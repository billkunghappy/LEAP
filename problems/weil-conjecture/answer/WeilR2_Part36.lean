    have hKIe : ∀ a, (C.presheaf.stalkSpecializes hG ≫ g.hom.stalkMap (genericPoint C)).hom
        ((wcLr1uGerm t (Ψ' n) h').hom a) = (wcLr1uGerm t n hn).hom ((Ψ'.stalkMap n).hom a) := by
      intro a
      have := congrArg (fun F => F.hom a) KI
      exact this
    refine ⟨h', fun a => ?_, fun a x hx hax => ?_⟩
    · show _ ∈ V.comap _
      rw [ValuationSubring.mem_comap, hKIe]
      exact hd1 _
    · have hx' : x ∈
          V.comap (C.presheaf.stalkSpecializes hG ≫ g.hom.stalkMap (genericPoint C)).hom := hx
      have e1 := congrArg (C.presheaf.stalkSpecializes hG ≫ g.hom.stalkMap (genericPoint C)).hom hax
      rw [map_mul, map_one, hKIe] at e1
      have hu := hd2 _ _ (ValuationSubring.mem_comap.mp hx') e1
      exact isUnit_of_map_unit (Ψ'.stalkMap n).hom a hu

  have hgf : g.hom ≫ (γ ≫ ι) = γ ≫ ι := by rw [← Category.assoc, hgγ]
  have s3 : ∀ (y : X) (h : (γ ≫ ι) (genericPoint C) ⤳ y),
      wcLr1uGerm (γ ≫ ι) y h ≫
        (C.presheaf.stalkSpecializes hG ≫ g.hom.stalkMap (genericPoint C)) =
        wcLr1uGerm (γ ≫ ι) y h := by
    intro y h
    have hhelp : ∀ (f1 f2 : C ⟶ X), f1 = f2 → ∀ (k1 : f1 (genericPoint C) ⤳ y)
        (k2 : f2 (genericPoint C) ⤳ y),
        X.presheaf.stalkSpecializes k1 ≫ f1.stalkMap (genericPoint C) =
          X.presheaf.stalkSpecializes k2 ≫ f2.stalkMap (genericPoint C) := by
      rintro f1 f2 rfl k1 k2
      rfl
    simp only [wcLr1uGerm, Category.assoc]
    rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc (γ ≫ ι) (g.hom (genericPoint C))
        (genericPoint C) hG,
      TopCat.Presheaf.stalkSpecializes_comp_assoc,
      ← Scheme.Hom.stalkMap_comp g.hom (γ ≫ ι) (genericPoint C)]
    exact hhelp _ _ hgf _ _

  have s4 : ∀ (B : ValuationSubring C.functionField)
      (φ : C.functionField →+* C.functionField) (y : C.functionField),
      φ y = y → B.valuation y < 1 → (B.comap φ).valuation y < 1 := by
    intro B φ y hφ hlt
    by_cases hy : y = 0
    · rw [hy, map_zero]; exact zero_lt_one
    have hyB : y ∈ B.comap φ := by
      rw [ValuationSubring.mem_comap, hφ]
      exact (ValuationSubring.valuation_le_one_iff B y).mp hlt.le
    have hle : (B.comap φ).valuation y ≤ 1 :=
      ((B.comap φ).valuation_le_one_iff y).mpr hyB
    refine lt_of_le_of_ne hle (fun heq => ?_)
    have hinv : (B.comap φ).valuation y⁻¹ ≤ 1 := by
      rw [Valuation.map_inv, heq, inv_one]
    have hinvB : y⁻¹ ∈ B := by
      have h1 := ((B.comap φ).valuation_le_one_iff y⁻¹).mp hinv
      rw [ValuationSubring.mem_comap, map_inv₀, hφ] at h1
      exact h1
    have h2 : B.valuation y⁻¹ ≤ 1 := (B.valuation_le_one_iff y⁻¹).mpr hinvB
    rw [Valuation.map_inv, inv_le_one₀ ((Valuation.pos_iff _).mpr hy)] at h2
    exact absurd hlt (not_lt.mpr h2)
  refine ⟨A'.comap (C.presheaf.stalkSpecializes hG ≫ g.hom.stalkMap (genericPoint C)).hom,
    ?_, ?_⟩
  · obtain ⟨hcx, η', h, h1, h2, h3, h4, h5⟩ := hA'
    refine ⟨?_, η', h, h1, h2, h3, h4, ?_⟩
    · have := s2 X (γ ≫ ι) (𝟙 X) (by rw [Category.comp_id, hgf]) A' _ hcx
      exact this
    · intro s hs
      have hfix : (C.presheaf.stalkSpecializes hG ≫ g.hom.stalkMap (genericPoint C)).hom
          ((wcLr1uGerm (γ ≫ ι) η' h).hom s) = (wcLr1uGerm (γ ≫ ι) η' h).hom s :=
        congrArg (fun F => F.hom s) (s3 η' h)
      exact s4 A' _ _ hfix (h5 s hs)
  · have := s2 _ (γ ≫ ιb).toNormalization Ψ hΨt A' q₀ hcq₀
    rwa [hΨq] at this

theorem wcpa_dj_lr1k_nsr_ub_tc_crt_stalk_rad : ∀ {N Y : Scheme.{u}} (π : N ⟶ Y) [IsIntegralHom π] (q : N), IsLocalRing.maximalIdeal (N.presheaf.stalk q) ≤ (Ideal.map (π.stalkMap q).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk (π q)))).radical :=
by
  have alg_core : ∀ {A B O : Type u} [CommRing A] [CommRing B] [CommRing O] [Algebra B O]
      [IsLocalRing O] (φ : A →+* B), φ.IsIntegral → ∀ (P : Ideal B) [P.IsPrime]
      [IsLocalization.AtPrime O P] (I : Ideal O),
      (∀ α : A, algebraMap B O (φ α) ∈ IsLocalRing.maximalIdeal O →
        algebraMap B O (φ α) ∈ I) →
      IsLocalRing.maximalIdeal O ≤ I.radical := by
    intro A B O _ _ _ _ _ φ hφ P _ _ I hI
    letI : Algebra A B := φ.toAlgebra
    have hint : Algebra.IsIntegral A B := ⟨hφ⟩
    have ha : (IsLocalRing.maximalIdeal O).comap (algebraMap B O) = P :=
      IsLocalization.AtPrime.under_maximalIdeal O P
    rw [Ideal.radical_eq_sInf]
    intro x hx
    rw [Ideal.mem_sInf]
    rintro Q ⟨hIQ, hQ⟩
    set Q'' := Q.comap (algebraMap B O) with hQ''
    haveI : Q''.IsPrime := Ideal.comap_isPrime _ _
    have hd : Q'' ≤ P := by
      rw [← ha]; exact Ideal.comap_mono (IsLocalRing.le_maximalIdeal hQ.ne_top)
    have he : P.comap (algebraMap A B) ≤ Q''.comap (algebraMap A B) := by
      intro α hα
      rw [Ideal.mem_comap] at hα ⊢
      rw [hQ'', Ideal.mem_comap]
      apply hIQ
      apply hI
      rw [← ha] at hα
      exact hα
    have hf : Q'' = P := by
      by_contra hne
      obtain ⟨y, hyP, hyQ⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hd hne)
      have := Ideal.under_lt_under_of_integral_mem_sdiff hd ⟨hyP, hyQ⟩
        (Algebra.IsIntegral.isIntegral (R := A) y)
      exact lt_irrefl _ (lt_of_lt_of_le this he)
    have hg : Q = IsLocalRing.maximalIdeal O := by
      have h1 : Ideal.map (algebraMap B O) Q'' = Q := IsLocalization.map_under P.primeCompl O Q
      rw [hf, IsLocalization.AtPrime.map_eq_maximalIdeal] at h1
      exact h1.symm
    rw [hg]; exact hx
  intro N Y π _ q
  obtain ⟨U, hU, hqU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := π q) trivial
  have hU' : IsAffineOpen (π ⁻¹ᵁ U) := hU.preimage π
  have hq' : q ∈ π ⁻¹ᵁ U := hqU
  let x' : (π ⁻¹ᵁ U : N.Opens) := ⟨q, hq'⟩
  letI : Algebra Γ(N, π ⁻¹ᵁ U) (N.presheaf.stalk (x' : N)) :=
    TopCat.Presheaf.algebra_section_stalk N.presheaf x'
  haveI := hU'.isLocalization_stalk x'
  have hφ := IsIntegralHom.isIntegral_app π U hU
  refine alg_core (O := N.presheaf.stalk (x' : N)) (π.app U).hom hφ
    (hU'.primeIdealOf x').asIdeal _ ?_
  intro α hα
  have key' : (π.stalkMap q).hom ((Y.presheaf.germ U (π q) hqU).hom α) =
      (N.presheaf.germ (π ⁻¹ᵁ U) q hqU).hom ((π.app U).hom α) :=
    Scheme.Hom.germ_stalkMap_apply π U q hqU α
  rw [TopCat.Presheaf.stalk_open_algebraMap] at hα ⊢
  change (N.presheaf.germ (π ⁻¹ᵁ U) q hqU).hom ((π.app U).hom α) ∈
    IsLocalRing.maximalIdeal (N.presheaf.stalk q) at hα
  change (N.presheaf.germ (π ⁻¹ᵁ U) q hqU).hom ((π.app U).hom α) ∈
    Ideal.map (π.stalkMap q).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk (π q)))
  rw [← key'] at hα ⊢
  apply Ideal.mem_map_of_mem
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hα ⊢
  exact fun hu => hα (hu.map _)

theorem wcpa_dj_lr1k_nsr_ub_tc_crt_box_bound : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (sC : C ⟶ Spec (.of Ω)) (Xb N : Scheme.{u}) (ub : Xb ⟶ Spec (.of ↥W)) (f : C ⟶ Xb) (t : C ⟶ N) (π : N ⟶ Xb), t ≫ π = f → f ≫ ub = sC ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) → ∀ (z : Xb) (q : N), π q = z → ∀ (g : Fin 2 → Xb.presheaf.stalk z) (d' : ↥W), wcTcRad W ub z g → d' ≠ 0 → d' ∈ IsLocalRing.maximalIdeal ↥W → IsLocalRing.maximalIdeal (N.presheaf.stalk q) ≤ (Ideal.map (π.stalkMap q).hom (IsLocalRing.maximalIdeal (Xb.presheaf.stalk (π q)))).radical → ∀ x ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk q), ∃ k : ℕ, ∀ (V : ValuationSubring C.functionField) (h : t (genericPoint C) ⤳ q), wcLr1uDom (wcLr1uGerm t q h).hom (V : Set C.functionField) → wcTcBox sC f z g (d' : Ω) V → V.valuation ((wcLr1uGerm t q h).hom x) ^ k ≤ V.valuation (wcLr1uConst sC (d' : Ω)) :=
by
  intro Ω _ W C _ sC Xb N ub f t π hf hcomp z q hqz g d' hRad hd0 hdm hR x hx
  subst hqz
  subst hf
  unfold wcTcRad at hRad
  unfold wcTcBox wcLr1uDom wcLr1uGerm wcLr1uConst
  set φ := (π.stalkMap q).hom with hφ
  set σ := ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ ub.appTop ≫
    Xb.presheaf.germ ⊤ (π q) trivial).hom d' with hσ
  have hJ : IsLocalRing.maximalIdeal (Xb.presheaf.stalk (π q)) ≤
      (Ideal.span {g 0, g 1, σ}).radical := by
    intro y hy
    exact hRad.2 d' hd0 hdm y hy
  have hmap : IsLocalRing.maximalIdeal (N.presheaf.stalk q) ≤
      (Ideal.map φ (Ideal.span {g 0, g 1, σ})).radical := by
    refine hR.trans ?_
    rw [Ideal.radical_le_radical_iff]
    exact (Ideal.map_mono hJ).trans (by apply Ideal.map_radical_le)
  obtain ⟨k, hk⟩ := hmap hx
  rw [Ideal.map_span, Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at hk
  obtain ⟨r0, z1, hz1, hk⟩ := Ideal.mem_span_insert.mp hk
  obtain ⟨r1, r2, hz⟩ := Ideal.mem_span_pair.mp hz1
  refine ⟨k, ?_⟩
  intro V h hDom hBox
  obtain ⟨h', hb⟩ := hBox
  have e1 : π.stalkMap q ≫ N.presheaf.stalkSpecializes h ≫ t.stalkMap (genericPoint C) =
      Xb.presheaf.stalkSpecializes h' ≫ (t ≫ π).stalkMap (genericPoint C) := by
    rw [Scheme.Hom.stalkMap_comp, ← Scheme.Hom.stalkSpecializes_stalkMap_assoc]
    rfl
  have e1' : ∀ y, (N.presheaf.stalkSpecializes h ≫ t.stalkMap (genericPoint C)).hom (φ y) =
      (Xb.presheaf.stalkSpecializes h' ≫ (t ≫ π).stalkMap (genericPoint C)).hom y := by
    intro y
    rw [← e1]; rfl
  have e2 : (Scheme.ΓSpecIso (.of ↥W)).inv ≫ ub.appTop ≫ Xb.presheaf.germ ⊤ (π q) trivial ≫
      Xb.presheaf.stalkSpecializes h' ≫ (t ≫ π).stalkMap (genericPoint C) =
      CommRingCat.ofHom (algebraMap ↥W Ω) ≫ (Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
        C.presheaf.germ ⊤ (genericPoint C) trivial := by
    have hA : ub.appTop ≫ (t ≫ π).appTop = ((t ≫ π) ≫ ub).appTop :=
      (Scheme.Hom.comp_appTop _ _).symm
    have h1 : Xb.presheaf.germ ⊤ (π q) trivial ≫ Xb.presheaf.stalkSpecializes h' =
        Xb.presheaf.germ ⊤ ((t ≫ π) (genericPoint C)) trivial :=
      by apply TopCat.Presheaf.germ_stalkSpecializes
    have h2 : Xb.presheaf.germ ⊤ ((t ≫ π) (genericPoint C)) trivial ≫
        (t ≫ π).stalkMap (genericPoint C) =
        (t ≫ π).appTop ≫ C.presheaf.germ ⊤ (genericPoint C) trivial :=
      Scheme.Hom.germ_stalkMap _ _ _ _
    calc (Scheme.ΓSpecIso (.of ↥W)).inv ≫ ub.appTop ≫ Xb.presheaf.germ ⊤ (π q) trivial ≫
          Xb.presheaf.stalkSpecializes h' ≫ (t ≫ π).stalkMap (genericPoint C)
        = (Scheme.ΓSpecIso (.of ↥W)).inv ≫ ((t ≫ π) ≫ ub).appTop ≫
            C.presheaf.germ ⊤ (genericPoint C) trivial := by
          rw [reassoc_of% h1, h2, reassoc_of% hA]
          simp only [Category.assoc]
      _ = _ := by
          rw [hcomp, Scheme.Hom.comp_appTop]
          simp only [Category.assoc]
          rw [← Scheme.ΓSpecIso_inv_naturality_assoc]
  have e2' : (Xb.presheaf.stalkSpecializes h' ≫ (t ≫ π).stalkMap (genericPoint C)).hom σ =
      ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
        C.presheaf.germ ⊤ (genericPoint C) trivial).hom (d' : Ω) := by
    have := congrArg (fun F => CommRingCat.Hom.hom F d') e2
    exact this
  set G := (N.presheaf.stalkSpecializes h ≫ t.stalkMap (genericPoint C)).hom with hG
  set G' := (Xb.presheaf.stalkSpecializes h' ≫ (t ≫ π).stalkMap (genericPoint C)).hom with hG'
  set D := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ sC.appTop ≫
    C.presheaf.germ ⊤ (genericPoint C) trivial).hom (d' : Ω) with hD
  have hle : ∀ r, V.valuation (G r) ≤ 1 := fun r => (V.valuation_le_one_iff _).mpr (hDom.1 r)
  have hGx : G x ^ k = G r0 * G' (g 0) + (G r1 * G' (g 1) + G r2 * D) := by
    rw [← map_pow G x k, hk, ← hz, map_add, map_add, map_mul, map_mul, map_mul, e1', e1', e1', e2']
  rw [← V.valuation.map_pow (G x) k, hGx]
  apply Valuation.map_add_le
  · rw [Valuation.map_mul]; exact (mul_le_of_le_one_left' (hle r0)).trans (hb 0)
  · apply Valuation.map_add_le
    · rw [Valuation.map_mul]; exact (mul_le_of_le_one_left' (hle r1)).trans (hb 1)
    · rw [Valuation.map_mul]; exact mul_le_of_le_one_left' (hle r2)

theorem wcpa_dj_lr1k_nsr_ub_tc_crt_chart : ∀ (C N Xb : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (t : C ⟶ N) (π : N ⟶ Xb) [IsIntegralHom π] (z : Xb) (q₀ : N), π q₀ = z → t (genericPoint C) ⤳ q₀ → ∃ (B : Type u) (_ : CommRing B) (ψ : B →+* C.functionField) (P : N → Ideal B), (∀ q : N, π q = z → (P q).IsPrime) ∧ (∀ q q' : N, π q = z → π q' = z → P q ≤ P q' → q = q') ∧ (∀ q : N, π q = z → ∀ b : B, ∃ x : N.presheaf.stalk q, (x ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk q) ↔ b ∈ P q) ∧ ∀ h : t (genericPoint C) ⤳ q, (wcLr1uGerm t q h).hom x = ψ b) :=
by
  classical
  intro C N Xb _ t π _ z q₀ hq₀ h₀
  obtain ⟨U, hU, hzU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := Xb) (U := ⊤) (x := z) trivial
  have hU' : IsAffineOpen (π ⁻¹ᵁ U) := hU.preimage π
  have hfib : ∀ q : N, π q = z → q ∈ π ⁻¹ᵁ U := fun q hq => by
    show π q ∈ U
    rw [hq]; exact hzU
  have hη : genericPoint C ∈ t ⁻¹ᵁ (π ⁻¹ᵁ U) := h₀.mem_open (π ⁻¹ᵁ U).isOpen (hfib q₀ hq₀)
  let P : N → Ideal Γ(N, π ⁻¹ᵁ U) := fun q => if hq : q ∈ π ⁻¹ᵁ U then
    Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) q hq).hom
      (IsLocalRing.maximalIdeal (N.presheaf.stalk q)) else ⊤
  have hP : ∀ q (hq : q ∈ π ⁻¹ᵁ U), P q = Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) q hq).hom
      (IsLocalRing.maximalIdeal (N.presheaf.stalk q)) := fun q hq => dif_pos hq
  refine ⟨Γ(N, π ⁻¹ᵁ U), inferInstance,
    (C.presheaf.germ (t ⁻¹ᵁ (π ⁻¹ᵁ U)) (genericPoint C) hη).hom.comp (t.app (π ⁻¹ᵁ U)).hom,
    P, ?_, ?_, ?_⟩
  · intro q hq
    rw [hP q (hfib q hq)]
    exact Ideal.IsPrime.comap _
  · intro q q' hq hq' hle
    have hqU := hfib q hq
    have hq'U := hfib q' hq'
    rw [hP q hqU, hP q' hq'U] at hle
    have hint : (π.app U).hom.IsIntegral := IsIntegralHom.isIntegral_app π U hU
    have hcontr : ∀ (y : N) (hy : π y ∈ U), Ideal.comap (π.app U).hom
        (Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) y hy).hom
          (IsLocalRing.maximalIdeal (N.presheaf.stalk y))) =
        Ideal.comap (Xb.presheaf.germ U (π y) hy).hom
          (IsLocalRing.maximalIdeal (Xb.presheaf.stalk (π y))) := by
      intro y hy
      ext a
      simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      have e : (N.presheaf.germ (π ⁻¹ᵁ U) y hy).hom ((π.app U).hom a) =
          (π.stalkMap y).hom ((Xb.presheaf.germ U (π y) hy).hom a) :=
        (π.germ_stalkMap_apply U y hy a).symm
      rw [e]
      exact not_congr (isUnit_map_iff _ _)
    have hR : ∀ (y₁ y₂ : Xb) (h₁ : y₁ ∈ U) (h₂ : y₂ ∈ U), y₁ = y₂ →
        Ideal.comap (Xb.presheaf.germ U y₁ h₁).hom
          (IsLocalRing.maximalIdeal (Xb.presheaf.stalk y₁)) =
        Ideal.comap (Xb.presheaf.germ U y₂ h₂).hom
          (IsLocalRing.maximalIdeal (Xb.presheaf.stalk y₂)) := by
      rintro _ _ _ _ rfl; rfl
    have heq : Ideal.comap (π.app U).hom (Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) q hqU).hom
          (IsLocalRing.maximalIdeal (N.presheaf.stalk q))) =
        Ideal.comap (π.app U).hom (Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) q' hq'U).hom
          (IsLocalRing.maximalIdeal (N.presheaf.stalk q'))) := by
      rw [hcontr q hqU, hcontr q' hq'U]
      exact hR _ _ _ _ (hq.trans hq'.symm)
    have hPP : Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) q hqU).hom
          (IsLocalRing.maximalIdeal (N.presheaf.stalk q)) =
        Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) q' hq'U).hom
          (IsLocalRing.maximalIdeal (N.presheaf.stalk q')) := by
      by_contra hne
      obtain ⟨x, hx', hx⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hle hne)
      letI := (π.app U).hom.toAlgebra
      have hlt := Ideal.under_lt_under_of_integral_mem_sdiff (R := Γ(Xb, U)) hle ⟨hx', hx⟩ (hint x)
      rw [Ideal.under_def, Ideal.under_def] at hlt
      exact (ne_of_lt hlt) heq
    have key : ∀ (x : N) (hx : x ∈ π ⁻¹ᵁ U), (hU'.primeIdealOf ⟨x, hx⟩).asIdeal =
        Ideal.comap (N.presheaf.germ (π ⁻¹ᵁ U) x hx).hom
          (IsLocalRing.maximalIdeal (N.presheaf.stalk x)) := by
      intro x hx
      rw [hU'.primeIdealOf_eq_map_closedPoint]
      rfl
    have h1 : hU'.primeIdealOf ⟨q, hqU⟩ = hU'.primeIdealOf ⟨q', hq'U⟩ :=
      PrimeSpectrum.ext (by rw [key, key]; exact hPP)
    have h2 := congrArg hU'.fromSpec.base h1
    rw [hU'.fromSpec_primeIdealOf, hU'.fromSpec_primeIdealOf] at h2
    exact h2
  · intro q hq b
    have hqU := hfib q hq
    refine ⟨(N.presheaf.germ (π ⁻¹ᵁ U) q hqU).hom b, ?_, ?_⟩
    · rw [hP q hqU, Ideal.mem_comap]
    · intro h
      simp only [wcLr1uGerm, CommRingCat.hom_comp, RingHom.comp_apply]
      rw [TopCat.Presheaf.germ_stalkSpecializes_apply, Scheme.Hom.germ_stalkMap_apply]

theorem wcpa_dj_lr1k_nsr_ub_tc_crt_split : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
      wcpaDjLkCov Ω γ →
    ∀ (Xb : Scheme.{u}) (ub : Xb ⟶ Spec (.of ↥W)) (ιb : wcProjK Ω 1 ⟶ Xb)
      [QuasiCompact (γ ≫ ιb)] [QuasiSeparated (γ ≫ ιb)],
      wcpaDjLkModel W ub ιb →
    ∀ (z : Xb) (g : Fin 2 → Xb.presheaf.stalk z) (d' : ↥W),
      wcTcRad W ub z g → d' ≠ 0 → d' ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (D S₁ S₂ : ValuationSubring C.functionField → Prop),
