      g.hom ≫ γ = γ ∧ IsIso Ψ ∧
      (γ ≫ ιY).toNormalization ≫ Ψ = g.hom ≫ (γ ≫ ιY).toNormalization ∧ Ψ q' = q :=
by
  intro Ω _ _ W hW hWt C _ γ hcov hgal Y uY ιY _ _ hM q q' hqq
  obtain ⟨hss, hYp, hpb⟩ := hM
  obtain ⟨hYint, hYnorm⟩ := wcpa_dj_lr1u_model_normal Ω W hW hWt Y uY ιY hss hYp hpb
  obtain ⟨hGfin, hdesc⟩ :=
