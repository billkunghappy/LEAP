    have hbij : Function.Bijective ((Limits.pullback.fst rb U.ι).stalkMap ρ).hom :=
      ConcreteCategory.bijective_of_isIso _
    have hA : ((Limits.pullback.fst rb U.ι).stalkMap ρ).hom
        (((Scheme.ΓSpecIso (.of ↥W)).inv ≫ (rb ≫ uX).appTop ≫
          Xb.presheaf.germ ⊤ (Limits.pullback.fst rb U.ι ρ) trivial).hom b) =
        ((Limits.pullback rb U.ι).presheaf.germ ⊤ ρ trivial).hom
