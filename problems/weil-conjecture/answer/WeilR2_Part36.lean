    rw [← hcompat w]
    exact e.symm_apply_apply (w : Ω)
  have hclear : ∀ ω : Ω, ∃ (n : ℕ) (a₀ : ↥W), (ϖ : Ω) ^ n * ω = (a₀ : Ω) := by
    intro ω
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := ↥W) ω
    simp only [ValuationSubring.algebraMap_apply] at hab
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have hb0' : (b : Ω) ≠ 0 := fun h => hb0 (by exact_mod_cast h)
    obtain ⟨n, b', hb'⟩ := hdiv b hb0
    refine ⟨n, a * b', ?_⟩
    have hpow : (ϖ : Ω) ^ n = (b : Ω) * (b' : Ω) := by
      have := congrArg (fun x : ↥W => (x : Ω)) hb'
      push_cast at this
      exact this
    rw [← hab, hpow]
    push_cast
    field_simp
  have hpt : ∀ c : C, ∃ c' : ↥W, P c = (c' : Ω) ∧
      χ₁ c = algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) c' := by
    intro c
    obtain ⟨n, a₀, hn⟩ := hclear (P c)
    have h1 : algebraMap (↥W) C ϖ ^ n * c = algebraMap (↥W) C a₀ := by
      apply hPinj
      rw [map_mul, map_pow, hPW, hPW, hn]
    have h2 : algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) a₀ =
        algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ ^ n * χ₁ c := by
      rw [← hχ₁, ← hχ₁, ← map_pow, ← map_mul, h1]
    obtain ⟨c', hc'⟩ := hB2 n a₀ (χ₁ c) h2
    refine ⟨c', ?_, ?_⟩
    · have hϖ' : (ϖ : Ω) ≠ 0 := fun h => hϖ0 (by exact_mod_cast h)
      apply mul_left_cancel₀ (pow_ne_zero n hϖ')
      rw [hn, hc']
      push_cast
      rfl
    · rw [← sub_eq_zero]
      apply hcancel n
      rw [mul_sub, ← h2, hc', map_mul, map_pow, sub_self]
  have hmem : ∀ c : C, P c ∈ W := fun c => by
    obtain ⟨c', hc', -⟩ := hpt c
    rw [hc']
    exact c'.2
  refine ⟨P.codRestrict W hmem, ?_, ?_⟩
  · intro w
    apply Subtype.ext
    rw [RingHom.codRestrict_apply]
    exact hPW w
  · intro r
    obtain ⟨c', hc', hχ⟩ := hpt r
    have hθ : P.codRestrict W hmem r = c' :=
      Subtype.ext (by rw [RingHom.codRestrict_apply]; exact hc')
    rw [hθ, hχ]

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_scale_poly : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ (m : ℕ) (a : Fin m → Polynomial Ω), ∃ e : ℕ, ∀ i, ∃ A : Polynomial ↥W, A.map (algebraMap (↥W) Ω) = Polynomial.C ((ϖ : Ω) ^ e) * a i :=
by
  intro Ω _ W ϖ _ hdiv m a
  classical
  have s1 : ∀ x : Ω, ∃ n : ℕ, ∀ e : ℕ, n ≤ e → (ϖ : Ω) ^ e * x ∈ W := by
    intro x
    rcases W.mem_or_inv_mem x with hx | hx
    · exact ⟨0, fun e _ => mul_mem (pow_mem ϖ.2 e) hx⟩
    · by_cases hx0 : x = 0
      · exact ⟨0, fun e _ => by rw [hx0, mul_zero]; exact zero_mem W⟩
      · have hc : (⟨x⁻¹, hx⟩ : ↥W) ≠ 0 := by
          intro h
          have h' := congrArg Subtype.val h
          exact inv_ne_zero hx0 h'
        obtain ⟨n, y, hy⟩ := hdiv _ hc
        have hy' : (ϖ : Ω) ^ n = x⁻¹ * (y : Ω) := by
          have h' := congrArg Subtype.val hy
          simpa using h'
        have h2 : (ϖ : Ω) ^ n * x = (y : Ω) := by
          rw [hy', mul_comm x⁻¹, mul_assoc, inv_mul_cancel₀ hx0, mul_one]
        refine ⟨n, fun e he => ?_⟩
        have h3 : (ϖ : Ω) ^ e * x = (ϖ : Ω) ^ (e - n) * (y : Ω) := by
          rw [← h2, ← mul_assoc, ← pow_add, Nat.sub_add_cancel he]
        rw [h3]
        exact mul_mem (pow_mem ϖ.2 _) y.2
  have hev : ∀ᶠ e in Filter.atTop, ∀ i, ∀ k ∈ (a i).support, (ϖ : Ω) ^ e * (a i).coeff k ∈ W := by
    rw [Filter.eventually_all]
    intro i
    rw [Filter.eventually_all_finset]
    intro k _
    obtain ⟨n, hn⟩ := s1 ((a i).coeff k)
    exact Filter.eventually_atTop.2 ⟨n, hn⟩
  obtain ⟨e, he⟩ := hev.exists
  refine ⟨e, fun i => ?_⟩
  have hl : Polynomial.C ((ϖ : Ω) ^ e) * a i ∈ Polynomial.lifts (algebraMap (↥W) Ω) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro k
    rw [Polynomial.coeff_C_mul]
    by_cases hk : k ∈ (a i).support
    · exact ⟨⟨_, he i k hk⟩, rfl⟩
    · rw [Polynomial.notMem_support_iff.mp hk, mul_zero]
      exact ⟨0, map_zero _⟩
  exact (Polynomial.mem_lifts _).mp hl

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_scale_monic : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), (∀ (m : ℕ) (a : Fin m → Polynomial Ω), ∃ e : ℕ, ∀ i, ∃ A : Polynomial ↥W, A.map (algebraMap (↥W) Ω) = Polynomial.C ((ϖ : Ω) ^ e) * a i) → ∀ χ : Polynomial (Polynomial Ω), χ.Monic → ∃ (e : ℕ) (q : Polynomial (Polynomial ↥W)), q.Monic ∧ q.natDegree = χ.natDegree ∧ q.map (Polynomial.mapRingHom (algebraMap (↥W) Ω)) = χ.scaleRoots (Polynomial.C ((ϖ : Ω) ^ e)) :=
by
  intro Ω _ W ϖ HS χ hχ
  classical
  obtain ⟨e, hA⟩ := HS (χ.natDegree + 1) (fun i => χ.coeff i)
  choose A hA using hA
  have hs : Polynomial.C ((ϖ : Ω) ^ e) =
      Polynomial.mapRingHom (algebraMap (↥W) Ω) (Polynomial.C (ϖ ^ e)) := by
    rw [Polynomial.coe_mapRingHom, Polynomial.map_C, (algebraMap (↥W) Ω).map_pow]
    rfl
  have hlift : χ.scaleRoots (Polynomial.C ((ϖ : Ω) ^ e)) ∈
      Polynomial.lifts (Polynomial.mapRingHom (algebraMap (↥W) Ω)) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro k
    rw [Polynomial.coeff_scaleRoots]
    rcases lt_trichotomy k χ.natDegree with hk | hk | hk
    · obtain ⟨j, hj⟩ : ∃ j, χ.natDegree - k = j + 1 := ⟨χ.natDegree - k - 1, by omega⟩
      have h2 : Polynomial.mapRingHom (algebraMap (↥W) Ω) (A ⟨k, by omega⟩) =
          Polynomial.C ((ϖ : Ω) ^ e) * χ.coeff k := by
        rw [Polynomial.coe_mapRingHom]
        exact hA ⟨k, by omega⟩
      refine ⟨A ⟨k, by omega⟩ * Polynomial.C (ϖ ^ e) ^ j, ?_⟩
      rw [hj, pow_succ', map_mul, map_pow, ← hs, h2]
      ring
    · refine ⟨1, ?_⟩
      rw [hk, Nat.sub_self, pow_zero, mul_one, hχ.coeff_natDegree, map_one]
    · refine ⟨0, ?_⟩
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hk, zero_mul, map_zero]
  have hmon : (χ.scaleRoots (Polynomial.C ((ϖ : Ω) ^ e))).Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_scaleRoots,
      Polynomial.coeff_scaleRoots, Nat.sub_self, pow_zero, mul_one]
    exact hχ.coeff_natDegree
  obtain ⟨q, hq1, hq2, hq3⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hmon
  exact ⟨e, q, hq3, by rw [hq2, Polynomial.natDegree_scaleRoots], hq1⟩

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_free_basis : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ∀ (C : Type u) [CommRing C] [Algebra ↥W C] (D : Type u) [CommRing D] [IsDomain D] [Algebra C D] [Algebra Ω D], Function.Injective (algebraMap C D) → (∀ b : D, ∃ n : ℕ, ∃ a : C, algebraMap C D (algebraMap (↥W) C ϖ) ^ n * b = algebraMap C D a) → (∀ w : ↥W, algebraMap Ω D (w : Ω) = algebraMap C D (algebraMap (↥W) C w)) → ∀ τ₀ : D, Function.Injective (Polynomial.aeval (R := Ω) τ₀) → (Polynomial.aeval (R := Ω) τ₀).Finite → ∃ (τ : C) (n : ℕ) (b : Fin n → C), 0 < n ∧ (∀ d : D, ∃ a : Fin n → Polynomial Ω, d = ∑ l, Polynomial.aeval (algebraMap C D τ) (a l) * algebraMap C D (b l)) ∧ (∀ a : Fin n → Polynomial Ω, ∑ l, Polynomial.aeval (algebraMap C D τ) (a l) * algebraMap C D (b l) = 0 → ∀ l, a l = 0) :=
by
  intro Ω _ W ϖ hϖ0 C _ _ D _ _ _ _ _hinj hgen hc τ₀ hτinj hτfin
  classical
  have hϖΩ : (ϖ : Ω) ≠ 0 := fun h => hϖ0 (Subtype.ext h)

  have s1 : ∀ (c : Ω), c ≠ 0 →
      Function.Injective (Polynomial.aeval (R := Ω) (algebraMap Ω D c * τ₀)) ∧
        (Polynomial.aeval (R := Ω) (algebraMap Ω D c * τ₀)).Finite := by
    intro c hc0
    letI : Invertible c := invertibleOfNonzero hc0
    have key : Polynomial.aeval (R := Ω) (algebraMap Ω D c * τ₀) =
        (Polynomial.aeval (R := Ω) τ₀).comp
          ((Polynomial.algEquivCMulXAddC c (0 : Ω) : Polynomial Ω ≃ₐ[Ω] Polynomial Ω) :
            Polynomial Ω →ₐ[Ω] Polynomial Ω) := by
      apply Polynomial.algHom_ext
      simp [Polynomial.algEquivCMulXAddC_apply]
    rw [key]
    refine ⟨hτinj.comp (Polynomial.algEquivCMulXAddC c (0 : Ω)).injective, ?_⟩
    exact AlgHom.Finite.comp hτfin
      (AlgHom.Finite.of_surjective _ (Polynomial.algEquivCMulXAddC c (0 : Ω)).surjective)

  have s2 : ∀ τ : D, Function.Injective (Polynomial.aeval (R := Ω) τ) →
      (Polynomial.aeval (R := Ω) τ).Finite →
      ∃ (n : ℕ) (b : Fin n → D), 0 < n ∧
        (∀ d : D, ∃ a : Fin n → Polynomial Ω, d = ∑ l, Polynomial.aeval τ (a l) * b l) ∧
        (∀ a : Fin n → Polynomial Ω, ∑ l, Polynomial.aeval τ (a l) * b l = 0 → ∀ l, a l = 0) := by
    intro τ hi hf
    letI : Algebra (Polynomial Ω) D := (Polynomial.aeval (R := Ω) τ).toRingHom.toAlgebra
    have hsmul : ∀ (p : Polynomial Ω) (x : D), p • x = Polynomial.aeval τ p * x := fun p x => rfl
    haveI : Module.Finite (Polynomial Ω) D := hf
    haveI : Module.IsTorsionFree (Polynomial Ω) D :=
      (Module.isTorsionFree_iff_algebraMap_injective).mpr hi
    haveI : Module.Free (Polynomial Ω) D := Module.free_of_finite_type_torsion_free'
    refine ⟨Module.finrank (Polynomial Ω) D, Module.finBasis (Polynomial Ω) D,
      Module.finrank_pos, ?_, ?_⟩
    · intro d
      refine ⟨fun l => (Module.finBasis (Polynomial Ω) D).repr d l, ?_⟩
      conv_lhs => rw [← (Module.finBasis (Polynomial Ω) D).sum_repr d]
      simp only [hsmul]
    · intro a ha
      exact Fintype.linearIndependent_iff.mp (Module.finBasis (Polynomial Ω) D).linearIndependent a
        (by simpa only [hsmul] using ha)

  obtain ⟨m, a, ha⟩ := hgen τ₀
  have hτeq : algebraMap C D a = algebraMap Ω D ((ϖ : Ω) ^ m) * τ₀ := by
    rw [← ha, ← hc ϖ, map_pow]
  obtain ⟨hi, hf⟩ := s1 _ (pow_ne_zero m hϖΩ)
  rw [← hτeq] at hi hf
  obtain ⟨n, b', hn, hspan, hind⟩ := s2 (algebraMap C D a) hi hf
  choose mm cc hcc using fun l => hgen (b' l)
  refine ⟨a, n, cc, hn, ?_, ?_⟩
  · intro d
    obtain ⟨a', ha'⟩ := hspan d
    refine ⟨fun l => Polynomial.C (((ϖ : Ω) ^ (mm l))⁻¹) * a' l, ?_⟩
    rw [ha']
    apply Finset.sum_congr rfl
    intro l _
    have hu : algebraMap Ω D (((ϖ : Ω) ^ (mm l))⁻¹) * algebraMap Ω D (ϖ : Ω) ^ (mm l) = 1 := by
      rw [← map_pow, ← map_mul, inv_mul_cancel₀ (pow_ne_zero _ hϖΩ), map_one]
    rw [← hcc l, ← hc ϖ, map_mul, Polynomial.aeval_C]
    linear_combination (-(Polynomial.aeval (algebraMap C D a) (a' l) * b' l)) * hu
  · intro a' h0 l
    have h1 : ∑ l, Polynomial.aeval (algebraMap C D a) (Polynomial.C ((ϖ : Ω) ^ (mm l)) * a' l) * b' l
        = 0 := by
      rw [← h0]
      apply Finset.sum_congr rfl
      intro l _
      rw [← hcc l, ← hc ϖ, map_mul, Polynomial.aeval_C, map_pow]
      ring
    have hz := hind _ h1 l
    exact (mul_eq_zero.mp hz).resolve_left (Polynomial.C_ne_zero.mpr (pow_ne_zero _ hϖΩ))

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_mult_matrix_ch : ∀ (Ω : Type u) [Field Ω] (D : Type u) [CommRing D] [Algebra Ω D] (τ : D) (n : ℕ) (b : Fin n → D), (∀ d : D, ∃ a : Fin n → Polynomial Ω, d = ∑ l, Polynomial.aeval τ (a l) * b l) → (∀ a : Fin n → Polynomial Ω, ∑ l, Polynomial.aeval τ (a l) * b l = 0 → ∀ l, a l = 0) → ∀ h : D, ∃ M : Matrix (Fin n) (Fin n) (Polynomial Ω), (∀ a : Fin n → Polynomial Ω, h * ∑ l, Polynomial.aeval τ (a l) * b l = ∑ l, Polynomial.aeval τ ((M.mulVec a) l) * b l) ∧ (M.charpoly.map (Polynomial.aeval τ).toRingHom).eval h = 0 :=
by
  intro Ω _ D _ _ τ n b hspan _ h
  classical
  choose c hc using fun k : Fin n => hspan (h * b k)
  refine ⟨Matrix.of (fun l k => c k l), ?_, ?_⟩
  · intro a
    simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, map_sum, map_mul, Finset.sum_mul]
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [mul_left_comm, hc k, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun l _ => by ring)
  · set N : Matrix (Fin n) (Fin n) D := Matrix.scalar (Fin n) h -
      (Matrix.of (fun l k => c k l)).map (Polynomial.aeval τ).toRingHom with hN
    have hcol : Matrix.vecMul b N = 0 := by
      funext k
      simp only [hN, Matrix.vecMul, dotProduct, Matrix.sub_apply, Matrix.scalar_apply,
        Matrix.diagonal_apply, Matrix.map_apply, Matrix.of_apply, mul_sub,
        Finset.sum_sub_distrib, mul_ite, mul_zero, Finset.sum_ite_eq',
        Finset.mem_univ, ite_true, Pi.zero_apply]
      rw [sub_eq_zero, mul_comm, hc k]
      exact Finset.sum_congr rfl (fun l _ => by rw [mul_comm]; rfl)
    have hdet : N.det • b = 0 := by
      have h1 := Matrix.vecMul_vecMul b N N.adjugate
      rw [hcol, Matrix.zero_vecMul, Matrix.mul_adjugate, Matrix.vecMul_smul,
        Matrix.vecMul_one] at h1
      exact h1.symm
    obtain ⟨a1, ha1⟩ := hspan 1
    have hN0 : N.det = 0 := by
      calc N.det = N.det * 1 := (mul_one _).symm
        _ = ∑ l, Polynomial.aeval τ (a1 l) * (N.det * b l) := by
          rw [ha1, Finset.mul_sum]
          exact Finset.sum_congr rfl (fun l _ => by ring)
        _ = 0 := Finset.sum_eq_zero (fun l _ => by
          rw [show N.det * b l = 0 from congrFun hdet l, mul_zero])
    rw [← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hN0

theorem wcpa_dj_lr1k_nsr_gub_itmp_si_den_eigen_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (D : Type u) [CommRing D] [Algebra Ω D], Algebra.FiniteType Ω D → ∀ (τ : D) (n : ℕ) (b : Fin n → D), (∀ d : D, ∃ a : Fin n → Polynomial Ω, d = ∑ l, Polynomial.aeval τ (a l) * b l) → (∀ a : Fin n → Polynomial Ω, ∑ l, Polynomial.aeval τ (a l) * b l = 0 → ∀ l, a l = 0) → ∀ (h : D) (M : Matrix (Fin n) (Fin n) (Polynomial Ω)), (∀ a : Fin n → Polynomial Ω, h * ∑ l, Polynomial.aeval τ (a l) * b l = ∑ l, Polynomial.aeval τ ((M.mulVec a) l) * b l) → ∀ t lam : Ω, (M.charpoly.map (Polynomial.evalRingHom t)).eval lam = 0 → ∃ P : D →ₐ[Ω] Ω, P τ = t ∧ P h = lam :=
by
  intro Ω _ _ D _ _ hft τ n b hspan hind h M hM t lam hroot
  classical

  have hdet : (Matrix.scalar (Fin n) lam - M.map (Polynomial.evalRingHom t)).det = 0 := by
    rw [← Matrix.eval_charpoly, Matrix.charpoly_map]
    exact hroot

  obtain ⟨w, hw0, hw⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr hdet
  have hstar : ∀ j, ∑ i, w i * (M i j).eval t = lam * w j := by
    intro j
    have h1 := congrFun hw j
    simp only [Matrix.vecMul, dotProduct, Matrix.sub_apply, Matrix.scalar_apply,
      Matrix.diagonal_apply, Matrix.map_apply, Polynomial.coe_evalRingHom, mul_sub,
      Finset.sum_sub_distrib, mul_ite, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true,
      Pi.zero_apply] at h1
    linear_combination -h1

  set I : Ideal D := Ideal.span {τ - algebraMap Ω D t, h - algebraMap Ω D lam} with hIdef
  have hI : I ≠ ⊤ := by
    intro hItop
    obtain ⟨k, hk⟩ := Function.ne_iff.mp hw0
    have hbk : b k ∈ I := by rw [hItop]; exact Submodule.mem_top
    obtain ⟨u, v, huv⟩ := Ideal.mem_span_pair.mp hbk
    obtain ⟨p, hp⟩ := hspan u
    obtain ⟨q, hq⟩ := hspan v
    set c : Fin n → Polynomial Ω := fun l => p l * (Polynomial.X - Polynomial.C t) +
      (M.mulVec q) l - Polynomial.C lam * q l -
      (Pi.single k (1 : Polynomial Ω) : Fin n → Polynomial Ω) l with hcdef
    have e1 : ∑ l, Polynomial.aeval τ (p l * (Polynomial.X - Polynomial.C t)) * b l =
        u * (τ - algebraMap Ω D t) := by
      rw [hp, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      simp only [map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      ring
    have e2 : ∑ l, Polynomial.aeval τ ((M.mulVec q) l) * b l = h * v := by
      rw [hq, hM]
    have e3 : ∑ l, Polynomial.aeval τ (Polynomial.C lam * q l) * b l =
        algebraMap Ω D lam * v := by
      rw [hq, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      simp only [map_mul, Polynomial.aeval_C]
      ring
    have e4 : ∑ l, Polynomial.aeval τ ((Pi.single k (1 : Polynomial Ω) : Fin n → Polynomial Ω) l)
        * b l = b k := by
      simp [Pi.single_apply]
    have hsum : ∑ l, Polynomial.aeval τ (c l) * b l = 0 := by
      simp only [hcdef, map_sub, map_add, sub_mul, add_mul, Finset.sum_sub_distrib,
        Finset.sum_add_distrib]
      rw [e1, e2, e3, e4, ← huv]
      ring
    have hc := hind c hsum
    have key : ∀ l, ∑ j, (M l j).eval t * (q j).eval t - lam * (q l).eval t =
        if l = k then 1 else 0 := by
      intro l
      have h1 := congrArg (Polynomial.eval t) (hc l)
      simp only [hcdef, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_X, Polynomial.eval_C, sub_self, mul_zero, zero_add, Polynomial.eval_zero,
        Matrix.mulVec, dotProduct, Polynomial.eval_finset_sum, Pi.single_apply] at h1
      split_ifs at h1 ⊢ with hlk
      · simp only [Polynomial.eval_one] at h1
        linear_combination h1
      · simp only [Polynomial.eval_zero] at h1
        linear_combination h1
    have hL : ∑ l, w l * (∑ j, (M l j).eval t * (q j).eval t - lam * (q l).eval t) = 0 := by
      simp only [mul_sub, Finset.mul_sum]
      rw [Finset.sum_sub_distrib, Finset.sum_comm, sub_eq_zero]
      have : ∀ j, ∑ l, w l * ((M l j).eval t * (q j).eval t) = lam * (w j * (q j).eval t) := by
        intro j
        calc ∑ l, w l * ((M l j).eval t * (q j).eval t)
            = (∑ l, w l * (M l j).eval t) * (q j).eval t := by
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl (fun l _ => ?_)
              ring
          _ = lam * (w j * (q j).eval t) := by rw [hstar j]; ring
      rw [Finset.sum_congr rfl (fun j _ => this j)]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ring
    have hR : ∑ l, w l * (∑ j, (M l j).eval t * (q j).eval t - lam * (q l).eval t) = w k := by
      simp only [key, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    exact hk (by rw [← hR, hL]; rfl)

  obtain ⟨𝔪, h𝔪, hI𝔪⟩ := Ideal.exists_le_maximal I hI
  letI : Field (D ⧸ 𝔪) := Ideal.Quotient.field 𝔪
  haveI := hft
  haveI : Algebra.FiniteType Ω (D ⧸ 𝔪) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω 𝔪)
      (Ideal.Quotient.mkₐ_surjective Ω 𝔪)
  haveI : Module.Finite Ω (D ⧸ 𝔪) := finite_of_finite_type_of_isJacobsonRing Ω (D ⧸ 𝔪)
  haveI : Algebra.IsIntegral Ω (D ⧸ 𝔪) := Algebra.IsIntegral.of_finite Ω _
  have hbij : Function.Bijective (algebraMap Ω (D ⧸ 𝔪)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : Ω ≃ₐ[Ω] D ⧸ 𝔪 := AlgEquiv.ofBijective (Algebra.ofId Ω (D ⧸ 𝔪)) hbij
  have hmk : ∀ (x : D) (s : Ω), x - algebraMap Ω D s ∈ I →
      (e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω 𝔪)) x = s := by
    intro x s hx
    have h1 : Ideal.Quotient.mk 𝔪 x = algebraMap Ω (D ⧸ 𝔪) s := by
      rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq]
      exact hI𝔪 hx
    rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, h1]
    exact AlgHom.commutes e.symm.toAlgHom s
  refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω 𝔪), hmk τ t ?_, hmk h lam ?_⟩
  · exact Ideal.subset_span (Set.mem_insert _ _)
  · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

