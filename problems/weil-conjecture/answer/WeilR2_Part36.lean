    obtain ⟨_, _, huniq⟩ := hb1.2 _ (Limits.pullback.snd r₀ U.ι) hb1.1
    exact (huniq _ (by show (θ ≫ θ') ≫ _ = _; rw [Category.assoc, hθ', hθ])).trans
      (huniq _ (Category.id_comp _)).symm
  have hθ'θ : θ' ≫ θ = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb2.2 _ (Limits.pullback.snd rM m) hb2.1
    exact (huniq _ (by show (θ' ≫ θ) ≫ _ = _; rw [Category.assoc, hθ, hθ'])).trans
      (huniq _ (Category.id_comp _)).symm
  haveI : IsIso θ := ⟨θ', hθθ', hθ'θ⟩
  obtain ⟨h₂, hh₂⟩ : ∃ h₂ : Limits.pullback r₀ U.ι ⟶ M', h₂ = θ ≫ Limits.pullback.fst rM m :=
    ⟨_, rfl⟩
  haveI : Etale h₂ := by rw [hh₂]; infer_instance
  refine ⟨M', rM, h₂, hrM, inferInstance, ?_⟩
  rw [hh₂, Category.assoc, Limits.pullback.condition, ← Category.assoc, hθ]

theorem wcpa_dj_lr1k_nsr_gcn_stalk_factor : ∀ (R : CommRingCat.{u}) [IsLocalRing R] (Y : Scheme.{u}) [IsAffine Y] (σ : Spec R ⟶ Y) (T : Γ(Y, ⊤)), RingHom.ker σ.appTop.hom = Ideal.span {T} → ∀ (y : ↥Y), y = σ (IsLocalRing.closedPoint R) → ∀ (V : Y.Opens) (g : Γ(Y, V)) (hy : y ∈ V), (σ.app V).hom g = 0 → ∃ h : ↥(Y.presheaf.stalk y), (Y.presheaf.germ V y hy).hom g = (Y.presheaf.germ ⊤ y trivial).hom T * h :=
by
  intro R _ Y _ σ T hker y hyeq V g hy hg
  subst hyeq
  have hU := isAffineOpen_top Y
  letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf
    (⟨σ (IsLocalRing.closedPoint R), trivial⟩ : (⊤ : Y.Opens))
  haveI hloc := hU.isLocalization_stalk ⟨σ (IsLocalRing.closedPoint R), trivial⟩
  obtain ⟨⟨a, s⟩, hE⟩ := IsLocalization.surj
    (hU.primeIdealOf ⟨σ (IsLocalRing.closedPoint R), trivial⟩).asIdeal.primeCompl
    ((Y.presheaf.germ V _ hy).hom g)
  have hunit := IsLocalization.map_units (Y.presheaf.stalk (σ (IsLocalRing.closedPoint R))) s
  change (Y.presheaf.germ V _ hy).hom g * (Y.presheaf.germ ⊤ _ trivial).hom (s : Γ(Y, ⊤)) =
    (Y.presheaf.germ ⊤ _ trivial).hom a at hE
  change IsUnit ((Y.presheaf.germ ⊤ _ trivial).hom (s : Γ(Y, ⊤))) at hunit
  have hV := Scheme.germ_stalkClosedPointTo σ V hy
  have hT := Scheme.germ_stalkClosedPointTo σ ⊤ trivial
  have hψz : (Scheme.stalkClosedPointTo σ).hom ((Y.presheaf.germ V _ hy).hom g) = 0 := by
    have := congrArg (fun f => f.hom g) hV
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [this, hg, map_zero]
  have hψa : (Scheme.stalkClosedPointTo σ).hom ((Y.presheaf.germ ⊤ _ trivial).hom a) = 0 := by
    rw [← hE, map_mul, hψz, zero_mul]
  have hσa : σ.appTop.hom a = 0 := by
    have key : ∀ {A B : CommRingCat.{u}} (e : A ≅ B) (x : A), e.hom.hom x = 0 → x = 0 := by
      intro A B e x hx
      have h2 := congrArg e.inv.hom hx
      rw [map_zero] at h2
      rw [← h2]
      simp
    have := congrArg (fun f => f.hom a) hT
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [hψa] at this
    exact key _ _ this.symm
  have ha : a ∈ Ideal.span {T} := by rw [← hker]; exact hσa
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ha
  refine ⟨(Y.presheaf.germ ⊤ (σ (IsLocalRing.closedPoint R)) trivial).hom c *
    ((hunit.unit⁻¹ : (Y.presheaf.stalk (σ (IsLocalRing.closedPoint R)))ˣ) :
      Y.presheaf.stalk (σ (IsLocalRing.closedPoint R))), ?_⟩
  have hu : (↑hunit.unit : Y.presheaf.stalk (σ (IsLocalRing.closedPoint R))) =
      (Y.presheaf.germ ⊤ _ trivial).hom (s : Γ(Y, ⊤)) := hunit.unit_spec
  calc (Y.presheaf.germ V _ hy).hom g
      = (Y.presheaf.germ V _ hy).hom g * (↑hunit.unit * ↑hunit.unit⁻¹) := by
        rw [Units.mul_inv, mul_one]
    _ = (Y.presheaf.germ ⊤ _ trivial).hom a * ↑hunit.unit⁻¹ := by
        rw [← mul_assoc, hu, hE]
    _ = _ := by
        rw [← hc, map_mul]; ring

theorem wcpa_dj_lr1k_nsr_gcn_model_node : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W), c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (M' : Scheme.{u}) (rM : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), wcCsdIsBlowup (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔ wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c) rM → ∀ y : ↥M', rM y = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) (IsLocalRing.closedPoint ↥W) → (¬ ∃ ψ : ↥(M'.presheaf.stalk y), (M'.presheaf.germ ⊤ y trivial).hom (rM.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) = (M'.presheaf.germ ⊤ y trivial).hom ((rM ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)) * ψ) → ∀ q : ↥(Limits.pullback (rM ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))), Limits.pullback.fst (rM ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) q = y → ¬ ∃ O : (Limits.pullback (rM ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens, q ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ Limits.pullback.snd (rM ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
by
  intro Ω _ W c hc _hcm M' rM hrM y hy hND q hq
  classical

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f a = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self a
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2
  have hprinc : wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)}) := by
    unfold wcNcPrincipal
    have := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    rw [this]
  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
