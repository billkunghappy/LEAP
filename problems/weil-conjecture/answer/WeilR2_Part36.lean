      IsFractionRing.injective V (FractionRing V)
    have hjπ : IsUnit (((algebraMap V (FractionRing V)).comp ev) p) := by
      rw [RingHom.comp_apply, hevp]
      exact Ne.isUnit (fun h => hπ (hjinj (by rw [h, map_zero])))
    let E : Localization.Away p →+* FractionRing V :=
      IsLocalization.Away.lift (S := Localization.Away p) p hjπ
    have hEeq : ∀ t : T, E (algebraMap T (Localization.Away p) t) =
        ((algebraMap V (FractionRing V)).comp ev) t :=
      fun t => IsLocalization.Away.lift_eq (S := Localization.Away p) p hjπ t
    refine ⟨ev, E, hsurj, hevp, fun t => hEeq t, ?_⟩
    rintro ⟨v, hv⟩
    apply hnot
