  have hPU : ∀ {Y P : Scheme.{u}} (r : P ⟶ Y) (U0 : P.Opens), IsAffineOpen U0 →
      ∀ (φ : Γ(Y, ⊤) →+* Γ(P, U0)),
      (∀ (z : P) (hz : z ∈ U0) (a : Γ(Y, ⊤)), (P.presheaf.germ U0 z hz).hom (φ a) =
        (P.presheaf.germ ⊤ z trivial).hom (r.appTop.hom a)) →
      ∀ (τ : Fin 2 → Γ(P, U0)), τ 0 = 1 →
      (∀ s : Γ(P, U0), s ∈ Subring.closure (Set.range φ ∪ Set.range τ)) →
      ∀ (ρ ρ' : ↥P) (hρ : ρ ∈ U0) (hρ' : ρ' ∈ U0), r ρ = r ρ' →
      ¬ IsUnit ((P.presheaf.germ U0 ρ hρ).hom (τ 1)) →
      ¬ IsUnit ((P.presheaf.germ U0 ρ' hρ').hom (τ 1)) → ρ = ρ' := by
    intro Y P r U0 hU0 φ hφ τ hτ0 hgen ρ ρ' hρ hρ' hrr hn hn'

    have hD : ∀ f : Γ(P, U0), ∃ (a : Γ(Y, ⊤)) (c : Γ(P, U0)), f = φ a + τ 1 * c := by
      intro f
      have hf := hgen f
      induction hf using Subring.closure_induction with
      | mem x hx =>
        rcases hx with ⟨a, rfl⟩ | ⟨i, hi⟩
        · exact ⟨a, 0, by rw [mul_zero, add_zero]⟩
        · rcases (Fin.exists_fin_two (p := fun j => τ j = x)).mp ⟨i, hi⟩ with h | h
          · subst h
            exact ⟨1, 0, by rw [hτ0, map_one, mul_zero, add_zero]⟩
          · subst h
            exact ⟨0, 1, by rw [map_zero, mul_one, zero_add]⟩
      | zero => exact ⟨0, 0, by rw [map_zero, mul_zero, add_zero]⟩
      | one => exact ⟨1, 0, by rw [map_one, mul_zero, add_zero]⟩
      | add x x' _ _ hx hx' =>
        obtain ⟨a, c, rfl⟩ := hx
        obtain ⟨a', c', rfl⟩ := hx'
        exact ⟨a + a', c + c', by rw [map_add]; ring⟩
      | neg x _ hx =>
        obtain ⟨a, c, rfl⟩ := hx
        exact ⟨-a, -c, by rw [map_neg]; ring⟩
      | mul x x' _ _ hx hx' =>
        obtain ⟨a, c, rfl⟩ := hx
        obtain ⟨a', c', rfl⟩ := hx'
        exact ⟨a * a', c * φ a' + φ a * c' + τ 1 * c * c', by rw [map_mul]; ring⟩

    have hIC : ∀ (z : P) (hz : z ∈ U0), ¬ IsUnit ((P.presheaf.germ U0 z hz).hom (τ 1)) →
        ∀ (a : Γ(Y, ⊤)) (c : Γ(P, U0)),
        (z ∈ P.basicOpen (φ a + τ 1 * c) ↔ r z ∈ Y.basicOpen a) := by
      intro z hz hnz a c
      refine (Scheme.mem_basicOpen P _ z hz).trans
        (Iff.trans ?_ (Scheme.mem_basicOpen Y a (r z) trivial).symm)
      have hm' : (P.presheaf.germ U0 z hz).hom (τ 1) * (P.presheaf.germ U0 z hz).hom c ∈
          IsLocalRing.maximalIdeal _ :=
        Ideal.mul_mem_right _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnz))
      have e1 : (P.presheaf.germ U0 z hz).hom (φ a + τ 1 * c) =
          (P.presheaf.germ U0 z hz).hom (φ a) +
            (P.presheaf.germ U0 z hz).hom (τ 1) * (P.presheaf.germ U0 z hz).hom c := by
        rw [map_add, map_mul]
      have e3 : (r.stalkMap z).hom ((Y.presheaf.germ ⊤ (r z) trivial).hom a) =
          (P.presheaf.germ ⊤ z trivial).hom (r.appTop.hom a) :=
        Scheme.Hom.germ_stalkMap_apply r ⊤ z trivial a
      calc IsUnit ((P.presheaf.germ U0 z hz).hom (φ a + τ 1 * c))
          ↔ IsUnit ((P.presheaf.germ U0 z hz).hom (φ a)) := by rw [e1]; exact key _ _ _ hm'
        _ ↔ IsUnit ((r.stalkMap z).hom ((Y.presheaf.germ ⊤ (r z) trivial).hom a)) := by
          rw [hφ z hz a, e3]
