        A.valuation (φ μ₂ * ε ^ k₂ * u₂) := by
    intro ε hε μ₁ μ₂ k₁ k₂ u₁ u₂ hμ₁ hμ₂ hu₁ hu₂ hinf hle
    have hvu : ∀ u : L, A.valuation (u - 1) < 1 → A.valuation u = 1 := fun u hu => by
      have := Valuation.map_eq_of_sub_lt A.valuation
        (by rwa [map_one] : A.valuation (u - 1) < A.valuation 1)
      rwa [map_one] at this
