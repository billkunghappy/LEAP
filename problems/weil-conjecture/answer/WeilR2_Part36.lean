theorem wcLlsASm_integral_node : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g β b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    β ∣ b → ¬ b ∣ β → b ∣ g → ((ℓ : ℕ) : K) = 0 → Module.finrank K L = ℓ →
