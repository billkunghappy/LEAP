  have e : ⊤ ≤ σ₀ ⁻¹ᵁ U := (Scheme.preimage_eq_top_of_closedPoint_mem σ₀ hσU).ge
  obtain ⟨g, hgT, hkerθ, hσg⟩ := L4 (.of ↥W) X U σ₀ ΔU _ hΔι hker e
  refine ⟨U, hU, g, hσx ▸ hσU, hσg, ?_, ?_⟩
  · intro a
    have hle : U ≤ uX ⁻¹ᵁ ⊤ := le_of_le_of_eq le_top (Scheme.Hom.preimage_top uX).symm
    rw [wcpa_dj_lr1k_ll_dp_centre_ideal Ω W X uX σ₀ hσ U hU hle e a]
    exact L5 _ (wcGcfStr uX U) g
      (fun b => wcpa_dj_lr1k_ll_dp_theta_phi ↥W X uX σ₀ hσ U hle e b) hkerθ a
