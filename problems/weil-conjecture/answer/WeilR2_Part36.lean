  have hψ : Function.Injective ψ := fun σ τ h => AlgEquiv.restrictScalars_injective K h
  haveI : Group.IsSolvable (L' ≃ₐ[M'] L') :=
    Group.isSolvable_of_isSolvable_injective (f := ψ.comp ρ) (hψ.comp hρinj)
  have hcard : Nat.card ↥(wcLlsDec (Localization.Away w) M' L' y₁) ≤ Nat.card (L ≃ₐ[M] L) :=
    (Subgroup.card_le_card_group _).trans (Nat.card_le_card_of_injective ρ hρinj)
  refine ⟨Localization.Away w, inferInstance, hdomBw, inferInstance, M', inferInstance,
    inferInstance, inferInstance, L', inferInstance, inferInstance, inferInstance, inferInstance,
    hFD, hGal, 𝔮.map (algebraMap B (Localization.Away w)), algebraMap B (Localization.Away w) x,
    algebraMap B (Localization.Away w) x', g', y₁, e, he, hPDw,
    ⟨hy₁p, hy₁', inferInstance, fun _ t ht => by cases ht⟩, hcard, hgb, hbg, ?_⟩

  exact wcpa_dj_llsm_neat_radius_transfer Ω W hW hWt A K M L 𝔭 k hPD z0 b₁ hb₁m hb₁0 hshape s hs
    Q hQ' (Localization.Away w) ((algebraMap B (Localization.Away w)).comp ι)
    (𝔮.map (algebraMap B (Localization.Away w))) (algebraMap B (Localization.Away w) x)
    (algebraMap B (Localization.Away w) x') g' hιwet hιwinj hιwW hιwQ hPDw e
