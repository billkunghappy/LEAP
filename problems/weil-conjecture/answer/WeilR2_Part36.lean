    hιwF hgb hbg M' hlift L' lam hlam hadj

theorem wcpa_dj_llsm_sm_fs_uniformizer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (𝔭 : Ideal A) (t : A) (z : Ideal ↥(integralClosure A M)),
    wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : z.IsPrime), z.comap (algebraMap A ↥(integralClosure A M)) = 𝔭 → wcLlsUniq A M 𝔭 z →
    wcpaDjLkDelta (wcLlsFS W ((algebraMap A M).comp (algebraMap ↥W A)) A z) = 0 →
    ∃ τ : ↥(integralClosure A M), τ ∈ z ∧
      IsDomain (wcLlsFS W ((algebraMap A M).comp (algebraMap ↥W A)) A z) ∧
      wcLlsSmQ W ((algebraMap A M).comp (algebraMap ↥W A)) A z τ ≠ 0 ∧
      ¬ IsUnit (wcLlsSmQ W ((algebraMap A M).comp (algebraMap ↥W A)) A z τ) ∧
      ∀ x : wcLlsFS W ((algebraMap A M).comp (algebraMap ↥W A)) A z, ¬ IsUnit x →
        wcLlsSmQ W ((algebraMap A M).comp (algebraMap ↥W A)) A z τ ∣ x :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ 𝔭 t z hPD hzP hzc hzU hδ
  classical
  haveI := hzP

  have s3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [_root_.IsReduced R],
      ringKrullDim R = ((1 : ℕ) : WithBot ℕ∞) → IsRegularLocalRing R →
      IsDomain R ∧ ∃ π : R, π ≠ 0 ∧ IsLocalRing.maximalIdeal R = Ideal.span {π} := by
    intro R _ _ _ _ hdim hreg
    have h1 : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal R) : ℕ) : WithBot ℕ∞) =
        ((1 : ℕ) : WithBot ℕ∞) := hreg.spanFinrank_maximalIdeal.trans hdim
    have h1' : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) = 1 := by exact_mod_cast h1
    have hfg : Submodule.FG (IsLocalRing.maximalIdeal R) := IsNoetherian.noetherian _
    obtain ⟨s, hs1, hs2⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
    rw [h1'] at hs1
    obtain ⟨π, rfl⟩ := Set.encard_eq_one.mp (by simpa using hs1)
    have hmax : IsLocalRing.maximalIdeal R = Ideal.span {π} := hs2.symm
    have hπ0 : π ≠ 0 := by
      rintro rfl
      have hbot : IsLocalRing.maximalIdeal R = ⊥ := by rw [hmax, Ideal.span_singleton_eq_bot]
      have hF : IsField R := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot
      have h0 := ringKrullDim_eq_zero_of_isField hF
      rw [h0] at hdim
      simp at hdim
    have hne : IsLocalRing.maximalIdeal R ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hkrull := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R) hne
    have hnf : ∀ x : R, x ≠ 0 → ∃ (n : ℕ) (u : R), IsUnit u ∧ x = u * π ^ n := by
      intro x hx
      have hex : ∃ N, x ∉ Ideal.span {π ^ N} := by
        by_contra hcon
        push_neg at hcon
        apply hx
        have hmem : x ∈ ⨅ i, (IsLocalRing.maximalIdeal R) ^ i := by
          rw [Submodule.mem_iInf]
          intro i
          rw [hmax, Ideal.span_singleton_pow]
          exact hcon i
        rw [hkrull] at hmem
        exact (Submodule.mem_bot R).mp hmem
      have hN : x ∉ Ideal.span {π ^ Nat.find hex} := Nat.find_spec hex
      have hN0 : Nat.find hex ≠ 0 := by
        intro h0
        apply hN
        rw [h0, pow_zero, Ideal.span_singleton_one]
        exact Submodule.mem_top
      obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hN0
      have hxn : x ∈ Ideal.span {π ^ n} := not_not.mp (Nat.find_min hex (by omega))
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hxn
      refine ⟨n, u, ?_, hu.symm⟩
      by_contra hu'
      have hum : u ∈ IsLocalRing.maximalIdeal R :=
        (IsLocalRing.mem_maximalIdeal u).mpr (mem_nonunits_iff.mpr hu')
      rw [hmax] at hum
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hum
      apply hN
      rw [hn, Ideal.mem_span_singleton']
      exact ⟨v, by rw [← hu, ← hv, pow_succ]; ring⟩
    have hnz : NoZeroDivisors R := by
      constructor
      intro a b hab
      by_contra h
      push_neg at h
      obtain ⟨n, u, hu, hau⟩ := hnf a h.1
      obtain ⟨k, v, hv, hbv⟩ := hnf b h.2
      have hprod : (u * v) * π ^ (n + k) = 0 := by rw [← hab, hau, hbv]; ring
      have hp : π ^ (n + k) = 0 := (hu.mul hv).mul_right_eq_zero.mp hprod
      exact hπ0 (IsReduced.eq_zero π ⟨n + k, hp⟩)
    haveI := hnz
    exact ⟨NoZeroDivisors.to_isDomain R, π, hπ0, hmax⟩

  have s4 : ∀ (C : Type u) [CommRing C] (z : Ideal C) [z.IsPrime]
      (J : Ideal (Localization.AtPrime z)) (π : Localization.AtPrime z ⧸ J), π ≠ 0 →
      ¬ IsUnit π → (∀ x : Localization.AtPrime z ⧸ J, ¬ IsUnit x → π ∣ x) →
      ∃ τ : C, τ ∈ z ∧ Ideal.Quotient.mk J (algebraMap C (Localization.AtPrime z) τ) ≠ 0 ∧
        ¬ IsUnit (Ideal.Quotient.mk J (algebraMap C (Localization.AtPrime z) τ)) ∧
        ∀ x : Localization.AtPrime z ⧸ J, ¬ IsUnit x →
          Ideal.Quotient.mk J (algebraMap C (Localization.AtPrime z) τ) ∣ x := by
    intro C _ z _ J π hπ0 hπu hdiv
    obtain ⟨ξ, rfl⟩ := Ideal.Quotient.mk_surjective π
    obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.mk'_surjective z.primeCompl ξ
    dsimp only at hcs
    subst hcs
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime z) c s
    have hεu : IsUnit (Ideal.Quotient.mk J (algebraMap C (Localization.AtPrime z) s)) :=
      (IsLocalization.map_units (Localization.AtPrime z) s).map _
    have hq : Ideal.Quotient.mk J (algebraMap C (Localization.AtPrime z) c) =
        Ideal.Quotient.mk J (IsLocalization.mk' (Localization.AtPrime z) c s) *
          Ideal.Quotient.mk J (algebraMap C (Localization.AtPrime z) s) := by
      rw [← map_mul, hspec]
    have hnu : ¬ IsUnit (Ideal.Quotient.mk J (algebraMap C (Localization.AtPrime z) c)) := by
      rw [hq, IsUnit.mul_iff]; exact fun h => hπu h.1
    refine ⟨c, ?_, ?_, hnu, ?_⟩
    · by_contra hc
      apply hnu
      exact (IsLocalization.map_units (Localization.AtPrime z) (⟨c, hc⟩ : z.primeCompl)).map _
    · rw [hq]; intro h; exact hπ0 (hεu.mul_left_eq_zero.mp h)
    · intro x hx
      obtain ⟨y, hy⟩ := hdiv x hx
      obtain ⟨e, he⟩ := hεu.exists_left_inv
      refine ⟨e * y, ?_⟩
