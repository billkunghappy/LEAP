    have hU : IsUnit (q.eval c) := by
      by_contra hn
      have h1 : q.eval c ∈ IsLocalRing.maximalIdeal ↥W :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hn)
      have h2 : q.eval c - q.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
        have hd := Polynomial.sub_dvd_eval_sub c 0 q
        rw [sub_zero, ← Polynomial.coeff_zero_eq_eval_zero] at hd
