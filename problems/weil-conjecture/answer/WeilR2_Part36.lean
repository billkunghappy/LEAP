    ∀ (V : X.Opens) (g : Γ(X, V)) (hη : genericPoint ↥C ∈ (γ ≫ ι) ⁻¹ᵁ V)
      (hx : (γ ≫ ι) (genericPoint ↥C) ⤳ wcpaDjLkImg W (γ ≫ ι) uX y₀),
      wcUrChart W γ ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) V g hη hx →
      wcpaDjLlDiscParam W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) (wcUrTau W V g) :=
by
  intro Ω _ _ W C _ γ X uX ι _ _ y₀ τ hH V g hη hx hCh
  obtain ⟨hW, -, -, -, hM, -, -, -, -, -⟩ := hH
  obtain ⟨hV, hxV, hinj, hgt, hgm, htr, hdict⟩ := hCh
  haveI : IsProper uX := hM.1.2.1
  haveI : Flat uX := hM.1.1
  have hlfp : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) X uX hM.1.1 inferInstance
  have hle : V ≤ uX ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  have hGκ0 := (wcpa_dj_lr1k_nsr_nlb_ue_ur_const_germ Ω W C γ X uX ι hM _ hx).1
  set x := wcpaDjLkImg W (γ ≫ ι) uX y₀ with hxdef
  set s₀ := (X.presheaf.germ V x hxV).hom g with hs₀
  set t := wcUrT (γ ≫ ι) V g hη with ht
