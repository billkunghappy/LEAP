    exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have s2 (Y N : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] [AlgebraicGeometry.IsIntegral N]
      (p : Y ⟶ N) [IsProper p] (hgen : p (genericPoint ↥Y) = genericPoint ↥N)
      (hiso : IsIso (p.stalkMap (genericPoint ↥Y))) (n : ↥N)
      (hic : IsIntegrallyClosed ↥(N.presheaf.stalk n)) :
      ∃ (R : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral R)
