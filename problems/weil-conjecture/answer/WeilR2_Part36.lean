    constructor
    · intro hlt
      by_contra hn
      rw [hOeq _ (fun h => hn (hCb.mp h))] at hlt
      exact lt_irrefl _ hlt
    · intro h
      exact hOlt' _ (hCb.mpr h)
  · obtain ⟨i, hi⟩ := hp
    have hnot : p.map (algebraMap ↥W B) ∉ P := by
