      · rcases le_or_gt e δ' with h' | h'
        · have : δ' = e := le_antisymm hδ'e h'
          rw [this] at hle; exact absurd hB (not_lt.mpr hle)
        · have hT : δ' ∈ (insert 0 (l.map d).toFinset).filter
              (fun a => a < e ∧ (l.map (fun i => max a (d i))).prod ≤ B) :=
            Finset.mem_filter.mpr ⟨Finset.mem_insert_of_mem hmem, h', hle⟩
