theorem wcpa_dj_lr1k_nsr_nlb_lv_dom_affine : ∀ (C Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (h : C ⟶ Y) (R : CommRingCat.{u}) [IsLocalRing ↑R] (τ : Spec R ⟶ Y) (U : Y.Opens),
    IsAffineOpen U → ∀ (e : ⊤ ≤ τ ⁻¹ᵁ U) (hη : genericPoint ↥C ∈ h ⁻¹ᵁ U),
    h (genericPoint ↥C) ⤳ τ (IsLocalRing.closedPoint ↑R) →
    ∀ A : ValuationSubring C.functionField,
      (wcNsrNaDom A h (τ (IsLocalRing.closedPoint ↑R)) ↔
        ((∀ s : Γ(Y, U), A.valuation
            ((C.presheaf.germ (h ⁻¹ᵁ U) (genericPoint ↥C) hη).hom ((h.app U).hom s)) ≤ 1) ∧
          ∀ s : Γ(Y, U), ((Scheme.ΓSpecIso R).hom.hom ((τ.appLE U ⊤ e).hom s) ∈
              IsLocalRing.maximalIdeal ↑R ↔
            A.valuation
              ((C.presheaf.germ (h ⁻¹ᵁ U) (genericPoint ↥C) hη).hom ((h.app U).hom s)) < 1))) :=
by
  intro C Y _ h R _ τ U hU e hη hspec A
  have hyU : τ (IsLocalRing.closedPoint ↑R) ∈ U :=
    e (show IsLocalRing.closedPoint ↑R ∈ (⊤ : (Spec R).Opens) from trivial)

  have alg : ∀ {B S R' K : Type u} [CommRing B] [CommRing S] [IsLocalRing S] [CommRing R']
      [IsLocalRing R'] [Field K] (g : B →+* S) (φ : S →+* R') (Λ : S →+* K)
      (A : ValuationSubring K), IsLocalHom φ → (∀ t : S, ∃ b c : B, IsUnit (g c) ∧ t * g c = g b) →
      (((∀ t : S, A.valuation (Λ t) ≤ 1) ∧ ∀ t ∈ IsLocalRing.maximalIdeal S, A.valuation (Λ t) < 1) ↔
        ((∀ b : B, A.valuation (Λ (g b)) ≤ 1) ∧
          ∀ b : B, (φ (g b) ∈ IsLocalRing.maximalIdeal R' ↔ A.valuation (Λ (g b)) < 1))) := by
    intro B S R' K _ _ _ _ _ _ g φ Λ A hφ hfrac
    have hF : ∀ t : S, t ∈ IsLocalRing.maximalIdeal S ↔ φ t ∈ IsLocalRing.maximalIdeal R' := by
      intro t
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        mem_nonunits_iff]
      exact not_congr ⟨fun h => h.map φ, fun h => isUnit_of_map_unit φ t h⟩
    have hUn : ∀ z : S, IsUnit z → (∀ t : S, A.valuation (Λ t) ≤ 1) →
        ¬ A.valuation (Λ z) < 1 := by
      intro z hz H hlt
      obtain ⟨w, hw⟩ := hz.exists_right_inv
      have h1 : A.valuation (Λ z) * A.valuation (Λ w) = 1 := by
        rw [← map_mul, ← map_mul, hw, map_one, map_one]
      have h2 : A.valuation (Λ z) * A.valuation (Λ w) < 1 :=
        lt_of_le_of_lt (mul_le_of_le_one_right' (H w)) hlt
      rw [h1] at h2
      exact lt_irrefl _ h2
    constructor
    · rintro ⟨H1, H2⟩
      refine ⟨fun b => H1 (g b), fun b => ⟨fun hb => H2 _ ((hF _).mpr hb), fun hb => ?_⟩⟩
      by_contra hn
      have hu : IsUnit (g b) := by
        by_contra hnu
        exact hn ((hF _).mp ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)))
      exact hUn _ hu H1 hb
    · rintro ⟨H1, H2⟩
      have key : ∀ t : S, ∃ b : B, A.valuation (Λ t) = A.valuation (Λ (g b)) ∧
          (t ∈ IsLocalRing.maximalIdeal S → g b ∈ IsLocalRing.maximalIdeal S) := by
        intro t
        obtain ⟨b, c, hc, htc⟩ := hfrac t
        have hc1 : A.valuation (Λ (g c)) = 1 := by
          have hnm : ¬ A.valuation (Λ (g c)) < 1 := by
            intro hlt
            have h3 := (hF _).mpr ((H2 c).mpr hlt)
            exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h3)) hc
          exact le_antisymm (H1 c) (not_lt.mp hnm)
        refine ⟨b, ?_, fun ht => ?_⟩
        · rw [← htc, map_mul, map_mul, hc1, mul_one]
        · rw [← htc]; exact Ideal.mul_mem_right _ _ ht
      refine ⟨fun t => ?_, fun t ht => ?_⟩
      · obtain ⟨b, hb, -⟩ := key t
        rw [hb]; exact H1 b
      · obtain ⟨b, hb, hm⟩ := key t
        rw [hb]; exact (H2 b).mp ((hF _).mp (hm ht))

  have s2 : ∀ s : Γ(Y, U), (wcLr1uGerm h (τ (IsLocalRing.closedPoint ↑R)) hspec).hom
      ((Y.presheaf.germ U (τ (IsLocalRing.closedPoint ↑R)) hyU).hom s) =
      (C.presheaf.germ (h ⁻¹ᵁ U) (genericPoint ↥C) hη).hom ((h.app U).hom s) := by
    intro s
    unfold wcLr1uGerm
    rw [CommRingCat.comp_apply, TopCat.Presheaf.germ_stalkSpecializes_apply]
    exact Scheme.Hom.germ_stalkMap_apply h U (genericPoint C) hη s

  have s3 : ∀ s : Γ(Y, U), (Scheme.stalkClosedPointTo τ).hom
      ((Y.presheaf.germ U (τ (IsLocalRing.closedPoint ↑R)) hyU).hom s) =
      (Scheme.ΓSpecIso R).hom.hom ((τ.appLE U ⊤ e).hom s) := by
    intro s
    rw [← CommRingCat.comp_apply, Scheme.germ_stalkClosedPointTo]
    simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.op_hom, eqToIso.hom, CommRingCat.comp_apply]
    rfl

  have s4 : ∀ t : Y.presheaf.stalk (τ (IsLocalRing.closedPoint ↑R)), ∃ b c : Γ(Y, U),
      IsUnit ((Y.presheaf.germ U (τ (IsLocalRing.closedPoint ↑R)) hyU).hom c) ∧
      t * (Y.presheaf.germ U (τ (IsLocalRing.closedPoint ↑R)) hyU).hom c =
        (Y.presheaf.germ U (τ (IsLocalRing.closedPoint ↑R)) hyU).hom b := by
    intro t
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk (τ (IsLocalRing.closedPoint ↑R))) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨τ (IsLocalRing.closedPoint ↑R), hyU⟩
    have := hU.isLocalization_stalk ⟨τ (IsLocalRing.closedPoint ↑R), hyU⟩
    obtain ⟨⟨b, c⟩, hbc⟩ := IsLocalization.surj
      (hU.primeIdealOf ⟨τ (IsLocalRing.closedPoint ↑R), hyU⟩).asIdeal.primeCompl t
    refine ⟨b, c, ?_, ?_⟩
    · exact IsLocalization.map_units (Y.presheaf.stalk (τ (IsLocalRing.closedPoint ↑R))) c
    · exact hbc
  haveI := Scheme.isLocalHom_stalkClosedPointTo τ
  have hmain := alg (Y.presheaf.germ U (τ (IsLocalRing.closedPoint ↑R)) hyU).hom
    (Scheme.stalkClosedPointTo τ).hom (wcLr1uGerm h (τ (IsLocalRing.closedPoint ↑R)) hspec).hom A
    inferInstance s4
  simp only [s2, s3] at hmain
  rw [← hmain]
  unfold wcNsrNaDom
  constructor
  · rintro ⟨_, H⟩; exact H
  · intro H; exact ⟨hspec, H⟩

theorem wcpa_dj_lr1k_nsr_nlb_lv_dq_algebra : ∀ {W R R₁ L : Type u} [CommRing W] [IsDomain W]
    [IsLocalRing W] [CommRing R] [CommRing R₁] [Field L] (φ : W →+* R) (ev evσ : R →+* W)
    (ρ : R →+* R₁) (ψ : R₁ →+* W) (G₁ : R₁ →+* L) (a : W) (b : R) (T : Set R₁)
    (A : ValuationSubring L),
    ev.comp φ = RingHom.id W → evσ.comp φ = RingHom.id W → ψ.comp ρ = ev → a ≠ 0 →
    G₁ (ρ (φ a)) ≠ 0 →
    (∀ f, ev f = 0 → evσ f ∈ Ideal.span {a}) →
    (∀ f, evσ f ∈ Ideal.span {a} → ∃ y, ρ f = y * ρ b) →
    evσ b ∈ Ideal.span {a} →
    (∀ t ∈ T, ∃ f, evσ f ∈ Ideal.span {a} ∧ ρ f = t * ρ b) →
    (∀ s, s ∈ Subring.closure (Set.range ρ ∪ T)) →
    (((∀ s, A.valuation (G₁ s) ≤ 1) ∧
        ∀ s, (ψ s ∈ IsLocalRing.maximalIdeal W ↔ A.valuation (G₁ s) < 1)) ↔
      ((∀ c, A.valuation (G₁ (ρ (φ c))) ≤ 1 ∧
          (c ∈ IsLocalRing.maximalIdeal W → A.valuation (G₁ (ρ (φ c))) < 1)) ∧
        ∀ f, A.valuation (G₁ (ρ f) - G₁ (ρ (φ (ev f)))) < A.valuation (G₁ (ρ (φ a))))) :=
by
  intro W R R₁ L _ _ _ _ _ _ φ ev evσ ρ ψ G₁ a b T A Hev Hevσ Hψρ Ha Hα H1 H2 H3 H4 H5
  have hev : ∀ c, ev (φ c) = c := fun c => RingHom.congr_fun Hev c
  have hevσ : ∀ c, evσ (φ c) = c := fun c => RingHom.congr_fun Hevσ c
  have hψρ : ∀ f, ψ (ρ f) = ev f := fun f => RingHom.congr_fun Hψρ f

  have hb : ev b ∈ Ideal.span {a} := by
    have h0 : ev (b - φ (ev b)) = 0 := by rw [map_sub, hev, sub_self]
    have h1 := H1 _ h0
    rw [map_sub, hevσ] at h1
    have h2 := Ideal.sub_mem _ H3 h1
    rwa [sub_sub_cancel] at h2
  obtain ⟨k, hk⟩ := Ideal.mem_span_singleton'.mp hb
  obtain ⟨y, hy⟩ := H2 (φ a) (by rw [hevσ]; exact Ideal.mem_span_singleton_self a)
  have hyk : ψ y * k = 1 := by
    have e := congrArg ψ hy
    rw [hψρ, hev, map_mul, hψρ, ← hk] at e
    apply mul_right_cancel₀ Ha
    rw [one_mul, mul_assoc]
    exact e.symm
  have hka : k * a ≠ 0 := by
    intro h
    rcases mul_eq_zero.mp h with h | h
    · rw [h, mul_zero] at hyk
      exact zero_ne_one hyk
    · exact Ha h
  constructor
  ·
    rintro ⟨L1, L2⟩
    refine ⟨fun c => ⟨L1 _, fun hc => (L2 _).mp (by rw [hψρ, hev]; exact hc)⟩, ?_⟩
    have hψy : ψ y ∉ IsLocalRing.maximalIdeal W := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
      exact ⟨⟨ψ y, k, hyk, by rw [mul_comm]; exact hyk⟩, rfl⟩
    have hvy : A.valuation (G₁ y) = 1 :=
      le_antisymm (L1 y) (not_lt.mp (fun h => hψy ((L2 y).mpr h)))
    have hαβ : A.valuation (G₁ (ρ (φ a))) = A.valuation (G₁ (ρ b)) := by
      rw [hy, map_mul, Valuation.map_mul, hvy, one_mul]
    have hβ0 : A.valuation (G₁ (ρ b)) ≠ 0 := by
      rw [← hαβ]
      exact (Valuation.ne_zero_iff _).mpr Hα
    intro f
    obtain ⟨z, hz⟩ := H2 _ (H1 (f - φ (ev f)) (by rw [map_sub, hev, sub_self]))
    have hψz : ψ z = 0 := by
      have e := congrArg ψ hz
      rw [hψρ, map_sub, hev, sub_self, map_mul, hψρ, ← hk] at e
      exact (mul_eq_zero.mp e.symm).resolve_right hka
    have hvz : A.valuation (G₁ z) < 1 := (L2 z).mp (by rw [hψz]; exact Ideal.zero_mem _)
    have e : G₁ (ρ f) - G₁ (ρ (φ (ev f))) = G₁ z * G₁ (ρ b) := by
      rw [← map_mul, ← hz, map_sub, map_sub]
    rw [e, Valuation.map_mul, hαβ]
    exact mul_lt_of_lt_one_left (zero_lt_iff.mpr hβ0) hvz
  ·
    rintro ⟨R1, R2⟩
    have hunit : ∀ c : W, c ∉ IsLocalRing.maximalIdeal W →
        A.valuation (G₁ (ρ (φ c))) = 1 := by
      intro c hc
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hc
      obtain ⟨u, rfl⟩ := hc
      have e : A.valuation (G₁ (ρ (φ ↑u))) * A.valuation (G₁ (ρ (φ ↑u⁻¹))) = 1 := by
        rw [← Valuation.map_mul, ← map_mul, ← map_mul, ← map_mul, Units.mul_inv, map_one,
          map_one, map_one, Valuation.map_one]
      apply le_antisymm (R1 _).1
      calc (1 : A.ValueGroup) = _ := e.symm
        _ ≤ _ := mul_le_of_le_one_right' (R1 _).1
    have hk1 : A.valuation (G₁ (ρ (φ k))) = 1 := hunit k (by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
      exact ⟨⟨k, ψ y, by rw [mul_comm]; exact hyk, hyk⟩, rfl⟩)
    have hα1 : A.valuation (G₁ (ρ (φ a))) ≤ 1 := (R1 a).1
    have hkα : G₁ (ρ (φ (ev b))) = G₁ (ρ (φ k)) * G₁ (ρ (φ a)) := by
      rw [← hk]; simp only [map_mul]
    have hvkα : A.valuation (G₁ (ρ (φ k)) * G₁ (ρ (φ a))) = A.valuation (G₁ (ρ (φ a))) := by
      rw [Valuation.map_mul, hk1, one_mul]
    have hbk : A.valuation (G₁ (ρ b) - G₁ (ρ (φ k)) * G₁ (ρ (φ a))) <
        A.valuation (G₁ (ρ (φ a))) := by
      rw [← hkα]; exact R2 b
    have hβ : A.valuation (G₁ (ρ b)) = A.valuation (G₁ (ρ (φ a))) := by
      rw [← hvkα]
      apply Valuation.map_eq_of_sub_lt
      rw [hvkα]
      exact hbk
    have hθ1 : ∀ s, A.valuation (G₁ (ρ (φ (ψ s)))) ≤ 1 := fun s => (R1 _).1
    have P : ∀ s, A.valuation (G₁ s - G₁ (ρ (φ (ψ s)))) < 1 := by
      intro s
      refine Subring.closure_induction
        (p := fun s _ => A.valuation (G₁ s - G₁ (ρ (φ (ψ s)))) < 1) ?_ ?_ ?_ ?_ ?_ ?_ (H5 s)
      · intro x hx
        rcases hx with ⟨f, rfl⟩ | ht
        · rw [hψρ]
          exact lt_of_lt_of_le (R2 f) hα1
        · obtain ⟨f, -, hf⟩ := H4 x ht
          have hevf : ev f = ψ x * (k * a) := by rw [← hψρ, hf, map_mul, hψρ, hk]
          have key : (G₁ x - G₁ (ρ (φ (ψ x)))) * G₁ (ρ b) =
              (G₁ (ρ f) - G₁ (ρ (φ (ev f)))) -
                G₁ (ρ (φ (ψ x))) * (G₁ (ρ b) - G₁ (ρ (φ k)) * G₁ (ρ (φ a))) := by
            rw [hevf, hf]
            simp only [map_mul]
            ring
          have hlt : A.valuation ((G₁ x - G₁ (ρ (φ (ψ x)))) * G₁ (ρ b)) <
              A.valuation (G₁ (ρ b)) := by
            rw [key, hβ, sub_eq_add_neg]
            apply Valuation.map_add_lt _ (R2 f)
            rw [Valuation.map_neg, Valuation.map_mul]
            exact lt_of_le_of_lt (mul_le_of_le_one_left' (hθ1 x)) hbk
          rw [Valuation.map_mul] at hlt
          by_contra hc
          exact absurd hlt (not_lt.mpr (le_mul_of_one_le_left' (not_lt.mp hc)))
      · simp
      · simp
      · intro x z _ _ hx hz
        have e : G₁ (x + z) - G₁ (ρ (φ (ψ (x + z)))) =
            (G₁ x - G₁ (ρ (φ (ψ x)))) + (G₁ z - G₁ (ρ (φ (ψ z)))) := by
          simp only [map_add]; ring
        rw [e]
        exact Valuation.map_add_lt _ hx hz
      · intro x _ hx
        have e : G₁ (-x) - G₁ (ρ (φ (ψ (-x)))) = -(G₁ x - G₁ (ρ (φ (ψ x)))) := by
          simp only [map_neg]; ring
        rw [e, Valuation.map_neg]
        exact hx
      · intro x z _ _ hx hz
        have hGz : A.valuation (G₁ z) ≤ 1 := by
          have e : G₁ z = G₁ (ρ (φ (ψ z))) + (G₁ z - G₁ (ρ (φ (ψ z)))) := by ring
          rw [e]
          exact Valuation.map_add_le _ (hθ1 z) hz.le
        have e : G₁ (x * z) - G₁ (ρ (φ (ψ (x * z)))) =
            (G₁ x - G₁ (ρ (φ (ψ x)))) * G₁ z +
              G₁ (ρ (φ (ψ x))) * (G₁ z - G₁ (ρ (φ (ψ z)))) := by
          simp only [map_mul]; ring
        rw [e]
        apply Valuation.map_add_lt
        · rw [Valuation.map_mul]
          exact lt_of_le_of_lt (mul_le_of_le_one_right' hGz) hx
        · rw [Valuation.map_mul]
          exact lt_of_le_of_lt (mul_le_of_le_one_left' (hθ1 x)) hz
    refine ⟨fun s => ?_, fun s => ⟨fun hs => ?_, fun hs => ?_⟩⟩
    · have e : G₁ s = G₁ (ρ (φ (ψ s))) + (G₁ s - G₁ (ρ (φ (ψ s)))) := by ring
      rw [e]
      exact Valuation.map_add_le _ (hθ1 s) (P s).le
    · have e : G₁ s = G₁ (ρ (φ (ψ s))) + (G₁ s - G₁ (ρ (φ (ψ s)))) := by ring
      rw [e]
      exact Valuation.map_add_lt _ ((R1 _).2 hs) (P s)
    · by_contra hns
      have h1 := hunit _ hns
      have e : A.valuation (G₁ s) = A.valuation (G₁ (ρ (φ (ψ s)))) :=
        Valuation.map_eq_of_sub_lt _ (by rw [h1]; exact P s)
      rw [e, h1] at hs
      exact lt_irrefl _ hs

theorem wcpa_dj_lr1k_nsr_nlb_lv_q_local : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (X : Scheme.{u}) (h : C ⟶ X)
    (uX : X ⟶ Spec (.of ↥W)) (x : ↥X) (σ' : Spec (.of ↥W) ⟶ X) (a : ↥W)
    (A : ValuationSubring C.functionField),
    σ' ≫ uX = 𝟙 _ → σ' (IsLocalRing.closedPoint ↥W) = x → h (genericPoint ↥C) ⤳ x →
