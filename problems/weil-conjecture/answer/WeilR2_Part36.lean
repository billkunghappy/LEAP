  obtain ⟨O, hO, hOe⟩ := hemb1.isInducing.isOpen_iff.mp hSmOpen
  have hSmIff : ∀ t : ↥(⇑(wcUePi γ ι ι₁ r₁ hι) ⁻¹' {wcNdPt W (γ ≫ ι) uX y₀}),
      wcUeSmPt W (r₁ ≫ uX) ((γ ≫ ι₁).fromNormalization t.1) ↔
        (γ ≫ ι₁).fromNormalization t.1 ∈ O := by
    intro t
    constructor
    · rintro ⟨w, hw, hsm⟩
      have h1 : w ∈ (Limits.pullback.fst (r₁ ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹' O := by
        rw [hOe]; exact hsm
      rw [← hw]; exact h1
    · intro h
      obtain ⟨w, hw⟩ := hlift (r₁ ≫ uX) ((γ ≫ ι₁).fromNormalization t.1) (hTc t.1 t.2)
      refine ⟨w, hw, ?_⟩
      have h1 : w ∈ (Limits.pullback.fst (r₁ ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹' O := by
