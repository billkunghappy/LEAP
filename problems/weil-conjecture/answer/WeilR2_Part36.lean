      rw [this]; exact Q.zero_mem
    have hne' : ∀ d : C', d ∉ Q' → i' d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi' (by rw [h0, map_zero])
      rw [this]; exact Q'.zero_mem
    have hu : ∀ d : Q.primeCompl, IsUnit (i d) := fun d => isUnit_iff_ne_zero.mpr (hne d d.2)
    have hu' : ∀ d : Q'.primeCompl, IsUnit (i' d) :=
      fun d => isUnit_iff_ne_zero.mpr (hne' d d.2)
    obtain ⟨ι, hιa, hιm, hinj⟩ : ∃ ι : Localization.AtPrime Q →+* L,
        (∀ x, ι (algebraMap C _ x) = i x) ∧
        (∀ x (d : Q.primeCompl), i x = i d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hu,
        IsLocalization.lift_eq hu, fun x d => (IsLocalization.lift_mk'_spec hu x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i (IsLocalization.injective (Localization.AtPrime Q)
          (Ideal.primeCompl_le_nonZeroDivisors Q) h)
      · intro h; rw [hi h]
    obtain ⟨ι', hιa', hιm', hinj'⟩ : ∃ ι : Localization.AtPrime Q' →+* L,
        (∀ x, ι (algebraMap C' _ x) = i' x) ∧
        (∀ x (d : Q'.primeCompl), i' x = i' d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q'.primeCompl) (S := Localization.AtPrime Q') hu',
        IsLocalization.lift_eq hu', fun x d => (IsLocalization.lift_mk'_spec hu' x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i' (IsLocalization.injective (Localization.AtPrime Q')
          (Ideal.primeCompl_le_nonZeroDivisors Q') h)
      · intro h; rw [hi' h]
    have hrange : ι.range = ι'.range := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
        obtain ⟨k₁, y₁, h1⟩ := H x
        obtain ⟨k₂, y₂, h2⟩ := H d
        have hy₂ : y₂ ∉ Q' := fun h => d.2 ((HQ _ _ _ h2).mpr h)
        have hD : y₂ * υ' ^ k₁ ∈ Q'.primeCompl := by
          intro h
          rcases hQ'.mem_or_mem h with h | h
