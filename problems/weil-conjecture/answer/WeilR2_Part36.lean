    obtain ⟨t, ht⟩ := hdesc (ιY ⁻¹ᵁ U) hV s (fun a h => hsfix a h)
    have htint : (ιY.app U).hom.IsIntegralElem t := by
      obtain ⟨p, hpm, hp⟩ := hsint
      refine ⟨p, hpm, ?_⟩
      apply wcpa_dj_lr1k_llfi_cover_injective Ω C γ hcov (ιY ⁻¹ᵁ U)
      rw [map_zero, Polynomial.hom_eval₂, ← CommRingCat.hom_comp, ht]
      rw [Scheme.Hom.comp_app] at hp
