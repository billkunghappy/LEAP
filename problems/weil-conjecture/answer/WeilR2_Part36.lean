    have h2 : algebraMap M' L' (algebraMap (Localization.Away w) M' p) =
        algebraMap M' L' (algebraMap (Localization.Away w) M' q) := h1
    exact IsFractionRing.injective (Localization.Away w) M' ((algebraMap M' L').injective h2)
  obtain ⟨y₁, -, hy₁p, hy₁⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
    (S := ↥(integralClosure (Localization.Away w) L'))
    (𝔮.map (algebraMap B (Localization.Away w))) ⊥ (by
      intro p hp
