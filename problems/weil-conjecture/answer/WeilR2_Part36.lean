    rintro ⟨x, hx⟩
    induction hx using Algebra.adjoin_induction with
    | mem z hz =>
      refine ⟨0, ?_⟩
      rw [map_zero, sub_zero]
      rcases hz with rfl | hz
      · exact hN1
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        exact hN2
    | algebraMap a =>
      refine ⟨a, ?_⟩
      have e : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ :
          ↥(wcLlsASmS W A K u β (β * t))) = algebraMap A ↥(wcLlsASmS W A K u β (β * t)) a :=
        Subtype.ext rfl
