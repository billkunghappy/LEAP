            mul_le_of_le_one_left' ((V.valuation_le_one_iff _).2 hmem)

    have hlift : ∀ r ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk n),
        ∀ (g : C.presheaf.stalk P) (c : ↥W), sp g = germ r →
        g - κP (c : Ω) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P) →
        c ∈ IsLocalRing.maximalIdeal ↥W := by
      intro r hr g c hg hgc
      by_contra hcm
      have hcu : IsUnit c := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hcm
        exact hcm
      obtain ⟨c', hc'⟩ := hcu.exists_right_inv
      have hcc : (c : Ω) * (c' : Ω) = 1 := congrArg Subtype.val hc'
      have hκ : κP (c : Ω) * κP (c' : Ω) = 1 := by
        rw [← map_mul, hcc, map_one]
      have hκu : IsUnit (κP (c : Ω)) := ⟨⟨_, _, hκ, by rw [mul_comm]; exact hκ⟩, rfl⟩
      have hgu : IsUnit g := by
        by_contra hgn
        have hgm : g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P) := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact hgn
        have hk : κP (c : Ω) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P) := by
          have := Ideal.sub_mem _ hgm hgc
          rwa [sub_sub_cancel] at this
        exact mem_nonunits_iff.1 ((IsLocalRing.mem_maximalIdeal _).1 hk) hκu
      obtain ⟨g', hg'⟩ := hgu.exists_right_inv
      have hid : g' - κP (c' : Ω) = -(g' * κP (c' : Ω) * (g - κP (c : Ω))) := by
        linear_combination κP (c' : Ω) * hg' - g' * hκ
      have hmem : sp g' ∈ V := by
        refine (hV _).2 ⟨g', c', rfl, ?_⟩
        rw [hid]
        exact (Ideal.neg_mem_iff _).2 (Ideal.mul_mem_left _ _ hgc)
      have h1 : germ r * sp g' = 1 := by
        rw [← hg, ← map_mul, hg', map_one]
      have hru := hD2 r (sp g') hmem h1
      exact mem_nonunits_iff.1 ((IsLocalRing.mem_maximalIdeal _).1 hr) hru

    have he : ∃ e : ↥W, e ≠ 0 ∧ e ∈ IsLocalRing.maximalIdeal ↥W := by
      obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
        by_contra h
        push Not at h
        exact hWt (top_unique fun x _ => h x)
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact hx W.zero_mem
      have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
      refine ⟨⟨x⁻¹, hxi⟩, fun h => inv_ne_zero hx0 (congrArg Subtype.val h), ?_⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      obtain ⟨b, hb⟩ := hu.exists_right_inv
      have hb' : x⁻¹ * (b : Ω) = 1 := congrArg Subtype.val hb
      have hxb : (b : Ω) = x := by
        have := congrArg (x * ·) hb'
        simp only [mul_one, ← mul_assoc, mul_inv_cancel₀ hx0, one_mul] at this
        exact this
      exact hx (hxb ▸ b.2)

    have hrep : ∀ i : Fin 2, ∃ (g : C.presheaf.stalk P) (c : ↥W), sp g = germ (f i) ∧
        g - κP (c : Ω) ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P) :=
      fun i => (hV _).1 (hD1 (f i))
    choose g c hgsp hgm using hrep
    have hcm : ∀ i, c i ∈ IsLocalRing.maximalIdeal ↥W := fun i =>
      hlift (f i) (hf i) (g i) (c i) (hgsp i) (hgm i)
    obtain ⟨d, hd0, hdm, hdvd⟩ : ∃ d : ↥W, d ≠ 0 ∧ d ∈ IsLocalRing.maximalIdeal ↥W ∧
        ∀ i, d ∣ c i := by
      obtain ⟨e, he0, hem⟩ := he
      rcases ValuationRing.dvd_total (c 0) (c 1) with h | h
      · by_cases h0 : c 0 = 0
        · have h1 : c 1 = 0 := by
            rw [h0] at h
            exact zero_dvd_iff.1 h
          exact ⟨e, he0, hem, Fin.forall_fin_two.2
            ⟨by rw [h0]; exact dvd_zero e, by rw [h1]; exact dvd_zero e⟩⟩
        · exact ⟨c 0, h0, hcm 0, Fin.forall_fin_two.2 ⟨dvd_rfl, h⟩⟩
      · by_cases h1 : c 1 = 0
        · have h0 : c 0 = 0 := by
            rw [h1] at h
            exact zero_dvd_iff.1 h
          exact ⟨e, he0, hem, Fin.forall_fin_two.2
            ⟨by rw [h0]; exact dvd_zero e, by rw [h1]; exact dvd_zero e⟩⟩
        · exact ⟨c 1, h1, hcm 1, Fin.forall_fin_two.2 ⟨h, dvd_rfl⟩⟩
    refine ⟨d, hd0, hdm, ?_⟩
    unfold wcTcBox
    refine ⟨hn, fun i => ?_⟩
    show V.valuation (germ (f i)) ≤ V.valuation (wcLr1uConst sC (d : Ω))
    obtain ⟨w, hw⟩ := hdvd i
    have E1 : germ (f i) = sp (κP (c i : Ω)) + sp (g i - κP (c i : Ω)) := by
      rw [← map_add, add_sub_cancel, hgsp i]
    have E2 : V.valuation (sp (κP (c i : Ω))) ≤ V.valuation (sp (κP (d : Ω))) := by
      have hcw : ((c i : ↥W) : Ω) = (d : Ω) * (w : Ω) := by rw [hw]; rfl
      rw [hcw, map_mul κP, map_mul sp, map_mul V.valuation]
      exact mul_le_of_le_one_right' ((V.valuation_le_one_iff _).2 (hconst w))
    have E3 := hinf _ (hgm i) d hd0
    rw [← hK0, E1]
    exact Valuation.map_add_le _ E2 E3
  exact core _ (γ ≫ wcProjKStr Ω 1) (γ ≫ ι').toNormalization n f hRad.1 hRig hCen

theorem wcpa_dj_lr1k_nsr_gub_it_rank_one_pow : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ ϖ d : ↥W, ϖ ≠ 0 →
    ϖ ∈ IsLocalRing.maximalIdeal ↥W → d ∈ IsLocalRing.maximalIdeal ↥W → ∃ N : ℕ, ϖ ∣ d ^ N :=
by
  intro Ω _ W hdim ϖ d hϖ0 _hϖm hd
  haveI hK : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
  have hmax := Ring.krullDimLE_one_iff_of_isPrime_bot.mp hK
  have hrad : d ∈ (Ideal.span {ϖ}).radical := by
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro J ⟨hJ, hJp⟩
    have hϖJ : ϖ ∈ J := hJ (Ideal.mem_span_singleton_self ϖ)
    have hJne : J ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hϖJ
      exact hϖ0 hϖJ
    have hJm : J.IsMaximal := hmax J hJne hJp
    rw [IsLocalRing.eq_maximalIdeal hJm]
    exact hd
  obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hrad
  exact ⟨N, Ideal.mem_span_singleton.mp hN⟩

theorem wcpa_dj_lr1k_nsr_gub_itmpd_place : ∀ {B L K : Type u} [CommRing B] [Field L] [Field K]
    (ψ : B →+* L) (χ : B →+* K), Function.Injective ψ →
    ∃ O : ValuationSubring L, (∀ b : B, ψ b ∈ O) ∧ ∀ b : B, χ b = 0 → O.valuation (ψ b) < 1 :=
by
  intro B L K _ _ _ ψ χ hψ
  classical
  set 𝔭 : Ideal B := RingHom.ker χ with h𝔭
  have : 𝔭.IsPrime := RingHom.ker_isPrime χ
  have hunits : ∀ y : 𝔭.primeCompl, IsUnit (ψ y) := by
    intro y
    apply isUnit_iff_ne_zero.mpr
    intro h0
    have hy : (y : B) ∉ 𝔭 := y.2
    apply hy
    have : (y : B) = 0 := hψ (by rw [h0, map_zero])
    rw [this]; exact 𝔭.zero_mem
  let f : Localization.AtPrime 𝔭 →+* L :=
    IsLocalization.lift (M := 𝔭.primeCompl) (S := Localization.AtPrime 𝔭) hunits
  have hf : ∀ b : B, f (algebraMap B (Localization.AtPrime 𝔭) b) = ψ b := fun b =>
    IsLocalization.lift_eq hunits b
  obtain ⟨O, hO, hloc⟩ := IsLocalRing.exists_factor_valuationRing f
  refine ⟨O, fun b => ?_, fun b hb => ?_⟩
  · rw [← hf b]; exact hO _
  · have hb𝔭 : b ∈ 𝔭 := hb
    have hx : algebraMap B (Localization.AtPrime 𝔭) b ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭 b).mpr hb𝔭
    have hxnu : ¬ IsUnit (algebraMap B (Localization.AtPrime 𝔭) b) :=
      (IsLocalRing.mem_maximalIdeal _).mp hx
    have hynu : ¬ IsUnit (f.codRestrict O.toSubring hO (algebraMap B (Localization.AtPrime 𝔭) b)) :=
      fun hu => hxnu (hloc.map_nonunit _ hu)
    let y : O := ⟨f (algebraMap B (Localization.AtPrime 𝔭) b), hO _⟩
    have hy : ¬ IsUnit y := hynu
    have h1 := (O.valuation_lt_one_iff y).mp ((IsLocalRing.mem_maximalIdeal _).mpr hy)
    have h2 : (y : L) = ψ b := hf b
    rw [h2] at h1
    exact h1

theorem wcpa_dj_lr1k_nsr_gub_itmpd_theta_ext : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (g : Fin 2 → A) (c : ↥W), c ≠ 0 →
    ∀ θ : ↥(wcGubBox W A g c) →+* ↥W,
      (∀ w : ↥W, θ (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A w)) = w) →
    ∃ θΩ : wcGubGen W A →+* Ω,
      (∀ r : ↥(wcGubBox W A g c), θΩ (r : wcGubGen W A) = ((θ r : ↥W) : Ω)) ∧
      (∀ w : ↥W, θΩ (algebraMap A (wcGubGen W A) (algebraMap ↥W A w)) = (w : Ω)) :=
by
  intro Ω _ W A _ _ g c hc0 θ hθ
  classical
  let θ' : A →+* Ω := W.subtype.comp (θ.comp (algebraMap A ↥(wcGubBox W A g c)))
  have hθ'W : ∀ w : ↥W, θ' (algebraMap ↥W A w) = (w : Ω) := by
    intro w
    show ((θ (algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A w)) : ↥W) : Ω) = _
    rw [hθ]
  have hc0' : (c : Ω) ≠ 0 := fun h => hc0 (Subtype.ext h)
  have s1 : ∀ y : Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W), IsUnit (θ' y) := by
    rintro ⟨y, hy⟩
    obtain ⟨w, hw, rfl⟩ := Submonoid.mem_map.mp hy
    have hw0 : w ≠ 0 := nonZeroDivisors.ne_zero hw
    show IsUnit (θ' (algebraMap ↥W A w))
    rw [hθ'W]
    exact Ne.isUnit (fun h => hw0 (Subtype.ext h))
  let θΩ : wcGubGen W A →+* Ω :=
    IsLocalization.lift (M := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
      (S := wcGubGen W A) s1
  have hlift : ∀ a : A, θΩ (algebraMap A (wcGubGen W A) a) = θ' a := fun a =>
    IsLocalization.lift_eq (M := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
      (S := wcGubGen W A) s1 a
  have hunit : IsUnit (algebraMap A (wcGubGen W A) (algebraMap ↥W A c)) :=
    IsLocalization.map_units (M := Submonoid.map (algebraMap ↥W A) (nonZeroDivisors ↥W))
      (wcGubGen W A) ⟨algebraMap ↥W A c,
        Submonoid.mem_map.mpr ⟨c, mem_nonZeroDivisors_of_ne_zero hc0, rfl⟩⟩
  refine ⟨θΩ, ?_, fun w => by rw [hlift, hθ'W]⟩
  rintro ⟨x, hx⟩
  induction hx using Algebra.adjoin_induction with
  | mem x hx' =>
    obtain ⟨i, rfl⟩ := hx'
    have hcoe : algebraMap A (wcGubGen W A) (algebraMap ↥W A c) *
        (algebraMap A (wcGubGen W A) (g i) *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A c))) =
        algebraMap A (wcGubGen W A) (g i) := by
      rw [mul_left_comm, Ring.mul_inverse_cancel _ hunit, mul_one]
    have he : algebraMap A ↥(wcGubBox W A g c) (g i) =
        algebraMap A ↥(wcGubBox W A g c) (algebraMap ↥W A c) *
          ⟨algebraMap A (wcGubGen W A) (g i) *
            Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A c)),
            Algebra.subset_adjoin ⟨i, rfl⟩⟩ := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
      exact hcoe.symm
    have h1 : θΩ (algebraMap A (wcGubGen W A) (algebraMap ↥W A c)) *
        θΩ (algebraMap A (wcGubGen W A) (g i) *
          Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A c))) =
        θΩ (algebraMap A (wcGubGen W A) (g i)) := by
      rw [← map_mul, hcoe]
    rw [hlift, hlift, hθ'W] at h1
    have h2 : ((θ (algebraMap A ↥(wcGubBox W A g c) (g i)) : ↥W) : Ω) =
        (c : Ω) * ((θ ⟨algebraMap A (wcGubGen W A) (g i) *
            Ring.inverse (algebraMap A (wcGubGen W A) (algebraMap ↥W A c)),
            Algebra.subset_adjoin ⟨i, rfl⟩⟩ : ↥W) : Ω) := by
      rw [he, map_mul, hθ]
      rfl
    apply mul_left_cancel₀ hc0'
    refine h1.trans ?_
    exact h2
  | algebraMap a =>
    exact hlift a
  | add x y hx hy ihx ihy =>
    show θΩ (x + y) = ((θ (⟨x, hx⟩ + ⟨y, hy⟩) : ↥W) : Ω)
    calc θΩ (x + y) = θΩ x + θΩ y := map_add _ _ _
      _ = ((θ ⟨x, hx⟩ : ↥W) : Ω) + ((θ ⟨y, hy⟩ : ↥W) : Ω) := by rw [← ihx, ← ihy]
      _ = ((θ (⟨x, hx⟩ + ⟨y, hy⟩) : ↥W) : Ω) := by rw [map_add]; rfl
  | mul x y hx hy ihx ihy =>
    show θΩ (x * y) = ((θ (⟨x, hx⟩ * ⟨y, hy⟩) : ↥W) : Ω)
    calc θΩ (x * y) = θΩ x * θΩ y := map_mul _ _ _
      _ = ((θ ⟨x, hx⟩ : ↥W) : Ω) * ((θ ⟨y, hy⟩ : ↥W) : Ω) := by rw [← ihx, ← ihy]
      _ = ((θ (⟨x, hx⟩ * ⟨y, hy⟩) : ↥W) : Ω) := by rw [map_mul]; rfl

theorem wcpa_dj_lr1k_nsr_gub_itmpd_germ_inj : ∀ {C N : Scheme.{u}} [AlgebraicGeometry.IsIntegral C]
    [AlgebraicGeometry.IsIntegral N] (t : C ⟶ N) [IsDominant t] (n : ↥N)
    (h : t (genericPoint ↥C) ⤳ n), Function.Injective (wcLr1uGerm t n h).hom :=
by
  intro C N _ _ t _ n h
  have hp : t (genericPoint C) = genericPoint N := by
    have hsub : Set.range t ⊆ closure {t (genericPoint C)} := by
      rintro _ ⟨x, rfl⟩
      exact specializes_iff_mem_closure.mp
        (((genericPoint_spec C).specializes (Set.mem_univ x)).map t.continuous)
    have h2 : closure (Set.range t) ⊆ closure {t (genericPoint C)} :=
      closure_minimal hsub isClosed_closure
    rw [t.denseRange.closure_range] at h2
    have hg : IsGenericPoint (t (genericPoint C)) (Set.univ : Set N) :=
      isGenericPoint_def.mpr (Set.eq_univ_of_univ_subset h2)
    exact hg.eq (genericPoint_spec N)
  have f_inj : Function.Injective (N.presheaf.stalkSpecializes h).hom := by
    have hc := TopCat.Presheaf.stalkSpecializes_comp N.presheaf
      (genericPoint_specializes (t (genericPoint C))) h
    have hinj : Function.Injective (N.presheaf.stalkSpecializes
        ((genericPoint_specializes (t (genericPoint C))).trans h)).hom :=
      IsFractionRing.injective (N.presheaf.stalk n) N.functionField
    rw [← hc, CommRingCat.hom_comp, RingHom.coe_comp] at hinj
    exact hinj.of_comp
  have hF : ∀ y : N, y = genericPoint N → IsField (N.presheaf.stalk y) := by
    rintro y rfl
    exact Field.toIsField _
  have hF' := hF _ hp
  have g_inj : Function.Injective (t.stalkMap (genericPoint C)).hom := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    obtain ⟨b, hb⟩ := hF'.mul_inv_cancel hx0
    have h1 := congrArg (t.stalkMap (genericPoint C)).hom hb
    rw [map_mul, map_one, hx, zero_mul] at h1
    exact zero_ne_one h1
  show Function.Injective (N.presheaf.stalkSpecializes h ≫ t.stalkMap (genericPoint C)).hom
  rw [CommRingCat.hom_comp, RingHom.coe_comp]
  exact g_inj.comp f_inj

theorem wcpa_dj_lcp_ra_valuative_center : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T), UniversallyClosed q →
    ∀ W : T.Opens, IsAffineOpen W → ∀ (ξ : Y) (hξ : ξ ∈ q ⁻¹ᵁ W)
    (V : ValuationSubring (Y.residueField ξ)),
    (∀ r : Γ(T, W), (q.app W ≫ Y.presheaf.germ (q ⁻¹ᵁ W) ξ hξ ≫ Y.residue ξ).hom r ∈ V) →
    ∃ y : Y, y ∈ q ⁻¹ᵁ W ∧ ∀ (O' : Y.Opens) (_ : y ∈ O') (σ : Γ(Y, O')),
      ∃ (hξ' : ξ ∈ O') (v : V), (v : Y.residueField ξ) = (Y.presheaf.germ O' ξ hξ' ≫ Y.residue ξ).hom σ ∧
        (y ∈ Y.basicOpen σ → IsUnit v) :=
by
  intro Y T q hq W hW ξ hξ V hR
  classical

  have appTopEq : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (h : (⊤ : (Spec S).Opens) ≤ Spec.map f ⁻¹ᵁ ⊤),
      (Spec.map f).appLE ⊤ ⊤ h = (Spec.map f).appTop := by
    intro R S f h
    exact Scheme.Hom.appLE_eq_app (Spec.map f)
  have nat : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (g : Spec R ⟶ Y) (m : Spec S ⟶ Y),
      Spec.map f ≫ g = m → ∀ (O' : Y.Opens) (e : ⊤ ≤ g ⁻¹ᵁ O') (e' : ⊤ ≤ m ⁻¹ᵁ O') (σ : Γ(Y, O')),
      (Scheme.ΓSpecIso S).hom.hom ((m.appLE O' ⊤ e').hom σ) =
        f.hom ((Scheme.ΓSpecIso R).hom.hom ((g.appLE O' ⊤ e).hom σ)) := by
    intro R S f g m hm O' e e' σ
    subst hm
    have h0 : (⊤ : (Spec S).Opens) ≤ Spec.map f ⁻¹ᵁ ⊤ := fun _ _ => trivial
    rw [← Scheme.Hom.appLE_comp_appLE (Spec.map f) g O' ⊤ ⊤ e h0, appTopEq f h0]
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      Category.assoc, Scheme.ΓSpecIso_naturality, ← Category.assoc, CommRingCat.comp_apply,
      CommRingCat.comp_apply]

  set φ := q.app W ≫ Y.presheaf.germ (q ⁻¹ᵁ W) ξ hξ ≫ Y.residue ξ with hφ
  let β : Γ(T, W) ⟶ CommRingCat.of V := CommRingCat.ofHom (φ.hom.codRestrict V hR)
  have hβ : β ≫ CommRingCat.ofHom (algebraMap V (Y.residueField ξ)) = φ := by
    ext r; rfl

  have hsq1 : Y.fromSpecResidueField ξ ≫ q = Spec.map φ ≫ hW.fromSpec := by
    have h1 : T.fromSpecStalk (q ξ) = Spec.map (T.presheaf.germ W (q ξ) hξ) ≫ hW.fromSpec := by
      rw [← hW.fromSpecStalk_eq_fromSpecStalk hξ]
      rfl
    have h2 := Scheme.SpecMap_stalkMap_fromSpecStalk q (x := ξ)
    have h3 := Scheme.Hom.germ_stalkMap q W ξ hξ
    have hφ' : φ = T.presheaf.germ W (q ξ) hξ ≫ q.stalkMap ξ ≫ Y.residue ξ := by
      rw [hφ, ← Category.assoc, ← h3, Category.assoc]
    rw [hφ']
    simp only [Spec.map_comp, Category.assoc]
    rw [← h1, h2]
    rfl
  have hsq : CommSq (W := Spec (CommRingCat.of (Y.residueField ξ))) (Y.fromSpecResidueField ξ)
      (Spec.map (CommRingCat.ofHom (algebraMap V (Y.residueField ξ)))) q
      (Spec.map β ≫ hW.fromSpec) := ⟨by rw [hsq1, ← hβ, Spec.map_comp, Category.assoc]⟩

  have hEx : ValuativeCriterion.Existence q := (UniversallyClosed.eq_valuativeCriterion ▸ hq).1
  have key : ∃ l : Spec (CommRingCat.of V) ⟶ Y,
      Spec.map (CommRingCat.ofHom (algebraMap V (Y.residueField ξ))) ≫ l =
        Y.fromSpecResidueField ξ ∧ l ≫ q = Spec.map β ≫ hW.fromSpec := by
    obtain ⟨⟨l, hl1, hl2⟩⟩ := (hEx (ValuativeCommSq.mk V (Y.residueField ξ) _ _ hsq)).exists_lift
    exact ⟨l, hl1, hl2⟩
  obtain ⟨l, hl1, hl2⟩ := key

  let cp : Spec (CommRingCat.of V) := IsLocalRing.closedPoint V
  refine ⟨l cp, ?_, ?_⟩
  · have h4 : hW.fromSpec (Spec.map β cp) ∈ W := by
      have := Set.mem_range_self (f := hW.fromSpec) (Spec.map β cp)
      rw [hW.range_fromSpec] at this
      exact this
    have h5 : (l ≫ q) cp = (Spec.map β ≫ hW.fromSpec) cp := by rw [hl2]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h5
    show q (l cp) ∈ W
    rw [h5]
    exact h4
  · intro O' hyO' σ
    have hall : l ⁻¹ᵁ O' = ⊤ := IsLocalRing.closed_point_mem_iff.mp hyO'
    have e : ⊤ ≤ l ⁻¹ᵁ O' := hall.ge
    have hξ' : ξ ∈ O' := by
      let pK : Spec (CommRingCat.of (Y.residueField ξ)) := IsLocalRing.closedPoint (Y.residueField ξ)
      have hp := e (Set.mem_univ (Spec.map (CommRingCat.ofHom (algebraMap V (Y.residueField ξ))) pK))
      have h7 : l (Spec.map (CommRingCat.ofHom (algebraMap V (Y.residueField ξ))) pK) = ξ := by
        rw [← Scheme.Hom.comp_apply, hl1]
        exact Scheme.fromSpecResidueField_apply ξ pK
      rw [← h7]
      exact hp
    have e' : ⊤ ≤ Y.fromSpecResidueField ξ ⁻¹ᵁ O' := by
      intro x _
      show Y.fromSpecResidueField ξ x ∈ O'
      rw [Scheme.fromSpecResidueField_apply]
      exact hξ'
    refine ⟨hξ', (Scheme.ΓSpecIso (CommRingCat.of V)).hom.hom ((l.appLE O' ⊤ e).hom σ), ?_, ?_⟩
    ·
      have h1 := nat (CommRingCat.ofHom (algebraMap V (Y.residueField ξ))) l _ hl1 O' e e' σ
      rw [CommRingCat.hom_ofHom, ValuationSubring.algebraMap_apply] at h1
      rw [← h1]
      have h0 : (⊤ : (Spec (Y.residueField ξ)).Opens) ≤ Spec.map (Y.residue ξ) ⁻¹ᵁ ⊤ :=
        fun _ _ => trivial
      have hs2 : (Y.fromSpecResidueField ξ).appLE O' ⊤ e' =
          Y.presheaf.germ O' ξ hξ' ≫ (Scheme.ΓSpecIso (Y.presheaf.stalk ξ)).inv ≫
            (Spec.map (Y.residue ξ)).appLE ⊤ ⊤ h0 := by
        have hc := Scheme.Hom.comp_appLE (Spec.map (Y.residue ξ)) (Y.fromSpecStalk ξ) O' ⊤ e'
        rw [Scheme.fromSpecStalk_app hξ', Category.assoc, Category.assoc] at hc
        erw [Scheme.Hom.map_appLE] at hc
        exact hc
      rw [hs2, appTopEq, ← CommRingCat.comp_apply, Category.assoc, Category.assoc,
        Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
    · intro hyσ
      have hmem : cp ∈ (Spec (CommRingCat.of V)).basicOpen ((l.appLE O' ⊤ e).hom σ) := by
        rw [Scheme.basicOpen_appLE]
        exact ⟨trivial, hyσ⟩
      rw [basicOpen_eq_of_affine'] at hmem
      have hmem' := (PrimeSpectrum.mem_basicOpen _ _).mp hmem
      exact (IsLocalRing.notMem_maximalIdeal).mp hmem'

theorem wcpa_dj_lr1k_nsr_gub_itmpd_curve_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ O : ValuationSubring C.functionField,
      (∀ x : Ω, wcLr1uConst (γ ≫ wcProjKStr Ω 1) x ∈ O) →
      ∃ P : ↥C, IsClosed ({P} : Set ↥C) ∧
        (∀ h : C.functionField, O.valuation h < 1 →
           ∃ g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P),
