          ((f.app V).hom ((r.appLE U V e).hom s)) =
        (C.presheaf.germ (f' ⁻¹ᵁ U) (genericPoint C) hU).hom ((f'.app U).hom s) := by
    intro Y X f r f' hf U V e hV hU s
    subst hf
    have key := congrArg (fun φ => φ.hom s)
      (Scheme.Hom.appLE_comp_appLE f r U V (f ⁻¹ᵁ V) e le_rfl)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key
    rw [Scheme.Hom.app_eq_appLE f, key, T_appLE_germ]
  have T_centred_val : ∀ (N : Scheme.{u}) (t : C ⟶ N) (n : N)
      (A : ValuationSubring C.functionField), wcNsrCentred t n A →
      ∃ h : t (genericPoint C) ⤳ n, (∀ s, A.valuation ((wcLr1uGerm t n h).hom s) ≤ 1) ∧
        (∀ s ∈ IsLocalRing.maximalIdeal (N.presheaf.stalk n),
          A.valuation ((wcLr1uGerm t n h).hom s) < 1) ∧
        (∀ s, IsUnit s → A.valuation ((wcLr1uGerm t n h).hom s) = 1) := by
    intro N t n A hc
    obtain ⟨h, hmem, hloc⟩ := hc
    have h1 : ∀ s, A.valuation ((wcLr1uGerm t n h).hom s) ≤ 1 := fun s =>
      (ValuationSubring.valuation_le_one_iff A _).mpr (hmem s)
    refine ⟨h, h1, fun s hs => ?_, fun s hs => ?_⟩
    · let a : A := ⟨(wcLr1uGerm t n h).hom s, hmem s⟩
      have ha : a ∈ IsLocalRing.maximalIdeal A := by
        refine (IsLocalRing.mem_maximalIdeal _).mpr (fun hu => ?_)
        obtain ⟨u, hu⟩ := hu
        have h2 : (wcLr1uGerm t n h).hom s * ((u⁻¹ : Aˣ) : A) = 1 := by
          have : ((u : A) * ((u⁻¹ : Aˣ) : A) : A) = 1 := u.mul_inv
          rw [hu] at this
          exact congrArg Subtype.val this
        exact ((IsLocalRing.mem_maximalIdeal _).mp hs) (hloc s _ ((u⁻¹ : Aˣ) : A).2 h2)
      exact (ValuationSubring.valuation_lt_one_iff A a).mp ha
    · obtain ⟨u, rfl⟩ := hs
      have e : A.valuation ((wcLr1uGerm t n h).hom (u : N.presheaf.stalk n)) *
          A.valuation ((wcLr1uGerm t n h).hom ((u⁻¹ : (N.presheaf.stalk n)ˣ) : N.presheaf.stalk n))
            = 1 := by
        rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
      apply le_antisymm (h1 _)
      by_contra hlt
      push_neg at hlt
      have h3 := mul_le_of_le_one_right' (h1 ((u⁻¹ : (N.presheaf.stalk n)ˣ) : N.presheaf.stalk n))
        (a := A.valuation ((wcLr1uGerm t n h).hom (u : N.presheaf.stalk n)))
      rw [e] at h3
      exact absurd (lt_of_le_of_lt h3 hlt) (lt_irrefl _)

  have T_rigid : ∀ (s : C ⟶ Spec (.of Ω)) (V : ValuationSubring C.functionField),
      wcUbRigid W s V →
      (∀ ω : Ω, wcLr1uConst s ω ∈ V ↔ ω ∈ W) ∧ ∀ y ∈ V, ∃ c : W, ∀ d : Ω, d ≠ 0 →
        V.valuation (y - wcLr1uConst s (c : Ω)) < V.valuation (wcLr1uConst s d) := by
    intro s V hR
    obtain ⟨P, -, hP⟩ := hR
    let κ : Ω →+* C.presheaf.stalk P :=
      ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop ≫ C.presheaf.germ ⊤ P trivial).hom
    let sp : C.presheaf.stalk P →+* C.functionField :=
      (C.presheaf.stalkSpecializes (genericPoint_specializes P)).hom
    have hP' : ∀ z, z ∈ V ↔ ∃ (g : C.presheaf.stalk P) (c : W), sp g = z ∧
        g - κ c ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P) := hP
    have F1 : ∀ ω, sp (κ ω) = wcLr1uConst s ω := by
      intro ω
      have e : C.presheaf.germ ⊤ P trivial ≫
          C.presheaf.stalkSpecializes (genericPoint_specializes P) =
          C.presheaf.germ ⊤ (genericPoint C) trivial :=
        TopCat.Presheaf.germ_stalkSpecializes _ _ _
      exact congrArg (fun φ => φ.hom (s.appTop.hom ((Scheme.ΓSpecIso (.of Ω)).inv.hom ω))) e
    have F2 : Function.Injective sp :=
      IsFractionRing.injective (C.presheaf.stalk P) C.functionField
    have Kne : ∀ d : Ω, d ≠ 0 → wcLr1uConst s d ≠ 0 := fun d hd => (map_ne_zero _).mpr hd
    have F3 : ∀ h ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P), ∀ d : Ω, d ≠ 0 →
        V.valuation (sp h) < V.valuation (wcLr1uConst s d) := by
      intro h hh d hd
      have hh₁ : h * κ d⁻¹ ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk P) :=
        Ideal.mul_mem_right _ _ hh
      have hz : sp (h * κ d⁻¹) = sp h * (wcLr1uConst s d)⁻¹ := by
        rw [map_mul, F1, map_inv₀]
      have hzV : sp (h * κ d⁻¹) ∈ V := (hP' _).mpr ⟨h * κ d⁻¹, 0, rfl, by simpa using hh₁⟩
      have hlt : V.valuation (sp (h * κ d⁻¹)) < 1 := by
        rcases lt_or_eq_of_le ((ValuationSubring.valuation_le_one_iff V _).mpr hzV) with hl | he
        · exact hl
        · exfalso
          have hz0 : sp (h * κ d⁻¹) ≠ 0 := by
            intro h0; rw [h0, map_zero] at he; exact zero_ne_one he
          have hinv : (sp (h * κ d⁻¹))⁻¹ ∈ V := by
            rw [← ValuationSubring.valuation_le_one_iff, map_inv₀, he, inv_one]
          obtain ⟨h', c', hh', -⟩ := (hP' _).mp hinv
          have h5 : sp ((h * κ d⁻¹) * h') = sp 1 := by
            rw [map_mul, hh', mul_inv_cancel₀ hz0, map_one]
          have hu : IsUnit (h * κ d⁻¹) := isUnit_iff_exists_inv.mpr ⟨h', F2 h5⟩
          exact (IsLocalRing.mem_maximalIdeal _).mp hh₁ hu
      have hKd : 0 < V.valuation (wcLr1uConst s d) := by
        rw [zero_lt_iff]; exact (Valuation.ne_zero_iff _).mpr (Kne d hd)
      have h6 : V.valuation (sp h) =
          V.valuation (sp (h * κ d⁻¹)) * V.valuation (wcLr1uConst s d) := by
        rw [← map_mul, hz, mul_assoc, inv_mul_cancel₀ (Kne d hd), mul_one]
      rw [h6]
      exact mul_lt_of_lt_one_left hKd hlt
    refine ⟨fun ω => ⟨fun hω => ?_, fun hω => ?_⟩, fun y hy => ?_⟩
    · obtain ⟨h, c, hh, hm⟩ := (hP' _).mp hω
      have h7 : h = κ ω := F2 (by rw [hh, F1])
      rw [h7, ← map_sub] at hm
      by_contra hne
      have hne' : ω - c ≠ 0 := by
        intro h0; apply hne; rw [sub_eq_zero.mp h0]; exact c.2
      exact (IsLocalRing.mem_maximalIdeal _).mp hm ((IsUnit.mk0 _ hne').map κ)
    · exact (hP' _).mpr ⟨κ ω, ⟨ω, hω⟩, F1 ω, by simp⟩
    · obtain ⟨h, c, hh, hm⟩ := (hP' _).mp hy
      refine ⟨c, fun d hd => ?_⟩
      have h8 : y - wcLr1uConst s c = sp (h - κ c) := by rw [map_sub, F1, hh]
      rw [h8]
      exact F3 _ hm d hd

  have T_scale : ∀ (K : Ω →+* C.functionField) (V : ValuationSubring C.functionField),
      (∀ ω : Ω, K ω ∈ V ↔ ω ∈ W) →
      (∀ y ∈ V, ∃ c : W, ∀ d : Ω, d ≠ 0 → V.valuation (y - K (c : Ω)) < V.valuation (K d)) →
      ∀ (y : C.functionField) (a₀ : W), a₀ ≠ 0 → V.valuation y ≤ 1 →
      V.valuation (K (a₀ : Ω)) < V.valuation y →
      ∃ c : W, c ≠ 0 ∧ c ∣ a₀ ∧ ¬ a₀ ∣ c ∧ ∀ e : W, e ≠ 0 → e ∈ IsLocalRing.maximalIdeal W →
        V.valuation (K ((c * e : W) : Ω)) < V.valuation y := by
    intro K V H1 H2 y a₀ ha hy1 hya
    have hyV : y ∈ V := (ValuationSubring.valuation_le_one_iff V y).mp hy1
    obtain ⟨c, hc⟩ := H2 y hyV
    have ha' : (a₀ : Ω) ≠ 0 := fun h => ha (Subtype.ext h)
    have hc0 : c ≠ 0 := by
      rintro rfl
      have h1 := hc _ ha'
      simp only [ZeroMemClass.coe_zero, map_zero, sub_zero] at h1
      exact lt_irrefl _ (h1.trans hya)
    have hc' : (c : Ω) ≠ 0 := fun h => hc0 (Subtype.ext h)
    have hvy : V.valuation y = V.valuation (K c) := by
      have h1 := hc _ hc'
      have h2 : y = K c + (y - K c) := by ring
      conv_lhs => rw [h2]
      exact Valuation.map_add_eq_of_lt_left _ h1
    have hvy0 : 0 < V.valuation y := lt_of_le_of_lt zero_le' hya
    refine ⟨c, hc0, ?_, ?_, ?_⟩
    · have hKδ : K ((a₀ : Ω) / c) * K c = K a₀ := by rw [← map_mul, div_mul_cancel₀ _ hc']
      have hle : V.valuation (K ((a₀ : Ω) / c)) ≤ 1 := by
        by_contra hgt
        push_neg at hgt
        have h3 : V.valuation y ≤ V.valuation (K a₀) := by
          rw [← hKδ, map_mul, ← hvy]
          exact le_mul_of_one_le_left' hgt.le
        exact absurd (lt_of_le_of_lt h3 hya) (lt_irrefl _)
      have hδW : (a₀ : Ω) / c ∈ W :=
        (H1 _).mp ((ValuationSubring.valuation_le_one_iff V _).mp hle)
      refine ⟨⟨(a₀ : Ω) / c, hδW⟩, Subtype.ext ?_⟩
      show (a₀ : Ω) = c * ((a₀ : Ω) / c)
      rw [mul_div_cancel₀ _ hc']
    · rintro ⟨w, hw⟩
      have hw' : (c : Ω) = a₀ * w := congrArg Subtype.val hw
      have hwle : V.valuation (K w) ≤ 1 :=
        (ValuationSubring.valuation_le_one_iff V _).mpr ((H1 _).mpr w.2)
      have h3 : V.valuation y ≤ V.valuation (K a₀) := by
        rw [hvy, hw', map_mul, map_mul]
        exact mul_le_of_le_one_right' hwle
      exact absurd (lt_of_le_of_lt h3 hya) (lt_irrefl _)
    · intro e he0 hem
      have he' : (e : Ω) ≠ 0 := fun h => he0 (Subtype.ext h)
      have hle : V.valuation (K e) ≤ 1 :=
        (ValuationSubring.valuation_le_one_iff V _).mpr ((H1 _).mpr e.2)
      have hlt : V.valuation (K e) < 1 := by
        rcases lt_or_eq_of_le hle with h | h
        · exact h
        · exfalso
          have hinv : ((e : Ω))⁻¹ ∈ W := by
            rw [← H1, ← ValuationSubring.valuation_le_one_iff, map_inv₀, map_inv₀, h, inv_one]
          apply (IsLocalRing.mem_maximalIdeal _).mp hem
          refine isUnit_iff_exists_inv.mpr ⟨⟨_, hinv⟩, Subtype.ext ?_⟩
          show (e : Ω) * (e : Ω)⁻¹ = 1
          exact mul_inv_cancel₀ he'
      show V.valuation (K ((c : Ω) * e)) < V.valuation y
      rw [map_mul, map_mul, ← hvy]
      exact mul_lt_of_lt_one_right hvy0 hlt

  have T_const : ∀ (X : Scheme.{u}) (f : C ⟶ X) (uX : X ⟶ Spec (.of W)) (s : C ⟶ Spec (.of Ω)),
      f ≫ uX = s ≫ Spec.map (CommRingCat.ofHom (algebraMap W Ω)) →
      ∀ (U : X.Opens) (hU : genericPoint C ∈ f ⁻¹ᵁ U) (b : W),
      (C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint C) hU).hom ((f.app U).hom (wcGcfStr uX U b)) =
        wcLr1uConst s (b : Ω) := by
    intro X f uX s hcomp U hU b
    have hT : genericPoint C ∈ (f ≫ uX) ⁻¹ᵁ ⊤ := trivial
    have hT' : genericPoint C ∈ (s ≫ Spec.map (CommRingCat.ofHom (algebraMap W Ω))) ⁻¹ᵁ ⊤ :=
      trivial
    have e1 := T_germ_comp X (Spec (.of W)) f uX (f ≫ uX) rfl ⊤ U (by simp) hU hT
      ((Scheme.ΓSpecIso (.of W)).inv.hom b)
    have e2 := T_trans (Spec (.of W)) _ _ hcomp ⊤ ((Scheme.ΓSpecIso (.of W)).inv.hom b) hT hT'
    have e3 : (Spec.map (CommRingCat.ofHom (algebraMap W Ω))).appTop.hom
        ((Scheme.ΓSpecIso (.of W)).inv.hom b) =
          (Scheme.ΓSpecIso (.of Ω)).inv.hom (algebraMap W Ω b) :=
      (congrArg (fun φ => φ.hom b)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap W Ω)))).symm
    show _ = (C.presheaf.germ ⊤ (genericPoint C) trivial).hom
      (s.appTop.hom ((Scheme.ΓSpecIso (.of Ω)).inv.hom (b : Ω)))
    have e4 : (C.presheaf.germ ((s ≫ Spec.map (CommRingCat.ofHom (algebraMap W Ω))) ⁻¹ᵁ ⊤)
        (genericPoint C) hT').hom (((s ≫ Spec.map (CommRingCat.ofHom (algebraMap W Ω))).app ⊤).hom
          ((Scheme.ΓSpecIso (.of W)).inv.hom b)) =
        (C.presheaf.germ ⊤ (genericPoint C) trivial).hom
          (s.appTop.hom ((Spec.map (CommRingCat.ofHom (algebraMap W Ω))).appTop.hom
            ((Scheme.ΓSpecIso (.of W)).inv.hom b))) := by
      rfl
    unfold wcGcfStr
    rw [CommRingCat.hom_comp, RingHom.comp_apply, e1, e2, e4, e3]
    rfl
  have T_nonunit : ∀ (η : X) (hη : η ∈ U), uX η = IsLocalRing.closedPoint W →
      ∀ b : W, b ∈ IsLocalRing.maximalIdeal W →
      ¬ IsUnit ((X.presheaf.germ U η hη).hom (wcGcfStr uX U b)) := by
    intro η hη hc b hb hu
    unfold wcGcfStr at hu
    rw [CommRingCat.hom_comp, RingHom.comp_apply,
      T_appLE_germ X (Spec (.of W)) uX ⊤ U (by simp) η hη] at hu
    have hu' : IsUnit ((uX.stalkMap η).hom (((Spec (.of W)).presheaf.germ ⊤ (uX η) trivial).hom
        ((Scheme.ΓSpecIso (.of W)).inv.hom b))) := by
      convert hu using 1; exact Scheme.Hom.germ_stalkMap_apply uX ⊤ η _ _
    have hu2 := isUnit_of_map_unit _ _ hu'
    have hmem : uX η ∈ (Spec (.of W)).basicOpen ((Scheme.ΓSpecIso (.of W)).inv.hom b) :=
      (Scheme.mem_basicOpen _ _ _ _).mpr hu2
    rw [basicOpen_eq_of_affine, hc] at hmem
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hmem hb

  obtain ⟨G, hG⟩ : ∃ G : Γ(X, U) → C.functionField, ∀ t, G t =
      (C.presheaf.germ ((γ ≫ ι) ⁻¹ᵁ U) (genericPoint C) hgen).hom (((γ ≫ ι).app U).hom t) :=
    ⟨_, fun _ => rfl⟩
  have hcomp : (γ ≫ ι) ≫ uX =
      (γ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap W Ω)) := by
    rw [Category.assoc, hM.2.2.w]
    exact (Category.assoc _ _ _).symm
  have hχ : ∀ b : W, G (wcGcfStr uX U b) = wcLr1uConst (γ ≫ wcProjKStr Ω 1) (b : Ω) := by
    intro b
    rw [hG]
    exact T_const X (γ ≫ ι) uX (γ ≫ wcProjKStr Ω 1) hcomp U hgen b

  have partA : ∀ b : W, b ∈ IsLocalRing.maximalIdeal W →
      A.valuation (G (wcGcfStr uX U b)) < A.valuation (G g) := by
    intro b hb
    obtain ⟨-, η, hη, hηx, hηne, hηs, -, hηA⟩ := hA
    have hηU : η ∈ U := hηx.mem_open U.isOpen hxU
    obtain ⟨u, hu⟩ := hunit η hηU hηx hηne hηs
    have hs1 : (X.presheaf.germ U η hηU).hom (wcGcfStr uX U b) ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk η) :=
      (IsLocalRing.mem_maximalIdeal _).mpr (T_nonunit η hηU hηs b hb)
    have hs2 := Ideal.mul_mem_right ((u⁻¹ : (X.presheaf.stalk η)ˣ) : X.presheaf.stalk η) _ hs1
    have hlt := hηA _ hs2
    rw [map_mul, map_mul, T_germ_point X (γ ≫ ι) η hη U hηU hgen, ← hG] at hlt
    have e3 : A.valuation ((wcLr1uGerm (γ ≫ ι) η hη).hom (u : X.presheaf.stalk η)) *
        A.valuation ((wcLr1uGerm (γ ≫ ι) η hη).hom
          ((u⁻¹ : (X.presheaf.stalk η)ˣ) : X.presheaf.stalk η)) = 1 := by
      rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
    rw [hu, T_germ_point X (γ ≫ ι) η hη U hηU hgen, ← hG] at e3
    have hγpos : 0 < A.valuation (G g) := by
      rw [zero_lt_iff]
      intro h0
      rw [h0, zero_mul] at e3
      exact zero_ne_one e3
    calc A.valuation (G (wcGcfStr uX U b))
        = A.valuation (G (wcGcfStr uX U b)) * (A.valuation (G g) *
            A.valuation ((wcLr1uGerm (γ ≫ ι) η hη).hom
              ((u⁻¹ : (X.presheaf.stalk η)ˣ) : X.presheaf.stalk η))) := by rw [e3, mul_one]
      _ = (A.valuation (G (wcGcfStr uX U b)) *
            A.valuation ((wcLr1uGerm (γ ≫ ι) η hη).hom
              ((u⁻¹ : (X.presheaf.stalk η)ˣ) : X.presheaf.stalk η))) * A.valuation (G g) := by
          rw [mul_comm (A.valuation (G g)), ← mul_assoc]
      _ < A.valuation (G g) := mul_lt_of_lt_one_left hγpos hlt
  have hA0 := partA a₀ hP.2.2.2

  have hzU : r₀ z₀ ∈ (⟨U, hU⟩ : X.affineOpens).1 := by
    show r₀ z₀ ∈ U
    rw [hz₀]; exact hxU
  have hspan : Ideal.span (Set.range ![g, wcGcfStr uX U a₀]) =
      (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀).ideal ⟨U, hU⟩ := by
    rw [Matrix.range_cons_cons_empty, hideal a₀]
  obtain ⟨j, V₀, e, hz₀V₀, -, hmap0⟩ :=
    GC X X₀ _ r₀ hbl.1 ⟨U, hU⟩ 2 ![g, wcGcfStr uX U a₀] hspan z₀ hzU
  have hmap : Ideal.map (r₀.appLE U V₀.1 e).hom
      ((σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀).ideal ⟨U, hU⟩) =
      Ideal.span {(r₀.appLE U V₀.1 e).hom (![g, wcGcfStr uX U a₀] j)} := hmap0

  obtain ⟨hsA, iA, -, iiiA⟩ := T_centred_val X₀ (γ ≫ ι₀) z₀ A hA₀
  obtain ⟨hsV, iV, iiV, -⟩ := T_centred_val X₀ (γ ≫ ι₀) z₀ V hV₀
  have hgen₀ : genericPoint C ∈ (γ ≫ ι₀) ⁻¹ᵁ V₀.1 := by
    rw [Scheme.Hom.mem_preimage]
    exact hsA.mem_open V₀.1.isOpen hz₀V₀
  obtain ⟨H₀, hH₀⟩ : ∃ H₀ : Γ(X₀, V₀.1) → C.functionField, ∀ t, H₀ t =
      (C.presheaf.germ ((γ ≫ ι₀) ⁻¹ᵁ V₀.1) (genericPoint C) hgen₀).hom
        (((γ ≫ ι₀).app V₀.1).hom t) := ⟨_, fun _ => rfl⟩
  have hH₀mul : ∀ a b, H₀ (a * b) = H₀ a * H₀ b := by
    intro a b; rw [hH₀, hH₀, hH₀, map_mul, map_mul]
  have hpt : ∀ (h : (γ ≫ ι₀) (genericPoint C) ⤳ z₀) (t : Γ(X₀, V₀.1)),
      (wcLr1uGerm (γ ≫ ι₀) z₀ h).hom ((X₀.presheaf.germ V₀.1 z₀ hz₀V₀).hom t) = H₀ t := by
    intro h t
    rw [hH₀]
    exact T_germ_point X₀ (γ ≫ ι₀) z₀ h V₀.1 hz₀V₀ hgen₀ t
  have hcompat : ∀ t : Γ(X, U), H₀ ((r₀.appLE U V₀.1 e).hom t) = G t := by
    intro t
    rw [hH₀, hG]
    exact T_germ_comp X₀ X (γ ≫ ι₀) r₀ (γ ≫ ι) (by rw [Category.assoc, hι₀]) U V₀.1 e hgen₀
      hgen t
  have hAle : ∀ t, A.valuation (H₀ t) ≤ 1 := fun t => by rw [← hpt hsA]; exact iA _
  have hVle : ∀ t, V.valuation (H₀ t) ≤ 1 := fun t => by rw [← hpt hsV]; exact iV _
  have h3 : ∀ t, A.valuation (H₀ t) < 1 → V.valuation (H₀ t) < 1 := by
    intro t ht
    rw [← hpt hsA] at ht
    have hm : (X₀.presheaf.germ V₀.1 z₀ hz₀V₀).hom t ∈
        IsLocalRing.maximalIdeal (X₀.presheaf.stalk z₀) := by
      refine (IsLocalRing.mem_maximalIdeal _).mpr (fun hu => ?_)
      rw [iiiA _ hu] at ht
      exact lt_irrefl _ ht
    rw [← hpt hsV]
    exact iiV _ hm

  have hg_mem : g ∈ (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀).ideal ⟨U, hU⟩ := by
    rw [hideal a₀]; exact Ideal.subset_span (Set.mem_insert _ _)
  have ha_mem : wcGcfStr uX U a₀ ∈ (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀).ideal ⟨U, hU⟩ := by
    rw [hideal a₀]; exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hp_mem := Ideal.mem_map_of_mem (r₀.appLE U V₀.1 e).hom hg_mem
  have hq_mem := Ideal.mem_map_of_mem (r₀.appLE U V₀.1 e).hom ha_mem
  rw [hmap] at hp_mem hq_mem

  have hVtrans : V.valuation (G (wcGcfStr uX U a₀)) < V.valuation (G g) := by
