theorem wcpa_dj_lr1k_nsr_gub_itmp_si_md_kpoint : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ (C : Type u) [CommRing C] [Algebra ↥W C], Algebra.FiniteType ↥W C → (∀ x : C, algebraMap (↥W) C ϖ * x = 0 → x = 0) → ∀ κ : AdicCompletion (Ideal.span {ϖ}) ↥W →+* AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C, (∀ w : ↥W, κ (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) w) = algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C w)) → ∀ 𝔪 : Ideal (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ))), 𝔪.IsMaximal → ∃ (χ : Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ)) →+* FractionRing (AdicCompletion (Ideal.span {ϖ}) ↥W)) (χ₀ : AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C →+* AdicCompletion (Ideal.span {ϖ}) ↥W), (∀ y : AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C, χ (algebraMap (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ))) y) = algebraMap (AdicCompletion (Ideal.span {ϖ}) ↥W) (FractionRing (AdicCompletion (Ideal.span {ϖ}) ↥W)) (χ₀ y)) ∧ (∀ a : AdicCompletion (Ideal.span {ϖ}) ↥W, χ₀ (κ a) = a) ∧ (∀ b : Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ)), b ∈ 𝔪 ↔ χ b = 0) :=
by
  intro Ω _ _ W hW ϖ hϖ0 hϖnu hdiv C _ _ hFT hnzd κ hκ 𝔪 h𝔪
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (r : R) (z : AdicCompletion (Ideal.span {r}) R),
      IsUnit (1 - algebraMap R (AdicCompletion (Ideal.span {r}) R) r * z) := by
    intro R _ r z
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have hs1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
