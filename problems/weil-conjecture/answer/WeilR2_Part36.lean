    intro Y P r T B U t hCH ρ hnd
    obtain ⟨H1, H2, H3, H4, H5, H6⟩ := hCH
    have h00 := H3 0 0
    have h01 := H3 0 1
    have h10 := H3 1 0
    have h4 := H4 0
