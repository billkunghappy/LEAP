        (∀ f : ↥(R.presheaf.stalk (genericPoint ↥R)),
          ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
            (g.appTop.hom.comp (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)).IsIntegralElem f →
          ∃ a : ↥(N.presheaf.stalk n), ((R.presheaf.germ ⊤ (genericPoint ↥R) trivial).hom.comp
            (g.appTop.hom.comp (Scheme.ΓSpecIso (.of ↥(N.presheaf.stalk n))).inv.hom)) a = f) ∧
