      simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
      exact hy
    have hsplit := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (p := q))
    rw [← hsplit, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map] at hev
    have hlc : ι q.leadingCoeff ≠ 0 :=
      (map_ne_zero ι).mpr (Polynomial.leadingCoeff_ne_zero.mpr hq0)
    have hprod := (mul_eq_zero.mp hev).resolve_left hlc
    rw [Multiset.prod_eq_zero_iff, Multiset.mem_map] at hprod
    obtain ⟨r, -, hr⟩ := hprod
    refine ⟨r, ?_⟩
    simp only [Function.comp, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C] at hr
    exact (sub_eq_zero.mp hr).symm

  have R2 : ∀ f : L, A.valuation f ≤ 1 → ∃ b : ↥W, A.valuation (f - φ b) < 1 := by
    intro f hf
    obtain ⟨n, a, hne, hrel, hsum⟩ := H f hf
    obtain ⟨b, j, hbj, hg⟩ := s1 f hf n a hne hrel hsum
    set F : A := ⟨f, (A.valuation_le_one_iff f).1 hf⟩ with hF
    set G : A := ∑ i, ψ (b i) * F ^ (i : ℕ) with hG
    have hGc : (G : L) = ∑ i, φ (b i) * f ^ (i : ℕ) := by
      show A.subtype G = _
      rw [hG, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow]
      rfl
    have hGm : G ∈ IsLocalRing.maximalIdeal A :=
      (A.valuation_lt_one_iff G).mpr (by rw [hGc]; exact hg)
