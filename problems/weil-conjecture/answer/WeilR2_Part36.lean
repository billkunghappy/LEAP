      rw [map_mul, map_pow, ← hc, ha, Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [map_mul, hjA, hA l, map_mul, Polynomial.aeval_C, map_pow, mul_assoc]
