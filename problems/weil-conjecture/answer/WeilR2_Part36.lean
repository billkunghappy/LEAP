    rw [e]
    exact Ideal.mul_mem_left _ _ hN1
  have hρv : algebraMap A ↥(wcLlsASmS W A K u β (β * t)) v ∈ wcLlsASmN W A K u β (β * t) := by
    have key : algebraMap A K u * algebraMap A K v =
