      dsimp only at h1
      rw [Scheme.Hom.appLE, h1]
      haveI := hiso _ _ (homOfLE e).op
        (by rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization])
      simp only [CommRingCat.hom_comp, RingHom.coe_comp]
      exact (ConcreteCategory.bijective_of_isIso _).injective.comp
        (((ConcreteCategory.bijective_of_isIso _).injective.comp (fun x y hxy => Subtype.ext hxy)).comp
