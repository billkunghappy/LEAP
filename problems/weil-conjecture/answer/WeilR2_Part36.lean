  let ι := IsLocalRing.ResidueField.map ψ
  have hι : ∀ c : W, ι (IsLocalRing.residue W c) = IsLocalRing.residue A (ψ c) :=
    fun c => IsLocalRing.ResidueField.map_residue ψ c

  have s2 : ∀ (n : ℕ) (c : Fin (n + 1) → IsLocalRing.ResidueField W) (j : Fin (n + 1)),
      c j ≠ 0 → ∀ y : IsLocalRing.ResidueField A, ∑ i, ι (c i) * y ^ (i : ℕ) = 0 →
      ∃ r, ι r = y := by
    intro n c j hcj y hy
    set q : Polynomial (IsLocalRing.ResidueField W) :=
      ∑ i, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ) with hq
    have hqj : q.coeff (j : ℕ) = c j := by
      rw [hq, Polynomial.finset_sum_coeff, Finset.sum_eq_single j]
      · rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl]
      · intro i _ hij
