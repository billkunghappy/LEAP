    have e := congrArg (P.presheaf.germ (U 0) ρ hρ0).hom h01
    rw [map_mul, hgermLE r (U 0) ρ hρ0 T, hgermLE r (U 0) ρ hρ0 B] at e
    obtain ⟨v, hv⟩ := hu
    refine ⟨↑v⁻¹, ?_⟩
    rw [e, ← hv, mul_comm (v : ↥(P.presheaf.stalk ρ)), mul_assoc, Units.mul_inv, mul_one]

  obtain ⟨hσ, hσx, hb0, hbm⟩ := hP
