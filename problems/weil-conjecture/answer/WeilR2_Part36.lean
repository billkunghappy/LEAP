theorem wcpa_dj_lr1k_nsr_nlb_limit_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
    wcNsrNlbHyp W γ uX ι y₀ τ →
    ∃ A : ValuationSubring C.functionField,
      wcNsrNlbLim W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) A :=
by
  classical
  intro Ω _ _ W C _ γ X uX ι _ _ y₀ τ hH
  obtain ⟨hW, hWt, hcov, hgal, hM, hy₀, hSm, hτ, hE, hnLB⟩ := hH
  set x := wcpaDjLkImg W (γ ≫ ι) uX y₀ with hx

  have vlt : ∀ (A : ValuationSubring C.functionField) (f : C.functionField),
      A.valuation f < 1 ↔ f ∈ A ∧ (f = 0 ∨ f⁻¹ ∉ A) := by
    intro A f
    constructor
    · intro hf
      refine ⟨(A.valuation_le_one_iff f).mp hf.le, ?_⟩
      by_cases h0 : f = 0
      · exact Or.inl h0
      · right
        intro hinv
        have h1 : A.valuation f⁻¹ ≤ 1 := (A.valuation_le_one_iff _).mpr hinv
        have h2 : A.valuation f * A.valuation f⁻¹ = 1 := by
          rw [← map_mul, mul_inv_cancel₀ h0, map_one]
        have h3 : A.valuation f * A.valuation f⁻¹ ≤ A.valuation f := mul_le_of_le_one_right' h1
        rw [h2] at h3
        exact absurd (lt_of_le_of_lt h3 hf) (lt_irrefl 1)
    · rintro ⟨hfA, h | h⟩
      · rw [h, map_zero]; exact zero_lt_one
      · have hle := (A.valuation_le_one_iff f).mpr hfA
        rcases lt_or_eq_of_le hle with h' | h'
        · exact h'
        · exfalso
          apply h
          have h1 : A.valuation f⁻¹ = 1 := by rw [map_inv₀, h', inv_one]
          exact (A.valuation_le_one_iff _).mp h1.le

  have s1 : ∀ (J : Type u) (S T : J → Set C.functionField),
      (∀ F : Finset J, ∃ A : ValuationSubring C.functionField, ∀ j ∈ F,
        (∀ f ∈ S j, A.valuation f ≤ 1) ∧ ∀ f ∈ T j, A.valuation f < 1) →
      ∃ A : ValuationSubring C.functionField, ∀ j,
        (∀ f ∈ S j, A.valuation f ≤ 1) ∧ ∀ f ∈ T j, A.valuation f < 1 := by
    intro J S T hfin
    let Cs : Set (C.functionField → Bool) := {g | g 0 = true ∧ g 1 = true ∧
      (∀ x y, g x = true → g y = true → g (x + y) = true) ∧
      (∀ x y, g x = true → g y = true → g (x * y) = true) ∧
      (∀ x, g x = true → g (-x) = true) ∧ (∀ x, g x = true ∨ g x⁻¹ = true)}
    have key : ∀ (x y z : C.functionField) (p : Bool → Bool → Bool → Prop),
        IsClosed {g : C.functionField → Bool | p (g x) (g y) (g z)} := by
      intro x y z p
      have hc : Continuous
          (fun g : C.functionField → Bool => ((g x, g y, g z) : Bool × Bool × Bool)) := by
        fun_prop
      exact IsClosed.preimage hc
        (isClosed_discrete ({t : Bool × Bool × Bool | p t.1 t.2.1 t.2.2}))
    have hC : IsClosed Cs := by
      have e : Cs = {g : C.functionField → Bool | g 0 = true} ∩
          ({g : C.functionField → Bool | g 1 = true} ∩
          ((⋂ x : C.functionField, ⋂ y : C.functionField,
            {g : C.functionField → Bool | g x = true → g y = true → g (x + y) = true}) ∩
          ((⋂ x : C.functionField, ⋂ y : C.functionField,
            {g : C.functionField → Bool | g x = true → g y = true → g (x * y) = true}) ∩
          ((⋂ x : C.functionField, {g : C.functionField → Bool | g x = true → g (-x) = true}) ∩
          (⋂ x : C.functionField, {g : C.functionField → Bool | g x = true ∨ g x⁻¹ = true}))))) := by
        ext g
        simp only [Cs, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
      rw [e]
      refine IsClosed.inter (key 0 0 0 (fun a _ _ => a = true)) (IsClosed.inter
        (key 1 1 1 (fun a _ _ => a = true)) (IsClosed.inter ?_ (IsClosed.inter ?_
        (IsClosed.inter ?_ ?_))))
      · exact isClosed_iInter fun x => isClosed_iInter fun y =>
          key x y (x + y) (fun a b c => a = true → b = true → c = true)
      · exact isClosed_iInter fun x => isClosed_iInter fun y =>
          key x y (x * y) (fun a b c => a = true → b = true → c = true)
      · exact isClosed_iInter fun x => key x x (-x) (fun a _ c => a = true → c = true)
      · exact isClosed_iInter fun x => key x x x⁻¹ (fun a _ c => a = true ∨ c = true)
    let Z : J → Set (C.functionField → Bool) := fun j =>
      (⋂ f ∈ S j, {g : C.functionField → Bool | g f = true}) ∩
        (⋂ f ∈ T j, {g : C.functionField → Bool | g f = true ∧ (f = 0 ∨ ¬ g f⁻¹ = true)})
    have hZ : ∀ j, IsClosed (Z j) := fun j =>
      (isClosed_biInter fun f _ => key f f f (fun a _ _ => a = true)).inter
        (isClosed_biInter fun f _ =>
          key f f f⁻¹ (fun a _ c => a = true ∧ (f = 0 ∨ ¬ c = true)))
    obtain ⟨g, hgC, hgZ⟩ := hC.isCompact.inter_iInter_nonempty Z hZ (fun F => by
      obtain ⟨A, hA⟩ := hfin F
      let χ : C.functionField → Bool := fun y => decide (y ∈ A)
      have hχ : χ ∈ Cs := by
        refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
        · simp [χ, A.zero_mem]
        · simp [χ, A.one_mem]
        · intro x y hx hy
          simp only [χ, decide_eq_true_eq] at hx hy ⊢
          exact A.add_mem _ _ hx hy
        · intro x y hx hy
          simp only [χ, decide_eq_true_eq] at hx hy ⊢
          exact A.mul_mem _ _ hx hy
        · intro x hx
          simp only [χ, decide_eq_true_eq] at hx ⊢
          exact A.neg_mem _ hx
        · intro x
          simp only [χ, decide_eq_true_eq]
          exact A.mem_or_inv_mem x
      refine ⟨χ, hχ, Set.mem_iInter₂.mpr fun j hj =>
        ⟨Set.mem_iInter₂.mpr fun f hf => ?_, Set.mem_iInter₂.mpr fun f hf => ?_⟩⟩
      · show decide (f ∈ A) = true
        rw [decide_eq_true_eq]
        exact (A.valuation_le_one_iff f).mp ((hA j hj).1 f hf)
      · show decide (f ∈ A) = true ∧ (f = 0 ∨ ¬ decide (f⁻¹ ∈ A) = true)
        rw [decide_eq_true_eq, decide_eq_true_eq]
        exact (vlt A f).mp ((hA j hj).2 f hf))
    let Wg : ValuationSubring C.functionField :=
      { carrier := {x | g x = true}
        mul_mem' := fun {a b} ha hb => hgC.2.2.2.1 a b ha hb
        one_mem' := hgC.2.1
        add_mem' := fun {a b} ha hb => hgC.2.2.1 a b ha hb
        zero_mem' := hgC.1
        neg_mem' := fun {a} ha => hgC.2.2.2.2.1 a ha
        mem_or_inv_mem' := fun x => hgC.2.2.2.2.2 x }
    refine ⟨Wg, fun j => ?_⟩
    have hj : g ∈ Z j := Set.mem_iInter.mp hgZ j
    refine ⟨fun f hf => ?_, fun f hf => ?_⟩
    · rw [ValuationSubring.valuation_le_one_iff]
      exact Set.mem_iInter₂.mp hj.1 f hf
    · rw [vlt]
      exact Set.mem_iInter₂.mp hj.2 f hf

  have s3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (φ : R →+* C.functionField),
      ∃ A : ValuationSubring C.functionField, (∀ s : R, A.valuation (φ s) ≤ 1) ∧
        ∀ s ∈ IsLocalRing.maximalIdeal R, A.valuation (φ s) < 1 := by
    intro R _ _ φ
    obtain ⟨A, hA⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.range φ)
    obtain ⟨hsub, hloc⟩ := LocalSubring.le_def.mp hA
    have hmemR : ∀ s : R, φ s ∈ (LocalSubring.range φ).toSubring := by
      intro s
      rw [LocalSubring.range_toSubring]
      exact Set.mem_range_self s
    have hmem : ∀ s : R, φ s ∈ A := fun s => hsub (hmemR s)
    refine ⟨A, fun s => (A.valuation_le_one_iff _).mpr (hmem s), fun s hs => ?_⟩
    by_contra hlt
    have hle : A.valuation (φ s) ≤ 1 := (A.valuation_le_one_iff _).mpr (hmem s)
    have heq : A.valuation (φ s) = 1 := le_antisymm hle (not_lt.mp hlt)
    have hne : φ s ≠ 0 := by
      intro h; rw [h, map_zero] at heq; exact zero_ne_one heq
    have hinv : (φ s)⁻¹ ∈ A := by
      have h1 : A.valuation (φ s)⁻¹ = 1 := by rw [map_inv₀, heq, inv_one]
      exact (A.valuation_le_one_iff _).mp h1.le
    let a : (LocalSubring.range φ).toSubring := ⟨φ s, hmemR s⟩
    have hu : IsUnit (Subring.inclusion hsub a) := by
      refine isUnit_of_dvd_one ⟨(⟨(φ s)⁻¹, hinv⟩ : A.toLocalSubring.toSubring), ?_⟩
      apply Subtype.ext
      show (1 : C.functionField) = φ s * (φ s)⁻¹
      rw [mul_inv_cancel₀ hne]
    have hua : IsUnit a := hloc.map_nonunit a hu
    obtain ⟨b, hb⟩ := hua.exists_right_inv
    obtain ⟨r, hr⟩ : ∃ r, φ r = (b : C.functionField) := by
      have hR : ∀ y ∈ (LocalSubring.range φ).toSubring, y ∈ Set.range φ := by
        intro y hy
        rw [LocalSubring.range_toSubring] at hy
        exact hy
      exact hR _ b.2
    have h1 : φ (s * r) = 1 := by
      rw [map_mul, hr]
      exact congrArg Subtype.val hb
    have hsr : s * r ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right r _ hs
    have hunit : IsUnit (1 - s * r) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp hsr)
    have h2 : φ (1 - s * r) = 0 := by rw [map_sub, map_one, h1, sub_self]
    exact (hunit.map φ).ne_zero h2

  have G3 : ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
      wcpaDjLlPair W uX x σ a → wcpaDjLlPair W uX x σ' a' →
      σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a →
      ¬ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' →
      a ∣ a' ∧ ¬ a' ∣ a := by
    intro σ a σ' a' hP hP' hle hnle
    obtain ⟨h1, h2⟩ := (hτ.2.2 σ a σ' a' hP hP').mp hle
    refine ⟨h1, fun h3 => hnle ((hτ.2.2 σ' a' σ a hP' hP).mpr ⟨h3, ?_⟩)⟩
    have h4 : a' ∣ τ σ' - τ σ := dvd_trans h3 h2
    have h5 : τ σ - τ σ' = -(τ σ' - τ σ) := by ring
    rw [h5]
    exact dvd_neg.mpr h4

  haveI hprop : IsProper uX := hM.1.2.1
  haveI hflat : Flat uX := hM.1.1
  haveI hlfp : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) X uX hflat inferInstance

  have hstar : ∀ (σs : Spec (.of ↥W) ⟶ X) (as : ↥W), wcpaDjLlPair W uX x σs as →
      ∃ A : ValuationSubring C.functionField,
        wcNlbWDom W (γ ≫ ι) uX A ∧ wcNlbQ W (γ ≫ ι) uX x σs as A := by
    intro σs as hP
    obtain ⟨hσs, hσx, ha0, ham⟩ := hP
    obtain ⟨Xs, rs, hbl, ⟨ιs, hιs, hMs⟩, -⟩ :=
      wcpa_dj_lr1k_imp_blowup_model Ω W hW hWt X uX ι hM σs hσs
        (wcpaDjLkPi W (γ ≫ ι) uX y₀) hσx.symm hSm as ha0 ham
    have hinv := (wcpa_dj_nc_centre_props Ω W hW X uX σs as hlfp inferInstance hσs ha0 ham).2.2
    obtain ⟨σs₁, hσs₁, -⟩ := hbl.2 (Spec (.of ↥W)) σs hinv
    have hy := wcpa_dj_lr1k_nsr_nlb_lv_generic_spec Ω W C γ hcov Xs (rs ≫ uX) ιs hMs
      (σs₁ (IsLocalRing.closedPoint ↥W))
    obtain ⟨A, hA1, hA2⟩ := s3 _ (wcLr1uGerm (γ ≫ ιs) _ hy).hom
    exact ⟨A, (wcpa_dj_lr1k_nsr_nlb_lv_dom_iff_Q Ω W hW hWt C γ hcov X uX ι hM x
      (wcpaDjLkPi W (γ ≫ ι) uX y₀) rfl hSm σs as σs as ⟨hσs, hσx, ha0, ham⟩
      ⟨hσs, hσx, ha0, ham⟩ le_rfl Xs rs ιs hbl hιs hMs σs₁ hσs₁ A).mp ⟨hy, hA1, hA2⟩⟩

  let Pd : Set C.functionField × Set C.functionField → Prop := fun ST =>
      ∃ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W)
        (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁) (σ₁ : Spec (.of ↥W) ⟶ X₁),
        wcpaDjLlPair W uX x σ a ∧ wcpaDjLlPair W uX x σ' a' ∧
        wcpaDjLlExh W γ uX ι x σ a ∧ wcpaDjLlExh W γ uX ι x σ' a' ∧
        σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ∧
        ¬ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ∧
        wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₁ ∧ ι₁ ≫ r₁ = ι ∧
        wcpaDjLkModel W (r₁ ≫ uX) ι₁ ∧ σ₁ ≫ r₁ = σ' ∧
        ∀ A : ValuationSubring C.functionField,
          (wcNsrNaDom A (γ ≫ ι₁) (σ₁ (IsLocalRing.closedPoint ↥W)) ↔
            ((∀ f ∈ ST.1, A.valuation f ≤ 1) ∧ ∀ f ∈ ST.2, A.valuation f < 1))
  have hJ : ∀ j : {ST // Pd ST}, Pd j.1 := fun j => j.2
  choose σf af σ'f a'f X₁f r₁f ι₁f σ₁f hP hP' hEx hEx' hle hnle hbl hι hM₁ hσ₁ hiff using hJ

  have minex : ∀ F : Finset {ST // Pd ST}, F.Nonempty → ∃ js ∈ F, ∀ k ∈ F,
      (σ'f js).ker ⊔ wcNcPrincipal (.of ↥W) X uX (a'f js) ≤
        (σ'f k).ker ⊔ wcNcPrincipal (.of ↥W) X uX (a'f k) := by
    intro F
    induction F using Finset.induction_on with
    | empty => intro hF; exact absurd hF Finset.not_nonempty_empty
    | insert a F' haF ih =>
      intro _
      by_cases hF' : F'.Nonempty
      · obtain ⟨j, hj, hjmin⟩ := ih hF'
        rcases hE.2.2 (σ'f a) (a'f a) (σ'f j) (a'f j) (hP' a) (hP' j) (hEx' a) (hEx' j) with h | h
        · refine ⟨a, Finset.mem_insert_self _ _, fun k hk => ?_⟩
          rcases Finset.mem_insert.mp hk with hk | hk
          · rw [hk]
          · exact h.trans (hjmin k hk)
        · refine ⟨j, Finset.mem_insert_of_mem hj, fun k hk => ?_⟩
          rcases Finset.mem_insert.mp hk with hk | hk
          · rw [hk]; exact h
          · exact hjmin k hk
      · have hF'e : F' = ∅ := Finset.not_nonempty_iff_eq_empty.mp hF'
        refine ⟨a, Finset.mem_insert_self _ _, fun k hk => ?_⟩
        rw [hF'e] at hk
        rcases Finset.mem_insert.mp hk with hk | hk
        · rw [hk]
        · exact absurd hk (Finset.notMem_empty k)

  have hfinite : ∀ F : Finset {ST // Pd ST}, ∃ A : ValuationSubring C.functionField, ∀ j ∈ F,
      (∀ f ∈ j.1.1, A.valuation f ≤ 1) ∧ ∀ f ∈ j.1.2, A.valuation f < 1 := by
    intro F
    rcases F.eq_empty_or_nonempty with hF | hF
    · exact ⟨⊤, fun j hj => by rw [hF] at hj; exact absurd hj (Finset.notMem_empty j)⟩
    obtain ⟨js, -, hmin⟩ := minex F hF
    obtain ⟨A, hWD, hQ⟩ := hstar (σ'f js) (a'f js) (hP' js)
    refine ⟨A, fun j hj => ?_⟩
    obtain ⟨hdiv, hndiv⟩ := G3 (σf j) (af j) (σ'f j) (a'f j) (hP j) (hP' j) (hle j) (hnle j)
    have hQj := wcpa_dj_lr1k_nsr_nlb_lv_q_shift Ω W C γ X uX ι hM x (σ'f j) (a'f j) (σ'f js)
      (a'f js) (af j) (hP' j) (hP' js) (hP j).2.2.1 (hmin j hj) hdiv hndiv A hWD hQ
    have hdom := (wcpa_dj_lr1k_nsr_nlb_lv_dom_iff_Q Ω W hW hWt C γ hcov X uX ι hM x
      (wcpaDjLkPi W (γ ≫ ι) uX y₀) rfl hSm (σf j) (af j) (σ'f j) (a'f j) (hP j) (hP' j) (hle j)
      (X₁f j) (r₁f j) (ι₁f j) (hbl j) (hι j) (hM₁ j) (σ₁f j) (hσ₁ j) A).mpr ⟨hWD, hQj⟩
    exact (hiff j A).mp hdom

  obtain ⟨A, hA⟩ := s1 {ST // Pd ST} (fun j => j.1.1) (fun j => j.1.2) hfinite
  refine ⟨A, ?_⟩
  unfold wcNsrNlbLim
  intro σ a σ' a' hPa hPa' hExa hExa' hlea hnlea X₁ r₁ ι₁ hbla hιa hM₁a σ₁ hσ₁a
  have hy := wcpa_dj_lr1k_nsr_nlb_lv_generic_spec Ω W C γ hcov X₁ (r₁ ≫ uX) ι₁ hM₁a
    (σ₁ (IsLocalRing.closedPoint ↥W))
  have hiffa : ∀ B : ValuationSubring C.functionField,
      (wcNsrNaDom B (γ ≫ ι₁) (σ₁ (IsLocalRing.closedPoint ↥W)) ↔
        ((∀ f ∈ Set.range (wcLr1uGerm (γ ≫ ι₁) _ hy).hom, B.valuation f ≤ 1) ∧
          ∀ f ∈ (wcLr1uGerm (γ ≫ ι₁) _ hy).hom ''
            ((IsLocalRing.maximalIdeal (X₁.presheaf.stalk (σ₁ (IsLocalRing.closedPoint ↥W))) :
              Set (X₁.presheaf.stalk (σ₁ (IsLocalRing.closedPoint ↥W))))),
            B.valuation f < 1)) := by
    intro B
    constructor
    · rintro ⟨hy', h1, h2⟩
      refine ⟨?_, ?_⟩
      · rintro f ⟨s, rfl⟩; exact h1 s
      · rintro f ⟨s, hs, rfl⟩; exact h2 s hs
    · rintro ⟨h1, h2⟩
      exact ⟨hy, fun s => h1 _ ⟨s, rfl⟩, fun s hs => h2 _ ⟨s, hs, rfl⟩⟩
  have hj : Pd (Set.range (wcLr1uGerm (γ ≫ ι₁) _ hy).hom,
      (wcLr1uGerm (γ ≫ ι₁) _ hy).hom ''
        ((IsLocalRing.maximalIdeal (X₁.presheaf.stalk (σ₁ (IsLocalRing.closedPoint ↥W))) :
          Set (X₁.presheaf.stalk (σ₁ (IsLocalRing.closedPoint ↥W)))))) :=
    ⟨σ, a, σ', a', X₁, r₁, ι₁, σ₁, hPa, hPa', hExa, hExa', hlea, hnlea, hbla, hιa, hM₁a,
      hσ₁a, hiffa⟩
  exact (hiffa A).mpr (hA ⟨_, hj⟩)

theorem wcpa_dj_lr1k_llfi_cover_injective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → ∀ V : (wcProjK Ω 1).Opens, Function.Injective (γ.app V).hom :=
by
  intro Ω _ _ C γ hcov U
  haveI : IrreducibleSpace C := hcov.2.2.1
  obtain ⟨V₀, hV₀d, hV₀e⟩ := hcov.2.2.2.2
  haveI : AlgebraicGeometry.IsIntegral (wcProjK Ω 1) := (wc_projK_integral_normal Ω 1).1
  obtain ⟨c, hc⟩ : ∃ c : C, γ c = genericPoint (wcProjK Ω 1) := by
    haveI : Nonempty C := IrreducibleSpace.toNonempty
    obtain ⟨v, hv⟩ := hV₀d.nonempty
    haveI : Flat (V₀.ι ≫ γ) := inferInstance
    have hgen : GeneralizingMap (V₀.ι ≫ γ) := Flat.generalizingMap _
    have hsp : genericPoint (wcProjK Ω 1) ⤳ (V₀.ι ≫ γ) ⟨v, hv⟩ :=
      genericPoint_specializes _
    obtain ⟨a', -, ha'⟩ := hgen hsp
    exact ⟨V₀.ι a', by rw [← Scheme.Hom.comp_apply]; exact ha'⟩
  by_cases hU : U = ⊥
  · subst hU
    intro a b _
    exact Subsingleton.elim a b
  · have hη : genericPoint (wcProjK Ω 1) ∈ U := by
      have hne : (U : Set (wcProjK Ω 1)).Nonempty :=
        (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
      exact ((genericPoint_spec (wcProjK Ω 1)).mem_open_set_iff U.isOpen).mpr
        (by rw [Set.univ_inter]; exact hne)
    have hx : γ c ∈ U := by rw [hc]; exact hη
    have hF : IsField ((wcProjK Ω 1).presheaf.stalk (γ c)) := by
      rw [hc]; exact Field.toIsField (wcProjK Ω 1).functionField
    have hφ : Function.Injective (γ.stalkMap c).hom := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      by_contra hne
      obtain ⟨b, hb⟩ := hF.mul_inv_cancel hne
      have h1 : (γ.stalkMap c).hom (a * b) = 1 := by rw [hb, map_one]
      rw [map_mul, ha, zero_mul] at h1
      exact zero_ne_one h1
    have hgerm := germ_injective_of_isIntegral (wcProjK Ω 1) (γ c) hx
    intro s t hst
    apply hgerm
    apply hφ
    rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.germ_stalkMap_apply, hst]

theorem wcpa_dj_lr1k_llfi_generic_integral : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), AlgebraicGeometry.IsIntegral X → (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → ∀ U : X.Opens, IsAffineOpen U → ∀ t : Γ(wcProjK Ω 1, ι ⁻¹ᵁ U), (ι.app U).hom.IsIntegralElem t → ∃ r : Γ(X, U), (ι.app U).hom r = t :=
by
  intro Ω _ W hW hWt X uX ι hXint hXnorm hpb U hU t ht
  classical
  haveI := hXint

  haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
  have hprimes : ∀ I : Ideal ↥W, I.IsPrime → I = ⊥ ∨ I = IsLocalRing.maximalIdeal ↥W := by
    intro I hI
    rcases Ring.krullDimLE_one_iff.mp inferInstance I hI with h | h
    · exact Or.inl (le_bot_iff.mp (h.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le))
    · exact Or.inr (IsLocalRing.eq_maximalIdeal h)
  obtain ⟨t', ht'⟩ : ∃ t' : Ω, t' ∉ W := by
    by_contra hcon
    push_neg at hcon
    exact hWt (eq_top_iff.mpr fun x _ => hcon x)
  have ht0 : t' ≠ 0 := fun h => ht' (h ▸ W.zero_mem)
  have hti : t'⁻¹ ∈ W := (W.mem_or_inv_mem t').resolve_left ht'
  obtain ⟨a, ha⟩ : ∃ a : ↥W, a = ⟨t'⁻¹, hti⟩ := ⟨_, rfl⟩
  have hav : (a : Ω) = t'⁻¹ := by rw [ha]
  have ha0 : a ≠ 0 := fun h => inv_ne_zero ht0 (by rw [← hav, h]; rfl)
  have ham : a ∈ IsLocalRing.maximalIdeal ↥W := by
    intro hu
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    apply ht'
    have hv' : t'⁻¹ * (v : Ω) = 1 := by rw [← hav]; exact congrArg Subtype.val hv
    have : (v : Ω) = t' := by
      have := congrArg (t' * ·) hv'
      simp only [mul_one] at this
      rw [← mul_assoc, mul_inv_cancel₀ ht0, one_mul] at this
      exact this
    rw [← this]; exact v.2
  have hloc : IsLocalization.Away a Ω := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, n, rfl⟩
      simp only [map_pow]
      apply IsUnit.pow
      exact isUnit_iff_ne_zero.mpr (by
        show (a : Ω) ≠ 0
        rw [hav]; exact inv_ne_zero ht0)
    · intro x
      by_cases hx : x ∈ W
      · exact ⟨(⟨x, hx⟩, 1), by simp⟩
      · have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
        have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
        obtain ⟨y, hy⟩ : ∃ y : ↥W, y = ⟨x⁻¹, hxi⟩ := ⟨_, rfl⟩
        have hyv : (y : Ω) = x⁻¹ := by rw [hy]
        have hy0 : y ≠ 0 := fun h => inv_ne_zero hx0 (by rw [← hyv, h]; rfl)
        have hamem : a ∈ (Ideal.span {y}).radical := by
          rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
          rintro J ⟨hyJ, hJ⟩
          rcases hprimes J hJ with h | h
          · exfalso
            apply hy0
            have : y ∈ J := hyJ (Ideal.mem_span_singleton_self y)
            rw [h] at this
            simpa using this
          · rw [h]; exact ham
        obtain ⟨n, hn⟩ := hamem
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
        refine ⟨(w, ⟨a ^ n, n, rfl⟩), ?_⟩
        have hw' : (w : Ω) * x⁻¹ = (a : Ω) ^ n := by
          rw [← hyv]
          have := congrArg Subtype.val hw
          simpa using this
        show x * algebraMap ↥W Ω (a ^ n) = algebraMap ↥W Ω w
        simp only [map_pow]
        show x * (a : Ω) ^ n = (w : Ω)
        rw [← hw', mul_comm (w : Ω), ← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
    · intro x y hxy
      exact ⟨1, by simpa using Subtype.val_injective hxy⟩
  haveI heW : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
    IsOpenImmersion.of_isLocalization a
  have hra : ∀ z : ↥(Spec (.of ↥W)),
      z ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ↔ a ∉ z.asIdeal := by
    intro z
    constructor
    · rintro ⟨x, rfl⟩ hz
      have hx : (x : PrimeSpectrum Ω).asIdeal = ⊥ :=
        @Ideal.eq_bot_of_prime _ _ _ (PrimeSpectrum.isPrime (x : PrimeSpectrum Ω))
      have h1 : Ideal.comap (algebraMap ↥W Ω) (x : PrimeSpectrum Ω).asIdeal = ⊥ := by
        rw [hx]
        exact (RingHom.injective_iff_ker_eq_bot _).mp Subtype.val_injective
      have h2 : a ∈ Ideal.comap (algebraMap ↥W Ω) (x : PrimeSpectrum Ω).asIdeal := hz
      rw [h1] at h2
      exact ha0 (by simpa using h2)
    · intro hz
      have hz' : z.asIdeal = ⊥ := by
        rcases hprimes z.asIdeal z.isPrime with h | h
        · exact h
        · exact absurd (by rw [h]; exact ham) hz
      refine ⟨⟨⊥, Ideal.isPrime_bot⟩, ?_⟩
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap ↥W Ω) ⊥ = z.asIdeal
      rw [hz']
      exact (RingHom.injective_iff_ker_eq_bot _).mp Subtype.val_injective
  haveI hιo : IsOpenImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip heW
  have hrι : ∀ x : X, x ∈ Set.range ⇑ι ↔ a ∉ (uX x).asIdeal := by
    intro x
    rw [← hra]
    constructor
    · rintro ⟨p, rfl⟩
      refine ⟨wcProjKStr Ω 1 p, ?_⟩
      have := congrArg (fun f : wcProjK Ω 1 ⟶ Spec (.of ↥W) => f p) hpb.w
      simp only [Scheme.Hom.comp_apply] at this
      exact this.symm
    · rintro ⟨y, hy⟩
      obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := uX) (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x y hy.symm
      refine ⟨hpb.isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, hpb.isoPullback_inv_fst, hw1]

  have hVU : ι ''ᵁ ι ⁻¹ᵁ U ≤ U := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf]; exact inf_le_right
  have hkey : X.presheaf.map (homOfLE hVU).op ≫ (ι.appIso (ι ⁻¹ᵁ U)).hom = ι.app U := by
    rw [Scheme.Hom.appIso_hom, ← Category.assoc, Scheme.Hom.naturality, Category.assoc,
      ← Functor.map_comp]
    conv_rhs => rw [← Category.comp_id (ι.app U)]
    congr 1
  have hres : X.presheaf.map (homOfLE hVU).op = ι.app U ≫ (ι.appIso (ι ⁻¹ᵁ U)).inv := by
    rw [← hkey, Category.assoc, Iso.hom_inv_id, Category.comp_id]

  by_cases hA : Subsingleton Γ(X, U)
  · refine ⟨0, ?_⟩
    have h10 : (1 : Γ(wcProjK Ω 1, ι ⁻¹ᵁ U)) = 0 := by
      rw [← map_one (ι.app U).hom, ← map_zero (ι.app U).hom, Subsingleton.elim (1 : Γ(X, U)) 0]
    haveI := subsingleton_of_zero_eq_one h10.symm
    exact Subsingleton.elim _ _

  rw [not_subsingleton_iff_nontrivial] at hA
  obtain ⟨P⟩ := (PrimeSpectrum.nonempty_iff_nontrivial (R := Γ(X, U))).mpr hA
  have hxP : hU.fromSpec P ∈ U := by
    have := Set.mem_range_self (f := hU.fromSpec) P
    rwa [hU.range_fromSpec] at this
  haveI hUne : Nonempty U := ⟨⟨_, hxP⟩⟩
  haveI : IsDomain Γ(X, U) := IsIntegral.component_integral U

  haveI : IsIntegrallyClosed Γ(X, U) := by
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    let Q : Spec Γ(X, U) := ⟨p, hpm.isPrime⟩
    have hx : hU.fromSpec Q ∈ U := by
      have := Set.mem_range_self (f := hU.fromSpec) Q
      rwa [hU.range_fromSpec] at this
    let x : U := ⟨_, hx⟩
    have hq : hU.primeIdealOf x = Q := by
      haveI := hU.isOpenImmersion_fromSpec
      apply hU.fromSpec.isOpenEmbedding.injective
      rw [hU.fromSpec_primeIdealOf]
    letI : Algebra Γ(X, U) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf x
    have hlocx : IsLocalization.AtPrime (X.presheaf.stalk (x : X)) p := by
      have := hU.isLocalization_stalk x
      rw [hq] at this
      exact this
    let e := IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
      (X.presheaf.stalk (x : X))
    haveI := hXnorm (x : X)
    exact IsIntegrallyClosed.of_equiv e.symm.toRingEquiv

  have s1' : ∀ x : X, x ∈ X.basicOpen (wcCnSigma uX U a) ↔ x ∈ U ∧ a ∉ (uX x).asIdeal := by
    intro x
    have e : wcCnSigma uX U a = (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) := rfl
    have h2 : x ∈ X.basicOpen (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) ↔
        uX x ∈ (Spec (.of ↥W)).basicOpen ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) := by
      rw [← Scheme.preimage_basicOpen_top]
      rfl
    rw [e, Scheme.basicOpen_res, TopologicalSpace.Opens.mem_inf, h2,
      AlgebraicGeometry.basicOpen_eq_of_affine]
    exact ⟨fun h => ⟨h.1, (PrimeSpectrum.mem_basicOpen _ _).mp h.2⟩,
      fun h => ⟨h.1, (PrimeSpectrum.mem_basicOpen _ _).mpr h.2⟩⟩
  have hVeq : ι ''ᵁ ι ⁻¹ᵁ U = X.basicOpen (wcCnSigma uX U a) := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
    ext x
    simp only [SetLike.mem_coe]
    rw [TopologicalSpace.Opens.mem_inf, s1', Scheme.Hom.mem_opensRange]
    exact ⟨fun h => ⟨h.2, (hrι x).mp h.1⟩, fun h => ⟨(hrι x).mpr h.2, h.1⟩⟩
  letI : Algebra Γ(X, U) Γ(X, ι ''ᵁ ι ⁻¹ᵁ U) := (X.presheaf.map (homOfLE hVU).op).hom.toAlgebra
  haveI hlocV : IsLocalization.Away (wcCnSigma uX U a) Γ(X, ι ''ᵁ ι ⁻¹ᵁ U) :=
    hU.isLocalization_of_eq_basicOpen (wcCnSigma uX U a) (homOfLE hVU) hVeq

  have s4 : ∀ (A C : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing C]
      [Algebra A C] (s : A), IsLocalization.Away s C → ∀ c : C, IsIntegral A c →
      ∃ r : A, algebraMap A C r = c := by
    intro A C _ _ _ _ _ s hlocs c hc
    by_cases hs : s = 0
    · have hu : IsUnit (algebraMap A C 0) :=
        IsLocalization.map_units C (⟨0, 1, by simp [hs]⟩ : Submonoid.powers s)
      rw [map_zero, isUnit_zero_iff] at hu
      haveI : Subsingleton C := subsingleton_of_zero_eq_one hu
      exact ⟨0, Subsingleton.elim _ _⟩
    · have hunit : ∀ y : Submonoid.powers s, IsUnit (algebraMap A (FractionRing A) y) := by
        rintro ⟨_, n, rfl⟩
        exact isUnit_iff_ne_zero.mpr
          ((map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).mpr
            (pow_ne_zero n hs))
      obtain ⟨lam, hlam⟩ : ∃ lam : C →+* FractionRing A,
          ∀ x : A, lam (algebraMap A C x) = algebraMap A (FractionRing A) x :=
        ⟨IsLocalization.lift (M := Submonoid.powers s) hunit, IsLocalization.lift_eq hunit⟩
      letI : Algebra C (FractionRing A) := lam.toAlgebra
      haveI : IsScalarTower A C (FractionRing A) :=
        IsScalarTower.of_algebraMap_eq (fun x => (hlam x).symm)
      haveI : IsFractionRing C (FractionRing A) :=
        IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers s) C
          (FractionRing A)
      have hcK : IsIntegral A (algebraMap C (FractionRing A) c) :=
        hc.map (IsScalarTower.toAlgHom A C (FractionRing A))
      obtain ⟨r, hr⟩ := (IsIntegrallyClosed.isIntegral_iff (R := A) (K := FractionRing A)).mp hcK
      refine ⟨r, IsFractionRing.injective C (FractionRing A) ?_⟩
      rw [← IsScalarTower.algebraMap_apply]
      exact hr

  have hcint : IsIntegral Γ(X, U) ((ι.appIso (ι ⁻¹ᵁ U)).inv.hom t) := by
    obtain ⟨p, hpm, hp⟩ := ht
    refine ⟨p, hpm, ?_⟩
    have halg : algebraMap Γ(X, U) Γ(X, ι ''ᵁ ι ⁻¹ᵁ U) =
        (ι.appIso (ι ⁻¹ᵁ U)).inv.hom.comp (ι.app U).hom := by
      rw [RingHom.algebraMap_toAlgebra, hres]; rfl
    rw [halg, ← Polynomial.hom_eval₂, hp, map_zero]
  obtain ⟨r, hr⟩ := s4 Γ(X, U) Γ(X, ι ''ᵁ ι ⁻¹ᵁ U) (wcCnSigma uX U a) hlocV _ hcint
  refine ⟨r, ?_⟩
  have h1 : (ι.app U).hom r =
      (ι.appIso (ι ⁻¹ᵁ U)).hom.hom ((X.presheaf.map (homOfLE hVU).op).hom r) := by
    rw [← hkey]; rfl
  have hr' : (X.presheaf.map (homOfLE hVU).op).hom r = (ι.appIso (ι ⁻¹ᵁ U)).inv.hom t := hr
  rw [h1, hr']
  show ((ι.appIso (ι ⁻¹ᵁ U)).inv ≫ (ι.appIso (ι ⁻¹ᵁ U)).hom).hom t = t
  rw [Iso.inv_hom_id]
  rfl

theorem wcpa_dj_lr1k_nsr_nlb_centre_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
    wcNsrNlbHyp W γ uX ι y₀ τ →
    ∀ A₁ : ValuationSubring C.functionField,
      wcNsrNlbLim W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) A₁ →
      ∃ A : ValuationSubring C.functionField,
        wcNsrNlbLim W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) A ∧
        wcNsrNaDom A (γ ≫ ι).toNormalization (wcNdPt W (γ ≫ ι) uX y₀) :=
by
  intro Ω _ _ W C _ γ X uX ι _ _ y₀ τ hH A₁ hLim
  classical
  obtain ⟨hW, hWt, hcov, hgal, hM, _hBad, hSm, hτ, hE, hnLB⟩ := hH
  obtain ⟨-, -, hτ3⟩ := hτ
  obtain ⟨⟨σ, a, hP, hX⟩, -, hE3⟩ := hE

  have hex : ∃ (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' ∧
      wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' ∧
      ¬ (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a') := by
    by_contra hcon
    apply hnLB
    refine ⟨σ, a, hP, fun σ' a' h1 h2 => ?_⟩
    by_contra hle
    exact hcon ⟨σ', a', h1, h2, hle⟩
  obtain ⟨σ', a', hP', hX', hnle⟩ := hex
  have hle : σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' ≤ σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a :=
    (hE3 σ a σ' a' hP hP' hX hX').resolve_left hnle
  have hdiv : a ∣ τ σ' - τ σ := ((hτ3 σ a σ' a' hP hP').mp hle).2

  obtain ⟨X₁, r₁, hbl, ⟨ι₁, hι₁, hM₁⟩, -⟩ :=
    wcpa_dj_lr1k_imp_blowup_model Ω W hW hWt X uX ι hM σ hP.1 (wcpaDjLkPi W (γ ≫ ι) uX y₀)
      hP.2.1.symm hSm a hP.2.2.1 hP.2.2.2

  obtain ⟨hflat, hprop, -⟩ := hM.1
  haveI : IsProper uX := hprop
  have hLFP : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) X uX hflat inferInstance
  have hPsa : wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a :=
    ⟨hP'.1, hP'.2.1, hP.2.2.1, hP.2.2.2⟩
  have hIeq : σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a = σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a := by
    apply le_antisymm
    · refine (hτ3 σ' a σ a hPsa hP).mpr ⟨dvd_refl a, ?_⟩
      rw [← neg_sub]
      exact dvd_neg.mpr hdiv
    · exact (hτ3 σ a σ' a hP hPsa).mpr ⟨dvd_refl a, hdiv⟩
  have hinvσ' : wcCsdInvPull (σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) σ' :=
    (wcpa_dj_nc_centre_props Ω W hW X uX σ' a hLFP inferInstance hP'.1 hP.2.2.1 hP.2.2.2).2.2
  rw [← hIeq] at hinvσ'
  obtain ⟨σ₁, hσ₁, -⟩ := hbl.2 (Spec (.of ↥W)) σ' hinvσ'

  have hD₁ := hLim σ a σ' a' hP hP' hX hX' hle hnle X₁ r₁ ι₁ hbl hι₁ hM₁ σ₁ hσ₁

  have push : ∀ (A : ValuationSubring C.functionField) {Y Y' : Scheme.{u}} (h : C ⟶ Y)
      (r : Y ⟶ Y') (y : ↥Y), wcNsrNaDom A h y → wcNsrNaDom A (h ≫ r) (r y) := by
    intro A Y Y' h r y hd
    obtain ⟨hy, d1, d2⟩ := hd
    have hy' : (h ≫ r) (genericPoint C) ⤳ r y := by
      rw [Scheme.Hom.comp_apply]; exact hy.map r.continuous
    have hg : wcLr1uGerm (h ≫ r) (r y) hy' = r.stalkMap y ≫ wcLr1uGerm h y hy := by
      unfold wcLr1uGerm
      rw [Scheme.Hom.stalkMap_comp]
      simp only [Category.assoc]
      rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc]
      rfl
    refine ⟨hy', fun s => ?_, fun s hs => ?_⟩
    · rw [hg, CommRingCat.hom_comp, RingHom.comp_apply]
      exact d1 _
    · rw [hg, CommRingCat.hom_comp, RingHom.comp_apply]
      apply d2
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hs ⊢
      exact fun hu => hs (isUnit_of_map_unit _ s hu)
  have hDx := push A₁ (γ ≫ ι₁) r₁ (σ₁ (IsLocalRing.closedPoint ↥W)) hD₁
  have e1 : (γ ≫ ι₁) ≫ r₁ = γ ≫ ι := by rw [Category.assoc, hι₁]
  have e2 : r₁ (σ₁ (IsLocalRing.closedPoint ↥W)) = wcpaDjLkImg W (γ ≫ ι) uX y₀ := by
    have k : ∀ p, (σ₁ ≫ r₁) p = σ' p := fun p => by rw [hσ₁]
    exact (Scheme.Hom.comp_apply σ₁ r₁ _).symm.trans ((k _).trans hP'.2.1)
  rw [e1, e2] at hDx

  have centre : ∀ {C Y N : Scheme.{u}} [AlgebraicGeometry.IsIntegral C]
      (A : ValuationSubring C.functionField) (f : C ⟶ Y) (j : C ⟶ N) (ν : N ⟶ Y)
      [UniversallyClosed ν], j ≫ ν = f → ∀ z : ↥Y, wcNsrNaDom A f z →
      ∃ n : ↥N, ν n = z ∧ wcNsrNaDom A j n := by
    intro C Y N _ A f j ν _ hjν z hz
    obtain ⟨hy, h1, h2⟩ := hz
    have hmem : ∀ s, (wcLr1uGerm f z hy).hom s ∈ A := fun s =>
      (ValuationSubring.valuation_le_one_iff A _).mp (h1 s)
    let φ : (Y.presheaf.stalk z) →+* A := (wcLr1uGerm f z hy).hom.codRestrict A hmem
    have hφ : ∀ s, ((φ s : A) : C.functionField) = (wcLr1uGerm f z hy).hom s := fun s => rfl
    have hloc : IsLocalHom φ := by
      refine ⟨fun a ha => ?_⟩
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) :=
        (IsLocalRing.mem_maximalIdeal a).mpr hna
      have h3 : φ a ∈ IsLocalRing.maximalIdeal A :=
        (ValuationSubring.valuation_lt_one_iff A (φ a)).mpr (by rw [hφ]; exact h2 a hm)
      exact ((IsLocalRing.mem_maximalIdeal _).mp h3) ha
    let g : Spec (.of A) ⟶ Y := Spec.map (CommRingCat.ofHom φ) ≫ Y.fromSpecStalk z
    have hgc : g (IsLocalRing.closedPoint A) = z := by
      have : IsLocalHom (CommRingCat.ofHom φ).hom := hloc
      show (Y.fromSpecStalk z) ((Spec.map (CommRingCat.ofHom φ)) (IsLocalRing.closedPoint A)) = z
      rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]
    have hgw : Spec.map (CommRingCat.ofHom (algebraMap A C.functionField)) ≫ g =
        C.fromSpecStalk (genericPoint C) ≫ f := by
      have e : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap A C.functionField) =
          wcLr1uGerm f z hy := by
        ext s; rfl
      calc Spec.map (CommRingCat.ofHom (algebraMap A C.functionField)) ≫ g
          = Spec.map (CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap A C.functionField)) ≫
              Y.fromSpecStalk z := by
            rw [Spec.map_comp, Category.assoc]
        _ = Spec.map (Y.presheaf.stalkSpecializes hy ≫ f.stalkMap (genericPoint C)) ≫
              Y.fromSpecStalk z := by rw [e]; rfl
        _ = C.fromSpecStalk (genericPoint C) ≫ f := by
            rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
              Scheme.SpecMap_stalkMap_fromSpecStalk]
    have hE : ValuativeCriterion.Existence ν := by
      have h : (ValuativeCriterion.Existence ⊓ @QuasiCompact) ν := by
        rw [← UniversallyClosed.eq_valuativeCriterion]; infer_instance
      exact h.1
    let i₁ : Spec (.of C.functionField) ⟶ N := C.fromSpecStalk (genericPoint C) ≫ j
    have hsq : i₁ ≫ ν = Spec.map (CommRingCat.ofHom (algebraMap A C.functionField)) ≫ g := by
      rw [hgw]
      show (C.fromSpecStalk (genericPoint C) ≫ j) ≫ ν = _
      rw [Category.assoc, hjν]
    let S : ValuativeCommSq ν := ⟨A, C.functionField, i₁, g, ⟨hsq⟩⟩
    have := hE S
    let l : Spec (.of A) ⟶ N := S.commSq.lift
    have hl1 : Spec.map (CommRingCat.ofHom (algebraMap A C.functionField)) ≫ l = i₁ :=
      S.commSq.fac_left
    have hl2 : l ≫ ν = g := S.commSq.fac_right
    refine ⟨l (IsLocalRing.closedPoint A), ?_, ?_⟩
    · have key : ∀ x, (l ≫ ν) x = g x := fun x => by rw [hl2]
      exact (Scheme.Hom.comp_apply l ν _).symm.trans ((key _).trans hgc)
    · have hsp : j (genericPoint C) ⤳ l (IsLocalRing.closedPoint A) := by
        let pt : ↥(Spec (.of C.functionField)) := IsLocalRing.closedPoint C.functionField
        have h0 := (IsLocalRing.specializes_closedPoint
          ((Spec.map (CommRingCat.ofHom (algebraMap A C.functionField))) pt)).map l.continuous
        have key1 : ∀ x, (Spec.map (CommRingCat.ofHom (algebraMap A C.functionField)) ≫ l) x =
            i₁ x := fun x => by rw [hl1]
        have e1 : l ((Spec.map (CommRingCat.ofHom (algebraMap A C.functionField))) pt) =
            j (genericPoint C) := by
          calc l ((Spec.map (CommRingCat.ofHom (algebraMap A C.functionField))) pt)
              = (Spec.map (CommRingCat.ofHom (algebraMap A C.functionField)) ≫ l) pt :=
                (Scheme.Hom.comp_apply _ _ _).symm
            _ = (C.fromSpecStalk (genericPoint C) ≫ j) pt := key1 pt
            _ = j (C.fromSpecStalk (genericPoint C) pt) := Scheme.Hom.comp_apply _ _ _
            _ = j (genericPoint C) := congrArg j Scheme.fromSpecStalk_closedPoint
        rw [e1] at h0
        exact h0
      let ψ := Scheme.stalkClosedPointTo l
      have hψloc : IsLocalHom ψ.hom := Scheme.isLocalHom_stalkClosedPointTo l
      have hgerm : wcLr1uGerm j (l (IsLocalRing.closedPoint A)) hsp =
          ψ ≫ CommRingCat.ofHom (algebraMap A C.functionField) := by
        apply Spec.map_inj.mp
        apply (cancel_mono (N.fromSpecStalk (l (IsLocalRing.closedPoint A)))).mp
        rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl1]
        show Spec.map (N.presheaf.stalkSpecializes hsp ≫ j.stalkMap (genericPoint C)) ≫ _ = _
        rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
          Scheme.SpecMap_stalkMap_fromSpecStalk]
      refine ⟨hsp, fun s => ?_, fun s hs => ?_⟩
      · rw [hgerm]
        exact ValuationSubring.valuation_le_one A (ψ.hom s)
      · rw [hgerm]
        have hns : ψ.hom s ∈ IsLocalRing.maximalIdeal A := by
          refine (IsLocalRing.mem_maximalIdeal _).mpr (fun hu => ?_)
          exact ((IsLocalRing.mem_maximalIdeal _).mp hs) (isUnit_of_map_unit ψ.hom s hu)
        exact (ValuationSubring.valuation_lt_one_iff A (ψ.hom s)).mp hns
  obtain ⟨n₁, hn₁x, hDn₁⟩ := centre A₁ (γ ≫ ι) (γ ≫ ι).toNormalization
    (γ ≫ ι).fromNormalization (Scheme.Hom.toNormalization_fromNormalization _) _ hDx

  have himg : wcpaDjLkImg W (γ ≫ ι) uX y₀ =
      (γ ≫ ι).fromNormalization (Limits.pullback.fst ((γ ≫ ι).fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y₀) := by
    unfold wcpaDjLkImg wcpaDjLkPi
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
    simp only [Limits.pullback.map, Limits.pullback.lift_fst]

  obtain ⟨hss, hXp, hpb⟩ := hM
  obtain ⟨hXint, hXnorm⟩ := wcpa_dj_lr1u_model_normal Ω W hW hWt X uX ι hss hXp hpb
  obtain ⟨hGfin, hdesc⟩ :=
    wcpa_dj_lr1k_llfi_galois_descent wcpa_dj_lr1k_llfi_fibre_count Ω C γ hcov hgal
  haveI : IsAffineHom ι :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip inferInstance
  have hinv : ∀ U : X.Opens, IsAffineOpen U → ∀ s : Γ(C, (γ ≫ ι) ⁻¹ᵁ U),
      ((γ ≫ ι).app U).hom.IsIntegralElem s →
      (∀ (a : C ≅ C) (h : a.hom ≫ γ = γ), (a.hom.appLE ((γ ≫ ι) ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U)
        (by rw [← Scheme.Hom.comp_preimage, ← Category.assoc, h])).hom s = s) →
      ∃ r : Γ(X, U), ((γ ≫ ι).app U).hom r = s := by
    intro U hU s hsint hsfix
    have hV : IsAffineOpen (ι ⁻¹ᵁ U) := hU.preimage ι
    obtain ⟨t, ht⟩ := hdesc (ι ⁻¹ᵁ U) hV s (fun a h => hsfix a h)
    have htint : (ι.app U).hom.IsIntegralElem t := by
      obtain ⟨p, hpm, hp⟩ := hsint
      refine ⟨p, hpm, ?_⟩
      apply wcpa_dj_lr1k_llfi_cover_injective Ω C γ hcov (ι ⁻¹ᵁ U)
      rw [map_zero, Polynomial.hom_eval₂, ← CommRingCat.hom_comp, ht]
      rw [Scheme.Hom.comp_app] at hp
