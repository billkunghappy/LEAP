        rw [← Polynomial.eval₂_at_apply, hy, ← Polynomial.eval_map]
        exact hx
      exact (map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective ↥W Ω)).mp h1
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hqy, map_zero]
  have : Infinite (IsLocalRing.ResidueField ↥W) := inferInstance

  have s4 : ∀ E : Polynomial (IsLocalRing.ResidueField ↥W), E ≠ 0 →
      ∃ a, D.eval a ≠ 0 ∧ E.eval a ≠ 0 := by
    intro E hE
    by_contra hcon
    push_neg at hcon
    apply mul_ne_zero hD0 hE
    apply Polynomial.funext
    intro a
    rw [Polynomial.eval_mul, Polynomial.eval_zero]
    by_cases h : D.eval a = 0
    · rw [h, zero_mul]
    · rw [hcon a h, mul_zero]

  have hres : ∀ (P : Polynomial ↥W) (α : ↥W), IsLocalRing.residue ↥W (P.eval α) =
      (P.map (IsLocalRing.residue ↥W)).eval (IsLocalRing.residue ↥W α) := fun P α => by
    rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
  have hmem : ∀ x : ↥W, ¬ IsUnit x → x ∈ IsLocalRing.maximalIdeal ↥W := fun x hx =>
    (IsLocalRing.mem_maximalIdeal x).mpr (mem_nonunits_iff.mpr hx)
  have hunit : ∀ (P : Polynomial ↥W) (α : ↥W),
      (P.map (IsLocalRing.residue ↥W)).eval (IsLocalRing.residue ↥W α) ≠ 0 →
      IsUnit (P.eval α) := by
    intro P α h
    rw [← hres] at h
    by_contra hu
    exact h ((IsLocalRing.residue_eq_zero_iff _).mpr (hmem _ hu))
  have hresne : ∀ x : ↥W, IsUnit x → IsLocalRing.residue ↥W x ≠ 0 := by
    intro x hx h
    have h2 := (IsLocalRing.residue_eq_zero_iff x).mp h
    exact ((IsLocalRing.mem_maximalIdeal x).mp h2) hx
  obtain ⟨n, hεn⟩ := hGε
  have hn : ¬ IsUnit n := fun hu => hεG (by rw [hεn]; exact hu.mul_right_dvd.mpr dvd_rfl)
  have hnm : n ∈ IsLocalRing.maximalIdeal ↥W := hmem n hn

  have s2 : ∀ z y : ↥W, G ∣ z → z ∣ G → ε ∣ z - y → ∃ u : ↥W, IsUnit u ∧ y = G * u := by
    intro z y hz1 hz2 hz3
    obtain ⟨w, hw⟩ := hz1
    obtain ⟨s, hs⟩ := hz2
    obtain ⟨e, he⟩ := hz3
    have hws : w * s = 1 := by
      apply mul_left_cancel₀ hG0
      calc G * (w * s) = (G * w) * s := by ring
