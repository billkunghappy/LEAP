theorem wcpa_dj_llsm_smcd_coord_change_sep : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (M : Type u) [Field M] [Algebra B M] [IsFractionRing B M] (L : Type u) [Field L] [Algebra M L] (𝔮 : Ideal B) (x x' σ ε : B) (c c' b : ↥W), wcLlsPD W B 𝔮 (.disc x) → wcLlsPD W B 𝔮 (.disc x') → c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W → σ ∉ 𝔮 → ε ∉ 𝔮 → x - algebraMap ↥W B c ≠ 0 → x' - algebraMap ↥W B c' ≠ 0 → σ * (x - algebraMap ↥W B c) = ε * (x' - algebraMap ↥W B c') → wcLlsDiscSep W B M L x c b → wcLlsDiscSep W B M L x' c' b :=
by
  intro Ω _ W B _ _ _ M _ _ _ L _ _ 𝔮 x x' σ ε c c' b hPD hPD' hc hc' hσ hε hZne hZ'ne hstar hsep

  have s4 : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
      [Algebra A K] (L : Type u) [Field L] [Algebra K L] (R R' : Subalgebra A K) (υ : K),
      υ ∈ R' → (∀ r ∈ R, ∃ k : ℕ, υ ^ k * r ∈ R') →
      ∀ x : L, IsIntegral ↥R x → ∃ k : ℕ, IsIntegral ↥R' (algebraMap K L (υ ^ k) * x) := by
    intro A _ K _ _ L _ _ R R' υ hυ hmul x hx
    classical
    obtain ⟨p, hpm, hp⟩ := hx
    choose! kf hkf using hmul
    set n := p.natDegree with hn
    set κ := ∑ i ∈ Finset.range (n + 1), kf ((p.coeff i : R) : K) with hκ
    set q : Polynomial K := (p.map R.val.toRingHom).scaleRoots (υ ^ κ) with hq
    have hpm' : (p.map R.val.toRingHom).Monic := hpm.map _
    have hnd : (p.map R.val.toRingHom).natDegree = n := hpm.natDegree_map _
    have hqm : q.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hpm'
    have hcoeff : ∀ i, q.coeff i ∈ R' := by
      intro i
      rw [hq, Polynomial.coeff_scaleRoots, hnd, Polynomial.coeff_map]
      rcases lt_trichotomy i n with hi | hi | hi
      · have h1 : kf ((p.coeff i : R) : K) ≤ κ :=
          Finset.single_le_sum (f := fun j => kf ((p.coeff j : R) : K))
            (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr (by omega))
        have h2 : κ ≤ κ * (n - i) := Nat.le_mul_of_pos_right _ (by omega)
        have e : (υ ^ κ) ^ (n - i) = υ ^ (κ * (n - i) - kf ((p.coeff i : R) : K)) *
            υ ^ kf ((p.coeff i : R) : K) := by
          rw [← pow_mul, ← pow_add, Nat.sub_add_cancel (h1.trans h2)]
        show ((p.coeff i : R) : K) * (υ ^ κ) ^ (n - i) ∈ R'
        rw [e, mul_comm, mul_assoc]
        exact mul_mem (pow_mem hυ _) (hkf _ (p.coeff i).2)
      · subst hi
        show ((p.coeff p.natDegree : R) : K) * (υ ^ κ) ^ (p.natDegree - p.natDegree) ∈ R'
        rw [hpm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
        exact one_mem _
      · show ((p.coeff i : R) : K) * (υ ^ κ) ^ (n - i) ∈ R'
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi]
        simp
    have hqlift : q ∈ Polynomial.lifts R'.val.toRingHom := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨q.coeff i, hcoeff i⟩, rfl⟩
    obtain ⟨q', hq'map, _, hq'm⟩ := Polynomial.lifts_and_degree_eq_and_monic hqlift hqm
    refine ⟨κ, q', hq'm, ?_⟩
    have halg : algebraMap ↥R' L = (algebraMap K L).comp R'.val.toRingHom := rfl
    rw [halg, ← Polynomial.eval₂_map, hq'map, hq]
    apply Polynomial.scaleRoots_eval₂_eq_zero
    rw [Polynomial.eval₂_map]
    exact hp

  have s5 : ∀ (C C' L : Type u) [CommRing C] [CommRing C'] [Field L]
      (i : C →+* L) (i' : C' →+* L), Function.Injective i' → ∀ υ' : C',
      (∀ x : C, ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x) →
      ∀ Q' : Ideal C', Q'.IsPrime → υ' ∉ Q' →
      ∃ Q : Ideal C, Q.IsPrime ∧
        ∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q') := by
    intro C C' L _ _ _ i i' hi' υ' H Q' hQ' hυ'
    have hpow : ∀ k : ℕ, υ' ^ k ∉ Q' := fun k h => hυ' (hQ'.mem_of_pow_mem k h)
    have indep : ∀ (x : C) (k₁ k₂ : ℕ) (y₁ y₂ : C'), i' y₁ = i' υ' ^ k₁ * i x →
        i' y₂ = i' υ' ^ k₂ * i x → y₁ ∈ Q' → y₂ ∈ Q' := by
      intro x k₁ k₂ y₁ y₂ h1 h2 hy1
      have e : υ' ^ k₁ * y₂ = υ' ^ k₂ * y₁ :=
        hi' (by rw [map_mul, map_mul, map_pow, map_pow, h1, h2]; ring)
      have : υ' ^ k₁ * y₂ ∈ Q' := by rw [e]; exact Q'.mul_mem_left _ hy1
      exact (hQ'.mem_or_mem this).resolve_left (hpow k₁)
    let Q : Ideal C :=
      { carrier := {x | ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x ∧ y ∈ Q'}
        add_mem' := by
          rintro a b ⟨k₁, y₁, h1, hy1⟩ ⟨k₂, y₂, h2, hy2⟩
          refine ⟨k₁ + k₂, υ' ^ k₂ * y₁ + υ' ^ k₁ * y₂, ?_,
            add_mem (Q'.mul_mem_left _ hy1) (Q'.mul_mem_left _ hy2)⟩
          rw [map_add, map_mul, map_mul, map_pow, map_pow, h1, h2, map_add]; ring
        zero_mem' := ⟨0, 0, by simp, Q'.zero_mem⟩
        smul_mem' := by
          rintro a b ⟨k₁, y₁, h1, hy1⟩
          obtain ⟨j, ya, ha⟩ := H a
          refine ⟨j + k₁, ya * y₁, ?_, Q'.mul_mem_left _ hy1⟩
          rw [smul_eq_mul, map_mul, map_mul, ha, h1]; ring }
    have memQ : ∀ x, x ∈ Q ↔ ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x ∧ y ∈ Q' :=
      fun x => Iff.rfl
    have HQ : ∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q') := by
      intro x k y hy
      rw [memQ]
      constructor
      · rintro ⟨k₂, y₂, h2, hy2⟩
        exact indep x k₂ k y₂ y h2 hy hy2
      · intro hyQ
        exact ⟨k, y, hy, hyQ⟩
    refine ⟨Q, ⟨?_, ?_⟩, HQ⟩
    · rw [Ne, Ideal.eq_top_iff_one, memQ]
      rintro ⟨k, y, h, hy⟩
      have : y = υ' ^ k := hi' (by rw [h, map_one, mul_one, map_pow])
      exact hpow k (this ▸ hy)
    · intro a b hab
      obtain ⟨k₁, y₁, h1⟩ := H a
      obtain ⟨k₂, y₂, h2⟩ := H b
      have h12 : i' (y₁ * y₂) = i' υ' ^ (k₁ + k₂) * i (a * b) := by
        rw [map_mul, map_mul, h1, h2]; ring
      have := (HQ _ _ _ h12).mp hab
      rcases hQ'.mem_or_mem this with h | h
      · exact Or.inl ((HQ _ _ _ h1).mpr h)
      · exact Or.inr ((HQ _ _ _ h2).mpr h)

  have s6 : ∀ (C C' L : Type u) [CommRing C] [IsDomain C] [CommRing C']
      [IsDomain C'] [Field L] (i : C →+* L) (i' : C' →+* L), Function.Injective i →
      Function.Injective i' → ∀ (υ : C) (υ' : C'), i υ = i' υ' →
      (∀ x : C, ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x) →
      (∀ x' : C', ∃ (k : ℕ) (y : C), i y = i υ ^ k * i' x') →
      ∀ (Q : Ideal C) [Q.IsPrime] (Q' : Ideal C') [Q'.IsPrime], υ' ∉ Q' →
      (∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q')) →
      ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime Q',
