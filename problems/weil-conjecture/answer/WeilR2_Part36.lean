    obtain ⟨u, hu'⟩ := hu
    have h1 : Θ' (↑u⁻¹) * Θ z = 1 := by
      rw [← hΘ', ← hu', ← map_mul, Units.inv_mul, map_one]
    have hle1 : O.valuation (Θ' ↑u⁻¹) ≤ 1 := (O.valuation_le_one_iff _).mpr (hOC _)
    have hle2 : O.valuation (Θ z) ≤ 1 := (O.valuation_le_one_iff _).mpr (hO1 z)
