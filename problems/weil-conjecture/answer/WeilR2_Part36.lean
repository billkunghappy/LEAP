import WeilR2_Part35
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcFrmCp_expansion : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W), wcLlsPD W A 𝔭 (.ann u v g) → ∀ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O → ∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e → ∀ ρ₁ ρ₂ : ↥W, wcFrmInt W g ρ₁ → wcFrmInt W g ρ₂ → ρ₁ ∣ ρ₂ → (∀ z ∈ Z ++ Y, ¬ (ρ₁ ∣ z ∧ z ∣ ρ₂)) → ∃ Λ : List (ℤ × ↥W × ↥W), (∀ t ∈ Λ, t.2.2 ≠ 0) ∧ ∀ σ : ↥W, wcFrmInt W g σ → ρ₁ ∣ σ → σ ∣ ρ₂ → F - (Λ.map (fun t => algebraMap A K (algebraMap ↥W A t.2.1) / algebraMap A K (algebraMap ↥W A t.2.2) * algebraMap A K u ^ t.1)).sum ∈ O σ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g hPD O hO F k1 k2 Z Y d e hR ρ₁ ρ₂ hI₁ hI₂ h12 hno
  classical
  obtain ⟨j, hj⟩ : ∃ j : ↥W →+* K, ∀ w, j w = algebraMap A K (algebraMap ↥W A w) :=
    ⟨(algebraMap A K).comp (algebraMap ↥W A), fun _ => rfl⟩
  have hPD' := hPD
  unfold wcLlsPD at hPD'
  obtain ⟨-, -, -, hmax, hm𝔭, hgm, hg0, huv, h𝔭eq, -⟩ := hPD'
  haveI : 𝔭.IsPrime := hmax.isPrime
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  obtain ⟨hj0', hU, hs0, hσ⟩ := wcFrmCpE_val Ω W A K 𝔭 u v g O hPD hO
  have hj0 : ∀ w : ↥W, w ≠ 0 → j w ≠ 0 := fun w hw => by rw [hj]; exact hj0' w hw
  have harch := wcFrmCp_arch Ω W hW
  obtain ⟨I, hI⟩ : ∃ I : ↥W → Prop, ∀ σ, I σ ↔ (wcFrmInt W g σ ∧ ρ₁ ∣ σ ∧ σ ∣ ρ₂) :=
    ⟨_, fun _ => Iff.rfl⟩
  have hA : ∀ σ, I σ → ∀ a : A, algebraMap A K a ∈ O σ :=
    fun σ h => (hσ σ ((hI σ).mp h).1).1
  have hinv : ∀ σ, I σ → ∀ s : A, s ∉ 𝔭 → (algebraMap A K s)⁻¹ ∈ O σ :=
    fun σ h => (hσ σ ((hI σ).mp h).1).2.1
  have hjO : ∀ σ, I σ → ∀ w : ↥W, j w ∈ O σ := fun σ h w => by rw [hj]; exact hA σ h _
  have hIprop : ∀ σ, I σ → σ ≠ 0 ∧ ρ₁ ∣ σ ∧ σ ∣ ρ₂ := fun σ h =>
    ⟨((hI σ).mp h).1.2.1, ((hI σ).mp h).2.1, ((hI σ).mp h).2.2⟩
  have hUσ : ∀ σ, I σ → algebraMap A K u / j σ ∈ O σ ∧ j σ / algebraMap A K u ∈ O σ :=
    fun σ h => by rw [hj]; exact (hσ σ ((hI σ).mp h).1).2.2.1
  obtain ⟨q₂, hq₂⟩ := hI₂.2.2.1
  have hq₂m : q₂ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra h
    rw [IsLocalRing.notMem_maximalIdeal] at h
    apply hI₂.2.2.2
    rw [hq₂]
    exact (IsUnit.mul_right_dvd h).mpr dvd_rfl
  have hq₂0 : q₂ ≠ 0 := by
    rintro rfl
    exact hg0 (by rw [hq₂, mul_zero])
  obtain ⟨c, hcρ₁, hcq₂, hcm, hc0⟩ : ∃ c : ↥W, c ∣ ρ₁ ∧ c ∣ q₂ ∧
      c ∈ IsLocalRing.maximalIdeal ↥W ∧ c ≠ 0 := by
    rcases ValuationRing.dvd_total ρ₁ q₂ with h | h
    · exact ⟨ρ₁, dvd_rfl, h, hI₁.1, hI₁.2.1⟩
    · exact ⟨q₂, h, dvd_rfl, hq₂m, hq₂0⟩
  have hjc : j c ≠ 0 := hj0 c hc0
  have hV : algebraMap A K v = j g / algebraMap A K u :=
    (eq_div_iff hU).mpr (by rw [mul_comm, hj, ← map_mul, huv])
  have hUc : ∀ σ, I σ → algebraMap A K u / j c ∈ O σ ∧ algebraMap A K v / j c ∈ O σ := by
    intro σ hIσ
    obtain ⟨hσi, ⟨t, ht⟩, ⟨t', ht'⟩⟩ := (hI σ).mp hIσ
    obtain ⟨r₁, hr₁⟩ := hcρ₁
    obtain ⟨r₂, hr₂⟩ := hcq₂
    have hσ0 : σ ≠ 0 := hσi.2.1
    have ht0 : t ≠ 0 := by rintro rfl; exact hσ0 (by rw [ht, mul_zero])
    have hr₁0 : r₁ ≠ 0 := by rintro rfl; exact hI₁.2.1 (by rw [hr₁, mul_zero])
    have hjt : j t ≠ 0 := hj0 t ht0
    have hjr₁ : j r₁ ≠ 0 := hj0 r₁ hr₁0
    constructor
    · have e1 : algebraMap A K u / j c = algebraMap A K u / j σ * j (r₁ * t) := by
        rw [ht, hr₁]; simp only [map_mul]; field_simp
      rw [e1]; exact mul_mem (hUσ σ hIσ).1 (hjO σ hIσ _)
    · have e2 : algebraMap A K v / j c = j σ / algebraMap A K u * j (t' * r₂) := by
        rw [hV, hq₂, ht', hr₂]; simp only [map_mul]; field_simp
      rw [e2]; exact mul_mem (hUσ σ hIσ).2 (hjO σ hIσ _)
  have hsec := wcFrmCp_ann_section Ω W A 𝔭 u v g hPD
  have hUC := wcFrmCpE_unit Ω W A K j 𝔭 u v g c O I hj huv hm𝔭 hu𝔭 hv𝔭 hsec hU hs0 hj0 hc0
    hA hinv hUc
  obtain ⟨T, hT⟩ : ∃ T : Subring K, T = Subring.closure ({z : K | ∃ p q : ↥W, q ≠ 0 ∧
      z = j p / j q} ∪ {algebraMap A K u, (algebraMap A K u)⁻¹}) := ⟨_, rfl⟩
  have hgen : ∀ p q : ↥W, q ≠ 0 → j p / j q ∈ T := fun p q hq => by
    rw [hT]; exact Subring.subset_closure (Set.mem_union_left _ ⟨p, q, hq, rfl⟩)
  have hUT : algebraMap A K u ∈ T := by
    rw [hT]; exact Subring.subset_closure (Set.mem_union_right _ (Set.mem_insert _ _))
  obtain ⟨hk1, hk2, hd, he, hrep⟩ := hR
  have hYne : ∀ y ∈ Y, algebraMap A K (u - algebraMap ↥W A y) ≠ 0 := by
    intro y hy h0
    rw [map_sub, sub_eq_zero] at h0
    have h1 := ((hσ ρ₁ hI₁).2.2.2.1 y h0).1
    have h2 := ((hσ ρ₂ hI₂).2.2.2.1 y h0).2
    exact hno y (List.mem_append_right _ hy) ⟨h1, h2⟩
  have hPY : (Y.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod ≠ 0 := by
    apply List.prod_ne_zero
    intro h
    obtain ⟨y, hy, hy0⟩ := List.mem_map.mp h
    exact hYne y hy hy0
  have hYinv : (Y.map (fun y => (algebraMap A K (u - algebraMap ↥W A y))⁻¹)).prod =
      (Y.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod⁻¹ := by
    rw [List.prod_inv, List.map_map]; rfl
  have hφd : algebraMap A K d ≠ 0 := hs0 d hd
  have hφk2 : algebraMap A K (algebraMap ↥W A k2) ≠ 0 := hj0' k2 hk2
  have hF0 : F = (algebraMap A K (algebraMap ↥W A k1) *
      (Z.map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod * algebraMap A K e) /
      (algebraMap A K d * algebraMap A K (algebraMap ↥W A k2) *
        (Y.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod) :=
    eq_div_of_mul_eq (mul_ne_zero (mul_ne_zero hφd hφk2) hPY) (by rw [mul_comm]; exact hrep)
  obtain ⟨Xs, hXs⟩ : ∃ Xs : List K, Xs = [algebraMap A K (algebraMap ↥W A k1) /
      algebraMap A K (algebraMap ↥W A k2), algebraMap A K e / algebraMap A K d] ++
      Z.map (fun z => algebraMap A K (u - algebraMap ↥W A z)) ++
      Y.map (fun y => (algebraMap A K (u - algebraMap ↥W A y))⁻¹) := ⟨_, rfl⟩
  have hF : F = Xs.prod := by
    rw [hXs, List.prod_append, List.prod_append, hYinv, hF0]
    simp only [List.prod_cons, List.prod_nil]
    field_simp
  have hXsA : ∀ X ∈ Xs, ∃ b : ↥W, b ≠ 0 ∧ ∀ δ : ↥W, δ ≠ 0 → ∃ P ∈ T, ∀ σ, I σ →
      j b * X ∈ O σ ∧ j b * (X - P) / j δ ∈ O σ := by
    intro X hX
    rw [hXs] at hX
    simp only [List.mem_append, List.mem_cons, List.mem_map, List.not_mem_nil, or_false] at hX
    rcases hX with ((rfl | rfl) | ⟨z, hz, rfl⟩) | ⟨y, hy, rfl⟩
    · refine ⟨k2, hk2, fun δ hδ => ⟨algebraMap A K (algebraMap ↥W A k1) /
        algebraMap A K (algebraMap ↥W A k2), ?_, fun σ hIσ => ⟨?_, ?_⟩⟩⟩
      · have := hgen k1 k2 hk2
        rwa [hj, hj] at this
      · rw [hj, mul_div_cancel₀ _ hφk2]; exact hA σ hIσ _
      · rw [sub_self, mul_zero, zero_div]; exact zero_mem _
    · refine ⟨1, one_ne_zero, fun δ hδ => ?_⟩
      obtain ⟨N, s', hs'⟩ := harch c δ hcm hδ
      obtain ⟨P, hP, hPσ⟩ := hUC N e d hd
      have hjδ : j δ ≠ 0 := hj0 δ hδ
      have hs'0 : s' ≠ 0 := by
        rintro rfl
        exact pow_ne_zero N hc0 (by rw [hs', mul_zero])
      have hjs' : j s' ≠ 0 := hj0 s' hs'0
      refine ⟨P, by rw [hT]; exact hP, fun σ hIσ => ⟨?_, ?_⟩⟩
      · rw [map_one, one_mul, div_eq_mul_inv]; exact mul_mem (hA σ hIσ e) (hinv σ hIσ d hd)
      · have e3 : j 1 * (algebraMap A K e / algebraMap A K d - P) / j δ =
            (algebraMap A K e / algebraMap A K d - P) / j c ^ N * j s' := by
          have hcN : j c ^ N = j δ * j s' := by rw [← map_pow, hs', map_mul]
          rw [hcN, map_one, one_mul]; field_simp
        rw [e3]; exact mul_mem (hPσ σ hIσ) (hjO σ hIσ s')
    · refine ⟨1, one_ne_zero, fun δ hδ => ⟨algebraMap A K (u - algebraMap ↥W A z), ?_,
        fun σ hIσ => ⟨?_, ?_⟩⟩⟩
      · have e4 : algebraMap A K (u - algebraMap ↥W A z) = algebraMap A K u - j z / j 1 := by
          rw [map_sub, map_one, div_one, hj]
        rw [e4]; exact sub_mem hUT (hgen z 1 one_ne_zero)
      · rw [map_one, one_mul]; exact hA σ hIσ _
      · rw [sub_self, mul_zero, zero_div]; exact zero_mem _
    · have hDy : algebraMap A K (u - algebraMap ↥W A y) = algebraMap A K u - j y := by
        rw [map_sub, hj]
      have hD : algebraMap A K u - j y ≠ 0 := by rw [← hDy]; exact hYne y hy
      have hpole : ∀ σ, I σ → (¬ σ ∣ y → j y / (algebraMap A K u - j y) ∈ O σ) ∧
          (σ ∣ y → j σ / (algebraMap A K u - j y) ∈ O σ) := fun σ h => by
        rw [← hDy, hj, hj]; exact (hσ σ ((hI σ).mp h).1).2.2.2.2 y (hYne y hy)
      obtain ⟨b, hb0, hb⟩ := wcFrmCpE_pole Ω W K j (algebraMap A K u) O I ρ₁ ρ₂ y harch hj0 hU
        hIprop hjO hUσ hD hpole (hno y (List.mem_append_right _ hy))
      refine ⟨b, hb0, fun δ hδ => ?_⟩
      obtain ⟨P, hP, hPσ⟩ := hb δ hδ
      refine ⟨P, by rw [hT]; exact hP, fun σ hIσ => ?_⟩
      rw [hDy]; exact hPσ σ hIσ
  obtain ⟨b, hb0, hb⟩ := wcFrmCpE_prod Ω W K j T O I hjO hj0 Xs hXsA
  obtain ⟨P, hPT, hPσ⟩ := hb b hb0
  obtain ⟨Λ, hΛ0, hΛ⟩ := wcFrmCpE_closure_list Ω W K j (algebraMap A K u) hU P (by
    rw [← hT]; exact hPT)
  refine ⟨Λ, hΛ0, fun σ h1 h2 h3 => ?_⟩
  have hIσ : I σ := (hI σ).mpr ⟨h1, h2, h3⟩
  have hm := (hPσ σ hIσ).2
  rw [mul_div_cancel_left₀ _ (hj0 b hb0), ← hF, hΛ] at hm
  simp only [hj] at hm
  exact hm

theorem wcFrmCp_laurent_reduce : ∀ (E : Type u) [Field E] (ℓ : ℕ) [Fact ℓ.Prime] [CharP E ℓ] (S : Subfield E), (∀ a ∈ S, ∃ b ∈ S, b ^ ℓ = a) → (∀ a ∈ S, ∃ b ∈ S, b ^ ℓ - b = a) → ∀ (x : E) (Λ : List (ℤ × E)), (∀ t ∈ Λ, t.2 ∈ S) → ∃ (H : E) (D : List (ℤ × E)), (D.map Prod.fst).Nodup ∧ (∀ t ∈ D, t.2 ∈ S ∧ t.2 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ t.1) ∧ (Λ.map (fun t => t.2 * x ^ t.1)).sum - (H ^ ℓ - H) = (D.map (fun t => t.2 * x ^ t.1)).sum :=
by
  intro E _ ℓ _ _ S hroot has x
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have single : ∀ (n : ℕ) (k : ℤ) (c : E), k.natAbs = n → c ∈ S →
      ∃ (H : E) (k' : ℤ) (c' : E), c' ∈ S ∧ (c' ≠ 0 → ¬ (ℓ : ℤ) ∣ k') ∧
        c * x ^ k - (H ^ ℓ - H) = c' * x ^ k' := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro k c hk hc
      by_cases hdiv : (ℓ : ℤ) ∣ k
      · by_cases hk0 : k = 0
        · obtain ⟨b, hbS, hb⟩ := has c hc
          refine ⟨b, 0, 0, S.zero_mem, fun h => absurd rfl h, ?_⟩
          rw [hk0, zpow_zero]
          linear_combination -hb
        · obtain ⟨m, rfl⟩ := hdiv
          have hm0 : m ≠ 0 := by
            rintro rfl
            simp at hk0
          have hlt : m.natAbs < n := by
            rw [← hk, Int.natAbs_mul, Int.natAbs_natCast]
            have h2 := (Fact.out : ℓ.Prime).two_le
            have : 0 < m.natAbs := Int.natAbs_pos.mpr hm0
            nlinarith
          obtain ⟨b, hbS, hb⟩ := hroot c hc
          obtain ⟨H₁, k', c', hc'S, hc'k, heq⟩ := ih _ hlt m b rfl hbS
          refine ⟨b * x ^ m + H₁, k', c', hc'S, hc'k, ?_⟩
          have hx : x ^ ((ℓ : ℤ) * m) = (x ^ m) ^ ℓ := by
            rw [mul_comm, zpow_mul, zpow_natCast]
          rw [hx, add_pow_char, mul_pow]
          linear_combination heq - (x ^ m) ^ ℓ * hb
      · exact ⟨0, k, c, hc, fun _ => hdiv, by rw [zero_pow hℓ0]; ring⟩
  have hins : ∀ (D' : List (ℤ × E)), (D'.map Prod.fst).Nodup →
      (∀ t ∈ D', t.2 ∈ S ∧ t.2 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ t.1) →
      ∀ (k : ℤ) (c : E), c ∈ S → (c ≠ 0 → ¬ (ℓ : ℤ) ∣ k) →
      ∃ D : List (ℤ × E), (D.map Prod.fst).Nodup ∧
        (∀ t ∈ D, t.2 ∈ S ∧ t.2 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ t.1) ∧
        (∀ j ∈ D.map Prod.fst, j = k ∨ j ∈ D'.map Prod.fst) ∧
        (D.map (fun t => t.2 * x ^ t.1)).sum = c * x ^ k + (D'.map (fun t => t.2 * x ^ t.1)).sum := by
    intro D'
    induction D' with
    | nil =>
      intro _ _ k c hc hck
      by_cases hc0 : c = 0
      · exact ⟨[], by simp, by simp, by simp, by simp [hc0]⟩
      · refine ⟨[(k, c)], by simp, ?_, ?_, by simp⟩
        · intro t ht
          simp only [List.mem_singleton] at ht
          subst ht
          exact ⟨hc, hc0, hck hc0⟩
        · intro j hj
          left
          simpa using hj
    | cons p D'' ih =>
      obtain ⟨j, e⟩ := p
      intro hnd hgood k c hc hck
      simp only [List.map_cons, List.nodup_cons] at hnd
      obtain ⟨hjnot, hnd''⟩ := hnd
      have hge : e ∈ S ∧ e ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ j := hgood (j, e) (by simp)
      have hgood'' : ∀ t ∈ D'', t.2 ∈ S ∧ t.2 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ t.1 :=
        fun t ht => hgood t (List.mem_cons_of_mem _ ht)
      by_cases hjk : j = k
      · by_cases hs : c + e = 0
        · refine ⟨D'', hnd'', hgood'', ?_, ?_⟩
          · intro j' hj'
            right
            simp only [List.map_cons, List.mem_cons]
            right
            exact hj'
          · simp only [List.map_cons, List.sum_cons]
            rw [hjk]
            linear_combination (-(x ^ k)) * hs
        · refine ⟨(k, c + e) :: D'', ?_, ?_, ?_, ?_⟩
          · simp only [List.map_cons, List.nodup_cons]
            exact ⟨hjk ▸ hjnot, hnd''⟩
          · intro t ht
            rcases List.mem_cons.mp ht with rfl | ht
            · exact ⟨S.add_mem hc hge.1, hs, hjk ▸ hge.2.2⟩
            · exact hgood'' t ht
          · intro j' hj'
            simp only [List.map_cons, List.mem_cons] at hj' ⊢
            rcases hj' with h | h
            · left; exact h
            · right; right; exact h
          · simp only [List.map_cons, List.sum_cons]
            rw [hjk]
            ring
      · obtain ⟨D₂, hnd₂, hgood₂, hexp₂, hsum₂⟩ := ih hnd'' hgood'' k c hc hck
        refine ⟨(j, e) :: D₂, ?_, ?_, ?_, ?_⟩
        · simp only [List.map_cons, List.nodup_cons]
          refine ⟨fun hj => ?_, hnd₂⟩
          rcases hexp₂ j hj with h | h
          · exact hjk h
          · exact hjnot h
        · intro t ht
          rcases List.mem_cons.mp ht with rfl | ht
          · exact hge
          · exact hgood₂ t ht
        · intro j' hj'
          simp only [List.map_cons, List.mem_cons] at hj' ⊢
          rcases hj' with h | h
          · right; left; exact h
          · rcases hexp₂ j' h with h' | h'
            · left; exact h'
            · right; right; exact h'
        · simp only [List.map_cons, List.sum_cons]
          rw [hsum₂]
          ring
  intro Λ
  induction Λ with
  | nil =>
    intro _
    exact ⟨0, [], by simp, by simp, by simp [zero_pow hℓ0]⟩
  | cons t Λ' ih =>
    intro hΛ
    obtain ⟨H', D', hnd', hgood', hE1⟩ := ih (fun s hs => hΛ s (List.mem_cons_of_mem _ hs))
    obtain ⟨H₁, k', c', hc'S, hc'k, hE2⟩ := single _ t.1 t.2 rfl (hΛ t (by simp))
    obtain ⟨D, hnd, hgood, _, hE3⟩ := hins D' hnd' hgood' k' c' hc'S hc'k
    refine ⟨H₁ + H', D, hnd, hgood, ?_⟩
    rw [hE3, List.map_cons, List.sum_cons, add_pow_char]
    linear_combination hE1 + hE2

theorem wcFrmDm_threshold : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (a b : ↥W) (n : ℕ), a ≠ 0 → b ≠ 0 → 0 < n → ∃ τ : ↥W, τ ≠ 0 ∧ ∀ x : ↥W,
      x ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 →
      ((a ∣ b * x ^ n ↔ τ ∣ x) ∧ (b * x ^ n ∣ a ↔ x ∣ τ)) :=
by
  intro Ω _ _ W a b n ha hb hn
  have hn0 : n ≠ 0 := Nat.pos_iff_ne_zero.mp hn
  have powdvd : ∀ y w : ↥W, y ^ n ∣ w ^ n → y ∣ w := by
    intro y w h
    rcases ValuationRing.dvd_total y w with h1 | ⟨r, hr⟩
    · exact h1
    · by_cases hw : w = 0
      · rw [hw]; exact dvd_zero _
      · obtain ⟨s, hs⟩ := h
        have hwn : w ^ n ≠ 0 := pow_ne_zero _ hw
        have h1 : w ^ n * 1 = w ^ n * (r ^ n * s) := by
          rw [mul_one]
          conv_lhs => rw [hs]
          rw [hr, mul_pow]
          ring
        have h2 := mul_left_cancel₀ hwn h1
        have hu : IsUnit (r ^ n) := isUnit_of_dvd_one ⟨s, h2⟩
        have hr' : IsUnit r := (isUnit_pow_iff hn0).mp hu
        rw [hr]
        exact (hr'.mul_right_dvd).mpr (dvd_refl w)
  by_cases hba : b ∣ a
  · obtain ⟨c, hc⟩ := hba
    have hc0 : c ≠ 0 := by
      rintro rfl
      exact ha (by rw [hc, mul_zero])
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((c : Ω)) hn
    have hcΩ : (c : Ω) ≠ 0 := by
      intro h
      exact hc0 (Subtype.ext h)
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hn0] at hz
      exact hcΩ hz.symm
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · obtain ⟨m, hm⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        have key : z = (c : Ω) * (z⁻¹) ^ m := by
          rw [← hz, hm, pow_succ, inv_pow, mul_comm (z ^ m) z, mul_assoc,
            mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
        rw [key]
        exact mul_mem c.2 (pow_mem h m)
    let τ : ↥W := ⟨z, hzW⟩
    have hτn : τ ^ n = c := Subtype.ext (by simp [τ, hz])
    have hτ0 : τ ≠ 0 := by
      intro h
      apply hz0
      have := congrArg Subtype.val h
      simpa [τ] using this
    refine ⟨τ, hτ0, fun x _ _ => ⟨?_, ?_⟩⟩
    · rw [hc, mul_dvd_mul_iff_left hb, ← hτn]
      exact ⟨powdvd τ x, fun h => pow_dvd_pow_of_dvd h n⟩
    · rw [hc, mul_dvd_mul_iff_left hb, ← hτn]
      exact ⟨powdvd x τ, fun h => pow_dvd_pow_of_dvd h n⟩
  · have hab : a ∣ b := (ValuationRing.dvd_total a b).resolve_right hba
    refine ⟨1, one_ne_zero, fun x hx _ => ⟨?_, ?_⟩⟩
    · exact ⟨fun _ => one_dvd x, fun _ => hab.mul_right _⟩
    · constructor
      · intro h
        exact absurd ((dvd_mul_right b _).trans h) hba
      · intro h
        exact absurd (isUnit_of_dvd_one h) ((IsLocalRing.mem_maximalIdeal x).mp hx)

theorem wcFrmDm_cell_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (C : List ↥W) (ρ ρ₂ : ↥W), ρ ≠ 0 → ρ₂ ≠ 0 → ρ ∣ ρ₂ → ¬ ρ₂ ∣ ρ → ρ₂ ∈ C →
    (∀ c ∈ C, ¬ (ρ ∣ c ∧ c ∣ ρ)) →
    ∃ ρ' : ↥W, ρ' ≠ 0 ∧ ρ ∣ ρ' ∧ ¬ ρ' ∣ ρ ∧ ρ' ∣ ρ₂ ∧
      ∀ c ∈ C, ((ρ ∣ c ↔ ρ' ∣ c) ∧ (c ∣ ρ ↔ c ∣ ρ')) :=
by
  intro Ω _ _ W C ρ ρ₂ hρ hρ₂ h12 hn21 hmem hgen
  classical
  have hmin : ∀ (L : List ↥W) (P : ↥W → Prop), (∃ x ∈ L, P x) →
      ∃ ζ ∈ L, P ζ ∧ ∀ c ∈ L, P c → ζ ∣ c := by
    intro L P
    induction L with
    | nil => rintro ⟨x, hx, _⟩; simp at hx
    | cons a t ih =>
      rintro ⟨x, hx, hPx⟩
      by_cases ht : ∃ x ∈ t, P x
      · obtain ⟨ζ, hζ, hPζ, hall⟩ := ih ht
        by_cases hPa : P a
        · rcases ValuationRing.dvd_total a ζ with h | h
          · refine ⟨a, by simp, hPa, ?_⟩
            intro c hc hPc
            rcases List.mem_cons.mp hc with hca | hc
            · rw [hca]
            · exact h.trans (hall c hc hPc)
          · refine ⟨ζ, List.mem_cons_of_mem _ hζ, hPζ, ?_⟩
            intro c hc hPc
            rcases List.mem_cons.mp hc with hca | hc
            · rw [hca]; exact h
            · exact hall c hc hPc
        · refine ⟨ζ, List.mem_cons_of_mem _ hζ, hPζ, ?_⟩
          intro c hc hPc
          rcases List.mem_cons.mp hc with hca | hc
          · rw [hca] at hPc; exact absurd hPc hPa
          · exact hall c hc hPc
      · have hPa : P a := by
          rcases List.mem_cons.mp hx with hxa | hx
          · rw [hxa] at hPx; exact hPx
          · exact absurd ⟨x, hx, hPx⟩ ht
        refine ⟨a, by simp, hPa, ?_⟩
        intro c hc hPc
        rcases List.mem_cons.mp hc with hca | hc
        · rw [hca]
        · exact absurd ⟨c, hc, hPc⟩ ht
  have hsqrt : ∀ q : ↥W, ∃ y : ↥W, y * y = q := by
    intro q
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (q : Ω) (by norm_num : 0 < 2)
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · by_cases hz0 : z = 0
        · rw [hz0]; exact W.zero_mem
        · have hze : z = (q : Ω) * z⁻¹ := by
            rw [← hz, pow_two, mul_assoc, mul_inv_cancel₀ hz0, mul_one]
          rw [hze]; exact W.mul_mem _ _ q.2 h
    refine ⟨⟨z, hzW⟩, ?_⟩
    apply Subtype.ext
    show z * z = (q : Ω)
    rw [← hz, pow_two]
  obtain ⟨ζ, hζC, ⟨hZ1, hZ2⟩, hZ4⟩ :=
    hmin C (fun c => ρ ∣ c ∧ ¬ c ∣ ρ) ⟨ρ₂, hmem, h12, hn21⟩
  have hZ3 : ζ ∣ ρ₂ := hZ4 ρ₂ hmem ⟨h12, hn21⟩
  have hZ5 : ζ ≠ 0 := by
    intro h0
    rw [h0] at hZ3
    exact hρ₂ (zero_dvd_iff.mp hZ3)
  obtain ⟨q, hq⟩ := hZ1
  obtain ⟨y, hy⟩ := hsqrt q
  have hy0 : y ≠ 0 := by
    intro h0
    apply hZ5
    rw [hq, ← hy, h0]
    simp
  have hyu : ¬ IsUnit y := by
    intro hu
    apply hZ2
    rw [hq, ← hy]
    exact (hu.mul hu).mul_right_dvd.mpr (dvd_refl ρ)
  have hy1 : ¬ y ∣ 1 := fun h => hyu (isUnit_of_dvd_one h)
  have hP3 : ¬ ρ * y ∣ ρ := by
    intro h
    apply hy1
    have h' : ρ * y ∣ ρ * 1 := by rwa [mul_one]
    exact (mul_dvd_mul_iff_left hρ).mp h'
  have hP4 : ρ * y ∣ ζ := by
    rw [hq, ← hy, ← mul_assoc]
    exact dvd_mul_right _ _
  have hP6 : ¬ ζ ∣ ρ * y := by
    intro h
    rw [hq, ← hy] at h
    have h1 : y * y ∣ y * 1 := by
      rw [mul_one]
      exact (mul_dvd_mul_iff_left hρ).mp h
    exact hy1 ((mul_dvd_mul_iff_left hy0).mp h1)
  refine ⟨ρ * y, mul_ne_zero hρ hy0, dvd_mul_right ρ y, hP3, hP4.trans hZ3, ?_⟩
  intro c hc
  by_cases hρc : ρ ∣ c
  · have hcρ : ¬ c ∣ ρ := fun h => hgen c hc ⟨hρc, h⟩
    have hζc := hZ4 c hc ⟨hρc, hcρ⟩
    refine ⟨iff_of_true hρc (hP4.trans hζc), iff_of_false hcρ ?_⟩
    intro h
    exact hP6 (hζc.trans h)
  · have hcρ : c ∣ ρ := (ValuationRing.dvd_total ρ c).resolve_left hρc
    refine ⟨iff_of_false hρc ?_, iff_of_true hcρ (hcρ.trans (dvd_mul_right ρ y))⟩
    intro h
    exact hρc ((dvd_mul_right ρ y).trans h)

theorem wcFrmDm_slope : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ρ ρ' a b : ↥W)
    (Z Y : List ↥W) (k : ℤ), ρ ≠ 0 → ρ' ≠ 0 → ρ ∣ ρ' → ¬ ρ' ∣ ρ → a ≠ 0 → b ≠ 0 →
    (∀ c ∈ Z ++ Y, (ρ ∣ c ↔ ρ' ∣ c)) →
    a * wcFrmP W ρ Z * ρ ^ (-k).toNat ∣ b * wcFrmP W ρ Y * ρ ^ k.toNat →
    b * wcFrmP W ρ Y * ρ ^ k.toNat ∣ a * wcFrmP W ρ Z * ρ ^ (-k).toNat →
    a * wcFrmP W ρ' Z * ρ' ^ (-k).toNat ∣ b * wcFrmP W ρ' Y * ρ' ^ k.toNat →
    b * wcFrmP W ρ' Y * ρ' ^ k.toNat ∣ a * wcFrmP W ρ' Z * ρ' ^ (-k).toNat →
    wcFrmM W ρ Z Y = k :=
by
  intro Ω _ W ρ ρ' a b Z Y k hρ hρ' hdiv hndiv ha hb hpat H1 H2 H3 H4

  have hdag : ∀ n : ℕ, n ≠ 0 → ¬ ρ' ^ n ∣ ρ ^ n := by
    intro n hn h
    obtain ⟨w, hw⟩ := hdiv
    rw [hw, mul_pow] at h
    have h' : ρ ^ n * w ^ n ∣ ρ ^ n * 1 := by rw [mul_one]; exact h
    have h1 : w ^ n ∣ 1 := (mul_dvd_mul_iff_left (pow_ne_zero n hρ)).mp h'
    have hu : IsUnit w := isUnit_of_dvd_one ((dvd_pow_self w hn).trans h1)
    apply hndiv
    rw [hw]
    exact (IsUnit.mul_right_dvd hu).mpr dvd_rfl

  have hexp : ∀ (A B : ↥W) (P Q : ℕ), A ≠ 0 → B ≠ 0 →
      A * ρ ^ P ∣ B * ρ ^ Q → B * ρ ^ Q ∣ A * ρ ^ P →
      A * ρ' ^ P ∣ B * ρ' ^ Q → B * ρ' ^ Q ∣ A * ρ' ^ P → P = Q := by
    intro A B P Q hA hB h1 h2 h3 h4
    rcases lt_trichotomy P Q with hlt | heq | hgt
    · exfalso
      obtain ⟨n, hn⟩ := Nat.exists_eq_add_of_lt hlt
      subst hn
      have e1 : B * ρ' ^ (P + n + 1) = (B * ρ' ^ (n + 1)) * ρ' ^ P := by ring
      have e2 : B * ρ ^ (P + n + 1) = (B * ρ ^ (n + 1)) * ρ ^ P := by ring
      rw [e1] at h4
      have h4' : B * ρ' ^ (n + 1) ∣ A := (mul_dvd_mul_iff_right (pow_ne_zero P hρ')).mp h4
      rw [e2] at h1
      have h1' : A ∣ B * ρ ^ (n + 1) := (mul_dvd_mul_iff_right (pow_ne_zero P hρ)).mp h1
      exact hdag (n + 1) (Nat.succ_ne_zero n)
        ((mul_dvd_mul_iff_left hB).mp (h4'.trans h1'))
    · exact heq
    · exfalso
      obtain ⟨n, hn⟩ := Nat.exists_eq_add_of_lt hgt
      subst hn
      have e1 : A * ρ' ^ (Q + n + 1) = (A * ρ' ^ (n + 1)) * ρ' ^ Q := by ring
      have e2 : A * ρ ^ (Q + n + 1) = (A * ρ ^ (n + 1)) * ρ ^ Q := by ring
      rw [e1] at h3
      have h3' : A * ρ' ^ (n + 1) ∣ B := (mul_dvd_mul_iff_right (pow_ne_zero Q hρ')).mp h3
      rw [e2] at h2
      have h2' : B ∣ A * ρ ^ (n + 1) := (mul_dvd_mul_iff_right (pow_ne_zero Q hρ)).mp h2
      exact hdag (n + 1) (Nat.succ_ne_zero n)
        ((mul_dvd_mul_iff_left hA).mp (h3'.trans h2'))

  have hZ : ∀ c ∈ Z, (ρ ∣ c ↔ ρ' ∣ c) := fun c hc => hpat c (List.mem_append_left Y hc)
  have hY : ∀ c ∈ Y, (ρ ∣ c ↔ ρ' ∣ c) := fun c hc => hpat c (List.mem_append_right Z hc)
  have hfilt : ∀ X : List ↥W, (∀ c ∈ X, (ρ ∣ c ↔ ρ' ∣ c)) →
      wcFrmP W ρ' X = (X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod *
        ρ' ^ (X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length := by
    intro X hX
    have f1 : X.filter (fun x => @decide (¬ ρ' ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _)) := by
      apply List.filter_congr
      intro x hx
      exact decide_eq_decide.mpr (not_congr (hX x hx)).symm
    have f2 : X.filter (fun x => @decide (ρ' ∣ x) (Classical.propDecidable _)) =
        X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _)) := by
      apply List.filter_congr
      intro x hx
      exact decide_eq_decide.mpr (hX x hx).symm
    unfold wcFrmP
    rw [f1, f2]
  have hPρ : ∀ X : List ↥W, wcFrmP W ρ X =
      (X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod *
        ρ ^ (X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length :=
    fun X => rfl
  have hQ : ∀ X : List ↥W,
      (X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod ≠ 0 := by
    intro X h
    rw [List.prod_eq_zero_iff, List.mem_filter] at h
    exact (@of_decide_eq_true (¬ ρ ∣ 0) (Classical.propDecidable _) h.2) (dvd_zero ρ)
  rw [hPρ Z, hPρ Y] at H1 H2
  rw [hfilt Z hZ, hfilt Y hY] at H3 H4
  have hQZ := hQ Z
  have hQY := hQ Y
  unfold wcFrmM
  generalize (Z.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod = QZ
    at H1 H2 H3 H4 hQZ
  generalize (Y.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod = QY
    at H1 H2 H3 H4 hQY
  generalize (Z.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length = cZ
    at H1 H2 H3 H4 ⊢
  generalize (Y.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length = cY
    at H1 H2 H3 H4 ⊢
  have key := hexp (a * QZ) (b * QY) (cZ + (-k).toNat) (cY + k.toNat)
    (mul_ne_zero ha hQZ) (mul_ne_zero hb hQY)
    (by convert H1 using 1 <;> ring) (by convert H2 using 1 <;> ring)
    (by convert H3 using 1 <;> ring) (by convert H4 using 1 <;> ring)
  omega

theorem wcFrmDm_val_facts : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W) (O : ↥W → ValuationSubring K),
    wcLlsPD W A 𝔭 (.ann u v g) → wcFrmVAL W A K 𝔭 u g O → ∀ σ : ↥W, wcFrmInt W g σ →
    (∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0) ∧
    (∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
      ((O σ).valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          (O σ).valuation (algebraMap A K (algebraMap ↥W A w₂)) ↔ w₂ ∣ w₁)) ∧
    (O σ).valuation (algebraMap A K u) = (O σ).valuation (algebraMap A K (algebraMap ↥W A σ)) ∧
    (∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
      wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e →
      ((O σ).valuation F ≤ 1 → k2 * wcFrmP W σ Y ∣ k1 * wcFrmP W σ Z) ∧
      ∀ (p q : ↥W) (k : ℤ), p ≠ 0 → q ≠ 0 →
        (O σ).valuation F = (O σ).valuation (algebraMap A K (algebraMap ↥W A p) /
          algebraMap A K (algebraMap ↥W A q) * algebraMap A K u ^ k) →
        (k1 * q) * wcFrmP W σ Z * σ ^ (-k).toNat ∣ (k2 * p) * wcFrmP W σ Y * σ ^ k.toNat ∧
        (k2 * p) * wcFrmP W σ Y * σ ^ k.toNat ∣ (k1 * q) * wcFrmP W σ Z * σ ^ (-k).toNat) :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 u v g O hPD hO σ hσ
  classical
  obtain ⟨V1, V2, V3⟩ := hO σ hσ
  have hσ0 : σ ≠ 0 := hσ.2.1

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have h1 : w • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact hw
    haveI := hPD.2.1
    rcases smul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hb : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    apply hw
    apply hWA
    apply IsFractionRing.injective A K
    rw [h, map_zero, map_zero]
  have hνne : ∀ w : ↥W, w ≠ 0 → (O σ).valuation (algebraMap A K (algebraMap ↥W A w)) ≠ 0 := by
    intro w hw h
    exact hb w hw ((Valuation.zero_iff _).mp h)
  have key : ∀ a b : (O σ).ValueGroup, b ≠ 0 → (a / b ≤ 1 ↔ a ≤ b) := by
    intro a b hb0
    constructor
    · intro h
      have : a / b * b ≤ 1 * b := by gcongr
      rwa [div_mul_cancel₀ a hb0, one_mul] at this
    · intro h
      have : a * b⁻¹ ≤ b * b⁻¹ := by gcongr
      rwa [mul_inv_cancel₀ hb0, ← div_eq_mul_inv] at this

  have hc : ∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 →
      ((O σ).valuation (algebraMap A K (algebraMap ↥W A w₁)) ≤
          (O σ).valuation (algebraMap A K (algebraMap ↥W A w₂)) ↔ w₂ ∣ w₁) := by
    intro w₁ w₂ h1 h2
    constructor
    · intro h
      apply V2 w₁ w₂ h1 h2
      rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div]
      exact (key _ _ (hνne w₂ h2)).mpr h
    · rintro ⟨c, rfl⟩
      rw [map_mul, map_mul, Valuation.map_mul]
      exact mul_le_of_le_one_right' (((O σ).valuation_le_one_iff _).mpr (V3 _))

  have hP : ∀ X : List ↥W, wcFrmP W σ X ≠ 0 := by
    intro X
    unfold wcFrmP
    refine mul_ne_zero ?_ (pow_ne_zero _ hσ0)
    rw [Ne, List.prod_eq_zero_iff]
    intro h
    have := (List.mem_filter.mp h).2
    simp at this

  have hstar : ∀ (F : K) (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), F ≠ 0 →
      wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e →
      (O σ).valuation (algebraMap A K (algebraMap ↥W A (k1 * wcFrmP W σ Z))) =
        (O σ).valuation (algebraMap A K (algebraMap ↥W A (k2 * wcFrmP W σ Y))) *
          (O σ).valuation F := by
    intro F k1 k2 Z Y d e hF hR
    obtain ⟨h1, h2⟩ := V1 F k1 k2 Z Y d e hF hR
    have hA0 := hνne _ (mul_ne_zero hR.1 (hP Z))
    have hB0 := hνne _ (mul_ne_zero hR.2.1 (hP Y))
    have hF0 : (O σ).valuation F ≠ 0 := fun h => hF ((Valuation.zero_iff _).mp h)
    rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div, Valuation.map_mul,
      key _ _ hA0] at h1
    rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div, Valuation.map_mul,
      key _ _ (mul_ne_zero hB0 hF0)] at h2
    exact le_antisymm h2 h1

  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    have huv : u * v = algebraMap ↥W A g := hPD.2.2.2.2.2.2.2.1
    apply hb g hPD.2.2.2.2.2.2.1
    rw [← huv, map_mul, h, zero_mul]
  have hR1 : wcFrmREP W A K 𝔭 u (algebraMap A K u) 1 1 [0] [] 1 1 := by
    have h1 : (1 : A) ∉ 𝔭 := fun h => hPD.2.2.2.1.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    refine ⟨one_ne_zero, one_ne_zero, h1, h1, ?_⟩
    simp
  have hd : (O σ).valuation (algebraMap A K u) =
      (O σ).valuation (algebraMap A K (algebraMap ↥W A σ)) := by
    have h := hstar _ 1 1 [0] [] 1 1 hu0 hR1
    have hP0 : wcFrmP W σ [0] = σ := by simp [wcFrmP]
    have hPn : wcFrmP W σ [] = 1 := by simp [wcFrmP]
    rw [hP0, hPn, one_mul, one_mul, map_one, map_one, Valuation.map_one, one_mul] at h
    exact h.symm
  have alg : ∀ (α β γ δ π κ s F : (O σ).ValueGroup) (a b : ℕ), κ ≠ 0 → s ≠ 0 →
      α * β = γ * δ * F → F = π / κ * (s ^ a / s ^ b) →
      α * κ * β * s ^ b = γ * π * δ * s ^ a := by
    intro α β γ δ π κ s F a b hκ hs h hF
    rw [hF] at h
    have hk' : κ⁻¹ * κ = 1 := inv_mul_cancel₀ hκ
    have hs' : (s ^ b)⁻¹ * s ^ b = 1 := inv_mul_cancel₀ (pow_ne_zero b hs)
    calc α * κ * β * s ^ b = (α * β) * (κ * s ^ b) := by
          rw [mul_right_comm α κ β, mul_assoc (α * β) κ]
      _ = γ * δ * (π / κ * (s ^ a / s ^ b)) * (κ * s ^ b) := by rw [h]
      _ = γ * π * δ * s ^ a * ((κ⁻¹ * κ) * ((s ^ b)⁻¹ * s ^ b)) := by
          simp only [div_eq_mul_inv]
          ac_rfl
      _ = γ * π * δ * s ^ a := by rw [hk', hs', mul_one, mul_one]
  refine ⟨hb, hc, hd, ?_⟩
  intro F k1 k2 Z Y d e hF hR
  have hs := hstar F k1 k2 Z Y d e hF hR
  have hA0 : k1 * wcFrmP W σ Z ≠ 0 := mul_ne_zero hR.1 (hP Z)
  have hB0 : k2 * wcFrmP W σ Y ≠ 0 := mul_ne_zero hR.2.1 (hP Y)
  refine ⟨fun hF1 => ?_, fun p q k hp hq hFk => ?_⟩
  · rw [← hc _ _ hA0 hB0, hs]
    exact mul_le_of_le_one_right' hF1
  · have hk : k = ((k.toNat : ℕ) : ℤ) - (((-k).toNat : ℕ) : ℤ) :=
      (Int.toNat_sub_toNat_neg k).symm
    rw [hk] at hFk
    generalize k.toNat = a at hFk ⊢
    generalize (-k).toNat = b at hFk ⊢
    have hsne := hνne σ hσ0
    have hqne := hνne q hq
    rw [Valuation.map_mul, Valuation.map_div, map_zpow₀, hd, zpow_sub₀ hsne, zpow_natCast,
      zpow_natCast] at hFk
    have heq : (O σ).valuation (algebraMap A K (algebraMap ↥W A (k1 * q * wcFrmP W σ Z * σ ^ b))) =
        (O σ).valuation (algebraMap A K (algebraMap ↥W A (k2 * p * wcFrmP W σ Y * σ ^ a))) := by
      simp only [map_mul, map_pow, Valuation.map_mul, Valuation.map_pow] at hs ⊢
      exact alg _ _ _ _ _ _ _ _ a b hqne hsne hs hFk
    have hL : k1 * q * wcFrmP W σ Z * σ ^ b ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hR.1 hq) (hP Z)) (pow_ne_zero _ hσ0)
    have hRr : k2 * p * wcFrmP W σ Y * σ ^ a ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero hR.2.1 hp) (hP Y)) (pow_ne_zero _ hσ0)
    exact ⟨(hc _ _ hRr hL).mp heq.ge, (hc _ _ hL hRr).mp heq.le⟩

theorem wcFrmDm_term_cmp : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) {K : Type u}
    [Field K] (O : ValuationSubring K) (ι : ↥W →+* K) (x : K) (σ : ↥W), σ ≠ 0 →
    (∀ w : ↥W, w ≠ 0 → ι w ≠ 0) →
    (∀ w₁ w₂ : ↥W, w₁ ≠ 0 → w₂ ≠ 0 → (O.valuation (ι w₁) ≤ O.valuation (ι w₂) ↔ w₂ ∣ w₁)) →
    O.valuation x = O.valuation (ι σ) →
    ∀ (p q p' q' : ↥W) (k k' : ℤ), p ≠ 0 → q ≠ 0 → p' ≠ 0 → q' ≠ 0 → k' < k →
    ((O.valuation (ι p / ι q * x ^ k) ≤ O.valuation (ι p' / ι q' * x ^ k') ↔
        p' * q ∣ p * q' * σ ^ (k - k').toNat) ∧
      (O.valuation (ι p' / ι q' * x ^ k') ≤ O.valuation (ι p / ι q * x ^ k) ↔
        p * q' * σ ^ (k - k').toNat ∣ p' * q)) :=
by
  intro Ω _ W K _ O ι x σ hσ hι hval hx p q p' q' k k' hp hq hp' hq' hkk
  have hk : k = k' + ((k - k').toNat : ℤ) := by
    have := Int.toNat_of_nonneg (show (0:ℤ) ≤ k - k' by omega)
    omega
  have hs0 : O.valuation (ι σ) ≠ 0 := (Valuation.ne_zero_iff _).mpr (hι σ hσ)
  have hb0 : O.valuation (ι q) ≠ 0 := (Valuation.ne_zero_iff _).mpr (hι q hq)
  have hb'0 : O.valuation (ι q') ≠ 0 := (Valuation.ne_zero_iff _).mpr (hι q' hq')
  have hw1 : p * q' * σ ^ (k - k').toNat ≠ 0 :=
    mul_ne_zero (mul_ne_zero hp hq') (pow_ne_zero _ hσ)
  have hw2 : p' * q ≠ 0 := mul_ne_zero hp' hq
  have hDne : O.valuation (ι σ) ^ k' / (O.valuation (ι q) * O.valuation (ι q')) ≠ 0 :=
    div_ne_zero (zpow_ne_zero _ hs0) (mul_ne_zero hb0 hb'0)
  have hD0 : 0 < O.valuation (ι σ) ^ k' / (O.valuation (ι q) * O.valuation (ι q')) :=
    zero_lt_iff.mpr hDne
  have e1 : O.valuation (ι p / ι q * x ^ k) = O.valuation (ι (p * q' * σ ^ (k - k').toNat)) *
      (O.valuation (ι σ) ^ k' / (O.valuation (ι q) * O.valuation (ι q'))) := by
    have h1 : O.valuation (ι p / ι q * x ^ k) =
        O.valuation (ι p) / O.valuation (ι q) * (O.valuation (ι σ) ^ k' *
          O.valuation (ι σ) ^ (k - k').toNat) := by
      rw [map_mul, map_div₀, map_zpow₀, hx]
      conv_lhs => rw [hk]
      rw [zpow_add₀ hs0, zpow_natCast]
    rw [h1, map_mul, map_mul, map_pow, map_mul, map_mul, map_pow]
    field_simp
  have e2 : O.valuation (ι p' / ι q' * x ^ k') = O.valuation (ι (p' * q)) *
      (O.valuation (ι σ) ^ k' / (O.valuation (ι q) * O.valuation (ι q'))) := by
    rw [map_mul, map_div₀, map_zpow₀, hx, map_mul, map_mul]
    field_simp
  rw [e1, e2, mul_le_mul_iff_of_pos_right hD0, mul_le_mul_iff_of_pos_right hD0]
  exact ⟨hval _ _ hw1 hw2, hval _ _ hw2 hw1⟩

theorem wcFrmDm_max_term : ∀ {K : Type u} [Field K] {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]
    (ν : Valuation K Γ₀) {ι : Type*} (D : List ι) (T : ι → K) (E : K), D.Nodup → ν E ≤ 1 →
    (∀ i ∈ D, ν (T i) ≠ 1) → (∀ i ∈ D, ∀ j ∈ D, i ≠ j → ν (T i) ≠ ν (T j)) →
    ((∀ i ∈ D, ν (T i) < 1) ∧ ν ((D.map T).sum + E) ≤ 1) ∨
    (∃ j ∈ D, 1 < ν (T j) ∧ (∀ i ∈ D, i ≠ j → ν (T i) < ν (T j)) ∧
      ν ((D.map T).sum + E) = ν (T j)) :=
by
  intro K _ Γ₀ _ ν ι D T E hD hE h1 h2
  classical
  have s1 : ∀ (L : List ι) (g : Γ₀), (∀ i ∈ L, ν (T i) ≤ g) → ν ((L.map T).sum) ≤ g := by
    intro L g
    induction L with
    | nil => intro _; simp
    | cons a L ih =>
      intro h
      rw [List.map_cons, List.sum_cons]
      exact Valuation.map_add_le ν (h a (List.mem_cons_self ..))
        (ih (fun i hi => h i (List.mem_cons_of_mem a hi)))
  have s2 : ∀ (L : List ι) (g : Γ₀), g ≠ 0 → (∀ i ∈ L, ν (T i) < g) → ν ((L.map T).sum) < g := by
    intro L g hg
    induction L with
    | nil => intro _; simp [zero_lt_iff, hg]
    | cons a L ih =>
      intro h
      rw [List.map_cons, List.sum_cons]
      exact Valuation.map_add_lt ν (h a (List.mem_cons_self ..))
        (ih (fun i hi => h i (List.mem_cons_of_mem a hi)))
  by_cases h : ∃ i ∈ D, 1 ≤ ν (T i)
  · right
    obtain ⟨i₀, hi₀D, hi₀⟩ := h
    have hne : D.toFinset.Nonempty := ⟨i₀, List.mem_toFinset.mpr hi₀D⟩
    obtain ⟨j, hjD', hjmax⟩ := Finset.exists_max_image D.toFinset (fun i => ν (T i)) hne
    have hjD : j ∈ D := List.mem_toFinset.mp hjD'
    have hmax : ∀ i ∈ D, ν (T i) ≤ ν (T j) := fun i hi => hjmax i (List.mem_toFinset.mpr hi)
    have hj1 : 1 < ν (T j) := lt_of_le_of_ne (hi₀.trans (hmax i₀ hi₀D)) (h1 j hjD).symm
    have hdom : ∀ i ∈ D, i ≠ j → ν (T i) < ν (T j) := fun i hi hij =>
      lt_of_le_of_ne (hmax i hi) (h2 i hi j hjD hij)
    have hsplit : (D.map T).sum = T j + ((D.erase j).map T).sum := by
      rw [((List.perm_cons_erase hjD).map T).sum_eq, List.map_cons, List.sum_cons]
    have hj0 : ν (T j) ≠ 0 := ne_of_gt (lt_of_le_of_lt zero_le' hj1)
    have hR : ν (((D.erase j).map T).sum) < ν (T j) := by
      apply s2 _ _ hj0
      intro i hi
      rw [hD.mem_erase_iff] at hi
      exact hdom i hi.2 hi.1
    have hRE : ν (((D.erase j).map T).sum + E) < ν (T j) :=
      Valuation.map_add_lt ν hR (lt_of_le_of_lt hE hj1)
    refine ⟨j, hjD, hj1, hdom, ?_⟩
    rw [hsplit, add_assoc]
    exact Valuation.map_add_eq_of_lt_left ν hRE
  · left
    push_neg at h
    refine ⟨h, ?_⟩
    exact Valuation.map_add_le ν (s1 D 1 (fun i hi => (h i hi).le)) hE

theorem wcFrmCp_dominant : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (ℓ : ℕ) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K]
    [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    ∀ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O →
    ∀ F : K, F ≠ 0 → ∀ D : List (ℤ × ↥W × ↥W), (D.map Prod.fst).Nodup →
    (∀ t ∈ D, t.2.1 ≠ 0 ∧ t.2.2 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ t.1) →
    ∀ ρ₁ ρ₂ : ↥W, wcFrmInt W g ρ₁ → wcFrmInt W g ρ₂ → ρ₁ ∣ ρ₂ →
    (∀ σ : ↥W, wcFrmInt W g σ → ρ₁ ∣ σ → σ ∣ ρ₂ →
      F - (D.map (fun t => algebraMap A K (algebraMap ↥W A t.2.1) /
        algebraMap A K (algebraMap ↥W A t.2.2) * algebraMap A K u ^ t.1)).sum ∈ O σ) →
    ∃ (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), wcFrmREP W A K 𝔭 u F k1 k2 Z Y d e ∧
      ∀ ρ : ↥W, wcFrmInt W g ρ → (ρ₁ ∣ ρ ∧ ρ ∣ ρ₂) → wcFrmGen W ρ (Z ++ Y) →
        wcFrmGood W ℓ ρ k1 k2 Z Y :=
by
  intro Ω _ _ W hW hWt ℓ A _ _ _ K _ _ _ 𝔭 u v g hPD O hO F hF0 D hDnd hD ρ₁ ρ₂ hI₁ hI₂ h12 hE
  classical

  obtain ⟨T, hT⟩ : ∃ T : ℤ × ↥W × ↥W → K, ∀ t, T t = algebraMap A K (algebraMap ↥W A t.2.1) /
      algebraMap A K (algebraMap ↥W A t.2.2) * algebraMap A K u ^ t.1 := ⟨_, fun _ => rfl⟩
  have hDT : D.map (fun t : ℤ × ↥W × ↥W => algebraMap A K (algebraMap ↥W A t.2.1) /
      algebraMap A K (algebraMap ↥W A t.2.2) * algebraMap A K u ^ t.1) = D.map T :=
    List.map_congr_left (fun t _ => (hT t).symm)
  have hE' : ∀ σ, wcFrmInt W g σ → ρ₁ ∣ σ → σ ∣ ρ₂ → F - (D.map T).sum ∈ O σ := by
    intro σ h1 h2 h3
    have := hE σ h1 h2 h3
    rwa [hDT] at this
  obtain ⟨k1, k2, Z₁, Y₁, d, e, hR⟩ := wcFrm_rep_exists Ω W hW hWt A K 𝔭 u v g hPD F hF0

  obtain ⟨t₀, ht₀⟩ : ∃ t₀ : ℤ × ↥W × ↥W, t₀ = ((0 : ℤ), (1 : ↥W), (1 : ↥W)) := ⟨_, rfl⟩
  have hTt₀ : T t₀ = 1 := by
    rw [hT, ht₀]
    simp
  have hk0 : ∀ t ∈ D, t.1 ≠ 0 := fun t ht h => (hD t ht).2.2 (by rw [h]; exact dvd_zero _)
  have hDnodup : D.Nodup := List.Nodup.of_map Prod.fst hDnd
  have memD₀ : ∀ i ∈ D, i ∈ t₀ :: D := fun i hi => List.mem_cons_of_mem _ hi
  have ht₀mem : t₀ ∈ t₀ :: D := List.mem_cons_self
  have hne_t₀ : ∀ i ∈ D, i ≠ t₀ := fun i hi h => hk0 i hi (by rw [h, ht₀])
  have hkeynd : ((t₀ :: D).map Prod.fst).Nodup := by
    rw [List.map_cons, List.nodup_cons]
    refine ⟨?_, hDnd⟩
    intro hmem
    obtain ⟨t, ht, htk⟩ := List.mem_map.mp hmem
    exact hk0 t ht (by rw [htk, ht₀])
  have hD₀key : ∀ s ∈ t₀ :: D, ∀ t ∈ t₀ :: D, s ≠ t → s.1 ≠ t.1 :=
    fun s hs t ht hst hk => hst (List.inj_on_of_nodup_map hkeynd hs ht hk)
  have hD₀nz : ∀ s ∈ t₀ :: D, s.2.1 ≠ 0 ∧ s.2.2 ≠ 0 := by
    intro s hs
    rcases List.mem_cons.mp hs with h | h
    · rw [h, ht₀]; exact ⟨one_ne_zero, one_ne_zero⟩
    · exact ⟨(hD s h).1, (hD s h).2.1⟩

  have hthr : ∀ s t : ℤ × ↥W × ↥W, ∃ τ : ↥W, t.1 < s.1 → s.2.1 ≠ 0 → s.2.2 ≠ 0 →
      t.2.1 ≠ 0 → t.2.2 ≠ 0 → ∀ σ, wcFrmInt W g σ →
        (((O σ).valuation (T s) ≤ (O σ).valuation (T t) ↔ τ ∣ σ) ∧
         ((O σ).valuation (T t) ≤ (O σ).valuation (T s) ↔ σ ∣ τ)) := by
    intro s t
    by_cases hc : t.1 < s.1 ∧ s.2.1 ≠ 0 ∧ s.2.2 ≠ 0 ∧ t.2.1 ≠ 0 ∧ t.2.2 ≠ 0
    · obtain ⟨hlt, h1, h2, h3, h4⟩ := hc
      have hn : 0 < (s.1 - t.1).toNat := by omega
      obtain ⟨τ, _, hτ⟩ := wcFrmDm_threshold Ω W (t.2.1 * s.2.2) (s.2.1 * t.2.2)
        (s.1 - t.1).toNat (mul_ne_zero h3 h2) (mul_ne_zero h1 h4) hn
      refine ⟨τ, fun _ _ _ _ _ σ hσ => ?_⟩
      have V := wcFrmDm_val_facts Ω W A K 𝔭 u v g O hPD hO σ hσ
      have hcmp := wcFrmDm_term_cmp W (O σ) ((algebraMap A K).comp (algebraMap ↥W A))
        (algebraMap A K u) σ hσ.2.1 V.1 V.2.1 V.2.2.1 s.2.1 s.2.2 t.2.1 t.2.2 s.1 t.1
        h1 h2 h3 h4 hlt
      rw [hT s, hT t]
      obtain ⟨hτ1, hτ2⟩ := hτ σ hσ.1 hσ.2.1
      rw [← hτ1, ← hτ2]
      exact hcmp
    · exact ⟨0, fun h1 h2 h3 h4 h5 => absurd ⟨h1, h2, h3, h4, h5⟩ hc⟩
  choose τ hτ using hthr

  obtain ⟨Pd, hPd⟩ : ∃ Pd : List ↥W,
      Pd = ρ₂ :: (t₀ :: D).flatMap (fun s => (t₀ :: D).map (fun t => τ s t)) := ⟨_, rfl⟩
  have hρ₂Pd : ρ₂ ∈ Pd := by rw [hPd]; exact List.mem_cons_self
  have hτPd : ∀ s ∈ t₀ :: D, ∀ t ∈ t₀ :: D, τ s t ∈ Pd := by
    intro s hs t ht
    rw [hPd]
    exact List.mem_cons_of_mem _ (List.mem_flatMap.mpr ⟨s, hs, List.mem_map.mpr ⟨t, ht, rfl⟩⟩)
  have hPdmem : ∀ c ∈ Pd, c ∈ Z₁ ++ Pd ++ (Y₁ ++ Pd) :=
    fun c hc => List.mem_append_left _ (List.mem_append_right _ hc)
  have hR' : wcFrmREP W A K 𝔭 u F k1 k2 (Z₁ ++ Pd) (Y₁ ++ Pd) d e := by
    obtain ⟨h1, h2, h3, h4, h5⟩ := hR
    refine ⟨h1, h2, h3, h4, ?_⟩
    rw [List.map_append, List.map_append, List.prod_append, List.prod_append]
    linear_combination (Pd.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod * h5

  have hStr : ∀ σ, wcFrmInt W g σ → wcFrmGen W σ (Z₁ ++ Pd ++ (Y₁ ++ Pd)) →
      ∀ s ∈ t₀ :: D, ∀ t ∈ t₀ :: D, s ≠ t →
        (O σ).valuation (T s) ≠ (O σ).valuation (T t) := by
    intro σ hσ hg s hs t ht hst heq
    have hk := hD₀key s hs t ht hst
    rcases lt_or_gt_of_ne hk with hlt | hlt
    · have h := hτ t s hlt (hD₀nz t ht).1 (hD₀nz t ht).2 (hD₀nz s hs).1 (hD₀nz s hs).2 σ hσ
      exact hg (τ t s) (hPdmem _ (hτPd t ht s hs)) ⟨h.2.mp heq.le, h.1.mp heq.symm.le⟩
    · have h := hτ s t hlt (hD₀nz s hs).1 (hD₀nz s hs).2 (hD₀nz t ht).1 (hD₀nz t ht).2 σ hσ
      exact hg (τ s t) (hPdmem _ (hτPd s hs t ht)) ⟨h.2.mp heq.symm.le, h.1.mp heq.le⟩
  have hTr : ∀ σ σ', wcFrmInt W g σ → wcFrmInt W g σ' →
      (∀ c ∈ Z₁ ++ Pd ++ (Y₁ ++ Pd), ((σ ∣ c ↔ σ' ∣ c) ∧ (c ∣ σ ↔ c ∣ σ'))) →
      ∀ s ∈ t₀ :: D, ∀ t ∈ t₀ :: D, s ≠ t →
        (O σ').valuation (T s) ≤ (O σ').valuation (T t) →
        (O σ).valuation (T s) ≤ (O σ).valuation (T t) := by
    intro σ σ' hσ hσ' hpat s hs t ht hst hle
    have hk := hD₀key s hs t ht hst
    rcases lt_or_gt_of_ne hk with hlt | hlt
    · have h := hτ t s hlt (hD₀nz t ht).1 (hD₀nz t ht).2 (hD₀nz s hs).1 (hD₀nz s hs).2 σ hσ
      have h' := hτ t s hlt (hD₀nz t ht).1 (hD₀nz t ht).2 (hD₀nz s hs).1 (hD₀nz s hs).2 σ' hσ'
      exact h.2.mpr ((hpat _ (hPdmem _ (hτPd t ht s hs))).1.mpr (h'.2.mp hle))
    · have h := hτ s t hlt (hD₀nz s hs).1 (hD₀nz s hs).2 (hD₀nz t ht).1 (hD₀nz t ht).2 σ hσ
      have h' := hτ s t hlt (hD₀nz s hs).1 (hD₀nz s hs).2 (hD₀nz t ht).1 (hD₀nz t ht).2 σ' hσ'
      exact h.1.mpr ((hpat _ (hPdmem _ (hτPd s hs t ht))).2.mpr (h'.1.mp hle))

  have hmax : ∀ σ, wcFrmInt W g σ → ρ₁ ∣ σ → σ ∣ ρ₂ → wcFrmGen W σ (Z₁ ++ Pd ++ (Y₁ ++ Pd)) →
      ((∀ i ∈ D, (O σ).valuation (T i) < 1) ∧ (O σ).valuation F ≤ 1) ∨
      (∃ j ∈ D, 1 < (O σ).valuation (T j) ∧
        (∀ i ∈ D, i ≠ j → (O σ).valuation (T i) < (O σ).valuation (T j)) ∧
        (O σ).valuation F = (O σ).valuation (T j)) := by
    intro σ hσ h1 h2 hg
    have hEσ : (O σ).valuation (F - (D.map T).sum) ≤ 1 :=
      ((O σ).valuation_le_one_iff _).mpr (hE' σ hσ h1 h2)
    have hsum : (D.map T).sum + (F - (D.map T).sum) = F := by ring
    have hm := wcFrmDm_max_term (O σ).valuation D T (F - (D.map T).sum) hDnodup hEσ
      (fun i hi h1' => hStr σ hσ hg i (memD₀ i hi) t₀ ht₀mem (hne_t₀ i hi)
        (by rw [h1', hTt₀, map_one]))
      (fun i hi j hj hij => hStr σ hσ hg i (memD₀ i hi) j (memD₀ j hj) hij)
    rw [hsum] at hm
    exact hm

  refine ⟨k1, k2, Z₁ ++ Pd, Y₁ ++ Pd, d, e, hR', ?_⟩
  intro ρ hρ hpc hgen
  have Vρ := wcFrmDm_val_facts Ω W A K 𝔭 u v g O hPD hO ρ hρ
  unfold wcFrmGood
  rcases hmax ρ hρ hpc.1 hpc.2 hgen with ⟨_, hFle⟩ | ⟨j, hjD, hj1, hjdom, hFj⟩
  ·
    exact Or.inl ((Vρ.2.2.2 F k1 k2 _ _ d e hF0 hR').1 hFle)
  ·
    have hρ₂gen : ¬ ρ₂ ∣ ρ := fun h => hgen ρ₂ (hPdmem _ hρ₂Pd) ⟨hpc.2, h⟩
    obtain ⟨ρ', hρ'0, hρρ', hρ'ρ, hρ'2, hpat⟩ := wcFrmDm_cell_point Ω W
      (Z₁ ++ Pd ++ (Y₁ ++ Pd)) ρ ρ₂ hρ.2.1 hI₂.2.1 hpc.2 hρ₂gen (hPdmem _ hρ₂Pd) hgen
    have hρ'I : wcFrmInt W g ρ' := by
      refine ⟨?_, hρ'0, hρ'2.trans hI₂.2.2.1, fun h => hI₂.2.2.2 (h.trans hρ'2)⟩
      obtain ⟨c, hc⟩ := hρρ'
      rw [hc]
      exact Ideal.mul_mem_right _ _ hρ.1
    have hgen' : wcFrmGen W ρ' (Z₁ ++ Pd ++ (Y₁ ++ Pd)) := fun c hc h =>
      hgen c hc ⟨(hpat c hc).1.mpr h.1, (hpat c hc).2.mpr h.2⟩
    have Vρ' := wcFrmDm_val_facts Ω W A K 𝔭 u v g O hPD hO ρ' hρ'I
    have hFj' : (O ρ').valuation F = (O ρ').valuation (T j) := by
      rcases hmax ρ' hρ'I (hpc.1.trans hρρ') hρ'2 hgen' with ⟨hlt1, _⟩ |
          ⟨j', hj'D, _, hj'dom, hFj'⟩
      · exfalso
        have h1 : (O ρ').valuation (T j) ≤ (O ρ').valuation (T t₀) := by
          rw [hTt₀, map_one]
          exact (hlt1 j hjD).le
        have h2 := hTr ρ ρ' hρ hρ'I hpat j (memD₀ j hjD) t₀ ht₀mem (hne_t₀ j hjD) h1
        rw [hTt₀, map_one] at h2
        exact absurd hj1 (not_lt.mpr h2)
      · have hjj : j' = j := by
          by_contra hne
          have h1 := (hj'dom j hjD (Ne.symm hne)).le
          have h2 := hTr ρ ρ' hρ hρ'I hpat j (memD₀ j hjD) j' (memD₀ j' hj'D) (Ne.symm hne) h1
          exact absurd (hjdom j' hj'D hne) (not_lt.mpr h2)
        rw [hjj] at hFj'
        exact hFj'
    rw [hT] at hFj hFj'
    obtain ⟨hd1, hd2⟩ := (Vρ.2.2.2 F k1 k2 _ _ d e hF0 hR').2 j.2.1 j.2.2 j.1
      (hD j hjD).1 (hD j hjD).2.1 hFj
    obtain ⟨hd1', hd2'⟩ := (Vρ'.2.2.2 F k1 k2 _ _ d e hF0 hR').2 j.2.1 j.2.2 j.1
      (hD j hjD).1 (hD j hjD).2.1 hFj'

    have hM := wcFrmDm_slope Ω W ρ ρ' (k1 * j.2.2) (k2 * j.2.1) (Z₁ ++ Pd) (Y₁ ++ Pd) j.1
      hρ.2.1 hρ'0 hρρ' hρ'ρ (mul_ne_zero hR'.1 (hD j hjD).2.1)
      (mul_ne_zero hR'.2.1 (hD j hjD).1) (fun c hc => (hpat c hc).1) hd1 hd2 hd1' hd2'
    right
    rw [hM]
    exact (hD j hjD).2.2

theorem wcFrm_compact_piece : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∀ O : ↥W → ValuationSubring K, wcFrmVAL W A K 𝔭 u g O →
    ∀ (k1 k2 : ↥W) (Z Y : List ↥W) (d e : A), wcFrmREP W A K 𝔭 u f₀ k1 k2 Z Y d e →
    ∀ ρ₁ ρ₂ : ↥W, wcFrmInt W g ρ₁ → wcFrmInt W g ρ₂ → ρ₁ ∣ ρ₂ →
    (∀ z ∈ Z ++ Y, wcFrmInt W g z → ¬ (ρ₁ ∣ z ∧ z ∣ ρ₂)) →
    wcFrmMem W A K 𝔭 u g ℓ f₀ (fun ρ => ρ₁ ∣ ρ ∧ ρ ∣ ρ₂) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD _hfin α f₀ hα1 hf₀
    O hO k1 k2 Z Y d e hR ρ₁ ρ₂ hI₁ hI₂ h12 hno
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e' : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e', hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP K ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hK
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
  have hFne : ∀ H : K, f₀ - (H ^ ℓ - H) ≠ 0 := by
    intro H h0
    have h1 : algebraMap K L f₀ = algebraMap K L H ^ ℓ - algebraMap K L H := by
      have h2 := congrArg (algebraMap K L) h0
      rw [map_sub, map_sub, map_pow, map_zero, sub_eq_zero] at h2
      exact h2
    have h2 : (α - algebraMap K L H) ^ ℓ = α - algebraMap K L H := by
      rw [sub_pow_char]
      have h3 := hf₀.symm.trans h1
      linear_combination h3
    have hbot : α - algebraMap K L H ∈ (⊥ : Subfield L) :=
      (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr h2
    have hr : α - algebraMap K L H ∈ (algebraMap K L).fieldRange :=
      (bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp hr
    exact hα1 ⟨x + H, by rw [map_add, hx]; ring⟩

  have hno' : ∀ z ∈ Z ++ Y, ¬ (ρ₁ ∣ z ∧ z ∣ ρ₂) := by
    rintro z hz ⟨hz1, hz2⟩
    refine hno z hz ⟨?_, ?_, hz2.trans hI₂.2.2.1, fun h => hI₂.2.2.2 (h.trans hz2)⟩ ⟨hz1, hz2⟩
    · obtain ⟨c, hc⟩ := hz1
      rw [hc]
      exact Ideal.mul_mem_right _ _ hI₁.1
    · rintro rfl
      exact hI₂.2.1 (zero_dvd_iff.mp hz2)

  obtain ⟨Λ, _hΛq, hΛ⟩ := wcFrmCp_expansion Ω W hW hWt A K 𝔭 u v g hPD O hO f₀ k1 k2 Z Y d e hR
    ρ₁ ρ₂ hI₁ hI₂ h12 hno'

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have h1 : w • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact hw
    haveI := hPD.2.1
    rcases smul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hginj : Function.Injective ((algebraMap A K).comp (algebraMap ↥W A)) :=
    (IsFractionRing.injective A K).comp hWA
  let ι : Ω →+* K := IsFractionRing.lift (A := ↥W) hginj
  have hι : ∀ w : ↥W, ι (w : Ω) = algebraMap A K (algebraMap ↥W A w) := fun w =>
    IsFractionRing.lift_algebraMap (A := ↥W) hginj w
  let S : Subfield K := ι.fieldRange
  have hSroot : ∀ a ∈ S, ∃ b ∈ S, b ^ ℓ = a := by
    intro a ha
    obtain ⟨y, rfl⟩ := RingHom.mem_fieldRange.mp ha
    obtain ⟨b, hb⟩ := IsAlgClosed.exists_pow_nat_eq y hℓ.pos
    exact ⟨ι b, RingHom.mem_fieldRange.mpr ⟨b, rfl⟩, by rw [← map_pow, hb]⟩
  have hSas : ∀ a ∈ S, ∃ b ∈ S, b ^ ℓ - b = a := by
    intro a ha
    obtain ⟨y, rfl⟩ := RingHom.mem_fieldRange.mp ha
    have hlt : (Polynomial.X + Polynomial.C y : Polynomial Ω).degree <
        (Polynomial.X ^ ℓ : Polynomial Ω).degree := by
      rw [Polynomial.degree_X_pow, Polynomial.degree_X_add_C]
      exact_mod_cast hℓ.one_lt
    have hdeg : (Polynomial.X ^ ℓ - (Polynomial.X + Polynomial.C y) : Polynomial Ω).degree =
        (ℓ : WithBot ℕ) := by
      rw [Polynomial.degree_sub_eq_left_of_degree_lt hlt, Polynomial.degree_X_pow]
    obtain ⟨b, hb⟩ := IsAlgClosed.exists_root
      (Polynomial.X ^ ℓ - (Polynomial.X + Polynomial.C y) : Polynomial Ω)
      (by rw [hdeg]; exact_mod_cast hℓ.ne_zero)
    have hb' : Polynomial.eval b
        (Polynomial.X ^ ℓ - (Polynomial.X + Polynomial.C y) : Polynomial Ω) = 0 := hb
    rw [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at hb'
    refine ⟨ι b, RingHom.mem_fieldRange.mpr ⟨b, rfl⟩, ?_⟩
    rw [← map_pow, ← map_sub]
    congr 1
    linear_combination hb'
  obtain ⟨H, D', hD'nd, hD'S, hD'eq⟩ := wcFrmCp_laurent_reduce K ℓ S hSroot hSas
    (algebraMap A K u) (Λ.map (fun t => (t.1, algebraMap A K (algebraMap ↥W A t.2.1) /
      algebraMap A K (algebraMap ↥W A t.2.2)))) (by
        intro t ht
        obtain ⟨s, _, rfl⟩ := List.mem_map.mp ht
        refine RingHom.mem_fieldRange.mpr ⟨(s.2.1 : Ω) / (s.2.2 : Ω), ?_⟩
        rw [map_div₀, hι, hι])
  have hΛsum : ((Λ.map (fun t => (t.1, algebraMap A K (algebraMap ↥W A t.2.1) /
      algebraMap A K (algebraMap ↥W A t.2.2)))).map
        (fun t => t.2 * algebraMap A K u ^ t.1)).sum =
      (Λ.map (fun t => algebraMap A K (algebraMap ↥W A t.2.1) /
        algebraMap A K (algebraMap ↥W A t.2.2) * algebraMap A K u ^ t.1)).sum := by
    rw [List.map_map]
    rfl
  rw [hΛsum] at hD'eq

  have hcoef : ∀ c : K, ∃ pq : ↥W × ↥W, c ∈ S → c ≠ 0 → pq.1 ≠ 0 ∧ pq.2 ≠ 0 ∧
      c = algebraMap A K (algebraMap ↥W A pq.1) / algebraMap A K (algebraMap ↥W A pq.2) := by
    intro c
    by_cases hc : c ∈ S ∧ c ≠ 0
    · obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp hc.1
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact hc.2 (by rw [← hx, map_zero])
      rcases W.mem_or_inv_mem x with h | h
      · refine ⟨((⟨x, h⟩ : ↥W), (1 : ↥W)), fun _ _ => ⟨?_, one_ne_zero, ?_⟩⟩
        · intro h0
          exact hx0 (congrArg Subtype.val h0)
        · have h1 : ι x = algebraMap A K (algebraMap ↥W A ⟨x, h⟩) := hι ⟨x, h⟩
          rw [map_one, map_one, div_one, ← h1, hx]
      · refine ⟨((1 : ↥W), (⟨x⁻¹, h⟩ : ↥W)), fun _ _ => ⟨one_ne_zero, ?_, ?_⟩⟩
        · intro h0
          exact (inv_ne_zero hx0) (congrArg Subtype.val h0)
        · have h1 : ι x⁻¹ = algebraMap A K (algebraMap ↥W A ⟨x⁻¹, h⟩) := hι ⟨x⁻¹, h⟩
          rw [map_one, map_one, ← h1, map_inv₀, ← hx, one_div, inv_inv]
    · exact ⟨(1, 1), fun h1 h2 => absurd ⟨h1, h2⟩ hc⟩
  choose pq hpq using hcoef
  let D : List (ℤ × ↥W × ↥W) := D'.map (fun t => (t.1, pq t.2))
  have hDnd : (D.map Prod.fst).Nodup := by
    show ((D'.map (fun t => (t.1, pq t.2))).map Prod.fst).Nodup
    rw [List.map_map]
    exact hD'nd
  have hDprop : ∀ t ∈ D, t.2.1 ≠ 0 ∧ t.2.2 ≠ 0 ∧ ¬ (ℓ : ℤ) ∣ t.1 := by
    intro t ht
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp ht
    obtain ⟨hsS, hs0, hsl⟩ := hD'S s hs
    obtain ⟨h1, h2, _⟩ := hpq s.2 hsS hs0
    exact ⟨h1, h2, hsl⟩
  have hDsum : (D.map (fun t => algebraMap A K (algebraMap ↥W A t.2.1) /
        algebraMap A K (algebraMap ↥W A t.2.2) * algebraMap A K u ^ t.1)).sum =
      (D'.map (fun t => t.2 * algebraMap A K u ^ t.1)).sum := by
    show ((D'.map (fun t => (t.1, pq t.2))).map (fun t => algebraMap A K (algebraMap ↥W A t.2.1) /
        algebraMap A K (algebraMap ↥W A t.2.2) * algebraMap A K u ^ t.1)).sum = _
    rw [List.map_map]
    congr 1
    apply List.map_congr_left
    intro s hs
    obtain ⟨hsS, hs0, _⟩ := hD'S s hs
    obtain ⟨_, _, h3⟩ := hpq s.2 hsS hs0
    exact congrArg (fun c => c * algebraMap A K u ^ s.1) h3.symm

  obtain ⟨k1', k2', Z', Y', d', e', hrep, hgood⟩ := wcFrmCp_dominant Ω W hW hWt ℓ A K 𝔭 u v g
    hPD O hO (f₀ - (H ^ ℓ - H)) (hFne H) D hDnd hDprop ρ₁ ρ₂ hI₁ hI₂ h12 (by
      intro σ hσ h1 h2
      rw [hDsum, ← hD'eq]
      have hm := hΛ σ hσ h1 h2
      convert hm using 1
      ring)
  exact ⟨H, k1', k2', Z', Y', d', e', hrep, fun ρ hInt hI hGen => hgood ρ hInt hI hGen⟩

theorem wcLlsASmc_frf_radial_family : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ ℓ : ℕ, ℓ.Prime → ringChar Ω = ℓ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → wcLlsSolvPt W A K L 𝔭 (.ann u v g) y → wcLlsUniq A L 𝔭 y →
    wcLlsBR W A K L 𝔭 (.ann u v g) → Module.finrank K L = ℓ →
    ∀ (α : L) (f₀ : K), α ∉ Set.range (algebraMap K L) → algebraMap K L f₀ = α ^ ℓ - α →
    ∃ (N : ℕ) (Hf : Fin N → K) (k1 k2 : Fin N → ↥W) (Zf Yf : Fin N → List ↥W) (df ef : Fin N → A),
      (∀ i, k1 i ≠ 0 ∧ k2 i ≠ 0 ∧ df i ∉ 𝔭 ∧ ef i ∉ 𝔭 ∧
        algebraMap A K (df i) * algebraMap A K (algebraMap ↥W A (k2 i)) *
            ((Yf i).map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod *
            (f₀ - (Hf i ^ ℓ - Hf i)) =
          algebraMap A K (algebraMap ↥W A (k1 i)) *
            ((Zf i).map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod *
            algebraMap A K (ef i)) ∧
      ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → ρ ∣ g → ¬ g ∣ ρ →
        (∀ i, ∀ z ∈ Zf i ++ Yf i, ¬ (ρ ∣ z ∧ z ∣ ρ)) →
        ∃ i, (let P : List ↥W → ↥W := fun X =>
                (X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod *
                  ρ ^ (X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length
              let m : ℤ :=
                (((Zf i).filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length : ℤ) -
                (((Yf i).filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length : ℤ)
              k2 i * P (Yf i) ∣ k1 i * P (Zf i) ∨ ¬ (ℓ : ℤ) ∣ m) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hSolv hUniq hBR hdeg
    α f₀ hα1 hf₀
  classical

  have hΩ : ((ℓ : ℕ) : Ω) = 0 := by
    rw [← hchar]
    exact ringChar.Nat.cast_ringChar
  have hWl : ((ℓ : ℕ) : ↥W) = 0 := by
    apply Subtype.ext
    simpa using hΩ
  have hK : ((ℓ : ℕ) : K) = 0 := by
    have e : ((ℓ : ℕ) : K) = algebraMap A K (algebraMap ↥W A ((ℓ : ℕ) : ↥W)) := by
      rw [map_natCast, map_natCast]
    rw [e, hWl, map_zero, map_zero]
  have hL : ((ℓ : ℕ) : L) = 0 := by
    rw [← map_natCast (algebraMap K L), hK, map_zero]
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP L ℓ := (CharP.charP_iff_prime_eq_zero hℓ).mpr hL
  have hf0 : f₀ ≠ 0 := by
    intro h0
    have h1 := hf₀
    rw [h0, map_zero] at h1
    have hαα : α ^ ℓ = α := sub_eq_zero.mp h1.symm
    have hbot : α ∈ (⊥ : Subfield L) := (Subfield.mem_bot_iff_pow_eq_self L ℓ).mpr hαα
    have hr : α ∈ (algebraMap K L).fieldRange :=
      (bot_le : (⊥ : Subfield L) ≤ (algebraMap K L).fieldRange) hbot
    obtain ⟨x, hx⟩ := RingHom.mem_fieldRange.mp hr
    exact hα1 ⟨x, hx⟩
  have hgm : g ∈ IsLocalRing.maximalIdeal ↥W := hPD.2.2.2.2.2.1
  have hg0 : g ≠ 0 := hPD.2.2.2.2.2.2.1

  obtain ⟨O, hO⟩ := wcFrm_gauss_val Ω W hW hWt A K 𝔭 u v g hPD
  obtain ⟨k1₀, k2₀, Z₀, Y₀, d₀, e₀, hR₀⟩ := wcFrm_rep_exists Ω W hW hWt A K 𝔭 u v g hPD f₀ hf0
  have hR₀' : wcFrmREP W A K 𝔭 u (f₀ - ((0 : K) ^ ℓ - 0)) k1₀ k2₀ Z₀ Y₀ d₀ e₀ := by
    rw [zero_pow hℓ.ne_zero, sub_zero, sub_zero]
    exact hR₀
  let x₀ : wcFrmData W A K 𝔭 u ℓ f₀ := ⟨0, k1₀, k2₀, Z₀, Y₀, d₀, e₀, hR₀'⟩


  let gen : wcFrmData W A K 𝔭 u ℓ f₀ → ↥W → Prop :=
    fun x ρ => wcFrmGen W ρ (x.Z ++ x.Y) ∧ ¬ (ρ ∣ g ∧ g ∣ ρ)
  let good : wcFrmData W A K 𝔭 u ℓ f₀ → ↥W → Prop :=
    fun x ρ => wcFrmInt W g ρ → wcFrmGood W ℓ ρ x.k1 x.k2 x.Z x.Y
  have hmem : ∀ I : ↥W → Prop, wcFrmMem W A K 𝔭 u g ℓ f₀ I →
      ∃ x : wcFrmData W A K 𝔭 u ℓ f₀, ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
        I ρ → gen x ρ → good x ρ := by
    intro I hI
    obtain ⟨H, k1, k2, Z, Y, d, e, hrep, hg⟩ := hI
    exact ⟨⟨H, k1, k2, Z, Y, d, e, hrep⟩, fun ρ _ _ hIρ hgen hInt => hg ρ hInt hIρ hgen.1⟩

  let Cr : List ↥W := g :: (Z₀ ++ Y₀).filter (fun a => decide (wcFrmInt W g a))
  have hCr : ∀ a ∈ Cr, a = g ∨ (a ∈ Z₀ ++ Y₀ ∧ wcFrmInt W g a) := by
    intro a ha
    rcases List.mem_cons.mp ha with h | h
    · exact Or.inl h
    · right
      have h' := List.mem_filter.mp h
      exact ⟨h'.1, of_decide_eq_true h'.2⟩
  have hCrm : ∀ a ∈ Cr, a ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a ha
    rcases hCr a ha with h | ⟨_, h⟩
    · rw [h]; exact hgm
    · exact h.1
  have hZ0 : ∃ ρ₀ : ↥W, ρ₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ₀ ≠ 0 ∧ ∃ x, ∀ ρ : ↥W,
      ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → (ρ ∣ ρ₀ ∧ ¬ ρ₀ ∣ ρ) → gen x ρ → good x ρ := by
    obtain ⟨ρ₀, hI, hM⟩ := wcFrm_end_u Ω W hW hWt ℓ hℓ hchar A K L 𝔭 u v g hPD hdeg α f₀
      hα1 hf₀ O hO
    exact ⟨ρ₀, hI.1, hI.2.1, hmem _ hM⟩
  have hRt : ∀ a ∈ Cr, a ≠ 0 → ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧ ∃ x,
      ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
        (a ∣ ρ ∧ ¬ ρ ∣ a ∧ ρ ∣ a * ρ' ∧ ¬ a * ρ' ∣ ρ) → gen x ρ → good x ρ := by
    intro a ha _
    rcases hCr a ha with h | ⟨_, hI⟩
    · refine ⟨g, hgm, hg0, x₀, fun ρ _ _ hreg _ hInt => ?_⟩
      rw [h] at hreg
      exact absurd hreg.1 hInt.2.2.2
    · obtain ⟨ρ', h1, h2, hM⟩ := wcFrm_end_right Ω W hW hWt ℓ hℓ hchar A K L 𝔭 u v g hPD hdeg
        α f₀ hα1 hf₀ O hO a hI
      exact ⟨ρ', h1, h2, hmem _ hM⟩
  have hLf : ∀ a ∈ Cr, a ≠ 0 → ∃ ρ' : ↥W, ρ' ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ' ≠ 0 ∧ ∃ x,
      ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
        (ρ ∣ a ∧ ¬ a ∣ ρ ∧ a ∣ ρ * ρ' ∧ ¬ ρ * ρ' ∣ a) → gen x ρ → good x ρ := by
    intro a ha _
    rcases hCr a ha with h | ⟨_, hI⟩
    · obtain ⟨ρ', h1, h2, hM⟩ := wcFrm_end_v Ω W hW hWt ℓ hℓ hchar A K L 𝔭 u v g hPD hdeg
        α f₀ hα1 hf₀ O hO
      obtain ⟨x, hx⟩ := hmem _ hM
      refine ⟨ρ', h1, h2, x, fun ρ hρ hρ0 hreg hgen => hx ρ hρ hρ0 ?_ hgen⟩
      rw [h] at hreg
      exact hreg.2.2.2
    · obtain ⟨ρ', h1, h2, hM⟩ := wcFrm_end_left Ω W hW hWt ℓ hℓ hchar A K L 𝔭 u v g hPD hdeg
        α f₀ hα1 hf₀ O hO a hI
      exact ⟨ρ', h1, h2, hmem _ hM⟩
  have hPt : ∀ a ∈ Cr, a ≠ 0 → ∃ x, ∀ ρ : ↥W, ρ ∣ a → a ∣ ρ → ¬ gen x ρ := by
    intro a ha _
    rcases hCr a ha with h | ⟨hz, _⟩
    · refine ⟨x₀, fun ρ h1 h2 hg => hg.2 ?_⟩
      rw [h] at h1 h2
      exact ⟨h1, h2⟩
    · exact ⟨x₀, fun ρ h1 h2 hg => hg.1 a hz ⟨h1, h2⟩⟩
  have hCp : ∀ ρ₁ ρ₂ : ↥W, ρ₁ ∈ IsLocalRing.maximalIdeal ↥W → ρ₁ ≠ 0 → ρ₁ ∣ ρ₂ →
      (∀ a ∈ Cr, a ≠ 0 → ¬ (ρ₁ ∣ a ∧ a ∣ ρ₂)) →
      ∃ x, ∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 →
        (ρ₁ ∣ ρ ∧ ρ ∣ ρ₂) → gen x ρ → good x ρ := by
    intro ρ₁ ρ₂ h1 h2 h3 hno
    by_cases h1g : ρ₁ ∣ g
    · have hg2 : ¬ g ∣ ρ₂ := fun h => hno g List.mem_cons_self hg0 ⟨h1g, h⟩
      have h2g : ρ₂ ∣ g := (ValuationRing.dvd_total ρ₂ g).resolve_right hg2
      have hρ₂m : ρ₂ ∈ IsLocalRing.maximalIdeal ↥W := by
        obtain ⟨c, hc⟩ := h3
        rw [hc]
        exact Ideal.mul_mem_right _ _ h1
      have hρ₂0 : ρ₂ ≠ 0 := by
        rintro rfl
        exact hg2 (dvd_zero g)
      have hI₁ : wcFrmInt W g ρ₁ := ⟨h1, h2, h1g, fun h => hg2 (h.trans h3)⟩
      have hI₂ : wcFrmInt W g ρ₂ := ⟨hρ₂m, hρ₂0, h2g, hg2⟩
      apply hmem
      apply wcFrm_compact_piece Ω W hW hWt ℓ hℓ hchar A K L 𝔭 u v g hPD hdeg α f₀ hα1 hf₀ O hO
        k1₀ k2₀ Z₀ Y₀ d₀ e₀ hR₀ ρ₁ ρ₂ hI₁ hI₂ h3
      intro z hz hzI
      exact hno z (List.mem_cons_of_mem _ (List.mem_filter.mpr ⟨hz, decide_eq_true hzI⟩)) hzI.2.1
    · refine ⟨x₀, fun ρ _ _ hreg _ hInt => ?_⟩
      exact absurd (hreg.1.trans hInt.2.2.1) h1g
  obtain ⟨N, xs, hxs⟩ := wcFrf_cover W hW hWt gen good Cr hCrm hZ0 hRt hLf hPt hCp
  refine ⟨N, fun i => (xs i).H, fun i => (xs i).k1, fun i => (xs i).k2, fun i => (xs i).Z,
    fun i => (xs i).Y, fun i => (xs i).d, fun i => (xs i).e, fun i => (xs i).rep, ?_⟩
  intro ρ hρ hρ0 hρg hgρ hgen
  obtain ⟨i, hi⟩ := hxs ρ hρ hρ0 (fun i => ⟨hgen i, fun h => hgρ h.2⟩)
  exact ⟨i, hi ⟨hρ, hρ0, hρg, hgρ⟩⟩

theorem wcLlsASmc_frf_cell_select : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (ℓ : ℕ) (A : Type u) [CommRing A] [Algebra ↥W A]
    (K : Type u) [Field K] [Algebra A K] (𝔭 : Ideal A) (u : A) (g : ↥W) (f₀ : K) (N : ℕ)
    (Hf : Fin N → K) (k1 k2 : Fin N → ↥W) (Zf Yf : Fin N → List ↥W) (df ef : Fin N → A),
    (∀ i, k1 i ≠ 0 ∧ k2 i ≠ 0 ∧ df i ∉ 𝔭 ∧ ef i ∉ 𝔭 ∧
        algebraMap A K (df i) * algebraMap A K (algebraMap ↥W A (k2 i)) *
            ((Yf i).map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod *
            (f₀ - (Hf i ^ ℓ - Hf i)) =
          algebraMap A K (algebraMap ↥W A (k1 i)) *
            ((Zf i).map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod *
            algebraMap A K (ef i)) →
    (∀ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W → ρ ≠ 0 → ρ ∣ g → ¬ g ∣ ρ →
        (∀ i, ∀ z ∈ Zf i ++ Yf i, ¬ (ρ ∣ z ∧ z ∣ ρ)) →
        ∃ i, (let P : List ↥W → ↥W := fun X =>
                (X.filter (fun x => @decide (¬ ρ ∣ x) (Classical.propDecidable _))).prod *
                  ρ ^ (X.filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length
              let m : ℤ :=
                (((Zf i).filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length : ℤ) -
                (((Yf i).filter (fun x => @decide (ρ ∣ x) (Classical.propDecidable _))).length : ℤ)
              k2 i * P (Yf i) ∣ k1 i * P (Zf i) ∨ ¬ (ℓ : ℤ) ∣ m)) →
    ∃ T : Finset ↥W, ∀ β b : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → β ∣ b → ¬ b ∣ β → b ∣ g →
      (∀ τ ∈ T, ¬ ((β ∣ τ ∧ ¬ τ ∣ β) ∧ (τ ∣ b ∧ ¬ b ∣ τ))) →
      ∃ (h : K) (κ₁ κ₂ : ↥W) (Z Y : List ↥W) (d ε : A), κ₁ ≠ 0 ∧ κ₂ ≠ 0 ∧ d ∉ 𝔭 ∧ ε ∉ 𝔭 ∧
        (∀ z ∈ Z ++ Y, ¬ ((β ∣ z ∧ ¬ z ∣ β) ∧ (z ∣ b ∧ ¬ b ∣ z))) ∧
        algebraMap A K d * algebraMap A K (algebraMap ↥W A κ₂) *
            (Y.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod * (f₀ - (h ^ ℓ - h)) =
          algebraMap A K (algebraMap ↥W A κ₁) *
            (Z.map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod * algebraMap A K ε ∧
        (let PB : List ↥W → ↥W := fun X =>
            (X.filter (fun x => @decide (¬ b ∣ x) (Classical.propDecidable _))).prod *
              β ^ (X.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length
          let PR : List ↥W → ↥W := fun X =>
            (X.filter (fun x => @decide (¬ b ∣ x) (Classical.propDecidable _))).prod *
              b ^ (X.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length
          let m : ℤ := ((Z.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length : ℤ) -
            ((Y.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length : ℤ)
          (κ₂ * PB Y ∣ κ₁ * PB Z ∧ κ₂ * PR Y ∣ κ₁ * PR Z) ∨
            (¬ (ℓ : ℤ) ∣ m ∧
              ((0 < m ∧ κ₁ * PR Z ∣ κ₂ * PR Y) ∨ (m < 0 ∧ κ₁ * PB Z ∣ κ₂ * PB Y)))) :=
by
  intro Ω _ _ W ℓ A _ _ K _ _ 𝔭 u g f₀ N Hf k1 k2 Zf Yf df ef hrep hgood
  classical

  have hroot : ∀ (q : ↥W) (n : ℕ), 0 < n → ∃ τ : ↥W, τ ^ n = q := by
    intro q n hn
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (q : Ω) hn
    by_cases hzW : z ∈ W
    · refine ⟨⟨z, hzW⟩, Subtype.ext ?_⟩
      simpa using hz
    · exfalso
      have hinv : z⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left hzW
      have hz0 : z ≠ 0 := fun h => hzW (by rw [h]; exact W.zero_mem)
      obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
      have e : z = (q : Ω) * z⁻¹ ^ k := by
        rw [← hz, pow_succ, inv_pow, mul_comm (z ^ k) z, mul_assoc,
          mul_inv_cancel₀ (pow_ne_zero _ hz0), mul_one]
      apply hzW
      rw [e]
      exact mul_mem q.2 (pow_mem hinv k)

  have hcore : ∀ (A B : ↥W) (g m : ℕ), ∃ τ : ↥W, ∀ x y : ↥W, x ∣ y →
      ¬ ((x ∣ τ ∧ ¬ τ ∣ x) ∧ (τ ∣ y ∧ ¬ y ∣ τ)) →
      ((B * x ^ g ∣ A * x ^ (g + m) ∧ B * y ^ g ∣ A * y ^ (g + m)) ∨
       (A * x ^ (g + m) ∣ B * x ^ g ∧ A * y ^ (g + m) ∣ B * y ^ g)) := by
    intro A B g m
    rcases ValuationRing.dvd_total B A with hBA | hAB
    · refine ⟨0, fun x y _ _ => Or.inl ⟨?_, ?_⟩⟩ <;>
        rw [pow_add, ← mul_assoc] <;> exact Dvd.dvd.mul_right (mul_dvd_mul_right hBA _) _
    · obtain ⟨q, rfl⟩ := hAB
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        refine ⟨0, fun x y _ _ => Or.inr ⟨?_, ?_⟩⟩ <;>
          simp only [add_zero] <;> exact mul_dvd_mul_right (dvd_mul_right _ _) _
      · obtain ⟨τ, hτ⟩ := hroot q m hm
        have hpos : ∀ z : ↥W, τ ∣ z → A * q * z ^ g ∣ A * z ^ (g + m) := by
          intro z hz
          have h1 : q ∣ z ^ m := by rw [← hτ]; exact pow_dvd_pow_of_dvd hz m
          rw [pow_add]
          calc A * q * z ^ g = A * z ^ g * q := by ring
            _ ∣ A * z ^ g * z ^ m := mul_dvd_mul_left _ h1
            _ = A * (z ^ g * z ^ m) := by ring
        have hneg : ∀ z : ↥W, z ∣ τ → A * z ^ (g + m) ∣ A * q * z ^ g := by
          intro z hz
          have h1 : z ^ m ∣ q := by rw [← hτ]; exact pow_dvd_pow_of_dvd hz m
          rw [pow_add]
          calc A * (z ^ g * z ^ m) = A * z ^ g * z ^ m := by ring
            _ ∣ A * z ^ g * q := mul_dvd_mul_left _ h1
            _ = A * q * z ^ g := by ring
        refine ⟨τ, fun x y hxy hbt => ?_⟩
        by_cases hτx : τ ∣ x
        · exact Or.inl ⟨hpos x hτx, hpos y (hτx.trans hxy)⟩
        · have hxτ : x ∣ τ := (ValuationRing.dvd_total x τ).resolve_right hτx
          have hyτ : y ∣ τ := by
            by_contra hyτ
            have hτy : τ ∣ y := (ValuationRing.dvd_total τ y).resolve_right hyτ
            exact hbt ⟨⟨hxτ, hτx⟩, hτy, hyτ⟩
          exact Or.inr ⟨hneg x hxτ, hneg y hyτ⟩

  have hsign : ∀ (N₁ N₂ : ↥W) (fZ fY : ℕ), ∃ τ : ↥W, ∀ x y : ↥W, x ∣ y →
      ¬ ((x ∣ τ ∧ ¬ τ ∣ x) ∧ (τ ∣ y ∧ ¬ y ∣ τ)) →
      ((N₂ * x ^ fY ∣ N₁ * x ^ fZ ∧ N₂ * y ^ fY ∣ N₁ * y ^ fZ) ∨
       (N₁ * x ^ fZ ∣ N₂ * x ^ fY ∧ N₁ * y ^ fZ ∣ N₂ * y ^ fY)) := by
    intro N₁ N₂ fZ fY
    rcases le_total fY fZ with h | h
    · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le h
      exact hcore N₁ N₂ fY m
    · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le h
      obtain ⟨τ, hτ⟩ := hcore N₂ N₁ fZ m
      exact ⟨τ, fun x y hxy hbt => (hτ x y hxy hbt).symm⟩

  have h3 : ∀ (N₁ N₂ : ↥W) (fZ fY : ℕ) (x ρ y : ↥W), N₁ ≠ 0 → N₂ ≠ 0 → x ≠ 0 → ρ ≠ 0 →
      y ≠ 0 → ¬ ρ ∣ x → ¬ y ∣ ρ →
      N₁ * x ^ fZ ∣ N₂ * x ^ fY → N₁ * y ^ fZ ∣ N₂ * y ^ fY → N₂ * ρ ^ fY ∣ N₁ * ρ ^ fZ →
      (N₂ * x ^ fY ∣ N₁ * x ^ fZ ∧ N₂ * y ^ fY ∣ N₁ * y ^ fZ) := by
    intro N₁ N₂ fZ fY x ρ y hN₁ hN₂ hx0 hρ0 hy0 hρx hyρ hx hy hρ
    rcases le_total fY fZ with h | h
    · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le h
      have hρ' : N₂ ∣ N₁ * ρ ^ m := by
        have e : N₂ * ρ ^ fY ∣ N₁ * ρ ^ m * ρ ^ fY := by
          have : N₁ * ρ ^ (fY + m) = N₁ * ρ ^ m * ρ ^ fY := by ring
          rw [← this]; exact hρ
        exact (mul_dvd_mul_iff_right (pow_ne_zero _ hρ0)).mp e
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        simp only [pow_zero, mul_one, add_zero] at hρ' ⊢
        exact ⟨mul_dvd_mul_right hρ' _, mul_dvd_mul_right hρ' _⟩
      · exfalso
        have hy' : N₁ * y ^ m ∣ N₂ := by
          have e : N₁ * y ^ m * y ^ fY ∣ N₂ * y ^ fY := by
            have : N₁ * y ^ (fY + m) = N₁ * y ^ m * y ^ fY := by ring
            rw [← this]; exact hy
          exact (mul_dvd_mul_iff_right (pow_ne_zero _ hy0)).mp e
        have : y ^ m ∣ ρ ^ m := (mul_dvd_mul_iff_left hN₁).mp (hy'.trans hρ')
        exact hyρ ((IsIntegrallyClosed.pow_dvd_pow_iff hm.ne').mp this)
    · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le h
      have hρ' : N₂ * ρ ^ m ∣ N₁ := by
        have e : N₂ * ρ ^ m * ρ ^ fZ ∣ N₁ * ρ ^ fZ := by
          have : N₂ * ρ ^ (fZ + m) = N₂ * ρ ^ m * ρ ^ fZ := by ring
          rw [← this]; exact hρ
        exact (mul_dvd_mul_iff_right (pow_ne_zero _ hρ0)).mp e
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        simp only [pow_zero, mul_one, add_zero] at hρ' ⊢
        exact ⟨mul_dvd_mul_right hρ' _, mul_dvd_mul_right hρ' _⟩
      · exfalso
        have hx' : N₁ ∣ N₂ * x ^ m := by
          have e : N₁ * x ^ fZ ∣ N₂ * x ^ m * x ^ fZ := by
            have : N₂ * x ^ (fZ + m) = N₂ * x ^ m * x ^ fZ := by ring
            rw [← this]; exact hx
          exact (mul_dvd_mul_iff_right (pow_ne_zero _ hx0)).mp e
        have : ρ ^ m ∣ x ^ m := (mul_dvd_mul_iff_left hN₂).mp (hρ'.trans hx')
        exact hρx ((IsIntegrallyClosed.pow_dvd_pow_iff hm.ne').mp this)

  have hmid : ∀ β b : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → b ≠ 0 → β ∣ b →
      ¬ b ∣ β → b ∣ g → ∃ ρ : ↥W, ρ ∈ IsLocalRing.maximalIdeal ↥W ∧ ρ ≠ 0 ∧ β ∣ ρ ∧ ¬ ρ ∣ β ∧
        ρ ∣ b ∧ ¬ b ∣ ρ ∧ ρ ∣ g ∧ ¬ g ∣ ρ := by
    intro β b hβm hβ0 hb0 hβb hbβ hbg
    obtain ⟨ρ, hρ⟩ := hroot (β * b) 2 two_pos
    have h2 : (2 : ℕ) ≠ 0 := two_ne_zero
    have hρ0 : ρ ≠ 0 := by
      rintro rfl
      rw [zero_pow h2] at hρ
      exact mul_ne_zero hβ0 hb0 hρ.symm
    have hβρ : β ∣ ρ := (IsIntegrallyClosed.pow_dvd_pow_iff h2).mp
      (by rw [hρ, sq]; exact mul_dvd_mul_left β hβb)
    have hρb : ρ ∣ b := (IsIntegrallyClosed.pow_dvd_pow_iff h2).mp
      (by rw [hρ, sq]; exact mul_dvd_mul_right hβb b)
    have hbρ : ¬ b ∣ ρ := by
      intro hbρ
      have : b ^ 2 ∣ ρ ^ 2 := pow_dvd_pow_of_dvd hbρ 2
      rw [hρ, sq] at this
      exact hbβ ((mul_dvd_mul_iff_right hb0).mp this)
    refine ⟨ρ, ?_, hρ0, hβρ, ?_, hρb, hbρ, hρb.trans hbg, fun h => hbρ (hbg.trans h)⟩
    · obtain ⟨k, hk⟩ := hβρ
      rw [hk]
      exact Ideal.mul_mem_right k _ hβm
    · intro hρβ
      have : ρ ^ 2 ∣ β ^ 2 := pow_dvd_pow_of_dvd hρβ 2
      rw [hρ, sq] at this
      exact hbβ ((mul_dvd_mul_iff_left hβ0).mp this)

  have hcls : ∀ (β ρ b ζ : ↥W), β ∣ ρ → ¬ ρ ∣ β → ρ ∣ b → ¬ b ∣ ρ →
      ¬ ((β ∣ ζ ∧ ¬ ζ ∣ β) ∧ (ζ ∣ b ∧ ¬ b ∣ ζ)) → ¬ (ρ ∣ ζ ∧ ζ ∣ ρ) ∧ (b ∣ ζ ↔ ρ ∣ ζ) := by
    intro β ρ b ζ hβρ hρβ hρb hbρ hn
    refine ⟨fun ⟨h1, h2⟩ => hn ⟨⟨hβρ.trans h1, fun h => hρβ (h1.trans h)⟩, h2.trans hρb,
      fun h => hbρ (h.trans h2)⟩, fun h => hρb.trans h, fun h => ?_⟩
    by_contra hbζ
    have hζb : ζ ∣ b := (ValuationRing.dvd_total ζ b).resolve_right hbζ
    exact hn ⟨⟨hβρ.trans h, fun h' => hρβ (h.trans h')⟩, hζb, hbζ⟩

  have hclose : ∀ (κ₁ κ₂ nZ nY ρ β b : ↥W) (fZ fY : ℕ),
      κ₁ * nZ ≠ 0 → κ₂ * nY ≠ 0 → β ≠ 0 → ρ ≠ 0 → b ≠ 0 → ¬ ρ ∣ β → ¬ b ∣ ρ →
      ((κ₂ * nY * β ^ fY ∣ κ₁ * nZ * β ^ fZ ∧ κ₂ * nY * b ^ fY ∣ κ₁ * nZ * b ^ fZ) ∨
       (κ₁ * nZ * β ^ fZ ∣ κ₂ * nY * β ^ fY ∧ κ₁ * nZ * b ^ fZ ∣ κ₂ * nY * b ^ fY)) →
      (κ₂ * (nY * ρ ^ fY) ∣ κ₁ * (nZ * ρ ^ fZ) ∨ ¬ (ℓ : ℤ) ∣ ((fZ : ℤ) - (fY : ℤ))) →
      ((κ₂ * (nY * β ^ fY) ∣ κ₁ * (nZ * β ^ fZ) ∧ κ₂ * (nY * b ^ fY) ∣ κ₁ * (nZ * b ^ fZ)) ∨
        (¬ (ℓ : ℤ) ∣ ((fZ : ℤ) - (fY : ℤ)) ∧
          ((0 < (fZ : ℤ) - (fY : ℤ) ∧ κ₁ * (nZ * b ^ fZ) ∣ κ₂ * (nY * b ^ fY)) ∨
           ((fZ : ℤ) - (fY : ℤ) < 0 ∧ κ₁ * (nZ * β ^ fZ) ∣ κ₂ * (nY * β ^ fY))))) := by
    intro κ₁ κ₂ nZ nY ρ β b fZ fY hN1 hN2 hβ0 hρ0 hb0 hρβ hbρ hd hg
    simp only [← mul_assoc] at hg ⊢
    rcases hd with hp | ⟨hnβ, hnb⟩
    · exact Or.inl hp
    · by_cases hl : (ℓ : ℤ) ∣ ((fZ : ℤ) - (fY : ℤ))
      · have hpρ := hg.resolve_right (not_not.mpr hl)
        exact Or.inl (h3 _ _ fZ fY β ρ b hN1 hN2 hβ0 hρ0 hb0 hρβ hbρ hnβ hnb hpρ)
      · refine Or.inr ⟨hl, ?_⟩
        rcases lt_trichotomy ((fZ : ℤ) - (fY : ℤ)) 0 with h | h | h
        · exact Or.inr ⟨h, hnβ⟩
        · exact (hl (by rw [h]; exact dvd_zero _)).elim
        · exact Or.inl ⟨h, hnb⟩

  choose τf hτf using hsign
  obtain ⟨T, hmemZ, hmemT⟩ : ∃ T : Finset ↥W, (∀ i, ∀ z ∈ Zf i ++ Yf i, z ∈ T) ∧
      (∀ (i : Fin N) (S S' F F' : List ↥W), S.Sublist (Zf i) → S'.Sublist (Yf i) →
        F.Sublist (Zf i) → F'.Sublist (Yf i) →
        τf (k1 i * S.prod) (k2 i * S'.prod) F.length F'.length ∈ T) := by
    refine ⟨Finset.univ.biUnion (fun i : Fin N => ((Zf i ++ Yf i) ++
      ((Zf i).sublists.flatMap (fun S => (Yf i).sublists.flatMap (fun S' =>
        (Zf i).sublists.flatMap (fun F => (Yf i).sublists.map (fun F' =>
          τf (k1 i * S.prod) (k2 i * S'.prod) F.length F'.length)))))).toFinset), ?_, ?_⟩
    · intro i z hz
      exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, List.mem_toFinset.mpr
        (List.mem_append_left _ hz)⟩
    · intro i S S' F F' hs1 hs2 hs3 hs4
      exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, List.mem_toFinset.mpr
        (List.mem_append_right _ (List.mem_flatMap.mpr ⟨S, List.mem_sublists.mpr hs1,
          List.mem_flatMap.mpr ⟨S', List.mem_sublists.mpr hs2,
            List.mem_flatMap.mpr ⟨F, List.mem_sublists.mpr hs3,
              List.mem_map.mpr ⟨F', List.mem_sublists.mpr hs4, rfl⟩⟩⟩⟩))⟩
  refine ⟨T, ?_⟩

  intro β b hβm hβ0 hbm hb0 hβb hbβ hbg hside
  obtain ⟨ρ, hρm, hρ0, hβρ, hρβ, hρb, hbρ, hρg, hgρ⟩ := hmid β b hβm hβ0 hb0 hβb hbβ hbg
  have hcl : ∀ j, ∀ z ∈ Zf j ++ Yf j, ¬ (ρ ∣ z ∧ z ∣ ρ) ∧ (b ∣ z ↔ ρ ∣ z) :=
    fun j z hz => hcls β ρ b z hβρ hρβ hρb hbρ (hside _ (hmemZ j z hz))
