    field_simp

  have hinjAC : Function.Injective (algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) := by
    intro p q hpq
    apply Subtype.ext
    apply (algebraMap K M).injective
    exact congrArg (fun c : ↥(integralClosure ↥(Algebra.adjoin A {s}) M) => (c : M)) hpq
  obtain ⟨𝔠₀, h0p, h0Q, h0c⟩ := wcpa_dj_llsm_scbc_normal_going_down ↥(Algebra.adjoin A {s})
    ↥(integralClosure ↥(Algebra.adjoin A {s}) M) hinjAC N₁ hICN Q inferInstance hQ 𝔟₀ h𝔟₀p h𝔟₀N
  obtain ⟨𝔠₁, h1p, h1Q, h1c⟩ := wcpa_dj_llsm_scbc_normal_going_down ↥(Algebra.adjoin A {s})
    ↥(integralClosure ↥(Algebra.adjoin A {s}) M) hinjAC N₁ hICN Q inferInstance hQ 𝔟₁ h𝔟₁p h𝔟₁N
  have hz0c0 : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      (algebraMap A ↥(Algebra.adjoin A {s}) z0) ∈ 𝔠₀ := by
