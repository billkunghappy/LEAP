  haveI : Finite H := Finite.of_equiv {a : C ≅ C // a.hom ≫ γ = γ}
    ⟨fun x => ⟨x.1, (hHmem x.1).2 x.2⟩, fun x => ⟨x.1, (hHmem x.1).1 x.2⟩,
      fun _ => rfl, fun _ => rfl⟩
  have hH : ∀ a : Aut C, a ∈ H → a.hom ≫ (γ ≫ ι) = γ ≫ ι := by
