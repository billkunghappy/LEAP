    intro r
    have h1 := hg (algebraMap (Localization.Away p) _ r)
    rw [hg₀r] at h1
    exact h1
  have hgl : ∀ t : T, g (lam t) = algebraMap V (FractionRing V) (ev t) := by
    intro t
    rw [← hcomp, hgl', hev']
  refine ⟨g, ?_, ?_, ?_, ?_⟩
  · apply s7 F V π g hdiv
    · intro v
      obtain ⟨t, rfl⟩ := hevs v
      exact ⟨lam t, hgl t⟩
    · refine ⟨lam' (IsLocalization.Away.invSelf p), ?_⟩
      rw [hgl', ← hevp, ← hev', ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf, map_one]
  · intro v
    obtain ⟨t, rfl⟩ := hevs v
    obtain ⟨c, hc⟩ := himg t
    exact ⟨c, by rw [hc, hgl]⟩
  · rw [hρp, hgl, hevp]
  · have h1 := hg ⟨xb, Algebra.self_mem_adjoin_singleton _ xb⟩
