      ∃ (h : K) (κ₁ κ₂ : ↥W) (Z Y : List ↥W) (d ε : A), κ₁ ≠ 0 ∧ κ₂ ≠ 0 ∧ d ∉ 𝔭 ∧ ε ∉ 𝔭 ∧
        (∀ z ∈ Z ++ Y, ¬ ((β ∣ z ∧ ¬ z ∣ β) ∧ (z ∣ b ∧ ¬ b ∣ z))) ∧
        algebraMap A K d * algebraMap A K (algebraMap ↥W A κ₂) *
            (Y.map (fun y => algebraMap A K (u - algebraMap ↥W A y))).prod * (f₀ - (h ^ ℓ - h)) =
          algebraMap A K (algebraMap ↥W A κ₁) *
            (Z.map (fun z => algebraMap A K (u - algebraMap ↥W A z))).prod * algebraMap A K ε ∧
        (let PB : List ↥W → ↥W := fun X =>
            (X.filter (fun x => @decide (¬ b ∣ x) (Classical.propDecidable _))).prod *
              β ^ (X.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length
          let PR : List ↥W → ↥W := fun X =>
            (X.filter (fun x => @decide (¬ b ∣ x) (Classical.propDecidable _))).prod *
              b ^ (X.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length
          let m : ℤ := ((Z.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length : ℤ) -
            ((Y.filter (fun x => @decide (b ∣ x) (Classical.propDecidable _))).length : ℤ)
          (κ₂ * PB Y ∣ κ₁ * PB Z ∧ κ₂ * PR Y ∣ κ₁ * PR Z) ∨
            (¬ (ℓ : ℤ) ∣ m ∧
              ((0 < m ∧ κ₁ * PR Z ∣ κ₂ * PR Y) ∨ (m < 0 ∧ κ₁ * PB Z ∣ κ₂ * PB Y)))) :=
by
  intro Ω _ _ W hW hWt ℓ hℓ hchar A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hSolv hUniq hBR
    hdeg α f₀ hα1 hf₀
  obtain ⟨N, Hf, k1, k2, Zf, Yf, df, ef, hrep, hgood⟩ :=
    wcLlsASmc_frf_radial_family Ω W hW hWt ℓ hℓ hchar A K L 𝔭 u v g y hPD hSolv hUniq hBR hdeg
      α f₀ hα1 hf₀
  exact wcLlsASmc_frf_cell_select Ω W ℓ A K 𝔭 u g f₀ N Hf k1 k2 Zf Yf df ef hrep hgood

