    have hcomp : ∀ (V : ((γ ≫ ι).normalization).Opens)
        (Φ₁ Φ₂ : (γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization)
        (h₁ : V ≤ Φ₁ ⁻¹ᵁ V) (h₂ : V ≤ Φ₂ ⁻¹ᵁ V) (h₃ : V ≤ (Φ₂ ≫ Φ₁) ⁻¹ᵁ V)
        (b : Γ((γ ≫ ι).normalization, V)),
        ((Φ₂ ≫ Φ₁).appLE V V h₃).hom b = (Φ₂.appLE V V h₂).hom ((Φ₁.appLE V V h₁).hom b) := by
      intro V Φ₁ Φ₂ h₁ h₂ h₃ b
      rw [← Scheme.Hom.appLE_comp_appLE Φ₂ Φ₁ V V V h₁ h₂]
      rfl
    have hfix : ∀ (Φ : (γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization) (U : X.Opens)
        (h : (γ ≫ ι).fromNormalization ⁻¹ᵁ U ≤ Φ ⁻¹ᵁ ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)),
        Φ ≫ (γ ≫ ι).fromNormalization = (γ ≫ ι).fromNormalization →
        ∀ a, (Φ.appLE _ _ h).hom (((γ ≫ ι).fromNormalization.app U).hom a) =
          ((γ ≫ ι).fromNormalization.app U).hom a := by
      intro Φ U h hΦ a
      have e1 : (γ ≫ ι).fromNormalization.app U ≫ Φ.appLE _ _ h =
          (γ ≫ ι).fromNormalization.app U := by
        rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
        exact hcongr _ _ _ _ _ _ hΦ
      exact congrArg (fun φ => φ.hom a) e1
    obtain ⟨H, hHmem⟩ : ∃ H : Subgroup (Aut C), ∀ a, a ∈ H ↔ a.hom ≫ γ = γ :=
      ⟨{ carrier := {a | a.hom ≫ γ = γ}
         one_mem' := Category.id_comp γ
         mul_mem' := fun {a b} ha hb => by
           change a.hom ≫ γ = γ at ha
           change b.hom ≫ γ = γ at hb
           show (b.hom ≫ a.hom) ≫ γ = γ
           rw [Category.assoc, ha, hb]
