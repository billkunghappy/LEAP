  have hιwW : ((algebraMap B (Localization.Away w)).comp ι).comp
      ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) =
