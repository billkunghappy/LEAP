    have hc : ∀ (α r : ↥W), θ α (algebraMap ↥W B r) = r := fun α r => AlgHom.commutes (θ α) r
    have hS : ∀ α : ↥W, ∑ k ∈ Finset.range (n + 1), θ α (a k) * α ^ k = 0 := by
