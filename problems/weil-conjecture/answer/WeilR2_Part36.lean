  have e₂ := hTR ρ' hρ2' V₂ g₂ hyV₂ hσg₂ hnd₂

  obtain ⟨ht00, hρ0, hns⟩ := hCL (Limits.pullback.snd rb U.ι) T _ U' t hCH ρ e₁
  obtain ⟨-, hρ0', hns'⟩ := hCL (Limits.pullback.snd rb U.ι) T _ U' t hCH ρ' e₂

  have hρρ' := hPU (Limits.pullback.snd rb U.ι) (U' 0) (hCH.2.1 0)
    ((Limits.pullback.snd rb U.ι).appLE ⊤ (U' 0) (by simp)).hom
    (hgermLE (Limits.pullback.snd rb U.ι) (U' 0)) (t 0) ht00 (hCH.2.2.2.2.1 0)
    ρ ρ' hρ0 hρ0' (hρ2.trans hρ2'.symm) hns hns'
