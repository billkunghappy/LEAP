        (𝔓.comap ((Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q)))).comp
          (algebraMap C (Localization.AtPrime Q))) = Q → ∀ ξ, ¬ IsUnit ξ → ξ ∈ 𝔓)) := by
    intro C _ Q _ J hJQ
    have hJ'm : J.map (algebraMap C (Localization.AtPrime Q)) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q (Localization.AtPrime Q)]
      exact Ideal.map_mono hJQ
    have hJ'ne : J.map (algebraMap C (Localization.AtPrime Q)) ≠ ⊤ :=
      ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top hJ'm
    haveI : Nontrivial (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) :=
      Ideal.Quotient.nontrivial_iff.mpr hJ'ne
    refine ⟨IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective, ?_, ?_, ?_⟩
    · intro hrad
      apply (Ideal.isRadical_iff_quotient_reduced _).mp
      show (J.map (algebraMap C (Localization.AtPrime Q))).radical ≤ _
      rw [← IsLocalization.map_radical Q.primeCompl]
      exact Ideal.map_mono hrad
    · intro 𝔠 h𝔠 hJ𝔠 h𝔠Q
      have hdisj : Disjoint (Q.primeCompl : Set C) (𝔠 : Set C) := by
        rw [Set.disjoint_left]
        intro a ha ha'
        exact ha (h𝔠Q ha')
      haveI h𝔠' : (𝔠.map (algebraMap C (Localization.AtPrime Q))).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint Q.primeCompl _ 𝔠 h𝔠 hdisj
      have hcomap : (𝔠.map (algebraMap C (Localization.AtPrime Q))).comap
          (algebraMap C (Localization.AtPrime Q)) = 𝔠 :=
        IsLocalization.comap_map_of_isPrime_disjoint Q.primeCompl _ h𝔠 hdisj
      have hle : J.map (algebraMap C (Localization.AtPrime Q)) ≤
          𝔠.map (algebraMap C (Localization.AtPrime Q)) := Ideal.map_mono hJ𝔠
      refine ⟨(𝔠.map (algebraMap C (Localization.AtPrime Q))).map
        (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q)))), ?_, ?_⟩
      · apply Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        rw [Ideal.mk_ker]
        exact hle
      · intro c
        rw [Ideal.mem_quotient_iff_mem hle, ← Ideal.mem_comap, hcomap]
    · intro 𝔓 h𝔓
      have h𝔓' : (𝔓.comap (Ideal.Quotient.mk
          (J.map (algebraMap C (Localization.AtPrime Q))))).IsPrime :=
        Ideal.comap_isPrime _ _
      have hle : 𝔓.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q)))) ≤
          IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
        IsLocalRing.le_maximalIdeal h𝔓'.ne_top
      have hcc : 𝔓.comap ((Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q)))).comp
          (algebraMap C (Localization.AtPrime Q))) =
          (𝔓.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q))))).comap
            (algebraMap C (Localization.AtPrime Q)) := (Ideal.comap_comap _ _).symm
      refine ⟨?_, ?_⟩
      · rw [hcc]
        calc _ ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
              (algebraMap C (Localization.AtPrime Q)) := Ideal.comap_mono hle
          _ = Q := IsLocalization.AtPrime.comap_maximalIdeal _ _
      · intro hQ' ξ hξ
        rw [hcc] at hQ'
        have hmax : 𝔓.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q)))) =
            IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
          have h1 := IsLocalization.map_comap Q.primeCompl (Localization.AtPrime Q)
            (𝔓.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q)))))
          rw [← h1]
          show Ideal.map (algebraMap C (Localization.AtPrime Q))
            ((𝔓.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q))))).comap
              (algebraMap C (Localization.AtPrime Q))) = _
          rw [hQ', IsLocalization.AtPrime.map_eq_maximalIdeal Q]
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective ξ
        by_contra hn
        apply hξ
        have ha : a ∉ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
          rw [← hmax]
          exact hn
        exact ((IsLocalRing.mem_maximalIdeal a).not.mp ha |> not_not.mp).map _

  have hshape' : (∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨ (∃ v g, k = .ann z0 v g ∧ b₁ ∣ g) := by
    rcases hshape with ⟨t, c, h1, h2, h3⟩ | ⟨u', v, g, h1, h2, h3⟩
    · exact Or.inl ⟨t, c, h1, h2, h3⟩
    · rw [h3]; exact Or.inr ⟨v, g, h1, h2⟩
  obtain ⟨N₁, hN₁⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}), N =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) := ⟨_, rfl⟩
  rw [← hN₁] at hQ
  have hNne : N₁ ≠ ⊤ := by
    rw [← hQ]; exact Ideal.IsPrime.ne_top (Ideal.comap_isPrime _ _)
  haveI hNmax : N₁.IsMaximal := by
    rw [hN₁]
    exact wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 k z0 b₁ hPD hshape' hb₁m hb₁0 s hs
      (by rw [← hN₁]; exact hNne)

  obtain ⟨_hdomN, hICN, hpres⟩ := wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 k z0 b₁ hPD
    hshape' hb₁m hb₁0 s hs N₁ hN₁
  obtain ⟨P, _, eP, heP⟩ := wcNd_hens_exists (Localization.AtPrime N₁)
    (IsLocalRing.maximalIdeal (Localization.AtPrime N₁))
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  obtain ⟨f, hfpres, hf0, hf1⟩ := hpres P eP heP
  obtain ⟨hB1p, hB1x0, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt P _ b₁ f hfpres
  obtain ⟨f', hf'pres, hf'0, hf'1⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P _ b₁ f hfpres
  obtain ⟨hB0p, hB0x1, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt P _ b₁ f' hf'pres
  rw [hf'1] at hB0p
  rw [hf'0, hf'1] at hB0x1
  rw [hf1] at hB1p
  rw [hf0, hf1] at hB1x0
  rw [hf0] at hB0p
  rw [hf0, hf1] at hB0x1
  have contract : ∀ (𝔅 : Ideal P), 𝔅.IsPrime → ∀ (a b : ↥(Algebra.adjoin A {s})),
      eP (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N₁) a) ∈ 𝔅 →
      eP (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N₁) b) ∉ 𝔅 →
      (IsLocalRing.maximalIdeal ↥W).map (eP.comp
        ((algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N₁)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))) ≤ 𝔅 →
      ∃ 𝔟 : Ideal ↥(Algebra.adjoin A {s}), 𝔟.IsPrime ∧ 𝔟 ≤ N₁ ∧
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≤ 𝔟 ∧
        a ∈ 𝔟 ∧ b ∉ 𝔟 := by
    intro 𝔅 h𝔅 a b ha hb hm
    haveI := h𝔅
    refine ⟨𝔅.comap (eP.comp (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N₁))),
      Ideal.comap_isPrime _ _, ?_, ?_, ha, hb⟩
    · intro x hx
      by_contra hxN
      have hu : IsUnit (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N₁) x) :=
        IsLocalization.map_units (Localization.AtPrime N₁) (⟨x, hxN⟩ : N₁.primeCompl)
      exact h𝔅.ne_top (Ideal.eq_top_of_isUnit_mem _
        (show eP (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N₁) x) ∈ 𝔅 from hx)
        (hu.map eP))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hm (Ideal.mem_map_of_mem _ hw)
  obtain ⟨𝔟₀, h𝔟₀p, h𝔟₀N, h𝔟₀m, hz𝔟₀, hs𝔟₀⟩ := contract _ hB0p
    (algebraMap A ↥(Algebra.adjoin A {s}) z0) ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩
    (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))) hB0x1 le_sup_right
  obtain ⟨𝔟₁, h𝔟₁p, h𝔟₁N, h𝔟₁m, hs𝔟₁, hz𝔟₁⟩ := contract _ hB1p
    ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ (algebraMap A ↥(Algebra.adjoin A {s}) z0)
    (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))) hB1x0 le_sup_right

  have hz0K : algebraMap A K z0 ≠ 0 := by
    intro h
    apply hz𝔟₁
    have : algebraMap A ↥(Algebra.adjoin A {s}) z0 = 0 := by
      apply Subtype.ext
      show algebraMap A K z0 = 0
      exact h
    rw [this]
    exact Ideal.zero_mem _
  have hA1eq : algebraMap A ↥(Algebra.adjoin A {s}) z0 *
      ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ =
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A b₁) := by
    apply Subtype.ext
    show algebraMap A K z0 * s = algebraMap A K (algebraMap ↥W A b₁)
