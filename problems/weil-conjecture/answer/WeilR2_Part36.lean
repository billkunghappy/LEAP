      exact Category.id_comp _
    · exact hρν 1
    · exact Category.id_comp _
  have hρmul : ∀ g h, ρ (g * h) = ρ h ≫ ρ g := by
    intro g h
    apply Scheme.Hom.normalization.hom_ext (γ ≫ ι) _ _ (γ ≫ ι).fromNormalization
    · rw [hρτ (g * h), ← Category.assoc, hρτ h, Category.assoc, hρτ g, ← Category.assoc]
      rfl
    · exact hρν _
    · rw [Category.assoc, hρν g, hρν h]
  have hρiso : ∀ g, IsIso (ρ g) := fun g =>
    ⟨⟨ρ g⁻¹, by rw [← hρmul g⁻¹ g, inv_mul_cancel, hρ1],
      by rw [← hρmul g g⁻¹, mul_inv_cancel, hρ1]⟩⟩

  obtain ⟨U, hUmem, hzU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens X)) (show (γ ≫ ι).fromNormalization z ∈ (⊤ : X.Opens) from trivial)
  have hU : IsAffineOpen U := hUmem
  have hV : IsAffineOpen ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) := hU.preimage _
  have hz : z ∈ (γ ≫ ι).fromNormalization ⁻¹ᵁ U := hzU
  have hz' : z' ∈ (γ ≫ ι).fromNormalization ⁻¹ᵁ U := by
    show (γ ≫ ι).fromNormalization z' ∈ U
    rw [← hzz]; exact hzU
  have hle : ∀ g, (γ ≫ ι).fromNormalization ⁻¹ᵁ U ≤
      ρ g ⁻¹ᵁ ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) := by
    intro g
    rw [← Scheme.Hom.comp_preimage, hρν g]

  have h1 : ∀ b, ((ρ 1).appLE _ _ (hle 1)).hom b = b := by
    intro b
    rw [hcongr (ρ 1) (𝟙 _) _ _ (hle 1) (hρ1 ▸ hle 1) hρ1]
    exact hid _ _ b
  have h2 : ∀ g h b, ((ρ (g * h)).appLE _ _ (hle (g * h))).hom b =
      ((ρ h).appLE _ _ (hle h)).hom (((ρ g).appLE _ _ (hle g)).hom b) := by
    intro g h b
    rw [hcongr (ρ (g * h)) (ρ h ≫ ρ g) _ _ (hle (g * h)) (hρmul g h ▸ hle (g * h)) (hρmul g h)]
    exact hcomp _ _ _ _ _ _ b
  have h3 : ∀ g a, ((ρ g).appLE _ _ (hle g)).hom (((γ ≫ ι).fromNormalization.app U).hom a) =
      ((γ ≫ ι).fromNormalization.app U).hom a := fun g a => hfix (ρ g) U (hle g) (hρν g) a

  have e : (γ ≫ ι) ⁻¹ᵁ U ≤ (γ ≫ ι).toNormalization ⁻¹ᵁ ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) := by
    rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization]
  have hfact : (γ ≫ ι).fromNormalization.app U ≫
      (γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U) e =
      (γ ≫ ι).app U := by
    rw [Scheme.Hom.app_eq_appLE (γ ≫ ι).fromNormalization, Scheme.Hom.appLE_comp_appLE,
      Scheme.Hom.app_eq_appLE (γ ≫ ι)]
    exact hcongr _ _ _ _ _ _ (Scheme.Hom.toNormalization_fromNormalization (γ ≫ ι))
  have tinj := htinj C X (γ ≫ ι) U hU e
  have h4 : ∀ b, (∀ g, ((ρ g).appLE _ _ (hle g)).hom b = b) →
      ∃ a, ((γ ≫ ι).fromNormalization.app U).hom a = b := by
    intro b hb
    have hbint : ((γ ≫ ι).fromNormalization.app U).hom.IsIntegralElem b :=
      IsIntegralHom.isIntegral_app _ U hU b
    have hsint : ((γ ≫ ι).app U).hom.IsIntegralElem
        (((γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
          ((γ ≫ ι) ⁻¹ᵁ U) e).hom b) := by
      obtain ⟨p, hpm, hp⟩ := hbint
      refine ⟨p, hpm, ?_⟩
      rw [← hfact, CommRingCat.hom_comp, ← Polynomial.hom_eval₂, hp, map_zero]
    have hσle : ∀ g : H, (γ ≫ ι) ⁻¹ᵁ U ≤ (g : Aut C).hom ⁻¹ᵁ ((γ ≫ ι) ⁻¹ᵁ U) := by
      intro g
      rw [← Scheme.Hom.comp_preimage, hH g g.2]
    have hsfix : ∀ g : H, ((g : Aut C).hom.appLE ((γ ≫ ι) ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U) (hσle g)).hom
        (((γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
          ((γ ≫ ι) ⁻¹ᵁ U) e).hom b) =
        ((γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
          ((γ ≫ ι) ⁻¹ᵁ U) e).hom b := by
      intro g
      have e2 : (γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
            ((γ ≫ ι) ⁻¹ᵁ U) e ≫
            (g : Aut C).hom.appLE ((γ ≫ ι) ⁻¹ᵁ U) ((γ ≫ ι) ⁻¹ᵁ U) (hσle g) =
          (ρ g).appLE _ _ (hle g) ≫
            (γ ≫ ι).toNormalization.appLE ((γ ≫ ι).fromNormalization ⁻¹ᵁ U)
              ((γ ≫ ι) ⁻¹ᵁ U) e := by
        rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
        exact hcongr _ _ _ _ _ _ (hρτ g).symm
      have e3 := congrArg (fun φ => φ.hom b) e2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [e3, hb g]
    obtain ⟨r, hr⟩ := hinv U hU _ hsint (fun a h => hsfix ⟨a, (hHmem a).2 h⟩)
    refine ⟨r, tinj ?_⟩
    rw [← hr, ← hfact]
    rfl

  have hcontr : (hV.primeIdealOf ⟨z, hz⟩).asIdeal.comap ((γ ≫ ι).fromNormalization.app U).hom =
      (hV.primeIdealOf ⟨z', hz'⟩).asIdeal.comap ((γ ≫ ι).fromNormalization.app U).hom := by
    have hinj : Function.Injective hU.fromSpec :=
      hU.fromSpec.isOpenEmbedding.isEmbedding.injective
    have heq := hinj ((hgen _ _ (γ ≫ ι).fromNormalization U hU _ hV le_rfl z hz).trans
      (hzz.trans (hgen _ _ (γ ≫ ι).fromNormalization U hU _ hV le_rfl z' hz').symm))
    have := congrArg PrimeSpectrum.asIdeal heq
    rw [Scheme.Hom.app_eq_appLE]
    exact this

  obtain ⟨g, hg⟩ := s1 _ _ H _ (fun g => ((ρ g).appLE _ _ (hle g)).hom) h1 h2 h3 h4
    (hV.primeIdealOf ⟨z, hz⟩).asIdeal (hV.primeIdealOf ⟨z', hz'⟩).asIdeal
    (PrimeSpectrum.isPrime _) (PrimeSpectrum.isPrime _) hcontr

  have hp : (Spec.map ((ρ g).appLE _ _ (hle g))) (hV.primeIdealOf ⟨z, hz⟩) =
      hV.primeIdealOf ⟨z', hz'⟩ :=
    (Spec.map_apply _ _).trans (PrimeSpectrum.ext hg.symm)
  have hpt : (ρ g) z = z' :=
    (hgen _ _ (ρ g) _ hV _ hV (hle g) z hz).symm.trans
      ((congrArg (fun p => hV.fromSpec p) hp).trans (hV.fromSpec_primeIdealOf ⟨z', hz'⟩))
  exact ⟨ρ g, hρiso g, hρν g, hpt⟩

theorem wcpa_dj_lr1k_nsr_ubc_bdry_transport : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
      wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
    wcpaDjLkModel W uX ι → ∀ x : ↥X,
    ∀ (Y : Scheme.{u}) (rY : Y ⟶ X) (ιY : wcProjK Ω 1 ⟶ Y)
      [QuasiCompact (γ ≫ ιY)] [QuasiSeparated (γ ≫ ιY)],
      ιY ≫ rY = ι → wcpaDjLkModel W (rY ≫ uX) ιY →
    ∀ A : ValuationSubring C.functionField, wcNsrBdry W (γ ≫ ι) uX x A →
    ∀ q₁ q : ↥(γ ≫ ιY).normalization,
      wcNsrCentred (γ ≫ ιY).toNormalization q₁ A →
      (γ ≫ ιY).fromNormalization q₁ = (γ ≫ ιY).fromNormalization q →
      ∃ A'' : ValuationSubring C.functionField, wcNsrBdry W (γ ≫ ι) uX x A'' ∧
        wcNsrCentred (γ ≫ ιY).toNormalization q A'' :=
by
  intro Ω _ _ W hW hWt C _ γ hcov hgal X uX ι hM x Y rY ιY _ _ hιY hMY A hA q₁ q hcA hqq
  classical

  obtain ⟨hss, hYp, hpb⟩ := hMY
  obtain ⟨hYint, hYnorm⟩ := wcpa_dj_lr1u_model_normal Ω W hW hWt Y (rY ≫ uX) ιY hss hYp hpb
  obtain ⟨hGfin, hdesc⟩ :=
    wcpa_dj_lr1k_llfi_galois_descent wcpa_dj_lr1k_llfi_fibre_count Ω C γ hcov hgal
  haveI : IsAffineHom ιY :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip inferInstance
  have hinv : ∀ U : Y.Opens, IsAffineOpen U → ∀ s : Γ(C, (γ ≫ ιY) ⁻¹ᵁ U),
      ((γ ≫ ιY).app U).hom.IsIntegralElem s →
      (∀ (a : C ≅ C) (h : a.hom ≫ γ = γ), (a.hom.appLE ((γ ≫ ιY) ⁻¹ᵁ U) ((γ ≫ ιY) ⁻¹ᵁ U)
        (by rw [← Scheme.Hom.comp_preimage, ← Category.assoc, h])).hom s = s) →
      ∃ r : Γ(Y, U), ((γ ≫ ιY).app U).hom r = s := by
    intro U hU s hsint hsfix
    have hV : IsAffineOpen (ιY ⁻¹ᵁ U) := hU.preimage ιY
    obtain ⟨t, ht⟩ := hdesc (ιY ⁻¹ᵁ U) hV s (fun a h => hsfix a h)
    have htint : (ιY.app U).hom.IsIntegralElem t := by
      obtain ⟨p, hpm, hp⟩ := hsint
      refine ⟨p, hpm, ?_⟩
      apply wcpa_dj_lr1k_llfi_cover_injective Ω C γ hcov (ιY ⁻¹ᵁ U)
      rw [map_zero, Polynomial.hom_eval₂, ← CommRingCat.hom_comp, ht]
      rw [Scheme.Hom.comp_app] at hp
      exact hp
    obtain ⟨r, hr⟩ :=
      wcpa_dj_lr1k_llfi_generic_integral Ω W hW hWt Y (rY ≫ uX) ιY hYint hYnorm hpb U hU t htint
    refine ⟨r, ?_⟩
    rw [Scheme.Hom.comp_app]
    show (γ.app (ιY ⁻¹ᵁ U)).hom ((ιY.app U).hom r) = s
    rw [hr, ht]
  obtain ⟨Ψ, hΨiso, hΨν, hΨq⟩ :=
    wcpa_dj_lr1k_llfi_norm_transitive C (wcProjK Ω 1) Y γ ιY hGfin hinv q₁ q hqq
  haveI := hΨiso

  haveI : IsFinite γ := hcov.2.2.2.1
  have PB := wcpa_dj_lr1s_normalization_generic_fibre Ω W C (γ ≫ wcProjKStr Ω 1) γ Y
    (rY ≫ uX) ιY ‹IsFinite γ› rfl hpb

  have hΨp : Ψ ≫ ((γ ≫ ιY).fromNormalization ≫ rY ≫ uX) =
      (γ ≫ ιY).fromNormalization ≫ rY ≫ uX := by
    rw [← Category.assoc, hΨν]
  have hΨp' : inv Ψ ≫ ((γ ≫ ιY).fromNormalization ≫ rY ≫ uX) =
      (γ ≫ ιY).fromNormalization ≫ rY ≫ uX := by
    rw [← hΨp, IsIso.inv_hom_id_assoc, hΨp]
  have w₁ : ((γ ≫ ιY).toNormalization ≫ Ψ) ≫ ((γ ≫ ιY).fromNormalization ≫ rY ≫ uX) =
      (γ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    simpa only [Category.assoc, hΨp] using PB.w
  have w₂ : ((γ ≫ ιY).toNormalization ≫ inv Ψ) ≫ ((γ ≫ ιY).fromNormalization ≫ rY ≫ uX) =
      (γ ≫ wcProjKStr Ω 1) ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    simpa only [Category.assoc, hΨp'] using PB.w
  let a : C ⟶ C := PB.lift _ _ w₁
  let b : C ⟶ C := PB.lift _ _ w₂
  have ha1 : a ≫ (γ ≫ ιY).toNormalization = (γ ≫ ιY).toNormalization ≫ Ψ := PB.lift_fst _ _ _
  have ha2 : a ≫ (γ ≫ wcProjKStr Ω 1) = γ ≫ wcProjKStr Ω 1 := PB.lift_snd _ _ _
  have hb1 : b ≫ (γ ≫ ιY).toNormalization = (γ ≫ ιY).toNormalization ≫ inv Ψ :=
    PB.lift_fst _ _ _
  have hb2 : b ≫ (γ ≫ wcProjKStr Ω 1) = γ ≫ wcProjKStr Ω 1 := PB.lift_snd _ _ _
  have hab : a ≫ b = 𝟙 C := by
    apply PB.hom_ext
    · rw [Category.assoc, hb1, ← Category.assoc, ha1, Category.assoc, IsIso.hom_inv_id,
        Category.comp_id, Category.id_comp]
    · rw [Category.assoc, hb2, ha2, Category.id_comp]
  have hba : b ≫ a = 𝟙 C := by
    apply PB.hom_ext
    · rw [Category.assoc, ha1, ← Category.assoc, hb1, Category.assoc, IsIso.inv_hom_id,
        Category.comp_id, Category.id_comp]
    · rw [Category.assoc, ha2, hb2, Category.id_comp]
  haveI : IsIso a := ⟨⟨b, hab, hba⟩⟩

  have hf : γ ≫ ι = (γ ≫ ιY).toNormalization ≫ (γ ≫ ιY).fromNormalization ≫ rY := by
    rw [← hιY, ← Category.assoc ((γ ≫ ιY).toNormalization),
      Scheme.Hom.toNormalization_fromNormalization, Category.assoc]
  have haf : a ≫ (γ ≫ ι) = γ ≫ ι := by
    rw [hf, ← Category.assoc a, ha1, Category.assoc, ← Category.assoc Ψ, hΨν]

  have hgen : a (genericPoint C) = genericPoint C := genericPoint_eq_of_isOpenImmersion a
  have ha : a (genericPoint C) ⤳ genericPoint C := specializes_of_eq hgen
  let σ : C.functionField →+* C.functionField :=
    (C.presheaf.stalkSpecializes ha ≫ a.stalkMap (genericPoint C)).hom

  have germNat : ∀ {Z Z' : Scheme.{u}} (g : C ⟶ Z) (g' : C ⟶ Z') (Φ : Z ⟶ Z'),
      a ≫ g' = g ≫ Φ → ∀ (z : Z) (h : g (genericPoint C) ⤳ z) (h' : g' (genericPoint C) ⤳ Φ z),
      wcLr1uGerm g' (Φ z) h' ≫ (C.presheaf.stalkSpecializes ha ≫ a.stalkMap (genericPoint C)) =
        Φ.stalkMap z ≫ wcLr1uGerm g z h := by
    intro Z Z' g g' Φ hg z h h'
    apply Spec.map_inj.mp
    apply (cancel_mono (Z'.fromSpecStalk (Φ z))).mp
    simp only [wcLr1uGerm, Spec.map_comp, Category.assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk,
      Scheme.SpecMap_stalkMap_fromSpecStalk_assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk_assoc, hg]

  have germFix : ∀ {Z : Scheme.{u}} (g : C ⟶ Z), a ≫ g = g →
      ∀ (z : Z) (h : g (genericPoint C) ⤳ z),
      wcLr1uGerm g z h ≫ (C.presheaf.stalkSpecializes ha ≫ a.stalkMap (genericPoint C)) =
        wcLr1uGerm g z h := by
    intro Z g hg z h
    apply Spec.map_inj.mp
    apply (cancel_mono (Z.fromSpecStalk z)).mp
    simp only [wcLr1uGerm, Spec.map_comp, Category.assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk,
      Scheme.SpecMap_stalkMap_fromSpecStalk_assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk_assoc, hg]

  have domTrans : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (φ : R →+* C.functionField)
      (φ' : R' →+* C.functionField) (θ : R →+* R') [IsLocalHom θ],
      (∀ r, σ (φ r) = φ' (θ r)) → wcLr1uDom φ' (A : Set C.functionField) →
      wcLr1uDom φ ((A.comap σ : ValuationSubring C.functionField) : Set C.functionField) := by
    intro R R' _ _ φ φ' θ _ hcomm hd
    obtain ⟨h1, h2⟩ := hd
    refine ⟨fun r => ?_, fun r t ht hrt => ?_⟩
    · show φ r ∈ A.comap σ
      rw [ValuationSubring.mem_comap, hcomm]
      exact h1 (θ r)
    · have ht' : σ t ∈ A := ValuationSubring.mem_comap.mp ht
      have e : φ' (θ r) * σ t = 1 := by rw [← hcomm, ← map_mul, hrt, map_one]
      exact isUnit_of_map_unit θ r (h2 (θ r) (σ t) ht' e)

  have ltIff : ∀ (B : ValuationSubring C.functionField) (z : C.functionField), z ≠ 0 →
      (B.valuation z < 1 ↔ z⁻¹ ∉ B) := by
    intro B z hz
    rw [← ValuationSubring.valuation_le_one_iff, not_le,
      Valuation.one_lt_val_iff _ (inv_ne_zero hz), inv_inv]

  obtain ⟨h, hdom⟩ := hcA
  have h' : (γ ≫ ιY).toNormalization (genericPoint C) ⤳ Ψ q₁ := by
    have e : Ψ ((γ ≫ ιY).toNormalization (genericPoint C)) =
        (γ ≫ ιY).toNormalization (genericPoint C) := by
      rw [← Scheme.Hom.comp_apply, ← ha1, Scheme.Hom.comp_apply, hgen]
    have h0 := h.map Ψ.continuous
    rw [e] at h0
    exact h0
  have E := germNat (γ ≫ ιY).toNormalization (γ ≫ ιY).toNormalization Ψ ha1 q₁ h h'
  have hcomm : ∀ r, σ ((wcLr1uGerm (γ ≫ ιY).toNormalization (Ψ q₁) h').hom r) =
      (wcLr1uGerm (γ ≫ ιY).toNormalization q₁ h).hom ((Ψ.stalkMap q₁).hom r) := fun r =>
    congrArg (fun k => k.hom r) E
  have hCq : wcNsrCentred (γ ≫ ιY).toNormalization (Ψ q₁) (A.comap σ) :=
    ⟨h', domTrans _ _ (Ψ.stalkMap q₁).hom hcomm hdom⟩
  rw [hΨq] at hCq

  obtain ⟨⟨hx, hdomx⟩, η, hη, hηx, hne, hcl, hmin, hval⟩ := hA
  have hfixx : ∀ r, σ ((wcLr1uGerm (γ ≫ ι) x hx).hom r) =
      (wcLr1uGerm (γ ≫ ι) x hx).hom (RingHom.id _ r) := fun r =>
    congrArg (fun k => k.hom r) (germFix (γ ≫ ι) haf x hx)
  refine ⟨A.comap σ, ⟨⟨hx, domTrans _ _ (RingHom.id _) hfixx hdomx⟩, η, hη, hηx, hne, hcl,
    hmin, fun s hs => ?_⟩, hCq⟩
  have hfix : σ ((wcLr1uGerm (γ ≫ ι) η hη).hom s) = (wcLr1uGerm (γ ≫ ι) η hη).hom s :=
    congrArg (fun k => k.hom s) (germFix (γ ≫ ι) haf η hη)
  have hv := hval s hs
  by_cases hg0 : (wcLr1uGerm (γ ≫ ι) η hη).hom s = 0
  · rw [hg0, map_zero]
    exact zero_lt_one
  · refine (ltIff (A.comap σ) _ hg0).mpr (fun hm => (ltIff A _ hg0).mp hv ?_)
    rw [ValuationSubring.mem_comap, map_inv₀, hfix] at hm
    exact hm

theorem wcpa_dj_lr1k_nsr_ub_cover : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1),
