    rw [← hvG β]; exact not_le.mp (fun h => H2 ((s0 b _).mpr h))
  obtain ⟨δ, δ', hδδ', hδ'e, hD, hfδ, hfδ'⟩ := s1 R d _ _ he0 g2 g3
