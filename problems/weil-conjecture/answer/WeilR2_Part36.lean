  intro Ω _ _ W ϖ hϖ p hp hn β M hdiv
  classical
  have split : ∀ n : ℕ, ∀ q : Polynomial W, q.Monic → q.natDegree = n →
      ∃ R : Multiset W, Multiset.card R = n ∧ ∀ x : W, q.eval x = (R.map (fun r => x - r)).prod := by
    intro n
    induction n with
    | zero =>
      intro q hq hd
      refine ⟨0, rfl, fun x => ?_⟩
      rw [Polynomial.eq_one_of_monic_natDegree_zero hq hd]
      simp
    | succ n ih =>
      intro q hq hd
      have hqm : (q.map (algebraMap W Ω)).Monic := hq.map _
      have hdeg : (q.map (algebraMap W Ω)).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hqm.ne_zero, hq.natDegree_map, hd]
        exact_mod_cast Nat.succ_ne_zero n
      obtain ⟨r, hr⟩ := IsAlgClosed.exists_root _ hdeg
      have hr' : Polynomial.eval₂ (algebraMap W Ω) r q = 0 := by
        rw [Polynomial.IsRoot.def, Polynomial.eval_map] at hr; exact hr
      have hint : _root_.IsIntegral W r := ⟨q, hq, hr'⟩
      obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := W) (K := Ω)).mp hint
      have hroot : q.IsRoot y := by
        show q.eval y = 0
        apply IsFractionRing.injective W Ω
        rw [map_zero, ← Polynomial.eval₂_at_apply, hy, hr']
      have hmul := Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot
      have hq'm : (q /ₘ (Polynomial.X - Polynomial.C y)).Monic := by
        apply Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C y)
        rw [hmul]; exact hq
