        φ (μ * a ^ n * ∏ z ∈ Z, (c - z) ^ (k z)) *
          (∏ z ∈ Z, (1 + φ (a / (c - z)) * ((t - φ c) / φ a)) ^ (k z)) *
          ((t - φ c) / φ a - φ ((z₀ - c) / a)) ^ n := by
    intro Ω _ L _ φ t μ c a z₀ n Z k ha hZ
    have ha' : φ a ≠ 0 := (map_ne_zero φ).mpr ha
    have h1 : t - φ z₀ = φ a * ((t - φ c) / φ a - φ ((z₀ - c) / a)) := by
      rw [map_div₀, map_sub]; field_simp; ring
    have h2 : ∀ z ∈ Z, t - φ z = φ (c - z) * (1 + φ (a / (c - z)) * ((t - φ c) / φ a)) := by
      intro z hz
      have hcz : φ (c - z) ≠ 0 := (map_ne_zero φ).mpr (hZ z hz)
      rw [map_div₀]; field_simp; rw [map_sub]; ring
    rw [h1, Finset.prod_congr rfl (fun z hz => by rw [h2 z hz])]
    simp only [mul_zpow, Finset.prod_mul_distrib, map_mul, map_zpow₀, map_prod]
    ring
  have ds_disc_facts : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
      (A : ValuationSubring L) (φ : Ω →+* L),
      (∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ↔ A.valuation (φ (b : Ω)) < 1) →
      (∀ a x : ↥W, a ≠ 0 → (a ∣ x ↔ A.valuation (φ (x : Ω)) ≤ A.valuation (φ (a : Ω)))) →
      (∀ y : Ω, y ∉ W → 1 < A.valuation (φ y)) → ∀ (t : L) (E : ↥W → ↥W → Prop),
      (∃ c a, E c a) →
      (∀ c a, E c a → c ∈ IsLocalRing.maximalIdeal ↥W ∧ a ≠ 0 ∧
        a ∈ IsLocalRing.maximalIdeal ↥W) →
      (∀ z ∈ IsLocalRing.maximalIdeal ↥W, ∀ δ ∈ IsLocalRing.maximalIdeal ↥W, δ ≠ 0 →
        ∃ c a, E c a ∧ ¬ (a ∣ δ ∧ a ∣ z - c)) →
      (∀ c a, E c a → ∃ c' : ↥W, a ∣ c' - c ∧
        A.valuation (t - φ (c' : Ω)) < A.valuation (φ (a : Ω))) →
      (∀ c a, E c a → A.valuation (t - φ (c : Ω)) ≤ A.valuation (φ (a : Ω))) ∧
      (∀ z : ↥W, (∀ c a, E c a → a ∣ z - c) → z ∈ IsLocalRing.maximalIdeal ↥W) ∧
      (∀ z z' : ↥W, (∀ c a, E c a → a ∣ z - c) → (∀ c a, E c a → a ∣ z' - c) → z = z') ∧
      (∀ z : ↥W, (∀ c a, E c a → a ∣ z - c) → ∀ y : Ω, y ≠ 0 →
        A.valuation (t - φ (z : Ω)) < A.valuation (φ y)) := by
    intro Ω _ W L _ A φ hm hdiv hout t E H1 H2 H3 H4
    have hdm : ∀ z : ↥W, (∀ c a, E c a → a ∣ z - c) → z ∈ IsLocalRing.maximalIdeal ↥W := by
      intro z hz
      obtain ⟨c₁, a₁, h1⟩ := H1
      obtain ⟨hc, -, ha⟩ := H2 c₁ a₁ h1
      obtain ⟨e, he⟩ := hz c₁ a₁ h1
      have : z = a₁ * e + c₁ := by rw [← he]; ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) hc
    have hd0 : ∀ z : ↥W, (∀ c a, E c a → a ∣ z - c) → ∀ δ : ↥W,
        δ ∈ IsLocalRing.maximalIdeal ↥W → δ ≠ 0 →
        A.valuation (t - φ (z : Ω)) < A.valuation (φ (δ : Ω)) := by
      intro z hz δ hδ hδ0
      obtain ⟨c₁, a₁, h1, hn⟩ := H3 z (hdm z hz) δ hδ hδ0
      have ha0 := (H2 c₁ a₁ h1).2.1
      have hnd : ¬ a₁ ∣ δ := fun h => hn ⟨h, hz c₁ a₁ h1⟩
      rw [hdiv a₁ δ ha0, not_le] at hnd
      obtain ⟨c', hc', hlt⟩ := H4 c₁ a₁ h1
      have hzc : a₁ ∣ z - c' := by
        have : z - c' = (z - c₁) - (c' - c₁) := by ring
        rw [this]; exact dvd_sub (hz c₁ a₁ h1) hc'
      rw [hdiv a₁ _ ha0] at hzc
      have heq : t - φ (z : Ω) = (t - φ (c' : Ω)) - φ (((z - c' : ↥W)) : Ω) := by
        push_cast; rw [map_sub]; ring
      rw [heq]
      refine lt_of_le_of_lt (Valuation.map_sub _ _ _) ?_
      exact lt_of_le_of_lt (max_le hlt.le hzc) hnd
    refine ⟨?_, hdm, ?_, ?_⟩
    · intro c a h
      obtain ⟨c', hc', hlt⟩ := H4 c a h
      have ha0 := (H2 c a h).2.1
      rw [hdiv a _ ha0] at hc'
      have heq : t - φ (c : Ω) = (t - φ (c' : Ω)) + φ (((c' - c : ↥W)) : Ω) := by
        push_cast; rw [map_sub]; ring
      rw [heq]
      exact le_trans (Valuation.map_add _ _ _) (max_le hlt.le hc')
    · intro z z' hz hz'
      by_contra hne
      have hδ0 : z - z' ≠ 0 := sub_ne_zero.mpr hne
      have hδ : z - z' ∈ IsLocalRing.maximalIdeal ↥W :=
        Ideal.sub_mem _ (hdm z hz) (hdm z' hz')
      obtain ⟨c, a, h, hn⟩ := H3 z (hdm z hz) (z - z') hδ hδ0
      apply hn
      refine ⟨?_, hz c a h⟩
      have : z - z' = (z - c) - (z' - c) := by ring
      rw [this]; exact dvd_sub (hz c a h) (hz' c a h)
    · intro z hz y hy
      obtain ⟨c₁, a₁, h1⟩ := H1
      obtain ⟨-, ha0, ha⟩ := H2 c₁ a₁ h1
      have e1 := hd0 z hz a₁ ha ha0
      have e2 := (hm a₁).mp ha
      by_cases hyW : y ∈ W
      · by_cases hym : (⟨y, hyW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W
        · have hy0 : (⟨y, hyW⟩ : ↥W) ≠ 0 := fun h => hy (congrArg Subtype.val h)
          exact hd0 z hz _ hym hy0
        · rw [hm] at hym
          exact lt_of_lt_of_le (e1.trans e2) (not_lt.mp hym)
      · exact (e1.trans e2).trans (hout y hyW)
  have ds_deep_exp_nonneg : ∀ (Ω : Type u) [Field Ω] (L : Type u) [Field L]
      (A : ValuationSubring L) (φ : Ω →+* L) (t : L) (z₀ μ : Ω) (Z₀ : Finset Ω) (k : Ω → ℤ)
      (f : L), z₀ ∈ Z₀ → μ ≠ 0 → t - φ z₀ ≠ 0 →
      (∀ y : Ω, y ≠ 0 → A.valuation (t - φ z₀) < A.valuation (φ y)) →
      f = φ μ * ∏ z ∈ Z₀, (t - φ z) ^ (k z) → A.valuation f ≤ 1 → 0 ≤ k z₀ := by
    intro Ω _ L _ A φ t z₀ μ Z₀ k f hz₀ hμ ht hinf hf hvf
    classical
    set ε := A.valuation (t - φ z₀) with hε
    have hεpos : 0 < ε := zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr ht)
    have hother : ∀ z ∈ Z₀.erase z₀, A.valuation (t - φ z) = A.valuation (φ (z₀ - z)) := by
      intro z hz
      have hne : z₀ - z ≠ 0 := sub_ne_zero.mpr (Finset.ne_of_mem_erase hz).symm
      have : t - φ z = (t - φ z₀) + φ (z₀ - z) := by rw [map_sub]; ring
      rw [this]
      exact Valuation.map_add_eq_of_lt_right _ (hinf _ hne)
    set μ'' := μ * ∏ z ∈ Z₀.erase z₀, (z₀ - z) ^ (k z) with hμ''
    have hμ''0 : μ'' ≠ 0 := by
      refine mul_ne_zero hμ ?_
      rw [Finset.prod_ne_zero_iff]
      intro z hz
      exact zpow_ne_zero _ (sub_ne_zero.mpr (Finset.ne_of_mem_erase hz).symm)
    have hvf' : A.valuation f = A.valuation (φ μ'') * ε ^ (k z₀) := by
      rw [hf, ← Finset.mul_prod_erase Z₀ _ hz₀, hμ'']
      simp only [map_mul, map_prod, map_zpow₀]
      rw [Finset.prod_congr rfl (fun z hz => by rw [hother z hz])]
      ac_rfl
    by_contra hneg
    rw [not_le] at hneg
    obtain ⟨m, hm⟩ : ∃ m : ℕ, k z₀ = -((m : ℤ) + 1) := ⟨(-(k z₀) - 1).toNat, by omega⟩
    have hε1 : ε < 1 := by
      have := hinf 1 one_ne_zero
      rwa [map_one, Valuation.map_one] at this
    have hpow : ε ^ (m + 1) ≤ ε := pow_le_of_le_one zero_le hε1.le (by omega)
    have hzp : ε ^ (k z₀) = (ε ^ (m + 1))⁻¹ := by
      rw [hm, zpow_neg]; norm_cast
    have hinv : ε⁻¹ ≤ (ε ^ (m + 1))⁻¹ := inv_anti₀ (pow_pos hεpos _) hpow
    have hlt : ε < A.valuation (φ μ'') := hinf μ'' hμ''0
    have : 1 < A.valuation f := by
      rw [hvf', hzp]
      calc (1 : _) = ε * ε⁻¹ := (mul_inv_cancel₀ hεpos.ne').symm
        _ < A.valuation (φ μ'') * ε⁻¹ := mul_lt_mul_of_pos_right hlt (inv_pos.mpr hεpos)
        _ ≤ A.valuation (φ μ'') * (ε ^ (m + 1))⁻¹ := mul_le_mul_of_nonneg_left hinv zero_le
    exact absurd hvf (not_le.mpr this)
  have ds_outside : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (L : Type u) [Field L]
      (A : ValuationSubring L) (φ : Ω →+* L),
      (∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ↔ A.valuation (φ (b : Ω)) < 1) →
      (∀ a x : ↥W, a ≠ 0 → (a ∣ x ↔ A.valuation (φ (x : Ω)) ≤ A.valuation (φ (a : Ω)))) →
      (∀ y : Ω, y ≠ 0 → A.valuation (φ y) ≠ 0) → ∀ (c a : ↥W) (z : Ω), a ≠ 0 →
      (¬ ∃ hz : z ∈ W, a ∣ (⟨z, hz⟩ : ↥W) - c) →
      ((c : Ω) - z ≠ 0 ∧ ∃ d : ↥W, d ∈ IsLocalRing.maximalIdeal ↥W ∧
        (d : Ω) = (a : Ω) / ((c : Ω) - z)) ∧
      ∀ z₀ : ↥W, a ∣ z₀ - c →
        A.valuation (φ ((c : Ω) - z)) = A.valuation (φ ((z₀ : Ω) - z)) := by
    intro Ω _ W L _ A φ hm hdiv hnz c a z ha hout
    have hcz : (c : Ω) - z ≠ 0 := by
      intro h
      have hz : z = (c : Ω) := (sub_eq_zero.mp h).symm
      apply hout
      refine ⟨hz ▸ c.2, ?_⟩
      have : (⟨z, hz ▸ c.2⟩ : ↥W) = c := Subtype.ext hz
      rw [this, sub_self]; exact dvd_zero a
    have hd : ∃ d : ↥W, d ∈ IsLocalRing.maximalIdeal ↥W ∧
        (d : Ω) = (a : Ω) / ((c : Ω) - z) := by
      by_cases hzW : z ∈ W
      · have hnd : ¬ a ∣ (⟨z, hzW⟩ : ↥W) - c := fun h => hout ⟨hzW, h⟩
        rcases ValuationRing.dvd_total a ((⟨z, hzW⟩ : ↥W) - c) with h | ⟨e, he⟩
        · exact absurd h hnd
        · have he' : (a : Ω) = (z - (c : Ω)) * (e : Ω) := by
            have := congrArg (fun x : ↥W => (x : Ω)) he
            simpa using this
          have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
            rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
            intro hu
            apply hnd
            obtain ⟨u, hu'⟩ := hu.exists_right_inv
            refine ⟨u, ?_⟩
            rw [he, mul_assoc, hu', mul_one]
          refine ⟨-e, neg_mem hem, ?_⟩
          push_cast
          rw [he']
          have : z - (c : Ω) = -((c : Ω) - z) := by ring
          rw [this]
          field_simp
      · have hczW : (c : Ω) - z ∉ W := by
          intro h
          apply hzW
          have : z = (c : Ω) - ((c : Ω) - z) := by ring
          rw [this]; exact W.sub_mem c.2 h
        have hs : ((c : Ω) - z)⁻¹ ∈ W := (W.mem_or_inv_mem _).resolve_left hczW
        have hsm : (⟨((c : Ω) - z)⁻¹, hs⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          obtain ⟨u, hu'⟩ := hu.exists_right_inv
          apply hczW
          have : ((c : Ω) - z)⁻¹ * (u : Ω) = 1 := by
            have := congrArg (fun x : ↥W => (x : Ω)) hu'
            simpa using this
          have hu2 : (u : Ω) = (c : Ω) - z := by
            field_simp at this
            rw [this]
          rw [← hu2]; exact u.2
        refine ⟨a * ⟨((c : Ω) - z)⁻¹, hs⟩, Ideal.mul_mem_left _ _ hsm, ?_⟩
        push_cast
        rw [div_eq_mul_inv]
    refine ⟨⟨hcz, hd⟩, ?_⟩
    intro z₀ hz₀
    obtain ⟨d, hdm, hdeq⟩ := hd
    have ha' : (a : Ω) = (d : Ω) * ((c : Ω) - z) := by rw [hdeq]; field_simp
    have hpos : 0 < A.valuation (φ ((c : Ω) - z)) := zero_lt_iff.mpr (hnz _ hcz)
    have hlt1 : A.valuation (φ (a : Ω)) < A.valuation (φ ((c : Ω) - z)) := by
      rw [ha', map_mul, Valuation.map_mul]
      calc A.valuation (φ (d : Ω)) * A.valuation (φ ((c : Ω) - z))
          < 1 * A.valuation (φ ((c : Ω) - z)) := mul_lt_mul_of_pos_right ((hm d).mp hdm) hpos
        _ = _ := one_mul _
    have h2 := (hdiv a _ ha).mp hz₀
    have : (z₀ : Ω) - z = ((c : Ω) - z) + (((z₀ - c : ↥W)) : Ω) := by push_cast; ring
    rw [this, map_add]
    exact (Valuation.map_add_eq_of_lt_left _ (lt_of_le_of_lt h2 hlt1)).symm
  have ds_caseI_bound : ∀ (Ω : Type u) [Field Ω] (L : Type u) [Field L] (A : ValuationSubring L)
      (φ : Ω →+* L) (μ a c z₀ δ : Ω) (n : ℤ) (Z : Finset Ω) (k : Ω → ℤ), 1 ≤ n →
      (∀ z ∈ Z, A.valuation (φ (c - z)) = A.valuation (φ (z₀ - z))) →
      μ * ∏ z ∈ Z, (z₀ - z) ^ (k z) ≠ 0 →
      A.valuation (φ (μ * ∏ z ∈ Z, (z₀ - z) ^ (k z))) * A.valuation (φ δ) ≤ 1 →
      A.valuation (φ a) < A.valuation (φ δ) → A.valuation (φ a) ≤ 1 →
      A.valuation (φ (μ * a ^ n * ∏ z ∈ Z, (c - z) ^ (k z))) < 1 := by
    intro Ω _ L _ A φ μ a c z₀ δ n Z k hn hZ hμ hb had ha1
    have e : A.valuation (φ (μ * a ^ n * ∏ z ∈ Z, (c - z) ^ (k z))) =
        A.valuation (φ (μ * ∏ z ∈ Z, (z₀ - z) ^ (k z))) * A.valuation (φ a) ^ n := by
      simp only [map_mul, map_prod, map_zpow₀]
      rw [Finset.prod_congr rfl (fun z hz => by rw [hZ z hz])]
      ac_rfl
    rw [e]
    have hpos : 0 < A.valuation (φ (μ * ∏ z ∈ Z, (z₀ - z) ^ (k z))) :=
      zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr ((map_ne_zero φ).mpr hμ))
    obtain ⟨m, hm⟩ : ∃ m : ℕ, n = ((m + 1 : ℕ) : ℤ) := ⟨(n - 1).toNat, by omega⟩
    have hp : A.valuation (φ a) ^ n ≤ A.valuation (φ a) := by
      rw [hm, zpow_natCast]
      exact pow_le_of_le_one zero_le ha1 (by omega)
    calc _ < A.valuation (φ (μ * ∏ z ∈ Z, (z₀ - z) ^ (k z))) * A.valuation (φ δ) :=
          mul_lt_mul_of_pos_left (lt_of_le_of_lt hp had) hpos
      _ ≤ 1 := hb
  have ds_factor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (L : Type u) [Field L]
      (φ : Ω →+* L) (t : L), (∀ P : Polynomial Ω, P.eval₂ φ t = 0 → P = 0) →
      ∀ (f : L) (P Q : Polynomial Ω), Q.eval₂ φ t ≠ 0 → f * Q.eval₂ φ t = P.eval₂ φ t →
      f ≠ 0 → ∃ (μ : Ω) (Z₀ : Finset Ω) (k : Ω → ℤ), μ ≠ 0 ∧ (∀ z ∈ Z₀, k z ≠ 0) ∧
        (∀ z : Ω, t - φ z ≠ 0) ∧ f = φ μ * ∏ z ∈ Z₀, (t - φ z) ^ (k z) := by
    intro Ω _ _ L _ φ t htr f P Q hQ hfPQ hf0
    classical
    have htz : ∀ z : Ω, t - φ z ≠ 0 := by
      intro z h
      apply Polynomial.X_sub_C_ne_zero z
      apply htr
      simp [h]
    have hev : ∀ (R : Polynomial Ω) (S : Finset Ω), R.roots.toFinset ⊆ S →
        R.eval₂ φ t = φ R.leadingCoeff *
          ∏ z ∈ S, (t - φ z) ^ ((R.roots.count z : ℕ) : ℤ) := by
      intro R S hS
      have h := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
        (IsAlgClosed.card_roots_eq_natDegree (k := Ω) (p := R))
      conv_lhs => rw [← h]
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
        Multiset.map_map]
      have hm : Multiset.map (Polynomial.eval₂ φ t ∘ fun a => Polynomial.X - Polynomial.C a)
          R.roots = R.roots.map (fun a => t - φ a) := by
        apply Multiset.map_congr rfl
        intro a _
        simp
      rw [hm, Finset.prod_multiset_map_count]
      congr 1
      simp only [zpow_natCast]
      apply Finset.prod_subset hS
      intro z _ hz
      rw [Multiset.count_eq_zero.mpr (fun h => hz (Multiset.mem_toFinset.mpr h)), pow_zero]
    have hQ0 : Q ≠ 0 := by rintro rfl; simp at hQ
    have hP0 : P ≠ 0 := by
      rintro rfl
      rw [Polynomial.eval₂_zero] at hfPQ
      exact mul_ne_zero hf0 hQ hfPQ
    set S := P.roots.toFinset ∪ Q.roots.toFinset with hS
    have hPe := hev P S Finset.subset_union_left
    have hQe := hev Q S Finset.subset_union_right
    set k : Ω → ℤ := fun z => ((P.roots.count z : ℕ) : ℤ) - ((Q.roots.count z : ℕ) : ℤ)
      with hk
    have hfeq : f = φ (P.leadingCoeff / Q.leadingCoeff) * ∏ z ∈ S, (t - φ z) ^ (k z) := by
      have : f = P.eval₂ φ t / Q.eval₂ φ t := by rw [← hfPQ]; field_simp
      rw [this, hPe, hQe, map_div₀, mul_div_mul_comm, ← Finset.prod_div_distrib]
      congr 1
      apply Finset.prod_congr rfl
      intro z _
      rw [hk]
      exact (zpow_sub₀ (htz z) _ _).symm
    have hlc : P.leadingCoeff / Q.leadingCoeff ≠ 0 :=
      div_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hP0)
        (Polynomial.leadingCoeff_ne_zero.mpr hQ0)
    refine ⟨_, S.filter (fun z => k z ≠ 0), k, hlc, fun z hz => (Finset.mem_filter.mp hz).2,
      htz, ?_⟩
    rw [hfeq, Finset.prod_filter_of_ne]
    intro z _ hne hkz
    exact hne (by rw [hkz, zpow_zero])
  intro Ω _ _ W L _ A φ hW t htr E H1 H2 Hch H3 H4 f P Q hQ hfPQ hvf
  classical
  obtain ⟨hm, hdiv, hout, hnz⟩ := ds_val_facts Ω W L A φ hW
  obtain ⟨hTb, hdm, huniq, hinf⟩ := ds_disc_facts Ω W L A φ hm hdiv hout t E H1 H2 H3 H4
  obtain ⟨c₁, a₁, h1⟩ := H1
  by_cases hf0 : f = 0
  · refine ⟨c₁, a₁, h1, fun c a _ _ _ => ⟨0, ∅, fun _ => 0, fun _ => 0, 0, 0, by simp, ?_,
      fun _ => Ideal.zero_mem _⟩⟩
    simp [hf0]
  obtain ⟨μ, Z₀, k, hμ, hk, htz, hf⟩ := ds_factor Ω L φ t htr f P Q hQ hfPQ hf0

  have hND : ∀ z : Ω, ∃ p : ↥W × ↥W,
      (¬ ∃ hz : z ∈ W, ∀ c a, E c a → a ∣ (⟨z, hz⟩ : ↥W) - c) →
      E p.1 p.2 ∧ ¬ ∃ hz : z ∈ W, p.2 ∣ (⟨z, hz⟩ : ↥W) - p.1 := by
    intro z
    by_cases hzW : z ∈ W
    · by_cases hD : ∀ c a, E c a → a ∣ (⟨z, hzW⟩ : ↥W) - c
      · exact ⟨(c₁, a₁), fun h => absurd ⟨hzW, hD⟩ h⟩
      · push_neg at hD
        obtain ⟨c, a, hE, hn⟩ := hD
        exact ⟨(c, a), fun _ => ⟨hE, fun ⟨_, h⟩ => hn h⟩⟩
    · exact ⟨(c₁, a₁), fun _ => ⟨h1, fun ⟨hz', _⟩ => hzW hz'⟩⟩
  choose pz hpz using hND

  have htrans : ∀ (c a : ↥W) (z : Ω), (pz z).2 ∣ a → (pz z).2 ∣ c - (pz z).1 →
      (¬ ∃ hz : z ∈ W, (pz z).2 ∣ (⟨z, hz⟩ : ↥W) - (pz z).1) →
      ¬ ∃ hz : z ∈ W, a ∣ (⟨z, hz⟩ : ↥W) - c := by
    rintro c a z h1' h2' hO ⟨hz, hd⟩
