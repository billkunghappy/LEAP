      rw [mul_comm, h1]
      exact c.2
    · rintro ⟨k, hk⟩
      refine ⟨algebraMap ↥(integralClosure A M) (Localization.Away H) ⟨_, hk⟩ *
        IsLocalization.Away.invSelf (S := Localization.Away H) H ^ k, ?_⟩
      have hinv : algebraMap (Localization.Away H) M
          (IsLocalization.Away.invSelf (S := Localization.Away H) H) * algebraMap A M (e₁ * e₂) = 1 := by
        rw [← hCMH, ← hιC, ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf, map_one]
      rw [map_mul, hιC, map_pow]
      show (algebraMap A M (e₁ * e₂) ^ k * x) * _ = x
      rw [mul_comm (algebraMap A M (e₁ * e₂) ^ k) x, mul_assoc, ← mul_pow,
        mul_comm (algebraMap A M (e₁ * e₂)), hinv, one_pow, mul_one]
  · show Ideal.comap ((algebraMap ↥(integralClosure A M) (Localization.Away H)).comp
      (algebraMap A ↥(integralClosure A M))) _ = 𝔭
    rw [← Ideal.comap_comap, hcomapz, hzc]
  · intro 𝔮' h𝔮'P h𝔮'c
    haveI := h𝔮'P
    have hz' : 𝔮'.comap (algebraMap ↥(integralClosure A M) (Localization.Away H)) = z := by
      apply hzU _ inferInstance
      rw [Ideal.comap_comap]
      exact h𝔮'c
    rw [← hz']
    exact (IsLocalization.map_comap (Submonoid.powers H) (Localization.Away H) 𝔮').symm

theorem wcpa_dj_llsm_sm_lift_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M L : Type u) [Field M] [Field L] [Algebra K M] [Algebra M L]
    [Algebra K L] [Algebra A M] [Algebra A L] [IsScalarTower A K M] [IsScalarTower K M L]
    [IsScalarTower A K L] [IsScalarTower A M L] [FiniteDimensional K L] [IsGalois K L]
    [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    [Algebra B L] [IsScalarTower B M L] [IsScalarTower A B L]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B) (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    wcLlsSolvPt W A K L 𝔭 (.disc t) y → wcLlsUniq A L 𝔭 y → Group.IsSolvable (L ≃ₐ[K] L) →
    ∃ y' : Ideal ↥(integralClosure B L),
      wcLlsSolvPt W B M L 𝔮 (.disc t') y' ∧ wcLlsUniq B L 𝔮 y' :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ M L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ B _ _ _ _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' y _hPD hSmc hSolv hUniq hGal
  classical
  obtain ⟨hS1, hS2, _hS3, hS4, hS5⟩ := hSmc
  obtain ⟨hyP, hyc, _, hyδ⟩ := hSolv


  have hδinv : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S := by
    intro R S _ _ e
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
        (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
    letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
    let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
        ↥(integralClosure S (FractionRing S)) :=
      { toFun := eI
        map_add' := map_add eI
        map_smul' := fun r a => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
          rfl }
    let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
        ↥(integralClosure R (FractionRing R)) :=
      { toFun := eI.symm
        map_add' := map_add eI.symm
        map_smul' := fun s b => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
          rfl }
    let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
    let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
    have h1 : p ≤ q.comap LeI := by
      rintro _ ⟨r, rfl⟩
      exact ⟨e r, (heI r).symm⟩
    have h2 : q ≤ p.comap LeI' := by
      rintro _ ⟨s, rfl⟩
      exact ⟨e.symm s, (heI' s).symm⟩
    let Φ := p.mapQ q LeI h1
    let Φ' := q.mapQ p LeI' h2
    let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
        (↥(integralClosure S (FractionRing S)) ⧸ q) :=
      { Φ with
        invFun := Φ'
        left_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H a =>
            show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.symm_apply_apply a)
        right_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H b =>
            show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.apply_symm_apply b) }
    let O := Submodule.orderIsoMapComap Φe
    unfold wcpaDjLkDelta
    rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
      OrderIso.map_top]

  have hAMinj : Function.Injective (algebraMap A M) := by
    rw [IsScalarTower.algebraMap_eq A K M]
    exact (algebraMap K M).injective.comp (IsFractionRing.injective A K)
  have hM0 : algebraMap A M h ≠ 0 := by
    intro h0
    apply hS1
    have : h = 0 := hAMinj (by rw [h0, map_zero])
    rw [this]; exact 𝔭.zero_mem
  have hLh : algebraMap A L h = algebraMap M L (algebraMap A M h) :=
    IsScalarTower.algebraMap_apply A M L h
  have hL0 : algebraMap A L h ≠ 0 := by
    rw [hLh]; exact (map_ne_zero _).mpr hM0

  obtain ⟨b₀, hb₀⟩ : ∃ b₀ : B, algebraMap B M b₀ = (algebraMap A M h)⁻¹ :=
    (hS2 _).mpr ⟨1, by rw [pow_one, mul_inv_cancel₀ hM0]; exact isIntegral_one⟩
  have hBL : ∀ b : B, algebraMap B L b = algebraMap M L (algebraMap B M b) :=
    fun b => IsScalarTower.algebraMap_apply B M L b
  have hb₀L : algebraMap B L b₀ = (algebraMap A L h)⁻¹ := by
    rw [hBL, hb₀, map_inv₀, ← hLh]
  have HB : ∀ x : L, IsIntegral B x ↔ ∃ k : ℕ, IsIntegral A (algebraMap A L h ^ k * x) := by
    intro x
    constructor
    · rintro ⟨p, hpm, hp⟩
      have hk : ∀ i, ∃ k : ℕ,
          IsIntegral A (algebraMap A M h ^ k * algebraMap B M (p.coeff i)) :=
        fun i => (hS2 _).mp ⟨_, rfl⟩
      choose k hk using hk
      obtain ⟨κ, hkκ⟩ : ∃ κ : ℕ, ∀ i, i ≤ p.natDegree → k i ≤ κ :=
        ⟨∑ i ∈ Finset.range (p.natDegree + 1), k i, fun i hi =>
          Finset.single_le_sum (f := k) (fun j _ => Nat.zero_le _)
            (Finset.mem_range.mpr (by omega))⟩
      have hsL : algebraMap B L (algebraMap A B h ^ κ) = algebraMap A L h ^ κ := by
        rw [map_pow, ← IsScalarTower.algebraMap_apply]
      have hq := Polynomial.scaleRoots_eval₂_eq_zero (algebraMap B L)
        (s := algebraMap A B h ^ κ) hp
      rw [hsL] at hq
      have hcoeff : ∀ i, IsIntegral A
          (((p.scaleRoots (algebraMap A B h ^ κ)).map (algebraMap B L)).coeff i) := by
        intro i
        rw [Polynomial.coeff_map, Polynomial.coeff_scaleRoots, map_mul, map_pow, hsL, ← pow_mul]
        by_cases hi : i < p.natDegree
        · have hle : k i ≤ κ * (p.natDegree - i) :=
            le_trans (hkκ i hi.le) (Nat.le_mul_of_pos_right _ (by omega))
          have e1 : algebraMap B L (p.coeff i) * algebraMap A L h ^ (κ * (p.natDegree - i)) =
              algebraMap A L h ^ (κ * (p.natDegree - i) - k i) *
                algebraMap M L (algebraMap A M h ^ k i * algebraMap B M (p.coeff i)) := by
            rw [map_mul, map_pow, ← hLh, ← hBL, ← mul_assoc, ← pow_add,
              Nat.sub_add_cancel hle, mul_comm]
          rw [e1]
          exact (isIntegral_algebraMap.pow _).mul (hk i).algebraMap
        · have hni : p.natDegree - i = 0 := by omega
          rw [hni, mul_zero, pow_zero, mul_one]
          rcases Nat.eq_or_lt_of_le (not_lt.mp hi) with hin | hin
          · rw [← hin, hpm.coeff_natDegree, map_one]; exact isIntegral_one
          · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hin, map_zero]; exact isIntegral_zero
      have hmon : ((p.scaleRoots (algebraMap A B h ^ κ)).map (algebraMap B L)).Monic :=
        ((Polynomial.monic_scaleRoots_iff _).mpr hpm).map _
      have hlift : ((p.scaleRoots (algebraMap A B h ^ κ)).map (algebraMap B L)) ∈
          Polynomial.lifts (algebraMap ↥(integralClosure A L) L) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro i
        exact ⟨⟨_, hcoeff i⟩, rfl⟩
      obtain ⟨qC, hqC, _, hqCm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
      have hC : IsIntegral ↥(integralClosure A L) (algebraMap A L h ^ κ * x) :=
        ⟨qC, hqCm, by rw [← Polynomial.eval_map, hqC, Polynomial.eval_map]; exact hq⟩
      exact ⟨κ, isIntegral_trans _ hC⟩
    · rintro ⟨k, hk⟩
      have h1 : IsIntegral B (algebraMap A L h ^ k * x) := hk.tower_top
      have h2 : IsIntegral B (algebraMap B L b₀ ^ k) := (isIntegral_algebraMap).pow k
      have h3 := h2.mul h1
      rwa [hb₀L, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ hL0, one_pow, one_mul] at h3

  let ι : ↥(integralClosure A L) →+* ↥(integralClosure B L) :=
    { toFun := fun x => ⟨(x : L), IsIntegral.tower_top (A := B) x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hιv : ∀ x, ((ι x : ↥(integralClosure B L)) : L) = (x : L) := fun _ => rfl
  have hιinj : Function.Injective ι := fun a b hab =>
    Subtype.ext (by rw [← hιv a, ← hιv b, hab])
  obtain ⟨hC, hCv⟩ : ∃ c : ↥(integralClosure A L), (c : L) = algebraMap A L h :=
    ⟨algebraMap A _ h, rfl⟩
  have hCeq : hC = algebraMap A _ h := Subtype.ext hCv

  have hinvD : IsIntegral B (algebraMap A L h)⁻¹ :=
    (HB _).mpr ⟨1, by rw [pow_one, mul_inv_cancel₀ hL0]; exact isIntegral_one⟩
  have hunit : IsUnit (ι hC) := by
    refine isUnit_iff_exists_inv.mpr ⟨⟨_, hinvD⟩, Subtype.ext ?_⟩
    show (hC : L) * (algebraMap A L h)⁻¹ = 1
    rw [hCv, mul_inv_cancel₀ hL0]

  have hsurj : ∀ z : ↥(integralClosure B L), ∃ (k : ℕ) (x : ↥(integralClosure A L)),
      ι hC ^ k * z = ι x := by
    intro z
    obtain ⟨k, hk⟩ := (HB z).mp z.2
    refine ⟨k, ⟨_, hk⟩, Subtype.ext ?_⟩
    show (hC : L) ^ k * (z : L) = algebraMap A L h ^ k * (z : L)
    rw [hCv]

  letI : Algebra ↥(integralClosure A L) ↥(integralClosure B L) := ι.toAlgebra
  haveI hloc : IsLocalization (Submonoid.powers hC) ↥(integralClosure B L) := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, n, rfl⟩
      show IsUnit (ι (hC ^ n))
      rw [map_pow]; exact hunit.pow n
    · intro z
      obtain ⟨k, x, hx⟩ := hsurj z
      refine ⟨(x, ⟨hC ^ k, k, rfl⟩), ?_⟩
      show z * ι (hC ^ k) = ι x
      rw [map_pow, mul_comm, hx]
    · intro a b hab
      exact ⟨1, by rw [hιinj hab]⟩

  have hCy : hC ∉ y := by
    intro hm
    apply hS1
    rw [← hyc, Ideal.mem_comap, ← hCeq]
    exact hm
  have hdisj : Disjoint ((Submonoid.powers hC : Submonoid _) : Set ↥(integralClosure A L))
      (y : Set ↥(integralClosure A L)) := by
    rw [Set.disjoint_left]
    rintro _ ⟨n, rfl⟩ hn
    exact hCy (hyP.mem_of_pow_mem n hn)

  haveI := hyP
  have hy'P : (y.map ι).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers hC) _ y hyP hdisj
  have hy'c : (y.map ι).comap ι = y :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers hC) _ hyP hdisj
  have huniq : ∀ y'' : Ideal ↥(integralClosure B L), y''.comap ι = y → y'' = y.map ι := by
    intro y'' h''
    rw [← h'']
    exact (IsLocalization.map_under (Submonoid.powers hC) _ y'').symm

  have htower : (algebraMap B ↥(integralClosure B L)).comp (algebraMap A B) =
      ι.comp (algebraMap A ↥(integralClosure A L)) :=
    RingHom.ext fun a => Subtype.ext (by
      show algebraMap B L (algebraMap A B a) = algebraMap A L a
      exact (IsScalarTower.algebraMap_apply A B L a).symm)
  unfold wcLlsSolvPt wcLlsUniq
  refine ⟨y.map ι, ⟨hy'P, ?_, ?_, ?_⟩, ?_⟩
  ·
    refine hS5 _ ?_ ?_
    · haveI := hy'P; exact Ideal.comap_isPrime _ _
    · rw [Ideal.comap_comap, htower, ← Ideal.comap_comap, hy'c, hyc]
  ·
    let f : ↥(wcLlsDec B M L (y.map ι)) →* (L ≃ₐ[K] L) :=
      (AlgEquiv.restrictScalarsHom K).comp (wcLlsDec B M L (y.map ι)).subtype
    have hf : Function.Injective f := fun a b hab =>
      Subtype.ext (AlgEquiv.restrictScalars_injective K hab)
    exact Group.isSolvable_of_isSolvable_injective hf
  ·
    intro _ _ _
    haveI := hy'P
    let T := Localization.AtPrime (y.map ι)
    haveI : IsScalarTower ↥(integralClosure A L) ↥(integralClosure B L) T := inferInstance
    have h0 := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Submonoid.powers hC) T (y.map ι)
    have epc : y.primeCompl =
        ((y.map ι).comap (algebraMap ↥(integralClosure A L) ↥(integralClosure B L))).primeCompl :=
      Submonoid.ext fun z => by
        rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff]
        show z ∉ y ↔ z ∉ (y.map ι).comap ι
        rw [hy'c]
    haveI hlocT : IsLocalization y.primeCompl T := by
      rw [epc]; exact h0
    let e := IsLocalization.algEquiv y.primeCompl (Localization.AtPrime y) T
    have hwAB : ∀ w : ↥W, ((algebraMap A L).comp (algebraMap ↥W A)) w =
        ((algebraMap B L).comp (algebraMap ↥W B)) w := by
      intro w
      simp only [RingHom.comp_apply]
      rw [IsScalarTower.algebraMap_apply ↥W A B w, ← IsScalarTower.algebraMap_apply A B L]
    have hSAB : ι '' {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} =
        {b : ↥(integralClosure B L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap B L).comp (algebraMap ↥W B)) w} := by
      ext b'
      constructor
      · rintro ⟨b, ⟨w, hw, hbw⟩, rfl⟩
        exact ⟨w, hw, by rw [hιv, hbw]; exact hwAB w⟩
      · rintro ⟨w, hw, hbw⟩
        refine ⟨algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w), ⟨w, hw, rfl⟩, ?_⟩
        apply Subtype.ext
        rw [hιv, hbw]
        exact hwAB w
    have hJ : Ideal.map (algebraMap ↥(integralClosure B L) T)
        (Ideal.span {b : ↥(integralClosure B L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap B L).comp (algebraMap ↥W B)) w}) =
        Ideal.map (e.toRingEquiv : Localization.AtPrime y →+* T)
          (Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
            (Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
              (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w})) := by
      rw [Ideal.map_map]
      have hcomp : (e.toRingEquiv : Localization.AtPrime y →+* T).comp
          (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)) =
          (algebraMap ↥(integralClosure B L) T).comp ι :=
        RingHom.ext fun x => (e.commutes x).trans
          (IsScalarTower.algebraMap_apply _ ↥(integralClosure B L) T x)
      rw [hcomp, ← Ideal.map_map, Ideal.map_span ι, hSAB]
    have eFS : wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ≃+*
        wcLlsFS W ((algebraMap B L).comp (algebraMap ↥W B)) B (y.map ι) := by
      unfold wcLlsFS
      exact Ideal.quotientEquiv _ _ e.toRingEquiv hJ
    rw [← hδinv _ _ eFS]
    exact hyδ hyP t rfl
  ·
    intro y'' hy''P hy''c
    apply huniq
    haveI := hy''P
    apply hUniq _ (Ideal.comap_isPrime _ _)
    rw [Ideal.comap_comap, ← htower, ← Ideal.comap_comap, hy''c, hS4]

theorem wcpa_dj_llsm_sm_point_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ θ : A →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔭 →
    ∃ θ' : B →ₐ[↥W] ↥W, (∀ x : A, θ' (algebraMap A B x) = θ x) ∧
      (IsLocalRing.maximalIdeal ↥W).comap θ' = 𝔮 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' hPD hSmc θ hθ
  classical
  obtain ⟨hh, hrange, -, -, huniq⟩ := hSmc

  have hinjAM : Function.Injective (algebraMap A M) := by
    rw [IsScalarTower.algebraMap_eq A K M]
    exact (algebraMap K M).injective.comp (IsFractionRing.injective A K)
  have hinjBM : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  have hinjAB : Function.Injective (algebraMap A B) := by
    intro x y hxy
    apply hinjAM
    rw [IsScalarTower.algebraMap_apply A B M x, IsScalarTower.algebraMap_apply A B M y, hxy]
  have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
  have hM0 : algebraMap A M h ≠ 0 := (map_ne_zero_iff _ hinjAM).mpr hh0
  have hunit : IsUnit (θ h) := by
    apply IsLocalRing.notMem_maximalIdeal.mp
    intro hm
    apply hh
    rw [← hθ]
    exact hm

  let C := integralClosure A B
  have hinjAC : Function.Injective (algebraMap A C) := by
    intro x y hxy
    apply hinjAB
    exact congrArg Subtype.val hxy

  let θr : A →+* ↥W := θ.toRingHom
  let P : Ideal A := RingHom.ker θr
  haveI hPprime : P.IsPrime := RingHom.ker_isPrime θr
  obtain ⟨Q, hQprime, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain
    (S := C) P (by
      rw [(RingHom.injective_iff_ker_eq_bot _).mp hinjAC]
      exact bot_le)
  haveI := hQprime
  haveI hLO : Q.LiesOver P := ⟨hQP.symm⟩
  letI : Algebra (A ⧸ P) (C ⧸ Q) := Ideal.Quotient.algebraOfLiesOver Q P
  haveI : Algebra.IsIntegral (A ⧸ P) (C ⧸ Q) := Ideal.Quotient.algebra_isIntegral_of_liesOver Q P
  let θb : A ⧸ P →+* ↥W := θr.kerLift
  letI : Algebra (A ⧸ P) ↥W := θb.toAlgebra
  letI : Algebra (A ⧸ P) Ω := ((algebraMap (↥W) Ω).comp θb).toAlgebra
  haveI : IsScalarTower (A ⧸ P) (↥W) Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hinjPQ : Function.Injective (algebraMap (A ⧸ P) (C ⧸ Q)) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.Quotient.algebraMap_mk_of_liesOver, Ideal.Quotient.eq_zero_iff_mem] at hx
    rw [Ideal.Quotient.eq_zero_iff_mem, ← hQP]
    exact hx
  have hinjPΩ : Function.Injective (algebraMap (A ⧸ P) Ω) :=
    (IsFractionRing.injective (↥W) Ω).comp (RingHom.kerLift_injective θr)
  haveI : Module.IsTorsionFree (A ⧸ P) (C ⧸ Q) :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hinjPQ
  haveI : Module.IsTorsionFree (A ⧸ P) Ω :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hinjPΩ
  haveI : Algebra.IsAlgebraic (A ⧸ P) (C ⧸ Q) := Algebra.IsIntegral.isAlgebraic
  let lam : (C ⧸ Q) →ₐ[A ⧸ P] Ω := IsAlgClosed.lift
  have hmem : ∀ s : C ⧸ Q, (lam : (C ⧸ Q) →+* Ω) s ∈ W := by
    intro s
    have h1 : IsIntegral (A ⧸ P) s := Algebra.IsIntegral.isIntegral s
    have h2 : IsIntegral (A ⧸ P) (lam s) := IsIntegral.map lam h1
    have h3 : IsIntegral (↥W) (lam s) := h2.tower_top
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp h3
    have hy' : (y : Ω) = lam s := hy
    show lam s ∈ W
    rw [← hy']
    exact y.2
  let ψ : C →+* ↥W := ((lam : (C ⧸ Q) →+* Ω).codRestrict W hmem).comp (Ideal.Quotient.mk Q)
  have hψ : ∀ a : A, ψ (algebraMap A C a) = θ a := by
    intro a
    apply Subtype.ext
    show lam (Ideal.Quotient.mk Q (algebraMap A C a)) = (θ a : Ω)
    rw [← Ideal.Quotient.algebraMap_mk_of_liesOver Q P, AlgHom.commutes]
    show (algebraMap (↥W) Ω) (θr.kerLift (Ideal.Quotient.mk _ a)) = _
    rw [RingHom.kerLift_mk]
    rfl

  have hBunit : IsUnit (algebraMap A B h) := by
    obtain ⟨b₀, hb₀⟩ := (hrange (algebraMap A M h)⁻¹).mpr
      ⟨1, by rw [pow_one, mul_inv_cancel₀ hM0]; exact isIntegral_one⟩
    refine IsUnit.of_mul_eq_one b₀ (hinjBM ?_)
    rw [map_mul, ← IsScalarTower.algebraMap_apply A B M, hb₀, mul_inv_cancel₀ hM0, map_one]
  haveI hloc : IsLocalization.Away (algebraMap A C h) B := by
    rw [IsLocalization.Away, isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, n, rfl⟩
      rw [map_pow]
      exact hBunit.pow n
    · intro z
      obtain ⟨k, hk⟩ := (hrange (algebraMap B M z)).mp ⟨z, rfl⟩
      have hint : IsIntegral A (algebraMap A B h ^ k * z) := by
        rw [← isIntegral_algHom_iff (IsScalarTower.toAlgHom A B M) hinjBM]
        simpa [map_mul, map_pow, ← IsScalarTower.algebraMap_apply] using hk
      refine ⟨(⟨algebraMap A B h ^ k * z, hint⟩, ⟨algebraMap A C h ^ k, k, rfl⟩), ?_⟩
      show z * (algebraMap A C h ^ k : C).1 = algebraMap A B h ^ k * z
      rw [mul_comm]
      rfl
    · intro x y hxy
      exact ⟨1, by rw [Subtype.ext hxy]⟩
  have hψunit : IsUnit (ψ (algebraMap A C h)) := by rw [hψ]; exact hunit
  let φ : B →+* ↥W := IsLocalization.Away.lift (algebraMap A C h) (S := B) hψunit
  have hφ : ∀ a : A, φ (algebraMap A B a) = θ a := by
    intro a
    have : algebraMap A B a = algebraMap C B (algebraMap A C a) := rfl
    rw [this, IsLocalization.Away.lift_eq, hψ]
  let θ' : B →ₐ[↥W] ↥W :=
    { φ with
      commutes' := fun w => by
        show φ (algebraMap (↥W) B w) = algebraMap (↥W) (↥W) w
        rw [IsScalarTower.algebraMap_apply (↥W) A B, hφ, θ.commutes] }
  have hθ'A : ∀ x : A, θ' (algebraMap A B x) = θ x := hφ
  refine ⟨θ', hθ'A, ?_⟩
  apply huniq
  · exact Ideal.comap_isPrime θ' (IsLocalRing.maximalIdeal ↥W)
  · rw [← hθ]
    ext x
    simp only [Ideal.mem_comap, hθ'A]

theorem wcpa_dj_llsm_smni_norm_section : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ →
      ∃ z₀ : ↥W, z₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∣ z₀ ∧ ∃ e n : A, e ∉ 𝔭 ∧
        algebraMap A K e * (LinearMap.charpoly
            (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff 0 =
          algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * algebraMap A K n :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre
  classical
  have hPD' := hPD
  obtain ⟨-, -, hIC, h𝔭max, -, ht𝔭, -, -⟩ := hPD'
  obtain ⟨hh𝔭, hS2, hPDB, h𝔮c, -⟩ := hSmc
  haveI := hIC
  have hinjB : Function.Injective (algebraMap B M) := IsFractionRing.injective B M

  obtain ⟨k, hk⟩ := (hS2 (algebraMap B M (t' - algebraMap ↥W B c₃))).mp ⟨_, rfl⟩
  have hnormx : Algebra.norm K (algebraMap A M h ^ k * algebraMap B M (t' - algebraMap ↥W B c₃)) =
      algebraMap A K h ^ (k * Module.finrank K M) *
        Algebra.norm K (algebraMap B M (t' - algebraMap ↥W B c₃)) := by
    rw [map_mul, map_pow, IsScalarTower.algebraMap_apply A K M h, Algebra.norm_algebraMap]
    ring
  have hxint : IsIntegral A
      (Algebra.norm K (algebraMap A M h ^ k * algebraMap B M (t' - algebraMap ↥W B c₃))) :=
    Algebra.isIntegral_norm K hk
  obtain ⟨ν, hν⟩ := (IsIntegrallyClosed.isIntegral_iff (R := A) (K := K)).mp hxint
  have hprod := Algebra.norm_eq_prod_automorphisms K
    (algebraMap A M h ^ k * algebraMap B M (t' - algebraMap ↥W B c₃))
  rw [← Finset.mul_prod_erase Finset.univ
    (fun σ : M ≃ₐ[K] M => σ (algebraMap A M h ^ k * algebraMap B M (t' - algebraMap ↥W B c₃)))
    (Finset.mem_univ 1)] at hprod
  have hDint : IsIntegral A (∏ σ ∈ Finset.univ.erase (1 : M ≃ₐ[K] M),
      σ (algebraMap A M h ^ k * algebraMap B M (t' - algebraMap ↥W B c₃))) := by
    apply IsIntegral.prod
    intro σ _
    have := hk.map (σ.restrictScalars A)
    exact this
  generalize hDdef : (∏ σ ∈ Finset.univ.erase (1 : M ≃ₐ[K] M),
      σ (algebraMap A M h ^ k * algebraMap B M (t' - algebraMap ↥W B c₃))) = D at hprod hDint
  obtain ⟨d, hd⟩ := (hS2 D).mpr ⟨0, by rw [pow_zero, one_mul]; exact hDint⟩
  have hN2 : algebraMap A B ν = algebraMap A B h ^ k * (t' - algebraMap ↥W B c₃) * d := by
    apply hinjB
    have e1 : algebraMap B M (algebraMap A B ν) = algebraMap K M (algebraMap A K ν) := by
      rw [← IsScalarTower.algebraMap_apply A B M, IsScalarTower.algebraMap_apply A K M]
    have e2 : algebraMap B M (algebraMap A B h ^ k * (t' - algebraMap ↥W B c₃) * d) =
        (algebraMap A M h ^ k * algebraMap B M (t' - algebraMap ↥W B c₃)) * D := by
      rw [map_mul, map_mul, map_pow, ← IsScalarTower.algebraMap_apply A B M, hd]
    rw [e1, e2, hν, hprod, AlgEquiv.one_apply]

  have hsign : (LinearMap.charpoly
      (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff 0 =
      (-1) ^ Module.finrank K M * Algebra.norm K (algebraMap B M (t' - algebraMap ↥W B c₃)) := by
    rw [Algebra.norm_apply, LinearMap.det_eq_sign_charpoly_coeff, ← mul_assoc, ← mul_pow,
      neg_one_mul, neg_neg, one_pow, one_mul]

  obtain ⟨θ₀, hθ₀t, hθ₀c⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB c₃ hc₃
  have hθ₀y : θ₀ (t' - algebraMap ↥W B c₃) = 0 := by
    rw [map_sub, hθ₀t, AlgHom.commutes]
    simp
  have hθW : ∀ w : ↥W, θ₀ (algebraMap A B (algebraMap ↥W A w)) = w := by
    intro w
    rw [← IsScalarTower.algebraMap_apply ↥W A B, AlgHom.commutes]
    rfl
  have hθm : ∀ a : A, θ₀ (algebraMap A B a) ∈ IsLocalRing.maximalIdeal ↥W ↔ a ∈ 𝔭 := by
    intro a
    rw [← h𝔮c, Ideal.mem_comap, ← hθ₀c, Ideal.mem_comap]
  have hθν : θ₀ (algebraMap A B ν) = 0 := by
    rw [hN2, map_mul, map_mul, hθ₀y, mul_zero, zero_mul]

  have htm : θ₀ (algebraMap A B t) ∈ IsLocalRing.maximalIdeal ↥W := (hθm t).mpr ht𝔭
  have hz₀m : θ₀ (algebraMap A B t) - c ∈ IsLocalRing.maximalIdeal ↥W := sub_mem htm hc
  have hbz₀ : b ∣ θ₀ (algebraMap A B t) - c :=
    (hPre θ₀ hθ₀c).mpr (by rw [hθ₀t, sub_self]; exact dvd_zero _)

  obtain ⟨ev, -, -, hsec⟩ := wcLlsAS_dsbu_section Ω W hW hWt A 𝔭 t
    (θ₀ (algebraMap A B t)) hPD htm
  obtain ⟨s, e', hs, hse⟩ := hsec ν
  have happ := congrArg (fun a => θ₀ (algebraMap A B a)) hse
  simp only [map_mul, map_sub, hθW, sub_self, zero_mul, hθν, zero_sub, mul_neg,
    neg_eq_zero] at happ
  have hθs : θ₀ (algebraMap A B s) ≠ 0 := by
    intro h0
    apply hs
    rw [← hθm s, h0]
    exact Ideal.zero_mem _
  have hev0 : ev ν = 0 := (mul_eq_zero.mp happ).resolve_left hθs
  rw [hev0, map_zero, sub_zero] at hse
  have hst : t - algebraMap ↥W A (θ₀ (algebraMap A B t)) =
      t - algebraMap ↥W A c - algebraMap ↥W A (θ₀ (algebraMap A B t) - c) := by
    rw [map_sub]; ring
  rw [hst] at hse

  refine ⟨θ₀ (algebraMap A B t) - c, hz₀m, hbz₀, s * h ^ (k * Module.finrank K M),
    (-1) ^ Module.finrank K M * e', ?_, ?_⟩
  · exact h𝔭max.isPrime.mul_notMem hs
      (fun hm => hh𝔭 (h𝔭max.isPrime.mem_of_pow_mem _ hm))
  · rw [hsign]
    calc algebraMap A K (s * h ^ (k * Module.finrank K M)) *
          ((-1) ^ Module.finrank K M * Algebra.norm K (algebraMap B M (t' - algebraMap ↥W B c₃)))
        = (-1) ^ Module.finrank K M * (algebraMap A K s * (algebraMap A K h ^ (k * Module.finrank K M) *
          Algebra.norm K (algebraMap B M (t' - algebraMap ↥W B c₃)))) := by
          rw [map_mul, map_pow]; ring
      _ = (-1) ^ Module.finrank K M * (algebraMap A K s * algebraMap A K ν) := by
          rw [hν, hnormx]
      _ = (-1) ^ Module.finrank K M * algebraMap A K (s * ν) := by rw [map_mul]
      _ = (-1) ^ Module.finrank K M *
          (algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A (θ₀ (algebraMap A B t) - c)) *
            algebraMap A K e') := by rw [hse, map_mul]
      _ = algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A (θ₀ (algebraMap A B t) - c)) *
          algebraMap A K ((-1) ^ Module.finrank K M * e') := by
          rw [map_mul, map_pow, map_neg, map_one]; ring

theorem wcpa_dj_llsm_smni_noo_galois_stable : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ σ : M ≃ₐ[K] M, ∃ ψ : B →+* B, (∀ x : B, algebraMap B M (ψ x) = σ (algebraMap B M x)) ∧
      ∀ x : B, (ψ x ∈ 𝔮 ↔ x ∈ 𝔮) :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 h 𝔮 t' hSmc σ
  obtain ⟨_hh, hS2, hPDB, h𝔮c, huniq⟩ := hSmc
  have h𝔮max : 𝔮.IsMaximal := hPDB.2.2.2.1
  haveI : 𝔮.IsPrime := h𝔮max.isPrime
  have hinj : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  have s1 : ∀ a : A, σ (algebraMap A M a) = algebraMap A M a := by
    intro a
    rw [IsScalarTower.algebraMap_apply A K M]
    exact σ.commutes _
  have s1' : ∀ a : A, algebraMap B M (algebraMap A B a) = algebraMap A M a := fun a =>
    (IsScalarTower.algebraMap_apply A B M a).symm
  have s2 : ∀ x : B, ∃ y : B, algebraMap B M y = σ (algebraMap B M x) := by
    intro x
    obtain ⟨k, hk⟩ := (hS2 (algebraMap B M x)).mp ⟨x, rfl⟩
    have hk' := IsIntegral.map (σ.restrictScalars A) hk
    rw [AlgEquiv.restrictScalars_apply, map_mul, map_pow, s1] at hk'
    obtain ⟨y, hy⟩ := (hS2 (σ (algebraMap B M x))).mpr ⟨k, hk'⟩
    exact ⟨y, hy⟩
  choose g hg using s2
  let ψ : B →+* B :=
    { toFun := g
      map_one' := hinj (by rw [hg, map_one, map_one])
      map_mul' := fun x y => hinj (by rw [hg, map_mul, map_mul, map_mul, hg, hg])
      map_zero' := hinj (by rw [hg, map_zero, map_zero])
      map_add' := fun x y => hinj (by rw [hg, map_add, map_add, map_add, hg, hg]) }
  have hψ : ∀ x, ψ x = g x := fun x => rfl
  have s4 : ψ.comp (algebraMap A B) = algebraMap A B := by
    ext a
    apply hinj
    rw [RingHom.comp_apply, hψ, hg, s1', s1]
  have s5 : 𝔮.comap ψ = 𝔮 := by
    haveI hpr : (𝔮.comap ψ).IsPrime := Ideal.comap_isPrime ψ 𝔮
    apply huniq _ hpr
    rw [Ideal.comap_comap, s4, h𝔮c]
  refine ⟨ψ, fun x => hg x, fun x => ?_⟩
  rw [← Ideal.mem_comap, s5]

theorem wcpa_dj_llsm_smni_noo_conj_irreducible : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (h : A) (𝔮 : Ideal B) [𝔮.IsPrime] (t' : B),
    wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    (∀ σ : M ≃ₐ[K] M, ∃ ψ : B →+* B, (∀ x : B, algebraMap B M (ψ x) = σ (algebraMap B M x)) ∧
      ∀ x : B, (ψ x ∈ 𝔮 ↔ x ∈ 𝔮)) →
    ∀ (σ : M ≃ₐ[K] M) (ψ : B →+* B), (∀ x : B, algebraMap B M (ψ x) = σ (algebraMap B M x)) →
    ∀ x : B, Irreducible (wcNooPi W B 𝔮 x) → Irreducible (wcNooPi W B 𝔮 (ψ x)) :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 hh 𝔮 _ t' _ hstab σ ψ hψ
    x hx
  classical
  have hinj : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  obtain ⟨ψ₁, h₁, h₁q⟩ := hstab σ
  obtain ⟨ψ', h', h'q⟩ := hstab σ.symm
  have s1 : ∀ y, ψ y ∈ 𝔮 ↔ y ∈ 𝔮 := by
    intro y
    have e : ψ y = ψ₁ y := hinj (by rw [hψ, h₁])
    rw [e]
    exact h₁q y
  have s2a : ∀ y, ψ' (ψ y) = y := fun y =>
    hinj (by rw [h', hψ, AlgEquiv.symm_apply_apply])
  have s2b : ∀ y, ψ (ψ' y) = y := fun y =>
    hinj (by rw [hψ, h', AlgEquiv.apply_symm_apply])
  have hA : ∀ a : A, algebraMap B M (algebraMap A B a) = algebraMap K M (algebraMap A K a) := by
    intro a
    rw [← IsScalarTower.algebraMap_apply A B M, IsScalarTower.algebraMap_apply A K M]
  have s3a : ∀ w : ↥W, ψ (algebraMap (↥W) B w) = algebraMap (↥W) B w := by
    intro w
    rw [IsScalarTower.algebraMap_apply (↥W) A B]
    apply hinj
    rw [hψ, hA, AlgEquiv.commutes]
  have s3b : ∀ w : ↥W, ψ' (algebraMap (↥W) B w) = algebraMap (↥W) B w := by
    intro w
    rw [IsScalarTower.algebraMap_apply (↥W) A B]
    apply hinj
    rw [h', hA, AlgEquiv.commutes]
  have hq : 𝔮 = Ideal.comap ψ 𝔮 := by
    ext y
    rw [Ideal.mem_comap, s1]
  have hq' : 𝔮 = Ideal.comap ψ' 𝔮 := by
    ext y
    rw [Ideal.mem_comap, h'q]
  let φ := Localization.localRingHom 𝔮 𝔮 ψ hq
  let φ' := Localization.localRingHom 𝔮 𝔮 ψ' hq'
  have hφa : ∀ y, φ (algebraMap B (Localization.AtPrime 𝔮) y) =
      algebraMap B (Localization.AtPrime 𝔮) (ψ y) := fun y =>
    Localization.localRingHom_to_map _ _ _ _ _
  have hφ'a : ∀ y, φ' (algebraMap B (Localization.AtPrime 𝔮) y) =
      algebraMap B (Localization.AtPrime 𝔮) (ψ' y) := fun y =>
    Localization.localRingHom_to_map _ _ _ _ _
  have s5a : φ'.comp φ = RingHom.id _ := by
    apply IsLocalization.ringHom_ext 𝔮.primeCompl
    refine RingHom.ext fun y => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hφa, hφ'a, s2a,
      RingHom.id_apply]
  have s5b : φ.comp φ' = RingHom.id _ := by
    apply IsLocalization.ringHom_ext 𝔮.primeCompl
    refine RingHom.ext fun y => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hφ'a, hφa, s2b,
      RingHom.id_apply]
  let J : Ideal (Localization.AtPrime 𝔮) := ((IsLocalRing.maximalIdeal ↥W).map
    (algebraMap (↥W) B)).map (algebraMap B (Localization.AtPrime 𝔮))
  have s6a : J ≤ J.comap φ := by
    rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, Ideal.map_le_iff_le_comap]
    intro w hw
    simp only [Ideal.mem_comap, RingHom.comp_apply]
    rw [hφa, s3a]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw)
  have s6b : J ≤ J.comap φ' := by
    rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, Ideal.map_le_iff_le_comap]
    intro w hw
    simp only [Ideal.mem_comap, RingHom.comp_apply]
    rw [hφ'a, s3b]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw)
  let θ := Ideal.quotientMap J φ s6a
  let θ' := Ideal.quotientMap J φ' s6b
  have s8a : θ'.comp θ = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun z => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, Ideal.quotientMap_mk,
      Ideal.quotientMap_mk, ← RingHom.comp_apply φ' φ, s5a, RingHom.id_apply, RingHom.id_apply]
  have s8b : θ.comp θ' = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun z => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, Ideal.quotientMap_mk,
      Ideal.quotientMap_mk, ← RingHom.comp_apply φ φ', s5b, RingHom.id_apply, RingHom.id_apply]
  let e : (Localization.AtPrime 𝔮 ⧸ J) ≃+* (Localization.AtPrime 𝔮 ⧸ J) :=
    RingEquiv.ofRingHom θ θ' s8b s8a
  have key : e (wcNooPi W B 𝔮 x) = wcNooPi W B 𝔮 (ψ x) := by
    show θ (Ideal.Quotient.mk J (algebraMap B (Localization.AtPrime 𝔮) x)) =
      Ideal.Quotient.mk J (algebraMap B (Localization.AtPrime 𝔮) (ψ x))
    rw [Ideal.quotientMap_mk, hφa]
  rw [← key]
  exact hx.map e

theorem wcpa_dj_llsm_smni_noo_denominators : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    (∀ σ : M ≃ₐ[K] M, ∃ ψ : B →+* B, (∀ x : B, algebraMap B M (ψ x) = σ (algebraMap B M x)) ∧
      ∀ x : B, (ψ x ∈ 𝔮 ↔ x ∈ 𝔮)) →
    ∀ b s : B, s ∉ 𝔮 → ∃ (x : M) (a : A), IsIntegral A x ∧ a ∉ 𝔭 ∧
      algebraMap A M a * algebraMap B M b = x * algebraMap B M s :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc hstab b s hs
  classical
  haveI : IsIntegrallyClosed A := hPD.2.2.1
  haveI h𝔭p : 𝔭.IsPrime := hPD.2.2.2.1.isPrime
  have hPDB : wcLlsPD W B 𝔮 (.disc t') := hSmc.2.2.1
  haveI h𝔮p : 𝔮.IsPrime := hPDB.2.2.2.1.isPrime
  have h𝔮c : 𝔮.comap (algebraMap A B) = 𝔭 := hSmc.2.2.2.1
  have hh : h ∉ 𝔭 := hSmc.1
  choose ψ hψ hψq using hstab
  have hψ1 : ∀ x : B, ψ 1 x = x := fun x =>
    IsFractionRing.injective B M (by rw [hψ 1 x, AlgEquiv.one_apply])
  set Nb : B := ∏ σ : M ≃ₐ[K] M, ψ σ s with hNb
  set P : B := ∏ σ ∈ (Finset.univ : Finset (M ≃ₐ[K] M)).erase 1, ψ σ s with hP
  have hsP : s * P = Nb := by
    have := Finset.mul_prod_erase (Finset.univ : Finset (M ≃ₐ[K] M)) (fun σ => ψ σ s)
      (Finset.mem_univ 1)
    rw [hψ1 s] at this
    exact this
  have hNbq : Nb ∉ 𝔮 := by
    intro hN
    obtain ⟨σ, _, hσ⟩ := Ideal.IsPrime.prod_mem_iff.mp hN
    exact hs ((hψq σ s).mp hσ)
  have hNbM : algebraMap B M Nb = algebraMap K M (Algebra.norm K (algebraMap B M s)) := by
    rw [Algebra.norm_eq_prod_automorphisms, hNb, map_prod]
    exact Finset.prod_congr rfl (fun σ _ => hψ σ s)
  obtain ⟨k, hk⟩ := (hSmc.2.1 (algebraMap B M Nb)).mp ⟨Nb, rfl⟩
  have hhM : algebraMap A M h = algebraMap K M (algebraMap A K h) :=
    IsScalarTower.algebraMap_apply A K M h
  have hk' : IsIntegral A (algebraMap A K h ^ k * Algebra.norm K (algebraMap B M s)) := by
    have hinj : Function.Injective (IsScalarTower.toAlgHom A K M) := (algebraMap K M).injective
    rw [← isIntegral_algHom_iff _ hinj]
    have e : IsScalarTower.toAlgHom A K M (algebraMap A K h ^ k * Algebra.norm K (algebraMap B M s))
        = algebraMap A M h ^ k * algebraMap B M Nb := by
      rw [IsScalarTower.coe_toAlgHom', map_mul, map_pow, ← hhM, hNbM]
    rw [e]; exact hk
  obtain ⟨a₀, ha₀⟩ := IsIntegrallyClosed.isIntegral_iff.mp hk'
  have hhB : algebraMap A M h = algebraMap B M (algebraMap A B h) :=
    IsScalarTower.algebraMap_apply A B M h
  have ha₀M : algebraMap A M a₀ = algebraMap A M h ^ k * algebraMap B M Nb := by
    rw [IsScalarTower.algebraMap_apply A K M, ha₀, map_mul, map_pow, ← hhM, hNbM]
  have ha₀B : algebraMap A B a₀ = algebraMap A B h ^ k * Nb := by
    apply IsFractionRing.injective B M
    rw [map_mul, map_pow, ← IsScalarTower.algebraMap_apply A B M, ← hhB, ha₀M]
  have ha₀p : a₀ ∉ 𝔭 := by
    intro ha
    rw [← h𝔮c, Ideal.mem_comap, ha₀B] at ha
    rcases h𝔮p.mem_or_mem ha with h1 | h1
    · apply hh
      rw [← h𝔮c, Ideal.mem_comap]
      exact h𝔮p.mem_of_pow_mem k h1
    · exact hNbq h1
  obtain ⟨j, hj⟩ := (hSmc.2.1 (algebraMap B M (b * P))).mp ⟨b * P, rfl⟩
  refine ⟨algebraMap A M h ^ k * (algebraMap A M h ^ j * algebraMap B M (b * P)), h ^ j * a₀,
    ?_, ?_, ?_⟩
  · exact ((isIntegral_algebraMap).pow k).mul hj
  · intro ha
    rcases h𝔭p.mem_or_mem ha with h1 | h1
    · exact hh (h𝔭p.mem_of_pow_mem j h1)
    · exact ha₀p h1
  · rw [map_mul, map_pow, ha₀M, ← hsP, map_mul, map_mul]
    ring

theorem wcpa_dj_llsm_smni_noo_closure_finite : ∀ (A : Type u) [CommRing A] [IsDomain A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (M : Type u) [Field M]
    [Algebra K M] [Algebra A M] [IsScalarTower A K M],
    (∀ s : K, Module.Finite ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) →
    Module.Finite A ↥(integralClosure A M) :=
by
  intro A _ _ K _ _ _ M _ _ _ _ H
  haveI hC₀ : Module.Finite ↥(Algebra.adjoin A {(0 : K)})
      ↥(integralClosure ↥(Algebra.adjoin A {(0 : K)}) M) := H 0
  haveI hR₀ : Module.Finite A ↥(Algebra.adjoin A {(0 : K)}) :=
    Algebra.finite_adjoin_simple_of_isIntegral isIntegral_zero
  haveI : Algebra.IsIntegral A ↥(Algebra.adjoin A {(0 : K)}) :=
    Algebra.IsIntegral.of_finite A ↥(Algebra.adjoin A {(0 : K)})
  haveI : Module.Finite A ↥(integralClosure ↥(Algebra.adjoin A {(0 : K)}) M) :=
    Module.Finite.trans ↥(Algebra.adjoin A {(0 : K)})
      ↥(integralClosure ↥(Algebra.adjoin A {(0 : K)}) M)
  have h5a : ∀ x : M, x ∈ integralClosure ↥(Algebra.adjoin A {(0 : K)}) M →
      x ∈ integralClosure A M := fun x hx =>
    isIntegral_trans (R := A) (A := ↥(Algebra.adjoin A {(0 : K)})) x hx
  have h5b : ∀ x : M, x ∈ integralClosure A M →
      x ∈ integralClosure ↥(Algebra.adjoin A {(0 : K)}) M := fun x hx =>
    IsIntegral.tower_top (A := ↥(Algebra.adjoin A {(0 : K)})) hx
  let g : ↥(integralClosure ↥(Algebra.adjoin A {(0 : K)}) M) →ₗ[A] ↥(integralClosure A M) :=
    LinearMap.codRestrict (Subalgebra.toSubmodule (integralClosure A M))
      ((integralClosure ↥(Algebra.adjoin A {(0 : K)}) M).val.restrictScalars A).toLinearMap
      (fun y => h5a _ y.2)
  apply Module.Finite.of_surjective g
  intro z
  exact ⟨⟨(z : M), h5b _ z.2⟩, rfl⟩

theorem wcpa_dj_llsm_smni_noo_fibre_degree : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t h : A) (𝔮 : Ideal B) [𝔮.IsPrime] (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c c₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c₃ ∈ IsLocalRing.maximalIdeal ↥W →
    Module.Finite A ↥(integralClosure A M) →
    (∀ b s : B, s ∉ 𝔮 → ∃ (x : M) (a : A), IsIntegral A x ∧ a ∉ 𝔭 ∧
      algebraMap A M a * algebraMap B M b = x * algebraMap B M s) →
    ∀ r : ℕ, (∃ v : wcNooFib W B 𝔮, wcNooPi W B 𝔮 (t' - algebraMap ↥W B c₃) ^ r =
      wcNooPi W B 𝔮 (algebraMap A B (t - algebraMap ↥W A c)) * v) →
    Module.finrank K M ≤ r :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 _ t' hPD hSmc c c₃ hc hc₃ hfin hden r hex
  classical
  obtain ⟨v, hv⟩ := hex

  have h𝔭max : 𝔭.IsMaximal := hPD.2.2.2.1
  have hm𝔭 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := hPD.2.2.2.2.1
  have ht : t ∈ 𝔭 := hPD.2.2.2.2.2.1
  have hS2 := hSmc.2.1
  have hPDB : wcLlsPD W B 𝔮 (.disc t') := hSmc.2.2.1
  have hm𝔮 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔮 := hPDB.2.2.2.2.1
  have ht' : t' ∈ 𝔮 := hPDB.2.2.2.2.2.1
  have h𝔭p : 𝔭.IsPrime := h𝔭max.isPrime
  have h𝔮p : 𝔮.IsPrime := ‹𝔮.IsPrime›

  have hT : t' - algebraMap ↥W B c₃ ∈ 𝔮 := 𝔮.sub_mem ht' (hm𝔮 (Ideal.mem_map_of_mem _ hc₃))
  have hZ : t - algebraMap ↥W A c ∈ 𝔭 := 𝔭.sub_mem ht (hm𝔭 (Ideal.mem_map_of_mem _ hc))
  have hW𝔮 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W B w ∈ 𝔮 :=
    fun w hw => hm𝔮 (Ideal.mem_map_of_mem _ hw)
  have h1𝔭 : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp h𝔭max.ne_top

  obtain ⟨ev, hev, -, hsec⟩ := wcLlsAS_dsbu_section Ω W hW hWt B 𝔮 t' c₃ hPDB hc₃
  generalize hTdef : t' - algebraMap ↥W B c₃ = T at hsec hv hT
  generalize hZdef : t - algebraMap ↥W A c = Z at hv hZ

  have hexp : ∀ (j : ℕ) (b : B), ∃ (s' : B) (w : ℕ → ↥W) (e : B), s' ∉ 𝔮 ∧
      s' * b = s' * ∑ i ∈ Finset.range j, algebraMap ↥W B (w i) * T ^ i + T ^ j * e := by
    intro j b
    induction j with
    | zero =>
      refine ⟨1, 0, b, (Ideal.ne_top_iff_one 𝔮).mp h𝔮p.ne_top, ?_⟩
      simp
    | succ j ih =>
      obtain ⟨s', w, e, hs', heq⟩ := ih
      have hu : IsUnit (ev s') := by
        by_contra hnu
        have hmem : ev s' ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
        obtain ⟨s₀, e₀, hs₀, h₀⟩ := hsec s'
        have h1 : s₀ * (s' - algebraMap ↥W B (ev s')) ∈ 𝔮 := by
          rw [h₀]; exact Ideal.mul_mem_right _ _ hT
        rcases h𝔮p.mem_or_mem h1 with h2 | h2
        · exact hs₀ h2
        · apply hs'
          have h3 := 𝔮.add_mem h2 (hW𝔮 _ hmem)
          simpa using h3
      have hev_a : ev (e - algebraMap ↥W B (ev e * ↑hu.unit⁻¹) * s') = 0 := by
        rw [map_sub, map_mul, hev, mul_assoc, hu.val_inv_mul, mul_one, sub_self]
      obtain ⟨s₀, e₀, hs₀, h₀⟩ := hsec (e - algebraMap ↥W B (ev e * ↑hu.unit⁻¹) * s')
      rw [hev_a, map_zero, sub_zero] at h₀
      refine ⟨s₀ * s', Function.update w j (ev e * ↑hu.unit⁻¹), e₀, ?_, ?_⟩
      · exact fun hm => (h𝔮p.mem_or_mem hm).elim hs₀ hs'
      · have hsum : ∑ i ∈ Finset.range (j + 1),
              algebraMap ↥W B (Function.update w j (ev e * ↑hu.unit⁻¹) i) * T ^ i
            = ∑ i ∈ Finset.range j, algebraMap ↥W B (w i) * T ^ i +
              algebraMap ↥W B (ev e * ↑hu.unit⁻¹) * T ^ j := by
          rw [Finset.sum_range_succ, Function.update_self]
          congr 1
          apply Finset.sum_congr rfl
          intro i hi
          rw [Function.update_of_ne (Finset.mem_range.mp hi).ne]
        rw [hsum]
        linear_combination s₀ * heq + T ^ j * h₀

  obtain ⟨σ, y, x, hσ, hx, hσT⟩ : ∃ σ y x : B, σ ∉ 𝔮 ∧
      x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ∧
      σ * T ^ r = algebraMap A B Z * y + x := by
    obtain ⟨v₀, rfl⟩ := Ideal.Quotient.mk_surjective v
    obtain ⟨⟨y₀, s₁⟩, hys⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl v₀
    have h1 : (algebraMap B (Localization.AtPrime 𝔮) T) ^ r -
        algebraMap B (Localization.AtPrime 𝔮) (algebraMap A B Z) * v₀ ∈
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)).map
          (algebraMap B (Localization.AtPrime 𝔮)) := by
      rw [← Ideal.Quotient.eq, map_pow, map_mul]
      exact hv
    have hspec : v₀ * algebraMap B (Localization.AtPrime 𝔮) (s₁ : B) =
        algebraMap B (Localization.AtPrime 𝔮) y₀ := by
      rw [← hys]; exact IsLocalization.mk'_spec (Localization.AtPrime 𝔮) y₀ s₁
    have h2 : algebraMap B (Localization.AtPrime 𝔮) ((s₁ : B) * T ^ r - algebraMap A B Z * y₀) ∈
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)).map
          (algebraMap B (Localization.AtPrime 𝔮)) := by
      have h3 := Ideal.mul_mem_right (algebraMap B (Localization.AtPrime 𝔮) (s₁ : B)) _ h1
      convert h3 using 1
      simp only [map_sub, map_mul, map_pow]
      rw [← hspec]
      ring
    obtain ⟨⟨p1, p2⟩, hp⟩ :=
      (IsLocalization.mem_map_algebraMap_iff 𝔮.primeCompl (Localization.AtPrime 𝔮)).mp h2
    have hinj : Function.Injective (algebraMap B (Localization.AtPrime 𝔮)) :=
      IsLocalization.injective (M := 𝔮.primeCompl) (S := Localization.AtPrime 𝔮)
        (Ideal.primeCompl_le_nonZeroDivisors 𝔮)
    rw [← map_mul] at hp
    have hp' := hinj hp
    refine ⟨(p2 : B) * (s₁ : B), (p2 : B) * y₀, (p1 : B), ?_, p1.2, ?_⟩
    · exact fun hm => (h𝔮p.mem_or_mem hm).elim (Ideal.mem_primeCompl_iff.mp p2.2)
        (Ideal.mem_primeCompl_iff.mp s₁.2)
    · linear_combination hp'

  set C' : Submodule A M := Subalgebra.toSubmodule (integralClosure A M) with hC'
  have hmemC : ∀ z : M, IsIntegral A z → z ∈ C' := fun z hz => hz
  have hCmem : ∀ z : M, z ∈ C' → IsIntegral A z := fun z hz => hz

  let I₀ : Ideal B :=
    { carrier := {x | ∀ b D : B, D ∉ 𝔮 → ∃ a : A, a ∉ 𝔭 ∧ ∃ z ∈ 𝔭 • C',
        algebraMap A M a * algebraMap B M (b * x) = z * algebraMap B M D}
      zero_mem' := by
        intro b D hD
        exact ⟨1, h1𝔭, 0, Submodule.zero_mem _, by simp⟩
      add_mem' := by
        intro x y hx hy b D hD
        obtain ⟨a₁, ha₁, z₁, hz₁, h₁⟩ := hx b D hD
        obtain ⟨a₂, ha₂, z₂, hz₂, h₂⟩ := hy b D hD
        refine ⟨a₁ * a₂, fun hm => (h𝔭p.mem_or_mem hm).elim ha₁ ha₂, a₂ • z₁ + a₁ • z₂,
          Submodule.add_mem _ (Submodule.smul_mem _ _ hz₁) (Submodule.smul_mem _ _ hz₂), ?_⟩
        rw [Algebra.smul_def, Algebra.smul_def, map_mul (algebraMap A M) a₁ a₂, mul_add, map_add]
        linear_combination (algebraMap A M a₂) * h₁ + (algebraMap A M a₁) * h₂
      smul_mem' := by
        intro a x hx b D hD
        show ∃ a' : A, a' ∉ 𝔭 ∧ ∃ z ∈ 𝔭 • C',
          algebraMap A M a' * algebraMap B M (b * (a * x)) = z * algebraMap B M D
        rw [← mul_assoc]
        exact hx (b * a) D hD }
  have hI₀ : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ I₀ := by
    rw [Ideal.map_le_iff_le_comap]
    intro μ hμ b D hD
    obtain ⟨xb, ab, hxb, hab, hb⟩ := hden b D hD
    refine ⟨ab, hab, (algebraMap ↥W A μ) • xb,
      Submodule.smul_mem_smul (hm𝔭 (Ideal.mem_map_of_mem _ hμ)) (hmemC xb hxb), ?_⟩
    rw [Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply ↥W A B μ,
      ← IsScalarTower.algebraMap_apply A B M]
    linear_combination (algebraMap A M (algebraMap ↥W A μ)) * hb
  have hclear0 : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B), ∀ b D : B, D ∉ 𝔮 →
      ∃ a : A, a ∉ 𝔭 ∧ ∃ z ∈ 𝔭 • C',
        algebraMap A M a * algebraMap B M (b * x) = z * algebraMap B M D :=
    fun x hx => hI₀ hx

  set VK : Submodule K M := Submodule.span K
    (Set.range fun i : Fin r => (algebraMap B M T) ^ (i : ℕ)) with hVK

  have hkey : ∀ x' : M, IsIntegral A x' → ∃ a : A, a ∉ 𝔭 ∧
      algebraMap A M a * x' ∈ VK.restrictScalars A ⊔ 𝔭 • C' := by
    intro x' hx'
    obtain ⟨b, hb⟩ := (hS2 x').mpr ⟨0, by rw [pow_zero, one_mul]; exact hx'⟩
    obtain ⟨s', w, e, hs', heq⟩ := hexp r b
    generalize hP : ∑ i ∈ Finset.range r, algebraMap ↥W B (w i) * T ^ i = P at heq
    have hD : σ * s' ∉ 𝔮 := fun hm => (h𝔮p.mem_or_mem hm).elim hσ hs'
    have hcB : σ * s' * b = σ * s' * P + algebraMap A B Z * (y * e) + x * e := by
      linear_combination σ * heq + e * hσT
    obtain ⟨x₁, a₁, hx₁, ha₁, h₁⟩ := hden (y * e) (σ * s') hD
    obtain ⟨a₂, ha₂, z₂, hz₂, h₂⟩ := hclear0 (x * e) (Ideal.mul_mem_right _ _ hx) 1 (σ * s') hD
    rw [one_mul] at h₂
    have hDM : algebraMap B M (σ * s') ≠ 0 := by
      intro h0
      apply hD
      rw [(IsFractionRing.injective B M) (h0.trans (map_zero _).symm)]
      exact 𝔮.zero_mem
    have hfinal : algebraMap A M (a₁ * a₂) * x' =
        algebraMap A M (a₁ * a₂) * algebraMap B M P + algebraMap A M (a₂ * Z) * x₁ +
          algebraMap A M a₁ * z₂ := by
      apply mul_left_cancel₀ hDM
      have hcM := congrArg (algebraMap B M) hcB
      rw [map_mul (algebraMap B M) (σ * s') b, hb, map_add, map_add,
        map_mul (algebraMap B M) (σ * s') P, map_mul (algebraMap B M) (algebraMap A B Z),
        ← IsScalarTower.algebraMap_apply A B M] at hcM
      rw [map_mul (algebraMap A M) a₁ a₂, map_mul (algebraMap A M) a₂ Z]
      linear_combination (algebraMap A M a₁ * algebraMap A M a₂) * hcM +
        (algebraMap A M a₂ * algebraMap A M Z) * h₁ + (algebraMap A M a₁) * h₂
    refine ⟨a₁ * a₂, fun hm => (h𝔭p.mem_or_mem hm).elim ha₁ ha₂, ?_⟩
    rw [hfinal]
    have hPV : algebraMap B M P ∈ VK := by
      rw [← hP, map_sum]
      refine Submodule.sum_mem _ (fun i hi => ?_)
      rw [map_mul, map_pow, IsScalarTower.algebraMap_apply ↥W A B (w i),
        ← IsScalarTower.algebraMap_apply A B M, IsScalarTower.algebraMap_apply A K M,
        ← Algebra.smul_def]
      refine VK.smul_mem _ (Submodule.subset_span ⟨⟨i, Finset.mem_range.mp hi⟩, rfl⟩)
    refine Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_
    · apply Submodule.mem_sup_left
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem (VK.restrictScalars A) _ hPV
    · apply Submodule.mem_sup_right
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem_smul (𝔭.mul_mem_left a₂ hZ) (hmemC x₁ hx₁)
    · apply Submodule.mem_sup_right
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ a₁ hz₂

  have hn1 : C' ≤ VK.restrictScalars A ⊔ 𝔭 • C' := by
    intro c' hc'
    obtain ⟨a, ha, hmem⟩ := hkey c' (hCmem c' hc')
    obtain ⟨yy, i, hi, hyi⟩ := h𝔭max.exists_inv ha
    have he : c' = yy • (algebraMap A M a * c') + i • c' := by
      rw [Algebra.smul_def, Algebra.smul_def, ← mul_assoc, ← map_mul, ← add_mul, ← map_add, hyi,
        map_one, one_mul]
    rw [he]
    exact Submodule.add_mem _ (Submodule.smul_mem _ _ hmem)
      (Submodule.mem_sup_right (Submodule.smul_mem_smul hi hc'))
  have hfg : C'.FG := Module.Finite.iff_fg.mp hfin
  obtain ⟨a, ha1, haC⟩ :=
    Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hfg le_rfl hn1
  have ha𝔭 : a ∉ 𝔭 := by
    intro hm
    apply h1𝔭
    have h3 := 𝔭.sub_mem hm ha1
    simpa using h3
  have hk : algebraMap A K a ≠ 0 := by
    intro h0
    apply ha𝔭
    rw [(IsFractionRing.injective A K) (h0.trans (map_zero _).symm)]
    exact 𝔭.zero_mem
  have hCV : ∀ c' : M, IsIntegral A c' → c' ∈ VK := by
    intro c' hc'
    have h1 : a • c' ∈ VK.restrictScalars A :=
      haC (Submodule.smul_mem_pointwise_smul c' a C' (hmemC c' hc'))
    have h2 : algebraMap A K a • c' ∈ VK := by rw [algebraMap_smul]; exact h1
    have h3 := VK.smul_mem (algebraMap A K a)⁻¹ h2
    rwa [smul_smul, inv_mul_cancel₀ hk, one_smul] at h3
  have htop : VK = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro z
    haveI := Algebra.IsAlgebraic.of_finite K M
    have hzK : IsAlgebraic K z := Algebra.IsAlgebraic.isAlgebraic z
    have hzA : IsAlgebraic A z := (IsFractionRing.isAlgebraic_iff A K M).mpr hzK
    obtain ⟨yy, hy0, hyint⟩ := hzA.exists_integral_multiple
    have hyK : algebraMap A K yy ≠ 0 := by
      intro h0
      exact hy0 ((IsFractionRing.injective A K) (h0.trans (map_zero _).symm))
    have h2 : algebraMap A K yy • z ∈ VK := by rw [algebraMap_smul]; exact hCV _ hyint
    have h3 := VK.smul_mem (algebraMap A K yy)⁻¹ h2
    rwa [smul_smul, inv_mul_cancel₀ hyK, one_smul] at h3
  calc Module.finrank K M = Module.finrank K (⊤ : Submodule K M) := (finrank_top K M).symm
    _ = Module.finrank K VK := by rw [htop]
    _ = Set.finrank K (Set.range fun i : Fin r => (algebraMap B M T) ^ (i : ℕ)) := rfl
    _ ≤ Fintype.card (Fin r) := finrank_range_le_card _
    _ = r := Fintype.card_fin r

theorem wcpa_dj_llsm_smni_norm_order_one : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ →
      ∀ (z₀ : ↥W) (e n : A), z₀ ∈ IsLocalRing.maximalIdeal ↥W → e ∉ 𝔭 →
        algebraMap A K e * (LinearMap.charpoly
            (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff 0 =
          algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * algebraMap A K n →
        n ∉ 𝔭 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre z₀ e n hz₀ he hrel
  classical
  have hPDB : wcLlsPD W B 𝔮 (.disc t') := hSmc.2.2.1
  have h𝔮c : 𝔮.comap (algebraMap A B) = 𝔭 := hSmc.2.2.2.1
  have h𝔭eq : 𝔭 = Ideal.span {t} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
    hPD.2.2.2.2.2.2.1
  haveI : 𝔮.IsPrime := hPDB.2.2.2.1.isPrime
  obtain ⟨hdom, hdvr, hirr⟩ := wcpa_dj_llsm_kpde_fibre_dvr Ω W B 𝔮 t' hPDB
  haveI : IsDomain (wcNooFib W B 𝔮) := hdom
  haveI : IsDiscreteValuationRing (wcNooFib W B 𝔮) := hdvr

  have hπW : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, wcNooPi W B 𝔮 (algebraMap ↥W B w) = 0 := by
    intro w hw
    show Ideal.Quotient.mk _ (algebraMap B (Localization.AtPrime 𝔮) (algebraMap ↥W B w)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw)
  have hπA : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A),
      wcNooPi W B 𝔮 (algebraMap A B x) = 0 := by
    have hle : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
        RingHom.ker ((wcNooPi W B 𝔮).comp (algebraMap A B)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply,
        ← IsScalarTower.algebraMap_apply ↥W A B]
      exact hπW w hw
    intro x hx
    have := hle hx
    rwa [RingHom.mem_ker, RingHom.comp_apply] at this
  set T : B := t' - algebraMap ↥W B c₃ with hT
  set ℓ : ℕ := Module.finrank K M with hℓ
  have hirrT : Irreducible (wcNooPi W B 𝔮 T) := by
    have e1 : wcNooPi W B 𝔮 T = wcNooPi W B 𝔮 t' := by
      rw [hT, map_sub, hπW c₃ hc₃, sub_zero]
    rw [e1]; exact hirr
  have hπWA : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      wcNooPi W B 𝔮 (algebraMap A B (algebraMap ↥W A w)) = 0 := by
    intro w hw
    rw [← IsScalarTower.algebraMap_apply ↥W A B]
    exact hπW w hw
  have hπt : wcNooPi W B 𝔮 (algebraMap A B t) =
      wcNooPi W B 𝔮 (algebraMap A B (t - algebraMap ↥W A c)) := by
    rw [map_sub, map_sub, hπWA c hc, sub_zero]
  have hπX : wcNooPi W B 𝔮 (algebraMap A B (t - algebraMap ↥W A c - algebraMap ↥W A z₀)) =
      wcNooPi W B 𝔮 (algebraMap A B (t - algebraMap ↥W A c)) := by
    rw [map_sub _ (t - algebraMap ↥W A c), map_sub _ (algebraMap A B (t - algebraMap ↥W A c)),
      hπWA z₀ hz₀, sub_zero]

  choose ψ hψ hψq using wcpa_dj_llsm_smni_noo_galois_stable Ω W hW hWt A K M B 𝔭 h 𝔮 t' hSmc
  have hstab : ∀ σ : M ≃ₐ[K] M, ∃ ψ : B →+* B,
      (∀ x : B, algebraMap B M (ψ x) = σ (algebraMap B M x)) ∧ ∀ x : B, (ψ x ∈ 𝔮 ↔ x ∈ 𝔮) :=
    fun σ => ⟨ψ σ, hψ σ, hψq σ⟩
  have hirrσ : ∀ σ : M ≃ₐ[K] M, Irreducible (wcNooPi W B 𝔮 (ψ σ T)) := fun σ =>
    wcpa_dj_llsm_smni_noo_conj_irreducible Ω W hW hWt A K M B 𝔭 h 𝔮 t' hSmc hstab σ (ψ σ)
      (hψ σ) T hirrT

  have hcoeff : algebraMap K M ((LinearMap.charpoly (Algebra.lmul K M (algebraMap B M T))).coeff 0)
      = (-1) ^ ℓ * algebraMap B M (∏ σ : M ≃ₐ[K] M, ψ σ T) := by
    have hdet : Algebra.norm K (algebraMap B M T) =
        (-1) ^ ℓ * (LinearMap.charpoly (Algebra.lmul K M (algebraMap B M T))).coeff 0 := by
      rw [Algebra.norm_apply, LinearMap.det_eq_sign_charpoly_coeff]
    have h2 : (LinearMap.charpoly (Algebra.lmul K M (algebraMap B M T))).coeff 0 =
        (-1) ^ ℓ * Algebra.norm K (algebraMap B M T) := by
      rw [hdet, ← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]
    rw [h2, map_mul, map_pow, map_neg, map_one, Algebra.norm_eq_prod_automorphisms, map_prod]
    congr 1
    exact Finset.prod_congr rfl (fun σ _ => (hψ σ T).symm)

  have hB : algebraMap A B e * ((-1) ^ ℓ * ∏ σ : M ≃ₐ[K] M, ψ σ T) =
      algebraMap A B (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * algebraMap A B n := by
    apply IsFractionRing.injective B M
    have h1 := congrArg (algebraMap K M) hrel
    rw [map_mul, map_mul, hcoeff, ← IsScalarTower.algebraMap_apply A K M,
      ← IsScalarTower.algebraMap_apply A K M, ← IsScalarTower.algebraMap_apply A K M,
      IsScalarTower.algebraMap_apply A B M e,
      IsScalarTower.algebraMap_apply A B M (t - algebraMap ↥W A c - algebraMap ↥W A z₀),
      IsScalarTower.algebraMap_apply A B M n] at h1
    rw [map_mul, map_mul, map_mul, map_pow, map_neg, map_one]
    exact h1

  have hπeq := congrArg (wcNooPi W B 𝔮) hB
  rw [map_mul, map_mul, map_mul, map_pow, map_neg, map_one, map_prod, hπX] at hπeq
  have hEu : IsUnit (wcNooPi W B 𝔮 (algebraMap A B e)) := by
    have h1 : algebraMap A B e ∉ 𝔮 := fun h' => he (by rw [← h𝔮c]; exact h')
    have h2 : IsUnit (algebraMap B (Localization.AtPrime 𝔮) (algebraMap A B e)) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔮 _).mpr h1
    exact h2.map (Ideal.Quotient.mk _)

  have hcard : (Finset.univ : Finset (M ≃ₐ[K] M)).card = ℓ := by
    rw [Finset.card_univ]
    first
      | exact IsGalois.card_aut_eq_finrank K M
      | (rw [← Nat.card_eq_fintype_card]; exact IsGalois.card_aut_eq_finrank K M)
  have hassoc : Associated (wcNooPi W B 𝔮 T ^ ℓ) (∏ σ : M ≃ₐ[K] M, wcNooPi W B 𝔮 (ψ σ T)) := by
    have := Associated.prod Finset.univ (fun _ => wcNooPi W B 𝔮 T)
      (fun σ => wcNooPi W B 𝔮 (ψ σ T))
      (fun σ _ => IsDiscreteValuationRing.associated_of_irreducible (ha := hirrT) (hb := hirrσ σ))
    rwa [Finset.prod_const, hcard] at this
  obtain ⟨w, hw⟩ := hassoc
  have hϖ0 : wcNooPi W B 𝔮 T ≠ 0 := hirrT.ne_zero
  have hℓpos : 0 < ℓ := Module.finrank_pos

  intro hn
  rw [h𝔭eq] at hn
  obtain ⟨α, μ, hμ, hαμ⟩ := Ideal.mem_span_singleton_sup.mp hn
  have hπn : wcNooPi W B 𝔮 (algebraMap A B n) =
      wcNooPi W B 𝔮 (algebraMap A B α) * wcNooPi W B 𝔮 (algebraMap A B (t - algebraMap ↥W A c)) := by
    rw [← hαμ, map_add, map_mul, map_add, map_mul, hπA μ hμ, add_zero, hπt]
  rw [hπn] at hπeq

  have hZ0 : wcNooPi W B 𝔮 (algebraMap A B (t - algebraMap ↥W A c)) ≠ 0 := by
    intro hZ
    rw [hZ, zero_mul] at hπeq
    have hne : wcNooPi W B 𝔮 (algebraMap A B e) *
        ((-1) ^ ℓ * ∏ σ : M ≃ₐ[K] M, wcNooPi W B 𝔮 (ψ σ T)) ≠ 0 := by
      refine mul_ne_zero hEu.ne_zero (mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) ?_)
      rw [← hw]
      exact mul_ne_zero (pow_ne_zero _ hϖ0) w.ne_zero
    exact hne hπeq
  obtain ⟨r, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hZ0 hirrT

  have hfin : Module.Finite A ↥(integralClosure A M) :=
    wcpa_dj_llsm_smni_noo_closure_finite A K M
      (wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K M 𝔭 (.disc t) hPD)
  have hden := wcpa_dj_llsm_smni_noo_denominators Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc hstab
  have hℓr : ℓ ≤ r := wcpa_dj_llsm_smni_noo_fibre_degree Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc
    c c₃ hc hc₃ hfin hden r ⟨↑u⁻¹, by rw [hu, mul_comm (↑u : wcNooFib W B 𝔮) _, mul_assoc,
      Units.mul_inv, mul_one]⟩

  obtain ⟨d, hd⟩ : ∃ d, 2 * r = ℓ + 1 + d := ⟨2 * r - (ℓ + 1), by omega⟩
  have key : wcNooPi W B 𝔮 T ^ ℓ *
      (wcNooPi W B 𝔮 (algebraMap A B e) * (-1) ^ ℓ * (w : wcNooFib W B 𝔮)) =
      wcNooPi W B 𝔮 T ^ ℓ * (wcNooPi W B 𝔮 T * (wcNooPi W B 𝔮 T ^ d *
        ((u : wcNooFib W B 𝔮) * (u : wcNooFib W B 𝔮) * wcNooPi W B 𝔮 (algebraMap A B α)))) := by
    have e1 : wcNooPi W B 𝔮 T ^ ℓ * (wcNooPi W B 𝔮 T * wcNooPi W B 𝔮 T ^ d) =
        wcNooPi W B 𝔮 T ^ r * wcNooPi W B 𝔮 T ^ r := by
      rw [← pow_succ', ← pow_add, ← pow_add, show ℓ + (d + 1) = r + r by omega]
    have e2 : wcNooPi W B 𝔮 T ^ ℓ *
        (wcNooPi W B 𝔮 (algebraMap A B e) * (-1) ^ ℓ * (w : wcNooFib W B 𝔮)) =
        wcNooPi W B 𝔮 (algebraMap A B e) *
          ((-1) ^ ℓ * ∏ σ : M ≃ₐ[K] M, wcNooPi W B 𝔮 (ψ σ T)) := by
      rw [← hw]; ring
    rw [e2, hπeq, hu]
    linear_combination (-((u : wcNooFib W B 𝔮) * (u : wcNooFib W B 𝔮) *
      wcNooPi W B 𝔮 (algebraMap A B α))) * e1
  have key2 := mul_left_cancel₀ (pow_ne_zero ℓ hϖ0) key
  have hU : IsUnit (wcNooPi W B 𝔮 (algebraMap A B e) * (-1) ^ ℓ * (w : wcNooFib W B 𝔮)) :=
    (hEu.mul (isUnit_one.neg.pow ℓ)).mul w.isUnit
  rw [key2] at hU
  exact hirrT.not_isUnit (isUnit_of_mul_isUnit_left hU)

theorem wcpa_dj_llsm_smni_valuation_match : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ →
      ∀ (z₀ : ↥W) (e n : A), z₀ ∈ IsLocalRing.maximalIdeal ↥W → b ∣ z₀ → e ∉ 𝔭 → n ∉ 𝔭 →
        algebraMap A K e * (LinearMap.charpoly
            (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff 0 =
          algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * algebraMap A K n →
        b ∣ b₃ ^ Module.finrank K M ∧ b₃ ^ Module.finrank K M ∣ b :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre z₀ e n hz₀ hbz₀ he hn hrel
  classical

  have hs3 : ∀ (G : Type u) [Fintype G],
      (∀ a ∈ IsLocalRing.maximalIdeal ↥W, ∃ (τ : G → ↥W) (x y : ↥W), IsUnit x ∧ IsUnit y ∧
        x * ∏ g, τ g = a * y ∧ ∀ g, (b ∣ z₀ + a ↔ b₃ ∣ τ g)) →
      b ∣ b₃ ^ Fintype.card G ∧ b₃ ^ Fintype.card G ∣ b := by
    intro G _ H
    have h1 : b₃ ^ Fintype.card G ∣ b := by
      obtain ⟨τ, x, y, hx, hy, he, hiff⟩ := H b hb
      have hd : ∀ g, b₃ ∣ τ g := fun g => (hiff g).1 (dvd_add hbz₀ dvd_rfl)
      have h3 : b₃ ^ Fintype.card G ∣ ∏ g, τ g := by
        rw [← Finset.card_univ, ← Finset.prod_const]
        exact Finset.prod_dvd_prod_of_dvd _ _ (fun g _ => hd g)
      have h2 : b₃ ^ Fintype.card G ∣ b * y := he ▸ dvd_mul_of_dvd_right h3 x
      exact hy.dvd_mul_right.mp h2
    refine ⟨?_, h1⟩
    obtain ⟨δ, hδ⟩ := h1
    by_cases hδu : IsUnit δ
    · rw [hδ]; exact hδu.mul_right_dvd.mpr dvd_rfl
    exfalso
    have hδ0 : δ ≠ 0 := by rintro rfl; exact hb0 (by rw [hδ, mul_zero])
    have hδΩ : (δ : Ω) ≠ 0 := fun h => hδ0 (Subtype.ext h)
    obtain ⟨ε, hε⟩ := IsAlgClosed.exists_pow_nat_eq (δ : Ω) two_pos
    have hεW : ε ∈ W := by
      rcases W.mem_or_inv_mem ε with h | h
      · exact h
      · exfalso
        apply hδu
        have hm : (δ : Ω)⁻¹ ∈ W := by rw [← hε, ← inv_pow]; exact W.pow_mem h 2
        exact isUnit_iff_exists_inv.mpr ⟨⟨(δ : Ω)⁻¹, hm⟩, Subtype.ext (by simp [hδΩ])⟩
    set εW : ↥W := ⟨ε, hεW⟩ with hεWdef
    have hεsq : εW * εW = δ := Subtype.ext (by simp [εW, ← hε, pow_two])
    have hεu : ¬ IsUnit εW := fun hu => hδu (hεsq ▸ hu.mul hu)
    have hε0 : εW ≠ 0 := by rintro h0; rw [h0, zero_mul] at hεsq; exact hδ0 hεsq.symm
    have hεm : εW ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hεu
    have hpow0 : b₃ ^ Fintype.card G ≠ 0 := pow_ne_zero _ hb₃0
    obtain ⟨τ, x, y, hx, hy, he, hiff⟩ :=
      H (b₃ ^ Fintype.card G * εW) (Ideal.mul_mem_left _ _ hεm)
    have hnd : ¬ b ∣ z₀ + b₃ ^ Fintype.card G * εW := by
      intro hd
      have h2 : b ∣ b₃ ^ Fintype.card G * εW := by
        have := dvd_sub hd hbz₀
        rwa [add_sub_cancel_left] at this
      rw [hδ, ← hεsq, ← mul_one (b₃ ^ Fintype.card G * εW), mul_assoc,
        mul_dvd_mul_iff_left hpow0, mul_dvd_mul_iff_left hε0] at h2
      exact hεu (isUnit_of_dvd_one h2)
    have hτ : ∀ g, τ g ∣ b₃ := fun g =>
      ((ValuationRing.dvd_total b₃ (τ g)).resolve_left (fun h' => hnd ((hiff g).2 h')))
    have h3 : ∏ g, τ g ∣ b₃ ^ Fintype.card G := by
      rw [← Finset.card_univ, ← Finset.prod_const]
      exact Finset.prod_dvd_prod_of_dvd _ _ (fun g _ => hτ g)
    have h4 : b₃ ^ Fintype.card G * (εW * y) ∣ b₃ ^ Fintype.card G * x := by
      rw [← mul_assoc, ← he, mul_comm (b₃ ^ Fintype.card G) x]
      exact mul_dvd_mul_left x h3
    rw [mul_dvd_mul_iff_left hpow0] at h4
    exact hεu (isUnit_of_dvd_unit (dvd_of_mul_right_dvd h4) hx)

  have hIC : IsIntegrallyClosed A := hPD.2.2.1
  have hS1 : h ∉ 𝔭 := hSmc.1
  have hS2 := hSmc.2.1
  have hS4 : 𝔮.comap (algebraMap A B) = 𝔭 := hSmc.2.2.2.1
  have hS5 := hSmc.2.2.2.2
  have hinjB : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  have hinjA : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hinjKM : Function.Injective (algebraMap K M) := (algebraMap K M).injective

  have hσA : ∀ (σ : M ≃ₐ[K] M) (a : A), σ (algebraMap A M a) = algebraMap A M a := fun σ a => by
    rw [IsScalarTower.algebraMap_apply A K M, AlgEquiv.commutes]
  have hs1 : ∀ σ : M ≃ₐ[K] M, ∃ σB : B →ₐ[A] B,
      ∀ x : B, algebraMap B M (σB x) = σ (algebraMap B M x) := by
    intro σ
    have hr : ∀ x : B, σ (algebraMap B M x) ∈ Set.range (algebraMap B M) := by
      intro x
      obtain ⟨k, hk⟩ := (hS2 _).1 ⟨x, rfl⟩
      refine (hS2 _).2 ⟨k, ?_⟩
      have := hk.map ((σ : M →ₐ[K] M).restrictScalars A)
      rw [map_mul, map_pow] at this
      simpa [hσA] using this
    choose f hf using hr
    refine ⟨
      { toFun := f
        map_one' := hinjB (by rw [hf, map_one, map_one])
        map_mul' := fun x y => hinjB (by rw [hf, map_mul, map_mul, map_mul, hf, hf])
        map_zero' := hinjB (by rw [hf, map_zero, map_zero])
        map_add' := fun x y => hinjB (by rw [hf, map_add, map_add, map_add, hf, hf])
        commutes' := fun a => hinjB (by
          rw [hf, ← IsScalarTower.algebraMap_apply A B M, hσA]) }, hf⟩
  choose σB hσB using hs1

  set y : B := t' - algebraMap ↥W B c₃ with hy
  set Y : M := algebraMap B M y with hY
  set ℓ : ℕ := Module.finrank K M with hℓ
  have hcard : Fintype.card (M ≃ₐ[K] M) = ℓ := by
    rw [Fintype.card_eq_nat_card, IsGalois.card_aut_eq_finrank]

  have hnormB : algebraMap B M (∏ σ : M ≃ₐ[K] M, σB σ y) =
      algebraMap K M (Algebra.norm K Y) := by
    rw [map_prod, Algebra.norm_eq_prod_automorphisms]
    exact Finset.prod_congr rfl (fun σ _ => hσB σ y)
  obtain ⟨k, hk⟩ := (hS2 _).1 ⟨_, hnormB⟩
  have hk' : IsIntegral A (algebraMap A K h ^ k * Algebra.norm K Y) := by
    rw [← isIntegral_algHom_iff (IsScalarTower.toAlgHom A K M) hinjKM]
    convert hk using 1
    simp [IsScalarTower.algebraMap_apply A K M]
  obtain ⟨ν₀, hν₀⟩ := IsIntegrallyClosed.isIntegral_iff.mp hk'
  have hν₀B : algebraMap A B ν₀ = algebraMap A B h ^ k * ∏ σ : M ≃ₐ[K] M, σB σ y := by
    apply hinjB
    rw [map_mul, map_pow, hnormB, ← IsScalarTower.algebraMap_apply A B M,
      IsScalarTower.algebraMap_apply A K M, hν₀, map_mul, map_pow,
      ← IsScalarTower.algebraMap_apply A K M, ← IsScalarTower.algebraMap_apply A B M]

  have hcoeff : (LinearMap.charpoly (Algebra.lmul K M Y)).coeff 0 =
      (-1) ^ ℓ * Algebra.norm K Y := by
    rw [Algebra.norm_apply, LinearMap.det_eq_sign_charpoly_coeff, ← mul_assoc, ← mul_pow]
    simp

  have hA : e * ((-1) ^ ℓ * ν₀) = h ^ k * (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * n := by
    apply hinjA
    rw [hcoeff] at hrel
    simp only [map_mul, map_pow, map_neg, map_one]
    rw [hν₀]
    linear_combination (algebraMap A K h ^ k) * hrel

  have hH : ∀ a ∈ IsLocalRing.maximalIdeal ↥W, ∃ (τ : (M ≃ₐ[K] M) → ↥W) (x y : ↥W),
      IsUnit x ∧ IsUnit y ∧ x * ∏ g, τ g = a * y ∧ ∀ g, (b ∣ z₀ + a ↔ b₃ ∣ τ g) := by
    intro a ha
    have hcza : c + z₀ + a ∈ IsLocalRing.maximalIdeal ↥W :=
      add_mem (add_mem hc hz₀) ha
    obtain ⟨θ, hθt, hθc⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt A 𝔭 t hPD _ hcza
    obtain ⟨θ₀, hθ₀A, hθ₀c⟩ := wcpa_dj_llsm_sm_point_lift Ω W hW hWt A K M B 𝔭 t h 𝔮 t'
      hPD hSmc θ hθc
    have hunit : ∀ u : A, u ∉ 𝔭 → IsUnit (θ u) := by
      intro u hu
      refine IsLocalRing.notMem_maximalIdeal.mp ?_
      intro hm
      apply hu
      rw [← hθc]
      exact hm
    have hθh0 : θ h ^ k ≠ 0 := pow_ne_zero _ (hunit h hS1).ne_zero
    let θ' : (M ≃ₐ[K] M) → (B →ₐ[↥W] ↥W) := fun σ => θ₀.comp ((σB σ).restrictScalars ↥W)
    have hθ'apply : ∀ σ x, θ' σ x = θ₀ (σB σ x) := fun σ x => rfl
    have hθ'A : ∀ σ x, θ' σ (algebraMap A B x) = θ x := by
      intro σ x
      rw [hθ'apply, AlgHom.commutes, hθ₀A]
    have hθ'c : ∀ σ, (IsLocalRing.maximalIdeal ↥W).comap (θ' σ) = 𝔮 := by
      intro σ
      have h𝔮p : 𝔮.IsPrime := by rw [← hθ₀c]; exact Ideal.IsPrime.comap _
      have e1 : (IsLocalRing.maximalIdeal ↥W).comap (θ' σ) = 𝔮.comap (σB σ) := by
        ext x
        rw [Ideal.mem_comap, Ideal.mem_comap, hθ'apply, ← hθ₀c, Ideal.mem_comap]
      rw [e1]
      apply hS5
      · exact Ideal.IsPrime.comap _
      · ext x
        rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes, ← Ideal.mem_comap, hS4]

    have hθA := congrArg θ hA
    simp only [map_mul, map_pow, map_neg, map_one, map_sub, AlgHom.commutes] at hθA
    have hθν₀ : θ ν₀ = θ h ^ k * ∏ σ : M ≃ₐ[K] M, θ' σ y := by
      have := congrArg θ₀ hν₀B
      rw [hθ₀A, map_mul, map_pow, hθ₀A, map_prod] at this
      exact this
    rw [hθν₀, hθt] at hθA
    have hZ : c + z₀ + a - algebraMap ↥W ↥W c - algebraMap ↥W ↥W z₀ = a := by
      simp only [Algebra.algebraMap_self, RingHom.id_apply]; ring
    rw [hZ] at hθA
    refine ⟨fun σ => θ' σ y, θ e * (-1) ^ ℓ, θ n, (hunit e he).mul (isUnit_neg_one.pow _),
      hunit n hn, ?_, ?_⟩
    · apply mul_left_cancel₀ hθh0
      linear_combination hθA
    · intro σ
      have hp := hPre (θ' σ) (hθ'c σ)
      rw [hθ'A, hθt, show c + z₀ + a - c = z₀ + a by ring] at hp
      rw [hp]
      have : θ' σ t' - c₃ = θ' σ y := by
        rw [hy, map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
      rw [this]
  have := hs3 (M ≃ₐ[K] M) hH
  rw [hcard] at this
  exact this

theorem wcpa_dj_llsm_smni_coeff_expansion : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ →
      ∀ z₀ : ↥W, z₀ ∈ IsLocalRing.maximalIdeal ↥W → b ∣ z₀ →
        ∀ i < Module.finrank K M, ∃ s : A, s ∉ 𝔭 ∧ ∃ (ε : ↥W) (α : A),
          algebraMap A K s * ((LinearMap.charpoly
              (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff i -
            algebraMap A K (algebraMap ↥W A (b₃ ^ (Module.finrank K M - i) * ε))) =
          algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * algebraMap A K α :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hPre z₀ hz₀ hbz₀ i hi
  classical
  have hPD' := hPD
  obtain ⟨-, hNZ, hIC, h𝔭max, -, -, -, -⟩ := hPD'
  have hSmc' := hSmc
  obtain ⟨hh𝔭, hS2, -, -, hS5⟩ := hSmc'
  haveI := hIC
  haveI := hNZ
  have hinjB : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  have hinjA : Function.Injective (algebraMap A K) := IsFractionRing.injective A K

  have hwinj : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [Algebra.algebraMap_eq_smul_one] at hx
    exact (smul_eq_zero.mp hx).resolve_right one_ne_zero
  have hbnu : ¬ IsUnit b := fun hu => (IsLocalRing.mem_maximalIdeal b).mp hb hu
  haveI : Infinite K := Infinite.of_injective
    (fun n : ℕ => algebraMap A K (algebraMap ↥W A (b ^ n)))
    (fun n m hnm => pow_injective_of_not_isUnit hbnu hb0 (hwinj (hinjA hnm)))

  have hchar : ∀ x : M, (LinearMap.charpoly (Algebra.lmul K M x)).map (algebraMap K M) =
      ∏ σ : M ≃ₐ[K] M, (Polynomial.X - Polynomial.C (σ x)) := by
    intro x
    apply Polynomial.eq_of_infinite_eval_eq
    apply Set.Infinite.mono (s := Set.range (algebraMap K M))
    · rintro _ ⟨l, rfl⟩
      show _ = _
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply, LinearMap.eval_charpoly]
      have hl : algebraMap K (Module.End K M) l - Algebra.lmul K M x =
          Algebra.lmul K M (algebraMap K M l - x) := by
        ext y
        simp [Algebra.smul_def]
      rw [hl, ← Algebra.norm_apply, Algebra.norm_eq_prod_automorphisms, Polynomial.eval_prod]
      refine Finset.prod_congr rfl (fun σ _ => ?_)
      simp
    · exact Set.infinite_range_of_injective (algebraMap K M).injective

  have hcoeff : ∀ (ι : Type u) [Fintype ι] (f : ι → ↥W) (d : ↥W), (∀ j : ι, d ∣ f j) →
      ∀ i : ℕ, i ≤ Fintype.card ι → ∃ ε : ↥W,
        (∏ j : ι, (Polynomial.X - Polynomial.C (f j))).coeff i = d ^ (Fintype.card ι - i) * ε := by
    intro ι _ f d hf i hi
    choose g hg using hf
    have hprod : (∏ j : ι, (Polynomial.X - Polynomial.C (f j))) =
        (((Finset.univ.val.map g).map (fun r => d • r)).map
          (fun r => Polynomial.X - Polynomial.C r)).prod := by
      rw [Finset.prod_eq_multiset_prod, Multiset.map_map, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro j _
      simp [hg j, smul_eq_mul]
    have hcard : Multiset.card ((Finset.univ.val.map g).map (fun r => d • r)) =
        Fintype.card ι := by
      simp [Finset.card_univ]
    rw [hprod, Multiset.prod_X_sub_C_coeff _ (by rw [hcard]; exact hi), hcard,
      ← Multiset.pow_smul_esymm]
    exact ⟨(-1) ^ (Fintype.card ι - i) * (Finset.univ.val.map g).esymm (Fintype.card ι - i),
      by rw [smul_eq_mul]; ring⟩

  have hcz : c + z₀ ∈ IsLocalRing.maximalIdeal ↥W := add_mem hc hz₀
  obtain ⟨θ, hθt, hθc⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt A 𝔭 t hPD (c + z₀) hcz
  have hθw : ∀ x : ↥W, θ (algebraMap ↥W A x) = x := fun x => θ.commutes x

  obtain ⟨θ₀, hθ₀A, -⟩ :=
    wcpa_dj_llsm_sm_point_lift Ω W hW hWt A K M B 𝔭 t h 𝔮 t' hPD hSmc θ hθc
  have hfixA : ∀ (σ : M ≃ₐ[K] M) (a : A), σ (algebraMap A M a) = algebraMap A M a := by
    intro σ a
    rw [IsScalarTower.algebraMap_apply A K M, AlgEquiv.commutes]
  have hrange : ∀ (σ : M ≃ₐ[K] M) (y : B), ∃ y' : B,
      algebraMap B M y' = σ (algebraMap B M y) := by
    intro σ y
    obtain ⟨k, hk⟩ := (hS2 (algebraMap B M y)).mp ⟨y, rfl⟩
    have h1 : IsIntegral A (σ (algebraMap A M h ^ k * algebraMap B M y)) :=
      hk.map (σ.restrictScalars A)
    rw [map_mul, map_pow, hfixA] at h1
    exact (hS2 _).mpr ⟨k, h1⟩
  choose σB hσB using hrange
  have hσBA : ∀ (σ : M ≃ₐ[K] M) (a : A), σB σ (algebraMap A B a) = algebraMap A B a :=
    fun σ a => hinjB (by rw [hσB, ← IsScalarTower.algebraMap_apply A B M, hfixA])
  let σR : (M ≃ₐ[K] M) → B →+* B := fun σ =>
    { toFun := σB σ
      map_one' := hinjB (by simp only [hσB, map_one])
      map_mul' := fun x y => hinjB (by simp only [hσB, map_mul])
      map_zero' := hinjB (by simp only [hσB, map_zero])
      map_add' := fun x y => hinjB (by simp only [hσB, map_add]) }
  let θ' : (M ≃ₐ[K] M) → B →ₐ[↥W] ↥W := fun σ =>
    AlgHom.mk ((θ₀ : B →+* ↥W).comp (σR σ)) (fun r => by
      show θ₀ (σB σ (algebraMap ↥W B r)) = algebraMap ↥W ↥W r
      rw [IsScalarTower.algebraMap_apply ↥W A B, hσBA, ← IsScalarTower.algebraMap_apply ↥W A B,
        AlgHom.commutes])
  have hθ'v : ∀ σ y, θ' σ y = θ₀ (σB σ y) := fun σ y => rfl
  have hθ'c : ∀ σ, (IsLocalRing.maximalIdeal ↥W).comap (θ' σ) = 𝔮 := by
    intro σ
    apply hS5
    · infer_instance
    · ext a
      rw [Ideal.mem_comap, Ideal.mem_comap, hθ'v, hσBA, hθ₀A, ← hθc, Ideal.mem_comap]

  have hdiv : ∀ σ, b₃ ∣ θ₀ (σB σ (t' - algebraMap ↥W B c₃)) := by
    intro σ
    have h1 := (hPre (θ' σ) (hθ'c σ)).mp (by
      rw [hθ'v, hσBA, hθ₀A, hθt, add_sub_cancel_left]
      exact hbz₀)
    have e : θ₀ (σB σ (t' - algebraMap ↥W B c₃)) = θ' σ t' - c₃ := by
      rw [← hθ'v, map_sub, AlgHom.commutes]
      rfl
    rw [e]
    exact h1

  let P : Polynomial B := ∏ σ : M ≃ₐ[K] M,
    (Polynomial.X - Polynomial.C (σB σ (t' - algebraMap ↥W B c₃)))
  have hP1 : P.map (algebraMap B M) = (LinearMap.charpoly
      (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).map (algebraMap K M) := by
    rw [hchar]
    simp only [P, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hσB]
  have hP2 : P.map (θ₀ : B →+* ↥W) = ∏ σ : M ≃ₐ[K] M,
      (Polynomial.X - Polynomial.C (θ₀ (σB σ (t' - algebraMap ↥W B c₃)))) := by
    simp only [P, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
    rfl

  have hE1 : algebraMap B M (P.coeff i) = algebraMap K M ((LinearMap.charpoly
      (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff i) := by
    rw [← Polynomial.coeff_map, hP1, Polynomial.coeff_map]

  have hcard : Fintype.card (M ≃ₐ[K] M) = Module.finrank K M := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank]
  obtain ⟨ε, hε⟩ := hcoeff (M ≃ₐ[K] M) (fun σ => θ₀ (σB σ (t' - algebraMap ↥W B c₃))) b₃ hdiv i
    (by rw [hcard]; exact hi.le)
  rw [hcard] at hε
  have hE2 : θ₀ (P.coeff i) = b₃ ^ (Module.finrank K M - i) * ε := by
    show (θ₀ : B →+* ↥W) (P.coeff i) = _
    rw [← Polynomial.coeff_map, hP2, hε]

  obtain ⟨N, hN⟩ := (hS2 (algebraMap K M ((LinearMap.charpoly
      (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff i))).mp ⟨P.coeff i, hE1⟩
  have hN' : IsIntegral A (algebraMap A K h ^ N * (LinearMap.charpoly
      (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff i) := by
    have e : algebraMap A M h ^ N * algebraMap K M ((LinearMap.charpoly
        (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff i) =
        IsScalarTower.toAlgHom A K M (algebraMap A K h ^ N * (LinearMap.charpoly
          (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff i) := by
      rw [IsScalarTower.toAlgHom_apply, map_mul, map_pow, ← IsScalarTower.algebraMap_apply]
    rw [e] at hN
    exact (isIntegral_algHom_iff _ (algebraMap K M).injective).mp hN
  obtain ⟨α', hα'⟩ := (IsIntegrallyClosed.isIntegral_iff (R := A) (K := K)).mp hN'

  have hαB : algebraMap A B α' = algebraMap A B h ^ N * P.coeff i := by
    apply hinjB
    rw [map_mul, map_pow, hE1, ← IsScalarTower.algebraMap_apply A B M,
      ← IsScalarTower.algebraMap_apply A B M, IsScalarTower.algebraMap_apply A K M,
      IsScalarTower.algebraMap_apply A K M h, hα', map_mul, map_pow]
  have hθα : θ α' = θ h ^ N * (b₃ ^ (Module.finrank K M - i) * ε) := by
    rw [← hθ₀A, hαB, map_mul, map_pow, hθ₀A, hE2]

  obtain ⟨ev, -, -, hsec⟩ := wcLlsAS_dsbu_section Ω W hW hWt A 𝔭 t (c + z₀) hPD hcz
  obtain ⟨a, ha⟩ : ∃ a : A,
      a = α' - h ^ N * algebraMap ↥W A (b₃ ^ (Module.finrank K M - i) * ε) := ⟨_, rfl⟩
  have hθa : θ a = 0 := by
    rw [ha, map_sub, map_mul, map_pow, hθw, hθα, sub_self]
  obtain ⟨s₁, e₁, hs₁, hse⟩ := hsec a
  have happ := congrArg θ hse
  simp only [map_mul, map_sub, hθa, hθw, hθt, sub_self, zero_mul, zero_sub, mul_neg,
    neg_eq_zero] at happ
  have hθs₁ : θ s₁ ≠ 0 := by
    intro h0
    apply hs₁
    rw [← hθc, Ideal.mem_comap, h0]
    exact Ideal.zero_mem _
  have hev0 : ev a = 0 := (mul_eq_zero.mp happ).resolve_left hθs₁
  rw [hev0, map_zero, sub_zero] at hse

  refine ⟨s₁ * h ^ N, h𝔭max.isPrime.mul_notMem hs₁
    (fun hm => hh𝔭 (h𝔭max.isPrime.mem_of_pow_mem _ hm)), ε, e₁, ?_⟩
  have hZ : t - algebraMap ↥W A c - algebraMap ↥W A z₀ = t - algebraMap ↥W A (c + z₀) := by
    rw [map_add]; ring
  have key := congrArg (algebraMap A K) hse
  rw [map_mul, map_mul, ← hZ, ha] at key
  simp only [map_mul, map_sub, map_pow, hα'] at key ⊢
  linear_combination key

theorem wcpa_dj_llsm_smni_nodes_proper : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsSmPre W A B 𝔮 t t' c b c₃ b₃ →
      wcLlsASbN W A K (t - algebraMap ↥W A c) b ≠ ⊤ ∧
        wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ ≠ ⊤ ∧
        t - algebraMap ↥W A c ≠ 0 ∧ t' - algebraMap ↥W B c₃ ≠ 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 _hPre

  have hsqrt : ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      ∃ ε : ↥W, ε ∈ IsLocalRing.maximalIdeal ↥W ∧ ε ≠ 0 ∧ ε * ε = b := by
    intro b hb hb0
    obtain ⟨e, he⟩ := IsAlgClosed.exists_pow_nat_eq (b : Ω) (by norm_num : 0 < 2)
    have hb0' : (b : Ω) ≠ 0 := fun h0 => hb0 (Subtype.ext h0)
    have he0 : e ≠ 0 := by
      rintro rfl
      apply hb0'
      rw [← he]
      ring
    have hbnu : ¬ IsUnit b := (IsLocalRing.mem_maximalIdeal _).mp hb
    have heW : e ∈ W := by
      rcases W.mem_or_inv_mem e with h1 | h1
      · exact h1
      · exfalso
        apply hbnu
        have hmul : b * ((⟨e⁻¹, h1⟩ : ↥W) * ⟨e⁻¹, h1⟩) = 1 := by
          apply Subtype.ext
          show (b : Ω) * (e⁻¹ * e⁻¹) = 1
          rw [← he]
          field_simp
        exact ⟨⟨b, _, hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩
    have hee : (⟨e, heW⟩ : ↥W) * ⟨e, heW⟩ = b := by
      apply Subtype.ext
      show e * e = (b : Ω)
      rw [← he]
      ring
    refine ⟨⟨e, heW⟩, ?_, ?_, hee⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply hbnu
      rw [← hee]
      exact hu.mul hu
    · intro h0
      apply he0
      exact congrArg Subtype.val h0

  have chart : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra ↥W R] (K' : Type u) [Field K']
      [Algebra R K'] [IsFractionRing R K'] (𝔯 : Ideal R) (τ : R) (c b : ↥W),
      wcLlsPD W R 𝔯 (.disc τ) → c ∈ IsLocalRing.maximalIdeal ↥W →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      wcLlsASbN W R K' (τ - algebraMap ↥W R c) b ≠ ⊤ ∧ τ - algebraMap ↥W R c ≠ 0 := by
    intro R _ _ _ K' _ _ _ 𝔯 τ c b hPD hc hb hb0
    obtain ⟨ε, hεm, hε0, hεε⟩ := hsqrt b hb hb0
    obtain ⟨θ, hθτ, -⟩ := wcpa_dj_llsm_sm_points_exist Ω W hW hWt R 𝔯 τ hPD (c + ε)
      (Ideal.add_mem _ hc hεm)
    have hθw : ∀ w : ↥W, θ (algebraMap ↥W R w) = w := fun w => by
      rw [θ.commutes]; rfl
    have hθu : θ (τ - algebraMap ↥W R c) = ε := by
      rw [map_sub, hθτ, hθw]; ring
    have hu0 : τ - algebraMap ↥W R c ≠ 0 := by
      intro h0; apply hε0; rw [← hθu, h0, map_zero]
    refine ⟨?_, hu0⟩
    set u := τ - algebraMap ↥W R c with hu
    set β := algebraMap ↥W R b with hβ
    have hinj := IsFractionRing.injective R K'
    set s : K' := algebraMap R K' β / algebraMap R K' u with hs
    have huK : algebraMap R K' u ≠ 0 := fun h0 => hu0 (hinj (by rw [h0, map_zero]))
    have hus : algebraMap R K' u * s = algebraMap R K' β := by
      rw [hs]; field_simp
    have hsS : s ∈ Algebra.adjoin R {s} := Algebra.subset_adjoin (Set.mem_singleton _)
    let π : Polynomial R →ₐ[R] ↥(Algebra.adjoin R {s}) := Polynomial.aeval (⟨s, hsS⟩ : _)
    have hπ : ∀ P, (((π P) : ↥(Algebra.adjoin R {s})) : K') = Polynomial.aeval s P :=
      fun P => Polynomial.aeval_subalgebra_coe P (Algebra.adjoin R {s}) ⟨s, hsS⟩
    have hsurj : Function.Surjective (π : Polynomial R →+* ↥(Algebra.adjoin R {s})) := by
      rintro ⟨x, hx⟩
      have hx' : x ∈ (Polynomial.aeval (R := R) s).range := by
        rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact hx
      obtain ⟨P, hP⟩ := hx'
      exact ⟨P, Subtype.ext (by
        show (((π P) : ↥(Algebra.adjoin R {s})) : K') = x
        rw [hπ]; exact hP)⟩
    let ψ : Polynomial R →+* ↥W := Polynomial.eval₂RingHom (θ : R →+* ↥W) ε
    have hθu' : (θ : R →+* ↥W) u * ε = (θ : R →+* ↥W) β := by
      show θ u * ε = θ β
      rw [hθu, hεε, hβ, hθw]
    have hθu0 : (θ : R →+* ↥W) u ≠ 0 := by
      show θ u ≠ 0
      rw [hθu]; exact hε0
    have hker : RingHom.ker (π : Polynomial R →+* ↥(Algebra.adjoin R {s})) ≤ RingHom.ker ψ := by
      intro P hP
      rw [RingHom.mem_ker] at hP ⊢
      have hP0 : π P = 0 := hP
      have hP' : Polynomial.eval₂ (algebraMap R K') s P = 0 := by
        rw [← Polynomial.aeval_def, ← hπ, hP0]; rfl
      have h1 := Polynomial.scaleRoots_eval₂_mul (p := P) (algebraMap R K') s u
      rw [hus, Polynomial.eval₂_at_apply, hP', mul_zero] at h1
      have hQ : (P.scaleRoots u).eval β = 0 := hinj (by rw [h1, map_zero])
      have h2 := Polynomial.scaleRoots_eval₂_mul (p := P) (θ : R →+* ↥W) ε u
      rw [hθu', Polynomial.eval₂_at_apply, hQ, map_zero] at h2
      have hpow : (θ : R →+* ↥W) u ^ P.natDegree ≠ 0 := pow_ne_zero _ hθu0
      show Polynomial.eval₂ (θ : R →+* ↥W) ε P = 0
      exact (mul_eq_zero.mp h2.symm).resolve_left hpow
    let Φ : ↥(Algebra.adjoin R {s}) →+* ↥W :=
      (RingHom.liftOfSurjective (π : Polynomial R →+* ↥(Algebra.adjoin R {s})) hsurj) ⟨ψ, hker⟩
    have hΦ : ∀ P, Φ (π P) = ψ P := fun P =>
      RingHom.liftOfRightInverse_comp_apply _ _ _ ⟨ψ, hker⟩ P
    have hΦC : ∀ r : R, Φ (algebraMap R ↥(Algebra.adjoin R {s}) r) = θ r := by
      intro r
      have e1 : algebraMap R ↥(Algebra.adjoin R {s}) r = π (Polynomial.C r) :=
        (Polynomial.aeval_C _ _).symm
      rw [e1, hΦ]
      show Polynomial.eval₂ (θ : R →+* ↥W) ε (Polynomial.C r) = θ r
      rw [Polynomial.eval₂_C]
      rfl
    have hΦX : Φ ⟨s, hsS⟩ = ε := by
      have e1 : (⟨s, hsS⟩ : ↥(Algebra.adjoin R {s})) = π Polynomial.X :=
        (Polynomial.aeval_X _).symm
      rw [e1, hΦ]
      show Polynomial.eval₂ (θ : R →+* ↥W) ε Polynomial.X = ε
      rw [Polynomial.eval₂_X]
    have hN : wcLlsASbN W R K' u b ≤ (IsLocalRing.maximalIdeal ↥W).comap Φ := by
      unfold wcLlsASbN
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases Set.mem_insert_iff.mp hx with h1 | h1
        · rw [h1]
          show Φ (algebraMap R ↥(Algebra.adjoin R {s}) u) ∈ IsLocalRing.maximalIdeal ↥W
          rw [hΦC, hθu]
          exact hεm
        · rw [Set.mem_singleton_iff] at h1
          rw [h1]
          show Φ ⟨s, hsS⟩ ∈ IsLocalRing.maximalIdeal ↥W
          rw [hΦX]
          exact hεm
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        show Φ (algebraMap R ↥(Algebra.adjoin R {s}) (algebraMap ↥W R w)) ∈
          IsLocalRing.maximalIdeal ↥W
        rw [hΦC, hθw]
        exact hw
    intro htop
    rw [htop, top_le_iff] at hN
    exact Ideal.comap_ne_top Φ (IsLocalRing.maximalIdeal.isMaximal _).ne_top hN

  obtain ⟨hNA, hZ⟩ := chart A K 𝔭 t c b hPD hc hb hb0
  obtain ⟨hNB, hT⟩ := chart B M 𝔮 t' c₃ b₃ hSmc.2.2.1 hc₃ hb₃ hb₃0
  exact ⟨hNA, hNB, hZ, hT⟩

theorem wcpa_dj_llsm_smni_assembly : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b c₃ b₃ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → c₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ∈ IsLocalRing.maximalIdeal ↥W → b₃ ≠ 0 →
      wcLlsASbN W A K (t - algebraMap ↥W A c) b ≠ ⊤ →
      wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ ≠ ⊤ →
      t - algebraMap ↥W A c ≠ 0 → t' - algebraMap ↥W B c₃ ≠ 0 →
      ∀ (z₀ : ↥W) (e n : A), z₀ ∈ IsLocalRing.maximalIdeal ↥W → b ∣ z₀ → e ∉ 𝔭 → n ∉ 𝔭 →
        algebraMap A K e * (LinearMap.charpoly
            (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff 0 =
          algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * algebraMap A K n →
        b ∣ b₃ ^ Module.finrank K M → b₃ ^ Module.finrank K M ∣ b →
        (∀ i < Module.finrank K M, ∃ s : A, s ∉ 𝔭 ∧ ∃ (ε : ↥W) (α : A),
          algebraMap A K s * ((LinearMap.charpoly
              (Algebra.lmul K M (algebraMap B M (t' - algebraMap ↥W B c₃)))).coeff i -
            algebraMap A K (algebraMap ↥W A (b₃ ^ (Module.finrank K M - i) * ε))) =
          algebraMap A K (t - algebraMap ↥W A c - algebraMap ↥W A z₀) * algebraMap A K α) →
      (∃ p q : ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃),
        q ∉ wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ ∧
        p ∈ wcLlsASbN W B M (t' - algebraMap ↥W B c₃) b₃ ∧
        algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M q *
            algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
              algebraMap A K (t - algebraMap ↥W A c)) =
          algebraMap ↥(wcLlsASbS W B M (t' - algebraMap ↥W B c₃) b₃) M p) ∧
      (∃ g : Polynomial ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b),
        g.leadingCoeff ∉ wcLlsASbN W A K (t - algebraMap ↥W A c) b ∧
        (∀ j < g.natDegree, g.coeff j ∈ wcLlsASbN W A K (t - algebraMap ↥W A c) b) ∧
        Polynomial.eval₂ ((algebraMap K M).comp
            (algebraMap ↥(wcLlsASbS W A K (t - algebraMap ↥W A c) b) K))
          (algebraMap B M (algebraMap ↥W B b₃) / algebraMap B M (t' - algebraMap ↥W B c₃)) g = 0) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _
    𝔭 t h 𝔮 t' hPD hSmc c b c₃ b₃ hc hb hb0 hc₃ hb₃ hb₃0 hNA hNB hZ0 hT0 z₀ e n hz₀ hbz₀ he hn
    H2 hV1 hV2 H1
  classical

  have s1 : ∀ (T σ β : M), σ * T = β →
      (LinearMap.charpoly (Algebra.lmul K M T)).coeff (Module.finrank K M) = 1 ∧
      ∑ i ∈ Finset.range (Module.finrank K M + 1),
        algebraMap K M ((LinearMap.charpoly (Algebra.lmul K M T)).coeff i) * β ^ i *
          σ ^ (Module.finrank K M - i) = 0 := by
    intro T σ β hσ
    have hmon : (LinearMap.charpoly (Algebra.lmul K M T)).Monic := LinearMap.charpoly_monic _
    have hdeg : (LinearMap.charpoly (Algebra.lmul K M T)).natDegree = Module.finrank K M :=
      LinearMap.charpoly_natDegree _
    refine ⟨by rw [← hdeg]; exact hmon.coeff_natDegree, ?_⟩
    have hCH : Polynomial.aeval T (LinearMap.charpoly (Algebra.lmul K M T)) = 0 := by
      have h1 := LinearMap.aeval_self_charpoly (Algebra.lmul K M T)
      rw [Polynomial.aeval_algHom_apply] at h1
      have h3 := congrArg (fun f : Module.End K M => f 1) h1
      simpa using h3
    rw [Polynomial.aeval_eq_sum_range, hdeg] at hCH
    have h4 := congrArg (· * σ ^ Module.finrank K M) hCH
    simp only [Finset.sum_mul, zero_mul] at h4
    refine Eq.trans ?_ h4
    apply Finset.sum_congr rfl
    intro i hi
    have hi' : i ≤ Module.finrank K M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [Algebra.smul_def, ← hσ, mul_pow, show σ ^ Module.finrank K M =
      σ ^ (Module.finrank K M - i) * σ ^ i by rw [← pow_add, Nat.sub_add_cancel hi']]
    ring

  have s3 : ∀ (R : Type u) [CommRing R] (φ : R →+* M) (N : Ideal R) (ℓ : ℕ)
      (H : ℕ → R) (σ : M), H 0 ∉ N → (∀ i, 1 ≤ i → i ≤ ℓ → H i ∈ N) →
      ∑ i ∈ Finset.range (ℓ + 1), φ (H i) * σ ^ (ℓ - i) = 0 →
      ∃ g : Polynomial R, g.leadingCoeff ∉ N ∧ (∀ j < g.natDegree, g.coeff j ∈ N) ∧
        Polynomial.eval₂ φ σ g = 0 := by
    intro R _ φ N ℓ H σ h0 hi hs
    obtain ⟨g, hg⟩ : ∃ g : Polynomial R,
        g = ∑ j ∈ Finset.range (ℓ + 1), Polynomial.C (H (ℓ - j)) * Polynomial.X ^ j := ⟨_, rfl⟩
    have hcoeff : ∀ k, g.coeff k = if k ≤ ℓ then H (ℓ - k) else 0 := by
      intro k
      simp [hg, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow, Nat.lt_succ_iff]
    have hH0 : H 0 ≠ 0 := fun h => h0 (h ▸ N.zero_mem)
    have hdeg : g.natDegree = ℓ := by
      apply Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
      · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro k hk
        rw [hcoeff, if_neg (by exact_mod_cast (not_le.mpr hk))]
      · rw [hcoeff, if_pos le_rfl, Nat.sub_self]; exact hH0
    refine ⟨g, ?_, ?_, ?_⟩
    · rw [Polynomial.leadingCoeff, hdeg, hcoeff, if_pos le_rfl, Nat.sub_self]; exact h0
    · intro j hj
      rw [hdeg] at hj
      rw [hcoeff, if_pos hj.le]
      exact hi _ (by omega) (by omega)
    · rw [← hs, ← Finset.sum_range_reflect, hg]
      simp only [Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul, Polynomial.eval₂_C,
        Polynomial.eval₂_X_pow]
      apply Finset.sum_congr rfl
      intro j hj
      have : j ≤ ℓ := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      rw [show ℓ + 1 - 1 - j = ℓ - j by omega, show ℓ - (ℓ - j) = j by omega]

  have nodeMax : ∀ (D : Type u) [CommRing D] (P : Ideal D), P.IsMaximal →
      ∀ (T : Type u) [CommRing T] [Algebra D T] (s : T) (N : Ideal ↥(Algebra.adjoin D {s})),
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin D {s})) ∈ N →
      P ≤ N.comap (algebraMap D ↥(Algebra.adjoin D {s})) → N ≠ ⊤ → N.IsMaximal := by
    intro D _ P hP T _ _ s N hsN hPN hNt
    have span : ∀ (x : T) (hx : x ∈ Algebra.adjoin D {s}), ∃ a : D,
        (⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a ∈ N := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        refine ⟨0, ?_⟩
        rw [map_zero, sub_zero]
        have e : (⟨x, Algebra.subset_adjoin hx⟩ : ↥(Algebra.adjoin D {s})) =
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := Subtype.ext hx
        rw [e]; exact hsN
      | algebraMap d =>
        refine ⟨d, ?_⟩
        convert N.zero_mem using 1
        exact sub_eq_zero.mpr (Subtype.ext rfl)
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a + a', ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) -
            algebraMap D ↥(Algebra.adjoin D {s}) (a + a') =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a) +
            ((⟨y, hy⟩ : ↥(Algebra.adjoin D {s})) - algebraMap D ↥(Algebra.adjoin D {s}) a') := by
          have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin D {s})) =
