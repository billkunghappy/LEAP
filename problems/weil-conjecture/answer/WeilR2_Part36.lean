  have hBwet : (algebraMap B (Localization.Away w)).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (A := Localization.Away w) w)
  have hιwet : ((algebraMap B (Localization.Away w)).comp ι).Etale :=
