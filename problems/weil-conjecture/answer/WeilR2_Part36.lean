      wcNsrCentred (γ ≫ ι₀).toNormalization n V →
      ∃ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W ∧ b ∣ a₀ ∧ ¬ a₀ ∣ b ∧
        ∃ A'' : ValuationSubring C.functionField,
          wcNsrBdry W (γ ≫ ι) uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) A'' ∧
          wcUbShare W γ uX ι σ₀ b V A'' :=
by
  intro Ω _ _ W hW hWt C _ γ hcov hgal X uX ι _ _ hM y₀ hSm τ hτ hE σ₀ a₀ hP X₀ r₀ ι₀ _ _ hbl hι₀
