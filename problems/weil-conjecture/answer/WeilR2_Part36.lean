  intro R _ _ X uX x V hxV σ hσ hσx
  subst hσx
  have key : ∀ (U : X.Opens) (hU : σ (IsLocalRing.closedPoint R) ∈ U) (e' : ⊤ ≤ σ ⁻¹ᵁ U)
      (s : Γ(X, U)), (Scheme.stalkClosedPointTo σ).hom ((X.presheaf.germ U _ hU).hom s) =
        (Scheme.ΓSpecIso (.of R)).hom.hom ((σ.appLE U ⊤ e').hom s) := by
    intro U hU e' s
    show (X.presheaf.germ U _ hU ≫ Scheme.stalkClosedPointTo σ).hom s =
      (σ.appLE U ⊤ e' ≫ (Scheme.ΓSpecIso (.of R)).hom).hom s
    rw [Scheme.germ_stalkClosedPointTo]
    rfl
  refine ⟨(Scheme.stalkClosedPointTo σ).hom, inferInstance, ?_, ?_⟩
  · intro w
    have hκ : wcNdSig uX (σ (IsLocalRing.closedPoint R)) w =
        (X.presheaf.germ ⊤ _ trivial).hom
          (uX.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom w)) := by
      unfold wcNdSig wcCnSigma
      have h3 : (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op = 𝟙 _ := Subsingleton.elim _ _
      rw [h3, CategoryTheory.Functor.map_id]
      rfl
    have hle1 : (⊤ : X.Opens) ≤ uX ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]
    have e3 : (⊤ : (Spec (.of R)).Opens) ≤ σ ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]
    have h4 : uX.appLE ⊤ ⊤ hle1 = uX.appTop := Scheme.Hom.appLE_eq_app _
    have hth : (Scheme.ΓSpecIso (.of R)).hom.hom ((σ.appLE ⊤ ⊤ e3).hom ((uX.appLE ⊤ ⊤ hle1).hom
        ((Scheme.ΓSpecIso (.of R)).inv.hom w))) = w := by
      have keyid : ∀ (Y : Scheme.{u}) (f : Y ⟶ Y), f = 𝟙 Y → ∀ h : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ ⊤,
          f.appLE ⊤ ⊤ h = 𝟙 _ := by
        intro Y f hf h
        subst hf
        exact (Scheme.Hom.appLE_eq_app (𝟙 Y) (U := ⊤)).trans (Scheme.Hom.id_app (X := Y) ⊤)
      have h2 : uX.appLE ⊤ ⊤ hle1 ≫ σ.appLE ⊤ ⊤ e3 = 𝟙 _ := by
        rw [Scheme.Hom.appLE_comp_appLE]
        exact keyid _ _ hσ _
      have h3 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of R)).inv.hom w)) h2
      simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.comp_apply,
        RingHom.id_apply] at h3
      rw [h3]
      exact (Scheme.ΓSpecIso (.of R)).inv_hom_id_apply w
    rw [h4] at hth
    rw [hκ, key ⊤ trivial e3]
    exact hth
  · intro e' h
    exact key V hxV e' h

theorem wcpa_dj_lr1k_nsr_nlb_ue_ur_dp_section : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) (x : ↥X) (V : X.Opens) (hxV : x ∈ V) (ψ : ↥(X.presheaf.stalk x) →+* R), IsLocalHom ψ → (∀ w : R, ψ (wcNdSig uX x w) = w) → ∃ σ : Spec (.of R) ⟶ X, σ ≫ uX = 𝟙 _ ∧ σ (IsLocalRing.closedPoint R) = x ∧ ∀ (e' : ⊤ ≤ σ ⁻¹ᵁ V) (h : Γ(X, V)), (Scheme.ΓSpecIso (.of R)).hom.hom ((σ.appLE V ⊤ e').hom h) = ψ ((X.presheaf.germ V x hxV).hom h) :=
by
  intro R _ _ X uX x V hxV ψ hψ hret
  have : IsLocalHom (CommRingCat.ofHom ψ).hom := hψ
  let σ : Spec (.of R) ⟶ X := Spec.map (CommRingCat.ofHom ψ) ≫ X.fromSpecStalk x
  have hcl : σ (IsLocalRing.closedPoint R) = x := by
    have e1 : (Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint R) =
        IsLocalRing.closedPoint (X.presheaf.stalk x) := Spec_closedPoint
    have e2 := Scheme.fromSpecStalk_closedPoint (x := x)
    rw [← e1] at e2
    exact e2
  have key : ∀ (U : X.Opens) (hxU : x ∈ U) (e : ⊤ ≤ σ ⁻¹ᵁ U) (h : Γ(X, U)),
      (Scheme.ΓSpecIso (.of R)).hom.hom ((σ.appLE U ⊤ e).hom h) =
        ψ ((X.presheaf.germ U x hxU).hom h) := by
    intro U hxU e h
    have hU : σ (IsLocalRing.closedPoint R) ∈ U := hcl ▸ hxU
    have h1 := congrArg (fun φ => φ.hom h) (Scheme.germ_stalkClosedPointTo σ U hU)
    have h2 := congrArg (fun φ => φ.hom h)
      (Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk (R := .of R) (CommRingCat.ofHom ψ) U hU)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1 h2
    refine Eq.trans ?_ (h1.symm.trans h2)
    rfl
  refine ⟨σ, ?_, hcl, fun e' h => key V hxV e' h⟩
  apply ext_of_isAffine
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop]
  ext r
  have hinj : Function.Injective (Scheme.ΓSpecIso (.of R)).hom.hom := by
    intro a b hab
    have := congrArg (Scheme.ΓSpecIso (.of R)).inv.hom hab
    simpa using this
  apply hinj
  have hr := key ⊤ trivial (le_refl (σ ⁻¹ᵁ ⊤) : (⊤ : (Spec (.of R)).Opens) ≤ σ ⁻¹ᵁ ⊤) (uX.appTop.hom r)
  have hw := hret ((Scheme.ΓSpecIso (.of R)).hom.hom r)
  have hN : wcNdSig uX x ((Scheme.ΓSpecIso (.of R)).hom.hom r) =
      (X.presheaf.germ ⊤ x trivial).hom (uX.appTop.hom r) := by
    simp [wcNdSig, wcCnSigma]
  rw [hN] at hw
  have hA : σ.appLE ⊤ ⊤ (le_refl (σ ⁻¹ᵁ ⊤) : (⊤ : (Spec (.of R)).Opens) ≤ σ ⁻¹ᵁ ⊤) = σ.appTop := by
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl
  rw [hA] at hr
  simp only [CommRingCat.comp_apply, CommRingCat.id_apply]
  rw [hr, hw]

theorem wcpa_dj_lr1k_nsr_nlb_ue_ur_dp_ev_hom : ∀ (R O L : Type u) [CommRing R] [IsLocalRing R] [CommRing O] [IsLocalRing O] [CommRing L] (G : O →+* L) (φ : R →+* L) (t : L), (∀ P : Polynomial R, P.eval₂ φ t = 0 → P = 0) → (∀ s : O, ∃ p q : Polynomial R, IsUnit (q.coeff 0) ∧ (s ∈ IsLocalRing.maximalIdeal O → p.coeff 0 ∈ IsLocalRing.maximalIdeal R) ∧ G s * q.eval₂ φ t = p.eval₂ φ t) → ∀ c ∈ IsLocalRing.maximalIdeal R, ∃ ψ : O →+* R, IsLocalHom ψ ∧ ∀ (s : O) (p q : Polynomial R), IsUnit (q.coeff 0) → G s * q.eval₂ φ t = p.eval₂ φ t → ψ s * q.eval c = p.eval c :=
by
  intro R O L _ _ _ _ _ G φ t htr hdict c hc
  classical
  have hdiff : ∀ q : Polynomial R, q.eval c - q.coeff 0 ∈ IsLocalRing.maximalIdeal R := by
    intro q
    obtain ⟨k, hk⟩ := Polynomial.sub_dvd_eval_sub c 0 q
    rw [Polynomial.coeff_zero_eq_eval_zero, hk, sub_zero]
    exact Ideal.mul_mem_right _ _ hc
  have hunit : ∀ q : Polynomial R, IsUnit (q.coeff 0) → IsUnit (q.eval c) := by
    intro q hq
    by_contra h
    have h1 : q.eval c ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr h
    have h2 : q.coeff 0 ∈ IsLocalRing.maximalIdeal R := by
      have h3 := Ideal.sub_mem _ h1 (hdiff q)
      rwa [sub_sub_cancel] at h3
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h2)) hq
  have hnon : ∀ p : Polynomial R, p.coeff 0 ∈ IsLocalRing.maximalIdeal R →
      p.eval c ∈ IsLocalRing.maximalIdeal R := by
    intro p hp
    have h3 := Ideal.add_mem _ hp (hdiff p)
    rwa [add_sub_cancel] at h3
  have hcross : ∀ (s : O) (p q p' q' : Polynomial R), G s * q.eval₂ φ t = p.eval₂ φ t →
      G s * q'.eval₂ φ t = p'.eval₂ φ t → p.eval c * q'.eval c = p'.eval c * q.eval c := by
    intro s p q p' q' h h'
    have hD : p * q' - p' * q = 0 := by
      apply htr
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_mul, ← h, ← h']
      ring
    have h4 := congrArg (Polynomial.eval c) (sub_eq_zero.mp hD)
    rwa [Polynomial.eval_mul, Polynomial.eval_mul] at h4
  choose P Q hQ hPm hPQ using hdict
  obtain ⟨f, hF0⟩ : ∃ f : O → R, ∀ s, f s * (Q s).eval c = (P s).eval c :=
    ⟨fun s => (P s).eval c * ↑(hunit (Q s) (hQ s)).unit⁻¹, fun s => by
      rw [mul_assoc, IsUnit.val_inv_mul, mul_one]⟩
  have hK : ∀ (s : O) (p q : Polynomial R), G s * q.eval₂ φ t = p.eval₂ φ t →
      f s * q.eval c = p.eval c := by
    intro s p q h
    have hc' := hcross s (P s) (Q s) p q (hPQ s) h
    apply (hunit (Q s) (hQ s)).mul_left_inj.mp
    rw [mul_right_comm, hF0 s, hc']
  let ψ : O →+* R :=
    { toFun := f
      map_one' := by
        have h5 := hK 1 1 1 (by simp)
        simpa using h5
      map_mul' := by
        intro x y
        have hu := (hunit (Q x) (hQ x)).mul (hunit (Q y) (hQ y))
        apply hu.mul_left_inj.mp
        have h5 := hK (x * y) (P x * P y) (Q x * Q y) (by
          rw [map_mul, Polynomial.eval₂_mul, Polynomial.eval₂_mul, ← hPQ x, ← hPQ y]; ring)
        rw [Polynomial.eval_mul, Polynomial.eval_mul] at h5
        rw [h5, ← hF0 x, ← hF0 y]
        ring
      map_zero' := by
        have h5 := hK 0 0 1 (by simp)
        simpa using h5
      map_add' := by
        intro x y
        have hu := (hunit (Q x) (hQ x)).mul (hunit (Q y) (hQ y))
        apply hu.mul_left_inj.mp
        have h5 := hK (x + y) (P x * Q y + P y * Q x) (Q x * Q y) (by
          rw [map_add, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul,
            Polynomial.eval₂_mul, ← hPQ x, ← hPQ y]; ring)
        simp only [Polynomial.eval_mul, Polynomial.eval_add] at h5
        rw [h5, ← hF0 x, ← hF0 y]
        ring }
  refine ⟨ψ, ⟨fun a ha => ?_⟩, fun s p q _ h => hK s p q h⟩
  by_contra hna
  have hm : a ∈ IsLocalRing.maximalIdeal O := (IsLocalRing.mem_maximalIdeal _).mpr hna
  have h1 := hnon (P a) (hPm a hm)
  have h2 : IsUnit ((P a).eval c) := by
    rw [← hF0 a]
    exact ha.mul (hunit _ (hQ a))
  exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)) h2

theorem wcpa_dj_lr1k_nsr_nlb_ue_ur_disc_param : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
    [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)]
    (y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX)) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
