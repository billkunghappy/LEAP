      ((Φ₂ ≫ Φ₁).appLE V V h₃).hom b = (Φ₂.appLE V V h₂).hom ((Φ₁.appLE V V h₁).hom b) := by
    intro V Φ₁ Φ₂ h₁ h₂ h₃ b
