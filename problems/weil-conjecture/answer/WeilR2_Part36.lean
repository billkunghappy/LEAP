  obtain ⟨V', hD', hchar'⟩ := wcpa_dj_lr1k_nsr_esp_fibre_residue C _ _
    (γ ≫ ι₁).toNormalization
    (Limits.pullback.fst ((γ ≫ ι₁).fromNormalization ≫ r₁ ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) h' A' ν' hAν'
    hcA' hζ' hdom'
  refine ⟨ζ, ζ', h, h', hc, hc', hx, hx', V, V', hD, hD', ?_⟩
  by_cases hzz : ζ = ζ'
  swap
  · exact Or.inl hzz
  subst hzz
  have hh : h' = h := rfl
  subst hh
  right

  have hover : (r₁ ≫ uX) ((γ ≫ ι₁).fromNormalization (wcNdPt W (γ ≫ ι₁) (r₁ ≫ uX) ζ)) =
      IsLocalRing.closedPoint ↥W := by
