  have s2 : ∀ {A B Ap Bq : Type u} [CommRing A] [CommRing B] [CommRing Ap] [CommRing Bq]
      [Algebra A Ap] [Algebra B Bq] [IsLocalRing Ap] [IsLocalRing Bq] (ρ : A →+* B),
      ρ.IsIntegral → ∀ (p : Ideal A) [p.IsPrime] (q : Ideal B) [q.IsPrime]
        [IsLocalization.AtPrime Ap p] [IsLocalization.AtPrime Bq q] (ψ : Ap →+* Bq) [IsLocalHom ψ],
        ψ.comp (algebraMap A Ap) = (algebraMap B Bq).comp ρ →
        IsLocalRing.maximalIdeal Bq ≤ (Ideal.map ψ (IsLocalRing.maximalIdeal Ap)).radical := by
    intro A B Ap Bq _ _ _ _ _ _ _ _ ρ hρ p _ q _ _ _ ψ _ hcomp
    have hψm : Ideal.comap ψ (IsLocalRing.maximalIdeal Bq) = IsLocalRing.maximalIdeal Ap :=
