        algebraMap (Localization.Away w) M' (((algebraMap B (Localization.Away w)).comp ι) c) :=
    fun c => IsFractionRing.lift_algebraMap (K := M) hinj' c
  obtain ⟨L', _, _, lam, ρ, hlam, hFD, hGal, hρinj, hadj⟩ :=
    wcpa_dj_llsm_neat_top_field K M L M'
  haveI := hFD
  haveI := hGal
  letI algBL' : Algebra (Localization.Away w) L' :=
    ((algebraMap M' L').comp (algebraMap (Localization.Away w) M')).toAlgebra
  haveI : IsScalarTower (Localization.Away w) M' L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)

  haveI h𝔮wp : (𝔮.map (algebraMap B (Localization.Away w))).IsPrime := hPDw.2.2.2.1.isPrime
  have hinjBw : Function.Injective (algebraMap (Localization.Away w)
      ↥(integralClosure (Localization.Away w) L')) := by
