      ∃ δ δ' : W.ValueGroup, δ < δ' ∧ δ' ≤ e ∧ (∀ i ∈ l, d i ≤ δ ∨ δ' ≤ d i) ∧
        (l.map (fun i => max δ (d i))).prod ≤ B ∧ B < (l.map (fun i => max δ' (d i))).prod := by
    intro l d B e he h0 hB
    have hf0 : (l.map (fun i => max (0 : W.ValueGroup) (d i))).prod ≤ B := by
      have : (fun i => max (0 : W.ValueGroup) (d i)) = d := funext fun i => max_eq_right zero_le
      rw [this]; exact h0
    have h0T : (0 : W.ValueGroup) ∈ (insert 0 (l.map d).toFinset).filter
        (fun a => a < e ∧ (l.map (fun i => max a (d i))).prod ≤ B) :=
      Finset.mem_filter.mpr ⟨Finset.mem_insert_self _ _, he, hf0⟩
    obtain ⟨δ, hδT, hδmax⟩ : ∃ δ ∈ (insert 0 (l.map d).toFinset).filter
        (fun a => a < e ∧ (l.map (fun i => max a (d i))).prod ≤ B),
        ∀ a ∈ (insert 0 (l.map d).toFinset).filter
        (fun a => a < e ∧ (l.map (fun i => max a (d i))).prod ≤ B), a ≤ δ :=
      ⟨_, Finset.max'_mem _ ⟨0, h0T⟩, fun a ha => Finset.le_max' _ a ha⟩
    have hδT' := Finset.mem_filter.mp hδT
    obtain ⟨δ', hδ'N, hδ'min⟩ : ∃ δ' ∈ insert e ((l.map d).toFinset.filter (fun a => δ < a)),
        ∀ a ∈ insert e ((l.map d).toFinset.filter (fun a => δ < a)), δ' ≤ a :=
      ⟨_, Finset.min'_mem _ ⟨e, Finset.mem_insert_self _ _⟩, fun a ha => Finset.min'_le _ a ha⟩
    have hδ'e : δ' ≤ e := hδ'min e (Finset.mem_insert_self _ _)
    have hcases : δ' = e ∨ (δ' ∈ (l.map d).toFinset ∧ δ < δ') := by
      rcases Finset.mem_insert.mp hδ'N with h | h
      · exact Or.inl h
