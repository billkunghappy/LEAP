          algebraMap R K (p.coeff k) * (algebraMap R K (a * c)) ^ k *
            (algebraMap R K t₀) ^ (n - k) := by
        simp only [map_mul, map_pow]
      rw [e, ← hspec, ← pow_mul_pow_sub (algebraMap R K t₀) hk', Algebra.smul_def]
      ring
    have hu : IsUnit (algebraMap R K t₀) := IsLocalization.map_units K t
    have hq : (algebraMap R K t₀) ^ (n + 1) * Polynomial.aeval z (Polynomial.X * p) = 0 := by
      rw [Polynomial.aeval_mul, Polynomial.aeval_X]
      calc (algebraMap R K t₀) ^ (n + 1) * (z * Polynomial.aeval z p)
          = (z * algebraMap R K t₀) * ((algebraMap R K t₀) ^ n * Polynomial.aeval z p) := by ring
        _ = algebraMap R K (a * c * N₀) := by rw [hspec, hc1, ← map_mul]
        _ = 0 := by rw [hacN, map_zero]
    have hq' : Polynomial.aeval z (Polynomial.X * p) = 0 := (hu.pow (n + 1)).mul_right_eq_zero.mp hq
    exact ⟨Polynomial.X * p, Polynomial.monic_X.mul hp, by rw [← Polynomial.aeval_def]; exact hq'⟩

theorem wcpa_dj_lr1k_nsr_eb_bc_val_sep : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsLocalRing D] [IsNoetherianRing D], ringKrullDim D ≤ ((1 : ℕ) : WithBot ℕ∞) → IsNoetherianRing ↥(integralClosure D (FractionRing D)) → ∀ (κ : Type v) [Field κ] (φ : D →+* κ), Function.Injective φ → ∀ (V V' : ValuationSubring κ), (∀ d : D, φ d ∈ V) → (∀ d : D, φ d ∈ V') → (∀ d ∈ IsLocalRing.maximalIdeal D, V.valuation (φ d) < 1) → (∀ d ∈ IsLocalRing.maximalIdeal D, V'.valuation (φ d) < 1) → ∀ (a b : D), b ≠ 0 → ¬ (V.valuation (φ a / φ b) < 1 ↔ V'.valuation (φ a / φ b) < 1) → ∃ (a' b' : D) (p : Polynomial D), b' ≠ 0 ∧ p.Monic ∧ ∑ k ∈ Finset.range (p.natDegree + 1), p.coeff k * a' ^ k * b' ^ (p.natDegree - k) = 0 ∧ ¬ (V.valuation (φ a' / φ b') < 1 ↔ V'.valuation (φ a' / φ b') < 1) :=
by
  intro D _ _ _ _ hdim hnoeth κ _ φ hφ V V' hV hV' _ _ a b _ hsep
  classical

  haveI hBfr : IsFractionRing ↥(integralClosure D (FractionRing D)) (FractionRing D) :=
    integralClosure.isFractionRing_of_finite_extension (FractionRing D) (FractionRing D)
  haveI hDdim : Ring.DimensionLEOne D := by
    have hK : Ring.KrullDimLE 1 D := Ring.krullDimLE_iff.mpr hdim
    refine ⟨fun {p} hp0 hpp => ?_⟩
    rcases (Ring.krullDimLE_one_iff.mp hK) p hpp with hmin | hmax
    · rw [IsDomain.minimalPrimes_eq_singleton_bot] at hmin
      exact absurd (Set.mem_singleton_iff.mp hmin) hp0
    · exact hmax
  haveI hBdim : Ring.DimensionLEOne ↥(integralClosure D (FractionRing D)) :=
    Ring.DimensionLEOne.integralClosure D (FractionRing D)
  haveI hBic : IsIntegrallyClosed ↥(integralClosure D (FractionRing D)) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (FractionRing D)
  haveI hBnoeth : IsNoetherianRing ↥(integralClosure D (FractionRing D)) := hnoeth
  haveI hDed : IsDedekindDomain ↥(integralClosure D (FractionRing D)) :=
    (isDedekindDomain_iff ↥(integralClosure D (FractionRing D)) (FractionRing D)).mpr
      ⟨inferInstance, hnoeth, inferInstance, fun hx => IsIntegrallyClosed.isIntegral_iff.mp hx⟩

  let ι : FractionRing D →+* κ := IsFractionRing.lift hφ
  have hιD : ∀ d : D, ι (algebraMap D (FractionRing D) d) = φ d := fun d =>
    IsFractionRing.lift_algebraMap hφ d

  have intmem : ∀ (U : ValuationSubring κ), (∀ d, φ d ∈ U) →
      ∀ y : FractionRing D, _root_.IsIntegral D y → ι y ∈ U := by
    intro U hU y hy
    obtain ⟨p, hpm, hp⟩ := hy
    let σ : D →+* U := φ.codRestrict U hU
    have hint : _root_.IsIntegral U (ι y) := by
      refine ⟨p.map σ, hpm.map σ, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp : (algebraMap U κ).comp σ = ι.comp (algebraMap D (FractionRing D)) := by
        ext d
        simp only [RingHom.comp_apply, hιD]
        rfl
      rw [hcomp, ← Polynomial.hom_eval₂, hp, map_zero]
    obtain ⟨z, hz⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    rw [← hz]
    exact z.2
  have hBV : ∀ y : ↥(integralClosure D (FractionRing D)),
      ι (algebraMap _ (FractionRing D) y) ∈ V := fun y => intmem V hV _ y.2
  have hBV' : ∀ y : ↥(integralClosure D (FractionRing D)),
      ι (algebraMap _ (FractionRing D) y) ∈ V' := fun y => intmem V' hV' _ y.2
  have le1 : ∀ y : ↥(integralClosure D (FractionRing D)),
      V.valuation (ι (algebraMap _ (FractionRing D) y)) ≤ 1 := fun y =>
    (V.valuation_le_one_iff _).mpr (hBV y)
  have le1' : ∀ y : ↥(integralClosure D (FractionRing D)),
      V'.valuation (ι (algebraMap _ (FractionRing D) y)) ≤ 1 := fun y =>
    (V'.valuation_le_one_iff _).mpr (hBV' y)
  have hfinj := IsFractionRing.injective ↥(integralClosure D (FractionRing D)) (FractionRing D)

  have key : ∃ y : ↥(integralClosure D (FractionRing D)),
      ¬ (V.valuation (ι (algebraMap _ (FractionRing D) y)) < 1 ↔
        V'.valuation (ι (algebraMap _ (FractionRing D) y)) < 1) := by
    by_contra hcon
    simp only [not_exists, not_not] at hcon
    have unit : ∀ y : ↥(integralClosure D (FractionRing D)),
        ¬ V.valuation (ι (algebraMap _ (FractionRing D) y)) < 1 →
        V.valuation (ι (algebraMap _ (FractionRing D) y)) = 1 ∧
          V'.valuation (ι (algebraMap _ (FractionRing D) y)) = 1 := by
      intro y hy
      have hy' := fun h => hy ((hcon y).mpr h)
      exact ⟨le_antisymm (le1 y) (not_lt.mp hy), le_antisymm (le1' y) (not_lt.mp hy')⟩
    have keyA : ∀ (x : FractionRing D) (c u : ↥(integralClosure D (FractionRing D))),
        x * algebraMap _ (FractionRing D) u = algebraMap _ (FractionRing D) c →
        ¬ V.valuation (ι (algebraMap _ (FractionRing D) u)) < 1 →
        (V.valuation (ι x) < 1 ↔ V'.valuation (ι x) < 1) := by
      intro x c u hx hu
      obtain ⟨h1, h1'⟩ := unit u hu
      have e : V.valuation (ι (algebraMap _ (FractionRing D) c)) = V.valuation (ι x) := by
        rw [← hx, map_mul, Valuation.map_mul, h1, mul_one]
      have e' : V'.valuation (ι (algebraMap _ (FractionRing D) c)) = V'.valuation (ι x) := by
        rw [← hx, map_mul, Valuation.map_mul, h1', mul_one]
      rw [← e, ← e']
      exact hcon c
    have keyB : ∀ (x : FractionRing D) (c u : ↥(integralClosure D (FractionRing D))),
        x * algebraMap _ (FractionRing D) c = algebraMap _ (FractionRing D) u →
        ¬ V.valuation (ι (algebraMap _ (FractionRing D) u)) < 1 →
        (V.valuation (ι x) < 1 ↔ V'.valuation (ι x) < 1) := by
      intro x c u hx hu
      obtain ⟨h1, h1'⟩ := unit u hu
      have e : V.valuation (ι x) * V.valuation (ι (algebraMap _ (FractionRing D) c)) = 1 := by
        rw [← Valuation.map_mul, ← map_mul, hx, h1]
      have e' : V'.valuation (ι x) * V'.valuation (ι (algebraMap _ (FractionRing D) c)) = 1 := by
        rw [← Valuation.map_mul, ← map_mul, hx, h1']
      refine iff_of_false ?_ ?_
      · intro hlt
        have := lt_of_le_of_lt (mul_le_of_le_one_right' (le1 c)) hlt
        rw [e] at this
        exact lt_irrefl _ this
      · intro hlt
        have := lt_of_le_of_lt (mul_le_of_le_one_right' (le1' c)) hlt
        rw [e'] at this
        exact lt_irrefl _ this
    have allx : ∀ x : FractionRing D, (V.valuation (ι x) < 1 ↔ V'.valuation (ι x) < 1) := by
      intro x
      obtain ⟨a0, s, hs, rfl⟩ :=
        IsFractionRing.div_surjective (A := ↥(integralClosure D (FractionRing D))) x
      have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
      have hfs : algebraMap _ (FractionRing D) s ≠ 0 := by
        intro h
        apply hs0
        apply hfinj
        rw [h, map_zero]
      let N : Ideal ↥(integralClosure D (FractionRing D)) :=
        Ideal.comap ((ι.comp (algebraMap _ (FractionRing D))).codRestrict V hBV)
          (IsLocalRing.maximalIdeal V)
      have hN : ∀ y, y ∈ N ↔ V.valuation (ι (algebraMap _ (FractionRing D) y)) < 1 := by
        intro y
        simp only [N, Ideal.mem_comap]
        exact V.valuation_lt_one_iff _
      haveI hNp : N.IsPrime := Ideal.comap_isPrime _ _
      by_cases hNb : N = ⊥
      · by_cases ha0 : a0 = 0
        · rw [ha0, map_zero, zero_div, map_zero, Valuation.map_zero, Valuation.map_zero]
          exact iff_of_true zero_lt_one zero_lt_one
        · apply keyB _ s a0
          · rw [div_mul_cancel₀ _ hfs]
          · rw [← hN, hNb, Ideal.mem_bot]
            exact ha0
      · haveI := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
          ↥(integralClosure D (FractionRing D)) hNb (Localization.AtPrime N)
        haveI hVR : ValuationRing (Localization.AtPrime N) := inferInstance
        haveI hPVR : PreValuationRing (Localization.AtPrime N) := hVR.toPreValuationRing
        obtain ⟨c, hc⟩ := ValuationRing.cond
          (algebraMap _ (Localization.AtPrime N) a0) (algebraMap _ (Localization.AtPrime N) s)
        obtain ⟨⟨c0, u⟩, rfl⟩ := IsLocalization.mk'_surjective N.primeCompl c
        have hu : (u : ↥(integralClosure D (FractionRing D))) ∉ N := u.2
        have hinj := IsLocalization.injective (Localization.AtPrime N)
          (Ideal.primeCompl_le_nonZeroDivisors N)
        rcases hc with hc | hc
        · have e : a0 * c0 = s * u := by
            apply hinj
            rw [map_mul, map_mul, ← hc, mul_assoc, IsLocalization.mk'_spec]
          apply keyB _ c0 u
          · rw [div_mul_eq_mul_div, ← map_mul, e, map_mul, mul_div_cancel_left₀ _ hfs]
          · rw [← hN]; exact hu
        · have e : s * c0 = a0 * u := by
            apply hinj
            rw [map_mul, map_mul, ← hc, mul_assoc, IsLocalization.mk'_spec]
          apply keyA _ c0 u
          · rw [div_mul_eq_mul_div, ← map_mul, ← e, map_mul, mul_div_cancel_left₀ _ hfs]
          · rw [← hN]; exact hu
    have hx : ι (algebraMap D (FractionRing D) a / algebraMap D (FractionRing D) b) =
        φ a / φ b := by
      rw [map_div₀, hιD, hιD]
    exact hsep (hx ▸ allx _)

  obtain ⟨y, hy⟩ := key
  obtain ⟨a', b', hb', hab⟩ :=
    IsFractionRing.div_surjective (A := D) (algebraMap _ (FractionRing D) y)
  obtain ⟨p, hpm, hp⟩ := y.2
  have hb'0 : b' ≠ 0 := nonZeroDivisors.ne_zero hb'
  have hinjD := IsFractionRing.injective D (FractionRing D)
  have hp' : Polynomial.eval₂ (algebraMap D (FractionRing D))
      (algebraMap D (FractionRing D) a' / algebraMap D (FractionRing D) b') p = 0 := by
    rw [hab]; exact hp
  have hsr := Polynomial.scaleRoots_eval₂_eq_zero_of_eval₂_div_eq_zero hinjD hp' hb'
  refine ⟨a', b', p, hb'0, hpm, ?_, ?_⟩
  · apply hinjD
    rw [map_zero, ← hsr, Polynomial.eval₂_eq_sum_range, Polynomial.natDegree_scaleRoots, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Polynomial.coeff_scaleRoots]
    simp only [map_mul, map_pow]
    ring
  · have e : ι (algebraMap _ (FractionRing D) y) = φ a' / φ b' := by
      rw [← hab, map_div₀, hιD, hιD]
    rw [← e]
    exact hy

theorem wcpa_dj_lr1k_nsr_eb_bc_ka_length : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsLocalRing D] [IsNoetherianRing D], ringKrullDim D ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ x : D, x ≠ 0 → Module.length D (↥(integralClosure D (FractionRing D)) ⧸ (Ideal.span {x} • (⊤ : Submodule D ↥(integralClosure D (FractionRing D))))) ≤ Module.length D (D ⧸ Ideal.span {x}) :=
by
  intro D _ _ _ _ hdim x hx
  have s1 : ∀ I : Ideal D, I ≠ ⊥ → Module.length D (D ⧸ I) ≠ ⊤ := by
    intro I hI
    haveI : Ring.KrullDimLE 1 D := Ring.krullDimLE_iff.mpr hdim
    haveI : Ring.KrullDimLE 0 (D ⧸ I) := by
      rw [Ring.krullDimLE_zero_iff]
      intro Q hQ
      have hPp : (Q.comap (Ideal.Quotient.mk I)).IsPrime := Ideal.comap_isPrime _ Q
      have hIP : I ≤ Q.comap (Ideal.Quotient.mk I) := fun i hi => by
        show Ideal.Quotient.mk I i ∈ Q
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hi]; exact Q.zero_mem
      have hPmax : (Q.comap (Ideal.Quotient.mk I)).IsMaximal := by
        rcases (Ring.krullDimLE_one_iff.mp inferInstance) _ hPp with h | h
        · rw [IsDomain.minimalPrimes_eq_singleton_bot, Set.mem_singleton_iff] at h
          rw [h] at hIP
          exact absurd (le_bot_iff.mp hIP) hI
        · exact h
      have hmap : (Q.comap (Ideal.Quotient.mk I)).map (Ideal.Quotient.mk I) = Q :=
        Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective Q
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective hPmax with h | h
      · rw [hmap] at h; exact absurd h hQ.ne_top
      · rwa [hmap] at h
    haveI : IsArtinianRing (D ⧸ I) := IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
    haveI : IsArtinian D (D ⧸ I) :=
      isArtinian_of_surjective_algebraMap (R := D ⧸ I) Ideal.Quotient.mk_surjective
    rw [Module.length_ne_top_iff, isFiniteLength_iff_isNoetherian_isArtinian]
    exact ⟨inferInstance, inferInstance⟩
  have s2 : ∀ I : Ideal D, Module.length D (D ⧸ I) ≠ ⊤ →
      Module.length D (↥I ⧸ (Ideal.span {x} • (⊤ : Submodule D ↥I))) =
        Module.length D (D ⧸ Ideal.span {x}) := by
    intro I hfin
    have hJI : Ideal.span {x} * I ≤ I := Ideal.mul_le_right
    have hJx : Ideal.span {x} * I ≤ Ideal.span {x} := Ideal.mul_le_left
    have hmemJ : ∀ y, y ∈ Ideal.span {x} * I ↔ ∃ z ∈ I, x * z = y :=
      fun y => Ideal.mem_span_singleton_mul
    have hcomap : ∀ y : I, y ∈ (Ideal.span {x} • (⊤ : Submodule D ↥I)) ↔
        (y : D) ∈ Ideal.span {x} * I := by
      intro y
      rw [Submodule.mem_smul_top_iff]
      exact Iff.rfl
    let f : (↥I ⧸ (Ideal.span {x} • (⊤ : Submodule D ↥I))) →ₗ[D] D ⧸ (Ideal.span {x} * I) :=
      Submodule.mapQ _ (Ideal.span {x} * I) I.subtype (fun y hy => (hcomap y).mp hy)
    let g : D ⧸ (Ideal.span {x} * I) →ₗ[D] D ⧸ I := Submodule.factor hJI
    have hf : Function.Injective f := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro q hq
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      rw [LinearMap.mem_ker] at hq
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero, hcomap]
      have h' : Submodule.Quotient.mk (p := Ideal.span {x} * I) (y : D) = 0 := hq
      rwa [Submodule.Quotient.mk_eq_zero] at h'
    have hg : Function.Surjective g := Submodule.factor_surjective hJI
    have hfg : Function.Exact f g := by
      intro q
      obtain ⟨d, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      constructor
      · intro h
        have h' : Submodule.Quotient.mk (p := I) d = 0 := h
        rw [Submodule.Quotient.mk_eq_zero] at h'
        exact ⟨Submodule.Quotient.mk ⟨d, h'⟩, rfl⟩
      · rintro ⟨q', hq'⟩
        obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ q'
        rw [← hq']
        show Submodule.Quotient.mk (p := I) (y : D) = 0
        rw [Submodule.Quotient.mk_eq_zero]; exact y.2
    have hA := Module.length_eq_add_of_exact f g hf hg hfg
    let μ : D →ₗ[D] D := LinearMap.mulLeft D x
    have hμ : I ≤ Submodule.comap μ (Ideal.span {x} * I) :=
      fun i hi => Ideal.mul_mem_mul (Ideal.mem_span_singleton_self x) hi
    let f' : D ⧸ I →ₗ[D] D ⧸ (Ideal.span {x} * I) := Submodule.mapQ I (Ideal.span {x} * I) μ hμ
    let g' : D ⧸ (Ideal.span {x} * I) →ₗ[D] D ⧸ Ideal.span {x} := Submodule.factor hJx
    have hf' : Function.Injective f' := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro q hq
      obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      rw [LinearMap.mem_ker] at hq
      have h' : Submodule.Quotient.mk (p := Ideal.span {x} * I) (x * r) = 0 := hq
      rw [Submodule.Quotient.mk_eq_zero, hmemJ] at h'
      obtain ⟨z, hz, hzr⟩ := h'
      have hzr' : z = r := mul_left_cancel₀ hx hzr
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero, ← hzr']
      exact hz
    have hg' : Function.Surjective g' := Submodule.factor_surjective hJx
    have hfg' : Function.Exact f' g' := by
      intro q
      obtain ⟨d, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      constructor
      · intro h
        have h' : Submodule.Quotient.mk (p := Ideal.span {x}) d = 0 := h
        rw [Submodule.Quotient.mk_eq_zero, Ideal.mem_span_singleton'] at h'
        obtain ⟨r, rfl⟩ := h'
        refine ⟨Submodule.Quotient.mk r, ?_⟩
        show Submodule.Quotient.mk (p := Ideal.span {x} * I) (x * r) =
          Submodule.Quotient.mk (r * x)
        exact congrArg _ (mul_comm x r)
      · rintro ⟨q', hq'⟩
        obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective _ q'
        rw [← hq']
        show Submodule.Quotient.mk (p := Ideal.span {x}) (x * r) = 0
        rw [Submodule.Quotient.mk_eq_zero]
        exact Ideal.mul_mem_right r _ (Ideal.mem_span_singleton_self x)
    have hB := Module.length_eq_add_of_exact f' g' hf' hg' hfg'
    have hAB := hA.symm.trans hB
    apply ENat.add_left_injective_of_ne_top hfin
    simp only
    rw [hAB, add_comm]
  have s3 : ∀ M : Submodule D ↥(integralClosure D (FractionRing D)), M.FG → ∃ ψ : ↥M →ₗ[D] D, Function.Injective ψ := by
    intro M hM
    classical
    obtain ⟨S, hS⟩ := hM
    let T : Finset (FractionRing D) :=
      Finset.image (fun s : ↥(integralClosure D (FractionRing D)) => (s : FractionRing D)) S
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors D) T
    let Φ : ↥(integralClosure D (FractionRing D)) →ₗ[D] FractionRing D :=
      (b : D) • (integralClosure D (FractionRing D)).val.toLinearMap
    let Z : Submodule D (FractionRing D) := LinearMap.range (Algebra.linearMap D (FractionRing D))
    have hMZ : M ≤ Z.comap Φ := by
      rw [← hS, Submodule.span_le]
      intro s hs
      obtain ⟨d, hd⟩ := hb (s : FractionRing D) (Finset.mem_image.mpr ⟨s, Finset.mem_coe.mp hs, rfl⟩)
      exact ⟨d, by simpa [Φ] using hd⟩
    let e := LinearEquiv.ofInjective (Algebra.linearMap D (FractionRing D))
      (IsFractionRing.injective D (FractionRing D))
    refine ⟨e.symm.toLinearMap ∘ₗ (Φ ∘ₗ M.subtype).codRestrict Z (fun m => hMZ m.2), ?_⟩
    rw [injective_iff_map_eq_zero]
    intro m hm
    have h1 : (Φ ∘ₗ M.subtype).codRestrict Z (fun m => hMZ m.2) m = 0 := by
      simpa using hm
    have h2 : Φ (m : ↥(integralClosure D (FractionRing D))) = 0 := congrArg Subtype.val h1
    have h3 : (b : D) • ((m : ↥(integralClosure D (FractionRing D))) : FractionRing D) = 0 := h2
    rw [Algebra.smul_def] at h3
    have hb0 : algebraMap D (FractionRing D) (b : D) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective D (FractionRing D))).mpr
        (nonZeroDivisors.ne_zero b.2)
    have h4 := (mul_eq_zero.mp h3).resolve_left hb0
    exact Subtype.ext (Subtype.ext h4)
  have s4 : ∀ (M : Type u) [AddCommGroup M] [Module D M] (ψ : M →ₗ[D] D), Function.Injective ψ →
      Module.length D (M ⧸ (Ideal.span {x} • (⊤ : Submodule D M))) =
        Module.length D (↥(LinearMap.range ψ) ⧸
          (Ideal.span {x} • (⊤ : Submodule D ↥(LinearMap.range ψ)))) := by
    intro M _ _ ψ hψ
    let e := LinearEquiv.ofInjective ψ hψ
    have h : Submodule.map (e : M →ₗ[D] ↥(LinearMap.range ψ)) (Ideal.span {x} • ⊤) =
        Ideal.span {x} • ⊤ := by
      rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]
    exact (Submodule.Quotient.equiv _ _ e h).length_eq
  have s5 : ∀ (B : Type u) [AddCommGroup B] [Module D B] (c : ℕ∞),
      (∀ M : Submodule D B, M.FG → M ≠ ⊥ →
        Module.length D (↥M ⧸ (Ideal.span {x} • (⊤ : Submodule D ↥M))) ≤ c) →
      Module.length D (B ⧸ (Ideal.span {x} • (⊤ : Submodule D B))) ≤ c := by
    intro B _ _ c H
    rw [Module.length_quotient, Order.coheight_le_iff]
    intro p hp
    rcases Nat.eq_zero_or_pos p.length with h0 | hpos
    · rw [h0]; simp
    have hlt : ∀ i : Fin p.length, p.toFun i.castSucc < p.toFun i.succ :=
      fun i => p.strictMono Fin.castSucc_lt_succ
    have hstep : ∀ i : Fin p.length, ∃ u, u ∈ p.toFun i.succ ∧ u ∉ p.toFun i.castSucc :=
      fun i => SetLike.exists_of_lt (hlt i)
    choose u hu1 hu2 using hstep
    have hMfg : (Submodule.span D (Set.range u)).FG := Submodule.fg_span (Set.finite_range u)
    have hM0 : Submodule.span D (Set.range u) ≠ ⊥ := by
      intro h
      have hm : u ⟨0, hpos⟩ ∈ Submodule.span D (Set.range u) := Submodule.subset_span ⟨_, rfl⟩
      rw [h, Submodule.mem_bot] at hm
      apply hu2 ⟨0, hpos⟩
      rw [hm]; exact Submodule.zero_mem _
    have hqs : ∀ i : Fin p.length,
        (p.toFun i.castSucc).comap (Submodule.span D (Set.range u)).subtype <
          (p.toFun i.succ).comap (Submodule.span D (Set.range u)).subtype := by
      intro i
      refine lt_of_le_of_ne (Submodule.comap_mono (hlt i).le) ?_
      intro heq
      have hmem : (⟨u i, Submodule.subset_span ⟨i, rfl⟩⟩ : Submodule.span D (Set.range u)) ∈
          (p.toFun i.succ).comap (Submodule.span D (Set.range u)).subtype := hu1 i
      rw [← heq] at hmem
      exact hu2 i hmem
    let q : LTSeries (Submodule D (Submodule.span D (Set.range u))) :=
      { length := p.length
        toFun := fun j => (p.toFun j).comap (Submodule.span D (Set.range u)).subtype
        step := fun i => hqs i }
    have hhead : Ideal.span {x} • (⊤ : Submodule D (Submodule.span D (Set.range u))) ≤ q.head := by
      show _ ≤ (p.toFun 0).comap (Submodule.span D (Set.range u)).subtype
      rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'', Submodule.map_top,
        Submodule.range_subtype]
      exact (Submodule.smul_mono le_rfl le_top).trans hp
    have hlen := Order.length_le_coheight hhead
    rw [← Module.length_quotient] at hlen
    exact hlen.trans (H _ hMfg hM0)
  apply s5 _ _
  intro M hM hM0
  obtain ⟨ψ, hψ⟩ := s3 M hM
  rw [s4 ↥M ψ hψ]
  have hI0 : LinearMap.range ψ ≠ ⊥ := by
    obtain ⟨m, hm, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hM0
    intro h
    have hr : ψ ⟨m, hm⟩ ∈ LinearMap.range ψ := LinearMap.mem_range_self _ _
    rw [h, Submodule.mem_bot] at hr
    exact hm0 (congrArg Subtype.val (hψ (hr.trans (map_zero ψ).symm)))
  rw [s2 (LinearMap.range ψ) (s1 _ hI0)]

theorem wcpa_dj_lr1k_nsr_eb_bc_ka_noeth : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsLocalRing D] [IsNoetherianRing D], ringKrullDim D ≤ ((1 : ℕ) : WithBot ℕ∞) → (∀ x : D, x ≠ 0 → Module.length D (↥(integralClosure D (FractionRing D)) ⧸ (Ideal.span {x} • (⊤ : Submodule D ↥(integralClosure D (FractionRing D))))) ≤ Module.length D (D ⧸ Ideal.span {x})) → IsNoetherianRing ↥(integralClosure D (FractionRing D)) :=
by
  intro D _ _ _ _ hdim hlen
  haveI : Ring.KrullDimLE 1 D := Ring.krullDimLE_iff.mpr (by exact_mod_cast hdim)
  set B := ↥(integralClosure D (FractionRing D)) with hB

  have quot : ∀ x : D, x ≠ 0 →
      IsNoetherian B (B ⧸ Ideal.span {algebraMap D B x}) := by
    intro x hx
    have hfin : IsFiniteLength D (D ⧸ Ideal.span {x}) :=
      isFiniteLength_quotient_span_singleton D (mem_nonZeroDivisors_of_ne_zero hx)
    have h1 : Module.length D (D ⧸ Ideal.span {x}) ≠ ⊤ := Module.length_ne_top_iff.mpr hfin
    have h2 := ne_top_of_le_ne_top h1 (hlen x hx)
    have h3 := (isFiniteLength_iff_isNoetherian_isArtinian.mp (Module.length_ne_top_iff.mp h2)).1
    have s4 : (Ideal.span {x} • (⊤ : Submodule D B)) =
        (Ideal.span {algebraMap D B x}).restrictScalars D := by
      ext z
      rw [Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists,
        Submodule.restrictScalars_mem, Ideal.mem_span_singleton']
      constructor
      · rintro ⟨b, -, rfl⟩
        exact ⟨b, by rw [Algebra.smul_def, mul_comm]⟩
      · rintro ⟨a, rfl⟩
        exact ⟨a, Submodule.mem_top, by rw [Algebra.smul_def, mul_comm]⟩
    rw [s4] at h3
    have h4 : IsNoetherian D (B ⧸ Ideal.span {algebraMap D B x}) :=
      isNoetherian_of_linearEquiv
        (Submodule.Quotient.restrictScalarsEquiv D (Ideal.span {algebraMap D B x}))
    exact isNoetherian_of_tower D h4
  refine ⟨fun J => ?_⟩
  by_cases hJ : J = ⊥
  · rw [hJ]; exact Submodule.fg_bot
  obtain ⟨y, hyJ, hy0⟩ := Submodule.ne_bot_iff _ |>.mp hJ
  have hU := Ideal.under_ne_bot_of_integral_mem (R := D) hy0 hyJ
    (Algebra.IsIntegral.isIntegral y)
  obtain ⟨x, hxU, hx0⟩ := Submodule.ne_bot_iff _ |>.mp hU
  have hxJ : algebraMap D B x ∈ J := hxU
  haveI := quot x hx0
  set I₀ : Ideal B := Ideal.span {algebraMap D B x}
  have hle : I₀ ≤ J := (Ideal.span_singleton_le_iff_mem J).mpr hxJ
  apply Submodule.fg_of_fg_map_of_fg_inf_ker I₀.mkQ
  · exact IsNoetherian.noetherian _
  · rw [Submodule.ker_mkQ, inf_eq_right.mpr hle]
    exact Submodule.fg_span_singleton _

theorem wcpa_dj_lr1k_nsr_eb_branch_count : ∀ (F : Scheme.{u}) (w : F),
    _root_.IsReduced ↥(F.presheaf.stalk w) → IsNoetherianRing ↥(F.presheaf.stalk w) →
    ringKrullDim ↥(F.presheaf.stalk w) ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (ζ₁ ζ₂ ζ₃ : F) (h₁ : ζ₁ ⤳ w) (h₂ : ζ₂ ⤳ w) (h₃ : ζ₃ ⤳ w)
      (V₁ : ValuationSubring (F.residueField ζ₁)) (V₂ : ValuationSubring (F.residueField ζ₂))
      (V₃ : ValuationSubring (F.residueField ζ₃)),
      closure {ζ₁} ∈ irreducibleComponents F → closure {ζ₂} ∈ irreducibleComponents F →
      closure {ζ₃} ∈ irreducibleComponents F →
      wcNsrEbDom F h₁ V₁ → wcNsrEbDom F h₂ V₂ → wcNsrEbDom F h₃ V₃ →
      wcNsrEbSep F h₁ h₂ V₁ V₂ → wcNsrEbSep F h₁ h₃ V₁ V₃ → wcNsrEbSep F h₂ h₃ V₂ V₃ →
      ζ₁ ≠ ζ₂ → wcpaDjLkBad ↥(F.presheaf.stalk w) :=
by
  intro F w hred hnoeth hdim ζ₁ ζ₂ ζ₃ h₁ h₂ h₃ V₁ V₂ V₃ hc₁ hc₂ hc₃ hD₁ hD₂ hD₃ hS₁₂ hS₁₃ hS₂₃
    hne₁₂
  classical
  haveI := hred
  haveI := hnoeth

  have star : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ] (ρ : R →+* κ)
      (ψ : FractionRing R →+* κ), ψ.comp (algebraMap R (FractionRing R)) = ρ →
      ∀ (x : R) (t : nonZeroDivisors R),
        ψ (IsLocalization.mk' (FractionRing R) x t) * ρ t = ρ x := by
    intro R _ κ _ ρ ψ hψ x t
    rw [← hψ, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, IsLocalization.mk'_spec]

  have nzd : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ] (ρ : R →+* κ),
      RingHom.ker ρ ∈ minimalPrimes R → ∀ t : nonZeroDivisors R, ρ t ≠ 0 := by
    intro R _ κ _ ρ hP t h0
    exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hP)
      (show (t : R) ∈ RingHom.ker ρ from RingHom.mem_ker.mpr h0) t.2

  have caseA : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [_root_.IsReduced R] [IsNoetherianRing R]
      (κ κ' : Type u) [Field κ] [Field κ'] (ρ : R →+* κ) (ρ' : R →+* κ')
      (ψ : FractionRing R →+* κ) (ψ' : FractionRing R →+* κ'),
      ψ.comp (algebraMap R (FractionRing R)) = ρ → ψ'.comp (algebraMap R (FractionRing R)) = ρ' →
      RingHom.ker ρ ∈ minimalPrimes R → RingHom.ker ρ' ∈ minimalPrimes R →
      RingHom.ker ρ ≠ RingHom.ker ρ' →
      ∃ z : FractionRing R, IsIntegral R z ∧ ψ z = 1 ∧ ψ' z = 0 := by
    intro R _ _ _ _ κ κ' _ _ ρ ρ' ψ ψ' hψ hψ' hP hP' hne
    have h1 : (1 : R) ∉ RingHom.ker ρ := by
      rw [RingHom.mem_ker, map_one]; exact one_ne_zero
    have hsum : ∑ k ∈ Finset.range ((Polynomial.X - Polynomial.C (1 : R)).natDegree + 1),
        (Polynomial.X - Polynomial.C (1 : R)).coeff k * (1 : R) ^ k *
          (1 : R) ^ ((Polynomial.X - Polynomial.C (1 : R)).natDegree - k) ∈ RingHom.ker ρ := by
      rw [Polynomial.natDegree_X_sub_C]
      simp [Finset.sum_range_succ, Polynomial.coeff_X, Polynomial.coeff_one]
    obtain ⟨c, t, hcP, hcQ, htc, hint⟩ := wcpa_dj_lr1k_nsr_eb_bc_lift_integral R (RingHom.ker ρ)
      hP 1 1 (Polynomial.X - Polynomial.C 1) h1 (Polynomial.monic_X_sub_C 1) hsum
    rw [one_mul] at hint
    have hc0 : ρ c ≠ 0 := fun h => hcP (RingHom.mem_ker.mpr h)
    have hc' : ρ' c = 0 := RingHom.mem_ker.mp (hcQ (RingHom.ker ρ') hP' (Ne.symm hne))
    have htc' : ρ t = ρ c := by
      have := RingHom.mem_ker.mp htc
      rw [map_sub, sub_eq_zero, map_mul, map_one, one_mul] at this
      exact this
    refine ⟨IsLocalization.mk' (FractionRing R) c t, hint, ?_, ?_⟩
    · have e := star R κ ρ ψ hψ c t
      rw [htc'] at e
      exact mul_right_cancel₀ hc0 (e.trans (one_mul _).symm)
    · have e := star R κ' ρ' ψ' hψ' c t
      rw [hc'] at e
      exact (mul_eq_zero.mp e).resolve_right (nzd R κ' ρ' hP' t)

  have caseB : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [_root_.IsReduced R]
      [IsNoetherianRing R], ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ (κ : Type u) [Field κ] (ρ : R →+* κ) (ψ ψ' : FractionRing R →+* κ)
        (V V' : ValuationSubring κ),
      ψ.comp (algebraMap R (FractionRing R)) = ρ → ψ'.comp (algebraMap R (FractionRing R)) = ρ →
      RingHom.ker ρ ∈ minimalPrimes R →
      (∀ d, ρ d ∈ V) → (∀ d, ρ d ∈ V') →
      (∀ d ∈ IsLocalRing.maximalIdeal R, V.valuation (ρ d) < 1) →
      (∀ d ∈ IsLocalRing.maximalIdeal R, V'.valuation (ρ d) < 1) →
      ∀ r s : R, ρ s ≠ 0 → ¬ (V.valuation (ρ r / ρ s) < 1 ↔ V'.valuation (ρ r / ρ s) < 1) →
      ∃ z : FractionRing R, IsIntegral R z ∧
        ¬ (V.valuation (ψ z) < 1 ↔ V'.valuation (ψ' z) < 1) := by
    intro R _ _ _ _ hdimR κ _ ρ ψ ψ' V V' hψ hψ' hP hV hV' hmV hmV' r s hs hsep
    haveI : (RingHom.ker ρ).IsPrime := RingHom.ker_isPrime ρ
    haveI : IsDomain (R ⧸ RingHom.ker ρ) := Ideal.Quotient.isDomain _
    haveI : IsNoetherianRing (R ⧸ RingHom.ker ρ) := Ideal.Quotient.isNoetherianRing _
    haveI : IsLocalRing (R ⧸ RingHom.ker ρ) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    have hdimD : ringKrullDim (R ⧸ RingHom.ker ρ) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
      (ringKrullDim_quotient_le _).trans hdimR
    have hφ : Function.Injective (RingHom.kerLift ρ) := RingHom.kerLift_injective ρ
    have hφmk : ∀ x : R, RingHom.kerLift ρ (Ideal.Quotient.mk (RingHom.ker ρ) x) = ρ x :=
      RingHom.kerLift_mk ρ
    have hmax : ∀ x : R, Ideal.Quotient.mk (RingHom.ker ρ) x ∈
        IsLocalRing.maximalIdeal (R ⧸ RingHom.ker ρ) → x ∈ IsLocalRing.maximalIdeal R := by
      intro x hx
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      exact fun hu => hx (hu.map _)
    have hVD : ∀ d : R ⧸ RingHom.ker ρ, RingHom.kerLift ρ d ∈ V := by
      intro d
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
      rw [hφmk]; exact hV x
    have hV'D : ∀ d : R ⧸ RingHom.ker ρ, RingHom.kerLift ρ d ∈ V' := by
      intro d
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
      rw [hφmk]; exact hV' x
    have hmVD : ∀ d ∈ IsLocalRing.maximalIdeal (R ⧸ RingHom.ker ρ),
        V.valuation (RingHom.kerLift ρ d) < 1 := by
      intro d hd
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
      rw [hφmk]; exact hmV x (hmax x hd)
    have hmV'D : ∀ d ∈ IsLocalRing.maximalIdeal (R ⧸ RingHom.ker ρ),
        V'.valuation (RingHom.kerLift ρ d) < 1 := by
      intro d hd
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
      rw [hφmk]; exact hmV' x (hmax x hd)
    have hnb := wcpa_dj_lr1k_nsr_eb_bc_ka_noeth (R ⧸ RingHom.ker ρ) hdimD
      (wcpa_dj_lr1k_nsr_eb_bc_ka_length (R ⧸ RingHom.ker ρ) hdimD)
    have hs0 : Ideal.Quotient.mk (RingHom.ker ρ) s ≠ 0 := by
      intro h; apply hs; rw [← hφmk, h, map_zero]
    obtain ⟨a', b', p, hb', hpm, hsum, hsep'⟩ := wcpa_dj_lr1k_nsr_eb_bc_val_sep
      (R ⧸ RingHom.ker ρ) hdimD hnb κ (RingHom.kerLift ρ) hφ V V' hVD hV'D hmVD hmV'D
      (Ideal.Quotient.mk _ r) (Ideal.Quotient.mk _ s) hs0 (by rw [hφmk, hφmk]; exact hsep)
    obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective a'
    obtain ⟨b₀, rfl⟩ := Ideal.Quotient.mk_surjective b'
    obtain ⟨p₀, hp₀map, hp₀deg, hp₀m⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr (Polynomial.map_surjective _ Ideal.Quotient.mk_surjective p))
      hpm
    have hnd : p₀.natDegree = p.natDegree := Polynomial.natDegree_eq_of_degree_eq hp₀deg
    have hb₀ : b₀ ∉ RingHom.ker ρ := fun h => hb' (Ideal.Quotient.eq_zero_iff_mem.mpr h)
    have hsumP : ∑ k ∈ Finset.range (p₀.natDegree + 1),
        p₀.coeff k * a₀ ^ k * b₀ ^ (p₀.natDegree - k) ∈ RingHom.ker ρ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sum, hnd, ← hsum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [map_mul, map_mul, map_pow, map_pow, ← Polynomial.coeff_map, hp₀map]
    obtain ⟨c, t, hcP, -, htc, hint⟩ := wcpa_dj_lr1k_nsr_eb_bc_lift_integral R (RingHom.ker ρ)
      hP a₀ b₀ p₀ hb₀ hp₀m hsumP
    have hc0 : ρ c ≠ 0 := fun h => hcP (RingHom.mem_ker.mpr h)
    have hb0 : ρ b₀ ≠ 0 := fun h => hb₀ (RingHom.mem_ker.mpr h)
    have e2 : ρ t = ρ b₀ * ρ c := by
      have := RingHom.mem_ker.mp htc
      rw [map_sub, sub_eq_zero, map_mul] at this
      exact this
    have key : ∀ ψ₀ : FractionRing R →+* κ, ψ₀.comp (algebraMap R (FractionRing R)) = ρ →
        ψ₀ (IsLocalization.mk' (FractionRing R) (a₀ * c) t) =
          RingHom.kerLift ρ (Ideal.Quotient.mk _ a₀) /
            RingHom.kerLift ρ (Ideal.Quotient.mk _ b₀) := by
      intro ψ₀ hψ₀
      have e1 := star R κ ρ ψ₀ hψ₀ (a₀ * c) t
      rw [hφmk, hφmk, eq_div_iff hb0]
      apply mul_right_cancel₀ hc0
      rw [mul_assoc, ← e2, e1, map_mul]
    refine ⟨_, hint, ?_⟩
    rw [key ψ hψ, key ψ' hψ']
    exact hsep'

  have domlt : ∀ (ζ : F) (h : ζ ⤳ w) (V : ValuationSubring (F.residueField ζ)),
      wcNsrEbDom F h V →
      ∀ d ∈ IsLocalRing.maximalIdeal (F.presheaf.stalk w), V.valuation (wcNsrEbRho F h d) < 1 := by
    intro ζ h V hD d hd
    obtain ⟨hs, hm⟩ := hD d
    exact (ValuationSubring.valuation_lt_one_iff V _).mp (hm hd)

  have kerne : ∀ (ζ ζ' : F) (h : ζ ⤳ w) (h' : ζ' ⤳ w), ζ ≠ ζ' →
      RingHom.ker (wcNsrEbRho F h) ≠ RingHom.ker (wcNsrEbRho F h') := by
    intro ζ ζ' h h' hne heq
    obtain ⟨q, hq, hqζ⟩ := wcpa_dj_lr1k_nsr_eb_bc_ker_point F h
    obtain ⟨q', hq', hqζ'⟩ := wcpa_dj_lr1k_nsr_eb_bc_ker_point F h'
    apply hne
    have hqq : q = q' := PrimeSpectrum.ext (hq.trans (heq.trans hq'.symm))
    rw [← hqζ, ← hqζ', hqq]

  have pkg : ∀ (ζ : F) (h : ζ ⤳ w) (V : ValuationSubring (F.residueField ζ)),
      closure {ζ} ∈ irreducibleComponents F → wcNsrEbDom F h V →
      RingHom.ker (wcNsrEbRho F h) ∈ minimalPrimes (F.presheaf.stalk w) ∧
      ∃ ψ : FractionRing (F.presheaf.stalk w) →+* F.residueField ζ,
        ψ.comp (algebraMap (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))) =
          wcNsrEbRho F h ∧
        ∃ M : Ideal ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))),
          M.IsMaximal ∧
          ∀ y : ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))),
            y ∈ M ↔ V.valuation (ψ y) < 1 := by
    intro ζ h V hc hD
    obtain ⟨q, hq, hqζ⟩ := wcpa_dj_lr1k_nsr_eb_bc_ker_point F h
    have hmin : RingHom.ker (wcNsrEbRho F h) ∈ minimalPrimes (F.presheaf.stalk w) := by
      rw [← hq]
      apply wcpa_dj_lr1k_nsr_eb_bc_ker_minimal F w q
      rw [hqζ]; exact hc
    refine ⟨hmin, ?_⟩
    obtain ⟨ψ, hψ, hψV⟩ := wcpa_dj_lr1k_nsr_eb_bc_frac_extend _ _ (wcNsrEbRho F h) hmin V
      (fun r => (hD r).1)
    refine ⟨ψ, hψ, ?_⟩
    obtain ⟨M, hM, hMiff⟩ := wcpa_dj_lr1k_nsr_eb_bc_branch_ideal _ _ ψ V hψV (by
      intro r hr
      have := domlt ζ h V hD r hr
      rw [← hψ] at this
      exact this)
    exact ⟨M, hM, hMiff⟩

  have sepel : ∀ (ζ ζ' : F) (h : ζ ⤳ w) (h' : ζ' ⤳ w) (V : ValuationSubring (F.residueField ζ))
      (V' : ValuationSubring (F.residueField ζ'))
      (ψ : FractionRing (F.presheaf.stalk w) →+* F.residueField ζ)
      (ψ' : FractionRing (F.presheaf.stalk w) →+* F.residueField ζ'),
      ψ.comp (algebraMap (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))) =
        wcNsrEbRho F h →
      ψ'.comp (algebraMap (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))) =
        wcNsrEbRho F h' →
      RingHom.ker (wcNsrEbRho F h) ∈ minimalPrimes (F.presheaf.stalk w) →
      RingHom.ker (wcNsrEbRho F h') ∈ minimalPrimes (F.presheaf.stalk w) →
      wcNsrEbDom F h V → wcNsrEbDom F h' V' → wcNsrEbSep F h h' V V' →
      ∃ z : FractionRing (F.presheaf.stalk w), IsIntegral (F.presheaf.stalk w) z ∧
        ¬ (V.valuation (ψ z) < 1 ↔ V'.valuation (ψ' z) < 1) := by
    intro ζ ζ' h h' V V' ψ ψ' hψ hψ' hP hP' hD hD' hS
    by_cases hz : ζ = ζ'
    · subst hz
      rcases hS with hS | ⟨r, s, hs, -, hsep⟩
      · exact absurd rfl hS
      · exact caseB _ hdim _ (wcNsrEbRho F h) ψ ψ' V V' hψ hψ' hP (fun d => (hD d).1)
          (fun d => (hD' d).1) (domlt ζ h V hD) (domlt ζ h' V' hD') r s hs hsep
    · obtain ⟨z, hz', h1, h0⟩ := caseA _ _ _ _ _ ψ ψ' hψ hψ' hP hP' (kerne ζ ζ' h h' hz)
      refine ⟨z, hz', ?_⟩
      rw [h1, h0, map_one, map_zero]
      simp

  have Mne : ∀ (κ κ' : Type u) [Field κ] [Field κ'] (V : ValuationSubring κ)
      (V' : ValuationSubring κ') (ψ : FractionRing (F.presheaf.stalk w) →+* κ)
      (ψ' : FractionRing (F.presheaf.stalk w) →+* κ')
      (M M' : Ideal ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w)))),
      (∀ y : ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))),
        y ∈ M ↔ V.valuation (ψ y) < 1) →
      (∀ y : ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))),
        y ∈ M' ↔ V'.valuation (ψ' y) < 1) →
      (∃ z : FractionRing (F.presheaf.stalk w), IsIntegral (F.presheaf.stalk w) z ∧
        ¬ (V.valuation (ψ z) < 1 ↔ V'.valuation (ψ' z) < 1)) → M ≠ M' := by
    intro κ κ' _ _ V V' ψ ψ' M M' hM hM' ⟨z, hz, hsep⟩ heq
    apply hsep
    have a1 := hM ⟨z, hz⟩
    have a2 := hM' ⟨z, hz⟩
    rw [heq] at a1
    exact a1.symm.trans a2
  obtain ⟨hP₁, ψ₁, hψ₁, M₁, hM₁, hM₁i⟩ := pkg ζ₁ h₁ V₁ hc₁ hD₁
  obtain ⟨hP₂, ψ₂, hψ₂, M₂, hM₂, hM₂i⟩ := pkg ζ₂ h₂ V₂ hc₂ hD₂
  obtain ⟨hP₃, ψ₃, hψ₃, M₃, hM₃, hM₃i⟩ := pkg ζ₃ h₃ V₃ hc₃ hD₃
  have e12 : M₁ ≠ M₂ := Mne _ _ V₁ V₂ ψ₁ ψ₂ M₁ M₂ hM₁i hM₂i
    (sepel ζ₁ ζ₂ h₁ h₂ V₁ V₂ ψ₁ ψ₂ hψ₁ hψ₂ hP₁ hP₂ hD₁ hD₂ hS₁₂)
  have e13 : M₁ ≠ M₃ := Mne _ _ V₁ V₃ ψ₁ ψ₃ M₁ M₃ hM₁i hM₃i
    (sepel ζ₁ ζ₃ h₁ h₃ V₁ V₃ ψ₁ ψ₃ hψ₁ hψ₃ hP₁ hP₃ hD₁ hD₃ hS₁₃)
  have e23 : M₂ ≠ M₃ := Mne _ _ V₂ V₃ ψ₂ ψ₃ M₂ M₃ hM₂i hM₃i
    (sepel ζ₂ ζ₃ h₂ h₃ V₂ V₃ ψ₂ ψ₃ hψ₂ hψ₃ hP₂ hP₃ hD₂ hD₃ hS₂₃)
  unfold wcpaDjLkBad wcpaDjLkDelta wcpaDjLkBranches
  rintro (h0 | ⟨-, h2⟩)
  ·
    obtain ⟨z, hz, h1, h0'⟩ := caseA _ _ _ _ _ ψ₁ ψ₂ hψ₁ hψ₂ hP₁ hP₂ (kerne ζ₁ ζ₂ h₁ h₂ hne₁₂)
    rw [Module.length_eq_zero_iff] at h0
    have hmk := Subsingleton.elim (Submodule.Quotient.mk
      (p := (Algebra.linearMap (F.presheaf.stalk w)
        ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w)))).range)
      (⟨z, hz⟩ : ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w))))) 0
    rw [Submodule.Quotient.mk_eq_zero, LinearMap.mem_range] at hmk
    obtain ⟨r', hr'⟩ := hmk
    have hz' : algebraMap (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w)) r' = z :=
      congrArg Subtype.val hr'
    have e1 : wcNsrEbRho F h₁ r' = 1 := by rw [← hψ₁, RingHom.comp_apply, hz', h1]
    have e2 : wcNsrEbRho F h₂ r' = 0 := by rw [← hψ₂, RingHom.comp_apply, hz', h0']
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self r' with hu | hu
    · exact (hu.map (wcNsrEbRho F h₂)).ne_zero e2
    · exact (hu.map (wcNsrEbRho F h₁)).ne_zero (by rw [map_sub, map_one, e1, sub_self])
  ·
    have hinj : Function.Injective
        (![⟨M₁, hM₁⟩, ⟨M₂, hM₂⟩, ⟨M₃, hM₃⟩] : Fin 3 → MaximalSpectrum
          ↥(integralClosure (F.presheaf.stalk w) (FractionRing (F.presheaf.stalk w)))) := by
      intro i j hij
      fin_cases i <;> fin_cases j <;>
        first
        | rfl
        | (exfalso
           simp at hij
           first
           | exact e12 hij | exact e12 hij.symm | exact e13 hij | exact e13 hij.symm
           | exact e23 hij | exact e23 hij.symm)
    have hcard := ENat.card_le_card_of_injective hinj
    rw [ENat.card_eq_coe_fintype_card, Fintype.card_fin, h2] at hcard
    have : (3 : ℕ) ≤ 2 := by exact_mod_cast hcard
    omega

theorem wcpa_dj_lr1k_nsr_glb_exh_bij : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
