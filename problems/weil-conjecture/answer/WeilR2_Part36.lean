  have K5 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (C X : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (h : C ⟶ X) (uX : X ⟶ Spec (.of ↥W)) (str : C ⟶ Spec (.of Ω)), h ≫ uX = str ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) → ∀ (O : X.Opens) (hη : genericPoint C ∈ h ⁻¹ᵁ O) (a : ↥W), (C.presheaf.germ (h ⁻¹ᵁ O) (genericPoint C) hη).hom ((h.app O).hom ((uX.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))) = wcLr1uConst str (a : Ω) := by
