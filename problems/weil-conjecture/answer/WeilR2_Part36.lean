    · linear_combination hw - he - e * hεn
  by_cases hPt : Pt = 0
  · exfalso
    obtain ⟨a, ha, -⟩ := s4 1 one_ne_zero
    obtain ⟨α, rfl⟩ := IsLocalRing.residue_surjective a
    obtain ⟨z, h1, h2, h3⟩ := H1 α ha
    obtain ⟨u, hu, hy⟩ := s2 z _ h1 h2 h3
    rw [hPt, Polynomial.eval_zero] at hy
    exact hG0 ((mul_eq_zero.mp hy.symm).resolve_right hu.ne_zero)

  have s3 : ∀ P : Polynomial ↥W, P ≠ 0 →
      ∃ (μ : ↥W) (P0 : Polynomial ↥W), P = Polynomial.C μ * P0 ∧ ∃ j, P0.coeff j = 1 := by
    intro P hP
    obtain ⟨j, hj, hmax⟩ := Finset.exists_max_image P.support
      (fun i => W.valuation ((P.coeff i : ↥W) : Ω)) (Polynomial.nonempty_support_iff.mpr hP)
    have hμ0 : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
    have hdvd : ∀ i, P.coeff j ∣ P.coeff i := by
      intro i
      by_cases hi : i ∈ P.support
      · obtain ⟨a, ha⟩ := (W.valuation_le_iff _ _).mp (hmax i hi)
        exact ⟨a, Subtype.ext (ha.symm.trans (mul_comm _ _))⟩
      · rw [Polynomial.notMem_support_iff.mp hi]; exact dvd_zero _
    obtain ⟨P0, hP0⟩ := (Polynomial.C_dvd_iff_dvd_coeff _ _).mpr hdvd
    refine ⟨P.coeff j, P0, hP0, j, ?_⟩
    have h1 : P.coeff j = P.coeff j * P0.coeff j := by
      conv_lhs => rw [hP0]
      rw [Polynomial.coeff_C_mul]
    exact mul_left_cancel₀ hμ0 (h1.symm.trans (mul_one _).symm)
  obtain ⟨μ, P0, hPμ, j, hj⟩ := s3 Pt hPt
  have hP0bar : P0.map (IsLocalRing.residue ↥W) ≠ 0 := by
    intro h
    have h' := congrArg (fun p => p.coeff j) h
    simp only [Polynomial.coeff_map, hj, map_one, Polynomial.coeff_zero] at h'
    exact one_ne_zero h'
  obtain ⟨a, haD, haP⟩ := s4 _ hP0bar
  obtain ⟨α, rfl⟩ := IsLocalRing.residue_surjective a
  have hρ := hunit P0 α haP
  obtain ⟨z, h1, h2, h3⟩ := H1 α haD
  obtain ⟨u, hu, hy⟩ := s2 z _ h1 h2 h3
  have hev : Pt.eval α = μ * P0.eval α := by rw [hPμ, Polynomial.eval_mul, Polynomial.eval_C]
  have hvu : IsUnit (u * ↑hρ.unit⁻¹) := hu.mul (Units.isUnit _)
  have hμ : μ = G * (u * ↑hρ.unit⁻¹) := by
    have h4 : μ * P0.eval α = G * u := hev.symm.trans hy
    calc μ = μ * P0.eval α * ↑hρ.unit⁻¹ := by rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
      _ = G * (u * ↑hρ.unit⁻¹) := by rw [h4, mul_assoc]
  refine ⟨Polynomial.C (u * ↑hρ.unit⁻¹) * P0, ?_, ⟨j, ?_⟩, ?_⟩
  · rw [hPμ, hμ, Polynomial.C_mul, mul_assoc]
  · rw [Polynomial.coeff_C_mul, hj, mul_one]
    intro hm
    exact ((IsLocalRing.mem_maximalIdeal _).mp hm) hvu
  · by_contra hdeg
    push_neg at hdeg
    have hd0 := Nat.le_zero.mp hdeg
    have hKeq := Polynomial.eq_C_of_natDegree_eq_zero hd0
    have hKj : ((Polynomial.C (u * ↑hρ.unit⁻¹) * P0).map (IsLocalRing.residue ↥W)).coeff j ≠ 0 := by
      rw [Polynomial.coeff_map, Polynomial.coeff_C_mul, hj, mul_one]
      exact hresne _ hvu
    have hc : ((Polynomial.C (u * ↑hρ.unit⁻¹) * P0).map (IsLocalRing.residue ↥W)).coeff 0 ≠ 0 := by
      intro h
      apply hKj
      rw [hKeq, h, Polynomial.C_0, Polynomial.coeff_zero]
    obtain ⟨α₀, e, he⟩ := H2
    have hκ : IsUnit ((Polynomial.C (u * ↑hρ.unit⁻¹) * P0).eval α₀) := by
      apply hunit
      rw [hKeq, Polynomial.eval_C]
      exact hc
    have hPα₀ : Pt.eval α₀ = G * (Polynomial.C (u * ↑hρ.unit⁻¹) * P0).eval α₀ := by
      rw [hPμ, hμ, Polynomial.C_mul, mul_assoc, Polynomial.eval_mul, Polynomial.eval_C]
    rw [hPα₀, hεn, mul_assoc] at he
    have h5 := mul_left_cancel₀ hG0 he
    rw [h5] at hκ
    exact hn (isUnit_of_mul_isUnit_left hκ)

theorem wcpa_dj_llsm_smpcgbtige_residue_transc : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (M : Type u) [Field M] (V : ValuationSubring M) (ψ : ↥W →+* M) (w δ : M) (Kt : Polynomial ↥W) (ε₀ : ↥W), (∀ a : ↥W, ψ a ∈ V) → (∀ p : Polynomial ↥W, (∃ i, p.coeff i ∉ IsLocalRing.maximalIdeal ↥W) → V.valuation (p.eval₂ ψ w) = 1) → V.valuation δ < 1 → IsUnit ε₀ → 0 < (Kt.map (IsLocalRing.residue ↥W)).natDegree → ∀ p : Polynomial ↥W, (∃ i, p.coeff i ∉ IsLocalRing.maximalIdeal ↥W) → V.valuation (p.eval₂ ψ (ψ ε₀ / (Kt.eval₂ ψ w + δ))) = 1 :=
by
  intro Ω _ W M _ V ψ w δ Kt ε₀ hψ hVg hδ hε hK p hp
  classical
  have hunit : ∀ x : ↥W, x ∉ IsLocalRing.maximalIdeal ↥W ↔ IsUnit x := by
    intro x
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
  have hadd : ∀ x z : M, V.valuation z < V.valuation x →
      V.valuation (x + z) = V.valuation x := by
    intro x z h
    exact Valuation.map_add_eq_of_lt_left _ h

  have s2 : ∀ Q : Polynomial ↥W, (∃ i, Q.coeff i ∉ IsLocalRing.maximalIdeal ↥W) →
      ∃ j, (Q.comp Kt).coeff j ∉ IsLocalRing.maximalIdeal ↥W := by
    intro Q ⟨i, hi⟩
    have hQ : Q.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      apply hi
      have := congrArg (fun q => q.coeff i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact (IsLocalRing.residue_eq_zero_iff _).mp this
    have hc : (Q.comp Kt).map (IsLocalRing.residue ↥W) ≠ 0 := by
      rw [Polynomial.map_comp]
      intro h
      rw [Polynomial.comp_eq_zero_iff] at h
      rcases h with h | ⟨_, h⟩
      · exact hQ h
      · rw [h, Polynomial.natDegree_C] at hK
        exact lt_irrefl _ hK
    by_contra hall
    push_neg at hall
    apply hc
    ext j
    rw [Polynomial.coeff_map, Polynomial.coeff_zero]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr (hall j)

  have hy1 : V.valuation (Kt.eval₂ ψ w) = 1 := by
    obtain ⟨j, hj⟩ := s2 Polynomial.X
      ⟨1, by rw [Polynomial.coeff_X_one, hunit]; exact isUnit_one⟩
    rw [Polynomial.X_comp] at hj
    exact hVg Kt ⟨j, hj⟩
  have hδV : δ ∈ V := (V.valuation_le_one_iff δ).mp hδ.le
  have hyV : Kt.eval₂ ψ w ∈ V := (V.valuation_le_one_iff _).mp hy1.le
  have hy'1 : V.valuation (Kt.eval₂ ψ w + δ) = 1 := by
    rw [hadd _ _ (by rw [hy1]; exact hδ), hy1]
  have hy'0 : Kt.eval₂ ψ w + δ ≠ 0 := by
    intro h
    rw [h, Valuation.map_zero] at hy'1
    exact zero_ne_one hy'1

  have s3 : ∀ (Q : Polynomial ↥W) (a : M), a ∈ V →
      V.valuation (Q.eval₂ ψ (a + δ) - Q.eval₂ ψ a) ≤ V.valuation δ := by
    intro Q a ha
    let ψV : ↥W →+* ↥V := ψ.codRestrict V hψ
    have hcoe : ∀ (x : M) (hx : x ∈ V),
        (((Q.map ψV).eval (⟨x, hx⟩ : ↥V) : ↥V) : M) = Q.eval₂ ψ x := by
      intro x hx
      rw [Polynomial.eval_map]
      show V.subtype (Q.eval₂ ψV ⟨x, hx⟩) = _
      rw [Polynomial.hom_eval₂]
      have hcomp : V.subtype.comp ψV = ψ := RingHom.ext fun _ => rfl
      rw [hcomp]
      rfl
    obtain ⟨e, he⟩ := Polynomial.sub_dvd_eval_sub (⟨a + δ, add_mem ha hδV⟩ : ↥V) ⟨a, ha⟩
      (Q.map ψV)
    have h1 := congrArg V.subtype he
    rw [map_sub, map_mul, map_sub] at h1
    change (((Q.map ψV).eval (⟨a + δ, add_mem ha hδV⟩ : ↥V) : ↥V) : M) -
        (((Q.map ψV).eval (⟨a, ha⟩ : ↥V) : ↥V) : M) = ((a + δ) - a) * (e : M) at h1
    rw [hcoe, hcoe, add_sub_cancel_left] at h1
    rw [h1, Valuation.map_mul]
    exact mul_le_of_le_one_right' ((V.valuation_le_one_iff _).mpr e.2)

  obtain ⟨i₀, hi₀⟩ := hp
  have hi₀n : i₀ ≤ p.natDegree := by
    by_contra h
    push_neg at h
    apply hi₀
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt h]
    exact Ideal.zero_mem _
  set Q : Polynomial ↥W := ∑ i ∈ Finset.range (p.natDegree + 1),
    Polynomial.C (p.coeff i * ε₀ ^ i) * Polynomial.X ^ (p.natDegree - i) with hQ
  have hQcoeff : Q.coeff (p.natDegree - i₀) = p.coeff i₀ * ε₀ ^ i₀ := by
    rw [hQ, Polynomial.finset_sum_coeff, Finset.sum_eq_single i₀]
    · rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl]
    · intro i hi hne
      have := Finset.mem_range.mp hi
      rw [Polynomial.coeff_C_mul_X_pow, if_neg]
      omega
    · intro h
      exact absurd (Finset.mem_range.mpr (by omega)) h
  have hQprim : ∃ i, Q.coeff i ∉ IsLocalRing.maximalIdeal ↥W :=
    ⟨p.natDegree - i₀, by rw [hQcoeff, hunit]; exact ((hunit _).mp hi₀).mul (hε.pow _)⟩
  have hid : ∀ y : M, y ≠ 0 → p.eval₂ ψ (ψ ε₀ / y) * y ^ p.natDegree = Q.eval₂ ψ y := by
    intro y hy
    rw [Polynomial.eval₂_eq_sum_range, Finset.sum_mul, hQ, Polynomial.eval₂_finset_sum]
    apply Finset.sum_congr rfl
    intro i hi
    have hin : i ≤ p.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    have hyi : y ^ i ≠ 0 := pow_ne_zero _ hy
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, map_mul, map_pow,
      div_pow, show y ^ p.natDegree = y ^ i * y ^ (p.natDegree - i) by
        rw [← pow_add, Nat.add_sub_cancel' hin]]
    field_simp

  have hQy : V.valuation (Q.eval₂ ψ (Kt.eval₂ ψ w)) = 1 := by
    obtain ⟨j, hj⟩ := s2 Q hQprim
    have := hVg _ ⟨j, hj⟩
    rwa [Polynomial.eval₂_comp] at this
  have hQy' : V.valuation (Q.eval₂ ψ (Kt.eval₂ ψ w + δ)) = 1 := by
    have h3 := s3 Q _ hyV
    have e : Q.eval₂ ψ (Kt.eval₂ ψ w + δ) = Q.eval₂ ψ (Kt.eval₂ ψ w) +
        (Q.eval₂ ψ (Kt.eval₂ ψ w + δ) - Q.eval₂ ψ (Kt.eval₂ ψ w)) := by ring
    rw [e, hadd _ _ (lt_of_le_of_lt h3 (hδ.trans_eq hQy.symm)), hQy]
  have hfin := congrArg V.valuation (hid _ hy'0)
  rw [Valuation.map_mul, Valuation.map_pow, hy'1, one_pow, mul_one, hQy'] at hfin
  exact hfin

theorem wcpa_dj_llsm_smpcgbti_gauss_extension : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ R : List ↥W, (∀ r ∈ R, r ∈ IsLocalRing.maximalIdeal ↥W) →
    (∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      (θ (algebraMap A B t) - c ∣ (R.map (fun r => θ t' - r)).prod ∧
        (R.map (fun r => θ t' - r)).prod ∣ θ (algebraMap A B t) - c)) →
    ∀ x γ : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → γ ∈ IsLocalRing.maximalIdeal ↥W → γ ≠ 0 →
    (∃ r ∈ R, γ ∣ x - r) →
    b ∣ (R.map (fun r => @ite _ (γ ∣ x - r) (Classical.propDecidable _) γ (x - r))).prod →
    (R.map (fun r => @ite _ (γ ∣ x - r) (Classical.propDecidable _) γ (x - r))).prod ∣ b →
    ∃ V : ValuationSubring M, wcSmpcgbtiGauss W A K M 𝔭 t c b V ∧
      ∀ y : ↥W,
        (γ ∣ x - y → V.valuation (algebraMap B M t' -
            ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) y) =
          V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) γ)) ∧
        (¬ γ ∣ x - y → V.valuation (algebraMap B M t' -
            ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) y) =
          V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) (x - y))) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' hPD hSmc
    c b hc hbm hb0 R hRm hR x γ hxm hγm hγ0 hr₀ hbG hGb

  have hPDB : wcLlsPD W B 𝔮 (.disc t') := hSmc.2.2.1
  have hcA : 𝔮.comap (algebraMap A B) = 𝔭 := hSmc.2.2.2.1
  have hAM : ∀ a : A, algebraMap K M (algebraMap A K a) = algebraMap B M (algebraMap A B a) := by
    intro a
    rw [← IsScalarTower.algebraMap_apply A K M, IsScalarTower.algebraMap_apply A B M]
  have hwM : ∀ y : ↥W, ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) y =
      algebraMap B M (algebraMap ↥W B y) := by
    intro y
    rw [RingHom.comp_apply, RingHom.comp_apply, hAM, ← IsScalarTower.algebraMap_apply ↥W A B]
  have hWMeq : ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) =
      (algebraMap B M).comp (algebraMap ↥W B) := RingHom.ext hwM
  have hwBinj : Function.Injective (algebraMap ↥W B) := by
    haveI := hPDB.2.1
    rw [injective_iff_map_eq_zero]
    intro y hy
    rw [Algebra.algebraMap_eq_smul_one] at hy
    exact (smul_eq_zero.mp hy).resolve_right one_ne_zero
  have hWMne : ∀ y : ↥W, y ≠ 0 →
      ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) y ≠ 0 := by
    intro y hy h0
    rw [hwM, ← map_zero (algebraMap B M)] at h0
    exact hy (hwBinj ((IsFractionRing.injective B M h0).trans (map_zero _).symm))
  have hunit : ∀ y : ↥W, y ∉ IsLocalRing.maximalIdeal ↥W → IsUnit y := by
    intro y hy
    by_contra hu
    exact hy ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hu))
  have h1m : (1 : ↥W) ∉ IsLocalRing.maximalIdeal ↥W := fun h1 =>
    (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hq : ∀ y : ↥W, algebraMap ↥W B y ∈ 𝔮 ↔ y ∈ IsLocalRing.maximalIdeal ↥W := by
    intro y
    constructor
    · intro hy
      by_contra hn
      exact hPDB.2.2.2.1.ne_top (Ideal.eq_top_of_isUnit_mem _ hy ((hunit y hn).map _))
    · intro hy
      exact hPDB.2.2.2.2.1 (Ideal.mem_map_of_mem _ hy)
  have hmem : ∀ α : ↥W, x + γ * α ∈ IsLocalRing.maximalIdeal ↥W := fun α =>
    Ideal.add_mem _ hxm (Ideal.mul_mem_right α _ hγm)
  have hιγ : algebraMap B M (algebraMap ↥W B γ) ≠ 0 := by
    rw [← hwM]; exact hWMne γ hγ0

  obtain ⟨G, hGdef⟩ : ∃ G : ↥W, G =
      (R.map (fun r => @ite _ (γ ∣ x - r) (Classical.propDecidable _) γ (x - r))).prod := ⟨_, rfl⟩
  rw [← hGdef] at hbG hGb
  have hG0 : G ≠ 0 := by
    rintro rfl
    exact hb0 (zero_dvd_iff.mp hGb)
  have hιG : algebraMap B M (algebraMap ↥W B G) ≠ 0 := by
    rw [← hwM]; exact hWMne G hG0
  obtain ⟨d, hd⟩ := id hbG
  obtain ⟨ε₀, hε₀⟩ := id hGb
  have hε₀u : IsUnit ε₀ := by
    have e : b * (d * ε₀) = b * 1 := by rw [mul_one, ← mul_assoc, ← hd, ← hε₀]
    exact isUnit_of_dvd_one ⟨d, by rw [mul_comm]; exact (mul_left_cancel₀ hb0 e).symm⟩

  obtain ⟨V, hVB, hVlt, hVg⟩ :=
    wcpa_dj_llsm_smpcgbtige_gauss_point Ω W hW hWt B M 𝔮 t' hPDB x γ hxm hγm hγ0
  generalize hw : (algebraMap B M t' - algebraMap B M (algebraMap ↥W B x)) /
    algebraMap B M (algebraMap ↥W B γ) = w at hVg
  have hw_eq : algebraMap B M (algebraMap ↥W B γ) * w =
      algebraMap B M t' - algebraMap B M (algebraMap ↥W B x) := by
    rw [← hw, mul_div_assoc', mul_div_cancel_left₀ _ hιγ]
  have hv1 : ∀ y : ↥W,
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) y) ≤ 1 := by
    intro y
    rw [hwM]
    exact (V.valuation_le_one_iff _).mpr (hVB _)
  have hvlt : ∀ y : ↥W,
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) y) < 1 ↔
        y ∈ IsLocalRing.maximalIdeal ↥W := by
    intro y
    rw [hwM, hVlt, hq]
  have hv0 : ∀ y : ↥W, y ≠ 0 →
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) y) ≠ 0 :=
    fun y hy => (Valuation.ne_zero_iff _).mpr (hWMne y hy)
  have hG3 : ∀ w₁ w₂ : ↥W,
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w₁) ≤
        V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w₂) ↔
      w₂ ∣ w₁ := by
    intro w₁ w₂
    constructor
    · intro hle
      by_contra hnd
      rcases ValuationRing.dvd_total w₁ w₂ with ⟨u, hu⟩ | hdv
      · have hum : u ∈ IsLocalRing.maximalIdeal ↥W := by
          by_contra hn
          have hu' := hunit u hn
          exact hnd ⟨↑hu'.unit⁻¹, by rw [hu, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
        have hw1 : w₁ ≠ 0 := by
          rintro rfl
          exact hnd (dvd_zero _)
        have hlt : V.valuation (((algebraMap K M).comp ((algebraMap A K).comp
              (algebraMap ↥W A))) w₂) <
            V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w₁) := by
          rw [hu, map_mul, Valuation.map_mul]
          exact mul_lt_of_lt_one_right (zero_lt_iff.mpr (hv0 w₁ hw1)) ((hvlt u).mpr hum)
        exact absurd hle (not_le.mpr hlt)
      · exact hnd hdv
    · rintro ⟨k, rfl⟩
      rw [map_mul, Valuation.map_mul]
      exact mul_le_of_le_one_right' (hv1 k)
  have hvw : V.valuation w = 1 := by
    have := hVg Polynomial.X ⟨1, by rw [Polynomial.coeff_X_one]; exact h1m⟩
    rwa [Polynomial.eval₂_X] at this
  have hLy : ∀ y : ↥W, algebraMap B M t' - algebraMap B M (algebraMap ↥W B y) =
      algebraMap B M (algebraMap ↥W B γ) * w + algebraMap B M (algebraMap ↥W B (x - y)) := by
    intro y
    rw [hw_eq, map_sub (algebraMap ↥W B), map_sub (algebraMap B M)]
    ring

  obtain ⟨N, hN⟩ := wcpa_dj_lr1k_ebnt_dms_rank_one_power Ω W hW G γ hG0 hγm hγ0
  have hGε : G ∣ γ ^ (N + 1) := dvd_trans hN (pow_dvd_pow γ (Nat.le_succ N))
  have hεG : ¬ γ ^ (N + 1) ∣ G := by
    intro hdv
    have h2 : γ ^ N * γ ∣ γ ^ N * 1 := by
      rw [mul_one, ← pow_succ]; exact dvd_trans hdv hN
    have h3 : γ ∣ 1 := (mul_dvd_mul_iff_left (pow_ne_zero N hγ0)).mp h2
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hγm) (isUnit_of_dvd_one h3)
  obtain ⟨P, S, E, hS, hTay⟩ := wcpa_dj_llsm_smpcgbtige_taylor_alg Ω W hW hWt B 𝔮 t' hPDB x hxm
    (N + 1) (by omega) (algebraMap A B (t - algebraMap ↥W A c))

  have hdvθ : ∀ (θ : B →ₐ[↥W] ↥W) (α : ↥W), θ t' = x + γ * α →
      (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      γ ^ (N + 1) ∣ θ (algebraMap A B t) - c -
        (P.comp (Polynomial.C γ * Polynomial.X)).eval α := by
    intro θ α hθt hθc
    have hθS : IsUnit (θ S) := hunit _ (fun hm => hS (by rw [← hθc]; exact hm))
    have hθT : θ (t' - algebraMap ↥W B x) = γ * α := by
      rw [map_sub, hθt, AlgHom.commutes]
      change x + γ * α - x = γ * α
      ring
    have hθP : θ (P.eval₂ (algebraMap ↥W B) (t' - algebraMap ↥W B x)) =
        (P.comp (Polynomial.C γ * Polynomial.X)).eval α := by
      rw [← Polynomial.aeval_def, ← Polynomial.aeval_algHom_apply θ, hθT,
        Polynomial.coe_aeval_eq_eval, Polynomial.eval_comp]
      simp
    have hθz : θ (algebraMap A B (t - algebraMap ↥W A c)) = θ (algebraMap A B t) - c := by
      rw [map_sub, map_sub, ← IsScalarTower.algebraMap_apply ↥W A B c, AlgHom.commutes]
      rfl
    have key : θ S * (θ (algebraMap A B (t - algebraMap ↥W A c)) -
        θ (P.eval₂ (algebraMap ↥W B) (t' - algebraMap ↥W B x))) =
        θ (t' - algebraMap ↥W B x) ^ (N + 1) * θ E := by
      rw [← map_sub θ, ← map_mul θ, hTay, map_mul θ, map_pow θ]
    rw [hθz, hθP, hθT] at key
    rw [← IsUnit.dvd_mul_left hθS, key, mul_pow]
    exact dvd_mul_of_dvd_left (dvd_mul_right _ _) _
  obtain ⟨hn4a, D, hD0, hD⟩ := wcpa_dj_llsm_smpcgbtige_disc_factors Ω W R x γ hγ0
  have hgen : ∀ α : ↥W, D.eval (IsLocalRing.residue ↥W α) ≠ 0 → ∃ z : ↥W, G ∣ z ∧ z ∣ G ∧
      γ ^ (N + 1) ∣ z - (P.comp (Polynomial.C γ * Polynomial.X)).eval α := by
    intro α hα
    obtain ⟨θ, hθt, hθc⟩ :=
      wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB (x + γ * α) (hmem α)
    obtain ⟨h1, h2⟩ := hn4a α (hD α hα)
    obtain ⟨h3, h4⟩ := hR θ hθc
    rw [hθt] at h3 h4
    rw [← hGdef] at h1 h2
    exact ⟨θ (algebraMap A B t) - c, dvd_trans h1 h4, dvd_trans h3 h2, hdvθ θ α hθt hθc⟩
  obtain ⟨r₀, hr₀R, u₀, hu₀⟩ := hr₀
  have hspecial : γ ^ (N + 1) ∣ (P.comp (Polynomial.C γ * Polynomial.X)).eval (-u₀) := by
    obtain ⟨θ, hθt, hθc⟩ :=
      wcpa_dj_llsm_sm_points_exist Ω W hW hWt B 𝔮 t' hPDB (x + γ * -u₀) (hmem (-u₀))
    have hz0 : θ (algebraMap A B t) - c = 0 := by
      obtain ⟨_, h4⟩ := hR θ hθc
      have hp0 : (R.map (fun r => θ t' - r)).prod = 0 :=
        List.prod_eq_zero (List.mem_map.mpr ⟨r₀, hr₀R, by rw [hθt]; linear_combination hu₀⟩)
      rw [hp0] at h4
      exact zero_dvd_iff.mp h4
    have := hdvθ θ (-u₀) hθt hθc
    rwa [hz0, zero_sub, dvd_neg] at this
  obtain ⟨Kt, hPt, hKunit, hKdeg⟩ := wcpa_dj_llsm_smpcgbtige_poly_compare Ω W
    (P.comp (Polynomial.C γ * Polynomial.X)) G (γ ^ (N + 1)) D hG0 hGε hεG hD0 hgen ⟨-u₀, hspecial⟩

  have hιT : algebraMap B M (t' - algebraMap ↥W B x) = algebraMap B M (algebraMap ↥W B γ) * w := by
    rw [map_sub, hw_eq]
  have hιP : algebraMap B M (P.eval₂ (algebraMap ↥W B) (t' - algebraMap ↥W B x)) =
      algebraMap B M (algebraMap ↥W B G) *
        Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w := by
    have e1 : (P.comp (Polynomial.C γ * Polynomial.X)).eval₂
        ((algebraMap B M).comp (algebraMap ↥W B)) w =
        P.eval₂ ((algebraMap B M).comp (algebraMap ↥W B))
          ((algebraMap B M).comp (algebraMap ↥W B) γ * w) := by
      rw [Polynomial.eval₂_comp, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X]
    have e2 : (P.comp (Polynomial.C γ * Polynomial.X)).eval₂
        ((algebraMap B M).comp (algebraMap ↥W B)) w =
        (algebraMap B M).comp (algebraMap ↥W B) G *
          Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w := by
      rw [hPt, Polynomial.eval₂_mul, Polynomial.eval₂_C]
    rw [Polynomial.hom_eval₂, hιT]
    exact e1.symm.trans e2
  have hM : algebraMap B M S * (algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) -
      algebraMap B M (algebraMap ↥W B G) * Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) =
      (algebraMap B M (algebraMap ↥W B γ) * w) ^ (N + 1) * algebraMap B M E := by
    rw [← hιP, ← hιT, ← map_sub (algebraMap B M), ← map_mul (algebraMap B M), hTay,
      map_mul (algebraMap B M), map_pow (algebraMap B M)]
  have hvS : V.valuation (algebraMap B M S) = 1 :=
    le_antisymm ((V.valuation_le_one_iff _).mpr (hVB S))
      (not_lt.mp (fun hlt => hS ((hVlt S).mp hlt)))
  have hvE : V.valuation (algebraMap B M E) ≤ 1 := (V.valuation_le_one_iff _).mpr (hVB E)
  have hk1 : V.valuation (Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) = 1 :=
    hVg Kt hKunit
  have hlt : V.valuation (algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) -
      algebraMap B M (algebraMap ↥W B G) * Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) <
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) G) := by
    have e := congrArg V.valuation hM
    have hl : V.valuation (algebraMap B M S *
        (algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) -
          algebraMap B M (algebraMap ↥W B G) *
            Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w)) =
        V.valuation (algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) -
          algebraMap B M (algebraMap ↥W B G) *
            Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) := by
      rw [Valuation.map_mul, hvS, one_mul]
    have hr : V.valuation ((algebraMap B M (algebraMap ↥W B γ) * w) ^ (N + 1) *
        algebraMap B M E) =
        V.valuation (algebraMap B M (algebraMap ↥W B γ)) ^ (N + 1) *
          V.valuation (algebraMap B M E) := by
      rw [Valuation.map_mul, Valuation.map_pow, Valuation.map_mul, hvw, mul_one]
    rw [hl, hr] at e
    rw [e]
    calc V.valuation (algebraMap B M (algebraMap ↥W B γ)) ^ (N + 1) *
          V.valuation (algebraMap B M E)
        ≤ V.valuation (algebraMap B M (algebraMap ↥W B γ)) ^ (N + 1) :=
          mul_le_of_le_one_right' hvE
      _ = V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A)))
            (γ ^ (N + 1))) := by
          rw [map_pow, Valuation.map_pow, hwM]
      _ < V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) G) :=
          not_le.mp (fun hle => hεG ((hG3 G (γ ^ (N + 1))).mp hle))
  have hvk : V.valuation (algebraMap B M (algebraMap ↥W B G) *
      Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) =
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) G) := by
    rw [Valuation.map_mul, hk1, mul_one, hwM]
  have hZv : V.valuation (algebraMap B M (algebraMap A B (t - algebraMap ↥W A c))) =
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) G) := by
    have hlt' : V.valuation (algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) -
        algebraMap B M (algebraMap ↥W B G) * Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) <
        V.valuation (algebraMap B M (algebraMap ↥W B G) *
          Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) := by
      rw [hvk]; exact hlt
    have h1 := Valuation.map_add_eq_of_lt_left V.valuation hlt'
    rw [show algebraMap B M (algebraMap ↥W B G) *
        Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w +
        (algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) -
          algebraMap B M (algebraMap ↥W B G) *
            Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w) =
        algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) by ring, hvk] at h1
    exact h1

  obtain ⟨δ, hδdef⟩ : ∃ δ : M, δ = algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) /
      algebraMap B M (algebraMap ↥W B G) -
        Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w := ⟨_, rfl⟩
  have hδ : V.valuation δ < 1 := by
    have e : algebraMap B M (algebraMap ↥W B G) * δ =
        algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) -
          algebraMap B M (algebraMap ↥W B G) *
            Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w := by
      rw [hδdef, mul_sub, mul_div_assoc', mul_div_cancel_left₀ _ hιG]
    have h2 := hlt
    rw [← e, Valuation.map_mul, hwM] at h2
    exact lt_of_mul_lt_mul_left' (by rwa [mul_one])
  have hs : algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
      algebraMap A K (t - algebraMap ↥W A c)) =
      ((algebraMap B M).comp (algebraMap ↥W B)) ε₀ /
        (Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w + δ) := by
    have hkd : Kt.eval₂ ((algebraMap B M).comp (algebraMap ↥W B)) w + δ =
        algebraMap B M (algebraMap A B (t - algebraMap ↥W A c)) /
          algebraMap B M (algebraMap ↥W B G) := by
      rw [hδdef]; ring
    rw [hkd, map_div₀, hAM, hAM, ← IsScalarTower.algebraMap_apply ↥W A B, div_div_eq_mul_div, hε₀,
      map_mul (algebraMap ↥W B), map_mul (algebraMap B M), RingHom.comp_apply]
    ring
  have hn5 := wcpa_dj_llsm_smpcgbtige_residue_transc Ω W M V
    ((algebraMap B M).comp (algebraMap ↥W B)) w δ Kt ε₀ (fun a => hVB (algebraMap ↥W B a))
    hVg hδ hε₀u hKdeg
  refine ⟨V, ?_, ?_⟩
  · unfold wcSmpcgbtiGauss
    refine ⟨?_, ?_, hG3, ?_, ?_⟩
    · intro a
      rw [hAM]
      exact hVB _
    · intro a
      rw [hAM, hVlt, ← hcA, Ideal.mem_comap]
    · rw [hAM, hZv]
      exact le_antisymm ((hG3 G b).mpr hbG) ((hG3 b G).mpr hGb)
    · intro p hp
      rw [hWMeq, hs]
      exact hn5 p hp
  · intro y
    rw [hwM y, hwM γ, hwM (x - y)]
    constructor
    · rintro ⟨u, hu⟩
      have hp : V.valuation (w + algebraMap B M (algebraMap ↥W B u)) = 1 := by
        have hc1 : (Polynomial.X + Polynomial.C u).coeff 1 ∉ IsLocalRing.maximalIdeal ↥W := by
          simpa using h1m
        have := hVg (Polynomial.X + Polynomial.C u) ⟨1, hc1⟩
        rwa [Polynomial.eval₂_add, Polynomial.eval₂_X, Polynomial.eval₂_C,
          RingHom.comp_apply] at this
      rw [hLy, hu, map_mul (algebraMap ↥W B), map_mul (algebraMap B M), ← mul_add,
        Valuation.map_mul, hp, mul_one]
    · intro hnd
      obtain ⟨u, hu⟩ := (ValuationRing.dvd_total γ (x - y)).resolve_left hnd
      have hp : V.valuation (algebraMap B M (algebraMap ↥W B u) * w + 1) = 1 := by
        have hc0 : (Polynomial.C u * Polynomial.X + 1).coeff 0 ∉ IsLocalRing.maximalIdeal ↥W := by
          simpa using h1m
        have := hVg (Polynomial.C u * Polynomial.X + 1) ⟨0, hc0⟩
        rwa [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X,
          Polynomial.eval₂_one, RingHom.comp_apply] at this
      rw [hLy, hu, map_mul (algebraMap ↥W B), map_mul (algebraMap B M),
        show algebraMap B M (algebraMap ↥W B (x - y)) * algebraMap B M (algebraMap ↥W B u) * w +
          algebraMap B M (algebraMap ↥W B (x - y)) =
          algebraMap B M (algebraMap ↥W B (x - y)) *
            (algebraMap B M (algebraMap ↥W B u) * w + 1) by ring,
        Valuation.map_mul, hp, mul_one]

theorem wcpa_dj_llsm_smpcgbtiic_ratfunc_normal_form : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (t : A) (c b : ↥W) (ι : RatFunc Ω →+* K), (∀ a : ↥W, ι (algebraMap Ω (RatFunc Ω) (a : Ω)) = algebraMap A K (algebraMap ↥W A a)) → ι RatFunc.X = algebraMap A K t → algebraMap A K (algebraMap ↥W A b) ≠ 0 → algebraMap A K (t - algebraMap ↥W A c) ≠ 0 → ∀ f : RatFunc Ω, f ≠ 0 → ∃ (γ : Ω) (e g : Polynomial ↥W), γ ≠ 0 ∧ (∃ i, IsUnit (e.coeff i)) ∧ (∃ i, IsUnit (g.coeff i)) ∧ ι f * e.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)) = ι (algebraMap Ω (RatFunc Ω) γ) * g.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)) :=
by
  intro Ω _ W A _ _ K _ _ t c b ι hW hX hb hz f hf
  classical
  set ψ : ↥W →+* K := (algebraMap A K).comp (algebraMap ↥W A) with hψ
  set s : K := algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) with hs
  set ιΩ : Ω →+* K := ι.comp (algebraMap Ω (RatFunc Ω)) with hιΩ
  set τ : K := algebraMap A K t with hτ

  have hcompW : ιΩ.comp W.subtype = ψ := RingHom.ext fun a => hW a

  have hs0 : s ≠ 0 := div_ne_zero hb hz
  have hsτ : ιΩ (c : Ω) * s + ιΩ (b : Ω) = s * τ := by
    have h1 : ιΩ (c : Ω) = algebraMap A K (algebraMap ↥W A c) := hW c
    have h2 : ιΩ (b : Ω) = algebraMap A K (algebraMap ↥W A b) := hW b
    have h3 : s * algebraMap A K (t - algebraMap ↥W A c) = algebraMap A K (algebraMap ↥W A b) :=
      div_mul_cancel₀ _ hz
    rw [map_sub] at h3
    rw [h1, h2, ← h3, hτ]
    ring

  have hev : ∀ R : Polynomial Ω, ι (algebraMap (Polynomial Ω) (RatFunc Ω) R) = R.eval₂ ιΩ τ := by
    intro R
    have : ι.comp (algebraMap (Polynomial Ω) (RatFunc Ω)) = Polynomial.eval₂RingHom ιΩ τ := by
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
          RatFunc.algebraMap_C, hιΩ, RingHom.comp_apply, RatFunc.algebraMap_eq_C]
      · rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          RatFunc.algebraMap_X, hX]
    exact RingHom.congr_fun this R

  have homog : ∀ (R : Polynomial Ω) (n : ℕ), R.natDegree ≤ n →
      ∃ R' : Polynomial Ω, s ^ n * R.eval₂ ιΩ τ = R'.eval₂ ιΩ s := by
    intro R n hn
    refine ⟨∑ j ∈ Finset.range (n + 1), Polynomial.C (R.coeff j) * Polynomial.X ^ (n - j) *
      (Polynomial.C (c : Ω) * Polynomial.X + Polynomial.C (b : Ω)) ^ j, ?_⟩
    rw [Polynomial.eval₂_eq_sum_range' ιΩ (by omega : R.natDegree < n + 1), Finset.mul_sum,
      Polynomial.eval₂_finsetSum]
    refine Finset.sum_congr rfl fun j hj => ?_
    have hj' : j ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_pow, Polynomial.eval₂_C,
      Polynomial.eval₂_X, Polynomial.eval₂_add]
    rw [hsτ, mul_pow, ← pow_sub_mul_pow s hj']
    ring

  have content : ∀ P : Polynomial Ω, P ≠ 0 → ∃ (β : Ω) (P₀ : Polynomial ↥W), β ≠ 0 ∧
      (∃ i, IsUnit (P₀.coeff i)) ∧ P = Polynomial.C β * P₀.map W.subtype := by
    intro P hP
    obtain ⟨j, hj, hjmax⟩ := Finset.exists_max_image P.support
      (fun i => W.valuation (P.coeff i)) (Polynomial.support_nonempty.mpr hP)
    have hβ : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
    have hv : W.valuation (P.coeff j) ≠ 0 := (Valuation.ne_zero_iff _).mpr hβ
    have hmem : ∀ i, (P.coeff j)⁻¹ * P.coeff i ∈ W := by
      intro i
      by_cases hi : i ∈ P.support
      · rw [← W.valuation_le_one_iff, map_mul, map_inv₀,
          inv_mul_le_iff₀ (zero_lt_iff.mpr hv), mul_one]
        exact hjmax i hi
      · rw [Polynomial.notMem_support_iff.mp hi, mul_zero]
        exact W.zero_mem
    have hlift : Polynomial.C (P.coeff j)⁻¹ * P ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_C_mul]
      exact ⟨⟨_, hmem n⟩, rfl⟩
    obtain ⟨P₀, hP₀⟩ := (Polynomial.lifts_iff_set_range _).mp hlift
    refine ⟨P.coeff j, P₀, hβ, ⟨j, ?_⟩, ?_⟩
    · have h1 : W.subtype (P₀.coeff j) = W.subtype 1 := by
        rw [← Polynomial.coeff_map, hP₀, Polynomial.coeff_C_mul, inv_mul_cancel₀ hβ, map_one]
      rw [W.subtype_injective h1]
      exact isUnit_one
    · rw [hP₀, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hβ, Polynomial.C_1, one_mul]

  set N := f.num with hN
  set D := f.denom with hD
  have hD0 : D ≠ 0 := RatFunc.denom_ne_zero f
  have hN0 : N ≠ 0 := RatFunc.num_ne_zero hf
  have hinj := RatFunc.algebraMap_injective Ω
  have hδD : algebraMap (Polynomial Ω) (RatFunc Ω) D ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr hD0
  have hδN : algebraMap (Polynomial Ω) (RatFunc Ω) N ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr hN0
  have hfd : algebraMap (Polynomial Ω) (RatFunc Ω) N = f * algebraMap (Polynomial Ω) (RatFunc Ω) D :=
    (div_eq_iff hδD).mp (RatFunc.num_div_denom f)
  have hstar : ι f * D.eval₂ ιΩ τ = N.eval₂ ιΩ τ := by
    rw [← hev, ← hev, ← map_mul, hfd]
  have hDτ : D.eval₂ ιΩ τ ≠ 0 := by rw [← hev]; exact (map_ne_zero ι).mpr hδD
  have hNτ : N.eval₂ ιΩ τ ≠ 0 := by rw [← hev]; exact (map_ne_zero ι).mpr hδN
  obtain ⟨D', hD'⟩ := homog D (max N.natDegree D.natDegree) (le_max_right _ _)
  obtain ⟨N', hN'⟩ := homog N (max N.natDegree D.natDegree) (le_max_left _ _)
  have hstar2 : ι f * D'.eval₂ ιΩ s = N'.eval₂ ιΩ s := by
    rw [← hD', ← hN', ← hstar]
    ring
  have hD'0 : D' ≠ 0 := by
    rintro rfl
    rw [Polynomial.eval₂_zero] at hD'
    exact mul_ne_zero (pow_ne_zero _ hs0) hDτ hD'
  have hN'0 : N' ≠ 0 := by
    rintro rfl
    rw [Polynomial.eval₂_zero] at hN'
    exact mul_ne_zero (pow_ne_zero _ hs0) hNτ hN'
  obtain ⟨βd, D₀, hβd, hD₀u, hD₀⟩ := content D' hD'0
  obtain ⟨βn, N₀, hβn, hN₀u, hN₀⟩ := content N' hN'0
  have hevD : D'.eval₂ ιΩ s = ιΩ βd * D₀.eval₂ ψ s := by
    rw [hD₀, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map, hcompW]
  have hevN : N'.eval₂ ιΩ s = ιΩ βn * N₀.eval₂ ψ s := by
    rw [hN₀, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map, hcompW]
  rw [hevD, hevN] at hstar2
  have hβd' : ιΩ βd ≠ 0 := (map_ne_zero ιΩ).mpr hβd
  refine ⟨βn / βd, D₀, N₀, div_ne_zero hβn hβd, hD₀u, hN₀u, ?_⟩
  have hγ : ι (algebraMap Ω (RatFunc Ω) (βn / βd)) = ιΩ βn / ιΩ βd := by
    rw [← map_div₀]; rfl
  rw [hγ, div_mul_eq_mul_div, eq_div_iff hβd']
  linear_combination hstar2

theorem wcpa_dj_llsm_smpcgbtiic_ratfunc_values : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] (𝔭 : Ideal A) (t : A) (c b : ↥W) (V : ValuationSubring M), wcSmpcgbtiGauss W A K M 𝔭 t c b V → ∀ ι : RatFunc Ω →+* K, (∀ a : ↥W, ι (algebraMap Ω (RatFunc Ω) (a : Ω)) = algebraMap A K (algebraMap ↥W A a)) → (∀ f : RatFunc Ω, f ≠ 0 → ∃ (γ : Ω) (e g : Polynomial ↥W), γ ≠ 0 ∧ (∃ i, IsUnit (e.coeff i)) ∧ (∃ i, IsUnit (g.coeff i)) ∧ ι f * e.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)) = ι (algebraMap Ω (RatFunc Ω) γ) * g.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c))) → (∀ f : RatFunc Ω, f ≠ 0 → ∃ w : ↥W, w ≠ 0 ∧ (V.valuation (algebraMap K M (ι f)) = V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w) ∨ (V.valuation (algebraMap K M (ι f)))⁻¹ = V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w))) ∧ (∀ f : RatFunc Ω, algebraMap K M (ι f) ∈ V → ∃ g e : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}), V.valuation (algebraMap K M (e : K)) = 1 ∧ algebraMap K M (ι f) * algebraMap K M (e : K) = algebraMap K M (g : K)) :=
by
  intro Ω _ W A _ _ _ K _ _ _ M _ _ 𝔭 t c b V hG ι hιW hNF
  classical
  obtain ⟨_, _, hG3, _, hG5⟩ := hG
  set s : K := algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)
    with hs

  have hval : ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) →
      V.valuation (algebraMap K M (q.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) s)) = 1 := by
    intro q hq
    obtain ⟨i, hi⟩ := hq
    rw [Polynomial.hom_eval₂]
    apply hG5
    refine ⟨i, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
    exact hi

  have hmem : ∀ q : Polynomial ↥W,
      q.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) s ∈ Algebra.adjoin A {s} := by
    intro q
    rw [← Polynomial.eval₂_map, ← Polynomial.aeval_def]
    exact Polynomial.aeval_mem_adjoin_singleton A s

  have hlt : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
      V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w) < 1 := by
    intro w hw
    by_contra h
    rw [not_lt] at h
    have h1 := (hG3 1 w).mp (by rw [map_one, Valuation.map_one]; exact h)
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hw))
      (isUnit_iff_dvd_one.mpr h1)

  have hkey : ∀ (f : RatFunc Ω) (γ : Ω) (e g : Polynomial ↥W), (∃ i, IsUnit (e.coeff i)) →
      (∃ i, IsUnit (g.coeff i)) →
      ι f * e.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) s =
        ι (algebraMap Ω (RatFunc Ω) γ) * g.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) s →
      V.valuation (algebraMap K M (ι f)) =
        V.valuation (algebraMap K M (ι (algebraMap Ω (RatFunc Ω) γ))) := by
    intro f γ e g he hg heq
    have h := congrArg (fun x => V.valuation (algebraMap K M x)) heq
    simp only [map_mul, hval e he, hval g hg, mul_one] at h
    exact h

  have hprod : ∀ γ : Ω, γ ≠ 0 → ∀ hγ' : γ⁻¹ ∈ W,
      V.valuation (algebraMap K M (ι (algebraMap Ω (RatFunc Ω) γ))) *
        V.valuation (((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ⟨γ⁻¹, hγ'⟩) = 1 := by
    intro γ hγ hγ'
    have h1 : ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) ⟨γ⁻¹, hγ'⟩
        = algebraMap K M (ι (algebraMap Ω (RatFunc Ω) γ⁻¹)) := by
      rw [RingHom.comp_apply, RingHom.comp_apply, ← hιW ⟨γ⁻¹, hγ'⟩]
    rw [h1, ← Valuation.map_mul, ← map_mul, ← map_mul, ← map_mul, mul_inv_cancel₀ hγ, map_one,
      map_one, map_one, Valuation.map_one]
  refine ⟨?_, ?_⟩
  ·
    intro f hf
    obtain ⟨γ, e, g, hγ0, he, hg, heq⟩ := hNF f hf
    have hk := hkey f γ e g he hg heq
    by_cases hγ : γ ∈ W
    · refine ⟨⟨γ, hγ⟩, ?_, Or.inl ?_⟩
      · intro h
        apply hγ0
        simpa using congrArg Subtype.val h
      · rw [hk, RingHom.comp_apply, RingHom.comp_apply, ← hιW ⟨γ, hγ⟩]
    · have hγ' : γ⁻¹ ∈ W := (W.mem_or_inv_mem γ).resolve_left hγ
      refine ⟨⟨γ⁻¹, hγ'⟩, ?_, Or.inr ?_⟩
      · intro h
        apply hγ0
        simpa using congrArg Subtype.val h
      · rw [hk]
        exact inv_eq_of_mul_eq_one_right (hprod γ hγ0 hγ')
  ·
    intro f hfV
    by_cases hf : f = 0
    · subst hf
      refine ⟨0, 1, ?_, ?_⟩
      · simp
      · simp
    obtain ⟨γ, e, g, hγ0, he, hg, heq⟩ := hNF f hf
    by_cases hγ : γ ∈ W
    · refine ⟨⟨(Polynomial.C (⟨γ, hγ⟩ : ↥W) * g).eval₂
          ((algebraMap A K).comp (algebraMap ↥W A)) s, hmem _⟩,
        ⟨e.eval₂ ((algebraMap A K).comp (algebraMap ↥W A)) s, hmem _⟩, hval e he, ?_⟩
      show algebraMap K M (ι f) * algebraMap K M (e.eval₂ ((algebraMap A K).comp
          (algebraMap ↥W A)) s) = algebraMap K M ((Polynomial.C (⟨γ, hγ⟩ : ↥W) * g).eval₂
          ((algebraMap A K).comp (algebraMap ↥W A)) s)
      rw [← map_mul, heq, Polynomial.eval₂_mul, Polynomial.eval₂_C, RingHom.comp_apply,
        ← hιW ⟨γ, hγ⟩]
    · exfalso
      have hγ' : γ⁻¹ ∈ W := (W.mem_or_inv_mem γ).resolve_left hγ
      have hk := hkey f γ e g he hg heq
      have hm : (⟨γ⁻¹, hγ'⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        obtain ⟨u, hu⟩ := isUnit_iff_exists_inv.mp hu
        apply hγ
        have h2 : γ⁻¹ * (u : Ω) = 1 := congrArg Subtype.val hu
        have h3 : (u : Ω) = γ := by
          calc (u : Ω) = γ * (γ⁻¹ * (u : Ω)) := by
                rw [← mul_assoc, mul_inv_cancel₀ hγ0, one_mul]
            _ = γ := by rw [h2, mul_one]
        rw [← h3]
        exact u.2
      have h1 := hlt _ hm
      have h2 := hprod γ hγ0 hγ'
      rw [← hk] at h2
      have h4 : V.valuation (algebraMap K M (ι f)) ≤ 1 := (V.valuation_le_one_iff _).mpr hfV
      have h5 := lt_of_le_of_lt (mul_le_of_le_one_left' h4) h1
      rw [h2] at h5
      exact lt_irrefl _ h5

theorem wcpa_dj_llsm_smpcgbtiic_value_power : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (F M : Type u) [Field F] [Field M] [Algebra F M] [Algebra.IsAlgebraic F M] (wM : ↥W →+* M) (V : ValuationSubring M), (∀ w : ↥W, V.valuation (wM w) ≤ 1) → (∀ w : ↥W, V.valuation (wM w) < 1 ↔ w ∈ IsLocalRing.maximalIdeal ↥W) → (∀ f : F, f ≠ 0 → ∃ w : ↥W, w ≠ 0 ∧ (V.valuation (algebraMap F M f) = V.valuation (wM w) ∨ (V.valuation (algebraMap F M f))⁻¹ = V.valuation (wM w))) → ∀ x : M, x ≠ 0 → V.valuation x < 1 → ∃ n : ℕ, 0 < n ∧ ∃ w ∈ IsLocalRing.maximalIdeal ↥W, w ≠ 0 ∧ V.valuation (x ^ n) = V.valuation (wM w) :=
by
  intro Ω _ W F M _ _ _ _ wM V h1 h2 h3 x hx0 hx1
  classical
  have hinj : Function.Injective (algebraMap F M) := (algebraMap F M).injective

  obtain ⟨p, hp0, hpx⟩ := Algebra.IsAlgebraic.isAlgebraic (R := F) x
  obtain ⟨t, ht⟩ : ∃ t : ℕ → M, ∀ k, t k = algebraMap F M (p.coeff k) * x ^ k :=
    ⟨_, fun _ => rfl⟩
  have hsum : ∑ k ∈ Finset.range (p.natDegree + 1), t k = 0 := by
    rw [← hpx, Polynomial.aeval_eq_sum_range]
    exact Finset.sum_congr rfl (fun k _ => by rw [ht, Algebra.smul_def])
  obtain ⟨i₀, hi₀R, hi₀max⟩ := Finset.exists_max_image (Finset.range (p.natDegree + 1))
    (fun k => V.valuation (t k)) ⟨0, by simp⟩
  have htN : V.valuation (t p.natDegree) ≠ 0 := by
    rw [Valuation.ne_zero_iff, ht]
    refine mul_ne_zero ?_ (pow_ne_zero _ hx0)
    rw [Polynomial.coeff_natDegree]
    exact (map_ne_zero_iff _ hinj).mpr (Polynomial.leadingCoeff_ne_zero.mpr hp0)
  have hg0 : V.valuation (t i₀) ≠ 0 := by
    intro h
    have h' := hi₀max p.natDegree (by simp)
    rw [h] at h'
    exact htN (le_antisymm h' zero_le')
  have htie : ∃ j₀ ∈ Finset.range (p.natDegree + 1), j₀ ≠ i₀ ∧
      V.valuation (t j₀) = V.valuation (t i₀) := by
    by_contra hcon
    push_neg at hcon
    have hlt : ∀ k ∈ (Finset.range (p.natDegree + 1)).erase i₀,
        V.valuation (t k) < V.valuation (t i₀) := by
      intro k hk
      obtain ⟨hki, hkR⟩ := Finset.mem_erase.mp hk
      exact lt_of_le_of_ne (hi₀max k hkR) (hcon k hkR hki)
    have hs := V.valuation.map_sum_lt hg0 hlt
    have h0 := Finset.add_sum_erase _ t hi₀R
    rw [hsum] at h0
    have hadd : V.valuation (t i₀ + ∑ k ∈ (Finset.range (p.natDegree + 1)).erase i₀, t k)
        = V.valuation (t i₀) := Valuation.map_add_eq_of_lt_left _ hs
    rw [h0, Valuation.map_zero] at hadd
    exact hg0 hadd.symm
  obtain ⟨j₀, -, hj₀ne, hj₀eq⟩ := htie
  have key2 : ∃ i j : ℕ, i < j ∧ V.valuation (t i) = V.valuation (t j) ∧
      V.valuation (t i) ≠ 0 := by
    rcases lt_or_gt_of_ne hj₀ne with h | h
    · exact ⟨j₀, i₀, h, hj₀eq, hj₀eq ▸ hg0⟩
    · exact ⟨i₀, j₀, h, hj₀eq.symm, hg0⟩
  obtain ⟨i, j, hij, hteq, hti0⟩ := key2
  have hval : ∀ k, V.valuation (t k) =
      V.valuation (algebraMap F M (p.coeff k)) * V.valuation x ^ k := fun k => by
    rw [ht, Valuation.map_mul, Valuation.map_pow]
  have hX0 : V.valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  have hα0 : V.valuation (algebraMap F M (p.coeff i)) ≠ 0 := by
    intro h; apply hti0; rw [hval, h, zero_mul]
  have hβ0 : V.valuation (algebraMap F M (p.coeff j)) ≠ 0 := by
    intro h; apply hti0; rw [hteq, hval, h, zero_mul]
  have hci : p.coeff i ≠ 0 := by
    intro h; apply hα0; rw [h, map_zero, Valuation.map_zero]
  have hcj : p.coeff j ≠ 0 := by
    intro h; apply hβ0; rw [h, map_zero, Valuation.map_zero]
  obtain ⟨Y, hYdef⟩ : ∃ Y, Y = V.valuation x ^ (j - i) := ⟨_, rfl⟩
  have hY0 : Y ≠ 0 := by rw [hYdef]; exact pow_ne_zero _ hX0
  have hY1 : Y < 1 := by
    rw [hYdef]; exact pow_lt_one₀ zero_le' hx1 (by omega)
  have hab : V.valuation (algebraMap F M (p.coeff i)) =
      V.valuation (algebraMap F M (p.coeff j)) * Y := by
    have e := hteq
    rw [hval, hval] at e
    have hpow : V.valuation x ^ j = V.valuation x ^ i * Y := by
      rw [hYdef, ← pow_add]; congr 1; omega
    rw [hpow] at e
    apply mul_right_cancel₀ (pow_ne_zero i hX0)
    rw [e, mul_assoc, mul_comm Y]

  have hΓmul : ∀ a b : ↥W, V.valuation (wM (a * b)) = V.valuation (wM a) * V.valuation (wM b) :=
    fun a b => by rw [map_mul wM, Valuation.map_mul]
  have hΓone : V.valuation (wM 1) = 1 := by rw [map_one, Valuation.map_one]
  have key : ∀ w₁ w₂ : ↥W, V.valuation (wM w₂) ≠ 0 →
      V.valuation (wM w₁) = V.valuation (wM w₂) * Y → ∃ c : ↥W, V.valuation (wM c) = Y := by
    intro w₁ w₂ hq hpq
    obtain ⟨c, hc | hc⟩ := ValuationRing.cond w₁ w₂
    · exfalso
      have e : V.valuation (wM w₂) = V.valuation (wM w₂) * Y * V.valuation (wM c) := by
        rw [← hpq, ← hΓmul, hc]
      have e2 : Y * V.valuation (wM c) = 1 := by
        apply mul_left_cancel₀ hq
        rw [mul_one, ← mul_assoc]; exact e.symm
      have e3 : Y * V.valuation (wM c) ≤ Y := mul_le_of_le_one_right' (h1 c)
      rw [e2] at e3
      exact absurd hY1 (not_lt.mpr e3)
    · refine ⟨c, ?_⟩
      apply mul_left_cancel₀ hq
      rw [← hΓmul, hc, hpq]
  obtain ⟨wa, -, ha⟩ := h3 (p.coeff i) hci
  obtain ⟨wb, -, hb⟩ := h3 (p.coeff j) hcj
  have hex : ∃ c : ↥W, V.valuation (wM c) = Y := by
    rcases ha with ha | ha <;> rcases hb with hb | hb
    · exact key wa wb (hb ▸ hβ0) (by rw [← ha, ← hb]; exact hab)
    · refine key (wa * wb) 1 (by rw [hΓone]; exact one_ne_zero) ?_
      rw [hΓmul, hΓone, one_mul, ← ha, ← hb, hab, mul_comm _ Y, mul_assoc,
        mul_inv_cancel₀ hβ0, mul_one]
    · refine key 1 (wa * wb) ?_ ?_
      · rw [hΓmul, ← ha, ← hb]; exact mul_ne_zero (inv_ne_zero hα0) hβ0
      · rw [hΓmul, hΓone, ← ha, ← hb, hab, mul_assoc, inv_mul_cancel₀ (mul_ne_zero hβ0 hY0)]
    · refine key wb wa (by rw [← ha]; exact inv_ne_zero hα0) ?_
      rw [← ha, ← hb, hab, mul_inv, mul_assoc, inv_mul_cancel₀ hY0, mul_one]
  obtain ⟨c, hc⟩ := hex
  refine ⟨j - i, by omega, c, (h2 c).mp (by rw [hc]; exact hY1), ?_, ?_⟩
  · intro hc0
    rw [hc0, map_zero, Valuation.map_zero] at hc
    exact hY0 hc.symm
  · rw [Valuation.map_pow, hc, hYdef]

theorem wcpa_dj_llsm_smpcgbtiic_integral_localization : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M] [IsScalarTower A K M] [FiniteDimensional K M] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ (c b : ↥W) (ι : RatFunc Ω →+* K), (∀ a : ↥W, ι (algebraMap Ω (RatFunc Ω) (a : Ω)) = algebraMap A K (algebraMap ↥W A a)) → ι RatFunc.X = algebraMap A K t → ∀ V : ValuationSubring M, (∀ f : RatFunc Ω, algebraMap K M (ι f) ∈ V → ∃ g e : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}), V.valuation (algebraMap K M (e : K)) = 1 ∧ algebraMap K M (ι f) * algebraMap K M (e : K) = algebraMap K M (g : K)) → ∀ y : M, y ∈ V → ∃ x d : ↥(integralClosure ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M), V.valuation (d : M) = 1 ∧ y * (d : M) = (x : M) :=
by
  intro Ω _ W A _ _ _ K _ _ _ M _ _ _ _ _ 𝔭 t hPD c b ι hιW hιX V hfrac y hy
  classical
  letI iFK : Algebra (RatFunc Ω) K := ι.toAlgebra
  letI iFM : Algebra (RatFunc Ω) M := ((algebraMap K M).comp ι).toAlgebra
  haveI : IsScalarTower (RatFunc Ω) K M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : FiniteDimensional (RatFunc Ω) K :=
    (wcLlsASbfd_ratfunc_finsep Ω W A K 𝔭 t hPD ι hιW hιX).1
  haveI : FiniteDimensional (RatFunc Ω) M := Module.Finite.trans K M
  haveI : Algebra.IsAlgebraic (RatFunc Ω) M := Algebra.IsAlgebraic.of_finite _ _
  letI iR : Algebra ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M :=
    ((algebraMap (RatFunc Ω) M).comp (V.comap (algebraMap (RatFunc Ω) M)).toSubring.subtype).toAlgebra

  have hB := @wcLlsASbfd_bourbaki_integral ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M _ _ iR
  obtain ⟨σ, z, hσV, hσ0, hσiV, hσi, hzi, hσz⟩ :=
    wcLlsASbfd_unit_fraction (RatFunc Ω) M (V.comap (algebraMap (RatFunc Ω) M))
      (V.comap (algebraMap (RatFunc Ω) M)).toSubring rfl V
      (fun f hf => ValuationSubring.mem_comap.mp hf)
      (fun f hf hf0 hinv => ValuationSubring.mem_comap.mpr (by rw [map_inv₀]; exact hinv))
      hB y hy
  have hσ1 : V.valuation σ = 1 := by
    have hu : IsUnit (⟨σ, hσV⟩ : V) :=
      ⟨⟨⟨σ, hσV⟩, ⟨σ⁻¹, hσiV⟩, Subtype.ext (mul_inv_cancel₀ hσ0),
        Subtype.ext (inv_mul_cancel₀ hσ0)⟩, rfl⟩
    exact (ValuationSubring.valuation_eq_one_iff V _).mp hu

  have hclear : ∀ (T : Type u) [CommRing T] [Algebra T M],
      (∀ r : RatFunc Ω, r ∈ (V.comap (algebraMap (RatFunc Ω) M)).toSubring →
        ∃ g e : T, V.valuation (algebraMap T M e) = 1 ∧
          algebraMap (RatFunc Ω) M r * algebraMap T M e = algebraMap T M g) →
      ∀ u : M, IsIntegral ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring u →
        ∃ E : T, V.valuation (algebraMap T M E) = 1 ∧ IsIntegral T (algebraMap T M E * u) := by
    intro T _ _ H u hu
    obtain ⟨p, hpm, hpu⟩ := hu
    choose g e he hge using fun i : ℕ => H ((p.coeff i : ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring) : RatFunc Ω) (p.coeff i).2
    have hαr : ∀ r : ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring,
        algebraMap ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M r =
          algebraMap (RatFunc Ω) M (r : RatFunc Ω) := fun r => rfl
    refine ⟨∏ i ∈ Finset.range p.natDegree, e i, ?_, ?_⟩
    · rw [map_prod, map_prod]
      exact Finset.prod_eq_one (fun i _ => he i)
    have hPm : (p.map (algebraMap ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M)).Monic :=
      hpm.map _
    have hPn : (p.map (algebraMap ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M)).natDegree =
        p.natDegree := hpm.natDegree_map _
    have hQm : ((p.map (algebraMap ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M)).scaleRoots
        (algebraMap T M (∏ i ∈ Finset.range p.natDegree, e i))).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr hPm
    have hQl : (p.map (algebraMap ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M)).scaleRoots
        (algebraMap T M (∏ i ∈ Finset.range p.natDegree, e i)) ∈
          Polynomial.lifts (algebraMap T M) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, hPn, Polynomial.coeff_map]
      rcases lt_trichotomy i p.natDegree with h | h | h
      · refine ⟨g i * (∏ j ∈ (Finset.range p.natDegree).erase i, e j) *
          (∏ j ∈ Finset.range p.natDegree, e j) ^ (p.natDegree - 1 - i), ?_⟩
        have h1 : p.natDegree - i = (p.natDegree - 1 - i) + 1 := by omega
        have h2 := Finset.mul_prod_erase (Finset.range p.natDegree) e (Finset.mem_range.mpr h)
        rw [h1, pow_succ, map_mul, map_mul, map_pow, ← hge i, ← h2, map_mul, hαr]
        ring
      · rw [h, Nat.sub_self, pow_zero, mul_one, hpm.coeff_natDegree, map_one]
        exact ⟨1, map_one _⟩
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, map_zero, zero_mul]
        exact ⟨0, map_zero _⟩
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hQl hQm
    refine ⟨q, hqm, ?_⟩
    rw [Polynomial.eval₂_eq_eval_map, hqmap]
    have hPu : (p.map (algebraMap ↥(V.comap (algebraMap (RatFunc Ω) M)).toSubring M)).eval₂
        (RingHom.id M) u = 0 := by
      rw [Polynomial.eval₂_map, RingHom.id_comp]; exact hpu
    exact Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id M)
      (s := algebraMap T M (∏ i ∈ Finset.range p.natDegree, e i)) hPu

  have hH : ∀ r : RatFunc Ω, r ∈ (V.comap (algebraMap (RatFunc Ω) M)).toSubring →
      ∃ g e : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)}),
        V.valuation (algebraMap _ M e) = 1 ∧
          algebraMap (RatFunc Ω) M r * algebraMap _ M e = algebraMap _ M g := by
    intro r hr
    obtain ⟨g, e, he, hge⟩ := hfrac r (ValuationSubring.mem_comap.mp hr)
    exact ⟨g, e, he, hge⟩

  obtain ⟨E₁, hE₁, hE₁i⟩ := hclear _ hH σ hσi
  obtain ⟨E₂, hE₂, hE₂i⟩ := hclear _ hH z hzi
  refine ⟨⟨algebraMap _ M E₁ * (algebraMap _ M E₂ * z), isIntegral_algebraMap.mul hE₂i⟩,
    ⟨algebraMap _ M E₂ * (algebraMap _ M E₁ * σ), isIntegral_algebraMap.mul hE₁i⟩, ?_, ?_⟩
  · show V.valuation (algebraMap _ M E₂ * (algebraMap _ M E₁ * σ)) = 1
    rw [map_mul, map_mul, hE₁, hE₂, hσ1, one_mul, one_mul]
  · show y * (algebraMap _ M E₂ * (algebraMap _ M E₁ * σ)) =
      algebraMap _ M E₁ * (algebraMap _ M E₂ * z)
    rw [← hσz]; ring

theorem wcpa_dj_llsm_smpcgbtiic_contraction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → ∀ V : ValuationSubring M, wcSmpcgbtiGauss W A K M 𝔭 t c b V → ∀ x : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}), V.valuation (algebraMap K M (x : K)) < 1 → x ∈ Ideal.span {algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) (t - algebraMap ↥W A c), ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c), Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})).comp (algebraMap ↥W A)) :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ M _ _ 𝔭 t hPD c b hc V hG x hx
  classical
  obtain ⟨hFT, -, -, hmax, hle, -, heq, -⟩ := hPD
  obtain ⟨hG1, hG2, hG3, hG4, hG5⟩ := hG

  have hres : ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 := by
    intro a
    have T1 : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
      apply IsAlgClosed.of_exists_root
      intro p hpmon hpirr
      have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact IsLocalRing.residue_surjective _
      obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon
      have hpdeg : 0 < p.natDegree := hpirr.natDegree_pos
      set j : ↥W →+* Ω := algebraMap ↥W Ω with hj
      have hQmon : (q.map j).Monic := hqmon.map j
      have hQdeg : (q.map j).natDegree = q.natDegree := hqmon.natDegree_map j
      have hQd : (q.map j).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hQmon.ne_zero, hQdeg, hqdeg]
        exact_mod_cast hpdeg.ne'
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (q.map j) hQd
      have hzint : _root_.IsIntegral ↥W z := by
        refine ⟨q, hqmon, ?_⟩
        rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
        exact hz
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
      have hqy : q.eval y = 0 := by
        apply (IsFractionRing.injective ↥W Ω)
        rw [map_zero, ← Polynomial.eval_map_apply]
        rw [hy]
        exact hz
      refine ⟨IsLocalRing.residue ↥W y, ?_⟩
      rw [← hqmap, Polynomial.eval_map_apply, hqy, map_zero]
    have T2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
        [IsAlgClosed (IsLocalRing.ResidueField R)] (k : Type u) [Field k] (ρ : R →+* k),
        IsLocalHom ρ → ρ.FiniteType → Function.Surjective ρ := by
      intro R _ _ _ k _ ρ hloc hρFT
      set ψ := IsLocalRing.ResidueField.lift ρ with hψ
      have hψr : ψ.comp (IsLocalRing.residue R) = ρ :=
        IsLocalRing.ResidueField.lift_comp_residue ρ
      have hψFT : ψ.FiniteType := by
        rw [← hψr] at hρFT
        exact RingHom.FiniteType.of_comp_finiteType hρFT
      have hψfin : ψ.Finite := (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hψFT
      have hψsurj : Function.Surjective ψ :=
        (IsAlgClosed.ringHom_bijective_of_isIntegral ψ hψfin.to_isIntegral).2
      rw [← hψr]
      exact hψsurj.comp (IsLocalRing.residue_surjective)
    have := hmax
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    let ρ : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
    have hloc : IsLocalHom ρ := by
      refine ⟨fun x hx => ?_⟩
      by_contra hxu
      have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal x).mpr hxu
      have h1 : algebraMap ↥W A x ∈ 𝔭 := hle (Ideal.mem_map_of_mem _ hxm)
      have h2 : ρ x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
      rw [h2] at hx
      exact not_isUnit_zero hx
    have hρFT : ρ.FiniteType :=
      RingHom.FiniteType.comp_surjective (RingHom.finiteType_algebraMap.mpr hFT)
        Ideal.Quotient.mk_surjective
    obtain ⟨w, hw⟩ := T2 ↥W (A ⧸ 𝔭) ρ hloc hρFT (Ideal.Quotient.mk 𝔭 a)
    refine ⟨w, ?_⟩
    exact Ideal.Quotient.eq.mp hw.symm

  have hm1 : (1 : ↥W) ∉ IsLocalRing.maximalIdeal ↥W := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hvs : V.valuation (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
      algebraMap A K (t - algebraMap ↥W A c))) = 1 := by
    have h := hG5 Polynomial.X ⟨1, by rw [Polynomial.coeff_X_one]; exact hm1⟩
    rwa [Polynomial.eval₂_X] at h

  have hconst : ∀ q : Polynomial A, V.valuation (algebraMap K M (Polynomial.aeval
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)) q)) < 1 →
      q.coeff 0 ∈ 𝔭 := by
    intro q hq
    choose w hw using fun i => hres (q.coeff i)
    have hexp : algebraMap K M (Polynomial.aeval
        (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)) q) =
        (∑ i ∈ Finset.range (q.natDegree + 1),
          ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) (w i) *
            (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
              algebraMap A K (t - algebraMap ↥W A c))) ^ i) +
        ∑ i ∈ Finset.range (q.natDegree + 1),
          algebraMap K M (algebraMap A K (q.coeff i - algebraMap ↥W A (w i))) *
            (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
              algebraMap A K (t - algebraMap ↥W A c))) ^ i := by
      rw [Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.eval₂_eq_sum_range,
        ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [RingHom.comp_apply, map_sub]
      ring
    have hE : Polynomial.eval₂ ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A)))
        (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
          algebraMap A K (t - algebraMap ↥W A c)))
        (∑ i ∈ Finset.range (q.natDegree + 1), Polynomial.C (w i) * Polynomial.X ^ i) =
        ∑ i ∈ Finset.range (q.natDegree + 1),
          ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) (w i) *
            (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
              algebraMap A K (t - algebraMap ↥W A c))) ^ i := by
      rw [Polynomial.eval₂_finset_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
    have hcoeff0 : (∑ i ∈ Finset.range (q.natDegree + 1),
        Polynomial.C (w i) * Polynomial.X ^ i).coeff 0 = w 0 := by
      rw [Polynomial.finset_sum_coeff]
      simp [Polynomial.coeff_C_mul_X_pow]
    have hT : V.valuation (∑ i ∈ Finset.range (q.natDegree + 1),
          algebraMap K M (algebraMap A K (q.coeff i - algebraMap ↥W A (w i))) *
            (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
              algebraMap A K (t - algebraMap ↥W A c))) ^ i) < 1 := by
      apply Valuation.map_sum_lt _ one_ne_zero
      intro i _
      rw [Valuation.map_mul, Valuation.map_pow, hvs, one_pow, mul_one]
      exact (hG2 _).mpr (hw i)
    have hw0 : w 0 ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra h0
      have h1 := hG5 (∑ i ∈ Finset.range (q.natDegree + 1), Polynomial.C (w i) * Polynomial.X ^ i)
        ⟨0, by rw [hcoeff0]; exact h0⟩
      rw [hE] at h1
      have h2 := Valuation.map_add_eq_of_lt_left V.valuation (hT.trans_eq h1.symm)
      rw [← hexp, h1] at h2
      rw [h2] at hq
      exact lt_irrefl _ hq
    have h3 := Ideal.add_mem 𝔭 (hw 0) (hle (Ideal.mem_map_of_mem (algebraMap ↥W A) hw0))
    rwa [sub_add_cancel] at h3

  have hideal : 𝔭 ≤ (Ideal.span {algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) (t - algebraMap ↥W A c), ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c), Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})).comp (algebraMap ↥W A))).comap (algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})) := by
    rw [heq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      have e : algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) t = algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) (t - algebraMap ↥W A c) + ((algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})).comp (algebraMap ↥W A)) c := by
        rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
    · rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap]
      intro w hw
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  obtain ⟨q, hq⟩ : ∃ q : Polynomial A, Polynomial.aeval
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)) q = (x : K) := by
    have hx' : (x : K) ∈ (Polynomial.aeval (R := A)
        (algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c))).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact x.2
    exact (AlgHom.mem_range _).mp hx'
  have hxq : x = Polynomial.aeval (⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c), Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})) q := by
    apply Subtype.ext
    rw [Polynomial.aeval_subalgebra_coe]
    exact hq.symm
  have hdecomp : Polynomial.aeval (⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c), Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})) q = (⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c), Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})) * Polynomial.aeval (⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c), Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})) q.divX + algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) (q.coeff 0) := by
    conv_lhs => rw [← Polynomial.X_mul_divX_add q]
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
  have hq0 : q.coeff 0 ∈ 𝔭 := hconst q (by rw [hq]; exact hx)
  rw [hxq, hdecomp]
  refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (hideal hq0)
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

theorem wcpa_dj_llsm_smpcgbti_inner_center : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ V : ValuationSubring M, wcSmpcgbtiGauss W A K M 𝔭 t c b V →
    ∃ P ∈ (Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (x : M) =
            ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes,
      algebraMap ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)
          ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
            Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∉ P ∧
      P.comap (algebraMap ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)) ≤
        Ideal.span {algebraMap A ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
            (t - algebraMap ↥W A c),
          ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
            Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})).comp
            (algebraMap ↥W A)) ∧
      (∀ x : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M),
        (x : M) ∈ V) ∧
      (∀ x : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M),
        x ∈ P ↔ V.valuation (x : M) < 1) ∧
      ∀ y : M, y ∈ V → ∃ x d : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M),
        d ∉ P ∧ y * (d : M) = (x : M) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ 𝔭 t hPD c b hc hbm hb0 V hG
  classical
  have hGauss := hG
  obtain ⟨hG1, hG2, hG3, hG4, hG5⟩ := hG

  have hm1 : (1 : ↥W) ∉ IsLocalRing.maximalIdeal ↥W := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hvs : V.valuation (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
      algebraMap A K (t - algebraMap ↥W A c))) = 1 := by
    have h := hG5 Polynomial.X ⟨1, by rw [Polynomial.coeff_X_one]; exact hm1⟩
    rwa [Polynomial.eval₂_X] at h
  have hs0 : algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h
    rw [h, map_zero, Valuation.map_zero] at hvs
    exact zero_ne_one hvs
  have hb' : algebraMap A K (algebraMap ↥W A b) ≠ 0 := by
    intro h; apply hs0; rw [h, zero_div]
  have hz' : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h; apply hs0; rw [h, div_zero]

  have hF2 : ∀ w : ↥W, V.valuation (((algebraMap K M).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) w) ≤ 1 := by
    intro w
    have h := (hG3 w 1).mpr (one_dvd w)
    rwa [map_one, Valuation.map_one] at h
  have hF2' : ∀ w : ↥W, V.valuation (((algebraMap K M).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) w) < 1 ↔ w ∈ IsLocalRing.maximalIdeal ↥W := by
    intro w
    have h := hG3 1 w
    rw [map_one, Valuation.map_one] at h
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_dvd_one, ← h, not_le]

  have hSle : ∀ k : K, k ∈ Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
      algebraMap A K (t - algebraMap ↥W A c)} → V.valuation (algebraMap K M k) ≤ 1 := by
    intro k hk
    induction hk using Algebra.adjoin_induction with
    | mem x hx => rw [Set.mem_singleton_iff.mp hx, hvs]
    | algebraMap r => exact (V.valuation_le_one_iff _).mpr (hG1 r)
    | add x y _ _ hx hy => rw [map_add]; exact Valuation.map_add_le _ hx hy
    | mul x y _ _ hx hy => rw [map_mul, map_mul]; exact mul_le_one' hx hy

  have hCV : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A
      {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M),
      (x : M) ∈ V := by
    intro x
    let φ : ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) →+* ↥V :=
      (algebraMap ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M).codRestrict
        V (fun a => (V.valuation_le_one_iff _).mp (hSle a a.2))
    have hcomp : (algebraMap ↥V M).comp φ = (RingHom.id M).comp (algebraMap ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M) := by
      ext a; rfl
    have hxi : IsIntegral ↥V (x : M) := IsIntegral.map_of_comp_eq φ (RingHom.id M) hcomp x.2
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxi
    rw [← hy]; exact y.2

  let P : Ideal ↥(integralClosure ↥(Algebra.adjoin A
      {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M) :=
    { carrier := {x | V.valuation (x : M) < 1}
      add_mem' := by
        intro x y hx hy
        simp only [Set.mem_setOf_eq] at hx hy ⊢
        rw [AddMemClass.coe_add]
        exact Valuation.map_add_lt _ hx hy
      zero_mem' := by
        show V.valuation ((0 : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)) : M) < 1
        simp
      smul_mem' := by
        intro r x hx
        simp only [Set.mem_setOf_eq, smul_eq_mul] at hx ⊢
        rw [MulMemClass.coe_mul, map_mul]
        exact lt_of_le_of_lt
          (mul_le_of_le_one_left' ((V.valuation_le_one_iff _).mpr (hCV r))) hx }
  have hPmem : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A
      {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M),
      x ∈ P ↔ V.valuation (x : M) < 1 := fun x => Iff.rfl
  have hPprime : P.IsPrime := by
    refine Ideal.isPrime_iff.mpr ⟨?_, ?_⟩
    · rw [Ideal.ne_top_iff_one, hPmem]
      simp
    · intro x y hxy
      rw [hPmem] at hxy
      rw [hPmem, hPmem]
      rw [MulMemClass.coe_mul, map_mul] at hxy
      by_contra hcon
      push_neg at hcon
      have hx1 := le_antisymm ((V.valuation_le_one_iff _).mpr (hCV x)) hcon.1
      have hy1 := le_antisymm ((V.valuation_le_one_iff _).mpr (hCV y)) hcon.2
      rw [hx1, hy1, one_mul] at hxy
      exact lt_irrefl _ hxy
  have hJP : Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (x : M) =
            ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} ≤ P := by
    rw [Ideal.span_le]
    rintro x ⟨w, hw, hxw⟩
    show V.valuation (x : M) < 1
    rw [hxw]; exact (hF2' w).mpr hw

  obtain ⟨ι, hιW, hιX⟩ := wcLlsASbfd_ratfunc_embed Ω W A K 𝔭 t hPD
  have hNF := wcpa_dj_llsm_smpcgbtiic_ratfunc_normal_form Ω W A K t c b ι hιW hιX hb' hz'
  obtain ⟨hH', hfrac⟩ :=
    wcpa_dj_llsm_smpcgbtiic_ratfunc_values Ω W A K M 𝔭 t c b V hGauss ι hιW hNF
  have hloc :=
    wcpa_dj_llsm_smpcgbtiic_integral_localization Ω W A K M 𝔭 t hPD c b ι hιW hιX V hfrac
  have hcon := wcpa_dj_llsm_smpcgbtiic_contraction Ω W A K M 𝔭 t hPD c b hc V hGauss

  have hmin : P ∈ (Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (x : M) =
            ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes := by
    refine ⟨⟨hPprime, hJP⟩, ?_⟩
    rintro q ⟨hqprime, hJq⟩ hqP
    intro x hxP
    by_cases hx0 : x = 0
    · rw [hx0]; exact q.zero_mem
    have hx0' : (x : M) ≠ 0 := by
      intro h; apply hx0; exact Subtype.ext (by simpa using h)
    letI iFK : Algebra (RatFunc Ω) K := ι.toAlgebra
    letI iFM : Algebra (RatFunc Ω) M := ((algebraMap K M).comp ι).toAlgebra
    haveI : IsScalarTower (RatFunc Ω) K M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : FiniteDimensional (RatFunc Ω) K :=
      (wcLlsASbfd_ratfunc_finsep Ω W A K 𝔭 t hPD ι hιW hιX).1
    haveI : FiniteDimensional (RatFunc Ω) M := Module.Finite.trans K M
    haveI : Algebra.IsAlgebraic (RatFunc Ω) M := Algebra.IsAlgebraic.of_finite _ _
    obtain ⟨n, hn, w, hwm, hw0, hxn⟩ := wcpa_dj_llsm_smpcgbtiic_value_power Ω W (RatFunc Ω) M
      ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) V hF2 hF2' hH' (x : M)
      hx0' ((hPmem x).mp hxP)
    have hvxn0 : V.valuation ((x : M) ^ n) ≠ 0 :=
      (Valuation.ne_zero_iff _).mpr (pow_ne_zero n hx0')
    have hwM0 : ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w ≠ 0 := by
      intro h; rw [h, Valuation.map_zero] at hxn; exact hvxn0 hxn
    have hy1 : V.valuation ((x : M) ^ n /
        ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w) = 1 := by
      rw [map_div₀, hxn, div_self ((Valuation.ne_zero_iff _).mpr hwM0)]
    have hyV := (V.valuation_le_one_iff _).mp (le_of_eq hy1)
    obtain ⟨e, d, hd1, hyd⟩ := hloc _ hyV
    have hwJ : algebraMap ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
        ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)
        (algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          (algebraMap ↥W A w)) ∈ Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (x : M) =
            ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} :=
      Ideal.subset_span ⟨w, hwm, rfl⟩
    have hkey : d * x ^ n = algebraMap ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
        ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)
        (algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          (algebraMap ↥W A w)) * e := by
      apply Subtype.ext
      show (d : M) * (x : M) ^ n =
        ((algebraMap K M).comp ((algebraMap A K).comp (algebraMap ↥W A))) w * (e : M)
      rw [← hyd]
      first
        | (field_simp; done)
        | (field_simp; ring)
    have hdq : d ∉ q := fun h => by
      have h2 := (hPmem d).mp (hqP h)
      rw [hd1] at h2
      exact lt_irrefl _ h2
    have hmemq : d * x ^ n ∈ q := by
      rw [hkey]; exact hJq (Ideal.mul_mem_right _ _ hwJ)
    exact hqprime.mem_of_pow_mem n ((hqprime.mem_or_mem hmemq).resolve_left hdq)

  refine ⟨P, hmin, ?_, ?_, hCV, hPmem, ?_⟩
  · intro h
    rw [hPmem] at h
    have h' : V.valuation (algebraMap K M (algebraMap A K (algebraMap ↥W A b) /
        algebraMap A K (t - algebraMap ↥W A c))) < 1 := h
    rw [hvs] at h'
    exact lt_irrefl _ h'
  · intro x hx
    exact hcon x ((hPmem _).mp hx)
  · intro y hy
    obtain ⟨x, d, hd1, hyd⟩ := hloc y hy
    refine ⟨x, d, ?_, hyd⟩
    rw [hPmem, hd1]
    exact lt_irrefl _

theorem wcpa_dj_llsm_smpcgbtinu_fibre_dvr : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (𝔮 : Ideal B) (t' : B),
    wcLlsPD W B 𝔮 (.disc t') →
    ∃ 𝔮₀ : Ideal B, 𝔮₀.IsPrime ∧ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔮₀ ∧
      𝔮₀ ≤ 𝔮 ∧ t' ∉ 𝔮₀ ∧
      (∀ 𝔮₁ : Ideal B, 𝔮₁.IsPrime → (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔮₁ →
        𝔮₁ ≤ 𝔮 → 𝔮₁ = 𝔮₀ ∨ 𝔮₁ = 𝔮) ∧
      ∀ β : B, β ∉ 𝔮₀ → ∃ (n : ℕ) (σ u μ : B), σ ∉ 𝔮 ∧ u ∉ 𝔮 ∧ μ ∈ 𝔮₀ ∧
        σ * β = u * t' ^ n + μ :=
by
  intro Ω _ W B _ _ _ 𝔮 t' hPD
  classical
  obtain ⟨hFT, -, -, h𝔮max, hI𝔮, ht'𝔮, h𝔮eq, -⟩ := id hPD
  haveI h𝔮p : 𝔮.IsPrime := h𝔮max.isPrime
  have h1𝔮 : (1 : B) ∉ 𝔮 := fun h => h𝔮p.ne_top ((Ideal.eq_top_iff_one _).mpr h)

  have krull : ∀ β : B, (∀ n : ℕ, β ∈ Ideal.span {t' ^ n} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) →
      ∃ σ : B, σ ∉ 𝔮 ∧ σ * β ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) := by
    intro β hβ
    letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W)
    haveI : Algebra.FiniteType ↥W (B ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ↥W _)
        (Ideal.Quotient.mkₐ_surjective ↥W _)
    haveI : Algebra.FiniteType (↥W ⧸ IsLocalRing.maximalIdeal ↥W)
        (B ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) :=
      Algebra.FiniteType.of_restrictScalars_finiteType ↥W (↥W ⧸ IsLocalRing.maximalIdeal ↥W) _
    haveI : IsNoetherianRing (B ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) :=
      Algebra.FiniteType.isNoetherianRing (↥W ⧸ IsLocalRing.maximalIdeal ↥W) _
    have hmem : Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)) β ∈
        ⨅ i : ℕ, (𝔮.map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map
          (algebraMap ↥W B)))) ^ i • (⊤ : Submodule
            (B ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B))
            (B ⧸ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B))) := by
      rw [Submodule.mem_iInf]
      intro i
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (hβ i)
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [Ideal.smul_eq_mul, Ideal.mul_top, ← hyz, map_add,
        (Ideal.Quotient.eq_zero_iff_mem).mpr hz, add_zero, map_mul, map_pow]
      exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow (Ideal.mem_map_of_mem _ ht'𝔮) i)
    obtain ⟨r, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff _ _).mp hmem
    obtain ⟨ρ, hρ, hρr⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp r.2
    refine ⟨1 - ρ, fun h => h1𝔮 (by simpa using 𝔮.add_mem h hρ), ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_sub, map_one, hρr, sub_mul, one_mul]
    rw [smul_eq_mul] at hr
    rw [hr, sub_self]
  set I : Ideal B := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) with hIdef

  have nzd : ∀ (j : ℕ) (x s : B), s ∉ 𝔮 → s * t' ^ j * x ∈ I → ∃ s', s' ∉ 𝔮 ∧ s' * x ∈ I := by
    intro j
    induction j with
    | zero => intro x s hs h; exact ⟨s, hs, by simpa using h⟩
    | succ j ih =>
      intro x s hs h
      obtain ⟨s'', hs'', h''⟩ := wcpa_dj_llsm_smw_fibre_nzd Ω W B 𝔮 t' hPD (t' ^ j * x)
        ⟨s, hs, by rw [show s * t' * (t' ^ j * x) = s * t' ^ (j + 1) * x by ring]; exact h⟩
      exact ih x s'' hs'' (by rw [mul_assoc]; exact h'')

  have nf : ∀ β : B, (∃ n : ℕ, β ∉ Ideal.span {t' ^ n} ⊔ I) →
      ∃ (m : ℕ) (a μ : B), a ∉ 𝔮 ∧ μ ∈ I ∧ β = a * t' ^ m + μ := by
    intro β h
    have hN := Nat.find_spec h
    have hN0 : Nat.find h ≠ 0 := by
      intro h0
      apply hN
      rw [h0, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_sup_left Submodule.mem_top
    obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hN0
    have hmin := not_not.mp (Nat.find_min h (show m < Nat.find h by omega))
    obtain ⟨y, hy, μ, hμ, hyμ⟩ := Submodule.mem_sup.mp hmin
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    refine ⟨m, a, μ, ?_, hμ, hyμ.symm⟩
    intro ha
    obtain ⟨y', hy', ν, hν, hy'ν⟩ := Submodule.mem_sup.mp (h𝔮eq.le ha)
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy'
    apply hN
    rw [hm]
    refine Submodule.mem_sup.mpr ⟨c * t' ^ (m + 1), Ideal.mem_span_singleton'.mpr ⟨c, rfl⟩,
      ν * t' ^ m + μ, I.add_mem (I.mul_mem_right _ hν) hμ, ?_⟩
    rw [← hyμ, ← hy'ν]
    ring

  let 𝔮₀ : Ideal B :=
    { carrier := {β | ∃ σ, σ ∉ 𝔮 ∧ σ * β ∈ I}
      add_mem' := by
        rintro a b ⟨σ₁, h₁, ha⟩ ⟨σ₂, h₂, hb⟩
        refine ⟨σ₁ * σ₂, fun h => (h𝔮p.mem_or_mem h).elim h₁ h₂, ?_⟩
        have e : σ₁ * σ₂ * (a + b) = σ₂ * (σ₁ * a) + σ₁ * (σ₂ * b) := by ring
        rw [e]
        exact I.add_mem (I.mul_mem_left _ ha) (I.mul_mem_left _ hb)
      zero_mem' := ⟨1, h1𝔮, by rw [mul_zero]; exact I.zero_mem⟩
      smul_mem' := by
        rintro c x ⟨σ, hσ, hx⟩
        refine ⟨σ, hσ, ?_⟩
        rw [smul_eq_mul, show σ * (c * x) = c * (σ * x) by ring]
        exact I.mul_mem_left _ hx }
  have hmem0 : ∀ β, β ∈ 𝔮₀ ↔ ∃ σ, σ ∉ 𝔮 ∧ σ * β ∈ I := fun β => Iff.rfl
  have hIq0 : I ≤ 𝔮₀ := fun x hx => (hmem0 x).mpr ⟨1, h1𝔮, by rw [one_mul]; exact hx⟩
  have hq0q : 𝔮₀ ≤ 𝔮 := by
    intro x hx
    obtain ⟨σ, hσ, h⟩ := (hmem0 x).mp hx
    exact (h𝔮p.mem_or_mem (hI𝔮 h)).resolve_left hσ
  have ht'0 : t' ∉ 𝔮₀ := by
    intro hx
    obtain ⟨σ, hσ, h⟩ := (hmem0 t').mp hx
    obtain ⟨s', hs', h'⟩ := nzd 1 1 σ hσ (by rw [pow_one, mul_one]; exact h)
    exact hs' (by rw [mul_one] at h'; exact hI𝔮 h')
  have NF : ∀ β, β ∉ 𝔮₀ → ∃ (m : ℕ) (a μ : B), a ∉ 𝔮 ∧ μ ∈ I ∧ β = a * t' ^ m + μ := by
    intro β hβ
    apply nf
    by_contra hcon
    push_neg at hcon
    exact hβ ((hmem0 β).mpr (krull β hcon))

  have hq0p : 𝔮₀.IsPrime := by
    refine ⟨fun htop => h1𝔮 (hq0q (by rw [htop]; exact Submodule.mem_top)), ?_⟩
    intro β γ hβγ
    by_contra hcon
    push_neg at hcon
    obtain ⟨hβ, hγ⟩ := hcon
    obtain ⟨m, a, μ, ha, hμ, hβe⟩ := NF β hβ
    obtain ⟨k, a', μ', ha', hμ', hγe⟩ := NF γ hγ
    obtain ⟨σ, hσ, h⟩ := (hmem0 _).mp hβγ
    rw [hβe, hγe] at h
    have e : σ * t' ^ (m + k) * (a * a') =
        σ * ((a * t' ^ m + μ) * (a' * t' ^ k + μ')) -
          σ * (a * t' ^ m * μ' + μ * (a' * t' ^ k) + μ * μ') := by ring
    have hmem : σ * t' ^ (m + k) * (a * a') ∈ I := by
      rw [e]
      refine I.sub_mem h (I.mul_mem_left _ ?_)
      exact I.add_mem (I.add_mem (I.mul_mem_left _ hμ') (I.mul_mem_right _ hμ))
        (I.mul_mem_right _ hμ)
    obtain ⟨s', hs', h'⟩ := nzd (m + k) (a * a') σ hσ hmem
    rcases h𝔮p.mem_or_mem (hI𝔮 h') with h1 | h1
    · exact hs' h1
    · rcases h𝔮p.mem_or_mem h1 with h2 | h2
      · exact ha h2
      · exact ha' h2

  have hii : ∀ 𝔮₁ : Ideal B, 𝔮₁.IsPrime → I ≤ 𝔮₁ → 𝔮₁ ≤ 𝔮 → 𝔮₁ = 𝔮₀ ∨ 𝔮₁ = 𝔮 := by
    intro 𝔮₁ h₁p hI₁ h₁𝔮
    have h0₁ : 𝔮₀ ≤ 𝔮₁ := by
      intro x hx
      obtain ⟨σ, hσ, h⟩ := (hmem0 x).mp hx
      exact (h₁p.mem_or_mem (hI₁ h)).resolve_left (fun h' => hσ (h₁𝔮 h'))
    by_cases hle : 𝔮₁ ≤ 𝔮₀
    · exact Or.inl (le_antisymm hle h0₁)
    · right
      obtain ⟨β, hβ1, hβ0⟩ := SetLike.not_le_iff_exists.mp hle
      obtain ⟨m, a, μ, ha, hμ, hβe⟩ := NF β hβ0
      have h2 : a * t' ^ m ∈ 𝔮₁ := by
        have := 𝔮₁.sub_mem hβ1 (hI₁ hμ)
        rwa [hβe, add_sub_cancel_right] at this
      have h3 : t' ^ m ∈ 𝔮₁ := (h₁p.mem_or_mem h2).resolve_left (fun h' => ha (h₁𝔮 h'))
      have h4 : t' ∈ 𝔮₁ := h₁p.mem_of_pow_mem m h3
      refine le_antisymm h₁𝔮 ?_
      exact h𝔮eq.le.trans (sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr h4)) hI₁)

  refine ⟨𝔮₀, hq0p, hIq0, hq0q, ht'0, hii, ?_⟩
  intro β hβ
  obtain ⟨m, a, μ, ha, hμ, hβeq⟩ := NF β hβ
  exact ⟨m, 1, a, μ, h1𝔮, ha, hIq0 hμ, by rw [one_mul]; exact hβeq⟩

theorem wcpa_dj_llsm_smpcgbtinu_trace_on_B : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
    [Algebra A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M] [IsScalarTower A K M]
    (B : Type u) [CommRing B] [Algebra A B] [Algebra B M] [IsScalarTower A B M] (h : A) (s : K),
    (∀ x : M, x ∈ Set.range (algebraMap B M) ↔ ∃ k : ℕ, IsIntegral A (algebraMap A M h ^ k * x)) →
    ∀ (𝔓 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) M)), 𝔓.IsPrime →
    algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      (algebraMap A ↥(Algebra.adjoin A {s}) h) ∉ 𝔓 →
    ∃ 𝔮𝔓 : Ideal B, 𝔮𝔓.IsPrime ∧
      𝔮𝔓.comap (algebraMap A B) = 𝔓.comap ((algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp (algebraMap A ↥(Algebra.adjoin A {s}))) ∧
      ∀ (β : B) (k : ℕ) (X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)),
        (X : M) = algebraMap A M h ^ k * algebraMap B M β → (X ∈ 𝔓 ↔ β ∈ 𝔮𝔓) :=
by
  intro A _ K _ _ M _ _ _ _ B _ _ _ _ h s hB 𝔓 h𝔓 hu
  classical
  have hιA : ∀ a : A, ((algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) M) (algebraMap A ↥(Algebra.adjoin A {s}) a) :
      ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) : M) = algebraMap A M a := fun a =>
    (IsScalarTower.algebraMap_apply A K M a).symm
  generalize hU : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)
      (algebraMap A ↥(Algebra.adjoin A {s}) h) = U at hu
  have hUc : (U : M) = algebraMap A M h := by rw [← hU]; exact hιA h
  have hUpow : ∀ k : ℕ, ((U ^ k : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) : M) =
      algebraMap A M h ^ k := by
    intro k; rw [SubmonoidClass.coe_pow, hUc]

  have hwit : ∀ β : B, ∃ (k : ℕ) (X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)),
      (X : M) = algebraMap A M h ^ k * algebraMap B M β := by
    intro β
    obtain ⟨k, hk⟩ := (hB (algebraMap B M β)).mp ⟨β, rfl⟩
    exact ⟨k, ⟨_, (mem_integralClosure_iff _ _).mpr hk.tower_top⟩, rfl⟩

  have hcan : ∀ (x y : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) (k k' : ℕ),
      x * U ^ k' = y * U ^ k → x ∈ 𝔓 → y ∈ 𝔓 := by
    intro x y k k' hxy hx
    have h1 : y * U ^ k ∈ 𝔓 := hxy ▸ 𝔓.mul_mem_right _ hx
    rcases h𝔓.mem_or_mem h1 with h2 | h2
    · exact h2
    · exact absurd (h𝔓.mem_of_pow_mem _ h2) hu

  have hind : ∀ (β : B) (k k' : ℕ) (X X' : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)),
      (X : M) = algebraMap A M h ^ k * algebraMap B M β →
      (X' : M) = algebraMap A M h ^ k' * algebraMap B M β → X ∈ 𝔓 → X' ∈ 𝔓 := by
    intro β k k' X X' hX hX' hXP
    refine hcan X X' k k' (Subtype.ext ?_) hXP
    rw [MulMemClass.coe_mul, MulMemClass.coe_mul, hUpow, hUpow, hX, hX']
    ring

  let q : Ideal B :=
    { carrier := {β | ∃ (k : ℕ) (X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)),
        (X : M) = algebraMap A M h ^ k * algebraMap B M β ∧ X ∈ 𝔓}
      add_mem' := by
        rintro β₁ β₂ ⟨k₁, X₁, hX₁, hP₁⟩ ⟨k₂, X₂, hX₂, hP₂⟩
        refine ⟨k₁ + k₂, X₁ * U ^ k₂ + X₂ * U ^ k₁, ?_,
          𝔓.add_mem (𝔓.mul_mem_right _ hP₁) (𝔓.mul_mem_right _ hP₂)⟩
        rw [AddMemClass.coe_add, MulMemClass.coe_mul, MulMemClass.coe_mul, hUpow, hUpow, hX₁, hX₂,
          map_add, pow_add]
        ring
      zero_mem' := ⟨0, 0, by simp, 𝔓.zero_mem⟩
      smul_mem' := by
        rintro c β ⟨k, X, hX, hP⟩
        obtain ⟨kc, Xc, hXc⟩ := hwit c
        refine ⟨kc + k, Xc * X, ?_, 𝔓.mul_mem_left _ hP⟩
        rw [MulMemClass.coe_mul, hXc, hX, smul_eq_mul, map_mul, pow_add]
        ring }
  have hmemq : ∀ β : B, β ∈ q ↔ ∃ (k : ℕ) (X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)),
      (X : M) = algebraMap A M h ^ k * algebraMap B M β ∧ X ∈ 𝔓 := fun β => Iff.rfl
  have hcrit : ∀ (β : B) (k : ℕ) (X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)),
      (X : M) = algebraMap A M h ^ k * algebraMap B M β → (X ∈ 𝔓 ↔ β ∈ q) := by
    intro β k X hX
    rw [hmemq]
    constructor
    · intro hXP; exact ⟨k, X, hX, hXP⟩
    · rintro ⟨k', X', hX', hX'P⟩
      exact hind β k' k X' X hX' hX hX'P
  refine ⟨q, ?_, ?_, hcrit⟩
  · refine Ideal.IsPrime.mk ?_ ?_
    · intro htop
      have h1 : (1 : B) ∈ q := (Ideal.eq_top_iff_one _).mp htop
      have h2 := (hcrit 1 0 1 (by simp)).mpr h1
      exact h𝔓.ne_top ((Ideal.eq_top_iff_one _).mpr h2)
    · intro β₁ β₂ hβ
      obtain ⟨k₁, X₁, hX₁⟩ := hwit β₁
      obtain ⟨k₂, X₂, hX₂⟩ := hwit β₂
      have hX : ((X₁ * X₂ : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) : M) =
          algebraMap A M h ^ (k₁ + k₂) * algebraMap B M (β₁ * β₂) := by
        rw [MulMemClass.coe_mul, hX₁, hX₂, map_mul, pow_add]
        ring
      have h1 := (hcrit _ _ _ hX).mpr hβ
      rcases h𝔓.mem_or_mem h1 with h2 | h2
      · exact Or.inl ((hcrit _ _ _ hX₁).mp h2)
      · exact Or.inr ((hcrit _ _ _ hX₂).mp h2)
  · ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply]
    refine ((hcrit (algebraMap A B a) 0 _ ?_).symm)
    rw [hιA, pow_zero, one_mul, IsScalarTower.algebraMap_apply A B M a]

theorem wcpa_dj_llsm_smpcgbtinu_gauss_node_ring : ∀ (B : Type u) [CommRing B] [IsDomain B]
    [IsIntegrallyClosed B] (M : Type u) [Field M] [Algebra B M] [IsFractionRing B M]
    (𝔮₀ 𝔮 : Ideal B) (τ : B), 𝔮₀.IsPrime → 𝔮.IsPrime → 𝔮₀ ≤ 𝔮 → τ ∈ 𝔮 → τ ∉ 𝔮₀ →
    (∀ β : B, β ∉ 𝔮₀ → ∃ (n : ℕ) (σ u μ : B), σ ∉ 𝔮 ∧ u ∉ 𝔮 ∧ μ ∈ 𝔮₀ ∧
      σ * β = u * τ ^ n + μ) →
    (∀ β : B, algebraMap B M β ∈ wcSmpNuD B M 𝔮₀ 𝔮) ∧
    wcSmpNuE B M 𝔮₀ ⊆ wcSmpNuMD B M 𝔮₀ 𝔮 ∧
    wcSmpNuMD B M 𝔮₀ 𝔮 ⊆ wcSmpNuD B M 𝔮₀ 𝔮 ∧
    (1 : M) ∉ wcSmpNuMD B M 𝔮₀ 𝔮 ∧
    (∀ x ∈ wcSmpNuD B M 𝔮₀ 𝔮, ∀ y ∈ wcSmpNuD B M 𝔮₀ 𝔮,
      x + y ∈ wcSmpNuD B M 𝔮₀ 𝔮 ∧ x * y ∈ wcSmpNuD B M 𝔮₀ 𝔮) ∧
    (∀ x ∈ wcSmpNuMD B M 𝔮₀ 𝔮, ∀ y ∈ wcSmpNuMD B M 𝔮₀ 𝔮, x + y ∈ wcSmpNuMD B M 𝔮₀ 𝔮) ∧
    (∀ x ∈ wcSmpNuE B M 𝔮₀, ∀ y ∈ wcSmpNuE B M 𝔮₀, x + y ∈ wcSmpNuE B M 𝔮₀) ∧
    (∀ x ∈ wcSmpNuD B M 𝔮₀ 𝔮, ∀ y ∈ wcSmpNuE B M 𝔮₀, x * y ∈ wcSmpNuE B M 𝔮₀) ∧
    (∀ σ : B, σ ∉ 𝔮 → (algebraMap B M σ)⁻¹ ∈ wcSmpNuD B M 𝔮₀ 𝔮) ∧
    (∀ p : Polynomial M, p.Monic → (∀ i, p.coeff i ∈ wcSmpNuD B M 𝔮₀ 𝔮) →
      ∀ x : M, p.eval x = 0 → x ∈ wcSmpNuD B M 𝔮₀ 𝔮) :=
by
  intro B _ _ _ M _ _ _ 𝔮₀ 𝔮 τ h0 h1 hle hτ _hτ0 H
  classical
  have hinj : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  have nq0 : ∀ {s : B}, s ∉ 𝔮 → s ∉ 𝔮₀ := fun hs h => hs (hle h)
  have nm0 : ∀ {a b : B}, a ∉ 𝔮₀ → b ∉ 𝔮₀ → a * b ∉ 𝔮₀ :=
    fun ha hb h => (h0.mem_or_mem h).elim ha hb
  have nm1 : ∀ {a b : B}, a ∉ 𝔮 → b ∉ 𝔮 → a * b ∉ 𝔮 :=
    fun ha hb h => (h1.mem_or_mem h).elim ha hb
  have one0 : (1 : B) ∉ 𝔮₀ := (Ideal.ne_top_iff_one _).mp h0.ne_top
  have one1 : (1 : B) ∉ 𝔮 := (Ideal.ne_top_iff_one _).mp h1.ne_top
  have memE : ∀ x : M, x ∈ wcSmpNuE B M 𝔮₀ ↔
      ∃ e ∈ 𝔮₀, ∃ d ∉ 𝔮₀, x * algebraMap B M d = algebraMap B M e := fun x => Iff.rfl
  have memD : ∀ x : M, x ∈ wcSmpNuD B M 𝔮₀ 𝔮 ↔
      ∃ y, ∃ σ ∉ 𝔮, x * algebraMap B M σ - algebraMap B M y ∈ wcSmpNuE B M 𝔮₀ :=
    fun x => Iff.rfl
  have memMD : ∀ x : M, x ∈ wcSmpNuMD B M 𝔮₀ 𝔮 ↔
      ∃ y ∈ 𝔮, ∃ σ ∉ 𝔮, x * algebraMap B M σ - algebraMap B M y ∈ wcSmpNuE B M 𝔮₀ :=
    fun x => Iff.rfl

  have E0 : (0 : M) ∈ wcSmpNuE B M 𝔮₀ :=
    (memE 0).2 ⟨0, 𝔮₀.zero_mem, 1, one0, by rw [zero_mul, map_zero]⟩
  have Eadd : ∀ x ∈ wcSmpNuE B M 𝔮₀, ∀ x' ∈ wcSmpNuE B M 𝔮₀, x + x' ∈ wcSmpNuE B M 𝔮₀ := by
    intro x hx x' hx'
    obtain ⟨e₁, he₁, d₁, hd₁, h₁⟩ := (memE x).1 hx
    obtain ⟨e₂, he₂, d₂, hd₂, h₂⟩ := (memE x').1 hx'
    refine (memE _).2 ⟨e₁ * d₂ + e₂ * d₁, 𝔮₀.add_mem (𝔮₀.mul_mem_right _ he₁)
      (𝔮₀.mul_mem_right _ he₂), d₁ * d₂, nm0 hd₁ hd₂, ?_⟩
    simp only [map_mul, map_add]
    linear_combination (algebraMap B M d₂) * h₁ + (algebraMap B M d₁) * h₂
  have Eneg : ∀ x ∈ wcSmpNuE B M 𝔮₀, -x ∈ wcSmpNuE B M 𝔮₀ := by
    intro x hx
    obtain ⟨e, he, d, hd, h⟩ := (memE x).1 hx
    refine (memE _).2 ⟨-e, neg_mem he, d, hd, ?_⟩
    rw [map_neg]
    linear_combination -h

  have LocE : ∀ (x : M) (a s : B), s ∉ 𝔮₀ → x * algebraMap B M s = algebraMap B M a →
      ∀ z ∈ wcSmpNuE B M 𝔮₀, x * z ∈ wcSmpNuE B M 𝔮₀ := by
    intro x a s hs hx z hz
    obtain ⟨e, he, d, hd, h⟩ := (memE z).1 hz
    refine (memE _).2 ⟨a * e, 𝔮₀.mul_mem_left a he, s * d, nm0 hs hd, ?_⟩
    simp only [map_mul]
    linear_combination (z * algebraMap B M d) * hx + (algebraMap B M a) * h
  have preLoc : ∀ (w : M) (y : B), w - algebraMap B M y ∈ wcSmpNuE B M 𝔮₀ →
      ∃ a s : B, s ∉ 𝔮₀ ∧ w * algebraMap B M s = algebraMap B M a := by
    intro w y h
    obtain ⟨e, he, d, hd, h⟩ := (memE _).1 h
    refine ⟨y * d + e, d, hd, ?_⟩
    simp only [map_mul, map_add]
    linear_combination h
  have DLoc : ∀ x ∈ wcSmpNuD B M 𝔮₀ 𝔮,
      ∃ a s : B, s ∉ 𝔮₀ ∧ x * algebraMap B M s = algebraMap B M a := by
    intro x hx
    obtain ⟨y, σ, hσ, h⟩ := (memD x).1 hx
    obtain ⟨a, s, hs, h'⟩ := preLoc _ y h
    refine ⟨a, σ * s, nm0 (nq0 hσ) hs, ?_⟩
    rw [map_mul, ← mul_assoc, h']
  have core_add : ∀ (x₁ x₂ : M) (y₁ y₂ σ₁ σ₂ : B),
      x₁ * algebraMap B M σ₁ - algebraMap B M y₁ ∈ wcSmpNuE B M 𝔮₀ →
      x₂ * algebraMap B M σ₂ - algebraMap B M y₂ ∈ wcSmpNuE B M 𝔮₀ →
      (x₁ + x₂) * algebraMap B M (σ₁ * σ₂) - algebraMap B M (y₁ * σ₂ + y₂ * σ₁) ∈
        wcSmpNuE B M 𝔮₀ := by
    intro x₁ x₂ y₁ y₂ σ₁ σ₂ h₁ h₂
    have e : (x₁ + x₂) * algebraMap B M (σ₁ * σ₂) - algebraMap B M (y₁ * σ₂ + y₂ * σ₁) =
        algebraMap B M σ₂ * (x₁ * algebraMap B M σ₁ - algebraMap B M y₁) +
        algebraMap B M σ₁ * (x₂ * algebraMap B M σ₂ - algebraMap B M y₂) := by
      simp only [map_mul, map_add]; ring
    rw [e]
    exact Eadd _ (LocE _ σ₂ 1 one0 (by rw [map_one, mul_one]) _ h₁) _
      (LocE _ σ₁ 1 one0 (by rw [map_one, mul_one]) _ h₂)
  have core_mul : ∀ (x₁ x₂ : M) (y₁ y₂ σ₁ σ₂ : B),
      x₁ * algebraMap B M σ₁ - algebraMap B M y₁ ∈ wcSmpNuE B M 𝔮₀ →
      x₂ * algebraMap B M σ₂ - algebraMap B M y₂ ∈ wcSmpNuE B M 𝔮₀ →
      (x₁ * x₂) * algebraMap B M (σ₁ * σ₂) - algebraMap B M (y₁ * y₂) ∈ wcSmpNuE B M 𝔮₀ := by
    intro x₁ x₂ y₁ y₂ σ₁ σ₂ h₁ h₂
    have e : (x₁ * x₂) * algebraMap B M (σ₁ * σ₂) - algebraMap B M (y₁ * y₂) =
        (x₂ * algebraMap B M σ₂) * (x₁ * algebraMap B M σ₁ - algebraMap B M y₁) +
        algebraMap B M y₁ * (x₂ * algebraMap B M σ₂ - algebraMap B M y₂) := by
      simp only [map_mul]; ring
    rw [e]
    obtain ⟨a, s, hs, h'⟩ := preLoc _ y₂ h₂
    exact Eadd _ (LocE _ a s hs h' _ h₁) _ (LocE _ y₁ 1 one0 (by rw [map_one, mul_one]) _ h₂)

  have c1 : ∀ β : B, algebraMap B M β ∈ wcSmpNuD B M 𝔮₀ 𝔮 := fun β =>
    (memD _).2 ⟨β, 1, one1, by rw [map_one, mul_one, sub_self]; exact E0⟩
  have c2 : wcSmpNuE B M 𝔮₀ ⊆ wcSmpNuMD B M 𝔮₀ 𝔮 := fun x hx =>
    (memMD _).2 ⟨0, 𝔮.zero_mem, 1, one1, by rw [map_one, map_zero, mul_one, sub_zero]; exact hx⟩
  have c3 : wcSmpNuMD B M 𝔮₀ 𝔮 ⊆ wcSmpNuD B M 𝔮₀ 𝔮 := by
    intro x hx
    obtain ⟨y, _, σ, hσ, h⟩ := (memMD x).1 hx
    exact (memD _).2 ⟨y, σ, hσ, h⟩
  have c4 : (1 : M) ∉ wcSmpNuMD B M 𝔮₀ 𝔮 := by
    intro h
    obtain ⟨y, hy, σ, hσ, hE⟩ := (memMD _).1 h
    obtain ⟨e, he, d, hd, h'⟩ := (memE _).1 hE
    have h2 : algebraMap B M ((σ - y) * d) = algebraMap B M e := by
      rw [map_mul, map_sub, ← h', one_mul]
    have h3 := hinj h2
    rw [← h3] at he
    rcases h0.mem_or_mem he with h4 | h4
    · exact hσ (by have h5 := 𝔮.add_mem (hle h4) hy; simpa using h5)
    · exact hd h4
  have c5 : ∀ x ∈ wcSmpNuD B M 𝔮₀ 𝔮, ∀ y ∈ wcSmpNuD B M 𝔮₀ 𝔮,
      x + y ∈ wcSmpNuD B M 𝔮₀ 𝔮 ∧ x * y ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
    intro x hx y hy
    obtain ⟨y₁, σ₁, hσ₁, h₁⟩ := (memD x).1 hx
    obtain ⟨y₂, σ₂, hσ₂, h₂⟩ := (memD y).1 hy
    exact ⟨(memD _).2 ⟨_, _, nm1 hσ₁ hσ₂, core_add _ _ _ _ _ _ h₁ h₂⟩,
      (memD _).2 ⟨_, _, nm1 hσ₁ hσ₂, core_mul _ _ _ _ _ _ h₁ h₂⟩⟩
  have c6 : ∀ x ∈ wcSmpNuMD B M 𝔮₀ 𝔮, ∀ y ∈ wcSmpNuMD B M 𝔮₀ 𝔮,
      x + y ∈ wcSmpNuMD B M 𝔮₀ 𝔮 := by
    intro x hx y hy
    obtain ⟨y₁, hy₁, σ₁, hσ₁, h₁⟩ := (memMD x).1 hx
    obtain ⟨y₂, hy₂, σ₂, hσ₂, h₂⟩ := (memMD y).1 hy
    exact (memMD _).2 ⟨_, 𝔮.add_mem (𝔮.mul_mem_right _ hy₁) (𝔮.mul_mem_right _ hy₂), _,
      nm1 hσ₁ hσ₂, core_add _ _ _ _ _ _ h₁ h₂⟩
  have c8 : ∀ x ∈ wcSmpNuD B M 𝔮₀ 𝔮, ∀ y ∈ wcSmpNuE B M 𝔮₀, x * y ∈ wcSmpNuE B M 𝔮₀ := by
    intro x hx y hy
    obtain ⟨a, s, hs, h⟩ := DLoc x hx
    exact LocE x a s hs h y hy
  have c9 : ∀ σ : B, σ ∉ 𝔮 → (algebraMap B M σ)⁻¹ ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
    intro σ hσ
    have hne : algebraMap B M σ ≠ 0 := by
      intro h
      apply hσ
      rw [hinj (h.trans (map_zero _).symm)]
      exact 𝔮.zero_mem
    exact (memD _).2 ⟨1, σ, hσ, by rw [inv_mul_cancel₀ hne, map_one, sub_self]; exact E0⟩
  have DMD : ∀ x ∈ wcSmpNuD B M 𝔮₀ 𝔮, ∀ z ∈ wcSmpNuMD B M 𝔮₀ 𝔮,
      x * z ∈ wcSmpNuMD B M 𝔮₀ 𝔮 := by
    intro x hx z hz
    obtain ⟨y₁, σ₁, hσ₁, h₁⟩ := (memD x).1 hx
    obtain ⟨y₂, hy₂, σ₂, hσ₂, h₂⟩ := (memMD z).1 hz
    exact (memMD _).2 ⟨_, 𝔮.mul_mem_left _ hy₂, _, nm1 hσ₁ hσ₂,
      core_mul _ _ _ _ _ _ h₁ h₂⟩
  have MDneg : ∀ x ∈ wcSmpNuMD B M 𝔮₀ 𝔮, -x ∈ wcSmpNuMD B M 𝔮₀ 𝔮 := by
    intro x hx
    obtain ⟨y, hy, σ, hσ, h⟩ := (memMD x).1 hx
    refine (memMD _).2 ⟨-y, neg_mem hy, σ, hσ, ?_⟩
    have e : -x * algebraMap B M σ - algebraMap B M (-y) =
        -(x * algebraMap B M σ - algebraMap B M y) := by
      rw [map_neg]; ring
    rw [e]; exact Eneg _ h
  have MD0 : (0 : M) ∈ wcSmpNuMD B M 𝔮₀ 𝔮 :=
    (memMD _).2 ⟨0, 𝔮.zero_mem, 1, one1, by rw [zero_mul, map_zero, sub_zero]; exact E0⟩

  have K : ∀ (z : M) (α δ : B) (nα nδ : ℕ) (σα uα μα σδ uδ μδ : B),
      σα ∉ 𝔮 → uα ∉ 𝔮 → μα ∈ 𝔮₀ → σα * α = uα * τ ^ nα + μα →
      σδ ∉ 𝔮 → uδ ∉ 𝔮 → μδ ∈ 𝔮₀ → σδ * δ = uδ * τ ^ nδ + μδ →
      δ ∉ 𝔮₀ → z * algebraMap B M δ = algebraMap B M α → nδ ≤ nα →
      ∃ y σ : B, σ ∉ 𝔮 ∧ (nδ < nα → y ∈ 𝔮) ∧
        z * algebraMap B M σ - algebraMap B M y ∈ wcSmpNuE B M 𝔮₀ := by
    intro z α δ nα nδ σα uα μα σδ uδ μδ hσα huα hμα hHα hσδ huδ hμδ hHδ hδ hz hn
    obtain ⟨k, rfl⟩ : ∃ k, nα = nδ + k := ⟨nα - nδ, by omega⟩
    refine ⟨uα * σδ * τ ^ k, uδ * σα, nm1 huδ hσα, fun hlt => ?_, ?_⟩
    · obtain ⟨j, hj⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      rw [hj]
      exact 𝔮.mul_mem_left _ (Ideal.pow_mem_of_mem 𝔮 hτ _ (Nat.succ_pos j))
    · refine (memE _).2 ⟨σδ * (uδ * μα - uα * τ ^ k * μδ),
        𝔮₀.mul_mem_left _ (𝔮₀.sub_mem (𝔮₀.mul_mem_left _ hμα) (𝔮₀.mul_mem_left _ hμδ)),
        σδ * δ, nm0 (nq0 hσδ) hδ, ?_⟩
      have hA := congrArg (algebraMap B M) hHα
      have hD := congrArg (algebraMap B M) hHδ
      simp only [map_mul, map_add, map_pow] at hA hD
      simp only [map_mul, map_sub, map_pow]
      linear_combination (algebraMap B M uδ * algebraMap B M σα * algebraMap B M σδ) * hz +
        (algebraMap B M uδ * algebraMap B M σδ) * hA -
        (algebraMap B M uα * algebraMap B M σδ * algebraMap B M τ ^ k) * hD

  have c10 : ∀ p : Polynomial M, p.Monic → (∀ i, p.coeff i ∈ wcSmpNuD B M 𝔮₀ 𝔮) →
      ∀ x : M, p.eval x = 0 → x ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
    intro p hp hc x hx

    have hcl : ∀ i, ∃ a s : B, s ∉ 𝔮₀ ∧ p.coeff i * algebraMap B M s = algebraMap B M a :=
      fun i => DLoc _ (hc i)
    choose a s hs hcs using hcl
    obtain ⟨S, hSdef⟩ : ∃ S : B, S = ∏ i ∈ Finset.range p.natDegree, s i := ⟨_, rfl⟩
    have hS : S ∉ 𝔮₀ := by
      rw [hSdef]
      exact Finset.prod_induction _ (fun b => b ∉ 𝔮₀) (fun _ _ ha hb => nm0 ha hb) one0
        (fun i _ => hs i)
    have hlift : p.scaleRoots (algebraMap B M S) ∈ Polynomial.lifts (algebraMap B M) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i p.natDegree with hi | hi | hi
      · obtain ⟨k, hk⟩ : ∃ k, p.natDegree - i = k + 1 := ⟨p.natDegree - i - 1, by omega⟩
        obtain ⟨R, hR⟩ : ∃ R : B, R = ∏ j ∈ (Finset.range p.natDegree).erase i, s j := ⟨_, rfl⟩
        have hS' : algebraMap B M S = algebraMap B M (s i) * algebraMap B M R := by
          rw [hSdef, hR, ← map_mul, Finset.mul_prod_erase _ _ (Finset.mem_range.2 hi)]
        refine ⟨a i * R * S ^ k, ?_⟩
        rw [hk, pow_succ, map_mul, map_mul, map_pow]
        linear_combination (-(algebraMap B M R * algebraMap B M S ^ k)) * hcs i -
          (p.coeff i * algebraMap B M S ^ k) * hS'
      · refine ⟨1, ?_⟩
        rw [hi, Nat.sub_self, pow_zero, mul_one, hp.coeff_natDegree, map_one]
      · refine ⟨0, ?_⟩
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, zero_mul, map_zero]
    obtain ⟨q, hqmap, -, hqmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff _).2 hp)
    have hint : _root_.IsIntegral B (algebraMap B M S * x) := by
      refine ⟨q, hqmonic, ?_⟩
      rw [← Polynomial.eval_map, hqmap]
      have h2 := Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id M) (s := algebraMap B M S)
        (show Polynomial.eval₂ (RingHom.id M) x p = 0 by rw [Polynomial.eval₂_id]; exact hx)
      rwa [RingHom.id_apply, Polynomial.eval₂_id] at h2
    obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    obtain ⟨a₀, s₀, hs₀, hx₀⟩ : ∃ a s : B, s ∉ 𝔮₀ ∧ x * algebraMap B M s = algebraMap B M a :=
      ⟨b, S, hS, by rw [hb, mul_comm]⟩

    by_cases ha₀ : a₀ ∈ 𝔮₀
    · exact c3 (c2 ((memE _).2 ⟨a₀, ha₀, s₀, hs₀, hx₀⟩))
    obtain ⟨na, σa, ua, μa, hσa, hua, hμa, hHa⟩ := H a₀ ha₀
    obtain ⟨ns, σs, us, μs, hσs, hus, hμs, hHs⟩ := H s₀ hs₀
    rcases le_or_gt ns na with hle' | hlt
    · obtain ⟨y, σ, hσ, -, hE⟩ := K x a₀ s₀ na ns σa ua μa σs us μs hσa hua hμa hHa hσs hus
        hμs hHs hs₀ hx₀ hle'
      exact (memD _).2 ⟨y, σ, hσ, hE⟩
    · exfalso
      have hx0 : x ≠ 0 := by
        rintro rfl
        rw [zero_mul] at hx₀
        apply ha₀
        rw [hinj (hx₀.symm.trans (map_zero _).symm)]
        exact 𝔮₀.zero_mem
      have hinv : x⁻¹ * algebraMap B M a₀ = algebraMap B M s₀ := by
        rw [← hx₀, ← mul_assoc, inv_mul_cancel₀ hx0, one_mul]
      obtain ⟨y, σ, hσ, hy, hE⟩ := K x⁻¹ s₀ a₀ ns na σs us μs σa ua μa hσs hus hμs hHs hσa hua
        hμa hHa ha₀ hinv hlt.le
      have hw : x⁻¹ ∈ wcSmpNuMD B M 𝔮₀ 𝔮 := (memMD _).2 ⟨y, hy hlt, σ, hσ, hE⟩
      have hw1 : x⁻¹ * x = 1 := inv_mul_cancel₀ hx0
      have hpow : ∀ j : ℕ, x⁻¹ ^ (j + 1) ∈ wcSmpNuMD B M 𝔮₀ 𝔮 := by
        intro j
        induction j with
        | zero => rw [zero_add, pow_one]; exact hw
        | succ j ih => rw [pow_succ]; exact DMD _ (c3 ih) _ hw
      have hsum : ∑ i ∈ Finset.range (p.natDegree + 1),
          p.coeff i * x⁻¹ ^ (p.natDegree - i) = 0 := by
        have e : ∀ i ∈ Finset.range (p.natDegree + 1), p.coeff i * x⁻¹ ^ (p.natDegree - i) =
            x⁻¹ ^ p.natDegree * (p.coeff i * x ^ i) := by
          intro i hi
          have hi' : i ≤ p.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have h2 : x⁻¹ ^ p.natDegree = x⁻¹ ^ (p.natDegree - i) * x⁻¹ ^ i := by
            rw [← pow_add, Nat.sub_add_cancel hi']
          have hwx : x⁻¹ ^ i * x ^ i = 1 := by rw [← mul_pow, hw1, one_pow]
          rw [h2]
          calc p.coeff i * x⁻¹ ^ (p.natDegree - i)
              = p.coeff i * x⁻¹ ^ (p.natDegree - i) * (x⁻¹ ^ i * x ^ i) := by
                rw [hwx, mul_one]
            _ = x⁻¹ ^ (p.natDegree - i) * x⁻¹ ^ i * (p.coeff i * x ^ i) := by ring
        rw [Finset.sum_congr rfl e, ← Finset.mul_sum, ← Polynomial.eval_eq_sum_range, hx,
          mul_zero]
      rw [Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one, hp.coeff_natDegree] at hsum
      have hT : ∑ i ∈ Finset.range p.natDegree, p.coeff i * x⁻¹ ^ (p.natDegree - i) ∈
          wcSmpNuMD B M 𝔮₀ 𝔮 := by
        apply Finset.sum_induction _ (fun t => t ∈ wcSmpNuMD B M 𝔮₀ 𝔮)
        · exact fun a b ha hb => c6 a ha b hb
        · exact MD0
        · intro i hi
          have hi' := Finset.mem_range.mp hi
          obtain ⟨k, hk⟩ : ∃ k, p.natDegree - i = k + 1 := ⟨p.natDegree - i - 1, by omega⟩
          rw [hk]
          exact DMD _ (hc i) _ (hpow k)
      have h1M : (1 : M) ∈ wcSmpNuMD B M 𝔮₀ 𝔮 := by
        have e1 : (1 : M) =
            -(∑ i ∈ Finset.range p.natDegree, p.coeff i * x⁻¹ ^ (p.natDegree - i)) := by
          linear_combination hsum
        rw [e1]; exact MDneg _ hT
      exact c4 h1M
  exact ⟨c1, c2, c3, c4, c5, c6, Eadd, c8, c9, c10⟩

theorem wcpa_dj_llsm_smpcgbtinu_local_integral : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (M : Type u) [Field M] [Algebra A M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower A B M]
    (𝔭 : Ideal A) (h : A) (𝔮 : Ideal B) (t' : B), 𝔭.IsMaximal → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ y σ : B, y ∉ 𝔮 → σ ∉ 𝔮 →
    ∃ (n : ℕ) (α : ℕ → A), α 0 ∉ 𝔭 ∧
      ∑ i ∈ Finset.range (n + 1),
        algebraMap A M (α i) * (algebraMap B M y / algebraMap B M σ) ^ i = 0 :=
by
  classical
  intro Ω _ W A _ _ _ M _ _ B _ _ _ _ _ _ _ 𝔭 h 𝔮 t' h𝔭 hS y σ hy hσ
  unfold wcLlsSmc at hS
  obtain ⟨hh, hint, -, -, huniq⟩ := hS
  haveI hp𝔭 : 𝔭.IsPrime := h𝔭.isPrime
  have tower : ∀ a : A, algebraMap B M (algebraMap A B a) = algebraMap A M a := fun a =>
    (IsScalarTower.algebraMap_apply A B M a).symm

  have wit : ∀ β : B, ∃ (k : ℕ) (X : integralClosure A M),
      (X : M) = algebraMap A M h ^ k * algebraMap B M β := by
    intro β
    obtain ⟨k, hk⟩ := (hint (algebraMap B M β)).mp ⟨β, rfl⟩
    exact ⟨k, ⟨_, (mem_integralClosure_iff A M).mpr hk⟩, rfl⟩

  have reversal : ∀ (a : A), a ∉ 𝔭 → ∀ (w x : M), IsIntegral A w → w * x = algebraMap A M a →
      ∃ (n : ℕ) (α : ℕ → A), α 0 ∉ 𝔭 ∧
        ∑ i ∈ Finset.range (n + 1), algebraMap A M (α i) * x ^ i = 0 := by
    intro a ha w x hw hwx
    obtain ⟨p, hpm, hp⟩ := hw
    obtain ⟨n, hn⟩ : ∃ n, p.natDegree = n := ⟨_, rfl⟩
    have hcoeff : p.coeff n = 1 := by rw [← hn]; exact hpm.coeff_natDegree
    refine ⟨n, fun j => p.coeff (n - j) * a ^ (n - j), ?_, ?_⟩
    · show p.coeff (n - 0) * a ^ (n - 0) ∉ 𝔭
      rw [Nat.sub_zero, hcoeff, one_mul]
      intro hmem
      exact ha (hp𝔭.mem_of_pow_mem _ hmem)
    · have h1 : ∑ i ∈ Finset.range (n + 1), algebraMap A M (p.coeff i) * w ^ i = 0 := by
        rw [Polynomial.eval₂_eq_sum_range, hn] at hp
        exact hp
      have h2 : ∑ i ∈ Finset.range (n + 1), algebraMap A M (p.coeff i * a ^ i) * x ^ (n - i)
          = 0 := by
        have e : ∑ i ∈ Finset.range (n + 1), algebraMap A M (p.coeff i * a ^ i) * x ^ (n - i)
            = x ^ n * ∑ i ∈ Finset.range (n + 1), algebraMap A M (p.coeff i) * w ^ i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i hi => ?_)
          have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [map_mul, map_pow, ← hwx]
          have ex : x ^ n = x ^ i * x ^ (n - i) := by rw [← pow_add, Nat.add_sub_cancel' hin]
          rw [ex]
          ring
        rw [e, h1, mul_zero]
      have h3 := Finset.sum_range_reflect
        (fun i => algebraMap A M (p.coeff i * a ^ i) * x ^ (n - i)) (n + 1)
      refine Eq.trans ?_ (h3.trans h2)
      refine Finset.sum_congr rfl (fun j hj => ?_)
      have hjn : j ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      have e1 : n + 1 - 1 - j = n - j := by omega
      have e2 : n - (n - j) = j := by omega
      simp only [e1, e2]

  have trace : ∀ (Q : Ideal (integralClosure A M)), Q.IsPrime →
      algebraMap A (integralClosure A M) h ∉ Q →
      ∃ q' : Ideal B, q'.IsPrime ∧
        q'.comap (algebraMap A B) = Q.comap (algebraMap A (integralClosure A M)) ∧
        ∀ (β : B) (k : ℕ) (X : integralClosure A M),
          (X : M) = algebraMap A M h ^ k * algebraMap B M β → (X ∈ Q ↔ β ∈ q') := by
    intro Q hQ hHQ
    have hHk : ∀ k : ℕ, algebraMap A (integralClosure A M) h ^ k ∉ Q :=
      fun k hk => hHQ (hQ.mem_of_pow_mem k hk)
    have indep : ∀ (β : B) (k k' : ℕ) (X X' : integralClosure A M),
        (X : M) = algebraMap A M h ^ k * algebraMap B M β →
        (X' : M) = algebraMap A M h ^ k' * algebraMap B M β → X' ∈ Q → X ∈ Q := by
      intro β k k' X X' hX hX' hmem
      have e : algebraMap A (integralClosure A M) h ^ k' * X
          = algebraMap A (integralClosure A M) h ^ k * X' := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap, hX, hX']
        ring
      have hm : algebraMap A (integralClosure A M) h ^ k' * X ∈ Q := by
        rw [e]; exact Q.mul_mem_left _ hmem
      exact (hQ.mem_or_mem hm).resolve_left (hHk k')
    obtain ⟨q', hmemq⟩ : ∃ q' : Ideal B, ∀ β, β ∈ q' ↔
        ∃ (k : ℕ) (X : integralClosure A M), X ∈ Q ∧
          (X : M) = algebraMap A M h ^ k * algebraMap B M β := by
      refine ⟨{ carrier := {β | ∃ (k : ℕ) (X : integralClosure A M), X ∈ Q ∧
                  (X : M) = algebraMap A M h ^ k * algebraMap B M β}
                add_mem' := ?_
                zero_mem' := ?_
                smul_mem' := ?_ }, fun β => Iff.rfl⟩
      · simp only [Set.mem_setOf_eq]
        rintro β β' ⟨k, X, hX, hXe⟩ ⟨k', X', hX', hXe'⟩
        refine ⟨k + k', algebraMap A _ h ^ k' * X + algebraMap A _ h ^ k * X',
          Q.add_mem (Q.mul_mem_left _ hX) (Q.mul_mem_left _ hX'), ?_⟩
        simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_pow,
          Subalgebra.coe_algebraMap, hXe, hXe', map_add]
        ring
      · simp only [Set.mem_setOf_eq]
        exact ⟨0, 0, Q.zero_mem, by simp⟩
      · simp only [Set.mem_setOf_eq]
        rintro c β ⟨k, X, hX, hXe⟩
        obtain ⟨kc, Xc, hXc⟩ := wit c
        refine ⟨kc + k, Xc * X, Q.mul_mem_left _ hX, ?_⟩
        simp only [smul_eq_mul, Subalgebra.coe_mul, hXc, hXe, map_mul]
        ring
    have key : ∀ (β : B) (k : ℕ) (X : integralClosure A M),
        (X : M) = algebraMap A M h ^ k * algebraMap B M β → (X ∈ Q ↔ β ∈ q') := by
      intro β k X hX
      rw [hmemq]
      constructor
      · intro hmem
        exact ⟨k, X, hmem, hX⟩
      · rintro ⟨k', X', hX', hXe'⟩
        exact indep β k k' X X' hX hXe' hX'
    refine ⟨q', ⟨?_, ?_⟩, ?_, key⟩
    · rw [Ideal.ne_top_iff_one]
      intro h1
      have hm := (key 1 0 1 (by simp)).mpr h1
      exact hQ.ne_top ((Ideal.eq_top_iff_one _).mpr hm)
    · intro a b hab
      obtain ⟨ka, Xa, hXa⟩ := wit a
      obtain ⟨kb, Xb, hXb⟩ := wit b
      have hm : Xa * Xb ∈ Q := (key (a * b) (ka + kb) (Xa * Xb)
        (by simp only [Subalgebra.coe_mul, hXa, hXb, map_mul]; ring)).mpr hab
      rcases hQ.mem_or_mem hm with hm' | hm'
      · exact Or.inl ((key a ka Xa hXa).mp hm')
      · exact Or.inr ((key b kb Xb hXb).mp hm')
    · ext a
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact (key (algebraMap A B a) 0 (algebraMap A _ a)
        (by rw [Subalgebra.coe_algebraMap, pow_zero, one_mul, tower])).symm

  have hwit : ∃ (γ : B) (a' : A), a' ∉ 𝔭 ∧ γ * y = algebraMap A B a' := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨k₀, Xy, hXy⟩ := wit y
    have hunder : Ideal.under A (Ideal.span {Xy}) ≤ 𝔭 := by
      intro a ha
      change algebraMap A (integralClosure A M) a ∈ Ideal.span {Xy} at ha
      rw [Ideal.mem_span_singleton'] at ha
      obtain ⟨c, hc⟩ := ha
      obtain ⟨βc, hβc⟩ := (hint (c : M)).mpr
        ⟨0, by rw [pow_zero, one_mul]; exact (mem_integralClosure_iff A M).mp c.2⟩
      by_contra hna
      apply hcon (βc * algebraMap A B h ^ k₀) a hna
      apply IsFractionRing.injective B M
      have hc' := congrArg Subtype.val hc
      simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, hXy] at hc'
      rw [map_mul, map_mul, map_pow, tower, tower, hβc, ← hc']
      ring
    obtain ⟨Q, hQge, hQ, hQu⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral 𝔭 (Ideal.span {Xy}) hunder
    have hHQ : algebraMap A (integralClosure A M) h ∉ Q := by
      intro hm
      apply hh
      rw [← hQu]
      exact hm
    obtain ⟨q', hq', hq'c, hkey⟩ := trace Q hQ hHQ
    have hq'eq : q' = 𝔮 := huniq q' hq' (by rw [hq'c]; exact hQu)
    apply hy
    rw [← hq'eq]
    exact (hkey y k₀ Xy hXy).mp (hQge (Ideal.subset_span (Set.mem_singleton Xy)))

  obtain ⟨γ, a', ha', hγ⟩ := hwit
  obtain ⟨k, hk⟩ := (hint (algebraMap B M (γ * σ))).mp ⟨_, rfl⟩
  have hσ0 : algebraMap B M σ ≠ 0 := by
    intro h0
    apply hσ
    have hσz : σ = 0 := IsFractionRing.injective B M (by rw [h0, map_zero])
    rw [hσz]
    exact 𝔮.zero_mem
  have ha : a' * h ^ k ∉ 𝔭 := by
    intro hm
    rcases hp𝔭.mem_or_mem hm with h1 | h1
    · exact ha' h1
    · exact hh (hp𝔭.mem_of_pow_mem k h1)
  refine reversal (a' * h ^ k) ha _ _ hk ?_
  simp only [map_mul, map_pow]
  rw [← tower a', ← hγ, map_mul, div_eq_mul_inv]
  have hinv : algebraMap B M σ * (algebraMap B M σ)⁻¹ = 1 := mul_inv_cancel₀ hσ0
  linear_combination (algebraMap A M h ^ k * algebraMap B M γ * algebraMap B M y) * hinv

theorem wcpa_dj_llsm_smpcgbti_node_unique : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ R : List ↥W, (∀ r ∈ R, r ∈ IsLocalRing.maximalIdeal ↥W) →
    (∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      (θ (algebraMap A B t) - c ∣ (R.map (fun r => θ t' - r)).prod ∧
        (R.map (fun r => θ t' - r)).prod ∣ θ (algebraMap A B t) - c)) →
    ∃ Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M),
      Q.IsPrime ∧
      Q.comap (algebraMap ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
          ↥(integralClosure ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
            (t - algebraMap ↥W A c),
          ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
            Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})).comp
            (algebraMap ↥W A)) ∧
      ∀ Q' : Ideal ↥(integralClosure ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M),
        Q'.IsPrime →
        Q'.comap (algebraMap ↥(Algebra.adjoin A
            {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
            ↥(integralClosure ↥(Algebra.adjoin A
              {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)}) M)) =
          Ideal.span {algebraMap A ↥(Algebra.adjoin A
              {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})
              (t - algebraMap ↥W A c),
            ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c),
              Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
          (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A
              {algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c)})).comp
              (algebraMap ↥W A)) →
        Q' = Q :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ M _ _ _ _ _ _ B _ _ _ _ _ _ _ _ 𝔭 t h 𝔮 t' hPD hSmc
    c b hc hbm hb0 R hRm hR
  set z0 : A := t - algebraMap ↥W A c with hz0def
  set s : K := algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0 with hsdef
  obtain ⟨-, -, -, h𝔭max, hm𝔭, ht𝔭, h𝔭eq, -⟩ := id hPD
  obtain ⟨hh𝔭, hBint, hPDB, h𝔮c, h𝔮u⟩ := id hSmc
  obtain ⟨-, -, hICB, h𝔮max, -, ht'𝔮, -, -⟩ := id hPDB
  haveI : IsIntegrallyClosed B := hICB
  have hτ := wcpa_dj_llsm_obnu_tau_ne_zero Ω W A K 𝔭 t hPD c b hb0
  have hz0ne : z0 ≠ 0 := fun h0 => hτ.1 (by show algebraMap A K z0 = 0; rw [h0, map_zero])
  have hz0𝔭 : z0 ∈ 𝔭 := by
    rw [hz0def]; exact 𝔭.sub_mem ht𝔭 (hm𝔭 (Ideal.mem_map_of_mem _ hc))
  have hsz : s * algebraMap A K z0 = algebraMap A K (algebraMap ↥W A b) := by
    rw [hsdef]; exact div_mul_cancel₀ _ hτ.1

  set N : Ideal ↥(Algebra.adjoin A {s}) :=
    Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) with hN
  have hle : 𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A ↥(Algebra.adjoin A {s}) t ∈ N
      have et : t = z0 + algebraMap ↥W A c := (sub_add_cancel _ _).symm
      rw [et, map_add, hN]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hc))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      show algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ N
      rw [hN]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hw)

  obtain ⟨h₁, -, -, -, -, -, -, χ, hχa, hχs⟩ :=
    wcpa_dj_llsm_bcc_chart_etale W A K 𝔭 (.disc t) z0 b hPD (Or.inl ⟨t, c, rfl, hc, rfl⟩)
      hbm hb0 hz0ne
  have hle' : Algebra.adjoin A {s} ≤ Algebra.adjoin A
      {algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0, (algebraMap A K h₁)⁻¹} :=
    Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
  set χ' : ↥(Algebra.adjoin A {s}) →+* A ⧸ 𝔭 := χ.comp (Subalgebra.inclusion hle').toRingHom
    with hχ'
  have hχ'a : ∀ a : A, χ' (algebraMap A _ a) = Ideal.Quotient.mk 𝔭 a := by
    intro a
    show χ ((Subalgebra.inclusion hle') (algebraMap A _ a)) = _
    rw [AlgHom.commutes]; exact hχa a
  have hχ's : χ' ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ = 0 := by
    show χ ((Subalgebra.inclusion hle') ⟨s, _⟩) = 0
    exact hχs
  have hNker : N ≤ RingHom.ker χ' := by
    rw [hN]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro y hy
      rcases hy with rfl | hy
      · rw [SetLike.mem_coe, RingHom.mem_ker, hχ'a, Ideal.Quotient.eq_zero_iff_mem]
        exact hz0𝔭
      · rw [Set.mem_singleton_iff] at hy
        rw [hy, SetLike.mem_coe, RingHom.mem_ker]
        exact hχ's
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show χ' (algebraMap A _ (algebraMap ↥W A w)) = 0
      rw [hχ'a, Ideal.Quotient.eq_zero_iff_mem]
      exact hm𝔭 (Ideal.mem_map_of_mem _ hw)
  have hNne : N ≠ ⊤ := by
    intro htop
    have h1 : (1 : ↥(Algebra.adjoin A {s})) ∈ RingHom.ker χ' :=
      hNker (by rw [htop]; exact Submodule.mem_top)
    rw [RingHom.mem_ker, map_one] at h1
    have h1' : (1 : A) ∈ 𝔭 := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_one]; exact h1
    exact h𝔭max.ne_top ((Ideal.eq_top_iff_one _).mpr h1')
  have hNmax : N.IsMaximal :=
    wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.disc t) z0 b hPD
      (Or.inl ⟨t, c, rfl, hc, rfl⟩) hbm hb0 s rfl hNne

  set ι : A →+* ↥(integralClosure ↥(Algebra.adjoin A {s}) M) :=
    (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).comp
      (algebraMap A ↥(Algebra.adjoin A {s})) with hι
  have hιA : ∀ a : A, ((ι a : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) : M) =
      algebraMap A M a := fun a => (IsScalarTower.algebraMap_apply A K M a).symm
  have hιB : ∀ a : A, ((ι a : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) : M) =
      algebraMap B M (algebraMap A B a) :=
    fun a => (hιA a).trans (IsScalarTower.algebraMap_apply A B M a)

  obtain ⟨𝔮₀, h𝔮₀p, hmB, h𝔮₀le, ht'𝔮₀, h𝔮₀ii, h𝔮₀iii⟩ :=
    wcpa_dj_llsm_smpcgbtinu_fibre_dvr W B 𝔮 t' hPDB
  obtain ⟨gB, gEMD, gMDD, g1, gD, gMD, gE, gDE, gInv, gInt⟩ :=
    wcpa_dj_llsm_smpcgbtinu_gauss_node_ring B M 𝔮₀ 𝔮 t' h𝔮₀p h𝔮max.isPrime h𝔮₀le ht'𝔮 ht'𝔮₀
      h𝔮₀iii
  have hAD : ∀ a : A, algebraMap A M a ∈ wcSmpNuD B M 𝔮₀ 𝔮 := fun a => by
    rw [IsScalarTower.algebraMap_apply A B M]; exact gB _
  have hD1 : (1 : M) ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
    have := gB 1; rwa [map_one] at this
  have hDpow : ∀ z ∈ wcSmpNuD B M 𝔮₀ 𝔮, ∀ i : ℕ, z ^ i ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
    intro z hz i
    induction i with
    | zero => rw [pow_zero]; exact hD1
    | succ i ih => rw [pow_succ]; exact (gD _ ih _ hz).2
  have hE0 : (0 : M) ∈ wcSmpNuE B M 𝔮₀ :=
    ⟨0, 𝔮₀.zero_mem, 1, fun h1 => h𝔮₀p.ne_top ((Ideal.eq_top_iff_one _).mpr h1), by simp⟩
  have hbq0 : algebraMap A B (algebraMap ↥W A b) ∈ 𝔮₀ := by
    rw [← IsScalarTower.algebraMap_apply ↥W A B b]
    exact hmB (Ideal.mem_map_of_mem _ hbm)
  have hz0𝔮 : algebraMap A B z0 ∈ 𝔮 := by
    rw [← Ideal.mem_comap, h𝔮c]; exact hz0𝔭
  have hwit : ∀ β : B, ∃ (k : ℕ) (X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)),
      (X : M) = algebraMap A M h ^ k * algebraMap B M β := by
    intro β
    obtain ⟨k, hk⟩ := (hBint (algebraMap B M β)).mp ⟨β, rfl⟩
    have hk' : IsIntegral ↥(Algebra.adjoin A {s}) (algebraMap A M h ^ k * algebraMap B M β) :=
      IsIntegral.tower_top hk
    exact ⟨k, ⟨_, hk'⟩, rfl⟩
  have hint : (algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) M)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  have hmaxOf : ∀ Q' : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) M), Q'.IsPrime →
      Q'.comap (algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) = N → Q'.IsMaximal := by
    intro Q' hp hcq
    haveI := hp
    exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hint Q' (by rw [hcq]; exact hNmax)

  have core : ∀ Q' : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) M), Q'.IsPrime →
      Q'.comap (algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) = N →
      ∀ x ∈ Q', (x : M) ∈ wcSmpNuMD B M 𝔮₀ 𝔮 := by
    intro Q' hQ'p hQ'c
    have hQ'A : Q'.comap ι = 𝔭 := by
      have e : Q'.comap ι = (Q'.comap (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) M))).comap
            (algebraMap A ↥(Algebra.adjoin A {s})) := rfl
      rw [e, hQ'c]
      exact (h𝔭max.eq_of_le (Ideal.comap_ne_top _ hNne) hle).symm
    have hmemQ' : ∀ a : A, ι a ∈ Q' ↔ a ∈ 𝔭 := fun a => by
      rw [← hQ'A, Ideal.mem_comap]
    have hhQ' : ι h ∉ Q' := fun hh => hh𝔭 ((hmemQ' h).mp hh)

    obtain ⟨P, hPmin, hPQ', hz0P⟩ :=
      wcpa_dj_llsm_fcbu_strict_branch Ω W hW hWt A K M 𝔭 t hPD c b hc hbm hb0 Q' hQ'p hQ'c
    have hPp : P.IsPrime := hPmin.1.1
    have hhP : ι h ∉ P := fun hh => hhQ' (hPQ' hh)
    have hz0P' : ι z0 ∉ P := hz0P
    have hJP : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ι (algebraMap ↥W A w) ∈ P := by
      intro w hw
      apply hPmin.1.2
      apply Ideal.subset_span
      exact ⟨w, hw, rfl⟩

    obtain ⟨𝔮P, h𝔮Pp, -, h𝔮P⟩ :=
      wcpa_dj_llsm_smpcgbtinu_trace_on_B A K M B h s hBint P hPp hhP
    obtain ⟨𝔮Q, h𝔮Qp, h𝔮Qc, h𝔮Q⟩ :=
      wcpa_dj_llsm_smpcgbtinu_trace_on_B A K M B h s hBint Q' hQ'p hhQ'
    have h𝔮Q𝔮 : 𝔮Q = 𝔮 := h𝔮u 𝔮Q h𝔮Qp (by rw [h𝔮Qc]; exact hQ'A)
    have h𝔮Ple : 𝔮P ≤ 𝔮 := by
      intro β hβ
      obtain ⟨k, X, hX⟩ := hwit β
      rw [← h𝔮Q𝔮]
      exact (h𝔮Q β k X hX).mp (hPQ' ((h𝔮P β k X hX).mpr hβ))
    have hmBP : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) ≤ 𝔮P := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap]
      exact (h𝔮P (algebraMap ↥W B w) 0 (ι (algebraMap ↥W A w))
        (by rw [pow_zero, one_mul, hιB, ← IsScalarTower.algebraMap_apply ↥W A B])).mp
        (hJP w hw)
    have hz0X : ((ι z0 : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) : M) =
        algebraMap A M h ^ 0 * algebraMap B M (algebraMap A B z0) := by
      rw [pow_zero, one_mul]; exact hιB z0
    have h𝔮P0 : 𝔮P = 𝔮₀ := by
      refine (h𝔮₀ii 𝔮P h𝔮Pp hmBP h𝔮Ple).resolve_right ?_
      intro heq
      exact hz0P' ((h𝔮P _ 0 (ι z0) hz0X).mpr (by rw [heq]; exact hz0𝔮))
    have hz0q0 : algebraMap A B z0 ∉ 𝔮₀ := by
      intro hin
      exact hz0P' ((h𝔮P _ 0 (ι z0) hz0X).mpr (by rw [h𝔮P0]; exact hin))

    have hsE : algebraMap K M s ∈ wcSmpNuE B M 𝔮₀ := by
      refine ⟨algebraMap A B (algebraMap ↥W A b), hbq0, algebraMap A B z0, hz0q0, ?_⟩
      rw [← IsScalarTower.algebraMap_apply A B M, ← IsScalarTower.algebraMap_apply A B M,
        IsScalarTower.algebraMap_apply A K M z0,
        IsScalarTower.algebraMap_apply A K M (algebraMap ↥W A b), ← map_mul, hsz]

    have hSD : ∀ y : ↥(Algebra.adjoin A {s}), algebraMap K M (y : K) ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
      rintro ⟨y, hy⟩
      show algebraMap K M y ∈ wcSmpNuD B M 𝔮₀ 𝔮
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff.mp hx]; exact gMDD (gEMD hsE)
      | algebraMap a =>
        rw [← IsScalarTower.algebraMap_apply A K M]; exact hAD a
      | add x y _ _ hx hy => rw [map_add]; exact (gD _ hx _ hy).1
      | mul x y _ _ hx hy => rw [map_mul]; exact (gD _ hx _ hy).2
    have hCD : ∀ X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M),
        (X : M) ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
      intro X
      have hXi : IsIntegral ↥(Algebra.adjoin A {s}) (X : M) := X.2
      obtain ⟨p, hpm, hpx⟩ := hXi
      refine gInt (p.map (algebraMap ↥(Algebra.adjoin A {s}) M)) (hpm.map _) (fun i => ?_)
        (X : M) ?_
      · rw [Polynomial.coeff_map]; exact hSD (p.coeff i)
      · rw [Polynomial.eval_map]; exact hpx

    have hCEP : ∀ X : ↥(integralClosure ↥(Algebra.adjoin A {s}) M),
        (X : M) ∈ wcSmpNuE B M 𝔮₀ → X ∈ P := by
      intro X hXE
      obtain ⟨e, he, d, hd, hXd⟩ := hXE
      obtain ⟨kd, Xd, hXd'⟩ := hwit d
      obtain ⟨ke, Xe, hXe'⟩ := hwit e
      have hXeP : Xe ∈ P := (h𝔮P e ke Xe hXe').mpr (by rw [h𝔮P0]; exact he)
      have hXdP : Xd ∉ P := fun hin => hd (by rw [← h𝔮P0]; exact (h𝔮P d kd Xd hXd').mp hin)
      have key : Xd * X * ι h ^ ke = Xe * ι h ^ kd := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, MulMemClass.coe_mul,
          SubmonoidClass.coe_pow]
        rw [hXd', hXe', hιA h, ← hXd]
        ring
      have h1 : Xd * X * ι h ^ ke ∈ P := by rw [key]; exact P.mul_mem_right _ hXeP
      rcases hPp.mem_or_mem h1 with h2 | h2
      · exact (hPp.mem_or_mem h2).resolve_left hXdP
      · exact absurd (hPp.mem_of_pow_mem _ h2) hhP

    intro x hx
    obtain ⟨y, σ, hσ, hxE⟩ := hCD x
    by_cases hy : y ∈ 𝔮
    · exact ⟨y, hy, σ, hσ, hxE⟩
    exfalso
    have hσ0 : algebraMap B M σ ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective B M)).mpr (fun h0 => hσ (h0 ▸ 𝔮.zero_mem))
    set x0 : M := algebraMap B M y / algebraMap B M σ with hx0
    have hx0D : x0 ∈ wcSmpNuD B M 𝔮₀ 𝔮 := by
      rw [hx0, div_eq_mul_inv]; exact (gD _ (gB y) _ (gInv σ hσ)).2
    have hxx0 : (x : M) - x0 ∈ wcSmpNuE B M 𝔮₀ := by
      have e : (x : M) - x0 =
          (algebraMap B M σ)⁻¹ * ((x : M) * algebraMap B M σ - algebraMap B M y) := by
        rw [hx0, mul_sub, mul_comm (algebraMap B M σ)⁻¹ ((x : M) * algebraMap B M σ), mul_assoc,
          mul_inv_cancel₀ hσ0, mul_one, div_eq_inv_mul]
      rw [e]; exact gDE _ (gInv σ hσ) _ hxE
    have hpowE : ∀ i : ℕ, (x : M) ^ i - x0 ^ i ∈ wcSmpNuE B M 𝔮₀ := by
      intro i
      induction i with
      | zero => rw [pow_zero, pow_zero, sub_self]; exact hE0
      | succ i ih =>
        have e : (x : M) ^ (i + 1) - x0 ^ (i + 1) =
            (x : M) * ((x : M) ^ i - x0 ^ i) + x0 ^ i * ((x : M) - x0) := by ring
        rw [e]
        exact gE _ (gDE _ (hCD x) _ ih) _ (gDE _ (hDpow _ hx0D i) _ hxx0)
    obtain ⟨n, α, hα0, hαsum⟩ :=
      wcpa_dj_llsm_smpcgbtinu_local_integral Ω W A M B 𝔭 h 𝔮 t' h𝔭max hSmc y σ hy hσ
    have hgQ : (∑ i ∈ Finset.range (n + 1), ι (α i) * x ^ i) ∈ Q' := by
      refine hPQ' (hCEP _ ?_)
      have hgM : ((∑ i ∈ Finset.range (n + 1), ι (α i) * x ^ i :
          ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) : M) =
          ∑ i ∈ Finset.range (n + 1), algebraMap A M (α i) * ((x : M) ^ i - x0 ^ i) := by
        have e1 : ∑ i ∈ Finset.range (n + 1), algebraMap A M (α i) * ((x : M) ^ i - x0 ^ i) =
            ∑ i ∈ Finset.range (n + 1), algebraMap A M (α i) * (x : M) ^ i -
            ∑ i ∈ Finset.range (n + 1), algebraMap A M (α i) * x0 ^ i := by
          rw [← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl (fun i _ => by ring)
        rw [e1, hαsum, sub_zero, AddSubmonoidClass.coe_finset_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, MulMemClass.coe_mul,
          SubmonoidClass.coe_pow]
        rw [hιA]
      rw [hgM]
      exact Finset.sum_induction _ (· ∈ wcSmpNuE B M 𝔮₀) (fun a b ha hb => gE a ha b hb) hE0
        (fun i _ => gDE _ (hAD _) _ (hpowE i))
    have hrest : (∑ i ∈ Finset.range n, ι (α (i + 1)) * x ^ (i + 1)) ∈ Q' :=
      Ideal.sum_mem _ (fun i _ => Q'.mul_mem_left _ (Ideal.pow_mem_of_mem Q' hx _ (Nat.succ_pos i)))
    have hsplit : (∑ i ∈ Finset.range (n + 1), ι (α i) * x ^ i) =
        (∑ i ∈ Finset.range n, ι (α (i + 1)) * x ^ (i + 1)) + ι (α 0) := by
      rw [Finset.sum_range_succ', pow_zero, mul_one]
    have hα0Q : ι (α 0) ∈ Q' := by
      have := Q'.sub_mem hgQ hrest
      rwa [hsplit, add_sub_cancel_left] at this
    exact hα0 ((hmemQ' (α 0)).mp hα0Q)

  haveI := hNmax.isPrime
  obtain ⟨Q, -, hQp, hQc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
    (S := ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) N ⊥ (by
      intro y hy
      have hy' := Ideal.mem_bot.mp (Ideal.mem_comap.mp hy)
      have h1 : algebraMap K M (y : K) = 0 := congrArg Subtype.val hy'
      have h2 : y = 0 := Subtype.ext ((map_eq_zero_iff _ (algebraMap K M).injective).mp h1)
      rw [h2]; exact N.zero_mem)
  refine ⟨Q, hQp, hQc, fun Q' hQ'p hQ'c => ?_⟩
  have hQm := hmaxOf Q hQp hQc
  have hQ'm := hmaxOf Q' hQ'p hQ'c
  by_contra hne
  have hnle : ¬ Q' ≤ Q := fun hle'' => hne (hQ'm.eq_of_le hQm.ne_top hle'')
  have hlt : Q < Q ⊔ Q' :=
    lt_of_le_of_ne le_sup_left (fun heq => hnle (le_sup_right.trans heq.symm.le))
  have htop : Q ⊔ Q' = ⊤ := hQm.out.2 _ hlt
  have h1 : (1 : ↥(integralClosure ↥(Algebra.adjoin A {s}) M)) ∈ Q ⊔ Q' := by
    rw [htop]; exact Submodule.mem_top
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
  have hsum := gMD _ (core Q hQp hQc y hy) _ (core Q' hQ'p hQ'c z hz)
  have e : (y : M) + (z : M) = 1 := congrArg Subtype.val hyz
  rw [e] at hsum
  exact g1 hsum

theorem wcpa_dj_llsm_smpcgb_two_inner_branches : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (M : Type u) [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [IsGalois K M]
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] [Algebra A B] [Algebra B M]
    [IsFractionRing B M] [IsScalarTower ↥W A B] [IsScalarTower A B M]
    (𝔭 : Ideal A) (t : A) (h : A) (𝔮 : Ideal B) (t' : B),
    wcLlsPD W A 𝔭 (.disc t) → wcLlsSmc W A M B 𝔭 h 𝔮 t' →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ R : List ↥W, (∀ r ∈ R, r ∈ IsLocalRing.maximalIdeal ↥W) →
    (∀ θ : B →ₐ[↥W] ↥W, (IsLocalRing.maximalIdeal ↥W).comap θ = 𝔮 →
      (θ (algebraMap A B t) - c ∣ (R.map (fun r => θ t' - r)).prod ∧
        (R.map (fun r => θ t' - r)).prod ∣ θ (algebraMap A B t) - c)) →
    ∀ x₁ β : ↥W, x₁ ∈ IsLocalRing.maximalIdeal ↥W → β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 →
    b ∣ (R.map (fun r => x₁ - r)).prod → b ∣ (R.map (fun r => x₁ + β - r)).prod →
    ¬ b ∣ (R.map (fun r => @ite _ (β ∣ x₁ - r) (Classical.propDecidable _) β (x₁ - r))).prod →
    ∃ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A
