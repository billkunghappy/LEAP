      (d : K) * (f₀ - (h ^ ℓ - h)) = (e : K)) →
    wcLlsAnnMidSep W A K L u β b :=
by
  intro Ω _ _ W hW hWt ℓ hℓ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g β b hPD hβm hβ0 hbm hb0
    hβb hbβ hbg hK hfin α f₀ h hα1 hf₀ hint
  obtain ⟨d, e, hd, hde⟩ := hint
  obtain ⟨t, rfl⟩ := hβb
  obtain ⟨r, hr⟩ := hbg

  have ht0 : t ≠ 0 := by
    rintro rfl
    exact hb0 (mul_zero β)
  have htm : t ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hcon
    have hu : IsUnit t := (IsLocalRing.notMem_maximalIdeal).mp hcon
    obtain ⟨t', ht'⟩ := hu.exists_right_inv
    exact hbβ ⟨t', by rw [mul_assoc, ht', mul_one]⟩
  have hqm : t * r ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right r _ htm
  have hgq : g = β * (t * r) := hr.trans (mul_assoc β t r)
  have htq : t ∣ t * r := dvd_mul_right t r

  obtain ⟨_, hNZ, _, hmax, _, _, hg0, huv, h𝔭, _⟩ := id hPD
  have := hNZ

  obtain ⟨A₃, _, _, _, _, _, _, _, u₃, v₃, 𝔭₃, hBr, hu₃, hv₃, hPD₃, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K L 𝔭 u v g β (t * r) hPD hβm hβ0 hqm hgq

  have hiff := wcpa_dj_llsm_isi_chart_transport Ω W hW hWt A K L 𝔭 u v g β (t * r) t A₃ u₃ v₃
    𝔭₃ hPD hβm hβ0 hqm hgq hBr hu₃ hv₃ hPD₃ htm ht0 htq
  obtain ⟨hBrW, hBrR, -⟩ := id hBr

  suffices hgoal : wcLlsAnnSep W A₃ K L u₃ t from hiff.mp hgoal
  by_cases hN : wcLlsASbN W A₃ K u₃ t = ⊤
  ·
    delta wcLlsAnnSep wcLlsSepAt
    intro 𝔮 _ h𝔮
    have h1 := h𝔮.trans hN
    exact absurd h1 (Ideal.IsPrime.ne_top inferInstance)


  have hWK : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h0
    have h1 : algebraMap ↥W A x = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hx h2
    · exact one_ne_zero h2
  have huK : algebraMap A K u ≠ 0 := by
    intro h0
    have hu0 : u = 0 := (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    apply hWK g hg0
    rw [← huv, hu0, zero_mul, map_zero]

  have hN1 : (⟨algebraMap A K u / algebraMap A K (algebraMap ↥W A β),
      Algebra.subset_adjoin (Set.mem_insert _ _)⟩ : ↥(wcLlsASmS W A K u β (β * t))) ∈
      wcLlsASmN W A K u β (β * t) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hN2 : (⟨algebraMap A K (algebraMap ↥W A (β * t)) / algebraMap A K u,
      Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
        ↥(wcLlsASmS W A K u β (β * t))) ∈ wcLlsASmN W A K u β (β * t) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

  have hρu : algebraMap A ↥(wcLlsASmS W A K u β (β * t)) u ∈ wcLlsASmN W A K u β (β * t) := by
