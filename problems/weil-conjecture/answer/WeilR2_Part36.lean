      F.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) := by
    intro Z F
    have := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, ← this]

  have hnot1 : y ∉ U 1 := by
    intro hy1
    apply hND
    have h10 := hU.2.2.1 1 0
    have hgermLE : ∀ a : Γ(Spec (.of (MvPolynomial (Fin 1) ↥W)), ⊤),
        (M'.presheaf.germ (U 1) y hy1).hom ((rM.appLE ⊤ (U 1) (by simp)).hom a) =
