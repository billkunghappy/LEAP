  have hCL : ∀ {Y P : Scheme.{u}} (r : P ⟶ Y) (T B : Γ(Y, ⊤)) (U : Fin 2 → P.Opens)
      (t : ∀ l : Fin 2, Fin 2 → Γ(P, U l)), wcBpChartHyp r ![T, B] U t → ∀ ρ : ↥P,
      (¬ ∃ ψ : ↥(P.presheaf.stalk ρ), (P.presheaf.germ ⊤ ρ trivial).hom (r.appTop.hom T) =
