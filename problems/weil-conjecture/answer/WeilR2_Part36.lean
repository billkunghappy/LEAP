  have hιinj : Function.Injective (algebraMap B M) := IsFractionRing.injective B M
  have hunit : ∀ y : ↥W, y ∉ IsLocalRing.maximalIdeal ↥W → IsUnit y := by
    intro y hy
    by_contra hu
    exact hy ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hu))
  have hq : ∀ y : ↥W, algebraMap ↥W B y ∈ 𝔮 ↔ y ∈ IsLocalRing.maximalIdeal ↥W := by
