theorem wcpa_dj_lr1k_nsr_ub_tcul_chart_rad : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) [QuasiSeparated uX] (x : ↥X)
      (σ₀ : Spec (.of ↥W) ⟶ X), σ₀ ≫ uX = 𝟙 _ → σ₀ (IsLocalRing.closedPoint ↥W) = x →
    ∀ (U : X.Opens) (hU : IsAffineOpen U) (g : Γ(X, U)), x ∈ U → (σ₀.app U).hom g = 0 →
      (∀ a : ↥W, (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a).ideal ⟨U, hU⟩ =
        Ideal.span {g, wcGcfStr uX U a}) →
    ∀ (a : ↥W), a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (Xa : Scheme.{u}) (ra : Xa ⟶ X),
      wcCsdIsBlowup (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) ra →
    ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (f : C ⟶ X) (f' : C ⟶ Xa), f' ≫ ra = f →
    ∀ (hgen : genericPoint C ∈ f ⁻¹ᵁ U) (z : ↥Xa), ra z = x →
    ∀ A : ValuationSubring C.functionField, wcNsrCentred f' z A →
      A.valuation ((C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint C) hgen).hom
          ((f.app U).hom (wcGcfStr uX U a))) <
        A.valuation ((C.presheaf.germ (f ⁻¹ᵁ U) (genericPoint C) hgen).hom ((f.app U).hom g)) →
    ∃ (U₁ : Xa.Opens) (_ : IsAffineOpen U₁) (hz : z ∈ U₁) (e : U₁ ≤ ra ⁻¹ᵁ U) (S : Γ(Xa, U₁)),
      (ra.appLE U U₁ e).hom (wcGcfStr uX U a) = S * (ra.appLE U U₁ e).hom g ∧
      wcTcRad W (ra ≫ uX) z ![(Xa.presheaf.germ U₁ z hz).hom ((ra.appLE U U₁ e).hom g),
        (Xa.presheaf.germ U₁ z hz).hom S] :=
by
  intro Ω _ W hW hWt X uX _ x σ₀ hσ hσx U hU g hxU hσg hideal a ha0 ham Xa ra hbl C _ f f' hff
    hgen z hzx A hA hlt
  classical

  have s1 : ∀ c : ↥W, c ≠ 0 → ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ k : ℕ, c ∣ w ^ k := by
    intro c hc w hw
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hrad : w ∈ (Ideal.span {c}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hJc, hJp⟩
      rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
      · exfalso
        have hJ : J = ⊥ := le_bot_iff.mp (h.2 ⟨Ideal.isPrime_bot, le_refl _⟩ bot_le)
        apply hc
        have hcJ : c ∈ J := hJc (Ideal.subset_span rfl)
        rw [hJ] at hcJ
        exact (Submodule.mem_bot _).mp hcJ
      · rw [IsLocalRing.eq_maximalIdeal h]; exact hw
    obtain ⟨k, hk⟩ := hrad
    exact ⟨k, Ideal.mem_span_singleton.mp hk⟩

  have s2 : ∀ {R R₁ : Type u} [CommRing R] [CommRing R₁] (φ : R →+* R₁) (S : R₁),
      (∀ t : R₁, t ∈ Subring.closure (Set.range φ ∪ {S})) →
      ∀ t : R₁, ∃ (α : R) (w : R₁), t = φ α + S * w := by
    intro R R₁ _ _ φ S hcl t
    have ht := hcl t
    induction ht using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨r, hr⟩ | hx
      · exact ⟨r, 0, by rw [hr, mul_zero, add_zero]⟩
      · rw [Set.mem_singleton_iff] at hx
        exact ⟨0, 1, by rw [hx, map_zero, zero_add, mul_one]⟩
    | zero => exact ⟨0, 0, by rw [map_zero, mul_zero, add_zero]⟩
    | one => exact ⟨1, 0, by rw [map_one, mul_zero, add_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨α, w, hαw⟩ := hx
      obtain ⟨α', w', hαw'⟩ := hy
      exact ⟨α + α', w + w', by rw [hαw, hαw', map_add]; ring⟩
    | neg x _ hx =>
      obtain ⟨α, w, hαw⟩ := hx
      exact ⟨-α, -w, by rw [hαw, map_neg]; ring⟩
    | mul x y _ _ hx hy =>
      obtain ⟨α, w, hαw⟩ := hx
      obtain ⟨α', w', hαw'⟩ := hy
      exact ⟨α * α', w * φ α' + φ α * w' + S * w * w', by rw [hαw, hαw', map_mul]; ring⟩

  have s3 : ∀ {R R₁ O K : Type u} [CommRing R] [CommRing R₁] [CommRing O] [IsLocalRing O]
      [CommRing K] [IsLocalRing K]
      (θ : R →+* K) (ε : K →+* R) (φ : R →+* R₁) (γ : R₁ →+* O) (g : R) (S : R₁) (c : K),
      (∀ w : K, θ (ε w) = w) → RingHom.ker θ = Ideal.span {g} →
      (∀ w ∈ IsLocalRing.maximalIdeal K, ∃ k : ℕ, c ∣ w ^ k) →
      (∀ t : R₁, ∃ (α : R) (w : R₁), t = φ α + S * w) →
      γ (φ g) ∈ IsLocalRing.maximalIdeal O → γ S ∈ IsLocalRing.maximalIdeal O →
      (∀ y : O, ∃ t u : R₁, IsUnit (γ u) ∧ y * γ u = γ t) →
      ∀ y ∈ IsLocalRing.maximalIdeal O, ∃ k : ℕ,
        y ^ k ∈ Ideal.span {γ (φ g), γ S, γ (φ (ε c))} := by
    intro R R₁ O K _ _ _ _ _ _ θ ε φ γ g S c hθε hker hdiv hdec hg hS hfr y hy
    set J := Ideal.span {γ (φ g), γ S, γ (φ (ε c))} with hJ
    have hgJ : γ (φ g) ∈ J := Ideal.subset_span (by simp)
    have hSJ : γ S ∈ J := Ideal.subset_span (by simp)
    have hcJ : γ (φ (ε c)) ∈ J := Ideal.subset_span (by simp)
    have hkerm : ∀ r : R, θ r = 0 → ∃ q : R, r = q * g := by
      intro r hr
      have hr' : r ∈ Ideal.span {g} := by rw [← hker]; exact hr
      obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp hr'
      exact ⟨q, hq.symm⟩
    have ha : ∀ α : R, γ (φ α) ∈ IsLocalRing.maximalIdeal O →
        θ α ∈ IsLocalRing.maximalIdeal K := by
      intro α hα
      by_contra hn
      have hu : IsUnit (θ α) := by
        by_contra h'
        exact hn ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h'))
      obtain ⟨q, hq⟩ := hkerm (α - ε (θ α)) (by rw [map_sub, hθε, sub_self])
      have e : α = ε (θ α) + q * g := by rw [← hq]; ring
      have e' := congrArg (fun r => γ (φ r)) e
      simp only [map_add, map_mul] at e'
      have hu' : IsUnit (γ (φ (ε (θ α)))) := hu.map ((γ.comp φ).comp ε)
      have hn' : γ (φ q) * γ (φ g) ∈ IsLocalRing.maximalIdeal O := Ideal.mul_mem_left _ _ hg
      have hm : γ (φ (ε (θ α))) ∈ IsLocalRing.maximalIdeal O := by
        have h1 := Ideal.sub_mem _ hα hn'
        rwa [e', add_sub_cancel_right] at h1
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hm) hu'
    have hb : ∀ α : R, γ (φ α) ∈ IsLocalRing.maximalIdeal O → ∃ k : ℕ, γ (φ α) ^ k ∈ J := by
      intro α hα
      obtain ⟨k, w', hw'⟩ := hdiv _ (ha α hα)
      obtain ⟨q, hq⟩ := hkerm (α ^ k - ε c * ε w')
        (by rw [map_sub, map_pow, map_mul, hθε, hθε, hw', sub_self])
      refine ⟨k, ?_⟩
      have e : α ^ k = ε c * ε w' + q * g := by rw [← hq]; ring
      have e' := congrArg (fun r => γ (φ r)) e
      simp only [map_add, map_mul, map_pow] at e'
      rw [e']
      exact J.add_mem (J.mul_mem_right _ hcJ) (J.mul_mem_left _ hgJ)
    have hc : ∀ t : R₁, γ t ∈ IsLocalRing.maximalIdeal O → ∃ k : ℕ, γ t ^ k ∈ J := by
      intro t ht
      obtain ⟨α, w, htw⟩ := hdec t
      have e : γ t = γ (φ α) + γ S * γ w := by rw [htw, map_add, map_mul]
      have hα : γ (φ α) ∈ IsLocalRing.maximalIdeal O := by
        have h1 := Ideal.sub_mem _ ht (Ideal.mul_mem_right (γ w) _ hS)
        rwa [e, add_sub_cancel_right] at h1
      obtain ⟨k, hk⟩ := hb α hα
      refine ⟨k, ?_⟩
      obtain ⟨d, hd⟩ := sub_dvd_pow_sub_pow (γ t) (γ (φ α)) k
      have hsub : γ t - γ (φ α) = γ S * γ w := by rw [e]; ring
      have h2 : γ t ^ k = γ (φ α) ^ k + γ S * γ w * d := by
        rw [← hsub]; linear_combination hd
      rw [h2]
      exact J.add_mem hk (J.mul_mem_right _ (J.mul_mem_right _ hSJ))
    obtain ⟨t, u, hu, hyu⟩ := hfr y
    have ht : γ t ∈ IsLocalRing.maximalIdeal O := by
      rw [← hyu]; exact Ideal.mul_mem_right _ _ hy
    obtain ⟨k, hk⟩ := hc t ht
    refine ⟨k, ?_⟩
    obtain ⟨v, hv⟩ := (hu.pow k).exists_right_inv
    have h3 : y ^ k = γ t ^ k * v := by rw [← hyu, mul_pow, mul_assoc, hv, mul_one]
    rw [h3]
    exact J.mul_mem_right _ hk

  have T_appLE_germ : ∀ (C Z : Scheme.{u}) (k : C ⟶ Z) (O : Z.Opens) (W' : C.Opens)
      (e : W' ≤ k ⁻¹ᵁ O) (x : C) (hx : x ∈ W') (t : Γ(Z, O)),
      (C.presheaf.germ W' x hx).hom ((k.appLE O W' e).hom t) =
        (C.presheaf.germ (k ⁻¹ᵁ O) x (e hx)).hom ((k.app O).hom t) := by
    intro C Z k O W' e x hx t
    rw [Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply,
      TopCat.Presheaf.germ_res_apply]
  have T_germ_point : ∀ (Y : Scheme.{u}) (f : C ⟶ Y) (y : Y)
      (hy : f (genericPoint C) ⤳ y) (V : Y.Opens) (hyV : y ∈ V)
      (hV : genericPoint C ∈ f ⁻¹ᵁ V) (s : Γ(Y, V)),
      (wcLr1uGerm f y hy).hom ((Y.presheaf.germ V y hyV).hom s) =
        (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hV).hom ((f.app V).hom s) := by
    intro Y f y hy V hyV hV s
    rw [wcLr1uGerm, CommRingCat.hom_comp, RingHom.comp_apply,
      TopCat.Presheaf.germ_stalkSpecializes_apply]
    exact Scheme.Hom.germ_stalkMap_apply f V (genericPoint C) hV s
  have T_germ_comp : ∀ (Y X : Scheme.{u}) (f : C ⟶ Y) (r : Y ⟶ X) (f' : C ⟶ X),
      f ≫ r = f' → ∀ (U : X.Opens) (V : Y.Opens) (e : V ≤ r ⁻¹ᵁ U)
      (hV : genericPoint C ∈ f ⁻¹ᵁ V) (hU : genericPoint C ∈ f' ⁻¹ᵁ U) (s : Γ(X, U)),
      (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hV).hom
          ((f.app V).hom ((r.appLE U V e).hom s)) =
        (C.presheaf.germ (f' ⁻¹ᵁ U) (genericPoint C) hU).hom ((f'.app U).hom s) := by
    intro Y X f r f' hf U V e hV hU s
    subst hf
    have key := congrArg (fun φ => φ.hom s)
      (Scheme.Hom.appLE_comp_appLE f r U V (f ⁻¹ᵁ V) e le_rfl)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key
    rw [Scheme.Hom.app_eq_appLE f, key, T_appLE_germ]

  have hgz : ∀ (U₁ : Xa.Opens) (e : U₁ ≤ ra ⁻¹ᵁ U) (hz₁ : z ∈ U₁),
      (Xa.presheaf.germ U₁ z hz₁).hom ((ra.appLE U U₁ e).hom g) ∈
        IsLocalRing.maximalIdeal (Xa.presheaf.stalk z) := by
    intro U₁ e hz₁
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h1 : z ∈ Xa.basicOpen ((ra.appLE U U₁ e).hom g) := (Scheme.mem_basicOpen _ _ _ hz₁).mpr hu
    rw [Scheme.basicOpen_appLE] at h1
    have h2 : z ∈ ra ⁻¹ᵁ X.basicOpen g :=
      (inf_le_right : U₁ ⊓ ra ⁻¹ᵁ X.basicOpen g ≤ ra ⁻¹ᵁ X.basicOpen g) h1
    have h3 : σ₀ (IsLocalRing.closedPoint ↥W) ∈ X.basicOpen g := by
      rw [hσx, ← hzx]; exact h2
    have h4 : IsLocalRing.closedPoint ↥W ∈ σ₀ ⁻¹ᵁ X.basicOpen g := h3
    have h5 : IsLocalRing.closedPoint ↥W ∈ (Spec (.of ↥W)).basicOpen ((σ₀.app U).hom g) :=
      (Scheme.preimage_basicOpen σ₀ g).le h4
    have h6 : (Spec (.of ↥W)).basicOpen ((σ₀.app U).hom g) = ⊥ := by rw [hσg]; simp
    have h7 : IsLocalRing.closedPoint ↥W ∈ (⊥ : (Spec (.of ↥W)).Opens) := h6 ▸ h5
    exact h7

  have etop : ⊤ ≤ σ₀ ⁻¹ᵁ U := by
    intro p _
    show σ₀ p ∈ U
    exact ((IsLocalRing.specializes_closedPoint p).map σ₀.continuous).mem_open U.isOpen
      (by rw [hσx]; exact hxU)
  have hle : U ≤ uX ⁻¹ᵁ ⊤ := by simp
  obtain ⟨θ, hθdef⟩ : ∃ θ : Γ(X, U) →+* ↥W,
      θ = ((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (σ₀.appLE U ⊤ etop).hom := ⟨_, rfl⟩
