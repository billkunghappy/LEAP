  letI : Algebra (Localization.Away p) F := lam'.toAlgebra
  haveI : IsDomain (Localization.Away p) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hp0)
  haveI : IsIntegrallyClosed (Localization.Away p) :=
    isIntegrallyClosed_of_isLocalization (Localization.Away p) (Submonoid.powers p)
