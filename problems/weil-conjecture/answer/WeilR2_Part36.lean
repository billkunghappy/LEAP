  have hPm : (minpoly (Localization.Away p) xb).Monic := minpoly.monic hxi
  have hP0 : (minpoly (Localization.Away p) xb).eval₂ lam' xb = 0 := by
    have := minpoly.aeval (Localization.Away p) xb
    rwa [Polynomial.aeval_def] at this
  have himg' : ∀ t : T, ∃ c : Ch, ρ c = lam' (algebraMap T (Localization.Away p) t) := fun t => by
    rw [hcomp]; exact himg t
  obtain ⟨i, hi⟩ := s2 T (Localization.Away p) F Ch (algebraMap T _) lam' ρ himg'
    (minpoly (Localization.Away p) xb) xb hPm hP0 hbad
  obtain ⟨ev, ev', hevs, hevp, hev', hbadval⟩ := s3 T V p π hπ hgauss _ hi
