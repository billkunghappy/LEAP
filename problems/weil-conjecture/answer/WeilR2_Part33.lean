  have hb'm : b' ∈ IsLocalRing.maximalIdeal ↥W := hb' ▸ Ideal.mul_mem_right q' _ hr
  obtain ⟨hJne, hidem⟩ := wcpa_dj_llsm_scdc_fibre_connected Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU
    c' b' hc' hb'm hb'0 hs'

  have hPD' := hPD
  obtain ⟨-, hNZ, -, h𝔭max, -, -, h𝔭eq, -⟩ := hPD'
  have hε : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    have h1 : algebraMap ↥W A w = 0 :=
      (IsFractionRing.injective A K) (by rw [h, map_zero])
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hw h2
    · exact one_ne_zero h2
  have hq'0 : q' ≠ 0 := by rintro rfl; exact hb'0 (by rw [hb', mul_zero])
  have hSU : wcLlsScS W A K t c' r =
      algebraMap A K (algebraMap ↥W A q') * wcLlsScS W A K t c' b' := by
    unfold wcLlsScS
    rw [hb', map_mul, map_mul]
    have h1 := hε r hr0
    have h2 := hε q' hq'0
    field_simp
  have hSmem : wcLlsScS W A K t c' r ∈ Algebra.adjoin A {wcLlsScS W A K t c' b'} := by
    rw [hSU]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin (Set.mem_singleton _))
  have hle : Algebra.adjoin A {wcLlsScS W A K t c' r} ≤
      Algebra.adjoin A {wcLlsScS W A K t c' b'} :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr hSmem)
  let ι : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L) →+*
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) :=
    ((integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L).val.toRingHom).codRestrict
      (integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
      (fun z => IsIntegral.map_of_comp_eq (Subalgebra.inclusion hle).toRingHom (RingHom.id L)
        (RingHom.ext fun _ => rfl) z.2)
  have hι : ∀ z, ((ι z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)) : L) =
      (z : L) := fun z => rfl
  have hgen : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A w)) ∈
        wcLlsScJ W A K L t c' b' := by
    intro w hw
    apply Ideal.le_radical
    apply Ideal.subset_span
    exact ⟨w, hw, rfl⟩
  have hfibN : ∀ P : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
      P.IsPrime → wcLlsScJ W A K L t c' b' ≤ P →
      wcLlsScN W A K t c' r ≤ (P.comap ι).comap
        (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) := by
    intro P hP hJP
    unfold wcLlsScN
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
        Ideal.mem_comap]
      have e : ι (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
            ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩) =
          algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A q')) *
          algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
