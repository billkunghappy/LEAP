        ext r; rfl
      have hD0 : Polynomial.eval₂ ι (x ^ k) Q' = 0 := by
        apply D.subtype_injective
        rw [Polynomial.hom_eval₂, hι, map_zero, map_pow]
        exact hQ'eval
      have hnd : Q'.natDegree = q.natDegree := Polynomial.natDegree_scaleRoots _ _
      rw [Polynomial.eval₂_eq_sum_range, hnd, Finset.sum_range_succ,
        Polynomial.coeff_scaleRoots, hqm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one,
        map_one, one_mul] at hD0
      have hxd : (x ^ k) ^ q.natDegree =
