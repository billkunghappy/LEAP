    obtain ⟨O, hRO, hzO⟩ := Subring.exists_le_valuationSubring_of_isIntegrallyClosedIn hzR
    have key : ∀ x : K, algebraMap K L x ∈ O → IsIntegral ↥(Algebra.adjoin A {x}) z → z ∈ O := by
      intro x hxO hzx
      have hmem : ∀ y ∈ Algebra.adjoin A {x}, algebraMap K L y ∈ O := by
