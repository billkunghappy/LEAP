      (h𝔫 (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))))
    have hN𝔫 : N't ^ N ∈ 𝔫 :=
      h𝔫 (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
    have hwt𝔫 : ∀ μ ∈ IsLocalRing.maximalIdeal ↥W, wt μ ∈ 𝔫 := fun μ hμ =>
      hin (wt μ) (by rw [cW]; exact hwM μ hμ)
    have hτ𝔫 : algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c')) ∈ 𝔫 := by
      apply hin
      show algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) ∈ MS
      rw [hτL, mul_comm]
      exact hMmul _ _ huP (hwM b' hb')
    obtain ⟨_, _, _, hmax, _, _, h𝔭eq, _⟩ := hPD

    have hNle : wcLlsScNV W A K t c' b' ≤ 𝔫.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) := by
      unfold wcLlsScNV
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro z hz
        rcases hz with rfl | rfl
        · exact hτ𝔫
        · rw [SetLike.mem_coe, Ideal.mem_comap, ← hVt]; exact hV𝔫
      · rw [Ideal.map_le_iff_le_comap]
        intro μ hμ
        rw [Ideal.mem_comap, Ideal.mem_comap]
        have := hwt𝔫 μ hμ
        rw [hwt] at this
        exact this
    have h𝔭N : ∀ a ∈ 𝔭, algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a ∈
        wcLlsScNV W A K t c' b' := by
      intro a ha
      rw [← Ideal.mem_comap]
      revert a
      show 𝔭 ≤ _
      rw [h𝔭eq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e2 : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
            algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
            algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A c') := by
          rw [← map_add, sub_add_cancel]
        rw [e2]
        unfold wcLlsScNV
        exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc'))
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_comap]
        unfold wcLlsScNV
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hx)
    have hcomapA : Ideal.comap (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}))
        (𝔫.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L))) = 𝔭 := by
      symm
      apply hmax.eq_of_le
      · haveI := h𝔫max.isPrime
        exact (Ideal.IsPrime.comap _).ne_top
      · intro a ha
        rw [Ideal.mem_comap]
        exact hNle (h𝔭N a ha)
    have hdecomp : ∀ z : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}), ∃ (a : A)
        (z₁ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})),
        z = algebraMap A _ a + ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ * z₁ := by
      intro z
      have key : ∀ x (hx : x ∈ Algebra.adjoin A {wcLlsScV W A K t c' b'}), ∃ (a : A)
          (z₁ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})),
          x = algebraMap A K a + wcLlsScV W A K t c' b' * (z₁ : K) := by
        intro x hx
        induction hx using Algebra.adjoin_induction with
        | mem x hx =>
          rw [Set.mem_singleton_iff.mp hx]
          exact ⟨0, 1, by simp⟩
        | algebraMap a => exact ⟨a, 0, by simp⟩
        | add x y _ _ hx hy =>
          obtain ⟨a, z₁, rfl⟩ := hx
          obtain ⟨b, z₂, rfl⟩ := hy
          exact ⟨a + b, z₁ + z₂, by
            simp only [map_add, Subalgebra.coe_add]; ring⟩
        | mul x y _ _ hx hy =>
          obtain ⟨a, z₁, rfl⟩ := hx
          obtain ⟨b, z₂, rfl⟩ := hy
          refine ⟨a * b, algebraMap A _ a * z₂ + algebraMap A _ b * z₁ +
            ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ * z₁ * z₂, ?_⟩
          simp only [map_mul, Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
          ring
      obtain ⟨a, z₁, hz⟩ := key z z.2
      exact ⟨a, z₁, Subtype.ext (by push_cast; exact hz)⟩
    have hge : 𝔫.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) ≤
        wcLlsScNV W A K t c' b' := by
      intro z hz
      obtain ⟨a, z₁, rfl⟩ := hdecomp z
      have hVz : (⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
          ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) * z₁ ∈ wcLlsScNV W A K t c' b' := by
        unfold wcLlsScNV
        exact Ideal.mul_mem_right _ _ (Ideal.mem_sup_left (Ideal.subset_span
          (Set.mem_insert_of_mem _ rfl)))
      have ha : algebraMap A _ a ∈ 𝔫.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) := by
        have := Ideal.sub_mem _ hz (hNle hVz)
        rwa [add_sub_cancel_right] at this
      have ha' : a ∈ 𝔭 := by rw [← hcomapA, Ideal.mem_comap]; exact ha
      exact Ideal.add_mem _ (h𝔭N a ha') hVz
    have heq := hwU 𝔫 h𝔫max.isPrime (le_antisymm hge hNle)
    rw [heq] at hN𝔫
    exact hN'w ((inferInstance : w.IsPrime).mem_of_pow_mem N hN𝔫)
  have h1I : (1 : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) ∈
      Ideal.span {Vt ^ K₁, N't ^ N} ⊔ MI := by rw [hItop]; exact Submodule.mem_top
  obtain ⟨y₁, hy₁, z₂, hz₂, hyz⟩ := Submodule.mem_sup.1 h1I
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.1 hy₁
  have e1 : (1 : L) = (a : L) * vL ^ K₁ + (b : L) * (N't : L) ^ N + (z₂ : L) := by
    have hsum : a * Vt ^ K₁ + b * N't ^ N + z₂ = 1 := by rw [hab]; exact hyz
    have := congrArg (fun z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) =>
      (z : L)) hsum
    simp only [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_one,
      cV] at this
    exact this.symm
  obtain ⟨hVv, hhV⟩ : ∃ hVv : L, hVv = (a : L) * (vL ^ K₁ * (vL ^ N * rx)) + (b : L) * (wL ε ^ N * nn) :=
    ⟨_, rfl⟩
  have hVB : hVv ∈ BV := by
    rw [hhV]
    exact BV.add_mem (BV.mul_mem ((hBV _).2 a.2) hK₁)
      (BV.mul_mem ((hBV _).2 b.2) (BV.mul_mem (BV.pow_mem (hwBV ε) N) hnnB))
  have hfin : vL ^ N * rx - hVv ∈ MS := by
    have := MS.add_mem (hMmul (b : L) _ (hBP _ ((hBV _).2 b.2)) hB6)
      (hMmul (vL ^ N * rx) _ hfP ((hMI z₂).1 hz₂))
    convert this using 1
    rw [hhV]
    linear_combination (vL ^ N * rx) * e1
  have htot := MS.add_mem hstep5 hfin
  obtain ⟨β, h', hβ, hh', heq⟩ := (hMS _).1 htot
  refine ⟨β, h', wL ε ^ N * qx, hVv, hβ, toP _ hh', (hBU _).1 hULB, (hBV _).1 hVB, ?_⟩
  rw [← hwL]
  linear_combination heq

theorem wcpa_dj_llsm_sccas_ctu_h1_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → wcLlsScDF W A K L t c' b' →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w →
        wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 1 →
        ∀ 𝔷 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
          𝔷.IsPrime → 𝔷 ≤ w →
          (∀ x ∈ IsLocalRing.maximalIdeal ↥W,
            algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A x)) ∈ 𝔷) →
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔷 →
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∉ 𝔷 →
          ∃ (r : ℕ) (e : Fin r → L),
            (∀ i, ∃ k : ℕ, algebraMap K L (wcLlsScV W A K t c' b') ^ k * e i ∈
              integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) ∧
            ∀ h : L, (∃ k : ℕ, algebraMap K L (wcLlsScV W A K t c' b') ^ k * h ∈
                integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) →
              ∃ (s : ↥(integralClosure A L)) (a : Fin r → ↥(integralClosure A L)) (hU hV : L),
                s ∉ y ∧ hU ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L ∧
                hV ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L ∧
                (s : L) * h = ∑ i, (a i : L) * e i + hU + hV :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb' hb0 hs hDF
    w _ hwc hwU hbr 𝔷 h𝔷P h𝔷w h𝔷m h𝔷V h𝔷τ
  classical

  have shift_poly : ∀ (u v : K), u * v = 1 → ∀ c : K, c ∈ Algebra.adjoin A {v} →
      ∃ D : ℕ, ∀ D' : ℕ, D ≤ D' → u ^ D' * c ∈ Algebra.adjoin A {u} := by
    intro u v huv c hc
    induction hc using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      refine ⟨1, fun D' hD' => ?_⟩
      obtain ⟨E, rfl⟩ := Nat.exists_eq_add_of_le hD'
      rw [add_comm, pow_succ, mul_assoc, huv, mul_one]
      exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton _)) _
    | algebraMap a =>
      exact ⟨0, fun D' _ => Subalgebra.mul_mem _
        (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton _)) _)
        (Subalgebra.algebraMap_mem _ a)⟩
    | add x y _ _ hx hy =>
      obtain ⟨D1, h1⟩ := hx
      obtain ⟨D2, h2⟩ := hy
      exact ⟨max D1 D2, fun D' hD' => by
        rw [mul_add]
        exact add_mem (h1 D' (le_of_max_le_left hD')) (h2 D' (le_of_max_le_right hD'))⟩
    | mul x y _ _ hx hy =>
      obtain ⟨D1, h1⟩ := hx
      obtain ⟨D2, h2⟩ := hy
      refine ⟨D1 + D2, fun D' hD' => ?_⟩
      obtain ⟨E, rfl⟩ := Nat.exists_eq_add_of_le hD'
      have : u ^ (D1 + D2 + E) * (x * y) = (u ^ D1 * x) * (u ^ (D2 + E) * y) := by ring
      rw [this]
      exact Subalgebra.mul_mem _ (h1 D1 le_rfl) (h2 _ (Nat.le_add_right _ _))

  have laurent_split : ∀ (u v : K), u * v = 1 → ∀ (k N : ℕ) (c : K), c ∈ Algebra.adjoin A {v} →
      ∃ (a : Fin N → A) (p q : K), p ∈ Algebra.adjoin A {u} ∧ q ∈ Algebra.adjoin A {v} ∧
        u ^ k * c = ∑ j : Fin N, algebraMap A K (a j) * u ^ (j : ℕ) + u ^ N * p + q := by
    intro u v huv k N c hc
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hc
    obtain ⟨P, rfl⟩ := hc
    induction P using Polynomial.induction_on' with
    | add P Q hP hQ =>
      obtain ⟨a1, p1, q1, hp1, hq1, e1⟩ := hP
      obtain ⟨a2, p2, q2, hp2, hq2, e2⟩ := hQ
      refine ⟨a1 + a2, p1 + p2, q1 + q2, add_mem hp1 hp2, add_mem hq1 hq2, ?_⟩
      rw [map_add, mul_add, e1, e2]
      simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      ring
    | monomial n α =>
      rw [Polynomial.aeval_monomial]
      by_cases hnk : k < n
      · refine ⟨0, 0, algebraMap A K α * v ^ (n - k), Subalgebra.zero_mem _,
          Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ α)
            (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton _)) _), ?_⟩
        have key : u ^ k * v ^ n = v ^ (n - k) := by
          conv_lhs => rw [show n = k + (n - k) by omega]
          rw [pow_add, ← mul_assoc, ← mul_pow, huv, one_pow, one_mul]
        simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero, mul_zero, zero_add]
        linear_combination (algebraMap A K α) * key
      · push Not at hnk
        have key : u ^ k * v ^ n = u ^ (k - n) := by
          conv_lhs => rw [show k = (k - n) + n by omega]
          rw [pow_add, mul_assoc, ← mul_pow, huv, one_pow, mul_one]
        by_cases hkN : k - n < N
        · refine ⟨fun j : Fin N => if (j : ℕ) = k - n then α else 0, 0, 0, Subalgebra.zero_mem _,
            Subalgebra.zero_mem _, ?_⟩
          have hs : ∑ j : Fin N, algebraMap A K (if (j : ℕ) = k - n then α else 0) * u ^ (j : ℕ)
              = algebraMap A K α * u ^ (k - n) := by
            rw [Finset.sum_eq_single (⟨k - n, hkN⟩ : Fin N)]
            · simp
            · intro b _ hb
              have : (b : ℕ) ≠ k - n := fun h => hb (Fin.ext h)
              simp [this]
            · intro h
              exact absurd (Finset.mem_univ _) h
          rw [hs, mul_zero, add_zero, add_zero]
          linear_combination (algebraMap A K α) * key
        · push Not at hkN
          refine ⟨0, algebraMap A K α * u ^ (k - n - N), 0,
            Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ α)
              (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton _)) _),
            Subalgebra.zero_mem _, ?_⟩
          have key2 : u ^ (k - n) = u ^ N * u ^ (k - n - N) := by
            rw [← pow_add]
            congr 1
            omega
          simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero, zero_add, add_zero]
          linear_combination (algebraMap A K α) * key + (algebraMap A K α) * key2

  have shift_integral : ∀ (u v : K),
      (∀ c : K, c ∈ Algebra.adjoin A {v} → ∃ D : ℕ, ∀ D' : ℕ, D ≤ D' →
        u ^ D' * c ∈ Algebra.adjoin A {u}) →
      ∀ x : L, IsIntegral ↥(Algebra.adjoin A {v}) x →
        ∃ N : ℕ, ∀ j : ℕ, N ≤ j →
          IsIntegral ↥(Algebra.adjoin A {u}) (algebraMap K L u ^ j * x) := by
    intro u v hsh x hx
    obtain ⟨p, hpm, hp⟩ := hx
    choose D hD using fun l : ℕ => hsh (p.coeff l : K) (p.coeff l).2
    set n := p.natDegree with hn
    refine ⟨∑ l ∈ Finset.range n, D l, fun j hj => ?_⟩
    set P : Polynomial K := p.map (algebraMap (Algebra.adjoin A {v}) K) with hP
    have hPm : P.Monic := hpm.map _
    have hPn : P.natDegree = n := hpm.natDegree_map _
    have hPe : Polynomial.eval₂ (algebraMap K L) x P = 0 := by
      rw [hP, Polynomial.eval₂_map]
      exact hp
    set Q := P.scaleRoots (u ^ j) with hQ
    have hQe : Polynomial.eval₂ (algebraMap K L) (algebraMap K L (u ^ j) * x) Q = 0 :=
      Polynomial.scaleRoots_eval₂_eq_zero _ hPe
    have hQm : Q.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hPm
    have hlift : Q ∈ Polynomial.lifts (algebraMap (Algebra.adjoin A {u}) K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro l
      rw [hQ, Polynomial.coeff_scaleRoots, hPn]
      rcases lt_trichotomy l n with hl | hl | hl
      · have hmem : u ^ (j * (n - l)) * (p.coeff l : K) ∈ Algebra.adjoin A {u} := by
          apply hD l
          have h1 : D l ≤ ∑ l ∈ Finset.range n, D l :=
            Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr hl)
          have h2 : j ≤ j * (n - l) := Nat.le_mul_of_pos_right _ (by omega)
          omega
        rw [hP, Polynomial.coeff_map, ← pow_mul, mul_comm]
        exact ⟨⟨_, hmem⟩, rfl⟩
      · subst hl
        have h1 : P.coeff P.natDegree = 1 := hPm
        rw [hPn] at h1
        rw [h1, Nat.sub_self, pow_zero, one_mul]
        exact ⟨1, map_one _⟩
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul]
        exact ⟨0, map_zero _⟩
    obtain ⟨q, hqQ, _, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hQm
    refine ⟨q, hqm, ?_⟩
    have hcomp : (algebraMap ↥(Algebra.adjoin A {u}) L) =
        (algebraMap K L).comp (algebraMap ↥(Algebra.adjoin A {u}) K) := rfl
    rw [hcomp, ← Polynomial.eval₂_map, hqQ, ← map_pow]
    exact hQe

  have hτA : t - algebraMap ↥W A c' ≠ 0 := by
    intro h0
    apply h𝔷τ
    rw [h0, map_zero, map_zero]
    exact 𝔷.zero_mem
  have hbA : algebraMap ↥W A b' ≠ 0 := by
    haveI := hPD.2.1
    intro h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    exact hb0 ((smul_eq_zero.mp h0).resolve_right one_ne_zero)
  have hτK : algebraMap A K (t - algebraMap ↥W A c') ≠ 0 := fun h0 =>
    hτA (IsFractionRing.injective A K (by rw [h0, map_zero]))
  have hbK : algebraMap A K (algebraMap ↥W A b') ≠ 0 := fun h0 =>
    hbA (IsFractionRing.injective A K (by rw [h0, map_zero]))
  have huv : wcLlsScS W A K t c' b' * wcLlsScV W A K t c' b' = 1 := by
    unfold wcLlsScS wcLlsScV
    field_simp
  have hvu : algebraMap K L (wcLlsScV W A K t c' b') *
      algebraMap K L (wcLlsScS W A K t c' b') = 1 := by
    rw [← map_mul, mul_comm, huv, map_one]
