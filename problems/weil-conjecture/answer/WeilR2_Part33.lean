  letI : Algebra ↥W (wcLlsaA W K (g (MvPolynomial.X 0)) c' b') :=
    ((algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c' b')).comp (algebraMap ↥W B)).toAlgebra
  obtain ⟨_, hPDA⟩ := wcpa_dj_llsma_chart_ring Ω W B K g (𝔭.map (algebraMap A B)) c' b'
    hgEt hgC hPDB hc' hb' hb0 rfl
  obtain ⟨_, _, hICA, _⟩ := hPDA
  have hsV : wcLlsaS W K (g (MvPolynomial.X 0)) c' b' = wcLlsScV W A K t c' b' := by
    rw [hgX]
    show algebraMap B K (algebraMap A B (algebraMap ↥W A b')) /
        algebraMap B K (algebraMap A B t - algebraMap A B (algebraMap ↥W A c')) =
      algebraMap A K (algebraMap ↥W A b') / algebraMap A K (t - algebraMap ↥W A c')
    rw [← map_sub]
    rfl
  haveI hICC : IsIntegrallyClosed ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) :=
    @IsIntegrallyClosed.of_equiv _ _ _ _
      (Subalgebra.equivOfEq _ _ (by rw [hsV])).toRingEquiv hICA

  have hRVC : ∀ z ∈ Algebra.adjoin A {wcLlsScV W A K t c' b'},
      z ∈ Algebra.adjoin ↥B {wcLlsScV W A K t c' b'} := by
    intro z hz
    have hle : Algebra.adjoin A {wcLlsScV W A K t c' b'} ≤
        (Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}).restrictScalars A :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr
        (Algebra.subset_adjoin (Set.mem_singleton _)))
    exact hle hz
  let ι : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) →+*
      ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) :=
    { toFun := fun z => ⟨z.1, hRVC z.1 z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  letI : Algebra ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) := ι.toAlgebra
  have key2 : ∀ x ∈ Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}, ∃ n : ℕ, ∃ r : K,
      r ∈ Algebra.adjoin A {wcLlsScV W A K t c' b'} ∧ x * algebraMap A K h ^ n = r := by
    intro x hx
    have hhR : algebraMap A K h ∈ Algebra.adjoin A {wcLlsScV W A K t c' b'} :=
      Subalgebra.algebraMap_mem _ h
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨0, _, Algebra.subset_adjoin (Set.mem_singleton _), by rw [pow_zero, mul_one]⟩
    | algebraMap r =>
      obtain ⟨n, a, ha⟩ := key1 r.1 r.2
      exact ⟨n, algebraMap A K a, Subalgebra.algebraMap_mem _ a, ha⟩
    | add x y _ _ hx hy =>
      obtain ⟨n₁, r₁, hr₁, h₁⟩ := hx
      obtain ⟨n₂, r₂, hr₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, r₁ * algebraMap A K h ^ n₂ + r₂ * algebraMap A K h ^ n₁,
        Subalgebra.add_mem _ (Subalgebra.mul_mem _ hr₁ (Subalgebra.pow_mem _ hhR _))
          (Subalgebra.mul_mem _ hr₂ (Subalgebra.pow_mem _ hhR _)), ?_⟩
      rw [← h₁, ← h₂, pow_add]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨n₁, r₁, hr₁, h₁⟩ := hx
      obtain ⟨n₂, r₂, hr₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, r₁ * r₂, Subalgebra.mul_mem _ hr₁ hr₂, ?_⟩
      rw [← h₁, ← h₂, pow_add]
      ring
  haveI hCloc : IsLocalization.Away
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) h)
      ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) := by
    refine IsLocalization.Away.mk _ ?_ ?_ ?_
    · refine IsUnit.of_mul_eq_one
        (algebraMap ↥B ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'})
          ⟨(algebraMap A K h)⁻¹, heB⟩) ?_
      apply Subtype.ext
      show algebraMap A K h * (algebraMap A K h)⁻¹ = 1
      exact mul_inv_cancel₀ hĥ
    · intro s
      obtain ⟨n, r, hr, hs⟩ := key2 s.1 s.2
      refine ⟨n, ⟨r, hr⟩, Subtype.ext ?_⟩
      show (s : K) * algebraMap A K h ^ n = r
      exact hs
    · intro a b hab
      have hab' : (a : K) = (b : K) :=
        congrArg (fun z : ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) => (z : K)) hab
      exact ⟨0, by rw [Subtype.ext hab']⟩

  have hxN : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) h ∉
      wcLlsScNV W A K t c' b' := by
    intro hmem
    have hq : (Ideal.comap (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}))
        (wcLlsScNV W A K t c' b')).IsPrime := Ideal.comap_isPrime _ _
    have hle : 𝔭 ≤ Ideal.comap (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}))
        (wcLlsScNV W A K t c' b') := by
      rw [h𝔭eq, sup_le_iff]
      constructor
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        rw [hx, SetLike.mem_coe, Ideal.mem_comap]
        have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
            algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
              ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp
                (algebraMap ↥W A)) c' := by
          rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
        rw [e]
        exact Ideal.add_mem _
          (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc'))
      · apply Ideal.map_le_iff_le_comap.mp
        rw [Ideal.map_map]
        exact le_sup_right
    have h4 := h𝔭max.eq_of_le hq.ne_top hle
    apply hh𝔭
    rw [h4, Ideal.mem_comap]
    exact hmem

  have hMN : Submonoid.powers (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) h) ≤
      (wcLlsScNV W A K t c' b').primeCompl := Submonoid.powers_le.mpr hxN
  let algCT : Algebra ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'})
      (Localization.AtPrime (wcLlsScNV W A K t c' b')) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ _ _ hMN
  have tower := @IsLocalization.localization_isScalarTower_of_submonoid_le
    ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) _
    ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) _ _
    (Localization.AtPrime (wcLlsScNV W A K t c' b')) _ _ _ _ hMN _ _
  have hloc2 := @IsLocalization.isLocalization_of_submonoid_le
    ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) _
    ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) _ _
    (Localization.AtPrime (wcLlsScNV W A K t c' b')) _ _ _ _ hMN _ _ algCT tower
  have hle : (wcLlsScNV W A K t c' b').primeCompl.map
      (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'})) ≤
      nonZeroDivisors ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) := by
    rintro _ ⟨r, hr, rfl⟩
    apply mem_nonZeroDivisors_of_ne_zero
    intro h0
    apply hr
    have h0' : (r : K) = ((0 : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) : K) :=
      congrArg (fun z : ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'}) => (z : K)) h0
    rw [Subtype.ext h0']
    exact Ideal.zero_mem _
  exact @isIntegrallyClosed_of_isLocalization ↥(Algebra.adjoin ↥B {wcLlsScV W A K t c' b'})
    (Localization.AtPrime (wcLlsScNV W A K t c' b')) _ _ algCT _ _ _ hle hloc2

theorem wcpa_dj_llsm_obnu_fibre_poly : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → wcLlsScDF W A K L t c' b' → ∃ Φ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) →+* Polynomial (IsLocalRing.ResidueField ↥W), (∀ z, Φ z = 0 ↔ z ∈ wcLlsScJ W A K L t c' b') ∧ (∃ φ : A →+* IsLocalRing.ResidueField ↥W, (∀ a : A, Φ (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) a)) = Polynomial.C (φ a)) ∧ (∀ a : A, φ a = 0 ↔ a ∈ 𝔭) ∧ ∀ w : ↥W, φ (algebraMap ↥W A w) = IsLocalRing.residue ↥W w) ∧ 1 ≤ (Φ (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩)).natDegree :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ 𝔭 t hPD c' b' hc' hb' hb'0 hDF

  have s1 : ∀ (B : Type u) [CommRing B] (ι : ↥W →+* B) (J : Ideal B) (x : B),
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ι w ∈ J) →
      (∀ z : B, ∃ p : Polynomial ↥W, z - Polynomial.eval₂ ι x p ∈ J) →
      (∀ p : Polynomial ↥W, Polynomial.eval₂ ι x p ∈ J →
        ∀ i, p.coeff i ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ Φ : B →+* Polynomial (IsLocalRing.ResidueField ↥W), (∀ z, Φ z = 0 ↔ z ∈ J) ∧
        (∀ w : ↥W, Φ (ι w) = Polynomial.C (IsLocalRing.residue ↥W w)) ∧
        Φ x = Polynomial.X := by
    intro B _ ι J x hm hgen htr
    let θ : Polynomial ↥W →+* B ⧸ J :=
      (Ideal.Quotient.mk J).comp (Polynomial.eval₂RingHom ι x)
    have hθ : Function.Surjective θ := by
      intro q
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨p, hp⟩ := hgen z
      exact ⟨p, (Ideal.Quotient.eq.mpr hp).symm⟩
    let ρ : Polynomial ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W) :=
      Polynomial.mapRingHom (IsLocalRing.residue ↥W)
    have hρ : Function.Surjective ρ :=
      Polynomial.map_surjective _ IsLocalRing.residue_surjective
    have hker : RingHom.ker θ = RingHom.ker ρ := by
      show RingHom.ker θ = RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue ↥W))
      rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue]
      ext p
      rw [Ideal.mem_map_C_iff, RingHom.mem_ker]
      constructor
      · intro hp
        exact htr p (Ideal.Quotient.eq_zero_iff_mem.mp hp)
      · intro hp
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        show Polynomial.eval₂ ι x p ∈ J
        rw [Polynomial.eval₂_eq_sum_range]
        exact Ideal.sum_mem _ (fun i _ => J.mul_mem_right _ (hm _ (hp i)))
    obtain ⟨E, hE⟩ : ∃ E : B ⧸ J ≃+* Polynomial (IsLocalRing.ResidueField ↥W),
        ∀ p, E (Ideal.Quotient.mk J (Polynomial.eval₂ ι x p)) =
          Polynomial.map (IsLocalRing.residue ↥W) p :=
      ⟨((RingHom.quotientKerEquivOfSurjective hθ).symm.trans (Ideal.quotEquivOfEq hker)).trans
          (RingHom.quotientKerEquivOfSurjective hρ), fun p => by
        have h1 : Ideal.Quotient.mk J (Polynomial.eval₂ ι x p) = θ p := rfl
        rw [h1, RingEquiv.trans_apply, RingEquiv.trans_apply,
          RingHom.quotientKerEquivOfSurjective_symm_apply, Ideal.quotEquivOfEq_mk,
          RingHom.quotientKerEquivOfSurjective_apply_mk]
        try rfl⟩
    refine ⟨E.toRingHom.comp (Ideal.Quotient.mk J), ?_, ?_, ?_⟩
    · intro z
      show E (Ideal.Quotient.mk J z) = 0 ↔ z ∈ J
      rw [map_eq_zero_iff E E.injective, Ideal.Quotient.eq_zero_iff_mem]
    · intro w
      show E (Ideal.Quotient.mk J (ι w)) = Polynomial.C (IsLocalRing.residue ↥W w)
      have h := hE (Polynomial.C w)
      rw [Polynomial.eval₂_C, Polynomial.map_C] at h
      exact h
    · show E (Ideal.Quotient.mk J x) = Polynomial.X
      have h := hE Polynomial.X
      rw [Polynomial.eval₂_X, Polynomial.map_X] at h
      exact h

  have s3 : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] [Algebra.IsIntegral R B]
      (Φ : B →+* Polynomial (IsLocalRing.ResidueField ↥W)) (x : B), Φ x = Polynomial.X →
      ¬ ∀ r : R, ∃ c, Φ (algebraMap R B r) = Polynomial.C c := by
    intro R B _ _ _ _ Φ x hx H
    have hψ : Φ.comp (algebraMap R B) =
        Polynomial.C.comp (Polynomial.constantCoeff.comp (Φ.comp (algebraMap R B))) := by
      refine RingHom.ext fun r => ?_
      obtain ⟨c, hc⟩ := H r
      simp only [RingHom.comp_apply, hc, Polynomial.constantCoeff_apply, Polynomial.coeff_C_zero]
    obtain ⟨q, hqm, hq⟩ := Algebra.IsIntegral.isIntegral (R := R) x
    have h1 := congrArg Φ hq
    rw [Polynomial.hom_eval₂, hψ, hx, map_zero, ← Polynomial.eval₂_map,
      Polynomial.eval₂_C_X] at h1
    exact (hqm.map _).ne_zero h1

  obtain ⟨_, hNZ, _, hmax, _, _, h𝔭eq, _⟩ := hPD
  have hb'K : algebraMap A K (algebraMap ↥W A b') ≠ 0 := by
    intro h0
    have h1 : algebraMap ↥W A b' = 0 :=
      (IsFractionRing.injective A K) (h0.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hb'0 h2
    · exact one_ne_zero h2

  have s2 : ∀ (B : Type u) [CommRing B] (j : A →+* B)
      (Φ : B →+* Polynomial (IsLocalRing.ResidueField ↥W)),
      (∀ a ∈ 𝔭, Φ (j a) = 0) → ∃ φ : A →+* IsLocalRing.ResidueField ↥W,
        (∀ a : A, Φ (j a) = Polynomial.C (φ a)) ∧ (∀ a : A, φ a = 0 ↔ a ∈ 𝔭) := by
    intro B _ j Φ h0
    have hunit : ∀ a, a ∉ 𝔭 → IsUnit (Φ (j a)) := by
      intro a ha
      obtain ⟨y, i, hi, hyi⟩ := hmax.exists_inv ha
      have h1 : Φ (j a) * Φ (j y) = 1 := by
        have := congrArg (fun r => Φ (j r)) hyi
        simp only [map_add, map_mul, map_one, h0 i hi, add_zero] at this
        rw [mul_comm]
        exact this
      exact IsUnit.of_mul_eq_one _ h1
    have hconst : ∀ a, Φ (j a) = Polynomial.C ((Φ (j a)).coeff 0) := by
      intro a
      by_cases ha : a ∈ 𝔭
      · rw [h0 a ha, Polynomial.coeff_zero, map_zero]
      · obtain ⟨r, _, hr⟩ := Polynomial.isUnit_iff.mp (hunit a ha)
        rw [← hr, Polynomial.coeff_C_zero]
    refine ⟨Polynomial.constantCoeff.comp (Φ.comp j), fun a => ?_, fun a => ?_⟩
    · rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.constantCoeff_apply]
      exact hconst a
    · rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.constantCoeff_apply]
      constructor
      · intro h
        by_contra ha
        have h2 := (hunit a ha).ne_zero
        rw [hconst a, h, map_zero] at h2
        exact h2 rfl
      · intro ha
        rw [h0 a ha, Polynomial.coeff_zero]

  have hmJ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A w)) ∈
        wcLlsScJ W A K L t c' b' := by
    intro w hw
    unfold wcLlsScJ
    apply Ideal.le_radical
    apply Ideal.subset_span
    exact ⟨w, hw, rfl⟩
  have htJ : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) t) ∈
        wcLlsScJ W A K L t c' b' := by
    have hτ : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (t - algebraMap ↥W A c')) =
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A b')) *
        algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
          ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
      apply Subtype.ext
      show algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) =
        algebraMap K L (algebraMap A K (algebraMap ↥W A b')) *
          algebraMap K L (wcLlsScS W A K t c' b')
      rw [← map_mul]
      congr 1
      unfold wcLlsScS
      field_simp
    have h1 := (wcLlsScJ W A K L t c' b').mul_mem_right
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
          ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩) (hmJ b' hb')
    rw [← hτ] at h1
    have h2 := Ideal.add_mem _ h1 (hmJ c' hc')
    rw [← map_add, ← map_add, sub_add_cancel] at h2
    exact h2
  have hJ𝔭le : 𝔭 ≤ (wcLlsScJ W A K L t c' b').comap
      ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))) := by
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      exact htJ
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hmJ w hw

  obtain ⟨x, hgen, htr⟩ := hDF
  obtain ⟨Φ, hΦker, hΦW, hΦx⟩ := s1
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
    ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})).comp (algebraMap ↥W A)))
    (wcLlsScJ W A K L t c' b') x (fun w hw => hmJ w hw) hgen htr
  obtain ⟨φ, hΦA, hφ𝔭⟩ := s2 ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
    ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))) Φ
    (fun a ha => (hΦker _).mpr (hJ𝔭le ha))
  have hφW : ∀ w : ↥W, φ (algebraMap ↥W A w) = IsLocalRing.residue ↥W w := by
    intro w
    apply Polynomial.C_injective
    rw [← hΦW w]
    exact (hΦA (algebraMap ↥W A w)).symm
  refine ⟨Φ, hΦker, ⟨φ, fun a => hΦA a, hφ𝔭, hφW⟩, ?_⟩
  by_contra hlt
  push_neg at hlt
  have hd0 : (Φ (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
      ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩)).natDegree = 0 := by
    omega
  apply s3 ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) Φ x hΦx
  intro r
  obtain ⟨y, hy⟩ := r
  induction hy using Algebra.adjoin_induction with
  | mem y hy' =>
    rw [Set.mem_singleton_iff] at hy'
    subst hy'
    exact ⟨_, Polynomial.eq_C_of_natDegree_eq_zero hd0⟩
  | algebraMap a => exact ⟨φ a, hΦA a⟩
  | add y₁ y₂ hy₁ hy₂ ih₁ ih₂ =>
    obtain ⟨c₁, hc₁⟩ := ih₁
    obtain ⟨c₂, hc₂⟩ := ih₂
    refine ⟨c₁ + c₂, ?_⟩
    show Φ (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
      ((⟨y₁, hy₁⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})) + ⟨y₂, hy₂⟩)) = _
    rw [map_add, map_add, hc₁, hc₂, Polynomial.C_add]
  | mul y₁ y₂ hy₁ hy₂ ih₁ ih₂ =>
    obtain ⟨c₁, hc₁⟩ := ih₁
    obtain ⟨c₂, hc₂⟩ := ih₂
    refine ⟨c₁ * c₂, ?_⟩
    show Φ (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
      ((⟨y₁, hy₁⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})) * ⟨y₂, hy₂⟩)) = _
    rw [map_mul, map_mul, hc₁, hc₂, Polynomial.C_mul]

theorem wcpa_dj_llsm_obnu_chart_transfer : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] (t : A) (c' b' : ↥W), algebraMap A K (t - algebraMap ↥W A c') ≠ 0 → algebraMap A K (algebraMap ↥W A b') ≠ 0 → wcLlsScS W A K t c' b' * wcLlsScV W A K t c' b' = 1 ∧ (∀ z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L), ∃ (d : ℕ) (y : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)), (y : L) = (z : L) * algebraMap K L (wcLlsScS W A K t c' b') ^ d) ∧ (∀ r : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L), ∃ (e : ℕ) (r' : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)), (r' : L) = (r : L) * algebraMap K L (wcLlsScV W A K t c' b') ^ e) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ t c' b' hτ hβ

  have hshift : ∀ (σ ρ : K), σ * ρ = 1 → ∀ r ∈ Algebra.adjoin A {ρ}, ∃ D : ℕ,
      ∀ D' : ℕ, D ≤ D' → r * σ ^ D' ∈ Algebra.adjoin A {σ} := by
    intro σ ρ h r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      refine ⟨1, fun D' hD' => ?_⟩
      obtain ⟨k, rfl⟩ : ∃ k, D' = k + 1 := ⟨D' - 1, by omega⟩
      have e : x * σ ^ (k + 1) = σ ^ k := by
        rw [pow_succ]; linear_combination σ ^ k * h
      rw [e]
      exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton σ)) _
    | algebraMap a =>
      exact ⟨0, fun D' _ => Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a)
        (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton σ)) _)⟩
    | add x y _ _ hx hy =>
      obtain ⟨D1, h1⟩ := hx
      obtain ⟨D2, h2⟩ := hy
      refine ⟨max D1 D2, fun D' hD' => ?_⟩
      rw [add_mul]
      exact Subalgebra.add_mem _ (h1 D' (le_of_max_le_left hD')) (h2 D' (le_of_max_le_right hD'))
    | mul x y _ _ hx hy =>
      obtain ⟨D1, h1⟩ := hx
      obtain ⟨D2, h2⟩ := hy
      refine ⟨D1 + D2, fun D' hD' => ?_⟩
      have e : x * y * σ ^ D' = (x * σ ^ D1) * (y * σ ^ (D' - D1)) := by
        rw [mul_mul_mul_comm, ← pow_add, Nat.add_sub_cancel' (by omega)]
      rw [e]
      exact Subalgebra.mul_mem _ (h1 D1 le_rfl) (h2 (D' - D1) (by omega))

  have hint : ∀ (R₁ R₂ : Subalgebra A K) (σ : K),
      (∀ r ∈ R₂, ∃ D : ℕ, ∀ D' : ℕ, D ≤ D' → r * σ ^ D' ∈ R₁) → ∀ x : L,
      IsIntegral R₂ x → ∃ d : ℕ, IsIntegral R₁ (x * algebraMap K L σ ^ d) := by
    intro R₁ R₂ σ hsh x hx
    obtain ⟨p, hpm, hpx⟩ := hx
    choose Df hDf using fun i => hsh (p.coeff i : K) (p.coeff i).2
    have hpKm : (p.map (algebraMap R₂ K)).Monic := hpm.map _
    have hnK : (p.map (algebraMap R₂ K)).natDegree = p.natDegree := hpm.natDegree_map _
    have hQcoeff : ∀ i, ((p.map (algebraMap R₂ K)).scaleRoots
        (σ ^ (∑ j ∈ Finset.range p.natDegree, Df j))).coeff i ∈ R₁ := by
      intro i
      rw [Polynomial.coeff_scaleRoots, hnK, Polynomial.coeff_map]
      rcases lt_trichotomy i p.natDegree with hi | hi | hi
      · rw [← pow_mul]
        apply hDf
        have h1 : Df i ≤ ∑ j ∈ Finset.range p.natDegree, Df j :=
          Finset.single_le_sum (fun j _ => Nat.zero_le (Df j)) (Finset.mem_range.mpr hi)
        exact h1.trans (Nat.le_mul_of_pos_right _ (by omega))
      · subst hi
        rw [Nat.sub_self, pow_zero, mul_one]
        have h1 : p.coeff p.natDegree = 1 := hpm
        rw [h1, map_one]
        exact Subalgebra.one_mem _
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, map_zero, zero_mul]
        exact Subalgebra.zero_mem _
    have hlifts : (p.map (algebraMap R₂ K)).scaleRoots
        (σ ^ (∑ j ∈ Finset.range p.natDegree, Df j)) ∈ Polynomial.lifts (algebraMap R₁ K) :=
      (Polynomial.lifts_iff_coeff_lifts _).mpr (fun i => ⟨⟨_, hQcoeff i⟩, rfl⟩)
    have hQm : ((p.map (algebraMap R₂ K)).scaleRoots
        (σ ^ (∑ j ∈ Finset.range p.natDegree, Df j))).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr hpKm
    obtain ⟨q, hqQ, _, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hQm
    refine ⟨∑ j ∈ Finset.range p.natDegree, Df j, q, hqm, ?_⟩
    rw [IsScalarTower.algebraMap_eq R₁ K L, ← Polynomial.eval₂_map, hqQ, ← map_pow, mul_comm,
      Polynomial.scaleRoots_eval₂_mul, Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq, hpx,
      mul_zero]

  have hSV : wcLlsScS W A K t c' b' * wcLlsScV W A K t c' b' = 1 := by
    unfold wcLlsScS wcLlsScV
    rw [div_mul_div_comm, mul_comm (algebraMap A K (algebraMap ↥W A b')),
      div_self (mul_ne_zero hτ hβ)]
  have hVS : wcLlsScV W A K t c' b' * wcLlsScS W A K t c' b' = 1 := by
    rw [mul_comm]; exact hSV
  refine ⟨hSV, ?_, ?_⟩
  · intro z
    obtain ⟨d, hd⟩ := hint (Algebra.adjoin A {wcLlsScS W A K t c' b'})
      (Algebra.adjoin A {wcLlsScV W A K t c' b'}) (wcLlsScS W A K t c' b')
      (hshift _ _ hSV) (z : L) z.2
    exact ⟨d, ⟨_, hd⟩, rfl⟩
  · intro r
    obtain ⟨e, he⟩ := hint (Algebra.adjoin A {wcLlsScV W A K t c' b'})
      (Algebra.adjoin A {wcLlsScS W A K t c' b'}) (wcLlsScV W A K t c' b')
      (hshift _ _ hVS) (r : L) r.2
    exact ⟨e, ⟨_, he⟩, rfl⟩

theorem wcpa_dj_llsm_obnu_inf_place : ∀ (κ : Type u) [Field κ] [DecidableEq (RatFunc κ)] (O : ValuationSubring (RatFunc κ)), (∀ c : κ, algebraMap κ (RatFunc κ) c ∈ O) → ∀ f : Polynomial κ, 1 ≤ f.natDegree → O.valuation (algebraMap (Polynomial κ) (RatFunc κ) f)⁻¹ < 1 → ∀ g : RatFunc κ, (O.valuation g < 1 ↔ RatFunc.inftyValuation κ g < 1) :=
by
  intro κ _ _ O H1 f H2 H3 g
  have hconst_le : ∀ c : κ, O.valuation (algebraMap κ (RatFunc κ) c) ≤ 1 := fun c =>
    (O.valuation_le_one_iff _).mpr (H1 c)
  have hconst : ∀ c : κ, c ≠ 0 → O.valuation (algebraMap κ (RatFunc κ) c) = 1 := by
    intro c hc
    have hx0 : algebraMap κ (RatFunc κ) c ≠ 0 := (map_ne_zero _).mpr hc
    have h1 := hconst_le c
    have h2 : O.valuation (algebraMap κ (RatFunc κ) c)⁻¹ ≤ 1 := by
      rw [← map_inv₀]; exact hconst_le c⁻¹
    rw [map_inv₀] at h2
    have hpos : 0 < O.valuation (algebraMap κ (RatFunc κ) c) := (Valuation.pos_iff _).mpr hx0
    exact le_antisymm h1 ((inv_le_one₀ hpos).mp h2)
  have hbridge : ∀ p : Polynomial κ, algebraMap (Polynomial κ) (RatFunc κ) p =
      ∑ i ∈ Finset.range (p.natDegree + 1),
        algebraMap κ (RatFunc κ) (p.coeff i) * RatFunc.X ^ i := by
    intro p
    conv_lhs => rw [p.as_sum_range_C_mul_X_pow]
    simp only [map_sum, map_mul, map_pow, RatFunc.algebraMap_C, RatFunc.algebraMap_X,
      RatFunc.algebraMap_eq_C]
  have hf0 : f ≠ 0 := by
    rintro rfl; simp at H2
  have hX : 1 < O.valuation RatFunc.X := by
    by_contra hcon
    have hcon' : O.valuation RatFunc.X ≤ 1 := le_of_not_gt hcon
    have hXO : (RatFunc.X : RatFunc κ) ∈ O := (O.valuation_le_one_iff _).mp hcon'
    have hfO : algebraMap (Polynomial κ) (RatFunc κ) f ∈ O := by
      rw [hbridge]
      exact O.sum_mem fun i _ => O.mul_mem _ _ (H1 _) (O.pow_mem hXO _)
    have hle : O.valuation (algebraMap (Polynomial κ) (RatFunc κ) f) ≤ 1 :=
      (O.valuation_le_one_iff _).mpr hfO
    have hne : algebraMap (Polynomial κ) (RatFunc κ) f ≠ 0 :=
      (map_ne_zero_iff _ (RatFunc.algebraMap_injective κ)).mpr hf0
    have hpos := (Valuation.pos_iff O.valuation).mpr hne
    rw [map_inv₀, inv_lt_one₀ hpos] at H3
    exact absurd H3 (not_lt.mpr hle)
  have hc0 : (0 : O.ValueGroup) < O.valuation RatFunc.X := lt_trans zero_lt_one hX
  have hpoly : ∀ p : Polynomial κ, p ≠ 0 →
      O.valuation (algebraMap (Polynomial κ) (RatFunc κ) p) = O.valuation RatFunc.X ^ p.natDegree := by
    intro p hp
    rw [hbridge, Finset.sum_range_succ]
    have hx : O.valuation (algebraMap κ (RatFunc κ) (p.coeff p.natDegree) * RatFunc.X ^ p.natDegree)
        = O.valuation RatFunc.X ^ p.natDegree := by
      rw [Valuation.map_mul, Valuation.map_pow, Polynomial.coeff_natDegree,
        hconst _ (Polynomial.leadingCoeff_ne_zero.mpr hp), one_mul]
    rw [Valuation.map_add_eq_of_lt_right, hx]
    rw [hx]
    apply Valuation.map_sum_lt _ (pow_ne_zero _ hc0.ne')
    intro i hi
    rw [Finset.mem_range] at hi
    rw [Valuation.map_mul, Valuation.map_pow]
    calc O.valuation (algebraMap κ (RatFunc κ) (p.coeff i)) * O.valuation RatFunc.X ^ i
        ≤ 1 * O.valuation RatFunc.X ^ i := mul_le_mul_of_nonneg_right (hconst_le _) zero_le
      _ = O.valuation RatFunc.X ^ i := one_mul _
      _ < O.valuation RatFunc.X ^ p.natDegree := pow_lt_pow_right₀ hX hi
  by_cases hg : g = 0
  · subst hg; simp
  · have hP := RatFunc.num_ne_zero hg
    have hQ := RatFunc.denom_ne_zero g
    have hvg : O.valuation g = O.valuation (algebraMap _ (RatFunc κ) g.num) /
        O.valuation (algebraMap _ (RatFunc κ) g.denom) := by
      conv_lhs => rw [← RatFunc.num_div_denom g]
      exact Valuation.map_div _ _ _
    rw [hvg, hpoly _ hP, hpoly _ hQ, div_lt_one₀ (pow_pos hc0 _), pow_lt_pow_iff_right₀ hX]
    rw [RatFunc.inftyValuation_apply, RatFunc.inftyValuation_of_nonzero κ hg,
      WithZero.exp_lt_one_iff, RatFunc.intDegree]
    omega

theorem wcpa_dj_llsm_obnu_spec_hom : ∀ (L : Type u) [Field L] (S₁ S₂ : Type u) [CommRing S₁] [CommRing S₂] (i₁ : S₁ →+* L) (i₂ : S₂ →+* L), Function.Injective i₁ → ∀ (u : S₁) (F : Type u) [Field F] (Φ : S₁ →+* F), Φ u ≠ 0 → (∀ z : S₂, ∃ (d : ℕ) (y : S₁), i₁ y = i₂ z * i₁ u ^ d) → ∃ Ψ : S₂ →+* F, ∀ (z : S₂) (d : ℕ) (y : S₁), i₁ y = i₂ z * i₁ u ^ d → Ψ z * Φ u ^ d = Φ y :=
by
  intro L _ S₁ S₂ _ _ i₁ i₂ hi u F _ Φ hu h
  classical
  choose dz yz hz using h
  have hq : ∀ n : ℕ, Φ u ^ n ≠ 0 := fun n => pow_ne_zero n hu
  have cross : ∀ (z : S₂) (d d' : ℕ) (y y' : S₁), i₁ y = i₂ z * i₁ u ^ d →
      i₁ y' = i₂ z * i₁ u ^ d' → Φ y * Φ u ^ d' = Φ y' * Φ u ^ d := by
    intro z d d' y y' h1 h2
    have e : y * u ^ d' = y' * u ^ d := by
      apply hi
      rw [map_mul, map_mul, map_pow, map_pow, h1, h2]
      ring
    have e2 := congrArg Φ e
    rw [map_mul, map_mul, map_pow, map_pow] at e2
    exact e2
  let ψ : S₂ → F := fun z => Φ (yz z) / Φ u ^ dz z
  have s3 : ∀ (z : S₂) (d : ℕ) (y : S₁), i₁ y = i₂ z * i₁ u ^ d → ψ z * Φ u ^ d = Φ y := by
    intro z d y hzy
    have hc := cross z (dz z) d (yz z) y (hz z) hzy
    show Φ (yz z) / Φ u ^ dz z * Φ u ^ d = Φ y
    rw [div_mul_eq_mul_div, div_eq_iff (hq _), hc]
  have s4 : ∀ (z : S₂) (d : ℕ) (y : S₁) (c : F), i₁ y = i₂ z * i₁ u ^ d →
      c * Φ u ^ d = Φ y → ψ z = c := by
    intro z d y c hzy hc
    exact mul_right_cancel₀ (hq d) ((s3 z d y hzy).trans hc.symm)
  refine ⟨{ toFun := ψ, map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ }, s3⟩
  · exact s4 1 0 1 1 (by simp) (by simp)
  · intro z₁ z₂
    have e1 := s3 z₁ _ _ (hz z₁)
    have e2 := s3 z₂ _ _ (hz z₂)
    show ψ (z₁ * z₂) = ψ z₁ * ψ z₂
    apply s4 (z₁ * z₂) (dz z₁ + dz z₂) (yz z₁ * yz z₂)
    · rw [map_mul, map_mul, hz, hz, pow_add]
      ring
    · rw [map_mul, pow_add]
      linear_combination (ψ z₂ * Φ u ^ dz z₂) * e1 + Φ (yz z₁) * e2
  · exact s4 0 0 0 0 (by simp) (by simp)
  · intro z₁ z₂
    have e1 := s3 z₁ _ _ (hz z₁)
    have e2 := s3 z₂ _ _ (hz z₂)
    show ψ (z₁ + z₂) = ψ z₁ + ψ z₂
    apply s4 (z₁ + z₂) (dz z₁ + dz z₂) (yz z₁ * u ^ dz z₂ + yz z₂ * u ^ dz z₁)
    · simp only [map_add, map_mul, map_pow, hz, pow_add]
      ring
    · simp only [map_add, map_mul, map_pow, pow_add]
      linear_combination (Φ u ^ dz z₂) * e1 + (Φ u ^ dz z₁) * e2

theorem wcpa_dj_llsm_obnu_exc_below : ∀ (L : Type u) [Field L] (S₁ S₂ : Type u) [CommRing S₁] [CommRing S₂] (i₁ : S₁ →+* L) (i₂ : S₂ →+* L), Function.Injective i₂ → ∀ (u : S₁) (v : S₂), i₁ u * i₂ v = 1 → (∀ r : S₁, ∃ (e : ℕ) (r' : S₂), i₂ r' = i₁ r * i₂ v ^ e) → ∀ (G : Set S₁) (P : Ideal S₂), P.IsPrime → v ∉ P → (∀ g ∈ G, ∃ g' ∈ P, i₂ g' = i₁ g) → ∀ (z : S₂) (d : ℕ) (y : S₁), i₁ y = i₂ z * i₁ u ^ d → y ∈ (Ideal.span G).radical → z ∈ P :=
by
  intro L _ S₁ S₂ _ _ i₁ i₂ hi₂ u v huv H G P hP hvP HG z d y hy hyrad
  have s0 : ∀ (x : S₂) (k : ℕ), x * v ^ k ∈ P → x ∈ P := by
    intro x k hx
    rcases hP.mem_or_mem hx with h | h
    · exact h
    · exact absurd (hP.mem_of_pow_mem k h) hvP
  let J : Ideal S₁ :=
    { carrier := { r : S₁ | ∀ (e : ℕ) (s : S₂), i₂ s = i₁ r * i₂ v ^ e → s ∈ P }
      zero_mem' := by
        simp only [Set.mem_setOf_eq]
        intro e s hs
        have h0 : s = 0 := hi₂ (by rw [hs, map_zero, map_zero, zero_mul])
        rw [h0]; exact P.zero_mem
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        intro e s hs
        obtain ⟨e₁, a', ha'⟩ := H a
        have ha'P : a' ∈ P := ha e₁ a' ha'
        have ht : s * v ^ e₁ - a' * v ^ e ∈ P := by
          apply hb (e + e₁)
          simp only [map_sub, map_mul, map_pow]
          rw [hs, ha', map_add]
          ring
        apply s0 s e₁
        have h1 : s * v ^ e₁ = (s * v ^ e₁ - a' * v ^ e) + a' * v ^ e := by ring
        rw [h1]
        exact P.add_mem ht (P.mul_mem_right _ ha'P)
      smul_mem' := by
        intro c a ha
        simp only [Set.mem_setOf_eq] at ha ⊢
        intro e s hs
        obtain ⟨e₁, c', hc'⟩ := H c
        obtain ⟨e₂, a', ha'⟩ := H a
        have ha'P : a' ∈ P := ha e₂ a' ha'
        apply s0 s (e₁ + e₂)
        have h1 : s * v ^ (e₁ + e₂) = c' * a' * v ^ e := by
          apply hi₂
          simp only [map_mul, map_pow]
          rw [hs, hc', ha', smul_eq_mul, map_mul]
          ring
        rw [h1]
        exact P.mul_mem_right _ (P.mul_mem_left _ ha'P) }
  have hGJ : Ideal.span G ≤ J := by
    rw [Ideal.span_le]
    intro g hg e s hs
    obtain ⟨g', hg'P, hg'⟩ := HG g hg
    have h1 : s = g' * v ^ e := hi₂ (by rw [hs, map_mul, map_pow, hg'])
    rw [h1]; exact P.mul_mem_right _ hg'P
  obtain ⟨n, hn⟩ := hyrad
  have hJ : y ^ n ∈ J := hGJ hn
  have hzn : z ^ n ∈ P := by
    apply hJ (d * n) (z ^ n)
    have h2 : i₂ (z ^ n) = (i₂ z) ^ n * (i₁ u * i₂ v) ^ (d * n) := by
      rw [huv, one_pow, mul_one, map_pow]
    rw [h2, map_pow, hy]
    ring
  exact hP.mem_of_pow_mem n hzn

theorem wcpa_dj_llsm_obnu_node_contract : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → ∀ (κ : Type u) [Field κ] [DecidableEq (RatFunc κ)] (φ : A →+* κ), (∀ a : A, φ a = 0 ↔ a ∈ 𝔭) → ∀ f : Polynomial κ, 1 ≤ f.natDegree → ∀ Ψ₀ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) →+* RatFunc κ, (∀ a : A, Ψ₀ (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a) = algebraMap κ (RatFunc κ) (φ a)) → Ψ₀ ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ = (algebraMap (Polynomial κ) (RatFunc κ) f)⁻¹ → ∀ z, RatFunc.inftyValuation κ (Ψ₀ z) ≤ 1 ∧ (RatFunc.inftyValuation κ (Ψ₀ z) < 1 ↔ z ∈ wcLlsScNV W A K t c' b') :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD c' b' hc' _hb' κ _ _ φ hφ f hdeg Ψ₀ hA hV
  obtain ⟨_, _, _, _, hm𝔭, ht𝔭, hpeq, _⟩ := hPD

  have hf0 : f ≠ 0 := by
    intro h
    rw [h, Polynomial.natDegree_zero] at hdeg
    omega
  have hg : RatFunc.inftyValuation κ ((algebraMap (Polynomial κ) (RatFunc κ) f)⁻¹) < 1 := by
    rw [map_inv₀, RatFunc.inftyValuation_apply, RatFunc.inftyValuation.polynomial κ hf0]
    have h1 : (1 : WithZero (Multiplicative ℤ)) < WithZero.exp (f.natDegree : ℤ) :=
      WithZero.one_lt_exp_iff.mpr (by exact_mod_cast hdeg)
    exact (inv_lt_one₀ (zero_lt_one.trans h1)).mpr h1
  have hC : ∀ c : κ, RatFunc.inftyValuation κ (algebraMap κ (RatFunc κ) c) ≤ 1 ∧
      (RatFunc.inftyValuation κ (algebraMap κ (RatFunc κ) c) < 1 ↔ c = 0) := by
    intro c
    rw [RatFunc.algebraMap_eq_C]
    by_cases hc : c = 0
    · subst hc
      simp
    · rw [RatFunc.inftyValuation.C κ hc]
      exact ⟨le_rfl, by simp [hc]⟩

  have hle : ∀ z : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}),
      RatFunc.inftyValuation κ (Ψ₀ z) ≤ 1 := by
    rintro ⟨y, hy⟩
    induction hy using Algebra.adjoin_induction with
    | mem y hy' =>
      rw [Set.mem_singleton_iff] at hy'
      subst hy'
      rw [hV]
      exact hg.le
    | algebraMap r =>
      show RatFunc.inftyValuation κ
        (Ψ₀ (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) r)) ≤ 1
      rw [hA]
      exact (hC _).1
    | add y₁ y₂ h₁ h₂ ih₁ ih₂ =>
      show RatFunc.inftyValuation κ (Ψ₀ (⟨y₁, h₁⟩ + ⟨y₂, h₂⟩)) ≤ 1
      rw [map_add]
      exact (Valuation.map_add _ _ _).trans (max_le ih₁ ih₂)
    | mul y₁ y₂ h₁ h₂ ih₁ ih₂ =>
      show RatFunc.inftyValuation κ (Ψ₀ (⟨y₁, h₁⟩ * ⟨y₂, h₂⟩)) ≤ 1
      rw [map_mul, map_mul]
      exact mul_le_one' ih₁ ih₂

  have decomp : ∀ z : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}), ∃ (a : A)
      (r : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})),
      z = algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a +
        ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ * r := by
    rintro ⟨y, hy⟩
    induction hy using Algebra.adjoin_induction with
    | mem y hy' =>
      rw [Set.mem_singleton_iff] at hy'
      subst hy'
      refine ⟨0, 1, ?_⟩
      rw [map_zero, zero_add, mul_one]
    | algebraMap r =>
      refine ⟨r, 0, ?_⟩
      rw [mul_zero, add_zero]
      rfl
    | add y₁ y₂ h₁ h₂ ih₁ ih₂ =>
      obtain ⟨a₁, r₁, e₁⟩ := ih₁
      obtain ⟨a₂, r₂, e₂⟩ := ih₂
      refine ⟨a₁ + a₂, r₁ + r₂, ?_⟩
      show (⟨y₁, h₁⟩ + ⟨y₂, h₂⟩ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) = _
      rw [e₁, e₂, map_add]
      ring
    | mul y₁ y₂ h₁ h₂ ih₁ ih₂ =>
      obtain ⟨a₁, r₁, e₁⟩ := ih₁
      obtain ⟨a₂, r₂, e₂⟩ := ih₂
      refine ⟨a₁ * a₂, r₁ * algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a₂ +
        algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a₁ * r₂ +
        ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ * r₁ * r₂, ?_⟩
      show (⟨y₁, h₁⟩ * ⟨y₂, h₂⟩ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) = _
      rw [e₁, e₂, map_mul]
      ring

  have hτ𝔭 : t - algebraMap ↥W A c' ∈ 𝔭 := 𝔭.sub_mem ht𝔭 (hm𝔭 (Ideal.mem_map_of_mem _ hc'))
  have hmw : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A w ∈ 𝔭 :=
    fun w hw => hm𝔭 (Ideal.mem_map_of_mem _ hw)
  have hVNV : (⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
      ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) ∈ wcLlsScNV W A K t c' b' :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hτNV : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      (t - algebraMap ↥W A c') ∈ wcLlsScNV W A K t c' b' :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hmNV : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A w) ∈
        wcLlsScNV W A K t c' b' := fun w hw =>
    Ideal.mem_sup_right (Ideal.mem_map_of_mem
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp (algebraMap ↥W A)) hw)
  have hpNV : ∀ a ∈ 𝔭, algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a ∈
      wcLlsScNV W A K t c' b' := by
    intro a ha
    rw [hpeq] at ha
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp ha
    obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    rw [map_add, map_mul]
    refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ ?_) ?_
    · have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
          algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
          algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A c') := by
        rw [← map_add, sub_add_cancel]
      rw [e]
      exact Ideal.add_mem _ hτNV (hmNV c' hc')
    · have hmap : Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W) ≤
          (wcLlsScNV W A K t c' b').comap
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := by
        rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hmNV w hw
      exact hmap hz

  let I : Ideal ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) :=
    { carrier := {z | RatFunc.inftyValuation κ (Ψ₀ z) < 1}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq, map_add] at ha hb ⊢
        exact Valuation.map_add_lt _ ha hb
      zero_mem' := by simp
      smul_mem' := fun c x hx => by
        simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul] at hx ⊢
        exact lt_of_le_of_lt (mul_le_of_le_one_left' (hle c)) hx }
  have hNVI : wcLlsScNV W A K t c' b' ≤ I := by
    apply sup_le
    · rw [Ideal.span_le]
      intro y hy
      rcases hy with h | h
      · subst h
        show RatFunc.inftyValuation κ (Ψ₀ (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          (t - algebraMap ↥W A c'))) < 1
        rw [hA, (hφ _).mpr hτ𝔭, map_zero, map_zero]
        exact zero_lt_one
      · rw [Set.mem_singleton_iff] at h
        subst h
        show RatFunc.inftyValuation κ (Ψ₀ ⟨wcLlsScV W A K t c' b',
          Algebra.subset_adjoin (Set.mem_singleton _)⟩) < 1
        rw [hV]
        exact hg
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      show RatFunc.inftyValuation κ (Ψ₀ (((algebraMap A ↥(Algebra.adjoin A
        {wcLlsScV W A K t c' b'})).comp (algebraMap ↥W A)) w)) < 1
      rw [RingHom.comp_apply, hA, (hφ _).mpr (hmw w hw), map_zero, map_zero]
      exact zero_lt_one
  intro z
  refine ⟨hle z, ⟨fun hz => ?_, fun hz => hNVI hz⟩⟩
  obtain ⟨a, r, rfl⟩ := decomp z
  rw [map_add, map_mul, hA, hV] at hz
  have htail : RatFunc.inftyValuation κ ((algebraMap (Polynomial κ) (RatFunc κ) f)⁻¹ * Ψ₀ r) < 1 := by
    rw [Valuation.map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_right' (hle r)) hg
  have hφa : φ a = 0 := by
    by_contra hne
    have h1 : RatFunc.inftyValuation κ (algebraMap κ (RatFunc κ) (φ a)) = 1 :=
      le_antisymm (hC _).1 (not_lt.mp (fun h => hne ((hC _).2.mp h)))
    rw [Valuation.map_add_eq_of_lt_left _ (by rw [h1]; exact htail), h1] at hz
    exact lt_irrefl _ hz
  exact Ideal.add_mem _ (hpNV a ((hφ a).mp hφa)) (Ideal.mul_mem_right _ _ hVNV)

theorem wcpa_dj_llsm_obnu_integral_image : ∀ (R C F : Type u) [CommRing R] [CommRing C] [Field F] [Algebra R C] [Algebra.IsIntegral R C] (Θ : C →+* F) (O : ValuationSubring F), (∀ r : R, Θ (algebraMap R C r) ∈ O) → ∀ z : C, Θ z ∈ O :=
by
  intro R C F _ _ _ _ _ Θ O h z
  let φ : R →+* O := (Θ.comp (algebraMap R C)).codRestrict O h
  have hsq : (algebraMap O F).comp φ = Θ.comp (algebraMap R C) := RingHom.ext fun r => rfl
  have hz : IsIntegral O (Θ z) :=
    IsIntegral.map_of_comp_eq φ Θ hsq (Algebra.IsIntegral.isIntegral z)
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hz
  rw [← hy, ValuationSubring.algebraMap_apply]
  exact y.2

theorem wcpa_dj_llsm_obnu_dominating_valuation : ∀ (C F : Type u) [CommRing C] [Field F] (Θ : C →+* F) (P : Ideal C), P.IsPrime → RingHom.ker Θ ≤ P → ∃ O : ValuationSubring F, (∀ z : C, Θ z ∈ O) ∧ ∀ z ∈ P, O.valuation (Θ z) < 1 :=
by
  intro C F _ _ Θ P hP hker
  have hfs : Function.Surjective Θ.rangeRestrict := Θ.rangeRestrict_surjective
  have hkf : RingHom.ker Θ.rangeRestrict ≤ P := by
    rw [RingHom.ker_rangeRestrict]; exact hker
  haveI hQ : (P.map Θ.rangeRestrict).IsPrime := Ideal.map_isPrime_of_surjective hfs hkf
  obtain ⟨O, hRO⟩ := LocalSubring.exists_le_valuationSubring
    (LocalSubring.ofPrime Θ.range (P.map Θ.rangeRestrict))
  obtain ⟨h, hloc⟩ := LocalSubring.le_def.mp hRO
  have hmem : ∀ z : C, Θ z ∈ O := by
    intro z
    have h1 : Θ z ∈ (LocalSubring.ofPrime Θ.range (P.map Θ.rangeRestrict)).toSubring :=
      LocalSubring.le_ofPrime Θ.range (P.map Θ.rangeRestrict) (RingHom.mem_range_self Θ z)
    exact h h1
  refine ⟨O, hmem, ?_⟩
  intro z hz
  have ha : Θ.rangeRestrict z ∈ P.map Θ.rangeRestrict := Ideal.mem_map_of_mem _ hz
  have hr := (IsLocalization.AtPrime.to_map_mem_maximal_iff
    (LocalSubring.ofPrime Θ.range (P.map Θ.rangeRestrict)).toSubring
    (P.map Θ.rangeRestrict) (Θ.rangeRestrict z)).mpr ha
  have ho := map_nonunit (Subring.inclusion h) _ hr
  exact (ValuationSubring.valuation_lt_one_iff O ⟨Θ z, hmem z⟩).mp ho

theorem wcpa_dj_llsm_ob_node_unique : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → wcLlsScDF W A K L t c' b' →
      ∃ w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
        w.IsPrime ∧
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' ∧
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0
    hs' hDF

  obtain ⟨hτ0, hb0K⟩ := wcpa_dj_llsm_obnu_tau_ne_zero Ω W A K 𝔭 t hPD c' b' hb'0
  obtain ⟨hUV, hVU, hUVt⟩ := wcpa_dj_llsm_obnu_chart_transfer Ω W A K L t c' b' hτ0 hb0K
  obtain ⟨Φ, hΦker, ⟨φ, hΦA, hφ𝔭, hφW⟩, hdeg⟩ :=
    wcpa_dj_llsm_obnu_fibre_poly Ω W A K L 𝔭 t hPD c' b' hc' hb'm hb'0 hDF
  set U_B : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) :=
    algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
      ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hU_B
  set V_B : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) :=
    algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
      ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hV_B
  set f : Polynomial (IsLocalRing.ResidueField ↥W) := Φ U_B with hf
  have hf0 : f ≠ 0 := by
    intro h
    rw [h, Polynomial.natDegree_zero] at hdeg
    exact absurd hdeg (by norm_num)
  have hfK : algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
      (RatFunc (IsLocalRing.ResidueField ↥W)) f ≠ 0 :=
    (map_ne_zero_iff _ (RatFunc.algebraMap_injective _)).mpr hf0
  set Φt : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) →+*
      RatFunc (IsLocalRing.ResidueField ↥W) :=
    (algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
      (RatFunc (IsLocalRing.ResidueField ↥W))).comp Φ with hΦt
  have hΦtU : Φt U_B ≠ 0 := hfK
  set i₁ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) →+* L :=
    (integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L).val.toRingHom with hi₁
  set i₂ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) →+* L :=
    (integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L).val.toRingHom with hi₂

  obtain ⟨Ψ, hΨ⟩ := wcpa_dj_llsm_obnu_spec_hom L
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) i₁ i₂
    Subtype.val_injective U_B (RatFunc (IsLocalRing.ResidueField ↥W)) Φt hΦtU (by
      intro z
      obtain ⟨d, y', hy'⟩ := hVU z
      exact ⟨d, y', hy'⟩)
  have hΨA : ∀ a : A, Ψ (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a)) =
      algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W)) (φ a) := by
    intro a
    have h := hΨ (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a)) 0
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) a)) (by
        rw [pow_zero, mul_one]
        rfl)
    rw [pow_zero, mul_one] at h
    rw [h, hΦt, RingHom.comp_apply, hΦA, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
  have hΨV : Ψ V_B = (algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
      (RatFunc (IsLocalRing.ResidueField ↥W)) f)⁻¹ := by
    have h := hΨ V_B 1 1 (by
      rw [map_one, pow_one]
      show (1 : L) = algebraMap K L (wcLlsScV W A K t c' b') *
        algebraMap K L (wcLlsScS W A K t c' b')
      rw [← map_mul, mul_comm, hUV, map_one])
    rw [pow_one, map_one] at h
    exact eq_inv_of_mul_eq_one_left h

  have h7 := wcpa_dj_llsm_obnu_node_contract Ω W A K 𝔭 t hPD c' b' hc' hb'm
    (IsLocalRing.ResidueField ↥W) φ hφ𝔭 f hdeg
    (Ψ.comp (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)))
    (fun a => hΨA a) hΨV

  have h8 : ∀ z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
      RatFunc.inftyValuation (IsLocalRing.ResidueField ↥W) (Ψ z) ≤ 1 := by
    intro z
    have := wcpa_dj_llsm_obnu_integral_image ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
      (RatFunc (IsLocalRing.ResidueField ↥W)) Ψ
      (RatFunc.inftyValuation (IsLocalRing.ResidueField ↥W)).valuationSubring
      (fun r => (Valuation.mem_valuationSubring_iff _ _).mpr (h7 r).1) z
    exact (Valuation.mem_valuationSubring_iff _ _).mp this

  let Winf : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) :=
    { carrier := {z | RatFunc.inftyValuation (IsLocalRing.ResidueField ↥W) (Ψ z) < 1}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq, map_add] at ha hb ⊢
        exact Valuation.map_add_lt _ ha hb
      zero_mem' := by simp
      smul_mem' := fun c x hx => by
        simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul] at hx ⊢
        exact lt_of_le_of_lt (mul_le_of_le_one_left' (h8 c)) hx }
  have hWmem : ∀ z, z ∈ Winf ↔ RatFunc.inftyValuation (IsLocalRing.ResidueField ↥W) (Ψ z) < 1 :=
    fun z => Iff.rfl
  have hWprime : Winf.IsPrime := by
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 := (hWmem 1).mp ((Ideal.eq_top_iff_one _).mp htop)
      rw [map_one, map_one] at h1
      exact lt_irrefl _ h1
    · intro a b hab
      rw [hWmem, map_mul, map_mul] at hab
      rw [hWmem, hWmem]
      by_contra hc
      push_neg at hc
      obtain ⟨ha, hb⟩ := hc
      have ha1 := le_antisymm (h8 a) ha
      have hb1 := le_antisymm (h8 b) hb
      rw [ha1, hb1, one_mul] at hab
      exact lt_irrefl _ hab
  have hWc : Winf.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
      wcLlsScNV W A K t c' b' := by
    ext z
    rw [Ideal.mem_comap]
    exact (h7 z).2
  refine ⟨Winf, hWprime, hWc, ?_⟩

  intro w' hw' hw'c
  haveI : (wcLlsScNV W A K t c' b').IsPrime := hWc ▸ Ideal.comap_isPrime _ _
  have hIC := wcpa_dj_llsm_obnu_node_normal Ω W A K 𝔭 t hPD c' b' hc' hb'm hb'0
  have hinj : Function.Injective (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) := by
    intro x x' hxx
    have h1 : algebraMap K L (x : K) = algebraMap K L (x' : K) :=
      congrArg (fun z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) =>
        (z : L)) hxx
    exact Subtype.ext ((algebraMap K L).injective h1)
  have h𝔫p : (RingHom.ker (Ψ.comp (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)))).IsPrime :=
    RingHom.ker_isPrime _
  have h𝔫le : RingHom.ker (Ψ.comp (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L))) ≤
      wcLlsScNV W A K t c' b' := by
    intro z hz
    rw [RingHom.mem_ker] at hz
    apply (h7 z).2.mp
    rw [hz, map_zero]
    exact zero_lt_one
  obtain ⟨𝔮, h𝔮p, h𝔮le, h𝔮c⟩ := wcpa_dj_llsm_scbc_normal_going_down
    ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) hinj
    (wcLlsScNV W A K t c' b') hIC w' hw' hw'c _ h𝔫p h𝔫le
  have hVq : V_B ∉ 𝔮 := by
    intro hV
    have h1 : (Ψ.comp (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)))
        ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ = 0 := by
      rw [← RingHom.mem_ker, ← h𝔮c, Ideal.mem_comap]
      exact hV
    have h2 : Ψ V_B = 0 := h1
    rw [hΨV] at h2
    exact inv_ne_zero hfK h2
  have hker : RingHom.ker Ψ ≤ w' := by
    intro z hz
    rw [RingHom.mem_ker] at hz
    obtain ⟨d, y', hy'⟩ := hVU z
    have h1 := hΨ z d y' hy'
    rw [hz, zero_mul] at h1
    have h2 : Φ y' = 0 := by
      have h3 : algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
          (RatFunc (IsLocalRing.ResidueField ↥W)) (Φ y') = 0 := h1.symm
      exact (map_eq_zero_iff _ (RatFunc.algebraMap_injective _)).mp h3
    have h3 : y' ∈ wcLlsScJ W A K L t c' b' := (hΦker y').mp h2
    apply h𝔮le
    refine wcpa_dj_llsm_obnu_exc_below L
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) i₁ i₂
      Subtype.val_injective U_B V_B ?_ ?_
      {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))}
      𝔮 h𝔮p hVq ?_ z d y' hy' h3
    · show algebraMap K L (wcLlsScS W A K t c' b') * algebraMap K L (wcLlsScV W A K t c' b') = 1
      rw [← map_mul, hUV, map_one]
    · intro r
      obtain ⟨e, r', hr'⟩ := hUVt r
      exact ⟨e, r', hr'⟩
    · rintro g ⟨w₀, hw₀, hg⟩
      refine ⟨algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A w₀)), ?_, ?_⟩
      · have h4 : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A w₀) ∈
            RingHom.ker (Ψ.comp (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L))) := by
          rw [RingHom.mem_ker, RingHom.comp_apply, hΨA, hφW,
            (IsLocalRing.residue_eq_zero_iff w₀).mpr hw₀, map_zero]
        rw [← h𝔮c, Ideal.mem_comap] at h4
        exact h4
      · exact hg.symm
  obtain ⟨O, hOΨ, hOw⟩ := wcpa_dj_llsm_obnu_dominating_valuation
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
    (RatFunc (IsLocalRing.ResidueField ↥W)) Ψ w' hw' hker
  have hconst : ∀ c : IsLocalRing.ResidueField ↥W,
      algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W)) c ∈ O := by
    intro c
    obtain ⟨w₀, rfl⟩ := IsLocalRing.residue_surjective c
    rw [← hφW, ← hΨA]
    exact hOΨ _
  have hVw : V_B ∈ w' := by
    have h1 : (⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
        ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) ∈ wcLlsScNV W A K t c' b' :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    rw [← hw'c, Ideal.mem_comap] at h1
    exact h1
  have hOV : O.valuation (algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
      (RatFunc (IsLocalRing.ResidueField ↥W)) f)⁻¹ < 1 := by
    rw [← hΨV]
    exact hOw _ hVw
  have h4 := wcpa_dj_llsm_obnu_inf_place (IsLocalRing.ResidueField ↥W) O hconst f hdeg hOV
  have hle : w' ≤ Winf := fun z hz => (h4 (Ψ z)).mp (hOw z hz)
  by_contra hne
  have hlt : w' < Winf := lt_of_le_of_ne hle hne
  have h5 : w'.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) <
      Winf.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) :=
    Ideal.IsIntegral.under_lt_under (R := ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) hlt
  rw [hw'c, hWc] at h5
  exact lt_irrefl _ h5

theorem wcpa_dj_llsm_obi_branches_sum : ∀ (R : Type u) [CommRing R] [IsReduced R]
    (h : (minimalPrimes R).Finite),
    wcpaDjLkBranches R = ∑ P ∈ h.toFinset, wcpaDjLkBranches (R ⧸ P) :=
by
  intro R _ _ h
  classical

  have s5 : ∀ (ι : Type u) [Fintype ι] (A : ι → Type u) [∀ i, CommRing (A i)],
      ENat.card (MaximalSpectrum ((i : ι) → A i)) = ∑ i, ENat.card (MaximalSpectrum (A i)) := by
    intro ι _ A _
    have hsurj : ∀ i, Function.Surjective (Pi.evalRingHom A i) := fun i a =>
      ⟨Pi.single i a, Pi.single_eq_same i a⟩
    let Φ : (Σ i, MaximalSpectrum (A i)) → MaximalSpectrum ((i : ι) → A i) := fun x =>
      ⟨Ideal.comap (Pi.evalRingHom A x.1) x.2.asIdeal, x.2.isMaximal.comap_piEvalRingHom⟩
    have hΦ : Function.Bijective Φ := by
      constructor
      · rintro ⟨i, M⟩ ⟨j, N⟩ hMN
        have h1 : Ideal.comap (Pi.evalRingHom A i) M.asIdeal =
            Ideal.comap (Pi.evalRingHom A j) N.asIdeal := congrArg MaximalSpectrum.asIdeal hMN
        by_cases hij : i = j
        · subst hij
          have hMN' : M = N := by
            apply MaximalSpectrum.ext
            rw [← Ideal.map_comap_of_surjective _ (hsurj i) M.asIdeal, h1,
              Ideal.map_comap_of_surjective _ (hsurj i)]
          rw [hMN']
        · exfalso
          have hf : (Pi.single j 1 : (i : ι) → A i) ∈ Ideal.comap (Pi.evalRingHom A i) M.asIdeal := by
            rw [Ideal.mem_comap, Pi.evalRingHom_apply, Pi.single_eq_of_ne hij]
            exact M.asIdeal.zero_mem
          rw [h1, Ideal.mem_comap, Pi.evalRingHom_apply, Pi.single_eq_same] at hf
          exact N.isMaximal.ne_top ((Ideal.eq_top_iff_one _).mpr hf)
      · intro 𝔪
        obtain ⟨i, q, hq⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq
          (⟨𝔪.asIdeal, 𝔪.isMaximal.isPrime⟩ : PrimeSpectrum ((i : ι) → A i))
        have hq' : Ideal.comap (Pi.evalRingHom A i) q.asIdeal = 𝔪.asIdeal :=
          congrArg PrimeSpectrum.asIdeal hq
        have hqm : q.asIdeal = Ideal.map (Pi.evalRingHom A i) 𝔪.asIdeal := by
          rw [← hq', Ideal.map_comap_of_surjective _ (hsurj i)]
        have hmax : q.asIdeal.IsMaximal := by
          rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ (hsurj i) 𝔪.isMaximal with h2 | h2
          · exact absurd (hqm.trans h2) q.isPrime.ne_top
          · rw [hqm]; exact h2
        exact ⟨⟨i, ⟨q.asIdeal, hmax⟩⟩, MaximalSpectrum.ext hq'⟩
    rw [← ENat.card_congr (Equiv.ofBijective Φ hΦ)]
    by_cases hfin : ∀ i, Finite (MaximalSpectrum (A i))
    · rw [ENat.card_eq_coe_natCard, Nat.card_sigma, Nat.cast_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [ENat.card_eq_coe_natCard]
    · push_neg at hfin
      obtain ⟨i, hi⟩ := hfin
      have hinf : Infinite (Σ i, MaximalSpectrum (A i)) := Infinite.sigma_of_right (a := i)
      rw [ENat.card_eq_top_of_infinite]
      refine (eq_top_iff.mpr ?_).symm
      calc (⊤ : ℕ∞) = ENat.card (MaximalSpectrum (A i)) := ENat.card_eq_top_of_infinite.symm
        _ ≤ ∑ j, ENat.card (MaximalSpectrum (A j)) :=
          Finset.single_le_sum (f := fun j => ENat.card (MaximalSpectrum (A j)))
            (fun _ _ => zero_le) (Finset.mem_univ i)

  have s6 : ∀ (A B : Type u) [CommRing A] [CommRing B], (A ≃+* B) →
      ENat.card (MaximalSpectrum A) = ENat.card (MaximalSpectrum B) := by
    intro A B _ _ e
    apply ENat.card_congr
    exact
      { toFun := fun M => ⟨Ideal.comap e.symm M.asIdeal,
          @Ideal.comap_isMaximal_of_equiv _ _ _ _ _ _ _ e.symm _ M.isMaximal⟩
        invFun := fun N => ⟨Ideal.comap e N.asIdeal,
          @Ideal.comap_isMaximal_of_equiv _ _ _ _ _ _ _ e _ N.isMaximal⟩
        left_inv := fun M => by
          apply MaximalSpectrum.ext
          ext x
          show x ∈ Ideal.comap e (Ideal.comap e.symm M.asIdeal) ↔ _
          rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.symm_apply_apply]
        right_inv := fun N => by
          apply MaximalSpectrum.ext
          ext x
          show x ∈ Ideal.comap e.symm (Ideal.comap e N.asIdeal) ↔ _
          rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.apply_symm_apply] }

  set S := h.toFinset with hS
  have hmin : ∀ Q ∈ S, Q ∈ minimalPrimes R := fun Q hQ => h.mem_toFinset.mp hQ
  have hp : ∀ P ∈ S, P.IsPrime := fun P hP => Ideal.IsMinimalPrime.isPrime (hmin P hP)

  have s1 : ∀ x : R, (∀ P ∈ minimalPrimes R, x ∈ P) → x = 0 := by
    intro x hx
    apply IsReduced.eq_zero x
    rw [← mem_nilradical, nilradical_eq_sInf, Submodule.mem_sInf]
    intro J hJ
    have : Ideal.IsPrime J := hJ
    obtain ⟨P, hP, hPJ⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ J)
    exact hPJ (hx P hP)
  have h0 : ∀ x : R, (∀ P ∈ S, x ∈ P) → x = 0 := fun x hx =>
    s1 x (fun P hP => hx P (h.mem_toFinset.mpr hP))

  have s2 : ∀ P ∈ S, ∃ e : R, e ∉ P ∧ ∀ Q ∈ S, Q ≠ P → e ∈ Q := by
    intro P hP
    have hPmin := hmin P hP
    haveI hPp : P.IsPrime := Ideal.IsMinimalPrime.isPrime hPmin
    have hex : ∀ Q ∈ S.erase P, ∃ a : R, a ∈ Q ∧ a ∉ P := by
      intro Q hQ
      obtain ⟨hQP, hQS⟩ := Finset.mem_erase.mp hQ
      have hQmin := hmin Q hQS
      have hnle : ¬ Q ≤ P := by
        intro hle
        exact hQP (le_antisymm hle (hPmin.2 ⟨Ideal.IsMinimalPrime.isPrime hQmin, bot_le⟩ hle))
      exact SetLike.not_le_iff_exists.mp hnle
    choose! a ha1 ha2 using hex
    refine ⟨∏ Q ∈ S.erase P, a Q, ?_, ?_⟩
    · intro hmem
      obtain ⟨Q, hQ, hQP⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
      exact ha2 Q hQ hQP
    · intro Q hQ hQP
      have hQe : Q ∈ S.erase P := Finset.mem_erase.mpr ⟨hQP, hQ⟩
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem a hQe
      rw [hc]
      exact Q.mul_mem_right c (ha1 Q hQe)

  have halg : ∀ (P : S) (x : R), algebraMap R (FractionRing (R ⧸ (P : Ideal R))) x =
      algebraMap (R ⧸ (P : Ideal R)) (FractionRing (R ⧸ (P : Ideal R)))
        (Ideal.Quotient.mk (P : Ideal R) x) := fun P x => by
    rw [IsScalarTower.algebraMap_apply R (R ⧸ (P : Ideal R)) (FractionRing (R ⧸ (P : Ideal R)))]
    rfl
  have hzero : ∀ (P : S) (x : R),
      algebraMap R (FractionRing (R ⧸ (P : Ideal R))) x = 0 ↔ x ∈ (P : Ideal R) := by
    intro P x
    rw [halg, map_eq_zero_iff _ (IsFractionRing.injective (R ⧸ (P : Ideal R))
      (FractionRing (R ⧸ (P : Ideal R)))), Ideal.Quotient.eq_zero_iff_mem]
  have claimA : ∀ s ∈ nonZeroDivisors R, ∀ P ∈ S, s ∉ P := by
    intro s hs P hP hsP
    obtain ⟨e, he1, he2⟩ := s2 P hP
    have hse : s * e = 0 := h0 _ (fun Q hQ => by
      by_cases hQP : Q = P
      · rw [hQP]; exact P.mul_mem_right e hsP
      · exact Q.mul_mem_left s (he2 Q hQ hQP))
    have he0 : e = 0 := (mul_left_mem_nonZeroDivisors_eq_zero_iff hs).mp hse
    exact he1 (he0 ▸ P.zero_mem)
  have claimB : ∀ s : R, (∀ P ∈ S, s ∉ P) → s ∈ nonZeroDivisors R := by
    intro s hs
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply h0
    intro P hP
    have hPp := hp P hP
    have hxs : x * s ∈ P := hx ▸ P.zero_mem
    exact (hPp.mem_or_mem hxs).resolve_right (hs P hP)
  choose e he1 he2 using s2
  have key : ∀ (f : S → R) (P : S),
      algebraMap R (FractionRing (R ⧸ (P : Ideal R))) (∑ Q : S, e Q.1 Q.2 * f Q) =
        algebraMap R (FractionRing (R ⧸ (P : Ideal R))) (e P.1 P.2) *
          algebraMap R (FractionRing (R ⧸ (P : Ideal R))) (f P) := by
    intro f P
    rw [map_sum, Finset.sum_eq_single P]
    · rw [map_mul]
    · intro Q _ hQP
      rw [map_mul, (hzero P (e Q.1 Q.2)).mpr
        (he2 Q.1 Q.2 P.1 P.2 (fun h => hQP (Subtype.ext h).symm)), zero_mul]
    · intro h; exact absurd (Finset.mem_univ P) h
  haveI hloc : IsLocalization (nonZeroDivisors R) ((P : S) → FractionRing (R ⧸ (P : Ideal R))) := by
    constructor
    constructor
    · rintro ⟨s, hs⟩
      rw [Pi.isUnit_iff]
      intro P
      haveI := hp P.1 P.2
      change IsUnit (algebraMap R (FractionRing (R ⧸ (P : Ideal R))) s)
      rw [halg]
      refine IsLocalization.map_units (FractionRing (R ⧸ (P : Ideal R)))
        (⟨Ideal.Quotient.mk _ s, ?_⟩ : nonZeroDivisors (R ⧸ (P : Ideal R)))
      apply mem_nonZeroDivisors_of_ne_zero
      rw [Ne, Ideal.Quotient.eq_zero_iff_mem]
      exact claimA s hs P.1 P.2
    · intro z
      have hex : ∀ P : S, ∃ α σ : R, σ ∉ (P : Ideal R) ∧
          z P * algebraMap R (FractionRing (R ⧸ (P : Ideal R))) σ =
            algebraMap R (FractionRing (R ⧸ (P : Ideal R))) α := by
        intro P
        haveI := hp P.1 P.2
        obtain ⟨⟨a', m'⟩, hm⟩ := IsLocalization.surj (nonZeroDivisors (R ⧸ (P : Ideal R))) (z P)
        obtain ⟨α, hα⟩ := Ideal.Quotient.mk_surjective a'
        obtain ⟨σ, hσ⟩ := Ideal.Quotient.mk_surjective (m' : R ⧸ (P : Ideal R))
        refine ⟨α, σ, ?_, ?_⟩
        · intro hσP
          have hm0 : (m' : R ⧸ (P : Ideal R)) = 0 := by
            rw [← hσ]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hσP
          exact nonZeroDivisors.ne_zero m'.2 hm0
        · rw [halg, halg, hα, hσ]; exact hm
      choose α σ hσ hzσ using hex
      have hsmem : (∑ Q : S, e Q.1 Q.2 * σ Q) ∈ nonZeroDivisors R := by
        apply claimB
        intro P hP hmem
        haveI := hp P hP
        have h1 := (hzero ⟨P, hP⟩ _).mpr hmem
        rw [key] at h1
        rcases mul_eq_zero.mp h1 with h2 | h2
        · exact he1 P hP ((hzero ⟨P, hP⟩ _).mp h2)
        · exact hσ ⟨P, hP⟩ ((hzero ⟨P, hP⟩ _).mp h2)
      refine ⟨⟨∑ Q : S, e Q.1 Q.2 * α Q, ⟨_, hsmem⟩⟩, ?_⟩
      funext P
      change z P * algebraMap R (FractionRing (R ⧸ (P : Ideal R))) (∑ Q : S, e Q.1 Q.2 * σ Q) =
        algebraMap R (FractionRing (R ⧸ (P : Ideal R))) (∑ Q : S, e Q.1 Q.2 * α Q)
      rw [key, key, ← hzσ P]
      ring
    · intro x y hxy
      refine ⟨1, ?_⟩
      rw [OneMemClass.coe_one, one_mul, one_mul, ← sub_eq_zero]
      apply h0
      intro P hP
      have hc := congrFun hxy ⟨P, hP⟩
      refine (hzero ⟨P, hP⟩ (x - y)).mp ?_
      rw [map_sub, sub_eq_zero]
      exact hc

  have hint : ∀ x : ((P : S) → FractionRing (R ⧸ (P : Ideal R))),
      IsIntegral R x ↔ ∀ P : S, IsIntegral (R ⧸ (P : Ideal R)) (x P) := by
    intro x
    constructor
    · intro hx P
      exact (hx.map (Pi.evalAlgHom R (fun P : S => FractionRing (R ⧸ (P : Ideal R))) P)).tower_top
    · intro hx
      have hx' : ∀ P : S, ∃ p : Polynomial R, p.Monic ∧
          Polynomial.eval₂ (algebraMap R (FractionRing (R ⧸ (P : Ideal R)))) (x P) p = 0 :=
        fun P => isIntegral_trans (R := R) (A := R ⧸ (P : Ideal R)) _ (hx P)
      choose p hpm hpe using hx'
      refine ⟨∏ P : S, p P, Polynomial.monic_prod_of_monic _ _ (fun P _ => hpm P), ?_⟩
      funext Q
      rw [Polynomial.eval₂_finsetProd, Finset.prod_apply]
      apply Finset.prod_eq_zero (Finset.mem_univ Q)
      have h1 := Polynomial.aeval_algHom_apply
        (Pi.evalAlgHom R (fun P : S => FractionRing (R ⧸ (P : Ideal R))) Q) x (p Q)
      rw [Pi.evalAlgHom_apply] at h1
      change Pi.evalAlgHom R (fun P : S => FractionRing (R ⧸ (P : Ideal R))) Q
        (Polynomial.aeval x (p Q)) = 0
      rw [← h1, Polynomial.aeval_def]
      exact hpe Q
  let e3 : ↥(integralClosure R ((P : S) → FractionRing (R ⧸ (P : Ideal R)))) ≃+*
      ((P : S) → ↥(integralClosure (R ⧸ (P : Ideal R)) (FractionRing (R ⧸ (P : Ideal R))))) :=
    { toFun := fun x P => ⟨x.1 P, ((hint x.1).mp x.2) P⟩
      invFun := fun y => ⟨fun P => (y P).1, (hint _).mpr (fun P => (y P).2)⟩
      left_inv := fun x => rfl
      right_inv := fun y => rfl
      map_mul' := fun x y => rfl
      map_add' := fun x y => rfl }

  let e1 : FractionRing R ≃ₐ[R] ((P : S) → FractionRing (R ⧸ (P : Ideal R))) :=
    IsLocalization.algEquiv (nonZeroDivisors R) (FractionRing R) _
  let e2 := AlgEquiv.mapIntegralClosure e1
  show ENat.card (MaximalSpectrum ↥(integralClosure R (FractionRing R))) =
    ∑ P ∈ S, wcpaDjLkBranches (R ⧸ P)
  rw [s6 _ _ (e2.toRingEquiv.trans e3),
    s5 S (fun P : S => ↥(integralClosure (R ⧸ (P : Ideal R)) (FractionRing (R ⧸ (P : Ideal R))))),
    ← Finset.sum_coe_sort S]
  rfl

theorem wcpa_dj_llsm_obi_br_birational : ∀ (D₀ D₁ : Type u) [CommRing D₀] [IsDomain D₀]
    [CommRing D₁] [IsDomain D₁] (f : D₀ →+* D₁), Function.Injective f → f.IsIntegral →
    (∀ x : D₁, ∃ a b : D₀, f b ≠ 0 ∧ x * f b = f a) →
    wcpaDjLkBranches D₀ = wcpaDjLkBranches D₁ :=
by
  intro D₀ D₁ _ _ _ _ f hinj hint hbir
  classical
  have hι₁ : Function.Injective (algebraMap D₁ (FractionRing D₁)) :=
    IsFractionRing.injective D₁ (FractionRing D₁)
  have hg : Function.Injective ((algebraMap D₁ (FractionRing D₁)).comp f) := hι₁.comp hinj
  let φ₀ : FractionRing D₀ →+* FractionRing D₁ :=
    IsFractionRing.lift (A := D₀) (K := FractionRing D₀) (L := FractionRing D₁) hg
  have hφ₀ : ∀ a : D₀, φ₀ (algebraMap D₀ (FractionRing D₀) a) =
      algebraMap D₁ (FractionRing D₁) (f a) := fun a =>
    IsFractionRing.lift_algebraMap (A := D₀) (K := FractionRing D₀) (L := FractionRing D₁) hg a
  have hne : ∀ x : D₁, x ≠ 0 → algebraMap D₁ (FractionRing D₁) x ≠ 0 := fun x hx =>
    (map_ne_zero_iff _ hι₁).mpr hx
  have hsurj : Function.Surjective φ₀ := by
    intro z
    obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := D₁) z
    obtain ⟨a, b, hb, hab⟩ := hbir x
    obtain ⟨a', b', hb', hab'⟩ := hbir y
    have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
    have ha' : f a' ≠ 0 := by rw [← hab']; exact mul_ne_zero hy0 hb'
    refine ⟨algebraMap D₀ (FractionRing D₀) (a * b') /
      algebraMap D₀ (FractionRing D₀) (b * a'), ?_⟩
    have e1 : algebraMap D₁ (FractionRing D₁) (f a) =
        algebraMap D₁ (FractionRing D₁) x * algebraMap D₁ (FractionRing D₁) (f b) := by
      rw [← hab, map_mul]
    have e2 : algebraMap D₁ (FractionRing D₁) (f a') =
        algebraMap D₁ (FractionRing D₁) y * algebraMap D₁ (FractionRing D₁) (f b') := by
      rw [← hab', map_mul]
    rw [map_div₀, hφ₀, hφ₀, map_mul, map_mul, map_mul, map_mul, e1, e2,
      div_eq_div_iff (mul_ne_zero (hne _ hb) (by rw [← e2]; exact hne _ ha')) (hne _ hy0)]
    ring
  let φ : FractionRing D₀ ≃+* FractionRing D₁ := RingEquiv.ofBijective φ₀ ⟨φ₀.injective, hsurj⟩
  have hφφ₀ : ∀ z, φ z = φ₀ z := fun z => rfl
  have hcomp : φ₀.comp (algebraMap D₀ (FractionRing D₀)) =
      (algebraMap D₁ (FractionRing D₁)).comp f := RingHom.ext hφ₀
  have hiff : ∀ z : FractionRing D₀, _root_.IsIntegral D₀ z ↔ _root_.IsIntegral D₁ (φ₀ z) := by
    intro z
    constructor
    · rintro ⟨p, hpm, hp⟩
      refine ⟨p.map f, hpm.map f, ?_⟩
      rw [Polynomial.eval₂_map, ← hcomp, ← Polynomial.hom_eval₂, hp, map_zero]
    · intro h
      letI : Algebra D₀ D₁ := f.toAlgebra
      haveI : Algebra.IsIntegral D₀ D₁ := ⟨fun x => hint x⟩
      have h2 : _root_.IsIntegral D₀ (φ₀ z) := isIntegral_trans (φ₀ z) h
      obtain ⟨q, hqm, hq⟩ := h2
      rw [IsScalarTower.algebraMap_eq D₀ D₁ (FractionRing D₁)] at hq
      refine ⟨q, hqm, ?_⟩
      apply φ₀.injective
      rw [Polynomial.hom_eval₂, hcomp, map_zero]
      exact hq
  let σ : ↥(integralClosure D₀ (FractionRing D₀)) ≃+* ↥(integralClosure D₁ (FractionRing D₁)) :=
    { toFun := fun n => ⟨φ₀ n, (hiff n).mp n.2⟩
      invFun := fun n => ⟨φ.symm n, (hiff (φ.symm n)).mpr (by
        rw [← hφφ₀, RingEquiv.apply_symm_apply]; exact n.2)⟩
      left_inv := fun n => Subtype.ext (φ.symm_apply_apply (n : FractionRing D₀))
      right_inv := fun n => Subtype.ext (φ.apply_symm_apply (n : FractionRing D₁))
      map_mul' := fun x y => Subtype.ext (map_mul φ₀ (x : FractionRing D₀) y)
      map_add' := fun x y => Subtype.ext (map_add φ₀ (x : FractionRing D₀) y) }
  let E : MaximalSpectrum ↥(integralClosure D₀ (FractionRing D₀)) ≃
      MaximalSpectrum ↥(integralClosure D₁ (FractionRing D₁)) :=
    { toFun := fun M => ⟨M.asIdeal.comap σ.symm,
        (haveI := M.isMaximal; Ideal.comap_isMaximal_of_equiv σ.symm)⟩
      invFun := fun M => ⟨M.asIdeal.comap σ,
        (haveI := M.isMaximal; Ideal.comap_isMaximal_of_equiv σ)⟩
      left_inv := fun M => by
        apply MaximalSpectrum.ext
        ext x
        show x ∈ (M.asIdeal.comap σ.symm).comap σ ↔ x ∈ M.asIdeal
        rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.symm_apply_apply]
      right_inv := fun M => by
        apply MaximalSpectrum.ext
        ext x
        show x ∈ (M.asIdeal.comap σ).comap σ.symm ↔ x ∈ M.asIdeal
        rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.apply_symm_apply] }
  unfold wcpaDjLkBranches
  exact ENat.card_congr E

theorem wcpa_dj_llsm_obi_R0_minprimes_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
      (minimalPrimes (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)).Finite :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy _
  classical
  haveI := hy
  obtain ⟨hFT, _, hIC, -⟩ := hPD

  have s1 : (Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W)).minimalPrimes.Finite := by
    letI : Field (↥W ⧸ IsLocalRing.maximalIdeal ↥W) :=
      Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W)
    haveI : Algebra.FiniteType ↥W
        (A ⧸ Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W)) := inferInstance
    haveI : Algebra.FiniteType (↥W ⧸ IsLocalRing.maximalIdeal ↥W)
        (A ⧸ Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W)) :=
      Algebra.FiniteType.of_restrictScalars_finiteType ↥W _ _
    haveI : IsNoetherianRing
        (A ⧸ Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W)) :=
      Algebra.FiniteType.isNoetherianRing (↥W ⧸ IsLocalRing.maximalIdeal ↥W) _
    rw [Ideal.minimalPrimes_eq_comap]
    exact (minimalPrimes.finite_of_isNoetherianRing _).image _

  have hinj : Function.Injective (algebraMap A ↥(integralClosure A L)) := by
    intro a b hab
    have h1 := congrArg Subtype.val hab
    change algebraMap A L a = algebraMap A L b at h1
    rw [IsScalarTower.algebraMap_apply A K L, IsScalarTower.algebraMap_apply A K L b] at h1
    exact IsFractionRing.injective A K ((algebraMap K L).injective h1)
  haveI : FaithfulSMul A ↥(integralClosure A L) :=
    (faithfulSMul_iff_algebraMap_injective A ↥(integralClosure A L)).mpr hinj
  haveI : Algebra.HasGoingDown A ↥(integralClosure A L) := inferInstance

  have s3 : ∀ (I : Ideal A) (P : Ideal ↥(integralClosure A L)),
      P ∈ (I.map (algebraMap A ↥(integralClosure A L))).minimalPrimes →
      P.comap (algebraMap A ↥(integralClosure A L)) ∈ I.minimalPrimes := by
    intro I P hP
    haveI hPp : P.IsPrime := hP.1.1
    refine ⟨⟨Ideal.comap_isPrime _ P, Ideal.map_le_iff_le_comap.mp hP.1.2⟩, ?_⟩
    intro q hq hqle
    haveI := hq.1
    haveI : P.LiesOver (P.comap (algebraMap A ↥(integralClosure A L))) :=
      ⟨by rw [Ideal.under_def]⟩
    obtain ⟨P'', hP''le, hP''p, hP''lo⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (p := q)
        (q := P.comap (algebraMap A ↥(integralClosure A L))) P hqle
    have hq_eq : q = P''.comap (algebraMap A ↥(integralClosure A L)) := by
      rw [hP''lo.over, Ideal.under_def]
    have hPP : P ≤ P'' :=
      hP.2 ⟨hP''p, Ideal.map_le_iff_le_comap.mpr (hq_eq ▸ hq.2)⟩ hP''le
    rw [hq_eq]
    exact Ideal.comap_mono hPP

  haveI hinv : Algebra.IsInvariant A ↥(integralClosure A L) (L ≃ₐ[K] L) := by
    constructor
    intro b hb
    have hb' : (b : L) ∈ (⊥ : IntermediateField K L) := by
      rw [IsGalois.mem_bot_iff_fixed]
      intro g
      exact congrArg Subtype.val (hb g)
    obtain ⟨k, hk⟩ := IntermediateField.mem_bot.mp hb'
    have hkint : IsIntegral A k := by
      rw [← isIntegral_algHom_iff (IsScalarTower.toAlgHom A K L)
        (fun x z h => (algebraMap K L).injective h)]
      rw [IsScalarTower.toAlgHom_apply, hk]
      exact b.2
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hkint
    refine ⟨a, Subtype.ext ?_⟩
    change algebraMap A L a = (b : L)
    rw [IsScalarTower.algebraMap_apply A K L, ha, hk]

  have s2 : ∀ q : Ideal A, {P : Ideal ↥(integralClosure A L) | P.IsPrime ∧
      P.comap (algebraMap A ↥(integralClosure A L)) = q}.Finite := by
    intro q
    by_cases hne : {P : Ideal ↥(integralClosure A L) | P.IsPrime ∧
        P.comap (algebraMap A ↥(integralClosure A L)) = q}.Nonempty
    · obtain ⟨P₀, hP₀, hP₀q⟩ := hne
      haveI := hP₀
      open scoped Pointwise in
      refine (Set.finite_range (fun g : L ≃ₐ[K] L => g • P₀)).subset ?_
      rintro P ⟨hP, hPq⟩
      haveI := hP
      obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A ↥(integralClosure A L)
        (L ≃ₐ[K] L) P₀ P (by rw [Ideal.under_def, Ideal.under_def, hP₀q, hPq])
      exact ⟨g, hg.symm⟩
    · rw [Set.not_nonempty_iff_eq_empty] at hne
      rw [hne]
      exact Set.finite_empty

  have s4 : Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} =
      (Ideal.map (algebraMap ↥W A) (IsLocalRing.maximalIdeal ↥W)).map
        (algebraMap A ↥(integralClosure A L)) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨w, hw, hb⟩
      have hb2 : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w) := Subtype.ext hb
      rw [hb2]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw)
    · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      apply Ideal.subset_span
      exact ⟨w, hw, rfl⟩

  have s5 : (Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
      (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w}).minimalPrimes.Finite := by
    rw [s4]
    refine (s1.biUnion (fun q _ => s2 q)).subset ?_
    intro P hP
    exact Set.mem_biUnion (s3 _ P hP) ⟨hP.1.1, rfl⟩

  have key : ∀ IA : Ideal ↥(integralClosure A L), IA.minimalPrimes.Finite →
      (minimalPrimes (Localization.AtPrime y ⧸
        IA.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)))).Finite := by
    intro IA hIA
    let J := IA.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
    let Φ : Ideal (Localization.AtPrime y ⧸ J) → Ideal ↥(integralClosure A L) := fun Q =>
      (Q.comap (Ideal.Quotient.mk J)).comap
        (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
    have hΦinj : Function.Injective Φ := by
      intro Q1 Q2 h
      apply Ideal.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective
      calc Q1.comap (Ideal.Quotient.mk J)
          = Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
              (Φ Q1) :=
            (IsLocalization.map_under y.primeCompl (Localization.AtPrime y) _).symm
        _ = Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
              (Φ Q2) := by rw [h]
        _ = Q2.comap (Ideal.Quotient.mk J) :=
            IsLocalization.map_under y.primeCompl (Localization.AtPrime y) _
    have hmap : ∀ Q ∈ minimalPrimes (Localization.AtPrime y ⧸ J), Φ Q ∈ IA.minimalPrimes := by
      intro Q hQ
      have h1 : Q.comap (Ideal.Quotient.mk J) ∈ J.minimalPrimes := by
        rw [Ideal.minimalPrimes_eq_comap]
        exact ⟨Q, hQ, rfl⟩
      rw [IsLocalization.minimalPrimes_map y.primeCompl (Localization.AtPrime y) IA] at h1
      exact h1
    exact Set.Finite.of_finite_image
      (hIA.subset (by rintro _ ⟨Q, hQ, rfl⟩; exact hmap Q hQ)) hΦinj.injOn
  exact key _ s5

theorem wcpa_dj_llsm_obism_fs_corr : ∀ (S : Type u) [CommRing S] (q : Ideal S) [q.IsPrime]
    (I : Ideal S), I ≤ q →
    ∀ ψ : S →+* (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))),
    ψ = (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))).comp
      (algebraMap S (Localization.AtPrime q)) →
    (∀ 𝔔 : Ideal S, 𝔔.IsPrime → I ≤ 𝔔 → 𝔔 ≤ q → (𝔔.map ψ).IsPrime ∧ (𝔔.map ψ).comap ψ = 𝔔) ∧
    (∀ 𝔓 : Ideal (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))),
      𝔓.IsPrime → (𝔓.comap ψ).map ψ = 𝔓 ∧ 𝔓.comap ψ ≤ q) ∧
    (∀ 𝔓 : Ideal (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))),
      𝔓 ∈ minimalPrimes (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))) ↔
        𝔓.IsPrime ∧ 𝔓.comap ψ ∈ I.minimalPrimes) :=
by
  intro S _ q _ I hIq ψ hψ
  subst hψ
  have hSur : Function.Surjective
      (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))) :=
    Ideal.Quotient.mk_surjective
  have hK : RingHom.ker (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))) =
      I.map (algebraMap S (Localization.AtPrime q)) := Ideal.mk_ker
  have hdisj : ∀ 𝔔 : Ideal S, 𝔔 ≤ q → Disjoint (q.primeCompl : Set S) (𝔔 : Set S) :=
    fun 𝔔 h => Set.disjoint_left.mpr (fun x hxM hx => hxM (h hx))
  refine ⟨?_, ?_, ?_⟩
  · intro 𝔔 h𝔔 hI𝔔 h𝔔q
    have hp : (𝔔.map (algebraMap S (Localization.AtPrime q))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint q.primeCompl _ 𝔔 h𝔔 (hdisj 𝔔 h𝔔q)
    have hc : (𝔔.map (algebraMap S (Localization.AtPrime q))).comap
        (algebraMap S (Localization.AtPrime q)) = 𝔔 :=
      IsLocalization.comap_map_of_isPrime_disjoint q.primeCompl _ h𝔔 (hdisj 𝔔 h𝔔q)
    have hker : RingHom.ker (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))) ≤
        𝔔.map (algebraMap S (Localization.AtPrime q)) := by
      rw [hK]; exact Ideal.map_mono hI𝔔
    rw [← Ideal.map_map]
    refine ⟨Ideal.map_isPrime_of_surjective hSur hker, ?_⟩
    rw [← Ideal.comap_comap, Ideal.comap_map_of_surjective' _ hSur, sup_eq_left.mpr hker, hc]
  · intro 𝔓 h𝔓
    refine ⟨?_, ?_⟩
    · rw [← Ideal.comap_comap, ← Ideal.map_map, IsLocalization.map_comap q.primeCompl,
        Ideal.map_comap_of_surjective _ hSur]
    · intro x hx
      by_contra hxq
      have hu : IsUnit (algebraMap S (Localization.AtPrime q) x) :=
        IsLocalization.map_units (Localization.AtPrime q) (⟨x, hxq⟩ : q.primeCompl)
      exact h𝔓.ne_top (Ideal.eq_top_of_isUnit_mem _ hx
        (hu.map (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q))))))
  · intro 𝔓
    constructor
    · intro h
      refine ⟨h.1.1, ?_⟩
      have h1 : 𝔓.comap (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))) ∈
          (RingHom.ker (Ideal.Quotient.mk
            (I.map (algebraMap S (Localization.AtPrime q))))).minimalPrimes := by
        rw [RingHom.ker_eq_comap_bot, Ideal.comap_minimalPrimes_eq_of_surjective hSur]
        exact ⟨𝔓, h, rfl⟩
      rw [hK, IsLocalization.minimalPrimes_map q.primeCompl] at h1
      rw [← Ideal.comap_comap]
      exact h1
    · rintro ⟨_, h⟩
      rw [← Ideal.comap_comap] at h
      have h1 : 𝔓.comap (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))) ∈
          (RingHom.ker (Ideal.Quotient.mk
            (I.map (algebraMap S (Localization.AtPrime q))))).minimalPrimes := by
        rw [hK, IsLocalization.minimalPrimes_map q.primeCompl]
        exact h
      rw [RingHom.ker_eq_comap_bot, Ideal.comap_minimalPrimes_eq_of_surjective hSur] at h1
      obtain ⟨P₁, hP₁, he⟩ := h1
      have hP : P₁ = 𝔓 := by
        rw [← Ideal.map_comap_of_surjective _ hSur P₁, he, Ideal.map_comap_of_surjective _ hSur]
      rw [← hP]
      exact hP₁

theorem wcpa_dj_llsm_obism_chart : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (t : A) (c' b' : ↥W),
    (∀ x : ↥(integralClosure A L),
      IsIntegral ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (x : L)) ∧
    (∀ z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
      ∃ (k : ℕ) (a : ↥(integralClosure A L)),
        (a : L) = algebraMap A L (t - algebraMap ↥W A c') ^ k * (z : L)) ∧
    (algebraMap A K (t - algebraMap ↥W A c') * wcLlsScV W A K t c' b' =
        algebraMap A K (algebraMap ↥W A b') ∨ wcLlsScV W A K t c' b' = 0) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ t c' b'
  classical

  have hC : ∀ (A K : Type u) [CommRing A] [CommRing K] [Algebra A K] (τ : A) (V : K),
      (∃ a₀ : A, algebraMap A K a₀ = algebraMap A K τ * V) →
      ∀ x ∈ Algebra.adjoin A {V}, ∃ D : ℕ, ∀ k : ℕ, D ≤ k →
        ∃ a : A, algebraMap A K a = algebraMap A K τ ^ k * x := by
    intro A K _ _ _ τ V h0
    obtain ⟨a₀, ha₀⟩ := h0
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      refine ⟨1, fun k hk => ?_⟩
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      refine ⟨τ ^ j * a₀, ?_⟩
      rw [map_mul, map_pow, ha₀, pow_succ]
      ring
    | algebraMap r =>
      exact ⟨0, fun k _ => ⟨τ ^ k * r, by rw [map_mul, map_pow]⟩⟩
    | add x y _ _ hx hy =>
      obtain ⟨Dx, hDx⟩ := hx
      obtain ⟨Dy, hDy⟩ := hy
      refine ⟨max Dx Dy, fun k hk => ?_⟩
      obtain ⟨ax, hax⟩ := hDx k (le_of_max_le_left hk)
      obtain ⟨ay, hay⟩ := hDy k (le_of_max_le_right hk)
      exact ⟨ax + ay, by rw [map_add, hax, hay, mul_add]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨Dx, hDx⟩ := hx
      obtain ⟨Dy, hDy⟩ := hy
      refine ⟨Dx + Dy, fun k hk => ?_⟩
      obtain ⟨ax, hax⟩ := hDx Dx le_rfl
      obtain ⟨ay, hay⟩ := hDy Dy le_rfl
      obtain ⟨j, rfl⟩ : ∃ j, k = j + (Dx + Dy) := ⟨k - (Dx + Dy), by omega⟩
      refine ⟨τ ^ j * ax * ay, ?_⟩
      rw [map_mul, map_mul, map_pow, hax, hay, pow_add, pow_add]
      ring

  have hScale : ∀ (A S L : Type u) [CommRing A] [CommRing S] [CommRing L] [Algebra A S]
      [Algebra S L] [Algebra A L] [IsScalarTower A S L] (τ : A),
      (∀ s : S, ∃ D : ℕ, ∀ k : ℕ, D ≤ k →
        ∃ a : A, algebraMap A S a = algebraMap A S τ ^ k * s) →
      ∀ x : L, IsIntegral S x → ∃ k : ℕ, IsIntegral A (algebraMap A L τ ^ k * x) := by
    intro A S L _ _ _ _ _ _ _ τ h x hx
    choose Dfun hD using h
    obtain ⟨q, hqm, hq⟩ := hx
    obtain ⟨D, hDdef⟩ : ∃ D, D = (Finset.range q.natDegree).sup (fun i => Dfun (q.coeff i)) :=
      ⟨_, rfl⟩
    have hroot := Polynomial.scaleRoots_eval₂_eq_zero (algebraMap S L) hq
      (s := algebraMap A S τ ^ D)
    have hlift : q.scaleRoots (algebraMap A S τ ^ D) ∈ Polynomial.lifts (algebraMap A S) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i q.natDegree with hi | hi | hi
      · have hle : Dfun (q.coeff i) ≤ D := by
          rw [hDdef]
          exact Finset.le_sup (f := fun i => Dfun (q.coeff i)) (Finset.mem_range.mpr hi)
        have hle2 : D ≤ D * (q.natDegree - i) := Nat.le_mul_of_pos_right _ (by omega)
        obtain ⟨a, ha⟩ := hD (q.coeff i) (D * (q.natDegree - i)) (hle.trans hle2)
        refine ⟨a, ?_⟩
        rw [ha, pow_mul, mul_comm]
      · refine ⟨1, ?_⟩
        rw [hi, Nat.sub_self, pow_zero, mul_one, map_one]
        exact hqm.coeff_natDegree.symm
      · refine ⟨0, ?_⟩
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, zero_mul, map_zero]
    have hmon : (q.scaleRoots (algebraMap A S τ ^ D)).Monic := by
      unfold Polynomial.Monic
      rw [Polynomial.leadingCoeff_scaleRoots]
      exact hqm
    obtain ⟨p, hpmap, _, hpm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hmon
    refine ⟨D, p, hpm, ?_⟩
    have hσ : algebraMap S L (algebraMap A S τ ^ D) = algebraMap A L τ ^ D := by
      rw [map_pow, ← IsScalarTower.algebraMap_apply]
    rw [← hσ, IsScalarTower.algebraMap_eq A S L, ← Polynomial.eval₂_map, hpmap]
    exact hroot

  have hc : algebraMap A K (t - algebraMap ↥W A c') * wcLlsScV W A K t c' b' =
        algebraMap A K (algebraMap ↥W A b') ∨ wcLlsScV W A K t c' b' = 0 := by
    have hV : wcLlsScV W A K t c' b' = algebraMap A K (algebraMap ↥W A b') /
        algebraMap A K (t - algebraMap ↥W A c') := rfl
    rw [hV]
    by_cases h : algebraMap A K (t - algebraMap ↥W A c') = 0
    · right; rw [h, div_zero]
    · left; exact mul_div_cancel₀ _ h
  refine ⟨?_, ?_, hc⟩
  ·
    intro x
    exact IsIntegral.tower_top (R := A) ((mem_integralClosure_iff A L).mp x.2)
  ·
    intro z
    have h0 : ∃ a₀ : A, algebraMap A K a₀ =
        algebraMap A K (t - algebraMap ↥W A c') * wcLlsScV W A K t c' b' := by
      rcases hc with h | h
      · exact ⟨algebraMap ↥W A b', h.symm⟩
      · exact ⟨0, by rw [map_zero, h, mul_zero]⟩
    have hS : ∀ s : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}), ∃ D : ℕ, ∀ k : ℕ, D ≤ k →
        ∃ a : A, algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a =
          algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
            (t - algebraMap ↥W A c') ^ k * s := by
      intro s
      obtain ⟨D, hD⟩ := hC A K (t - algebraMap ↥W A c') _ h0 (s : K) s.2
      refine ⟨D, fun k hk => ?_⟩
      obtain ⟨a, ha⟩ := hD k hk
      refine ⟨a, Subtype.ext ?_⟩
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      exact ha
    obtain ⟨k, hk⟩ := hScale A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L
      (t - algebraMap ↥W A c') hS (z : L)
      ((mem_integralClosure_iff ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L).mp z.2)
    exact ⟨k, ⟨_, (mem_integralClosure_iff A L).mpr hk⟩, rfl⟩

theorem wcpa_dj_llsm_obi_t_regular : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ a : A, t * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ s : A, s ∉ 𝔭 ∧ s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
by
  intro Ω _ W A _ _ _ 𝔭 t hPD a hta
  classical

  have s1 : ∀ (R₀ : Type u) [CommRing R₀] (I : Ideal R₀) (S : Type u) [CommRing S]
      (f : Polynomial R₀ →+* S), f.Flat → ∀ y : S,
      f Polynomial.X * y ∈ I.map (f.comp Polynomial.C) →
        y ∈ I.map (f.comp Polynomial.C) := by
    intro R₀ _ I S _ f hf y hy
    letI := f.toAlgebra
    have hflat : Module.Flat (Polynomial R₀) S := hf
    have hy' : f Polynomial.X * y ∈ Submodule.span S ((f.comp Polynomial.C) '' I) := hy
    obtain ⟨n, c, g, hg⟩ := Submodule.mem_span_set'.mp hy'
    choose w hwI hwf using fun i => (g i).2
    have hrel : ∑ i, (Fin.cons Polynomial.X (fun i => -Polynomial.C (w i)) :
        Fin (n + 1) → Polynomial R₀) i • (Fin.cons y c : Fin (n + 1) → S) i = 0 := by
      rw [Fin.sum_univ_succ]
      simp only [Fin.cons_zero, Fin.cons_succ, Algebra.smul_def, RingHom.algebraMap_toAlgebra,
        map_neg, neg_mul, Finset.sum_neg_distrib]
      have e : ∑ i, f (Polynomial.C (w i)) * c i = f Polynomial.X * y := by
        rw [← hg]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [smul_eq_mul, ← hwf i, RingHom.comp_apply, mul_comm]
      rw [e, add_neg_cancel]
    obtain ⟨k, aa, z, hY, hF⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := Polynomial R₀) (M := S) hrel
    have hmem : ∀ j, aa 0 j ∈ I.map Polynomial.C := by
      intro j
      have h1 := hF j
      rw [Fin.sum_univ_succ] at h1
      simp only [Fin.cons_zero, Fin.cons_succ, neg_mul, Finset.sum_neg_distrib] at h1
      have h2 : Polynomial.X * aa 0 j ∈ I.map Polynomial.C := by
        have e : Polynomial.X * aa 0 j = ∑ i, Polynomial.C (w i) * aa i.succ j := by
          linear_combination h1
        rw [e]
        exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hwI i)))
      rw [Ideal.mem_map_C_iff] at h2 ⊢
      intro m
      have := h2 (m + 1)
      rwa [Polynomial.coeff_X_mul] at this
    have hY0 := hY 0
    simp only [Fin.cons_zero] at hY0
    rw [hY0]
    refine Ideal.sum_mem _ (fun j _ => ?_)
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    refine Ideal.mul_mem_right _ _ ?_
    rw [← Ideal.map_map]
    exact Ideal.mem_map_of_mem _ (hmem j)
  have hmax : 𝔭.IsMaximal := hPD.2.2.2.1
  obtain ⟨-, -, h, hh, f, hfC, hfX, hfet⟩ := hPD.2.2.2.2.2
  have hflat : f.Flat := ((RingHom.etale_iff_formallyUnramified_and_smooth f).mp hfet).2.flat
  have hstar : ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
      (algebraMap A (Localization.Away h)) =
      (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) := by
    rw [Ideal.map_map, hfC]
  have h1 := Ideal.mem_map_of_mem (algebraMap A (Localization.Away h)) hta
  rw [hstar, map_mul, ← hfX] at h1
  have h2 := s1 (↥W) (IsLocalRing.maximalIdeal ↥W) (Localization.Away h) f hflat _ h1
  rw [← hstar] at h2
  obtain ⟨⟨⟨x, hxJ⟩, ⟨_, hq⟩⟩, hx⟩ :=
    (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers h) (Localization.Away h)).mp h2
  obtain ⟨q, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hq
  simp only at hx
  rw [← map_mul] at hx
  obtain ⟨⟨_, hp⟩, hc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h)
    (Localization.Away h)).mp hx
  obtain ⟨p, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hp
  simp only at hc
  refine ⟨h ^ p * h ^ q, ?_, ?_⟩
  · rw [← pow_add]
    intro hm
    exact hh (hmax.isPrime.mem_of_pow_mem _ hm)
  · have e : h ^ p * h ^ q * a = h ^ p * x := by
      rw [← hc]; ring
    rw [e]
    exact Ideal.mul_mem_left _ _ hxJ

theorem wcpa_dj_llsm_obism_le_w : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (𝔭 : Ideal A) (t : A) (c' b' : ↥W), wcLlsPD W A 𝔭 (.disc t) →
    c' ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) [w.IsPrime],
      w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
        wcLlsScNV W A K t c' b' →
      wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w →
      ∀ J : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
        algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ J →
        (∀ a : A, algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a) ∈ J → a ∈ 𝔭) →
        J ≤ w :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ 𝔭 t c' b' hPD hc' w _ hwc hwU J hVJ hJA
  classical

  have hdec : ∀ r : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}),
      ∃ (a : A) (r' : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})),
        r = algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a +
          ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ * r' := by
    intro r
    have hr : (r : K) ∈ (Polynomial.aeval (R := A) (wcLlsScV W A K t c' b')).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact r.2
    obtain ⟨p, hp⟩ := (AlgHom.mem_range _).mp hr
    refine ⟨p.coeff 0, ⟨Polynomial.aeval (wcLlsScV W A K t c' b') p.divX,
      Polynomial.aeval_mem_adjoin_singleton A (wcLlsScV W A K t c' b')⟩, ?_⟩
    apply Subtype.ext
    rw [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ← hp]
    conv_lhs => rw [← Polynomial.X_mul_divX_add p]
    simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
    ring

  have hVN : (⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
      ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) ∈ wcLlsScNV W A K t c' b' := by
    unfold wcLlsScNV
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hτN : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c')
      ∈ wcLlsScNV W A K t c' b' := by
    unfold wcLlsScNV
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hmN : ∀ x ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A x)
        ∈ wcLlsScNV W A K t c' b' := by
    intro x hx
    unfold wcLlsScNV
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
      ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp (algebraMap ↥W A)) hx)

  have hpN : ∀ a ∈ 𝔭, algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a
      ∈ wcLlsScNV W A K t c' b' := by
    have h𝔭 := hPD.2.2.2.2.2.2.1
    have hle : 𝔭 ≤ (wcLlsScNV W A K t c' b').comap
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := by
      rw [h𝔭]
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
            algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
            algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A c') := by
          rw [← map_add, sub_add_cancel]
        rw [e]
        exact Ideal.add_mem _ hτN (hmN c' hc')
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        exact hmN x hx
    intro a ha
    exact hle ha

  have hunder : Ideal.under ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) J ≤
      wcLlsScNV W A K t c' b' := by
    rw [Ideal.under_def]
    intro r hr
    rw [Ideal.mem_comap] at hr
    obtain ⟨a, r', rfl⟩ := hdec r
    have h1 : algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ * r') ∈ J := by
      rw [map_mul]
      exact J.mul_mem_right _ hVJ
    have h2 : algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a) ∈ J := by
      have h3 := J.sub_mem hr h1
      rwa [map_add, add_sub_cancel_right] at h3
    exact Ideal.add_mem _ (hpN a (hJA a h2)) (Ideal.mul_mem_right _ _ hVN)

  haveI hNprime : (wcLlsScNV W A K t c' b').IsPrime := hwc ▸ Ideal.comap_isPrime _ w

  obtain ⟨Q, hJQ, hQp, hQu⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral (wcLlsScNV W A K t c' b') J hunder
  rw [Ideal.under_def] at hQu

  have hQw : Q = w := hwU Q hQp hQu
  rw [← hQw]
  exact hJQ

theorem wcpa_dj_llsm_obism_generic_avoid : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (𝔭 : Ideal A) (t : A) (c' : ↥W) (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.disc t) → c' ∈ IsLocalRing.maximalIdeal ↥W →
    (∀ a : A, t * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ s : A, s ∉ 𝔭 ∧ s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
    y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    ∀ P ∈ (Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}).minimalPrimes,
      P ≤ y → algebraMap A ↥(integralClosure A L) (t - algebraMap ↥W A c') ∉ P :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ 𝔭 t c' y hPD hc' hreg hy hyc P hP hPy hτ
  classical
  obtain ⟨_, _, hic, hmax, hmA, ht, hspan, _⟩ := hPD
  haveI hpr : 𝔭.IsPrime := hmax.isPrime
  haveI := hic

  have s1 : 𝔭 ∉ ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).minimalPrimes := by
    intro hmin
    have hJ : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 := hmin.1.2
    have claim : ∀ n : ℕ, ∀ s : A, s ∉ 𝔭 →
        s * t ^ n ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
      intro n
      induction n with
      | zero =>
        intro s hs h
        rw [pow_zero, mul_one] at h
        exact hs (hJ h)
      | succ n ih =>
        intro s hs h
        have e : t * (s * t ^ n) = s * t ^ (n + 1) := by ring
        have h' : t * (s * t ^ n) ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
          rw [e]; exact h
        obtain ⟨s', hs', hs'm⟩ := hreg _ h'
        refine ih (s' * s) (Ideal.IsPrime.mul_notMem hpr hs' hs) ?_
        rw [mul_assoc]; exact hs'm
    have hdisj : Disjoint ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) : Set A)
        ((𝔭.primeCompl ⊔ Submonoid.powers t : Submonoid A) : Set A) := by
      rw [Set.disjoint_left]
      intro x hx hxS
      obtain ⟨a, ha, b, hb, rfl⟩ := Submonoid.mem_sup.mp hxS
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hb
      exact claim n a ha hx
    obtain ⟨Q, hQ, hJQ, hQd⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
    have hQp : Q ≤ 𝔭 := by
      intro x hx
      by_contra hx'
      exact Set.disjoint_left.mp hQd hx
        (Submonoid.mem_sup_left (show x ∈ 𝔭.primeCompl from hx'))
    have hpQ : 𝔭 ≤ Q := hmin.2 ⟨hQ, hJQ⟩ hQp
    exact Set.disjoint_left.mp hQd (hpQ ht) (Submonoid.mem_sup_right (Submonoid.mem_powers t))

  have hI : Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} =
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A ↥(integralClosure A L)) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨x, hx, hb⟩
      have hbe : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A x) := Subtype.ext hb
      rw [hbe]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hx)
    · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro x hx
      exact Ideal.mem_comap.mpr (Ideal.mem_comap.mpr (Ideal.subset_span ⟨x, hx, rfl⟩))

  haveI : FaithfulSMul A ↥(integralClosure A L) := by
    rw [faithfulSMul_iff_algebraMap_injective]
    intro a a' h
    have h2 : algebraMap A L a = algebraMap A L a' := congrArg Subtype.val h
    rw [IsScalarTower.algebraMap_apply A K L, IsScalarTower.algebraMap_apply A K L] at h2
    exact IsFractionRing.injective A K ((algebraMap K L).injective h2)
  haveI : Algebra.HasGoingDown A ↥(integralClosure A L) := inferInstance

  rw [hI] at hP
  haveI hPp : P.IsPrime := hP.1.1
  have hq : P.comap (algebraMap A ↥(integralClosure A L)) ∈
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).minimalPrimes := by
    refine ⟨⟨inferInstance, Ideal.map_le_iff_le_comap.mp hP.1.2⟩, ?_⟩
    intro Q hQ hQq
    haveI : Q.IsPrime := hQ.1
    haveI : P.LiesOver (P.comap (algebraMap A ↥(integralClosure A L))) :=
      ⟨(Ideal.under_def A P).symm⟩
    obtain ⟨P'', hP''P, hP''p, hlo⟩ := Ideal.exists_ideal_le_liesOver_of_le
      (p := Q) (q := P.comap (algebraMap A ↥(integralClosure A L))) P hQq
    have hQeq : Q = P''.comap (algebraMap A ↥(integralClosure A L)) :=
      (Ideal.over_def P'' Q).trans (Ideal.under_def A P'')
    have hmP : ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A ↥(integralClosure A L)) ≤ P'' := by
      rw [Ideal.map_le_iff_le_comap, ← hQeq]
      exact hQ.2
    have hPP'' : P ≤ P'' := hP.2 ⟨hP''p, hmP⟩ hP''P
    rw [hQeq]
    exact Ideal.comap_mono hPP''

  have hle1 : P.comap (algebraMap A ↥(integralClosure A L)) ≤ 𝔭 := by
    rw [← hyc]; exact Ideal.comap_mono hPy
  have hle2 : 𝔭 ≤ P.comap (algebraMap A ↥(integralClosure A L)) := by
    rw [hspan]
    refine sup_le ?_ hq.1.2
    rw [Ideal.span_singleton_le_iff_mem]
    have hsum := Ideal.add_mem _ (Ideal.mem_comap.mpr hτ) (hq.1.2 (Ideal.mem_map_of_mem _ hc'))
    rwa [sub_add_cancel] at hsum
  have heq : P.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 := le_antisymm hle1 hle2
  rw [heq] at hq
  exact s1 hq

theorem wcpa_dj_llsm_obism_w_over_y : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (𝔭 : Ideal A) (t : A) (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) [w.IsPrime],
      w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
        wcLlsScNV W A K t c' b' →
      ∀ (x : ↥(integralClosure A L))
        (hx : IsIntegral ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (x : L)),
        ((⟨(x : L), hx⟩ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) ∈ w ↔
          x ∈ y) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' w _ hwc x hx
  have hint : ∀ z : ↥(integralClosure A L),
      IsIntegral ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (z : L) := fun z =>
    IsIntegral.tower_top (A := ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) z.2
  let ι : ↥(integralClosure A L) →+*
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) :=
    ((integralClosure A L).val.toRingHom).codRestrict
      (integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (fun z => hint z)
  have hιv : ∀ z, ((ι z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) :
      L) = (z : L) := fun z => rfl
  have hιA : ∀ a : A, ι (algebraMap A ↥(integralClosure A L) a) =
      algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a) := by
    intro a
    apply Subtype.ext
    rw [hιv]
    show algebraMap A L a = algebraMap K L (algebraMap A K a)
    exact IsScalarTower.algebraMap_apply A K L a
  have hq : (w.comap ι).comap (algebraMap A ↥(integralClosure A L)) =
      (wcLlsScNV W A K t c' b').comap
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, hιA, ← hwc, Ideal.mem_comap]
  haveI hNp : (wcLlsScNV W A K t c' b').IsPrime := hwc ▸ Ideal.comap_isPrime _ w
  have hne : (wcLlsScNV W A K t c' b').comap
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) ≠ ⊤ :=
    (Ideal.comap_isPrime _ _).ne_top
  have hle : 𝔭 ≤ (wcLlsScNV W A K t c' b').comap
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := by
    rw [hPD.2.2.2.2.2.2.1]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
          algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp
            (algebraMap ↥W A)) c' := by
        rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
      rw [e]
      apply Ideal.add_mem
      · unfold wcLlsScNV
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · unfold wcLlsScNV
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc')
    · rw [Ideal.map_le_iff_le_comap]
      intro z hz
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A z) =
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp
            (algebraMap ↥W A)) z := rfl
      rw [e]
      unfold wcLlsScNV
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hz)
  have heq := hPD.2.2.2.1.eq_of_le hne hle
  haveI : (w.comap ι).IsPrime := Ideal.comap_isPrime ι w
  have hy' : w.comap ι = y := hU _ inferInstance (hq.trans heq.symm)
  show ι x ∈ w ↔ x ∈ y
  rw [← hy', Ideal.mem_comap]

theorem wcpa_dj_llsm_obism_lift : ∀ (S T : Type u) [CommRing S] [CommRing T] (ι : S →+* T),
    Function.Injective ι → ∀ τ : S, (∀ z : T, ∃ (k : ℕ) (a : S), ι a = ι τ ^ k * z) →
    ∃ Λ : Ideal S → Ideal T,
      (∀ P : Ideal S, ∀ z : T, z ∈ Λ P ↔ ∃ (k : ℕ) (a : S), a ∈ P ∧ ι a = ι τ ^ k * z) ∧
      (∀ P : Ideal S, P.IsPrime → τ ∉ P → (Λ P).IsPrime ∧ (Λ P).comap ι = P) ∧
      (∀ Q : Ideal T, Q.IsPrime → ι τ ∉ Q → Λ (Q.comap ι) = Q) :=
by
  intro S T _ _ ι hι τ H
  let Λ : Ideal S → Ideal T := fun P =>
    { carrier := {z | ∃ (k : ℕ) (a : S), a ∈ P ∧ ι a = ι τ ^ k * z}
      add_mem' := by
        rintro z₁ z₂ ⟨k₁, a₁, ha₁, h₁⟩ ⟨k₂, a₂, ha₂, h₂⟩
        refine ⟨k₁ + k₂, τ ^ k₂ * a₁ + τ ^ k₁ * a₂,
          P.add_mem (P.mul_mem_left _ ha₁) (P.mul_mem_left _ ha₂), ?_⟩
        rw [map_add, map_mul, map_mul, map_pow, map_pow, h₁, h₂, pow_add]
        ring
      zero_mem' := ⟨0, 0, P.zero_mem, by simp⟩
      smul_mem' := by
        rintro c z ⟨k, a, ha, h⟩
        obtain ⟨m, b, hb⟩ := H c
        refine ⟨m + k, b * a, P.mul_mem_left b ha, ?_⟩
        rw [smul_eq_mul, map_mul, hb, h, pow_add]
        ring }
  have hmem : ∀ P z, z ∈ Λ P ↔ ∃ (k : ℕ) (a : S), a ∈ P ∧ ι a = ι τ ^ k * z :=
    fun P z => Iff.rfl
  have s2 : ∀ P : Ideal S, P.IsPrime → τ ∉ P → ∀ (m : ℕ) (x : S), τ ^ m * x ∈ P → x ∈ P := by
    intro P hP hτ m x h
    rcases hP.mem_or_mem h with h' | h'
    · exact absurd (hP.mem_of_pow_mem m h') hτ
    · exact h'
  have s3 : ∀ P : Ideal S, P.IsPrime → τ ∉ P → (Λ P).comap ι = P := by
    intro P hP hτ
    ext x
    rw [Ideal.mem_comap, hmem]
    constructor
    · rintro ⟨k, a, ha, h⟩
      have hax : a = τ ^ k * x := hι (by rw [h, map_mul, map_pow])
      have hx : τ ^ k * x ∈ P := by rw [← hax]; exact ha
      exact s2 P hP hτ k x hx
    · intro hx
      exact ⟨0, x, hx, by rw [pow_zero, one_mul]⟩
  have s4 : ∀ P : Ideal S, P.IsPrime → τ ∉ P → (Λ P).IsPrime := by
    intro P hP hτ
    rw [Ideal.isPrime_iff]
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : S) ∈ (Λ P).comap ι := by
        rw [Ideal.mem_comap, map_one, htop]; exact Submodule.mem_top
      rw [s3 P hP hτ] at h1
      exact hP.ne_top ((Ideal.eq_top_iff_one P).mpr h1)
    · intro z₁ z₂ hz
      obtain ⟨k, a, ha, h⟩ := (hmem P _).mp hz
      obtain ⟨k₁, a₁, h₁⟩ := H z₁
      obtain ⟨k₂, a₂, h₂⟩ := H z₂
      have heq : τ ^ k * (a₁ * a₂) = τ ^ (k₁ + k₂) * a := by
        apply hι
        rw [map_mul, map_mul, map_mul, map_pow, map_pow, h₁, h₂, h, pow_add]
        ring
      have hm' : τ ^ k * (a₁ * a₂) ∈ P := by rw [heq]; exact P.mul_mem_left _ ha
      have hm : a₁ * a₂ ∈ P := s2 P hP hτ k _ hm'
      rcases hP.mem_or_mem hm with h' | h'
      · exact Or.inl ((hmem P _).mpr ⟨k₁, a₁, h', h₁⟩)
      · exact Or.inr ((hmem P _).mpr ⟨k₂, a₂, h', h₂⟩)
  have s5 : ∀ Q : Ideal T, Q.IsPrime → ι τ ∉ Q → Λ (Q.comap ι) = Q := by
    intro Q hQ hu
    ext z
    rw [hmem]
    constructor
    · rintro ⟨k, a, ha, h⟩
      rw [Ideal.mem_comap, h] at ha
      rcases hQ.mem_or_mem ha with h' | h'
      · exact absurd (hQ.mem_of_pow_mem k h') hu
      · exact h'
    · intro hz
      obtain ⟨k, a, h⟩ := H z
      refine ⟨k, a, ?_, h⟩
      rw [Ideal.mem_comap, h]
      exact Q.mul_mem_left _ hz
  exact ⟨Λ, hmem, fun P hP hτ => ⟨s4 P hP hτ, s3 P hP hτ⟩, s5⟩

theorem wcpa_dj_llsm_obism_int_mod_V : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u)
    [Field L] [Algebra K L] (t : A) (c' b' : ↥W)
    (z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)),
    ∃ p : Polynomial A, p.Monic ∧
      p.eval₂ ((algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)).comp
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}))) z ∈
        Ideal.span {algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩} :=
by
  intro Ω _ W A _ _ K _ _ L _ _ t c' b' z

  have s1 : ∀ (x : K) (r : ↥(Algebra.adjoin A {x})), ∃ (a : A) (s : ↥(Algebra.adjoin A {x})),
      r = algebraMap A ↥(Algebra.adjoin A {x}) a +
        ⟨x, Algebra.subset_adjoin (Set.mem_singleton x)⟩ * s := by
    intro x r
    obtain ⟨y, hy⟩ := r
    have hy' := hy
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hy'
    obtain ⟨f, hf⟩ := hy'
    have hmem : Polynomial.aeval x f.divX ∈ Algebra.adjoin A {x} := by
      rw [Algebra.adjoin_singleton_eq_range_aeval]; exact ⟨_, rfl⟩
    refine ⟨f.coeff 0, ⟨_, hmem⟩, ?_⟩
    apply Subtype.ext
    subst hf
    have e := congrArg (Polynomial.aeval x) (Polynomial.X_mul_divX_add f)
    simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at e
    rw [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
    show (Polynomial.aeval x) f = _
    rw [← e]
    ring

  have s2 : ∀ (R T : Type u) [CommRing R] [CommRing T] (φ : A →+* R) (ψ : R →+* T) (v : R),
      (∀ r : R, ∃ (a : A) (s : R), r = φ a + v * s) → ∀ (q : Polynomial R), q.Monic →
      ∀ z : T, q.eval₂ ψ z = 0 →
        ∃ p : Polynomial A, p.Monic ∧ p.eval₂ (ψ.comp φ) z ∈ Ideal.span {ψ v} := by
    intro R T _ _ φ ψ v hdec q hq z hqz
    choose a s hs using hdec
    refine ⟨Polynomial.X ^ q.natDegree + ∑ i ∈ Finset.range q.natDegree,
      Polynomial.C (a (q.coeff i)) * Polynomial.X ^ i, ?_, ?_⟩
    · apply Polynomial.monic_X_pow_add
      refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
      rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
      intro i hi
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le i _)
        (by exact_mod_cast Finset.mem_range.mp hi)
    · rw [Ideal.mem_span_singleton']
      refine ⟨-(∑ i ∈ Finset.range q.natDegree, ψ (s (q.coeff i)) * z ^ i), ?_⟩
      have hq' := hqz
      rw [hq.as_sum] at hq'
      simp only [Polynomial.eval₂_add, Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul,
        Polynomial.eval₂_C, Polynomial.eval₂_X_pow, RingHom.comp_apply] at hq' ⊢
      have hsum : ∑ i ∈ Finset.range q.natDegree, ψ (q.coeff i) * z ^ i =
          ∑ i ∈ Finset.range q.natDegree, ψ (φ (a (q.coeff i))) * z ^ i +
            ψ v * ∑ i ∈ Finset.range q.natDegree, ψ (s (q.coeff i)) * z ^ i := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        have h := congrArg ψ (hs (q.coeff i))
        rw [map_add, map_mul] at h
        rw [h]
        ring
      rw [hsum] at hq'
      linear_combination -hq'

  obtain ⟨q, hqm, hqz⟩ := integralClosure.isIntegral z
  exact s2 _ _ _ _ _ (s1 _) q hqm z hqz

theorem wcpa_dj_llsm_obism_quot_map : ∀ (S T : Type u) [CommRing S] [CommRing T] (ι : S →+* T)
    (q : Ideal S) [q.IsPrime] (q' : Ideal T) [q'.IsPrime] (_ : q = q'.comap ι)
    (I : Ideal S) (I' : Ideal T), I.map ι ≤ I' →
    ∀ (𝔓 : Ideal (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))))
      (𝔓' : Ideal (Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q')))),
    𝔓.IsPrime → 𝔓'.IsPrime →
    𝔓.comap ((Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))).comp
        (algebraMap S (Localization.AtPrime q))) =
      𝔓'.comap (((Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))).comp
        (algebraMap T (Localization.AtPrime q'))).comp ι) →
    (∀ z : T, ∃ a b : S,
      Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))
          (algebraMap T (Localization.AtPrime q') (ι b)) ∉ 𝔓' ∧
      Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))
          (algebraMap T (Localization.AtPrime q') (ι b * z - ι a)) ∈ 𝔓') →
    (∀ z : T, ∃ p : Polynomial S, p.Monic ∧
      Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))
          (algebraMap T (Localization.AtPrime q') (p.eval₂ ι z)) ∈ 𝔓') →
    (∀ s : T, s ∉ q' → ∃ a : S, a ∉ q ∧ ∃ u : T,
      Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))
          (algebraMap T (Localization.AtPrime q') (s * u - ι a)) ∈ 𝔓') →
    ∃ f : (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))) ⧸ 𝔓 →+*
        (Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q'))) ⧸ 𝔓',
      Function.Injective f ∧
        RingHom.IsIntegral (R := (Localization.AtPrime q ⧸
          I.map (algebraMap S (Localization.AtPrime q))) ⧸ 𝔓) f ∧
        ∀ x, ∃ a b, f b ≠ 0 ∧ x * f b = f a :=
by
  intro S T _ _ ι q _ q' _ hq I I' hI 𝔓 𝔓' h𝔓 h𝔓' hcomp Hbir Hint Hunit
  classical
  let g : Localization.AtPrime q →+* Localization.AtPrime q' :=
    Localization.localRingHom q q' ι hq
  have hg : ∀ s : S, g (algebraMap S _ s) = algebraMap T _ (ι s) := fun s =>
    Localization.localRingHom_to_map q q' ι hq s
  have hle : I.map (algebraMap S (Localization.AtPrime q)) ≤
      (I'.map (algebraMap T (Localization.AtPrime q'))).comap g := by
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_map]
    have e : g.comp (algebraMap S (Localization.AtPrime q)) =
        (algebraMap T (Localization.AtPrime q')).comp ι := RingHom.ext hg
    rw [e, ← Ideal.map_map]
    exact Ideal.map_mono hI
  let gb := Ideal.quotientMap (I'.map (algebraMap T (Localization.AtPrime q'))) g hle
  let ψ0 := (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))).comp
    (algebraMap S (Localization.AtPrime q))
  let ψ1 := (Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))).comp
    (algebraMap T (Localization.AtPrime q'))
  have hgb : ∀ s, gb (ψ0 s) = ψ1 (ι s) := by
    intro s
    show gb (Ideal.Quotient.mk _ (algebraMap S _ s)) = Ideal.Quotient.mk _ (algebraMap T _ (ι s))
    rw [Ideal.quotientMap_mk, hg]
  have hu0 : ∀ s : S, s ∉ q → IsUnit (ψ0 s) := fun s hs =>
    (IsLocalization.map_units (Localization.AtPrime q) (⟨s, hs⟩ : q.primeCompl)).map
      (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q))))
  have hu1 : ∀ s : T, s ∉ q' → IsUnit (ψ1 s) := fun s hs =>
    (IsLocalization.map_units (Localization.AtPrime q') (⟨s, hs⟩ : q'.primeCompl)).map
      (Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q'))))
  have hfr0 : ∀ x, ∃ a s, s ∉ q ∧ x * ψ0 s = ψ0 a := by
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨⟨a, s, hs⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
    refine ⟨a, s, hs, ?_⟩
    have := congrArg (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q))))
      (IsLocalization.mk'_spec (Localization.AtPrime q) a ⟨s, hs⟩)
    rw [map_mul] at this
    exact this
  have hfr1 : ∀ x, ∃ a s, s ∉ q' ∧ x * ψ1 s = ψ1 a := by
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨⟨a, s, hs⟩, rfl⟩ := IsLocalization.mk'_surjective q'.primeCompl y
    refine ⟨a, s, hs, ?_⟩
    have := congrArg (Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q'))))
      (IsLocalization.mk'_spec (Localization.AtPrime q') a ⟨s, hs⟩)
    rw [map_mul] at this
    exact this
  have hd : 𝔓'.comap gb = 𝔓 := by
    ext x
    obtain ⟨a, s, hs, hx⟩ := hfr0 x
    rw [Ideal.mem_comap]
    have key0 : x ∈ 𝔓 ↔ ψ0 a ∈ 𝔓 := by
      obtain ⟨v, hv⟩ := (hu0 s hs).exists_right_inv
      constructor
      · intro h
        rw [← hx]
        exact 𝔓.mul_mem_right _ h
      · intro h
        have e : x = ψ0 a * v := by rw [← hx, mul_assoc, hv, mul_one]
        rw [e]
        exact 𝔓.mul_mem_right _ h
    have key1 : gb x ∈ 𝔓' ↔ ψ1 (ι a) ∈ 𝔓' := by
      have hx' : gb x * ψ1 (ι s) = ψ1 (ι a) := by rw [← hgb, ← hgb, ← map_mul, hx]
      have hus : IsUnit (ψ1 (ι s)) := by rw [← hgb]; exact (hu0 s hs).map gb
      obtain ⟨v, hv⟩ := hus.exists_right_inv
      constructor
      · intro h
        rw [← hx']
        exact 𝔓'.mul_mem_right _ h
      · intro h
        have e : gb x = ψ1 (ι a) * v := by rw [← hx', mul_assoc, hv, mul_one]
        rw [e]
        exact 𝔓'.mul_mem_right _ h
    have key2 : ψ0 a ∈ 𝔓 ↔ ψ1 (ι a) ∈ 𝔓' := by
      have h := SetLike.ext_iff.mp hcomp a
      rw [Ideal.mem_comap, Ideal.mem_comap] at h
      exact h
    exact key1.trans (key2.symm.trans key0.symm)
  let π0 := (Ideal.Quotient.mk 𝔓).comp ψ0
  let π1 := (Ideal.Quotient.mk 𝔓').comp ψ1
  obtain ⟨f, hfinj, hfπ⟩ : ∃ f : (Localization.AtPrime q ⧸
        I.map (algebraMap S (Localization.AtPrime q))) ⧸ 𝔓 →+*
        (Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q'))) ⧸ 𝔓',
      Function.Injective f ∧ ∀ s, f (π0 s) = π1 (ι s) := by
    refine ⟨Ideal.quotientMap 𝔓' gb hd.ge, Ideal.quotientMap_injective' hd.le, ?_⟩
    intro s
    show Ideal.quotientMap 𝔓' gb hd.ge (Ideal.Quotient.mk 𝔓 (ψ0 s)) =
      Ideal.Quotient.mk 𝔓' (ψ1 (ι s))
    rw [Ideal.quotientMap_mk, hgb]
  have : IsDomain ((Localization.AtPrime q' ⧸
      I'.map (algebraMap T (Localization.AtPrime q'))) ⧸ 𝔓') := Ideal.Quotient.isDomain 𝔓'
  have hv1 : ∀ s : T, s ∉ q' → IsUnit (π1 s) := fun s hs => (hu1 s hs).map (Ideal.Quotient.mk 𝔓')
  have hv0 : ∀ s : S, s ∉ q → IsUnit (π0 s) := fun s hs => (hu0 s hs).map (Ideal.Quotient.mk 𝔓)
  have hfr1' : ∀ x, ∃ z s, s ∉ q' ∧ x * π1 s = π1 z := by
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨z, s, hs, hy⟩ := hfr1 y
    refine ⟨z, s, hs, ?_⟩
    show Ideal.Quotient.mk 𝔓' y * Ideal.Quotient.mk 𝔓' (ψ1 s) = Ideal.Quotient.mk 𝔓' (ψ1 z)
    rw [← map_mul, hy]
  have hmem : ∀ t : T, ψ1 t ∈ 𝔓' → π1 t = 0 := fun t ht => Ideal.Quotient.eq_zero_iff_mem.mpr ht
  have hnmem : ∀ t : T, ψ1 t ∉ 𝔓' → π1 t ≠ 0 := fun t ht h =>
    ht (Ideal.Quotient.eq_zero_iff_mem.mp h)
  have Hbir' : ∀ z : T, ∃ a b : S, π1 (ι b) ≠ 0 ∧ π1 (ι b * z - ι a) = 0 := fun z => by
    obtain ⟨a, b, h1, h2⟩ := Hbir z
    exact ⟨a, b, hnmem _ h1, hmem _ h2⟩
  have Hint' : ∀ z : T, ∃ p : Polynomial S, p.Monic ∧ π1 (p.eval₂ ι z) = 0 := fun z => by
    obtain ⟨p, h1, h2⟩ := Hint z
    exact ⟨p, h1, hmem _ h2⟩
  have Hunit' : ∀ s : T, s ∉ q' → ∃ a : S, a ∉ q ∧ ∃ u : T, π1 (s * u - ι a) = 0 :=
    fun s hs => by
      obtain ⟨a, ha, u, h⟩ := Hunit s hs
      exact ⟨a, ha, u, hmem _ h⟩
  have key : ∀ (D0 D1 : Type u) [CommRing D0] [CommRing D1] [IsDomain D1]
      (π0 : S →+* D0) (π1 : T →+* D1) (f : D0 →+* D1),
      (∀ s, f (π0 s) = π1 (ι s)) →
      (∀ s : S, s ∉ q → IsUnit (π0 s)) → (∀ s : T, s ∉ q' → IsUnit (π1 s)) →
      (∀ x, ∃ z s, s ∉ q' ∧ x * π1 s = π1 z) →
      (∀ z : T, ∃ a b : S, π1 (ι b) ≠ 0 ∧ π1 (ι b * z - ι a) = 0) →
      (∀ z : T, ∃ p : Polynomial S, p.Monic ∧ π1 (p.eval₂ ι z) = 0) →
      (∀ s : T, s ∉ q' → ∃ a : S, a ∉ q ∧ ∃ u : T, π1 (s * u - ι a) = 0) →
      f.IsIntegral ∧ ∀ x, ∃ a b, f b ≠ 0 ∧ x * f b = f a := by
    intro D0 D1 _ _ _ π0 π1 f hfπ hv0 hv1 hfr Hbir Hint Hunit
    constructor
    · intro x
      obtain ⟨z, s, hs, hx⟩ := hfr x
      obtain ⟨a, ha, u, hu⟩ := Hunit s hs
      have hu' : π1 s * π1 u = π1 (ι a) := by
        rw [← sub_eq_zero, ← map_mul, ← map_sub]; exact hu
      obtain ⟨p, hpm, hp⟩ := Hint (z * u)
      have hzu : f.IsIntegralElem (π1 (z * u)) := by
        refine ⟨p.map π0, hpm.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        have e : f.comp π0 = π1.comp ι := RingHom.ext hfπ
        rw [e, ← Polynomial.hom_eval₂]
        exact hp
      obtain ⟨r, hr⟩ := (hv0 a ha).exists_left_inv
      have hfr : f r * f (π0 a) = 1 := by rw [← map_mul, hr, map_one]
      apply RingHom.IsIntegralElem.of_mul_unit f x (f (π0 a)) r hfr
      have e : x * f (π0 a) = π1 (z * u) := by
        rw [hfπ, ← hu', map_mul, ← hx]; ring
      rw [e]
      exact hzu
    · intro x
      obtain ⟨z, s, hs, hx⟩ := hfr x
      obtain ⟨a₁, b₁, hb₁, h₁⟩ := Hbir z
      obtain ⟨a₂, b₂, hb₂, h₂⟩ := Hbir s
      have h₁' : π1 (ι b₁) * π1 z = π1 (ι a₁) := by
        rw [← sub_eq_zero, ← map_mul, ← map_sub]; exact h₁
      have h₂' : π1 (ι b₂) * π1 s = π1 (ι a₂) := by
        rw [← sub_eq_zero, ← map_mul, ← map_sub]; exact h₂
      have hπs : π1 s ≠ 0 := (hv1 s hs).ne_zero
      refine ⟨π0 (b₂ * a₁), π0 (a₂ * b₁), ?_, ?_⟩
      · rw [map_mul, map_mul, hfπ, hfπ, ← h₂']
        exact mul_ne_zero (mul_ne_zero hb₂ hπs) hb₁
      · simp only [map_mul, hfπ]
        linear_combination (-(x * π1 (ι b₁))) * h₂' + (π1 (ι b₁) * π1 (ι b₂)) * hx +
          π1 (ι b₂) * h₁'
  have key' := key ((Localization.AtPrime q ⧸
        I.map (algebraMap S (Localization.AtPrime q))) ⧸ 𝔓)
      ((Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q'))) ⧸ 𝔓')
      π0 π1 f
  obtain ⟨hint, hbir⟩ := key' hfπ hv0 hv1 hfr1' Hbir' Hint' Hunit'
  exact ⟨f, hfinj, hint, hbir⟩

theorem wcpa_dj_llsm_obi_strict_match : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L))
        [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w →
        ∃ j : Ideal (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) →
            Ideal (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
              (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w),
          (∀ P ∈ minimalPrimes (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y),
            j P ∈ minimalPrimes (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
              (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) ∧
            wcObiImg W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
              ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∉ j P ∧
            ∃ f : wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ⧸ P →+*
                wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
                  ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w ⧸ j P,
              Function.Injective f ∧ f.IsIntegral ∧
                ∀ x, ∃ a b, f b ≠ 0 ∧ x * f b = f a) ∧
          Set.InjOn j (minimalPrimes (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)) ∧
          (∀ Q ∈ minimalPrimes (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
              (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w),
            wcObiImg W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
              ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∉ Q →
            ∃ P ∈ minimalPrimes (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y),
              j P = Q) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0
    w _ hwc hwU
  classical

  have key : ∀ (S T : Type u) [CommRing S] [CommRing T] (ι : S →+* T), Function.Injective ι →
      ∀ (τ : S) (τT : T), τT = ι τ → ∀ v : T, (∀ z : T, ∃ (k : ℕ) (a : S), ι a = ι τ ^ k * z) →
      ∀ (q : Ideal S) [q.IsPrime] (q' : Ideal T) [q'.IsPrime], q = q'.comap ι →
      ∀ (I : Ideal S) (I' : Ideal T), I' = I.map ι → I ≤ q →
      (∀ P ∈ I.minimalPrimes, P ≤ q → τ ∉ P) →
      (∃ b ∈ I, ι τ * v = ι b) →
      (∀ J : Ideal T, v ∈ J → J.comap ι ≤ q → J ≤ q') →
      (∀ z : T, ∃ p : Polynomial S, p.Monic ∧ p.eval₂ ι z ∈ Ideal.span {v}) →
      ∃ j : Ideal (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))) →
          Ideal (Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q'))),
        (∀ P ∈ minimalPrimes
            (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))),
          j P ∈ minimalPrimes
            (Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q'))) ∧
          Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))
            (algebraMap T (Localization.AtPrime q') τT) ∉ j P ∧
          ∃ f : (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))) ⧸ P →+*
              (Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q'))) ⧸ j P,
            Function.Injective f ∧
              RingHom.IsIntegral (R := (Localization.AtPrime q ⧸
                I.map (algebraMap S (Localization.AtPrime q))) ⧸ P) f ∧
              ∀ x, ∃ a b, f b ≠ 0 ∧ x * f b = f a) ∧
        Set.InjOn j (minimalPrimes
          (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q)))) ∧
        (∀ Q ∈ minimalPrimes
            (Localization.AtPrime q' ⧸ I'.map (algebraMap T (Localization.AtPrime q'))),
          Ideal.Quotient.mk (I'.map (algebraMap T (Localization.AtPrime q')))
