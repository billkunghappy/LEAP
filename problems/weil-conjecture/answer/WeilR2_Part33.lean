by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y c'' b₀ β A'' _ _ _ _ _ _ _ t' 𝔭''
    hPD hyp hyc hU hδ hc hb₀ hb₀0 hSub ht' hPD'' hβ hβ0 hSep

  have hb0 : b₀ * β ≠ 0 := mul_ne_zero hb₀0 hβ0

  obtain ⟨Q, hQp, hQc, hQU⟩ := wcpa_dj_llsm_sc_residue_uniq Ω W hW hWt A K L 𝔭 t y hPD hyp hyc
    hU c'' b₀ (b₀ * β) β hc hb₀ hb₀0 hβ rfl hb0 hSep
  haveI := hQp

  obtain ⟨y'', hy''p, hy''c, hU'', hiso⟩ := wcpa_dj_llsm_rp_chart_transfer Ω W A K L 𝔭 t c'' b₀
    A'' t' 𝔭'' hPD hc hb₀ hb₀0 hSub ht' hPD'' Q hQc hQU
  refine ⟨y'', hy''p, hy''c, hU'', fun hp hδ0 => ?_⟩
  rw [hiso hp] at hδ0
  exact hδ hyp (wcpa_dj_llsm_sc_disc_criterion Ω W hW hWt A K L 𝔭 t y hPD hyp hyc hU c'' b₀
