    (wcLlsDiscSep W A'' K L t' e β' ↔ wcLlsRsiSep2 W A K L t (c'' + b₀ * e) b₀ (b₀ * β')) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ 𝔭 t c'' b₀ e β' A'' _ _ _ _ _ t' 𝔭'' hPD hc'' hb₀m hb₀0 hBr ht' hPD'' hem hβ'm hβ'0
  have nodeMax : ∀ (A : Type u) [CommRing A] (K : Type u) [CommRing K]
    [Algebra A K] (𝔭 : Ideal A) (G : Set K) (hmax : 𝔭.IsMaximal)
    (N J : Ideal ↥(Algebra.adjoin A G))
    (hG : ∀ (g : K) (hg : g ∈ G), (⟨g, Algebra.subset_adjoin hg⟩ : ↥(Algebra.adjoin A G)) ∈ N)
    (hpN : 𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A G))) (hNJ : N ≤ J) (hJ : J ≠ ⊤), J = N := by
    intro A _ K _ _ 𝔭 G hmax N J hG hpN hNJ hJ
    have nf : ∀ x (hx : x ∈ Algebra.adjoin A G), ∃ a : A,
        (⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ a ∈ N := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact ⟨0, by rw [map_zero, sub_zero]; exact hG x hx⟩
      | algebraMap a =>
        refine ⟨a, ?_⟩
        have e : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(Algebra.adjoin A G)) =
            algebraMap A _ a := rfl
        rw [e, sub_self]; exact N.zero_mem
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a + b, ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ (a + b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ a) +
            ((⟨y, hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ b) := by
          have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin A G)) =
              (⟨x, hx⟩ : ↥(Algebra.adjoin A G)) + ⟨y, hy⟩ := rfl
          rw [e1, map_add]; ring
        rw [e]; exact add_mem ha hb
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a * b, ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ (a * b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ a) * ⟨y, hy⟩ +
            algebraMap A _ a * ((⟨y, hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ b) := by
          have e1 : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin A G)) =
              (⟨x, hx⟩ : ↥(Algebra.adjoin A G)) * ⟨y, hy⟩ := rfl
          rw [e1, map_mul]; ring
        rw [e]; exact add_mem (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hb)
    refine le_antisymm ?_ hNJ
    intro x hxJ
    obtain ⟨a, ha⟩ := nf x.1 x.2
    have ha' : x - algebraMap A _ a ∈ N := ha
    have haJ : algebraMap A ↥(Algebra.adjoin A G) a ∈ J := by
      have e : algebraMap A ↥(Algebra.adjoin A G) a = x - (x - algebraMap A _ a) := by ring
      rw [e]; exact sub_mem hxJ (hNJ ha')
    by_cases hc0 : a ∈ 𝔭
    · have e : x = (x - algebraMap A _ a) + algebraMap A _ a := by ring
      rw [e]; exact add_mem ha' (hpN hc0)
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hmax.exists_inv hc0
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(Algebra.adjoin A G)) =
          algebraMap A _ β * algebraMap A _ a + algebraMap A _ i := by
        rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hpN hi))
  have adjDen : ∀ (A'' : Type u) [CommRing A''] (K : Type u) [CommRing K] [Algebra A'' K]
    (s : K) (T : Subring K) (M : Submonoid K) (hMT : ∀ q ∈ M, q ∈ T)
    (hs : ∃ q ∈ M, q * s ∈ T) (ha : ∀ a : A'', ∃ q ∈ M, q * algebraMap A'' K a ∈ T), ∀ r ∈ Algebra.adjoin A'' {s}, ∃ q ∈ M, q * r ∈ T := by
    intro A'' _ K _ _ s T M hMT hs ha
    intro r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx => rw [Set.mem_singleton_iff] at hx; subst hx; exact hs
    | algebraMap a => exact ha a
    | add x y _ _ hx hy =>
      obtain ⟨q₁, hq₁, h₁⟩ := hx
      obtain ⟨q₂, hq₂, h₂⟩ := hy
      refine ⟨q₁ * q₂, mul_mem hq₁ hq₂, ?_⟩
