        have e2 := hl Ek hEk.1.1 htEk hEk.1.2 k hEkK l (heq ▸ hlE)
        rw [← e1, ← e2]
    · exact ⟨hex P hP htP (hI𝔶.trans h𝔶P), hun P hP htP⟩
  have s2a : ∀ (κ : Type u) [Field κ] (f : LaurentPolynomial κ), IsUnit f →
      ∃ (c : κ) (k : ℤ), c ≠ 0 ∧ f = LaurentPolynomial.C c * LaurentPolynomial.T k := by
    intro κ _ f hf
    obtain ⟨g, hfg⟩ := hf.exists_right_inv
    obtain ⟨N, f', hf'⟩ := LaurentPolynomial.exists_T_pow f
    obtain ⟨M, g', hg'⟩ := LaurentPolynomial.exists_T_pow g
    have h1 : Polynomial.toLaurent (f' * g') =
        Polynomial.toLaurent (Polynomial.X ^ (N + M)) := by
      rw [map_mul, hf', hg', Polynomial.toLaurent_X_pow]
      calc f * LaurentPolynomial.T (N : ℤ) * (g * LaurentPolynomial.T (M : ℤ))
          = (f * g) * (LaurentPolynomial.T (N : ℤ) * LaurentPolynomial.T (M : ℤ)) := by ring
        _ = LaurentPolynomial.T ((N + M : ℕ) : ℤ) := by
          rw [hfg, one_mul, ← LaurentPolynomial.T_add]; push_cast; rfl
    have h2 := Polynomial.toLaurent_injective h1
    have hdvd : f' ∣ Polynomial.X ^ (N + M) := ⟨g', h2.symm⟩
    obtain ⟨i, _, hassoc⟩ := (dvd_prime_pow Polynomial.prime_X _).mp hdvd
    obtain ⟨w, hw⟩ := hassoc
    obtain ⟨r, hr, hrw⟩ := Polynomial.isUnit_iff.mp (w⁻¹).isUnit
    have hf'eq : f' = Polynomial.C r * Polynomial.X ^ i := by
      calc f' = f' * ↑w * ↑w⁻¹ := by rw [mul_assoc, Units.mul_inv, mul_one]
        _ = _ := by rw [hw, hrw, mul_comm]
    refine ⟨r, (i : ℤ) - N, hr.ne_zero, ?_⟩
    have h3 : f * LaurentPolynomial.T (N : ℤ) = LaurentPolynomial.C r * LaurentPolynomial.T (i : ℤ) := by
      rw [← hf', hf'eq, Polynomial.toLaurent_C_mul_X_pow]
    calc f = f * LaurentPolynomial.T (N : ℤ) * LaurentPolynomial.T (-(N : ℤ)) := by
          rw [mul_assoc, ← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero, mul_one]
      _ = LaurentPolynomial.C r * LaurentPolynomial.T ((i : ℤ) - N) := by
          rw [h3, mul_assoc, ← LaurentPolynomial.T_add, sub_eq_add_neg]
  have s2b : ∀ (κ : Type u) [Field κ] (f : LaurentPolynomial κ), IsUnit f →
      (IsUnit (1 + f) ∨ 1 + f = 0) → ∃ c : κ, f = LaurentPolynomial.C c := by
    intro κ _ f hf hu
    obtain ⟨c, k, hc, rfl⟩ := s2a κ f hf
    by_cases hk : k = 0
    · exact ⟨c, by rw [hk, LaurentPolynomial.T_zero, mul_one]⟩
    exfalso
    have hco : ∀ (a : κ) (m n : ℤ),
        (LaurentPolynomial.C a * LaurentPolynomial.T m : LaurentPolynomial κ).coeff n =
          if m = n then a else 0 := by
      intro a m n
      rw [← LaurentPolynomial.single_eq_C_mul_T, AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
    have h1 : ∀ n, (1 : LaurentPolynomial κ).coeff n = if 0 = n then 1 else 0 := by
      intro n
      rw [← LaurentPolynomial.single_zero_one_eq_one, AddMonoidAlgebra.coeff_single,
        Finsupp.single_apply]
    have e0 : (1 + LaurentPolynomial.C c * LaurentPolynomial.T k).coeff 0 = 1 := by
      simp only [AddMonoidAlgebra.coeff_add, Finsupp.coe_add, Pi.add_apply, h1, hco]; simp [hk]
    have ek : (1 + LaurentPolynomial.C c * LaurentPolynomial.T k).coeff k = c := by
      simp only [AddMonoidAlgebra.coeff_add, Finsupp.coe_add, Pi.add_apply, h1, hco]
      simp [Ne.symm hk]
