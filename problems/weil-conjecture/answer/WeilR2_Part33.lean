      N Q hQc hQU hNic hNdvr
    have hdimF : ringKrullDim (Localization.AtPrime Q ⧸ (Ideal.map
        (algebraMap ↥W ↥(integralClosure R L)) (IsLocalRing.maximalIdeal ↥W)).map
          (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) =
        ((1 : ℕ) : WithBot ℕ∞) := hdimF0

    haveI : Nontrivial (wcLlsFS W wL R Q) := e.toEquiv.nontrivial
    haveI : IsLocalRing (wcLlsFS W wL R Q) :=
