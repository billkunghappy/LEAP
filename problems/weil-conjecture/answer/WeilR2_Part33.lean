    rw [Ideal.under_def] at hov
    exact hov.symm
  obtain ⟨_, _, _, h𝔭max, hm𝔭, hgm, _, _, h𝔭eq, h, hh, f, hfC, hf0, hf1, hfet⟩ := hPD
  have h𝔭prime : 𝔭.IsPrime := h𝔭max.isPrime
  have hdisj : Disjoint (Submonoid.powers h : Set A) (𝔭 : Set A) :=
    (Ideal.disjoint_powers_iff_notMem h h𝔭prime.isRadical).mpr hh
  have h𝔓prime : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h) 𝔭
      h𝔭prime hdisj
  have h𝔓comap : (𝔭.map (algebraMap A (Localization.Away h))).comap
      (algebraMap A (Localization.Away h)) = 𝔭 := by
    have := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h)
      (Localization.Away h) h𝔭prime hdisj
    rw [Ideal.under_def] at this
    exact this
  have hfCw : ∀ w : ↥W, f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g}) (MvPolynomial.C w)) =
      algebraMap A (Localization.Away h) (algebraMap ↥W A w) := fun w => by
    have := RingHom.congr_fun hfC w
    simpa using this

  let φt : MvPolynomial (Fin 2) ↥W →+* Polynomial (↥W ⧸ IsLocalRing.maximalIdeal ↥W) :=
    MvPolynomial.eval₂Hom (Polynomial.C.comp (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)))
      (![Polynomial.X, 0] : Fin 2 → Polynomial (↥W ⧸ IsLocalRing.maximalIdeal ↥W))
  have hφC : ∀ w : ↥W, φt (MvPolynomial.C w) =
      Polynomial.C (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W) w) := by
    intro w; simp [φt]
  have hφX0 : φt (MvPolynomial.X 0) = Polynomial.X := by simp [φt]
  have hφX1 : φt (MvPolynomial.X 1) = 0 := by simp [φt]
  have hker : ∀ a ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
      MvPolynomial (Fin 2) ↥W)}, φt a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_sub, map_mul, hφX0, hφX1, hφC, Ideal.Quotient.eq_zero_iff_mem.mpr hgm]
    simp
  let φ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}) →+*
      Polynomial (↥W ⧸ IsLocalRing.maximalIdeal ↥W) :=
    Ideal.Quotient.lift (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}) φt hker
  have hφmk : ∀ F, φ (Ideal.Quotient.mk _ F) = φt F := fun F => Ideal.Quotient.lift_mk _ _ _
  have hp₀prime : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ

  have hψ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ((Ideal.Quotient.mk (𝔭.map (algebraMap A (Localization.Away h)))).comp
        ((algebraMap A (Localization.Away h)).comp (algebraMap ↥W A))) w = 0 := by
    intro w hw
    simp only [RingHom.comp_apply]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.mem_map_of_mem _ (hm𝔭 (Ideal.mem_map_of_mem _ hw)))
  let ψ := Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W)
    ((Ideal.Quotient.mk (𝔭.map (algebraMap A (Localization.Away h)))).comp
        ((algebraMap A (Localization.Away h)).comp (algebraMap ↥W A))) hψ
  let χ := Polynomial.eval₂RingHom ψ
    (Ideal.Quotient.mk (𝔭.map (algebraMap A (Localization.Away h)))
      (algebraMap A (Localization.Away h) u))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  have hχ : χ.comp φt = (Ideal.Quotient.mk (𝔭.map (algebraMap A (Localization.Away h)))).comp
      (f.comp (Ideal.Quotient.mk _)) := by
    apply MvPolynomial.ringHom_ext
    · intro w
      show χ (φt (MvPolynomial.C w)) = Ideal.Quotient.mk _ (f (Ideal.Quotient.mk _
        (MvPolynomial.C w)))
      rw [hfCw, hφC]
      simp [χ, ψ]
    · have e0 : χ (φt (MvPolynomial.X 0)) = Ideal.Quotient.mk _ (f (Ideal.Quotient.mk
          (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
            MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.X 0))) := by
        rw [hφX0, hf0]
        simp [χ]
      have e1 : χ (φt (MvPolynomial.X 1)) = Ideal.Quotient.mk _ (f (Ideal.Quotient.mk
          (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
            MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.X 1))) := by
        rw [hφX1, hf1, map_zero]
        exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hv𝔭)).symm
      intro i
      fin_cases i
      · exact e0
      · exact e1
  have hle : RingHom.ker φ ≤ (𝔭.map (algebraMap A (Localization.Away h))).comap f := by
    intro x hx
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [RingHom.mem_ker, hφmk] at hx
    have h1 := RingHom.congr_fun hχ F
    simp only [RingHom.comp_apply] at h1
    rw [hx, map_zero] at h1
    show f _ ∈ 𝔭.map (algebraMap A (Localization.Away h))
    exact (Ideal.Quotient.eq_zero_iff_mem (I := 𝔭.map (algebraMap A (Localization.Away h)))).mp
      h1.symm
  have hmemp₀ : ∀ F, Ideal.Quotient.mk _ F ∈ RingHom.ker φ ↔ φt F = 0 := fun F => by
    rw [RingHom.mem_ker, hφmk]
  generalize RingHom.ker φ = p₀ at hp₀prime hle hmemp₀
  have hGD' := hGD (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
    (Localization.Away h) f hfet
  obtain ⟨Q₀, hQ₀le, hQ₀, hQ₀eq⟩ := hGD' p₀ _ hp₀prime h𝔓prime hle
  refine ⟨Q₀.comap (algebraMap A (Localization.Away h)),
    Ideal.comap_isPrime (algebraMap A (Localization.Away h)) Q₀, ?_, ?_, ?_⟩
  · rw [← h𝔓comap]; exact Ideal.comap_mono hQ₀le
  · rw [Ideal.map_le_iff_le_comap]
    intro w hw
    show algebraMap A (Localization.Away h) (algebraMap ↥W A w) ∈ Q₀
    rw [← hfCw]
    have hC : Ideal.Quotient.mk _ (MvPolynomial.C w) ∈ Q₀.comap f := by
      rw [hQ₀eq, hmemp₀, hφC, Ideal.Quotient.eq_zero_iff_mem.mpr hw, map_zero]
    exact hC
  · intro hmem
    have h1 : Ideal.Quotient.mk _ (MvPolynomial.X 0) ∈ Q₀.comap f := by
      show f _ ∈ Q₀
      rw [hf0]; exact hmem
    rw [hQ₀eq, hmemp₀, hφX0] at h1
    exact Polynomial.X_ne_zero h1

theorem wcpa_dj_llsm_isice_branch_exist : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ g →
    ∀ (y : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y.IsPrime →
    y.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    ∃ Ps Pu : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L),
      Ps ∈ (Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes ∧
      Pu ∈ (Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes ∧
      Ps ≤ y ∧ Pu ≤ y ∧
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ Ps ∧
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) u) ∉ Ps ∧
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) u) ∈ Pu ∧
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∉ Pu :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g b hPD hbm hb0 hbg y hy hyc
  classical
  haveI := hy
  have hPD' := hPD
  obtain ⟨_, _, _, _, _, _, hg0, huv, h𝔭eq, _⟩ := hPD'
  obtain ⟨hh, hgh⟩ := hbg
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    have hu : u = 0 := IsFractionRing.injective A K (h.trans (map_zero _).symm)
    rw [hu, zero_mul] at huv
    exact hg0 (hWA (huv.symm.trans (map_zero _).symm))
  have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A hh) *
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) := by
    have h1 : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K (algebraMap ↥W A hh) := by
      rw [← map_mul, huv, hgh, map_mul, map_mul]
    field_simp
    rw [mul_comm (algebraMap A K v), h1]; ring

  have h𝔭N : 𝔭 ≤ (wcLlsASbN W A K u b).comap (algebraMap A ↥(wcLlsASbS W A K u b)) := by
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with hz | hz
      · rw [hz]
        exact Ideal.mem_comap.mpr (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
      · rw [Set.mem_singleton_iff] at hz
        rw [hz]
        have : algebraMap A ↥(wcLlsASbS W A K u b) v =
            algebraMap A _ (algebraMap ↥W A hh) *
              ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
                Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
          apply Subtype.ext
          exact hvK
        show _ ∈ wcLlsASbN W A K u b
        rw [this]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_sup_left (Ideal.subset_span
          (Set.mem_insert_of_mem _ rfl)))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  obtain ⟨𝔭₀, h0p, h0le, h0m, h0u⟩ :=
    wcpa_dj_llsm_isirbc_ann_fibre_generic_prime Ω W A 𝔭 u v g hPD
  have hb𝔭₀ : algebraMap ↥W A b ∈ 𝔭₀ := h0m (Ideal.mem_map_of_mem _ hbm)
  obtain ⟨𝔫s, hsp, hsc, hsJ⟩ := wcpa_dj_llsm_scbc_branch_prime A K u (algebraMap ↥W A b) 𝔭₀
    h0p hb𝔭₀ h0u (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) rfl
  have hsN : 𝔫s ≤ wcLlsASbN W A K u b := by
    apply hsJ
    · exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    · rw [Ideal.map_le_iff_le_comap]
      exact h0le.trans h𝔭N
  have hsm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w) ∈ 𝔫s := by
    intro w hw
    have h1 := h0m (Ideal.mem_map_of_mem _ hw)
    rw [← hsc] at h1
    exact h1
  have hsu : algebraMap A ↥(wcLlsASbS W A K u b) u ∉ 𝔫s := by
    intro h
    apply h0u
    rw [← hsc]
    exact h

  have hne : wcLlsASbN W A K u b ≠ ⊤ := by
    rw [← hyc]; exact (Ideal.IsPrime.comap _).ne_top
  have hmax : (wcLlsASbN W A K u b).IsMaximal :=
    wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u b hPD
      (Or.inr ⟨v, g, rfl, ⟨hh, hgh⟩⟩) hbm hb0 _ rfl hne
  haveI := hmax
  haveI hNp : (wcLlsASbN W A K u b).IsPrime := hmax.isPrime
  obtain ⟨_, hnorm, hpresAll⟩ := wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 (.ann u v g) u b
    hPD (Or.inr ⟨v, g, rfl, ⟨hh, hgh⟩⟩) hbm hb0 _ rfl (wcLlsASbN W A K u b) rfl
  obtain ⟨P, _, e, he⟩ := wcNd_hens_exists (Localization.AtPrime (wcLlsASbN W A K u b))
    (IsLocalRing.maximalIdeal _) (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  obtain ⟨f, hpres, hf0, hf1⟩ := hpresAll P e he
  unfold wcEbntPres at hpres
  obtain ⟨_, _, hσ, hhens⟩ := hpres

  have hs5 : ((Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
        (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) * MvPolynomial.X 1 -
          MvPolynomial.C b}))).IsPrime ∧
      ∃ p₀ : Ideal (wcEbntN W b), p₀.IsPrime ∧
        p₀ ≤ (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
            (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) * MvPolynomial.X 1 -
              MvPolynomial.C b})) ∧
        wcEbntX W b 0 ∈ p₀ ∧ wcEbntX W b 1 ∉ p₀ ∧
        ∀ w ∈ IsLocalRing.maximalIdeal ↥W, Ideal.Quotient.mk (Ideal.span
          {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) * MvPolynomial.X 1 - MvPolynomial.C b})
            (MvPolynomial.C w) ∈ p₀ := by
    have hres : IsLocalRing.residue ↥W b = 0 := (IsLocalRing.residue_eq_zero_iff b).mpr hbm
    obtain ⟨Φ₀, hΦC, hΦX⟩ : ∃ Φ₀ : MvPolynomial (Fin 2) ↥W →+*
        Polynomial (IsLocalRing.ResidueField ↥W),
        (∀ r, Φ₀ (MvPolynomial.C r) = Polynomial.C (IsLocalRing.residue ↥W r)) ∧
        (∀ i, Φ₀ (MvPolynomial.X i) = ![0, Polynomial.X] i) :=
      ⟨MvPolynomial.eval₂Hom (Polynomial.C.comp (IsLocalRing.residue ↥W)) ![0, Polynomial.X],
        fun r => by simp, fun i => by simp⟩
    have hΦb : Φ₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b) = 0 := by
      rw [map_sub, map_mul, hΦX, hΦX, hΦC, hres]
      simp
    have hΦJ : ∀ a ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) *
        MvPolynomial.X 1 - MvPolynomial.C b}, Φ₀ a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hΦb, mul_zero]
    set J0 := Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) * MvPolynomial.X 1 -
        MvPolynomial.C b} with hJ0
    set φ₀ := Ideal.Quotient.lift J0 Φ₀ hΦJ with hφ₀
    have hφmk : ∀ x, φ₀ (Ideal.Quotient.mk J0 x) = Φ₀ x := fun x => Ideal.Quotient.lift_mk _ _ _
    set ε := (Polynomial.evalRingHom (0 : IsLocalRing.ResidueField ↥W)).comp φ₀ with hε
    have hcomp : (Polynomial.evalRingHom (0 : IsLocalRing.ResidueField ↥W)).comp Φ₀ =
        (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [hΦC]
      · intro i
        rw [RingHom.comp_apply, RingHom.comp_apply, hΦX, MvPolynomial.constantCoeff_X, map_zero]
        fin_cases i <;> simp
    have hεmk : ∀ x, ε (Ideal.Quotient.mk J0 x) =
        IsLocalRing.residue ↥W (MvPolynomial.constantCoeff x) := by
      intro x
      rw [hε, RingHom.comp_apply, hφmk]
      exact RingHom.congr_fun hcomp x
    set S := Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} with hS
    have hXS : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) ↥W) ∈ S :=
      Fin.forall_fin_two.mpr ⟨Ideal.subset_span (Set.mem_insert _ _),
        Ideal.subset_span (Set.mem_insert_of_mem _ rfl)⟩
    have hdec : ∀ p : MvPolynomial (Fin 2) ↥W,
        p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈ S := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => rw [MvPolynomial.constantCoeff_C, sub_self]; exact S.zero_mem
      | add p q hp hq =>
        have : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
          rw [map_add, map_add]; ring
        rw [this]; exact S.add_mem hp hq
      | mul_X p n hp =>
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
        exact S.mul_mem_left _ (hXS n)
    have h𝔬eq : (S ⊔ (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
        (Ideal.Quotient.mk J0) = RingHom.ker ε := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        apply sup_le
        · rw [Ideal.span_le]
          intro z hz
          rcases hz with rfl | hz
          · show ε (Ideal.Quotient.mk J0 _) = 0
            rw [hεmk, MvPolynomial.constantCoeff_X, map_zero]
          · rw [Set.mem_singleton_iff] at hz
            subst hz
            show ε (Ideal.Quotient.mk J0 _) = 0
            rw [hεmk, MvPolynomial.constantCoeff_X, map_zero]
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          show ε (Ideal.Quotient.mk J0 _) = 0
          rw [hεmk, MvPolynomial.constantCoeff_C]
          exact (IsLocalRing.residue_eq_zero_iff w).mpr hw
      · intro x hx
        obtain ⟨x', rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [RingHom.mem_ker, hεmk, IsLocalRing.residue_eq_zero_iff] at hx
        have hsplit : x' = (x' - MvPolynomial.C (MvPolynomial.constantCoeff x')) +
            MvPolynomial.C (MvPolynomial.constantCoeff x') := by ring
        rw [hsplit]
        apply Ideal.mem_map_of_mem
        exact Ideal.add_mem _ (Ideal.mem_sup_left (hdec x'))
          (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hx))
    refine ⟨by rw [h𝔬eq]; exact RingHom.ker_isPrime ε, RingHom.ker φ₀, RingHom.ker_isPrime φ₀,
      ?_, ?_, ?_, ?_⟩
    · rw [h𝔬eq]
      intro x hx
      rw [RingHom.mem_ker] at hx ⊢
      rw [hε, RingHom.comp_apply, hx, map_zero]
    · show φ₀ (Ideal.Quotient.mk J0 _) = 0
      rw [hφmk, hΦX]
      rfl
    · intro h
      have h1 : φ₀ (Ideal.Quotient.mk J0 (MvPolynomial.X 1)) = 0 := h
      rw [hφmk, hΦX] at h1
      exact Polynomial.X_ne_zero h1
    · intro w hw
      show φ₀ (Ideal.Quotient.mk J0 _) = 0
      rw [hφmk, hΦC, (IsLocalRing.residue_eq_zero_iff w).mpr hw, map_zero]

  have hdown : ∀ (B : Type u) [CommRing B] (𝔬 : Ideal B), 𝔬.IsPrime → ∀ (P : Type u)
      [CommRing P] (f : B →+* P), wcNdIsHens 𝔬 P f → ∀ (q : Ideal B), q.IsPrime → q ≤ 𝔬 →
      ∃ 𝔓 : Ideal P, 𝔓.IsPrime ∧ (∀ x ∈ 𝔓, ¬ IsUnit x) ∧ 𝔓.comap f = q := by
    intro B _ 𝔬 h𝔬 P _ f hf q hq hq𝔬
    haveI := h𝔬
    obtain ⟨hHen, hunit, huniv⟩ := hf
    haveI : IsLocalRing P := hHen.toIsLocalRing
    have hM : ∀ y : 𝔬.primeCompl, IsUnit (f y) := fun y => (hunit y).mpr y.2
    obtain ⟨f', hf'c⟩ : ∃ f' : Localization.AtPrime 𝔬 →+* P,
        f'.comp (algebraMap B (Localization.AtPrime 𝔬)) = f :=
      ⟨_, IsLocalization.lift_comp hM⟩
    have hf'a : ∀ a, f' (algebraMap B (Localization.AtPrime 𝔬) a) = f a :=
      fun a => RingHom.congr_fun hf'c a
    have hH : wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔬)) P f' := by
      refine ⟨hHen, ?_, ?_⟩
      · intro x
        obtain ⟨⟨a, σ⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔬.primeCompl x
        simp only
        rw [IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime 𝔬) 𝔬]
        have h1 : f' (IsLocalization.mk' (Localization.AtPrime 𝔬) a σ) * f σ = f a := by
          rw [← hf'a, ← hf'a, ← map_mul, IsLocalization.mk'_spec]
        rw [← hunit a, ← h1]
        constructor
        · intro hx; exact hx.mul (hM σ)
        · intro hx; exact isUnit_of_mul_isUnit_left hx
      · intro B' _ hB' g hg
        have hg0 : ∀ a, IsUnit ((g.comp (algebraMap B (Localization.AtPrime 𝔬))) a) ↔
            a ∉ 𝔬 := by
          intro a
          rw [RingHom.comp_apply, hg,
            IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔬) 𝔬]
        obtain ⟨h, ⟨hhc, hhl⟩, huniq⟩ := huniv B' hB' (g.comp (algebraMap B _)) hg0
        refine ⟨h, ⟨?_, hhl⟩, ?_⟩
        · apply IsLocalization.ringHom_ext 𝔬.primeCompl
          rw [RingHom.comp_assoc, hf'c, hhc]
        · rintro h' ⟨hh'c, hh'l⟩
          apply huniq h'
          refine ⟨?_, hh'l⟩
          rw [← hh'c, RingHom.comp_assoc, hf'c]
    have hdisj : Disjoint (𝔬.primeCompl : Set B) (q : Set B) := by
      rw [Set.disjoint_left]
      intro a ha haq
      exact ha (hq𝔬 haq)
    have hqm := IsLocalization.isPrime_of_isPrime_disjoint 𝔬.primeCompl
      (Localization.AtPrime 𝔬) q hq hdisj
    have hle : q.map (algebraMap B (Localization.AtPrime 𝔬)) ≤
        (IsLocalRing.maximalIdeal P).comap f' := by
      rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, hf'c]
      intro a ha
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit, not_not]
      exact hq𝔬 ha
    obtain ⟨𝔓, h𝔓p, h𝔓le, h𝔓c⟩ := wcpa_dj_llsm_scbc_hens_going_down (Localization.AtPrime 𝔬)
      P f' hH _ _ hqm (IsLocalRing.maximalIdeal.isMaximal P).isPrime hle
    refine ⟨𝔓, h𝔓p, fun x hx => (IsLocalRing.mem_maximalIdeal x).mp (h𝔓le hx), ?_⟩
    rw [← hf'c, ← Ideal.comap_comap, h𝔓c]
    exact IsLocalization.comap_map_of_isPrime_disjoint 𝔬.primeCompl _ hq hdisj

  obtain ⟨h𝔬, p₀, hp0p, hp0le, hX0, hX1, hpm⟩ := hs5
  obtain ⟨𝔓, h𝔓p, h𝔓nu, h𝔓c⟩ := hdown (wcEbntN W b) _ h𝔬 P f hhens p₀ hp0p hp0le
  haveI := h𝔓p
  have hum : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w) ∈
        𝔓.comap (e.comp (algebraMap ↥(wcLlsASbS W A K u b)
          (Localization.AtPrime (wcLlsASbN W A K u b)))) := by
    intro w hw
    have h1 := hpm w hw
    rw [← h𝔓c, Ideal.mem_comap] at h1
    have h2 : f (Ideal.Quotient.mk _ (MvPolynomial.C w)) =
        (e.comp (algebraMap ↥(wcLlsASbS W A K u b)
          (Localization.AtPrime (wcLlsASbN W A K u b))))
          (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w)) :=
      RingHom.congr_fun hσ w
    rw [h2] at h1
    exact h1
  have huu : algebraMap A ↥(wcLlsASbS W A K u b) u ∈
      𝔓.comap (e.comp (algebraMap ↥(wcLlsASbS W A K u b)
        (Localization.AtPrime (wcLlsASbN W A K u b)))) := by
    have h1 := hX0
    rw [← h𝔓c, Ideal.mem_comap, hf0] at h1
    exact h1
  have hsnot : (⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
      Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(wcLlsASbS W A K u b)) ∉
      𝔓.comap (e.comp (algebraMap ↥(wcLlsASbS W A K u b)
        (Localization.AtPrime (wcLlsASbN W A K u b)))) := by
    intro h
    apply hX1
    rw [← h𝔓c, Ideal.mem_comap, hf1]
    exact h
  have hun : 𝔓.comap (e.comp (algebraMap ↥(wcLlsASbS W A K u b)
      (Localization.AtPrime (wcLlsASbN W A K u b)))) ≤ wcLlsASbN W A K u b := by
    intro x hx
    have h1 : ¬ IsUnit (e (algebraMap _ (Localization.AtPrime (wcLlsASbN W A K u b)) x)) :=
      h𝔓nu _ hx
    rw [he.2.1, not_not] at h1
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
      (Localization.AtPrime (wcLlsASbN W A K u b)) (wcLlsASbN W A K u b) x).mp h1

  have hinj : Function.Injective (algebraMap ↥(wcLlsASbS W A K u b)
      ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) := by
    intro x x' hxx
    have h1 := congrArg Subtype.val hxx
    apply Subtype.ext
    apply (algebraMap K L).injective
    exact h1
  have hcoe : ∀ a : A, ((algebraMap ↥(wcLlsASbS W A K u b)
      ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      (algebraMap A ↥(wcLlsASbS W A K u b) a) :
        ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) : L) =
      algebraMap K L (algebraMap A K a) := fun a => rfl
  have hdesc : ∀ 𝔫 : Ideal ↥(wcLlsASbS W A K u b), 𝔫.IsPrime → 𝔫 ≤ wcLlsASbN W A K u b →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w) ∈ 𝔫) →
      ∃ Q ∈ (Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes,
        Q ≤ y ∧ ∀ r : ↥(wcLlsASbS W A K u b), algebraMap ↥(wcLlsASbS W A K u b)
          ↥(integralClosure ↥(wcLlsASbS W A K u b) L) r ∈ Q → r ∈ 𝔫 := by
    intro 𝔫 hnp hnN hnm
    obtain ⟨𝔮, hqp, hqy, hqc⟩ := wcpa_dj_llsm_scbc_normal_going_down
      ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L) hinj
      (wcLlsASbN W A K u b) hnorm y hy hyc 𝔫 hnp hnN
    haveI := hqp
    have hIq : Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} ≤ 𝔮 := by
      rw [Ideal.span_le]
      rintro c ⟨x, hx, hcx⟩
      have hc : c = algebraMap ↥(wcLlsASbS W A K u b)
          ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
          (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A x)) := by
        apply Subtype.ext
        rw [hcx]
        exact (hcoe _).symm
      have h1 := hnm x hx
      rw [← hqc, Ideal.mem_comap] at h1
      rw [SetLike.mem_coe, hc]
      exact h1
    obtain ⟨Q, hQm, hQq⟩ := Ideal.exists_minimalPrimes_le hIq
    refine ⟨Q, hQm, hQq.trans hqy, fun r hr => ?_⟩
    have h1 : algebraMap ↥(wcLlsASbS W A K u b)
        ↥(integralClosure ↥(wcLlsASbS W A K u b) L) r ∈ 𝔮 := hQq hr
    rw [← hqc]
    exact h1

  obtain ⟨Ps, hPs, hPsy, hPsc⟩ := hdesc 𝔫s hsp hsN hsm
  obtain ⟨Pu, hPu, hPuy, hPuc⟩ := hdesc _ (Ideal.IsPrime.comap _) hun hum

  have hπ : algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) u) *
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈
      Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} := by
    have h1 : algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A b)) ∈
        Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} :=
      Ideal.subset_span ⟨b, hbm, rfl⟩
    convert h1 using 1
    apply Subtype.ext
    show algebraMap K L (algebraMap A K u) *
      algebraMap K L (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A b))
    rw [← map_mul, mul_div_cancel₀ _ hu0]
  have huPs : algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      (algebraMap A ↥(wcLlsASbS W A K u b) u) ∉ Ps := fun h => hsu (hPsc _ h)
  have hsPu : algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
        Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∉ Pu := fun h => hsnot (hPuc _ h)
  have hsPs := (hPs.1.1.mem_or_mem (hPs.1.2 hπ)).resolve_left huPs
  have huPu := (hPu.1.1.mem_or_mem (hPu.1.2 hπ)).resolve_right hsPu
  exact ⟨Ps, Pu, hPs, hPu, hPsy, hPuy, hsPs, huPs, huPu, hsPu⟩

theorem wcpa_dj_llsm_isiceib_chart_compare : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    (𝔭 : Ideal A) (u v : A) (g a' b e h : ↥W)
    (A₃ : Type u) [CommRing A₃] [Algebra ↥W A₃] [Algebra A₃ K] (u₃ : A₃),
    wcLlsPD W A 𝔭 (.ann u v g) → b = a' * e → g = b * h →
    algebraMap A K u ≠ 0 → algebraMap A K (algebraMap ↥W A a') ≠ 0 →
    wcLlsBrSub W A K A₃ (algebraMap A K u / algebraMap A K (algebraMap ↥W A a'))
      {algebraMap A K u / algebraMap A K (algebraMap ↥W A a'), algebraMap A K v} →
    algebraMap A₃ K u₃ = algebraMap A K u / algebraMap A K (algebraMap ↥W A a') →
    (wcIcxNI W A K u a' b).IsPrime →
    algebraMap A₃ K (algebraMap ↥W A₃ e) / algebraMap A₃ K u₃ = wcLlsIsiS2 W A K u b ∧
    (∀ z : K, z ∈ wcIcxRI W A K u a' b → z ∈ wcLlsASbS W A₃ K u₃ e) ∧
    (∀ z : K, z ∈ wcLlsASbS W A₃ K u₃ e → ∃ σ : ↥(wcIcxRI W A K u a' b),
       σ ∉ wcIcxNI W A K u a' b ∧ (σ : K) * z ∈ wcIcxRI W A K u a' b) :=
by
  intro Ω _ W A _ _ _ K _ _ 𝔭 u v g a' b e h A₃ _ _ _ u₃ hPD he hgh hu0 ha0 hBr hu₃ hNI
  classical
  obtain ⟨_, _, _, h𝔭max, _, _, _, huv, h𝔭eq, _⟩ := hPD
  obtain ⟨hw, hrange, hfrac⟩ := hBr

  have hgen : algebraMap A₃ K (algebraMap ↥W A₃ e) / algebraMap A₃ K u₃ =
      algebraMap A K (algebraMap ↥W A b) / algebraMap A K u := by
    rw [hw e, hu₃, he, map_mul, map_mul, div_div_eq_mul_div,
      mul_comm (algebraMap A K (algebraMap ↥W A e))]
  have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A h) *
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) := by
    have h1 : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K (algebraMap ↥W A h) := by
      rw [← map_mul, huv, hgh, map_mul, map_mul]
    field_simp
    rw [mul_comm (algebraMap A K v), h1]; ring
  have hxRI : algebraMap A K u / algebraMap A K (algebraMap ↥W A a') ∈ wcIcxRI W A K u a' b :=
    Algebra.subset_adjoin (Set.mem_insert _ _)
  have hsRI : algebraMap A K (algebraMap ↥W A b) / algebraMap A K u ∈ wcIcxRI W A K u a' b :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hle : Algebra.adjoin A ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K) ≤
      wcIcxRI W A K u a' b :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr hxRI)
  have hR3 : ∀ z, z ∈ wcLlsASbS W A₃ K u₃ e ↔
      z ∈ Algebra.adjoin A₃ ({algebraMap A K (algebraMap ↥W A b) / algebraMap A K u} : Set K) := by
    intro z
    show z ∈ Algebra.adjoin A₃
      ({algebraMap A₃ K (algebraMap ↥W A₃ e) / algebraMap A₃ K u₃} : Set K) ↔ _
    rw [hgen]

  have congr_gen : ∀ (x : K) (J : Ideal ↥(Algebra.adjoin A ({x} : Set K))),
      (⟨x, Algebra.subset_adjoin (Set.mem_singleton x)⟩ : ↥(Algebra.adjoin A ({x} : Set K))) ∈ J →
      ∀ z : ↥(Algebra.adjoin A ({x} : Set K)), ∃ a : A,
        z - algebraMap A ↥(Algebra.adjoin A ({x} : Set K)) a ∈ J := by
    intro x J hxJ
    rintro ⟨r, hr⟩
    induction hr using Algebra.adjoin_induction with
    | mem y hy =>
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact ⟨0, by rw [map_zero, sub_zero]; exact hxJ⟩
    | algebraMap a =>
      exact ⟨a, by
        convert J.zero_mem using 1
        exact sub_eq_zero.mpr (Subtype.ext rfl)⟩
    | add y₁ y₂ hy₁ hy₂ ih₁ ih₂ =>
      obtain ⟨a₁, ha₁⟩ := ih₁
      obtain ⟨a₂, ha₂⟩ := ih₂
      refine ⟨a₁ + a₂, ?_⟩
      have hxy : (⟨y₁ + y₂, Subalgebra.add_mem _ hy₁ hy₂⟩ : ↥(Algebra.adjoin A ({x} : Set K))) =
          ⟨y₁, hy₁⟩ + ⟨y₂, hy₂⟩ := rfl
      have : (⟨y₁ + y₂, Subalgebra.add_mem _ hy₁ hy₂⟩ : ↥(Algebra.adjoin A ({x} : Set K))) -
          algebraMap A _ (a₁ + a₂) =
          (⟨y₁, hy₁⟩ - algebraMap A _ a₁) + (⟨y₂, hy₂⟩ - algebraMap A _ a₂) := by
        rw [hxy, map_add]; ring
      rw [this]; exact Ideal.add_mem _ ha₁ ha₂
    | mul y₁ y₂ hy₁ hy₂ ih₁ ih₂ =>
      obtain ⟨a₁, ha₁⟩ := ih₁
      obtain ⟨a₂, ha₂⟩ := ih₂
      refine ⟨a₁ * a₂, ?_⟩
      have hxy : (⟨y₁ * y₂, Subalgebra.mul_mem _ hy₁ hy₂⟩ : ↥(Algebra.adjoin A ({x} : Set K))) =
          ⟨y₁, hy₁⟩ * ⟨y₂, hy₂⟩ := rfl
      have : (⟨y₁ * y₂, Subalgebra.mul_mem _ hy₁ hy₂⟩ : ↥(Algebra.adjoin A ({x} : Set K))) -
          algebraMap A _ (a₁ * a₂) = (⟨y₁, hy₁⟩ - algebraMap A _ a₁) * ⟨y₂, hy₂⟩ +
            algebraMap A _ a₁ * (⟨y₂, hy₂⟩ - algebraMap A _ a₂) := by
        rw [hxy, map_mul]; ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha₁) (Ideal.mul_mem_left _ _ ha₂)

  have denom_gen : ∀ (R : Subalgebra A K) (N : Ideal ↥R), N.IsPrime → ∀ t : K, t ∈ R →
      (∀ y : A₃, ∃ σ : ↥R, σ ∉ N ∧ (σ : K) * algebraMap A₃ K y ∈ R) →
      ∀ z ∈ Algebra.adjoin A₃ ({t} : Set K), ∃ σ : ↥R, σ ∉ N ∧ (σ : K) * z ∈ R := by
    intro R N hN t ht hy z hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      refine ⟨1, fun h1 => hN.ne_top ((Ideal.eq_top_iff_one _).mpr h1), ?_⟩
      rw [OneMemClass.coe_one, one_mul]
      exact ht
    | algebraMap y => exact hy y
    | add z₁ z₂ _ _ ih₁ ih₂ =>
      obtain ⟨σ₁, hσ₁, h₁⟩ := ih₁
      obtain ⟨σ₂, hσ₂, h₂⟩ := ih₂
      refine ⟨σ₁ * σ₂, fun hm => (hN.mem_or_mem hm).elim hσ₁ hσ₂, ?_⟩
      have e1 : ((σ₁ * σ₂ : ↥R) : K) * (z₁ + z₂) =
          (σ₂ : K) * ((σ₁ : K) * z₁) + (σ₁ : K) * ((σ₂ : K) * z₂) := by
        rw [MulMemClass.coe_mul]; ring
      rw [e1]
      exact R.add_mem (R.mul_mem σ₂.2 h₁) (R.mul_mem σ₁.2 h₂)
    | mul z₁ z₂ _ _ ih₁ ih₂ =>
      obtain ⟨σ₁, hσ₁, h₁⟩ := ih₁
      obtain ⟨σ₂, hσ₂, h₂⟩ := ih₂
      refine ⟨σ₁ * σ₂, fun hm => (hN.mem_or_mem hm).elim hσ₁ hσ₂, ?_⟩
      have e1 : ((σ₁ * σ₂ : ↥R) : K) * (z₁ * z₂) = ((σ₁ : K) * z₁) * ((σ₂ : K) * z₂) := by
        rw [MulMemClass.coe_mul]; ring
      rw [e1]
      exact R.mul_mem h₁ h₂

  have hc2 : ∀ z : K, z ∈ wcIcxRI W A K u a' b → z ∈ wcLlsASbS W A₃ K u₃ e := by
    intro z hz
    rw [hR3]
    have hA3 : ∀ y ∈ Algebra.adjoin A
        ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K),
        y ∈ Algebra.adjoin A₃ ({algebraMap A K (algebraMap ↥W A b) / algebraMap A K u} : Set K) := by
      intro y hy
      obtain ⟨y', hy'⟩ := hrange hy
      rw [← hy']
      exact Subalgebra.algebraMap_mem _ y'
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · exact hA3 _ (Algebra.subset_adjoin (Set.mem_singleton _))
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap r => exact hA3 _ (Subalgebra.algebraMap_mem _ r)
    | add x y _ _ hx hy => exact Subalgebra.add_mem _ hx hy
    | mul x y _ _ hx hy => exact Subalgebra.mul_mem _ hx hy

  set J : Ideal ↥(Algebra.adjoin A ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K)) :=
    Ideal.span (((↑) : ↥(Algebra.adjoin A
      ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K)) → K) ⁻¹'
      ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a'), algebraMap A K v} ∪
        (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
          (IsLocalRing.maximalIdeal ↥W : Set ↥W))) with hJ

  have hJN : J ≤ (wcIcxNI W A K u a' b).comap (Subalgebra.inclusion hle) := by
    rw [hJ, Ideal.span_le]
    intro t ht
    rw [Set.mem_preimage] at ht
    rw [SetLike.mem_coe, Ideal.mem_comap]
    rcases ht with (ht | ht) | ⟨w, hw, hwt⟩
    · have : Subalgebra.inclusion hle t =
          ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
        apply Subtype.ext
        show (t : K) = wcLlsIsiS1 W A K u a'
        exact ht
      rw [this]
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    · have ht' : (t : K) = algebraMap A K v := ht
      have : Subalgebra.inclusion hle t =
          algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A h) *
            ⟨wcLlsIsiS2 W A K u b,
              Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
        apply Subtype.ext
        rw [MulMemClass.coe_mul]
        show (t : K) = _
        rw [ht']
        exact hvK
      rw [this]
      exact Ideal.mul_mem_left _ _
        (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
    · have : Subalgebra.inclusion hle t =
          ((algebraMap A ↥(wcIcxRI W A K u a' b)).comp (algebraMap ↥W A)) w := by
        apply Subtype.ext
        show (t : K) = _
        rw [← hwt]
        rfl
      rw [this]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have h𝔭NI : 𝔭 ≤ (wcIcxNI W A K u a' b).comap (algebraMap A ↥(wcIcxRI W A K u a' b)) := by
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with hz | hz
      · rw [hz]
        have : algebraMap A ↥(wcIcxRI W A K u a' b) u =
            algebraMap A _ (algebraMap ↥W A a') *
              ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
          apply Subtype.ext
          show algebraMap A K u = algebraMap A K (algebraMap ↥W A a') *
            (algebraMap A K u / algebraMap A K (algebraMap ↥W A a'))
          field_simp
        show _ ∈ wcIcxNI W A K u a' b
        rw [this]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
      · rw [Set.mem_singleton_iff] at hz
        rw [hz]
        have : algebraMap A ↥(wcIcxRI W A K u a' b) v =
            algebraMap A _ (algebraMap ↥W A h) *
              ⟨wcLlsIsiS2 W A K u b,
                Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
          apply Subtype.ext
          exact hvK
        show _ ∈ wcIcxNI W A K u a' b
        rw [this]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_sup_left (Ideal.subset_span
          (Set.mem_insert_of_mem _ rfl)))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have h𝔭J : 𝔭 ≤ J.comap (algebraMap A ↥(Algebra.adjoin A
      ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K))) := by
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with hz | hz
      · rw [hz]
        have : algebraMap A ↥(Algebra.adjoin A
            ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K)) u =
            algebraMap A _ (algebraMap ↥W A a') *
              ⟨algebraMap A K u / algebraMap A K (algebraMap ↥W A a'),
                Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
          apply Subtype.ext
          show algebraMap A K u = algebraMap A K (algebraMap ↥W A a') *
            (algebraMap A K u / algebraMap A K (algebraMap ↥W A a'))
          field_simp
        rw [SetLike.mem_coe, Ideal.mem_comap, this, hJ]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span
          (Set.mem_preimage.mpr (Set.mem_union_left _ (Set.mem_insert _ _))))
      · rw [Set.mem_singleton_iff] at hz
        rw [hz, SetLike.mem_coe, Ideal.mem_comap, hJ]
        exact Ideal.subset_span (Set.mem_preimage.mpr
          (Set.mem_union_left _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, hJ]
      exact Ideal.subset_span (Set.mem_preimage.mpr
        (Set.mem_union_right _ (Set.mem_image_of_mem _ hw)))

  have s6 : ∀ a : A, algebraMap A ↥(wcIcxRI W A K u a' b) a ∈ wcIcxNI W A K u a' b →
      algebraMap A ↥(Algebra.adjoin A
        ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K)) a ∈ J := by
    intro a hmem
    haveI := hNI
    have h𝔭eq' : 𝔭 = (wcIcxNI W A K u a' b).comap (algebraMap A ↥(wcIcxRI W A K u a' b)) :=
      h𝔭max.eq_of_le (Ideal.IsPrime.comap _).ne_top h𝔭NI
    have ha𝔭 : a ∈ 𝔭 := by rw [h𝔭eq']; exact hmem
    exact h𝔭J ha𝔭

  have KC : ∀ q : ↥(Algebra.adjoin A
      ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K)),
      Subalgebra.inclusion hle q ∈ wcIcxNI W A K u a' b → q ∈ J := by
    intro q hq
    have hXJ : (⟨algebraMap A K u / algebraMap A K (algebraMap ↥W A a'),
        Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A
          ({algebraMap A K u / algebraMap A K (algebraMap ↥W A a')} : Set K))) ∈ J := by
      rw [hJ]
      exact Ideal.subset_span (Set.mem_preimage.mpr (Set.mem_union_left _ (Set.mem_insert _ _)))
    obtain ⟨a, ha⟩ := congr_gen _ J hXJ q
    have h1 := hJN ha
    rw [Ideal.mem_comap, map_sub, AlgHom.commutes] at h1
    have h2 : algebraMap A ↥(wcIcxRI W A K u a' b) a ∈ wcIcxNI W A K u a' b := by
      have := Ideal.sub_mem _ hq h1
      rwa [sub_sub_cancel] at this
    have h3 := s6 a h2
    have := Ideal.add_mem _ ha h3
    rwa [sub_add_cancel] at this

  have hc3 : ∀ z : K, z ∈ wcLlsASbS W A₃ K u₃ e → ∃ σ : ↥(wcIcxRI W A K u a' b),
       σ ∉ wcIcxNI W A K u a' b ∧ (σ : K) * z ∈ wcIcxRI W A K u a' b := by
    intro z hz
    rw [hR3] at hz
    refine denom_gen (wcIcxRI W A K u a' b) (wcIcxNI W A K u a' b) hNI _ hsRI ?_ z hz
    intro y
    obtain ⟨p, q, hqJ, hpq⟩ := hfrac (algebraMap A₃ K y) ⟨y, rfl⟩
    refine ⟨Subalgebra.inclusion hle q, fun hmem => hqJ (KC q hmem), ?_⟩
    show (q : K) * algebraMap A₃ K y ∈ wcIcxRI W A K u a' b
    rw [mul_comm, hpq]
    exact hle p.2
  exact ⟨hgen, hc2, hc3⟩

theorem wcpa_dj_llsm_isiceib_closure_denom : ∀ (A A' K L : Type u) [CommRing A] [CommRing A']
    [Field K] [Field L] [Algebra A K] [Algebra A' K] [Algebra K L]
    (R : Subalgebra A K) (R' : Subalgebra A' K) (N : Ideal ↥R), N.IsPrime →
    (∀ z ∈ R', ∃ σ : ↥R, σ ∉ N ∧ (σ : K) * z ∈ R) →
    ∀ z : L, IsIntegral ↥R' z → ∃ σ : ↥R, σ ∉ N ∧ IsIntegral ↥R (algebraMap K L (σ : K) * z) :=
by
  intro A A' K L _ _ _ _ _ _ _ R R' N hN hden z hz
  classical
  haveI := hN
  choose τ hτN hτR using hden
  obtain ⟨p, hp, hpz⟩ := hz
  obtain ⟨pK, hpKdef⟩ : ∃ q : Polynomial K, q = p.map (algebraMap R' K) := ⟨_, rfl⟩
  have hpKm : pK.Monic := by rw [hpKdef]; exact hp.map _
  have hcoeff : ∀ i, pK.coeff i ∈ R' := by
    intro i
    rw [hpKdef, Polynomial.coeff_map]
    exact (p.coeff i).2
  have hpKz : Polynomial.eval₂ (algebraMap K L) z pK = 0 := by
    rw [hpKdef, Polynomial.eval₂_map]
    exact hpz
  obtain ⟨σ, hσ⟩ : ∃ s : ↥R, s = ∏ i ∈ Finset.range pK.natDegree,
      τ (pK.coeff i) (hcoeff i) := ⟨_, rfl⟩
  have hσN : σ ∉ N := by
    rw [hσ, Ideal.IsPrime.prod_mem_iff]
    rintro ⟨i, _, hi⟩
    exact hτN _ _ hi
  have hkey : ∀ i < pK.natDegree, (σ : K) * pK.coeff i ∈ R := by
    intro i hi
    have h1 := Finset.mul_prod_erase (Finset.range pK.natDegree)
      (fun j => τ (pK.coeff j) (hcoeff j)) (Finset.mem_range.2 hi)
    have h2 : (σ : K) = (τ (pK.coeff i) (hcoeff i) : K) *
        ((∏ j ∈ (Finset.range pK.natDegree).erase i, τ (pK.coeff j) (hcoeff j) : ↥R) : K) := by
      rw [hσ, ← h1, Subalgebra.coe_mul]
    rw [h2, mul_comm (τ (pK.coeff i) (hcoeff i) : K), mul_assoc]
    exact R.mul_mem (SetLike.coe_mem _) (hτR _ _)
  obtain ⟨P, hP⟩ : ∃ P : Polynomial K, P = pK.scaleRoots (σ : K) := ⟨_, rfl⟩
  have hPm : P.Monic := by rw [hP]; exact (Polynomial.monic_scaleRoots_iff _).2 hpKm
  have hPc : ∀ i, P.coeff i ∈ Set.range (algebraMap R K) := by
    intro i
    have hmem : P.coeff i ∈ R := by
      rw [hP, Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i pK.natDegree with h | h | h
      · obtain ⟨k, hk⟩ : ∃ k, pK.natDegree - i = k + 1 := ⟨pK.natDegree - i - 1, by omega⟩
        have e2 : pK.coeff i * (σ : K) ^ (pK.natDegree - i) =
            ((σ : K) * pK.coeff i) * (σ : K) ^ k := by
          rw [hk, pow_succ]; ring
        rw [e2]
        exact R.mul_mem (hkey i h) (R.pow_mem (SetLike.coe_mem σ) _)
      · rw [h, Nat.sub_self, pow_zero, mul_one, hpKm.coeff_natDegree]
        exact R.one_mem
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul]
        exact R.zero_mem
    exact ⟨⟨_, hmem⟩, rfl⟩
  obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic
    ((Polynomial.lifts_iff_coeff_lifts P).2 hPc) hPm
  refine ⟨σ, hσN, q, hqm, ?_⟩
  have hRL : algebraMap (↥R) L = (algebraMap K L).comp (algebraMap (↥R) K) := rfl
  rw [hRL, ← Polynomial.eval₂_map, hqmap, hP, Polynomial.scaleRoots_eval₂_mul, hpKz, mul_zero]

theorem wcpa_dj_llsm_isiceib_prime_transport : ∀ (C D : Type u) [CommRing C] [CommRing D]
    (ι : C →+* D), Function.Injective ι → ∀ (M : Submonoid C),
    (∀ z : D, ∃ σ ∈ M, ∃ c : C, ι σ * z = ι c) →
    ∀ (Q : Ideal C), Q.IsPrime → (∀ σ ∈ M, σ ∉ Q) →
    ∃ y : Ideal D, y.IsPrime ∧ y.comap ι = Q ∧
      ∀ (J : Ideal C) (J' : Ideal D), J' ≤ J.map ι → J ≤ J'.comap ι →
        ∀ P ∈ J'.minimalPrimes, P ≤ y → P.comap ι ∈ J.minimalPrimes :=
by
  intro C D _ _ ι hι M hcof
  have hT : ∀ (𝔮 : Ideal C), 𝔮.IsPrime → (∀ σ ∈ M, σ ∉ 𝔮) → ∃ y : Ideal D, y.IsPrime ∧
      y.comap ι = 𝔮 ∧ ∀ z : D, z ∈ y ↔ ∃ σ ∈ M, ∃ c ∈ 𝔮, ι σ * z = ι c := by
    intro 𝔮 h𝔮 hd
    let y : Ideal D :=
      { carrier := {z | ∃ σ ∈ M, ∃ c ∈ 𝔮, ι σ * z = ι c}
        zero_mem' := ⟨1, M.one_mem, 0, 𝔮.zero_mem, by simp⟩
        add_mem' := by
          rintro z w ⟨σ, hσ, c, hc, hz⟩ ⟨σ', hσ', c', hc', hw⟩
          refine ⟨σ * σ', M.mul_mem hσ hσ', σ' * c + σ * c',
            𝔮.add_mem (𝔮.mul_mem_left _ hc) (𝔮.mul_mem_left _ hc'), ?_⟩
          simp only [map_mul, map_add]
          rw [← hz, ← hw]; ring
        smul_mem' := by
          rintro r z ⟨σ, hσ, c, hc, hz⟩
          obtain ⟨τ, hτ, e, he⟩ := hcof r
          refine ⟨τ * σ, M.mul_mem hτ hσ, e * c, 𝔮.mul_mem_left _ hc, ?_⟩
          simp only [map_mul, smul_eq_mul]
          rw [← he, ← hz]; ring }
    have hmem : ∀ z : D, z ∈ y ↔ ∃ σ ∈ M, ∃ c ∈ 𝔮, ι σ * z = ι c := fun z => Iff.rfl
    have hcomap : y.comap ι = 𝔮 := by
      ext x
      rw [Ideal.mem_comap, hmem]
      constructor
      · rintro ⟨σ, hσ, c, hc, h⟩
        rw [← map_mul] at h
        have h' := hι h
        rw [← h'] at hc
        exact (h𝔮.mem_or_mem hc).resolve_left (hd σ hσ)
      · intro hx
        exact ⟨1, M.one_mem, x, hx, by simp⟩
    refine ⟨y, ?_, hcomap, hmem⟩
    rw [Ideal.isPrime_iff]
    constructor
    · intro htop
      have h1 : (1 : D) ∈ y := htop ▸ Submodule.mem_top
      obtain ⟨σ, hσ, c, hc, h⟩ := (hmem 1).1 h1
      rw [mul_one] at h
      have h' := hι h
      exact hd σ hσ (h' ▸ hc)
    · intro z w hzw
      obtain ⟨τ, hτ, e, he, h⟩ := (hmem _).1 hzw
      obtain ⟨σ, hσ, c, hc⟩ := hcof z
      obtain ⟨σ', hσ', c', hc'⟩ := hcof w
      have key : ι (τ * (c * c')) = ι (σ * σ' * e) := by
        simp only [map_mul]
        rw [← hc, ← hc', ← h]; ring
      have hk := hι key
      have hmem2 : τ * (c * c') ∈ 𝔮 := by rw [hk]; exact 𝔮.mul_mem_left _ he
      have hcc : c * c' ∈ 𝔮 := (h𝔮.mem_or_mem hmem2).resolve_left (hd τ hτ)
      rcases h𝔮.mem_or_mem hcc with h1 | h1
      · left; exact (hmem z).2 ⟨σ, hσ, c, h1, hc⟩
      · right; exact (hmem w).2 ⟨σ', hσ', c', h1, hc'⟩
  intro Q hQ hdisj
  obtain ⟨y, hy, hyc, hym⟩ := hT Q hQ hdisj
  refine ⟨y, hy, hyc, ?_⟩
  intro J J' hJ'J hJJ' P hP hPy
  change Minimal (fun q : Ideal D => q.IsPrime ∧ J' ≤ q) P at hP
  change Minimal (fun q : Ideal C => q.IsPrime ∧ J ≤ q) (P.comap ι)
  have hPM : ∀ σ ∈ M, ι σ ∉ P := by
    intro σ hσ h
    have h2 : σ ∈ y.comap ι := hPy h
    rw [hyc] at h2
    exact hdisj σ hσ h2
  have hPp : P.IsPrime := hP.1.1
  have hJ'P : J' ≤ P := hP.1.2
  refine ⟨⟨hPp.comap ι, le_trans hJJ' (Ideal.comap_mono hJ'P)⟩, ?_⟩
  rintro 𝔮 ⟨h𝔮, hJ𝔮⟩ hle
  have hd : ∀ σ ∈ M, σ ∉ 𝔮 := fun σ hσ h => hPM σ hσ (hle h)
  obtain ⟨y𝔮, hy𝔮, hy𝔮c, hy𝔮m⟩ := hT 𝔮 h𝔮 hd
  have ha : J' ≤ y𝔮 := by
    refine le_trans hJ'J (le_trans (Ideal.map_mono hJ𝔮) ?_)
    rw [Ideal.map_le_iff_le_comap, hy𝔮c]
  have hb : y𝔮 ≤ P := by
    intro z hz
    obtain ⟨σ, hσ, c, hc, h⟩ := (hy𝔮m z).1 hz
    have h3 : ι σ * z ∈ P := by rw [h]; exact hle hc
    exact (hPp.mem_or_mem h3).resolve_left (hPM σ hσ)
  have hPY := hP.2 ⟨hy𝔮, ha⟩ hb
  calc P.comap ι ≤ y𝔮.comap ι := Ideal.comap_mono hPY
    _ = 𝔮 := hy𝔮c

theorem wcpa_dj_llsm_isice_inner_branch_exist : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (Q : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)), Q.IsPrime →
    Q.comap (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) =
      wcIcxNI W A K u a' b →
    ∃ E E' : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L),
      E ∈ (Ideal.span {c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes ∧
      E' ∈ (Ideal.span {c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).minimalPrimes ∧
      E ≤ Q ∧ E' ≤ Q ∧
      algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ⟨wcLlsIsiS2 W A K u b,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ ∈ E ∧
      algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∉ E ∧
      algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∈ E' ∧
      algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ⟨wcLlsIsiS2 W A K u b,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ ∉ E' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hPD ha'm ha'0 hbm hb0
    ha'b hnba hbg Q hQ hQc
  classical
  haveI := hQ
  have hPD' := hPD
  obtain ⟨_, _, _, _, _, _, hg0, huv, _, _⟩ := hPD'
  obtain ⟨e, he⟩ := ha'b
  obtain ⟨hh, hgh⟩ := hbg

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hwK : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    apply hw
    apply hWA
    rw [map_zero]
    exact IsFractionRing.injective A K (h.trans (map_zero _).symm)
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    have hu : u = 0 := IsFractionRing.injective A K (h.trans (map_zero _).symm)
    rw [hu, zero_mul] at huv
    exact hg0 (hWA (huv.symm.trans (map_zero _).symm))
  have ha0 := hwK a' ha'0
  have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hne
    have hu : IsUnit e := IsLocalRing.notMem_maximalIdeal.mp hne
    exact hnba (he ▸ hu.mul_right_dvd.mpr (dvd_refl a'))
  have he0 : e ≠ 0 := fun h => hb0 (by rw [he, h, mul_zero])
  have hqm : e * hh ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right _ _ hem
  have hgq : g = a' * (e * hh) := by rw [hgh, he, mul_assoc]

  obtain ⟨A₃, _, _, _, _, _, _, _, u₃, v₃, 𝔭₃, hBr, hu₃, _, hPD₃, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K L 𝔭 u v g a' (e * hh) hPD ha'm ha'0 hqm hgq
  have hNIp : (wcIcxNI W A K u a' b).IsPrime := by
    rw [← hQc]; exact Ideal.IsPrime.comap _

  obtain ⟨hgen, hsub, hden⟩ := wcpa_dj_llsm_isiceib_chart_compare Ω W A K 𝔭 u v g a' b e hh
    A₃ u₃ hPD he hgh hu0 ha0 hBr hu₃ hNIp

  let φ : ↥(wcIcxRI W A K u a' b) →+* ↥(wcLlsASbS W A₃ K u₃ e) :=
    ((wcIcxRI W A K u a' b).val : ↥(wcIcxRI W A K u a' b) →ₐ[A] K).toRingHom.codRestrict
      (wcLlsASbS W A₃ K u₃ e) (fun x => hsub x x.2)
  have hφ : (algebraMap ↥(wcLlsASbS W A₃ K u₃ e) L).comp φ =
      (RingHom.id L).comp (algebraMap ↥(wcIcxRI W A K u a' b) L) := RingHom.ext fun _ => rfl
  let ι : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) →+*
      ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L) :=
    ((integralClosure ↥(wcIcxRI W A K u a' b) L).val :
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) →ₐ[↥(wcIcxRI W A K u a' b)] L).toRingHom.codRestrict
      (integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)
      (fun x => IsIntegral.map_of_comp_eq φ (RingHom.id L) hφ x.2)
  have hιv : ∀ x, ((ι x : ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)) : L) = (x : L) :=
    fun _ => rfl
  have hιinj : Function.Injective ι := fun x y h => Subtype.ext (by
    rw [← hιv x, ← hιv y, h])

  set M : Submonoid ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) :=
    (wcIcxNI W A K u a' b).primeCompl.map
      (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) with hM
  have hcof : ∀ z : ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L), ∃ σ ∈ M,
      ∃ c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L), ι σ * z = ι c := by
    intro z
    obtain ⟨σ, hσN, hσint⟩ := wcpa_dj_llsm_isiceib_closure_denom A A₃ K L
      (wcIcxRI W A K u a' b) (wcLlsASbS W A₃ K u₃ e) (wcIcxNI W A K u a' b) hNIp hden z z.2
    refine ⟨algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) σ,
      Submonoid.mem_map.mpr ⟨σ, hσN, rfl⟩, ⟨algebraMap K L (σ : K) * (z : L), hσint⟩, ?_⟩
    exact Subtype.ext rfl
  have hdisj : ∀ σ ∈ M, σ ∉ Q := by
    intro σ hσ hσQ
    obtain ⟨r, hr, rfl⟩ := Submonoid.mem_map.mp hσ
    exact hr (by rw [← hQc]; exact hσQ)

  obtain ⟨y, hy, hyQ, htr⟩ := wcpa_dj_llsm_isiceib_prime_transport _ _ ι hιinj M hcof Q hQ hdisj
  haveI := hy
  have hιQ : ∀ c ∈ Q, ι c ∈ y := fun c hc => by rw [← hyQ] at hc; exact hc
  have hNQ : ∀ r ∈ wcIcxNI W A K u a' b,
      algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) r ∈ Q :=
    fun r hr => by rw [← hQc] at hr; exact hr

  have hιs : ι (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ⟨wcLlsIsiS2 W A K u b,
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩) =
      algebraMap ↥(wcLlsASbS W A₃ K u₃ e) ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)
        ⟨algebraMap A₃ K (algebraMap ↥W A₃ e) / algebraMap A₃ K u₃,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
    apply Subtype.ext
    show algebraMap K L (wcLlsIsiS2 W A K u b) =
      algebraMap K L (algebraMap A₃ K (algebraMap ↥W A₃ e) / algebraMap A₃ K u₃)
    rw [hgen]
  have hιx : ι (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩) =
      algebraMap ↥(wcLlsASbS W A₃ K u₃ e) ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)
        (algebraMap A₃ ↥(wcLlsASbS W A₃ K u₃ e) u₃) := by
    apply Subtype.ext
    show algebraMap K L (wcLlsIsiS1 W A K u a') = algebraMap K L (algebraMap A₃ K u₃)
    rw [hu₃]; rfl
  have hιw : ∀ w : ↥W,
      ι (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        (algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A w))) =
      algebraMap ↥(wcLlsASbS W A₃ K u₃ e) ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)
        (algebraMap A₃ ↥(wcLlsASbS W A₃ K u₃ e) (algebraMap ↥W A₃ w)) := by
    intro w
    apply Subtype.ext
    show algebraMap K L (algebraMap A K (algebraMap ↥W A w)) =
      algebraMap K L (algebraMap A₃ K (algebraMap ↥W A₃ w))
    rw [hBr.1 w]

  have hle : wcLlsASbN W A₃ K u₃ e ≤ y.comap (algebraMap ↥(wcLlsASbS W A₃ K u₃ e)
      ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)) := by
    apply sup_le
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | hz
      · show _ ∈ y
        rw [← hιx]
        exact hιQ _ (hNQ _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))))
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        show _ ∈ y
        rw [← hιs]
        exact hιQ _ (hNQ _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      show _ ∈ y
      have h1 := hιQ _ (hNQ _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(wcIcxRI W A K u a' b)).comp (algebraMap ↥W A)) hw)))
      have h2 : ι (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
          (((algebraMap A ↥(wcIcxRI W A K u a' b)).comp (algebraMap ↥W A)) w)) =
          algebraMap ↥(wcLlsASbS W A₃ K u₃ e) ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)
            (((algebraMap A₃ ↥(wcLlsASbS W A₃ K u₃ e)).comp (algebraMap ↥W A₃)) w) := hιw w
      rw [h2] at h1
      exact h1
  have hyne : y.comap (algebraMap ↥(wcLlsASbS W A₃ K u₃ e)
      ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L)) ≠ ⊤ := (Ideal.IsPrime.comap _).ne_top
  have hmax : (wcLlsASbN W A₃ K u₃ e).IsMaximal :=
    wcpa_dj_llsm_brrm_node_max Ω W hW hWt A₃ K 𝔭₃ (.ann u₃ v₃ (e * hh)) u₃ e hPD₃
      (Or.inr ⟨v₃, e * hh, rfl, ⟨hh, rfl⟩⟩) hem he0 _ rfl
      (fun h => hyne (top_le_iff.mp (h ▸ hle)))
  have hyc := (hmax.eq_of_le hyne hle).symm

  obtain ⟨Ps, Pu, hPs, hPu, hPsy, hPuy, hsPs, huPs, huPu, hsPu⟩ :=
    wcpa_dj_llsm_isice_branch_exist Ω W hW hWt A₃ K L 𝔭₃ u₃ v₃ (e * hh) e hPD₃ hem he0
      ⟨hh, rfl⟩ y hy hyc

  have hJ1 : Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A₃ K).comp (algebraMap ↥W A₃))) w} ≤
      (Ideal.span {c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map ι := by
    rw [Ideal.span_le]
    rintro c ⟨w, hw, hc⟩
    have hc' : c = ι (algebraMap ↥(wcIcxRI W A K u a' b)
        ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
        (algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A w))) := by
      apply Subtype.ext
      rw [hc]
      show algebraMap K L (algebraMap A₃ K (algebraMap ↥W A₃ w)) =
        algebraMap K L (algebraMap A K (algebraMap ↥W A w))
      rw [hBr.1 w]
    rw [SetLike.mem_coe, hc']
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨w, hw, rfl⟩)
  have hJ2 : Ideal.span {c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} ≤
      (Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A₃ K u₃ e) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A₃ K).comp (algebraMap ↥W A₃))) w}).comap ι := by
    rw [Ideal.span_le]
    rintro c ⟨w, hw, hc⟩
    rw [SetLike.mem_coe, Ideal.mem_comap]
    apply Ideal.subset_span
    refine ⟨w, hw, ?_⟩
    rw [hιv, hc]
    show algebraMap K L (algebraMap A K (algebraMap ↥W A w)) =
      algebraMap K L (algebraMap A₃ K (algebraMap ↥W A₃ w))
    rw [hBr.1 w]

  refine ⟨Ps.comap ι, Pu.comap ι, htr _ _ hJ1 hJ2 Ps hPs hPsy, htr _ _ hJ1 hJ2 Pu hPu hPuy,
    fun c hc => by rw [← hyQ]; exact hPsy hc, fun c hc => by rw [← hyQ]; exact hPuy hc,
    ?_, ?_, ?_, ?_⟩
  · rw [Ideal.mem_comap, hιs]; exact hsPs
  · rw [Ideal.mem_comap, hιx]; exact huPs
  · rw [Ideal.mem_comap, hιx]; exact huPu
  · rw [Ideal.mem_comap, hιs]; exact hsPu

theorem wcpa_dj_llsm_isice_lift_branch : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
    [Algebra A K] (L : Type u) [Field L] [Algebra K L] (S T : Subalgebra A K) (h : S ≤ T)
    (t : K) (U : Set K),
    (∀ z ∈ T, z ∈ Algebra.adjoin A (insert t U)) →
    (∀ z ∈ U, ∃ c : ↥(integralClosure ↥S L), (c : L) = algebraMap K L z) →
    ∀ (𝔓 y : Ideal ↥(integralClosure ↥S L)), 𝔓.IsPrime → y.IsPrime → 𝔓 ≤ y →
    (∃ σ p : ↥(integralClosure ↥S L), σ ∉ 𝔓 ∧ p ∈ 𝔓 ∧ (σ : L) * algebraMap K L t = (p : L)) →
    ∃ 𝔷 Q : Ideal ↥(integralClosure ↥T L), 𝔷.IsPrime ∧ Q.IsPrime ∧ 𝔷 ≤ Q ∧
      Q.comap (wcIcxIncl L S T h) = y ∧ 𝔷.comap (wcIcxIncl L S T h) = 𝔓 ∧
      ∀ z : ↥(integralClosure ↥T L), z ∈ 𝔷 ↔
        ∃ σ p : ↥(integralClosure ↥S L), σ ∉ 𝔓 ∧ p ∈ 𝔓 ∧ (z : L) * (σ : L) = (p : L) :=
by
  intro A _ K _ _ L _ _ S T h t U hT hU 𝔓 y h𝔓 hy h𝔓y hσ
  classical
  obtain ⟨σ₀, p₀, hσ₀, hp₀, he₀⟩ := hσ
  have one_nm : (1 : ↥(integralClosure ↥S L)) ∉ 𝔓 :=
    fun h1 => h𝔓.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have cong : ∀ k ∈ Algebra.adjoin A (insert t U), ∃ b σ p : ↥(integralClosure ↥S L),
      σ ∉ 𝔓 ∧ p ∈ 𝔓 ∧ (algebraMap K L k - (b : L)) * (σ : L) = (p : L) := by
    intro k hk
    induction hk using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · refine ⟨0, σ₀, p₀, hσ₀, hp₀, ?_⟩
        push_cast
        linear_combination he₀
      · obtain ⟨c, hc⟩ := hU x hx
        refine ⟨c, 1, 0, one_nm, Ideal.zero_mem _, ?_⟩
        rw [hc]
        simp
    | algebraMap a =>
      refine ⟨algebraMap ↥S ↥(integralClosure ↥S L) ⟨algebraMap A K a, S.algebraMap_mem a⟩, 1, 0,
        one_nm, Ideal.zero_mem _, ?_⟩
      show (algebraMap K L (algebraMap A K a) - algebraMap K L (algebraMap A K a)) *
        ((1 : ↥(integralClosure ↥S L)) : L) = ((0 : ↥(integralClosure ↥S L)) : L)
      simp
    | add x z hx hz ihx ihz =>
      obtain ⟨b₁, σ₁, p₁, hσ₁, hp₁, e₁⟩ := ihx
      obtain ⟨b₂, σ₂, p₂, hσ₂, hp₂, e₂⟩ := ihz
      refine ⟨b₁ + b₂, σ₁ * σ₂, p₁ * σ₂ + p₂ * σ₁, h𝔓.mul_notMem hσ₁ hσ₂,
        𝔓.add_mem (𝔓.mul_mem_right _ hp₁) (𝔓.mul_mem_right _ hp₂), ?_⟩
      rw [map_add]
      push_cast
      linear_combination (σ₂ : L) * e₁ + (σ₁ : L) * e₂
    | mul x z hx hz ihx ihz =>
      obtain ⟨b₁, σ₁, p₁, hσ₁, hp₁, e₁⟩ := ihx
      obtain ⟨b₂, σ₂, p₂, hσ₂, hp₂, e₂⟩ := ihz
      refine ⟨b₁ * b₂, σ₁ * σ₂, p₁ * p₂ + p₁ * b₂ * σ₂ + b₁ * σ₁ * p₂, h𝔓.mul_notMem hσ₁ hσ₂,
        𝔓.add_mem (𝔓.add_mem (𝔓.mul_mem_right _ hp₁)
          (𝔓.mul_mem_right _ (𝔓.mul_mem_right _ hp₁))) (𝔓.mul_mem_left _ hp₂), ?_⟩
      rw [map_mul]
      push_cast
      linear_combination (algebraMap K L z * (σ₂ : L)) * e₁ + ((p₁ : L) + (b₁ : L) * (σ₁ : L)) * e₂

  have denT : ∀ τ ∈ T, ∃ σ c : ↥(integralClosure ↥S L), σ ∉ 𝔓 ∧
      algebraMap K L τ * (σ : L) = (c : L) := by
    intro τ hτ
    obtain ⟨b, σ, p, hσ, hp, e⟩ := cong τ (hT τ hτ)
    exact ⟨σ, p + b * σ, hσ, by push_cast; linear_combination e⟩

  have den : ∀ z : ↥(integralClosure ↥T L), ∃ σ c : ↥(integralClosure ↥S L), σ ∉ 𝔓 ∧
      (z : L) * (σ : L) = (c : L) := by
    intro z
    have hz : IsIntegral (↥T) (z : L) := z.2
    obtain ⟨f, hfm, hf⟩ := hz
    have common : ∀ n : ℕ, ∃ σ : ↥(integralClosure ↥S L), σ ∉ 𝔓 ∧ ∀ i < n,
        ∃ c : ↥(integralClosure ↥S L), algebraMap (↥T) L (f.coeff i) * (σ : L) = (c : L) := by
      intro n
      induction n with
      | zero => exact ⟨1, one_nm, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
      | succ n ih =>
        obtain ⟨σ, hσ, hc⟩ := ih
        obtain ⟨σ', c', hσ', hc'⟩ := denT ((f.coeff n : ↥T) : K) (f.coeff n).2
        have e' : algebraMap (↥T) L (f.coeff n) = algebraMap K L ((f.coeff n : ↥T) : K) := rfl
        refine ⟨σ * σ', h𝔓.mul_notMem hσ hσ', fun i hi => ?_⟩
        rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
        · obtain ⟨c, hc⟩ := hc i hi
          exact ⟨c * σ', by push_cast; rw [← hc]; ring⟩
        · exact ⟨c' * σ, by push_cast; rw [← hc', e']; ring⟩
    obtain ⟨σ, hσ, hc⟩ := common f.natDegree
    have hFm : (f.map (algebraMap (↥T) L)).Monic := hfm.map _
    have hFdeg : (f.map (algebraMap (↥T) L)).natDegree = f.natDegree := hfm.natDegree_map _
    have hF0 : Polynomial.eval₂ (RingHom.id L) (z : L) (f.map (algebraMap (↥T) L)) = 0 := by
      rw [Polynomial.eval₂_id, Polynomial.eval_map]
      exact hf
    have hG0 := Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id L) (s := (σ : L)) hF0
    have hGm : ((f.map (algebraMap (↥T) L)).scaleRoots (σ : L)).Monic := by
      rw [Polynomial.monic_scaleRoots_iff]; exact hFm
    have hlift : (f.map (algebraMap (↥T) L)).scaleRoots (σ : L) ∈
        Polynomial.lifts (algebraMap ↥(integralClosure ↥S L) L) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, hFdeg, Polynomial.coeff_map]
      rcases lt_trichotomy i f.natDegree with hi | rfl | hi
      · obtain ⟨c, hc⟩ := hc i hi
        refine ⟨c * σ ^ (f.natDegree - i - 1), ?_⟩
        have hm : f.natDegree - i = (f.natDegree - i - 1) + 1 := by omega
        rw [hm]
        change ((c * σ ^ (f.natDegree - i - 1) : ↥(integralClosure ↥S L)) : L) = _
        push_cast
        rw [← hc]
        ring
      · refine ⟨1, ?_⟩
        simp [hfm.coeff_natDegree]
      · refine ⟨0, ?_⟩
        simp [Polynomial.coeff_eq_zero_of_natDegree_lt hi]
    obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hGm
    have hB : IsIntegral (↥(integralClosure ↥S L)) ((σ : L) * (z : L)) := by
      refine ⟨q, hqm, ?_⟩
      rw [Polynomial.eval₂_eq_eval_map, hq]
      exact hG0
    have hS : IsIntegral (↥S) ((σ : L) * (z : L)) := isIntegral_trans _ hB
    refine ⟨σ, ⟨(σ : L) * (z : L), hS⟩, hσ, ?_⟩
    show (z : L) * (σ : L) = (σ : L) * (z : L)
    ring

  let 𝔷 : Ideal ↥(integralClosure ↥T L) :=
    { carrier := {z | ∃ σ p : ↥(integralClosure ↥S L), σ ∉ 𝔓 ∧ p ∈ 𝔓 ∧
        (z : L) * (σ : L) = (p : L)}
      add_mem' := by
        rintro a b ⟨σ₁, p₁, hσ₁, hp₁, e₁⟩ ⟨σ₂, p₂, hσ₂, hp₂, e₂⟩
        refine ⟨σ₁ * σ₂, p₁ * σ₂ + p₂ * σ₁, h𝔓.mul_notMem hσ₁ hσ₂,
          𝔓.add_mem (𝔓.mul_mem_right _ hp₁) (𝔓.mul_mem_right _ hp₂), ?_⟩
        push_cast
        linear_combination (σ₂ : L) * e₁ + (σ₁ : L) * e₂
      zero_mem' := ⟨1, 0, one_nm, Ideal.zero_mem _, by simp⟩
      smul_mem' := by
        rintro c a ⟨σ₁, p₁, hσ₁, hp₁, e₁⟩
        obtain ⟨σ₂, d, hσ₂, e₂⟩ := den c
        refine ⟨σ₁ * σ₂, d * p₁, h𝔓.mul_notMem hσ₁ hσ₂, 𝔓.mul_mem_left _ hp₁, ?_⟩
        show ((c * a : ↥(integralClosure ↥T L)) : L) * _ = _
        push_cast
        linear_combination ((c : L) * (σ₂ : L)) * e₁ + (p₁ : L) * e₂ }
  have hmem : ∀ z : ↥(integralClosure ↥T L), z ∈ 𝔷 ↔
      ∃ σ p : ↥(integralClosure ↥S L), σ ∉ 𝔓 ∧ p ∈ 𝔓 ∧ (z : L) * (σ : L) = (p : L) :=
    fun z => Iff.rfl
  have h𝔷 : 𝔷.IsPrime := by
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : ↥(integralClosure ↥T L)) ∈ 𝔷 := htop ▸ Submodule.mem_top
      obtain ⟨σ, p, hσ, hp, e⟩ := (hmem 1).mp h1
      apply hσ
      have : σ = p := Subtype.ext (by rw [← e]; push_cast; ring)
      rw [this]
      exact hp
    · intro z₁ z₂ hz
      obtain ⟨σ, p, hσ, hp, e⟩ := (hmem _).mp hz
      obtain ⟨σ₁, d₁, hσ₁, e₁⟩ := den z₁
      obtain ⟨σ₂, d₂, hσ₂, e₂⟩ := den z₂
      have e3 : d₁ * d₂ * σ = p * (σ₁ * σ₂) := by
        apply Subtype.ext
        push_cast at e ⊢
        linear_combination (-((d₂ : L) * (σ : L))) * e₁ +
          (-((z₁ : L) * (σ₁ : L) * (σ : L))) * e₂ + ((σ₁ : L) * (σ₂ : L)) * e
      have h3 : d₁ * d₂ * σ ∈ 𝔓 := by rw [e3]; exact 𝔓.mul_mem_right _ hp
      rcases h𝔓.mem_or_mem h3 with h4 | h4
      · rcases h𝔓.mem_or_mem h4 with h5 | h5
        · exact Or.inl ((hmem _).mpr ⟨σ₁, d₁, hσ₁, h5, e₁⟩)
        · exact Or.inr ((hmem _).mpr ⟨σ₂, d₂, hσ₂, h5, e₂⟩)
      · exact absurd h4 hσ

  have h𝔷c : 𝔷.comap (wcIcxIncl L S T h) = 𝔓 := by
    ext x
    rw [Ideal.mem_comap, hmem]
    constructor
    · rintro ⟨σ, p, hσ, hp, e⟩
      have e' : x * σ = p := Subtype.ext (by push_cast; exact e)
      have : x * σ ∈ 𝔓 := e' ▸ hp
      exact (h𝔓.mem_or_mem this).resolve_right hσ
    · intro hx
      refine ⟨1, x, one_nm, hx, ?_⟩
      show (x : L) * ((1 : ↥(integralClosure ↥S L)) : L) = (x : L)
      simp

  have lo : ∀ (R B C : Type u) [CommRing R] [CommRing B] [CommRing C] (g : R →+* C)
      (f : B →+* C), g.IsIntegral →
      ∀ (𝔓 y : Ideal B) (𝔷 : Ideal C), 𝔓.IsPrime → y.IsPrime → 𝔷.IsPrime →
      𝔓 ≤ y → 𝔷.comap f = 𝔓 → (∀ r : R, ∃ b : B, g r - f b ∈ 𝔷) →
      ∃ Q : Ideal C, Q.IsPrime ∧ 𝔷 ≤ Q ∧ Q.comap f = y := by
    intro R B C _ _ _ g f hg 𝔓 y 𝔷 h𝔓 hy h𝔷 h𝔓y hc hcong
    haveI := h𝔓
    haveI := hy
    haveI := h𝔷
    let fb : B ⧸ 𝔓 →+* C ⧸ 𝔷 := Ideal.quotientMap 𝔷 f hc.ge
    have hinj : Function.Injective fb := Ideal.quotientMap_injective' hc.le
    letI : Algebra (B ⧸ 𝔓) (C ⧸ 𝔷) := fb.toAlgebra
    haveI : Algebra.IsIntegral (B ⧸ 𝔓) (C ⧸ 𝔷) := by
      constructor
      intro x
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨p, hpm, hp⟩ := hg c
      have hlift : p.map ((Ideal.Quotient.mk 𝔷).comp g) ∈ Polynomial.lifts fb := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        rw [Polynomial.coeff_map]
        obtain ⟨b, hb⟩ := hcong (p.coeff n)
        refine ⟨Ideal.Quotient.mk 𝔓 b, ?_⟩
        show Ideal.quotientMap 𝔷 f hc.ge (Ideal.Quotient.mk 𝔓 b) = _
        rw [Ideal.quotientMap_mk, RingHom.comp_apply]
        exact (Ideal.Quotient.eq.mpr hb).symm
      obtain ⟨q, hqmap, -, hqm⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic hlift (hpm.map _)
      refine ⟨q, hqm, ?_⟩
      show Polynomial.eval₂ fb _ q = 0
      rw [Polynomial.eval₂_eq_eval_map, hqmap, Polynomial.eval_map, ← Polynomial.hom_eval₂, hp,
        map_zero]
    haveI hyb : (y.map (Ideal.Quotient.mk 𝔓)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact h𝔓y)
    obtain ⟨Qb, -, hQb, hQbc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
      (y.map (Ideal.Quotient.mk 𝔓)) (⊥ : Ideal (C ⧸ 𝔷)) (Ideal.comap_bot_le_of_injective _ hinj)
    have hQbc' : Qb.comap fb = y.map (Ideal.Quotient.mk 𝔓) := hQbc
    refine ⟨Qb.comap (Ideal.Quotient.mk 𝔷), Ideal.comap_isPrime _ _, ?_, ?_⟩
    · intro z hz
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hz]
      exact Qb.zero_mem
    · ext b
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have e1 : Ideal.Quotient.mk 𝔷 (f b) = fb (Ideal.Quotient.mk 𝔓 b) := rfl
      rw [e1, ← Ideal.mem_comap, hQbc', Ideal.mem_quotient_iff_mem h𝔓y]

  have hcongT : ∀ r : ↥T, ∃ b : ↥(integralClosure ↥S L),
      algebraMap (↥T) ↥(integralClosure ↥T L) r - wcIcxIncl L S T h b ∈ 𝔷 := by
    intro r
    obtain ⟨b, σ, p, hσ, hp, e⟩ := cong (r : K) (hT _ r.2)
    refine ⟨b, (hmem _).mpr ⟨σ, p, hσ, hp, ?_⟩⟩
    exact e
  obtain ⟨Q, hQ, h𝔷Q, hQy⟩ := lo (↥T) ↥(integralClosure ↥S L) ↥(integralClosure ↥T L)
    (algebraMap (↥T) ↥(integralClosure ↥T L)) (wcIcxIncl L S T h)
    (fun c => Algebra.IsIntegral.isIntegral c) 𝔓 y 𝔷 h𝔓 hy h𝔷 h𝔓y h𝔷c hcongT
  exact ⟨𝔷, Q, h𝔷, hQ, h𝔷Q, hQy, h𝔷c, hmem⟩

theorem wcpa_dj_llsm_isice_three_branches_bad : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    {L : Type u} [Field L] (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
    (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime],
    IsNoetherianRing (wcLlsFS W wL R 𝔮) → IsReduced (wcLlsFS W wL R 𝔮) →
    ¬ wcpaDjLkBad (wcLlsFS W wL R 𝔮) →
    ∀ p₁ ∈ (Ideal.span {c : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (c : L) = wL w}).minimalPrimes,
    ∀ p₂ ∈ (Ideal.span {c : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (c : L) = wL w}).minimalPrimes,
    ∀ p₃ ∈ (Ideal.span {c : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (c : L) = wL w}).minimalPrimes,
    p₁ ≤ 𝔮 → p₂ ≤ 𝔮 → p₃ ≤ 𝔮 → p₁ = p₂ ∨ p₁ = p₃ ∨ p₂ = p₃ :=
by
  have gen : ∀ (C : Type u) [CommRing C] (J 𝔮 : Ideal C) [𝔮.IsPrime],
      IsNoetherianRing (Localization.AtPrime 𝔮 ⧸ J.map (algebraMap C (Localization.AtPrime 𝔮))) →
      _root_.IsReduced (Localization.AtPrime 𝔮 ⧸ J.map (algebraMap C (Localization.AtPrime 𝔮))) →
      ¬ wcpaDjLkBad (Localization.AtPrime 𝔮 ⧸ J.map (algebraMap C (Localization.AtPrime 𝔮))) →
      ∀ p₁ ∈ J.minimalPrimes, ∀ p₂ ∈ J.minimalPrimes, ∀ p₃ ∈ J.minimalPrimes,
      p₁ ≤ 𝔮 → p₂ ≤ 𝔮 → p₃ ≤ 𝔮 → p₁ = p₂ ∨ p₁ = p₃ ∨ p₂ = p₃ := by
    intro C _ J 𝔮 _ hnoeth hred hbad p₁ hp₁ p₂ hp₂ p₃ hp₃ h₁ h₂ h₃
    have tr : ∀ p ∈ J.minimalPrimes, p ≤ 𝔮 →
        Ideal.under C (p.map (algebraMap C (Localization.AtPrime 𝔮))) = p ∧
        ∃ P ∈ minimalPrimes (Localization.AtPrime 𝔮 ⧸
            J.map (algebraMap C (Localization.AtPrime 𝔮))),
          P.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime 𝔮)))) =
            p.map (algebraMap C (Localization.AtPrime 𝔮)) := by
      intro p hp hpq
      have hpp : p.IsPrime := hp.1.1
      have hdisj : Disjoint (𝔮.primeCompl : Set C) (p : Set C) := by
        rw [Set.disjoint_left]
        intro x hx hxp
        exact hx (hpq hxp)
      have hu := IsLocalization.under_map_of_isPrime_disjoint 𝔮.primeCompl
        (Localization.AtPrime 𝔮) hpp hdisj
      refine ⟨hu, ?_⟩
      have hmem : p.map (algebraMap C (Localization.AtPrime 𝔮)) ∈
          (J.map (algebraMap C (Localization.AtPrime 𝔮))).minimalPrimes := by
        rw [IsLocalization.minimalPrimes_map 𝔮.primeCompl (Localization.AtPrime 𝔮) J,
          Set.mem_preimage, hu]
        exact hp
      rw [Ideal.minimalPrimes_eq_comap] at hmem
      obtain ⟨P, hP, hPc⟩ := hmem
      exact ⟨P, hP, hPc⟩
    by_contra hne
    push_neg at hne
    obtain ⟨hne12, hne13, hne23⟩ := hne
    obtain ⟨hu₁, P₁, hP₁, hc₁⟩ := tr p₁ hp₁ h₁
    obtain ⟨hu₂, P₂, hP₂, hc₂⟩ := tr p₂ hp₂ h₂
    obtain ⟨hu₃, P₃, hP₃, hc₃⟩ := tr p₃ hp₃ h₃
    have inj : ∀ {p p' : Ideal C}
        {Q Q' : Ideal (Localization.AtPrime 𝔮 ⧸ J.map (algebraMap C (Localization.AtPrime 𝔮)))},
        Ideal.under C (p.map (algebraMap C (Localization.AtPrime 𝔮))) = p →
        Ideal.under C (p'.map (algebraMap C (Localization.AtPrime 𝔮))) = p' →
        Q.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime 𝔮)))) =
          p.map (algebraMap C (Localization.AtPrime 𝔮)) →
        Q'.comap (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime 𝔮)))) =
          p'.map (algebraMap C (Localization.AtPrime 𝔮)) → Q = Q' → p = p' := by
      intro p p' Q Q' hu hu' hc hc' hQ
      rw [← hu, ← hu', ← hc, ← hc', hQ]
    have n12 : P₁ ≠ P₂ := fun h => hne12 (inj hu₁ hu₂ hc₁ hc₂ h)
    have n13 : P₁ ≠ P₃ := fun h => hne13 (inj hu₁ hu₃ hc₁ hc₃ h)
    have n23 : P₂ ≠ P₃ := fun h => hne23 (inj hu₂ hu₃ hc₂ hc₃ h)
    have hpr : P₁.IsPrime := hP₁.1.1
    haveI : Nontrivial (Localization.AtPrime 𝔮 ⧸
        J.map (algebraMap C (Localization.AtPrime 𝔮))) := by
      refine nontrivial_of_ne 0 1 ?_
      intro h
      apply hpr.ne_top
      rw [Ideal.eq_top_iff_one, ← h]
      exact P₁.zero_mem
    haveI : IsLocalRing (Localization.AtPrime 𝔮 ⧸
        J.map (algebraMap C (Localization.AtPrime 𝔮))) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    haveI := hnoeth
    haveI := hred
    have hinj : Function.Injective (![P₁, P₂, P₃] : Fin 3 → Ideal (Localization.AtPrime 𝔮 ⧸
        J.map (algebraMap C (Localization.AtPrime 𝔮)))) := by
      intro i j hij
      fin_cases i <;> fin_cases j <;> simp at hij ⊢ <;>
        first
        | exact n12 hij | exact n13 hij | exact n23 hij
        | exact n12 hij.symm | exact n13 hij.symm | exact n23 hij.symm
    have hmin : ∀ i, (![P₁, P₂, P₃] : Fin 3 → Ideal (Localization.AtPrime 𝔮 ⧸
        J.map (algebraMap C (Localization.AtPrime 𝔮)))) i ∈ minimalPrimes (Localization.AtPrime 𝔮 ⧸
        J.map (algebraMap C (Localization.AtPrime 𝔮))) := by
      intro i
      fin_cases i
      · exact hP₁
      · exact hP₂
      · exact hP₃
    obtain ⟨hδ, hBr⟩ := wcpa_dj_lr1k_ll_db_two_minimal_primes
      (Localization.AtPrime 𝔮 ⧸ J.map (algebraMap C (Localization.AtPrime 𝔮))) 3
      ![P₁, P₂, P₃] hinj hmin (by norm_num)
    rcases not_not.mp hbad with h | ⟨_, h⟩
    · exact hδ h
    · rw [h] at hBr
      norm_num at hBr
  intro Ω _ W L _ wL R _ _ 𝔮 _
  exact gen _ (Ideal.span {c : ↥(integralClosure R L) |
    ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (c : L) = wL w}) 𝔮

theorem wcpa_dj_llsm_isice_fs_reduced_noetherian : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A),
    wcLlsPD W A 𝔭 k → ∀ (R : Subalgebra A K), R.FG →
    ∀ (𝔮 : Ideal ↥(integralClosure ↥R L)) [𝔮.IsPrime],
    IsReduced (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) ↥R 𝔮) ∧
    IsNoetherianRing
      (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) ↥R 𝔮) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k hPD R hRfg 𝔮 _
  classical
  have hAft : Algebra.FiniteType ↥W A := hPD.1
  have hAnz : NoZeroSMulDivisors ↥W A := hPD.2.1
  haveI := hAnz
  have hWA : Function.Injective (algebraMap W A) := by
    intro x y hxy
    rw [← sub_eq_zero]
    have h : (x - y) • (1 : A) = 0 := by
      rw [Algebra.smul_def, map_sub, hxy, sub_self, zero_mul]
    rcases smul_eq_zero.mp h with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hDft : Algebra.FiniteType A R := (Subalgebra.fg_iff_finiteType R).mp hRfg

  have hfin : Module.Finite ↥R ↥(integralClosure ↥R L) := by
    obtain ⟨ι₀, hι₀⟩ : ∃ ι₀ : W →+* K, ι₀ = (algebraMap A K).comp (algebraMap W A) := ⟨_, rfl⟩
    have hι₀inj : Function.Injective ι₀ := by
      rw [hι₀]; exact (IsFractionRing.injective A K).comp hWA
    let φ : Ω →+* K := IsFractionRing.lift (K := Ω) hι₀inj
    have hφ : ∀ c : W, φ (c : Ω) = ι₀ c := fun c => IsFractionRing.lift_algebraMap hι₀inj c
    letI : Algebra Ω K := φ.toAlgebra
    letI : Algebra Ω L := ((algebraMap K L).comp φ).toAlgebra
    haveI : IsScalarTower Ω K L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    letI : Algebra W R := ((algebraMap A R).comp (algebraMap W A)).toAlgebra
    haveI : IsScalarTower W A R := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hfc : ∀ c : W, algebraMap R K (algebraMap W R c) = ι₀ c := fun c => by
      rw [hι₀]; rfl
    have hfcΩ : ∀ c : W, algebraMap R K (algebraMap W R c) = algebraMap Ω K (c : Ω) := fun c => by
      rw [hfc]; exact (hφ c).symm
    have hWD : Algebra.FiniteType W R := Algebra.FiniteType.trans hAft hDft
    obtain ⟨G, hG⟩ := hWD.out
    obtain ⟨T, hT⟩ : ∃ T : Subalgebra Ω K, T = Algebra.adjoin Ω (Set.range (algebraMap R K)) :=
      ⟨_, rfl⟩
    have hTeq : T = Algebra.adjoin Ω ((G.image (algebraMap R K) : Finset K) : Set K) := by
      apply le_antisymm
      · rw [hT, Algebra.adjoin_le_iff]
        rintro _ ⟨r, rfl⟩
        have hr : r ∈ Algebra.adjoin W (G : Set R) := by rw [hG]; trivial
        induction hr using Algebra.adjoin_induction with
        | mem x hx =>
          exact Algebra.subset_adjoin (Finset.mem_coe.mpr
            (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx)))
        | algebraMap c =>
          rw [hfcΩ]
          exact Subalgebra.algebraMap_mem _ _
        | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
        | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
      · rw [hT]
        apply Algebra.adjoin_mono
        intro x hx
        rw [Finset.coe_image] at hx
        obtain ⟨r, _, rfl⟩ := hx
        exact ⟨r, rfl⟩
    have hTft : Algebra.FiniteType Ω T := (Subalgebra.fg_iff_finiteType T).mp ⟨_, hTeq.symm⟩
    have hden : ∀ x ∈ T, ∃ c : W, c ≠ 0 ∧ ι₀ c * x ∈ Set.range (algebraMap R K) := by
      intro x hx
      rw [hT] at hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        obtain ⟨r, rfl⟩ := hx
        exact ⟨1, one_ne_zero, r, by rw [map_one, one_mul]⟩
      | algebraMap ω =>
        by_cases hω : ω ∈ W
        · refine ⟨1, one_ne_zero, algebraMap W R ⟨ω, hω⟩, ?_⟩
          rw [map_one, one_mul, hfcΩ]
        · have hω0 : ω ≠ 0 := fun h => hω (h ▸ W.zero_mem)
          have hinv : ω⁻¹ ∈ W := (W.mem_or_inv_mem ω).resolve_left hω
          refine ⟨⟨ω⁻¹, hinv⟩, fun h => inv_ne_zero hω0 (congrArg Subtype.val h), 1, ?_⟩
          rw [map_one, ← hφ]
          show (1 : K) = φ ω⁻¹ * φ ω
          rw [← map_mul, inv_mul_cancel₀ hω0, map_one]
      | add x y _ _ hx hy =>
        obtain ⟨c₁, hc₁, r₁, hr₁⟩ := hx
        obtain ⟨c₂, hc₂, r₂, hr₂⟩ := hy
        refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, algebraMap W R c₂ * r₁ + algebraMap W R c₁ * r₂, ?_⟩
        rw [map_add, map_mul, map_mul, hr₁, hr₂, hfc, hfc, map_mul]
        ring
      | mul x y _ _ hx hy =>
        obtain ⟨c₁, hc₁, r₁, hr₁⟩ := hx
        obtain ⟨c₂, hc₂, r₂, hr₂⟩ := hy
        refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, r₁ * r₂, ?_⟩
        rw [map_mul, hr₁, hr₂, map_mul]
        ring
    haveI : FaithfulSMul T K :=
      (faithfulSMul_iff_algebraMap_injective T K).mpr Subtype.val_injective
    have hfT : ∀ a : A, algebraMap A K a ∈ T := fun a => by
      rw [hT]; exact Algebra.subset_adjoin ⟨algebraMap A R a, rfl⟩
    haveI hTfrac : IsFractionRing T K := IsFractionRing.of_field T K (fun z => by
      obtain ⟨x, y, _, hxy⟩ := IsFractionRing.div_surjective (A := A) z
      exact ⟨⟨_, hfT x⟩, ⟨_, hfT y⟩, hxy.symm⟩)
    haveI := hTft
    have hNfin : Module.Finite T (integralClosure T L) :=
      wc_sf_integralClosure_finite_of_embedding Ω T K L L (AlgHom.id T L) (fun _ _ h => h)
        noether_integralClosure_finite
    obtain ⟨N, hN⟩ : ∃ N : Subalgebra T L, N = integralClosure T L := ⟨_, rfl⟩
    have hmemN : ∀ x : L, x ∈ N ↔ IsIntegral T x := fun x => by rw [hN]; rfl
    rw [← hN] at hNfin
    have hNft : Algebra.FiniteType Ω N :=
      Algebra.FiniteType.trans hTft (Module.Finite.finiteType (R := T) N)
    letI : Algebra W N := ((algebraMap Ω N).comp (algebraMap W Ω)).toAlgebra
    haveI : IsScalarTower W Ω N := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let ρ : R →+* T := RingHom.codRestrict (algebraMap R K) T
      (fun d => by rw [hT]; exact Algebra.subset_adjoin ⟨d, rfl⟩)
    have hρE : ∀ d : R, algebraMap T L (ρ d) = algebraMap R L d := fun d => rfl
    have hDN : ∀ d : R, algebraMap R L d ∈ N := fun d => by
      rw [hmemN, ← hρE]; exact isIntegral_algebraMap
    let ψ : R →+* N := RingHom.codRestrict (algebraMap R L) N hDN
    letI : Algebra R N := ψ.toAlgebra
    have hWDN : IsScalarTower W R N := IsScalarTower.of_algebraMap_eq (fun c => by
      apply Subtype.ext
      show algebraMap K L (φ (c : Ω)) = algebraMap K L (algebraMap R K (algebraMap W R c))
      rw [hφ, hfc])
    let j : N →ₐ[R] L := { toRingHom := (N.val : N →+* L), commutes' := fun _ => rfl }
    have hj : Function.Injective j := Subtype.val_injective
    choose! cf hcf0 hcf using hden
    have hgen : ∀ b : N, ∃ c : W, c ≠ 0 ∧ IsIntegral R (algebraMap W N c * b) := by
      intro b
      obtain ⟨p, hpm, hp⟩ := (hmemN (b : L)).mp b.2
      set n := p.natDegree with hn
      refine ⟨∏ i ∈ Finset.range n, cf (p.coeff i : K),
        Finset.prod_ne_zero_iff.mpr (fun i _ => hcf0 _ (p.coeff i).2), ?_⟩
      set c := ∏ i ∈ Finset.range n, cf (p.coeff i : K) with hc
      have hγmem : ι₀ c ∈ T := by
        have : ι₀ c = algebraMap A K (algebraMap W A c) := by rw [hι₀]; rfl
        rw [this]; exact hfT _
      set γ : T := ⟨ι₀ c, hγmem⟩ with hγ
      have hrange : ∀ x : T, (x : K) ∈ Set.range (algebraMap R K) → x ∈ Set.range ρ := by
        rintro x ⟨d, hd⟩
        exact ⟨d, Subtype.ext hd⟩
      have hι₀r : ∀ c' : W, ι₀ c' ∈ Set.range (algebraMap R K) := fun c' => ⟨_, hfc c'⟩
      have hlift : p.scaleRoots γ ∈ Polynomial.lifts ρ := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro i
        rw [Polynomial.coeff_scaleRoots]
        apply hrange
        by_cases hi : i < n
        · obtain ⟨e, he⟩ := Finset.dvd_prod_of_mem (fun i => cf (p.coeff i : K))
            (Finset.mem_range.mpr hi)
          obtain ⟨m, hm⟩ : ∃ m, n - i = m + 1 := ⟨n - i - 1, by omega⟩
          have hval : ((p.coeff i * γ ^ (n - i) : T) : K) =
              (ι₀ (cf (p.coeff i : K)) * (p.coeff i : K)) * ι₀ e * (ι₀ c) ^ m := by
            rw [hm, Subalgebra.coe_mul, Subalgebra.coe_pow]
            show (p.coeff i : K) * (ι₀ c) ^ (m + 1) = _
            have hce : ι₀ c = ι₀ (cf (p.coeff i : K)) * ι₀ e := by rw [hc, he, map_mul]
            rw [pow_succ, hce]
            ring
          rw [hval]
          obtain ⟨d₁, hd₁⟩ := hcf _ (p.coeff i).2
          obtain ⟨d₂, hd₂⟩ := hι₀r e
          obtain ⟨d₃, hd₃⟩ := hι₀r c
          exact ⟨d₁ * d₂ * d₃ ^ m, by rw [map_mul, map_mul, map_pow, hd₁, hd₂, hd₃]⟩
        · have hni : n - i = 0 := by omega
          rw [hni, pow_zero, mul_one]
          rcases (Nat.le_of_not_lt hi).eq_or_lt with h | h
          · rw [← h, hn, hpm.coeff_natDegree]
            exact ⟨1, by rw [map_one]; rfl⟩
          · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [← hn]; exact h)]
            exact ⟨0, by rw [map_zero]; rfl⟩
      obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
        ((Polynomial.monic_scaleRoots_iff γ).mpr hpm)
      have hroot := Polynomial.scaleRoots_eval₂_eq_zero (algebraMap T L) (s := γ) hp
      rw [← hqmap, Polynomial.eval₂_map] at hroot
      have hint : IsIntegral R (algebraMap T L γ * (b : L)) := ⟨q, hqm, hroot⟩
      rw [← isIntegral_algHom_iff j hj]
      have : j (algebraMap W N c * b) = algebraMap T L γ * (b : L) := by
        show algebraMap K L (φ (c : Ω)) * (b : L) = algebraMap K L (ι₀ c) * (b : L)
        rw [hφ]
      rw [this]
      exact hint
    have hnfr : Algebra.FiniteType R (integralClosure R N) :=
      wcpa_dj_lr1s_nf_ring_reduction Ω W hW R N hWD hNft inferInstance hgen
    let J : integralClosure R N →ₐ[R] integralClosure R L :=
      (j.comp (integralClosure R N).val).codRestrict (integralClosure R L)
        (fun x => x.2.map j)
    have hJ : Function.Surjective J := by
      intro y
      have hyT : IsIntegral T (y : L) := by
        have := IsIntegral.map_of_comp_eq (T := T) (U := L) ρ (RingHom.id L)
          (RingHom.ext fun d => rfl) y.2
        exact this
      let b : N := ⟨y, (hmemN _).mpr hyT⟩
      have hb : IsIntegral R b := (isIntegral_algHom_iff j hj).mp y.2
      exact ⟨⟨b, hb⟩, Subtype.ext rfl⟩
    haveI : Algebra.FiniteType R (integralClosure R L) := hnfr.of_surjective J hJ
    exact Algebra.IsIntegral.finite

  set σ : ↥W →+* ↥(integralClosure ↥R L) :=
    (algebraMap ↥R ↥(integralClosure ↥R L)).comp ((algebraMap A ↥R).comp (algebraMap ↥W A))
    with hσ
  have hwL : Function.Injective
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) := by
    rw [RingHom.coe_comp, RingHom.coe_comp]
    exact (algebraMap K L).injective.comp ((IsFractionRing.injective A K).comp hWA)
  have hcoe : ∀ w : ↥W, ((σ w : ↥(integralClosure ↥R L)) : L) =
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := fun w => rfl
  have hσinj : Function.Injective σ := fun w₁ w₂ h => hwL (by rw [← hcoe, ← hcoe, h])

  have hRed := wcpa_dj_llsm_obi_fs_reduced Ω W L _ hwL ↥R (fun x => by
    show IsIntegral ↥R (algebraMap ↥R L (algebraMap A ↥R (algebraMap ↥W A x)))
    exact isIntegral_algebraMap) 𝔮

  have hFTσ : σ.FiniteType := by
    have h1 : (algebraMap ↥W A).FiniteType := RingHom.finiteType_algebraMap.mpr hAft
    have h2 : (algebraMap A ↥R).FiniteType := RingHom.finiteType_algebraMap.mpr hDft
    have h3 : (algebraMap ↥R ↥(integralClosure ↥R L)).FiniteType :=
      RingHom.FiniteType.of_finite (RingHom.finite_algebraMap.mpr hfin)
    exact h3.comp (h2.comp h1)

  haveI : FaithfulSMul ↥R K := by
    rw [faithfulSMul_iff_algebraMap_injective]; intro x y h; exact Subtype.ext h
  haveI : IsFractionRing ↥R K := IsFractionRing.of_field _ K (fun z => by
    obtain ⟨a, b, -, hz⟩ := IsFractionRing.div_surjective (A := A) z
    exact ⟨algebraMap A ↥R a, algebraMap A ↥R b, hz.symm⟩)
  haveI hIC : IsIntegrallyClosed ↥(integralClosure ↥R L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (R := ↥R) K (L := L)

  have hred := wcpa_dj_llsm_mg_fibre_reduced Ω W _ σ hσinj

  have hI : Ideal.span {b : ↥(integralClosure ↥R L) |
      ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x} =
      (IsLocalRing.maximalIdeal ↥W).map σ := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨x, hx, hb⟩
      have hbx : b = σ x := Subtype.val_injective (hb.trans (hcoe x).symm)
      rw [hbx]
      exact Ideal.mem_map_of_mem σ hx
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact Ideal.subset_span ⟨x, hx, hcoe x⟩
  have hI' : (Ideal.span {b : ↥(integralClosure ↥R L) |
      ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x}).map
        (algebraMap ↥(integralClosure ↥R L) (Localization.AtPrime 𝔮)) =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(integralClosure ↥R L) (Localization.AtPrime 𝔮)).comp σ) := by
    rw [hI, Ideal.map_map]
  refine ⟨hRed, ?_⟩

  by_cases hle : (IsLocalRing.maximalIdeal ↥W).map σ ≤ 𝔮
  · have hN := (wcpa_dj_llsm_mg_fibre_noeth_norm Ω W _ σ hFTσ 𝔮 hle hred).1
    exact isNoetherianRing_of_ringEquiv _ (Ideal.quotEquivOfEq hI'.symm)
  · rw [Ideal.map_le_iff_le_comap] at hle
    obtain ⟨w, hw, hσw⟩ := Set.not_subset.mp hle
    have hunit : IsUnit (algebraMap ↥(integralClosure ↥R L) (Localization.AtPrime 𝔮) (σ w)) :=
      IsLocalization.map_units (Localization.AtPrime 𝔮) (⟨σ w, hσw⟩ : 𝔮.primeCompl)
    have hmem : algebraMap ↥(integralClosure ↥R L) (Localization.AtPrime 𝔮) (σ w) ∈
        (Ideal.span {b : ↥(integralClosure ↥R L) |
          ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
            (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x}).map
          (algebraMap ↥(integralClosure ↥R L) (Localization.AtPrime 𝔮)) :=
      Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨w, hw, hcoe w⟩)
    have hJ := Ideal.eq_top_of_isUnit_mem _ hmem hunit
    haveI hss : Subsingleton
        (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) ↥R 𝔮) :=
      Ideal.Quotient.subsingleton_iff.mpr hJ
    infer_instance

theorem wcpa_dj_llsm_isice_fibre_connected : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W)
    (hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a')
    (hRI : wcLlsASbS W A K u b ≤ wcIcxRI W A K u a' b)
    (hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a')
    (hIC : wcIcxRI W A K u a' b ≤ wcLlsIsiCR W A K u a'),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (y₀ : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y₀.IsPrime →
    y₀.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    ∀ (eo : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
      (eI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)),
      eo * eo - eo ∈ (y₀.map (wcIcxIncl L _ _ hRo)).radical →
      eI * eI - eI ∈ (y₀.map (wcIcxIncl L _ _ hRI)).radical →
      wcIcxIncl L _ _ hoC eo - wcIcxIncl L _ _ hIC eI ∈
        (y₀.map (wcIcxIncl L _ _ (hRo.trans hoC))).radical →
      (eo ∈ (y₀.map (wcIcxIncl L _ _ hRo)).radical ∧ eI ∈ (y₀.map (wcIcxIncl L _ _ hRI)).radical) ∨
      (eo - 1 ∈ (y₀.map (wcIcxIncl L _ _ hRo)).radical ∧
        eI - 1 ∈ (y₀.map (wcIcxIncl L _ _ hRI)).radical) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hRo hRI hoC hIC hPD ha'm ha'0
    hbm hb0 ha'b hnba hbg y₀ hy₀ hy₀c eo eI ho hI hC
  classical
  haveI := hy₀

  have s4L : ∀ (R : Type u) [CommRing R] (g x : R), x * x - x ∈ (Ideal.span {g}).radical →
      ∀ N : ℕ, ∃ x' : R, x' * x' - x' ∈ Ideal.span {g ^ N} ∧
        x' - x ∈ Ideal.span {x * x - x} := by
    intro R _ g x hx N
    set t := x * x - x with ht
    obtain ⟨r, hr⟩ := hx
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hr
    let f : R → R := fun w => 3 * w ^ 2 - 2 * w ^ 3
    have key : ∀ j : ℕ, (∃ a, a * t ^ (2 ^ j) = f^[j] x * f^[j] x - f^[j] x) ∧
        (∃ b, b * t = f^[j] x - x) := by
      intro j
      induction j with
      | zero => exact ⟨⟨1, by simp [ht]⟩, ⟨0, by simp⟩⟩
      | succ j ih =>
        obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := ih
        set w := f^[j] x with hw
        rw [Function.iterate_succ_apply']
        refine ⟨⟨a ^ 2 * (4 * w ^ 2 - 4 * w - 3), ?_⟩,
          ⟨a * t ^ (2 ^ j - 1) * (1 - 2 * w) + b, ?_⟩⟩
        · have e : t ^ (2 ^ (j + 1)) = (t ^ (2 ^ j)) ^ 2 := by rw [pow_succ, pow_mul]
          rw [e]
          show _ = (3 * w ^ 2 - 2 * w ^ 3) * (3 * w ^ 2 - 2 * w ^ 3) - (3 * w ^ 2 - 2 * w ^ 3)
          linear_combination (a * t ^ 2 ^ j + (w * w - w)) * (4 * w ^ 2 - 4 * w - 3) * ha
        · have hpos : 1 ≤ 2 ^ j := Nat.one_le_two_pow
          have e : t ^ (2 ^ j - 1) * t = t ^ (2 ^ j) := by
            rw [← pow_succ, Nat.sub_add_cancel hpos]
          show _ = (3 * w ^ 2 - 2 * w ^ 3) - x
          linear_combination (1 - 2 * w) * ha + a * (1 - 2 * w) * e + hb
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := key (r * N)
    refine ⟨f^[r * N] x, ?_, Ideal.mem_span_singleton'.mpr ⟨b, hb⟩⟩
    rw [← ha]
    apply Ideal.mul_mem_left
    have hle : r * N ≤ 2 ^ (r * N) := (Nat.lt_two_pow_self).le
    have e : t ^ (2 ^ (r * N)) = (t ^ r) ^ N * t ^ (2 ^ (r * N) - r * N) := by
      rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hle]
    rw [e, ← hc, mul_pow]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))

  have s5L : ∀ (R : Type u) [CommRing R] (g p q : R) (N : ℕ), p * p - p ∈ Ideal.span {g ^ N} →
      q * q - q ∈ Ideal.span {g ^ N} → p - q ∈ (Ideal.span {g}).radical →
      p - q ∈ Ideal.span {g ^ N} := by
    intro R _ g p q N hp hq hd
    set I := Ideal.span {g ^ N} with hI
    set d := p - q with hdd
    have h3 : d ^ 3 - d ∈ I := by
      have e : d ^ 3 - d = (p * p - p) * (1 + p - 3 * q) + (q * q - q) * (3 * p - q - 1) := by
        rw [hdd]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_right _ _ hq)
    have hk : ∀ k : ℕ, d ^ (2 * k + 1) - d ∈ I := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        have e : d ^ (2 * (k + 1) + 1) - d = d ^ 2 * (d ^ (2 * k + 1) - d) + (d ^ 3 - d) := by
          ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ ih) h3
    obtain ⟨m, hm⟩ := hd
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hm
    have hpow : d ^ (2 * (m * N) + 1) ∈ I := by
      have e : d ^ (2 * (m * N) + 1) = (d ^ m) ^ N * d ^ (m * N + 1) := by
        rw [← pow_mul, ← pow_add]; congr 1; ring
      rw [e, ← hβ, mul_pow]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    have := Ideal.sub_mem _ hpow (hk (m * N))
    rwa [sub_sub_cancel] at this

  have sepL : ∀ (R C : Type u) [CommRing R] [CommRing C] [Algebra R C], Module.Finite R C →
      ∀ (N : Ideal R), N.IsMaximal → ∀ (y₀ : Ideal C), y₀.IsPrime →
      y₀.comap (algebraMap R C) = N →
      ∃ ε : C, ε - 1 ∈ y₀ ∧ ∀ Q : Ideal C, Q.IsPrime → Q.comap (algebraMap R C) = N →
        Q ≠ y₀ → ε ∈ Q := by
    intro R C _ _ _ hfin N hN y₀ hy₀ hy₀c
    have hmaxQ : ∀ Q : Ideal C, Q.IsPrime → Q.comap (algebraMap R C) = N → Q.IsMaximal := by
      intro Q hQ hQc
      haveI : Algebra.IsIntegral R C := Algebra.IsIntegral.of_finite R C
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_under Q (by
        show (Q.comap (algebraMap R C)).IsMaximal
        rw [hQc]; exact hN)
    have hy₀m := hmaxQ y₀ hy₀ hy₀c
    set I := N.map (algebraMap R C) with hI
    have hart : IsArtinianRing (C ⧸ I) := by
      letI : Field (R ⧸ N) := Ideal.Quotient.field N
      haveI : Module.Finite R (C ⧸ I) :=
        Module.Finite.of_surjective (Ideal.Quotient.mkₐ R I).toLinearMap
          Ideal.Quotient.mk_surjective
      haveI : Module.Finite (R ⧸ N) (C ⧸ I) :=
        Module.Finite.of_restrictScalars_finite R _ _
      exact IsArtinianRing.of_finite (R ⧸ N) _
    set S := {Q : Ideal C | Q.IsPrime ∧ Q.comap (algebraMap R C) = N} with hS
    have hSfin : S.Finite := by
      apply Set.Finite.subset ((IsArtinianRing.setOf_isMaximal_finite (C ⧸ I)).image
        (fun J => J.comap (Ideal.Quotient.mk I)))
      rintro Q ⟨hQ, hQc⟩
      have hIQ : I ≤ Q := by rw [hI, Ideal.map_le_iff_le_comap, hQc]
      have hker : RingHom.ker (Ideal.Quotient.mk I) ≤ Q := by rw [Ideal.mk_ker]; exact hIQ
      haveI := hQ
      haveI hprime : (Q.map (Ideal.Quotient.mk I)).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
      refine ⟨Q.map (Ideal.Quotient.mk I), IsArtinianRing.isMaximal_of_isPrime _, ?_⟩
      show (Q.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = Q
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
        Ideal.mk_ker]
      exact sup_eq_left.mpr hIQ
    have hind : ∀ F : Finset (Ideal C), (∀ Q ∈ F, Q ∈ S ∧ Q ≠ y₀) →
        ∃ ε : C, ε - 1 ∈ y₀ ∧ ∀ Q ∈ F, ε ∈ Q := by
      intro F
      induction F using Finset.induction_on with
      | empty => intro _; exact ⟨1, by rw [sub_self]; exact y₀.zero_mem, fun Q hQ => by simp at hQ⟩
      | insert Q F hQF ih =>
        intro hF
        obtain ⟨ε', hε'1, hε'F⟩ := ih (fun Q' hQ' => hF Q' (Finset.mem_insert_of_mem hQ'))
        obtain ⟨⟨hQp, hQc⟩, hQne⟩ := hF Q (Finset.mem_insert_self Q F)
        have hcop : y₀ ⊔ Q = ⊤ := hy₀m.coprime_of_ne (hmaxQ Q hQp hQc) (Ne.symm hQne)
        have h1 : (1 : C) ∈ y₀ ⊔ Q := by rw [hcop]; exact Submodule.mem_top
        obtain ⟨a, ha, c, hc, hac⟩ := Submodule.mem_sup.mp h1
        refine ⟨c * ε', ?_, ?_⟩
        · have e : c * ε' - 1 = (-a) * ε' + (ε' - 1) := by linear_combination ε' * hac
          rw [e]
          exact y₀.add_mem (y₀.mul_mem_right _ (y₀.neg_mem ha)) hε'1
        · intro Q' hQ'
          rcases Finset.mem_insert.mp hQ' with h | h
          · rw [h]; exact Q.mul_mem_right _ hc
          · exact Q'.mul_mem_left _ (hε'F Q' h)
    obtain ⟨ε, hε1, hεF⟩ := hind (hSfin.sdiff (t := {y₀})).toFinset (fun Q hQ => by
      rw [Set.Finite.mem_toFinset] at hQ
      exact ⟨hQ.1, hQ.2⟩)
    refine ⟨ε, hε1, fun Q hQ hQc hQne => hεF Q ?_⟩
    rw [Set.Finite.mem_toFinset]
    exact ⟨⟨hQ, hQc⟩, hQne⟩

  have closL : ∀ (A K : Type u) [CommRing A] [CommRing K] [Algebra A K] (R₁ : Subalgebra A K)
      (s : K) (X : Set K), s ∈ R₁ → (∀ y ∈ X, ∃ k : ℕ, s ^ k * y ∈ R₁) →
      ∀ y ∈ Algebra.adjoin A X, ∃ k : ℕ, s ^ k * y ∈ R₁ := by
    intro A K _ _ _ R₁ s X hs hX y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx => exact hX x hx
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact R₁.algebraMap_mem a⟩
    | add x y _ _ hx hy =>
      obtain ⟨k, hk⟩ := hx
      obtain ⟨l, hl⟩ := hy
      refine ⟨k + l, ?_⟩
      have e : s ^ (k + l) * (x + y) = s ^ l * (s ^ k * x) + s ^ k * (s ^ l * y) := by ring
      rw [e]
      exact R₁.add_mem (R₁.mul_mem (R₁.pow_mem hs l) hk) (R₁.mul_mem (R₁.pow_mem hs k) hl)
    | mul x y _ _ hx hy =>
      obtain ⟨k, hk⟩ := hx
      obtain ⟨l, hl⟩ := hy
      refine ⟨k + l, ?_⟩
      have e : s ^ (k + l) * (x * y) = (s ^ k * x) * (s ^ l * y) := by ring
      rw [e]
      exact R₁.mul_mem hk hl

  have scaleL : ∀ (A K L : Type u) [CommRing A] [Field K] [Algebra A K] [Field L] [Algebra K L]
      (R₁ R₂ : Subalgebra A K) (s : K), s ∈ R₁ → (∀ y ∈ R₂, ∃ k : ℕ, s ^ k * y ∈ R₁) →
      ∀ x : L, IsIntegral R₂ x → ∃ N : ℕ, IsIntegral R₁ (algebraMap K L s ^ N * x) := by
    intro A K L _ _ _ _ _ R₁ R₂ s hs hR x hx
    obtain ⟨p, hpm, hpx⟩ := hx
    obtain ⟨q, hq⟩ : ∃ q : Polynomial K, q = p.map (algebraMap R₂ K) := ⟨_, rfl⟩
    have hqm : q.Monic := by rw [hq]; exact hpm.map _
    have hqx : Polynomial.eval₂ (algebraMap K L) x q = 0 := by
      rw [hq, Polynomial.eval₂_map]; exact hpx
    have hcoef : ∀ i, ∃ k : ℕ, s ^ k * q.coeff i ∈ R₁ := by
      intro i
      rw [hq, Polynomial.coeff_map]
      exact hR _ (p.coeff i).2
    choose k hk using hcoef
    obtain ⟨κ, hκ⟩ : ∃ κ : ℕ, κ = ∑ i ∈ Finset.range q.natDegree, k i := ⟨_, rfl⟩
    have hQm : (q.scaleRoots (s ^ κ)).Monic := (Polynomial.monic_scaleRoots_iff (s ^ κ)).mpr hqm
    have hQc : ∀ i, (q.scaleRoots (s ^ κ)).coeff i ∈ R₁ := by
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i q.natDegree with h | h | h
      · have hki : k i ≤ κ := by
          rw [hκ]
          exact Finset.single_le_sum (f := k) (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr h)
        have hle : k i ≤ κ * (q.natDegree - i) :=
          le_trans hki (Nat.le_mul_of_pos_right κ (by omega))
        obtain ⟨e', he'⟩ : ∃ e', κ * (q.natDegree - i) = e' + k i :=
          ⟨_, (Nat.sub_add_cancel hle).symm⟩
        have e : q.coeff i * (s ^ κ) ^ (q.natDegree - i) =
            s ^ e' * (s ^ k i * q.coeff i) := by
          rw [← pow_mul, he', pow_add]
          ring
        rw [e]
        exact R₁.mul_mem (R₁.pow_mem hs _) (hk i)
      · rw [h, hqm.coeff_natDegree, Nat.sub_self, pow_zero, one_mul]
        exact R₁.one_mem
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul]
        exact R₁.zero_mem
    have hQl : q.scaleRoots (s ^ κ) ∈ Polynomial.lifts (algebraMap R₁ K) :=
      (Polynomial.lifts_iff_coeff_lifts _).mpr (fun n => ⟨⟨_, hQc n⟩, rfl⟩)
    obtain ⟨Q', hQ'map, -, hQ'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hQl hQm
    refine ⟨κ, Q', hQ'm, ?_⟩
    have hcomp : algebraMap R₁ L = (algebraMap K L).comp (algebraMap R₁ K) := rfl
    rw [hcomp, ← Polynomial.eval₂_map, hQ'map, ← map_pow, Polynomial.scaleRoots_eval₂_mul, hqx,
      mul_zero]

  have splitL : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (Bu Bv : Subring L)
      (u v b : L) (r : ℕ) (g : Fin r → L) (p : Fin r → Polynomial A) (M : ℕ), u * v = 1 →
      u ∈ Bu → b ∈ Bu → (∀ a : A, algebraMap A L a ∈ Bu) → (∀ a : A, algebraMap A L a ∈ Bv) →
      (∀ j, g j ∈ Bu) → (∀ (j : Fin r) (a : ℕ), b * v ^ a * g j ∈ Bv) →
      ∃ u₁ ∈ Bu, ∃ u₂ ∈ Bv, b * (v ^ M * ∑ j, Polynomial.aeval u (p j) * g j) = u₁ + u₂ := by
    intro A L _ _ _ Bu Bv u v b r g p M huv hu hb hAu hAv hg hcol
    let P : L → Prop := fun x => ∃ u₁ ∈ Bu, ∃ u₂ ∈ Bv, x = u₁ + u₂
    have P0 : P 0 := ⟨0, Bu.zero_mem, 0, Bv.zero_mem, by rw [add_zero]⟩
    have Padd : ∀ x y, P x → P y → P (x + y) := by
      rintro x y ⟨a1, ha1, a2, ha2, rfl⟩ ⟨b1, hb1, b2, hb2, rfl⟩
      exact ⟨a1 + b1, Bu.add_mem ha1 hb1, a2 + b2, Bv.add_mem ha2 hb2, by ring⟩
    have key : ∀ (j : Fin r) (i : ℕ),
        P (algebraMap A L ((p j).coeff i) * (b * v ^ M * u ^ i * g j)) := by
      intro j i
      rcases le_or_gt M i with h | h
      · obtain ⟨d, rfl⟩ : ∃ d, i = M + d := ⟨i - M, by omega⟩
        have e : v ^ M * u ^ (M + d) = u ^ d := by
          rw [pow_add, ← mul_assoc, ← mul_pow, mul_comm v u, huv, one_pow, one_mul]
        refine ⟨algebraMap A L ((p j).coeff (M + d)) * (b * u ^ d * g j), ?_, 0, Bv.zero_mem, ?_⟩
        · exact Bu.mul_mem (hAu _) (Bu.mul_mem (Bu.mul_mem hb (Bu.pow_mem hu _)) (hg j))
        · rw [add_zero, ← e]; ring
      · obtain ⟨d, rfl⟩ : ∃ d, M = d + i := ⟨M - i, by omega⟩
        have e : v ^ (d + i) * u ^ i = v ^ d := by
          rw [pow_add, mul_assoc, ← mul_pow, mul_comm v u, huv, one_pow, mul_one]
        refine ⟨0, Bu.zero_mem, algebraMap A L ((p j).coeff i) * (b * v ^ d * g j),
          Bv.mul_mem (hAv _) (hcol j d), ?_⟩
        rw [zero_add, ← e]; ring
    have hexp : b * (v ^ M * ∑ j, Polynomial.aeval u (p j) * g j) =
        ∑ j, ∑ i ∈ Finset.range ((p j).natDegree + 1),
          algebraMap A L ((p j).coeff i) * (b * v ^ M * u ^ i * g j) := by
      rw [Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Polynomial.aeval_eq_sum_range, Finset.sum_mul, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def]; ring
    rw [hexp]
    exact Finset.sum_induction _ P Padd P0 (fun j _ =>
      Finset.sum_induction _ P Padd P0 (fun i _ => key j i))

  have cechL : ∀ (A K L : Type u) [CommRing A] [Field K] [Algebra A K] [Field L] [Algebra K L]
      [Algebra A L] [IsScalarTower A K L]
      (RI RC : Subalgebra A K) (x y δ : K) (c : A), x * y = 1 → x ∈ RI → δ ∈ RI →
      algebraMap A K c = x * δ → (∀ r ∈ RC, ∃ k : ℕ, y ^ k * r ∈ Algebra.adjoin A {y}) →
      Module.Finite ↥(Algebra.adjoin A {y}) ↥(integralClosure ↥(Algebra.adjoin A {y}) L) →
      ∃ n : ℕ, ∀ z : L, IsIntegral ↥RC z → ∃ zo zI : L, IsIntegral ↥(Algebra.adjoin A {y}) zo ∧
        IsIntegral ↥RI zI ∧ algebraMap K L (algebraMap A K c) ^ n * z = zo + zI := by
    intro A K L _ _ _ _ _ _ _ RI RC x y δ c hxy hxRI hδRI hc hRC hfin
    have hyR : y ∈ Algebra.adjoin A {y} := Algebra.subset_adjoin (Set.mem_singleton y)
    have hUV : ∀ r ∈ Algebra.adjoin A {y}, ∃ k : ℕ, x ^ k * r ∈ RI :=
      closL A K RI x {y} hxRI (fun r hr => ⟨1, by
        rw [Set.mem_singleton_iff.mp hr, pow_one, hxy]; exact RI.one_mem⟩)
    have s5 : ∀ g : L, IsIntegral (Algebra.adjoin A {y}) g →
        ∃ n : ℕ, IsIntegral RI (algebraMap K L x ^ n * g) :=
      fun g hg => scaleL A K L RI (Algebra.adjoin A {y}) x hxRI hUV g hg
    have s6 : ∀ z : L, IsIntegral RC z →
        ∃ M : ℕ, IsIntegral (Algebra.adjoin A {y}) (algebraMap K L y ^ M * z) :=
      fun z hz => scaleL A K L (Algebra.adjoin A {y}) RC y hyR hRC z hz
    haveI := hfin
    obtain ⟨r, g, hg⟩ := Module.Finite.exists_fin (R := Algebra.adjoin A {y})
      (M := integralClosure (Algebra.adjoin A {y}) L)
    choose n hn using fun j => s5 (g j : L) (g j).2
    obtain ⟨N, hN⟩ : ∃ N : ℕ, N = ∑ j, n j := ⟨_, rfl⟩
    have hintK : ∀ (R : Subalgebra A K) (x : K), x ∈ R → IsIntegral R (algebraMap K L x) :=
      fun R x hx => isIntegral_algebraMap (R := R) (A := L) (x := ⟨x, hx⟩)
    have hcolI : ∀ (j : Fin r) (a : ℕ), IsIntegral RI
        (algebraMap K L (algebraMap A K c) ^ N * algebraMap K L x ^ a * (g j : L)) := by
      intro j a
      have hnj : n j ≤ N := by
        rw [hN]
        exact Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
      obtain ⟨e, he⟩ : ∃ e, N = n j + e := ⟨N - n j, by omega⟩
      have eq : algebraMap K L (algebraMap A K c) ^ N * algebraMap K L x ^ a * (g j : L) =
          algebraMap K L δ ^ N * algebraMap K L x ^ (a + e) *
            (algebraMap K L x ^ n j * (g j : L)) := by
        rw [hc, map_mul, mul_pow, he]; ring
      rw [eq]
      exact ((hintK _ δ hδRI).pow _).mul ((hintK _ x hxRI).pow _) |>.mul (hn j)
    have hAu : ∀ (R : Subalgebra A K) (a : A),
        algebraMap A L a ∈ (integralClosure R L).toSubring := by
      intro R a
      rw [IsScalarTower.algebraMap_apply A K L a]
      exact hintK R _ (R.algebraMap_mem a)
    have hb : algebraMap K L (algebraMap A K c) ^ N ∈
        (integralClosure (Algebra.adjoin A {y}) L).toSubring :=
      Subring.pow_mem _ (hintK _ _ ((Algebra.adjoin A {y}).algebraMap_mem _)) N
    refine ⟨N, fun z hz => ?_⟩
    obtain ⟨M, hM⟩ := s6 z hz
    have hw : (⟨algebraMap K L y ^ M * z, hM⟩ : integralClosure (Algebra.adjoin A {y}) L) ∈
        Submodule.span (Algebra.adjoin A {y}) (Set.range g) := by
      rw [hg]; exact Submodule.mem_top
    obtain ⟨ρ, hρ⟩ := (Submodule.mem_span_range_iff_exists_fun (Algebra.adjoin A {y})).mp hw
    have hp : ∀ j, ∃ q : Polynomial A, Polynomial.aeval y q = (ρ j : K) := by
      intro j
      have hmem : (ρ j : K) ∈ (Polynomial.aeval (R := A) y).range := by
        rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact (ρ j).2
      exact Set.mem_range.mp hmem
    choose p hpp using hp
    have hzexp : algebraMap K L y ^ M * z =
        ∑ j, Polynomial.aeval (algebraMap K L y) (p j) * (g j : L) := by
      have h1 := congrArg (fun x : integralClosure (Algebra.adjoin A {y}) L => (x : L)) hρ
      simp only at h1
      rw [← h1]
      push_cast
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Polynomial.aeval_algebraMap_apply, hpp j, Algebra.smul_def]
      rfl
    have hz' : z = algebraMap K L x ^ M * (algebraMap K L y ^ M * z) := by
      rw [← mul_assoc, ← mul_pow, ← map_mul, hxy, map_one, one_pow, one_mul]
    have huv : algebraMap K L y * algebraMap K L x = 1 := by
      rw [← map_mul, mul_comm, hxy, map_one]
    obtain ⟨u₁, hu₁, u₂, hu₂, he⟩ := splitL A L
      (integralClosure (Algebra.adjoin A {y}) L).toSubring
      (integralClosure RI L).toSubring (algebraMap K L y) (algebraMap K L x)
      (algebraMap K L (algebraMap A K c) ^ N) r (fun j => (g j : L)) p M huv (hintK _ y hyR) hb
      (hAu _) (hAu _) (fun j => (g j).2) hcolI
    refine ⟨u₁, u₂, hu₁, hu₂, ?_⟩
    rw [hz', hzexp]
    exact he

  have sectL : ∀ (A K L : Type u) [CommRing A] [Field K] [Algebra A K] [Field L] [Algebra K L]
      (R₀ Ro RI : Subalgebra A K) (x y : K), x * y = 1 →
      Ro ≤ Algebra.adjoin A (insert y (R₀ : Set K)) →
      RI ≤ Algebra.adjoin A (insert x (R₀ : Set K)) →
      ∀ z : L, IsIntegral ↥Ro z → IsIntegral ↥RI z → IsIntegral ↥R₀ z := by
    intro A K L _ _ _ _ _ R₀ Ro RI x y hxy hRo hRI z hzo hzI
    have hcase : ∀ (T : Subalgebra A K) (t : K), T ≤ Algebra.adjoin A (insert t (R₀ : Set K)) →
        ∀ V : ValuationSubring L, Set.range (algebraMap R₀ L) ⊆ (V.toSubring : Set L) →
        algebraMap K L t ∈ V → IsIntegral T z → z ∈ V := by
      intro T t hT V hsV ht hz
      have hmem : ∀ r ∈ Algebra.adjoin A (insert t (R₀ : Set K)), algebraMap K L r ∈ V := by
        intro r hr
        induction hr using Algebra.adjoin_induction with
        | mem w hw =>
          rcases hw with rfl | hw
          · exact ht
          · exact hsV ⟨⟨w, hw⟩, rfl⟩
        | algebraMap a => exact hsV ⟨algebraMap A R₀ a, rfl⟩
        | add w w' _ _ hw hw' => rw [map_add]; exact add_mem hw hw'
        | mul w w' _ _ hw hw' => rw [map_mul]; exact mul_mem hw hw'
      let φ : T →+* V := RingHom.codRestrict ((algebraMap K L).comp T.val.toRingHom) V
        (fun r => hmem r (hT r.2))
      have hφ : (algebraMap V L).comp φ = (RingHom.id L).comp (algebraMap T L) := by
        ext r; rfl
      have hzV := IsIntegral.map_of_comp_eq φ (RingHom.id L) hφ hz
      obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hzV
      rw [RingHom.id_apply] at hw
      rw [← hw]; exact w.2
    have hxyL : algebraMap K L x * algebraMap K L y = 1 := by rw [← map_mul, hxy, map_one]
    have hz : z ∈ (integralClosure (Subring.closure (Set.range (algebraMap R₀ L))) L).toSubring := by
      rw [← iInf_valuationSubring_superset]
      apply Subring.mem_iInf.mpr
      rintro ⟨V, hV⟩
      rcases V.mem_or_inv_mem (algebraMap K L y) with h | h
      · exact hcase Ro y hRo V hV h hzo
      · have hx : algebraMap K L x = (algebraMap K L y)⁻¹ := eq_inv_of_mul_eq_one_left hxyL
        exact hcase RI x hRI V hV (hx ▸ h) hzI
    have hz' : IsIntegral (Subring.closure (Set.range (algebraMap R₀ L))) z := hz
    obtain ⟨p, hpm, hp⟩ := hz'
    have hle : Subring.closure (Set.range (algebraMap R₀ L)) ≤ (algebraMap R₀ L).range :=
      Subring.closure_le.mpr (by rintro _ ⟨r, rfl⟩; exact RingHom.mem_range.mpr ⟨r, rfl⟩)
    have hlift : p.map (Subring.closure (Set.range (algebraMap R₀ L))).subtype ∈
        Polynomial.lifts (algebraMap R₀ L) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      exact RingHom.mem_range.mp (hle (p.coeff n).2)
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift (hpm.map _)
    refine ⟨q, hqm, ?_⟩
    rw [← Polynomial.eval_map, hqmap, Polynomial.eval_map]
    exact hp

  have keyT : ∀ (C0 Co CI CC : Type u) [CommRing C0] [CommRing Co] [CommRing CI] [CommRing CC]
      (ιo : C0 →+* Co) (ιI : C0 →+* CI) (ιoC : Co →+* CC) (ιIC : CI →+* CC) (ιC : C0 →+* CC),
      (∀ x, ιC x = ιoC (ιo x)) → (∀ x, ιC x = ιIC (ιI x)) →
      ∀ (y₀ : Ideal C0), y₀.IsMaximal → ∀ (ε : C0), ε - 1 ∈ y₀ →
      ∀ (πo : Co) (πI : CI) (α : CC),
      (∀ f ∈ (y₀.map ιo).radical, ιo ε * f ∈ (Ideal.span {πo}).radical) →
      (∀ f ∈ (y₀.map ιI).radical, ιI ε * f ∈ (Ideal.span {πI}).radical) →
      (∀ f ∈ (y₀.map ιC).radical, ιC ε * f ∈ (Ideal.span {α}).radical) →
      πo ∈ y₀.map ιo → πI ∈ y₀.map ιI →
      ∀ (wo : CC), ιoC πo = α * wo → ∀ (k₁ : ℕ) (wI : CC), k₁ ≠ 0 → ιIC πI ^ k₁ = α * wI →
      ∀ (N : ℕ), N ≠ 0 → (∀ z : CC, ∃ (d_o : Co) (d_I : CI), d_o ∈ y₀.map ιo ∧
        d_I ∈ y₀.map ιI ∧ α ^ N * z = ιoC d_o + ιIC d_I) →
      (∀ (p : Co) (q : CI), ιoC p = ιIC q → ∃ g : C0, ιo g = p ∧ ιI g = q) →
      ∀ (eo : Co) (eI : CI), eo * eo - eo ∈ (y₀.map ιo).radical →
      eI * eI - eI ∈ (y₀.map ιI).radical →
      ιoC eo - ιIC eI ∈ (y₀.map ιC).radical →
      (eo ∈ (y₀.map ιo).radical ∧ eI ∈ (y₀.map ιI).radical) ∨
      (eo - 1 ∈ (y₀.map ιo).radical ∧ eI - 1 ∈ (y₀.map ιI).radical) := by
    intro C0 Co CI CC _ _ _ _ ιo ιI ιoC ιIC ιC hCo hCI y₀ hy ε hε πo πI α hGo hGI hGC hπo hπI
      wo hwo k₁ wI hk₁ hwI N hN hsplit hsec eo eI ho hI hC
    have hmapJ : ∀ {D : Type u} [CommRing D] (ι : C0 →+* D) {c : C0}, c ∈ y₀ →
        ι c ∈ (y₀.map ι).radical :=
      fun ι _ hc => Ideal.le_radical (Ideal.mem_map_of_mem ι hc)
    have hback : ∀ {D : Type u} [CommRing D] (ι : C0 →+* D), (y₀.map ι).radical ≠ ⊤ →
        ∀ c : C0, ι c ∈ (y₀.map ι).radical → c ∈ y₀ := by
      intro D _ ι hne c hc
      have hle : y₀ ≤ (y₀.map ι).radical.comap ι := fun x hx => hmapJ ι hx
      have hne' : (y₀.map ι).radical.comap ι ≠ ⊤ := by
        intro h
        apply hne
        rw [Ideal.eq_top_iff_one]
        have h1 : (1 : C0) ∈ (y₀.map ι).radical.comap ι := by rw [h]; exact Submodule.mem_top
        rwa [Ideal.mem_comap, map_one] at h1
      rw [hy.eq_of_le hne' hle]
      exact hc
    have hεo : ιo ε - 1 ∈ (y₀.map ιo).radical := by
      rw [← map_one ιo, ← map_sub]; exact hmapJ ιo hε
    have hεI : ιI ε - 1 ∈ (y₀.map ιI).radical := by
      rw [← map_one ιI, ← map_sub]; exact hmapJ ιI hε
    have hfo : ιo ε * (eo * eo - eo) + (ιo ε - 1) * eo ∈ (y₀.map ιo).radical :=
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ ho) (Ideal.mul_mem_right _ _ hεo)
    have hfI : ιI ε * (eI * eI - eI) + (ιI ε - 1) * eI ∈ (y₀.map ιI).radical :=
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ hI) (Ideal.mul_mem_right _ _ hεI)
    have exo : (ιo ε * eo) * (ιo ε * eo) - ιo ε * eo =
        ιo ε * (ιo ε * (eo * eo - eo) + (ιo ε - 1) * eo) := by ring
    have exI : (ιI ε * eI) * (ιI ε * eI) - ιI ε * eI =
        ιI ε * (ιI ε * (eI * eI - eI) + (ιI ε - 1) * eI) := by ring
    have htxo : (ιo ε * eo) * (ιo ε * eo) - ιo ε * eo ∈ (Ideal.span {πo}).radical := by
      rw [exo]; exact hGo _ hfo
    have htxI : (ιI ε * eI) * (ιI ε * eI) - ιI ε * eI ∈ (Ideal.span {πI}).radical := by
      rw [exI]; exact hGI _ hfI
    have htxoJ : (ιo ε * eo) * (ιo ε * eo) - ιo ε * eo ∈ (y₀.map ιo).radical := by
      rw [exo]; exact Ideal.mul_mem_left _ _ hfo
    have htxIJ : (ιI ε * eI) * (ιI ε * eI) - ιI ε * eI ∈ (y₀.map ιI).radical := by
      rw [exI]; exact Ideal.mul_mem_left _ _ hfI
    obtain ⟨p, hp1, hp2⟩ := s4L Co πo (ιo ε * eo) htxo N
    obtain ⟨q, hq1, hq2⟩ := s4L CI πI (ιI ε * eI) htxI (k₁ * N)
    have hP : ιoC p * ιoC p - ιoC p ∈ Ideal.span {α ^ N} := by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hp1
      refine Ideal.mem_span_singleton'.mpr ⟨ιoC c * wo ^ N, ?_⟩
      rw [← map_mul, ← map_sub, ← hc, map_mul, map_pow, hwo]; ring
    have hQ : ιIC q * ιIC q - ιIC q ∈ Ideal.span {α ^ N} := by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hq1
      refine Ideal.mem_span_singleton'.mpr ⟨ιIC c * wI ^ N, ?_⟩
      rw [← map_mul, ← map_sub, ← hc, map_mul, map_pow, pow_mul, hwI]; ring
    have h1 : ιoC (p - ιo ε * eo) ∈ (Ideal.span {α}).radical := by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hp2
      obtain ⟨m, hm⟩ := htxo
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hm
      have e1 : (p - ιo ε * eo) ^ m = (c ^ m * d) * πo := by rw [← hc, mul_pow, ← hd]; ring
      refine ⟨m, ?_⟩
      rw [← map_pow, e1, map_mul, hwo]
      exact Ideal.mem_span_singleton'.mpr ⟨ιoC (c ^ m * d) * wo, by ring⟩
    have h3 : ιIC (q - ιI ε * eI) ∈ (Ideal.span {α}).radical := by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hq2
      obtain ⟨m, hm⟩ := htxI
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hm
      have e1 : (q - ιI ε * eI) ^ (m * k₁) = (c ^ m * d) ^ k₁ * πI ^ k₁ := by
        rw [← hc, pow_mul, mul_pow, ← hd, ← mul_pow]; ring
      refine ⟨m * k₁, ?_⟩
      rw [← map_pow, e1, map_mul, map_pow ιIC πI, hwI]
      exact Ideal.mem_span_singleton'.mpr ⟨ιIC ((c ^ m * d) ^ k₁) * wI, by ring⟩
    have h2 := hGC _ hC
    have hdec : ιoC p - ιIC q = ιoC (p - ιo ε * eo) + ιC ε * (ιoC eo - ιIC eI) -
        ιIC (q - ιI ε * eI) := by
      rw [map_sub, map_sub, map_mul, map_mul, ← hCo, ← hCI]; ring
    have hPQ : ιoC p - ιIC q ∈ (Ideal.span {α}).radical := by
      rw [hdec]; exact Ideal.sub_mem _ (Ideal.add_mem _ h1 h2) h3
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp (s5L CC α (ιoC p) (ιIC q) N hP hQ hPQ)
