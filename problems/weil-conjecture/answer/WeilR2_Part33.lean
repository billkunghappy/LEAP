  have hηh : η * algebraMap A K h = 1 := by rw [← hη]; exact inv_mul_cancel₀ hhK
  have hηE : η ∈ Algebra.adjoin A {s, η} := Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl)
  have hψw : ∀ w : ↥W, ψ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C b}) (MvPolynomial.C w)) = algebraMap A _ (algebraMap ↥W A w) :=
    fun w => RingHom.congr_fun hψC w

  have hs3 : ∀ σ : K, ∀ x ∈ Algebra.adjoin A {σ, η}, ∃ n : ℕ,
      x * algebraMap A K h ^ n ∈ Algebra.adjoin A {σ} := by
    intro σ x hx
    have hhA : algebraMap A K h ∈ Algebra.adjoin A {σ} := Subalgebra.algebraMap_mem _ h
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · exact ⟨0, by rw [pow_zero, mul_one]; exact Algebra.subset_adjoin (Set.mem_singleton _)⟩
      · rw [Set.mem_singleton_iff.mp hx]
        exact ⟨1, by rw [pow_one, hηh]; exact Subalgebra.one_mem _⟩
    | algebraMap r =>
      exact ⟨0, by rw [pow_zero, mul_one]; exact Subalgebra.algebraMap_mem _ r⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨n₁, h₁⟩ := ihx
      obtain ⟨n₂, h₂⟩ := ihy
      refine ⟨n₁ + n₂, ?_⟩
      have e : (x + y) * algebraMap A K h ^ (n₁ + n₂) =
