  obtain ⟨ux, hux⟩ : ∃ ux : L, ux = Polynomial.eval₂ wL xL (Polynomial.X ^ d + T) := ⟨_, rfl⟩
  have hũx : ux = xL ^ d + ∑ j ∈ Finset.range d, wL (cε j) * xL ^ j := by
