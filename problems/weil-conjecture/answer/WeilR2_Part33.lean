      exact Ideal.map_mono hm𝔭
    · exact Ideal.mem_map_of_mem _ ht𝔭
    · rw [h𝔭eq, Ideal.map_sup, Ideal.map_span, Set.image_singleton,
        show algebraMap ↥W B = (algebraMap A B).comp (algebraMap ↥W A) from rfl, Ideal.map_map]
    · refine ⟨1, fun h1 => hpB.ne_top ((Ideal.eq_top_iff_one _).mpr h1),
        (algebraMap B (Localization.Away (1 : B))).comp φ, ?_, ?_, ?_⟩
      · rw [RingHom.comp_assoc, hφC]
      · rw [RingHom.comp_apply, hφX]
      · exact RingHom.Etale.stableUnderComposition φ (algebraMap B _) hφet
