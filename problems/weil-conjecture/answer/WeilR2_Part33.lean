          (y * algebraMap A K h ^ n₂) * algebraMap A K h ^ n₁ := by ring
      rw [e]
      exact add_mem (mul_mem h₁ (pow_mem hhA _)) (mul_mem h₂ (pow_mem hhA _))
    | mul x y _ _ ihx ihy =>
      obtain ⟨n₁, h₁⟩ := ihx
      obtain ⟨n₂, h₂⟩ := ihy
      refine ⟨n₁ + n₂, ?_⟩
      have e : (x * y) * algebraMap A K h ^ (n₁ + n₂) =
          (x * algebraMap A K h ^ n₁) * (y * algebraMap A K h ^ n₂) := by ring
