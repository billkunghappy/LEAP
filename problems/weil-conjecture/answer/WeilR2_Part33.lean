theorem wcpa_dj_llsm_lc_chart_frac : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g →
    ∀ (ι : ↥(wcIsicgC1 W A K L u (a' * q')) →+* ↥(wcIsicgB W A K L u a')),
      (∀ x, ((ι x : ↥(wcIsicgB W A K L u a')) : L) = (x : L)) →
    ∀ (Q : Ideal ↥(wcIsicgC1 W A K L u (a' * q'))) [Q.IsPrime],
      Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
        wcLlsASbN W A K u (a' * q') →
      ∃ (_ : IsDomain (Localization.AtPrime Q)), IsIntegrallyClosed (Localization.AtPrime Q) ∧
      ∃ (lO : Localization.AtPrime Q →+* L) (lD : Localization (Q.primeCompl.map ι) →+* L),
        Function.Injective lO ∧ Function.Injective lD ∧ lD.comp (wcLcTheta ι Q) = lO ∧
        (∀ z : L, ∃ a b : Localization.AtPrime Q, b ≠ 0 ∧ z * lO b = lO a) ∧
        (∀ (z : L) (p : Polynomial (Localization (Q.primeCompl.map ι))), p.Monic →
          p.eval₂ lD z = 0 → ∃ d, lD d = z) ∧
        ∃ x y : Localization (Q.primeCompl.map ι),
          x * wcLcTheta ι Q (wcIsicgSig W A K L u (a' * q') Q a') =
            wcLcTheta ι Q (wcIsicgU W A K L u (a' * q') Q) ∧
          y * wcLcTheta ι Q (wcIsicgU W A K L u (a' * q') Q) =
            wcLcTheta ι Q (wcIsicgSig W A K L u (a' * q') Q a') ∧
          ∀ z : Localization (Q.primeCompl.map ι), ∃ p : Polynomial (Localization (Q.primeCompl.map ι)),
            p.Monic ∧ (∀ i, p.coeff i ∈ Subring.closure (Set.range (wcLcTheta ι Q) ∪ {x, y})) ∧
            p.eval z = 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0 hdvd
    ι hι Q _ hQc
  classical

  have s2 : ∀ (C B L : Type u) [CommRing C] [CommRing B] [Field L] (jC : C →+* L) (jB : B →+* L)
      (ι : C →+* B), Function.Injective jC → Function.Injective jB → (∀ x, jB (ι x) = jC x) →
      ∀ (Q : Ideal C) [Q.IsPrime],
      ∃ (lO : Localization.AtPrime Q →+* L) (lD : Localization (Q.primeCompl.map ι) →+* L),
        Function.Injective lO ∧ Function.Injective lD ∧ lD.comp (wcLcTheta ι Q) = lO ∧
        (∀ x, lO (algebraMap C (Localization.AtPrime Q) x) = jC x) ∧
        (∀ b, lD (algebraMap B (Localization (Q.primeCompl.map ι)) b) = jB b) ∧
        (∀ m ∈ Q.primeCompl.map ι, jB m ≠ 0) := by
    intro C B L _ _ _ jC jB ι hjC hjB hι Q _
    have hC0 : ∀ y : Q.primeCompl, jC y ≠ 0 := by
      intro y h
      apply y.2
      rw [hjC (h.trans (map_zero jC).symm)]
      exact Q.zero_mem
    have hD0 : ∀ m ∈ Q.primeCompl.map ι, jB m ≠ 0 := by
      intro m hm
      obtain ⟨s, hs, hsm⟩ := Submonoid.mem_map.mp hm
      rw [← hsm, hι]
      exact hC0 ⟨s, hs⟩
    have hgO : ∀ y : Q.primeCompl, IsUnit (jC y) := fun y => isUnit_iff_ne_zero.mpr (hC0 y)
    have hgD : ∀ y : Q.primeCompl.map ι, IsUnit (jB y) :=
      fun y => isUnit_iff_ne_zero.mpr (hD0 y y.2)
    have hlO : ∀ x, (IsLocalization.lift hgO : Localization.AtPrime Q →+* L)
        (algebraMap C (Localization.AtPrime Q) x) = jC x := fun x => IsLocalization.lift_eq hgO x
    have hlD : ∀ b, (IsLocalization.lift hgD : Localization (Q.primeCompl.map ι) →+* L)
        (algebraMap B (Localization (Q.primeCompl.map ι)) b) = jB b :=
      fun b => IsLocalization.lift_eq hgD b
    refine ⟨IsLocalization.lift hgO, IsLocalization.lift hgD, ?_, ?_, ?_, hlO, hlD, hD0⟩
    · rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists Q.primeCompl _).mp h
        have h2 := congrArg jC hc
        rw [map_mul, map_mul] at h2
        exact mul_left_cancel₀ (hC0 c) h2
      · intro h
        rw [hjC h]
    · rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists (Q.primeCompl.map ι) _).mp h
        have h2 := congrArg jB hc
        rw [map_mul, map_mul] at h2
        exact mul_left_cancel₀ (hD0 c c.2) h2
      · intro h
        rw [hjB h]
    · apply IsLocalization.ringHom_ext Q.primeCompl
      ext x
      simp only [RingHom.comp_apply]
      rw [IsLocalization.map_eq, hlD, hlO, hι]

  have s3 : ∀ (B L : Type u) [CommRing B] [Field L] (jB : B →+* L) (M : Submonoid B)
      (D : Type u) [CommRing D] [Algebra B D] [IsLocalization M D] (lD : D →+* L),
      (∀ b, lD (algebraMap B D b) = jB b) → (∀ m ∈ M, jB m ≠ 0) →
      (∀ (w : L) (f : Polynomial B), f.Monic → f.eval₂ jB w = 0 → ∃ b, jB b = w) →
      ∀ (z : L) (p : Polynomial D), p.Monic → p.eval₂ lD z = 0 → ∃ d, lD d = z := by
    intro B L _ _ jB M D _ _ _ lD hlD hM hcl z p hp hz
    letI : Algebra D L := lD.toAlgebra
    letI : Algebra B L := jB.toAlgebra
    haveI : IsScalarTower B D L :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun b => (hlD b).symm)
    have hzi : IsIntegral D z := ⟨p, hp, hz⟩
    obtain ⟨⟨m, hm⟩, hint⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M z hzi
    obtain ⟨f, hf, hfz⟩ := hint
    have hsm : ((⟨m, hm⟩ : M) • z) = jB m * z := by
      rw [Submonoid.smul_def, Algebra.smul_def]
      rfl
    rw [hsm] at hfz
    obtain ⟨b, hb⟩ := hcl _ f hf hfz
    refine ⟨IsLocalization.mk' D b ⟨m, hm⟩, ?_⟩
    have h1 := congrArg lD (IsLocalization.mk'_spec D b ⟨m, hm⟩)
    rw [map_mul, hlD, hlD, hb] at h1
    exact mul_right_cancel₀ (hM m hm) (h1.trans (mul_comm _ _))

  have s4 : ∀ (R C B : Type u) [CommRing R] [CommRing C] [CommRing B] (jR : R →+* B),
      (∀ b : B, ∃ f : Polynomial R, f.Monic ∧ f.eval₂ jR b = 0) →
      ∀ (ι : C →+* B) (Q : Ideal C) [Q.IsPrime] (T : Subring (Localization (Q.primeCompl.map ι))),
      (∀ o, wcLcTheta ι Q o ∈ T) →
      (∀ r, algebraMap B (Localization (Q.primeCompl.map ι)) (jR r) ∈ T) →
      ∀ z : Localization (Q.primeCompl.map ι), ∃ p : Polynomial (Localization (Q.primeCompl.map ι)),
        p.Monic ∧ (∀ i, p.coeff i ∈ T) ∧ p.eval z = 0 := by
    intro R C B _ _ _ jR hint ι Q _ T hθ hR z
    obtain ⟨⟨b, ⟨m, hm⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Q.primeCompl.map ι) z
    obtain ⟨s, hs, hsm⟩ := Submonoid.mem_map.mp hm
    subst hsm
    dsimp only
    have ht : wcLcTheta ι Q (IsLocalization.mk' (Localization.AtPrime Q) (1 : C) ⟨s, hs⟩) =
        IsLocalization.mk' (Localization (Q.primeCompl.map ι)) (1 : B) ⟨ι s, hm⟩ := by
      rw [IsLocalization.map_mk', map_one]
    have hz : IsLocalization.mk' (Localization (Q.primeCompl.map ι)) b ⟨ι s, hm⟩ =
        wcLcTheta ι Q (IsLocalization.mk' (Localization.AtPrime Q) (1 : C) ⟨s, hs⟩) *
          algebraMap B (Localization (Q.primeCompl.map ι)) b := by
      rw [IsLocalization.mk'_eq_mul_mk'_one, ht, mul_comm]
    obtain ⟨f, hf, hfb⟩ := hint b
    refine ⟨(f.map ((algebraMap B (Localization (Q.primeCompl.map ι))).comp jR)).scaleRoots
      (wcLcTheta ι Q (IsLocalization.mk' (Localization.AtPrime Q) (1 : C) ⟨s, hs⟩)), ?_, ?_, ?_⟩
    · exact (Polynomial.monic_scaleRoots_iff _).mpr (hf.map _)
    · intro i
      rw [Polynomial.coeff_scaleRoots, Polynomial.coeff_map]
      exact T.mul_mem (hR _) (T.pow_mem (hθ _) _)
    · rw [hz]
      have e1 : (f.map ((algebraMap B (Localization (Q.primeCompl.map ι))).comp jR)).eval₂
          (RingHom.id _) (algebraMap B (Localization (Q.primeCompl.map ι)) b) = 0 := by
        rw [Polynomial.eval₂_map, RingHom.id_comp, ← Polynomial.hom_eval₂, hfb, map_zero]
      have e2 := Polynomial.scaleRoots_eval₂_mul
        (p := f.map ((algebraMap B (Localization (Q.primeCompl.map ι))).comp jR)) (RingHom.id _)
        (algebraMap B (Localization (Q.primeCompl.map ι)) b)
        (wcLcTheta ι Q (IsLocalization.mk' (Localization.AtPrime Q) (1 : C) ⟨s, hs⟩))
      rw [e1, mul_zero] at e2
      exact e2

  have hNZ : NoZeroSMulDivisors ↥W A := hPD.2.1
  have hWinj : ∀ w : ↥W, algebraMap A K (algebraMap ↥W A w) = 0 → w = 0 := by
    intro w hw
    have h4 : algebraMap ↥W A w = 0 := (IsFractionRing.injective A K) (hw.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h4
    exact (smul_eq_zero.mp h4).resolve_right one_ne_zero
  have ha'K : algebraMap A K (algebraMap ↥W A a') ≠ 0 := fun h => ha'0 (hWinj a' h)
  have huK : algebraMap A K u ≠ 0 := by
    intro h
    have hu0 : u = 0 := IsFractionRing.injective A K (h.trans (map_zero _).symm)
    have hPD' := hPD
    obtain ⟨-, -, -, -, -, -, hg0, huv, -⟩ := hPD'
    apply hg0
    apply hWinj
    rw [← huv, hu0, zero_mul, map_zero]
  haveI hC1ic : IsIntegrallyClosed ↥(wcIsicgC1 W A K L u (a' * q')) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI hC1fr : IsFractionRing ↥(wcIsicgC1 W A K L u (a' * q')) L :=
    integralClosure.isFractionRing_of_finite_extension K L
  haveI hOdom : IsDomain (Localization.AtPrime Q) :=
    IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors Q)
  have hOint : IsIntegrallyClosed (Localization.AtPrime Q) :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime Q) Q.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors Q)

  obtain ⟨lO, lD, hlOinj, hlDinj, hθl, hlOv, hlDv, hD0⟩ :=
    s2 ↥(wcIsicgC1 W A K L u (a' * q')) ↥(wcIsicgB W A K L u a') L
      (algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) L) (algebraMap ↥(wcIsicgB W A K L u a') L) ι
      (fun a b h => Subtype.ext h) (fun a b h => Subtype.ext h) (fun x => hι x) Q
  have hfrac : ∀ z : L, ∃ a b : Localization.AtPrime Q, b ≠ 0 ∧ z * lO b = lO a := by
    intro z
    obtain ⟨c, e, he, hz⟩ := IsFractionRing.div_surjective ↥(wcIsicgC1 W A K L u (a' * q')) z
    have he0 : algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) L e ≠ 0 := fun h =>
      nonZeroDivisors.ne_zero he ((IsFractionRing.injective _ L) (h.trans (map_zero _).symm))
    refine ⟨algebraMap _ _ c, algebraMap _ _ e, ?_, ?_⟩
    · intro h
      apply he0
      rw [← hlOv, h, map_zero]
    · rw [hlOv, hlOv, ← hz, div_mul_cancel₀ _ he0]

  have hint : ∀ (z : L) (p : Polynomial (Localization (Q.primeCompl.map ι))), p.Monic →
      p.eval₂ lD z = 0 → ∃ d, lD d = z :=
    s3 ↥(wcIsicgB W A K L u a') L (algebraMap ↥(wcIsicgB W A K L u a') L) (Q.primeCompl.map ι)
      (Localization (Q.primeCompl.map ι)) lD hlDv hD0 (by
        intro w f hf hfw
        have hw : IsIntegral ↥(wcIsicgB W A K L u a') w := ⟨f, hf, hfw⟩
        exact IsIntegrallyClosedIn.isIntegral_iff.mp hw)

  obtain ⟨cw, hcw⟩ : ∃ cw : ↥W → ↥(wcIsicgC1 W A K L u (a' * q')), ∀ w, cw w =
      algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w)) := ⟨_, fun _ => rfl⟩
  have hval : ∀ w, ((cw w : ↥(wcIsicgC1 W A K L u (a' * q'))) : L) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A w)) := by
    intro w; rw [hcw]; rfl
  have hσ : ∀ w, wcIsicgSig W A K L u (a' * q') Q w =
      algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) (Localization.AtPrime Q) (cw w) := by
    intro w; rw [hcw]; rfl
  obtain ⟨cu, hcu⟩ : ∃ cu : ↥(wcIsicgC1 W A K L u (a' * q')), cu =
      algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) u) := ⟨_, rfl⟩
  have hcuval : ((cu : ↥(wcIsicgC1 W A K L u (a' * q'))) : L) = algebraMap K L (algebraMap A K u) := by
    rw [hcu]; rfl
  have hU : wcIsicgU W A K L u (a' * q') Q =
      algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) (Localization.AtPrime Q) cu := by
    rw [hcu]
  have hθ : ∀ c : ↥(wcIsicgC1 W A K L u (a' * q')),
      wcLcTheta ι Q (algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) (Localization.AtPrime Q) c) =
        algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)) (ι c) :=
    fun c => IsLocalization.map_eq (Submonoid.le_comap_map Q.primeCompl) c
  have hxB : algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
      ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ * ι (cw a') = ι cu := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, hι, hι, hval, hcuval]
    show algebraMap K L (wcLlsIsiS1 W A K u a') * algebraMap K L (algebraMap A K (algebraMap ↥W A a')) =
      algebraMap K L (algebraMap A K u)
    rw [← map_mul]
    congr 1
    unfold wcLlsIsiS1
    exact div_mul_cancel₀ _ ha'K
  have hyB : algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
      ⟨wcLlsIsiS2 W A K u a', Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ *
        ι cu = ι (cw a') := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, hι, hι, hval, hcuval]
    show algebraMap K L (wcLlsIsiS2 W A K u a') * algebraMap K L (algebraMap A K u) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A a'))
    rw [← map_mul]
    congr 1
    unfold wcLlsIsiS2
    exact div_mul_cancel₀ _ huK

  have hAel : ∀ (a : A) (h : algebraMap A K a ∈ wcLlsIsiCR W A K u a'),
      algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a') ⟨algebraMap A K a, h⟩ =
        ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
          (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) a)) := by
    intro a h
    apply Subtype.ext
    rw [hι]
    rfl
  have hadd : ∀ (c c' : K) (hc : c ∈ wcLlsIsiCR W A K u a') (hc' : c' ∈ wcLlsIsiCR W A K u a')
      (h : c + c' ∈ wcLlsIsiCR W A K u a'),
      (⟨c + c', h⟩ : ↥(wcLlsIsiCR W A K u a')) = ⟨c, hc⟩ + ⟨c', hc'⟩ := fun _ _ _ _ _ => rfl
  have hmul : ∀ (c c' : K) (hc : c ∈ wcLlsIsiCR W A K u a') (hc' : c' ∈ wcLlsIsiCR W A K u a')
      (h : c * c' ∈ wcLlsIsiCR W A K u a'),
      (⟨c * c', h⟩ : ↥(wcLlsIsiCR W A K u a')) = ⟨c, hc⟩ * ⟨c', hc'⟩ := fun _ _ _ _ _ => rfl
  have hR : ∀ r : ↥(wcLlsIsiCR W A K u a'),
      algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))
        (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a') r) ∈
      Subring.closure (Set.range (wcLcTheta ι Q) ∪
        {algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))
          (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
            ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩),
         algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))
          (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
            ⟨wcLlsIsiS2 W A K u a',
              Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩)}) := by
    rintro ⟨c, hc⟩
    induction hc using Algebra.adjoin_induction with
    | mem c hc' =>
      rcases hc' with rfl | hc'
      · exact Subring.subset_closure (Or.inr (Set.mem_insert _ _))
      · rw [Set.mem_singleton_iff] at hc'
        subst hc'
        exact Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    | algebraMap a =>
      rw [hAel, ← hθ]
      exact Subring.subset_closure (Or.inl ⟨_, rfl⟩)
    | add c c' hc hc' ih ih' =>
      have e2 : ((algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))).comp
          (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a'))) (⟨c, hc⟩ + ⟨c', hc'⟩) =
          ((algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))).comp
            (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a'))) ⟨c, hc⟩ +
          ((algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))).comp
            (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a'))) ⟨c', hc'⟩ :=
        ((algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))).comp
          (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a'))).map_add' _ _
      rw [hadd c c' hc hc']
      show ((algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))).comp
          (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a'))) (⟨c, hc⟩ + ⟨c', hc'⟩) ∈ _
      rw [e2]
      exact Subring.add_mem _ ih ih'
    | mul c c' hc hc' ih ih' =>
      rw [hmul c c' hc hc', map_mul (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')),
        map_mul (algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)))]
      exact Subring.mul_mem _ ih ih'
  have hintB : ∀ b : ↥(wcIsicgB W A K L u a'), ∃ f : Polynomial ↥(wcLlsIsiCR W A K u a'),
      f.Monic ∧ f.eval₂ (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')) b = 0 :=
    fun b => Algebra.IsIntegral.isIntegral b
  refine ⟨hOdom, hOint, lO, lD, hlOinj, hlDinj, hθl, hfrac, hint,
    algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))
      (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
        ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩),
    algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))
      (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
        ⟨wcLlsIsiS2 W A K u a',
          Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩), ?_, ?_, ?_⟩
  · rw [hσ, hU, hθ, hθ, ← map_mul (algebraMap ↥(wcIsicgB W A K L u a')
      (Localization (Q.primeCompl.map ι))), hxB]
  · rw [hσ, hU, hθ, hθ, ← map_mul (algebraMap ↥(wcIsicgB W A K L u a')
      (Localization (Q.primeCompl.map ι))), hyB]
  · exact s4 ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgC1 W A K L u (a' * q')) ↥(wcIsicgB W A K L u a')
      (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')) hintB ι Q _
      (fun o => Subring.subset_closure (Or.inl ⟨o, rfl⟩)) hR

theorem wcpa_dj_llsm_lc_chart_fibre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g →
    ∀ (ι : ↥(wcIsicgC1 W A K L u (a' * q')) →+* ↥(wcIsicgB W A K L u a')),
      (∀ x, ((ι x : ↥(wcIsicgB W A K L u a')) : L) = (x : L)) →
    ∀ (Q : Ideal ↥(wcIsicgC1 W A K L u (a' * q'))) [Q.IsPrime],
      Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
        wcLlsASbN W A K u (a' * q') →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        wcIsicgSig W A K L u (a' * q') Q w ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q)) ∧
      Function.Injective (wcIsicgSig W A K L u (a' * q') Q) ∧
      (∀ 𝔓 : Ideal (Localization (Q.primeCompl.map ι)), 𝔓.IsPrime →
        ((IsLocalRing.maximalIdeal ↥W).map (wcIsicgSig W A K L u (a' * q') Q)).map
          (wcLcTheta ι Q) ≤ 𝔓 →
        (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).map (wcLcTheta ι Q) ≤ 𝔓) ∧
      (wcIsicgIB W A K L u a').map
          (algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι))) =
        ((IsLocalRing.maximalIdeal ↥W).map (wcIsicgSig W A K L u (a' * q') Q)).map
          (wcLcTheta ι Q) ∧
      ∀ (w : ↥W) (c : ↥(wcIsicgB W A K L u a')),
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
        algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)) c =
          wcLcTheta ι Q (wcIsicgSig W A K L u (a' * q') Q w) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0 hdvd
    ι hι Q _ hQc
  classical

  have s1 : ∀ (R C B : Type u) [CommRing R] [CommRing C] [CommRing B] [Algebra R C]
      [Algebra.IsIntegral R C] (ι : C →+* B) (Q : Ideal C) [Q.IsPrime]
      (𝔓 : Ideal (Localization (Q.primeCompl.map ι))), 𝔓.IsPrime →
      Q.comap (algebraMap R C) ≤ ((𝔓.comap (algebraMap B (Localization (Q.primeCompl.map ι)))).comap
        ι).comap (algebraMap R C) →
      (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).map (wcLcTheta ι Q) ≤ 𝔓 := by
    intro R C B _ _ _ _ _ ι Q _ 𝔓 h𝔓 hle
    haveI := h𝔓
    have hle1 : (𝔓.comap (algebraMap B (Localization (Q.primeCompl.map ι)))).comap ι ≤ Q := by
      intro x hx
      by_contra hxQ
      have hu : IsUnit (algebraMap B (Localization (Q.primeCompl.map ι)) (ι x)) :=
        IsLocalization.map_units (Localization (Q.primeCompl.map ι))
          (⟨ι x, Submonoid.mem_map_of_mem ι (show x ∈ Q.primeCompl from hxQ)⟩ : Q.primeCompl.map ι)
      exact h𝔓.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hu)
    have hge : Q ≤ (𝔓.comap (algebraMap B (Localization (Q.primeCompl.map ι)))).comap ι := by
      intro x hxQ
      by_contra hx𝔮
      have hlt := Ideal.under_lt_under_of_integral_mem_sdiff (R := R) hle1 (x := x) ⟨hxQ, hx𝔮⟩
        (Algebra.IsIntegral.isIntegral x)
      exact lt_irrefl _ (lt_of_lt_of_le hlt hle)
    have hm : IsLocalRing.maximalIdeal (Localization.AtPrime Q) =
        Q.map (algebraMap C (Localization.AtPrime Q)) :=
      (Localization.AtPrime.map_eq_maximalIdeal).symm
    rw [hm, Ideal.map_map, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.comp_apply]
    have e : wcLcTheta ι Q (algebraMap C (Localization.AtPrime Q) x) =
        algebraMap B (Localization (Q.primeCompl.map ι)) (ι x) :=
      IsLocalization.map_eq (Submonoid.le_comap_map Q.primeCompl) x
    rw [e]
    exact hge hx

  have hNZ : NoZeroSMulDivisors ↥W A := hPD.2.1
  have hWinj : ∀ w : ↥W, algebraMap A K (algebraMap ↥W A w) = 0 → w = 0 := by
    intro w hw
    have h4 : algebraMap ↥W A w = 0 := (IsFractionRing.injective A K) (hw.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h4
    exact (smul_eq_zero.mp h4).resolve_right one_ne_zero
  have ha'K : algebraMap A K (algebraMap ↥W A a') ≠ 0 := fun h => ha'0 (hWinj a' h)
  obtain ⟨cw, hcw⟩ : ∃ cw : ↥W → ↥(wcIsicgC1 W A K L u (a' * q')), ∀ w, cw w =
      algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w)) := ⟨_, fun _ => rfl⟩
  have hval : ∀ w, ((cw w : ↥(wcIsicgC1 W A K L u (a' * q'))) : L) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A w)) := by
    intro w; rw [hcw]; rfl
  have hσ : ∀ w, wcIsicgSig W A K L u (a' * q') Q w =
      algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) (Localization.AtPrime Q) (cw w) := by
    intro w; rw [hcw]; rfl
  have hθ : ∀ c : ↥(wcIsicgC1 W A K L u (a' * q')),
      wcLcTheta ι Q (algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) (Localization.AtPrime Q) c) =
        algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)) (ι c) :=
    fun c => IsLocalization.map_eq (Submonoid.le_comap_map Q.primeCompl) c
  have hιc : ∀ (w : ↥W) (c : ↥(wcIsicgB W A K L u a')),
      (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) → ι (cw w) = c :=
    fun w c hc => Subtype.ext ((hι _).trans ((hval w).trans hc.symm))
  have h5 : ∀ (w : ↥W) (c : ↥(wcIsicgB W A K L u a')),
      (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
      algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)) c =
        wcLcTheta ι Q (wcIsicgSig W A K L u (a' * q') Q w) := by
    intro w c hc
    rw [← hιc w c hc, hσ, hθ]
  have hcwQ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, cw w ∈ Q := by
    intro w hw
    have hr : algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w) ∈
        wcLlsASbN W A K u (a' * q') := by
      unfold wcLlsASbN
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
    rw [← hQc, Ideal.mem_comap] at hr
    rw [hcw]
    exact hr
  refine ⟨?_, ?_, ?_, ?_, h5⟩
  ·
    intro w hw
    rw [hσ, ← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ (hcwQ w hw)
  ·
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [hσ] at hw
    have h1 : cw w = 0 :=
      (IsLocalization.injective (Localization.AtPrime Q) (Ideal.primeCompl_le_nonZeroDivisors Q))
        (hw.trans (map_zero _).symm)
    have h2 : algebraMap K L (algebraMap A K (algebraMap ↥W A w)) = 0 := by
      rw [← hval w, h1]; rfl
    exact hWinj w ((map_eq_zero _).mp h2)
  ·
    intro 𝔓 h𝔓 hle
    have hF : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)) (ι (cw w)) ∈ 𝔓 := by
      intro w hw
      rw [← hθ, ← hσ]
      exact hle (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw))
    apply s1 ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
      ↥(wcIsicgB W A K L u a') ι Q 𝔓 h𝔓
    rw [hQc]
    unfold wcLlsASbN
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with hx | hx
      · rw [hx, SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap]
        have e : ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
            (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) u)) =
            ι (cw a') * algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
              ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
          apply Subtype.ext
          rw [MulMemClass.coe_mul, hι, hι, hval]
          show algebraMap K L (algebraMap A K u) = algebraMap K L (algebraMap A K (algebraMap ↥W A a')) *
            algebraMap K L (wcLlsIsiS1 W A K u a')
          rw [← map_mul]
          congr 1
          unfold wcLlsIsiS1
          field_simp
        rw [e, map_mul (algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)))]
        exact Ideal.mul_mem_right _ _ (hF a' ha'm)
      · have hx' : (x : K) = algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u := by
          rw [Set.mem_singleton_iff.mp hx]
        rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap]
        have e : ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q')) x) =
            ι (cw q') * algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
              ⟨wcLlsIsiS2 W A K u a', Algebra.subset_adjoin
                (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
          apply Subtype.ext
          rw [MulMemClass.coe_mul, hι, hι, hval]
          show algebraMap K L (x : K) = algebraMap K L (algebraMap A K (algebraMap ↥W A q')) *
            algebraMap K L (wcLlsIsiS2 W A K u a')
          rw [hx', ← map_mul]
          congr 1
          unfold wcLlsIsiS2
          rw [map_mul, map_mul]
          ring
        rw [e, map_mul (algebraMap ↥(wcIsicgB W A K L u a') (Localization (Q.primeCompl.map ι)))]
        exact Ideal.mul_mem_right _ _ (hF q' hq'm)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply,
        ← hcw]
      exact hF w hw
  ·
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      show Ideal.span _ ≤ _
      rw [Ideal.span_le]
      rintro c ⟨w, hw, hc⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, h5 w c hc]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hw)
    · rw [Ideal.map_map, Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.comp_apply]
      have hc' : ((ι (cw w) : ↥(wcIsicgB W A K L u a')) : L) =
          algebraMap K L (algebraMap A K (algebraMap ↥W A w)) := (hι _).trans (hval w)
      have hc : ι (cw w) ∈ wcIsicgIB W A K L u a' := Ideal.subset_span ⟨w, hw, hc'⟩
      rw [← h5 w (ι (cw w)) hc']
      exact Ideal.mem_map_of_mem _ hc

theorem wcpa_dj_llsm_lc_residue_roots : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g →
    ∀ (ι : ↥(wcIsicgC1 W A K L u (a' * q')) →+* ↥(wcIsicgB W A K L u a')),
      (∀ x, ((ι x : ↥(wcIsicgB W A K L u a')) : L) = (x : L)) →
    ∀ (Q : Ideal ↥(wcIsicgC1 W A K L u (a' * q'))) [Q.IsPrime],
      Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
        wcLlsASbN W A K u (a' * q') →
      ∀ h : Polynomial (Localization.AtPrime Q), h.Monic → 0 < h.natDegree →
        ∃ a, h.eval a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD _ _ _ _ hdvd _ _ Q _ hQc
    hpol hmon hdeg
  classical

  have hroot : ∀ p : Polynomial ↥W, p.Monic → 0 < p.natDegree → ∃ w : ↥W, p.eval w = 0 := by
    intro p hm hd
    have hmap : (p.map (algebraMap W Ω)).Monic := hm.map _
    have hdg : (p.map (algebraMap W Ω)).natDegree = p.natDegree := hm.natDegree_map _
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root (p.map (algebraMap W Ω)) (by
      rw [Polynomial.degree_eq_natDegree hmap.ne_zero, hdg]; exact_mod_cast hd.ne')
    have hα' : (p.map (algebraMap W Ω)).eval α = 0 := hα
    have hint : IsIntegral W α := ⟨p, hm, by rwa [Polynomial.eval_map] at hα'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, ?_⟩
    apply IsFractionRing.injective W Ω
    rw [map_zero, ← hα', Polynomial.eval_map, ← hy, Polynomial.eval₂_at_apply]

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (τ : ↥W →+* S)
      (Q0 : Ideal S) [Q0.IsPrime], (∀ r : R, ∃ w : ↥W, algebraMap R S r - τ w ∈ Q0) →
      ∀ s : S, IsIntegral R s → ∃ w : ↥W, s - τ w ∈ Q0 := by
    intro R S _ _ _ τ Q0 _ happ s hs
    have peel : ∀ n : ℕ, ∀ q : Polynomial ↥W, q.Monic → q.natDegree = n →
        (q.map ((Ideal.Quotient.mk Q0).comp τ)).eval (Ideal.Quotient.mk Q0 s) = 0 →
        ∃ w, Ideal.Quotient.mk Q0 s = Ideal.Quotient.mk Q0 (τ w) := by
      intro n
      induction n with
      | zero =>
        intro q hq hn he
        rw [hq.natDegree_eq_zero] at hn
        rw [hn, Polynomial.map_one, Polynomial.eval_one] at he
        exact absurd he one_ne_zero
      | succ n ih =>
        intro q hq hn he
        obtain ⟨w, hw⟩ := hroot q hq (by omega)
        have hfac : (Polynomial.X - Polynomial.C w) * (q /ₘ (Polynomial.X - Polynomial.C w)) = q :=
          Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hw
        have hq' : (q /ₘ (Polynomial.X - Polynomial.C w)).Monic :=
          Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C w) (by rw [hfac]; exact hq)
        have hdg : (q /ₘ (Polynomial.X - Polynomial.C w)).natDegree = n := by
          have := Polynomial.Monic.natDegree_mul (Polynomial.monic_X_sub_C w) hq'
          rw [hfac, Polynomial.natDegree_X_sub_C] at this; omega
        rw [← hfac, Polynomial.map_mul, Polynomial.eval_mul] at he
        simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, Polynomial.eval_sub,
          Polynomial.eval_X, Polynomial.eval_C, RingHom.comp_apply] at he
        rcases mul_eq_zero.mp he with h1 | h1
        · exact ⟨w, sub_eq_zero.mp h1⟩
        · exact ih _ hq' hdg h1
    obtain ⟨p, hpm, hp⟩ := hs
    have hlift : p.map ((Ideal.Quotient.mk Q0).comp (algebraMap R S)) ∈
        Polynomial.lifts ((Ideal.Quotient.mk Q0).comp τ) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      obtain ⟨w, hw⟩ := happ (p.coeff n)
      exact ⟨w, (Ideal.Quotient.eq.mpr hw).symm⟩
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift (hpm.map _)
    have he : (q.map ((Ideal.Quotient.mk Q0).comp τ)).eval (Ideal.Quotient.mk Q0 s) = 0 := by
      rw [hqmap, Polynomial.eval_map, ← Polynomial.hom_eval₂, hp, map_zero]
    obtain ⟨w, hw⟩ := peel _ q hqm rfl he
    exact ⟨w, Ideal.Quotient.eq.mp hw⟩

  obtain ⟨hft, hnz, -, hmax, hle, -, hg0, huv, hp, -⟩ := hPD
  haveI := hnz
  haveI := hmax

  have s3 : ∀ x : A ⧸ 𝔭, IsIntegral ↥W x := by
    intro x
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    have hle' : IsLocalRing.maximalIdeal ↥W ≤ 𝔭.comap (algebraMap ↥W A) :=
      Ideal.map_le_iff_le_comap.mp hle
    let φ : IsLocalRing.ResidueField ↥W →+* A ⧸ 𝔭 := Ideal.quotientMap 𝔭 (algebraMap ↥W A) hle'
    letI : Algebra (IsLocalRing.ResidueField ↥W) (A ⧸ 𝔭) := φ.toAlgebra
    haveI : IsScalarTower ↥W (IsLocalRing.ResidueField ↥W) (A ⧸ 𝔭) :=
      IsScalarTower.of_algebraMap_eq (fun w => rfl)
    haveI : Algebra.FiniteType ↥W (A ⧸ 𝔭) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ↥W 𝔭) (Ideal.Quotient.mkₐ_surjective ↥W 𝔭)
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W) (A ⧸ 𝔭) :=
      Algebra.FiniteType.of_restrictScalars_finiteType ↥W (IsLocalRing.ResidueField ↥W) (A ⧸ 𝔭)
    haveI : Module.Finite (IsLocalRing.ResidueField ↥W) (A ⧸ 𝔭) :=
      finite_of_finite_type_of_isJacobsonRing (IsLocalRing.ResidueField ↥W) (A ⧸ 𝔭)
    obtain ⟨p, hpm, hp⟩ := IsIntegral.of_finite (IsLocalRing.ResidueField ↥W) x
    have hlift : p ∈ Polynomial.lifts (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact Ideal.Quotient.mk_surjective (p.coeff n)
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
    refine ⟨q, hqm, ?_⟩
    rw [IsScalarTower.algebraMap_eq ↥W (IsLocalRing.ResidueField ↥W) (A ⧸ 𝔭),
      ← Polynomial.eval₂_map, hqmap]
    exact hp

  have hAres : ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 := by
    intro a
    haveI : (⊥ : Ideal (A ⧸ 𝔭)).IsPrime := by infer_instance
    obtain ⟨w, hw⟩ := s2 ↥W (A ⧸ 𝔭) (algebraMap ↥W (A ⧸ 𝔭)) ⊥
      (fun r => ⟨r, by rw [sub_self]; exact Ideal.zero_mem _⟩) (Ideal.Quotient.mk 𝔭 a)
      (s3 (Ideal.Quotient.mk 𝔭 a))
    refine ⟨w, ?_⟩
    rw [Ideal.mem_bot, ← Ideal.Quotient.mk_algebraMap, ← map_sub,
      Ideal.Quotient.eq_zero_iff_mem] at hw
    exact hw

  have hu0 : algebraMap A K u ≠ 0 := by
    intro h0
    have hu : u = 0 := IsFractionRing.injective A K (h0.trans (map_zero _).symm)
    have h1 : algebraMap ↥W A g = 0 := by rw [← huv, hu, zero_mul]
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases eq_zero_or_eq_zero_of_smul_eq_zero h1 with h2 | h2
    · exact hg0 h2
    · exact one_ne_zero h2
  have hs₁ : algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u ∈
      wcLlsASbS W A K u (a' * q') := by
    unfold wcLlsASbS
    exact Algebra.subset_adjoin (Set.mem_singleton _)
  have hN_u : algebraMap A ↥(wcLlsASbS W A K u (a' * q')) u ∈ wcLlsASbN W A K u (a' * q') := by
    unfold wcLlsASbN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hN_s : (⟨algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u, hs₁⟩ :
      ↥(wcLlsASbS W A K u (a' * q'))) ∈ wcLlsASbN W A K u (a' * q') := by
    unfold wcLlsASbN
    exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hN_m : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w) ∈
        wcLlsASbN W A K u (a' * q') := by
    intro w hw
    unfold wcLlsASbN
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  obtain ⟨c₀, hc₀⟩ := hdvd
  have hv_eq : algebraMap A K v = algebraMap A K (algebraMap ↥W A c₀) *
      (algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u) := by
    have e : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A (a' * q')) * algebraMap A K (algebraMap ↥W A c₀) := by
      rw [← map_mul (algebraMap A K) u v, huv, hc₀, map_mul (algebraMap ↥W A),
        map_mul (algebraMap A K)]
    rw [mul_div_assoc', eq_div_iff hu0]
    linear_combination e
  have hN_v : algebraMap A ↥(wcLlsASbS W A K u (a' * q')) v ∈ wcLlsASbN W A K u (a' * q') := by
    have e : algebraMap A ↥(wcLlsASbS W A K u (a' * q')) v =
        algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A c₀) *
          ⟨algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u, hs₁⟩ :=
      Subtype.ext hv_eq
    rw [e]
    exact Ideal.mul_mem_left _ _ hN_s
  have hle_comap : 𝔭 ≤ (wcLlsASbN W A K u (a' * q')).comap
      (algebraMap A ↥(wcLlsASbS W A K u (a' * q'))) := by
    rw [hp]
    refine sup_le (Ideal.span_le.mpr ?_) (Ideal.map_le_iff_le_comap.mpr ?_)
    · intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hx | hx
      · rw [hx]; exact hN_u
      · rw [hx]; exact hN_v
    · intro w hw
      exact hN_m w hw
  have hR₁ : ∀ r : ↥(wcLlsASbS W A K u (a' * q')), ∃ w : ↥W,
      r - algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w) ∈
        wcLlsASbN W A K u (a' * q') := by
    rintro ⟨r, hr⟩
    have key : ∀ (x : K) (hx : x ∈ Algebra.adjoin A
        {algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u}),
        ∃ w : ↥W, (⟨x, hx⟩ : ↥(wcLlsASbS W A K u (a' * q'))) -
          algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w) ∈
            wcLlsASbN W A K u (a' * q') := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact ⟨0, by rw [map_zero, map_zero, sub_zero]; exact hN_s⟩
      | algebraMap a =>
        obtain ⟨w, hw⟩ := hAres a
        refine ⟨w, ?_⟩
        have h1 := hle_comap hw
        rw [Ideal.mem_comap, map_sub] at h1
        exact h1
      | add x y hx hy ihx ihy =>
        obtain ⟨w₁, h₁⟩ := ihx
        obtain ⟨w₂, h₂⟩ := ihy
        refine ⟨w₁ + w₂, ?_⟩
        have e : ∀ hxy, (⟨x + y, hxy⟩ : ↥(wcLlsASbS W A K u (a' * q'))) -
            algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A (w₁ + w₂)) =
            ((⟨x, hx⟩ : ↥(wcLlsASbS W A K u (a' * q'))) -
              algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w₁)) +
            ((⟨y, hy⟩ : ↥(wcLlsASbS W A K u (a' * q'))) -
              algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w₂)) := by
          intro hxy
          have e1 : (⟨x + y, hxy⟩ : ↥(wcLlsASbS W A K u (a' * q'))) =
              (⟨x, hx⟩ : ↥(wcLlsASbS W A K u (a' * q'))) + ⟨y, hy⟩ := rfl
          rw [e1, map_add, map_add]
          ring
        rw [e]
        exact Ideal.add_mem _ h₁ h₂
      | mul x y hx hy ihx ihy =>
        obtain ⟨w₁, h₁⟩ := ihx
        obtain ⟨w₂, h₂⟩ := ihy
        refine ⟨w₁ * w₂, ?_⟩
        have e : ∀ hxy, (⟨x * y, hxy⟩ : ↥(wcLlsASbS W A K u (a' * q'))) -
            algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A (w₁ * w₂)) =
            ((⟨x, hx⟩ : ↥(wcLlsASbS W A K u (a' * q'))) -
              algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w₁)) *
                (⟨y, hy⟩ : ↥(wcLlsASbS W A K u (a' * q'))) +
            algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w₁) *
              ((⟨y, hy⟩ : ↥(wcLlsASbS W A K u (a' * q'))) -
                algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w₂)) := by
          intro hxy
          have e1 : (⟨x * y, hxy⟩ : ↥(wcLlsASbS W A K u (a' * q'))) =
              (⟨x, hx⟩ : ↥(wcLlsASbS W A K u (a' * q'))) * ⟨y, hy⟩ := rfl
          rw [e1, map_mul, map_mul]
          ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ h₁) (Ideal.mul_mem_left _ _ h₂)
    exact key r hr

  let τ : ↥W →+* ↥(wcIsicgC1 W A K L u (a' * q')) :=
    (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))).comp
      ((algebraMap A ↥(wcLlsASbS W A K u (a' * q'))).comp (algebraMap ↥W A))
  have hτm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, τ w ∈ Q := by
    intro w hw
    have h1 := hN_m w hw
    rw [← hQc, Ideal.mem_comap] at h1
    exact h1

  have hC₁ : ∀ c : ↥(wcIsicgC1 W A K L u (a' * q')), ∃ w : ↥W, c - τ w ∈ Q := by
    intro c
    refine s2 ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q')) τ Q ?_ c ?_
    · intro r
      obtain ⟨w, hw⟩ := hR₁ r
      refine ⟨w, ?_⟩
      rw [← hQc, Ideal.mem_comap, map_sub] at hw
      exact hw
    · exact Algebra.IsIntegral.isIntegral c

  have s5 : ∀ (C : Type u) [CommRing C] (τ0 : ↥W →+* C) (Q0 : Ideal C) [Q0.IsPrime],
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, τ0 w ∈ Q0) → (∀ c : C, ∃ w : ↥W, c - τ0 w ∈ Q0) →
      ∀ z : Localization.AtPrime Q0, ∃ w : ↥W,
        z - algebraMap C (Localization.AtPrime Q0) (τ0 w) ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime Q0) := by
    intro C _ τ0 Q0 _ hτ0 happ z
    obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q0.primeCompl z
    obtain ⟨w₁, h₁⟩ := happ c
    obtain ⟨w₂, h₂⟩ := happ s
    have hw₂ : IsUnit w₂ := by
      by_contra hn
      have h3 : τ0 w₂ ∈ Q0 := hτ0 w₂ ((IsLocalRing.mem_maximalIdeal w₂).mpr hn)
      apply s.2
      have h4 := Q0.add_mem h₂ h3
      simpa using h4
    obtain ⟨v', hv'⟩ := hw₂.exists_right_inv
    refine ⟨w₁ * v', ?_⟩
    have hx : c - τ0 (w₁ * v') * s ∈ Q0 := by
      have e1 : τ0 (w₁ * v') * τ0 w₂ = τ0 w₁ := by
        rw [← map_mul, mul_assoc, mul_comm v', hv', mul_one]
      have e : c - τ0 (w₁ * v') * s = (c - τ0 w₁) - τ0 (w₁ * v') * (s - τ0 w₂) := by
        linear_combination -e1
      rw [e]
      exact Q0.sub_mem h₁ (Q0.mul_mem_left _ h₂)
    have e2 : IsLocalization.mk' (Localization.AtPrime Q0) c s -
        algebraMap C (Localization.AtPrime Q0) (τ0 (w₁ * v')) =
        IsLocalization.mk' (Localization.AtPrime Q0) (c - τ0 (w₁ * v') * s) s := by
      rw [eq_comm, IsLocalization.mk'_eq_iff_eq_mul, sub_mul, IsLocalization.mk'_spec, map_sub,
        map_mul]
    rw [e2]
    exact (IsLocalization.AtPrime.mk'_mem_maximal_iff (S := Localization.AtPrime Q0) (I := Q0)
      _ _).mpr hx

  have s6 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (σ : ↥W →+* O),
      (∀ z : O, ∃ w : ↥W, z - σ w ∈ IsLocalRing.maximalIdeal O) →
      ∀ h : Polynomial O, h.Monic → 0 < h.natDegree →
        ∃ a, h.eval a ∈ IsLocalRing.maximalIdeal O := by
    intro O _ _ σ happ h hm hd
    have hlift : h.map (IsLocalRing.residue O) ∈
        Polynomial.lifts ((IsLocalRing.residue O).comp σ) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      obtain ⟨w, hw⟩ := happ (h.coeff n)
      refine ⟨w, ?_⟩
      have h1 := (IsLocalRing.residue_eq_zero_iff _).mpr hw
      rw [map_sub, sub_eq_zero] at h1
      exact h1.symm
    obtain ⟨q, hqmap, hqdeg, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift (hm.map _)
    have hqd : 0 < q.natDegree := by rw [hqdeg, hm.natDegree_map]; exact hd
    obtain ⟨w₀, hw₀⟩ := hroot q hqm hqd
    refine ⟨σ w₀, ?_⟩
    rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map,
      ← hqmap]
    have e : IsLocalRing.residue O (σ w₀) = ((IsLocalRing.residue O).comp σ) w₀ := rfl
    rw [e, Polynomial.eval_map, Polynomial.eval₂_at_apply, hw₀, map_zero]
  have hO := s5 ↥(wcIsicgC1 W A K L u (a' * q')) τ Q hτm hC₁
  exact s6 (Localization.AtPrime Q) ((algebraMap _ (Localization.AtPrime Q)).comp τ) hO hpol
    hmon hdeg

theorem wcpa_dj_llsm_lc_hens_basic : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsIntegrallyClosed O]
    [IsLocalRing O] (P : Type u) [CommRing P] (k : O →+* P),
    wcNdIsHens (IsLocalRing.maximalIdeal O) P k →
    IsDomain P ∧ (∀ z : P, ¬ IsUnit z ↔ z ∈ Ideal.map k (IsLocalRing.maximalIdeal O)) ∧
    ((∀ h : Polynomial O, h.Monic → 0 < h.natDegree → ∃ a, h.eval a ∈ IsLocalRing.maximalIdeal O) →
      ∀ z : P, ∃ a : O, ¬ IsUnit (z - k a)) :=
by
  intro O _ _ _ _ P _ k hk
  classical
  have hdom := (wcNd_hens_normal_domain O (IsLocalRing.maximalIdeal O)
    (IsLocalRing.maximalIdeal.isMaximal O).isPrime P k hk).1
  have hk' := hk
  obtain ⟨hHP, hunits, _huniv⟩ := hk'
  haveI : HenselianLocalRing P := hHP
  set 𝔪 := IsLocalRing.maximalIdeal O with h𝔪
  set J := Ideal.map k 𝔪 with hJdef
  have hJ : J ≤ IsLocalRing.maximalIdeal P := by
    rw [hJdef, Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hunits a).mp hu ha

  have hK : ∀ z : P, ∃ a : O, z - k a ∈ J := by
    haveI h𝔪max : 𝔪.IsMaximal := IsLocalRing.maximalIdeal.isMaximal O
    letI : Field (O ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have hq := wcNd_hens_quotient O 𝔪 𝔪 P k hk le_rfl
    set kb : O ⧸ 𝔪 →+* P ⧸ J := Ideal.quotientMap (𝔪.map k) k Ideal.le_comap_map with hkb
    obtain ⟨hHPb, hunitsb, hunivb⟩ := hq
    have hp0 : ∀ c : O ⧸ 𝔪, IsUnit c ↔ c ∉ 𝔪.map (Ideal.Quotient.mk 𝔪) := by
      intro c
      rw [Ideal.map_quotient_self, Ideal.mem_bot, isUnit_iff_ne_zero]
    haveI : HenselianLocalRing (O ⧸ 𝔪) := Field.henselian (O ⧸ 𝔪)
    obtain ⟨h, ⟨hh1, hh2⟩, -⟩ := hunivb (O ⧸ 𝔪) (Field.henselian _) (RingHom.id _) hp0
    haveI : IsLocalHom h := hh2
    haveI : IsLocalHom kb := ⟨fun c hc => (hp0 c).mpr ((hunitsb c).mp hc)⟩
    haveI : HenselianLocalRing (P ⧸ J) := hHPb
    have huq := hunivb (P ⧸ J) hHPb kb hunitsb
    have e1 : kb.comp h = RingHom.id (P ⧸ J) := by
      apply huq.unique
      · refine ⟨?_, ?_⟩
        · rw [RingHom.comp_assoc, hh1, RingHom.comp_id]
        · exact RingHom.isLocalHom_comp kb h
      · exact ⟨RingHom.id_comp _, inferInstance⟩
    intro z
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (h (Ideal.Quotient.mk J z))
    refine ⟨a, ?_⟩
    rw [← Ideal.Quotient.eq]
    have e2 := RingHom.congr_fun e1 (Ideal.Quotient.mk J z)
    rw [RingHom.comp_apply, RingHom.id_apply, ← ha, hkb, Ideal.quotientMap_mk] at e2
    exact e2.symm
  refine ⟨hdom, ?_, ?_⟩
  · intro z
    constructor
    · intro hz
      obtain ⟨a, ha⟩ := hK z
      by_cases ham : a ∈ 𝔪
      · have := J.add_mem ha (Ideal.mem_map_of_mem k ham)
        rwa [sub_add_cancel] at this
      · exfalso
        have hu : IsUnit (k a) := (hunits a).mpr ham
        have hzm : z ∈ IsLocalRing.maximalIdeal P := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hz
        have hka : k a ∈ IsLocalRing.maximalIdeal P := by
          have := (IsLocalRing.maximalIdeal P).sub_mem hzm (hJ ha)
          rwa [sub_sub_cancel] at this
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hka
        exact hka hu
    · intro hz
      have := hJ hz
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at this
  · intro _ z
    obtain ⟨a, ha⟩ := hK z
    refine ⟨a, ?_⟩
    have := hJ ha
    rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at this

theorem wcpa_dj_llsm_lcl_residue : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (σ : ↥W →+* P) (β : ↥W) (f : wcEbntN W β →+* P), wcEbntPres W σ β f → ∃ r : P →+* IsLocalRing.ResidueField ↥W, r.comp σ = IsLocalRing.residue ↥W ∧ r (f (wcEbntX W β 0)) = 0 ∧ r (f (wcEbntX W β 1)) = 0 ∧ ∀ z : P, ∃ w : ↥W, z - σ w ∈ Ideal.span {f (wcEbntX W β 0), f (wcEbntX W β 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
by
  intro Ω _ W P _ σ β f hpres
  obtain ⟨hβm, -, hfσ, hHens, hunit, huniv⟩ := hpres
  set Rel : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} with hRel
  set A0 : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C with hA0

  have hresβ : IsLocalRing.residue ↥W β = 0 := (IsLocalRing.residue_eq_zero_iff β).mpr hβm
  let φ : MvPolynomial (Fin 2) ↥W →+* IsLocalRing.ResidueField ↥W :=
    MvPolynomial.eval₂Hom (IsLocalRing.residue ↥W) (fun _ => 0)
  have hφC : ∀ w, φ (MvPolynomial.C w) = IsLocalRing.residue ↥W w := fun w =>
    MvPolynomial.eval₂Hom_C _ _ _
  have hφX : ∀ i, φ (MvPolynomial.X i) = 0 := fun i => MvPolynomial.eval₂Hom_X' _ _ _
  have hφRel : ∀ a ∈ Rel, φ a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp only [map_mul, map_sub, hφX, hφC, hresβ]
    ring
  let ev : wcEbntN W β →+* IsLocalRing.ResidueField ↥W := Ideal.Quotient.lift Rel φ hφRel
  have hev : ∀ F, ev (Ideal.Quotient.mk Rel F) = φ F := fun F => Ideal.Quotient.lift_mk _ _ _
  have hK : ∀ F : MvPolynomial (Fin 2) ↥W, F - MvPolynomial.C (MvPolynomial.constantCoeff F) ∈
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [e]; exact Ideal.add_mem _ hp hq
    | mul_X p n hp =>
      have hX : (MvPolynomial.X n : MvPolynomial (Fin 2) ↥W) ∈
          (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
        apply Ideal.subset_span
        fin_cases n <;> simp
      have e : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n))
          = p * MvPolynomial.X n := by
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      rw [e]; exact Ideal.mul_mem_left _ _ hX
  have hφspan : ∀ F ∈ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin 2) ↥W)), φ F = 0 := by
    intro F hF
    have hle : (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
        Ideal (MvPolynomial (Fin 2) ↥W)) ≤ RingHom.ker φ := by
      rw [Ideal.span_le]
      rintro x (rfl | rfl)
      · exact (RingHom.mem_ker).mpr (hφX _)
      · exact (RingHom.mem_ker).mpr (hφX _)
    exact (RingHom.mem_ker).mp (hle hF)
  have hφcc : ∀ F, φ F = IsLocalRing.residue ↥W (MvPolynomial.constantCoeff F) := by
    intro F
    have h1 := hφspan _ (hK F)
    rw [map_sub, hφC, sub_eq_zero] at h1
    exact h1
  have hker : ∀ a : wcEbntN W β, ev a = 0 ↔ a ∈ A0.map (Ideal.Quotient.mk Rel) := by
    intro a
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
    constructor
    · intro h
      rw [hev, hφcc, IsLocalRing.residue_eq_zero_iff] at h
      apply Ideal.mem_map_of_mem
      have h4 := Ideal.add_mem A0
        (Ideal.mem_sup_left (hK F) : F - MvPolynomial.C (MvPolynomial.constantCoeff F) ∈ A0)
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem MvPolynomial.C h) :
          MvPolynomial.C (MvPolynomial.constantCoeff F) ∈ A0)
      rwa [sub_add_cancel] at h4
    · intro h
      have hle : A0.map (Ideal.Quotient.mk Rel) ≤ RingHom.ker ev := by
        rw [Ideal.map_le_iff_le_comap]
        refine sup_le ?_ ?_
        · intro x hx
          rw [Ideal.mem_comap, RingHom.mem_ker, hev]
          exact hφspan x hx
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.mem_ker, hev, hφC]
          exact (IsLocalRing.residue_eq_zero_iff w).mpr hw
      exact (RingHom.mem_ker).mp (hle h)

  set I : Ideal P := (A0.map (Ideal.Quotient.mk Rel)).map f with hI
  haveI : HenselianLocalRing P := hHens
  have hIle : I ≤ IsLocalRing.maximalIdeal P := by
    rw [hI, Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hunit a).mp hu ha
  have hIne : I ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal P).ne_top hIle
  haveI : Nontrivial (P ⧸ I) := by
    refine ⟨⟨0, 1, fun h => hIne ((Ideal.eq_top_iff_one I).mpr ?_)⟩⟩
    have h1 : Ideal.Quotient.mk I 1 = 0 := by rw [map_one]; exact h.symm
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1
  haveI hmkloc : IsLocalHom (Ideal.Quotient.mk I) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  haveI : IsLocalRing (P ⧸ I) :=
    IsLocalRing.of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hQH : HenselianLocalRing (P ⧸ I) := by
    refine @HenselianLocalRing.mk (P ⧸ I) _ inferInstance ?_
    intro g hg a₀ h₁ h₂
    obtain ⟨G, hGmap, -, hGmon⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts g).mpr (Polynomial.map_surjective _ Ideal.Quotient.mk_surjective g)) hg
    subst hGmap
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a₀
    rw [Polynomial.eval_map, Polynomial.eval₂_at_apply] at h₁
    rw [Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_at_apply] at h₂
    have h₁' : Polynomial.eval a G ∈ IsLocalRing.maximalIdeal P := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h₁ ⊢
      exact fun hu => h₁ (hu.map _)
    have h₂' : IsUnit (Polynomial.eval a (Polynomial.derivative G)) :=
      isUnit_of_map_unit (Ideal.Quotient.mk I) _ h₂
    obtain ⟨b, hb, hba⟩ := HenselianLocalRing.is_henselian G hGmon a h₁' h₂'
    refine ⟨Ideal.Quotient.mk I b, ?_, ?_⟩
    · show Polynomial.eval (Ideal.Quotient.mk I b) (Polynomial.map (Ideal.Quotient.mk I) G) = 0
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply, hb.eq_zero, map_zero]
    · rw [← map_sub, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hba
      exact fun hu => hba (isUnit_of_map_unit (Ideal.Quotient.mk I) _ hu)
  have hevunit : ∀ a : wcEbntN W β, IsUnit (ev a) ↔ a ∉ A0.map (Ideal.Quotient.mk Rel) := by
    intro a
    rw [isUnit_iff_ne_zero, Ne, hker]
  obtain ⟨rr, ⟨hrrf, hrrloc⟩, -⟩ :=
    huniv (IsLocalRing.ResidueField ↥W) (Field.henselian _) ev hevunit
  haveI := hrrloc
  have hrrfa : ∀ a, rr (f a) = ev a := fun a => RingHom.congr_fun hrrf a
  have hσw : ∀ w, σ w = f (Ideal.Quotient.mk Rel (MvPolynomial.C w)) := fun w => by
    rw [← hfσ, RingHom.comp_apply, RingHom.comp_apply]

  let evb : (wcEbntN W β ⧸ A0.map (Ideal.Quotient.mk Rel)) →+* IsLocalRing.ResidueField ↥W :=
    Ideal.Quotient.lift _ ev (fun a ha => (hker a).mpr ha)
  have hevb : ∀ a, evb (Ideal.Quotient.mk _ a) = ev a := fun a => Ideal.Quotient.lift_mk _ _ _
  have hevb_inj : Function.Injective evb := by
    intro x y hxy
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [hevb, hevb] at hxy
    apply Ideal.Quotient.eq.mpr
    exact (hker (a - b)).mp (by rw [map_sub, hxy, sub_self])
  have hev_surj : Function.Surjective ev := by
    intro y
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨Ideal.Quotient.mk Rel (MvPolynomial.C w), by rw [hev, hφC]⟩
  have hevb_surj : Function.Surjective evb := by
    intro y
    obtain ⟨a, rfl⟩ := hev_surj y
    exact ⟨Ideal.Quotient.mk _ a, hevb a⟩
  let E := RingEquiv.ofBijective evb ⟨hevb_inj, hevb_surj⟩
  have hEsymm : ∀ x, E.symm (evb x) = x := fun x => E.symm_apply_apply x
  let e' : (wcEbntN W β ⧸ A0.map (Ideal.Quotient.mk Rel)) →+* P ⧸ I :=
    Ideal.quotientMap I f Ideal.le_comap_map
  have he' : ∀ a, e' (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk I (f a) := fun a =>
    Ideal.quotientMap_mk
  have hIker : I ≤ RingHom.ker rr := by
    rw [hI, Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, hrrfa]
    exact (hker a).mpr ha
  let hb : P ⧸ I →+* IsLocalRing.ResidueField ↥W :=
    Ideal.Quotient.lift I rr (fun z hz => (RingHom.mem_ker).mp (hIker hz))
  have hhb : ∀ z, hb (Ideal.Quotient.mk I z) = rr z := fun z => Ideal.Quotient.lift_mk _ _ _
  let φQ : P ⧸ I →+* P ⧸ I := (e'.comp E.symm.toRingHom).comp hb
  have hφQ_apply : ∀ y, φQ y = e' (E.symm (hb y)) := fun y => rfl
  have hφQg : φQ.comp ((Ideal.Quotient.mk I).comp f) = (Ideal.Quotient.mk I).comp f := by
    apply RingHom.ext
    intro a
    show e' (E.symm (hb (Ideal.Quotient.mk I (f a)))) = Ideal.Quotient.mk I (f a)
    rw [hhb, hrrfa, ← hevb, hEsymm, he']
  have hφQloc : IsLocalHom φQ := by
    refine ⟨fun y hy => ?_⟩
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hz : rr z ≠ 0 := by
      intro h0
      apply not_isUnit_zero (M₀ := P ⧸ I)
      have h5 : φQ (Ideal.Quotient.mk I z) = 0 := by
        rw [hφQ_apply, hhb, h0, map_zero, map_zero]
      rw [← h5]
      exact hy
    have hu : IsUnit z := isUnit_of_map_unit rr z (isUnit_iff_ne_zero.mpr hz)
    exact hu.map _
  have hgunit : ∀ a : wcEbntN W β, IsUnit (((Ideal.Quotient.mk I).comp f) a) ↔
      a ∉ A0.map (Ideal.Quotient.mk Rel) := by
    intro a
    rw [← hunit a, RingHom.comp_apply]
    exact ⟨fun hu => isUnit_of_map_unit (Ideal.Quotient.mk I) _ hu, fun hu => hu.map _⟩
  have hEU := huniv (P ⧸ I) hQH ((Ideal.Quotient.mk I).comp f) hgunit
  have hk1 : (φQ.comp (Ideal.Quotient.mk I)).comp f = (Ideal.Quotient.mk I).comp f := by
    rw [RingHom.comp_assoc]; exact hφQg
  haveI := hφQloc
  have hk1loc : IsLocalHom (φQ.comp (Ideal.Quotient.mk I)) := by
    refine ⟨fun y hy => ?_⟩
    exact isUnit_of_map_unit (Ideal.Quotient.mk I) y (isUnit_of_map_unit φQ _ hy)
  have hφQid : φQ.comp (Ideal.Quotient.mk I) = Ideal.Quotient.mk I :=
    hEU.unique ⟨hk1, hk1loc⟩ ⟨rfl, hmkloc⟩
  have hrep : ∀ z : P, ∃ a : wcEbntN W β, z - f a ∈ I := by
    intro z
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (E.symm (rr z))
    refine ⟨a, ?_⟩
    rw [← Ideal.Quotient.eq]
    have e1 : Ideal.Quotient.mk I z = φQ (Ideal.Quotient.mk I z) := by
      rw [← RingHom.comp_apply φQ, hφQid]
    rw [e1, hφQ_apply, hhb, ← ha, he']

  have hIJ : I ≤ Ideal.span {f (wcEbntX W β 0), f (wcEbntX W β 1)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map σ := by
    rw [hI, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro x (rfl | rfl)
      · rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, ← hσw]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem σ hw)
  refine ⟨rr, ?_, ?_, ?_, ?_⟩
  · apply RingHom.ext
    intro w
    rw [RingHom.comp_apply, hσw, hrrfa, hev, hφC]
  · rw [hrrfa]
    show ev (Ideal.Quotient.mk Rel (MvPolynomial.X 0)) = 0
    rw [hev, hφX]
  · rw [hrrfa]
    show ev (Ideal.Quotient.mk Rel (MvPolynomial.X 1)) = 0
    rw [hev, hφX]
  · intro z
    obtain ⟨a, ha⟩ := hrep z
    obtain ⟨w, hw⟩ := IsLocalRing.residue_surjective (ev a)
    refine ⟨w, hIJ ?_⟩
    have h2 : a - Ideal.Quotient.mk Rel (MvPolynomial.C w) ∈ A0.map (Ideal.Quotient.mk Rel) := by
      rw [← hker, map_sub, hev, hφC, hw, sub_self]
    have h3 := Ideal.add_mem _ ha (Ideal.mem_map_of_mem f h2)
    rw [map_sub, ← hσw] at h3
    convert h3 using 1
    ring

theorem wcpa_dj_llsm_lcl_fibre_map : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] [IsDomain P] (σ : ↥W →+* P) (β : ↥W) (f : wcEbntN W β →+* P), wcEbntPres W σ β f → ∀ (μ d : ↥W), μ ∈ IsLocalRing.maximalIdeal ↥W → μ ≠ 0 → d ∈ IsLocalRing.maximalIdeal ↥W → d ≠ 0 → μ * d = β → ∀ (r : P →+* IsLocalRing.ResidueField ↥W), r.comp σ = IsLocalRing.residue ↥W → r (f (wcEbntX W β 0)) = 0 → r (f (wcEbntX W β 1)) = 0 → ∃ ρ : ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W), (∀ p : P, ρ (algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) p) = LaurentPolynomial.C (r p)) ∧ ρ ⟨wcLcT (f (wcEbntX W β 0)) (σ μ), Algebra.subset_adjoin (by simp)⟩ = LaurentPolynomial.T 1 :=
by
  classical
  have s3 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (β μ d : ↥W), μ ∈ IsLocalRing.maximalIdeal ↥W → μ ≠ 0 → d ∈ IsLocalRing.maximalIdeal ↥W → μ * d = β → ∀ (φ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* IsLocalRing.ResidueField ↥W), φ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = 0 → φ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = 0 → φ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = IsLocalRing.residue ↥W → ∀ (D : ℕ) (a : Fin (D + 1) → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})), ∑ k : Fin (D + 1), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0 ^ (k : ℕ) * MvPolynomial.C μ ^ (D - (k : ℕ))) * a k = 0 → ∀ k, φ (a k) = 0 := by
    intro Ω _ W β μ d hμm hμ0 hdm hβ φ hφ0 hφ1 hφC D a hsum k
    classical
    let e : MvPolynomial (Fin 2) ↥W →+* LaurentPolynomial ↥W :=
      MvPolynomial.eval₂Hom LaurentPolynomial.C
        ![LaurentPolynomial.C μ * LaurentPolynomial.T 1, LaurentPolynomial.C d * LaurentPolynomial.T (-1)]
    have he0 : e (MvPolynomial.X 0) = LaurentPolynomial.C μ * LaurentPolynomial.T 1 := by
      simp [e]
    have he1 : e (MvPolynomial.X 1) = LaurentPolynomial.C d * LaurentPolynomial.T (-1) := by
      simp [e]
    have heC : ∀ w, e (MvPolynomial.C w) = LaurentPolynomial.C w := fun w => by
      simp [e]
    have he : ∀ x ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} : Ideal (MvPolynomial (Fin 2) ↥W)), e x = 0 := by
      intro x hx
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [map_mul, map_sub, map_mul, he0, he1, heC, ← hβ, map_mul]
      have hT : (LaurentPolynomial.T 1 : LaurentPolynomial ↥W) * LaurentPolynomial.T (-1) = 1 := by
        rw [← LaurentPolynomial.T_add]; norm_num
      have : LaurentPolynomial.C μ * LaurentPolynomial.T 1 * (LaurentPolynomial.C d * LaurentPolynomial.T (-1))
          - LaurentPolynomial.C μ * LaurentPolynomial.C d = (0 : LaurentPolynomial ↥W) := by
        linear_combination (LaurentPolynomial.C μ * LaurentPolynomial.C d) * hT
      rw [this, mul_zero]
    let τ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) →+* LaurentPolynomial ↥W := Ideal.Quotient.lift _ e he
    have hτ : ∀ x, τ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) x) = e x := fun x => Ideal.Quotient.lift_mk _ e he
    let u := (LaurentPolynomial.isUnit_T (R := IsLocalRing.ResidueField ↥W) 1).unit
    let mapres : LaurentPolynomial ↥W →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W) :=
      LaurentPolynomial.eval₂ (LaurentPolynomial.C.comp (IsLocalRing.residue ↥W)) u
    have hmT : mapres (LaurentPolynomial.T 1) = LaurentPolynomial.T 1 := by
      simp only [mapres]
      rw [LaurentPolynomial.eval₂_T, zpow_one, IsUnit.unit_spec]
    have hmC : ∀ w, mapres (LaurentPolynomial.C w) = LaurentPolynomial.C (IsLocalRing.residue ↥W w) :=
      fun w => by simp only [mapres]; rw [LaurentPolynomial.eval₂_C]; rfl
    have hres0 : IsLocalRing.residue ↥W μ = 0 := (IsLocalRing.residue_eq_zero_iff μ).mpr hμm
    have hres1 : IsLocalRing.residue ↥W d = 0 := (IsLocalRing.residue_eq_zero_iff d).mpr hdm
    have hcomp : mapres.comp τ = LaurentPolynomial.C.comp φ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro w
        simp only [RingHom.comp_apply]
        rw [hτ, heC, hmC]
        have := RingHom.congr_fun hφC w
        simp only [RingHom.comp_apply] at this
        rw [this]
      · intro i
        fin_cases i
        · simp only [RingHom.comp_apply]
          rw [hτ]
          show mapres (e (MvPolynomial.X 0)) = LaurentPolynomial.C (φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0)))
          rw [he0, map_mul, hmC, hres0, hφ0, map_zero, zero_mul]
        · simp only [RingHom.comp_apply]
          rw [hτ]
          show mapres (e (MvPolynomial.X 1)) = LaurentPolynomial.C (φ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 1)))
          rw [he1, map_mul, hmC, hres1, hφ1, map_zero, zero_mul]
    have hmτ : ∀ x, mapres (τ x) = LaurentPolynomial.C (φ x) := fun x => RingHom.congr_fun hcomp x
    have hτc : ∀ i : Fin (D + 1), τ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β}) (MvPolynomial.X 0 ^ (i : ℕ) * MvPolynomial.C μ ^ (D - (i : ℕ)))) =
        LaurentPolynomial.C (μ ^ D) * LaurentPolynomial.T 1 ^ (i : ℕ) := by
      intro i
      have hi : (i : ℕ) ≤ D := Nat.lt_succ_iff.mp i.isLt
      rw [hτ, map_mul, map_pow, map_pow, he0, heC, mul_pow, map_pow]
      calc LaurentPolynomial.C μ ^ (i : ℕ) * LaurentPolynomial.T 1 ^ (i : ℕ) * LaurentPolynomial.C μ ^ (D - (i : ℕ))
          = (LaurentPolynomial.C μ ^ (i : ℕ) * LaurentPolynomial.C μ ^ (D - (i : ℕ))) * LaurentPolynomial.T 1 ^ (i : ℕ) := by ring
        _ = LaurentPolynomial.C μ ^ D * LaurentPolynomial.T 1 ^ (i : ℕ) := by rw [pow_mul_pow_sub _ hi]
    have h1 := congrArg τ hsum
    rw [map_sum, map_zero] at h1
    have h1' : LaurentPolynomial.C (μ ^ D) * ∑ i : Fin (D + 1), LaurentPolynomial.T 1 ^ (i : ℕ) * τ (a i) = 0 := by
      rw [← h1, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul τ, hτc, mul_assoc]
    clear h1
    have h1 := h1'
    have hC : (LaurentPolynomial.C (μ ^ D) : LaurentPolynomial ↥W) ≠ 0 := by
      intro h
      rw [← Polynomial.toLaurent_C, ← map_zero (Polynomial.toLaurent (R := ↥W))] at h
      have h' := Polynomial.toLaurent_injective h
      rw [Polynomial.C_eq_zero] at h'
      exact pow_ne_zero D hμ0 h'
    have h2 := (mul_eq_zero.mp h1).resolve_left hC
    have h3 := congrArg mapres h2
    rw [map_sum, map_zero] at h3
    set p : Polynomial (IsLocalRing.ResidueField ↥W) :=
      ∑ i : Fin (D + 1), Polynomial.C (φ (a i)) * Polynomial.X ^ (i : ℕ) with hp
    have h4 : Polynomial.toLaurent p = 0 := by
      rw [hp, map_sum, ← h3]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow, Polynomial.toLaurent_C, Polynomial.toLaurent_X, map_mul mapres, map_pow,
        hmT, hmτ, mul_comm]
    rw [← map_zero (Polynomial.toLaurent (R := IsLocalRing.ResidueField ↥W))] at h4
    have h5 := Polynomial.toLaurent_injective h4
    have h6 := congrArg (fun q => Polynomial.coeff q (k : ℕ)) h5
    simp only [hp, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_zero] at h6
    simpa [Fin.val_inj] using h6
  have s4 : ∀ (A B K : Type u) [CommRing A] [CommRing B] [CommRing K] (f : A →+* B) (r : B →+* K), f.Flat → ∀ (n : ℕ) (c : Fin n → A) (x : Fin n → B), ∑ i, f (c i) * x i = 0 → (∀ a : Fin n → A, ∑ i, c i * a i = 0 → ∀ i, r (f (a i)) = 0) → ∀ i, r (x i) = 0 := by
    intro A B K _ _ _ f r hf n c x hsum hcol i
    let _i : Algebra A B := f.toAlgebra
    have hfl : Module.Flat A B := hf
    have hs : ∑ j, c j • x j = 0 := by
      rw [← hsum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Algebra.smul_def]
      rfl
    have h : Module.IsTrivialRelation c x := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hs
    obtain ⟨k, a, y, hxy, ha⟩ := h
    rw [hxy i, map_sum]
    apply Finset.sum_eq_zero
    intro j _
    rw [Algebra.smul_def, map_mul]
    have h2 : r (f (a i j)) = 0 := hcol (fun i => a i j) (ha j) i
    have h3 : algebraMap A B (a i j) = f (a i j) := rfl
    rw [h3, h2, zero_mul]
  have s5 : ∀ (R S k : Type u) [CommRing R] [CommRing S] [CommRing k] (ι : R →+* S) (t : Sˣ) (r : R →+* k), (∀ g : Polynomial R, Polynomial.eval₂ ι (t : S) g = 0 → ∀ n, r (g.coeff n) = 0) → ∀ L : LaurentPolynomial R, LaurentPolynomial.eval₂ ι t L = 0 → LaurentPolynomial.eval₂ (LaurentPolynomial.C.comp r) (LaurentPolynomial.isUnit_T (R := k) 1).unit L = 0 := by
    intro R S k _ _ _ ι t r hpoly L hL
    obtain ⟨n, g, hg⟩ := LaurentPolynomial.exists_T_pow L
    have hE : Polynomial.eval₂ ι (t : S) g = 0 := by
      rw [← LaurentPolynomial.eval₂_toLaurent, hg, map_mul, hL, zero_mul]
    have hc := hpoly g hE
    have hΨg : LaurentPolynomial.eval₂ (LaurentPolynomial.C.comp r)
        (LaurentPolynomial.isUnit_T (R := k) 1).unit (Polynomial.toLaurent g) = 0 := by
      rw [LaurentPolynomial.eval₂_toLaurent, Polynomial.eval₂_eq_sum_range]
      apply Finset.sum_eq_zero
      intro m _
      rw [RingHom.comp_apply, hc m, map_zero, zero_mul]
    rw [hg, map_mul, LaurentPolynomial.eval₂_T] at hΨg
    exact (Units.isUnit _).mul_left_eq_zero.mp hΨg
  have s6 : ∀ (P K : Type u) [CommRing P] [CommRing K] (ι : P →+* K), Function.Injective ι → ∀ (x t₀ : P) (T : K), T * ι t₀ = ι x → ∀ g : Polynomial P, Polynomial.eval₂ ι T g = 0 → ∑ k ∈ Finset.range (g.natDegree + 1), x ^ k * t₀ ^ (g.natDegree - k) * g.coeff k = 0 := by
    intro P K _ _ ι hι x t₀ T hT g hg
    apply hι
    rw [map_zero, map_sum]
    rw [Polynomial.eval₂_eq_sum_range] at hg
    have h2 : ι t₀ ^ g.natDegree * ∑ k ∈ Finset.range (g.natDegree + 1), ι (g.coeff k) * T ^ k = 0 := by
      rw [hg, mul_zero]
    rw [← h2, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    have hk' : k ≤ g.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    rw [map_mul, map_mul, map_pow, map_pow, ← hT, mul_pow]
    have : ι t₀ ^ g.natDegree = ι t₀ ^ k * ι t₀ ^ (g.natDegree - k) := by
      rw [← pow_add, Nat.add_sub_cancel' hk']
    rw [this]
    ring
  have s7 : ∀ (P K : Type u) [CommRing P] [Field K] [Algebra P K] (t : Kˣ) (z : K), z ∈ Algebra.adjoin P {(t : K), (t : K)⁻¹} ↔ ∃ L : LaurentPolynomial P, LaurentPolynomial.eval₂ (algebraMap P K) t L = z := by
    intro P K _ _ _ t z
    constructor
    · intro hz
      induction hz using Algebra.adjoin_induction with
      | mem x hx =>
        rcases hx with rfl | rfl
        · exact ⟨LaurentPolynomial.T 1, by rw [LaurentPolynomial.eval₂_T, zpow_one]⟩
        · refine ⟨LaurentPolynomial.T (-1), ?_⟩
          rw [LaurentPolynomial.eval₂_T, zpow_neg_one, Units.val_inv_eq_inv_val]
      | algebraMap p => exact ⟨LaurentPolynomial.C p, LaurentPolynomial.eval₂_C _ _ _⟩
      | add x y _ _ ihx ihy =>
        obtain ⟨L, hL⟩ := ihx
        obtain ⟨L', hL'⟩ := ihy
        exact ⟨L + L', by rw [map_add, hL, hL']⟩
      | mul x y _ _ ihx ihy =>
        obtain ⟨L, hL⟩ := ihx
        obtain ⟨L', hL'⟩ := ihy
        exact ⟨L * L', by rw [map_mul, hL, hL']⟩
    · rintro ⟨L, rfl⟩
      induction L using LaurentPolynomial.induction_on' with
      | add p q hp hq => rw [map_add]; exact add_mem hp hq
      | C_mul_T n a =>
        rw [map_mul, LaurentPolynomial.eval₂_C, LaurentPolynomial.eval₂_T]
        refine Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a) ?_
        rcases Int.eq_nat_or_neg n with ⟨m, rfl | rfl⟩
        · rw [zpow_natCast, Units.val_pow_eq_pow_val]
          exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) m
        · rw [zpow_neg, zpow_natCast, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val, ← inv_pow]
          exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) m
  intro Ω _ _ W hW hWt P _ _ σ β f hpres μ d hμm hμ0 hdm hd0 hβ r hrσ hrX hrY
  have hflat := wcpa_dj_lr1k_ebnt_dmne_pres_flat Ω W hW hWt P σ β f hpres
  have hσinj := wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W P σ β f hpres
  have hpres' := hpres
  obtain ⟨-, -, hfσ, -⟩ := hpres'
  have hιinj : Function.Injective (algebraMap P (FractionRing P)) :=
    IsFractionRing.injective P (FractionRing P)
  have hXYN : wcEbntX W β 0 * wcEbntX W β 1 =
      ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β :
        MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) β := by
    show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
    rw [← map_mul, RingHom.comp_apply, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hXY : f (wcEbntX W β 0) * f (wcEbntX W β 1) = σ μ * σ d := by
    rw [← map_mul σ, hβ, ← map_mul f, hXYN]
    exact RingHom.congr_fun hfσ β
  have hσμ0 : σ μ ≠ 0 := fun h => hμ0 (hσinj (h.trans (map_zero σ).symm))
  have hσd0 : σ d ≠ 0 := fun h => hd0 (hσinj (h.trans (map_zero σ).symm))
  have hX0 : f (wcEbntX W β 0) ≠ 0 := by
    intro h
    rw [h, zero_mul] at hXY
    exact mul_ne_zero hσμ0 hσd0 hXY.symm
  have hιμ : algebraMap P (FractionRing P) (σ μ) ≠ 0 :=
    fun h => hσμ0 (hιinj (h.trans (map_zero _).symm))
  have hιX : algebraMap P (FractionRing P) (f (wcEbntX W β 0)) ≠ 0 :=
    fun h => hX0 (hιinj (h.trans (map_zero _).symm))
  have hT0 : wcLcT (f (wcEbntX W β 0)) (σ μ) ≠ 0 := by
    show algebraMap P (FractionRing P) (f (wcEbntX W β 0)) /
      algebraMap P (FractionRing P) (σ μ) ≠ 0
    exact div_ne_zero hιX hιμ
  have hTmul : wcLcT (f (wcEbntX W β 0)) (σ μ) * algebraMap P (FractionRing P) (σ μ) =
      algebraMap P (FractionRing P) (f (wcEbntX W β 0)) := by
    show algebraMap P (FractionRing P) (f (wcEbntX W β 0)) /
      algebraMap P (FractionRing P) (σ μ) * algebraMap P (FractionRing P) (σ μ) = _
    exact div_mul_cancel₀ _ hιμ
  let t : (FractionRing P)ˣ := Units.mk0 (wcLcT (f (wcEbntX W β 0)) (σ μ)) hT0

  have hpoly : ∀ g : Polynomial P,
      Polynomial.eval₂ (algebraMap P (FractionRing P)) (t : FractionRing P) g = 0 →
      ∀ n, r (g.coeff n) = 0 := by
    intro g hg n
    have hs6 := s6 P (FractionRing P) (algebraMap P (FractionRing P))
      hιinj (f (wcEbntX W β 0)) (σ μ) (wcLcT (f (wcEbntX W β 0)) (σ μ)) hTmul g hg
    let c : Fin (g.natDegree + 1) → wcEbntN W β := fun i =>
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β})
        (MvPolynomial.X 0 ^ (i : ℕ) * MvPolynomial.C μ ^ (g.natDegree - (i : ℕ)))
    have hfC : f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C β}) (MvPolynomial.C μ)) = σ μ := RingHom.congr_fun hfσ μ
    have hfc : ∀ i : Fin (g.natDegree + 1),
        f (c i) = f (wcEbntX W β 0) ^ (i : ℕ) * σ μ ^ (g.natDegree - (i : ℕ)) := by
      intro i
      simp only [c, map_mul, map_pow]
      rw [hfC]
    have hsum : ∑ i : Fin (g.natDegree + 1), f (c i) * g.coeff i = 0 := by
      simp_rw [hfc]
      rw [Fin.sum_univ_eq_sum_range
        (fun k => f (wcEbntX W β 0) ^ k * σ μ ^ (g.natDegree - k) * g.coeff k) (g.natDegree + 1)]
      exact hs6
    have hkill := s4 (wcEbntN W β) P (IsLocalRing.ResidueField ↥W)
      f r hflat (g.natDegree + 1) c (fun i => g.coeff i) hsum (by
        intro a ha
        exact s3 Ω W β μ d hμm hμ0 hdm hβ (r.comp f) hrX hrY
          (by rw [RingHom.comp_assoc, hfσ, hrσ]) g.natDegree a ha)
    by_cases hn : n ≤ g.natDegree
    · exact hkill ⟨n, Nat.lt_succ_of_le hn⟩
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), map_zero]

  have hmem : ∀ L : LaurentPolynomial P,
      LaurentPolynomial.eval₂ (algebraMap P (FractionRing P)) t L ∈
        wcLcPT (f (wcEbntX W β 0)) (σ μ) := fun L =>
    (s7 P (FractionRing P) t _).mpr ⟨L, rfl⟩
  let ev : LaurentPolynomial P →+* ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) :=
    (LaurentPolynomial.eval₂ (algebraMap P (FractionRing P)) t).codRestrict
      (wcLcPT (f (wcEbntX W β 0)) (σ μ)) hmem
  have hsurj : Function.Surjective ev := by
    rintro ⟨z, hz⟩
    obtain ⟨L, hL⟩ := (s7 P (FractionRing P) t z).mp hz
    exact ⟨L, Subtype.ext hL⟩
  let Ψ : LaurentPolynomial P →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W) :=
    LaurentPolynomial.eval₂ (LaurentPolynomial.C.comp r)
      (LaurentPolynomial.isUnit_T (R := IsLocalRing.ResidueField ↥W) 1).unit
  have hker : RingHom.ker ev ≤ RingHom.ker Ψ := by
    intro L hL
    rw [RingHom.mem_ker] at hL ⊢
    have h1 : LaurentPolynomial.eval₂ (algebraMap P (FractionRing P)) t L = 0 :=
      congrArg Subtype.val hL
    exact s5 P (FractionRing P) (IsLocalRing.ResidueField ↥W)
      (algebraMap P (FractionRing P)) t r hpoly L h1
  refine ⟨ev.liftOfSurjective hsurj ⟨Ψ, hker⟩, ?_, ?_⟩
  · intro p
    have h2 : (ev.liftOfSurjective hsurj ⟨Ψ, hker⟩) (ev (LaurentPolynomial.C p)) =
        LaurentPolynomial.C (r p) := by
      rw [RingHom.liftOfSurjective_comp_apply]
      show Ψ (LaurentPolynomial.C p) = _
      rw [LaurentPolynomial.eval₂_C]
      rfl
    convert h2 using 2
    apply Subtype.ext
    show algebraMap P (FractionRing P) p =
      LaurentPolynomial.eval₂ (algebraMap P (FractionRing P)) t (LaurentPolynomial.C p)
    rw [LaurentPolynomial.eval₂_C]
  · have h2 : (ev.liftOfSurjective hsurj ⟨Ψ, hker⟩) (ev (LaurentPolynomial.T 1)) =
        LaurentPolynomial.T 1 := by
      rw [RingHom.liftOfSurjective_comp_apply]
      show Ψ (LaurentPolynomial.T 1) = _
      rw [LaurentPolynomial.eval₂_T, zpow_one, IsUnit.unit_spec]
    convert h2 using 2
    apply Subtype.ext
    show wcLcT (f (wcEbntX W β 0)) (σ μ) =
      LaurentPolynomial.eval₂ (algebraMap P (FractionRing P)) t (LaurentPolynomial.T 1)
    rw [LaurentPolynomial.eval₂_T, zpow_one]
    rfl

theorem wcpa_dj_llsm_lcl_fibre_kernel : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (σ' : ↥W →+* R) (u : Rˣ) (ρ : R →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W)), ρ.comp σ' = LaurentPolynomial.C.comp (IsLocalRing.residue ↥W) → ρ (u : R) = LaurentPolynomial.T 1 → (∀ z : R, ∃ L : LaurentPolynomial ↥W, z - LaurentPolynomial.eval₂ σ' u L ∈ (IsLocalRing.maximalIdeal ↥W).map σ') → RingHom.ker ρ = (IsLocalRing.maximalIdeal ↥W).map σ' ∧ Function.Surjective ρ :=
by
  intro Ω _ W R _ σ' u ρ hρσ hρT hrep
  classical
  have hσ : ∀ w, ρ (σ' w) = LaurentPolynomial.C (IsLocalRing.residue ↥W w) := fun w => by
    rw [← RingHom.comp_apply, hρσ, RingHom.comp_apply]
  have hnat : ∀ k : ℕ, ρ ((u ^ (k:ℤ) : Rˣ) : R) = LaurentPolynomial.T (k:ℤ) := by
    intro k
    rw [zpow_natCast, Units.val_pow_eq_pow_val, map_pow, hρT, LaurentPolynomial.T_pow, mul_one]
  have hpow : ∀ n : ℤ, ρ ((u ^ n : Rˣ) : R) = LaurentPolynomial.T n := by
    intro n
    rcases Int.eq_nat_or_neg n with ⟨k, rfl | rfl⟩
    · exact hnat k
    · have h1 : ρ ((u ^ (-(k:ℤ)) : Rˣ) : R) * LaurentPolynomial.T (k:ℤ) = 1 := by
        rw [← hnat k, ← map_mul, ← Units.val_mul, ← zpow_add, neg_add_cancel, zpow_zero,
          Units.val_one, map_one]
      have h2 : LaurentPolynomial.T (-(k:ℤ)) * LaurentPolynomial.T (k:ℤ) =
          (1 : LaurentPolynomial (IsLocalRing.ResidueField ↥W)) := by
        rw [← LaurentPolynomial.T_add, neg_add_cancel, LaurentPolynomial.T_zero]
      exact (LaurentPolynomial.isUnit_T (k:ℤ)).mul_left_inj.mp (h1.trans h2.symm)
  have hmono : ∀ (a : ↥W) (j : ℤ),
      LaurentPolynomial.eval₂ σ' u (LaurentPolynomial.C a * LaurentPolynomial.T j)
        = σ' a * ((u ^ j : Rˣ) : R) := by
    intro a j
    rw [map_mul, LaurentPolynomial.eval₂_C, LaurentPolynomial.eval₂_T]
  have hcoeff : ∀ (L : LaurentPolynomial ↥W) (m : ℤ),
      (ρ (LaurentPolynomial.eval₂ σ' u L)).coeff m = IsLocalRing.residue ↥W (L.coeff m) := by
    intro L
    induction L using LaurentPolynomial.induction_on' with
    | add p q hp hq =>
      intro m
      rw [map_add, map_add, AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_add,
        Finsupp.add_apply, Finsupp.add_apply, hp, hq, map_add]
    | C_mul_T j a =>
      intro m
      rw [hmono, map_mul, hσ, hpow, ← LaurentPolynomial.single_eq_C_mul_T,
        ← LaurentPolynomial.single_eq_C_mul_T, AddMonoidAlgebra.coeff_single,
        AddMonoidAlgebra.coeff_single, Finsupp.single_apply, Finsupp.single_apply]
      split_ifs <;> simp
  have hmem : ∀ L : LaurentPolynomial ↥W, (∀ n : ℤ, L.coeff n ∈ IsLocalRing.maximalIdeal ↥W) →
      LaurentPolynomial.eval₂ σ' u L ∈ (IsLocalRing.maximalIdeal ↥W).map σ' := by
    intro L hL
    rw [← AddMonoidAlgebra.sum_coeff_single L, map_finsuppSum]
    apply Ideal.sum_mem
    intro n _
    show LaurentPolynomial.eval₂ σ' u (AddMonoidAlgebra.single n (L.coeff n)) ∈ _
    rw [LaurentPolynomial.single_eq_C_mul_T, hmono]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem σ' (hL n))
  have hle : (IsLocalRing.maximalIdeal ↥W).map σ' ≤ RingHom.ker ρ := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    rw [Ideal.mem_comap, RingHom.mem_ker, hσ, (IsLocalRing.residue_eq_zero_iff w).mpr hw, map_zero]
  refine ⟨le_antisymm ?_ hle, ?_⟩
  · intro z hz
    rw [RingHom.mem_ker] at hz
    obtain ⟨L, hLz⟩ := hrep z
    have h0 : ρ (LaurentPolynomial.eval₂ σ' u L) = 0 := by
      have h1 := hle hLz
      rw [RingHom.mem_ker, map_sub, hz, zero_sub, neg_eq_zero] at h1
      exact h1
    have hL : ∀ n : ℤ, L.coeff n ∈ IsLocalRing.maximalIdeal ↥W := by
      intro n
      rw [← IsLocalRing.residue_eq_zero_iff, ← hcoeff, h0]
      rfl
    have := Ideal.add_mem _ hLz (hmem L hL)
    rwa [sub_add_cancel] at this
  · intro f
    induction f using LaurentPolynomial.induction_on' with
    | add p q hp hq =>
      obtain ⟨z₁, h₁⟩ := hp
      obtain ⟨z₂, h₂⟩ := hq
      exact ⟨z₁ + z₂, by rw [map_add, h₁, h₂]⟩
    | C_mul_T n a =>
      obtain ⟨w, hw⟩ := IsLocalRing.residue_surjective a
      exact ⟨σ' w * ((u ^ n : Rˣ) : R), by rw [map_mul, hσ, hpow, hw]⟩

theorem wcpa_dj_llsm_isirnd_normal_of_etale_approx : ∀ (A A₁ P D : Type u) [CommRing A] [CommRing A₁] [IsDomain A₁] [IsIntegrallyClosed A₁] [CommRing P] [CommRing D] [IsDomain D] (ι : A →+* A₁) (f : A →+* P) (j : P →+* D) (ψ : A₁ →+* D), ψ.comp ι = j.comp f → Function.Injective ψ → (∀ F : Finset P, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A E) (_ : Algebra.Etale A E) (φ : E →+* P), φ.comp (algebraMap A E) = f ∧ ∀ x ∈ F, x ∈ φ.range) → (∀ d : D, ∃ (n : ℕ) (p : Fin n → P) (a : Fin n → A₁), d = ∑ i, j (p i) * ψ (a i)) → IsIntegrallyClosed D :=
by
  intro A A₁ P D _ _ _ _ _ _ _ ι f j ψ hcomp hψinj happrox hgen
  classical

  have hchart : ∀ F : Finset D, ∃ (T : Type u) (_ : CommRing T) (_ : Algebra A₁ T)
      (_ : Algebra.Etale A₁ T) (Θ : T →+* D), Θ.comp (algebraMap A₁ T) = ψ ∧
      ∀ x ∈ F, x ∈ Θ.range := by
    intro F
    choose n p a hpa using hgen
    obtain ⟨E, _, _, _, φ, hφ, hFφ⟩ := happrox (F.biUnion (fun d => Finset.univ.image (p d)))
    have hmem : ∀ d ∈ F, ∀ i, ∃ e : E, φ e = p d i := by
      intro d hd i
      exact RingHom.mem_range.mp (hFφ (p d i) (Finset.mem_biUnion.mpr
        ⟨d, hd, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩))
    choose e he using hmem
    letI : Algebra A A₁ := ι.toAlgebra
    letI : Algebra A D := (j.comp f).toAlgebra
    let ψ' : A₁ →ₐ[A] D :=
      { ψ with
        commutes' := fun r => by
          show ψ (ι r) = j (f r)
          exact RingHom.congr_fun hcomp r }
    let χ' : E →ₐ[A] D :=
      { j.comp φ with
        commutes' := fun r => by
          show j (φ (algebraMap A E r)) = j (f r)
          rw [← RingHom.comp_apply φ, hφ] }
    have hΘt : ∀ (x : A₁) (y : E),
        (Algebra.TensorProduct.productMap ψ' χ') (x ⊗ₜ[A] y) = ψ x * j (φ y) := by
      intro x y
      rw [Algebra.TensorProduct.productMap_apply_tmul]
      rfl
    refine ⟨TensorProduct A A₁ E, inferInstance, inferInstance, inferInstance,
      (Algebra.TensorProduct.productMap ψ' χ').toRingHom, ?_, ?_⟩
    · ext x
      show (Algebra.TensorProduct.productMap ψ' χ') (algebraMap A₁ (TensorProduct A A₁ E) x) = ψ x
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply, hΘt,
        map_one, map_one, mul_one]
    · intro x hx
      refine RingHom.mem_range.mpr ⟨∑ i, a x i ⊗ₜ[A] e x hx i, ?_⟩
      refine Eq.trans ?_ (hpa x).symm
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      show (Algebra.TensorProduct.productMap ψ' χ') (a x i ⊗ₜ[A] e x hx i) = _
      rw [hΘt, he, mul_comm]

  apply IsIntegrallyClosed.of_localization_maximal
  intro 𝔫 _ h𝔫max
  haveI : 𝔫.IsPrime := h𝔫max.isPrime
  have hℓinj : Function.Injective (algebraMap D (Localization.AtPrime 𝔫)) :=
    IsLocalization.injective (Localization.AtPrime 𝔫) (Ideal.primeCompl_le_nonZeroDivisors 𝔫)
  refine (wcNd_hne_union_normal (Localization.AtPrime 𝔫) ?_).2
  intro G
  have hsurj : ∀ z : Localization.AtPrime 𝔫, ∃ (x : D) (σ : 𝔫.primeCompl),
      IsLocalization.mk' (Localization.AtPrime 𝔫) x σ = z :=
    fun z => by
      obtain ⟨⟨x, σ⟩, h⟩ := IsLocalization.mk'_surjective 𝔫.primeCompl z
      exact ⟨x, σ, h⟩
  choose x σ hxσ using hsurj
  obtain ⟨T₀, _, _, _, Θ, hΘ, hF⟩ := hchart (G.image x ∪ G.image (fun z => (σ z : D)))
  haveI h𝔔 : (Ideal.comap Θ 𝔫).IsPrime := Ideal.comap_isPrime Θ 𝔫
  obtain ⟨hTd, hTi⟩ := wc_pks_etale_localization_normal A₁ T₀ (Ideal.comap Θ 𝔫)
  let γ : Localization.AtPrime (Ideal.comap Θ 𝔫) →+* Localization.AtPrime 𝔫 :=
    Localization.localRingHom (Ideal.comap Θ 𝔫) 𝔫 Θ rfl
  have hγ1 : ∀ y : T₀, γ (algebraMap T₀ _ y) = algebraMap D (Localization.AtPrime 𝔫) (Θ y) :=
    fun y => Localization.localRingHom_to_map _ _ _ _ _
  have hγinj : Function.Injective γ := by
    apply wcNd_hne_local_injective A₁ T₀ (Ideal.comap Θ 𝔫) hTd (Localization.AtPrime 𝔫) γ
    · have hc : γ.comp (algebraMap A₁ (Localization.AtPrime (Ideal.comap Θ 𝔫))) =
          (algebraMap D (Localization.AtPrime 𝔫)).comp ψ := by
        ext c
        rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply A₁ T₀
          (Localization.AtPrime (Ideal.comap Θ 𝔫)), hγ1, RingHom.comp_apply,
          ← RingHom.comp_apply Θ, hΘ]
      rw [hc]
      exact hℓinj.comp hψinj
    · intro y
      exact wcNd_hne_etale_algebraic A₁ T₀ y
  refine ⟨Localization.AtPrime (Ideal.comap Θ 𝔫), inferInstance, hTd, hTi, γ, hγinj, ?_⟩
  intro z hz
  obtain ⟨t, ht⟩ := RingHom.mem_range.mp
    (hF (x z) (Finset.mem_union_left _ (Finset.mem_image_of_mem x hz)))
  obtain ⟨s, hs⟩ := RingHom.mem_range.mp
    (hF (σ z) (Finset.mem_union_right _ (Finset.mem_image_of_mem (fun z => (σ z : D)) hz)))
  have hs𝔔 : s ∈ (Ideal.comap Θ 𝔫).primeCompl := by
    show s ∉ Ideal.comap Θ 𝔫
    rw [Ideal.mem_comap, hs]
    exact (σ z).2
  refine RingHom.mem_range.mpr
    ⟨IsLocalization.mk' (Localization.AtPrime (Ideal.comap Θ 𝔫)) t ⟨s, hs𝔔⟩, ?_⟩
  have hu : IsUnit (algebraMap D (Localization.AtPrime 𝔫) (σ z)) :=
    IsLocalization.map_units _ (σ z)
  apply hu.mul_left_injective
  dsimp only
  have e1 : z * algebraMap D (Localization.AtPrime 𝔫) (σ z) =
      algebraMap D (Localization.AtPrime 𝔫) (x z) := by
    have h0 := IsLocalization.mk'_spec (Localization.AtPrime 𝔫) (x z) (σ z)
    rwa [hxσ z] at h0
  have e2 : IsLocalization.mk' (Localization.AtPrime (Ideal.comap Θ 𝔫)) t ⟨s, hs𝔔⟩ *
      algebraMap T₀ (Localization.AtPrime (Ideal.comap Θ 𝔫)) s =
      algebraMap T₀ (Localization.AtPrime (Ideal.comap Θ 𝔫)) t :=
    IsLocalization.mk'_spec _ _ _
  rw [e1, ← hs, ← hγ1, ← map_mul, e2, hγ1, ht]

theorem wcpa_dj_llsm_lcl_PT_normal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] [IsDomain P] (σ : ↥W →+* P) (β : ↥W) (f : wcEbntN W β →+* P), wcEbntPres W σ β f → ∀ (μ d : ↥W), μ ∈ IsLocalRing.maximalIdeal ↥W → μ ≠ 0 → d ∈ IsLocalRing.maximalIdeal ↥W → d ≠ 0 → μ * d = β → ∀ z : FractionRing P, _root_.IsIntegral ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) z → z ∈ wcLcPT (f (wcEbntX W β 0)) (σ μ) :=
by
  intro Ω _ _ W hW hWt P _ _ σ β f hpres μ d hμm hμ0 hdm hd0 hβ z hz
  classical
  have hpres' := hpres
  obtain ⟨-, hβ0, hfσ, he⟩ := hpres'

  haveI hNdom : IsDomain (wcEbntN W β) := (wcNd_nodal_poly_normal Ω W β hβ0).1
  haveI hNint : IsIntegrallyClosed (wcEbntN W β) := (wcNd_nodal_poly_normal Ω W β hβ0).2
  have hprime : ∀ (A : Type u) [CommRing A] (p : Ideal A) (Q : Type u) [CommRing Q]
      (e : A →+* Q), wcNdIsHens p Q e → p.IsPrime := by
    intro A _ p Q _ e he
    haveI := he.1
    have hp : p = (IsLocalRing.maximalIdeal Q).comap e := by
      ext t
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he.2.1 t, not_not]
    rw [hp]
    exact Ideal.comap_isPrime e _
  have hfinj : Function.Injective f :=
    (wcpa_dj_lr1k_ebnb_hens_inj (wcEbntN W β) _ (hprime _ _ _ _ he) P f he).1
  have hσinj := wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W P σ β f hpres
  have hιinj : Function.Injective (algebraMap P (FractionRing P)) :=
    IsFractionRing.injective P (FractionRing P)
  have hfC : ∀ w : ↥W, f (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w)) = σ w :=
    fun w => RingHom.congr_fun hfσ w

  have hXYN : wcEbntX W β 0 * wcEbntX W β 1 =
      ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β :
        MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) β := by
    show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
    rw [← map_mul, RingHom.comp_apply, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hXY : f (wcEbntX W β 0) * f (wcEbntX W β 1) = σ μ * σ d := by
    rw [← map_mul σ, hβ, ← map_mul f, hXYN]
    exact RingHom.congr_fun hfσ β
  have hσμ0 : σ μ ≠ 0 := fun h => hμ0 (hσinj (h.trans (map_zero σ).symm))
  have hσd0 : σ d ≠ 0 := fun h => hd0 (hσinj (h.trans (map_zero σ).symm))
  have hX0 : f (wcEbntX W β 0) ≠ 0 := by
    intro h
    rw [h, zero_mul] at hXY
    exact mul_ne_zero hσμ0 hσd0 hXY.symm
  have hιμ : algebraMap P (FractionRing P) (σ μ) ≠ 0 :=
    fun h => hσμ0 (hιinj (h.trans (map_zero _).symm))
  have hιX : algebraMap P (FractionRing P) (f (wcEbntX W β 0)) ≠ 0 :=
    fun h => hX0 (hιinj (h.trans (map_zero _).symm))
  have hT0 : wcLcT (f (wcEbntX W β 0)) (σ μ) ≠ 0 := by
    show algebraMap P (FractionRing P) (f (wcEbntX W β 0)) /
      algebraMap P (FractionRing P) (σ μ) ≠ 0
    exact div_ne_zero hιX hιμ
  have hTmul : wcLcT (f (wcEbntX W β 0)) (σ μ) * algebraMap P (FractionRing P) (σ μ) =
      algebraMap P (FractionRing P) (f (wcEbntX W β 0)) := by
    show algebraMap P (FractionRing P) (f (wcEbntX W β 0)) /
      algebraMap P (FractionRing P) (σ μ) * algebraMap P (FractionRing P) (σ μ) = _
    exact div_mul_cancel₀ _ hιμ
  have hιXY : algebraMap P (FractionRing P) (f (wcEbntX W β 0)) *
      algebraMap P (FractionRing P) (f (wcEbntX W β 1)) =
      algebraMap P (FractionRing P) (σ μ) * algebraMap P (FractionRing P) (σ d) := by
    rw [← map_mul, hXY, map_mul]
  obtain ⟨t, htval⟩ : ∃ t : (FractionRing P)ˣ,
      (t : FractionRing P) = wcLcT (f (wcEbntX W β 0)) (σ μ) := ⟨Units.mk0 _ hT0, rfl⟩
  have htmem : (t : FractionRing P) ∈ wcLcPT (f (wcEbntX W β 0)) (σ μ) := by
    rw [htval]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
  have htimem : (t : FractionRing P)⁻¹ ∈ wcLcPT (f (wcEbntX W β 0)) (σ μ) := by
    rw [htval]; exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))

  haveI hBint : IsIntegrallyClosed (LaurentPolynomial ↥W) := by
    have hM : Submonoid.powers (Polynomial.X : Polynomial ↥W) ≤ nonZeroDivisors _ :=
      powers_le_nonZeroDivisors_of_noZeroDivisors Polynomial.X_ne_zero
    exact isIntegrallyClosed_of_isLocalization (R := Polynomial ↥W) (S := LaurentPolynomial ↥W)
      (Submonoid.powers Polynomial.X) hM

  let e0 : MvPolynomial (Fin 2) ↥W →+* LaurentPolynomial ↥W :=
    MvPolynomial.eval₂Hom LaurentPolynomial.C
      ![LaurentPolynomial.C μ * LaurentPolynomial.T 1, LaurentPolynomial.C d * LaurentPolynomial.T (-1)]
  have he0 : e0 (MvPolynomial.X 0) = LaurentPolynomial.C μ * LaurentPolynomial.T 1 := by
    simp [e0]
  have he1 : e0 (MvPolynomial.X 1) = LaurentPolynomial.C d * LaurentPolynomial.T (-1) := by
    simp [e0]
  have heC : ∀ w, e0 (MvPolynomial.C w) = LaurentPolynomial.C w := fun w => by
    simp [e0]
  have hespan : ∀ x ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β} :
      Ideal (MvPolynomial (Fin 2) ↥W)), e0 x = 0 := by
    intro x hx
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, map_sub, map_mul, he0, he1, heC, ← hβ, map_mul]
    have hT : (LaurentPolynomial.T 1 : LaurentPolynomial ↥W) * LaurentPolynomial.T (-1) = 1 := by
      rw [← LaurentPolynomial.T_add]; norm_num
    have : LaurentPolynomial.C μ * LaurentPolynomial.T 1 * (LaurentPolynomial.C d * LaurentPolynomial.T (-1))
        - LaurentPolynomial.C μ * LaurentPolynomial.C d = (0 : LaurentPolynomial ↥W) := by
      linear_combination (LaurentPolynomial.C μ * LaurentPolynomial.C d) * hT
    rw [this, mul_zero]
  obtain ⟨τ, hτ⟩ : ∃ τ : wcEbntN W β →+* LaurentPolynomial ↥W, ∀ x, τ (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β :
        MvPolynomial (Fin 2) ↥W)}) x) = e0 x :=
    ⟨Ideal.Quotient.lift _ e0 hespan, fun x => Ideal.Quotient.lift_mk _ e0 hespan⟩
  have hτC : τ.comp ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) = LaurentPolynomial.C := by
    apply RingHom.ext
    intro w
    rw [RingHom.comp_apply, RingHom.comp_apply, hτ, heC]
  have hτX0 : τ (wcEbntX W β 0) = LaurentPolynomial.C μ * LaurentPolynomial.T 1 := by
    rw [← he0]; exact hτ _

  obtain ⟨ψ0, hψ0⟩ : ∃ ψ0 : LaurentPolynomial ↥W →+* FractionRing P,
      ψ0 = LaurentPolynomial.eval₂ ((algebraMap P (FractionRing P)).comp σ) t := ⟨_, rfl⟩
  have hψC : ∀ a, ψ0 (LaurentPolynomial.C a) = algebraMap P (FractionRing P) (σ a) := by
    intro a
    rw [hψ0, LaurentPolynomial.eval₂_C]
    rfl
  have hψT : ∀ k : ℤ, ψ0 (LaurentPolynomial.T k) = ((t ^ k : (FractionRing P)ˣ) : FractionRing P) := by
    intro k
    rw [hψ0, LaurentPolynomial.eval₂_T]
  have hψT1 : ψ0 (LaurentPolynomial.T 1) = (t : FractionRing P) := by
    rw [hψT, zpow_one]
  have hψmem : ∀ L, ψ0 L ∈ wcLcPT (f (wcEbntX W β 0)) (σ μ) := by
    intro L
    induction L using LaurentPolynomial.induction_on' with
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | C_mul_T n a =>
      rw [map_mul, hψC, hψT]
      refine Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ (σ a)) ?_
      rcases Int.eq_nat_or_neg n with ⟨m, rfl | rfl⟩
      · rw [zpow_natCast, Units.val_pow_eq_pow_val]
        exact Subalgebra.pow_mem _ htmem m
      · rw [zpow_neg, zpow_natCast, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val, ← inv_pow]
        exact Subalgebra.pow_mem _ htimem m
  let ψ : LaurentPolynomial ↥W →+* ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) :=
    ψ0.codRestrict (wcLcPT (f (wcEbntX W β 0)) (σ μ)) hψmem

  have hcomp : ψ.comp τ = (algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))).comp f := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      apply Subtype.ext
      show ψ0 (τ (Ideal.Quotient.mk _ (MvPolynomial.C w))) =
        algebraMap P (FractionRing P) (f (Ideal.Quotient.mk _ (MvPolynomial.C w)))
      rw [hτ, heC, hψC, hfC]
    · intro i
      fin_cases i
      · apply Subtype.ext
        show ψ0 (τ (Ideal.Quotient.mk _ (MvPolynomial.X 0))) =
          algebraMap P (FractionRing P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
        rw [hτ, he0, map_mul, hψC, hψT1, htval, mul_comm]
        exact hTmul
      · apply Subtype.ext
        show ψ0 (τ (Ideal.Quotient.mk _ (MvPolynomial.X 1))) =
          algebraMap P (FractionRing P) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
        rw [hτ, he1, map_mul, hψC, hψT, zpow_neg_one, Units.val_inv_eq_inv_val, htval, eq_comm,
          ← div_eq_mul_inv, eq_div_iff hT0]
        apply mul_right_cancel₀ hιμ
        have h1 : algebraMap P (FractionRing P) (f (Ideal.Quotient.mk (Ideal.span
            {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)})
            (MvPolynomial.X 1))) = algebraMap P (FractionRing P) (f (wcEbntX W β 1)) := rfl
        rw [h1]
        linear_combination (algebraMap P (FractionRing P) (f (wcEbntX W β 1))) * hTmul + hιXY

  have hC : (LaurentPolynomial.C μ : LaurentPolynomial ↥W) ≠ 0 := by
    intro h
    rw [← Polynomial.toLaurent_C, ← map_zero (Polynomial.toLaurent (R := ↥W))] at h
    have h' := Polynomial.toLaurent_injective h
    rw [Polynomial.C_eq_zero] at h'
    exact hμ0 h'
  have hψ0inj : Function.Injective ψ0 := by
    rw [injective_iff_map_eq_zero]
    intro L hL
    obtain ⟨n, g, hg⟩ := LaurentPolynomial.exists_T_pow L
    have h2 : ψ0.comp (Polynomial.toLaurent : Polynomial ↥W →+* LaurentPolynomial ↥W) =
        Polynomial.eval₂RingHom ((algebraMap P (FractionRing P)).comp σ) (t : FractionRing P) := by
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, Polynomial.toLaurent_C, hψC, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C, RingHom.comp_apply]
      · rw [RingHom.comp_apply, Polynomial.toLaurent_X, hψT1, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_X]
    have hg0 : Polynomial.eval₂ ((algebraMap P (FractionRing P)).comp σ) (t : FractionRing P) g = 0 := by
      have h1 : ψ0 (Polynomial.toLaurent g) = 0 := by rw [hg, map_mul, hL, zero_mul]
      have h3 := RingHom.congr_fun h2 g
      rw [RingHom.comp_apply, h1, Polynomial.coe_eval₂RingHom] at h3
      exact h3.symm
    have hD := Polynomial.scaleRoots_eval₂_mul (p := g) ((algebraMap P (FractionRing P)).comp σ)
      (t : FractionRing P) μ
    rw [hg0, mul_zero] at hD
    have hfμt : ((algebraMap P (FractionRing P)).comp σ) μ * (t : FractionRing P) =
        algebraMap P (FractionRing P) (f (wcEbntX W β 0)) := by
      rw [RingHom.comp_apply, htval, mul_comm]; exact hTmul
    rw [hfμt] at hD
    have hE := Polynomial.hom_eval₂ (g.scaleRoots μ) σ (algebraMap P (FractionRing P))
      (f (wcEbntX W β 0))
    rw [hD] at hE
    have hE2 : Polynomial.eval₂ σ (f (wcEbntX W β 0)) (g.scaleRoots μ) = 0 :=
      hιinj (hE.trans (map_zero _).symm)
    have hF := Polynomial.hom_eval₂ (g.scaleRoots μ)
      ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β :
        MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) f (wcEbntX W β 0)
    rw [hfσ, hE2] at hF
    have hF2 : Polynomial.eval₂ ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) (wcEbntX W β 0)
        (g.scaleRoots μ) = 0 :=
      hfinj (hF.trans (map_zero _).symm)
    have hG := Polynomial.hom_eval₂ (g.scaleRoots μ)
      ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β :
        MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) τ (wcEbntX W β 0)
    rw [hF2, map_zero, hτC, hτX0,
      Polynomial.scaleRoots_eval₂_mul (p := g) LaurentPolynomial.C (LaurentPolynomial.T 1) μ] at hG
    have htoL : Polynomial.eval₂ LaurentPolynomial.C (LaurentPolynomial.T 1) g =
        Polynomial.toLaurent g := by
      have h4 : (Polynomial.toLaurent : Polynomial ↥W →+* LaurentPolynomial ↥W) =
          Polynomial.eval₂RingHom LaurentPolynomial.C (LaurentPolynomial.T 1) := by
        apply Polynomial.ringHom_ext
        · intro a
          rw [Polynomial.toLaurent_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        · rw [Polynomial.toLaurent_X, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      rw [h4, Polynomial.coe_eval₂RingHom]
    rw [htoL] at hG
    have hg1 : Polynomial.toLaurent g = 0 :=
      (mul_eq_zero.mp hG.symm).resolve_left (pow_ne_zero _ hC)
    rw [hg1] at hg
    exact ((LaurentPolynomial.isUnit_T (n : ℤ)).mul_left_eq_zero).mp hg.symm
  have hψinj : Function.Injective ψ := by
    intro x y hxy
    apply hψ0inj
    exact congrArg Subtype.val hxy

  have hPTeq : wcLcPT (f (wcEbntX W β 0)) (σ μ) =
      Algebra.adjoin P {(t : FractionRing P), (t : FractionRing P)⁻¹} := by
    rw [htval]
  have hrep : ∀ x : FractionRing P, x ∈ Algebra.adjoin P {(t : FractionRing P), (t : FractionRing P)⁻¹} →
      ∃ L : LaurentPolynomial P, LaurentPolynomial.eval₂ (algebraMap P (FractionRing P)) t L = x := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨LaurentPolynomial.T 1, by rw [LaurentPolynomial.eval₂_T, zpow_one]⟩
      · refine ⟨LaurentPolynomial.T (-1), ?_⟩
        rw [LaurentPolynomial.eval₂_T, zpow_neg_one, Units.val_inv_eq_inv_val]
    | algebraMap p => exact ⟨LaurentPolynomial.C p, LaurentPolynomial.eval₂_C _ _ _⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨L, hL⟩ := ihx
      obtain ⟨L', hL'⟩ := ihy
      exact ⟨L + L', by rw [map_add, hL, hL']⟩
    | mul x y _ _ ihx ihy =>
      obtain ⟨L, hL⟩ := ihx
      obtain ⟨L', hL'⟩ := ihy
      exact ⟨L * L', by rw [map_mul, hL, hL']⟩
  have hsum : ∀ L : LaurentPolynomial P, ∃ (n : ℕ) (p : Fin n → P) (a : Fin n → LaurentPolynomial ↥W),
      LaurentPolynomial.eval₂ (algebraMap P (FractionRing P)) t L =
        ∑ i, algebraMap P (FractionRing P) (p i) * ψ0 (a i) := by
    intro L
    induction L using LaurentPolynomial.induction_on' with
    | add p q hp hq =>
      obtain ⟨n, p1, a1, h1⟩ := hp
      obtain ⟨m, p2, a2, h2⟩ := hq
      refine ⟨n + m, Fin.append p1 p2, Fin.append a1 a2, ?_⟩
      rw [map_add, h1, h2, Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]
    | C_mul_T k c =>
      refine ⟨1, ![c], ![LaurentPolynomial.T k], ?_⟩
      rw [Fin.sum_univ_one]
      simp only [Matrix.cons_val_zero]
      rw [map_mul, LaurentPolynomial.eval₂_C, LaurentPolynomial.eval₂_T, hψT]
  have hgen : ∀ w : ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)), ∃ (n : ℕ) (p : Fin n → P)
      (a : Fin n → LaurentPolynomial ↥W),
      w = ∑ i, algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) (p i) * ψ (a i) := by
    intro w
    have hw : (w : FractionRing P) ∈
        Algebra.adjoin P {(t : FractionRing P), (t : FractionRing P)⁻¹} := hPTeq ▸ w.2
    obtain ⟨L, hL⟩ := hrep _ hw
    obtain ⟨n, p, a, hpa⟩ := hsum L
    refine ⟨n, p, a, ?_⟩
    apply Subtype.ext
    rw [← hL, hpa]
    push_cast
    rfl

  have hPTint : IsIntegrallyClosed ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) :=
    wcpa_dj_llsm_isirnd_normal_of_etale_approx (wcEbntN W β) (LaurentPolynomial ↥W) P
      ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) τ f
      (algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))) ψ hcomp hψinj
      (wcNd_hne_etale_approx (wcEbntN W β) _ P f he) hgen
  haveI := hPTint
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff
    (R := ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))) (K := FractionRing P)).mp hz
  rw [← hy]
  exact y.2

theorem wcpa_dj_llsm_lc_laurent_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P : Type u) [CommRing P] [IsDomain P] (σ : ↥W →+* P) (β : ↥W) (f : wcEbntN W β →+* P),
    wcEbntPres W σ β f → ∀ (μ d : ↥W), μ ∈ IsLocalRing.maximalIdeal ↥W → μ ≠ 0 →
    d ∈ IsLocalRing.maximalIdeal ↥W → d ≠ 0 → μ * d = β →
    (∀ z : FractionRing P, _root_.IsIntegral ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) z →
      z ∈ wcLcPT (f (wcEbntX W β 0)) (σ μ)) ∧
    ∃ ψ : ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) ⧸
        ((IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))).comp σ)).radical ≃+*
        LaurentPolynomial (IsLocalRing.ResidueField ↥W),
      ∀ w : ↥W, ψ (Ideal.Quotient.mk _ (algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) (σ w))) =
        LaurentPolynomial.C (IsLocalRing.residue ↥W w) :=
by
  intro Ω _ _ W hW hWt P _ _ σ β f hpres μ d hμm hμ0 hdm hd0 hβ
  classical
  refine ⟨wcpa_dj_llsm_lcl_PT_normal Ω W hW hWt P σ β f hpres μ d hμm hμ0 hdm hd0 hβ, ?_⟩
  have hpres' := hpres
  obtain ⟨-, -, hfσ, -⟩ := hpres'
  obtain ⟨r, hrσ, hrX, hrY, hrz⟩ := wcpa_dj_llsm_lcl_residue Ω W P σ β f hpres
  obtain ⟨ρ, hρp, hρT⟩ := wcpa_dj_llsm_lcl_fibre_map Ω W hW hWt P σ β f hpres μ d hμm hμ0 hdm
    hd0 hβ r hrσ hrX hrY

  have htmem : wcLcT (f (wcEbntX W β 0)) (σ μ) ∈ wcLcPT (f (wcEbntX W β 0)) (σ μ) :=
    Algebra.subset_adjoin (by simp)
  have htimem : (wcLcT (f (wcEbntX W β 0)) (σ μ))⁻¹ ∈ wcLcPT (f (wcEbntX W β 0)) (σ μ) :=
    Algebra.subset_adjoin (by simp)
  have ht0 : wcLcT (f (wcEbntX W β 0)) (σ μ) ≠ 0 := by
    intro h
    have h1 : (⟨wcLcT (f (wcEbntX W β 0)) (σ μ), htmem⟩ :
        ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))) = 0 := Subtype.ext h
    have h2 := hρT
    rw [h1, map_zero] at h2
    exact (LaurentPolynomial.isUnit_T (R := IsLocalRing.ResidueField ↥W) 1).ne_zero h2.symm
  let u : (↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)))ˣ :=
    ⟨⟨wcLcT (f (wcEbntX W β 0)) (σ μ), htmem⟩, ⟨(wcLcT (f (wcEbntX W β 0)) (σ μ))⁻¹, htimem⟩,
      Subtype.ext (mul_inv_cancel₀ ht0), Subtype.ext (inv_mul_cancel₀ ht0)⟩

  have hXYN : wcEbntX W β 0 * wcEbntX W β 1 =
      ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β :
        MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) β := by
    show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
    rw [← map_mul, RingHom.comp_apply, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hXY : f (wcEbntX W β 0) * f (wcEbntX W β 1) = σ μ * σ d := by
    rw [← map_mul σ, hβ, ← map_mul f, hXYN]
    exact RingHom.congr_fun hfσ β
  have hσμ : algebraMap P (FractionRing P) (σ μ) ≠ 0 := by
    intro h
    apply ht0
    show algebraMap P (FractionRing P) (f (wcEbntX W β 0)) /
      algebraMap P (FractionRing P) (σ μ) = 0
    rw [h, div_zero]
  have hX0 : algebraMap P (FractionRing P) (f (wcEbntX W β 0)) ≠ 0 := by
    intro h
    apply ht0
    show algebraMap P (FractionRing P) (f (wcEbntX W β 0)) /
      algebraMap P (FractionRing P) (σ μ) = 0
    rw [h, zero_div]
  have hXt : algebraMap P (FractionRing P) (f (wcEbntX W β 0)) =
      algebraMap P (FractionRing P) (σ μ) * wcLcT (f (wcEbntX W β 0)) (σ μ) := by
    show _ = _ * (_ / _)
    field_simp
  have hYt : algebraMap P (FractionRing P) (f (wcEbntX W β 1)) =
      algebraMap P (FractionRing P) (σ d) * (wcLcT (f (wcEbntX W β 0)) (σ μ))⁻¹ := by
    have h1 : algebraMap P (FractionRing P) (f (wcEbntX W β 0)) *
        algebraMap P (FractionRing P) (f (wcEbntX W β 1)) =
        algebraMap P (FractionRing P) (σ μ) * algebraMap P (FractionRing P) (σ d) := by
      have h2 := congrArg (algebraMap P (FractionRing P)) hXY
      simpa only [map_mul] using h2
    show _ = _ * (_ / _)⁻¹
    rw [inv_div, mul_div_assoc', eq_div_iff hX0]
    linear_combination h1

  set σ' : ↥W →+* ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) :=
    (algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))).comp σ with hσ'
  set I : Ideal ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) :=
    (IsLocalRing.maximalIdeal ↥W).map σ' with hI
  have hXI : algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) (f (wcEbntX W β 0)) ∈ I := by
    have e : algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) (f (wcEbntX W β 0)) =
        σ' μ * (u : ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))) := Subtype.ext hXt
    rw [e]
    exact I.mul_mem_right _ (Ideal.mem_map_of_mem σ' hμm)
  have hYI : algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) (f (wcEbntX W β 1)) ∈ I := by
    have e : algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) (f (wcEbntX W β 1)) =
        σ' d * ((u⁻¹ : (↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)))ˣ) :
          ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))) := Subtype.ext hYt
    rw [e]
    exact I.mul_mem_right _ (Ideal.mem_map_of_mem σ' hdm)
  have hJ : Ideal.span {f (wcEbntX W β 0), f (wcEbntX W β 1)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map σ ≤
      I.comap (algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ))) := by
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | rfl
      · exact hXI
      · exact hYI
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact Ideal.mem_map_of_mem σ' hw

  have hrep : ∀ z : ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)), ∃ L : LaurentPolynomial ↥W,
      z - LaurentPolynomial.eval₂ σ' u L ∈ I := by
    rintro ⟨z, hz⟩
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · refine ⟨LaurentPolynomial.T 1, ?_⟩
        rw [LaurentPolynomial.eval₂_T, zpow_one]
        convert I.zero_mem using 1
        exact sub_eq_zero.mpr rfl
      · refine ⟨LaurentPolynomial.T (-1), ?_⟩
        rw [LaurentPolynomial.eval₂_T, zpow_neg_one]
        convert I.zero_mem using 1
        exact sub_eq_zero.mpr rfl
    | algebraMap p =>
      obtain ⟨w, hw⟩ := hrz p
      refine ⟨LaurentPolynomial.C w, ?_⟩
      rw [LaurentPolynomial.eval₂_C]
      have h1 := hJ hw
      rw [Ideal.mem_comap, map_sub] at h1
      exact h1
    | add x y hx hy ihx ihy =>
      obtain ⟨L, hL⟩ := ihx
      obtain ⟨L', hL'⟩ := ihy
      refine ⟨L + L', ?_⟩
      convert I.add_mem hL hL' using 1
      rw [map_add]
      apply Subtype.ext
      simp only [Subalgebra.coe_add, Subalgebra.coe_sub]
      ring
    | mul x y hx hy ihx ihy =>
      obtain ⟨L, hL⟩ := ihx
      obtain ⟨L', hL'⟩ := ihy
      refine ⟨L * L', ?_⟩
      convert I.add_mem (I.mul_mem_right ⟨y, hy⟩ hL)
        (I.mul_mem_left (LaurentPolynomial.eval₂ σ' u L) hL') using 1
      rw [map_mul]
      apply Subtype.ext
      simp only [Subalgebra.coe_add, Subalgebra.coe_sub, Subalgebra.coe_mul]
      ring
  have hρσ : ρ.comp σ' = LaurentPolynomial.C.comp (IsLocalRing.residue ↥W) := by
    apply RingHom.ext
    intro w
    show ρ (algebraMap P ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) (σ w)) =
      LaurentPolynomial.C (IsLocalRing.residue ↥W w)
    rw [hρp, ← RingHom.comp_apply r σ, hrσ]
  obtain ⟨hker, hsurj⟩ := wcpa_dj_llsm_lcl_fibre_kernel Ω W
    ↥(wcLcPT (f (wcEbntX W β 0)) (σ μ)) σ' u ρ hρσ hρT hrep
  haveI : IsDomain (LaurentPolynomial (IsLocalRing.ResidueField ↥W)) := inferInstance
  have hprime : (RingHom.ker ρ).IsPrime := RingHom.ker_isPrime ρ
  have hrad : I.radical = RingHom.ker ρ := by rw [hI, ← hker, hprime.radical]
  refine ⟨(Ideal.quotEquivOfEq hrad).trans (RingHom.quotientKerEquivOfSurjective hsurj), ?_⟩
  intro w
  rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk, hρp, ← RingHom.comp_apply r σ, hrσ]

theorem wcpa_dj_llsm_lc_fibre_compare : ∀ (R O D P : Type u) [CommRing R] [CommRing O] [IsLocalRing O]
    [CommRing D] [CommRing P] [IsLocalRing P] (σ : R →+* O) (θ : O →+* D) (κ : O →+* P)
    (𝔪 : Ideal R),
    𝔪.map σ ≤ IsLocalRing.maximalIdeal O →
    Ideal.map κ (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal P →
    (∀ z : P, ∃ a : O, ¬ IsUnit (z - κ a)) →
    (∀ 𝔓 : Ideal D, 𝔓.IsPrime → (𝔪.map σ).map θ ≤ 𝔓 →
      (IsLocalRing.maximalIdeal O).map θ ≤ 𝔓) →
    letI iD : Algebra O D := θ.toAlgebra
    letI iP : Algebra O P := κ.toAlgebra
    ∃ e : D ⧸ ((𝔪.map σ).map θ).radical ≃+*
        TensorProduct O D P ⧸ ((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical,
      ∀ d : D, e (Ideal.Quotient.mk _ d) = Ideal.Quotient.mk _ (TensorProduct.tmul O d (1 : P)) :=
by
  intro R O D P _ _ _ _ _ _ σ θ κ 𝔪 h1 h2 h3 h4
  letI iD : Algebra O D := θ.toAlgebra
  letI iP : Algebra O P := κ.toAlgebra
  let iL : D →+* TensorProduct O D P := Algebra.TensorProduct.includeLeftRingHom
  let iR : P →+* TensorProduct O D P :=
    (Algebra.TensorProduct.includeRight : P →ₐ[O] TensorProduct O D P).toRingHom
  have hiL : ∀ d : D, iL d = TensorProduct.tmul O d (1 : P) := fun d => rfl
  have hiR : ∀ p : P, iR p = TensorProduct.tmul O (1 : D) p := fun p => rfl
  have Id1 : iL.comp θ = algebraMap O (TensorProduct O D P) := by
    ext r
    rw [RingHom.comp_apply, hiL, Algebra.TensorProduct.algebraMap_apply]
    rfl
  have Id2 : iR.comp κ = algebraMap O (TensorProduct O D P) := by
    ext r
    rw [RingHom.comp_apply, hiR, Algebra.TensorProduct.algebraMap_apply']
    rfl
  have hmapL : ∀ I : Ideal O, (I.map θ).map iL = I.map (algebraMap O (TensorProduct O D P)) := by
    intro I; rw [Ideal.map_map, Id1]

  have R1 : (IsLocalRing.maximalIdeal O).map θ ≤ ((𝔪.map σ).map θ).radical := by
    rw [Ideal.radical_eq_sInf]
    exact le_sInf fun J ⟨hJ, hJp⟩ => h4 J hJp hJ
  have R2 : (IsLocalRing.maximalIdeal O).map (algebraMap O (TensorProduct O D P)) ≤
      ((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical := by
    rw [← hmapL, ← hmapL]
    exact (Ideal.map_mono R1).trans (Ideal.map_radical_le iL)

  have hnu : ∀ p : P, ¬ IsUnit p → p ∈ IsLocalRing.maximalIdeal P := fun p hp =>
    (IsLocalRing.mem_maximalIdeal p).mpr (mem_nonunits_iff.mpr hp)
  have hH : IsLocalRing.maximalIdeal O ≤ (IsLocalRing.maximalIdeal P).comap κ :=
    Ideal.map_le_iff_le_comap.mp h2.le
  let κb : O ⧸ IsLocalRing.maximalIdeal O →+* P ⧸ IsLocalRing.maximalIdeal P :=
    Ideal.quotientMap _ κ hH
  have κinj : Function.Injective κb := by
    apply Ideal.quotientMap_injective'
    exact IsLocalRing.le_maximalIdeal
      (Ideal.comap_ne_top κ (IsLocalRing.maximalIdeal.isMaximal P).ne_top)
  have κsurj : Function.Surjective κb := by
    intro y
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, ha⟩ := h3 p
    refine ⟨Ideal.Quotient.mk _ a, ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq, ← neg_sub]
    exact neg_mem (hnu _ ha)
  let E : O ⧸ IsLocalRing.maximalIdeal O ≃+* P ⧸ IsLocalRing.maximalIdeal P :=
    RingEquiv.ofBijective κb ⟨κinj, κsurj⟩
  let r : P →+* O ⧸ IsLocalRing.maximalIdeal O :=
    E.symm.toRingHom.comp (Ideal.Quotient.mk _)
  have hr : ∀ (p : P) (a : O), ¬ IsUnit (p - κ a) →
      r p = Ideal.Quotient.mk (IsLocalRing.maximalIdeal O) a := by
    intro p a ha
    have h' : Ideal.Quotient.mk (IsLocalRing.maximalIdeal P) p =
        E (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O) a) := by
      have hE : E (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O) a) =
          κb (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O) a) := rfl
      rw [hE, Ideal.quotientMap_mk, Ideal.Quotient.eq]
      exact hnu _ ha
    show E.symm (Ideal.Quotient.mk (IsLocalRing.maximalIdeal P) p) = _
    rw [h', RingEquiv.symm_apply_apply]

  have hq : IsLocalRing.maximalIdeal O ≤ (((𝔪.map σ).map θ).radical).comap θ :=
    Ideal.map_le_iff_le_comap.mp R1
  let q : O ⧸ IsLocalRing.maximalIdeal O →+* D ⧸ ((𝔪.map σ).map θ).radical :=
    Ideal.quotientMap _ θ hq
  let g₀ : P →+* D ⧸ ((𝔪.map σ).map θ).radical := q.comp r
  have hg₀ : ∀ (p : P) (a : O), ¬ IsUnit (p - κ a) → g₀ p = Ideal.Quotient.mk _ (θ a) := by
    intro p a ha
    show q (r p) = _
    rw [hr p a ha]
    exact Ideal.quotientMap_mk ..
  let g : P →ₐ[O] D ⧸ ((𝔪.map σ).map θ).radical :=
    { g₀ with
      commutes' := fun a => by
        show g₀ (κ a) = _
        rw [hg₀ (κ a) a (by rw [sub_self]; exact not_isUnit_zero)]
        exact Ideal.Quotient.mk_algebraMap .. }
  have hgp : ∀ p : P, g p = g₀ p := fun p => rfl

  let χ : TensorProduct O D P →ₐ[O] D ⧸ ((𝔪.map σ).map θ).radical :=
    Algebra.TensorProduct.lift (Ideal.Quotient.mkₐ O _) g (fun _ _ => Commute.all _ _)
  have hχ : ∀ (d : D) (p : P), χ (TensorProduct.tmul O d p) = Ideal.Quotient.mk _ d * g p := by
    intro d p
    rw [Algebra.TensorProduct.lift_tmul]
    rfl
  have hIS_ker : ∀ x ∈ (𝔪.map σ).map (algebraMap O (TensorProduct O D P)), χ x = 0 := by
    intro x hx
    have hle : (𝔪.map σ).map (algebraMap O (TensorProduct O D P)) ≤ RingHom.ker χ := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, ← Ideal.Quotient.mk_algebraMap,
        Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.le_radical (Ideal.mem_map_of_mem θ ha)
    exact hle hx
  have hkill : ∀ x ∈ ((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical,
      χ.toRingHom x = 0 := by
    intro x hx
    obtain ⟨n, hn⟩ := hx
    have h0 : χ x ^ n = 0 := by rw [← map_pow]; exact hIS_ker _ hn
    obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (χ x)
    rw [← hd, ← map_pow, Ideal.Quotient.eq_zero_iff_mem] at h0
    show χ x = 0
    rw [← hd, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_radical_of_pow_mem h0
  let G : TensorProduct O D P ⧸ ((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical →+*
      D ⧸ ((𝔪.map σ).map θ).radical :=
    Ideal.Quotient.lift _ χ.toRingHom hkill

  have hF : ((𝔪.map σ).map θ).radical ≤
      (((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical).comap iL := by
    rw [Ideal.comap_radical]
    apply Ideal.radical_mono
    rw [← Ideal.map_le_iff_le_comap, hmapL]
  let F : D ⧸ ((𝔪.map σ).map θ).radical →+*
      TensorProduct O D P ⧸ ((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical :=
    Ideal.quotientMap _ iL hF
  have hFmk : ∀ d : D, F (Ideal.Quotient.mk _ d) =
      Ideal.Quotient.mk _ (TensorProduct.tmul O d (1 : P)) :=
    fun d => Ideal.quotientMap_mk ..
  have hGmk : ∀ s, G (Ideal.Quotient.mk _ s) = χ s := fun s => Ideal.Quotient.lift_mk ..
  have hGF : G.comp F = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    ext d
    rw [RingHom.comp_apply, RingHom.comp_apply, hFmk, hGmk, hχ, map_one, mul_one,
      RingHom.comp_apply, RingHom.id_apply]
  have hFG : F.comp G = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    refine RingHom.ext fun s => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, hGmk, RingHom.comp_apply, RingHom.id_apply]
    induction s using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
    | tmul d p =>
      obtain ⟨a, ha⟩ := h3 p
      have e1 : TensorProduct.tmul O (θ a) (1 : P) = TensorProduct.tmul O (1 : D) (κ a) := by
        have h1' : θ a = a • (1 : D) := Algebra.algebraMap_eq_smul_one a
        have h2' : κ a = a • (1 : P) := Algebra.algebraMap_eq_smul_one a
        rw [h1', h2', TensorProduct.smul_tmul]
      have hmem : TensorProduct.tmul O (1 : D) p - TensorProduct.tmul O (θ a) (1 : P) ∈
          ((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical := by
        rw [e1, ← TensorProduct.tmul_sub]
        apply R2
        have hpm : p - κ a ∈ Ideal.map κ (IsLocalRing.maximalIdeal O) := by
          rw [h2]; exact hnu _ ha
        have hh := Ideal.mem_map_of_mem iR hpm
        rw [Ideal.map_map, Id2] at hh
        exact hh
      have hmk : Ideal.Quotient.mk (((𝔪.map σ).map
            (algebraMap O (TensorProduct O D P))).radical) (TensorProduct.tmul O (θ a) (1 : P)) =
          Ideal.Quotient.mk _ (TensorProduct.tmul O (1 : D) p) :=
        (Ideal.Quotient.eq.mpr hmem).symm
      rw [hχ, map_mul, hgp, hg₀ p a ha, hFmk, hFmk, hmk, ← map_mul,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  refine ⟨RingEquiv.ofRingHom F G hFG hGF, fun d => ?_⟩
  exact hFmk d

theorem wcpa_dj_llsm_lcd_hens_flat : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsIntegrallyClosed O] (p : Ideal O), p.IsPrime → ∀ (P : Type u) [CommRing P] (κ : O →+* P), wcNdIsHens p P κ → κ.Flat :=
by
  intro O _ _ _ p hp P _ κ hH
  classical
  have hH' := hH
  obtain ⟨hHens, hunit, huniv⟩ := hH'

  have hκinj : Function.Injective κ := by
    obtain ⟨V, _, hV, g, hg, hgu⟩ := wcNd_hne_valuation_witness O p hp
    obtain ⟨h, ⟨hhg, _⟩, _⟩ := huniv V hV g hgu
    intro a b hab
    apply hg
    rw [← hhg, RingHom.comp_apply, RingHom.comp_apply, hab]
  letI : Algebra O P := κ.toAlgebra
  show Module.Flat O P
  apply Module.Flat.of_forall_isTrivialRelation
  intro l f x hrel

  obtain ⟨E, _, _, _, j, hj, hmem⟩ := wcNd_hne_etale_approx O p P κ hH (Finset.univ.image x)
  have hb : ∀ i, ∃ b : E, j b = x i := fun i => by
    obtain ⟨b, hb⟩ := RingHom.mem_range.mp
      (hmem (x i) (Finset.mem_image_of_mem _ (Finset.mem_univ i)))
    exact ⟨b, hb⟩
  choose b hb using hb
  have hjO : ∀ a : O, j (algebraMap O E a) = κ a := fun a => by rw [← hj]; rfl

  let q : Ideal E := (IsLocalRing.maximalIdeal P).comap j
  haveI : q.IsPrime := Ideal.IsPrime.comap j
  have hunits : ∀ s : q.primeCompl, IsUnit (j s) := by
    intro s
    have hs : (s : E) ∉ q := s.2
    by_contra hns
    exact hs (Ideal.mem_comap.mpr ((IsLocalRing.mem_maximalIdeal _).mpr hns))
  let γ : Localization.AtPrime q →+* P := IsLocalization.lift (S := Localization.AtPrime q) hunits
  have hγι : ∀ e : E, γ (algebraMap E (Localization.AtPrime q) e) = j e := fun e =>
    IsLocalization.lift_eq hunits e
  have hγO : ∀ a : O, γ (algebraMap O (Localization.AtPrime q) a) = κ a := by
    intro a
    rw [IsScalarTower.algebraMap_apply O E (Localization.AtPrime q), hγι, hjO]

  have hdom : IsDomain (Localization.AtPrime q) := (wc_pks_etale_localization_normal O E q).1
  have hγinj : Function.Injective γ := by
    apply wcNd_hne_local_injective O E q hdom P γ
    · intro a a' haa
      rw [RingHom.comp_apply, RingHom.comp_apply, hγO, hγO] at haa
      exact hκinj haa
    · exact wcNd_hne_etale_algebraic O E

  haveI : Algebra.Smooth O E := Algebra.Smooth.mk
  haveI : Module.Flat O E := Algebra.Smooth.flat O E
  haveI : Module.Flat O (Localization.AtPrime q) :=
    Module.Flat.trans O E (Localization.AtPrime q)

  have hrel'' : ∑ i, algebraMap O (Localization.AtPrime q) (f i) *
      algebraMap E (Localization.AtPrime q) (b i) = 0 := by
    apply hγinj
    rw [map_zero, map_sum, ← hrel]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def, map_mul, hγO, hγι, hb]
    rfl

  obtain ⟨k, a, y, hy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
    (R := O) (M := Localization.AtPrime q) (f := f)
    (x := fun i => algebraMap E (Localization.AtPrime q) (b i)) (by
      simp only [Algebra.smul_def]
      exact hrel'')
  refine ⟨k, a, fun t => γ (y t), fun i => ?_, ha⟩
  have hyi := hy i
  simp only [Algebra.smul_def] at hyi
  rw [← hb i, ← hγι, hyi, map_sum]
  refine Finset.sum_congr rfl (fun t _ => ?_)
  rw [map_mul, hγO, Algebra.smul_def]
  rfl

theorem wcpa_dj_llsm_lcd_hens_normalization : ∀ (O D L P : Type u) [CommRing O] [IsDomain O] [IsIntegrallyClosed O] [IsLocalRing O] [CommRing D] [Field L] [CommRing P] [Algebra O D] [Algebra O L] [IsFractionRing O L] [Algebra D L] [IsScalarTower O D L] [Algebra O P], wcNdIsHens (IsLocalRing.maximalIdeal O) P (algebraMap O P) → (∀ z : L, IsIntegral D z → ∃ d, algebraMap D L d = z) → ∀ z : TensorProduct O L P, (∃ q : Polynomial (TensorProduct O D P), q.Monic ∧ q.eval₂ (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O P)).toRingHom z = 0) → z ∈ (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O P)).range :=
by
  intro O D L P _ _ _ _ _ _ _ _ _ _ _ _ _ hH hD z hz
  classical
  obtain ⟨q, hqm, hq⟩ := hz

  have hH' := hH
  obtain ⟨hHens, _, huniv⟩ := hH'
  haveI : HenselianLocalRing P := hHens
  have hmprime : (IsLocalRing.maximalIdeal O).IsPrime := (IsLocalRing.maximalIdeal.isMaximal O).isPrime
  have hκinj : Function.Injective (algebraMap O P) := by
    obtain ⟨V, _, hV, g, hg, hgu⟩ := wcNd_hne_valuation_witness O (IsLocalRing.maximalIdeal O) hmprime
    obtain ⟨h, ⟨hhg, _⟩, _⟩ := huniv V hV g hgu
    intro a b hab
    apply hg
    rw [← hhg, RingHom.comp_apply, RingHom.comp_apply, hab]
  haveI : IsDomain P :=
    (wcNd_hens_normal_domain O (IsLocalRing.maximalIdeal O) hmprime P (algebraMap O P) hH).1

  have hLinj : Function.Injective (algebraMap O L) := IsFractionRing.injective O L
  have hgP : Function.Injective (algebraMap P (FractionRing P)) :=
    IsFractionRing.injective P (FractionRing P)
  have hgeq : ∀ a : O, algebraMap O (FractionRing P) a =
      algebraMap P (FractionRing P) (algebraMap O P a) :=
    fun a => IsScalarTower.algebraMap_apply O P (FractionRing P) a
  have hg : Function.Injective (algebraMap O (FractionRing P)) := fun a b h =>
    hκinj (hgP (by rw [← hgeq, ← hgeq]; exact h))
  let jL : L →+* FractionRing P := IsFractionRing.lift hg
  have hjL : ∀ a : O, jL (algebraMap O L a) = algebraMap O (FractionRing P) a := fun a =>
    IsFractionRing.lift_algebraMap hg a
  let jA : L →ₐ[O] FractionRing P := { jL with commutes' := fun a => hjL a }
  let ΨA : TensorProduct O L P →ₐ[O] FractionRing P :=
    Algebra.TensorProduct.lift jA (IsScalarTower.toAlgHom O P (FractionRing P))
      (fun _ _ => Commute.all _ _)
  have hΨ_tmul : ∀ (l : L) (p : P), ΨA (l ⊗ₜ[O] p) = jL l * algebraMap P (FractionRing P) p :=
    fun l p => (Algebra.TensorProduct.lift_tmul _ _ _ l p).trans rfl
  have hzero : ∀ (t : O) (p : P), t ≠ 0 → (algebraMap O L t)⁻¹ ⊗ₜ[O] p = 0 → p = 0 := by
    intro t p ht h
    have hw := congrArg ΨA h
    rw [hΨ_tmul, map_zero, map_inv₀, hjL] at hw
    have hgt : algebraMap O (FractionRing P) t ≠ 0 := fun h0 =>
      ht (hg (h0.trans (map_zero _).symm))
    rcases mul_eq_zero.mp hw with h' | h'
    · exact absurd (inv_eq_zero.mp h') hgt
    · exact hgP (h'.trans (map_zero _).symm)

  have hform : ∀ (M : Type u) [AddCommGroup M] [Module O M] (w : TensorProduct O L M),
      ∃ t : O, t ≠ 0 ∧ ∃ m : M, w = (algebraMap O L t)⁻¹ ⊗ₜ[O] m := by
    intro M _ _ w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨1, one_ne_zero, 0, by rw [TensorProduct.tmul_zero]⟩
    | tmul l p =>
      obtain ⟨a, b, hb, h⟩ := IsFractionRing.div_surjective O l
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      refine ⟨b, hb0, a • p, ?_⟩
      rw [← TensorProduct.smul_tmul]
      have e : a • (algebraMap O L b)⁻¹ = l := by
        rw [Algebra.smul_def, ← h, div_eq_mul_inv]
      rw [e]
    | add w₁ w₂ ih₁ ih₂ =>
      obtain ⟨t, ht, p, rfl⟩ := ih₁
      obtain ⟨t', ht', p', rfl⟩ := ih₂
      have ht0 : algebraMap O L t ≠ 0 := fun h0 => ht (hLinj (h0.trans (map_zero _).symm))
      have ht0' : algebraMap O L t' ≠ 0 := fun h0 => ht' (hLinj (h0.trans (map_zero _).symm))
      refine ⟨t * t', mul_ne_zero ht ht', t' • p + t • p', ?_⟩
      rw [TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
      have e1 : t' • (algebraMap O L (t * t'))⁻¹ = (algebraMap O L t)⁻¹ := by
        rw [Algebra.smul_def, map_mul, mul_inv, mul_left_comm, mul_inv_cancel₀ ht0', mul_one]
      have e2 : t • (algebraMap O L (t * t'))⁻¹ = (algebraMap O L t')⁻¹ := by
        rw [Algebra.smul_def, map_mul, mul_inv, ← mul_assoc, mul_inv_cancel₀ ht0, one_mul]
      rw [e1, e2]

  have hnat : ∀ (E E' : Type u) [CommRing E] [CommRing E'] [Algebra O E] [Algebra O E']
      (f : E →ₐ[O] E') (w : TensorProduct O D E),
      Algebra.TensorProduct.map (AlgHom.id O L) f
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E) w) =
        Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E')
          (Algebra.TensorProduct.map (AlgHom.id O D) f w) := by
    intro E E' _ _ _ _ f w
    induction w using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul d e => simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    | add a b ha hb => simp only [map_add, ha, hb]
  have heval : ∀ (E E' : Type u) [CommRing E] [CommRing E'] [Algebra O E] [Algebra O E']
      (f : E →ₐ[O] E') (x : TensorProduct O L E) (p : Polynomial (TensorProduct O D E)),
      Algebra.TensorProduct.map (AlgHom.id O L) f
          (p.eval₂ (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L)
            (AlgHom.id O E)).toRingHom x) =
        (p.map (Algebra.TensorProduct.map (AlgHom.id O D) f).toRingHom).eval₂
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E')).toRingHom
          (Algebra.TensorProduct.map (AlgHom.id O L) f x) := by
    intro E E' _ _ _ _ f x p
    rw [Polynomial.eval₂_map]
    have h1 := Polynomial.hom_eval₂ p
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E)).toRingHom
      (Algebra.TensorProduct.map (AlgHom.id O L) f).toRingHom x
    have h2 : (Algebra.TensorProduct.map (AlgHom.id O L) f).toRingHom.comp
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E)).toRingHom =
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E')).toRingHom.comp
          (Algebra.TensorProduct.map (AlgHom.id O D) f).toRingHom :=
      RingHom.ext (hnat E E' f)
    rw [h2] at h1
    exact h1

  have hcrux : ∀ (E : Type u) [CommRing E] [Algebra O E] [Algebra.Etale O E]
      (z : TensorProduct O L E),
      (∃ q : Polynomial (TensorProduct O D E), q.Monic ∧
        q.eval₂ (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L)
          (AlgHom.id O E)).toRingHom z = 0) →
      z ∈ (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E)).range := by
    intro E _ _ _ z hzq
    obtain ⟨q, hqm, hq⟩ := hzq
    let χ : TensorProduct D (TensorProduct O D E) L ≃+* TensorProduct O L E :=
      (Algebra.TensorProduct.comm D (TensorProduct O D E) L).toRingEquiv.trans
        (Algebra.TensorProduct.cancelBaseChange O D L L E).toRingEquiv
    set φE := Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E) with hφE
    have hχt : ∀ (s : TensorProduct O D E), χ (s ⊗ₜ[D] (1 : L)) = φE s := by
      intro s
      induction s using TensorProduct.induction_on with
      | zero => rw [TensorProduct.zero_tmul, map_zero, map_zero]
      | tmul d e =>
        show (Algebra.TensorProduct.cancelBaseChange O D L L E)
          ((Algebra.TensorProduct.comm D (TensorProduct O D E) L) ((d ⊗ₜ[O] e) ⊗ₜ[D] (1 : L))) = _
        rw [Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.cancelBaseChange_tmul, hφE,
          Algebra.TensorProduct.map_tmul, IsScalarTower.toAlgHom_apply, AlgHom.id_apply,
          Algebra.algebraMap_eq_smul_one]
      | add a b ha hb => rw [TensorProduct.add_tmul, map_add, map_add, ha, hb]
    have hχ : (χ : TensorProduct D (TensorProduct O D E) L →+* TensorProduct O L E).comp
        (algebraMap (TensorProduct O D E) (TensorProduct D (TensorProduct O D E) L)) =
          φE.toRingHom := by
      apply RingHom.ext
      intro s
      exact hχt s
    set y := χ.symm z with hy
    have hyint : IsIntegral (TensorProduct O D E) y := by
      refine ⟨q, hqm, ?_⟩
      apply χ.injective
      rw [map_zero, ← RingEquiv.coe_toRingHom, Polynomial.hom_eval₂, hχ]
      rw [RingEquiv.coe_toRingHom, hy, RingEquiv.apply_symm_apply]
      exact hq
    obtain ⟨u, hu⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth
      (R := D) (S := TensorProduct O D E) (B := L)).2 ⟨y, hyint⟩
    have hu' : Algebra.TensorProduct.map (AlgHom.id (TensorProduct O D E) (TensorProduct O D E))
        (integralClosure D L).val u = y := congrArg Subtype.val hu
    have hrange : ∀ v : TensorProduct D (TensorProduct O D E) (integralClosure D L),
        ∃ w : TensorProduct O D E,
          algebraMap (TensorProduct O D E) (TensorProduct D (TensorProduct O D E) L) w =
          Algebra.TensorProduct.map (AlgHom.id (TensorProduct O D E) (TensorProduct O D E))
            (integralClosure D L).val v := by
      intro v
      induction v using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [map_zero, map_zero]⟩
      | tmul s c =>
        obtain ⟨d, hd⟩ := hD c.1 c.2
        refine ⟨d • s, ?_⟩
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Subalgebra.coe_val, ← hd,
          Algebra.algebraMap_eq_smul_one d, ← TensorProduct.smul_tmul]
        rfl
      | add a b ha hb =>
        obtain ⟨wa, hwa⟩ := ha
        obtain ⟨wb, hwb⟩ := hb
        exact ⟨wa + wb, by rw [map_add, map_add, hwa, hwb]⟩
    obtain ⟨w, hw⟩ := hrange u
    refine ⟨w, ?_⟩
    show φE w = z
    rw [← hχt w]
    have : w ⊗ₜ[D] (1 : L) = y := by rw [← hu', ← hw]; rfl
    rw [this, hy, RingEquiv.apply_symm_apply]

  have hker : ∀ (E : Type u) [CommRing E] [Algebra O E] [Algebra.Etale O E] (j : E →+* P),
      j.comp (algebraMap O E) = algebraMap O P → ∀ e : E, j e = 0 →
      ∃ s : E, IsUnit (j s) ∧ s * e = 0 := by
    intro E _ _ _ j hj e he
    let 𝔮 : Ideal E := (IsLocalRing.maximalIdeal P).comap j
    haveI : 𝔮.IsPrime := Ideal.comap_isPrime j _
    obtain ⟨hdom, _⟩ := wc_pks_etale_localization_normal O E 𝔮
    have hunitq : ∀ y : 𝔮.primeCompl, IsUnit (j y) := by
      intro y
      have hy : j y ∉ IsLocalRing.maximalIdeal P := y.2
      exact IsLocalRing.notMem_maximalIdeal.mp hy
    let γ : Localization.AtPrime 𝔮 →+* P := IsLocalization.lift hunitq
    have hγ : γ.comp (algebraMap O (Localization.AtPrime 𝔮)) = algebraMap O P := by
      rw [IsScalarTower.algebraMap_eq O E (Localization.AtPrime 𝔮), ← RingHom.comp_assoc,
        IsLocalization.lift_comp, hj]
    have hγinj : Function.Injective γ :=
      wcNd_hne_local_injective O E 𝔮 hdom P γ (by rw [hγ]; exact hκinj)
        (fun y => wcNd_hne_etale_algebraic O E y)
    have h0 : algebraMap E (Localization.AtPrime 𝔮) e = 0 := by
      apply hγinj
      rw [map_zero]
      show IsLocalization.lift hunitq (algebraMap E (Localization.AtPrime 𝔮) e) = 0
      rw [IsLocalization.lift_eq, he]
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff 𝔮.primeCompl _ e).mp h0
    exact ⟨m, hunitq m, hm⟩

  obtain ⟨Sz, hSz⟩ := TensorProduct.exists_finset z
  choose Sc hSc using fun n => TensorProduct.exists_finset (q.coeff n)
  let F : Finset P := Sz.image Prod.snd ∪ q.support.biUnion (fun n => (Sc n).image Prod.snd)
  obtain ⟨E, _, _, _, φ, hφ, hF⟩ :=
    wcNd_hne_etale_approx O (IsLocalRing.maximalIdeal O) P (algebraMap O P) hH F
  have hφa : ∀ a : O, φ (algebraMap O E a) = algebraMap O P a := fun a => RingHom.congr_fun hφ a
  let j : E →ₐ[O] P := { φ with commutes' := hφa }
  have hpre : ∀ p ∈ F, ∃ x : E, φ x = p := fun p hp => RingHom.mem_range.mp (hF p hp)
  have hlift : ∀ (X : Type u) [CommRing X] [Algebra O X] (S : Finset (X × P)),
      (∀ i ∈ S, i.2 ∈ F) → ∃ w : TensorProduct O X E,
        Algebra.TensorProduct.map (AlgHom.id O X) j w = ∑ i ∈ S, i.1 ⊗ₜ[O] i.2 := by
    intro X _ _ S
    induction S using Finset.induction_on with
    | empty => intro _; exact ⟨0, by rw [map_zero, Finset.sum_empty]⟩
    | insert a S ha ih =>
      intro hS
      obtain ⟨w, hw⟩ := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      obtain ⟨x, hx⟩ := hpre a.2 (hS a (Finset.mem_insert_self a S))
      refine ⟨a.1 ⊗ₜ[O] x + w, ?_⟩
      rw [map_add, hw, Algebra.TensorProduct.map_tmul, Finset.sum_insert ha, AlgHom.id_apply]
      show a.1 ⊗ₜ[O] φ x + _ = _
      rw [hx]
  obtain ⟨z', hz'⟩ := hlift L Sz (fun i hi => Finset.mem_union_left _ (Finset.mem_image_of_mem _ hi))
  rw [← hSz] at hz'
  have hcoef : ∀ n, q.coeff n ∈ Set.range (Algebra.TensorProduct.map (AlgHom.id O D) j).toRingHom := by
    intro n
    by_cases hn : n ∈ q.support
    · obtain ⟨w, hw⟩ := hlift D (Sc n) (fun i hi => Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨n, hn, Finset.mem_image_of_mem _ hi⟩))
      exact ⟨w, hw.trans (hSc n).symm⟩
    · rw [Polynomial.notMem_support_iff.mp hn]
      exact ⟨0, map_zero _⟩
  haveI : Nontrivial (TensorProduct O D P) := RingHom.domain_nontrivial
    (ΨA.toRingHom.comp (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O P)).toRingHom)
  obtain ⟨q', hq'map, -, hq'm⟩ := Polynomial.lifts_and_degree_eq_and_monic
    ((Polynomial.lifts_iff_coeff_lifts _).mpr hcoef) hqm
  set r := q'.eval₂ (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L)
    (AlgHom.id O E)).toRingHom z' with hr
  have hrj : Algebra.TensorProduct.map (AlgHom.id O L) j r = 0 := by
    rw [hr, heval E P j z' q', hq'map, hz']
    exact hq
  obtain ⟨t, ht, e, hre⟩ := hform E r
  have hje : φ e = 0 := by
    rw [hre, Algebra.TensorProduct.map_tmul, AlgHom.id_apply] at hrj
    exact hzero t (j e) ht hrj
  obtain ⟨s, hs, hse⟩ := hker E φ hφ e hje

  let E' := Localization.Away s
  haveI : Algebra.Etale O E' := Algebra.Etale.comp O E E'
  let π : E →ₐ[O] E' := IsScalarTower.toAlgHom O E E'
  let j'₀ : E' →+* P := IsLocalization.Away.lift s hs
  have hj'₀ : ∀ x : E, j'₀ (algebraMap E E' x) = φ x := fun x => IsLocalization.Away.lift_eq s hs x
  have hj'a : ∀ a : O, j'₀ (algebraMap O E' a) = algebraMap O P a := by
    intro a
    rw [IsScalarTower.algebraMap_apply O E E', hj'₀, hφa]
  let j' : E' →ₐ[O] P := { j'₀ with commutes' := hj'a }
  have hjj : ∀ x : E, j' (π x) = j x := fun x => hj'₀ x
  have hcompL : ∀ w : TensorProduct O L E, Algebra.TensorProduct.map (AlgHom.id O L) j w =
      Algebra.TensorProduct.map (AlgHom.id O L) j' (Algebra.TensorProduct.map (AlgHom.id O L) π w) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul l x => simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hjj]
    | add a b ha hb => simp only [map_add, ha, hb]
  have hπs : IsUnit (π s) := IsLocalization.Away.algebraMap_isUnit s
  have hπe : π e = 0 := (IsUnit.mul_right_eq_zero hπs).mp (by rw [← map_mul, hse, map_zero])
  have hq''m : (q'.map (Algebra.TensorProduct.map (AlgHom.id O D) π).toRingHom).Monic :=
    hq'm.map _
  have hz''root : (q'.map (Algebra.TensorProduct.map (AlgHom.id O D) π).toRingHom).eval₂
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O E')).toRingHom
      (Algebra.TensorProduct.map (AlgHom.id O L) π z') = 0 := by
    rw [← heval E E' π z' q', ← hr, hre, Algebra.TensorProduct.map_tmul, hπe,
      TensorProduct.tmul_zero]
  obtain ⟨w, hw⟩ := (AlgHom.mem_range _).mp (hcrux E' _ ⟨_, hq''m, hz''root⟩)
  refine (AlgHom.mem_range _).mpr ⟨Algebra.TensorProduct.map (AlgHom.id O D) j' w, ?_⟩
  rw [← hnat E' P j' w, hw, ← hcompL, hz']

theorem wcpa_dj_llsm_lc_descent : ∀ (R O D P L : Type u) [CommRing R] [CommRing O] [IsDomain O]
    [IsIntegrallyClosed O] [IsLocalRing O] [CommRing D] [CommRing P] [IsDomain P] [Field L]
    (σ : R →+* O) (𝔪 : Ideal R) (θ : O →+* D) (κ : O →+* P) (lO : O →+* L) (lD : D →+* L),
    Function.Injective lO → Function.Injective lD → lD.comp θ = lO →
    (∀ z : L, ∃ a b : O, b ≠ 0 ∧ z * lO b = lO a) →
    (∀ (z : L) (p : Polynomial D), p.Monic → p.eval₂ lD z = 0 → ∃ d, lD d = z) →
    wcNdIsHens (IsLocalRing.maximalIdeal O) P κ →
    ∀ (x y : D) (U tₐ : O) (r₁ r₂ : R) (p₁ p₂ η : P) (n : ℕ),
    IsUnit η → 1 ≤ n → σ r₁ ≠ 0 → σ r₂ ≠ 0 →
    x * θ tₐ = θ U → y * θ U = θ tₐ → tₐ = σ r₁ ^ n →
    κ U = η * p₁ ^ n → p₁ * p₂ = κ (σ r₁ * σ r₂) →
    (∀ z : D, ∃ p : Polynomial D, p.Monic ∧
      (∀ i, p.coeff i ∈ Subring.closure (Set.range θ ∪ {x, y})) ∧ p.eval z = 0) →
    (∀ z : FractionRing P, _root_.IsIntegral ↥(wcLcPT p₁ ((κ.comp σ) r₁)) z →
      z ∈ wcLcPT p₁ ((κ.comp σ) r₁)) →
    letI iD : Algebra O D := θ.toAlgebra
    letI iP : Algebra O P := κ.toAlgebra
    ∃ e : TensorProduct O D P ⧸ ((𝔪.map σ).map (algebraMap O (TensorProduct O D P))).radical ≃+*
        ↥(wcLcPT p₁ ((κ.comp σ) r₁)) ⧸
          (𝔪.map ((algebraMap P ↥(wcLcPT p₁ ((κ.comp σ) r₁))).comp (κ.comp σ))).radical,
      ∀ r : R, e (Ideal.Quotient.mk _ (TensorProduct.tmul O (θ (σ r)) (1 : P))) =
        Ideal.Quotient.mk _ (algebraMap P ↥(wcLcPT p₁ ((κ.comp σ) r₁)) ((κ.comp σ) r)) :=
by
  intro R O D P L _ _ _ _ _ _ _ _ _ σ 𝔪 θ κ lO lD hlO hlD hθ hfrac hDint hk x y U tₐ r₁ r₂ p₁ p₂ η n
    hη hn hr₁ hr₂ hx hy htₐ hU hp12 hint hPT
  classical
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  letI iD : Algebra O D := θ.toAlgebra
  letI iP : Algebra O P := κ.toAlgebra
  letI iL : Algebra O L := lO.toAlgebra
  letI iDL : Algebra D L := lD.toAlgebra
  haveI hTower : IsScalarTower O D L := IsScalarTower.of_algebraMap_eq (fun a => by
    show lO a = lD (θ a)
    rw [← hθ]; rfl)
  haveI hFrac : IsFractionRing O L :=
    { map_units := fun b => by
        refine IsUnit.mk0 _ ?_
        show lO b ≠ 0
        intro h
        exact nonZeroDivisors.coe_ne_zero b (hlO (h.trans (map_zero lO).symm))
      surj := fun z => by
        obtain ⟨a, b, hb, h⟩ := hfrac z
        exact ⟨(a, ⟨b, mem_nonZeroDivisors_of_ne_zero hb⟩), h⟩
      exists_of_eq := fun {a a'} h => ⟨1, by rw [hlO h]⟩ }
  haveI hflat : Module.Flat O P :=
    wcpa_dj_llsm_lcd_hens_flat O (IsLocalRing.maximalIdeal O)
      (Ideal.IsMaximal.isPrime inferInstance) P κ hk
  have hκ : Function.Injective κ := FaithfulSMul.algebraMap_injective O P
  have hgP : Function.Injective (algebraMap P (FractionRing P)) :=
    IsFractionRing.injective P (FractionRing P)
  have hgeq : ∀ a : O, algebraMap O (FractionRing P) a = algebraMap P (FractionRing P) (κ a) :=
    fun a => IsScalarTower.algebraMap_apply O P (FractionRing P) a
  have hg : Function.Injective (algebraMap O (FractionRing P)) := fun a b h =>
    hκ (hgP (by rw [← hgeq, ← hgeq]; exact h))
  let jL : L →+* FractionRing P := IsFractionRing.lift hg
  have hjL : ∀ a : O, jL (lO a) = algebraMap O (FractionRing P) a := fun a =>
    IsFractionRing.lift_algebraMap hg a
  let jA : L →ₐ[O] FractionRing P := { jL with commutes' := fun a => hjL a }
  let ΨA : TensorProduct O L P →ₐ[O] FractionRing P :=
    Algebra.TensorProduct.lift jA (IsScalarTower.toAlgHom O P (FractionRing P))
      (fun _ _ => Commute.all _ _)
  let φ : TensorProduct O D P →ₐ[O] TensorProduct O L P :=
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom O D L) (AlgHom.id O P)
  let Φ : TensorProduct O D P →ₐ[O] FractionRing P := ΨA.comp φ
  let ℓ : D →+* FractionRing P := jL.comp lD
  have hΨ_tmul : ∀ (l : L) (p : P), ΨA (l ⊗ₜ[O] p) = jL l * algebraMap P (FractionRing P) p :=
    fun l p => (Algebra.TensorProduct.lift_tmul _ _ _ l p).trans rfl
  have hφ_tmul : ∀ (d : D) (p : P), φ (d ⊗ₜ[O] p) = lD d ⊗ₜ[O] p := fun d p =>
    (Algebra.TensorProduct.map_tmul _ _ d p).trans rfl
  have hΦ_tmul : ∀ (d : D) (p : P), Φ (d ⊗ₜ[O] p) = ℓ d * algebraMap P (FractionRing P) p :=
    fun d p => by
      show ΨA (φ (d ⊗ₜ[O] p)) = _
      rw [hφ_tmul, hΨ_tmul]
      rfl
  have hℓθ : ∀ a : O, ℓ (θ a) = algebraMap O (FractionRing P) a := fun a => by
    show jL (lD (θ a)) = _
    rw [← RingHom.comp_apply lD θ, hθ, hjL]

  have hform : ∀ w : TensorProduct O L P, ∃ t : O, t ≠ 0 ∧ ∃ p : P, w = (lO t)⁻¹ ⊗ₜ[O] p := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨1, one_ne_zero, 0, by rw [TensorProduct.tmul_zero]⟩
    | tmul l p =>
      obtain ⟨a, b, hb, h⟩ := hfrac l
      have hb' : lO b ≠ 0 := fun h0 => hb (hlO (h0.trans (map_zero lO).symm))
      refine ⟨b, hb, a • p, ?_⟩
      rw [← TensorProduct.smul_tmul]
      have e : a • (lO b)⁻¹ = l := by
        rw [Algebra.smul_def]
        show lO a * (lO b)⁻¹ = l
        rw [← h, mul_inv_cancel_right₀ hb']
      rw [e]
    | add w₁ w₂ ih₁ ih₂ =>
      obtain ⟨t, ht, p, rfl⟩ := ih₁
      obtain ⟨t', ht', p', rfl⟩ := ih₂
      have ht0 : lO t ≠ 0 := fun h0 => ht (hlO (h0.trans (map_zero lO).symm))
      have ht0' : lO t' ≠ 0 := fun h0 => ht' (hlO (h0.trans (map_zero lO).symm))
      refine ⟨t * t', mul_ne_zero ht ht', t' • p + t • p', ?_⟩
      rw [TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
      have e1 : t' • (lO (t * t'))⁻¹ = (lO t)⁻¹ := by
        rw [Algebra.smul_def]
        show lO t' * (lO (t * t'))⁻¹ = (lO t)⁻¹
        rw [map_mul, mul_inv, mul_left_comm, mul_inv_cancel₀ ht0', mul_one]
      have e2 : t • (lO (t * t'))⁻¹ = (lO t')⁻¹ := by
        rw [Algebra.smul_def]
        show lO t * (lO (t * t'))⁻¹ = (lO t')⁻¹
        rw [map_mul, mul_inv, ← mul_assoc, mul_inv_cancel₀ ht0, one_mul]
      rw [e1, e2]
  have hΨinj : Function.Injective ΨA := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    obtain ⟨t, ht, p, rfl⟩ := hform w
    rw [hΨ_tmul, map_inv₀, hjL] at hw
    have hgt : algebraMap O (FractionRing P) t ≠ 0 := fun h0 => ht (hg (h0.trans (map_zero _).symm))
    have hp : algebraMap P (FractionRing P) p = 0 := by
      rcases mul_eq_zero.mp hw with h | h
      · exact absurd (inv_eq_zero.mp h) hgt
      · exact h
    rw [show p = 0 from hgP (hp.trans (map_zero _).symm), TensorProduct.tmul_zero]
  have hφinj : Function.Injective φ := by
    have e : (φ : TensorProduct O D P → TensorProduct O L P) =
        LinearMap.rTensor P (IsScalarTower.toAlgHom O D L).toLinearMap := by
      funext w
      induction w using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul d p => rw [hφ_tmul, LinearMap.rTensor_tmul]; rfl
      | add a b ha hb => rw [map_add, map_add, ha, hb]
    rw [e]
    exact Module.Flat.rTensor_preserves_injective_linearMap _ hlD
  have hΦinj : Function.Injective Φ := hΨinj.comp hφinj

  have htₐ0 : tₐ ≠ 0 := by rw [htₐ]; exact pow_ne_zero _ hr₁
  set c : FractionRing P := algebraMap O (FractionRing P) (σ r₁) with hc
  have hc0 : c ≠ 0 := fun h0 => hr₁ (hg (h0.trans (map_zero _).symm))
  set ηi : P := ↑hη.unit⁻¹ with hηi
  have hηηi : η * ηi = 1 := hη.mul_val_inv
  have hE1 : ℓ x * c ^ (m + 1) =
      algebraMap P (FractionRing P) η * algebraMap P (FractionRing P) p₁ ^ (m + 1) := by
    have := congrArg ℓ hx
    rw [map_mul, hℓθ, hℓθ, htₐ, map_pow, hgeq U, hU, map_mul, map_pow] at this
    exact this
  have hE2 : ℓ y * (algebraMap P (FractionRing P) η * algebraMap P (FractionRing P) p₁ ^ (m + 1)) =
      c ^ (m + 1) := by
    have := congrArg ℓ hy
    rw [map_mul, hℓθ, hℓθ, htₐ, map_pow, hgeq U, hU, map_mul, map_pow] at this
    exact this
  have hp0 : algebraMap P (FractionRing P) p₁ ≠ 0 := by
    intro h0
    rw [h0, zero_pow (Nat.succ_ne_zero m), mul_zero, mul_zero] at hE2
    exact pow_ne_zero _ hc0 hE2.symm
  have hηi' : algebraMap P (FractionRing P) η * algebraMap P (FractionRing P) ηi = 1 := by
    rw [← map_mul, hηηi, map_one]
  set T := wcLcT p₁ ((κ.comp σ) r₁) with hT
  have hTeq : T = algebraMap P (FractionRing P) p₁ / c := by
    rw [hc, hgeq]; rfl
  have hT0 : T ≠ 0 := by rw [hTeq]; exact div_ne_zero hp0 hc0
  have hlx : ℓ x = algebraMap P (FractionRing P) η * T ^ (m + 1) := by
    rw [hTeq, div_pow, ← mul_div_assoc, eq_div_iff (pow_ne_zero _ hc0)]
    exact hE1
  have hly0 : ℓ y = algebraMap P (FractionRing P) ηi * c ^ (m + 1) /
      algebraMap P (FractionRing P) p₁ ^ (m + 1) := by
    rw [eq_div_iff (pow_ne_zero _ hp0), ← hE2]
    linear_combination (-(ℓ y * algebraMap P (FractionRing P) p₁ ^ (m + 1))) * hηi'
  have hly : ℓ y = algebraMap P (FractionRing P) ηi * T⁻¹ ^ (m + 1) := by
    rw [hly0, hTeq, inv_div, div_pow, mul_div_assoc]
  have hxT : ℓ x * algebraMap P (FractionRing P) ηi = T ^ (m + 1) := by
    rw [hlx, mul_right_comm, hηi', one_mul]
  have hTinv : T⁻¹ = T ^ m * algebraMap P (FractionRing P) η * ℓ y := by
    rw [hly, mul_assoc, ← mul_assoc (algebraMap P (FractionRing P) η), hηi', one_mul, inv_pow,
      pow_succ, mul_inv, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hT0), one_mul]

  set PT := wcLcPT p₁ ((κ.comp σ) r₁) with hPTdef
  have hTmem : T ∈ PT := Algebra.subset_adjoin (Set.mem_insert _ _)
  have hTinvmem : T⁻¹ ∈ PT :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hPmem : ∀ p : P, algebraMap P (FractionRing P) p ∈ PT := fun p => PT.algebraMap_mem p
  have hℓmem : ∀ z : D, ℓ z ∈ PT := by
    have hcl : Subring.closure (Set.range θ ∪ {x, y}) ≤ Subring.comap ℓ PT.toSubring := by
      rw [Subring.closure_le]
      rintro _ (⟨a, rfl⟩ | h)
      · show ℓ (θ a) ∈ PT
        rw [hℓθ, hgeq]; exact hPmem _
      · rcases h with h | h
        · rw [h]
          show ℓ x ∈ PT
          rw [hlx]; exact PT.mul_mem (hPmem _) (PT.pow_mem hTmem _)
        · rw [Set.mem_singleton_iff.mp h]
          show ℓ y ∈ PT
          rw [hly]; exact PT.mul_mem (hPmem _) (PT.pow_mem hTinvmem _)
    intro z
    obtain ⟨p, hpm, hpc, hpz⟩ := hint z
    have hlift : p.map ℓ ∈ Polynomial.lifts (algebraMap PT (FractionRing P)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_map]
      exact ⟨⟨ℓ (p.coeff i), hcl (hpc i)⟩, rfl⟩
    obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift (hpm.map ℓ)
    apply hPT
    refine ⟨q, hqm, ?_⟩
    rw [Polynomial.eval₂_eq_eval_map, hq, Polynomial.eval_map, Polynomial.eval₂_at_apply, hpz,
      map_zero]
  have hΦmem : ∀ w, Φ w ∈ PT := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact PT.zero_mem
    | tmul d p => rw [hΦ_tmul]; exact PT.mul_mem (hℓmem d) (hPmem p)
    | add a b ha hb => rw [map_add]; exact PT.add_mem ha hb

  have hΨτ : ΨA ((lO (σ r₁))⁻¹ ⊗ₜ[O] p₁) = T := by
    rw [hΨ_tmul, map_inv₀, hjL, hTeq, div_eq_inv_mul]
  have hτpow : ((lO (σ r₁))⁻¹ ⊗ₜ[O] p₁ : TensorProduct O L P) ^ (m + 1) =
      φ (x ⊗ₜ[O] ηi) := by
    apply hΨinj
    rw [map_pow, hΨτ]
    show T ^ (m + 1) = Φ (x ⊗ₜ[O] ηi)
    rw [hΦ_tmul, hxT]
  have hTrange : ∃ w, Φ w = T := by
    have hmem := wcpa_dj_llsm_lcd_hens_normalization O D L P hk
      (fun z hz => by
        obtain ⟨p, hp, hpz⟩ := hz
        exact hDint z p hp hpz)
      ((lO (σ r₁))⁻¹ ⊗ₜ[O] p₁)
      ⟨Polynomial.X ^ (m + 1) - Polynomial.C (x ⊗ₜ[O] ηi),
        Polynomial.monic_X_pow_sub_C _ (Nat.succ_ne_zero m), by
          rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
          show _ - φ (x ⊗ₜ[O] ηi) = 0
          rw [hτpow, sub_self]⟩
    obtain ⟨w, hw⟩ := (AlgHom.mem_range _).mp hmem
    exact ⟨w, by show ΨA (φ w) = T; rw [hw]; exact hΨτ⟩
  have hrange : ∀ z ∈ PT, ∃ w, Φ w = z := by
    intro z hz
    change z ∈ Algebra.adjoin P {T, T⁻¹} at hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      rcases hz with rfl | hz
      · exact hTrange
      · obtain rfl : z = T⁻¹ := hz
        obtain ⟨w, hw⟩ := hTrange
        refine ⟨w ^ m * (1 ⊗ₜ[O] η) * (y ⊗ₜ[O] 1), ?_⟩
        rw [map_mul, map_mul, map_pow, hw, hΦ_tmul, hΦ_tmul, map_one, map_one, one_mul, mul_one,
          hTinv]
    | algebraMap p => exact ⟨1 ⊗ₜ[O] p, by rw [hΦ_tmul, map_one, one_mul]⟩
    | add a b _ _ ha hb =>
      obtain ⟨wa, rfl⟩ := ha
      obtain ⟨wb, rfl⟩ := hb
      exact ⟨wa + wb, map_add _ _ _⟩
    | mul a b _ _ ha hb =>
      obtain ⟨wa, rfl⟩ := ha
      obtain ⟨wb, rfl⟩ := hb
      exact ⟨wa * wb, map_mul _ _ _⟩

  let Φ' : TensorProduct O D P →+* PT := Φ.toRingHom.codRestrict PT hΦmem
  have hΦ'bij : Function.Bijective Φ' := by
    constructor
    · intro a b h
      exact hΦinj (congrArg Subtype.val h)
    · intro z
      obtain ⟨w, hw⟩ := hrange z.1 z.2
      exact ⟨w, Subtype.ext hw⟩
  let e₀ : TensorProduct O D P ≃+* PT := RingEquiv.ofBijective Φ' hΦ'bij
  have he₀ : ∀ a : O, e₀ (algebraMap O (TensorProduct O D P) a) = algebraMap P PT (κ a) := by
    intro a
    apply Subtype.ext
    show Φ (algebraMap O _ a) = algebraMap P (FractionRing P) (κ a)
    rw [AlgHom.commutes, hgeq]
  have he₀c : (e₀ : TensorProduct O D P →+* PT).comp (algebraMap O (TensorProduct O D P)) =
      (algebraMap P PT).comp κ := RingHom.ext he₀
  set I := (𝔪.map σ).map (algebraMap O (TensorProduct O D P)) with hI
  have hIJ : I.map (e₀ : TensorProduct O D P →+* PT) =
      𝔪.map ((algebraMap P PT).comp (κ.comp σ)) := by
    rw [hI, Ideal.map_map, Ideal.map_map, he₀c]; rfl
  have hker : RingHom.ker (e₀ : TensorProduct O D P →+* PT) ≤ I := by
    intro a ha
    rw [RingHom.mem_ker] at ha
    have : a = 0 := e₀.injective (ha.trans (map_zero e₀).symm)
    rw [this]; exact zero_mem _
  have hrad : (𝔪.map ((algebraMap P PT).comp (κ.comp σ))).radical =
      I.radical.map (e₀ : TensorProduct O D P →+* PT) := by
    rw [Ideal.map_radical_of_surjective (f := (e₀ : TensorProduct O D P →+* PT)) e₀.surjective
      hker, hIJ]
  refine ⟨Ideal.quotientEquiv I.radical _ e₀ hrad, fun r => ?_⟩
  rw [Ideal.quotientEquiv_mk]
  congr 1
  have : θ (σ r) ⊗ₜ[O] (1 : P) = algebraMap O (TensorProduct O D P) (σ r) := by
    rw [Algebra.TensorProduct.algebraMap_apply]; rfl
  rw [this]
  exact he₀ (σ r)

theorem wcpa_dj_llsm_isicg_local_circle : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g →
    ∀ (ι : ↥(wcIsicgC1 W A K L u (a' * q')) →+* ↥(wcIsicgB W A K L u a')),
      (∀ x, ((ι x : ↥(wcIsicgB W A K L u a')) : L) = (x : L)) →
    ∀ (Q : Ideal ↥(wcIsicgC1 W A K L u (a' * q'))) [Q.IsPrime],
      Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
        wcLlsASbN W A K u (a' * q') →
      ∀ (P : Type u) [CommRing P] (k : Localization.AtPrime Q →+* P),
        wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P k →
      ∀ (β : ↥W) (f : wcEbntN W β →+* P) (η : P) (n : ℕ) (ν : ↥W),
        wcEbntPres W (k.comp (wcIsicgSig W A K L u (a' * q') Q)) β f → IsUnit η → 1 ≤ n →
        IsUnit ν → k (wcIsicgU W A K L u (a' * q') Q) = η * f (wcEbntX W β 0) ^ n →
        a' * q' = β ^ n * ν →
        ∃ ψ : wcIsicgFib ι (wcIsicgIB W A K L u a') Q ≃+*
            LaurentPolynomial (IsLocalRing.ResidueField ↥W),
          ∀ (w : ↥W) (c : ↥(wcIsicgB W A K L u a')),
            (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
            ψ (wcIsicgFibMk ι (wcIsicgIB W A K L u a') Q c) =
              LaurentPolynomial.C (IsLocalRing.residue ↥W w) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0 hdvd
    ι hι Q _ hQc P _ k hk β f η n ν hpres hη hn hν hU hβ
  classical
  have hnu : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W → ¬ IsUnit x :=
    fun x hx => (IsLocalRing.mem_maximalIdeal x).mp hx
  have hpres' := hpres
  obtain ⟨-, hβ0, hfσ, -⟩ := hpres'

  obtain ⟨μ₀, hμ₀⟩ := IsAlgClosed.exists_pow_nat_eq (a' : Ω) (by omega : 0 < n)
  have hμ₀0 : μ₀ ≠ 0 := by
    rintro rfl
    apply ha'0
    apply Subtype.ext
    show (a' : Ω) = 0
    rw [← hμ₀, zero_pow (by omega)]
  have hμW : μ₀ ∈ W := by
    by_contra hcon
    have hinv : μ₀⁻¹ ∈ W := (W.mem_or_inv_mem μ₀).resolve_left hcon
    apply hnu a' ha'm
    refine isUnit_iff_exists_inv.mpr ⟨(⟨μ₀⁻¹, hinv⟩ : ↥W) ^ n, ?_⟩
    apply Subtype.ext
    show (a' : Ω) * (μ₀⁻¹) ^ n = 1
    rw [← hμ₀, ← mul_pow, mul_inv_cancel₀ hμ₀0, one_pow]
  obtain ⟨μ, hμdef⟩ : ∃ μ : ↥W, (μ : Ω) = μ₀ := ⟨⟨μ₀, hμW⟩, rfl⟩
  have hμn : μ ^ n = a' := Subtype.ext (by show (μ : Ω) ^ n = (a' : Ω); rw [hμdef]; exact hμ₀)
  have hμ0 : μ ≠ 0 := fun h => hμ₀0 (hμdef.symm.trans (congrArg Subtype.val h))
  have hμm : μ ∈ IsLocalRing.maximalIdeal ↥W :=
    (IsLocalRing.mem_maximalIdeal μ).mpr (fun hu => hnu a' ha'm (by rw [← hμn]; exact hu.pow n))
  obtain ⟨d, hd⟩ : μ ∣ β := by
    rcases ValuationRing.dvd_total μ β with h | ⟨t, ht⟩
    · exact h
    · exfalso
      have e : β ^ n * (t ^ n * q') = β ^ n * ν := by
        rw [← hβ, ← hμn, ht]; ring
      have e2 := mul_left_cancel₀ (pow_ne_zero n hβ0) e
      exact hnu q' hq'm (isUnit_of_mul_isUnit_right (by rw [e2]; exact hν))
  have hd0 : d ≠ 0 := fun h => hβ0 (by rw [hd, h, mul_zero])
  have hdm : d ∈ IsLocalRing.maximalIdeal ↥W := by
    refine (IsLocalRing.mem_maximalIdeal d).mpr (fun hdu => ?_)
    have e : μ ^ n * q' = μ ^ n * (d ^ n * ν) := by
      rw [hμn, hβ, hd, mul_pow, ← hμn]; ring
    have e2 := mul_left_cancel₀ (pow_ne_zero n hμ0) e
    exact hnu q' hq'm (by rw [e2]; exact (hdu.pow n).mul hν)

  obtain ⟨hOdom, hOint, lO, lD, hlOinj, hlDinj, hlDθ, hfrac, hlDint, x, y, hx, hy, hxyint⟩ :=
    wcpa_dj_llsm_lc_chart_frac Ω W hW hWt A K L 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0 hdvd
      ι hι Q hQc
  haveI := hOdom
  haveI := hOint
  obtain ⟨hσm, hσinj, hprimes, hIB, hcomp⟩ :=
    wcpa_dj_llsm_lc_chart_fibre Ω W hW hWt A K L 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0 hdvd
      ι hι Q hQc
  have hroots := wcpa_dj_llsm_lc_residue_roots Ω W hW hWt A K L 𝔭 u v g a' q' hPD ha'm ha'0
    hq'm hq'0 hdvd ι hι Q hQc

  obtain ⟨hPdom, hnonunit, hres⟩ := wcpa_dj_llsm_lc_hens_basic (Localization.AtPrime Q) P k hk
  haveI := hPdom
  have hk2 := hk
  obtain ⟨hPh, -, -⟩ := hk2
  haveI : HenselianLocalRing P := hPh

  obtain ⟨hPTn, ψ4, hψ4⟩ := wcpa_dj_llsm_lc_laurent_chart Ω W hW hWt P
    (k.comp (wcIsicgSig W A K L u (a' * q') Q)) β f hpres μ d hμm hμ0 hdm hd0 hd.symm

  have h1 : ((wcIsicgIB W A K L u a').map (algebraMap ↥(wcIsicgB W A K L u a')
      (Localization (Q.primeCompl.map ι)))).radical =
      (((IsLocalRing.maximalIdeal ↥W).map (wcIsicgSig W A K L u (a' * q') Q)).map
        (wcLcTheta ι Q)).radical :=
    congrArg Ideal.radical hIB
  have hσ0 : ∀ w : ↥W, w ≠ 0 → wcIsicgSig W A K L u (a' * q') Q w ≠ 0 :=
    fun w hw h => hw (hσinj (h.trans (map_zero _).symm))
  have hXY : wcEbntX W β 0 * wcEbntX W β 1 =
      ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β :
        MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) β := by
    show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
    rw [← map_mul, RingHom.comp_apply, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hp12 : f (wcEbntX W β 0) * f (wcEbntX W β 1) =
      k (wcIsicgSig W A K L u (a' * q') Q μ * wcIsicgSig W A K L u (a' * q') Q d) := by
    rw [← map_mul (wcIsicgSig W A K L u (a' * q') Q), ← map_mul f, hXY, ← hd]
    exact RingHom.congr_fun hfσ β
  have a6 : wcIsicgSig W A K L u (a' * q') Q a' =
      wcIsicgSig W A K L u (a' * q') Q μ ^ n := by rw [← map_pow, hμn]

  have a1 : (IsLocalRing.maximalIdeal ↥W).map (wcIsicgSig W A K L u (a' * q') Q) ≤
      IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
    Ideal.map_le_iff_le_comap.mpr (fun w hw => Ideal.mem_comap.mpr (hσm w hw))
  have a2 : Ideal.map k (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) =
      IsLocalRing.maximalIdeal P :=
    Ideal.ext fun z => by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact (hnonunit z).symm
  have T0 := wcpa_dj_llsm_lc_fibre_compare ↥W (Localization.AtPrime Q)
    (Localization (Q.primeCompl.map ι)) P (wcIsicgSig W A K L u (a' * q') Q) (wcLcTheta ι Q) k
    (IsLocalRing.maximalIdeal ↥W)
  have T1 := T0 a1
  have T2 := T1 a2
  have T3 := T2 (hres hroots)
  have T4 := T3 hprimes
  obtain ⟨e5, he5⟩ := T4

  have S0 := wcpa_dj_llsm_lc_descent ↥W (Localization.AtPrime Q)
    (Localization (Q.primeCompl.map ι)) P L (wcIsicgSig W A K L u (a' * q') Q)
    (IsLocalRing.maximalIdeal ↥W) (wcLcTheta ι Q) k lO lD
  have S1 := S0 hlOinj
  have S2 := S1 hlDinj
  have S3 := S2 hlDθ
  have S4 := S3 hfrac
  have S5 := S4 hlDint
  have S6 := S5 hk x y (wcIsicgU W A K L u (a' * q') Q) (wcIsicgSig W A K L u (a' * q') Q a') μ d
    (f (wcEbntX W β 0)) (f (wcEbntX W β 1)) η n
  have S7 := S6 hη
  have S8 := S7 hn
  have S9 := S8 (hσ0 μ hμ0)
  have S10 := S9 (hσ0 d hd0)
  have S11 := S10 hx
  have S12 := S11 hy
  have S13 := S12 a6
  have S14 := S13 hU
  have S15 := S14 hp12
  have S16 := S15 hxyint
  have S17 := S16 hPTn
  obtain ⟨e6, he6⟩ := S17

  refine ⟨((Ideal.quotEquivOfEq h1).trans e5).trans (e6.trans ψ4), fun w c hc => ?_⟩
  have st1 : Ideal.quotEquivOfEq h1 (wcIsicgFibMk ι (wcIsicgIB W A K L u a') Q c) =
      Ideal.Quotient.mk _ (wcLcTheta ι Q (wcIsicgSig W A K L u (a' * q') Q w)) :=
    (Ideal.quotEquivOfEq_mk h1 _).trans (congrArg (Ideal.Quotient.mk _) (hcomp w c hc))
  have st2 := congrArg (fun z => ψ4 (e6 (e5 z))) st1
  have st3 := congrArg (fun z => ψ4 (e6 z)) (he5 (wcLcTheta ι Q (wcIsicgSig W A K L u (a' * q') Q w)))
  have st4 := congrArg ψ4 (he6 w)
  exact st2.trans (st3.trans (st4.trans (hψ4 w)))

theorem wcpa_dj_llsm_isi_circle_good : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g → wcLlsAnnSep W A K L u (a' * q') → wcLlsIsiCirc W A K L u a' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0
    hdvd hSep
  classical

  obtain ⟨ι, hι, hfin, hmax, hover⟩ := wcpa_dj_llsm_isicg_over_node Ω W hW hWt A K L 𝔭 u v g a' q'
    hPD ha'm ha'0 hq'm hq'0 hdvd

  set S : Set (Ideal ↥(wcIsicgC1 W A K L u (a' * q'))) :=
    {Q | Q.IsPrime ∧
      Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
        wcLlsASbN W A K u (a' * q')} with hS
  haveI : Finite ↥S := hfin.to_subtype
  let e : ↥S ≃ Fin (Nat.card ↥S) := Finite.equivFin ↥S
  let Qs : Fin (Nat.card ↥S) → Ideal ↥(wcIsicgC1 W A K L u (a' * q')) := fun i => (e.symm i).1
  haveI hQp : ∀ i, (Qs i).IsPrime := fun i => (e.symm i).2.1
  have hQc : ∀ i, (Qs i).comap
      (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
        wcLlsASbN W A K u (a' * q') := fun i => (e.symm i).2.2
  have hQinj : Function.Injective Qs := Subtype.val_injective.comp e.symm.injective
  have hQmax : ∀ i, (Qs i).IsMaximal := fun i => hmax _ (hQp i) (hQc i)
  have hcov : ∀ 𝔓 : Ideal ↥(wcIsicgB W A K L u a'), 𝔓.IsPrime → wcIsicgIB W A K L u a' ≤ 𝔓 →
      ∃ i, 𝔓.comap ι = Qs i := by
    intro 𝔓 h𝔓 hI
    let x : ↥S := ⟨𝔓.comap ι, ⟨Ideal.comap_isPrime ι 𝔓, hover 𝔓 h𝔓 hI⟩⟩
    refine ⟨e x, ?_⟩
    show 𝔓.comap ι = (e.symm (e x)).1
    rw [Equiv.symm_apply_apply]

  obtain ⟨esplit, hes⟩ := wcpa_dj_llsm_isicg_fibre_split _ _ ι (wcIsicgIB W A K L u a')
    (Nat.card ↥S) Qs hQinj hQmax hcov

  have hloc : ∀ i : Fin (Nat.card ↥S), ∃ ψ : wcIsicgFib ι (wcIsicgIB W A K L u a') (Qs i) ≃+*
      LaurentPolynomial (IsLocalRing.ResidueField ↥W),
      ∀ (w : ↥W) (c : ↥(wcIsicgB W A K L u a')),
        (c : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) →
        ψ (wcIsicgFibMk ι (wcIsicgIB W A K L u a') (Qs i) c) =
          LaurentPolynomial.C (IsLocalRing.residue ↥W w) := by
    intro i
    obtain ⟨P, _, k, hk, β, f, η, n, ν, hpres, hη, hn, hν, hu, hb⟩ :=
      wcpa_dj_llsm_isicg_node_monomial Ω W hW hWt A K L 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0
        hdvd hSep (Qs i) (hQc i)
    exact wcpa_dj_llsm_isicg_local_circle Ω W hW hWt A K L 𝔭 u v g a' q' hPD ha'm ha'0 hq'm
      hq'0 hdvd ι hι (Qs i) (hQc i) P k hk β f η n ν hpres hη hn hν hu hb
  choose ψ hψ using hloc

  refine ⟨Nat.card ↥S, esplit.trans (RingEquiv.piCongrRight ψ), ?_⟩
  intro w c hc i
  rw [RingEquiv.trans_apply, RingEquiv.piCongrRight_apply, hes c i]
  exact hψ i w c hc

theorem wcpa_dj_llsm_isic_node_of_pair : ∀ (F D₁ D₂ : Type u) [CommRing F] [IsLocalRing F]
    [CommRing D₁] [IsDomain D₁] [IsDiscreteValuationRing D₁]
    [CommRing D₂] [IsDomain D₂] [IsDiscreteValuationRing D₂] (φ₁ : F →+* D₁) (φ₂ : F →+* D₂),
    Function.Surjective φ₁ → Function.Surjective φ₂ →
    (∀ x : F, φ₁ x = 0 → φ₂ x = 0 → x = 0) →
    (∃ x : F, Irreducible (φ₁ x) ∧ φ₂ x = 0) → (∃ x : F, φ₁ x = 0 ∧ Irreducible (φ₂ x)) →
    wcpaDjLkDelta F = 1 ∧ wcpaDjLkBranches F = 2 :=
by
  intro F D₁ D₂ _ _ _ _ _ _ _ _ φ₁ φ₂ hs₁ hs₂ hJ hx₁ hx₂
  obtain ⟨X, hX1, hX2⟩ := hx₁
  obtain ⟨Y, hY1, hY2⟩ := hx₂
  haveI : IsLocalHom φ₁ := IsLocalHom.of_surjective φ₁ hs₁
  haveI : IsLocalHom φ₂ := IsLocalHom.of_surjective φ₂ hs₂
  have hdiv1 : ∀ z : F, ¬ IsUnit z → φ₁ X ∣ φ₁ z := by
    intro z hz
    have hz' : ¬ IsUnit (φ₁ z) := fun h => hz (isUnit_of_map_unit φ₁ z h)
    have hm : φ₁ z ∈ IsLocalRing.maximalIdeal D₁ := (IsLocalRing.mem_maximalIdeal _).mpr hz'
    rw [hX1.maximalIdeal_eq, Ideal.mem_span_singleton] at hm
    exact hm
  have hdiv2 : ∀ z : F, ¬ IsUnit z → φ₂ Y ∣ φ₂ z := by
    intro z hz
    have hz' : ¬ IsUnit (φ₂ z) := fun h => hz (isUnit_of_map_unit φ₂ z h)
    have hm : φ₂ z ∈ IsLocalRing.maximalIdeal D₂ := (IsLocalRing.mem_maximalIdeal _).mpr hz'
    rw [hY2.maximalIdeal_eq, Ideal.mem_span_singleton] at hm
    exact hm
  have hXY : X * Y = 0 :=
    hJ _ (by rw [map_mul, hY1, mul_zero]) (by rw [map_mul, hX2, zero_mul])
  have hker2 : Ideal.span {X} = RingHom.ker φ₂ := by
    ext z
    rw [Ideal.mem_span_singleton, RingHom.mem_ker]
    constructor
    · rintro ⟨c, rfl⟩
      rw [map_mul, hX2, zero_mul]
    · intro hz
      have hnu : ¬ IsUnit z := fun h => by
        have h' := h.map φ₂
        rw [hz] at h'
        exact not_isUnit_zero h'
      obtain ⟨a, ha⟩ := hdiv1 z hnu
      obtain ⟨a', rfl⟩ := hs₁ a
      refine ⟨a', ?_⟩
      have h0 := hJ (z - X * a') (by rw [map_sub, map_mul, ha, sub_self])
        (by rw [map_sub, map_mul, hz, hX2, zero_mul, sub_zero])
      exact sub_eq_zero.mp h0
  have hker1 : Ideal.span {Y} = RingHom.ker φ₁ := by
    ext z
    rw [Ideal.mem_span_singleton, RingHom.mem_ker]
    constructor
    · rintro ⟨c, rfl⟩
      rw [map_mul, hY1, zero_mul]
    · intro hz
      have hnu : ¬ IsUnit z := fun h => by
        have h' := h.map φ₁
        rw [hz] at h'
        exact not_isUnit_zero h'
      obtain ⟨b, hb⟩ := hdiv2 z hnu
      obtain ⟨b', rfl⟩ := hs₂ b
      refine ⟨b', ?_⟩
      have h0 := hJ (z - Y * b') (by rw [map_sub, map_mul, hz, hY1, zero_mul, sub_zero])
        (by rw [map_sub, map_mul, hb, sub_self])
      exact sub_eq_zero.mp h0
  let e₂ : (F ⧸ Ideal.span {X}) ≃+* D₂ :=
    (Ideal.quotEquivOfEq hker2).trans (RingHom.quotientKerEquivOfSurjective hs₂)
  let e₁ : (F ⧸ Ideal.span {Y}) ≃+* D₁ :=
    (Ideal.quotEquivOfEq hker1).trans (RingHom.quotientKerEquivOfSurjective hs₁)
  haveI : IsDomain (F ⧸ Ideal.span {X}) := MulEquiv.isDomain D₂ e₂.toMulEquiv
  haveI : IsDomain (F ⧸ Ideal.span {Y}) := MulEquiv.isDomain D₁ e₁.toMulEquiv
  haveI : IsIntegrallyClosed (F ⧸ Ideal.span {X}) := IsIntegrallyClosed.of_equiv e₂.symm
  haveI : IsIntegrallyClosed (F ⧸ Ideal.span {Y}) := IsIntegrallyClosed.of_equiv e₁.symm
  have hc1 : Ideal.Quotient.mk (Ideal.span {X}) Y ≠ 0 := by
    intro h
    rw [Ideal.Quotient.eq_zero_iff_mem, hker2, RingHom.mem_ker] at h
    exact hY2.ne_zero h
  have hc2 : Ideal.Quotient.mk (Ideal.span {Y}) X ≠ 0 := by
    intro h
    rw [Ideal.Quotient.eq_zero_iff_mem, hker1, RingHom.mem_ker] at h
    exact hX1.ne_zero h
  have hm : IsLocalRing.maximalIdeal F = Ideal.span {X, Y} := by
    apply le_antisymm
    · intro z hz
      have hnu : ¬ IsUnit z := (IsLocalRing.mem_maximalIdeal z).mp hz
      obtain ⟨a, ha⟩ := hdiv1 z hnu
      obtain ⟨b, hb⟩ := hdiv2 z hnu
      obtain ⟨a', rfl⟩ := hs₁ a
      obtain ⟨b', rfl⟩ := hs₂ b
      rw [Ideal.mem_span_pair]
      refine ⟨a', b', ?_⟩
      have h0 := hJ (z - (a' * X + b' * Y))
        (by rw [map_sub, map_add, map_mul, map_mul, ha, hY1]; ring)
        (by rw [map_sub, map_add, map_mul, map_mul, hb, hX2]; ring)
      exact (sub_eq_zero.mp h0).symm
    · rw [Ideal.span_le]
      intro w hw
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
      rcases hw with rfl | rfl
      · exact (IsLocalRing.mem_maximalIdeal _).mpr (fun h => hX1.not_isUnit (h.map φ₁))
      · exact (IsLocalRing.mem_maximalIdeal _).mpr (fun h => hY2.not_isUnit (h.map φ₂))
  obtain ⟨φ, hφ⟩ := wcpa_dj_llsm_tg_node_closure_prod F X Y hXY hc1 hc2
  exact wcpa_dj_llsm_tg_node_delta_branches F X Y hm φ hφ

theorem wcpa_dj_llsm_isicb_core : ∀ (F : Type u) [CommRing F] [IsLocalRing F] [IsNoetherianRing F]
    [_root_.IsReduced F],
    (∀ P₀ P₁ : Ideal F, P₀.IsPrime → P₁.IsPrime → P₀ < P₁ → P₁.IsMaximal) →
    ∀ (p : Ideal F), p.IsPrime → p ≠ IsLocalRing.maximalIdeal F → ∀ z ∈ p, z ≠ 0 →
    ¬ wcpaDjLkBad F → ∃ _ : IsDomain (F ⧸ p), IsDiscreteValuationRing (F ⧸ p) :=
by
  intro F _ _ _ _ hCH p hpP hpm z hz hz0 hbad
  classical

  have L0 : ∀ x : F, (∀ q ∈ minimalPrimes F, x ∈ q) → x = 0 := by
    intro x hx
    have h1 : x ∈ sInf (minimalPrimes F) := Submodule.mem_sInf.mpr hx
    rw [minimalPrimes, Ideal.sInf_minimalPrimes] at h1
    obtain ⟨n, hn⟩ := h1
    exact IsReduced.eq_zero x ⟨n, by simpa using hn⟩

  have L1 : ∀ (p p' : Ideal F), p ∈ minimalPrimes F → p' ∈ minimalPrimes F → p' ≠ p →
      ∃ a b : F, a ∉ p ∧ b ∈ p ∧ b ∉ p' ∧ a * b = 0 ∧ (∀ q ∈ minimalPrimes F, q ≠ p → a ∈ q) ∧
        ∀ d : F, d ∉ p → d * a + b ∈ nonZeroDivisors F := by
    intro p p' hp hp' hne
    have hfin := minimalPrimes.finite_of_isNoetherianRing F
    set S := hfin.toFinset.erase p with hS
    have hSmem : ∀ q, q ∈ S ↔ q ∈ minimalPrimes F ∧ q ≠ p := by
      intro q; rw [hS, Finset.mem_erase, Set.Finite.mem_toFinset]; exact and_comm
    haveI hpP : p.IsPrime := hp.1.1
    have hA : ¬ S.inf id ≤ p := by
      intro h
      obtain ⟨q, hqS, hqp⟩ := hpP.inf_le'.mp h
      obtain ⟨hq, hqne⟩ := (hSmem q).mp hqS
      exact hqne (le_antisymm hqp (hp.2 ⟨hq.1.1, bot_le⟩ hqp))
    obtain ⟨a, haS, ha⟩ := SetLike.not_le_iff_exists.mp hA
    have haq : ∀ q ∈ minimalPrimes F, q ≠ p → a ∈ q := fun q hq hqp =>
      Finset.inf_le (f := id) ((hSmem q).mpr ⟨hq, hqp⟩) haS
    have hB : ¬ (p : Set F) ⊆ ⋃ i ∈ (S : Set (Ideal F)), id i := by
      intro h
      obtain ⟨q, hqS, hpq⟩ := (Ideal.subset_union_prime (f := id) p p
        (fun i hi _ _ => ((hSmem i).mp hi).1.1.1)).mp h
      obtain ⟨hq, hqne⟩ := (hSmem q).mp hqS
      exact hqne (le_antisymm (hq.2 ⟨hpP, bot_le⟩ hpq) hpq)
    obtain ⟨b, hbp, hbS⟩ := Set.not_subset.mp hB
    have hbq : ∀ q ∈ minimalPrimes F, q ≠ p → b ∉ q := by
      intro q hq hqp hbq
      apply hbS
      exact Set.mem_biUnion (x := q) ((hSmem q).mpr ⟨hq, hqp⟩) hbq
    refine ⟨a, b, ha, hbp, hbq p' hp' hne, ?_, haq, ?_⟩
    · apply L0
      intro q hq
      by_cases hqp : q = p
      · rw [hqp]; exact p.mul_mem_left a hbp
      · exact q.mul_mem_right b (haq q hq hqp)
    · intro d hd
      have hσ : ∀ q ∈ minimalPrimes F, d * a + b ∉ q := by
        intro q hq hσq
        by_cases hqp : q = p
        · subst hqp
          have : d * a ∈ q := by
            have := q.sub_mem hσq hbp
            simpa using this
          rcases hpP.mem_or_mem this with h | h
          · exact hd h
          · exact ha h
        · apply hbq q hq hqp
          have := q.sub_mem hσq (q.mul_mem_left d (haq q hq hqp))
          simpa using this
      have key : ∀ x : F, (d * a + b) * x = 0 → x = 0 := by
        intro x hx
        apply L0
        intro q hq
        haveI : q.IsPrime := hq.1.1
        have : (d * a + b) * x ∈ q := by rw [hx]; exact q.zero_mem
        exact (Ideal.IsPrime.mem_or_mem inferInstance this).resolve_left (hσ q hq)
      rw [mem_nonZeroDivisors_iff]
      exact ⟨fun x hx => key x (by first | exact hx | (rw [mul_comm]; exact hx)),
        fun x hx => key x (by first | exact hx | (rw [mul_comm]; exact hx))⟩

  have L2 : ∃ π : (q : Ideal F) → q ∈ minimalPrimes F → (FractionRing F →+* FractionRing (F ⧸ q)),
      (∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), (π q hq).comp (algebraMap F (FractionRing F)) =
        (algebraMap (F ⧸ q) (FractionRing (F ⧸ q))).comp (Ideal.Quotient.mk q)) ∧
      ∀ x : FractionRing F, (∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), π q hq x = 0) → x = 0 := by
    have hunit : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F) (s : nonZeroDivisors F),
        IsUnit (((algebraMap (F ⧸ q) (FractionRing (F ⧸ q))).comp (Ideal.Quotient.mk q)) s) := by
      intro q hq s
      haveI : q.IsPrime := hq.1.1
      have hs : (s : F) ∉ q := fun h =>
        Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hq) h s.2
      apply IsUnit.mk0
      rw [RingHom.comp_apply]
      intro h0
      apply hs
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact (IsFractionRing.injective (F ⧸ q) (FractionRing (F ⧸ q))) (h0.trans (map_zero _).symm)
    refine ⟨fun q hq => IsLocalization.lift (M := nonZeroDivisors F) (S := FractionRing F)
      (hunit q hq), fun q hq => IsLocalization.lift_comp _, ?_⟩
    intro x hx
    obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors F) x
    have hr : ∀ q ∈ minimalPrimes F, r ∈ q := by
      intro q hq
      haveI : q.IsPrime := hq.1.1
      have h1 := hx q hq
      have h2 := congrArg (IsLocalization.lift (M := nonZeroDivisors F) (S := FractionRing F)
        (hunit q hq)) (IsLocalization.mk'_spec (FractionRing F) r s)
      simp only at h1
      rw [map_mul, h1, zero_mul, IsLocalization.lift_eq] at h2
      rw [RingHom.comp_apply] at h2
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact (IsFractionRing.injective (F ⧸ q) (FractionRing (F ⧸ q)))
        (h2.symm.trans (map_zero _).symm)
    show IsLocalization.mk' (FractionRing F) r s = 0
    rw [L0 r hr, IsLocalization.mk'_zero]

  have L3 : ∀ (p : Ideal F) (hp : p ∈ minimalPrimes F) (a b : F), a ∉ p → b ∈ p → b ≠ 0 →
      (∀ q ∈ minimalPrimes F, q ≠ p → a ∈ q) → a * b = 0 → a + b ∈ nonZeroDivisors F →
      ∀ π : (q : Ideal F) → q ∈ minimalPrimes F → (FractionRing F →+* FractionRing (F ⧸ q)),
      (∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), (π q hq).comp (algebraMap F (FractionRing F)) =
        (algebraMap (F ⧸ q) (FractionRing (F ⧸ q))).comp (Ideal.Quotient.mk q)) →
      ∃ e : FractionRing F, e * e = e ∧ (∀ f : F, algebraMap F (FractionRing F) f ≠ e) ∧
        π p hp e = 1 ∧ ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), q ≠ p → π q hq e = 0 := by
    intro p hp a b ha hb hb0 haq hab hs π hπ
    set ι := algebraMap F (FractionRing F) with hι
    set e := IsLocalization.mk' (FractionRing F) a (⟨a + b, hs⟩ : nonZeroDivisors F) with he
    have hE : e * ι (a + b) = ι a := IsLocalization.mk'_spec (FractionRing F) a ⟨a + b, hs⟩
    have hu : IsUnit (ι (a + b)) :=
      IsLocalization.map_units (FractionRing F) (⟨a + b, hs⟩ : nonZeroDivisors F)
    have hsq : ι a * ι (a + b) = ι a * ι a := by
      rw [← map_mul, ← map_mul]; congr 1; linear_combination hab
    have hπq : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F) (x : F),
        π q hq (ι x) = algebraMap (F ⧸ q) (FractionRing (F ⧸ q)) (Ideal.Quotient.mk q x) := by
      intro q hq x
      have := congrArg (fun φ => φ x) (hπ q hq)
      simpa using this
    have hsq_ne : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), a + b ∉ q := fun q hq h =>
      Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hq) h hs
    have hee : e * e = e := by
      apply hu.mul_right_cancel
      apply hu.mul_right_cancel
      calc e * e * ι (a + b) * ι (a + b) = (e * ι (a + b)) * (e * ι (a + b)) := by ring
        _ = ι a * ι a := by rw [hE]
        _ = ι a * ι (a + b) := hsq.symm
        _ = e * ι (a + b) * ι (a + b) := by rw [hE]
    have hproj : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F),
        π q hq e * algebraMap (F ⧸ q) (FractionRing (F ⧸ q)) (Ideal.Quotient.mk q (a + b)) =
          algebraMap (F ⧸ q) (FractionRing (F ⧸ q)) (Ideal.Quotient.mk q a) := by
      intro q hq
      rw [← hπq q hq, ← hπq q hq, ← map_mul, hE]
    refine ⟨e, hee, ?_, ?_, ?_⟩
    · intro f hf
      have h1 : ι (f * (a + b)) = ι a := by rw [map_mul, hf, hE]
      have h1' : f * (a + b) = a := IsFractionRing.injective F (FractionRing F) h1
      have h2 : ι (f * f) = ι f := by rw [map_mul, hf, hee]
      have h2' : f * f = f := IsFractionRing.injective F (FractionRing F) h2
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self f with hf1 | hf1
      · have : f = 1 := by
          have h3 : f * (f - 1) = 0 := by linear_combination h2'
          have := (hf1.mul_right_eq_zero).mp h3
          linear_combination this
        subst this
        apply hb0
        linear_combination h1'
      · have : f = 0 := by
          have h3 : (1 - f) * f = 0 := by linear_combination -h2'
          exact (hf1.mul_right_eq_zero).mp h3
        subst this
        apply ha
        rw [← h1']; simp
    · haveI : p.IsPrime := hp.1.1
      have h := hproj p hp
      have hab' : Ideal.Quotient.mk p (a + b) = Ideal.Quotient.mk p a := by
        rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero]
      rw [hab'] at h
      have hne : algebraMap (F ⧸ p) (FractionRing (F ⧸ p)) (Ideal.Quotient.mk p a) ≠ 0 := by
        intro h0
        apply ha
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact IsFractionRing.injective (F ⧸ p) (FractionRing (F ⧸ p)) (h0.trans (map_zero _).symm)
      exact mul_right_cancel₀ hne (h.trans (one_mul _).symm)
    · intro q hq hqp
      haveI : q.IsPrime := hq.1.1
      have h := hproj q hq
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (haq q hq hqp), map_zero] at h
      have hne : algebraMap (F ⧸ q) (FractionRing (F ⧸ q)) (Ideal.Quotient.mk q (a + b)) ≠ 0 := by
        intro h0
        apply hsq_ne q hq
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact IsFractionRing.injective (F ⧸ q) (FractionRing (F ⧸ q)) (h0.trans (map_zero _).symm)
      exact (mul_eq_zero.mp h).resolve_right hne

  have L4 : ∀ (e : FractionRing F), e * e = e → (∀ f : F, algebraMap F (FractionRing F) f ≠ e) →
      (Module.length F (↥(integralClosure F (FractionRing F)) ⧸
        LinearMap.range (Algebra.linearMap F ↥(integralClosure F (FractionRing F)))) = 0 ∨
       Module.length F (↥(integralClosure F (FractionRing F)) ⧸
        LinearMap.range (Algebra.linearMap F ↥(integralClosure F (FractionRing F)))) = 1) →
      ∀ t : FractionRing F, IsIntegral F t →
        ∃ f₀ f₁ : F, t = algebraMap F (FractionRing F) f₀ + algebraMap F (FractionRing F) f₁ * e := by
    intro e hee heF hlen
    set C := integralClosure F (FractionRing F) with hC
    set R₀ := LinearMap.range (Algebra.linearMap F ↥C) with hR₀
    have heI : IsIntegral F e := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X, ?_, ?_⟩
      · exact Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num))
      · simp [Polynomial.eval₂_sub, sq, hee]
    set ê : ↥C := ⟨e, heI⟩ with hê
    have hne : (Submodule.Quotient.mk ê : ↥C ⧸ R₀) ≠ 0 := by
      intro h
      rw [Submodule.Quotient.mk_eq_zero, hR₀, LinearMap.mem_range] at h
      obtain ⟨f, hf⟩ := h
      apply heF f
      have := congrArg Subtype.val hf
      simpa using this
    have hsimple : IsSimpleModule F (↥C ⧸ R₀) := by
      rcases hlen with h | h
      · exfalso
        haveI := Module.length_eq_zero_iff.mp h
        exact hne (Subsingleton.elim _ _)
      · exact Module.length_eq_one_iff.mp h
    have hspan := IsSimpleModule.span_singleton_eq_top F hne
    intro t ht
    set tt : ↥C := ⟨t, ht⟩
    have hmem : (Submodule.Quotient.mk tt : ↥C ⧸ R₀) ∈
        Submodule.span F {Submodule.Quotient.mk ê} := by
      rw [hspan]; trivial
    obtain ⟨f₁, hf₁⟩ := Submodule.mem_span_singleton.mp hmem
    have h2 : Submodule.Quotient.mk (tt - f₁ • ê) = (0 : ↥C ⧸ R₀) := by
      rw [Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul, hf₁, sub_self]
    rw [Submodule.Quotient.mk_eq_zero, hR₀, LinearMap.mem_range] at h2
    obtain ⟨f₀, hf₀⟩ := h2
    refine ⟨f₀, f₁, ?_⟩
    have := congrArg Subtype.val hf₀
    simp only [Algebra.linearMap_apply] at this
    have h3 : ((algebraMap F ↥C f₀ : ↥C) : FractionRing F) = algebraMap F (FractionRing F) f₀ := rfl
    rw [h3] at this
    have h4 : ((tt - f₁ • ê : ↥C) : FractionRing F) =
        t - algebraMap F (FractionRing F) f₁ * e := by
      simp [tt, ê, Algebra.smul_def]
    rw [h4] at this
    linear_combination -this

  have L5 : ∀ (p : Ideal F) (hp : p ∈ minimalPrimes F) (a b : F), a ∉ p → b ∈ p →
      (∀ q ∈ minimalPrimes F, q ≠ p → a ∈ q) → (∀ d : F, d ∉ p → d * a + b ∈ nonZeroDivisors F) →
      ∀ π : (q : Ideal F) → q ∈ minimalPrimes F → (FractionRing F →+* FractionRing (F ⧸ q)),
      (∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), (π q hq).comp (algebraMap F (FractionRing F)) =
        (algebraMap (F ⧸ q) (FractionRing (F ⧸ q))).comp (Ideal.Quotient.mk q)) →
      (∀ x : FractionRing F, (∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), π q hq x = 0) → x = 0) →
      ∀ e : FractionRing F, π p hp e = 1 →
      (∀ t : FractionRing F, IsIntegral F t →
        ∃ f₀ f₁ : F, t = algebraMap F (FractionRing F) f₀ + algebraMap F (FractionRing F) f₁ * e) →
      IsIntegrallyClosed (F ⧸ p) := by
    intro p hp a b ha hb haq hnzd π hπ hinj e he1 hdec
    haveI : p.IsPrime := hp.1.1
    set ι := algebraMap F (FractionRing F) with hι
    have hπq : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F) (x : F),
        π q hq (ι x) = algebraMap (F ⧸ q) (FractionRing (F ⧸ q)) (Ideal.Quotient.mk q x) := by
      intro q hq x
      have := congrArg (fun φ => φ x) (hπ q hq)
      simpa using this
    have hne0 : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F) (x : F), x ∉ q →
        algebraMap (F ⧸ q) (FractionRing (F ⧸ q)) (Ideal.Quotient.mk q x) ≠ 0 := by
      intro q hq x hx h0
      haveI : q.IsPrime := hq.1.1
      apply hx
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact IsFractionRing.injective (F ⧸ q) (FractionRing (F ⧸ q)) (h0.trans (map_zero _).symm)
    rw [isIntegrallyClosed_iff (FractionRing (F ⧸ p))]
    intro ξ hξ
    obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := F ⧸ p) ξ
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hd : d ∉ p := by
      intro hdp
      rw [← Ideal.Quotient.eq_zero_iff_mem] at hdp
      rw [hdp] at hy
      exact zero_notMem_nonZeroDivisors hy
    obtain ⟨G, hGm, hG⟩ := hξ
    obtain ⟨Ĝ, hĜmap, -, hĜm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      (Polynomial.lifts_iff_coeff_lifts G |>.mpr (fun n => Ideal.Quotient.mk_surjective _)) hGm
    set σ : nonZeroDivisors F := ⟨d * a + b, hnzd d hd⟩ with hσ
    set t := IsLocalization.mk' (FractionRing F) (c * a) σ with ht
    have hT : t * ι (d * a + b) = ι (c * a) := IsLocalization.mk'_spec (FractionRing F) (c * a) σ
    have hσq : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), d * a + b ∉ q := fun q hq h =>
      Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hq) h (hnzd d hd)
    have htp : π p hp t = ξ := by
      have h := congrArg (π p hp) hT
      rw [map_mul, hπq, hπq] at h
      have hb0 : Ideal.Quotient.mk p b = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb
      simp only [map_add, map_mul, hb0, add_zero] at h
      have ha0 := hne0 p hp a ha
      have hd0 := hne0 p hp d hd
      rw [← hxy, eq_div_iff hd0]
      apply mul_right_cancel₀ ha0
      calc π p hp t * (algebraMap (F ⧸ p) (FractionRing (F ⧸ p))) (Ideal.Quotient.mk p d) *
            (algebraMap (F ⧸ p) (FractionRing (F ⧸ p))) (Ideal.Quotient.mk p a)
          = π p hp t * ((algebraMap (F ⧸ p) (FractionRing (F ⧸ p))) (Ideal.Quotient.mk p d) *
            (algebraMap (F ⧸ p) (FractionRing (F ⧸ p))) (Ideal.Quotient.mk p a)) := by ring
        _ = (algebraMap (F ⧸ p) (FractionRing (F ⧸ p))) (Ideal.Quotient.mk p c) *
            (algebraMap (F ⧸ p) (FractionRing (F ⧸ p))) (Ideal.Quotient.mk p a) := h
    have htq : ∀ (q : Ideal F) (hq : q ∈ minimalPrimes F), q ≠ p → π q hq t = 0 := by
      intro q hq hqp
      haveI : q.IsPrime := hq.1.1
      have h := congrArg (π q hq) hT
      rw [map_mul, hπq, hπq] at h
      have ha0 : Ideal.Quotient.mk q a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (haq q hq hqp)
      rw [map_mul (Ideal.Quotient.mk q) c a, ha0, mul_zero, map_zero] at h
      exact (mul_eq_zero.mp h).resolve_right (hne0 q hq _ (hσq q hq))
    have hti : IsIntegral F t := by
      refine ⟨Polynomial.X * Ĝ, Polynomial.monic_X.mul hĜm, ?_⟩
      apply hinj
      intro q hq
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, map_mul]
      by_cases hqp : q = p
      · subst hqp
        have : π q hq (Polynomial.eval₂ ι t Ĝ) = 0 := by
          rw [Polynomial.hom_eval₂, hπ q hq, ← Polynomial.eval₂_map, hĜmap]
          have hpp : hq = hp := rfl
          rw [hpp, htp]
          exact hG
        rw [this, mul_zero]
      · rw [htq q hq hqp, zero_mul]
    obtain ⟨f₀, f₁, hf⟩ := hdec t hti
    refine ⟨Ideal.Quotient.mk p (f₀ + f₁), ?_⟩
    rw [← htp, hf]
    simp only [map_add, map_mul, hπq, he1, mul_one]

  have L6 : ∀ (p : Ideal F) [p.IsPrime], p ≠ IsLocalRing.maximalIdeal F →
      IsIntegrallyClosed (F ⧸ p) → IsDiscreteValuationRing (F ⧸ p) := by
    intro p _ hpm hic
    haveI : IsLocalRing (F ⧸ p) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
    have hnf : ¬ IsField (F ⧸ p) := by
      intro hf
      have : p.IsMaximal := Ideal.Quotient.maximal_of_isField p hf
      exact hpm (IsLocalRing.eq_maximalIdeal this)
    have hT := (IsDiscreteValuationRing.TFAE (F ⧸ p) hnf).out 1 4
    refine hT.mpr ⟨hic, IsLocalRing.maximalIdeal (F ⧸ p), ⟨?_, inferInstance⟩, ?_⟩
    · intro h; exact hnf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
    · rintro P' ⟨hP'0, hP'⟩
      have hle : p ≤ P'.comap (Ideal.Quotient.mk p) := fun x hx => by
        rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]; exact P'.zero_mem
      have hne : p ≠ P'.comap (Ideal.Quotient.mk p) := by
        intro h
        apply hP'0
        rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective P', ← h,
          Ideal.map_quotient_self]
      have hmax : (P'.comap (Ideal.Quotient.mk p)).IsMaximal :=
        hCH p _ inferInstance (Ideal.comap_isPrime _ _) (lt_of_le_of_ne hle hne)
      have h2 : P'.comap (Ideal.Quotient.mk p) ≤
          (IsLocalRing.maximalIdeal (F ⧸ p)).comap (Ideal.Quotient.mk p) :=
        Ideal.comap_mono (IsLocalRing.le_maximalIdeal hP'.ne_top)
      have h3 := hmax.eq_of_le
        (Ideal.comap_ne_top _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top) h2
      rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective P',
        ← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective
          (IsLocalRing.maximalIdeal (F ⧸ p)), h3]

  have hp : p ∈ minimalPrimes F := by
    obtain ⟨q, hq, hqp⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal F) ≤ p)
    by_cases h : q = p
    · rw [← h]; exact hq
    · exfalso
      have hmax := hCH q p hq.1.1 hpP (lt_of_le_of_ne hqp h)
      exact hpm (IsLocalRing.eq_maximalIdeal hmax)

  have hp' : ∃ p' ∈ minimalPrimes F, z ∉ p' := by
    by_contra h
    push_neg at h
    exact hz0 (L0 z h)
  obtain ⟨p', hp'm, hzp'⟩ := hp'
  have hne : p' ≠ p := fun h => hzp' (by rw [h]; exact hz)

  obtain ⟨a, b, ha, hb, hbp', hab, haq, hnzd⟩ := L1 p p' hp hp'm hne
  have hb0 : b ≠ 0 := fun h => hbp' (by rw [h]; exact p'.zero_mem)
  obtain ⟨π, hπ, hinj⟩ := L2
  have h1p : (1 : F) ∉ p := fun h => hpP.ne_top ((Ideal.eq_top_iff_one p).mpr h)
  have hs : a + b ∈ nonZeroDivisors F := by
    have := hnzd 1 h1p
    rwa [one_mul] at this
  obtain ⟨e, hee, heF, he1, -⟩ := L3 p hp a b ha hb hb0 haq hab hs π hπ

  have hlen : Module.length F (↥(integralClosure F (FractionRing F)) ⧸
        LinearMap.range (Algebra.linearMap F ↥(integralClosure F (FractionRing F)))) = 0 ∨
       Module.length F (↥(integralClosure F (FractionRing F)) ⧸
        LinearMap.range (Algebra.linearMap F ↥(integralClosure F (FractionRing F)))) = 1 := by
    have h := not_not.mp hbad
    unfold wcpaDjLkDelta at h
    rcases h with h | ⟨h, -⟩
    · exact Or.inl h
    · exact Or.inr h
  have hdec := L4 e hee heF hlen
  have hic := L5 p hp a b ha hb haq hnzd π hπ hinj e he1 hdec
  haveI := hpP
  exact ⟨Ideal.Quotient.isDomain p, L6 p hpm hic⟩

theorem wcpa_dj_llsm_isicb_chain : ∀ (R C : Type u) [CommRing R] [CommRing C] [Algebra R C]
    [Algebra.IsIntegral R C] (Q : Ideal C) [Q.IsPrime] (I : Ideal C), I ≤ Q →
    ∀ z₁ z₂ : C, z₁ ∈ Q → z₂ ∈ Q → z₁ * z₂ ∈ I →
    (∀ P : Ideal C, P.IsPrime → I ≤ P → P ≤ Q → z₁ ∈ P → z₂ ∈ P →
      Q.comap (algebraMap R C) ≤ P.comap (algebraMap R C)) →
    IsNoetherianRing (Localization.AtPrime Q ⧸ I.map (algebraMap C (Localization.AtPrime Q))) →
    ∀ P₀ P₁ : Ideal (Localization.AtPrime Q ⧸ I.map (algebraMap C (Localization.AtPrime Q))),
      P₀.IsPrime → P₁.IsPrime → P₀ < P₁ → P₁.IsMaximal :=
by
  intro R C _ _ _ _ Q _ I hIQ z₁ z₂ hz₁ hz₂ hzI hH hNoeth

  have s1 : ∀ (F : Type u) [CommRing F] [IsNoetherianRing F] (𝔪 : Ideal F), 𝔪.IsMaximal →
      (∀ 𝔓 : Ideal F, 𝔓.IsPrime → 𝔓 ≤ 𝔪) → ∀ a b : F, b ∈ 𝔪 →
      (∀ 𝔐 : Ideal F, 𝔐.IsPrime → a ∈ 𝔐 → b ∈ 𝔐 → 𝔐 = 𝔪) →
      ∀ P₀ P₁ : Ideal F, P₀.IsPrime → P₁.IsPrime → P₀ < P₁ → a ∈ P₀ → P₁ = 𝔪 := by
    intro F _ _ 𝔪 h𝔪 hall a b hb huniq P₀ P₁ hP₀ hP₁ hlt ha
    by_contra hne
    have hsurj : Function.Surjective (Ideal.Quotient.mk P₀) := Ideal.Quotient.mk_surjective
    have hker : RingHom.ker (Ideal.Quotient.mk P₀) = P₀ := Ideal.mk_ker
    have hcm : ∀ K : Ideal F, P₀ ≤ K → (K.map (Ideal.Quotient.mk P₀)).comap
        (Ideal.Quotient.mk P₀) = K := by
      intro K hK
      rw [Ideal.comap_map_of_surjective' _ hsurj, hker, sup_eq_left.mpr hK]
    have hpr : ∀ K : Ideal F, K.IsPrime → P₀ ≤ K → (K.map (Ideal.Quotient.mk P₀)).IsPrime := by
      intro K hK hPK
      exact Ideal.map_isPrime_of_surjective hsurj (by rw [hker]; exact hPK)
    have hP₀m : P₀ ≤ 𝔪 := hall P₀ hP₀
    have hP₁m : P₁ ≤ 𝔪 := hall P₁ hP₁
    haveI h0p := hpr P₀ hP₀ le_rfl
    haveI h1p := hpr P₁ hP₁ hlt.le
    haveI hmp := hpr 𝔪 h𝔪.isPrime hP₀m
    have hlt01 : P₀.map (Ideal.Quotient.mk P₀) < P₁.map (Ideal.Quotient.mk P₀) := by
      refine lt_of_le_of_ne (Ideal.map_mono hlt.le) ?_
      intro heq
      have := congrArg (Ideal.comap (Ideal.Quotient.mk P₀)) heq
      rw [hcm P₀ le_rfl, hcm P₁ hlt.le] at this
      exact hlt.ne this
    have hlt1m : P₁.map (Ideal.Quotient.mk P₀) < 𝔪.map (Ideal.Quotient.mk P₀) := by
      refine lt_of_le_of_ne (Ideal.map_mono hP₁m) ?_
      intro heq
      have := congrArg (Ideal.comap (Ideal.Quotient.mk P₀)) heq
      rw [hcm P₁ hlt.le, hcm 𝔪 hP₀m] at this
      exact hne this
    have hmin : 𝔪.map (Ideal.Quotient.mk P₀) ∈
        (Ideal.span {Ideal.Quotient.mk P₀ b}).minimalPrimes := by
      refine ⟨⟨hmp, ?_⟩, ?_⟩
      · rw [Ideal.span_singleton_le_iff_mem]; exact Ideal.mem_map_of_mem _ hb
      · intro 𝔔 h𝔔 _
        obtain ⟨h𝔔p, hb𝔔⟩ := h𝔔
        rw [Ideal.span_singleton_le_iff_mem] at hb𝔔
        have hM : (𝔔.comap (Ideal.Quotient.mk P₀)).IsPrime := Ideal.comap_isPrime _ 𝔔
        have haM : a ∈ 𝔔.comap (Ideal.Quotient.mk P₀) := by
          rw [Ideal.mem_comap, (Ideal.Quotient.eq_zero_iff_mem).mpr ha]; exact 𝔔.zero_mem
        have hbM : b ∈ 𝔔.comap (Ideal.Quotient.mk P₀) := hb𝔔
        have hc := huniq _ hM haM hbM
        have e : 𝔔 = 𝔪.map (Ideal.Quotient.mk P₀) := by
          rw [← hc, Ideal.map_comap_of_surjective _ hsurj]
        exact e.ge
    have hh := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ _ hmin
    have hh' : (𝔪.map (Ideal.Quotient.mk P₀)).height ≤ ((1 : ℕ) : ℕ∞) := by
      rw [Nat.cast_one]; exact hh
    have h1 := (Ideal.height_le_iff.mp hh') _ h1p hlt1m
    have h0 : (P₁.map (Ideal.Quotient.mk P₀)).height ≤ ((0 : ℕ) : ℕ∞) := by
      rw [Nat.cast_one] at h1
      rw [Nat.cast_zero]
      exact (Order.lt_one_iff.mp h1).le
    have h2 := (Ideal.height_le_iff.mp h0) _ h0p hlt01
    rw [Nat.cast_zero] at h2
    exact (not_lt_zero h2)

  set φ := algebraMap C (Localization.AtPrime Q) with hφ
  set J := I.map φ with hJ
  set π := Ideal.Quotient.mk J with hπ
  set 𝔪 := IsLocalRing.maximalIdeal (Localization.AtPrime Q) with h𝔪
  have hsurj : Function.Surjective π := Ideal.Quotient.mk_surjective
  have hker : RingHom.ker π = J := Ideal.mk_ker
  have hQm : Q.map φ = 𝔪 := Localization.AtPrime.map_eq_maximalIdeal
  have hJm : J ≤ 𝔪 := hQm ▸ Ideal.map_mono hIQ
  have hcm : (𝔪.map π).comap π = 𝔪 := by
    rw [Ideal.comap_map_of_surjective' π hsurj, hker, sup_eq_left.mpr hJm]
  have hmax : (𝔪.map π).IsMaximal := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective π hsurj
      (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime Q)) with h | h
    · exfalso
      have h' := hcm
      rw [h, Ideal.comap_top] at h'
      exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime Q)).ne_top h'.symm
    · exact h
  have hall : ∀ 𝔓 : Ideal (Localization.AtPrime Q ⧸ J), 𝔓.IsPrime → 𝔓 ≤ 𝔪.map π := by
    intro 𝔓 h𝔓
    rw [← Ideal.map_comap_of_surjective π hsurj 𝔓]
    exact Ideal.map_mono (IsLocalRing.le_maximalIdeal (Ideal.comap_isPrime π 𝔓).ne_top)
  have hmem : ∀ z ∈ Q, π (φ z) ∈ 𝔪.map π := fun z hz =>
    Ideal.mem_map_of_mem _ (hQm ▸ Ideal.mem_map_of_mem φ hz)
  have hprod : π (φ z₁) * π (φ z₂) = 0 := by
    rw [← map_mul, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem φ hzI

  have hstar : ∀ P : Ideal C, P.IsPrime → I ≤ P → P ≤ Q → z₁ ∈ P → z₂ ∈ P → P = Q := by
    intro P hP hIP hPQ h1 h2
    by_contra hne
    obtain ⟨x, hxQ, hxP⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hPQ hne)
    have hlt' := Ideal.under_lt_under_of_integral_mem_sdiff (R := R) hPQ ⟨hxQ, hxP⟩
      (Algebra.IsIntegral.isIntegral x)
    exact absurd (hH P hP hIP hPQ h1 h2) (not_le_of_gt hlt')

  have s2 : ∀ 𝔐 : Ideal (Localization.AtPrime Q ⧸ J), 𝔐.IsPrime → π (φ z₁) ∈ 𝔐 →
      π (φ z₂) ∈ 𝔐 → 𝔐 = 𝔪.map π := by
    intro 𝔐 h𝔐 h1 h2
    have hM' : (𝔐.comap π).IsPrime := Ideal.comap_isPrime π 𝔐
    have hP : ((𝔐.comap π).comap φ).IsPrime := Ideal.comap_isPrime φ _
    have hIP : I ≤ (𝔐.comap π).comap φ := by
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_comap,
        (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.mem_map_of_mem φ hx)]
      exact 𝔐.zero_mem
    have hPQ : (𝔐.comap π).comap φ ≤ Q := by
      have h := Ideal.comap_mono (f := φ) (IsLocalRing.le_maximalIdeal hM'.ne_top)
      exact h.trans Localization.AtPrime.under_maximalIdeal.le
    have heq := hstar _ hP hIP hPQ h1 h2
    have hM'eq : 𝔐.comap π = 𝔪 := by
      rw [← IsLocalization.map_under Q.primeCompl (Localization.AtPrime Q) (𝔐.comap π)]
      change Ideal.map φ (Ideal.comap φ (Ideal.comap π 𝔐)) = 𝔪
      rw [heq, hQm]
    rw [← Ideal.map_comap_of_surjective π hsurj 𝔐, hM'eq]
  haveI := hNoeth
  intro P₀ P₁ hP₀ hP₁ hlt
  have h0 : π (φ z₁) * π (φ z₂) ∈ P₀ := by rw [hprod]; exact P₀.zero_mem
  rcases hP₀.mem_or_mem h0 with h | h
  · have e := s1 _ (𝔪.map π) hmax hall (π (φ z₁)) (π (φ z₂)) (hmem z₂ hz₂) s2 P₀ P₁ hP₀ hP₁ hlt h
    rw [e]; exact hmax
  · have e := s1 _ (𝔪.map π) hmax hall (π (φ z₂)) (π (φ z₁)) (hmem z₁ hz₁)
      (fun 𝔐 h𝔐 ha hb => s2 𝔐 h𝔐 hb ha) P₀ P₁ hP₀ hP₁ hlt h
    rw [e]; exact hmax

theorem wcpa_dj_llsm_isicb_exc_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (R C : Type u) [CommRing R] [IsDomain R] [CommRing C] [IsDomain C] [Algebra R C]
    [Algebra.IsIntegral R C], Function.Injective (algebraMap R C) →
    ∀ (σ : ↥W →+* R) (N : Ideal R) [N.IsPrime], IsIntegrallyClosed (Localization.AtPrime N) →
    ∀ (β : ↥W) (P : Type u) [CommRing P] (e : Localization.AtPrime N →+* P),
    wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime N)) P e →
    ∀ (f : wcEbntN W β →+* P),
    wcEbntPres W (e.comp ((algebraMap R (Localization.AtPrime N)).comp σ)) β f →
    ∀ z₁ z₂ : R, f (wcEbntX W β 0) = e (algebraMap R (Localization.AtPrime N) z₁) →
    f (wcEbntX W β 1) = e (algebraMap R (Localization.AtPrime N) z₂) →
    ∀ (Q : Ideal C), Q.IsPrime → Q.comap (algebraMap R C) = N →
    (∃ 𝔮 : Ideal C, 𝔮.IsPrime ∧ 𝔮 ≤ Q ∧
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap R C (σ w) ∈ 𝔮) ∧
      algebraMap R C z₁ ∈ 𝔮 ∧ algebraMap R C z₂ ∉ 𝔮) ∧
    (∃ 𝔮 : Ideal C, 𝔮.IsPrime ∧ 𝔮 ≤ Q ∧
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap R C (σ w) ∈ 𝔮) ∧
      algebraMap R C z₂ ∈ 𝔮 ∧ algebraMap R C z₁ ∉ 𝔮) :=
by
  intro Ω _ W R C _ _ _ _ _ _ hinj σ N _ hIC β P _ e he f hpres z₁ z₂ hz₁ hz₂ Q hQ hQN
  classical
  unfold wcEbntPres at hpres
  obtain ⟨hβm, -, hfσ, hfH⟩ := hpres
  unfold wcNdIsHens at hfH
  obtain ⟨-, -, hfU⟩ := hfH
  have hXprime : (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}).IsPrime :=
    (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr Polynomial.prime_X
  obtain ⟨H, iH, q, hqH⟩ := wcNd_hens_exists (Polynomial (IsLocalRing.ResidueField ↥W)) _ hXprime
  have hHdom : IsDomain H := (wcNd_hens_normal_domain _ _ hXprime H q hqH).1
  have hqinj : Function.Injective q := (wcpa_dj_lr1k_ebnb_hens_inj _ _ hXprime H q hqH).1
  have hqH' := hqH
  unfold wcNdIsHens at hqH'
  obtain ⟨hHens, hqU, -⟩ := hqH'
  have hres0 : IsLocalRing.residue ↥W β = 0 := (IsLocalRing.residue_eq_zero_iff β).mpr hβm

  have hg : ∀ v : Fin 2 → Polynomial (IsLocalRing.ResidueField ↥W), v 0 * v 1 = 0 →
      (∀ i, (v i).coeff 0 = 0) →
      ∃ g : wcEbntN W β →+* Polynomial (IsLocalRing.ResidueField ↥W),
        (∀ i, g (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.X i)) = v i) ∧
        (∀ w : ↥W, g (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w)) =
            Polynomial.C (IsLocalRing.residue ↥W w)) ∧
        ∀ a : wcEbntN W β,
          g a ∈ Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))} ↔
          a ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}))
            (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
    intro v hv01 hv0
    obtain ⟨gt, hgt⟩ : ∃ gt : MvPolynomial (Fin 2) ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W),
        gt = MvPolynomial.eval₂Hom (Polynomial.C.comp (IsLocalRing.residue ↥W)) v := ⟨_, rfl⟩
    have hgrel : gt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C β) = 0 := by
      rw [hgt, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hres0, map_zero, hv01, sub_zero]
    have hker : ∀ a ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}, gt a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hgrel, mul_zero]
    refine ⟨Ideal.Quotient.lift _ gt hker, ?_, ?_, ?_⟩
    · intro i
      rw [Ideal.Quotient.lift_mk, hgt, MvPolynomial.eval₂Hom_X']
    · intro w
      rw [Ideal.Quotient.lift_mk, hgt, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    · have hcc : ∀ p, (gt p).coeff 0 = IsLocalRing.residue ↥W (MvPolynomial.constantCoeff p) := by
        have h1 : (Polynomial.constantCoeff).comp gt =
            (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff := by
          apply MvPolynomial.ringHom_ext
          · intro r
            simp [hgt]
          · intro i
            simp [hgt, hv0 i]
        intro p
        have h2 := RingHom.congr_fun h1 p
        simpa [Polynomial.constantCoeff_apply] using h2
      have hdiff : ∀ p : MvPolynomial (Fin 2) ↥W,
          p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
            Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a => simp
        | add p q hp hq =>
          have e1 : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
              (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
            rw [map_add, map_add]; ring
          rw [e1]; exact Ideal.add_mem _ hp hq
        | mul_X p n hp =>
          have e1 : p * MvPolynomial.X n -
              MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n)) =
              p * MvPolynomial.X n := by
            rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
          rw [e1]
          apply Ideal.mul_mem_left
          apply Ideal.subset_span
          fin_cases n <;> simp
      have hJ : ∀ p : MvPolynomial (Fin 2) ↥W,
          p ∈ (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ↔
            MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W := by
        intro p
        constructor
        · intro hp
          have hle : (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ≤
              (IsLocalRing.maximalIdeal ↥W).comap (MvPolynomial.constantCoeff) := by
            refine sup_le ?_ ?_
            · rw [Ideal.span_le]
              intro x hx
              rcases hx with rfl | rfl <;> simp
            · rw [Ideal.map_le_iff_le_comap]
              intro w hw
              simpa using hw
          exact hle hp
        · intro hp
          have e1 : p = MvPolynomial.C (MvPolynomial.constantCoeff p) +
              (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) := by ring
          rw [e1]
          exact Ideal.add_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hp))
            (Ideal.mem_sup_left (hdiff p))
      have hrelJ : Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)} ≤
          (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, hJ]
        simp [hβm]
      intro a
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective (I := Ideal.span {(MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}) a
      rw [Ideal.Quotient.lift_mk, Ideal.mem_quotient_iff_mem hrelJ, hJ, Ideal.mem_span_singleton,
        Polynomial.X_dvd_iff, hcc, IsLocalRing.residue_eq_zero_iff]

  have key : ∀ (za zb : R) (xa xb : wcEbntN W β)
      (g : wcEbntN W β →+* Polynomial (IsLocalRing.ResidueField ↥W)),
      f xa = e (algebraMap R (Localization.AtPrime N) za) →
      f xb = e (algebraMap R (Localization.AtPrime N) zb) →
      g xa = 0 → g xb = Polynomial.X →
      (∀ w : ↥W, g (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.C w)) =
            Polynomial.C (IsLocalRing.residue ↥W w)) →
      (∀ a : wcEbntN W β,
          g a ∈ Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))} ↔
          a ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C β : MvPolynomial (Fin 2) ↥W)}))
            (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))) →
      ∃ 𝔮 : Ideal C, 𝔮.IsPrime ∧ 𝔮 ≤ Q ∧
        (∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap R C (σ w) ∈ 𝔮) ∧
        algebraMap R C za ∈ 𝔮 ∧ algebraMap R C zb ∉ 𝔮 := by
    intro za zb xa xb g hfa hfb hga hgb hgC hgmem
    obtain ⟨h, hh, -⟩ := (hfU H hHens (q.comp g) (fun a => by
      rw [RingHom.comp_apply, hqU, not_iff_not]; exact hgmem a)).exists
    have hval : ∀ x, h (f x) = q (g x) := fun x => RingHom.congr_fun hh x
    obtain ⟨φ, hφ⟩ : ∃ φ : R →+* H, ∀ r, φ r = h (e (algebraMap R (Localization.AtPrime N) r)) :=
      ⟨h.comp (e.comp (algebraMap R (Localization.AtPrime N))), fun r => rfl⟩
    have hφa : φ za = 0 := by
      rw [hφ, ← hfa, hval, hga, map_zero]
    have hφb : φ zb ≠ 0 := by
      rw [hφ, ← hfb, hval, hgb]
      exact (map_ne_zero_iff q hqinj).mpr Polynomial.X_ne_zero
    have hφσ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, φ (σ w) = 0 := by
      intro w hw
      have h1 := RingHom.congr_fun hfσ w
      simp only [RingHom.comp_apply] at h1
      rw [hφ, ← h1, hval, hgC, (IsLocalRing.residue_eq_zero_iff w).mpr hw, map_zero, map_zero]
    haveI := hHdom
    have hprime : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
    have hle : RingHom.ker φ ≤ N := by
      intro x hx
      by_contra hxN
      have hu : IsUnit (algebraMap R (Localization.AtPrime N) x) :=
        IsLocalization.map_units (Localization.AtPrime N) (⟨x, hxN⟩ : N.primeCompl)
      have hu2 : IsUnit (φ x) := by
        rw [hφ]; exact (hu.map e).map h
      rw [RingHom.mem_ker.mp hx] at hu2
      exact not_isUnit_zero hu2
    obtain ⟨𝔮, h𝔮, h𝔮Q, h𝔮c⟩ := wcpa_dj_llsm_scbc_normal_going_down R C hinj N hIC Q hQ hQN
      (RingHom.ker φ) hprime hle
    have hm : ∀ r, algebraMap R C r ∈ 𝔮 ↔ φ r = 0 := by
      intro r
      rw [← Ideal.mem_comap, h𝔮c, RingHom.mem_ker]
    exact ⟨𝔮, h𝔮, h𝔮Q, fun w hw => (hm _).mpr (hφσ w hw), (hm _).mpr hφa,
      fun h' => hφb ((hm _).mp h')⟩
  obtain ⟨g₀, hg₀X, hg₀C, hg₀m⟩ := hg ![0, Polynomial.X] (by simp)
    (by intro i; fin_cases i <;> simp)
  obtain ⟨g₁, hg₁X, hg₁C, hg₁m⟩ := hg ![Polynomial.X, 0] (by simp)
    (by intro i; fin_cases i <;> simp)
  have e00 : g₀ (wcEbntX W β 0) = 0 := by
    have := hg₀X 0
    simp only [Matrix.cons_val_zero] at this
    exact this
  have e01 : g₀ (wcEbntX W β 1) = Polynomial.X := by
    have := hg₀X 1
    simp only [Matrix.cons_val_one] at this
    exact this
  have e10 : g₁ (wcEbntX W β 0) = Polynomial.X := by
    have := hg₁X 0
    simp only [Matrix.cons_val_zero] at this
    exact this
  have e11 : g₁ (wcEbntX W β 1) = 0 := by
    have := hg₁X 1
    simp only [Matrix.cons_val_one] at this
    exact this
  exact ⟨key z₁ z₂ _ _ g₀ hz₁ hz₂ e00 e01 hg₀C hg₀m, key z₂ z₁ _ _ g₁ hz₂ hz₁ e11 e10 hg₁C hg₁m⟩

theorem wcpa_dj_llsm_br_inner_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g b₀ q : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    q ∈ IsLocalRing.maximalIdeal ↥W → g = b₀ * q →
    ∃ (A₃ : Type u) (_ : CommRing A₃) (_ : IsDomain A₃) (_ : Algebra ↥W A₃) (_ : Algebra A₃ K)
      (_ : IsFractionRing A₃ K) (_ : Algebra A₃ L) (_ : IsScalarTower A₃ K L)
      (u₃ v₃ : A₃) (𝔭₃ : Ideal A₃),
      wcLlsBrSub W A K A₃ (algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀))
        {algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀), algebraMap A K v} ∧
      algebraMap A₃ K u₃ = algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀) ∧
      algebraMap A₃ K v₃ = algebraMap A K v ∧
      wcLlsPD W A₃ 𝔭₃ (.ann u₃ v₃ q) ∧
      ∀ c ∈ wcLlsBrSet W A₃ K L 𝔭₃ u₃, b₀ * c ∈ wcLlsBrSet W A K L 𝔭 u :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g b₀ q hPD hb hb0 hq hgq
  classical
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, -, hg0, huv, h𝔭eq, h, hh𝔭, f, hfC, hfX0, hfX1, hfet⟩ := hPD

  have gen : ∀ (P R B' Q : Type u) [CommRing P] [CommRing R] [CommRing B'] [CommRing Q]
      (ι : P →+* R) (g₀ : P →+* B') (ψ₀ : R →+* Q) (j : B' →+* Q), g₀.Etale →
      ψ₀.comp ι = j.comp g₀ →
      (∀ (T : Type u) [CommRing T] (u : R →+* T) (v : B' →+* T), u.comp ι = v.comp g₀ →
        ∃ β : Q →+* T, β.comp ψ₀ = u ∧ β.comp j = v) →
      (∀ (T : Type u) [CommRing T] (β₁ β₂ : Q →+* T), β₁.comp ψ₀ = β₂.comp ψ₀ →
        β₁.comp j = β₂.comp j → β₁ = β₂) →
      ψ₀.Etale := by
    intro P R B' Q _ _ _ _ ι g₀ ψ₀ j hg₀ hcomm hex hepi
    letI : Algebra P R := ι.toAlgebra
    letI : Algebra P B' := g₀.toAlgebra
    letI : Algebra P Q := (j.comp g₀).toAlgebra
    haveI : Algebra.Etale P B' := hg₀
    have hT : (algebraMap R (TensorProduct P R B')).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange P B' R)
    let f : R →ₐ[P] Q := { ψ₀ with commutes' := fun q =>RingHom.congr_fun hcomm q }
    let j' : B' →ₐ[P] Q := { j with commutes' := fun q => rfl }
    let α : TensorProduct P R B' →+* Q := (Algebra.TensorProduct.productMap f j').toRingHom
    have hα : ∀ r b, α (r ⊗ₜ[P] b) = ψ₀ r * j b := fun r b =>
      Algebra.TensorProduct.productMap_apply_tmul f j' r b
    obtain ⟨β, hβ1, hβ2⟩ := hex (TensorProduct P R B')
      (Algebra.TensorProduct.includeLeftRingHom (R := P) (A := R) (B := B'))
      (Algebra.TensorProduct.includeRight (R := P) (A := R) (B := B')).toRingHom
      (RingHom.ext fun q => by
        show (algebraMap P R q) ⊗ₜ[P] (1 : B') = (1 : R) ⊗ₜ[P] (algebraMap P B' q)
        exact Algebra.TensorProduct.tmul_one_eq_one_tmul q)
    have hβψ : ∀ r, β (ψ₀ r) = r ⊗ₜ[P] (1 : B') := fun r => by
      have := RingHom.congr_fun hβ1 r
      rw [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply] at this
      exact this
    have hβj : ∀ b, β (j b) = (1 : R) ⊗ₜ[P] b := fun b => by
      have := RingHom.congr_fun hβ2 b
      rw [RingHom.comp_apply] at this
      exact this.trans (Algebra.TensorProduct.includeRight_apply b)
    have hαβ : α.comp β = RingHom.id Q := by
      apply hepi Q
      · apply RingHom.ext
        intro r
        show α (β (ψ₀ r)) = ψ₀ r
        rw [hβψ, hα, map_one, mul_one]
      · apply RingHom.ext
        intro b
        show α (β (j b)) = j b
        rw [hβj, hα, map_one, one_mul]
    have hβα : β.comp α = RingHom.id _ := by
      apply Algebra.TensorProduct.ringHom_ext
      · apply RingHom.ext
        intro r
        show β (α (r ⊗ₜ[P] (1 : B'))) = r ⊗ₜ[P] (1 : B')
        rw [hα, map_one, mul_one, hβψ]
      · apply RingHom.ext
        intro b
        show β (α ((1 : R) ⊗ₜ[P] b)) = (1 : R) ⊗ₜ[P] b
        rw [hα, map_one, one_mul, hβj]
    let e : TensorProduct P R B' ≃+* Q := RingEquiv.ofRingHom α β hαβ hβα
    have hψe : ψ₀ = e.toRingHom.comp (algebraMap R (TensorProduct P R B')) := by
      apply RingHom.ext
      intro r
      change ψ₀ r = α (r ⊗ₜ[P] (1 : B'))
      rw [hα, map_one, mul_one]
    rw [hψe]
    exact RingHom.Etale.respectsIso.1 _ e hT

  have hh0 : h ≠ 0 := fun h0 => hh𝔭 (h0 ▸ 𝔭.zero_mem)
  have hinjA : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hu : IsUnit (algebraMap A K h) := ((map_ne_zero_iff _ hinjA).mpr hh0).isUnit
  haveI : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
  letI algBK : Algebra (Localization.Away h) K := (IsLocalization.Away.lift h hu).toAlgebra
  have hBK : ∀ a : A, algebraMap (Localization.Away h) K (algebraMap A (Localization.Away h) a) =
      algebraMap A K a := fun a => IsLocalization.Away.lift_eq h hu a
  haveI : IsScalarTower A (Localization.Away h) K :=
    IsScalarTower.of_algebraMap_eq (fun a => (hBK a).symm)
  haveI : IsFractionRing (Localization.Away h) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers h)
      (Localization.Away h) K
  have hinjB : Function.Injective (algebraMap (Localization.Away h) K) :=
    IsFractionRing.injective _ K
  have hfC' : f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
      algebraMap ↥W (Localization.Away h) := by
    rw [hfC]; exact (IsScalarTower.algebraMap_eq ↥W A (Localization.Away h)).symm
  have hfCw : ∀ w, f (Ideal.Quotient.mk _ (MvPolynomial.C w)) =
      algebraMap ↥W (Localization.Away h) w := fun w => RingHom.congr_fun hfC' w
  have hWB : ∀ w : ↥W, algebraMap ↥W (Localization.Away h) w =
      algebraMap A (Localization.Away h) (algebraMap ↥W A w) := fun w =>
    IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) w
  haveI := h𝔭max
  have hmaxB : (𝔭.map (algebraMap A (Localization.Away h))).IsMaximal := by
    refine IsLocalization.isMaximal_of_isMaximal_disjoint (Submonoid.powers h) _ 𝔭 ?_
    refine Set.disjoint_left.mpr ?_
    rintro x ⟨n, rfl⟩ hx
    exact hh𝔭 (h𝔭max.isPrime.mem_of_pow_mem n hx)
  have hWinj : ∀ w : ↥W, algebraMap A K (algebraMap ↥W A w) = 0 → w = 0 := by
    intro w hw
    have h3 : algebraMap ↥W A w = 0 := hinjA (by rw [hw, map_zero])
    have h4 : w • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one, h3]
    exact (smul_eq_zero.mp h4).resolve_right one_ne_zero
  have hbK : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := fun h0 => hb0 (hWinj b₀ h0)
  have hq0 : q ≠ 0 := by rintro rfl; exact hg0 (by rw [hgq, mul_zero])
  set s : K := algebraMap A K u / algebraMap A K (algebraMap ↥W A b₀) with hsdef
  have hus : algebraMap A K u = algebraMap A K (algebraMap ↥W A b₀) * s := by
    rw [hsdef, mul_div_cancel₀ _ hbK]
  have hvs : algebraMap A K v * s = algebraMap A K (algebraMap ↥W A q) := by
    have e1 : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A b₀) * algebraMap A K (algebraMap ↥W A q) := by
      rw [← map_mul, huv, hgq, map_mul, map_mul]
    rw [hus] at e1
    apply mul_left_cancel₀ hbK
    linear_combination e1
  have hbs : algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) b₀) * s =
      algebraMap (Localization.Away h) K (algebraMap A (Localization.Away h) u) := by
    rw [hWB, hBK, hBK, hus]
  have hvs' : algebraMap (Localization.Away h) K (algebraMap A (Localization.Away h) v) * s =
      algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) q) := by
    rw [hWB, hBK, hBK, hvs]

  set I : Ideal (Polynomial (Localization.Away h)) :=
    Ideal.span {Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) * Polynomial.X -
        Polynomial.C (algebraMap A (Localization.Away h) u),
      Polynomial.C (algebraMap A (Localization.Away h) v) * Polynomial.X -
        Polynomial.C (algebraMap ↥W (Localization.Away h) q)} with hIdef
  have hg1 : Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) * Polynomial.X -
      Polynomial.C (algebraMap A (Localization.Away h) u) ∈ I :=
    Ideal.subset_span (Set.mem_insert _ _)
  have hg2 : Polynomial.C (algebraMap A (Localization.Away h) v) * Polynomial.X -
      Polynomial.C (algebraMap ↥W (Localization.Away h) q) ∈ I :=
    Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  set Ig : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} with hIgdef
  set Iq : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C q} with hIqdef
  have hIq0 : Ideal.Quotient.mk Iq (MvPolynomial.X 0) * Ideal.Quotient.mk Iq (MvPolynomial.X 1) =
      Ideal.Quotient.mk Iq (MvPolynomial.C q) := by
    rw [← map_mul, Ideal.Quotient.eq]; exact Ideal.mem_span_singleton_self _
  let ιt : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W ⧸ Iq :=
    MvPolynomial.eval₂Hom ((Ideal.Quotient.mk Iq).comp MvPolynomial.C)
      ![Ideal.Quotient.mk Iq (MvPolynomial.C b₀ * MvPolynomial.X 0),
        Ideal.Quotient.mk Iq (MvPolynomial.X 1)]
  have hιtC : ∀ w, ιt (MvPolynomial.C w) = Ideal.Quotient.mk Iq (MvPolynomial.C w) := by
    intro w; simp [ιt]
  have hιt0 : ιt (MvPolynomial.X 0) = Ideal.Quotient.mk Iq (MvPolynomial.C b₀ * MvPolynomial.X 0) := by
    simp [ιt]
  have hιt1 : ιt (MvPolynomial.X 1) = Ideal.Quotient.mk Iq (MvPolynomial.X 1) := by
    simp [ιt]
  have hιtI : ∀ x ∈ Ig, ιt x = 0 := by
    intro x hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    have hrel : ιt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 := by
      rw [map_sub, map_mul, hιt0, hιt1, hιtC, map_mul, mul_assoc, hIq0, hgq, map_mul, map_mul,
        sub_self]
    rw [map_mul, hrel, mul_zero]
  let ι : MvPolynomial (Fin 2) ↥W ⧸ Ig →+* MvPolynomial (Fin 2) ↥W ⧸ Iq :=
    Ideal.Quotient.lift Ig ιt hιtI
  have hιmk : ∀ x, ι (Ideal.Quotient.mk Ig x) = ιt x := fun x => Ideal.Quotient.lift_mk Ig ιt hιtI
  let ψt : MvPolynomial (Fin 2) ↥W →+* Polynomial (Localization.Away h) ⧸ I :=
    MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp
        (Polynomial.C.comp (algebraMap ↥W (Localization.Away h))))
      ![Ideal.Quotient.mk I Polynomial.X,
        Ideal.Quotient.mk I (Polynomial.C (algebraMap A (Localization.Away h) v))]
  have hψtC : ∀ w, ψt (MvPolynomial.C w) =
      Ideal.Quotient.mk I (Polynomial.C (algebraMap ↥W (Localization.Away h) w)) := by
    intro w; simp [ψt]
  have hψt0 : ψt (MvPolynomial.X 0) = Ideal.Quotient.mk I Polynomial.X := by simp [ψt]
  have hψt1 : ψt (MvPolynomial.X 1) =
      Ideal.Quotient.mk I (Polynomial.C (algebraMap A (Localization.Away h) v)) := by simp [ψt]
  have hψtI : ∀ x ∈ Iq, ψt x = 0 := by
    have hrel : ψt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C q) = 0 := by
      rw [map_sub, map_mul, hψt0, hψt1, hψtC, ← map_mul, ← map_sub, Ideal.Quotient.eq_zero_iff_mem,
        mul_comm]
      exact hg2
    have hle0 : Iq ≤ RingHom.ker ψt := by
      rw [hIqdef, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      exact hrel
    exact fun x hx => hle0 hx
  let ψ₀ : MvPolynomial (Fin 2) ↥W ⧸ Iq →+* Polynomial (Localization.Away h) ⧸ I :=
    Ideal.Quotient.lift Iq ψt hψtI
  have hψ₀mk : ∀ x, ψ₀ (Ideal.Quotient.mk Iq x) = ψt x := fun x =>
    Ideal.Quotient.lift_mk Iq ψt hψtI
  have hXb : Ideal.Quotient.mk I (Polynomial.C (algebraMap ↥W (Localization.Away h) b₀)) *
      Ideal.Quotient.mk I Polynomial.X =
      Ideal.Quotient.mk I (Polynomial.C (algebraMap A (Localization.Away h) u)) := by
    rw [← map_mul, Ideal.Quotient.eq]; exact hg1
  have hcomm : ψ₀.comp ι = ((Ideal.Quotient.mk I).comp Polynomial.C).comp f := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      show ψ₀ (ι (Ideal.Quotient.mk Ig (MvPolynomial.C w))) =
        Ideal.Quotient.mk I (Polynomial.C (f (Ideal.Quotient.mk Ig (MvPolynomial.C w))))
      rw [hιmk, hιtC, hψ₀mk, hψtC, hfCw]
    · intro i
      fin_cases i
      · show ψ₀ (ι (Ideal.Quotient.mk Ig (MvPolynomial.X 0))) =
          Ideal.Quotient.mk I (Polynomial.C (f (Ideal.Quotient.mk Ig (MvPolynomial.X 0))))
        rw [hιmk, hιt0, hψ₀mk, map_mul, hψtC, hψt0, hXb, hfX0]
      · show ψ₀ (ι (Ideal.Quotient.mk Ig (MvPolynomial.X 1))) =
          Ideal.Quotient.mk I (Polynomial.C (f (Ideal.Quotient.mk Ig (MvPolynomial.X 1))))
        rw [hιmk, hιt1, hψ₀mk, hψt1, hfX1]
  have hψ₀et : RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸ Iq)
      (S := Polynomial (Localization.Away h) ⧸ I) ψ₀ := by
    refine gen (MvPolynomial (Fin 2) ↥W ⧸ Ig) (MvPolynomial (Fin 2) ↥W ⧸ Iq) (Localization.Away h)
      (Polynomial (Localization.Away h) ⧸ I) ι f ψ₀ ((Ideal.Quotient.mk I).comp Polynomial.C)
      hfet hcomm ?_ ?_
    · intro T _ α β hαβ
      have hβC : ∀ w, β (algebraMap ↥W (Localization.Away h) w) =
          α (Ideal.Quotient.mk Iq (MvPolynomial.C w)) := by
        intro w
        have := RingHom.congr_fun hαβ (Ideal.Quotient.mk Ig (MvPolynomial.C w))
        rw [RingHom.comp_apply, RingHom.comp_apply, hιmk, hιtC, hfCw] at this
        exact this.symm
      have hβu : β (algebraMap A (Localization.Away h) u) =
          α (Ideal.Quotient.mk Iq (MvPolynomial.C b₀ * MvPolynomial.X 0)) := by
        have := RingHom.congr_fun hαβ (Ideal.Quotient.mk Ig (MvPolynomial.X 0))
        rw [RingHom.comp_apply, RingHom.comp_apply, hιmk, hιt0, hfX0] at this
        exact this.symm
      have hβv : β (algebraMap A (Localization.Away h) v) =
          α (Ideal.Quotient.mk Iq (MvPolynomial.X 1)) := by
        have := RingHom.congr_fun hαβ (Ideal.Quotient.mk Ig (MvPolynomial.X 1))
        rw [RingHom.comp_apply, RingHom.comp_apply, hιmk, hιt1, hfX1] at this
        exact this.symm
      let γt : Polynomial (Localization.Away h) →+* T :=
        Polynomial.eval₂RingHom β (α (Ideal.Quotient.mk Iq (MvPolynomial.X 0)))
      have hγtC : ∀ b, γt (Polynomial.C b) = β b := fun b => Polynomial.eval₂_C _ _
      have hγtX : γt Polynomial.X = α (Ideal.Quotient.mk Iq (MvPolynomial.X 0)) :=
        Polynomial.eval₂_X _ _
      have hγtI : I ≤ RingHom.ker γt := by
        rw [hIdef, Ideal.span_le]
        rintro x (rfl | rfl)
        · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, hγtC, hγtC, hγtX, hβC, hβu,
            ← map_mul, ← map_mul, sub_self]
        · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, hγtC, hγtC, hγtX, hβC, hβv,
            mul_comm (α (Ideal.Quotient.mk Iq (MvPolynomial.X 1))), ← map_mul, hIq0, sub_self]
      let γ : Polynomial (Localization.Away h) ⧸ I →+* T :=
        Ideal.Quotient.lift I γt (fun a ha => hγtI ha)
      have hγmk : ∀ x, γ (Ideal.Quotient.mk I x) = γt x := fun x =>
        Ideal.Quotient.lift_mk I γt _
      refine ⟨γ, ?_, ?_⟩
      · apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro w
          show γ (ψ₀ (Ideal.Quotient.mk Iq (MvPolynomial.C w))) =
            α (Ideal.Quotient.mk Iq (MvPolynomial.C w))
          rw [hψ₀mk, hψtC, hγmk, hγtC, hβC]
        · intro i
          fin_cases i
          · show γ (ψ₀ (Ideal.Quotient.mk Iq (MvPolynomial.X 0))) =
              α (Ideal.Quotient.mk Iq (MvPolynomial.X 0))
            rw [hψ₀mk, hψt0, hγmk, hγtX]
          · show γ (ψ₀ (Ideal.Quotient.mk Iq (MvPolynomial.X 1))) =
              α (Ideal.Quotient.mk Iq (MvPolynomial.X 1))
            rw [hψ₀mk, hψt1, hγmk, hγtC, hβv]
      · apply RingHom.ext
        intro b
        show γ (Ideal.Quotient.mk I (Polynomial.C b)) = β b
        rw [hγmk, hγtC]
    · intro T _ β₁ β₂ h1 h2
      apply Ideal.Quotient.ringHom_ext
      apply Polynomial.ringHom_ext
      · intro b
        exact RingHom.congr_fun h2 b
      · have := RingHom.congr_fun h1 (Ideal.Quotient.mk Iq (MvPolynomial.X 0))
        rw [RingHom.comp_apply, RingHom.comp_apply, hψ₀mk, hψt0] at this
        exact this

  obtain ⟨hRqd, hRqic⟩ : IsDomain (MvPolynomial (Fin 2) ↥W ⧸ Iq) ∧
      IsIntegrallyClosed (MvPolynomial (Fin 2) ↥W ⧸ Iq) := wcNd_nodal_poly_normal Ω W q hq0
  haveI := hRqd
  haveI := hRqic
  have hb0q : Ideal.Quotient.mk Iq (MvPolynomial.C b₀) ≠ 0 := by
    intro h0
    let ev : MvPolynomial (Fin 2) ↥W →+* ↥W := MvPolynomial.eval₂Hom (RingHom.id ↥W) ![q, 1]
    have hev : ∀ x ∈ Iq, ev x = 0 := by
      intro x hx
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      simp [ev]
    have h1 := congrArg (Ideal.Quotient.lift Iq ev hev) h0
    rw [Ideal.Quotient.lift_mk, map_zero] at h1
    exact hb0 (by simpa [ev] using h1)
  have hnzd : ∀ p : Polynomial (Localization.Away h),
      Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) * p ∈ I → p ∈ I := by
    intro p hp
    have nzdGen : ∀ (R Q : Type u) [CommRing R] [IsDomain R] [CommRing Q] (ψ' : R →+* Q) (r : R),
        ψ'.Etale → r ≠ 0 → ∀ x : Q, ψ' r * x = 0 → x = 0 := by
      intro R Q _ _ _ ψ' r hψ' hr x hx
      letI : Algebra R Q := ψ'.toAlgebra
      haveI : Algebra.Etale R Q := hψ'
      haveI : Module.Flat R Q := inferInstance
      have hsr : IsSMulRegular R r := IsLeftRegular.isSMulRegular (mul_right_injective₀ hr)
      have hsrB := hsr.of_flat (S := Q)
      apply hsrB
      show ψ' r * x = ψ' r * 0
      rw [hx, mul_zero]
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    refine nzdGen (MvPolynomial (Fin 2) ↥W ⧸ Iq) (Polynomial (Localization.Away h) ⧸ I) ψ₀
      (Ideal.Quotient.mk Iq (MvPolynomial.C b₀)) hψ₀et hb0q _ ?_
    rw [hψ₀mk, hψtC, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact hp
  have hit : ∀ (n : ℕ) (p : Polynomial (Localization.Away h)),
      Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ n * p ∈ I → p ∈ I := by
    intro n
    induction n with
    | zero => intro p hp; simpa using hp
    | succ n ih =>
      intro p hp
      apply ih
      apply hnzd
      rw [← mul_assoc, ← pow_succ']
      exact hp

  have hdesc : ∀ p : Polynomial (Localization.Away h), ∃ (n : ℕ) (c : Localization.Away h),
      Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ n * p - Polynomial.C c ∈ I := by
    intro p
    induction p using Polynomial.induction_on with
    | C a => exact ⟨0, a, by simp⟩
    | add p r hp hr =>
      obtain ⟨n, c, hc⟩ := hp
      obtain ⟨m, d, hd⟩ := hr
      refine ⟨n + m, algebraMap ↥W (Localization.Away h) b₀ ^ m * c +
        algebraMap ↥W (Localization.Away h) b₀ ^ n * d, ?_⟩
      have e : Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ (n + m) * (p + r) -
          Polynomial.C (algebraMap ↥W (Localization.Away h) b₀ ^ m * c +
            algebraMap ↥W (Localization.Away h) b₀ ^ n * d) =
          Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ m *
            (Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ n * p - Polynomial.C c) +
          Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ n *
            (Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ m * r - Polynomial.C d) := by
        simp only [map_add, map_mul, map_pow]; ring
      rw [e]
      exact I.add_mem (I.mul_mem_left _ hc) (I.mul_mem_left _ hd)
    | monomial n a ih =>
      obtain ⟨k, c, hc⟩ := ih
      refine ⟨k + 1, c * algebraMap A (Localization.Away h) u, ?_⟩
      have e : Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ (k + 1) *
          (Polynomial.C a * Polynomial.X ^ (n + 1)) -
          Polynomial.C (c * algebraMap A (Localization.Away h) u) =
          (Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) ^ k *
            (Polynomial.C a * Polynomial.X ^ n) - Polynomial.C c) *
            (Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) * Polynomial.X) +
          Polynomial.C c * (Polynomial.C (algebraMap ↥W (Localization.Away h) b₀) * Polynomial.X -
            Polynomial.C (algebraMap A (Localization.Away h) u)) := by
        simp only [map_mul]; ring
      rw [e]
      exact I.add_mem (I.mul_mem_right _ hc) (I.mul_mem_left _ hg1)
  have hIker : I ≤ RingHom.ker (Polynomial.aeval (R := Localization.Away h) s) := by
    rw [hIdef, Ideal.span_le]
    rintro x (rfl | rfl)
    · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, Polynomial.aeval_C,
        Polynomial.aeval_C, Polynomial.aeval_X, hbs, sub_self]
    · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, Polynomial.aeval_C,
        Polynomial.aeval_C, Polynomial.aeval_X, hvs', sub_self]
  have hker : RingHom.ker (Polynomial.aeval (R := Localization.Away h) s) = I := by
    refine le_antisymm ?_ hIker
    intro p hp
    rw [RingHom.mem_ker] at hp
    obtain ⟨n, c, hc⟩ := hdesc p
    have hc0 : c = 0 := by
      have h1 := hIker hc
      rw [RingHom.mem_ker, map_sub, map_mul, hp, mul_zero, zero_sub, Polynomial.aeval_C,
        neg_eq_zero] at h1
      exact hinjB (by rw [h1, map_zero])
    rw [hc0, map_zero, sub_zero] at hc
    exact hit n p hc

  set S : Subalgebra (Localization.Away h) K := Algebra.adjoin (Localization.Away h) {s}
    with hSdef
  set u₃ : S := ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hu₃def
  let σ : Polynomial (Localization.Away h) →+* S := (Polynomial.aeval u₃).toRingHom
  have hσ : ∀ p, ((σ p : S) : K) = Polynomial.aeval s p := fun p =>
    Polynomial.aeval_subalgebra_coe p S u₃
  have hσsurj : Function.Surjective σ := by
    intro x
    obtain ⟨p, hp⟩ := Algebra.adjoin_eq_exists_aeval _ s x
    exact ⟨p, Subtype.ext ((hσ p).trans hp)⟩
  have hkσ : I = RingHom.ker σ := by
    rw [← hker]
    ext p
    rw [RingHom.mem_ker, RingHom.mem_ker, ← hσ]
    exact ⟨fun h0 => Subtype.ext h0, fun h0 => by rw [h0]; rfl⟩
  let e : (Polynomial (Localization.Away h) ⧸ I) ≃+* S :=
    (Ideal.quotEquivOfEq hkσ).trans (RingHom.quotientKerEquivOfSurjective hσsurj)
  have he : ∀ p, e (Ideal.Quotient.mk I p) = σ p := fun p => by
    show (RingHom.quotientKerEquivOfSurjective hσsurj)
      ((Ideal.quotEquivOfEq hkσ) (Ideal.Quotient.mk I p)) = _
    rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
  let ψ : (MvPolynomial (Fin 2) ↥W ⧸ Iq) →+* S := e.toRingHom.comp ψ₀
  have hψet : RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸ Iq) (S := S) ψ :=
    RingHom.Etale.respectsIso.1 _ e hψ₀et
  set v₃ : S := algebraMap (Localization.Away h) S (algebraMap A (Localization.Away h) v)
    with hv₃def
  have hψC : ∀ w, ψ (Ideal.Quotient.mk Iq (MvPolynomial.C w)) =
      algebraMap (Localization.Away h) S (algebraMap ↥W (Localization.Away h) w) := by
    intro w
    show e (ψ₀ _) = _
    rw [hψ₀mk, hψtC, he]
    exact Polynomial.aeval_C u₃ _
  have hψ0 : ψ (Ideal.Quotient.mk Iq (MvPolynomial.X 0)) = u₃ := by
    show e (ψ₀ _) = _
    rw [hψ₀mk, hψt0, he]
    exact Polynomial.aeval_X u₃
  have hψ1 : ψ (Ideal.Quotient.mk Iq (MvPolynomial.X 1)) = v₃ := by
    show e (ψ₀ _) = _
    rw [hψ₀mk, hψt1, he]
    exact Polynomial.aeval_C u₃ _

  letI algWS : Algebra ↥W S :=
    ((algebraMap (Localization.Away h) S).comp (algebraMap ↥W (Localization.Away h))).toAlgebra
  have hAWS : algebraMap ↥W S =
      (algebraMap (Localization.Away h) S).comp (algebraMap ↥W (Localization.Away h)) := rfl
  have hψCc : ψ.comp ((Ideal.Quotient.mk Iq).comp MvPolynomial.C) = algebraMap ↥W S :=
    RingHom.ext fun w => hψC w
  set φ : A →+* S := (algebraMap (Localization.Away h) S).comp (algebraMap A (Localization.Away h))
    with hφdef
  have hinjS : Function.Injective (algebraMap S K) := Subtype.val_injective
  have hWK : ∀ w : ↥W, algebraMap S K (algebraMap ↥W S w) =
