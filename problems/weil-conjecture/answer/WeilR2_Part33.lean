    haveI hregFS := wcpa_dj_lr1k_gn_delta_zero_regular _ (le_of_eq hdimFS) hδ

    obtain ⟨Q', hQ'max, hQ'c, ⟨e'⟩⟩ := wcpa_dj_llsm_flsc_fibre_iso ↥W ↥(integralClosure R L) Q hIQ
    haveI := hQ'max
    haveI hregF : IsRegularLocalRing (Localization.AtPrime Q ⧸ (Ideal.map
        (algebraMap ↥W ↥(integralClosure R L)) (IsLocalRing.maximalIdeal ↥W)).map
