              (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩)) i ∈ _
          rw [hzero]
          exact Subalgebra.zero_mem _
      | algebraMap a =>
        obtain ⟨c, hc⟩ := hθ i a
        have e : wcIcxIncl L _ _ hIC (algebraMap ↥(wcIcxRI W A K u a' b)
            ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
            ⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩) =
            algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
              (algebraMap A _ a) := Subtype.ext rfl
        change ψ (wcIcxIncl L _ _ hIC (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
          ⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩)) i ∈ _
        rw [e, hc]
        exact hCmem _ c
      | add x y hx hy ihx ihy =>
        have hxy' : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : ↥(wcIcxRI W A K u a' b)) =
            ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
        rw [hxy', map_add]
        exact Subalgebra.add_mem _ ihx ihy
      | mul x y hx hy ihx ihy =>
        have hxy' : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : ↥(wcIcxRI W A K u a' b)) =
            ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
        rw [hxy', map_mul]
        exact Subalgebra.mul_mem _ ihx ihy
    let σ := σ0.codRestrict _ hmem
    have hσ : (algebraMap _ (LaurentPolynomial (IsLocalRing.ResidueField ↥W))).comp σ =
        ((Pi.evalRingHom (fun _ : Fin n => LaurentPolynomial (IsLocalRing.ResidueField ↥W)) i).comp
          (ψ.comp (wcIcxIncl L _ _ hIC))).comp (algebraMap ↥(wcIcxRI W A K u a' b)
            ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) := RingHom.ext fun _ => rfl
    exact IsIntegral.map_of_comp_eq σ _ hσ (Algebra.IsIntegral.isIntegral z)

  obtain ⟨hCo, hCI⟩ := core (IsLocalRing.ResidueField ↥W) n (wcIcxIncl L _ _ hRo)
    (wcIcxIncl L _ _ hRI) (wcIcxIncl L _ _ hoC) (wcIcxIncl L _ _ hIC)
    (wcIcxIncl L _ _ (hRo.trans hoC)) (hcomp _ _ _ hRo hoC)
    (RingHom.ext fun _ => Subtype.ext rfl) (hinj _ _ hoC) (hinj _ _ hIC) _ _ hyx hso hsI y₀ hy₀
    ψ hψs IC hψker _ _ hIoC hIIC hIo hII h9 hbo hbI hconn hconstO hconstI hintO hintI
  refine ⟨fun Q₁ Q₂ hQ₁ hQ₂ hc₁ hc₂ hN₁ hN₂ => hCo Q₁ Q₂ hQ₁ hQ₂ hc₁ hc₂ ?_ ?_,
    fun Q₁ Q₂ hQ₁ hQ₂ hc₁ hc₂ hN₁ hN₂ => hCI Q₁ Q₂ hQ₁ hQ₂ hc₁ hc₂ ?_ ?_⟩
  · have hm : (⟨algebraMap A K (algebraMap ↥W A a') / algebraMap A K u,
        Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(wcLlsASbS W A K u a')) ∈
        Q₁.comap (algebraMap ↥(wcLlsASbS W A K u a')
          ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) := by
      rw [hN₁]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    exact hm
  · have hm : (⟨algebraMap A K (algebraMap ↥W A a') / algebraMap A K u,
        Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(wcLlsASbS W A K u a')) ∈
        Q₂.comap (algebraMap ↥(wcLlsASbS W A K u a')
          ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) := by
      rw [hN₂]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    exact hm
  · have hm : (⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
        ↥(wcIcxRI W A K u a' b)) ∈ Q₁.comap (algebraMap ↥(wcIcxRI W A K u a' b)
          ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) := by
      rw [hN₁]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    exact hm
  · have hm : (⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :
        ↥(wcIcxRI W A K u a' b)) ∈ Q₂.comap (algebraMap ↥(wcIcxRI W A K u a' b)
          ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) := by
      rw [hN₂]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    exact hm

theorem wcpa_dj_llsm_isic_ends : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W)
    (hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a')
    (hRI : wcLlsASbS W A K u b ≤ wcIcxRI W A K u a' b),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    wcLlsAnnSep W A K L u a' → wcLlsIsiSep2 W A K L u a' b → wcLlsIsiCirc W A K L u a' →
    ∀ (y₀ : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y₀.IsPrime →
    y₀.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    ∃ (Qo 𝔷o : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
      (QI 𝔷I : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)),
      Qo.IsPrime ∧ 𝔷o.IsPrime ∧ QI.IsPrime ∧ 𝔷I.IsPrime ∧
      Qo.comap (wcIcxIncl L _ _ hRo) = y₀ ∧ QI.comap (wcIcxIncl L _ _ hRI) = y₀ ∧
      Qo.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
        wcLlsASbN W A K u a' ∧
      QI.comap (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) =
        wcIcxNI W A K u a' b ∧
      𝔷o ≤ Qo ∧ 𝔷I ≤ QI ∧
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ c : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w → c ∈ 𝔷o) ∧
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L),
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w → c ∈ 𝔷I) ∧
      (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
          ⟨algebraMap A K (algebraMap ↥W A a') / algebraMap A K u,
            Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔷o ∧
        algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
          (algebraMap A ↥(wcLlsASbS W A K u a') u) ∉ 𝔷o) ∧
      (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
          ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∈ 𝔷I ∧
        algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)
          ⟨wcLlsIsiS2 W A K u b,
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ ∉ 𝔷I) ∧
      (∀ x : ↥(integralClosure ↥(wcLlsASbS W A K u b) L),
        wcIcxIncl L _ _ hRo x ∈ 𝔷o → wcIcxIncl L _ _ hRI x ∈ 𝔷I →
        ∃ σ : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), σ ∉ y₀ ∧ ∃ n : ℕ, σ * x ^ n ∈
          Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
            ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
              (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hRo hRI hPD ha'm ha'0 hbm hb0
    ha'b hnba hbg hAo hIs hCirc y₀ hy₀ hy₀c
  classical
  haveI := hy₀
  have hPD' := hPD
  obtain ⟨_, hNZ, _, h𝔭max, _, _, hg0, huv, h𝔭eq, _⟩ := hPD'
  obtain ⟨e, he⟩ := ha'b
  obtain ⟨hh, hgh⟩ := hbg
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hwK : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    apply hw
    apply hWA
    rw [map_zero]
    exact IsFractionRing.injective A K (h.trans (map_zero _).symm)
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    have hu : u = 0 := IsFractionRing.injective A K (h.trans (map_zero _).symm)
    rw [hu, zero_mul] at huv
    exact hg0 (hWA (huv.symm.trans (map_zero _).symm))
  have ha0 := hwK a' ha'0
  have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hne
    have hu : IsUnit e := IsLocalRing.notMem_maximalIdeal.mp hne
    exact hnba (he ▸ hu.mul_right_dvd.mpr (dvd_refl a'))
  have hgm : a' ∣ g := ⟨e * hh, by rw [hgh, he, mul_assoc]⟩

  have hsK : algebraMap A K (algebraMap ↥W A b) / algebraMap A K u =
      algebraMap A K (algebraMap ↥W A e) * (algebraMap A K (algebraMap ↥W A a') / algebraMap A K u) := by
    rw [he, map_mul, map_mul]; ring
  have hxsK : algebraMap A K u / algebraMap A K (algebraMap ↥W A a') *
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) = algebraMap A K (algebraMap ↥W A e) := by
    rw [he, map_mul, map_mul]; field_simp
  have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A hh) *
      (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) := by
    have h1 : algebraMap A K u * algebraMap A K v =
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K (algebraMap ↥W A hh) := by
      rw [← map_mul, huv, hgh, map_mul, map_mul]
    field_simp
    rw [mul_comm (algebraMap A K v), h1]; ring

  have hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a' := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff]
    exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton_iff.mpr rfl))
  have hIC : wcIcxRI W A K u a' b ≤ wcLlsIsiCR W A K u a' := by
    apply Algebra.adjoin_le
    intro z hz
    rcases hz with rfl | hz
    · exact Algebra.subset_adjoin (Set.mem_insert _ _)
    · rw [Set.mem_singleton_iff] at hz
      subst hz
      show algebraMap A K (algebraMap ↥W A b) / algebraMap A K u ∈ _
      rw [hsK]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton_iff.mpr rfl)))

  have hmin : ∀ {B C : Type u} [CommRing B] [CommRing C] (ι : B →+* C) (I : Ideal B) (J : Ideal C),
      I ≤ J.comap ι → ∀ E ∈ J.minimalPrimes, ∀ P ∈ I.minimalPrimes, E.comap ι ≤ P →
      P = E.comap ι := by
    intro B C _ _ ι I J hIJ E hE P hP hle
    haveI := hE.1.1
    exact le_antisymm (hP.2 ⟨Ideal.IsPrime.comap ι, hIJ.trans (Ideal.comap_mono hE.1.2)⟩ hle) hle

  set I₀ := Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} with hI₀
  set Io := Ideal.span {c : ↥(integralClosure ↥(wcLlsASbS W A K u a') L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} with hIo
  set II := Ideal.span {c : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} with hII
  have hw0 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w)) ∈ I₀ :=
    fun w hw => Ideal.subset_span ⟨w, hw, rfl⟩
  have hI₀o : I₀ ≤ Io.comap (wcIcxIncl L _ _ hRo) := by
    rw [hI₀, Ideal.span_le]
    rintro c ⟨w, hw, hc⟩
    exact Ideal.subset_span ⟨w, hw, hc⟩
  have hI₀I : I₀ ≤ II.comap (wcIcxIncl L _ _ hRI) := by
    rw [hI₀, Ideal.span_le]
    rintro c ⟨w, hw, hc⟩
    exact Ideal.subset_span ⟨w, hw, hc⟩

  have hN₀y : ∀ x, x ∈ wcLlsASbN W A K u b →
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L) x ∈ y₀ := by
    intro x hx
    rw [← hy₀c] at hx
    exact hx
  have hu₀y : algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      (algebraMap A ↥(wcLlsASbS W A K u b) u) ∈ y₀ :=
    hN₀y _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
  have hs₀y : algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
      ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
        Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ y₀ :=
    hN₀y _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
  have hm₀y : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w)) ∈ y₀ :=
    fun w hw => hN₀y _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw))

  have hNo : ∀ Q : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L), Q.IsPrime →
      Q.comap (wcIcxIncl L _ _ hRo) = y₀ →
      algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
        ⟨algebraMap A K (algebraMap ↥W A a') / algebraMap A K u,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ Q →
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
        wcLlsASbN W A K u a' := by
    intro Q hQ hQy hyQ
    have hle : wcLlsASbN W A K u a' ≤
        Q.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) := by
      apply sup_le
      · rw [Ideal.span_le]
        intro z hz
        rcases hz with rfl | hz
        · have h1 : wcIcxIncl L _ _ hRo (algebraMap ↥(wcLlsASbS W A K u b)
              ↥(integralClosure ↥(wcLlsASbS W A K u b) L) (algebraMap A ↥(wcLlsASbS W A K u b) u)) ∈ Q := by
            rw [← Ideal.mem_comap, hQy]; exact hu₀y
          exact h1
        · rw [Set.mem_singleton_iff] at hz
          subst hz
          exact hyQ
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        have h1 : wcIcxIncl L _ _ hRo (algebraMap ↥(wcLlsASbS W A K u b)
            ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
              (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w))) ∈ Q := by
          rw [← Ideal.mem_comap, hQy]; exact hm₀y w hw
        exact h1
    have hne : Q.comap (algebraMap ↥(wcLlsASbS W A K u a')
        ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) ≠ ⊤ := (Ideal.IsPrime.comap _).ne_top
    have hmax : (wcLlsASbN W A K u a').IsMaximal :=
      wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u a' hPD
        (Or.inr ⟨v, g, rfl, hgm⟩) ha'm ha'0 _ rfl (fun h => hne (top_le_iff.mp (h ▸ hle)))
    exact (hmax.eq_of_le hne hle).symm

  have hcongI : ∀ r : ↥(wcIcxRI W A K u a' b), ∃ a : A,
      r - algebraMap A ↥(wcIcxRI W A K u a' b) a ∈ wcIcxNI W A K u a' b := by
    rintro ⟨r, hr⟩
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨0, ?_⟩
      rw [map_zero, sub_zero]
      apply Ideal.mem_sup_left
      apply Ideal.subset_span
      rcases hx with rfl | hx
      · exact Set.mem_insert _ _
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact Set.mem_insert_of_mem _ rfl
    | algebraMap a =>
      exact ⟨a, by
        convert (wcIcxNI W A K u a' b).zero_mem using 1
        exact sub_eq_zero.mpr (Subtype.ext rfl)⟩
    | add x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨c, hc⟩ := ihy
      refine ⟨a + c, ?_⟩
      have hxy : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : ↥(wcIcxRI W A K u a' b)) =
          ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
      have : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : ↥(wcIcxRI W A K u a' b)) -
          algebraMap A _ (a + c) = (⟨x, hx⟩ - algebraMap A _ a) + (⟨y, hy⟩ - algebraMap A _ c) := by
        rw [hxy, map_add]; ring
      rw [this]; exact Ideal.add_mem _ ha hc
    | mul x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨c, hc⟩ := ihy
      refine ⟨a * c, ?_⟩
      have hxy : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : ↥(wcIcxRI W A K u a' b)) =
          ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
      have : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : ↥(wcIcxRI W A K u a' b)) -
          algebraMap A _ (a * c) = (⟨x, hx⟩ - algebraMap A _ a) * ⟨y, hy⟩ +
            algebraMap A _ a * (⟨y, hy⟩ - algebraMap A _ c) := by
        rw [hxy, map_mul]; ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hc)
  have h𝔭NI : 𝔭 ≤ (wcIcxNI W A K u a' b).comap (algebraMap A ↥(wcIcxRI W A K u a' b)) := by
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with hz | hz
      · rw [hz]
        have : algebraMap A ↥(wcIcxRI W A K u a' b) u =
            algebraMap A _ (algebraMap ↥W A a') *
              ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
          apply Subtype.ext
          show algebraMap A K u = algebraMap A K (algebraMap ↥W A a') *
            (algebraMap A K u / algebraMap A K (algebraMap ↥W A a'))
          field_simp
        show _ ∈ wcIcxNI W A K u a' b
        rw [this]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
      · rw [Set.mem_singleton_iff] at hz
        rw [hz]
        have : algebraMap A ↥(wcIcxRI W A K u a' b) v =
            algebraMap A _ (algebraMap ↥W A hh) *
              ⟨wcLlsIsiS2 W A K u b,
                Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
