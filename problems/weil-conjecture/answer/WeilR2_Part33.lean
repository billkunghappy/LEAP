        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w))
        (Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) |
          ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
            (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x})))
        (Ideal.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          (Localization.AtPrime w)) (![P, P0, P3] i)) := ⟨_, fun _ => rfl⟩
  have hmin : ∀ i, Pf i ∈ minimalPrimes (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) := by
    intro i
    rw [hPf i]
    fin_cases i
    · exact hG1.1
    · exact hG2.1
    · exact hG3.1
  have hback : ∀ i, Ideal.comap (algebraMap
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w))
      (Ideal.comap (Ideal.Quotient.mk (Ideal.map (algebraMap
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w))
        (Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) |
          ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
            (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x})))
        (Pf i)) = ![P, P0, P3] i := by
    intro i
    rw [hPf i]
    fin_cases i
    · exact hG1.2
    · exact hG2.2
    · exact hG3.2
  have hinj : Function.Injective Pf := by
    intro i j hij
    apply inj3 P P0 P3 hne h13 h23
    rw [← hback i, ← hback j, hij]

  obtain ⟨hδ, hbr⟩ := wcpa_dj_lr1k_ll_db_two_minimal_primes _ 3 Pf hinj hmin (by norm_num)
  unfold wcpaDjLkBad at hNB
  rcases not_not.mp hNB with h | ⟨_, h⟩
  · exact hδ h
  · rw [h] at hbr
    norm_num at hbr

theorem wcpa_dj_llsm_fc_glue : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsFcConnW W A K L t c' b' → wcLlsFcFin W A K L t c' b' →
      wcLlsFcUni W A K L t c' b' →
      ∀ e : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
        e * e - e ∈ wcLlsScJ W A K L t c' b' →
          e ∈ wcLlsScJ W A K L t c' b' ∨ e - 1 ∈ wcLlsScJ W A K L t c' b' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' b' hc' hb'm hb'0 hConn hFin hUni
    e he
  classical

  have crt : ∀ (R : Type u) [CommRing R] (J : Ideal R) (v g : R) (N : ℕ),
      J.minimalPrimes.Finite →
      (∀ w : Ideal R, w.IsPrime → J ≤ w → v ∈ w → ∃! P, P ∈ J.minimalPrimes ∧ P ≤ w) →
      (∀ P ∈ J.minimalPrimes, g * (g - v ^ N) ∈ P) →
      ∃ a : R, a * a - a ∈ J.radical ∧ v ^ N * a - g ∈ J.radical := by
    intro R _ J v g N hfin huni hcol
    have hprime : ∀ P ∈ J.minimalPrimes, P.IsPrime := fun P hP => hP.1.1
    have hJle : ∀ P ∈ J.minimalPrimes, J ≤ P := fun P hP => hP.1.2
    have hcomax : (hfin.toFinset.filter (fun P => g ∈ P)).inf id ⊔
        (hfin.toFinset.filter (fun P => g ∉ P)).inf id = ⊤ := by
      by_contra hne
      obtain ⟨w, hw, hle⟩ := Ideal.exists_le_maximal _ hne
      have hwp := hw.isPrime
      obtain ⟨P, hPZ, hPw⟩ := (Ideal.IsPrime.inf_le' hwp).mp (le_trans le_sup_left hle)
      obtain ⟨P', hP'O, hP'w⟩ := (Ideal.IsPrime.inf_le' hwp).mp (le_trans le_sup_right hle)
      simp only [Finset.mem_filter, Set.Finite.mem_toFinset] at hPZ hP'O
      have hgw : g ∈ w := hPw hPZ.2
      have hP'g : g - v ^ N ∈ P' :=
        ((hprime P' hP'O.1).mem_or_mem (hcol P' hP'O.1)).resolve_left hP'O.2
      by_cases hv : v ∈ w
      · obtain ⟨Q, _, huQ⟩ := huni w hwp (le_trans (hJle P hPZ.1) hPw) hv
        have h1 := huQ P ⟨hPZ.1, hPw⟩
        have h2 := huQ P' ⟨hP'O.1, hP'w⟩
        apply hP'O.2
        rw [h2, ← h1]
        exact hPZ.2
      · apply hv
        apply hwp.mem_of_pow_mem N
        have := w.sub_mem hgw (hP'w hP'g)
        simpa using this
    have h1 : (1 : R) ∈ (hfin.toFinset.filter (fun P => g ∈ P)).inf id ⊔
        (hfin.toFinset.filter (fun P => g ∉ P)).inf id := by
      rw [hcomax]; exact Submodule.mem_top
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
    refine ⟨a, ?_, ?_⟩
    · rw [← Ideal.sInf_minimalPrimes]
      refine Submodule.mem_sInf.mpr (fun P hP => ?_)
      have hPF : P ∈ hfin.toFinset := hfin.mem_toFinset.mpr hP
      by_cases hg : g ∈ P
      · have haP : a ∈ P := Finset.inf_le (f := id) (Finset.mem_filter.mpr ⟨hPF, hg⟩) ha
        have : a * a - a = a * (a - 1) := by ring
        rw [this]
        exact Ideal.mul_mem_right _ P haP
      · have hbP : b ∈ P := Finset.inf_le (f := id) (Finset.mem_filter.mpr ⟨hPF, hg⟩) hb
        have : a * a - a = -(a * b) := by linear_combination a * hab
        rw [this]
        exact Submodule.neg_mem _ (Ideal.mul_mem_left P _ hbP)
    · rw [← Ideal.sInf_minimalPrimes]
      refine Submodule.mem_sInf.mpr (fun P hP => ?_)
      have hPF : P ∈ hfin.toFinset := hfin.mem_toFinset.mpr hP
      by_cases hg : g ∈ P
      · have haP : a ∈ P := Finset.inf_le (f := id) (Finset.mem_filter.mpr ⟨hPF, hg⟩) ha
        exact Submodule.sub_mem _ (Ideal.mul_mem_left P _ haP) hg
      · have hbP : b ∈ P := Finset.inf_le (f := id) (Finset.mem_filter.mpr ⟨hPF, hg⟩) hb
        have hP'g : g - v ^ N ∈ P := ((hprime P hP).mem_or_mem (hcol P hP)).resolve_left hg
        have : v ^ N * a - g = -(v ^ N * b) - (g - v ^ N) := by
          linear_combination v ^ N * hab
        rw [this]
        exact Submodule.sub_mem _ (Submodule.neg_mem _ (Ideal.mul_mem_left P _ hbP)) hP'g

  have span_descent : ∀ (R S : Type u) [CommRing R] [CommRing S] (ι : R →+* S) (v : R)
      (T : Set R), (∀ x : S, ∃ (N : ℕ) (r : R), ι r = ι v ^ N * x) →
      ∀ x ∈ Ideal.span (ι '' T), ∃ (N : ℕ) (y : R), y ∈ Ideal.span T ∧ ι y = ι v ^ N * x := by
    intro R S _ _ ι v T hden x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨t, ht, rfl⟩ := hx
      exact ⟨0, t, Ideal.subset_span ht, by simp⟩
    | zero => exact ⟨0, 0, Submodule.zero_mem _, by simp⟩
    | add x₁ x₂ _ _ ih₁ ih₂ =>
      obtain ⟨N₁, y₁, hy₁, e₁⟩ := ih₁
      obtain ⟨N₂, y₂, hy₂, e₂⟩ := ih₂
      refine ⟨N₁ + N₂, v ^ N₂ * y₁ + v ^ N₁ * y₂,
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy₁) (Ideal.mul_mem_left _ _ hy₂), ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, e₁, e₂]
      ring
    | smul c x _ ih =>
      obtain ⟨N, y, hy, e⟩ := ih
      obtain ⟨M, r, hr⟩ := hden c
      refine ⟨M + N, r * y, Ideal.mul_mem_left _ _ hy, ?_⟩
      rw [map_mul, hr, e, smul_eq_mul]
      ring

  have away_scale : ∀ (s v : K), s * v = 1 → ∀ z : L,
      IsIntegral ↥(Algebra.adjoin A {s, v}) z →
      ∃ N : ℕ, IsIntegral ↥(Algebra.adjoin A {v}) (algebraMap K L v ^ N * z) := by
    intro s v hsv z hz
    have hvR : v ∈ Algebra.adjoin A {v} := Algebra.subset_adjoin (Set.mem_singleton v)
    have hmono : ∀ p : K, ∀ M M' : ℕ, v ^ M * p ∈ Algebra.adjoin A {v} → M ≤ M' →
        v ^ M' * p ∈ Algebra.adjoin A {v} := by
      intro p M M' h hle
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hle
      have : v ^ (M + k) * p = v ^ k * (v ^ M * p) := by ring
      rw [this]
      exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hvR k) h
    have hclear : ∀ p ∈ Algebra.adjoin A {s, v}, ∃ M : ℕ, v ^ M * p ∈ Algebra.adjoin A {v} := by
      intro p hp
      induction hp using Algebra.adjoin_induction with
      | mem x hx =>
        rcases hx with rfl | hx
        · exact ⟨1, by rw [pow_one, mul_comm, hsv]; exact Subalgebra.one_mem _⟩
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          exact ⟨0, by rw [pow_zero, one_mul]; exact hvR⟩
      | algebraMap r =>
        exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ r⟩
      | add x y _ _ hx hy =>
        obtain ⟨M₁, h₁⟩ := hx
        obtain ⟨M₂, h₂⟩ := hy
        refine ⟨M₁ + M₂, ?_⟩
        rw [mul_add]
        exact Subalgebra.add_mem _ (hmono x M₁ _ h₁ (by omega)) (hmono y M₂ _ h₂ (by omega))
      | mul x y _ _ hx hy =>
        obtain ⟨M₁, h₁⟩ := hx
        obtain ⟨M₂, h₂⟩ := hy
        refine ⟨M₁ + M₂, ?_⟩
        have : v ^ (M₁ + M₂) * (x * y) = (v ^ M₁ * x) * (v ^ M₂ * y) := by ring
        rw [this]
        exact Subalgebra.mul_mem _ h₁ h₂
    obtain ⟨P, hPm, hPz⟩ := hz
    set n := P.natDegree with hn
    choose Mj hMj using fun j => hclear (P.coeff j : K) (P.coeff j).2
    set M := ∑ j ∈ Finset.range (n + 1), Mj j with hM
    have hq : ∀ j : Fin n, ∃ q : ↥(Algebra.adjoin A {v}),
        (q : K) = v ^ (M * (n - (j : ℕ))) * (P.coeff j : K) := by
      intro j
      refine ⟨⟨_, hmono _ (Mj j) _ (hMj j) ?_⟩, rfl⟩
      have h1 : Mj j ≤ M := Finset.single_le_sum (f := Mj) (fun _ _ => Nat.zero_le _)
        (Finset.mem_range.mpr (by omega))
      have h2 : 1 ≤ n - (j : ℕ) := by omega
      calc Mj j ≤ M := h1
        _ = M * 1 := (mul_one M).symm
        _ ≤ M * (n - (j : ℕ)) := Nat.mul_le_mul_left M h2
    choose q hq using hq
    refine ⟨M, ⟨Polynomial.X ^ n + ∑ j : Fin n, Polynomial.C (q j) * Polynomial.X ^ (j : ℕ),
      ?_, ?_⟩⟩
    · exact Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
    · rw [Polynomial.eval₂_eq_sum_range] at hPz
      rw [Finset.sum_range_succ, ← hn, hPm.coeff_natDegree, Finset.sum_range] at hPz
      simp only [Polynomial.eval₂_add, Polynomial.eval₂_finsetSum, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_mul, Polynomial.eval₂_C]
      have key : ∀ j : Fin n, algebraMap (↥(Algebra.adjoin A {v})) L (q j) *
          (algebraMap K L v ^ M * z) ^ (j : ℕ) = algebraMap K L v ^ (M * n) *
          (algebraMap (↥(Algebra.adjoin A {s, v})) L (P.coeff j) * z ^ (j : ℕ)) := by
        intro j
        have e1 : algebraMap (↥(Algebra.adjoin A {v})) L (q j) = algebraMap K L (q j : K) := rfl
        have e2 : algebraMap (↥(Algebra.adjoin A {s, v})) L (P.coeff j) =
            algebraMap K L (P.coeff j : K) := rfl
        rw [e1, e2, hq j, map_mul, map_pow]
        have e3 : M * n = M * (n - (j : ℕ)) + M * (j : ℕ) := by
          rw [← mul_add, Nat.sub_add_cancel j.2.le]
        rw [e3, pow_add, mul_pow, ← pow_mul]
        ring
      rw [Finset.sum_congr rfl (fun j _ => key j), ← Finset.mul_sum]
      have e4 : (algebraMap K L v ^ M * z) ^ n = algebraMap K L v ^ (M * n) * z ^ n := by
        rw [mul_pow, ← pow_mul]
      rw [e4, ← mul_add]
      rw [map_one, one_mul, add_comm] at hPz
      rw [hPz, mul_zero]

  have radmap : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (T : Set R)
      (T' : Set S), (∀ x ∈ T, φ x ∈ Ideal.span T') →
      ∀ x ∈ (Ideal.span T).radical, φ x ∈ (Ideal.span T').radical := by
    intro R S _ _ φ T T' hT x hx
    obtain ⟨n, hn⟩ := hx
    refine ⟨n, ?_⟩
    rw [← map_pow]
    have h1 : Ideal.map φ (Ideal.span T) ≤ Ideal.span T' := by
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨y, hy, rfl⟩
      exact hT y hy
    exact h1 (Ideal.mem_map_of_mem φ hn)

  haveI : NoZeroSMulDivisors ↥W A := hPD.2.1
  have hbA : algebraMap ↥W A b' ≠ 0 := by
    rw [Algebra.algebraMap_eq_smul_one]
    exact smul_ne_zero hb'0 one_ne_zero
  have hbK : algebraMap A K (algebraMap ↥W A b') ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hbA

  obtain ⟨φ₁, hφ₁⟩ : ∃ φ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) →+*
      ↥(integralClosure ↥(Algebra.adjoin A
        {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
      ∀ x, (φ x : L) = (x : L) :=
    ⟨wcIcxIncl L _ _ (Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))),
      fun _ => rfl⟩
  obtain ⟨φ₂, hφ₂⟩ : ∃ φ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) →+*
      ↥(integralClosure ↥(Algebra.adjoin A
        {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
      ∀ x, (φ x : L) = (x : L) :=
    ⟨wcIcxIncl L _ _ (Algebra.adjoin_mono (Set.singleton_subset_iff.mpr
      (Set.mem_insert_of_mem _ (Set.mem_singleton _)))), fun _ => rfl⟩
  have hinj : Function.Injective φ₂ := fun a b h =>
    Subtype.ext (by rw [← hφ₂ a, ← hφ₂ b, h])
  obtain ⟨Ũ, hŨ⟩ : ∃ z : ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
      (z : L) = algebraMap K L (wcLlsScS W A K t c' b') :=
    ⟨algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) _
      ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_insert _ _)⟩, rfl⟩
  have mk12 : ∀ w : ↥W, ∃ z : ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
      (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) := fun w =>
    ⟨algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) _
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'})
        (algebraMap ↥W A w)), rfl⟩
  have mk2 : ∀ w : ↥W, ∃ z : ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsScV W A K t c' b'}) L),
      (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) := fun w =>
    ⟨algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) _
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A w)), rfl⟩
  have hVel : ((wcLlsFcVel W A K L t c' b' : _) : L) = algebraMap K L (wcLlsScV W A K t c' b') :=
    rfl
  have hJU : ∀ x, x ∈ wcLlsScJ W A K L t c' b' → φ₁ x ∈ wcLlsFcJUV W A K L t c' b' := by
    intro x hx
    unfold wcLlsScJ at hx
    unfold wcLlsFcJUV
    refine radmap φ₁ _ _ ?_ x hx
    rintro z ⟨w, hw, hz⟩
    exact Ideal.subset_span ⟨w, hw, by rw [hφ₁]; exact hz⟩
  have hJV : ∀ x, x ∈ wcLlsFcJV W A K L t c' b' → φ₂ x ∈ wcLlsFcJUV W A K L t c' b' := by
    intro x hx
    unfold wcLlsFcJV at hx
    unfold wcLlsFcJUV
    refine radmap φ₂ _ _ ?_ x hx
    rintro z (⟨w, hw, hz⟩ | hz)
    · exact Ideal.subset_span ⟨w, hw, by rw [hφ₂]; exact hz⟩
    · obtain ⟨bt, hbt⟩ := mk12 b'
      have e1 : φ₂ z = bt * Ũ := by
        apply Subtype.ext
        show (φ₂ z : L) = (bt : L) * (Ũ : L)
        rw [hφ₂, hz, hbt, hŨ, ← map_mul]
        congr 1
        unfold wcLlsScS
        field_simp
      rw [e1]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨b', hb'm, hbt⟩)

  by_cases hJVt : wcLlsFcJV W A K L t c' b' = ⊤
  · have h1 : (1 : ↥(integralClosure ↥(Algebra.adjoin A
        {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L)) ∈ wcLlsFcJUV W A K L t c' b' := by
      rw [← map_one φ₂]
      exact hJV 1 (by rw [hJVt]; exact Submodule.mem_top)
    have hUVt : wcLlsFcJUV W A K L t c' b' = ⊤ := (Ideal.eq_top_iff_one _).mpr h1
    rcases hConn e 0 he (by rw [hJVt]; exact Submodule.mem_top)
        ⟨φ₁ e - φ₂ 0, by rw [hUVt]; exact Submodule.mem_top, by
          show (φ₁ e : L) - (φ₂ 0 : L) = _
          rw [hφ₁, hφ₂]⟩ with ⟨h, _⟩ | ⟨h, _⟩
    · exact Or.inl h
    · exact Or.inr h

  obtain ⟨Mx, hMx, hJM⟩ := Ideal.exists_le_maximal _ hJVt
  haveI := hMx.isPrime
  obtain ⟨P₀, hP₀, -⟩ := Ideal.exists_minimalPrimes_le hJM
  have hVel0 : wcLlsFcVel W A K L t c' b' ≠ 0 := fun h => hFin.2 P₀ hP₀ (h ▸ P₀.zero_mem)
  have hV0 : wcLlsScV W A K t c' b' ≠ 0 := by
    intro h
    apply hVel0
    apply Subtype.ext
    rw [hVel, h, map_zero]
    rfl
  have hx0 : algebraMap A K (t - algebraMap ↥W A c') ≠ 0 := by
    intro h
    apply hV0
    unfold wcLlsScV
    rw [h, div_zero]
  have hUV : wcLlsScS W A K t c' b' * wcLlsScV W A K t c' b' = 1 := by
    unfold wcLlsScS wcLlsScV
    field_simp
  have hUp : Ũ * φ₂ (wcLlsFcVel W A K L t c' b') = 1 := by
    apply Subtype.ext
    show (Ũ : L) * (φ₂ _ : L) = _
    rw [hφ₂, hŨ, hVel, ← map_mul, hUV, map_one]
    rfl

  have hden : ∀ y : ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
      ∃ (N : ℕ) (r : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)),
        φ₂ r = φ₂ (wcLlsFcVel W A K L t c' b') ^ N * y := by
    intro y
    obtain ⟨N, hN⟩ := away_scale _ _ hUV (y : L) y.2
    refine ⟨N, ⟨_, hN⟩, ?_⟩
    apply Subtype.ext
    rw [hφ₂, MulMemClass.coe_mul, SubmonoidClass.coe_pow, hφ₂, hVel]
  have hee : φ₁ e * φ₁ e - φ₁ e ∈ wcLlsFcJUV W A K L t c' b' := by
    have := hJU _ he
    rwa [map_sub, map_mul] at this
  obtain ⟨N, g, hg⟩ := hden (φ₁ e)
  unfold wcLlsFcJUV at hee
  obtain ⟨ρ, hρ⟩ := hee
  have hspan : Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
