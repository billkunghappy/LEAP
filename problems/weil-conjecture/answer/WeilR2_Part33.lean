  haveI : IsScalarTower ↥(wcLlsASbS W A K u (a' * q')) K L :=
    IsScalarTower.of_algebraMap_eq (fun x => rfl)
  haveI hC1ic : IsIntegrallyClosed ↥(wcIsicgC1 W A K L u (a' * q')) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI hLQd : IsDomain (Localization.AtPrime Q) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors _ (Ideal.primeCompl_le_nonZeroDivisors Q)
  haveI : IsIntegrallyClosed (Localization.AtPrime Q) :=
    isIntegrallyClosed_of_isLocalization _ Q.primeCompl (Ideal.primeCompl_le_nonZeroDivisors Q)
  have hk_inj := (wcpa_dj_lr1k_ebnb_hens_inj (Localization.AtPrime Q)
    (IsLocalRing.maximalIdeal _) inferInstance P k hk).1
  obtain ⟨hlinj, B, _, α, 𝔫, h𝔫, β, hαf, hloc, hβα⟩ :=
    hlt _ _ _ hinj hfin (wcLlsASbN W A K u (a' * q')) Q hNQ
  have hjZinj : Function.Injective jZ :=
    (wcpa_dj_lr1k_ebnb_hens_inj (Localization.AtPrime (wcLlsASbN W A K u (a' * q')))
      (IsLocalRing.maximalIdeal _) inferInstance PZ eZ heZ).2 P jZ
      (by rw [hjZ]; exact hk_inj.comp hlinj)

  have hjZfin : jZ.Finite :=
    (wcpa_dj_lr1k_ebnb_hens_finite _ B (Localization.AtPrime Q) PZ P α hαf 𝔫 h𝔫 β hloc eZ heZ
