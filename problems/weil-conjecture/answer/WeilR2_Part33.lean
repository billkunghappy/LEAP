    intro c
    apply hinjS
    rw [V1]
    simp only [map_mul, map_sub, hWK, hu₃K]
    linear_combination hus
  have V6 : u₃ * v₃ = algebraMap ↥W S q := by
    apply hinjS
    rw [map_mul, hu₃K, hv₃K, hWK, mul_comm]
    exact hvs

  set 𝔭₃ : Ideal S := Ideal.span {u₃, v₃} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S)
    with h𝔭₃def
  have hu₃mem : u₃ ∈ 𝔭₃ := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv₃mem : v₃ ∈ 𝔭₃ := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hm₃ : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W S w ∈ 𝔭₃ :=
    fun w hw => Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  have hu𝔭 : u ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv𝔭 : v ∈ 𝔭 := by
    rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hw𝔭 : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A w ∈ 𝔭 :=
    fun w hw => hm𝔭 (Ideal.mem_map_of_mem _ hw)
  have hle : 𝔭 ≤ 𝔭₃.comap φ := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro x (rfl | hx)
      · rw [SetLike.mem_coe, Ideal.mem_comap, V3]
        exact Ideal.mul_mem_left _ _ hu₃mem
      · rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe, Ideal.mem_comap]
