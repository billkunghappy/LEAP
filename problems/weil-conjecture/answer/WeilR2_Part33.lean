    have h := Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)
      (algebraMap A' ↥(Algebra.adjoin A' {I1, I2}) (algebraMap ↥W A' w))
    have e1 : algebraMap ↥(Algebra.adjoin A' {I1, I2}) L
        (algebraMap A' ↥(Algebra.adjoin A' {I1, I2}) (algebraMap ↥W A' w)) =
        (algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)) w := by
      show algebraMap K L (algebraMap A' K (algebraMap ↥W A' w)) = _
      rw [hBS1]; rfl
    rw [← e1]; exact h

  have hDen : ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)), Q.IsPrime →
      algebraMap ↥(Algebra.adjoin A {S1, s0}) ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
        ⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∈ Q →
      algebraMap ↥(Algebra.adjoin A {S1, s0}) ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
        ⟨s0, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ ∈ Q →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap ↥(Algebra.adjoin A {S1, s0}) ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
          (algebraMap A ↥(Algebra.adjoin A {S1, s0}) (algebraMap ↥W A w)) ∈ Q) →
      ∀ y : ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L),
        ∃ d x : ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L), d ∉ Q ∧ i x = i d * i' y := by
    intro Q hQ hS1Q hS2Q hmQ
    haveI := hQ
    obtain ⟨NR, hNR⟩ : ∃ NR : Ideal ↥(Algebra.adjoin A {S1, s0}), NR = Q.comap
        (algebraMap ↥(Algebra.adjoin A {S1, s0}) ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)) :=
      ⟨_, rfl⟩
    have hNRp : NR.IsPrime := by rw [hNR]; infer_instance
    haveI := hNRp
    have hJ0 : NR.comap (Subalgebra.inclusion hXle) = Ideal.span
        (((↑) : ↥(Algebra.adjoin A {X}) → K) ⁻¹'
          ({algebraMap A K (t - algebraMap ↥W A c), X} ∪
            (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W))) := by
      refine nodeMax A K 𝔭 {X} hmax _ _ ?_ ?_ ?_ (Ideal.comap_ne_top _ hNRp.ne_top)
      · intro g hg
        have hg' : g = X := hg
        rw [show (⟨g, Algebra.subset_adjoin hg⟩ : ↥(Algebra.adjoin A {X})) =
          ⟨X, Algebra.subset_adjoin (Set.mem_singleton X)⟩ from Subtype.ext hg']
        exact Ideal.subset_span (Or.inl (Or.inr rfl))
      · rw [h𝔭]
        apply sup_le
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
          have e1 : algebraMap A ↥(Algebra.adjoin A {X}) t =
              algebraMap A ↥(Algebra.adjoin A {X}) (t - algebraMap ↥W A c) +
              algebraMap A ↥(Algebra.adjoin A {X}) (algebraMap ↥W A c) := by
            rw [← map_add, sub_add_cancel]
          rw [e1]
          exact add_mem (Ideal.subset_span (Or.inl (Or.inl rfl)))
            (Ideal.subset_span (Or.inr ⟨c, hc, rfl⟩))
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          rw [Ideal.mem_comap, Ideal.mem_comap]
          exact Ideal.subset_span (Or.inr ⟨w, hw, rfl⟩)
      · rw [Ideal.span_le]
        intro y hy
        rw [SetLike.mem_coe, Ideal.mem_comap, hNR, Ideal.mem_comap]
        rcases hy with (hy | hy) | ⟨w, hw, hyw⟩
        · have hy' : (y : K) = algebraMap A K (t - algebraMap ↥W A c) := hy
          have e1 : Subalgebra.inclusion hXle y =
              algebraMap A ↥(Algebra.adjoin A {S1, s0}) (algebraMap ↥W A a') *
                ⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := by
            apply Subtype.ext
            show (y : K) = algebraMap A K (algebraMap ↥W A a') * S1
            rw [hy']
            exact F2
          rw [e1, map_mul]
          exact Ideal.mul_mem_left _ _ hS1Q
        · have hy' : (y : K) = X := hy
          have e1 : Subalgebra.inclusion hXle y =
              ⟨s0, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ := by
            apply Subtype.ext
            show (y : K) = s0
            exact hy'.trans hXs0
          rw [e1]
          exact hS2Q
        · have e1 : Subalgebra.inclusion hXle y =
              algebraMap A ↥(Algebra.adjoin A {S1, s0}) (algebraMap ↥W A w) := by
            apply Subtype.ext
            exact hyw.symm
          rw [e1]
          exact hmQ w hw
    let M : Submonoid K := NR.primeCompl.map (Algebra.adjoin A {S1, s0}).val
    have hMR : ∀ q ∈ M, q ∈ Algebra.adjoin A {S1, s0} := by
      intro q hq
      obtain ⟨r, _, rfl⟩ := Submonoid.mem_map.mp hq
      exact r.2
    have hmul : ∀ r ∈ Algebra.adjoin A' {I1, I2}, ∃ q ∈ M, q * r ∈ Algebra.adjoin A {S1, s0} := by
      intro r hr
      obtain ⟨q, hq, hqr⟩ := adjDen A' K {I1, I2} (Algebra.adjoin A {S1, s0}).toSubring M hMR
        (fun g hg => by
          rcases hg with hg | hg
          · refine ⟨1, one_mem _, ?_⟩
            rw [one_mul, hg, hI1]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
          · rw [Set.mem_singleton_iff] at hg
            refine ⟨1, one_mem _, ?_⟩
            rw [one_mul, hg, hI2]
            exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
        (fun a => by
          obtain ⟨p, q, hq, hpq⟩ := hBS3 (algebraMap A' K a) ⟨a, rfl⟩
          have hqN : Subalgebra.inclusion hXle q ∉ NR := by
            intro h
            apply hq
            have h' : q ∈ NR.comap (Subalgebra.inclusion hXle) := h
            rw [hJ0] at h'
            exact h'
          refine ⟨(q : K), Submonoid.mem_map.mpr ⟨Subalgebra.inclusion hXle q, hqN, rfl⟩, ?_⟩
          rw [mul_comm, hpq]
          exact hXle p.2) r hr
      exact ⟨q, hq, hqr⟩
    intro y
    obtain ⟨q, hqM, hint⟩ := intDen A A' K L (Algebra.adjoin A {S1, s0})
      (Algebra.adjoin A' {I1, I2}) M hMR hmul (y : L) y.2
    obtain ⟨r, hrN, hrq⟩ := Submonoid.mem_map.mp hqM
    refine ⟨algebraMap _ _ r, ⟨_, hint⟩, ?_, ?_⟩
    · intro h
      exact hrN (by rw [hNR]; exact h)
    · show algebraMap K L q * (y : L) = algebraMap K L (r : K) * (y : L)
      rw [← hrq]
      rfl

  intro Q' hQ' hQ'N
  rw [hwL]
  have hI1Q' : algebraMap ↥(Algebra.adjoin A' {I1, I2})
      ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)
      ⟨I1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∈ Q' := by
    have h : (⟨I1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ : ↥(Algebra.adjoin A' {I1, I2})) ∈
        Q'.comap (algebraMap ↥(Algebra.adjoin A' {I1, I2})
          ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)) := by
      rw [hQ'N]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    exact h
  have hI2Q' : algebraMap ↥(Algebra.adjoin A' {I1, I2})
      ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)
      ⟨I2, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ ∈ Q' := by
    have h : (⟨I2, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
        ↥(Algebra.adjoin A' {I1, I2})) ∈
        Q'.comap (algebraMap ↥(Algebra.adjoin A' {I1, I2})
          ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)) := by
      rw [hQ'N]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    exact h
  have hmQ' : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↥(Algebra.adjoin A' {I1, I2}) ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)
        (algebraMap A' ↥(Algebra.adjoin A' {I1, I2}) (algebraMap ↥W A' w)) ∈ Q' := by
    intro w hw
    have h : algebraMap A' ↥(Algebra.adjoin A' {I1, I2}) (algebraMap ↥W A' w) ∈
        Q'.comap (algebraMap ↥(Algebra.adjoin A' {I1, I2})
          ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)) := by
      rw [hQ'N]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A' ↥(Algebra.adjoin A' {I1, I2})).comp (algebraMap ↥W A')) hw)
    exact h
  obtain ⟨Q, hQdef⟩ : ∃ Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L),
      Q = Q'.comap j := ⟨_, rfl⟩
  have hQp : Q.IsPrime := by rw [hQdef]; infer_instance
  haveI := hQp
  have hjmem : ∀ x, j x ∈ Q' ↔ x ∈ Q := fun x => by rw [hQdef, Ideal.mem_comap]
  have hQN : Q.comap (algebraMap ↥(Algebra.adjoin A {S1, s0})
      ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)) =
      Ideal.span {⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩,
        ⟨s0, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {S1, s0})).comp (algebraMap ↥W A)) := by
    refine nodeMax A K 𝔭 {S1, s0} hmax _ _ ?_ ?_ ?_ (Ideal.comap_ne_top _ hQp.ne_top)
    · intro g hg
      rcases hg with hg | hg
      · rw [show (⟨g, Algebra.subset_adjoin (Or.inl hg)⟩ : ↥(Algebra.adjoin A {S1, s0})) =
          ⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ from Subtype.ext hg]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [Set.mem_singleton_iff] at hg
        rw [show (⟨g, Algebra.subset_adjoin (Or.inr hg)⟩ : ↥(Algebra.adjoin A {S1, s0})) =
          ⟨s0, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
          from Subtype.ext hg]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    · rw [h𝔭]
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e1 : algebraMap A ↥(Algebra.adjoin A {S1, s0}) t =
            algebraMap A ↥(Algebra.adjoin A {S1, s0}) (algebraMap ↥W A a') *
              ⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ +
            algebraMap A ↥(Algebra.adjoin A {S1, s0}) (algebraMap ↥W A c) := by
          apply Subtype.ext
          show algebraMap A K t =
            algebraMap A K (algebraMap ↥W A a') * S1 + algebraMap A K (algebraMap ↥W A c)
          rw [← F2, ← map_add, sub_add_cancel]
        rw [e1]
        exact add_mem
          (Ideal.mul_mem_left _ _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))))
          (Ideal.mem_sup_right (Ideal.mem_map_of_mem
            ((algebraMap A ↥(Algebra.adjoin A {S1, s0})).comp (algebraMap ↥W A)) hc))
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
          ((algebraMap A ↥(Algebra.adjoin A {S1, s0})).comp (algebraMap ↥W A)) hw)
    · apply sup_le
      · rw [Ideal.span_le]
        intro y hy
        rcases hy with hy | hy
        · rw [hy, SetLike.mem_coe, Ideal.mem_comap, ← hjmem]
          have e1 : j (algebraMap ↥(Algebra.adjoin A {S1, s0})
              ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
              ⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩) =
              algebraMap ↥(Algebra.adjoin A' {I1, I2})
                ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)
                ⟨I1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ :=
            Subtype.ext (by
              show algebraMap K L S1 = algebraMap K L I1
              rw [hI1])
          rw [e1]
          exact hI1Q'
        · rw [Set.mem_singleton_iff] at hy
          rw [hy, SetLike.mem_coe, Ideal.mem_comap, ← hjmem]
          have e1 : j (algebraMap ↥(Algebra.adjoin A {S1, s0})
              ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
              ⟨s0, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩) =
              algebraMap ↥(Algebra.adjoin A' {I1, I2})
                ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)
                ⟨I2, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :=
            Subtype.ext (by
              show algebraMap K L s0 = algebraMap K L I2
              rw [hI2])
          rw [e1]
          exact hI2Q'
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap, ← hjmem]
        have e1 : j (algebraMap ↥(Algebra.adjoin A {S1, s0})
            ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
            (((algebraMap A ↥(Algebra.adjoin A {S1, s0})).comp (algebraMap ↥W A)) w)) =
            algebraMap ↥(Algebra.adjoin A' {I1, I2})
              ↥(integralClosure ↥(Algebra.adjoin A' {I1, I2}) L)
              (algebraMap A' ↥(Algebra.adjoin A' {I1, I2}) (algebraMap ↥W A' w)) :=
          Subtype.ext (by
            show algebraMap K L (algebraMap A K (algebraMap ↥W A w)) =
              algebraMap K L (algebraMap A' K (algebraMap ↥W A' w))
            rw [hBS1])
        rw [e1]
        exact hmQ' w hw
  have hnb := hMid Q hQN
  have hS1Q : algebraMap ↥(Algebra.adjoin A {S1, s0})
      ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
      ⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∈ Q := by
    have h : (⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ : ↥(Algebra.adjoin A {S1, s0})) ∈
        Q.comap (algebraMap ↥(Algebra.adjoin A {S1, s0})
          ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)) := by
      rw [hQN]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    exact h
  have hS2Q : algebraMap ↥(Algebra.adjoin A {S1, s0})
      ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
      ⟨s0, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ ∈ Q := by
    have h : (⟨s0, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩ :
        ↥(Algebra.adjoin A {S1, s0})) ∈
        Q.comap (algebraMap ↥(Algebra.adjoin A {S1, s0})
          ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)) := by
      rw [hQN]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    exact h
  have hmQ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↥(Algebra.adjoin A {S1, s0}) ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)
        (algebraMap A ↥(Algebra.adjoin A {S1, s0}) (algebraMap ↥W A w)) ∈ Q := by
    intro w hw
    have h : algebraMap A ↥(Algebra.adjoin A {S1, s0}) (algebraMap ↥W A w) ∈
        Q.comap (algebraMap ↥(Algebra.adjoin A {S1, s0})
          ↥(integralClosure ↥(Algebra.adjoin A {S1, s0}) L)) := by
      rw [hQN]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {S1, s0})).comp (algebraMap ↥W A)) hw)
    exact h
  have hDen' := hDen Q hQp hS1Q hS2Q hmQ
  obtain ⟨eq, heq⟩ := locEquiv _ _ L i i' j hi hi' hcomp Q Q' hQdef.symm hDen'
  intro hb
  apply hnb
  refine (s7 L ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
    ↥(Algebra.adjoin A {S1, s0}) ↥(Algebra.adjoin A' {I1, I2}) Q Q' eq ?_ hw).mpr hb
  intro x y hxy
  rw [heq]
  congr 1
  exact Subtype.ext hxy

theorem wcpa_dj_llsm_isicg_fibre_split : ∀ (R B : Type u) [CommRing R] [CommRing B] (ι : R →+* B)
    (I : Ideal B) (n : ℕ) (Q : Fin n → Ideal R) [∀ i, (Q i).IsPrime], Function.Injective Q →
    (∀ i, (Q i).IsMaximal) →
    (∀ 𝔓 : Ideal B, 𝔓.IsPrime → I ≤ 𝔓 → ∃ i, 𝔓.comap ι = Q i) →
    ∃ e : B ⧸ I.radical ≃+* (∀ i : Fin n, wcIsicgFib ι I (Q i)),
      ∀ (b : B) (i : Fin n), e (Ideal.Quotient.mk _ b) i = wcIsicgFibMk ι I (Q i) b :=
by
  intro R B _ _ ι I n Q _ hinj hmax hcov
  classical

  have hK : ∀ j, ∀ r ∈ Q j, wcIsicgFibMk ι I (Q j) (ι r) = 0 := by
    intro j r hr
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, Ideal.radical_eq_sInf,
      Ideal.mem_sInf]
    rintro 𝔔 ⟨hle, h𝔔⟩
    have hP : (𝔔.comap (algebraMap B (Localization ((Q j).primeCompl.map ι)))).IsPrime :=
      Ideal.comap_isPrime _ _
    have hIP : I ≤ 𝔔.comap (algebraMap B (Localization ((Q j).primeCompl.map ι))) :=
      Ideal.map_le_iff_le_comap.mp hle
    obtain ⟨i, hi⟩ := hcov _ hP hIP
    have hsub : (𝔔.comap (algebraMap B (Localization ((Q j).primeCompl.map ι)))).comap ι
        ≤ Q j := by
      intro x hx
      by_contra hxQ
      have hm : ι x ∈ (Q j).primeCompl.map ι :=
        Submonoid.mem_map_of_mem ι (show x ∈ (Q j).primeCompl from hxQ)
      have hu := IsLocalization.map_units (Localization ((Q j).primeCompl.map ι))
        (⟨ι x, hm⟩ : (Q j).primeCompl.map ι)
      exact h𝔔.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp (Ideal.mem_comap.mp hx)) hu)
    have heq : (𝔔.comap (algebraMap B (Localization ((Q j).primeCompl.map ι)))).comap ι
        = Q j := by
      rw [hi] at hsub ⊢
      exact (hmax i).eq_of_le (hmax j).ne_top hsub
    have hr' : r ∈ (𝔔.comap (algebraMap B (Localization ((Q j).primeCompl.map ι)))).comap ι :=
      heq.ge hr
    exact Ideal.mem_comap.mp (Ideal.mem_comap.mp hr')

  have hker : ∀ b : B, b ∈ I.radical ↔ ∀ i, wcIsicgFibMk ι I (Q i) b = 0 := by
    intro b
    constructor
    · rintro ⟨m, hm⟩ i
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact ⟨m, by rw [← map_pow]; exact Ideal.mem_map_of_mem _ hm⟩
    · intro h
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro 𝔓 ⟨hI, h𝔓⟩
      obtain ⟨i, hi⟩ := hcov 𝔓 h𝔓 hI
      have hdisj : Disjoint ((Q i).primeCompl.map ι : Set B) (𝔓 : Set B) := by
        rw [Set.disjoint_left]
        intro z hz hz𝔓
        obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hz
        apply hs
        rw [← hi]
        exact hz𝔓
      have hpr := IsLocalization.isPrime_of_isPrime_disjoint ((Q i).primeCompl.map ι)
        (Localization ((Q i).primeCompl.map ι)) 𝔓 h𝔓 hdisj
      have hcomap := IsLocalization.under_map_of_isPrime_disjoint ((Q i).primeCompl.map ι)
        (Localization ((Q i).primeCompl.map ι)) h𝔓 hdisj
      have hb := h i
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem] at hb
      have hle : (I.map (algebraMap B (Localization ((Q i).primeCompl.map ι)))).radical ≤
          𝔓.map (algebraMap B (Localization ((Q i).primeCompl.map ι))) :=
        (hpr.radical_le_iff).mpr (Ideal.map_mono hI)
      have h2 := hle hb
      rw [← hcomap]
      exact h2

  have hfac : ∀ j (r r' : R), r - r' ∈ Q j →
      wcIsicgFibMk ι I (Q j) (ι r) = wcIsicgFibMk ι I (Q j) (ι r') := by
    intro j r r' h
    have := hK j _ h
    rw [map_sub, map_sub, sub_eq_zero] at this
    exact this

  have hfrac : ∀ (y : ∀ i, wcIsicgFib ι I (Q i)) (j : Fin n), ∃ (b : B) (s : R), s ∉ Q j ∧
      y j * wcIsicgFibMk ι I (Q j) (ι s) = wcIsicgFibMk ι I (Q j) b := by
    intro y j
    obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (y j)
    obtain ⟨⟨b, m⟩, hbm⟩ := IsLocalization.mk'_surjective ((Q j).primeCompl.map ι) z
    obtain ⟨s, hs, hsm⟩ := Submonoid.mem_map.mp m.2
    refine ⟨b, s, hs, ?_⟩
    rw [← hz, ← hbm, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, hsm,
      IsLocalization.mk'_spec]

  have hinv : ∀ j (s : R), s ∉ Q j → ∃ t : R,
      wcIsicgFibMk ι I (Q j) (ι t) * wcIsicgFibMk ι I (Q j) (ι s) = 1 := by
    intro j s hs
    obtain ⟨t, i, hi, hti⟩ := (hmax j).exists_inv hs
    refine ⟨t, ?_⟩
    have h1 : t * s - 1 = -i := by rw [← hti]; ring
    have := hfac j (t * s) 1 (by rw [h1]; exact neg_mem hi)
    rw [map_one, map_one] at this
    rw [← map_mul, ← map_mul, this]

  have hcop : Pairwise (Function.onFun IsCoprime Q) := by
    intro i j hij
    rw [Function.onFun, Ideal.isCoprime_iff_sup_eq]
    exact Ideal.IsMaximal.coprime_of_ne (hmax i) (hmax j) (hinj.ne hij)
  have hidem : ∀ i, ∃ e : R, ∀ j,
      wcIsicgFibMk ι I (Q j) (ι e) = if j = i then 1 else 0 := by
    intro i
    obtain ⟨e, he⟩ := Ideal.exists_forall_sub_mem_ideal hcop
      (fun j => if j = i then (1 : R) else 0)
    refine ⟨e, fun j => ?_⟩
    rw [hfac j e _ (he j)]
    split_ifs <;> simp
  let φ : B →+* (∀ i, wcIsicgFib ι I (Q i)) := RingHom.pi (fun i => wcIsicgFibMk ι I (Q i))
  have hsurj : Function.Surjective φ := by
    intro y
    choose b s hs hy using hfrac y
    choose t ht using fun j => hinv j (s j) (hs j)
    choose e he using hidem
    refine ⟨∑ i, ι (e i) * ι (t i) * b i, ?_⟩
    funext j
    show wcIsicgFibMk ι I (Q j) (∑ i, ι (e i) * ι (t i) * b i) = y j
    rw [map_sum]
    simp only [map_mul]
    rw [Finset.sum_eq_single j]
    · rw [he j j, if_pos rfl, one_mul, ← hy j, mul_left_comm, ht j, mul_one]
    · intro i _ hij
      rw [he i j, if_neg (fun h => hij h.symm), zero_mul, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ j) h
  have hkerφ : RingHom.ker φ = I.radical := by
    ext b
    rw [RingHom.mem_ker, hker b, funext_iff]
    exact Iff.rfl
  refine ⟨(Ideal.quotEquivOfEq hkerφ.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj), ?_⟩
  intro b i
  rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk]
  rfl

theorem wcpa_dj_llsm_isicg_over_node : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g →
    ∃ ι : ↥(wcIsicgC1 W A K L u (a' * q')) →+* ↥(wcIsicgB W A K L u a'),
      (∀ x, ((ι x : ↥(wcIsicgB W A K L u a')) : L) = (x : L)) ∧
      {Q : Ideal ↥(wcIsicgC1 W A K L u (a' * q')) | Q.IsPrime ∧
        Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
          wcLlsASbN W A K u (a' * q')}.Finite ∧
      (∀ Q : Ideal ↥(wcIsicgC1 W A K L u (a' * q')), Q.IsPrime →
        Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
          wcLlsASbN W A K u (a' * q') → Q.IsMaximal) ∧
      ∀ 𝔓 : Ideal ↥(wcIsicgB W A K L u a'), 𝔓.IsPrime → wcIsicgIB W A K L u a' ≤ 𝔓 →
        (𝔓.comap ι).comap
          (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
          wcLlsASbN W A K u (a' * q') :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0 hdvd
  classical

  have hWA : ∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ≠ 0 := by
    intro w hw h
    haveI : NoZeroSMulDivisors ↥W A := hPD.2.1
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases eq_zero_or_eq_zero_of_smul_eq_zero h with h1 | h1
    · exact hw h1
    · exact one_ne_zero h1
  have ha'K : algebraMap A K (algebraMap ↥W A a') ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (hWA a' ha'0)
  have hbm : a' * q' ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right q' _ ha'm
  have hb0 : a' * q' ≠ 0 := mul_ne_zero ha'0 hq'0

  have hs₁eq : algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u =
      algebraMap A K (algebraMap ↥W A q') * wcLlsIsiS2 W A K u a' := by
    rw [wcLlsIsiS2]
    simp only [map_mul]
    ring
  have hle : wcLlsASbS W A K u (a' * q') ≤ wcLlsIsiCR W A K u a' := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff]
    show algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u ∈ wcLlsIsiCR W A K u a'
    rw [hs₁eq]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

  have hint : ∀ x : ↥(wcIsicgC1 W A K L u (a' * q')), (x : L) ∈ wcIsicgB W A K L u a' := by
    intro x
    letI : Algebra ↥(wcLlsASbS W A K u (a' * q')) ↥(wcLlsIsiCR W A K u a') :=
      (Subalgebra.inclusion hle).toRingHom.toAlgebra
    haveI : IsScalarTower ↥(wcLlsASbS W A K u (a' * q')) ↥(wcLlsIsiCR W A K u a') L :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    exact IsIntegral.tower_top (A := ↥(wcLlsIsiCR W A K u a')) x.2
  let ι : ↥(wcIsicgC1 W A K L u (a' * q')) →+* ↥(wcIsicgB W A K L u a') :=
    ((wcIsicgC1 W A K L u (a' * q')).val.toRingHom).codRestrict (wcIsicgB W A K L u a') hint

  have hmax_of : wcLlsASbN W A K u (a' * q') ≠ ⊤ → (wcLlsASbN W A K u (a' * q')).IsMaximal := by
    intro hne
    exact wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u (a' * q') hPD
      (Or.inr ⟨v, g, rfl, hdvd⟩) hbm hb0 _ rfl hne

  haveI hfin : Module.Finite ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q')) :=
    wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 (.ann u v g) hPD _
  haveI : Algebra.QuasiFinite ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q')) :=
    Algebra.QuasiFinite.instOfFinite

  have hintR : (algebraMap ↥(wcLlsASbS W A K u (a' * q'))
      ↥(wcIsicgC1 W A K L u (a' * q'))).IsIntegral :=
    fun x => Algebra.IsIntegral.isIntegral x

  have hmem : ∀ (𝔓 : Ideal ↥(wcIsicgB W A K L u a')), wcIsicgIB W A K L u a' ≤ 𝔓 →
      ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A w))) ∈ 𝔓 := by
    intro 𝔓 hI w hw
    apply hI
    apply Ideal.subset_span
    exact ⟨w, hw, rfl⟩
  let xB : ↥(wcIsicgB W A K L u a') :=
    algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
      ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩
  let yB : ↥(wcIsicgB W A K L u a') :=
    algebraMap ↥(wcLlsIsiCR W A K u a') ↥(wcIsicgB W A K L u a')
      ⟨wcLlsIsiS2 W A K u a', Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  have hu : ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) u)) =
      ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A a'))) * xB := by
    apply Subtype.ext
    show algebraMap K L (algebraMap A K u) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A a')) * algebraMap K L (wcLlsIsiS1 W A K u a')
    rw [← map_mul, wcLlsIsiS1, mul_div_cancel₀ _ ha'K]
  have hsR : ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        ⟨algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩) =
      ι (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))
        (algebraMap A ↥(wcLlsASbS W A K u (a' * q')) (algebraMap ↥W A q'))) * yB := by
    apply Subtype.ext
    show algebraMap K L (algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A q')) * algebraMap K L (wcLlsIsiS2 W A K u a')
    rw [← map_mul, hs₁eq]
  refine ⟨ι, fun _ => rfl, ?_, ?_, ?_⟩
  ·
    refine (Algebra.QuasiFinite.finite_primesOver (wcLlsASbN W A K u (a' * q'))).subset ?_
    intro Q hQ
    exact ⟨hQ.1, (Ideal.liesOver_iff _ _).mpr (by rw [Ideal.under_def]; exact hQ.2.symm)⟩
  ·
    intro Q hQ hQc
    have hNp : (wcLlsASbN W A K u (a' * q')).IsPrime := by
      rw [← hQc]; exact Ideal.comap_isPrime _ Q
    have hNmax := hmax_of hNp.ne_top
    exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hintR Q (by rw [hQc]; exact hNmax)
  ·
    intro 𝔓 h𝔓 hI
    haveI : (𝔓.comap ι).IsPrime := Ideal.comap_isPrime ι 𝔓
    have hne : (𝔓.comap ι).comap (algebraMap ↥(wcLlsASbS W A K u (a' * q'))
        ↥(wcIsicgC1 W A K L u (a' * q'))) ≠ ⊤ := (Ideal.comap_isPrime _ _).ne_top
    have hle2 : wcLlsASbN W A K u (a' * q') ≤ (𝔓.comap ι).comap
        (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) := by
      unfold wcLlsASbN
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rcases Set.mem_insert_iff.mp hx with rfl | hx
        · rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, hu]
          exact Ideal.mul_mem_right _ _ (hmem 𝔓 hI a' ha'm)
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, hsR]
          exact Ideal.mul_mem_right _ _ (hmem 𝔓 hI q' hq'm)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hmem 𝔓 hI w hw
    have hNne : wcLlsASbN W A K u (a' * q') ≠ ⊤ := ne_top_of_le_ne_top hne hle2
    exact ((hmax_of hNne).eq_of_le hne hle2).symm

theorem wcpa_dj_llsm_isicg_node_monomial : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' q' : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → q' ≠ 0 →
    a' * q' ∣ g → wcLlsAnnSep W A K L u (a' * q') →
    ∀ (Q : Ideal ↥(wcIsicgC1 W A K L u (a' * q'))) [Q.IsPrime],
      Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) =
        wcLlsASbN W A K u (a' * q') →
      ∃ (P : Type u) (_ : CommRing P) (k : Localization.AtPrime Q →+* P),
        wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P k ∧
        ∃ (β : ↥W) (f : wcEbntN W β →+* P) (η : P) (n : ℕ) (ν : ↥W),
          wcEbntPres W (k.comp (wcIsicgSig W A K L u (a' * q') Q)) β f ∧ IsUnit η ∧ 1 ≤ n ∧
          IsUnit ν ∧ k (wcIsicgU W A K L u (a' * q') Q) = η * f (wcEbntX W β 0) ^ n ∧
          a' * q' = β ^ n * ν :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' q' hPD ha'm ha'0 hq'm hq'0
    hbg hSep Q _ hQ
  classical

  have hlt : ∀ (R C : Type u) [CommRing R] [CommRing C] [IsDomain C] (f : R →+* C),
      Function.Injective f → f.Finite → ∀ (N : Ideal R) [N.IsMaximal] (Q : Ideal C) [Q.IsPrime]
      (hNQ : N = Q.comap f), Function.Injective (Localization.localRingHom N Q f hNQ) ∧
      ∃ (B : Type u) (_ : CommRing B) (α : Localization.AtPrime N →+* B) (𝔫 : Ideal B)
        (h𝔫 : 𝔫.IsMaximal) (β : B →+* Localization.AtPrime Q), α.Finite ∧
        @IsLocalization B _ (@Ideal.primeCompl B _ 𝔫 h𝔫.isPrime) (Localization.AtPrime Q) _
          β.toAlgebra ∧ β.comp α = Localization.localRingHom N Q f hNQ := by
    intro R C _ _ _ f hinj hfin N _ Q _ hNQ
    have hM'Q : N.primeCompl.map f ≤ Q.primeCompl := by
      rintro _ ⟨y, hy, rfl⟩ hyQ
      apply hy
      rw [hNQ]
      exact hyQ
    have hlam : Function.Injective (Localization.localRingHom N Q f hNQ) := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨x, y⟩, rfl⟩ := IsLocalization.mk'_surjective N.primeCompl z
      dsimp only at hz ⊢
      rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hz
      obtain ⟨m, hm⟩ := hz
      have hm0 : (m : C) ≠ 0 := fun h => m.2 (h ▸ Q.zero_mem)
      have hfx : f x = 0 := (mul_eq_zero.mp hm).resolve_left hm0
      have hx : x = 0 := hinj (hfx.trans f.map_zero.symm)
      rw [hx, IsLocalization.mk'_zero]
    refine ⟨hlam, ?_⟩
    let B := Localization (N.primeCompl.map f)
    let α : Localization.AtPrime N →+* B :=
      IsLocalization.map B f (Submonoid.le_comap_map N.primeCompl)
    have hα : α.Finite :=
      RingHom.finite_localizationPreserves f N.primeCompl (Localization.AtPrime N) B hfin
    have hdisj : Disjoint ((N.primeCompl.map f : Submonoid C) : Set C) (Q : Set C) := by
      rw [Set.disjoint_left]
      intro x hx hxQ
      exact hM'Q hx hxQ
    let 𝔫 : Ideal B := Q.map (algebraMap C B)
    have h𝔫p : 𝔫.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (N.primeCompl.map f) B Q inferInstance hdisj
    have h𝔫c : 𝔫.comap (algebraMap C B) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint (N.primeCompl.map f) B inferInstance hdisj
    have hQmax : Q.IsMaximal := by
      have hN : (Q.comap f).IsMaximal := hNQ ▸ inferInstance
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap' f hfin.to_isIntegral Q hN
    have h𝔫 : 𝔫.IsMaximal := by
      obtain ⟨𝔐, h𝔐, h𝔫𝔐⟩ := Ideal.exists_le_maximal 𝔫 h𝔫p.ne_top
      have hle : Q ≤ 𝔐.comap (algebraMap C B) := by
        rw [← h𝔫c]; exact Ideal.comap_mono h𝔫𝔐
      have hne : 𝔐.comap (algebraMap C B) ≠ ⊤ := Ideal.comap_ne_top _ h𝔐.ne_top
      have heq : Q = 𝔐.comap (algebraMap C B) := hQmax.eq_of_le hne hle
      have : 𝔐 = 𝔫 := by
        rw [← IsLocalization.map_under (N.primeCompl.map f) B 𝔐]
        show Ideal.map (algebraMap C B) (𝔐.comap (algebraMap C B)) = Q.map (algebraMap C B)
        rw [← heq]
      rw [← this]; exact h𝔐
    have hu : ∀ y : N.primeCompl.map f, IsUnit (algebraMap C (Localization.AtPrime Q) y) :=
      fun y => IsLocalization.map_units (Localization.AtPrime Q)
        (⟨y, hM'Q y.2⟩ : Q.primeCompl)
    let β : B →+* Localization.AtPrime Q := IsLocalization.lift (M := N.primeCompl.map f) hu
    have hβc : β.comp (algebraMap C B) = algebraMap C (Localization.AtPrime Q) :=
      IsLocalization.lift_comp hu
    refine ⟨B, inferInstance, α, 𝔫, h𝔫, β, hα, ?_, ?_⟩
    · letI : Algebra B (Localization.AtPrime Q) := β.toAlgebra
      haveI : IsScalarTower C B (Localization.AtPrime Q) :=
        IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.lift_eq hu x).symm)
      haveI h1 : IsLocalization (Q.primeCompl.map (algebraMap C B)) (Localization.AtPrime Q) :=
        IsLocalization.isLocalization_of_submonoid_le B (Localization.AtPrime Q)
          (N.primeCompl.map f) Q.primeCompl hM'Q
      have hJ : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap β = 𝔫 := by
        have hc : ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap β).comap
            (algebraMap C B) = Q := by
          rw [Ideal.comap_comap, hβc]
          exact Localization.AtPrime.comap_maximalIdeal
        rw [← IsLocalization.map_under (N.primeCompl.map f) B
          ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap β)]
        show Ideal.map (algebraMap C B) (((IsLocalRing.maximalIdeal
          (Localization.AtPrime Q)).comap β).comap (algebraMap C B)) = Q.map (algebraMap C B)
        rw [hc]
      refine IsLocalization.of_le (Q.primeCompl.map (algebraMap C B))
        (@Ideal.primeCompl B _ 𝔫 h𝔫.isPrime) ?_ ?_
      · rintro _ ⟨x, hx, rfl⟩ h
        apply hx
        rw [← h𝔫c]
        exact h
      · intro r hr
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hr'
        apply hr
        rw [← hJ]
        exact hr'
    · apply IsLocalization.ringHom_ext N.primeCompl
      ext x
      simp only [RingHom.comp_apply]
      rw [Localization.localRingHom_to_map]
      show β (IsLocalization.map B f (Submonoid.le_comap_map N.primeCompl)
        (algebraMap R (Localization.AtPrime N) x)) = _
      rw [IsLocalization.map_eq, IsLocalization.lift_eq]

  have hbm : a' * q' ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right q' _ ha'm
  have hb0 : a' * q' ≠ 0 := mul_ne_zero ha'0 hq'0

  have hnb := by
    unfold wcLlsAnnSep wcLlsSepAt at hSep
    exact hSep Q hQ

  have hNt : wcLlsASbN W A K u (a' * q') ≠ ⊤ := by
    rw [← hQ]; exact Ideal.IsPrime.ne_top inferInstance
  haveI hNmax : (wcLlsASbN W A K u (a' * q')).IsMaximal :=
    wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.ann u v g) u (a' * q') hPD
      (Or.inr ⟨v, g, rfl, hbg⟩) hbm hb0 _ rfl hNt

  obtain ⟨hNd, hNic, hpres⟩ :=
    wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 (.ann u v g) u (a' * q') hPD
      (Or.inr ⟨v, g, rfl, hbg⟩) hbm hb0 _ rfl (wcLlsASbN W A K u (a' * q')) rfl
  haveI := hNd
  haveI := hNic

  have hfinM := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 _ hPD
    (algebraMap A K (algebraMap ↥W A (a' * q')) / algebraMap A K u)
  have hfin : (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))).Finite :=
    RingHom.finite_algebraMap.mpr hfinM
  have hinj : Function.Injective
      (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) := by
    intro x y hxy
    have h1 := congrArg Subtype.val hxy
