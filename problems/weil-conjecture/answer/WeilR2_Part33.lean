        rw [mul_zero, RingHom.comp_apply, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
        exact hb𝔭 b₀ hb₀m)
    have hcompK := hcK ((Algebra.adjoin A {s, (algebraMap A K h)⁻¹}).val.toRingHom.comp j)
      (RingHom.ext fun a => by
        show ((j (algebraMap A _ a) : ↥(Algebra.adjoin A {s, (algebraMap A K h)⁻¹})) : K) =
          algebraMap A K a
        rw [hj1']; rfl)
      ((Algebra.adjoin A {s, (algebraMap A K h)⁻¹}).val.toRingHom.comp ψ)
      (RingHom.ext fun w => by
        show ((ψ (Ideal.Quotient.mk _ (MvPolynomial.C w)) :
          ↥(Algebra.adjoin A {s, (algebraMap A K h)⁻¹})) : K) =
          algebraMap A K (algebraMap ↥W A w)
        rw [show ψ (Ideal.Quotient.mk _ (MvPolynomial.C w)) = _ from RingHom.congr_fun hψC w]
        rfl)
      (by
        show ((ψ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) :
          ↥(Algebra.adjoin A {s, (algebraMap A K h)⁻¹})) : K) = algebraMap A K z₀
        rw [hψ0]; rfl)
      (by
        show ((ψ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) :
          ↥(Algebra.adjoin A {s, (algebraMap A K h)⁻¹})) : K) = s
        rw [hψ1])
    have hcomp : ψ.comp ι = j.comp f := RingHom.ext fun p =>
      Subtype.val_injective (RingHom.congr_fun hcompK p)
    have hgen : ∀ q : ↥(Algebra.adjoin A {s, (algebraMap A K h)⁻¹}),
        q ∈ Subring.closure (Set.range ψ ∪ Set.range j) := by
      rintro ⟨y, hy⟩
      induction hy using Algebra.adjoin_induction with
      | mem y hy =>
        rcases hy with hy | hy
        · subst hy
          exact Subring.subset_closure (Or.inl ⟨_, hψ1⟩)
        · rw [Set.mem_singleton_iff] at hy
          subst hy
          exact Subring.subset_closure (Or.inr ⟨_, hj2⟩)
      | algebraMap a =>
        exact Subring.subset_closure (Or.inr ⟨algebraMap A _ a, hj1' a⟩)
      | add y₁ y₂ hy₁ hy₂ ih₁ ih₂ => exact Subring.add_mem _ ih₁ ih₂
      | mul y₁ y₂ hy₁ hy₂ ih₁ ih₂ => exact Subring.mul_mem _ ih₁ ih₂
    have habsι : ∀ r, ∃ n : ℕ, Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C b₀ : MvPolynomial (Fin 2) ↥W)})
        (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) ^ n * r ∈ Set.range ι := fun r => by
      obtain ⟨n, hn⟩ := habs ι.range (RingHom.mem_range.mpr hx0)
        (fun w => RingHom.mem_range.mpr (hCw w)) r
      exact ⟨n, RingHom.mem_range.mp hn⟩
    have G0 := gen P (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {(MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C b₀ : MvPolynomial (Fin 2) ↥W)}) (Localization.Away h)
      ↥(Algebra.adjoin A {s, (algebraMap A K h)⁻¹}) ι f ψ j
      (Ideal.Quotient.mk _ (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W))
    have G1 := G0 hfet
    have G2 := G1 hcomp
    have G3 := G2 hjinj
    have G4 := G3 hgen
    have G5 := G4 hreg
    have G6 := G5 hx0
    obtain ⟨hψet, hUP⟩ := G6 habsι
    obtain ⟨β, hβψ, hβj⟩ := hUP (A ⧸ 𝔭) ρ αk (hcκ αk hα1 ρ hρC hρ0 hρ1)
    refine ⟨ψ, hψC, hψ0, hψ1, hψet, β, ?_, ?_⟩
    · intro a
      rw [← hj1']
      exact (RingHom.congr_fun hβj (algebraMap A _ a)).trans (RingHom.congr_fun hα1 a)
    · have e := (RingHom.congr_fun hβψ (Ideal.Quotient.mk _ (MvPolynomial.X 1))).trans hρ1
      rw [RingHom.comp_apply, hψ1] at e
      exact e
  have hzs : algebraMap A K z₀ * (algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀) =
      algebraMap A K (algebraMap ↥W A b₀) := by
    field_simp
  rcases hk with ⟨t, c, rfl, hc, rfl⟩ | ⟨v, g, rfl, hgb⟩
  · obtain ⟨ht, -, h, hh, f, hfC, hfX, hfet⟩ := hrest
    have hfC' : ∀ w, f (Polynomial.C w) = algebraMap A _ (algebraMap ↥W A w) := fun w =>
      RingHom.congr_fun hfC w
    let ι : Polynomial ↥W →+* (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₀ : MvPolynomial (Fin 2) ↥W)}) :=
      Polynomial.eval₂RingHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
        (Ideal.Quotient.mk _ (MvPolynomial.X 0) + Ideal.Quotient.mk _ (MvPolynomial.C c))
    have hιC : ∀ w, ι (Polynomial.C w) = Ideal.Quotient.mk _ (MvPolynomial.C w) := fun w =>
      Polynomial.eval₂_C _ _
    have hιX : ι Polynomial.X =
        Ideal.Quotient.mk _ (MvPolynomial.X 0) + Ideal.Quotient.mk _ (MvPolynomial.C c) :=
      Polynomial.eval₂_X _ _
    refine ⟨h, hh, core _ h hzs hh (Polynomial ↥W) f ι hfet ?_ ?_ ?_ ?_⟩
    · intro jK hjK ψK hψKC hψK0 hψK1
      apply Polynomial.ringHom_ext
      · intro w
        rw [RingHom.comp_apply, RingHom.comp_apply, hιC, hfC']
        exact (RingHom.congr_fun hψKC w).trans (RingHom.congr_fun hjK _).symm
      · rw [RingHom.comp_apply, RingHom.comp_apply, hιX, hfX, map_add, hψK0,
          show ψK (Ideal.Quotient.mk _ (MvPolynomial.C c)) = algebraMap A K (algebraMap ↥W A c)
            from RingHom.congr_fun hψKC c,
          show jK (algebraMap A _ t) = algebraMap A K t from RingHom.congr_fun hjK t,
          ← map_add, sub_add_cancel]
    · exact ⟨Polynomial.X - Polynomial.C c, by rw [map_sub, hιX, hιC, add_sub_cancel_right]⟩
    · intro w
      exact ⟨Polynomial.C w, hιC w⟩
    · intro αk hαk ρ hρC hρ0 hρ1
      apply Polynomial.ringHom_ext
      · intro w
        rw [RingHom.comp_apply, RingHom.comp_apply, hιC, hfC']
        exact (RingHom.congr_fun hρC w).trans (RingHom.congr_fun hαk _).symm
      · rw [RingHom.comp_apply, RingHom.comp_apply, hιX, hfX, map_add, hρ0, zero_add,
          show ρ (Ideal.Quotient.mk _ (MvPolynomial.C c)) = Ideal.Quotient.mk 𝔭 (algebraMap ↥W A c)
            from RingHom.congr_fun hρC c,
          show αk (algebraMap A _ t) = Ideal.Quotient.mk 𝔭 t from RingHom.congr_fun hαk t,
          Ideal.Quotient.eq_zero_iff_mem.mpr (hb𝔭 c hc), Ideal.Quotient.eq_zero_iff_mem.mpr ht]
  · obtain ⟨hgm, hg0, huv, h𝔭eq, h, hh, f, hfC, hf0, hf1, hfet⟩ := hrest
    obtain ⟨q, rfl⟩ := hgb
    have hfC' : ∀ w, f (Ideal.Quotient.mk _ (MvPolynomial.C w)) =
        algebraMap A _ (algebraMap ↥W A w) := fun w => RingHom.congr_fun hfC w
    obtain ⟨ι, hιC, hι0, hι1⟩ := liftD (b₀ * q) (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₀ : MvPolynomial (Fin 2) ↥W)})
      ((Ideal.Quotient.mk _).comp MvPolynomial.C) (Ideal.Quotient.mk _ (MvPolynomial.X 0))
      (Ideal.Quotient.mk _ (MvPolynomial.C q) * Ideal.Quotient.mk _ (MvPolynomial.X 1)) (by
        rw [RingHom.comp_apply, MvPolynomial.C_mul, map_mul, ← hx0x1]; ring)
    have hιC' : ∀ w, ι (Ideal.Quotient.mk _ (MvPolynomial.C w)) =
        Ideal.Quotient.mk _ (MvPolynomial.C w) := fun w => RingHom.congr_fun hιC w
    have hz𝔭 : z₀ ∈ 𝔭 := by
      rw [h𝔭eq]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hv𝔭 : v ∈ 𝔭 := by
      rw [h𝔭eq]
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    refine ⟨h, hh, core _ h hzs hh (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {(MvPolynomial.X 0 *
      MvPolynomial.X 1 - MvPolynomial.C (b₀ * q) : MvPolynomial (Fin 2) ↥W)}) f ι hfet ?_
      ⟨Ideal.Quotient.mk _ (MvPolynomial.X 0), hι0⟩
      (fun w => ⟨Ideal.Quotient.mk _ (MvPolynomial.C w), hιC' w⟩) ?_⟩
    · intro jK hjK ψK hψKC hψK0 hψK1
      apply extD
      · apply RingHom.ext
        intro w
        have e1 := hιC' w
        have e2 := hfC' w
        show ψK (ι (Ideal.Quotient.mk _ (MvPolynomial.C w))) =
          jK (f (Ideal.Quotient.mk _ (MvPolynomial.C w)))
        rw [e1, e2]
        exact (RingHom.congr_fun hψKC w).trans (RingHom.congr_fun hjK _).symm
      · rw [RingHom.comp_apply, RingHom.comp_apply, hι0, hf0, hψK0]
        exact (RingHom.congr_fun hjK z₀).symm
      · rw [RingHom.comp_apply, RingHom.comp_apply, hι1, hf1, map_mul, hψK1,
          show ψK (Ideal.Quotient.mk _ (MvPolynomial.C q)) = algebraMap A K (algebraMap ↥W A q)
            from RingHom.congr_fun hψKC q,
          show jK (algebraMap A _ v) = algebraMap A K v from RingHom.congr_fun hjK v]
        have e : algebraMap A K z₀ * algebraMap A K v =
            algebraMap A K (algebraMap ↥W A b₀) * algebraMap A K (algebraMap ↥W A q) := by
          rw [← map_mul, huv, map_mul, map_mul]
        field_simp
        linear_combination -e
    · intro αk hαk ρ hρC hρ0 hρ1
      apply extD
      · apply RingHom.ext
        intro w
        have e1 := hιC' w
        have e2 := hfC' w
        show ρ (ι (Ideal.Quotient.mk _ (MvPolynomial.C w))) =
          αk (f (Ideal.Quotient.mk _ (MvPolynomial.C w)))
        rw [e1, e2]
        exact (RingHom.congr_fun hρC w).trans (RingHom.congr_fun hαk _).symm
      · rw [RingHom.comp_apply, RingHom.comp_apply, hι0, hf0, hρ0,
          show αk (algebraMap A _ z₀) = Ideal.Quotient.mk 𝔭 z₀ from RingHom.congr_fun hαk z₀]
        exact (Ideal.Quotient.eq_zero_iff_mem.mpr hz𝔭).symm
      · rw [RingHom.comp_apply, RingHom.comp_apply, hι1, hf1, map_mul, hρ1, mul_zero,
          show αk (algebraMap A _ v) = Ideal.Quotient.mk 𝔭 v from RingHom.congr_fun hαk v]
        exact (Ideal.Quotient.eq_zero_iff_mem.mpr hv𝔭).symm

theorem wcpa_dj_llsm_kptf_residue_trivial : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A),
    Algebra.FiniteType ↥W A → 𝔭.IsMaximal →
    (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 →
    ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 :=
by
  intro Ω _ _ W A _ _ 𝔭 hFT h𝔭 hm a

  have T1 : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro p hpmon hpirr
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact IsLocalRing.residue_surjective _
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon
    have hpdeg : 0 < p.natDegree := hpirr.natDegree_pos
    set j : ↥W →+* Ω := algebraMap ↥W Ω with hj
    have hQmon : (q.map j).Monic := hqmon.map j
    have hQdeg : (q.map j).natDegree = q.natDegree := hqmon.natDegree_map j
    have hQd : (q.map j).degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hQmon.ne_zero, hQdeg, hqdeg]
      exact_mod_cast hpdeg.ne'
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (q.map j) hQd
    have hzint : _root_.IsIntegral ↥W z := by
      refine ⟨q, hqmon, ?_⟩
      rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
      exact hz
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
    have hqy : q.eval y = 0 := by
      apply (IsFractionRing.injective ↥W Ω)
      rw [map_zero, ← Polynomial.eval_map_apply]
      rw [hy]
      exact hz
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    rw [← hqmap, Polynomial.eval_map_apply, hqy, map_zero]


  have T2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      [IsAlgClosed (IsLocalRing.ResidueField R)] (k : Type u) [Field k] (ρ : R →+* k),
      IsLocalHom ρ → ρ.FiniteType → Function.Surjective ρ := by
    intro R _ _ _ k _ ρ hloc hρFT
    set ψ := IsLocalRing.ResidueField.lift ρ with hψ
    have hψr : ψ.comp (IsLocalRing.residue R) = ρ :=
      IsLocalRing.ResidueField.lift_comp_residue ρ
    have hψFT : ψ.FiniteType := by
      rw [← hψr] at hρFT
      exact RingHom.FiniteType.of_comp_finiteType hρFT
    have hψfin : ψ.Finite := (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hψFT
    have hψsurj : Function.Surjective ψ :=
      (IsAlgClosed.ringHom_bijective_of_isIntegral ψ hψfin.to_isIntegral).2
    rw [← hψr]
    exact hψsurj.comp (IsLocalRing.residue_surjective)
  have := h𝔭
  letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  let ρ : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)

  have hloc : IsLocalHom ρ := by
    refine ⟨fun x hx => ?_⟩
    by_contra hxu
    have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal x).mpr hxu
    have h1 : algebraMap ↥W A x ∈ 𝔭 := hm (Ideal.mem_map_of_mem _ hxm)
    have h2 : ρ x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
    rw [h2] at hx
    exact not_isUnit_zero hx
  have hρFT : ρ.FiniteType :=
    RingHom.FiniteType.comp_surjective (RingHom.finiteType_algebraMap.mpr hFT)
      Ideal.Quotient.mk_surjective

  obtain ⟨w, hw⟩ := T2 ↥W (A ⧸ 𝔭) ρ hloc hρFT (Ideal.Quotient.mk 𝔭 a)
  refine ⟨w, ?_⟩
  exact Ideal.Quotient.eq.mp hw.symm

theorem wcpa_dj_llsm_brrm_node_pres : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (k : wcLlsKind W A) (z₀ : A) (b : ↥W),
    wcLlsPD W A 𝔭 k →
    ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ z₀ = t - algebraMap ↥W A c) ∨
      (∃ v g, k = .ann z₀ v g ∧ b ∣ g)) →
    b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀ →
    ∀ (N : Ideal ↥(Algebra.adjoin A {s})) [N.IsMaximal],
    N = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    IsDomain (Localization.AtPrime N) ∧ IsIntegrallyClosed (Localization.AtPrime N) ∧
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime N →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime N)) P e →
      ∃ f : wcEbntN W b →+* P,
        wcEbntPres W (e.comp ((algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))) b f ∧
        f (wcEbntX W b 0) = e (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N)
          (algebraMap A ↥(Algebra.adjoin A {s}) z₀)) ∧
        f (wcEbntX W b 1) = e (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N)
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 k z₀ b hPD hk hbm hb0
  classical

  have away : ∀ (R E : Type u) [CommRing R] [IsDomain R] [CommRing E] (ι : R →+* E) (h : R)
      (N : Ideal R) [N.IsPrime] (q : Ideal E) [q.IsPrime], Function.Injective ι → IsUnit (ι h) →
      (∀ x : E, ∃ (n : ℕ) (r : R), ι r = x * ι h ^ n) → q.comap ι = N → h ∉ N →
      ∃ j : E →+* Localization.AtPrime N, j.comp ι = algebraMap R (Localization.AtPrime N) ∧
        @IsLocalization E _ q.primeCompl (Localization.AtPrime N) _ j.toAlgebra := by
    intro R E _ _ _ ι h N _ q _ hinj hu hsurj hcom hhN
    letI : Algebra R E := ι.toAlgebra
    haveI hlocE : IsLocalization (Submonoid.powers h) E := by
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, n, rfl⟩
        show IsUnit (ι (h ^ n))
        rw [map_pow]
        exact hu.pow n
      · intro x
        obtain ⟨n, r, hr⟩ := hsurj x
        refine ⟨⟨r, ⟨h ^ n, n, rfl⟩⟩, ?_⟩
        show x * ι (h ^ n) = ι r
        rw [map_pow, hr]
      · intro a c hac
        exact ⟨1, by rw [hinj hac]⟩
    have hMu : ∀ y : Submonoid.powers h, IsUnit (algebraMap R (Localization.AtPrime N) y) := by
      rintro ⟨_, n, rfl⟩
      rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime N) N,
        Ideal.mem_primeCompl_iff]
      exact fun hm => hhN (Ideal.IsPrime.mem_of_pow_mem ‹N.IsPrime› n hm)
    let j : E →+* Localization.AtPrime N :=
      IsLocalization.lift (M := Submonoid.powers h) (S := E) hMu
    have hjι : j.comp ι = algebraMap R (Localization.AtPrime N) := IsLocalization.lift_comp hMu
    have hcomx : ∀ r : R, ι r ∈ q ↔ r ∈ N := fun r => by rw [← hcom]; rfl
    have hιh : ι h ∉ q := fun hm => hhN (by rw [← hcom]; exact hm)
    have hjx : ∀ x : E, x ∉ q → IsUnit (j x) := by
      intro x hx
      obtain ⟨n, r, hr⟩ := hsurj x
      have hrN : r ∉ N := by
        rw [← hcom, Ideal.mem_comap, hr]
        intro hm
        rcases Ideal.IsPrime.mem_or_mem ‹q.IsPrime› hm with h1 | h1
        · exact hx h1
        · exact hιh (Ideal.IsPrime.mem_of_pow_mem ‹q.IsPrime› n h1)
      have h1 : IsUnit (j (ι r)) := by
        rw [← RingHom.comp_apply, hjι,
          IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime N) N]
        exact Ideal.mem_primeCompl_iff.mpr hrN
      rw [hr, map_mul] at h1
      exact isUnit_of_mul_isUnit_left h1
    have hαinj : Function.Injective (algebraMap R (Localization.AtPrime N)) :=
      IsLocalization.injective _ (Ideal.primeCompl_le_nonZeroDivisors N)
    have hjinj : Function.Injective j := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨n, r, hr⟩ := hsurj z
      have h1 : algebraMap R (Localization.AtPrime N) r = 0 := by
        rw [← hjι, RingHom.comp_apply, hr, map_mul, hz, zero_mul]
      have h2 : r = 0 := hαinj (h1.trans (map_zero _).symm)
      rw [h2, map_zero] at hr
      exact ((hu.pow n).mul_left_eq_zero).mp hr.symm
    refine ⟨j, hjι, ?_⟩
    letI : Algebra E (Localization.AtPrime N) := j.toAlgebra
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨x, hx⟩
      exact hjx x (Ideal.mem_primeCompl_iff.mp hx)
    · intro y
      obtain ⟨⟨r, t⟩, hrt⟩ := IsLocalization.surj N.primeCompl y
      refine ⟨⟨ι r, ⟨ι t, Ideal.mem_primeCompl_iff.mpr
        (fun hm => Ideal.mem_primeCompl_iff.mp t.2 ((hcomx _).mp hm))⟩⟩, ?_⟩
      show y * j (ι t) = j (ι r)
      rw [← RingHom.comp_apply j ι, ← RingHom.comp_apply j ι, hjι]
      exact hrt
    · intro a c hac
      exact ⟨1, by rw [hjinj hac]⟩

  have etaleHens : ∀ (T E O P : Type u) [CommRing T] [CommRing E] [CommRing O] [CommRing P]
      [Algebra E O] [IsLocalRing O] (ψ : T →+* E) (𝔫 : Ideal T) (q : Ideal E) [q.IsPrime]
      [IsLocalization.AtPrime O q], ψ.Etale → q.comap ψ = 𝔫 → (∀ x : E, ∃ t : T, x - ψ t ∈ q) →
      ∀ (e : O →+* P), wcNdIsHens (IsLocalRing.maximalIdeal O) P e →
      wcNdIsHens 𝔫 P (e.comp ((algebraMap E O).comp ψ)) := by
    intro T E O P _ _ _ _ _ _ ψ 𝔫 q _ _ hψ hcom hres e he
    obtain ⟨H1, H2, H3⟩ := he
    letI : Algebra T E := ψ.toAlgebra
    haveI : Algebra.Etale T E := hψ
    have hOunit : ∀ y : O, IsUnit (e y) ↔ IsUnit y := fun y => by
      rw [H2, IsLocalRing.notMem_maximalIdeal]
    unfold wcNdIsHens
    refine ⟨H1, fun t => ?_, ?_⟩
    · rw [RingHom.comp_apply, RingHom.comp_apply, hOunit,
        IsLocalization.AtPrime.isUnit_to_map_iff O q, Ideal.mem_primeCompl_iff, ← hcom,
        Ideal.mem_comap]
    intro B _ hB g hg
    haveI := hB
    letI : Algebra T B := g.toAlgebra
    let gbar : T ⧸ 𝔫 →+* IsLocalRing.ResidueField B :=
      Ideal.Quotient.lift 𝔫 ((IsLocalRing.residue B).comp g) (fun a ha => by
        rw [RingHom.comp_apply, IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff]
        exact fun hu => (hg a).mp hu ha)
    have hgbar : ∀ t : T, gbar (Ideal.Quotient.mk 𝔫 t) = IsLocalRing.residue B (g t) :=
      fun t => Ideal.Quotient.lift_mk _ _ _
    have hgbar_inj : Function.Injective gbar := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hgbar, IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff] at hy
      rw [Ideal.Quotient.eq_zero_iff_mem]
      by_contra hn
      exact hy ((hg t).mpr hn)
    let ψbar : T ⧸ 𝔫 →+* E ⧸ q := Ideal.quotientMap q ψ (le_of_eq hcom.symm)
    have hψbar_bij : Function.Bijective ψbar := by
      refine ⟨Ideal.quotientMap_injective' (le_of_eq hcom), ?_⟩
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨t, ht⟩ := hres x
      refine ⟨Ideal.Quotient.mk 𝔫 t, ?_⟩
      rw [Ideal.quotientMap_mk, Ideal.Quotient.eq, ← neg_sub]
      exact q.neg_mem ht
    let eqv := RingEquiv.ofBijective ψbar hψbar_bij
    let σ : E →+* IsLocalRing.ResidueField B :=
      gbar.comp (eqv.symm.toRingHom.comp (Ideal.Quotient.mk q))
    have hσψ : ∀ t : T, σ (ψ t) = IsLocalRing.residue B (g t) := by
      intro t
      show gbar (eqv.symm (Ideal.Quotient.mk q (ψ t))) = _
      have h1 : eqv.symm (Ideal.Quotient.mk q (ψ t)) = Ideal.Quotient.mk 𝔫 t := by
        rw [RingEquiv.symm_apply_eq]
        change Ideal.Quotient.mk q (ψ t) = ψbar (Ideal.Quotient.mk 𝔫 t)
        rw [Ideal.quotientMap_mk]
      rw [h1, hgbar]
    have hσ0 : ∀ x : E, σ x = 0 ↔ x ∈ q := by
      intro x
      show gbar (eqv.symm (Ideal.Quotient.mk q x)) = 0 ↔ _
      rw [map_eq_zero_iff gbar hgbar_inj, map_eq_zero_iff _ eqv.symm.injective,
        Ideal.Quotient.eq_zero_iff_mem]
    have hσ : σ.comp (algebraMap T E) = (IsLocalRing.residue B).comp (algebraMap T B) :=
      RingHom.ext fun t => hσψ t
    obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base T B
      (fun E'' _ _ _ σ'' => wc_hnas_smooth_section_henselian B E'' σ'') E σ hσ
    have hunit : ∀ x : E, IsUnit (τ x) ↔ x ∉ q := by
      intro x
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hτ, Ne, hσ0]
    have hMq : ∀ y : q.primeCompl, IsUnit ((τ : E →+* B) y) :=
      fun y => (hunit y).mpr (Ideal.mem_primeCompl_iff.mp y.2)
    let k : O →+* B := IsLocalization.lift (M := q.primeCompl) (S := O) hMq
    have hkE : ∀ x : E, k (algebraMap E O x) = τ x := fun x => IsLocalization.lift_eq hMq x
    have hkloc : ∀ o : O, IsUnit (k o) → IsUnit o := by
      intro o ho
      obtain ⟨⟨x, y⟩, hxy⟩ := IsLocalization.surj q.primeCompl o
      have e2 : k o * τ y = τ x := by rw [← hkE, ← hkE, ← map_mul, hxy]
      have hx : IsUnit (τ x) := by
        rw [← e2]
        exact ho.mul ((hunit y).mpr (Ideal.mem_primeCompl_iff.mp y.2))
      have hx' : IsUnit (algebraMap E O x) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff O q x).mpr
          (Ideal.mem_primeCompl_iff.mpr ((hunit x).mp hx))
      rw [← hxy] at hx'
      exact isUnit_of_mul_isUnit_left hx'
    have hkunit : ∀ o : O, IsUnit (k o) ↔ o ∉ IsLocalRing.maximalIdeal O := fun o =>
      ⟨fun h => IsLocalRing.notMem_maximalIdeal.mpr (hkloc o h),
        fun h => (IsLocalRing.notMem_maximalIdeal.mp h).map k⟩
    obtain ⟨η, ⟨hηe, hηl⟩, hηu⟩ := H3 B hB k hkunit
    refine ⟨η, ⟨RingHom.ext fun t => ?_, hηl⟩, ?_⟩
    · show η (e (algebraMap E O (ψ t))) = g t
      rw [← RingHom.comp_apply η e, hηe, hkE]
      exact τ.commutes t
    rintro η' ⟨hη', hη'l⟩
    haveI := hη'l
    haveI : IsLocalHom e := ⟨fun y hy => (hOunit y).mp hy⟩
    let τ' : E →ₐ[T] B := ⟨(η'.comp e).comp (algebraMap E O), fun t => by
      show η' (e (algebraMap E O (ψ t))) = g t
      exact RingHom.congr_fun hη' t⟩
    have hres' : ∀ x : E, IsLocalRing.residue B (τ' x) = IsLocalRing.residue B (τ x) := by
      intro x
      obtain ⟨t, ht⟩ := hres x
      have h1 : algebraMap E O (x - ψ t) ∈ IsLocalRing.maximalIdeal O :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff O q _).mpr ht
      have h2 : ¬ IsUnit (η' (e (algebraMap E O (x - ψ t)))) := fun hu =>
        mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)
          (isUnit_of_map_unit e _ (isUnit_of_map_unit η' _ hu))
      have e3 : τ' x - g t = η' (e (algebraMap E O (x - ψ t))) := by
        simp only [map_sub]
        rw [← RingHom.congr_fun hη' t]
        rfl
      have h3 : IsLocalRing.residue B (τ' x) = IsLocalRing.residue B (g t) := by
        rw [← sub_eq_zero, ← map_sub, e3, IsLocalRing.residue_eq_zero_iff,
          IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact h2
      have hgt : g t = τ (ψ t) := (τ.commutes t).symm
      have h4 : IsLocalRing.residue B (τ x) = IsLocalRing.residue B (g t) := by
        rw [hgt, ← sub_eq_zero, ← map_sub, ← map_sub, hτ, hσ0]
        exact ht
      exact h3.trans h4.symm
    have heq : τ' = τ := wc_hnas_hs_etale_hom_unique_residue T E B τ' τ hres'
    have hk' : η'.comp e = k := IsLocalization.ringHom_ext q.primeCompl
      (RingHom.ext fun x => by
        show η' (e (algebraMap E O x)) = k (algebraMap E O x)
        rw [hkE]
        exact congrArg (fun F : E →ₐ[T] B => F x) heq)
    exact hηu η' ⟨hk', hη'l⟩

  have hPD0 := hPD
  obtain ⟨hFT, hNZ, hIC, h𝔭max, hm𝔭, hrest⟩ := hPD0
  haveI := h𝔭max
  letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  have hinjA : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hWinj : ∀ w : ↥W, algebraMap A K (algebraMap ↥W A w) = 0 → w = 0 := by
    intro w hw
    have h3 : algebraMap ↥W A w = 0 := hinjA (by rw [hw, map_zero])
    have h4 : w • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one, h3]
    exact (smul_eq_zero.mp h4).resolve_right one_ne_zero
  have hw𝔭 : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A w ∈ 𝔭 :=
    fun w hw => hm𝔭 (Ideal.mem_map_of_mem _ hw)

  have hz𝔭 : z₀ ∈ 𝔭 := by
    rcases hk with ⟨t, c, rfl, hc, rfl⟩ | ⟨v, g, rfl, -⟩
    · exact Ideal.sub_mem _ hrest.1 (hw𝔭 c hc)
    · rw [hrest.2.2.2.1]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hz0 : z₀ ≠ 0 := by
    rcases hk with ⟨t, c, rfl, hc, rfl⟩ | ⟨v, g, rfl, -⟩
    · obtain ⟨-, -, h, hh𝔭, f, hfC, hfX, hfet⟩ := hrest
      intro hz
      have hh0 : h ≠ 0 := fun h0 => hh𝔭 (h0 ▸ 𝔭.zero_mem)
      haveI : IsDomain (Localization.Away h) :=
        IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
      letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
      haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfet
      haveI : Module.Flat (Polynomial ↥W) (Localization.Away h) := inferInstance
      have hne : (Polynomial.X - Polynomial.C c : Polynomial ↥W) ≠ 0 :=
        Polynomial.X_sub_C_ne_zero c
