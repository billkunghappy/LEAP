      ⟨⟨0, 1, fun h => hne ((Ideal.eq_top_iff_one _).mpr
        (Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_one]; exact h.symm)))⟩⟩
    haveI hFloc : IsLocalRing (Localization.AtPrime Q ⧸ (Ideal.map
        (algebraMap ↥W ↥(integralClosure R L)) (IsLocalRing.maximalIdeal ↥W)).map
