    refine ⟨fun P => (Λ (P.comap ψ0)).map ψ1, ?_, ?_, ?_⟩
    · intro P hP
      beta_reduce
      obtain ⟨hPp, hmin, hτ, hΛp, hΛc, hvΛ, hjp, hjc, hΛmin⟩ := hfact P hP
