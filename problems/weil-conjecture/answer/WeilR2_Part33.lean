theorem wcpa_dj_llsm_ob_branch_inject : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → wcLlsScDF W A K L t c' b' →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L))
        [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w →
        wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) + 1 ≤
          wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
            (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0
    hs' hDF w _ hwc hwU
  classical

  obtain ⟨j, hj1, hjinj, hj3⟩ := wcpa_dj_llsm_obi_strict_match Ω W hW hWt A K L 𝔭 t y hPD hy
    hyc hU c' b' hc' hb'm hb'0 w hwc hwU
  obtain ⟨Qe, hQe, hτQe, hQeU⟩ := wcpa_dj_llsm_obi_exc_branch Ω W hW hWt A K L 𝔭 t hPD c' b'
    hc' hb'm hb'0 hDF w hwc hwU

  have hWA : Function.Injective (algebraMap ↥W A) := by
    haveI := hPD.2.1
    refine (injective_iff_map_eq_zero _).mpr fun x hx => ?_
    rw [Algebra.algebraMap_eq_smul_one] at hx
    exact (smul_eq_zero.mp hx).resolve_right one_ne_zero
  have hinjA : Function.Injective ((algebraMap A L).comp (algebraMap ↥W A)) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp ((IsFractionRing.injective A K).comp hWA)
  have hintA : ∀ x : ↥W, IsIntegral A (((algebraMap A L).comp (algebraMap ↥W A)) x) := fun x =>
    isIntegral_algebraMap (R := A) (A := L) (x := algebraMap ↥W A x)
  have hred0 : IsReduced (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
    wcpa_dj_llsm_obi_fs_reduced Ω W L _ hinjA A hintA y
  have hinjV : Function.Injective
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) :=
    (algebraMap K L).injective.comp ((IsFractionRing.injective A K).comp hWA)
  have hintV : ∀ x : ↥W, IsIntegral ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      (((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x) := fun x =>
    isIntegral_algebraMap (R := ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) (A := L)
      (x := algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A x))
  have hred1 : IsReduced (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) :=
    wcpa_dj_llsm_obi_fs_reduced Ω W L _ hinjV _ hintV w

  have h0 := wcpa_dj_llsm_obi_R0_minprimes_finite Ω W hW hWt A K L 𝔭 t y hPD hy hyc
  have hsub : minimalPrimes (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) ⊆
      j '' minimalPrimes (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) ∪ {Qe} := by
    intro Q hQ
    by_cases hτ : wcObiImg W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
        ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c')) ∈ Q
    · exact Or.inr (hQeU Q hQ hτ)
    · obtain ⟨P, hP, hPQ⟩ := hj3 Q hQ hτ
      exact Or.inl ⟨P, hP, hPQ⟩
  have h1 := ((h0.image j).union (Set.finite_singleton Qe)).subset hsub

  have heq : ∀ P ∈ h0.toFinset,
      wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ⧸ P) =
      wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
        (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w ⧸ j P) := by
    intro P hP
    have hP' := h0.mem_toFinset.mp hP
    obtain ⟨hjP, _, f, hfi, hfint, hfb⟩ := hj1 P hP'
    haveI : P.IsPrime := hP'.1.1
    haveI : (j P).IsPrime := hjP.1.1
    exact wcpa_dj_llsm_obi_br_birational _ _ f hfi hfint hfb
  have hQe1 : 1 ≤ wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
      (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w ⧸ Qe) := by
    haveI : Qe.IsPrime := hQe.1.1
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (integralClosure
      (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
        (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w ⧸ Qe)
      (FractionRing (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
        (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w ⧸ Qe)))
    exact (ENat.one_le_card_iff_nonempty _).mpr ⟨⟨M, hM⟩⟩
  have hnot : Qe ∉ h0.toFinset.image j := by
    intro h
    obtain ⟨P, hP, hPQ⟩ := Finset.mem_image.mp h
    exact (hj1 P (h0.mem_toFinset.mp hP)).2.1 (hPQ ▸ hτQe)
  have hins : insert Qe (h0.toFinset.image j) ⊆ h1.toFinset := by
    intro Q hQ
    rcases Finset.mem_insert.mp hQ with h | h
    · exact h1.mem_toFinset.mpr (h ▸ hQe)
    · obtain ⟨P, hP, hPQ⟩ := Finset.mem_image.mp h
      exact h1.mem_toFinset.mpr (hPQ ▸ (hj1 P (h0.mem_toFinset.mp hP)).1)
  rw [wcpa_dj_llsm_obi_branches_sum _ h0, wcpa_dj_llsm_obi_branches_sum _ h1]
  calc ∑ P ∈ h0.toFinset,
        wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ⧸ P) + 1
      = ∑ P ∈ h0.toFinset, wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp
          ((algebraMap A K).comp (algebraMap ↥W A))) ↥(Algebra.adjoin A
            {wcLlsScV W A K t c' b'}) w ⧸ j P) + 1 := by
        rw [Finset.sum_congr rfl heq]
    _ = ∑ Q ∈ h0.toFinset.image j, wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp
          ((algebraMap A K).comp (algebraMap ↥W A))) ↥(Algebra.adjoin A
            {wcLlsScV W A K t c' b'}) w ⧸ Q) + 1 := by
        rw [Finset.sum_image (fun x hx z hz hxz => hjinj (h0.mem_toFinset.mp hx)
          (h0.mem_toFinset.mp hz) hxz)]
    _ ≤ ∑ Q ∈ h0.toFinset.image j, wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp
          ((algebraMap A K).comp (algebraMap ↥W A))) ↥(Algebra.adjoin A
            {wcLlsScV W A K t c' b'}) w ⧸ Q) +
          wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
            (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w ⧸ Qe) :=
        add_le_add le_rfl hQe1
    _ = ∑ Q ∈ insert Qe (h0.toFinset.image j), wcpaDjLkBranches (wcLlsFS W
          ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
            ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w ⧸ Q) := by
        rw [Finset.sum_insert hnot, add_comm]
    _ ≤ _ := Finset.sum_le_sum_of_subset hins

theorem wcpa_dj_llsm_scdc_one_boundary : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → wcLlsScDF W A K L t c' b' →
      (∃ w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
        w.IsPrime ∧
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' ∧
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w) ∧
      wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 1 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0
    hs' hDF

  have s7 : ∀ (P : Type u) [CommRing P] (I : Ideal P), I ≠ ⊤ →
      1 ≤ wcpaDjLkBranches (P ⧸ I) := by
    intro P _ I hI
    haveI : Nontrivial (P ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (integralClosure (P ⧸ I) (FractionRing (P ⧸ I)))
    exact (ENat.one_le_card_iff_nonempty _).mpr ⟨⟨M, hM⟩⟩

  have s9 : ∀ (P : Type u) [CommRing P] [IsLocalRing P] (I : Ideal P),
      ¬ wcpaDjLkBad (P ⧸ I) → wcpaDjLkBranches (P ⧸ I) ≤ 2 := by
    intro P _ _ I h
    have h' := not_not.mp h
    rcases h' with h0 | ⟨_, h2⟩
    · have hsub := Module.length_eq_zero_iff.mp h0
      set R := P ⧸ I
      set S := integralClosure R (FractionRing R)
      have hsurjR : Function.Surjective (algebraMap R S) := by
        intro x
        have hx : (Submodule.Quotient.mk x : S ⧸ (Algebra.linearMap R S).range) =
            Submodule.Quotient.mk 0 := Subsingleton.elim _ _
        rw [Submodule.Quotient.eq, sub_zero, LinearMap.mem_range] at hx
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, by rw [← hr, Algebra.linearMap_apply]⟩
      set φ : P →+* S := (algebraMap R S).comp (Ideal.Quotient.mk I) with hφ
      have hφs : Function.Surjective φ :=
        hsurjR.comp Ideal.Quotient.mk_surjective
      have hss : Subsingleton (MaximalSpectrum S) := by
        constructor
        intro M₁ M₂
        apply MaximalSpectrum.ext
        haveI := M₁.isMaximal
        haveI := M₂.isMaximal
        have e1 : Ideal.comap φ M₁.asIdeal = IsLocalRing.maximalIdeal P :=
          IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective φ hφs)
        have e2 : Ideal.comap φ M₂.asIdeal = IsLocalRing.maximalIdeal P :=
          IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective φ hφs)
        rw [← Ideal.map_comap_of_surjective φ hφs M₁.asIdeal,
          ← Ideal.map_comap_of_surjective φ hφs M₂.asIdeal, e1, e2]
      have h1 : wcpaDjLkBranches R ≤ 1 := (ENat.card_le_one_iff_subsingleton _).mpr hss
      exact h1.trans one_le_two
    · exact h2.le

  have s9' : ∀ (R0 : Type u) [CommRing R0] [Algebra R0 L] (wL : ↥W →+* L)
      (q : Ideal ↥(integralClosure R0 L)) [q.IsPrime],
      ¬ wcpaDjLkBad (wcLlsFS W wL R0 q) → wcpaDjLkBranches (wcLlsFS W wL R0 q) ≤ 2 := by
    intro R0 _ _ wL q _ h
    exact s9 (Localization.AtPrime q)
      (Ideal.map (algebraMap ↥(integralClosure R0 L) (Localization.AtPrime q))
        (Ideal.span {b : ↥(integralClosure R0 L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = wL w})) h
  have s7' : ∀ (R0 : Type u) [CommRing R0] [Algebra R0 L] (wL : ↥W →+* L)
      (q : Ideal ↥(integralClosure R0 L)) [q.IsPrime],
      Ideal.span {b : ↥(integralClosure R0 L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = wL w} ≤ q → 1 ≤ wcpaDjLkBranches (wcLlsFS W wL R0 q) := by
    intro R0 _ _ wL q _ hle
    refine s7 (Localization.AtPrime q)
      (Ideal.map (algebraMap ↥(integralClosure R0 L) (Localization.AtPrime q))
        (Ideal.span {b : ↥(integralClosure R0 L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = wL w})) ?_
    intro htop
    have h2 := Ideal.map_mono (f := algebraMap ↥(integralClosure R0 L) (Localization.AtPrime q)) hle
    rw [htop, Localization.AtPrime.map_eq_maximalIdeal, top_le_iff] at h2
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top h2

  obtain ⟨w, hw, hwc, hwU⟩ := wcpa_dj_llsm_ob_node_unique Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU
    c' b' hc' hb'm hb'0 hs' hDF
  haveI := hw
  refine ⟨⟨w, hw, hwc, hwU⟩, ?_⟩

  have h8 : wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) + 1 ≤
      wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
        (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) :=
    wcpa_dj_llsm_ob_branch_inject Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU c' b' hc' hb'm
      hb'0 hs' hDF w hwc hwU

  have hnb : ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
        (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) :=
    @hs' w hw hwc
  have h9 : wcpaDjLkBranches (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
        (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w) ≤ 2 :=
    s9' _ _ w hnb

  have h7 : 1 ≤ wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) := by
    obtain ⟨_, _, _, _, hm𝔭, _⟩ := hPD
    have hle : Ideal.span {b : ↥(integralClosure A L) | ∃ w₀ ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w₀} ≤ y := by
      rw [Ideal.span_le]
      rintro b ⟨w₀, hw₀, hb⟩
      have hbeq : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w₀) :=
        Subtype.ext hb
      have hmem : algebraMap ↥W A w₀ ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hw₀)
      rw [← hyc, Ideal.mem_comap] at hmem
      rw [SetLike.mem_coe, hbeq]
      exact hmem
    exact s7' A ((algebraMap A L).comp (algebraMap ↥W A)) y hle

  have arith : ∀ n m : ℕ∞, 1 ≤ n → n + 1 ≤ m → m ≤ 2 → n = 1 := by
    intro n m h1 h2 h3
    have h4 : n + 1 ≤ 2 := h2.trans h3
    induction n using ENat.recTopCoe with
    | top => simp at h4
    | coe n =>
      norm_cast at h1 h4 ⊢
      omega
  exact arith _ _ h7 h8 h9

theorem wcpa_dj_llsm_sccas_reduced_fibre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
      IsReduced (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy _
  classical
  obtain ⟨_, hNZ, _⟩ := hPD

  have hWA : Function.Injective (algebraMap ↥W A) := by
    intro a b hab
    have h1 : (a - b) • (1 : A) = 0 := by
      rw [sub_smul, ← Algebra.algebraMap_eq_smul_one, ← Algebra.algebraMap_eq_smul_one, hab,
        sub_self]
    rcases smul_eq_zero.mp h1 with h | h
    · exact sub_eq_zero.mp h
    · exact absurd h one_ne_zero
  have hAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hwLinj : Function.Injective ((algebraMap A L).comp (algebraMap ↥W A)) := hAL.comp hWA

  have hint : ∀ u : ↥W, _root_.IsIntegral A (((algebraMap A L).comp (algebraMap ↥W A)) u) :=
    fun u => isIntegral_algebraMap
  let emb : ↥W → ↥(integralClosure A L) := fun u =>
    ⟨((algebraMap A L).comp (algebraMap ↥W A)) u, hint u⟩

  have hform : ∀ x ∈ Ideal.span {b : ↥(integralClosure A L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w},
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ c : ↥(integralClosure A L),
        (x : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w * (c : L) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨w, hw, hxw⟩ := hx
      exact ⟨w, hw, 1, by rw [hxw, OneMemClass.coe_one, mul_one]⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, by simp⟩
    | add x z _ _ hx hz =>
      obtain ⟨w₁, hw₁, c₁, h₁⟩ := hx
      obtain ⟨w₂, hw₂, c₂, h₂⟩ := hz
      rcases ValuationRing.dvd_total w₁ w₂ with ⟨e, he⟩ | ⟨e, he⟩
      · refine ⟨w₁, hw₁, c₁ + emb e * c₂, ?_⟩
        rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, he, map_mul]
        show _ = _ * (_ + ((algebraMap A L).comp (algebraMap ↥W A)) e * _)
        ring
      · refine ⟨w₂, hw₂, emb e * c₁ + c₂, ?_⟩
        rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, he, map_mul]
        show _ = _ * (((algebraMap A L).comp (algebraMap ↥W A)) e * _ + _)
        ring
    | smul a x _ hx =>
      obtain ⟨w, hw, c, h⟩ := hx
      refine ⟨w, hw, a * c, ?_⟩
      rw [smul_eq_mul, MulMemClass.coe_mul, h, MulMemClass.coe_mul]
      ring

  have hroot : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ n : ℕ, 0 < n →
      ∃ π ∈ IsLocalRing.maximalIdeal ↥W, π ^ n = w := by
    intro w hw n hn
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hw
    by_cases h : z ∈ W
    · have hπ : (⟨z, h⟩ : ↥W) ^ n = w := Subtype.ext (by simp [hz])
      refine ⟨⟨z, h⟩, ?_, hπ⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact hw (hπ ▸ hu.pow n)
    · exfalso
      have hz0 : z ≠ 0 := by
        rintro rfl
        exact h W.zero_mem
      have hzi : z⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left h
      have hv : w * (⟨z⁻¹, hzi⟩ : ↥W) ^ n = 1 := by
        apply Subtype.ext
        simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one]
        rw [← hz, ← mul_pow, mul_inv_cancel₀ hz0, one_pow]
      exact hw (IsUnit.of_mul_eq_one _ hv)

  have hrad : ∀ (b : ↥(integralClosure A L)) (n : ℕ), b ^ n ∈ Ideal.span
      {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} →
      b ∈ Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} := by
    intro b n hbn
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [pow_zero] at hbn
      simpa using Ideal.mul_mem_left _ b hbn
    obtain ⟨w, hw, c, hc⟩ := hform _ hbn
    rw [SubmonoidClass.coe_pow] at hc
    by_cases hw0 : w = 0
    · have h0 : (b : L) ^ n = 0 := by rw [hc, hw0, map_zero, zero_mul]
      have hb0 : b = 0 := Subtype.ext (by
        rw [ZeroMemClass.coe_zero]; exact (pow_eq_zero_iff hn.ne').mp h0)
      rw [hb0]
      exact Ideal.zero_mem _
    obtain ⟨π, hπ, hπn⟩ := hroot w hw n hn
    have hwL0 : ((algebraMap A L).comp (algebraMap ↥W A)) w ≠ 0 := by
      intro h
      exact hw0 ((map_eq_zero_iff _ hwLinj).mp h)
    have hπ0 : ((algebraMap A L).comp (algebraMap ↥W A)) π ≠ 0 := by
      intro h
      apply hw0
      rw [← hπn, (map_eq_zero_iff _ hwLinj).mp h, zero_pow hn.ne']
    have hξ : ((b : L) / ((algebraMap A L).comp (algebraMap ↥W A)) π) ^ n = (c : L) := by
      rw [div_pow, hc, ← map_pow, hπn]
      exact mul_div_cancel_left₀ _ hwL0
    have hξint : _root_.IsIntegral A
        ((b : L) / ((algebraMap A L).comp (algebraMap ↥W A)) π) :=
      _root_.IsIntegral.of_pow hn (by rw [hξ]; exact c.2)
    have hmem : emb π * ⟨_, hξint⟩ ∈ Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} :=
      Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨π, hπ, rfl⟩)
    have hbeq : b = emb π * ⟨_, hξint⟩ := by
      apply Subtype.ext
      rw [MulMemClass.coe_mul]
      show (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) π *
        ((b : L) / ((algebraMap A L).comp (algebraMap ↥W A)) π)
      rw [mul_div_cancel₀ _ hπ0]
    rw [hbeq]
    exact hmem

  unfold wcLlsFS
  refine ⟨fun x hx => ?_⟩
  obtain ⟨n, hn⟩ := hx
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl x
  rw [← map_pow, ← IsLocalization.mk'_pow, Ideal.Quotient.eq_zero_iff_mem,
    IsLocalization.mk'_mem_map_algebraMap_iff] at hn
  obtain ⟨s', hs', hs'a⟩ := hn
  rw [Ideal.Quotient.eq_zero_iff_mem, IsLocalization.mk'_mem_map_algebraMap_iff]
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · refine ⟨s', hs', ?_⟩
    rw [pow_zero, mul_one] at hs'a
    exact Ideal.mul_mem_right _ _ hs'a
  · refine ⟨s', hs', hrad _ n ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    have he : (s' * a) ^ (m + 1) = s' ^ m * (s' * a ^ (m + 1)) := by ring
    rw [he]
    exact Ideal.mul_mem_left _ _ hs'a

theorem wcpa_dj_llsm_scrs_nm_disc_to_node : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (fA : Polynomial ↥W →+* P), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) P fA → ∀ (b' : ↥W), b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → ∃ (Q : Type u) (_ : CommRing Q) (f : wcEbntN W b' →+* Q) (h : P →+* Q), wcEbntPres W (h.comp (fA.comp Polynomial.C)) b' f ∧ IsLocalHom h ∧ h (fA Polynomial.X) = f (wcEbntX W b' 0) :=
by
  intro Ω _ W P _ fA hH b' hb'm hb'0
  classical
  set J : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b'} with hJ
  set mk := Ideal.Quotient.mk J with hmk
  have hres : IsLocalRing.residue ↥W b' = 0 := (IsLocalRing.residue_eq_zero_iff b').mpr hb'm

  have hev : MvPolynomial.eval₂Hom (IsLocalRing.residue ↥W)
      (fun _ : Fin 2 => (0 : IsLocalRing.ResidueField ↥W)) =
      (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro c; simp
    · intro i; simp
  have hJker : ∀ a ∈ J, MvPolynomial.eval₂Hom (IsLocalRing.residue ↥W)
      (fun _ : Fin 2 => (0 : IsLocalRing.ResidueField ↥W)) a = 0 := by
    intro a ha
    obtain ⟨k, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp [hres]
  let rN : MvPolynomial (Fin 2) ↥W ⧸ J →+* IsLocalRing.ResidueField ↥W :=
    Ideal.Quotient.lift J _ hJker
  have hrN : ∀ p, rN (mk p) = IsLocalRing.residue ↥W (MvPolynomial.constantCoeff p) := by
    intro p
    show Ideal.Quotient.lift J _ hJker (Ideal.Quotient.mk J p) = _
    rw [Ideal.Quotient.lift_mk, hev, RingHom.comp_apply]
  set mN : Ideal (MvPolynomial (Fin 2) ↥W ⧸ J) :=
    (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map mk with hmN
  have hstarN : ∀ t, t ∈ mN ↔ rN t = 0 := by
    intro t
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
    change mk p ∈ mN ↔ rN (mk p) = 0
    rw [hrN]
    constructor
    · intro hp
      have hle : mN ≤ RingHom.ker rN := by
        rw [hmN, Ideal.map_le_iff_le_comap]
        apply sup_le
        · rw [Ideal.span_le]
          intro x hx
          simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
          rcases hx with rfl | rfl
          · show rN (mk _) = 0
            rw [hrN]; simp
          · show rN (mk _) = 0
            rw [hrN]; simp
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          show rN (mk (MvPolynomial.C c)) = 0
          rw [hrN, MvPolynomial.constantCoeff_C]
          exact (IsLocalRing.residue_eq_zero_iff c).mpr hc
      have := hle hp
      rw [RingHom.mem_ker, hrN] at this
      exact this
    · intro hp
      have hcm : MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W :=
        (IsLocalRing.residue_eq_zero_iff _).mp hp
      apply Ideal.mem_map_of_mem
      have hdec : p = (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
          MvPolynomial.C (MvPolynomial.constantCoeff p) := by ring
      rw [hdec]
      apply Ideal.add_mem
      · apply Ideal.mem_sup_left
        have hsub : Ideal.span ((MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) ↥W) '' Set.univ) ≤
            Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
          apply Ideal.span_mono
          rintro _ ⟨i, -, rfl⟩
          fin_cases i <;> simp
        apply hsub
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        rw [MvPolynomial.mem_support_iff] at hm
        by_contra hcon
        push_neg at hcon
        have hm0 : m = 0 := by
          ext i
          exact hcon i (Set.mem_univ i)
        apply hm
        rw [hm0, MvPolynomial.coeff_sub, MvPolynomial.coeff_zero_C,
          ← MvPolynomial.constantCoeff_eq, sub_self]
      · apply Ideal.mem_sup_right
        exact Ideal.mem_map_of_mem _ hcm
  have hmNker : mN = RingHom.ker rN := by
    ext t
    rw [RingHom.mem_ker]
    exact hstarN t
  have hmNprime : mN.IsPrime := by
    rw [hmNker]
    exact RingHom.ker_isPrime rN

  let rA : Polynomial ↥W →+* IsLocalRing.ResidueField ↥W :=
    (IsLocalRing.residue ↥W).comp Polynomial.constantCoeff
  have hstarA : ∀ p : Polynomial ↥W,
      p ∈ Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C ↔
        rA p = 0 := by
    intro p
    constructor
    · intro hp
      have hle : Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C ≤
          RingHom.ker rA := by
        apply sup_le
        · rw [Ideal.span_le]
          intro x hx
          rw [Set.mem_singleton_iff] at hx
          subst hx
          show rA Polynomial.X = 0
          simp [rA]
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          show rA (Polynomial.C c) = 0
          simp only [rA, RingHom.comp_apply, Polynomial.constantCoeff_apply, Polynomial.coeff_C_zero]
          exact (IsLocalRing.residue_eq_zero_iff c).mpr hc
      exact hle hp
    · intro hp
      have hcm : p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
        apply (IsLocalRing.residue_eq_zero_iff _).mp
        simpa [rA, Polynomial.constantCoeff_apply] using hp
      rw [← Polynomial.X_mul_divX_add p]
      apply Ideal.add_mem
      · apply Ideal.mem_sup_left
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      · apply Ideal.mem_sup_right
        exact Ideal.mem_map_of_mem _ hcm

  let φ : Polynomial ↥W →+* MvPolynomial (Fin 2) ↥W ⧸ J :=
    Polynomial.eval₂RingHom (mk.comp MvPolynomial.C) (mk (MvPolynomial.X 0))
  have hφC : ∀ c, φ (Polynomial.C c) = mk (MvPolynomial.C c) := by
    intro c
    show Polynomial.eval₂ _ _ (Polynomial.C c) = _
    rw [Polynomial.eval₂_C, RingHom.comp_apply]
  have hφX : φ Polynomial.X = mk (MvPolynomial.X 0) := by
    show Polynomial.eval₂ _ _ Polynomial.X = _
    rw [Polynomial.eval₂_X]
  have hcomp : rN.comp φ = rA := by
    apply Polynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, hφC, hrN, MvPolynomial.constantCoeff_C]
      simp [rA]
    · rw [RingHom.comp_apply, hφX, hrN]
      simp [rA]
  have hstar : ∀ p : Polynomial ↥W, φ p ∈ mN ↔
      p ∈ Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C := by
    intro p
    rw [hstarN, hstarA, ← hcomp, RingHom.comp_apply]

  obtain ⟨Q, iQ, f, hf⟩ := wcNd_hens_exists (MvPolynomial (Fin 2) ↥W ⧸ J) mN hmNprime
  letI := iQ
  have hunit : ∀ p : Polynomial ↥W, IsUnit ((f.comp φ) p) ↔
      p ∉ Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C := by
    intro p
    rw [RingHom.comp_apply, hf.2.1, hstar]
  obtain ⟨h, ⟨hh, hloc⟩, -⟩ := hH.2.2 Q hf.1 (f.comp φ) hunit
  refine ⟨Q, iQ, f, h, ⟨hb'm, hb'0, ?_, hf⟩, hloc, ?_⟩
  · ext c
    have := RingHom.congr_fun hh (Polynomial.C c)
    simp only [RingHom.comp_apply] at this ⊢
    rw [this, hφC]
  · have := RingHom.congr_fun hh Polynomial.X
    simp only [RingHom.comp_apply] at this
    rw [this, hφX]

theorem wcpa_dj_llsm_scrs_nm_disc_branch_inj : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] (fA : Polynomial ↥W →+* P), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) P fA → ∀ (Q : Type u) [CommRing Q] (σQ : ↥W →+* Q) (b' : ↥W) (f : wcEbntN W b' →+* Q), wcEbntPres W σQ b' f → ∀ (h : P →+* Q), h.comp (fA.comp Polynomial.C) = σQ → h (fA Polynomial.X) = f (wcEbntX W b' 0) → ∀ F : P, h F ∈ Ideal.span {f (wcEbntX W b' 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σQ → F ∈ (IsLocalRing.maximalIdeal ↥W).map (fA.comp Polynomial.C) :=
by
  intro Ω _ _ W hdim hWt P _ fA hH Q _ σQ b' f hpres h hhC hhX F hF
  classical

  have s2 : ∀ (A B P : Type u) [CommRing A] [CommRing B] [CommRing P] (φ : A ≃+* B)
      (p : Ideal A) (e : A →+* P), wcNdIsHens p P e →
      wcNdIsHens (Ideal.map φ p) P (e.comp φ.symm.toRingHom) := by
    intro A B P _ _ _ φ p e he
    obtain ⟨hH, hU, hUP⟩ := he
    have hle : Ideal.map φ p ≤ Ideal.comap φ.symm p :=
