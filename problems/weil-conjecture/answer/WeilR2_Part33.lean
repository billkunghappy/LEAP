      simp only [RingHom.comp_apply]
      rw [hψw, ← hιA, ← RingHom.comp_apply j ι, hjι]
    · show e (j (ψ (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) = _
      rw [hψ0, ← hιA, ← RingHom.comp_apply j ι, hjι]
    · show e (j (ψ (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) = _
      rw [hψ1, ← hιs, ← RingHom.comp_apply j ι, hjι]

theorem wcpa_dj_llsm_brrm_norm_bridge : ∀ (K : Type u) [Field K] (L : Type u) [Field L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (R : Type u) [CommRing R] [IsDomain R] [Algebra R K] [IsFractionRing R K] [Algebra R L]
    [IsScalarTower R K L]
