theorem wcpa_dj_llsm_rsior_chart_loc : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    (A' : Type u) [CommRing A'] [IsDomain A'] [Algebra ↥W A'] [Algebra A' K] [IsFractionRing A' K]
    (𝔭 : Ideal A) (𝔭' : Ideal A') (t : A) (u' v' : A') (c a' q : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
