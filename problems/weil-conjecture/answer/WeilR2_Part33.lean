    have hz'coe : ((Polynomial.eval₂ (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))
        ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩
        (Polynomial.reflect g.natDegree g) : ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})) : K) =
        Polynomial.aeval (wcLlsScS W A K t c' b') (Polynomial.reflect g.natDegree g) := by
      rw [← Polynomial.aeval_def, Polynomial.aeval_subalgebra_coe]
    have hz'J : (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
        (Polynomial.eval₂ (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))
        ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩
        (Polynomial.reflect g.natDegree g)) ∈ wcLlsScJ W A K L t c' b' := by
      refine (hchar _ g.natDegree _ ?_).mp hr
      calc _ = algebraMap K L (Polynomial.aeval (wcLlsScS W A K t c' b')
