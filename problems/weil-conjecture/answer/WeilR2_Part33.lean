    rw [← hWB]
  have hu₃K : algebraMap S K u₃ = s := rfl
  have hv₃K : algebraMap S K v₃ = algebraMap A K v := V1 v
  have V3 : φ u = algebraMap ↥W S b₀ * u₃ := by
