    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) t ∈ wcLlsScN W A K t c' r
      have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) t =
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A c') +
          algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A r) *
          ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :=
        Subtype.ext hS1
      rw [e]
      refine add_mem (Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A)) hc'))
        (Ideal.mul_mem_left _ _ hs)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      show algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w) ∈
        wcLlsScN W A K t c' r
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A)) hw)
  have hprime_eq : ∀ P : Ideal ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}), P.IsPrime →
      wcLlsScN W A K t c' r ≤ P → P = wcLlsScN W A K t c' r := by
    intro P hP hNP
    haveI := hP
    have hc : P.comap (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) = 𝔭 :=
      (h𝔭max.eq_of_le (Ideal.comap_isPrime _ P).ne_top (hb.trans (Ideal.comap_mono hNP))).symm
    refine le_antisymm ?_ hNP
    intro y hy
    obtain ⟨a, z, hyaz⟩ := hnf (y : K) y.2
    have hy' : y = algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) a +
        ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ * z :=
      Subtype.ext hyaz
    have haP : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) a ∈ P := by
      have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) a =
          y - ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ * z := by
        rw [hy']; ring
      rw [e]
      exact sub_mem hy (Ideal.mul_mem_right _ _ (hNP hs))
    have ha𝔭 : a ∈ 𝔭 := by rw [← hc]; exact haP
    rw [hy']
    exact add_mem (hb ha𝔭) (Ideal.mul_mem_right _ _ hs)

  by_cases hT : wcLlsScJ W A K L t c' (r * q') ⊔ Ideal.span {x} = ⊤
  · rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at hT
    obtain ⟨j, hj, y, hy, hjy⟩ := hT
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    refine ⟨a, ?_⟩
    have e : x * a - 1 = -j := by rw [← hjy]; ring
    rw [e]
    exact neg_mem hj
  · exfalso
    obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal _ hT
    haveI : M.IsPrime := hM.isPrime
    have hJ : wcLlsScJ W A K L t c' (r * q') ≤ M := le_trans le_sup_left hJM
    have hxM : x ∈ M := hJM (Ideal.mem_sup_right (Ideal.mem_span_singleton_self x))
    have hG : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W →
        ∀ e : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' (r * q')}) L),
        (e : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w)) → e ∈ M := by
      intro w hw e he
      exact hJ (Ideal.le_radical (Ideal.subset_span ⟨w, hw, he⟩))
    have hNP : wcLlsScN W A K t c' r ≤ (M.comap ι).comap
        (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) := by
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        show ι (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
          ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩) ∈ M
        have e : ι (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
            ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩) =
            algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' (r * q')})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' (r * q')}) L)
              (algebraMap A _ (algebraMap ↥W A q')) *
            algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' (r * q')})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' (r * q')}) L)
              ⟨wcLlsScS W A K t c' (r * q'), Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
          apply Subtype.ext
          show algebraMap K L (wcLlsScS W A K t c' r) =
            algebraMap K L (algebraMap A K (algebraMap ↥W A q')) *
              algebraMap K L (wcLlsScS W A K t c' (r * q'))
          rw [← map_mul, ← hS2]
        rw [e]
        exact Ideal.mul_mem_right _ _ (hG q' hq' _ rfl)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hG w hw _ rfl
    have hPQ : M.comap ι = Q := hQU (M.comap ι) inferInstance (hprime_eq _ inferInstance hNP)
    have hιd : ι d = x := Subtype.ext hxd.symm
    apply hdQ
    rw [← hPQ, Ideal.mem_comap, hιd]
    exact hxM

theorem wcpa_dj_llsm_flw_adjoin_residue : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' r : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W → r ≠ 0 → ∀ x : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}), ∃ w : ↥W, x - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w) ∈ wcLlsScN W A K t c' r :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ 𝔭 t hPD c' r hc' hr hr0
  obtain ⟨hFT, hNZ, _hIC, hmax, hle, _ht, hpeq, _⟩ := hPD
  haveI := hNZ


  have hres : ∀ a : A, ∃ w : ↥W, a - algebraMap ↥W A w ∈ 𝔭 := by
    intro a
    have T1 : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
      apply IsAlgClosed.of_exists_root
      intro p hpmon hpirr
      have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact IsLocalRing.residue_surjective _
      obtain ⟨q, hqmap, hqdeg, hqmon⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic hlift hpmon
      have hpdeg : 0 < p.natDegree := hpirr.natDegree_pos
      set j : ↥W →+* Ω := algebraMap ↥W Ω with hj
      have hQmon : (q.map j).Monic := hqmon.map j
      have hQdeg : (q.map j).natDegree = q.natDegree := hqmon.natDegree_map j
      have hQd : (q.map j).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hQmon.ne_zero, hQdeg, hqdeg]
        exact_mod_cast hpdeg.ne'
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (q.map j) hQd
      have hzint : _root_.IsIntegral ↥W z := by
        refine ⟨q, hqmon, ?_⟩
        rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
        exact hz
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
      have hqy : q.eval y = 0 := by
        apply (IsFractionRing.injective ↥W Ω)
        rw [map_zero, ← Polynomial.eval_map_apply]
        rw [hy]
        exact hz
      refine ⟨IsLocalRing.residue ↥W y, ?_⟩
      rw [← hqmap, Polynomial.eval_map_apply, hqy, map_zero]
    have T2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
        [IsAlgClosed (IsLocalRing.ResidueField R)] (k : Type u) [Field k] (ρ : R →+* k),
        IsLocalHom ρ → ρ.FiniteType → Function.Surjective ρ := by
      intro R _ _ _ k _ ρ hloc hρFT
      set ψ := IsLocalRing.ResidueField.lift ρ with hψ
      have hψr : ψ.comp (IsLocalRing.residue R) = ρ :=
        IsLocalRing.ResidueField.lift_comp_residue ρ
      have hψFT : ψ.FiniteType := by
        rw [← hψr] at hρFT
        exact RingHom.FiniteType.of_comp_finiteType hρFT
      have hψfin : ψ.Finite := (RingHom.finite_iff_finiteType_of_isJacobsonRing).mpr hψFT
      have hψsurj : Function.Surjective ψ :=
        (IsAlgClosed.ringHom_bijective_of_isIntegral ψ hψfin.to_isIntegral).2
      rw [← hψr]
      exact hψsurj.comp (IsLocalRing.residue_surjective)
    have := hmax
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    let ρ : ↥W →+* A ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)
    have hloc : IsLocalHom ρ := by
      refine ⟨fun x hx => ?_⟩
      by_contra hxu
      have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal x).mpr hxu
      have h1 : algebraMap ↥W A x ∈ 𝔭 := hle (Ideal.mem_map_of_mem _ hxm)
      have h2 : ρ x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1
      rw [h2] at hx
      exact not_isUnit_zero hx
    have hρFT : ρ.FiniteType :=
      RingHom.FiniteType.comp_surjective (RingHom.finiteType_algebraMap.mpr hFT)
        Ideal.Quotient.mk_surjective
    obtain ⟨w, hw⟩ := T2 ↥W (A ⧸ 𝔭) ρ hloc hρFT (Ideal.Quotient.mk 𝔭 a)
    refine ⟨w, ?_⟩
    exact Ideal.Quotient.eq.mp hw.symm

  have hrA : algebraMap ↥W A r ≠ 0 := by
    intro h
    have h1 : r • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one, h]
    rcases NoZeroSMulDivisors.eq_zero_or_eq_zero_of_smul_eq_zero h1 with h2 | h2
    · exact hr0 h2
    · exact one_ne_zero h2
  have hrK : algebraMap A K (algebraMap ↥W A r) ≠ 0 := fun h =>
    hrA ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))

  have hkey : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) t =
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A c') +
        algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A r) *
          ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
    apply Subtype.ext
    show algebraMap A K t = algebraMap A K (algebraMap ↥W A c') +
      algebraMap A K (algebraMap ↥W A r) * wcLlsScS W A K t c' r
    rw [wcLlsScS, map_sub, mul_div_cancel₀ _ hrK]
    ring

  have h𝔭N : 𝔭 ≤ (wcLlsScN W A K t c' r).comap
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) := by
    rw [hpeq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, hkey,
        wcLlsScN]
      refine Ideal.add_mem _ (Ideal.mem_sup_right ?_) (Ideal.mem_sup_left ?_)
      · exact Ideal.mem_map_of_mem
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A)) hc'
      · exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, wcLlsScN]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A)) hw)

  intro x
  obtain ⟨y, hy⟩ := x
  refine Algebra.adjoin_induction (p := fun y hy => ∃ w : ↥W,
    (⟨y, hy⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) -
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w) ∈
        wcLlsScN W A K t c' r) ?_ ?_ ?_ ?_ hy
  · intro y hy'
    rw [Set.mem_singleton_iff] at hy'
    subst hy'
    refine ⟨0, ?_⟩
    rw [map_zero, map_zero, sub_zero, wcLlsScN]
    exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  · intro a
    obtain ⟨w, hw⟩ := hres a
    refine ⟨w, ?_⟩
    have h1 := h𝔭N hw
    rw [Ideal.mem_comap, map_sub] at h1
    exact h1
  · intro y z hy hz h1 h2
    obtain ⟨w1, h1⟩ := h1
    obtain ⟨w2, h2⟩ := h2
    refine ⟨w1 + w2, ?_⟩
    show (⟨y, hy⟩ + ⟨z, hz⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) -
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A (w1 + w2)) ∈
        wcLlsScN W A K t c' r
    rw [map_add, map_add]
    have h3 := Ideal.add_mem _ h1 h2
    convert h3 using 1
    abel
  · intro y z hy hz h1 h2
    obtain ⟨w1, h1⟩ := h1
    obtain ⟨w2, h2⟩ := h2
    refine ⟨w1 * w2, ?_⟩
    show (⟨y, hy⟩ * ⟨z, hz⟩ : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) -
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A (w1 * w2)) ∈
        wcLlsScN W A K t c' r
    rw [map_mul, map_mul]
    have h3 := Ideal.add_mem _ (Ideal.mul_mem_right (⟨z, hz⟩ :
      ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) _ h1)
      (Ideal.mul_mem_left _
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w1)) h2)
    convert h3 using 1
    ring

theorem wcpa_dj_llsm_flw_closure_residue : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (L : Type u) [Field L] [Algebra R L] (σ : ↥W →+* ↥(integralClosure R L)) (Q : Ideal ↥(integralClosure R L)), Q.IsPrime → (∀ x : R, ∃ w : ↥W, algebraMap R ↥(integralClosure R L) x - σ w ∈ Q) → (∀ w ∈ IsLocalRing.maximalIdeal ↥W, σ w ∈ Q) → ∀ b : ↥(integralClosure R L), ∃ w : ↥W, b - σ w ∈ Q :=
by
  intro Ω _ _ W R _ L _ _ σ Q hQ H1 _ b

  have s1 : ∀ f : Polynomial ↥W, f.Monic → 1 ≤ f.natDegree → ∃ c : ↥W, f.IsRoot c := by
    intro f hf hd
    have hdeg : (f.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [hf.degree_map, Polynomial.degree_eq_natDegree hf.ne_zero]
      intro h
      have : f.natDegree = 0 := by exact_mod_cast h
      omega
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root _ hdeg
    have hint : _root_.IsIntegral ↥W α :=
      ⟨f, hf, by rwa [Polynomial.IsRoot, Polynomial.eval_map] at hα⟩
    obtain ⟨c, hc⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
    refine ⟨c, Polynomial.IsRoot.of_map (f := algebraMap ↥W Ω) ?_ (IsFractionRing.injective ↥W Ω)⟩
    rw [hc]; exact hα

  have s2 : ∀ (n : ℕ) (f : Polynomial ↥W), f.natDegree = n → f.Monic →
      Polynomial.eval₂ σ b f ∈ Q → ∃ c : ↥W, b - σ c ∈ Q := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro f hfn hf hQf
      rcases Nat.eq_zero_or_pos n with h0 | hpos
      · have h1 : f = 1 := Polynomial.eq_one_of_monic_natDegree_zero hf (hfn.trans h0)
        rw [h1, Polynomial.eval₂_one] at hQf
        exact absurd (Ideal.eq_top_of_isUnit_mem Q hQf isUnit_one) hQ.ne_top
      · obtain ⟨c, hc⟩ := s1 f hf (by omega)
        have hfac : (Polynomial.X - Polynomial.C c) * (f /ₘ (Polynomial.X - Polynomial.C c)) = f :=
          Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hc
        have hgm : (f /ₘ (Polynomial.X - Polynomial.C c)).Monic :=
          Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c) (by rw [hfac]; exact hf)
        have hgd : (f /ₘ (Polynomial.X - Polynomial.C c)).natDegree = f.natDegree - 1 := by
          rw [Polynomial.natDegree_divByMonic f (Polynomial.monic_X_sub_C c),
            Polynomial.natDegree_X_sub_C]
        have hev : Polynomial.eval₂ σ b f =
            (b - σ c) * Polynomial.eval₂ σ b (f /ₘ (Polynomial.X - Polynomial.C c)) := by
          conv_lhs => rw [← hfac]
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
        rw [hev] at hQf
        rcases hQ.mem_or_mem hQf with h | h
        · exact ⟨c, h⟩
        · exact ih (n - 1) (by omega) _ (by rw [hgd, hfn]) hgm h

  obtain ⟨p, hp, hpb⟩ := integralClosure.isIntegral b

  choose w hw using H1
  have hfm : (Polynomial.X ^ p.natDegree + ∑ i : Fin p.natDegree,
      Polynomial.C (w (p.coeff i)) * Polynomial.X ^ (i : ℕ)).Monic :=
    Polynomial.monic_X_pow_add
      (Polynomial.degree_sum_fin_lt (fun i : Fin p.natDegree => w (p.coeff i)))

  have hEp : Polynomial.eval₂ (algebraMap R ↥(integralClosure R L)) b p =
      b ^ p.natDegree + ∑ i ∈ Finset.range p.natDegree,
        algebraMap R ↥(integralClosure R L) (p.coeff i) * b ^ i := by
    conv_lhs => rw [hp.as_sum]
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
  have hEf : Polynomial.eval₂ σ b (Polynomial.X ^ p.natDegree + ∑ i : Fin p.natDegree,
      Polynomial.C (w (p.coeff i)) * Polynomial.X ^ (i : ℕ)) =
      b ^ p.natDegree + ∑ i ∈ Finset.range p.natDegree, σ (w (p.coeff i)) * b ^ i := by
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
    rw [Fin.sum_univ_eq_sum_range (fun i => σ (w (p.coeff i)) * b ^ i) p.natDegree]
  have hmem : Polynomial.eval₂ σ b (Polynomial.X ^ p.natDegree + ∑ i : Fin p.natDegree,
      Polynomial.C (w (p.coeff i)) * Polynomial.X ^ (i : ℕ)) ∈ Q := by
    rw [← sub_zero (Polynomial.eval₂ σ b _), ← hpb, hEf, hEp, add_sub_add_left_eq_sub,
      ← Finset.sum_sub_distrib]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    rw [← sub_mul]
    refine Ideal.mul_mem_right _ _ ?_
    rw [← neg_sub]
    exact Q.neg_mem_iff.mpr (hw _)

  exact s2 _ _ rfl hfm hmem

theorem wcpa_dj_llsm_kpde_fibre_dvr : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (t : A),
    wcLlsPD W A 𝔭 (.disc t) →
    ∃ _ : IsDomain (Localization.AtPrime 𝔭 ⧸ ((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭))),
      IsDiscreteValuationRing (Localization.AtPrime 𝔭 ⧸ ((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭))) ∧
      Irreducible (Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭)))
          (algebraMap A (Localization.AtPrime 𝔭) t)) :=
by
  intro Ω _ W A _ _ _ 𝔭 _ t hPD
  obtain ⟨-, -, -, -, hm𝔭, -, h𝔭eq, h, hh, f₀, hfC, hfX, hfet⟩ := hPD
  let π : Polynomial ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W) :=
    Polynomial.mapRingHom (IsLocalRing.residue ↥W)
  have hπX : π Polynomial.X = Polynomial.X := Polynomial.map_X _
  obtain ⟨E, _, fb, ρ, q, hq, hfbet, -, hρker, hfbπ, hqeq, ⟨eB⟩⟩ :=
    wcpa_dj_llsm_tg_chart_basechange W A 𝔭 h (Polynomial ↥W) f₀
      (Polynomial (IsLocalRing.ResidueField ↥W)) π hm𝔭 hh
      (by rw [Polynomial.algebraMap_eq]; exact hfC) hfet
      (Polynomial.map_surjective _ IsLocalRing.residue_surjective)
      (by rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, Polynomial.algebraMap_eq])
  have hqX : q = Ideal.span {fb Polynomial.X} := by
    rw [hqeq, h𝔭eq, Ideal.map_sup, Ideal.map_sup,
      (Ideal.map_eq_bot_iff_le_ker ρ).mpr (le_of_eq hρker.symm), sup_bot_eq,
      Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton, ← hfX,
      ← hfbπ, hπX]
  haveI := hq
  obtain ⟨hEdom, hEdvr⟩ := wcpa_dj_llsm_tg_etale_line_dvr (IsLocalRing.ResidueField ↥W) E fb q
    hfbet hqX
  set I : Ideal (Localization.AtPrime 𝔭) := ((IsLocalRing.maximalIdeal ↥W).map
    (algebraMap ↥W A)).map (algebraMap A (Localization.AtPrime 𝔭)) with hI
  haveI hR0dom : IsDomain (Localization.AtPrime 𝔭 ⧸ I) := MulEquiv.isDomain _ eB.toMulEquiv
  haveI hR0dvr : IsDiscreteValuationRing (Localization.AtPrime 𝔭 ⧸ I) :=
    IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing eB.symm
  refine ⟨hR0dom, hR0dvr, ?_⟩
  rw [IsDiscreteValuationRing.irreducible_iff_uniformizer]
  have hmk : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
  have hM : (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭 ⧸ I)).comap (Ideal.Quotient.mk I) =
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
    haveI := Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk I) hmk
      (K := IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭 ⧸ I))
    exact IsLocalRing.eq_maximalIdeal this
  have hS : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) =
      𝔭.map (algebraMap A (Localization.AtPrime 𝔭)) :=
    (Localization.AtPrime.map_eq_maximalIdeal).symm
  have h𝔭S : 𝔭.map (algebraMap A (Localization.AtPrime 𝔭)) =
      (Ideal.span {t}).map (algebraMap A (Localization.AtPrime 𝔭)) ⊔ I := by
    rw [hI, ← Ideal.map_sup]
    exact congrArg (Ideal.map (algebraMap A (Localization.AtPrime 𝔭))) h𝔭eq
  calc IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭 ⧸ I)
      = ((IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭 ⧸ I)).comap
          (Ideal.Quotient.mk I)).map (Ideal.Quotient.mk I) :=
        (Ideal.map_comap_of_surjective _ hmk _).symm
    _ = _ := by
        rw [hM, hS, h𝔭S, Ideal.map_sup, Ideal.map_quotient_self, sup_bot_eq, Ideal.map_span,
          Ideal.map_span, Set.image_singleton, Set.image_singleton]

theorem wcpa_dj_llsm_flsc_base_local : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' r : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W → r ≠ 0 →
    ∀ [(wcLlsScN W A K t c' r).IsPrime],
      IsIntegrallyClosed (Localization.AtPrime (wcLlsScN W A K t c' r)) ∧
      ∃ _ : IsDomain (Localization.AtPrime (wcLlsScN W A K t c' r) ⧸
          ((IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A))).map
            (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
              (Localization.AtPrime (wcLlsScN W A K t c' r)))),
        IsDiscreteValuationRing (Localization.AtPrime (wcLlsScN W A K t c' r) ⧸
          ((IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A))).map
            (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
              (Localization.AtPrime (wcLlsScN W A K t c' r)))) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' r hc' hr hr0 hN
  classical

  have loc_iso : ∀ (R B : Type u) [CommRing R] [CommRing B] [IsDomain B] (j : R →+* B),
      Function.Injective j → ∀ (N : Ideal R) [N.IsPrime] (P : Ideal B) [P.IsPrime],
      P.comap j = N → (∀ b : B, ∃ p q : R, q ∉ N ∧ j q * b = j p) →
      ∃ e : Localization.AtPrime N ≃+* Localization.AtPrime P, ∀ x : R,
        e (algebraMap R (Localization.AtPrime N) x) = algebraMap B (Localization.AtPrime P) (j x) := by
    intro R B _ _ _ j hj N _ P _ hPN hfrac
    have hy : N.primeCompl ≤ (P.primeCompl).comap j := by
      intro q hq h
      apply hq
      rw [← hPN]
      exact h
    let φ : Localization.AtPrime N →+* Localization.AtPrime P :=
      IsLocalization.map (Localization.AtPrime P) j hy
    have hφ : ∀ x : R, φ (algebraMap R _ x) = algebraMap B _ (j x) := fun x =>
      IsLocalization.map_eq hy x
    have hinj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.mk'_surjective N.primeCompl z
      dsimp only at hxs
      subst hxs
      have hz' := hz
      simp only [φ, IsLocalization.map_mk'] at hz'
      rw [IsLocalization.mk'_eq_zero_iff] at hz'
      obtain ⟨⟨m, hm⟩, hmx⟩ := hz'
      have hm0 : m ≠ 0 := by
        intro h; apply hm; rw [h]; exact P.zero_mem
      have hjx : j x = 0 := (mul_eq_zero.mp hmx).resolve_left hm0
      have hx : x = 0 := hj (hjx.trans (map_zero j).symm)
      rw [hx, IsLocalization.mk'_zero]
    have hsurj : Function.Surjective φ := by
      intro y
      obtain ⟨⟨b, ⟨u, hu⟩⟩, hbu⟩ := IsLocalization.mk'_surjective P.primeCompl y
      dsimp only at hbu
      subst hbu
      obtain ⟨p, q, hq, hpq⟩ := hfrac b
      obtain ⟨p₂, q₂, hq₂, hpq₂⟩ := hfrac u
      have hp₂ : p₂ ∉ N := by
        intro h
        rw [← hPN, Ideal.mem_comap, ← hpq₂] at h
        rcases (inferInstance : P.IsPrime).mem_or_mem h with h1 | h1
        · exact hq₂ (by rw [← hPN]; exact h1)
        · exact hu h1
      have hqp₂ : q * p₂ ∈ N.primeCompl := N.primeCompl.mul_mem hq hp₂
      refine ⟨IsLocalization.mk' (Localization.AtPrime N) (p * q₂) ⟨q * p₂, hqp₂⟩, ?_⟩
      simp only [φ, IsLocalization.map_mk']
      rw [IsLocalization.mk'_eq_iff_eq]
      apply congrArg
      show u * j (p * q₂) = j (q * p₂) * b
      rw [map_mul, map_mul]
      linear_combination (-(u * j q₂)) * hpq + (j q * b) * hpq₂
    exact ⟨RingEquiv.ofBijective φ ⟨hinj, hsurj⟩, hφ⟩

  have transport : ∀ (V R B : Type u) [CommRing V] [CommRing R] [CommRing B] (σR : V →+* R)
      (σB : V →+* B) (j : R →+* B), j.comp σR = σB → ∀ (I : Ideal V) (N : Ideal R) [N.IsPrime]
      (P : Ideal B) [P.IsPrime] (e : Localization.AtPrime N ≃+* Localization.AtPrime P),
      (∀ x : R, e (algebraMap R (Localization.AtPrime N) x) =
        algebraMap B (Localization.AtPrime P) (j x)) →
      IsIntegrallyClosed (Localization.AtPrime P) →
      (∃ _ : IsDomain (Localization.AtPrime P ⧸ (I.map σB).map (algebraMap B (Localization.AtPrime P))),
        IsDiscreteValuationRing (Localization.AtPrime P ⧸
          (I.map σB).map (algebraMap B (Localization.AtPrime P)))) →
      IsIntegrallyClosed (Localization.AtPrime N) ∧
      ∃ _ : IsDomain (Localization.AtPrime N ⧸ (I.map σR).map (algebraMap R (Localization.AtPrime N))),
        IsDiscreteValuationRing (Localization.AtPrime N ⧸
          (I.map σR).map (algebraMap R (Localization.AtPrime N))) := by
    intro V R B _ _ _ σR σB j hjσ I N _ P _ e he hic hdd
    obtain ⟨hdom, hdvr⟩ := hdd
    refine ⟨IsIntegrallyClosed.of_equiv e.symm, ?_⟩
    have hcomp : (e : Localization.AtPrime N →+* Localization.AtPrime P).comp
        (algebraMap R (Localization.AtPrime N)) = (algebraMap B (Localization.AtPrime P)).comp j :=
      RingHom.ext he
    have hJ : (I.map σB).map (algebraMap B (Localization.AtPrime P)) =
        ((I.map σR).map (algebraMap R (Localization.AtPrime N))).map
          (e : Localization.AtPrime N →+* Localization.AtPrime P) := by
      rw [Ideal.map_map, Ideal.map_map, Ideal.map_map, hcomp, ← hjσ, RingHom.comp_assoc]
    let e' := Ideal.quotientEquiv _ _ e hJ
    haveI hdomN : IsDomain (Localization.AtPrime N ⧸
        (I.map σR).map (algebraMap R (Localization.AtPrime N))) :=
      MulEquiv.isDomain _ e'.toMulEquiv
    exact ⟨hdomN, IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e'.symm⟩

  obtain ⟨A'', _, _, _, _, _, _, _, t', 𝔭'', hBr, ht', hPD'', -⟩ :=
    wcpa_dj_llsm_br_residue_chart Ω W hW hWt A K L 𝔭 t c' r hPD hc' hr hr0
  change wcLlsBrSub W A K A'' (wcLlsScS W A K t c' r) {wcLlsScS W A K t c' r} at hBr
  change algebraMap A'' K t' = wcLlsScS W A K t c' r at ht'
  obtain ⟨hBi, hBii, hBiii⟩ := hBr
  obtain ⟨_, _, hIC'', hmax'', hle'', ht'p, -⟩ := id hPD''
  haveI : 𝔭''.IsPrime := hmax''.isPrime
  have hι : Function.Injective (algebraMap A'' K) := IsFractionRing.injective A'' K

  have hex : ∀ x : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}), ∃ y : A'',
      algebraMap A'' K y = (x : K) := fun x => hBii x.2
  choose jf hjf using hex
  let j : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) →+* A'' :=
    { toFun := jf
      map_one' := hι (by simp [hjf])
      map_mul' := fun x y => hι (by simp [hjf])
      map_zero' := hι (by simp [hjf])
      map_add' := fun x y => hι (by simp [hjf]) }
  have hJ : ∀ x, algebraMap A'' K (j x) = (x : K) := fun x => hjf x
  have hjinj : Function.Injective j := by
    intro x y hxy
    apply Subtype.ext
    rw [← hJ x, ← hJ y, hxy]
  have hjσ : j.comp ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp
      (algebraMap ↥W A)) = algebraMap ↥W A'' := by
    refine RingHom.ext fun w => hι ?_
    rw [RingHom.comp_apply, hJ, hBi w]
    rfl
  have hjσ' : ∀ w : ↥W, j (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
      (algebraMap ↥W A w)) = algebraMap ↥W A'' w := fun w => RingHom.congr_fun hjσ w
  have hjS : j ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ = t' :=
    hι ((hJ _).trans ht'.symm)

  have hNle : wcLlsScN W A K t c' r ≤ 𝔭''.comap j := by
    unfold wcLlsScN
    refine sup_le ?_ ?_
    · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hjS]
      exact ht'p
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply, hjσ']
      exact hle'' (Ideal.mem_map_of_mem _ hw)
  have hcomap : 𝔭''.comap j = wcLlsScN W A K t c' r := by
    refine le_antisymm ?_ hNle
    intro x hx
    rw [Ideal.mem_comap] at hx
    obtain ⟨w, hw⟩ := wcpa_dj_llsm_flw_adjoin_residue Ω W A K 𝔭 t hPD c' r hc' hr hr0 x
    have hwm : w ∈ IsLocalRing.maximalIdeal ↥W := by
      by_contra hwm
      have hu : IsUnit w := by
        by_contra h
        exact hwm ((IsLocalRing.mem_maximalIdeal _).2 (mem_nonunits_iff.2 h))
      have h1 : j (x - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          (algebraMap ↥W A w)) ∈ 𝔭'' := hNle hw
      have h2 : algebraMap ↥W A'' w ∈ 𝔭'' := by
        rw [map_sub, hjσ'] at h1
        have := 𝔭''.sub_mem hx h1
        rwa [sub_sub_cancel] at this
      exact hmax''.ne_top (Ideal.eq_top_of_isUnit_mem _ h2 (hu.map _))
    have hσN : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w) ∈
        wcLlsScN W A K t c' r := by
      unfold wcLlsScN
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A)) hwm)
    have := Ideal.add_mem _ hw hσN
    rwa [sub_add_cancel] at this

  have hfrac : ∀ b : A'', ∃ p q : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}),
      q ∉ wcLlsScN W A K t c' r ∧ j q * b = j p := by
    intro b
    obtain ⟨p, q, hq, hpq⟩ := hBiii (algebraMap A'' K b) ⟨b, rfl⟩
    refine ⟨p, q, fun hqN => hq ?_, ?_⟩
    · refine (?_ : wcLlsScN W A K t c' r ≤ _) hqN
      unfold wcLlsScN
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact Ideal.subset_span (Set.mem_union_left _ rfl)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap]
        exact Ideal.subset_span (Set.mem_union_right _ ⟨w, hw, rfl⟩)
    · apply hι
      rw [map_mul, hJ, hJ, mul_comm]
      exact hpq
  obtain ⟨e, he⟩ := loc_iso _ A'' j hjinj (wcLlsScN W A K t c' r) 𝔭'' hcomap hfrac
  obtain ⟨hdom, hdvr, -⟩ := wcpa_dj_llsm_kpde_fibre_dvr Ω W A'' 𝔭'' t' hPD''
  haveI := hIC''
  have hP : IsIntegrallyClosed (Localization.AtPrime 𝔭'') :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime 𝔭'') 𝔭''.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors 𝔭'')
  exact transport ↥W _ A'' _ (algebraMap ↥W A'') j hjσ (IsLocalRing.maximalIdeal ↥W)
    (wcLlsScN W A K t c' r) 𝔭'' e he hP ⟨hdom, hdvr⟩

theorem wcpa_dj_llsm_flsc_fibre_dim : ∀ (W R B : Type u) [CommRing W] [IsLocalRing W] [CommRing R]
    [IsDomain R] [CommRing B] [IsDomain B] (σR : W →+* R) (f : R →+* B), Function.Injective f →
    f.IsIntegral → ∀ (N : Ideal R) [N.IsPrime] (Q : Ideal B) [Q.IsPrime], Q.comap f = N →
    (∀ Q' : Ideal B, Q'.IsPrime → Q'.comap f = N → Q' = Q) →
    IsIntegrallyClosed (Localization.AtPrime N) →
    (∃ _ : IsDomain (Localization.AtPrime N ⧸ ((IsLocalRing.maximalIdeal W).map σR).map
        (algebraMap R (Localization.AtPrime N))),
      IsDiscreteValuationRing (Localization.AtPrime N ⧸ ((IsLocalRing.maximalIdeal W).map σR).map
        (algebraMap R (Localization.AtPrime N)))) →
    ringKrullDim (Localization.AtPrime Q ⧸ ((IsLocalRing.maximalIdeal W).map (f.comp σR)).map
      (algebraMap B (Localization.AtPrime Q))) = ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro W R B _ _ _ _ _ _ σR f hfinj hfint N _ Q _ hQc _hU hNic hDVR
  classical
  rw [← Ideal.map_map σR f]
  generalize (IsLocalRing.maximalIdeal W).map σR = a at hDVR ⊢
  generalize hJ' : a.map (algebraMap R (Localization.AtPrime N)) = J at hDVR
  have hJ : J = a.map (algebraMap R (Localization.AtPrime N)) := hJ'.symm
  obtain ⟨hdom, hdvr⟩ := hDVR

  have hT1 : ringKrullDim (Localization.AtPrime N ⧸ J) = 1 :=
    IsPrincipalIdealRing.ringKrullDim_eq_one _ (IsDiscreteValuationRing.not_isField _)
  have hJprime : J.IsPrime := (Ideal.Quotient.isDomain_iff_prime J).mp hdom
  have hJle : J ≤ IsLocalRing.maximalIdeal (Localization.AtPrime N) :=
    IsLocalRing.le_maximalIdeal hJprime.ne_top
  obtain ⟨p, hpdef⟩ : ∃ p : Ideal R, p = J.comap (algebraMap R (Localization.AtPrime N)) :=
    ⟨_, rfl⟩
  have hap : a ≤ p := by
    rw [hpdef, hJ]; exact Ideal.le_comap_map
  have hpN : p ≤ N := by
    rw [hpdef]
    calc J.comap (algebraMap R (Localization.AtPrime N))
        ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime N)).comap
            (algebraMap R (Localization.AtPrime N)) := Ideal.comap_mono hJle
      _ = N := Localization.AtPrime.under_maximalIdeal
  have hpne : p ≠ N := by
    intro hpN'
    have h1 : J = IsLocalRing.maximalIdeal (Localization.AtPrime N) := by
      rw [← IsLocalization.map_under N.primeCompl (Localization.AtPrime N) J]
      change Ideal.map _ (J.comap (algebraMap R (Localization.AtPrime N))) = _
      rw [← hpdef, hpN']
      exact Localization.AtPrime.map_eq_maximalIdeal
    have hmax : J.IsMaximal := by rw [h1]; exact IsLocalRing.maximalIdeal.isMaximal _
    exact IsDiscreteValuationRing.not_isField _
      ((Ideal.Quotient.maximal_ideal_iff_isField_quotient J).mp hmax)

  have hNQ : N = Q.comap f := hQc.symm
  have hstar : (Localization.localRingHom N Q f hNQ).comp (algebraMap R (Localization.AtPrime N)) =
      (algebraMap B (Localization.AtPrime Q)).comp f :=
    RingHom.ext (fun x => Localization.localRingHom_to_map N Q f hNQ x)
  have hupper : ringKrullDim (Localization.AtPrime Q ⧸ (a.map f).map
      (algebraMap B (Localization.AtPrime Q))) ≤ ringKrullDim (Localization.AtPrime N ⧸ J) := by
    rw [ringKrullDim_quotient, ringKrullDim_quotient]
    have hmem : ∀ P : PrimeSpectrum (Localization.AtPrime Q),
        P ∈ PrimeSpectrum.zeroLocus (((a.map f).map (algebraMap B (Localization.AtPrime Q)) :
          Ideal (Localization.AtPrime Q)) : Set (Localization.AtPrime Q)) →
        (⟨Ideal.comap (Localization.localRingHom N Q f hNQ) P.asIdeal, inferInstance⟩ :
          PrimeSpectrum (Localization.AtPrime N)) ∈ PrimeSpectrum.zeroLocus (J : Set _) := by
      intro P hP
      rw [PrimeSpectrum.mem_zeroLocus] at hP ⊢
      have h1 : J.map (Localization.localRingHom N Q f hNQ) ≤ P.asIdeal := by
        rw [hJ, Ideal.map_map, hstar, ← Ideal.map_map]
        exact SetLike.coe_subset_coe.mp hP
      exact SetLike.coe_subset_coe.mpr (Ideal.map_le_iff_le_comap.mp h1)
    refine Order.krullDim_le_of_strictMono
      (fun P => ⟨⟨Ideal.comap (Localization.localRingHom N Q f hNQ) P.1.asIdeal, inferInstance⟩,
        hmem P.1 P.2⟩) ?_
    intro P₁ P₂ hlt
    have hlt' : P₁.1.asIdeal < P₂.1.asIdeal := hlt
    change Ideal.comap (Localization.localRingHom N Q f hNQ) P₁.1.asIdeal <
      Ideal.comap (Localization.localRingHom N Q f hNQ) P₂.1.asIdeal
    refine lt_of_le_of_ne (Ideal.comap_mono hlt'.le) ?_
    intro heq
    have hP12 : P₁.1.asIdeal.comap (algebraMap B (Localization.AtPrime Q)) <
        P₂.1.asIdeal.comap (algebraMap B (Localization.AtPrime Q)) := by
      refine lt_of_le_of_ne (Ideal.comap_mono hlt'.le) ?_
      intro h
      apply hlt'.ne
      rw [← IsLocalization.map_under Q.primeCompl (Localization.AtPrime Q) P₁.1.asIdeal,
        ← IsLocalization.map_under Q.primeCompl (Localization.AtPrime Q) P₂.1.asIdeal]
      exact congrArg (Ideal.map (algebraMap B (Localization.AtPrime Q))) h
    have hc : (P₁.1.asIdeal.comap (algebraMap B (Localization.AtPrime Q))).comap f =
        (P₂.1.asIdeal.comap (algebraMap B (Localization.AtPrime Q))).comap f := by
      have := congrArg (Ideal.comap (algebraMap R (Localization.AtPrime N))) heq
      rw [Ideal.comap_comap, Ideal.comap_comap, hstar] at this
      rw [Ideal.comap_comap, Ideal.comap_comap]
      exact this
    obtain ⟨x, hx2, hx1⟩ := SetLike.exists_of_lt hP12
    letI : Algebra R B := f.toAlgebra
    haveI : (P₁.1.asIdeal.comap (algebraMap B (Localization.AtPrime Q))).IsPrime :=
      Ideal.IsPrime.comap _
    have hlt2 := Ideal.under_lt_under_of_integral_mem_sdiff (R := R) hP12.le ⟨hx2, hx1⟩ (hfint x)
    exact hlt2.ne hc

  obtain ⟨P, hPprime, hPQ, hPc⟩ : ∃ P : Ideal B, P.IsPrime ∧ P ≤ Q ∧ P.comap f = p := by
    letI : Algebra R B := f.toAlgebra
    haveI : Algebra.IsIntegral R B := ⟨hfint⟩
    haveI hBNdom : IsDomain (Localization (Algebra.algebraMapSubmonoid B N.primeCompl)) := by
      apply IsLocalization.isDomain_localization
      intro y hy
      obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hy
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      apply hs
      have : s = 0 := hfinj (by rw [map_zero]; exact h0)
      rw [this]; exact N.zero_mem
    haveI : FaithfulSMul (Localization.AtPrime N)
        (Localization (Algebra.algebraMapSubmonoid B N.primeCompl)) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr
        (localizationAlgebra_injective (M := N.primeCompl) _ _ hfinj)
    haveI : Algebra.HasGoingDown (Localization.AtPrime N)
        (Localization (Algebra.algebraMapSubmonoid B N.primeCompl)) := inferInstance
    have hdisjQ : Disjoint ((Algebra.algebraMapSubmonoid B N.primeCompl : Submonoid B) : Set B)
        (Q : Set B) := by
      rw [Set.disjoint_left]
      intro y hy hyQ
      obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hy
      apply hs
      rw [← hQc]
      exact hyQ
    haveI hQNp : (Q.map (algebraMap B
        (Localization (Algebra.algebraMapSubmonoid B N.primeCompl)))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint _ _ Q inferInstance hdisjQ
    haveI : Q.LiesOver N := ⟨hQc.symm⟩
    have hQN := IsLocalization.liesOver_of_isPrime_of_disjoint (R' := Localization.AtPrime N)
      (S' := Localization (Algebra.algebraMapSubmonoid B N.primeCompl))
      N.primeCompl (Algebra.algebraMapSubmonoid B N.primeCompl) N hdisjQ
    rw [Localization.AtPrime.map_eq_maximalIdeal] at hQN
    haveI := hQN
    haveI := hJprime
    obtain ⟨P', hP'le, hP'prime, hP'lo⟩ := Ideal.exists_ideal_le_liesOver_of_le (p := J)
      (q := IsLocalRing.maximalIdeal (Localization.AtPrime N))
      (Q.map (algebraMap B (Localization (Algebra.algebraMapSubmonoid B N.primeCompl)))) hJle
    refine ⟨P'.comap (algebraMap B (Localization (Algebra.algebraMapSubmonoid B N.primeCompl))),
      Ideal.IsPrime.comap _, ?_, ?_⟩
    · calc P'.comap (algebraMap B (Localization (Algebra.algebraMapSubmonoid B N.primeCompl)))
          ≤ (Q.map (algebraMap B (Localization (Algebra.algebraMapSubmonoid B N.primeCompl)))).comap
            (algebraMap B (Localization (Algebra.algebraMapSubmonoid B N.primeCompl))) :=
            Ideal.comap_mono hP'le
        _ = Q := IsLocalization.under_map_of_isPrime_disjoint _ _ inferInstance hdisjQ
    · rw [hpdef]
      change Ideal.comap (algebraMap R B) (Ideal.comap (algebraMap B
        (Localization (Algebra.algebraMapSubmonoid B N.primeCompl))) P') = _
      rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq R B,
        IsScalarTower.algebraMap_eq R (Localization.AtPrime N), ← Ideal.comap_comap]
      congr 1
      exact hP'lo.over.symm

  have hPne : P ≠ Q := fun h => hpne (by rw [← hPc, h, hQc])
  have haP : a.map f ≤ P := Ideal.map_le_iff_le_comap.mpr (by rw [hPc]; exact hap)
  have hlower : (1 : WithBot ℕ∞) ≤ ringKrullDim (Localization.AtPrime Q ⧸ (a.map f).map
      (algebraMap B (Localization.AtPrime Q))) := by
    rw [ringKrullDim_quotient, Order.one_le_krullDim_iff]
    have hdisjP : Disjoint (Q.primeCompl : Set B) (P : Set B) := by
      rw [Set.disjoint_left]; intro s hs hsP; exact hs (hPQ hsP)
    haveI hP'pr : (P.map (algebraMap B (Localization.AtPrime Q))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint Q.primeCompl _ P hPprime hdisjP
    have hPBq_le : P.map (algebraMap B (Localization.AtPrime Q)) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
      IsLocalRing.le_maximalIdeal hP'pr.ne_top
    have hIle : (a.map f).map (algebraMap B (Localization.AtPrime Q)) ≤
        P.map (algebraMap B (Localization.AtPrime Q)) := Ideal.map_mono haP
    refine ⟨⟨⟨P.map (algebraMap B (Localization.AtPrime Q)), hP'pr⟩, ?_⟩,
      ⟨⟨IsLocalRing.maximalIdeal (Localization.AtPrime Q), inferInstance⟩, ?_⟩, ?_⟩
    · exact (PrimeSpectrum.mem_zeroLocus _ _).mpr (SetLike.coe_subset_coe.mpr hIle)
    · exact (PrimeSpectrum.mem_zeroLocus _ _).mpr
        (SetLike.coe_subset_coe.mpr (hIle.trans hPBq_le))
    · change P.map (algebraMap B (Localization.AtPrime Q)) <
        IsLocalRing.maximalIdeal (Localization.AtPrime Q)
      refine lt_of_le_of_ne hPBq_le ?_
      intro h
      apply hPne
      have e1 := IsLocalization.under_map_of_isPrime_disjoint Q.primeCompl
        (Localization.AtPrime Q) hPprime hdisjP
      rw [h, Localization.AtPrime.under_maximalIdeal] at e1
      exact e1.symm
  rw [hT1] at hupper
  rw [Nat.cast_one]
  exact le_antisymm hupper hlower

theorem wcpa_dj_llsm_flsc_fibre_iso : ∀ (W B : Type u) [CommRing W] [IsLocalRing W] [CommRing B] [Algebra W B] (Q : Ideal B) [Q.IsMaximal], Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W) ≤ Q → ∃ (Q' : Ideal (TensorProduct W (IsLocalRing.ResidueField W) B)) (_ : Q'.IsMaximal), Q'.comap (Algebra.TensorProduct.includeRight : B →ₐ[W] TensorProduct W (IsLocalRing.ResidueField W) B) = Q ∧ Nonempty (Localization.AtPrime Q' ≃+* (Localization.AtPrime Q ⧸ (Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W)).map (algebraMap B (Localization.AtPrime Q)))) :=
by
  intro W B _ _ _ _ Q _ hI
  classical
  let fA : B →ₐ[W] TensorProduct W (IsLocalRing.ResidueField W) B :=
    Algebra.TensorProduct.includeRight
  let f : B →+* TensorProduct W (IsLocalRing.ResidueField W) B := fA.toRingHom
  have hf : ∀ b : B, f b = (1 : IsLocalRing.ResidueField W) ⊗ₜ[W] b := fun b => rfl

  have hsurj : Function.Surjective f := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero f⟩
    | tmul x b =>
      obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective x
      refine ⟨w • b, ?_⟩
      rw [hf, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
        IsLocalRing.ResidueField.algebraMap_eq]
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨b₁, rfl⟩ := h₁
      obtain ⟨b₂, rfl⟩ := h₂
      exact ⟨b₁ + b₂, map_add f b₁ b₂⟩

  have hker : RingHom.ker f = Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W) := by
    apply le_antisymm
    · intro b hb
      rw [RingHom.mem_ker] at hb
      let I := Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W)
      let h₀ : W →ₐ[W] B ⧸ I := Algebra.ofId W (B ⧸ I)
      have hh₀ : ∀ w ∈ IsLocalRing.maximalIdeal W, h₀ w = 0 := by
        intro w hw
        show Ideal.Quotient.mk I (algebraMap W B w) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_map_of_mem _ hw
      let h₁ : IsLocalRing.ResidueField W →ₐ[W] B ⧸ I :=
        Ideal.Quotient.liftₐ (IsLocalRing.maximalIdeal W) h₀ hh₀
      let g : TensorProduct W (IsLocalRing.ResidueField W) B →ₐ[W] B ⧸ I :=
        Algebra.TensorProduct.lift h₁ (Ideal.Quotient.mkₐ W I) (fun _ _ => Commute.all _ _)
      have hg : g (f b) = Ideal.Quotient.mk I b := by
        rw [hf, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rw [hb, map_zero] at hg
      exact Ideal.Quotient.eq_zero_iff_mem.mp hg.symm
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show fA (algebraMap W B w) = 0
      rw [AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply,
        IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff w).mpr hw,
        TensorProduct.zero_tmul]

  let Q' : Ideal (TensorProduct W (IsLocalRing.ResidueField W) B) := Ideal.map f Q
  have hcomap : Q'.comap f = Q := by
    show (Ideal.map f Q).comap f = Q
    rw [Ideal.comap_map_of_surjective' f hsurj, hker]
    exact sup_eq_left.mpr hI
  have hmax : Q'.IsMaximal := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective f hsurj (inferInstance : Q.IsMaximal)
      with h | h
    · exfalso
      have hQ : Q = ⊤ := by rw [← hcomap]; show (Ideal.map f Q).comap f = ⊤; rw [h, Ideal.comap_top]
      exact Ideal.IsMaximal.ne_top inferInstance hQ
    · exact h
  haveI : Q'.IsPrime := hmax.isPrime
  refine ⟨Q', hmax, hcomap, ?_⟩

  let J : Ideal (Localization.AtPrime Q) :=
    (Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W)).map
      (algebraMap B (Localization.AtPrime Q))
  let e : (B ⧸ RingHom.ker f) ≃+* TensorProduct W (IsLocalRing.ResidueField W) B :=
    RingHom.quotientKerEquivOfSurjective hsurj
  let q : B ⧸ RingHom.ker f →+* Localization.AtPrime Q ⧸ J :=
    Ideal.quotientMap J (algebraMap B (Localization.AtPrime Q))
      (by rw [hker]; exact Ideal.le_comap_map)
  let φ : TensorProduct W (IsLocalRing.ResidueField W) B →+* Localization.AtPrime Q ⧸ J :=
    q.comp e.symm.toRingHom
  letI : Algebra (TensorProduct W (IsLocalRing.ResidueField W) B) (Localization.AtPrime Q ⧸ J) :=
    φ.toAlgebra
  have hφ : ∀ b, φ (f b) = Ideal.Quotient.mk J (algebraMap B (Localization.AtPrime Q) b) := by
    intro b
    have h1 : e.symm (f b) = Ideal.Quotient.mk _ b := by
      apply e.injective
      rw [RingEquiv.apply_symm_apply]
      rfl
    show q (e.symm (f b)) = _
    rw [h1]
    rfl
  have hloc : IsLocalization (Submonoid.map f Q.primeCompl) (Localization.AtPrime Q ⧸ J) := by
    refine IsLocalization.of_surjective (M := Q.primeCompl) (S := Localization.AtPrime Q) f hsurj
      (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective ?_ ?_
    · ext b
      exact (hφ b).symm
    · rw [Ideal.mk_ker, hker]
  have hM : Submonoid.map f Q.primeCompl = Q'.primeCompl := by
    ext y
    simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
    constructor
    · rintro ⟨x, hx, rfl⟩ hfx
      exact hx (by rw [← hcomap]; exact hfx)
    · intro hy
      obtain ⟨x, rfl⟩ := hsurj y
      exact ⟨x, fun hx => hy (by rw [← hcomap] at hx; exact hx), rfl⟩
  rw [hM] at hloc
  exact ⟨(IsLocalization.algEquiv Q'.primeCompl (Localization.AtPrime Q')
    (Localization.AtPrime Q ⧸ J)).toRingEquiv⟩

theorem wcpa_dj_llsm_flsc_smooth_nbhd : ∀ (R K B : Type u) [CommRing R] [Field K] [PerfectField K] [Algebra R K] [CommRing B] [Algebra R B] [Algebra.FinitePresentation R B] [Module.Flat R B] (Q : Ideal B) [Q.IsPrime] (Q' : Ideal (TensorProduct R K B)) [Q'.IsMaximal], Q'.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R K B) = Q → IsRegularLocalRing (Localization.AtPrime Q') → ringKrullDim (Localization.AtPrime Q') = ((1 : ℕ) : WithBot ℕ∞) → ∃ b : B, b ∉ Q ∧ Algebra.IsStandardSmoothOfRelativeDimension 1 R (Localization.Away b) :=
by
  intro R K B _ _ _ _ _ _ _ _ Q _ Q' _ hQ hreg hdim
  classical

  have s2at : ∀ (A T : Type u) [CommRing A] [CommRing T] [Algebra A T] (n : ℕ) (Q : Ideal T)
      [Q.IsPrime] (s : T), s ∉ Q →
      Algebra.IsStandardSmoothOfRelativeDimension n A (Localization.Away s) →
      Algebra.IsSmoothAt A Q := by
    intro A T _ _ _ n Q _ s hs hstd
    haveI := hstd
    haveI : Algebra.IsStandardSmooth A (Localization.Away s) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.FormallySmooth A (Localization.Away s) := inferInstance
    letI : Algebra (Localization.Away s) (Localization.AtPrime Q) :=
      (IsLocalization.lift (M := Submonoid.powers s) (S := Localization.Away s)
        (g := algebraMap T (Localization.AtPrime Q)) (by
          rintro ⟨_, k, rfl⟩
          show IsUnit (algebraMap T (Localization.AtPrime Q) (s ^ k))
          rw [map_pow]
          exact (IsLocalization.map_units (Localization.AtPrime Q)
            (⟨s, hs⟩ : Q.primeCompl)).pow k)).toAlgebra
    haveI : IsScalarTower T (Localization.Away s) (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun t => (IsLocalization.lift_eq _ t).symm)
    haveI : IsScalarTower A (Localization.Away s) (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        rw [IsScalarTower.algebraMap_apply A T (Localization.Away s),
          ← IsScalarTower.algebraMap_apply T (Localization.Away s) (Localization.AtPrime Q),
          ← IsScalarTower.algebraMap_apply A T (Localization.AtPrime Q)])
    have hle : Submonoid.powers s ≤ Q.primeCompl := Submonoid.powers_le.mpr hs
    haveI := IsLocalization.isLocalization_of_submonoid_le (Localization.Away s)
      (Localization.AtPrime Q) (Submonoid.powers s) Q.primeCompl hle
    haveI : Algebra.FormallySmooth (Localization.Away s) (Localization.AtPrime Q) :=
      Algebra.FormallySmooth.of_isLocalization
        (Submonoid.map (algebraMap T (Localization.Away s)) Q.primeCompl)
    exact Algebra.FormallySmooth.comp A (Localization.Away s) (Localization.AtPrime Q)

  haveI hftK : Algebra.FiniteType K (TensorProduct R K B) :=
    Algebra.FiniteType.baseChange (R := R) (A := B) K
  haveI hlft : LocallyOfFiniteType
      (Spec.map (CommRingCat.ofHom (algebraMap K (TensorProduct R K B)))) :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType) (R := CommRingCat.of K)
      (S := CommRingCat.of (TensorProduct R K B))
      (φ := CommRingCat.ofHom (algebraMap K (TensorProduct R K B)))).mpr
      (RingHom.finiteType_algebraMap.mpr hftK)
  let z : Spec (CommRingCat.of (TensorProduct R K B)) :=
    (⟨Q', inferInstance⟩ : PrimeSpectrum (TensorProduct R K B))
  have hzc : IsClosed ({z} : Set (Spec (CommRingCat.of (TensorProduct R K B)))) :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal
      (⟨Q', inferInstance⟩ : PrimeSpectrum (TensorProduct R K B))).mpr ‹Q'.IsMaximal›
  let e := (Spec.stalkIso (CommRingCat.of (TensorProduct R K B))
    (⟨Q', inferInstance⟩ : PrimeSpectrum (TensorProduct R K B))).commRingCatIsoToRingEquiv
  have hzreg : IsRegularLocalRing
      ((Spec (CommRingCat.of (TensorProduct R K B))).presheaf.stalk z) := by
    haveI : IsRegularLocalRing (Localization.AtPrime Q') := hreg
    exact IsRegularLocalRing.of_ringEquiv e.symm
  have hzdim : ringKrullDim ((Spec (CommRingCat.of (TensorProduct R K B))).presheaf.stalk z) =
      ((1 : ℕ) : WithBot ℕ∞) :=
    (ringKrullDim_eq_of_ringEquiv e).trans hdim
  obtain ⟨U, hzU, hUsm⟩ := wcpa_dj_lr1k_gn_regular_closed_smooth K
    (Spec (CommRingCat.of (TensorProduct R K B)))
    (Spec.map (CommRingCat.ofHom (algebraMap K (TensorProduct R K B)))) 1 z hzc hzreg hzdim
  obtain ⟨s, hs, hstd⟩ := wcpa_dj_mn_fs_field_open_std K (TensorProduct R K B) 1 U z hzU hUsm
  have hs' : s ∉ Q' := hs
  haveI : Q'.IsPrime := inferInstance
  have hsmK : Algebra.IsSmoothAt K Q' := s2at K (TensorProduct R K B) 1 Q' s hs' hstd
  have hsmR : Algebra.IsSmoothAt R Q := wcpa_dj_mn_fs_fibrewise R K B Q' Q hQ hsmK
  obtain ⟨b, m, hb, hstdb⟩ := wcpa_dj_cf_ss_std_smooth_nbhd R B Q hsmR
  have hm := wcpa_dj_mn_fs_reldim R K B 1 m Q' s hs' hstd Q hQ b hb hstdb
  subst hm
  exact ⟨b, hb, hstdb⟩

theorem wcpa_dj_llsm_flsc_etale_coord : ∀ (W B : Type u) [CommRing W] [IsLocalRing W] [CommRing B] [Algebra W B] (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap W B) = IsLocalRing.maximalIdeal W → (∀ x : B, ∃ w : W, x - algebraMap W B w ∈ Q) → ∀ b : B, b ∉ Q → Algebra.IsStandardSmoothOfRelativeDimension 1 W (Localization.Away b) → ∃ g z : B, g ∉ Q ∧ z ∈ Q ∧ ∃ φ : Polynomial W →+* Localization.Away g, φ.comp Polynomial.C = (algebraMap B (Localization.Away g)).comp (algebraMap W B) ∧ φ Polynomial.X = algebraMap B (Localization.Away g) z ∧ φ.Etale :=
by
  have wc_tube_jacobian_etale : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (n : ℕ) (ι : Type) [Fintype ι] (a : ι → A), RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap R A) → Fintype.card ι = n → ∀ (q : Ideal A) [q.IsPrime], Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R A (a j))) = ⊤ → ∃ s : A, s ∉ q ∧ ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away s A'], RingHom.Etale ((algebraMap A A').comp (MvPolynomial.eval₂Hom (algebraMap R A) a)) := by
    classical
    have s5 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S]
        [Algebra R T] [Algebra S T] [IsScalarTower R S T], Algebra.FormallySmooth R T →
        Algebra.FinitePresentation R T → Algebra.FiniteType R S →
        Function.Bijective (KaehlerDifferential.mapBaseChange R S T) → Algebra.Etale S T := by
      intro R S T _ _ _ _ _ _ _ h1 h2 h3 hb
      have hH : Subsingleton (Algebra.H1Cotangent S T) := by
        have hx0 : ∀ x : Algebra.H1Cotangent S T, x = 0 := by
          intro x
          have hδ : Algebra.H1Cotangent.δ R S T x = 0 := by
            apply hb.1
            rw [map_zero]
            exact (Algebra.H1Cotangent.exact_δ_mapBaseChange R S T).apply_apply_eq_zero x
          obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ R S T x).mp hδ
          rw [Subsingleton.elim y 0, map_zero]
        exact ⟨fun a b => (hx0 a).trans (hx0 b).symm⟩
      have hΩ : Subsingleton Ω[T⁄S] := by
        have hw0 : ∀ w : Ω[T⁄S], w = 0 := by
          intro w
          obtain ⟨z, rfl⟩ := KaehlerDifferential.map_surjective R S T w
          obtain ⟨y, rfl⟩ := hb.2 z
          exact (KaehlerDifferential.exact_mapBaseChange_map R S T).apply_apply_eq_zero y
        exact ⟨fun a b => (hw0 a).trans (hw0 b).symm⟩
      haveI : Algebra.FormallyEtale S T := Algebra.FormallyEtale.mk hΩ hH
      haveI : Algebra.FinitePresentation S T :=
        Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R S T
      exact ⟨inferInstance, inferInstance⟩
    have s2 : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] [Module.Finite A M]
        (ι : Type) (v : ι → M) (q : Ideal A) [q.IsPrime],
        Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] v j)) = ⊤ →
        ∃ s : A, s ∉ q ∧ ∀ m : M, s • m ∈ Submodule.span A (Set.range v) := by
      intro A M _ _ _ _ ι v q _ h
      set N := Submodule.span A (Set.range v) with hN
      have hsub : Subsingleton (TensorProduct A q.ResidueField (M ⧸ N)) := by
        let πκ := LinearMap.baseChange q.ResidueField N.mkQ
        have hs : Function.Surjective πκ :=
          LinearMap.baseChange_surjective _ (Submodule.mkQ_surjective N)
        have hr : LinearMap.range πκ = ⊥ := by
          rw [LinearMap.range_eq_map, ← h, Submodule.map_span, Submodule.span_eq_bot]
          rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
          simp only [πκ, LinearMap.baseChange_tmul, Submodule.mkQ_apply]
          rw [(Submodule.Quotient.mk_eq_zero N).mpr (Submodule.subset_span ⟨j, rfl⟩),
            TensorProduct.tmul_zero]
        have h0 : ∀ x : TensorProduct A q.ResidueField (M ⧸ N), x = 0 := by
          intro x
          obtain ⟨x', rfl⟩ := hs x
          have hx : πκ x' ∈ LinearMap.range πκ := ⟨x', rfl⟩
          rw [hr] at hx
          exact hx
        exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
      let p : PrimeSpectrum A := ⟨q, inferInstance⟩
      have hnot : p ∉ Module.support A (M ⧸ N) := fun hp =>
        not_nontrivial_iff_subsingleton.mpr hsub
          ((Module.mem_support_iff_nontrivial_residueField_tensorProduct p).mp hp)
      rw [Module.mem_support_iff_of_finite] at hnot
      obtain ⟨s, hs, hsq⟩ := SetLike.not_le_iff_exists.mp hnot
      refine ⟨s, hsq, fun m => ?_⟩
      have := Module.mem_annihilator.mp hs (Submodule.Quotient.mk m)
      rw [← Submodule.Quotient.mk_smul] at this
      exact (Submodule.Quotient.mk_eq_zero N).mp this
    have s3 : ∀ (R A A' : Type u) [CommRing R] [CommRing A] [CommRing A'] [Algebra R A]
        [Algebra A A'] [Algebra R A'] [IsScalarTower R A A'] (ι : Type) [Fintype ι] (a : ι → A)
        (s : A) [IsLocalization.Away s A'] [Algebra (MvPolynomial ι R) A']
        [IsScalarTower R (MvPolynomial ι R) A'],
        (∀ j, algebraMap (MvPolynomial ι R) A' (MvPolynomial.X j) = algebraMap A A' (a j)) →
        (∀ ω : Ω[A⁄R], s • ω ∈
          Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (a j)))) →
        Function.Surjective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) A') := by
      intro R A A' _ _ _ _ _ _ _ ι _ a s _ _ _ hX hs
      haveI : Algebra.FormallyEtale A A' :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.powers s)
      have hbc := KaehlerDifferential.isBaseChange_of_formallyEtale R A A'
      rw [← LinearMap.range_eq_top, eq_top_iff]
      intro y _
      set Im := LinearMap.range (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) A')
        with hIm
      have hgen : ∀ j, KaehlerDifferential.map R R A A' (KaehlerDifferential.D R A (a j)) ∈ Im := by
        intro j
        refine ⟨1 ⊗ₜ KaehlerDifferential.D R _ (MvPolynomial.X j), ?_⟩
        simp only [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D, hX]
      have hle : Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (a j))) ≤
          (Im.restrictScalars A).comap (KaehlerDifferential.map R R A A') := by
        rw [Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        exact hgen j
      have hall : ∀ ω, KaehlerDifferential.map R R A A' ω ∈ Im := by
        intro ω
        have h1 := hle (hs ω)
        rw [Submodule.mem_comap, Submodule.restrictScalars_mem, LinearMap.map_smul,
          ← algebraMap_smul A' s] at h1
        obtain ⟨u, hu⟩ := IsLocalization.Away.algebraMap_isUnit (S := A') s
        have e : KaehlerDifferential.map R R A A' ω =
            (↑u⁻¹ : A') • (algebraMap A A' s • KaehlerDifferential.map R R A A' ω) := by
          rw [← hu, smul_smul, Units.inv_mul, one_smul]
        rw [e]
        exact Im.smul_mem _ h1
      exact hbc.inductionOn y hall (fun c n hn => Im.smul_mem c hn)
        (fun _ _ h1 h2 => Im.add_mem h1 h2)
    have s4 : ∀ (R T : Type u) [CommRing R] [CommRing T] (ι : Type) [Fintype ι] [Algebra R T]
        [Algebra (MvPolynomial ι R) T] [IsScalarTower R (MvPolynomial ι R) T] (n : ℕ),
        Algebra.IsStandardSmoothOfRelativeDimension n R T → Fintype.card ι = n →
        Function.Surjective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T) →
        Function.Bijective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T) := by
      intro R T _ _ ι _ _ _ _ n hT hc hs
      refine ⟨?_, hs⟩
      rcases subsingleton_or_nontrivial T with hT0 | hT0
      · haveI := Module.subsingleton T
          (TensorProduct (MvPolynomial ι R) T Ω[MvPolynomial ι R⁄R])
        intro x y _
        exact Subsingleton.elim x y
      · haveI := hT
        haveI : Algebra.IsStandardSmooth R T :=
          Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
        haveI : Algebra.FinitePresentation R T := Algebra.IsStandardSmooth.finitePresentation
        haveI : Algebra.FiniteType R T := Algebra.FiniteType.of_finitePresentation
        haveI : Module.Finite T Ω[T⁄R] := KaehlerDifferential.finite R T
        haveI : Module.Free T Ω[T⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
        haveI : StrongRankCondition T := commRing_strongRankCondition T
        have hfr : Module.finrank T Ω[T⁄R] = n := Module.finrank_eq_of_rank_eq
          (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n)
        let bT := Module.finBasisOfFinrankEq T Ω[T⁄R] hfr
        let bS := ((KaehlerDifferential.mvPolynomialBasis R ι).baseChange T).reindex
          (Fintype.equivFinOfCardEq hc)
        let E := bS.equiv bT (Equiv.refl _)
