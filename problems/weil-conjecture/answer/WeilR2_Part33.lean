      · exact LaurentPolynomial.invert.injective.comp Polynomial.toLaurent_injective
      · intro a; simp
      · simp
      · intro f
        obtain ⟨N, p, hp⟩ := LaurentPolynomial.exists_T_pow (LaurentPolynomial.invert f)
        refine ⟨N, p, ?_⟩
