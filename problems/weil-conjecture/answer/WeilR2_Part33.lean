    (K : Type u) [Field K] [Algebra A K] [Algebra A'' K] (L : Type u) [Field L] [Algebra K L]
    (R : Subalgebra A K) (R'' : Subalgebra A'' K) (M : Submonoid K)
    (hMR : ∀ q ∈ M, q ∈ R) (hmul : ∀ r ∈ R'', ∃ q ∈ M, q * r ∈ R), ∀ x : L, IsIntegral ↥R'' x → ∃ q ∈ M, IsIntegral ↥R (algebraMap K L q * x) := by
    intro A A'' _ _ K _ _ _ L _ _ R R'' M hMR hmul
