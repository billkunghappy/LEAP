    have hcomψ := (hmb.eq_of_le (Ideal.comap_isPrime ψ (RingHom.ker χ)).ne_top hle).symm
    have hresid : ∀ x : ↥(Algebra.adjoin A {s, η}), ∃ t, x - ψ t ∈ RingHom.ker χ := by
