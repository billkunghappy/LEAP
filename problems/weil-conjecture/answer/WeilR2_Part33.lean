  have hfP : vL ^ N * rx ∈ PS := PS.mul_mem (PS.pow_mem (hBP _ hvB) N) hrxP
  obtain ⟨K₁, hK₁⟩ := (hPS _).1 hfP

  let MI : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) :=
    { carrier := {z | (z : L) ∈ MS}
      add_mem' := fun {a b} ha hb => by
        show ((a + b : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) : L) ∈ MS
        rw [Subalgebra.coe_add]; exact MS.add_mem ha hb
      zero_mem' := by show ((0 : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) : L) ∈ MS
                      rw [Subalgebra.coe_zero]; exact MS.zero_mem
