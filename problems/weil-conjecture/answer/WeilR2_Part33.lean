  obtain ⟨N', y, hy, hyeq⟩ :=
    span_descent _ _ φ₂ (wcLlsFcVel W A K L t c' b') _ hden _ (hspan hρ)
  have hyJ : y ∈ wcLlsFcJV W A K L t c' b' := by
    unfold wcLlsFcJV
    apply Ideal.le_radical
    refine Ideal.span_mono ?_ hy
    rintro z ⟨w, hw, hz⟩
    exact Or.inl ⟨w, hw, hz⟩
  have hcol : ∀ P ∈ (wcLlsFcJV W A K L t c' b').minimalPrimes,
      g * (g - wcLlsFcVel W A K L t c' b' ^ N) ∈ P := by
    intro P hP
    have hPp : P.IsPrime := hP.1.1
    have hid : (g * (g - wcLlsFcVel W A K L t c' b' ^ N)) ^ ρ * wcLlsFcVel W A K L t c' b' ^ N' =
        wcLlsFcVel W A K L t c' b' ^ (2 * N * ρ) * y := by
      apply hinj
      have hb : φ₂ (g * (g - wcLlsFcVel W A K L t c' b' ^ N)) =
          φ₂ (wcLlsFcVel W A K L t c' b') ^ (2 * N) * (φ₁ e * φ₁ e - φ₁ e) := by
        rw [map_mul, map_sub, map_pow, hg]
        ring
      rw [map_mul, map_pow, hb, map_mul, hyeq]
      simp only [map_pow]
      rw [mul_pow, ← pow_mul]
      ring
    have h1 : (g * (g - wcLlsFcVel W A K L t c' b' ^ N)) ^ ρ *
        wcLlsFcVel W A K L t c' b' ^ N' ∈ P := by
      rw [hid]
