by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0 hs'
  refine ⟨wcpa_dj_llsm_fc_J_ne_top Ω W hW hWt A K L 𝔭 t hPD c' b' hc' hb'm hb'0, ?_⟩
