        algebraMap ↑Γ(X₀, U') ↥(integralClosure ↑Γ(X₀, U') ↑C.functionField) (e.symm a') := by
      apply Subtype.ext
      show algebraMap (wcLlsaA W K (g (MvPolynomial.X 0))
        (wcG2cTau W V (g (MvPolynomial.X 0)) σ₀) a₀) ↑C.functionField a' =
        algebraMap ↑Γ(X₀, U') ↑C.functionField (e.symm a')
      rw [← hcomp, RingEquiv.apply_symm_apply]
    rw [hj]

  have hηhom : ∀ a : Aut C, a.hom (genericPoint C) = genericPoint C := fun a => by
    haveI : IsOpenImmersion a.hom := @IsOpenImmersion.of_isIso _ _ a.hom (Iso.isIso_hom a)
    exact genericPoint_eq_of_isOpenImmersion a.hom
  have hlift_inv : ∀ a : Aut C, wcpaDjLlFixes W γ ι₀ (r₀ ≫ uX) w a →
      wcpaDjLlFixes W γ ι₀ (r₀ ≫ uX) w a⁻¹ := by
    rintro a ⟨ha, fa, h1, h2, h3⟩
    have hih : a.inv ≫ a.hom = 𝟙 C := Iso.inv_hom_id (a : C ≅ C)
    have hhi : a.hom ≫ a.inv = 𝟙 C := Iso.hom_inv_id (a : C ≅ C)
    have hinvγ : a.inv ≫ γ = γ := by
      calc a.inv ≫ γ = a.inv ≫ a.hom ≫ γ := by rw [ha]
        _ = γ := by rw [← Category.assoc, hih, Category.id_comp]
    have H : γ ≫ ι₀ = (a.inv ≫ (γ ≫ ι₀).toNormalization) ≫ (γ ≫ ι₀).fromNormalization := by
      rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, ← Category.assoc, hinvγ]
    obtain ⟨g'', e1, e2⟩ : ∃ g'' : (γ ≫ ι₀).normalization ⟶ (γ ≫ ι₀).normalization,
        (γ ≫ ι₀).toNormalization ≫ g'' = a.inv ≫ (γ ≫ ι₀).toNormalization ∧
        g'' ≫ (γ ≫ ι₀).fromNormalization = (γ ≫ ι₀).fromNormalization :=
      ⟨_, Scheme.Hom.toNormalization_normalizationDesc _ _ _ H,
        Scheme.Hom.normalizationDesc_comp _ _ _ H⟩
    have e3 : fa ≫ g'' = 𝟙 _ := by
      apply Scheme.Hom.normalization.hom_ext (γ ≫ ι₀) _ _ (γ ≫ ι₀).fromNormalization
      · rw [← Category.assoc, h1, Category.assoc, e1, ← Category.assoc, hhi,
          Category.id_comp, Category.comp_id]
      · rw [Category.assoc, e2, h2]
      · rw [Category.id_comp]
    refine ⟨hinvγ, g'', e1, e2, ?_⟩
    calc g'' (wcNdPt W (γ ≫ ι₀) (r₀ ≫ uX) w)
        = g'' (fa (wcNdPt W (γ ≫ ι₀) (r₀ ≫ uX) w)) := by rw [h3]
      _ = (fa ≫ g'') (wcNdPt W (γ ≫ ι₀) (r₀ ≫ uX) w) := (Scheme.Hom.comp_apply _ _ _).symm
      _ = wcNdPt W (γ ≫ ι₀) (r₀ ≫ uX) w := by rw [e3]; rfl
  let H : Subgroup (Aut C) :=
    { carrier := {a | wcpaDjLlFixes W γ ι₀ (r₀ ≫ uX) w a}
      one_mem' := by
        refine ⟨Category.id_comp γ, 𝟙 _, ?_, Category.id_comp _, rfl⟩
        rw [Category.comp_id]
        exact (Category.id_comp _).symm
      mul_mem' := by
        rintro a b ⟨ha, fa, ha1, ha2, ha3⟩ ⟨hb, fb, hb1, hb2, hb3⟩
        refine ⟨?_, fb ≫ fa, ?_, ?_, ?_⟩
        · show (b.hom ≫ a.hom) ≫ γ = γ
          rw [Category.assoc, ha, hb]
        · show _ = (b.hom ≫ a.hom) ≫ _
          rw [← Category.assoc, hb1, Category.assoc, ha1, Category.assoc]
        · rw [Category.assoc, ha2, hb2]
        · rw [Scheme.Hom.comp_apply, hb3, ha3]
      inv_mem' := fun {a} h => hlift_inv a h }
  have hHmem : ∀ a, a ∈ H ↔ wcpaDjLlFixes W γ ι₀ (r₀ ≫ uX) w a := fun a => Iff.rfl
  haveI hHsolv : Group.IsSolvable H := hss H hHmem

  have hint := wcpa_dj_llsmgds_cover_sections Ω W C γ hcov X uX ι hM.2.2 V hch.1 hgen hκ
  obtain ⟨hfix, D, Φ, hD, hΦ⟩ := wcpa_dj_llsmgds_deck_galois_hom Ω C γ X ι V hgen K hκ
  have hdesc := wcpa_dj_llsmgds_deck_fixed_in_base Ω W hW hWt C γ hcov hgal X uX ι hM V hch.1
    hch.2.2.1 hgen K hκ hint hfix
  have hsurj : Function.Surjective Φ := by
    have hrange : Φ.range = ⊤ := by
      have hbot : IntermediateField.fixedField Φ.range = ⊥ := by
        rw [eq_bot_iff]
        intro ℓ hℓ
        rw [IntermediateField.mem_fixedField_iff] at hℓ
        rw [IntermediateField.mem_bot]
        obtain ⟨k, hk⟩ := hdesc ℓ (fun a ha hη => by
          let a' : Aut C := a
          have hih : a.inv ≫ a.hom = 𝟙 C := Iso.inv_hom_id a
          have hmem : a'⁻¹ ∈ D := (hD _).mpr (by
            show a.inv ≫ γ = γ
            calc a.inv ≫ γ = a.inv ≫ a.hom ≫ γ := by rw [ha]
              _ = γ := by rw [← Category.assoc, hih, Category.id_comp])
          have h1 := hℓ (Φ ⟨a'⁻¹, hmem⟩) ⟨_, rfl⟩
          rw [hΦ ⟨a'⁻¹, hmem⟩ hη ℓ] at h1
          exact h1)
        exact ⟨k, hk⟩
      rw [← IntermediateField.fixingSubgroup_fixedField Φ.range, hbot,
        IntermediateField.fixingSubgroup_bot]
    intro σ
    have : σ ∈ Φ.range := hrange ▸ Subgroup.mem_top σ
    exact MonoidHom.mem_range.mp this

  open Pointwise in
  have hle : wcLlsDec (wcLlsaA W K (g (MvPolynomial.X 0))
      (wcG2cTau W V (g (MvPolynomial.X 0)) σ₀) a₀) K ↑C.functionField (ys.comap j) ≤
      (H.subgroupOf D).map Φ := by
    intro σ hσ
    obtain ⟨a, rfl⟩ := hsurj σ
    refine ⟨a, ?_, rfl⟩
    show a ∈ H.subgroupOf D
    rw [Subgroup.mem_subgroupOf]
    have hinv : Φ a⁻¹ ∈ wcLlsDec (wcLlsaA W K (g (MvPolynomial.X 0))
        (wcG2cTau W V (g (MvPolynomial.X 0)) σ₀) a₀) K ↑C.functionField (ys.comap j) := by
      rw [map_inv]; exact inv_mem hσ
    have hY := MulAction.mem_stabilizer_iff.mp hinv
    rw [himg] at hY
    have htr : ∀ m, wcpaDjGslTr a.1.hom (genericPoint C) (genericPoint C) (hηhom a.1) m =
        Φ a⁻¹ m := fun m => (hΦ a⁻¹ (hηhom a.1) m).symm
    refine hfix₀ a.1 ((hD _).mp a.2) (hηhom a.1) (fun ℓ => ?_)
    rw [htr]
    constructor
    · intro hℓ
      have h2 := Set.smul_mem_smul_set (a := Φ a⁻¹) hℓ
      rw [hY, AlgEquiv.smul_def] at h2
      exact h2
    · intro hℓ
      have h2 : Φ a⁻¹ • ℓ ∈ Φ a⁻¹ • (Subtype.val ''
          (ys : Set ↥(integralClosure ↑Γ(X₀, U') ↑C.functionField))) := by
        rw [hY, AlgEquiv.smul_def]; exact hℓ
      exact Set.smul_mem_smul_set_iff.mp h2
  have hDs : Group.IsSolvable (wcLlsDec (wcLlsaA W K (g (MvPolynomial.X 0))
      (wcG2cTau W V (g (MvPolynomial.X 0)) σ₀) a₀) K ↑C.functionField (ys.comap j)) := by
    let fH : ↥(H.subgroupOf D) →* ↥H :=
      { toFun := fun k => ⟨k.1.1, Subgroup.mem_subgroupOf.mp k.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    have hfH : Function.Injective fH := fun a b h => by
      have h' : (fH a : Aut C) = (fH b : Aut C) := congrArg Subtype.val h
      exact Subtype.ext (Subtype.ext h')
    haveI : Group.IsSolvable ↥(H.subgroupOf D) := Group.isSolvable_of_isSolvable_injective hfH
    haveI : Group.IsSolvable ↥((H.subgroupOf D).map Φ) :=
      Group.isSolvable_of_surjective (Φ.subgroupMap_surjective _)
    exact Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hle)
  exact ⟨ys.comap j, hyP, hyc, hDs⟩

theorem wcpa_dj_llsm_annulus_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
