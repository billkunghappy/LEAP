  have hnu : ∀ j, ¬ IsUnit (a1 0 j) := by
    intro j hu0
    apply hirr'.ne_zero
    rw [Ideal.Quotient.eq_zero_iff_mem]
    refine h𝔔P.mem_of_pow_mem (m + 1) ?_
    refine (Ideal.unit_mul_mem_iff_mem _ (hε.mul (hu0.map e))).mp ?_
    have key : ε * e (a1 0 j) * f (wcEbntX W g bb) ^ (m + 1) =
        f (wcEbntX W g aa) * (f (wcEbntX W g bb) * e (a1 1 j)) := by
      have h := congrArg e (hrel1 j)
      rw [map_mul, map_mul] at h
      linear_combination -(e (a1 0 j)) * hvX + h - e (a1 1 j) * hXX
    show ε * e (a1 0 j) * f (wcEbntX W g bb) ^ (m + 1) ∈ _
    rw [key]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _)))

  have hD : ∀ (𝔓 : Ideal P) (_ : 𝔓.IsPrime) [IsDomain (P ⧸ 𝔓)] [IsDiscreteValuationRing (P ⧸ 𝔓)],
      Irreducible (Ideal.Quotient.mk 𝔓 (f (wcEbntX W g aa))) → 𝔓 ≤ Ideal.map e 𝔷' →
      ∃ j, ∀ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime w),
        x ∈ Ideal.span {a1 0 j} ⊔ 𝔷' := by
    intro 𝔓 _ _ _ hirr hle
    have hmE := (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hirr
    haveI : IsLocalHom (Ideal.Quotient.mk 𝔓) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hnm : ∀ x : P, ¬ IsUnit x → Ideal.Quotient.mk 𝔓 x ∈ IsLocalRing.maximalIdeal (P ⧸ 𝔓) :=
      fun x hx => (IsLocalRing.mem_maximalIdeal _).mpr (fun hu => hx (isUnit_of_map_unit _ _ hu))
    have hnue : ∀ a : Localization.AtPrime w, ¬ IsUnit a → ¬ IsUnit (e a) := by
      intro a ha hea
      exact ((he.2.1 a).mp hea) ((IsLocalRing.mem_maximalIdeal _).mpr ha)
    obtain ⟨j, hj⟩ := C3 (P ⧸ 𝔓) (Ideal.Quotient.mk 𝔓 (f (wcEbntX W g aa))) hirr.ne_zero hmE k1
      (fun j => Ideal.Quotient.mk 𝔓 (e (a1 0 j))) (fun j => Ideal.Quotient.mk 𝔓 (y1 j))
      (fun j => hnm _ (hnue _ (hnu j)))
      (by rw [hXa1, map_sum]; exact Finset.sum_congr rfl (fun j _ => map_mul _ _ _))
    refine ⟨j, fun x hx => ?_⟩
    have hex : Ideal.Quotient.mk 𝔓 (e x) ∈ Ideal.span {Ideal.Quotient.mk 𝔓 (e (a1 0 j))} := by
      rw [← hj]
      exact hnm _ (hnue _ ((IsLocalRing.mem_maximalIdeal _).mp hx))
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hex
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective d
    have hdiff : e x - p * e (a1 0 j) ∈ 𝔓 := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hd, sub_self]
    rw [← C2 (Localization.AtPrime w) P e he (Ideal.span {a1 0 j} ⊔ 𝔷'), Ideal.mem_comap]
    have hsplit : e x = p * e (a1 0 j) + (e x - p * e (a1 0 j)) := by ring
    rw [hsplit]
    refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem e
      (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)))) ?_
    exact Ideal.map_mono le_sup_right (hle hdiff)
  obtain ⟨h𝔓P, hdomE, hdvr, hirr, -⟩ := wcNd_nodal_branch_dvr Ω W g hgm P f hfH aa bb hab
  obtain ⟨j, hgen⟩ := hD _ h𝔓P hirr h𝔓le

  rw [h𝔷'] at hgen
  obtain ⟨ζ, z₀, hζw, hVζ, hgen'⟩ := C5 ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) w 𝔷 h𝔷P h𝔷w V0 g0 (a1 0 j) (a1 1 j)
    ((IsLocalRing.mem_maximalIdeal _).mpr (hnu j)) (hrel1 j) hgen
  refine ⟨g, 1, ζ, z₀, hgm, hg0, hζw, ?_, hgen'⟩
  have h1 : ((V0 * ζ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) : L) = ((g0 * z₀ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) : L) := congrArg Subtype.val hVζ
  rw [hV0, hg0'] at h1
  rw [pow_one]
  exact h1

theorem wcpa_dj_llsm_sccas_ctua_chart_shift : ∀ (A : Type u) [CommRing A] [IsDomain A] (K L : Type u)
    [Field K] [Field L] [Algebra A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (s₁ s₂ : K), s₁ * s₂ = 1 → ∀ f : L, IsIntegral (Algebra.adjoin A {s₁}) f →
      ∃ N : ℕ, IsIntegral (Algebra.adjoin A {s₂}) (algebraMap K L s₂ ^ N * f) :=
by
  intro A _ _ K L _ _ _ _ _ _ s₁ s₂ hs f hf
  classical
  have hs2mem : s₂ ∈ Algebra.adjoin A {s₂} := Algebra.subset_adjoin (Set.mem_singleton _)
  have hcoeff : ∀ c ∈ Algebra.adjoin A {s₁}, ∃ D : ℕ, s₂ ^ D * c ∈ Algebra.adjoin A {s₂} := by
    intro c hc
    induction hc using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨1, by rw [pow_one, mul_comm, hs]; exact Subalgebra.one_mem _⟩
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ a⟩
    | add x y _ _ hx hy =>
      obtain ⟨Dx, hx⟩ := hx
      obtain ⟨Dy, hy⟩ := hy
      refine ⟨Dx + Dy, ?_⟩
      have e : s₂ ^ (Dx + Dy) * (x + y) = s₂ ^ Dy * (s₂ ^ Dx * x) + s₂ ^ Dx * (s₂ ^ Dy * y) := by
        ring
      rw [e]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hs2mem _) hx)
        (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hs2mem _) hy)
    | mul x y _ _ hx hy =>
      obtain ⟨Dx, hx⟩ := hx
      obtain ⟨Dy, hy⟩ := hy
      refine ⟨Dx + Dy, ?_⟩
      have e : s₂ ^ (Dx + Dy) * (x * y) = (s₂ ^ Dx * x) * (s₂ ^ Dy * y) := by ring
      rw [e]
      exact Subalgebra.mul_mem _ hx hy
  have hmono : ∀ c : K, ∀ D e : ℕ, s₂ ^ D * c ∈ Algebra.adjoin A {s₂} → D ≤ e →
      s₂ ^ e * c ∈ Algebra.adjoin A {s₂} := by
    intro c D e h hle
    have e' : s₂ ^ e * c = s₂ ^ (e - D) * (s₂ ^ D * c) := by
      rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
    rw [e']
    exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hs2mem _) h
  obtain ⟨p, hpm, hpf⟩ := hf
  choose Dfun hD using fun i => hcoeff _ (p.coeff i).2
  set n := p.natDegree with hn
  set D := ∑ i ∈ Finset.range n, Dfun i with hDdef
  set u := s₂ ^ D with hu
  set pK : Polynomial K := p.map ((Algebra.adjoin A {s₁}).val : Algebra.adjoin A {s₁} →+* K)
    with hpK
  have hpKm : pK.Monic := hpm.map _
  have hpKdeg : pK.natDegree = n := hpm.natDegree_map _
  set q := pK.scaleRoots u with hq
  have hqm : q.Monic := by rw [hq, Polynomial.monic_scaleRoots_iff]; exact hpKm
  have hqlift : q ∈ Polynomial.lifts
      ((Algebra.adjoin A {s₂}).val : Algebra.adjoin A {s₂} →+* K) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    have hmem : q.coeff i ∈ Algebra.adjoin A {s₂} := by
      rw [hq, Polynomial.coeff_scaleRoots, hpKdeg, hpK, Polynomial.coeff_map]
      change (p.coeff i : K) * u ^ (n - i) ∈ Algebra.adjoin A {s₂}
      rcases lt_trichotomy i n with h | h | h
      · rw [mul_comm, hu, ← pow_mul]
        apply hmono _ (Dfun i) _ (hD i)
        have h1 : Dfun i ≤ D :=
          Finset.single_le_sum (fun j _ => Nat.zero_le (Dfun j)) (Finset.mem_range.mpr h)
        have h2 : 0 < n - i := by omega
        exact h1.trans (Nat.le_mul_of_pos_right _ h2)
      · rw [h, hn, hpm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
        exact Subalgebra.one_mem _
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h]
        simp
    exact ⟨⟨_, hmem⟩, rfl⟩
  obtain ⟨Q, hQmap, hQdeg, hQm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hqlift hqm
  refine ⟨D, Q, hQm, ?_⟩
  rw [← map_pow, Subalgebra.algebraMap_eq, ← Polynomial.eval₂_map, hQmap, hq,
    Polynomial.scaleRoots_eval₂_mul, hpK, Polynomial.eval₂_map, ← Subalgebra.algebraMap_eq, hpf,
    mul_zero]

theorem wcpa_dj_llsm_sccas_ctua_radical : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] (t : A) (c' b' : ↥W) (z q : L),
    (∃ k : ℕ, algebraMap K L (wcLlsScV W A K t c' b') ^ k * z ∈
      integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) →
    (∃ k : ℕ, algebraMap K L (wcLlsScV W A K t c' b') ^ k * q ∈
      integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) →
    ∀ (n : ℕ) (μ : ↥W), 1 ≤ n → μ ∈ IsLocalRing.maximalIdeal ↥W →
    z ^ n = algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) * q →
    ∃ (β : ↥W) (z' : L), β ∈ IsLocalRing.maximalIdeal ↥W ∧
      (∃ k : ℕ, algebraMap K L (wcLlsScV W A K t c' b') ^ k * z' ∈
        integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) ∧
      z = algebraMap K L (algebraMap A K (algebraMap ↥W A β)) * z' :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ L _ _ _ _ t c' b' z q _hz hq n μ hn hμ hzq
  have hVint : IsIntegral (Algebra.adjoin A {wcLlsScV W A K t c' b'})
      (algebraMap K L (wcLlsScV W A K t c' b')) :=
    isIntegral_algebraMap (R := Algebra.adjoin A {wcLlsScV W A K t c' b'}) (A := L)
      (x := (⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
        Algebra.adjoin A {wcLlsScV W A K t c' b'}))
  by_cases hz0 : z = 0
  · refine ⟨0, 0, Ideal.zero_mem _, ⟨0, by simp⟩, by simp [hz0]⟩
  have hιμ : algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) ≠ 0 := by
    intro h
    rw [h, zero_mul] at hzq
    exact hz0 ((pow_eq_zero_iff (by omega)).mp hzq)
  obtain ⟨β₀, hβ₀⟩ := IsAlgClosed.exists_pow_nat_eq (μ : Ω) (by omega : 0 < n)
  have hμnu : ¬ IsUnit μ := (IsLocalRing.mem_maximalIdeal _).mp hμ
  have hβW : β₀ ∈ W := by
    by_contra hnot
    have hne : β₀ ≠ 0 := fun h => hnot (h ▸ W.zero_mem)
    have hinv : β₀⁻¹ ∈ W := (W.mem_or_inv_mem β₀).resolve_left hnot
    apply hμnu
    refine isUnit_iff_exists_inv.mpr ⟨(⟨β₀⁻¹, hinv⟩ : ↥W) ^ n, ?_⟩
    apply Subtype.ext
    show (μ : Ω) * (β₀⁻¹) ^ n = 1
    rw [← hβ₀, inv_pow, mul_inv_cancel₀ (pow_ne_zero _ hne)]
  have hbn : (⟨β₀, hβW⟩ : ↥W) ^ n = μ := Subtype.ext (by
    show β₀ ^ n = (μ : Ω)
    exact hβ₀)
  have hbm : (⟨β₀, hβW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact hμnu (hbn ▸ hu.pow n)
  generalize hb : (⟨β₀, hβW⟩ : ↥W) = b at hbn hbm
  have hιb : algebraMap K L (algebraMap A K (algebraMap ↥W A b)) ^ n =
      algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) := by
    simp only [← map_pow, hbn]
  have hιb0 : algebraMap K L (algebraMap A K (algebraMap ↥W A b)) ≠ 0 := by
    intro h
    rw [h, zero_pow (by omega)] at hιb
    exact hιμ hιb.symm
  generalize hιbdef : algebraMap K L (algebraMap A K (algebraMap ↥W A b)) = ιb at hιb hιb0
  generalize algebraMap K L (algebraMap A K (algebraMap ↥W A μ)) = ιμ at hιb hιμ hzq
  refine ⟨b, z * ιb⁻¹, hbm, ?_, ?_⟩
  · obtain ⟨k, hk⟩ := hq
    rw [mem_integralClosure_iff] at hk
    refine ⟨k, ?_⟩
    have hz'n : (z * ιb⁻¹) ^ n = q := by
      rw [mul_pow, inv_pow, hιb, hzq]
      field_simp
    rw [mem_integralClosure_iff]
    apply IsIntegral.of_pow (by omega : 0 < n)
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    have hrw : (algebraMap K L (wcLlsScV W A K t c' b') ^ k * (z * ιb⁻¹)) ^ (n' + 1) =
        (algebraMap K L (wcLlsScV W A K t c' b')) ^ (k * n') *
          (algebraMap K L (wcLlsScV W A K t c' b') ^ k * q) := by
      rw [mul_pow, hz'n, ← pow_mul]
      ring
    rw [hrw]
    exact IsIntegral.mul (hVint.pow _) hk
  · rw [hιbdef]
    field_simp

