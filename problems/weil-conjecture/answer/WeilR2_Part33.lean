      intro f hf
      obtain ⟨N, p, hp⟩ := hT f
      induction N generalizing p with
      | zero => exact ⟨p, by rw [hp, pow_zero, mul_one]⟩
      | succ N ih =>
        obtain ⟨q, hqm, hq⟩ := hf
        set d := q.natDegree with hd
