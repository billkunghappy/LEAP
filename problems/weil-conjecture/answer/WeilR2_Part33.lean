      rw [RingHom.mem_ker, map_sub, hψw, hχA, ← ha, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact hw
    have hH := etaleHens (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C b}) ↥(Algebra.adjoin A {s, η})
      (Localization.AtPrime N) P ψ _ (RingHom.ker χ) hψet hcomψ hresid e he
    refine ⟨e.comp (j.comp ψ), ?_, ?_, ?_⟩
    · unfold wcEbntPres
