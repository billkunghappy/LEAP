  have hG' : wcNdModelA W P (jZ.comp (eZ.comp ((algebraMap ↥(wcLlsASbS W A K u (a' * q'))
      (Localization.AtPrime (wcLlsASbN W A K u (a' * q')))).comp
      ((algebraMap A ↥(wcLlsASbS W A K u (a' * q'))).comp (algebraMap ↥W A))))) ∨
