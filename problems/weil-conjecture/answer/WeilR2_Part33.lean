  have hjx : ∀ x : ↥(wcLlsASbS W A K u (a' * q')),
      jZ (eZ (algebraMap _ (Localization.AtPrime (wcLlsASbN W A K u (a' * q'))) x)) =
        k (algebraMap ↥(wcIsicgC1 W A K L u (a' * q')) (Localization.AtPrime Q)
          (algebraMap _ ↥(wcIsicgC1 W A K L u (a' * q')) x)) := by
    intro x
