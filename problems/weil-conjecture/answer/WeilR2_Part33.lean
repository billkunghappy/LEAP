      have hτQ : ι τ ∉ Q := fun h => hτ (by rw [← hΛc]; exact hQle h)
      have h1 : P.comap ψ0 ≤ Q.comap ι := by
        refine hmin.2 ⟨(by haveI := hQp; infer_instance), Ideal.map_le_iff_le_comap.mp hIQ⟩ ?_
        rw [← hΛc]; exact Ideal.comap_mono hQle
