theorem wcpa_dj_llsm_flsc_fs_noetherian : ∀ (W B : Type u) [CommRing W] [IsLocalRing W] [CommRing B] [Algebra W B] [Algebra.FiniteType W B] (Q : Ideal B) [Q.IsPrime], IsNoetherianRing (Localization.AtPrime Q ⧸ (Ideal.map (algebraMap W B) (IsLocalRing.maximalIdeal W)).map (algebraMap B (Localization.AtPrime Q))) :=
by
  intro W B _ _ _ _ _ Q _
  set m := IsLocalRing.maximalIdeal W with hm
  set I : Ideal B := Ideal.map (algebraMap W B) m with hI
  set J : Ideal (Localization.AtPrime Q) := I.map (algebraMap B (Localization.AtPrime Q)) with hJ
  haveI hmax : m.IsMaximal := IsLocalRing.maximalIdeal.isMaximal W
  letI : Field (W ⧸ m) := Ideal.Quotient.field m
  haveI : IsNoetherianRing (W ⧸ m) := inferInstance
  haveI hft1 : Algebra.FiniteType W (B ⧸ I) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ W I) (Ideal.Quotient.mkₐ_surjective W I)
  haveI hft2 : Algebra.FiniteType (W ⧸ m) (B ⧸ I) :=
    Algebra.FiniteType.of_restrictScalars_finiteType W (W ⧸ m) (B ⧸ I)
  haveI hBI : IsNoetherianRing (B ⧸ I) := Algebra.FiniteType.isNoetherianRing (W ⧸ m) (B ⧸ I)
  haveI hloc : IsLocalization (Submonoid.map (Ideal.Quotient.mk I) Q.primeCompl)
      (Localization.AtPrime Q ⧸ J) := by
    refine IsLocalization.of_surjective Q.primeCompl (Localization.AtPrime Q)
      (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective ?_ ?_
    · ext x
      simp only [RingHom.comp_apply]
      exact (Ideal.Quotient.algebraMap_quotient_map_quotient x).symm
    · rw [Ideal.mk_ker, Ideal.mk_ker]
  exact IsLocalization.isNoetherianRing (Submonoid.map (Ideal.Quotient.mk I) Q.primeCompl)
    (Localization.AtPrime Q ⧸ J) hBI

theorem wcpa_dj_llsm_fl_smooth_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' r : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W → r ≠ 0 →
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
          wcLlsScN W A K t c' r →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L (wcLlsScN W A K t c' r) Q →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) Q) = 0 →
        ∃ g z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L), g ∉ Q ∧ z ∈ Q ∧
          ∃ φ : Polynomial ↥W →+* Localization.Away g,
            φ.comp Polynomial.C =
              (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
                (Localization.Away g)).comp (wcFlSig W A K L t c' r) ∧
            φ Polynomial.X =
              algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
                (Localization.Away g) z ∧
            φ.Etale :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' r hc' hr hr0 Q _ hQc hQU hδ
  classical

  have key : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra R L] (σR : ↥W →+* R)
      (wL : ↥W →+* L), Function.Injective wL →
      (∀ w : ↥W, ((algebraMap R ↥(integralClosure R L) (σR w) : ↥(integralClosure R L)) : L) =
        wL w) →
      Function.Injective (algebraMap R ↥(integralClosure R L)) →
      ((algebraMap R ↥(integralClosure R L)).comp σR).FiniteType →
      ∀ (N : Ideal R) [N.IsPrime] (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime],
      Q.comap (algebraMap R ↥(integralClosure R L)) = N → wcLlsUniq R L N Q →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, (algebraMap R ↥(integralClosure R L)).comp σR w ∈ Q) →
      (∀ b : ↥(integralClosure R L), ∃ w : ↥W,
        b - (algebraMap R ↥(integralClosure R L)).comp σR w ∈ Q) →
      IsIntegrallyClosed (Localization.AtPrime N) →
      (∃ _ : IsDomain (Localization.AtPrime N ⧸ ((IsLocalRing.maximalIdeal ↥W).map σR).map
          (algebraMap R (Localization.AtPrime N))),
        IsDiscreteValuationRing (Localization.AtPrime N ⧸ ((IsLocalRing.maximalIdeal ↥W).map σR).map
          (algebraMap R (Localization.AtPrime N)))) →
      wcpaDjLkDelta (wcLlsFS W wL R Q) = 0 →
      ∃ g z : ↥(integralClosure R L), g ∉ Q ∧ z ∈ Q ∧
        ∃ φ : Polynomial ↥W →+* Localization.Away g,
          φ.comp Polynomial.C = (algebraMap ↥(integralClosure R L) (Localization.Away g)).comp
            ((algebraMap R ↥(integralClosure R L)).comp σR) ∧
          φ Polynomial.X = algebraMap ↥(integralClosure R L) (Localization.Away g) z ∧ φ.Etale := by
    intro R _ _ _ σR wL hwL hσL hfinj hft N _ Q _ hQc hQU hσm hres hNic hNdvr hδ
    have hσinj : Function.Injective ((algebraMap R ↥(integralClosure R L)).comp σR) := by
      intro w w' h
      apply hwL
      rw [← hσL, ← hσL]
      exact congrArg (fun z : ↥(integralClosure R L) => (z : L)) h

    haveI hQmax : Q.IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨fun h => (inferInstance : Q.IsPrime).ne_top ((Ideal.eq_top_iff_one Q).mpr h), ?_⟩
      intro J x hQJ hx hxJ
      obtain ⟨w, hw⟩ := hres x
      have hwm : w ∉ IsLocalRing.maximalIdeal ↥W := by
        intro hm
        apply hx
        have := Ideal.add_mem _ hw (hσm w hm)
        rwa [sub_add_cancel] at this
      have hu : IsUnit w := by
        by_contra h
        exact hwm ((IsLocalRing.mem_maximalIdeal _).2 (mem_nonunits_iff.2 h))
      have hσJ : (algebraMap R ↥(integralClosure R L)).comp σR w ∈ J := by
        have := J.sub_mem hxJ (hQJ hw)
        rwa [sub_sub_cancel] at this
      exact (Ideal.eq_top_iff_one J).mp (Ideal.eq_top_of_isUnit_mem J hσJ (hu.map _))

    letI : Algebra ↥W ↥(integralClosure R L) :=
      ((algebraMap R ↥(integralClosure R L)).comp σR).toAlgebra
    haveI hFT : Algebra.FiniteType ↥W ↥(integralClosure R L) :=
      RingHom.finiteType_algebraMap.mp hft
    haveI hflat : Module.Flat ↥W ↥(integralClosure R L) := by
      rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
      intro x hx
      rw [Submodule.mem_torsion_iff] at hx
      obtain ⟨⟨a, ha⟩, hax⟩ := hx
      rw [Submodule.mem_bot]
      have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
      have h1 : (algebraMap R ↥(integralClosure R L)).comp σR a * x = 0 := hax
      rcases mul_eq_zero.mp h1 with h | h
      · exact absurd (hσinj (h.trans (map_zero _).symm)) ha0
      · exact h
    haveI hfp : Algebra.FinitePresentation ↥W ↥(integralClosure R L) :=
      wcpa_dj_lr1u_mnc_nagata_fp ↥W _ hFT hflat
    have hcomapW : Q.comap (algebraMap ↥W ↥(integralClosure R L)) =
        IsLocalRing.maximalIdeal ↥W := by
      symm
      apply (IsLocalRing.maximalIdeal.isMaximal ↥W).eq_of_le (Ideal.comap_isPrime _ Q).ne_top
      intro w hw
      exact hσm w hw
    have hIQ : Ideal.map (algebraMap ↥W ↥(integralClosure R L)) (IsLocalRing.maximalIdeal ↥W) ≤ Q :=
      Ideal.map_le_iff_le_comap.mpr (fun w hw => hσm w hw)

    have hI : Ideal.span {b : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w} =
        Ideal.map (algebraMap ↥W ↥(integralClosure R L)) (IsLocalRing.maximalIdeal ↥W) := by
      show _ = Ideal.span (⇑((algebraMap R ↥(integralClosure R L)).comp σR) ''
        ↑(IsLocalRing.maximalIdeal ↥W))
      congr 1
      ext b
      constructor
      · rintro ⟨w, hw, hb⟩
