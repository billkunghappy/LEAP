  let ι := wcIcxIncl L (Algebra.adjoin A {wcLlsScS W A K t c' r})
    (Algebra.adjoin A {wcLlsScS W A K t c' (r * q')}) hle

  have hnf : ∀ y : K, ∀ hy : y ∈ Algebra.adjoin A {wcLlsScS W A K t c' r},
      ∃ (a : A) (z : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})),
