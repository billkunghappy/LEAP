      have hΛq' : Λ (P.comap ψ0) ≤ q' := hle _ hvΛ (by rw [hΛc]; exact hPq)
      obtain ⟨hjp, hjc⟩ := c1a _ hΛp (G1 _ hmin.1.2) hΛq'
      refine ⟨hPp, hmin, hτ, hΛp, hΛc, hvΛ, hjp, hjc, ⟨hΛp, G1 _ hmin.1.2⟩, ?_⟩
      intro Q hQ hQle
