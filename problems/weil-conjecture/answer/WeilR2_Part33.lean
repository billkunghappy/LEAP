    exact h𝔴'w ((h𝔴'P.mem_or_mem hmem).resolve_left (fun h0 => hV𝔴 (h𝔴'P.mem_of_pow_mem k h0)))
  have hwne : (1 : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) ∉ w :=
