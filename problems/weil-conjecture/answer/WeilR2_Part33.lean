by
  intro Ω _ W B _ _ K _ _ L _ _ t c a b hba _ hcomp


  have G : ∀ (T₁ T₂ : Subalgebra B K), T₁ = T₂ → ∀ (z₁ σ₁ : ↥T₁) (z₂ σ₂ : ↥T₂)
      (f₁ : ↥W →+* ↥T₁) (f₂ : ↥W →+* ↥T₂) (wL₁ wL₂ : ↥W →+* L),
      (z₁ : K) = (z₂ : K) → (σ₁ : K) = (σ₂ : K) → (∀ w, (f₁ w : K) = (f₂ w : K)) →
      wL₁ = wL₂ →
      ((∀ (𝔮 : Ideal ↥(integralClosure ↥T₁ L)) [𝔮.IsPrime],
          𝔮.comap (algebraMap ↥T₁ ↥(integralClosure ↥T₁ L)) =
            Ideal.span {z₁, σ₁} ⊔ Ideal.map f₁ (IsLocalRing.maximalIdeal ↥W) →
