    · intro Q hQ hτQ
      obtain ⟨hQp, hQmin⟩ := (c1c Q).mp hQ
      have hQq' : Q.comap ψ1 ≤ q' := (c1b Q hQp).2
      have hιτ : ι τ ∉ Q.comap ψ1 := hτQ
