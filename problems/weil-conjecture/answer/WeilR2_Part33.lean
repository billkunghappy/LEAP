  refine ⟨((IsLocalRing.maximalIdeal ↥W).map
      (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔
      Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X b))}).comap
      (e.comp (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (Localization.AtPrime w))), Ideal.IsPrime.comap _, ?_, ?_, ?_⟩
  · intro x hx
    by_contra hxw
    have hxu : IsUnit (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (Localization.AtPrime w) x) := IsLocalization.map_units (Localization.AtPrime w)
        (⟨x, hxw⟩ : w.primeCompl)
    exact h𝔅p.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (hxu.map e))
  · intro μ hμ
    rw [Ideal.mem_comap]
    have h1 := RingHom.congr_fun hfσ μ
    rw [RingHom.comp_apply] at h1 ⊢
    erw [← h1]
    exact Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hμ)
  · rw [Ideal.mem_comap, RingHom.comp_apply, hva]
    intro h
    rcases h𝔅p.mem_or_mem h with h1 | h1
    · exact h𝔅p.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 hε)
    · exact hXa (h𝔅p.mem_of_pow_mem n h1)

theorem wcpa_dj_llsm_sccas_ctua_exc_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → wcLlsScDF W A K L t c' b' →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w →
        wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 1 →
        ∀ 𝔷 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
          𝔷.IsPrime → 𝔷 ≤ w →
          (∀ x ∈ IsLocalRing.maximalIdeal ↥W,
            algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A x)) ∈ 𝔷) →
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔷 →
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∉ 𝔷 →
          ∀ z : L, (∃ k : ℕ, algebraMap K L (wcLlsScV W A K t c' b') ^ k * z ∈
              integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) →
            ∃ s n : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
              (s ∉ w ∨ n ∉ w) ∧ ∃ (β : ↥W) (z' : L), β ∈ IsLocalRing.maximalIdeal ↥W ∧
                (∃ k : ℕ, algebraMap K L (wcLlsScV W A K t c' b') ^ k * z' ∈
                  integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) ∧
                (s : L) * z - (n : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A β)) * z' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb' hb0 hs hDF
    w _ hwc hwU hbr 𝔷 h𝔷P h𝔷w h𝔷m h𝔷V h𝔷τ z hz
  classical

  have hiso : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (P : Type u) [CommRing P] (e : R →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal R) P e →
      ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (h : P →+* R') (h' : R' →+* P),
        Module.Flat R R' ∧ IsLocalRing R' ∧ IsLocalHom (algebraMap R R') ∧
        (∀ r, h (e r) = algebraMap R R' r) ∧ (∀ r, h' (algebraMap R R' r) = e r) ∧
        ∀ x, h' (h x) = x := by
    intro R _ _ P _ e he
    obtain ⟨R', _, _, hR', hflat, -⟩ := wcNd_hi_hens_exists_flat R
    haveI := he.1
    haveI := hR'.1
    obtain ⟨h, ⟨hh, hhl⟩, -⟩ := he.2.2 R' hR'.1 (algebraMap R R') hR'.2.1
    obtain ⟨h', ⟨hh', hh'l⟩, -⟩ := hR'.2.2 P he.1 e he.2.1
    have hid : h'.comp h = RingHom.id P := by
      haveI := hhl
      haveI := hh'l
      exact (he.2.2 P he.1 e he.2.1).unique
        ⟨by rw [RingHom.comp_assoc, hh, hh'], inferInstance⟩ ⟨RingHom.id_comp e, inferInstance⟩
    have hloc : IsLocalHom (algebraMap R R') := by
      refine ⟨fun a ha => ?_⟩
      by_contra hc
      exact ((hR'.2.1 a).mp ha) ((IsLocalRing.mem_maximalIdeal _).mpr hc)
    refine ⟨R', inferInstance, inferInstance, h, h', hflat, inferInstance, hloc,
      fun r => by rw [← hh]; rfl, fun r => by rw [← hh']; rfl,
      fun x => by rw [← RingHom.comp_apply, hid, RingHom.id_apply]⟩
  have C2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (P : Type u) [CommRing P] (e : R →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal R) P e → ∀ I : Ideal R,
      Ideal.comap e (Ideal.map e I) = I := by
    intro R _ _ P _ e he I
    obtain ⟨R', _, _, h, h', hflat, _, _, hh, hh', hinv⟩ := hiso R P e he
    haveI : Module.FaithfullyFlat R R' := Module.FaithfullyFlat.of_flat_of_isLocalHom
    refine le_antisymm (fun x hx => ?_) Ideal.le_comap_map
    rw [Ideal.mem_comap] at hx
    have h1 : h (e x) ∈ Ideal.map (h.comp e) I := by
      rw [← Ideal.map_map]; exact Ideal.mem_map_of_mem h hx
    have h2 : (h.comp e) = algebraMap R R' := RingHom.ext hh
    rw [h2, hh] at h1
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := R') I]
    exact h1
  have C4 : ∀ (B : Type u) [CommRing B] [IsDomain B] (w : Ideal B) [w.IsPrime] (a b c : B)
      (r y : Localization.AtPrime w),
      algebraMap B (Localization.AtPrime w) c =
        r * algebraMap B (Localization.AtPrime w) a + algebraMap B (Localization.AtPrime w) b * y →
      ∃ s n y₀ : B, s ∉ w ∧ s * c = n * a + b * y₀ := by
    intro B _ _ w _ a b c r y h
    obtain ⟨⟨r₀, s₁⟩, rfl⟩ := IsLocalization.mk'_surjective w.primeCompl r
    obtain ⟨⟨y₀, s₂⟩, rfl⟩ := IsLocalization.mk'_surjective w.primeCompl y
    simp only at h
    have hinj := IsLocalization.injective (Localization.AtPrime w)
      (Ideal.primeCompl_le_nonZeroDivisors w)
    have hs1 := IsLocalization.mk'_spec (Localization.AtPrime w) r₀ s₁
    have hs2 := IsLocalization.mk'_spec (Localization.AtPrime w) y₀ s₂
    refine ⟨(s₁ : B) * s₂, s₂ * r₀, s₁ * y₀, ?_, ?_⟩
    · intro hmem
      rcases (inferInstance : w.IsPrime).mem_or_mem hmem with h1 | h1
      · exact s₁.2 h1
      · exact s₂.2 h1
    · apply hinj
      simp only [map_mul, map_add]
      rw [h, ← hs1, ← hs2]
      ring
  have MS1 : ∀ (R : Type u) [CommRing R] (σ : ↥W →+* R) (x : R),
      x ∈ (IsLocalRing.maximalIdeal ↥W).map σ →
      ∃ β : ↥W, β ∈ IsLocalRing.maximalIdeal ↥W ∧ ∃ y : R, x = σ β * y := by
    intro R _ σ x hx
    have hx' : x ∈ Submodule.span R (σ '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := hx
    clear hx
    induction hx' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨μ, hμ, rfl⟩ := hx
      exact ⟨μ, hμ, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, zero_mem _, 0, by rw [mul_zero]⟩
    | add x₁ x₂ _ _ hx₁ hx₂ =>
      obtain ⟨β₁, hβ₁, y₁, rfl⟩ := hx₁
      obtain ⟨β₂, hβ₂, y₂, rfl⟩ := hx₂
      obtain ⟨c, hc | hc⟩ := ValuationRing.cond β₁ β₂
      · exact ⟨β₁, hβ₁, y₁ + σ c * y₂, by rw [← hc, map_mul]; ring⟩
      · exact ⟨β₂, hβ₂, σ c * y₁ + y₂, by rw [← hc, map_mul]; ring⟩
    | smul a x _ hx =>
      obtain ⟨β, hβ, y, rfl⟩ := hx
      exact ⟨β, hβ, a * y, by rw [smul_eq_mul]; ring⟩
  have hdichG : ∀ (R : Type u) [CommRing R] (Q : Ideal R) [IsDomain (R ⧸ Q)]
      [IsDiscreteValuationRing (R ⧸ Q)] (y₁ y₂ : R),
      ∃ p : R, y₁ - p * y₂ ∈ Q ∨ y₂ - p * y₁ ∈ Q := by
    intro R _ Q _ _ y₁ y₂
    rcases ValuationRing.dvd_total (Ideal.Quotient.mk Q y₂) (Ideal.Quotient.mk Q y₁) with
      ⟨d, hd⟩ | ⟨d, hd⟩
    · obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective d
      refine ⟨p, Or.inl ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hd]
      ring
    · obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective d
      refine ⟨p, Or.inr ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hd]
      ring
  have hkillG : ∀ (R : Type u) [CommRing R] (I : Ideal R) (xa xb q : R),
      xa * xb ∈ I → q ∈ I ⊔ Ideal.span {xa} → xb * q ∈ I := by
    intro R _ I xa xb q hx hq
    rw [sup_comm, Ideal.mem_span_singleton_sup] at hq
    obtain ⟨a, i, hi, rfl⟩ := hq
    have e1 : xb * (a * xa + i) = a * (xa * xb) + xb * i := by ring
    rw [e1]
    exact I.add_mem (I.mul_mem_left _ hx) (I.mul_mem_left _ hi)

  have core : ∀ (B : Type u) [CommRing B] [IsDomain B] (w : Ideal B) [w.IsPrime]
      (P : Type u) [CommRing P] (e : Localization.AtPrime w →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime w)) P e →
      ∀ (σB : ↥W →+* B) (V0 : B) (xb ε : P) (m : ℕ),
      e (algebraMap B (Localization.AtPrime w) V0) = ε * xb ^ (m + 1) →
      (∀ y₁ y₂ : P, ∃ p : P,
        xb * (y₁ - p * y₂) ∈ (IsLocalRing.maximalIdeal ↥W).map
          (e.comp ((algebraMap B (Localization.AtPrime w)).comp σB)) ∨
        xb * (y₂ - p * y₁) ∈ (IsLocalRing.maximalIdeal ↥W).map
          (e.comp ((algebraMap B (Localization.AtPrime w)).comp σB))) →
      ∀ a c : B, ∃ (s n y₀ : B) (β : ↥W), β ∈ IsLocalRing.maximalIdeal ↥W ∧ s ∉ w ∧
        (s * (V0 * c) = n * (V0 * a) + σB β * y₀ ∨ s * (V0 * a) = n * (V0 * c) + σB β * y₀) := by
    intro B _ _ w _ P _ e he σB V0 xb ε m hvX hdich a c
    have hmapI : (IsLocalRing.maximalIdeal ↥W).map
        (e.comp ((algebraMap B (Localization.AtPrime w)).comp σB)) =
        Ideal.map e ((IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap B (Localization.AtPrime w)).comp σB)) := (Ideal.map_map _ _).symm
    have key : ∀ a' c' : B, (∃ p : P, xb * (e (algebraMap B (Localization.AtPrime w) c') -
        p * e (algebraMap B (Localization.AtPrime w) a')) ∈ (IsLocalRing.maximalIdeal ↥W).map
          (e.comp ((algebraMap B (Localization.AtPrime w)).comp σB))) →
        ∃ (s n y₀ : B) (β : ↥W), β ∈ IsLocalRing.maximalIdeal ↥W ∧ s ∉ w ∧
          s * (V0 * c') = n * (V0 * a') + σB β * y₀ := by
      rintro a' c' ⟨p, hp⟩
      rw [hmapI] at hp
      have h1 : algebraMap B (Localization.AtPrime w) (V0 * c') ∈
          Ideal.span {algebraMap B (Localization.AtPrime w) (V0 * a')} ⊔
            (IsLocalRing.maximalIdeal ↥W).map ((algebraMap B (Localization.AtPrime w)).comp σB) := by
        rw [← C2 (Localization.AtPrime w) P e he (Ideal.span {algebraMap B (Localization.AtPrime w)
          (V0 * a')} ⊔ (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap B (Localization.AtPrime w)).comp σB)), Ideal.mem_comap]
        have hsplit : e (algebraMap B (Localization.AtPrime w) (V0 * c')) =
            p * e (algebraMap B (Localization.AtPrime w) (V0 * a')) +
              (ε * xb ^ m) * (xb * (e (algebraMap B (Localization.AtPrime w) c') -
                p * e (algebraMap B (Localization.AtPrime w) a'))) := by
          have h2 : e (algebraMap B (Localization.AtPrime w) (V0 * c')) =
              e (algebraMap B (Localization.AtPrime w) V0) *
                e (algebraMap B (Localization.AtPrime w) c') := by simp only [map_mul]
          have h3 : e (algebraMap B (Localization.AtPrime w) (V0 * a')) =
              e (algebraMap B (Localization.AtPrime w) V0) *
                e (algebraMap B (Localization.AtPrime w) a') := by simp only [map_mul]
          rw [h2, h3, hvX]
          ring
        rw [hsplit]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem e
          (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))))
          (Ideal.mul_mem_left _ _ (Ideal.map_mono le_sup_right hp))
      obtain ⟨r, i, hi, hri⟩ := Ideal.mem_span_singleton_sup.mp h1
      obtain ⟨β, hβ, yy, rfl⟩ := MS1 (Localization.AtPrime w)
        ((algebraMap B (Localization.AtPrime w)).comp σB) i hi
      obtain ⟨s, n, y₀, hs, heq⟩ := C4 B w (V0 * a') (σB β) (V0 * c') r yy hri.symm
      exact ⟨s, n, y₀, β, hβ, hs, heq⟩
    obtain ⟨p, h | h⟩ := hdich (e (algebraMap B (Localization.AtPrime w) c))
      (e (algebraMap B (Localization.AtPrime w) a))
    · obtain ⟨s, n, y₀, β, hβ, hs, heq⟩ := key a c ⟨p, h⟩
      exact ⟨s, n, y₀, β, hβ, hs, Or.inl heq⟩
    · obtain ⟨s, n, y₀, β, hβ, hs, heq⟩ := key c a ⟨p, h⟩
      exact ⟨s, n, y₀, β, hβ, hs, Or.inr heq⟩

  have hb'A : algebraMap ↥W A b' ≠ 0 := by
    haveI := hPD.2.1
    intro h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    exact hb0 ((smul_eq_zero.mp h0).resolve_right one_ne_zero)
  have hb'K : algebraMap A K (algebraMap ↥W A b') ≠ 0 := fun h0 =>
    hb'A (IsFractionRing.injective A K (by rw [h0, map_zero]))
  have hτK : algebraMap A K (t - algebraMap ↥W A c') ≠ 0 := by
    intro h0
    apply h𝔷τ
    have h1 : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        (t - algebraMap ↥W A c') = 0 := Subtype.ext h0
    rw [h1, map_zero]
    exact 𝔷.zero_mem
  have hVL : algebraMap K L (wcLlsScV W A K t c' b') ≠ 0 :=
    (map_ne_zero _).mpr (by unfold wcLlsScV; exact div_ne_zero hb'K hτK)
  obtain ⟨k₀, hk₀⟩ := hz
  have hp : algebraMap K L (wcLlsScV W A K t c' b') ^ (k₀ + 1) ≠ 0 := pow_ne_zero _ hVL

  obtain ⟨P, _, e, he⟩ := wcNd_hens_exists (Localization.AtPrime w)
    (IsLocalRing.maximalIdeal (Localization.AtPrime w))
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  haveI := he.1
  have hbad := @hs w (by assumption) hwc
  have hmodel := wcpa_dj_llsm_sd_good_model Ω W hW hWt A K L 𝔭 (.disc t) hPD
    (t - algebraMap ↥W A c') b' hb' hb0 (Or.inl ⟨t, c', rfl, hc', rfl⟩)
    (wcLlsScV W A K t c' b') rfl w hwc hbad P e he
  obtain ⟨hu, hv, huv, hbranch⟩ := wcpa_dj_llsm_scrs_branch_condition Ω W hW hWt A K L 𝔭 t hPD
    c' b' hc' hb' hb0 (wcLlsScV W A K t c' b') rfl w hwc P e he
  obtain ⟨g, f, ⟨hgm, hg0, hfC, hfH⟩, n, ε, ω, hn, hε, hω, hgn, hcase⟩ :=
    wcpa_dj_llsm_scrs_node_monomial Ω W hW hWt P _ hmodel _ _ b' hb' hb0 hu hv huv hbranch
  have h01 : f (wcEbntX W g 0) * f (wcEbntX W g 1) =
      e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w) (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A g)))) := by
    rw [← map_mul]
    have h1 : wcEbntX W g 0 * wcEbntX W g 1 = (Ideal.Quotient.mk (Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.C g) : wcEbntN W g) := by
      show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
      rw [← map_mul]
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
    rw [h1]
    exact RingHom.congr_fun hfC g
  obtain ⟨aa, bb, hab, hvX, -, hXX⟩ : ∃ aa bb : Fin 2, aa ≠ bb ∧
      e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w)
          (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩)) =
        ε * f (wcEbntX W g bb) ^ n ∧
      e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w)
          (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A ω)))) *
        e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w)
          (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c')))) * ε =
        f (wcEbntX W g aa) ^ n ∧
      f (wcEbntX W g aa) * f (wcEbntX W g bb) =
        e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (Localization.AtPrime w) (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A g)))) := by
    rcases hcase with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨1, 0, by decide, h1, h2, by rw [mul_comm]; exact h01⟩
