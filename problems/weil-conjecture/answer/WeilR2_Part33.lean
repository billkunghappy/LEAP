  have hAU : ∀ c : ↥(integralClosure A L),
      (c : L) ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L :=
    fun c => IsIntegral.tower_top c.2
  have hAV : ∀ c : ↥(integralClosure A L),
      (c : L) ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L :=
    fun c => IsIntegral.tower_top c.2

  have hNadd : ∀ x x' : L,
      (∃ p q : L, p ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L ∧
        q ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L ∧ x = p + q) →
      (∃ p q : L, p ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L ∧
        q ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L ∧ x' = p + q) →
      (∃ p q : L, p ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L ∧
        q ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L ∧ x + x' = p + q) := by
    rintro x x' ⟨p, q, hp, hq, rfl⟩ ⟨p', q', hp', hq', rfl⟩
    exact ⟨p + p', q + q', add_mem hp hp', add_mem hq hq', by ring⟩
  have hNmul : ∀ (c : ↥(integralClosure A L)) (x : L),
      (∃ p q : L, p ∈ integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L ∧
