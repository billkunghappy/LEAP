theorem wcpa_dj_llsm_fl_fibre_over_Q : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' r b' q' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → b' = r * q' → b' ≠ 0 →
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
          wcLlsScN W A K t c' r →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L (wcLlsScN W A K t c' r) Q →
        ∀ d : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L), d ∉ Q →
        ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
          (x : L) = (d : L) →
          ∃ h : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
            x * h - 1 ∈ wcLlsScJ W A K L t c' b' :=
by
  classical
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' r b' q' hc' hr hr0 hq' hb' hb'0
    Q _ hQc hQU d hdQ x hxd
  subst hb'
  obtain ⟨_, hNZ, _, h𝔭max, _, hdisc⟩ := hPD
  obtain ⟨_, h𝔭eq, _⟩ := hdisc
  haveI := hNZ

  have hinjWA : ∀ w : ↥W, algebraMap ↥W A w = 0 → w = 0 := by
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hinjK : ∀ w : ↥W, w ≠ 0 → algebraMap A K (algebraMap ↥W A w) ≠ 0 := by
    intro w hw h
    apply hw
    apply hinjWA
    exact (IsFractionRing.injective A K) (h.trans (map_zero _).symm)
  have hq'0 : q' ≠ 0 := by
    rintro rfl
    exact hb'0 (mul_zero r)
  have hrK := hinjK r hr0
  have hqK := hinjK q' hq'0

  have hS1 : algebraMap A K t = algebraMap A K (algebraMap ↥W A c') +
      algebraMap A K (algebraMap ↥W A r) * wcLlsScS W A K t c' r := by
    unfold wcLlsScS
    rw [map_sub]
    field_simp
    ring
  have hS2 : wcLlsScS W A K t c' r =
      algebraMap A K (algebraMap ↥W A q') * wcLlsScS W A K t c' (r * q') := by
    unfold wcLlsScS
    rw [map_mul, map_mul]
    field_simp

  have hle : Algebra.adjoin A {wcLlsScS W A K t c' r} ≤
      Algebra.adjoin A {wcLlsScS W A K t c' (r * q')} := by
    apply Algebra.adjoin_le
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    rw [hS2]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
