    intro x y h
    have h1 : algebraMap K L (x : K) = algebraMap K L (y : K) :=
      congrArg (fun z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L) =>
        (z : L)) h
    exact Subtype.ext ((algebraMap K L).injective h1)

  haveI hPDft : Algebra.FiniteType ↥W A := hPD.1
  haveI hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 (.disc t) hPD
    (wcLlsScS W A K t c' r)
  have hft : (wcFlSig W A K L t c' r).FiniteType := by
    refine RingHom.FiniteType.comp ?_ (RingHom.FiniteType.comp ?_ ?_)
    · exact RingHom.Finite.finiteType (RingHom.finite_algebraMap.mpr hfin)
    · exact RingHom.finiteType_algebraMap.mpr
        (Algebra.FiniteType.adjoin_of_finite (Set.finite_singleton _))
