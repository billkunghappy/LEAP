    haveI := hsm
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1 (R := W) (S := A)
    haveI : Module.Free A Ω[A⁄W] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hrank : Module.rank A Ω[A⁄W] = 1 := by
      rw [Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential 1]; simp
    have hfr : Module.finrank A Ω[A⁄W] = 1 := Module.finrank_eq_of_rank_eq (by rw [hrank]; simp)
    have hV : Module.finrank κ (TensorProduct A κ Ω[A⁄W]) = 1 := by
      rw [Module.finrank_baseChange, hfr]
    haveI : FiniteDimensional κ (TensorProduct A κ Ω[A⁄W]) :=
      Module.finite_of_finrank_pos (by rw [hV]; norm_num)
    set M : Submodule A Ω[A⁄W] := Submodule.span A (Set.range (fun β : B => D (j β))) with hM
    have hMtop : M = ⊤ := by
      have hjb : ∀ n : ℕ, D (j b ^ n) ∈ M := by
        intro n
        induction n with
        | zero => simp
        | succ n ih =>
          rw [pow_succ, Derivation.leibniz]
          exact M.add_mem (M.smul_mem _ (Submodule.subset_span ⟨b, rfl⟩)) (M.smul_mem _ ih)
      have hall : ∀ a : A, D a ∈ M := by
        intro a
        obtain ⟨⟨β, ⟨_, n, rfl⟩⟩, hβ⟩ := IsLocalization.surj (Submonoid.powers b) a
        simp only at hβ
        have hu : IsUnit (j (b ^ n)) :=
          IsLocalization.map_units A (⟨b ^ n, n, rfl⟩ : Submonoid.powers b)
        obtain ⟨v, hv⟩ := hu.exists_left_inv
        have h1 : D (a * j (b ^ n)) ∈ M := by rw [hβ]; exact Submodule.subset_span ⟨β, rfl⟩
        rw [Derivation.leibniz] at h1
        have h2 : j (b ^ n) • D a ∈ M := by
          have h3 : a • D (j (b ^ n)) ∈ M := M.smul_mem _ (by rw [map_pow]; exact hjb n)
          have := M.sub_mem h1 h3
          simpa using this
        have h4 := M.smul_mem v h2
