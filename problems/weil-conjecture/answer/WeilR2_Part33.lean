        have h0 : (p.eval 0) ^ d = 0 := by
          have := congrArg (Polynomial.eval 0) key'
          rw [Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_finset_sum,
            Polynomial.eval_zero] at this
          rwa [Finset.sum_eq_zero (fun i hi => ?_), add_zero] at this
          have hi' := Finset.mem_range.mp hi
          rw [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X,
            zero_pow (mul_ne_zero (Nat.succ_ne_zero N) (by omega)), mul_zero]
