          · rw [SetLike.not_le_iff_exists] at hJ
            obtain ⟨a, haJ, haq⟩ := hJ
            obtain ⟨x₁, x₂, hx⟩ := Ideal.mem_span_pair.mp (Ideal.mem_comap.mp haJ)
