          refine ⟨p, hpm, ?_⟩
          have h2 : p.eval₂ ι z ∈ ((Λ (P.comap ψ0)).map ψ1).comap ψ1 := by
            rw [hjc]; exact (Ideal.span_singleton_le_iff_mem _).mpr hvΛ hp
