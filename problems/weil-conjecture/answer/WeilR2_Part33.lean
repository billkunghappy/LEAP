          · exact (pow_eq_zero_iff (by omega)).mp h0
        obtain ⟨p₁, hp₁⟩ : Polynomial.X ∣ p :=
          Polynomial.X_dvd_iff.mpr (by rw [Polynomial.coeff_zero_eq_eval_zero]; exact hp0)
