    ((inferInstance : N.IsMaximal).eq_of_le (Ideal.comap_isPrime ι (RingHom.ker χ)).ne_top
      hNle).symm

  have hhN : algebraMap A ↥(Algebra.adjoin A {s}) h ∉ N := by
    rw [← hcomap, Ideal.mem_comap, RingHom.mem_ker, hιA, hχA]
    intro h0
    exact hh𝔭 (Ideal.Quotient.eq_zero_iff_mem.mp h0)

  have hunitH : IsUnit (ι (algebraMap A ↥(Algebra.adjoin A {s}) h)) := by
    rw [hιA]
    exact isUnit_iff_exists_inv.mpr ⟨⟨η, hηE⟩, Subtype.ext (by
      show algebraMap A K h * η = 1
      rw [mul_comm]
      exact hηh)⟩
  have hsurjE : ∀ x : ↥(Algebra.adjoin A {s, η}), ∃ (n : ℕ) (r : ↥(Algebra.adjoin A {s})),
      ι r = x * ι (algebraMap A ↥(Algebra.adjoin A {s}) h) ^ n := by
    intro x
    obtain ⟨n, hn⟩ := hs3 s (x : K) x.2
    refine ⟨n, ⟨_, hn⟩, Subtype.ext ?_⟩
    rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
    rfl
  obtain ⟨j, hjι, hjloc⟩ := away ↥(Algebra.adjoin A {s}) ↥(Algebra.adjoin A {s, η}) ι
    (algebraMap A ↥(Algebra.adjoin A {s}) h) N (RingHom.ker χ) hιinj hunitH hsurjE hcomap hhN
  refine ⟨inferInstance, ?_, ?_⟩

  · obtain ⟨hRbD, hRbIC⟩ := wcNd_nodal_poly_normal Ω W b hb0
    haveI := hRbD
    haveI := hRbIC
    letI : Algebra (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C b}) ↥(Algebra.adjoin A {s, η}) := ψ.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C b}) ↥(Algebra.adjoin A {s, η}) := hψet
    obtain ⟨-, hICq⟩ := wc_pks_etale_localization_normal (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
      ↥(Algebra.adjoin A {s, η}) (RingHom.ker χ)
    haveI := hICq
    letI : Algebra ↥(Algebra.adjoin A {s, η}) (Localization.AtPrime N) := j.toAlgebra
    haveI : IsLocalization (RingHom.ker χ).primeCompl (Localization.AtPrime N) := hjloc
    exact IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv (RingHom.ker χ).primeCompl
