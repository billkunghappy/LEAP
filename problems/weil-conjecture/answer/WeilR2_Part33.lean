  letI : Algebra ↥W B := ((algebraMap A B).comp (algebraMap ↥W A)).toAlgebra
  haveI : IsScalarTower ↥W A B := IsScalarTower.of_algebraMap_eq' rfl

  let ε : Localization.Away h ≃ₐ[A] B :=
    IsLocalization.algEquiv (Submonoid.powers h) (Localization.Away h) B
  let φ : Polynomial ↥W →+* B := ε.toRingEquiv.toRingHom.comp f
  have hφet : RingHom.Etale φ := RingHom.Etale.respectsIso.1 f ε.toRingEquiv hfet
  have hφC : φ.comp Polynomial.C = algebraMap ↥W B := by
    refine RingHom.ext fun w => ?_
    show ε (f (Polynomial.C w)) = algebraMap A B (algebraMap ↥W A w)
    rw [← RingHom.comp_apply f Polynomial.C, hfC, RingHom.comp_apply, AlgEquiv.commutes]
  have hφX : φ Polynomial.X = algebraMap A B t := by
    show ε (f Polynomial.X) = _
    rw [hfX, AlgEquiv.commutes]
  let e₀ := MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)
  let g : MvPolynomial (Fin 1) ↥W →+* B := φ.comp e₀.toRingEquiv.toRingHom
  have hgEt : g.Etale := RingHom.Etale.respectsIso.2 φ e₀.toRingEquiv hφet
  have hgC : g.comp MvPolynomial.C = algebraMap ↥W B := by
    refine RingHom.ext fun w => ?_
    show φ (MvPolynomial.eval₂ Polynomial.C (fun _ => Polynomial.X) (MvPolynomial.C w)) = _
