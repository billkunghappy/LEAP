  obtain ⟨hNic, hNdom, hNdvr⟩ :=
    wcpa_dj_llsm_flsc_base_local Ω W hW hWt A K L 𝔭 t hPD c' r hc' hr hr0
  exact key ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
    ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})).comp (algebraMap ↥W A))
    ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) hwL hσL hfinj hft
    (wcLlsScN W A K t c' r) Q hQc hQU hσm hres hNic ⟨hNdom, hNdvr⟩ hδ

theorem wcpa_dj_llsm_kptf_hens_descent : ∀ (A : Type u) [CommRing A] (𝔭 : Ideal A), 𝔭.IsPrime →
    ∃ (Q : Type u) (_ : CommRing Q) (φ : A →+* Q), wcNdIsHens 𝔭 Q φ ∧
      ∀ p q : A, φ p ∈ Ideal.span {φ q} → ∃ a s : A, s ∉ 𝔭 ∧ p * s = q * a :=
by
  intro A _ 𝔭 h𝔭
  haveI : 𝔭.IsPrime := h𝔭
  obtain ⟨R, iR, iAlg, hH, hflat, -⟩ := wcNd_hi_hens_exists_flat (Localization.AtPrime 𝔭)
  obtain ⟨hHens, hUnits, hUP⟩ := hH
  haveI : IsLocalRing R := hHens.toIsLocalRing
  haveI hlocρ : IsLocalHom (algebraMap (Localization.AtPrime 𝔭) R) :=
    ⟨fun x hx => IsLocalRing.notMem_maximalIdeal.mp ((hUnits x).mp hx)⟩
  have hLunit : ∀ a : A, IsUnit (algebraMap A (Localization.AtPrime 𝔭) a) ↔ a ∉ 𝔭 := fun a =>
    IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭 a
  refine ⟨R, iR, (algebraMap (Localization.AtPrime 𝔭) R).comp
    (algebraMap A (Localization.AtPrime 𝔭)), ⟨hHens, ?_, ?_⟩, ?_⟩
  ·
    intro a
    rw [RingHom.comp_apply]
    exact (hUnits _).trans (IsLocalRing.notMem_maximalIdeal.trans (hLunit a))
  ·
    intro B _ hB g hg
    have hgM : ∀ y : 𝔭.primeCompl, IsUnit (g y) := fun y => (hg y).mpr y.2
    obtain ⟨g', hg'⟩ : ∃ g' : Localization.AtPrime 𝔭 →+* B,
        g'.comp (algebraMap A (Localization.AtPrime 𝔭)) = g :=
      ⟨IsLocalization.lift hgM, IsLocalization.lift_comp hgM⟩
    have hg'a : ∀ a : A, g' (algebraMap A (Localization.AtPrime 𝔭) a) = g a := fun a =>
      RingHom.congr_fun hg' a
    have hg'u : ∀ x : Localization.AtPrime 𝔭,
        IsUnit (g' x) ↔ x ∉ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
      intro x
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl x
      have e1 := IsLocalization.mk'_spec (Localization.AtPrime 𝔭) a s
      have e2 : g' (IsLocalization.mk' (Localization.AtPrime 𝔭) a s) * g s = g a := by
        rw [← hg'a, ← hg'a, ← map_mul, e1]
      have i1 : IsUnit (g' (IsLocalization.mk' (Localization.AtPrime 𝔭) a s)) ↔ IsUnit (g a) := by
        rw [← e2, IsUnit.mul_iff]
        exact (and_iff_left (hgM s)).symm
      have i2 : IsUnit (algebraMap A (Localization.AtPrime 𝔭) a) ↔
          IsUnit (IsLocalization.mk' (Localization.AtPrime 𝔭) a s) := by
        rw [← e1, IsUnit.mul_iff]
        exact and_iff_left (IsLocalization.map_units (Localization.AtPrime 𝔭) s)
      exact i1.trans ((hg a).trans ((hLunit a).symm.trans
        (i2.trans IsLocalRing.notMem_maximalIdeal.symm)))
    obtain ⟨h, ⟨hh, hhloc⟩, huniq⟩ := hUP B hB g' hg'u
    refine ⟨h, ⟨?_, hhloc⟩, ?_⟩
    · rw [← RingHom.comp_assoc, hh, hg']
    · rintro h' ⟨hh', hh'loc⟩
      apply huniq h'
      refine ⟨?_, hh'loc⟩
      apply IsLocalization.ringHom_ext 𝔭.primeCompl
      rw [RingHom.comp_assoc, hh', hg']
  ·
    intro p q hpq
    haveI : Module.FaithfullyFlat (Localization.AtPrime 𝔭) R :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hmem : algebraMap A (Localization.AtPrime 𝔭) p ∈
        Ideal.span {algebraMap A (Localization.AtPrime 𝔭) q} := by
      have h1 := Ideal.comap_map_eq_self_of_faithfullyFlat (B := R)
        (Ideal.span {algebraMap A (Localization.AtPrime 𝔭) q})
      rw [← h1, Ideal.mem_comap, Ideal.map_span, Set.image_singleton]
      exact hpq
    obtain ⟨x, hx⟩ := Ideal.mem_span_singleton'.mp hmem
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl x
    have e1 := IsLocalization.mk'_spec (Localization.AtPrime 𝔭) a s
    have e2 : algebraMap A (Localization.AtPrime 𝔭) (p * s) =
        algebraMap A (Localization.AtPrime 𝔭) (q * a) := by
      rw [map_mul, map_mul, ← hx, ← e1]
      ring
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists 𝔭.primeCompl (Localization.AtPrime 𝔭)).mp e2
    refine ⟨c * a, c * s, ?_, ?_⟩
    · intro hm
      rcases h𝔭.mem_or_mem hm with h | h
      · exact c.2 h
      · exact s.2 h
    · linear_combination hc

theorem wcpa_dj_llsm_flw_hens_etale_transfer : ∀ (R B H : Type u) [CommRing R] [CommRing B] [CommRing H] (𝔪 : Ideal R) (Q : Ideal B), Q.IsPrime → ∀ g : B, g ∉ Q → ∀ φ : R →+* Localization.Away g, φ.Etale → (∀ p : R, φ p ∈ Q.map (algebraMap B (Localization.Away g)) ↔ p ∈ 𝔪) → (∀ x : Localization.Away g, ∃ p : R, φ p - x ∈ Q.map (algebraMap B (Localization.Away g))) → ∀ e : B →+* H, wcNdIsHens Q H e → ∀ e' : Localization.Away g →+* H, e'.comp (algebraMap B (Localization.Away g)) = e → wcNdIsHens 𝔪 H (e'.comp φ) :=
by

  have s3 : ∀ (P E C : Type u) [CommRing P] [CommRing E] [CommRing C] [HenselianLocalRing C]
      (χ : P →+* E) (γ : P →+* C) (ϱ : E →+* IsLocalRing.ResidueField C), χ.Etale →
      ϱ.comp χ = (IsLocalRing.residue C).comp γ →
      ∃ τ : E →+* C, τ.comp χ = γ ∧ ∀ x, IsLocalRing.residue C (τ x) = ϱ x := by
    intro P E C _ _ _ _ χ γ ϱ hχ hσ
    letI : Algebra P E := χ.toAlgebra
    letI : Algebra P C := γ.toAlgebra
    haveI : Algebra.Etale P E := hχ
    obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base P C
      (fun E'' _ _ _ σ'' => wc_hnas_smooth_section_henselian C E'' σ'') E ϱ hσ
    exact ⟨τ, RingHom.ext fun t => τ.commutes t, hτ⟩

  have s4 : ∀ (P E C : Type u) [CommRing P] [CommRing E] [CommRing C] [IsLocalRing C]
      (χ : P →+* E) (τ τ' : E →+* C), χ.Etale → τ.comp χ = τ'.comp χ →
      (∀ x, IsLocalRing.residue C (τ x) = IsLocalRing.residue C (τ' x)) → τ = τ' := by
    intro P E C _ _ _ _ χ τ τ' hχ hcomp hres
    letI : Algebra P E := χ.toAlgebra
    letI : Algebra P C := (τ.comp χ).toAlgebra
    haveI : Algebra.Etale P E := hχ
    let t1 : E →ₐ[P] C := ⟨τ, fun r => rfl⟩
    let t2 : E →ₐ[P] C := ⟨τ', fun r => (RingHom.congr_fun hcomp r).symm⟩
    have := wc_hnas_hs_etale_hom_unique_residue P E C t1 t2 hres
    exact RingHom.ext fun x => congrArg (fun f : E →ₐ[P] C => f x) this
  intro R B H _ _ _ 𝔪 Q hQ g hg φ hφet hJ hres e he e' he'
  obtain ⟨hH1, hEu, hEuniq⟩ := he
  set Q' : Ideal (Localization.Away g) := Q.map (algebraMap B (Localization.Away g)) with hQ'def

  have hdisj : Disjoint (↑(Submonoid.powers g) : Set B) ↑Q := by
    rw [Set.disjoint_left]
    intro x hx1 hx
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).1 hx1
    exact hg (hQ.mem_of_pow_mem n hx)
  have hQEc : Q'.comap (algebraMap B (Localization.Away g)) = Q :=
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers g) _ hQ hdisj
  have hαQ : ∀ b : B, algebraMap B (Localization.Away g) b ∈ Q' ↔ b ∈ Q := by
    intro b
    constructor
    · intro h; rw [← hQEc]; exact Ideal.mem_comap.2 h
    · intro h; exact Ideal.mem_map_of_mem _ h
  have he'a : ∀ b : B, e' (algebraMap B (Localization.Away g) b) = e b :=
    fun b => RingHom.congr_fun he' b

  have hA : ∀ x : Localization.Away g, IsUnit (e' x) ↔ x ∉ Q' := by
    intro x
    obtain ⟨n, a, hxa⟩ := IsLocalization.Away.surj g x
    have hgn : IsUnit (algebraMap B (Localization.Away g) g ^ n) :=
      (IsLocalization.Away.algebraMap_isUnit g).pow n
    have hegn : IsUnit (e g ^ n) := ((hEu g).2 hg).pow n
    have h1 : IsUnit (e' x) ↔ IsUnit (e a) := by
      have k : e' x * e g ^ n = e a := by
        rw [← he'a g, ← he'a a, ← map_pow, ← map_mul, hxa]
      rw [← k, IsUnit.mul_iff]
      exact ⟨fun h => ⟨h, hegn⟩, fun h => h.1⟩
    have h2 : x ∈ Q' ↔ a ∈ Q := by
      rw [← Ideal.mul_unit_mem_iff_mem _ hgn, hxa, hαQ]
    rw [h1, hEu, h2]
  unfold wcNdIsHens
  refine ⟨hH1, fun p => ?_, ?_⟩
  · rw [RingHom.comp_apply, hA, hJ]
  intro C _ hC γ hγ
  haveI := hC
  have hL : ∀ p : R, φ p ∈ Q' → IsLocalRing.residue C (γ p) = 0 := by
    intro p hp
    rw [IsLocalRing.residue_eq_zero_iff]
    exact (IsLocalRing.mem_maximalIdeal _).mpr
      (mem_nonunits_iff.mpr fun hu => (hγ p).mp hu ((hJ p).mp hp))

  let ψ : R →+* Localization.Away g ⧸ Q' := (Ideal.Quotient.mk Q').comp φ
  have hψ : Function.Surjective ψ := by
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨p, hp⟩ := hres x
    exact ⟨p, Ideal.Quotient.eq.mpr hp⟩
  let ρ : R →+* IsLocalRing.ResidueField C := (IsLocalRing.residue C).comp γ
  have hρ : ∀ p ∈ RingHom.ker ψ, ρ p = 0 := by
    intro p hp
    exact hL p (Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hp))
  let E := RingHom.quotientKerEquivOfSurjective hψ
  let ρb : R ⧸ RingHom.ker ψ →+* IsLocalRing.ResidueField C :=
    Ideal.Quotient.lift (RingHom.ker ψ) ρ hρ
  let ϱ : Localization.Away g →+* IsLocalRing.ResidueField C :=
    ρb.comp (E.symm.toRingHom.comp (Ideal.Quotient.mk Q'))
  have hϱφ : ∀ p : R, ϱ (φ p) = IsLocalRing.residue C (γ p) := by
    intro p
    have h1 : E.symm (Ideal.Quotient.mk Q' (φ p)) = Ideal.Quotient.mk _ p := by
      rw [RingEquiv.symm_apply_eq]
      exact (RingHom.quotientKerEquivOfSurjective_apply_mk hψ p).symm
    show ρb (E.symm (Ideal.Quotient.mk Q' (φ p))) = _
    rw [h1]
    exact Ideal.Quotient.lift_mk _ _ _
  have hϱ : ∀ (x : Localization.Away g) (p : R), φ p - x ∈ Q' →
      ϱ x = IsLocalRing.residue C (γ p) := by
    intro x p hp
    have k : Ideal.Quotient.mk Q' x = Ideal.Quotient.mk Q' (φ p) :=
      (Ideal.Quotient.eq.mpr hp).symm
    rw [← hϱφ]
    show ρb (E.symm (Ideal.Quotient.mk Q' x)) = ρb (E.symm (Ideal.Quotient.mk Q' (φ p)))
    rw [k]
  have hσ : ϱ.comp φ = (IsLocalRing.residue C).comp γ := RingHom.ext fun p => hϱφ p

  obtain ⟨β', hβ'φ, hβ'⟩ := @s3 R (Localization.Away g) C inferInstance inferInstance
    inferInstance hC φ γ ϱ hφet hσ
  have hβ'u : ∀ x, IsUnit (β' x) ↔ x ∉ Q' := by
    intro x
    obtain ⟨p, hp⟩ := hres x
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hβ', hϱ x p hp,
      IsLocalRing.residue_ne_zero_iff_isUnit, hγ, ← hJ]
    constructor
    · intro h hx
      apply h
      have k := Ideal.add_mem _ hp hx
      rwa [sub_add_cancel] at k
    · intro h hx
      apply h
      have k := Ideal.sub_mem _ hx hp
      rwa [sub_sub_cancel] at k
  obtain ⟨β, hβdef⟩ : ∃ β : B →+* C, β = β'.comp (algebraMap B (Localization.Away g)) :=
    ⟨_, rfl⟩
  have hβu : ∀ b, IsUnit (β b) ↔ b ∉ Q := by
    intro b
    rw [hβdef, RingHom.comp_apply, hβ'u, hαQ]
  obtain ⟨h, ⟨hhe, hhloc⟩, hhuniq⟩ := hEuniq C hC β hβu
  have hhe' : h.comp e' = β' := by
    apply IsLocalization.ringHom_ext (Submonoid.powers g)
    rw [RingHom.comp_assoc, he', hhe, hβdef]
