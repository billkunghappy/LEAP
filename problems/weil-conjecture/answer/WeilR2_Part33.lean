      ∃ (τ : Polynomial κ →+* LaurentPolynomial κ) (tt : LaurentPolynomial κ) (kk : ℕ),
        Function.Injective τ ∧ (∀ a, τ (Polynomial.C a) = LaurentPolynomial.C a) ∧
        τ Polynomial.X = tt ∧ tt ≠ 0 ∧ (∀ f, ∃ (N : ℕ) (p : Polynomial κ), τ p = f * tt ^ N) ∧
