        have key : τ (p ^ d + ∑ i ∈ Finset.range d,
            α i * p ^ i * Polynomial.X ^ ((N + 1) * (d - i))) = 0 := by
          rw [map_add, map_pow, map_sum, hp]
          have e : ∀ i ∈ Finset.range d, τ (α i * p ^ i * Polynomial.X ^ ((N + 1) * (d - i))) =
