      refine ⟨h, ⟨RingHom.ext fun b => ?_, hh2⟩, ?_⟩
      · have := RingHom.congr_fun hh1 (φ.symm b)
        simpa using this
      · rintro h' ⟨h1', h2'⟩
        apply huniq
        refine ⟨RingHom.ext fun t => ?_, h2'⟩
        have := RingHom.congr_fun h1' (φ t)
        simpa using this

  have hle : (IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W) ≤
      Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C := le_sup_right
  have hQ := wcNd_hens_quotient _ _ _ P fA hH hle
  let Φ : (Polynomial ↥W ⧸ (IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W))
      ≃+* Polynomial (IsLocalRing.ResidueField ↥W) :=
    (Ideal.polynomialQuotientEquivQuotientPolynomial (IsLocalRing.maximalIdeal ↥W)).symm
  have hΦc : Φ.toRingHom.comp (Ideal.Quotient.mk
      ((IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W))) =
      Polynomial.mapRingHom (IsLocalRing.residue ↥W) := by
    refine RingHom.ext fun g => ?_
    exact Ideal.polynomialQuotientEquivQuotientPolynomial_symm_mk _ g
  have hΦI : Ideal.map Φ ((Ideal.span {Polynomial.X} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)).map
        (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)))) =
      Ideal.span {Polynomial.X} := by
    have e1 : Ideal.map Φ ((Ideal.span {Polynomial.X} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)).map
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)))) =
        Ideal.map Φ.toRingHom ((Ideal.span {Polynomial.X} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)).map
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)))) := rfl
    rw [e1, Ideal.map_map, hΦc, Ideal.map_sup, Ideal.map_span, Set.image_singleton,
      Polynomial.coe_mapRingHom, Polynomial.map_X, Ideal.map_map]
    have e2 : Ideal.map ((Polynomial.mapRingHom (IsLocalRing.residue ↥W)).comp Polynomial.C)
        (IsLocalRing.maximalIdeal ↥W) = ⊥ := by
      rw [Ideal.map_eq_bot_iff_le_ker]
      intro c hc
      rw [RingHom.mem_ker, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
        (IsLocalRing.residue_eq_zero_iff c).mpr hc, Polynomial.C_0]
    rw [e2, sup_bot_eq]
  have hS := s2 _ _ _ Φ _ _ hQ
  rw [hΦI] at hS
  obtain ⟨hdom, hdvr, hirr⟩ := wcNd_line_hens_dvr (IsLocalRing.ResidueField ↥W) _ _ hS
  have hΦX : Φ.symm.toRingHom Polynomial.X = Ideal.Quotient.mk
      ((IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)) Polynomial.X := by
    have e := Ideal.polynomialQuotientEquivQuotientPolynomial_map_mk
      (IsLocalRing.maximalIdeal ↥W) Polynomial.X
    rw [Polynomial.map_X] at e
    exact e
  have hϖ : ((Ideal.quotientMap (((IsLocalRing.maximalIdeal ↥W).map
      (Polynomial.C : ↥W →+* Polynomial ↥W)).map fA) fA Ideal.le_comap_map).comp
        Φ.symm.toRingHom) Polynomial.X =
      Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map
        (Polynomial.C : ↥W →+* Polynomial ↥W)).map fA) (fA Polynomial.X) := by
    rw [RingHom.comp_apply, hΦX, Ideal.quotientMap_mk]
  rw [hϖ] at hirr

  obtain ⟨hJp, hxJ, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hdim hWt Q σQ b' f hpres

  rw [← Ideal.map_map]
  have hle2 : ((IsLocalRing.maximalIdeal ↥W).map (Polynomial.C : ↥W →+* Polynomial ↥W)).map fA ≤
      Ideal.comap h (Ideal.span {f (wcEbntX W b' 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σQ) := by
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_map, Ideal.map_map, RingHom.comp_assoc, hhC]
    exact le_sup_right
  haveI := hdom
  haveI := hdvr
  haveI : IsDomain (Q ⧸ (Ideal.span {f (wcEbntX W b' 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σQ)) :=
    (Ideal.Quotient.isDomain_iff_prime _).mpr hJp
  by_contra hFI
  have hz : Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map
      (Polynomial.C : ↥W →+* Polynomial ↥W)).map fA) F ≠ 0 :=
    fun h0 => hFI (Ideal.Quotient.eq_zero_iff_mem.mp h0)
  obtain ⟨k, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hz hirr
  have h1 : Ideal.quotientMap (Ideal.span {f (wcEbntX W b' 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σQ)
