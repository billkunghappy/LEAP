        rw [this, hf0, smul_zero]
      | add x y hx hy => rw [hx, hy, add_zero]
    haveI : Subsingleton (TensorProduct A κ Ω[A⁄W]) := ⟨fun x y => by rw [hall0 x, hall0 y]⟩
    rw [Module.finrank_zero_of_subsingleton] at hV
