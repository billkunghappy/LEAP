      have hPp : ((Q.comap ψ1).comap ι).IsPrime := inferInstance
      have hIP : I ≤ (Q.comap ψ1).comap ι := Ideal.map_le_iff_le_comap.mp hQmin.1.2
      have hτP : τ ∉ (Q.comap ψ1).comap ι := hιτ
      have hPq : (Q.comap ψ1).comap ι ≤ q := by rw [hq]; exact Ideal.comap_mono hQq'
      have hΛQ : Λ ((Q.comap ψ1).comap ι) = Q.comap ψ1 := hΛcomap _ hQmin.1.1 hιτ
      have hPmin : (Q.comap ψ1).comap ι ∈ I.minimalPrimes := by
        refine ⟨⟨hPp, hIP⟩, ?_⟩
        intro P' hP' hP'le
        obtain ⟨hP'p, hIP'⟩ := hP'
        have hτP' : τ ∉ P' := fun h => hτP (hP'le h)
        obtain ⟨hΛ'p, hΛ'c⟩ := hΛprime P' hP'p hτP'
