          algebraMap ↥(Algebra.adjoin κ {yb}) (LaurentPolynomial κ) ⟨_, hu⟩ * τ g ^ k := by
        show _ = (LaurentPolynomial.C c⁻¹ * yb) * _
        rw [hut, ← mul_pow, ← hτX, ← map_mul, ← hg, hp]
      rw [← hxk] at hQ'eval
