        rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.symm_apply_apply]; exact hx)
    have hmem : ∀ b : B, b ∈ Ideal.map φ p ↔ φ.symm b ∈ p := by
      intro b
      constructor
      · intro hb; exact Ideal.mem_comap.mp (hle hb)
      · intro hb
