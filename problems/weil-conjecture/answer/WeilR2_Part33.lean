    intro S T _ _ ι hι τ τT hτT v hch q _ q' _ hq I I' hI' hIq havoid hv hle hint
    subst hI' hτT
    obtain ⟨Λ, hΛmem, hΛprime, hΛcomap⟩ := wcpa_dj_llsm_obism_lift S T ι hι τ hch
    have hIq' : I.map ι ≤ q' := by
      rw [Ideal.map_le_iff_le_comap, ← hq]; exact hIq
    set ψ0 := (Ideal.Quotient.mk (I.map (algebraMap S (Localization.AtPrime q)))).comp
      (algebraMap S (Localization.AtPrime q)) with hψ0
    set ψ1 := (Ideal.Quotient.mk ((I.map ι).map (algebraMap T (Localization.AtPrime q')))).comp
      (algebraMap T (Localization.AtPrime q')) with hψ1
    obtain ⟨c0a, c0b, c0c⟩ := wcpa_dj_llsm_obism_fs_corr S q I hIq ψ0 hψ0
    obtain ⟨c1a, c1b, c1c⟩ := wcpa_dj_llsm_obism_fs_corr T q' (I.map ι) hIq' ψ1 hψ1
    have G1 : ∀ P : Ideal S, I ≤ P → I.map ι ≤ Λ P := fun P hP =>
      Ideal.map_le_iff_le_comap.mpr fun x hx => (hΛmem P (ι x)).mpr ⟨0, x, hP hx, by simp⟩
    have hmono : ∀ P P' : Ideal S, P' ≤ P → Λ P' ≤ Λ P := by
      intro P P' h z hz
      obtain ⟨k, a, ha, he⟩ := (hΛmem P' z).mp hz
      exact (hΛmem P z).mpr ⟨k, a, h ha, he⟩
    obtain ⟨b₀, hb₀I, hb₀⟩ := hv
    have hfact : ∀ P : Ideal
        (Localization.AtPrime q ⧸ I.map (algebraMap S (Localization.AtPrime q))),
        P ∈ minimalPrimes _ →
        P.IsPrime ∧ P.comap ψ0 ∈ I.minimalPrimes ∧ τ ∉ P.comap ψ0 ∧
        (Λ (P.comap ψ0)).IsPrime ∧ (Λ (P.comap ψ0)).comap ι = P.comap ψ0 ∧
        v ∈ Λ (P.comap ψ0) ∧ ((Λ (P.comap ψ0)).map ψ1).IsPrime ∧
        ((Λ (P.comap ψ0)).map ψ1).comap ψ1 = Λ (P.comap ψ0) ∧
        Λ (P.comap ψ0) ∈ (I.map ι).minimalPrimes := by
