  have hMI : ∀ z, z ∈ MI ↔ (z : L) ∈ MS := fun z => Iff.rfl
  have hItop : Ideal.span {Vt ^ K₁, N't ^ N} ⊔ MI = ⊤ := by
    by_contra hne
