    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' r b' q' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → b' = r * q' → b' ≠ 0 →
      wcLlsDiscSep W A K L t c' b' →
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
          wcLlsScN W A K t c' r →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L (wcLlsScN W A K t c' r) Q →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) Q) = 0 →
        wcLlsScConn W A K L t c' b' → wcLlsScDF W A K L t c' b' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' r b' q' hc' hr hr0 hq' hb' hb'0
    _hs' Q hQ hQc hQU hδQ hC

  have s5 : ∀ (B : Type u) [CommRing B] (σ : ↥W →+* B) (I : Ideal B) (G : B) (k : ℕ)
      (θ : Localization.Away (Ideal.Quotient.mk I G) ≃+*
        (Fin k → Polynomial (IsLocalRing.ResidueField ↥W))),
      (∀ w : ↥W, θ (algebraMap (B ⧸ I) (Localization.Away (Ideal.Quotient.mk I G))
          (Ideal.Quotient.mk I (σ w))) =
        algebraMap (IsLocalRing.ResidueField ↥W) (Fin k → Polynomial (IsLocalRing.ResidueField ↥W))
          (IsLocalRing.residue ↥W w)) →
      (∃ h : B, G * h - 1 ∈ I.radical) → I.radical ≠ ⊤ →
      (∀ e : B, e * e - e ∈ I.radical → e ∈ I.radical ∨ e - 1 ∈ I.radical) →
      ∃ x : B, (∀ z : B, ∃ p : Polynomial ↥W, z - Polynomial.eval₂ σ x p ∈ I.radical) ∧
        ∀ p : Polynomial ↥W, Polynomial.eval₂ σ x p ∈ I.radical →
          ∀ i, p.coeff i ∈ IsLocalRing.maximalIdeal ↥W := by
    intro B _ σ I G k θ hθ hG hJ hidem

    have hu : IsUnit (Ideal.Quotient.mk I G) := by
      obtain ⟨h, hh⟩ := hG
      obtain ⟨n, hn⟩ := hh
      have hnil : IsNilpotent (Ideal.Quotient.mk I (G * h - 1)) :=
        ⟨n, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact hn⟩
      have h1 : IsUnit (Ideal.Quotient.mk I (G * h - 1) + 1) := hnil.isUnit_add_one
      have h2 : Ideal.Quotient.mk I (G * h - 1) + 1 =
          Ideal.Quotient.mk I G * Ideal.Quotient.mk I h := by
        rw [map_sub, map_one, map_mul]; ring
      rw [h2] at h1
      exact isUnit_of_mul_isUnit_left h1
    let e1 : (B ⧸ I) ≃ₐ[B ⧸ I] Localization.Away (Ideal.Quotient.mk I G) :=
      IsLocalization.atUnit (B ⧸ I) (Localization.Away (Ideal.Quotient.mk I G))
        (Ideal.Quotient.mk I G) hu
    let Φ : (B ⧸ I) ≃+* (Fin k → Polynomial (IsLocalRing.ResidueField ↥W)) :=
      e1.toRingEquiv.trans θ
    have hΦ : ∀ y, Φ y = θ (algebraMap (B ⧸ I) (Localization.Away (Ideal.Quotient.mk I G)) y) := by
      intro y
      show θ (e1 y) = _
      exact congrArg θ (e1.commutes y)

    have hIrad : I.radical = I := by
      apply le_antisymm _ Ideal.le_radical
      intro x hx
      obtain ⟨n, hn⟩ := hx
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      apply Φ.injective
      rw [map_zero]
      have hnil : IsNilpotent (Φ (Ideal.Quotient.mk I x)) :=
        ⟨n, by rw [← map_pow, ← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr hn, map_zero]⟩
      exact hnil.eq_zero

    have hk : k = 1 := by
      rcases Nat.lt_or_ge k 1 with h0 | h1
      · exfalso
        apply hJ
        rw [hIrad, Ideal.eq_top_iff_one, ← Ideal.Quotient.eq_zero_iff_mem]
        apply Φ.injective
        funext i
        exfalso
        have := i.2
        omega
      · rcases Nat.lt_or_ge k 2 with h2 | h2
        · omega
        · exfalso
          obtain ⟨e, he⟩ := Ideal.Quotient.mk_surjective
            (Φ.symm (Pi.single (⟨0, by omega⟩ : Fin k) 1))
          have hΦe : Φ (Ideal.Quotient.mk I e) = Pi.single (⟨0, by omega⟩ : Fin k) 1 := by
            rw [he]; exact Φ.apply_symm_apply _
          have hidem' : e * e - e ∈ I.radical := by
            rw [hIrad, ← Ideal.Quotient.eq_zero_iff_mem]
            apply Φ.injective
            rw [map_zero, map_sub, map_mul, map_sub, map_mul, hΦe, ← Pi.single_mul, mul_one,
              sub_self]
          rcases hidem e hidem' with h | h
          · rw [hIrad, ← Ideal.Quotient.eq_zero_iff_mem] at h
            have h3 := congrFun (congrArg Φ h) ⟨0, by omega⟩
            rw [hΦe, map_zero, Pi.single_eq_same] at h3
            exact one_ne_zero h3
          · rw [hIrad, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, sub_eq_zero] at h
            have h3 := congrFun (congrArg Φ h) ⟨1, by omega⟩
            rw [hΦe, map_one, Pi.single_eq_of_ne (by simp [Fin.ext_iff]), Pi.one_apply] at h3
            exact zero_ne_one h3
    subst hk
    let F : B →+* Polynomial (IsLocalRing.ResidueField ↥W) :=
      (Pi.evalRingHom (fun _ : Fin 1 => Polynomial (IsLocalRing.ResidueField ↥W)) 0).comp
        (Φ.toRingHom.comp (Ideal.Quotient.mk I))
    have hFapp : ∀ b, F b = Φ (Ideal.Quotient.mk I b) 0 := fun b => rfl
    have hFsurj : Function.Surjective F := by
      intro q
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (Φ.symm (fun _ => q))
      refine ⟨y, ?_⟩
      rw [hFapp, hy, Φ.apply_symm_apply]
    have hFker : ∀ b, F b = 0 ↔ b ∈ I := by
      intro b
      rw [← Ideal.Quotient.eq_zero_iff_mem, hFapp]
      constructor
      · intro h
        apply Φ.injective
        rw [map_zero]
        funext i
        rw [Fin.fin_one_eq_zero i]
        exact h
      · intro h
        rw [h, map_zero]
        rfl
    have hFσ : F.comp σ = Polynomial.C.comp (IsLocalRing.residue ↥W) := by
      refine RingHom.ext fun w => ?_
      show F (σ w) = Polynomial.C (IsLocalRing.residue ↥W w)
      rw [hFapp, hΦ, hθ]
      rfl
    obtain ⟨x, hx⟩ := hFsurj Polynomial.X
    have hFev : ∀ p : Polynomial ↥W,
        F (Polynomial.eval₂ σ x p) = p.map (IsLocalRing.residue ↥W) := by
      intro p
      rw [Polynomial.hom_eval₂, hFσ, hx]
      rfl
    refine ⟨x, ?_, ?_⟩
    · intro z
      obtain ⟨p, hp⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥W)
        IsLocalRing.residue_surjective (F z)
      refine ⟨p, ?_⟩
      rw [hIrad, ← hFker, map_sub, hFev, hp, sub_self]
    · intro p hp i
      rw [hIrad, ← hFker, hFev] at hp
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.coeff_map, hp, Polynomial.coeff_zero]

  obtain ⟨g, z, hg, hz, φ, hφC, hφX, hφet⟩ :=
    wcpa_dj_llsm_fl_smooth_chart Ω W hW hWt A K L 𝔭 t hPD c' r hc' hr hr0 Q hQc hQU hδQ

  obtain ⟨g', hg', P, hPm, hPd, hPres, ε, hε⟩ :=
    wcpa_dj_llsm_fl_weierstrass Ω W hW hWt A K L 𝔭 t hPD c' r hc' hr hr0 Q hQc hQU hδQ
      g z hg hz φ hφC hφX hφet

  obtain ⟨G, hGL, k, θ, hθ⟩ :=
    wcpa_dj_llsm_fl_fibre_product Ω W hW hWt A K L 𝔭 t hPD c' r b' q' hc' hr hr0 hq' hb' hb'0
      Q hQc hQU g z hg hz φ hφC hφX hφet g' hg' P hPm hPd hPres ε hε

  have hgg' : g * g' ∉ Q := by
    intro h
    rcases hQ.mem_or_mem h with h1 | h1
    · exact hg h1
    · exact hg' h1
  have hGu := wcpa_dj_llsm_fl_fibre_over_Q Ω W hW hWt A K L 𝔭 t hPD c' r b' q' hc' hr hr0 hq'
    hb' hb'0 Q hQc hQU (g * g') hgg' G hGL

  exact s5 _ (wcFlSig W A K L t c' b') (wcFlIU W A K L t c' b') G k θ hθ hGu hC.1 hC.2

theorem wcpa_dj_llsm_obnu_tau_ne_zero : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, b' ≠ 0 → algebraMap A K (t - algebraMap ↥W A c') ≠ 0 ∧ algebraMap A K (algebraMap ↥W A b') ≠ 0 :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD c' b' hb'0
  obtain ⟨_, hNZ, _, _, _, _, _, h, hh, f, hfC, hfX, hfet⟩ := hPD
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hne : ∀ x : A, x ≠ 0 → algebraMap A K x ≠ 0 := fun x hx h0 =>
    hx (hinj (h0.trans (map_zero _).symm))
  refine ⟨hne _ ?_, hne _ ?_⟩
  · intro hτ
    have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ Submodule.zero_mem _)
    haveI : IsDomain (Localization.Away h) :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfet.toAlgebra
    haveI : Module.Flat (Polynomial ↥W) (Localization.Away h) := inferInstance
    have hnzd : (Polynomial.X - Polynomial.C c') ∈ nonZeroDivisors (Polynomial ↥W) :=
      (Polynomial.monic_X_sub_C c').mem_nonZeroDivisors
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Localization.Away h) hnzd
    have hf0 : f (Polynomial.X - Polynomial.C c') = 0 := by
      rw [map_sub, hfX]
      have := RingHom.congr_fun hfC c'
      simp only [RingHom.comp_apply] at this
      rw [this, ← map_sub, hτ, map_zero]
    have hsm : ∀ x : Localization.Away h, (Polynomial.X - Polynomial.C c') • x = 0 := by
      intro x
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, hf0, zero_mul]
    have h10 : (1 : Localization.Away h) = 0 := hreg (by
      show (Polynomial.X - Polynomial.C c') • (1 : Localization.Away h) =
        (Polynomial.X - Polynomial.C c') • (0 : Localization.Away h)
      rw [hsm, hsm])
    exact one_ne_zero h10
  · intro h0
    rw [Algebra.algebraMap_eq_smul_one] at h0
    rcases smul_eq_zero.mp h0 with h1 | h1
    · exact hb'0 h1
    · exact one_ne_zero h1

theorem wcpa_dj_llsm_obnu_node_normal : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → ∀ [(wcLlsScNV W A K t c' b').IsPrime], IsIntegrallyClosed (Localization.AtPrime (wcLlsScNV W A K t c' b')) :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD c' b' hc' hb' hb0 _
  classical
  obtain ⟨hFT, hNZ, hIC, h𝔭max, hm𝔭, ht𝔭, h𝔭eq, h, hh𝔭, f, hfC, hfX, hfet⟩ := hPD
  haveI := hNZ
  haveI := hIC
  have hh0 : h ≠ 0 := fun h0 => hh𝔭 (h0 ▸ 𝔭.zero_mem)
  have hinjK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hĥ : algebraMap A K h ≠ 0 := fun h0 => hh0 (hinjK (h0.trans (map_zero _).symm))
  obtain ⟨B, hB⟩ : ∃ B : Subalgebra A K, B = Algebra.adjoin A {(algebraMap A K h)⁻¹} := ⟨_, rfl⟩
  have heB : (algebraMap A K h)⁻¹ ∈ B := by
    rw [hB]; exact Algebra.subset_adjoin (Set.mem_singleton _)

  have key1 : ∀ x ∈ B, ∃ n : ℕ, ∃ a : A, x * algebraMap A K h ^ n = algebraMap A K a := by
    intro x hx
    rw [hB] at hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨1, 1, by rw [pow_one, inv_mul_cancel₀ hĥ, map_one]⟩
    | algebraMap r => exact ⟨0, r, by rw [pow_zero, mul_one]⟩
    | add x y _ _ hx hy =>
      obtain ⟨n₁, a₁, h₁⟩ := hx
      obtain ⟨n₂, a₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, a₁ * h ^ n₂ + a₂ * h ^ n₁, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ← h₁, ← h₂, pow_add]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨n₁, a₁, h₁⟩ := hx
      obtain ⟨n₂, a₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, a₁ * a₂, ?_⟩
      rw [map_mul, ← h₁, ← h₂, pow_add]
