  choose Ni hNi using hNi
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = Finset.univ.sup Ni := ⟨_, rfl⟩
  have hfU : ∀ i, algebraMap K L (wcLlsScS W A K t c' b') ^ N * (f i : L) ∈
