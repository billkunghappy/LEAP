theorem wcpa_dj_llsma_annsep_iff : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [Algebra ↥W B] (K : Type u) [Field K] [Algebra B K]
