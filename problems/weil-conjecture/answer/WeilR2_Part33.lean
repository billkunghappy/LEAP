  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    haveI := hPD.2.1
    rw [Algebra.algebraMap_eq_smul_one] at hw
    exact (smul_eq_zero.mp hw).resolve_right one_ne_zero
  have hwL : Function.Injective ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) :=
    (algebraMap K L).injective.comp ((IsFractionRing.injective A K).comp hWA)
  have hσL : ∀ w : ↥W, ((wcFlSig W A K L t c' r w :
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) : L) =
