theorem wcpa_dj_llsm_sc_residue_uniq : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' r b' q' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → b' = r * q' → b' ≠ 0 →
      wcLlsDiscSep W A K L t c' b' →
      ∃ Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L), Q.IsPrime ∧
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
          wcLlsScN W A K t c' r ∧
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L (wcLlsScN W A K t c' r) Q :=
by
  classical

  have s3 : ∀ (R : Type u) [CommRing R] (K : Type u) [Field K]
      [Algebra R K] (L : Type u) [Field L] [Algebra K L] [Algebra R L] [IsScalarTower R K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔫 : Ideal R),
      (∀ x : K, IsIntegral R x → ∃ p q : R, q ∉ 𝔫 ∧ x * algebraMap R K q = algebraMap R K p) →
      ∀ (Q₁ Q₂ : Ideal ↥(integralClosure R L)), Q₁.IsPrime → Q₂.IsPrime →
        Q₁.comap (algebraMap R ↥(integralClosure R L)) = 𝔫 →
        Q₂.comap (algebraMap R ↥(integralClosure R L)) = 𝔫 →
        ∃ σ : L ≃ₐ[K] L, ∀ z : ↥(integralClosure R L), z ∈ Q₂ ↔ ∃ w ∈ Q₁, σ (w : L) = (z : L) := by
    intro R _ K _ _ L _ _ _ _ _ _ 𝔫 hnorm Q₁ Q₂ hQ₁ hQ₂ hQ₁N hQ₂N
    have act : ∀ σ : L ≃ₐ[K] L, ∃ ρ : ↥(integralClosure R L) →+* ↥(integralClosure R L),
        ∀ z, ((ρ z : ↥(integralClosure R L)) : L) = σ (z : L) := by
      intro σ
      exact ⟨((σ.toAlgHom.restrictScalars R).toRingHom.comp
        (integralClosure R L).val.toRingHom).codRestrict (integralClosure R L)
        (fun z => IsIntegral.map (σ.toAlgHom.restrictScalars R) z.2), fun z => rfl⟩
    choose τ hτ using act
    have hτR : ∀ σ (a : R), τ σ (algebraMap R _ a) = algebraMap R _ a := by
      intro σ a
      apply Subtype.ext
      rw [hτ]
      show σ (algebraMap R L a) = algebraMap R L a
      rw [IsScalarTower.algebraMap_apply R K L, AlgEquiv.commutes]
    have hcomapN : ∀ σ, (Q₁.comap (τ σ)).comap (algebraMap R ↥(integralClosure R L)) = 𝔫 := by
      intro σ
      rw [← hQ₁N]
      ext a
      simp only [Ideal.mem_comap, hτR]
    have key : ∃ σ : L ≃ₐ[K] L, Q₂ = Q₁.comap (τ σ) := by
      by_contra hne
      push_neg at hne
      have hnle : ∀ σ : L ≃ₐ[K] L, ¬ Q₂ ≤ Q₁.comap (τ σ) := by
        intro σ hle
        haveI : Q₂.IsPrime := hQ₂
        rcases lt_or_eq_of_le hle with hlt | heq
        · obtain ⟨z, hzJ, hzI⟩ := Set.exists_of_ssubset hlt
          have := Ideal.comap_lt_comap_of_integral_mem_sdiff (R := R) hle ⟨hzJ, hzI⟩
            (integralClosure.isIntegral z)
          rw [Ideal.under, Ideal.under, hQ₂N, hcomapN σ] at this
          exact lt_irrefl _ this
        · exact hne σ heq
      have hprime : ∀ σ ∈ (Finset.univ : Finset (L ≃ₐ[K] L)), σ ≠ 1 → σ ≠ 1 →
          (Q₁.comap (τ σ)).IsPrime := fun σ _ _ _ => Ideal.comap_isPrime _ _
      have hnsub : ¬ ((Q₂ : Set ↥(integralClosure R L)) ⊆
          ⋃ σ ∈ ((Finset.univ : Finset (L ≃ₐ[K] L)) : Set (L ≃ₐ[K] L)),
            ((Q₁.comap (τ σ) : Ideal ↥(integralClosure R L)) : Set ↥(integralClosure R L))) := by
        rw [Ideal.subset_union_prime 1 1 hprime]
        rintro ⟨σ, _, hσ⟩
        exact hnle σ hσ
      obtain ⟨x, hxQ₂, hx⟩ := Set.not_subset.mp hnsub
      have hxσ : ∀ σ, τ σ x ∉ Q₁ := by
        intro σ h
        apply hx
        exact Set.mem_biUnion (Finset.mem_coe.mpr (Finset.mem_univ σ)) h
      set N := ∏ σ : L ≃ₐ[K] L, τ σ x with hN
      have hNL : (N : L) = algebraMap K L (Algebra.norm K (x : L)) := by
        rw [Algebra.norm_eq_prod_automorphisms, hN]
        simp only [← hτ]
        exact map_prod (integralClosure R L).val _ _
      have hnint : IsIntegral R (Algebra.norm K (x : L)) := by
        have h1 : IsIntegral R (algebraMap K L (Algebra.norm K (x : L))) := by
          rw [← hNL]; exact N.2
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom R K L)
          (algebraMap K L).injective).mp h1
      obtain ⟨p, q, hq, hpq⟩ := hnorm _ hnint
      have hNC : N * algebraMap R _ q = algebraMap R _ p := by
        apply Subtype.ext
        have := congrArg (algebraMap K L) hpq
        rw [map_mul] at this
        simp only [← IsScalarTower.algebraMap_apply] at this
        rw [← hNL] at this
        exact this
      have hNQ₂ : N ∈ Q₂ := by
        rw [hN]
        haveI := hQ₂
        have : τ 1 x = x := Subtype.ext (by rw [hτ]; rfl)
        exact (Ideal.IsPrime.prod_mem_iff).mpr ⟨1, Finset.mem_univ _, by rw [this]; exact hxQ₂⟩
      have hp : p ∈ 𝔫 := by
        rw [← hQ₂N, Ideal.mem_comap, ← hNC]
        exact Ideal.mul_mem_right _ _ hNQ₂
      have hpQ₁ : algebraMap R _ p ∈ Q₁ := by
        rw [← Ideal.mem_comap, hQ₁N]; exact hp
      have hqQ₁ : algebraMap R _ q ∉ Q₁ := by
        rw [← Ideal.mem_comap, hQ₁N]; exact hq
      rw [← hNC] at hpQ₁
      have hNQ₁ : N ∈ Q₁ := (hQ₁.mem_or_mem hpQ₁).resolve_right hqQ₁
      haveI := hQ₁
      obtain ⟨σ, _, hσ⟩ := (Ideal.IsPrime.prod_mem_iff).mp hNQ₁
      exact hxσ σ hσ
    obtain ⟨σ, hσ⟩ := key
    refine ⟨σ.symm, fun z => ?_⟩
    rw [hσ, Ideal.mem_comap]
    constructor
    · intro h
      exact ⟨τ σ z, h, by rw [hτ, AlgEquiv.symm_apply_apply]⟩
    · rintro ⟨w, hw, hwz⟩
      have e : τ σ z = w := Subtype.ext (by rw [hτ, ← hwz, AlgEquiv.apply_symm_apply])
      rw [e]; exact hw
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' r b' q' hc' hr hr0
    hq' hb' hb'0 hs'

  have s6 : ∀ (C B : Type u) [CommRing C] [CommRing B] (ι : C →+* B) (J : Ideal B)
      (𝔐 : Set (Ideal C)), 𝔐.Finite → J.radical = J →
      (∀ e : B, e * e - e ∈ J → e ∈ J ∨ e - 1 ∈ J) → (∀ Q ∈ 𝔐, Q.IsMaximal) →
      (∀ P : Ideal B, P.IsPrime → J ≤ P → P.comap ι ∈ 𝔐) →
      (∀ Q ∈ 𝔐, ∃ P : Ideal B, P.IsPrime ∧ J ≤ P ∧ P.comap ι = Q) →
      ∀ Q ∈ 𝔐, ∀ Q' ∈ 𝔐, Q = Q' := by
    intro C B _ _ ι J 𝔐 hfin hrad hid hmax hcov hhit Q hQ Q' hQ'
    by_contra hne
    have hcop : ∀ Q'' ∈ hfin.toFinset.erase Q, Q ⊔ Q'' = ⊤ := by
      intro Q'' hQ''
      obtain ⟨hne'', hmem⟩ := Finset.mem_erase.mp hQ''
      exact Ideal.IsMaximal.coprime_of_ne (hmax Q hQ) (hmax Q'' (hfin.mem_toFinset.mp hmem))
        (Ne.symm hne'')
    have htop : Q ⊔ ∏ Q'' ∈ hfin.toFinset.erase Q, Q'' = ⊤ := Ideal.sup_prod_eq_top hcop
    have h1 : (1 : C) ∈ Q ⊔ ∏ Q'' ∈ hfin.toFinset.erase Q, Q'' := by
      rw [htop]; exact Submodule.mem_top
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
    have hbT : ∀ Q'' ∈ hfin.toFinset.erase Q, b ∈ Q'' := fun Q'' hQ'' =>
      (Ideal.prod_le_inf.trans (Finset.inf_le hQ'')) hb
    have hab𝔐 : ∀ Q'' ∈ 𝔐, a * b ∈ Q'' := by
      intro Q'' hQ''
      by_cases h : Q'' = Q
      · rw [h]; exact Ideal.mul_mem_right b _ ha
      · exact Ideal.mul_mem_left _ a
          (hbT Q'' (Finset.mem_erase.mpr ⟨h, hfin.mem_toFinset.mpr hQ''⟩))
    have hJab : ι (a * b) ∈ J := by
      rw [← hrad, Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro P ⟨hJP, hP⟩
      exact hab𝔐 _ (hcov P hP hJP)
    have he : ι b * ι b - ι b ∈ J := by
      have e1 : ι b * ι b - ι b = -ι (a * b) := by
        rw [← map_mul, ← map_sub, ← map_neg]
        congr 1
        linear_combination b * hab
      rw [e1]
      exact J.neg_mem hJab
    rcases hid (ι b) he with h | h
    · obtain ⟨P, _, hJP, hPQ⟩ := hhit Q hQ
      have hbQ : b ∈ Q := by rw [← hPQ]; exact hJP h
      have h1Q : (1 : C) ∈ Q := hab ▸ Q.add_mem ha hbQ
      exact (hmax Q hQ).ne_top ((Ideal.eq_top_iff_one _).mpr h1Q)
    · obtain ⟨P, _, hJP, hPQ⟩ := hhit Q' hQ'
      have hιa : ι a ∈ J := by
        have e2 : ι b - 1 = -ι a := by
          rw [← map_one ι, ← map_sub, ← map_neg]
          congr 1
          linear_combination hab
        rw [e2] at h
        exact (J.neg_mem_iff).mp h
      have haQ' : a ∈ Q' := by rw [← hPQ]; exact hJP hιa
      have hbQ' : b ∈ Q' :=
        hbT Q' (Finset.mem_erase.mpr ⟨fun h' => hne h'.symm, hfin.mem_toFinset.mpr hQ'⟩)
      have h1Q : (1 : C) ∈ Q' := hab ▸ Q'.add_mem haQ' hbQ'
