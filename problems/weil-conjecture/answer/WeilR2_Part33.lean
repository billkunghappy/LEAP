        (Polynomial.C : ↥W →+* Polynomial ↥W)).map fA) F) = 0 := by
    rw [Ideal.quotientMap_mk]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hF
  rw [hw, map_mul, map_pow, Ideal.quotientMap_mk, hhX] at h1
  have hx0 : Ideal.Quotient.mk (Ideal.span {f (wcEbntX W b' 1)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map σQ) (f (wcEbntX W b' 0)) ≠ 0 :=
    fun h0 => hxJ (Ideal.Quotient.eq_zero_iff_mem.mp h0)
  exact mul_ne_zero ((w.isUnit.map _).ne_zero) (pow_ne_zero _ hx0) h1

theorem wcpa_dj_llsm_scrs_node_monomial : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P), (wcNdModelA W P σ ∨ wcNdModelB W P σ) →
    ∀ (u v : P) (b : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → ¬ IsUnit u → ¬ IsUnit v →
    u * v = σ b →
    (∀ 𝔓 ∈ (Ideal.map σ (IsLocalRing.maximalIdeal ↥W)).minimalPrimes, ¬ (u ∈ 𝔓 ∧ v ∈ 𝔓)) →
    ∃ (g : ↥W) (f : wcEbntN W g →+* P), wcEbntPres W σ g f ∧
      ∃ (n : ℕ) (ε : P) (ω : ↥W), 1 ≤ n ∧ IsUnit ε ∧ IsUnit ω ∧ g ^ n = ω * b ∧
        ((v = ε * f (wcEbntX W g 0) ^ n ∧ σ ω * u * ε = f (wcEbntX W g 1) ^ n) ∨
          (v = ε * f (wcEbntX W g 1) ^ n ∧ σ ω * u * ε = f (wcEbntX W g 0) ^ n)) :=
by
  intro Ω _ _ W hdim hWt P _ σ hmod u v b hb hb0 hu hv huv hbr
  classical
  have hrel : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → f (wcEbntX W c 0) * f (wcEbntX W c 1) = σ c := by
    intro P _ σ c f hf
    have h1 : (wcEbntX W c 0) * (wcEbntX W c 1) =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
          (MvPolynomial.C c) := by
      show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
      rw [← map_mul, Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    rw [← map_mul, h1, ← hf.2.2.1]
    rfl
  have hprime : ∀ (A : Type u) [CommRing A] (p : Ideal A) (P : Type u) [CommRing P]
      (e : A →+* P), wcNdIsHens p P e → p.IsPrime := by
    intro A _ p P _ e he
    haveI := he.1
    have hp : p = (IsLocalRing.maximalIdeal P).comap e := by
      ext t
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he.2.1 t, not_not]
    rw [hp]
    exact Ideal.comap_isPrime e _
  rcases hmod with hA | hB
  ·
    exfalso
    obtain ⟨fA, hfC, hH⟩ := hA
    have hI : ((IsLocalRing.maximalIdeal ↥W).map σ).IsPrime :=
      wcpa_dj_lr1k_ebnt_modelA_fibre Ω W hdim hWt P σ ⟨fA, hfC, hH⟩
    have claim : ∀ (F G : P) (c : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W → c ≠ 0 →
        F * G = σ c → ¬ IsUnit F → F ∈ (IsLocalRing.maximalIdeal ↥W).map σ := by
      intro F G c hc hc0 hFG hF
      by_contra hFI
      have hcc : c * c ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_left _ c hc
      have hcc0 : c * c ≠ 0 := mul_ne_zero hc0 hc0
      obtain ⟨Q, _, f, h, hpres, hloc, hX⟩ :=
        wcpa_dj_llsm_scrs_nm_disc_to_node Ω W P fA hH (c * c) hcc hcc0
      haveI := hloc
      have hJ : h F ∉ Ideal.span {f (wcEbntX W (c * c) 1)} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (h.comp (fA.comp Polynomial.C)) := by
        intro hmem
        apply hFI
        have := wcpa_dj_llsm_scrs_nm_disc_branch_inj Ω W hdim hWt P fA hH Q
          (h.comp (fA.comp Polynomial.C)) (c * c) f hpres h rfl hX F hmem
        rwa [hfC] at this
      have hFG' : h F * h G = (h.comp (fA.comp Polynomial.C)) c := by
        rw [← map_mul, hFG, ← hfC]
        rfl
      obtain ⟨α, n, η, _, hη, hform⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hdim hWt Q
        (h.comp (fA.comp Polynomial.C)) (c * c) f hpres (h F) (h G) c hc0 hFG'
      rcases n with _ | k
      · simp only [pow_zero, mul_one, or_self] at hform
        by_cases hα : IsUnit α
        · apply hF
          apply (isUnit_map_iff h F).mp
          rw [hform]
          exact hη.mul (hα.map _)
        · apply hJ
          rw [hform]
          exact Ideal.mem_sup_right (Ideal.mul_mem_left _ η
            (Ideal.mem_map_of_mem _ ((IsLocalRing.mem_maximalIdeal α).mpr hα)))
      · rcases hform with h0 | h1
        · have hmem : (h.comp (fA.comp Polynomial.C)) c ∈
              Ideal.span {f (wcEbntX W (c * c) 0)} := by
            refine Ideal.mem_span_singleton'.mpr
              ⟨η * (h.comp (fA.comp Polynomial.C)) α * f (wcEbntX W (c * c) 0) ^ k * h G, ?_⟩
            rw [← hFG', h0]
            ring
          obtain ⟨k', hk'⟩ := wcpa_dj_lr1k_ebnt_coord_divides Ω W Q
            (h.comp (fA.comp Polynomial.C)) (c * c) f hpres c hmem
          have e1 : c * 1 = c * (c * k') := by rw [mul_one, ← mul_assoc]; exact hk'
          have e2 : 1 = c * k' := mul_left_cancel₀ hc0 e1
          have hcu : IsUnit c := IsUnit.of_mul_eq_one k' e2.symm
          exact (IsLocalRing.mem_maximalIdeal c).mp hc hcu
        · apply hJ
          refine Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr
            ⟨η * (h.comp (fA.comp Polynomial.C)) α * f (wcEbntX W (c * c) 1) ^ k, ?_⟩)
          rw [h1]
          ring
    have huI := claim u v b hb hb0 huv hu
    have hvI := claim v u b hb hb0 (by rw [mul_comm]; exact huv) hv
    haveI := hI
    exact hbr _ (by rw [Ideal.minimalPrimes_eq_subsingleton_self]; exact Set.mem_singleton _)
      ⟨huI, hvI⟩
  ·
    obtain ⟨g, hg, hg0, f, hfC, hH⟩ := hB
    have hpres : wcEbntPres W σ g f := ⟨hg, hg0, hfC, hH⟩
    haveI : IsDomain (wcEbntN W g) := (wcNd_nodal_poly_normal Ω W g hg0).1
    haveI : IsIntegrallyClosed (wcEbntN W g) := (wcNd_nodal_poly_normal Ω W g hg0).2
    haveI : IsDomain P :=
      (wcNd_hens_normal_domain (wcEbntN W g) _ (hprime _ _ _ _ hH) P f hH).1
    have hσinj := wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W P σ g f hpres
    have hσg0 : σ g ≠ 0 := fun h => hg0 (hσinj (h.trans (map_zero σ).symm))
    have hσg : σ g ∈ (IsLocalRing.maximalIdeal ↥W).map σ := Ideal.mem_map_of_mem σ hg
    obtain ⟨α, n, η, _, hη, hform⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hdim hWt P σ g f
      hpres v u b hb0 (by rw [mul_comm]; exact huv)
    obtain ⟨f₁, hp₁, hv₁⟩ : ∃ f₁ : wcEbntN W g →+* P, wcEbntPres W σ g f₁ ∧
        v = η * σ α * f₁ (wcEbntX W g 0) ^ n := by
      rcases hform with h | h
      · exact ⟨f, hpres, h⟩
      · obtain ⟨f', hf', h0, _⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P σ g f hpres
        exact ⟨f', hf', by rw [h0]; exact h⟩
    obtain ⟨f₂, hp₂, h20, h21⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W P σ g f₁ hp₁
    have hxy : f₁ (wcEbntX W g 0) * f₁ (wcEbntX W g 1) = σ g := hrel P σ g f₁ hp₁
    obtain ⟨hB1p, hxB1, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hdim hWt P σ g f₁ hp₁
    obtain ⟨hB0p, hyB0, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hdim hWt P σ g f₂ hp₂
    rw [h21] at hB0p
    rw [h20, h21] at hyB0
    obtain ⟨α', n', η', -, hη', hform'⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hdim hWt P σ
      g f₁ hp₁ u v b hb0 huv
    refine ⟨g, f₁, hp₁, ?_⟩
    generalize f₁ (wcEbntX W g 0) = x at hv₁ hxy hB1p hxB1 hB0p hyB0 hform' ⊢
    generalize f₁ (wcEbntX W g 1) = y at hv₁ hxy hB1p hxB1 hB0p hyB0 hform' ⊢
    have hmin : ∀ (z w : P), z * w ∈ (IsLocalRing.maximalIdeal ↥W).map σ →
        (Ideal.span {w} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ).IsPrime →
        z ∉ Ideal.span {w} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ →
        Ideal.span {w} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ∈
          ((IsLocalRing.maximalIdeal ↥W).map σ).minimalPrimes := by
      intro z w hzw hp hz
      refine ⟨⟨hp, le_sup_right⟩, ?_⟩
      rintro q ⟨hq, hIq⟩ hqle
      rcases hq.mem_or_mem (hIq hzw) with h | h
      · exact absurd (hqle h) hz
      · exact sup_le ((Ideal.span_singleton_le_iff_mem q).mpr h) hIq
    have hB1min := hmin x y (by rw [hxy]; exact hσg) hB1p hxB1
    have hB0min := hmin y x (by rw [mul_comm, hxy]; exact hσg) hB0p hyB0

    have hαu : IsUnit α := by
      by_contra hα
      have hvI : v ∈ (IsLocalRing.maximalIdeal ↥W).map σ := by
        rw [hv₁]
        exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ η
          (Ideal.mem_map_of_mem σ ((IsLocalRing.mem_maximalIdeal α).mpr hα)))
      have huB0 : u ∉ Ideal.span {x} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
        fun h => hbr _ hB0min ⟨h, Ideal.mem_sup_right hvI⟩
      have huB1 : u ∉ Ideal.span {y} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
        fun h => hbr _ hB1min ⟨h, Ideal.mem_sup_right hvI⟩
      rcases n' with _ | k
      · simp only [pow_zero, mul_one, or_self] at hform'
        by_cases hα' : IsUnit α'
        · apply hu
          rw [hform']
          exact hη'.mul (hα'.map σ)
        · apply huB0
          rw [hform']
          exact Ideal.mem_sup_right (Ideal.mul_mem_left _ η'
            (Ideal.mem_map_of_mem σ ((IsLocalRing.mem_maximalIdeal α').mpr hα')))
      · rcases hform' with h | h
        · exact huB0 (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr
            ⟨η' * σ α' * x ^ k, by rw [h]; ring⟩))
        · exact huB1 (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr
            ⟨η' * σ α' * y ^ k, by rw [h]; ring⟩))
    obtain ⟨ε, hε, hvε⟩ : ∃ ε : P, IsUnit ε ∧ v = ε * x ^ n :=
      ⟨η * σ α, hη.mul (hαu.map σ), hv₁⟩
    have hn : 1 ≤ n := by
      rcases Nat.eq_zero_or_pos n with h0 | h0
      · exfalso
        apply hv
        rw [hvε, h0, pow_zero, mul_one]
        exact hε
      · exact h0
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
    have hvB0 : v ∈ Ideal.span {x} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
      Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨ε * x ^ k, by rw [hvε]; ring⟩)
    have huB0 : u ∉ Ideal.span {x} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
      fun h => hbr _ hB0min ⟨h, hvB0⟩
    have hx0 : x ≠ 0 := by
      intro h
      apply hσg0
      rw [← hxy, h, zero_mul]
    have hstar : u * ε * x ^ (k + 1) = σ b := by
      rw [← huv, hvε]
      ring
    have hstar2 : x ^ (k + 1) * y ^ (k + 1) = σ (g ^ (k + 1)) := by
      rw [map_pow, ← hxy, mul_pow]
    have hxn0 : x ^ (k + 1) ≠ 0 := pow_ne_zero _ hx0
    have hεB0 : ε ∉ Ideal.span {x} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
      fun h => hB0p.ne_top (Ideal.eq_top_of_isUnit_mem _ h hε)
    rcases ValuationRing.dvd_total b (g ^ (k + 1)) with ⟨ω, hω⟩ | ⟨d, hd⟩
    · have key : σ ω * u * ε = y ^ (k + 1) := by
        apply mul_right_cancel₀ hxn0
        calc σ ω * u * ε * x ^ (k + 1) = σ ω * (u * ε * x ^ (k + 1)) := by ring
          _ = σ ω * σ b := by rw [hstar]
          _ = σ (g ^ (k + 1)) := by rw [hω, map_mul, mul_comm]
          _ = y ^ (k + 1) * x ^ (k + 1) := by rw [← hstar2, mul_comm]
      by_cases hωu : IsUnit ω
      · exact ⟨k + 1, ε, ω, by omega, hε, hωu, by rw [hω, mul_comm], Or.inl ⟨hvε, key⟩⟩
      · exfalso
        have hyn : y ^ (k + 1) ∈ Ideal.span {x} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ := by
          rw [← key]
          exact Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _
            (Ideal.mem_map_of_mem σ ((IsLocalRing.mem_maximalIdeal ω).mpr hωu))))
        exact hyB0 (hB0p.mem_of_pow_mem _ hyn)
    · have key : u * ε = y ^ (k + 1) * σ d := by
        apply mul_right_cancel₀ hxn0
        calc u * ε * x ^ (k + 1) = σ b := hstar
          _ = σ (g ^ (k + 1)) * σ d := by rw [hd, map_mul]
          _ = y ^ (k + 1) * σ d * x ^ (k + 1) := by rw [← hstar2]; ring
      by_cases hdu : IsUnit d
      · have hinv : (↑hdu.unit⁻¹ : ↥W) * d = 1 := hdu.val_inv_mul
        refine ⟨k + 1, ε, ↑hdu.unit⁻¹, by omega, hε, Units.isUnit _, ?_, Or.inl ⟨hvε, ?_⟩⟩
        · rw [hd]
          calc g ^ (k + 1) = g ^ (k + 1) * ((↑hdu.unit⁻¹ : ↥W) * d) := by rw [hinv, mul_one]
            _ = (↑hdu.unit⁻¹ : ↥W) * (g ^ (k + 1) * d) := by ring
        · calc σ ↑hdu.unit⁻¹ * u * ε = σ ↑hdu.unit⁻¹ * (u * ε) := by ring
            _ = σ ↑hdu.unit⁻¹ * (y ^ (k + 1) * σ d) := by rw [key]
            _ = y ^ (k + 1) * σ ((↑hdu.unit⁻¹ : ↥W) * d) := by rw [map_mul]; ring
            _ = y ^ (k + 1) := by rw [hinv, map_one, mul_one]
      · exfalso
        have huε : u * ε ∈ Ideal.span {x} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ := by
          rw [key]
          exact Ideal.mem_sup_right (Ideal.mul_mem_left _ _
            (Ideal.mem_map_of_mem σ ((IsLocalRing.mem_maximalIdeal d).mpr hdu)))
        rcases hB0p.mem_or_mem huε with h | h
        · exact huB0 h
        · exact hεB0 h

theorem wcpa_dj_llsm_scbc_hens_going_down : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (P : Type u) [CommRing P] (e : B →+* P), wcNdIsHens (IsLocalRing.maximalIdeal B) P e → ∀ (𝔮₁ : Ideal B) (𝔓₂ : Ideal P), 𝔮₁.IsPrime → 𝔓₂.IsPrime → 𝔮₁ ≤ 𝔓₂.comap e → ∃ 𝔓₁ : Ideal P, 𝔓₁.IsPrime ∧ 𝔓₁ ≤ 𝔓₂ ∧ 𝔓₁.comap e = 𝔮₁ :=
by
  intro B _ _ P _ e hP 𝔮₁ 𝔓₂ h𝔮₁ h𝔓₂ hle
  obtain ⟨R, _, _, hR, hflat, -⟩ := wcNd_hi_hens_exists_flat B
  obtain ⟨φ, ⟨hφe, hφloc⟩, -⟩ := hP.2.2 R hR.1 (algebraMap B R) hR.2.1
  obtain ⟨ψ, ⟨hψι, hψloc⟩, -⟩ := hR.2.2 P hP.1 e hP.2.1
  haveI := hφloc
  haveI := hψloc
  have hψφ : ψ.comp φ = RingHom.id P := by
    apply (hP.2.2 P hP.1 e hP.2.1).unique
    · refine ⟨?_, ?_⟩
      · rw [RingHom.comp_assoc, hφe, hψι]
      · exact RingHom.isLocalHom_comp ψ φ
    · exact ⟨RingHom.id_comp e, isLocalHom_id P⟩
  haveI : Module.Flat B R := hflat
  haveI : Algebra.HasGoingDown B R := Algebra.HasGoingDown.of_flat
  haveI hQp : (𝔓₂.comap ψ).IsPrime := Ideal.comap_isPrime ψ 𝔓₂
  haveI hq₂p : (𝔓₂.comap e).IsPrime := Ideal.comap_isPrime e 𝔓₂
  have hQc : (𝔓₂.comap ψ).comap (algebraMap B R) = 𝔓₂.comap e := by
    rw [Ideal.comap_comap, hψι]
  haveI : (𝔓₂.comap ψ).LiesOver (𝔓₂.comap e) := ⟨by rw [Ideal.under_def, hQc]⟩
  obtain ⟨P', hP'le, hP'p, hP'o⟩ :=
    Ideal.exists_ideal_le_liesOver_of_le (p := 𝔮₁) (q := 𝔓₂.comap e) (𝔓₂.comap ψ) hle
  have hP'c : P'.comap (algebraMap B R) = 𝔮₁ := by
    rw [hP'o.over, Ideal.under_def]
  refine ⟨P'.comap φ, Ideal.comap_isPrime φ P', ?_, ?_⟩
  · intro x hx
    have h1 : φ x ∈ 𝔓₂.comap ψ := hP'le hx
    have h2 : ψ (φ x) ∈ 𝔓₂ := h1
    have h3 : ψ (φ x) = x := by
      have := congrArg (fun f : P →+* P => f x) hψφ
      simpa using this
    rw [h3] at h2
    exact h2
  · rw [Ideal.comap_comap, hφe, hP'c]

theorem wcpa_dj_llsm_scbc_incomparable_max : ∀ (R C : Type u) [CommRing R] [CommRing C] [Algebra R C] [Algebra.IsIntegral R C] (Q : Ideal C) [Q.IsPrime] (𝔮 : Ideal (Localization.AtPrime Q)), 𝔮.IsPrime → Q.comap (algebraMap R C) ≤ (𝔮.comap (algebraMap C (Localization.AtPrime Q))).comap (algebraMap R C) → 𝔮 = IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
by
  intro R C _ _ _ _ Q _ 𝔮 h𝔮 hle
  haveI := h𝔮
  set q' : Ideal C := 𝔮.comap (algebraMap C (Localization.AtPrime Q)) with hq'
  haveI hq'p : q'.IsPrime := Ideal.comap_isPrime _ 𝔮
  have s2 : q' ≤ Q := by
    have h1 : 𝔮 ≤ IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
      IsLocalRing.le_maximalIdeal h𝔮.ne_top
    have h2 := Ideal.comap_mono (f := algebraMap C (Localization.AtPrime Q)) h1
    have h3 : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
        (algebraMap C (Localization.AtPrime Q)) = Q :=
      Localization.AtPrime.comap_maximalIdeal (I := Q)
    rw [h3] at h2
    exact h2
  have s3 : q' = Q := by
    by_contra hne
    have hlt : q' < Q := lt_of_le_of_ne s2 hne
    obtain ⟨x, hxQ, hxq'⟩ := SetLike.exists_of_lt hlt
    have hint : IsIntegral R x := Algebra.IsIntegral.isIntegral x
    have hlt' := Ideal.comap_lt_comap_of_integral_mem_sdiff (R := R) (I := q') (J := Q) s2
      ⟨hxQ, hxq'⟩ hint
    exact absurd hle (not_le_of_gt hlt')
  calc 𝔮 = q'.map (algebraMap C (Localization.AtPrime Q)) :=
        (IsLocalization.map_comap Q.primeCompl (Localization.AtPrime Q) 𝔮).symm
    _ = Q.map (algebraMap C (Localization.AtPrime Q)) := by rw [s3]
    _ = IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
        Localization.AtPrime.map_eq_maximalIdeal

theorem wcpa_dj_llsm_scrs_branch_condition : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K (t - algebraMap ↥W A c) →
    ∀ (Qb : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Qb.IsPrime],
      Qb.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime Qb →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Qb)) P e →
      ¬ IsUnit (e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c))))) ∧
      ¬ IsUnit (e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩))) ∧
      e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c)))) *
        e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
          (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) =
        (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) b ∧
      ∀ 𝔓 ∈ (Ideal.map (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))))
          (IsLocalRing.maximalIdeal ↥W)).minimalPrimes,
        ¬ (e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c)))) ∈ 𝔓 ∧
          e (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
            (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
              ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩)) ∈ 𝔓) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 t hPD c b hc hbm hb0 s hs Qb _ hQb P _ e he
  classical
  obtain ⟨N, hNdef⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}), N =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) := ⟨_, rfl⟩
  rw [← hNdef] at hQb

  have huN : algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) ∈ N := by
    rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hsN : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ N := by
    rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hmN : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ N := by
    intro w hw
    rw [hNdef]
    exact Ideal.mem_sup_right
      (Ideal.mem_map_of_mem ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hw)
  have hmaxL : ∀ x, x ∈ N →
      algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
        (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) x) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime Qb) := by
    intro x hx
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Qb) Qb]
    rw [← hQb] at hx
    exact hx

  obtain ⟨𝔭₀, h𝔭₀p, h𝔭₀le, h𝔭₀m, hu𝔭₀⟩ :=
    wcpa_dj_llsm_scbc_fibre_generic_prime Ω W A 𝔭 t hPD c
  have hu0 : t - algebraMap ↥W A c ≠ 0 := by
    intro h; apply hu𝔭₀; rw [h]; exact 𝔭₀.zero_mem
  have huK : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := by
    intro h
    exact hu0 ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))
  have hprodR : algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) *
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) =
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A b) := by
    apply Subtype.ext
    show algebraMap A K (t - algebraMap ↥W A c) * s = algebraMap A K (algebraMap ↥W A b)
    rw [hs]
    field_simp
  refine ⟨fun h => ((he.2.1 _).mp h) (hmaxL _ huN), fun h => ((he.2.1 _).mp h) (hmaxL _ hsN),
    ?_, ?_⟩
  · rw [← map_mul, ← map_mul, ← map_mul, hprodR]
    rfl

  intro 𝔓 h𝔓 hboth
  obtain ⟨hu𝔓, hs𝔓⟩ := hboth
  obtain ⟨⟨h𝔓p, h𝔓m⟩, h𝔓min⟩ := h𝔓
  haveI := h𝔓p

  have hN𝔮 : N ≤ (((𝔓.comap e).comap
      (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb))).comap
      (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L))) := by
    rw [hNdef]
    apply sup_le
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · exact hu𝔓
      · exact hs𝔓
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact h𝔓m (Ideal.mem_map_of_mem _ hw)
  have h𝔮max : 𝔓.comap e = IsLocalRing.maximalIdeal (Localization.AtPrime Qb) :=
    wcpa_dj_llsm_scbc_incomparable_max _ _ Qb (𝔓.comap e) (Ideal.comap_isPrime e 𝔓)
      (by rw [hQb]; exact hN𝔮)

  have hβ : algebraMap ↥W A b ∈ 𝔭₀ := h𝔭₀m (Ideal.mem_map_of_mem _ hbm)
  obtain ⟨𝔫₁, h𝔫₁p, h𝔫₁c, h𝔫₁J⟩ := wcpa_dj_llsm_scbc_branch_prime A K
    (t - algebraMap ↥W A c) (algebraMap ↥W A b) 𝔭₀ h𝔭₀p hβ hu𝔭₀ s hs
  have h𝔭N : 𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
    obtain ⟨_, _, _, _, _, _, h𝔭eq, _⟩ := hPD
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A ↥(Algebra.adjoin A {s}) t ∈ N
      have hteq : algebraMap A ↥(Algebra.adjoin A {s}) t =
          algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) +
          algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A c) := by
        rw [← map_add, sub_add_cancel]
      rw [hteq]
      exact Ideal.add_mem _ huN (hmN c hc)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hmN w hw
  have h𝔫₁N : 𝔫₁ ≤ N := h𝔫₁J N hsN (by
    rw [Ideal.map_le_iff_le_comap]
    exact le_trans h𝔭₀le h𝔭N)

  have hNmax := wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 (.disc t) (t - algebraMap ↥W A c) b
    hPD (Or.inl ⟨t, c, rfl, hc, rfl⟩) hbm hb0 s hs
    (by rw [← hNdef, ← hQb]; exact (Ideal.comap_isPrime _ Qb).ne_top)
  haveI hNm : N.IsMaximal := by rw [hNdef]; exact hNmax
  have hRN : IsIntegrallyClosed (Localization.AtPrime N) :=
    (wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 (.disc t) (t - algebraMap ↥W A c) b
      hPD (Or.inl ⟨t, c, rfl, hc, rfl⟩) hbm hb0 s hs N hNdef).2.1

  have hinj : Function.Injective
      (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
    intro x y hxy
    have h1 := congrArg (fun z : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) => (z : L)) hxy
    have h2 : algebraMap K L (x : K) = algebraMap K L (y : K) := h1
    exact Subtype.ext ((algebraMap K L).injective h2)
  obtain ⟨𝔮₁, h𝔮₁p, h𝔮₁le, h𝔮₁c⟩ := wcpa_dj_llsm_scbc_normal_going_down _ _ hinj N hRN Qb
    inferInstance hQb 𝔫₁ h𝔫₁p h𝔫₁N

  have hdisj : Disjoint (Qb.primeCompl : Set ↥(integralClosure ↥(Algebra.adjoin A {s}) L))
      (𝔮₁ : Set ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
    rw [Set.disjoint_left]
    intro x hx hx'
    exact hx (h𝔮₁le hx')
  have h𝔮₁'p : (𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint Qb.primeCompl (Localization.AtPrime Qb) 𝔮₁
      h𝔮₁p hdisj
  have h𝔮₁'c : (𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb))).comap (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb)) = 𝔮₁ :=
    IsLocalization.under_map_of_isPrime_disjoint Qb.primeCompl (Localization.AtPrime Qb)
      h𝔮₁p hdisj

  have h𝔮₁'le : 𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Qb)) ≤ 𝔓.comap e := by
    rw [h𝔮max]
    exact IsLocalRing.le_maximalIdeal h𝔮₁'p.ne_top
  obtain ⟨𝔓₁, h𝔓₁p, h𝔓₁le, h𝔓₁c⟩ :=
    wcpa_dj_llsm_scbc_hens_going_down (Localization.AtPrime Qb) P e he
      (𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (Localization.AtPrime Qb))) 𝔓 h𝔮₁'p h𝔓p h𝔮₁'le

  have hm𝔓₁ : Ideal.map (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime Qb)).comp ((algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))))
          (IsLocalRing.maximalIdeal ↥W) ≤ 𝔓₁ := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    have h1 : algebraMap ↥W A w ∈ 𝔭₀ := h𝔭₀m (Ideal.mem_map_of_mem _ hw)
    have h2 : algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ 𝔫₁ := by
      rw [← h𝔫₁c] at h1; exact h1
    have h3 : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)) ∈ 𝔮₁ := by
      rw [← h𝔮₁c] at h2; exact h2
    have h4 := Ideal.mem_map_of_mem
      (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)) h3
    rw [← h𝔓₁c] at h4
    exact h4

  have h𝔓le : 𝔓 ≤ 𝔓₁ := h𝔓min ⟨h𝔓₁p, hm𝔓₁⟩ h𝔓₁le
  have h5 : algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Qb)
      (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c))) ∈
      𝔮₁.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (Localization.AtPrime Qb)) := by
    rw [← h𝔓₁c]; exact h𝔓le hu𝔓
  have h6 : algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c)) ∈ 𝔮₁ := by
    rw [← h𝔮₁'c]; exact h5
  have h7 : algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) ∈ 𝔫₁ := by
    rw [← h𝔮₁c]; exact h6
  exact hu𝔭₀ (by rw [← h𝔫₁c]; exact h7)

theorem wcNd_nodal_branch_dvr : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (g : ↥W), g ∈ IsLocalRing.maximalIdeal ↥W → ∀ (P : Type u) [CommRing P] (f : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* P), wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f → ∀ (a b : Fin 2), a ≠ b → ((IsLocalRing.maximalIdeal ↥W).map (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X b))}).IsPrime ∧ ∃ (_ : IsDomain (P ⧸ ((IsLocalRing.maximalIdeal ↥W).map (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X b))}))), IsDiscreteValuationRing (P ⧸ ((IsLocalRing.maximalIdeal ↥W).map (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X b))})) ∧ Irreducible (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X b))}) (f (Ideal.Quotient.mk _ (MvPolynomial.X a)))) ∧ ∀ z : P, ∃ c : ↥W, z - f (Ideal.Quotient.mk _ (MvPolynomial.C c)) ∈ (IsLocalRing.maximalIdeal ↥W).map (f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X b))} ⊔ Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X a))} :=
by
  intro Ω _ W g hg P _ f hf a b hab
  classical

  have s4 : ∀ (A B Q : Type u) [CommRing A] [CommRing B] [CommRing Q] (φ : A ≃+* B)
      (p : Ideal A) (e : A →+* Q), wcNdIsHens p Q e →
      wcNdIsHens (Ideal.map φ p) Q (e.comp φ.symm.toRingHom) := by
    intro A B Q _ _ _ φ p e he
    obtain ⟨hH, hU, hUP⟩ := he
    have hle : Ideal.map φ p ≤ Ideal.comap φ.symm p :=
      Ideal.map_le_iff_le_comap.mpr (fun x hx => by
        rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.symm_apply_apply]; exact hx)
    have hmem : ∀ b : B, b ∈ Ideal.map φ p ↔ φ.symm b ∈ p := by
      intro b
      constructor
      · intro hb; exact Ideal.mem_comap.mp (hle hb)
      · intro hb
        have := Ideal.mem_map_of_mem (φ : A →+* B) hb
        rw [RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply] at this
        exact this
    refine ⟨hH, ?_, ?_⟩
    · intro b
      show IsUnit (e (φ.symm b)) ↔ _
      rw [hU, hmem]
    · intro C _ hC g hg
      have hg' : ∀ t, IsUnit ((g.comp φ.toRingHom) t) ↔ t ∉ p := by
        intro t
        show IsUnit (g (φ t)) ↔ _
        rw [hg, hmem, RingEquiv.symm_apply_apply]
      obtain ⟨h, ⟨hh1, hh2⟩, huniq⟩ := hUP C hC (g.comp φ.toRingHom) hg'
      refine ⟨h, ⟨RingHom.ext fun b => ?_, hh2⟩, ?_⟩
      · have := RingHom.congr_fun hh1 (φ.symm b)
        simpa using this
      · rintro h' ⟨h1', h2'⟩
        apply huniq
        refine ⟨RingHom.ext fun t => ?_, h2'⟩
        have := RingHom.congr_fun h1' (φ t)
        simpa using this

  have s6 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (g0 : R)
      (f0 : (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0}) →+* P),
      wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ (IsLocalRing.maximalIdeal R).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f0 →
      ∀ K : Ideal P, (∀ z : P, ¬ IsUnit z → z ∈ K) →
      f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ K → f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ K →
      ∀ z : P, ∃ c : R, z - f0 (Ideal.Quotient.mk _ (MvPolynomial.C c)) ∈ K := by
    intro R _ _ g0 f0 hH K hK h0 h1 z
    obtain ⟨a', s, hs, hnu⟩ := wcpa_dj_lr1k_ebc_dia_hens_residue _ P _ f0 hH z
    have hdec : ∀ q : MvPolynomial (Fin 2) R,
        q - MvPolynomial.C (MvPolynomial.constantCoeff q) ∈
          Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) R), MvPolynomial.X 1} := by
      intro q
      induction q using MvPolynomial.induction_on
      · rename_i r
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact Ideal.zero_mem _
      · rename_i p q hp hq
        have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
          rw [map_add, map_add]; ring
        rw [e]; exact Ideal.add_mem _ hp hq
      · rename_i p i _
        have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
        have hX : (MvPolynomial.X i : MvPolynomial (Fin 2) R) ∈
            Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) R), MvPolynomial.X 1} := by
          rcases hi with rfl | rfl
          · exact Ideal.subset_span (Set.mem_insert _ _)
          · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
        exact Ideal.mul_mem_left _ _ hX
    have hcong : ∀ q : MvPolynomial (Fin 2) R,
        f0 (Ideal.Quotient.mk _ q) -
          f0 (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff q))) ∈ K := by
      intro q
      rw [← map_sub, ← map_sub]
      have hspan : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) R), MvPolynomial.X 1} ≤
          K.comap (f0.comp (Ideal.Quotient.mk _)) := by
        rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | hx
        · exact h0
        · rw [Set.mem_singleton_iff] at hx; subst hx; exact h1
      exact hspan (hdec q)
    obtain ⟨s', rfl⟩ := Ideal.Quotient.mk_surjective s
    obtain ⟨a'', rfl⟩ := Ideal.Quotient.mk_surjective a'
    have hcs : IsUnit (MvPolynomial.constantCoeff s') := by
      by_contra hc
      apply hs
      have hm : MvPolynomial.constantCoeff s' ∈ IsLocalRing.maximalIdeal R :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hc)
      apply Ideal.mem_map_of_mem
      have e : s' = MvPolynomial.C (MvPolynomial.constantCoeff s') +
          (s' - MvPolynomial.C (MvPolynomial.constantCoeff s')) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hm))
        (Ideal.mem_sup_left (hdec s'))
    obtain ⟨v, hv⟩ : ∃ v : R, MvPolynomial.constantCoeff s' * v = 1 :=
      ⟨↑hcs.unit⁻¹, hcs.mul_val_inv⟩
    refine ⟨MvPolynomial.constantCoeff a'' * v, ?_⟩
    have hA := hK _ hnu
    have hB := hcong s'
    have hC := hcong a''
    have hv' : f0 (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff s'))) *
        f0 (Ideal.Quotient.mk _ (MvPolynomial.C v)) = 1 := by
      rw [← map_mul, ← map_mul, ← map_mul, hv, map_one, map_one, map_one]
    have key : z - f0 (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff a'' * v))) =
        f0 (Ideal.Quotient.mk _ (MvPolynomial.C v)) *
          ((z * f0 (Ideal.Quotient.mk _ s') - f0 (Ideal.Quotient.mk _ a'')) -
            z * (f0 (Ideal.Quotient.mk _ s') -
              f0 (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff s')))) +
            (f0 (Ideal.Quotient.mk _ a'') -
              f0 (Ideal.Quotient.mk _ (MvPolynomial.C (MvPolynomial.constantCoeff a''))))) := by
      rw [map_mul MvPolynomial.C, map_mul (Ideal.Quotient.mk _), map_mul f0]
      linear_combination (-z) * hv'
    rw [key]
    exact Ideal.mul_mem_left _ _ (Ideal.add_mem _ (Ideal.sub_mem _ hA (Ideal.mul_mem_left _ _ hB)) hC)

  have core : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (g0 : R)
      (f0 : (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0}) →+* P),
      g0 ∈ IsLocalRing.maximalIdeal R →
      wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ (IsLocalRing.maximalIdeal R).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f0 →
      ((IsLocalRing.maximalIdeal R).map (f0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))}).IsPrime ∧ ∃ (_ : IsDomain (P ⧸ ((IsLocalRing.maximalIdeal R).map (f0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))}))), IsDiscreteValuationRing (P ⧸ ((IsLocalRing.maximalIdeal R).map (f0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))})) ∧ Irreducible (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map (f0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))}) (f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) ∧ ∀ z : P, ∃ c : R, z - f0 (Ideal.Quotient.mk _ (MvPolynomial.C c)) ∈ (IsLocalRing.maximalIdeal R).map (f0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))} ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0))} := by
    intro R _ _ g0 f0 hg0 hH
    haveI : HenselianLocalRing P := hH.1
    have h𝔞𝔪 : (Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) R)} ⊔
        (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0})) ≤
        (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) R), MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0})) :=
      Ideal.map_mono (sup_le_sup_right (Ideal.span_mono (Set.subset_insert _ _)) _)
    have hJ : Ideal.map f0 ((Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) R)} ⊔
        (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0}))) =
        (IsLocalRing.maximalIdeal R).map (f0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ⊔
          Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))} := by
      rw [Ideal.map_map, Ideal.map_sup, Ideal.map_span, Set.image_singleton, Ideal.map_map,
        RingHom.comp_assoc, sup_comm]
      rfl
    have hQ := wcNd_hens_quotient _ _ _ P f0 hH h𝔞𝔪
    obtain ⟨Φ, hΦX, hΦI⟩ := wcpa_dj_lr1k_ebnt_branch_base_iso R g0 hg0
    have hS := s4 _ _ _ Φ _ _ hQ
    rw [hΦI] at hS
    obtain ⟨hdom, hdvr, hirr⟩ := wcNd_line_hens_dvr (IsLocalRing.ResidueField R) _ _ hS
    have hsymm : Φ.symm Polynomial.X =
        Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) := by
      rw [RingEquiv.symm_apply_eq]
      exact hΦX.symm
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at hirr
    rw [hsymm, Ideal.quotientMap_mk] at hirr
    rw [← hJ]
    set J := Ideal.map f0 ((Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) R)} ⊔
        (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0})))
      with hJdef
    have hprime : J.IsPrime := (Ideal.Quotient.isDomain_iff_prime J).mp hdom
    have hJmax : J ≤ IsLocalRing.maximalIdeal P := IsLocalRing.le_maximalIdeal hprime.ne_top
    have hnon : ∀ z : P, ¬ IsUnit z → z ∈ J ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0))} := by
      intro z hz
      have hz' : ¬ IsUnit (Ideal.Quotient.mk J z) := by
        intro hu
        obtain ⟨w', hw'⟩ := hu.exists_right_inv
        obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w'
        rw [← map_mul, ← map_one (Ideal.Quotient.mk J), Ideal.Quotient.eq] at hw'
        have h1 : z * w - 1 ∈ IsLocalRing.maximalIdeal P := hJmax hw'
        have h2 : IsUnit (z * w) := by
          by_contra h
          have h3 : z * w ∈ IsLocalRing.maximalIdeal P :=
            (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h)
          have h4 := Ideal.sub_mem _ h3 h1
          rw [sub_sub_cancel] at h4
          exact (IsLocalRing.maximalIdeal.isMaximal P).ne_top ((Ideal.eq_top_iff_one _).mpr h4)
        exact hz (isUnit_of_mul_isUnit_left h2)
      have hmax : IsLocalRing.maximalIdeal (P ⧸ J) =
          Ideal.span {Ideal.Quotient.mk J (f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0)))} :=
        (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hirr
      have hzm : Ideal.Quotient.mk J z ∈ IsLocalRing.maximalIdeal (P ⧸ J) :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hz')
      rw [hmax, Ideal.mem_span_singleton'] at hzm
      obtain ⟨r', hr'⟩ := hzm
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r'
      rw [← map_mul, Ideal.Quotient.eq] at hr'
      have h5 := Ideal.sub_mem _
        (Ideal.mem_sup_right (Ideal.mul_mem_left _ r (Ideal.mem_span_singleton_self
          (f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0))))) :
          r * f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈
            J ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0))})
        (Ideal.mem_sup_left hr' : _ ∈ J ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0))})
      rw [sub_sub_cancel] at h5
      exact h5
    have hu1 : f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ J := by
      rw [hJ]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
    have hres := s6 R g0 f0 hH (J ⊔ Ideal.span {f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0))}) hnon
      (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)) (Ideal.mem_sup_left hu1)
    exact ⟨hprime, hdom, hdvr, hirr, hres⟩

  have s5 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (g0 : R)
      (f0 : (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0}) →+* P),
      wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ (IsLocalRing.maximalIdeal R).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f0 →
      ∃ f' : (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0}) →+* P,
        wcNdIsHens ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ (IsLocalRing.maximalIdeal R).map MvPolynomial.C).map (Ideal.Quotient.mk _)) P f' ∧
        f'.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = f0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
        f' (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = f0 (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∧
        f' (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = f0 (Ideal.Quotient.mk _ (MvPolynomial.X 0)) := by
    intro R _ _ g0 f0 hf0
    let I : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0}
    let ρ : MvPolynomial (Fin 2) R →+* MvPolynomial (Fin 2) R :=
      (MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1)).toRingHom
    have hρX0 : ρ (MvPolynomial.X 0) = MvPolynomial.X 1 := by
      simp [ρ, MvPolynomial.rename_X]
    have hρX1 : ρ (MvPolynomial.X 1) = MvPolynomial.X 0 := by
      simp [ρ, MvPolynomial.rename_X]
    have hρC : ∀ r, ρ (MvPolynomial.C r) = MvPolynomial.C r := by
      intro r; simp [ρ, MvPolynomial.rename_C]
    have hρρ : ∀ p, ρ (ρ p) = p := by
      intro p
      have e : (⇑(Equiv.swap (0 : Fin 2) 1) ∘ ⇑(Equiv.swap (0 : Fin 2) 1)) = id :=
        funext fun i => Equiv.swap_apply_self _ _ _
      show MvPolynomial.rename _ (MvPolynomial.rename _ p) = p
      rw [MvPolynomial.rename_rename, e]
      simp
    have hρg : ρ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0) =
        MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g0 := by
      rw [map_sub, map_mul, hρX0, hρX1, hρC, mul_comm (MvPolynomial.X 1)]
    have hH : ∀ p ∈ I, (Ideal.Quotient.mk I).comp ρ p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [RingHom.comp_apply, map_mul, hρg, map_mul,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), mul_zero]
    let s : (MvPolynomial (Fin 2) R ⧸ I) →+* (MvPolynomial (Fin 2) R ⧸ I) :=
      Ideal.Quotient.lift I ((Ideal.Quotient.mk I).comp ρ) hH
    have hs : ∀ p, s (Ideal.Quotient.mk I p) = Ideal.Quotient.mk I (ρ p) := fun p =>
      Ideal.Quotient.lift_mk _ _ _
    have hss : ∀ t, s (s t) = t := by
      intro t
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
      rw [hs, hs, hρρ]
    let M : Ideal (MvPolynomial (Fin 2) R ⧸ I) :=
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal R).map MvPolynomial.C).map (Ideal.Quotient.mk I)
    have hsM1 : ∀ t ∈ M, s t ∈ M := by
      intro t ht
      have hle : M ≤ M.comap s := by
        apply Ideal.map_le_iff_le_comap.mpr
        apply sup_le
        · rw [Ideal.span_le]
          intro x hx
          rcases hx with rfl | hx
          · show s (Ideal.Quotient.mk I (MvPolynomial.X 0)) ∈ M
            rw [hs, hρX0]
            exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
          · rw [Set.mem_singleton_iff] at hx
            subst hx
            show s (Ideal.Quotient.mk I (MvPolynomial.X 1)) ∈ M
            rw [hs, hρX1]
            exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
        · apply Ideal.map_le_iff_le_comap.mpr
          intro r hr
          show s (Ideal.Quotient.mk I (MvPolynomial.C r)) ∈ M
          rw [hs, hρC]
          exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hr))
      exact hle ht
    have hsM : ∀ t, s t ∈ M ↔ t ∈ M := by
      intro t
      refine ⟨fun h => ?_, hsM1 t⟩
      have := hsM1 _ h
      rwa [hss] at this
    obtain ⟨hHen, hU, hUP⟩ := hf0
    refine ⟨f0.comp s, ⟨hHen, ?_, ?_⟩, ?_, ?_, ?_⟩
    · intro t
      exact (hU (s t)).trans (not_congr (hsM t))
    · intro B _ hB gB hgB
      have hg' : ∀ t, IsUnit ((gB.comp s) t) ↔ t ∉ M := fun t =>
        (hgB (s t)).trans (not_congr (hsM t))
      obtain ⟨k, ⟨hk, hkl⟩, hku⟩ := hUP B hB (gB.comp s) hg'
      refine ⟨k, ⟨?_, hkl⟩, fun k' hk' => hku k' ⟨?_, hk'.2⟩⟩
      · apply RingHom.ext
        intro t
        have := RingHom.congr_fun hk (s t)
        simp only [RingHom.comp_apply] at this ⊢
        rw [this, hss]
      · apply RingHom.ext
        intro t
        have := RingHom.congr_fun hk'.1 (s t)
        simp only [RingHom.comp_apply] at this ⊢
        rw [hss] at this
        exact this
    · apply RingHom.ext
      intro r
      show f0 (s (Ideal.Quotient.mk I (MvPolynomial.C r))) = f0 (Ideal.Quotient.mk I (MvPolynomial.C r))
      rw [hs, hρC]
    · show f0 (s (Ideal.Quotient.mk I (MvPolynomial.X 0))) = f0 (Ideal.Quotient.mk I (MvPolynomial.X 1))
      rw [hs, hρX0]
    · show f0 (s (Ideal.Quotient.mk I (MvPolynomial.X 1))) = f0 (Ideal.Quotient.mk I (MvPolynomial.X 0))
      rw [hs, hρX1]

  have hcases : ∀ a b : Fin 2, a ≠ b → (a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0) := by decide
  rcases hcases a b hab with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact core (↥W) g f hg hf
  · obtain ⟨f', hf', hσ', h0', h1'⟩ := s5 (↥W) g f hf
    have h := core (↥W) g f' hg hf'
    have hfc : ∀ c : ↥W, f' (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
        f (Ideal.Quotient.mk _ (MvPolynomial.C c)) := fun c => RingHom.congr_fun hσ' c
    rw [hσ', h0', h1'] at h
    simp only [hfc] at h
    exact h

theorem wcpa_dj_llsm_kpdf_special_fibre_dvr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A),
    wcLlsPD W A 𝔭 (.disc t) →
    (∀ a b : A, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
      ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∨
        s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) ∧
    (∀ s : A, s ∉ 𝔭 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
    ∀ b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
      ∃ (k : ℕ) (u s : A), u ∉ 𝔭 ∧ s ∉ 𝔭 ∧
        s * b - u * t ^ k ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
by


  have chart : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
      (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (h : A)
      (S : Type u) [CommRing S] [Algebra ↥W S] (f₀ : S →+* Localization.Away h)
      (P : Type u) [CommRing P] (π : S →+* P),
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → h ∉ 𝔭 →
      f₀.comp (algebraMap ↥W S) =
        (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) →
      RingHom.Etale f₀ → Function.Surjective π →
      RingHom.ker π = (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S) →
      ∃ (E : Type u) (_ : CommRing E) (fb : P →+* E)
        (ρ : Localization.Away h →+* E) (q : Ideal E) (_ : q.IsPrime),
        RingHom.Etale fb ∧ Function.Surjective ρ ∧
        RingHom.ker ρ = ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
          (algebraMap A (Localization.Away h)) ∧
        (∀ s, fb (π s) = ρ (f₀ s)) ∧
        q = (𝔭.map (algebraMap A (Localization.Away h))).map ρ ∧
        Nonempty ((Localization.AtPrime 𝔭 ⧸
          ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.AtPrime 𝔭))) ≃+* Localization.AtPrime q) := by
    intro Ω _ W A _ _ 𝔭 _ h S _ _ f₀ P _ π hm hh hf het hπ hker
    have hK : (RingHom.ker π).map f₀ = ((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) := by
      rw [hker, Ideal.map_map, hf, ← Ideal.map_map]
    have s1 : ∃ fb : P →+* Localization.Away h ⧸ ((IsLocalRing.maximalIdeal ↥W).map
          (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)),
        RingHom.Etale fb ∧ ∀ s, fb (π s) = Ideal.Quotient.mk _ (f₀ s) := by
      generalize ((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) = K at hK ⊢
      letI := f₀.toAlgebra
      haveI : Algebra.Etale S (Localization.Away h) := het
      set J := RingHom.ker π with hJ
      have h1 : RingHom.Etale (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))) :=
        RingHom.etale_algebraMap.mpr inferInstance
      let e₁ : TensorProduct S (S ⧸ J) (Localization.Away h) ≃+*
          Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) :=
        (Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h)).toRingEquiv.trans
          (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm.toRingEquiv
      let e₂ : Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) ≃+*
          Localization.Away h ⧸ K := Ideal.quotEquivOfEq hK
      let e := e₁.trans e₂
      let g := e.toRingHom.comp (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h)))
      have hg : RingHom.Etale g := RingHom.Etale.respectsIso.1 _ _ h1
      let fb := g.comp (RingHom.quotientKerEquivOfSurjective hπ).symm.toRingHom
      have hfb : RingHom.Etale fb := RingHom.Etale.respectsIso.2 _ _ hg
      refine ⟨fb, hfb, fun s => ?_⟩
      have hs : (RingHom.quotientKerEquivOfSurjective hπ).symm (π s) = Ideal.Quotient.mk J s :=
        RingHom.quotientKerEquivOfSurjective_symm_apply hπ s
      show e₂ (e₁ (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))
        ((RingHom.quotientKerEquivOfSurjective hπ).symm (π s)))) = _
      rw [hs, Algebra.TensorProduct.algebraMap_apply]
      show e₂ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm
        ((Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h))
          (_ ⊗ₜ[S] (1 : Localization.Away h)))) = _
      rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
      rw [Algebra.smul_def, mul_one]
      rfl
    set 𝔞 : Ideal A := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with h𝔞d
    have h𝔞 : 𝔞 ≤ 𝔭 := hm
    have hdisj : Disjoint (Submonoid.powers h : Set A) 𝔭 := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hx)
    have hhn : ∀ n : ℕ, h ^ n ∉ 𝔭 := fun n hn => hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hn)
    have hQp : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 ‹_› hdisj
    have hq : ((𝔭.map (algebraMap A (Localization.Away h))).map
        (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h))))).IsPrime := by
      apply Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      rw [Ideal.mk_ker]
      exact Ideal.map_mono h𝔞
    have s3 : Nonempty ((Localization.AtPrime 𝔭 ⧸ 𝔞.map (algebraMap A (Localization.AtPrime 𝔭))) ≃+*
        Localization.AtPrime ((𝔭.map (algebraMap A (Localization.Away h))).map
          (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h)))))) := by
      have hQc : (𝔭.map (algebraMap A (Localization.Away h))).comap
          (algebraMap A (Localization.Away h)) = 𝔭 :=
        IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
      set I : Ideal (Localization.Away h) := 𝔞.map (algebraMap A (Localization.Away h)) with hI
      set Q : Ideal (Localization.Away h) := 𝔭.map (algebraMap A (Localization.Away h)) with hQ
      set q : Ideal (Localization.Away h ⧸ I) := Q.map (Ideal.Quotient.mk I) with hqdef
      have hIQ : I ≤ Q := Ideal.map_mono h𝔞
      have hK1 : q.comap (Ideal.Quotient.mk I) = Q := by
        rw [hqdef, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
          ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
        exact sup_eq_left.mpr hIQ
      have hK2 : ∀ a : A, Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a) ∈ q ↔ a ∈ 𝔭 := by
        intro a
        rw [← Ideal.mem_comap, hK1, ← Ideal.mem_comap, hQc]
      have hunit : ∀ y : 𝔭.primeCompl, IsUnit (((algebraMap (Localization.Away h ⧸ I)
          (Localization.AtPrime q)).comp ((Ideal.Quotient.mk I).comp
            (algebraMap A (Localization.Away h)))) y) := by
        intro y
        exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q _).mpr
          (fun hm => y.2 ((hK2 y).mp hm))
      have hK3 : ∀ t : Localization.Away h ⧸ I, t ∉ q → ∃ (y : Localization.Away h) (m : ℕ) (b : A),
          Ideal.Quotient.mk I y = t ∧
          y * algebraMap A (Localization.Away h) h ^ m = algebraMap A (Localization.Away h) b ∧
          b ∉ 𝔭 := by
        intro t ht
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective t
        obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj h y
        refine ⟨y, m, b, rfl, hb, ?_⟩
        intro hb𝔭
        have h1 : algebraMap A (Localization.Away h) b ∈ Q := Ideal.mem_map_of_mem _ hb𝔭
        rw [← hb] at h1
        rcases hQp.mem_or_mem h1 with h2 | h2
        · exact ht (Ideal.mem_map_of_mem _ h2)
        · rw [← map_pow, ← Ideal.mem_comap, hQc] at h2
          exact hhn m h2
      let θ := IsLocalization.lift (M := 𝔭.primeCompl) (S := Localization.AtPrime 𝔭) hunit
      have hsurj : Function.Surjective θ := by
        intro z
        obtain ⟨⟨e, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
        obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective e
        obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj h x
        have hs0 : b * h ^ n ∈ 𝔭.primeCompl := fun hm =>
          (Ideal.IsPrime.mem_or_mem ‹_› hm).elim hb (hhn n)
        refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔭) (a * h ^ m) ⟨b * h ^ n, hs0⟩, ?_⟩
        rw [IsLocalization.lift_mk'_spec]
        have hZ := IsLocalization.mk'_spec (Localization.AtPrime q) (Ideal.Quotient.mk I x) t
        rw [← hy] at hZ
        simp only [RingHom.comp_apply, map_mul, map_pow]
        rw [← ha, ← hyb]
        simp only [map_mul, map_pow]
        rw [← hZ]
        ring
      have hkerθ : RingHom.ker θ = 𝔞.map (algebraMap A (Localization.AtPrime 𝔭)) := by
        apply le_antisymm
        · intro w hw
          rw [RingHom.mem_ker] at hw
          obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl w
          rw [IsLocalization.lift_mk'_spec, mul_zero] at hw
          obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q)
            (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a))).mp hw
          obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
          have e1 : Ideal.Quotient.mk I (algebraMap A (Localization.Away h) b) =
              ↑t * Ideal.Quotient.mk I (algebraMap A (Localization.Away h) h ^ m) := by
            rw [← hyb, map_mul, hy]
          have e2 : Ideal.Quotient.mk I (algebraMap A (Localization.Away h) (b * a)) = 0 := by
            rw [map_mul, map_mul, e1]
            linear_combination (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) h ^ m)) * ht
          rw [Ideal.Quotient.eq_zero_iff_mem] at e2
          obtain ⟨c, ⟨k, rfl⟩, hc⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
            (Submonoid.powers h) (Localization.Away h) 𝔞 (b * a)).mp e2
          rw [IsLocalization.mk'_mem_map_algebraMap_iff 𝔭.primeCompl]
          refine ⟨h ^ k * b, fun hm => (Ideal.IsPrime.mem_or_mem ‹_› hm).elim (hhn k) hb, ?_⟩
          rw [mul_assoc]
          exact hc
        · rw [Ideal.map_le_iff_le_comap]
          intro x hx
          rw [Ideal.mem_comap, RingHom.mem_ker, IsLocalization.lift_eq]
          show algebraMap (Localization.Away h ⧸ I) (Localization.AtPrime q)
            (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) x)) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hx), map_zero]
      exact ⟨(Ideal.quotEquivOfEq hkerθ.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)⟩
    obtain ⟨fb, hfb, hfbπ⟩ := s1
    exact ⟨_, inferInstance, fb, Ideal.Quotient.mk _, _, hq, hfb, Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, hfbπ, rfl, s3⟩

  have line : ∀ (k E : Type u) [Field k] [CommRing E]
      (f : Polynomial k →+* E) (q : Ideal E) [q.IsPrime],
      RingHom.Etale f → q = Ideal.span {f Polynomial.X} →
      ∃ _ : IsDomain (Localization.AtPrime q), IsDiscreteValuationRing (Localization.AtPrime q) := by
    intro k E _ _ f q _ hf hq
    letI := f.toAlgebra
    haveI : Algebra.Etale (Polynomial k) E := RingHom.Etale.toAlgebra hf
    haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing (Polynomial k) E
    have hreg : IsSMulRegular E (algebraMap (Polynomial k) E Polynomial.X) := by
      apply IsSMulRegular.of_flat
      intro a b h
      exact mul_left_cancel₀ Polynomial.X_ne_zero h
    haveI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) inferInstance
    haveI : Module.Flat E (Localization.AtPrime q) :=
      IsLocalization.flat (Localization.AtPrime q) q.primeCompl
    have hm : IsLocalRing.maximalIdeal (Localization.AtPrime q) =
        Ideal.span {algebraMap E (Localization.AtPrime q) (f Polynomial.X)} := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal,
        congrArg (Ideal.map (algebraMap E (Localization.AtPrime q))) hq, Ideal.map_span,
        Set.image_singleton]
    have hτ : IsSMulRegular (Localization.AtPrime q)
        (algebraMap E (Localization.AtPrime q) (f Polynomial.X)) :=
      IsSMulRegular.of_flat (S := Localization.AtPrime q) hreg
    generalize algebraMap E (Localization.AtPrime q) (f Polynomial.X) = τ at hm hτ
    have hτc : ∀ n : ℕ, ∀ a b : Localization.AtPrime q, τ ^ n * a = τ ^ n * b → a = b := by
      intro n
      induction n with
      | zero => intro a b h; simpa using h
      | succ n ih =>
        intro a b h
        apply ih
        apply hτ
        simp only [smul_eq_mul]
        rw [pow_succ] at h
        calc τ * (τ ^ n * a) = τ ^ n * τ * a := by ring
          _ = τ ^ n * τ * b := h
          _ = τ * (τ ^ n * b) := by ring
    have hτn : ∀ n, τ ^ n ≠ 0 := fun n h => one_ne_zero (hτc n 1 0 (by rw [h]; simp))
    have hK : ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    have hfac : ∀ x : Localization.AtPrime q, x ≠ 0 →
        ∃ n : ℕ, ∃ u : Localization.AtPrime q, IsUnit u ∧ x = τ ^ n * u := by
      intro x hx
      classical
      have hex : ∃ n, x ∉ Ideal.span {τ ^ n} := by
        by_contra hcon
        push_neg at hcon
        apply hx
        have : x ∈ ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i := by
          rw [Ideal.mem_iInf]
          intro i
          rw [hm, Ideal.span_singleton_pow]
          exact hcon i
        rw [hK] at this
        exact this
      have hN : x ∉ Ideal.span {τ ^ Nat.find hex} := Nat.find_spec hex
      have hN0 : Nat.find hex ≠ 0 := by
        intro h0
        apply hN
        rw [h0, pow_zero, Ideal.span_singleton_one]
        trivial
      obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hN0
      have hxn : x ∈ Ideal.span {τ ^ n} := by
        by_contra h
        have := Nat.find_min' hex h
        omega
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hxn
      refine ⟨n, u, ?_, by rw [← hu, mul_comm]⟩
      by_contra hu'
      have hum : u ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        (IsLocalRing.mem_maximalIdeal u).mpr hu'
      rw [hm] at hum
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hum
      apply hN
      rw [Ideal.mem_span_singleton']
      exact ⟨w, by rw [hn, pow_succ, ← hu, ← hw]; ring⟩
    haveI : NoZeroDivisors (Localization.AtPrime q) := by
      constructor
      intro x y hxy
      by_contra h
      push_neg at h
      obtain ⟨a, u, hu, rfl⟩ := hfac x h.1
      obtain ⟨b, v, hv, rfl⟩ := hfac y h.2
      have h2 : τ ^ (a + b) * (u * v) = 0 := by
        rw [pow_add]
        calc τ ^ a * τ ^ b * (u * v) = τ ^ a * u * (τ ^ b * v) := by ring
          _ = 0 := hxy
      exact hτn (a + b) ((hu.mul hv).mul_left_eq_zero.mp h2)
    haveI : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
    refine ⟨inferInstance, ?_⟩
    have hnf : ¬ IsField (Localization.AtPrime q) := by
      intro hF
      have h1 := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
      have hτm : τ ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
        rw [hm]; exact Ideal.subset_span rfl
      rw [h1] at hτm
      exact hτn 1 (by simpa using hτm)
    have hP : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (Localization.AtPrime q)) :=
      ⟨⟨τ, hm⟩⟩
    exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime q) hnf).out 5 1).mp hP

  intro Ω _ _ W _ _ A _ _ _ 𝔭 t hPD
  obtain ⟨_, _, _, hmax, hmA, ht𝔭, h𝔭eq, h, hh, f, hfC, hfX, hfet⟩ := hPD
  haveI : 𝔭.IsPrime := hmax.isPrime
  have h1𝔭 : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hmax.ne_top
  have hnot : ∀ {x y : A}, x ∉ 𝔭 → y ∉ 𝔭 → x * y ∉ 𝔭 := fun hx hy hxy =>
    (hmax.isPrime.mem_or_mem hxy).elim hx hy
  have hf' : f.comp (algebraMap ↥W (Polynomial ↥W)) =
      (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) := by
    rw [Polynomial.algebraMap_eq]; exact hfC
  have hπ : Function.Surjective (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) := by
    rw [Polynomial.coe_mapRingHom]
    exact Polynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) =
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (Polynomial ↥W)) := by
    rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, Polynomial.algebraMap_eq]
  obtain ⟨E, _, fb, ρ, q, hq, hfbet, hρs, hρker, hcomm, hqeq, ⟨e⟩⟩ :=
    chart W A 𝔭 h (Polynomial ↥W) f (Polynomial (IsLocalRing.ResidueField ↥W))
      (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) hmA hh hf' hfet hπ hker
  have hX : ρ (algebraMap A (Localization.Away h) t) = fb Polynomial.X := by
    rw [← hfX, ← hcomm, Polynomial.coe_mapRingHom, Polynomial.map_X]
  have hqX : q = Ideal.span {fb Polynomial.X} := by
    rw [hqeq, Ideal.map_map, h𝔭eq, Ideal.map_sup, Ideal.map_span, Set.image_singleton]
    have hbot : ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (ρ.comp (algebraMap A (Localization.Away h))) = ⊥ := by
      apply (Ideal.map_eq_bot_iff_le_ker _).mpr
      intro x hx
      rw [RingHom.mem_ker, RingHom.comp_apply, ← RingHom.mem_ker, hρker]
      exact Ideal.mem_map_of_mem _ hx
    rw [hbot, sup_bot_eq, RingHom.comp_apply, hX]
  obtain ⟨_, _⟩ := line (IsLocalRing.ResidueField ↥W) E fb q hfbet hqX
  set mA := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmA_def
  set J := mA.map (algebraMap A (Localization.AtPrime 𝔭)) with hJ_def
  obtain ⟨ψ, hψ⟩ : ∃ ψ : A →+* Localization.AtPrime q,
      ∀ y, ψ y = e (Ideal.Quotient.mk J (algebraMap A (Localization.AtPrime 𝔭) y)) :=
    ⟨e.toRingHom.comp ((Ideal.Quotient.mk J).comp (algebraMap A (Localization.AtPrime 𝔭))),
      fun y => rfl⟩

  have hT : ∀ y : A, ψ y = 0 ↔ ∃ s : A, s ∉ 𝔭 ∧ s * y ∈ mA := by
    intro y
    rw [hψ, map_eq_zero_iff e e.injective, Ideal.Quotient.eq_zero_iff_mem,
      IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔭.primeCompl]
    constructor
    · rintro ⟨m, hm, hmy⟩; exact ⟨m, hm, hmy⟩
    · rintro ⟨m, hm, hmy⟩; exact ⟨m, hm, hmy⟩

  have hU : ∀ y : A, y ∉ 𝔭 → IsUnit (ψ y) := by
    intro y hy
    rw [hψ]
    exact ((IsLocalization.map_units (Localization.AtPrime 𝔭)
      (⟨y, hy⟩ : 𝔭.primeCompl)).map (Ideal.Quotient.mk J)).map e

  have hJmax : J ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
    (Ideal.map_mono hmA).trans (Localization.AtPrime.map_eq_maximalIdeal).le
  have hN : ∀ y : A, y ∈ 𝔭 → ¬ IsUnit (ψ y) := by
    intro y hy hu
    rw [hψ] at hu
    have hu' : IsUnit (Ideal.Quotient.mk J (algebraMap A (Localization.AtPrime 𝔭) y)) := by
      have := hu.map e.symm
      rwa [RingEquiv.symm_apply_apply] at this
    obtain ⟨w, hw⟩ := hu'.exists_right_inv
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w
    rw [← map_mul, ← map_one (Ideal.Quotient.mk J), Ideal.Quotient.eq] at hw
    have hym : algebraMap A (Localization.AtPrime 𝔭) y ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact Ideal.mem_map_of_mem _ hy
    have h1 : (1 : Localization.AtPrime 𝔭) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
      have := Ideal.sub_mem _ (Ideal.mul_mem_right w _ hym) (hJmax hw)
      rwa [sub_sub_cancel] at this
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have hRep : ∀ z : Localization.AtPrime q, ∃ a s : A, s ∉ 𝔭 ∧ z * ψ s = ψ a := by
    intro z
    obtain ⟨w, rfl⟩ := e.surjective z
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl w
    refine ⟨a, s, s.2, ?_⟩
    rw [hψ, hψ, ← map_mul, ← map_mul, IsLocalization.mk'_spec]

  have hmax' : IsLocalRing.maximalIdeal (Localization.AtPrime q) = Ideal.span {ψ t} := by
    apply le_antisymm
    · intro z hz
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz
      obtain ⟨a, s, hs, hzs⟩ := hRep z
      have ha : a ∈ 𝔭 := by
        by_contra ha
        apply hz
        have h1 : IsUnit (z * ψ s) := by rw [hzs]; exact hU a ha
        exact isUnit_of_mul_isUnit_left h1
      rw [h𝔭eq] at ha
      obtain ⟨y, hy, i, hi, rfl⟩ := Submodule.mem_sup.mp ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      have hi0 : ψ i = 0 := (hT i).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
      obtain ⟨v, hv⟩ := (hU s hs).exists_right_inv
      have hz' : z = ψ t * (ψ c * v) := by
        calc z = z * (ψ s * v) := by rw [hv, mul_one]
          _ = (z * ψ s) * v := by ring
          _ = ψ (c * t + i) * v := by rw [hzs]
          _ = ψ t * (ψ c * v) := by rw [map_add, map_mul, hi0]; ring
      rw [hz']
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.span_singleton_le_iff_mem, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact hN t ht𝔭
  refine ⟨fun a b hab => ?_, fun s hs hst => ?_, fun b hb => ?_⟩
  ·
    have h0 : ψ a * ψ b = 0 := by
      rw [← map_mul]; exact (hT _).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
    rcases mul_eq_zero.mp h0 with h0 | h0
    · obtain ⟨s, hs, hsa⟩ := (hT a).mp h0
      exact ⟨s, hs, Or.inl hsa⟩
    · obtain ⟨s, hs, hsb⟩ := (hT b).mp h0
      exact ⟨s, hs, Or.inr hsb⟩
  ·
    have h0 : ψ s * ψ t = 0 := by
      rw [← map_mul]; exact (hT _).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
    have ht0 : ψ t = 0 := (hU s hs).mul_right_eq_zero.mp h0
    have hsp : Ideal.span {(0 : Localization.AtPrime q)} = ⊥ := Ideal.span_singleton_eq_bot.mpr rfl
    rw [ht0, hsp] at hmax'
    exact IsDiscreteValuationRing.not_a_field _ hmax'
  ·
    have hb0 : ψ b ≠ 0 := by
      intro h0
      obtain ⟨s, hs, hsb⟩ := (hT b).mp h0
      exact hb s hs hsb
    have hirr : Irreducible (ψ t) :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax'
    obtain ⟨k, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hirr
    obtain ⟨u₁, s₁, hs₁, hvs⟩ := hRep (v : Localization.AtPrime q)
    have hu₁ : u₁ ∉ 𝔭 := by
      intro h0
      apply hN u₁ h0
      rw [← hvs]
      exact v.isUnit.mul (hU s₁ hs₁)
    have h0 : ψ (s₁ * b - u₁ * t ^ k) = 0 := by
      rw [map_sub, map_mul, map_mul, map_pow, hv, ← hvs]; ring
    obtain ⟨s₂, hs₂, hmem⟩ := (hT _).mp h0
    refine ⟨k, s₂ * u₁, s₂ * s₁, hnot hs₂ hu₁, hnot hs₂ hs₁, ?_⟩
    have hrw : s₂ * s₁ * b - s₂ * u₁ * t ^ k = s₂ * (s₁ * b - u₁ * t ^ k) := by ring
    rw [hrw]
    exact hmem

theorem wcpa_dj_llsm_ssb_fibre_chain : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (𝔭 : Ideal A) (t : A) (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) → y.IsPrime → y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → ∀ 𝔮₀ 𝔮 : Ideal ↥(integralClosure A L), 𝔮₀.IsPrime → 𝔮.IsPrime → 𝔮₀ ≤ 𝔮 → 𝔮 ≤ y → 𝔮 ≠ y → (∀ x ∈ IsLocalRing.maximalIdeal ↥W, algebraMap A ↥(integralClosure A L) (algebraMap ↥W A x) ∈ 𝔮₀) → 𝔮₀ = 𝔮 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ 𝔭 t y hPD hy hyc 𝔮₀ 𝔮 h0P h𝔮P h0le h𝔮y
    h𝔮ne h0m
  classical
  have hk := (wcpa_dj_llsm_kpdf_special_fibre_dvr Ω W hW hWt A 𝔭 t hPD).2.2
  obtain ⟨_, _, _, _, hm𝔭, ht𝔭, h𝔭eq, _⟩ := hPD
  haveI := h0P
  haveI := h𝔮P
  have hP1P : (𝔮₀.comap (algebraMap A ↥(integralClosure A L))).IsPrime := Ideal.IsPrime.comap _
  have hP2P : (𝔮.comap (algebraMap A ↥(integralClosure A L))).IsPrime := Ideal.IsPrime.comap _
  have hmP1 : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
      𝔮₀.comap (algebraMap A ↥(integralClosure A L)) := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, Ideal.mem_comap]
    exact h0m x hx
  have hP12 : 𝔮₀.comap (algebraMap A ↥(integralClosure A L)) ≤
      𝔮.comap (algebraMap A ↥(integralClosure A L)) := Ideal.comap_mono h0le
  have hmP2 := hmP1.trans hP12
  have hP2lt : 𝔮.comap (algebraMap A ↥(integralClosure A L)) < 𝔭 := by
    have h1 : 𝔮 < y := lt_of_le_of_ne h𝔮y h𝔮ne
    have h2 : 𝔮.comap (algebraMap A ↥(integralClosure A L)) <
        y.comap (algebraMap A ↥(integralClosure A L)) := Ideal.IsIntegral.comap_lt_comap h1
    rwa [hyc] at h2
  have hP21 : 𝔮.comap (algebraMap A ↥(integralClosure A L)) ≤
      𝔮₀.comap (algebraMap A ↥(integralClosure A L)) := by
    intro b hb
    have hex : ∃ s : A, s ∉ 𝔭 ∧
        s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by
      by_contra hno
      push_neg at hno
      obtain ⟨k, u, s, hu, hs, hsub⟩ := hk b hno
      have h1 : s * b ∈ 𝔮.comap (algebraMap A ↥(integralClosure A L)) := Ideal.mul_mem_left _ s hb
      have h2 : u * t ^ k ∈ 𝔮.comap (algebraMap A ↥(integralClosure A L)) := by
        have h3 := Ideal.sub_mem _ h1 (hmP2 hsub)
        rwa [sub_sub_cancel] at h3
      rcases hP2P.mem_or_mem h2 with h3 | h3
      · exact hu (hP2lt.le h3)
      · have ht : t ∈ 𝔮.comap (algebraMap A ↥(integralClosure A L)) :=
          hP2P.mem_of_pow_mem k h3
        have h4 : 𝔭 ≤ 𝔮.comap (algebraMap A ↥(integralClosure A L)) := by
          rw [h𝔭eq]
          exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr ht) hmP2
        exact hP2lt.ne (le_antisymm hP2lt.le h4)
    obtain ⟨s, hs, hsb⟩ := hex
    rcases hP1P.mem_or_mem (hmP1 hsb) with h | h
    · exact absurd (hP2lt.le (hP12 h)) hs
    · exact h
  have hP : 𝔮₀.comap (algebraMap A ↥(integralClosure A L)) =
      𝔮.comap (algebraMap A ↥(integralClosure A L)) := le_antisymm hP12 hP21
  by_contra hne
  have hlt : 𝔮₀ < 𝔮 := lt_of_le_of_ne h0le hne
  have h2 : 𝔮₀.comap (algebraMap A ↥(integralClosure A L)) <
      𝔮.comap (algebraMap A ↥(integralClosure A L)) := Ideal.IsIntegral.comap_lt_comap hlt
  exact h2.ne hP

theorem wcpa_dj_llsm_ssb_unibranch_nil : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) → ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 1 → ∀ 𝔮 : Ideal ↥(integralClosure A L), 𝔮.IsPrime → 𝔮 ≤ y → (∀ x ∈ IsLocalRing.maximalIdeal ↥W, algebraMap A ↥(integralClosure A L) (algebraMap ↥W A x) ∈ 𝔮) → (∀ 𝔮₀ : Ideal ↥(integralClosure A L), 𝔮₀.IsPrime → 𝔮₀ ≤ 𝔮 → (∀ x ∈ IsLocalRing.maximalIdeal ↥W, algebraMap A ↥(integralClosure A L) (algebraMap ↥W A x) ∈ 𝔮₀) → 𝔮₀ = 𝔮) → ∀ a ∈ 𝔮, ∃ s : ↥(integralClosure A L), s ∉ y ∧ s * a ∈ Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hbr 𝔮 h𝔮P h𝔮y h𝔮m hmin a ha
  classical
  haveI := hy

  have s5 : ∀ (R : Type u) [CommRing R] [IsReduced R], (minimalPrimes R).Finite →
      wcpaDjLkBranches R = 1 → ∀ p ∈ minimalPrimes R, ∀ q ∈ minimalPrimes R, p = q := by
    intro R _ _ hfin hbr
    classical
    intro p₁ hp₁ p₂ hp₂
    by_contra hne
    have hprime : ∀ p ∈ minimalPrimes R, p.IsPrime := fun p hp => hp.1.1
    have hnil : ∀ w : R, (∀ p ∈ minimalPrimes R, w ∈ p) → w = 0 := by
      intro w hw
      have h1 : w ∈ sInf (minimalPrimes R) := Submodule.mem_sInf.mpr hw
      have h2 : w ∈ (⊥ : Ideal R).radical := by
        rw [← Ideal.sInf_minimalPrimes]; exact h1
      obtain ⟨n, hn⟩ := h2
      exact IsReduced.eq_zero w ⟨n, by simpa using hn⟩
    set s := hfin.toFinset.erase p₁ with hs
    have hp₂s : p₂ ∈ s := Finset.mem_erase.mpr ⟨Ne.symm hne, hfin.mem_toFinset.mpr hp₂⟩
    have hsmin : ∀ p ∈ s, p ∈ minimalPrimes R := fun p hp =>
      hfin.mem_toFinset.mp (Finset.mem_of_mem_erase hp)
    have hsne : ∀ p ∈ s, p ≠ p₁ := fun p hp => Finset.ne_of_mem_erase hp
    have hall : ∀ p ∈ minimalPrimes R, p = p₁ ∨ p ∈ s := by
      intro p hp
      by_cases h : p = p₁
      · exact Or.inl h
      · exact Or.inr (Finset.mem_erase.mpr ⟨h, hfin.mem_toFinset.mpr hp⟩)
    obtain ⟨x, hx1, hxs⟩ : ∃ x ∈ p₁, ∀ p ∈ s, x ∉ p := by
      by_contra h
      push Not at h
      have hsub : (p₁ : Set R) ⊆ ⋃ p ∈ (s : Set (Ideal R)), ((id p : Ideal R) : Set R) := by
        intro x hx
        obtain ⟨p, hp, hxp⟩ := h x hx
        exact Set.mem_biUnion (x := p) hp hxp
      obtain ⟨p, hp, hle⟩ := (Ideal.subset_union_prime (f := id) p₁ p₁
        (fun p hp _ _ => hprime p (hsmin p hp))).mp hsub
      exact hsne p hp (le_antisymm ((hsmin p hp).2 ⟨hprime p₁ hp₁, bot_le⟩ hle) hle)
    obtain ⟨z, hzs, hz1⟩ : ∃ z ∈ s.inf id, z ∉ p₁ := by
      by_contra h
      push Not at h
      have hle : s.inf id ≤ p₁ := fun z hz => h z hz
      rw [(hprime p₁ hp₁).inf_le'] at hle
      obtain ⟨p, hp, hle⟩ := hle
      exact hsne p hp (le_antisymm hle (hp₁.2 ⟨hprime p (hsmin p hp), bot_le⟩ hle))
    have hzp : ∀ p ∈ s, z ∈ p := fun p hp => (Finset.inf_le (f := id) hp) hzs
    have hxz : x * z = 0 := by
      apply hnil
      intro p hp
      rcases hall p hp with h | h
      · rw [h]; exact Ideal.mul_mem_right _ _ hx1
      · exact Ideal.mul_mem_left _ _ (hzp p h)
    have hr : x + z ∈ nonZeroDivisors R := by
      have key : ∀ w : R, w * (x + z) = 0 → w = 0 := by
        intro w hw
        apply hnil
        intro p hp
        have hrp : x + z ∉ p := by
          rcases hall p hp with h | h
          · rw [h]
            intro hr
            apply hz1
            have := p₁.sub_mem hr hx1
            rwa [add_sub_cancel_left] at this
          · intro hr
            apply hxs p h
            have := p.sub_mem hr (hzp p h)
            rwa [add_sub_cancel_right] at this
        rcases (hprime p hp).mem_or_mem (show w * (x + z) ∈ p by rw [hw]; exact p.zero_mem) with h | h
        · exact h
        · exact absurd h hrp
      rw [mem_nonZeroDivisors_iff]
      exact ⟨fun w hw => key w (by rw [mul_comm]; exact hw), key⟩
    set e : FractionRing R := IsLocalization.mk' (FractionRing R) z ⟨x + z, hr⟩ with he
    have hee : e * e = e := by
      rw [he, ← IsLocalization.mk'_mul, IsLocalization.mk'_eq_iff_eq]
      congr 1
      simp only [Submonoid.coe_mul]
      linear_combination (-(x + z)) * hxz
    have he0 : e ≠ 0 := by
      intro h
      rw [he, IsLocalization.mk'_eq_zero_iff] at h
      obtain ⟨⟨m, hm⟩, hmz⟩ := h
      rw [mem_nonZeroDivisors_iff] at hm
      have : z = 0 := hm.1 z hmz
      exact hz1 (this ▸ p₁.zero_mem)
    have he1 : e ≠ 1 := by
      intro h
      rw [he, ← IsLocalization.mk'_self' (FractionRing R) (x := (⟨x + z, hr⟩ : nonZeroDivisors R)),
        IsLocalization.mk'_eq_iff_eq] at h
      have h' := IsFractionRing.injective R (FractionRing R) h
      change (x + z) * z = (x + z) * (x + z) at h'
      have hxx : x * x = 0 := by linear_combination -h' - hxz
      have hx0 : x = 0 := IsReduced.eq_zero x ⟨2, by rw [sq]; exact hxx⟩
      exact hxs p₂ hp₂s (hx0 ▸ p₂.zero_mem)
    haveI : Nontrivial R := ⟨⟨0, 1, fun h => (hprime p₁ hp₁).ne_top
      ((Ideal.eq_top_iff_one _).mpr (by rw [← h]; exact p₁.zero_mem))⟩⟩
    have hint : IsIntegral R e := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X, Polynomial.monic_X_pow_sub ?_, ?_⟩
      · rw [Polynomial.degree_X]; norm_num
      · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, sq, hee, sub_self]
    set ε : ↥(integralClosure R (FractionRing R)) := ⟨e, hint⟩ with hε
    have hεε : ε * (1 - ε) = 0 := by
      apply Subtype.ext
      show e * (1 - e) = 0
      rw [mul_sub, mul_one, hee, sub_self]
    have hε0 : ε ≠ 0 := fun h => he0 (congrArg Subtype.val h)
    have hε1 : 1 - ε ≠ 0 := fun h => he1 (by
      have := congrArg Subtype.val h
      change (1 : FractionRing R) - e = 0 at this
      exact (sub_eq_zero.mp this).symm)
    have hnu1 : ε ∈ nonunits _ := fun hu => hε1 ((hu.mul_right_eq_zero).mp hεε)
    have hnu2 : (1 - ε) ∈ nonunits _ := fun hu =>
      hε0 ((hu.mul_left_eq_zero).mp hεε)
    obtain ⟨M₁, hM₁, hεM₁⟩ := exists_max_ideal_of_mem_nonunits hnu1
    obtain ⟨M₂, hM₂, hεM₂⟩ := exists_max_ideal_of_mem_nonunits hnu2
    have hM : M₁ ≠ M₂ := by
      intro h
      rw [← h] at hεM₂
      have := M₁.add_mem hεM₁ hεM₂
      rw [add_sub_cancel] at this
      exact hM₁.ne_top ((Ideal.eq_top_iff_one _).mpr this)
    have hnt : Nontrivial (MaximalSpectrum ↥(integralClosure R (FractionRing R))) :=
      ⟨⟨⟨M₁, hM₁⟩, ⟨M₂, hM₂⟩, fun h => hM (congrArg MaximalSpectrum.asIdeal h)⟩⟩
    have := (ENat.one_lt_card_iff_nontrivial _).mpr hnt
    unfold wcpaDjLkBranches at hbr
    rw [hbr] at this
    exact lt_irrefl _ this

  have reduced_fibre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
      ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
      (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
      ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
        IsReduced (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) := by
    intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy _
    classical
    obtain ⟨_, hNZ, _⟩ := hPD

    have hWA : Function.Injective (algebraMap ↥W A) := by
      intro a b hab
      have h1 : (a - b) • (1 : A) = 0 := by
        rw [sub_smul, ← Algebra.algebraMap_eq_smul_one, ← Algebra.algebraMap_eq_smul_one, hab,
          sub_self]
      rcases smul_eq_zero.mp h1 with h | h
      · exact sub_eq_zero.mp h
      · exact absurd h one_ne_zero
    have hAL : Function.Injective (algebraMap A L) := by
      rw [IsScalarTower.algebraMap_eq A K L]
      exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
    have hwLinj : Function.Injective ((algebraMap A L).comp (algebraMap ↥W A)) := hAL.comp hWA

    have hint : ∀ u : ↥W, _root_.IsIntegral A (((algebraMap A L).comp (algebraMap ↥W A)) u) :=
      fun u => isIntegral_algebraMap
    let emb : ↥W → ↥(integralClosure A L) := fun u =>
      ⟨((algebraMap A L).comp (algebraMap ↥W A)) u, hint u⟩

    have hform : ∀ x ∈ Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w},
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ c : ↥(integralClosure A L),
          (x : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w * (c : L) := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨w, hw, hxw⟩ := hx
        exact ⟨w, hw, 1, by rw [hxw, OneMemClass.coe_one, mul_one]⟩
      | zero => exact ⟨0, Ideal.zero_mem _, 0, by simp⟩
      | add x z _ _ hx hz =>
        obtain ⟨w₁, hw₁, c₁, h₁⟩ := hx
        obtain ⟨w₂, hw₂, c₂, h₂⟩ := hz
        rcases ValuationRing.dvd_total w₁ w₂ with ⟨e, he⟩ | ⟨e, he⟩
        · refine ⟨w₁, hw₁, c₁ + emb e * c₂, ?_⟩
          rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, he, map_mul]
          show _ = _ * (_ + ((algebraMap A L).comp (algebraMap ↥W A)) e * _)
          ring
        · refine ⟨w₂, hw₂, emb e * c₁ + c₂, ?_⟩
          rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, he, map_mul]
          show _ = _ * (((algebraMap A L).comp (algebraMap ↥W A)) e * _ + _)
          ring
      | smul a x _ hx =>
        obtain ⟨w, hw, c, h⟩ := hx
        refine ⟨w, hw, a * c, ?_⟩
        rw [smul_eq_mul, MulMemClass.coe_mul, h, MulMemClass.coe_mul]
        ring

    have hroot : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ n : ℕ, 0 < n →
        ∃ π ∈ IsLocalRing.maximalIdeal ↥W, π ^ n = w := by
      intro w hw n hn
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hw
      by_cases h : z ∈ W
      · have hπ : (⟨z, h⟩ : ↥W) ^ n = w := Subtype.ext (by simp [hz])
        refine ⟨⟨z, h⟩, ?_, hπ⟩
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        exact hw (hπ ▸ hu.pow n)
      · exfalso
        have hz0 : z ≠ 0 := by
          rintro rfl
          exact h W.zero_mem
        have hzi : z⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left h
        have hv : w * (⟨z⁻¹, hzi⟩ : ↥W) ^ n = 1 := by
          apply Subtype.ext
          simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one]
          rw [← hz, ← mul_pow, mul_inv_cancel₀ hz0, one_pow]
        exact hw (IsUnit.of_mul_eq_one _ hv)

    have hrad : ∀ (b : ↥(integralClosure A L)) (n : ℕ), b ^ n ∈ Ideal.span
        {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} →
        b ∈ Ideal.span {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} := by
      intro b n hbn
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [pow_zero] at hbn
        simpa using Ideal.mul_mem_left _ b hbn
      obtain ⟨w, hw, c, hc⟩ := hform _ hbn
      rw [SubmonoidClass.coe_pow] at hc
      by_cases hw0 : w = 0
      · have h0 : (b : L) ^ n = 0 := by rw [hc, hw0, map_zero, zero_mul]
        have hb0 : b = 0 := Subtype.ext (by
          rw [ZeroMemClass.coe_zero]; exact (pow_eq_zero_iff hn.ne').mp h0)
        rw [hb0]
        exact Ideal.zero_mem _
      obtain ⟨π, hπ, hπn⟩ := hroot w hw n hn
      have hwL0 : ((algebraMap A L).comp (algebraMap ↥W A)) w ≠ 0 := by
        intro h
        exact hw0 ((map_eq_zero_iff _ hwLinj).mp h)
      have hπ0 : ((algebraMap A L).comp (algebraMap ↥W A)) π ≠ 0 := by
        intro h
        apply hw0
        rw [← hπn, (map_eq_zero_iff _ hwLinj).mp h, zero_pow hn.ne']
      have hξ : ((b : L) / ((algebraMap A L).comp (algebraMap ↥W A)) π) ^ n = (c : L) := by
        rw [div_pow, hc, ← map_pow, hπn]
        exact mul_div_cancel_left₀ _ hwL0
      have hξint : _root_.IsIntegral A
          ((b : L) / ((algebraMap A L).comp (algebraMap ↥W A)) π) :=
        _root_.IsIntegral.of_pow hn (by rw [hξ]; exact c.2)
      have hmem : emb π * ⟨_, hξint⟩ ∈ Ideal.span {b : ↥(integralClosure A L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
            (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} :=
        Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨π, hπ, rfl⟩)
      have hbeq : b = emb π * ⟨_, hξint⟩ := by
        apply Subtype.ext
        rw [MulMemClass.coe_mul]
        show (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) π *
          ((b : L) / ((algebraMap A L).comp (algebraMap ↥W A)) π)
        rw [mul_div_cancel₀ _ hπ0]
      rw [hbeq]
      exact hmem

    unfold wcLlsFS
    refine ⟨fun x hx => ?_⟩
    obtain ⟨n, hn⟩ := hx
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl x
    rw [← map_pow, ← IsLocalization.mk'_pow, Ideal.Quotient.eq_zero_iff_mem,
      IsLocalization.mk'_mem_map_algebraMap_iff] at hn
    obtain ⟨s', hs', hs'a⟩ := hn
    rw [Ideal.Quotient.eq_zero_iff_mem, IsLocalization.mk'_mem_map_algebraMap_iff]
    rcases Nat.eq_zero_or_pos n with rfl | hpos
    · refine ⟨s', hs', ?_⟩
      rw [pow_zero, mul_one] at hs'a
      exact Ideal.mul_mem_right _ _ hs'a
    · refine ⟨s', hs', hrad _ n ?_⟩
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      have he : (s' * a) ^ (m + 1) = s' ^ m * (s' * a ^ (m + 1)) := by ring
      rw [he]
      exact Ideal.mul_mem_left _ _ hs'a

  have kpdf : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
      ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A),
      wcLlsPD W A 𝔭 (.disc t) →
      (∀ a b : A, a * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
        ∃ s : A, s ∉ 𝔭 ∧ (s * a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ∨
          s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A))) ∧
      (∀ s : A, s ∉ 𝔭 → s * t ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) ∧
      ∀ b : A, (∀ s : A, s ∉ 𝔭 → s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)) →
        ∃ (k : ℕ) (u s : A), u ∉ 𝔭 ∧ s ∉ 𝔭 ∧
          s * b - u * t ^ k ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) := by


    have chart : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
        (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (h : A)
        (S : Type u) [CommRing S] [Algebra ↥W S] (f₀ : S →+* Localization.Away h)
        (P : Type u) [CommRing P] (π : S →+* P),
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭 → h ∉ 𝔭 →
        f₀.comp (algebraMap ↥W S) =
          (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) →
        RingHom.Etale f₀ → Function.Surjective π →
        RingHom.ker π = (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S) →
        ∃ (E : Type u) (_ : CommRing E) (fb : P →+* E)
          (ρ : Localization.Away h →+* E) (q : Ideal E) (_ : q.IsPrime),
          RingHom.Etale fb ∧ Function.Surjective ρ ∧
          RingHom.ker ρ = ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.Away h)) ∧
          (∀ s, fb (π s) = ρ (f₀ s)) ∧
          q = (𝔭.map (algebraMap A (Localization.Away h))).map ρ ∧
          Nonempty ((Localization.AtPrime 𝔭 ⧸
            ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
              (algebraMap A (Localization.AtPrime 𝔭))) ≃+* Localization.AtPrime q) := by
      intro Ω _ W A _ _ 𝔭 _ h S _ _ f₀ P _ π hm hh hf het hπ hker
      have hK : (RingHom.ker π).map f₀ = ((IsLocalRing.maximalIdeal ↥W).map
          (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) := by
        rw [hker, Ideal.map_map, hf, ← Ideal.map_map]
      have s1 : ∃ fb : P →+* Localization.Away h ⧸ ((IsLocalRing.maximalIdeal ↥W).map
            (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)),
          RingHom.Etale fb ∧ ∀ s, fb (π s) = Ideal.Quotient.mk _ (f₀ s) := by
        generalize ((IsLocalRing.maximalIdeal ↥W).map
          (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) = K at hK ⊢
        letI := f₀.toAlgebra
        haveI : Algebra.Etale S (Localization.Away h) := het
        set J := RingHom.ker π with hJ
        have h1 : RingHom.Etale (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))) :=
          RingHom.etale_algebraMap.mpr inferInstance
        let e₁ : TensorProduct S (S ⧸ J) (Localization.Away h) ≃+*
            Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) :=
          (Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h)).toRingEquiv.trans
            (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm.toRingEquiv
        let e₂ : Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) ≃+*
            Localization.Away h ⧸ K := Ideal.quotEquivOfEq hK
        let e := e₁.trans e₂
        let g := e.toRingHom.comp (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h)))
        have hg : RingHom.Etale g := RingHom.Etale.respectsIso.1 _ _ h1
        let fb := g.comp (RingHom.quotientKerEquivOfSurjective hπ).symm.toRingHom
        have hfb : RingHom.Etale fb := RingHom.Etale.respectsIso.2 _ _ hg
        refine ⟨fb, hfb, fun s => ?_⟩
        have hs : (RingHom.quotientKerEquivOfSurjective hπ).symm (π s) = Ideal.Quotient.mk J s :=
          RingHom.quotientKerEquivOfSurjective_symm_apply hπ s
        show e₂ (e₁ (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))
          ((RingHom.quotientKerEquivOfSurjective hπ).symm (π s)))) = _
        rw [hs, Algebra.TensorProduct.algebraMap_apply]
        show e₂ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm
          ((Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h))
            (_ ⊗ₜ[S] (1 : Localization.Away h)))) = _
        rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply,
          Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
        rw [Algebra.smul_def, mul_one]
        rfl
      set 𝔞 : Ideal A := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with h𝔞d
      have h𝔞 : 𝔞 ≤ 𝔭 := hm
      have hdisj : Disjoint (Submonoid.powers h : Set A) 𝔭 := by
        rw [Set.disjoint_left]
        rintro x ⟨n, rfl⟩ hx
        exact hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hx)
      have hhn : ∀ n : ℕ, h ^ n ∉ 𝔭 := fun n hn => hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hn)
      have hQp : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 ‹_› hdisj
      have hq : ((𝔭.map (algebraMap A (Localization.Away h))).map
          (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h))))).IsPrime := by
        apply Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        rw [Ideal.mk_ker]
        exact Ideal.map_mono h𝔞
      have s3 : Nonempty ((Localization.AtPrime 𝔭 ⧸ 𝔞.map (algebraMap A (Localization.AtPrime 𝔭))) ≃+*
          Localization.AtPrime ((𝔭.map (algebraMap A (Localization.Away h))).map
            (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h)))))) := by
        have hQc : (𝔭.map (algebraMap A (Localization.Away h))).comap
            (algebraMap A (Localization.Away h)) = 𝔭 :=
          IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
        set I : Ideal (Localization.Away h) := 𝔞.map (algebraMap A (Localization.Away h)) with hI
        set Q : Ideal (Localization.Away h) := 𝔭.map (algebraMap A (Localization.Away h)) with hQ
        set q : Ideal (Localization.Away h ⧸ I) := Q.map (Ideal.Quotient.mk I) with hqdef
        have hIQ : I ≤ Q := Ideal.map_mono h𝔞
        have hK1 : q.comap (Ideal.Quotient.mk I) = Q := by
          rw [hqdef, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
            ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
          exact sup_eq_left.mpr hIQ
        have hK2 : ∀ a : A, Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a) ∈ q ↔ a ∈ 𝔭 := by
          intro a
          rw [← Ideal.mem_comap, hK1, ← Ideal.mem_comap, hQc]
        have hunit : ∀ y : 𝔭.primeCompl, IsUnit (((algebraMap (Localization.Away h ⧸ I)
            (Localization.AtPrime q)).comp ((Ideal.Quotient.mk I).comp
              (algebraMap A (Localization.Away h)))) y) := by
          intro y
          exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q _).mpr
            (fun hm => y.2 ((hK2 y).mp hm))
        have hK3 : ∀ t : Localization.Away h ⧸ I, t ∉ q → ∃ (y : Localization.Away h) (m : ℕ) (b : A),
            Ideal.Quotient.mk I y = t ∧
            y * algebraMap A (Localization.Away h) h ^ m = algebraMap A (Localization.Away h) b ∧
            b ∉ 𝔭 := by
          intro t ht
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective t
          obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj h y
          refine ⟨y, m, b, rfl, hb, ?_⟩
          intro hb𝔭
          have h1 : algebraMap A (Localization.Away h) b ∈ Q := Ideal.mem_map_of_mem _ hb𝔭
          rw [← hb] at h1
          rcases hQp.mem_or_mem h1 with h2 | h2
          · exact ht (Ideal.mem_map_of_mem _ h2)
          · rw [← map_pow, ← Ideal.mem_comap, hQc] at h2
            exact hhn m h2
        let θ := IsLocalization.lift (M := 𝔭.primeCompl) (S := Localization.AtPrime 𝔭) hunit
        have hsurj : Function.Surjective θ := by
          intro z
          obtain ⟨⟨e, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
          obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective e
          obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj h x
          have hs0 : b * h ^ n ∈ 𝔭.primeCompl := fun hm =>
            (Ideal.IsPrime.mem_or_mem ‹_› hm).elim hb (hhn n)
          refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔭) (a * h ^ m) ⟨b * h ^ n, hs0⟩, ?_⟩
          rw [IsLocalization.lift_mk'_spec]
          have hZ := IsLocalization.mk'_spec (Localization.AtPrime q) (Ideal.Quotient.mk I x) t
          rw [← hy] at hZ
          simp only [RingHom.comp_apply, map_mul, map_pow]
          rw [← ha, ← hyb]
          simp only [map_mul, map_pow]
          rw [← hZ]
          ring
        have hkerθ : RingHom.ker θ = 𝔞.map (algebraMap A (Localization.AtPrime 𝔭)) := by
          apply le_antisymm
          · intro w hw
            rw [RingHom.mem_ker] at hw
            obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl w
            rw [IsLocalization.lift_mk'_spec, mul_zero] at hw
            obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q)
              (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a))).mp hw
            obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
            have e1 : Ideal.Quotient.mk I (algebraMap A (Localization.Away h) b) =
                ↑t * Ideal.Quotient.mk I (algebraMap A (Localization.Away h) h ^ m) := by
              rw [← hyb, map_mul, hy]
            have e2 : Ideal.Quotient.mk I (algebraMap A (Localization.Away h) (b * a)) = 0 := by
              rw [map_mul, map_mul, e1]
              linear_combination (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) h ^ m)) * ht
            rw [Ideal.Quotient.eq_zero_iff_mem] at e2
            obtain ⟨c, ⟨k, rfl⟩, hc⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
              (Submonoid.powers h) (Localization.Away h) 𝔞 (b * a)).mp e2
            rw [IsLocalization.mk'_mem_map_algebraMap_iff 𝔭.primeCompl]
            refine ⟨h ^ k * b, fun hm => (Ideal.IsPrime.mem_or_mem ‹_› hm).elim (hhn k) hb, ?_⟩
            rw [mul_assoc]
            exact hc
          · rw [Ideal.map_le_iff_le_comap]
            intro x hx
            rw [Ideal.mem_comap, RingHom.mem_ker, IsLocalization.lift_eq]
            show algebraMap (Localization.Away h ⧸ I) (Localization.AtPrime q)
              (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) x)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hx), map_zero]
        exact ⟨(Ideal.quotEquivOfEq hkerθ.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)⟩
      obtain ⟨fb, hfb, hfbπ⟩ := s1
      exact ⟨_, inferInstance, fb, Ideal.Quotient.mk _, _, hq, hfb, Ideal.Quotient.mk_surjective,
        Ideal.mk_ker, hfbπ, rfl, s3⟩

    have line : ∀ (k E : Type u) [Field k] [CommRing E]
        (f : Polynomial k →+* E) (q : Ideal E) [q.IsPrime],
        RingHom.Etale f → q = Ideal.span {f Polynomial.X} →
        ∃ _ : IsDomain (Localization.AtPrime q), IsDiscreteValuationRing (Localization.AtPrime q) := by
      intro k E _ _ f q _ hf hq
      letI := f.toAlgebra
      haveI : Algebra.Etale (Polynomial k) E := RingHom.Etale.toAlgebra hf
      haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing (Polynomial k) E
      have hreg : IsSMulRegular E (algebraMap (Polynomial k) E Polynomial.X) := by
        apply IsSMulRegular.of_flat
        intro a b h
        exact mul_left_cancel₀ Polynomial.X_ne_zero h
      haveI : IsNoetherianRing (Localization.AtPrime q) :=
        IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) inferInstance
      haveI : Module.Flat E (Localization.AtPrime q) :=
        IsLocalization.flat (Localization.AtPrime q) q.primeCompl
      have hm : IsLocalRing.maximalIdeal (Localization.AtPrime q) =
          Ideal.span {algebraMap E (Localization.AtPrime q) (f Polynomial.X)} := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal,
          congrArg (Ideal.map (algebraMap E (Localization.AtPrime q))) hq, Ideal.map_span,
          Set.image_singleton]
      have hτ : IsSMulRegular (Localization.AtPrime q)
          (algebraMap E (Localization.AtPrime q) (f Polynomial.X)) :=
        IsSMulRegular.of_flat (S := Localization.AtPrime q) hreg
      generalize algebraMap E (Localization.AtPrime q) (f Polynomial.X) = τ at hm hτ
      have hτc : ∀ n : ℕ, ∀ a b : Localization.AtPrime q, τ ^ n * a = τ ^ n * b → a = b := by
        intro n
        induction n with
        | zero => intro a b h; simpa using h
        | succ n ih =>
          intro a b h
          apply ih
          apply hτ
          simp only [smul_eq_mul]
          rw [pow_succ] at h
          calc τ * (τ ^ n * a) = τ ^ n * τ * a := by ring
            _ = τ ^ n * τ * b := h
            _ = τ * (τ ^ n * b) := by ring
      have hτn : ∀ n, τ ^ n ≠ 0 := fun n h => one_ne_zero (hτc n 1 0 (by rw [h]; simp))
      have hK : ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      have hfac : ∀ x : Localization.AtPrime q, x ≠ 0 →
          ∃ n : ℕ, ∃ u : Localization.AtPrime q, IsUnit u ∧ x = τ ^ n * u := by
        intro x hx
        classical
        have hex : ∃ n, x ∉ Ideal.span {τ ^ n} := by
          by_contra hcon
          push_neg at hcon
          apply hx
          have : x ∈ ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i := by
            rw [Ideal.mem_iInf]
            intro i
            rw [hm, Ideal.span_singleton_pow]
            exact hcon i
          rw [hK] at this
          exact this
        have hN : x ∉ Ideal.span {τ ^ Nat.find hex} := Nat.find_spec hex
        have hN0 : Nat.find hex ≠ 0 := by
          intro h0
          apply hN
          rw [h0, pow_zero, Ideal.span_singleton_one]
          trivial
        obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hN0
        have hxn : x ∈ Ideal.span {τ ^ n} := by
          by_contra h
          have := Nat.find_min' hex h
          omega
        obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hxn
        refine ⟨n, u, ?_, by rw [← hu, mul_comm]⟩
        by_contra hu'
        have hum : u ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
          (IsLocalRing.mem_maximalIdeal u).mpr hu'
        rw [hm] at hum
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hum
        apply hN
        rw [Ideal.mem_span_singleton']
        exact ⟨w, by rw [hn, pow_succ, ← hu, ← hw]; ring⟩
      haveI : NoZeroDivisors (Localization.AtPrime q) := by
        constructor
        intro x y hxy
        by_contra h
        push_neg at h
        obtain ⟨a, u, hu, rfl⟩ := hfac x h.1
        obtain ⟨b, v, hv, rfl⟩ := hfac y h.2
        have h2 : τ ^ (a + b) * (u * v) = 0 := by
          rw [pow_add]
          calc τ ^ a * τ ^ b * (u * v) = τ ^ a * u * (τ ^ b * v) := by ring
            _ = 0 := hxy
        exact hτn (a + b) ((hu.mul hv).mul_left_eq_zero.mp h2)
      haveI : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
      refine ⟨inferInstance, ?_⟩
      have hnf : ¬ IsField (Localization.AtPrime q) := by
        intro hF
        have h1 := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
        have hτm : τ ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          rw [hm]; exact Ideal.subset_span rfl
        rw [h1] at hτm
        exact hτn 1 (by simpa using hτm)
      have hP : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (Localization.AtPrime q)) :=
        ⟨⟨τ, hm⟩⟩
      exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime q) hnf).out 5 1).mp hP

    intro Ω _ _ W _ _ A _ _ _ 𝔭 t hPD
    obtain ⟨_, _, _, hmax, hmA, ht𝔭, h𝔭eq, h, hh, f, hfC, hfX, hfet⟩ := hPD
    haveI : 𝔭.IsPrime := hmax.isPrime
    have h1𝔭 : (1 : A) ∉ 𝔭 := (Ideal.ne_top_iff_one 𝔭).mp hmax.ne_top
    have hnot : ∀ {x y : A}, x ∉ 𝔭 → y ∉ 𝔭 → x * y ∉ 𝔭 := fun hx hy hxy =>
      (hmax.isPrime.mem_or_mem hxy).elim hx hy
    have hf' : f.comp (algebraMap ↥W (Polynomial ↥W)) =
        (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A) := by
      rw [Polynomial.algebraMap_eq]; exact hfC
    have hπ : Function.Surjective (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) := by
      rw [Polynomial.coe_mapRingHom]
      exact Polynomial.map_surjective _ IsLocalRing.residue_surjective
    have hker : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) =
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (Polynomial ↥W)) := by
      rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, Polynomial.algebraMap_eq]
    obtain ⟨E, _, fb, ρ, q, hq, hfbet, hρs, hρker, hcomm, hqeq, ⟨e⟩⟩ :=
      chart W A 𝔭 h (Polynomial ↥W) f (Polynomial (IsLocalRing.ResidueField ↥W))
        (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) hmA hh hf' hfet hπ hker
    have hX : ρ (algebraMap A (Localization.Away h) t) = fb Polynomial.X := by
      rw [← hfX, ← hcomm, Polynomial.coe_mapRingHom, Polynomial.map_X]
    have hqX : q = Ideal.span {fb Polynomial.X} := by
      rw [hqeq, Ideal.map_map, h𝔭eq, Ideal.map_sup, Ideal.map_span, Set.image_singleton]
      have hbot : ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
          (ρ.comp (algebraMap A (Localization.Away h))) = ⊥ := by
        apply (Ideal.map_eq_bot_iff_le_ker _).mpr
        intro x hx
        rw [RingHom.mem_ker, RingHom.comp_apply, ← RingHom.mem_ker, hρker]
        exact Ideal.mem_map_of_mem _ hx
      rw [hbot, sup_bot_eq, RingHom.comp_apply, hX]
    obtain ⟨_, _⟩ := line (IsLocalRing.ResidueField ↥W) E fb q hfbet hqX
    set mA := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with hmA_def
    set J := mA.map (algebraMap A (Localization.AtPrime 𝔭)) with hJ_def
    obtain ⟨ψ, hψ⟩ : ∃ ψ : A →+* Localization.AtPrime q,
        ∀ y, ψ y = e (Ideal.Quotient.mk J (algebraMap A (Localization.AtPrime 𝔭) y)) :=
      ⟨e.toRingHom.comp ((Ideal.Quotient.mk J).comp (algebraMap A (Localization.AtPrime 𝔭))),
        fun y => rfl⟩

    have hT : ∀ y : A, ψ y = 0 ↔ ∃ s : A, s ∉ 𝔭 ∧ s * y ∈ mA := by
      intro y
      rw [hψ, map_eq_zero_iff e e.injective, Ideal.Quotient.eq_zero_iff_mem,
        IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔭.primeCompl]
      constructor
      · rintro ⟨m, hm, hmy⟩; exact ⟨m, hm, hmy⟩
      · rintro ⟨m, hm, hmy⟩; exact ⟨m, hm, hmy⟩

    have hU : ∀ y : A, y ∉ 𝔭 → IsUnit (ψ y) := by
      intro y hy
      rw [hψ]
      exact ((IsLocalization.map_units (Localization.AtPrime 𝔭)
        (⟨y, hy⟩ : 𝔭.primeCompl)).map (Ideal.Quotient.mk J)).map e

    have hJmax : J ≤ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
      (Ideal.map_mono hmA).trans (Localization.AtPrime.map_eq_maximalIdeal).le
    have hN : ∀ y : A, y ∈ 𝔭 → ¬ IsUnit (ψ y) := by
      intro y hy hu
      rw [hψ] at hu
      have hu' : IsUnit (Ideal.Quotient.mk J (algebraMap A (Localization.AtPrime 𝔭) y)) := by
        have := hu.map e.symm
        rwa [RingEquiv.symm_apply_apply] at this
      obtain ⟨w, hw⟩ := hu'.exists_right_inv
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w
      rw [← map_mul, ← map_one (Ideal.Quotient.mk J), Ideal.Quotient.eq] at hw
      have hym : algebraMap A (Localization.AtPrime 𝔭) y ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact Ideal.mem_map_of_mem _ hy
      have h1 : (1 : Localization.AtPrime 𝔭) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
        have := Ideal.sub_mem _ (Ideal.mul_mem_right w _ hym) (hJmax hw)
        rwa [sub_sub_cancel] at this
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

    have hRep : ∀ z : Localization.AtPrime q, ∃ a s : A, s ∉ 𝔭 ∧ z * ψ s = ψ a := by
      intro z
      obtain ⟨w, rfl⟩ := e.surjective z
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl w
      refine ⟨a, s, s.2, ?_⟩
      rw [hψ, hψ, ← map_mul, ← map_mul, IsLocalization.mk'_spec]

    have hmax' : IsLocalRing.maximalIdeal (Localization.AtPrime q) = Ideal.span {ψ t} := by
      apply le_antisymm
      · intro z hz
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz
        obtain ⟨a, s, hs, hzs⟩ := hRep z
        have ha : a ∈ 𝔭 := by
          by_contra ha
          apply hz
          have h1 : IsUnit (z * ψ s) := by rw [hzs]; exact hU a ha
          exact isUnit_of_mul_isUnit_left h1
        rw [h𝔭eq] at ha
        obtain ⟨y, hy, i, hi, rfl⟩ := Submodule.mem_sup.mp ha
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
        have hi0 : ψ i = 0 := (hT i).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
        obtain ⟨v, hv⟩ := (hU s hs).exists_right_inv
        have hz' : z = ψ t * (ψ c * v) := by
          calc z = z * (ψ s * v) := by rw [hv, mul_one]
            _ = (z * ψ s) * v := by ring
            _ = ψ (c * t + i) * v := by rw [hzs]
            _ = ψ t * (ψ c * v) := by rw [map_add, map_mul, hi0]; ring
        rw [hz']
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      · rw [Ideal.span_singleton_le_iff_mem, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact hN t ht𝔭
    refine ⟨fun a b hab => ?_, fun s hs hst => ?_, fun b hb => ?_⟩
    ·
      have h0 : ψ a * ψ b = 0 := by
        rw [← map_mul]; exact (hT _).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
      rcases mul_eq_zero.mp h0 with h0 | h0
      · obtain ⟨s, hs, hsa⟩ := (hT a).mp h0
        exact ⟨s, hs, Or.inl hsa⟩
      · obtain ⟨s, hs, hsb⟩ := (hT b).mp h0
        exact ⟨s, hs, Or.inr hsb⟩
    ·
      have h0 : ψ s * ψ t = 0 := by
        rw [← map_mul]; exact (hT _).mpr ⟨1, h1𝔭, by rwa [one_mul]⟩
      have ht0 : ψ t = 0 := (hU s hs).mul_right_eq_zero.mp h0
      have hsp : Ideal.span {(0 : Localization.AtPrime q)} = ⊥ := Ideal.span_singleton_eq_bot.mpr rfl
      rw [ht0, hsp] at hmax'
      exact IsDiscreteValuationRing.not_a_field _ hmax'
    ·
      have hb0 : ψ b ≠ 0 := by
        intro h0
        obtain ⟨s, hs, hsb⟩ := (hT b).mp h0
        exact hb s hs hsb
      have hirr : Irreducible (ψ t) :=
        (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax'
      obtain ⟨k, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hirr
      obtain ⟨u₁, s₁, hs₁, hvs⟩ := hRep (v : Localization.AtPrime q)
      have hu₁ : u₁ ∉ 𝔭 := by
        intro h0
        apply hN u₁ h0
        rw [← hvs]
        exact v.isUnit.mul (hU s₁ hs₁)
      have h0 : ψ (s₁ * b - u₁ * t ^ k) = 0 := by
        rw [map_sub, map_mul, map_mul, map_pow, hv, ← hvs]; ring
      obtain ⟨s₂, hs₂, hmem⟩ := (hT _).mp h0
      refine ⟨k, s₂ * u₁, s₂ * s₁, hnot hs₂ hu₁, hnot hs₂ hs₁, ?_⟩
      have hrw : s₂ * s₁ * b - s₂ * u₁ * t ^ k = s₂ * (s₁ * b - u₁ * t ^ k) := by ring
      rw [hrw]
      exact hmem

  have G : ∀ (Bg : Type u) [CommRing Bg] (yg : Ideal Bg) [yg.IsPrime] (Ig qg : Ideal Bg),
      IsReduced (Localization.AtPrime yg ⧸ Ig.map (algebraMap Bg (Localization.AtPrime yg))) →
      wcpaDjLkBranches (Localization.AtPrime yg ⧸
        Ig.map (algebraMap Bg (Localization.AtPrime yg))) = 1 →
      {Q : Ideal Bg | Q.IsPrime ∧ Ig ≤ Q ∧ Q ≤ yg}.Finite →
      qg.IsPrime → Ig ≤ qg → qg ≤ yg →
      (∀ Q : Ideal Bg, Q.IsPrime → Ig ≤ Q → Q ≤ qg → Q = qg) →
      ∀ a ∈ qg, ∃ s : Bg, s ∉ yg ∧ s * a ∈ Ig := by
    intro Bg _ yg _ Ig qg hred hbr1 hS hqP hIq hqy hqmin a ha
    set ℓ := algebraMap Bg (Localization.AtPrime yg) with hℓ
    set J := Ig.map ℓ with hJ
    set q : Localization.AtPrime yg →+* Localization.AtPrime yg ⧸ J := Ideal.Quotient.mk J with hq
    set π : Bg →+* Localization.AtPrime yg ⧸ J := q.comp ℓ with hπ

    have P1 : ∀ Q : Ideal Bg, Q.IsPrime → Ig ≤ Q → Q ≤ yg →
        (Ideal.map π Q).IsPrime ∧ Ideal.comap π (Ideal.map π Q) = Q := by
      intro Q hQ hIQ hQy
      have hdisj : Disjoint (yg.primeCompl : Set Bg) (Q : Set Bg) :=
        Set.disjoint_left.mpr fun s hs hsQ => hs (hQy hsQ)
      haveI hQ' : (Ideal.map ℓ Q).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint yg.primeCompl _ Q hQ hdisj
      have hc1 : Ideal.comap ℓ (Ideal.map ℓ Q) = Q :=
        IsLocalization.comap_map_of_isPrime_disjoint yg.primeCompl _ hQ hdisj
      have hJQ : J ≤ Ideal.map ℓ Q := Ideal.map_mono hIQ
      have hker : RingHom.ker q = J := Ideal.mk_ker
      have hP : (Ideal.map q (Ideal.map ℓ Q)).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [hker]; exact hJQ)
      have hc2 : Ideal.comap q (Ideal.map q (Ideal.map ℓ Q)) = Ideal.map ℓ Q := by
        rw [Ideal.comap_map_of_surjective' q Ideal.Quotient.mk_surjective, hker]
        exact sup_eq_left.mpr hJQ
      refine ⟨?_, ?_⟩
      · rw [hπ, ← Ideal.map_map]; exact hP
      · rw [hπ, ← Ideal.map_map, ← Ideal.comap_comap, hc2, hc1]

    have P2 : ∀ 𝔓 : Ideal (Localization.AtPrime yg ⧸ J), 𝔓.IsPrime →
        Ig ≤ Ideal.comap π 𝔓 ∧ Ideal.comap π 𝔓 ≤ yg ∧ Ideal.map π (Ideal.comap π 𝔓) = 𝔓 := by
      intro 𝔓 h𝔓
      refine ⟨?_, ?_, ?_⟩
      · intro b hb
        rw [Ideal.mem_comap]
        show q (ℓ b) ∈ 𝔓
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem ℓ hb)]
        exact 𝔓.zero_mem
      · intro b hb
        by_contra hby
        have hu : IsUnit (ℓ b) :=
          (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime yg) yg b).mpr hby
        exact h𝔓.ne_top (Ideal.eq_top_of_isUnit_mem _ hb (hu.map q))
      · have h1 : Ideal.map ℓ (Ideal.comap ℓ (Ideal.comap q 𝔓)) = Ideal.comap q 𝔓 := by
          have := IsLocalization.map_under yg.primeCompl (Localization.AtPrime yg)
            (Ideal.comap q 𝔓)
          rwa [Ideal.under_def] at this
        rw [hπ, ← Ideal.map_map, ← Ideal.comap_comap, h1]
        exact Ideal.map_comap_of_surjective q Ideal.Quotient.mk_surjective 𝔓

    have hfin : (minimalPrimes (Localization.AtPrime yg ⧸ J)).Finite := by
      refine Set.Finite.of_finite_image (f := Ideal.comap π) (hS.subset ?_) ?_
      · rintro Q ⟨𝔓, h𝔓, rfl⟩
        have h𝔓P : 𝔓.IsPrime := h𝔓.1.1
        obtain ⟨h1, h2, _⟩ := P2 𝔓 h𝔓P
        exact ⟨Ideal.IsPrime.comap π, h1, h2⟩
      · intro 𝔓₁ h₁ 𝔓₂ h₂ heq
        rw [← (P2 𝔓₁ h₁.1.1).2.2, ← (P2 𝔓₂ h₂.1.1).2.2]
        exact congrArg (Ideal.map π) heq

    obtain ⟨h𝔓₀P, h𝔓₀c⟩ := P1 qg hqP hIq hqy
    have h𝔓₀min : Ideal.map π qg ∈ minimalPrimes (Localization.AtPrime yg ⧸ J) := by
      refine ⟨⟨h𝔓₀P, bot_le⟩, fun 𝔓' h' hle => ?_⟩
      have hP' : 𝔓'.IsPrime := h'.1
      obtain ⟨h1, _, h3⟩ := P2 𝔓' hP'
      have hle' : Ideal.comap π 𝔓' ≤ qg := by
        rw [← h𝔓₀c]; exact Ideal.comap_mono hle
      have heq : Ideal.comap π 𝔓' = qg := hqmin _ (Ideal.IsPrime.comap π) h1 hle'
      rw [← h3, heq]

    haveI : IsReduced (Localization.AtPrime yg ⧸ J) := hred
    have huniq := s5 (Localization.AtPrime yg ⧸ J) hfin hbr1

    have hmem : π a ∈ sInf (minimalPrimes (Localization.AtPrime yg ⧸ J)) :=
      Submodule.mem_sInf.mpr fun p hp => by
        rw [huniq p hp _ h𝔓₀min]
        exact Ideal.mem_map_of_mem π ha
    have hrad : π a ∈ (⊥ : Ideal (Localization.AtPrime yg ⧸ J)).radical := by
      rw [← Ideal.sInf_minimalPrimes]; exact hmem
    obtain ⟨n, hn⟩ := hrad
    have h0 : π a = 0 := IsReduced.eq_zero _ ⟨n, by simpa using hn⟩
    have h0' : ℓ a ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp h0
    obtain ⟨m, hm, hma⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff yg.primeCompl
        (Localization.AtPrime yg) Ig a).mp h0'
    exact ⟨m, hm, hma⟩

  have hred := reduced_fibre Ω W hW hWt A K L 𝔭 t y hPD hy hyc
  obtain ⟨_, _, H3⟩ := kpdf Ω W hW hWt A 𝔭 t hPD
  obtain ⟨_, _, hIC, _, hm𝔭, _, h𝔭eq, _⟩ := hPD
  haveI := hIC
  have hIgen : ∀ x ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(integralClosure A L) (algebraMap ↥W A x) ∈
        Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} :=
    fun x hx => Ideal.subset_span ⟨x, hx, rfl⟩

  have s3 : ∀ P₁ P₂ : Ideal A, P₁.IsPrime → P₂.IsPrime →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ P₁ →
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ P₂ →
      P₁ ≤ 𝔭 → P₂ ≤ 𝔭 → P₁ ≠ 𝔭 → P₁ ≤ P₂ := by
    intro P₁ P₂ h1 h2 hm1 hm2 hl1 hl2 hn1 b hb
    by_cases hc : ∃ s : A, s ∉ 𝔭 ∧ s * b ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)
    · obtain ⟨s, hs, hsb⟩ := hc
      exact (h2.mem_or_mem (hm2 hsb)).resolve_left (fun h => hs (hl2 h))
    · have hc' : ∀ s : A, s ∉ 𝔭 →
          s * b ∉ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) :=
        fun s hs hsb => hc ⟨s, hs, hsb⟩
      obtain ⟨k, u, s, hu, _, hsub⟩ := H3 b hc'
      exfalso
      apply hn1
      have hsb : s * b ∈ P₁ := P₁.mul_mem_left s hb
      have hut : u * t ^ k ∈ P₁ := by
        have := P₁.sub_mem hsb (hm1 hsub)
        rwa [sub_sub_cancel] at this
      have ht : t ∈ P₁ :=
        h1.mem_of_pow_mem k ((h1.mem_or_mem hut).resolve_left (fun h => hu (hl1 h)))
      apply le_antisymm hl1
      rw [h𝔭eq]
      exact sup_le (by rw [Ideal.span_le, Set.singleton_subset_iff]; exact ht) hm1

  have s4 : ∀ c : Ideal A, {Q : Ideal ↥(integralClosure A L) |
      Q.IsPrime ∧ Q.comap (algebraMap A ↥(integralClosure A L)) = c}.Finite := by
    intro c
    haveI : IsFractionRing ↥(integralClosure A L) L :=
      IsIntegralClosure.isFractionRing_of_finite_extension A K L ↥(integralClosure A L)
    haveI := Algebra.isInvariant_of_isGalois' A K L ↥(integralClosure A L)
    haveI : Finite (↥(integralClosure A L) ≃ₐ[A] ↥(integralClosure A L)) :=
      Finite.of_equiv _ (galRestrict A K L ↥(integralClosure A L)).toEquiv
    by_cases hne : ∃ Q₀ : Ideal ↥(integralClosure A L),
        Q₀.IsPrime ∧ Q₀.comap (algebraMap A ↥(integralClosure A L)) = c
    · obtain ⟨Q₀, hQ₀, hQ₀c⟩ := hne
      haveI := hQ₀
      open Pointwise in
      refine (Set.finite_range
        (fun g : (↥(integralClosure A L) ≃ₐ[A] ↥(integralClosure A L)) => g • Q₀)).subset ?_
      rintro Q ⟨hQ, hQc⟩
      haveI := hQ
      obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A ↥(integralClosure A L)
        (↥(integralClosure A L) ≃ₐ[A] ↥(integralClosure A L)) Q₀ Q
        (by rw [Ideal.under_def, Ideal.under_def, hQ₀c, hQc])
      exact ⟨g, hg.symm⟩
    · exact Set.Finite.subset Set.finite_empty (fun Q hQ => hne ⟨Q, hQ.1, hQ.2⟩)

  have hSfin : {Q : Ideal ↥(integralClosure A L) | Q.IsPrime ∧
      Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} ≤ Q ∧ Q ≤ y}.Finite := by
    have hT : ∀ Q : Ideal ↥(integralClosure A L), Q.IsPrime →
        Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} ≤ Q → Q ≤ y → Q ≠ y →
        (Q.comap (algebraMap A ↥(integralClosure A L))).IsPrime ∧
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
          Q.comap (algebraMap A ↥(integralClosure A L)) ∧
        Q.comap (algebraMap A ↥(integralClosure A L)) ≤ 𝔭 ∧
        Q.comap (algebraMap A ↥(integralClosure A L)) ≠ 𝔭 := by
      intro Q hQ hIQ hQy hQne
      haveI := hQ
      have hlt : Q < y := lt_of_le_of_ne hQy hQne
      have hult := Ideal.IsIntegral.under_lt_under (R := A) hlt
      rw [Ideal.under_def, Ideal.under_def, hyc] at hult
      refine ⟨Ideal.IsPrime.comap _, ?_, hult.le, hult.ne⟩
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap]
      exact hIQ (hIgen x hx)
    by_cases hex : ∃ Q₀ : Ideal ↥(integralClosure A L), Q₀.IsPrime ∧
        Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} ≤ Q₀ ∧ Q₀ ≤ y ∧ Q₀ ≠ y
    · obtain ⟨Q₀, hQ₀, hIQ₀, hQ₀y, hQ₀ne⟩ := hex
      obtain ⟨hc0P, hc0m, hc0l, hc0n⟩ := hT Q₀ hQ₀ hIQ₀ hQ₀y hQ₀ne
      refine ((s4 (Q₀.comap (algebraMap A ↥(integralClosure A L)))).insert y).subset ?_
      rintro Q ⟨hQ, hIQ, hQy⟩
      by_cases hQe : Q = y
      · exact Or.inl hQe
      · right
        obtain ⟨hcP, hcm, hcl, hcn⟩ := hT Q hQ hIQ hQy hQe
        exact ⟨hQ, le_antisymm (s3 _ _ hcP hc0P hcm hc0m hcl hc0l hcn)
          (s3 _ _ hc0P hcP hc0m hcm hc0l hcl hc0n)⟩
    · refine (Set.finite_singleton y).subset ?_
      rintro Q ⟨hQ, hIQ, hQy⟩
      by_contra hQe
      exact hex ⟨Q, hQ, hIQ, hQy, hQe⟩
  have hI𝔮 : Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
      (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} ≤ 𝔮 := by
    rw [Ideal.span_le]
    rintro b ⟨x, hx, hbx⟩
    have hb : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A x) := Subtype.ext hbx
    rw [hb]
    exact h𝔮m x hx
  exact G ↥(integralClosure A L) y (Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
      (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}) 𝔮 hred hbr hSfin h𝔮P hI𝔮 h𝔮y
    (fun Q hQ hIQ hQ𝔮 => hmin Q hQ hQ𝔮 (fun x hx => hIQ (hIgen x hx))) a ha

theorem wcpa_dj_llsm_ssb_hens_descent_normal : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (P : Type u) [CommRing P] (e : R →+* P), wcNdIsHens (IsLocalRing.maximalIdeal R) P e → ∀ (𝔓 : Ideal P) [𝔓.IsPrime], IsIntegrallyClosed (P ⧸ 𝔓) → 𝔓 ≤ (Ideal.map e (Ideal.comap e 𝔓)).radical → IsIntegrallyClosed (R ⧸ Ideal.comap e 𝔓) :=
by

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Q : Type u) [CommRing Q] (f : B →+* Q),
      wcNdIsHens (IsLocalRing.maximalIdeal B) Q f → ∀ I : Ideal B,
        Ideal.comap f (Ideal.map f I) = I := by
    intro B _ _ Q _ f hf I
    obtain ⟨R', _, _, hR', hflat, -⟩ := wcNd_hi_hens_exists_flat B
    haveI : HenselianLocalRing R' := hR'.1
    haveI : IsLocalHom (algebraMap B R') :=
      ⟨fun a ha => IsLocalRing.notMem_maximalIdeal.mp ((hR'.2.1 a).mp ha)⟩
    haveI : Module.FaithfullyFlat B R' := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hff : Ideal.comap (algebraMap B R') (Ideal.map (algebraMap B R') I) = I :=
      Ideal.comap_map_eq_self_of_faithfullyFlat I
    obtain ⟨h, ⟨hh, -⟩, -⟩ := hf.2.2 R' hR'.1 (algebraMap B R') hR'.2.1
    refine le_antisymm ?_ Ideal.le_comap_map
    intro x hx
    rw [Ideal.mem_comap] at hx
    have h1 : h (f x) ∈ Ideal.map h (Ideal.map f I) := Ideal.mem_map_of_mem h hx
    rw [Ideal.map_map, hh, ← RingHom.comp_apply, hh] at h1
    rw [← hff, Ideal.mem_comap]
    exact h1

  have s2 : ∀ (D : Type u) [CommRing D] [IsDomain D] (p : Ideal D), p.IsPrime →
      ∀ (H : Type u) [CommRing H] (g : D →+* H), wcNdIsHens p H g → _root_.IsReduced H := by
    intro D _ _ p hp H _ g hg
    haveI : HenselianLocalRing H := hg.1
    refine ⟨fun x hx => ?_⟩
    obtain ⟨n, hn⟩ := hx
    obtain ⟨E, _, _, _, j, hjc, hF, hj⟩ := wcNd_hens_etale_chart D p hp H g hg {x}
    obtain ⟨b, hb⟩ := hF x (Finset.mem_singleton_self x)
    haveI : (Ideal.comap j (IsLocalRing.maximalIdeal H)).IsPrime := Ideal.comap_isPrime j _
    obtain ⟨e', he', he'h⟩ := wcpa_dj_lr1k_eb_cd_hens_localize E
      (Ideal.comap j (IsLocalRing.maximalIdeal H)) H j hj
    have hinj : Function.Injective e' := by
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot, ← Ideal.map_bot (f := e')]
      exact s1 _ _ e' he'h ⊥
    haveI : _root_.IsReduced E := wc_cgtnr_etale_over_domain_reduced D E
    have hy : e' (algebraMap E (Localization.AtPrime (Ideal.comap j (IsLocalRing.maximalIdeal H))) b)
        = x := by
      rw [← hb, ← RingHom.comp_apply, he']
    have hyn : (algebraMap E (Localization.AtPrime (Ideal.comap j (IsLocalRing.maximalIdeal H))) b)
        ^ n = 0 := hinj (by rw [map_pow, hy, hn, map_zero])
    have hy0 := IsNilpotent.eq_zero ⟨n, hyn⟩
    rw [← hy, hy0, map_zero]

  have s3 : ∀ (D E : Type u) [CommRing D] [IsDomain D] [CommRing E] [IsDomain E]
      [IsIntegrallyClosed E] (ψ : D →+* E), Function.Injective ψ →
      (∀ a s : D, ψ a ∈ Ideal.span {ψ s} → a ∈ Ideal.span {s}) → IsIntegrallyClosed D := by
    intro D E _ _ _ _ _ ψ hinj hdiv
    rw [isIntegrallyClosed_iff (FractionRing D)]
    intro x hx
    obtain ⟨a, s, hs, rfl⟩ := IsFractionRing.div_surjective (A := D) x
    have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
    have hψs0 : ψ s ≠ 0 := fun h => hs0 (hinj (h.trans (map_zero ψ).symm))
    have hne : algebraMap D (FractionRing D) s ≠ 0 :=
      fun h => hs0 (IsFractionRing.injective D (FractionRing D) (h.trans (map_zero _).symm))
    have hne' : algebraMap E (FractionRing E) (ψ s) ≠ 0 :=
      fun h => hψs0 (IsFractionRing.injective E (FractionRing E) (h.trans (map_zero _).symm))
    let φ : FractionRing D →+* FractionRing E := IsFractionRing.map hinj
    have hcomm : (algebraMap E (FractionRing E)).comp ψ = φ.comp (algebraMap D (FractionRing D)) :=
      (IsLocalization.map_comp _).symm
    have hφx := IsIntegral.map_of_comp_eq ψ φ hcomm hx
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (K := FractionRing E)).mp hφx
    have hφa : φ (algebraMap D (FractionRing D) a) = algebraMap E (FractionRing E) (ψ a) :=
      IsLocalization.map_eq _ _
    have hφs : φ (algebraMap D (FractionRing D) s) = algebraMap E (FractionRing E) (ψ s) :=
      IsLocalization.map_eq _ _
    rw [map_div₀, hφa, hφs, eq_div_iff hne', ← map_mul] at hy
    have hya : y * ψ s = ψ a := IsFractionRing.injective E (FractionRing E) hy
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp (hdiv a s (Ideal.mem_span_singleton'.mpr ⟨y, hya⟩))
    refine ⟨t, ?_⟩
    rw [eq_div_iff hne, ← map_mul, ht]

  intro R _ _ P _ e hH 𝔓 _ hIC hrad
  haveI hqP : (Ideal.comap e 𝔓).IsPrime := Ideal.comap_isPrime e 𝔓
  have hqm : Ideal.comap e 𝔓 ≤ IsLocalRing.maximalIdeal R := IsLocalRing.le_maximalIdeal hqP.ne_top
  have hHq := wcNd_hens_quotient R (IsLocalRing.maximalIdeal R) (Ideal.comap e 𝔓) P e hH hqm
  have hpbar : ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk (Ideal.comap e 𝔓))).IsPrime := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk (Ideal.comap e 𝔓))
      Ideal.Quotient.mk_surjective (IsLocalRing.maximalIdeal.isMaximal R) with h | h
    · exfalso
      have h1 := Ideal.comap_map_of_surjective' (Ideal.Quotient.mk (Ideal.comap e 𝔓))
        Ideal.Quotient.mk_surjective (IsLocalRing.maximalIdeal R)
      rw [h, Ideal.comap_top, Ideal.mk_ker, sup_eq_left.mpr hqm] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top h1.symm
    · exact h.isPrime
  have hred := s2 (R ⧸ Ideal.comap e 𝔓) _ hpbar (P ⧸ (Ideal.comap e 𝔓).map e) _ hHq
  have hrad' : ((Ideal.comap e 𝔓).map e).IsRadical :=
    (Ideal.isRadical_iff_quotient_reduced _).mpr hred
  have hPeq : 𝔓 = (Ideal.comap e 𝔓).map e :=
    le_antisymm (hrad.trans_eq hrad'.radical) Ideal.map_comap_le

  let ψ : R ⧸ Ideal.comap e 𝔓 →+* P ⧸ 𝔓 := Ideal.quotientMap 𝔓 e (le_refl _)
  have hψinj : Function.Injective ψ := Ideal.quotientMap_injective
  have hdiv : ∀ a s : R ⧸ Ideal.comap e 𝔓, ψ a ∈ Ideal.span {ψ s} → a ∈ Ideal.span {s} := by
    intro a s has
    obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨s₀, rfl⟩ := Ideal.Quotient.mk_surjective s
    rw [Ideal.mem_span_singleton'] at has
    obtain ⟨c, hc⟩ := has
    obtain ⟨c₀, rfl⟩ := Ideal.Quotient.mk_surjective c
    have hc' : Ideal.Quotient.mk 𝔓 (c₀ * e s₀) = Ideal.Quotient.mk 𝔓 (e a₀) := by
      rw [map_mul]; exact hc
    rw [Ideal.Quotient.eq] at hc'
    have hmem : e a₀ - c₀ * e s₀ ∈ (Ideal.comap e 𝔓).map e := by
      rw [← hPeq, ← neg_sub]; exact 𝔓.neg_mem hc'
    have h1 : e a₀ ∈ Ideal.map e (Ideal.span {s₀} ⊔ Ideal.comap e 𝔓) := by
      rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton_sup]
      exact ⟨c₀, e a₀ - c₀ * e s₀, hmem, by ring⟩
    have h3 : a₀ ∈ Ideal.span {s₀} ⊔ Ideal.comap e 𝔓 := by
      rw [← s1 R P e hH (Ideal.span {s₀} ⊔ Ideal.comap e 𝔓)]
      exact h1
    obtain ⟨d, r, hr, hdr⟩ := Ideal.mem_span_singleton_sup.mp h3
    rw [Ideal.mem_span_singleton']
    refine ⟨Ideal.Quotient.mk _ d, ?_⟩
    rw [← map_mul, Ideal.Quotient.eq, ← hdr]
    have hh : d * s₀ - (d * s₀ + r) = -r := by ring
    rw [hh]
    exact (Ideal.comap e 𝔓).neg_mem hr
  haveI := hIC
  exact s3 (R ⧸ Ideal.comap e 𝔓) (P ⧸ 𝔓) ψ hψinj hdiv

theorem wcpa_dj_llsm_sccas_strict_branch : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 1 →
        ∃ 𝔷 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
          𝔷.IsPrime ∧ 𝔷 ≤ w ∧
          (∀ x ∈ IsLocalRing.maximalIdeal ↥W,
            algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A x)) ∈ 𝔷) ∧
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔷 ∧
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∉ 𝔷 ∧
          (∀ a : ↥(integralClosure A L), wcLlsCasIota W A K L t c' b' a ∈ 𝔷 →
            ∃ s : ↥(integralClosure A L), s ∉ y ∧ ∃ n : ℕ, s * a ^ n ∈
              Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
                (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}) ∧
          IsIntegrallyClosed (wcLlsCasD
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) w 𝔷) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb' hb0 hs
    w _ hwc hbr
  classical

  obtain ⟨P, _, e, he⟩ := wcNd_hens_exists (Localization.AtPrime w)
    (IsLocalRing.maximalIdeal (Localization.AtPrime w))
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime

