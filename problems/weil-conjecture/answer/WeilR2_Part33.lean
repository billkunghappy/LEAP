      · exact absurd (h𝔷c ▸ (Ideal.mem_comap.mpr (hF𝔷 (h ▸ hsE))) : _ ∈ P) hsP
      · exact absurd (hFu𝔷 (h ▸ hsE)) (hsI_notin Pu 𝔷I h𝔷Ic hsPu)
    ·
      have huP : ¬ algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
          (algebraMap A ↥(wcLlsASbS W A K u b) u) ∈ P := fun h => hboth ⟨h, hsP⟩
      left
      obtain ⟨𝔷, Q, h𝔷, hQ, h𝔷Q, hQy, h𝔷c, h𝔷mem⟩ := liftO P hP hPy huP
      have hQc := hNo Q hQ hQy (h𝔷Q (yIn P 𝔷 hP huP h𝔷mem))
      have hQQ := huniqO Q Qo hQ hQo hQy hQoy hQc hQoc
      have hIo𝔷 : Io ≤ 𝔷 := by
        rw [hIo, Ideal.span_le]; rintro c ⟨w, hw, hc⟩; exact IoIn P 𝔷 hP h𝔷mem w hw c hc
      have hIo𝔷o : Io ≤ 𝔷o := by
        rw [hIo, Ideal.span_le]; rintro c ⟨w, hw, hc⟩; exact IoIn Ps 𝔷o hPs h𝔷omem w hw c hc
      haveI := h𝔷; haveI := h𝔷o
      obtain ⟨F, hF, hF𝔷⟩ := Ideal.exists_minimalPrimes_le hIo𝔷
      obtain ⟨Fs, hFs, hFs𝔷⟩ := Ideal.exists_minimalPrimes_le hIo𝔷o
      obtain ⟨_, Pu', _, hPu', _, hPu'Q, _, _, huPu', _⟩ := hO Qo hQo hQoc
      rcases hthreeO Qo hQo hQoc F hF Fs hFs Pu' hPu' (hQQ ▸ (hF𝔷.trans h𝔷Q)) (hFs𝔷.trans h𝔷oQo)
        hPu'Q with h | h | h
      · have e1 := hmin _ _ _ hI₀o F hF P hP (h𝔷c ▸ Ideal.comap_mono hF𝔷)
        have e2 := hmin _ _ _ hI₀o Fs hFs Ps hPs (h𝔷oc ▸ Ideal.comap_mono hFs𝔷)
        rw [e1, e2, h]
      · exact absurd (hF𝔷 (h ▸ huPu')) (huo_notin P 𝔷 h𝔷c huP)
      · exact absurd (hFs𝔷 (h ▸ huPu')) (huo_notin Ps 𝔷o h𝔷oc huPs)
  refine ⟨Qo, 𝔷o, QI, 𝔷I, hQo, h𝔷o, hQI, h𝔷I, hQoy, hQIy, hQoc, hQIc, h𝔷oQo, h𝔷IQI,
    IoIn Ps 𝔷o hPs h𝔷omem, IIIn Pu 𝔷I hPu h𝔷Imem,
    ⟨yIn Ps 𝔷o hPs huPs h𝔷omem, huo_notin Ps 𝔷o h𝔷oc huPs⟩,
    ⟨xIn Pu 𝔷I hPu hsPu h𝔷Imem, hsI_notin Pu 𝔷I h𝔷Ic hsPu⟩, ?_⟩
  intro c hco hcI
  have hcPs : c ∈ Ps := by rw [← h𝔷oc]; exact hco
  have hcPu : c ∈ Pu := by rw [← h𝔷Ic]; exact hcI
  by_contra hcon
  push_neg at hcon
  have hdisj : Disjoint (I₀ : Set ↥(integralClosure ↥(wcLlsASbS W A K u b) L))
      ((y₀.primeCompl ⊔ Submonoid.powers c : Submonoid _) : Set _) := by
    rw [Set.disjoint_left]
    intro z hzI hzS
    obtain ⟨σ, hσ, t, ht, rfl⟩ := Submonoid.mem_sup.mp hzS
    obtain ⟨n, rfl⟩ := ht
    exact hcon σ hσ n hzI
  obtain ⟨P', hP', hIP', hP'd⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
  have hP'y : P' ≤ y₀ := by
    intro z hz
    by_contra hzy
    exact Set.disjoint_left.mp hP'd hz
      (Submonoid.mem_sup_left (show z ∈ y₀.primeCompl from hzy))
  have hcP' : c ∉ P' := fun h => Set.disjoint_left.mp hP'd h
    (Submonoid.mem_sup_right (Submonoid.mem_powers c))
  obtain ⟨P, hP, hPP'⟩ := Ideal.exists_minimalPrimes_le hIP'
  rcases hclass P hP (hPP'.trans hP'y) with rfl | rfl
  · exact hcP' (hPP' hcPs)
  · exact hcP' (hPP' hcPu)

theorem wcpa_dj_llsm_isicc_node_two_branch : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    {L : Type u} [Field L] (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
    (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime],
    IsNoetherianRing (wcLlsFS W wL R 𝔮) → IsReduced (wcLlsFS W wL R 𝔮) →
    ¬ wcpaDjLkBad (wcLlsFS W wL R 𝔮) →
    ∀ P₁ ∈ (wcIccM W wL R).minimalPrimes, ∀ P₂ ∈ (wcIccM W wL R).minimalPrimes,
    P₁ ≠ P₂ → P₁ ≤ 𝔮 → P₂ ≤ 𝔮 →
    (∀ z ∈ 𝔮, ∃ σ ∉ 𝔮, ∃ a ∈ P₁, ∃ β ∈ P₂, σ * z = a + β) ∧
    (∀ (t d : ↥(integralClosure R L)) (n : ℕ) (c : ℕ → ↥(integralClosure R L)), d ∉ P₁ → 0 < n →
      t ^ n + ∑ i ∈ Finset.range n, c i * t ^ i * d ^ (n - i) ∈ P₁ →
      ∃ σ ∉ 𝔮, ∃ r, σ * t - r * d ∈ P₁) :=
by

  have s1 : ∀ (F : Type u) [CommRing F] [_root_.IsReduced F]
      [IsNoetherianRing F] (p₁ p₂ : Ideal F), p₁ ∈ minimalPrimes F → p₂ ∈ minimalPrimes F →
      p₁ ≠ p₂ →
      ∃ u v : F, u ∉ p₁ ∧ u ∈ p₂ ∧ v ∈ p₁ ∧ v ∉ p₂ ∧ (∀ x ∈ p₁, x * u = 0) ∧
        ∀ s : F, s ∉ p₁ → s * u + v ∈ nonZeroDivisors F := by
    intro F _ _ _ p₁ p₂ h1 h2 hne
    classical
    have hfin := minimalPrimes.finite_of_isNoetherianRing F
    have hprime : ∀ q ∈ minimalPrimes F, q.IsPrime := fun q hq => hq.1.1
    have hmin : ∀ q ∈ minimalPrimes F, ∀ q' : Ideal F, q'.IsPrime → q' ≤ q → q = q' :=
      fun q hq q' hq' hle => le_antisymm (hq.2 ⟨hq', bot_le⟩ hle) hle
    have hZ : ∀ x : F, (∀ q ∈ minimalPrimes F, x ∈ q) → x = 0 := by
      intro x hx
      have hrad : x ∈ (⊥ : Ideal F).radical := by
        rw [← Ideal.sInf_minimalPrimes]
        exact Submodule.mem_sInf.mpr hx
      obtain ⟨n, hn⟩ := hrad
      exact _root_.IsReduced.eq_zero x ⟨n, by simpa using hn⟩
    have hp₁ := hprime p₁ h1
    set S' : Finset (Ideal F) := hfin.toFinset.erase p₁ with hS'
    have hmemS' : ∀ q, q ∈ S' ↔ q ≠ p₁ ∧ q ∈ minimalPrimes F := by
      intro q
      rw [hS', Finset.mem_erase, Set.Finite.mem_toFinset]
    have hsplit : ∀ q ∈ minimalPrimes F, q = p₁ ∨ q ∈ S' := by
      intro q hq
      by_cases h : q = p₁
      · exact Or.inl h
      · exact Or.inr ((hmemS' q).mpr ⟨h, hq⟩)
    have hp₂S : p₂ ∈ S' := (hmemS' p₂).mpr ⟨fun h => hne h.symm, h2⟩
    obtain ⟨u, huJ, hu1⟩ : ∃ u ∈ S'.inf id, u ∉ p₁ := by
      have hnle : ¬ S'.inf id ≤ p₁ := by
        intro hle
        obtain ⟨q, hq, hqle⟩ := (Ideal.IsPrime.inf_le' hp₁).mp hle
        have hq' := (hmemS' q).mp hq
        exact hq'.1 (le_antisymm hqle (h1.2 ⟨hprime q hq'.2, bot_le⟩ hqle))
      exact SetLike.not_le_iff_exists.mp hnle
    have huq : ∀ q ∈ S', u ∈ q := fun q hq => Finset.inf_le (f := id) hq huJ
    obtain ⟨v, hv1, hvq⟩ : ∃ v ∈ p₁, ∀ q ∈ S', v ∉ q := by
      by_contra hcon
      push_neg at hcon
      have hsub : (p₁ : Set F) ⊆ ⋃ q ∈ (S' : Set (Ideal F)), ((id q : Ideal F) : Set F) := by
        intro x hx
        obtain ⟨q, hq, hxq⟩ := hcon x hx
        exact Set.mem_biUnion (x := q) (Finset.mem_coe.mpr hq) hxq
      obtain ⟨q, hq, hle⟩ := (Ideal.subset_union_prime_finite (S'.finite_toSet) p₁ p₁
        (fun i hi _ _ => hprime i ((hmemS' i).mp hi).2)).mp hsub
      have hq' := (hmemS' q).mp hq
      exact hq'.1 (hmin q hq'.2 p₁ hp₁ hle)
    refine ⟨u, v, hu1, huq p₂ hp₂S, hv1, hvq p₂ hp₂S, ?_, ?_⟩
    · intro x hx
      apply hZ
      intro q hq
      rcases hsplit q hq with h | h
      · rw [h]; exact p₁.mul_mem_right u hx
      · exact q.mul_mem_left x (huq q h)
    · intro s hs
      have hwq : ∀ q ∈ minimalPrimes F, s * u + v ∉ q := by
        intro q hq hw
        rcases hsplit q hq with h | h
        · rw [h] at hw
          have : s * u ∈ p₁ := by
            have := p₁.sub_mem hw hv1
            simpa using this
          rcases hp₁.mem_or_mem this with h' | h'
          · exact hs h'
          · exact hu1 h'
        · apply hvq q h
          have := q.sub_mem hw (q.mul_mem_left s (huq q h))
          simpa using this
      have key : ∀ y : F, (s * u + v) * y = 0 → y = 0 := by
        intro y hy
        apply hZ
        intro q hq
        have : (s * u + v) * y ∈ q := by rw [hy]; exact q.zero_mem
        exact ((hprime q hq).mem_or_mem this).resolve_left (hwq q hq)
      exact mem_nonZeroDivisors_iff.mpr ⟨key, fun y hy => key y (by rw [mul_comm]; exact hy)⟩

  have s2 : ∀ (F : Type u) [CommRing F] [IsLocalRing F],
      (Module.length F (↥(integralClosure F (FractionRing F)) ⧸
        (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) = 0 ∨
       Module.length F (↥(integralClosure F (FractionRing F)) ⧸
        (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) = 1) →
      (∀ y₁ y₂ : FractionRing F, _root_.IsIntegral F y₁ → _root_.IsIntegral F y₂ →
        (∀ f : F, algebraMap F (FractionRing F) f ≠ y₁) →
        ∃ f g : F, y₂ = algebraMap F (FractionRing F) f + algebraMap F (FractionRing F) g * y₁) ∧
      (∀ y : FractionRing F, _root_.IsIntegral F y → ∀ m : F, ¬ IsUnit m →
        ∃ f : F, algebraMap F (FractionRing F) f = algebraMap F (FractionRing F) m * y) := by
    intro F _ _ hlen
    have KF : ∀ y : ↥(integralClosure F (FractionRing F)),
        (Submodule.Quotient.mk y : ↥(integralClosure F (FractionRing F)) ⧸
          (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) = 0 ↔
        ∃ f : F, algebraMap F (FractionRing F) f = (y : FractionRing F) := by
      intro y
      rw [Submodule.Quotient.mk_eq_zero, LinearMap.mem_range]
      constructor
      · rintro ⟨f, hf⟩
        exact ⟨f, by rw [← hf]; rfl⟩
      · rintro ⟨f, hf⟩
        exact ⟨f, Subtype.ext hf⟩
    refine ⟨?_, ?_⟩
    · intro y₁ y₂ hy₁ hy₂ hnot
      have hne : (Submodule.Quotient.mk (⟨y₁, hy₁⟩ : ↥(integralClosure F (FractionRing F))) :
          ↥(integralClosure F (FractionRing F)) ⧸
          (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) ≠ 0 := by
        intro h
        obtain ⟨f, hf⟩ := (KF _).mp h
        exact hnot f hf
      rcases hlen with h0 | h1
      · have := Module.length_eq_zero_iff.mp h0
        exact absurd (Subsingleton.elim _ _) hne
      · have := Module.length_eq_one_iff.mp h1
        have htop := IsSimpleModule.span_singleton_eq_top F hne
        have hmem : (Submodule.Quotient.mk (⟨y₂, hy₂⟩ : ↥(integralClosure F (FractionRing F))) :
            ↥(integralClosure F (FractionRing F)) ⧸
            (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) ∈
            Submodule.span F {Submodule.Quotient.mk
              (⟨y₁, hy₁⟩ : ↥(integralClosure F (FractionRing F)))} := by
          rw [htop]; exact Submodule.mem_top
        obtain ⟨g, hg⟩ := Submodule.mem_span_singleton.mp hmem
        have h0 : (Submodule.Quotient.mk ((⟨y₂, hy₂⟩ : ↥(integralClosure F (FractionRing F))) -
            g • (⟨y₁, hy₁⟩ : ↥(integralClosure F (FractionRing F)))) :
            ↥(integralClosure F (FractionRing F)) ⧸
            (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) = 0 := by
          rw [Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul, hg, sub_self]
        obtain ⟨f, hf⟩ := (KF _).mp h0
        refine ⟨f, g, ?_⟩
        have hc : (((⟨y₂, hy₂⟩ : ↥(integralClosure F (FractionRing F))) -
            g • (⟨y₁, hy₁⟩ : ↥(integralClosure F (FractionRing F))) :
              ↥(integralClosure F (FractionRing F))) : FractionRing F) =
            y₂ - algebraMap F (FractionRing F) g * y₁ := by
          rw [Subalgebra.coe_sub, Subalgebra.coe_smul, Algebra.smul_def]
        rw [hc] at hf
        linear_combination -hf
    · intro y hy m hm
      have hz : (Submodule.Quotient.mk (m • (⟨y, hy⟩ : ↥(integralClosure F (FractionRing F)))) :
          ↥(integralClosure F (FractionRing F)) ⧸
          (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) = 0 := by
        rcases hlen with h0 | h1
        · have := Module.length_eq_zero_iff.mp h0
          exact Subsingleton.elim _ _
        · have := Module.length_eq_one_iff.mp h1
          by_contra hne
          have htop := IsSimpleModule.span_singleton_eq_top F hne
          have hmem : (Submodule.Quotient.mk (⟨y, hy⟩ : ↥(integralClosure F (FractionRing F))) :
              ↥(integralClosure F (FractionRing F)) ⧸
              (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) ∈
              Submodule.span F {Submodule.Quotient.mk
                (m • (⟨y, hy⟩ : ↥(integralClosure F (FractionRing F))))} := by
            rw [htop]; exact Submodule.mem_top
          obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
          rw [Submodule.Quotient.mk_smul, smul_smul] at hc
          have hu : IsUnit (1 - c * m) :=
            IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ (mul_mem_nonunits_right hm)
          have h1' : (1 - c * m) • (Submodule.Quotient.mk
              (⟨y, hy⟩ : ↥(integralClosure F (FractionRing F))) :
              ↥(integralClosure F (FractionRing F)) ⧸
              (Algebra.linearMap F ↥(integralClosure F (FractionRing F))).range) = 0 := by
            rw [sub_smul, one_smul, hc, sub_self]
          rw [hu.smul_eq_zero] at h1'
          apply hne
          rw [Submodule.Quotient.mk_smul, h1', smul_zero]
      obtain ⟨f, hf⟩ := (KF _).mp hz
      refine ⟨f, ?_⟩
      rw [hf, Subalgebra.coe_smul, Algebra.smul_def]

  have s3 : ∀ (F : Type u) [CommRing F] [IsLocalRing F]
      (p₁ p₂ : Ideal F) [p₁.IsPrime] [p₂.IsPrime] (u v : F),
      u ∉ p₁ → u ∈ p₂ → v ∈ p₁ → v ∉ p₂ → (∀ x ∈ p₁, x * u = 0) →
      (∀ s : F, s ∉ p₁ → s * u + v ∈ nonZeroDivisors F) →
      (∀ y₁ y₂ : FractionRing F, _root_.IsIntegral F y₁ → _root_.IsIntegral F y₂ →
        (∀ f : F, algebraMap F (FractionRing F) f ≠ y₁) →
        ∃ f g : F, y₂ = algebraMap F (FractionRing F) f + algebraMap F (FractionRing F) g * y₁) →
      (∀ y : FractionRing F, _root_.IsIntegral F y → ∀ m : F, ¬ IsUnit m →
        ∃ f : F, algebraMap F (FractionRing F) f = algebraMap F (FractionRing F) m * y) →
      (∀ x : F, ¬ IsUnit x → ∃ a ∈ p₁, ∃ b ∈ p₂, x = a + b) ∧
      (∀ (T D : F) (n : ℕ) (c : ℕ → F), D ∉ p₁ → 0 < n →
        T ^ n + ∑ i ∈ Finset.range n, c i * T ^ i * D ^ (n - i) ∈ p₁ →
        ∃ f : F, T - f * D ∈ p₁) := by
    intro F _ _ p₁ p₂ hp₁ hp₂ u v hu1 hu2 hv1 hv2 hann hnzd hA hB
    have hinj : Function.Injective (algebraMap F (FractionRing F)) :=
      IsFractionRing.injective F (FractionRing F)
    have huv : v * u = 0 := hann v hv1
    have hvu' : algebraMap F (FractionRing F) v * algebraMap F (FractionRing F) u = 0 := by
      rw [← map_mul, huv, map_zero]
    have hw0 : u + v ∈ nonZeroDivisors F := by
      have := hnzd 1 (fun h => hp₁.ne_top ((Ideal.eq_top_iff_one _).mpr h))
      simpa using this
    obtain ⟨e, he_def⟩ : ∃ e, e = IsLocalization.mk' (FractionRing F) u
        (⟨u + v, hw0⟩ : nonZeroDivisors F) := ⟨_, rfl⟩
    have he : e * (algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v) =
        algebraMap F (FractionRing F) u := by
      have := IsLocalization.mk'_spec (FractionRing F) u (⟨u + v, hw0⟩ : nonZeroDivisors F)
      rw [← map_add, he_def]; exact this
    have hunit : IsUnit (algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v) := by
      rw [← map_add]
      exact IsLocalization.map_units (FractionRing F) (⟨u + v, hw0⟩ : nonZeroDivisors F)
    have hee : e * e = e := by
      have h : (e * e - e) * ((algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v) *
          (algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v)) = 0 := by
        linear_combination (e * (algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v) +
          algebraMap F (FractionRing F) u -
          (algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v)) * he - hvu'
      rw [(hunit.mul hunit).mul_left_eq_zero, sub_eq_zero] at h
      exact h
    have he_int : _root_.IsIntegral F e := by
      refine ⟨Polynomial.X ^ 2 + -Polynomial.X, Polynomial.monic_X_pow_add ?_, ?_⟩
      · rw [Polynomial.degree_neg, Polynomial.degree_X]; norm_num
      · simp only [Polynomial.eval₂_add, Polynomial.eval₂_neg, Polynomial.eval₂_X_pow,
          Polynomial.eval₂_X]
        rw [sq, hee]; ring
    have he_notin : ∀ f : F, algebraMap F (FractionRing F) f ≠ e := by
      intro f hf
      have h1 : f * (u + v) = u := hinj (by rw [map_mul, map_add, hf, he])
      have h2 : f * (f - 1) = 0 := hinj (by
        rw [map_mul, map_sub, map_one, map_zero, hf]; linear_combination hee)
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self f with hf' | hf'
      · have h3 : f - 1 = 0 := hf'.mul_right_eq_zero.mp h2
        have hf1 : f = 1 := sub_eq_zero.mp h3
        apply hv2
        have : v = 0 := by rw [hf1] at h1; linear_combination h1
        rw [this]; exact p₂.zero_mem
      · have h3 : (1 - f) * f = 0 := by linear_combination -h2
        have h4 : f = 0 := hf'.mul_right_eq_zero.mp h3
        apply hu1
        have : u = 0 := by rw [h4] at h1; linear_combination -h1
        rw [this]; exact p₁.zero_mem
    refine ⟨?_, ?_⟩
    · intro x hx
      obtain ⟨f, hf⟩ := hB e he_int x hx
      have hst : f * (u + v) = x * u := hinj (by
        rw [map_mul, map_add, map_mul, hf]
        linear_combination algebraMap F (FractionRing F) x * he)
      have h1 : (x - f) * u ∈ p₁ := by
        have : (x - f) * u = f * v := by linear_combination -hst
        rw [this]; exact p₁.mul_mem_left f hv1
      have h2 : f * v ∈ p₂ := by
        have : f * v = (x - f) * u := by linear_combination hst
        rw [this]; exact p₂.mul_mem_left _ hu2
      exact ⟨x - f, (hp₁.mem_or_mem h1).resolve_right hu1, f,
        (hp₂.mem_or_mem h2).resolve_right hv2, by ring⟩
    · intro T D n c hD hn hS
      have hD' : D * u + v ∈ nonZeroDivisors F := hnzd D hD
      obtain ⟨D', hD'def⟩ : ∃ D', D' = D * u + v := ⟨_, rfl⟩
      rw [← hD'def] at hD'
      obtain ⟨Y, hY_def⟩ : ∃ Y, Y = IsLocalization.mk' (FractionRing F) (T * u)
          (⟨D', hD'⟩ : nonZeroDivisors F) := ⟨_, rfl⟩
      have hY : Y * algebraMap F (FractionRing F) D' = algebraMap F (FractionRing F) (T * u) := by
        rw [hY_def]; exact IsLocalization.mk'_spec (FractionRing F) (T * u) ⟨D', hD'⟩
      have hDunit : IsUnit (algebraMap F (FractionRing F) D') :=
        IsLocalization.map_units (FractionRing F) (⟨D', hD'⟩ : nonZeroDivisors F)
      have pw : ∀ k j : ℕ, u ^ (j + 1) * D' ^ k = u ^ (j + 1 + k) * D ^ k := by
        intro k
        induction k with
        | zero => intro j; simp
        | succ k ih =>
          intro j
          rw [pow_succ D' k, ← mul_assoc, ih j, hD'def]
          linear_combination (u ^ (j + k) * D ^ k) * huv
      have hSu : (T ^ n + ∑ i ∈ Finset.range n, c i * T ^ i * D ^ (n - i)) * u = 0 := hann _ hS
      have hring : (T * u) ^ (n + 1) +
          ∑ i ∈ Finset.range n, c i * (T * u) ^ (i + 1) * D' ^ (n - i) = 0 := by
        have e1 : ∀ i ∈ Finset.range n, c i * (T * u) ^ (i + 1) * D' ^ (n - i) =
            u ^ (n + 1) * (c i * T ^ (i + 1) * D ^ (n - i)) := by
          intro i hi
          have hi' : i < n := Finset.mem_range.mp hi
          have h := pw (n - i) i
          have hidx : i + 1 + (n - i) = n + 1 := by omega
          rw [hidx] at h
          linear_combination (c i * T ^ (i + 1)) * h
        rw [Finset.sum_congr rfl e1, ← Finset.mul_sum]
        have hsum : ∑ i ∈ Finset.range n, c i * T ^ (i + 1) * D ^ (n - i) =
            T * ∑ i ∈ Finset.range n, c i * T ^ i * D ^ (n - i) := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun i _ => by ring)
        rw [hsum]
        linear_combination (u ^ n * T) * hSu
      have hY_int : _root_.IsIntegral F Y := by
        refine ⟨Polynomial.X ^ (n + 1) +
            ∑ i ∈ Finset.range n, Polynomial.C (c i) * Polynomial.X ^ (i + 1),
          Polynomial.monic_X_pow_add ?_, ?_⟩
        · refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
          refine lt_of_le_of_lt (Finset.sup_le (a := (n : WithBot ℕ)) ?_) ?_
          · intro i hi
            refine le_trans (Polynomial.degree_C_mul_X_pow_le _ _) ?_
            have := Finset.mem_range.mp hi
            exact_mod_cast (by omega : i + 1 ≤ n)
          · exact_mod_cast Nat.lt_succ_self n
        · rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
          simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
          have hmul : (Y ^ (n + 1) + ∑ i ∈ Finset.range n,
              algebraMap F (FractionRing F) (c i) * Y ^ (i + 1)) *
              algebraMap F (FractionRing F) D' ^ (n + 1) = 0 := by
            rw [add_mul, Finset.sum_mul]
            have e2 : ∀ i ∈ Finset.range n, algebraMap F (FractionRing F) (c i) * Y ^ (i + 1) *
                algebraMap F (FractionRing F) D' ^ (n + 1) =
                algebraMap F (FractionRing F) (c i * (T * u) ^ (i + 1) * D' ^ (n - i)) := by
              intro i hi
              have hi' := Finset.mem_range.mp hi
              have hidx : n + 1 = (i + 1) + (n - i) := by omega
              simp only [map_mul, map_pow]
              rw [← map_mul, ← hY, hidx,
                pow_add (algebraMap F (FractionRing F) D') (i + 1) (n - i)]
              ring
            rw [Finset.sum_congr rfl e2, ← mul_pow, hY, ← map_pow, ← map_sum, ← map_add, hring,
              map_zero]
          exact (hDunit.pow (n + 1)).mul_left_eq_zero.mp hmul
      obtain ⟨f, g, hfg⟩ := hA e Y he_int hY_int he_notin
      have hY' : Y * algebraMap F (FractionRing F) D' =
          algebraMap F (FractionRing F) T * algebraMap F (FractionRing F) u := by
        rw [hY, map_mul]
      have hst : T * u * (u + v) = f * D' * (u + v) + g * u * D' := hinj (by
        simp only [map_mul, map_add]
        linear_combination
          (-(algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v)) * hY' +
          (algebraMap F (FractionRing F) D' *
            (algebraMap F (FractionRing F) u + algebraMap F (FractionRing F) v)) * hfg +
          (algebraMap F (FractionRing F) g * algebraMap F (FractionRing F) D') * he)
      refine ⟨f + g, ?_⟩
      have heq : u * (u * (T - (f + g) * D)) =
          -(v * (T * u - f * D * u - f * u - f * v - g * u)) := by
        rw [hD'def] at hst; linear_combination hst
      have hmem : u * (u * (T - (f + g) * D)) ∈ p₁ := by
        rw [heq]; exact neg_mem (p₁.mul_mem_right _ hv1)
      exact (hp₁.mem_or_mem ((hp₁.mem_or_mem hmem).resolve_left hu1)).resolve_left hu1

  have s4 : ∀ (C : Type u) [CommRing C] (I 𝔮 : Ideal C) [𝔮.IsPrime], I ≤ 𝔮 →
      IsLocalRing (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))) ∧
      (∀ z ∈ 𝔮, ¬ IsUnit (Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))
          (algebraMap C (Localization.AtPrime 𝔮) z))) ∧
      (∀ y : Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)),
        ∃ r s : C, s ∉ 𝔮 ∧
          y * Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))
              (algebraMap C (Localization.AtPrime 𝔮) s) =
            Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))
              (algebraMap C (Localization.AtPrime 𝔮) r)) := by
    intro C _ I 𝔮 _ hI𝔮
    have hJ : I.map (algebraMap C (Localization.AtPrime 𝔮)) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.map_mono hI𝔮
    have hJne : I.map (algebraMap C (Localization.AtPrime 𝔮)) ≠ ⊤ := by
      intro h
      rw [h] at hJ
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (top_le_iff.mp hJ)
    haveI : Nontrivial (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))) :=
      Ideal.Quotient.nontrivial_iff.mpr hJne
    refine ⟨IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective, ?_, ?_⟩
    · intro z hz hu
      obtain ⟨y, hy⟩ := hu.exists_right_inv
      obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq] at hy
      have h1 := hJ hy
      have h2 : algebraMap C (Localization.AtPrime 𝔮) z * y' ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
        apply Ideal.mul_mem_right
        rw [← Localization.AtPrime.map_eq_maximalIdeal]
        exact Ideal.mem_map_of_mem _ hz
      have h3 := Ideal.sub_mem _ h2 h1
      rw [sub_sub_cancel] at h3
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
    · intro y
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl w
      refine ⟨r, s, s.2, ?_⟩
      rw [← map_mul]
      congr 1
      exact IsLocalization.mk'_spec _ r s

  have s5 : ∀ (C : Type u) [CommRing C] (I 𝔮 : Ideal C)
      [𝔮.IsPrime] (P : Ideal C), P ∈ I.minimalPrimes → P ≤ 𝔮 →
      (P.map ((Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))).comp
          (algebraMap C (Localization.AtPrime 𝔮)))).IsPrime ∧
      P.map ((Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))).comp
          (algebraMap C (Localization.AtPrime 𝔮))) ∈
        minimalPrimes (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))) ∧
      (P.map ((Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))).comp
          (algebraMap C (Localization.AtPrime 𝔮)))).comap
        ((Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))).comp
          (algebraMap C (Localization.AtPrime 𝔮))) = P := by
    intro C _ I 𝔮 _ P hP hP𝔮
    have hPp : P.IsPrime := hP.1.1
    have hIP : I ≤ P := hP.1.2
    have hdisj : Disjoint (𝔮.primeCompl : Set C) (P : Set C) := by
      rw [Set.disjoint_left]
      intro x hx hxP
      exact hx (hP𝔮 hxP)
    set α := algebraMap C (Localization.AtPrime 𝔮)
    set J := I.map α
    have hP'c : (P.map α).comap α = P :=
      IsLocalization.under_map_of_isPrime_disjoint 𝔮.primeCompl _ hPp hdisj
    have hP'p : (P.map α).IsPrime := IsLocalization.isPrime_of_isPrime_disjoint _ _ P hPp hdisj
    have hJP' : J ≤ P.map α := Ideal.map_mono hIP
    have hker : RingHom.ker (Ideal.Quotient.mk J) ≤ P.map α := by
      rw [Ideal.mk_ker]; exact hJP'
    have hmap : P.map ((Ideal.Quotient.mk J).comp α) = (P.map α).map (Ideal.Quotient.mk J) := by
      rw [Ideal.map_map]
    have hprime : (P.map ((Ideal.Quotient.mk J).comp α)).IsPrime := by
      rw [hmap]; exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
    have hcomap : (P.map ((Ideal.Quotient.mk J).comp α)).comap
        ((Ideal.Quotient.mk J).comp α) = P := by
      rw [hmap, ← Ideal.comap_comap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hJP', hP'c]
    refine ⟨hprime, ⟨⟨hprime, bot_le⟩, ?_⟩, hcomap⟩
    intro q ⟨hq, _⟩ hqle
    have hqc : (q.comap ((Ideal.Quotient.mk J).comp α)).IsPrime := Ideal.comap_isPrime _ q
    have hIq : I ≤ q.comap ((Ideal.Quotient.mk J).comp α) := by
      intro x hx
      rw [Ideal.mem_comap, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_map_of_mem α hx)]
      exact q.zero_mem
    have hle : q.comap ((Ideal.Quotient.mk J).comp α) ≤ P := by
      rw [← hcomap]; exact Ideal.comap_mono hqle
    have hPle := hP.2 ⟨hqc, hIq⟩ hle
    exact le_trans (Ideal.map_mono hPle) (Ideal.map_comap_le)

  have G : ∀ (C : Type u) [CommRing C] (I 𝔮 : Ideal C) [𝔮.IsPrime],
      IsNoetherianRing (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))) →
      _root_.IsReduced (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))) →
      ¬ wcpaDjLkBad (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))) →
      ∀ P₁ ∈ I.minimalPrimes, ∀ P₂ ∈ I.minimalPrimes,
      P₁ ≠ P₂ → P₁ ≤ 𝔮 → P₂ ≤ 𝔮 →
      (∀ z ∈ 𝔮, ∃ σ ∉ 𝔮, ∃ a ∈ P₁, ∃ β ∈ P₂, σ * z = a + β) ∧
      (∀ (t d : C) (n : ℕ) (c : ℕ → C), d ∉ P₁ → 0 < n →
        t ^ n + ∑ i ∈ Finset.range n, c i * t ^ i * d ^ (n - i) ∈ P₁ →
        ∃ σ ∉ 𝔮, ∃ r, σ * t - r * d ∈ P₁) := by
    intro C _ I 𝔮 _ hN hR hBad P₁ hP₁ P₂ hP₂ hne hP₁𝔮 hP₂𝔮
    have hI𝔮 : I ≤ 𝔮 := le_trans hP₁.1.2 hP₁𝔮
    obtain ⟨hloc, hnu, hfrac⟩ := s4 C I 𝔮 hI𝔮
    obtain ⟨hp1p, hp1m, hp1c⟩ := s5 C I 𝔮 P₁ hP₁ hP₁𝔮
    obtain ⟨hp2p, hp2m, hp2c⟩ := s5 C I 𝔮 P₂ hP₂ hP₂𝔮
    set π := (Ideal.Quotient.mk (I.map (algebraMap C (Localization.AtPrime 𝔮)))).comp
      (algebraMap C (Localization.AtPrime 𝔮)) with hπ
    have hne' : P₁.map π ≠ P₂.map π := by
      intro h; apply hne; rw [← hp1c, ← hp2c, h]
    obtain ⟨u, v, hu1, hu2, hv1, hv2, hann, hnzd⟩ := s1 _ _ _ hp1m hp2m hne'
    have hlen : Module.length (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
        (↥(integralClosure (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
          (FractionRing (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))))) ⧸
        (Algebra.linearMap (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
          ↥(integralClosure (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
          (FractionRing (Localization.AtPrime 𝔮 ⧸
            I.map (algebraMap C (Localization.AtPrime 𝔮)))))).range) = 0 ∨
        Module.length (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
        (↥(integralClosure (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
          (FractionRing (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮))))) ⧸
        (Algebra.linearMap (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
          ↥(integralClosure (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap C (Localization.AtPrime 𝔮)))
          (FractionRing (Localization.AtPrime 𝔮 ⧸
            I.map (algebraMap C (Localization.AtPrime 𝔮)))))).range) = 1 := by
      unfold wcpaDjLkBad wcpaDjLkDelta at hBad
      rcases not_not.mp hBad with h | h
      · exact Or.inl h
      · exact Or.inr h.1
    obtain ⟨hA, hB⟩ := s2 _ hlen
    obtain ⟨hT, hNF⟩ := s3 _ (P₁.map π) (P₂.map π) u v hu1 hu2 hv1 hv2 hann hnzd hA hB
    have hmemP : ∀ (P : Ideal C), (P.map π).comap π = P → ∀ x : C, π x ∈ P.map π → x ∈ P := by
      intro P hc x hx
      rw [← hc]; exact Ideal.mem_comap.mpr hx
    refine ⟨?_, ?_⟩
    · intro z hz
      obtain ⟨a', ha', b', hb', hab⟩ := hT (π z) (hnu z hz)
      obtain ⟨a, s₁, hs₁, ha⟩ := hfrac a'
      obtain ⟨β, s₂, hs₂, hb⟩ := hfrac b'
      have ha2 : a' * π s₁ = π a := ha
      have hb2 : b' * π s₂ = π β := hb
      have haP : a ∈ P₁ := hmemP P₁ hp1c a (by rw [← ha2]; exact Ideal.mul_mem_right _ _ ha')
      have hbP : β ∈ P₂ := hmemP P₂ hp2c β (by rw [← hb2]; exact Ideal.mul_mem_right _ _ hb')
      have hw : π (s₁ * s₂ * z - s₂ * a - s₁ * β) = 0 := by
        simp only [map_sub, map_mul]
        rw [hab, ← ha2, ← hb2]; ring
      have hwP : s₁ * s₂ * z - s₂ * a - s₁ * β ∈ P₁ :=
        hmemP P₁ hp1c _ (by rw [hw]; exact Ideal.zero_mem _)
      refine ⟨s₁ * s₂, fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hs₁ hs₂,
        s₂ * a + (s₁ * s₂ * z - s₂ * a - s₁ * β), P₁.add_mem (P₁.mul_mem_left _ haP) hwP,
        s₁ * β, P₂.mul_mem_left _ hbP, by ring⟩
    · intro t d n c hd hn hS
      have hD : π d ∉ P₁.map π := fun h => hd (hmemP P₁ hp1c d h)
      have hS' := Ideal.mem_map_of_mem π hS
      simp only [map_add, map_sum, map_mul, map_pow] at hS'
      obtain ⟨f, hf⟩ := hNF (π t) (π d) n (fun i => π (c i)) hD hn hS'
      obtain ⟨r, s, hs, hrs⟩ := hfrac f
      have hrs2 : f * π s = π r := hrs
      refine ⟨s, hs, r, hmemP P₁ hp1c _ ?_⟩
      have : π (s * t - r * d) = π s * (π t - f * π d) := by
        simp only [map_sub, map_mul]; rw [← hrs2]; ring
      rw [this]
      exact Ideal.mul_mem_left _ _ hf
  intro Ω _ W L _ wL R _ _ 𝔮 _ hN hR hBad P₁ hP₁ P₂ hP₂ hne hP₁𝔮 hP₂𝔮
  exact G _ (wcIccM W wL R) 𝔮 hN hR hBad P₁ hP₁ P₂ hP₂ hne hP₁𝔮 hP₂𝔮

theorem wcpa_dj_llsm_isicc_global_sections : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (zo : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
      (zI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)), (zo : L) = (zI : L) →
    ∃ c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), (c : L) = (zo : L) :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b _ _ _ _ _ _ _ _ zo zI hz
  classical

  have transport : ∀ (T : Subalgebra A K) (V : ValuationSubring L),
      (∀ t ∈ T, algebraMap K L t ∈ V) → ∀ w : L, IsIntegral T w → w ∈ V := by
    intro T V hTV w hw
    let φ : T →+* V := ((algebraMap K L).comp T.val.toRingHom).codRestrict V
      (fun t => hTV t.1 t.2)
    have hcomp : (algebraMap V L).comp φ = (RingHom.id L).comp (algebraMap T L) := by
      ext t; rfl
    have h1 : IsIntegral V w := by
      have := IsIntegral.map_of_comp_eq φ (RingHom.id L) hcomp hw
      simpa using this
    obtain ⟨v, hv⟩ := (IsIntegrallyClosed.isIntegral_iff (R := V) (K := L)).mp h1
    rw [← hv]; exact v.2
  set R0 := wcLlsASbS W A K u b with hR0
  set s0 : Set L := ((algebraMap R0 L).range : Set L) with hs0
  have hzo : IsIntegral (wcLlsASbS W A K u a') (zo : L) := (mem_integralClosure_iff _ _).mp zo.2
  have hzI : IsIntegral (wcIcxRI W A K u a' b) (zI : L) := (mem_integralClosure_iff _ _).mp zI.2
  have key : ∀ V : {V : ValuationSubring L // s0 ⊆ V}, (zo : L) ∈ V.1 := by
    rintro ⟨V, hV⟩
    have hV' : ∀ r ∈ R0, algebraMap K L r ∈ V := fun r hr =>
      hV (RingHom.mem_range.mpr ⟨⟨r, hr⟩, rfl⟩)
    let B : Subalgebra A K :=
      { toSubsemiring := (V.toSubring.comap (algebraMap K L)).toSubsemiring
        algebraMap_mem' := fun a => hV' _ (R0.algebraMap_mem a) }
    have hBmem : ∀ t : K, t ∈ B ↔ algebraMap K L t ∈ V := fun t => Iff.rfl
    have hs : algebraMap K L (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u) ∈ V :=
      hV' _ (Algebra.subset_adjoin (Set.mem_singleton _))
    rcases V.mem_or_inv_mem
      (algebraMap K L (algebraMap A K (algebraMap ↥W A a') / algebraMap A K u)) with h | h
    · have hle : wcLlsASbS W A K u a' ≤ B :=
        Algebra.adjoin_le (Set.singleton_subset_iff.mpr ((hBmem _).mpr h))
      exact transport _ V (fun t ht => (hBmem t).mp (hle ht)) _ hzo
    · rw [← map_inv₀, inv_div] at h
      have hle : wcIcxRI W A K u a' b ≤ B := by
        apply Algebra.adjoin_le
        intro t ht
        rcases ht with rfl | ht
        · exact (hBmem _).mpr h
        · rw [Set.mem_singleton_iff] at ht
          subst ht
          exact (hBmem _).mpr hs
      rw [hz]
      exact transport _ V (fun t ht => (hBmem t).mp (hle ht)) _ hzI
  have hmem : (zo : L) ∈ (integralClosure (Subring.closure s0) L).toSubring := by
    rw [← iInf_valuationSubring_superset]
    refine Subring.mem_iInf.mpr ?_
    intro V
    exact key ⟨V.1, V.2⟩
  have hcl : IsIntegral (Subring.closure s0) (zo : L) := hmem
  have hinj : Function.Injective (algebraMap R0 L) := fun x y hxy =>
    Subtype.ext ((algebraMap K L).injective hxy)
  let e : R0 ≃+* (algebraMap R0 L).range :=
    RingEquiv.ofBijective (algebraMap R0 L).rangeRestrict
      ⟨fun x y hxy => hinj (congrArg Subtype.val hxy), (algebraMap R0 L).rangeRestrict_surjective⟩
  have hle : Subring.closure s0 ≤ (algebraMap R0 L).range := Subring.closure_le.mpr subset_rfl
  let φ : Subring.closure s0 →+* R0 := e.symm.toRingHom.comp (Subring.inclusion hle)
  have hcomp : (algebraMap R0 L).comp φ = (RingHom.id L).comp (algebraMap (Subring.closure s0) L) := by
    ext r
    have h1 := congrArg Subtype.val (e.apply_symm_apply (Subring.inclusion hle r))
    exact h1
  have hint : IsIntegral R0 (zo : L) := by
    have := IsIntegral.map_of_comp_eq φ (RingHom.id L) hcomp hcl
    simpa using this
  exact ⟨⟨(zo : L), (mem_integralClosure_iff _ _).mpr hint⟩, rfl⟩

theorem wcpa_dj_llsm_isicc_h_fg : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∃ G : Finset ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
      ∀ γ : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
        ∃ (go : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
          (gI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L))
          (c : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) → A),
          (γ : L) = (go : L) + (gI : L) + ∑ x ∈ G, algebraMap A L (c x) * (x : L) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hPD ha'm ha'0 hbm hb0
    ha'b hnba hbg
  classical
  obtain ⟨hFT, hNZ, _, _, _, _, hg0, huv, _⟩ := hPD

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    apply hg0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, ← huv, map_mul, h, zero_mul]
  have ha0 : algebraMap A K (algebraMap ↥W A a') ≠ 0 := by
    intro h
    apply ha'0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, h]
  have hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a' := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff]
    exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hfgO : (wcLlsASbS W A K u a').FG :=
    ⟨{algebraMap A K (algebraMap ↥W A a') / algebraMap A K u}, by
      rw [Finset.coe_singleton]⟩

  have s1 : ∀ (s : Set K) (T : Subalgebra A K) (t : K), t ∈ T →
      (∀ σ ∈ s, ∃ M : ℕ, t ^ M * σ ∈ T) →
      ∀ r ∈ Algebra.adjoin A s, ∃ M : ℕ, t ^ M * r ∈ T := by
    intro s T t ht hs r hr
    induction hr using Algebra.adjoin_induction with
    | mem p hp => exact hs p hp
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact T.algebraMap_mem a⟩
    | add p q _ _ hp hq =>
      obtain ⟨M₁, h₁⟩ := hp
      obtain ⟨M₂, h₂⟩ := hq
      refine ⟨M₁ + M₂, ?_⟩
      have e : t ^ (M₁ + M₂) * (p + q) = t ^ M₂ * (t ^ M₁ * p) + t ^ M₁ * (t ^ M₂ * q) := by
        ring
      rw [e]
      exact T.add_mem (T.mul_mem (T.pow_mem ht _) h₁) (T.mul_mem (T.pow_mem ht _) h₂)
    | mul p q _ _ hp hq =>
      obtain ⟨M₁, h₁⟩ := hp
      obtain ⟨M₂, h₂⟩ := hq
      refine ⟨M₁ + M₂, ?_⟩
      have e : t ^ (M₁ + M₂) * (p * q) = (t ^ M₁ * p) * (t ^ M₂ * q) := by ring
      rw [e]
      exact T.mul_mem h₁ h₂

  have s2 : ∀ (R R' : Subalgebra A K) (t : K), t ∈ R' → (∀ r ∈ R, ∃ M : ℕ, t ^ M * r ∈ R') →
      ∀ z : L, IsIntegral ↥R z → ∃ N : ℕ, IsIntegral ↥R' (algebraMap K L t ^ N * z) := by
    intro R R' t ht hR z hz
    obtain ⟨p, hpm, hpz⟩ := hz
    choose M hM using fun r : ↥R => hR r r.2
    obtain ⟨N, hN⟩ : ∃ N : ℕ, ∀ i < p.natDegree, M (p.coeff i) ≤ N :=
      ⟨∑ i ∈ Finset.range p.natDegree, M (p.coeff i), fun i hi =>
        Finset.single_le_sum (fun j _ => Nat.zero_le (M (p.coeff j))) (Finset.mem_range.mpr hi)⟩
    have hpKd : (p.map (algebraMap ↥R K)).natDegree = p.natDegree := hpm.natDegree_map _
    have hcoeff : ∀ i, ((p.map (algebraMap ↥R K)).scaleRoots (t ^ N)).coeff i ∈ R' := by
      intro i
      rw [Polynomial.coeff_scaleRoots, hpKd, Polynomial.coeff_map]
      rcases lt_or_ge i p.natDegree with hi | hi
      · have hMN : M (p.coeff i) ≤ N := hN i hi
        have hNk : N ≤ N * (p.natDegree - i) := Nat.le_mul_of_pos_right N (by omega)
        have h2 : (t ^ N) ^ (p.natDegree - i) =
            t ^ (N * (p.natDegree - i) - M (p.coeff i)) * t ^ M (p.coeff i) := by
          rw [← pow_mul, ← pow_add, Nat.sub_add_cancel (hMN.trans hNk)]
        have h3 : algebraMap ↥R K (p.coeff i) = ((p.coeff i : ↥R) : K) := rfl
        have e : algebraMap ↥R K (p.coeff i) * (t ^ N) ^ (p.natDegree - i) =
            t ^ (N * (p.natDegree - i) - M (p.coeff i)) *
              (t ^ M (p.coeff i) * ((p.coeff i : ↥R) : K)) := by
          rw [h3, h2]; ring
        rw [e]
        exact R'.mul_mem (R'.pow_mem ht _) (hM _)
      · rw [Nat.sub_eq_zero_of_le hi, pow_zero, mul_one]
        rcases hi.lt_or_eq with hi | hi
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, map_zero]; exact R'.zero_mem
        · have h1 : p.coeff p.natDegree = 1 := hpm
          rw [← hi, h1, map_one]; exact R'.one_mem
    have hmon : ((p.map (algebraMap ↥R K)).scaleRoots (t ^ N)).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr (hpm.map _)
    have hlift : (p.map (algebraMap ↥R K)).scaleRoots (t ^ N) ∈
        Polynomial.lifts (algebraMap ↥R' K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨_, hcoeff n⟩, rfl⟩
    obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
    refine ⟨N, q, hqm, ?_⟩
    have e1 : algebraMap ↥R' L = (algebraMap K L).comp (algebraMap ↥R' K) := rfl
    have e2 : algebraMap ↥R L = (algebraMap K L).comp (algebraMap ↥R K) := rfl
    rw [e1, ← Polynomial.eval₂_map, hq, ← map_pow, Polynomial.scaleRoots_eval₂_mul,
      Polynomial.eval₂_map, ← e2, hpz, mul_zero]

  have core : ∀ (Ro RI RC : Subalgebra A K) (x y : K), x * y = 1 → Ro = Algebra.adjoin A {y} →
      x ∈ RI → RC ≤ Algebra.adjoin A {x, y} → Ro ≤ RC → x ∈ RC →
      Module.Finite ↥Ro ↥(integralClosure ↥Ro L) →
      ∃ G : Finset ↥(integralClosure ↥RC L), ∀ γ : ↥(integralClosure ↥RC L),
        ∃ (go : ↥(integralClosure ↥Ro L)) (gI : ↥(integralClosure ↥RI L))
          (c : ↥(integralClosure ↥RC L) → A),
          (γ : L) = (go : L) + (gI : L) + ∑ g ∈ G, algebraMap A L (c g) * (g : L) := by
    intro Ro RI RC x y hxy hRo hxI hRC hoC' hxC hfin
    have hyo : y ∈ Ro := by rw [hRo]; exact Algebra.subset_adjoin (Set.mem_singleton y)
    have hint : ∀ (R : Subalgebra A K) (k : K), k ∈ R → IsIntegral ↥R (algebraMap K L k) :=
      fun R k hk => (isIntegral_algebraMap : IsIntegral ↥R (algebraMap ↥R L ⟨k, hk⟩))
    have hintA : ∀ (R : Subalgebra A K) (a : A), IsIntegral ↥R (algebraMap A L a) := by
      intro R a
      rw [IsScalarTower.algebraMap_apply A K L]
      exact hint R _ (R.algebraMap_mem a)
    have hXYn : ∀ n : ℕ, algebraMap K L x ^ n * algebraMap K L y ^ n = 1 := by
      intro n
      rw [← mul_pow, ← map_mul, hxy, map_one, one_pow]
    have hαC : ∀ α : ↥(integralClosure ↥Ro L), IsIntegral ↥RC (α : L) :=
      fun α => (wcIcxIncl L Ro RC hoC' α).2

    have hxo : ∀ r ∈ Ro, ∃ M : ℕ, x ^ M * r ∈ RI := by
      intro r hr
      refine s1 {y} RI x hxI ?_ r (by rw [← hRo]; exact hr)
      intro σ hσ
      rw [Set.mem_singleton_iff.mp hσ]
      exact ⟨1, by rw [pow_one, hxy]; exact RI.one_mem⟩
    have hyCo : ∀ r ∈ RC, ∃ M : ℕ, y ^ M * r ∈ Ro := by
      intro r hr
      refine s1 {x, y} Ro y hyo ?_ r (hRC hr)
      intro σ hσ
      rcases hσ with h | h
      · rw [h]; exact ⟨1, by rw [pow_one, mul_comm, hxy]; exact Ro.one_mem⟩
      · rw [Set.mem_singleton_iff.mp h]; exact ⟨0, by rw [pow_zero, one_mul]; exact hyo⟩
    choose Nf hNf using fun α : ↥(integralClosure ↥Ro L) => s2 Ro RI x hxI hxo (α : L) α.2
    have hfg : (⊤ : Submodule ↥Ro ↥(integralClosure ↥Ro L)).FG := Module.Finite.fg_top
    obtain ⟨S₀, hS₀⟩ := hfg
    obtain ⟨N₀, hN₀⟩ : ∃ N₀ : ℕ, ∀ α ∈ S₀, Nf α ≤ N₀ := ⟨S₀.sup Nf, fun α hα => Finset.le_sup hα⟩
    have hgenI : ∀ α ∈ S₀, ∀ j : ℕ,
        IsIntegral ↥RI (algebraMap K L x ^ j * (algebraMap K L x ^ N₀ * (α : L))) := by
      intro α hα j
      have e : algebraMap K L x ^ j * (algebraMap K L x ^ N₀ * (α : L)) =
          algebraMap K L x ^ (j + (N₀ - Nf α)) * (algebraMap K L x ^ Nf α * (α : L)) := by
        rw [← mul_assoc, ← mul_assoc, ← pow_add, ← pow_add,
          show j + (N₀ - Nf α) + Nf α = j + N₀ by have := hN₀ α hα; omega]
      rw [e]
      exact ((hint RI x hxI).pow _).mul (hNf α)

    obtain ⟨e, hep⟩ : ∃ e : ↥(integralClosure ↥Ro L) × ℕ → ↥(integralClosure ↥RC L),
        ∀ p, ((e p : ↥(integralClosure ↥RC L)) : L) = algebraMap K L x ^ p.2 * (p.1 : L) :=
      ⟨fun p => ⟨algebraMap K L x ^ p.2 * (p.1 : L),
        ((hint RC x hxC).pow p.2).mul (hαC p.1)⟩, fun p => rfl⟩
    refine ⟨(S₀ ×ˢ Finset.range N₀).image e, fun γ => ?_⟩
    obtain ⟨Good, hGood⟩ : ∃ P : L → Prop, ∀ z, P z ↔
        ∃ (go : ↥(integralClosure ↥Ro L)) (gI : ↥(integralClosure ↥RI L))
          (c : ↥(integralClosure ↥RC L) → A),
          z = (go : L) + (gI : L) +
            ∑ g ∈ (S₀ ×ˢ Finset.range N₀).image e, algebraMap A L (c g) * (g : L) :=
      ⟨_, fun z => Iff.rfl⟩
    have hGood0 : Good 0 := by
      refine (hGood 0).mpr ⟨0, 0, 0, ?_⟩
      simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero,
        ZeroMemClass.coe_zero, add_zero]
    have hGoodAdd : ∀ z₁ z₂, Good z₁ → Good z₂ → Good (z₁ + z₂) := by
      intro z₁ z₂ h₁ h₂
      obtain ⟨go1, gI1, c1, e1⟩ := (hGood z₁).mp h₁
      obtain ⟨go2, gI2, c2, e2⟩ := (hGood z₂).mp h₂
      refine (hGood _).mpr ⟨go1 + go2, gI1 + gI2, c1 + c2, ?_⟩
      rw [e1, e2]
      simp only [AddMemClass.coe_add, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      ring
    have hGoodG : ∀ p ∈ S₀ ×ˢ Finset.range N₀, ∀ a : A,
        Good (algebraMap A L a * (algebraMap K L x ^ p.2 * (p.1 : L))) := by
      intro p hp a
      refine (hGood _).mpr ⟨0, 0, fun g => if g = e p then a else 0, ?_⟩
      rw [Finset.sum_eq_single_of_mem (e p) (Finset.mem_image_of_mem e hp)]
      · simp only [hep, ZeroMemClass.coe_zero, zero_add, ite_true]
      · intro g _ hg
        simp only [hg, ite_false, map_zero, zero_mul]
    have hmono : ∀ α ∈ S₀, ∀ (n i : ℕ) (a : A),
        Good (algebraMap K L x ^ n * (algebraMap A L a * algebraMap K L y ^ i) * (α : L)) := by
      intro α hα n i a
      rcases le_or_gt n i with h | h
      · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
        have hmem : IsIntegral ↥Ro (algebraMap A L a * (algebraMap K L y ^ k * (α : L))) :=
          (hintA Ro a).mul (((hint Ro y hyo).pow k).mul α.2)
        refine (hGood _).mpr ⟨⟨_, hmem⟩, 0, 0, ?_⟩
        simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero,
          ZeroMemClass.coe_zero, add_zero]
        rw [pow_add]
        linear_combination (algebraMap A L a * algebraMap K L y ^ k * (α : L)) * hXYn n
      · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h.le
        rcases le_or_gt N₀ k with hk | hk
        · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
          have hmem : IsIntegral ↥RI (algebraMap A L a *
              (algebraMap K L x ^ j * (algebraMap K L x ^ N₀ * (α : L)))) :=
            (hintA RI a).mul (hgenI α hα j)
          refine (hGood _).mpr ⟨0, ⟨_, hmem⟩, 0, ?_⟩
          simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero,
            ZeroMemClass.coe_zero, add_zero, zero_add]
          rw [pow_add, pow_add]
          linear_combination (algebraMap A L a * algebraMap K L x ^ j *
            algebraMap K L x ^ N₀ * (α : L)) * hXYn i
        · have hG := hGoodG (α, k) (Finset.mem_product.mpr ⟨hα, Finset.mem_range.mpr hk⟩) a
          have e' : algebraMap K L x ^ (i + k) * (algebraMap A L a * algebraMap K L y ^ i) *
              (α : L) = algebraMap A L a * (algebraMap K L x ^ k * (α : L)) := by
            rw [pow_add]
            linear_combination (algebraMap A L a * algebraMap K L x ^ k * (α : L)) * hXYn i
          rw [e']; exact hG

    obtain ⟨n, hn⟩ := s2 RC Ro y hyo hyCo (γ : L) γ.2
    have hβ : (⟨algebraMap K L y ^ n * (γ : L), hn⟩ : ↥(integralClosure ↥Ro L)) ∈
        Submodule.span ↥Ro (S₀ : Set ↥(integralClosure ↥Ro L)) := by
      rw [hS₀]; exact Submodule.mem_top
    obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp hβ
    choose q hq using fun α : ↥(integralClosure ↥Ro L) => (AlgHom.mem_range _).mp
      (show ((f α : ↥Ro) : K) ∈ (Polynomial.aeval y : Polynomial A →ₐ[A] K).range from by
        rw [← Algebra.adjoin_singleton_eq_range_aeval, ← hRo]; exact (f α).2)
    have hf' : ∑ α ∈ S₀, Polynomial.aeval (algebraMap K L y) (q α) * (α : L) =
        algebraMap K L y ^ n * (γ : L) := by
      have h1 := congrArg (fun z : ↥(integralClosure ↥Ro L) => (z : L)) hf
      simp only [AddSubmonoidClass.coe_finsetSum] at h1
      rw [← h1]
      refine Finset.sum_congr rfl (fun α _ => ?_)
      have e1 : ((f α • α : ↥(integralClosure ↥Ro L)) : L) =
          algebraMap K L ((f α : ↥Ro) : K) * (α : L) := Algebra.smul_def (f α) (α : L)
      rw [e1, ← hq α, Polynomial.aeval_algebraMap_apply]
    have hγ : (γ : L) = ∑ α ∈ S₀,
        algebraMap K L x ^ n * Polynomial.aeval (algebraMap K L y) (q α) * (α : L) := by
      calc (γ : L) = algebraMap K L x ^ n * (algebraMap K L y ^ n * (γ : L)) := by
            linear_combination (-(γ : L)) * hXYn n
        _ = algebraMap K L x ^ n *
            ∑ α ∈ S₀, Polynomial.aeval (algebraMap K L y) (q α) * (α : L) := by rw [hf']
        _ = _ := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl fun _ _ => (mul_assoc _ _ _).symm
    have hfinal : Good (γ : L) := by
      rw [hγ]
      refine Finset.sum_induction _ Good hGoodAdd hGood0 (fun α hα => ?_)
      refine Polynomial.induction_on' (q α) (fun p₁ p₂ h₁ h₂ => ?_) (fun i a => ?_)
      · rw [map_add, mul_add, add_mul]; exact hGoodAdd _ _ h₁ h₂
      · rw [Polynomial.aeval_monomial]; exact hmono α hα n i a
    exact (hGood _).mp hfinal

  have hxy : wcLlsIsiS1 W A K u a' * wcLlsIsiS2 W A K u a' = 1 := by
    unfold wcLlsIsiS1 wcLlsIsiS2
    rw [div_mul_div_comm, mul_comm (algebraMap A K u), div_self (mul_ne_zero ha0 hu0)]
  exact core (wcLlsASbS W A K u a') (wcIcxRI W A K u a' b) (wcLlsIsiCR W A K u a')
    (wcLlsIsiS1 W A K u a') (wcLlsIsiS2 W A K u a') hxy rfl
    (Algebra.subset_adjoin (Set.mem_insert _ _)) le_rfl hoC
    (Algebra.subset_adjoin (Set.mem_insert _ _))
    (wcpa_dj_llsm_isicb_norm_finite Ω W hW A K L hFT hNZ _ hfgO)

theorem wcpa_dj_llsm_isicc_h_vanish : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (y₀ : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u b) L)), y₀.IsPrime →
    y₀.comap (algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) =
      wcLlsASbN W A K u b →
    (∃ G : Finset ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
      ∀ γ : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
        ∃ (go : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
          (gI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L))
          (c : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) → A),
          (γ : L) = (go : L) + (gI : L) + ∑ x ∈ G, algebraMap A L (c x) * (x : L)) →
    (∀ γ : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
      ∃ σ : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), σ ∉ y₀ ∧
        ∃ (go : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
          (gI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) (w : ↥W)
          (γ' : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)),
          w ∈ IsLocalRing.maximalIdeal ↥W ∧
          (σ : L) * (γ : L) = (go : L) + (gI : L) + wcIccWL W A K L w * (γ' : L)) →
    ∀ γ : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
      ∃ σ : ↥(integralClosure ↥(wcLlsASbS W A K u b) L), σ ∉ y₀ ∧
        ∃ (go : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
          (gI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)),
          (σ : L) * (γ : L) = (go : L) + (gI : L) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hPD ha'm ha'0 hbm hb0 ha'b hnba
    hbg y₀ hy₀ hy₀c hFG hSF
  classical
  haveI := hy₀
  obtain ⟨e, he⟩ := ha'b

  have hRo : wcLlsASbS W A K u b ≤ wcLlsASbS W A K u a' := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff]
    have hs : algebraMap A K (algebraMap ↥W A b) / algebraMap A K u =
        algebraMap A K (algebraMap ↥W A e) *
          (algebraMap A K (algebraMap ↥W A a') / algebraMap A K u) := by
      rw [he, map_mul, map_mul]
      ring
    rw [SetLike.mem_coe, hs]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin (Set.mem_singleton _))
  have hRI : wcLlsASbS W A K u b ≤ wcIcxRI W A K u a' b := by
    apply Algebra.adjoin_le
    rw [Set.singleton_subset_iff]
    exact Algebra.subset_adjoin (Set.mem_insert_of_mem _
      (Set.mem_singleton (wcLlsIsiS2 W A K u b)))
  have hinc : ∀ (S T : Subalgebra A K) (h : S ≤ T) (x : ↥(integralClosure ↥S L)),
      ((wcIcxIncl L S T h x : ↥(integralClosure ↥T L)) : L) = (x : L) := fun _ _ _ _ => rfl
  have hcstc : ∀ (R : Subalgebra A K) (w : ↥W),
      ((wcIccCst W A K L R w : ↥(integralClosure ↥R L)) : L) = wcIccWL W A K L w :=
    fun _ _ => rfl

  have s2 : ∀ {C : Type u} [CommRing C] (y : Ideal C) [y.IsPrime] {ι : Type u} [Fintype ι]
      [DecidableEq ι] (σ : ι → C) (a : ι → ι → C), (∀ j, σ j ∉ y) → (∀ j k, a j k ∈ y) →
      (Matrix.diagonal σ - Matrix.of a).det ∉ y := by
    intro C _ y _ ι _ _ σ a hσ ha hdet
    have h1 : Ideal.Quotient.mk y (Matrix.diagonal σ - Matrix.of a).det = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hdet
    rw [RingHom.map_det] at h1
    have h2 : (Ideal.Quotient.mk y).mapMatrix (Matrix.diagonal σ - Matrix.of a) =
        Matrix.diagonal (fun j => Ideal.Quotient.mk y (σ j)) := by
      ext j k
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.sub_apply, Matrix.of_apply,
        map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr (ha j k), sub_zero]
      by_cases hjk : j = k
      · subst hjk
        rw [Matrix.diagonal_apply_eq, Matrix.diagonal_apply_eq]
      · rw [Matrix.diagonal_apply_ne _ hjk, Matrix.diagonal_apply_ne _ hjk, map_zero]
    rw [h2, Matrix.det_diagonal] at h1
    obtain ⟨j, _, hj⟩ := Finset.prod_eq_zero_iff.mp h1
    exact hσ j (Ideal.Quotient.eq_zero_iff_mem.mp hj)

  have s3 : ∀ {C : Type u} [CommRing C] (f : C →+* L) (M : AddSubgroup L),
      (∀ (c : C) (m : L), m ∈ M → f c * m ∈ M) → ∀ {ι : Type u} [Fintype ι] [DecidableEq ι]
      (N : Matrix ι ι C) (g : ι → L), (∀ j, ∑ k, f (N j k) * g k ∈ M) →
      ∀ i, f N.det * g i ∈ M := by
    intro C _ f M hM ι _ _ N g hrow i
    have hsum : ∑ j, f (N.adjugate i j) * ∑ k, f (N j k) * g k ∈ M :=
      AddSubgroup.sum_mem _ (fun j _ => hM _ _ (hrow j))
    have h1 : ∀ k, ∑ j, f (N.adjugate i j) * f (N j k) = f ((N.adjugate * N) i k) := by
      intro k
      rw [Matrix.mul_apply, map_sum]
      simp only [map_mul]
    have heq : ∑ j, f (N.adjugate i j) * ∑ k, f (N j k) * g k = f N.det * g i := by
      calc ∑ j, f (N.adjugate i j) * ∑ k, f (N j k) * g k
          = ∑ k, (∑ j, f (N.adjugate i j) * f (N j k)) * g k := by
            simp only [Finset.mul_sum, Finset.sum_mul]
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun j _ => ?_))
            ring
        _ = ∑ k, f ((N.adjugate * N) i k) * g k := by simp only [h1]
        _ = f N.det * g i := by
            rw [Matrix.adjugate_mul, Finset.sum_eq_single i]
            · simp [Matrix.one_apply]
            · intro k _ hk
              simp [Matrix.one_apply_ne (Ne.symm hk)]
            · intro h
              exact absurd (Finset.mem_univ i) h
    rw [← heq]
    exact hsum

  obtain ⟨M, hMmem⟩ : ∃ M : AddSubgroup L, ∀ l, l ∈ M ↔
      ∃ (go : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
        (gI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)), (go : L) + (gI : L) = l :=
    ⟨{ carrier := {l | ∃ (go : ↥(integralClosure ↥(wcLlsASbS W A K u a') L))
          (gI : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)), (go : L) + (gI : L) = l}
       add_mem' := by
         rintro _ _ ⟨go₁, gI₁, rfl⟩ ⟨go₂, gI₂, rfl⟩
         exact ⟨go₁ + go₂, gI₁ + gI₂, by push_cast; ring⟩
       zero_mem' := ⟨0, 0, by simp⟩
       neg_mem' := by
         rintro _ ⟨go, gI, rfl⟩
         exact ⟨-go, -gI, by push_cast; ring⟩ }, fun _ => Iff.rfl⟩
  have hMcl : ∀ (c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) (m : L), m ∈ M →
      (c : L) * m ∈ M := by
    intro c m hm
    obtain ⟨go, gI, rfl⟩ := (hMmem m).mp hm
    refine (hMmem _).mpr ⟨wcIcxIncl L _ _ hRo c * go, wcIcxIncl L _ _ hRI c * gI, ?_⟩
    simp only [MulMemClass.coe_mul, hinc]
    ring
  obtain ⟨f, hf⟩ : ∃ f : ↥(integralClosure ↥(wcLlsASbS W A K u b) L) →+* L,
      ∀ c, f c = (c : L) :=
    ⟨(integralClosure ↥(wcLlsASbS W A K u b) L).val.toRingHom, fun _ => rfl⟩
  have hMclf : ∀ (c : ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) (m : L), m ∈ M →
      f c * m ∈ M := fun c m hm => by rw [hf]; exact hMcl c m hm
  have hcst : ∀ t : A, ((algebraMap ↥(wcLlsASbS W A K u b)
      ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) t) : ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) :
        L) = algebraMap A L t := by
    intro t
    rw [IsScalarTower.algebraMap_apply A K L t]
    rfl
  have hcsty : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ t : A,
      algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w * t)) ∈ y₀ := by
    intro w hw t
    have h1 : algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A w * t) ∈
        wcLlsASbN W A K u b := by
      rw [map_mul]
      apply Ideal.mul_mem_right
      unfold wcLlsASbN
      apply Ideal.mem_sup_right
      exact Ideal.mem_map_of_mem ((algebraMap A ↥(wcLlsASbS W A K u b)).comp (algebraMap ↥W A)) hw
    rw [← hy₀c] at h1
    exact h1

  obtain ⟨G, hG⟩ := hFG
  choose σ hσ go₁ gI₁ w γ' hw hE1 using
    fun x : ↥G => hSF (x : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L))
  choose go₂ gI₂ c hE2 using fun x : ↥G => hG (γ' x)
  obtain ⟨a, hay, hav⟩ : ∃ a : ↥G → ↥G → ↥(integralClosure ↥(wcLlsASbS W A K u b) L),
      (∀ j k, a j k ∈ y₀) ∧ ∀ j k, (a j k : L) =
        wcIccWL W A K L (w j) * algebraMap A L (c j (k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L))) := by
    refine ⟨fun j k => algebraMap ↥(wcLlsASbS W A K u b) ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) (algebraMap ↥W A (w j) *
          c j (k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)))), fun j k => hcsty _ (hw j) _,
      fun j k => ?_⟩
    rw [hcst, map_mul, IsScalarTower.algebraMap_apply A K L (algebraMap ↥W A (w j))]
    rfl
  obtain ⟨N, hN⟩ : ∃ N : Matrix ↥G ↥G ↥(integralClosure ↥(wcLlsASbS W A K u b) L),
      N = Matrix.diagonal σ - Matrix.of a := ⟨_, rfl⟩
  have hrow : ∀ j : ↥G, ∑ k : ↥G, f (N j k) *
      ((k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) ∈ M := by
    intro j
    have h1 : ∑ k : ↥G, f (Matrix.diagonal σ j k) *
        ((k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) =
        (σ j : L) * ((j : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) := by
      rw [Finset.sum_eq_single j]
      · rw [Matrix.diagonal_apply_eq, hf]
      · intro k _ hk
        rw [Matrix.diagonal_apply_ne _ (Ne.symm hk), map_zero, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ j) h
    have h2 : ∑ k : ↥G, f (Matrix.of a j k) *
        ((k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) =
        wcIccWL W A K L (w j) * ∑ k : ↥G,
          algebraMap A L (c j (k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L))) *
          ((k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Matrix.of_apply, hf, hav, mul_assoc]
    have hexp : ∑ k : ↥G, f (N j k) *
        ((k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) =
        (σ j : L) * ((j : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) -
        wcIccWL W A K L (w j) * ∑ k : ↥G,
          algebraMap A L (c j (k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L))) *
          ((k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) := by
      rw [hN]
      simp only [Matrix.sub_apply, map_sub, sub_mul, Finset.sum_sub_distrib]
      rw [h1, h2]
    have hcs := Finset.sum_coe_sort G
      (fun x => algebraMap A L (c j x) * (x : L))
    beta_reduce at hcs
    rw [hexp]
    refine (hMmem _).mpr ⟨go₁ j + wcIccCst W A K L (wcLlsASbS W A K u a') (w j) * go₂ j,
      gI₁ j + wcIccCst W A K L (wcIcxRI W A K u a' b) (w j) * gI₂ j, ?_⟩
    simp only [AddMemClass.coe_add, MulMemClass.coe_mul, hcstc]
    linear_combination (-1 : L) * hE1 j - wcIccWL W A K L (w j) * hE2 j +
      wcIccWL W A K L (w j) * hcs

  have hΔ : N.det ∉ y₀ := by
    rw [hN]
    exact s2 y₀ σ a hσ hay
  have hdetx : ∀ i : ↥G, (N.det : L) *
      ((i : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) ∈ M := by
    intro i
    have := s3 f M hMclf N (fun k => ((k : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L))
      hrow i
    rw [hf] at this
    exact this

  intro γ
  obtain ⟨go, gI, cc, hγ⟩ := hG γ
  have hcs2 := Finset.sum_coe_sort G (fun x => algebraMap A L (cc x) * (x : L))
  beta_reduce at hcs2
  have hS : ∑ x : ↥G, ((algebraMap ↥(wcLlsASbS W A K u b)
      ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
        (algebraMap A ↥(wcLlsASbS W A K u b) (cc x)) :
          ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) : L) *
        ((N.det : L) * ((x : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L)) =
      (N.det : L) * ∑ x : ↥G, algebraMap A L (cc x) *
        ((x : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [hcst]
    ring
  have hmem : (N.det : L) * (γ : L) ∈ M := by
    have e : (N.det : L) * (γ : L) =
        (N.det : L) * ((go : L) + ((0 : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) : L)) +
        (N.det : L) * (((0 : ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) : L) + (gI : L)) +
        ∑ x : ↥G, ((algebraMap ↥(wcLlsASbS W A K u b)
          ↥(integralClosure ↥(wcLlsASbS W A K u b) L)
            (algebraMap A ↥(wcLlsASbS W A K u b) (cc x)) :
              ↥(integralClosure ↥(wcLlsASbS W A K u b) L)) : L) *
          ((N.det : L) * ((x : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L)) := by
      rw [hS, ZeroMemClass.coe_zero, ZeroMemClass.coe_zero]
      linear_combination (N.det : L) * hγ - (N.det : L) * hcs2
    rw [e]
    refine M.add_mem (M.add_mem (hMcl _ _ ((hMmem _).mpr ⟨go, 0, rfl⟩))
      (hMcl _ _ ((hMmem _).mpr ⟨0, gI, rfl⟩))) ?_
    exact M.sum_mem (fun x _ => hMcl _ _ (hdetx x))
  obtain ⟨go', gI', hgg⟩ := (hMmem _).mp hmem
  exact ⟨N.det, hΔ, go', gI', hgg.symm⟩

theorem wcpa_dj_llsm_isiccc_chart_clear : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    algebraMap A K u ≠ 0 → algebraMap A K (algebraMap ↥W A a') ≠ 0 →
    ∀ γ : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
      (∃ (n : ℕ) (δ : ↥(integralClosure ↥(wcLlsASbS W A K u a') L)),
        (δ : L) = algebraMap K L (wcLlsIsiS2 W A K u a') ^ n * (γ : L)) ∧
      (∃ (n : ℕ) (δ : ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)),
        (δ : L) = algebraMap K L (wcLlsIsiS1 W A K u a') ^ n * (γ : L)) :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hu0 ha0 γ
  classical

  have denom : ∀ (R : Subalgebra A K) (s t : K), t ∈ R → s * t = 1 →
      ∀ r ∈ Algebra.adjoin A {s, t}, ∃ n : ℕ, t ^ n * r ∈ R := by
    intro R s t ht hst r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · exact ⟨1, by rw [pow_one, mul_comm, hst]; exact R.one_mem⟩
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact ⟨0, by rw [pow_zero, one_mul]; exact ht⟩
    | algebraMap a =>
      exact ⟨0, by rw [pow_zero, one_mul]; exact R.algebraMap_mem a⟩
    | add x y _ _ hx hy =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, ?_⟩
      have e : t ^ (n₁ + n₂) * (x + y) = t ^ n₂ * (t ^ n₁ * x) + t ^ n₁ * (t ^ n₂ * y) := by
        rw [pow_add]; ring
      rw [e]
      exact R.add_mem (R.mul_mem (R.pow_mem ht _) h₁) (R.mul_mem (R.pow_mem ht _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, ?_⟩
      have e : t ^ (n₁ + n₂) * (x * y) = (t ^ n₁ * x) * (t ^ n₂ * y) := by
        rw [pow_add]; ring
      rw [e]
      exact R.mul_mem h₁ h₂

  have scale : ∀ (R C : Subalgebra A K) (t : K), t ∈ R → (∀ r ∈ C, ∃ n : ℕ, t ^ n * r ∈ R) →
      ∀ x : L, _root_.IsIntegral ↥C x →
        ∃ n : ℕ, _root_.IsIntegral ↥R (algebraMap K L t ^ n * x) := by
    intro R C t ht hC x hx
    obtain ⟨p, hpm, hp⟩ := hx
    have mono : ∀ (r : K) (n m : ℕ), n ≤ m → t ^ n * r ∈ R → t ^ m * r ∈ R := by
      intro r n m hnm h
      have e : t ^ m * r = t ^ (m - n) * (t ^ n * r) := by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hnm]
      rw [e]
      exact R.mul_mem (R.pow_mem ht _) h
    choose f hf using fun i : ℕ => hC (p.coeff i : K) (p.coeff i).2
    set d := p.natDegree with hd
    set N := (Finset.range d).sup f with hN
    set P : Polynomial K := p.map (C.val : ↥C →+* K) with hP
    have hPm : P.Monic := hpm.map _
    have hPd : P.natDegree = d := hpm.natDegree_map _
    have hPc : ∀ i, P.coeff i = (p.coeff i : K) := fun i => by
      rw [hP, Polynomial.coeff_map]; rfl
    set Q := P.scaleRoots (t ^ N) with hQ
    have hQm : Q.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hPm
    have hQc : ∀ i, Q.coeff i ∈ R := by
      intro i
      rw [hQ, Polynomial.coeff_scaleRoots, hPd, hPc]
      rcases lt_trichotomy i d with hi | hi | hi
      · have hfi : f i ≤ N := Finset.le_sup (Finset.mem_range.mpr hi)
        have hle : N ≤ N * (d - i) := Nat.le_mul_of_pos_right N (by omega)
        rw [← pow_mul, mul_comm]
        exact mono _ (f i) _ (hfi.trans hle) (hf i)
      · subst hi
        rw [Nat.sub_self, pow_zero, mul_one, hd, hpm.coeff_natDegree]
        simp
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
        simp
    have hlift : Q ∈ Polynomial.lifts (R.val : ↥R →+* K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨Q.coeff i, hQc i⟩, rfl⟩
    obtain ⟨q, hqQ, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hQm
    refine ⟨N, q, hqm, ?_⟩
    have hP0 : Polynomial.eval₂ (algebraMap K L) x P = 0 := by
      rw [hP, Polynomial.eval₂_map, ← Subalgebra.algebraMap_eq]
      exact hp
    have h1 := Polynomial.scaleRoots_eval₂_eq_zero (algebraMap K L) (s := t ^ N) hP0
    rw [Subalgebra.algebraMap_eq, ← Polynomial.eval₂_map, hqQ, ← map_pow]
    exact h1

  have hxy : wcLlsIsiS1 W A K u a' * wcLlsIsiS2 W A K u a' = 1 := by
    unfold wcLlsIsiS1 wcLlsIsiS2
    rw [div_mul_div_comm, mul_comm (algebraMap A K u), div_self (mul_ne_zero ha0 hu0)]
  have hyx : wcLlsIsiS2 W A K u a' * wcLlsIsiS1 W A K u a' = 1 := by
    rw [mul_comm]; exact hxy
  have hγ : _root_.IsIntegral ↥(wcLlsIsiCR W A K u a') (γ : L) := γ.2
  constructor
  · have htR : wcLlsIsiS2 W A K u a' ∈ wcLlsASbS W A K u a' :=
      Algebra.subset_adjoin (Set.mem_singleton _)
    obtain ⟨n, hn⟩ := scale _ _ _ htR
      (denom _ (wcLlsIsiS1 W A K u a') (wcLlsIsiS2 W A K u a') htR hxy) _ hγ
    exact ⟨n, ⟨_, hn⟩, rfl⟩
  · have htR : wcLlsIsiS1 W A K u a' ∈ wcIcxRI W A K u a' b :=
      Algebra.subset_adjoin (Set.mem_insert _ _)
    have hden : ∀ r ∈ wcLlsIsiCR W A K u a',
        ∃ n : ℕ, wcLlsIsiS1 W A K u a' ^ n * r ∈ wcIcxRI W A K u a' b := by
      intro r hr
      have hr' : r ∈ Algebra.adjoin A {wcLlsIsiS2 W A K u a', wcLlsIsiS1 W A K u a'} := by
        rw [Set.pair_comm]; exact hr
      exact denom _ _ _ htR hyx r hr'
    obtain ⟨n, hn⟩ := scale _ _ _ htR hden _ hγ
    exact ⟨n, ⟨_, hn⟩, rfl⟩

theorem wcpa_dj_llsm_isiccc_orientation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W)
    (hoC : wcLlsASbS W A K u a' ≤ wcLlsIsiCR W A K u a'),
    wcLlsPD W A 𝔭 (.ann u v g) → a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ θ : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) →+*
      LaurentPolynomial (IsLocalRing.ResidueField ↥W),
    Function.Surjective θ →
    (∀ w : ↥W, θ (wcIccCst W A K L (wcLlsIsiCR W A K u a') w) =
      LaurentPolynomial.C (IsLocalRing.residue ↥W w)) →
    ∃ (c : IsLocalRing.ResidueField ↥W) (k : ℤ), c ≠ 0 ∧ k ≠ 0 ∧
      θ (wcIccYC W A K L u a') = LaurentPolynomial.C c * LaurentPolynomial.T k ∧
      ∀ δ : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
        θ (wcIcxIncl L _ _ hoC δ) * θ (wcIccYC W A K L u a') ≠ 1 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g a' b hoC hPD ha'm ha'0 ha'b hnba hbg
    θ hsurj hθC
  classical

  have L1 : ∀ (κ : Type u) [Field κ] (f : LaurentPolynomial κ), IsUnit f →
      ∃ (c : κ) (k : ℤ), c ≠ 0 ∧ f = LaurentPolynomial.C c * LaurentPolynomial.T k := by
    intro κ _ f hf
    obtain ⟨g, hfg⟩ := hf.exists_right_inv
    obtain ⟨n, p, hp⟩ := LaurentPolynomial.exists_T_pow f
    obtain ⟨m, q, hq⟩ := LaurentPolynomial.exists_T_pow g
    have hpq : p * q = Polynomial.X ^ (n + m) := by
      apply Polynomial.toLaurent_injective
      rw [map_mul, hp, hq, Polynomial.toLaurent_X_pow]
      calc f * LaurentPolynomial.T n * (g * LaurentPolynomial.T m)
          = (f * g) * (LaurentPolynomial.T n * LaurentPolynomial.T m) := by ring
      _ = LaurentPolynomial.T ((n + m : ℕ) : ℤ) := by
          rw [hfg, one_mul, ← LaurentPolynomial.T_add]; push_cast; rfl
    obtain ⟨i, -, hassoc⟩ := (dvd_prime_pow Polynomial.prime_X _).mp ⟨q, hpq.symm⟩
    obtain ⟨ε, hε⟩ := hassoc
    obtain ⟨r, hr, hrε⟩ := Polynomial.isUnit_iff.mp (ε⁻¹).isUnit
    have hp' : p = Polynomial.C r * Polynomial.X ^ i := by
      rw [hrε, ← hε, mul_comm, Units.mul_inv_cancel_right]
    refine ⟨r, (i : ℤ) - n, hr.ne_zero, ?_⟩
    have h1 : f * LaurentPolynomial.T n = LaurentPolynomial.C r * LaurentPolynomial.T i := by
      rw [← hp, hp', Polynomial.toLaurent_C_mul_X_pow]
    calc f = f * LaurentPolynomial.T n * LaurentPolynomial.T (-(n : ℤ)) := by
          rw [mul_assoc, ← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero, mul_one]
    _ = LaurentPolynomial.C r * LaurentPolynomial.T ((i : ℤ) - n) := by
          rw [h1, mul_assoc, ← LaurentPolynomial.T_add, sub_eq_add_neg]
  have L2 : ∀ (κ : Type u) [Field κ] (c : κ) (k : ℤ), c ≠ 0 →
      LaurentPolynomial.C c * LaurentPolynomial.T k ∈ Set.range (Polynomial.toLaurent (R := κ)) →
      0 ≤ k := by
    rintro κ _ c k hc ⟨p, hp⟩
    by_contra hk
    have hN : (((-k).toNat : ℕ) : ℤ) = -k := Int.toNat_of_nonneg (by omega)
    have h1 : p * Polynomial.X ^ ((-k).toNat) = Polynomial.C c := by
      apply Polynomial.toLaurent_injective
      rw [map_mul, hp, Polynomial.toLaurent_X_pow, Polynomial.toLaurent_C, hN, mul_assoc,
        ← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero, mul_one]
    have h2 := congrArg (fun z => Polynomial.coeff z 0) h1
    simp only [Polynomial.coeff_mul_X_pow', Polynomial.coeff_C_zero] at h2
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by omega))] at h2
    exact hc h2.symm
  have L3 : ∀ (κ : Type u) [Field κ] (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
      (φ : S →+* LaurentPolynomial κ),
      (∀ r : R, φ (algebraMap R S r) ∈ Set.range (Polynomial.toLaurent (R := κ))) →
      ∀ s : S, IsIntegral R s → φ s ∈ Set.range (Polynomial.toLaurent (R := κ)) := by
    intro κ _ R S _ _ _ φ hφ s hs
    obtain ⟨M, hMm, hM⟩ := hs
    have hlift : M.map (φ.comp (algebraMap R S)) ∈
        Polynomial.lifts (Polynomial.toLaurent (R := κ)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      exact hφ _
    obtain ⟨Q, hQ, -, hQm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift (hMm.map _)
    have hAM : algebraMap (Polynomial κ) (LaurentPolynomial κ) = Polynomial.toLaurent :=
      RingHom.ext fun f => LaurentPolynomial.algebraMap_eq_toLaurent f
    have hint : IsIntegral (Polynomial κ) (φ s) := by
      refine ⟨Q, hQm, ?_⟩
      rw [hAM, ← Polynomial.eval_map, hQ, Polynomial.eval_map, ← Polynomial.hom_eval₂, hM, map_zero]
    have hu : ∀ y : Submonoid.powers (Polynomial.X : Polynomial κ),
        IsUnit (algebraMap (Polynomial κ) (FractionRing (Polynomial κ)) y) := by
      rintro ⟨y, n, rfl⟩
      rw [map_pow]
      exact (IsUnit.mk0 _ ((map_ne_zero_iff _
        (IsFractionRing.injective (Polynomial κ) (FractionRing (Polynomial κ)))).mpr
        Polynomial.X_ne_zero)).pow n
    obtain ⟨ι, hιdef⟩ : ∃ ι : LaurentPolynomial κ →+* FractionRing (Polynomial κ),
        ι = IsLocalization.lift (M := Submonoid.powers Polynomial.X) hu := ⟨_, rfl⟩
    have hιc : ∀ p, ι (algebraMap (Polynomial κ) (LaurentPolynomial κ) p) =
        algebraMap _ (FractionRing (Polynomial κ)) p := fun p => by
      rw [hιdef]; exact IsLocalization.lift_eq hu p
    have hιinj : Function.Injective ι := by
      rw [hιdef, IsLocalization.lift_injective_iff]
      intro x y
      rw [LaurentPolynomial.algebraMap_eq_toLaurent, LaurentPolynomial.algebraMap_eq_toLaurent,
        Polynomial.toLaurent_inj,
        (IsFractionRing.injective (Polynomial κ) (FractionRing (Polynomial κ))).eq_iff]
    have hint' : IsIntegral (Polynomial κ) (ι (φ s)) :=
      IsIntegral.map_of_comp_eq (RingHom.id _) ι (RingHom.ext fun p => (hιc p).symm) hint
    obtain ⟨p, hp⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint'
    refine ⟨p, hιinj ?_⟩
    rw [← LaurentPolynomial.algebraMap_eq_toLaurent, hιc, hp]
  have L6 : ∀ (κ : Type u) [Field κ] (c : κ) (k : ℤ), c ≠ 0 →
      (1 + LaurentPolynomial.C c * LaurentPolynomial.T k = 0 ∨
        ∃ (c' : κ) (k' : ℤ), 1 + LaurentPolynomial.C c * LaurentPolynomial.T k =
          LaurentPolynomial.C c' * LaurentPolynomial.T k') → k = 0 := by
    intro κ _ c k hc h
    by_contra hk
    have e1 : (1 : LaurentPolynomial κ) = LaurentPolynomial.C 1 * LaurentPolynomial.T 0 := by
      rw [LaurentPolynomial.T_zero, map_one, mul_one]
    rcases h with h | ⟨c', k', h⟩
    · rw [e1, ← LaurentPolynomial.single_eq_C_mul_T, ← LaurentPolynomial.single_eq_C_mul_T] at h
      have := congrArg (fun z : LaurentPolynomial κ => z.coeff k) h
      simp only [AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_single,
        AddMonoidAlgebra.coeff_zero, Finsupp.add_apply, Finsupp.single_apply, Finsupp.coe_zero,
        Pi.zero_apply] at this
      simp [Ne.symm hk] at this
      exact hc this
    · rw [e1, ← LaurentPolynomial.single_eq_C_mul_T, ← LaurentPolynomial.single_eq_C_mul_T,
        ← LaurentPolynomial.single_eq_C_mul_T] at h
      have h0 := congrArg (fun z : LaurentPolynomial κ => z.coeff 0) h
      have hk' := congrArg (fun z : LaurentPolynomial κ => z.coeff k) h
      simp only [AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_single,
        Finsupp.add_apply, Finsupp.single_apply] at h0 hk'
      simp [hk, Ne.symm hk] at h0 hk'
      by_cases hk0 : k' = 0
      · subst hk0
        simp [Ne.symm hk] at hk'
        exact hc hk'
      · simp [hk0] at h0
  have hadd : ∀ (κ : Type u) [Field κ] (x y : LaurentPolynomial κ),
      x ∈ Set.range (Polynomial.toLaurent (R := κ)) →
      y ∈ Set.range (Polynomial.toLaurent (R := κ)) →
      x + y ∈ Set.range (Polynomial.toLaurent (R := κ)) := by
    rintro κ _ x y ⟨p, rfl⟩ ⟨q, rfl⟩
    exact ⟨p + q, map_add _ _ _⟩
  have hmul : ∀ (κ : Type u) [Field κ] (x y : LaurentPolynomial κ),
      x ∈ Set.range (Polynomial.toLaurent (R := κ)) →
      y ∈ Set.range (Polynomial.toLaurent (R := κ)) →
      x * y ∈ Set.range (Polynomial.toLaurent (R := κ)) := by
    rintro κ _ x y ⟨p, rfl⟩ ⟨q, rfl⟩
    exact ⟨p * q, map_mul _ _ _⟩
  have hCmem : ∀ (κ : Type u) [Field κ] (c : κ),
      LaurentPolynomial.C c ∈ Set.range (Polynomial.toLaurent (R := κ)) :=
    fun κ _ c => ⟨Polynomial.C c, Polynomial.toLaurent_C c⟩

  obtain ⟨e, he⟩ := ha'b
  obtain ⟨f₀, hf₀⟩ := hbg
  have hPD' := hPD
  obtain ⟨_, hNZ, _, hmax, _, _, hg0, huv, h𝔭, _⟩ := hPD'
  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases smul_eq_zero.mp hw with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    apply hg0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, ← huv, map_mul, h, zero_mul]
  have ha0 : algebraMap A K (algebraMap ↥W A a') ≠ 0 := by
    intro h
    apply ha'0
    apply hWA
    apply IsFractionRing.injective A K
    rw [map_zero, map_zero, h]
  have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hne
    obtain ⟨eu, rfl⟩ := IsLocalRing.notMem_maximalIdeal.mp hne
    exact hnba ⟨↑eu⁻¹, by rw [he, mul_assoc, Units.mul_inv, mul_one]⟩
  have hxy : wcLlsIsiS1 W A K u a' * wcLlsIsiS2 W A K u a' = 1 := by
    unfold wcLlsIsiS1 wcLlsIsiS2
    rw [div_mul_div_comm, mul_comm (algebraMap A K u), div_self (mul_ne_zero ha0 hu0)]
  obtain ⟨xC, hxCdef⟩ : ∃ xC : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L),
      xC = algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := ⟨_, rfl⟩
  have hxCv : (xC : L) = algebraMap K L (wcLlsIsiS1 W A K u a') := by rw [hxCdef]; rfl
  have hyCv : ((wcIccYC W A K L u a' : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)) : L) =
      algebraMap K L (wcLlsIsiS2 W A K u a') := rfl
  have hxyC : xC * wcIccYC W A K L u a' = 1 := Subtype.ext (by
    rw [MulMemClass.coe_mul, hxCv, hyCv, ← map_mul, hxy, map_one, OneMemClass.coe_one])
  obtain ⟨φA, hφA⟩ : ∃ φA : A →+* LaurentPolynomial (IsLocalRing.ResidueField ↥W),
      ∀ a, φA a = θ (algebraMap ↥(wcLlsIsiCR W A K u a')
        ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        (algebraMap A ↥(wcLlsIsiCR W A K u a') a)) := ⟨θ.comp ((algebraMap _ _).comp
          (algebraMap A ↥(wcLlsIsiCR W A K u a'))), fun a => rfl⟩

  have hu_eq : algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
      (algebraMap A ↥(wcLlsIsiCR W A K u a') u) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') a' * xC := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, hxCv]
    show algebraMap K L (algebraMap A K u) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A a')) * algebraMap K L (wcLlsIsiS1 W A K u a')
    rw [← map_mul]
    congr 1
    unfold wcLlsIsiS1
    rw [mul_div_cancel₀ _ ha0]
  have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A e) *
      algebraMap A K (algebraMap ↥W A f₀) * wcLlsIsiS2 W A K u a' := by
    unfold wcLlsIsiS2
    have h1 : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A a') *
        algebraMap A K (algebraMap ↥W A e) * algebraMap A K (algebraMap ↥W A f₀) := by
      have := congrArg (algebraMap A K) huv
      rw [hf₀, he] at this
      simpa only [map_mul] using this
    rw [← mul_div_assoc, eq_div_iff hu0]
    linear_combination h1
  have hv_eq : algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
      (algebraMap A ↥(wcLlsIsiCR W A K u a') v) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') e * wcIccCst W A K L (wcLlsIsiCR W A K u a') f₀ *
        wcIccYC W A K L u a' := by
    apply Subtype.ext
    rw [MulMemClass.coe_mul, MulMemClass.coe_mul, hyCv]
    show algebraMap K L (algebraMap A K v) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A e)) *
        algebraMap K L (algebraMap A K (algebraMap ↥W A f₀)) *
        algebraMap K L (wcLlsIsiS2 W A K u a')
    rw [hvK, map_mul, map_mul]
  have hw_eq : ∀ w : ↥W, algebraMap ↥(wcLlsIsiCR W A K u a')
      ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
      (algebraMap A ↥(wcLlsIsiCR W A K u a') (algebraMap ↥W A w)) =
      wcIccCst W A K L (wcLlsIsiCR W A K u a') w := fun w => Subtype.ext rfl
  have hkill : 𝔭 ≤ RingHom.ker φA := by
    rw [h𝔭]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with rfl | rfl
      · rw [SetLike.mem_coe, RingHom.mem_ker, hφA, hu_eq, map_mul, hθC,
          (IsLocalRing.residue_eq_zero_iff a').mpr ha'm, map_zero, zero_mul]
      · rw [SetLike.mem_coe, RingHom.mem_ker, hφA, hv_eq, map_mul, map_mul, hθC,
          (IsLocalRing.residue_eq_zero_iff e).mpr hem, map_zero, zero_mul, zero_mul]
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker, hφA, hw_eq w, hθC,
        (IsLocalRing.residue_eq_zero_iff w).mpr hw, map_zero]

  have hunitA : ∀ a : A, a ∉ 𝔭 → IsUnit (φA a) := by
    intro a ha
    obtain ⟨y', i, hi, hyi⟩ := hmax.exists_inv ha
    refine IsUnit.of_mul_eq_one (φA y') ?_
    have := congrArg φA hyi
    rw [map_add, map_mul, map_one, RingHom.mem_ker.mp (hkill hi), add_zero] at this
    rw [mul_comm]
    exact this
  have hconst : ∀ a : A, ∃ c, φA a = LaurentPolynomial.C c := by
    intro a
    by_cases ha : a ∈ 𝔭
    · exact ⟨0, by rw [RingHom.mem_ker.mp (hkill ha), map_zero]⟩
    obtain ⟨c₁, k₁, hc₁, h₁⟩ := L1 _ _ (hunitA a ha)
    have hk₁ : k₁ = 0 := by
      apply L6 _ c₁ k₁ hc₁
      by_cases ha1 : 1 + a ∈ 𝔭
      · left
        rw [← h₁, ← map_one φA, ← map_add]
        exact RingHom.mem_ker.mp (hkill ha1)
      · right
        obtain ⟨c', k', -, h'⟩ := L1 _ _ (hunitA _ ha1)
        exact ⟨c', k', by rw [← h₁, ← map_one φA, ← map_add]; exact h'⟩
    exact ⟨c₁, by rw [h₁, hk₁, LaurentPolynomial.T_zero, mul_one]⟩

  have adj : ∀ (θ' : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) →+*
        LaurentPolynomial (IsLocalRing.ResidueField ↥W)) (s : Set K)
      (hs : Algebra.adjoin A s ≤ wcLlsIsiCR W A K u a'),
      (∀ a : A, θ' (algebraMap ↥(wcLlsIsiCR W A K u a')
        ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        (algebraMap A ↥(wcLlsIsiCR W A K u a') a)) ∈ Set.range Polynomial.toLaurent) →
      (∀ x (hx : x ∈ s), θ' (algebraMap ↥(wcLlsIsiCR W A K u a')
        ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        ⟨x, hs (Algebra.subset_adjoin hx)⟩) ∈ Set.range Polynomial.toLaurent) →
      ∀ x (hx : x ∈ Algebra.adjoin A s), θ' (algebraMap ↥(wcLlsIsiCR W A K u a')
        ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) ⟨x, hs hx⟩) ∈
        Set.range Polynomial.toLaurent := by
    intro θ' s hs hA hgen x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hgen x hx
    | algebraMap a => exact hA a
    | add x y hx hy ihx ihy =>
      show θ' (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        ((⟨x, hs hx⟩ : ↥(wcLlsIsiCR W A K u a')) + ⟨y, hs hy⟩)) ∈ _
      rw [map_add, map_add]
      exact hadd _ _ _ ihx ihy
    | mul x y hx hy ihx ihy =>
      show θ' (algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        ((⟨x, hs hx⟩ : ↥(wcLlsIsiCR W A K u a')) * ⟨y, hs hy⟩)) ∈ _
      rw [map_mul, map_mul]
      exact hmul _ _ _ ihx ihy

  have hyunit : IsUnit (θ (wcIccYC W A K L u a')) :=
    IsUnit.of_mul_eq_one (θ xC) (by rw [← map_mul, mul_comm, hxyC, map_one])
  obtain ⟨c, k, hc, hθy⟩ := L1 _ _ hyunit

  have key : ∀ (θ' : ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) →+*
        LaurentPolynomial (IsLocalRing.ResidueField ↥W)) (c' : IsLocalRing.ResidueField ↥W)
      (n : ℕ), c' ≠ 0 → 0 < n →
      θ' (wcIccYC W A K L u a') = LaurentPolynomial.C c' * LaurentPolynomial.T (n : ℤ) →
      (∀ a : A, ∃ c₀, θ' (algebraMap ↥(wcLlsIsiCR W A K u a')
        ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        (algebraMap A ↥(wcLlsIsiCR W A K u a') a)) = LaurentPolynomial.C c₀) →
      ∀ δ : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
        θ' (wcIcxIncl L _ _ hoC δ) * θ' (wcIccYC W A K L u a') ≠ 1 := by
    intro θ' c' n hc' hn hy' hA' δ hδ
    have hSA : ∀ a : A, θ' (algebraMap ↥(wcLlsIsiCR W A K u a')
        ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
        (algebraMap A ↥(wcLlsIsiCR W A K u a') a)) ∈ Set.range Polynomial.toLaurent := by
      intro a
      obtain ⟨c₀, hc₀⟩ := hA' a
      rw [hc₀]
      exact hCmem _ c₀
    have hSy : θ' (wcIccYC W A K L u a') ∈ Set.range Polynomial.toLaurent :=
      ⟨Polynomial.C c' * Polynomial.X ^ n, by rw [hy', Polynomial.toLaurent_C_mul_X_pow]⟩
    have hRo : ∀ r : ↥(wcLlsASbS W A K u a'), (θ'.comp (wcIcxIncl L _ _ hoC))
        (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L) r) ∈
        Set.range Polynomial.toLaurent := by
      rintro ⟨r, hr⟩
      have e1 : wcIcxIncl L _ _ hoC (algebraMap ↥(wcLlsASbS W A K u a')
          ↥(integralClosure ↥(wcLlsASbS W A K u a') L) ⟨r, hr⟩) =
          algebraMap ↥(wcLlsIsiCR W A K u a') ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L)
            ⟨r, hoC hr⟩ := Subtype.ext rfl
      rw [RingHom.comp_apply, e1]
      refine adj θ' _ hoC hSA ?_ r hr
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact hSy
    have hδS := L3 _ _ _ (θ'.comp (wcIcxIncl L _ _ hoC)) hRo δ (Algebra.IsIntegral.isIntegral δ)
    have hδv : θ' (wcIcxIncl L _ _ hoC δ) =
        LaurentPolynomial.C c'⁻¹ * LaurentPolynomial.T (-(n : ℤ)) := by
      have hone : LaurentPolynomial.C c' * LaurentPolynomial.T (n : ℤ) *
          (LaurentPolynomial.C c'⁻¹ * LaurentPolynomial.T (-(n : ℤ))) =
          (1 : LaurentPolynomial (IsLocalRing.ResidueField ↥W)) := by
        rw [mul_mul_mul_comm, ← map_mul, mul_inv_cancel₀ hc', map_one, one_mul,
          ← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero]
      calc θ' (wcIcxIncl L _ _ hoC δ) = θ' (wcIcxIncl L _ _ hoC δ) *
            (LaurentPolynomial.C c' * LaurentPolynomial.T (n : ℤ) *
              (LaurentPolynomial.C c'⁻¹ * LaurentPolynomial.T (-(n : ℤ)))) := by
            rw [hone, mul_one]
      _ = (θ' (wcIcxIncl L _ _ hoC δ) * θ' (wcIccYC W A K L u a')) *
            (LaurentPolynomial.C c'⁻¹ * LaurentPolynomial.T (-(n : ℤ))) := by
            rw [hy']; ring
      _ = _ := by rw [hδ, one_mul]
    rw [RingHom.comp_apply, hδv] at hδS
    have := L2 _ c'⁻¹ (-(n : ℤ)) (inv_ne_zero hc') hδS
    omega

  have hk : k ≠ 0 := by
    intro hk0
    rw [hk0, LaurentPolynomial.T_zero, mul_one] at hθy
    have hθx : θ xC = LaurentPolynomial.C c⁻¹ := by
      have h1 : θ xC * θ (wcIccYC W A K L u a') = 1 := by rw [← map_mul, hxyC, map_one]
      calc θ xC = θ xC * (LaurentPolynomial.C c * LaurentPolynomial.C c⁻¹) := by
            rw [← map_mul, mul_inv_cancel₀ hc, map_one, mul_one]
      _ = (θ xC * θ (wcIccYC W A K L u a')) * LaurentPolynomial.C c⁻¹ := by rw [hθy]; ring
      _ = LaurentPolynomial.C c⁻¹ := by rw [h1, one_mul]
    have hRC : ∀ r : ↥(wcLlsIsiCR W A K u a'), θ (algebraMap ↥(wcLlsIsiCR W A K u a')
        ↥(integralClosure ↥(wcLlsIsiCR W A K u a') L) r) ∈ Set.range Polynomial.toLaurent := by
      rintro ⟨r, hr⟩
      refine adj θ _ le_rfl ?_ ?_ r hr
      · intro a
        obtain ⟨c₀, hc₀⟩ := hconst a
        rw [← hφA, hc₀]
        exact hCmem _ c₀
      · intro x hx
        rcases hx with rfl | hx
        · rw [← hxCdef, hθx]
          exact hCmem _ _
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          show θ (wcIccYC W A K L u a') ∈ _
          rw [hθy]
          exact hCmem _ _
    obtain ⟨γ, hγ⟩ := hsurj (LaurentPolynomial.T (-1))
    have hγS := L3 _ _ _ θ hRC γ (Algebra.IsIntegral.isIntegral γ)
    rw [hγ, ← one_mul (LaurentPolynomial.T (-1)), ← map_one LaurentPolynomial.C] at hγS
    have := L2 _ 1 (-1) one_ne_zero hγS
    omega
  refine ⟨c, k, hc, hk, hθy, ?_⟩

  intro δ hδ
  rcases lt_or_gt_of_ne hk with hneg | hpos
  · refine key ((LaurentPolynomial.invert.toRingEquiv.toRingHom).comp θ) c (-k).toNat hc
      (by omega) ?_ ?_ δ ?_
    · show LaurentPolynomial.invert (θ (wcIccYC W A K L u a')) = _
      rw [hθy, map_mul, LaurentPolynomial.invert_C, LaurentPolynomial.invert_T,
        Int.toNat_of_nonneg (by omega)]
    · intro a
      obtain ⟨c₀, hc₀⟩ := hconst a
      refine ⟨c₀, ?_⟩
      show LaurentPolynomial.invert (θ _) = _
      rw [← hφA, hc₀, LaurentPolynomial.invert_C]
    · show LaurentPolynomial.invert (θ (wcIcxIncl L _ _ hoC δ)) *
        LaurentPolynomial.invert (θ (wcIccYC W A K L u a')) = 1
      rw [← map_mul, hδ, map_one]
  · refine key θ c k.toNat hc (by omega) ?_ ?_ δ hδ
    · rw [hθy, Int.toNat_of_nonneg (by omega)]
    · intro a
      obtain ⟨c₀, hc₀⟩ := hconst a
      exact ⟨c₀, by rw [← hφA, hc₀]⟩

