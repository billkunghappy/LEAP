theorem wcpa_dj_llsm_dr_sep_element (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L]
    (y : Ideal ↥(integralClosure A L)) (hy : y.IsPrime)
    (hmax : (y.comap (algebraMap A ↥(integralClosure A L))).IsMaximal) :
    ∃ θ : L, wcDrSepEl A K L y θ :=
by
  classical
  haveI := hy
  have hcomm : ∀ (τ : L ≃ₐ[K] L) (a : A), τ (algebraMap A L a) = algebraMap A L a := by
    intro τ a
    rw [IsScalarTower.algebraMap_apply A K L, AlgEquiv.commutes]
  have hint : ∀ (τ : L ≃ₐ[K] L) (z : L), IsIntegral A z → IsIntegral A (τ z) := by
    intro τ z hz
    exact hz.map ((τ : L →ₐ[K] L).restrictScalars A)
  let res : (L ≃ₐ[K] L) → (↥(integralClosure A L) →+* ↥(integralClosure A L)) := fun τ =>
    { toFun := fun z => ⟨τ z, hint τ z z.2⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun a b => Subtype.ext (by simp)
      map_zero' := Subtype.ext (by simp)
      map_add' := fun a b => Subtype.ext (by simp) }
  have hres : ∀ τ z, ((res τ z : ↥(integralClosure A L)) : L) = τ (z : L) := fun _ _ => rfl
  have hres_mul : ∀ σ δ z, res σ (res δ z) = res (σ * δ) z := fun _ _ _ => Subtype.ext rfl
  have hres_one : ∀ z, res 1 z = z := fun _ => Subtype.ext rfl
  have hmemY : ∀ z : ↥(integralClosure A L),
      (z : L) ∈ Subtype.val '' (y : Set ↥(integralClosure A L)) ↔ z ∈ y := by
    intro z
    constructor
    · rintro ⟨w, hw, he⟩
      have : w = z := Subtype.ext he
      rw [← this]; exact hw
    · intro h; exact ⟨z, h, rfl⟩

  have hRint : (algebraMap A ↥(integralClosure A L)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  have hymax : y.IsMaximal := Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hRint y hmax
  have hcompeq : ∀ τ, (res τ).comp (algebraMap A ↥(integralClosure A L)) =
      algebraMap A ↥(integralClosure A L) := by
    intro τ
    refine RingHom.ext fun a => Subtype.ext ?_
    exact hcomm τ a
  let P : (L ≃ₐ[K] L) → Ideal ↥(integralClosure A L) := fun τ => y.comap (res τ)
  have hPprime : ∀ τ, (P τ).IsPrime := fun τ => Ideal.comap_isPrime _ _
  have hPmax : ∀ τ, (P τ).IsMaximal := by
    intro τ
    haveI := hPprime τ
    apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hRint
    show (Ideal.comap (algebraMap A _) (Ideal.comap (res τ) y)).IsMaximal
    rw [Ideal.comap_comap, hcompeq]; exact hmax
  have hPD : ∀ τ, P τ = y → τ ∈ wcLlsDec A K L y := by
    intro τ hPe
    open Pointwise in rw [wcLlsDec, MulAction.mem_stabilizer_iff]
    ext w
    open Pointwise in rw [Set.mem_smul_set]
    constructor
    · rintro ⟨z, ⟨z', hz', rfl⟩, rfl⟩
      have h1 : z' ∈ P τ := by rw [hPe]; exact hz'
      exact ⟨res τ z', h1, rfl⟩
    · rintro ⟨w', hw', rfl⟩
      have hinv : res τ (res τ⁻¹ w') = w' := by
        rw [hres_mul, mul_inv_cancel, hres_one]
      refine ⟨((res τ⁻¹ w' : ↥(integralClosure A L)) : L), ⟨res τ⁻¹ w', ?_, rfl⟩, ?_⟩
      · have h2 : res τ⁻¹ w' ∈ P τ := by
          show res τ (res τ⁻¹ w') ∈ y
          rw [hinv]; exact hw'
        rw [hPe] at h2; exact h2
      · rw [AlgEquiv.smul_def, ← hres, hinv]

  have hcop : ∀ τ, τ ∉ wcLlsDec A K L y → ∃ a ∈ y, 1 - a ∈ P τ := by
    intro τ hτ
    have hne : y ≠ P τ := fun h => hτ (hPD τ h.symm)
    have htop := Ideal.IsMaximal.coprime_of_ne hymax (hPmax τ) hne
    have h1 : (1 : ↥(integralClosure A L)) ∈ y ⊔ P τ := by rw [htop]; exact Submodule.mem_top
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
    refine ⟨a, ha, ?_⟩
    have : 1 - a = b := by rw [← hab]; ring
    rw [this]; exact hb
  choose! a ha ha' using hcop
  obtain ⟨S, hS⟩ : ∃ S : Finset (L ≃ₐ[K] L),
      S = Finset.univ.filter (fun τ => τ ∉ wcLlsDec A K L y) := ⟨_, rfl⟩
  obtain ⟨x0, hx0⟩ : ∃ x : ↥(integralClosure A L), x = 1 - ∏ τ ∈ S, (1 - a τ) := ⟨_, rfl⟩
  have hx0y : x0 ∈ y := by
    rw [hx0, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_prod, Finset.prod_eq_one,
      sub_self]
    intro τ hτ
    rw [hS] at hτ
    rw [map_sub, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr (ha τ (Finset.mem_filter.mp hτ).2),
      sub_zero]
  have hx0P : ∀ τ, τ ∉ wcLlsDec A K L y → x0 ∉ P τ := by
    intro τ hτ hx
    have hτS : τ ∈ S := by rw [hS]; exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hτ⟩
    have hprod : ∏ σ ∈ S, (1 - a σ) ∈ P τ := by
      rw [← Finset.mul_prod_erase S _ hτS]
      exact Ideal.mul_mem_right _ _ (ha' τ hτ)
    have h1 : (1 : ↥(integralClosure A L)) ∈ P τ := by
      have h2 := Ideal.add_mem _ hx hprod
      rwa [hx0, sub_add_cancel] at h2
    exact (hPprime τ).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  obtain ⟨t0, ht0⟩ : ∃ t : ↥(integralClosure A L),
      t = ∏ δ : ↥(wcLlsDec A K L y), res δ x0 := ⟨_, rfl⟩
  have ht0y : t0 ∈ y := by
    rw [ht0, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ (1 : ↥(wcLlsDec A K L y)))]
    apply Ideal.mul_mem_right
    have h1 : ((1 : ↥(wcLlsDec A K L y)) : L ≃ₐ[K] L) = 1 := rfl
    rw [h1, hres_one]; exact hx0y
  have hC2 : ∀ δ ∈ wcLlsDec A K L y, δ (t0 : L) = t0 := by
    intro δ hδ
    rw [← hres]
    congr 1
    rw [ht0, map_prod]
    simp_rw [hres_mul]
    exact Fintype.prod_equiv (Equiv.mulLeft (⟨δ, hδ⟩ : ↥(wcLlsDec A K L y))) _ _ (fun i => rfl)
  have hC3 : ∀ σ : L ≃ₐ[K] L, σ (t0 : L) ∈ Subtype.val '' (y : Set ↥(integralClosure A L)) →
      σ ∈ wcLlsDec A K L y := by
    intro σ hσ
    by_contra hσD
    rw [← hres, hmemY, ht0, map_prod] at hσ
    obtain ⟨δ, -, hδ⟩ := Ideal.IsPrime.prod_mem_iff.mp hσ
    rw [hres_mul] at hδ
    have hσδ : σ * δ ∉ wcLlsDec A K L y := by
      intro h
      apply hσD
      have h2 := (wcLlsDec A K L y).mul_mem h ((wcLlsDec A K L y).inv_mem δ.2)
      rwa [mul_inv_cancel_right] at h2
    exact hx0P _ hσδ hδ

  have hθA : IsIntegral A (t0 : L) := t0.2
  have hθK : IsIntegral K (t0 : L) := Algebra.IsIntegral.isIntegral _
  have hmK : minpoly K (t0 : L) = (minpoly A (t0 : L)).map (algebraMap A K) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' K hθA
  obtain ⟨fL, hfLdef⟩ : ∃ p : Polynomial L,
      p = (minpoly K (t0 : L)).map (algebraMap K L) := ⟨_, rfl⟩
  have hfLmon : fL.Monic := by rw [hfLdef]; exact (minpoly.monic hθK).map _
  have hfLne : fL ≠ 0 := hfLmon.ne_zero
  have hfLspl : fL.Splits := by rw [hfLdef]; exact Normal.splits inferInstance _
  have hfLsep : fL.Separable := by
    rw [hfLdef]; exact Polynomial.Separable.map (Algebra.IsSeparable.isSeparable K (t0 : L))
  have hnd : fL.roots.Nodup := Polynomial.nodup_roots hfLsep
  have hprod := hfLspl.eq_prod_roots_of_monic hfLmon
  have hroot : ∀ r : L, r ∈ fL.roots ↔ Polynomial.aeval r (minpoly K (t0 : L)) = 0 := by
    intro r
    rw [Polynomial.mem_roots hfLne, Polynomial.IsRoot.def, hfLdef, Polynomial.eval_map_algebraMap]
  have hθroot : (t0 : L) ∈ fL.roots := (hroot _).mpr (minpoly.aeval K _)
  have hfL : (minpoly A (t0 : L)).map (algebraMap A L) = fL := by
    rw [hfLdef, hmK, Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
  have hder : Polynomial.aeval (t0 : L) (Polynomial.derivative (minpoly A (t0 : L))) =
      ((fL.roots.erase (t0 : L)).map (fun r => (t0 : L) - r)).prod := by
    have h := Polynomial.eval_multiset_prod_X_sub_C_derivative hθroot
    rw [← hprod] at h
    rw [← Polynomial.eval_map_algebraMap, ← Polynomial.derivative_map, hfL]
    exact h
  let M : Submonoid L :=
    { carrier := {z | ∃ h : IsIntegral A z, (⟨z, h⟩ : ↥(integralClosure A L)) ∉ y}
      one_mem' := ⟨isIntegral_one, fun h => hy.ne_top ((Ideal.eq_top_iff_one _).mpr h)⟩
      mul_mem' := by
        rintro u v ⟨hu, hu'⟩ ⟨hv, hv'⟩
        exact ⟨hu.mul hv, fun h => (hy.mem_or_mem (x := ⟨u, hu⟩) (y := ⟨v, hv⟩) h).elim hu' hv'⟩ }
  have hM1 : ∀ z : ↥(integralClosure A L), (z : L) ∈ M → z ∉ y := by
    intro z hz
    obtain ⟨h, hn⟩ := hz
    exact hn
  have hM2 : ∀ z : ↥(integralClosure A L), z ∉ y → (z : L) ∈ M := fun z hz => ⟨z.2, hz⟩
  have hfac : ∀ r ∈ fL.roots.erase (t0 : L), (t0 : L) - r ∈ M := by
    intro r hr
    obtain ⟨hrθ, hr'⟩ := (Multiset.Nodup.mem_erase_iff hnd).mp hr
    have hr0 := (hroot r).mp hr'
    have heq : minpoly K (t0 : L) = minpoly K r :=
      minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hθK) hr0 (minpoly.monic hθK)
    obtain ⟨τ, hτ⟩ := MulAction.mem_orbit_iff.mp ((Normal.minpoly_eq_iff_mem_orbit L).mp heq.symm)
    rw [AlgEquiv.smul_def] at hτ
    have hτD : τ ∉ wcLlsDec A K L y := by
      intro h
      apply hrθ
      rw [← hτ]; exact hC2 τ h
    have hτY : res τ t0 ∉ y := fun h => hτD (hC3 τ ((hmemY _).mpr h))
    have hsub : t0 - res τ t0 ∉ y := by
      intro h
      apply hτY
      have h2 := Ideal.sub_mem y ht0y h
      rwa [sub_sub_cancel] at h2
    have h3 := hM2 _ hsub
    rw [← hτ]
    exact h3
  have hdM : Polynomial.aeval (t0 : L) (Polynomial.derivative (minpoly A (t0 : L))) ∈ M := by
    rw [hder]
    apply Submonoid.multiset_prod_mem
    intro z hz
    obtain ⟨r, hr, rfl⟩ := Multiset.mem_map.mp hz
    exact hfac r hr
  have hev : ∀ p : Polynomial A, Polynomial.aeval (t0 : L) p =
      ((Polynomial.aeval t0 p : ↥(integralClosure A L)) : L) :=
    fun p => Polynomial.aeval_algHom_apply (integralClosure A L).val t0 p
  have hd : Polynomial.aeval t0 (Polynomial.derivative (minpoly A (t0 : L))) ∉ y := by
    apply hM1; rw [← hev]; exact hdM
  have hdq : Polynomial.derivative (minpoly A (t0 : L)) = (minpoly A (t0 : L)).divX +
      Polynomial.X * Polynomial.derivative (minpoly A (t0 : L)).divX := by
    conv_lhs => rw [← Polynomial.X_mul_divX_add (minpoly A (t0 : L))]
    rw [Polynomial.derivative_add, Polynomial.derivative_mul, Polynomial.derivative_X,
      Polynomial.derivative_C, one_mul, add_zero]
  have hq : Polynomial.aeval t0 (minpoly A (t0 : L)).divX ∉ y := by
    intro h
    apply hd
    rw [hdq, map_add, map_mul, Polynomial.aeval_X]
    exact Ideal.add_mem _ h (Ideal.mul_mem_right _ _ ht0y)
  have hE : Polynomial.aeval (t0 : L) (wcDrE A (t0 : L)) ∉
      Subtype.val '' (y : Set ↥(integralClosure A L)) := by
    rw [hev, hmemY]
    unfold wcDrE
    rw [map_mul]
    intro h
    rcases hy.mem_or_mem h with h1 | h1
    · exact hd h1
    · exact hq h1
  refine ⟨(t0 : L), ?_⟩
  unfold wcDrSepEl
  exact ⟨⟨hθA, ht0y⟩, hC2, hC3, hE⟩

theorem wcpa_dj_llsm_dr_point_transfer {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Algebra ↥W A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L]
    (y : Ideal ↥(integralClosure A L)) (θ : L) (hy : y.IsPrime) (hθ : wcDrSepEl A K L y θ) :
    letI : Algebra ↥W ↥(wcDrA A K θ) := wcDrA.algW
    ∃ y'' : Ideal ↥(integralClosure ↥(wcDrA A K θ) L), y''.IsPrime ∧
      (y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L))).comap
          (algebraMap A ↥(wcDrA A K θ)) = y.comap (algebraMap A ↥(integralClosure A L)) ∧
      wcLlsUniq ↥(wcDrA A K θ) L
        (y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L))) y'' ∧
      Nonempty (↥(wcLlsDec ↥(wcDrA A K θ) ↥(wcDrK K θ) L y'') ≃* ↥(wcLlsDec A K L y)) ∧
      ∀ (_ : y.IsPrime) (_ : y''.IsPrime),
        Nonempty (wcLlsFS W ((algebraMap ↥(wcDrA A K θ) L).comp
            (algebraMap ↥W ↥(wcDrA A K θ))) ↥(wcDrA A K θ) y'' ≃+*
          wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  letI instW : Algebra ↥W ↥(wcDrA A K θ) := wcDrA.algW
  classical
  obtain ⟨⟨hθi, hθy⟩, hS2, hS3, hS4⟩ := hθ

  have s6 : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (ι : B →+* B'), Function.Injective ι →
      ∀ (e : B), IsUnit (ι e) → (∀ b' : B', ∃ (n : ℕ) (b : B), ι b = ι e ^ n * b') →
      ∀ (y : Ideal B), y.IsPrime → e ∉ y →
      ∃ y' : Ideal B', y'.IsPrime ∧ y'.comap ι = y ∧
        (∀ Q : Ideal B', Q.IsPrime → Q.comap ι = y → Q = y') ∧
        ∀ b', b' ∈ y' ↔ ∃ (n : ℕ) (c : B), c ∈ y ∧ ι c = ι e ^ n * b' := by
    intro B B' _ _ ι hι e he hsurj y hy hey
    have hpow : ∀ n : ℕ, e ^ n ∉ y := fun n h => hey (hy.mem_of_pow_mem n h)
    have hcancel : ∀ (n : ℕ) (b : B), e ^ n * b ∈ y → b ∈ y := fun n b h =>
      (hy.mem_or_mem h).resolve_left (hpow n)
    let y' : Ideal B' :=
      { carrier := {b' | ∃ (n : ℕ) (c : B), c ∈ y ∧ ι c = ι e ^ n * b'}
        add_mem' := by
          rintro a b ⟨n₁, c₁, hc₁, h₁⟩ ⟨n₂, c₂, hc₂, h₂⟩
          refine ⟨n₁ + n₂, e ^ n₂ * c₁ + e ^ n₁ * c₂,
            y.add_mem (y.mul_mem_left _ hc₁) (y.mul_mem_left _ hc₂), ?_⟩
          simp only [map_add, map_mul, map_pow, h₁, h₂]
          ring
        zero_mem' := ⟨0, 0, y.zero_mem, by simp⟩
        smul_mem' := by
          rintro r b ⟨n, c, hc, h⟩
          obtain ⟨m, a, ha⟩ := hsurj r
          refine ⟨m + n, a * c, y.mul_mem_left _ hc, ?_⟩
          simp only [map_mul, ha, h, smul_eq_mul]
          ring }
    have hmem : ∀ b', b' ∈ y' ↔ ∃ (n : ℕ) (c : B), c ∈ y ∧ ι c = ι e ^ n * b' := fun _ => Iff.rfl
    have key : ∀ (b' : B') (n : ℕ) (b : B), ι b = ι e ^ n * b' → (b' ∈ y' ↔ b ∈ y) := by
      intro b' n b hb
      rw [hmem]
      constructor
      · rintro ⟨m, c, hc, hcm⟩
        have h1 : ι (e ^ n * c) = ι (e ^ m * b) := by
          rw [map_mul, map_mul, map_pow, map_pow, hcm, hb]; ring
        have h2 := hι h1
        exact hcancel m b (h2 ▸ y.mul_mem_left _ hc)
      · intro hby
        exact ⟨n, b, hby, hb⟩
    have hcomap : y'.comap ι = y := by
      ext b
      rw [Ideal.mem_comap]
      exact key (ι b) 0 b (by rw [pow_zero, one_mul])
    have hprime : y'.IsPrime := by
      refine ⟨?_, ?_⟩
      · intro htop
        have h1 : (1 : B') ∈ y' := htop ▸ Submodule.mem_top
        rw [key 1 0 1 (by rw [pow_zero, one_mul, map_one])] at h1
        exact hy.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      · intro a b hab
        obtain ⟨n₁, a₁, ha₁⟩ := hsurj a
        obtain ⟨n₂, a₂, ha₂⟩ := hsurj b
        have h12 : ι (a₁ * a₂) = ι e ^ (n₁ + n₂) * (a * b) := by
          rw [map_mul, ha₁, ha₂]; ring
        rw [key _ _ _ h12] at hab
        rcases hy.mem_or_mem hab with h | h
        · exact Or.inl ((key _ _ _ ha₁).mpr h)
        · exact Or.inr ((key _ _ _ ha₂).mpr h)
    refine ⟨y', hprime, hcomap, ?_, hmem⟩
    intro Q hQ hQc
    ext b'
    obtain ⟨n, b, hb⟩ := hsurj b'
    rw [key b' n b hb, ← hQc, Ideal.mem_comap, hb]
    constructor
    · intro h
      exact Q.mul_mem_left _ h
    · intro h
      rcases hQ.mem_or_mem h with h1 | h1
      · exact absurd (Ideal.eq_top_of_isUnit_mem _ h1 (he.pow n)) hQ.ne_top
      · exact h1

  have s4 : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (ι : B →+* B'), Function.Injective ι →
      ∀ (e : B), IsUnit (ι e) → (∀ b' : B', ∃ (n : ℕ) (b : B), ι b = ι e ^ n * b') →
      ∀ (y : Ideal B) [y.IsPrime] (y' : Ideal B') [y'.IsPrime], y'.comap ι = y →
      ∀ (T : Set B) (T' : Set B'), T' = ι '' T →
      Nonempty (Localization.AtPrime y' ⧸
          Ideal.map (algebraMap B' (Localization.AtPrime y')) (Ideal.span T') ≃+*
        Localization.AtPrime y ⧸ Ideal.map (algebraMap B (Localization.AtPrime y)) (Ideal.span T)) := by
    intro B B' _ _ ι hι e he hsurj y _ y' hy' hc T T' hT
    letI : Algebra B (Localization.AtPrime y') := ((algebraMap B' _).comp ι).toAlgebra
    have halg : ∀ b, algebraMap B (Localization.AtPrime y') b = algebraMap B' _ (ι b) :=
      fun _ => rfl
    have hnot : ∀ s : B, s ∉ y → ι s ∉ y' := fun s hs h => hs (by rw [← hc]; exact h)
    have heu : ι e ∉ y' := fun h => hy'.ne_top (Ideal.eq_top_of_isUnit_mem _ h he)
    have hpowu : ∀ (m : ℕ) (t' : B'), t' ∉ y' → ι e ^ m * t' ∉ y' := by
      intro m t' ht' h
      rcases hy'.mem_or_mem h with h1 | h1
      · exact heu (hy'.mem_of_pow_mem _ h1)
      · exact ht' h1
    have hback : ∀ (m : ℕ) (t : B) (t' : B'), t' ∉ y' → ι t = ι e ^ m * t' → t ∉ y := by
      intro m t t' ht' ht h
      have h1 : ι t ∈ y' := by rw [← hc] at h; exact h
      rw [ht] at h1
      exact hpowu m t' ht' h1
    haveI : IsLocalization y.primeCompl (Localization.AtPrime y') := by
      constructor
      constructor
      · rintro ⟨s, hs⟩
        rw [halg]
        exact IsLocalization.map_units (Localization.AtPrime y') (⟨ι s, hnot s hs⟩ : y'.primeCompl)
      · intro z
        obtain ⟨⟨b', t'⟩, rfl⟩ := IsLocalization.mk'_surjective y'.primeCompl z
        obtain ⟨n, b, hb⟩ := hsurj b'
        obtain ⟨m, t, ht⟩ := hsurj (t' : B')
        have hnt : ι (e ^ n * t) = ι e ^ (n + m) * (t' : B') := by
          rw [map_mul, map_pow, ht]; ring
        have ht' : e ^ n * t ∉ y := hback (n + m) _ t' t'.2 hnt
        refine ⟨⟨e ^ m * b, ⟨e ^ n * t, ht'⟩⟩, ?_⟩
        have e2 : ι (e ^ m * b) = ι e ^ (n + m) * b' := by
          rw [map_mul, map_pow, hb]; ring
        show _ * algebraMap B (Localization.AtPrime y') (e ^ n * t) =
          algebraMap B (Localization.AtPrime y') (e ^ m * b)
        rw [halg, halg, hnt, e2, map_mul, map_mul,
          ← IsLocalization.mk'_spec (Localization.AtPrime y') b' t']
        ring
      · intro a₁ a₂ h
        rw [halg, halg] at h
        obtain ⟨c, h'⟩ := (IsLocalization.eq_iff_exists y'.primeCompl _).mp h
        obtain ⟨m, t, ht⟩ := hsurj (c : B')
        refine ⟨⟨t, hback m t c c.2 ht⟩, hι ?_⟩
        show ι (t * a₁) = ι (t * a₂)
        rw [map_mul, map_mul, ht, mul_assoc, mul_assoc, h']
    let φ : Localization.AtPrime y' ≃+* Localization.AtPrime y :=
      (IsLocalization.algEquiv y.primeCompl (Localization.AtPrime y')
        (Localization.AtPrime y)).toRingEquiv
    have hφ : ∀ b : B, φ (algebraMap B' _ (ι b)) = algebraMap B _ b := fun b =>
      (IsLocalization.algEquiv y.primeCompl (Localization.AtPrime y')
        (Localization.AtPrime y)).commutes b
    subst hT
    refine ⟨Ideal.quotientEquiv _ _ φ ?_⟩
    rw [Ideal.map_span, Ideal.map_span, Ideal.map_span]
    congr 1
    ext z
    constructor
    · rintro ⟨b, hb, rfl⟩
      exact ⟨_, ⟨ι b, ⟨b, hb, rfl⟩, rfl⟩, hφ b⟩
    · rintro ⟨_, ⟨_, ⟨b, hb, rfl⟩, rfl⟩, rfl⟩
      exact ⟨b, hb, (hφ b).symm⟩

  have hbij : ∀ {M : Type u} (g : M → M), Function.Bijective g → ∀ S : Set M,
      (g '' S = S ↔ ∀ x, g x ∈ S ↔ x ∈ S) := by
    intro M g hg S
    constructor
    · intro h x
      constructor
      · intro hx
        have : g x ∈ g '' S := by rw [h]; exact hx
        obtain ⟨z, hz, hzx⟩ := this
        exact hg.1 hzx ▸ hz
      · intro hx
        rw [← h]; exact ⟨x, hx, rfl⟩
    · intro h
      ext z
      obtain ⟨x, rfl⟩ := hg.2 z
      constructor
      · rintro ⟨w, hw, hwx⟩
        rw [← hwx]; exact (h w).mpr hw
      · intro hz
        exact ⟨x, (h x).mp hz, rfl⟩

  have s3 : ∀ (P Q : Ideal ↥(integralClosure A L)), P.IsPrime → Q.IsPrime →
      P.comap (algebraMap A ↥(integralClosure A L)) =
        Q.comap (algebraMap A ↥(integralClosure A L)) →
      ∃ σ : L ≃ₐ[K] L, Subtype.val '' (Q : Set ↥(integralClosure A L)) =
        (fun x => σ x) '' (Subtype.val '' (P : Set ↥(integralClosure A L))) := by
    intro P Q hP hQ hPQ
    haveI := hP
    haveI := hQ
    haveI : Algebra.IsAlgebraic A K := IsLocalization.isAlgebraic K (nonZeroDivisors A)
    haveI : Algebra.IsAlgebraic A L := Algebra.IsAlgebraic.trans A K L
    have hinj : ∀ x : A, algebraMap A L x = 0 → x = 0 := by
      intro x hx
      rw [IsScalarTower.algebraMap_apply A K L] at hx
      have h1 := (algebraMap K L).injective (hx.trans (map_zero _).symm)
      exact IsFractionRing.injective A K (h1.trans (map_zero _).symm)
    haveI : IsFractionRing (integralClosure A L) L :=
      integralClosure.isFractionRing_of_algebraic hinj
    haveI : Finite (integralClosure A L ≃ₐ[A] integralClosure A L) :=
      Finite.of_equiv _ (galRestrict A K L (integralClosure A L)).toEquiv
    haveI : Algebra.IsInvariant A (integralClosure A L)
        (integralClosure A L ≃ₐ[A] integralClosure A L) :=
      Algebra.isInvariant_of_isGalois' A K L (integralClosure A L)
    haveI : SMulCommClass (integralClosure A L ≃ₐ[A] integralClosure A L) A
        (integralClosure A L) := SMulCommClass.symm _ _ _
    obtain ⟨h, hh⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A (integralClosure A L)
      (integralClosure A L ≃ₐ[A] integralClosure A L) P Q
      (by rw [Ideal.under_def, Ideal.under_def, hPQ])
    set σ := (galRestrict A K L (integralClosure A L)).symm h with hσ
    have hgσ : galRestrict A K L (integralClosure A L) σ = h := by
      rw [hσ, MulEquiv.apply_symm_apply]
    have hQeq : Q = P.comap (galRestrict A K L (integralClosure A L) σ).symm := by
      rw [hh, hgσ, Ideal.pointwise_smul_eq_comap]
      rfl
    have hval : ∀ b : integralClosure A L,
        ((galRestrict A K L (integralClosure A L) σ b : integralClosure A L) : L) = σ (b : L) :=
      fun b => algebraMap_galRestrict_apply A σ b
    refine ⟨σ, ?_⟩
    rw [hQeq]
    ext x
    simp only [Set.mem_image, SetLike.mem_coe, Ideal.mem_comap]
    constructor
    · rintro ⟨b, hb, rfl⟩
      refine ⟨_, ⟨_, hb, rfl⟩, ?_⟩
      rw [← hval, AlgEquiv.apply_symm_apply]
    · rintro ⟨_, ⟨b, hb, rfl⟩, rfl⟩
      refine ⟨galRestrict A K L (integralClosure A L) σ b, ?_, hval b⟩
      rwa [AlgEquiv.symm_apply_apply]

  haveI hAt : IsScalarTower A ↥(wcDrA A K θ) L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hεc : ((Polynomial.aeval (wcDrTh K θ) (wcDrE A θ) : ↥(wcDrK K θ)) : L) =
      Polynomial.aeval θ (wcDrE A θ) := (IntermediateField.aeval_coe _ _ _).symm
  have hε0 : Polynomial.aeval θ (wcDrE A θ) ≠ 0 := by
    intro h
    exact hS4 ⟨0, y.zero_mem, by rw [h]; rfl⟩
  have hεinvc : (((Polynomial.aeval (wcDrTh K θ) (wcDrE A θ))⁻¹ : ↥(wcDrK K θ)) : L) =
      (Polynomial.aeval θ (wcDrE A θ))⁻¹ := by
    rw [IntermediateField.coe_inv, hεc]
  have hεint : IsIntegral A (Polynomial.aeval θ (wcDrE A θ)) := by
    have h := (Polynomial.aeval (⟨θ, hθi⟩ : ↥(integralClosure A L)) (wcDrE A θ)).2
    rw [Polynomial.aeval_subalgebra_coe] at h
    exact h
  have hεE : Polynomial.aeval θ (wcDrE A θ) ∈ wcDrK K θ := by
    rw [← hεc]; exact SetLike.coe_mem _
  set ε : L := Polynomial.aeval θ (wcDrE A θ) with hεdef
  let θA : ↥(wcDrA A K θ) := ⟨wcDrTh K θ, Algebra.subset_adjoin (Set.mem_insert _ _)⟩
  let ηA : ↥(wcDrA A K θ) := ⟨(Polynomial.aeval (wcDrTh K θ) (wcDrE A θ))⁻¹,
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  have hηA : algebraMap ↥(wcDrA A K θ) L ηA = ε⁻¹ := hεinvc
  let εA : ↥(wcDrA A K θ) := Polynomial.aeval θA (wcDrE A θ)
  have hεA : algebraMap ↥(wcDrA A K θ) L εA = ε := by
    show (((Polynomial.aeval θA (wcDrE A θ) : ↥(wcDrA A K θ)) : ↥(wcDrK K θ)) : L) = ε
    rw [Polynomial.aeval_subalgebra_coe]
    exact hεc

  have hR : ∀ r : ↥(wcDrA A K θ), ∃ n : ℕ,
      IsIntegral A (ε ^ n * algebraMap ↥(wcDrA A K θ) L r) := by
    rintro ⟨r, hr⟩
    show ∃ n : ℕ, IsIntegral A (ε ^ n * ((r : ↥(wcDrK K θ)) : L))
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨0, by rw [pow_zero, one_mul]; exact hθi⟩
      · refine ⟨1, ?_⟩
        rw [hεinvc, pow_one, mul_inv_cancel₀ hε0]
        exact isIntegral_one
    | algebraMap a =>
      have e : ((algebraMap A ↥(wcDrK K θ) a : ↥(wcDrK K θ)) : L) = algebraMap A L a := rfl
      exact ⟨0, by rw [pow_zero, one_mul, e]; exact isIntegral_algebraMap⟩
    | add x z _ _ hx hz =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hz
      refine ⟨n₁ + n₂, ?_⟩
      have e : ε ^ (n₁ + n₂) * ((x + z : ↥(wcDrK K θ)) : L) =
          ε ^ n₂ * (ε ^ n₁ * (x : L)) + ε ^ n₁ * (ε ^ n₂ * (z : L)) := by
        rw [IntermediateField.coe_add]; ring
      rw [e]
      exact ((hεint.pow _).mul h₁).add ((hεint.pow _).mul h₂)
    | mul x z _ _ hx hz =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hz
      refine ⟨n₁ + n₂, ?_⟩
      have e : ε ^ (n₁ + n₂) * ((x * z : ↥(wcDrK K θ)) : L) =
          (ε ^ n₁ * (x : L)) * (ε ^ n₂ * (z : L)) := by
        rw [IntermediateField.coe_mul]; ring
      rw [e]
      exact h₁.mul h₂

  have hdesc : ∀ x : L, IsIntegral ↥(wcDrA A K θ) x → ∃ n : ℕ, IsIntegral A (ε ^ n * x) := by
    rintro x ⟨p, hpm, hpx⟩
    choose nf hnf using hR
    refine ⟨∑ i ∈ Finset.range (p.natDegree + 1), nf (p.coeff i), ?_⟩
    set N := ∑ i ∈ Finset.range (p.natDegree + 1), nf (p.coeff i) with hN
    have hc : ∀ i, IsIntegral A (ε ^ N * algebraMap ↥(wcDrA A K θ) L (p.coeff i)) := by
      intro i
      by_cases hi : i ≤ p.natDegree
      · have hle : nf (p.coeff i) ≤ N :=
          Finset.single_le_sum (f := fun j => nf (p.coeff j)) (fun _ _ => Nat.zero_le _)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
        rw [← Nat.sub_add_cancel hle, pow_add, mul_assoc]
        exact (hεint.pow _).mul (hnf _)
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), map_zero, mul_zero]
        exact isIntegral_zero
    set P : Polynomial L := (p.scaleRoots (εA ^ N)).map (algebraMap ↥(wcDrA A K θ) L) with hP
    have hsε : algebraMap ↥(wcDrA A K θ) L (εA ^ N) = ε ^ N := by rw [map_pow, hεA]
    have hPm : P.Monic := ((Polynomial.monic_scaleRoots_iff _).mpr hpm).map _
    have hPc : ∀ i, IsIntegral A (P.coeff i) := by
      intro i
      rw [hP, Polynomial.coeff_map, Polynomial.coeff_scaleRoots, map_mul, map_pow, hsε]
      rcases lt_trichotomy i p.natDegree with h | h | h
      · obtain ⟨k, hk⟩ : ∃ k, p.natDegree - i = k + 1 := ⟨p.natDegree - i - 1, by omega⟩
        have e : algebraMap ↥(wcDrA A K θ) L (p.coeff i) * (ε ^ N) ^ (p.natDegree - i) =
            (ε ^ N * algebraMap ↥(wcDrA A K θ) L (p.coeff i)) * (ε ^ N) ^ k := by
          rw [hk]; ring
        rw [e]
        exact (hc i).mul ((hεint.pow N).pow k)
      · rw [h, Nat.sub_self, pow_zero, mul_one, hpm.coeff_natDegree, map_one]
        exact isIntegral_one
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, map_zero, zero_mul]
        exact isIntegral_zero
    have hroot : Polynomial.eval (ε ^ N * x) P = 0 := by
      rw [hP, Polynomial.eval_map, ← hsε]
      exact Polynomial.scaleRoots_eval₂_eq_zero _ hpx
    have hlift : P ∈ Polynomial.lifts (algebraMap ↥(integralClosure A L) L) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨P.coeff i, hPc i⟩, rfl⟩
    obtain ⟨q, hqP, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hPm
    have hI : IsIntegral ↥(integralClosure A L) (ε ^ N * x) :=
      ⟨q, hqm, by rw [← Polynomial.eval_map, hqP, hroot]⟩
    exact isIntegral_trans _ hI

  have hup : ∀ c : L, IsIntegral A c → ∀ n : ℕ, IsIntegral ↥(wcDrA A K θ) ((ε⁻¹) ^ n * c) := by
    intro c hc n
    rw [← hηA]
    exact ((isIntegral_algebraMap).pow n).mul hc.tower_top

  let ι : ↥(integralClosure A L) →+* ↥(integralClosure ↥(wcDrA A K θ) L) :=
    ((integralClosure A L).val.toRingHom).codRestrict (integralClosure ↥(wcDrA A K θ) L)
      (fun x => IsIntegral.tower_top (A := ↥(wcDrA A K θ)) x.2)
  have hιv : ∀ b, ((ι b : ↥(integralClosure ↥(wcDrA A K θ) L)) : L) = (b : L) := fun _ => rfl
  have hιinj : Function.Injective ι := fun a b h => Subtype.ext (by
    have := congrArg (fun z : ↥(integralClosure ↥(wcDrA A K θ) L) => (z : L)) h
    simpa only [hιv] using this)
  let εt : ↥(integralClosure A L) := ⟨ε, hεint⟩
  have hεinvI : IsIntegral ↥(wcDrA A K θ) ε⁻¹ := by rw [← hηA]; exact isIntegral_algebraMap
  have hεu : IsUnit (ι εt) := by
    have h1 : ι εt * ⟨ε⁻¹, hεinvI⟩ = 1 := by
      apply Subtype.ext
      show ε * ε⁻¹ = (1 : L)
      exact mul_inv_cancel₀ hε0
    exact ⟨⟨ι εt, ⟨ε⁻¹, hεinvI⟩, h1, by rw [mul_comm]; exact h1⟩, rfl⟩
  have hsurj : ∀ b' : ↥(integralClosure ↥(wcDrA A K θ) L),
      ∃ (n : ℕ) (b : ↥(integralClosure A L)), ι b = ι εt ^ n * b' := by
    intro b'
    obtain ⟨n, hn⟩ := hdesc (b' : L) b'.2
    refine ⟨n, ⟨ε ^ n * b', hn⟩, Subtype.ext ?_⟩
    rw [Subalgebra.coe_mul, Subalgebra.coe_pow]
    rfl
  have hεy : εt ∉ y := fun h => hS4 ⟨εt, h, rfl⟩
  obtain ⟨y'', hy''P, hy''c, hy''U, hy''m⟩ :=
    @s6 ↥(integralClosure A L) ↥(integralClosure ↥(wcDrA A K θ) L) _ _ ι hιinj εt hεu hsurj
      y hy hεy

  have hfac : (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L)).comp
      (algebraMap A ↥(wcDrA A K θ)) = ι.comp (algebraMap A ↥(integralClosure A L)) :=
    RingHom.ext fun _ => Subtype.ext rfl
  have hG2 : (y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L))).comap
      (algebraMap A ↥(wcDrA A K θ)) = y.comap (algebraMap A ↥(integralClosure A L)) := by
    rw [Ideal.comap_comap, hfac, ← Ideal.comap_comap, hy''c]
  have hmemD : ∀ σ : L ≃ₐ[K] L, σ ∈ wcLlsDec A K L y ↔
      (fun x => σ x) '' (Subtype.val '' (y : Set ↥(integralClosure A L))) =
        Subtype.val '' (y : Set ↥(integralClosure A L)) := by
    intro σ
    unfold wcLlsDec
    open Pointwise in
    exact (MulAction.mem_stabilizer_iff).trans (by rw [← Set.image_smul]; exact Iff.rfl)
  have hmemD'' : ∀ σ : L ≃ₐ[↥(wcDrK K θ)] L,
      σ ∈ wcLlsDec ↥(wcDrA A K θ) ↥(wcDrK K θ) L y'' ↔
      (fun x => σ x) '' (Subtype.val '' (y'' : Set ↥(integralClosure ↥(wcDrA A K θ) L))) =
        Subtype.val '' (y'' : Set ↥(integralClosure ↥(wcDrA A K θ) L)) := by
    intro σ
    unfold wcLlsDec
    open Pointwise in
    exact (MulAction.mem_stabilizer_iff).trans (by rw [← Set.image_smul]; exact Iff.rfl)

  have hUniq : wcLlsUniq ↥(wcDrA A K θ) L
      (y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L))) y'' := by
    intro Q hQ hQc
    haveI := hQ
    apply hy''U Q hQ
    have hQ0 : (Q.comap ι).IsPrime := Ideal.comap_isPrime ι Q
    have hcon : y.comap (algebraMap A ↥(integralClosure A L)) =
        (Q.comap ι).comap (algebraMap A ↥(integralClosure A L)) := by
      rw [Ideal.comap_comap, ← hfac, ← Ideal.comap_comap, hQc, hG2]
    obtain ⟨σ, hσ⟩ := s3 y (Q.comap ι) hy hQ0 hcon
    have hθQ : (⟨θ, hθi⟩ : ↥(integralClosure A L)) ∈ Q.comap ι := by
      have h3 : algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L) θA =
          ι ⟨θ, hθi⟩ := Subtype.ext rfl
      have h1 : θA ∈
          y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L)) := by
        rw [Ideal.mem_comap, h3]
        have h2 : (⟨θ, hθi⟩ : ↥(integralClosure A L)) ∈ y''.comap ι := by rw [hy''c]; exact hθy
        exact h2
      rw [← hQc, Ideal.mem_comap, h3] at h1
      exact h1
    have hθmem : θ ∈ (fun x => σ x) '' (Subtype.val '' (y : Set ↥(integralClosure A L))) := by
      rw [← hσ]; exact ⟨_, hθQ, rfl⟩
    obtain ⟨z, hz, hσz⟩ := hθmem
    have hσinv : σ⁻¹ ∈ wcLlsDec A K L y := by
      apply hS3
      have e : (σ⁻¹ : L ≃ₐ[K] L) θ = z := by
        show σ.symm θ = z
        rw [← hσz]
        exact σ.symm_apply_apply z
      rw [e]; exact hz
    have hσD : σ ∈ wcLlsDec A K L y := by
      have := inv_mem hσinv
      rwa [inv_inv] at this
    rw [(hmemD σ).mp hσD] at hσ
    exact SetLike.coe_injective ((Set.image_injective.mpr Subtype.val_injective) hσ)

  have hY''char : ∀ x : L,
      x ∈ Subtype.val '' (y'' : Set ↥(integralClosure ↥(wcDrA A K θ) L)) ↔
      ∃ n : ℕ, ε ^ n * x ∈ Subtype.val '' (y : Set ↥(integralClosure A L)) := by
    intro x
    constructor
    · rintro ⟨b', hb', rfl⟩
      obtain ⟨n, c, hc, hcb⟩ := (hy''m b').mp hb'
      refine ⟨n, c, hc, ?_⟩
      have := congrArg (fun z : ↥(integralClosure ↥(wcDrA A K θ) L) => (z : L)) hcb
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, hιv] at this
      exact this
    · rintro ⟨n, c, hc, hcx⟩
      have hxI : IsIntegral ↥(wcDrA A K θ) x := by
        have e : x = (ε⁻¹) ^ n * (c : L) := by
          rw [hcx, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ hε0, one_pow, one_mul]
        rw [e]; exact hup _ c.2 n
      refine ⟨⟨x, hxI⟩, (hy''m _).mpr ⟨n, c, hc, Subtype.ext ?_⟩, rfl⟩
      rw [Subalgebra.coe_mul, Subalgebra.coe_pow]
      exact hcx
  have hYchar : ∀ x : L, x ∈ Subtype.val '' (y : Set ↥(integralClosure A L)) ↔
      x ∈ Subtype.val '' (y'' : Set ↥(integralClosure ↥(wcDrA A K θ) L)) ∧ IsIntegral A x := by
    intro x
    constructor
    · rintro ⟨c, hc, rfl⟩
      refine ⟨⟨ι c, ?_, rfl⟩, c.2⟩
      have : c ∈ y''.comap ι := by rw [hy''c]; exact hc
      exact this
    · rintro ⟨⟨b', hb', rfl⟩, hxI⟩
      have hxI' : (b' : L) ∈ integralClosure A L := (mem_integralClosure_iff _ _).mpr hxI
      refine ⟨⟨(b' : L), hxI'⟩, ?_, rfl⟩
      have hιb : ι ⟨(b' : L), hxI'⟩ = b' := Subtype.ext rfl
      rw [SetLike.mem_coe, ← hy''c, Ideal.mem_comap, hιb]
      exact hb'
  have hfix : ∀ δ ∈ wcLlsDec A K L y, ∀ x ∈ wcDrK K θ, δ x = x := by
    intro δ hδ x hx
    have hle : wcDrK K θ ≤ IntermediateField.fixedField (wcLlsDec A K L y) := by
      rw [IntermediateField.adjoin_simple_le_iff, IntermediateField.mem_fixedField_iff]
      exact hS2
    exact (IntermediateField.mem_fixedField_iff _ _).mp (hle hx) δ hδ
  have hequiv : ∀ g : L ≃ₐ[K] L, g ε = ε →
      ((fun x => g x) '' (Subtype.val '' (y'' : Set ↥(integralClosure ↥(wcDrA A K θ) L))) =
          Subtype.val '' (y'' : Set ↥(integralClosure ↥(wcDrA A K θ) L)) ↔
        (fun x => g x) '' (Subtype.val '' (y : Set ↥(integralClosure A L))) =
          Subtype.val '' (y : Set ↥(integralClosure A L))) := by
    intro g hg
    have hgi : ∀ x, IsIntegral A (g x) ↔ IsIntegral A x :=
      fun x => isIntegral_algEquiv (g.restrictScalars A)
    have hm : ∀ (n : ℕ) (x : L), ε ^ n * g x = g (ε ^ n * x) := by
      intro n x; rw [map_mul, map_pow, hg]
    rw [hbij (fun x => g x) g.bijective, hbij (fun x => g x) g.bijective]
    beta_reduce
    constructor
    · intro h x
      rw [hYchar, hYchar, h, hgi]
    · intro h x
      rw [hY''char, hY''char]
      simp only [hm, h]

  have hG4 : Nonempty (↥(wcLlsDec ↥(wcDrA A K θ) ↥(wcDrK K θ) L y'') ≃* ↥(wcLlsDec A K L y)) := by
    have hres : ∀ σ : L ≃ₐ[↥(wcDrK K θ)] L, (σ.restrictScalars K) ε = ε := by
      intro σ
      exact σ.commutes (⟨ε, hεE⟩ : ↥(wcDrK K θ))
    let Φ : ↥(wcLlsDec ↥(wcDrA A K θ) ↥(wcDrK K θ) L y'') →* ↥(wcLlsDec A K L y) :=
      { toFun := fun σ => ⟨(σ.1 : L ≃ₐ[↥(wcDrK K θ)] L).restrictScalars K,
          (hmemD _).mpr ((hequiv _ (hres σ.1)).mp ((hmemD'' σ.1).mp σ.2))⟩
        map_one' := Subtype.ext (AlgEquiv.ext fun _ => rfl)
        map_mul' := fun _ _ => Subtype.ext (AlgEquiv.ext fun _ => rfl) }
    refine ⟨MulEquiv.ofBijective Φ ⟨?_, ?_⟩⟩
    · intro a b h
      apply Subtype.ext
      apply AlgEquiv.ext
      intro x
      have := congrArg (fun f : ↥(wcLlsDec A K L y) => (f.1 : L ≃ₐ[K] L) x) h
      exact this
    · rintro ⟨δ, hδ⟩
      let σ : L ≃ₐ[↥(wcDrK K θ)] L := AlgEquiv.ofRingEquiv (f := δ.toRingEquiv)
        (fun x => hfix δ hδ x x.2)
      have hσ : σ ∈ wcLlsDec ↥(wcDrA A K θ) ↥(wcDrK K θ) L y'' := by
        rw [hmemD'']
        exact (hequiv δ (hfix δ hδ ε hεE)).mpr ((hmemD δ).mp hδ)
      exact ⟨⟨σ, hσ⟩, Subtype.ext (AlgEquiv.ext fun _ => rfl)⟩
  refine ⟨y'', hy''P, hG2, hUniq, hG4, ?_⟩

  intro hyP hy''P'
  have hT : {b : ↥(integralClosure ↥(wcDrA A K θ) L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap ↥(wcDrA A K θ) L).comp (algebraMap ↥W ↥(wcDrA A K θ))) w} =
      ι '' {b : ↥(integralClosure A L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} := by
    ext b'
    constructor
    · rintro ⟨w0, hw0, hb'⟩
      refine ⟨algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w0), ⟨w0, hw0, rfl⟩, ?_⟩
      exact Subtype.ext hb'.symm
    · rintro ⟨b, ⟨w0, hw0, hb⟩, rfl⟩
      exact ⟨w0, hw0, hb⟩
  exact @s4 _ _ _ _ ι hιinj εt hεu hsurj y hyP y'' hy''P' hy''c _ _ hT

theorem wcpa_dj_llsm_dr_chart_pd {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A) (y : Ideal ↥(integralClosure A L)) (θ : L)
    (hPD : wcLlsPD W A 𝔭 k) (hy : y.IsPrime)
    (hy𝔭 : y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭) (hθ : wcDrSepEl A K L y θ) :
    letI : Algebra ↥W ↥(wcDrA A K θ) := wcDrA.algW
    IsFractionRing ↥(wcDrA A K θ) ↥(wcDrK K θ) ∧
    (∀ x : ↥(wcDrA A K θ), ∃ a : A,
      x - algebraMap A ↥(wcDrA A K θ) a ∈ Ideal.map (algebraMap A ↥(wcDrA A K θ)) 𝔭) ∧
    wcLlsPD W ↥(wcDrA A K θ) (Ideal.map (algebraMap A ↥(wcDrA A K θ)) 𝔭)
      (wcDrKind (algebraMap A ↥(wcDrA A K θ)) k) :=
by
  have hConductor : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
      [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (θ : L),
      IsIntegral A θ → Algebra.adjoin K {θ} = ⊤ → ∀ x : L, IsIntegral A x →
      Polynomial.aeval θ (Polynomial.derivative (minpoly A θ)) * x ∈ Algebra.adjoin A {θ} := by
    intro A _ _ _ K _ _ _ L _ _ _ _ _ _ θ hθ hgen x hx
    have s1 : minpoly K θ = Polynomial.map (algebraMap A K) (minpoly A θ) :=
      minpoly.isIntegrallyClosed_eq_field_fractions' K hθ
    have s2 : Polynomial.aeval θ (Polynomial.derivative (minpoly K θ)) =
        Polynomial.aeval θ (Polynomial.derivative (minpoly A θ)) := by
      rw [s1, Polynomial.derivative_map, Polynomial.aeval_map_algebraMap]
    have s3 : Polynomial.aeval θ (Polynomial.derivative (minpoly A θ)) ≠ 0 := by
      rw [← s2]
      exact Polynomial.Separable.aeval_derivative_ne_zero
        (Algebra.IsSeparable.isSeparable K θ) (minpoly.aeval K θ)
    have hdual := traceForm_dualSubmodule_adjoin A K hgen hθ
    have s5 : ∀ y ∈ Algebra.adjoin A {θ}, IsIntegral A y := fun y hy =>
      IsIntegral.of_mem_of_fg _ hθ.fg_adjoin_singleton y hy
    have s6 : x ∈ (Algebra.traceForm K L).dualSubmodule
        (Subalgebra.toSubmodule (Algebra.adjoin A {θ})) := by
      rw [LinearMap.BilinForm.mem_dualSubmodule]
      intro y hy
      rw [Subalgebra.mem_toSubmodule] at hy
      rw [Algebra.traceForm_apply, Submodule.mem_one]
      have h1 : IsIntegral A (Algebra.trace K L (x * y)) :=
        Algebra.isIntegral_trace (hx.mul (s5 y hy))
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp h1
      exact ⟨a, ha⟩
    rw [hdual, s2, Submodule.mem_smul_pointwise_iff_exists] at s6
    obtain ⟨b, hb, hbx⟩ := s6
    rw [← hbx, smul_eq_mul, mul_inv_cancel_left₀ s3]
    exact hb
  have hStdEtale : ∀ (A : Type u) [CommRing A] [IsDomain A]
      [IsIntegrallyClosed A] (L : Type u) [Field L] [Algebra A L],
      Function.Injective (algebraMap A L) → ∀ θ : L, IsIntegral A θ →
      ∀ z : ↥(Algebra.adjoin A {θ}),
        Polynomial.aeval (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
          (Polynomial.derivative (minpoly A θ)) ∣ z →
        RingHom.Etale ((algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away z)).comp
          (algebraMap A ↥(Algebra.adjoin A {θ}))) := by
    intro A _ _ _ L _ _ hinj θ hθ z hdz
    have : Module.IsTorsionFree A L := Module.isTorsionFree_iff_algebraMap_injective.mpr hinj
    let e : AdjoinRoot (minpoly A θ) ≃ₐ[A] ↥(Algebra.adjoin A {θ}) := minpoly.equivAdjoin hθ
    have he_root : e (AdjoinRoot.root (minpoly A θ)) =
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) := by
      show minpoly.equivAdjoin hθ (AdjoinRoot.root (minpoly A θ)) = _
      rw [minpoly.coe_equivAdjoin, AdjoinRoot.Minpoly.coe_toAdjoin, AdjoinRoot.liftAlgHom_root]
    have her : e (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ))) =
        Polynomial.aeval (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
          (Polynomial.derivative (minpoly A θ)) := by
      rw [← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, he_root]
    let P : StandardEtalePair A :=
      ⟨minpoly A θ, minpoly.monic hθ, Polynomial.derivative (minpoly A θ), ⟨1, 0, 1, by simp⟩⟩
    have h1 : Algebra.Etale A
        (Localization.Away (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ)))) :=
      Algebra.Etale.of_equiv P.equivAwayAdjoinRoot
    have H : Submonoid.map e.toRingEquiv.toMonoidHom
        (Submonoid.powers (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ)))) =
        Submonoid.powers (Polynomial.aeval
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
          (Polynomial.derivative (minpoly A θ))) := by
      rw [Submonoid.map_powers, ← her]
      rfl
    let ψ₀ := IsLocalization.ringEquivOfRingEquiv
      (Localization.Away (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ))))
      (Localization.Away (Polynomial.aeval
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
          (Polynomial.derivative (minpoly A θ)))) e.toRingEquiv H
    have hψ : ∀ a : A, ψ₀ (algebraMap A _ a) = algebraMap A _ a := by
      intro a
      rw [IsScalarTower.algebraMap_apply A (AdjoinRoot (minpoly A θ))
        (Localization.Away (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ)))) a,
        IsLocalization.ringEquivOfRingEquiv_eq,
        IsScalarTower.algebraMap_apply A ↥(Algebra.adjoin A {θ})
          (Localization.Away (Polynomial.aeval
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
          (Polynomial.derivative (minpoly A θ)))) a]
      congr 1
      exact e.commutes a
    have h2 : Algebra.Etale A (Localization.Away (Polynomial.aeval
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
          (Polynomial.derivative (minpoly A θ)))) :=
      Algebra.Etale.of_equiv (AlgEquiv.ofRingEquiv (f := ψ₀) hψ)
    obtain ⟨w, rfl⟩ := hdz
    set d := Polynomial.aeval
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
          (Polynomial.derivative (minpoly A θ)) with hd
    let x := algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away d) w
    have : Algebra.Etale (Localization.Away d) (Localization.Away x) :=
      Algebra.Etale.of_isLocalizationAway x
    have h3 : Algebra.Etale A (Localization.Away x) :=
      Algebra.Etale.comp A (Localization.Away d) (Localization.Away x)
    have : IsLocalization.Away (d * w) (Localization.Away x) :=
      IsLocalization.Away.mul' (Localization.Away d) (Localization.Away x) d w
    let ε := IsLocalization.algEquiv (Submonoid.powers (d * w)) (Localization.Away x)
      (Localization.Away (d * w))
    let ε' : Localization.Away x ≃ₐ[A] Localization.Away (d * w) := ε.restrictScalars A
    have h5 : (algebraMap A (Localization.Away (d * w))).Etale := by
      have hA : (algebraMap A (Localization.Away x)).Etale := RingHom.etale_algebraMap.mpr h3
      have h6 := RingHom.Etale.respectsIso.left (algebraMap A (Localization.Away x))
        ε'.toRingEquiv hA
      convert h6 using 1
      ext a
      show _ = ε' (algebraMap A _ a)
      exact (ε'.commutes a).symm
    rw [← IsScalarTower.algebraMap_eq]
    exact h5
  have hChartCompose : ∀ (A C S : Type u) [CommRing A] [CommRing C] [CommRing S]
      (j : A →+* C) (h : A) (x : C) (f₀ : S →+* Localization.Away h), RingHom.Etale f₀ →
      RingHom.Etale ((algebraMap C (Localization.Away (j h * x))).comp j) →
      ∃ φ : Localization.Away h →+* Localization.Away (j h * x),
        φ.comp (algebraMap A (Localization.Away h)) =
          (algebraMap C (Localization.Away (j h * x))).comp j ∧
        RingHom.Etale (φ.comp f₀) := by
    intro A C S _ _ _ j h x f₀ hf₀ hγ
    have key : ∀ (C' : Type u) [CommRing C'] (γ : A →+* C'), IsUnit (γ h) → γ.Etale →
        ∃ φ : Localization.Away h →+* C',
          φ.comp (algebraMap A (Localization.Away h)) = γ ∧ RingHom.Etale (φ.comp f₀) := by
      intro C' _ γ hu hγ'
      obtain ⟨φ, hcomp⟩ : ∃ φ : Localization.Away h →+* C',
          φ.comp (algebraMap A (Localization.Away h)) = γ :=
        ⟨IsLocalization.Away.lift (S := Localization.Away h) h hu,
          RingHom.ext fun a => IsLocalization.Away.lift_eq h hu a⟩
      refine ⟨φ, hcomp, ?_⟩
      letI iA : Algebra A C' := γ.toAlgebra
      letI iAh : Algebra (Localization.Away h) C' := φ.toAlgebra
      haveI : IsScalarTower A (Localization.Away h) C' :=
        IsScalarTower.of_algebraMap_eq (fun a => (RingHom.congr_fun hcomp a).symm)
      haveI : Algebra.Etale A (Localization.Away h) := Algebra.Etale.of_isLocalizationAway h
      haveI : Algebra.Etale A C' := hγ'.toAlgebra
      haveI : Algebra.Etale (Localization.Away h) C' :=
        Algebra.Etale.of_restrictScalars A (Localization.Away h) C'
      have hφ : RingHom.Etale φ := RingHom.etale_algebraMap.mpr inferInstance
      exact RingHom.Etale.stableUnderComposition f₀ φ hf₀ hφ
    have hu : IsUnit (algebraMap C (Localization.Away (j h * x)) (j h)) :=
      IsLocalization.Away.isUnit_of_dvd (S := Localization.Away (j h * x)) (j h * x)
        (dvd_mul_right (j h) x)
    exact key _ _ hu hγ
  haveI hAic : IsIntegrallyClosed A := hPD.2.2.1
  have h𝔭max : 𝔭.IsMaximal := hPD.2.2.2.1
  have hinjAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K

  have core : ∀ (F : Type u) [Field F] [Algebra K F] [Algebra A F] [IsScalarTower A K F]
      [FiniteDimensional K F] [Algebra.IsSeparable K F] (α : F) (P : Polynomial A)
      (B : Subalgebra A F), B = Algebra.adjoin A {α, (Polynomial.aeval α P)⁻¹} →
      IsIntegral A α → Algebra.adjoin K {α} = ⊤ →
      P = Polynomial.derivative (minpoly A α) * Polynomial.divX (minpoly A α) →
      Polynomial.aeval α P ≠ 0 →
      IsFractionRing ↥B F ∧ IsIntegrallyClosed ↥B ∧ RingHom.Etale (algebraMap A ↥B) ∧
      Function.Injective (algebraMap A ↥B) ∧
      ∀ (Y : Ideal ↥(Algebra.adjoin A {α})), Y.IsPrime →
        Y.comap (algebraMap A ↥(Algebra.adjoin A {α})) = 𝔭 →
        (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α})) ∈ Y →
        Polynomial.aeval (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α})) P ∉ Y →
        (∀ x : ↥B, ∃ a : A, x - algebraMap A ↥B a ∈ Ideal.map (algebraMap A ↥B) 𝔭) ∧
        (Ideal.map (algebraMap A ↥B) 𝔭).comap (algebraMap A ↥B) = 𝔭 ∧
        (Ideal.map (algebraMap A ↥B) 𝔭).IsMaximal := by
    intro F _ _ _ _ _ _ α P B hB hα hgen hP he
    have hinjF : Function.Injective (algebraMap A F) := by
      rw [IsScalarTower.algebraMap_eq A K F]
      exact (algebraMap K F).injective.comp hinjAK
    have hαB : α ∈ B := by rw [hB]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
    have heiB : (Polynomial.aeval α P)⁻¹ ∈ B := by
      rw [hB]; exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl)
    have hRB : Algebra.adjoin A {α} ≤ B := by
      rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]; exact hαB
    have heR : Polynomial.aeval α P ∈ Algebra.adjoin A {α} :=
      Polynomial.aeval_mem_adjoin_singleton A α
    have hdR : Polynomial.aeval α (Polynomial.derivative (minpoly A α)) ∈ Algebra.adjoin A {α} :=
      Polynomial.aeval_mem_adjoin_singleton A α
    have hqR : Polynomial.aeval α (Polynomial.divX (minpoly A α)) ∈ Algebra.adjoin A {α} :=
      Polynomial.aeval_mem_adjoin_singleton A α
    have hedq : Polynomial.aeval α P = Polynomial.aeval α (Polynomial.derivative (minpoly A α)) *
        Polynomial.aeval α (Polynomial.divX (minpoly A α)) := by rw [hP, map_mul]
    obtain ⟨z, hz_def⟩ : ∃ z : ↥(Algebra.adjoin A {α}), z =
        Polynomial.aeval (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α})) P :=
      ⟨_, rfl⟩
    have hz : (z : F) = Polynomial.aeval α P := by
      rw [hz_def]; exact Polynomial.aeval_subalgebra_coe P _ _
    have hdvd : Polynomial.aeval (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α}))
        (Polynomial.derivative (minpoly A α)) ∣ z :=
      ⟨Polynomial.aeval (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α}))
        (Polynomial.divX (minpoly A α)), by rw [hz_def, hP, map_mul]⟩
    have hEt0 := hStdEtale A F hinjF α hα z hdvd
    set e := Polynomial.aeval α P with he_def
    set d := Polynomial.aeval α (Polynomial.derivative (minpoly A α)) with hd_def
    set q := Polynomial.aeval α (Polynomial.divX (minpoly A α)) with hq_def

    have s1 : ∀ s ∈ B, ∃ n : ℕ, s * e ^ n ∈ Algebra.adjoin A {α} := by
      intro s hs
      rw [hB] at hs
      induction hs using Algebra.adjoin_induction with
      | mem x hx =>
        rcases Set.mem_insert_iff.mp hx with hx | hx
        · rw [hx]
          exact ⟨0, by rw [pow_zero, mul_one]; exact Algebra.self_mem_adjoin_singleton A _⟩
        · rw [Set.mem_singleton_iff] at hx
          rw [hx]
          exact ⟨1, by rw [pow_one, inv_mul_cancel₀ he]; exact Subalgebra.one_mem _⟩
      | algebraMap r =>
        exact ⟨0, by rw [pow_zero, mul_one]; exact Subalgebra.algebraMap_mem _ r⟩
      | add x y _ _ hx hy =>
        obtain ⟨n, hn⟩ := hx
        obtain ⟨m, hm⟩ := hy
        refine ⟨n + m, ?_⟩
        have h1 : (x + y) * e ^ (n + m) = (x * e ^ n) * e ^ m + (y * e ^ m) * e ^ n := by ring
        rw [h1]
        exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hn (Subalgebra.pow_mem _ heR m))
          (Subalgebra.mul_mem _ hm (Subalgebra.pow_mem _ heR n))
      | mul x y _ _ hx hy =>
        obtain ⟨n, hn⟩ := hx
        obtain ⟨m, hm⟩ := hy
        refine ⟨n + m, ?_⟩
        have h1 : (x * y) * e ^ (n + m) = (x * e ^ n) * (y * e ^ m) := by ring
        rw [h1]
        exact Subalgebra.mul_mem _ hn hm

    letI algRB : Algebra ↥(Algebra.adjoin A {α}) ↥B := (Subalgebra.inclusion hRB).toRingHom.toAlgebra
    have hcoeRB : ∀ r : ↥(Algebra.adjoin A {α}),
        ((algebraMap ↥(Algebra.adjoin A {α}) ↥B r : ↥B) : F) = (r : F) := fun r => rfl
    have hunit : IsUnit (algebraMap ↥(Algebra.adjoin A {α}) ↥B z) := by
      refine isUnit_iff_exists_inv.mpr ⟨⟨e⁻¹, heiB⟩, ?_⟩
      apply Subtype.ext
      show (z : F) * e⁻¹ = 1
      rw [hz, mul_inv_cancel₀ he]
    haveI hloc : IsLocalization.Away z ↥B := by
      refine IsLocalization.Away.mk z hunit ?_ ?_
      · intro s
        obtain ⟨n, hn⟩ := s1 s.1 s.2
        refine ⟨n, ⟨_, hn⟩, ?_⟩
        apply Subtype.ext
        show (s : F) * ((algebraMap ↥(Algebra.adjoin A {α}) ↥B z ^ n : ↥B) : F) = (s : F) * e ^ n
        rw [SubmonoidClass.coe_pow, hcoeRB, hz]
      · intro a b hab
        exact ⟨0, by rw [pow_zero, one_mul, one_mul]; exact Subalgebra.inclusion_injective hRB hab⟩

    have hEtB : RingHom.Etale (algebraMap A ↥B) := by
      let ε := IsLocalization.algEquiv (Submonoid.powers z) (Localization.Away z) ↥B
      have h6 := RingHom.Etale.respectsIso.left _ ε.toRingEquiv hEt0
      convert h6 using 1
      apply RingHom.ext
      intro a
      show algebraMap A ↥B a = ε (algebraMap ↥(Algebra.adjoin A {α}) (Localization.Away z)
        (algebraMap A ↥(Algebra.adjoin A {α}) a))
      rw [AlgEquiv.commutes]
      rfl

    have hd0 : d ≠ 0 := fun h => he (by rw [hedq, h, zero_mul])
    haveI hFR : IsFractionRing ↥B F := by
      haveI : FaithfulSMul ↥B F :=
        (faithfulSMul_iff_algebraMap_injective ↥B F).mpr Subtype.val_injective
      refine IsFractionRing.of_field ↥B F (fun w => ?_)
      have halg : IsAlgebraic A w :=
        (IsFractionRing.isAlgebraic_iff A K F).mpr (Algebra.IsAlgebraic.isAlgebraic w)
      obtain ⟨a, ha0, hai⟩ := halg.exists_integral_multiple
      have hc : d * (a • w) ∈ Algebra.adjoin A {α} := hConductor A K F α hα hgen (a • w) hai
      have ha0' : algebraMap A F a ≠ 0 := fun h => ha0 (hinjF (by rw [h, map_zero]))
      refine ⟨⟨d * (a • w), hRB hc⟩, ⟨d * algebraMap A F a,
        Subalgebra.mul_mem _ (hRB hdR) (Subalgebra.algebraMap_mem _ a)⟩, ?_⟩
      show w = d * (a • w) / (d * algebraMap A F a)
      rw [Algebra.smul_def, eq_div_iff (mul_ne_zero hd0 ha0')]
      ring

    have hIC : IsIntegrallyClosed ↥B := by
      rw [isIntegrallyClosed_iff F]
      intro x hx
      haveI : IsScalarTower ↥(Algebra.adjoin A {α}) ↥B F :=
        IsScalarTower.of_algebraMap_eq (fun r => rfl)
      obtain ⟨⟨m, hm⟩, hmi⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers z) x hx
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
      haveI : Algebra.IsIntegral A ↥(Algebra.adjoin A {α}) :=
        Algebra.IsIntegral.adjoin (fun y hy => by rw [Set.mem_singleton_iff.mp hy]; exact hα)
      have hiA : IsIntegral A (e ^ n * x) := by
        convert isIntegral_trans (R := A) _ hmi using 1
        show e ^ n * x = ((z ^ n : ↥(Algebra.adjoin A {α})) : F) * x
        rw [SubmonoidClass.coe_pow, hz]
      have hc : d * (e ^ n * x) ∈ Algebra.adjoin A {α} := hConductor A K F α hα hgen _ hiA
      refine ⟨⟨d * (e ^ n * x) * q * e⁻¹ ^ (n + 1), ?_⟩, ?_⟩
      · exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (hRB hc) (hRB hqR))
          (Subalgebra.pow_mem _ heiB _)
      · show d * (e ^ n * x) * q * e⁻¹ ^ (n + 1) = x
        calc d * (e ^ n * x) * q * e⁻¹ ^ (n + 1) = (d * q) * e ^ n * e⁻¹ ^ (n + 1) * x := by ring
          _ = (e * e⁻¹) ^ (n + 1) * x := by rw [← hedq]; ring
          _ = x := by rw [mul_inv_cancel₀ he, one_pow, one_mul]
    refine ⟨hFR, hIC, hEtB, fun a b h => hinjF (congrArg Subtype.val h), ?_⟩
    intro Y hYp hYc hαY hzY
    rw [← hz_def] at hzY

    have hfα : Polynomial.aeval (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α}))
        (minpoly A α) = 0 := by
      apply Subtype.ext
      rw [Polynomial.aeval_subalgebra_coe]
      exact minpoly.aeval A α
    have hsplit := Polynomial.X_mul_divX_add (minpoly A α)
    have hf₀ : (minpoly A α).coeff 0 ∈ 𝔭 := by
      have h1 : (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α})) *
          Polynomial.aeval (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α}))
            (Polynomial.divX (minpoly A α)) +
          algebraMap A ↥(Algebra.adjoin A {α}) ((minpoly A α).coeff 0) = 0 := by
        have h2 := congrArg (Polynomial.aeval
          (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α}))) hsplit
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hfα] at h2
        exact h2
      rw [← hYc, Ideal.mem_comap, eq_neg_of_add_eq_zero_right h1]
      exact Y.neg_mem (Y.mul_mem_right _ hαY)

    have hP₀ : P.coeff 0 ∉ 𝔭 := by
      intro hP0
      apply hzY
      have h1 := congrArg (Polynomial.aeval
        (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α})))
        (Polynomial.X_mul_divX_add P)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at h1
      rw [hz_def, ← h1]
      refine Y.add_mem (Y.mul_mem_right _ hαY) ?_
      rw [← hYc] at hP0
      exact hP0
    set I := Ideal.map (algebraMap A ↥B) 𝔭 with hI

    have hαq : α * q + algebraMap A F ((minpoly A α).coeff 0) = 0 := by
      have h2 := congrArg (Polynomial.aeval α) hsplit
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, minpoly.aeval] at h2
      exact h2
    have hdeiB : -(d * e⁻¹) ∈ B := B.neg_mem (B.mul_mem (hRB hdR) heiB)
    have hαI : (⟨α, hαB⟩ : ↥B) ∈ I := by
      have h1 : (⟨α, hαB⟩ : ↥B) =
          algebraMap A ↥B ((minpoly A α).coeff 0) * ⟨-(d * e⁻¹), hdeiB⟩ := by
        apply Subtype.ext
        show α = algebraMap A F ((minpoly A α).coeff 0) * -(d * e⁻¹)
        rw [eq_neg_of_add_eq_zero_right hαq]
        calc α = α * (e * e⁻¹) := by rw [mul_inv_cancel₀ he, mul_one]
          _ = α * (d * q) * e⁻¹ := by rw [← hedq]; ring
          _ = -(α * q) * -(d * e⁻¹) := by ring
      rw [h1]
      exact I.mul_mem_right _ (Ideal.mem_map_of_mem _ hf₀)

    have heB : e ∈ B := hRB heR
    have heP : (⟨e, heB⟩ : ↥B) - algebraMap A ↥B (P.coeff 0) ∈ I := by
      have h1 : α * Polynomial.aeval α P.divX + algebraMap A F (P.coeff 0) = e := by
        have h2 := congrArg (Polynomial.aeval α) (Polynomial.X_mul_divX_add P)
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at h2
        exact h2
      have h2 : (⟨e, heB⟩ : ↥B) - algebraMap A ↥B (P.coeff 0) =
          ⟨α, hαB⟩ * ⟨Polynomial.aeval α P.divX, hRB (Polynomial.aeval_mem_adjoin_singleton A α)⟩ := by
        apply Subtype.ext
        show e - algebraMap A F (P.coeff 0) = α * Polynomial.aeval α P.divX
        rw [← h1]; ring
      rw [h2]
      exact I.mul_mem_right _ hαI
    obtain ⟨ρ, i, hi, hρ⟩ := h𝔭max.exists_inv hP₀
    have heiI : (⟨e⁻¹, heiB⟩ : ↥B) - algebraMap A ↥B ρ ∈ I := by
      have hu : (⟨e, heB⟩ : ↥B) * ⟨e⁻¹, heiB⟩ = 1 := Subtype.ext (mul_inv_cancel₀ he)
      have hρ' : algebraMap A ↥B ρ * algebraMap A ↥B (P.coeff 0) + algebraMap A ↥B i = 1 := by
        rw [← map_mul, ← map_add, hρ, map_one]
      have h1 : (⟨e⁻¹, heiB⟩ : ↥B) - algebraMap A ↥B ρ = ⟨e⁻¹, heiB⟩ *
          (algebraMap A ↥B i - algebraMap A ↥B ρ * ((⟨e, heB⟩ : ↥B) - algebraMap A ↥B (P.coeff 0))) := by
        linear_combination (-(⟨e⁻¹, heiB⟩ : ↥B)) * hρ' + algebraMap A ↥B ρ * hu
      rw [h1]
      exact I.mul_mem_left _ (I.sub_mem (Ideal.mem_map_of_mem _ hi) (I.mul_mem_left _ heP))

    have H1' : ∀ s ∈ B, ∃ a : A, ∀ hs : s ∈ B, (⟨s, hs⟩ : ↥B) - algebraMap A ↥B a ∈ I := by
      intro s hs
      rw [hB] at hs
      induction hs using Algebra.adjoin_induction with
      | mem x hx =>
        rcases Set.mem_insert_iff.mp hx with hx | hx
        · subst hx
          exact ⟨0, fun _ => by rw [map_zero, sub_zero]; exact hαI⟩
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          exact ⟨ρ, fun _ => heiI⟩
      | algebraMap r =>
        refine ⟨r, fun hs => ?_⟩
        rw [show (⟨algebraMap A F r, hs⟩ : ↥B) = algebraMap A ↥B r from rfl, sub_self]
        exact I.zero_mem
      | add x y hx' hy' hx hy =>
        obtain ⟨a, ha⟩ := hx
        obtain ⟨b, hb⟩ := hy
        have hxB : x ∈ B := by rw [hB]; exact hx'
        have hyB : y ∈ B := by rw [hB]; exact hy'
        refine ⟨a + b, fun hs => ?_⟩
        have h1 : (⟨x + y, hs⟩ : ↥B) - algebraMap A ↥B (a + b) =
            ((⟨x, hxB⟩ : ↥B) - algebraMap A ↥B a) + ((⟨y, hyB⟩ : ↥B) - algebraMap A ↥B b) := by
          rw [map_add, show (⟨x + y, hs⟩ : ↥B) = ⟨x, hxB⟩ + ⟨y, hyB⟩ from rfl]; ring
        rw [h1]
        exact I.add_mem (ha hxB) (hb hyB)
      | mul x y hx' hy' hx hy =>
        obtain ⟨a, ha⟩ := hx
        obtain ⟨b, hb⟩ := hy
        have hxB : x ∈ B := by rw [hB]; exact hx'
        have hyB : y ∈ B := by rw [hB]; exact hy'
        refine ⟨a * b, fun hs => ?_⟩
        have h1 : (⟨x * y, hs⟩ : ↥B) - algebraMap A ↥B (a * b) =
            ((⟨x, hxB⟩ : ↥B) - algebraMap A ↥B a) * ⟨y, hyB⟩ +
              algebraMap A ↥B a * ((⟨y, hyB⟩ : ↥B) - algebraMap A ↥B b) := by
          rw [map_mul, show (⟨x * y, hs⟩ : ↥B) = ⟨x, hxB⟩ * ⟨y, hyB⟩ from rfl]; ring
        rw [h1]
        exact I.add_mem (I.mul_mem_right _ (ha hxB)) (I.mul_mem_left _ (hb hyB))
    have H1 : ∀ x : ↥B, ∃ a : A, x - algebraMap A ↥B a ∈ I := by
      rintro ⟨s, hs⟩
      obtain ⟨a, ha⟩ := H1' s hs
      exact ⟨a, ha hs⟩

    have hdisj : Disjoint (↑(Submonoid.powers z) : Set ↥(Algebra.adjoin A {α})) ↑Y :=
      (Ideal.disjoint_powers_iff_notMem z hYp.isRadical).mpr hzY
    have hY'p := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers z) ↥B Y hYp hdisj
    have hIY : I ≤ Y.map (algebraMap ↥(Algebra.adjoin A {α}) ↥B) := by
      rw [hI, Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap]
      have h1 : algebraMap A ↥(Algebra.adjoin A {α}) a ∈ Y := by rw [← hYc] at ha; exact ha
      exact Ideal.mem_map_of_mem _ h1
    have hcomap : I.comap (algebraMap A ↥B) = 𝔭 := by
      refine (h𝔭max.eq_of_le ?_ Ideal.le_comap_map).symm
      intro htop
      apply hY'p.ne_top
      rw [Ideal.eq_top_iff_one]
      apply hIY
      have h1 : (1 : A) ∈ I.comap (algebraMap A ↥B) := by rw [htop]; exact Submodule.mem_top
      rw [Ideal.mem_comap, map_one] at h1
      exact h1

    have hImax : I.IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨fun h1 => ?_, fun J x hIJ hxI hxJ => ?_⟩
      · have h2 : (1 : A) ∈ I.comap (algebraMap A ↥B) := by
          rw [Ideal.mem_comap, map_one]; exact h1
        rw [hcomap] at h2
        exact h𝔭max.ne_top ((Ideal.eq_top_iff_one _).mpr h2)
      · obtain ⟨a, ha⟩ := H1 x
        have ha𝔭 : a ∉ 𝔭 := fun h => hxI (by
          have h2 := I.add_mem ha (Ideal.mem_map_of_mem (algebraMap A ↥B) h)
          rw [sub_add_cancel] at h2
          exact h2)
        obtain ⟨ρ', i', hi', hρ'⟩ := h𝔭max.exists_inv ha𝔭
        have e1 : (1 : ↥B) = algebraMap A ↥B ρ' * x - algebraMap A ↥B ρ' * (x - algebraMap A ↥B a) +
            algebraMap A ↥B i' := by
          rw [← map_one (algebraMap A ↥B), ← hρ', map_add, map_mul]; ring
        rw [e1]
        exact J.add_mem (J.sub_mem (J.mul_mem_left _ hxJ) (hIJ (I.mul_mem_left _ ha)))
          (hIJ (Ideal.mem_map_of_mem _ hi'))
    exact ⟨H1, hcomap, hImax⟩

  have pdT : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra A B] [Algebra ↥W B],
      algebraMap ↥W B = (algebraMap A B).comp (algebraMap ↥W A) →
      Function.Injective (algebraMap A B) → Algebra.FiniteType A B → IsIntegrallyClosed B →
      RingHom.Etale (algebraMap A B) → (Ideal.map (algebraMap A B) 𝔭).IsMaximal →
      (Ideal.map (algebraMap A B) 𝔭).comap (algebraMap A B) = 𝔭 →
      wcLlsPD W B (Ideal.map (algebraMap A B) 𝔭) (wcDrKind (algebraMap A B) k) := by
    intro B _ _ _ _ hW hinj hft hIC hEt hmax hcomap
    obtain ⟨hftW, hnzd, -, -, hmW, hk⟩ := hPD
    haveI : IsScalarTower ↥W A B := IsScalarTower.of_algebraMap_eq' hW
    haveI := hnzd
    refine ⟨Algebra.FiniteType.trans hftW hft, ?_, hIC, hmax, ?_, ?_⟩
    · refine ⟨fun {c x} h => ?_⟩
      rw [Algebra.smul_def, hW, RingHom.comp_apply] at h
      rcases mul_eq_zero.mp h with h | h
      · left
        have h2 : algebraMap ↥W A c = 0 := hinj (by rw [h, map_zero])
        have h3 : c • (1 : A) = 0 := by rw [Algebra.smul_def, h2, zero_mul]
        exact (smul_eq_zero.mp h3).resolve_right one_ne_zero
      · right; exact h
    · rw [hW, ← Ideal.map_map]
      exact Ideal.map_mono hmW
    · have hloc : ∀ h : A, h ∉ 𝔭 → algebraMap A B h * 1 ∉ Ideal.map (algebraMap A B) 𝔭 := by
        intro h hh hm
        rw [mul_one] at hm
        apply hh
        rw [← hcomap, Ideal.mem_comap]
        exact hm
      have hEt1 : ∀ h : A, RingHom.Etale
          ((algebraMap B (Localization.Away (algebraMap A B h * 1))).comp (algebraMap A B)) := by
        intro h
        have h1 : RingHom.Etale (algebraMap B (Localization.Away (algebraMap A B h * 1))) :=
          RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (algebraMap A B h * 1))
        exact RingHom.Etale.stableUnderComposition _ _ hEt h1
      cases k with
      | disc t =>
        obtain ⟨ht, h𝔭eq, h, hh, f₀, hfC, hfX, hfet⟩ := hk
        obtain ⟨φ, hφ, hφet⟩ := hChartCompose A B (Polynomial ↥W) (algebraMap A B) h 1 f₀ hfet
          (hEt1 h)
        refine ⟨Ideal.mem_map_of_mem _ ht, ?_, algebraMap A B h * 1, hloc h hh, φ.comp f₀, ?_, ?_,
          hφet⟩
        · rw [h𝔭eq, Ideal.map_sup, Ideal.map_span, Set.image_singleton, Ideal.map_map, ← hW]
        · rw [RingHom.comp_assoc, hfC, ← RingHom.comp_assoc, hφ, RingHom.comp_assoc, ← hW]
        · show φ (f₀ Polynomial.X) = _
          rw [hfX]
          exact RingHom.congr_fun hφ t
      | ann u v g =>
        obtain ⟨hg, hg0, huv, h𝔭eq, h, hh, f₀, hfC, hfu, hfv, hfet⟩ := hk
        obtain ⟨φ, hφ, hφet⟩ := hChartCompose A B
          (MvPolynomial (Fin 2) ↥W ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
          (algebraMap A B) h 1 f₀ hfet (hEt1 h)
        refine ⟨hg, hg0, ?_, ?_, algebraMap A B h * 1, hloc h hh, φ.comp f₀, ?_, ?_, ?_, hφet⟩
        · show algebraMap A B u * algebraMap A B v = algebraMap ↥W B g
          rw [← map_mul, huv, hW, RingHom.comp_apply]
        · rw [h𝔭eq, Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map, ← hW]
        · rw [RingHom.comp_assoc, hfC, ← RingHom.comp_assoc, hφ, RingHom.comp_assoc, ← hW]
        · show φ (f₀ _) = _
          rw [hfu]
          exact RingHom.congr_fun hφ u
        · show φ (f₀ _) = _
          rw [hfv]
          exact RingHom.congr_fun hφ v

  letI iW : Algebra ↥W ↥(wcDrA A K θ) := wcDrA.algW
  obtain ⟨⟨hθi, hθy⟩, -, -, hθE⟩ := hθ
  haveI := hy
  let α : ↥(wcDrK K θ) := wcDrTh K θ
  let ψ : ↥(wcDrK K θ) →ₐ[A] L := (IntermediateField.val (wcDrK K θ)).restrictScalars A
  have hψα : ψ α = θ := rfl
  have hψinj : Function.Injective ψ := Subtype.val_injective
  have hmin : minpoly A θ = minpoly A α := minpoly.algHom_eq ψ hψinj α
  have hαint : IsIntegral A α := (isIntegral_algHom_iff ψ hψinj).mp hθi
  have hθK : IsIntegral K θ := IsIntegral.of_finite K θ
  have hgen : Algebra.adjoin K {α} = ⊤ := by
    have h := (IntermediateField.adjoin.powerBasis hθK).adjoin_gen_eq_top
    rw [IntermediateField.adjoin.powerBasis_gen] at h
    exact h
  haveI : Algebra.IsSeparable K ↥(wcDrK K θ) :=
    Algebra.isSeparable_tower_bot_of_isSeparable K ↥(wcDrK K θ) L
  have hPeq : wcDrE A θ = Polynomial.derivative (minpoly A α) * Polynomial.divX (minpoly A α) := by
    show Polynomial.derivative (minpoly A θ) * Polynomial.divX (minpoly A θ) = _
    rw [hmin]
  have hψE : ψ (Polynomial.aeval α (wcDrE A θ)) = Polynomial.aeval θ (wcDrE A θ) := by
    rw [← Polynomial.aeval_algHom_apply, hψα]
  have hE : Polynomial.aeval α (wcDrE A θ) ≠ 0 := by
    intro h0
    apply hθE
    refine ⟨0, y.zero_mem, ?_⟩
    rw [← hψE, h0, map_zero] <;> rfl
  obtain ⟨hFR, hIC, hEt, hinj, hrest⟩ :=
    core ↥(wcDrK K θ) α (wcDrE A θ) (wcDrA A K θ) rfl hαint hgen hPeq hE
  have hRint : ∀ r : ↥(Algebra.adjoin A {α}), (ψ.comp (Algebra.adjoin A {α}).val) r ∈
      integralClosure A L := fun r => by
    have h1 : IsIntegral A (ψ (r : ↥(wcDrK K θ))) :=
      (IsIntegral.of_mem_of_fg _ hαint.fg_adjoin_singleton _ r.2).map ψ
    exact h1
  let χ : ↥(Algebra.adjoin A {α}) →ₐ[A] ↥(integralClosure A L) :=
    (ψ.comp (Algebra.adjoin A {α}).val).codRestrict (integralClosure A L) hRint
  have hYp : (y.comap χ).IsPrime := Ideal.comap_isPrime χ y
  have hYc : (y.comap χ).comap (algebraMap A ↥(Algebra.adjoin A {α})) = 𝔭 := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes, ← hy𝔭, Ideal.mem_comap]
  have hαY : (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α})) ∈ y.comap χ := by
    rw [Ideal.mem_comap]
    have h1 : χ ⟨α, Algebra.self_mem_adjoin_singleton A α⟩ = ⟨θ, hθi⟩ := Subtype.ext rfl
    rw [h1]
    exact hθy
  have hzY : Polynomial.aeval (⟨α, Algebra.self_mem_adjoin_singleton A α⟩ : ↥(Algebra.adjoin A {α}))
      (wcDrE A θ) ∉ y.comap χ := by
    intro hz
    rw [Ideal.mem_comap] at hz
    apply hθE
    refine ⟨_, hz, ?_⟩
    exact (congrArg ψ (Polynomial.aeval_subalgebra_coe _ _ _)).trans hψE
  obtain ⟨H1, hcomap, hmax⟩ := hrest (y.comap χ) hYp hYc hαY hzY
  have hft : Algebra.FiniteType A ↥(wcDrA A K θ) :=
    Algebra.FiniteType.adjoin_of_finite ((Set.finite_singleton _).insert _)
  exact ⟨hFR, H1, pdT ↥(wcDrA A K θ) rfl hinj hft hIC hEt hmax hcomap⟩

theorem wcpa_dj_llsm_dst_loc_fs : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (L : Type u)
    [Field L] (wL : ↥W →+* L) (R R'' : Type u) [CommRing R] [CommRing R''] [Algebra R L]
    [Algebra R'' L] (ε : L)
    (hRR : ∀ x : L, x ∈ integralClosure R L → x ∈ integralClosure R'' L),
    ε ≠ 0 → ε ∈ integralClosure R L → ε⁻¹ ∈ integralClosure R'' L →
    (∀ x : L, x ∈ integralClosure R'' L → ∃ n : ℕ, ε ^ n * x ∈ integralClosure R L) →
    (∀ w ∈ IsLocalRing.maximalIdeal ↥W, wL w ∈ integralClosure R L) →
    (∀ (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (𝔮'' : Ideal ↥(integralClosure R'' L))
        [𝔮''.IsPrime],
        (∀ (x : L) (hx : x ∈ integralClosure R L),
          (⟨x, hx⟩ : ↥(integralClosure R L)) ∈ 𝔮 ↔
            (⟨x, hRR x hx⟩ : ↥(integralClosure R'' L)) ∈ 𝔮'') →
        (wcpaDjLkBad (wcLlsFS W wL R 𝔮) ↔ wcpaDjLkBad (wcLlsFS W wL R'' 𝔮''))) ∧
    (∀ (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (hε : ε ∈ integralClosure R L),
        (⟨ε, hε⟩ : ↥(integralClosure R L)) ∉ 𝔮 →
        ∃ 𝔮'' : Ideal ↥(integralClosure R'' L), 𝔮''.IsPrime ∧
          ∀ (x : L) (hx : x ∈ integralClosure R L),
            (⟨x, hx⟩ : ↥(integralClosure R L)) ∈ 𝔮 ↔
              (⟨x, hRR x hx⟩ : ↥(integralClosure R'' L)) ∈ 𝔮'') :=
by
  intro Ω _ W L _ wL R R'' _ _ _ _ ε hRR hε0 hεB hinv hden hm
  have primeExt : ∀ (C C'' L : Type u) [CommRing C] [CommRing C''] [Field L]
    (i : C →+* L) (i'' : C'' →+* L) (j : C →+* C'') (hi : Function.Injective i)
    (hcomp : i''.comp j = i)
    (Q : Ideal C) (hQ : Q.IsPrime) (H : ∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y),
      ∃ Q'' : Ideal C'', Q''.IsPrime ∧ Q''.comap j = Q := by
    intro C C'' L _ _ _ i i'' j hi hcomp Q hQ H
    have hij : ∀ x, i'' (j x) = i x := fun x => by rw [← hcomp]; rfl
    have indep : ∀ (y : C'') (d x d' x' : C), d' ∉ Q → i x = i d * i'' y →
        i x' = i d' * i'' y → x' ∈ Q → x ∈ Q := by
      intro y d x d' x' hd' h1 h2 hx'
      have e : x * d' = x' * d := hi (by rw [map_mul, map_mul, h1, h2]; ring)
      have : x * d' ∈ Q := by rw [e]; exact Q.mul_mem_right _ hx'
      exact (hQ.mem_or_mem this).resolve_right hd'
    have h1Q : (1 : C) ∉ Q := fun h => hQ.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    let Q'' : Ideal C'' :=
      { carrier := {y | ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q}
        add_mem' := by
          rintro a b ⟨d₁, x₁, hd₁, h1, hx1⟩ ⟨d₂, x₂, hd₂, h2, hx2⟩
          refine ⟨d₁ * d₂, x₁ * d₂ + x₂ * d₁, fun h => ?_, ?_,
            add_mem (Q.mul_mem_right _ hx1) (Q.mul_mem_right _ hx2)⟩
          · rcases hQ.mem_or_mem h with h | h
            · exact hd₁ h
            · exact hd₂ h
          · rw [map_add, map_mul, map_mul, map_mul, h1, h2, map_add]; ring
        zero_mem' := ⟨1, 0, h1Q, by simp, Q.zero_mem⟩
        smul_mem' := by
          rintro c b ⟨d₁, x₁, hd₁, h1, hx1⟩
          obtain ⟨dc, xc, hdc, hc⟩ := H c
          refine ⟨dc * d₁, xc * x₁, fun h => ?_, ?_, Q.mul_mem_left _ hx1⟩
          · rcases hQ.mem_or_mem h with h | h
            · exact hdc h
            · exact hd₁ h
          · rw [smul_eq_mul, map_mul, map_mul, map_mul, hc, h1]; ring }
    have memQ : ∀ y, y ∈ Q'' ↔ ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q := fun y => Iff.rfl
    refine ⟨Q'', ⟨?_, ?_⟩, ?_⟩
    · rw [Ne, Ideal.eq_top_iff_one, memQ]
      rintro ⟨d, x, hd, h, hx⟩
      have : x = d := hi (by rw [h, map_one, mul_one])
      exact hd (this ▸ hx)
    · intro a b hab
      obtain ⟨d, x, hd, h, hx⟩ := (memQ _).mp hab
      obtain ⟨d₁, x₁, hd₁, h1⟩ := H a
      obtain ⟨d₂, x₂, hd₂, h2⟩ := H b
      have h12 : i (x₁ * x₂) = i (d₁ * d₂) * i'' (a * b) := by
        rw [map_mul, map_mul, map_mul, h1, h2]; ring
      have hd12 : d₁ * d₂ ∉ Q := fun h => by
        rcases hQ.mem_or_mem h with h | h
        · exact hd₁ h
        · exact hd₂ h
      have := indep _ _ _ _ _ hd h12 h hx
      rcases hQ.mem_or_mem this with h' | h'
      · exact Or.inl ((memQ _).mpr ⟨d₁, x₁, hd₁, h1, h'⟩)
      · exact Or.inr ((memQ _).mpr ⟨d₂, x₂, hd₂, h2, h'⟩)
    · ext x
      rw [Ideal.mem_comap, memQ]
      constructor
      · rintro ⟨d, x', hd, h, hx'⟩
        have e : x' = d * x := hi (by rw [h, hij, map_mul])
        rw [e] at hx'
        exact (hQ.mem_or_mem hx').resolve_left hd
      · intro hx
        exact ⟨1, x, h1Q, by rw [map_one, one_mul, hij], hx⟩
  have locEquiv : ∀ (C C'' L : Type u) [CommRing C] [IsDomain C]
    [CommRing C''] [IsDomain C''] [Field L] (i : C →+* L) (i'' : C'' →+* L) (j : C →+* C'')
    (hi : Function.Injective i) (hi'' : Function.Injective i'') (hcomp : i''.comp j = i)
    (Q : Ideal C) [hQ : Q.IsPrime] (Q'' : Ideal C'') [hQ'' : Q''.IsPrime] (hc : Q''.comap j = Q)
    (H : ∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y),
      ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'',
      ∀ x : C, e (algebraMap C (Localization.AtPrime Q) x) =
        algebraMap C'' (Localization.AtPrime Q'') (j x) := by
    intro C C'' L _ _ _ _ _ i i'' j hi hi'' hcomp Q hQ Q'' hQ'' hc H
    have hij : ∀ x, i'' (j x) = i x := fun x => by rw [← hcomp]; rfl
    have hjQ : ∀ d : C, d ∉ Q → j d ∉ Q'' := fun d hd h => hd (by rw [← hc]; exact h)
    have hne : ∀ d : C, d ∉ Q → i d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi (by rw [h0, map_zero])
      rw [this]; exact Q.zero_mem
    have hne'' : ∀ d : C'', d ∉ Q'' → i'' d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi'' (by rw [h0, map_zero])
      rw [this]; exact Q''.zero_mem
    have hu : ∀ d : Q.primeCompl, IsUnit (i d) := fun d => isUnit_iff_ne_zero.mpr (hne d d.2)
    have hu'' : ∀ d : Q''.primeCompl, IsUnit (i'' d) :=
      fun d => isUnit_iff_ne_zero.mpr (hne'' d d.2)
    obtain ⟨ι, hιa, hιm, hinj⟩ : ∃ ι : Localization.AtPrime Q →+* L,
        (∀ x, ι (algebraMap C _ x) = i x) ∧
        (∀ x (d : Q.primeCompl), i x = i d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hu,
        IsLocalization.lift_eq hu, fun x d => (IsLocalization.lift_mk'_spec hu x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i (IsLocalization.injective (Localization.AtPrime Q)
          (Ideal.primeCompl_le_nonZeroDivisors Q) h)
      · intro h; rw [hi h]
    obtain ⟨ι', hιa', hιm', hinj'⟩ : ∃ ι : Localization.AtPrime Q'' →+* L,
        (∀ x, ι (algebraMap C'' _ x) = i'' x) ∧
        (∀ x (d : Q''.primeCompl), i'' x = i'' d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q''.primeCompl) (S := Localization.AtPrime Q'') hu'',
        IsLocalization.lift_eq hu'', fun x d => (IsLocalization.lift_mk'_spec hu'' x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i'' (IsLocalization.injective (Localization.AtPrime Q'')
          (Ideal.primeCompl_le_nonZeroDivisors Q'') h)
      · intro h; rw [hi'' h]
    have hrange : ι.range = ι'.range := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
        have hD : j d ∈ Q''.primeCompl := hjQ d d.2
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q'') (j x) ⟨_, hD⟩, ?_⟩
        apply mul_left_cancel₀ (hne d d.2)
        have hv := hιm x d
        have hv' := hιm' (j x) ⟨_, hD⟩
        simp only at hv'
        rw [hij, hij] at hv'
        rw [← hv, hv']
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨y, d''⟩, rfl⟩ := IsLocalization.mk'_surjective Q''.primeCompl z
        obtain ⟨d₁, x₁, hd₁, h1⟩ := H y
        obtain ⟨d₂, x₂, hd₂, h2⟩ := H d''
        have hx₂ : x₂ ∉ Q := by
          intro hx
          have e : j x₂ = j d₂ * d'' := hi'' (by rw [hij, map_mul, hij, h2])
          have : j x₂ ∈ Q'' := by rw [← Ideal.mem_comap, hc]; exact hx
          rw [e] at this
          rcases hQ''.mem_or_mem this with h | h
          · exact hjQ d₂ hd₂ h
          · exact d''.2 h
        have hD : d₁ * x₂ ∈ Q.primeCompl := by
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact hd₁ h
          · exact hx₂ h
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q) (x₁ * d₂) ⟨_, hD⟩, ?_⟩
        apply mul_left_cancel₀ (hne _ hD)
        have hv := hιm' y d''
        have hv' := hιm (x₁ * d₂) ⟨_, hD⟩
        simp only at hv'
        rw [← hv']
        have hd0 : i d₂ ≠ 0 := hne d₂ hd₂
        rw [map_mul, map_mul, h1, hv, h2]
        dsimp only
        ring
    let e1 : Localization.AtPrime Q ≃+* ι.range :=
      RingEquiv.ofBijective ι.rangeRestrict
        ⟨fun a b h => hinj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι⟩
    let e2 : Localization.AtPrime Q'' ≃+* ι'.range :=
      RingEquiv.ofBijective ι'.rangeRestrict
        ⟨fun a b h => hinj' (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι'⟩
    let e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'' :=
      e1.trans ((RingEquiv.subringCongr hrange).trans e2.symm)
    have hιe : ∀ z, ι' (e z) = ι z := by
      intro z
      have := congrArg Subtype.val (e2.apply_symm_apply ((RingEquiv.subringCongr hrange) (e1 z)))
      exact this
    refine ⟨e, fun x => hinj' ?_⟩
    rw [hιe, hιa, hιa', hij]
  have t_llfi : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
    wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
        (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }
  have s7g : ∀ (L : Type u) [Field L] (wL : ↥W →+* L) (R R' : Type u) [CommRing R]
    [CommRing R'] [Algebra R L] [Algebra R' L]
    (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime]
    (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime]
    (e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'),
    (∀ (x : ↥(integralClosure R L)) (y : ↥(integralClosure R' L)), (x : L) = (y : L) →
      e (algebraMap _ _ x) = algebraMap _ _ y) →
    (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      wL w ∈ integralClosure R L ∧ wL w ∈ integralClosure R' L) →
    (wcpaDjLkBad (wcLlsFS W wL R Q) ↔ wcpaDjLkBad (wcLlsFS W wL R' Q')) := by
    intro L _ wL R R' _ _ _ _ Q _ Q' _ e he hw
    have hI : Ideal.map (e : Localization.AtPrime Q →+* Localization.AtPrime Q')
        ((Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) =
        (Ideal.span {b : ↥(integralClosure R' L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')) := by
      rw [Ideal.map_map, Ideal.map_span, Ideal.map_span]
      congr 1
      ext z
      constructor
      · rintro ⟨b, ⟨w, hw', hb⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').2⟩, ⟨w, hw', rfl⟩, (he b ⟨wL w, (hw w hw').2⟩ hb).symm⟩
      · rintro ⟨b', ⟨w, hw', hb'⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').1⟩, ⟨w, hw', rfl⟩, he ⟨wL w, (hw w hw').1⟩ b' hb'.symm⟩
    have eq : wcLlsFS W wL R Q ≃+* wcLlsFS W wL R' Q' := Ideal.quotientEquiv _ _ e hI.symm
    obtain ⟨h1, h2⟩ := t_llfi _ _ eq
    unfold wcpaDjLkBad
    rw [h1, h2]
  let i : ↥(integralClosure R L) →+* L := (integralClosure R L).val.toRingHom
  let i'' : ↥(integralClosure R'' L) →+* L := (integralClosure R'' L).val.toRingHom
  let j : ↥(integralClosure R L) →+* ↥(integralClosure R'' L) :=
    { toFun := fun x => ⟨(x : L), hRR x x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hcomp : i''.comp j = i := RingHom.ext fun _ => rfl
  have hi : Function.Injective i := Subtype.val_injective
  have hi'' : Function.Injective i'' := Subtype.val_injective
  have H : ∀ (𝔮 : Ideal ↥(integralClosure R L)), 𝔮.IsPrime →
      (⟨ε, hεB⟩ : ↥(integralClosure R L)) ∉ 𝔮 →
      ∀ y : ↥(integralClosure R'' L), ∃ d x : ↥(integralClosure R L), d ∉ 𝔮 ∧
        i x = i d * i'' y := by
    intro 𝔮 h𝔮 hε y
    obtain ⟨n, hn⟩ := hden y.1 y.2
    refine ⟨⟨ε, hεB⟩ ^ n, ⟨ε ^ n * y.1, hn⟩, fun h => hε (h𝔮.mem_of_pow_mem n h), ?_⟩
    show ε ^ n * (y : L) = ((⟨ε, hεB⟩ ^ n : ↥(integralClosure R L)) : L) * (y : L)
    rw [SubmonoidClass.coe_pow]
  refine ⟨fun 𝔮 _ 𝔮'' _ hmem => ?_, fun 𝔮 _ hε' hεq => ?_⟩
  · have hc : 𝔮''.comap j = 𝔮 := Ideal.ext fun x => (hmem x.1 x.2).symm
    have hεq : (⟨ε, hεB⟩ : ↥(integralClosure R L)) ∉ 𝔮 := by
      intro h
      have h1 := (hmem ε hεB).mp h
      have e1 : (1 : ↥(integralClosure R'' L)) = ⟨ε, hRR ε hεB⟩ * ⟨ε⁻¹, hinv⟩ :=
        Subtype.ext (mul_inv_cancel₀ hε0).symm
      apply Ideal.IsPrime.ne_top ‹𝔮''.IsPrime›
      rw [Ideal.eq_top_iff_one, e1]
      exact Ideal.mul_mem_right _ _ h1
    obtain ⟨e, he⟩ := locEquiv _ _ L i i'' j hi hi'' hcomp 𝔮 𝔮'' hc (H 𝔮 inferInstance hεq)
    exact s7g L wL R R'' 𝔮 𝔮'' e (fun x y hxy => by rw [he]; congr 1; exact Subtype.ext hxy)
      (fun w hw => ⟨hm w hw, hRR _ (hm w hw)⟩)
  · obtain ⟨Q'', hQ'', hc⟩ :=
      primeExt _ _ L i i'' j hi hcomp 𝔮 inferInstance (H 𝔮 inferInstance hεq)
    refine ⟨Q'', hQ'', fun x hx => ?_⟩
    rw [← hc]
    exact Iff.rfl

theorem wcpa_dj_llsm_dst_galois_move : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (K : Type u) [Field K]
    [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L] (R : Subalgebra A K)
    (φ : ↥W →+* K) (y : Ideal ↥(integralClosure A L)) [y.IsPrime]
    (𝔮 : Ideal ↥(integralClosure ↥R L)) [𝔮.IsPrime],
    (𝔮.comap (algebraMap ↥R ↥(integralClosure ↥R L))).comap (algebraMap A ↥R) =
      y.comap (algebraMap A ↥(integralClosure A L)) →
    ∃ 𝔮' : Ideal ↥(integralClosure ↥R L), 𝔮'.IsPrime ∧
      𝔮'.comap (algebraMap ↥R ↥(integralClosure ↥R L)) =
        𝔮.comap (algebraMap ↥R ↥(integralClosure ↥R L)) ∧
      (∀ (x : L) (hx : x ∈ integralClosure A L) (hx' : x ∈ integralClosure ↥R L),
        (⟨x, hx'⟩ : ↥(integralClosure ↥R L)) ∈ 𝔮' ↔ (⟨x, hx⟩ : ↥(integralClosure A L)) ∈ y) ∧
      ∀ (_ : 𝔮'.IsPrime),
        (wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp φ) ↥R 𝔮) ↔
          wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp φ) ↥R 𝔮')) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ _ _ R φ y _ 𝔮 _ hq
  classical

  have hAB : ∀ x : L, x ∈ integralClosure A L → x ∈ integralClosure ↥R L := fun x hx =>
    IsIntegral.tower_top hx
  let ι : ↥(integralClosure A L) →+* ↥(integralClosure ↥R L) :=
    { toFun := fun x => ⟨x.1, hAB x.1 x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hc0 : (𝔮.comap ι).comap (algebraMap A ↥(integralClosure A L)) =
      (𝔮.comap (algebraMap ↥R ↥(integralClosure ↥R L))).comap (algebraMap A ↥R) := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap]
    have e : ι (algebraMap A ↥(integralClosure A L) a) =
        algebraMap ↥R ↥(integralClosure ↥R L) (algebraMap A ↥R a) :=
      Subtype.ext (IsScalarTower.algebraMap_apply A ↥R L a)
    rw [e]

  haveI : Algebra.IsAlgebraic A K := IsLocalization.isAlgebraic K (nonZeroDivisors A)
  haveI : Algebra.IsAlgebraic A L := Algebra.IsAlgebraic.trans A K L
  have hinj : ∀ x : A, algebraMap A L x = 0 → x = 0 := by
    intro x hx
    rw [IsScalarTower.algebraMap_apply A K L] at hx
    have h1 := (algebraMap K L).injective (hx.trans (map_zero _).symm)
    exact IsFractionRing.injective A K (h1.trans (map_zero _).symm)
  haveI : IsFractionRing (integralClosure A L) L :=
    integralClosure.isFractionRing_of_algebraic hinj
  haveI : Finite (integralClosure A L ≃ₐ[A] integralClosure A L) :=
    Finite.of_equiv _ (galRestrict A K L (integralClosure A L)).toEquiv
  haveI : Algebra.IsInvariant A (integralClosure A L)
      (integralClosure A L ≃ₐ[A] integralClosure A L) :=
    Algebra.isInvariant_of_isGalois' A K L (integralClosure A L)
  haveI : SMulCommClass (integralClosure A L ≃ₐ[A] integralClosure A L) A
      (integralClosure A L) := SMulCommClass.symm _ _ _
  obtain ⟨h, hh⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A (integralClosure A L)
    (integralClosure A L ≃ₐ[A] integralClosure A L) y (𝔮.comap ι)
    (by rw [Ideal.under_def, Ideal.under_def, hc0, hq])
  set σ := (galRestrict A K L (integralClosure A L)).symm h with hσ
  have hgσ : galRestrict A K L (integralClosure A L) σ = h := by
    rw [hσ, MulEquiv.apply_symm_apply]
  have hq0eq : 𝔮.comap ι = y.comap (galRestrict A K L (integralClosure A L) σ).symm := by
    rw [hh, hgσ, Ideal.pointwise_smul_eq_comap]
    rfl
  have hmem0 : ∀ b : ↥(integralClosure A L),
      galRestrict A K L (integralClosure A L) σ b ∈ 𝔮.comap ι ↔ b ∈ y := by
    intro b
    rw [hq0eq, Ideal.mem_comap, AlgEquiv.symm_apply_apply]

  let σR : L ≃ₐ[↥R] L := σ.restrictScalars ↥R
  let σR' : L ≃ₐ[↥R] L := σ.symm.restrictScalars ↥R
  have hB : ∀ x : L, x ∈ integralClosure ↥R L → σ x ∈ integralClosure ↥R L :=
    fun x hx => IsIntegral.map σR hx
  have hB' : ∀ x : L, x ∈ integralClosure ↥R L → σ.symm x ∈ integralClosure ↥R L :=
    fun x hx => IsIntegral.map σR' hx
  let σB : ↥(integralClosure ↥R L) ≃+* ↥(integralClosure ↥R L) :=
    { toFun := fun b => ⟨σ b.1, hB b.1 b.2⟩
      invFun := fun b => ⟨σ.symm b.1, hB' b.1 b.2⟩
      left_inv := fun b => Subtype.ext (σ.symm_apply_apply b.1)
      right_inv := fun b => Subtype.ext (σ.apply_symm_apply b.1)
      map_mul' := fun a b => Subtype.ext (map_mul σ a.1 b.1)
      map_add' := fun a b => Subtype.ext (map_add σ a.1 b.1) }

  have hi : (𝔮.comap σB).comap (algebraMap ↥R ↥(integralClosure ↥R L)) =
      𝔮.comap (algebraMap ↥R ↥(integralClosure ↥R L)) := by
    ext r
    rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap]
    have e : σB (algebraMap ↥R ↥(integralClosure ↥R L) r) =
        algebraMap ↥R ↥(integralClosure ↥R L) r :=
      Subtype.ext (σR.commutes r)
    rw [e]

  have hii : ∀ (x : L) (hx : x ∈ integralClosure A L) (hx' : x ∈ integralClosure ↥R L),
      (⟨x, hx'⟩ : ↥(integralClosure ↥R L)) ∈ 𝔮.comap σB ↔
        (⟨x, hx⟩ : ↥(integralClosure A L)) ∈ y := by
    intro x hx hx'
    rw [Ideal.mem_comap, ← hmem0 ⟨x, hx⟩, Ideal.mem_comap]
    have e : σB ⟨x, hx'⟩ = ι (galRestrict A K L (integralClosure A L) σ ⟨x, hx⟩) :=
      Subtype.ext (algebraMap_galRestrict_apply A σ (⟨x, hx⟩ : ↥(integralClosure A L))).symm
    rw [e]
  refine ⟨𝔮.comap σB, inferInstance, hi, hii, fun h' => ?_⟩

  have H : Submonoid.map σB.symm.toMonoidHom 𝔮.primeCompl = (𝔮.comap σB).primeCompl := by
    ext z
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨x, hx, rfl⟩
      show σB (σB.symm x) ∉ 𝔮
      rw [RingEquiv.apply_symm_apply]
      exact hx
    · intro hz
      exact ⟨σB z, hz, σB.symm_apply_apply z⟩
  let Ψ : Localization.AtPrime 𝔮 ≃+* Localization.AtPrime (𝔮.comap σB) :=
    IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔮)
      (Localization.AtPrime (𝔮.comap σB)) σB.symm H
  have hΨ : ∀ b : ↥(integralClosure ↥R L),
      Ψ (algebraMap _ (Localization.AtPrime 𝔮) b) =
        algebraMap _ (Localization.AtPrime (𝔮.comap σB)) (σB.symm b) :=
    fun b => IsLocalization.ringEquivOfRingEquiv_eq H b
  have hfix : ∀ b : ↥(integralClosure ↥R L),
      b ∈ {b : ↥(integralClosure ↥R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap K L).comp φ) w} →
      σB.symm b = b := by
    rintro b ⟨w, -, hb⟩
    apply Subtype.ext
    show σ.symm (b : L) = b
    rw [hb, RingHom.comp_apply, AlgEquiv.commutes]
  have hI : Ideal.map (Ψ : Localization.AtPrime 𝔮 →+* Localization.AtPrime (𝔮.comap σB))
      ((Ideal.span {b : ↥(integralClosure ↥R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap K L).comp φ) w}).map
          (algebraMap ↥(integralClosure ↥R L) (Localization.AtPrime 𝔮))) =
      (Ideal.span {b : ↥(integralClosure ↥R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap K L).comp φ) w}).map
          (algebraMap ↥(integralClosure ↥R L) (Localization.AtPrime (𝔮.comap σB))) := by
    rw [Ideal.map_map, Ideal.map_span, Ideal.map_span]
    congr 1
    apply Set.image_congr
    intro b hb
    rw [RingHom.comp_apply]
    show Ψ (algebraMap _ _ b) = _
    rw [hΨ, hfix b hb]
  have eq : wcLlsFS W ((algebraMap K L).comp φ) ↥R 𝔮 ≃+*
      wcLlsFS W ((algebraMap K L).comp φ) ↥R (𝔮.comap σB) :=
    Ideal.quotientEquiv _ _ Ψ hI.symm
  have t_llfi : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
    wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
        (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }
  obtain ⟨h1, h2⟩ := t_llfi _ _ eq
  unfold wcpaDjLkBad
  rw [h1, h2]

theorem wcpa_dj_llsm_dst_den : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K] [Algebra A K]
    (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] (θ : L) (s : K),
    IsIntegral A θ → Polynomial.aeval θ (wcDrE A θ) ≠ 0 →
    (∀ r : K, r ∈ Algebra.adjoin A {s} →
      algebraMap K ↥(wcDrK K θ) r ∈
        Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) ∧
    (∀ x : L, x ∈ integralClosure ↥(Algebra.adjoin A {s}) L →
      x ∈ integralClosure ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L) ∧
    (∀ x : L,
      x ∈ integralClosure ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L →
      ∃ n : ℕ, Polynomial.aeval θ (wcDrE A θ) ^ n * x ∈
        integralClosure ↥(Algebra.adjoin A {s}) L) ∧
    Polynomial.aeval θ (wcDrE A θ) ∈ integralClosure A L ∧
    Polynomial.aeval θ (wcDrE A θ) ∈ integralClosure ↥(Algebra.adjoin A {s}) L ∧
    (Polynomial.aeval θ (wcDrE A θ))⁻¹ ∈
      integralClosure ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L :=
by
  intro A _ K _ _ L _ _ _ _ θ s hθ he0
  classical

  have L1 : ∀ (B T : Type u) [CommRing B] [CommRing T] [Algebra B T] (G : Set T) (φ : T →+* L)
      (C : Subring L) (ε : L), ε ∈ C → (∀ g ∈ G, ∃ n : ℕ, ε ^ n * φ g ∈ C) →
      (∀ b : B, ∃ n : ℕ, ε ^ n * φ (algebraMap B T b) ∈ C) →
      ∀ x ∈ Algebra.adjoin B G, ∃ n : ℕ, ε ^ n * φ x ∈ C := by
    intro B T _ _ _ G φ C ε hε hG hB x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hG x hx
    | algebraMap b => exact hB b
    | add x y _ _ ihx ihy =>
      obtain ⟨n, hn⟩ := ihx
      obtain ⟨m, hm⟩ := ihy
      refine ⟨n + m, ?_⟩
      have h1 : ε ^ (n + m) * φ (x + y) = ε ^ m * (ε ^ n * φ x) + ε ^ n * (ε ^ m * φ y) := by
        rw [map_add, pow_add]; ring
      rw [h1]
      exact C.add_mem (C.mul_mem (C.pow_mem hε _) hn) (C.mul_mem (C.pow_mem hε _) hm)
    | mul x y _ _ ihx ihy =>
      obtain ⟨n, hn⟩ := ihx
      obtain ⟨m, hm⟩ := ihy
      refine ⟨n + m, ?_⟩
      have h1 : ε ^ (n + m) * φ (x * y) = (ε ^ n * φ x) * (ε ^ m * φ y) := by
        rw [map_mul, pow_add]; ring
      rw [h1]
      exact C.mul_mem hn hm

  have L2 : ∀ (R R'' : Type u) [CommRing R] [CommRing R''] [Algebra R L] [Algebra R'' L] (ε : L),
      ε ∈ integralClosure R L →
      (∀ r : R'', ∃ n : ℕ, ε ^ n * algebraMap R'' L r ∈ integralClosure R L) →
      ∀ x : L, IsIntegral R'' x → ∃ n : ℕ, ε ^ n * x ∈ integralClosure R L := by
    intro R R'' _ _ _ _ ε hε hden x hx
    obtain ⟨p, hpm, hpx⟩ := hx
    choose nf hnf using hden
    have hcoef : ∃ N : ℕ, ∀ i, ε ^ N * algebraMap R'' L (p.coeff i) ∈ integralClosure R L := by
      refine ⟨∑ j ∈ Finset.range (p.natDegree + 1), nf (p.coeff j), fun i => ?_⟩
      by_cases hi : i ≤ p.natDegree
      · have hle : nf (p.coeff i) ≤ ∑ j ∈ Finset.range (p.natDegree + 1), nf (p.coeff j) :=
          Finset.single_le_sum (f := fun j => nf (p.coeff j)) (fun _ _ => Nat.zero_le _)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
        have h1 : ε ^ (∑ j ∈ Finset.range (p.natDegree + 1), nf (p.coeff j)) *
              algebraMap R'' L (p.coeff i) =
            ε ^ ((∑ j ∈ Finset.range (p.natDegree + 1), nf (p.coeff j)) - nf (p.coeff i)) *
              (ε ^ nf (p.coeff i) * algebraMap R'' L (p.coeff i)) := by
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
        rw [h1]
        exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hε _) (hnf _)
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (not_le.mp hi), map_zero, mul_zero]
        exact Subalgebra.zero_mem _
    obtain ⟨N, hN⟩ := hcoef
    have hqm : (p.map (algebraMap R'' L)).Monic := hpm.map _
    have hqd : (p.map (algebraMap R'' L)).natDegree = p.natDegree := hpm.natDegree_map _
    have hPm : ((p.map (algebraMap R'' L)).scaleRoots (ε ^ N)).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr hqm
    have hPc : ∀ i, ((p.map (algebraMap R'' L)).scaleRoots (ε ^ N)).coeff i ∈
        integralClosure R L := by
      intro i
      rw [Polynomial.coeff_scaleRoots, hqd, Polynomial.coeff_map]
      rcases lt_trichotomy i p.natDegree with hi | hi | hi
      · obtain ⟨k, hk⟩ : ∃ k, p.natDegree - i = k + 1 := ⟨p.natDegree - i - 1, by omega⟩
        rw [hk, pow_succ]
        have h1 : algebraMap R'' L (p.coeff i) * ((ε ^ N) ^ k * ε ^ N) =
            (ε ^ N * algebraMap R'' L (p.coeff i)) * (ε ^ N) ^ k := by ring
        rw [h1]
        exact Subalgebra.mul_mem _ (hN i) (Subalgebra.pow_mem _ (Subalgebra.pow_mem _ hε _) _)
      · rw [hi, Nat.sub_self, pow_zero, mul_one, hpm.coeff_natDegree, map_one]
        exact Subalgebra.one_mem _
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, map_zero, zero_mul]
        exact Subalgebra.zero_mem _
    have hPl : (p.map (algebraMap R'' L)).scaleRoots (ε ^ N) ∈
        Polynomial.lifts (algebraMap (integralClosure R L) L) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨_, hPc i⟩, rfl⟩
    obtain ⟨P', hP'map, -, hP'm⟩ := Polynomial.lifts_and_degree_eq_and_monic hPl hPm
    have hq0 : Polynomial.eval₂ (RingHom.id L) x (p.map (algebraMap R'' L)) = 0 := by
      rw [Polynomial.eval₂_map, RingHom.id_comp]
      exact hpx
    have hint : IsIntegral (integralClosure R L) (ε ^ N * x) := by
      refine ⟨P', hP'm, ?_⟩
      rw [← Polynomial.eval_map, hP'map]
      exact Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id L) hq0
    exact ⟨N, isIntegral_trans _ hint⟩

  haveI hTow : IsScalarTower A ↥(Algebra.adjoin A {s}) L :=
    IsScalarTower.of_algebraMap_eq (fun a => IsScalarTower.algebraMap_apply A K L a)
  have hee : ((Polynomial.aeval (wcDrTh K θ) (wcDrE A θ) : ↥(wcDrK K θ)) : L) =
      Polynomial.aeval θ (wcDrE A θ) := by
    rw [← IntermediateField.aeval_coe]; rfl
  have H0 : ∀ z : L, IsIntegral A z → z ∈ integralClosure ↥(Algebra.adjoin A {s}) L :=
    fun z hz => hz.tower_top
  have c4 : Polynomial.aeval θ (wcDrE A θ) ∈ integralClosure A L := by
    have h1 : Polynomial.aeval θ (wcDrE A θ) ∈ Algebra.adjoin A {θ} :=
      Polynomial.aeval_mem_adjoin_singleton A θ
    have h2 : Algebra.adjoin A {θ} ≤ integralClosure A L :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr hθ)
    exact h2 h1
  have c5 : Polynomial.aeval θ (wcDrE A θ) ∈ integralClosure ↥(Algebra.adjoin A {s}) L :=
    H0 _ c4
  have c1 : ∀ r : K, r ∈ Algebra.adjoin A {s} →
      algebraMap K ↥(wcDrK K θ) r ∈
        Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s} := by
    intro r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff.mp hx]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap a =>
      have h1 : algebraMap K ↥(wcDrK K θ) (algebraMap A K a) =
          algebraMap ↥(wcDrA A K θ) ↥(wcDrK K θ) (algebraMap A ↥(wcDrA A K θ) a) := by
        rw [← IsScalarTower.algebraMap_apply A K ↥(wcDrK K θ)]; rfl
      rw [h1]
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  have c2 : ∀ x : L, x ∈ integralClosure ↥(Algebra.adjoin A {s}) L →
      x ∈ integralClosure ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L := by
    intro x hx
    let ι : ↥(Algebra.adjoin A {s}) →+*
        ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) :=
      { toFun := fun r => ⟨algebraMap K ↥(wcDrK K θ) r, c1 r r.2⟩
        map_one' := Subtype.ext (map_one (algebraMap K ↥(wcDrK K θ)))
        map_mul' := fun a b => Subtype.ext (map_mul (algebraMap K ↥(wcDrK K θ)) (a : K) b)
        map_zero' := Subtype.ext (map_zero (algebraMap K ↥(wcDrK K θ)))
        map_add' := fun a b => Subtype.ext (map_add (algebraMap K ↥(wcDrK K θ)) (a : K) b) }
    exact IsIntegral.map_of_comp_eq ι (RingHom.id L) (RingHom.ext fun _ => rfl) hx
  have hmem : (Polynomial.aeval (wcDrTh K θ) (wcDrE A θ))⁻¹ ∈ wcDrA A K θ :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have c6 : (Polynomial.aeval θ (wcDrE A θ))⁻¹ ∈
      integralClosure ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L := by
    have h1 : (Polynomial.aeval θ (wcDrE A θ))⁻¹ =
        algebraMap ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L
          (algebraMap ↥(wcDrA A K θ)
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) ⟨_, hmem⟩) := by
      show (Polynomial.aeval θ (wcDrE A θ))⁻¹ =
        (((Polynomial.aeval (wcDrTh K θ) (wcDrE A θ))⁻¹ : ↥(wcDrK K θ)) : L)
      rw [IntermediateField.coe_inv, hee]
    rw [h1]
    exact isIntegral_algebraMap

  have hI : ∀ a ∈ wcDrA A K θ, ∃ n : ℕ, Polynomial.aeval θ (wcDrE A θ) ^ n *
      algebraMap ↥(wcDrK K θ) L a ∈ (integralClosure ↥(Algebra.adjoin A {s}) L).toSubring := by
    refine L1 A ↥(wcDrK K θ) _ (algebraMap ↥(wcDrK K θ) L) _ _ c5 ?_ ?_
    · intro g hg
      rcases hg with hg | hg
      · rw [hg]
        refine ⟨0, ?_⟩
        rw [pow_zero, one_mul]
        exact H0 θ hθ
      · rw [Set.mem_singleton_iff.mp hg]
        refine ⟨1, ?_⟩
        show Polynomial.aeval θ (wcDrE A θ) ^ 1 *
          (((Polynomial.aeval (wcDrTh K θ) (wcDrE A θ))⁻¹ : ↥(wcDrK K θ)) : L) ∈ _
        rw [IntermediateField.coe_inv, hee, pow_one, mul_inv_cancel₀ he0]
        exact Subring.one_mem _
    · intro a
      refine ⟨0, ?_⟩
      rw [pow_zero, one_mul]
      exact H0 (algebraMap A L a) isIntegral_algebraMap
  have hO : ∀ r ∈ Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s},
      ∃ n : ℕ, Polynomial.aeval θ (wcDrE A θ) ^ n *
      algebraMap ↥(wcDrK K θ) L r ∈ (integralClosure ↥(Algebra.adjoin A {s}) L).toSubring := by
    refine L1 ↥(wcDrA A K θ) ↥(wcDrK K θ) _ (algebraMap ↥(wcDrK K θ) L) _ _ c5 ?_ ?_
    · intro g hg
      rw [Set.mem_singleton_iff.mp hg]
      refine ⟨0, ?_⟩
      rw [pow_zero, one_mul]
      exact Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin A {s}) L)
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s}))
    · intro b
      exact hI b.1 b.2
  have c3 : ∀ x : L,
      x ∈ integralClosure ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L →
      ∃ n : ℕ, Polynomial.aeval θ (wcDrE A θ) ^ n * x ∈
        integralClosure ↥(Algebra.adjoin A {s}) L := by
    intro x hx
    refine L2 ↥(Algebra.adjoin A {s})
      ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) _ c5 ?_ x hx
    intro r
    obtain ⟨n, hn⟩ := hO r.1 r.2
    exact ⟨n, hn⟩
  exact ⟨c1, c2, c3, c4, c5, c6⟩

theorem wcpa_dj_llsm_dr_sep_transfer {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A) (y : Ideal ↥(integralClosure A L)) (θ : L)
    (hPD : wcLlsPD W A 𝔭 k) (hy : y.IsPrime)
    (hy𝔭 : y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭) (hθ : wcDrSepEl A K L y θ)
    (hH1 : ∀ x : ↥(wcDrA A K θ), ∃ a : A,
      x - algebraMap A ↥(wcDrA A K θ) a ∈ Ideal.map (algebraMap A ↥(wcDrA A K θ)) 𝔭) :
    letI : Algebra ↥W ↥(wcDrA A K θ) := wcDrA.algW
    (∀ t : A, k = .disc t → ∀ c b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
      (wcLlsDiscSep W A K L t c b ↔
        wcLlsDiscSep W ↥(wcDrA A K θ) ↥(wcDrK K θ) L (algebraMap A ↥(wcDrA A K θ) t) c b)) ∧
    (∀ (u v : A) (g : ↥W), k = .ann u v g → ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W →
      b ≠ 0 → b ∣ g →
      (wcLlsAnnSep W A K L u b ↔
        wcLlsAnnSep W ↥(wcDrA A K θ) ↥(wcDrK K θ) L (algebraMap A ↥(wcDrA A K θ) u) b)) :=
by
  classical
  set_option synthInstance.maxHeartbeats 400000 in
  letI : Algebra ↥W ↥(wcDrA A K θ) := wcDrA.algW
  obtain ⟨-, hNZ, hIC, hmax, -, hk⟩ := hPD
  haveI := hNZ
  haveI := hIC
  haveI := hy
  obtain ⟨⟨hθi, -⟩, -, -, heny⟩ := hθ
  have he0 : Polynomial.aeval θ (wcDrE A θ) ≠ 0 := by
    intro h
    apply heny
    exact ⟨0, y.zero_mem, by rw [h]; rfl⟩
  have he_y : ∀ h : Polynomial.aeval θ (wcDrE A θ) ∈ integralClosure A L,
      (⟨_, h⟩ : ↥(integralClosure A L)) ∉ y := fun h hy' => heny ⟨_, hy', rfl⟩

  have node : ∀ (S : Type u) [CommRing S] (f : A →+* S) (N J : Ideal S), 𝔭 ≤ N.comap f →
      (∀ x : S, ∃ a : A, x - f a ∈ N) → N ≤ J → J ≠ ⊤ → J = N := by
    intro S _ f N J hpN nf hNJ hJ
    refine le_antisymm ?_ hNJ
    intro x hxJ
    obtain ⟨a, ha⟩ := nf x
    have haJ : f a ∈ J := by
      have e : f a = x - (x - f a) := by ring
      rw [e]; exact sub_mem hxJ (hNJ ha)
    by_cases hc0 : a ∈ 𝔭
    · have e : x = (x - f a) + f a := by ring
      rw [e]; exact add_mem ha (hpN hc0)
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hmax.exists_inv hc0
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : S) = f β * f a + f i := by rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hpN hi))

  have spanL : ∀ (B T : Type u) [CommRing B] [CommRing T] [Algebra B T] (G : Set T)
      (F : A →+* ↥(Algebra.adjoin B G)) (N : Ideal ↥(Algebra.adjoin B G)),
      (∀ (g : T) (hg : g ∈ G), (⟨g, Algebra.subset_adjoin hg⟩ : ↥(Algebra.adjoin B G)) ∈ N) →
      (∀ b : B, ∃ a : A, algebraMap B ↥(Algebra.adjoin B G) b - F a ∈ N) →
      ∀ (x : T) (hx : x ∈ Algebra.adjoin B G), ∃ a : A,
        (⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - F a ∈ N := by
    intro B T _ _ _ G F N hG hB x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact ⟨0, by rw [map_zero, sub_zero]; exact hG x hx⟩
    | algebraMap b => exact hB b
    | add x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨b, hb⟩ := ihy
      refine ⟨a + b, ?_⟩
      have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin B G)) - F (a + b) =
          ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - F a) +
          ((⟨y, hy⟩ : ↥(Algebra.adjoin B G)) - F b) := by
        have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin B G)) =
            (⟨x, hx⟩ : ↥(Algebra.adjoin B G)) + ⟨y, hy⟩ := rfl
        rw [e1, map_add]; ring
      rw [e]; exact add_mem ha hb
    | mul x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨b, hb⟩ := ihy
      refine ⟨a * b, ?_⟩
      have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin B G)) - F (a * b) =
          ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - F a) * ⟨y, hy⟩ +
          F a * ((⟨y, hy⟩ : ↥(Algebra.adjoin B G)) - F b) := by
        have e1 : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin B G)) =
            (⟨x, hx⟩ : ↥(Algebra.adjoin B G)) * ⟨y, hy⟩ := rfl
        rw [e1, map_mul]; ring
      rw [e]; exact add_mem (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hb)

  have G1 : ∀ (z : A) (s : K) (N : Ideal ↥(Algebra.adjoin A {s}))
      (N'' : Ideal ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})),
      N = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
      N'' = Ideal.span {algebraMap ↥(wcDrA A K θ)
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
            (algebraMap A ↥(wcDrA A K θ) z),
          ⟨algebraMap K ↥(wcDrK K θ) s, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap ↥(wcDrA A K θ)
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})).comp
            (algebraMap ↥W ↥(wcDrA A K θ))) →
      𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) →
      ((∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [𝔮.IsPrime],
          𝔮.comap (algebraMap ↥(Algebra.adjoin A {s})
            ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) = N →
          ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
            ↥(Algebra.adjoin A {s}) 𝔮)) ↔
        (∀ (𝔮 : Ideal ↥(integralClosure
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L)) [𝔮.IsPrime],
          𝔮.comap (algebraMap ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
            ↥(integralClosure
              ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L)) = N'' →
          ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) 𝔮))) := by
    intro z s N N'' hNdef hN''def H2
    obtain ⟨d1, d2, d3, d4, d5, d6⟩ := wcpa_dj_llsm_dst_den A K L θ s hθi he0
    have hwm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        (algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)) w ∈
          integralClosure ↥(Algebra.adjoin A {s}) L := fun w _ =>
      Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w))
    have loc := wcpa_dj_llsm_dst_loc_fs W L
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
      (Polynomial.aeval θ (wcDrE A θ)) d2 he0 d5 d6 d3 hwm
    let ι : ↥(Algebra.adjoin A {s}) →+*
        ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) :=
      { toFun := fun r => ⟨algebraMap K ↥(wcDrK K θ) r, d1 r r.2⟩
        map_one' := Subtype.ext (map_one (algebraMap K ↥(wcDrK K θ)))
        map_mul' := fun a b => Subtype.ext (map_mul (algebraMap K ↥(wcDrK K θ)) (a : K) b)
        map_zero' := Subtype.ext (map_zero (algebraMap K ↥(wcDrK K θ)))
        map_add' := fun a b => Subtype.ext (map_add (algebraMap K ↥(wcDrK K θ)) (a : K) b) }
    let j : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →+*
        ↥(integralClosure ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L) :=
      { toFun := fun x => ⟨x.1, d2 x.1 x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hιA : ∀ a : A, ι (algebraMap A ↥(Algebra.adjoin A {s}) a) =
        algebraMap ↥(wcDrA A K θ) ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
          (algebraMap A ↥(wcDrA A K θ) a) := fun a =>
      Subtype.ext (IsScalarTower.algebraMap_apply A K ↥(wcDrK K θ) a).symm
    have hjsq : ∀ r : ↥(Algebra.adjoin A {s}),
        j (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) r) =
          algebraMap ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
            ↥(integralClosure
              ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L) (ι r) :=
      fun r => Subtype.ext rfl
    have hN : ∀ J : Ideal ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}),
        N'' ≤ J ↔ N ≤ J.comap ι := by
      intro J
      rw [hNdef, hN''def]
      constructor
      · intro h
        apply sup_le
        · rw [Ideal.span_le]
          intro x hx
          rcases hx with hx | hx
          · rw [hx, SetLike.mem_coe, Ideal.mem_comap, hιA]
            exact h (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          · rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe, Ideal.mem_comap]
            exact h (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply, hιA]
          exact h (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw))
      · intro h
        apply sup_le
        · rw [Ideal.span_le]
          intro x hx
          rcases hx with hx | hx
          · rw [hx, SetLike.mem_coe, ← hιA]
            exact h (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          · rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe]
            exact h (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          rw [Ideal.mem_comap]
          have h1 := h (Ideal.mem_sup_right (Ideal.mem_map_of_mem
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hw))
          rw [Ideal.mem_comap, RingHom.comp_apply, hιA] at h1
          exact h1
    have hRsp : ∀ x : ↥(Algebra.adjoin A {s}), ∃ a : A,
        x - algebraMap A ↥(Algebra.adjoin A {s}) a ∈ N := fun x =>
      spanL A K {s} (algebraMap A ↥(Algebra.adjoin A {s})) N
        (fun g hg => by
          rw [hNdef]
          have e : (⟨g, Algebra.subset_adjoin hg⟩ : ↥(Algebra.adjoin A {s})) =
              ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := Subtype.ext hg
          rw [e]
          exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
        (fun b => ⟨b, by rw [sub_self]; exact N.zero_mem⟩) x.1 x.2
    have H2'' : 𝔭 ≤ N''.comap ((algebraMap ↥(wcDrA A K θ)
        ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})).comp
          (algebraMap A ↥(wcDrA A K θ))) := by
      intro a ha
      have h1 : ι (algebraMap A ↥(Algebra.adjoin A {s}) a) ∈ N'' :=
        ((hN N'').mp le_rfl) (Ideal.mem_comap.mp (H2 ha))
      rw [hιA] at h1
      exact h1
    have hR''sp : ∀ x : ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}),
        ∃ a : A, x - ((algebraMap ↥(wcDrA A K θ)
          ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})).comp
            (algebraMap A ↥(wcDrA A K θ))) a ∈ N'' := fun x =>
      spanL ↥(wcDrA A K θ) ↥(wcDrK K θ) {algebraMap K ↥(wcDrK K θ) s} _ N''
        (fun g hg => by
          rw [hN''def]
          have e : (⟨g, Algebra.subset_adjoin hg⟩ :
              ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})) =
              ⟨algebraMap K ↥(wcDrK K θ) s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :=
            Subtype.ext hg
          rw [e]
          exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
        (fun b => by
          obtain ⟨a, ha⟩ := hH1 b
          refine ⟨a, ?_⟩
          have h1 := Ideal.mem_map_of_mem (algebraMap ↥(wcDrA A K θ)
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})) ha
          rw [map_sub, Ideal.map_map] at h1
          exact Ideal.map_le_iff_le_comap.mpr H2'' h1) x.1 x.2
    constructor
    · intro hS 𝔮'' h𝔮'' hq''
      haveI := h𝔮''
      haveI : (𝔮''.comap j).IsPrime := Ideal.comap_isPrime j 𝔮''
      have hq : (𝔮''.comap j).comap (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) = N := by
        refine node _ (algebraMap A ↥(Algebra.adjoin A {s})) N _ H2 hRsp ?_
          (Ideal.comap_ne_top _ (Ideal.IsPrime.ne_top inferInstance))
        intro x hx
        have h1 := ((hN _).mp (le_of_eq hq''.symm)) hx
        show j (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L) x) ∈ 𝔮''
        rw [hjsq]; exact h1
      intro hb
      exact hS (𝔮''.comap j) hq ((loc.1 (𝔮''.comap j) 𝔮'' (fun x hx => Iff.rfl)).mpr hb)
    · intro hS'' 𝔮 h𝔮 hq
      haveI := h𝔮
      have hqA : (𝔮.comap (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L))).comap
            (algebraMap A ↥(Algebra.adjoin A {s})) =
          y.comap (algebraMap A ↥(integralClosure A L)) := by
        rw [hy𝔭]
        refine (hmax.eq_of_le (Ideal.comap_ne_top _
          (Ideal.comap_ne_top _ (Ideal.IsPrime.ne_top inferInstance))) ?_).symm
        rw [hq]; exact H2
      obtain ⟨𝔮', h𝔮'p, h𝔮'R, h𝔮'y, hbad'⟩ := wcpa_dj_llsm_dst_galois_move W A K L
        (Algebra.adjoin A {s}) ((algebraMap A K).comp (algebraMap ↥W A)) y 𝔮 hqA
      haveI := h𝔮'p
      have he' : (⟨Polynomial.aeval θ (wcDrE A θ), d5⟩ :
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) ∉ 𝔮' :=
        fun h => he_y d4 ((h𝔮'y _ d4 d5).mp h)
      obtain ⟨𝔮'', h𝔮''p, h𝔮''m⟩ := loc.2 𝔮' d5 he'
      haveI := h𝔮''p
      have hq'' : 𝔮''.comap (algebraMap
          ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
          ↥(integralClosure
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L)) = N'' := by
        refine node ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
          ((algebraMap ↥(wcDrA A K θ)
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})).comp
              (algebraMap A ↥(wcDrA A K θ))) N'' (𝔮''.comap (algebraMap
                ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
                ↥(integralClosure
                  ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L)))
              H2'' (fun x => hR''sp x) ?_ (Ideal.comap_ne_top _ h𝔮''p.ne_top)
        apply (hN _).mpr
        intro x hx
        show algebraMap ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s})
          ↥(integralClosure
            ↥(Algebra.adjoin ↥(wcDrA A K θ) {algebraMap K ↥(wcDrK K θ) s}) L) (ι x) ∈ 𝔮''
        rw [← hjsq]
        have h1 : algebraMap ↥(Algebra.adjoin A {s})
            ↥(integralClosure ↥(Algebra.adjoin A {s}) L) x ∈ 𝔮' := by
          show x ∈ 𝔮'.comap (algebraMap ↥(Algebra.adjoin A {s})
            ↥(integralClosure ↥(Algebra.adjoin A {s}) L))
          rw [h𝔮'R, hq]; exact hx
        exact (h𝔮''m _ (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L) x).2).mp h1
      intro hb
      exact hS'' 𝔮'' hq'' ((loc.1 𝔮' 𝔮'' h𝔮''m).mp ((hbad' h𝔮'p).mp hb))

  have hwL : (algebraMap ↥(wcDrK K θ) L).comp ((algebraMap ↥(wcDrA A K θ) ↥(wcDrK K θ)).comp
      (algebraMap ↥W ↥(wcDrA A K θ))) =
      (algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)) := by
    ext w
    show ((algebraMap A ↥(wcDrA A K θ) (algebraMap ↥W A w) : ↥(wcDrK K θ)) : L) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A w))
    exact IsScalarTower.algebraMap_apply A K L (algebraMap ↥W A w)
  have hsGen : ∀ (z : A) (w : ↥W),
      algebraMap ↥(wcDrA A K θ) ↥(wcDrK K θ) (algebraMap ↥W ↥(wcDrA A K θ) w) /
        algebraMap ↥(wcDrA A K θ) ↥(wcDrK K θ) (algebraMap A ↥(wcDrA A K θ) z) =
      algebraMap K ↥(wcDrK K θ) (algebraMap A K (algebraMap ↥W A w) / algebraMap A K z) := by
    intro z w
    rw [map_div₀]
    congr 1
    · exact IsScalarTower.algebraMap_apply A K ↥(wcDrK K θ) (algebraMap ↥W A w)
    · exact IsScalarTower.algebraMap_apply A K ↥(wcDrK K θ) z
  have hWne : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h
    have h1 : algebraMap ↥W A x = 0 := IsFractionRing.injective A K (h.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one, smul_eq_zero] at h1
    rcases h1 with h1 | h1
    · exact hx h1
    · exact one_ne_zero h1
  refine ⟨fun t ht c b hc hb hb0 => ?_, fun u v g hk' b hb hb0 hbg => ?_⟩
  ·
    subst ht
    obtain ⟨-, h𝔭, -⟩ := hk
    have hz : algebraMap A ↥(wcDrA A K θ) t - algebraMap ↥W ↥(wcDrA A K θ) c =
        algebraMap A ↥(wcDrA A K θ) (t - algebraMap ↥W A c) := by
      rw [map_sub]; rfl
    unfold wcLlsDiscSep wcLlsSepAt
    rw [hz, hsGen, hwL]
    refine G1 _ _ _ _ rfl rfl ?_
    rw [h𝔭]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      have e1 : algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
            algebraMap A K (t - algebraMap ↥W A c)}) t =
          algebraMap A _ (t - algebraMap ↥W A c) +
            ((algebraMap A _).comp (algebraMap ↥W A)) c := by
        rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
      rw [e1]
      exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  ·
    subst hk'
    obtain ⟨-, hg0, huv, h𝔭, -⟩ := hk
    obtain ⟨q, hq⟩ := hbg
    have hU0 : algebraMap A K u ≠ 0 := by
      intro h
      apply hWne g hg0
      rw [← huv, map_mul, h, zero_mul]
    unfold wcLlsAnnSep wcLlsSepAt
    rw [hsGen, hwL]
    refine G1 _ _ _ _ rfl rfl ?_
    rw [h𝔭]
    apply sup_le
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with hx | hx
      · rw [hx, SetLike.mem_coe, Ideal.mem_comap]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe, Ideal.mem_comap]
        have e1 : algebraMap A ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) /
              algebraMap A K u}) v =
            algebraMap A _ (algebraMap ↥W A q) *
              ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K u,
                Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
          apply Subtype.ext
          show algebraMap A K v = algebraMap A K (algebraMap ↥W A q) *
            (algebraMap A K (algebraMap ↥W A b) / algebraMap A K u)
          rw [mul_div_assoc', eq_div_iff hU0]
          have h2 := congrArg (algebraMap A K) huv
          rw [hq] at h2
          simp only [map_mul] at h2
          linear_combination h2
        rw [e1]
        exact Ideal.mul_mem_left _ _
          (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

theorem wcpa_dj_llsm_decomposition_reduction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ P : ℕ → Prop, wcLlsLocThm W P → wcLlsChartThm W P :=
by
  intro Ω _ _ W hW hWt P hLoc A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y hPD hSolv hP
  have : IsIntegrallyClosed A := hPD.2.2.1
  obtain ⟨hyP, hy𝔭, hsolv, hδ⟩ := hSolv
  have hmax : (y.comap (algebraMap A ↥(integralClosure A L))).IsMaximal := by
    rw [hy𝔭]; exact hPD.2.2.2.1
  obtain ⟨θ, hθ⟩ := wcpa_dj_llsm_dr_sep_element A K L y hyP hmax
  letI : Algebra ↥W ↥(wcDrA A K θ) := wcDrA.algW
  obtain ⟨hFR, hH1, hPD''⟩ := wcpa_dj_llsm_dr_chart_pd W A K L 𝔭 k y θ hPD hyP hy𝔭 hθ
  have := hFR
  obtain ⟨y'', hy''P, hcomap, hUniq, ⟨eD⟩, hFS⟩ :=
    wcpa_dj_llsm_dr_point_transfer W A K L y θ hyP hθ
  have hT := wcpa_dj_llsm_dr_sep_transfer W A K L 𝔭 k y θ hPD hyP hy𝔭 hθ hH1
  have := hy''P
  have heq : Ideal.map (algebraMap A ↥(wcDrA A K θ)) 𝔭 =
      y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L)) := by
    apply hPD''.2.2.2.1.eq_of_le (Ideal.IsPrime.ne_top inferInstance)
    rw [Ideal.map_le_iff_le_comap, hcomap, hy𝔭]
  have hPD2 : wcLlsPD W ↥(wcDrA A K θ)
      (y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L)))
      (wcDrKind (algebraMap A ↥(wcDrA A K θ)) k) := heq ▸ hPD''
  have hsolv'' : Group.IsSolvable ↥(wcLlsDec ↥(wcDrA A K θ) ↥(wcDrK K θ) L y'') :=
    Group.isSolvable_of_surjective (f := eD.symm.toMonoidHom) eD.symm.surjective
  have hcard : Nat.card ↥(wcLlsDec ↥(wcDrA A K θ) ↥(wcDrK K θ) L y'') =
      Nat.card ↥(wcLlsDec A K L y) := Nat.card_congr eD.toEquiv
  have hSolv'' : wcLlsSolvPt W ↥(wcDrA A K θ) ↥(wcDrK K θ) L
      (y''.comap (algebraMap ↥(wcDrA A K θ) ↥(integralClosure ↥(wcDrA A K θ) L)))
      (wcDrKind (algebraMap A ↥(wcDrA A K θ)) k) y'' := by
    refine ⟨hy''P, rfl, hsolv'', ?_⟩
    intro h2 t ht
    cases k with
    | disc t0 =>
      obtain ⟨eF⟩ := hFS hyP h2
      rw [(wcpa_dj_lr1k_llfi_ringequiv _ _ eF).1]
      exact hδ hyP t0 rfl
    | ann u v g => simp [wcDrKind] at ht
  have hLM := hLoc ↥(wcDrA A K θ) ↥(wcDrK K θ) L _ _ y'' hPD2 hSolv'' hUniq
    (by rw [hcard]; exact hP)
  obtain ⟨hTd, hTa⟩ := hT
  cases k with
  | disc t =>
    obtain ⟨c, b, hc, hb, hb0, hs, hmx⟩ := hLM
    exact ⟨c, b, hc, hb, hb0, (hTd t rfl c b hc hb hb0).mpr hs,
      fun c' b' hc' hb' hb0' hs' hd1 hd2 =>
        hmx c' b' hc' hb' hb0' ((hTd t rfl c' b' hc' hb' hb0').mp hs') hd1 hd2⟩
  | ann u v g =>
    obtain ⟨b, hb, hb0, hbg, hs, hmx⟩ := hLM
    exact ⟨b, hb, hb0, hbg, (hTa u v g rfl b hb hb0 hbg).mpr hs,
      fun b' hb' hb0' hbg' hd hs' =>
        hmx b' hb' hb0' hbg' hd ((hTa u v g rfl b' hb' hb0' hbg').mp hs')⟩

theorem wcpa_dj_llsm_tg_chart_basechange {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (𝔭 : Ideal A) [𝔭.IsPrime] (h : A)
    (S : Type u) [CommRing S] [Algebra ↥W S] (f₀ : S →+* Localization.Away h)
    (P : Type u) [CommRing P] (π : S →+* P)
    (hm : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭) (hh : h ∉ 𝔭)
    (hf : f₀.comp (algebraMap ↥W S) =
      (algebraMap A (Localization.Away h)).comp (algebraMap ↥W A))
    (het : RingHom.Etale f₀) (hπ : Function.Surjective π)
    (hker : RingHom.ker π = (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S)) :
    ∃ (E : Type u) (_ : CommRing E) (fb : P →+* E)
      (ρ : Localization.Away h →+* E) (q : Ideal E) (_ : q.IsPrime),
      RingHom.Etale fb ∧ Function.Surjective ρ ∧
      RingHom.ker ρ = ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
        (algebraMap A (Localization.Away h)) ∧
      (∀ s, fb (π s) = ρ (f₀ s)) ∧
      q = (𝔭.map (algebraMap A (Localization.Away h))).map ρ ∧
      Nonempty ((Localization.AtPrime 𝔭 ⧸
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
          (algebraMap A (Localization.AtPrime 𝔭))) ≃+* Localization.AtPrime q) :=
by

  have hK : (RingHom.ker π).map f₀ = ((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) := by
    rw [hker, Ideal.map_map, hf, ← Ideal.map_map]

  have s1 : ∃ fb : P →+* Localization.Away h ⧸ ((IsLocalRing.maximalIdeal ↥W).map
        (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)),
      RingHom.Etale fb ∧ ∀ s, fb (π s) = Ideal.Quotient.mk _ (f₀ s) := by
    generalize ((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W A)).map (algebraMap A (Localization.Away h)) = K at hK ⊢
    letI := f₀.toAlgebra
    haveI : Algebra.Etale S (Localization.Away h) := het
    set J := RingHom.ker π with hJ
    have h1 : RingHom.Etale (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))) :=
      RingHom.etale_algebraMap.mpr inferInstance
    let e₁ : TensorProduct S (S ⧸ J) (Localization.Away h) ≃+*
        Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) :=
      (Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h)).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm.toRingEquiv
    let e₂ : Localization.Away h ⧸ J.map (algebraMap S (Localization.Away h)) ≃+*
        Localization.Away h ⧸ K := Ideal.quotEquivOfEq hK
    let e := e₁.trans e₂
    let g := e.toRingHom.comp (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h)))
    have hg : RingHom.Etale g := RingHom.Etale.respectsIso.1 _ _ h1
    let fb := g.comp (RingHom.quotientKerEquivOfSurjective hπ).symm.toRingHom
    have hfb : RingHom.Etale fb := RingHom.Etale.respectsIso.2 _ _ hg
    refine ⟨fb, hfb, fun s => ?_⟩
    have hs : (RingHom.quotientKerEquivOfSurjective hπ).symm (π s) = Ideal.Quotient.mk J s :=
      RingHom.quotientKerEquivOfSurjective_symm_apply hπ s
    show e₂ (e₁ (algebraMap (S ⧸ J) (TensorProduct S (S ⧸ J) (Localization.Away h))
      ((RingHom.quotientKerEquivOfSurjective hπ).symm (π s)))) = _
    rw [hs, Algebra.TensorProduct.algebraMap_apply]
    show e₂ ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away h) J).symm
      ((Algebra.TensorProduct.comm S (S ⧸ J) (Localization.Away h))
        (_ ⊗ₜ[S] (1 : Localization.Away h)))) = _
    rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
    rw [Algebra.smul_def, mul_one]
    rfl

  set 𝔞 : Ideal A := (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) with h𝔞d
  have h𝔞 : 𝔞 ≤ 𝔭 := hm
  have hdisj : Disjoint (Submonoid.powers h : Set A) 𝔭 := by
    rw [Set.disjoint_left]
    rintro x ⟨n, rfl⟩ hx
    exact hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hx)
  have hhn : ∀ n : ℕ, h ^ n ∉ 𝔭 := fun n hn => hh (Ideal.IsPrime.mem_of_pow_mem ‹_› n hn)
  have hQp : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔭 ‹_› hdisj

  have hq : ((𝔭.map (algebraMap A (Localization.Away h))).map
      (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h))))).IsPrime := by
    apply Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    rw [Ideal.mk_ker]
    exact Ideal.map_mono h𝔞

  have s3 : Nonempty ((Localization.AtPrime 𝔭 ⧸ 𝔞.map (algebraMap A (Localization.AtPrime 𝔭))) ≃+*
      Localization.AtPrime ((𝔭.map (algebraMap A (Localization.Away h))).map
        (Ideal.Quotient.mk (𝔞.map (algebraMap A (Localization.Away h)))))) := by
    have hQc : (𝔭.map (algebraMap A (Localization.Away h))).comap
        (algebraMap A (Localization.Away h)) = 𝔭 :=
      IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
    set I : Ideal (Localization.Away h) := 𝔞.map (algebraMap A (Localization.Away h)) with hI
    set Q : Ideal (Localization.Away h) := 𝔭.map (algebraMap A (Localization.Away h)) with hQ
    set q : Ideal (Localization.Away h ⧸ I) := Q.map (Ideal.Quotient.mk I) with hqdef
    have hIQ : I ≤ Q := Ideal.map_mono h𝔞
    have hK1 : q.comap (Ideal.Quotient.mk I) = Q := by
      rw [hqdef, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact sup_eq_left.mpr hIQ
    have hK2 : ∀ a : A, Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a) ∈ q ↔ a ∈ 𝔭 := by
      intro a
      rw [← Ideal.mem_comap, hK1, ← Ideal.mem_comap, hQc]
    have hunit : ∀ y : 𝔭.primeCompl, IsUnit (((algebraMap (Localization.Away h ⧸ I)
        (Localization.AtPrime q)).comp ((Ideal.Quotient.mk I).comp
          (algebraMap A (Localization.Away h)))) y) := by
      intro y
      exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q _).mpr
        (fun hm => y.2 ((hK2 y).mp hm))
    have hK3 : ∀ t : Localization.Away h ⧸ I, t ∉ q → ∃ (y : Localization.Away h) (m : ℕ) (b : A),
        Ideal.Quotient.mk I y = t ∧
        y * algebraMap A (Localization.Away h) h ^ m = algebraMap A (Localization.Away h) b ∧
        b ∉ 𝔭 := by
      intro t ht
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective t
      obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj h y
      refine ⟨y, m, b, rfl, hb, ?_⟩
      intro hb𝔭
      have h1 : algebraMap A (Localization.Away h) b ∈ Q := Ideal.mem_map_of_mem _ hb𝔭
      rw [← hb] at h1
      rcases hQp.mem_or_mem h1 with h2 | h2
      · exact ht (Ideal.mem_map_of_mem _ h2)
      · rw [← map_pow, ← Ideal.mem_comap, hQc] at h2
        exact hhn m h2
    let θ := IsLocalization.lift (M := 𝔭.primeCompl) (S := Localization.AtPrime 𝔭) hunit
    have hsurj : Function.Surjective θ := by
      intro z
      obtain ⟨⟨e, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
      obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective e
      obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj h x
      have hs0 : b * h ^ n ∈ 𝔭.primeCompl := fun hm =>
        (Ideal.IsPrime.mem_or_mem ‹_› hm).elim hb (hhn n)
      refine ⟨IsLocalization.mk' (Localization.AtPrime 𝔭) (a * h ^ m) ⟨b * h ^ n, hs0⟩, ?_⟩
      rw [IsLocalization.lift_mk'_spec]
      have hZ := IsLocalization.mk'_spec (Localization.AtPrime q) (Ideal.Quotient.mk I x) t
      rw [← hy] at hZ
      simp only [RingHom.comp_apply, map_mul, map_pow]
      rw [← ha, ← hyb]
      simp only [map_mul, map_pow]
      rw [← hZ]
      ring
    have hkerθ : RingHom.ker θ = 𝔞.map (algebraMap A (Localization.AtPrime 𝔭)) := by
      apply le_antisymm
      · intro w hw
        rw [RingHom.mem_ker] at hw
        obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl w
        rw [IsLocalization.lift_mk'_spec, mul_zero] at hw
        obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q)
          (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) a))).mp hw
        obtain ⟨y, m, b, hy, hyb, hb⟩ := hK3 t t.2
        have e1 : Ideal.Quotient.mk I (algebraMap A (Localization.Away h) b) =
            ↑t * Ideal.Quotient.mk I (algebraMap A (Localization.Away h) h ^ m) := by
          rw [← hyb, map_mul, hy]
        have e2 : Ideal.Quotient.mk I (algebraMap A (Localization.Away h) (b * a)) = 0 := by
          rw [map_mul, map_mul, e1]
          linear_combination (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) h ^ m)) * ht
        rw [Ideal.Quotient.eq_zero_iff_mem] at e2
        obtain ⟨c, ⟨k, rfl⟩, hc⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
          (Submonoid.powers h) (Localization.Away h) 𝔞 (b * a)).mp e2
        rw [IsLocalization.mk'_mem_map_algebraMap_iff 𝔭.primeCompl]
        refine ⟨h ^ k * b, fun hm => (Ideal.IsPrime.mem_or_mem ‹_› hm).elim (hhn k) hb, ?_⟩
        rw [mul_assoc]
        exact hc
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker, IsLocalization.lift_eq]
        show algebraMap (Localization.Away h ⧸ I) (Localization.AtPrime q)
          (Ideal.Quotient.mk I (algebraMap A (Localization.Away h) x)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hx), map_zero]
    exact ⟨(Ideal.quotEquivOfEq hkerθ.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)⟩

  obtain ⟨fb, hfb, hfbπ⟩ := s1
  exact ⟨_, inferInstance, fb, Ideal.Quotient.mk _, _, hq, hfb, Ideal.Quotient.mk_surjective,
    Ideal.mk_ker, hfbπ, rfl, s3⟩

theorem wcpa_dj_llsm_tg_etale_line_dvr (k E : Type u) [Field k] [CommRing E]
    (f : Polynomial k →+* E) (q : Ideal E) [q.IsPrime] :
    RingHom.Etale f → q = Ideal.span {f Polynomial.X} →
    ∃ _ : IsDomain (Localization.AtPrime q), IsDiscreteValuationRing (Localization.AtPrime q) :=
by
  intro hf hq
  letI := f.toAlgebra
  haveI : Algebra.Etale (Polynomial k) E := RingHom.Etale.toAlgebra hf
  haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing (Polynomial k) E
  have hreg : IsSMulRegular E (algebraMap (Polynomial k) E Polynomial.X) := by
    apply IsSMulRegular.of_flat
    intro a b h
    exact mul_left_cancel₀ Polynomial.X_ne_zero h
  haveI : IsNoetherianRing (Localization.AtPrime q) :=
    IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) inferInstance
  haveI : Module.Flat E (Localization.AtPrime q) := IsLocalization.flat (Localization.AtPrime q) q.primeCompl
  have hm : IsLocalRing.maximalIdeal (Localization.AtPrime q) =
      Ideal.span {algebraMap E (Localization.AtPrime q) (f Polynomial.X)} := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal,
      congrArg (Ideal.map (algebraMap E (Localization.AtPrime q))) hq, Ideal.map_span,
      Set.image_singleton]
  have hτ : IsSMulRegular (Localization.AtPrime q)
      (algebraMap E (Localization.AtPrime q) (f Polynomial.X)) :=
    IsSMulRegular.of_flat (S := Localization.AtPrime q) hreg
  generalize algebraMap E (Localization.AtPrime q) (f Polynomial.X) = τ at hm hτ
  have hτc : ∀ n : ℕ, ∀ a b : Localization.AtPrime q, τ ^ n * a = τ ^ n * b → a = b := by
    intro n
    induction n with
    | zero => intro a b h; simpa using h
    | succ n ih =>
      intro a b h
      apply ih
      apply hτ
      simp only [smul_eq_mul]
      rw [pow_succ] at h
      calc τ * (τ ^ n * a) = τ ^ n * τ * a := by ring
        _ = τ ^ n * τ * b := h
        _ = τ * (τ ^ n * b) := by ring
  have hτn : ∀ n, τ ^ n ≠ 0 := fun n h => one_ne_zero (hτc n 1 0 (by rw [h]; simp))
  have hK : ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i = ⊥ :=
    Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top
  have hfac : ∀ x : Localization.AtPrime q, x ≠ 0 →
      ∃ n : ℕ, ∃ u : Localization.AtPrime q, IsUnit u ∧ x = τ ^ n * u := by
    intro x hx
    classical
    have hex : ∃ n, x ∉ Ideal.span {τ ^ n} := by
      by_contra hcon
      push_neg at hcon
      apply hx
      have : x ∈ ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i := by
        rw [Ideal.mem_iInf]
        intro i
        rw [hm, Ideal.span_singleton_pow]
        exact hcon i
      rw [hK] at this
      exact this
    have hN : x ∉ Ideal.span {τ ^ Nat.find hex} := Nat.find_spec hex
    have hN0 : Nat.find hex ≠ 0 := by
      intro h0
      apply hN
      rw [h0, pow_zero, Ideal.span_singleton_one]
      trivial
    obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hN0
    have hxn : x ∈ Ideal.span {τ ^ n} := by
      by_contra h
      have := Nat.find_min' hex h
      omega
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hxn
    refine ⟨n, u, ?_, by rw [← hu, mul_comm]⟩
    by_contra hu'
    have hum : u ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      (IsLocalRing.mem_maximalIdeal u).mpr hu'
    rw [hm] at hum
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hum
    apply hN
    rw [Ideal.mem_span_singleton']
    exact ⟨w, by rw [hn, pow_succ, ← hu, ← hw]; ring⟩
  haveI : NoZeroDivisors (Localization.AtPrime q) := by
    constructor
    intro x y hxy
    by_contra h
    push_neg at h
    obtain ⟨a, u, hu, rfl⟩ := hfac x h.1
    obtain ⟨b, v, hv, rfl⟩ := hfac y h.2
    have h2 : τ ^ (a + b) * (u * v) = 0 := by
      rw [pow_add]
      calc τ ^ a * τ ^ b * (u * v) = τ ^ a * u * (τ ^ b * v) := by ring
        _ = 0 := hxy
    exact hτn (a + b) ((hu.mul hv).mul_left_eq_zero.mp h2)
  haveI : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
  refine ⟨inferInstance, ?_⟩
  have hnf : ¬ IsField (Localization.AtPrime q) := by
    intro hF
    have h1 := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
    have hτm : τ ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
      rw [hm]; exact Ideal.subset_span rfl
    rw [h1] at hτm
    exact hτn 1 (by simpa using hτm)
  have hP : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (Localization.AtPrime q)) :=
    ⟨⟨τ, hm⟩⟩
  exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime q) hnf).out 5 1).mp hP

theorem wcpa_dj_llsm_tg_etale_node_quotients (k E : Type u) [Field k] [CommRing E]
    (f : (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* E)
    (q : Ideal E) [q.IsPrime] :
    RingHom.Etale f →
    q = Ideal.span {f (Ideal.Quotient.mk _ (MvPolynomial.X 0)),
      f (Ideal.Quotient.mk _ (MvPolynomial.X 1))} →
    algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) *
        algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = 0 ∧
      IsLocalRing.maximalIdeal (Localization.AtPrime q) =
        Ideal.span {algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))),
          algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1)))} ∧
      (∃ _ : IsDomain (Localization.AtPrime q ⧸ Ideal.span
          {algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0)))}),
        IsIntegrallyClosed (Localization.AtPrime q ⧸ Ideal.span
          {algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0)))})) ∧
      (∃ _ : IsDomain (Localization.AtPrime q ⧸ Ideal.span
          {algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1)))}),
        IsIntegrallyClosed (Localization.AtPrime q ⧸ Ideal.span
          {algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1)))})) ∧
      Ideal.Quotient.mk (Ideal.span
          {algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0)))})
        (algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) ≠ 0 ∧
      Ideal.Quotient.mk (Ideal.span
          {algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 1)))})
        (algebraMap E (Localization.AtPrime q) (f (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) ≠ 0 :=
by
  intro hf hq
  have line_dvr : ∀ (k E : Type u) [Field k] [CommRing E]
      (f : Polynomial k →+* E) (q : Ideal E) [q.IsPrime],
      RingHom.Etale f → q = Ideal.span {f Polynomial.X} →
      ∃ _ : IsDomain (Localization.AtPrime q), IsDiscreteValuationRing (Localization.AtPrime q) := by
    intro k E _ _ f q _ hf hq
    letI := f.toAlgebra
    haveI : Algebra.Etale (Polynomial k) E := RingHom.Etale.toAlgebra hf
    haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing (Polynomial k) E
    have hreg : IsSMulRegular E (algebraMap (Polynomial k) E Polynomial.X) := by
      apply IsSMulRegular.of_flat
      intro a b h
      exact mul_left_cancel₀ Polynomial.X_ne_zero h
    haveI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) inferInstance
    haveI : Module.Flat E (Localization.AtPrime q) := IsLocalization.flat (Localization.AtPrime q) q.primeCompl
    have hm : IsLocalRing.maximalIdeal (Localization.AtPrime q) =
        Ideal.span {algebraMap E (Localization.AtPrime q) (f Polynomial.X)} := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal,
        congrArg (Ideal.map (algebraMap E (Localization.AtPrime q))) hq, Ideal.map_span,
        Set.image_singleton]
    have hτ : IsSMulRegular (Localization.AtPrime q)
        (algebraMap E (Localization.AtPrime q) (f Polynomial.X)) :=
      IsSMulRegular.of_flat (S := Localization.AtPrime q) hreg
    generalize algebraMap E (Localization.AtPrime q) (f Polynomial.X) = τ at hm hτ
    have hτc : ∀ n : ℕ, ∀ a b : Localization.AtPrime q, τ ^ n * a = τ ^ n * b → a = b := by
      intro n
      induction n with
      | zero => intro a b h; simpa using h
      | succ n ih =>
        intro a b h
        apply ih
        apply hτ
        simp only [smul_eq_mul]
        rw [pow_succ] at h
        calc τ * (τ ^ n * a) = τ ^ n * τ * a := by ring
          _ = τ ^ n * τ * b := h
          _ = τ * (τ ^ n * b) := by ring
    have hτn : ∀ n, τ ^ n ≠ 0 := fun n h => one_ne_zero (hτc n 1 0 (by rw [h]; simp))
    have hK : ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    have hfac : ∀ x : Localization.AtPrime q, x ≠ 0 →
        ∃ n : ℕ, ∃ u : Localization.AtPrime q, IsUnit u ∧ x = τ ^ n * u := by
      intro x hx
      classical
      have hex : ∃ n, x ∉ Ideal.span {τ ^ n} := by
        by_contra hcon
        push_neg at hcon
        apply hx
        have : x ∈ ⨅ i : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime q) ^ i := by
          rw [Ideal.mem_iInf]
          intro i
          rw [hm, Ideal.span_singleton_pow]
          exact hcon i
        rw [hK] at this
        exact this
      have hN : x ∉ Ideal.span {τ ^ Nat.find hex} := Nat.find_spec hex
      have hN0 : Nat.find hex ≠ 0 := by
        intro h0
        apply hN
        rw [h0, pow_zero, Ideal.span_singleton_one]
        trivial
      obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hN0
      have hxn : x ∈ Ideal.span {τ ^ n} := by
        by_contra h
        have := Nat.find_min' hex h
        omega
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hxn
      refine ⟨n, u, ?_, by rw [← hu, mul_comm]⟩
      by_contra hu'
      have hum : u ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        (IsLocalRing.mem_maximalIdeal u).mpr hu'
      rw [hm] at hum
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hum
      apply hN
      rw [Ideal.mem_span_singleton']
      exact ⟨w, by rw [hn, pow_succ, ← hu, ← hw]; ring⟩
    haveI : NoZeroDivisors (Localization.AtPrime q) := by
      constructor
      intro x y hxy
      by_contra h
      push_neg at h
      obtain ⟨a, u, hu, rfl⟩ := hfac x h.1
      obtain ⟨b, v, hv, rfl⟩ := hfac y h.2
      have h2 : τ ^ (a + b) * (u * v) = 0 := by
        rw [pow_add]
        calc τ ^ a * τ ^ b * (u * v) = τ ^ a * u * (τ ^ b * v) := by ring
          _ = 0 := hxy
      exact hτn (a + b) ((hu.mul hv).mul_left_eq_zero.mp h2)
    haveI : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
    refine ⟨inferInstance, ?_⟩
    have hnf : ¬ IsField (Localization.AtPrime q) := by
      intro hF
      have h1 := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
      have hτm : τ ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
        rw [hm]; exact Ideal.subset_span rfl
      rw [h1] at hτm
      exact hτn 1 (by simpa using hτm)
    have hP : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (Localization.AtPrime q)) :=
      ⟨⟨τ, hm⟩⟩
    exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime q) hnf).out 5 1).mp hP
  have t_s7 : ∀ (Q R : Type u) [CommRing Q] [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (φ : Q ≃+* R) (w : Q) (hm : IsLocalRing.maximalIdeal R = Ideal.span {φ w}),
    (∃ _ : IsDomain Q, IsIntegrallyClosed Q) ∧ w ≠ 0 := by
    intro Q R _ _ _ _ φ w hm
    haveI : IsDomain Q := MulEquiv.isDomain R φ.toMulEquiv
    refine ⟨⟨this, IsIntegrallyClosed.of_equiv φ.symm⟩, ?_⟩
    rintro rfl
    rw [map_zero, Ideal.span_singleton_eq_bot.mpr rfl] at hm
    exact IsDiscreteValuationRing.not_a_field' hm

  have t_s3 : ∀ (P E : Type u) [CommRing P] [CommRing E] (f : P →+* E) (x : P) (hf : RingHom.Etale f),
    ∃ g : (P ⧸ Ideal.span {x}) →+* (E ⧸ Ideal.span {f x}), RingHom.Etale g ∧
      ∀ p : P, g (Ideal.Quotient.mk (Ideal.span {x}) p) =
        Ideal.Quotient.mk (Ideal.span {f x}) (f p) := by
    intro P E _ _ f x hf
    letI := f.toAlgebra
    haveI : Algebra.Etale P E := hf
    have hI : (Ideal.span {x} : Ideal P).map (algebraMap P E) = Ideal.span {f x} := by
      rw [Ideal.map_span, Set.image_singleton]; rfl
    have h1 : RingHom.Etale (algebraMap (P ⧸ Ideal.span {x}) (TensorProduct P (P ⧸ Ideal.span {x}) E)) :=
      RingHom.etale_algebraMap.mpr inferInstance
    let h2 : TensorProduct P (P ⧸ Ideal.span {x}) E ≃+* TensorProduct P E (P ⧸ Ideal.span {x}) :=
      (Algebra.TensorProduct.comm P (P ⧸ Ideal.span {x}) E).toRingEquiv
    let h3 : TensorProduct P E (P ⧸ Ideal.span {x}) ≃+* E ⧸ (Ideal.span {x} : Ideal P).map (algebraMap P E) :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot E (Ideal.span {x})).symm.toRingEquiv
    let h4 : E ⧸ (Ideal.span {x} : Ideal P).map (algebraMap P E) ≃+* E ⧸ Ideal.span {f x} :=
      Ideal.quotEquivOfEq hI
    refine ⟨h4.toRingHom.comp (h3.toRingHom.comp (h2.toRingHom.comp
      (algebraMap (P ⧸ Ideal.span {x}) (TensorProduct P (P ⧸ Ideal.span {x}) E)))), ?_, ?_⟩
    · refine RingHom.Etale.stableUnderComposition _ _ ?_ (RingHom.Etale.of_bijective h4.bijective)
      refine RingHom.Etale.stableUnderComposition _ _ ?_ (RingHom.Etale.of_bijective h3.bijective)
      exact RingHom.Etale.stableUnderComposition _ _ h1 (RingHom.Etale.of_bijective h2.bijective)
    · intro p
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, h2, h3, h4,
        Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        AlgEquiv.coe_ringEquiv, Algebra.TensorProduct.comm_tmul]
      rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
      show Ideal.quotEquivOfEq hI (Ideal.Quotient.mk _ (p • (1 : E))) = _
      rw [Ideal.quotEquivOfEq_mk, Algebra.smul_def, mul_one]
      rfl

  have t_s4 : ∀ (E : Type u) [CommRing E] (q : Ideal E) [q.IsPrime] (a : E) (ha : a ∈ q)
    (q' : Ideal (E ⧸ Ideal.span {a})) [q'.IsPrime]
    (hq' : q' = q.map (Ideal.Quotient.mk (Ideal.span {a}))),
    ∃ φ : (Localization.AtPrime q ⧸ Ideal.span {algebraMap E (Localization.AtPrime q) a}) ≃+*
        Localization.AtPrime q',
      ∀ e : E, φ (Ideal.Quotient.mk (Ideal.span {algebraMap E (Localization.AtPrime q) a})
          (algebraMap E (Localization.AtPrime q) e)) =
        algebraMap (E ⧸ Ideal.span {a}) (Localization.AtPrime q')
          (Ideal.Quotient.mk (Ideal.span {a}) e) := by
    intro E _ q _ a ha q' _ hq'
    have hcomap : q'.comap (Ideal.Quotient.mk (Ideal.span {a})) = q := by
      rw [hq', Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left]
      rw [Ideal.span_le, Set.singleton_subset_iff]; exact ha
    let θ : Localization.AtPrime q →+* Localization.AtPrime q' :=
      Localization.localRingHom q q' (Ideal.Quotient.mk (Ideal.span {a})) hcomap.symm
    have hθ : ∀ e, θ (algebraMap E _ e) =
        algebraMap _ (Localization.AtPrime q') (Ideal.Quotient.mk (Ideal.span {a}) e) :=
      fun e => Localization.localRingHom_to_map _ _ _ _ _
    have hJ : ∀ y ∈ Ideal.span {algebraMap E (Localization.AtPrime q) a}, θ y = 0 := by
      intro y hy
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [map_mul, hθ, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self a),
        map_zero, mul_zero]
    let θb := Ideal.Quotient.lift (Ideal.span {algebraMap E (Localization.AtPrime q) a}) θ hJ
    let ψ0 : E ⧸ Ideal.span {a} →+*
        Localization.AtPrime q ⧸ Ideal.span {algebraMap E (Localization.AtPrime q) a} :=
      Ideal.Quotient.lift (Ideal.span {a})
        ((Ideal.Quotient.mk _).comp (algebraMap E (Localization.AtPrime q))) (by
          intro y hy
          obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
          rw [RingHom.comp_apply, map_mul, map_mul,
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), mul_zero])
    have hψ0 : ∀ s : q'.primeCompl, IsUnit (ψ0 s) := by
      rintro ⟨s, hs⟩
      obtain ⟨e, rfl⟩ := Ideal.Quotient.mk_surjective s
      have he : e ∉ q := by
        intro h; apply hs; rw [← hcomap] at h; exact h
      show IsUnit (ψ0 (Ideal.Quotient.mk _ e))
      rw [Ideal.Quotient.lift_mk]
      exact (IsLocalization.map_units (Localization.AtPrime q) (⟨e, he⟩ : q.primeCompl)).map
        (Ideal.Quotient.mk (Ideal.span {algebraMap E (Localization.AtPrime q) a}))
    let ψ : Localization.AtPrime q' →+*
        Localization.AtPrime q ⧸ Ideal.span {algebraMap E (Localization.AtPrime q) a} :=
      IsLocalization.lift hψ0
    have hψ : ∀ e, ψ (algebraMap _ (Localization.AtPrime q') (Ideal.Quotient.mk (Ideal.span {a}) e)) =
        Ideal.Quotient.mk _ (algebraMap E (Localization.AtPrime q) e) := by
      intro e
      rw [IsLocalization.lift_eq]
      exact Ideal.Quotient.lift_mk _ _ _
    refine ⟨RingEquiv.ofRingHom θb ψ ?_ ?_, ?_⟩
    · apply IsLocalization.ringHom_ext q'.primeCompl
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun e => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hψ, Ideal.Quotient.lift_mk, hθ]
    · apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext q.primeCompl
      refine RingHom.ext fun e => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [Ideal.Quotient.lift_mk, hθ, hψ]
    · intro e
      exact (Ideal.Quotient.lift_mk (Ideal.span {algebraMap E (Localization.AtPrime q) a}) θ hJ).trans (hθ e)

  have t_s5 : ∀ (k : Type u) [Field k],
    ∃ e : Polynomial k ≃+* ((MvPolynomial (Fin 2) k ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) ⧸
        Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
          (MvPolynomial.X 0)}),
      e Polynomial.X = Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X 0)})
        (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
          (MvPolynomial.X 1)) := by
    intro k _
    set Z : Ideal (MvPolynomial (Fin 2) k) := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
      with hZ
    set Y : Ideal (MvPolynomial (Fin 2) k ⧸ Z) := Ideal.span {Ideal.Quotient.mk Z (MvPolynomial.X 0)}
      with hY
    let M : MvPolynomial (Fin 2) k →+* (MvPolynomial (Fin 2) k ⧸ Z) ⧸ Y :=
      (Ideal.Quotient.mk Y).comp (Ideal.Quotient.mk Z)
    have hM0 : M (MvPolynomial.X 0) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    let α : Polynomial k →+* (MvPolynomial (Fin 2) k ⧸ Z) ⧸ Y :=
      Polynomial.eval₂RingHom (M.comp MvPolynomial.C) (M (MvPolynomial.X 1))
    let β0 : MvPolynomial (Fin 2) k →+* Polynomial k :=
      MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
    have hβ0X0 : β0 (MvPolynomial.X 0) = 0 := by simp [β0]
    have hβ0X1 : β0 (MvPolynomial.X 1) = Polynomial.X := by simp [β0]
    have hβ0C : ∀ r, β0 (MvPolynomial.C r) = Polynomial.C r := by intro r; simp [β0]
    have hβ0Z : ∀ y ∈ Z, β0 y = 0 := by
      intro y hy
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [map_mul, map_mul, hβ0X0, zero_mul, mul_zero]
    let β1 := Ideal.Quotient.lift Z β0 hβ0Z
    have hβ1Y : ∀ y ∈ Y, β1 y = 0 := by
      intro y hy
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [map_mul, Ideal.Quotient.lift_mk, hβ0X0, mul_zero]
    let β := Ideal.Quotient.lift Y β1 hβ1Y
    have hβM : ∀ p, β (M p) = β0 p := by
      intro p
      show β (Ideal.Quotient.mk Y (Ideal.Quotient.mk Z p)) = _
      rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
    have hαX : α Polynomial.X = M (MvPolynomial.X 1) := Polynomial.eval₂_X _ _
    have hαC : ∀ r, α (Polynomial.C r) = M (MvPolynomial.C r) := fun r => Polynomial.eval₂_C _ _
    refine ⟨RingEquiv.ofRingHom α β ?_ ?_, hαX⟩
    · apply Ideal.Quotient.ringHom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        show α (β (M (MvPolynomial.C r))) = M (MvPolynomial.C r)
        rw [hβM, hβ0C, hαC]
      · intro i
        show α (β (M (MvPolynomial.X i))) = M (MvPolynomial.X i)
        fin_cases i
        · show α (β (M (MvPolynomial.X 0))) = M (MvPolynomial.X 0)
          rw [hβM, hβ0X0, map_zero, hM0]
        · show α (β (M (MvPolynomial.X 1))) = M (MvPolynomial.X 1)
          rw [hβM, hβ0X1, hαX]
    · apply Polynomial.ringHom_ext
      · intro r
        show β (α (Polynomial.C r)) = Polynomial.C r
        rw [hαC, hβM, hβ0C]
      · show β (α Polynomial.X) = Polynomial.X
        rw [hαX, hβM, hβ0X1]

  have t_s6 : ∀ (k : Type u) [Field k],
    ∃ σ : (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) ≃+*
        (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}),
      σ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X 0)) =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X 1) ∧
      σ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X 1)) =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X 0) := by
    intro k _
    let ρ : MvPolynomial (Fin 2) k ≃+* MvPolynomial (Fin 2) k :=
      (MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 2) 1)).toRingEquiv
    have hρ : ∀ i, ρ (MvPolynomial.X i) = MvPolynomial.X (Equiv.swap (0 : Fin 2) 1 i) :=
      fun i => MvPolynomial.rename_X _ _
    have hZ : (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) k)) =
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}).map
          (ρ : MvPolynomial (Fin 2) k →+* MvPolynomial (Fin 2) k) := by
      rw [Ideal.map_span, Set.image_singleton, RingHom.coe_coe, map_mul, hρ, hρ,
        Equiv.swap_apply_left, Equiv.swap_apply_right, mul_comm]
    refine ⟨Ideal.quotientEquiv _ _ ρ hZ, ?_, ?_⟩
    · rw [Ideal.quotientEquiv_mk, hρ, Equiv.swap_apply_left]
    · rw [Ideal.quotientEquiv_mk, hρ, Equiv.swap_apply_right]



  have H : ∀ g : (MvPolynomial (Fin 2) k ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* E,
      RingHom.Etale g →
      q = Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 0)),
        g (Ideal.Quotient.mk _ (MvPolynomial.X 1))} →
      (∃ _ : IsDomain (Localization.AtPrime q ⧸ Ideal.span
          {algebraMap E (Localization.AtPrime q) (g (Ideal.Quotient.mk _ (MvPolynomial.X 0)))}),
        IsIntegrallyClosed (Localization.AtPrime q ⧸ Ideal.span
          {algebraMap E (Localization.AtPrime q) (g (Ideal.Quotient.mk _ (MvPolynomial.X 0)))})) ∧
      Ideal.Quotient.mk (Ideal.span
          {algebraMap E (Localization.AtPrime q) (g (Ideal.Quotient.mk _ (MvPolynomial.X 0)))})
        (algebraMap E (Localization.AtPrime q) (g (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) ≠ 0 := by
    intro g hg hqg
    obtain ⟨g₁, hg₁, hg₁mk⟩ := t_s3 _ E g (Ideal.Quotient.mk _ (MvPolynomial.X 0)) hg
    obtain ⟨e, he⟩ := t_s5 k
    obtain ⟨F, hF⟩ : ∃ F : Polynomial k →+* E ⧸ Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 0))},
        F = g₁.comp e.toRingHom := ⟨_, rfl⟩
    have hFet : RingHom.Etale F := by
      rw [hF]
      exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective e.bijective) hg₁
    have hFX : F Polynomial.X = Ideal.Quotient.mk
        (Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 0))})
        (g (Ideal.Quotient.mk _ (MvPolynomial.X 1))) := by
      rw [hF, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, he, hg₁mk]
    have ha : g (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ q := by
      rw [hqg]; exact Ideal.subset_span (Set.mem_insert _ _)
    obtain ⟨q', hq'⟩ : ∃ q' : Ideal (E ⧸ Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 0))}),
        q' = q.map (Ideal.Quotient.mk _) := ⟨_, rfl⟩
    haveI hq'p : q'.IsPrime := by
      rw [hq']
      apply Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      rw [Ideal.mk_ker, Ideal.span_le, Set.singleton_subset_iff]; exact ha
    have hq'X : q' = Ideal.span {F Polynomial.X} := by
      rw [hq', hFX, hqg, Ideal.map_span, Set.image_pair,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _),
        Ideal.span_insert_zero]
    obtain ⟨hD, hDVR⟩ := line_dvr k _ F q' hFet hq'X
    obtain ⟨φ, hφ⟩ := t_s4 E q _ ha q' hq'
    have hm : IsLocalRing.maximalIdeal (Localization.AtPrime q') =
        Ideal.span {φ (Ideal.Quotient.mk (Ideal.span
          {algebraMap E (Localization.AtPrime q) (g (Ideal.Quotient.mk _ (MvPolynomial.X 0)))})
          (algebraMap E (Localization.AtPrime q) (g (Ideal.Quotient.mk _ (MvPolynomial.X 1)))))} := by
      refine (Localization.AtPrime.map_eq_maximalIdeal).symm.trans ?_
      refine (congrArg (Ideal.map (algebraMap _ (Localization.AtPrime q'))) hq'X).trans ?_
      rw [Ideal.map_span, Set.image_singleton, hFX, hφ]
    exact t_s7 _ _ φ _ hm
  have hx01 : (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
      (MvPolynomial.X 0 : MvPolynomial (Fin 2) k)) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = 0 := by
    rw [← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  obtain ⟨σ, hσ0, hσ1⟩ := t_s6 k
  have Hf := H f hf hq
  have Hg := H (f.comp σ.toRingHom)
    (RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective σ.bijective) hf)
    (by
      rw [RingHom.comp_apply, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
        hσ0, hσ1, hq, Ideal.span_pair_comm])
  rw [RingHom.comp_apply, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
    hσ0, hσ1] at Hg
  refine ⟨?_, ?_, Hf.1, Hg.1, Hf.2, Hg.2⟩
  · rw [← map_mul, ← map_mul, hx01, map_zero, map_zero]
  · refine (Localization.AtPrime.map_eq_maximalIdeal).symm.trans ?_
    refine (congrArg (Ideal.map (algebraMap E (Localization.AtPrime q))) hq).trans ?_
    rw [Ideal.map_span, Set.image_pair]

theorem wcpa_dj_llsm_tg_node_closure_prod (B : Type u) [CommRing B] (u v : B) (huv : u * v = 0)
    [IsDomain (B ⧸ Ideal.span {u})] [IsIntegrallyClosed (B ⧸ Ideal.span {u})]
    [IsDomain (B ⧸ Ideal.span {v})] [IsIntegrallyClosed (B ⧸ Ideal.span {v})]
    (hu : Ideal.Quotient.mk (Ideal.span {u}) v ≠ 0)
    (hv : Ideal.Quotient.mk (Ideal.span {v}) u ≠ 0) :
    ∃ φ : ↥(integralClosure B (FractionRing B)) ≃+* (B ⧸ Ideal.span {u}) × (B ⧸ Ideal.span {v}),
      ∀ b, φ (algebraMap B _ b) = (Ideal.Quotient.mk _ b, Ideal.Quotient.mk _ b) :=
by
  classical

  have hmemu : ∀ b : B, Ideal.Quotient.mk (Ideal.span {u}) b = 0 ↔ ∃ c, c * u = b := fun b => by
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
  have hmemv : ∀ b : B, Ideal.Quotient.mk (Ideal.span {v}) b = 0 ↔ ∃ c, c * v = b := fun b => by
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
  have annU : ∀ b : B, b * u = 0 → ∃ c, c * v = b := by
    intro b hb
    rw [← hmemv]
    have h1 : Ideal.Quotient.mk (Ideal.span {v}) b * Ideal.Quotient.mk (Ideal.span {v}) u = 0 := by
      rw [← map_mul, hb, map_zero]
    exact (mul_eq_zero.mp h1).resolve_right hv
  have annV : ∀ b : B, b * v = 0 → ∃ c, c * u = b := by
    intro b hb
    rw [← hmemu]
    have h1 : Ideal.Quotient.mk (Ideal.span {u}) b * Ideal.Quotient.mk (Ideal.span {u}) v = 0 := by
      rw [← map_mul, hb, map_zero]
    exact (mul_eq_zero.mp h1).resolve_right hu
  have hint : ∀ b : B, (∃ c, c * u = b) → (∃ c, c * v = b) → b = 0 := by
    rintro b ⟨c, rfl⟩ ⟨c', hc'⟩
    have h1 : Ideal.Quotient.mk (Ideal.span {v}) c * Ideal.Quotient.mk (Ideal.span {v}) u = 0 := by
      rw [← map_mul]
      exact (hmemv _).mpr ⟨c', hc'⟩
    obtain ⟨d, rfl⟩ := (hmemv c).mp ((mul_eq_zero.mp h1).resolve_right hv)
    calc d * v * u = d * (u * v) := by ring
      _ = 0 := by rw [huv, mul_zero]
  have hl : u + v ∈ nonZeroDivisors B := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have hxu : x * u = 0 := hint _ ⟨x, rfl⟩ ⟨-x, by linear_combination -hx⟩
    have hxv : x * v = 0 := by linear_combination hx - hxu
    exact hint x (annV x hxv) (annU x hxu)
  have hnzu : ∀ s ∈ nonZeroDivisors B, Ideal.Quotient.mk (Ideal.span {u}) s ≠ 0 := by
    intro s hs h0
    obtain ⟨c, rfl⟩ := (hmemu s).mp h0
    have h2 : (c * u) * v = 0 := by rw [mul_assoc, huv, mul_zero]
    have hv0 : v = 0 := (mul_left_mem_nonZeroDivisors_eq_zero_iff hs).mp h2
    exact hu (by rw [hv0, map_zero])
  have hnzv : ∀ s ∈ nonZeroDivisors B, Ideal.Quotient.mk (Ideal.span {v}) s ≠ 0 := by
    intro s hs h0
    obtain ⟨c, rfl⟩ := (hmemv s).mp h0
    have h2 : (c * v) * u = 0 := by rw [mul_assoc, mul_comm v u, huv, mul_zero]
    have hu0 : u = 0 := (mul_left_mem_nonZeroDivisors_eq_zero_iff hs).mp h2
    exact hv (by rw [hu0, map_zero])

  have branch : ∀ (I : Ideal B) [IsDomain (B ⧸ I)],
      (∀ s ∈ nonZeroDivisors B, Ideal.Quotient.mk I s ≠ 0) →
      ∃ ψ : FractionRing B →+* FractionRing (B ⧸ I), ∀ b : B,
        ψ (algebraMap B (FractionRing B) b) =
          algebraMap (B ⧸ I) (FractionRing (B ⧸ I)) (Ideal.Quotient.mk I b) := by
    intro I _ hI
    have hunit : ∀ y : nonZeroDivisors B, IsUnit (((algebraMap (B ⧸ I) (FractionRing (B ⧸ I))).comp
        (Ideal.Quotient.mk I)) (y : B)) := by
      intro y
      rw [isUnit_iff_ne_zero, RingHom.comp_apply]
      intro h0
      exact hI y y.2 ((IsFractionRing.injective (B ⧸ I) (FractionRing (B ⧸ I)))
        (h0.trans (map_zero _).symm))
    exact ⟨IsLocalization.lift (M := nonZeroDivisors B) (S := FractionRing B) hunit,
      fun b => IsLocalization.lift_eq hunit b⟩

  have lands : ∀ (I : Ideal B) [IsDomain (B ⧸ I)] [IsIntegrallyClosed (B ⧸ I)]
      (ψ : FractionRing B →+* FractionRing (B ⧸ I)),
      (∀ b : B, ψ (algebraMap B (FractionRing B) b) =
          algebraMap (B ⧸ I) (FractionRing (B ⧸ I)) (Ideal.Quotient.mk I b)) →
      ∀ x : FractionRing B, IsIntegral B x →
        ∃ d : B ⧸ I, algebraMap (B ⧸ I) (FractionRing (B ⧸ I)) d = ψ x := by
    intro I _ _ ψ hψ x hx
    have hcomp : ψ.comp (algebraMap B (FractionRing B)) =
        (algebraMap (B ⧸ I) (FractionRing (B ⧸ I))).comp (Ideal.Quotient.mk I) := RingHom.ext hψ
    obtain ⟨p, hpm, hp⟩ := hx
    apply IsIntegrallyClosed.isIntegral_iff.mp
    refine ⟨p.map (Ideal.Quotient.mk I), hpm.map _, ?_⟩
    rw [Polynomial.eval₂_map, ← hcomp, ← Polynomial.hom_eval₂, hp, map_zero]
  obtain ⟨ψ₁, hψ₁⟩ := branch (Ideal.span {u}) hnzu
  obtain ⟨ψ₂, hψ₂⟩ := branch (Ideal.span {v}) hnzv
  have hκ₁ := IsFractionRing.injective (B ⧸ Ideal.span {u}) (FractionRing (B ⧸ Ideal.span {u}))
  have hκ₂ := IsFractionRing.injective (B ⧸ Ideal.span {v}) (FractionRing (B ⧸ Ideal.span {v}))

  have joint : ∀ x : FractionRing B, ψ₁ x = 0 → ψ₂ x = 0 → x = 0 := by
    intro x h1 h2
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (nonZeroDivisors B) x
    simp only at hs
    have ha1 : Ideal.Quotient.mk (Ideal.span {u}) a = 0 := by
      apply hκ₁
      rw [← hψ₁, ← hs, map_mul, h1, zero_mul, map_zero]
    have ha2 : Ideal.Quotient.mk (Ideal.span {v}) a = 0 := by
      apply hκ₂
      rw [← hψ₂, ← hs, map_mul, h2, zero_mul, map_zero]
    have ha : a = 0 := hint a ((hmemu a).mp ha1) ((hmemv a).mp ha2)
    rw [ha, map_zero] at hs
    exact ((IsLocalization.map_units (FractionRing B) s).mul_left_eq_zero).mp hs

  set e : FractionRing B :=
    IsLocalization.mk' (FractionRing B) u (⟨u + v, hl⟩ : nonZeroDivisors B) with he_def
  have he_spec : e * algebraMap B (FractionRing B) (u + v) = algebraMap B (FractionRing B) u :=
    IsLocalization.mk'_spec (FractionRing B) u ⟨u + v, hl⟩
  have hlunit : IsUnit (algebraMap B (FractionRing B) (u + v)) :=
    IsLocalization.map_units (FractionRing B) (⟨u + v, hl⟩ : nonZeroDivisors B)
  have hee : e * e = e := by
    have h : (e * e) * algebraMap B (FractionRing B) (u + v) * algebraMap B (FractionRing B) (u + v)
        = e * algebraMap B (FractionRing B) (u + v) * algebraMap B (FractionRing B) (u + v) := by
      calc (e * e) * algebraMap B (FractionRing B) (u + v) * algebraMap B (FractionRing B) (u + v)
          = (e * algebraMap B (FractionRing B) (u + v)) *
              (e * algebraMap B (FractionRing B) (u + v)) := by ring
        _ = algebraMap B (FractionRing B) u * algebraMap B (FractionRing B) u := by rw [he_spec]
        _ = algebraMap B (FractionRing B) u * algebraMap B (FractionRing B) (u + v) := by
          rw [← map_mul, ← map_mul]
          congr 1
          linear_combination -huv
        _ = e * algebraMap B (FractionRing B) (u + v) * algebraMap B (FractionRing B) (u + v) := by
          rw [he_spec]
    exact (hlunit.mul_left_inj).mp ((hlunit.mul_left_inj).mp h)
  have heint : IsIntegral B e := by
    refine ⟨Polynomial.X * (Polynomial.X - Polynomial.C 1),
      Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1), ?_⟩
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C, map_one, mul_sub, hee, mul_one, sub_self]
  have hψ₁e : ψ₁ e = 0 := by
    have h : ψ₁ e * ψ₁ (algebraMap B (FractionRing B) (u + v)) = 0 := by
      rw [← map_mul, he_spec, hψ₁,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self u), map_zero]
    have hne : ψ₁ (algebraMap B (FractionRing B) (u + v)) ≠ 0 := by
      rw [hψ₁]
      intro h0
      exact hnzu _ hl (hκ₁ (h0.trans (map_zero _).symm))
    exact (mul_eq_zero.mp h).resolve_right hne
  have hψ₂e : ψ₂ e = 1 := by
    have hmk : Ideal.Quotient.mk (Ideal.span {v}) (u + v) = Ideal.Quotient.mk (Ideal.span {v}) u := by
      rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self v), add_zero]
    have h : ψ₂ e * ψ₂ (algebraMap B (FractionRing B) (u + v)) =
        1 * ψ₂ (algebraMap B (FractionRing B) (u + v)) := by
      rw [← map_mul, he_spec, one_mul, hψ₂, hψ₂, hmk]
    have hne : ψ₂ (algebraMap B (FractionRing B) (u + v)) ≠ 0 := by
      rw [hψ₂, hmk]
      intro h0
      exact hv (hκ₂ (h0.trans (map_zero _).symm))
    exact mul_right_cancel₀ hne h

  let χ : ↥(integralClosure B (FractionRing B)) →+*
      FractionRing (B ⧸ Ideal.span {u}) × FractionRing (B ⧸ Ideal.span {v}) :=
    (ψ₁.prod ψ₂).comp (integralClosure B (FractionRing B)).val.toRingHom
  have hχ : ∀ x, χ x = (ψ₁ (x : FractionRing B), ψ₂ (x : FractionRing B)) := fun x => rfl
  let j : (B ⧸ Ideal.span {u}) × (B ⧸ Ideal.span {v}) →+*
      FractionRing (B ⧸ Ideal.span {u}) × FractionRing (B ⧸ Ideal.span {v}) :=
    RingHom.prodMap (algebraMap (B ⧸ Ideal.span {u}) (FractionRing (B ⧸ Ideal.span {u})))
      (algebraMap (B ⧸ Ideal.span {v}) (FractionRing (B ⧸ Ideal.span {v})))
  have hj_apply : ∀ a b, j (a, b) =
      (algebraMap (B ⧸ Ideal.span {u}) (FractionRing (B ⧸ Ideal.span {u})) a,
        algebraMap (B ⧸ Ideal.span {v}) (FractionRing (B ⧸ Ideal.span {v})) b) := fun a b => rfl
  have hj : Function.Injective j := by
    rintro ⟨a, b⟩ ⟨c, d⟩ h
    rw [hj_apply, hj_apply, Prod.mk.injEq] at h
    rw [hκ₁ h.1, hκ₂ h.2]
  have hrange : ∀ x, χ x ∈ j.range := by
    intro x
    have hx : IsIntegral B (x : FractionRing B) := (mem_integralClosure_iff B _).mp x.2
    obtain ⟨d₁, hd₁⟩ := lands (Ideal.span {u}) ψ₁ hψ₁ x hx
    obtain ⟨d₂, hd₂⟩ := lands (Ideal.span {v}) ψ₂ hψ₂ x hx
    exact ⟨(d₁, d₂), by rw [hj_apply, hd₁, hd₂, hχ]⟩
  let eJ := RingEquiv.ofBijective j.rangeRestrict
    ⟨fun a b h => hj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective j⟩
  let Φ₀ : ↥(integralClosure B (FractionRing B)) →+* (B ⧸ Ideal.span {u}) × (B ⧸ Ideal.span {v}) :=
    eJ.symm.toRingHom.comp (χ.codRestrict j.range hrange)
  have hjΦ : ∀ x, j (Φ₀ x) = χ x := by
    intro x
    exact congrArg Subtype.val (eJ.apply_symm_apply ⟨χ x, hrange x⟩)
  have hΦinj : Function.Injective Φ₀ := by
    intro x y hxy
    have h := congrArg j hxy
    rw [hjΦ, hjΦ, hχ, hχ, Prod.mk.injEq] at h
    apply Subtype.ext
    rw [← sub_eq_zero]
    exact joint _ (by rw [map_sub, h.1, sub_self]) (by rw [map_sub, h.2, sub_self])
  have hΦsurj : Function.Surjective Φ₀ := by
    rintro ⟨d₁, d₂⟩
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective d₁
    obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (d₂ - Ideal.Quotient.mk (Ideal.span {v}) b)
    have hz : algebraMap B (FractionRing B) b + algebraMap B (FractionRing B) c * e ∈
        integralClosure B (FractionRing B) := by
      rw [mem_integralClosure_iff]
      exact isIntegral_algebraMap.add (isIntegral_algebraMap.mul heint)
    refine ⟨⟨_, hz⟩, hj ?_⟩
    rw [hjΦ, hχ, hj_apply]
    simp only [map_add, map_mul, hψ₁, hψ₂, hψ₁e, hψ₂e, hb, hc, mul_zero, add_zero, mul_one, map_sub]
    rw [add_sub_cancel]
  refine ⟨RingEquiv.ofBijective Φ₀ ⟨hΦinj, hΦsurj⟩, fun b => ?_⟩
  apply hj
  show j (Φ₀ _) = _
  rw [hjΦ, hχ, hj_apply]
  show (ψ₁ (algebraMap B (FractionRing B) b), ψ₂ (algebraMap B (FractionRing B) b)) = _
  rw [hψ₁, hψ₂]

theorem wcpa_dj_llsm_tg_node_delta_branches (B : Type u) [CommRing B] [IsLocalRing B] (u v : B)
    (hm : IsLocalRing.maximalIdeal B = Ideal.span {u, v})
    (φ : ↥(integralClosure B (FractionRing B)) ≃+* (B ⧸ Ideal.span {u}) × (B ⧸ Ideal.span {v}))
    (hφ : ∀ b, φ (algebraMap B _ b) = (Ideal.Quotient.mk _ b, Ideal.Quotient.mk _ b)) :
    wcpaDjLkDelta B = 1 ∧ wcpaDjLkBranches B = 2 :=
by
  have hu : Ideal.span {u} ≤ IsLocalRing.maximalIdeal B := by
    rw [hm]; exact Ideal.span_mono (by simp)
  have hv : Ideal.span {v} ≤ IsLocalRing.maximalIdeal B := by
    rw [hm]; exact Ideal.span_mono (by simp)
  have hmtop : IsLocalRing.maximalIdeal B ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal B).ne_top
  constructor
  ·
    let π₁ : B ⧸ Ideal.span {u} →+* B ⧸ IsLocalRing.maximalIdeal B := Ideal.Quotient.factor hu
    let π₂ : B ⧸ Ideal.span {v} →+* B ⧸ IsLocalRing.maximalIdeal B := Ideal.Quotient.factor hv
    have hπ₁ : ∀ b, π₁ (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ b := fun b =>
      Ideal.Quotient.factor_mk hu b
    have hπ₂ : ∀ b, π₂ (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ b := fun b =>
      Ideal.Quotient.factor_mk hv b
    let Ψ : ↥(integralClosure B (FractionRing B)) →ₗ[B] B ⧸ IsLocalRing.maximalIdeal B :=
      { toFun := fun x => π₂ (φ x).2 - π₁ (φ x).1
        map_add' := by
          intro x y
          simp only [map_add, Prod.fst_add, Prod.snd_add]
          abel
        map_smul' := by
          intro b x
          simp only [RingHom.id_apply, Algebra.smul_def, map_mul, hφ, Prod.fst_mul, Prod.snd_mul,
            hπ₁, hπ₂, Ideal.Quotient.algebraMap_eq]
          ring }
    have hΨ : ∀ x, Ψ x = π₂ (φ x).2 - π₁ (φ x).1 := fun x => rfl
    have hsurj : Function.Surjective Ψ := by
      intro z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
      refine ⟨φ.symm (0, Ideal.Quotient.mk _ b), ?_⟩
      rw [hΨ, RingEquiv.apply_symm_apply, hπ₂, map_zero, sub_zero]
    have hker : LinearMap.ker Ψ =
        LinearMap.range (Algebra.linearMap B ↥(integralClosure B (FractionRing B))) := by
      ext x
      constructor
      · intro hx
        rw [LinearMap.mem_ker, hΨ] at hx
        obtain ⟨b₁, hb₁⟩ := Ideal.Quotient.mk_surjective (φ x).1
        obtain ⟨b₂, hb₂⟩ := Ideal.Quotient.mk_surjective (φ x).2
        rw [← hb₁, ← hb₂, hπ₁, hπ₂, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, hm,
          Ideal.mem_span_pair] at hx
        obtain ⟨α, β, hαβ⟩ := hx
        refine ⟨b₁ + α * u, ?_⟩
        apply φ.injective
        rw [Algebra.linearMap_apply, hφ]
        refine Prod.ext ?_ ?_
        · show Ideal.Quotient.mk _ (b₁ + α * u) = (φ x).1
          rw [← hb₁, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
          have : b₁ + α * u - b₁ = α * u := by ring
          rw [this]
          exact Ideal.mul_mem_left _ α (Ideal.mem_span_singleton_self u)
        · show Ideal.Quotient.mk _ (b₁ + α * u) = (φ x).2
          rw [← hb₂, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
          have : b₁ + α * u - b₂ = (-β) * v := by linear_combination hαβ
          rw [this]
          exact Ideal.mul_mem_left _ (-β) (Ideal.mem_span_singleton_self v)
      · rintro ⟨b, rfl⟩
        rw [LinearMap.mem_ker, hΨ, Algebra.linearMap_apply, hφ, hπ₁, hπ₂, sub_self]
    let e := (Submodule.quotEquivOfEq _ _ hker.symm).trans (Ψ.quotKerEquivOfSurjective hsurj)
    unfold wcpaDjLkDelta
    rw [e.length_eq]
    have : IsSimpleModule B (B ⧸ IsLocalRing.maximalIdeal B) :=
      isSimpleModule_iff_isCoatom.mpr (Ideal.isMaximal_def.mp (IsLocalRing.maximalIdeal.isMaximal B))
    exact Module.length_eq_one _ _
  ·
    have : Nontrivial (B ⧸ Ideal.span {u}) :=
      Ideal.Quotient.nontrivial_iff.mpr (fun h => hmtop (top_le_iff.mp (h ▸ hu)))
    have : Nontrivial (B ⧸ Ideal.span {v}) :=
      Ideal.Quotient.nontrivial_iff.mpr (fun h => hmtop (top_le_iff.mp (h ▸ hv)))
    have : IsLocalRing (B ⧸ Ideal.span {u}) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    have : IsLocalRing (B ⧸ Ideal.span {v}) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    have hprod : ∀ (D₁ D₂ : Type u) [CommRing D₁] [CommRing D₂] [IsLocalRing D₁]
        [IsLocalRing D₂], ENat.card (MaximalSpectrum (D₁ × D₂)) = 2 := by
      intro D₁ D₂ _ _ _ _
      have h1 : ((IsLocalRing.maximalIdeal D₁).prod (⊤ : Ideal D₂)).IsMaximal := by
        have : (IsLocalRing.maximalIdeal D₁).prod (⊤ : Ideal D₂) =
            (IsLocalRing.maximalIdeal D₁).comap (RingHom.fst D₁ D₂) := by
          ext x; simp [Ideal.mem_prod]
        rw [this]
        exact Ideal.comap_isMaximal_of_surjective _ Prod.fst_surjective
      have h2 : ((⊤ : Ideal D₁).prod (IsLocalRing.maximalIdeal D₂)).IsMaximal := by
        have : (⊤ : Ideal D₁).prod (IsLocalRing.maximalIdeal D₂) =
            (IsLocalRing.maximalIdeal D₂).comap (RingHom.snd D₁ D₂) := by
          ext x; simp [Ideal.mem_prod]
        rw [this]
        exact Ideal.comap_isMaximal_of_surjective _ Prod.snd_surjective
      have hne : (IsLocalRing.maximalIdeal D₁).prod (⊤ : Ideal D₂) ≠
          (⊤ : Ideal D₁).prod (IsLocalRing.maximalIdeal D₂) := by
        intro h
        have h01 : ((0 : D₁), (1 : D₂)) ∈ (IsLocalRing.maximalIdeal D₁).prod (⊤ : Ideal D₂) := by
          simp [Ideal.mem_prod]
        rw [h] at h01
        simp [Ideal.mem_prod] at h01
      let f : Bool → MaximalSpectrum (D₁ × D₂) := fun b =>
        if b then ⟨_, h2⟩ else ⟨_, h1⟩
      have hf : Function.Bijective f := by
        constructor
        · intro a b hab
          cases a <;> cases b
          · rfl
          · exact absurd (congrArg MaximalSpectrum.asIdeal hab) hne
          · exact absurd (congrArg MaximalSpectrum.asIdeal hab).symm hne
          · rfl
        · intro M
          rcases (Ideal.ideal_prod_prime M.asIdeal).mp M.isMaximal.isPrime with
            ⟨p, hp, hM⟩ | ⟨p, hp, hM⟩
          · refine ⟨false, ?_⟩
            have hle : M.asIdeal ≤ (IsLocalRing.maximalIdeal D₁).prod (⊤ : Ideal D₂) := by
              rw [hM]
              intro x hx
              rw [Ideal.mem_prod] at hx ⊢
              exact ⟨IsLocalRing.le_maximalIdeal hp.ne_top hx.1, hx.2⟩
            exact MaximalSpectrum.ext (M.isMaximal.eq_of_le h1.ne_top hle).symm
          · refine ⟨true, ?_⟩
            have hle : M.asIdeal ≤ (⊤ : Ideal D₁).prod (IsLocalRing.maximalIdeal D₂) := by
              rw [hM]
              intro x hx
              rw [Ideal.mem_prod] at hx ⊢
              exact ⟨hx.1, IsLocalRing.le_maximalIdeal hp.ne_top hx.2⟩
            exact MaximalSpectrum.ext (M.isMaximal.eq_of_le h2.ne_top hle).symm
      rw [← ENat.card_congr (Equiv.ofBijective f hf)]
      simp
    let e : MaximalSpectrum ↥(integralClosure B (FractionRing B)) ≃
        MaximalSpectrum ((B ⧸ Ideal.span {u}) × (B ⧸ Ideal.span {v})) :=
      { toFun := fun M => ⟨M.asIdeal.comap φ.symm,
          by have := M.isMaximal; exact Ideal.comap_isMaximal_of_equiv φ.symm⟩
        invFun := fun N => ⟨N.asIdeal.comap φ,
          by have := N.isMaximal; exact Ideal.comap_isMaximal_of_equiv φ⟩
        left_inv := by
          intro M
          apply MaximalSpectrum.ext
          ext x
          change x ∈ (M.asIdeal.comap φ.symm).comap φ ↔ x ∈ M.asIdeal
          rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.symm_apply_apply]
        right_inv := by
          intro N
          apply MaximalSpectrum.ext
          ext x
          change x ∈ (N.asIdeal.comap φ).comap φ.symm ↔ x ∈ N.asIdeal
          rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.apply_symm_apply] }
    unfold wcpaDjLkBranches
    rw [ENat.card_congr e]
    exact hprod _ _

theorem wcpa_dj_llsm_trivial_group : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    wcLlsLocThm W (· ≤ 1) :=
by
  intro Ω _ _ W _ _
  intro A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k y hPD hSolv hUniq hcard
  classical
  obtain ⟨hy, hyc, -, hδ⟩ := hSolv

  have hKL : Function.Bijective (algebraMap K L) := by
    have hmap : ∀ g : L ≃ₐ[K] L, ∀ x : integralClosure A L, g x ∈ integralClosure A L := by
      intro g x
      exact ((show IsIntegral A (x : L) from x.2).map ((g : L →ₐ[K] L).restrictScalars A))
    let σ : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun g =>
      { toFun := fun x => ⟨g x, hmap g x⟩
        map_one' := Subtype.ext (map_one g)
        map_mul' := fun a b => Subtype.ext (map_mul g _ _)
        map_zero' := Subtype.ext (map_zero g)
        map_add' := fun a b => Subtype.ext (map_add g _ _) }
    have hfix : ∀ g : L ≃ₐ[K] L, (σ g).comp (algebraMap A (integralClosure A L)) =
        algebraMap A (integralClosure A L) := by
      intro g
      refine RingHom.ext fun a => Subtype.ext ?_
      show g (algebraMap A L a) = algebraMap A L a
      rw [IsScalarTower.algebraMap_apply A K L, AlgEquiv.commutes]
    have htop : wcLlsDec A K L y = ⊤ := by
      rw [eq_top_iff]
      intro g _
      have hy' : y.comap (σ g.symm) = y := by
        haveI := hy
        refine hUniq _ inferInstance ?_
        rw [Ideal.comap_comap, hfix]
        exact hyc
      unfold wcLlsDec
      open Pointwise in rw [MulAction.mem_stabilizer_iff]
      open Pointwise in ext z
      open Pointwise in rw [Set.mem_smul_set]
      constructor
      · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
        refine ⟨σ g x, ?_, rfl⟩
        have e : σ g.symm (σ g x) = x := Subtype.ext (g.symm_apply_apply _)
        have h2 : σ g.symm (σ g x) ∈ y := by rw [e]; exact hx
        show σ g x ∈ y
        rw [← hy']
        exact h2
      · rintro ⟨x, hx, rfl⟩
        refine ⟨↑(σ g.symm x), ⟨σ g.symm x, ?_, rfl⟩, ?_⟩
        · rw [← hy'] at hx; exact hx
        · show g (g.symm (x : L)) = (x : L)
          exact g.apply_symm_apply _
    have hc := hcard
    rw [htop, Subgroup.card_top, IsGalois.card_aut_eq_finrank] at hc
    have h1 : Module.finrank K L = 1 := le_antisymm hc Module.finrank_pos
    have hbt := Subalgebra.bot_eq_top_of_finrank_eq_one h1
    refine ⟨(algebraMap K L).injective, fun x => ?_⟩
    have hx : x ∈ (⊥ : Subalgebra K L) := hbt ▸ Algebra.mem_top
    obtain ⟨c, hc⟩ := Algebra.mem_bot.mp hx
    exact ⟨c, hc⟩

  have s2 : ∀ [IsIntegrallyClosed A] (R : Type u) [CommRing R] [Algebra R L] (j : A →+* R),
      Function.Surjective j → (algebraMap R L).comp j = algebraMap A L →
      ∃ β : A →+* integralClosure R L, Function.Bijective β ∧
        ∀ a, (β a : L) = algebraMap A L a := by
    intro _ R _ _ j hj hc
    haveI : Nontrivial R := (algebraMap R L).domain_nontrivial
    refine ⟨(algebraMap R (integralClosure R L)).comp j, ⟨?_, ?_⟩, fun a => ?_⟩
    · intro a b hab
      have h := congrArg Subtype.val hab
      have h' : algebraMap A L a = algebraMap A L b := by
        rw [← hc]; exact h
      rw [IsScalarTower.algebraMap_apply A K L, IsScalarTower.algebraMap_apply A K L] at h'
      exact IsFractionRing.injective A K (hKL.1 h')
    · rintro ⟨x, hx⟩
      obtain ⟨p, hpm, hp⟩ := (show IsIntegral R x from hx)
      obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic
        ((Polynomial.mem_lifts p).mpr (Polynomial.map_surjective j hj p)) hpm
      have hxA : IsIntegral A x :=
        ⟨q, hqm, by rw [← hc, ← Polynomial.eval₂_map, hqmap]; exact hp⟩
      obtain ⟨c, rfl⟩ := hKL.2 x
      have hcA : IsIntegral A c :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K L) (algebraMap K L).injective).mp hxA
      obtain ⟨a, rfl⟩ := IsIntegrallyClosed.isIntegral_iff.mp hcA
      refine ⟨a, Subtype.ext ?_⟩
      show algebraMap R L (j a) = algebraMap K L (algebraMap A K a)
      rw [← RingHom.comp_apply, hc, IsScalarTower.algebraMap_apply A K L]
    · show algebraMap R L (j a) = algebraMap A L a
      rw [← RingHom.comp_apply, hc]

  have s3 : ∀ (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
      (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] (β : A →+* ↥(integralClosure R L)),
      Function.Bijective β → (∀ w, (β (algebraMap ↥W A w) : L) = wL w) →
      ∀ [𝔭.IsPrime], 𝔮.comap β = 𝔭 →
      Nonempty (wcLlsFS W wL R 𝔮 ≃+* (Localization.AtPrime 𝔭 ⧸
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
          (algebraMap A (Localization.AtPrime 𝔭)))) := by
    intro wL R _ _ 𝔮 _ β hβ hw _ h𝔭
    let e : A ≃+* ↥(integralClosure R L) := RingEquiv.ofBijective β hβ
    have hM : Submonoid.map e.toMonoidHom 𝔭.primeCompl = 𝔮.primeCompl := by
      ext z
      simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
      constructor
      · rintro ⟨a, ha, rfl⟩ hz
        apply ha
        rw [← h𝔭]
        exact hz
      · intro hz
        refine ⟨e.symm z, ?_, e.apply_symm_apply z⟩
        intro hz'
        apply hz
        rw [← h𝔭] at hz'
        have : β (e.symm z) = z := e.apply_symm_apply z
        rw [Ideal.mem_comap, this] at hz'
        exact hz'
    let ℓ := IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔭)
      (Localization.AtPrime 𝔮) e hM
    have hℓ : (ℓ : Localization.AtPrime 𝔭 →+* Localization.AtPrime 𝔮).comp
        (algebraMap A (Localization.AtPrime 𝔭)) =
        (algebraMap _ (Localization.AtPrime 𝔮)).comp β :=
      RingHom.ext fun a => IsLocalization.ringEquivOfRingEquiv_eq hM a
    have hspan : Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w} =
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map β := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro b ⟨w, hw', hb⟩
        have : b = β (algebraMap ↥W A w) := Subtype.ext (by rw [hw, hb])
        rw [this]
        exact Ideal.mem_map_of_mem β (Ideal.mem_map_of_mem _ hw')
      · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
        intro w hw'
        exact Ideal.subset_span ⟨w, hw', hw w⟩
    have hJ : (Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
        (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)) =
        Ideal.map (ℓ : Localization.AtPrime 𝔭 →+* Localization.AtPrime 𝔮)
          (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A)).map
            (algebraMap A (Localization.AtPrime 𝔭))) := by
      rw [hspan, Ideal.map_map β, Ideal.map_map (algebraMap A (Localization.AtPrime 𝔭)), hℓ]
    exact ⟨(Ideal.quotientEquiv _ _ ℓ hJ).symm⟩

  have s11 : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      wcpaDjLkDelta B = 0 := by
    intro B _ _ _
    unfold wcpaDjLkDelta
    rw [Module.length_eq_zero_iff]
    have htop : LinearMap.range
        (Algebra.linearMap B ↥(integralClosure B (FractionRing B))) = ⊤ := by
      rw [eq_top_iff]
      rintro ⟨x, hx⟩ -
      obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.mp (show IsIntegral B x from hx)
      exact LinearMap.mem_range.mpr ⟨b, Subtype.ext hb⟩
    constructor
    intro a b
    induction a using Submodule.Quotient.induction_on with
    | _ a =>
    induction b using Submodule.Quotient.induction_on with
    | _ b =>
    rw [Submodule.Quotient.eq, htop]
    exact Submodule.mem_top
  cases k with
  | disc t =>
    obtain ⟨-, -, hic, hmax, hm𝔭, ht, h𝔭eq, h, hh, f₀, hfC, hfX, hfet⟩ := hPD
    haveI : 𝔭.IsPrime := hmax.isPrime
    exfalso
    apply hδ hy t rfl
    obtain ⟨β, hβ, hβv⟩ := s2 A (RingHom.id A) Function.surjective_id (RingHom.comp_id _)
    have hβe : β = algebraMap A (integralClosure A L) :=
      RingHom.ext fun a => Subtype.ext (hβv a)
    haveI := hy
    obtain ⟨eFS⟩ := s3 ((algebraMap A L).comp (algebraMap ↥W A)) A y β hβ
      (fun w => hβv _) (by rw [hβe]; exact hyc)
    let π : Polynomial ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W) :=
      Polynomial.mapRingHom (IsLocalRing.residue ↥W)
    have hπX : π Polynomial.X = Polynomial.X := Polynomial.map_X _
    obtain ⟨E, _, fb, ρ, q, hq, hfbet, -, hρker, hfbπ, hqeq, ⟨eB⟩⟩ :=
      wcpa_dj_llsm_tg_chart_basechange W A 𝔭 h (Polynomial ↥W) f₀
        (Polynomial (IsLocalRing.ResidueField ↥W)) π hm𝔭 hh
        (by rw [Polynomial.algebraMap_eq]; exact hfC) hfet
        (Polynomial.map_surjective _ IsLocalRing.residue_surjective)
        (by rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, Polynomial.algebraMap_eq])
    have hqX : q = Ideal.span {fb Polynomial.X} := by
      rw [hqeq, h𝔭eq, Ideal.map_sup, Ideal.map_sup,
        (Ideal.map_eq_bot_iff_le_ker ρ).mpr (le_of_eq hρker.symm), sup_bot_eq,
        Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton, ← hfX,
        ← hfbπ, hπX]
    haveI := hq
    obtain ⟨_, _⟩ := wcpa_dj_llsm_tg_etale_line_dvr (IsLocalRing.ResidueField ↥W) E fb q
      hfbet hqX
    rw [(wcpa_dj_lr1k_llfi_ringequiv _ _ eFS).1, (wcpa_dj_lr1k_llfi_ringequiv _ _ eB).1]
    exact s11 _
  | ann u v g =>
    obtain ⟨-, hnz, hic, hmax, hm𝔭, hg, hg0, huv, h𝔭eq, h, hh, f₀, hfC, hfu, hfv, hfet⟩ := hPD
    haveI : 𝔭.IsPrime := hmax.isPrime
    refine ⟨g, hg, hg0, dvd_refl g, ?_, fun b' _ _ hb' _ _ => hb'⟩
    show wcLlsSepAt W A K L u
      (algebraMap A K (algebraMap ↥W A g) / algebraMap A K u)
    set s : K := algebraMap A K (algebraMap ↥W A g) / algebraMap A K u with hs_def
    intro 𝔮 _ h𝔮
    have hag : algebraMap ↥W A g ≠ 0 := by
      rw [Algebra.algebraMap_eq_smul_one]
      exact smul_ne_zero hg0 one_ne_zero
    have hιinj := IsFractionRing.injective A K
    have hιu : algebraMap A K u ≠ 0 := by
      intro h0
      apply hag
      apply hιinj
      rw [← huv, map_mul, h0, zero_mul, map_zero]
    have hs : s = algebraMap A K v := by
      rw [hs_def, ← huv, map_mul, mul_div_cancel_left₀ _ hιu]
    have hsbot : Algebra.adjoin A {s} ≤ ⊥ :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr (Algebra.mem_bot.mpr ⟨v, hs.symm⟩))
    have hjs : Function.Surjective (algebraMap A ↥(Algebra.adjoin A {s})) := by
      intro x
      obtain ⟨a, ha⟩ := Algebra.mem_bot.mp (hsbot x.2)
      exact ⟨a, Subtype.ext ha⟩
    have hji : Function.Injective (algebraMap A ↥(Algebra.adjoin A {s})) := by
      intro a b hab
      exact hιinj (congrArg Subtype.val hab)
    have hjc : (algebraMap ↥(Algebra.adjoin A {s}) L).comp
        (algebraMap A ↥(Algebra.adjoin A {s})) = algebraMap A L :=
      RingHom.ext fun a => (IsScalarTower.algebraMap_apply A K L a).symm
    obtain ⟨β, hβ, hβv⟩ := s2 _ _ hjs hjc
    have hβe : β = (algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
        (algebraMap A ↥(Algebra.adjoin A {s})) :=
      RingHom.ext fun a => Subtype.ext ((hβv a).trans (congrArg (· a) hjc).symm)
    have hsv : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) =
        algebraMap A ↥(Algebra.adjoin A {s}) v := Subtype.ext hs
    have hcomap : 𝔮.comap β = 𝔭 := by
      rw [hβe, ← Ideal.comap_comap, h𝔮, hsv]
      conv_rhs => rw [← Ideal.comap_map_of_bijective _ ⟨hji, hjs⟩ (I := 𝔭)]
      rw [h𝔭eq, Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map]
    obtain ⟨eFS⟩ := s3 ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) _ 𝔮 β
      hβ (fun w => by rw [hβv]; exact IsScalarTower.algebraMap_apply A K L _) hcomap

    set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} with hI
    set Z0 : Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} with hZ0
    let F : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ Z0 :=
      (Ideal.Quotient.mk Z0).comp (MvPolynomial.map (IsLocalRing.residue ↥W))
    have hresg : IsLocalRing.residue ↥W g = 0 := (IsLocalRing.residue_eq_zero_iff g).mpr hg
    have hFI : ∀ a ∈ I, F a = 0 := by
      have hle : I ≤ RingHom.ker F := by
        rw [hI, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        show Ideal.Quotient.mk Z0 (MvPolynomial.map (IsLocalRing.residue ↥W)
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g)) = 0
        rw [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, MvPolynomial.map_C, hresg,
          map_zero, sub_zero, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span rfl
      exact fun a ha => hle ha
    let π := Ideal.Quotient.lift I F hFI
    have hπmk : ∀ p, π (Ideal.Quotient.mk I p) = F p := fun p => Ideal.Quotient.lift_mk I F hFI
    have hπX : ∀ i : Fin 2, π (Ideal.Quotient.mk I (MvPolynomial.X i)) =
        Ideal.Quotient.mk Z0 (MvPolynomial.X i) := by
      intro i
      rw [hπmk]
      show Ideal.Quotient.mk Z0 (MvPolynomial.map _ (MvPolynomial.X i)) = _
      rw [MvPolynomial.map_X]
    have hπs : Function.Surjective π := by
      intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨p', rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective p
      exact ⟨Ideal.Quotient.mk I p', hπmk p'⟩
    have halg : algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I) =
        (Ideal.Quotient.mk I).comp MvPolynomial.C := by
      rw [IsScalarTower.algebraMap_eq ↥W (MvPolynomial (Fin 2) ↥W), Ideal.Quotient.algebraMap_eq,
        MvPolynomial.algebraMap_eq]
    have hπker : RingHom.ker π =
        (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I)) := by
      have h1 : RingHom.ker F = I ⊔ (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C := by
        have hZ0' : Z0 = Ideal.map (MvPolynomial.map (IsLocalRing.residue ↥W))
            (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) := by
          rw [hZ0, Ideal.map_span, Set.image_singleton, map_mul, MvPolynomial.map_X,
            MvPolynomial.map_X]
        have e1 : RingHom.ker F = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
            (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C := by
          show RingHom.ker ((Ideal.Quotient.mk Z0).comp _) = _
          rw [← RingHom.comap_ker, Ideal.mk_ker, hZ0', Ideal.comap_map_of_surjective _
            (MvPolynomial.map_surjective _ IsLocalRing.residue_surjective), ← RingHom.ker_eq_comap_bot,
            MvPolynomial.ker_map, IsLocalRing.ker_residue]
        rw [e1]
        have hCg : MvPolynomial.C g ∈ (IsLocalRing.maximalIdeal ↥W).map
            (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W) := Ideal.mem_map_of_mem _ hg
        apply le_antisymm
        · refine sup_le ?_ le_sup_right
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
          have : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W) =
              (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) + MvPolynomial.C g := by ring
          rw [this]
          exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span rfl))
            (Ideal.mem_sup_right hCg)
        · refine sup_le ?_ le_sup_right
          rw [hI, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
          exact Ideal.sub_mem _ (Ideal.mem_sup_left (Ideal.subset_span rfl))
            (Ideal.mem_sup_right hCg)
      have h2 : RingHom.ker (π.comp (Ideal.Quotient.mk I)) = RingHom.ker F := by
        rw [show π.comp (Ideal.Quotient.mk I) = F from RingHom.ext hπmk]
      rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
        (RingHom.ker π), RingHom.comap_ker, h2, h1, Ideal.map_sup,
        (Ideal.map_eq_bot_iff_le_ker _).mpr (le_of_eq (Ideal.mk_ker).symm), bot_sup_eq,
        Ideal.map_map, halg]
    obtain ⟨E, _, fb, ρ, q, hq, hfbet, -, hρker, hfbπ, hqeq, ⟨eB⟩⟩ :=
      wcpa_dj_llsm_tg_chart_basechange W A 𝔭 h (MvPolynomial (Fin 2) ↥W ⧸ I) f₀
        (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ Z0) π hm𝔭 hh
        (by rw [halg]; exact hfC) hfet hπs hπker
    have hfbX : ∀ i : Fin 2, fb (Ideal.Quotient.mk Z0 (MvPolynomial.X i)) =
        ρ (f₀ (Ideal.Quotient.mk I (MvPolynomial.X i))) := by
      intro i
      rw [← hπX, hfbπ]
    have hqX : q = Ideal.span {fb (Ideal.Quotient.mk Z0 (MvPolynomial.X 0)),
        fb (Ideal.Quotient.mk Z0 (MvPolynomial.X 1))} := by
      rw [hfbX, hfbX, hfu, hfv, hqeq, h𝔭eq, Ideal.map_sup, Ideal.map_sup,
        (Ideal.map_eq_bot_iff_le_ker ρ).mpr (le_of_eq hρker.symm), sup_bot_eq,
        Ideal.map_span, Ideal.map_span, Set.image_pair, Set.image_pair]
    haveI := hq
    obtain ⟨huv0, hmB, ⟨hD1, hIC1⟩, ⟨hD2, hIC2⟩, hne1, hne2⟩ :=
      wcpa_dj_llsm_tg_etale_node_quotients (IsLocalRing.ResidueField ↥W) E fb q hfbet hqX
    obtain ⟨φ, hφ⟩ := wcpa_dj_llsm_tg_node_closure_prod _ _ _ huv0 hne1 hne2
    obtain ⟨hδ1, hbr⟩ := wcpa_dj_llsm_tg_node_delta_branches _ _ _ hmB φ hφ
    intro hbad
    apply hbad
    right
    rw [(wcpa_dj_lr1k_llfi_ringequiv _ _ eFS).1, (wcpa_dj_lr1k_llfi_ringequiv _ _ eB).1,
      (wcpa_dj_lr1k_llfi_ringequiv _ _ eFS).2, (wcpa_dj_lr1k_llfi_ringequiv _ _ eB).2]
    exact ⟨hδ1, hbr⟩

theorem wcpa_dj_llsm_br_dec_top_iff : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u)
    [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [FiniteDimensional K L] [IsGalois K L], IsIntegrallyClosed A →
    ∀ (𝔭 : Ideal A) (y : Ideal ↥(integralClosure A L)), y.IsPrime →
    y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 →
    (wcLlsDec A K L y = ⊤ ↔ wcLlsUniq A L 𝔭 y) :=
by
  intro A _ _ K _ _ _ L _ _ _ _ _ _ hIC 𝔭 y hy hyc
  classical
  haveI : Algebra.IsAlgebraic A K := IsLocalization.isAlgebraic K (nonZeroDivisors A)
  haveI : Algebra.IsAlgebraic A L := Algebra.IsAlgebraic.trans A K L
  have hinj : ∀ x : A, algebraMap A L x = 0 → x = 0 := by
    intro x hx
    rw [IsScalarTower.algebraMap_apply A K L] at hx
    have h1 := (algebraMap K L).injective (hx.trans (map_zero _).symm)
    exact IsFractionRing.injective A K (h1.trans (map_zero _).symm)
  haveI : IsFractionRing (integralClosure A L) L :=
    integralClosure.isFractionRing_of_algebraic hinj

  have key : ∀ σ : L ≃ₐ[K] L,
      ((↑) : integralClosure A L → L) ''
        ((y.comap (galRestrict A K L (integralClosure A L) σ).symm : Ideal _) : Set _) =
      (fun x => σ x) '' (((↑) : integralClosure A L → L) '' (y : Set _)) := by
    intro σ
    have hval : ∀ b : integralClosure A L,
        ((galRestrict A K L (integralClosure A L) σ b : integralClosure A L) : L) = σ (b : L) :=
      fun b => algebraMap_galRestrict_apply A σ b
    ext x
    simp only [Set.mem_image, SetLike.mem_coe, Ideal.mem_comap]
    constructor
    · rintro ⟨b, hb, rfl⟩
      refine ⟨_, ⟨_, hb, rfl⟩, ?_⟩
      rw [← hval, AlgEquiv.apply_symm_apply]
    · rintro ⟨_, ⟨b, hb, rfl⟩, rfl⟩
      refine ⟨galRestrict A K L (integralClosure A L) σ b, ?_, hval b⟩
      rwa [AlgEquiv.symm_apply_apply]
  have hcomap : ∀ σ : L ≃ₐ[K] L,
      (y.comap (galRestrict A K L (integralClosure A L) σ).symm).comap
        (algebraMap A (integralClosure A L)) = y.comap (algebraMap A (integralClosure A L)) := by
    intro σ
    ext a
    simp only [Ideal.mem_comap, AlgEquiv.commutes]
  have hstab : ∀ σ : L ≃ₐ[K] L, σ ∈ wcLlsDec A K L y ↔
      (fun x => σ x) '' (((↑) : integralClosure A L → L) '' (y : Set _)) =
        ((↑) : integralClosure A L → L) '' (y : Set _) := by
    intro σ
    unfold wcLlsDec
    open Pointwise in
    exact (MulAction.mem_stabilizer_iff).trans (by rw [← Set.image_smul]; exact Iff.rfl)
  constructor
  · intro hTop y' hy' hy'c
    haveI : y'.IsPrime := hy'
    haveI : Finite (integralClosure A L ≃ₐ[A] integralClosure A L) :=
      Finite.of_equiv _ (galRestrict A K L (integralClosure A L)).toEquiv
    haveI : Algebra.IsInvariant A (integralClosure A L)
        (integralClosure A L ≃ₐ[A] integralClosure A L) :=
      Algebra.isInvariant_of_isGalois' A K L (integralClosure A L)
    haveI : SMulCommClass (integralClosure A L ≃ₐ[A] integralClosure A L) A
        (integralClosure A L) := SMulCommClass.symm _ _ _
    obtain ⟨h, hh⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A (integralClosure A L)
      (integralClosure A L ≃ₐ[A] integralClosure A L) y y'
      (by rw [Ideal.under_def, Ideal.under_def, hyc, hy'c])
    set σ := (galRestrict A K L (integralClosure A L)).symm h with hσ
    have hgσ : galRestrict A K L (integralClosure A L) σ = h := by
      rw [hσ, MulEquiv.apply_symm_apply]
    have hy'eq : y' = y.comap (galRestrict A K L (integralClosure A L) σ).symm := by
      rw [hh, hgσ, Ideal.pointwise_smul_eq_comap]
      rfl
    have h1 := key σ
    rw [← hy'eq, (hstab σ).mp (hTop ▸ Subgroup.mem_top σ)] at h1
    exact SetLike.coe_injective ((Set.image_injective.mpr Subtype.val_injective) h1)
  · intro hU
    rw [Subgroup.eq_top_iff']
    intro σ
    rw [hstab σ, ← key σ]
    rw [hU _ (Ideal.comap_isPrime _ _) ((hcomap σ).trans hyc)]

theorem wcpa_dj_llsm_br_centres : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A) (z : A),
    wcLlsPD W A 𝔭 k → ((∃ t, k = .disc t ∧ z = t) ∨ (∃ v g, k = .ann z v g)) →
    (∀ Q, wcLlsGenPt W A L 𝔭 Q → wcLlsRam A K L Q → ∃ c : ↥W,
        c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L))) ∧
    (wcLlsBrSet W A K L 𝔭 z).Finite ∧
    ∀ v g, k = .ann z v g → ∀ c ∈ wcLlsBrSet W A K L 𝔭 z,
      c ≠ 0 ∧ ∃ q : ↥W, q ∈ IsLocalRing.maximalIdeal ↥W ∧ g = c * q :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k z hPD hkind
  classical


  have trailing : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsDomain S] (φ : R →+* S) (a : S)
      (F : Polynomial R), a ≠ 0 → F ≠ 0 → F.eval₂ φ a = 0 →
      ∃ r : R, r ≠ 0 ∧ φ r ∈ Ideal.span {a} := by
    intro R S _ _ _ φ a F ha hF h
    set j := F.natTrailingDegree with hj
    obtain ⟨G, hG⟩ : (Polynomial.X : Polynomial R) ^ j ∣ F :=
      Polynomial.X_pow_dvd_iff.mpr
        (fun d hd => Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hd)
    have hc : F.trailingCoeff = G.coeff 0 := by
      rw [Polynomial.trailingCoeff, ← hj, hG, Polynomial.coeff_X_pow_mul', if_pos le_rfl,
        Nat.sub_self]
    refine ⟨F.trailingCoeff, mt Polynomial.trailingCoeff_eq_zero.mp hF, ?_⟩
    have hG0 : G.eval₂ φ a = 0 := by
      rw [hG, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at h
      exact (mul_eq_zero.mp h).resolve_left (pow_ne_zero _ ha)
    have hdec := congrArg (Polynomial.eval₂ φ a) (Polynomial.X_mul_divX_add G)
    rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C,
      hG0] at hdec
    rw [hc, Ideal.mem_span_singleton']
    exact ⟨-(G.divX.eval₂ φ a), by linear_combination -hdec⟩


  have etaleAlg : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsDomain S]
      (f : R →+* S), f.Etale → ∀ s : S, ∃ F : Polynomial R, F.map f ≠ 0 ∧ F.eval₂ f s = 0 := by
    intro R S _ _ _ f hf s
    letI := f.toAlgebra
    haveI : Algebra.Etale R S := hf
    haveI hJp : (RingHom.ker f).IsPrime := RingHom.ker_isPrime f
    let Rb := R ⧸ RingHom.ker f
    let fb : Rb →+* S := RingHom.kerLift f
    have hfb : Function.Injective fb := RingHom.kerLift_injective f
    have hfbmk : ∀ r : R, fb (Ideal.Quotient.mk _ r) = f r := fun r => RingHom.kerLift_mk f r
    letI : Algebra Rb S := fb.toAlgebra
    haveI : IsScalarTower R Rb S := IsScalarTower.of_algebraMap_eq (fun r => (hfbmk r).symm)
    haveI : Algebra.FormallyUnramified Rb S :=
      Algebra.FormallyUnramified.of_restrictScalars R Rb S
    haveI : Algebra.EssFiniteType Rb S := Algebra.EssFiniteType.of_comp R Rb S
    let M := Algebra.algebraMapSubmonoid S (nonZeroDivisors Rb)
    have hM : M ≤ nonZeroDivisors S := by
      rintro _ ⟨r, hr, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      exact nonZeroDivisors.ne_zero hr (hfb (by rw [map_zero]; exact h0))
    letI : Algebra (FractionRing Rb) (Localization M) :=
      localizationAlgebra (nonZeroDivisors Rb) S
    haveI : IsScalarTower Rb (FractionRing Rb) (Localization M) := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq Rb S (Localization M)]
      exact (IsLocalization.map_comp _).symm
    haveI : Algebra.FormallyUnramified S (Localization M) :=
      Algebra.FormallyUnramified.of_isLocalization M
    haveI : Algebra.FormallyUnramified Rb (Localization M) :=
      Algebra.FormallyUnramified.comp Rb S (Localization M)
    haveI : Algebra.FormallyUnramified (FractionRing Rb) (Localization M) :=
      Algebra.FormallyUnramified.localization_base (nonZeroDivisors Rb)
    haveI : Algebra.EssFiniteType S (Localization M) :=
      Algebra.EssFiniteType.of_isLocalization (Localization M) M
    haveI : Algebra.EssFiniteType Rb (Localization M) :=
      Algebra.EssFiniteType.comp Rb S (Localization M)
    haveI : Algebra.EssFiniteType (FractionRing Rb) (Localization M) :=
      Algebra.EssFiniteType.of_comp Rb (FractionRing Rb) (Localization M)
    haveI : Module.Finite (FractionRing Rb) (Localization M) :=
      Algebra.FormallyUnramified.finite_of_free _ _
    have hint : IsIntegral (FractionRing Rb) (algebraMap S (Localization M) s) :=
      Algebra.IsIntegral.isIntegral _
    obtain ⟨p, hpm, hp⟩ := hint
    set Fb := IsLocalization.integerNormalization (nonZeroDivisors Rb) p with hFb
    have hFb0 : Fb ≠ 0 := by
      rw [Ne, hFb, IsLocalization.integerNormalization_eq_zero_iff le_rfl]
      exact hpm.ne_zero
    have hFbs : Fb.eval₂ fb s = 0 := by
      have h := IsLocalization.integerNormalization_aeval_eq_zero (nonZeroDivisors Rb) p
        (x := algebraMap S (Localization M) s) (by rwa [Polynomial.aeval_def])
      rw [Polynomial.aeval_algebraMap_apply] at h
      have hinjS : Function.Injective (algebraMap S (Localization M)) :=
        IsLocalization.injective (Localization M) hM
      have h2 : Polynomial.aeval s Fb = 0 := hinjS (by rw [h, map_zero])
      rw [Polynomial.aeval_def] at h2
      exact h2
    obtain ⟨F, hF⟩ := Polynomial.map_surjective (Ideal.Quotient.mk (RingHom.ker f))
      Ideal.Quotient.mk_surjective Fb
    have hcomp : fb.comp (Ideal.Quotient.mk (RingHom.ker f)) = f := RingHom.ext hfbmk
    refine ⟨F, ?_, ?_⟩
    · rw [← hcomp, ← Polynomial.map_map, hF]
      exact (Polynomial.map_ne_zero_iff hfb).mpr hFb0
    · rw [← hcomp, ← Polynomial.eval₂_map, hF]
      exact hFbs


  have nodal : ∀ (g : ↥W) (I : Ideal (MvPolynomial (Fin 2) ↥W)),
      I = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} →
      ∀ F : Polynomial (MvPolynomial (Fin 2) ↥W ⧸ I),
      ∃ (N : ℕ) (F' : Polynomial (Polynomial ↥W)),
        F'.map (Polynomial.eval₂RingHom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
          (Ideal.Quotient.mk I (MvPolynomial.X 0))) =
          Polynomial.C (Ideal.Quotient.mk I (MvPolynomial.X 0) ^ N) * F := by
    intro g I hI F
    set ψ := Polynomial.eval₂RingHom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
      (Ideal.Quotient.mk I (MvPolynomial.X 0)) with hψ
    set U := Ideal.Quotient.mk I (MvPolynomial.X 0) with hU
    have hUV : U * Ideal.Quotient.mk I (MvPolynomial.X 1) = ψ (Polynomial.C g) := by
      rw [hψ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.comp_apply, hU, ← map_mul]
      rw [Ideal.Quotient.eq, hI]
      exact Ideal.subset_span rfl
    have hmono : ∀ r : MvPolynomial (Fin 2) ↥W ⧸ I,
        ∃ (N : ℕ) (q : Polynomial ↥W), U ^ N * r = ψ q := by
      intro r
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
      induction p using MvPolynomial.induction_on with
      | C a => exact ⟨0, Polynomial.C a, by simp [hψ]⟩
      | add p p' hp hp' =>
        obtain ⟨N, q, hq⟩ := hp
        obtain ⟨N', q', hq'⟩ := hp'
        refine ⟨N + N', Polynomial.X ^ N' * q + Polynomial.X ^ N * q', ?_⟩
        rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow, ← hq, ← hq']
        have hX : ψ Polynomial.X = U := by simp [hψ, hU]
        rw [hX]
        ring
      | mul_X p i hp =>
        obtain ⟨N, q, hq⟩ := hp
        have hX : ψ Polynomial.X = U := by simp [hψ, hU]
        fin_cases i
        · refine ⟨N, q * Polynomial.X, ?_⟩
          rw [map_mul, map_mul, ← hq, hX]
          show U ^ N * (Ideal.Quotient.mk I p * U) = U ^ N * Ideal.Quotient.mk I p * U
          ring
        · refine ⟨N + 1, q * Polynomial.C g, ?_⟩
          rw [map_mul, map_mul, ← hq, ← hUV]
          show U ^ (N + 1) * (Ideal.Quotient.mk I p * Ideal.Quotient.mk I (MvPolynomial.X 1)) =
            U ^ N * Ideal.Quotient.mk I p * (U * Ideal.Quotient.mk I (MvPolynomial.X 1))
          ring
    have key : ∀ G : Polynomial (MvPolynomial (Fin 2) ↥W ⧸ I),
        ∃ (N : ℕ) (G' : Polynomial (Polynomial ↥W)), G'.map ψ = Polynomial.C (U ^ N) * G := by
      intro G
      induction G using Polynomial.induction_on' with
      | add p q hp hq =>
        obtain ⟨N, p', hp'⟩ := hp
        obtain ⟨M, q', hq'⟩ := hq
        refine ⟨N + M,
          Polynomial.C (Polynomial.X ^ M) * p' + Polynomial.C (Polynomial.X ^ N) * q', ?_⟩
        have hX : ψ Polynomial.X = U := by simp [hψ, hU]
        have e1 : ψ (Polynomial.X ^ M) = U ^ M := by rw [map_pow, hX]
        have e2 : ψ (Polynomial.X ^ N) = U ^ N := by rw [map_pow, hX]
        rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
          Polynomial.map_C, hp', hq', e1, e2, pow_add, Polynomial.C_mul]
        rw [← mul_assoc, ← mul_assoc, ← Polynomial.C_mul, ← Polynomial.C_mul,
          mul_comm (U ^ M) (U ^ N), mul_add]
      | monomial n r =>
        obtain ⟨N, q, hq⟩ := hmono r
        refine ⟨N, Polynomial.monomial n q, ?_⟩
        rw [Polynomial.map_monomial, ← hq, Polynomial.C_mul_monomial]
    exact key F


  have ramElt : IsIntegrallyClosed A → ∃ δ : A, δ ≠ 0 ∧ ∀ Q : Ideal ↥(integralClosure A L),
      (∃ g : L ≃ₐ[K] L, g ≠ 1 ∧ ∀ x : ↥(integralClosure A L), ∃ q ∈ Q, (q : L) = g x - x) →
      algebraMap A ↥(integralClosure A L) δ ∈ Q := by
    intro hA
    have hx : ∀ σ : L ≃ₐ[K] L, ∃ x : L, IsIntegral A x ∧ (σ ≠ 1 → σ x ≠ x) := by
      intro σ
      by_cases hσ : σ = 1
      · exact ⟨0, isIntegral_zero, fun h => absurd hσ h⟩
      obtain ⟨y, hy⟩ : ∃ y : L, σ y ≠ y := by
        by_contra h
        push_neg at h
        exact hσ (AlgEquiv.ext h)
      have halg : IsAlgebraic A y :=
        (IsFractionRing.isAlgebraic_iff A K L).mpr (Algebra.IsAlgebraic.isAlgebraic y)
      obtain ⟨a, ha, hai⟩ := halg.exists_integral_multiple
      refine ⟨a • y, hai, fun _ => ?_⟩
      intro heq
      apply hy
      have ha' : algebraMap A L a ≠ 0 := by
        rw [IsScalarTower.algebraMap_apply A K L]
        intro h0
        apply ha
        apply IsFractionRing.injective A K
        rw [map_zero]
        exact (algebraMap K L).injective (by rw [h0, map_zero])
      have e1 : σ (a • y) = algebraMap A L a * σ y := by
        rw [Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply A K L, AlgEquiv.commutes]
      rw [e1, Algebra.smul_def] at heq
      exact mul_left_cancel₀ ha' heq
    choose x hxint hxne using hx
    let d : (L ≃ₐ[K] L) → L := fun σ => σ (x σ) - x σ
    have hdint : ∀ σ, IsIntegral A (d σ) := fun σ =>
      IsIntegral.sub (IsIntegral.map σ (hxint σ)) (hxint σ)
    have hd0 : ∀ σ, σ ≠ 1 → d σ ≠ 0 := fun σ hσ => sub_ne_zero.mpr (hxne σ hσ)
    set D : L := ∏ σ ∈ Finset.univ.erase 1, d σ with hD
    have hDint : IsIntegral A D := by
      have : D ∈ integralClosure A L := prod_mem (fun σ _ => hdint σ)
      exact this
    have hD0 : D ≠ 0 := by
      rw [hD, Finset.prod_ne_zero_iff]
      intro σ hσ
      exact hd0 σ (Finset.ne_of_mem_erase hσ)
    obtain ⟨δ, hδ⟩ := IsIntegrallyClosed.isIntegral_iff.mp (Algebra.isIntegral_norm K hDint)
    have hτint : ∀ τ : L ≃ₐ[K] L, IsIntegral A (τ D) := fun τ => IsIntegral.map τ hDint
    refine ⟨δ, ?_, ?_⟩
    · intro h0
      rw [h0, map_zero] at hδ
      exact (Algebra.norm_ne_zero_iff.mpr hD0) hδ.symm
    · rintro Q ⟨g, hg, hQ⟩
      obtain ⟨q, hqQ, hq⟩ := hQ ⟨x g, hxint g⟩
      set T : L := ∏ τ ∈ (Finset.univ : Finset (L ≃ₐ[K] L)).erase 1, τ D with hT
      have hdel : algebraMap A L δ = D * T := by
        rw [IsScalarTower.algebraMap_apply A K L, hδ, Algebra.norm_eq_prod_automorphisms,
          ← Finset.mul_prod_erase Finset.univ (fun τ : L ≃ₐ[K] L => τ D) (Finset.mem_univ 1),
          AlgEquiv.one_apply]
      have hTint : T ∈ integralClosure A L := prod_mem (fun τ _ => hτint τ)
      set R : L := ∏ σ ∈ (Finset.univ.erase (1 : L ≃ₐ[K] L)).erase g, d σ with hR
      have hRint : R ∈ integralClosure A L := prod_mem (fun σ _ => hdint σ)
      have e2 : D = d g * R :=
        (Finset.mul_prod_erase (Finset.univ.erase 1) d
          (Finset.mem_erase.mpr ⟨hg, Finset.mem_univ g⟩)).symm
      have heq : algebraMap A ↥(integralClosure A L) δ =
          q * (⟨R, hRint⟩ * ⟨T, hTint⟩) := by
        apply Subtype.ext
        show algebraMap A L δ = (q : L) * (R * T)
        rw [hdel, hq, e2]
        show (g (x g) - x g) * R * T = (g (x g) - x g) * (R * T)
        ring
      rw [heq]
      exact Ideal.mul_mem_right _ Q hqQ


  have ratPt : ∀ (P : Ideal A), P.IsPrime → P ≤ 𝔭 → 𝔭 ≠ ⊤ →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) → ∀ (p : Polynomial ↥W), z ∈ 𝔭 → p ≠ 0 →
      Polynomial.aeval z p ∈ P →
      ∃ c : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ∧ z - algebraMap ↥W A c ∈ P := by
    intro P hP hP𝔭 h𝔭 hW p hz hp hpz
    haveI : IsDomain (A ⧸ P) := Ideal.Quotient.isDomain P
    let β : A →+* FractionRing (A ⧸ P) :=
      (algebraMap (A ⧸ P) (FractionRing (A ⧸ P))).comp (Ideal.Quotient.mk P)
    have hβ : ∀ a : A, β a = 0 ↔ a ∈ P := by
      intro a
      constructor
      · intro h
        have : Ideal.Quotient.mk P a = 0 :=
          IsFractionRing.injective (A ⧸ P) (FractionRing (A ⧸ P)) (by rw [map_zero]; exact h)
        exact Ideal.Quotient.eq_zero_iff_mem.mp this
      · intro h
        show algebraMap (A ⧸ P) _ (Ideal.Quotient.mk P a) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr h, map_zero]
    let j0 : ↥W →+* FractionRing (A ⧸ P) := β.comp (algebraMap ↥W A)
    have hj0 : Function.Injective j0 := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      by_contra hne
      exact hW w hne ((hβ _).mp hw)
    let ι : Ω →+* FractionRing (A ⧸ P) := IsFractionRing.lift hj0
    have hι : ∀ w : ↥W, ι (w : Ω) = j0 w := fun w => IsFractionRing.lift_algebraMap hj0 w
    letI : Algebra Ω (FractionRing (A ⧸ P)) := ι.toAlgebra
    have hx : IsAlgebraic Ω (β z) := by
      refine ⟨p.map (algebraMap ↥W Ω),
        (Polynomial.map_ne_zero_iff (IsFractionRing.injective ↥W Ω)).mpr hp, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have e1 : (algebraMap Ω (FractionRing (A ⧸ P))).comp (algebraMap ↥W Ω) = j0 := by
        ext w; exact hι w
      rw [e1]
      have e2 := Polynomial.hom_eval₂ p (algebraMap ↥W A) β z
      rw [← Polynomial.aeval_def] at e2
      rw [show j0 = β.comp (algebraMap ↥W A) from rfl, ← e2]
      exact (hβ _).mpr hpz
    have hint := hx.isIntegral
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hint)
    obtain ⟨l, hl⟩ := minpoly.mem_range_of_degree_eq_one Ω (β z) hdeg
    change ι l = β z at hl
    by_cases hlW' : l ∈ W
    · have hlW := hlW'
      refine ⟨⟨l, hlW⟩, ?_, ?_⟩
      · have hsub : z - algebraMap ↥W A ⟨l, hlW⟩ ∈ P := by
          rw [← hβ, map_sub, ← hl]
          rw [show β (algebraMap ↥W A ⟨l, hlW⟩) = j0 ⟨l, hlW⟩ from rfl, ← hι]
          exact sub_self _
        by_contra hqm
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hqm
        have h4 : algebraMap ↥W A ⟨l, hlW⟩ ∈ 𝔭 := by
          have := 𝔭.sub_mem hz (hP𝔭 hsub)
          rwa [sub_sub_cancel] at this
        exact h𝔭 (Ideal.eq_top_of_isUnit_mem 𝔭 h4 (hqm.map (algebraMap ↥W A)))
      · rw [← hβ, map_sub, ← hl]
        rw [show β (algebraMap ↥W A ⟨l, hlW⟩) = j0 ⟨l, hlW⟩ from rfl, ← hι]
        exact sub_self _
    · exfalso
      have hlW : l⁻¹ ∈ W := (W.mem_or_inv_mem l).resolve_left hlW'
      have hl0 : l ≠ 0 := by
        rintro rfl; exact hlW' W.zero_mem
      have hsub : algebraMap ↥W A ⟨l⁻¹, hlW⟩ * z - 1 ∈ P := by
        rw [← hβ, map_sub, map_mul, map_one, ← hl]
        rw [show β (algebraMap ↥W A ⟨l⁻¹, hlW⟩) = j0 ⟨l⁻¹, hlW⟩ from rfl, ← hι, ← map_mul]
        simp [hl0]
      have h1 : (1 : A) ∈ 𝔭 := by
        have := 𝔭.sub_mem (Ideal.mul_mem_left 𝔭 (algebraMap ↥W A ⟨l⁻¹, hlW⟩) hz) (hP𝔭 hsub)
        rwa [sub_sub_cancel] at this
      exact h𝔭 ((Ideal.eq_top_iff_one 𝔭).mpr h1)


  have annFactor : ∀ (P : Ideal A), P.IsPrime → P ≤ 𝔭 → 𝔭 ≠ ⊤ →
      (∀ w : ↥W, w ≠ 0 → algebraMap ↥W A w ∉ P) → ∀ (u v : A) (g c : ↥W), g ≠ 0 →
      u * v = algebraMap ↥W A g → v ∈ 𝔭 → u - algebraMap ↥W A c ∈ P →
      c ≠ 0 ∧ ∃ q : ↥W, q ∈ IsLocalRing.maximalIdeal ↥W ∧ g = c * q := by
    intro P hP hP𝔭 h𝔭 hW u v g c hg huv hv hc
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [map_zero, sub_zero] at hc
      exact hW g hg (huv ▸ Ideal.mul_mem_right v P hc)
    refine ⟨hc0, ?_⟩
    rcases ValuationRing.dvd_total c g with ⟨q, hq⟩ | ⟨r, hr⟩
    · refine ⟨q, ?_, hq⟩
      have h1 : algebraMap ↥W A c * (v - algebraMap ↥W A q) =
          -(v * (u - algebraMap ↥W A c)) := by
        have : algebraMap ↥W A g = algebraMap ↥W A c * algebraMap ↥W A q := by rw [hq, map_mul]
        linear_combination huv + this
      have h2 : algebraMap ↥W A c * (v - algebraMap ↥W A q) ∈ P := by
        rw [h1]; exact P.neg_mem_iff.mpr (Ideal.mul_mem_left P v hc)
      have h3 : v - algebraMap ↥W A q ∈ P := (hP.mem_or_mem h2).resolve_left (hW c hc0)
      have h4 : algebraMap ↥W A q ∈ 𝔭 := by
        have := 𝔭.sub_mem hv (hP𝔭 h3)
        rwa [sub_sub_cancel] at this
      by_contra hqm
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hqm
      exact h𝔭 (Ideal.eq_top_of_isUnit_mem 𝔭 h4 (hqm.map (algebraMap ↥W A)))
    · exfalso
      have h1 : v * (u - algebraMap ↥W A c) =
          algebraMap ↥W A g * (1 - algebraMap ↥W A r * v) := by
        have : algebraMap ↥W A c = algebraMap ↥W A g * algebraMap ↥W A r := by rw [hr, map_mul]
        linear_combination huv - v * this
      have h2 : algebraMap ↥W A g * (1 - algebraMap ↥W A r * v) ∈ P := by
        rw [← h1]; exact Ideal.mul_mem_left P v hc
      have h3 : 1 - algebraMap ↥W A r * v ∈ P := (hP.mem_or_mem h2).resolve_left (hW g hg)
      have h4 : (1 : A) ∈ 𝔭 := by
        have := 𝔭.add_mem (hP𝔭 h3) (Ideal.mul_mem_left 𝔭 (algebraMap ↥W A r) hv)
        rwa [sub_add_cancel] at this
      exact h𝔭 ((Ideal.eq_top_iff_one 𝔭).mpr h4)


  have core : z ∈ 𝔭 ∧ IsIntegrallyClosed A ∧ 𝔭 ≠ ⊤ ∧ ∀ a : A, ∃ F : Polynomial (Polynomial ↥W),
      F ≠ 0 ∧ F.eval₂ (Polynomial.aeval z : Polynomial ↥W →ₐ[↥W] A).toRingHom a = 0 := by
    rcases hkind with ⟨t, rfl, rfl⟩ | ⟨v, g, rfl⟩
    · obtain ⟨-, -, hIC, hmax, -, hz, -, h, hh, f, hfC, hfX, het⟩ := hPD
      have hh0 : h ≠ 0 := by rintro rfl; exact hh 𝔭.zero_mem
      have hle := powers_le_nonZeroDivisors_of_noZeroDivisors hh0
      haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization hle
      have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
        IsLocalization.injective (Localization.Away h) hle
      have hfeq : f = (algebraMap A (Localization.Away h)).comp
          (Polynomial.aeval z : Polynomial ↥W →ₐ[↥W] A).toRingHom := by
        apply Polynomial.ringHom_ext
        · intro w
          have := congrArg (fun φ => φ w) hfC
          simp only [RingHom.comp_apply] at this
          rw [this]
          simp
        · rw [hfX]
          simp
      refine ⟨hz, hIC, hmax.ne_top, fun a => ?_⟩
      obtain ⟨F, hF, hFa⟩ := etaleAlg _ (Localization.Away h) f het
        (algebraMap A (Localization.Away h) a)
      refine ⟨F, fun h0 => hF (by rw [h0, Polynomial.map_zero]), hinj ?_⟩
      rw [map_zero, Polynomial.hom_eval₂, ← hfeq]
      exact hFa
    · obtain ⟨-, hNZ, hIC, hmax, -, hgm, hg0, huv, h𝔭eq, h, hh, f, hfC, hfU, hfV, het⟩ := hPD
      have hh0' : h ≠ 0 := by rintro rfl; exact hh 𝔭.zero_mem
      haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization
        (powers_le_nonZeroDivisors_of_noZeroDivisors hh0')
      have hea := etaleAlg (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {(MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}) (Localization.Away h) f
        (by exact het)
      have hz : z ∈ 𝔭 := by
        rw [h𝔭eq]
        exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
      have hh0 : h ≠ 0 := by rintro rfl; exact hh 𝔭.zero_mem
      have hle := powers_le_nonZeroDivisors_of_noZeroDivisors hh0
      haveI : IsDomain (Localization.Away h) := IsLocalization.isDomain_localization hle
      have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
        IsLocalization.injective (Localization.Away h) hle
      have hz0 : z ≠ 0 := by
        rintro rfl
        rw [zero_mul] at huv
        have h1 : g • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact huv.symm
        exact hg0 ((smul_eq_zero.mp h1).resolve_right one_ne_zero)
      set ψ := Polynomial.eval₂RingHom
        ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C)
        (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.X 0)) with hψ
      have hfeq : f.comp ψ = (algebraMap A (Localization.Away h)).comp
          (Polynomial.aeval z : Polynomial ↥W →ₐ[↥W] A).toRingHom := by
        apply Polynomial.ringHom_ext
        · intro w
          have := congrArg (fun φ => φ w) hfC
          simp only [RingHom.comp_apply] at this
          simp only [RingHom.comp_apply, hψ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          rw [this]
          simp
        · simp only [RingHom.comp_apply, hψ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          rw [hfU]
          simp
      refine ⟨hz, hIC, hmax.ne_top, fun a => ?_⟩
      obtain ⟨F, hF, hFa⟩ := hea (algebraMap A (Localization.Away h) a)
      obtain ⟨N, F', hN⟩ := nodal g _ rfl F
      have hfU0 : f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ≠ 0 := by
        rw [hfU]
        intro h0
        exact hz0 (hinj (by rw [h0, map_zero]))
      refine ⟨F', ?_, hinj ?_⟩
      · rintro rfl
        apply hF
        have h1 := congrArg (Polynomial.map f) hN
        rw [Polynomial.map_zero, Polynomial.map_zero, Polynomial.map_mul,
          Polynomial.map_C] at h1
        refine (mul_eq_zero.mp h1.symm).resolve_left ?_
        rw [Polynomial.C_eq_zero, map_pow]
        exact pow_ne_zero _ hfU0
      · rw [map_zero, Polynomial.hom_eval₂, ← hfeq, ← Polynomial.eval₂_map, hN,
          Polynomial.eval₂_mul, hFa, mul_zero]
  obtain ⟨hz𝔭, hIC, h𝔭, halg⟩ := core
  have annData : ∀ v g, k = .ann z v g → g ≠ 0 ∧ z * v = algebraMap ↥W A g ∧ v ∈ 𝔭 := by
    intro v g hk
    subst hk
    obtain ⟨-, -, -, -, -, -, hg0, huv, h𝔭eq, -⟩ := hPD
    refine ⟨hg0, huv, ?_⟩
    rw [h𝔭eq]
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))


  obtain ⟨δ, hδ0, hδQ⟩ := ramElt hIC
  obtain ⟨F, hF, hFδ⟩ := halg δ
  obtain ⟨p, hp0, hpδ⟩ := trailing _ _ _ δ F hδ0 hF hFδ
  have hpδ' : Polynomial.aeval z p ∈ Ideal.span {δ} := hpδ
  have hK : ∀ Q : Ideal ↥(integralClosure A L), wcLlsRam A K L Q →
      Polynomial.aeval z p ∈ Q.comap (algebraMap A ↥(integralClosure A L)) := by
    intro Q hR
    have h1 : δ ∈ Q.comap (algebraMap A ↥(integralClosure A L)) :=
      Ideal.mem_comap.mpr (hδQ Q hR)
    exact (Ideal.span_singleton_le_iff_mem _).mpr h1 hpδ'
  refine ⟨?_, ?_, ?_⟩
  · intro Q hGen hR
    obtain ⟨hQp, hQle, hQW⟩ := hGen
    haveI := hQp
    exact ratPt _ (Ideal.IsPrime.comap _) hQle h𝔭 hQW p hz𝔭 hp0 (hK Q hR)
  · apply Set.Finite.subset (p.roots.toFinset.finite_toSet)
    intro c hc
    obtain ⟨-, Q, ⟨hQp, hQle, hQW⟩, hzc, hR⟩ := hc
    have hpz := hK Q hR
    have e1 : algebraMap ↥W A (p.eval c) =
        (p.map (algebraMap ↥W A)).eval (algebraMap ↥W A c) := by
      rw [Polynomial.eval_map_algebraMap, Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval]
    have e2 : Polynomial.aeval z p = (p.map (algebraMap ↥W A)).eval z :=
      (Polynomial.eval_map_algebraMap p z).symm
    obtain ⟨r, hr⟩ := Polynomial.sub_dvd_eval_sub z (algebraMap ↥W A c) (p.map (algebraMap ↥W A))
    have hmem : algebraMap ↥W A (p.eval c) ∈ Q.comap (algebraMap A ↥(integralClosure A L)) := by
      have : algebraMap ↥W A (p.eval c) =
          Polynomial.aeval z p - (z - algebraMap ↥W A c) * r := by
        rw [e1, e2, ← hr]; ring
      rw [this]
      exact Ideal.sub_mem _ hpz (Ideal.mul_mem_right _ _ hzc)
    have hroot : p.eval c = 0 := by
      by_contra hne
      exact hQW _ hne hmem
    simp only [Finset.mem_coe, Multiset.mem_toFinset]
    exact (Polynomial.mem_roots hp0).mpr hroot
  · intro v g hk c hc
    obtain ⟨hg0, huv, hv⟩ := annData v g hk
    obtain ⟨-, Q, ⟨hQp, hQle, hQW⟩, hzc, -⟩ := hc
    haveI := hQp
    exact annFactor _ (Ideal.IsPrime.comap _) hQle h𝔭 hQW z v g c hg0 huv hv hzc

theorem wcpa_dj_llsm_nss_recenter : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c c' b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ c - c' →
      (wcLlsDiscSep W A K L t c b ↔ wcLlsDiscSep W A K L t c' b) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ 𝔭 t hPD

  have s4 : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
      [Algebra A K] (L : Type u) [Field L] [Algebra K L] (R R' : Subalgebra A K) (υ : K),
      υ ∈ R' → (∀ r ∈ R, ∃ k : ℕ, υ ^ k * r ∈ R') →
      ∀ x : L, IsIntegral ↥R x → ∃ k : ℕ, IsIntegral ↥R' (algebraMap K L (υ ^ k) * x) := by
    intro A _ K _ _ L _ _ R R' υ hυ hmul x hx
    classical
    obtain ⟨p, hpm, hp⟩ := hx
    choose! kf hkf using hmul
    set n := p.natDegree with hn
    set κ := ∑ i ∈ Finset.range (n + 1), kf ((p.coeff i : R) : K) with hκ
    set q : Polynomial K := (p.map R.val.toRingHom).scaleRoots (υ ^ κ) with hq
    have hpm' : (p.map R.val.toRingHom).Monic := hpm.map _
    have hnd : (p.map R.val.toRingHom).natDegree = n := hpm.natDegree_map _
    have hqm : q.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hpm'
    have hcoeff : ∀ i, q.coeff i ∈ R' := by
      intro i
      rw [hq, Polynomial.coeff_scaleRoots, hnd, Polynomial.coeff_map]
      rcases lt_trichotomy i n with hi | hi | hi
      · have h1 : kf ((p.coeff i : R) : K) ≤ κ :=
          Finset.single_le_sum (f := fun j => kf ((p.coeff j : R) : K))
            (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr (by omega))
        have h2 : κ ≤ κ * (n - i) := Nat.le_mul_of_pos_right _ (by omega)
        have e : (υ ^ κ) ^ (n - i) = υ ^ (κ * (n - i) - kf ((p.coeff i : R) : K)) *
            υ ^ kf ((p.coeff i : R) : K) := by
          rw [← pow_mul, ← pow_add, Nat.sub_add_cancel (h1.trans h2)]
        show ((p.coeff i : R) : K) * (υ ^ κ) ^ (n - i) ∈ R'
        rw [e, mul_comm, mul_assoc]
        exact mul_mem (pow_mem hυ _) (hkf _ (p.coeff i).2)
      · subst hi
        show ((p.coeff p.natDegree : R) : K) * (υ ^ κ) ^ (p.natDegree - p.natDegree) ∈ R'
        rw [hpm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
        exact one_mem _
      · show ((p.coeff i : R) : K) * (υ ^ κ) ^ (n - i) ∈ R'
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi]
        simp
    have hqlift : q ∈ Polynomial.lifts R'.val.toRingHom := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      exact ⟨⟨q.coeff i, hcoeff i⟩, rfl⟩
    obtain ⟨q', hq'map, _, hq'm⟩ := Polynomial.lifts_and_degree_eq_and_monic hqlift hqm
    refine ⟨κ, q', hq'm, ?_⟩
    have halg : algebraMap ↥R' L = (algebraMap K L).comp R'.val.toRingHom := rfl
    rw [halg, ← Polynomial.eval₂_map, hq'map, hq]
    apply Polynomial.scaleRoots_eval₂_eq_zero
    rw [Polynomial.eval₂_map]
    exact hp

  have s5 : ∀ (C C' L : Type u) [CommRing C] [CommRing C'] [Field L]
      (i : C →+* L) (i' : C' →+* L), Function.Injective i' → ∀ υ' : C',
      (∀ x : C, ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x) →
      ∀ Q' : Ideal C', Q'.IsPrime → υ' ∉ Q' →
      ∃ Q : Ideal C, Q.IsPrime ∧
        ∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q') := by
    intro C C' L _ _ _ i i' hi' υ' H Q' hQ' hυ'
    have hpow : ∀ k : ℕ, υ' ^ k ∉ Q' := fun k h => hυ' (hQ'.mem_of_pow_mem k h)
    have indep : ∀ (x : C) (k₁ k₂ : ℕ) (y₁ y₂ : C'), i' y₁ = i' υ' ^ k₁ * i x →
        i' y₂ = i' υ' ^ k₂ * i x → y₁ ∈ Q' → y₂ ∈ Q' := by
      intro x k₁ k₂ y₁ y₂ h1 h2 hy1
      have e : υ' ^ k₁ * y₂ = υ' ^ k₂ * y₁ :=
        hi' (by rw [map_mul, map_mul, map_pow, map_pow, h1, h2]; ring)
      have : υ' ^ k₁ * y₂ ∈ Q' := by rw [e]; exact Q'.mul_mem_left _ hy1
      exact (hQ'.mem_or_mem this).resolve_left (hpow k₁)
    let Q : Ideal C :=
      { carrier := {x | ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x ∧ y ∈ Q'}
        add_mem' := by
          rintro a b ⟨k₁, y₁, h1, hy1⟩ ⟨k₂, y₂, h2, hy2⟩
          refine ⟨k₁ + k₂, υ' ^ k₂ * y₁ + υ' ^ k₁ * y₂, ?_,
            add_mem (Q'.mul_mem_left _ hy1) (Q'.mul_mem_left _ hy2)⟩
          rw [map_add, map_mul, map_mul, map_pow, map_pow, h1, h2, map_add]; ring
        zero_mem' := ⟨0, 0, by simp, Q'.zero_mem⟩
        smul_mem' := by
          rintro a b ⟨k₁, y₁, h1, hy1⟩
          obtain ⟨j, ya, ha⟩ := H a
          refine ⟨j + k₁, ya * y₁, ?_, Q'.mul_mem_left _ hy1⟩
          rw [smul_eq_mul, map_mul, map_mul, ha, h1]; ring }
    have memQ : ∀ x, x ∈ Q ↔ ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x ∧ y ∈ Q' :=
      fun x => Iff.rfl
    have HQ : ∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q') := by
      intro x k y hy
      rw [memQ]
      constructor
      · rintro ⟨k₂, y₂, h2, hy2⟩
        exact indep x k₂ k y₂ y h2 hy hy2
      · intro hyQ
        exact ⟨k, y, hy, hyQ⟩
    refine ⟨Q, ⟨?_, ?_⟩, HQ⟩
    · rw [Ne, Ideal.eq_top_iff_one, memQ]
      rintro ⟨k, y, h, hy⟩
      have : y = υ' ^ k := hi' (by rw [h, map_one, mul_one, map_pow])
      exact hpow k (this ▸ hy)
    · intro a b hab
      obtain ⟨k₁, y₁, h1⟩ := H a
      obtain ⟨k₂, y₂, h2⟩ := H b
      have h12 : i' (y₁ * y₂) = i' υ' ^ (k₁ + k₂) * i (a * b) := by
        rw [map_mul, map_mul, h1, h2]; ring
      have := (HQ _ _ _ h12).mp hab
      rcases hQ'.mem_or_mem this with h | h
      · exact Or.inl ((HQ _ _ _ h1).mpr h)
      · exact Or.inr ((HQ _ _ _ h2).mpr h)

  have s6 : ∀ (C C' L : Type u) [CommRing C] [IsDomain C] [CommRing C']
      [IsDomain C'] [Field L] (i : C →+* L) (i' : C' →+* L), Function.Injective i →
      Function.Injective i' → ∀ (υ : C) (υ' : C'), i υ * i' υ' = 1 →
      (∀ x : C, ∃ (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x) →
      (∀ x' : C', ∃ (k : ℕ) (y : C), i y = i υ ^ k * i' x') →
      ∀ (Q : Ideal C) [Q.IsPrime] (Q' : Ideal C') [Q'.IsPrime], υ' ∉ Q' →
      (∀ (x : C) (k : ℕ) (y : C'), i' y = i' υ' ^ k * i x → (x ∈ Q ↔ y ∈ Q')) →
      ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime Q',
        ∀ (x : C) (y : C'), i x = i' y →
          e (algebraMap C (Localization.AtPrime Q) x) =
            algebraMap C' (Localization.AtPrime Q') y := by
    intro C C' L _ _ _ _ _ i i' hi hi' υ υ' hυυ' H H' Q hQ Q' hQ' hυ' HQ
    have HQr : ∀ (x' : C') (k : ℕ) (y : C), i y = i υ ^ k * i' x' → (y ∈ Q ↔ x' ∈ Q') := by
      intro x' k y hy
      apply HQ y k x'
      rw [hy, ← mul_assoc, ← mul_pow, mul_comm (i' υ'), hυυ', one_pow, one_mul]
    have hυ : υ ∉ Q := by
      intro h
      have h1 : i' 1 = i' υ' ^ 1 * i υ := by rw [pow_one, mul_comm, hυυ', map_one]
      exact hQ'.ne_top ((Ideal.eq_top_iff_one _).mpr ((HQ υ 1 1 h1).mp h))
    have hne : ∀ d : C, d ∉ Q → i d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi (by rw [h0, map_zero])
      rw [this]; exact Q.zero_mem
    have hne' : ∀ d : C', d ∉ Q' → i' d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi' (by rw [h0, map_zero])
      rw [this]; exact Q'.zero_mem
    have hu : ∀ d : Q.primeCompl, IsUnit (i d) := fun d => isUnit_iff_ne_zero.mpr (hne d d.2)
    have hu' : ∀ d : Q'.primeCompl, IsUnit (i' d) :=
      fun d => isUnit_iff_ne_zero.mpr (hne' d d.2)
    obtain ⟨ι, hιa, hιm, hinj⟩ : ∃ ι : Localization.AtPrime Q →+* L,
        (∀ x, ι (algebraMap C _ x) = i x) ∧
        (∀ x (d : Q.primeCompl), i x = i d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hu,
        IsLocalization.lift_eq hu, fun x d => (IsLocalization.lift_mk'_spec hu x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i (IsLocalization.injective (Localization.AtPrime Q)
          (Ideal.primeCompl_le_nonZeroDivisors Q) h)
      · intro h; rw [hi h]
    obtain ⟨ι', hιa', hιm', hinj'⟩ : ∃ ι : Localization.AtPrime Q' →+* L,
        (∀ x, ι (algebraMap C' _ x) = i' x) ∧
        (∀ x (d : Q'.primeCompl), i' x = i' d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q'.primeCompl) (S := Localization.AtPrime Q') hu',
        IsLocalization.lift_eq hu', fun x d => (IsLocalization.lift_mk'_spec hu' x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i' (IsLocalization.injective (Localization.AtPrime Q')
          (Ideal.primeCompl_le_nonZeroDivisors Q') h)
      · intro h; rw [hi' h]
    have hrange : ι.range = ι'.range := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
        obtain ⟨k₁, y₁, h1⟩ := H x
        obtain ⟨k₂, y₂, h2⟩ := H d
        have hy₂ : y₂ ∉ Q' := fun h => d.2 ((HQ _ _ _ h2).mpr h)
        have hD : y₂ * υ' ^ k₁ ∈ Q'.primeCompl := by
          intro h
          rcases hQ'.mem_or_mem h with h | h
          · exact hy₂ h
          · exact hυ' (hQ'.mem_of_pow_mem _ h)
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q') (y₁ * υ' ^ k₂) ⟨_, hD⟩, ?_⟩
        apply mul_left_cancel₀ (hne' _ hD)
        have hv := hιm x d
        have hv' := hιm' (y₁ * υ' ^ k₂) ⟨_, hD⟩
        simp only at hv'
        rw [← hv']
        have hd0 : i d ≠ 0 := hne d d.2
        apply mul_left_cancel₀ hd0
        rw [map_mul, map_mul, map_pow, map_pow, h1, h2]
        calc i d * (i' υ' ^ k₁ * i x * i' υ' ^ k₂)
            = i' υ' ^ k₁ * i' υ' ^ k₂ * i d * i x := by ring
          _ = i' υ' ^ k₁ * i' υ' ^ k₂ * i d * (i d * ι (IsLocalization.mk' _ x d)) := by
              rw [← hv]
          _ = i d * (i' υ' ^ k₂ * i d * i' υ' ^ k₁ * ι (IsLocalization.mk' _ x d)) := by ring
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q'.primeCompl z
        obtain ⟨k₁, y₁, h1⟩ := H' x
        obtain ⟨k₂, y₂, h2⟩ := H' d
        have hy₂ : y₂ ∉ Q := fun h => d.2 ((HQr _ _ _ h2).mp h)
        have hD : y₂ * υ ^ k₁ ∈ Q.primeCompl := by
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact hy₂ h
          · exact hυ (hQ.mem_of_pow_mem _ h)
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q) (y₁ * υ ^ k₂) ⟨_, hD⟩, ?_⟩
        apply mul_left_cancel₀ (hne _ hD)
        have hv := hιm' x d
        have hv' := hιm (y₁ * υ ^ k₂) ⟨_, hD⟩
        simp only at hv'
        rw [← hv']
        have hd0 : i' d ≠ 0 := hne' d d.2
        apply mul_left_cancel₀ hd0
        rw [map_mul, map_mul, map_pow, map_pow, h1, h2]
        calc i' d * (i υ ^ k₁ * i' x * i υ ^ k₂)
            = i υ ^ k₁ * i υ ^ k₂ * i' d * i' x := by ring
          _ = i υ ^ k₁ * i υ ^ k₂ * i' d * (i' d * ι' (IsLocalization.mk' _ x d)) := by
              rw [← hv]
          _ = i' d * (i υ ^ k₂ * i' d * i υ ^ k₁ * ι' (IsLocalization.mk' _ x d)) := by ring
    let e1 : Localization.AtPrime Q ≃+* ι.range :=
      RingEquiv.ofBijective ι.rangeRestrict
        ⟨fun a b h => hinj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι⟩
    let e2 : Localization.AtPrime Q' ≃+* ι'.range :=
      RingEquiv.ofBijective ι'.rangeRestrict
        ⟨fun a b h => hinj' (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι'⟩
    let e : Localization.AtPrime Q ≃+* Localization.AtPrime Q' :=
      e1.trans ((RingEquiv.subringCongr hrange).trans e2.symm)
    have hιe : ∀ z, ι' (e z) = ι z := by
      intro z
      have := congrArg Subtype.val (e2.apply_symm_apply ((RingEquiv.subringCongr hrange) (e1 z)))
      exact this
    refine ⟨e, fun x y hxy => hinj' ?_⟩
    rw [hιe, hιa, hιa']
    exact hxy

  have hllfi : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    classical
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
        algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
        (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }

  have s7 : ∀ (L : Type u) [Field L] (wL : ↥W →+* L) (R R' : Type u) [CommRing R]
      [CommRing R'] [Algebra R L] [Algebra R' L]
      (Q : Ideal ↥(integralClosure R L)) [Q.IsPrime]
      (Q' : Ideal ↥(integralClosure R' L)) [Q'.IsPrime]
      (e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'),
      (∀ (x : ↥(integralClosure R L)) (y : ↥(integralClosure R' L)), (x : L) = (y : L) →
        e (algebraMap _ _ x) = algebraMap _ _ y) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        wL w ∈ integralClosure R L ∧ wL w ∈ integralClosure R' L) →
      (wcpaDjLkBad (wcLlsFS W wL R Q) ↔ wcpaDjLkBad (wcLlsFS W wL R' Q')) := by
    intro L _ wL R R' _ _ _ _ Q _ Q' _ e he hw
    have hI : Ideal.map (e : Localization.AtPrime Q →+* Localization.AtPrime Q')
        ((Ideal.span {b : ↥(integralClosure R L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) =
        (Ideal.span {b : ↥(integralClosure R' L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w}).map
            (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')) := by
      rw [Ideal.map_map, Ideal.map_span, Ideal.map_span]
      congr 1
      ext z
      constructor
      · rintro ⟨b, ⟨w, hw', hb⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').2⟩, ⟨w, hw', rfl⟩, (he b ⟨wL w, (hw w hw').2⟩ hb).symm⟩
      · rintro ⟨b', ⟨w, hw', hb'⟩, rfl⟩
        exact ⟨⟨wL w, (hw w hw').1⟩, ⟨w, hw', rfl⟩, he ⟨wL w, (hw w hw').1⟩ b' hb'.symm⟩
    have eq : wcLlsFS W wL R Q ≃+* wcLlsFS W wL R' Q' := Ideal.quotientEquiv _ _ e hI.symm
    obtain ⟨h1, h2⟩ := hllfi _ _ eq
    unfold wcpaDjLkBad
    rw [h1, h2]

  have s1 : ∀ c : ↥W, t - algebraMap ↥W A c ≠ 0 := by
    intro c h0
    obtain ⟨_, _, _, _, _, _, _, h, hh, f, hfC, hfX, hfet⟩ := hPD
    letI := f.toAlgebra
    have hflat : f.Flat := ((RingHom.etale_iff_formallyUnramified_and_smooth f).mp hfet).2.flat
    haveI : Module.Flat (Polynomial ↥W) (Localization.Away h) := hflat
    have hP : (Polynomial.X - Polynomial.C c) ∈ nonZeroDivisors (Polynomial ↥W) :=
      (Polynomial.monic_X_sub_C c).mem_nonZeroDivisors
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Localization.Away h) hP
    have hfP : f (Polynomial.X - Polynomial.C c) = 0 := by
      rw [map_sub, hfX]
      have e1 : f (Polynomial.C c) = algebraMap A (Localization.Away h) (algebraMap ↥W A c) := by
        rw [← RingHom.comp_apply, hfC]; rfl
      rw [e1, ← map_sub, h0, map_zero]
    have h10 : (1 : Localization.Away h) = 0 := by
      apply hreg
      show (Polynomial.X - Polynomial.C c) • (1 : Localization.Away h) =
        (Polynomial.X - Polynomial.C c) • (0 : Localization.Away h)
      rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra, hfP, zero_mul]
    have hh0 : h ≠ 0 := fun e => hh (e ▸ Ideal.zero_mem _)
    have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
      IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    exact one_ne_zero (hinj (by rw [map_one, map_zero]; exact h10))
  obtain ⟨_, _, _, hmax, _, _, h𝔭, _⟩ := hPD

  have s2 : ∀ (s : K) (N J : Ideal ↥(Algebra.adjoin A {s})),
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ N →
      𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) → N ≤ J → J ≠ ⊤ → J = N := by
    intro s N J hsN hpN hNJ hJ
    refine le_antisymm ?_ hNJ
    intro x hxJ
    obtain ⟨p, hp⟩ : ∃ p : Polynomial A, Polynomial.aeval s p = (x : K) := by
      have gen : ∀ y ∈ Algebra.adjoin A {s}, ∃ p : Polynomial A, Polynomial.aeval s p = y := by
        intro y hy
        rw [Algebra.adjoin_singleton_eq_range_aeval] at hy
        obtain ⟨p, hp⟩ := hy
        exact ⟨p, hp⟩
      exact gen (x : K) x.2
    have hx : x = algebraMap A _ (p.coeff 0) +
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) *
        ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton A s⟩ := by
      apply Subtype.ext
      have e := congrArg (Polynomial.aeval s) (Polynomial.X_mul_divX_add p)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at e
      rw [Subalgebra.coe_add, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ← hp, ← e]
      exact add_comm _ _
    have hsy : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) *
        ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton A s⟩ ∈ N :=
      Ideal.mul_mem_right _ _ hsN
    have haJ : algebraMap A ↥(Algebra.adjoin A {s}) (p.coeff 0) ∈ J := by
      have h1 : algebraMap A ↥(Algebra.adjoin A {s}) (p.coeff 0) = x -
          (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) *
          ⟨Polynomial.aeval s p.divX, Polynomial.aeval_mem_adjoin_singleton A s⟩ := by
        rw [hx]; ring
      rw [h1]
      exact sub_mem hxJ (hNJ hsy)
    by_cases hc0 : p.coeff 0 ∈ 𝔭
    · rw [hx]
      exact add_mem (hpN hc0) hsy
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hmax.exists_inv hc0
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(Algebra.adjoin A {s})) =
          algebraMap A _ β * algebraMap A _ (p.coeff 0) + algebraMap A _ i := by
        rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hpN hi))

  have s3 : ∀ (s₁ s₂ υ : K), υ ∈ Algebra.adjoin A {s₂} → υ * s₁ ∈ Algebra.adjoin A {s₂} →
      ∀ r ∈ Algebra.adjoin A {s₁}, ∃ k : ℕ, υ ^ k * r ∈ Algebra.adjoin A {s₂} := by
    intro s₁ s₂ υ hυ hυs r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨1, by rwa [pow_one]⟩
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ a⟩
    | add x y _ _ hx hy =>
      obtain ⟨k₁, h₁⟩ := hx
      obtain ⟨k₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, ?_⟩
      have e : υ ^ (k₁ + k₂) * (x + y) = υ ^ k₂ * (υ ^ k₁ * x) + υ ^ k₁ * (υ ^ k₂ * y) := by ring
      rw [e]
      exact add_mem (mul_mem (pow_mem hυ _) h₁) (mul_mem (pow_mem hυ _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨k₁, h₁⟩ := hx
      obtain ⟨k₂, h₂⟩ := hy
      refine ⟨k₁ + k₂, ?_⟩
      have e : υ ^ (k₁ + k₂) * (x * y) = (υ ^ k₁ * x) * (υ ^ k₂ * y) := by ring
      rw [e]
      exact mul_mem h₁ h₂

  have key : ∀ c c' b : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W → c' ∈ IsLocalRing.maximalIdeal ↥W →
      b ∣ c - c' → wcLlsDiscSep W A K L t c b → wcLlsDiscSep W A K L t c' b := by
    intro c c' b hc hc' hdvd hsep
    obtain ⟨w, hw⟩ := hdvd
    have hZ : algebraMap A K (t - algebraMap ↥W A c) ≠ 0 := fun h =>
      s1 c ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))
    have hZ' : algebraMap A K (t - algebraMap ↥W A c') ≠ 0 := fun h =>
      s1 c' ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))
    have I1 : algebraMap A K (t - algebraMap ↥W A c') = algebraMap A K (t - algebraMap ↥W A c) +
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K (algebraMap ↥W A w) := by
      have e : algebraMap ↥W A c = algebraMap ↥W A c' + algebraMap ↥W A b * algebraMap ↥W A w := by
        rw [← map_mul, ← map_add, ← hw]; congr 1; ring
      rw [← map_mul, ← map_add, e]; congr 1; ring
    unfold wcLlsDiscSep wcLlsSepAt at hsep ⊢
    set Z := algebraMap A K (t - algebraMap ↥W A c) with hZdef
    set Z' := algebraMap A K (t - algebraMap ↥W A c') with hZ'def
    set B := algebraMap A K (algebraMap ↥W A b) with hBdef
    set ω := algebraMap A K (algebraMap ↥W A w) with hωdef
    set s := B / Z with hsdef
    set s' := B / Z' with hs'def
    have hZB : Z + B * ω ≠ 0 := by rw [← I1]; exact hZ'
    have hs'2 : s' = B / (Z + B * ω) := by rw [hs'def, I1]
    have alg : ∀ (Z P B ω : K), Z ≠ 0 → P ≠ 0 → P = Z + B * ω →
        (1 + ω * (B / Z)) * (1 - ω * (B / P)) = 1 ∧
        (1 + ω * (B / Z)) * (B / P) = B / Z ∧
        (1 - ω * (B / P)) * (B / Z) = B / P := by
      intro Z P B ω h1 h2 hP
      have ea : 1 + ω * (B / Z) = P / Z := by
        rw [eq_div_iff h1, add_mul, mul_assoc, div_mul_cancel₀ B h1, hP]; ring
      have eb : 1 - ω * (B / P) = Z / P := by
        rw [eq_div_iff h2, sub_mul, mul_assoc, div_mul_cancel₀ B h2, hP]; ring
      rw [ea, eb]
      refine ⟨?_, ?_, ?_⟩
      · rw [div_mul_div_comm, mul_comm P Z, div_self (mul_ne_zero h1 h2)]
      · rw [div_mul_div_comm, mul_comm P B, mul_div_mul_right B Z h2]
      · rw [div_mul_div_comm, mul_comm Z B, mul_div_mul_right B P h1]
    obtain ⟨I4, I5, I6⟩ : (1 + ω * s) * (1 - ω * s') = 1 ∧ (1 + ω * s) * s' = s ∧
        (1 - ω * s') * s = s' := alg Z Z' B ω hZ hZ' I1

    have hsR : s ∈ Algebra.adjoin A {s} := Algebra.subset_adjoin (Set.mem_singleton s)
    have hs'R : s' ∈ Algebra.adjoin A {s'} := Algebra.subset_adjoin (Set.mem_singleton s')
    have hu : 1 + ω * s ∈ Algebra.adjoin A {s} :=
      add_mem (one_mem _) (mul_mem (Subalgebra.algebraMap_mem _ _) hsR)
    have hu' : 1 - ω * s' ∈ Algebra.adjoin A {s'} :=
      sub_mem (one_mem _) (mul_mem (Subalgebra.algebraMap_mem _ _) hs'R)
    have hus' : (1 + ω * s) * s' ∈ Algebra.adjoin A {s} := by rw [I5]; exact hsR
    have hu's : (1 - ω * s') * s ∈ Algebra.adjoin A {s'} := by rw [I6]; exact hs'R
    have M1 := s3 s s' (1 - ω * s') hu' hu's
    have M2 := s3 s' s (1 + ω * s) hu hus'
    have Hc := s4 A K L (Algebra.adjoin A {s}) (Algebra.adjoin A {s'})
      (1 - ω * s') hu' M1
    have Hc' := s4 A K L (Algebra.adjoin A {s'}) (Algebra.adjoin A {s})
      (1 + ω * s) hu M2
    let i : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →+* L :=
      (integralClosure ↥(Algebra.adjoin A {s}) L).val.toRingHom
    let i' : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L) →+* L :=
      (integralClosure ↥(Algebra.adjoin A {s'}) L).val.toRingHom
    have hi : Function.Injective i := Subtype.val_injective
    have hi' : Function.Injective i' := Subtype.val_injective
    let υ : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
      algebraMap ↥(Algebra.adjoin A {s}) _ ⟨1 + ω * s, hu⟩
    let υ' : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L) :=
      algebraMap ↥(Algebra.adjoin A {s'}) _ ⟨1 - ω * s', hu'⟩
    have hiυ : i υ = algebraMap K L (1 + ω * s) := rfl
    have hiυ' : i' υ' = algebraMap K L (1 - ω * s') := rfl
    have hυυ' : i υ * i' υ' = 1 := by rw [hiυ, hiυ', ← map_mul, I4, map_one]
    have H : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
        ∃ (k : ℕ) (y : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L)),
          i' y = i' υ' ^ k * i x := by
      intro x
      obtain ⟨k, hk⟩ := Hc (x : L) x.2
      refine ⟨k, ⟨_, hk⟩, ?_⟩
      show algebraMap K L ((1 - ω * s') ^ k) * (x : L) = i' υ' ^ k * (x : L)
      rw [hiυ', map_pow]
    have H' : ∀ x' : ↥(integralClosure ↥(Algebra.adjoin A {s'}) L),
        ∃ (k : ℕ) (y : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)),
          i y = i υ ^ k * i' x' := by
      intro x
      obtain ⟨k, hk⟩ := Hc' (x : L) x.2
      refine ⟨k, ⟨_, hk⟩, ?_⟩
      show algebraMap K L ((1 + ω * s) ^ k) * (x : L) = i υ ^ k * (x : L)
      rw [hiυ, map_pow]
    intro Q' hQ' hQ'N

    have hs'N : (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'})) ∈
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c'),
          (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'}))} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hυ' : υ' ∉ Q' := by
      intro hmem
      have h1 : (⟨1 - ω * s', hu'⟩ : ↥(Algebra.adjoin A {s'})) ∈
          Q'.comap (algebraMap ↥(Algebra.adjoin A {s'}) _) := hmem
      have h2 : (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'})) ∈
          Q'.comap (algebraMap ↥(Algebra.adjoin A {s'}) _) := by rw [hQ'N]; exact hs'N
      have h3 : (1 : ↥(Algebra.adjoin A {s'})) = ⟨1 - ω * s', hu'⟩ +
          algebraMap A ↥(Algebra.adjoin A {s'}) (algebraMap ↥W A w) * ⟨s', hs'R⟩ := by
        apply Subtype.ext
        show (1 : K) = (1 - ω * s') + ω * s'
        ring
      apply hQ'.ne_top
      rw [Ideal.eq_top_iff_one]
      have h4 : (1 : ↥(Algebra.adjoin A {s'})) ∈
          Q'.comap (algebraMap ↥(Algebra.adjoin A {s'}) _) := by
        rw [h3]; exact add_mem h1 (Ideal.mul_mem_left _ _ h2)
      rw [Ideal.mem_comap, map_one] at h4
      exact h4
    obtain ⟨Q, hQ, HQ⟩ := s5 _ _ L i i' hi' υ' H Q' hQ' hυ'
    haveI := hQ
    obtain ⟨e, he⟩ := s6 _ _ L i i' hi hi' υ υ' hυυ' H H' Q Q' hυ' HQ

    have memJ : ∀ (r : ↥(Algebra.adjoin A {s})) (k : ℕ) (r' : ↥(Algebra.adjoin A {s'})),
        algebraMap K L (r' : K) = algebraMap K L (1 - ω * s') ^ k * algebraMap K L (r : K) →
        r' ∈ Ideal.span {algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c'),
          (⟨s', hs'R⟩ : ↥(Algebra.adjoin A {s'}))} ⊔
          (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) →
        r ∈ Q.comap (algebraMap ↥(Algebra.adjoin A {s}) _) := by
      intro r k r' hr hr'
      rw [Ideal.mem_comap]
      apply (HQ (algebraMap _ _ r) k (algebraMap _ _ r') hr).mpr
      rw [← Ideal.mem_comap, hQ'N]
      exact hr'
    have hsN : (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s})) ∈
        Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s}))} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hpN : 𝔭 ≤ (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).comap
          (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rw [h𝔭]
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        rw [SetLike.mem_coe, Ideal.mem_comap]
        have e1 : algebraMap A ↥(Algebra.adjoin A {s}) t =
            algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c) +
            ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) c := by
          rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
        rw [e1]
        exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.mem_sup_right
          (Ideal.mem_map_of_mem ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hx)
    have hNJ : Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) (t - algebraMap ↥W A c),
          (⟨s, hsR⟩ : ↥(Algebra.adjoin A {s}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≤
        Q.comap (algebraMap ↥(Algebra.adjoin A {s}) _) := by
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with hx | hx
        · rw [hx]
          refine memJ _ 0 (algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c))
            (by rw [pow_zero, one_mul]; rfl) ?_
          have e1 : algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c) =
              algebraMap A ↥(Algebra.adjoin A {s'}) (t - algebraMap ↥W A c') +
              ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) (c' - c) := by
            rw [RingHom.comp_apply, ← map_add]; congr 1; rw [map_sub]; ring
          rw [e1]
          exact add_mem (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
            (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (sub_mem hc' hc)))
        · rw [Set.mem_singleton_iff] at hx
          rw [hx]
          refine memJ _ 1 ⟨s', hs'R⟩ ?_ hs'N
          show algebraMap K L s' = algebraMap K L (1 - ω * s') ^ 1 * algebraMap K L s
          rw [pow_one, ← map_mul, I6]
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap]
        refine memJ _ 0 (algebraMap A ↥(Algebra.adjoin A {s'}) (algebraMap ↥W A x))
          (by rw [pow_zero, one_mul]; rfl) ?_
        exact Ideal.mem_sup_right
          (Ideal.mem_map_of_mem ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)) hx)
    have hJ : Q.comap (algebraMap ↥(Algebra.adjoin A {s}) _) ≠ ⊤ := Ideal.comap_ne_top _ hQ.ne_top
    have hQN := s2 s _ _ hsN hpN hNJ hJ
    have hnb := hsep Q hQN
    intro hb
    apply hnb
    refine (s7 L
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) ↥(Algebra.adjoin A {s'}) Q Q' e ?_ ?_).mpr hb
    · intro x y hxy
      exact he x y hxy
    · intro x _
      exact ⟨Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin A {s}) L)
          (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A x)),
        Subalgebra.algebraMap_mem (integralClosure ↥(Algebra.adjoin A {s'}) L)
          (algebraMap A ↥(Algebra.adjoin A {s'}) (algebraMap ↥W A x))⟩
  intro c c' b hc hc' _ _ hdvd
  exact ⟨key c c' b hc hc' hdvd, key c' c b hc' hc (dvd_sub_comm.mp hdvd)⟩

theorem wcpa_dj_llsm_sd_normalization_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (E : Type u) [Field E] [Algebra K E] [FiniteDimensional K E]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k → ∀ (s : K),
    Module.Finite ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E) :=
by
  intro Ω _ _ W hW _hWt A _ _ _ K _ _ _ E _ _ _ 𝔭 k hPD s
  classical
  obtain ⟨hAft, hAnz, -⟩ := hPD
  set D := Algebra.adjoin A {s} with hD

  have hWA : Function.Injective (algebraMap W A) := by
    intro x y hxy
    rw [← sub_eq_zero]
    have h : (x - y) • (1 : A) = 0 := by
      rw [Algebra.smul_def, map_sub, hxy, sub_self, zero_mul]
    rcases smul_eq_zero.mp h with h | h
    · exact h
    · exact absurd h one_ne_zero
  obtain ⟨ι₀, hι₀⟩ : ∃ ι₀ : W →+* K, ι₀ = (algebraMap A K).comp (algebraMap W A) := ⟨_, rfl⟩
  have hι₀inj : Function.Injective ι₀ := by
    rw [hι₀]; exact (IsFractionRing.injective A K).comp hWA

  let φ : Ω →+* K := IsFractionRing.lift (K := Ω) hι₀inj
  have hφ : ∀ c : W, φ (c : Ω) = ι₀ c := fun c => IsFractionRing.lift_algebraMap hι₀inj c
  letI : Algebra Ω K := φ.toAlgebra
  letI : Algebra Ω E := ((algebraMap K E).comp φ).toAlgebra
  haveI : IsScalarTower Ω K E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI : Algebra W D := ((algebraMap A D).comp (algebraMap W A)).toAlgebra
  haveI : IsScalarTower W A D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hfc : ∀ c : W, algebraMap D K (algebraMap W D c) = ι₀ c := fun c => by
    rw [hι₀]; rfl
  have hfcΩ : ∀ c : W, algebraMap D K (algebraMap W D c) = algebraMap Ω K (c : Ω) := fun c => by
    rw [hfc]; exact (hφ c).symm

  have hDft : Algebra.FiniteType A D :=
    (Subalgebra.fg_iff_finiteType D).mp ⟨{s}, by rw [Finset.coe_singleton]⟩
  have hWD : Algebra.FiniteType W D := Algebra.FiniteType.trans hAft hDft

  obtain ⟨G, hG⟩ := hWD.out
  obtain ⟨T, hT⟩ : ∃ T : Subalgebra Ω K, T = Algebra.adjoin Ω (Set.range (algebraMap D K)) :=
    ⟨_, rfl⟩
  have hTeq : T = Algebra.adjoin Ω ((G.image (algebraMap D K) : Finset K) : Set K) := by
    apply le_antisymm
    · rw [hT, Algebra.adjoin_le_iff]
      rintro _ ⟨r, rfl⟩
      have hr : r ∈ Algebra.adjoin W (G : Set D) := by rw [hG]; trivial
      induction hr using Algebra.adjoin_induction with
      | mem x hx =>
        exact Algebra.subset_adjoin (Finset.mem_coe.mpr
          (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx)))
      | algebraMap c =>
        rw [hfcΩ]
        exact Subalgebra.algebraMap_mem _ _
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
    · rw [hT]
      apply Algebra.adjoin_mono
      intro x hx
      rw [Finset.coe_image] at hx
      obtain ⟨r, _, rfl⟩ := hx
      exact ⟨r, rfl⟩
  have hTft : Algebra.FiniteType Ω T := (Subalgebra.fg_iff_finiteType T).mp ⟨_, hTeq.symm⟩

  have hden : ∀ x ∈ T, ∃ c : W, c ≠ 0 ∧ ι₀ c * x ∈ Set.range (algebraMap D K) := by
    intro x hx
    rw [hT] at hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨r, rfl⟩ := hx
      exact ⟨1, one_ne_zero, r, by rw [map_one, one_mul]⟩
    | algebraMap ω =>
      by_cases hω : ω ∈ W
      · refine ⟨1, one_ne_zero, algebraMap W D ⟨ω, hω⟩, ?_⟩
        rw [map_one, one_mul, hfcΩ]
      · have hω0 : ω ≠ 0 := fun h => hω (h ▸ W.zero_mem)
        have hinv : ω⁻¹ ∈ W := (W.mem_or_inv_mem ω).resolve_left hω
        refine ⟨⟨ω⁻¹, hinv⟩, fun h => inv_ne_zero hω0 (congrArg Subtype.val h), 1, ?_⟩
        rw [map_one, ← hφ]
        show (1 : K) = φ ω⁻¹ * φ ω
        rw [← map_mul, inv_mul_cancel₀ hω0, map_one]
    | add x y _ _ hx hy =>
      obtain ⟨c₁, hc₁, r₁, hr₁⟩ := hx
      obtain ⟨c₂, hc₂, r₂, hr₂⟩ := hy
      refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, algebraMap W D c₂ * r₁ + algebraMap W D c₁ * r₂, ?_⟩
      rw [map_add, map_mul, map_mul, hr₁, hr₂, hfc, hfc, map_mul]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨c₁, hc₁, r₁, hr₁⟩ := hx
      obtain ⟨c₂, hc₂, r₂, hr₂⟩ := hy
      refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, r₁ * r₂, ?_⟩
      rw [map_mul, hr₁, hr₂, map_mul]
      ring

  haveI : FaithfulSMul T K :=
    (faithfulSMul_iff_algebraMap_injective T K).mpr Subtype.val_injective
  have hfT : ∀ a : A, algebraMap A K a ∈ T := fun a => by
    rw [hT]; exact Algebra.subset_adjoin ⟨algebraMap A D a, rfl⟩
  haveI hTfrac : IsFractionRing T K := IsFractionRing.of_field T K (fun z => by
    obtain ⟨x, y, _, hxy⟩ := IsFractionRing.div_surjective (A := A) z
    exact ⟨⟨_, hfT x⟩, ⟨_, hfT y⟩, hxy.symm⟩)

  haveI := hTft
  have hNfin : Module.Finite T (integralClosure T E) :=
    wc_sf_integralClosure_finite_of_embedding Ω T K E E (AlgHom.id T E) (fun _ _ h => h)
      noether_integralClosure_finite
  obtain ⟨N, hN⟩ : ∃ N : Subalgebra T E, N = integralClosure T E := ⟨_, rfl⟩
  have hmemN : ∀ x : E, x ∈ N ↔ IsIntegral T x := fun x => by rw [hN]; rfl
  rw [← hN] at hNfin
  have hNft : Algebra.FiniteType Ω N :=
    Algebra.FiniteType.trans hTft (Module.Finite.finiteType (R := T) N)
  letI : Algebra W N := ((algebraMap Ω N).comp (algebraMap W Ω)).toAlgebra
  haveI : IsScalarTower W Ω N := IsScalarTower.of_algebraMap_eq (fun _ => rfl)

  let ρ : D →+* T := RingHom.codRestrict (algebraMap D K) T
    (fun d => by rw [hT]; exact Algebra.subset_adjoin ⟨d, rfl⟩)
  have hρE : ∀ d : D, algebraMap T E (ρ d) = algebraMap D E d := fun d => rfl
  have hDN : ∀ d : D, algebraMap D E d ∈ N := fun d => by
    rw [hmemN, ← hρE]; exact isIntegral_algebraMap
  let ψ : D →+* N := RingHom.codRestrict (algebraMap D E) N hDN
  letI : Algebra D N := ψ.toAlgebra
  have hWDN : IsScalarTower W D N := IsScalarTower.of_algebraMap_eq (fun c => by
    apply Subtype.ext
    show algebraMap K E (φ (c : Ω)) = algebraMap K E (algebraMap D K (algebraMap W D c))
    rw [hφ, hfc])
  let j : N →ₐ[D] E := { toRingHom := (N.val : N →+* E), commutes' := fun _ => rfl }
  have hj : Function.Injective j := Subtype.val_injective

  choose! cf hcf0 hcf using hden
  have hgen : ∀ b : N, ∃ c : W, c ≠ 0 ∧ IsIntegral D (algebraMap W N c * b) := by
    intro b
    obtain ⟨p, hpm, hp⟩ := (hmemN (b : E)).mp b.2
    set n := p.natDegree with hn
    refine ⟨∏ i ∈ Finset.range n, cf (p.coeff i : K),
      Finset.prod_ne_zero_iff.mpr (fun i _ => hcf0 _ (p.coeff i).2), ?_⟩
    set c := ∏ i ∈ Finset.range n, cf (p.coeff i : K) with hc
    have hγmem : ι₀ c ∈ T := by
      have : ι₀ c = algebraMap A K (algebraMap W A c) := by rw [hι₀]; rfl
      rw [this]; exact hfT _
    set γ : T := ⟨ι₀ c, hγmem⟩ with hγ
    have hrange : ∀ x : T, (x : K) ∈ Set.range (algebraMap D K) → x ∈ Set.range ρ := by
      rintro x ⟨d, hd⟩
      exact ⟨d, Subtype.ext hd⟩
    have hι₀r : ∀ c' : W, ι₀ c' ∈ Set.range (algebraMap D K) := fun c' => ⟨_, hfc c'⟩
    have hlift : p.scaleRoots γ ∈ Polynomial.lifts ρ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots]
      apply hrange
      by_cases hi : i < n
      · obtain ⟨e, he⟩ := Finset.dvd_prod_of_mem (fun i => cf (p.coeff i : K))
          (Finset.mem_range.mpr hi)
        obtain ⟨m, hm⟩ : ∃ m, n - i = m + 1 := ⟨n - i - 1, by omega⟩
        have hval : ((p.coeff i * γ ^ (n - i) : T) : K) =
            (ι₀ (cf (p.coeff i : K)) * (p.coeff i : K)) * ι₀ e * (ι₀ c) ^ m := by
          rw [hm, Subalgebra.coe_mul, Subalgebra.coe_pow]
          show (p.coeff i : K) * (ι₀ c) ^ (m + 1) = _
          have hce : ι₀ c = ι₀ (cf (p.coeff i : K)) * ι₀ e := by rw [hc, he, map_mul]
          rw [pow_succ, hce]
          ring
        rw [hval]
        obtain ⟨d₁, hd₁⟩ := hcf _ (p.coeff i).2
        obtain ⟨d₂, hd₂⟩ := hι₀r e
        obtain ⟨d₃, hd₃⟩ := hι₀r c
        exact ⟨d₁ * d₂ * d₃ ^ m, by rw [map_mul, map_mul, map_pow, hd₁, hd₂, hd₃]⟩
      · have hni : n - i = 0 := by omega
        rw [hni, pow_zero, mul_one]
        rcases (Nat.le_of_not_lt hi).eq_or_lt with h | h
        · rw [← h, hn, hpm.coeff_natDegree]
          exact ⟨1, by rw [map_one]; rfl⟩
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [← hn]; exact h)]
          exact ⟨0, by rw [map_zero]; rfl⟩
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff γ).mpr hpm)
    have hroot := Polynomial.scaleRoots_eval₂_eq_zero (algebraMap T E) (s := γ) hp
    rw [← hqmap, Polynomial.eval₂_map] at hroot
    have hint : IsIntegral D (algebraMap T E γ * (b : E)) := ⟨q, hqm, hroot⟩
    rw [← isIntegral_algHom_iff j hj]
    have : j (algebraMap W N c * b) = algebraMap T E γ * (b : E) := by
      show algebraMap K E (φ (c : Ω)) * (b : E) = algebraMap K E (ι₀ c) * (b : E)
      rw [hφ]
    rw [this]
    exact hint

  have hnfr : Algebra.FiniteType D (integralClosure D N) :=
    wcpa_dj_lr1s_nf_ring_reduction Ω W hW D N hWD hNft inferInstance hgen

  let J : integralClosure D N →ₐ[D] integralClosure D E :=
    (j.comp (integralClosure D N).val).codRestrict (integralClosure D E)
      (fun x => x.2.map j)
  have hJ : Function.Surjective J := by
    intro y
    have hyT : IsIntegral T (y : E) := by
      have := IsIntegral.map_of_comp_eq (T := T) (U := E) ρ (RingHom.id E)
        (RingHom.ext fun d => rfl) y.2
      exact this
    let b : N := ⟨y, (hmemN _).mpr hyT⟩
    have hb : IsIntegral D b := (isIntegral_algHom_iff j hj).mp y.2
    exact ⟨⟨b, hb⟩, Subtype.ext rfl⟩
  haveI : Algebra.FiniteType D (integralClosure D E) := hnfr.of_surjective J hJ
  exact Algebra.IsIntegral.finite

theorem wcpa_dj_llsm_sdg_chart_ring : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k → ∀ (s : K),
    Module.Finite ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →
    (wcSdgJ W A K L s).FiniteType ∧ (wcSdgJ W A K L s).Flat ∧
      Function.Injective (wcSdgJ W A K L s) ∧
      IsIntegrallyClosed ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 k hPD s hfin
  classical
  have hFT : Algebra.FiniteType ↥W A := hPD.1
  have hNZ : NoZeroSMulDivisors ↥W A := hPD.2.1

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    rcases eq_zero_or_eq_zero_of_smul_eq_zero hw with h | h
    · exact h
    · exact absurd h one_ne_zero

  have hinj : Function.Injective (wcSdgJ W A K L s) := by
    intro x y hxy
    have h1 : ((wcSdgJ W A K L s x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) =
        ((wcSdgJ W A K L s y : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) := by
      rw [hxy]
    have h2 : ∀ w : ↥W, ((wcSdgJ W A K L s w : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) =
        algebraMap K L (algebraMap A K (algebraMap ↥W A w)) := fun w => rfl
    rw [h2, h2] at h1
    exact hWA (IsFractionRing.injective A K ((algebraMap K L).injective h1))

  have hFTj : (wcSdgJ W A K L s).FiniteType := by
    have ha : (algebraMap ↥W A).FiniteType := RingHom.finiteType_algebraMap.mpr hFT
    have hb : (algebraMap A ↥(Algebra.adjoin A {s})).FiniteType :=
      RingHom.finiteType_algebraMap.mpr
        (Algebra.FiniteType.adjoin_of_finite (Set.finite_singleton s))
    have hc : (algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).FiniteType :=
      RingHom.Finite.finiteType (RingHom.finite_algebraMap.mpr hfin)
    exact RingHom.FiniteType.comp hc (RingHom.FiniteType.comp hb ha)

  have hFl : (wcSdgJ W A K L s).Flat := by
    letI := (wcSdgJ W A K L s).toAlgebra
    show Module.Flat ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
    intro x hx
    rw [Submodule.mem_torsion_iff] at hx
    obtain ⟨a, ha⟩ := hx
    rw [Submonoid.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra] at ha
    have ha0 : (a : ↥W) ≠ 0 := nonZeroDivisors.ne_zero a.2
    have hja : wcSdgJ W A K L s a ≠ 0 := fun h => ha0 (hinj (h.trans (map_zero _).symm))
    exact (mul_eq_zero.mp ha).resolve_left hja

  have hfr : IsFractionRing ↥(Algebra.adjoin A {s}) K := by
    refine IsFractionRing.of_field _ K ?_
    intro z
    obtain ⟨x, y, _, hxy⟩ := IsFractionRing.div_surjective (A := A) z
    exact ⟨algebraMap A _ x, algebraMap A _ y, hxy.symm⟩

  have hIC : IsIntegrallyClosed ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension K
  exact ⟨hFTj, hFl, hinj, hIC⟩

theorem wcpa_dj_llsm_sdg_fibre_dim : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b ∣ g ∧ z0 = u)) →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0 →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Q.IsPrime],
    Q.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    Module.Finite ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →
    Q.IsMaximal ∧ Q.comap (wcSdgJ W A K L s) = IsLocalRing.maximalIdeal ↥W ∧
      ringKrullDim (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
        ↥(Algebra.adjoin A {s}) Q) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 k hPD z0 b hb hb0 hshape s hs Q _ hQ _
  classical

  have s6 : ∀ (V R : Type u) [CommRing V] [IsLocalRing V] [CommRing R] (φ : V →+* R),
      φ.FiniteType → IsNoetherianRing (R ⧸ (IsLocalRing.maximalIdeal V).map φ) := by
    intro V R _ _ _ φ hφ
    let g : IsLocalRing.ResidueField V →+* R ⧸ (IsLocalRing.maximalIdeal V).map φ :=
      Ideal.quotientMap ((IsLocalRing.maximalIdeal V).map φ) φ Ideal.le_comap_map
    have hg : g.comp (IsLocalRing.residue V) =
        (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal V).map φ)).comp φ :=
      Ideal.quotientMap_comp_mk _
    have h1 : ((Ideal.Quotient.mk ((IsLocalRing.maximalIdeal V).map φ)).comp φ).FiniteType :=
      RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective) hφ
    rw [← hg] at h1
    have h2 : g.FiniteType := RingHom.FiniteType.of_comp_finiteType h1
    letI := g.toAlgebra
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField V)
        (R ⧸ (IsLocalRing.maximalIdeal V).map φ) := h2
    exact Algebra.FiniteType.isNoetherianRing (IsLocalRing.ResidueField V)
      (R ⧸ (IsLocalRing.maximalIdeal V).map φ)

  have s7 : ∀ (R : Type u) [CommRing R] (M : Ideal R), IsNoetherianRing (R ⧸ M) → ∀ (x y : R),
      x * y ∈ M → (Ideal.span {x, y} ⊔ M).IsPrime → ∀ (p0 p1 p2 : Ideal R), p0.IsPrime →
      p1.IsPrime → p2.IsPrime → M ≤ p0 → p0 < p1 → p1 < p2 → p2 ≤ Ideal.span {x, y} ⊔ M →
      False := by
    intro R _ M hN x y hxy hNp p0 p1 p2 hp0 hp1 hp2 hM h01 h12 h2N
    set π := Ideal.Quotient.mk M with hπ
    have hsurj : Function.Surjective π := Ideal.Quotient.mk_surjective
    have hker : RingHom.ker π = M := Ideal.mk_ker
    have hcm : ∀ I : Ideal R, M ≤ I → (I.map π).comap π = I := by
      intro I hI
      rw [Ideal.comap_map_of_surjective' π hsurj, hker, sup_eq_left.mpr hI]
    have hpr : ∀ I : Ideal R, I.IsPrime → M ≤ I → (I.map π).IsPrime := by
      intro I hI hMI
      exact Ideal.map_isPrime_of_surjective hsurj (by rw [hker]; exact hMI)
    have hlt : ∀ I J : Ideal R, M ≤ I → M ≤ J → I < J → I.map π < J.map π := by
      intro I J hI hJ hIJ
      refine lt_of_le_of_ne (Ideal.map_mono hIJ.le) ?_
      intro h
      apply hIJ.ne
      rw [← hcm I hI, ← hcm J hJ, h]
    have hM1 : M ≤ p1 := hM.trans h01.le
    have hM2 : M ≤ p2 := hM1.trans h12.le
    have hMN : M ≤ Ideal.span {x, y} ⊔ M := le_sup_right
    set Nb := (Ideal.span {x, y} ⊔ M).map π with hNb
    have hNbp : Nb.IsPrime := hpr _ hNp hMN
    have hNbeq : Nb = Ideal.span {π x, π y} := by
      rw [hNb, Ideal.map_sup, Ideal.map_span, Set.image_pair, hπ, Ideal.map_quotient_self,
        sup_bot_eq]
    have hxy0 : π x * π y = 0 := by
      rw [← map_mul]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hxy
    have hmin : Nb ∈ (Ideal.span {π x + π y}).minimalPrimes := by
      rw [Ideal.minimalPrimes, Set.mem_setOf_eq, Ideal.IsMinimalPrime, Minimal]
      refine ⟨⟨hNbp, ?_⟩, ?_⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff, hNbeq]
        exact Ideal.add_mem _ (Ideal.subset_span (by simp)) (Ideal.subset_span (by simp))
      · rintro P ⟨hP, hIP⟩ hPN
        have hs : π x + π y ∈ P := hIP (Ideal.mem_span_singleton_self _)
        have hx : π x ∈ P := by
          apply hP.mem_of_pow_mem 2
          have : π x ^ 2 = π x * (π x + π y) - π x * π y := by ring
          rw [this, hxy0, sub_zero]
          exact P.mul_mem_left _ hs
        have hy : π y ∈ P := by
          apply hP.mem_of_pow_mem 2
          have : π y ^ 2 = π y * (π x + π y) - π x * π y := by ring
          rw [this, hxy0, sub_zero]
          exact P.mul_mem_left _ hs
        rw [hNbeq, Ideal.span_le]
        intro z hz
        rcases hz with rfl | hz
        · exact hx
        · rw [Set.mem_singleton_iff] at hz; rw [hz]; exact hy
    have hht := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ Nb hmin
    have h1 : (p1.map π).height < 1 := by
      have := (Ideal.height_le_iff (p := Nb) (n := 1)).mp (by exact_mod_cast hht) (p1.map π)
        (hpr _ hp1 hM1) (lt_of_lt_of_le (hlt _ _ hM1 hM2 h12) (Ideal.map_mono h2N))
      exact_mod_cast this
    have h0 : (p0.map π).height < 0 := by
      haveI := hpr _ hp1 hM1
      have h1' : (p1.map π).height ≤ ((0 : ℕ) : ℕ∞) := by
        rw [Nat.cast_zero]; exact (Order.lt_one_iff.mp h1).le
      have := (Ideal.height_le_iff (p := p1.map π) (n := 0)).mp h1' (p0.map π)
        (hpr _ hp0 hM) (hlt _ _ hM hM1 h01)
      exact_mod_cast this
    exact not_lt_zero h0

  have s8 : ∀ (C : Type u) [CommRing C] (J Q : Ideal C) [Q.IsPrime],
      (∀ (P0 P1 P2 : Ideal C), P0.IsPrime → P1.IsPrime → P2.IsPrime → J ≤ P0 → P0 < P1 →
        P1 < P2 → P2 ≤ Q → False) →
      ringKrullDim (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) ≤
        ((1 : ℕ) : WithBot ℕ∞) := by
    intro C _ J Q _ H
    set ψ : C →+* (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) :=
      (Ideal.Quotient.mk _).comp (algebraMap C (Localization.AtPrime Q)) with hψ
    have hinj : Function.Injective (fun I : Ideal (Localization.AtPrime Q ⧸
        J.map (algebraMap C (Localization.AtPrime Q))) => I.comap ψ) := by
      intro I1 I2 h
      simp only [hψ] at h
      rw [← Ideal.comap_comap, ← Ideal.comap_comap] at h
      have h' := congrArg (Ideal.map (algebraMap C (Localization.AtPrime Q))) h
      rw [← Ideal.under_def, ← Ideal.under_def,
        IsLocalization.map_under Q.primeCompl, IsLocalization.map_under Q.primeCompl] at h'
      exact Ideal.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective h'
    have hlt : ∀ I1 I2 : Ideal (Localization.AtPrime Q ⧸
        J.map (algebraMap C (Localization.AtPrime Q))), I1 < I2 → I1.comap ψ < I2.comap ψ := by
      intro I1 I2 h
      exact lt_of_le_of_ne (Ideal.comap_mono h.le) (fun e => h.ne (hinj e))
    rw [ringKrullDim, Nat.cast_one, Order.krullDim_le_one_iff]
    intro x
    by_contra hx
    rw [not_or, not_isMin_iff, not_isMax_iff] at hx
    obtain ⟨⟨a, ha⟩, ⟨c, hc⟩⟩ := hx
    refine H (a.asIdeal.comap ψ) (x.asIdeal.comap ψ) (c.asIdeal.comap ψ)
      (Ideal.IsPrime.comap _) (Ideal.IsPrime.comap _) (Ideal.IsPrime.comap _) ?_
      (hlt _ _ ha) (hlt _ _ hc) ?_
    · intro z hz
      rw [Ideal.mem_comap]
      have : ψ z = 0 := by
        rw [hψ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_map_of_mem _ hz
      rw [this]; exact a.asIdeal.zero_mem
    · intro z hz
      by_contra hzQ
      have hu : IsUnit (algebraMap C (Localization.AtPrime Q) z) :=
        IsLocalization.map_units (Localization.AtPrime Q) (⟨z, hzQ⟩ : Q.primeCompl)
      have hu' : IsUnit (ψ z) := by
        rw [hψ, RingHom.comp_apply]; exact hu.map _
      exact c.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp hz) hu')

  have brrm : ∀ (𝔭 : Ideal A) (k : wcLlsKind W A) (z₀ : A) (b : ↥W),
      wcLlsPD W A 𝔭 k →
      ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ z₀ = t - algebraMap ↥W A c) ∨
        (∃ v g, k = .ann z₀ v g ∧ b ∣ g)) →
      ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀ →
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≠ ⊤ →
      (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).IsMaximal := by
    intro 𝔭 k z₀ b hPD hk s hs hNtop
    obtain ⟨N, hNdef⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}),
        N = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) := ⟨_, rfl⟩
    rw [← hNdef] at hNtop ⊢
    have hN1 : algebraMap A ↥(Algebra.adjoin A {s}) z₀ ∈ N := by
      rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hN2 : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ :
        ↥(Algebra.adjoin A {s})) ∈ N := by
      rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hN3 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ N := by
      intro w hw
      rw [hNdef]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hw)
    have hrep : ∀ (x₀ : K) (hx₀ : x₀ ∈ Algebra.adjoin A {s}), ∃ a : A,
        (⟨x₀, hx₀⟩ : ↥(Algebra.adjoin A {s})) - algebraMap A _ a ∈ N := by
      intro x₀ hx₀
      induction hx₀ using Algebra.adjoin_induction with
      | mem x hx =>
        refine ⟨0, ?_⟩
        have e : (⟨x, Algebra.subset_adjoin hx⟩ : ↥(Algebra.adjoin A {s})) =
            ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := Subtype.ext hx
        rw [map_zero, sub_zero, e]
        exact hN2
      | algebraMap r =>
        refine ⟨r, ?_⟩
        convert N.zero_mem using 1
        apply Subtype.ext
        simp
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a + a', ?_⟩
        convert N.add_mem ha ha' using 1
        apply Subtype.ext
        simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_algebraMap, map_add]
        ring
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨a', ha'⟩ := ihy
        refine ⟨a * a', ?_⟩
        convert N.add_mem (N.mul_mem_right (⟨y, hy⟩ : ↥(Algebra.adjoin A {s})) ha)
          (N.mul_mem_left (algebraMap A ↥(Algebra.adjoin A {s}) a) ha') using 1
        apply Subtype.ext
        simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_mul,
          Subalgebra.coe_algebraMap, map_mul]
        ring
    have hm : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
        N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      exact hN3 w hw
    obtain ⟨-, hnz, -, hmax, -, hcase⟩ := hPD
    haveI := hnz
    have hp : 𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
      rcases hk with ⟨t, c, rfl, hc, hz⟩ | ⟨v, g, rfl, hbg⟩
      · obtain ⟨-, h𝔭, -⟩ := hcase
        rw [h𝔭]
        refine sup_le ?_ hm
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e : t = z₀ + algebraMap ↥W A c := by rw [hz]; ring
        rw [e, map_add]
        exact N.add_mem hN1 (hN3 c hc)
      · obtain ⟨-, hg0, huv, h𝔭, -⟩ := hcase
        obtain ⟨q, hgq⟩ := hbg
        have hz0 : algebraMap A K z₀ ≠ 0 := by
          intro h
          have hz : z₀ = 0 := (IsFractionRing.injective A K) (by rw [h, map_zero])
          rw [hz, zero_mul, Algebra.algebraMap_eq_smul_one] at huv
          rcases smul_eq_zero.mp huv.symm with h1 | h1
          · exact hg0 h1
          · exact one_ne_zero h1
        have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A q) * s := by
          rw [hs]
          have e := congrArg (algebraMap A K) huv
          simp only [map_mul, hgq] at e
          rw [mul_div_assoc', eq_div_iff hz0]
          linear_combination e
        rw [h𝔭]
        refine sup_le ?_ hm
        rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rw [SetLike.mem_coe, Ideal.mem_comap]
        rcases hx with hx | hx
        · rw [hx]; exact hN1
        · have e : algebraMap A ↥(Algebra.adjoin A {s}) v =
              algebraMap A _ (algebraMap ↥W A q) *
                ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := by
            apply Subtype.ext
            simpa using hvK
          rw [hx, e]
          exact N.mul_mem_left _ hN2
    rw [Ideal.isMaximal_iff]
    refine ⟨fun h1 => hNtop ((Ideal.eq_top_iff_one N).mpr h1), ?_⟩
    intro J x hNJ hxN hxJ
    obtain ⟨a, ha⟩ := hrep x.1 x.2
    have ha' : x - algebraMap A _ a ∈ N := ha
    have ha𝔭 : a ∉ 𝔭 := by
      intro h
      apply hxN
      have := N.add_mem ha' (Ideal.mem_comap.mp (hp h))
      rwa [sub_add_cancel] at this
    obtain ⟨y, p', hp', hyp⟩ := hmax.exists_inv ha𝔭
    have e1 : (1 : ↥(Algebra.adjoin A {s})) = algebraMap A _ y * x -
        algebraMap A _ y * (x - algebraMap A _ a) + algebraMap A _ p' := by
      rw [← map_one (algebraMap A ↥(Algebra.adjoin A {s})), ← hyp, map_add, map_mul]; ring
    rw [e1]
    exact J.add_mem (J.sub_mem (J.mul_mem_left _ hxJ) (hNJ (N.mul_mem_left _ ha')))
      (hNJ (Ideal.mem_comap.mp (hp hp')))
  have hFT : Algebra.FiniteType ↥W A := by
    obtain ⟨h, -⟩ := hPD
    exact h
  have hk : (∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
      z0 = t - algebraMap ↥W A c) ∨ (∃ v g, k = .ann z0 v g ∧ b ∣ g) := by
    rcases hshape with h | ⟨u, v, g, hk, hbg, hz⟩
    · exact Or.inl h
    · exact Or.inr ⟨v, g, by rw [hz]; exact hk, hbg⟩
  have hNtop : Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≠ ⊤ := by
    rw [← hQ]; exact (Ideal.IsPrime.comap _).ne_top
  have hNmax := brrm 𝔭 k z0 b hPD hk s hs hNtop
  set φ : ↥W →+* ↥(Algebra.adjoin A {s}) :=
    (algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A) with hφ
  set N := Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map φ with hNdef

  have hint : (algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  have hQmax : Q.IsMaximal :=
    Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hint Q (by rw [hQ]; exact hNmax)

  have hQW : Q.comap (wcSdgJ W A K L s) = IsLocalRing.maximalIdeal ↥W := by
    have e : Q.comap (wcSdgJ W A K L s) = N.comap φ := by
      rw [← hQ, Ideal.comap_comap]
    rw [e]
    haveI := hNmax.isPrime
    apply le_antisymm
    · exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.comap φ).ne_top
    · rw [← Ideal.map_le_iff_le_comap, hNdef]
      exact le_sup_right

  have hφFT : φ.FiniteType :=
    RingHom.FiniteType.comp (RingHom.finiteType_algebraMap.mpr
      (Algebra.FiniteType.adjoin_of_finite (Set.finite_singleton s)))
      (RingHom.finiteType_algebraMap.mpr hFT)

  have hxy : algebraMap A ↥(Algebra.adjoin A {s}) z0 *
      ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ ∈ (IsLocalRing.maximalIdeal ↥W).map φ := by
    by_cases hz : algebraMap A K z0 = 0
    · have e : algebraMap A ↥(Algebra.adjoin A {s}) z0 *
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ = 0 := by
        apply Subtype.ext
        show algebraMap A K z0 * s = 0
        rw [hz, zero_mul]
      rw [e]; exact Submodule.zero_mem _
    · have e : algebraMap A ↥(Algebra.adjoin A {s}) z0 *
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ = φ b := by
        apply Subtype.ext
        show algebraMap A K z0 * s = algebraMap A K (algebraMap ↥W A b)
        rw [hs, mul_div_assoc', mul_div_cancel_left₀ _ hz]
      rw [e]; exact Ideal.mem_map_of_mem φ hb

  have hsl : ∀ P P' : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L), P.IsPrime → P < P' →
      P.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) <
        P'.comap (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) := by
    intro P P' hP hPP'
    obtain ⟨c, hc1, hc0⟩ := SetLike.exists_of_lt hPP'
    exact Ideal.under_lt_under_of_integral_mem_sdiff (R := ↥(Algebra.adjoin A {s})) (hI := hP)
      hPP'.le (x := c) ⟨hc1, hc0⟩ (Algebra.IsIntegral.isIntegral c)
  have hC : ∀ (P0 P1 P2 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)),
      P0.IsPrime → P1.IsPrime → P2.IsPrime →
      Ideal.span {c : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} ≤ P0 →
      P0 < P1 → P1 < P2 → P2 ≤ Q → False := by
    intro P0 P1 P2 h0 h1 h2 hJ h01 h12 h2Q
    refine s7 ↥(Algebra.adjoin A {s}) ((IsLocalRing.maximalIdeal ↥W).map φ)
      (s6 ↥W ↥(Algebra.adjoin A {s}) φ hφFT) _ _ hxy hNmax.isPrime
      (P0.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)))
      (P1.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)))
      (P2.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)))
      (by haveI := h0; exact Ideal.IsPrime.comap _) (by haveI := h1; exact Ideal.IsPrime.comap _)
      (by haveI := h2; exact Ideal.IsPrime.comap _) ?_ (hsl _ _ h0 h01) (hsl _ _ h1 h12) ?_
    · rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap]
      intro w hw
      apply hJ
      apply Ideal.subset_span
      exact ⟨w, hw, rfl⟩
    · exact (Ideal.comap_mono h2Q).trans hQ.le

  refine ⟨hQmax, hQW, ?_⟩
  exact s8 _ _ Q hC

theorem wcpa_dj_llsm_sdg_pd_not_surj : ∀ {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A)
    (k : wcLlsKind W A), wcLlsPD W A 𝔭 k → ¬ Function.Surjective (algebraMap ↥W A) :=
by
  intro Ω _ _ W A _ _ _ 𝔭 k hPD hsurj

  have rigid : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), f.Etale →
      ∀ (ψ : R →+* DualNumber S), (∀ r, TrivSqZeroExt.fst (ψ r) = f r) →
      ∀ r, f r = 0 → ψ r = 0 := by
    intro R S _ _ f hf ψ hψ r hr
    letI : Algebra R S := f.toAlgebra
    haveI : Algebra.Etale R S := hf
    letI : Algebra R (DualNumber S) := ψ.toAlgebra
    let g : DualNumber S →ₐ[R] S :=
      { (TrivSqZeroExt.fstHom S S S).toRingHom with
        commutes' := fun r => hψ r }
    have hgsurj : Function.Surjective g := fun x => ⟨TrivSqZeroExt.inl x, rfl⟩
    have hnil : IsNilpotent (RingHom.ker g) := by
      have e : RingHom.ker g * RingHom.ker g = ⊥ := by
        rw [← le_bot_iff]
        refine Ideal.mul_le.mpr ?_
        intro x hx y hy
        rw [RingHom.mem_ker] at hx hy
        change TrivSqZeroExt.fst x = 0 at hx
        change TrivSqZeroExt.fst y = 0 at hy
        rw [Ideal.mem_bot]
        refine TrivSqZeroExt.ext ?_ ?_
        · simp [TrivSqZeroExt.fst_mul, hx]
        · simp [TrivSqZeroExt.snd_mul, hx, hy]
      refine ⟨2, ?_⟩
      calc RingHom.ker g ^ 2 = RingHom.ker g * RingHom.ker g := pow_two _
        _ = ⊥ := e
        _ = 0 := rfl
    let s := Algebra.FormallySmooth.liftOfSurjective (AlgHom.id R S) g hgsurj hnil
    have h1 : s (f r) = ψ r := s.commutes r
    rw [← h1, hr, map_zero]

  have polyDual : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] (f : Polynomial R →+* S),
      ∃ ψ : Polynomial R →+* DualNumber S, (∀ p, TrivSqZeroExt.fst (ψ p) = f p) ∧
        (∀ c, ψ (Polynomial.C c) = TrivSqZeroExt.inl (f (Polynomial.C c))) ∧
        ψ Polynomial.X = TrivSqZeroExt.inl (f Polynomial.X) + DualNumber.eps := by
    intro R _ S _ f
    refine ⟨Polynomial.eval₂RingHom ((TrivSqZeroExt.inlHom S S).comp (f.comp Polynomial.C))
      (TrivSqZeroExt.inl (f Polynomial.X) + DualNumber.eps), ?_, ?_, ?_⟩
    · intro p
      have : (TrivSqZeroExt.fstHom S S S).toRingHom.comp
          (Polynomial.eval₂RingHom ((TrivSqZeroExt.inlHom S S).comp (f.comp Polynomial.C))
            (TrivSqZeroExt.inl (f Polynomial.X) + DualNumber.eps)) = f := by
        apply Polynomial.ringHom_ext
        · intro a; simp
        · simp
      exact RingHom.congr_fun this p
    · intro c; simp
    · simp

  have nodeDual : ∀ (R : Type u) [CommRing R] (g : R) (S : Type u) [CommRing S]
      (f : (MvPolynomial (Fin 2) R ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* S),
      ∃ ψ : (MvPolynomial (Fin 2) R ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* DualNumber S,
        (∀ p, TrivSqZeroExt.fst (ψ p) = f p) ∧
        (∀ c, ψ (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
          TrivSqZeroExt.inl (f (Ideal.Quotient.mk _ (MvPolynomial.C c)))) ∧
        ψ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
          TrivSqZeroExt.inl (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) +
            TrivSqZeroExt.inr (f (Ideal.Quotient.mk _ (MvPolynomial.X 0))) := by
    intro R _ g S _ f
    have hab : f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g}) (MvPolynomial.X 0)) *
        f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g}) (MvPolynomial.X 1)) =
        f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g}) (MvPolynomial.C g)) := by
      have h0 : Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) R)})
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, sub_eq_zero] at h0
      rw [← map_mul, ← map_mul, h0]
    set a := f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g}) (MvPolynomial.X 0)) with ha
    set b := f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g}) (MvPolynomial.X 1)) with hb
    let ψ₀ : MvPolynomial (Fin 2) R →+* DualNumber S :=
      MvPolynomial.eval₂Hom ((TrivSqZeroExt.inlHom S S).comp (f.comp
        ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
        ![TrivSqZeroExt.inl a + TrivSqZeroExt.inr a, TrivSqZeroExt.inl b - TrivSqZeroExt.inr b]
    have hgen : ψ₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 := by
      simp only [ψ₀, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply,
        TrivSqZeroExt.inlHom_apply]
      refine TrivSqZeroExt.ext ?_ ?_
      · simp [TrivSqZeroExt.fst_mul, hab]
      · simp [TrivSqZeroExt.snd_mul, mul_comm]
    have hker : ∀ x ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g :
        MvPolynomial (Fin 2) R)}, ψ₀ x = 0 := by
      intro x hx
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      rw [map_mul, hgen, mul_zero]
    refine ⟨Ideal.Quotient.lift _ ψ₀ hker, ?_, ?_, ?_⟩
    · intro p
      have : (TrivSqZeroExt.fstHom S S S).toRingHom.comp (Ideal.Quotient.lift _ ψ₀ hker) = f := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r; simp [ψ₀]
        · intro i
          fin_cases i
          · simp [ψ₀, ha]
          · simp [ψ₀, hb]
      exact RingHom.congr_fun this p
    · intro c; simp [ψ₀]
    · simp [ψ₀]

  cases k with
  | disc t =>
    simp only [wcLlsPD] at hPD
    obtain ⟨_, _, _, _, _, _, _, h, hh, f, hfC, hfX, hfet⟩ := hPD
    have hh0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
    have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
      IsLocalization.injective (Localization.Away h)
        (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    have hne : (1 : Localization.Away h) ≠ 0 := by
      intro e
      apply one_ne_zero (α := A)
      apply hinj
      rw [map_one, map_zero]
      exact e
    obtain ⟨w, hw⟩ := hsurj t
    obtain ⟨ψ, hψf, hψC, hψX⟩ := polyDual ↥W (Localization.Away h) f
    have hfr : f (Polynomial.X - Polynomial.C w) = 0 := by
      rw [map_sub, hfX, ← hw, sub_eq_zero]
      exact (RingHom.congr_fun hfC w).symm
    have h0 := rigid _ _ f hfet ψ hψf _ hfr
    have h1 := congrArg TrivSqZeroExt.snd h0
    rw [map_sub, hψX, hψC] at h1
    apply hne
    simpa using h1
  | ann u v g =>
    simp only [wcLlsPD] at hPD
    obtain ⟨_, hNZ, _, _, _, _, hg0, huv, _, h, hh, f, hfC, hfX₀, _, hfet⟩ := hPD
    have hh0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
    have hinj : Function.Injective (algebraMap A (Localization.Away h)) :=
      IsLocalization.injective (Localization.Away h)
        (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    obtain ⟨w, hw⟩ := hsurj u
    obtain ⟨ψ, hψf, hψC, hψX₀⟩ := nodeDual ↥W g (Localization.Away h) f
    have hfr : f (Ideal.Quotient.mk _ (MvPolynomial.X 0) -
        Ideal.Quotient.mk _ (MvPolynomial.C w)) = 0 := by
      rw [map_sub, hfX₀, ← hw, sub_eq_zero]
      exact (RingHom.congr_fun hfC w).symm
    have h0 := rigid _ _ f hfet ψ hψf _ hfr
    have h1 := congrArg TrivSqZeroExt.snd h0
    rw [map_sub, hψX₀, hψC] at h1
    simp only [TrivSqZeroExt.snd_sub, TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl,
      TrivSqZeroExt.snd_inr, TrivSqZeroExt.snd_zero, zero_add, sub_zero] at h1
    rw [hfX₀] at h1
    have hu : u = 0 := hinj (by rw [h1, map_zero])
    have hg : algebraMap ↥W A g = 0 := by rw [← huv, hu, zero_mul]
    haveI := hNZ
    rw [Algebra.algebraMap_eq_smul_one] at hg
    rcases smul_eq_zero.mp hg with h2 | h2
    · exact hg0 h2
    · exact one_ne_zero h2

theorem wcpa_dj_llsm_sdg_not_isolated : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b ∣ g ∧ z0 = u)) →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0 →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Q.IsPrime],
    Q.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    Module.Finite ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →
    Q.IsMaximal → Q.comap (wcSdgJ W A K L s) = IsLocalRing.maximalIdeal ↥W →
    ¬ Function.Surjective (algebraMap ↥W A) →
    ((1 : ℕ) : WithBot ℕ∞) ≤
      ringKrullDim (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
        ↥(Algebra.adjoin A {s}) Q) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 k hPD z0 b hb hb0 hshape s hs Q _ hQ hfin hQmax
    hQW hns
  classical

  have t_chain : ∀ (C : Type u) [CommRing C] (Q : Ideal C) [Q.IsPrime] (J P : Ideal C),
      P.IsPrime → J ≤ P → P ≤ Q → P ≠ Q → ((1 : ℕ) : WithBot ℕ∞) ≤
        ringKrullDim (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) := by
    intro C _ Q _ J P hP hJP hPQ hne
    set ι := algebraMap C (Localization.AtPrime Q)
    set π := Ideal.Quotient.mk (J.map ι)
    have hdP : Disjoint (Q.primeCompl : Set C) (P : Set C) := by
      rw [Set.disjoint_left]; intro x hx hxP; exact hx (hPQ hxP)
    have hdQ : Disjoint (Q.primeCompl : Set C) (Q : Set C) := by
      rw [Set.disjoint_left]; intro x hx hxQ; exact hx hxQ
    haveI hP' : (P.map ι).IsPrime := IsLocalization.isPrime_of_isPrime_disjoint _ _ P hP hdP
    haveI hQ' : (Q.map ι).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint _ _ Q inferInstance hdQ
    have cP : (P.map ι).comap ι = P := IsLocalization.comap_map_of_isPrime_disjoint _ _ hP hdP
    have cQ : (Q.map ι).comap ι = Q :=
      IsLocalization.comap_map_of_isPrime_disjoint _ _ inferInstance hdQ
    have hk : RingHom.ker π = J.map ι := Ideal.mk_ker
    have hkP : RingHom.ker π ≤ P.map ι := by rw [hk]; exact Ideal.map_mono hJP
    have hkQ : RingHom.ker π ≤ Q.map ι := by rw [hk]; exact Ideal.map_mono (hJP.trans hPQ)
    haveI h1 : ((P.map ι).map π).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hkP
    haveI h2 : ((Q.map ι).map π).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hkQ
    have c1 : ((P.map ι).map π).comap π = P.map ι := by
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective]; exact sup_eq_left.mpr hkP
    have c2 : ((Q.map ι).map π).comap π = Q.map ι := by
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective]; exact sup_eq_left.mpr hkQ
    have hlt : (⟨(P.map ι).map π, h1⟩ : PrimeSpectrum _) < ⟨(Q.map ι).map π, h2⟩ := by
      apply lt_of_le_of_ne
      · show (P.map ι).map π ≤ (Q.map ι).map π
        exact Ideal.map_mono (Ideal.map_mono hPQ)
      · intro h
        apply hne
        have h' : (P.map ι).map π = (Q.map ι).map π := congrArg PrimeSpectrum.asIdeal h
        have h'' : P.map ι = Q.map ι := by rw [← c1, ← c2, h']
        exact cP.symm.trans ((congrArg (Ideal.comap ι) h'').trans cQ)
    rw [Nat.cast_one]
    exact Order.one_le_krullDim_iff.mpr ⟨_, _, hlt⟩

  have t_integral : ∀ (C : Type u) [CommRing C] [IsDomain C] (j : ↥W →+* C),
      Function.Injective j → ∀ y : C, j.IsIntegralElem y → ∃ w : ↥W, j w = y := by
    intro C _ _ j hj y hy
    obtain ⟨p, hpm, hpy⟩ := hy
    have hlam : Function.Injective (algebraMap C (FractionRing C)) :=
      IsFractionRing.injective C (FractionRing C)
    have hg : Function.Injective ((algebraMap C (FractionRing C)).comp j) := hlam.comp hj
    obtain ⟨ι, hι⟩ : ∃ ι : Ω →+* FractionRing C, ∀ w : ↥W,
        ι (algebraMap W Ω w) = algebraMap C (FractionRing C) (j w) :=
      ⟨IsFractionRing.lift (A := ↥W) (K := Ω) hg, fun w => IsFractionRing.lift_algebraMap hg w⟩
    have hιc : ι.comp (algebraMap W Ω) = (algebraMap C (FractionRing C)).comp j := RingHom.ext hι
    have hp'm : (p.map (algebraMap W Ω)).Monic := hpm.map _
    have hfac := Polynomial.Splits.eq_prod_roots_of_monic
      (IsAlgClosed.splits (p.map (algebraMap W Ω))) hp'm
    have he1 : Polynomial.eval₂ ι (algebraMap C (FractionRing C) y)
        (p.map (algebraMap W Ω)) = 0 := by
      rw [Polynomial.eval₂_map, hιc, ← Polynomial.hom_eval₂, hpy, map_zero]
    rw [hfac, Polynomial.eval₂_multiset_prod, Multiset.map_map, Multiset.prod_eq_zero_iff] at he1
    obtain ⟨ω, hω, hω0⟩ := Multiset.mem_map.mp he1
    simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
      Polynomial.eval₂_C] at hω0
    have hωroot : Polynomial.eval ω (p.map (algebraMap W Ω)) = 0 :=
      (Polynomial.mem_roots hp'm.ne_zero).mp hω
    have hωint : IsIntegral W ω := ⟨p, hpm, by rw [← Polynomial.eval_map]; exact hωroot⟩
    obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp hωint
    refine ⟨w, hlam ?_⟩
    rw [← hι, hw]
    exact (sub_eq_zero.mp hω0).symm

  have t_isolating : ∀ (C : Type u) [CommRing C] (I Q : Ideal C), IsNoetherianRing (C ⧸ I) →
      Q.IsMaximal → I ≤ Q → (∀ P : Ideal C, P.IsPrime → I ≤ P → P ≤ Q → P = Q) →
      ∃ f : C, f ∉ Q ∧ ∀ P : Ideal C, P.IsPrime → I ≤ P → f ∉ P → P = Q := by
    intro C _ I Q hN hQ hIQ hmin
    have hfin : I.minimalPrimes.Finite := by
      rw [Ideal.minimalPrimes_eq_comap]
      exact (minimalPrimes.finite_of_isNoetherianRing (C ⧸ I)).image _
    have hsep : ∀ P ∈ I.minimalPrimes, P ≠ Q → ∃ x, x ∈ P ∧ x ∉ Q := by
      intro P hP hne
      by_contra h
      push_neg at h
      exact hne (hmin P hP.1.1 hP.1.2 h)
    choose! g hg using hsep
    refine ⟨∏ P ∈ hfin.toFinset.erase Q, g P, ?_, ?_⟩
    · intro hmem
      obtain ⟨P, hPT, hgP⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hQ.isPrime)).mp hmem
      obtain ⟨hPQ, hPm⟩ := Finset.mem_erase.mp hPT
      exact (hg P (hfin.mem_toFinset.mp hPm) hPQ).2 hgP
    · intro P' hP' hIP' hf
      obtain ⟨P, hPm, hPP'⟩ := Ideal.exists_minimalPrimes_le hIP'
      by_cases hPQ : P = Q
      · subst hPQ
        exact (hQ.eq_of_le hP'.ne_top hPP').symm
      · exfalso
        apply hf
        have hT : P ∈ hfin.toFinset.erase Q :=
          Finset.mem_erase.mpr ⟨hPQ, hfin.mem_toFinset.mpr hPm⟩
        exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem _ hT) (hPP' (hg P hPm hPQ).1)

  have t_noeth : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (C : Type u) [CommRing C]
      (j : R →+* C), j.FiniteType → IsNoetherianRing (C ⧸ (IsLocalRing.maximalIdeal R).map j) := by
    intro R _ _ C _ j hj
    have h1 : ((Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map j)).comp j).FiniteType :=
      hj.comp_surjective Ideal.Quotient.mk_surjective
    have h2 : ((Ideal.quotientMap ((IsLocalRing.maximalIdeal R).map j) j Ideal.le_comap_map).comp
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))).FiniteType := by
      rw [Ideal.quotientMap_comp_mk]; exact h1
    have h3 := RingHom.FiniteType.of_comp_finiteType h2
    letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal R)
    letI := (Ideal.quotientMap ((IsLocalRing.maximalIdeal R).map j) j Ideal.le_comap_map).toAlgebra
    haveI : Algebra.FiniteType (R ⧸ IsLocalRing.maximalIdeal R)
        (C ⧸ (IsLocalRing.maximalIdeal R).map j) := h3
    exact Algebra.FiniteType.isNoetherianRing (R ⧸ IsLocalRing.maximalIdeal R)
      (C ⧸ (IsLocalRing.maximalIdeal R).map j)

  have t_zmt : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] (j : R →+* C), j.FiniteType →
      ∀ (Q : Ideal C) [Q.IsPrime] (f : C), f ∉ Q →
      (∀ P : Ideal C, P.IsPrime → P.comap j = Q.comap j → f ∉ P → P = Q) →
      ∃ r : C, r ∉ Q ∧ j.IsIntegralElem r ∧ ∀ x : C, ∃ n : ℕ, j.IsIntegralElem (r ^ n * x) := by
    intro R _ C _ j hj Q _ f hfQ hiso
    letI := j.toAlgebra
    haveI : Algebra.FiniteType R C := hj
    set q : PrimeSpectrum C := ⟨Q, inferInstance⟩
    have hopen : IsOpen {(⟨q, rfl⟩ : ↑(PrimeSpectrum.comap (algebraMap R C) ⁻¹'
        {PrimeSpectrum.comap (algebraMap R C) q}))} := by
      have heq : {(⟨q, rfl⟩ : ↑(PrimeSpectrum.comap (algebraMap R C) ⁻¹'
          {PrimeSpectrum.comap (algebraMap R C) q}))} =
          Subtype.val ⁻¹' (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum C)) := by
        ext ⟨P, hP⟩
        simp only [Set.mem_singleton_iff, Set.mem_preimage, SetLike.mem_coe,
          PrimeSpectrum.mem_basicOpen]
        constructor
        · intro h
          cases h
          exact hfQ
        · intro hfP
          have hc : P.asIdeal.comap j = Q.comap j := by
            have := congrArg PrimeSpectrum.asIdeal
              (Set.mem_singleton_iff.mp (Set.mem_preimage.mp hP))
            rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal] at this
            exact this
          have := hiso P.asIdeal P.isPrime hc hfP
          apply Subtype.ext
          exact PrimeSpectrum.ext this
      rw [heq]
      exact continuous_subtype_val.isOpen_preimage _ (PrimeSpectrum.isOpen_basicOpen)
    haveI : Algebra.QuasiFiniteAt R q.asIdeal :=
      Algebra.QuasiFiniteAt.of_isOpen_singleton_fiber q hopen
    haveI : Algebra.QuasiFiniteAt R Q := this
    exact Algebra.zariskisMainProperty_iff.mp (Algebra.ZariskisMainProperty.of_finiteType (R := R) Q)

  have t_surj : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (C : Type u) [CommRing C]
      (j : R →+* C) (Q : Ideal C), Q.IsPrime → Q.comap j = IsLocalRing.maximalIdeal R →
      (∀ y : C, j.IsIntegralElem y → ∃ w : R, j w = y) → ∀ r : C, r ∉ Q → j.IsIntegralElem r →
      (∀ x : C, ∃ n : ℕ, j.IsIntegralElem (r ^ n * x)) → Function.Surjective j := by
    intro R _ _ C _ j Q hQ hQc himg r hrQ hr hrx x
    obtain ⟨w₀, hw₀⟩ := himg r hr
    have hu : IsUnit w₀ := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hm
      rw [← hQc] at hm
      exact hrQ (hw₀ ▸ hm)
    obtain ⟨n, hn⟩ := hrx x
    obtain ⟨w₁, hw₁⟩ := himg _ hn
    obtain ⟨u, rfl⟩ := hu
    refine ⟨(↑u⁻¹ : R) ^ n * w₁, ?_⟩
    rw [map_mul, hw₁, ← hw₀, map_pow, ← mul_assoc, ← mul_pow, ← map_mul, Units.inv_mul, map_one,
      one_pow, one_mul]


  obtain ⟨hWAft, hnz, -⟩ := hPD
  have hWAinj : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [Algebra.algebraMap_eq_smul_one] at hw
    exact (NoZeroSMulDivisors.eq_zero_or_eq_zero_of_smul_eq_zero hw).resolve_right one_ne_zero
  have hadjft : Algebra.FiniteType A (Algebra.adjoin A {s}) := by
    have hfs : (Subtype.val ⁻¹' ({s} : Set K) : Set (Algebra.adjoin A {s})).Finite :=
      (Set.finite_singleton s).preimage Subtype.val_injective.injOn
    exact ⟨⟨hfs.toFinset, by
      rw [Set.Finite.coe_toFinset]; exact Algebra.adjoin_adjoin_coe_preimage⟩⟩
  have hFT : (wcSdgJ W A K L s).FiniteType :=
    RingHom.FiniteType.comp (RingHom.finite_algebraMap.mpr hfin).finiteType
      (RingHom.FiniteType.comp (RingHom.finiteType_algebraMap.mpr hadjft)
        (RingHom.finiteType_algebraMap.mpr hWAft))
  have hjinj : Function.Injective (wcSdgJ W A K L s) := by
    intro w₁ w₂ h
    have hL := congrArg (fun x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) => (x : L)) h
    have e : algebraMap K L (algebraMap A K (algebraMap ↥W A w₁)) =
        algebraMap K L (algebraMap A K (algebraMap ↥W A w₂)) := hL
    exact hWAinj (IsFractionRing.injective A K ((algebraMap K L).injective e))
  have hIle : Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (x : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} ≤
      (IsLocalRing.maximalIdeal ↥W).map (wcSdgJ W A K L s) := by
    rw [Ideal.span_le]
    rintro x ⟨w, hw, hx⟩
    have hxw : x = wcSdgJ W A K L s w := Subtype.ext (by rw [hx]; rfl)
    rw [hxw]
    exact Ideal.mem_map_of_mem _ hw
  have hmQ : (IsLocalRing.maximalIdeal ↥W).map (wcSdgJ W A K L s) ≤ Q :=
    Ideal.map_le_iff_le_comap.mpr (le_of_eq hQW.symm)
  by_cases hch : ∃ P : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L), P.IsPrime ∧
      Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (x : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} ≤ P ∧
      P ≤ Q ∧ P ≠ Q
  · obtain ⟨P, hP, hIP, hPQ, hne⟩ := hch
    exact t_chain _ Q _ P hP hIP hPQ hne
  · exfalso
    apply hns
    have hmin : ∀ P : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L), P.IsPrime →
        (IsLocalRing.maximalIdeal ↥W).map (wcSdgJ W A K L s) ≤ P → P ≤ Q → P = Q := by
      intro P hP h1 h2
      by_contra hne
      exact hch ⟨P, hP, hIle.trans h1, h2, hne⟩
    have hnoeth := t_noeth ↥W _ (wcSdgJ W A K L s) hFT
    obtain ⟨f, hfQ, hf⟩ := t_isolating _ _ Q hnoeth hQmax hmQ hmin
    obtain ⟨r, hrQ, hrint, hrx⟩ := t_zmt ↥W _ (wcSdgJ W A K L s) hFT Q f hfQ
      (fun P hP hc hfP => hf P hP (by rw [Ideal.map_le_iff_le_comap, hc, hQW]) hfP)
    have himg := t_integral _ (wcSdgJ W A K L s) hjinj
    have hsurj := t_surj ↥W _ (wcSdgJ W A K L s) Q inferInstance hQW himg r hrQ hrint hrx
    intro a
    obtain ⟨w, hw⟩ := hsurj (algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (algebraMap A ↥(Algebra.adjoin A {s}) a))
    refine ⟨w, ?_⟩
    have hL := congrArg (fun x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) => (x : L)) hw
    have e : algebraMap K L (algebraMap A K (algebraMap ↥W A w)) =
        algebraMap K L (algebraMap A K a) := hL
    exact IsFractionRing.injective A K ((algebraMap K L).injective e)

theorem wcpa_dj_llsm_sdg_reduced_quotient : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    (j : ↥W →+* R), Function.Injective j →
    _root_.IsReduced (R ⧸ (IsLocalRing.maximalIdeal ↥W).map j) :=
by
  intro Ω _ _ W R _ _ _ j _
  have s1 : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map j,
      ∃ m ∈ IsLocalRing.maximalIdeal ↥W, ∃ s : R, x = j m * s := by
    intro x hx
    rw [Ideal.map] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨m, hm, rfl⟩ := hy
      exact ⟨m, hm, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, (mul_zero _).symm⟩
    | add y z _ _ hy hz =>
      obtain ⟨m, hm, s, rfl⟩ := hy
      obtain ⟨m', hm', s', rfl⟩ := hz
      rcases ValuationRing.dvd_total m m' with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨m, hm, s + j c * s', by rw [map_mul]; ring⟩
      · exact ⟨m', hm', j c * s + s', by rw [map_mul]; ring⟩
    | smul a y _ hy =>
      obtain ⟨m, hm, s, rfl⟩ := hy
      exact ⟨m, hm, a * s, by rw [smul_eq_mul]; ring⟩
  have s2 : ∀ m : ↥W, m ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ μ ∈ IsLocalRing.maximalIdeal ↥W, μ ^ 2 = m := by
    intro m hm
    have hmnu : ¬ IsUnit m := (IsLocalRing.mem_maximalIdeal _).mp hm
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (m : Ω) (by norm_num : 0 < 2)
    have hzW : z ∈ W := by
      rcases W.mem_or_inv_mem z with h | h
      · exact h
      · by_cases hz0 : z = 0
        · rw [hz0]; exact W.zero_mem
        · exfalso
          apply hmnu
          apply IsUnit.of_mul_eq_one ((⟨z⁻¹, h⟩ : W) ^ 2)
          apply Subtype.ext
          have e : (m : Ω) * (z⁻¹) ^ 2 = 1 := by
            rw [← hz]; field_simp
          simpa using e
    have hμ : (⟨z, hzW⟩ : W) ^ 2 = m := Subtype.ext (by simpa using hz)
    refine ⟨⟨z, hzW⟩, ?_, hμ⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply hmnu
    rw [← hμ]
    exact hu.pow 2
  rw [isReduced_iff_pow_one_lt 2 (by norm_num)]
  intro x hx
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hx
  obtain ⟨m, hm, s, hs⟩ := s1 _ hx
  obtain ⟨μ, hμm, hμ⟩ := s2 m hm
  have hdvd : (j μ) ^ 2 ∣ r ^ 2 := ⟨s, by rw [hs, ← map_pow, hμ]⟩
  obtain ⟨t, ht⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff two_ne_zero).mp hdvd
  rw [Ideal.Quotient.eq_zero_iff_mem, ht]
  exact Ideal.mul_mem_right t _ (Ideal.mem_map_of_mem j hμm)

theorem wcpa_dj_llsm_sdg_affine_fibre_point : ∀ (A₀ : Type u) [CommRing A₀] [IsLocalRing A₀]
    (C : Type u) [CommRing C] [Algebra A₀ C] (Q : Ideal C) [Q.IsMaximal],
    Q.comap (algebraMap A₀ C) = IsLocalRing.maximalIdeal A₀ →
    ∃ w : ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀))))),
      Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀)))) w =
        wcSdgPt C Q ∧
      IsClosed ({w} : Set _) ∧
      Nonempty (↑((Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
          (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀))))).presheaf.stalk w) ≃+*
        (Localization.AtPrime Q ⧸ (IsLocalRing.maximalIdeal A₀).map
          ((algebraMap C (Localization.AtPrime Q)).comp (algebraMap A₀ C)))) :=
by
  intro A₀ _ _ C _ _ Q _ hQ
  classical
  obtain ⟨h1, h2⟩ := wcpa_dj_p1g_cf_fibre_stalk A₀ (Spec (.of C))
    (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
  have hgy : (Spec.map (CommRingCat.ofHom (algebraMap A₀ C))) (wcSdgPt C Q) =
      IsLocalRing.closedPoint A₀ := by
    rw [Spec.map_apply]
    refine PrimeSpectrum.ext ?_
    exact hQ
  obtain ⟨w, hw⟩ := h1 _ hgy
  obtain ⟨-, hsurj, hker⟩ := h2 w
  haveI : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀))))) :=
    inferInstance
  refine ⟨w, hw, ?_, ?_⟩
  · rw [(Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀))))
      ).isClosedEmbedding.isClosed_iff_image_isClosed, Set.image_singleton, hw]
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr ‹Q.IsMaximal›
  · set x := Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀)))) w with hxdef
    have hnat : (Scheme.ΓSpecIso (.of A₀)).inv ≫
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ C))).appTop ≫
        (Spec (.of C)).presheaf.germ ⊤ x trivial =
        CommRingCat.ofHom (algebraMap A₀ C) ≫ (Scheme.ΓSpecIso (.of C)).inv ≫
          (Spec (.of C)).presheaf.germ ⊤ x trivial := by
      rw [← Category.assoc, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality]
    rw [hnat] at hker
    have hε : ∀ (y : PrimeSpectrum C), y.asIdeal = Q →
        ∃ ε : ↑((Spec (.of C)).presheaf.stalk y) ≃+* Localization.AtPrime Q,
          ∀ c : C, ε (((Scheme.ΓSpecIso (.of C)).inv ≫
            (Spec (.of C)).presheaf.germ ⊤ y trivial).hom c) =
            algebraMap C (Localization.AtPrime Q) c := by
      rintro y rfl
      refine ⟨(Spec.stalkIso (.of C) y).commRingCatIsoToRingEquiv, fun c => ?_⟩
      rw [← Spec.algebraMap_stalkIso_inv]
      exact Iso.inv_hom_id_apply (Spec.stalkIso (.of C) y) _
    obtain ⟨ε, hεc⟩ := hε x (by rw [hw])
    have hc : ε.toRingHom.comp (((Scheme.ΓSpecIso (.of C)).inv ≫
        (Spec (.of C)).presheaf.germ ⊤ x trivial).hom.comp (algebraMap A₀ C)) =
        (algebraMap C (Localization.AtPrime Q)).comp (algebraMap A₀ C) := by
      ext a
      exact hεc (algebraMap A₀ C a)
    have hker' : RingHom.ker ((Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A₀ C)))
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (IsLocalRing.ResidueField A₀))))).stalkMap
          w).hom =
        Ideal.map (((Scheme.ΓSpecIso (.of C)).inv ≫
          (Spec (.of C)).presheaf.germ ⊤ x trivial).hom.comp (algebraMap A₀ C))
          (IsLocalRing.maximalIdeal A₀) := by
      rw [hker]; rfl
    have hJ : (IsLocalRing.maximalIdeal A₀).map
        ((algebraMap C (Localization.AtPrime Q)).comp (algebraMap A₀ C)) =
        Ideal.map ε.toRingHom (Ideal.map (((Scheme.ΓSpecIso (.of C)).inv ≫
          (Spec (.of C)).presheaf.germ ⊤ x trivial).hom.comp (algebraMap A₀ C))
          (IsLocalRing.maximalIdeal A₀)) := by
      rw [Ideal.map_map, hc]
    exact ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans
      ((Ideal.quotEquivOfEq hker').trans (Ideal.quotientEquiv _ _ ε (by exact hJ)))⟩

theorem wcpa_dj_llsm_sdg_hens_bridge : ∀ (S C : Type u) [CommRing S] [CommRing C] [Algebra S C]
    (Q : Ideal C) [Q.IsPrime] (P : Type u) [CommRing P] (e : Localization.AtPrime Q →+* P),
    wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P e →
    ∃ e' : ↑((Spec (.of C)).presheaf.stalk (wcSdgPt C Q)) →+* P,
      wcNdIsHens (IsLocalRing.maximalIdeal ↑((Spec (.of C)).presheaf.stalk (wcSdgPt C Q))) P e' ∧
      e'.comp (wcNdSig (Spec.map (CommRingCat.ofHom (algebraMap S C))) (wcSdgPt C Q)) =
        e.comp ((algebraMap C (Localization.AtPrime Q)).comp (algebraMap S C)) :=
by
  intro S C _ _ _ Q _ P _ e he

  have transport : ∀ {A A' : Type u} [CommRing A] [CommRing A'] [IsLocalRing A]
      [IsLocalRing A'] (ι : A' ≃+* A) (e : A →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal A) P e →
      wcNdIsHens (IsLocalRing.maximalIdeal A') P (e.comp ι.toRingHom) := by
    intro A A' _ _ _ _ ι e he
    obtain ⟨hP, hunit, huniv⟩ := he
    have key : ∀ a' : A', a' ∈ IsLocalRing.maximalIdeal A' ↔
        ι a' ∈ IsLocalRing.maximalIdeal A := by
      intro a'
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        mem_nonunits_iff, MulEquiv.isUnit_map]
    have key' : ∀ a : A, a ∈ IsLocalRing.maximalIdeal A ↔
        ι.symm a ∈ IsLocalRing.maximalIdeal A' := by
      intro a
      rw [key, RingEquiv.apply_symm_apply]
    refine ⟨hP, ?_, ?_⟩
    · intro a'
      rw [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hunit,
        key]
    · intro B _ hB g' hg'
      have hg : ∀ a, IsUnit ((g'.comp ι.symm.toRingHom) a) ↔
          a ∉ IsLocalRing.maximalIdeal A := by
        intro a
        rw [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hg',
          key']
      obtain ⟨h, ⟨hhe, hloc⟩, huniq⟩ := huniv B hB (g'.comp ι.symm.toRingHom) hg
      refine ⟨h, ⟨?_, hloc⟩, ?_⟩
      · ext a'
        have := congrArg (fun φ => φ (ι a')) hhe
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
          RingEquiv.symm_apply_apply] at this
        simpa [RingHom.comp_apply] using this
      · intro h' ⟨hh'e, hloc'⟩
        apply huniq h'
        refine ⟨?_, hloc'⟩
        ext a
        have := congrArg (fun φ => φ (ι.symm a)) hh'e
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
          RingEquiv.apply_symm_apply] at this
        simpa [RingHom.comp_apply] using this
  set y := wcSdgPt C Q with hy
  let ι : ↑((Spec (.of C)).presheaf.stalk y) ≃+* Localization.AtPrime Q :=
    (StructureSheaf.stalkIso C y).symm.toRingEquiv
  refine ⟨e.comp ι.toRingHom, transport ι e he, ?_⟩
  rw [RingHom.comp_assoc]
  congr 1
  ext c
  simp only [wcNdSig, wcCnSigma, RingHom.comp_apply]
  have h1 : (homOfLE (le_top : (⊤ : (Spec (.of C)).Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
  rw [h1, op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id, RingHom.id_apply]
  have h2 := congrArg (fun φ => φ.hom c)
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap S C)))
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
  rw [← h2, Scheme.ΓSpecIso_inv]
  have h3 := congrArg (fun φ => φ.hom (algebraMap S C c))
    (StructureSheaf.algebraMap_germ (R := C) ⊤ y trivial)
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h3
  erw [h3, ← StructureSheaf.stalkAlgebra_map]
  exact (StructureSheaf.stalkIso C y).symm.commutes _

theorem wcpa_dj_llsm_sdg_smooth_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)) [LocallyOfFiniteType g],
    Flat g →
    ∀ w : ↥(Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
    IsClosed ({w} : Set _) →
    _root_.IsReduced ↑((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) →
    ringKrullDim ↑((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) =
      ((1 : ℕ) : WithBot ℕ∞) →
    wcpaDjLkDelta ↑((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) = 0 →
    wcLfChart (S := ↥W) (Q := Polynomial ↥W) g
      (Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
by
  intro Ω _ _ W Y g _ hflat w hwcl hred hdim hδ

  have Hnat : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) (s : Γ(Y, ⊤)),
      (f.residueFieldMap x).hom ((Y.evaluation ⊤ (f x) trivial).hom s) =
        (X.evaluation ⊤ x trivial).hom (f.appTop.hom s) := by
    intro X Y f x s
    exact Scheme.evaluation_naturality_apply f (V := ⊤) x trivial s
  have Hspec : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S) (r : R),
      (Spec.map (CommRingCat.ofHom f)).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r) =
        (Scheme.ΓSpecIso (.of S)).inv.hom (f r) := by
    intro R S _ _ f r
    have := congrArg (fun φ => φ.hom r) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    exact this.symm
  have Hsig : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (a : A),
      wcCnSigma g ⊤ a = g.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
    intro A _ Y g a
    have hid : ∀ (h : (⊤ : Y.Opens) ≤ ⊤), Y.presheaf.map (homOfLE h).op = 𝟙 _ := fun h => by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : Y.Opens)) from rfl,
        CategoryTheory.Functor.map_id]
    simp only [wcCnSigma, RingHom.comp_apply, hid, CommRingCat.hom_id, RingHom.id_apply]

  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A], IsAlgClosed (IsLocalRing.ResidueField A) → ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) [LocallyOfFiniteType g] (y : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))), IsClosed ({y} : Set ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))) → g (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) y) = IsLocalRing.closedPoint A ∧ Function.Surjective ((Y.evaluation ⊤ (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) y) trivial).hom.comp (wcCnSigma g ⊤)) := by
    intro A _ _ hκ Y g _ y hy
    haveI := hκ
    have gen : ∀ (s₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A)),
        s₀ = Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) →
        ∀ (y : ↥(Limits.pullback g s₀)), IsClosed ({y} : Set ↥(Limits.pullback g s₀)) →
        g (Limits.pullback.fst g s₀ y) = IsLocalRing.closedPoint A ∧
        Function.Surjective ((Y.evaluation ⊤ (Limits.pullback.fst g s₀ y) trivial).hom.comp
          (wcCnSigma g ⊤)) := by
      intro s₀ hs₀ y hy
      have hcond : Limits.pullback.fst g s₀ ≫ g = Limits.pullback.snd g s₀ ≫ s₀ :=
        Limits.pullback.condition
      have key : ∀ p : Spec (.of (IsLocalRing.ResidueField A)),
          (s₀ p).asIdeal = IsLocalRing.maximalIdeal A := by
        intro p
        subst hs₀
        show Ideal.comap (algebraMap A (IsLocalRing.ResidueField A)) p.asIdeal = _
        haveI := p.isPrime
        rw [Ideal.eq_bot_of_prime p.asIdeal, IsLocalRing.ResidueField.algebraMap_eq]
        exact IsLocalRing.ker_residue
      refine ⟨?_, ?_⟩
      · rw [← Scheme.Hom.comp_apply, hcond, Scheme.Hom.comp_apply]
        apply PrimeSpectrum.ext
        exact key _
      · intro t
        have hF := wc_closed_point_residue_surjective (IsLocalRing.ResidueField A) _
          (Limits.pullback.snd g s₀) y hy
        obtain ⟨k, hk⟩ := hF (((Limits.pullback.fst g s₀).residueFieldMap y).hom t)
        obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective k
        refine ⟨a, ?_⟩
        apply ((Limits.pullback.fst g s₀).residueFieldMap y).hom.injective
        rw [← hk]
        simp only [RingHom.comp_apply]
        rw [Hsig, Hnat (Limits.pullback.fst g s₀) y]
        congr 1
        have h1 : (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField A))).inv.hom
            (IsLocalRing.residue A a) = s₀.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
          rw [hs₀, Hspec, IsLocalRing.ResidueField.algebraMap_eq]
        rw [h1]
        have e1 : (Limits.pullback.fst g s₀).appTop.hom (g.appTop.hom
            ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
            (Limits.pullback.fst g s₀ ≫ g).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
          rw [Scheme.Hom.comp_appTop]; rfl
        have e2 : (Limits.pullback.snd g s₀).appTop.hom (s₀.appTop.hom
            ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
            (Limits.pullback.snd g s₀ ≫ s₀).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
          rw [Scheme.Hom.comp_appTop]; rfl
        rw [e1, e2, hcond]
    exact gen _ rfl y hy

  have s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (z : Y) (W' : Y.Opens), z ∈ W' → SmoothOfRelativeDimension 1 (W'.ι ≫ g) → g z = IsLocalRing.closedPoint A → ∃ (E : Type u) (_ : CommRing E) (σ : A →+* E) (e : Spec (.of E) ⟶ Y) (x : ↥(Spec (.of E))), IsOpenImmersion e ∧ e x = z ∧ Spec.map (CommRingCat.ofHom σ) = e ≫ g ∧ RingHom.IsStandardSmoothOfRelativeDimension 1 σ := by
    intro A _ _ Y g z W' hz hsm hcl
    obtain ⟨z', hz'⟩ : z ∈ Set.range W'.ι := by rw [Scheme.Opens.range_ι]; exact hz
    obtain ⟨U, hU, V, hV, hzV, hle, hstd⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1)
        (f := W'.ι ≫ g) z'
    have hmem : IsLocalRing.closedPoint A ∈ U := by
      have h1 : (W'.ι ≫ g) z' ∈ U := hle hzV
      rw [Scheme.Hom.comp_apply, hz'] at h1
      rw [← hcl]
      exact h1
    obtain rfl : U = ⊤ := (IsLocalRing.closedPoint_mem_iff U).mp hmem
    let σ : A →+* Γ(W'.toScheme, V) :=
      ((W'.ι ≫ g).appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom
    refine ⟨Γ(W'.toScheme, V), inferInstance, σ, hV.fromSpec ≫ W'.ι,
      hV.primeIdealOf ⟨z', hzV⟩, inferInstance, ?_, ?_, ?_⟩
    · exact (congrArg W'.ι (hV.fromSpec_primeIdealOf ⟨z', hzV⟩)).trans hz'
    · have h1 : CommRingCat.ofHom σ =
          (Scheme.ΓSpecIso (.of A)).inv ≫ (W'.ι ≫ g).appLE ⊤ V hle := rfl
      rw [h1, Spec.map_comp, ← Scheme.isoSpec_Spec_inv, ← IsAffineOpen.fromSpec_top,
        IsAffineOpen.SpecMap_appLE_fromSpec, Category.assoc]
    · exact hstd.comp (RingHom.IsStandardSmoothOfRelativeDimension.equiv
        (Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv)

  have s5 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (E : Type u) [CommRing E] (σ : A →+* E) (e : Spec (.of E) ⟶ Y) (x : ↥(Spec (.of E))), IsOpenImmersion e → Spec.map (CommRingCat.ofHom σ) = e ≫ g → g (e x) = IsLocalRing.closedPoint A → Function.Surjective ((Y.evaluation ⊤ (e x) trivial).hom.comp (wcCnSigma g ⊤)) → Ideal.comap σ (PrimeSpectrum.asIdeal x) = IsLocalRing.maximalIdeal A ∧ (∀ a : E, ∃ c : A, a - σ c ∈ PrimeSpectrum.asIdeal x) ∧ ∀ (Q : Type u) [CommRing Q] (j : A →+* Q) (ε : Q →+* E), ε.comp j = σ → Function.Bijective (Scheme.Hom.residueFieldMap (Spec.map (CommRingCat.ofHom ε)) x).hom := by
    intro A _ _ Y g E _ σ e x he hσ hcl hsurj
    let evx : E →+* (Spec (.of E)).residueField x :=
      ((Spec (.of E)).evaluation ⊤ x trivial).hom.comp (Scheme.ΓSpecIso (.of E)).inv.hom
    have hker : ∀ a : E, evx a = 0 ↔ a ∈ x.asIdeal := by
      intro a
      have h1 := Scheme.evaluation_eq_zero_iff_notMem_basicOpen (Spec (.of E)) (U := ⊤) x trivial
        ((Scheme.ΓSpecIso (.of E)).inv.hom a)
      rw [basicOpen_eq_of_affine] at h1
      exact h1.trans ((Iff.not (PrimeSpectrum.mem_basicOpen (x := x) a)).trans not_not)
    have hstar : Function.Surjective (evx.comp σ) := by
      intro t
      obtain ⟨t', ht'⟩ := (ConcreteCategory.bijective_of_isIso (e.residueFieldMap x)).2 t
      obtain ⟨a, ha⟩ := hsurj t'
      refine ⟨a, ?_⟩
      rw [← ht', ← ha]
      simp only [RingHom.comp_apply]
      rw [Hsig]
      erw [Hnat e x]
      have h2 : e.appTop.hom (g.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
          (Spec.map (CommRingCat.ofHom σ)).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
        rw [hσ, Scheme.Hom.comp_appTop]
        rfl
      rw [h2, Hspec]
      rfl
    refine ⟨?_, ?_, ?_⟩
    · have h1 : Ideal.comap σ x.asIdeal = (Spec.map (CommRingCat.ofHom σ) x).asIdeal := rfl
      rw [h1, hσ, Scheme.Hom.comp_apply, hcl]
      rfl
    · intro a
      obtain ⟨c, hc⟩ := hstar (evx a)
      refine ⟨c, ?_⟩
      rw [← hker, map_sub, ← RingHom.comp_apply evx σ, hc, sub_self]
    · intro Q _ j ε hεj
      refine ⟨RingHom.injective _, ?_⟩
      intro t
      obtain ⟨a, ha⟩ := hstar t
      refine ⟨((Spec (.of Q)).evaluation ⊤ (Spec.map (CommRingCat.ofHom ε) x) trivial).hom
        ((Scheme.ΓSpecIso (.of Q)).inv.hom (j a)), ?_⟩
      rw [Hnat, Hspec, ← ha, ← hεj]
      rfl

  have s4 : ∀ (A E : Type u) [CommRing A] [IsLocalRing A] [CommRing E] (σ : A →+* E) (𝔮 : Ideal E) [𝔮.IsPrime], RingHom.IsStandardSmoothOfRelativeDimension 1 σ → Ideal.comap σ 𝔮 = IsLocalRing.maximalIdeal A → (∀ a : E, ∃ c : A, a - σ c ∈ 𝔮) → ∃ ε : Polynomial A →+* E, ε.Etale ∧ ε.comp Polynomial.C = σ ∧ Ideal.comap ε 𝔮 = Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A) := by
    intro A E _ _ _ σ 𝔮 _ hstd hcomap hrep
    obtain ⟨g₁, hg₁C, hg₁et⟩ := hstd.exists_etale_mvPolynomial
    let u : Polynomial A ≃+* MvPolynomial (Fin 1) A :=
      (MvPolynomial.uniqueAlgEquiv A (Fin 1)).symm.toRingEquiv
    have huC : ∀ r : A, u (Polynomial.C r) = MvPolynomial.C r := by
      intro r
      show (MvPolynomial.uniqueAlgEquiv A (Fin 1)).symm (Polynomial.C r) = _
      rw [MvPolynomial.uniqueAlgEquiv_symm_apply]
      simp
    let ε₀ : Polynomial A →+* E := g₁.comp u.toRingHom
    have hε₀C : ε₀.comp Polynomial.C = σ := by
      rw [← hg₁C]
      ext r
      simp only [ε₀, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, huC]
    have hε₀et : ε₀.Etale :=
      RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective u.bijective) hg₁et
    obtain ⟨c, hc⟩ := hrep (ε₀ Polynomial.X)
    let τ : Polynomial A ≃+* Polynomial A := (Polynomial.taylorEquiv (-c)).toRingEquiv
    have hτX : τ Polynomial.X = Polynomial.X + Polynomial.C (-c) := by
      show Polynomial.taylor (-c) Polynomial.X = _
      exact Polynomial.taylor_X (R := A) (r := -c)
    have hτC : ∀ r : A, τ (Polynomial.C r) = Polynomial.C r := by
      intro r
      show Polynomial.taylor (-c) (Polynomial.C r) = _
      exact Polynomial.taylor_C (R := A) _ _
    let ε : Polynomial A →+* E := ε₀.comp τ.toRingHom
    have hεC : ε.comp Polynomial.C = σ := by
      rw [← hε₀C]
      ext r
      simp only [ε, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hτC]
    have hεet : ε.Etale :=
      RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective τ.bijective) hε₀et
    have hεX : ε Polynomial.X ∈ 𝔮 := by
      have h1 : ε Polynomial.X = ε₀ Polynomial.X - σ c := by
        show ε₀ (τ Polynomial.X) = _
        rw [hτX, map_add, sub_eq_add_neg, ← map_neg σ, ← hε₀C]
        rfl
      rw [h1]
      exact hc
    refine ⟨ε, hεet, hεC, ?_⟩
    let ρ : Polynomial A →+* IsLocalRing.ResidueField A :=
      (IsLocalRing.residue A).comp (Polynomial.evalRingHom 0)
    have hρs : Function.Surjective ρ := by
      intro t
      obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective t
      exact ⟨Polynomial.C r, by simp [ρ]⟩
    have hker : RingHom.ker ρ = Ideal.span {Polynomial.X} ⊔
        Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A) := by
      apply le_antisymm
      · intro p hp
        rw [RingHom.mem_ker] at hp
        have h0 : p.coeff 0 ∈ IsLocalRing.maximalIdeal A := by
          rw [Polynomial.coeff_zero_eq_eval_zero, ← IsLocalRing.residue_eq_zero_iff]
          simpa [ρ] using hp
        rw [← Polynomial.X_mul_divX_add p]
        refine Ideal.add_mem _ ?_ ?_
        · apply Ideal.mem_sup_left
          rw [mul_comm]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        · exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ h0)
      · apply sup_le
        · rw [Ideal.span_le]
          intro p hp
          rw [Set.mem_singleton_iff] at hp
          subst hp
          simp [ρ]
        · rw [Ideal.map_le_iff_le_comap]
          intro r hr
          simp only [Ideal.mem_comap, RingHom.mem_ker, ρ, RingHom.comp_apply,
            Polynomial.coe_evalRingHom, Polynomial.eval_C]
          exact (IsLocalRing.residue_eq_zero_iff r).mpr hr
    have hmax : (Ideal.span {Polynomial.X} ⊔
        Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A)).IsMaximal := by
      rw [← hker]
      exact RingHom.ker_isMaximal_of_surjective ρ hρs
    symm
    apply hmax.eq_of_le
    · exact (Ideal.comap_isPrime ε 𝔮).ne_top
    · apply sup_le
      · rw [Ideal.span_le]
        intro p hp
        rw [Set.mem_singleton_iff] at hp
        subst hp
        exact hεX
      · rw [Ideal.map_le_iff_le_comap]
        intro r hr
        rw [Ideal.mem_comap, Ideal.mem_comap, ← RingHom.comp_apply, hεC, ← Ideal.mem_comap,
          hcomap]
        exact hr

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI : LocallyOfFiniteType (Limits.pullback.snd g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  haveI := hred
  have hreg := wcpa_dj_lr1k_gn_delta_zero_regular _ hdim.le hδ
  obtain hsmF := wcpa_dj_lr1k_gn_regular_closed_smooth (IsLocalRing.ResidueField ↥W)
    _ (Limits.pullback.snd g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) 1 w hwcl hreg
    hdim
  have hlfp := wcpa_dj_mn_flat_fp (Spec (.of ↥W)) _ g hflat inferInstance
  obtain ⟨W', hW', hsm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) _ g
    (IsLocalRing.ResidueField ↥W) _ w hflat hlfp hsmF

  obtain ⟨hcl, hsurj⟩ := s2 ↥W hκ _ g w hwcl
  obtain ⟨E, _, σ, e, x, he, hex, hσ, hstd⟩ := s3 ↥W _ g _ W' hW' hsm hcl
  rw [← hex] at hcl hsurj
  obtain ⟨hcomap, hrep, hres⟩ := s5 ↥W _ _ E σ e x he hσ hcl hsurj
  haveI := x.isPrime
  obtain ⟨ε, hεet, hεC, hεcomap⟩ := s4 ↥W E σ x.asIdeal hstd hcomap hrep
  refine ⟨Spec (.of E), e, Spec.map (CommRingCat.ofHom ε), x, inferInstance, ?_, ?_, hex, ?_,
    ?_, hres (Polynomial ↥W) Polynomial.C ε hεC⟩
  · exact (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hεet
  · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, Polynomial.algebraMap_eq, hεC, hσ]
  · exact hεcomap
  · exact ConcreteCategory.bijective_of_isIso (e.residueFieldMap x)

theorem wcpa_dj_llsm_sdg_node_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)) [LocallyOfFiniteType g],
    Flat g →
    ∀ w : ↥(Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
    IsClosed ({w} : Set _) →
    _root_.IsReduced ↑((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) →
    ringKrullDim ↑((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) ≤
      ((1 : ℕ) : WithBot ℕ∞) →
    wcpaDjLkDelta ↑((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) = 1 →
    wcpaDjLkBranches ↑((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) = 2 →
    ∃ a ∈ IsLocalRing.maximalIdeal ↥W,
      wcLfChart (S := ↥W) (Q := wcNcRing W a) g
        (Limits.pullback.fst g
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)
        (Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
          (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
            Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))) :=
by
  intro Ω _ _ W Y g _ hflat w hw hred hdle h1 h2

  have s16 : ∀ (B O R K : Type u) [CommRing B] [CommRing O] [CommRing R] [IsLocalRing B]
      [IsLocalRing O] [IsLocalRing R] [Field K] (β : B →+* O) [IsLocalHom β] (π : O →+* R)
      (φ : K →+* R) (θ : IsLocalRing.ResidueField B ≃+* K), IsLocalHom π →
      π.comp β = (φ.comp θ.toRingHom).comp (IsLocalRing.residue B) →
      (∀ r : R, ∃ c : K, r - φ c ∈ IsLocalRing.maximalIdeal R) →
      Function.Bijective (IsLocalRing.ResidueField.map β) := by
    intro B O R K _ _ _ _ _ _ _ β _ π φ θ hπ hc hr
    refine ⟨RingHom.injective _, ?_⟩
    intro t
    obtain ⟨o, rfl⟩ := IsLocalRing.residue_surjective t
    obtain ⟨c, hc'⟩ := hr (π o)
    obtain ⟨k, hk⟩ := θ.surjective c
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective k
    refine ⟨IsLocalRing.residue B b, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue]
    have e1 : φ c = π (β b) := by
      have := congrArg (fun f => f b) hc
      simp only [RingHom.comp_apply] at this
      rw [this, ← hk]
      rfl
    rw [e1, ← map_sub] at hc'
    have hmem : β b - o ∈ IsLocalRing.maximalIdeal O := by
      by_contra hn
      have hu : IsUnit (β b - o) := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hn
        exact hn
      have hu' : IsUnit (π (o - β b)) := by
        rw [← neg_sub, map_neg]
        exact (hu.map π).neg
      exact (IsLocalRing.mem_maximalIdeal _).mp hc' hu'
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact hmem

  have s17 : ∀ (a : ↥W) (P : Ideal (wcNcRing W a)),
      Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) ∈ P →
      Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) ∈ P →
      P.comap (algebraMap ↥W (wcNcRing W a)) = IsLocalRing.maximalIdeal ↥W →
      a ∈ IsLocalRing.maximalIdeal ↥W ∧ P = Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
    intro a P h0 h1' hc
    have halg : ∀ c : ↥W, algebraMap ↥W (wcNcRing W a) c =
        Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) := fun c => rfl
    have hCm : ∀ c : ↥W, Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈ P ↔
        c ∈ IsLocalRing.maximalIdeal ↥W := by
      intro c
      rw [← hc, Ideal.mem_comap, halg]
    have hle : Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro f hf
        rcases hf with rfl | rfl
        · exact h0
        · exact h1'
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc'
        exact (hCm c).mpr hc'
    refine ⟨?_, le_antisymm ?_ hle⟩
    · rw [← hCm]
      have hrel : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C a) =
          Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) *
            Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) := by
        rw [← map_mul, Ideal.Quotient.eq]
        rw [← neg_sub]
        exact neg_mem (Ideal.mem_span_singleton_self _)
      rw [hrel]
      exact P.mul_mem_left _ h1'
    · have hdec0 : ∀ f : MvPolynomial (Fin 2) ↥W,
          f - MvPolynomial.C (MvPolynomial.constantCoeff f) ∈
          Ideal.span ({MvPolynomial.X 0, MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) ↥W)) := by
        intro f
        induction f using MvPolynomial.induction_on with
        | C r => simp
        | add p q hp hq =>
          have : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
              (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
                (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
            rw [map_add, map_add]; ring
          rw [this]
          exact Ideal.add_mem _ hp hq
        | mul_X p i hp =>
          have h0' : MvPolynomial.constantCoeff (p * MvPolynomial.X i) = 0 := by simp
          rw [h0', map_zero, sub_zero]
          apply Ideal.mul_mem_left
          apply Ideal.subset_span
          fin_cases i
          · exact Or.inl rfl
          · exact Or.inr rfl
      intro x hx
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hdec := hdec0 f
      set c := MvPolynomial.constantCoeff f with hcdef
      have hA : Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) ∈
          Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
            (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
        Ideal.mem_map_of_mem _ (Ideal.mem_sup_left hdec)
      have hcP : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈ P := by
        have : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) =
            Ideal.Quotient.mk (wcNcIdeal W a) f -
              Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) := by
          rw [map_sub]; ring
        rw [this]
        exact P.sub_mem hx (hle hA)
      have hcm : c ∈ IsLocalRing.maximalIdeal ↥W := (hCm c).mp hcP
      have hB : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈
          Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
            (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
        Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hcm))
      have : Ideal.Quotient.mk (wcNcIdeal W a) f =
          Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) +
            Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) := by
        rw [map_sub]; ring
      rw [this]
      exact Ideal.add_mem _ hA hB

  have s18 : ∀ {U Y T S : Scheme.{u}} (e : U ⟶ Y) (m : U ⟶ T) (g : Y ⟶ S) (h : T ⟶ S)
      (x : ↥U) (y : ↥Y), Etale e → m ≫ h = e ≫ g → e x = y →
      IsAlgClosed ↥(Y.residueField y) → Function.Bijective (g.residueFieldMap y).hom →
      Function.Bijective (e.residueFieldMap x).hom ∧
        Function.Bijective (m.residueFieldMap x).hom := by
    intro U Y T S e m g h x y he hmh hex hAC hg
    subst hex
    have hes : Function.Surjective (e.residueFieldMap x).hom :=
      wc_etale_residue_surj_of_sepClosed e x inferInstance
    have heb : Function.Bijective (e.residueFieldMap x).hom := ⟨RingHom.injective _, hes⟩
    refine ⟨heb, RingHom.injective _, ?_⟩
    have h1 := Scheme.residueFieldMap_comp m h x
    have h2 := Scheme.residueFieldMap_comp e g x
    have h3 := Scheme.Hom.residueFieldMap_congr hmh x
    have key : Function.Surjective ((m ≫ h).residueFieldMap x).hom := by
      rw [h3, h2]
      simp only [CommRingCat.hom_comp, RingHom.coe_comp]
      exact (heb.2.comp hg.2).comp (Scheme.residueFieldCongr _).commRingCatIsoToRingEquiv.surjective
    intro t
    obtain ⟨s, hs⟩ := key t
    refine ⟨(h.residueFieldMap (m x)).hom s, ?_⟩
    rw [← hs, h1]
    rfl
  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI : LocallyOfFiniteType (Limits.pullback.snd g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  have hlfp : LocallyOfFinitePresentation g :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) _ _ hflat inferInstance
  haveI := hred
  have hres : ∀ r : ↥((Limits.pullback g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w),
      ∃ c : IsLocalRing.ResidueField ↥W, r - ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField ↥W))).inv ≫
        (Limits.pullback.snd g
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).appTop ≫
        (Limits.pullback g
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.germ
            ⊤ w trivial).hom c ∈
        IsLocalRing.maximalIdeal ((Limits.pullback g
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) := by
    obtain ⟨x₁, hx₁, hsp⟩ := wc_rational_closed_specialization (IsLocalRing.ResidueField ↥W) _
      (Limits.pullback.snd g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) w
    have hx : x₁ (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) = w :=
      hsp.mem_closed hw rfl
    subst hx
    exact wcpa_dj_lqr_section_residue (IsLocalRing.ResidueField ↥W) _ _ x₁ hx₁
  obtain ⟨ê, hê⟩ := wcpa_dj_lr1k_gn_node_completion (IsLocalRing.ResidueField ↥W) _ _ hres hdle h1 h2
  obtain ⟨hgy, θ, hπs, hker, hcomp⟩ := wcpa_dj_lr1k_lfnc_fibre_stalk_data ↥W Y g w
  have hdat : wcNcNodeDatum g (Limits.pullback.fst g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) :=
    wcpa_dj_lr1k_lfnc_datum_algebra _ _ _ _ _ _ _ θ hπs hker hcomp ⟨ê, hê⟩
  obtain ⟨U, e, a, m, x', he, hm, hcomm, hex, hX0, hX1⟩ :=
    wcpa_dj_nc_chart_exists Ω W Y g _ hκ hflat hlfp hgy hdat
  have h3 : (wcNcStr W a) (m x') = IsLocalRing.closedPoint ↥W := by
    rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply, hex]
    exact hgy
  have hc : (m x').asIdeal.comap (algebraMap ↥W (wcNcRing W a)) = IsLocalRing.maximalIdeal ↥W := by
    have := congrArg PrimeSpectrum.asIdeal h3
    exact this
  obtain ⟨haM, hP⟩ := s17 a (m x').asIdeal hX0 hX1 hc
  have hβ := s16 _ _ _ _ _ _ _ θ inferInstance hcomp hres
  have hβ' : Function.Bijective
      (g.residueFieldMap (Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)).hom := hβ
  haveI hAC : IsAlgClosed ↥(Y.residueField (Limits.pullback.fst g
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) :=
    IsAlgClosed.of_ringEquiv (IsLocalRing.ResidueField ↥W) _
      (θ.symm.trans (RingEquiv.ofBijective _ hβ))
  obtain ⟨hre, hrm⟩ := s18 e m g (wcNcStr W a) x' _ he hcomm hex hAC hβ'
  exact ⟨a, haM, U, e, m, x', he, hm, hcomm, hex, hP, hre, hrm⟩

theorem wcpa_dj_llsm_sdg_node_a_ne_zero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), W ≠ ⊤ → ∀ (P : Type u) [CommRing P] [IsDomain P]
    (φ : wcNcRing W 0 →+* P),
    wcNdIsHens (Ideal.map (Ideal.Quotient.mk (wcNcIdeal W 0))
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))) P φ → False :=
by
  intro Ω _ _ W hWt P _ _ φ hH
  classical
  obtain ⟨_, _, hUP⟩ := hH

  obtain ⟨ϖ, hϖ0, hϖm⟩ : ∃ ϖ : ↥W, ϖ ≠ 0 ∧ ϖ ∈ IsLocalRing.maximalIdeal ↥W := by
    have hex : ∃ x : Ω, x ∉ W := by
      by_contra h
      push_neg at h
      exact hWt (eq_top_iff.mpr (fun x _ => h x))
    obtain ⟨x, hx⟩ := hex
    have hxinv : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
    have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
    refine ⟨⟨x⁻¹, hxinv⟩, ?_, ?_⟩
    · intro h
      have h' : x⁻¹ = 0 := congrArg Subtype.val h
      exact hx0 (inv_eq_zero.mp h')
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u, hu⟩
      apply hx
      have h1 : ((u⁻¹ : (↥W)ˣ) : ↥W) * ⟨x⁻¹, hxinv⟩ = 1 := by rw [← hu]; exact u.inv_mul
      have h2 : ((((u⁻¹ : (↥W)ˣ) : ↥W) : Ω)) * x⁻¹ = 1 := congrArg Subtype.val h1
      have h3 : ((((u⁻¹ : (↥W)ˣ) : ↥W) : Ω)) = x := (mul_inv_eq_one₀ hx0).mp h2
      rw [← h3]
      exact SetLike.coe_mem _

  have hsub : ∀ f : MvPolynomial (Fin 2) ↥W,
      f - MvPolynomial.C (MvPolynomial.constantCoeff f) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
    intro f
    refine MvPolynomial.induction_on (motive := fun f => f - MvPolynomial.C
      (MvPolynomial.constantCoeff f) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)))
      f ?_ ?_ ?_
    · intro a
      simp
    · intro p q hp hq
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      show p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) ∈ _
      rw [e]
      exact add_mem hp hq
    · intro p n _
      have e : p * MvPolynomial.X n -
          MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n)) =
          p * MvPolynomial.X n := by
        simp
      show p * MvPolynomial.X n -
          MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n)) ∈ _
      rw [e]
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      fin_cases n <;> simp
  have hmemp : ∀ f : MvPolynomial (Fin 2) ↥W,
      MvPolynomial.constantCoeff f ∈ IsLocalRing.maximalIdeal ↥W →
      Ideal.Quotient.mk (wcNcIdeal W 0) f ∈ Ideal.map (Ideal.Quotient.mk (wcNcIdeal W 0))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
    intro f hf
    apply Ideal.mem_map_of_mem
    have key : f = (f - MvPolynomial.C (MvPolynomial.constantCoeff f)) +
        MvPolynomial.C (MvPolynomial.constantCoeff f) := (sub_add_cancel _ _).symm
    rw [key]
    exact add_mem (Ideal.mem_sup_left (hsub f))
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem MvPolynomial.C hf))

  have hhens : HenselianLocalRing ↥W := by
    refine ⟨fun f hf a₀ h₁ _ => ?_⟩
    have h2 : W.valuation (algebraMap W Ω (f.eval a₀)) < 1 := (W.valuation_lt_one_iff _).mp h₁
    have hsplit := IsAlgClosed.splits (f.map (algebraMap W Ω))
    have h3 := Polynomial.Splits.aeval_eq_prod_aroots_of_monic hsplit hf (algebraMap W Ω a₀)
    rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at h3
    rw [h3] at h2
    have h4 : ∃ α ∈ f.aroots Ω, W.valuation (algebraMap W Ω a₀ - α) < 1 := by
      by_contra hcon
      push_neg at hcon
      rw [map_multiset_prod, Multiset.map_map] at h2
      have : 1 ≤ ((f.aroots Ω).map (W.valuation ∘ fun α => algebraMap W Ω a₀ - α)).prod := by
        apply Multiset.one_le_prod
        intro x hx
        obtain ⟨α, hα, rfl⟩ := Multiset.mem_map.mp hx
        exact hcon α hα
      exact absurd h2 (not_lt.mpr this)
    obtain ⟨α, hα, hv⟩ := h4
    have hα' := (Polynomial.mem_aroots.mp hα).2
    have hint : _root_.IsIntegral W α := ⟨f, hf, by rwa [← Polynomial.aeval_def]⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, ?_, ?_⟩
    · show Polynomial.eval y f = 0
      apply FaithfulSMul.algebraMap_injective W Ω
      rw [map_zero, ← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval, hy]
      exact hα'
    · rw [W.valuation_lt_one_iff]
      have e : ((y - a₀ : W) : Ω) = algebraMap W Ω y - algebraMap W Ω a₀ := by
        simp only [ValuationSubring.algebraMap_apply]; push_cast; rfl
      rw [e, hy, Valuation.map_sub_swap]
      exact hv

  have hpoint : ∀ v : Fin 2 → ↥W, v 0 * v 1 = 0 → (∀ i, v i ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ h : P →+* ↥W, ∀ f : MvPolynomial (Fin 2) ↥W,
        h (φ (Ideal.Quotient.mk (wcNcIdeal W 0) f)) = MvPolynomial.eval v f := by
    intro v hv hvm
    have hker : ∀ a ∈ wcNcIdeal W 0, MvPolynomial.eval v a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp [hv]
    let g : wcNcRing W 0 →+* ↥W := Ideal.Quotient.lift (wcNcIdeal W 0) (MvPolynomial.eval v) hker
    have hg : ∀ f, g (Ideal.Quotient.mk (wcNcIdeal W 0) f) = MvPolynomial.eval v f := fun f =>
      Ideal.Quotient.lift_mk _ _ _
    have hres : ∀ f : MvPolynomial (Fin 2) ↥W, IsLocalRing.residue ↥W (MvPolynomial.eval v f) =
        IsLocalRing.residue ↥W (MvPolynomial.constantCoeff f) := by
      intro f
      have e : (IsLocalRing.residue ↥W).comp (MvPolynomial.eval v) =
          (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp
        · intro i
          simp only [RingHom.comp_apply, MvPolynomial.eval_X, MvPolynomial.constantCoeff_X,
            map_zero]
          exact (IsLocalRing.residue_eq_zero_iff _).mpr (hvm i)
      exact RingHom.congr_fun e f
    have hle : Ideal.map (Ideal.Quotient.mk (wcNcIdeal W 0))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ≤
        Ideal.comap g (IsLocalRing.maximalIdeal ↥W) := by
      rw [Ideal.map_le_iff_le_comap]
      apply sup_le
      · rw [Ideal.span_le]
        intro z hz
        have hz' : z = MvPolynomial.X 0 ∨ z = MvPolynomial.X 1 := hz
        rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, hg]
        rcases hz' with rfl | rfl
        · rw [MvPolynomial.eval_X]; exact hvm 0
        · rw [MvPolynomial.eval_X]; exact hvm 1
      · rw [Ideal.map_le_iff_le_comap]
        intro μ hμ
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, hg, MvPolynomial.eval_C]
        exact hμ
    have hloc : ∀ a, IsUnit (g a) ↔ a ∉ Ideal.map (Ideal.Quotient.mk (wcNcIdeal W 0))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
      intro a
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
      constructor
      · intro hu hp
        exact (IsLocalRing.mem_maximalIdeal _).mp (hle hp) hu
      · intro hnp
        by_contra hu
        have hm : g (Ideal.Quotient.mk (wcNcIdeal W 0) f) ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.mem_maximalIdeal _).mpr hu
        apply hnp
        apply hmemp
        rw [hg] at hm
        rw [← IsLocalRing.residue_eq_zero_iff, ← hres, IsLocalRing.residue_eq_zero_iff]
        exact hm
    obtain ⟨h, ⟨hh, _⟩, _⟩ := hUP (↥W) hhens g hloc
    refine ⟨h, fun f => ?_⟩
    have e := RingHom.congr_fun hh (Ideal.Quotient.mk (wcNcIdeal W 0) f)
    rw [RingHom.comp_apply] at e
    rw [e, hg]

  have hxy : Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 0) *
      Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 1) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    have e : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W) =
        MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C 0 := by simp
    rw [e]
    exact Ideal.subset_span rfl
  obtain ⟨h1, hh1⟩ := hpoint ![ϖ, 0] (by simp) (by intro i; fin_cases i <;> simp [hϖm])
  obtain ⟨h2, hh2⟩ := hpoint ![0, ϖ] (by simp) (by intro i; fin_cases i <;> simp [hϖm])
  have hφ := congrArg φ hxy
  rw [map_mul, map_zero] at hφ
  rcases mul_eq_zero.mp hφ with h | h
  · have e := hh1 (MvPolynomial.X 0)
    rw [h, map_zero, MvPolynomial.eval_X] at e
    exact hϖ0 (by simpa using e.symm)
  · have e := hh2 (MvPolynomial.X 1)
    rw [h, map_zero, MvPolynomial.eval_X] at e
    exact hϖ0 (by simpa using e.symm)

theorem wcpa_dj_llsm_sd_good_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b ∣ g ∧ z0 = u)) →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0 →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [Q.IsPrime],
    Q.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) Q) →
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime Q →+* P),
    wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) P e →
    wcNdModelA W P (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) ∨
    wcNdModelB W P (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 k hPD z0 b hb hb0 hshape s hs Q _ hQ hgood
    P _ e he
  classical

  have hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 k hPD s
  obtain ⟨hFT, hFl, hj, hnorm⟩ :=
    wcpa_dj_llsm_sdg_chart_ring Ω W hW hWt A K L 𝔭 k hPD s hfin
  obtain ⟨hQmax, hQW, hdle⟩ :=
    wcpa_dj_llsm_sdg_fibre_dim Ω W hW hWt A K L 𝔭 k hPD z0 b hb hb0 hshape s hs Q hQ hfin
  have hns := wcpa_dj_llsm_sdg_pd_not_surj W A 𝔭 k hPD
  have hdge := wcpa_dj_llsm_sdg_not_isolated Ω W hW hWt A K L 𝔭 k hPD z0 b hb hb0 hshape s hs
    Q hQ hfin hQmax hQW hns
  haveI : IsIntegrallyClosed ↥(integralClosure ↥(Algebra.adjoin A {s}) L) := hnorm
  haveI : Q.IsMaximal := hQmax
  letI : Algebra ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L) := (wcSdgJ W A K L s).toAlgebra

  haveI hLFT : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L)))) :=
    HasRingHomProperty.Spec_iff.mpr hFT
  have hFlat : Flat (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L)))) :=
    HasRingHomProperty.Spec_iff.mpr hFl
  obtain ⟨w, hw, hwcl, ⟨ψ₀⟩⟩ :=
    wcpa_dj_llsm_sdg_affine_fibre_point ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L) Q hQW

  have hS : {x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (x : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
      (wcSdgJ W A K L s) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W) := by
    ext x
    constructor
    · rintro ⟨w, hw, hx⟩
      exact ⟨w, hw, Subtype.ext (by rw [hx]; rfl)⟩
    · rintro ⟨w, hw, rfl⟩
      exact ⟨w, hw, rfl⟩
  have hI : (Ideal.span {x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (x : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}).map
        (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Q)) =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Q)).comp
          (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L))) := by
    rw [hS, ← Ideal.map_map]
    rfl
  let ψ := ψ₀.trans (Ideal.quotEquivOfEq hI).symm

  haveI hCQn : IsIntegrallyClosed (Localization.AtPrime Q) :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime Q) Q.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors Q)
  have hinj : Function.Injective
      ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime Q)).comp
        (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L))) :=
    (IsLocalization.injective (Localization.AtPrime Q)
      (Ideal.primeCompl_le_nonZeroDivisors Q)).comp hj
  haveI hred0 := wcpa_dj_llsm_sdg_reduced_quotient Ω W (Localization.AtPrime Q) _ hinj
  have hred : _root_.IsReduced ↑((Limits.pullback (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L))))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk
        w) :=
    isReduced_of_injective ψ₀ ψ₀.injective
  have hdim := ringKrullDim_eq_of_ringEquiv ψ
  have hdim1 := le_antisymm (hdim.trans_le hdle) (hdge.trans_eq hdim.symm)
  obtain ⟨hδ, hbr⟩ := wcpa_dj_lr1k_llfi_ringequiv _ _ ψ
  have hg := not_not.mp hgood

  obtain ⟨e', he', hcomp⟩ :=
    wcpa_dj_llsm_sdg_hens_bridge ↥W ↥(integralClosure ↥(Algebra.adjoin A {s}) L) Q P e he
  haveI hPdom : IsDomain P :=
    (wcNd_hens_normal_domain (Localization.AtPrime Q) (IsLocalRing.maximalIdeal _)
      inferInstance P e he).1
  rcases hg with h0 | ⟨h1, h2⟩
  ·
    have hch := wcpa_dj_llsm_sdg_smooth_chart Ω W _ _ hFlat w hwcl hred hdim1 (hδ.trans h0)
    rw [hw] at hch
    obtain ⟨φ, hφ, hhens⟩ := wcpa_dj_lr1k_lf_chart_transfer _ _ _ _ _ _ hch P e' he'
    left
    refine ⟨φ, ?_, hhens⟩
    rw [← Polynomial.algebraMap_eq]
    exact hφ.trans hcomp
  ·
    obtain ⟨a, ham, hch⟩ := wcpa_dj_llsm_sdg_node_chart Ω W _ _ hFlat w hwcl hred hdim1.le
      (hδ.trans h1) (hbr.trans h2)
    rw [hw] at hch
    obtain ⟨φ, hφ, hhens⟩ := wcpa_dj_lr1k_lf_chart_transfer _ _ _ _ _ _ hch P e' he'
    have ha : a ≠ 0 := by
      rintro rfl
      exact wcpa_dj_llsm_sdg_node_a_ne_zero Ω W hWt P φ hhens
    right
    exact ⟨a, ham, ha, φ, hφ.trans hcomp, hhens⟩

theorem wcpa_dj_llsm_mg_chart_props : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (E : Type u) [Field E] [Algebra K E] [FiniteDimensional K E] (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k → ∀ (s : K), Module.Finite ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E) → IsIntegrallyClosed ↥(integralClosure ↥(Algebra.adjoin A {s}) E) ∧ Function.Injective ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) ∧ ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).FiniteType ∧ ∀ w : ↥W, ((((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) w : ↥(integralClosure ↥(Algebra.adjoin A {s}) E)) : E) = ((algebraMap K E).comp ((algebraMap A K).comp (algebraMap ↥W A))) w :=
by
  intro Ω _ W A _ _ _ K _ _ _ E _ _ _ 𝔭 k hPD s hfin
  have hFT : Algebra.FiniteType ↥W A := hPD.1
  have hNZ : NoZeroSMulDivisors ↥W A := hPD.2.1

  have hcoe : ∀ w : ↥W, ((((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) w : ↥(integralClosure ↥(Algebra.adjoin A {s}) E)) : E) = ((algebraMap K E).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := by
    intro w
    rfl

  have hft : ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).FiniteType := by
    have h1 : (algebraMap ↥W A).FiniteType := RingHom.finiteType_algebraMap.mpr hFT
    have hfg : (Algebra.adjoin A ({s} : Set K)).FG := by
      simpa using Subalgebra.fg_adjoin_finset (R := A) ({s} : Finset K)
    have h2 : (algebraMap A ↥(Algebra.adjoin A {s})).FiniteType :=
      RingHom.finiteType_algebraMap.mpr ((Subalgebra.fg_iff_finiteType _).mp hfg)
    have h3 : (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).FiniteType :=
      RingHom.FiniteType.of_finite (RingHom.finite_algebraMap.mpr hfin)
    exact h3.comp (h2.comp h1)

  have hWA : Function.Injective (algebraMap ↥W A) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have h0 : w • (1 : A) = 0 := by rw [Algebra.smul_def, hw, zero_mul]
    rcases eq_zero_or_eq_zero_of_smul_eq_zero h0 with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hwE : Function.Injective ((algebraMap K E).comp ((algebraMap A K).comp (algebraMap ↥W A))) := by
    rw [RingHom.coe_comp, RingHom.coe_comp]
    exact (algebraMap K E).injective.comp ((IsFractionRing.injective A K).comp hWA)
  have hinj : Function.Injective ((algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))) := by
    intro w₁ w₂ h
    apply hwE
    rw [← hcoe, ← hcoe, h]

  haveI hfs : FaithfulSMul ↥(Algebra.adjoin A {s}) K := by
    rw [faithfulSMul_iff_algebraMap_injective]
    intro x y h
    exact Subtype.ext h
  have hsurj : ∀ z : K, ∃ x y : ↥(Algebra.adjoin A {s}),
      z = algebraMap ↥(Algebra.adjoin A {s}) K x / algebraMap ↥(Algebra.adjoin A {s}) K y := by
    intro z
    obtain ⟨x, y, -, hz⟩ := IsFractionRing.div_surjective A z
    exact ⟨algebraMap A ↥(Algebra.adjoin A {s}) x, algebraMap A ↥(Algebra.adjoin A {s}) y, hz.symm⟩
  haveI : IsFractionRing ↥(Algebra.adjoin A {s}) K := IsFractionRing.of_field _ K hsurj
  have ha : IsIntegrallyClosed ↥(integralClosure ↥(Algebra.adjoin A {s}) E) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (R := ↥(Algebra.adjoin A {s})) K (L := E)
  exact ⟨ha, hinj, hft, hcoe⟩

theorem wcpa_dj_llsm_mg_fibre_reduced : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (σ : ↥W →+* R), Function.Injective σ → _root_.IsReduced (R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) :=
by
  intro Ω _ _ W R _ _ _ σ _
  classical
  have s1 : ∀ x ∈ (IsLocalRing.maximalIdeal ↥W).map σ,
      ∃ m ∈ IsLocalRing.maximalIdeal ↥W, ∃ r : R, x = σ m * r := by
    intro x hx
    rw [Ideal.map] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨m, hm, rfl⟩ := hy
      exact ⟨m, hm, 1, (mul_one _).symm⟩
    | zero => exact ⟨0, (IsLocalRing.maximalIdeal ↥W).zero_mem, 0, by simp⟩
    | add y z _ _ hy hz =>
      obtain ⟨m, hm, r, rfl⟩ := hy
      obtain ⟨m', hm', r', rfl⟩ := hz
      rcases ValuationRing.dvd_total m m' with ⟨c, rfl⟩ | ⟨c, rfl⟩
      · exact ⟨m, hm, r + σ c * r', by rw [map_mul]; ring⟩
      · exact ⟨m', hm', σ c * r + r', by rw [map_mul]; ring⟩
    | smul a y _ hy =>
      obtain ⟨m, hm, r, rfl⟩ := hy
      exact ⟨m, hm, a * r, by rw [smul_eq_mul]; ring⟩
  have s2 : ∀ (m : ↥W) (n : ℕ), 0 < n → m ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ τ ∈ IsLocalRing.maximalIdeal ↥W, τ ^ n = m := by
    intro m n hn hm
    obtain ⟨t, ht⟩ := IsAlgClosed.exists_pow_nat_eq (m : Ω) hn
    have htW : t ∈ W := by
      rcases W.mem_or_inv_mem t with h | h
      · exact h
      · by_cases ht0 : t = 0
        · rw [ht0]; exact W.zero_mem
        · obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
          have e : t = (m : Ω) * t⁻¹ ^ k := by
            rw [← ht, pow_succ, inv_pow, mul_comm (t ^ k) t, mul_assoc,
              mul_inv_cancel₀ (pow_ne_zero k ht0), mul_one]
          rw [e]
          exact mul_mem m.2 (pow_mem h k)
    have hτ : (⟨t, htW⟩ : ↥W) ^ n = m := Subtype.ext (by simp [ht])
    refine ⟨⟨t, htW⟩, ?_, hτ⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hm ⊢
    intro hu
    apply hm
    rw [← hτ]
    exact hu.pow n
  have hrad : ((IsLocalRing.maximalIdeal ↥W).map σ).IsRadical := by
    intro x hx
    obtain ⟨n, hn⟩ := hx
    rcases Nat.eq_zero_or_pos n with rfl | hpos
    · rw [pow_zero] at hn
      rw [Ideal.eq_top_of_isUnit_mem _ hn isUnit_one]
      trivial
    · obtain ⟨m, hm, r, hr⟩ := s1 _ hn
      obtain ⟨τ, hτ, rfl⟩ := s2 m n hpos hm
      have hdvd : σ τ ^ n ∣ x ^ n := ⟨r, by rw [hr, map_pow]⟩
      obtain ⟨s, rfl⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff hpos.ne').mp hdvd
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem σ hτ)
  exact (Ideal.isRadical_iff_quotient_reduced _).mp hrad

theorem wcpa_dj_llsm_mg_fibre_noeth_norm : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (C : Type u) [CommRing C] (σ : ↥W →+* C), σ.FiniteType → ∀ (𝔮 : Ideal C) [𝔮.IsPrime], (IsLocalRing.maximalIdeal ↥W).map σ ≤ 𝔮 → _root_.IsReduced (C ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) → IsNoetherianRing (Localization.AtPrime 𝔮 ⧸ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C (Localization.AtPrime 𝔮)).comp σ)) ∧ Module.Finite (Localization.AtPrime 𝔮 ⧸ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C (Localization.AtPrime 𝔮)).comp σ)) ↥(integralClosure (Localization.AtPrime 𝔮 ⧸ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C (Localization.AtPrime 𝔮)).comp σ)) (FractionRing (Localization.AtPrime 𝔮 ⧸ (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C (Localization.AtPrime 𝔮)).comp σ)))) :=
by
  intro Ω _ _ W C _ σ hσ 𝔮 _ hle hred
  classical
  set I : Ideal C := (IsLocalRing.maximalIdeal ↥W).map σ with hI
  set L := Localization.AtPrime 𝔮 with hL
  set J : Ideal L := (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C L).comp σ) with hJ
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI : PerfectField (IsLocalRing.ResidueField ↥W) := IsAlgClosed.perfectField _
  let φ : IsLocalRing.ResidueField ↥W →+* C ⧸ I :=
    Ideal.quotientMap I σ Ideal.le_comap_map
  have hφ : φ.FiniteType := by
    have hcomp : φ.comp (IsLocalRing.residue ↥W) = (Ideal.Quotient.mk I).comp σ := by
      apply RingHom.ext
      intro w
      rfl
    apply RingHom.FiniteType.of_comp_finiteType (f := IsLocalRing.residue ↥W)
    rw [hcomp]
    exact RingHom.FiniteType.comp
      (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective) hσ
  letI : Algebra (IsLocalRing.ResidueField ↥W) (C ⧸ I) := φ.toAlgebra
  haveI : Algebra.FiniteType (IsLocalRing.ResidueField ↥W) (C ⧸ I) := hφ
  haveI : IsNoetherianRing (C ⧸ I) :=
    Algebra.FiniteType.isNoetherianRing (IsLocalRing.ResidueField ↥W) (C ⧸ I)
  haveI : _root_.IsReduced (C ⧸ I) := hred
  have hker : RingHom.ker (Ideal.Quotient.mk I) = I := Ideal.mk_ker
  set 𝔮' : Ideal (C ⧸ I) := 𝔮.map (Ideal.Quotient.mk I) with h𝔮'def
  haveI h𝔮' : 𝔮'.IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [hker]; exact hle)
  have hcomap : 𝔮'.comap (Ideal.Quotient.mk I) = 𝔮 := by
    rw [h𝔮'def, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, hker]
    exact sup_eq_left.mpr hle
  have hJI : J = I.map (algebraMap C L) := by
    rw [hJ, hI, Ideal.map_map]
  let lam : C ⧸ I →+* L ⧸ J :=
    Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp (algebraMap C L)) (by
      intro a ha
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hJI]
      exact Ideal.mem_map_of_mem _ ha)
  letI : Algebra (C ⧸ I) (L ⧸ J) := lam.toAlgebra
  have hloc0 : IsLocalization (Submonoid.map (Ideal.Quotient.mk I) 𝔮.primeCompl) (L ⧸ J) := by
    apply IsLocalization.of_surjective 𝔮.primeCompl L (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    · apply RingHom.ext
      intro x
      rfl
    · rw [Ideal.mk_ker, hker, hJI]
  have hsub : Submonoid.map (Ideal.Quotient.mk I) 𝔮.primeCompl = 𝔮'.primeCompl := by
    ext d
    constructor
    · rintro ⟨x, hx, rfl⟩
      intro hd
      apply hx
      rw [← hcomap]
      exact hd
    · intro hd
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective d
      refine ⟨x, ?_, rfl⟩
      intro hx
      exact hd (Ideal.mem_map_of_mem _ hx)
  haveI hloc : IsLocalization.AtPrime (L ⧸ J) 𝔮' := by
    show IsLocalization 𝔮'.primeCompl (L ⧸ J)
    rw [← hsub]
    exact hloc0
  refine ⟨IsLocalization.isNoetherianRing 𝔮'.primeCompl (L ⧸ J) inferInstance, ?_⟩
  exact wcpa_dj_lr1k_imfc_stalk_norm_finite (IsLocalRing.ResidueField ↥W) (C ⧸ I) 𝔮' (L ⧸ J)

theorem wcpa_dj_llsm_mg_model_levels : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] [IsLocalRing R] (σ : ↥W →+* R), (IsLocalRing.maximalIdeal ↥W).map σ ≤ IsLocalRing.maximalIdeal R → ∀ [IsLocalRing (R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ)] (P : Type u) [CommRing P] (e : R →+* P), wcNdIsHens (IsLocalRing.maximalIdeal R) P e → (wcNdModelA W P (e.comp σ) → ∀ n : ℕ, Nonempty (((R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) ⧸ IsLocalRing.maximalIdeal (R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) ^ n) ≃+* (Polynomial (IsLocalRing.ResidueField ↥W) ⧸ Ideal.span {(Polynomial.X ^ n : Polynomial (IsLocalRing.ResidueField ↥W))}))) ∧ (wcNdModelB W P (e.comp σ) → ∃ θ : ∀ n : ℕ, ((R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) ⧸ IsLocalRing.maximalIdeal (R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) ^ n) ≃+* (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W))} ⊔ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)), MvPolynomial.X 1} ^ n)), ∀ (n : ℕ) (x : R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ) (y : MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)), θ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y → θ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y) :=
by
  intro Ω _ W R _ _ σ hle _ P _ e he

  have s1 : ∀ (A R : Type u) [CommRing A] [IsLocalRing A] [CommRing R] [IsLocalRing R]
      (s : A →+* R) (K : Ideal A), Function.Surjective s → RingHom.ker s = K →
      ∃ ρ : ∀ n : ℕ, (R ⧸ IsLocalRing.maximalIdeal R ^ n) ≃+*
        (A ⧸ (K ⊔ IsLocalRing.maximalIdeal A ^ n)),
        ∀ (n : ℕ) (x : R) (y : A), ρ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
          ρ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y := by
    intro A R _ _ _ _ s K hs hK
    have hΦs : ∀ n : ℕ,
        Function.Surjective ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) :=
      fun n => Ideal.Quotient.mk_surjective.comp hs
    have hΦk : ∀ n : ℕ, RingHom.ker ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) =
        K ⊔ IsLocalRing.maximalIdeal A ^ n := by
      intro n
      rw [← RingHom.comap_ker, Ideal.mk_ker, ← IsLocalRing.map_maximalIdeal_of_surjective s hs,
        ← Ideal.map_pow, Ideal.comap_map_of_surjective' s hs, hK, sup_comm]
    let ρ : ∀ n : ℕ, (R ⧸ IsLocalRing.maximalIdeal R ^ n) ≃+*
        (A ⧸ (K ⊔ IsLocalRing.maximalIdeal A ^ n)) :=
      fun n => (RingHom.quotientKerEquivOfSurjective (hΦs n)).symm.trans
        (Ideal.quotEquivOfEq (hΦk n))
    have hρ : ∀ (n : ℕ) (a : A), ρ n (Ideal.Quotient.mk _ (s a)) = Ideal.Quotient.mk _ a := by
      intro n a
      have h1 : (RingHom.quotientKerEquivOfSurjective (hΦs n)).symm
          (((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) a) =
            Ideal.Quotient.mk _ a := by
        rw [RingEquiv.symm_apply_eq]; rfl
      show (Ideal.quotEquivOfEq (hΦk n)) ((RingHom.quotientKerEquivOfSurjective (hΦs n)).symm
        (((Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp s) a)) = _
      rw [h1, Ideal.quotEquivOfEq_mk]
    refine ⟨ρ, fun n x y hxy => ?_⟩
    obtain ⟨a, rfl⟩ := hs x
    rw [hρ] at hxy ⊢
    rw [Ideal.Quotient.eq] at hxy ⊢
    have hle : K ⊔ IsLocalRing.maximalIdeal A ^ (n + 1) ≤ K ⊔ IsLocalRing.maximalIdeal A ^ n :=
      sup_le_sup_left (Ideal.pow_le_pow_right (Nat.le_succ n)) K
    exact hle hxy
  obtain ⟨ρ, hρ⟩ := s1 R (R ⧸ (IsLocalRing.maximalIdeal ↥W).map σ)
    (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map σ)) ((IsLocalRing.maximalIdeal ↥W).map σ)
    Ideal.Quotient.mk_surjective Ideal.mk_ker

  have key : ∀ {T : Type u} [CommRing T] (c : ↥W →+* T) (𝔫 : Ideal T) (f : T →+* P),
      𝔫.IsMaximal → Ideal.map c (IsLocalRing.maximalIdeal ↥W) ≤ 𝔫 → wcNdIsHens 𝔫 P f →
      f.comp c = e.comp σ →
      ∃ θ : ∀ n : ℕ, (R ⧸ (Ideal.map σ (IsLocalRing.maximalIdeal ↥W) ⊔
          IsLocalRing.maximalIdeal R ^ n)) ≃+*
        (T ⧸ (Ideal.map c (IsLocalRing.maximalIdeal ↥W) ⊔ 𝔫 ^ n)),
        ∀ (n : ℕ) (x : R) (y : T), θ (n + 1) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y →
          θ n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ y := by
    intro T _ c 𝔫 f h𝔫 hc hf hfc
    have hmap : Ideal.map e (Ideal.map σ (IsLocalRing.maximalIdeal ↥W)) =
        Ideal.map f (Ideal.map c (IsLocalRing.maximalIdeal ↥W)) := by
      rw [Ideal.map_map, Ideal.map_map, hfc]
    exact wcpa_dj_lr1k_ndmf_hens_levels R T P (IsLocalRing.maximalIdeal R) 𝔫 e f
      inferInstance h𝔫 he hf _ _ hle hc hmap
  refine ⟨fun hA n => ?_, fun hB => ?_⟩
  · obtain ⟨f, hfc, hf⟩ := hA
    obtain ⟨h𝔫, ψ, -⟩ := wcpa_dj_lr1k_ndmf_modelA_levels Ω W
    obtain ⟨θ, -⟩ := key Polynomial.C _ f h𝔫 le_sup_right hf hfc
    exact ⟨(ρ n).trans ((θ n).trans (ψ n))⟩
  · obtain ⟨g, hg, _hg0, f, hfc, hf⟩ := hB
    have hker : RingHom.ker (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})) = Ideal.span {(MvPolynomial.X 0 *
          MvPolynomial.X 1 - MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)} := Ideal.mk_ker
    obtain ⟨h𝔫, ψ, hψ⟩ := wcpa_dj_lr1k_ndmf_modelB_levels Ω W g hg
      (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})
      (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}))
      Ideal.Quotient.mk_surjective hker
    have hc : Ideal.map ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C)
          (IsLocalRing.maximalIdeal ↥W) ≤
        Ideal.map (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C g : MvPolynomial (Fin 2) ↥W)}))
          (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
            Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
      rw [← Ideal.map_map]
      exact Ideal.map_mono le_sup_right
    obtain ⟨θ, hθ⟩ := key _ _ f h𝔫 hc hf hfc
    refine ⟨fun n => (ρ n).trans ((θ n).trans (ψ n)), ?_⟩
    intro n x y hxy
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (ρ (n + 1) (Ideal.Quotient.mk _ x))
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (θ (n + 1) (Ideal.Quotient.mk _ a))
    have ha' := hρ n x a ha.symm
    have ht' := hθ n a t ht.symm
    simp only [RingEquiv.trans_apply] at hxy ⊢
    rw [← ha, ← ht] at hxy
    rw [ha', ht']
    exact hψ n t y hxy

theorem wcpa_dj_llsm_mg_node_levels_dim : ∀ (R k : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [Field k], ((R ⧸ IsLocalRing.maximalIdeal R ^ 3) ≃+* (MvPolynomial (Fin 2) k ⧸ (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)} ⊔ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k), MvPolynomial.X 1} ^ 3))) → ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro R k _ _ _ _ θ
  classical
  set m := IsLocalRing.maximalIdeal R with hm
  set J : Ideal (MvPolynomial (Fin 2) k) :=
    Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)} ⊔
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k), MvPolynomial.X 1} ^ 3 with hJ

  have hJcc : J ≤ RingHom.ker (MvPolynomial.constantCoeff (R := k) (σ := Fin 2)) := by
    apply sup_le
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      simp
    · refine le_trans (Ideal.pow_le_self (by norm_num)) ?_
      rw [Ideal.span_le]
      intro p hp
      rcases hp with rfl | rfl <;> simp [RingHom.mem_ker]
  have hspan : ∀ f : MvPolynomial (Fin 2) k, MvPolynomial.constantCoeff f = 0 →
      ∃ g h : MvPolynomial (Fin 2) k, f = g * MvPolynomial.X 0 + h * MvPolynomial.X 1 := by
    intro f hf
    have hf0 : f.coeff 0 = 0 := by
      rw [← hf, MvPolynomial.constantCoeff_eq]
    have hmem : f ∈ Ideal.span (MvPolynomial.X '' Set.univ : Set (MvPolynomial (Fin 2) k)) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro mo hmo
      have hne : mo ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hmo) hf0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ _, hi⟩
    have himg : (MvPolynomial.X '' Set.univ : Set (MvPolynomial (Fin 2) k)) =
        {MvPolynomial.X 0, MvPolynomial.X 1} := by
      ext p
      simp [Fin.exists_fin_two, eq_comm]
    rw [himg, Ideal.mem_span_pair] at hmem
    obtain ⟨g, h, hgh⟩ := hmem
    exact ⟨g, h, hgh.symm⟩
  have hnil0 : ∀ f : MvPolynomial (Fin 2) k, IsNilpotent (Ideal.Quotient.mk J f) →
      MvPolynomial.constantCoeff f = 0 := by
    intro f hf
    have := hf.map (Ideal.Quotient.lift J MvPolynomial.constantCoeff
      (fun a ha => RingHom.mem_ker.mp (hJcc ha)))
    rw [Ideal.Quotient.lift_mk] at this
    exact this.eq_zero
  have hmodel : ∀ u v : MvPolynomial (Fin 2) k ⧸ J, IsNilpotent u → IsNilpotent v →
      ∃ w, u * v = Ideal.Quotient.mk J (MvPolynomial.X 0 + MvPolynomial.X 1) * w := by
    intro u v hu hv
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨f', rfl⟩ := Ideal.Quotient.mk_surjective v
    obtain ⟨g, h, rfl⟩ := hspan f (hnil0 f hu)
    obtain ⟨g', h', rfl⟩ := hspan f' (hnil0 f' hv)
    refine ⟨Ideal.Quotient.mk J (g * g' * MvPolynomial.X 0 + h * h' * MvPolynomial.X 1), ?_⟩
    rw [← map_mul, ← map_mul, Ideal.Quotient.eq]
    apply Ideal.mem_sup_left
    rw [Ideal.mem_span_singleton]
    exact ⟨g * h' + h * g' - g * g' - h * h', by ring⟩

  obtain ⟨t, ht⟩ : ∃ t : R, θ (Ideal.Quotient.mk (m ^ 3) t) =
      Ideal.Quotient.mk J (MvPolynomial.X 0 + MvPolynomial.X 1) := by
    obtain ⟨y, hy⟩ := θ.surjective (Ideal.Quotient.mk J (MvPolynomial.X 0 + MvPolynomial.X 1))
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨t, hy⟩
  have hmax : m.IsPrime := (IsLocalRing.maximalIdeal.isMaximal R).isPrime
  have hzero : ∀ x : R, θ (Ideal.Quotient.mk (m ^ 3) x) = 0 → x ∈ m ^ 3 := by
    intro x hx
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact θ.injective (hx.trans (map_zero θ).symm)

  have htm : t ∈ m := by
    have h3 : (MvPolynomial.X 0 + MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ^ 3 ∈ J := by
      apply Ideal.mem_sup_right
      apply Ideal.pow_mem_pow
      exact Ideal.mem_span_pair.mpr ⟨1, 1, by ring⟩
    have h3' : t ^ 3 ∈ m ^ 3 := by
      apply hzero
      rw [map_pow, map_pow, ht, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
      exact h3
    exact hmax.mem_of_pow_mem 3 (Ideal.pow_le_self (by norm_num) h3')
  have hnilR : ∀ a ∈ m, IsNilpotent (θ (Ideal.Quotient.mk (m ^ 3) a)) := by
    intro a ha
    refine ⟨3, ?_⟩
    rw [← map_pow, ← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow ha 3),
      map_zero]

  have h5 : m ^ 2 ≤ Ideal.span {t} ⊔ m ^ 3 := by
    rw [sq]
    apply Ideal.mul_le.mpr
    intro a ha b hb
    obtain ⟨w, hw⟩ := hmodel _ _ (hnilR a ha) (hnilR b hb)
    obtain ⟨y, hy⟩ := θ.surjective w
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hab : a * b - t * c ∈ m ^ 3 := by
      rw [← Ideal.Quotient.eq]
      apply θ.injective
      rw [map_mul, map_mul, map_mul, map_mul, hw, ht, hy]
    rw [Ideal.mem_span_singleton_sup]
    exact ⟨c, a * b - t * c, hab, by ring⟩

  have h6 : m ^ 2 ≤ Ideal.span {t} := by
    have hfg : (m ^ 2).FG := IsNoetherian.noetherian _
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (I := m) hfg ?_ ?_
    · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    · rw [Ideal.smul_eq_mul, ← pow_succ']
      exact h5
  have hmin : m ∈ (Ideal.span {t}).minimalPrimes := by
    refine ⟨⟨hmax, (Ideal.span_singleton_le_iff_mem _).mpr htm⟩, ?_⟩
    rintro p ⟨hp, htp⟩ _
    exact hp.le_of_pow_le (h6.trans htp)
  have hht := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes_of_isLocalRing
    (Ideal.span {t}) hmin
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
  exact_mod_cast hht

theorem wcpa_dj_llsm_sd_model_good : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (E : Type u) [Field E] [Algebra K E] [FiniteDimensional K E]
    (𝔭 : Ideal A) (k : wcLlsKind W A), wcLlsPD W A 𝔭 k →
    ∀ (z0 : A) (b : ↥W), b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z0 = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ b ∣ g ∧ z0 = u)) →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z0 →
    ∀ (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) E)) [𝔮.IsPrime],
    𝔮.comap (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)) =
      Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z0,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) →
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime 𝔮 →+* P),
    wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) P e →
    (wcNdModelA W P (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) E)
        (Localization.AtPrime 𝔮)).comp ((algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))))) ∨
     wcNdModelB W P (e.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) E)
        (Localization.AtPrime 𝔮)).comp ((algebraMap ↥(Algebra.adjoin A {s})
        ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))))) →
    ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K E).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥(Algebra.adjoin A {s}) 𝔮) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ E _ _ _ 𝔭 k hPD z0 b hb hb0 hshape s hs 𝔮 h𝔮 hcomap
    P _ e hhens hmodel
  have hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K E 𝔭 k hPD s
  obtain ⟨hnorm, hinj, hft, hcoe⟩ := wcpa_dj_llsm_mg_chart_props Ω W A K E 𝔭 k hPD s hfin
  haveI := hnorm
  set ι : ↥W →+* ↥(integralClosure ↥(Algebra.adjoin A {s}) E) :=
    (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) E)).comp
      ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) with hι
  set σR : ↥W →+* Localization.AtPrime 𝔮 :=
    (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) E) (Localization.AtPrime 𝔮)).comp ι
    with hσR

  have hS : Ideal.span {c : ↥(integralClosure ↥(Algebra.adjoin A {s}) E) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : E) = ((algebraMap K E).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} =
      (IsLocalRing.maximalIdeal ↥W).map ι := by
    rw [Ideal.map]
    congr 1
    ext c
    constructor
    · rintro ⟨w, hw, hc⟩
      exact ⟨w, hw, Subtype.ext ((hcoe w).trans hc.symm)⟩
    · rintro ⟨w, hw, rfl⟩
      exact ⟨w, hw, hcoe w⟩
  have hSR : Ideal.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) E)
      (Localization.AtPrime 𝔮)) (Ideal.span {c : ↥(integralClosure ↥(Algebra.adjoin A {s}) E) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (c : E) = ((algebraMap K E).comp ((algebraMap A K).comp (algebraMap ↥W A))) w}) =
      (IsLocalRing.maximalIdeal ↥W).map σR := by
    rw [hS, Ideal.map_map]

  have hι𝔮 : (IsLocalRing.maximalIdeal ↥W).map ι ≤ 𝔮 := by
    rw [Ideal.map_le_iff_le_comap]
    intro μ hμ
    have h1 : ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) μ ∈
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) :=
      Ideal.mem_map_of_mem _ hμ
    have h2 : ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) μ ∈
        𝔮.comap (algebraMap ↥(Algebra.adjoin A {s})
          ↥(integralClosure ↥(Algebra.adjoin A {s}) E)) := by
      rw [hcomap]; exact Ideal.mem_sup_right h1
    exact Ideal.mem_comap.mpr (Ideal.mem_comap.mp h2)

  have gen : ∀ (C : Type u) [CommRing C] [IsDomain C] [IsIntegrallyClosed C] (ι : ↥W →+* C),
      Function.Injective ι → ι.FiniteType → ∀ (𝔮 : Ideal C) [𝔮.IsPrime],
      (IsLocalRing.maximalIdeal ↥W).map ι ≤ 𝔮 →
      ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime 𝔮 →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) P e →
      (wcNdModelA W P (e.comp ((algebraMap C (Localization.AtPrime 𝔮)).comp ι)) ∨
        wcNdModelB W P (e.comp ((algebraMap C (Localization.AtPrime 𝔮)).comp ι))) →
      ∀ J : Ideal (Localization.AtPrime 𝔮),
      J = (IsLocalRing.maximalIdeal ↥W).map ((algebraMap C (Localization.AtPrime 𝔮)).comp ι) →
      ¬ wcpaDjLkBad (Localization.AtPrime 𝔮 ⧸ J) := by
    intro C _ _ _ ι hinj hft 𝔮 _ hι𝔮 P _ e hhens hmodel J hJ
    subst hJ
    set σR : ↥W →+* Localization.AtPrime 𝔮 := (algebraMap C (Localization.AtPrime 𝔮)).comp ι
      with hσR
    have hle : (IsLocalRing.maximalIdeal ↥W).map σR ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [hσR, ← Ideal.map_map]
      calc Ideal.map (algebraMap C (Localization.AtPrime 𝔮)) ((IsLocalRing.maximalIdeal ↥W).map ι)
          ≤ Ideal.map (algebraMap C (Localization.AtPrime 𝔮)) 𝔮 := Ideal.map_mono hι𝔮
        _ = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) :=
            Localization.AtPrime.map_eq_maximalIdeal
    haveI : Nontrivial (Localization.AtPrime 𝔮 ⧸ (IsLocalRing.maximalIdeal ↥W).map σR) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top hle)
    haveI : IsLocalRing (Localization.AtPrime 𝔮 ⧸ (IsLocalRing.maximalIdeal ↥W).map σR) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    haveI : IsDomain (Localization.AtPrime 𝔮) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors 𝔮)
    haveI : IsIntegrallyClosed (Localization.AtPrime 𝔮) :=
      isIntegrallyClosed_of_isLocalization (Localization.AtPrime 𝔮) 𝔮.primeCompl
        (Ideal.primeCompl_le_nonZeroDivisors 𝔮)
    have hinjR : Function.Injective σR :=
      (IsLocalization.injective (Localization.AtPrime 𝔮)
        (Ideal.primeCompl_le_nonZeroDivisors 𝔮)).comp hinj
    have hredN := wcpa_dj_llsm_mg_fibre_reduced Ω W (Localization.AtPrime 𝔮) σR hinjR
    have hredC := wcpa_dj_llsm_mg_fibre_reduced Ω W C ι hinj
    obtain ⟨hnoeth, hnf⟩ := wcpa_dj_llsm_mg_fibre_noeth_norm Ω W C ι hft 𝔮 hι𝔮 hredC
    haveI := hnoeth
    obtain ⟨hA, hB⟩ :=
      wcpa_dj_llsm_mg_model_levels Ω W (Localization.AtPrime 𝔮) σR hle P e hhens
    intro hbad
    rcases hmodel with h | h
    · exact hbad (Or.inl (wcpa_dj_lr1k_ndmf_smooth_levels_delta _ _ (hA h)))
    · obtain ⟨θ, hθ⟩ := hB h
      have hdim := wcpa_dj_llsm_mg_node_levels_dim _ _ (θ 3)
      exact hbad (Or.inr (wcpa_dj_lr1k_ndmf_node_levels_delta _ _ θ hθ hredN hdim hnf))
  exact gen _ ι hinj hft 𝔮 hι𝔮 P e hhens hmodel _ hSR

theorem wcpa_dj_llsm_brrm_node_max : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (k : wcLlsKind W A) (z₀ : A) (b : ↥W),
    wcLlsPD W A 𝔭 k →
    ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ z₀ = t - algebraMap ↥W A c) ∨
      (∃ v g, k = .ann z₀ v g ∧ b ∣ g)) →
    b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    ∀ (s : K), s = algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀ →
    Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) ≠ ⊤ →
    (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).IsMaximal :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ 𝔭 k z₀ b hPD hk _ _ s hs hNtop
  classical
  obtain ⟨N, hNdef⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}),
      N = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) := ⟨_, rfl⟩
  rw [← hNdef] at hNtop ⊢
  have hN1 : algebraMap A ↥(Algebra.adjoin A {s}) z₀ ∈ N := by
    rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hN2 : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ N := by
    rw [hNdef]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hN3 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ N := by
    intro w hw
    rw [hNdef]
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
      ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) hw)

  have hrep : ∀ (x₀ : K) (hx₀ : x₀ ∈ Algebra.adjoin A {s}), ∃ a : A,
      (⟨x₀, hx₀⟩ : ↥(Algebra.adjoin A {s})) - algebraMap A _ a ∈ N := by
    intro x₀ hx₀
    induction hx₀ using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨0, ?_⟩
      have e : (⟨x, Algebra.subset_adjoin hx⟩ : ↥(Algebra.adjoin A {s})) =
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := Subtype.ext hx
      rw [map_zero, sub_zero, e]
      exact hN2
    | algebraMap r =>
      refine ⟨r, ?_⟩
      convert N.zero_mem using 1
      apply Subtype.ext
      simp
    | add x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨a', ha'⟩ := ihy
      refine ⟨a + a', ?_⟩
      convert N.add_mem ha ha' using 1
      apply Subtype.ext
      simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_algebraMap, map_add]
      ring
    | mul x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨a', ha'⟩ := ihy
      refine ⟨a * a', ?_⟩
      convert N.add_mem (N.mul_mem_right (⟨y, hy⟩ : ↥(Algebra.adjoin A {s})) ha)
        (N.mul_mem_left (algebraMap A ↥(Algebra.adjoin A {s}) a) ha') using 1
      apply Subtype.ext
      simp only [Subalgebra.coe_sub, Subalgebra.coe_add, Subalgebra.coe_mul,
        Subalgebra.coe_algebraMap, map_mul]
      ring
  have hm : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤
      N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    rw [Ideal.mem_comap, Ideal.mem_comap]
    exact hN3 w hw
  obtain ⟨-, hnz, -, hmax, -, hcase⟩ := hPD
  haveI := hnz
  have hp : 𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A {s})) := by
    rcases hk with ⟨t, c, rfl, hc, hz⟩ | ⟨v, g, rfl, hbg⟩
    · obtain ⟨-, h𝔭, -⟩ := hcase
      rw [h𝔭]
      refine sup_le ?_ hm
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      have e : t = z₀ + algebraMap ↥W A c := by rw [hz]; ring
      rw [e, map_add]
      exact N.add_mem hN1 (hN3 c hc)
    · obtain ⟨-, hg0, huv, h𝔭, -⟩ := hcase
      obtain ⟨q, hgq⟩ := hbg
      have hz0 : algebraMap A K z₀ ≠ 0 := by
        intro h
        have hz : z₀ = 0 := (IsFractionRing.injective A K) (by rw [h, map_zero])
        rw [hz, zero_mul, Algebra.algebraMap_eq_smul_one] at huv
        rcases smul_eq_zero.mp huv.symm with h1 | h1
        · exact hg0 h1
        · exact one_ne_zero h1
      have hvK : algebraMap A K v = algebraMap A K (algebraMap ↥W A q) * s := by
        rw [hs]
        have e := congrArg (algebraMap A K) huv
        simp only [map_mul, hgq] at e
        rw [mul_div_assoc', eq_div_iff hz0]
        linear_combination e
      rw [h𝔭]
      refine sup_le ?_ hm
      rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rw [SetLike.mem_coe, Ideal.mem_comap]
      rcases hx with hx | hx
      · rw [hx]; exact hN1
      · have e : algebraMap A ↥(Algebra.adjoin A {s}) v =
            algebraMap A _ (algebraMap ↥W A q) *
              ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ := by
          apply Subtype.ext
          simpa using hvK
        rw [hx, e]
        exact N.mul_mem_left _ hN2
  rw [Ideal.isMaximal_iff]
  refine ⟨fun h1 => hNtop ((Ideal.eq_top_iff_one N).mpr h1), ?_⟩
  intro J x hNJ hxN hxJ
  obtain ⟨a, ha⟩ := hrep x.1 x.2
  have ha' : x - algebraMap A _ a ∈ N := ha
  have ha𝔭 : a ∉ 𝔭 := by
    intro h
    apply hxN
    have := N.add_mem ha' (Ideal.mem_comap.mp (hp h))
    rwa [sub_add_cancel] at this
  obtain ⟨y, p', hp', hyp⟩ := hmax.exists_inv ha𝔭
  have e1 : (1 : ↥(Algebra.adjoin A {s})) = algebraMap A _ y * x -
      algebraMap A _ y * (x - algebraMap A _ a) + algebraMap A _ p' := by
    rw [← map_one (algebraMap A ↥(Algebra.adjoin A {s})), ← hyp, map_add, map_mul]; ring
  rw [e1]
  exact J.add_mem (J.sub_mem (J.mul_mem_left _ hxJ) (hNJ (N.mul_mem_left _ ha')))
    (hNJ (Ideal.mem_comap.mp (hp hp')))

theorem wcpa_dj_llsm_bcc_chart_etale : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (k : wcLlsKind W A) (z₀ : A) (b₀ : ↥W), wcLlsPD W A 𝔭 k → ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ z₀ = t - algebraMap ↥W A c) ∨ (∃ v g, k = .ann z₀ v g ∧ b₀ ∣ g)) → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → z₀ ≠ 0 → ∃ h : A, h ∉ 𝔭 ∧ ∃ ψ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₀}) →+* ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀, (algebraMap A K h)⁻¹}), ψ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = (algebraMap A _).comp (algebraMap ↥W A) ∧ ψ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = algebraMap A _ z₀ ∧ ψ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = ⟨algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ ∧ RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₀}) (S := ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀, (algebraMap A K h)⁻¹})) ψ ∧ ∃ χ : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀, (algebraMap A K h)⁻¹}) →+* A ⧸ 𝔭, (∀ a : A, χ (algebraMap A _ a) = Ideal.Quotient.mk 𝔭 a) ∧ χ ⟨algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ = 0 :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 k z₀ b₀ hPD hk hb₀m hb₀0 hz0
  classical
  have gen : ∀ (P R B Q : Type u) [CommRing P] [CommRing R] [CommRing B] [CommRing Q]
      (ι : P →+* R) (g₀ : P →+* B) (ψ₀ : R →+* Q) (j : B →+* Q) (x : R), g₀.Etale →
      ψ₀.comp ι = j.comp g₀ → Function.Injective j →
      (∀ q : Q, q ∈ Subring.closure (Set.range ψ₀ ∪ Set.range j)) →
      IsSMulRegular R x → x ∈ Set.range ι → (∀ r : R, ∃ n : ℕ, x ^ n * r ∈ Set.range ι) →
      ψ₀.Etale ∧ ∀ (T : Type u) [CommRing T] (u : R →+* T) (v : B →+* T), u.comp ι = v.comp g₀ →
        ∃ β : Q →+* T, β.comp ψ₀ = u ∧ β.comp j = v := by
    intro P R B Q _ _ _ _ ι g₀ ψ₀ j x hg₀ hcomm hj hgen hx hxr habs
    letI : Algebra P R := ι.toAlgebra
    letI : Algebra P B := g₀.toAlgebra
    letI : Algebra P Q := (j.comp g₀).toAlgebra
    haveI : Algebra.Etale P B := hg₀
    have hT : (algebraMap R (TensorProduct P R B)).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange P B R)
    let f : R →ₐ[P] Q := { ψ₀ with commutes' := fun q => RingHom.congr_fun hcomm q }
    let j' : B →ₐ[P] Q := { j with commutes' := fun q => rfl }
    let α : TensorProduct P R B →+* Q := (Algebra.TensorProduct.productMap f j').toRingHom
    have hα : ∀ r b, α (r ⊗ₜ[P] b) = ψ₀ r * j b := fun r b =>
      Algebra.TensorProduct.productMap_apply_tmul f j' r b
    have hιP : ∀ p : P, ι p ⊗ₜ[P] (1 : B) = (1 : R) ⊗ₜ[P] g₀ p := fun p =>
