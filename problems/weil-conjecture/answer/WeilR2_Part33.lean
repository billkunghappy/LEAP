    exact h𝔭N h'
  have hbz : b * z ∈ Submodule.span ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (Set.range g) := by
    rw [hg]; trivial
  obtain ⟨r, hr⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hbz
  choose c ρs hcρ using fun i => constTerm (wcLlsScV W A K t c' b') (r i)
  have ha' := congrArg (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) ha₀
  rw [map_add, map_mul] at ha'
  have hbz' : b * z = ∑ i, algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (c i)) * g i +
      algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ *
        ∑ i, algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (ρs i) * g i := by
    rw [← hr, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def, hcρ i, map_add, map_mul]
    ring
  have key := alg _ z s b _ _ _ _ _ ha' hab hbz'
  refine ⟨algebraMap A ↥(integralClosure A L) a₀, hs₀,
    fun i => algebraMap A ↥(integralClosure A L) (c i), 1, ?_, ?_⟩
  · exact fun h => (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one w).mpr h)
  · rw [one_mul]
    simp only [hcomp]
    rw [key]
    exact Ideal.mul_mem_right _ _ h𝔷V

theorem wcpa_dj_llsm_sccas_ct_residue_const : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        ∀ z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L), ∃ c : ↥W,
          z - algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A c)) ∈ w :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ 𝔭 t hPD c' b' hc' _ _ w _ hwc z
  classical

  have s1 : ∀ (D : Type u) [CommRing D] [IsDomain D] (φ : ↥W →+* D) (p : Polynomial ↥W),
      p.Monic → ∀ x : D, Polynomial.eval₂ φ x p = 0 → ∃ a : ↥W, φ a = x := by
    intro D _ _ φ
    suffices H : ∀ n : ℕ, ∀ p : Polynomial ↥W, p.natDegree = n → p.Monic → ∀ x : D,
        Polynomial.eval₂ φ x p = 0 → ∃ a : ↥W, φ a = x from fun p => H _ p rfl
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro p hn hp x hx
      rcases Nat.eq_zero_or_pos n with h0 | hpos
      · have h1 : p = 1 := Polynomial.eq_one_of_monic_natDegree_zero hp (hn.trans h0)
        rw [h1, Polynomial.eval₂_one] at hx
        exact absurd hx one_ne_zero
      · have hq : (p.map (algebraMap ↥W Ω)).Monic := hp.map _
        have hqd : (p.map (algebraMap ↥W Ω)).natDegree = n := by
          rw [hp.natDegree_map, hn]
        have hdeg : (p.map (algebraMap ↥W Ω)).degree ≠ 0 := by
          rw [Polynomial.degree_eq_natDegree hq.ne_zero, hqd]
          exact_mod_cast hpos.ne'
        obtain ⟨α, hα⟩ := IsAlgClosed.exists_root _ hdeg
        have hα' : Polynomial.eval₂ (algebraMap ↥W Ω) α p = 0 := by
          rw [← Polynomial.eval_map]; exact hα
        have hint : _root_.IsIntegral ↥W α := ⟨p, hp, hα'⟩
        obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
        have hpa0 : p.eval a = 0 := by
          apply IsFractionRing.injective ↥W Ω
          rw [map_zero, ← Polynomial.eval₂_at_apply, ha]
          exact hα'
        have hfac := (Polynomial.mul_divByMonic_eq_iff_isRoot (p := p) (a := a)).mpr hpa0
        have hp' : (p /ₘ (Polynomial.X - Polynomial.C a)).Monic := by
          apply Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C a)
          rw [hfac]; exact hp
        have hp'd : (p /ₘ (Polynomial.X - Polynomial.C a)).natDegree < n := by
          rw [Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C a),
            Polynomial.natDegree_X_sub_C, hn]; omega
        have h0 : (x - φ a) * Polynomial.eval₂ φ x (p /ₘ (Polynomial.X - Polynomial.C a)) = 0 := by
          have := congrArg (Polynomial.eval₂ φ x) hfac
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X,
            Polynomial.eval₂_C, hx] at this
          exact this
        rcases mul_eq_zero.mp h0 with h | h
        · exact ⟨a, (sub_eq_zero.mp h).symm⟩
        · exact ih _ hp'd _ rfl hp' x h

  obtain ⟨hFT, _, _, hmax, hm𝔭, _, h𝔭eq, _⟩ := hPD
  have s2 : ∀ a : A, ∃ p : Polynomial ↥W, p.Monic ∧
      Polynomial.eval₂ (algebraMap ↥W A) a p ∈ 𝔭 := by
    intro a
    have h : IsLocalRing.maximalIdeal ↥W ≤ 𝔭.comap (algebraMap ↥W A) :=
      Ideal.map_le_iff_le_comap.mp hm𝔭
    haveI := hmax
    letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
    letI : Field (↥W ⧸ IsLocalRing.maximalIdeal ↥W) :=
      Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W)
    letI alg : Algebra (↥W ⧸ IsLocalRing.maximalIdeal ↥W) (A ⧸ 𝔭) :=
      Ideal.Quotient.algebraQuotientOfLEComap h
    have e : (Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A) =
        (algebraMap (↥W ⧸ IsLocalRing.maximalIdeal ↥W) (A ⧸ 𝔭)).comp
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)) := RingHom.ext (fun r => rfl)
    haveI : Algebra.FiniteType (↥W ⧸ IsLocalRing.maximalIdeal ↥W) (A ⧸ 𝔭) := by
      have h1 : ((Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)).FiniteType :=
        RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
          (RingHom.finiteType_algebraMap.mpr hFT)
      rw [e] at h1
      exact RingHom.finiteType_algebraMap.mp (RingHom.FiniteType.of_comp_finiteType h1)
    haveI : Module.Finite (↥W ⧸ IsLocalRing.maximalIdeal ↥W) (A ⧸ 𝔭) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    obtain ⟨pb, hpbm, hpb⟩ :=
      Algebra.IsIntegral.isIntegral (R := ↥W ⧸ IsLocalRing.maximalIdeal ↥W)
        (Ideal.Quotient.mk 𝔭 a)
    have hl : pb ∈ Polynomial.lifts (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)) :=
      (Polynomial.lifts_iff_coeff_lifts _).mpr (fun n => Ideal.Quotient.mk_surjective _)
    obtain ⟨p, hpmap, -, hpm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl hpbm
    refine ⟨p, hpm, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂]
    rw [e, ← Polynomial.eval₂_map, hpmap]
    exact hpb

  have hbase : ∀ a : A, ∃ c : ↥W, a - algebraMap ↥W A c ∈ 𝔭 := by
    intro a
    obtain ⟨p, hpm, hp⟩ := s2 a
    haveI := hmax.isPrime
    obtain ⟨c, hc⟩ := s1 (A ⧸ 𝔭) ((Ideal.Quotient.mk 𝔭).comp (algebraMap ↥W A)) p hpm
      (Ideal.Quotient.mk 𝔭 a) (by
        rw [← Polynomial.hom_eval₂]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hp)
    exact ⟨c, Ideal.Quotient.eq.mp hc.symm⟩

  have hle : 𝔭 ≤ (wcLlsScNV W A K t c' b').comap
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
      have e2 : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
          algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
          algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A c') := by
        rw [← map_add, sub_add_cancel]
      rw [e2]
      unfold wcLlsScNV
      exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc'))
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_comap]
      unfold wcLlsScNV
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hx)
  have s3 : ∀ r : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}), ∃ c : ↥W,
      r - algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A c) ∈
        wcLlsScNV W A K t c' b' := by
    rintro ⟨x, hx⟩
    induction hx using Algebra.adjoin_induction with
    | mem x hx' =>
      rw [Set.mem_singleton_iff] at hx'
      subst hx'
      refine ⟨0, ?_⟩
      rw [map_zero, map_zero, sub_zero]
      unfold wcLlsScNV
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    | algebraMap a =>
      obtain ⟨c, hc⟩ := hbase a
      refine ⟨c, ?_⟩
      have := hle hc
      rw [Ideal.mem_comap, map_sub] at this
      exact this
    | add x y hx hy ihx ihy =>
      obtain ⟨c₁, h₁⟩ := ihx
      obtain ⟨c₂, h₂⟩ := ihy
      refine ⟨c₁ + c₂, ?_⟩
      have := Ideal.add_mem _ h₁ h₂
      convert this using 1
      rw [map_add, map_add]
      show (⟨x, hx⟩ + ⟨y, hy⟩ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) - _ = _
      ring
    | mul x y hx hy ihx ihy =>
      obtain ⟨c₁, h₁⟩ := ihx
      obtain ⟨c₂, h₂⟩ := ihy
      refine ⟨c₁ * c₂, ?_⟩
      have := Ideal.add_mem _ (Ideal.mul_mem_right (⟨y, hy⟩ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) _ h₁)
        (Ideal.mul_mem_left _ (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          (algebraMap ↥W A c₁)) h₂)
      convert this using 1
      rw [map_mul, map_mul]
      show (⟨x, hx⟩ * ⟨y, hy⟩ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) - _ = _
      ring

  obtain ⟨f, hfm, hf⟩ := integralClosure.isIntegral z
  set ψ := (Ideal.Quotient.mk w).comp (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) with hψ
  set φ := ψ.comp ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp
    (algebraMap ↥W A)) with hφ
  have hl : f.map ψ ∈ Polynomial.lifts φ := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    obtain ⟨c, hc⟩ := s3 (f.coeff n)
    refine ⟨c, ?_⟩
    rw [Polynomial.coeff_map]
    rw [← hwc, Ideal.mem_comap, map_sub] at hc
    exact (Ideal.Quotient.eq.mpr hc).symm
  obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl (hfm.map ψ)
  obtain ⟨c, hc⟩ := s1 _ φ q hqm (Ideal.Quotient.mk w z) (by
    rw [← Polynomial.eval_map, hqmap, Polynomial.eval_map, hψ, ← Polynomial.hom_eval₂]
    show Ideal.Quotient.mk w (Polynomial.eval₂ _ z f) = 0
    rw [hf, map_zero])
  exact ⟨c, Ideal.Quotient.eq.mp hc.symm⟩

theorem wcpa_dj_llsm_sccas_ctu_node_element : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → wcLlsScDF W A K L t c' b' →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w →
        wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 1 →
        ∀ 𝔷 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
          𝔷.IsPrime → 𝔷 ≤ w →
          (∀ x ∈ IsLocalRing.maximalIdeal ↥W,
            algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A x)) ∈ 𝔷) →
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔷 →
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∉ 𝔷 →
          ∃ (g : ↥W) (k : ℕ)
            (ζ z₀ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)),
            g ∈ IsLocalRing.maximalIdeal ↥W ∧ g ≠ 0 ∧ ζ ∈ w ∧
            algebraMap K L (wcLlsScV W A K t c' b') ^ k * (ζ : L) =
              algebraMap K L (algebraMap A K (algebraMap ↥W A g)) * (z₀ : L) ∧
            ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L), x ∈ w →
              ∃ e s : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L), s ∉ w ∧
                s * x - ζ * e ∈ 𝔷 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb' hb0 hs hDF
    w _ hwc hwU hbr 𝔷 h𝔷P h𝔷w h𝔷m h𝔷V h𝔷τ
  classical

  have hiso : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (P : Type u) [CommRing P] (e : R →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal R) P e →
      ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (h : P →+* R') (h' : R' →+* P),
        Module.Flat R R' ∧ IsLocalRing R' ∧ IsLocalHom (algebraMap R R') ∧
        (∀ r, h (e r) = algebraMap R R' r) ∧ (∀ r, h' (algebraMap R R' r) = e r) ∧
        ∀ x, h' (h x) = x := by
    intro R _ _ P _ e he
    obtain ⟨R', _, _, hR', hflat, -⟩ := wcNd_hi_hens_exists_flat R
    haveI := he.1
    haveI := hR'.1
    obtain ⟨h, ⟨hh, hhl⟩, -⟩ := he.2.2 R' hR'.1 (algebraMap R R') hR'.2.1
    obtain ⟨h', ⟨hh', hh'l⟩, -⟩ := hR'.2.2 P he.1 e he.2.1
