  obtain ⟨β, hβ⟩ := hkg

  obtain ⟨w, hw⟩ := hres β
  set z := β - algebraMap W B w with hzdef
  have hDz : D (j z) = D (j β) := by
    rw [hzdef, map_sub, ← IsScalarTower.algebraMap_apply W B A, map_sub,
