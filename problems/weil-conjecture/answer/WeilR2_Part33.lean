  · intro P _ e he
    letI : Algebra ↥(Algebra.adjoin A {s, η}) (Localization.AtPrime N) := j.toAlgebra
    haveI : IsLocalization.AtPrime (Localization.AtPrime N) (RingHom.ker χ) := hjloc
    have hmb := (wcpa_dj_lr1k_ndmf_modelB_levels Ω W b hbm
      (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C b}) (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective Ideal.mk_ker).1
    have hle : Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C b}))
        (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ≤
        (RingHom.ker χ).comap ψ := by
      rw [Ideal.map_le_iff_le_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        rintro x (rfl | hx)
        · rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap, RingHom.mem_ker, hψ0, hχA,
            Ideal.Quotient.eq_zero_iff_mem]
          exact hz𝔭
        · rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_comap,
            RingHom.mem_ker, hψ1]
          exact hχs
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, RingHom.mem_ker, hψw, hχA,
          Ideal.Quotient.eq_zero_iff_mem]
