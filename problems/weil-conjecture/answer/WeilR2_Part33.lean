import WeilR2_Part32
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_llsmacr_regular_pair : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (g : MvPolynomial (Fin 1) ↥W →+* B)
    (c a : ↥W), g.Etale → g.comp MvPolynomial.C = algebraMap ↥W B → a ≠ 0 →
    g (MvPolynomial.X 0) - algebraMap ↥W B c ≠ 0 ∧
      ∀ x : B, algebraMap ↥W B a * x ∈ Ideal.span {g (MvPolynomial.X 0) - algebraMap ↥W B c} →
        x ∈ Ideal.span {g (MvPolynomial.X 0) - algebraMap ↥W B c} :=
by

  have transfer : ∀ (P S : Type u) [CommRing P] [CommRing S] [Algebra P S] [Module.Flat P S]
      (p r : P), (∀ y : P, r * y ∈ Ideal.span {p} → y ∈ Ideal.span {p}) →
      ∀ x : S, algebraMap P S r * x ∈ Ideal.span {algebraMap P S p} →
        x ∈ Ideal.span {algebraMap P S p} := by
    intro P S _ _ _ _ p r hreg x hx
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hx
    let f : Fin 2 → P := ![r, p]
    let v : Fin 2 → S := ![x, -y]
    have hrel : ∑ i, f i • v i = 0 := by
      rw [Fin.sum_univ_two]
      show r • x + p • (-y) = 0
      rw [Algebra.smul_def, Algebra.smul_def, ← hy]; ring
    obtain ⟨k, A, z, hx', hA⟩ :=
      Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P) (M := S) hrel
    have hx0 : x = ∑ j, A 0 j • z j := hx' 0
    have hdiv : ∀ j, A 0 j ∈ Ideal.span {p} := by
      intro j
      apply hreg
      have h3 : ∑ i, f i * A i j = 0 := hA j
      rw [Fin.sum_univ_two] at h3
      change r * A 0 j + p * A 1 j = 0 at h3
      rw [Ideal.mem_span_singleton']
      exact ⟨-A 1 j, by linear_combination -h3⟩
    choose s hs using fun j => Ideal.mem_span_singleton'.mp (hdiv j)
    rw [hx0, Ideal.mem_span_singleton']
    refine ⟨∑ j, algebraMap P S (s j) * z j, ?_⟩
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def, ← hs j, map_mul]
    ring
  intro Ω _ W B _ _ _ g c a hg hgC ha
  classical
  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : MvPolynomial (Fin 1) ↥W, p₀ = MvPolynomial.X 0 - MvPolynomial.C c :=
    ⟨_, rfl⟩
  have hgp : g p₀ = g (MvPolynomial.X 0) - algebraMap ↥W B c := by
    rw [hp₀, map_sub, ← hgC, RingHom.comp_apply]
  have hga : g (MvPolynomial.C a) = algebraMap ↥W B a := by
    rw [← hgC, RingHom.comp_apply]

  have taylor : ∀ q : MvPolynomial (Fin 1) ↥W,
      q - MvPolynomial.C (MvPolynomial.eval (fun _ => c) q) ∈ Ideal.span {p₀} := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C w =>
      rw [MvPolynomial.eval_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval (fun _ => c) (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval (fun _ => c) p)) +
            (q - MvPolynomial.C (MvPolynomial.eval (fun _ => c) q)) := by
        rw [map_add, map_add]; ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    | mul_X p n hp =>
      have hn : n = 0 := Subsingleton.elim _ _
      subst hn
      have e : p * MvPolynomial.X 0 -
          MvPolynomial.C (MvPolynomial.eval (fun _ => c) (p * MvPolynomial.X 0)) =
          (p - MvPolynomial.C (MvPolynomial.eval (fun _ => c) p)) * MvPolynomial.X 0 +
            MvPolynomial.C (MvPolynomial.eval (fun _ => c) p) * p₀ := by
        rw [map_mul, MvPolynomial.eval_X, map_mul, hp₀]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
        (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))

  have hreg : ∀ y : MvPolynomial (Fin 1) ↥W,
      MvPolynomial.C a * y ∈ Ideal.span {p₀} → y ∈ Ideal.span {p₀} := by
    intro y hy
    obtain ⟨m, hm⟩ := Ideal.mem_span_singleton'.mp hy
    have h1 := congrArg (MvPolynomial.eval (fun _ => c)) hm
    rw [map_mul, map_mul, hp₀, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C,
      MvPolynomial.eval_C, sub_self, mul_zero] at h1
    have hev : MvPolynomial.eval (fun _ => c) y = 0 :=
      (mul_eq_zero.mp h1.symm).resolve_left ha
    have h2 := taylor y
    rwa [hev, map_zero, sub_zero] at h2

  have hp0 : p₀ ≠ 0 := by
    intro h
    have h4 := congrArg (MvPolynomial.eval (fun _ => c + 1)) h
    rw [hp₀, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, map_zero,
      add_sub_cancel_left] at h4
    exact one_ne_zero h4
  have hsr : IsSMulRegular (MvPolynomial (Fin 1) ↥W) p₀ :=
    IsLeftRegular.isSMulRegular (mul_right_injective₀ hp0)
  letI : Algebra (MvPolynomial (Fin 1) ↥W) B := g.toAlgebra
  haveI : Algebra.Etale (MvPolynomial (Fin 1) ↥W) B := hg
  haveI : Module.Flat (MvPolynomial (Fin 1) ↥W) B := inferInstance
  have halg : ∀ q, algebraMap (MvPolynomial (Fin 1) ↥W) B q = g q := fun q => rfl
  have hsrB : IsSMulRegular B (algebraMap (MvPolynomial (Fin 1) ↥W) B p₀) := hsr.of_flat
  have htr := transfer (MvPolynomial (Fin 1) ↥W) B p₀ (MvPolynomial.C a) hreg
  simp only [halg] at htr hsrB
  refine ⟨?_, ?_⟩
  · rw [← hgp]
    intro h0
    apply one_ne_zero (α := B)
    apply hsrB
    show g p₀ * 1 = g p₀ * 0
    rw [h0, zero_mul, zero_mul]
  · intro x hx
    rw [← hgp, ← hga] at hx
    rw [← hgp]
    exact htr x hx

theorem wcpa_dj_llsmacr_rees_kernel : ∀ (B : Type u) [CommRing B] [IsDomain B] (K : Type u)
    [Field K] [Algebra B K], Function.Injective (algebraMap B K) → ∀ (h a : B), h ≠ 0 →
    (∀ x : B, a * x ∈ Ideal.span {h} → x ∈ Ideal.span {h}) →
    RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) =
      Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} :=
by
  intro B _ _ K _ _ hinj h a hh hreg
  have hιh : algebraMap B K h ≠ 0 := by
    intro h0
    apply hh
    apply hinj
    rw [h0, map_zero]
  have hhr : algebraMap B K h * (algebraMap B K a / algebraMap B K h) = algebraMap B K a :=
    mul_div_cancel₀ _ hιh

  have s1 : Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} ≤
      RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    show _ ∈ RingHom.ker _
    rw [RingHom.mem_ker, map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_C,
      Polynomial.aeval_X, hhr, sub_self]

  have s2 : ∀ P : Polynomial B,
      Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
      h ∣ P.leadingCoeff * a ^ P.natDegree := by
    intro P hP
    have hev : Polynomial.eval a (P.scaleRoots h) = 0 := by
      apply hinj
      rw [map_zero, ← Polynomial.eval₂_at_apply, ← hhr, Polynomial.scaleRoots_eval₂_mul,
        ← Polynomial.aeval_def, hP, mul_zero]
    rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots, Finset.sum_range_succ]
      at hev
    simp only [Polynomial.coeff_scaleRoots, Nat.sub_self, pow_zero, mul_one] at hev
    have hS : h ∣ ∑ i ∈ Finset.range P.natDegree,
        P.coeff i * h ^ (P.natDegree - i) * a ^ i := by
      apply Finset.dvd_sum
      intro i hi
      have hi' := Finset.mem_range.mp hi
      apply Dvd.dvd.mul_right
      apply Dvd.dvd.mul_left
      exact dvd_pow_self h (by omega)
    have hlc : P.leadingCoeff * a ^ P.natDegree = -(∑ i ∈ Finset.range P.natDegree,
        P.coeff i * h ^ (P.natDegree - i) * a ^ i) := by
      rw [Polynomial.leadingCoeff]
      linear_combination hev
    rw [hlc]
    exact dvd_neg.mpr hS

  have s3 : ∀ (m : ℕ) (x : B), a ^ m * x ∈ Ideal.span {h} → x ∈ Ideal.span {h} := by
    intro m
    induction m with
    | zero => intro x hx; simpa using hx
    | succ m ih =>
      intro x hx
      apply ih
      apply hreg
      rw [← mul_assoc, ← pow_succ']
      exact hx

  have s4 : ∀ (P : Polynomial B) (q : B), 1 ≤ P.natDegree → P.leadingCoeff = h * q →
      (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
        (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree < P.natDegree := by
    intro P q hn hq
    have hXn : (Polynomial.X : Polynomial B) ^ P.natDegree =
        Polynomial.X ^ (P.natDegree - 1) * Polynomial.X := by
      rw [← pow_succ]
      congr 1
      omega
    have hD : Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
        (Polynomial.C h * Polynomial.X - Polynomial.C a) =
        Polynomial.C (q * h) * Polynomial.X ^ P.natDegree -
          Polynomial.C (q * a) * Polynomial.X ^ (P.natDegree - 1) := by
      rw [hXn, Polynomial.C_mul, Polynomial.C_mul]
      ring
    have hle : (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
        (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree ≤ P.natDegree - 1 := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      rw [hD, Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_C_mul_X_pow,
        Polynomial.coeff_C_mul_X_pow]
      have hN1 : N ≠ P.natDegree - 1 := by
        have : P.natDegree - 1 < N := by exact_mod_cast hN
        omega
      rw [if_neg hN1]
      by_cases hNn : N = P.natDegree
      · rw [if_pos hNn, hNn, Polynomial.coeff_natDegree, hq]
        ring
      · have : P.natDegree - 1 < N := by exact_mod_cast hN
        rw [if_neg hNn, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
        ring
    omega

  have s5 : ∀ n : ℕ, ∀ P : Polynomial B, P.natDegree = n →
      Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
      P ∈ Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro P hPn hP
      rcases Nat.eq_zero_or_pos n with h0 | hpos
      · have hPC := Polynomial.eq_C_of_natDegree_eq_zero (hPn.trans h0)
        rw [hPC, Polynomial.aeval_C] at hP
        have hc : P.coeff 0 = 0 := hinj (by rw [hP, map_zero])
        rw [hPC, hc, map_zero]
        exact Ideal.zero_mem _
      · subst hPn
        have hd := s2 P hP
        have hmem : a ^ P.natDegree * P.leadingCoeff ∈ Ideal.span {h} := by
          rw [Ideal.mem_span_singleton, mul_comm]
          exact hd
        obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp (s3 _ _ hmem)
        have hDI : Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
            (Polynomial.C h * Polynomial.X - Polynomial.C a) ∈
            Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} :=
          Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
        have hDk := RingHom.mem_ker.mp (s1 hDI)
        have hlt := s4 P q hpos hq
        have hP' := ih _ hlt _ rfl (by rw [map_sub, hP, hDk, sub_zero])
        have := Ideal.add_mem _ hP' hDI
        rwa [sub_add_cancel] at this
  exact le_antisymm (fun P hP => s5 _ P rfl (RingHom.mem_ker.mp hP)) s1

theorem wcpa_dj_llsmacr_annulus_etale : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (K : Type u) [Field K] [Algebra B K]
    (g : MvPolynomial (Fin 1) ↥W →+* B) (c a : ↥W), Function.Injective (algebraMap B K) →
    g.Etale → g.comp MvPolynomial.C = algebraMap ↥W B →
    g (MvPolynomial.X 0) - algebraMap ↥W B c ≠ 0 →
    RingHom.ker (Polynomial.aeval (R := B) (wcLlsaS W K (g (MvPolynomial.X 0)) c a)) ≤
      Ideal.span {Polynomial.C (g (MvPolynomial.X 0) - algebraMap ↥W B c) * Polynomial.X -
        Polynomial.C (algebraMap ↥W B a)} →
    ∃ ψ : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+*
        wcLlsaA W K (g (MvPolynomial.X 0)) c a,
      ψ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
        (algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c a)).comp (algebraMap ↥W B) ∧
      ψ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
        algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c a)
          (g (MvPolynomial.X 0) - algebraMap ↥W B c) ∧
      ψ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) =
        ⟨wcLlsaS W K (g (MvPolynomial.X 0)) c a, Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∧
      RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        (S := wcLlsaA W K (g (MvPolynomial.X 0)) c a) ψ :=
by
  intro Ω _ W B _ _ _ K _ _ g c a hinj hg hgC hh0 hker
  classical

  have gen : ∀ (P R B' Q : Type u) [CommRing P] [CommRing R] [CommRing B'] [CommRing Q]
      (ι : P →+* R) (g₀ : P →+* B') (ψ₀ : R →+* Q) (j : B' →+* Q), g₀.Etale →
      ψ₀.comp ι = j.comp g₀ →
      (∀ (T : Type u) [CommRing T] (u : R →+* T) (v : B' →+* T), u.comp ι = v.comp g₀ →
        ∃ β : Q →+* T, β.comp ψ₀ = u ∧ β.comp j = v) →
      (∀ (T : Type u) [CommRing T] (β₁ β₂ : Q →+* T), β₁.comp ψ₀ = β₂.comp ψ₀ →
        β₁.comp j = β₂.comp j → β₁ = β₂) →
      ψ₀.Etale := by
    intro P R B' Q _ _ _ _ ι g₀ ψ₀ j hg₀ hcomm hex hepi
    letI : Algebra P R := ι.toAlgebra
    letI : Algebra P B' := g₀.toAlgebra
    letI : Algebra P Q := (j.comp g₀).toAlgebra
    haveI : Algebra.Etale P B' := hg₀
    have hT : (algebraMap R (TensorProduct P R B')).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange P B' R)
    let f : R →ₐ[P] Q := { ψ₀ with commutes' := fun q => RingHom.congr_fun hcomm q }
    let j' : B' →ₐ[P] Q := { j with commutes' := fun q => rfl }
    let α : TensorProduct P R B' →+* Q := (Algebra.TensorProduct.productMap f j').toRingHom
    have hα : ∀ r b, α (r ⊗ₜ[P] b) = ψ₀ r * j b := fun r b =>
      Algebra.TensorProduct.productMap_apply_tmul f j' r b
    obtain ⟨β, hβ1, hβ2⟩ := hex (TensorProduct P R B')
      (Algebra.TensorProduct.includeLeftRingHom (R := P) (A := R) (B := B'))
      (Algebra.TensorProduct.includeRight (R := P) (A := R) (B := B')).toRingHom
      (RingHom.ext fun q => by
        show (algebraMap P R q) ⊗ₜ[P] (1 : B') = (1 : R) ⊗ₜ[P] (algebraMap P B' q)
        exact Algebra.TensorProduct.tmul_one_eq_one_tmul q)
    have hβψ : ∀ r, β (ψ₀ r) = r ⊗ₜ[P] (1 : B') := fun r => by
      have := RingHom.congr_fun hβ1 r
      rw [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply] at this
      exact this
    have hβj : ∀ b, β (j b) = (1 : R) ⊗ₜ[P] b := fun b => by
      have := RingHom.congr_fun hβ2 b
      rw [RingHom.comp_apply] at this
      exact this.trans (Algebra.TensorProduct.includeRight_apply b)
    have hαβ : α.comp β = RingHom.id Q := by
      apply hepi Q
      · apply RingHom.ext
        intro r
        show α (β (ψ₀ r)) = ψ₀ r
        rw [hβψ, hα, map_one, mul_one]
      · apply RingHom.ext
        intro b
        show α (β (j b)) = j b
        rw [hβj, hα, map_one, one_mul]
    have hβα : β.comp α = RingHom.id _ := by
      apply Algebra.TensorProduct.ringHom_ext
      · apply RingHom.ext
        intro r
        show β (α (r ⊗ₜ[P] (1 : B'))) = r ⊗ₜ[P] (1 : B')
        rw [hα, map_one, mul_one, hβψ]
      · apply RingHom.ext
        intro b
        show β (α ((1 : R) ⊗ₜ[P] b)) = (1 : R) ⊗ₜ[P] b
        rw [hα, map_one, one_mul, hβj]
    let e : TensorProduct P R B' ≃+* Q := RingEquiv.ofRingHom α β hαβ hβα
    have hψe : ψ₀ = e.toRingHom.comp (algebraMap R (TensorProduct P R B')) := by
      apply RingHom.ext
      intro r
      change ψ₀ r = α (r ⊗ₜ[P] (1 : B'))
      rw [hα, map_one, mul_one]
    rw [hψe]
    exact RingHom.Etale.respectsIso.1 _ e hT

  have s1 : ∀ (p : Polynomial B) (s : K), Polynomial.aeval s p = 0 →
      RingHom.ker (Polynomial.aeval (R := B) s) ≤ Ideal.span {p} →
      ∃ e : (Polynomial B ⧸ Ideal.span {p}) ≃+* ↥(Algebra.adjoin B {s}),
        (∀ b : B, e (Ideal.Quotient.mk (Ideal.span {p}) (Polynomial.C b)) =
          algebraMap B ↥(Algebra.adjoin B {s}) b) ∧
        e (Ideal.Quotient.mk (Ideal.span {p}) Polynomial.X) =
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
    intro p s hps hk
    let ŝ : ↥(Algebra.adjoin B {s}) := ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩
    let σ : Polynomial B →+* ↥(Algebra.adjoin B {s}) := (Polynomial.aeval ŝ).toRingHom
    have hσ : ∀ q, ((σ q : ↥(Algebra.adjoin B {s})) : K) = Polynomial.aeval s q := fun q =>
      Polynomial.aeval_subalgebra_coe q (Algebra.adjoin B {s}) ŝ
    have hsurj : Function.Surjective σ := by
      intro x
      obtain ⟨q, hq⟩ := Algebra.adjoin_eq_exists_aeval B s x
      exact ⟨q, Subtype.ext ((hσ q).trans hq)⟩
    have hkσ : Ideal.span {p} = RingHom.ker σ := by
      apply le_antisymm
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        apply Subtype.ext
        rw [hσ, hps]
        rfl
      · intro q hq
        apply hk
        rw [RingHom.mem_ker] at hq ⊢
        rw [← hσ, hq]
        rfl
    refine ⟨(Ideal.quotEquivOfEq hkσ).trans (RingHom.quotientKerEquivOfSurjective hsurj), ?_, ?_⟩
    · intro b
      rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
        RingHom.quotientKerEquivOfSurjective_apply_mk]
      exact Polynomial.aeval_C ŝ b
    · rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
        RingHom.quotientKerEquivOfSurjective_apply_mk]
      exact Polynomial.aeval_X ŝ

  have s2 : ∃ ψ₀ : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+*
        (Polynomial B ⧸ Ideal.span {Polynomial.C (g (MvPolynomial.X 0) - algebraMap ↥W B c) *
          Polynomial.X - Polynomial.C (algebraMap ↥W B a)}),
      (∀ w : ↥W, ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.C w)) =
        Ideal.Quotient.mk _ (Polynomial.C (algebraMap ↥W B w))) ∧
      ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
        Ideal.Quotient.mk _ (Polynomial.C (g (MvPolynomial.X 0) - algebraMap ↥W B c)) ∧
      ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Ideal.Quotient.mk _ Polynomial.X ∧
      RingHom.Etale ψ₀ := by
    set h : B := g (MvPolynomial.X 0) - algebraMap ↥W B c with hhdef
    set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a} with hIdef
    set J : Ideal (Polynomial B) :=
      Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C (algebraMap ↥W B a)} with hJdef
    let ψt : MvPolynomial (Fin 2) ↥W →+* Polynomial B ⧸ J :=
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk J).comp (Polynomial.C.comp (algebraMap ↥W B)))
        ![Ideal.Quotient.mk J (Polynomial.C h), Ideal.Quotient.mk J Polynomial.X]
    have hψtC : ∀ w, ψt (MvPolynomial.C w) =
        Ideal.Quotient.mk J (Polynomial.C (algebraMap ↥W B w)) := by
      intro w
      simp [ψt]
    have hψt0 : ψt (MvPolynomial.X 0) = Ideal.Quotient.mk J (Polynomial.C h) := by
      simp [ψt]
    have hψt1 : ψt (MvPolynomial.X 1) = Ideal.Quotient.mk J Polynomial.X := by
      simp [ψt]
    have hψtI : ∀ x ∈ I, ψt x = 0 := by
      intro x hx
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      have hrel : ψt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 := by
        rw [map_sub, map_mul, hψt0, hψt1, hψtC, ← map_mul, ← map_sub]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      rw [map_mul, hrel, mul_zero]
    let ψ₀ : MvPolynomial (Fin 2) ↥W ⧸ I →+* Polynomial B ⧸ J := Ideal.Quotient.lift I ψt hψtI
    have hψ₀mk : ∀ x, ψ₀ (Ideal.Quotient.mk I x) = ψt x := fun x =>
      Ideal.Quotient.lift_mk I ψt hψtI
    refine ⟨ψ₀, fun w => (hψ₀mk _).trans (hψtC w), (hψ₀mk _).trans hψt0,
      (hψ₀mk _).trans hψt1, ?_⟩

    let ι : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 2) ↥W ⧸ I :=
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
        (fun _ => Ideal.Quotient.mk I (MvPolynomial.X 0) + Ideal.Quotient.mk I (MvPolynomial.C c))
    have hιC : ∀ w, ι (MvPolynomial.C w) = Ideal.Quotient.mk I (MvPolynomial.C w) := by
      intro w
      show MvPolynomial.eval₂Hom _ _ (MvPolynomial.C w) = _
      rw [MvPolynomial.eval₂Hom_C]
      rfl
    have hιX : ι (MvPolynomial.X 0) =
        Ideal.Quotient.mk I (MvPolynomial.X 0) + Ideal.Quotient.mk I (MvPolynomial.C c) := by
      show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X 0) = _
      rw [MvPolynomial.eval₂Hom_X']
    have hgCw : ∀ w, g (MvPolynomial.C w) = algebraMap ↥W B w := fun w =>
      RingHom.congr_fun hgC w
    have hcomm : ψ₀.comp ι = ((Ideal.Quotient.mk J).comp Polynomial.C).comp g := by
      apply MvPolynomial.ringHom_ext
      · intro w
        show ψ₀ (ι (MvPolynomial.C w)) = Ideal.Quotient.mk J (Polynomial.C (g (MvPolynomial.C w)))
        rw [hιC, hψ₀mk, hψtC, hgCw]
      · intro i
        have hi : i = 0 := Subsingleton.elim _ _
        subst hi
        show ψ₀ (ι (MvPolynomial.X 0)) = Ideal.Quotient.mk J (Polynomial.C (g (MvPolynomial.X 0)))
        rw [hιX, map_add, hψ₀mk, hψ₀mk, hψt0, hψtC, ← map_add, ← map_add, hhdef,
          sub_add_cancel]
    refine gen (MvPolynomial (Fin 1) ↥W) (MvPolynomial (Fin 2) ↥W ⧸ I) B (Polynomial B ⧸ J)
      ι g ψ₀ ((Ideal.Quotient.mk J).comp Polynomial.C) hg hcomm ?_ ?_
    · intro T _ u v huv
      have hvC : ∀ w, v (algebraMap ↥W B w) = u (Ideal.Quotient.mk I (MvPolynomial.C w)) := by
        intro w
        have := RingHom.congr_fun huv (MvPolynomial.C w)
        rw [RingHom.comp_apply, RingHom.comp_apply, hιC, hgCw] at this
        exact this.symm
      have hvh : v h = u (Ideal.Quotient.mk I (MvPolynomial.X 0)) := by
        have := RingHom.congr_fun huv (MvPolynomial.X 0 - MvPolynomial.C c)
        rw [RingHom.comp_apply, RingHom.comp_apply, map_sub ι, map_sub g, hιX, hιC, hgCw,
          add_sub_cancel_right] at this
        exact this.symm
      let βt : Polynomial B →+* T :=
        Polynomial.eval₂RingHom v (u (Ideal.Quotient.mk I (MvPolynomial.X 1)))
      have hβtC : ∀ b, βt (Polynomial.C b) = v b := by
        intro b
        show Polynomial.eval₂ _ _ (Polynomial.C b) = _
        rw [Polynomial.eval₂_C]
      have hβtX : βt Polynomial.X = u (Ideal.Quotient.mk I (MvPolynomial.X 1)) := by
        show Polynomial.eval₂ _ _ Polynomial.X = _
        rw [Polynomial.eval₂_X]
      have hI0 : Ideal.Quotient.mk I (MvPolynomial.X 0) * Ideal.Quotient.mk I (MvPolynomial.X 1) -
          Ideal.Quotient.mk I (MvPolynomial.C a) = 0 := by
        have h0 : Ideal.Quotient.mk I (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) =
            0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        rw [map_sub, map_mul] at h0
        exact h0
      have hβtJ : ∀ x ∈ J, βt x = 0 := by
        intro x hx
        obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
        have hrel : βt (Polynomial.C h * Polynomial.X - Polynomial.C (algebraMap ↥W B a)) = 0 := by
          rw [map_sub, map_mul, hβtC, hβtC, hβtX, hvh, hvC, ← map_mul, ← map_sub, hI0, map_zero]
        rw [map_mul, hrel, mul_zero]
      let β : Polynomial B ⧸ J →+* T := Ideal.Quotient.lift J βt hβtJ
      have hβmk : ∀ x, β (Ideal.Quotient.mk J x) = βt x := fun x =>
        Ideal.Quotient.lift_mk J βt hβtJ
      refine ⟨β, ?_, ?_⟩
      · apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro w
          show β (ψ₀ (Ideal.Quotient.mk I (MvPolynomial.C w))) =
            u (Ideal.Quotient.mk I (MvPolynomial.C w))
          rw [hψ₀mk, hψtC, hβmk, hβtC, hvC]
        · intro i
          fin_cases i
          · show β (ψ₀ (Ideal.Quotient.mk I (MvPolynomial.X 0))) =
              u (Ideal.Quotient.mk I (MvPolynomial.X 0))
            rw [hψ₀mk, hψt0, hβmk, hβtC, hvh]
          · show β (ψ₀ (Ideal.Quotient.mk I (MvPolynomial.X 1))) =
              u (Ideal.Quotient.mk I (MvPolynomial.X 1))
            rw [hψ₀mk, hψt1, hβmk, hβtX]
      · apply RingHom.ext
        intro b
        show β (Ideal.Quotient.mk J (Polynomial.C b)) = v b
        rw [hβmk, hβtC]
    · intro T _ β₁ β₂ h1 h2
      apply Ideal.Quotient.ringHom_ext
      apply Polynomial.ringHom_ext
      · intro b
        exact RingHom.congr_fun h2 b
      · have := RingHom.congr_fun h1 (Ideal.Quotient.mk I (MvPolynomial.X 1))
        rw [RingHom.comp_apply, RingHom.comp_apply, hψ₀mk, hψt1] at this
        exact this

  obtain ⟨ψ₀, hψC, hψ0, hψ1, hψet⟩ := s2
  have hhK : algebraMap B K (g (MvPolynomial.X 0) - algebraMap ↥W B c) ≠ 0 := fun h0 =>
    hh0 (hinj (by rw [h0, map_zero]))
  have hps : Polynomial.aeval (wcLlsaS W K (g (MvPolynomial.X 0)) c a)
      (Polynomial.C (g (MvPolynomial.X 0) - algebraMap ↥W B c) * Polynomial.X -
        Polynomial.C (algebraMap ↥W B a)) = 0 := by
    rw [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_C, Polynomial.aeval_X]
    show algebraMap B K (g (MvPolynomial.X 0) - algebraMap ↥W B c) *
        (algebraMap B K (algebraMap ↥W B a) /
          algebraMap B K (g (MvPolynomial.X 0) - algebraMap ↥W B c)) -
        algebraMap B K (algebraMap ↥W B a) = 0
    rw [mul_div_cancel₀ _ hhK, sub_self]
  obtain ⟨eA, heC, heX⟩ := s1 _ _ hps hker
  refine ⟨eA.toRingHom.comp ψ₀, ?_, ?_, ?_, RingHom.Etale.respectsIso.1 _ eA hψet⟩
  · ext1 w
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hψC, heC]
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hψ0, heC]
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hψ1, heX]

theorem wcpa_dj_llsmacr_node_maximal : ∀ (B : Type u) [CommRing B] (K : Type u) [Field K]
    [Algebra B K] (h a : B) (𝔭 J : Ideal B), 𝔭.IsMaximal → h ∈ 𝔭 → a ∈ 𝔭 → J ≤ 𝔭 →
    𝔭 ≤ Ideal.span {h} ⊔ J →
    RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) ≤
      Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} →
    (Ideal.span {algebraMap B ↥(Algebra.adjoin B {algebraMap B K a / algebraMap B K h}) h,
        ⟨algebraMap B K a / algebraMap B K h, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
      J.map (algebraMap B ↥(Algebra.adjoin B {algebraMap B K a / algebraMap B K h}))).IsMaximal :=
by
  intro B _ K _ _ h a 𝔭 J hmax hh ha hJ hle hker
  generalize algebraMap B K a / algebraMap B K h = s at hker ⊢
  letI : Field (B ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  let A := Algebra.adjoin B {s}
  let v : A := ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩
  let σ : Polynomial B →+* A := (Polynomial.aeval (R := B) v).toRingHom
  have hσval : ∀ q, ((σ q : A) : K) = Polynomial.aeval s q := fun q =>
    (Polynomial.aeval_algHom_apply A.val v q).symm
  have hσsurj : Function.Surjective σ := by
    intro x
    obtain ⟨p, hp⟩ := Algebra.adjoin_eq_exists_aeval B s x
    exact ⟨p, Subtype.ext (by rw [hσval]; exact hp)⟩
  let χ₀ : Polynomial B →+* B ⧸ 𝔭 := (Ideal.Quotient.mk 𝔭).comp Polynomial.constantCoeff
  have hkerle : RingHom.ker σ ≤ RingHom.ker χ₀ := by
    intro q hq
    have h1 : q ∈ RingHom.ker (Polynomial.aeval (R := B) s) := by
      rw [RingHom.mem_ker] at hq ⊢
      rw [← hσval, hq]; rfl
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp (hker h1)
    have h2 : χ₀ (Polynomial.C h * Polynomial.X - Polynomial.C a) = 0 := by
      show Ideal.Quotient.mk 𝔭 (Polynomial.constantCoeff
        (Polynomial.C h * Polynomial.X - Polynomial.C a)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      simpa using 𝔭.neg_mem ha
    rw [RingHom.mem_ker, map_mul, h2, mul_zero]
  let χ : A →+* B ⧸ 𝔭 := σ.liftOfSurjective hσsurj ⟨χ₀, hkerle⟩
  have hχ : ∀ q, χ (σ q) = Ideal.Quotient.mk 𝔭 (q.coeff 0) := fun q => by
    show (σ.liftOfSurjective hσsurj ⟨χ₀, hkerle⟩) (σ q) = _
    rw [RingHom.liftOfSurjective_comp_apply]
    show Ideal.Quotient.mk 𝔭 (Polynomial.constantCoeff q) = _
    rw [Polynomial.constantCoeff_apply]
  have hb : ∀ b : B, algebraMap B A b = σ (Polynomial.C b) := fun b =>
    (Polynomial.aeval_C v b).symm
  have hX : v = σ Polynomial.X := (Polynomial.aeval_X v).symm
  have hχb : ∀ b, χ (algebraMap B A b) = Ideal.Quotient.mk 𝔭 b := by
    intro b; rw [hb, hχ, Polynomial.coeff_C_zero]
  have hχv : χ v = 0 := by rw [hX, hχ, Polynomial.coeff_X_zero, map_zero]
  have hχsurj : Function.Surjective χ := by
    intro y
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨_, hχb b⟩
  have hmaxχ := RingHom.ker_isMaximal_of_surjective χ hχsurj
  have hEq : (Ideal.span {algebraMap B A h, v} ⊔ J.map (algebraMap B A)) = RingHom.ker χ := by
    apply le_antisymm
    · apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | hx
        · exact RingHom.mem_ker.mpr (by rw [hχb]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hh)
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          exact RingHom.mem_ker.mpr hχv
      · rw [Ideal.map_le_iff_le_comap]
        intro j hj
        rw [Ideal.mem_comap, RingHom.mem_ker, hχb]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hJ hj)
    · intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨q, rfl⟩ := hσsurj x
      rw [hχ, Ideal.Quotient.eq_zero_iff_mem] at hx
      obtain ⟨y, hy, j, hj, hyj⟩ := Submodule.mem_sup.mp (hle hx)
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      have hq : q = Polynomial.X * q.divX + Polynomial.C (q.coeff 0) :=
        (Polynomial.X_mul_divX_add q).symm
      rw [hq, map_add, map_mul, ← hX, ← hb, ← hyj, map_add, map_mul]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ ?_) (Ideal.add_mem _ ?_ ?_)
      · exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
      · exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
      · exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hj)
  exact (congrArg Ideal.IsMaximal hEq).mpr hmaxχ

theorem wcpa_dj_llsma_chart_ring : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (K : Type u) [Field K] [Algebra B K]
    [IsFractionRing B K] (g : MvPolynomial (Fin 1) ↥W →+* B) (𝔭 : Ideal B) (c a : ↥W),
    g.Etale → g.comp MvPolynomial.C = algebraMap ↥W B →
    wcLlsPD W B 𝔭 (.disc (g (MvPolynomial.X 0))) →
    c ∈ IsLocalRing.maximalIdeal ↥W → a ∈ IsLocalRing.maximalIdeal ↥W → a ≠ 0 →
    ∀ [Algebra ↥W (wcLlsaA W K (g (MvPolynomial.X 0)) c a)],
    algebraMap ↥W (wcLlsaA W K (g (MvPolynomial.X 0)) c a) =
      (algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c a)).comp (algebraMap ↥W B) →
    IsFractionRing (wcLlsaA W K (g (MvPolynomial.X 0)) c a) K ∧
    wcLlsPD W (wcLlsaA W K (g (MvPolynomial.X 0)) c a)
      (wcLlsaN W K (g (MvPolynomial.X 0)) c a)
      (.ann (algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c a)
          (g (MvPolynomial.X 0) - algebraMap ↥W B c))
        ⟨wcLlsaS W K (g (MvPolynomial.X 0)) c a, Algebra.subset_adjoin (Set.mem_singleton _)⟩
        a) :=
by
  intro Ω _ W B _ _ _ K _ _ _ g 𝔭 c a hg hgC hPD hc ha ha0 _ hA
  classical
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, ht𝔭, h𝔭eq, -⟩ := hPD
  have hinj : Function.Injective (algebraMap B K) := IsFractionRing.injective B K
  obtain ⟨hh0, hreg⟩ := wcpa_dj_llsmacr_regular_pair Ω W B g c a hg hgC ha0
  have hker := wcpa_dj_llsmacr_rees_kernel B K hinj _ _ hh0 hreg
  obtain ⟨ψ, hψC, hψ0, hψ1, hψet⟩ :=
    wcpa_dj_llsmacr_annulus_etale Ω W B K g c a hinj hg hgC hh0 hker.le
  have hcJ : algebraMap ↥W B c ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) :=
    Ideal.mem_map_of_mem _ hc
  have haJ : algebraMap ↥W B a ∈ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) :=
    Ideal.mem_map_of_mem _ ha
  have hh𝔭 : g (MvPolynomial.X 0) - algebraMap ↥W B c ∈ 𝔭 := 𝔭.sub_mem ht𝔭 (hm𝔭 hcJ)
  have ha𝔭 : algebraMap ↥W B a ∈ 𝔭 := hm𝔭 haJ
  have h𝔭le : 𝔭 ≤ Ideal.span {g (MvPolynomial.X 0) - algebraMap ↥W B c} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) := by
    rw [h𝔭eq]
    refine sup_le ?_ le_sup_right
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    have hmem : (g (MvPolynomial.X 0) - algebraMap ↥W B c) + algebraMap ↥W B c ∈
        Ideal.span {g (MvPolynomial.X 0) - algebraMap ↥W B c} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B) :=
      Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
        (Ideal.mem_sup_right hcJ)
    rwa [sub_add_cancel] at hmem
  have hNmax0 := wcpa_dj_llsmacr_node_maximal B K _ _ 𝔭 _ h𝔭max hh𝔭 ha𝔭 hm𝔭 h𝔭le hker.le
  have hNeq : wcLlsaN W K (g (MvPolynomial.X 0)) c a =
      Ideal.span {algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c a)
          (g (MvPolynomial.X 0) - algebraMap ↥W B c),
        ⟨wcLlsaS W K (g (MvPolynomial.X 0)) c a, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W B)).map
        (algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c a)) := by
    unfold wcLlsaN
    rw [hA, ← Ideal.map_map]
  have hNmax : (wcLlsaN W K (g (MvPolynomial.X 0)) c a).IsMaximal := by
    rw [hNeq]; exact hNmax0
  have hhK : algebraMap B K (g (MvPolynomial.X 0) - algebraMap ↥W B c) ≠ 0 := fun h0 =>
    hh0 (hinj (by rw [h0, map_zero]))
  have hST : IsScalarTower ↥W B (wcLlsaA W K (g (MvPolynomial.X 0)) c a) :=
    IsScalarTower.of_algebraMap_eq' hA
  have hFTBA : Algebra.FiniteType B (wcLlsaA W K (g (MvPolynomial.X 0)) c a) := by
    have h1 := Subalgebra.fg_adjoin_finset (R := B)
      ({wcLlsaS W K (g (MvPolynomial.X 0)) c a} : Finset K)
    rw [Finset.coe_singleton] at h1
    exact (Subalgebra.fg_iff_finiteType _).mp h1
  have hFTA : Algebra.FiniteType ↥W (wcLlsaA W K (g (MvPolynomial.X 0)) c a) :=
    Algebra.FiniteType.trans hFT hFTBA
  have hNZA : NoZeroSMulDivisors ↥W (wcLlsaA W K (g (MvPolynomial.X 0)) c a) := by
    refine ⟨fun {w x} hwx => ?_⟩
    rw [Algebra.smul_def, hA, RingHom.comp_apply] at hwx
    rcases mul_eq_zero.mp hwx with h1 | h1
    · left
      have h2 : algebraMap B K (algebraMap ↥W B w) = 0 := by
        have h3 := congrArg Subtype.val h1
        simpa using h3
      have h3 : algebraMap ↥W B w = 0 := hinj (by rw [h2, map_zero])
      have h4 : w • (1 : B) = 0 := by rw [Algebra.smul_def, mul_one, h3]
      exact (smul_eq_zero.mp h4).resolve_right one_ne_zero
    · right; exact h1
  have hICA : IsIntegrallyClosed (wcLlsaA W K (g (MvPolynomial.X 0)) c a) := by
    obtain ⟨hRd, hRic⟩ := wcNd_nodal_poly_normal Ω W a ha0
    letI : Algebra (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        (wcLlsaA W K (g (MvPolynomial.X 0)) c a) :=
      @RingHom.toAlgebra (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        (wcLlsaA W K (g (MvPolynomial.X 0)) c a) _ _ ψ
    have : Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        (wcLlsaA W K (g (MvPolynomial.X 0)) c a) := RingHom.Etale.toAlgebra hψet
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    have : p.IsPrime := hpm.isPrime
    exact (wc_pks_etale_localization_normal (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
      (wcLlsaA W K (g (MvPolynomial.X 0)) c a) p).2
  have huv : algebraMap B (wcLlsaA W K (g (MvPolynomial.X 0)) c a)
        (g (MvPolynomial.X 0) - algebraMap ↥W B c) *
      ⟨wcLlsaS W K (g (MvPolynomial.X 0)) c a, Algebra.subset_adjoin (Set.mem_singleton _)⟩ =
      algebraMap ↥W (wcLlsaA W K (g (MvPolynomial.X 0)) c a) a := by
    apply Subtype.ext
