    ∀ (X₀ : Scheme.{u}) (r₀ : X₀ ⟶ X) (ι₀ : wcProjK Ω 1 ⟶ X₀)
      [QuasiCompact (γ ≫ ι₀)] [QuasiSeparated (γ ≫ ι₀)],
      wcCsdIsBlowup (σ₀.ker ⊔ wcNcPrincipal (.of ↥W) X uX a₀) r₀ → ι₀ ≫ r₀ = ι →
      wcpaDjLkModel W (r₀ ≫ uX) ι₀ →
    ∀ w : ↥(wcpaDjLkFib W (γ ≫ ι₀) (r₀ ≫ uX)),
      r₀ (wcpaDjLkImg W (γ ≫ ι₀) (r₀ ≫ uX) w) = wcpaDjLkImg W (γ ≫ ι) uX y₀ →
      ¬ wcpaDjLkSmAt W (r₀ ≫ uX) (wcpaDjLkPi W (γ ≫ ι₀) (r₀ ≫ uX) w) →
      wcpaDjLlSolvStab W γ ι₀ (r₀ ≫ uX) w →
    ∃ (A : Type u) (_ : CommRing A) (_ : IsDomain A) (_ : Algebra ↥W A) (K : Type u)
      (_ : Field K) (_ : Algebra A K) (_ : IsFractionRing A K) (L : Type u) (_ : Field L)
      (_ : Algebra K L) (_ : Algebra A L) (_ : IsScalarTower A K L) (_ : FiniteDimensional K L)
      (_ : IsGalois K L) (𝔭 : Ideal A) (u v : A) (y : Ideal ↥(integralClosure A L)),
      wcLlsPD W A 𝔭 (.ann u v a₀) ∧ wcLlsSolvPt W A K L 𝔭 (.ann u v a₀) y ∧
      ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ a₀ →
        (wcLlsAnnSep W A K L u b ↔
          wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ b) :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm σ₀ a₀ hP₀ X₀ r₀ ι₀ _ _ hbl₀ hι₀
    hM₀ w hw hnsm hss
  classical
  haveI hintC : AlgebraicGeometry.IsIntegral C := by
    haveI : IrreducibleSpace C := hcov.2.2.1
    haveI : SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) := hcov.2.1
    haveI : ∀ c : C, _root_.IsReduced (C.presheaf.stalk c) := fun c => by
      haveI := wcpa_smooth_stalk_isDomain Ω C (γ ≫ wcProjKStr Ω 1) 1 c
      infer_instance
    haveI : IsReduced C := isReduced_of_isReduced_stalk C
    exact isIntegral_of_irreducibleSpace_of_isReduced C
  obtain ⟨V, hle, g, 𝔭, hch⟩ :=
    wcpa_dj_llsmg_chart Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
  obtain ⟨hgen, hinj, hgal'⟩ :=
    wcpa_dj_llsmg_function_field_galois Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
      V hle g 𝔭 hch
  haveI hdom : IsDomain ↑Γ(X, V) := hch.2.2.1
  letI iWB : Algebra ↥W ↑Γ(X, V) := (wcG2cPhi W uX V hle).toAlgebra
  letI iBL : Algebra ↑Γ(X, V) ↑C.functionField := (wcG2cKap (γ ≫ ι) V hgen).toAlgebra
  letI iKL : Algebra (FractionRing ↑Γ(X, V)) ↑C.functionField :=
    (IsFractionRing.lift (K := FractionRing ↑Γ(X, V)) hinj).toAlgebra
  haveI iST : IsScalarTower ↑Γ(X, V) (FractionRing ↑Γ(X, V)) ↑C.functionField :=
    IsScalarTower.of_algebraMap_eq (fun a => (IsFractionRing.lift_algebraMap hinj a).symm)
  obtain ⟨hfd, hgalois⟩ := hgal' (FractionRing ↑Γ(X, V)) rfl
  haveI := hfd
  haveI := hgalois

  have hDP := wcpa_dj_llsmg_disc_param Ω W hW hWt X uX ι hM _ V hle g 𝔭 hch
  have hcm : wcG2cTau W V (g (MvPolynomial.X 0)) σ₀ ∈ IsLocalRing.maximalIdeal ↥W :=
