    have hdimQ' : ringKrullDim (Localization.AtPrime Q') = ((1 : ℕ) : WithBot ℕ∞) :=
      (ringKrullDim_eq_of_ringEquiv e').trans hdimF

    haveI := wcpa_dj_nc_residue_algclosed Ω W
    haveI := IsAlgClosed.perfectField (IsLocalRing.ResidueField ↥W)
    obtain ⟨b, hb, hstd⟩ := wcpa_dj_llsm_flsc_smooth_nbhd ↥W (IsLocalRing.ResidueField ↥W)
      ↥(integralClosure R L) Q Q' hQ'c hregQ' hdimQ'

    obtain ⟨g, z, hg, hz, φ, hφC, hφX, hφet⟩ :=
      wcpa_dj_llsm_flsc_etale_coord ↥W ↥(integralClosure R L) Q hcomapW hres b hb hstd
