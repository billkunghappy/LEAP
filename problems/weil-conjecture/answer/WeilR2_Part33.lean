  have hgQ : b * s' ∉ Q := fun h => (hQ.mem_or_mem h).elim hb hs'Q
  have hu : IsUnit (j (b ^ n)) :=
    IsLocalization.map_units A (⟨b ^ n, n, rfl⟩ : Submonoid.powers b)
  have hassoc : Associated (j s') s := by
    obtain ⟨u, hu'⟩ := hu
