  obtain ⟨nn, hnn⟩ : ∃ nn : L,
      nn = ∑ i ∈ Finset.range (d * N), wL (r.coeff i) * (n : L) ^ i * (s : L) ^ (d * N - i) := ⟨_, rfl⟩
  have hnnB : nn ∈ BV := by
    rw [hnn]
    exact sum_mem fun i _ => BV.mul_mem (BV.mul_mem (hwBV _) (BV.pow_mem hnB _)) (BV.pow_mem hsB _)
  have hB6 : (N't : L) ^ N * (vL ^ N * rx) - wL ε ^ N * nn ∈ MS := by
    have h1 : (vL * (N't : L)) ^ N - ((s : L) ^ d * wL ε) ^ N ∈ MS :=
