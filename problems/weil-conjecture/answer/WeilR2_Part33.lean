      refine ⟨((Q.comap ψ1).comap ι).map ψ0, (c0c _).mpr ⟨hmp, by rw [hmc]; exact hPmin⟩, ?_⟩
      show (Λ ((((Q.comap ψ1).comap ι).map ψ0).comap ψ0)).map ψ1 = Q
      rw [hmc, hΛQ]
      exact (c1b Q hQp).1

  obtain ⟨hs2a, hs2b, hs2c⟩ := wcpa_dj_llsm_obism_chart Ω W A K L t c' b'
  obtain ⟨ι, hιv⟩ : ∃ ι : ↥(integralClosure A L) →+*
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
      ∀ x, ((ι x : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) : L) =
        (x : L) :=
    ⟨((integralClosure A L).val.toRingHom).codRestrict
      (integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (fun x => hs2a x),
      fun x => rfl⟩
  have hι : Function.Injective ι := by
    intro x x' h
    apply Subtype.ext
    rw [← hιv x, ← hιv x', h]
  have hιA : ∀ a : A, ι (algebraMap A ↥(integralClosure A L) a) =
      algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a) := by
    intro a
    apply Subtype.ext
    rw [hιv]
    show algebraMap A L a = algebraMap K L (algebraMap A K a)
    exact IsScalarTower.algebraMap_apply A K L a
  have hch : ∀ z, ∃ (k : ℕ) (a : ↥(integralClosure A L)),
      ι a = ι (algebraMap A ↥(integralClosure A L) (t - algebraMap ↥W A c')) ^ k * z := by
    intro z
    obtain ⟨k, a, ha⟩ := hs2b z
    refine ⟨k, a, Subtype.ext ?_⟩
    rw [hιv, ha, MulMemClass.coe_mul, SubmonoidClass.coe_pow, hιv]
    rfl
  have hv : ∃ b ∈ Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x},
      ι (algebraMap A ↥(integralClosure A L) (t - algebraMap ↥W A c')) *
        algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ = ι b := by
    rcases hs2c with h | h
    · refine ⟨algebraMap A ↥(integralClosure A L) (algebraMap ↥W A b'),
        Ideal.subset_span ⟨b', hb'm, rfl⟩, ?_⟩
      apply Subtype.ext
      rw [MulMemClass.coe_mul, hιv, hιv]
      show algebraMap A L (t - algebraMap ↥W A c') * algebraMap K L (wcLlsScV W A K t c' b') =
        algebraMap A L (algebraMap ↥W A b')
      rw [IsScalarTower.algebraMap_apply A K L (t - algebraMap ↥W A c'),
        IsScalarTower.algebraMap_apply A K L (algebraMap ↥W A b'), ← map_mul, h]
    · refine ⟨0, Ideal.zero_mem _, ?_⟩
      have h' : algebraMap K L (wcLlsScV W A K t c' b') = 0 := by rw [h, map_zero]
      apply Subtype.ext
      rw [MulMemClass.coe_mul, map_zero]
      show _ * algebraMap K L (wcLlsScV W A K t c' b') =
        ((0 : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) : L)
      rw [h', mul_zero, ZeroMemClass.coe_zero]
  have hI' : Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) |
        ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x} =
      (Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}).map ι := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨x, hx, hb⟩
      have e : ι (algebraMap A ↥(integralClosure A L) (algebraMap ↥W A x)) = b := by
        apply Subtype.ext
        rw [hιv, hb]
        show algebraMap A L (algebraMap ↥W A x) =
          algebraMap K L (algebraMap A K (algebraMap ↥W A x))
        exact IsScalarTower.algebraMap_apply A K L _
      rw [SetLike.mem_coe, ← e]
      exact Ideal.mem_map_of_mem ι (Ideal.subset_span ⟨x, hx, rfl⟩)
    · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro g ⟨x, hx, hg⟩
      rw [SetLike.mem_coe, Ideal.mem_comap]
      refine Ideal.subset_span ⟨x, hx, ?_⟩
      rw [hιv, hg]
      show algebraMap A L (algebraMap ↥W A x) =
        algebraMap K L (algebraMap A K (algebraMap ↥W A x))
      exact IsScalarTower.algebraMap_apply A K L _
  have hIq : Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} ≤ y := by
    have hm𝔭 := hPD.2.2.2.2.1
    rw [Ideal.span_le]
    rintro b ⟨w₀, hw₀, hb⟩
    have hbeq : b = algebraMap A ↥(integralClosure A L) (algebraMap ↥W A w₀) := Subtype.ext hb
    have hmem : algebraMap ↥W A w₀ ∈ 𝔭 := hm𝔭 (Ideal.mem_map_of_mem _ hw₀)
    rw [← hyc, Ideal.mem_comap] at hmem
    rw [SetLike.mem_coe, hbeq]
    exact hmem
  have hreg := wcpa_dj_llsm_obi_t_regular Ω W A 𝔭 t hPD
  have havoid : ∀ P ∈ (Ideal.span {b : ↥(integralClosure A L) |
        ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}).minimalPrimes, P ≤ y →
      algebraMap A ↥(integralClosure A L) (t - algebraMap ↥W A c') ∉ P := fun P hP hPy =>
    wcpa_dj_llsm_obism_generic_avoid Ω W A K L 𝔭 t c' y hPD hc' hreg hy hyc P hP hPy
  have hle : ∀ J : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
      algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ J →
      J.comap ι ≤ y → J ≤ w := by
    intro J hvJ hJ
    refine wcpa_dj_llsm_obism_le_w Ω W A K L 𝔭 t c' b' hPD hc' w hwc hwU J hvJ ?_
    intro a ha
    rw [← hιA] at ha
    have h2 : algebraMap A ↥(integralClosure A L) a ∈ y := hJ (Ideal.mem_comap.mpr ha)
    rw [← hyc]
    exact h2
  have hint : ∀ z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
      ∃ p : Polynomial ↥(integralClosure A L), p.Monic ∧
        p.eval₂ ι z ∈ Ideal.span {algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          ⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩} := by
    intro z
    obtain ⟨p, hpm, hp⟩ := wcpa_dj_llsm_obism_int_mod_V Ω W A K L t c' b' z
    refine ⟨p.map (algebraMap A ↥(integralClosure A L)), hpm.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have e : ι.comp (algebraMap A ↥(integralClosure A L)) =
        (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)).comp
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := RingHom.ext hιA
    rw [e]
    exact hp
  have hq : y = w.comap ι := by
    ext x
    rw [Ideal.mem_comap]
    have e : ι x = ⟨(x : L), hs2a x⟩ := Subtype.ext (hιv x)
    rw [e]
    exact (wcpa_dj_llsm_obism_w_over_y Ω W A K L 𝔭 t y hPD hy hyc hU c' b' hc' w hwc x
      (hs2a x)).symm
  exact key _ _ ι hι _ _ (hιA _).symm _ hch y w hq _ _ hI' hIq havoid hv hle hint

theorem wcpa_dj_llsm_obi_exc_branch : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsScDF W A K L t c' b' →
      ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L))
        [w.IsPrime],
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w →
        ∃ Qe ∈ minimalPrimes (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
              (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w),
          wcObiImg W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
              ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∈ Qe ∧
          ∀ Q ∈ minimalPrimes (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp
              (algebraMap ↥W A))) ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w),
            wcObiImg W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
              ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) w
              (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
                (t - algebraMap ↥W A c')) ∈ Q → Q = Qe :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' b' hc' hb'm hb'0 hDF w _ hwc hwU
  classical

  have G5 : ∀ (R : Type u) [CommRing R] (𝔮 : Ideal R) [𝔮.IsPrime] (I P : Ideal R), P.IsPrime →
      I ≤ P → P ≤ 𝔮 → ∀ x : R, x ∈ P →
      (∀ P' : Ideal R, P'.IsPrime → I ≤ P' → P' ≤ P → P ≤ P') →
      (∀ P' : Ideal R, P'.IsPrime → I ≤ P' → P' ≤ 𝔮 → x ∈ P' → P ≤ P') →
      ∃ Qe ∈ minimalPrimes (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap R (Localization.AtPrime 𝔮))),
        Ideal.Quotient.mk (I.map (algebraMap R (Localization.AtPrime 𝔮)))
            (algebraMap R (Localization.AtPrime 𝔮) x) ∈ Qe ∧
        ∀ Q ∈ minimalPrimes (Localization.AtPrime 𝔮 ⧸ I.map (algebraMap R (Localization.AtPrime 𝔮))),
          Ideal.Quotient.mk (I.map (algebraMap R (Localization.AtPrime 𝔮)))
            (algebraMap R (Localization.AtPrime 𝔮) x) ∈ Q → Q = Qe := by
    intro R _ 𝔮 _ I P hPp hIP hP𝔮 x hx hmin habs
    set S := Localization.AtPrime 𝔮
    set ι := algebraMap R S
    set J := I.map ι
    set π := Ideal.Quotient.mk J
    have hπs : Function.Surjective π := Ideal.Quotient.mk_surjective
    have hc1 : ∀ Q : Ideal (S ⧸ J), Q.IsPrime → (Q.comap (π.comp ι)).IsPrime ∧
        I ≤ Q.comap (π.comp ι) ∧ Q.comap (π.comp ι) ≤ 𝔮 := by
      intro Q hQ
      refine ⟨Ideal.IsPrime.comap _, ?_, ?_⟩
      · intro i hi
        rw [Ideal.mem_comap, RingHom.comp_apply]
        have : ι i ∈ J := Ideal.mem_map_of_mem _ hi
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr this]
        exact Q.zero_mem
      · intro r hr
        by_contra hr'
        have hu : IsUnit (ι r) := (IsLocalization.AtPrime.isUnit_to_map_iff S 𝔮 r).mpr hr'
        exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hr (hu.map π))
    have hmc : ∀ Q : Ideal (S ⧸ J), (Q.comap (π.comp ι)).map (π.comp ι) = Q := by
      intro Q
      rw [← Ideal.comap_comap, ← Ideal.map_map]
      have h1 : ((Q.comap π).comap ι).map ι = Q.comap π :=
        IsLocalization.map_under 𝔮.primeCompl S _
      rw [h1]
      exact Ideal.map_comap_of_surjective π hπs Q
    have hcm : ∀ P' : Ideal R, P'.IsPrime → I ≤ P' → P' ≤ 𝔮 →
        (P'.map (π.comp ι)).IsPrime ∧ (P'.map (π.comp ι)).comap (π.comp ι) = P' := by
      intro P' hP' hI hq
      have hdisj : Disjoint (𝔮.primeCompl : Set R) P' := by
        rw [Set.disjoint_left]; intro a ha hb; exact ha (hq hb)
      have h1 : (P'.map ι).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint 𝔮.primeCompl S P' hP' hdisj
      have h2 : (P'.map ι).comap ι = P' :=
        IsLocalization.under_map_of_isPrime_disjoint 𝔮.primeCompl S hP' hdisj
      have hJ : J ≤ P'.map ι := Ideal.map_mono hI
      have hker : RingHom.ker π ≤ P'.map ι := by rw [Ideal.mk_ker]; exact hJ
      have h3 : ((P'.map ι).map π).IsPrime := Ideal.map_isPrime_of_surjective hπs hker
      have h4 : ((P'.map ι).map π).comap π = P'.map ι := by
        rw [Ideal.comap_map_of_surjective π hπs, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
        exact sup_eq_left.mpr hJ
      rw [← Ideal.map_map, ← Ideal.comap_comap]
      exact ⟨h3, by rw [h4, h2]⟩
    obtain ⟨hQeP, hQec⟩ := hcm P hPp hIP hP𝔮
    refine ⟨P.map (π.comp ι), ⟨⟨hQeP, bot_le⟩, ?_⟩, ?_, ?_⟩
    · intro Q' hQ' hle
      obtain ⟨h1, h2, _⟩ := hc1 Q' hQ'.1
      have : P ≤ Q'.comap (π.comp ι) := hmin _ h1 h2 (by
        calc Q'.comap (π.comp ι) ≤ (P.map (π.comp ι)).comap (π.comp ι) := Ideal.comap_mono hle
          _ = P := hQec)
      calc P.map (π.comp ι) ≤ (Q'.comap (π.comp ι)).map (π.comp ι) := Ideal.map_mono this
        _ = Q' := hmc Q'
    · exact Ideal.mem_map_of_mem (π.comp ι) hx
    · intro Q hQ hxQ
      obtain ⟨h1, h2, h3⟩ := hc1 Q hQ.1.1
      have hx' : x ∈ Q.comap (π.comp ι) := hxQ
      have hPQ : P ≤ Q.comap (π.comp ι) := habs _ h1 h2 h3 hx'
      have hle : P.map (π.comp ι) ≤ Q :=
        calc P.map (π.comp ι) ≤ (Q.comap (π.comp ι)).map (π.comp ι) := Ideal.map_mono hPQ
          _ = Q := hmc Q
      exact le_antisymm (hQ.2 ⟨hQeP, bot_le⟩ hle) hle

  have G3 : ∀ (RU RV : Type u) [CommRing RU] [CommRing RV] [Algebra RU L] [Algebra RV L]
      (S : Set L) (uB : ↥(integralClosure RU L)) (vB : ↥(integralClosure RV L))
      (J : Ideal ↥(integralClosure RU L)), (uB : L) * (vB : L) = 1 →
      J = (Ideal.span {z : ↥(integralClosure RU L) | (z : L) ∈ S}).radical →
      J.IsPrime → uB ∉ J →
      (∀ s ∈ S, ∃ z : ↥(integralClosure RU L), (z : L) = s) →
      (∀ s ∈ S, ∃ z : ↥(integralClosure RV L), (z : L) = s) →
      (∀ z : ↥(integralClosure RV L), ∃ (d : ℕ) (z' : ↥(integralClosure RU L)),
        (z' : L) = (z : L) * (uB : L) ^ d) →
      (∀ z : ↥(integralClosure RU L), ∃ (d : ℕ) (z' : ↥(integralClosure RV L)),
        (z' : L) = (z : L) * (vB : L) ^ d) →
      ∃ Pe : Ideal ↥(integralClosure RV L), Pe.IsPrime ∧
        Ideal.span {b : ↥(integralClosure RV L) | (b : L) ∈ S} ≤ Pe ∧ vB ∉ Pe ∧
        (∀ (z : ↥(integralClosure RV L)) (d : ℕ) (z' : ↥(integralClosure RU L)),
          (z' : L) = (z : L) * (uB : L) ^ d → (z ∈ Pe ↔ z' ∈ J)) ∧
        ∀ 𝔔 : Ideal ↥(integralClosure RV L), 𝔔.IsPrime →
          Ideal.span {b : ↥(integralClosure RV L) | (b : L) ∈ S} ≤ 𝔔 → vB ∉ 𝔔 → Pe ≤ 𝔔 := by
    intro RU RV _ _ _ _ S uB vB J huv hJ hJp huJ hSU hSV hVU hUV
    have hupow : ∀ k : ℕ, uB ^ k ∉ J := fun k hk => huJ (hJp.mem_of_pow_mem k hk)
    have WD : ∀ (z : ↥(integralClosure RV L)) (d e : ℕ) (z₁ z₂ : ↥(integralClosure RU L)),
        (z₁ : L) = (z : L) * (uB : L) ^ d → (z₂ : L) = (z : L) * (uB : L) ^ e →
        z₁ ∈ J → z₂ ∈ J := by
      intro z d e z₁ z₂ h1 h2 hz1
      have heq : z₁ * uB ^ e = z₂ * uB ^ d := by
        apply Subtype.ext
        simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
        rw [h1, h2]; ring
      have : z₂ * uB ^ d ∈ J := heq ▸ J.mul_mem_right _ hz1
      rcases hJp.mem_or_mem this with h | h
      · exact h
      · exact absurd h (hupow d)
    let Pe : Ideal ↥(integralClosure RV L) :=
      { carrier := {z | ∃ (d : ℕ) (z' : ↥(integralClosure RU L)),
          (z' : L) = (z : L) * (uB : L) ^ d ∧ z' ∈ J}
        add_mem' := by
          rintro a b ⟨d₁, y₁, h₁, hy₁⟩ ⟨d₂, y₂, h₂, hy₂⟩
          refine ⟨d₁ + d₂, y₁ * uB ^ d₂ + y₂ * uB ^ d₁, ?_,
            J.add_mem (J.mul_mem_right _ hy₁) (J.mul_mem_right _ hy₂)⟩
          simp only [AddMemClass.coe_add, MulMemClass.coe_mul, SubmonoidClass.coe_pow]
          rw [h₁, h₂]; ring
        zero_mem' := ⟨0, 0, by simp, J.zero_mem⟩
        smul_mem' := by
          rintro c z ⟨d, y, hy, hyJ⟩
          obtain ⟨e, s, hs⟩ := hVU c
          refine ⟨e + d, s * y, ?_, J.mul_mem_left _ hyJ⟩
          simp only [smul_eq_mul, MulMemClass.coe_mul]
          rw [hs, hy]; ring }
    have char : ∀ (z : ↥(integralClosure RV L)) (d : ℕ) (z' : ↥(integralClosure RU L)),
        (z' : L) = (z : L) * (uB : L) ^ d → (z ∈ Pe ↔ z' ∈ J) := by
      intro z d z' hz'
      constructor
      · rintro ⟨e, y, hy, hyJ⟩
        exact WD z e d y z' hy hz' hyJ
      · intro h
        exact ⟨d, z', hz', h⟩
    have h1J : (1 : ↥(integralClosure RU L)) ∉ J := fun h =>
      hJp.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have hPeP : Pe.IsPrime := by
      refine ⟨?_, ?_⟩
      · intro h
        have h1 : (1 : ↥(integralClosure RV L)) ∈ Pe := h ▸ Submodule.mem_top
        exact h1J ((char 1 0 1 (by simp)).mp h1)
      · intro a b hab
        obtain ⟨d₁, α, hα⟩ := hVU a
        obtain ⟨d₂, β, hβ⟩ := hVU b
        have : α * β ∈ J := (char (a * b) (d₁ + d₂) (α * β) (by
          simp only [MulMemClass.coe_mul]; rw [hα, hβ]; ring)).mp hab
        rcases hJp.mem_or_mem this with h | h
        · exact Or.inl ((char a d₁ α hα).mpr h)
        · exact Or.inr ((char b d₂ β hβ).mpr h)
    refine ⟨Pe, hPeP, ?_, ?_, char, ?_⟩
    · rw [Ideal.span_le]
      intro b hb
      have hb' : (b : L) ∈ S := hb
      obtain ⟨z', hz'⟩ := hSU _ hb'
      refine (char b 0 z' (by rw [pow_zero, mul_one, hz'])).mpr ?_
      rw [hJ]
      exact Ideal.le_radical (Ideal.subset_span (by show (z' : L) ∈ S; rw [hz']; exact hb'))
    · intro h
      exact h1J ((char vB 1 1 (by rw [OneMemClass.coe_one, pow_one, mul_comm, huv])).mp h)
    · intro 𝔔 h𝔔 hI hv z hz
      have Aux : ∀ y ∈ Ideal.span {z : ↥(integralClosure RU L) | (z : L) ∈ S},
          ∃ (e : ℕ) (y' : ↥(integralClosure RV L)), (y' : L) = (y : L) * (vB : L) ^ e ∧ y' ∈ 𝔔 := by
        intro y hy
        induction hy using Submodule.span_induction with
        | mem x hx =>
          have hx' : (x : L) ∈ S := hx
          obtain ⟨y', hy'⟩ := hSV _ hx'
          exact ⟨0, y', by rw [pow_zero, mul_one, hy'],
            hI (Ideal.subset_span (by show (y' : L) ∈ S; rw [hy']; exact hx'))⟩
        | zero => exact ⟨0, 0, by simp, 𝔔.zero_mem⟩
        | add x y _ _ hx hy =>
          obtain ⟨e₁, y₁, h₁, h₁𝔔⟩ := hx
          obtain ⟨e₂, y₂, h₂, h₂𝔔⟩ := hy
          refine ⟨e₁ + e₂, y₁ * vB ^ e₂ + y₂ * vB ^ e₁, ?_,
            𝔔.add_mem (𝔔.mul_mem_right _ h₁𝔔) (𝔔.mul_mem_right _ h₂𝔔)⟩
          simp only [AddMemClass.coe_add, MulMemClass.coe_mul, SubmonoidClass.coe_pow]
          rw [h₁, h₂]; ring
        | smul a x _ hx =>
          obtain ⟨e, y₁, h₁, h₁𝔔⟩ := hx
          obtain ⟨f, r', hr'⟩ := hUV a
          refine ⟨f + e, r' * y₁, ?_, 𝔔.mul_mem_left _ h₁𝔔⟩
          simp only [smul_eq_mul, MulMemClass.coe_mul]
          rw [hr', h₁]; ring
      obtain ⟨d, z', hz', hz'J⟩ := hz
      rw [hJ] at hz'J
      obtain ⟨k, hk⟩ := hz'J
      obtain ⟨e, y', hy', hy'𝔔⟩ := Aux _ hk
      have hab : ((uB : L) ^ d) ^ k * ((vB : L) ^ d) ^ k = 1 := by
        rw [← mul_pow, ← mul_pow, huv, one_pow, one_pow]
      have key : z ^ k * vB ^ e = y' * vB ^ (d * k) := by
        apply Subtype.ext
        simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
        rw [hy']
        simp only [SubmonoidClass.coe_pow]
        rw [hz', pow_mul]
        linear_combination (-((z : L) ^ k * (vB : L) ^ e)) * hab
      have hmem : z ^ k * vB ^ e ∈ 𝔔 := key ▸ 𝔔.mul_mem_right _ hy'𝔔
      rcases h𝔔.mem_or_mem hmem with h | h
      · exact h𝔔.mem_of_pow_mem k h
      · exact absurd (h𝔔.mem_of_pow_mem e h) hv

  have G1 : ∀ (Wr : Type u) [CommRing Wr] [IsLocalRing Wr] (A0 : Type u) [CommRing A0]
      (𝔭0 : Ideal A0), 𝔭0.IsMaximal →
      ∀ (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B]
      (ιWA : Wr →+* A0) (ιAR : A0 →+* R) (u : R) (J : Ideal B) (x : B),
      (∀ z : B, ∃ p : Polynomial Wr,
        z - Polynomial.eval₂ ((algebraMap R B).comp (ιAR.comp ιWA)) x p ∈ J) →
      (∀ p : Polynomial Wr, Polynomial.eval₂ ((algebraMap R B).comp (ιAR.comp ιWA)) x p ∈ J →
        ∀ i, p.coeff i ∈ IsLocalRing.maximalIdeal Wr) →
      (∀ c ∈ IsLocalRing.maximalIdeal Wr, (algebraMap R B).comp (ιAR.comp ιWA) c ∈ J) →
      (∀ a ∈ 𝔭0, (algebraMap R B).comp ιAR a ∈ J) →
      (∀ r : R, ∃ g : Polynomial A0, r = Polynomial.eval₂ ιAR u g) →
      IsIntegral R x →
      J.IsPrime ∧ algebraMap R B u ∉ J ∧ ∀ p : Polynomial A0,
        Polynomial.eval₂ ((algebraMap R B).comp ιAR) (algebraMap R B u) p ∈ J →
          ∀ i, p.coeff i ∈ 𝔭0 := by
    intro Wr _ _ A0 _ 𝔭0 h𝔭0 R _ B _ _ ιWA ιAR u J x hgen htr hmJ h𝔭J hRg hxint
    let ιW : Wr →+* B := (algebraMap R B).comp (ιAR.comp ιWA)
    let res : Wr →+* IsLocalRing.ResidueField Wr := IsLocalRing.residue Wr
    let φ : Polynomial Wr →+* B ⧸ J := (Ideal.Quotient.mk J).comp (Polynomial.eval₂RingHom ιW x)
    have hφ : ∀ p, φ p = Ideal.Quotient.mk J (Polynomial.eval₂ ιW x p) := fun p => rfl
    have hφs : Function.Surjective φ := by
      intro q
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨p, hp⟩ := hgen z
      exact ⟨p, by rw [hφ]; exact (Ideal.Quotient.eq.mpr hp).symm⟩
    let ρ : Polynomial Wr →+* Polynomial (IsLocalRing.ResidueField Wr) := Polynomial.mapRingHom res
    have hρ : ∀ p, ρ p = p.map res := fun p => rfl
    have hρs : Function.Surjective ρ :=
      Polynomial.map_surjective res IsLocalRing.residue_surjective
    have hker : RingHom.ker φ = RingHom.ker ρ := by
      ext p
      rw [RingHom.mem_ker, RingHom.mem_ker, hφ, Ideal.Quotient.eq_zero_iff_mem, hρ]
      constructor
      · intro h
        ext i
        rw [Polynomial.coeff_map, Polynomial.coeff_zero]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr (htr p h i)
      · intro h
        rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def]
        apply Ideal.sum_mem
        intro i _
        apply Ideal.mul_mem_right
        apply hmJ
        have := congrArg (fun q => Polynomial.coeff q i) h
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
        exact (IsLocalRing.residue_eq_zero_iff _).mp this
    let e1 := RingHom.quotientKerEquivOfSurjective hφs
    let e2 := RingHom.quotientKerEquivOfSurjective hρs
    let e12 := Ideal.quotEquivOfEq hker
    let Ψ : B ⧸ J ≃+* Polynomial (IsLocalRing.ResidueField Wr) := (e1.symm.trans e12).trans e2
    let θ : B →+* Polynomial (IsLocalRing.ResidueField Wr) := Ψ.toRingHom.comp (Ideal.Quotient.mk J)
    have hθp : ∀ p, θ (Polynomial.eval₂ ιW x p) = p.map res := by
      intro p
      have h1 : e1.symm (Ideal.Quotient.mk J (Polynomial.eval₂ ιW x p)) =
          Ideal.Quotient.mk _ p := by
        rw [RingEquiv.symm_apply_eq]; rfl
      show e2 (e12 (e1.symm (Ideal.Quotient.mk J (Polynomial.eval₂ ιW x p)))) = _
      rw [h1, Ideal.quotEquivOfEq_mk]; rfl
    have hθker : ∀ z, θ z = 0 ↔ z ∈ J := by
      intro z
      show Ψ (Ideal.Quotient.mk J z) = 0 ↔ _
      rw [map_eq_zero_iff Ψ Ψ.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hθx : θ x = Polynomial.X := by
      have := hθp Polynomial.X
      rwa [Polynomial.eval₂_X, Polynomial.map_X] at this
    let α : A0 →+* Polynomial (IsLocalRing.ResidueField Wr) := θ.comp ((algebraMap R B).comp ιAR)
    have hα𝔭 : ∀ a, α a = 0 ↔ a ∈ 𝔭0 := by
      intro a
      constructor
      · intro h
        by_contra ha
        obtain ⟨y, i, hi, hyi⟩ := h𝔭0.exists_inv ha
        have hαi : α i = 0 := (hθker _).mpr (h𝔭J i hi)
        have := congrArg α hyi
        rw [map_add, map_mul, h, mul_zero, zero_add, map_one, hαi] at this
        exact zero_ne_one this
      · intro h; exact (hθker _).mpr (h𝔭J a h)
    have hαC : ∀ a, α a = Polynomial.C ((α a).coeff 0) := by
      intro a
      by_cases ha : a ∈ 𝔭0
      · rw [(hα𝔭 a).mpr ha]; simp
      · obtain ⟨y, i, hi, hyi⟩ := h𝔭0.exists_inv ha
        have hαi : α i = 0 := (hα𝔭 i).mpr hi
        have h1 : α y * α a = 1 := by
          have := congrArg α hyi
          rwa [map_add, map_mul, hαi, add_zero, map_one] at this
        have hu : IsUnit (α a) := ⟨⟨α a, α y, by rw [mul_comm]; exact h1, h1⟩, rfl⟩
        obtain ⟨r, _, hr⟩ := Polynomial.isUnit_iff.mp hu
        rw [← hr, Polynomial.coeff_C_zero]
    let σ : A0 →+* IsLocalRing.ResidueField Wr := Polynomial.constantCoeff.comp α
    have hασ : α = Polynomial.C.comp σ := RingHom.ext fun a => by
      show α a = Polynomial.C ((α a).coeff 0); exact hαC a
    have hTnc : ∀ k, θ (algebraMap R B u) ≠ Polynomial.C k := by
      intro k hk
      let β : R →+* Polynomial (IsLocalRing.ResidueField Wr) := θ.comp (algebraMap R B)
      have hβC : ∀ r, β r = Polynomial.C ((β r).coeff 0) := by
        intro r
        obtain ⟨g, rfl⟩ := hRg r
        have e : β (Polynomial.eval₂ ιAR u g) =
            Polynomial.eval₂ (Polynomial.C.comp σ) (Polynomial.C k) g := by
          rw [Polynomial.hom_eval₂]
          have h1 : β.comp ιAR = Polynomial.C.comp σ := hασ
          have h2 : β u = Polynomial.C k := hk
          rw [h1, h2]
        rw [e, ← Polynomial.hom_eval₂, Polynomial.coeff_C_zero]
      let β₀ : R →+* IsLocalRing.ResidueField Wr := Polynomial.constantCoeff.comp β
      have hββ : β = Polynomial.C.comp β₀ := RingHom.ext fun r => by
        show β r = Polynomial.C ((β r).coeff 0); exact hβC r
      obtain ⟨g, hgm, hg⟩ := hxint
      have h0 := congrArg θ hg
      rw [map_zero, Polynomial.hom_eval₂, hθx] at h0
      have h1 : θ.comp (algebraMap R B) = Polynomial.C.comp β₀ := hββ
      rw [h1, ← Polynomial.eval₂_map, Polynomial.eval₂_C_X] at h0
      exact (hgm.map β₀).ne_zero h0
    refine ⟨?_, ?_, ?_⟩
    · have : J = RingHom.ker θ := by ext z; rw [RingHom.mem_ker, hθker]
      rw [this]; exact RingHom.ker_isPrime θ
    · intro hu
      exact hTnc 0 (by rw [(hθker _).mpr hu, map_zero])
    · intro p hp i
      have h0 := (hθker _).mpr hp
      rw [Polynomial.hom_eval₂] at h0
      have h1 : θ.comp ((algebraMap R B).comp ιAR) = Polynomial.C.comp σ := hασ
      rw [h1, ← Polynomial.eval₂_map] at h0
      have h2 : (p.map σ).comp (θ (algebraMap R B u)) = 0 := h0
      rcases Polynomial.comp_eq_zero_iff.mp h2 with h3 | ⟨_, h3⟩
      · have h4 : σ (p.coeff i) = 0 := by
          rw [← Polynomial.coeff_map, h3, Polynomial.coeff_zero]
        apply (hα𝔭 _).mp
        have h5 : α (p.coeff i) = Polynomial.C (σ (p.coeff i)) := by rw [hασ]; rfl
        rw [h5, h4, map_zero]
      · exact absurd h3 (hTnc _)

  have G2 : ∀ (u v : K), u * v = 1 → ∀ z : ↥(integralClosure ↥(Algebra.adjoin A {v}) L),
      ∃ (d : ℕ) (z' : ↥(integralClosure ↥(Algebra.adjoin A {u}) L)),
        (z' : L) = (z : L) * algebraMap K L u ^ d := by
    intro u v huv z
    have hM : ∀ r ∈ Algebra.adjoin A {v}, ∃ D : ℕ, ∀ k, D ≤ k →
        r * u ^ k ∈ Algebra.adjoin A {u} := by
      intro r hr
      induction hr using Algebra.adjoin_induction with
      | mem y hy =>
        rw [Set.mem_singleton_iff] at hy
        subst hy
        refine ⟨1, fun k hk => ?_⟩
        obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
        have : y * u ^ (1 + j) = u ^ j := by
          rw [pow_add, pow_one, ← mul_assoc, mul_comm y u, huv, one_mul]
        rw [this]
        exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton u)) j
      | algebraMap a =>
        refine ⟨0, fun k _ => ?_⟩
        exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a)
          (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton u)) k)
      | add y y' _ _ hy hy' =>
        obtain ⟨D₁, h₁⟩ := hy
        obtain ⟨D₂, h₂⟩ := hy'
        refine ⟨max D₁ D₂, fun k hk => ?_⟩
        rw [add_mul]
        exact Subalgebra.add_mem _ (h₁ k (le_of_max_le_left hk)) (h₂ k (le_of_max_le_right hk))
      | mul y y' _ _ hy hy' =>
        obtain ⟨D₁, h₁⟩ := hy
        obtain ⟨D₂, h₂⟩ := hy'
        refine ⟨D₁ + D₂, fun k hk => ?_⟩
        obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
        have : y * y' * u ^ (D₁ + D₂ + j) = (y * u ^ D₁) * (y' * u ^ (D₂ + j)) := by ring
        rw [this]
        exact Subalgebra.mul_mem _ (h₁ D₁ le_rfl) (h₂ _ (Nat.le_add_right _ _))
    obtain ⟨f, hfm, hf⟩ := (mem_integralClosure_iff _ _).mp z.2
    set n := f.natDegree with hn
    choose Df hDf using fun i => hM ((f.coeff i : ↥(Algebra.adjoin A {v})) : K) (f.coeff i).2
    set D := ∑ i ∈ Finset.range n, Df i with hD
    have hDi : ∀ i < n, Df i ≤ D := fun i hi =>
      Finset.single_le_sum (f := Df) (fun j _ => Nat.zero_le _) (Finset.mem_range.mpr hi)
    set fK := f.map (algebraMap ↥(Algebra.adjoin A {v}) K) with hfK
    have hfKm : fK.Monic := hfm.map _
    have hfKdeg : fK.natDegree = n := hfm.natDegree_map _
    set F := fK.scaleRoots (u ^ D) with hF
    have hFm : F.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hfKm
    have hFl : F ∈ Polynomial.lifts (algebraMap ↥(Algebra.adjoin A {u}) K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [hF, Polynomial.coeff_scaleRoots, hfKdeg, hfK, Polynomial.coeff_map]
      rcases lt_or_ge i n with hi | hi
      · have hk : Df i ≤ D * (n - i) :=
          le_trans (hDi i hi) (Nat.le_mul_of_pos_right _ (Nat.sub_pos_of_lt hi))
        have hmem := hDf i _ hk
        refine ⟨⟨_, hmem⟩, ?_⟩
        rw [← pow_mul]; rfl
      · rw [Nat.sub_eq_zero_of_le hi, pow_zero, mul_one]
        rcases eq_or_lt_of_le hi with h | h
        · rw [← h, hfm.coeff_natDegree, map_one]; exact ⟨1, map_one _⟩
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, map_zero]; exact ⟨0, map_zero _⟩
    obtain ⟨G, hGmap, _, hGm⟩ := Polynomial.lifts_and_degree_eq_and_monic hFl hFm
    have hcompU : (algebraMap K L).comp (algebraMap ↥(Algebra.adjoin A {u}) K) =
        algebraMap ↥(Algebra.adjoin A {u}) L := RingHom.ext fun r => rfl
    have hcompV : (algebraMap K L).comp (algebraMap ↥(Algebra.adjoin A {v}) K) =
        algebraMap ↥(Algebra.adjoin A {v}) L := RingHom.ext fun r => rfl
    have hint : IsIntegral ↥(Algebra.adjoin A {u}) (algebraMap K L (u ^ D) * (z : L)) := by
      refine ⟨G, hGm, ?_⟩
      have e1 : Polynomial.eval₂ (algebraMap ↥(Algebra.adjoin A {u}) L)
          (algebraMap K L (u ^ D) * (z : L)) G =
          Polynomial.eval₂ (algebraMap K L) (algebraMap K L (u ^ D) * (z : L)) F := by
        rw [← hGmap, Polynomial.eval₂_map, hcompU]
      rw [e1, hF, Polynomial.scaleRoots_eval₂_mul, hfKdeg]
      have e2 : Polynomial.eval₂ (algebraMap K L) (z : L) fK = 0 := by
        rw [hfK, Polynomial.eval₂_map, hcompV]; exact hf
      rw [e2, mul_zero]
    refine ⟨D, ⟨algebraMap K L (u ^ D) * (z : L), (mem_integralClosure_iff _ _).mpr hint⟩, ?_⟩
    show algebraMap K L (u ^ D) * (z : L) = (z : L) * algebraMap K L u ^ D
    rw [map_pow, mul_comm]


  obtain ⟨_, hNZ, _, h𝔭max, _, _, h𝔭eq, _⟩ := hPD
  haveI := hNZ
  have hb'A : algebraMap ↥W A b' ≠ 0 := by
    rw [Algebra.algebraMap_eq_smul_one]; exact smul_ne_zero hb'0 one_ne_zero
  have hb'K : algebraMap A K (algebraMap ↥W A b') ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hb'A
  obtain ⟨x, hgen, htr⟩ := hDF
  have hmJ : ∀ c ∈ IsLocalRing.maximalIdeal ↥W,
      ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})).comp (algebraMap ↥W A))) c ∈
        wcLlsScJ W A K L t c' b' := by
    intro c hc
    unfold wcLlsScJ
    exact Ideal.le_radical (Ideal.subset_span ⟨c, hc, rfl⟩)
  have hUb : wcLlsScS W A K t c' b' * algebraMap A K (algebraMap ↥W A b') =
      algebraMap A K (t - algebraMap ↥W A c') := by
    unfold wcLlsScS; exact div_mul_cancel₀ _ hb'K
  have hιτ : (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (t - algebraMap ↥W A c')) =
      ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
        ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})).comp (algebraMap ↥W A))) b' *
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
        ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
    apply Subtype.ext
    show algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A b')) *
        algebraMap K L (wcLlsScS W A K t c' b')
    rw [← map_mul, ← hUb, mul_comm]
  have hτJ : (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (t - algebraMap ↥W A c')) ∈
        wcLlsScJ W A K L t c' b' := by
    rw [hιτ]; exact Ideal.mul_mem_right _ _ (hmJ b' hb'm)
  have h𝔭J : ∀ a ∈ 𝔭, ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))) a ∈
        wcLlsScJ W A K L t c' b' := by
    have hle : 𝔭 ≤ (wcLlsScJ W A K L t c' b').comap
        ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))) := by
      rw [h𝔭eq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e : ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))) t =
            (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (t - algebraMap ↥W A c')) +
            ((algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comp
            ((algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})).comp
              (algebraMap ↥W A))) c' := by
          simp only [RingHom.comp_apply]
          rw [← map_add, ← map_add, sub_add_cancel]
        rw [e]
        exact Ideal.add_mem _ hτJ (hmJ c' hc')
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc
        exact hmJ c hc
    exact fun a ha => hle ha
  have hRg : ∀ r : ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}), ∃ g : Polynomial A,
      r = Polynomial.eval₂ (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}))
        ⟨wcLlsScS W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ g := by
    intro r
    obtain ⟨p, hp⟩ := Algebra.adjoin_eq_exists_aeval A (wcLlsScS W A K t c' b') r
    refine ⟨p, Subtype.ext ?_⟩
    rw [← Polynomial.aeval_def, Polynomial.aeval_subalgebra_coe]
    exact hp.symm
  obtain ⟨hJp, huJ, htrA⟩ := G1 ↥W A 𝔭 h𝔭max ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
    ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) (algebraMap ↥W A)
