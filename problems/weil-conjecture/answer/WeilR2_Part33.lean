        show f (Polynomial.X - Polynomial.C c) = 0
        rw [map_sub, hfX, hfc, ← map_sub, hz, map_zero]
      exact one_ne_zero (hsrB (by simp [hf0]))
    · obtain ⟨-, hg0, huv0, -⟩ := hrest
      intro hz
      apply hg0
      apply hWinj
      rw [← huv0, hz, zero_mul, map_zero]

  obtain ⟨h, hh𝔭, hrest2⟩ :=
    wcpa_dj_llsm_bcc_chart_etale W A K 𝔭 k z₀ b hPD hk hbm hb0 hz0
  intro s hs N _ hN
  rw [← hs] at hrest2
  have hh0 : h ≠ 0 := fun h0 => hh𝔭 (h0 ▸ 𝔭.zero_mem)
  have hhK : algebraMap A K h ≠ 0 := (map_ne_zero_iff _ hinjA).mpr hh0
  generalize hη : (algebraMap A K h)⁻¹ = η at hrest2
