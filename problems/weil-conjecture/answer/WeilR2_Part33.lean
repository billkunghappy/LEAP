  obtain ⟨p₀, hp₀⟩ := hDFL _ hh₀
  obtain ⟨q, hq⟩ : ∃ q, q = Polynomial.divByMonic p₀ ((Polynomial.X ^ d + T) ^ N) := ⟨_, rfl⟩
  obtain ⟨r, hr⟩ : ∃ r, r = Polynomial.modByMonic p₀ ((Polynomial.X ^ d + T) ^ N) := ⟨_, rfl⟩
