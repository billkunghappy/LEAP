  have hNQ : wcLlsASbN W A K u (a' * q') =
      Q.comap (algebraMap ↥(wcLlsASbS W A K u (a' * q')) ↥(wcIsicgC1 W A K L u (a' * q'))) :=
    hQ.symm

  obtain ⟨P, _, k, hk⟩ :=
    wcNd_hens_exists (Localization.AtPrime Q) (IsLocalRing.maximalIdeal _) inferInstance
  have hG := wcpa_dj_llsm_sd_good_model Ω W hW hWt A K L 𝔭 (.ann u v g) hPD u (a' * q') hbm hb0
    (Or.inr ⟨u, v, g, rfl, hbg, rfl⟩) _ rfl Q hQ hnb P k hk

  obtain ⟨PZ, _, eZ, heZ⟩ := wcNd_hens_exists (Localization.AtPrime (wcLlsASbN W A K u (a' * q')))
    (IsLocalRing.maximalIdeal _) inferInstance
  haveI hlamL : IsLocalHom (Localization.localRingHom _ Q _ hNQ) :=
    Localization.isLocalHom_localRingHom _ Q _ hNQ
  obtain ⟨jZ, ⟨hjZ, hjZl⟩, -⟩ := heZ.2.2 P hk.1 (k.comp (Localization.localRingHom _ Q _ hNQ))
    (fun a => by
