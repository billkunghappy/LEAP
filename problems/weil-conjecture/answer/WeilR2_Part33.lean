      rw [e]; exact add_mem (mul_mem (hMT _ hq₂) h₁) (mul_mem (hMT _ hq₁) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨q₁, hq₁, h₁⟩ := hx
      obtain ⟨q₂, hq₂, h₂⟩ := hy
      refine ⟨q₁ * q₂, mul_mem hq₁ hq₂, ?_⟩
      have e : q₁ * q₂ * (x * y) = (q₁ * x) * (q₂ * y) := by ring
      rw [e]; exact mul_mem h₁ h₂
  have primeExt : ∀ (C C'' L : Type u) [CommRing C] [CommRing C''] [Field L]
    (i : C →+* L) (i'' : C'' →+* L) (j : C →+* C'') (hi : Function.Injective i)
    (hcomp : i''.comp j = i)
    (Q : Ideal C) (hQ : Q.IsPrime) (H : ∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y), ∃ Q'' : Ideal C'', Q''.IsPrime ∧ Q''.comap j = Q := by
    intro C C'' L _ _ _ i i'' j hi hcomp Q hQ H
    have hij : ∀ x, i'' (j x) = i x := fun x => by rw [← hcomp]; rfl
    have indep : ∀ (y : C'') (d x d' x' : C), d' ∉ Q → i x = i d * i'' y →
        i x' = i d' * i'' y → x' ∈ Q → x ∈ Q := by
      intro y d x d' x' hd' h1 h2 hx'
      have e : x * d' = x' * d := hi (by rw [map_mul, map_mul, h1, h2]; ring)
      have : x * d' ∈ Q := by rw [e]; exact Q.mul_mem_right _ hx'
      exact (hQ.mem_or_mem this).resolve_right hd'
    have h1Q : (1 : C) ∉ Q := fun h => hQ.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    let Q'' : Ideal C'' :=
      { carrier := {y | ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q}
        add_mem' := by
          rintro a b ⟨d₁, x₁, hd₁, h1, hx1⟩ ⟨d₂, x₂, hd₂, h2, hx2⟩
          refine ⟨d₁ * d₂, x₁ * d₂ + x₂ * d₁, fun h => ?_, ?_,
            add_mem (Q.mul_mem_right _ hx1) (Q.mul_mem_right _ hx2)⟩
          · rcases hQ.mem_or_mem h with h | h
            · exact hd₁ h
            · exact hd₂ h
          · rw [map_add, map_mul, map_mul, map_mul, h1, h2, map_add]; ring
        zero_mem' := ⟨1, 0, h1Q, by simp, Q.zero_mem⟩
        smul_mem' := by
          rintro c b ⟨d₁, x₁, hd₁, h1, hx1⟩
          obtain ⟨dc, xc, hdc, hc⟩ := H c
          refine ⟨dc * d₁, xc * x₁, fun h => ?_, ?_, Q.mul_mem_left _ hx1⟩
          · rcases hQ.mem_or_mem h with h | h
            · exact hdc h
            · exact hd₁ h
          · rw [smul_eq_mul, map_mul, map_mul, map_mul, hc, h1]; ring }
    have memQ : ∀ y, y ∈ Q'' ↔ ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q := fun y => Iff.rfl
    refine ⟨Q'', ⟨?_, ?_⟩, ?_⟩
    · rw [Ne, Ideal.eq_top_iff_one, memQ]
      rintro ⟨d, x, hd, h, hx⟩
      have : x = d := hi (by rw [h, map_one, mul_one])
      exact hd (this ▸ hx)
    · intro a b hab
      obtain ⟨d, x, hd, h, hx⟩ := (memQ _).mp hab
      obtain ⟨d₁, x₁, hd₁, h1⟩ := H a
      obtain ⟨d₂, x₂, hd₂, h2⟩ := H b
      have h12 : i (x₁ * x₂) = i (d₁ * d₂) * i'' (a * b) := by
        rw [map_mul, map_mul, map_mul, h1, h2]; ring
      have hd12 : d₁ * d₂ ∉ Q := fun h => by
        rcases hQ.mem_or_mem h with h | h
        · exact hd₁ h
        · exact hd₂ h
