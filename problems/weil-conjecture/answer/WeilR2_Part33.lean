    unfold wcLlsScJ at hz
    obtain ⟨n, hn⟩ := hz
    have hspan : ∀ a ∈ Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
