  have hdisj : Disjoint (↑(Submonoid.powers h) : Set A) ↑𝔭 :=
    (Ideal.disjoint_powers_iff_notMem h h𝔭max.isPrime.isRadical).mpr hh𝔭
  have hpB : (𝔭.map (algebraMap A B)).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) B 𝔭 h𝔭max.isPrime hdisj
  have hunder : Ideal.comap (algebraMap A B) (𝔭.map (algebraMap A B)) = 𝔭 :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) B h𝔭max.isPrime hdisj
  have hmaxB : (𝔭.map (algebraMap A B)).IsMaximal := by
    refine ⟨⟨hpB.ne_top, fun J hJ => ?_⟩⟩
    by_contra hJt
    have h1 : 𝔭 ≤ Ideal.comap (algebraMap A B) J := hunder ▸ Ideal.comap_mono hJ.le
    have hJeq : Ideal.map (algebraMap A B) (Ideal.comap (algebraMap A B) J) = J :=
      IsLocalization.map_under (Submonoid.powers h) B J
    have h2 : Ideal.comap (algebraMap A B) J ≠ ⊤ := fun h3 => hJt (by
      rw [← hJeq, h3, Ideal.map_top])
    have h4 := h𝔭max.eq_of_le h2 h1
    apply ne_of_lt hJ
    rw [← hJeq, ← h4]
  have hPDB : wcLlsPD W B (𝔭.map (algebraMap A B)) (.disc (g (MvPolynomial.X 0))) := by
    rw [hgX]
    unfold wcLlsPD
    refine ⟨?_, ?_, ?_, hmaxB, ?_, ?_, ?_, ?_⟩
    · exact Algebra.FiniteType.trans hFT
        (@Algebra.FiniteType.of_finitePresentation _ _ _ _ _
          (IsLocalization.Away.finitePresentation h))
    · refine ⟨fun {c x} hcx => ?_⟩
      rw [Algebra.smul_def] at hcx
      rcases mul_eq_zero.mp hcx with h1 | h1
      · left
        have h2 : algebraMap ↥W A c = 0 := hinjAB (h1.trans (map_zero _).symm)
        have h3 : c • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one]; exact h2
        exact (smul_eq_zero.mp h3).resolve_right one_ne_zero
      · right; exact h1
    · exact isIntegrallyClosed_of_isLocalization B (Submonoid.powers h)
        (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
    · rw [show algebraMap ↥W B = (algebraMap A B).comp (algebraMap ↥W A) from rfl,
