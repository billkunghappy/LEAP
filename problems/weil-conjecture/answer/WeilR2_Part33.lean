    · obtain ⟨c', k', _, hc'⟩ := s2a κ _ hu
      rw [hc', hco] at e0 ek
      by_cases hk' : k' = 0
      · subst hk'; simp [Ne.symm hk] at ek; exact hc ek.symm
      · simp [hk'] at e0
    · rw [hu] at e0; simp at e0
  have s3core : ∀ (κ : Type u) [Field κ] (τ : Polynomial κ →+* LaurentPolynomial κ)
      (t : LaurentPolynomial κ), Function.Injective τ →
      (∀ a, τ (Polynomial.C a) = LaurentPolynomial.C a) → τ Polynomial.X = t → t ≠ 0 →
      (∀ f, ∃ (N : ℕ) (p : Polynomial κ), τ p = f * t ^ N) →
      ∀ (D : Subring (LaurentPolynomial κ)) (yb : LaurentPolynomial κ) (c : κ) (k : ℕ),
