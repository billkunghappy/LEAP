    exact hmap (Ideal.mem_map_of_mem _ hy)
  letI : Field (Localization.Away h ⧸ 𝔭.map (algebraMap A (Localization.Away h))) :=
    Ideal.Quotient.field _
  have huPB : algebraMap A (Localization.Away h) u ∈ 𝔭.map (algebraMap A (Localization.Away h)) :=
    Ideal.mem_map_of_mem _ hu𝔭
  have hvPB : algebraMap A (Localization.Away h) v ∈ 𝔭.map (algebraMap A (Localization.Away h)) :=
    Ideal.mem_map_of_mem _ hv𝔭
  have hqPB : algebraMap ↥W (Localization.Away h) q ∈
      𝔭.map (algebraMap A (Localization.Away h)) := by
    rw [hWB]; exact Ideal.mem_map_of_mem _ (hw𝔭 q hq)
  let χ₀ : Polynomial (Localization.Away h) →+*
      Localization.Away h ⧸ 𝔭.map (algebraMap A (Localization.Away h)) :=
    (Ideal.Quotient.mk _).comp Polynomial.constantCoeff
  have hIχ : I ≤ RingHom.ker χ₀ := by
    rw [hIdef, Ideal.span_le]
    rintro x (rfl | rfl)
    · show Ideal.Quotient.mk _ (Polynomial.constantCoeff _) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      simpa using (Ideal.neg_mem_iff _).mpr huPB
    · show Ideal.Quotient.mk _ (Polynomial.constantCoeff _) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      simpa using (Ideal.neg_mem_iff _).mpr hqPB
  have hkerle : RingHom.ker σ ≤ RingHom.ker χ₀ := by
    rw [← hkσ]; exact hIχ
  let χ : S →+* Localization.Away h ⧸ 𝔭.map (algebraMap A (Localization.Away h)) :=
    σ.liftOfSurjective hσsurj ⟨χ₀, hkerle⟩
  have hχ : ∀ p, χ (σ p) = Ideal.Quotient.mk _ (p.coeff 0) := fun p => by
    show (σ.liftOfSurjective hσsurj ⟨χ₀, hkerle⟩) (σ p) = _
    rw [RingHom.liftOfSurjective_comp_apply]
    show Ideal.Quotient.mk _ (Polynomial.constantCoeff p) = _
    rw [Polynomial.constantCoeff_apply]
  have hb' : ∀ b, algebraMap (Localization.Away h) S b = σ (Polynomial.C b) := fun b =>
    (Polynomial.aeval_C u₃ b).symm
  have hX : u₃ = σ Polynomial.X := (Polynomial.aeval_X u₃).symm
  have hχb : ∀ b, χ (algebraMap (Localization.Away h) S b) = Ideal.Quotient.mk _ b := by
    intro b; rw [hb', hχ, Polynomial.coeff_C_zero]
  have hχu : χ u₃ = 0 := by rw [hX, hχ, Polynomial.coeff_X_zero, map_zero]
  have hχsurj : Function.Surjective χ := by
    intro y
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨_, hχb b⟩
  have hmaxχ := RingHom.ker_isMaximal_of_surjective χ hχsurj
  have h𝔭₃eq : 𝔭₃ = RingHom.ker χ := by
    apply le_antisymm
    · apply sup_le
      · rw [Ideal.span_le]
        rintro x (rfl | hx)
        · exact RingHom.mem_ker.mpr hχu
        · rw [Set.mem_singleton_iff.mp hx]
          exact RingHom.mem_ker.mpr (by rw [hv₃def, hχb]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hvPB)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, RingHom.mem_ker, hAWS, RingHom.comp_apply, hχb,
          Ideal.Quotient.eq_zero_iff_mem, hWB]
        exact Ideal.mem_map_of_mem _ (hw𝔭 w hw)
    · intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨p, rfl⟩ := hσsurj x
      rw [hχ, Ideal.Quotient.eq_zero_iff_mem] at hx
      have hp' : p = Polynomial.X * p.divX + Polynomial.C (p.coeff 0) :=
        (Polynomial.X_mul_divX_add p).symm
      rw [hp', map_add, map_mul, ← hX, ← hb']
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hu₃mem) (hB𝔭 _ hx)
  have hmax₃ : 𝔭₃.IsMaximal := by rw [h𝔭₃eq]; exact hmaxχ

  haveI : IsScalarTower ↥W (Localization.Away h) S := IsScalarTower.of_algebraMap_eq' rfl
  have hFTBS : Algebra.FiniteType (Localization.Away h) S := by
    have h1 := Subalgebra.fg_adjoin_finset (R := Localization.Away h) ({s} : Finset K)
    rw [Finset.coe_singleton] at h1
    exact (Subalgebra.fg_iff_finiteType _).mp h1
  have hFTWB : Algebra.FiniteType ↥W (Localization.Away h) :=
    Algebra.FiniteType.trans hFT inferInstance
  have hFTWS : Algebra.FiniteType ↥W S := Algebra.FiniteType.trans hFTWB hFTBS
  have hNZS : NoZeroSMulDivisors ↥W S := by
    refine ⟨fun {w x} hwx => ?_⟩
    rw [Algebra.smul_def] at hwx
    rcases mul_eq_zero.mp hwx with h1 | h1
    · left
      have h2 : algebraMap A K (algebraMap ↥W A w) = 0 := by
        rw [← hWK, h1, map_zero]
      exact hWinj w h2
    · right; exact h1
  have hICS : IsIntegrallyClosed S := by
    letI : Algebra (MvPolynomial (Fin 2) ↥W ⧸ Iq) S := @RingHom.toAlgebra _ S _ _ ψ
    have : Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸ Iq) S := RingHom.Etale.toAlgebra hψet
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    have : p.IsPrime := hpm.isPrime
    exact (wc_pks_etale_localization_normal (MvPolynomial (Fin 2) ↥W ⧸ Iq) S p).2
  have h1N : (1 : S) ∉ 𝔭₃ := fun h1 => hmax₃.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hPD₃ : wcLlsPD W S 𝔭₃ (.ann u₃ v₃ q) := by
    refine ⟨hFTWS, hNZS, hICS, hmax₃, le_sup_right, hq, hq0, V6, rfl, 1, h1N,
      (algebraMap S (Localization.Away (1 : S))).comp ψ, ?_, ?_, ?_, ?_⟩
    · rw [RingHom.comp_assoc, hψCc]
    · rw [RingHom.comp_apply, hψ0]
    · rw [RingHom.comp_apply, hψ1]
    · exact RingHom.Etale.stableUnderComposition _ _ hψet
        (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (1 : S)))

  have hsub : ∀ x : K, x ∈ Algebra.adjoin A {s} → x ∈ S := by
    intro x hx
    have hle' : Algebra.adjoin A {s} ≤ S.restrictScalars A := by
      apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff, SetLike.mem_coe, Subalgebra.mem_restrictScalars]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    exact (Subalgebra.mem_restrictScalars _).mp (hle' hx)
  let j : ↥(Algebra.adjoin A {s}) →+* S :=
    { toFun := fun y => ⟨y, hsub y y.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hrange : ∀ x : S, ∃ k : ℕ, algebraMap S K x * algebraMap A K h ^ k ∈
      Algebra.adjoin A {s} := by
    rintro ⟨x, hx0⟩
    show ∃ k : ℕ, x * algebraMap A K h ^ k ∈ _
    have hx : x ∈ Algebra.adjoin (Localization.Away h) {s} := hx0
    clear hx0
    have hH : ∀ l : ℕ, algebraMap A K h ^ l ∈ Algebra.adjoin A {s} :=
      fun l => Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ h) l
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨0, ?_⟩
      rw [pow_zero, mul_one, Set.mem_singleton_iff.mp hx]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap r =>
      obtain ⟨⟨a, m⟩, hr⟩ := IsLocalization.surj (Submonoid.powers h) r
      obtain ⟨n, hn⟩ := m.2
      have hn' : h ^ n = (m : A) := hn
      refine ⟨n, ?_⟩
      have e : algebraMap (Localization.Away h) K r * algebraMap A K h ^ n = algebraMap A K a := by
        rw [← map_pow, ← hBK, ← hBK, ← map_mul, hn']
        exact congrArg _ hr
      rw [e]
      exact Subalgebra.algebraMap_mem _ a
    | add x y _ _ ihx ihy =>
      obtain ⟨k, hk⟩ := ihx
      obtain ⟨l, hl⟩ := ihy
      refine ⟨k + l, ?_⟩
      have e : (x + y) * algebraMap A K h ^ (k + l) =
          x * algebraMap A K h ^ k * algebraMap A K h ^ l +
          y * algebraMap A K h ^ l * algebraMap A K h ^ k := by ring
      rw [e]
      exact add_mem (mul_mem hk (hH l)) (mul_mem hl (hH k))
    | mul x y _ _ ihx ihy =>
      obtain ⟨k, hk⟩ := ihx
      obtain ⟨l, hl⟩ := ihy
      refine ⟨k + l, ?_⟩
      have e : (x * y) * algebraMap A K h ^ (k + l) =
          (x * algebraMap A K h ^ k) * (y * algebraMap A K h ^ l) := by ring
      rw [e]
      exact mul_mem hk hl
  have hBrSub : wcLlsBrSub W A K S s {s, algebraMap A K v} := by
    refine ⟨hWK, ?_, ?_⟩
    · intro y hy
      exact ⟨j ⟨y, hy⟩, rfl⟩
    · rintro _ ⟨x, rfl⟩
      obtain ⟨k, hk⟩ := hrange x
      set hA : ↥(Algebra.adjoin A {s}) := algebraMap A ↥(Algebra.adjoin A {s}) h with hAdef
      refine ⟨⟨algebraMap S K x * algebraMap A K h ^ k, hk⟩, hA ^ k, ?_, ?_⟩
      · intro hqm
        have hle2 : Ideal.span (((↑) : ↥(Algebra.adjoin A {s}) → K) ⁻¹'
            ({s, algebraMap A K v} ∪ (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
              (IsLocalRing.maximalIdeal ↥W : Set ↥W))) ≤ 𝔭₃.comap j := by
          rw [Ideal.span_le]
          rintro y ((hy | hy) | ⟨w, hw, hwy⟩)
          · rw [SetLike.mem_coe, Ideal.mem_comap]
            have hjy : j y = u₃ := hinjS hy
            rw [hjy]; exact hu₃mem
          · rw [SetLike.mem_coe, Ideal.mem_comap]
            have hjy : j y = v₃ := hinjS ((Set.mem_singleton_iff.mp hy).trans hv₃K.symm)
            rw [hjy]; exact hv₃mem
          · rw [SetLike.mem_coe, Ideal.mem_comap]
            have hjy : j y = algebraMap ↥W S w := hinjS (hwy.symm.trans (hWK w).symm)
            rw [hjy]; exact hm₃ w hw
        have hmem : j (hA ^ k) ∈ 𝔭₃ := Ideal.mem_comap.mp (hle2 hqm)
        have hjA : j hA = φ h := hinjS (by rw [V1]; rfl)
        have hunitA : IsUnit (j hA) := by
          rw [hjA]
          exact (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away h) h).map
            (algebraMap (Localization.Away h) S)
        have hunit : IsUnit (j (hA ^ k)) := by
          rw [map_pow]; exact hunitA.pow k
        exact hmax₃.ne_top (Ideal.eq_top_of_isUnit_mem 𝔭₃ hmem hunit)
      · show algebraMap S K x * ((hA ^ k : ↥(Algebra.adjoin A {s})) : K) =
          algebraMap S K x * algebraMap A K h ^ k
        rw [SubmonoidClass.coe_pow]
        rfl

  haveI : IsScalarTower S K L := by
    first
    | infer_instance
    | exact IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hcentre : ∀ c ∈ wcLlsBrSet W S K L 𝔭₃ u₃, b₀ * c ∈ wcLlsBrSet W A K L 𝔭 u := by
    intro c hc
    have hcomap : 𝔭₃.comap φ ≤ 𝔭 :=
      le_of_eq (Ideal.IsMaximal.eq_of_le h𝔭max (Ideal.comap_ne_top φ hmax₃.ne_top) hle).symm
    have hL : ∀ a : A, algebraMap S L (φ a) = algebraMap A L a := by
      intro a
      rw [IsScalarTower.algebraMap_apply S K L, V1, ← IsScalarTower.algebraMap_apply A K L]
    have hLcomp : (algebraMap S L).comp φ = (RingHom.id L).comp (algebraMap A L) :=
      RingHom.ext hL
    let ι' : ↥(integralClosure A L) →+* ↥(integralClosure S L) :=
      { toFun := fun x => ⟨(x : L), IsIntegral.map_of_comp_eq φ (RingHom.id L) hLcomp x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hιval : ∀ x : ↥(integralClosure A L), ((ι' x : ↥(integralClosure S L)) : L) = (x : L) :=
      fun _ => rfl
    have key : ∀ a : A, ι' (algebraMap A ↥(integralClosure A L) a) =
        algebraMap S ↥(integralClosure S L) (φ a) := by
      intro a
      apply Subtype.ext
      rw [hιval]
      show algebraMap A L a = algebraMap S L (φ a)
      rw [hL]
    obtain ⟨hcm, Q, ⟨hQp, hQle, hQw⟩, hQt, σ', hg1', hg'⟩ := hc
    haveI := hQp
    have keymem : ∀ a : A, a ∈ (Q.comap ι').comap (algebraMap A ↥(integralClosure A L)) ↔
        φ a ∈ Q.comap (algebraMap S ↥(integralClosure S L)) := by
      intro a
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, key]
    refine ⟨Ideal.mul_mem_left _ b₀ hcm, Q.comap ι',
      ⟨Ideal.comap_isPrime ι' Q, ?_, ?_⟩, ?_, σ', hg1', ?_⟩
    · intro a ha
      exact hcomap (Ideal.mem_comap.mpr (hQle ((keymem a).mp ha)))
    · intro w hw0 hw
      apply hQw w hw0
      rw [← V2 w]
      exact (keymem _).mp hw
    · rw [keymem, V5 c, Ideal.mem_comap, map_mul]
      exact Ideal.mul_mem_left Q _ (Ideal.mem_comap.mp hQt)
    · intro x
      have hgx : IsIntegral A (σ' (x : L)) := by
        have := IsIntegral.map (σ'.toAlgHom.restrictScalars A) x.2
        simpa using this
      have hd : IsIntegral A (σ' (x : L) - (x : L)) := hgx.sub x.2
      obtain ⟨q', hq', hqeq⟩ := hg' (ι' x)
      refine ⟨⟨σ' (x : L) - (x : L), hd⟩, ?_, rfl⟩
      have hιq : ι' ⟨σ' (x : L) - (x : L), hd⟩ = q' := by
        apply Subtype.ext
        rw [hιval, hqeq, hιval]
      rw [Ideal.mem_comap, hιq]
      exact hq'

  exact ⟨S, inferInstance, inferInstance, algWS, inferInstance, inferInstance, inferInstance,
    inferInstance, u₃, v₃, 𝔭₃, hBrSub, rfl, hv₃K, hPD₃, hcentre⟩

theorem wcpa_dj_llsm_isicb_inner_pres : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    ∀ (N : Ideal ↥(wcIcxRI W A K u a' b)) [N.IsPrime], N = wcIcxNI W A K u a' b →
    IsDomain (Localization.AtPrime N) ∧ IsIntegrallyClosed (Localization.AtPrime N) ∧
    ∀ (P : Type u) [CommRing P] (e : Localization.AtPrime N →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal (Localization.AtPrime N)) P e →
      ∃ (β : ↥W) (f : wcEbntN W β →+* P),
        wcEbntPres W (e.comp ((algebraMap ↥(wcIcxRI W A K u a' b) (Localization.AtPrime N)).comp
          ((algebraMap A ↥(wcIcxRI W A K u a' b)).comp (algebraMap ↥W A)))) β f ∧
        f (wcEbntX W β 0) = e (algebraMap ↥(wcIcxRI W A K u a' b) (Localization.AtPrime N)
          ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_insert _ _)⟩) ∧
        f (wcEbntX W β 1) = e (algebraMap ↥(wcIcxRI W A K u a' b) (Localization.AtPrime N)
          ⟨wcLlsIsiS2 W A K u b,
            Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ 𝔭 u v g a' b hPD ha'm ha'0 hbm hb0 ha'b hnba hbg N hNP hN
  subst hN

  have s2 : ∀ (B : Type u) [CommRing B] [Algebra B K] (P : Ideal B) (G : Set K), P.IsMaximal →
      ∀ N J : Ideal ↥(Algebra.adjoin B G),
      (∀ y : ↥(Algebra.adjoin B G), (y : K) ∈ G → y ∈ N) →
      P ≤ N.comap (algebraMap B ↥(Algebra.adjoin B G)) → N ≤ J → J ≠ ⊤ → J = N := by
    intro B _ _ P G hP N J hG hPN hNJ hJ
    refine le_antisymm ?_ hNJ
    have nf : ∀ (x : K) (hx : x ∈ Algebra.adjoin B G), ∃ a : B,
        (⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ a ∈ N := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact ⟨0, by rw [map_zero, sub_zero]; exact hG ⟨x, Algebra.subset_adjoin hx⟩ hx⟩
      | algebraMap a =>
        refine ⟨a, ?_⟩
        have e : (⟨algebraMap B K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(Algebra.adjoin B G)) =
            algebraMap B _ a := rfl
        rw [e, sub_self]; exact N.zero_mem
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a + b, ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ (a + b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ a) +
            ((⟨y, hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ b) := by
          show ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) + ⟨y, hy⟩) - algebraMap B _ (a + b) = _
          rw [map_add]; ring
        rw [e]; exact add_mem ha hb
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a * b, ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ (a * b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ a) * ⟨y, hy⟩ +
            algebraMap B _ a * ((⟨y, hy⟩ : ↥(Algebra.adjoin B G)) - algebraMap B _ b) := by
          show ((⟨x, hx⟩ : ↥(Algebra.adjoin B G)) * ⟨y, hy⟩) - algebraMap B _ (a * b) = _
          rw [map_mul]; ring
        rw [e]; exact add_mem (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hb)
    intro x hxJ
    obtain ⟨a, ha⟩ := nf x.1 x.2
    have hxa : x - algebraMap B _ a ∈ N := ha
    have haJ : algebraMap B ↥(Algebra.adjoin B G) a ∈ J := by
      have e : algebraMap B ↥(Algebra.adjoin B G) a = x - (x - algebraMap B _ a) := by ring
      rw [e]; exact sub_mem hxJ (hNJ hxa)
    by_cases hc : a ∈ P
    · have e : x = (x - algebraMap B _ a) + algebraMap B _ a := by ring
      rw [e]; exact add_mem hxa (hPN hc)
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hP.exists_inv hc
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(Algebra.adjoin B G)) =
          algebraMap B _ β * algebraMap B _ a + algebraMap B _ i := by
        rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hPN hi))

  have s3 : ∀ (B : Type u) [CommRing B] [Algebra B K] (s : K) (T : Subalgebra A K)
      (M : Submonoid K), (∀ k ∈ M, k ∈ T) → (∃ k ∈ M, k * s ∈ T) →
      (∀ a : B, ∃ k ∈ M, k * algebraMap B K a ∈ T) →
      ∀ r ∈ Algebra.adjoin B {s}, ∃ k ∈ M, k * r ∈ T := by
    intro B _ _ s T M hMT hs ha r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact hs
    | algebraMap a => exact ha a
    | add x y _ _ hx hy =>
      obtain ⟨k₁, hk₁, h₁⟩ := hx
      obtain ⟨k₂, hk₂, h₂⟩ := hy
      refine ⟨k₁ * k₂, mul_mem hk₁ hk₂, ?_⟩
      have e : k₁ * k₂ * (x + y) = k₂ * (k₁ * x) + k₁ * (k₂ * y) := by ring
      rw [e]
      exact add_mem (mul_mem (hMT _ hk₂) h₁) (mul_mem (hMT _ hk₁) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨k₁, hk₁, h₁⟩ := hx
      obtain ⟨k₂, hk₂, h₂⟩ := hy
      refine ⟨k₁ * k₂, mul_mem hk₁ hk₂, ?_⟩
      have e : k₁ * k₂ * (x * y) = (k₁ * x) * (k₂ * y) := by ring
      rw [e]
      exact mul_mem h₁ h₂

  have s5 : ∀ (C C'' : Type u) [CommRing C] [CommRing C''] (i : C →+* K) (i'' : C'' →+* K)
      (j : C →+* C''), Function.Injective i → i''.comp j = i →
      ∀ Q : Ideal C, Q.IsPrime → (∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y) →
      ∃ Q'' : Ideal C'', Q''.IsPrime ∧ Q''.comap j = Q := by
    intro C C'' _ _ i i'' j hi hij Q hQ H
    have hij' : ∀ x, i'' (j x) = i x := fun x => RingHom.congr_fun hij x
    have hdd : ∀ d d' : C, d ∉ Q → d' ∉ Q → d * d' ∉ Q :=
      fun d d' hd hd' h => (hQ.mem_or_mem h).elim hd hd'
    have h1Q : (1 : C) ∉ Q := fun h => hQ.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have indep : ∀ (y : C'') (d x d' x' : C), d ∉ Q → d' ∉ Q → i x = i d * i'' y →
        i x' = i d' * i'' y → x' ∈ Q → x ∈ Q := by
      intro y d x d' x' hd hd' h1 h2 hx'
      have e : d' * x = d * x' := hi (by rw [map_mul, map_mul, h1, h2]; ring)
      have h3 : d' * x ∈ Q := by rw [e]; exact Q.mul_mem_left _ hx'
      exact (hQ.mem_or_mem h3).resolve_left hd'
    let Q'' : Ideal C'' :=
      { carrier := {y | ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q}
        add_mem' := by
          rintro a b ⟨d₁, x₁, hd₁, h1, hx₁⟩ ⟨d₂, x₂, hd₂, h2, hx₂⟩
          refine ⟨d₁ * d₂, x₁ * d₂ + x₂ * d₁, hdd _ _ hd₁ hd₂, ?_,
            add_mem (Q.mul_mem_right _ hx₁) (Q.mul_mem_right _ hx₂)⟩
          rw [map_add, map_mul, map_mul, map_mul, map_add, h1, h2]; ring
        zero_mem' := ⟨1, 0, h1Q, by simp, Q.zero_mem⟩
        smul_mem' := by
          rintro c b ⟨d₁, x₁, hd₁, h1, hx₁⟩
          obtain ⟨dc, xc, hdc, hc⟩ := H c
          refine ⟨dc * d₁, xc * x₁, hdd _ _ hdc hd₁, ?_, Q.mul_mem_left _ hx₁⟩
          rw [smul_eq_mul, map_mul, map_mul, map_mul, hc, h1]; ring }
    have memQ : ∀ y, y ∈ Q'' ↔ ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y ∧ x ∈ Q :=
      fun y => Iff.rfl
    refine ⟨Q'', ⟨?_, ?_⟩, ?_⟩
    · rw [Ne, Ideal.eq_top_iff_one, memQ]
      rintro ⟨d, x, hd, h, hx⟩
      have : x = d := hi (by rw [h, map_one, mul_one])
      exact hd (this ▸ hx)
    · intro a b hab
      obtain ⟨d, x, hd, h, hx⟩ := (memQ _).mp hab
      obtain ⟨d₁, x₁, hd₁, h1⟩ := H a
      obtain ⟨d₂, x₂, hd₂, h2⟩ := H b
      have h12 : i (x₁ * x₂) = i (d₁ * d₂) * i'' (a * b) := by
        rw [map_mul, map_mul, map_mul, h1, h2]; ring
      have hx12 := indep _ _ _ _ _ (hdd _ _ hd₁ hd₂) hd h12 h hx
      rcases hQ.mem_or_mem hx12 with h' | h'
      · exact Or.inl ((memQ _).mpr ⟨d₁, x₁, hd₁, h1, h'⟩)
      · exact Or.inr ((memQ _).mpr ⟨d₂, x₂, hd₂, h2, h'⟩)
    · ext x
      rw [Ideal.mem_comap, memQ]
      constructor
      · rintro ⟨d, x', hd, h, hx'⟩
        have e : x' = d * x := hi (by rw [h, hij', map_mul])
        rw [e] at hx'
        exact (hQ.mem_or_mem hx').resolve_left hd
      · intro hx
        exact ⟨1, x, h1Q, by rw [hij', map_one, one_mul], hx⟩

  have s6 : ∀ (C C'' : Type u) [CommRing C] [IsDomain C] [CommRing C''] [IsDomain C'']
      (i : C →+* K) (i'' : C'' →+* K) (j : C →+* C''),
      Function.Injective i → Function.Injective i'' → i''.comp j = i →
      ∀ (Q : Ideal C) [Q.IsPrime] (Q'' : Ideal C'') [Q''.IsPrime], Q''.comap j = Q →
      (∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y) →
      ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'',
        ∀ (x : C) (y : C''), i x = i'' y →
          e (algebraMap C (Localization.AtPrime Q) x) =
            algebraMap C'' (Localization.AtPrime Q'') y := by
    intro C C'' _ _ _ _ i i'' j hi hi'' hij Q hQ Q'' hQ'' hQQ H
    have hij' : ∀ x, i'' (j x) = i x := fun x => RingHom.congr_fun hij x
    have hne : ∀ d : C, d ∉ Q → i d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi (by rw [h0, map_zero])
      rw [this]; exact Q.zero_mem
    have hne'' : ∀ d : C'', d ∉ Q'' → i'' d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi'' (by rw [h0, map_zero])
      rw [this]; exact Q''.zero_mem
    have hjQ : ∀ d : C, d ∉ Q → j d ∉ Q'' := by
      intro d hd h
      apply hd
      rw [← hQQ]
      exact h
    have hu : ∀ d : Q.primeCompl, IsUnit (i d) := fun d => isUnit_iff_ne_zero.mpr (hne d d.2)
    have hu'' : ∀ d : Q''.primeCompl, IsUnit (i'' d) :=
      fun d => isUnit_iff_ne_zero.mpr (hne'' d d.2)
    obtain ⟨ι, hιa, hιm, hinj⟩ : ∃ ι : Localization.AtPrime Q →+* K,
        (∀ x, ι (algebraMap C _ x) = i x) ∧
        (∀ x (d : Q.primeCompl), i x = i d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) hu,
        IsLocalization.lift_eq hu, fun x d => (IsLocalization.lift_mk'_spec hu x _ d).mp rfl, ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i (IsLocalization.injective (Localization.AtPrime Q)
          (Ideal.primeCompl_le_nonZeroDivisors Q) h)
      · intro h; rw [hi h]
    obtain ⟨ι'', hιa'', hιm'', hinj''⟩ : ∃ ι : Localization.AtPrime Q'' →+* K,
        (∀ x, ι (algebraMap C'' _ x) = i'' x) ∧
        (∀ x (d : Q''.primeCompl), i'' x = i'' d * ι (IsLocalization.mk' _ x d)) ∧
        Function.Injective ι := by
      refine ⟨IsLocalization.lift (M := Q''.primeCompl) (S := Localization.AtPrime Q'') hu'',
        IsLocalization.lift_eq hu'', fun x d => (IsLocalization.lift_mk'_spec hu'' x _ d).mp rfl,
        ?_⟩
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h
        exact congrArg i'' (IsLocalization.injective (Localization.AtPrime Q'')
          (Ideal.primeCompl_le_nonZeroDivisors Q'') h)
      · intro h; rw [hi'' h]
    have hrange : ι.range = ι''.range := by
      apply le_antisymm
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨x, d⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q'') (j x)
          (⟨j d, hjQ d d.2⟩ : Q''.primeCompl), ?_⟩
        have hv := hιm x d
        have hv'' := hιm'' (j x) (⟨j d, hjQ d d.2⟩ : Q''.primeCompl)
        simp only [hij'] at hv''
        apply mul_left_cancel₀ (hne d d.2)
        rw [← hv, ← hv'']
      · rintro _ ⟨z, rfl⟩
        obtain ⟨⟨y, d''⟩, rfl⟩ := IsLocalization.mk'_surjective Q''.primeCompl z
        obtain ⟨d₁, x₁, hd₁, h1⟩ := H y
        obtain ⟨d₂, x₂, hd₂, h2⟩ := H d''
        have hx₂ : x₂ ∉ Q := by
          intro hx
          have e : j x₂ = j d₂ * d'' := hi'' (by rw [hij', map_mul, hij', h2])
          have : j d₂ * d'' ∈ Q'' := by rw [← e, ← Ideal.mem_comap, hQQ]; exact hx
          rcases hQ''.mem_or_mem this with h | h
          · exact hjQ d₂ hd₂ h
          · exact d''.2 h
        have hD : d₁ * x₂ ∈ Q.primeCompl := by
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact hd₁ h
          · exact hx₂ h
        refine ⟨IsLocalization.mk' (Localization.AtPrime Q) (x₁ * d₂) (⟨_, hD⟩ : Q.primeCompl), ?_⟩
        have hA := hιm (x₁ * d₂) (⟨_, hD⟩ : Q.primeCompl)
        have hB := hιm'' y d''
        simp only [map_mul] at hA
        have hX : i d₁ * i d₂ * i'' d'' ≠ 0 :=
          mul_ne_zero (mul_ne_zero (hne d₁ hd₁) (hne d₂ hd₂)) (hne'' d'' d''.2)
        apply mul_left_cancel₀ hX
        linear_combination (-1 : K) * hA + i d₂ * h1 -
          i d₁ * ι (IsLocalization.mk' (Localization.AtPrime Q) (x₁ * d₂)
            (⟨_, hD⟩ : Q.primeCompl)) * h2 +
          i d₁ * i d₂ * hB
    let e1 : Localization.AtPrime Q ≃+* ι.range :=
      RingEquiv.ofBijective ι.rangeRestrict
        ⟨fun a b h => hinj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι⟩
    let e2 : Localization.AtPrime Q'' ≃+* ι''.range :=
      RingEquiv.ofBijective ι''.rangeRestrict
        ⟨fun a b h => hinj'' (congrArg Subtype.val h), RingHom.rangeRestrict_surjective ι''⟩
    let e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'' :=
      e1.trans ((RingEquiv.subringCongr hrange).trans e2.symm)
    have hιe : ∀ z, ι'' (e z) = ι z := by
      intro z
      have := congrArg Subtype.val (e2.apply_symm_apply ((RingEquiv.subringCongr hrange) (e1 z)))
      exact this
    refine ⟨e, fun x y hxy => hinj'' ?_⟩
    rw [hιe, hιa, hιa'']
    exact hxy

  have c4 : ∀ (R R' P : Type u) [CommRing R] [IsLocalRing R] [CommRing R'] [IsLocalRing R']
      [CommRing P] (E : R ≃+* R') (e : R →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal R) P e →
      wcNdIsHens (IsLocalRing.maximalIdeal R') P (e.comp (E.symm : R' →+* R)) := by
    intro R R' P _ _ _ _ _ E e he
    unfold wcNdIsHens at he ⊢
    obtain ⟨hH, hU, hUP⟩ := he
    have key : ∀ x : R, E x ∉ IsLocalRing.maximalIdeal R' ↔ x ∉ IsLocalRing.maximalIdeal R := by
      intro x
      rw [IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal, MulEquiv.isUnit_map]
    have key' : ∀ x : R', E.symm x ∉ IsLocalRing.maximalIdeal R ↔
        x ∉ IsLocalRing.maximalIdeal R' := by
      intro x
      rw [IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal, MulEquiv.isUnit_map]
    refine ⟨hH, fun a => (hU _).trans (key' a), ?_⟩
    intro B _ hB g' hg'
    have hg : ∀ x, IsUnit ((g'.comp (E : R →+* R')) x) ↔ x ∉ IsLocalRing.maximalIdeal R :=
      fun x => (hg' (E x)).trans (key x)
    obtain ⟨hh, ⟨hhc, hhl⟩, huniq⟩ := hUP B hB (g'.comp (E : R →+* R')) hg
    refine ⟨hh, ⟨?_, hhl⟩, ?_⟩
    · apply RingHom.ext
      intro a
      have := RingHom.congr_fun hhc (E.symm a)
      calc hh (e (E.symm a)) = g' (E (E.symm a)) := this
        _ = g' a := by rw [RingEquiv.apply_symm_apply]
    · rintro h' ⟨hc', hl'⟩
      apply huniq h'
      refine ⟨?_, hl'⟩
      apply RingHom.ext
      intro x
      have := RingHom.congr_fun hc' (E x)
      calc h' (e x) = h' (e (E.symm (E x))) := by rw [RingEquiv.symm_apply_apply]
        _ = g' (E x) := this

  obtain ⟨ε, hε⟩ := ha'b
  obtain ⟨c, hc⟩ := hbg
  have hεm : ε ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hεu
    apply hnba
    obtain ⟨ε', hε'⟩ := (IsLocalRing.notMem_maximalIdeal.mp hεu).exists_right_inv
    exact ⟨ε', by rw [hε, mul_assoc, hε', mul_one]⟩
  have hε0 : ε ≠ 0 := by
    rintro rfl
    exact hb0 (by rw [hε, mul_zero])
  have hqm : ε * c ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right _ _ hεm
  have hgq : g = a' * (ε * c) := by rw [hc, hε, mul_assoc]

  obtain ⟨A₃, _, _, _, iK, _, iL, iT, u₃, v₃, 𝔭₃, hBr, hu₃, hv₃, hPD₃, -⟩ :=
    wcpa_dj_llsm_br_inner_chart Ω W hW hWt A K K 𝔭 u v g a' (ε * c) hPD ha'm ha'0 hqm hgq
  clear iT iL
  obtain ⟨_, hNZ, _, hmax, _, _, hg0, huv, h𝔭, _⟩ := hPD
  obtain ⟨BS1, BS2, BS3⟩ := hBr
  haveI := hNZ

  have hinjA : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hWne : ∀ x : ↥W, x ≠ 0 → algebraMap A K (algebraMap ↥W A x) ≠ 0 := by
    intro x hx h
    have h1 : algebraMap ↥W A x = 0 := hinjA (by rw [h, map_zero])
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hx h2
    · exact one_ne_zero h2
  have hA0 := hWne a' ha'0
  have hG0 := hWne g hg0
  have hUV : algebraMap A K u * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
    rw [← map_mul, huv]
  have hU0 : algebraMap A K u ≠ 0 := by
    intro h; apply hG0; rw [← hUV, h, zero_mul]
  have hF2 : algebraMap A₃ K (algebraMap ↥W A₃ ε) / algebraMap A₃ K u₃ =
      wcLlsIsiS2 W A K u b := by
    rw [BS1, hu₃]
    unfold wcLlsIsiS2
    rw [hε, map_mul, map_mul, div_div_eq_mul_div, mul_comm (algebraMap A K (algebraMap ↥W A ε))]
  have hF3 : algebraMap A K u = algebraMap A K (algebraMap ↥W A a') * wcLlsIsiS1 W A K u a' := by
    unfold wcLlsIsiS1
    rw [mul_comm, div_mul_cancel₀ _ hA0]
  have hF4 : algebraMap A K v = algebraMap A K (algebraMap ↥W A c) * wcLlsIsiS2 W A K u b := by
    unfold wcLlsIsiS2
    rw [mul_div_assoc', eq_div_iff hU0]
    have hgbc : algebraMap A K (algebraMap ↥W A g) =
        algebraMap A K (algebraMap ↥W A b) * algebraMap A K (algebraMap ↥W A c) := by
      rw [hc, map_mul, map_mul]
    linear_combination hUV + hgbc
  have hX : algebraMap A K u / algebraMap A K (algebraMap ↥W A a') = wcLlsIsiS1 W A K u a' := rfl
  rw [hX] at BS2 BS3 hu₃

  have hS₁R : wcLlsIsiS1 W A K u a' ∈ wcIcxRI W A K u a' b :=
    Algebra.subset_adjoin (Set.mem_insert _ _)
  have hS₂R : wcLlsIsiS2 W A K u b ∈ wcIcxRI W A K u a' b :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hS₂R₃ : wcLlsIsiS2 W A K u b ∈ Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b} :=
    Algebra.subset_adjoin (Set.mem_singleton _)
  have hRR : ∀ x ∈ wcIcxRI W A K u a' b, x ∈ Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b} := by
    intro x hx
    change x ∈ Algebra.adjoin A {wcLlsIsiS1 W A K u a', wcLlsIsiS2 W A K u b} at hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with hx | hx
      · rw [hx, ← hu₃]; exact Subalgebra.algebraMap_mem _ u₃
      · rw [Set.mem_singleton_iff] at hx; rw [hx]; exact hS₂R₃
    | algebraMap a =>
      obtain ⟨a₃, ha₃⟩ := BS2 (Subalgebra.algebraMap_mem (Algebra.adjoin A {wcLlsIsiS1 W A K u a'}) a)
      rw [← ha₃]; exact Subalgebra.algebraMap_mem _ a₃
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy
  let i : ↥(wcIcxRI W A K u a' b) →+* K := (wcIcxRI W A K u a' b).val.toRingHom
  let i₃ : ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}) →+* K :=
    (Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}).val.toRingHom
  let j : ↥(wcIcxRI W A K u a' b) →+* ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}) :=
    { toFun := fun x => ⟨x.1, hRR x.1 x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hi : Function.Injective i := Subtype.val_injective
  have hi₃ : Function.Injective i₃ := Subtype.val_injective
  have hij : i₃.comp j = i := RingHom.ext fun _ => rfl

  have hS₁N : (⟨wcLlsIsiS1 W A K u a', hS₁R⟩ : ↥(wcIcxRI W A K u a' b)) ∈
      wcIcxNI W A K u a' b := by
    rw [wcIcxNI]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hS₂N : (⟨wcLlsIsiS2 W A K u b, hS₂R⟩ : ↥(wcIcxRI W A K u a' b)) ∈
      wcIcxNI W A K u a' b := by
    rw [wcIcxNI]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have hmN : ∀ x ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A x) ∈ wcIcxNI W A K u a' b := by
    intro x hx
    rw [wcIcxNI]
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
      ((algebraMap A ↥(wcIcxRI W A K u a' b)).comp (algebraMap ↥W A)) hx)

  have hι₀ : ∀ x ∈ Algebra.adjoin A {wcLlsIsiS1 W A K u a'}, x ∈ wcIcxRI W A K u a' b :=
    fun x hx => Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) hx
  let ι₀ : ↥(Algebra.adjoin A {wcLlsIsiS1 W A K u a'}) →+* ↥(wcIcxRI W A K u a' b) :=
    { toFun := fun d => ⟨d.1, hι₀ d.1 d.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hJ0 : (wcIcxNI W A K u a' b).comap ι₀ =
      Ideal.span (((↑) : ↥(Algebra.adjoin A {wcLlsIsiS1 W A K u a'}) → K) ⁻¹'
        (({wcLlsIsiS1 W A K u a', algebraMap A K v} : Set K) ∪
          (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W))) := by
    have hS₁J : (⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
        ↥(Algebra.adjoin A {wcLlsIsiS1 W A K u a'})) ∈
        Ideal.span (((↑) : ↥(Algebra.adjoin A {wcLlsIsiS1 W A K u a'}) → K) ⁻¹'
        (({wcLlsIsiS1 W A K u a', algebraMap A K v} : Set K) ∪
          (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W))) :=
      Ideal.subset_span (Set.mem_union_left _ (Set.mem_insert _ _))
    refine s2 A 𝔭 {wcLlsIsiS1 W A K u a'} hmax _ _ ?_ ?_ ?_ ?_
    · intro y hy
      have e : y = ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :=
        Subtype.ext (Set.mem_singleton_iff.mp hy)
      rw [e]; exact hS₁J
    · rw [h𝔭]
      apply sup_le
      · rw [Ideal.span_le]
        intro a ha
        rw [SetLike.mem_coe, Ideal.mem_comap]
        rcases ha with ha | ha
        · rw [ha]
          have e : algebraMap A ↥(Algebra.adjoin A {wcLlsIsiS1 W A K u a'}) u =
              algebraMap A _ (algebraMap ↥W A a') *
                ⟨wcLlsIsiS1 W A K u a', Algebra.subset_adjoin (Set.mem_singleton _)⟩ :=
            Subtype.ext hF3
          rw [e]; exact Ideal.mul_mem_left _ _ hS₁J
        · rw [Set.mem_singleton_iff] at ha
          rw [ha]
          exact Ideal.subset_span (Set.mem_union_left _ (Set.mem_insert_of_mem _ rfl))
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.subset_span (Set.mem_union_right _ ⟨x, hx, rfl⟩)
    · rw [Ideal.span_le]
      intro y hy
      rw [SetLike.mem_coe, Ideal.mem_comap]
      rcases hy with (hy | hy) | ⟨x, hx, hxy⟩
      · have e : ι₀ y = ⟨wcLlsIsiS1 W A K u a', hS₁R⟩ := Subtype.ext hy
        rw [e]; exact hS₁N
      · have e : ι₀ y = algebraMap A _ (algebraMap ↥W A c) * ⟨wcLlsIsiS2 W A K u b, hS₂R⟩ :=
          Subtype.ext ((Set.mem_singleton_iff.mp hy).trans hF4)
        rw [e]; exact Ideal.mul_mem_left _ _ hS₂N
      · have e : ι₀ y = algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A x) :=
          Subtype.ext hxy.symm
        rw [e]; exact hmN x hx
    · exact Ideal.comap_ne_top _ hNP.ne_top
  have hDen : ∀ y : ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}), ∃ d x : ↥(wcIcxRI W A K u a' b),
      d ∉ wcIcxNI W A K u a' b ∧ i x = i d * i₃ y := by
    intro y
    obtain ⟨k, hkM, hk⟩ := s3 A₃ (wcLlsIsiS2 W A K u b) (wcIcxRI W A K u a' b)
      ((wcIcxNI W A K u a' b).primeCompl.map (wcIcxRI W A K u a' b).val.toRingHom.toMonoidHom)
      (fun k hk => by
        obtain ⟨r, _, rfl⟩ := Submonoid.mem_map.mp hk
        exact r.2)
      ⟨1, Submonoid.one_mem _, by rw [one_mul]; exact hS₂R⟩
      (fun a₃ => by
        obtain ⟨p, d, hd, hpd⟩ := BS3 (algebraMap A₃ K a₃) ⟨a₃, rfl⟩
        have hd' : ι₀ d ∉ wcIcxNI W A K u a' b := by
          intro h
          apply hd
          rw [← hJ0]
          exact h
        refine ⟨(d : K), Submonoid.mem_map.mpr ⟨ι₀ d, Ideal.mem_primeCompl_iff.mpr hd', rfl⟩, ?_⟩
        rw [mul_comm, hpd]
        exact hι₀ _ p.2)
      y.1 y.2
    obtain ⟨r, hr, rfl⟩ := Submonoid.mem_map.mp hkM
    exact ⟨r, ⟨_, hk⟩, Ideal.mem_primeCompl_iff.mp hr, rfl⟩

  obtain ⟨P₃, hP₃prime, hP₃⟩ := s5 _ _ i i₃ j hi hij _ hNP hDen
  have hP₃' : ∀ z, z ∈ wcIcxNI W A K u a' b → j z ∈ P₃ := by
    intro z hz
    rw [← hP₃] at hz
    exact hz
  obtain ⟨N₃, hN₃⟩ : ∃ N₃ : Ideal ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}),
      N₃ = Ideal.span {algebraMap A₃ ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}) u₃,
        ⟨wcLlsIsiS2 W A K u b, Algebra.subset_adjoin (Set.mem_singleton (wcLlsIsiS2 W A K u b))⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A₃ ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b})).comp (algebraMap ↥W A₃)) :=
    ⟨_, rfl⟩
  have hle : N₃ ≤ P₃ := by
    rw [hN₃]
    apply sup_le
    · rw [Ideal.span_le]
      intro y hy
      rcases hy with hy | hy
      · rw [hy]
        have e1 : algebraMap A₃ ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}) u₃ =
            j ⟨wcLlsIsiS1 W A K u a', hS₁R⟩ := Subtype.ext hu₃
        rw [e1]; exact hP₃' _ hS₁N
      · rw [Set.mem_singleton_iff] at hy
        rw [hy]
        exact hP₃' _ hS₂N
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap]
      have e1 : ((algebraMap A₃ ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b})).comp
          (algebraMap ↥W A₃)) x = j (algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A x)) :=
        Subtype.ext (BS1 x)
      rw [e1]; exact hP₃' _ (hmN x hx)
  have hN₃ne : N₃ ≠ ⊤ := by
    intro h
    rw [h] at hle
    exact hP₃prime.ne_top (top_le_iff.mp hle)
  have hN₃max : N₃.IsMaximal := by
    rw [hN₃]
    refine wcpa_dj_llsm_brrm_node_max Ω W hW hWt A₃ K 𝔭₃ (.ann u₃ v₃ (ε * c)) u₃ ε hPD₃
      (Or.inr ⟨v₃, ε * c, rfl, ⟨c, rfl⟩⟩) hεm hε0 _ hF2.symm ?_
    rw [← hN₃]; exact hN₃ne
  haveI := hN₃max
  have hN₃P : N₃ = P₃ := Ideal.IsMaximal.eq_of_le hN₃max hP₃prime.ne_top hle
  have hN₃c : N₃.comap j = wcIcxNI W A K u a' b := by rw [hN₃P]; exact hP₃

  obtain ⟨E, hE⟩ := s6 _ _ i i₃ j hi hi₃ hij (wcIcxNI W A K u a' b) N₃ hN₃c hDen
  have hEs : ∀ (x : ↥(wcIcxRI W A K u a' b)) (y : ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b})),
      (x : K) = (y : K) →
      E.symm (algebraMap _ (Localization.AtPrime N₃) y) =
        algebraMap _ (Localization.AtPrime (wcIcxNI W A K u a' b)) x :=
    fun x y hxy => (RingEquiv.symm_apply_eq E).mpr (hE x y hxy).symm

  obtain ⟨_, hic₃, hpres₃⟩ := wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A₃ K 𝔭₃
    (.ann u₃ v₃ (ε * c)) u₃ ε hPD₃ (Or.inr ⟨v₃, ε * c, rfl, ⟨c, rfl⟩⟩) hεm hε0 _ hF2.symm N₃ hN₃
  refine ⟨inferInstance, ?_, ?_⟩
  · haveI := hic₃
    exact IsIntegrallyClosed.of_equiv E.symm
  · intro P _ e he
    have he' := c4 _ _ P E e he
    obtain ⟨f, hf, hf0, hf1⟩ := hpres₃ P (e.comp (E.symm : _ →+* _)) he'
    refine ⟨ε, f, ?_, ?_, ?_⟩
    · have hσ : (e.comp (E.symm : _ →+* _)).comp
          ((algebraMap ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}) (Localization.AtPrime N₃)).comp
            ((algebraMap A₃ ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b})).comp
              (algebraMap ↥W A₃))) =
          e.comp ((algebraMap ↥(wcIcxRI W A K u a' b)
            (Localization.AtPrime (wcIcxNI W A K u a' b))).comp
            ((algebraMap A ↥(wcIcxRI W A K u a' b)).comp (algebraMap ↥W A))) := by
        apply RingHom.ext
        intro w
        exact congrArg e (hEs (algebraMap A ↥(wcIcxRI W A K u a' b) (algebraMap ↥W A w))
          (algebraMap A₃ ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}) (algebraMap ↥W A₃ w))
          (BS1 w).symm)
      rw [hσ] at hf
      exact hf
    · rw [hf0]
      exact congrArg e (hEs ⟨wcLlsIsiS1 W A K u a', _⟩
        (algebraMap A₃ ↥(Algebra.adjoin A₃ {wcLlsIsiS2 W A K u b}) u₃) hu₃.symm)
    · rw [hf1]
      exact congrArg e (hEs ⟨wcLlsIsiS2 W A K u b, _⟩
        ⟨wcLlsIsiS2 W A K u b, Algebra.subset_adjoin (Set.mem_singleton _)⟩ rfl)

theorem wcpa_dj_llsm_isicb_norm_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (E : Type u) [Field E] [Algebra K E] [FiniteDimensional K E],
    Algebra.FiniteType ↥W A → NoZeroSMulDivisors ↥W A →
    ∀ (D : Subalgebra A K), D.FG → Module.Finite ↥D ↥(integralClosure ↥D E) :=
by
  intro Ω _ _ W hW A _ _ _ K _ _ _ E _ _ _ hAft hAnz D hFG
  classical

  have hWA : Function.Injective (algebraMap W A) := by
    intro x y hxy
    rw [← sub_eq_zero]
    have h : (x - y) • (1 : A) = 0 := by
      rw [Algebra.smul_def, map_sub, hxy, sub_self, zero_mul]
    rcases smul_eq_zero.mp h with h | h
    · exact h
    · exact absurd h one_ne_zero
  obtain ⟨ι₀, hι₀⟩ : ∃ ι₀ : W →+* K, ι₀ = (algebraMap A K).comp (algebraMap W A) := ⟨_, rfl⟩
  have hι₀inj : Function.Injective ι₀ := by
    rw [hι₀]; exact (IsFractionRing.injective A K).comp hWA

  let φ : Ω →+* K := IsFractionRing.lift (K := Ω) hι₀inj
  have hφ : ∀ c : W, φ (c : Ω) = ι₀ c := fun c => IsFractionRing.lift_algebraMap hι₀inj c
  letI : Algebra Ω K := φ.toAlgebra
  letI : Algebra Ω E := ((algebraMap K E).comp φ).toAlgebra
  haveI : IsScalarTower Ω K E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI : Algebra W D := ((algebraMap A D).comp (algebraMap W A)).toAlgebra
  haveI : IsScalarTower W A D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hfc : ∀ c : W, algebraMap D K (algebraMap W D c) = ι₀ c := fun c => by
    rw [hι₀]; rfl
  have hfcΩ : ∀ c : W, algebraMap D K (algebraMap W D c) = algebraMap Ω K (c : Ω) := fun c => by
    rw [hfc]; exact (hφ c).symm

  have hDft : Algebra.FiniteType A D := (Subalgebra.fg_iff_finiteType D).mp hFG
  have hWD : Algebra.FiniteType W D := Algebra.FiniteType.trans hAft hDft

  obtain ⟨G, hG⟩ := hWD.out
  obtain ⟨T, hT⟩ : ∃ T : Subalgebra Ω K, T = Algebra.adjoin Ω (Set.range (algebraMap D K)) :=
    ⟨_, rfl⟩
  have hTeq : T = Algebra.adjoin Ω ((G.image (algebraMap D K) : Finset K) : Set K) := by
    apply le_antisymm
    · rw [hT, Algebra.adjoin_le_iff]
      rintro _ ⟨r, rfl⟩
      have hr : r ∈ Algebra.adjoin W (G : Set D) := by rw [hG]; trivial
      induction hr using Algebra.adjoin_induction with
      | mem x hx =>
        exact Algebra.subset_adjoin (Finset.mem_coe.mpr
          (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx)))
      | algebraMap c =>
        rw [hfcΩ]
        exact Subalgebra.algebraMap_mem _ _
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
    · rw [hT]
      apply Algebra.adjoin_mono
      intro x hx
      rw [Finset.coe_image] at hx
      obtain ⟨r, _, rfl⟩ := hx
      exact ⟨r, rfl⟩
  have hTft : Algebra.FiniteType Ω T := (Subalgebra.fg_iff_finiteType T).mp ⟨_, hTeq.symm⟩

  have hden : ∀ x ∈ T, ∃ c : W, c ≠ 0 ∧ ι₀ c * x ∈ Set.range (algebraMap D K) := by
    intro x hx
    rw [hT] at hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨r, rfl⟩ := hx
      exact ⟨1, one_ne_zero, r, by rw [map_one, one_mul]⟩
    | algebraMap ω =>
      by_cases hω : ω ∈ W
      · refine ⟨1, one_ne_zero, algebraMap W D ⟨ω, hω⟩, ?_⟩
        rw [map_one, one_mul, hfcΩ]
      · have hω0 : ω ≠ 0 := fun h => hω (h ▸ W.zero_mem)
        have hinv : ω⁻¹ ∈ W := (W.mem_or_inv_mem ω).resolve_left hω
        refine ⟨⟨ω⁻¹, hinv⟩, fun h => inv_ne_zero hω0 (congrArg Subtype.val h), 1, ?_⟩
        rw [map_one, ← hφ]
        show (1 : K) = φ ω⁻¹ * φ ω
        rw [← map_mul, inv_mul_cancel₀ hω0, map_one]
    | add x y _ _ hx hy =>
      obtain ⟨c₁, hc₁, r₁, hr₁⟩ := hx
      obtain ⟨c₂, hc₂, r₂, hr₂⟩ := hy
      refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, algebraMap W D c₂ * r₁ + algebraMap W D c₁ * r₂, ?_⟩
      rw [map_add, map_mul, map_mul, hr₁, hr₂, hfc, hfc, map_mul]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨c₁, hc₁, r₁, hr₁⟩ := hx
      obtain ⟨c₂, hc₂, r₂, hr₂⟩ := hy
      refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, r₁ * r₂, ?_⟩
      rw [map_mul, hr₁, hr₂, map_mul]
      ring

  haveI : FaithfulSMul T K :=
    (faithfulSMul_iff_algebraMap_injective T K).mpr Subtype.val_injective
  have hfT : ∀ a : A, algebraMap A K a ∈ T := fun a => by
    rw [hT]; exact Algebra.subset_adjoin ⟨algebraMap A D a, rfl⟩
  haveI hTfrac : IsFractionRing T K := IsFractionRing.of_field T K (fun z => by
    obtain ⟨x, y, _, hxy⟩ := IsFractionRing.div_surjective (A := A) z
    exact ⟨⟨_, hfT x⟩, ⟨_, hfT y⟩, hxy.symm⟩)

  haveI := hTft
  have hNfin : Module.Finite T (integralClosure T E) :=
    wc_sf_integralClosure_finite_of_embedding Ω T K E E (AlgHom.id T E) (fun _ _ h => h)
      noether_integralClosure_finite
  obtain ⟨N, hN⟩ : ∃ N : Subalgebra T E, N = integralClosure T E := ⟨_, rfl⟩
  have hmemN : ∀ x : E, x ∈ N ↔ IsIntegral T x := fun x => by rw [hN]; rfl
  rw [← hN] at hNfin
  have hNft : Algebra.FiniteType Ω N :=
    Algebra.FiniteType.trans hTft (Module.Finite.finiteType (R := T) N)
  letI : Algebra W N := ((algebraMap Ω N).comp (algebraMap W Ω)).toAlgebra
  haveI : IsScalarTower W Ω N := IsScalarTower.of_algebraMap_eq (fun _ => rfl)

  let ρ : D →+* T := RingHom.codRestrict (algebraMap D K) T
    (fun d => by rw [hT]; exact Algebra.subset_adjoin ⟨d, rfl⟩)
  have hρE : ∀ d : D, algebraMap T E (ρ d) = algebraMap D E d := fun d => rfl
  have hDN : ∀ d : D, algebraMap D E d ∈ N := fun d => by
    rw [hmemN, ← hρE]; exact isIntegral_algebraMap
  let ψ : D →+* N := RingHom.codRestrict (algebraMap D E) N hDN
  letI : Algebra D N := ψ.toAlgebra
  have hWDN : IsScalarTower W D N := IsScalarTower.of_algebraMap_eq (fun c => by
    apply Subtype.ext
    show algebraMap K E (φ (c : Ω)) = algebraMap K E (algebraMap D K (algebraMap W D c))
    rw [hφ, hfc])
  let j : N →ₐ[D] E := { toRingHom := (N.val : N →+* E), commutes' := fun _ => rfl }
  have hj : Function.Injective j := Subtype.val_injective

  choose! cf hcf0 hcf using hden
  have hgen : ∀ b : N, ∃ c : W, c ≠ 0 ∧ IsIntegral D (algebraMap W N c * b) := by
    intro b
    obtain ⟨p, hpm, hp⟩ := (hmemN (b : E)).mp b.2
    set n := p.natDegree with hn
    refine ⟨∏ i ∈ Finset.range n, cf (p.coeff i : K),
      Finset.prod_ne_zero_iff.mpr (fun i _ => hcf0 _ (p.coeff i).2), ?_⟩
    set c := ∏ i ∈ Finset.range n, cf (p.coeff i : K) with hc
    have hγmem : ι₀ c ∈ T := by
      have : ι₀ c = algebraMap A K (algebraMap W A c) := by rw [hι₀]; rfl
      rw [this]; exact hfT _
    set γ : T := ⟨ι₀ c, hγmem⟩ with hγ
    have hrange : ∀ x : T, (x : K) ∈ Set.range (algebraMap D K) → x ∈ Set.range ρ := by
      rintro x ⟨d, hd⟩
      exact ⟨d, Subtype.ext hd⟩
    have hι₀r : ∀ c' : W, ι₀ c' ∈ Set.range (algebraMap D K) := fun c' => ⟨_, hfc c'⟩
    have hlift : p.scaleRoots γ ∈ Polynomial.lifts ρ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots]
      apply hrange
      by_cases hi : i < n
      · obtain ⟨e, he⟩ := Finset.dvd_prod_of_mem (fun i => cf (p.coeff i : K))
          (Finset.mem_range.mpr hi)
        obtain ⟨m, hm⟩ : ∃ m, n - i = m + 1 := ⟨n - i - 1, by omega⟩
        have hval : ((p.coeff i * γ ^ (n - i) : T) : K) =
            (ι₀ (cf (p.coeff i : K)) * (p.coeff i : K)) * ι₀ e * (ι₀ c) ^ m := by
          rw [hm, Subalgebra.coe_mul, Subalgebra.coe_pow]
          show (p.coeff i : K) * (ι₀ c) ^ (m + 1) = _
          have hce : ι₀ c = ι₀ (cf (p.coeff i : K)) * ι₀ e := by rw [hc, he, map_mul]
          rw [pow_succ, hce]
          ring
        rw [hval]
        obtain ⟨d₁, hd₁⟩ := hcf _ (p.coeff i).2
        obtain ⟨d₂, hd₂⟩ := hι₀r e
        obtain ⟨d₃, hd₃⟩ := hι₀r c
        exact ⟨d₁ * d₂ * d₃ ^ m, by rw [map_mul, map_mul, map_pow, hd₁, hd₂, hd₃]⟩
      · have hni : n - i = 0 := by omega
        rw [hni, pow_zero, mul_one]
        rcases (Nat.le_of_not_lt hi).eq_or_lt with h | h
        · rw [← h, hn, hpm.coeff_natDegree]
          exact ⟨1, by rw [map_one]; rfl⟩
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [← hn]; exact h)]
          exact ⟨0, by rw [map_zero]; rfl⟩
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff γ).mpr hpm)
    have hroot := Polynomial.scaleRoots_eval₂_eq_zero (algebraMap T E) (s := γ) hp
    rw [← hqmap, Polynomial.eval₂_map] at hroot
    have hint : IsIntegral D (algebraMap T E γ * (b : E)) := ⟨q, hqm, hroot⟩
    rw [← isIntegral_algHom_iff j hj]
    have : j (algebraMap W N c * b) = algebraMap T E γ * (b : E) := by
      show algebraMap K E (φ (c : Ω)) * (b : E) = algebraMap K E (ι₀ c) * (b : E)
      rw [hφ]
    rw [this]
    exact hint

  have hnfr : Algebra.FiniteType D (integralClosure D N) :=
    wcpa_dj_lr1s_nf_ring_reduction Ω W hW D N hWD hNft inferInstance hgen

  let J : integralClosure D N →ₐ[D] integralClosure D E :=
    (j.comp (integralClosure D N).val).codRestrict (integralClosure D E)
      (fun x => x.2.map j)
  have hJ : Function.Surjective J := by
    intro y
    have hyT : IsIntegral T (y : E) := by
      have := IsIntegral.map_of_comp_eq (T := T) (U := E) ρ (RingHom.id E)
        (RingHom.ext fun d => rfl) y.2
      exact this
    let b : N := ⟨y, (hmemN _).mpr hyT⟩
    have hb : IsIntegral D b := (isIntegral_algHom_iff j hj).mp y.2
    exact ⟨⟨b, hb⟩, Subtype.ext rfl⟩
  haveI : Algebra.FiniteType D (integralClosure D E) := hnfr.of_surjective J hJ
  exact Algebra.IsIntegral.finite

theorem wcpa_dj_llsm_isicb_fs_noeth_red : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u)
    [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    [FiniteDimensional K L], Algebra.FiniteType ↥W A → NoZeroSMulDivisors ↥W A →
    ∀ (D : Subalgebra A K), D.FG → Module.Finite ↥D ↥(integralClosure ↥D L) →
    ∀ (Q : Ideal ↥(integralClosure ↥D L)) [Q.IsPrime],
    IsNoetherianRing (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥D Q) ∧
    _root_.IsReduced (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ↥D Q) :=
by
  intro Ω _ _ W A _ _ _ K _ _ _ L _ _ _ hFT hNZ D hFG hfin Q _
  classical
  haveI := hNZ
  have hWA : Function.Injective (algebraMap W A) := by
    intro x y hxy
    rw [← sub_eq_zero]
    have h : (x - y) • (1 : A) = 0 := by
      rw [Algebra.smul_def, map_sub, hxy, sub_self, zero_mul]
    rcases smul_eq_zero.mp h with h | h
    · exact h
    · exact absurd h one_ne_zero
  have hDft : Algebra.FiniteType A D := (Subalgebra.fg_iff_finiteType D).mp hFG
  set σ : ↥W →+* ↥(integralClosure ↥D L) :=
    (algebraMap ↥D ↥(integralClosure ↥D L)).comp ((algebraMap A ↥D).comp (algebraMap ↥W A))
    with hσ
  have hwL : Function.Injective
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) := by
    rw [RingHom.coe_comp, RingHom.coe_comp]
    exact (algebraMap K L).injective.comp ((IsFractionRing.injective A K).comp hWA)
  have hcoe : ∀ w : ↥W, ((σ w : ↥(integralClosure ↥D L)) : L) =
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := fun w => rfl
  have hσinj : Function.Injective σ := fun w₁ w₂ h => hwL (by rw [← hcoe, ← hcoe, h])
  have hRed := wcpa_dj_llsm_obi_fs_reduced Ω W L _ hwL ↥D (fun x => by
    show IsIntegral ↥D (algebraMap ↥D L (algebraMap A ↥D (algebraMap ↥W A x)))
    exact isIntegral_algebraMap) Q
  have hFTσ : σ.FiniteType := by
    have h1 : (algebraMap ↥W A).FiniteType := RingHom.finiteType_algebraMap.mpr hFT
    have h2 : (algebraMap A ↥D).FiniteType := RingHom.finiteType_algebraMap.mpr hDft
    have h3 : (algebraMap ↥D ↥(integralClosure ↥D L)).FiniteType :=
      RingHom.FiniteType.of_finite (RingHom.finite_algebraMap.mpr hfin)
    exact h3.comp (h2.comp h1)
  haveI : FaithfulSMul ↥D K := by
    rw [faithfulSMul_iff_algebraMap_injective]; intro x y h; exact Subtype.ext h
  haveI : IsFractionRing ↥D K := IsFractionRing.of_field _ K (fun z => by
    obtain ⟨a, b, -, hz⟩ := IsFractionRing.div_surjective (A := A) z
    exact ⟨algebraMap A ↥D a, algebraMap A ↥D b, hz.symm⟩)
  haveI hIC : IsIntegrallyClosed ↥(integralClosure ↥D L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (R := ↥D) K (L := L)
  have hred := wcpa_dj_llsm_mg_fibre_reduced Ω W _ σ hσinj
  have hI : Ideal.span {b : ↥(integralClosure ↥D L) |
      ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x} =
      (IsLocalRing.maximalIdeal ↥W).map σ := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨x, hx, hb⟩
      have hbx : b = σ x := Subtype.val_injective (hb.trans (hcoe x).symm)
      rw [hbx]
      exact Ideal.mem_map_of_mem σ hx
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact Ideal.subset_span ⟨x, hx, hcoe x⟩
  have hI' : (Ideal.span {b : ↥(integralClosure ↥D L) |
      ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x}).map
        (algebraMap ↥(integralClosure ↥D L) (Localization.AtPrime Q)) =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(integralClosure ↥D L) (Localization.AtPrime Q)).comp σ) := by
    rw [hI, Ideal.map_map]
  refine ⟨?_, hRed⟩
  by_cases hle : (IsLocalRing.maximalIdeal ↥W).map σ ≤ Q
  · have hN := (wcpa_dj_llsm_mg_fibre_noeth_norm Ω W _ σ hFTσ Q hle hred).1
    exact isNoetherianRing_of_ringEquiv _ (Ideal.quotEquivOfEq hI'.symm)
  · rw [Ideal.map_le_iff_le_comap] at hle
    obtain ⟨w, hw, hσw⟩ := Set.not_subset.mp hle
    have hunit : IsUnit (algebraMap ↥(integralClosure ↥D L) (Localization.AtPrime Q) (σ w)) :=
      IsLocalization.map_units (Localization.AtPrime Q) (⟨σ w, hσw⟩ : Q.primeCompl)
    have hmem : algebraMap ↥(integralClosure ↥D L) (Localization.AtPrime Q) (σ w) ∈
        (Ideal.span {b : ↥(integralClosure ↥D L) |
          ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
            (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x}).map
          (algebraMap ↥(integralClosure ↥D L) (Localization.AtPrime Q)) :=
      Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨w, hw, hcoe w⟩)
    have hJ := Ideal.eq_top_of_isUnit_mem _ hmem hunit
    haveI hss : Subsingleton
        (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) ↥D Q) :=
      Ideal.Quotient.subsingleton_iff.mpr hJ
    infer_instance

theorem wcpa_dj_llsm_isic_branch_dvr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g a' b : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 → b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 →
    a' ∣ b → ¬ b ∣ a' → b ∣ g →
    wcLlsAnnSep W A K L u a' → wcLlsIsiSep2 W A K L u a' b →
    (∀ (Q 𝔷 : Ideal ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) [Q.IsPrime] [𝔷.IsPrime],
      Q.comap (algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)) =
        wcLlsASbN W A K u a' → 𝔷 ≤ Q →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ c : ↥(integralClosure ↥(wcLlsASbS W A K u a') L),
        (c : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w → c ∈ 𝔷) →
      algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
        ⟨algebraMap A K (algebraMap ↥W A a') / algebraMap A K u,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ 𝔷 →
      algebraMap ↥(wcLlsASbS W A K u a') ↥(integralClosure ↥(wcLlsASbS W A K u a') L)
        (algebraMap A ↥(wcLlsASbS W A K u a') u) ∉ 𝔷 →
      wcIsDVR (wcLlsCasD ↥(integralClosure ↥(wcLlsASbS W A K u a') L) Q 𝔷)) ∧
    (∀ (Q 𝔷 : Ideal ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) [Q.IsPrime] [𝔷.IsPrime],
      Q.comap (algebraMap ↥(wcIcxRI W A K u a' b) ↥(integralClosure ↥(wcIcxRI W A K u a' b) L)) =
