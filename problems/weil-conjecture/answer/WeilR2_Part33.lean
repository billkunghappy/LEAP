      rw [Ideal.mem_comap, Ideal.mem_comap, V2]
      exact hm₃ w hw
  have hB𝔭 : ∀ y ∈ 𝔭.map (algebraMap A (Localization.Away h)),
      algebraMap (Localization.Away h) S y ∈ 𝔭₃ := by
    intro y hy
    have hmap : (𝔭.map (algebraMap A (Localization.Away h))).map
