  have hyw : y = w.comap (wcLlsCasIota W A K L t c' b') := by
    obtain ⟨_, _, _, hmax, _, _, h𝔭eq, _⟩ := hPD
    have hNP : (wcLlsScNV W A K t c' b').IsPrime := hwc ▸ Ideal.IsPrime.comap _
