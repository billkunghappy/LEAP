    exact (algebraMap K L).injective.comp (IsFractionRing.injective R K)
  have hR'L : Function.Injective (algebraMap R' L) := by
    rw [IsScalarTower.algebraMap_eq R' K L, RingHom.coe_comp]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective R' K)
  have hai : Function.Injective (algebraMap R ↥(integralClosure R L)) := fun x y hxy =>
    hRL (congrArg Subtype.val hxy :)
  have ha'i : Function.Injective (algebraMap R' ↥(integralClosure R' L)) := fun x y hxy =>
    hR'L (congrArg Subtype.val hxy :)

  obtain ⟨τ, hτ⟩ : ∃ τ : ↥(integralClosure R L) →+* ↥(integralClosure R' L),
      ∀ x, ((τ x : ↥(integralClosure R' L)) : L) = (x : L) :=
    ⟨((integralClosure R L).val.toRingHom).codRestrict (integralClosure R' L)
      (fun x => _root_.IsIntegral.map_of_comp_eq ι (RingHom.id L)
        (by rw [hcompL, RingHom.id_comp]) x.2), fun x => rfl⟩
  have hτi : Function.Injective τ := fun x y hxy =>
    Subtype.ext (by rw [← hτ x, ← hτ y, hxy])
  have hτa : τ.comp (algebraMap R ↥(integralClosure R L)) =
      (algebraMap R' ↥(integralClosure R' L)).comp ι := by
    refine RingHom.ext fun x => Subtype.ext ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, hτ]
    show algebraMap R L x = algebraMap R' L (ι x)
    exact (RingHom.congr_fun hcompL x).symm
  obtain ⟨Q, hQdef⟩ : ∃ Q : Ideal ↥(integralClosure R L), Q = Q'.comap τ := ⟨_, rfl⟩
  haveI hQp : Q.IsPrime := by rw [hQdef]; infer_instance
  have hQN : Q.comap (algebraMap R ↥(integralClosure R L)) = N := by
    rw [hQdef, Ideal.comap_comap, hτa, ← Ideal.comap_comap, hQ']
    exact hNN.symm

  haveI := hNd
  haveI := hNic
  haveI := hN'd
  haveI := hN'ic
  haveI : IsIntegrallyClosed ↥(integralClosure R L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI : IsIntegrallyClosed ↥(integralClosure R' L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI : IsDomain (Localization.AtPrime Q) :=
    IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors Q)
  haveI : IsDomain (Localization.AtPrime Q') :=
    IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors Q')
  haveI : IsIntegrallyClosed (Localization.AtPrime Q) :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime Q) Q.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors Q)
  haveI : IsIntegrallyClosed (Localization.AtPrime Q') :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime Q') Q'.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors Q')
  haveI : IsLocalHom (Localization.localRingHom N Q (algebraMap R ↥(integralClosure R L))
      hQN.symm) := Localization.isLocalHom_localRingHom _ _ _ _
  haveI : IsLocalHom (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L))
      hQ'.symm) := Localization.isLocalHom_localRingHom _ _ _ _
  haveI : IsLocalHom (Localization.localRingHom Q Q' τ hQdef) :=
    Localization.isLocalHom_localRingHom _ _ _ _

  have hρ₁i := locInj R ↥(integralClosure R L) _ hai N Q hQN.symm
  have hρ₂i := locInj R' ↥(integralClosure R' L) _ ha'i N' Q' hQ'.symm
  have hτQi := locInj ↥(integralClosure R L) ↥(integralClosure R' L) τ hτi Q Q' hQdef
  have hcomm : (Localization.localRingHom Q Q' τ hQdef).comp
      (Localization.localRingHom N Q (algebraMap R ↥(integralClosure R L)) hQN.symm) =
      (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L)) hQ'.symm).comp
      (Localization.localRingHom N N' ι hNN) := by
    apply IsLocalization.ringHom_ext N.primeCompl
    refine RingHom.ext fun x => ?_
    simp only [RingHom.comp_apply, Localization.localRingHom_to_map]
    exact congrArg _ (RingHom.congr_fun hτa x)

  have ch₁ := chart R ↥(integralClosure R L) (algebraMap R _)
    (RingHom.finite_algebraMap.mpr hfinR) N Q hQN.symm
  have ch₂ := chart R' ↥(integralClosure R' L) (algebraMap R' _)
    (RingHom.finite_algebraMap.mpr hfinR') N' Q' hQ'.symm

  obtain ⟨α, hα⟩ := Field.exists_primitive_element K L
  obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors R)
    (Rₘ := K) α (Algebra.IsIntegral.isIntegral α)
  obtain ⟨θ₀, hθ₀def⟩ : ∃ θ₀ : L, θ₀ = algebraMap R L (m : R) * α := ⟨_, rfl⟩
  have hθR : θ₀ ∈ integralClosure R L := by
    have h0 := hm
    rw [Submonoid.smul_def, Algebra.smul_def, ← hθ₀def] at h0
    exact h0
  have hθR' : θ₀ ∈ integralClosure R' L :=
    _root_.IsIntegral.map_of_comp_eq ι (RingHom.id L) (by rw [hcompL, RingHom.id_comp]) hθR
  have hμ : algebraMap R K (m : R) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors m.2
  have hαeq : α = algebraMap K L (algebraMap R K (m : R))⁻¹ * θ₀ := by
    rw [hθ₀def, IsScalarTower.algebraMap_apply R K L, ← mul_assoc, ← map_mul,
      inv_mul_cancel₀ hμ, map_one, one_mul]
  have htop : IntermediateField.adjoin K {θ₀} = ⊤ := by
    rw [eq_top_iff, ← hα, IntermediateField.adjoin_simple_le_iff, hαeq]
    exact IntermediateField.mul_mem _ (IntermediateField.algebraMap_mem _ _)
      (IntermediateField.mem_adjoin_simple_self K θ₀)
  have hadj : Algebra.adjoin K {θ₀} = ⊤ :=
    (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic
      (Algebra.IsAlgebraic.isAlgebraic θ₀)).mp htop
  have hsurjL : ∀ x : L, ∃ q : Polynomial K, Polynomial.aeval θ₀ q = x := by
    intro x
    have hx : x ∈ Algebra.adjoin K {θ₀} := by rw [hadj]; exact Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
    obtain ⟨q, hq⟩ := hx
    exact ⟨q, hq⟩
  have key : ∀ (q : Polynomial K) (z : ↥(integralClosure R' L)),
      Polynomial.aeval θ₀ q = (z : L) → ∃ (p : Polynomial R') (b : R'),
        b ∈ nonZeroDivisors R' ∧
        Polynomial.aeval (⟨θ₀, hθR'⟩ : ↥(integralClosure R' L)) p =
          algebraMap R' ↥(integralClosure R' L) b * z := by
    intro q z hqz
    obtain ⟨b, hb, hp⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R') q
    refine ⟨IsLocalization.integerNormalization (nonZeroDivisors R') q, b, hb, Subtype.ext ?_⟩
    have e1 : ((Polynomial.aeval (⟨θ₀, hθR'⟩ : ↥(integralClosure R' L))
        (IsLocalization.integerNormalization (nonZeroDivisors R') q) :
          ↥(integralClosure R' L)) : L) =
        Polynomial.aeval θ₀ (IsLocalization.integerNormalization (nonZeroDivisors R') q) :=
      (Polynomial.aeval_algHom_apply (integralClosure R' L).val _ _).symm
    rw [e1, ← Polynomial.aeval_map_algebraMap K, hp, ← algebraMap_smul K b q, map_smul, hqz,
      Algebra.smul_def, ← IsScalarTower.algebraMap_apply]
    rfl
  have hTinj : Function.Injective
      (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')) :=
    IsLocalization.injective (Localization.AtPrime Q') (Ideal.primeCompl_le_nonZeroDivisors Q')
  have hev : ∀ p : Polynomial R',
      (p.map (algebraMap R' (Localization.AtPrime N'))).eval₂
        (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L)) hQ'.symm)
        (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q') ⟨θ₀, hθR'⟩) =
      algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')
        (Polynomial.aeval (⟨θ₀, hθR'⟩ : ↥(integralClosure R' L)) p) := by
    intro p
    have hrl : (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L))
        hQ'.symm).comp (algebraMap R' (Localization.AtPrime N')) =
        (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')).comp
          (algebraMap R' ↥(integralClosure R' L)) :=
      RingHom.ext fun x => by
        rw [RingHom.comp_apply, RingHom.comp_apply, Localization.localRingHom_to_map]
    rw [Polynomial.eval₂_map, hrl, Polynomial.aeval_def, Polynomial.hom_eval₂]
  have hθ : ∃ θ : Localization.AtPrime Q, ∀ r : Localization.AtPrime Q',
      ∃ c c' : Polynomial (Localization.AtPrime N'),
      c'.eval₂ (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L)) hQ'.symm)
        (Localization.localRingHom Q Q' τ hQdef θ) ≠ 0 ∧
      r * c'.eval₂ (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L))
        hQ'.symm) (Localization.localRingHom Q Q' τ hQdef θ) =
      c.eval₂ (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L)) hQ'.symm)
        (Localization.localRingHom Q Q' τ hQdef θ) := by
    refine ⟨algebraMap ↥(integralClosure R L) (Localization.AtPrime Q)
      (⟨θ₀, hθR⟩ : ↥(integralClosure R L)), ?_⟩
    have hτθ : τ ⟨θ₀, hθR⟩ = ⟨θ₀, hθR'⟩ := Subtype.ext (hτ _)
    rw [Localization.localRingHom_to_map, hτθ]
    intro r
    obtain ⟨⟨y, σ⟩, hr'⟩ := IsLocalization.mk'_surjective Q'.primeCompl r
    have hr'' : IsLocalization.mk' (Localization.AtPrime Q') y σ = r := hr'
    subst hr''
    obtain ⟨q₁, hq₁⟩ := hsurjL (y : L)
    obtain ⟨q₂, hq₂⟩ := hsurjL ((σ : ↥(integralClosure R' L)) : L)
    obtain ⟨p₁, b₁, hb₁, hp₁⟩ := key q₁ y hq₁
    obtain ⟨p₂, b₂, hb₂, hp₂⟩ := key q₂ σ hq₂
    have hσ : (σ : ↥(integralClosure R' L)) ∉ Q' := σ.2
    have hσ0 : (σ : ↥(integralClosure R' L)) ≠ 0 := fun h0 => hσ (by rw [h0]; exact Q'.zero_mem)
    have hT0 : ∀ z : ↥(integralClosure R' L), z ≠ 0 →
        algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q') z ≠ 0 :=
      fun z hz => (map_ne_zero_iff _ hTinj).mpr hz
    have ha0 : ∀ b ∈ nonZeroDivisors R', algebraMap R' ↥(integralClosure R' L) b ≠ 0 :=
      fun b hb => (map_ne_zero_iff _ ha'i).mpr (nonZeroDivisors.ne_zero hb)
    refine ⟨Polynomial.C (algebraMap R' (Localization.AtPrime N') b₂) *
        p₁.map (algebraMap R' (Localization.AtPrime N')),
      Polynomial.C (algebraMap R' (Localization.AtPrime N') b₁) *
        p₂.map (algebraMap R' (Localization.AtPrime N')), ?_, ?_⟩
    · simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, hev, hp₂,
        Localization.localRingHom_to_map, map_mul]
      exact mul_ne_zero (hT0 _ (ha0 b₁ hb₁)) (mul_ne_zero (hT0 _ (ha0 b₂ hb₂)) (hT0 _ hσ0))
    · simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, hev, hp₁, hp₂,
        Localization.localRingHom_to_map, map_mul]
      linear_combination (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')
          (algebraMap R' ↥(integralClosure R' L) b₁) *
        algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')
          (algebraMap R' ↥(integralClosure R' L) b₂)) *
        IsLocalization.mk'_spec (Localization.AtPrime Q') y σ

  obtain ⟨Q₁, iQ₁, k₁, Q₂, iQ₂, k₂, j₁, j₂, κ, hk₁, hk₂, hj₁l, hj₂l, hκl, hκj, hj₁i, hj₁f,
      hj₂i, hκi, hQd, hQc, hint, hfrac, hc₁, hc₂⟩ :=
    halg (Localization.AtPrime N) (Localization.AtPrime N') (Localization.AtPrime Q)
      (Localization.AtPrime Q') P₁ P₂ (Localization.localRingHom N N' ι hNN)
      (Localization.localRingHom N Q (algebraMap R ↥(integralClosure R L)) hQN.symm)
      (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L)) hQ'.symm)
      (Localization.localRingHom Q Q' τ hQdef)
      hρ₁i hρ₂i hτQi hcomm ch₁ ch₂ hθ e₁ he₁ e₂ he₂ h hhloc hh
  have hρ₁a : (Localization.localRingHom N Q (algebraMap R ↥(integralClosure R L))
      hQN.symm).comp (algebraMap R (Localization.AtPrime N)) =
      (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q)).comp
        (algebraMap R ↥(integralClosure R L)) :=
    RingHom.ext fun x => by
      rw [RingHom.comp_apply, RingHom.comp_apply, Localization.localRingHom_to_map]
  have hρ₂a : (Localization.localRingHom N' Q' (algebraMap R' ↥(integralClosure R' L))
      hQ'.symm).comp (algebraMap R' (Localization.AtPrime N')) =
      (algebraMap ↥(integralClosure R' L) (Localization.AtPrime Q')).comp
        (algebraMap R' ↥(integralClosure R' L)) :=
    RingHom.ext fun x => by
      rw [RingHom.comp_apply, RingHom.comp_apply, Localization.localRingHom_to_map]
  refine ⟨Q, hQp, hQN, Q₁, Q₂, iQ₁, iQ₂, k₁, k₂, j₁, j₂, κ, hk₁, hk₂, hj₁l, hj₂l, hκl, hκj,
    hj₁i, hj₁f, hj₂i, hκi, hQd, hQc, hint, hfrac, ?_, ?_⟩
  · rw [← hρ₁a, ← RingHom.comp_assoc, hc₁, RingHom.comp_assoc]
  · rw [← hρ₂a, ← RingHom.comp_assoc, hc₂, RingHom.comp_assoc]

theorem wcpa_dj_llsm_br_radial_mono : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A) (z₀ : A) (b b' : ↥W),
    wcLlsPD W A 𝔭 k →
    ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ z₀ = t - algebraMap ↥W A c) ∨
      (∃ v g, k = .ann z₀ v g ∧ b ∣ g)) →
    b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 →
    b' ∣ b →
    wcLlsSepAt W A K L z₀ (algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀) →
    wcLlsSepAt W A K L z₀ (algebraMap A K (algebraMap ↥W A b') / algebraMap A K z₀) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k z₀ b b' hPD hk hbm hb0 hb'm hb'0
    hb'b hSep
  classical
  obtain ⟨r, hr⟩ := hb'b
  have hk' : ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
      z₀ = t - algebraMap ↥W A c) ∨ (∃ v g, k = .ann z₀ v g ∧ b' ∣ g)) := by
    rcases hk with h | ⟨v, g, hkv, hbg⟩
    · exact Or.inl h
    · exact Or.inr ⟨v, g, hkv, (Dvd.intro r hr.symm).trans hbg⟩
  have hkc : ∀ β : ↥W, ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
      z₀ = t - algebraMap ↥W A c) ∨ (∃ v g, k = .ann z₀ v g ∧ β ∣ g)) →
      ((∃ (t : A) (c : ↥W), k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧
        z₀ = t - algebraMap ↥W A c) ∨
      (∃ (u v : A) (g : ↥W), k = .ann u v g ∧ β ∣ g ∧ z₀ = u)) := by
    intro β h
    rcases h with h | ⟨v, g, hkv, hbg⟩
    · exact Or.inl h
    · exact Or.inr ⟨z₀, v, g, hkv, hbg, rfl⟩
  generalize hs : algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀ = s at hSep
  generalize hs' : algebraMap A K (algebraMap ↥W A b') / algebraMap A K z₀ = s'
  have hss : s = algebraMap A K (algebraMap ↥W A r) * s' := by
    rw [← hs, ← hs', hr, map_mul, map_mul]; ring
  have hsR' : s ∈ Algebra.adjoin A {s'} := by
    rw [hss]
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin (Set.mem_singleton s'))
  have hRR : Algebra.adjoin A {s} ≤ Algebra.adjoin A {s'} :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr hsR')
  let ι : ↥(Algebra.adjoin A {s}) →+* ↥(Algebra.adjoin A {s'}) :=
    (Subalgebra.inclusion hRR).toRingHom
  have hιK : (algebraMap ↥(Algebra.adjoin A {s'}) K).comp ι =
      algebraMap ↥(Algebra.adjoin A {s}) K := RingHom.ext fun x => rfl
  have hιA : ∀ a : A, ι (algebraMap A ↥(Algebra.adjoin A {s}) a) =
      algebraMap A ↥(Algebra.adjoin A {s'}) a := fun a => Subtype.ext rfl
  have hιs : ι ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ =
      algebraMap A ↥(Algebra.adjoin A {s'}) (algebraMap ↥W A r) *
        ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩ := Subtype.ext (by exact hss)
  unfold wcLlsSepAt at hSep ⊢
  intro Q' _ hQ'
  obtain ⟨N, hNdef⟩ : ∃ N : Ideal ↥(Algebra.adjoin A {s}),
      N = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) := ⟨_, rfl⟩
  obtain ⟨N', hN'Q⟩ : ∃ N' : Ideal ↥(Algebra.adjoin A {s'}),
      N' = Q'.comap (algebraMap ↥(Algebra.adjoin A {s'})
        ↥(integralClosure ↥(Algebra.adjoin A {s'}) L)) := ⟨_, rfl⟩
  haveI hN'p : N'.IsPrime := by rw [hN'Q]; infer_instance
  have hN'def := hN'Q.trans hQ'
  haveI hN'max : N'.IsMaximal := by
    have := wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 k z₀ b' hPD hk' hb'm hb'0 s' hs'.symm
    rw [← hN'def] at this
    exact this hN'p.ne_top
  have hle : N ≤ N'.comap ι := by
    rw [hNdef, hN'def]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · rw [SetLike.mem_coe, Ideal.mem_comap, hιA]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [SetLike.mem_coe, Ideal.mem_comap, hιs]
        exact Ideal.mul_mem_left _ _
          (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply, hιA]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  have hcne : N'.comap ι ≠ ⊤ := (inferInstance : (N'.comap ι).IsPrime).ne_top
  haveI hNmax : N.IsMaximal := by
    have := wcpa_dj_llsm_brrm_node_max Ω W hW hWt A K 𝔭 k z₀ b hPD hk hbm hb0 s hs.symm
    rw [← hNdef] at this
    exact this (ne_top_of_le_ne_top hcne hle)
  have hNN : N = N'.comap ι := hNmax.eq_of_le hcne hle
  have hfin₁ := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 k hPD s
  have hfin₂ := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 k hPD s'
  obtain ⟨hNd, hNic, hpres₁⟩ :=
    wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 k z₀ b hPD hk hbm hb0 s hs.symm N hNdef
  obtain ⟨hN'd, hN'ic, hpres₂⟩ :=
    wcpa_dj_llsm_brrm_node_pres Ω W hW hWt A K 𝔭 k z₀ b' hPD hk' hb'm hb'0 s' hs'.symm N'
      hN'def
  obtain ⟨P₁, _, e₁, he₁⟩ :=
    wcNd_hens_exists (Localization.AtPrime N) (IsLocalRing.maximalIdeal _) inferInstance
  obtain ⟨P₂, _, e₂, he₂⟩ :=
    wcNd_hens_exists (Localization.AtPrime N') (IsLocalRing.maximalIdeal _) inferInstance
  haveI hlamL : IsLocalHom (Localization.localRingHom N N' ι hNN) :=
    Localization.isLocalHom_localRingHom N N' ι hNN
  obtain ⟨h, ⟨hh, hhl⟩, -⟩ := he₁.2.2 P₂ he₂.1 (e₂.comp (Localization.localRingHom N N' ι hNN))
    (fun a => by
      rw [RingHom.comp_apply, he₂.2.1, IsLocalRing.notMem_maximalIdeal,
        IsLocalRing.notMem_maximalIdeal]
      exact isUnit_map_iff (Localization.localRingHom N N' ι hNN) a)
  have hhe : ∀ x : ↥(Algebra.adjoin A {s}),
      h (e₁ (algebraMap ↥(Algebra.adjoin A {s}) (Localization.AtPrime N) x)) =
        e₂ (algebraMap ↥(Algebra.adjoin A {s'}) (Localization.AtPrime N') (ι x)) := by
    intro x
    have h1 : (h.comp e₁) (algebraMap _ (Localization.AtPrime N) x) =
        (e₂.comp (Localization.localRingHom N N' ι hNN)) (algebraMap _ _ x) := by rw [hh]
    rw [RingHom.comp_apply, RingHom.comp_apply, Localization.localRingHom_to_map] at h1
    exact h1
  let σ₁ : ↥W →+* P₁ := e₁.comp ((algebraMap ↥(Algebra.adjoin A {s})
    (Localization.AtPrime N)).comp ((algebraMap A ↥(Algebra.adjoin A {s})).comp
      (algebraMap ↥W A)))
  let σ₂ : ↥W →+* P₂ := e₂.comp ((algebraMap ↥(Algebra.adjoin A {s'})
    (Localization.AtPrime N')).comp ((algebraMap A ↥(Algebra.adjoin A {s'})).comp
      (algebraMap ↥W A)))
  obtain ⟨f₁, hf₁, hf₁0, hf₁1⟩ := hpres₁ P₁ e₁ he₁
  obtain ⟨f₂, hf₂, hf₂0, hf₂1⟩ := hpres₂ P₂ e₂ he₂
  have hhσ : h.comp σ₁ = σ₂ := RingHom.ext fun w =>
    (hhe (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w))).trans (by rw [hιA]; rfl)
  have hX0 : h (f₁ (wcEbntX W b 0)) = f₂ (wcEbntX W b' 0) := by
    rw [hf₁0, hf₂0, hhe, hιA]
  have hX1 : h (f₁ (wcEbntX W b 1)) = σ₂ r * f₂ (wcEbntX W b' 1) := by
    rw [hf₁1, hf₂1, hhe, hιs, map_mul, map_mul]
    rfl
  have hab : b = r * b' := by rw [hr, mul_comm]
  haveI : IsScalarTower ↥(Algebra.adjoin A {s}) K L :=
    IsScalarTower.of_algebraMap_eq (fun x => rfl)
  haveI : IsScalarTower ↥(Algebra.adjoin A {s'}) K L :=
    IsScalarTower.of_algebraMap_eq (fun x => rfl)
  obtain ⟨Q, hQp, hQN, Q₁, Q₂, _, _, k₁, k₂, j₁, j₂, κ, hk₁, hk₂, hj₁l, hj₂l, hκl, hκj, hj₁i,
      hj₁f, hj₂i, hκi, hQ₂d, hQ₂ic, hmon, hfrac, hc₁, hc₂⟩ :=
    wcpa_dj_llsm_brrm_norm_bridge K L ↥(Algebra.adjoin A {s}) ↥(Algebra.adjoin A {s'}) ι hιK
      hfin₁ hfin₂ N N' hNN hNd hNic hN'd hN'ic Q' hN'Q.symm P₁ P₂ e₁ e₂ he₁ he₂ h hhl hh
  have hQN' := hQN.trans hNdef
  have hnb := hSep Q hQN'
  have hG := wcpa_dj_llsm_sd_good_model Ω W hW hWt A K L 𝔭 k hPD z₀ b hbm hb0 (hkc b hk) s
    hs.symm Q hQN' hnb Q₁ k₁ hk₁
  have hσ₁ : k₁.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
      (Localization.AtPrime Q)).comp ((algebraMap ↥(Algebra.adjoin A {s})
      ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
      ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)))) = j₁.comp σ₁ :=
    RingHom.ext fun w =>
      congrArg (fun φ : ↥(Algebra.adjoin A {s}) →+* Q₁ => φ (algebraMap A _ (algebraMap ↥W A w)))
        hc₁
  have hσ₂ : k₂.comp ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s'}) L)
      (Localization.AtPrime Q')).comp ((algebraMap ↥(Algebra.adjoin A {s'})
      ↥(integralClosure ↥(Algebra.adjoin A {s'}) L)).comp
      ((algebraMap A ↥(Algebra.adjoin A {s'})).comp (algebraMap ↥W A)))) = j₂.comp σ₂ :=
    RingHom.ext fun w =>
      congrArg (fun φ : ↥(Algebra.adjoin A {s'}) →+* Q₂ =>
        φ (algebraMap A _ (algebraMap ↥W A w))) hc₂
  rw [hσ₁] at hG
  have hB := wcpa_dj_lr1k_ebnt_annulus_normalization Ω W hW hWt P₁ P₂ σ₁ σ₂ h hhl hhσ b b' r
    f₁ f₂ hab hf₁ hf₂ hX0 hX1 Q₁ Q₂ j₁ j₂ κ hj₁l hj₂l hκl hκj hj₁i hj₁f hj₂i hκi hk₂.1 hQ₂d
    hQ₂ic hmon hfrac hG
  rw [← hσ₂] at hB
  exact wcpa_dj_llsm_sd_model_good Ω W hW hWt A K L 𝔭 k hPD z₀ b' hb'm hb'0 (hkc b' hk') s'
    hs'.symm Q' hQ' Q₂ k₂ hk₂ (Or.inr hB)

theorem wcpa_dj_llsm_brsp_crt_element : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
    [Algebra A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] (y : Ideal ↥(integralClosure A L)), y.IsMaximal →
    wcLlsDec A K L y = ⊥ →
    ∃ θ : ↥(integralClosure A L), θ ∈ y ∧ ∀ σ : L ≃ₐ[K] L, σ ≠ 1 →
      ∀ z : ↥(integralClosure A L), (z : L) = σ (θ : L) → z - 1 ∈ y :=
by
  intro A _ K _ _ L _ _ _ _ _ y hy hdec
  classical

  have hmap : ∀ g : L ≃ₐ[K] L, ∀ x : integralClosure A L, g x ∈ integralClosure A L := by
    intro g x
    exact ((show IsIntegral A (x : L) from x.2).map ((g : L →ₐ[K] L).restrictScalars A))
  let res : (L ≃ₐ[K] L) → (integralClosure A L →+* integralClosure A L) := fun g =>
    { toFun := fun x => ⟨g x, hmap g x⟩
      map_one' := Subtype.ext (map_one g)
      map_mul' := fun a b => Subtype.ext (map_mul g _ _)
      map_zero' := Subtype.ext (map_zero g)
      map_add' := fun a b => Subtype.ext (map_add g _ _) }
  have hinv1 : ∀ (g : L ≃ₐ[K] L) (x : integralClosure A L), res g (res g.symm x) = x :=
    fun g x => Subtype.ext (g.apply_symm_apply (x : L))
  have hsurj : ∀ g : L ≃ₐ[K] L, Function.Surjective (res g) :=
    fun g x => ⟨res g.symm x, hinv1 g x⟩

  let I : (L ≃ₐ[K] L) → Ideal (integralClosure A L) := fun g => y.comap (res g)
  have hImax : ∀ g, (I g).IsMaximal := by
    intro g
    haveI := hy
    exact Ideal.comap_isMaximal_of_surjective (res g) (hsurj g)

  have hkey : ∀ g : L ≃ₐ[K] L, g ≠ 1 → ¬ (I g ≤ y) := by
    intro g hg hle
    have hIeq : I g = y := (hImax g).eq_of_le hy.ne_top hle
    have hiff : ∀ x, res g x ∈ y ↔ x ∈ y := by
      intro x
      have h : x ∈ I g ↔ x ∈ y := by rw [hIeq]
      exact h
    have hmem : g ∈ wcLlsDec A K L y := by
      unfold wcLlsDec
      open Pointwise in rw [MulAction.mem_stabilizer_iff]
      open Pointwise in ext z
      open Pointwise in rw [Set.mem_smul_set]
      constructor
      · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
        exact ⟨res g x, (hiff x).mpr hx, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        refine ⟨↑(res g.symm x), ⟨res g.symm x, ?_, rfl⟩, ?_⟩
        · show res g.symm x ∈ y
          rw [← hiff, hinv1]; exact hx
        · show g (g.symm (x : L)) = (x : L)
          exact g.apply_symm_apply _
    rw [hdec, Subgroup.mem_bot] at hmem
    exact hg hmem

  set S : Finset (L ≃ₐ[K] L) := (Finset.univ : Finset (L ≃ₐ[K] L)).erase 1 with hS
  set J : Ideal (integralClosure A L) := S.inf I with hJ
  have hJy : ¬ (J ≤ y) := by
    intro hle
    obtain ⟨g, hgS, hgle⟩ := (Ideal.IsPrime.inf_le' hy.isPrime).mp hle
    exact hkey g (Finset.mem_erase.mp hgS).1 hgle

  obtain ⟨b₀, hb₀J, hb₀y⟩ := SetLike.not_le_iff_exists.mp hJy
  obtain ⟨r, θ, hθy, hrθ⟩ := Ideal.IsMaximal.exists_inv hy hb₀y
  have hbJ : r * b₀ ∈ J := Ideal.mul_mem_left J r hb₀J

  refine ⟨θ, hθy, ?_⟩
  intro g hg z hz
  have hzr : z = res g θ := Subtype.ext hz
  have hθ1 : θ - 1 = -(r * b₀) := by
    linear_combination hrθ
  have hz1 : z - 1 = -(res g (r * b₀)) := by
    rw [hzr, ← map_one (res g), ← map_sub, hθ1, map_neg]
  have hgS : g ∈ S := Finset.mem_erase.mpr ⟨hg, Finset.mem_univ g⟩
  have hbI : r * b₀ ∈ I g := (Finset.inf_le hgS : J ≤ I g) hbJ
  rw [hz1]
  exact y.neg_mem hbI

theorem wcpa_dj_llsm_brsp_primitive_deriv : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u)
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L]
    [IsGalois K L] [DecidableEq (L ≃ₐ[K] L)] (θ : L), IsIntegral A θ →
    (∀ σ : L ≃ₐ[K] L, σ θ = θ → σ = 1) →
    Algebra.adjoin K {θ} = ⊤ ∧
    Polynomial.aeval θ (Polynomial.derivative (minpoly A θ)) =
      ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), (θ - σ θ) :=
by
  intro A _ _ _ K _ _ _ L _ _ _ _ _ _ _ θ hθ hstab
  have hθK : _root_.IsIntegral K θ := _root_.IsIntegral.of_finite K θ
  have hF : IntermediateField.adjoin K {θ} = ⊤ := by
    have hfix : (IntermediateField.adjoin K {θ}).fixingSubgroup = ⊥ := by
      rw [Subgroup.eq_bot_iff_forall]
      intro σ hσ
      apply hstab
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hσ θ
        (IntermediateField.mem_adjoin_simple_self K θ)
    rw [← IsGalois.fixedField_fixingSubgroup (IntermediateField.adjoin K {θ}), hfix,
      IntermediateField.fixedField_bot]
  have hAlg : Algebra.adjoin K {θ} = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hθK.isAlgebraic, hF,
      IntermediateField.top_toSubalgebra]
  refine ⟨hAlg, ?_⟩
  have hinj : Function.Injective (fun σ : L ≃ₐ[K] L => σ θ) := by
    intro σ τ h
    simp only at h
    have : (τ⁻¹ * σ) θ = θ := by
      rw [AlgEquiv.mul_apply, h, AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply]
    exact (inv_mul_eq_one.mp (hstab _ this)).symm
  have hprodK : (minpoly K θ).map (algebraMap K L) =
      ∏ σ : L ≃ₐ[K] L, (Polynomial.X - Polynomial.C (σ θ)) := by
    have hPm : (∏ σ : L ≃ₐ[K] L, (Polynomial.X - Polynomial.C (σ θ))).Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun σ _ => Polynomial.monic_X_sub_C (σ θ))
    have hfm : ((minpoly K θ).map (algebraMap K L)).Monic := (minpoly.monic hθK).map _
    have hdvd : (∏ σ : L ≃ₐ[K] L, (Polynomial.X - Polynomial.C (σ θ))) ∣
        (minpoly K θ).map (algebraMap K L) := by
      refine Fintype.prod_dvd_of_coprime
        (s := fun σ : L ≃ₐ[K] L => Polynomial.X - Polynomial.C (σ θ))
        (Polynomial.pairwise_coprime_X_sub_C hinj) ?_
      intro σ
      rw [Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def, Polynomial.eval_map_algebraMap]
      have := Polynomial.aeval_algHom_apply (σ : L →ₐ[K] L) θ (minpoly K θ)
      rw [minpoly.aeval, map_zero] at this
      exact this
    refine Polynomial.eq_of_monic_of_dvd_of_natDegree_le hPm hfm hdvd ?_
    · rw [Polynomial.natDegree_finsetProd_X_sub_C_eq_card, (minpoly.monic hθK).natDegree_map,
        ← IntermediateField.adjoin.finrank hθK, hF, IntermediateField.finrank_top',
        ← IsGalois.card_aut_eq_finrank, Nat.card_eq_fintype_card, Finset.card_univ]
  have s3 : ∀ (s : (L ≃ₐ[K] L) → L) (i₀ : L ≃ₐ[K] L),
      Polynomial.eval (s i₀) (Polynomial.derivative
        (∏ i, (Polynomial.X - Polynomial.C (s i)))) = ∏ i ∈ Finset.univ.erase i₀, (s i₀ - s i) := by
    intro s i₀
    rw [Polynomial.derivative_prod_finset]
    simp only [Polynomial.derivative_X_sub_C, mul_one, Polynomial.eval_finsetSum,
      Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    rw [Finset.sum_eq_single_of_mem i₀ (Finset.mem_univ _)]
    intro a _ ha
    apply Finset.prod_eq_zero (i := i₀)
    · exact Finset.mem_erase.mpr ⟨Ne.symm ha, Finset.mem_univ _⟩
    · exact sub_self _
  have hK : minpoly K θ = (minpoly A θ).map (algebraMap A K) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' K hθ
  have hprod : (minpoly A θ).map (algebraMap A L) =
      ∏ σ : L ≃ₐ[K] L, (Polynomial.X - Polynomial.C (σ θ)) := by
    rw [IsScalarTower.algebraMap_eq A K L, ← Polynomial.map_map, ← hK, hprodK]
  have h3 := s3 (fun σ => σ θ) 1
  simp only [AlgEquiv.one_apply] at h3
  rw [← h3, ← hprod, Polynomial.derivative_map, Polynomial.eval_map_algebraMap]

theorem wcpa_dj_llsm_brsp_deriv_unit : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K]
    [Algebra A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [DecidableEq (L ≃ₐ[K] L)] (y : Ideal ↥(integralClosure A L)),
    y.IsPrime → ∀ θ : ↥(integralClosure A L), θ ∈ y →
    (∀ σ : L ≃ₐ[K] L, σ ≠ 1 → ∀ z : ↥(integralClosure A L), (z : L) = σ (θ : L) → z - 1 ∈ y) →
    ∀ z : ↥(integralClosure A L),
      (z : L) = ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), ((θ : L) - σ (θ : L)) → z ∉ y :=
by
  intro A _ K _ _ L _ _ _ _ _ _ y hy θ hθ hP z hzL hz
  haveI := hy
  have hint : ∀ σ : L ≃ₐ[K] L, IsIntegral A (σ (θ : L)) := fun σ => by
    have h := IsIntegral.map (σ.toAlgHom.restrictScalars A) θ.2
    exact h
  let w : (L ≃ₐ[K] L) → ↥(integralClosure A L) := fun σ => ⟨σ (θ : L), hint σ⟩
  have hw : ∀ σ, ((w σ : ↥(integralClosure A L)) : L) = σ (θ : L) := fun σ => rfl
  have hzeq : z = ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), (θ - w σ) := by
    apply Subtype.ext
    rw [hzL]
    have hc : ((∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), (θ - w σ) :
        ↥(integralClosure A L)) : L) =
        ∏ σ ∈ Finset.univ.erase (1 : L ≃ₐ[K] L), (((θ - w σ : ↥(integralClosure A L))) : L) :=
      map_prod (integralClosure A L).val _ _
    rw [hc]
    refine Finset.prod_congr rfl (fun σ _ => ?_)
    rw [Subalgebra.coe_sub, hw]
  rw [hzeq, Ideal.IsPrime.prod_mem_iff] at hz
  obtain ⟨σ, hσ, hσy⟩ := hz
  have hσ1 : σ ≠ 1 := (Finset.mem_erase.mp hσ).1
  have h2 : w σ - 1 ∈ y := hP σ hσ1 (w σ) rfl
  have h1 : (1 : ↥(integralClosure A L)) = θ - (θ - w σ) - (w σ - 1) := by ring
  have hone : (1 : ↥(integralClosure A L)) ∈ y := by
    rw [h1]
    exact y.sub_mem (y.sub_mem hθ hσy) h2
  exact hy.ne_top ((Ideal.eq_top_iff_one y).mpr hone)

theorem wcpa_dj_llsm_brsp_conductor : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] [Algebra.IsSeparable K L] (θ : L),
    IsIntegral A θ → Algebra.adjoin K {θ} = ⊤ → ∀ x : L, IsIntegral A x →
    Polynomial.aeval θ (Polynomial.derivative (minpoly A θ)) * x ∈ Algebra.adjoin A {θ} :=
by
  intro A _ _ _ K _ _ _ L _ _ _ _ _ _ θ hθ hgen x hx
  have s1 : minpoly K θ = Polynomial.map (algebraMap A K) (minpoly A θ) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' K hθ
  have s2 : Polynomial.aeval θ (Polynomial.derivative (minpoly K θ)) =
      Polynomial.aeval θ (Polynomial.derivative (minpoly A θ)) := by
    rw [s1, Polynomial.derivative_map, Polynomial.aeval_map_algebraMap]
  have s3 : Polynomial.aeval θ (Polynomial.derivative (minpoly A θ)) ≠ 0 := by
    rw [← s2]
    exact Polynomial.Separable.aeval_derivative_ne_zero
      (Algebra.IsSeparable.isSeparable K θ) (minpoly.aeval K θ)
  have hdual := traceForm_dualSubmodule_adjoin A K hgen hθ
  have s5 : ∀ y ∈ Algebra.adjoin A {θ}, IsIntegral A y := fun y hy =>
    IsIntegral.of_mem_of_fg _ hθ.fg_adjoin_singleton y hy
  have s6 : x ∈ (Algebra.traceForm K L).dualSubmodule
      (Subalgebra.toSubmodule (Algebra.adjoin A {θ})) := by
    rw [LinearMap.BilinForm.mem_dualSubmodule]
    intro y hy
    rw [Subalgebra.mem_toSubmodule] at hy
    rw [Algebra.traceForm_apply, Submodule.mem_one]
    have h1 : IsIntegral A (Algebra.trace K L (x * y)) :=
      Algebra.isIntegral_trace (hx.mul (s5 y hy))
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp h1
    exact ⟨a, ha⟩
  rw [hdual, s2, Submodule.mem_smul_pointwise_iff_exists] at s6
  obtain ⟨b, hb, hbx⟩ := s6
  rw [← hbx, smul_eq_mul, mul_inv_cancel_left₀ s3]
  exact hb

theorem wcpa_dj_llsm_brsp_fs_transport : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (L : Type u) [Field L] [Algebra A L]
    (C : Subalgebra A L) (hle : C ≤ integralClosure A L) [Algebra ↥W ↥C],
    algebraMap ↥W ↥C = (algebraMap A ↥C).comp (algebraMap ↥W A) →
    ∀ d : ↥C, (∀ x : ↥(integralClosure A L), (d : L) * (x : L) ∈ C) →
    ∀ (y : Ideal ↥(integralClosure A L)) [y.IsPrime], Subalgebra.inclusion hle d ∉ y →
    Nonempty (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y ≃+*
      (Localization.AtPrime (y.comap (Subalgebra.inclusion hle)) ⧸
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥C)).map
          (algebraMap ↥C (Localization.AtPrime (y.comap (Subalgebra.inclusion hle)))))) :=
by
  intro Ω _ W A _ _ L _ _ C hle _ hW d hcond y _ hdy
  set ι : ↥C →+* ↥(integralClosure A L) := (Subalgebra.inclusion hle : ↥C →+* ↥(integralClosure A L))
    with hιdef
  have hιapp : ∀ c : ↥C, ι c = Subalgebra.inclusion hle c := fun c => rfl
  have hιL : ∀ c : ↥C, ((ι c : ↥(integralClosure A L)) : L) = (c : L) := fun c => rfl
  have hY : y.comap (Subalgebra.inclusion hle) = y.comap ι := rfl

  let Ψ : Localization.AtPrime (y.comap (Subalgebra.inclusion hle)) →+* Localization.AtPrime y :=
    Localization.localRingHom (y.comap (Subalgebra.inclusion hle)) y ι hY
  have hΨ : ∀ c : ↥C, Ψ (algebraMap ↥C (Localization.AtPrime (y.comap (Subalgebra.inclusion hle))) c)
      = algebraMap ↥(integralClosure A L) (Localization.AtPrime y) (ι c) := fun c =>
    Localization.localRingHom_to_map _ _ _ hY c
  have hinj : Function.Injective Ψ := by
    apply IsLocalization.injective_of_map_algebraMap_zero
      (M := (y.comap (Subalgebra.inclusion hle)).primeCompl)
    intro c hc
    rw [hΨ] at hc
    obtain ⟨⟨m, hm⟩, hmc⟩ := (IsLocalization.map_eq_zero_iff y.primeCompl _ _).mp hc
    have hm0 : m ≠ 0 := by
      intro h0
      apply hm
      rw [h0]
      exact y.zero_mem
    have hc0 : ι c = 0 := (mul_eq_zero.mp hmc).resolve_left hm0
    have : c = 0 := by
      apply Subalgebra.inclusion_injective hle
      rw [← hιapp, hc0, map_zero]
    rw [this, map_zero]
  have hsurj : Function.Surjective Ψ := by
    intro z
    obtain ⟨⟨x, ⟨s, hs⟩⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl z
    let a : ↥C := ⟨(d : L) * (x : L), hcond x⟩
    let b : ↥C := ⟨(d : L) * (s : L), hcond s⟩
    have ha : ι a = ι d * x := Subtype.ext rfl
    have hb : ι b = ι d * s := Subtype.ext rfl
    have hbY : b ∈ (y.comap (Subalgebra.inclusion hle)).primeCompl := by
      intro hb''
      have hb' : ι b ∈ y := hb''
      rw [hb] at hb'
      rcases Ideal.IsPrime.mem_or_mem inferInstance hb' with h | h
      · exact hdy h
      · exact hs h
    refine ⟨IsLocalization.mk' _ a ⟨b, hbY⟩, ?_⟩
    rw [Localization.localRingHom_mk']
    rw [IsLocalization.mk'_eq_iff_eq]
    congr 1
    simp only [ha, hb]
    ring
  let e := RingEquiv.ofBijective Ψ ⟨hinj, hsurj⟩
  have he : (e : Localization.AtPrime (y.comap (Subalgebra.inclusion hle)) →+* Localization.AtPrime y).comp
        (algebraMap ↥C (Localization.AtPrime (y.comap (Subalgebra.inclusion hle)))) =
      (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)).comp ι :=
    RingHom.ext fun c => hΨ c

  have hK : ∀ w : ↥W, ((ι (algebraMap ↥W ↥C w) : ↥(integralClosure A L)) : L) =
      ((algebraMap A L).comp (algebraMap ↥W A)) w := by
    intro w
    rw [hιL, hW, RingHom.comp_apply, RingHom.comp_apply]
    rfl
  have hspan : Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w} =
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥C)).map ι := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨w, hw', hb⟩
      have : b = ι (algebraMap ↥W ↥C w) := Subtype.ext (by rw [hK, hb])
      rw [this]
      exact Ideal.mem_map_of_mem ι (Ideal.mem_map_of_mem _ hw')
    · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro w hw'
      exact Ideal.subset_span ⟨w, hw', hK w⟩
  have hJ : (Ideal.span {b : ↥(integralClosure A L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) w}).map
      (algebraMap ↥(integralClosure A L) (Localization.AtPrime y)) =
      Ideal.map (e : Localization.AtPrime (y.comap (Subalgebra.inclusion hle)) →+* Localization.AtPrime y)
        (((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥C)).map
          (algebraMap ↥C (Localization.AtPrime (y.comap (Subalgebra.inclusion hle))))) := by
    rw [hspan, Ideal.map_map ι, ← he]
    exact (Ideal.map_map _ _).symm
  exact ⟨(Ideal.quotientEquiv _ _ e hJ).symm⟩

theorem wcpa_dj_llsm_brsp_standard_etale : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] (L : Type u) [Field L] [Algebra A L],
    Function.Injective (algebraMap A L) → ∀ θ : L, IsIntegral A θ →
    ∀ z : ↥(Algebra.adjoin A {θ}),
      Polynomial.aeval (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
        (Polynomial.derivative (minpoly A θ)) ∣ z →
      RingHom.Etale ((algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away z)).comp
        (algebraMap A ↥(Algebra.adjoin A {θ}))) :=
by
  intro A _ _ _ L _ _ hinj θ hθ z hdz
  have : Module.IsTorsionFree A L := Module.isTorsionFree_iff_algebraMap_injective.mpr hinj
  let e : AdjoinRoot (minpoly A θ) ≃ₐ[A] ↥(Algebra.adjoin A {θ}) := minpoly.equivAdjoin hθ
  have he_root : e (AdjoinRoot.root (minpoly A θ)) =
      (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) := by
    show minpoly.equivAdjoin hθ (AdjoinRoot.root (minpoly A θ)) = _
    rw [minpoly.coe_equivAdjoin, AdjoinRoot.Minpoly.coe_toAdjoin, AdjoinRoot.liftAlgHom_root]
  have her : e (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ))) =
      Polynomial.aeval (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
        (Polynomial.derivative (minpoly A θ)) := by
    rw [← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, he_root]
  let P : StandardEtalePair A :=
    ⟨minpoly A θ, minpoly.monic hθ, Polynomial.derivative (minpoly A θ), ⟨1, 0, 1, by simp⟩⟩
  have h1 : Algebra.Etale A
      (Localization.Away (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ)))) :=
    Algebra.Etale.of_equiv P.equivAwayAdjoinRoot
  have H : Submonoid.map e.toRingEquiv.toMonoidHom
      (Submonoid.powers (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ)))) =
      Submonoid.powers (Polynomial.aeval
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
        (Polynomial.derivative (minpoly A θ))) := by
    rw [Submonoid.map_powers, ← her]
    rfl
  let ψ₀ := IsLocalization.ringEquivOfRingEquiv
    (Localization.Away (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ))))
    (Localization.Away (Polynomial.aeval
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
        (Polynomial.derivative (minpoly A θ)))) e.toRingEquiv H
  have hψ : ∀ a : A, ψ₀ (algebraMap A _ a) = algebraMap A _ a := by
    intro a
    rw [IsScalarTower.algebraMap_apply A (AdjoinRoot (minpoly A θ))
      (Localization.Away (AdjoinRoot.mk (minpoly A θ) (Polynomial.derivative (minpoly A θ)))) a,
      IsLocalization.ringEquivOfRingEquiv_eq,
      IsScalarTower.algebraMap_apply A ↥(Algebra.adjoin A {θ})
        (Localization.Away (Polynomial.aeval
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
        (Polynomial.derivative (minpoly A θ)))) a]
    congr 1
    exact e.commutes a
  have h2 : Algebra.Etale A (Localization.Away (Polynomial.aeval
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
        (Polynomial.derivative (minpoly A θ)))) :=
    Algebra.Etale.of_equiv (AlgEquiv.ofRingEquiv (f := ψ₀) hψ)
  obtain ⟨w, rfl⟩ := hdz
  set d := Polynomial.aeval
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ}))
        (Polynomial.derivative (minpoly A θ)) with hd
  let x := algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away d) w
  have : Algebra.Etale (Localization.Away d) (Localization.Away x) :=
    Algebra.Etale.of_isLocalizationAway x
  have h3 : Algebra.Etale A (Localization.Away x) :=
    Algebra.Etale.comp A (Localization.Away d) (Localization.Away x)
  have : IsLocalization.Away (d * w) (Localization.Away x) :=
    IsLocalization.Away.mul' (Localization.Away d) (Localization.Away x) d w
  let ε := IsLocalization.algEquiv (Submonoid.powers (d * w)) (Localization.Away x)
    (Localization.Away (d * w))
  let ε' : Localization.Away x ≃ₐ[A] Localization.Away (d * w) := ε.restrictScalars A
  have h5 : (algebraMap A (Localization.Away (d * w))).Etale := by
    have hA : (algebraMap A (Localization.Away x)).Etale := RingHom.etale_algebraMap.mpr h3
    have h6 := RingHom.Etale.respectsIso.left (algebraMap A (Localization.Away x))
      ε'.toRingEquiv hA
    convert h6 using 1
    ext a
    show _ = ε' (algebraMap A _ a)
    exact (ε'.commutes a).symm
  rw [← IsScalarTower.algebraMap_eq]
  exact h5

theorem wcpa_dj_llsm_brsp_chart_compose : ∀ (A C S : Type u) [CommRing A] [CommRing C] [CommRing S]
    (j : A →+* C) (h : A) (x : C) (f₀ : S →+* Localization.Away h), RingHom.Etale f₀ →
    RingHom.Etale ((algebraMap C (Localization.Away (j h * x))).comp j) →
    ∃ φ : Localization.Away h →+* Localization.Away (j h * x),
      φ.comp (algebraMap A (Localization.Away h)) = (algebraMap C (Localization.Away (j h * x))).comp j ∧
      RingHom.Etale (φ.comp f₀) :=
by
  intro A C S _ _ _ j h x f₀ hf₀ hγ
  have key : ∀ (C' : Type u) [CommRing C'] (γ : A →+* C'), IsUnit (γ h) → γ.Etale →
      ∃ φ : Localization.Away h →+* C',
        φ.comp (algebraMap A (Localization.Away h)) = γ ∧ RingHom.Etale (φ.comp f₀) := by
    intro C' _ γ hu hγ'
    obtain ⟨φ, hcomp⟩ : ∃ φ : Localization.Away h →+* C',
        φ.comp (algebraMap A (Localization.Away h)) = γ :=
      ⟨IsLocalization.Away.lift (S := Localization.Away h) h hu,
        RingHom.ext fun a => IsLocalization.Away.lift_eq h hu a⟩
    refine ⟨φ, hcomp, ?_⟩
    letI iA : Algebra A C' := γ.toAlgebra
    letI iAh : Algebra (Localization.Away h) C' := φ.toAlgebra
    haveI : IsScalarTower A (Localization.Away h) C' :=
      IsScalarTower.of_algebraMap_eq (fun a => (RingHom.congr_fun hcomp a).symm)
    haveI : Algebra.Etale A (Localization.Away h) := Algebra.Etale.of_isLocalizationAway h
    haveI : Algebra.Etale A C' := hγ'.toAlgebra
    haveI : Algebra.Etale (Localization.Away h) C' :=
      Algebra.Etale.of_restrictScalars A (Localization.Away h) C'
    have hφ : RingHom.Etale φ := RingHom.etale_algebraMap.mpr inferInstance
    exact RingHom.Etale.stableUnderComposition f₀ φ hf₀ hφ
  have hu : IsUnit (algebraMap C (Localization.Away (j h * x)) (j h)) :=
    IsLocalization.Away.isUnit_of_dvd (S := Localization.Away (j h * x)) (j h * x)
      (dvd_mul_right (j h) x)
  exact key _ _ hu hγ

theorem wcpa_dj_llsm_brsp_node_not_bad : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (C : Type u) [CommRing C] [Algebra ↥W C] (Y : Ideal C) [Y.IsPrime] (g : ↥W) (u v h : C),
    g ∈ IsLocalRing.maximalIdeal ↥W → h ∉ Y →
    (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W C) ≤ Y →
    ∀ f : (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+* Localization.Away h,
    f.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
      (algebraMap C (Localization.Away h)).comp (algebraMap ↥W C) →
    f (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = algebraMap C (Localization.Away h) u →
    f (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = algebraMap C (Localization.Away h) v →
    RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
      (S := Localization.Away h) f →
    Y.map (algebraMap C (Localization.Away h)) =
      Ideal.span {algebraMap C (Localization.Away h) u, algebraMap C (Localization.Away h) v} ⊔
        ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W C)).map (algebraMap C (Localization.Away h)) →
    ¬ wcpaDjLkBad (Localization.AtPrime Y ⧸ ((IsLocalRing.maximalIdeal ↥W).map
      (algebraMap ↥W C)).map (algebraMap C (Localization.AtPrime Y))) :=
by
  intro Ω _ W C _ _ Y _ g u v h hg hh hm
  classical

  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} with hI
  intro f hfC hfu hfv hfet hY
  set Z0 : Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W)) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} with hZ0
  let F : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ Z0 :=
    (Ideal.Quotient.mk Z0).comp (MvPolynomial.map (IsLocalRing.residue ↥W))
  have hresg : IsLocalRing.residue ↥W g = 0 := (IsLocalRing.residue_eq_zero_iff g).mpr hg
  have hFI : ∀ a ∈ I, F a = 0 := by
    have hle : I ≤ RingHom.ker F := by
      rw [hI, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      show Ideal.Quotient.mk Z0 (MvPolynomial.map (IsLocalRing.residue ↥W)
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g)) = 0
      rw [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, MvPolynomial.map_C, hresg,
        map_zero, sub_zero, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    exact fun a ha => hle ha
  let π := Ideal.Quotient.lift I F hFI
  have hπmk : ∀ p, π (Ideal.Quotient.mk I p) = F p := fun p => Ideal.Quotient.lift_mk I F hFI
  have hπX : ∀ i : Fin 2, π (Ideal.Quotient.mk I (MvPolynomial.X i)) =
      Ideal.Quotient.mk Z0 (MvPolynomial.X i) := by
    intro i
    rw [hπmk]
    show Ideal.Quotient.mk Z0 (MvPolynomial.map _ (MvPolynomial.X i)) = _
    rw [MvPolynomial.map_X]
  have hπs : Function.Surjective π := by
    intro x
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨p', rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective p
    exact ⟨Ideal.Quotient.mk I p', hπmk p'⟩
  have halg : algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I) =
      (Ideal.Quotient.mk I).comp MvPolynomial.C := by
    rw [IsScalarTower.algebraMap_eq ↥W (MvPolynomial (Fin 2) ↥W), Ideal.Quotient.algebraMap_eq,
      MvPolynomial.algebraMap_eq]
  have hπker : RingHom.ker π =
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I)) := by
    have h1 : RingHom.ker F = I ⊔ (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C := by
      have hZ0' : Z0 = Ideal.map (MvPolynomial.map (IsLocalRing.residue ↥W))
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) := by
        rw [hZ0, Ideal.map_span, Set.image_singleton, map_mul, MvPolynomial.map_X,
          MvPolynomial.map_X]
      have e1 : RingHom.ker F = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C := by
        show RingHom.ker ((Ideal.Quotient.mk Z0).comp _) = _
        rw [← RingHom.comap_ker, Ideal.mk_ker, hZ0', Ideal.comap_map_of_surjective _
          (MvPolynomial.map_surjective _ IsLocalRing.residue_surjective), ← RingHom.ker_eq_comap_bot,
          MvPolynomial.ker_map, IsLocalRing.ker_residue]
      rw [e1]
      have hCg : MvPolynomial.C g ∈ (IsLocalRing.maximalIdeal ↥W).map
          (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W) := Ideal.mem_map_of_mem _ hg
      apply le_antisymm
      · refine sup_le ?_ le_sup_right
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
        have : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W) =
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) + MvPolynomial.C g := by ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span rfl))
          (Ideal.mem_sup_right hCg)
      · refine sup_le ?_ le_sup_right
        rw [hI, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
        exact Ideal.sub_mem _ (Ideal.mem_sup_left (Ideal.subset_span rfl))
          (Ideal.mem_sup_right hCg)
    have h2 : RingHom.ker (π.comp (Ideal.Quotient.mk I)) = RingHom.ker F := by
      rw [show π.comp (Ideal.Quotient.mk I) = F from RingHom.ext hπmk]
    rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      (RingHom.ker π), RingHom.comap_ker, h2, h1, Ideal.map_sup,
      (Ideal.map_eq_bot_iff_le_ker _).mpr (le_of_eq (Ideal.mk_ker).symm), bot_sup_eq,
      Ideal.map_map, halg]
  obtain ⟨E, _, fb, ρ, q, hq, hfbet, -, hρker, hfbπ, hqeq, ⟨eB⟩⟩ :=
    wcpa_dj_llsm_tg_chart_basechange W C Y h (MvPolynomial (Fin 2) ↥W ⧸ I) f
      (MvPolynomial (Fin 2) (IsLocalRing.ResidueField ↥W) ⧸ Z0) π hm hh
      (by rw [halg]; exact hfC) hfet hπs hπker
  have hfbX : ∀ i : Fin 2, fb (Ideal.Quotient.mk Z0 (MvPolynomial.X i)) =
      ρ (f (Ideal.Quotient.mk I (MvPolynomial.X i))) := by
    intro i
    rw [← hπX, hfbπ]
  have hqX : q = Ideal.span {fb (Ideal.Quotient.mk Z0 (MvPolynomial.X 0)),
      fb (Ideal.Quotient.mk Z0 (MvPolynomial.X 1))} := by
    rw [hfbX, hfbX, hfu, hfv, hqeq, hY, Ideal.map_sup,
      (Ideal.map_eq_bot_iff_le_ker ρ).mpr (le_of_eq hρker.symm), sup_bot_eq,
      Ideal.map_span, Set.image_pair]
  haveI := hq
  obtain ⟨huv0, hmB, ⟨hD1, hIC1⟩, ⟨hD2, hIC2⟩, hne1, hne2⟩ :=
    wcpa_dj_llsm_tg_etale_node_quotients (IsLocalRing.ResidueField ↥W) E fb q hfbet hqX
  obtain ⟨φ, hφ⟩ := wcpa_dj_llsm_tg_node_closure_prod _ _ _ huv0 hne1 hne2
  obtain ⟨hδ1, hbr⟩ := wcpa_dj_llsm_tg_node_delta_branches _ _ _ hmB φ hφ
  intro hbad
  apply hbad
  right
  rw [(wcpa_dj_lr1k_llfi_ringequiv _ _ eB).1, (wcpa_dj_lr1k_llfi_ringequiv _ _ eB).2]
  exact ⟨hδ1, hbr⟩

theorem wcpa_dj_llsm_brsp_node_ideal : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (L : Type u) [CommRing L] [Algebra A L] (θ : L)
    [Algebra ↥W ↥(Algebra.adjoin A {θ})],
    algebraMap ↥W ↥(Algebra.adjoin A {θ}) =
      (algebraMap A ↥(Algebra.adjoin A {θ})).comp (algebraMap ↥W A) →
    ∀ (Y : Ideal ↥(Algebra.adjoin A {θ})) (𝔭 : Ideal A) (u v c : A) (e h : ↥(Algebra.adjoin A {θ})),
    (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) ∈ Y →
    Y.comap (algebraMap A ↥(Algebra.adjoin A {θ})) = 𝔭 →
    𝔭 = Ideal.span {u, v} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) →
    (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) * e =
      algebraMap A ↥(Algebra.adjoin A {θ}) c →
    e ∣ h →
    Y.map (algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)) =
      Ideal.span {algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)
          (algebraMap A ↥(Algebra.adjoin A {θ}) u),
        algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)
          (algebraMap A ↥(Algebra.adjoin A {θ}) v)} ⊔
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥(Algebra.adjoin A {θ}))).map
        (algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)) :=
by
  intro Ω _ W A _ _ L _ _ θ _ hcomp Y 𝔭 u v c e h hθ hY h𝔭 he hdiv
  have hRHS : Ideal.span {algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)
          (algebraMap A ↥(Algebra.adjoin A {θ}) u),
        algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)
          (algebraMap A ↥(Algebra.adjoin A {θ}) v)} ⊔
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥(Algebra.adjoin A {θ}))).map
        (algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)) =
      (𝔭.map (algebraMap A ↥(Algebra.adjoin A {θ}))).map
        (algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)) := by
    rw [h𝔭, Ideal.map_sup, Ideal.map_sup, Ideal.map_span, Ideal.map_span, Set.image_pair,
      Set.image_pair, Ideal.map_map (algebraMap ↥W A) (algebraMap A ↥(Algebra.adjoin A {θ})),
      ← hcomp]
  rw [hRHS]
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro y hy
    rw [Ideal.mem_comap]
    have hc : c ∈ 𝔭 := by
      rw [← hY, Ideal.mem_comap, ← he]
      exact Y.mul_mem_right e hθ
    have hθM : algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) ∈
        (𝔭.map (algebraMap A ↥(Algebra.adjoin A {θ}))).map
          (algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)) := by
      obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp
        (IsLocalization.Away.isUnit_of_dvd h hdiv :
          IsUnit (algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h) e))
      have h1 : algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) =
          algebraMap ↥(Algebra.adjoin A {θ}) (Localization.Away h)
            (algebraMap A ↥(Algebra.adjoin A {θ}) c) * w := by
        rw [← he, map_mul, mul_assoc, hw, mul_one]
      rw [h1]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hc))
    obtain ⟨p, hp⟩ : (y : L) ∈ (Polynomial.aeval θ : Polynomial A →ₐ[A] L).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact y.2
    have hy' : y = Polynomial.aeval
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) p := by
      apply Subtype.ext
      rw [Polynomial.aeval_subalgebra_coe]
      exact hp.symm
    have hdec : y = Polynomial.aeval
        (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) p.divX *
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) +
        algebraMap A ↥(Algebra.adjoin A {θ}) (p.coeff 0) := by
      conv_lhs => rw [hy', ← Polynomial.divX_mul_X_add p]
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
    have hconst : algebraMap A ↥(Algebra.adjoin A {θ}) (p.coeff 0) ∈ Y := by
      have e1 : algebraMap A ↥(Algebra.adjoin A {θ}) (p.coeff 0) = y - Polynomial.aeval
          (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) p.divX *
            (⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩ : ↥(Algebra.adjoin A {θ})) := by
        rw [hdec]; ring
      rw [e1]
      exact Y.sub_mem hy (Y.mul_mem_left _ hθ)
    have hp0 : p.coeff 0 ∈ 𝔭 := by
      rw [← hY]
      exact hconst
    rw [hdec, map_add, map_mul]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hθM)
      (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hp0))
  · apply Ideal.map_mono
    rw [← hY]
    exact Ideal.map_comap_le

theorem wcpa_dj_llsm_br_split_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W)
    (y : Ideal ↥(integralClosure A L)),
    wcLlsPD W A 𝔭 (.ann u v g) → y.IsPrime →
    y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsDec A K L y = ⊥ →
    ∀ (_ : y.IsPrime),
      ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g y hPD hyp hyc hdec hyp'
  classical
  obtain ⟨-, -, hic, hmax, hm𝔭, hg, hg0, huv, h𝔭eq, h₀, hh₀, f₀, hfC, hfu, hfv, hfet⟩ := hPD
  haveI := hic
  haveI := hyp

  have hymax : y.IsMaximal :=
    Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A ↥(integralClosure A L))
      (algebraMap_isIntegral_iff.mpr inferInstance) y (by rw [hyc]; exact hmax)

  obtain ⟨θ', hθy, hP⟩ := wcpa_dj_llsm_brsp_crt_element A K L y hymax hdec
  have hθint : IsIntegral A (θ' : L) := θ'.2

  have hstab : ∀ σ : L ≃ₐ[K] L, σ (θ' : L) = (θ' : L) → σ = 1 := by
    intro σ hσ
    by_contra hne
    have h1 := hP σ hne θ' hσ.symm
    apply hyp.ne_top
    rw [Ideal.eq_top_iff_one]
    have e1 : (1 : ↥(integralClosure A L)) = θ' - (θ' - 1) := by ring
    rw [e1]
    exact y.sub_mem hθy h1

  obtain ⟨hKθ, hderiv⟩ := wcpa_dj_llsm_brsp_primitive_deriv A K L (θ' : L) hθint hstab

  have hle : Algebra.adjoin A {(θ' : L)} ≤ integralClosure A L :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr θ'.2)
  letI : Algebra ↥W ↥(Algebra.adjoin A {(θ' : L)}) :=
    ((algebraMap A ↥(Algebra.adjoin A {(θ' : L)})).comp (algebraMap ↥W A)).toAlgebra
  have hθC : Subalgebra.inclusion hle
      (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)})) = θ' :=
    Subtype.ext rfl
  have hθCY : (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)}))
      ∈ y.comap (Subalgebra.inclusion hle) := by
    rw [Ideal.mem_comap, hθC]; exact hθy
  set d : ↥(Algebra.adjoin A {(θ' : L)}) :=
    Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (Polynomial.derivative (minpoly A (θ' : L))) with hd
  set e : ↥(Algebra.adjoin A {(θ' : L)}) :=
    Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (Polynomial.divX (minpoly A (θ' : L))) with he
  have hdL : (d : L) = Polynomial.aeval (θ' : L) (Polynomial.derivative (minpoly A (θ' : L))) :=
    Polynomial.aeval_subalgebra_coe _ _ _

  have hdy : Subalgebra.inclusion hle d ∉ y := by
    apply wcpa_dj_llsm_brsp_deriv_unit A K L y hyp θ' hθy hP
    rw [Subalgebra.coe_inclusion, hdL]
    exact hderiv
  have hdY : d ∉ y.comap (Subalgebra.inclusion hle) := by
    rw [Ideal.mem_comap]; exact hdy

  have hcond : ∀ x : ↥(integralClosure A L), (d : L) * (x : L) ∈ Algebra.adjoin A {(θ' : L)} := by
    intro x
    rw [hdL]
    exact wcpa_dj_llsm_brsp_conductor A K L (θ' : L) hθint hKθ x x.2
  obtain ⟨eFS⟩ := wcpa_dj_llsm_brsp_fs_transport W A L (Algebra.adjoin A {(θ' : L)}) hle rfl d
    hcond y hdy

  have h0 : Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (minpoly A (θ' : L)) = 0 := by
    apply Subtype.ext
    rw [Polynomial.aeval_subalgebra_coe]
    simp [minpoly.aeval]
  have hsplit := Polynomial.divX_mul_X_add (minpoly A (θ' : L))
  have h1 : (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)})) * e
      = algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) (-(minpoly A (θ' : L)).coeff 0) := by
    have h2 : Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
        ↥(Algebra.adjoin A {(θ' : L)})) ((minpoly A (θ' : L)).divX * Polynomial.X +
          Polynomial.C ((minpoly A (θ' : L)).coeff 0)) = 0 := by
      rw [hsplit]; exact h0
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, ← he] at h2
    rw [map_neg, eq_neg_iff_add_eq_zero, mul_comm]
    exact h2
  have h3 : d = Polynomial.aeval (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ :
      ↥(Algebra.adjoin A {(θ' : L)})) (Polynomial.derivative (minpoly A (θ' : L)).divX) *
        (⟨(θ' : L), Algebra.self_mem_adjoin_singleton A _⟩ : ↥(Algebra.adjoin A {(θ' : L)})) + e := by
    have h4 : Polynomial.derivative (minpoly A (θ' : L)) =
        Polynomial.derivative ((minpoly A (θ' : L)).divX * Polynomial.X +
          Polynomial.C ((minpoly A (θ' : L)).coeff 0)) := by rw [hsplit]
    rw [hd, he, h4, Polynomial.derivative_add, Polynomial.derivative_mul, Polynomial.derivative_X,
      Polynomial.derivative_C, mul_one, add_zero, map_add, map_mul, Polynomial.aeval_X]
  have heY : e ∉ y.comap (Subalgebra.inclusion hle) := by
    intro heY
    apply hdY
    rw [h3]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hθCY) heY

  have hYc : (y.comap (Subalgebra.inclusion hle)).comap
      (algebraMap A ↥(Algebra.adjoin A {(θ' : L)})) = 𝔭 := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes, ← hyc, Ideal.mem_comap]
  have hhY : algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ ∉ y.comap (Subalgebra.inclusion hle) := by
    intro hh
    apply hh₀
    rw [← hYc, Ideal.mem_comap]
    exact hh

  have hzY : algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e) ∉
      y.comap (Subalgebra.inclusion hle) := by
    intro hz
    rcases Ideal.IsPrime.mem_or_mem inferInstance hz with h | h
    · exact hhY h
    · rcases Ideal.IsPrime.mem_or_mem inferInstance h with h' | h'
      · exact hdY h'
      · exact heY h'

  have hinj : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hEt := wcpa_dj_llsm_brsp_standard_etale A L hinj (θ' : L) hθint
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e))
    ⟨algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * e, by rw [← hd]; ring⟩
  obtain ⟨φ, hφ, hφet⟩ := wcpa_dj_llsm_brsp_chart_compose A ↥(Algebra.adjoin A {(θ' : L)})
    (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g})
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)})) h₀ (d * e) f₀ hfet hEt

  have hnode := wcpa_dj_llsm_brsp_node_ideal W A L (θ' : L) rfl
    (y.comap (Subalgebra.inclusion hle)) 𝔭 u v (-(minpoly A (θ' : L)).coeff 0) e
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e)) hθCY hYc h𝔭eq h1
    ⟨algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * d, by ring⟩

  have hmC : (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥(Algebra.adjoin A {(θ' : L)})) ≤
      y.comap (Subalgebra.inclusion hle) := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    rw [Ideal.mem_comap]
    show algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) (algebraMap ↥W A w) ∈
      y.comap (Subalgebra.inclusion hle)
    rw [← Ideal.mem_comap, hYc]
    exact hm𝔭 (Ideal.mem_map_of_mem _ hw)
  have hnb := wcpa_dj_llsm_brsp_node_not_bad W ↥(Algebra.adjoin A {(θ' : L)})
    (y.comap (Subalgebra.inclusion hle)) g (algebraMap A _ u) (algebraMap A _ v)
    (algebraMap A ↥(Algebra.adjoin A {(θ' : L)}) h₀ * (d * e)) hg hzY hmC (φ.comp f₀)
    (by rw [RingHom.comp_assoc, hfC, ← RingHom.comp_assoc, hφ, RingHom.comp_assoc]; rfl)
    (by show φ (f₀ _) = _; rw [hfu]; exact RingHom.congr_fun hφ u)
    (by show φ (f₀ _) = _; rw [hfv]; exact RingHom.congr_fun hφ v)
    hφet hnode

  obtain ⟨hδ, hbr⟩ := wcpa_dj_lr1k_llfi_ringequiv
    (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)
    (Localization.AtPrime (y.comap (Subalgebra.inclusion hle)) ⧸
      ((IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↥(Algebra.adjoin A {(θ' : L)}))).map
        (algebraMap ↥(Algebra.adjoin A {(θ' : L)})
          (Localization.AtPrime (y.comap (Subalgebra.inclusion hle))))) eFS
  intro hbad
  apply hnb
  unfold wcpaDjLkBad at hbad ⊢
  rw [← hδ, ← hbr]
  exact hbad

theorem wcpa_dj_llsm_br_ann_node_sep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (u v : A) (g : ↥W),
    wcLlsPD W A 𝔭 (.ann u v g) →
    (∀ y : Ideal ↥(integralClosure A L), y.IsPrime →
      y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → ∀ (_ : y.IsPrime),
      ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y)) →
    wcLlsAnnSep W A K L u g :=
by
  intro Ω _ _ W _hW _hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 u v g hPD hall
  classical

  have RE : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
    intro R S _ _ e
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) = algebraMap S (FractionRing S) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
        algebraMap R (FractionRing R) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
        (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
        (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
    have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S →+* R) (eF.symm : FractionRing S →+* FractionRing R) C2
    let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
    have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) := fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    constructor
    · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
      letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
      let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
          ↥(integralClosure S (FractionRing S)) :=
        { toFun := eI
          map_add' := map_add eI
          map_smul' := fun r a => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
            rfl }
      let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
          ↥(integralClosure R (FractionRing R)) :=
        { toFun := eI.symm
          map_add' := map_add eI.symm
          map_smul' := fun s b => by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
            rfl }
      let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
      let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
      have h1 : p ≤ q.comap LeI := by
        rintro _ ⟨r, rfl⟩
        exact ⟨e r, (heI r).symm⟩
      have h2 : q ≤ p.comap LeI' := by
        rintro _ ⟨s, rfl⟩
        exact ⟨e.symm s, (heI' s).symm⟩
      let Φ := p.mapQ q LeI h1
      let Φ' := q.mapQ p LeI' h2
      let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
          (↥(integralClosure S (FractionRing S)) ⧸ q) :=
        { Φ with
          invFun := Φ'
          left_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H a =>
              show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.symm_apply_apply a)
          right_inv := fun x => by
            induction x using Submodule.Quotient.induction_on with
            | H b =>
              show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
              rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
              exact congrArg _ (eI.apply_symm_apply b) }
      let O := Submodule.orderIsoMapComap Φe
      unfold wcpaDjLkDelta
      rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
        OrderIso.map_top]
    · unfold wcpaDjLkBranches
      apply ENat.card_congr
      exact
        { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
            haveI := M.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
          invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
            haveI := N.isMaximal
            exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
          left_inv := fun M => by
            ext x
            show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
            rw [RingEquiv.symm_apply_apply]
          right_inv := fun N => by
            ext x
            show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
            rw [RingEquiv.apply_symm_apply] }

  have FSeq : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] [Algebra R₁ L] [Algebra R₂ L]
      (w₁ w₂ : ↥W →+* L), (∀ w : ↥W, w₁ w = w₂ w) →
      ∀ (ψ : ↥(integralClosure R₁ L) ≃+* ↥(integralClosure R₂ L)),
      (∀ x : ↥(integralClosure R₁ L), ((ψ x : ↥(integralClosure R₂ L)) : L) = (x : L)) →
      ∀ (y₁ : Ideal ↥(integralClosure R₁ L)) [y₁.IsPrime]
        (y₂ : Ideal ↥(integralClosure R₂ L)) [y₂.IsPrime],
      y₁ = Ideal.comap ψ y₂ → Nonempty (wcLlsFS W w₁ R₁ y₁ ≃+* wcLlsFS W w₂ R₂ y₂) := by
    intro R₁ R₂ _ _ _ _ w₁ w₂ hw ψ hψ y₁ _ y₂ _ hy12
    have hmem : ∀ x, x ∈ y₁ ↔ ψ x ∈ y₂ := by
      intro x
      rw [hy12, Ideal.mem_comap]
    have hsub : Submonoid.map ψ.toMonoidHom y₁.primeCompl = y₂.primeCompl := by
      ext z
      simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
      constructor
      · rintro ⟨x, hx, rfl⟩ h
        exact hx ((hmem x).mpr h)
      · intro hz
        refine ⟨ψ.symm z, fun h => hz ?_, ψ.apply_symm_apply z⟩
        have h1 := (hmem _).mp h
        rwa [ψ.apply_symm_apply] at h1
    let Φ : Localization.AtPrime y₁ ≃+* Localization.AtPrime y₂ :=
      IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime y₁) (Localization.AtPrime y₂) ψ hsub
    have hΦ : ∀ x, Φ (algebraMap _ (Localization.AtPrime y₁) x) =
        algebraMap _ (Localization.AtPrime y₂) (ψ x) := fun x =>
      IsLocalization.ringEquivOfRingEquiv_eq hsub x
    have hcomm : (algebraMap ↥(integralClosure R₂ L) (Localization.AtPrime y₂)).comp
          (ψ : ↥(integralClosure R₁ L) →+* ↥(integralClosure R₂ L)) =
        (Φ : Localization.AtPrime y₁ →+* Localization.AtPrime y₂).comp
          (algebraMap ↥(integralClosure R₁ L) (Localization.AtPrime y₁)) :=
      RingHom.ext fun x => (hΦ x).symm
    have hgen : (ψ : ↥(integralClosure R₁ L) →+* ↥(integralClosure R₂ L)) ''
          {b : ↥(integralClosure R₁ L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₁ w} =
        {b : ↥(integralClosure R₂ L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₂ w} := by
      ext z
      constructor
      · rintro ⟨b, ⟨w, hw1, hw2⟩, rfl⟩
        exact ⟨w, hw1, (hψ b).trans (hw2.trans (hw w))⟩
      · rintro ⟨w, hw1, hw2⟩
        refine ⟨ψ.symm z, ⟨w, hw1, ?_⟩, ψ.apply_symm_apply z⟩
        have h1 := hψ (ψ.symm z)
        rw [ψ.apply_symm_apply] at h1
        exact h1.symm.trans (hw2.trans (hw w).symm)
    show Nonempty ((Localization.AtPrime y₁ ⧸
        (Ideal.span {b : ↥(integralClosure R₁ L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₁ w}).map
          (algebraMap ↥(integralClosure R₁ L) (Localization.AtPrime y₁))) ≃+*
      (Localization.AtPrime y₂ ⧸
        (Ideal.span {b : ↥(integralClosure R₂ L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = w₂ w}).map
          (algebraMap ↥(integralClosure R₂ L) (Localization.AtPrime y₂))))
    refine ⟨Ideal.quotientEquiv _ _ Φ ?_⟩
    rw [← hgen, ← Ideal.map_span, Ideal.map_map, hcomm, ← Ideal.map_map]

  obtain ⟨_, hnzd, _, _, _, hgm, hg0, huv, h𝔭, _⟩ := hPD
  haveI := hnzd
  have hag : algebraMap ↥W A g ≠ 0 := by
    intro h
    rw [Algebra.algebraMap_eq_smul_one] at h
    rcases smul_eq_zero.mp h with h1 | h1
    · exact hg0 h1
    · exact one_ne_zero h1
  have hu : u ≠ 0 := fun h => hag (by rw [← huv, h, zero_mul])
  have hKu : algebraMap A K u ≠ 0 := fun h =>
    hu (IsFractionRing.injective A K (h.trans (map_zero _).symm))
  have hv0 : algebraMap A K v = algebraMap A K (algebraMap ↥W A g) / algebraMap A K u := by
    rw [← huv, map_mul, mul_div_cancel_left₀ _ hKu]
  have hw : ∀ w : ↥W, ((algebraMap A L).comp (algebraMap ↥W A)) w =
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := fun w => by
    simp only [RingHom.comp_apply]
    exact IsScalarTower.algebraMap_apply A K L _
  suffices H : ∀ s : K, algebraMap A K v = s → wcLlsSepAt W A K L u s from H _ hv0
  intro s hv
  unfold wcLlsSepAt
  intro 𝔮 h𝔮P h𝔮

  have hSbot : Algebra.adjoin A {s} ≤ ⊥ :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr (Algebra.mem_bot.mpr ⟨v, hv⟩))
  have hρsurj : Function.Surjective (algebraMap A ↥(Algebra.adjoin A {s})) := by
    intro r
    obtain ⟨a, ha⟩ := Algebra.mem_bot.mp (hSbot r.2)
    exact ⟨a, Subtype.ext ha⟩
  have hρinj : Function.Injective (algebraMap A ↥(Algebra.adjoin A {s})) := by
    intro a b h
    exact IsFractionRing.injective A K (congrArg Subtype.val h)
  have hval : ∀ a : A, algebraMap ↥(Algebra.adjoin A {s}) L (algebraMap A ↥(Algebra.adjoin A {s}) a) =
      algebraMap A L a := by
    intro a
    rw [IsScalarTower.algebraMap_apply A K L a]
    rfl
  letI : IsScalarTower A ↥(Algebra.adjoin A {s}) L :=
    IsScalarTower.of_algebraMap_eq (fun a => (hval a).symm)
  haveI : Algebra.IsIntegral A ↥(Algebra.adjoin A {s}) := ⟨fun r => by
    obtain ⟨a, rfl⟩ := hρsurj r
    exact isIntegral_algebraMap⟩

  let ψ : ↥(integralClosure A L) ≃+* ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
    { toFun := fun x => ⟨x.1, show _root_.IsIntegral ↥(Algebra.adjoin A {s}) x.1 from
        (show _root_.IsIntegral A x.1 from x.2).tower_top⟩
      invFun := fun z => ⟨z.1, show _root_.IsIntegral A z.1 from
        isIntegral_trans z.1 (show _root_.IsIntegral ↥(Algebra.adjoin A {s}) z.1 from z.2)⟩
      left_inv := fun x => rfl
      right_inv := fun z => rfl
      map_mul' := fun x y => rfl
      map_add' := fun x y => rfl }
  have hψ : ∀ x : ↥(integralClosure A L),
      ((ψ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) : L) = (x : L) := fun x => rfl
  have hsq : ∀ a : A, ψ (algebraMap A ↥(integralClosure A L) a) =
      algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
        (algebraMap A ↥(Algebra.adjoin A {s}) a) := by
    intro a
    apply Subtype.ext
    exact (hval a).symm

  have hsv : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) =
      algebraMap A ↥(Algebra.adjoin A {s}) v := Subtype.ext hv.symm
  have hN : Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) u,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩} ⊔
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) =
      𝔭.map (algebraMap A ↥(Algebra.adjoin A {s})) := by
    rw [hsv, h𝔭, Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map]
  have hcomap : (Ideal.comap ψ 𝔮).comap (algebraMap A ↥(integralClosure A L)) = 𝔭 := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, hsq, ← Ideal.mem_comap, h𝔮, hN, ← Ideal.mem_comap,
      Ideal.comap_map_of_bijective _ ⟨hρinj, hρsurj⟩]

  haveI hy'P : (Ideal.comap ψ 𝔮).IsPrime := Ideal.comap_isPrime ψ 𝔮
  have h0 := hall (Ideal.comap ψ 𝔮) hy'P hcomap hy'P
  obtain ⟨e⟩ := FSeq A ↥(Algebra.adjoin A {s}) _ _ hw ψ hψ (Ideal.comap ψ 𝔮) 𝔮 rfl
  obtain ⟨hD, hB⟩ := RE _ _ e
  unfold wcpaDjLkBad at h0 ⊢
  rw [hD, hB] at h0
  exact h0

theorem wcpa_dj_llsm_bcc_loc_sep : ∀ {Ω : Type u} [Field Ω] (W : ValuationSubring Ω) (K : Type u) [Field K]
    (L : Type u) [Field L] [Algebra K L] (wL₁ wL₂ : ↥W →+* L) (R₁ R₂ : Type u) [CommRing R₁]
    [CommRing R₂] [Algebra R₁ K] [Algebra R₂ K] [Algebra R₁ L] [Algebra R₂ L],
    algebraMap R₁ L = (algebraMap K L).comp (algebraMap R₁ K) →
    algebraMap R₂ L = (algebraMap K L).comp (algebraMap R₂ K) →
    Function.Injective (algebraMap R₁ K) → Function.Injective (algebraMap R₂ K) →
    ∀ (ι : R₁ →+* R₂), (∀ x : R₁, algebraMap R₂ K (ι x) = algebraMap R₁ K x) →
    ∀ (h : R₁), (∃ y : R₂, algebraMap R₂ K y * algebraMap R₁ K h = 1) →
    (∀ y : R₂, ∃ (n : ℕ) (x : R₁), algebraMap R₁ K x = algebraMap R₂ K y * algebraMap R₁ K h ^ n) →
    ∀ (N₁ : Ideal R₁) (N₂ : Ideal R₂), N₂ = N₁.map ι → (∀ x : R₁, x * h ∈ N₁ → x ∈ N₁) →
    (∀ w : ↥W, wL₁ w = wL₂ w) →
    (∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ x : R₁, algebraMap R₁ L x = wL₁ w) →
    ((∀ (𝔮₁ : Ideal ↥(integralClosure R₁ L)) [𝔮₁.IsPrime],
        𝔮₁.comap (algebraMap R₁ ↥(integralClosure R₁ L)) = N₁ →
        ¬ wcpaDjLkBad (wcLlsFS W wL₁ R₁ 𝔮₁)) ↔
      (∀ (𝔮₂ : Ideal ↥(integralClosure R₂ L)) [𝔮₂.IsPrime],
        𝔮₂.comap (algebraMap R₂ ↥(integralClosure R₂ L)) = N₂ →
        ¬ wcpaDjLkBad (wcLlsFS W wL₂ R₂ 𝔮₂))) :=
by
  intro Ω _ W K _ L _ _ wL₁ wL₂ R₁ R₂ _ _ _ _ _ _ hL₁ hL₂ hα₁ hα₂ ι hι h hy₀ hloc N₁ N₂ hN hsat
    hw hwR
  classical


  have hRE : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      (wcpaDjLkBad R ↔ wcpaDjLkBad S) := by
    intro R S _ _ e
    have key : wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S := by
      let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
      have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) = algebraMap S (FractionRing S) (e r) :=
        fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
      have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
          algebraMap R (FractionRing R) (e.symm s) := by
        intro s
        rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
      have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
          (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
        ext r
        simp only [RingHom.comp_apply, RingHom.coe_coe]
        exact (H1 r).symm
      have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
          (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
        ext s
        simp only [RingHom.comp_apply, RingHom.coe_coe]
        exact (H2 s).symm
      have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) :=
        fun x hx => hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
      have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) :=
        fun y hy => hy.map_of_comp_eq (e.symm : S →+* R)
          (eF.symm : FractionRing S →+* FractionRing R) C2
      let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
        { toFun := fun x => ⟨eF x, I1 x x.2⟩
          invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
          left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
          right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
          map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
          map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
      have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) :=
        fun r => Subtype.ext (H1 r)
      have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
        intro s
        rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
      constructor
      · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
        letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
        let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
            ↥(integralClosure S (FractionRing S)) :=
          { toFun := eI
            map_add' := map_add eI
            map_smul' := fun r a => by
              rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
              rfl }
        let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
            ↥(integralClosure R (FractionRing R)) :=
          { toFun := eI.symm
            map_add' := map_add eI.symm
            map_smul' := fun s b => by
              rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
              rfl }
        let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
        let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
        have h1 : p ≤ q.comap LeI := by
          rintro _ ⟨r, rfl⟩
          exact ⟨e r, (heI r).symm⟩
        have h2 : q ≤ p.comap LeI' := by
          rintro _ ⟨s, rfl⟩
          exact ⟨e.symm s, (heI' s).symm⟩
        let Φ := p.mapQ q LeI h1
        let Φ' := q.mapQ p LeI' h2
        let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
            (↥(integralClosure S (FractionRing S)) ⧸ q) :=
          { Φ with
            invFun := Φ'
            left_inv := fun x => by
              induction x using Submodule.Quotient.induction_on with
              | H a =>
                show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
                rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
                exact congrArg _ (eI.symm_apply_apply a)
            right_inv := fun x => by
              induction x using Submodule.Quotient.induction_on with
              | H b =>
                show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
                rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
                exact congrArg _ (eI.apply_symm_apply b) }
        let O := Submodule.orderIsoMapComap Φe
        unfold wcpaDjLkDelta
        rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
          OrderIso.map_top]
      · unfold wcpaDjLkBranches
        apply ENat.card_congr
        exact
          { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
              haveI := M.isMaximal
              exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
            invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
              haveI := N.isMaximal
              exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
            left_inv := fun M => by
              ext x
              show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
              rw [RingEquiv.symm_apply_apply]
            right_inv := fun N => by
              ext x
              show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
              rw [RingEquiv.apply_symm_apply] }
    unfold wcpaDjLkBad
    rw [key.1, key.2]

  have hcomp : (algebraMap R₂ L).comp ι = algebraMap R₁ L := by
    ext x
    rw [RingHom.comp_apply, hL₂, hL₁, RingHom.comp_apply, RingHom.comp_apply, hι]
  have hιinj : Function.Injective ι := fun x x' hxx => hα₁ (by rw [← hι, ← hι x', hxx])
  obtain ⟨y₀, hy₀⟩ := hy₀
  have hu : y₀ * ι h = 1 := hα₂ (by rw [map_mul, hι, hy₀, map_one])
  have hs : ∀ y : R₂, ∃ (n : ℕ) (x : R₁), ι x = y * ι h ^ n := by
    intro y
    obtain ⟨n, x, hx⟩ := hloc y
    exact ⟨n, x, hα₂ (by rw [hι, hx, map_mul, map_pow, hι])⟩
  letI : Algebra R₁ R₂ := ι.toAlgebra
  haveI : IsScalarTower R₁ R₂ L := IsScalarTower.of_algebraMap_eq' hcomp.symm
  haveI hlocR : IsLocalization.Away h R₂ := IsLocalization.Away.mk h
    (isUnit_iff_exists_inv.mpr ⟨y₀, by rw [mul_comm]; exact hu⟩)
    (fun s => by
      obtain ⟨n, x, hx⟩ := hs s
      exact ⟨n, x, hx.symm⟩)
    (fun a b hab => ⟨0, by rw [hιinj hab]⟩)

  have hscale : ∀ b : L, IsIntegral R₂ b → ∃ n : ℕ, IsIntegral R₁ (algebraMap R₁ L h ^ n * b) := by
    intro b hb
    obtain ⟨⟨m, hm⟩, hmb⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers h) b hb
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
    refine ⟨n, ?_⟩
    have e1 : (⟨h ^ n, hm⟩ : Submonoid.powers h) • b = algebraMap R₁ L h ^ n * b := by
      rw [Submonoid.smul_def, Algebra.smul_def, map_pow]
    rw [e1] at hmb
    exact hmb

  let j : ↥(integralClosure R₁ L) →+* ↥(integralClosure R₂ L) :=
    { toFun := fun x => ⟨(x : L), IsIntegral.map_of_comp_eq ι (RingHom.id L)
        (by rw [hcomp, RingHom.id_comp]) x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hjinj : Function.Injective j := fun a b hab =>
    Subtype.ext (congrArg (fun x : ↥(integralClosure R₂ L) => (x : L)) hab)
  have hjβ : ∀ x : R₁, j (algebraMap R₁ ↥(integralClosure R₁ L) x) =
      algebraMap R₂ ↥(integralClosure R₂ L) (ι x) := fun x => Subtype.ext (by
    show algebraMap R₁ L x = algebraMap R₂ L (ι x)
    rw [← hcomp]
    rfl)
  letI : Algebra ↥(integralClosure R₁ L) ↥(integralClosure R₂ L) := j.toAlgebra
  have hjβ' : (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L)).comp
      (algebraMap R₁ ↥(integralClosure R₁ L)) = (algebraMap R₂ ↥(integralClosure R₂ L)).comp ι :=
    RingHom.ext hjβ
  haveI hlocB : IsLocalization.Away (algebraMap R₁ ↥(integralClosure R₁ L) h)
      ↥(integralClosure R₂ L) := IsLocalization.Away.mk _
    (isUnit_iff_exists_inv.mpr ⟨algebraMap R₂ _ y₀, by
      show j _ * _ = 1
      rw [hjβ, ← map_mul, mul_comm, hu, map_one]⟩)
    (fun s => by
      obtain ⟨n, hn⟩ := hscale (s : L) s.2
      refine ⟨n, ⟨algebraMap R₁ L h ^ n * s, hn⟩, Subtype.ext ?_⟩
      show (s : L) * ((j (algebraMap R₁ ↥(integralClosure R₁ L) h) ^ n :
        ↥(integralClosure R₂ L)) : L) = algebraMap R₁ L h ^ n * s
      rw [SubmonoidClass.coe_pow]
      show (s : L) * (algebraMap R₁ L h) ^ n = _
      ring)
    (fun a b hab => ⟨0, by rw [hjinj hab]⟩)

  have hsatn : ∀ (n : ℕ) (x : R₁), x * h ^ n ∈ N₁ → x ∈ N₁ := by
    intro n
    induction n with
    | zero => intro x hx; simpa using hx
    | succ n ih =>
      intro x hx
      apply ih
      apply hsat
      rw [mul_assoc, ← pow_succ]
      exact hx
  have hmapN : (N₁.map ι).comap ι = N₁ := by
    refine le_antisymm ?_ Ideal.le_comap_map
    intro a ha
    rw [Ideal.mem_comap] at ha
    obtain ⟨⟨⟨i, hi⟩, ⟨m, hm⟩⟩, he⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers h) R₂).mp ha
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
    apply hsatn n
    have e1 : a * h ^ n = i := hιinj (by rw [map_mul]; exact he)
    rw [e1]
    exact hi
  have hβh : ∀ 𝔮₁ : Ideal ↥(integralClosure R₁ L), 𝔮₁.IsPrime →
      𝔮₁.comap (algebraMap R₁ ↥(integralClosure R₁ L)) = N₁ →
      algebraMap R₁ ↥(integralClosure R₁ L) h ∉ 𝔮₁ := by
    intro 𝔮₁ hp hc hmem
    apply hp.ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : R₁) ∈ N₁ := hsat 1 (by rw [one_mul, ← hc, Ideal.mem_comap]; exact hmem)
    rw [← hc, Ideal.mem_comap, map_one] at h1
    exact h1

  have hS : {b : ↥(integralClosure R₂ L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL₂ w} =
      (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L)) ''
        {b : ↥(integralClosure R₁ L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL₁ w} := by
    ext b
    constructor
    · rintro ⟨w, hwm, hb⟩
      obtain ⟨x, hx⟩ := hwR w hwm
      refine ⟨algebraMap R₁ _ x, ⟨w, hwm, hx⟩, Subtype.ext ?_⟩
      show algebraMap R₁ L x = (b : L)
      rw [hx, hb, hw]
    · rintro ⟨a, ⟨w, hwm, ha⟩, rfl⟩
      exact ⟨w, hwm, by show (a : L) = wL₂ w; rw [ha, hw]⟩
  have hfib : ∀ (𝔮₁ : Ideal ↥(integralClosure R₁ L)) [𝔮₁.IsPrime]
      (𝔮₂ : Ideal ↥(integralClosure R₂ L)) [𝔮₂.IsPrime],
      𝔮₂.comap (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L)) = 𝔮₁ →
      (wcpaDjLkBad (wcLlsFS W wL₁ R₁ 𝔮₁) ↔ wcpaDjLkBad (wcLlsFS W wL₂ R₂ 𝔮₂)) := by
    intro 𝔮₁ _ 𝔮₂ _ hq
    subst hq
    haveI : IsLocalization.AtPrime (Localization.AtPrime 𝔮₂)
        (𝔮₂.comap (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))) :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Submonoid.powers (algebraMap R₁ ↥(integralClosure R₁ L) h)) (Localization.AtPrime 𝔮₂) 𝔮₂
    let e := IsLocalization.algEquiv
      (𝔮₂.comap (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))).primeCompl
      (Localization.AtPrime
        (𝔮₂.comap (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))))
      (Localization.AtPrime 𝔮₂)
    have hJ : Ideal.map (algebraMap ↥(integralClosure R₂ L) (Localization.AtPrime 𝔮₂))
        (Ideal.span {b : ↥(integralClosure R₂ L) |
          ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL₂ w}) =
        Ideal.map (e.toRingEquiv : _ →+* _)
          (Ideal.map (algebraMap ↥(integralClosure R₁ L) (Localization.AtPrime
            (𝔮₂.comap (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L)))))
            (Ideal.span {b : ↥(integralClosure R₁ L) |
              ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL₁ w})) := by
      rw [hS, ← Ideal.map_span, Ideal.map_map, Ideal.map_map]
      congr 1
      apply RingHom.ext
      intro b
      rw [RingHom.comp_apply, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply]
      exact (e.commutes b).symm
    have eq : wcLlsFS W wL₁ R₁
        (𝔮₂.comap (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))) ≃+*
        wcLlsFS W wL₂ R₂ 𝔮₂ :=
      Ideal.quotientEquiv _ _ e.toRingEquiv hJ
    exact hRE _ _ eq

  constructor
  · intro H₁ 𝔮₂ _ hc₂ hbad
    have hc₁ : (𝔮₂.comap (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))).comap
        (algebraMap R₁ ↥(integralClosure R₁ L)) = N₁ := by
      rw [Ideal.comap_comap, hjβ', ← Ideal.comap_comap, hc₂, hN, hmapN]
    exact H₁ _ hc₁ ((hfib _ 𝔮₂ rfl).mpr hbad)
  · intro H₂ 𝔮₁ _ hc₁ hbad
    have hh : algebraMap R₁ ↥(integralClosure R₁ L) h ∉ 𝔮₁ := hβh 𝔮₁ inferInstance hc₁
    have hdisj : Disjoint (Submonoid.powers (algebraMap R₁ ↥(integralClosure R₁ L) h) :
        Set ↥(integralClosure R₁ L)) (𝔮₁ : Set ↥(integralClosure R₁ L)) :=
      (Ideal.disjoint_powers_iff_notMem _ (Ideal.IsPrime.isRadical inferInstance)).mpr hh
    haveI hp₂ : (𝔮₁.map (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers _) _ 𝔮₁ inferInstance hdisj
    have hq : (𝔮₁.map (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))).comap
        (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L)) = 𝔮₁ :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers _) _ inferInstance hdisj
    have hunder : Ideal.under R₁ ((𝔮₁.map (algebraMap ↥(integralClosure R₁ L)
        ↥(integralClosure R₂ L))).comap (algebraMap R₂ ↥(integralClosure R₂ L))) = N₁ := by
      unfold Ideal.under
      rw [Ideal.comap_comap]
      show Ideal.comap ((algebraMap R₂ ↥(integralClosure R₂ L)).comp ι) _ = N₁
      rw [← hjβ', ← Ideal.comap_comap, hq, hc₁]
    have hP : (𝔮₁.map (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))).comap
        (algebraMap R₂ ↥(integralClosure R₂ L)) = N₂ := by
      have e1 := IsLocalization.map_under (Submonoid.powers h) R₂
        ((𝔮₁.map (algebraMap ↥(integralClosure R₁ L) ↥(integralClosure R₂ L))).comap
          (algebraMap R₂ ↥(integralClosure R₂ L)))
      rw [← e1, hN]
      exact congrArg (Ideal.map ι) hunder
    exact H₂ _ hP ((hfib 𝔮₁ _ hq).mp hbad)

theorem wcpa_dj_llsm_br_boundary_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (k : wcLlsKind W A) (z₀ : A) (b₀ : ↥W),
    wcLlsPD W A 𝔭 k →
    ((∃ t c, k = .disc t ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ z₀ = t - algebraMap ↥W A c) ∨
      (∃ v g, k = .ann z₀ v g ∧ b₀ ∣ g)) →
    b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    ∃ (A' : Type u) (_ : CommRing A') (_ : IsDomain A') (_ : Algebra ↥W A') (_ : Algebra A' K)
      (_ : IsFractionRing A' K) (_ : Algebra A' L) (_ : IsScalarTower A' K L)
      (u' v' : A') (𝔭' : Ideal A'),
      wcLlsBrSub W A K A' (algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀)
        {algebraMap A K z₀, algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀} ∧
      algebraMap A' K u' = algebraMap A K z₀ ∧
      algebraMap A' K v' = algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀ ∧
      wcLlsPD W A' 𝔭' (.ann u' v' b₀) ∧
      (∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ b₀ →
        (wcLlsSepAt W A K L z₀ (algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀) ↔
          wcLlsAnnSep W A' K L u' b)) ∧
      ((∀ Q, wcLlsGenPt W A L 𝔭 Q → wcLlsRam A K L Q → ∃ c : ↥W, b₀ ∣ c ∧
          z₀ - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L))) →
        wcLlsBR W A' K L 𝔭' (.ann u' v' b₀)) ∧
      (¬ wcLlsSepAt W A K L z₀ (algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀) →
        ∃ y' : Ideal ↥(integralClosure A' L), y'.IsPrime ∧
          y'.comap (algebraMap A' ↥(integralClosure A' L)) = 𝔭' ∧ ∀ (_ : y'.IsPrime),
          wcpaDjLkBad (wcLlsFS W ((algebraMap A' L).comp (algebraMap ↥W A')) A' y')) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 k z₀ b₀ hPD hk hb₀m hb₀0
  classical
  have hPD0 := hPD
  obtain ⟨hFT, hNZ, hIC, h𝔭max, hm𝔭, hrest⟩ := hPD0
  haveI := h𝔭max
  letI : Field (A ⧸ 𝔭) := Ideal.Quotient.field 𝔭
  have hinjA : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hWinj : ∀ w : ↥W, algebraMap A K (algebraMap ↥W A w) = 0 → w = 0 := by
    intro w hw
    have h3 : algebraMap ↥W A w = 0 := hinjA (by rw [hw, map_zero])
    have h4 : w • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one, h3]
    exact (smul_eq_zero.mp h4).resolve_right one_ne_zero
  have hw𝔭 : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W A w ∈ 𝔭 :=
    fun w hw => hm𝔭 (Ideal.mem_map_of_mem _ hw)

  have hz𝔭 : z₀ ∈ 𝔭 := by
    rcases hk with ⟨t, c, rfl, hc, rfl⟩ | ⟨v, g, rfl, -⟩
    · exact Ideal.sub_mem _ hrest.1 (hw𝔭 c hc)
    · rw [hrest.2.2.2.1]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hz0 : z₀ ≠ 0 := by
    rcases hk with ⟨t, c, rfl, hc, rfl⟩ | ⟨v, g, rfl, -⟩
    · obtain ⟨-, -, h, hh𝔭, f, hfC, hfX, hfet⟩ := hrest
      intro hz
      have hh0 : h ≠ 0 := fun h0 => hh𝔭 (h0 ▸ 𝔭.zero_mem)
      haveI : IsDomain (Localization.Away h) :=
        IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
      letI : Algebra (Polynomial ↥W) (Localization.Away h) := f.toAlgebra
      haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfet
      haveI : Module.Flat (Polynomial ↥W) (Localization.Away h) := inferInstance
      have hne : (Polynomial.X - Polynomial.C c : Polynomial ↥W) ≠ 0 :=
        Polynomial.X_sub_C_ne_zero c
      have hsr : IsSMulRegular (Polynomial ↥W) (Polynomial.X - Polynomial.C c) :=
        IsLeftRegular.isSMulRegular (mul_right_injective₀ hne)
      have hsrB := hsr.of_flat (S := Localization.Away h)
      have hfc : f (Polynomial.C c) = algebraMap A (Localization.Away h) (algebraMap ↥W A c) :=
        RingHom.congr_fun hfC c
      have hf0 : algebraMap (Polynomial ↥W) (Localization.Away h)
          (Polynomial.X - Polynomial.C c) = 0 := by
        show f (Polynomial.X - Polynomial.C c) = 0
        rw [map_sub, hfX, hfc, ← map_sub, hz, map_zero]
      exact one_ne_zero (hsrB (by simp [hf0]))
    · obtain ⟨-, hg0, huv0, -⟩ := hrest
      intro hz
      apply hg0
      apply hWinj
      rw [← huv0, hz, zero_mul, map_zero]

  obtain ⟨h, hh𝔭, ψ, hψC, hψ0, hψ1, hψet, χ, hχA, hχs⟩ :=
    wcpa_dj_llsm_bcc_chart_etale W A K 𝔭 k z₀ b₀ hPD hk hb₀m hb₀0 hz0
  have hh0 : h ≠ 0 := fun h0 => hh𝔭 (h0 ▸ 𝔭.zero_mem)
  have hzK : algebraMap A K z₀ ≠ 0 := (map_ne_zero_iff _ hinjA).mpr hz0
  have hhK : algebraMap A K h ≠ 0 := (map_ne_zero_iff _ hinjA).mpr hh0
  let s : K := algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀
  let η : K := (algebraMap A K h)⁻¹
  let S : Subalgebra A K := Algebra.adjoin A {s, η}
  have hsS : s ∈ S := Algebra.subset_adjoin (Set.mem_insert _ _)
  have hηS : η ∈ S := Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl)
  have hzs : algebraMap A K z₀ * s = algebraMap A K (algebraMap ↥W A b₀) := by
    exact mul_div_cancel₀ _ hzK
  have hηh : η * algebraMap A K h = 1 := inv_mul_cancel₀ hhK
  letI algWS : Algebra ↥W S := ((algebraMap A S).comp (algebraMap ↥W A)).toAlgebra
  let u' : S := algebraMap A S z₀
  let v' : S := ⟨s, hsS⟩
  let 𝔭' : Ideal S := Ideal.span {u', v'} ⊔
    (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S)
  have hinjS : Function.Injective (algebraMap S K) := Subtype.val_injective
  have huv : u' * v' = algebraMap ↥W S b₀ := hinjS (by rw [map_mul]; exact hzs)
  have hu'mem : u' ∈ 𝔭' := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hv'mem : v' ∈ 𝔭' := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))

  have hχu : χ u' = 0 := by
    exact (hχA z₀).trans (Ideal.Quotient.eq_zero_iff_mem.mpr hz𝔭)
  have h𝔭'χ : 𝔭' ≤ RingHom.ker χ := by
    apply sup_le
    · rw [Ideal.span_le]
      rintro x (rfl | hx)
      · exact RingHom.mem_ker.mpr hχu
      · rw [Set.mem_singleton_iff.mp hx]; exact RingHom.mem_ker.mpr hχs
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show χ (algebraMap A S (algebraMap ↥W A w)) = 0
      exact (hχA _).trans (Ideal.Quotient.eq_zero_iff_mem.mpr (hw𝔭 w hw))
  have h1𝔭' : (1 : S) ∉ 𝔭' := fun h1 => by
    have := RingHom.mem_ker.mp (h𝔭'χ h1)
    rw [map_one] at this
    exact one_ne_zero this
  have hWS : ∀ w : ↥W, algebraMap ↥W S w = algebraMap A S (algebraMap ↥W A w) := fun _ => rfl
  have hm' : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W S w ∈ 𝔭' :=
    fun w hw => Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have hvval : ∀ v g, k = .ann z₀ v g → ∀ b r : ↥W, g = b * r →
      algebraMap A K v = algebraMap A K (algebraMap ↥W A r) *
        (algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀) := by
    intro v g hkv b r hgr
    subst hkv
    obtain ⟨-, -, huv0, -⟩ := hrest
    have e1 : algebraMap A K z₀ * algebraMap A K v = algebraMap A K (algebraMap ↥W A g) := by
      rw [← map_mul, huv0]
    rw [hgr, map_mul, map_mul] at e1
    field_simp
    linear_combination e1

  have hnode : ∀ b : ↥W, b ∣ b₀ →
      𝔭 ≤ (Ideal.span {algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀}) z₀,
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀})).comp (algebraMap ↥W A))).comap
        (algebraMap A ↥(Algebra.adjoin A
          {algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀})) := by
    intro b hbb
    set R := Algebra.adjoin A {algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀} with hR
    have hzN : algebraMap A R z₀ ∈ (Ideal.span {algebraMap A R z₀,
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A R).comp (algebraMap ↥W A))) :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
    have hσN : (⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ : R) ∈ (Ideal.span {algebraMap A R z₀,
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A R).comp (algebraMap ↥W A))) :=
      Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hmN : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap A R (algebraMap ↥W A w) ∈
        (Ideal.span {algebraMap A R z₀,
        ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀,
          Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A R).comp (algebraMap ↥W A))) :=
      fun w hw => Ideal.mem_sup_right (Ideal.mem_map_of_mem ((algebraMap A R).comp (algebraMap ↥W A)) hw)
    rcases hk with ⟨t, c, rfl, hc, rfl⟩ | ⟨v, g, rfl, hgb⟩
    · rw [hrest.2.1]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
        have e : algebraMap A R t = algebraMap A R (t - algebraMap ↥W A c) +
            algebraMap A R (algebraMap ↥W A c) := by rw [← map_add, sub_add_cancel]
        rw [e]
        exact Ideal.add_mem _ hzN (hmN c hc)
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact hmN w hw
    · rw [hrest.2.2.2.1]
      obtain ⟨r, hr⟩ := hbb.trans hgb
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        rintro x (rfl | hx)
        · exact hzN
        · rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe, Ideal.mem_comap]
          have e : algebraMap A R v = algebraMap A R (algebraMap ↥W A r) *
              ⟨algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀,
                Algebra.subset_adjoin (Set.mem_singleton _)⟩ :=
            Subtype.ext (hvval v g rfl b r hr)
          rw [e]
          exact Ideal.mul_mem_left _ _ hσN
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact hmN w hw

  have hle' : 𝔭 ≤ 𝔭'.comap (algebraMap A S) := by
    refine le_trans (hnode b₀ dvd_rfl) ?_
    intro a ha
    rw [Ideal.mem_comap] at ha ⊢
    have hsub : Algebra.adjoin A {s} ≤ S := Algebra.adjoin_mono (by simp [s])
    let ι₀ : ↥(Algebra.adjoin A {s}) →+* S := Subalgebra.inclusion hsub
    have hmap : (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {s}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp
          (algebraMap ↥W A))) ≤ 𝔭'.comap ι₀ := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        rintro x (rfl | hx)
        · exact hu'mem
        · rw [Set.mem_singleton_iff.mp hx]; exact hv'mem
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hm' w hw
    exact hmap ha

  obtain ⟨β, i, hi, hβi⟩ := Ideal.IsMaximal.exists_inv h𝔭max hh𝔭
  have hnf : ∀ x : K, ∀ hx : x ∈ S, ∃ a : A, (⟨x, hx⟩ : S) - algebraMap A S a ∈ 𝔭' := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨0, by rw [map_zero, sub_zero]; exact hv'mem⟩
      · refine ⟨β, ?_⟩
        have e : (⟨η, hηS⟩ : S) - algebraMap A S β = ⟨η, hηS⟩ * algebraMap A S i := by
          apply hinjS
          show η - algebraMap A K β = η * algebraMap A K i
          have e2 : algebraMap A K β * algebraMap A K h + algebraMap A K i = 1 := by
            rw [← map_mul, ← map_add, hβi, map_one]
          calc η - algebraMap A K β = η * (algebraMap A K β * algebraMap A K h +
                algebraMap A K i) - algebraMap A K β * (η * algebraMap A K h) := by
                rw [e2, hηh]; ring
            _ = η * algebraMap A K i := by ring
        rw [e]
        exact Ideal.mul_mem_left _ _ (hle' hi)
    | algebraMap r =>
      refine ⟨r, ?_⟩
      convert 𝔭'.zero_mem using 1
      exact sub_eq_zero.mpr rfl
    | add x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨b, hb⟩ := ihy
      refine ⟨a + b, ?_⟩
      have e : (⟨x + y, add_mem hx hy⟩ : S) - algebraMap A S (a + b) =
          ((⟨x, hx⟩ : S) - algebraMap A S a) + ((⟨y, hy⟩ : S) - algebraMap A S b) := by
        rw [map_add]; apply hinjS; simp only [map_add, map_sub]; show x + y - _ = (x - _) + (y - _); ring
      rw [e]; exact Ideal.add_mem _ ha hb
    | mul x y hx hy ihx ihy =>
      obtain ⟨a, ha⟩ := ihx
      obtain ⟨b, hb⟩ := ihy
      refine ⟨a * b, ?_⟩
      have e : (⟨x * y, mul_mem hx hy⟩ : S) - algebraMap A S (a * b) =
          ((⟨x, hx⟩ : S) - algebraMap A S a) * ⟨y, hy⟩ +
            algebraMap A S a * ((⟨y, hy⟩ : S) - algebraMap A S b) := by
        rw [map_mul]; apply hinjS; simp only [map_add, map_sub, map_mul]
        show x * y - _ = (x - _) * y + _ * (y - _); ring
      rw [e]; exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hb)
  have hmax' : 𝔭'.IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨h1𝔭', fun J x hJ hx hxJ => ?_⟩
    obtain ⟨a, ha⟩ := hnf x x.2
    have ha' : x - algebraMap A S a ∈ 𝔭' := ha
    have ha𝔭 : a ∉ 𝔭 := fun h' => hx (by
      have := Ideal.add_mem _ ha' (hle' h'); rwa [sub_add_cancel] at this)
    obtain ⟨y, j, hj, hyj⟩ := Ideal.IsMaximal.exists_inv h𝔭max ha𝔭
    have e : (1 : S) = algebraMap A S y * x - algebraMap A S y * (x - algebraMap A S a) +
        algebraMap A S j := by
      rw [← map_one (algebraMap A S), ← hyj, map_add, map_mul]; ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hxJ)
      (Ideal.mul_mem_left _ _ (hJ ha'))) (hJ (hle' hj))

  have hs4 : ∀ σ : K, ∀ x ∈ Algebra.adjoin A {σ, η},
      ∃ n : ℕ, x * algebraMap A K h ^ n ∈ Algebra.adjoin A {σ} := by
    intro σ x hx
    have hH : ∀ l : ℕ, algebraMap A K h ^ l ∈ Algebra.adjoin A {σ} :=
      fun l => Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ h) l
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · exact ⟨0, by rw [pow_zero, mul_one]; exact Algebra.subset_adjoin (Set.mem_singleton _)⟩
      · rw [Set.mem_singleton_iff.mp hx]
        exact ⟨1, by rw [pow_one, hηh]; exact Subalgebra.one_mem _⟩
    | algebraMap r =>
      exact ⟨0, by rw [pow_zero, mul_one]; exact Subalgebra.algebraMap_mem _ r⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨k, hk⟩ := ihx
      obtain ⟨l, hl⟩ := ihy
      refine ⟨k + l, ?_⟩
      have e : (x + y) * algebraMap A K h ^ (k + l) =
          x * algebraMap A K h ^ k * algebraMap A K h ^ l +
          y * algebraMap A K h ^ l * algebraMap A K h ^ k := by ring
      rw [e]
      exact add_mem (mul_mem hk (hH l)) (mul_mem hl (hH k))
    | mul x y _ _ ihx ihy =>
      obtain ⟨k, hk⟩ := ihx
      obtain ⟨l, hl⟩ := ihy
      refine ⟨k + l, ?_⟩
      have e : (x * y) * algebraMap A K h ^ (k + l) =
          (x * algebraMap A K h ^ k) * (y * algebraMap A K h ^ l) := by ring
      rw [e]
      exact mul_mem hk hl
  have hsubS : Algebra.adjoin A {s} ≤ S := Algebra.adjoin_mono (by simp [s])
  let ι₀ : ↥(Algebra.adjoin A {s}) →+* S := (Subalgebra.inclusion hsubS).toRingHom
  have hmap₀ : (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {s}))} ⊔
      (IsLocalRing.maximalIdeal ↥W).map ((algebraMap A ↥(Algebra.adjoin A {s})).comp
        (algebraMap ↥W A))) ≤ 𝔭'.comap ι₀ := by
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro x (rfl | hx)
      · exact hu'mem
      · rw [Set.mem_singleton_iff.mp hx]; exact hv'mem
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      exact hm' w hw

  haveI : IsScalarTower ↥W A S := IsScalarTower.of_algebraMap_eq' rfl
  have hFTAS : Algebra.FiniteType A S := by
    have h1 := Subalgebra.fg_adjoin_finset (R := A) ({s, η} : Finset K)
    rw [Finset.coe_insert, Finset.coe_singleton] at h1
    exact (Subalgebra.fg_iff_finiteType _).mp h1
  have hFTWS : Algebra.FiniteType ↥W S := Algebra.FiniteType.trans hFT hFTAS
  have hNZS : NoZeroSMulDivisors ↥W S := by
    refine ⟨fun {w x} hwx => ?_⟩
    rw [Algebra.smul_def] at hwx
    rcases mul_eq_zero.mp hwx with h1 | h1
    · left
      apply hWinj
      have := congrArg (algebraMap S K) h1
      rw [map_zero] at this
      exact this
    · right; exact h1
  obtain ⟨hRd, hRic⟩ := wcNd_nodal_poly_normal Ω W b₀ hb₀0
  haveI := hRd
  haveI := hRic
  have hICS : IsIntegrallyClosed S := by
    letI : Algebra (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₀}) S :=
      @RingHom.toAlgebra _ S _ _ ψ
    have : Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₀}) S :=
      RingHom.Etale.toAlgebra hψet
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    have : p.IsPrime := hpm.isPrime
    exact (wc_pks_etale_localization_normal (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₀}) S p).2
  have hψCc : ψ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap ↥W S := hψC
  have hPD' : wcLlsPD W S 𝔭' (.ann u' v' b₀) := by
    refine ⟨hFTWS, hNZS, hICS, hmax', le_sup_right, hb₀m, hb₀0, huv, rfl, 1, h1𝔭',
      (algebraMap S (Localization.Away (1 : S))).comp ψ, ?_, ?_, ?_, ?_⟩
    · rw [RingHom.comp_assoc, hψCc]
    · rw [RingHom.comp_apply, hψ0]
    · rw [RingHom.comp_apply, hψ1]
    · exact RingHom.Etale.stableUnderComposition _ _ hψet
        (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (1 : S)))

  have hχh : ∀ n : ℕ, χ (algebraMap A S h ^ n) ≠ 0 := by
    intro n
    rw [map_pow, hχA]
    exact pow_ne_zero _ (fun h0 => hh𝔭 (Ideal.Quotient.eq_zero_iff_mem.mp h0))
  have hBrSub : wcLlsBrSub W A K S s {algebraMap A K z₀, s} := by
    refine ⟨fun _ => rfl, ?_, ?_⟩
    · intro y hy
      exact ⟨⟨y, hsubS hy⟩, rfl⟩
    · rintro _ ⟨x, rfl⟩
      obtain ⟨n, hn⟩ := hs4 s x x.2
      refine ⟨⟨_, hn⟩, algebraMap A ↥(Algebra.adjoin A {s}) h ^ n, ?_, ?_⟩
      · intro hqm
        have hle2 : Ideal.span (((↑) : ↥(Algebra.adjoin A {s}) → K) ⁻¹'
            ({algebraMap A K z₀, s} ∪ (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
              (IsLocalRing.maximalIdeal ↥W : Set ↥W))) ≤ 𝔭'.comap ι₀ := by
          rw [Ideal.span_le]
          rintro y ((hy | hy) | ⟨w, hw, hwy⟩)
          · rw [SetLike.mem_coe, Ideal.mem_comap]
            have hjy : ι₀ y = u' := hinjS hy
            rw [hjy]; exact hu'mem
          · rw [SetLike.mem_coe, Ideal.mem_comap]
            have hjy : ι₀ y = v' := hinjS (Set.mem_singleton_iff.mp hy)
            rw [hjy]; exact hv'mem
          · rw [SetLike.mem_coe, Ideal.mem_comap]
            have hjy : ι₀ y = algebraMap ↥W S w := hinjS hwy.symm
            rw [hjy]; exact hm' w hw
        have hmem : ι₀ (algebraMap A ↥(Algebra.adjoin A {s}) h ^ n) ∈ 𝔭' :=
          Ideal.mem_comap.mp (hle2 hqm)
        have hjA : ι₀ (algebraMap A ↥(Algebra.adjoin A {s}) h ^ n) = algebraMap A S h ^ n :=
          hinjS rfl
        rw [hjA] at hmem
        exact hχh n (RingHom.mem_ker.mp (h𝔭'χ hmem))
      · show (x : K) * ((algebraMap A ↥(Algebra.adjoin A {s}) h ^ n : ↥(Algebra.adjoin A {s})) : K) =
          (x : K) * algebraMap A K h ^ n
        rw [SubmonoidClass.coe_pow]
        rfl

  have mapEq : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (ι : R₁ →+* R₂) (a₁ b₁ : R₁)
      (a₂ b₂ : R₂) (w₁ : ↥W →+* R₁) (w₂ : ↥W →+* R₂), ι a₁ = a₂ → ι b₁ = b₂ → ι.comp w₁ = w₂ →
      Ideal.span {a₂, b₂} ⊔ (IsLocalRing.maximalIdeal ↥W).map w₂ =
        (Ideal.span {a₁, b₁} ⊔ (IsLocalRing.maximalIdeal ↥W).map w₁).map ι := by
    intro R₁ R₂ _ _ ι a₁ b₁ a₂ b₂ w₁ w₂ ha hb hw
    subst ha hb hw
    rw [Ideal.map_sup, Ideal.map_span, Set.image_pair, Ideal.map_map]
  have H6gen : ∀ {R : Type u} [CommRing R] (φ : A →+* R) (N : Ideal R), 𝔭 ≤ N.comap φ →
      ∀ x : R, x * φ h ∈ N → x ∈ N := by
    intro R _ φ N hle x hx
    have e : x = φ β * (x * φ h) + x * φ i := by
      have := congrArg φ hβi
      rw [map_add, map_mul, map_one] at this
      linear_combination (-x) * this
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hx) (Ideal.mul_mem_left _ _ (hle hi))

  have hiii : ¬ wcLlsSepAt W A K L z₀ s →
      ∃ y' : Ideal ↥(integralClosure S L), y'.IsPrime ∧
        y'.comap (algebraMap S ↥(integralClosure S L)) = 𝔭' ∧ ∀ (_ : y'.IsPrime),
        wcpaDjLkBad (wcLlsFS W ((algebraMap S L).comp (algebraMap ↥W S)) S y') := by
    intro hns
    have hN : 𝔭' = (Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z₀,
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A))).map ι₀ :=
      mapEq ι₀ _ _ _ _ _ _ (hinjS rfl) (hinjS rfl) (RingHom.ext fun _ => hinjS rfl)
    have key := wcpa_dj_llsm_bcc_loc_sep W K L
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ((algebraMap S L).comp (algebraMap ↥W S)) ↥(Algebra.adjoin A {s}) S rfl rfl
      Subtype.val_injective Subtype.val_injective ι₀ (fun _ => rfl)
      (algebraMap A ↥(Algebra.adjoin A {s}) h) ⟨⟨η, hηS⟩, hηh⟩
      (fun y => by obtain ⟨n, hn⟩ := hs4 s y y.2; exact ⟨n, ⟨_, hn⟩, rfl⟩) _ _ hN
      (H6gen _ _ (hnode b₀ dvd_rfl)) (fun _ => rfl)
      (fun w _ => ⟨algebraMap A _ (algebraMap ↥W A w), rfl⟩)
    by_contra hne
    exact hns (key.mpr (fun 𝔮₂ hp hc hbad => hne ⟨𝔮₂, hp, hc, fun _ => hbad⟩))

  have hi_ : ∀ b : ↥W, b ∈ IsLocalRing.maximalIdeal ↥W → b ≠ 0 → b ∣ b₀ →
      (wcLlsSepAt W A K L z₀ (algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀) ↔
        wcLlsAnnSep W S K L u' b) := by
    intro b _ _ hbb
    obtain ⟨e, he⟩ := hbb
    let σ : K := algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀
    have hsσ : s = algebraMap A K (algebraMap ↥W A e) * σ := by
      show algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K z₀ =
        algebraMap A K (algebraMap ↥W A e) * (algebraMap A K (algebraMap ↥W A b) / algebraMap A K z₀)
      rw [he, map_mul, map_mul]; ring
    have hSle : S ≤ Algebra.adjoin A {σ, η} := Algebra.adjoin_le (by
      rintro x (rfl | rfl)
      · rw [hsσ]
        exact mul_mem (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin (Set.mem_insert _ _))
      · exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl))
    have hsub : ∀ x ∈ Algebra.adjoin A {σ}, x ∈ Algebra.adjoin S {σ} := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact Algebra.subset_adjoin hx
      | algebraMap r => exact Subalgebra.algebraMap_mem (Algebra.adjoin S {σ}) (algebraMap A S r)
      | add x y _ _ hx hy => exact add_mem hx hy
      | mul x y _ _ hx hy => exact mul_mem hx hy
    have hsub2 : ∀ x ∈ Algebra.adjoin S {σ}, x ∈ Algebra.adjoin A {σ, η} := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff.mp hx]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
      | algebraMap r => exact hSle r.2
      | add x y _ _ hx hy => exact add_mem hx hy
      | mul x y _ _ hx hy => exact mul_mem hx hy
    let ι : ↥(Algebra.adjoin A {σ}) →+* ↥(Algebra.adjoin S {σ}) :=
      { toFun := fun y => ⟨y, hsub y y.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hN : (Ideal.span {algebraMap S ↥(Algebra.adjoin S {σ}) u',
        (⟨σ, Algebra.subset_adjoin (Set.mem_singleton σ)⟩ : ↥(Algebra.adjoin S {σ}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap S ↥(Algebra.adjoin S {σ})).comp (algebraMap ↥W S))) =
        (Ideal.span {algebraMap A ↥(Algebra.adjoin A {σ}) z₀,
        (⟨σ, Algebra.subset_adjoin (Set.mem_singleton σ)⟩ : ↥(Algebra.adjoin A {σ}))} ⊔
        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap A ↥(Algebra.adjoin A {σ})).comp (algebraMap ↥W A))).map ι :=
      mapEq ι _ _ _ _ _ _ (Subtype.ext rfl) (Subtype.ext rfl) (RingHom.ext fun _ => Subtype.ext rfl)
    have key := wcpa_dj_llsm_bcc_loc_sep W K L
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
      ((algebraMap K L).comp ((algebraMap S K).comp (algebraMap ↥W S)))
      ↥(Algebra.adjoin A {σ}) ↥(Algebra.adjoin S {σ}) rfl rfl
      Subtype.val_injective Subtype.val_injective ι (fun _ => rfl)
      (algebraMap A ↥(Algebra.adjoin A {σ}) h)
      ⟨⟨η, Subalgebra.algebraMap_mem (Algebra.adjoin S {σ}) (⟨η, hηS⟩ : S)⟩, hηh⟩
      (fun y => by obtain ⟨n, hn⟩ := hs4 σ y (hsub2 y y.2); exact ⟨n, ⟨_, hn⟩, rfl⟩) _ _ hN
      (H6gen _ _ (hnode b ⟨e, he⟩)) (fun _ => rfl)
      (fun w _ => ⟨algebraMap A _ (algebraMap ↥W A w), rfl⟩)
    show wcLlsSepAt W A K L z₀ σ ↔ wcLlsSepAt W S K L u' σ
    exact key

  have hii : (∀ Q, wcLlsGenPt W A L 𝔭 Q → wcLlsRam A K L Q → ∃ c : ↥W, b₀ ∣ c ∧
      z₀ - algebraMap ↥W A c ∈ Q.comap (algebraMap A ↥(integralClosure A L))) →
      wcLlsBR W S K L 𝔭' (.ann u' v' b₀) := by
    intro H Q' ⟨hQp, hQle, hQw⟩ ⟨σ', hσ1, hσ'⟩
    haveI := hQp
    have hL : (algebraMap S L).comp (algebraMap A S) = (RingHom.id L).comp (algebraMap A L) :=
      RingHom.ext fun a => by
        show algebraMap K L (algebraMap A K a) = algebraMap A L a
        exact (IsScalarTower.algebraMap_apply A K L a).symm
    let ι' : ↥(integralClosure A L) →+* ↥(integralClosure S L) :=
      { toFun := fun x => ⟨(x : L), IsIntegral.map_of_comp_eq (algebraMap A S) (RingHom.id L) hL x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have key : ∀ a : A, ι' (algebraMap A ↥(integralClosure A L) a) =
        algebraMap S ↥(integralClosure S L) (algebraMap A S a) := fun a => Subtype.ext (by
      show algebraMap A L a = algebraMap K L (algebraMap A K a)
      exact IsScalarTower.algebraMap_apply A K L a)
    have keymem : ∀ a : A, a ∈ (Q'.comap ι').comap (algebraMap A ↥(integralClosure A L)) ↔
        algebraMap A S a ∈ Q'.comap (algebraMap S ↥(integralClosure S L)) := by
      intro a
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, key]
    have hGen : wcLlsGenPt W A L 𝔭 (Q'.comap ι') := by
      refine ⟨Ideal.comap_isPrime ι' Q', ?_, ?_⟩
      · intro a ha
        have h1 := RingHom.mem_ker.mp (h𝔭'χ (hQle ((keymem a).mp ha)))
        rw [hχA] at h1
        exact Ideal.Quotient.eq_zero_iff_mem.mp h1
      · intro w hw0 hw
        exact hQw w hw0 ((keymem _).mp hw)
    have hRam : wcLlsRam A K L (Q'.comap ι') := by
      refine ⟨σ', hσ1, fun x => ?_⟩
      have hgx : IsIntegral A (σ' (x : L)) := by
        have := IsIntegral.map (σ'.toAlgHom.restrictScalars A) x.2
        simpa using this
      have hd : IsIntegral A (σ' (x : L) - (x : L)) := hgx.sub x.2
      obtain ⟨q', hq', hqeq⟩ := hσ' (ι' x)
      refine ⟨⟨σ' (x : L) - (x : L), hd⟩, ?_, rfl⟩
      have hιq : ι' ⟨σ' (x : L) - (x : L), hd⟩ = q' := Subtype.ext (by
        show σ' (x : L) - (x : L) = (q' : L)
        rw [hqeq]; rfl)
      rw [Ideal.mem_comap, hιq]
      exact hq'
    obtain ⟨c, ⟨d, hd⟩, hcQ⟩ := H _ hGen hRam
    rw [keymem] at hcQ
    haveI hP : (Q'.comap (algebraMap S ↥(integralClosure S L))).IsPrime := Ideal.comap_isPrime _ _
    have e : algebraMap A S (z₀ - algebraMap ↥W A c) = u' * (1 - v' * algebraMap ↥W S d) := by
      apply hinjS
      show algebraMap A K (z₀ - algebraMap ↥W A c) =
        algebraMap A K z₀ * (1 - s * algebraMap A K (algebraMap ↥W A d))
      rw [hd, map_sub, map_mul, map_mul]
      linear_combination (algebraMap A K (algebraMap ↥W A d)) * hzs
    rw [e] at hcQ
    rcases hP.mem_or_mem hcQ with h1 | h1
    · apply hQw b₀ hb₀0
      rw [← huv]
      exact Ideal.mul_mem_right _ _ h1
    · have h2 : 1 - v' * algebraMap ↥W S d ∈ 𝔭' := hQle h1
      apply h1𝔭'
      have := Ideal.add_mem _ h2 (Ideal.mul_mem_right (algebraMap ↥W S d) _ hv'mem)
      rwa [sub_add_cancel] at this
  exact ⟨S, inferInstance, inferInstance, algWS, inferInstance, inferInstance, inferInstance,
    inferInstance, u', v', 𝔭', hBrSub, rfl, rfl, hPD', hi_, hii, hiii⟩

theorem wcpa_dj_llsm_brrc_regular_pair : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (f : Polynomial ↥W →+* B) (c b : ↥W),
    f.Etale → f.comp Polynomial.C = algebraMap ↥W B → b ≠ 0 →
    algebraMap ↥W B b ≠ 0 ∧
      ∀ x : B, (f Polynomial.X - algebraMap ↥W B c) * x ∈ Ideal.span {algebraMap ↥W B b} →
        x ∈ Ideal.span {algebraMap ↥W B b} :=
by

  have transfer : ∀ (P S : Type u) [CommRing P] [CommRing S] [Algebra P S] [Module.Flat P S]
      (p r : P), (∀ y : P, r * y ∈ Ideal.span {p} → y ∈ Ideal.span {p}) →
      ∀ x : S, algebraMap P S r * x ∈ Ideal.span {algebraMap P S p} →
        x ∈ Ideal.span {algebraMap P S p} := by
    intro P S _ _ _ _ p r hreg x hx
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hx
    let f : Fin 2 → P := ![r, p]
    let v : Fin 2 → S := ![x, -y]
    have hrel : ∑ i, f i • v i = 0 := by
      rw [Fin.sum_univ_two]
      show r • x + p • (-y) = 0
      rw [Algebra.smul_def, Algebra.smul_def, ← hy]; ring
    obtain ⟨k, A, z, hx', hA⟩ :=
      Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P) (M := S) hrel
    have hx0 : x = ∑ j, A 0 j • z j := hx' 0
    have hdiv : ∀ j, A 0 j ∈ Ideal.span {p} := by
      intro j
      apply hreg
      have h3 : ∑ i, f i * A i j = 0 := hA j
      rw [Fin.sum_univ_two] at h3
      change r * A 0 j + p * A 1 j = 0 at h3
      rw [Ideal.mem_span_singleton']
      exact ⟨-A 1 j, by linear_combination -h3⟩
    choose s hs using fun j => Ideal.mem_span_singleton'.mp (hdiv j)
    rw [hx0, Ideal.mem_span_singleton']
    refine ⟨∑ j, algebraMap P S (s j) * z j, ?_⟩
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def, ← hs j, map_mul]
    ring
  intro Ω _ W B _ _ _ f c b hf hfC hb
  classical

  have poly : ∀ y : Polynomial ↥W, (Polynomial.X - Polynomial.C c) * y ∈
      Ideal.span {Polynomial.C b} → y ∈ Ideal.span {Polynomial.C b} := by
    intro y hy
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hy
    have hπb : Ideal.Quotient.mk (Ideal.span {b}) b = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self b)
    have h1 := congrArg (Polynomial.map (Ideal.Quotient.mk (Ideal.span {b}))) hz
    rw [Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C, hπb, map_zero, mul_zero,
      Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C] at h1
    have h2 : Polynomial.map (Ideal.Quotient.mk (Ideal.span {b})) y = 0 :=
      (Polynomial.Monic.mul_right_eq_zero_iff (Polynomial.monic_X_sub_C _)).mp h1.symm
    rw [Ideal.mem_span_singleton, Polynomial.C_dvd_iff_dvd_coeff]
    intro n
    have h3 : Ideal.Quotient.mk (Ideal.span {b}) (y.coeff n) = 0 := by
      rw [← Polynomial.coeff_map, h2, Polynomial.coeff_zero]
    exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h3)
  have hCb : (Polynomial.C b : Polynomial ↥W) ≠ 0 := by
    rw [Ne, Polynomial.C_eq_zero]; exact hb
  have hsr : IsSMulRegular (Polynomial ↥W) (Polynomial.C b) :=
    IsLeftRegular.isSMulRegular (mul_right_injective₀ hCb)
  have hfb : f (Polynomial.C b) = algebraMap ↥W B b := by
    rw [← hfC, RingHom.comp_apply]
  have hfr : f (Polynomial.X - Polynomial.C c) = f Polynomial.X - algebraMap ↥W B c := by
    rw [map_sub, ← hfC, RingHom.comp_apply]
  letI : Algebra (Polynomial ↥W) B := f.toAlgebra
  haveI : Algebra.Etale (Polynomial ↥W) B := hf
  haveI : Module.Flat (Polynomial ↥W) B := inferInstance
  have halg : ∀ q, algebraMap (Polynomial ↥W) B q = f q := fun q => rfl
  have hsrB : IsSMulRegular B (algebraMap (Polynomial ↥W) B (Polynomial.C b)) := hsr.of_flat
  have htr := transfer (Polynomial ↥W) B (Polynomial.C b) (Polynomial.X - Polynomial.C c) poly
  simp only [halg] at htr hsrB
  refine ⟨?_, ?_⟩
  · rw [← hfb]
    intro h0
    apply one_ne_zero (α := B)
    apply hsrB
    show f (Polynomial.C b) * 1 = f (Polynomial.C b) * 0
    rw [h0, zero_mul, zero_mul]
  · intro x hx
    rw [← hfb, ← hfr] at hx
    rw [← hfb]
    exact htr x hx

theorem wcpa_dj_llsm_brrc_disc_etale : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (B : Type u) [CommRing B] [Algebra ↥W B] (K : Type u) [Field K] [Algebra B K]
    (f : Polynomial ↥W →+* B) (c b : ↥W), Function.Injective (algebraMap B K) → f.Etale →
    f.comp Polynomial.C = algebraMap ↥W B → algebraMap ↥W B b ≠ 0 →
    RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K (f Polynomial.X - algebraMap ↥W B c) /
        algebraMap B K (algebraMap ↥W B b))) ≤
      Ideal.span {Polynomial.C (algebraMap ↥W B b) * Polynomial.X -
        Polynomial.C (f Polynomial.X - algebraMap ↥W B c)} →
    ∃ ψ : Polynomial ↥W →+* ↥(Algebra.adjoin B {algebraMap B K (f Polynomial.X - algebraMap ↥W B c) /
        algebraMap B K (algebraMap ↥W B b)}),
      ψ.comp Polynomial.C = (algebraMap B ↥(Algebra.adjoin B
        {algebraMap B K (f Polynomial.X - algebraMap ↥W B c) /
          algebraMap B K (algebraMap ↥W B b)})).comp (algebraMap ↥W B) ∧
      ψ Polynomial.X = ⟨algebraMap B K (f Polynomial.X - algebraMap ↥W B c) /
        algebraMap B K (algebraMap ↥W B b), Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∧
      RingHom.Etale (R := Polynomial ↥W) (S := ↥(Algebra.adjoin B
        {algebraMap B K (f Polynomial.X - algebraMap ↥W B c) /
          algebraMap B K (algebraMap ↥W B b)})) ψ :=
by
  intro Ω _ W B _ _ K _ _ f c b hinj hf hfC hb0 hker
  classical

  have gen : ∀ (P R B' Q : Type u) [CommRing P] [CommRing R] [CommRing B'] [CommRing Q]
      (ι : P →+* R) (g₀ : P →+* B') (ψ₀ : R →+* Q) (j : B' →+* Q), g₀.Etale →
      ψ₀.comp ι = j.comp g₀ →
      (∀ (T : Type u) [CommRing T] (u : R →+* T) (v : B' →+* T), u.comp ι = v.comp g₀ →
        ∃ β : Q →+* T, β.comp ψ₀ = u ∧ β.comp j = v) →
      (∀ (T : Type u) [CommRing T] (β₁ β₂ : Q →+* T), β₁.comp ψ₀ = β₂.comp ψ₀ →
        β₁.comp j = β₂.comp j → β₁ = β₂) →
      ψ₀.Etale := by
    intro P R B' Q _ _ _ _ ι g₀ ψ₀ j hg₀ hcomm hex hepi
    letI : Algebra P R := ι.toAlgebra
    letI : Algebra P B' := g₀.toAlgebra
    letI : Algebra P Q := (j.comp g₀).toAlgebra
    haveI : Algebra.Etale P B' := hg₀
    have hT : (algebraMap R (TensorProduct P R B')).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.baseChange P B' R)
    let f' : R →ₐ[P] Q := { ψ₀ with commutes' := fun q => RingHom.congr_fun hcomm q }
    let j' : B' →ₐ[P] Q := { j with commutes' := fun q => rfl }
    let α : TensorProduct P R B' →+* Q := (Algebra.TensorProduct.productMap f' j').toRingHom
    have hα : ∀ r b, α (r ⊗ₜ[P] b) = ψ₀ r * j b := fun r b =>
      Algebra.TensorProduct.productMap_apply_tmul f' j' r b
    obtain ⟨β, hβ1, hβ2⟩ := hex (TensorProduct P R B')
      (Algebra.TensorProduct.includeLeftRingHom (R := P) (A := R) (B := B'))
      (Algebra.TensorProduct.includeRight (R := P) (A := R) (B := B')).toRingHom
      (RingHom.ext fun q => by
        show (algebraMap P R q) ⊗ₜ[P] (1 : B') = (1 : R) ⊗ₜ[P] (algebraMap P B' q)
        exact Algebra.TensorProduct.tmul_one_eq_one_tmul q)
    have hβψ : ∀ r, β (ψ₀ r) = r ⊗ₜ[P] (1 : B') := fun r => by
      have := RingHom.congr_fun hβ1 r
      rw [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply] at this
      exact this
    have hβj : ∀ b, β (j b) = (1 : R) ⊗ₜ[P] b := fun b => by
      have := RingHom.congr_fun hβ2 b
      rw [RingHom.comp_apply] at this
      exact this.trans (Algebra.TensorProduct.includeRight_apply b)
    have hαβ : α.comp β = RingHom.id Q := by
      apply hepi Q
      · apply RingHom.ext
        intro r
        show α (β (ψ₀ r)) = ψ₀ r
        rw [hβψ, hα, map_one, mul_one]
      · apply RingHom.ext
        intro b
        show α (β (j b)) = j b
        rw [hβj, hα, map_one, one_mul]
    have hβα : β.comp α = RingHom.id _ := by
      apply Algebra.TensorProduct.ringHom_ext
      · apply RingHom.ext
        intro r
        show β (α (r ⊗ₜ[P] (1 : B'))) = r ⊗ₜ[P] (1 : B')
        rw [hα, map_one, mul_one, hβψ]
      · apply RingHom.ext
        intro b
        show β (α ((1 : R) ⊗ₜ[P] b)) = (1 : R) ⊗ₜ[P] b
        rw [hα, map_one, one_mul, hβj]
    let e : TensorProduct P R B' ≃+* Q := RingEquiv.ofRingHom α β hαβ hβα
    have hψe : ψ₀ = e.toRingHom.comp (algebraMap R (TensorProduct P R B')) := by
      apply RingHom.ext
      intro r
      change ψ₀ r = α (r ⊗ₜ[P] (1 : B'))
      rw [hα, map_one, mul_one]
    rw [hψe]
    exact RingHom.Etale.respectsIso.1 _ e hT

  have s1 : ∀ (p : Polynomial B) (s : K), Polynomial.aeval s p = 0 →
      RingHom.ker (Polynomial.aeval (R := B) s) ≤ Ideal.span {p} →
      ∃ e : (Polynomial B ⧸ Ideal.span {p}) ≃+* ↥(Algebra.adjoin B {s}),
        (∀ β : B, e (Ideal.Quotient.mk (Ideal.span {p}) (Polynomial.C β)) =
          algebraMap B ↥(Algebra.adjoin B {s}) β) ∧
        e (Ideal.Quotient.mk (Ideal.span {p}) Polynomial.X) =
          ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ := by
    intro p s hps hk
    let ŝ : ↥(Algebra.adjoin B {s}) := ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩
    let σ : Polynomial B →+* ↥(Algebra.adjoin B {s}) := (Polynomial.aeval ŝ).toRingHom
    have hσ : ∀ q, ((σ q : ↥(Algebra.adjoin B {s})) : K) = Polynomial.aeval s q := fun q =>
      Polynomial.aeval_subalgebra_coe q (Algebra.adjoin B {s}) ŝ
    have hsurj : Function.Surjective σ := by
      intro x
      obtain ⟨q, hq⟩ := Algebra.adjoin_eq_exists_aeval B s x
      exact ⟨q, Subtype.ext ((hσ q).trans hq)⟩
    have hkσ : Ideal.span {p} = RingHom.ker σ := by
      apply le_antisymm
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        apply Subtype.ext
        rw [hσ, hps]
        rfl
      · intro q hq
        apply hk
        rw [RingHom.mem_ker] at hq ⊢
        rw [← hσ, hq]
        rfl
    refine ⟨(Ideal.quotEquivOfEq hkσ).trans (RingHom.quotientKerEquivOfSurjective hsurj), ?_, ?_⟩
    · intro β
      rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
        RingHom.quotientKerEquivOfSurjective_apply_mk]
      exact Polynomial.aeval_C ŝ β
    · rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
        RingHom.quotientKerEquivOfSurjective_apply_mk]
      exact Polynomial.aeval_X ŝ

  have hfCw : ∀ w, f (Polynomial.C w) = algebraMap ↥W B w := fun w =>
    RingHom.congr_fun hfC w
  set J : Ideal (Polynomial B) := Ideal.span {Polynomial.C (algebraMap ↥W B b) * Polynomial.X -
      Polynomial.C (f Polynomial.X - algebraMap ↥W B c)} with hJdef
  let ψ₀ : Polynomial ↥W →+* Polynomial B ⧸ J :=
    Polynomial.eval₂RingHom ((Ideal.Quotient.mk J).comp (Polynomial.C.comp (algebraMap ↥W B)))
      (Ideal.Quotient.mk J Polynomial.X)
  have hψ₀C : ∀ w, ψ₀ (Polynomial.C w) =
      Ideal.Quotient.mk J (Polynomial.C (algebraMap ↥W B w)) := by
    intro w
    show Polynomial.eval₂ _ _ (Polynomial.C w) = _
    rw [Polynomial.eval₂_C]
    rfl
  have hψ₀X : ψ₀ Polynomial.X = Ideal.Quotient.mk J Polynomial.X := by
    show Polynomial.eval₂ _ _ Polynomial.X = _
    rw [Polynomial.eval₂_X]
  let ι : Polynomial ↥W →+* Polynomial ↥W :=
    Polynomial.eval₂RingHom Polynomial.C (Polynomial.C c + Polynomial.C b * Polynomial.X)
  have hιC : ∀ w, ι (Polynomial.C w) = Polynomial.C w := by
    intro w
    show Polynomial.eval₂ _ _ (Polynomial.C w) = _
    rw [Polynomial.eval₂_C]
  have hιX : ι Polynomial.X = Polynomial.C c + Polynomial.C b * Polynomial.X := by
    show Polynomial.eval₂ _ _ Polynomial.X = _
    rw [Polynomial.eval₂_X]
  have hJ0 : Ideal.Quotient.mk J (Polynomial.C (algebraMap ↥W B b)) *
      Ideal.Quotient.mk J Polynomial.X -
      (Ideal.Quotient.mk J (Polynomial.C (f Polynomial.X)) -
        Ideal.Quotient.mk J (Polynomial.C (algebraMap ↥W B c))) = 0 := by
    have h0 : Ideal.Quotient.mk J (Polynomial.C (algebraMap ↥W B b) * Polynomial.X -
        Polynomial.C (f Polynomial.X - algebraMap ↥W B c)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    rw [map_sub, map_mul, Polynomial.C_sub, map_sub] at h0
    exact h0
  have hcomm : ψ₀.comp ι = ((Ideal.Quotient.mk J).comp Polynomial.C).comp f := by
    apply Polynomial.ringHom_ext
    · intro w
      show ψ₀ (ι (Polynomial.C w)) = Ideal.Quotient.mk J (Polynomial.C (f (Polynomial.C w)))
      rw [hιC, hψ₀C, hfCw]
    · show ψ₀ (ι Polynomial.X) = Ideal.Quotient.mk J (Polynomial.C (f Polynomial.X))
      rw [hιX, map_add, map_mul, hψ₀C, hψ₀C, hψ₀X]
      linear_combination hJ0
  have hex : ∀ (T : Type u) [CommRing T] (u : Polynomial ↥W →+* T) (v : B →+* T),
      u.comp ι = v.comp f →
      ∃ β : (Polynomial B ⧸ J) →+* T, β.comp ψ₀ = u ∧
        β.comp ((Ideal.Quotient.mk J).comp Polynomial.C) = v := by
    intro T _ u v huv
    have hvC : ∀ w, v (algebraMap ↥W B w) = u (Polynomial.C w) := by
      intro w
      have := RingHom.congr_fun huv (Polynomial.C w)
      rw [RingHom.comp_apply, RingHom.comp_apply, hιC, hfCw] at this
      exact this.symm
    have hvX : v (f Polynomial.X) =
        u (Polynomial.C c) + u (Polynomial.C b) * u Polynomial.X := by
      have := RingHom.congr_fun huv Polynomial.X
      rw [RingHom.comp_apply, RingHom.comp_apply, hιX, map_add, map_mul] at this
      exact this.symm
    let βt : Polynomial B →+* T := Polynomial.eval₂RingHom v (u Polynomial.X)
    have hβtC : ∀ x, βt (Polynomial.C x) = v x := by
      intro x
      show Polynomial.eval₂ _ _ (Polynomial.C x) = _
      rw [Polynomial.eval₂_C]
    have hβtX : βt Polynomial.X = u Polynomial.X := by
      show Polynomial.eval₂ _ _ Polynomial.X = _
      rw [Polynomial.eval₂_X]
    have hβtJ : ∀ x ∈ J, βt x = 0 := by
      intro x hx
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      have hrel : βt (Polynomial.C (algebraMap ↥W B b) * Polynomial.X -
          Polynomial.C (f Polynomial.X - algebraMap ↥W B c)) = 0 := by
        rw [map_sub, map_mul, hβtC, hβtC, hβtX, map_sub, hvX, hvC, hvC]
        ring
      rw [map_mul, hrel, mul_zero]
    let β : Polynomial B ⧸ J →+* T := Ideal.Quotient.lift J βt hβtJ
    have hβmk : ∀ x, β (Ideal.Quotient.mk J x) = βt x := fun x =>
      Ideal.Quotient.lift_mk J βt hβtJ
    refine ⟨β, ?_, ?_⟩
    · apply Polynomial.ringHom_ext
      · intro w
        show β (ψ₀ (Polynomial.C w)) = u (Polynomial.C w)
        rw [hψ₀C, hβmk, hβtC, hvC]
      · show β (ψ₀ Polynomial.X) = u Polynomial.X
        rw [hψ₀X, hβmk, hβtX]
    · apply RingHom.ext
      intro x
      show β (Ideal.Quotient.mk J (Polynomial.C x)) = v x
      rw [hβmk, hβtC]
  have hepi : ∀ (T : Type u) [CommRing T] (β₁ β₂ : (Polynomial B ⧸ J) →+* T),
      β₁.comp ψ₀ = β₂.comp ψ₀ →
      β₁.comp ((Ideal.Quotient.mk J).comp Polynomial.C) =
        β₂.comp ((Ideal.Quotient.mk J).comp Polynomial.C) → β₁ = β₂ := by
    intro T _ β₁ β₂ h1 h2
    apply Ideal.Quotient.ringHom_ext
    apply Polynomial.ringHom_ext
    · intro x
      exact RingHom.congr_fun h2 x
    · have := RingHom.congr_fun h1 Polynomial.X
      rw [RingHom.comp_apply, RingHom.comp_apply, hψ₀X] at this
      exact this

  have hψet : ψ₀.Etale :=
    gen (Polynomial ↥W) (Polynomial ↥W) B (Polynomial B ⧸ J) ι f ψ₀
      ((Ideal.Quotient.mk J).comp Polynomial.C) hf hcomm hex hepi

  have hbK : algebraMap B K (algebraMap ↥W B b) ≠ 0 := fun h0 =>
    hb0 (hinj (by rw [h0, map_zero]))
  have hps : Polynomial.aeval (algebraMap B K (f Polynomial.X - algebraMap ↥W B c) /
        algebraMap B K (algebraMap ↥W B b))
      (Polynomial.C (algebraMap ↥W B b) * Polynomial.X -
        Polynomial.C (f Polynomial.X - algebraMap ↥W B c)) = 0 := by
    rw [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_C, Polynomial.aeval_X]
    rw [mul_div_cancel₀ _ hbK, sub_self]
  obtain ⟨eA, heC, heX⟩ := s1 _ _ hps hker
  refine ⟨eA.toRingHom.comp ψ₀, ?_, ?_, RingHom.Etale.respectsIso.1 _ eA hψet⟩
  · ext1 w
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
    exact (congrArg eA (hψ₀C w)).trans (heC _)
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
    exact (congrArg eA hψ₀X).trans heX

theorem wcpa_dj_llsm_brrc_brsub : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u)
    [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (A'' : Type u) [CommRing A'']
    [Algebra ↥W A''] [Algebra A'' K] (s : K) (h : A) (𝔭'' : Ideal A'')
    (j : ↥(Algebra.adjoin A {s}) →+* A''),
    (∀ w : ↥W, algebraMap A'' K (algebraMap ↥W A'' w) = algebraMap A K (algebraMap ↥W A w)) →
    (∀ y : ↥(Algebra.adjoin A {s}), algebraMap A'' K (j y) = (y : K)) →
    (∀ x : A'', ∃ k : ℕ, algebraMap A'' K x * algebraMap A K h ^ k ∈ Algebra.adjoin A {s}) →
    𝔭'' ≠ ⊤ → (∀ x : A'', algebraMap A'' K x = s → x ∈ 𝔭'') →
    (∀ (x : A'') (w : ↥W), w ∈ IsLocalRing.maximalIdeal ↥W →
      algebraMap A'' K x = algebraMap A K (algebraMap ↥W A w) → x ∈ 𝔭'') →
    (∀ x : A'', algebraMap A'' K x = algebraMap A K h → IsUnit x) →
    wcLlsBrSub W A K A'' s {s} :=
by
  intro Ω _ W A _ _ K _ _ A'' _ _ _ s h 𝔭'' j H1 H2 H3 H4 H5 H6 H7
  refine ⟨H1, ?_, ?_⟩
  · intro y hy
    exact ⟨j ⟨y, hy⟩, H2 ⟨y, hy⟩⟩
  · rintro _ ⟨x'', rfl⟩
    obtain ⟨k, hk⟩ := H3 x''
    set hA : ↥(Algebra.adjoin A {s}) := algebraMap A ↥(Algebra.adjoin A {s}) h with hAdef
    have hAK : (hA : K) = algebraMap A K h := rfl
    refine ⟨⟨algebraMap A'' K x'' * algebraMap A K h ^ k, hk⟩, hA ^ k, ?_, ?_⟩
    · intro hq
      have hle : Ideal.span (((↑) : ↥(Algebra.adjoin A {s}) → K) ⁻¹'
          ({s} ∪ (fun w : ↥W => algebraMap A K (algebraMap ↥W A w)) ''
            (IsLocalRing.maximalIdeal ↥W : Set ↥W))) ≤ 𝔭''.comap j := by
        rw [Ideal.span_le]
        rintro y (hy | ⟨w, hw, hwy⟩)
        · rw [SetLike.mem_coe, Ideal.mem_comap]
          exact H5 (j y) ((H2 y).trans (Set.mem_singleton_iff.mp hy))
        · rw [SetLike.mem_coe, Ideal.mem_comap]
          exact H6 (j y) w hw ((H2 y).trans hwy.symm)
      have hmem : j (hA ^ k) ∈ 𝔭'' := Ideal.mem_comap.mp (hle hq)
      have hunitA : IsUnit (j hA) := H7 (j hA) ((H2 hA).trans hAK)
      have hunit : IsUnit (j (hA ^ k)) := by
        rw [map_pow]; exact hunitA.pow k
      exact H4 (Ideal.eq_top_of_isUnit_mem 𝔭'' hmem hunit)
    · show algebraMap A'' K x'' * ((hA ^ k : ↥(Algebra.adjoin A {s})) : K) =
        algebraMap A'' K x'' * algebraMap A K h ^ k
      rw [SubmonoidClass.coe_pow, hAK]

theorem wcpa_dj_llsm_brrc_centre_map : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u)
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] (A'' : Type u) [CommRing A'']
    [Algebra ↥W A''] [Algebra A'' K] [Algebra A'' L] [IsScalarTower A'' K L] (𝔭 : Ideal A)
    (𝔭'' : Ideal A'') (t : A) (t' : A'') (c'' b₀ : ↥W) (φ : A →+* A''),
    𝔭.IsMaximal → 𝔭'' ≠ ⊤ → 𝔭 ≤ 𝔭''.comap φ →
    (∀ a : A, algebraMap A'' K (φ a) = algebraMap A K a) →
    (∀ w : ↥W, φ (algebraMap ↥W A w) = algebraMap ↥W A'' w) →
    c'' ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W →
    (∀ e : ↥W, φ (t - algebraMap ↥W A (c'' + b₀ * e)) =
      algebraMap ↥W A'' b₀ * (t' - algebraMap ↥W A'' e)) →
    ∀ e ∈ wcLlsBrSet W A'' K L 𝔭'' t', c'' + b₀ * e ∈ wcLlsBrSet W A K L 𝔭 t :=
by
  intro Ω _ W A _ _ K _ _ L _ _ _ _ A'' _ _ _ _ _ 𝔭 𝔭'' t t' c'' b₀ φ H1 H2 H3 H4 H5 H6 H7 H8
  intro e he
  have hcomap : 𝔭''.comap φ ≤ 𝔭 :=
    le_of_eq (Ideal.IsMaximal.eq_of_le H1 (Ideal.comap_ne_top φ H2) H3).symm
  have hL : ∀ a : A, algebraMap A'' L (φ a) = algebraMap A L a := by
    intro a
    rw [IsScalarTower.algebraMap_apply A'' K L, H4, ← IsScalarTower.algebraMap_apply A K L]
  have hLcomp : (algebraMap A'' L).comp φ = (RingHom.id L).comp (algebraMap A L) :=
    RingHom.ext hL
  let ι : ↥(integralClosure A L) →+* ↥(integralClosure A'' L) :=
    { toFun := fun x => ⟨(x : L), IsIntegral.map_of_comp_eq φ (RingHom.id L) hLcomp x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hιval : ∀ x : ↥(integralClosure A L), ((ι x : ↥(integralClosure A'' L)) : L) = (x : L) :=
    fun _ => rfl
  have key : ∀ a : A, ι (algebraMap A ↥(integralClosure A L) a) =
      algebraMap A'' ↥(integralClosure A'' L) (φ a) := by
    intro a
    apply Subtype.ext
    rw [hιval]
    show algebraMap A L a = algebraMap A'' L (φ a)
    rw [hL]
  obtain ⟨hem, Q, ⟨hQp, hQle, hQw⟩, hQt, g, hg1, hg⟩ := he
  haveI := hQp
  have keymem : ∀ a : A, a ∈ (Q.comap ι).comap (algebraMap A ↥(integralClosure A L)) ↔
      φ a ∈ Q.comap (algebraMap A'' ↥(integralClosure A'' L)) := by
    intro a
    rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, key]
  refine ⟨Ideal.add_mem _ H6 (Ideal.mul_mem_left _ b₀ hem), Q.comap ι,
    ⟨Ideal.comap_isPrime ι Q, ?_, ?_⟩, ?_, g, hg1, ?_⟩
  · intro a ha
    exact hcomap (Ideal.mem_comap.mpr (hQle ((keymem a).mp ha)))
  · intro w hw0 hw
    apply hQw w hw0
    rw [← H5 w]
    exact (keymem _).mp hw
  · rw [keymem, H8 e, Ideal.mem_comap, map_mul]
    exact Ideal.mul_mem_left Q _ (Ideal.mem_comap.mp hQt)
  · intro x
    have hgx : IsIntegral A (g (x : L)) := by
      have := IsIntegral.map (g.toAlgHom.restrictScalars A) x.2
      simpa using this
    have hd : IsIntegral A (g (x : L) - (x : L)) := hgx.sub x.2
    obtain ⟨q, hq, hqeq⟩ := hg (ι x)
    refine ⟨⟨g (x : L) - (x : L), hd⟩, ?_, rfl⟩
    have hιq : ι ⟨g (x : L) - (x : L), hd⟩ = q := by
      apply Subtype.ext
      rw [hιval, hqeq, hιval]
    rw [Ideal.mem_comap, hιq]
    exact hq

theorem wcpa_dj_llsm_br_residue_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c'' b₀ : ↥W),
    wcLlsPD W A 𝔭 (.disc t) → c'' ∈ IsLocalRing.maximalIdeal ↥W →
    b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    ∃ (A'' : Type u) (_ : CommRing A'') (_ : IsDomain A'') (_ : Algebra ↥W A'') (_ : Algebra A'' K)
      (_ : IsFractionRing A'' K) (_ : Algebra A'' L) (_ : IsScalarTower A'' K L)
      (t' : A'') (𝔭'' : Ideal A''),
      wcLlsBrSub W A K A''
        (algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀))
        {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)} ∧
      algebraMap A'' K t' =
        algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀) ∧
      wcLlsPD W A'' 𝔭'' (.disc t') ∧
      ∀ e ∈ wcLlsBrSet W A'' K L 𝔭'' t', c'' + b₀ * e ∈ wcLlsBrSet W A K L 𝔭 t :=
by
  intro Ω _ _ W _ _ A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c'' b₀ hPD hc hb hb0
  classical
  obtain ⟨hFT, hNZ, -, h𝔭max, hm𝔭, ht𝔭, h𝔭eq, h, hh𝔭, f, hfC, hfX, hfet⟩ := hPD

  have hh0 : h ≠ 0 := fun h0 => hh𝔭 (h0 ▸ 𝔭.zero_mem)
  have hinjA : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hu : IsUnit (algebraMap A K h) := ((map_ne_zero_iff _ hinjA).mpr hh0).isUnit
  haveI : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
  letI algBK : Algebra (Localization.Away h) K := (IsLocalization.Away.lift h hu).toAlgebra
  have hBK : ∀ a : A, algebraMap (Localization.Away h) K (algebraMap A (Localization.Away h) a) =
      algebraMap A K a := fun a => IsLocalization.Away.lift_eq h hu a
  haveI : IsScalarTower A (Localization.Away h) K :=
    IsScalarTower.of_algebraMap_eq (fun a => (hBK a).symm)
  haveI : IsFractionRing (Localization.Away h) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers h)
      (Localization.Away h) K
  have hinjB : Function.Injective (algebraMap (Localization.Away h) K) :=
    IsFractionRing.injective _ K
  have hfC' : f.comp Polynomial.C = algebraMap ↥W (Localization.Away h) := by
    rw [hfC]; exact (IsScalarTower.algebraMap_eq ↥W A (Localization.Away h)).symm
  have hat : f Polynomial.X - algebraMap ↥W (Localization.Away h) c'' =
      algebraMap A (Localization.Away h) (t - algebraMap ↥W A c'') := by
    rw [hfX, map_sub, IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) c'']
  have hbt : algebraMap ↥W (Localization.Away h) b₀ =
      algebraMap A (Localization.Away h) (algebraMap ↥W A b₀) :=
    IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) b₀
  haveI := h𝔭max
  have hmaxB : (𝔭.map (algebraMap A (Localization.Away h))).IsMaximal := by
    refine IsLocalization.isMaximal_of_isMaximal_disjoint (Submonoid.powers h) _ 𝔭 ?_
    refine Set.disjoint_left.mpr ?_
    rintro x ⟨n, rfl⟩ hx
    exact hh𝔭 (h𝔭max.isPrime.mem_of_pow_mem n hx)

  have hbt𝔭 : algebraMap ↥W (Localization.Away h) b₀ ∈ 𝔭.map (algebraMap A (Localization.Away h)) := by
    rw [hbt]; exact Ideal.mem_map_of_mem _ (hm𝔭 (Ideal.mem_map_of_mem _ hb))
  have hat𝔭 : f Polynomial.X - algebraMap ↥W (Localization.Away h) c'' ∈
      𝔭.map (algebraMap A (Localization.Away h)) := by
    rw [hat]; exact Ideal.mem_map_of_mem _ (𝔭.sub_mem ht𝔭 (hm𝔭 (Ideal.mem_map_of_mem _ hc)))

  obtain ⟨hbt0, hreg⟩ :=
    wcpa_dj_llsm_brrc_regular_pair Ω W (Localization.Away h) f c'' b₀ hfet hfC' hb0
  have hker := wcpa_dj_llsmacr_rees_kernel (Localization.Away h) K hinjB _ _ hbt0 hreg
  have hN1max := wcpa_dj_llsmacr_node_maximal (Localization.Away h) K _ _
    (𝔭.map (algebraMap A (Localization.Away h))) (𝔭.map (algebraMap A (Localization.Away h)))
    hmaxB hbt𝔭 hat𝔭 le_rfl le_sup_right hker.le

  have hbK : algebraMap A K (algebraMap ↥W A b₀) ≠ 0 := by
    intro h0
    apply hbt0
    apply hinjB
    rw [map_zero, hbt, hBK, h0]
  set sB : K := algebraMap (Localization.Away h) K
      (f Polynomial.X - algebraMap ↥W (Localization.Away h) c'') /
    algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) b₀) with hsBdef
  have hsBA : sB = algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀) := by
    rw [hsBdef, hat, hbt, hBK, hBK]
  have hkey : algebraMap A K (algebraMap ↥W A b₀) * sB =
      algebraMap A K t - algebraMap A K (algebraMap ↥W A c'') := by
    rw [hsBA, mul_div_cancel₀ _ hbK, map_sub]
  set S : Subalgebra (Localization.Away h) K := Algebra.adjoin (Localization.Away h) {sB}
    with hSdef
  letI algWS : Algebra ↥W S :=
    ((algebraMap (Localization.Away h) S).comp (algebraMap ↥W (Localization.Away h))).toAlgebra
  have hAWS : algebraMap ↥W S =
      (algebraMap (Localization.Away h) S).comp (algebraMap ↥W (Localization.Away h)) := rfl
  set t' : S := ⟨sB, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with ht'def
  obtain ⟨ψ, hψC, hψX, hψet⟩ : ∃ ψ : Polynomial ↥W →+* S,
      ψ.comp Polynomial.C =
        (algebraMap (Localization.Away h) S).comp (algebraMap ↥W (Localization.Away h)) ∧
      ψ Polynomial.X = t' ∧ ψ.Etale :=
    wcpa_dj_llsm_brrc_disc_etale Ω W (Localization.Away h) K f c'' b₀ hinjB hfet hfC' hbt0 hker.le
  set 𝔭'' : Ideal S := Ideal.span {t'} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W S)
    with h𝔭''def
  have hWK : ∀ w : ↥W, algebraMap S K (algebraMap ↥W S w) = algebraMap A K (algebraMap ↥W A w) := by
    intro w
    show algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) w) = _
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) w, hBK]
  have V1 : ∀ a : A, algebraMap S K (((algebraMap (Localization.Away h) S).comp
      (algebraMap A (Localization.Away h))) a) = algebraMap A K a := by
    intro a
    show algebraMap (Localization.Away h) K (algebraMap A (Localization.Away h) a) = _
    exact hBK a
  have V2 : ∀ w : ↥W, ((algebraMap (Localization.Away h) S).comp
      (algebraMap A (Localization.Away h))) (algebraMap ↥W A w) = algebraMap ↥W S w := by
    intro w
    show algebraMap (Localization.Away h) S (algebraMap A (Localization.Away h) (algebraMap ↥W A w)) =
      algebraMap (Localization.Away h) S (algebraMap ↥W (Localization.Away h) w)
    rw [← IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) w]
  have hinjS : Function.Injective (algebraMap S K) := Subtype.val_injective
  have ht'K : algebraMap S K t' = sB := rfl
  have V4 : ((algebraMap (Localization.Away h) S).comp (algebraMap A (Localization.Away h))) t =
      algebraMap ↥W S c'' + algebraMap ↥W S b₀ * t' := by
    apply hinjS
    rw [V1]
    simp only [map_add, map_mul, hWK, ht'K]
    linear_combination (-1 : K) * hkey
  have V5 : ∀ e : ↥W, ((algebraMap (Localization.Away h) S).comp
      (algebraMap A (Localization.Away h))) (t - algebraMap ↥W A (c'' + b₀ * e)) =
      algebraMap ↥W S b₀ * (t' - algebraMap ↥W S e) := by
    intro e
    apply hinjS
    rw [V1]
    simp only [map_add, map_sub, map_mul, hWK, ht'K]
    linear_combination (-1 : K) * hkey
  have ht'mem : t' ∈ 𝔭'' := Ideal.mem_sup_left (Ideal.mem_span_singleton_self t')
  have hm'' : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → algebraMap ↥W S w ∈ 𝔭'' :=
    fun w hw => Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
  have hle : 𝔭 ≤ 𝔭''.comap ((algebraMap (Localization.Away h) S).comp
      (algebraMap A (Localization.Away h))) := by
    rw [h𝔭eq]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, V4]
      exact Ideal.add_mem _ (hm'' c'' hc) (Ideal.mul_mem_left _ _ ht'mem)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, V2]
      exact hm'' w hw

  have h𝔭''eq : 𝔭'' = Ideal.span {algebraMap (Localization.Away h) S
        (algebraMap ↥W (Localization.Away h) b₀), t'} ⊔
      (𝔭.map (algebraMap A (Localization.Away h))).map (algebraMap (Localization.Away h) S) := by
    apply le_antisymm
    · refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, ← V2 w, RingHom.comp_apply]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _
          (Ideal.mem_map_of_mem _ (hm𝔭 (Ideal.mem_map_of_mem _ hw))))
    · refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro z hz
        rcases Set.mem_insert_iff.mp hz with hz | hz
        · rw [hz]; exact hm'' b₀ hb
        · rw [Set.mem_singleton_iff.mp hz]; exact ht'mem
      · rw [Ideal.map_map, Ideal.map_le_iff_le_comap]
        exact hle
  have hmax'' : 𝔭''.IsMaximal := by
    rw [h𝔭''eq]; exact hN1max

  haveI : IsScalarTower ↥W (Localization.Away h) S := IsScalarTower.of_algebraMap_eq' rfl
  have hFTBS : Algebra.FiniteType (Localization.Away h) S := by
    have h1 := Subalgebra.fg_adjoin_finset (R := Localization.Away h) ({sB} : Finset K)
    rw [Finset.coe_singleton] at h1
    exact (Subalgebra.fg_iff_finiteType _).mp h1
  have hFTWB : Algebra.FiniteType ↥W (Localization.Away h) := Algebra.FiniteType.trans hFT inferInstance
  have hFTWS : Algebra.FiniteType ↥W S := Algebra.FiniteType.trans hFTWB hFTBS
  have hNZS : NoZeroSMulDivisors ↥W S := by
    refine ⟨fun {w x} hwx => ?_⟩
    rw [Algebra.smul_def] at hwx
    rcases mul_eq_zero.mp hwx with h1 | h1
    · left
      have h2 : algebraMap A K (algebraMap ↥W A w) = 0 := by
        rw [← hWK, h1, map_zero]
      have h3 : algebraMap ↥W A w = 0 := hinjA (by rw [h2, map_zero])
      have h4 : w • (1 : A) = 0 := by rw [Algebra.smul_def, mul_one, h3]
      exact (smul_eq_zero.mp h4).resolve_right one_ne_zero
    · right; exact h1
  have hICS : IsIntegrallyClosed S := by
    letI : Algebra (Polynomial ↥W) S := @RingHom.toAlgebra (Polynomial ↥W) S _ _ ψ
    have : Algebra.Etale (Polynomial ↥W) S := RingHom.Etale.toAlgebra hψet
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    have : p.IsPrime := hpm.isPrime
    exact (wc_pks_etale_localization_normal (Polynomial ↥W) S p).2
  have h1N : (1 : S) ∉ 𝔭'' := fun h1 => hmax''.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hPD'' : wcLlsPD W S 𝔭'' (.disc t') := by
    refine ⟨hFTWS, hNZS, hICS, hmax'', le_sup_right, ht'mem, rfl, 1, h1N,
      (algebraMap S (Localization.Away (1 : S))).comp ψ, ?_, ?_, ?_⟩
    · rw [RingHom.comp_assoc, hψC, hAWS]
    · rw [RingHom.comp_apply, hψX]
    · exact RingHom.Etale.stableUnderComposition _ _ hψet
        (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (1 : S)))

  have hsub : ∀ x : K, x ∈ Algebra.adjoin A
      {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)} → x ∈ S := by
    intro x hx
    have hle' : Algebra.adjoin A
        {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)} ≤
        S.restrictScalars A := by
      apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff, SetLike.mem_coe, Subalgebra.mem_restrictScalars, ← hsBA]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    exact (Subalgebra.mem_restrictScalars _).mp (hle' hx)
  let j : ↥(Algebra.adjoin A
      {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)}) →+* S :=
    { toFun := fun y => ⟨y, hsub y y.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hrange : ∀ x : S, ∃ k : ℕ, algebraMap S K x * algebraMap A K h ^ k ∈ Algebra.adjoin A
      {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)} := by
    rintro ⟨x, hx0⟩
    show ∃ k : ℕ, x * algebraMap A K h ^ k ∈ _
    have hx : x ∈ Algebra.adjoin (Localization.Away h) {sB} := hx0
    clear hx0
    have hH : ∀ l : ℕ, algebraMap A K h ^ l ∈ Algebra.adjoin A
        {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)} :=
      fun l => Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ h) l
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨0, ?_⟩
      rw [pow_zero, mul_one, Set.mem_singleton_iff.mp hx, hsBA]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap r =>
      obtain ⟨⟨a, m⟩, hr⟩ := IsLocalization.surj (Submonoid.powers h) r
      obtain ⟨n, hn⟩ := m.2
      have hn' : h ^ n = (m : A) := hn
      refine ⟨n, ?_⟩
      have e : algebraMap (Localization.Away h) K r * algebraMap A K h ^ n = algebraMap A K a := by
        rw [← map_pow, ← hBK, ← hBK, ← map_mul, hn']
        exact congrArg _ hr
      rw [e]
      exact Subalgebra.algebraMap_mem _ a
    | add x y _ _ ihx ihy =>
      obtain ⟨k, hk⟩ := ihx
      obtain ⟨l, hl⟩ := ihy
      refine ⟨k + l, ?_⟩
      have e : (x + y) * algebraMap A K h ^ (k + l) =
          x * algebraMap A K h ^ k * algebraMap A K h ^ l +
          y * algebraMap A K h ^ l * algebraMap A K h ^ k := by ring
      rw [e]
      exact add_mem (mul_mem hk (hH l)) (mul_mem hl (hH k))
    | mul x y _ _ ihx ihy =>
      obtain ⟨k, hk⟩ := ihx
      obtain ⟨l, hl⟩ := ihy
      refine ⟨k + l, ?_⟩
      have e : (x * y) * algebraMap A K h ^ (k + l) =
          (x * algebraMap A K h ^ k) * (y * algebraMap A K h ^ l) := by ring
      rw [e]
      exact mul_mem hk hl
  have hBrSub : wcLlsBrSub W A K S
      (algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀))
      {algebraMap A K (t - algebraMap ↥W A c'') / algebraMap A K (algebraMap ↥W A b₀)} := by
    refine wcpa_dj_llsm_brrc_brsub Ω W A K S _ h 𝔭'' j hWK (fun _ => rfl) hrange hmax''.ne_top
      ?_ ?_ ?_
    · intro x hx
      have : x = t' := hinjS (hx.trans hsBA.symm)
      rw [this]; exact ht'mem
    · intro x w hw hx
      have : x = algebraMap ↥W S w := hinjS (hx.trans (hWK w).symm)
      rw [this]; exact hm'' w hw
    · intro x hx
      have : x = ((algebraMap (Localization.Away h) S).comp
          (algebraMap A (Localization.Away h))) h := hinjS (hx.trans (V1 h).symm)
      rw [this, RingHom.comp_apply]
      exact (IsLocalization.Away.algebraMap_isUnit h).map _

  refine ⟨S, inferInstance, inferInstance, algWS, inferInstance, inferInstance, inferInstance,
    inferInstance, t', 𝔭'', hBrSub, hsBA, hPD'', ?_⟩
  exact wcpa_dj_llsm_brrc_centre_map Ω W A K L S 𝔭 𝔭'' t t' c'' b₀
    ((algebraMap (Localization.Away h) S).comp (algebraMap A (Localization.Away h)))
    h𝔭max hmax''.ne_top hle V1 V2 hc hb V5

theorem wcpa_dj_llsm_fc_J_ne_top : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsScJ W A K L t c' b' ≠ ⊤ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' b' hc' hb'm hb'0
  obtain ⟨A'', iR, iD, iWA, iAK, iFR, iAL, iST, t', 𝔭'', hBr, -, hPD'', -⟩ :=
    wcpa_dj_llsm_br_residue_chart Ω W hW hWt A K L 𝔭 t c' b' hPD hc' hb'm hb'0
  obtain ⟨hW'', hsub, -⟩ := hBr
  obtain ⟨-, -, -, hmax, hm'', -⟩ := hPD''
  haveI : 𝔭''.IsPrime := hmax.isPrime
  have hinj : Function.Injective (algebraMap A'' K) := IsFractionRing.injective A'' K
  have hsub' : ((Algebra.adjoin A {wcLlsScS W A K t c' b'} : Subalgebra A K) : Set K) ⊆
      Set.range (algebraMap A'' K) := hsub

  let e : A'' ≃+* (algebraMap A'' K).range :=
    RingEquiv.ofBijective (algebraMap A'' K).rangeRestrict
      ⟨fun a b h => hinj (congrArg Subtype.val h), (algebraMap A'' K).rangeRestrict_surjective⟩
  let ι : ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) →+* (algebraMap A'' K).range :=
    RingHom.codRestrict (Algebra.adjoin A {wcLlsScS W A K t c' b'}).val.toRingHom _
      (fun x => (algebraMap A'' K).mem_range.mpr (hsub' x.2))
  let j : ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) →+* A'' := e.symm.toRingHom.comp ι
  have hj : ∀ x : ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}),
      algebraMap A'' K (j x) = (x : K) := by
    intro x
    have h1 := congrArg Subtype.val (e.apply_symm_apply (ι x))
    exact h1
  let N : Ideal ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) := 𝔭''.comap j
  haveI hN : N.IsPrime := Ideal.comap_isPrime j 𝔭''
  have hmN : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A w) ∈ N := by
    intro w hw
    show j (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A w)) ∈ 𝔭''
    have h1 : j (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A w)) =
        algebraMap ↥W A'' w := by
      apply hinj
      rw [hj, hW'']
      rfl
    rw [h1]
    exact hm'' (Ideal.mem_map_of_mem _ hw)

  have hinjRL : Function.Injective
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) := by
    intro x y hxy
    apply Subtype.val_injective
    exact (algebraMap K L).injective hxy
  have hker : (⊥ : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)).comap
      (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)) ≤ N := by
    intro x hx
    rw [Ideal.mem_comap, Ideal.mem_bot] at hx
    have h2 : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L x = 0 :=
      congrArg Subtype.val hx
    rw [hinjRL (h2.trans (map_zero _).symm)]
    exact N.zero_mem
  obtain ⟨Q, -, hQ, hQN⟩ := Ideal.exists_ideal_over_prime_of_isIntegral N
    (⊥ : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)) hker
  have hQN' : Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)) = N := hQN
  have hspan : Ideal.span {z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))} ≤ Q := by
    rw [Ideal.span_le]
    rintro z ⟨w, hw, hz⟩
    have hz' : z = algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L)
        (algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) (algebraMap ↥W A w)) := by
      apply Subtype.ext
      exact hz
    rw [SetLike.mem_coe, hz', ← Ideal.mem_comap, hQN']
    exact hmN w hw
  intro hJ
  apply hQ.ne_top
  rw [eq_top_iff, ← hJ]
  unfold wcLlsScJ
  exact (Ideal.IsPrime.radical_le_iff hQ).mpr hspan

theorem wcpa_dj_llsm_fcz_normalization_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → t - algebraMap ↥W A c' ≠ 0 →
      Module.Finite ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' b' _ _ _ _
  exact wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 (.disc t) hPD
    (wcLlsScS W A K t c' b')

theorem wcpa_dj_llsm_fcz_bound_of_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → t - algebraMap ↥W A c' ≠ 0 →
      Module.Finite ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) →
      ∃ c : ↥W, c ≠ 0 ∧
        ∀ z : ↥(integralClosure ↥(Algebra.adjoin A
            {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
          ∃ (u₁ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
            (u₂ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)),
            algebraMap K L (algebraMap A K (algebraMap ↥W A c)) * (z : L) =
              (u₁ : L) + (u₂ : L) :=
by
  classical

  have s1 : ∀ (A K : Type u) [CommRing A] [CommRing K] [Algebra A K] (R₁ : Subalgebra A K)
      (s : K) (X : Set K), s ∈ R₁ → (∀ y ∈ X, ∃ k : ℕ, s ^ k * y ∈ R₁) →
      ∀ y ∈ Algebra.adjoin A X, ∃ k : ℕ, s ^ k * y ∈ R₁ := by
    intro A K _ _ _ R₁ s X hs hX y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx => exact hX x hx
    | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact R₁.algebraMap_mem a⟩
    | add x y _ _ hx hy =>
      obtain ⟨k, hk⟩ := hx
      obtain ⟨l, hl⟩ := hy
      refine ⟨k + l, ?_⟩
      have e : s ^ (k + l) * (x + y) = s ^ l * (s ^ k * x) + s ^ k * (s ^ l * y) := by ring
      rw [e]
      exact R₁.add_mem (R₁.mul_mem (R₁.pow_mem hs l) hk) (R₁.mul_mem (R₁.pow_mem hs k) hl)
    | mul x y _ _ hx hy =>
      obtain ⟨k, hk⟩ := hx
      obtain ⟨l, hl⟩ := hy
      refine ⟨k + l, ?_⟩
      have e : s ^ (k + l) * (x * y) = (s ^ k * x) * (s ^ l * y) := by ring
      rw [e]
      exact R₁.mul_mem hk hl

  have s2 : ∀ (A K L : Type u) [CommRing A] [Field K] [Algebra A K] [Field L] [Algebra K L]
      (R₁ R₂ : Subalgebra A K) (s : K), s ∈ R₁ → (∀ y ∈ R₂, ∃ k : ℕ, s ^ k * y ∈ R₁) →
      ∀ x : L, IsIntegral R₂ x → ∃ N : ℕ, IsIntegral R₁ (algebraMap K L s ^ N * x) := by
    intro A K L _ _ _ _ _ R₁ R₂ s hs hR x hx
    obtain ⟨p, hpm, hpx⟩ := hx
    obtain ⟨q, hq⟩ : ∃ q : Polynomial K, q = p.map (algebraMap R₂ K) := ⟨_, rfl⟩
    have hqm : q.Monic := by rw [hq]; exact hpm.map _
    have hqx : Polynomial.eval₂ (algebraMap K L) x q = 0 := by
      rw [hq, Polynomial.eval₂_map]; exact hpx
    have hcoef : ∀ i, ∃ k : ℕ, s ^ k * q.coeff i ∈ R₁ := by
      intro i
      rw [hq, Polynomial.coeff_map]
      exact hR _ (p.coeff i).2
    choose k hk using hcoef
    obtain ⟨κ, hκ⟩ : ∃ κ : ℕ, κ = ∑ i ∈ Finset.range q.natDegree, k i := ⟨_, rfl⟩
    have hQm : (q.scaleRoots (s ^ κ)).Monic := (Polynomial.monic_scaleRoots_iff (s ^ κ)).mpr hqm
    have hQc : ∀ i, (q.scaleRoots (s ^ κ)).coeff i ∈ R₁ := by
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i q.natDegree with h | h | h
      · have hki : k i ≤ κ := by
          rw [hκ]
          exact Finset.single_le_sum (f := k) (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr h)
        have hle : k i ≤ κ * (q.natDegree - i) :=
          le_trans hki (Nat.le_mul_of_pos_right κ (by omega))
        obtain ⟨e', he'⟩ : ∃ e', κ * (q.natDegree - i) = e' + k i :=
          ⟨_, (Nat.sub_add_cancel hle).symm⟩
        have e : q.coeff i * (s ^ κ) ^ (q.natDegree - i) =
            s ^ e' * (s ^ k i * q.coeff i) := by
          rw [← pow_mul, he', pow_add]
          ring
        rw [e]
        exact R₁.mul_mem (R₁.pow_mem hs _) (hk i)
      · rw [h, hqm.coeff_natDegree, Nat.sub_self, pow_zero, one_mul]
        exact R₁.one_mem
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul]
        exact R₁.zero_mem
    have hQl : q.scaleRoots (s ^ κ) ∈ Polynomial.lifts (algebraMap R₁ K) :=
      (Polynomial.lifts_iff_coeff_lifts _).mpr (fun n => ⟨⟨_, hQc n⟩, rfl⟩)
    obtain ⟨Q', hQ'map, -, hQ'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hQl hQm
    refine ⟨κ, Q', hQ'm, ?_⟩
    have hcomp : algebraMap R₁ L = (algebraMap K L).comp (algebraMap R₁ K) := rfl
    rw [hcomp, ← Polynomial.eval₂_map, hQ'map, ← map_pow, Polynomial.scaleRoots_eval₂_mul, hqx,
      mul_zero]

  have s3 : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (Bu Bv : Subring L)
      (u v b : L) (r : ℕ) (g : Fin r → L) (p : Fin r → Polynomial A) (M : ℕ), u * v = 1 →
      u ∈ Bu → b ∈ Bu → (∀ a : A, algebraMap A L a ∈ Bu) → (∀ a : A, algebraMap A L a ∈ Bv) →
      (∀ j, g j ∈ Bu) → (∀ (j : Fin r) (a : ℕ), b * v ^ a * g j ∈ Bv) →
      ∃ u₁ ∈ Bu, ∃ u₂ ∈ Bv, b * (v ^ M * ∑ j, Polynomial.aeval u (p j) * g j) = u₁ + u₂ := by
    intro A L _ _ _ Bu Bv u v b r g p M huv hu hb hAu hAv hg hcol
    let P : L → Prop := fun x => ∃ u₁ ∈ Bu, ∃ u₂ ∈ Bv, x = u₁ + u₂
    have P0 : P 0 := ⟨0, Bu.zero_mem, 0, Bv.zero_mem, by rw [add_zero]⟩
    have Padd : ∀ x y, P x → P y → P (x + y) := by
      rintro x y ⟨a1, ha1, a2, ha2, rfl⟩ ⟨b1, hb1, b2, hb2, rfl⟩
      exact ⟨a1 + b1, Bu.add_mem ha1 hb1, a2 + b2, Bv.add_mem ha2 hb2, by ring⟩
    have key : ∀ (j : Fin r) (i : ℕ),
        P (algebraMap A L ((p j).coeff i) * (b * v ^ M * u ^ i * g j)) := by
      intro j i
      rcases le_or_gt M i with h | h
      · obtain ⟨d, rfl⟩ : ∃ d, i = M + d := ⟨i - M, by omega⟩
        have e : v ^ M * u ^ (M + d) = u ^ d := by
          rw [pow_add, ← mul_assoc, ← mul_pow, mul_comm v u, huv, one_pow, one_mul]
        refine ⟨algebraMap A L ((p j).coeff (M + d)) * (b * u ^ d * g j), ?_, 0, Bv.zero_mem, ?_⟩
        · exact Bu.mul_mem (hAu _) (Bu.mul_mem (Bu.mul_mem hb (Bu.pow_mem hu _)) (hg j))
        · rw [add_zero, ← e]; ring
      · obtain ⟨d, rfl⟩ : ∃ d, M = d + i := ⟨M - i, by omega⟩
        have e : v ^ (d + i) * u ^ i = v ^ d := by
          rw [pow_add, mul_assoc, ← mul_pow, mul_comm v u, huv, one_pow, mul_one]
        refine ⟨0, Bu.zero_mem, algebraMap A L ((p j).coeff i) * (b * v ^ d * g j),
          Bv.mul_mem (hAv _) (hcol j d), ?_⟩
        rw [zero_add, ← e]; ring
    have hexp : b * (v ^ M * ∑ j, Polynomial.aeval u (p j) * g j) =
        ∑ j, ∑ i ∈ Finset.range ((p j).natDegree + 1),
          algebraMap A L ((p j).coeff i) * (b * v ^ M * u ^ i * g j) := by
      rw [Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Polynomial.aeval_eq_sum_range, Finset.sum_mul, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def]; ring
    rw [hexp]
    exact Finset.sum_induction _ P Padd P0 (fun j _ =>
      Finset.sum_induction _ P Padd P0 (fun i _ => key j i))

  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' b' hc' hb'm hb'0 htc hfin
  by_cases hβ0 : algebraMap A K (algebraMap ↥W A b') = 0
  · refine ⟨b', hb'0, fun z => ⟨0, 0, ?_⟩⟩
    simp [hβ0]
  have hσ0 : algebraMap A K (t - algebraMap ↥W A c') ≠ 0 := by
    intro h
    apply htc
    exact IsFractionRing.injective A K (by rw [h, map_zero])
  have hS : wcLlsScS W A K t c' b' =
      algebraMap A K (t - algebraMap ↥W A c') / algebraMap A K (algebraMap ↥W A b') := rfl
  have hV : wcLlsScV W A K t c' b' =
      algebraMap A K (algebraMap ↥W A b') / algebraMap A K (t - algebraMap ↥W A c') := rfl
  have hSV : wcLlsScS W A K t c' b' * wcLlsScV W A K t c' b' = 1 := by
    rw [hS, hV, div_mul_div_comm, mul_comm (algebraMap A K (t - algebraMap ↥W A c')),
      div_self (mul_ne_zero hβ0 hσ0)]
  have hβV : algebraMap A K (algebraMap ↥W A b') =
      algebraMap A K (t - algebraMap ↥W A c') * wcLlsScV W A K t c' b' := by
    rw [hV, mul_div_cancel₀ _ hσ0]
  set S := wcLlsScS W A K t c' b' with hSdef
  set V := wcLlsScV W A K t c' b' with hVdef
  set σk := algebraMap A K (t - algebraMap ↥W A c') with hσkdef
  set βk := algebraMap A K (algebraMap ↥W A b') with hβkdef
  have hVmem : V ∈ Algebra.adjoin A {V} := Algebra.subset_adjoin (Set.mem_singleton V)
  have hSmem : S ∈ Algebra.adjoin A {S} := Algebra.subset_adjoin (Set.mem_singleton S)
  have hUV : ∀ y ∈ Algebra.adjoin A {S}, ∃ k : ℕ, V ^ k * y ∈ Algebra.adjoin A {V} :=
    s1 A K (Algebra.adjoin A {V}) V {S} hVmem (fun y hy => ⟨1, by
      rw [Set.mem_singleton_iff.mp hy, pow_one, mul_comm, hSV]
      exact (Algebra.adjoin A {V}).one_mem⟩)
  have s5 : ∀ g : L, IsIntegral (Algebra.adjoin A {S}) g →
      ∃ n : ℕ, IsIntegral (Algebra.adjoin A {V}) (algebraMap K L V ^ n * g) :=
    fun g hg => s2 A K L (Algebra.adjoin A {V}) (Algebra.adjoin A {S}) V hVmem hUV g hg
  have hUVU : ∀ y ∈ Algebra.adjoin A {S, V}, ∃ k : ℕ, S ^ k * y ∈ Algebra.adjoin A {S} :=
    s1 A K (Algebra.adjoin A {S}) S {S, V} hSmem (fun y hy => by
      rcases hy with hy | hy
      · rw [hy]; exact ⟨0, by rw [pow_zero, one_mul]; exact hSmem⟩
      · rw [Set.mem_singleton_iff.mp hy]
        exact ⟨1, by rw [pow_one, hSV]; exact (Algebra.adjoin A {S}).one_mem⟩)
  have s6 : ∀ z : L, IsIntegral (Algebra.adjoin A {S, V}) z →
      ∃ M : ℕ, IsIntegral (Algebra.adjoin A {S}) (algebraMap K L S ^ M * z) :=
    fun z hz => s2 A K L (Algebra.adjoin A {S}) (Algebra.adjoin A {S, V}) S hSmem hUVU z hz

  haveI := hfin
  obtain ⟨r, g, hg⟩ := Module.Finite.exists_fin (R := Algebra.adjoin A {S})
    (M := integralClosure (Algebra.adjoin A {S}) L)
  choose n hn using fun j => s5 (g j : L) (g j).2
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = ∑ j, n j := ⟨_, rfl⟩
  have hintK : ∀ (R : Subalgebra A K) (x : K), x ∈ R → IsIntegral R (algebraMap K L x) :=
    fun R x hx => isIntegral_algebraMap (R := R) (A := L) (x := ⟨x, hx⟩)
  have hcolI : ∀ (j : Fin r) (a : ℕ), IsIntegral (Algebra.adjoin A {V})
      (algebraMap K L βk ^ N * algebraMap K L V ^ a * (g j : L)) := by
    intro j a
    have hnj : n j ≤ N := by
      rw [hN]; exact Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    obtain ⟨e, he⟩ : ∃ e, N = n j + e := ⟨N - n j, by omega⟩
    have eq : algebraMap K L βk ^ N * algebraMap K L V ^ a * (g j : L) =
        algebraMap K L σk ^ N * algebraMap K L V ^ (a + e) *
          (algebraMap K L V ^ n j * (g j : L)) := by
      rw [hβV, map_mul, mul_pow, he]; ring
    rw [eq]
    exact ((hintK _ σk ((Algebra.adjoin A {V}).algebraMap_mem _)).pow _).mul
      ((hintK _ V hVmem).pow _) |>.mul (hn j)
  have hAu : ∀ (R : Subalgebra A K) (a : A),
      algebraMap A L a ∈ (integralClosure R L).toSubring := by
    intro R a
    rw [IsScalarTower.algebraMap_apply A K L a]
    exact hintK R _ (R.algebraMap_mem a)
  have hb : algebraMap K L βk ^ N ∈ (integralClosure (Algebra.adjoin A {S}) L).toSubring :=
    Subring.pow_mem _ (hintK _ βk ((Algebra.adjoin A {S}).algebraMap_mem _)) N
  refine ⟨b' ^ N, pow_ne_zero N hb'0, fun z => ?_⟩
  obtain ⟨M, hM⟩ := s6 (z : L) z.2
  have hw : (⟨algebraMap K L S ^ M * (z : L), hM⟩ : integralClosure (Algebra.adjoin A {S}) L) ∈
      Submodule.span (Algebra.adjoin A {S}) (Set.range g) := by
    rw [hg]; exact Submodule.mem_top
  obtain ⟨ρ, hρ⟩ := (Submodule.mem_span_range_iff_exists_fun (Algebra.adjoin A {S})).mp hw
  have hp : ∀ j, ∃ q : Polynomial A, Polynomial.aeval S q = (ρ j : K) := by
    intro j
    have hmem : (ρ j : K) ∈ (Polynomial.aeval (R := A) S).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact (ρ j).2
    exact Set.mem_range.mp hmem
  choose p hpp using hp
  have hzexp : algebraMap K L S ^ M * (z : L) =
      ∑ j, Polynomial.aeval (algebraMap K L S) (p j) * (g j : L) := by
    have h1 := congrArg (fun x : integralClosure (Algebra.adjoin A {S}) L => (x : L)) hρ
    simp only at h1
    rw [← h1]
    push_cast
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Polynomial.aeval_algebraMap_apply, hpp j, Algebra.smul_def]
    rfl
  have hz : (z : L) = algebraMap K L V ^ M * (algebraMap K L S ^ M * (z : L)) := by
    rw [← mul_assoc, ← mul_pow, ← map_mul, mul_comm V S, hSV, map_one, one_pow, one_mul]
  have huv : algebraMap K L S * algebraMap K L V = 1 := by rw [← map_mul, hSV, map_one]
  obtain ⟨u₁, hu₁, u₂, hu₂, he⟩ := s3 A L (integralClosure (Algebra.adjoin A {S}) L).toSubring
    (integralClosure (Algebra.adjoin A {V}) L).toSubring (algebraMap K L S) (algebraMap K L V)
    (algebraMap K L βk ^ N) r (fun j => (g j : L)) p M huv (hintK _ S hSmem) hb (hAu _) (hAu _)
    (fun j => (g j).2) hcolI
  refine ⟨⟨u₁, hu₁⟩, ⟨u₂, hu₂⟩, ?_⟩
  rw [map_pow, map_pow, map_pow, hz, hzexp]
  exact he

theorem wcpa_dj_llsm_fcz_conn_of_bound : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → t - algebraMap ↥W A c' ≠ 0 →
      (∃ c : ↥W, c ≠ 0 ∧
        ∀ z : ↥(integralClosure ↥(Algebra.adjoin A
            {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
          ∃ (u₁ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' b'}) L))
            (u₂ : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)),
            algebraMap K L (algebraMap A K (algebraMap ↥W A c)) * (z : L) =
              (u₁ : L) + (u₂ : L)) →
      wcLlsFcConnW W A K L t c' b' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0
    htc hBd
  obtain ⟨c, hc0, hBd⟩ := hBd
  intro e₁ e₂ he₁ he₂ hz
  obtain ⟨z₀, hz₀J, hz₀⟩ := hz
  have hnzd : NoZeroSMulDivisors ↥W A := hPD.2.1

  have idem_uniq : ∀ (R : Type u) [CommRing R] (g p q : R) (N : ℕ),
      p * p - p ∈ Ideal.span {g ^ N} → q * q - q ∈ Ideal.span {g ^ N} →
      p - q ∈ (Ideal.span {g}).radical → p - q ∈ Ideal.span {g ^ N} := by
    intro R _ g p q N hp hq hpq
    have h3 : (p - q) ^ 3 - (p - q) ∈ Ideal.span {g ^ N} := by
      have e : (p - q) ^ 3 - (p - q) =
          (p * p - p) * (1 + p - 3 * q) + (q * q - q) * (3 * p - q - 1) := by ring
      rw [e]; exact add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_right _ _ hq)
    have hind : ∀ k : ℕ, (p - q) ^ (2 * k + 1) - (p - q) ∈ Ideal.span {g ^ N} := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        have e : (p - q) ^ (2 * (k + 1) + 1) - (p - q) =
            (p - q) ^ 2 * ((p - q) ^ (2 * k + 1) - (p - q)) + ((p - q) ^ 3 - (p - q)) := by
          ring
        rw [e]; exact add_mem (Ideal.mul_mem_left _ _ ih) h3
    obtain ⟨m, hm⟩ := hpq
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hm
    have hbig : (p - q) ^ (2 * (m * N) + 1) ∈ Ideal.span {g ^ N} := by
      have e : (p - q) ^ (2 * (m * N) + 1) = ((p - q) ^ m) ^ N * (p - q) ^ (m * N + 1) := by
        rw [← pow_mul, ← pow_add]; congr 1; ring
      rw [e, ← hβ, mul_pow]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    have e : p - q = (p - q) ^ (2 * (m * N) + 1) - ((p - q) ^ (2 * (m * N) + 1) - (p - q)) := by
      ring
    rw [e]; exact sub_mem hbig (hind _)

  have idem_lift : ∀ (R : Type u) [CommRing R] (g x : R), x * x - x ∈ (Ideal.span {g}).radical →
      ∀ N : ℕ, ∃ x' : R, x' * x' - x' ∈ Ideal.span {g ^ N} ∧
        x' - x ∈ Ideal.span {x * x - x} := by
    intro R _ g x hx N
    obtain ⟨r, hr⟩ := hx
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hr
    have step : ∀ j : ℕ, ∃ y α : R, y * y - y = (x * x - x) ^ (2 ^ j) * α ∧
        y - x ∈ Ideal.span {x * x - x} := by
      intro j
      induction j with
      | zero => exact ⟨x, 1, by ring, by simp⟩
      | succ j ih =>
        obtain ⟨y, α, hy, hyx⟩ := ih
        refine ⟨3 * y ^ 2 - 2 * y ^ 3, α ^ 2 * (4 * y ^ 2 - 4 * y - 3), ?_, ?_⟩
        · have e : (3 * y ^ 2 - 2 * y ^ 3) * (3 * y ^ 2 - 2 * y ^ 3) - (3 * y ^ 2 - 2 * y ^ 3) =
              (y * y - y) ^ 2 * (4 * y ^ 2 - 4 * y - 3) := by ring
          rw [e, hy, pow_succ 2 j, pow_mul]; ring
        · have e : 3 * y ^ 2 - 2 * y ^ 3 - x = (y - x) + (y * y - y) * (1 - 2 * y) := by ring
          rw [e, hy]
          have hpos : 2 ^ j ≠ 0 := by positivity
          exact add_mem hyx (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _
            (Ideal.mem_span_singleton.mpr (dvd_pow_self _ hpos))))
    have aux : ∀ n : ℕ, n ≤ 2 ^ n := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        have h1 : 0 < 2 ^ n := by positivity
        rw [pow_succ]; omega
    obtain ⟨y, α, hy, hyx⟩ := step (r * N)
    refine ⟨y, ?_, hyx⟩
    have e : (x * x - x) ^ (2 ^ (r * N)) =
        ((x * x - x) ^ r) ^ N * (x * x - x) ^ (2 ^ (r * N) - r * N) := by
      rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' (aux _)]
    rw [hy, e, ← hβ, mul_pow]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _
      (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)))

  have rank_one : ∀ a w : ↥W, a ≠ 0 → w ∈ IsLocalRing.maximalIdeal ↥W → ∃ k : ℕ, a ∣ w ^ k := by
    intro a w ha hw
    by_cases hu : IsUnit a
    · exact ⟨0, hu.dvd⟩
    · have hPprime : (Ideal.span {a}).radical.IsPrime := by
        refine Ideal.isPrime_iff.mpr ⟨?_, ?_⟩
        · rw [Ne, Ideal.radical_eq_top, Ideal.span_singleton_eq_top]; exact hu
        · intro x y hxy
          obtain ⟨n, hn⟩ := hxy
          rcases ValuationRing.dvd_total x y with ⟨r, hr⟩ | ⟨r, hr⟩
          · right
            refine ⟨2 * n, ?_⟩
            have e : y ^ (2 * n) = r ^ n * (x * y) ^ n := by
              rw [pow_mul, ← mul_pow]; congr 1; rw [hr]; ring
            rw [e]; exact Ideal.mul_mem_left _ _ hn
          · left
            refine ⟨2 * n, ?_⟩
            have e : x ^ (2 * n) = r ^ n * (x * y) ^ n := by
              rw [pow_mul, ← mul_pow]; congr 1; rw [hr]; ring
            rw [e]; exact Ideal.mul_mem_left _ _ hn
      have hne : (Ideal.span {a}).radical ≠ ⊥ := by
        intro h
        apply ha
        have : a ∈ (Ideal.span {a}).radical := Ideal.le_radical (Ideal.mem_span_singleton_self a)
        rw [h] at this
        exact (Submodule.mem_bot _).mp this
      have : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
      have hmax : (Ideal.span {a}).radical.IsMaximal :=
        (Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance) _ hne hPprime
      have hP := IsLocalRing.eq_maximalIdeal hmax
      rw [← hP] at hw
      obtain ⟨k, hk⟩ := hw
      exact ⟨k, Ideal.mem_span_singleton.mp hk⟩

  have inter : ∀ (U V : K), U * V = 1 → ∀ x : L, IsIntegral ↥(Algebra.adjoin A {U}) x →
      IsIntegral ↥(Algebra.adjoin A {V}) x → IsIntegral A x := by
    intro U V hUV x hxU hxV
    have key : ∀ (O : ValuationSubring L), Set.range (algebraMap A L) ⊆ O →
        ∀ S : K, algebraMap K L S ∈ O → IsIntegral (Algebra.adjoin A {S}) x → x ∈ O := by
      intro O hO S hS hx
      have hmem : ∀ r : K, r ∈ Algebra.adjoin A {S} → algebraMap K L r ∈ O := by
        intro r hr
        induction hr using Algebra.adjoin_induction with
        | mem z hz =>
          rw [Set.mem_singleton_iff.mp hz]; exact hS
        | algebraMap a =>
          have : algebraMap K L (algebraMap A K a) = algebraMap A L a :=
            (IsScalarTower.algebraMap_apply A K L a).symm
          rw [this]; exact hO ⟨a, rfl⟩
        | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
        | mul a b _ _ ha hb => rw [map_mul]; exact mul_mem ha hb
      let φ : Algebra.adjoin A {S} →+* O :=
        ((algebraMap K L).comp (Algebra.adjoin A {S}).val.toRingHom).codRestrict O
          (fun r => hmem r r.2)
      have hO' : IsIntegral O x := by
        have := IsIntegral.map_of_comp_eq φ (RingHom.id L) (by ext r; rfl) hx
        simpa using this
      obtain ⟨o, ho⟩ := IsIntegrallyClosed.isIntegral_iff.mp hO'
      rw [← ho]; exact o.2
    have hvu : algebraMap K L V = (algebraMap K L U)⁻¹ := by
      have h : algebraMap K L U * algebraMap K L V = 1 := by rw [← map_mul, hUV, map_one]
      exact (inv_eq_of_mul_eq_one_right h).symm
    have hx : x ∈ (integralClosure (Subring.closure (Set.range (algebraMap A L))) L).toSubring := by
      rw [← iInf_valuationSubring_superset, Subring.mem_iInf]
      intro O
      have hO : Set.range (algebraMap A L) ⊆ (O.1 : Set L) := fun z hz => O.2 hz
      rcases O.1.mem_or_inv_mem (algebraMap K L U) with h | h
      · exact key O.1 hO U h hxU
      · rw [← hvu] at h; exact key O.1 hO V h hxV
    have hcl : Subring.closure (Set.range (algebraMap A L)) ≤ (integralClosure A L).toSubring := by
      rw [Subring.closure_le]
      rintro _ ⟨a, rfl⟩
      exact isIntegral_algebraMap
    let ψ : Subring.closure (Set.range (algebraMap A L)) →+* integralClosure A L :=
      Subring.inclusion hcl
    have hx2 : IsIntegral (integralClosure A L) x := by
      have := IsIntegral.map_of_comp_eq ψ (RingHom.id L) (by ext r; rfl) hx
      simpa using this
    have hx3 : x ∈ integralClosure (integralClosure A L) L := hx2
    rw [integralClosure_idem, Algebra.mem_bot] at hx3
    obtain ⟨a, rfl⟩ := hx3
    exact a.2

  have hbK : algebraMap A K (algebraMap ↥W A b') ≠ 0 := by
    intro h
    have h1 : algebraMap ↥W A b' = 0 :=
      IsFractionRing.injective A K (h.trans (map_zero _).symm)
    rw [Algebra.algebraMap_eq_smul_one] at h1
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact hb'0 h2
    · exact one_ne_zero h2
  have hτK : algebraMap A K (t - algebraMap ↥W A c') ≠ 0 := fun h =>
    htc (IsFractionRing.injective A K (h.trans (map_zero _).symm))
  have hSV : wcLlsScS W A K t c' b' * wcLlsScV W A K t c' b' = 1 := by
    unfold wcLlsScS wcLlsScV
    field_simp
  have hbS : algebraMap A K (algebraMap ↥W A b') * wcLlsScS W A K t c' b' =
      algebraMap A K (t - algebraMap ↥W A c') := by
    unfold wcLlsScS
    field_simp
  have hbu : algebraMap K L (algebraMap A K (algebraMap ↥W A b')) *
      algebraMap K L (wcLlsScS W A K t c' b') =
      algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) := by
    rw [← map_mul, hbS]
  have incl : ∀ (s₁ s₂ : Set K), s₁ ⊆ s₂ → ∀ x : L, IsIntegral (Algebra.adjoin A s₁) x →
      IsIntegral (Algebra.adjoin A s₂) x := by
    intro s₁ s₂ h x hx
    have := IsIntegral.map_of_comp_eq (Subalgebra.inclusion (Algebra.adjoin_mono h)).toRingHom
      (RingHom.id L) (by ext r; rfl) hx
    simpa using this
  have memK : ∀ (s : Set K) (r : K), r ∈ Algebra.adjoin A s →
      IsIntegral (Algebra.adjoin A s) (algebraMap K L r) := fun s r hr =>
    isIntegral_algebraMap (x := (⟨r, hr⟩ : Algebra.adjoin A s))
  have hWint : ∀ (s : Set K) (w : ↥W),
      IsIntegral (Algebra.adjoin A s) (algebraMap K L (algebraMap A K (algebraMap ↥W A w))) :=
    fun s w => memK s _ (Subalgebra.algebraMap_mem _ _)
  have hAint : ∀ (s : Set K) (a : A),
      IsIntegral (Algebra.adjoin A s) (algebraMap K L (algebraMap A K a)) :=
    fun s a => memK s _ (Subalgebra.algebraMap_mem _ _)
  have hsubU : ({wcLlsScS W A K t c' b'} : Set K) ⊆
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'} :=
    Set.singleton_subset_iff.mpr (Set.mem_insert _ _)
  have hsubV : ({wcLlsScV W A K t c' b'} : Set K) ⊆
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'} :=
    Set.singleton_subset_iff.mpr (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have huUV : IsIntegral (Algebra.adjoin A {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'})
      (algebraMap K L (wcLlsScS W A K t c' b')) :=
    memK _ _ (Algebra.subset_adjoin (Set.mem_insert _ _))
  obtain ⟨bU, hbU⟩ : ∃ x : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L,
      (x : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A b')) := ⟨⟨_, hWint _ b'⟩, rfl⟩
  obtain ⟨bV, hbV⟩ : ∃ x : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L,
      (x : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A b')) := ⟨⟨_, hWint _ b'⟩, rfl⟩
  obtain ⟨τV, hτV⟩ : ∃ x : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L,
      (x : L) = algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) :=
    ⟨⟨_, hAint _ _⟩, rfl⟩
  obtain ⟨bUV, hbUV⟩ : ∃ x : integralClosure (Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L,
      (x : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A b')) := ⟨⟨_, hWint _ b'⟩, rfl⟩
  have hbUJ : bU ∈ wcLlsScJ W A K L t c' b' := by
    unfold wcLlsScJ
    exact Ideal.le_radical (Ideal.subset_span ⟨b', hb'm, hbU⟩)
  have hbVJ : bV ∈ wcLlsFcJV W A K L t c' b' := by
    unfold wcLlsFcJV
    exact Ideal.le_radical (Ideal.subset_span (Or.inl ⟨b', hb'm, hbV⟩))

  obtain ⟨k₀, hk₀⟩ := rank_one c b' hc0 hb'm
  obtain ⟨γ, hγ⟩ := hk₀
  have hN : algebraMap K L (algebraMap A K (algebraMap ↥W A b')) ^ (k₀ + 1) =
      algebraMap K L (algebraMap A K (algebraMap ↥W A b')) *
        (algebraMap K L (algebraMap A K (algebraMap ↥W A c)) *
          algebraMap K L (algebraMap A K (algebraMap ↥W A γ))) := by
    have h1 : b' ^ (k₀ + 1) = b' * (c * γ) := by rw [pow_succ, hγ, mul_comm]
    have h2 := congrArg (fun w : ↥W => algebraMap K L (algebraMap A K (algebraMap ↥W A w))) h1
    simpa only [map_pow, map_mul] using h2

  have radmono : ∀ (R : Type u) [CommRing R] (S : Set R) (g : R),
      (∀ z ∈ S, z ∈ (Ideal.span {g}).radical) →
      ∀ x ∈ (Ideal.span S).radical, x ∈ (Ideal.span {g}).radical := by
    intro R _ S g h x hx
    have := Ideal.radical_mono (Ideal.span_le.mpr h) hx
    rwa [Ideal.radical_idem] at this
  have hτv : algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) *
      algebraMap K L (wcLlsScV W A K t c' b') =
      algebraMap K L (algebraMap A K (algebraMap ↥W A b')) := by
    rw [← map_mul]
    congr 1
    unfold wcLlsScV
    field_simp
  have genW : ∀ (s : Set K) (g : integralClosure (Algebra.adjoin A s) L),
      (g : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A b')) →
      ∀ z : integralClosure (Algebra.adjoin A s) L, (∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))) →
      z ∈ (Ideal.span {g}).radical := by
    rintro s g hg z ⟨w, hw, hz⟩
    obtain ⟨k, r, hr⟩ := rank_one b' w hb'0 hw
    refine ⟨k, Ideal.mem_span_singleton'.mpr ⟨⟨_, hWint s r⟩, Subtype.ext ?_⟩⟩
    show algebraMap K L (algebraMap A K (algebraMap ↥W A r)) * (g : L) = (z : L) ^ k
    rw [hz, hg, ← map_pow, ← map_pow, ← map_pow, hr, map_mul, map_mul, map_mul, mul_comm]
  have hJU : ∀ x : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L,
      x ∈ wcLlsScJ W A K L t c' b' → ∃ (k : ℕ) (β : integralClosure
        (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
        (x : L) ^ k = algebraMap K L (algebraMap A K (algebraMap ↥W A b')) * (β : L) := by
    intro x hx
    obtain ⟨k, hk⟩ := radmono _ _ bU (fun z hz => genW _ bU hbU z hz) x hx
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hk
    refine ⟨k, β, ?_⟩
    have := congrArg Subtype.val hβ
    change (β : L) * (bU : L) = (x : L) ^ k at this
    rw [← this, hbU, mul_comm]
  have hJUV : ∀ x : integralClosure (Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L,
      x ∈ wcLlsFcJUV W A K L t c' b' → ∃ (k : ℕ) (β : integralClosure (Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L),
        (x : L) ^ k = algebraMap K L (algebraMap A K (algebraMap ↥W A b')) * (β : L) := by
    intro x hx
    obtain ⟨k, hk⟩ := radmono _ _ bUV (fun z hz => genW _ bUV hbUV z hz) x hx
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hk
    refine ⟨k, β, ?_⟩
    have := congrArg Subtype.val hβ
    change (β : L) * (bUV : L) = (x : L) ^ k at this
    rw [← this, hbUV, mul_comm]
  have hvV : IsIntegral (Algebra.adjoin A {wcLlsScV W A K t c' b'})
      (algebraMap K L (wcLlsScV W A K t c' b')) :=
    memK _ _ (Algebra.subset_adjoin (Set.mem_singleton _))
  have hJV : ∀ x : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L,
      x ∈ wcLlsFcJV W A K L t c' b' → ∃ (k : ℕ) (β : integralClosure
        (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
        (x : L) ^ k = algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) * (β : L) := by
    intro x hx
    have hgen : ∀ z ∈ {z : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L |
        (∃ w ∈ IsLocalRing.maximalIdeal ↥W,
          (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))) ∨
        (z : L) = algebraMap K L (algebraMap A K (t - algebraMap ↥W A c'))},
        z ∈ (Ideal.span {τV}).radical := by
      rintro z (hz | hz)
      · have h1 := genW _ bV hbV z hz
        have h2 : bV ∈ Ideal.span {τV} := by
          refine Ideal.mem_span_singleton'.mpr ⟨⟨_, hvV⟩, Subtype.ext ?_⟩
          show algebraMap K L (wcLlsScV W A K t c' b') * (τV : L) = (bV : L)
          rw [hτV, hbV, mul_comm, hτv]
        have h3 : Ideal.span {bV} ≤ Ideal.span {τV} := (Ideal.span_singleton_le_iff_mem _).mpr h2
        exact Ideal.radical_mono h3 h1
      · refine Ideal.le_radical (Ideal.mem_span_singleton'.mpr ⟨1, Subtype.ext ?_⟩)
        show (1 : L) * (τV : L) = (z : L)
        rw [one_mul, hτV, hz]
    obtain ⟨k, hk⟩ := radmono _ _ τV hgen x hx
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hk
    refine ⟨k, β, ?_⟩
    have := congrArg Subtype.val hβ
    change (β : L) * (τV : L) = (x : L) ^ k at this
    rw [← this, hτV, mul_comm]

  have radU : ∀ x : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L,
      x ∈ wcLlsScJ W A K L t c' b' → x ∈ (Ideal.span {bU}).radical := by
    intro x hx
    obtain ⟨k, β, hk⟩ := hJU x hx
    refine ⟨k, Ideal.mem_span_singleton'.mpr ⟨β, Subtype.ext ?_⟩⟩
    show (β : L) * (bU : L) = (x : L) ^ k
    rw [hk, hbU, mul_comm]
  have radV : ∀ x : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L,
      x ∈ wcLlsFcJV W A K L t c' b' → x ∈ (Ideal.span {τV}).radical := by
    intro x hx
    obtain ⟨k, β, hk⟩ := hJV x hx
    refine ⟨k, Ideal.mem_span_singleton'.mpr ⟨β, Subtype.ext ?_⟩⟩
    show (β : L) * (τV : L) = (x : L) ^ k
    rw [hk, hτV, mul_comm]
  obtain ⟨x₁, hx₁, hx₁e⟩ := idem_lift _ bU e₁ (radU _ he₁) (k₀ + 1)
  obtain ⟨α₁, hα₁⟩ := Ideal.mem_span_singleton'.mp hx₁
  have hx₁eJ : x₁ - e₁ ∈ wcLlsScJ W A K L t c' b' :=
    (Ideal.span_singleton_le_iff_mem _).mpr he₁ hx₁e
  obtain ⟨x₂, hx₂, hx₂e⟩ := idem_lift _ τV e₂ (radV _ he₂) (k₀ + 1)
  obtain ⟨α₂, hα₂⟩ := Ideal.mem_span_singleton'.mp hx₂
  have hx₂eJ : x₂ - e₂ ∈ wcLlsFcJV W A K L t c' b' :=
    (Ideal.span_singleton_le_iff_mem _).mpr he₂ hx₂e
  have hα₁L : (α₁ : L) * algebraMap K L (algebraMap A K (algebraMap ↥W A b')) ^ (k₀ + 1) =
      (x₁ : L) * x₁ - x₁ := by
    rw [← hbU]; exact congrArg Subtype.val hα₁
  have hα₂L : (α₂ : L) * algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) ^ (k₀ + 1) =
      (x₂ : L) * x₂ - x₂ := by
    rw [← hτV]; exact congrArg Subtype.val hα₂

  have radUV : ∀ (X : integralClosure (Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L) (k : ℕ) (β : L),
      IsIntegral (Algebra.adjoin A {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) β →
      (X : L) ^ k = algebraMap K L (algebraMap A K (algebraMap ↥W A b')) * β →
      X ∈ (Ideal.span {bUV}).radical := by
    intro X k β hβ hk
    refine ⟨k, Ideal.mem_span_singleton'.mpr ⟨⟨β, hβ⟩, Subtype.ext ?_⟩⟩
    show β * (bUV : L) = (X : L) ^ k
    rw [hk, hbUV, mul_comm]
  obtain ⟨p, hp⟩ : ∃ p : integralClosure (Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L, (p : L) = (x₁ : L) :=
    ⟨⟨x₁, incl _ _ hsubU _ x₁.2⟩, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q : integralClosure (Algebra.adjoin A
      {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L, (q : L) = (x₂ : L) :=
    ⟨⟨x₂, incl _ _ hsubV _ x₂.2⟩, rfl⟩
  have hpI : p * p - p ∈ Ideal.span {bUV ^ (k₀ + 1)} := by
    refine Ideal.mem_span_singleton'.mpr ⟨⟨α₁, incl _ _ hsubU _ α₁.2⟩, Subtype.ext ?_⟩
    show (α₁ : L) * (bUV : L) ^ (k₀ + 1) = (p : L) * p - p
    rw [hbUV, hp, hα₁L]
  have hqI : q * q - q ∈ Ideal.span {bUV ^ (k₀ + 1)} := by
    refine Ideal.mem_span_singleton'.mpr
      ⟨⟨(α₂ : L) * algebraMap K L (wcLlsScS W A K t c' b') ^ (k₀ + 1),
        (incl _ _ hsubV _ α₂.2).mul (huUV.pow _)⟩, Subtype.ext ?_⟩
    show (α₂ : L) * algebraMap K L (wcLlsScS W A K t c' b') ^ (k₀ + 1) *
      (bUV : L) ^ (k₀ + 1) = (q : L) * q - q
    rw [hbUV, hq, ← hα₂L, ← hbu]
    ring
  have hpq : p - q ∈ (Ideal.span {bUV}).radical := by
    obtain ⟨k1, β1, hk1⟩ := hJU _ hx₁eJ
    obtain ⟨k2, β2, hk2⟩ := hJV _ hx₂eJ
    obtain ⟨k3, β3, hk3⟩ := hJUV _ hz₀J
    obtain ⟨A1, hA1⟩ : ∃ X : integralClosure (Algebra.adjoin A
        {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L, (X : L) = (x₁ : L) - e₁ :=
      ⟨⟨(x₁ : L) - e₁, incl _ _ hsubU _ (x₁ - e₁).2⟩, rfl⟩
    obtain ⟨A2, hA2⟩ : ∃ X : integralClosure (Algebra.adjoin A
        {wcLlsScS W A K t c' b', wcLlsScV W A K t c' b'}) L, (X : L) = (x₂ : L) - e₂ :=
      ⟨⟨(x₂ : L) - e₂, incl _ _ hsubV _ (x₂ - e₂).2⟩, rfl⟩
    have h1 : A1 ∈ (Ideal.span {bUV}).radical :=
      radUV A1 k1 β1 (incl _ _ hsubU _ β1.2) (by rw [hA1]; exact hk1)
    have h2 : A2 ∈ (Ideal.span {bUV}).radical := by
      refine radUV A2 k2 ((β2 : L) * algebraMap K L (wcLlsScS W A K t c' b'))
        ((incl _ _ hsubV _ β2.2).mul huUV) ?_
      have hk2' : ((x₂ : L) - e₂) ^ k2 =
          algebraMap K L (algebraMap A K (t - algebraMap ↥W A c')) * (β2 : L) := hk2
      rw [hA2, hk2', ← hbu]
      ring
    have h3 : z₀ ∈ (Ideal.span {bUV}).radical := radUV z₀ k3 β3 β3.2 hk3
    have hdec : p - q = A1 - A2 + z₀ := by
      apply Subtype.ext
      show (p : L) - q = (A1 : L) - A2 + z₀
      rw [hp, hq, hA1, hA2, hz₀]
      ring
    rw [hdec]
    exact add_mem (sub_mem h1 h2) h3
  have hpqN := idem_uniq _ bUV p q (k₀ + 1) hpI hqI hpq
  obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hpqN
  have hzL : (z : L) * algebraMap K L (algebraMap A K (algebraMap ↥W A b')) ^ (k₀ + 1) =
      (x₁ : L) - x₂ := by
    rw [← hbUV, ← hp, ← hq]; exact congrArg Subtype.val hz

  obtain ⟨v₁, v₂, hv⟩ := hBd z
  obtain ⟨γU, hγU⟩ : ∃ x : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L,
      (x : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A γ)) := ⟨⟨_, hWint _ γ⟩, rfl⟩
  obtain ⟨γV, hγV⟩ : ∃ x : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L,
      (x : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A γ)) := ⟨⟨_, hWint _ γ⟩, rfl⟩
  obtain ⟨x₁', hx₁'⟩ : ∃ x : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L,
      x = x₁ - bU * γU * v₁ := ⟨_, rfl⟩
  obtain ⟨x₂', hx₂'⟩ : ∃ x : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L,
      x = x₂ + bV * γV * v₂ := ⟨_, rfl⟩
  have heq : (x₁' : L) = (x₂' : L) := by
    rw [hx₁', hx₂']
    show (x₁ : L) - (bU : L) * (γU : L) * (v₁ : L) = (x₂ : L) + (bV : L) * (γV : L) * (v₂ : L)
    rw [hbU, hbV, hγU, hγV]
    linear_combination (-1 : L) * hzL + (z : L) * hN +
      (algebraMap K L (algebraMap A K (algebraMap ↥W A b')) *
        algebraMap K L (algebraMap A K (algebraMap ↥W A γ))) * hv
  have hAint' : IsIntegral A (x₁' : L) :=
    inter _ _ hSV (x₁' : L) x₁'.2 (by rw [heq]; exact x₂'.2)
  obtain ⟨a, haL⟩ : ∃ a : integralClosure A L, (a : L) = (x₁' : L) := ⟨⟨_, hAint'⟩, rfl⟩
  have hd₁ : e₁ - x₁' ∈ wcLlsScJ W A K L t c' b' := by
    have h : e₁ - x₁' = -(x₁ - e₁) + bU * γU * v₁ := by rw [hx₁']; ring
    rw [h]
    exact add_mem (neg_mem hx₁eJ) (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ hbUJ))
  have hd₂ : e₂ - x₂' ∈ wcLlsFcJV W A K L t c' b' := by
    have h : e₂ - x₂' = -(x₂ - e₂) - bV * γV * v₂ := by rw [hx₂']; ring
    rw [h]
    exact sub_mem (neg_mem hx₂eJ) (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ hbVJ))


  have hPD' := hPD
  obtain ⟨-, -, -, hmax, -, hdisc⟩ := hPD'
  obtain ⟨-, hpeq, -⟩ := hdisc
  have emb : ∀ (s : Set K) (a : integralClosure A L), IsIntegral (Algebra.adjoin A s) (a : L) := by
    intro s a
    have := IsIntegral.map_of_comp_eq (algebraMap A (Algebra.adjoin A s)) (RingHom.id L)
      (by ext r; exact (IsScalarTower.algebraMap_apply A K L r).symm) a.2
    simpa using this
  let ιU : integralClosure A L →+* integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L :=
    (integralClosure A L).val.toRingHom.codRestrict
      (integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) (fun a => emb _ a)
  let ιV : integralClosure A L →+* integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L :=
    (integralClosure A L).val.toRingHom.codRestrict
      (integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (fun a => emb _ a)
  have h𝔭U : 𝔭 ≤ (wcLlsScJ W A K L t c' b').comap
      (ιU.comp (algebraMap A (integralClosure A L))) := by
    rw [hpeq, sup_le_iff, Ideal.span_le, Set.singleton_subset_iff, Ideal.map_le_iff_le_comap]
    constructor
    · show ιU (algebraMap A (integralClosure A L) t) ∈ wcLlsScJ W A K L t c' b'
      have e : ιU (algebraMap A (integralClosure A L) t) =
          (⟨_, hWint _ c'⟩ : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L) +
          bU * ⟨_, memK _ _ (Algebra.subset_adjoin (Set.mem_singleton _))⟩ := by
        apply Subtype.ext
        show algebraMap A L t = algebraMap K L (algebraMap A K (algebraMap ↥W A c')) +
          (bU : L) * algebraMap K L (wcLlsScS W A K t c' b')
        rw [hbU, hbu, map_sub, map_sub, IsScalarTower.algebraMap_apply A K L t]; ring
      rw [e]
      refine add_mem ?_ (Ideal.mul_mem_right _ _ hbUJ)
      unfold wcLlsScJ
      exact Ideal.le_radical (Ideal.subset_span ⟨c', hc', rfl⟩)
    · intro w hw
      show ιU (algebraMap A (integralClosure A L) (algebraMap ↥W A w)) ∈ wcLlsScJ W A K L t c' b'
      unfold wcLlsScJ
      exact Ideal.le_radical (Ideal.subset_span ⟨w, hw, IsScalarTower.algebraMap_apply A K L _⟩)
  have h𝔭V : 𝔭 ≤ (wcLlsFcJV W A K L t c' b').comap
      (ιV.comp (algebraMap A (integralClosure A L))) := by
    rw [hpeq, sup_le_iff, Ideal.span_le, Set.singleton_subset_iff, Ideal.map_le_iff_le_comap]
    constructor
    · show ιV (algebraMap A (integralClosure A L) t) ∈ wcLlsFcJV W A K L t c' b'
      have e : ιV (algebraMap A (integralClosure A L) t) =
          (⟨_, hWint _ c'⟩ : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) +
          τV := by
        apply Subtype.ext
        show algebraMap A L t = algebraMap K L (algebraMap A K (algebraMap ↥W A c')) + (τV : L)
        rw [hτV, map_sub, map_sub, IsScalarTower.algebraMap_apply A K L t]; ring
      rw [e]
      unfold wcLlsFcJV
      exact add_mem (Ideal.le_radical (Ideal.subset_span (Or.inl ⟨c', hc', rfl⟩)))
        (Ideal.le_radical (Ideal.subset_span (Or.inr hτV)))
    · intro w hw
      show ιV (algebraMap A (integralClosure A L) (algebraMap ↥W A w)) ∈ wcLlsFcJV W A K L t c' b'
      unfold wcLlsFcJV
      exact Ideal.le_radical
        (Ideal.subset_span (Or.inl ⟨w, hw, IsScalarTower.algebraMap_apply A K L _⟩))
  have hJne := wcpa_dj_llsm_fc_J_ne_top Ω W hW hWt A K L 𝔭 t hPD c' b' hc' hb'm hb'0
  obtain ⟨P, hPmax, hJP⟩ := Ideal.exists_le_maximal _ hJne
  haveI := hPmax.isPrime
  have hPy : P.comap ιU = y := by
    apply hU
    · infer_instance
    · symm
      refine hmax.eq_of_le
        (inferInstance : ((P.comap ιU).comap (algebraMap A (integralClosure A L))).IsPrime).ne_top ?_
      intro p hp
      exact hJP (h𝔭U hp)
  have hJi : ∀ (a : integralClosure A L)
      (x : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L),
      (x : L) = (a : L) → x ∈ wcLlsScJ W A K L t c' b' → a ∈ y := by
    intro a x hx hxJ
    rw [← hPy, Ideal.mem_comap]
    have e : ιU a = x := Subtype.ext hx.symm
    rw [e]; exact hJP hxJ
  have hyrad : ∀ a ∈ y, a ∈ (𝔭.map (algebraMap A (integralClosure A L))).radical := by
    intro a ha
    rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
    intro J hJ
    have hIJ' : Ideal.map (algebraMap A (integralClosure A L)) 𝔭 ≤ (J : Ideal (integralClosure A L)) :=
      hJ.1
    have hJprime : Ideal.IsPrime (J : Ideal (integralClosure A L)) := hJ.2
    have hc : Ideal.comap (algebraMap A (integralClosure A L)) (J : Ideal (integralClosure A L)) = 𝔭 :=
      (hmax.eq_of_le (Ideal.IsPrime.comap _ (hK := hJprime)).ne_top
        (Ideal.map_le_iff_le_comap.mp hIJ')).symm
    rw [hU J hJprime hc]; exact ha
  have hrad : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x : R) (k : ℕ),
      x ^ k ∈ I.radical → x ∈ I.radical := by
    intro R _ I x k h
    have : x ∈ I.radical.radical := ⟨k, h⟩
    rwa [Ideal.radical_idem] at this
  have hJii : ∀ a : integralClosure A L, a ∈ y →
      (∀ x : integralClosure (Algebra.adjoin A {wcLlsScS W A K t c' b'}) L,
        (x : L) = (a : L) → x ∈ wcLlsScJ W A K L t c' b') ∧
      (∀ x : integralClosure (Algebra.adjoin A {wcLlsScV W A K t c' b'}) L,
        (x : L) = (a : L) → x ∈ wcLlsFcJV W A K L t c' b') := by
    intro a ha
    obtain ⟨k, hk⟩ := hyrad a ha
    constructor
    · intro x hx
      have e : ιU a = x := Subtype.ext hx.symm
      have h1 : ιU (a ^ k) ∈ wcLlsScJ W A K L t c' b' := by
        have h0 := Ideal.mem_map_of_mem ιU hk
        rw [Ideal.map_map] at h0
        exact (Ideal.map_le_iff_le_comap.mpr h𝔭U) h0
      rw [map_pow, e] at h1
      unfold wcLlsScJ at h1 ⊢
      exact hrad _ _ _ k h1
    · intro x hx
      have e : ιV a = x := Subtype.ext hx.symm
      have h1 : ιV (a ^ k) ∈ wcLlsFcJV W A K L t c' b' := by
        have h0 := Ideal.mem_map_of_mem ιV hk
        rw [Ideal.map_map] at h0
        exact (Ideal.map_le_iff_le_comap.mpr h𝔭V) h0
      rw [map_pow, e] at h1
      unfold wcLlsFcJV at h1 ⊢
      exact hrad _ _ _ k h1
  have hsq : x₁' * x₁' - x₁' ∈ wcLlsScJ W A K L t c' b' := by
    have h : x₁' * x₁' - x₁' = (e₁ * e₁ - e₁) - (e₁ - x₁') * (e₁ + x₁' - 1) := by ring
    rw [h]
    exact sub_mem he₁ (Ideal.mul_mem_right _ _ hd₁)
  have haa : a * a - a ∈ y := hJi (a * a - a) (x₁' * x₁' - x₁')
    (by show (x₁' : L) * x₁' - x₁' = (a : L) * a - a; rw [haL]) hsq
  have hmul : a * (a - 1) ∈ y := by rw [mul_sub, mul_one]; exact haa
  rcases hy.mem_or_mem hmul with h | h
  · left
    obtain ⟨h1, h2⟩ := hJii a h
    have hx1J := h1 x₁' haL.symm
    have hx2J := h2 x₂' (by rw [haL, heq])
    constructor
    · have := add_mem hd₁ hx1J
      rwa [sub_add_cancel] at this
    · have := add_mem hd₂ hx2J
      rwa [sub_add_cancel] at this
  · right
    obtain ⟨h1, h2⟩ := hJii (a - 1) h
    have hx1J := h1 (x₁' - 1) (by show (x₁' : L) - 1 = (a : L) - 1; rw [haL])
    have hx2J := h2 (x₂' - 1) (by show (x₂' : L) - 1 = (a : L) - 1; rw [haL, heq])
    constructor
    · have := add_mem hd₁ hx1J
      rwa [sub_add_sub_cancel] at this
    · have := add_mem hd₂ hx2J
      rwa [sub_add_sub_cancel] at this

theorem wcpa_dj_llsm_fc_zariski_conn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsFcConnW W A K L t c' b' :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0

  have htc : t - algebraMap ↥W A c' ≠ 0 := by
    obtain ⟨-, -, -, -, -, hm⟩ := hPD
    obtain ⟨-, -, h, hh, f, hfC, hfX, hfet⟩ := hm
    have hh0 : h ≠ 0 := fun h0 => hh (h0 ▸ 𝔭.zero_mem)
    intro h0
    letI := f.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) (Localization.Away h) := hfet
    have hreg : (Polynomial.X - Polynomial.C c') ∈ nonZeroDivisors (Polynomial ↥W) :=
      mem_nonZeroDivisors_of_ne_zero (Polynomial.X_sub_C_ne_zero c')
    have hsm := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Localization.Away h) hreg
    have hC : f (Polynomial.C c') = algebraMap A (Localization.Away h) (algebraMap ↥W A c') :=
      RingHom.congr_fun hfC c'
    have h1 : (Polynomial.X - Polynomial.C c') • (1 : Localization.Away h) = 0 := by
      rw [Algebra.smul_def, mul_one]
      show f (Polynomial.X - Polynomial.C c') = 0
      rw [map_sub, hfX, hC, ← map_sub, h0, map_zero]
    have h1' : (Polynomial.X - Polynomial.C c') • (1 : Localization.Away h) =
        (Polynomial.X - Polynomial.C c') • (0 : Localization.Away h) := by
      rw [h1, smul_zero]
    have h2 : (1 : Localization.Away h) = 0 := hsm h1'
    have h3 : algebraMap A (Localization.Away h) 1 = algebraMap A (Localization.Away h) 0 := by
      rw [map_one, map_zero, h2]
    obtain ⟨⟨_, n, rfl⟩, hn⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h) _).mp h3
    have hn' : h ^ n = 0 := by simpa using hn
    exact hh0 (IsNilpotent.eq_zero ⟨n, hn'⟩)

  exact wcpa_dj_llsm_fcz_conn_of_bound Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0
    htc
    (wcpa_dj_llsm_fcz_bound_of_finite Ω W hW hWt A K L 𝔭 t hPD c' b' hc' hb'm hb'0 htc
      (wcpa_dj_llsm_fcz_normalization_finite Ω W hW hWt A K L 𝔭 t hPD c' b' hc' hb'm hb'0 htc))

theorem wcpa_dj_llsm_fcw_fibre_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → (Ideal.map (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) 𝔭).IsPrime ∧ (⟨wcLlsScV W A K t c' b', Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) ∉ Ideal.map (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) 𝔭 :=
by
  have wcpa_dj_llsmacr_rees_kernel : ∀ (B : Type u) [CommRing B] [IsDomain B] (K : Type u)
      [Field K] [Algebra B K], Function.Injective (algebraMap B K) → ∀ (h a : B), h ≠ 0 →
      (∀ x : B, a * x ∈ Ideal.span {h} → x ∈ Ideal.span {h}) →
      RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) =
        Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} := by
    intro B _ _ K _ _ hinj h a hh hreg
    have hιh : algebraMap B K h ≠ 0 := by
      intro h0
      apply hh
      apply hinj
      rw [h0, map_zero]
    have hhr : algebraMap B K h * (algebraMap B K a / algebraMap B K h) = algebraMap B K a :=
      mul_div_cancel₀ _ hιh
    have s1 : Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} ≤
        RingHom.ker (Polynomial.aeval (R := B) (algebraMap B K a / algebraMap B K h)) := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      show _ ∈ RingHom.ker _
      rw [RingHom.mem_ker, map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_C,
        Polynomial.aeval_X, hhr, sub_self]
    have s2 : ∀ P : Polynomial B,
        Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
        h ∣ P.leadingCoeff * a ^ P.natDegree := by
      intro P hP
      have hev : Polynomial.eval a (P.scaleRoots h) = 0 := by
        apply hinj
        rw [map_zero, ← Polynomial.eval₂_at_apply, ← hhr, Polynomial.scaleRoots_eval₂_mul,
          ← Polynomial.aeval_def, hP, mul_zero]
      rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots, Finset.sum_range_succ]
        at hev
      simp only [Polynomial.coeff_scaleRoots, Nat.sub_self, pow_zero, mul_one] at hev
      have hS : h ∣ ∑ i ∈ Finset.range P.natDegree,
          P.coeff i * h ^ (P.natDegree - i) * a ^ i := by
        apply Finset.dvd_sum
        intro i hi
        have hi' := Finset.mem_range.mp hi
        apply Dvd.dvd.mul_right
        apply Dvd.dvd.mul_left
        exact dvd_pow_self h (by omega)
      have hlc : P.leadingCoeff * a ^ P.natDegree = -(∑ i ∈ Finset.range P.natDegree,
          P.coeff i * h ^ (P.natDegree - i) * a ^ i) := by
        rw [Polynomial.leadingCoeff]
        linear_combination hev
      rw [hlc]
      exact dvd_neg.mpr hS
    have s3 : ∀ (m : ℕ) (x : B), a ^ m * x ∈ Ideal.span {h} → x ∈ Ideal.span {h} := by
      intro m
      induction m with
      | zero => intro x hx; simpa using hx
      | succ m ih =>
        intro x hx
        apply ih
        apply hreg
        rw [← mul_assoc, ← pow_succ']
        exact hx
    have s4 : ∀ (P : Polynomial B) (q : B), 1 ≤ P.natDegree → P.leadingCoeff = h * q →
        (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
          (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree < P.natDegree := by
      intro P q hn hq
      have hXn : (Polynomial.X : Polynomial B) ^ P.natDegree =
          Polynomial.X ^ (P.natDegree - 1) * Polynomial.X := by
        rw [← pow_succ]
        congr 1
        omega
      have hD : Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
          (Polynomial.C h * Polynomial.X - Polynomial.C a) =
          Polynomial.C (q * h) * Polynomial.X ^ P.natDegree -
            Polynomial.C (q * a) * Polynomial.X ^ (P.natDegree - 1) := by
        rw [hXn, Polynomial.C_mul, Polynomial.C_mul]
        ring
      have hle : (P - Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
          (Polynomial.C h * Polynomial.X - Polynomial.C a)).natDegree ≤ P.natDegree - 1 := by
        rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro N hN
        rw [hD, Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_C_mul_X_pow,
          Polynomial.coeff_C_mul_X_pow]
        have hN1 : N ≠ P.natDegree - 1 := by
          have : P.natDegree - 1 < N := by exact_mod_cast hN
          omega
        rw [if_neg hN1]
        by_cases hNn : N = P.natDegree
        · rw [if_pos hNn, hNn, Polynomial.coeff_natDegree, hq]
          ring
        · have : P.natDegree - 1 < N := by exact_mod_cast hN
          rw [if_neg hNn, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
          ring
      omega
    have s5 : ∀ n : ℕ, ∀ P : Polynomial B, P.natDegree = n →
        Polynomial.aeval (algebraMap B K a / algebraMap B K h) P = 0 →
        P ∈ Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
        intro P hPn hP
        rcases Nat.eq_zero_or_pos n with h0 | hpos
        · have hPC := Polynomial.eq_C_of_natDegree_eq_zero (hPn.trans h0)
          rw [hPC, Polynomial.aeval_C] at hP
          have hc : P.coeff 0 = 0 := hinj (by rw [hP, map_zero])
          rw [hPC, hc, map_zero]
          exact Ideal.zero_mem _
        · subst hPn
          have hd := s2 P hP
          have hmem : a ^ P.natDegree * P.leadingCoeff ∈ Ideal.span {h} := by
            rw [Ideal.mem_span_singleton, mul_comm]
            exact hd
          obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp (s3 _ _ hmem)
          have hDI : Polynomial.C q * Polynomial.X ^ (P.natDegree - 1) *
              (Polynomial.C h * Polynomial.X - Polynomial.C a) ∈
              Ideal.span {Polynomial.C h * Polynomial.X - Polynomial.C a} :=
            Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
          have hDk := RingHom.mem_ker.mp (s1 hDI)
          have hlt := s4 P q hpos hq
          have hP' := ih _ hlt _ rfl (by rw [map_sub, hP, hDk, sub_zero])
          have := Ideal.add_mem _ hP' hDI
          rwa [sub_add_cancel] at this
    exact le_antisymm (fun P hP => s5 _ P rfl (RingHom.mem_ker.mp hP)) s1
  have wcpa_dj_llsm_brrc_regular_pair : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
      (B : Type u) [CommRing B] [IsDomain B] [Algebra ↥W B] (f : Polynomial ↥W →+* B) (c b : ↥W),
      f.Etale → f.comp Polynomial.C = algebraMap ↥W B → b ≠ 0 →
      algebraMap ↥W B b ≠ 0 ∧
        ∀ x : B, (f Polynomial.X - algebraMap ↥W B c) * x ∈ Ideal.span {algebraMap ↥W B b} →
          x ∈ Ideal.span {algebraMap ↥W B b} := by
    have transfer : ∀ (P S : Type u) [CommRing P] [CommRing S] [Algebra P S] [Module.Flat P S]
        (p r : P), (∀ y : P, r * y ∈ Ideal.span {p} → y ∈ Ideal.span {p}) →
        ∀ x : S, algebraMap P S r * x ∈ Ideal.span {algebraMap P S p} →
          x ∈ Ideal.span {algebraMap P S p} := by
      intro P S _ _ _ _ p r hreg x hx
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hx
      let f : Fin 2 → P := ![r, p]
      let v : Fin 2 → S := ![x, -y]
      have hrel : ∑ i, f i • v i = 0 := by
        rw [Fin.sum_univ_two]
        show r • x + p • (-y) = 0
        rw [Algebra.smul_def, Algebra.smul_def, ← hy]; ring
      obtain ⟨k, A, z, hx', hA⟩ :=
        Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P) (M := S) hrel
      have hx0 : x = ∑ j, A 0 j • z j := hx' 0
      have hdiv : ∀ j, A 0 j ∈ Ideal.span {p} := by
        intro j
        apply hreg
        have h3 : ∑ i, f i * A i j = 0 := hA j
        rw [Fin.sum_univ_two] at h3
        change r * A 0 j + p * A 1 j = 0 at h3
        rw [Ideal.mem_span_singleton']
        exact ⟨-A 1 j, by linear_combination -h3⟩
      choose s hs using fun j => Ideal.mem_span_singleton'.mp (hdiv j)
      rw [hx0, Ideal.mem_span_singleton']
      refine ⟨∑ j, algebraMap P S (s j) * z j, ?_⟩
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Algebra.smul_def, ← hs j, map_mul]
      ring
    intro Ω _ W B _ _ _ f c b hf hfC hb
    classical
    have poly : ∀ y : Polynomial ↥W, (Polynomial.X - Polynomial.C c) * y ∈
        Ideal.span {Polynomial.C b} → y ∈ Ideal.span {Polynomial.C b} := by
      intro y hy
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hy
      have hπb : Ideal.Quotient.mk (Ideal.span {b}) b = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self b)
      have h1 := congrArg (Polynomial.map (Ideal.Quotient.mk (Ideal.span {b}))) hz
      rw [Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C, hπb, map_zero, mul_zero,
        Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C] at h1
      have h2 : Polynomial.map (Ideal.Quotient.mk (Ideal.span {b})) y = 0 :=
        (Polynomial.Monic.mul_right_eq_zero_iff (Polynomial.monic_X_sub_C _)).mp h1.symm
      rw [Ideal.mem_span_singleton, Polynomial.C_dvd_iff_dvd_coeff]
      intro n
      have h3 : Ideal.Quotient.mk (Ideal.span {b}) (y.coeff n) = 0 := by
        rw [← Polynomial.coeff_map, h2, Polynomial.coeff_zero]
      exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h3)
    have hCb : (Polynomial.C b : Polynomial ↥W) ≠ 0 := by
      rw [Ne, Polynomial.C_eq_zero]; exact hb
    have hsr : IsSMulRegular (Polynomial ↥W) (Polynomial.C b) :=
      IsLeftRegular.isSMulRegular (mul_right_injective₀ hCb)
    have hfb : f (Polynomial.C b) = algebraMap ↥W B b := by
      rw [← hfC, RingHom.comp_apply]
    have hfr : f (Polynomial.X - Polynomial.C c) = f Polynomial.X - algebraMap ↥W B c := by
      rw [map_sub, ← hfC, RingHom.comp_apply]
    letI : Algebra (Polynomial ↥W) B := f.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) B := hf
    haveI : Module.Flat (Polynomial ↥W) B := inferInstance
    have halg : ∀ q, algebraMap (Polynomial ↥W) B q = f q := fun q => rfl
    have hsrB : IsSMulRegular B (algebraMap (Polynomial ↥W) B (Polynomial.C b)) := hsr.of_flat
    have htr := transfer (Polynomial ↥W) B (Polynomial.C b) (Polynomial.X - Polynomial.C c) poly
    simp only [halg] at htr hsrB
    refine ⟨?_, ?_⟩
    · rw [← hfb]
      intro h0
      apply one_ne_zero (α := B)
      apply hsrB
      show f (Polynomial.C b) * 1 = f (Polynomial.C b) * 0
      rw [h0, zero_mul, zero_mul]
    · intro x hx
      rw [← hfb, ← hfr] at hx
      rw [← hfb]
      exact htr x hx
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD c' b' hc' hb' hb'0
  classical
  obtain ⟨_, _, _, hmax, hm, ht, _, h, hh, f, hfC, hfX, hfet⟩ := hPD
  have h𝔭 : 𝔭.IsPrime := hmax.isPrime
  have hβ𝔭 : algebraMap ↥W A b' ∈ 𝔭 := hm (Ideal.mem_map_of_mem _ hb')
  have hγ𝔭 : algebraMap ↥W A c' ∈ 𝔭 := hm (Ideal.mem_map_of_mem _ hc')
  have hτ𝔭 : t - algebraMap ↥W A c' ∈ 𝔭 := Ideal.sub_mem _ ht hγ𝔭

  have hh0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
  haveI hBdom : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
  have hdisj : Disjoint (Submonoid.powers h : Set A) (𝔭 : Set A) :=
    (Ideal.disjoint_powers_iff_notMem h h𝔭.isRadical).mpr hh
  have hunder : (𝔭.map (algebraMap A (Localization.Away h))).comap
      (algebraMap A (Localization.Away h)) = 𝔭 :=
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h)
      h𝔭 hdisj

  have hfC' : f.comp Polynomial.C = algebraMap ↥W (Localization.Away h) := by
    rw [hfC, IsScalarTower.algebraMap_eq ↥W A (Localization.Away h)]
  obtain ⟨hR0, hR1⟩ := wcpa_dj_llsm_brrc_regular_pair Ω W (Localization.Away h) f c' b' hfet
    hfC' hb'0
  have eτ : f Polynomial.X - algebraMap ↥W (Localization.Away h) c' =
      algebraMap A (Localization.Away h) (t - algebraMap ↥W A c') := by
    rw [hfX, IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) c', map_sub]
  have eβ : algebraMap ↥W (Localization.Away h) b' =
      algebraMap A (Localization.Away h) (algebraMap ↥W A b') :=
    IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) b'
  rw [eτ, eβ] at hR1
  rw [eβ] at hR0
  have hβnu : ¬ IsUnit (algebraMap A (Localization.Away h) (algebraMap ↥W A b')) := by
    intro hu
    have htop : 𝔭.map (algebraMap A (Localization.Away h)) = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hβ𝔭) hu
    apply h𝔭.ne_top
    rw [← hunder, htop, Ideal.comap_top]
  have hτ0 : algebraMap A (Localization.Away h) (t - algebraMap ↥W A c') ≠ 0 := by
    intro e
    apply hβnu
    have h1 := hR1 1 (by rw [e, zero_mul]; exact Ideal.zero_mem _)
    exact Ideal.span_singleton_eq_top.mp ((Ideal.eq_top_iff_one _).mpr h1)
  have hreg : ∀ x : Localization.Away h,
      algebraMap A (Localization.Away h) (algebraMap ↥W A b') * x ∈
        Ideal.span {algebraMap A (Localization.Away h) (t - algebraMap ↥W A c')} →
      x ∈ Ideal.span {algebraMap A (Localization.Away h) (t - algebraMap ↥W A c')} := by
    intro x hx
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hx
    have hy' : algebraMap A (Localization.Away h) (t - algebraMap ↥W A c') * y ∈
        Ideal.span {algebraMap A (Localization.Away h) (algebraMap ↥W A b')} := by
      rw [mul_comm, hy]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp (hR1 y hy')
    have e0 : algebraMap A (Localization.Away h) (algebraMap ↥W A b') *
        (x - z * algebraMap A (Localization.Away h) (t - algebraMap ↥W A c')) = 0 := by
      rw [mul_sub, ← hy, ← hz]; ring
    have hx' : x = z * algebraMap A (Localization.Away h) (t - algebraMap ↥W A c') :=
      sub_eq_zero.mp ((mul_eq_zero.mp e0).resolve_left hR0)
    rw [hx']
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

  have hhK : IsUnit (algebraMap A K h) :=
    isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hh0)
  letI : Algebra (Localization.Away h) K := (IsLocalization.Away.lift h hhK).toAlgebra
  haveI : IsScalarTower A (Localization.Away h) K :=
    IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.Away.lift_eq h hhK x).symm)
  haveI : IsFractionRing (Localization.Away h) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers h)
      (Localization.Away h) K
  have hinj : Function.Injective (algebraMap (Localization.Away h) K) :=
    IsFractionRing.injective (Localization.Away h) K
  have hker := wcpa_dj_llsmacr_rees_kernel (Localization.Away h) K hinj
    (algebraMap A (Localization.Away h) (t - algebraMap ↥W A c'))
    (algebraMap A (Localization.Away h) (algebraMap ↥W A b')) hτ0 hreg
  have hv : algebraMap (Localization.Away h) K
        (algebraMap A (Localization.Away h) (algebraMap ↥W A b')) /
      algebraMap (Localization.Away h) K
        (algebraMap A (Localization.Away h) (t - algebraMap ↥W A c')) =
      wcLlsScV W A K t c' b' := by
    rw [← IsScalarTower.algebraMap_apply A (Localization.Away h) K,
      ← IsScalarTower.algebraMap_apply A (Localization.Away h) K]
    rfl
  rw [hv] at hker
  have hτB : algebraMap A (Localization.Away h) (t - algebraMap ↥W A c') ∈
      𝔭.map (algebraMap A (Localization.Away h)) := Ideal.mem_map_of_mem _ hτ𝔭
  have hβB : algebraMap A (Localization.Away h) (algebraMap ↥W A b') ∈
      𝔭.map (algebraMap A (Localization.Away h)) := Ideal.mem_map_of_mem _ hβ𝔭
  have hgP : Polynomial.C (algebraMap A (Localization.Away h) (t - algebraMap ↥W A c')) *
        Polynomial.X - Polynomial.C (algebraMap A (Localization.Away h) (algebraMap ↥W A b')) ∈
      Ideal.map Polynomial.C (𝔭.map (algebraMap A (Localization.Away h))) := by
    rw [Ideal.mem_map_C_iff]
    intro k
    rw [Polynomial.coeff_sub, Polynomial.coeff_C_mul_X, Polynomial.coeff_C]
    split_ifs with h1 h0
    · omega
    · rw [sub_zero]; exact hτB
    · rw [zero_sub]; exact neg_mem hβB
    · rw [sub_zero]; exact Ideal.zero_mem _
  have hcoef : ∀ p : Polynomial A, Polynomial.aeval (wcLlsScV W A K t c' b') p = 0 →
      ∀ n : ℕ, p.coeff n ∈ 𝔭 := by
    intro p hp n
    have hpB : p.map (algebraMap A (Localization.Away h)) ∈ Ideal.span
        {Polynomial.C (algebraMap A (Localization.Away h) (t - algebraMap ↥W A c')) *
          Polynomial.X - Polynomial.C (algebraMap A (Localization.Away h) (algebraMap ↥W A b'))} := by
      rw [← hker, RingHom.mem_ker, Polynomial.aeval_map_algebraMap]
      exact hp
    have hpP := (Ideal.span_singleton_le_iff_mem _).mpr hgP hpB
    have hn := (Ideal.mem_map_C_iff.mp hpP) n
    rw [Polynomial.coeff_map] at hn
    rw [← hunder]
    exact Ideal.mem_comap.mpr hn

  generalize wcLlsScV W A K t c' b' = v at hcoef ⊢
  let α : Polynomial A →+* ↥(Algebra.adjoin A {v}) :=
    (Polynomial.aeval (⟨v, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
      ↥(Algebra.adjoin A {v}))).toRingHom
  have hαval : ∀ p : Polynomial A, ((α p : ↥(Algebra.adjoin A {v})) : K) =
      Polynomial.aeval v p := fun p =>
    (Polynomial.aeval_algHom_apply (Algebra.adjoin A {v}).val _ p).symm
  have hsurj : Function.Surjective α := by
    intro y
    have hy : (y : K) ∈ (Polynomial.aeval (R := A) v).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]
      exact y.2
    obtain ⟨p, hp⟩ := hy
    exact ⟨p, Subtype.ext ((hαval p).trans hp)⟩
  have hkerα : RingHom.ker α ≤ Ideal.map Polynomial.C 𝔭 := by
    intro p hp
    rw [RingHom.mem_ker] at hp
    rw [Ideal.mem_map_C_iff]
    exact hcoef p (by rw [← hαval, hp]; rfl)
  have hαC : α.comp Polynomial.C = algebraMap A ↥(Algebra.adjoin A {v}) :=
    RingHom.ext fun a => Polynomial.aeval_C _ a
  have hmapeq : Ideal.map α (Ideal.map Polynomial.C 𝔭) =
      Ideal.map (algebraMap A ↥(Algebra.adjoin A {v})) 𝔭 := by
    rw [Ideal.map_map, hαC]
  haveI hP : (Ideal.map Polynomial.C 𝔭 : Ideal (Polynomial A)).IsPrime := by
    haveI := h𝔭
    exact Ideal.isPrime_map_C_of_isPrime
  refine ⟨?_, ?_⟩
  · rw [← hmapeq]
    exact Ideal.map_isPrime_of_surjective hsurj hkerα
  · rw [← hmapeq]
    intro hX
    have hαX : α Polynomial.X =
        (⟨v, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {v})) :=
      Polynomial.aeval_X _
    have hX' : (Polynomial.X : Polynomial A) ∈
        Ideal.comap α (Ideal.map α (Ideal.map Polynomial.C 𝔭)) := by
      rw [Ideal.mem_comap, hαX]
      exact hX
    rw [Ideal.comap_map_of_surjective α hsurj,
      sup_eq_left.mpr (show Ideal.comap α ⊥ ≤ Ideal.map Polynomial.C 𝔭 from hkerα)] at hX'
    have h1 := Ideal.mem_map_C_iff.mp hX' 1
    rw [Polynomial.coeff_X_one] at h1
    exact h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

theorem wcpa_dj_llsm_fcw_chart_normal : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → ∃ h : A, h ∉ 𝔭 ∧ ∀ z : K, IsIntegral ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) z → ∃ (n : ℕ) (r : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})), (r : K) = algebraMap A K h ^ n * z :=
by
  intro Ω _ W A _ _ _ K _ _ _ 𝔭 t hPD c' b' hc' hb' hb0
  classical
  unfold wcLlsPD at hPD
  obtain ⟨_, _, _, _, _, _, _, h, hh, f, hfC, hfX, hfet⟩ := hPD
  refine ⟨h, hh, ?_⟩

  have hh0 : h ≠ 0 := fun e => hh (e ▸ 𝔭.zero_mem)
  haveI hBdom : IsDomain (Localization.Away h) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hh0)
  have hu : IsUnit (algebraMap A K h) :=
    isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr hh0)
  letI : Algebra (Localization.Away h) K := (IsLocalization.Away.lift h hu).toAlgebra
  haveI : IsScalarTower A (Localization.Away h) K :=
    IsScalarTower.of_algebraMap_eq (fun a => (IsLocalization.Away.lift_eq h hu a).symm)
  haveI : IsFractionRing (Localization.Away h) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers h)
      (Localization.Away h) K
  have hinj : Function.Injective (algebraMap (Localization.Away h) K) :=
    IsFractionRing.injective (Localization.Away h) K

  obtain ⟨g, hgdef⟩ : ∃ g : MvPolynomial (Fin 1) ↥W →+* Localization.Away h,
      g = f.comp (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).toRingEquiv.toRingHom := ⟨_, rfl⟩
  have hg : g.Etale := by
    rw [hgdef]
    exact RingHom.Etale.respectsIso.2 _ _ hfet
  have hgC : g.comp MvPolynomial.C = algebraMap ↥W (Localization.Away h) := by
    refine RingHom.ext fun w => ?_
    have e1 : (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)) (MvPolynomial.C w) = Polynomial.C w := by
      rw [MvPolynomial.uniqueAlgEquiv_apply, MvPolynomial.eval₂_C]
    have e2 := RingHom.congr_fun hfC w
    simp only [RingHom.comp_apply] at e2
    rw [hgdef]
    show f ((MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)) (MvPolynomial.C w)) = _
    rw [e1, e2, ← IsScalarTower.algebraMap_apply]
  have hgX : g (MvPolynomial.X 0) = algebraMap A (Localization.Away h) t := by
    rw [hgdef]
    show f ((MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)) (MvPolynomial.X 0)) = _
    rw [MvPolynomial.uniqueAlgEquiv_apply, MvPolynomial.eval₂_X, hfX]
  have hV : wcLlsaS W K (g (MvPolynomial.X 0)) c' b' = wcLlsScV W A K t c' b' := by
    rw [hgX]
    show algebraMap (Localization.Away h) K (algebraMap ↥W (Localization.Away h) b') /
        algebraMap (Localization.Away h) K
          (algebraMap A (Localization.Away h) t - algebraMap ↥W (Localization.Away h) c') =
      algebraMap A K (algebraMap ↥W A b') / algebraMap A K (t - algebraMap ↥W A c')
    rw [IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) b',
      IsScalarTower.algebraMap_apply ↥W A (Localization.Away h) c', ← map_sub,
      ← IsScalarTower.algebraMap_apply A (Localization.Away h) K,
      ← IsScalarTower.algebraMap_apply A (Localization.Away h) K]

  have hreg := wcpa_dj_llsmacr_regular_pair Ω W (Localization.Away h) g c' b' hg hgC hb0
  have hker := wcpa_dj_llsmacr_rees_kernel (Localization.Away h) K hinj
    (g (MvPolynomial.X 0) - algebraMap ↥W (Localization.Away h) c')
    (algebraMap ↥W (Localization.Away h) b') hreg.1 hreg.2
  obtain ⟨ψ, -, -, -, hψ⟩ := wcpa_dj_llsmacr_annulus_etale Ω W (Localization.Away h) K g c' b'
    hinj hg hgC hreg.1 hker.le
  obtain ⟨hNd, hNic⟩ := wcNd_nodal_poly_normal Ω W b' hb0
  haveI := hNd
  haveI := hNic
  letI : Algebra (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b'})
      (wcLlsaA W K (g (MvPolynomial.X 0)) c' b') := ψ.toAlgebra
  haveI : Algebra.Etale (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b'})
      (wcLlsaA W K (g (MvPolynomial.X 0)) c' b') := RingHom.etale_algebraMap.mp hψ
  have hIC : IsIntegrallyClosed ↥(Algebra.adjoin (Localization.Away h)
      {wcLlsaS W K (g (MvPolynomial.X 0)) c' b'}) := by
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    haveI : p.IsPrime := hpm.isPrime
    exact (wc_pks_etale_localization_normal (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b'})
      (wcLlsaA W K (g (MvPolynomial.X 0)) c' b') p).2
  rw [hV] at hIC
  haveI := hIC

  have hclear : ∀ y ∈ Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c' b'},
      ∃ n : ℕ, algebraMap A K h ^ n * y ∈ Algebra.adjoin A {wcLlsScV W A K t c' b'} := by
    have hη : algebraMap A K h ∈ Algebra.adjoin A {wcLlsScV W A K t c' b'} :=
      Subalgebra.algebraMap_mem _ h
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨0, ?_⟩
      rw [Set.mem_singleton_iff.mp hx, pow_zero, one_mul]
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap b =>
      obtain ⟨n, a, hb⟩ := IsLocalization.Away.surj h b
      refine ⟨n, ?_⟩
      have e : algebraMap A K h ^ n * algebraMap (Localization.Away h) K b = algebraMap A K a := by
        have e3 := congrArg (algebraMap (Localization.Away h) K) hb
        rw [map_mul, map_pow, ← IsScalarTower.algebraMap_apply A (Localization.Away h) K,
          ← IsScalarTower.algebraMap_apply A (Localization.Away h) K] at e3
        rw [mul_comm]
        exact e3
      rw [e]
      exact Subalgebra.algebraMap_mem _ a
    | add x y _ _ hx hy =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, ?_⟩
      have e : algebraMap A K h ^ (n₁ + n₂) * (x + y) =
          algebraMap A K h ^ n₂ * (algebraMap A K h ^ n₁ * x) +
            algebraMap A K h ^ n₁ * (algebraMap A K h ^ n₂ * y) := by ring
      rw [e]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hη _) h₁)
        (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hη _) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨n₁, h₁⟩ := hx
      obtain ⟨n₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, ?_⟩
      have e : algebraMap A K h ^ (n₁ + n₂) * (x * y) =
          (algebraMap A K h ^ n₁ * x) * (algebraMap A K h ^ n₂ * y) := by ring
      rw [e]
      exact Subalgebra.mul_mem _ h₁ h₂

  intro z hz
  have hle : Algebra.adjoin A {wcLlsScV W A K t c' b'} ≤
      (Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c' b'}).restrictScalars A :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr (Algebra.subset_adjoin (Set.mem_singleton _)))
  let φ : ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) →+*
      ↥(Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c' b'}) :=
    { toFun := fun x => ⟨x, hle x.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hzB : IsIntegral ↥(Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c' b'}) z :=
    IsIntegral.map_of_comp_eq φ (RingHom.id K) (RingHom.ext fun _ => rfl) hz
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hzB
  have hzmem : z ∈ Algebra.adjoin (Localization.Away h) {wcLlsScV W A K t c' b'} := by
    rw [← hy]
    exact y.2
  obtain ⟨n, hn⟩ := hclear z hzmem
  exact ⟨n, ⟨_, hn⟩, rfl⟩

theorem wcpa_dj_llsm_fcw_galois_transitive : ∀ (R : Type u) [CommRing R] (K : Type u) [Field K] [Algebra R K] (L : Type u) [Field L] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [FiniteDimensional K L] [IsGalois K L] (Q : Ideal R) (h : R), h ∉ Q → (∀ z : K, IsIntegral R z → ∃ (n : ℕ) (r : R), algebraMap R K r = algebraMap R K h ^ n * z) → ∀ P P' : Ideal ↥(integralClosure R L), P.IsPrime → P'.IsPrime → P.comap (algebraMap R ↥(integralClosure R L)) = Q → P'.comap (algebraMap R ↥(integralClosure R L)) = Q → ∃ σ : L ≃ₐ[K] L, ∀ x y : ↥(integralClosure R L), (y : L) = σ (x : L) → (x ∈ P ↔ y ∈ P') :=
by
  intro R _ K _ _ L _ _ _ _ _ _ Q h hhQ hN P P' hP hP' hPc hP'c
  classical
  have s1 : ∀ P P' : Ideal ↥(integralClosure R L), P.IsPrime → P'.IsPrime →
      P.comap (algebraMap R ↥(integralClosure R L)) = Q →
      P'.comap (algebraMap R ↥(integralClosure R L)) = Q →
      ∀ b : ↥(integralClosure R L), (∀ σ : L ≃ₐ[K] L, σ (b : L) = (b : L)) → b ∈ P → b ∈ P' := by
    intro P P' hP hP' hPc hP'c b hb hbP
    obtain ⟨z, hz⟩ : (b : L) ∈ Set.range (algebraMap K L) :=
      (IsGalois.mem_range_algebraMap_iff_fixed (b : L)).mpr hb
    have hzi : IsIntegral R z := by
      have hb2 : IsIntegral R (b : L) := b.2
      rw [← hz] at hb2
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom R K L) (algebraMap K L).injective).mp hb2
    obtain ⟨n, r, hr⟩ := hN z hzi
    have hrb : algebraMap R (integralClosure R L) r =
        (algebraMap R (integralClosure R L) h) ^ n * b := by
      apply Subtype.ext
      have := congrArg (algebraMap K L) hr
      rw [map_mul, map_pow, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply,
        hz] at this
      simpa using this
    have h1 : algebraMap R (integralClosure R L) r ∈ P := by
      rw [hrb]; exact Ideal.mul_mem_left _ _ hbP
    have h2 : r ∈ Q := by rw [← hPc]; exact h1
    have h3 : algebraMap R (integralClosure R L) r ∈ P' := by
      rw [← hP'c] at h2; exact h2
    rw [hrb] at h3
    rcases hP'.mem_or_mem h3 with h4 | h4
    · exfalso
      apply hhQ
      rw [← hP'c]
      exact Ideal.mem_comap.mpr (hP'.mem_of_pow_mem n h4)
    · exact h4
  let G := L ≃ₐ[K] L
  let B := ↥(integralClosure R L)
  let A' := FixedPoints.subring B G
  haveI : Algebra.IsInvariant A' B G := ⟨fun b hb => ⟨⟨b, hb⟩, rfl⟩⟩
  have hcoe : ∀ (g : L ≃ₐ[K] L) (b : B), ((g • b : B) : L) = g (b : L) := fun g b => by
    rw [integralClosure.coe_smul]; rfl
  have s3 : Ideal.under A' P = Ideal.under A' P' := by
    ext a
    rw [Ideal.under_def, Ideal.under_def, Ideal.mem_comap, Ideal.mem_comap]
    have hfix : ∀ σ : L ≃ₐ[K] L, σ ((a : B) : L) = ((a : B) : L) := fun σ => by
      rw [← hcoe]; exact congrArg Subtype.val (a.2 σ)
    exact ⟨s1 P P' hP hP' hPc hP'c _ hfix, s1 P' P hP' hP hP'c hPc _ hfix⟩
  obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A' B G P P' s3
  refine ⟨g, fun x y hxy => ?_⟩
  have hy : y = g • x := Subtype.ext (by rw [hcoe]; exact hxy)
  rw [hy, hg, Ideal.smul_mem_pointwise_smul_iff]

theorem wcpa_dj_llsm_fcw_J_le_iff : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → ∀ 𝔓 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L), 𝔓.IsPrime → (wcLlsFcJV W A K L t c' b' ≤ 𝔓 ↔ Ideal.map (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) 𝔭 ≤ 𝔓.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L))) :=
by
  intro Ω _ W A _ _ K _ _ L _ _ 𝔭 t hPD c' b' hc'
  simp only [wcLlsPD] at hPD
  obtain ⟨-, -, -, -, hm, ht, hpeq, -⟩ := hPD
  set R := Algebra.adjoin A {wcLlsScV W A K t c' b'}
  set S := integralClosure ↥R L
  intro 𝔓 h𝔓
  have CI : ∀ a : A, (((algebraMap ↥R ↥S (algebraMap A ↥R a)) : ↥S) : L) =
      algebraMap K L (algebraMap A K a) := fun a => rfl
  have hwm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥W A w ∈ 𝔭 :=
    fun w hw => hm (Ideal.mem_map_of_mem _ hw)
  have htc : t - algebraMap ↥W A c' ∈ 𝔭 := Ideal.sub_mem _ ht (hwm c' hc')
  have CI' : ∀ (z : ↥S) (a : A), (z : L) = algebraMap K L (algebraMap A K a) →
      z = algebraMap ↥R ↥S (algebraMap A ↥R a) :=
    fun z a h => Subtype.ext (h.trans (CI a).symm)
  have hRHS : Ideal.map (algebraMap A ↥R) 𝔭 ≤ 𝔓.comap (algebraMap ↥R ↥S) ↔
      ∀ a ∈ 𝔭, algebraMap ↥R ↥S (algebraMap A ↥R a) ∈ 𝔓 := by
    rw [Ideal.map_le_iff_le_comap]
    constructor
    · intro h a ha; exact h ha
    · intro h a ha; exact h a ha
  rw [hRHS]
  unfold wcLlsFcJV
  constructor
  · intro hJ
    have hgen : ∀ z : ↥S, ((∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (z : L) = algebraMap K L (algebraMap A K (algebraMap ↥W A w))) ∨
        (z : L) = algebraMap K L (algebraMap A K (t - algebraMap ↥W A c'))) → z ∈ 𝔓 :=
      fun z hz => hJ (Ideal.le_radical (Ideal.subset_span hz))
    have hw : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        algebraMap ↥R ↥S (algebraMap A ↥R (algebraMap ↥W A w)) ∈ 𝔓 :=
      fun w hw => hgen _ (Or.inl ⟨w, hw, CI _⟩)
    have htc' : algebraMap ↥R ↥S (algebraMap A ↥R (t - algebraMap ↥W A c')) ∈ 𝔓 :=
      hgen _ (Or.inr (CI _))
    have hsum : algebraMap ↥R ↥S (algebraMap A ↥R t) =
        algebraMap ↥R ↥S (algebraMap A ↥R (t - algebraMap ↥W A c')) +
          algebraMap ↥R ↥S (algebraMap A ↥R (algebraMap ↥W A c')) := by
      rw [← map_add, ← map_add, sub_add_cancel]
    have hle : 𝔭 ≤ 𝔓.comap ((algebraMap ↥R ↥S).comp (algebraMap A ↥R)) := by
      rw [hpeq]
      refine sup_le ?_ ?_
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, RingHom.comp_apply, hsum]
        exact Ideal.add_mem _ htc' (hw c' hc')
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw'
        exact hw w hw'
    intro a ha
    exact hle ha
  · intro h
    rw [h𝔓.radical_le_iff, Ideal.span_le]
    rintro z (⟨w, hw, hz⟩ | hz)
    · rw [CI' z _ hz]; exact h _ (hwm w hw)
    · rw [CI' z _ hz]; exact h _ htc

theorem wcpa_dj_llsm_fc_W_components_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsFcFin W A K L t c' b' :=
by
  intro Ω _ _ W _hW _hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t hPD c' b' hc' hb'm hb'0
  classical

  have main : ∀ (R : Type u) [CommRing R] [Algebra R K] [Algebra R L] [IsScalarTower R K L],
      Function.Injective (algebraMap R K) →
      ∀ (I₀ : Ideal R) (J : Ideal ↥(integralClosure R L)) (h : R), I₀.IsPrime →
      (∀ 𝔓 : Ideal ↥(integralClosure R L), 𝔓.IsPrime →
        (J ≤ 𝔓 ↔ I₀ ≤ 𝔓.comap (algebraMap R ↥(integralClosure R L)))) →
      (∀ Q : Ideal R, Q.IsPrime → I₀ ≤ Q → h ∉ Q) →
      (∀ z : K, IsIntegral R z → ∃ (n : ℕ) (r : R), algebraMap R K r = algebraMap R K h ^ n * z) →
      J.minimalPrimes.Finite ∧
        ∀ P ∈ J.minimalPrimes, P.comap (algebraMap R ↥(integralClosure R L)) = I₀ := by
    intro R _ _ _ _ hinj I₀ J h hI₀ hJ hC hN
    haveI := hI₀

    have hker : RingHom.ker (algebraMap R ↥(integralClosure R L)) ≤ I₀ := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      have h1 : algebraMap R L x = 0 := congrArg Subtype.val hx
      rw [IsScalarTower.algebraMap_apply R K L] at h1
      have h2 : algebraMap R K x = 0 := (map_eq_zero_iff _ (algebraMap K L).injective).mp h1
      have h3 : x = 0 := hinj (by rw [h2, map_zero])
      rw [h3]
      exact I₀.zero_mem

    have hτi : ∀ (σ : L ≃ₐ[K] L) (x : ↥(integralClosure R L)), σ.symm (x : L) ∈ integralClosure R L :=
      fun σ x => (mem_integralClosure_iff R L).mpr
        (IsIntegral.map (σ.symm.toAlgHom.restrictScalars R) ((mem_integralClosure_iff R L).mp x.2))
    let τ : (L ≃ₐ[K] L) → (↥(integralClosure R L) →+* ↥(integralClosure R L)) := fun σ =>
      ((σ.symm : L ≃ₐ[K] L).toRingEquiv.toRingHom.comp (integralClosure R L).val.toRingHom).codRestrict
        (integralClosure R L) (fun x => hτi σ x)
    have hτv : ∀ (σ : L ≃ₐ[K] L) (y : ↥(integralClosure R L)), ((τ σ y : ↥(integralClosure R L)) : L)
        = σ.symm (y : L) := fun _ _ => rfl
    have hτalg : ∀ σ : L ≃ₐ[K] L, (τ σ).comp (algebraMap R ↥(integralClosure R L)) =
        algebraMap R ↥(integralClosure R L) := by
      intro σ
      refine RingHom.ext fun r => Subtype.ext ?_
      show σ.symm (algebraMap R L r) = algebraMap R L r
      rw [IsScalarTower.algebraMap_apply R K L]
      exact σ.symm.commutes _
    have hτσ : ∀ (σ : L ≃ₐ[K] L) (y : ↥(integralClosure R L)),
        (y : L) = σ ((τ σ y : ↥(integralClosure R L)) : L) := by
      intro σ y
      rw [hτv]
      exact (σ.apply_symm_apply _).symm

    have hover : ∀ P ∈ J.minimalPrimes, P.comap (algebraMap R ↥(integralClosure R L)) = I₀ := by
      intro 𝔓 h𝔓
      haveI h𝔓p : 𝔓.IsPrime := h𝔓.1.1
      have hJ𝔓 : J ≤ 𝔓 := h𝔓.1.2
      have hIQ : I₀ ≤ 𝔓.comap (algebraMap R ↥(integralClosure R L)) := (hJ 𝔓 h𝔓p).mp hJ𝔓
      obtain ⟨P₀, hP₀p, hP₀⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain I₀ hker
      haveI := hP₀p
      obtain ⟨P₁, hP₀P₁, hP₁p, hP₁⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
        (𝔓.comap (algebraMap R ↥(integralClosure R L))) P₀ (by rw [hP₀]; exact hIQ)
      obtain ⟨σ, hσ⟩ := wcpa_dj_llsm_fcw_galois_transitive R K L
        (𝔓.comap (algebraMap R ↥(integralClosure R L))) h (hC _ inferInstance hIQ) hN P₁ 𝔓
        hP₁p h𝔓p hP₁ rfl
      have hP'le : P₀.comap (τ σ) ≤ 𝔓 := by
        intro y hy
        have hx : τ σ y ∈ P₁ := hP₀P₁ (Ideal.mem_comap.mp hy)
        exact (hσ (τ σ y) y (hτσ σ y)).mp hx
      have hP'c : (P₀.comap (τ σ)).comap (algebraMap R ↥(integralClosure R L)) = I₀ := by
        rw [Ideal.comap_comap, hτalg σ]
        exact hP₀
      have hmin : Minimal (fun q : Ideal ↥(integralClosure R L) => q.IsPrime ∧ J ≤ q) 𝔓 := h𝔓
      have hP'eq : P₀.comap (τ σ) = 𝔓 :=
        (hmin.eq_of_le ⟨Ideal.comap_isPrime (τ σ) P₀, (hJ _ (Ideal.comap_isPrime (τ σ) P₀)).mpr hP'c.ge⟩
          hP'le)
      rw [← hP'eq, hP'c]
    refine ⟨?_, hover⟩

    rcases J.minimalPrimes.eq_empty_or_nonempty with he | ⟨𝔓₀, h𝔓₀⟩
    · rw [he]; exact Set.finite_empty
    · refine (Set.finite_range (fun σ : L ≃ₐ[K] L => 𝔓₀.comap (τ σ))).subset ?_
      intro 𝔓 h𝔓
      obtain ⟨σ, hσ⟩ := wcpa_dj_llsm_fcw_galois_transitive R K L I₀ h (hC I₀ hI₀ le_rfl) hN
        𝔓₀ 𝔓 h𝔓₀.1.1 h𝔓.1.1 (hover 𝔓₀ h𝔓₀) (hover 𝔓 h𝔓)
      refine ⟨σ, ?_⟩
      ext y
      rw [Ideal.mem_comap]
      exact hσ (τ σ y) y (hτσ σ y)

  obtain ⟨hI₀p, hVnot⟩ := wcpa_dj_llsm_fcw_fibre_prime Ω W A K 𝔭 t hPD c' b' hc' hb'm hb'0
  obtain ⟨h₀, hh₀, hN⟩ := wcpa_dj_llsm_fcw_chart_normal Ω W A K 𝔭 t hPD c' b' hc' hb'm hb'0
  have hmax : 𝔭.IsMaximal := hPD.2.2.2.1
  have key := main (Algebra.adjoin A {wcLlsScV W A K t c' b'}) (fun x y hxy => Subtype.ext hxy)
    (Ideal.map (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) 𝔭)
    (wcLlsFcJV W A K L t c' b') (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) h₀)
    hI₀p (fun 𝔓 h𝔓 => wcpa_dj_llsm_fcw_J_le_iff Ω W A K L 𝔭 t hPD c' b' hc' 𝔓 h𝔓)
    (by
      intro Q hQ hIQ hhQ
      have hle : 𝔭 ≤ Q.comap (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) :=
        Ideal.map_le_iff_le_comap.mp hIQ
      have heq := hmax.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hle
      apply hh₀
      rw [heq]
      exact Ideal.mem_comap.mpr hhQ)
    (fun z hz => by
      obtain ⟨n, r, hr⟩ := hN z hz
      exact ⟨n, r, hr⟩)
  unfold wcLlsFcFin
  refine ⟨key.1, fun P hP hV => hVnot ?_⟩
  rw [← key.2 P hP]
  exact Ideal.mem_comap.mpr hV

theorem wcpa_dj_llsm_obi_fs_reduced : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (L : Type u) [Field L] (wL : ↥W →+* L), Function.Injective wL →
    ∀ (R : Type u) [CommRing R] [Algebra R L], (∀ x : ↥W, IsIntegral R (wL x)) →
    ∀ (q : Ideal ↥(integralClosure R L)) [q.IsPrime], IsReduced (wcLlsFS W wL R q) :=
by
  intro Ω _ _ W L _ wL hwLinj R _ _ hint q _
  classical
  let emb : ↥W → ↥(integralClosure R L) := fun u => ⟨wL u, hint u⟩

  have hform : ∀ x ∈ Ideal.span {b : ↥(integralClosure R L) |
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w},
      ∃ w ∈ IsLocalRing.maximalIdeal ↥W, ∃ c : ↥(integralClosure R L),
        (x : L) = wL w * (c : L) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨w, hw, hxw⟩ := hx
      exact ⟨w, hw, 1, by rw [hxw, OneMemClass.coe_one, mul_one]⟩
    | zero => exact ⟨0, Ideal.zero_mem _, 0, by simp⟩
    | add x z _ _ hx hz =>
      obtain ⟨w₁, hw₁, c₁, h₁⟩ := hx
      obtain ⟨w₂, hw₂, c₂, h₂⟩ := hz
      rcases ValuationRing.dvd_total w₁ w₂ with ⟨e, he⟩ | ⟨e, he⟩
      · refine ⟨w₁, hw₁, c₁ + emb e * c₂, ?_⟩
        rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, he, map_mul]
        show _ = _ * (_ + wL e * _)
        ring
      · refine ⟨w₂, hw₂, emb e * c₁ + c₂, ?_⟩
        rw [AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul, h₁, h₂, he, map_mul]
        show _ = _ * (wL e * _ + _)
        ring
    | smul a x _ hx =>
      obtain ⟨w, hw, c, h⟩ := hx
      refine ⟨w, hw, a * c, ?_⟩
      rw [smul_eq_mul, MulMemClass.coe_mul, h, MulMemClass.coe_mul]
      ring

  have hroot : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ∀ n : ℕ, 0 < n →
      ∃ π ∈ IsLocalRing.maximalIdeal ↥W, π ^ n = w := by
    intro w hw n hn
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : Ω) hn
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hw
    by_cases h : z ∈ W
    · have hπ : (⟨z, h⟩ : ↥W) ^ n = w := Subtype.ext (by simp [hz])
      refine ⟨⟨z, h⟩, ?_, hπ⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact hw (hπ ▸ hu.pow n)
    · exfalso
      have hz0 : z ≠ 0 := by
        rintro rfl
        exact h W.zero_mem
      have hzi : z⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left h
      have hv : w * (⟨z⁻¹, hzi⟩ : ↥W) ^ n = 1 := by
        apply Subtype.ext
        simp only [MulMemClass.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one]
        rw [← hz, ← mul_pow, mul_inv_cancel₀ hz0, one_pow]
      exact hw (IsUnit.of_mul_eq_one _ hv)

  have hrad : ∀ (b : ↥(integralClosure R L)) (n : ℕ), b ^ n ∈ Ideal.span
      {b : ↥(integralClosure R L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w} →
      b ∈ Ideal.span {b : ↥(integralClosure R L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = wL w} := by
    intro b n hbn
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [pow_zero] at hbn
      simpa using Ideal.mul_mem_left _ b hbn
    obtain ⟨w, hw, c, hc⟩ := hform _ hbn
    rw [SubmonoidClass.coe_pow] at hc
    by_cases hw0 : w = 0
    · have h0 : (b : L) ^ n = 0 := by rw [hc, hw0, map_zero, zero_mul]
      have hb0 : b = 0 := Subtype.ext (by
        rw [ZeroMemClass.coe_zero]; exact (pow_eq_zero_iff hn.ne').mp h0)
      rw [hb0]
      exact Ideal.zero_mem _
    obtain ⟨π, hπ, hπn⟩ := hroot w hw n hn
    have hwL0 : wL w ≠ 0 := by
      intro h
      exact hw0 ((map_eq_zero_iff _ hwLinj).mp h)
    have hπ0 : wL π ≠ 0 := by
      intro h
      apply hw0
      rw [← hπn, (map_eq_zero_iff _ hwLinj).mp h, zero_pow hn.ne']
    have hξ : ((b : L) / wL π) ^ n = (c : L) := by
      rw [div_pow, hc, ← map_pow, hπn]
      exact mul_div_cancel_left₀ _ hwL0
    have hξint : _root_.IsIntegral R ((b : L) / wL π) :=
      _root_.IsIntegral.of_pow hn (by rw [hξ]; exact c.2)
    have hmem : emb π * ⟨_, hξint⟩ ∈ Ideal.span {b : ↥(integralClosure R L) |
        ∃ w ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w} :=
      Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨π, hπ, rfl⟩)
    have hbeq : b = emb π * ⟨_, hξint⟩ := by
      apply Subtype.ext
      rw [MulMemClass.coe_mul]
      show (b : L) = wL π * ((b : L) / wL π)
      rw [mul_div_cancel₀ _ hπ0]
    rw [hbeq]
    exact hmem

  unfold wcLlsFS
  refine ⟨fun x hx => ?_⟩
  obtain ⟨n, hn⟩ := hx
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
  rw [← map_pow, ← IsLocalization.mk'_pow, Ideal.Quotient.eq_zero_iff_mem,
    IsLocalization.mk'_mem_map_algebraMap_iff] at hn
  obtain ⟨s', hs', hs'a⟩ := hn
  rw [Ideal.Quotient.eq_zero_iff_mem, IsLocalization.mk'_mem_map_algebraMap_iff]
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · refine ⟨s', hs', ?_⟩
    rw [pow_zero, mul_one] at hs'a
    exact Ideal.mul_mem_right _ _ hs'a
  · refine ⟨s', hs', hrad _ n ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    have he : (s' * a) ^ (m + 1) = s' ^ m * (s' * a ^ (m + 1)) := by ring
    rw [he]
    exact Ideal.mul_mem_left _ _ hs'a

theorem wcpa_dj_lr1k_ll_db_two_minimal_primes : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
    [_root_.IsReduced R] [IsNoetherianRing R] (k : ℕ) (P : Fin k → Ideal R),
    Function.Injective P → (∀ i, P i ∈ minimalPrimes R) → 2 ≤ k →
    wcpaDjLkDelta R ≠ 0 ∧ (k : ℕ∞) ≤ wcpaDjLkBranches R :=
by
  intro R _ _ _ _ k P hPinj hPmin hk
  classical

  have hfin : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
  set M : Finset (Ideal R) := hfin.toFinset with hM
  have hMmem : ∀ q, q ∈ M ↔ q ∈ minimalPrimes R := fun q => hfin.mem_toFinset
  have hMprime : ∀ q ∈ M, q.IsPrime := fun q hq => ((hMmem q).1 hq).1.1
  have hminl : ∀ p ∈ M, ∀ q : Ideal R, q.IsPrime → q ≤ p → q = p := by
    intro p hp q hq hqp
    have hp' : p ∈ minimalPrimes R := (hMmem p).1 hp
    exact le_antisymm hqp (hp'.2 ⟨hq, bot_le⟩ hqp)
  have hzero : ∀ x : R, (∀ q ∈ M, x ∈ q) → x = 0 := by
    intro x hx
    have h1 : x ∈ sInf (⊥ : Ideal R).minimalPrimes := by
      rw [Submodule.mem_sInf]
      intro q hq
      exact hx q ((hMmem q).2 hq)
    rw [Ideal.sInf_minimalPrimes, Ideal.mem_radical_iff] at h1
    obtain ⟨n, hn⟩ := h1
    exact IsNilpotent.eq_zero ⟨n, Ideal.mem_bot.mp hn⟩
  have hex : ∀ p ∈ M, ∃ x : R, (∀ q ∈ M, q ≠ p → x ∈ q) ∧ x ∉ p := by
    intro p hp
    have hnle : ¬ (M.erase p).inf id ≤ p := by
      intro hle
      obtain ⟨q, hq, hqp⟩ := ((hMprime p hp).inf_le' (s := M.erase p) (f := id)).1 hle
      exact Finset.ne_of_mem_erase hq
        (hminl p hp q (hMprime q (Finset.mem_of_mem_erase hq)) hqp)
    obtain ⟨x, hx, hxp⟩ := SetLike.not_le_iff_exists.mp hnle
    refine ⟨x, fun q hq hqp => ?_, hxp⟩
    exact Finset.inf_le (f := id) (Finset.mem_erase.mpr ⟨hqp, hq⟩) hx
  choose! A hAin hAnot using hex
  have horthA : ∀ p ∈ M, ∀ q ∈ M, p ≠ q → A p * A q = 0 := by
    intro p hp q hq hpq
    apply hzero
    intro r hr
    by_cases hrp : r = p
    · rw [hrp]
      exact Ideal.mul_mem_left _ _ (hAin q hq p hp hpq)
    · exact Ideal.mul_mem_right _ _ (hAin p hp r hr hrp)
  set s : R := ∑ q ∈ M, A q with hs
  have hAs : ∀ p ∈ M, A p * s = A p * A p := by
    intro p hp
    rw [hs, Finset.mul_sum, Finset.sum_eq_single p]
    · intro q hq hqp
      exact horthA p hp q hq (Ne.symm hqp)
    · intro h
      exact absurd hp h
  have hsnot : ∀ r ∈ M, s ∉ r := by
    intro r hr hsr
    have hsplit : s = A r + ∑ q ∈ M.erase r, A q := (Finset.add_sum_erase M A hr).symm
    have h2 : ∑ q ∈ M.erase r, A q ∈ r := Ideal.sum_mem _ (fun q hq =>
      hAin q (Finset.mem_of_mem_erase hq) r hr (Finset.ne_of_mem_erase hq).symm)
    apply hAnot r hr
    have h3 : A r = s - ∑ q ∈ M.erase r, A q := by rw [hsplit]; ring
    rw [h3]
    exact Ideal.sub_mem _ hsr h2
  have hsnzd : s ∈ nonZeroDivisors R := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hzero
    intro r hr
    have h1 : x * s ∈ r := by rw [hx]; exact Ideal.zero_mem _
    exact ((hMprime r hr).mem_or_mem h1).resolve_right (hsnot r hr)
  have hPM : ∀ i, P i ∈ M := fun i => (hMmem (P i)).2 (hPmin i)

  let σ : nonZeroDivisors R := ⟨s, hsnzd⟩
  let f : Fin k → FractionRing R := fun i => IsLocalization.mk' (FractionRing R) (A (P i)) σ
  have hfspec : ∀ i, f i * algebraMap R (FractionRing R) s =
      algebraMap R (FractionRing R) (A (P i)) :=
    fun i => IsLocalization.mk'_spec (FractionRing R) (A (P i)) σ
  have hu : IsUnit (algebraMap R (FractionRing R) s) := IsLocalization.map_units (FractionRing R) σ
  have hinj : Function.Injective (algebraMap R (FractionRing R)) :=
    IsFractionRing.injective R (FractionRing R)
  have hfidem : ∀ i, f i * f i = f i := by
    intro i
    have h : (f i * f i - f i) * algebraMap R (FractionRing R) s *
        algebraMap R (FractionRing R) s = 0 := by
      have e : (f i * f i - f i) * algebraMap R (FractionRing R) s *
          algebraMap R (FractionRing R) s =
          algebraMap R (FractionRing R) (A (P i) * A (P i) - A (P i) * s) := by
        rw [map_sub, map_mul, map_mul, ← hfspec i]; ring
      rw [e, ← hAs (P i) (hPM i), sub_self, map_zero]
    rw [hu.mul_left_eq_zero, hu.mul_left_eq_zero, sub_eq_zero] at h
    exact h
  have hforth : ∀ i j, i ≠ j → f i * f j = 0 := by
    intro i j hij
    have h : f i * f j * algebraMap R (FractionRing R) s * algebraMap R (FractionRing R) s = 0 := by
      have e : f i * f j * algebraMap R (FractionRing R) s * algebraMap R (FractionRing R) s =
          algebraMap R (FractionRing R) (A (P i) * A (P j)) := by
        rw [map_mul, ← hfspec i, ← hfspec j]; ring
      rw [e, horthA (P i) (hPM i) (P j) (hPM j) (fun h => hij (hPinj h)), map_zero]
    rwa [hu.mul_left_eq_zero, hu.mul_left_eq_zero] at h
  have hfne : ∀ i, f i ≠ 0 := by
    intro i h
    have h1 := hfspec i
    rw [h, zero_mul] at h1
    have h2 : A (P i) = 0 := hinj (by rw [map_zero]; exact h1.symm)
    apply hAnot (P i) (hPM i)
    rw [h2]
    exact Ideal.zero_mem _
  have hfint : ∀ i, f i ∈ integralClosure R (FractionRing R) := by
    intro i
    rw [mem_integralClosure_iff]
    refine ⟨Polynomial.X * (Polynomial.X - Polynomial.C 1),
      Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1), ?_⟩
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C,
      map_one, mul_sub, mul_one, hfidem i, sub_self]
  let e : Fin k → ↥(integralClosure R (FractionRing R)) := fun i => ⟨f i, hfint i⟩
  have heidem : ∀ i, e i * e i = e i := fun i => Subtype.ext (hfidem i)
  have heorth : ∀ i j, i ≠ j → e i * e j = 0 := fun i j hij => Subtype.ext (hforth i j hij)
  have hene : ∀ i, e i ≠ 0 := fun i h => hfne i (congrArg Subtype.val h)
  let i₀ : Fin k := ⟨0, by omega⟩
  let i₁ : Fin k := ⟨1, by omega⟩
  have h01 : i₁ ≠ i₀ := by
    intro h
    have := congrArg Fin.val h
    simp [i₀, i₁] at this
  have he0ne1 : e i₀ ≠ 1 := by
    intro h
    apply hene i₁
    calc e i₁ = e i₁ * e i₀ := by rw [h, mul_one]
      _ = 0 := heorth i₁ i₀ h01
  refine ⟨?_, ?_⟩
  ·
    unfold wcpaDjLkDelta
    rw [Ne, Module.length_eq_zero_iff]
    intro hsub
    have hmem : e i₀ ∈ LinearMap.range
        (Algebra.linearMap R ↥(integralClosure R (FractionRing R))) := by
      rw [← Submodule.Quotient.mk_eq_zero]
      exact Subsingleton.elim _ _
    obtain ⟨c, hc⟩ := LinearMap.mem_range.mp hmem
    rw [Algebra.linearMap_apply] at hc
    have hinjO : Function.Injective
        (algebraMap R ↥(integralClosure R (FractionRing R))) := by
      intro x y hxy
      apply hinj
      exact congrArg Subtype.val hxy
    have hcidem : c * c = c := hinjO (by rw [map_mul, hc, heidem])
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self c with hcu | hcu
    · have hc1 : c = 1 := by
        have h2 : c * c = c * 1 := by rw [mul_one, hcidem]
        exact hcu.mul_left_cancel h2
      apply he0ne1
      rw [← hc, hc1, map_one]
    · have hc0 : c = 0 := by
        have h2 : c * (1 - c) = 0 := by rw [mul_sub, mul_one, hcidem, sub_self]
        exact hcu.mul_left_eq_zero.mp h2
      apply hene i₀
      rw [← hc, hc0, map_zero]
  ·
    unfold wcpaDjLkBranches
    have hprop : ∀ i, Ideal.span {1 - e i} ≠ ⊤ := by
      intro i h
      rw [Ideal.span_singleton_eq_top] at h
      apply hene i
      have h2 : e i * (1 - e i) = 0 := by rw [mul_sub, mul_one, heidem, sub_self]
      exact h.mul_left_eq_zero.mp h2
    choose N hNmax hNle using fun i => Ideal.exists_le_maximal _ (hprop i)
    have h1N : ∀ i, 1 - e i ∈ N i := fun i => (Ideal.span_singleton_le_iff_mem _).mp (hNle i)
    have heN : ∀ i, e i ∉ N i := by
      intro i h
      apply (hNmax i).ne_top
      rw [Ideal.eq_top_iff_one]
      have h3 := Ideal.add_mem _ h (h1N i)
      have h4 : e i + (1 - e i) = 1 := by ring
      rwa [h4] at h3
    have heN' : ∀ i j, i ≠ j → e i ∈ N j := by
      intro i j hij
      have h3 : e i * e j ∈ N j := by rw [heorth i j hij]; exact Ideal.zero_mem _
      exact ((hNmax j).isPrime.mem_or_mem h3).resolve_right (heN j)
    let g : Fin k → MaximalSpectrum ↥(integralClosure R (FractionRing R)) :=
      fun i => ⟨N i, hNmax i⟩
    have hg : Function.Injective g := by
      intro i j hij
      by_contra hne
      have hN : N i = N j := congrArg MaximalSpectrum.asIdeal hij
      apply heN i
      rw [hN]
      exact heN' i j hne
    have h5 := ENat.card_le_card_of_injective hg
    rwa [ENat.card_eq_coe_fintype_card, Fintype.card_fin] at h5

theorem wcpa_dj_llsm_fcbu_fs_noetherian : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ (s : K) (𝔮 : Ideal ↥(integralClosure ↥(Algebra.adjoin A {s}) L)) [𝔮.IsPrime], (∀ x ∈ IsLocalRing.maximalIdeal ↥W, algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A x)) ∈ 𝔮) → IsNoetherianRing (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) ↥(Algebra.adjoin A {s}) 𝔮) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ 𝔭 t hPD s 𝔮 _ h𝔮
  have hfin := wcpa_dj_llsm_sd_normalization_finite Ω W hW hWt A K L 𝔭 (.disc t) hPD s
  obtain ⟨hIC, hinj, hFT, hcoe⟩ := wcpa_dj_llsm_mg_chart_props Ω W A K L 𝔭 (.disc t) hPD s hfin
  set σ : ↥W →+* ↥(integralClosure ↥(Algebra.adjoin A {s}) L) :=
    (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L)).comp
      ((algebraMap A ↥(Algebra.adjoin A {s})).comp (algebraMap ↥W A)) with hσ
  haveI := hIC
  have hred := wcpa_dj_llsm_mg_fibre_reduced Ω W _ σ hinj
  have hle : (IsLocalRing.maximalIdeal ↥W).map σ ≤ 𝔮 := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    exact h𝔮 x hx
  have hN := (wcpa_dj_llsm_mg_fibre_noeth_norm Ω W _ σ hFT 𝔮 hle hred).1
  have hI : Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
      ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x} =
      (IsLocalRing.maximalIdeal ↥W).map σ := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro b ⟨x, hx, hb⟩
      have hbx : b = σ x := Subtype.val_injective (hb.trans (hcoe x).symm)
      rw [hbx]
      exact Ideal.mem_map_of_mem σ hx
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact Ideal.subset_span ⟨x, hx, hcoe x⟩
  have hI' : (Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) |
      ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x}).map
        (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L) (Localization.AtPrime 𝔮)) =
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap ↥(integralClosure ↥(Algebra.adjoin A {s}) L)
          (Localization.AtPrime 𝔮)).comp σ) := by
    rw [hI, Ideal.map_map]
  exact isNoetherianRing_of_ringEquiv _ (Ideal.quotEquivOfEq hI'.symm)

theorem wcpa_dj_llsm_scbc_fibre_generic_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c : ↥W, ∃ 𝔭₀ : Ideal A, 𝔭₀.IsPrime ∧ 𝔭₀ ≤ 𝔭 ∧ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W A) ≤ 𝔭₀ ∧ t - algebraMap ↥W A c ∉ 𝔭₀ :=
by
  intro Ω _ W A _ _ _ 𝔭 t hPD c
  have hGD : ∀ (S : Type u) [CommRing S] (g : Polynomial ↥W →+* S), g.Etale →
      ∀ Q : Ideal S, Q.IsPrime →
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ≤ Q.comap g →
      ∃ Q₀ : Ideal S, Q₀ ≤ Q ∧ Q₀.IsPrime ∧
        Q₀.comap g = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) := by
    intro S _ g hg Q hQ hle
    letI := g.toAlgebra
    haveI : Algebra.Etale (Polynomial ↥W) S := RingHom.Etale.toAlgebra hg
    haveI : Module.Flat (Polynomial ↥W) S := inferInstance
    haveI : Algebra.HasGoingDown (Polynomial ↥W) S := inferInstance
    haveI hp0 : (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W)).IsPrime :=
      Ideal.isPrime_map_C_of_isPrime
    have hle' : Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ≤
        Q.under (Polynomial ↥W) := by
      rw [Ideal.under_def]; exact hle
    obtain ⟨P, hPQ, hP, hPl⟩ := Ideal.exists_ideal_le_liesOver_of_le Q hle'
    refine ⟨P, hPQ, hP, ?_⟩
    have hov := hPl.over
    rw [Ideal.under_def] at hov
    exact hov.symm
  obtain ⟨_, _, _, h𝔭max, hm𝔭, ht𝔭, h𝔭eq, h, hh, f, hfC, hfX, hfet⟩ := hPD
  have h𝔭prime : 𝔭.IsPrime := h𝔭max.isPrime
  have hdisj : Disjoint (Submonoid.powers h : Set A) (𝔭 : Set A) :=
    (Ideal.disjoint_powers_iff_notMem h h𝔭prime.isRadical).mpr hh
  have h𝔓prime : (𝔭.map (algebraMap A (Localization.Away h))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h) 𝔭
      h𝔭prime hdisj
  have h𝔓comap : (𝔭.map (algebraMap A (Localization.Away h))).comap
      (algebraMap A (Localization.Away h)) = 𝔭 := by
    have := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h)
      (Localization.Away h) h𝔭prime hdisj
    rw [Ideal.under_def] at this
    exact this
  have hfCw : ∀ w : ↥W, f (Polynomial.C w) =
      algebraMap A (Localization.Away h) (algebraMap ↥W A w) := fun w => by
    have := RingHom.congr_fun hfC w
    simpa using this
  have hle : Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ≤
      (𝔭.map (algebraMap A (Localization.Away h))).comap f := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    show f (Polynomial.C w) ∈ 𝔭.map (algebraMap A (Localization.Away h))
    rw [hfCw]
    exact Ideal.mem_map_of_mem _ (hm𝔭 (Ideal.mem_map_of_mem _ hw))
  obtain ⟨Q₀, hQ₀le, hQ₀, hQ₀eq⟩ := hGD _ f hfet _ h𝔓prime hle
  refine ⟨Q₀.comap (algebraMap A (Localization.Away h)),
    Ideal.comap_isPrime (algebraMap A (Localization.Away h)) Q₀, ?_, ?_, ?_⟩
  · rw [← h𝔓comap]; exact Ideal.comap_mono hQ₀le
  · rw [Ideal.map_le_iff_le_comap]
    intro w hw
    show algebraMap A (Localization.Away h) (algebraMap ↥W A w) ∈ Q₀
    rw [← hfCw]
    have hC : Polynomial.C w ∈ Q₀.comap f := by
      rw [hQ₀eq]; exact Ideal.mem_map_of_mem _ hw
    exact hC
  · intro hmem
    have h1 : f (Polynomial.X - Polynomial.C c) ∈ Q₀ := by
      rw [map_sub, hfX, hfCw, ← map_sub]; exact hmem
    have h2 : Polynomial.X - Polynomial.C c ∈
        Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) := by
      rw [← hQ₀eq]; exact h1
    rw [Ideal.mem_map_C_iff] at h2
    have h3 := h2 1
    have h4 : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
      simpa [Polynomial.coeff_X, Polynomial.coeff_C] using h3
    exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h4

theorem wcpa_dj_llsm_scbc_branch_prime : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (u β : A) (𝔭₀ : Ideal A), 𝔭₀.IsPrime → β ∈ 𝔭₀ → u ∉ 𝔭₀ → ∀ (s : K), s = algebraMap A K β / algebraMap A K u → ∃ 𝔫 : Ideal ↥(Algebra.adjoin A {s}), 𝔫.IsPrime ∧ 𝔫.comap (algebraMap A ↥(Algebra.adjoin A {s})) = 𝔭₀ ∧ ∀ J : Ideal ↥(Algebra.adjoin A {s}), (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ J → 𝔭₀.map (algebraMap A ↥(Algebra.adjoin A {s})) ≤ J → 𝔫 ≤ J :=
by
  intro A _ _ K _ _ _ u β 𝔭₀ hp hβ hu s hs
  classical
  have hinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hu0 : algebraMap A K u ≠ 0 := by
    intro h
    apply hu
    rw [hinj (h.trans (map_zero _).symm)]
    exact 𝔭₀.zero_mem
  have hsu : s * algebraMap A K u = algebraMap A K β := by
    rw [hs]; field_simp
  have hcoe : ∀ a : A, ((algebraMap A ↥(Algebra.adjoin A {s}) a : ↥(Algebra.adjoin A {s})) : K)
      = algebraMap A K a := fun a => rfl
  have hsh : (((⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s}))) : K)
      = s := rfl

  have H : ∀ x ∈ Algebra.adjoin A {s}, ∃ (n : ℕ) (a : A),
      x * algebraMap A K u ^ n = algebraMap A K a := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      exact ⟨1, β, by rw [hx, pow_one, hsu]⟩
    | algebraMap r => exact ⟨0, r, by rw [pow_zero, mul_one]⟩
    | add x y _ _ hx hy =>
      obtain ⟨n, a, ha⟩ := hx
      obtain ⟨m, b, hb⟩ := hy
      refine ⟨n + m, a * u ^ m + b * u ^ n, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ← ha, ← hb]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨n, a, ha⟩ := hx
      obtain ⟨m, b, hb⟩ := hy
      refine ⟨n + m, a * b, ?_⟩
      rw [map_mul, ← ha, ← hb]
      ring

  have D : ∀ x ∈ Algebra.adjoin A {s}, ∃ (a₀ : A) (y : ↥(Algebra.adjoin A {s})),
      x = algebraMap A K a₀ + s * (y : K) := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      exact ⟨0, 1, by rw [hx, map_zero, OneMemClass.coe_one, mul_one, zero_add]⟩
    | algebraMap r => exact ⟨r, 0, by rw [ZeroMemClass.coe_zero, mul_zero, add_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, y1, h1⟩ := hx
      obtain ⟨b, y2, h2⟩ := hy
      refine ⟨a + b, y1 + y2, ?_⟩
      rw [h1, h2, map_add, AddMemClass.coe_add]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨a, y1, h1⟩ := hx
      obtain ⟨b, y2, h2⟩ := hy
      refine ⟨a * b, algebraMap A _ a * y2 + algebraMap A _ b * y1 +
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) * y1 * y2, ?_⟩
      rw [h1, h2, map_mul, AddMemClass.coe_add, AddMemClass.coe_add, MulMemClass.coe_mul,
        MulMemClass.coe_mul, MulMemClass.coe_mul, MulMemClass.coe_mul, hcoe, hcoe, hsh]
      ring
  have F2 : ∀ (c : A) (n : ℕ), c * u ^ n ∈ 𝔭₀ → c ∈ 𝔭₀ := by
    intro c n h
    rcases hp.mem_or_mem h with h | h
    · exact h
    · exact absurd (hp.mem_of_pow_mem n h) hu
  obtain ⟨𝔫, hmem⟩ : ∃ 𝔫 : Ideal ↥(Algebra.adjoin A {s}), ∀ x, x ∈ 𝔫 ↔
      ∃ (n : ℕ) (a : A), a ∈ 𝔭₀ ∧ (x : K) * algebraMap A K u ^ n = algebraMap A K a := by
    refine ⟨{ carrier := {x | ∃ (n : ℕ) (a : A), a ∈ 𝔭₀ ∧
                (x : K) * algebraMap A K u ^ n = algebraMap A K a}
              add_mem' := ?_
              zero_mem' := ?_
              smul_mem' := ?_ }, fun x => Iff.rfl⟩
    · rintro x y ⟨n, a, ha, hxa⟩ ⟨m, b, hb, hyb⟩
      refine ⟨n + m, a * u ^ m + b * u ^ n,
        𝔭₀.add_mem (𝔭₀.mul_mem_right _ ha) (𝔭₀.mul_mem_right _ hb), ?_⟩
      rw [AddMemClass.coe_add, map_add, map_mul, map_mul, map_pow, map_pow, ← hxa, ← hyb]
      ring
    · exact ⟨0, 0, 𝔭₀.zero_mem, by rw [ZeroMemClass.coe_zero, zero_mul, map_zero]⟩
    · rintro r x ⟨n, a, ha, hxa⟩
      obtain ⟨k, c, hc⟩ := H r r.2
      refine ⟨k + n, c * a, 𝔭₀.mul_mem_left _ ha, ?_⟩
      rw [smul_eq_mul, MulMemClass.coe_mul, map_mul, ← hc, ← hxa]
      ring
  have hprime : 𝔫.IsPrime := by
    rw [Ideal.isPrime_iff]
    constructor
    · intro htop
      have h1 : (1 : ↥(Algebra.adjoin A {s})) ∈ 𝔫 := (Ideal.eq_top_iff_one _).mp htop
      obtain ⟨n, a, ha, h⟩ := (hmem 1).mp h1
      rw [OneMemClass.coe_one, one_mul, ← map_pow] at h
      rw [← hinj h] at ha
      exact hu (hp.mem_of_pow_mem n ha)
    · intro x y hxy
      obtain ⟨n, a, ha, h⟩ := (hmem _).mp hxy
      obtain ⟨k, c, hc⟩ := H x x.2
      obtain ⟨m, d, hd⟩ := H y y.2
      have key : c * d * u ^ n = a * u ^ (k + m) := by
        apply hinj
        rw [map_mul, map_mul, map_mul, map_pow, map_pow, ← hc, ← hd, ← h, MulMemClass.coe_mul]
        ring
      have hcd : c * d ∈ 𝔭₀ := F2 _ n (key ▸ 𝔭₀.mul_mem_right _ ha)
      rcases hp.mem_or_mem hcd with h' | h'
      · exact Or.inl ((hmem x).mpr ⟨k, c, h', hc⟩)
      · exact Or.inr ((hmem y).mpr ⟨m, d, h', hd⟩)
  have hcomap : 𝔫.comap (algebraMap A ↥(Algebra.adjoin A {s})) = 𝔭₀ := by
    ext a
    rw [Ideal.mem_comap, hmem]
    constructor
    · rintro ⟨n, a', ha', h⟩
      rw [hcoe, ← map_pow, ← map_mul] at h
      rw [← hinj h] at ha'
      exact F2 a n ha'
    · intro ha
      exact ⟨0, a, ha, by rw [pow_zero, mul_one, hcoe]⟩
  have hs𝔫 : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) ∈ 𝔫 :=
    (hmem _).mpr ⟨1, β, hβ, by rw [pow_one, hsh, hsu]⟩
  refine ⟨𝔫, hprime, hcomap, ?_⟩
  intro J hsJ hJ x hx
  obtain ⟨a₀, y, hxy⟩ := D x x.2
  have hxeq : x = algebraMap A _ a₀ +
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) * y := by
    apply Subtype.ext
    rw [hxy, AddMemClass.coe_add, MulMemClass.coe_mul, hcoe, hsh]
  have ha₀ : algebraMap A ↥(Algebra.adjoin A {s}) a₀ ∈ 𝔫 := by
    have e : algebraMap A ↥(Algebra.adjoin A {s}) a₀ = x -
        (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s})) * y := by
      rw [hxeq]; ring
    rw [e]
    exact 𝔫.sub_mem hx (𝔫.mul_mem_right _ hs𝔫)
  have ha₀' : a₀ ∈ 𝔭₀ := by
    rw [← hcomap]; exact ha₀
  rw [hxeq]
  exact J.add_mem (hJ (Ideal.mem_map_of_mem _ ha₀')) (J.mul_mem_right _ hsJ)

theorem wcpa_dj_llsm_scbc_normal_going_down : ∀ (R C : Type u) [CommRing R] [IsDomain R] [CommRing C] [IsDomain C] [Algebra R C] [Algebra.IsIntegral R C], Function.Injective (algebraMap R C) → ∀ (N : Ideal R) [N.IsPrime], IsIntegrallyClosed (Localization.AtPrime N) → ∀ (Q : Ideal C), Q.IsPrime → Q.comap (algebraMap R C) = N → ∀ (𝔫 : Ideal R), 𝔫.IsPrime → 𝔫 ≤ N → ∃ 𝔮 : Ideal C, 𝔮.IsPrime ∧ 𝔮 ≤ Q ∧ 𝔮.comap (algebraMap R C) = 𝔫 :=
by
  intro R C _ _ _ _ _ _ hinj N _ hN Q hQ hQN 𝔫 h𝔫 h𝔫N
  haveI := hN
  set S := N.primeCompl with hS
  set T := Algebra.algebraMapSubmonoid C S with hT
  have hT0 : (0 : C) ∉ T := by
    rintro ⟨s, hs, hs0⟩
    apply hs
    have : s = 0 := hinj (by rw [hs0, map_zero])
    rw [this]; exact N.zero_mem
  haveI hCdom : IsDomain (Localization T) :=
    IsLocalization.isDomain_localization (le_nonZeroDivisors_of_noZeroDivisors hT0)
  have hinj' : Function.Injective (algebraMap (Localization.AtPrime N) (Localization T)) :=
    localizationAlgebra_injective (Localization.AtPrime N) (Localization T) hinj
  haveI : FaithfulSMul (Localization.AtPrime N) (Localization T) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj'
  haveI : Algebra.IsIntegral (Localization.AtPrime N) (Localization T) := inferInstance
  haveI : Algebra.HasGoingDown (Localization.AtPrime N) (Localization T) := inferInstance

  have hQdisj : Disjoint (T : Set C) (Q : Set C) := by
    rw [Set.disjoint_left]
    rintro x ⟨s, hs, rfl⟩ hx
    apply hs
    rw [← hQN]
    exact hx
  haveI := hQ
  set Q' := Q.map (algebraMap C (Localization T)) with hQ'
  haveI hQ'p : Q'.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint T _ Q hQ hQdisj
  have hQ'c : Q'.comap (algebraMap C (Localization T)) = Q :=
    IsLocalization.under_map_of_isPrime_disjoint T _ hQ hQdisj

  have h𝔫disj : Disjoint (S : Set R) (𝔫 : Set R) := by
    rw [Set.disjoint_left]
    intro x hx hx'
    exact hx (h𝔫N hx')
  have hNdisj : Disjoint (S : Set R) (N : Set R) := by
    rw [Set.disjoint_left]
    intro x hx hx'
    exact hx hx'
  haveI := h𝔫
  set 𝔫' := 𝔫.map (algebraMap R (Localization.AtPrime N)) with h𝔫'
  set N' := N.map (algebraMap R (Localization.AtPrime N)) with hN'
  haveI h𝔫'p : 𝔫'.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint S _ 𝔫 h𝔫 h𝔫disj
  haveI hN'p : N'.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint S _ N inferInstance hNdisj
  have h𝔫'c : 𝔫'.comap (algebraMap R (Localization.AtPrime N)) = 𝔫 :=
    IsLocalization.under_map_of_isPrime_disjoint S _ h𝔫 h𝔫disj
  have hle : 𝔫' ≤ N' := Ideal.map_mono h𝔫N

  have hJ : Q'.comap (algebraMap (Localization.AtPrime N) (Localization T)) = N' := by
    set J := Q'.comap (algebraMap (Localization.AtPrime N) (Localization T)) with hJdef
    have h1 : J.comap (algebraMap R (Localization.AtPrime N)) = N := by
      rw [hJdef, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq,
        IsScalarTower.algebraMap_eq R C (Localization T), ← Ideal.comap_comap, hQ'c, hQN]
    have h2 : Ideal.map (algebraMap R (Localization.AtPrime N))
        (J.comap (algebraMap R (Localization.AtPrime N))) = J :=
      IsLocalization.map_under S (Localization.AtPrime N) J
    rw [h1] at h2
    exact h2.symm
  haveI : Q'.LiesOver N' := ⟨hJ.symm⟩

  obtain ⟨P, hPQ, hPp, hPl⟩ := Ideal.exists_ideal_le_liesOver_of_le (p := 𝔫') (q := N') Q' hle
  refine ⟨P.comap (algebraMap C (Localization T)), Ideal.comap_isPrime _ _, ?_, ?_⟩
  · rw [← hQ'c]; exact Ideal.comap_mono hPQ
  · have hP : P.comap (algebraMap (Localization.AtPrime N) (Localization T)) = 𝔫' := hPl.over.symm
    rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq,
      IsScalarTower.algebraMap_eq R (Localization.AtPrime N) (Localization T), ← Ideal.comap_comap,
      hP, h𝔫'c]

theorem wcpa_dj_llsm_fcbu_strict_branch : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) → ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W → b' ≠ 0 → ∀ (w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)), w.IsPrime → w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) = wcLlsScNV W A K t c' b' → ∃ P ∈ (Ideal.span {b : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) x}).minimalPrimes, P ≤ w ∧ algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c')) ∉ P :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ 𝔭 t hPD c' b' hc' hb'm hb'0 w hwP hw
  classical
  haveI := hwP
  obtain ⟨𝔭₀, h0p, h0le, h0m, h0u⟩ := wcpa_dj_llsm_scbc_fibre_generic_prime Ω W A 𝔭 t hPD c'
  have hb0 : algebraMap ↥W A b' ∈ 𝔭₀ := h0m (Ideal.mem_map_of_mem _ hb'm)
  obtain ⟨𝔫, hnp, hnc, hnJ⟩ := wcpa_dj_llsm_scbc_branch_prime A K (t - algebraMap ↥W A c')
    (algebraMap ↥W A b') 𝔭₀ h0p hb0 h0u (wcLlsScV W A K t c' b') rfl
  have hpN : 𝔭 ≤ (wcLlsScNV W A K t c' b').comap
      (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := by
    rw [hPD.2.2.2.2.2.2.1]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t ∈ wcLlsScNV W A K t c' b'
      have e : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
          algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
          ((algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})).comp
            (algebraMap ↥W A)) c' := by
        rw [RingHom.comp_apply, ← map_add, sub_add_cancel]
      rw [e]
      unfold wcLlsScNV
      exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc'))
    · rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap]
      intro x hx
      rw [Ideal.mem_comap]
      unfold wcLlsScNV
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hx)
  have hnN : 𝔫 ≤ wcLlsScNV W A K t c' b' := by
    apply hnJ
    · unfold wcLlsScNV
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    · rw [Ideal.map_le_iff_le_comap]
      exact h0le.trans hpN
