      Ideal.quotEquivOfEq (congrArg (Ideal.map
        (algebraMap ↥(integralClosure R L) (Localization.AtPrime Q))) hI)
    have hne : (Ideal.map (algebraMap ↥W ↥(integralClosure R L))
