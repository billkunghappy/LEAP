      -(Ũ ^ N * φ₂ (wcLlsFcVel W A K L t c' b' ^ N * a - g)) := by
    have hUpN : Ũ ^ N * φ₂ (wcLlsFcVel W A K L t c' b') ^ N = 1 := by
      rw [← mul_pow, hUp, one_pow]
    rw [map_sub, map_mul, map_pow, hg]
    linear_combination (φ₂ a - φ₁ e) * hUpN
  rcases hConn e a he ha1 ⟨φ₁ e - φ₂ a, by
      rw [hz]
      exact Submodule.neg_mem _ (Ideal.mul_mem_left _ _ hd), by
      show (φ₁ e : L) - (φ₂ a : L) = _
      rw [hφ₁, hφ₂]⟩ with ⟨h, _⟩ | ⟨h, _⟩
  · exact Or.inl h
  · exact Or.inr h

theorem wcpa_dj_llsm_scdc_fibre_connected : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
