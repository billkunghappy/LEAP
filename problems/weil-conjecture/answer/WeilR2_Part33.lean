            rw [map_mul, map_mul, map_pow, map_pow, hα, hp, hτX, ← hid, pow_add]; ring
          rw [Finset.sum_congr rfl e, ← Finset.mul_sum, mul_pow, ← pow_mul, mul_comm (f ^ d),
