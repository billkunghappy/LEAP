    exact hBK a
  have V2 : ∀ w : ↥W, φ (algebraMap ↥W A w) = algebraMap ↥W S w := by
    intro w
    show algebraMap (Localization.Away h) S (algebraMap A (Localization.Away h) (algebraMap ↥W A w)) =
