      yb = LaurentPolynomial.C c * t ^ k → (∀ a : κ, LaurentPolynomial.C a ∈ D) →
      ∀ (hy : yb ∈ D),
      (∀ f ∈ D, IsIntegral ↥(Algebra.adjoin κ {yb}) f) →
      ∀ P P' : Ideal ↥D, P.IsPrime → P'.IsPrime → (⟨yb, hy⟩ : ↥D) ∈ P →
        (⟨yb, hy⟩ : ↥D) ∈ P' → P = P' := by
    intro κ _ τ t hτ hτC hτX ht hT D yb c k hc hk hyb hCD hy hint P P' hP hP' hyP hyP'
    have hR' : ∀ r ∈ Algebra.adjoin κ {yb}, ∃ q, τ q = r := by
      intro r hr
      induction hr using Algebra.adjoin_induction with
      | mem x hx =>
