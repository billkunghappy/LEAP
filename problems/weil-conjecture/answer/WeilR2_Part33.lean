    intro R A _ _ _ n ι _ a hstd hcard q _ hspan
    haveI hA : Algebra.IsStandardSmoothOfRelativeDimension n R A :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mp hstd
    haveI : Algebra.IsStandardSmooth R A :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.FinitePresentation R A := Algebra.IsStandardSmooth.finitePresentation
    haveI : Algebra.FiniteType R A := Algebra.FiniteType.of_finitePresentation
    haveI : Module.Finite A Ω[A⁄R] := KaehlerDifferential.finite R A
    obtain ⟨s, hsq, hs⟩ := s2 A Ω[A⁄R] ι (fun j => KaehlerDifferential.D R A (a j)) q hspan
    refine ⟨s, hsq, fun A' _ _ _ => ?_⟩
    letI : Algebra R A' := ((algebraMap A A').comp (algebraMap R A)).toAlgebra
    haveI : IsScalarTower R A A' := IsScalarTower.of_algebraMap_eq' rfl
    letI : Algebra (MvPolynomial ι R) A' :=
