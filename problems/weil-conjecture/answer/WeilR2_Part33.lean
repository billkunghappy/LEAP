      exact mul_mem h₁ h₂

  have hRE : Algebra.adjoin A {s} ≤ Algebra.adjoin A {s, η} :=
    Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
  let ι : ↥(Algebra.adjoin A {s}) →+* ↥(Algebra.adjoin A {s, η}) :=
    (Subalgebra.inclusion hRE).toRingHom
  have hιinj : Function.Injective ι := Subalgebra.inclusion_injective hRE
  have hιA : ∀ a : A, ι (algebraMap A ↥(Algebra.adjoin A {s}) a) =
      algebraMap A ↥(Algebra.adjoin A {s, η}) a := fun a => Subtype.ext rfl
  have hιs : ι ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ =
      ⟨s, Algebra.subset_adjoin (Set.mem_insert _ _)⟩ := Subtype.ext rfl

  haveI hqP : (RingHom.ker χ).IsPrime := RingHom.ker_isPrime χ

  have hNle : N ≤ (RingHom.ker χ).comap ι := by
    rw [hN]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro x (rfl | hx)
      · rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker, hιA, hχA,
          Ideal.Quotient.eq_zero_iff_mem]
        exact hz𝔭
      · rw [Set.mem_singleton_iff.mp hx, SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker, hιs]
        exact hχs
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, hιA, hχA,
        Ideal.Quotient.eq_zero_iff_mem]
