      rw [show (⟨g, Algebra.subset_adjoin hg⟩ : ↥(Algebra.adjoin A' {s'})) =
        ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩ from Subtype.ext hg']
      exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    · rw [h𝔭']
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with hx | hx
        · rw [hx, SetLike.mem_coe, Ideal.mem_comap]
          have e1 : algebraMap A' ↥(Algebra.adjoin A' {s'}) u' =
              algebraMap A' ↥(Algebra.adjoin A' {s'}) (algebraMap ↥W A' a') *
                ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩ := by
            apply Subtype.ext
            show algebraMap A' K u' = algebraMap A' K (algebraMap ↥W A' a') * s'
            exact F4
          rw [e1]
          exact Ideal.mul_mem_left _ _
            (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
        · rw [Set.mem_singleton_iff] at hx
          rw [hx, SetLike.mem_coe, Ideal.mem_comap]
          exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem
          ((algebraMap A' ↥(Algebra.adjoin A' {s'})).comp (algebraMap ↥W A')) hw)
    · apply sup_le
      · rw [Ideal.span_le]
        intro y hy
        rcases hy with hy | hy
        · rw [hy, SetLike.mem_coe, Ideal.mem_comap]
          have e1 : algebraMap ↥(Algebra.adjoin A' {s'})
              ↥(integralClosure ↥(Algebra.adjoin A' {s'}) L)
              (algebraMap A' ↥(Algebra.adjoin A' {s'}) v') =
              j (algebraMap ↥(Algebra.adjoin A {S1, S2})
                ↥(integralClosure ↥(Algebra.adjoin A {S1, S2}) L)
                ⟨S2, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩) :=
            Subtype.ext (by
              show algebraMap K L (algebraMap A' K v') = algebraMap K L S2
              rw [hv2])
          rw [e1, hjmem]
          exact hS2Q
        · rw [Set.mem_singleton_iff] at hy
          rw [hy, SetLike.mem_coe, Ideal.mem_comap]
          have e1 : algebraMap ↥(Algebra.adjoin A' {s'})
              ↥(integralClosure ↥(Algebra.adjoin A' {s'}) L)
              ⟨s', Algebra.subset_adjoin (Set.mem_singleton s')⟩ =
              j (algebraMap ↥(Algebra.adjoin A {S1, S2})
                ↥(integralClosure ↥(Algebra.adjoin A {S1, S2}) L)
                ⟨S1, Algebra.subset_adjoin (Set.mem_insert _ _)⟩) :=
            Subtype.ext (by
              show algebraMap K L s' = algebraMap K L S1
              rw [F1])
          rw [e1, hjmem]
          exact hS1Q
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        rw [Ideal.mem_comap, Ideal.mem_comap]
        have e1 : algebraMap ↥(Algebra.adjoin A' {s'})
            ↥(integralClosure ↥(Algebra.adjoin A' {s'}) L)
            (((algebraMap A' ↥(Algebra.adjoin A' {s'})).comp (algebraMap ↥W A')) w) =
            j (algebraMap ↥(Algebra.adjoin A {S1, S2})
              ↥(integralClosure ↥(Algebra.adjoin A {S1, S2}) L)
              (algebraMap A ↥(Algebra.adjoin A {S1, S2}) (algebraMap ↥W A w))) :=
          Subtype.ext (by
            show algebraMap K L (algebraMap A' K (algebraMap ↥W A' w)) =
              algebraMap K L (algebraMap A K (algebraMap ↥W A w))
            rw [hBS1])
        rw [e1, hjmem]
        exact hmQ w hw)
  obtain ⟨eq, heq⟩ := locEquiv _ _ L i i' j hi hi' hcomp Q Q' hQ'c hDen'
  intro hb
  apply hnb
  refine (s7 L ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
    ↥(Algebra.adjoin A {S1, S2}) ↥(Algebra.adjoin A' {s'}) Q Q' eq ?_ hw).mp hb
  intro x y hxy
  rw [heq]
  congr 1
  exact Subtype.ext hxy

theorem wcpa_dj_llsm_rsi_outer_restrict : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A) (c a' q : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c ∈ IsLocalRing.maximalIdeal ↥W → a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 →
    q ∈ IsLocalRing.maximalIdeal ↥W → q ≠ 0 →
    wcLlsDiscSep W A K L t c (a' * q) → wcLlsRsiSep2 W A K L t c a' (a' * q) :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t c a' q hPD hc ha' ha'0 hq hq0 hSep
  have hbm : a' * q ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right q _ ha'
  have hb0 : a' * q ≠ 0 := mul_ne_zero ha'0 hq0

  obtain ⟨A', _, _, _, _, _, _, _, u', v', 𝔭', hBr, hu', hv', hPD', hiff, -, -⟩ :=
    wcpa_dj_llsm_br_boundary_chart Ω W hW hWt A K L 𝔭 (.disc t) (t - algebraMap ↥W A c)
      (a' * q) hPD (Or.inl ⟨t, c, rfl, hc, rfl⟩) hbm hb0
  have hAu : wcLlsAnnSep W A' K L u' (a' * q) := (hiff (a' * q) hbm hb0 dvd_rfl).mp hSep
  have hPD'c := hPD'
  obtain ⟨h1, h2, h3, h4, h5, hg, hg0, huv, hp, h, hh, f, hfC, hf0, hf1, hfe⟩ := hPD'c

  have hPDs : wcLlsPD W A' 𝔭' (.ann v' u' (a' * q)) := by
    have swapEt : ∀ σ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C (a' * q)}) ≃+* (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (a' * q)}),
        RingHom.Etale (R := MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 *
          MvPolynomial.X 1 - MvPolynomial.C (a' * q)}) (S := Localization.Away h)
          (f.comp σ.toRingHom) := by
      intro σ
      exact @And.right _ _ RingHom.Etale.respectsIso _ _ (Localization.Away h)
        (Ideal.Quotient.commRing _) (Ideal.Quotient.commRing _) _ f σ hfe
    let I : Ideal (MvPolynomial (Fin 2) ↥W) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (a' * q)}
    let τ : MvPolynomial (Fin 2) ↥W ≃+* MvPolynomial (Fin 2) ↥W :=
      (MvPolynomial.renameEquiv ↥W (Equiv.swap (0 : Fin 2) 1)).toRingEquiv
    have hτX0 : τ (MvPolynomial.X 0) = MvPolynomial.X 1 := by
      simp [τ, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
    have hτX1 : τ (MvPolynomial.X 1) = MvPolynomial.X 0 := by
      simp [τ, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
    have hτC : ∀ w : ↥W, τ (MvPolynomial.C w) = MvPolynomial.C w := by
      intro w
      simp [τ, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
    have hτp : τ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (a' * q)) =
        MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (a' * q) := by
      rw [map_sub, map_mul, hτX0, hτX1, hτC, mul_comm (MvPolynomial.X 1)]
    have hI : I = Ideal.map (τ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W) I := by
      show _ = Ideal.map _ (Ideal.span _)
      rw [Ideal.map_span, Set.image_singleton, RingEquiv.coe_toRingHom, hτp]
    let σ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C (a' * q)}) ≃+* (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (a' * q)}) :=
      Ideal.quotientEquiv I I τ hI
    have hσ : ∀ p, σ (Ideal.Quotient.mk I p) = Ideal.Quotient.mk I (τ p) :=
      fun p => Ideal.quotientEquiv_mk I I τ hI p
    refine ⟨h1, h2, h3, h4, h5, hg, hg0, by rw [mul_comm]; exact huv,
      by rw [Set.pair_comm]; exact hp, h, hh, f.comp σ.toRingHom, ?_, ?_, ?_, swapEt σ⟩
    · rw [← hfC]
      refine RingHom.ext fun w => ?_
      show f (σ (Ideal.Quotient.mk I (MvPolynomial.C w))) = f (Ideal.Quotient.mk I (MvPolynomial.C w))
      rw [hσ, hτC]
    · show f (σ (Ideal.Quotient.mk I (MvPolynomial.X 0))) = _
      rw [hσ, hτX0]
      exact hf1
    · show f (σ (Ideal.Quotient.mk I (MvPolynomial.X 1))) = _
      rw [hσ, hτX1]
      exact hf0

  have key : ∀ (S T : Subalgebra A' K), S = T → ∀ (xS yS : ↥S) (xT yT : ↥T),
      (xS : K) = (yT : K) → (yS : K) = (xT : K) →
      (∀ (𝔮 : Ideal ↥(integralClosure ↥S L)) [𝔮.IsPrime],
        𝔮.comap (algebraMap ↥S ↥(integralClosure ↥S L)) =
          Ideal.span {xS, yS} ⊔ (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A' ↥S).comp (algebraMap ↥W A')) →
        ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A' K).comp
          (algebraMap ↥W A'))) ↥S 𝔮)) →
      (∀ (𝔮 : Ideal ↥(integralClosure ↥T L)) [𝔮.IsPrime],
        𝔮.comap (algebraMap ↥T ↥(integralClosure ↥T L)) =
          Ideal.span {xT, yT} ⊔ (IsLocalRing.maximalIdeal ↥W).map
            ((algebraMap A' ↥T).comp (algebraMap ↥W A')) →
        ¬ wcpaDjLkBad (wcLlsFS W ((algebraMap K L).comp ((algebraMap A' K).comp
          (algebraMap ↥W A'))) ↥T 𝔮)) := by
    intro S T hST
    subst hST
    intro xS yS xT yT e1 e2 hP 𝔮 _ hc
    have e1' : xS = yT := Subtype.ext e1
    have e2' : yS = xT := Subtype.ext e2
    apply hP 𝔮
    rw [hc, e1', e2', Set.pair_comm]
  have hAv : wcLlsAnnSep W A' K L v' (a' * q) := by
    haveI : NoZeroSMulDivisors ↥W A' := h2
    have hbK : algebraMap A' K (algebraMap ↥W A' (a' * q)) ≠ 0 := by
      intro hz
      have h0 : algebraMap ↥W A' (a' * q) = 0 :=
        (IsFractionRing.injective A' K) (hz.trans (map_zero _).symm)
      rw [Algebra.algebraMap_eq_smul_one] at h0
      rcases smul_eq_zero.mp h0 with h0 | h0
      · exact hb0 h0
      · exact one_ne_zero h0
    have huvK : algebraMap A' K u' * algebraMap A' K v' =
        algebraMap A' K (algebraMap ↥W A' (a' * q)) := by
      rw [← map_mul, huv]
    have hu0 : algebraMap A' K u' ≠ 0 := left_ne_zero_of_mul (huvK ▸ hbK)
    have hv0 : algebraMap A' K v' ≠ 0 := right_ne_zero_of_mul (huvK ▸ hbK)
    have e1 : algebraMap A' K (algebraMap ↥W A' (a' * q)) / algebraMap A' K u' =
        algebraMap A' K v' := (div_eq_iff hu0).mpr (by rw [← huvK, mul_comm])
    have e2 : algebraMap A' K (algebraMap ↥W A' (a' * q)) / algebraMap A' K v' =
        algebraMap A' K u' := (div_eq_iff hv0).mpr huvK.symm
    have hbot : ∀ x : A', Algebra.adjoin A' {algebraMap A' K x} = ⊥ := fun x =>
      le_antisymm (Algebra.adjoin_le (Set.singleton_subset_iff.mpr
        (Algebra.mem_bot.mpr ⟨x, rfl⟩))) bot_le
    have hAu' := hAu
    rw [wcLlsAnnSep, e1] at hAu'
    rw [wcLlsAnnSep, e2]
    exact key _ _ ((hbot v').trans (hbot u').symm) _ _ _ _ rfl rfl hAu'

  have hR := wcpa_dj_llsm_br_radial_mono Ω W hW hWt A' K L 𝔭' (.ann v' u' (a' * q)) v'
    (a' * q) q hPDs (Or.inr ⟨u', a' * q, rfl, dvd_rfl⟩) hbm hb0 hq hq0 (dvd_mul_left q a') hAv

  exact wcpa_dj_llsm_rsior_chart_loc W A K L A' 𝔭 𝔭' t u' v' c a' q hPD hc ha' ha'0 hq hq0
    hBr hu' hv' hPD' hR

theorem wcpa_dj_llsm_rsi_to_isi_sep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L]
    (A' : Type u) [CommRing A'] [IsDomain A'] [Algebra ↥W A'] [Algebra A' K] [IsFractionRing A' K]
    (𝔭 : Ideal A) (𝔭' : Ideal A') (t : A) (u' v' : A') (c a' b₀ : ↥W),
    wcLlsPD W A 𝔭 (.disc t) →
    c ∈ IsLocalRing.maximalIdeal ↥W → a' ∈ IsLocalRing.maximalIdeal ↥W → a' ≠ 0 →
    b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 → a' ∣ b₀ → ¬ b₀ ∣ a' →
    wcLlsBrSub W A K A'
      (algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K (t - algebraMap ↥W A c))
      {algebraMap A K (t - algebraMap ↥W A c),
        algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K (t - algebraMap ↥W A c)} →
    algebraMap A' K u' = algebraMap A K (t - algebraMap ↥W A c) →
    algebraMap A' K v' =
      algebraMap A K (algebraMap ↥W A b₀) / algebraMap A K (t - algebraMap ↥W A c) →
    wcLlsPD W A' 𝔭' (.ann u' v' b₀) →
    wcLlsRsiSep2 W A K L t c a' b₀ → wcLlsIsiSep2 W A' K L u' a' b₀ :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ A' _ _ _ _ _ 𝔭 𝔭' t u' v' c a' b₀ hPD hc ha' ha'0
    hb₀ hb₀0 hdvd hndvd hBr hu' hv' hPD' hMid
  have nodeMax : ∀ (A : Type u) [CommRing A] (K : Type u) [CommRing K]
    [Algebra A K] (𝔭 : Ideal A) (G : Set K) (hmax : 𝔭.IsMaximal)
    (N J : Ideal ↥(Algebra.adjoin A G))
    (hG : ∀ (g : K) (hg : g ∈ G), (⟨g, Algebra.subset_adjoin hg⟩ : ↥(Algebra.adjoin A G)) ∈ N)
    (hpN : 𝔭 ≤ N.comap (algebraMap A ↥(Algebra.adjoin A G))) (hNJ : N ≤ J) (hJ : J ≠ ⊤), J = N := by
    intro A _ K _ _ 𝔭 G hmax N J hG hpN hNJ hJ
    have nf : ∀ x (hx : x ∈ Algebra.adjoin A G), ∃ a : A,
        (⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ a ∈ N := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact ⟨0, by rw [map_zero, sub_zero]; exact hG x hx⟩
      | algebraMap a =>
        refine ⟨a, ?_⟩
        have e : (⟨algebraMap A K a, Subalgebra.algebraMap_mem _ a⟩ : ↥(Algebra.adjoin A G)) =
            algebraMap A _ a := rfl
        rw [e, sub_self]; exact N.zero_mem
      | add x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a + b, ?_⟩
        have e : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ (a + b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ a) +
            ((⟨y, hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ b) := by
          have e1 : (⟨x + y, add_mem hx hy⟩ : ↥(Algebra.adjoin A G)) =
              (⟨x, hx⟩ : ↥(Algebra.adjoin A G)) + ⟨y, hy⟩ := rfl
          rw [e1, map_add]; ring
        rw [e]; exact add_mem ha hb
      | mul x y hx hy ihx ihy =>
        obtain ⟨a, ha⟩ := ihx
        obtain ⟨b, hb⟩ := ihy
        refine ⟨a * b, ?_⟩
        have e : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ (a * b) =
            ((⟨x, hx⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ a) * ⟨y, hy⟩ +
            algebraMap A _ a * ((⟨y, hy⟩ : ↥(Algebra.adjoin A G)) - algebraMap A _ b) := by
          have e1 : (⟨x * y, mul_mem hx hy⟩ : ↥(Algebra.adjoin A G)) =
              (⟨x, hx⟩ : ↥(Algebra.adjoin A G)) * ⟨y, hy⟩ := rfl
          rw [e1, map_mul]; ring
        rw [e]; exact add_mem (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hb)
    refine le_antisymm ?_ hNJ
    intro x hxJ
    obtain ⟨a, ha⟩ := nf x.1 x.2
    have ha' : x - algebraMap A _ a ∈ N := ha
    have haJ : algebraMap A ↥(Algebra.adjoin A G) a ∈ J := by
      have e : algebraMap A ↥(Algebra.adjoin A G) a = x - (x - algebraMap A _ a) := by ring
      rw [e]; exact sub_mem hxJ (hNJ ha')
    by_cases hc0 : a ∈ 𝔭
    · have e : x = (x - algebraMap A _ a) + algebraMap A _ a := by ring
      rw [e]; exact add_mem ha' (hpN hc0)
    · exfalso
      obtain ⟨β, i, hi, hβ⟩ := hmax.exists_inv hc0
      apply hJ
      rw [Ideal.eq_top_iff_one]
      have e1 : (1 : ↥(Algebra.adjoin A G)) =
          algebraMap A _ β * algebraMap A _ a + algebraMap A _ i := by
        rw [← map_mul, ← map_add, hβ, map_one]
      rw [e1]
      exact add_mem (Ideal.mul_mem_left _ _ haJ) (hNJ (hpN hi))
  have adjDen : ∀ (A'' : Type u) [CommRing A''] (K : Type u) [CommRing K] [Algebra A'' K]
    (G : Set K) (T : Subring K) (M : Submonoid K) (hMT : ∀ q ∈ M, q ∈ T)
    (hs : ∀ g ∈ G, ∃ q ∈ M, q * g ∈ T) (ha : ∀ a : A'', ∃ q ∈ M, q * algebraMap A'' K a ∈ T),
    ∀ r ∈ Algebra.adjoin A'' G, ∃ q ∈ M, q * r ∈ T := by
    intro A'' _ K _ _ G T M hMT hs ha
    intro r hr
    induction hr using Algebra.adjoin_induction with
    | mem x hx => exact hs x hx
    | algebraMap a => exact ha a
    | add x y _ _ hx hy =>
      obtain ⟨q₁, hq₁, h₁⟩ := hx
      obtain ⟨q₂, hq₂, h₂⟩ := hy
      refine ⟨q₁ * q₂, mul_mem hq₁ hq₂, ?_⟩
      have e : q₁ * q₂ * (x + y) = q₂ * (q₁ * x) + q₁ * (q₂ * y) := by ring
      rw [e]; exact add_mem (mul_mem (hMT _ hq₂) h₁) (mul_mem (hMT _ hq₁) h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨q₁, hq₁, h₁⟩ := hx
      obtain ⟨q₂, hq₂, h₂⟩ := hy
      refine ⟨q₁ * q₂, mul_mem hq₁ hq₂, ?_⟩
      have e : q₁ * q₂ * (x * y) = (q₁ * x) * (q₂ * y) := by ring
      rw [e]; exact mul_mem h₁ h₂
  have locEquiv : ∀ (C C'' L : Type u) [CommRing C] [IsDomain C]
    [CommRing C''] [IsDomain C''] [Field L] (i : C →+* L) (i'' : C'' →+* L) (j : C →+* C'')
    (hi : Function.Injective i) (hi'' : Function.Injective i'') (hcomp : i''.comp j = i)
    (Q : Ideal C) [hQ : Q.IsPrime] (Q'' : Ideal C'') [hQ'' : Q''.IsPrime] (hc : Q''.comap j = Q)
    (H : ∀ y : C'', ∃ d x : C, d ∉ Q ∧ i x = i d * i'' y),
    ∃ e : Localization.AtPrime Q ≃+* Localization.AtPrime Q'',
      ∀ x : C, e (algebraMap C (Localization.AtPrime Q) x) =
        algebraMap C'' (Localization.AtPrime Q'') (j x) := by
    intro C C'' L _ _ _ _ _ i i'' j hi hi'' hcomp Q hQ Q'' hQ'' hc H
    have hij : ∀ x, i'' (j x) = i x := fun x => by rw [← hcomp]; rfl
    have hjQ : ∀ d : C, d ∉ Q → j d ∉ Q'' := fun d hd h => hd (by rw [← hc]; exact h)
    have hne : ∀ d : C, d ∉ Q → i d ≠ 0 := by
      intro d hd h0
      apply hd
      have : d = 0 := hi (by rw [h0, map_zero])
      rw [this]; exact Q.zero_mem
    have hne'' : ∀ d : C'', d ∉ Q'' → i'' d ≠ 0 := by
      intro d hd h0
      apply hd
