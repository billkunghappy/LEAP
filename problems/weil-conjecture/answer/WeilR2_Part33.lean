  obtain ⟨a, ha1, ha2⟩ := crt _ _ _ g N hFin.1 hUni hcol
  have hrad : (wcLlsFcJV W A K L t c' b').radical = wcLlsFcJV W A K L t c' b' := by
    unfold wcLlsFcJV
    exact Ideal.radical_idem _
  rw [hrad] at ha1 ha2
  have hd := hJV _ ha2
