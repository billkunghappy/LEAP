    haveI hFnoeth := wcpa_dj_llsm_flsc_fs_noetherian ↥W ↥(integralClosure R L) Q

    have hdimF0 := wcpa_dj_llsm_flsc_fibre_dim ↥W R ↥(integralClosure R L) σR
