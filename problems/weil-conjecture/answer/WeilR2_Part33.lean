    · obtain ⟨⟨E, hE, hEP, htE⟩, huE⟩ := hbr P hP h𝔶P htP
      refine ⟨?_, ?_⟩
      · obtain ⟨i, hi⟩ := hex E hE.1.1 htE hE.1.2
