  have hcontr : Pe.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) ≤
