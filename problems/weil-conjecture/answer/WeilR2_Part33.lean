            (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A cs))) * d -
            q (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A cz)))) *
            (is * q s)) * his' -
          (q (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A cs))) * d -
            q (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A cz)))) * his

  intro z
  obtain ⟨x, hx⟩ := hsurj (q z)
  obtain ⟨⟨a, a'⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl x
  have ha'w : wcLlsCasIota W A K L t c' b' (a' : ↥(integralClosure A L)) ∈ w.primeCompl := by
    intro h
    have h' : (a' : ↥(integralClosure A L)) ∈ w.comap (wcLlsCasIota W A K L t c' b') := h
    rw [← hyw] at h'
    exact a'.2 h'
  have hx1 := hx
  simp only [ψ, φ0, q, RingHom.comp_apply, Localization.localRingHom_mk'] at hx1
  have hx2 := Ideal.Quotient.eq.mp hx1
  rw [← IsLocalization.mk'_one (M := w.primeCompl) (Localization.AtPrime w) z] at hx2
  have e := IsLocalization.mk'_sub (Localization.AtPrime w) (wcLlsCasIota W A K L t c' b' a) z
    (⟨wcLlsCasIota W A K L t c' b' a', ha'w⟩ : w.primeCompl) (1 : w.primeCompl)
  rw [← e, IsLocalization.mk'_mem_map_algebraMap_iff] at hx2
  obtain ⟨m, hm, hmem⟩ := hx2
  rcases h𝔷P.mem_or_mem hmem with h | h
  · exact absurd (h𝔷w h) hm
  · refine ⟨a, a', a'.2, ?_⟩
    have h2 := 𝔷.neg_mem h
    convert h2 using 1
    simp only [OneMemClass.coe_one, mul_one]
    ring

theorem wcpa_dj_llsm_scdc_castelnuovo : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' b' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → b' ∈ IsLocalRing.maximalIdeal ↥W →
      b' ≠ 0 → wcLlsDiscSep W A K L t c' b' → wcLlsScDF W A K L t c' b' →
      (∃ w : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L),
        w.IsPrime ∧
        w.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)) =
          wcLlsScNV W A K t c' b' ∧
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L (wcLlsScNV W A K t c' b') w) →
      wcpaDjLkBranches (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 1 →
      wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' b' hc' hb' hb0 hs hDF
    hwex hbr
  obtain ⟨w, hwP, hwc, hwU⟩ := hwex
  haveI := hwP

  have hyw : y = w.comap (wcLlsCasIota W A K L t c' b') := by
    obtain ⟨_, _, _, hmax, _, _, h𝔭eq, _⟩ := hPD
    have hcomp : ∀ a : A, wcLlsCasIota W A K L t c' b' (algebraMap A ↥(integralClosure A L) a) =
        algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) a) := by
      intro a
      apply Subtype.ext
      exact IsScalarTower.algebraMap_apply A K L a
    have hNP : (wcLlsScNV W A K t c' b').IsPrime := hwc ▸ Ideal.IsPrime.comap _
    have hc : (w.comap (wcLlsCasIota W A K L t c' b')).comap
        (algebraMap A ↥(integralClosure A L)) = 𝔭 := by
      have e1 : (w.comap (wcLlsCasIota W A K L t c' b')).comap
          (algebraMap A ↥(integralClosure A L)) =
          (wcLlsScNV W A K t c' b').comap
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})) := by
        rw [← hwc]
        ext a
        simp only [Ideal.mem_comap, hcomp]
      rw [e1]
      symm
      apply hmax.eq_of_le
      · haveI := hNP
        exact (Ideal.IsPrime.comap _).ne_top
      · rw [h𝔭eq]
        refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
          have e2 : algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) t =
              algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (t - algebraMap ↥W A c') +
              algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A c') := by
            rw [← map_add, sub_add_cancel]
          rw [e2]
          unfold wcLlsScNV
          exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
            (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc'))
        · rw [Ideal.map_le_iff_le_comap]
          intro x hx
          rw [Ideal.mem_comap, Ideal.mem_comap]
          unfold wcLlsScNV
          exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hx)
    exact (hU _ (Ideal.IsPrime.comap _) hc).symm

  obtain ⟨𝔷, h𝔷P, h𝔷w, h𝔷m, h𝔷V, h𝔷τ, hnil, hD⟩ :=
    wcpa_dj_llsm_sccas_strict_branch Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU c' b' hc' hb' hb0 hs
      w hwc hbr
  haveI := h𝔷P

  haveI hred := wcpa_dj_llsm_sccas_reduced_fibre Ω W hW hWt A K L 𝔭 t y hPD hy hyc
  have hcon := wcpa_dj_llsm_sccas_contraction Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU c' b' hc' hb'
    hb0 hs hDF w hwc hwU hbr 𝔷 h𝔷P h𝔷w h𝔷m h𝔷V h𝔷τ

  have hIA : ∀ a : ↥(integralClosure A L), a ∈ Ideal.span {b : ↥(integralClosure A L) |
      ∃ x ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x} →
      wcLlsCasIota W A K L t c' b' a ∈ 𝔷 := by
    intro a ha
    have hle : Ideal.span {b : ↥(integralClosure A L) |
        ∃ x ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}
        ≤ 𝔷.comap (wcLlsCasIota W A K L t c' b') := by
      rw [Ideal.span_le]
      rintro b ⟨x, hx, hbx⟩
      rw [SetLike.mem_coe, Ideal.mem_comap]
      have e : wcLlsCasIota W A K L t c' b' b =
          algebraMap ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
            (algebraMap A ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) (algebraMap ↥W A x)) := by
        apply Subtype.ext
        show (b : L) = _
        rw [hbx, RingHom.comp_apply]
        exact IsScalarTower.algebraMap_apply A K L _
      rw [e]
      exact h𝔷m x hx
    exact hle ha

  let φ0 : Localization.AtPrime y →+* Localization.AtPrime w :=
    Localization.localRingHom y w (wcLlsCasIota W A K L t c' b') hyw
  let ψ : Localization.AtPrime y →+*
      wcLlsCasD ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) w 𝔷 :=
    (Ideal.Quotient.mk _).comp φ0
  have hψ : ∀ a ∈ Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
      (Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}), ψ a = 0 := by
    intro a ha
    have hle : Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
        (Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
          (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}) ≤ RingHom.ker ψ := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show Ideal.Quotient.mk _ (φ0 (algebraMap _ _ b)) = 0
      rw [Localization.localRingHom_to_map, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ (hIA b hb)
    exact hle ha
  let φ : wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y →+*
      wcLlsCasD ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) w 𝔷 :=
    Ideal.Quotient.lift (Ideal.map (algebraMap ↥(integralClosure A L) (Localization.AtPrime y))
      (Ideal.span {b : ↥(integralClosure A L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x})) ψ hψ

  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective y.primeCompl x
    have h1 : ψ (IsLocalization.mk' (Localization.AtPrime y) a s) = 0 := hx
    simp only [ψ, φ0, RingHom.comp_apply, Localization.localRingHom_mk',
      Ideal.Quotient.eq_zero_iff_mem] at h1
    rw [IsLocalization.mk'_mem_map_algebraMap_iff] at h1
    obtain ⟨s', hs', hs'a⟩ := h1
    have hιa : wcLlsCasIota W A K L t c' b' a ∈ 𝔷 := by
      rcases h𝔷P.mem_or_mem hs'a with h | h
      · exact absurd (h𝔷w h) hs'
      · exact h
    obtain ⟨s2, hs2, n, hn⟩ := hnil a hιa
    have hpow : (Ideal.Quotient.mk (Ideal.map (algebraMap ↥(integralClosure A L)
        (Localization.AtPrime y)) (Ideal.span {b : ↥(integralClosure A L) |
          ∃ x ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = ((algebraMap A L).comp (algebraMap ↥W A)) x}))
        (IsLocalization.mk' (Localization.AtPrime y) a s)) ^ n = 0 := by
      rw [← map_pow, ← IsLocalization.mk'_pow, Ideal.Quotient.eq_zero_iff_mem,
        IsLocalization.mk'_mem_map_algebraMap_iff]
      exact ⟨s2, hs2, hn⟩
    exact IsReduced.eq_zero (R := wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) _
      ⟨n, hpow⟩

  have hsurj : Function.Surjective φ := by
    intro d
    obtain ⟨e, rfl⟩ := Ideal.Quotient.mk_surjective d
    obtain ⟨⟨z, s⟩, rfl⟩ := IsLocalization.mk'_surjective w.primeCompl e
    obtain ⟨a1, a1', ha1', h1⟩ := hcon z
    obtain ⟨a2, a2', ha2', h2⟩ := hcon (s : _)
    have ha2 : a2 ∉ y := by
      intro ha2
      have hm : wcLlsCasIota W A K L t c' b' a2 ∈ w := by
        have : a2 ∈ w.comap (wcLlsCasIota W A K L t c' b') := hyw ▸ ha2
        exact this
      have h3 : wcLlsCasIota W A K L t c' b' a2' * (s : _) ∈ w := by
        have := w.add_mem (h𝔷w h2) hm
        rwa [sub_add_cancel] at this
      rcases hwP.mem_or_mem h3 with h | h
      · exact ha2' (hyw.symm ▸ (show a2' ∈ w.comap (wcLlsCasIota W A K L t c' b') from h))
      · exact s.2 h
    have hyden : a1' * a2 ∈ y.primeCompl := fun h => (hy.mem_or_mem h).elim ha1' ha2
    have hden : wcLlsCasIota W A K L t c' b' (a1' * a2) ∈ w.primeCompl := by
      intro h
      have h' : a1' * a2 ∈ y := by rw [hyw]; exact h
      exact hyden h'
    refine ⟨Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime y) (a1 * a2')
      (⟨a1' * a2, hyden⟩ : y.primeCompl)), ?_⟩
    show Ideal.Quotient.mk _ (φ0 (IsLocalization.mk' (Localization.AtPrime y) (a1 * a2')
      (⟨a1' * a2, hyden⟩ : y.primeCompl))) =
      Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime w) z s)
    rw [Localization.localRingHom_mk', Ideal.Quotient.eq]
    have hmem : wcLlsCasIota W A K L t c' b' a1 * wcLlsCasIota W A K L t c' b' a2' * (s : _) -
        z * (wcLlsCasIota W A K L t c' b' a1' * wcLlsCasIota W A K L t c' b' a2) ∈ 𝔷 := by
      have key : wcLlsCasIota W A K L t c' b' a1 * wcLlsCasIota W A K L t c' b' a2' * (s : _) -
          z * (wcLlsCasIota W A K L t c' b' a1' * wcLlsCasIota W A K L t c' b' a2) =
          z * wcLlsCasIota W A K L t c' b' a1' *
            (wcLlsCasIota W A K L t c' b' a2' * (s : _) - wcLlsCasIota W A K L t c' b' a2) -
          wcLlsCasIota W A K L t c' b' a2' * (s : _) *
            (wcLlsCasIota W A K L t c' b' a1' * z - wcLlsCasIota W A K L t c' b' a1) := by ring
      rw [key]
      exact 𝔷.sub_mem (𝔷.mul_mem_left _ h2) (𝔷.mul_mem_left _ h1)
    have e := IsLocalization.mk'_sub (Localization.AtPrime w)
      (wcLlsCasIota W A K L t c' b' (a1 * a2')) z
      (⟨wcLlsCasIota W A K L t c' b' (a1' * a2), hden⟩ : w.primeCompl) s
    have hmem' : IsLocalization.mk' (Localization.AtPrime w)
        (wcLlsCasIota W A K L t c' b' (a1 * a2'))
        (⟨wcLlsCasIota W A K L t c' b' (a1' * a2), hden⟩ : w.primeCompl) -
        IsLocalization.mk' (Localization.AtPrime w) z s ∈
        Ideal.map (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L)
          (Localization.AtPrime w)) 𝔷 := by
      rw [← e, IsLocalization.mk'_mem_map_algebraMap_iff]
      refine ⟨1, w.primeCompl.one_mem, ?_⟩
      rw [one_mul]
      show wcLlsCasIota W A K L t c' b' (a1 * a2') * (s : _) -
        z * wcLlsCasIota W A K L t c' b' (a1' * a2) ∈ 𝔷
      rw [map_mul, map_mul]
      exact hmem
    exact hmem'

  haveI : IsIntegrallyClosed (wcLlsCasD
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScV W A K t c' b'}) L) w 𝔷) := hD
  haveI hIC : IsIntegrallyClosed (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) :=
    IsIntegrallyClosed.of_equiv (RingEquiv.ofBijective φ ⟨hinj, hsurj⟩).symm
  unfold wcpaDjLkDelta
  rw [Module.length_eq_zero_iff, Submodule.Quotient.subsingleton_iff, eq_top_iff]
  rintro ⟨x, hx⟩ -
  rw [LinearMap.mem_range]
  obtain ⟨r, hr⟩ := (isIntegrallyClosed_iff (FractionRing _)).mp hIC hx
  exact ⟨r, Subtype.ext hr⟩

theorem wcpa_dj_llsm_sc_disc_criterion : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A)
    (y : Ideal ↥(integralClosure A L)), wcLlsPD W A 𝔭 (.disc t) →
    ∀ (_ : y.IsPrime), y.comap (algebraMap A ↥(integralClosure A L)) = 𝔭 → wcLlsUniq A L 𝔭 y →
    ∀ c' r b' q' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → b' = r * q' → b' ≠ 0 →
      wcLlsDiscSep W A K L t c' b' →
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
          wcLlsScN W A K t c' r →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L (wcLlsScN W A K t c' r) Q →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
          ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) Q) = 0 →
        wcpaDjLkDelta (wcLlsFS W ((algebraMap A L).comp (algebraMap ↥W A)) A y) = 0 :=
by
  intro Ω _ _ W hW hWt A _ _ _ K _ _ _ L _ _ _ _ _ _ 𝔭 t y hPD hy hyc hU c' r b' q' hc' hr hr0
    hq' hb' hb'0 hs' Q _ hQc hQU hδQ
  have hb'm : b' ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hb']
    exact Ideal.mul_mem_right q' _ hr
  have hC := wcpa_dj_llsm_scdc_fibre_connected Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU c' b' hc'
    hb'm hb'0 hs'
  have hDF := wcpa_dj_llsm_scdc_fibre_line Ω W hW hWt A K L 𝔭 t hPD c' r b' q' hc' hr hr0 hq' hb'
    hb'0 hs' Q hQc hQU hδQ hC
  obtain ⟨hw, hbr⟩ := wcpa_dj_llsm_scdc_one_boundary Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU c' b'
    hc' hb'm hb'0 hs' hDF
  exact wcpa_dj_llsm_scdc_castelnuovo Ω W hW hWt A K L 𝔭 t y hPD hy hyc hU c' b' hc' hb'm hb'0
    hs' hDF hw hbr

theorem wcpa_dj_llsm_rp_chart_transfer : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (𝔭 : Ideal A) (t : A) (c'' b₀ : ↥W) (A'' : Type u) [CommRing A''] [IsDomain A'']
    [Algebra ↥W A''] [Algebra A'' K] [IsFractionRing A'' K] [Algebra A'' L] [IsScalarTower A'' K L]
    (t' : A'') (𝔭'' : Ideal A''),
    wcLlsPD W A 𝔭 (.disc t) →
    c'' ∈ IsLocalRing.maximalIdeal ↥W → b₀ ∈ IsLocalRing.maximalIdeal ↥W → b₀ ≠ 0 →
    wcLlsBrSub W A K A'' (wcLlsScS W A K t c'' b₀) {wcLlsScS W A K t c'' b₀} →
    algebraMap A'' K t' = wcLlsScS W A K t c'' b₀ →
    wcLlsPD W A'' 𝔭'' (.disc t') →
    ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c'' b₀}) L)) [Q.IsPrime],
      Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c'' b₀})
        ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c'' b₀}) L)) =
        wcLlsScN W A K t c'' b₀ →
      wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c'' b₀}) L (wcLlsScN W A K t c'' b₀) Q →
      ∃ y'' : Ideal ↥(integralClosure A'' L), y''.IsPrime ∧
        y''.comap (algebraMap A'' ↥(integralClosure A'' L)) = 𝔭'' ∧ wcLlsUniq A'' L 𝔭'' y'' ∧
        ∀ (_ : y''.IsPrime),
          wcpaDjLkDelta (wcLlsFS W ((algebraMap A'' L).comp (algebraMap ↥W A'')) A'' y'') =
            wcpaDjLkDelta (wcLlsFS W ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A)))
              ↥(Algebra.adjoin A {wcLlsScS W A K t c'' b₀}) Q) :=
by
  intro Ω _ W A _ _ _ K _ _ _ L _ _ _ _ 𝔭 t c'' b₀ A'' _ _ _ _ _ _ _ t' 𝔭'' hPD hc hb hb0 hSub
    ht' hPD'' Q _ hQc hQU
  classical

  have s2 : ∀ (R : Subalgebra A K) (P : Ideal ↥R) [P.IsPrime],
      (∀ a : A'', ∃ p q : ↥R, q ∉ P ∧ algebraMap A'' K a * (q : K) = (p : K)) →
      ∀ x : L, _root_.IsIntegral A'' x →
        ∃ q : ↥R, q ∉ P ∧ _root_.IsIntegral ↥R (algebraMap K L (q : K) * x) := by
    intro R P _ hden x hx
    obtain ⟨f, hfm, hfx⟩ := hx
    have hcommon : ∀ s : Finset ℕ, ∃ q : ↥R, q ∉ P ∧ ∀ i ∈ s, ∃ p : ↥R,
        algebraMap A'' K (f.coeff i) * (q : K) = (p : K) := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        exact ⟨1, fun h => (‹P.IsPrime›).ne_top ((Ideal.eq_top_iff_one P).mpr h),
          fun i hi => absurd hi (Finset.notMem_empty i)⟩
      | insert j s hj ih =>
        obtain ⟨q, hq, hqs⟩ := ih
        obtain ⟨pj, qj, hqj, hpj⟩ := hden (f.coeff j)
        refine ⟨q * qj, fun h => ?_, ?_⟩
        · rcases (‹P.IsPrime›).mem_or_mem h with h1 | h1
          · exact hq h1
          · exact hqj h1
        · intro i hi
          rcases Finset.mem_insert.mp hi with rfl | hi
          · refine ⟨pj * q, ?_⟩
            rw [Subalgebra.coe_mul, Subalgebra.coe_mul, ← hpj]; ring
          · obtain ⟨p, hp⟩ := hqs i hi
            refine ⟨p * qj, ?_⟩
            rw [Subalgebra.coe_mul, Subalgebra.coe_mul, ← hp]; ring
    obtain ⟨q, hq, hqc⟩ := hcommon (Finset.range (f.natDegree + 1))
    set F : Polynomial K := f.map (algebraMap A'' K) with hF
    have hFm : F.Monic := hfm.map _
    have hFdeg : F.natDegree = f.natDegree := hfm.natDegree_map _
    have hFx : Polynomial.eval₂ (algebraMap K L) x F = 0 := by
      rw [hF, Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq]; exact hfx
    set G := F.scaleRoots (q : K) with hG
    have hGm : G.Monic := by rw [hG, Polynomial.monic_scaleRoots_iff]; exact hFm
    have hGx : Polynomial.eval₂ (algebraMap K L) (algebraMap K L (q : K) * x) G = 0 :=
      Polynomial.scaleRoots_eval₂_eq_zero (algebraMap K L) hFx
    have hGl : G ∈ Polynomial.lifts (algebraMap ↥R K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [hG, Polynomial.coeff_scaleRoots, hFdeg, hF, Polynomial.coeff_map]
      by_cases hi : i < f.natDegree
      · obtain ⟨p, hp⟩ := hqc i (Finset.mem_range.mpr (by omega))
        refine ⟨p * q ^ (f.natDegree - i - 1), ?_⟩
        have he : f.natDegree - i = (f.natDegree - i - 1) + 1 := by omega
        rw [he, pow_succ]
        show ((p * q ^ (f.natDegree - i - 1) : ↥R) : K) = _
        rw [Subalgebra.coe_mul, SubmonoidClass.coe_pow, ← hp]; ring
      · have he : f.natDegree - i = 0 := by omega
        rw [he, pow_zero, mul_one]
        rcases Nat.lt_or_ge f.natDegree i with h | h
        · refine ⟨0, ?_⟩
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, map_zero, map_zero]
        · have hi' : i = f.natDegree := by omega
          refine ⟨1, ?_⟩
          rw [hi', ← Polynomial.leadingCoeff, hfm.leadingCoeff, map_one, map_one]
    obtain ⟨G', hG'map, -, hG'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hGl hGm
    refine ⟨q, hq, G', hG'm, ?_⟩
    have halg : algebraMap ↥R L = (algebraMap K L).comp (algebraMap ↥R K) :=
      RingHom.ext fun r => rfl
    rw [halg, ← Polynomial.eval₂_map, hG'map]
    exact hGx

  have s45 : ∀ (B B'' : Type u) [CommRing B] [CommRing B''] (i : B →+* B'') (Q : Ideal B)
      [Q.IsPrime], Function.Injective i → (∀ x : B'', ∃ u b : B, u ∉ Q ∧ i u * x = i b) →
      ∃ y'' : Ideal B'', y''.IsPrime ∧ y''.comap i = Q ∧
        (∀ y3 : Ideal B'', y3.IsPrime → y3.comap i = Q → y3 = y'') ∧
        ∀ (_ : y''.IsPrime), ∃ Θ : Localization.AtPrime y'' ≃+* Localization.AtPrime Q,
          ∀ b : B, Θ (algebraMap B'' (Localization.AtPrime y'') (i b)) =
            algebraMap B (Localization.AtPrime Q) b := by
    intro B B'' _ _ i Q _ hi hden
    choose u b hu hub using hden
    have spec : ∀ (x : B'') (b' : B) (s : Q.primeCompl), i s * x = i b' →
        IsLocalization.mk' (Localization.AtPrime Q) (b x) (⟨u x, hu x⟩ : Q.primeCompl) =
          IsLocalization.mk' (Localization.AtPrime Q) b' s := by
      intro x b' s h
      rw [IsLocalization.mk'_eq_iff_eq]
      congr 1
      apply hi
      show i ((s : B) * b x) = i (u x * b')
      rw [map_mul, map_mul, ← hub x, ← h]; ring
    obtain ⟨θ, hθdef⟩ : ∃ θ : B'' →+* Localization.AtPrime Q, ∀ x, θ x =
        IsLocalization.mk' (Localization.AtPrime Q) (b x) (⟨u x, hu x⟩ : Q.primeCompl) :=
      ⟨{ toFun := fun x =>
            IsLocalization.mk' (Localization.AtPrime Q) (b x) (⟨u x, hu x⟩ : Q.primeCompl)
         map_one' := (spec 1 1 1 (by simp)).trans (by rw [IsLocalization.mk'_one, map_one])
         map_mul' := fun x y => (spec (x * y) (b x * b y) (⟨u x, hu x⟩ * ⟨u y, hu y⟩) (by
            show i (u x * u y) * (x * y) = i (b x * b y)
            rw [map_mul, map_mul, ← hub x, ← hub y]; ring)).trans
            (IsLocalization.mk'_mul _ _ _ _ _)
         map_zero' := (spec 0 0 1 (by simp)).trans (IsLocalization.mk'_zero _)
         map_add' := fun x y => (spec (x + y) (b x * u y + b y * u x)
            (⟨u x, hu x⟩ * ⟨u y, hu y⟩) (by
            show i (u x * u y) * (x + y) = i (b x * u y + b y * u x)
            rw [map_mul, map_add, map_mul, map_mul, ← hub x, ← hub y]; ring)).trans
            (IsLocalization.mk'_add (S := Localization.AtPrime Q) (b x) (b y)
              ⟨u x, hu x⟩ ⟨u y, hu y⟩) }, fun _ => rfl⟩
    have hθi : ∀ b0 : B, θ (i b0) = algebraMap B _ b0 := fun b0 => by
      rw [hθdef]; exact (spec (i b0) b0 1 (by simp)).trans (IsLocalization.mk'_one _ _)
    have hθx : ∀ (x : B'') (u' b' : B), i u' * x = i b' →
        algebraMap B (Localization.AtPrime Q) u' * θ x = algebraMap B _ b' := by
      intro x u' b' h
      rw [← hθi, ← hθi, ← map_mul, h]
    have hmax : ∀ c : B, algebraMap B (Localization.AtPrime Q) c ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) ↔ c ∈ Q := fun c =>
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q c
    have KF : ∀ x : B'', ∀ u' b' : B, u' ∉ Q → i u' * x = i b' →
        (θ x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) ↔ b' ∈ Q) := by
      intro x u' b' hu' h
      rw [← hmax b', ← hθx x u' b' h]
      constructor
      · intro hx; exact Ideal.mul_mem_left _ _ hx
      · intro hx
        rcases (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime Q)).isPrime.mem_or_mem
          hx with h1 | h1
        · exact absurd ((hmax u').mp h1) hu'
        · exact h1
    have hyc : ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ).comap i = Q := by
      ext c; rw [Ideal.mem_comap, Ideal.mem_comap, hθi, hmax]
    refine ⟨(IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ, Ideal.comap_isPrime _ _,
      hyc, ?_, ?_⟩
    · intro y3 hy3 hy3c
      ext x
      rw [Ideal.mem_comap, KF x (u x) (b x) (hu x) (hub x)]
      have hiu : i (u x) ∉ y3 := fun h' => hu x (by rw [← hy3c]; exact h')
      constructor
      · intro hx
        have : i (b x) ∈ y3 := by rw [← hub x]; exact Ideal.mul_mem_left _ _ hx
        rw [← hy3c]; exact this
      · intro hb
        have : i (u x) * x ∈ y3 := by rw [hub x]; rw [← hy3c] at hb; exact hb
        exact (hy3.mem_or_mem this).resolve_left hiu
    · intro hp
      generalize hY : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ = Y at hp hyc
      have hunit : ∀ z : Y.primeCompl, IsUnit (θ z) := by
        intro z
        apply (IsLocalRing.notMem_maximalIdeal).mp
        intro h
        apply z.2
        have h' : (z : B'') ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap θ := h
        rw [hY] at h'
        exact h'
      have hunit2 : ∀ s : Q.primeCompl,
          IsUnit (((algebraMap B'' (Localization.AtPrime Y)).comp i) s) := by
        intro s
        have : i s ∈ Y.primeCompl := by
          show i s ∉ Y
          intro h
          apply s.2
          have h' : (s : B) ∈ Y.comap i := h
          rw [hyc] at h'
          exact h'
        exact IsLocalization.map_units (Localization.AtPrime Y) (⟨i s, this⟩ : Y.primeCompl)
      obtain ⟨Θ, hΘ⟩ : ∃ Θ : Localization.AtPrime Y →+* Localization.AtPrime Q,
          ∀ x : B'', Θ (algebraMap B'' _ x) = θ x :=
        ⟨IsLocalization.lift hunit, fun x => IsLocalization.lift_eq hunit x⟩
      obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : Localization.AtPrime Q →+* Localization.AtPrime Y,
          ∀ c : B, Ψ (algebraMap B _ c) = algebraMap B'' _ (i c) :=
        ⟨IsLocalization.lift hunit2, fun c => IsLocalization.lift_eq hunit2 c⟩
      have h1 : Θ.comp Ψ = RingHom.id _ := by
        apply IsLocalization.ringHom_ext Q.primeCompl
        ext c
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΨ, hΘ, hθi]
      have h2 : Ψ.comp Θ = RingHom.id _ := by
        apply IsLocalization.ringHom_ext Y.primeCompl
        ext x
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΘ]
        have hU : IsUnit (algebraMap B'' (Localization.AtPrime Y) (i (u x))) :=
          hunit2 ⟨u x, hu x⟩
        apply hU.mul_left_cancel
        calc algebraMap B'' _ (i (u x)) * Ψ (θ x)
            = Ψ (algebraMap B _ (u x)) * Ψ (θ x) := by rw [hΨ]
          _ = Ψ (algebraMap B _ (b x)) := by rw [← map_mul, hθx x (u x) (b x) (hub x)]
          _ = algebraMap B'' _ (i (b x)) := hΨ (b x)
          _ = algebraMap B'' _ (i (u x)) * algebraMap B'' _ x := by rw [← hub x, map_mul]
      refine ⟨RingEquiv.ofRingHom Θ Ψ h1 h2, fun c => ?_⟩
      show Θ _ = _
      rw [hΘ, hθi]

  have s9 : ∀ (B B'' : Type u) [CommRing B] [CommRing B''] (i : B →+* B'') (Q : Ideal B)
      [Q.IsPrime] (y'' : Ideal B'') [y''.IsPrime]
      (Θ : Localization.AtPrime y'' ≃+* Localization.AtPrime Q),
      (∀ b : B, Θ (algebraMap B'' (Localization.AtPrime y'') (i b)) =
        algebraMap B (Localization.AtPrime Q) b) →
      ∀ (S : Set B) (S'' : Set B''), S'' = i '' S →
      Nonempty ((Localization.AtPrime y'' ⧸
          (Ideal.span S'').map (algebraMap B'' (Localization.AtPrime y''))) ≃+*
        (Localization.AtPrime Q ⧸ (Ideal.span S).map (algebraMap B (Localization.AtPrime Q)))) := by
    intro B B'' _ _ i Q _ y'' _ Θ hΘ S S'' hS
    refine ⟨Ideal.quotientEquiv _ _ Θ ?_⟩
    simp only [Ideal.map_span, hS, Set.image_image]
    congr 1
    apply Set.image_congr
    intro c _
    exact (hΘ c).symm

  have hδ : ∀ (R0 S0 : Type u) [CommRing R0] [CommRing S0], (R0 ≃+* S0) →
      wcpaDjLkDelta R0 = wcpaDjLkDelta S0 := by
    intro R0 S0 _ _ e
    let eF : FractionRing R0 ≃+* FractionRing S0 := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R0, eF (algebraMap R0 (FractionRing R0) r) =
        algebraMap S0 (FractionRing S0) (e r) :=
      fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
    have H2 : ∀ s : S0, eF.symm (algebraMap S0 (FractionRing S0) s) =
        algebraMap R0 (FractionRing R0) (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
    have C1 : (algebraMap S0 (FractionRing S0)).comp (e : R0 →+* S0) =
        (eF : FractionRing R0 →+* FractionRing S0).comp (algebraMap R0 (FractionRing R0)) := by
      ext r
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H1 r).symm
    have C2 : (algebraMap R0 (FractionRing R0)).comp (e.symm : S0 →+* R0) =
        (eF.symm : FractionRing S0 →+* FractionRing R0).comp (algebraMap S0 (FractionRing S0)) := by
      ext s
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      exact (H2 s).symm
    have I1 : ∀ x : FractionRing R0, _root_.IsIntegral R0 x → _root_.IsIntegral S0 (eF x) :=
      fun x hx => hx.map_of_comp_eq (e : R0 →+* S0) (eF : FractionRing R0 →+* FractionRing S0) C1
    have I2 : ∀ y : FractionRing S0, _root_.IsIntegral S0 y → _root_.IsIntegral R0 (eF.symm y) :=
      fun y hy => hy.map_of_comp_eq (e.symm : S0 →+* R0)
        (eF.symm : FractionRing S0 →+* FractionRing R0) C2
    let eI : ↥(integralClosure R0 (FractionRing R0)) ≃+* ↥(integralClosure S0 (FractionRing S0)) :=
      { toFun := fun x => ⟨eF x, I1 x x.2⟩
        invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
        left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
        right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
        map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R0) y)
        map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R0) y) }
    have heI : ∀ r : R0, eI (algebraMap R0 _ r) = algebraMap S0 _ (e r) :=
      fun r => Subtype.ext (H1 r)
    have heI' : ∀ s : S0, eI.symm (algebraMap S0 _ s) = algebraMap R0 _ (e.symm s) := by
      intro s
      rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
    letI : RingHomInvPair (e : R0 →+* S0) (e.symm : S0 →+* R0) := RingHomInvPair.of_ringEquiv e
    letI : RingHomInvPair (e.symm : S0 →+* R0) (e : R0 →+* S0) := RingHomInvPair.symm _ _
    let LeI : ↥(integralClosure R0 (FractionRing R0)) →ₛₗ[(e : R0 →+* S0)]
        ↥(integralClosure S0 (FractionRing S0)) :=
      { toFun := eI
        map_add' := map_add eI
        map_smul' := fun r a => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
          rfl }
    let LeI' : ↥(integralClosure S0 (FractionRing S0)) →ₛₗ[(e.symm : S0 →+* R0)]
        ↥(integralClosure R0 (FractionRing R0)) :=
      { toFun := eI.symm
        map_add' := map_add eI.symm
        map_smul' := fun s b => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
          rfl }
    let p := LinearMap.range (Algebra.linearMap R0 ↥(integralClosure R0 (FractionRing R0)))
    let q := LinearMap.range (Algebra.linearMap S0 ↥(integralClosure S0 (FractionRing S0)))
    have h1 : p ≤ q.comap LeI := by
      rintro _ ⟨r, rfl⟩
      exact ⟨e r, (heI r).symm⟩
    have h2 : q ≤ p.comap LeI' := by
      rintro _ ⟨s, rfl⟩
      exact ⟨e.symm s, (heI' s).symm⟩
    let Φ := p.mapQ q LeI h1
    let Φ' := q.mapQ p LeI' h2
    let Φe : (↥(integralClosure R0 (FractionRing R0)) ⧸ p) ≃ₛₗ[(e : R0 →+* S0)]
        (↥(integralClosure S0 (FractionRing S0)) ⧸ q) :=
      { Φ with
        invFun := Φ'
        left_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H a =>
            show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.symm_apply_apply a)
        right_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H b =>
            show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.apply_symm_apply b) }
    let O := Submodule.orderIsoMapComap Φe
    unfold wcpaDjLkDelta
    rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
      OrderIso.map_top]

  revert Q
  set s := wcLlsScS W A K t c'' b₀ with hs
  intro Q _ hQc hQU
  obtain ⟨hB1, hB2, hB3⟩ := hSub
  obtain ⟨-, -, -, hmax'', -, -, h𝔭eq, -⟩ := hPD''
  have hinj'' : Function.Injective (algebraMap A'' K) := IsFractionRing.injective A'' K

  have hκex : ∀ r : ↥(Algebra.adjoin A {s}), ∃ a : A'', algebraMap A'' K a = (r : K) :=
    fun r => hB2 r.2
  choose κf hκf using hκex
  let κ : ↥(Algebra.adjoin A {s}) →+* A'' :=
    { toFun := κf
      map_one' := hinj'' (by rw [hκf, map_one, OneMemClass.coe_one])
      map_mul' := fun x y => hinj'' (by rw [hκf, map_mul, hκf, hκf, Subalgebra.coe_mul])
      map_zero' := hinj'' (by rw [hκf, map_zero, ZeroMemClass.coe_zero])
      map_add' := fun x y => hinj'' (by rw [hκf, map_add, hκf, hκf, Subalgebra.coe_add]) }
  have hκ : ∀ r, algebraMap A'' K (κ r) = (r : K) := hκf

  have hcomp : (algebraMap A'' L).comp κ =
      (RingHom.id L).comp (algebraMap ↥(Algebra.adjoin A {s}) L) := by
    ext r
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [IsScalarTower.algebraMap_apply A'' K L, hκ]
    rfl
  have hBB : ∀ x : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
      (x : L) ∈ integralClosure A'' L := fun x =>
    (mem_integralClosure_iff _ _).mpr
      (((mem_integralClosure_iff _ _).mp x.2).map_of_comp_eq κ (RingHom.id L) hcomp)
  let i : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) →+* ↥(integralClosure A'' L) :=
    ((integralClosure ↥(Algebra.adjoin A {s}) L).val.toRingHom).codRestrict
      (integralClosure A'' L) hBB
  have hi_inj : Function.Injective i := fun x y h =>
    Subtype.ext (show (x : L) = (y : L) from
      congrArg (fun z : ↥(integralClosure A'' L) => (z : L)) h)

  have hNN : wcLlsScN W A K t c'' b₀ ≤ Ideal.span (Subtype.val ⁻¹'
      ({s} ∪ (fun w => algebraMap A K (algebraMap ↥W A w)) ''
        ↑(IsLocalRing.maximalIdeal ↥W))) := by
    apply sup_le
    · rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact Ideal.subset_span (Or.inl rfl)
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap]
      apply Ideal.subset_span
      exact Or.inr ⟨w, hw, rfl⟩
  have hden : ∀ a : A'', ∃ p q : ↥(Algebra.adjoin A {s}), q ∉ wcLlsScN W A K t c'' b₀ ∧
      algebraMap A'' K a * (q : K) = (p : K) := by
    intro a
    obtain ⟨p, q, hq, hpq⟩ := hB3 (algebraMap A'' K a) ⟨a, rfl⟩
    exact ⟨p, q, fun h => hq (hNN h), hpq⟩
  haveI hNprime : (wcLlsScN W A K t c'' b₀).IsPrime := by
    rw [← hQc]; exact Ideal.comap_isPrime _ _
  have hdenB : ∀ x : ↥(integralClosure A'' L), ∃ u b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L),
      u ∉ Q ∧ i u * x = i b := by
    intro x
    obtain ⟨q, hqN, hqI⟩ := s2 (Algebra.adjoin A {s}) (wcLlsScN W A K t c'' b₀) hden (x : L)
      ((mem_integralClosure_iff _ _).mp x.2)
    refine ⟨algebraMap ↥(Algebra.adjoin A {s}) _ q,
      ⟨algebraMap K L (q : K) * x, (mem_integralClosure_iff _ _).mpr hqI⟩, ?_, ?_⟩
    · intro h; apply hqN; rw [← hQc]; exact h
    · apply Subtype.ext; rfl

  obtain ⟨y'', hy''p, hy''c, hy''u, hΘ⟩ := s45 _ _ i Q hi_inj hdenB

  have hkey : ∀ (a : A'') (r : ↥(Algebra.adjoin A {s})), algebraMap A'' K a = (r : K) →
      algebraMap A'' ↥(integralClosure A'' L) a =
        i (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) r) := by
    intro a r h
    apply Subtype.ext
    show algebraMap A'' L a = algebraMap K L (r : K)
    rw [IsScalarTower.algebraMap_apply A'' K L, h]
  have hmemQ : ∀ (y3 : Ideal ↥(integralClosure A'' L)), y3.comap i = Q →
      ∀ r : ↥(Algebra.adjoin A {s}),
        i (algebraMap ↥(Algebra.adjoin A {s}) ↥(integralClosure ↥(Algebra.adjoin A {s}) L) r) ∈ y3 ↔
          r ∈ wcLlsScN W A K t c'' b₀ := by
    intro y3 h r
    rw [← hQc, Ideal.mem_comap, ← h, Ideal.mem_comap]
  have hsN : (⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ : ↥(Algebra.adjoin A {s}))
      ∈ wcLlsScN W A K t c'' b₀ :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
  have hwN : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w) ∈ wcLlsScN W A K t c'' b₀ :=
    fun w hw => Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)

  have hle : ∀ y3 : Ideal ↥(integralClosure A'' L), y3.comap i = Q →
      𝔭'' ≤ y3.comap (algebraMap A'' _) := by
    intro y3 h3
    rw [h𝔭eq]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show algebraMap A'' _ t' ∈ y3
      rw [hkey t' ⟨s, Algebra.subset_adjoin (Set.mem_singleton s)⟩ ht']
      exact (hmemQ y3 h3 _).mpr hsN
    · rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, Ideal.mem_comap]
      rw [hkey _ (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)) (hB1 w)]
      exact (hmemQ y3 h3 _).mpr (hwN w hw)
  have hcon : y''.comap (algebraMap A'' _) = 𝔭'' := by
    haveI := hy''p
    exact (hmax''.eq_of_le (Ideal.IsPrime.ne_top (Ideal.comap_isPrime _ _)) (hle y'' hy''c)).symm

  have hU : wcLlsUniq A'' L 𝔭'' y'' := by
    intro y3 hy3 hy3c
    haveI := hy3
    refine hy''u y3 hy3 (hQU _ (Ideal.comap_isPrime _ _) ?_)
    ext r
    rw [Ideal.mem_comap, Ideal.mem_comap]
    have h1 := hkey (κ r) r (hκ r)
    constructor
    · intro hr
      have h2 : κ r ∈ 𝔭'' := by rw [← hy3c, Ideal.mem_comap, h1]; exact hr
      rw [← hcon, Ideal.mem_comap, h1] at h2
      exact (hmemQ y'' hy''c r).mp h2
    · intro hr
      have h2 : κ r ∈ 𝔭'' := by
        rw [← hcon, Ideal.mem_comap, h1]; exact (hmemQ y'' hy''c r).mpr hr
      rw [← hy3c, Ideal.mem_comap, h1] at h2
      exact h2
  refine ⟨y'', hy''p, hcon, hU, fun hp => ?_⟩

  have hwL : ∀ w : ↥W, ((algebraMap A'' L).comp (algebraMap ↥W A'')) w =
      ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w := by
    intro w
    simp only [RingHom.comp_apply]
    rw [IsScalarTower.algebraMap_apply A'' K L, hB1 w]
  have hS : {b : ↥(integralClosure A'' L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap A'' L).comp (algebraMap ↥W A'')) w} =
      i '' {b : ↥(integralClosure ↥(Algebra.adjoin A {s}) L) | ∃ w ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap K L).comp ((algebraMap A K).comp (algebraMap ↥W A))) w} := by
    ext g
    constructor
    · rintro ⟨w, hw, hg⟩
      refine ⟨algebraMap ↥(Algebra.adjoin A {s}) _
        (algebraMap A ↥(Algebra.adjoin A {s}) (algebraMap ↥W A w)), ⟨w, hw, rfl⟩, ?_⟩
      apply Subtype.ext
      show _ = (g : L)
      rw [hg, hwL]
      rfl
    · rintro ⟨b, ⟨w, hw, hb⟩, rfl⟩
      exact ⟨w, hw, by rw [hwL]; exact hb⟩
  obtain ⟨Θ, hΘc⟩ := hΘ hp
  obtain ⟨e⟩ := s9 _ _ i Q y'' Θ hΘc _ _ hS
  exact hδ _ _ e

theorem wcpa_dj_llsm_br_residue_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
