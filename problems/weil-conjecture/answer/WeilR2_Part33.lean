      ∀ (𝔶 I : Ideal B) (n : ℕ) (K : Fin n → Ideal C), (∀ i, (K i).IsPrime) →
      (∀ i k, i ≠ k → K i ⊔ K k = ⊤) → (∀ i, I.map j ≤ K i) →
      (∀ P : Ideal C, P.IsPrime → I.map j ≤ P → ∃ i, K i ≤ P) → I ≤ 𝔶 →
      (∀ P : Ideal B, P.IsPrime → 𝔶 ≤ P → t ∈ P →
        (∃ E ∈ I.minimalPrimes, E ≤ P ∧ t ∉ E) ∧
        ∀ E ∈ I.minimalPrimes, ∀ E' ∈ I.minimalPrimes, E ≤ P → E' ≤ P → t ∉ E → t ∉ E' →
          E = E') →
      ∀ P : Ideal B, P.IsPrime → 𝔶 ≤ P →
        (∃ i, (K i).comap j ≤ P) ∧ ∀ i k, (K i).comap j ≤ P → (K k).comap j ≤ P → i = k := by
    intro B C _ _ j t hj ht hsurj 𝔶 I n K hKp hKc hIK hcov hI𝔶 hbr P hP h𝔶P
    letI : Algebra B C := j.toAlgebra
    haveI : IsLocalization.Away t C :=
      IsLocalization.Away.mk t ht hsurj (fun a b hab => ⟨0, by simpa using hj hab⟩)
    have hdisj : ∀ E : Ideal B, E.IsPrime → t ∉ E →
        Disjoint (Submonoid.powers t : Set B) E := by
      intro E hE htE
      rw [Set.disjoint_left]
      rintro _ ⟨m, rfl⟩ hm
      exact htE (hE.mem_of_pow_mem m hm)
    have hmapP : ∀ E : Ideal B, E.IsPrime → t ∉ E → (E.map j).IsPrime := fun E hE htE =>
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers t) C E hE (hdisj E hE htE)
    have hcm : ∀ E : Ideal B, E.IsPrime → t ∉ E → (E.map j).comap j = E := fun E hE htE =>
      IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers t) C hE (hdisj E hE htE)
    have hmc : ∀ i, ((K i).comap j).map j = K i := fun i =>
      IsLocalization.map_comap (Submonoid.powers t) C (K i)
    have htK : ∀ i, t ∉ (K i).comap j := fun i h =>
      (hKp i).ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp h) ht)
    have hIKc : ∀ i, I ≤ (K i).comap j := fun i => Ideal.map_le_iff_le_comap.mp (hIK i)
    have hex : ∀ E : Ideal B, E.IsPrime → t ∉ E → I ≤ E → ∃ i, (K i).comap j ≤ E := by
      intro E hE htE hIE
      obtain ⟨i, hi⟩ := hcov (E.map j) (hmapP E hE htE) (Ideal.map_mono hIE)
      exact ⟨i, (Ideal.comap_mono hi).trans (hcm E hE htE).le⟩
