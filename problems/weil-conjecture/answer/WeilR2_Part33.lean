  set t : ↑Γ(X, V) := g (MvPolynomial.X 0) with ht
  set c : ↥W := wcG2cTau W V t σ₀ with hc
  letI iWA : Algebra ↥W (wcLlsaA W (FractionRing ↑Γ(X, V)) t c a₀) :=
    ((algebraMap ↑Γ(X, V) (wcLlsaA W (FractionRing ↑Γ(X, V)) t c a₀)).comp
      (algebraMap ↥W ↑Γ(X, V))).toAlgebra
  obtain ⟨hfrac, hPD⟩ := wcpa_dj_llsma_chart_ring Ω W ↑Γ(X, V) (FractionRing ↑Γ(X, V)) g 𝔭 c a₀
    hch.2.2.2.1 hch.2.2.2.2.1 hch.2.2.2.2.2.2.1 hcm hP₀.2.2.2 hP₀.2.2.1 rfl
  obtain ⟨y, hyP, hyc, hysolv⟩ := wcpa_dj_llsma_dec_point Ω W hW hWt C γ hcov hgal X uX ι hM y₀
    hy₀ hSm σ₀ a₀ hP₀ X₀ r₀ ι₀ hbl₀ hι₀ hM₀ w hw hnsm hss V hle g 𝔭 hch hgen rfl
    (FractionRing ↑Γ(X, V)) rfl rfl
  refine ⟨wcLlsaA W (FractionRing ↑Γ(X, V)) t c a₀, inferInstance, inferInstance, iWA,
    FractionRing ↑Γ(X, V), inferInstance, inferInstance, hfrac, ↑C.functionField, inferInstance,
    iKL, inferInstance, inferInstance, hfd, hgalois,
    wcLlsaN W (FractionRing ↑Γ(X, V)) t c a₀,
    algebraMap ↑Γ(X, V) (wcLlsaA W (FractionRing ↑Γ(X, V)) t c a₀) (t - algebraMap ↥W ↑Γ(X, V) c),
    ⟨wcLlsaS W (FractionRing ↑Γ(X, V)) t c a₀, Algebra.subset_adjoin (Set.mem_singleton _)⟩,
    y, hPD, ⟨hyP, hyc, hysolv, fun _ t' h => by cases h⟩, ?_⟩
  intro b hb hb0 hba
  rw [wcpa_dj_llsma_annsep_iff Ω W ↑Γ(X, V) (FractionRing ↑Γ(X, V)) ↑C.functionField t c a₀ b
    hba rfl]
  have hP : wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ₀ b := ⟨hP₀.1, hP₀.2.1, hb0, hb⟩
  have hBadT : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkBad R → wcpaDjLkBad S := by
    intro R S _ _ e hb'
    obtain ⟨h1, h2⟩ := wcpa_dj_lr1k_llfi_ringequiv R S e
    unfold wcpaDjLkBad at hb' ⊢
    rw [← h1, ← h2]
    exact hb'
  constructor
  · intro hS X' r ι' _ _ hbl hι' hM' V₀ hV₀ hiso y' hbad hr
    by_contra hns
    obtain ⟨𝔮, h𝔮, hq, ⟨e⟩⟩ := wcpa_dj_llsmg_nonsmooth_points Ω W hW hWt C γ hcov hgal X uX
      ι hM y₀ hy₀ hSm V hle g 𝔭 hch hgen rfl (FractionRing ↑Γ(X, V)) rfl σ₀ b hP X' r ι' hbl hι'
      hM' V₀ hV₀ hiso y' hr hns
    exact hS 𝔮 hq (hBadT _ _ e hbad)
  · intro hE 𝔮 h𝔮 hq hbad
    obtain ⟨X', r, hbl, ⟨ι', hι', hM'⟩, V₀, hV₀, hiso⟩ :=
      wcpa_dj_lr1k_imp_blowup_model Ω W hW hWt X uX ι hM σ₀ hP.1
        (wcpaDjLkPi W (γ ≫ ι) uX y₀) hP.2.1.symm hSm b hP.2.2.1 hP.2.2.2
    haveI : IsFinite γ := hcov.2.2.2.1
    haveI : QuasiCompact ι' :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) hM'.2.2.flip inferInstance
    haveI : QuasiSeparated ι' :=
