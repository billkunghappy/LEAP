    linear_combination (↑hus.unit⁻¹ : Localization.Away (g * (s * s'))) * e1 -
      algebraMap B (Localization.Away (g * (s * s'))) S * e2

  have hs1 : ∀ x : ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}), ∃ w : ↥W,
      x - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w) ∈
        wcLlsScN W A K t c' r :=
    wcpa_dj_llsm_flw_adjoin_residue Ω W A K 𝔭 t hPD c' r hc' hr hr0
  have hSQ : algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
      ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
      ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∈ Q := by
    have h : (⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
        ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) ∈
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) := by
      rw [hQc, wcLlsScN]; exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
    exact h
  have hσm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, wcFlSig W A K L t c' r w ∈ Q := by
    intro w hw
    have h : algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w) ∈
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) := by
      rw [hQc, wcLlsScN]; exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw)
    exact h
  have hres := wcpa_dj_llsm_flw_closure_residue Ω W ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L
    (wcFlSig W A K L t c' r) Q inferInstance (fun x => by
      obtain ⟨w, hw⟩ := hs1 x
      refine ⟨w, ?_⟩
      have h : x - algebraMap A ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) (algebraMap ↥W A w) ∈
          Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
            ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) := by
        rw [hQc]; exact hw
      have h2 := Ideal.mem_comap.1 h
      rw [map_sub] at h2
      exact h2) hσm
  have hrad := wcpa_dj_llsm_flw_rad_fibre Ω W A K L t c' r hs1 Q hQc hQU z hz
  exact key _ Q (wcFlSig W A K L t c' r) _ hSQ hσm hres g z hg hz hrad φ hφC hφX hφet

theorem wcpa_dj_llsm_fp_quot_away_fibre : ∀ (W : Type u) [CommRing W] [IsLocalRing W]
    (B : Type u) [CommRing B] (B' : Type u) [CommRing B'] [Algebra W B'] (σ : W →+* B)
    (e : B ≃+* B'), (∀ w : W, e (σ w) = algebraMap W B' w) → ∀ (G : B) (k : ℕ)
    (Ψ : Localization.Away (TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) (e G)) ≃ₐ[IsLocalRing.ResidueField W]
      (Fin k → Polynomial (IsLocalRing.ResidueField W))) (I : Ideal B),
    I = Ideal.map σ (IsLocalRing.maximalIdeal W) →
    ∃ θ : Localization.Away (Ideal.Quotient.mk I G) ≃+* (Fin k → Polynomial (IsLocalRing.ResidueField W)),
      ∀ w : W, θ (algebraMap (B ⧸ I) (Localization.Away (Ideal.Quotient.mk I G)) (Ideal.Quotient.mk I (σ w))) =
        algebraMap (IsLocalRing.ResidueField W) (Fin k → Polynomial (IsLocalRing.ResidueField W)) (IsLocalRing.residue W w) :=
by
  intro W _ _ B _ B' _ _ σ e he G k Ψ I hI
  subst hI
  set 𝔪 := IsLocalRing.maximalIdeal W with h𝔪
  set I' : Ideal B' := Ideal.map (algebraMap W B') 𝔪 with hI'
  have hIJ : I' = Ideal.map (e : B →+* B') (Ideal.map σ 𝔪) := by
    have hcomp : (e : B →+* B').comp σ = algebraMap W B' := RingHom.ext fun w => he w
    rw [Ideal.map_map, hcomp]
  let α : B ⧸ Ideal.map σ 𝔪 ≃+* B' ⧸ I' := Ideal.quotientEquiv (Ideal.map σ 𝔪) I' e hIJ
  let β₁ : B' ⧸ I' ≃+* TensorProduct W B' (IsLocalRing.ResidueField W) :=
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B' 𝔪).toRingEquiv
  let β₂ : TensorProduct W B' (IsLocalRing.ResidueField W) ≃+*
      TensorProduct W (IsLocalRing.ResidueField W) B' :=
    (Algebra.TensorProduct.comm W B' (IsLocalRing.ResidueField W)).toRingEquiv
  let γ : B ⧸ Ideal.map σ 𝔪 ≃+* TensorProduct W (IsLocalRing.ResidueField W) B' :=
    α.trans (β₁.trans β₂)
  have hγ : ∀ x : B, γ (Ideal.Quotient.mk _ x) =
      TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) (e x) := by
    intro x
    show β₂ (β₁ (α (Ideal.Quotient.mk _ x))) = _
    have h1 : α (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk I' (e x) :=
      Ideal.quotientEquiv_mk _ _ _ _ x
    rw [h1]
    have h2 : β₁ (Ideal.Quotient.mk I' (e x)) =
        TensorProduct.tmul W (e x) (1 : IsLocalRing.ResidueField W) :=
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk B' 𝔪 (e x)
    rw [h2]
    exact Algebra.TensorProduct.comm_tmul W (e x) (1 : IsLocalRing.ResidueField W)
  have H : Submonoid.map γ.toMonoidHom (Submonoid.powers (Ideal.Quotient.mk _ G)) =
      Submonoid.powers (TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) (e G)) := by
    rw [Submonoid.map_powers]
    exact congrArg Submonoid.powers (hγ G)
  let δ := IsLocalization.ringEquivOfRingEquiv
    (Localization.Away (Ideal.Quotient.mk (Ideal.map σ 𝔪) G))
    (Localization.Away (TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) (e G))) γ H
  refine ⟨δ.trans Ψ.toRingEquiv, ?_⟩
  intro w
  rw [RingEquiv.trans_apply]
  have hδ := IsLocalization.ringEquivOfRingEquiv_eq (S := Localization.Away (Ideal.Quotient.mk (Ideal.map σ 𝔪) G))
    (Q := Localization.Away (TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) (e G))) H
    (Ideal.Quotient.mk _ (σ w))
  have hc : γ (Ideal.Quotient.mk _ (σ w)) =
      algebraMap (IsLocalRing.ResidueField W) (TensorProduct W (IsLocalRing.ResidueField W) B')
        (IsLocalRing.residue W w) := by
    rw [hγ, he, ← Algebra.TensorProduct.tmul_one_eq_one_tmul, Algebra.TensorProduct.algebraMap_apply,
      IsLocalRing.ResidueField.algebraMap_eq, Algebra.algebraMap_self, RingHom.id_apply]
  show Ψ (δ _) = _
  rw [hδ, hc, ← IsScalarTower.algebraMap_apply]
  exact Ψ.commutes _

theorem wcpa_dj_llsm_fp_scale_integral : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K] [Algebra A K] (L : Type u) [Field L] [Algebra K L] (c : A) (U : K) (x : L), IsIntegral ↥(Algebra.adjoin A {U}) x → ∃ N : ℕ, IsIntegral ↥(Algebra.adjoin A {algebraMap A K c * U}) (algebraMap K L (algebraMap A K c) ^ N * x) :=
by
  intro A _ K _ _ L _ _ c U x hx
  classical
  have hγpow : ∀ m : ℕ, algebraMap A K c ^ m ∈ Algebra.adjoin A {algebraMap A K c * U} := by
    intro m
    rw [← map_pow]
    exact Subalgebra.algebraMap_mem _ _
  have s1 : ∀ a ∈ Algebra.adjoin A {U}, ∃ D : ℕ, ∀ D' : ℕ, D ≤ D' →
      algebraMap A K c ^ D' * a ∈ Algebra.adjoin A {algebraMap A K c * U} := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem y hy =>
      rw [Set.mem_singleton_iff] at hy
      subst hy
      refine ⟨1, fun D' hD' => ?_⟩
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hD'
      have e : algebraMap A K c ^ (1 + k) * y = algebraMap A K c ^ k * (algebraMap A K c * y) := by
        ring
      rw [e]
      exact Subalgebra.mul_mem _ (hγpow k) (Algebra.subset_adjoin (Set.mem_singleton _))
    | algebraMap r =>
      refine ⟨0, fun D' _ => ?_⟩
      rw [← map_pow, ← map_mul]
      exact Subalgebra.algebraMap_mem _ _
    | add y z _ _ hy hz =>
      obtain ⟨D₁, h₁⟩ := hy
      obtain ⟨D₂, h₂⟩ := hz
      refine ⟨max D₁ D₂, fun D' hD' => ?_⟩
      rw [mul_add]
      exact Subalgebra.add_mem _ (h₁ D' (le_of_max_le_left hD')) (h₂ D' (le_of_max_le_right hD'))
    | mul y z _ _ hy hz =>
      obtain ⟨D₁, h₁⟩ := hy
      obtain ⟨D₂, h₂⟩ := hz
      refine ⟨D₁ + D₂, fun D' hD' => ?_⟩
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hD'
      have e : algebraMap A K c ^ (D₁ + D₂ + k) * (y * z) =
          (algebraMap A K c ^ D₁ * y) * (algebraMap A K c ^ (D₂ + k) * z) := by
        ring
      rw [e]
      exact Subalgebra.mul_mem _ (h₁ D₁ le_rfl) (h₂ _ (by omega))
  obtain ⟨p, hpm, hpx⟩ := hx
  choose Dfun hDfun using fun i => s1 ((p.coeff i : Algebra.adjoin A {U}) : K) (p.coeff i).2
  set n := p.natDegree with hn
  set D := ∑ i ∈ Finset.range n, Dfun i with hD
  refine ⟨D, ?_⟩
  set pK := p.map (algebraMap (Algebra.adjoin A {U}) K) with hpK
  have hpKm : pK.Monic := hpm.map _
  have hpKdeg : pK.natDegree = n := hpm.natDegree_map _
  have hpKc : ∀ i, pK.coeff i = ((p.coeff i : Algebra.adjoin A {U}) : K) := by
    intro i
    rw [hpK, Polynomial.coeff_map]
    rfl
  set q := pK.scaleRoots (algebraMap A K c ^ D) with hq
  have hqc : ∀ i, q.coeff i ∈ Set.range
      (algebraMap (Algebra.adjoin A {algebraMap A K c * U}) K) := by
    intro i
    have hmem : q.coeff i ∈ Algebra.adjoin A {algebraMap A K c * U} := by
      rw [hq, Polynomial.coeff_scaleRoots, hpKdeg]
      rcases lt_trichotomy i n with hi | hi | hi
      · rw [hpKc, ← pow_mul, mul_comm _ (algebraMap A K c ^ (D * (n - i)))]
        apply hDfun i
        have h1 : Dfun i ≤ D :=
          Finset.single_le_sum (fun j _ => Nat.zero_le (Dfun j)) (Finset.mem_range.mpr hi)
        have h2 : D ≤ D * (n - i) := Nat.le_mul_of_pos_right _ (by omega)
        omega
      · subst hi
        rw [Nat.sub_self, pow_zero, mul_one, ← hpKdeg, hpKm.coeff_natDegree]
        exact Subalgebra.one_mem _
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul]
        exact Subalgebra.zero_mem _
    exact ⟨⟨q.coeff i, hmem⟩, rfl⟩
  have hqm : q.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hpKm
  obtain ⟨q', hq'map, -, hq'm⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.lifts_iff_coeff_lifts q).mpr hqc) hqm
  refine ⟨q', hq'm, ?_⟩
  have e1 : algebraMap (Algebra.adjoin A {algebraMap A K c * U}) L =
      (algebraMap K L).comp (algebraMap (Algebra.adjoin A {algebraMap A K c * U}) K) := rfl
  have e2 : algebraMap (Algebra.adjoin A {U}) L =
      (algebraMap K L).comp (algebraMap (Algebra.adjoin A {U}) K) := rfl
  rw [e1, ← Polynomial.eval₂_map, hq'map, ← map_pow, hq, Polynomial.scaleRoots_eval₂_mul, hpK,
    Polynomial.eval₂_map, ← e2, hpx, mul_zero]

theorem wcpa_dj_llsm_fp_rank_one_clear : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), (∀ a : Ω, a ≠ 0 → W.valuation a < 1 → ∀ x : Ω, ∃ N : ℕ, W.valuation (a ^ N * x) ≤ 1) → ∀ (L : Type u) [Field L] [Algebra Ω L] (T : Subring L), (∀ w : ↥W, algebraMap Ω L (w : Ω) ∈ T) → ∀ q : ↥W, q ≠ 0 → q ∈ IsLocalRing.maximalIdeal ↥W → ∀ x ∈ Algebra.adjoin Ω (T : Set L), ∃ N : ℕ, algebraMap Ω L (q : Ω) ^ N * x ∈ T :=
by
  intro Ω _ W H L _ _ T hT q hq hqm x hx
  have hγ : algebraMap Ω L (q : Ω) ∈ T := hT q
  have hq0 : (q : Ω) ≠ 0 := fun h => hq (Subtype.ext h)
  have hqv : W.valuation (q : Ω) < 1 := (ValuationSubring.valuation_lt_one_iff W q).mp hqm
  induction hx using Algebra.adjoin_induction with
  | mem y hy => exact ⟨0, by rw [pow_zero, one_mul]; exact hy⟩
  | algebraMap ω =>
    obtain ⟨N, hN⟩ := H (q : Ω) hq0 hqv ω
    have hmem : (q : Ω) ^ N * ω ∈ W := (ValuationSubring.valuation_le_one_iff W _).mp hN
    refine ⟨N, ?_⟩
    have h1 := hT ⟨(q : Ω) ^ N * ω, hmem⟩
    simpa only [map_mul, map_pow] using h1
  | add y z _ _ ihy ihz =>
    obtain ⟨a, ha⟩ := ihy
    obtain ⟨b, hb⟩ := ihz
    refine ⟨a + b, ?_⟩
    have e : algebraMap Ω L (q : Ω) ^ (a + b) * (y + z) =
        algebraMap Ω L (q : Ω) ^ b * (algebraMap Ω L (q : Ω) ^ a * y) +
        algebraMap Ω L (q : Ω) ^ a * (algebraMap Ω L (q : Ω) ^ b * z) := by ring
    rw [e]
    exact T.add_mem (T.mul_mem (T.pow_mem hγ b) ha) (T.mul_mem (T.pow_mem hγ a) hb)
  | mul y z _ _ ihy ihz =>
    obtain ⟨a, ha⟩ := ihy
    obtain ⟨b, hb⟩ := ihz
    refine ⟨a + b, ?_⟩
    have e : algebraMap Ω L (q : Ω) ^ (a + b) * (y * z) =
        (algebraMap Ω L (q : Ω) ^ a * y) * (algebraMap Ω L (q : Ω) ^ b * z) := by ring
    rw [e]
    exact T.mul_mem ha hb

theorem wcpa_dj_llsm_fp_etale_away_mul : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] (g g' : S) (φ : R →+* Localization.Away g), φ.Etale → ((IsLocalization.Away.awayToAwayRight (S := Localization.Away g) (P := Localization.Away (g * g')) g g').comp φ).Etale :=
by
  intro R _ S _ g g' φ hφ
  let T := Localization.Away (algebraMap S (Localization.Away g) g')
  have h2 : (algebraMap (Localization.Away g) T).Etale := by
    rw [RingHom.etale_algebraMap]
    exact Algebra.Etale.of_isLocalizationAway (algebraMap S (Localization.Away g) g')
  let e : T ≃ₐ[S] Localization.Away (g * g') :=
    IsLocalization.algEquiv (Submonoid.powers (g * g')) T (Localization.Away (g * g'))
  have h4 : IsLocalization.Away.awayToAwayRight (S := Localization.Away g)
      (P := Localization.Away (g * g')) g g' =
      e.toRingEquiv.toRingHom.comp (algebraMap (Localization.Away g) T) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers g)
    ext a
    simp only [RingHom.comp_apply]
    rw [IsLocalization.Away.awayToAwayRight_eq, ← IsScalarTower.algebraMap_apply]
    exact (e.commutes a).symm
  have h5 : (IsLocalization.Away.awayToAwayRight (S := Localization.Away g)
      (P := Localization.Away (g * g')) g g').Etale := by
    rw [h4]
    exact RingHom.Etale.respectsIso.left _ _ h2
  exact RingHom.Etale.stableUnderComposition φ _ hφ h5

theorem wcpa_dj_llsm_fp_isIntegral_iff_monic : ∀ (R : Type u) [CommRing R] (T : Type u) [CommRing T] [Nontrivial T] [Algebra R T] (y : T), IsIntegral R y ↔ ∃ p : Polynomial T, p.Monic ∧ (∀ i, p.coeff i ∈ Set.range (algebraMap R T)) ∧ p.eval y = 0 :=
by
  intro R _ T _ _ _ y
  constructor
  · rintro ⟨q, hqm, hqy⟩
    refine ⟨q.map (algebraMap R T), hqm.map _, fun i => ⟨q.coeff i, (Polynomial.coeff_map _ i).symm⟩, ?_⟩
    rw [Polynomial.eval_map]
    exact hqy
  · rintro ⟨p, hpm, hc, hp⟩
    have hl : p ∈ Polynomial.lifts (algebraMap R T) := (Polynomial.lifts_iff_coeff_lifts p).mpr hc
    obtain ⟨q, hqp, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl hpm
    refine ⟨q, hqm, ?_⟩
    rw [Polynomial.eval₂_eq_eval_map, hqp]
    exact hp

theorem wcpa_dj_llsm_fp_monic_transfer : ∀ (Λ : Type u) [CommRing Λ] (L : Type u) [CommRing L] [Nontrivial L] (j : Λ →+* L), Function.Injective j → ∀ (C : Set Λ) (D : Set L), (∀ y : L, y ∈ D ↔ ∃ c ∈ C, j c = y) → ∀ x : Λ, (∃ p : Polynomial Λ, p.Monic ∧ (∀ i, p.coeff i ∈ C) ∧ p.eval x = 0) ↔ (∃ p : Polynomial L, p.Monic ∧ (∀ i, p.coeff i ∈ D) ∧ p.eval (j x) = 0) :=
by
  intro Λ _ L _ _ j hj C D hD x
  constructor
  · rintro ⟨p, hpm, hpC, hpx⟩
    refine ⟨p.map j, hpm.map j, fun i => ?_, ?_⟩
    · rw [Polynomial.coeff_map]
      exact (hD _).mpr ⟨p.coeff i, hpC i, rfl⟩
    · rw [Polynomial.eval_map_apply, hpx, map_zero]
  · rintro ⟨q, hqm, hqD, hqx⟩
    have hlift : q ∈ Polynomial.lifts j := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      obtain ⟨c, _, hjc⟩ := (hD (q.coeff n)).mp (hqD n)
      exact ⟨c, hjc⟩
    obtain ⟨p, hpq⟩ := (Polynomial.mem_lifts q).mp hlift
    refine ⟨p, ?_, fun i => ?_, ?_⟩
    · apply Polynomial.monic_of_injective hj
      rw [hpq]
      exact hqm
    · obtain ⟨c, hc, hjc⟩ := (hD (q.coeff i)).mp (hqD i)
      have h1 : j (p.coeff i) = j c := by
        rw [← Polynomial.coeff_map, hpq, hjc]
      rw [hj h1]
      exact hc
    · apply hj
      rw [map_zero, ← Polynomial.eval_map_apply, hpq, hqx]

theorem wcpa_dj_llsm_fl_fibre_product : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A] (K : Type u) [Field K] [Algebra A K]
    [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L] (𝔭 : Ideal A) (t : A), wcLlsPD W A 𝔭 (.disc t) →
    ∀ c' r b' q' : ↥W, c' ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W →
      r ≠ 0 → q' ∈ IsLocalRing.maximalIdeal ↥W → b' = r * q' → b' ≠ 0 →
      ∀ (Q : Ideal ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) [Q.IsPrime],
        Q.comap (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
          ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)) =
          wcLlsScN W A K t c' r →
        wcLlsUniq ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L (wcLlsScN W A K t c' r) Q →
        ∀ g z : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L), g ∉ Q → z ∈ Q →
        ∀ φ : Polynomial ↥W →+* Localization.Away g,
          φ.comp Polynomial.C =
            (algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
              (Localization.Away g)).comp (wcFlSig W A K L t c' r) →
          φ Polynomial.X =
            algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
              (Localization.Away g) z →
          φ.Etale →
        ∀ g' : ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L), g' ∉ Q →
        ∀ P : Polynomial ↥W, P.Monic → 1 ≤ P.natDegree →
          P.map (IsLocalRing.residue ↥W) = Polynomial.X ^ P.natDegree →
        ∀ ε : (Localization.Away (g * g'))ˣ,
          algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
              (Localization.Away (g * g'))
            (algebraMap ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})
              ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
              ⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩) =
            ↑ε * algebraMap ↥(integralClosure ↥(Algebra.adjoin A {wcLlsScS W A K t c' r}) L)
