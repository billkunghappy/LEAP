  have hs : (⟨wcLlsScS W A K t c' r, Algebra.subset_adjoin (Set.mem_singleton _)⟩ :
      ↥(Algebra.adjoin A {wcLlsScS W A K t c' r})) ∈ wcLlsScN W A K t c' r :=
