      have h2 : K k ≤ E.map j := (hmc k) ▸ Ideal.map_mono hk
      exact (hmapP E hE htE).ne_top (top_le_iff.mp (hKc i k hik ▸ sup_le h1 h2))
    have hl : ∀ E : Ideal B, E.IsPrime → t ∉ E → I ≤ E → ∀ i, E ≤ (K i).comap j →
        ∀ l, K l ≤ E.map j → l = i := by
      intro E hE htE hIE i hEi l hl
      by_contra hli
      have h1 : E.map j ≤ K i := (hmc i) ▸ Ideal.map_mono hEi
