        (fun i => (((ν + μ) i : ℕ) : ℤ) - if i ∈ σs then ((κ + N : ℕ) : ℤ) else 0) =
        (fun i => (μ i : ℤ) - if i ∈ σs then (κ : ℤ) else 0) := by
      intro μ
      funext i
      rw [Finsupp.add_apply, s2]
      by_cases hi : i ∈ σs
      · simp only [hi, ite_true]; push_cast; ring
      · simp only [hi, ite_false]; push_cast; ring
    refine ⟨?_, ?_⟩
    · symm
      apply Finset.sum_nbij' (fun μ => ν + μ) (fun μ' => μ' - ν)
      · intro μ hμ; exact s3d μ hμ
      · intro μ' hμ'; exact (s3c μ' hμ').2
      · intro μ _; exact add_tsub_cancel_left ν μ
      · intro μ' hμ'; exact add_tsub_cancel_of_le (s3c μ' hμ').1
      · intro μ _
        rw [s3a, s4 μ]
    · intro c hc μ' hμ'
      obtain ⟨hle, hmem⟩ := s3c μ' hμ'
      have e : μ' = ν + (μ' - ν) := (add_tsub_cancel_of_le hle).symm
      rw [e]
      have hsum : ∑ i, (((ν + (μ' - ν)) i : ℕ) : ℤ) =
          ∑ i, (ν i : ℤ) + ∑ i, (((μ' - ν) i : ℕ) : ℤ) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finsupp.add_apply]
        push_cast
        ring
      have hν' : ∑ i, (ν i : ℤ) = (N : ℤ) * σs.card := by
        simp only [s2]
        push_cast
        rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
        ring
      rw [hsum, hν', hc _ hmem]
      ring
  have homogOf : ∀ (g : MvPolynomial (Fin (M + 1)) R) (c : ℤ),
      (∀ μ ∈ g.support, (∑ i, (μ i : ℤ)) = c) → g.IsHomogeneous c.toNat := by
    intro g c hc dd hd
    have hmem : dd ∈ g.support := MvPolynomial.mem_support_iff.mpr hd
    have h1 := hc dd hmem
    have h2 : (Finsupp.weight 1 dd : ℕ) = ∑ i, dd i := by
      rw [Finsupp.weight_apply, Finsupp.sum_fintype]
      · simp
      · intro i; simp
    rw [h2, ← h1, ← Nat.cast_sum, Int.toNat_natCast]

  obtain ⟨𝒯, h𝒯⟩ : ∃ T : Set (Fin q → MvPolynomial (Fin (M + 1)) R),
      T = {f | (∃ t : ℕ, ∀ ρ, (f ρ).IsHomogeneous t) ∧ ∀ J, wcpaScPEv φ₀ hDU x r σ J f = 0} :=
    ⟨_, rfl⟩
  have mem𝒯 : ∀ f ∈ 𝒯, (∃ t : ℕ, ∀ ρ, (f ρ).IsHomogeneous t) ∧
      ∀ J, wcpaScPEv φ₀ hDU x r σ J f = 0 := by
    intro f hf; rw [h𝒯] at hf; exact hf
  have mk𝒯 : ∀ f : Fin q → MvPolynomial (Fin (M + 1)) R, ((∃ t : ℕ, ∀ ρ, (f ρ).IsHomogeneous t) ∧
      ∀ J, wcpaScPEv φ₀ hDU x r σ J f = 0) → f ∈ 𝒯 := by
    intro f hf; rw [h𝒯]; exact hf
  obtain ⟨K, hK⟩ : ∃ K : Submodule (MvPolynomial (Fin (M + 1)) R)
      (Fin q → MvPolynomial (Fin (M + 1)) R), K = Submodule.span _ 𝒯 := ⟨_, rfl⟩
  have K0 : ∀ f ∈ K, ∀ J, wcpaScPEv φ₀ hDU x r σ J f = 0 := by
    intro f hf J
    rw [hK] at hf
    induction hf using Submodule.span_induction with
    | mem f hf => exact (mem𝒯 f hf).2 J
    | zero => unfold wcpaScPEv wcKlmPEv; simp
    | add f g _ _ h1 h2 =>
      unfold wcpaScPEv at h1 h2 ⊢
      rw [pevEq] at h1 h2 ⊢
      simp only [Pi.add_apply, MvPolynomial.eval₂_add, add_smul, Finset.sum_add_distrib, h1, h2,
        add_zero]
    | smul a f _ h =>
      unfold wcpaScPEv at h ⊢
      rw [pevEq] at h ⊢
      simp only [Pi.smul_apply, smul_eq_mul, MvPolynomial.eval₂_mul, mul_smul]
      rw [← Finset.smul_sum, h, smul_zero]
  have graded : ∀ f ∈ K, ∀ t : ℕ, (fun ρ => if d₀ ≤ t then
      MvPolynomial.homogeneousComponent (t - d₀) (f ρ) else 0) ∈ K := by
    intro f hf t
    rw [hK] at hf ⊢
    obtain ⟨n', g', gg, rfl⟩ := Submodule.mem_span_set'.mp hf
    have hgg : ∀ i, ∃ t' : ℕ, ∀ ρ,
        ((gg i : Fin q → MvPolynomial (Fin (M + 1)) R) ρ).IsHomogeneous t' :=
      fun i => (mem𝒯 _ (gg i).2).1
    choose e he using hgg
    rw [gradedHc n' (fun i => e i + d₀) (fun i => (gg i : Fin q → MvPolynomial (Fin (M + 1)) R))
      (fun j ρ => by simpa using he j ρ) (fun j => Nat.le_add_left _ _) g' t]
    exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span (gg i).2))

  have hF0 : ∀ (k : Fin (M + 1)) (W : Y.Opens) (hW : W ≤ D k),
      (Y.presheaf.map (homOfLE hW).op).hom (x k k ^ r) = 1 := by
    intro k W hW; rw [hxJJ, one_pow, map_one]
  refine ⟨K, fun k => wcpaLmEvW φ₀ hDU x r σ k (D k) le_rfl,
    fun k l => wcpaLmEvW φ₀ hDU x r σ k (D k ⊓ D l) inf_le_left,
    fun k l j => wcpaLmEvW φ₀ hDU x r σ k (D k ⊓ D l ⊓ D j) (inf_le_left.trans inf_le_left),
    graded, fun w => ?_⟩
  refine ⟨fun k v v' => evAdd _ _ _ v v', fun k l v v' => evAdd _ _ _ v v',
    fun k l j v v' => evAdd _ _ _ v v', ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro k l hkl c
    obtain ⟨n₀, f, hf⟩ := hsurj k l c
    have hul : IsUnit ((Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom
        (x l k ^ r)) := unitSet k _ inf_le_left {l} (fun i hi => by
          rw [Finset.mem_singleton.mp hi]; exact inf_le_right) l (Finset.mem_singleton_self l)
    obtain ⟨v, hv, hev⟩ := surjVec ((Y.presheaf.map (homOfLE
      ((inf_le_left : D k ⊓ D l ≤ D k).trans (hDU k))).op).hom.comp φ₀)
      (fun i => (Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (x i k ^ r))
      (fun ρ => (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (σ ρ k))
      k l (ne_of_lt hkl) (hF0 k _ _) hul d₀ (w : ℤ) n₀ f
    refine ⟨v, AddSubgroup.mem_top v, hv, ?_⟩
    show wcpaLmEvW φ₀ hDU x r σ k (D k ⊓ D l) inf_le_left v = c
    unfold wcpaLmEvW
    rw [hev, ← pevW, ← hf, ← map_pow, smul_smul, ← mul_pow, Ring.inverse_mul_cancel _ hul, one_pow,
      one_smul]
  ·
    intro k l hkl v hv
    show wcpaLmEvW φ₀ hDU x r σ k (D k ⊓ D l) inf_le_left v = 0
    unfold wcLaurK at hv
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨κ, f, hfK, -, rfl⟩ := hv
      unfold wcpaLmEvW
      rw [evShift _ _ _ _ κ f (unitSet k _ inf_le_left _ (cov2 _ k l inf_le_left inf_le_right)),
        ← pevW, K0 f hfK k, map_zero, smul_zero]
    | zero => unfold wcpaLmEvW; exact evZero _ _ _
    | add v v' _ _ h1 h2 => unfold wcpaLmEvW at h1 h2 ⊢; rw [evAdd, h1, h2, add_zero]
    | smul a v _ h => unfold wcpaLmEvW at h ⊢; rw [evSmul, h, smul_zero]
  ·
    intro k l j hkl hlj v _ hv hΘ
    change wcpaLmEvW φ₀ hDU x r σ k (D k ⊓ D l ⊓ D j) (inf_le_left.trans inf_le_left) v = 0 at hΘ
    set τ : Finset (Fin (M + 1)) := {k, l, j} with hτ
    have hT : ∀ i ∈ τ, D k ⊓ D l ⊓ D j ≤ D i :=
      cov3 _ k l j (inf_le_left.trans inf_le_left) (inf_le_left.trans inf_le_right) inf_le_right
    obtain ⟨κ, h, hrep, hdeg⟩ := laurRepr (fun _ => (w : ℤ) - d₀) τ v hv
    have hv' : v = fun ρ => ∑ μ ∈ (h ρ).support,
        Finsupp.single (fun i => (μ i : ℤ) - if i ∈ τ then (κ : ℤ) else 0) ((h ρ).coeff μ) :=
      funext hrep
    set c : ℤ := (w : ℤ) - d₀ + κ * τ.card with hc
    have hhom : ∀ ρ, (h ρ).IsHomogeneous c.toNat := fun ρ => homogOf (h ρ) c (hdeg ρ)
    have hunits := unitSet k _ (inf_le_left.trans inf_le_left) τ hT
    have h0 : (G.presheaf.map (homOfLE (show D k ⊓ D l ⊓ D j ≤ D k from
        inf_le_left.trans inf_le_left)).op).hom (wcpaScPEv φ₀ hDU x r σ k h) = 0 := by
      rw [pevW]
      unfold wcpaLmEvW at hΘ
      rw [hv', evShift _ _ _ τ κ h hunits] at hΘ
      have hP : IsUnit (∏ i ∈ τ, Ring.inverse
          ((Y.presheaf.map (homOfLE (show D k ⊓ D l ⊓ D j ≤ D k from
            inf_le_left.trans inf_le_left)).op).hom (x i k ^ r))) :=
        Finset.prod_induction _ IsUnit (fun a b ha hb => ha.mul hb) isUnit_one
          (fun i hi => (hunits i hi).ringInverse)
      exact ((hP.pow κ).smul_eq_zero).mp hΘ
    obtain ⟨Nn, hN⟩ := hsat k l j c.toNat h hhom h0
    have hkl' : k ∉ ({l, j} : Finset (Fin (M + 1))) := by
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨ne_of_lt hkl, ne_of_lt (hkl.trans hlj)⟩
    have hlj' : l ∉ ({j} : Finset (Fin (M + 1))) := by
      simp only [Finset.mem_singleton]; exact ne_of_lt hlj
    have hmon : (MvPolynomial.X k * MvPolynomial.X l * MvPolynomial.X j :
        MvPolynomial (Fin (M + 1)) R) ^ Nn = ∏ i ∈ τ, MvPolynomial.X i ^ Nn := by
      rw [hτ, Finset.prod_insert hkl', Finset.prod_insert hlj', Finset.prod_singleton, mul_pow,
        mul_pow, mul_assoc]
    set f₃ : Fin q → MvPolynomial (Fin (M + 1)) R := fun ρ =>
      (MvPolynomial.X k * MvPolynomial.X l * MvPolynomial.X j) ^ Nn * h ρ with hf₃
    have hf₃K : f₃ ∈ K := by
      rw [hK]
      refine Submodule.subset_span (mk𝒯 f₃ ⟨⟨(1 + 1 + 1) * Nn + c.toNat, fun ρ => ?_⟩, hN⟩)
      exact ((((MvPolynomial.isHomogeneous_X R k).mul (MvPolynomial.isHomogeneous_X R l)).mul
        (MvPolynomial.isHomogeneous_X R j)).pow Nn).mul (hhom ρ)
    unfold wcLaurK
    refine Submodule.subset_span ⟨κ + Nn, f₃, hf₃K, fun ρ μ hμ => ?_, ?_⟩
    · rw [hf₃, hmon] at hμ
      rw [(shiftAlg τ κ Nn (h ρ)).2 c (hdeg ρ) μ hμ, hc]
      push_cast; ring
    · rw [hv']
      funext ρ
      rw [hf₃]
      dsimp only
      rw [hmon]
      exact ((shiftAlg τ κ Nn (h ρ)).1).symm
  ·
    intro k l hkl v hv
    symm
    exact resEvW k (D k) (D k ⊓ D l) le_rfl inf_le_left v
      (laurUnits w k _ le_rfl {k} v hv (fun i hi => by rw [Finset.mem_singleton.mp hi]))
  ·
    intro k l hkl v hv
    show wcpaLmEvW φ₀ hDU x r σ k (D k ⊓ D l) inf_le_left v = _
    rw [resEvW l (D l) (D k ⊓ D l) le_rfl inf_le_right v
      (laurUnits w l _ le_rfl {l} v hv (fun i hi => by rw [Finset.mem_singleton.mp hi]))]
    exact twistW w k l _ inf_le_left inf_le_right {l} v hv
  ·
    intro k l j hkl hlj v hv
    symm
    exact resEvW k (D k ⊓ D l) (D k ⊓ D l ⊓ D j) inf_le_left inf_le_left v
      (laurUnits w k _ inf_le_left {k, l} v hv (cov2 _ k l inf_le_left inf_le_right))
  ·
    intro k l j hkl hlj v hv
    symm
    exact resEvW k (D k ⊓ D j) (D k ⊓ D l ⊓ D j) inf_le_left
      (le_inf (inf_le_left.trans inf_le_left) inf_le_right) v
      (laurUnits w k _ inf_le_left {k, j} v hv (cov2 _ k j inf_le_left inf_le_right))
  ·
    intro k l j hkl hlj v hv
    show wcpaLmEvW φ₀ hDU x r σ k (D k ⊓ D l ⊓ D j) (inf_le_left.trans inf_le_left) v = _
    rw [resEvW l (D l ⊓ D j) (D k ⊓ D l ⊓ D j) inf_le_left
      (le_inf (inf_le_left.trans inf_le_right) inf_le_right) v
      (laurUnits w l _ inf_le_left {l, j} v hv (cov2 _ l j inf_le_left inf_le_right))]
    unfold wcpaScE
    rw [map_pow, resZ]
    exact twistW w k l _ _ _ {l, j} v hv

theorem wcpa_dj_scs_abstract_h1 {Y : Scheme.{u}} {M : ℕ} (D : Fin (M + 1) → Y.Opens)
    (E : ∀ k l, Γ(Y, D k ⊓ D l)) (hE1 : ∀ k, E k k = 1)
    (hE3 : ∀ k l j,
      (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        D k ⊓ D l ⊓ D j ≤ D k ⊓ D j)).op).hom (E k j) =
      (Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ⊓ D j ≤ D k ⊓ D l)).op).hom (E k l) *
      (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        D k ⊓ D l ⊓ D j ≤ D l ⊓ D j)).op).hom (E l j))
    (G : Y.Modules) (A : Type u) [CommRing A] (R' : ℕ) (d : Fin R' → ℕ)
    (K : Submodule (MvPolynomial (Fin (M + 1)) A) (Fin R' → MvPolynomial (Fin (M + 1)) A))
    (H : AddSubgroup (Fin R' → (Fin (M + 1) → ℤ) →₀ A))
    (Θ1 : ∀ k, (Fin R' → (Fin (M + 1) → ℤ) →₀ A) → Γ(G, D k))
    (Θ2 : ∀ k l, (Fin R' → (Fin (M + 1) → ℤ) →₀ A) → Γ(G, D k ⊓ D l))
    (Θ3 : ∀ k l j, (Fin R' → (Fin (M + 1) → ℤ) →₀ A) → Γ(G, D k ⊓ D l ⊓ D j))
    (w : ℕ) (hM : wcpaScModel D E G A R' d K H Θ1 Θ2 Θ3 w)
    (hVan : wcCnUtlVan A (M + 1) R' d K 1 (w : ℤ)) :
    wcpaScH1 D E G :=
by
  obtain ⟨N1, N2, N3, N4, N5, N6, N7, N8, N9, N10, N11⟩ := hM
  intro c hcoc

  have resM : ∀ (Mo : Y.Modules) {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Mo, U)),
      (Mo.presheaf.map (homOfLE h2).op).hom ((Mo.presheaf.map (homOfLE h1).op).hom x) =
      (Mo.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro Mo U V W h1 h2 x
    change (Mo.presheaf.map (homOfLE h1).op ≫ Mo.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resZ : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    change (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have smulM : ∀ (Mo : Y.Modules) {U V : Y.Opens} (h : V ≤ U) (r : Γ(Y, U)) (x : Γ(Mo, U)),
      (Mo.presheaf.map (homOfLE h).op).hom (r • x) =
      (Y.presheaf.map (homOfLE h).op).hom r • (Mo.presheaf.map (homOfLE h).op).hom x :=
    fun Mo U V h r x => Scheme.Modules.map_smul Mo (homOfLE h) r x
  have hinj : ∀ {U V : Y.Opens} (h1 : V ≤ U) (h2 : U ≤ V) (x : Γ(G, U)),
      (G.presheaf.map (homOfLE h1).op).hom x = 0 → x = 0 := by
    intro U V h1 h2 x hx
    have e0 : (G.presheaf.map (homOfLE h2).op).hom
        ((G.presheaf.map (homOfLE h1).op).hom x) = x := by
      rw [resM]
      change (G.presheaf.map (𝟙 _)).hom x = x
      rw [CategoryTheory.Functor.map_id]
      rfl
    rw [← e0, hx, map_zero]

  have hΘ2sub : ∀ k l a b, Θ2 k l (a - b) = Θ2 k l a - Θ2 k l b :=
    fun k l a b => map_sub (AddMonoidHom.mk' (Θ2 k l) (N2 k l)) a b
  have hΘ2neg : ∀ k l a, Θ2 k l (-a) = -Θ2 k l a :=
    fun k l a => map_neg (AddMonoidHom.mk' (Θ2 k l) (N2 k l)) a
  have hΘ3sub : ∀ k l j a b, Θ3 k l j (a - b) = Θ3 k l j a - Θ3 k l j b :=
    fun k l j a b => map_sub (AddMonoidHom.mk' (Θ3 k l j) (N3 k l j)) a b
  have hΘ3neg : ∀ k l j a, Θ3 k l j (-a) = -Θ3 k l j a :=
    fun k l j a => map_neg (AddMonoidHom.mk' (Θ3 k l j) (N3 k l j)) a
  have hC0 : ∀ σ, (0 : Fin R' → (Fin (M + 1) → ℤ) →₀ A) ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ := by
    intro σ
    simp only [wcLaurC, Set.mem_setOf_eq]
    intro r
    exact Submodule.zero_mem _
  have hCadd : ∀ σ (v v' : Fin R' → (Fin (M + 1) → ℤ) →₀ A),
      v ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ →
      v' ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ → v + v' ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ := by
    intro σ v v' hv hv'
    simp only [wcLaurC, Set.mem_setOf_eq] at hv hv' ⊢
    intro r
    exact Submodule.add_mem _ (hv r) (hv' r)
  have hCneg : ∀ σ (v : Fin R' → (Fin (M + 1) → ℤ) →₀ A),
      v ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ →
      -v ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ := by
    intro σ v hv
    simp only [wcLaurC, Set.mem_setOf_eq] at hv ⊢
    intro r
    exact Submodule.neg_mem _ (hv r)
  have hCsub : ∀ σ (v v' : Fin R' → (Fin (M + 1) → ℤ) →₀ A),
      v ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ →
      v' ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ → v - v' ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ := by
    intro σ v v' hv hv'
    simp only [wcLaurC, Set.mem_setOf_eq] at hv hv' ⊢
    intro r
    exact Submodule.sub_mem _ (hv r) (hv' r)
  have hCmono : ∀ σ τ : Finset (Fin (M + 1)), σ ⊆ τ → ∀ v : Fin R' → (Fin (M + 1) → ℤ) →₀ A,
      v ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ → v ∈ wcLaurC A (M + 1) R' d (w : ℤ) τ := by
    intro σ τ hst v hv
    simp only [wcLaurC, Set.mem_setOf_eq] at hv ⊢
    intro r
    refine Finsupp.supported_mono ?_ (hv r)
    intro β hβ
    simp only [Set.mem_setOf_eq] at hβ ⊢
    exact ⟨hβ.1, fun i hi => hβ.2 i (fun h => hi (hst h))⟩

  have hD2 : ∀ (f : Finset (Fin (M + 1)) → Fin R' → (Fin (M + 1) → ℤ) →₀ A) (k l : Fin (M + 1)),
      k < l → wcAltD (A := A) (M + 1) f {k, l} = f {l} - f {k} := by
    intro f k l hkl
    have h1 : k.val < l.val := hkl
    have n1 : k ∉ ({l} : Finset (Fin (M + 1))) := by
      simp only [Finset.mem_singleton, Fin.ext_iff]; omega
    have e1 : ({k, l} : Finset (Fin (M + 1))).filter (· < k) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl <;> intro h <;> simp only [Fin.lt_def] at h <;> omega
    have e2 : ({k, l} : Finset (Fin (M + 1))).filter (· < l) = {k} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Fin.ext_iff, Fin.lt_def]
      constructor <;> intro h <;> omega
    have e3 : ({k, l} : Finset (Fin (M + 1))).erase k = {l} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    have e4 : ({k, l} : Finset (Fin (M + 1))).erase l = {k} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    show ∑ i ∈ ({k, l} : Finset (Fin (M + 1))),
      ((-1 : A) ^ (({k, l} : Finset (Fin (M + 1))).filter (· < i)).card) •
        f (({k, l} : Finset (Fin (M + 1))).erase i) = _
    rw [Finset.sum_insert n1, Finset.sum_singleton, e1, e2, e3, e4, Finset.card_empty,
      Finset.card_singleton, pow_zero, pow_one]
    ext r β
    simp <;> ring
  have hD3 : ∀ (f : Finset (Fin (M + 1)) → Fin R' → (Fin (M + 1) → ℤ) →₀ A)
      (k l j : Fin (M + 1)),
      k < l → l < j → wcAltD (A := A) (M + 1) f {k, l, j} = f {l, j} - f {k, j} + f {k, l} := by
    intro f k l j hkl hlj
    have h1 : k.val < l.val := hkl
    have h2 : l.val < j.val := hlj
    have n1 : k ∉ ({l, j} : Finset (Fin (M + 1))) := by
      simp only [Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]; omega
    have n2 : l ∉ ({j} : Finset (Fin (M + 1))) := by
      simp only [Finset.mem_singleton, Fin.ext_iff]; omega
    have e1 : ({k, l, j} : Finset (Fin (M + 1))).filter (· < k) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl | rfl <;> intro h <;> simp only [Fin.lt_def] at h <;> omega
    have e2 : ({k, l, j} : Finset (Fin (M + 1))).filter (· < l) = {k} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Fin.ext_iff, Fin.lt_def]
      constructor <;> intro h <;> omega
    have e3 : ({k, l, j} : Finset (Fin (M + 1))).filter (· < j) = {k, l} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Fin.ext_iff, Fin.lt_def]
      constructor <;> intro h <;> omega
    have e4 : ({k, l, j} : Finset (Fin (M + 1))).erase k = {l, j} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    have e5 : ({k, l, j} : Finset (Fin (M + 1))).erase l = {k, j} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    have e6 : ({k, l, j} : Finset (Fin (M + 1))).erase j = {k, l} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    show ∑ i ∈ ({k, l, j} : Finset (Fin (M + 1))),
      ((-1 : A) ^ (({k, l, j} : Finset (Fin (M + 1))).filter (· < i)).card) •
        f (({k, l, j} : Finset (Fin (M + 1))).erase i) = _
    rw [Finset.sum_insert n1, Finset.sum_insert n2, Finset.sum_singleton, e1, e2, e3, e4, e5, e6,
      Finset.card_empty, Finset.card_singleton, Finset.card_pair (ne_of_lt hkl), pow_zero, pow_one,
      neg_one_sq]
    ext r β
    simp <;> ring
  have hsort : ∀ τ : Finset (Fin (M + 1)), τ.card = 3 →
      ∃ k l j : Fin (M + 1), k < l ∧ l < j ∧ τ = {k, l, j} := by
    intro τ hτ
    obtain ⟨x, y, x', hxy, hxx', hyx', rfl⟩ := Finset.card_eq_three.mp hτ
    rcases lt_or_gt_of_ne hxy with h1 | h1 <;> rcases lt_or_gt_of_ne hxx' with h2 | h2 <;>
      rcases lt_or_gt_of_ne hyx' with h3 | h3
    all_goals first
      | exact ⟨x, y, x', by assumption, by assumption, rfl⟩
      | (refine ⟨x, x', y, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨x', x, y, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨y, x, x', by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨y, x', x, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨x', y, x, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (exfalso; simp only [Fin.lt_def] at *; omega)

  have hlift : ∀ k l : Fin (M + 1), ∃ v, v ∈ H ∧ v ∈ wcLaurC A (M + 1) R' d (w : ℤ) {k, l} ∧
      (k < l → Θ2 k l v = c k l) ∧ (¬ k < l → v = 0) := by
    intro k l
    by_cases hkl : k < l
    · obtain ⟨v, hvH, hvC, hv⟩ := N4 k l hkl (c k l)
      exact ⟨v, hvH, hvC, fun _ => hv, fun h => absurd hkl h⟩
    · exact ⟨0, H.zero_mem, hC0 _, fun h => absurd h hkl, fun _ => rfl⟩
  choose V hVH hVC hVc hV0 using hlift

  obtain ⟨z, hzdef⟩ : ∃ z : Finset (Fin (M + 1)) → Fin R' → (Fin (M + 1) → ℤ) →₀ A,
      z = fun σ => if σ.card = 2 then -(∑ a ∈ σ, ∑ b ∈ σ, V a b) else 0 := ⟨_, rfl⟩
  have hz2 : ∀ k l : Fin (M + 1), k < l → z {k, l} = -V k l := by
    intro k l hkl
    have hne : k ≠ l := ne_of_lt hkl
    have h1 : z {k, l} = -(∑ a ∈ ({k, l} : Finset (Fin (M + 1))),
        ∑ b ∈ ({k, l} : Finset (Fin (M + 1))), V a b) := by
      rw [hzdef]
      exact if_pos (Finset.card_pair hne)
    rw [h1, Finset.sum_pair hne, Finset.sum_pair hne, Finset.sum_pair hne,
      hV0 k k (lt_irrefl k), hV0 l l (lt_irrefl l), hV0 l k (not_lt.mpr hkl.le)]
    simp
  have hz1 : ∀ σ : Finset (Fin (M + 1)),
      (σ.card = 1 + 1 → z σ ∈ wcLaurC A (M + 1) R' d (w : ℤ) σ) ∧ (σ.card ≠ 1 + 1 → z σ = 0) := by
    intro σ
    refine ⟨fun hσ => ?_, fun hσ => ?_⟩
    · have h1 : z σ = -(∑ a ∈ σ, ∑ b ∈ σ, V a b) := by
        rw [hzdef]
        exact if_pos hσ
      rw [h1]
      apply hCneg
      simp only [wcLaurC, Set.mem_setOf_eq]
      intro r
      rw [Finset.sum_apply]
      refine Submodule.sum_mem _ (fun a ha => ?_)
      rw [Finset.sum_apply]
      refine Submodule.sum_mem _ (fun b hb => ?_)
      have hsub : ({a, b} : Finset (Fin (M + 1))) ⊆ σ :=
        Finset.insert_subset_iff.mpr ⟨ha, Finset.singleton_subset_iff.mpr hb⟩
      have h2 := hCmono _ _ hsub _ (hVC a b)
      simp only [wcLaurC, Set.mem_setOf_eq] at h2
      exact h2 r
    · rw [hzdef]
      exact if_neg hσ

  have hz3 : ∀ τ : Finset (Fin (M + 1)), τ.card = 1 + 2 →
      wcAltD (A := A) (M + 1) z τ ∈ wcLaurK A (M + 1) R' d K (w : ℤ) τ := by
    intro τ hτ
    obtain ⟨k, l, j, hkl, hlj, rfl⟩ := hsort τ hτ
    have hkj : k < j := lt_trans hkl hlj
    rw [hD3 z k l j hkl hlj, hz2 l j hlj, hz2 k j hkj, hz2 k l hkl]
    have s1 : ({l, j} : Finset (Fin (M + 1))) ⊆ {k, l, j} := by
      intro x; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
    have s2 : ({k, j} : Finset (Fin (M + 1))) ⊆ {k, l, j} := by
      intro x; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
    have s3 : ({k, l} : Finset (Fin (M + 1))) ⊆ {k, l, j} := by
      intro x; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
    refine N6 k l j hkl hlj _ ?_ ?_ ?_
    · exact H.add_mem (H.sub_mem (H.neg_mem (hVH l j)) (H.neg_mem (hVH k j)))
        (H.neg_mem (hVH k l))
    · exact hCadd _ _ _ (hCsub _ _ _ (hCneg _ _ (hCmono _ _ s1 _ (hVC l j)))
        (hCneg _ _ (hCmono _ _ s2 _ (hVC k j)))) (hCneg _ _ (hCmono _ _ s3 _ (hVC k l)))
    · rw [N3, hΘ3sub, hΘ3neg, hΘ3neg, hΘ3neg, N11 k l j hkl hlj _ (hVC l j),
        N10 k l j hkl hlj _ (hVC k j), N9 k l j hkl hlj _ (hVC k l), hVc l j hlj, hVc k j hkj,
        hVc k l hkl, ← hcoc k l j]
      abel

  obtain ⟨y, hy1, hy2⟩ := hVan z hz1 hz3

  have hlt : ∀ k l : Fin (M + 1), k < l → c k l =
      (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (Θ1 k (y {k})) -
      E k l • (G.presheaf.map (homOfLE (inf_le_right : D k ⊓ D l ≤ D l)).op).hom
        (Θ1 l (y {l})) := by
    intro k l hkl
    have hX := hy2 {k, l} (Finset.card_pair (ne_of_lt hkl))
    rw [hz2 k l hkl, hD2 y k l hkl] at hX
    have h0 := N5 k l hkl _ hX
    rw [hΘ2sub, hΘ2neg, hΘ2sub, N7 k l hkl _ ((hy1 {k}).1 (Finset.card_singleton k)),
      N8 k l hkl _ ((hy1 {l}).1 (Finset.card_singleton l)), hVc k l hkl] at h0
    apply eq_of_sub_eq_zero
    rw [← neg_eq_zero, ← h0]
    abel

  have hckk : ∀ k, c k k = 0 := by
    intro k
    have h := hcoc k k k
    simp only [hE1, map_one, one_smul] at h
    apply hinj (inf_le_left : D k ⊓ D k ⊓ D k ≤ D k ⊓ D k) (le_inf le_rfl inf_le_left)
    have h2 : ∀ x : Γ(G, D k ⊓ D k ⊓ D k), x + x = x → x = 0 := by
      intro x hx
      have h3 := congrArg (fun t => t - x) hx
      simpa using h3
    exact h2 _ h

  refine ⟨fun k => Θ1 k (y {k}), ?_⟩
  intro k l
  beta_reduce
  rcases lt_trichotomy k l with hkl | rfl | hlk
  · exact hlt k l hkl
  · rw [hckk k, hE1 k, one_smul]
    exact (sub_self _).symm
  · have hcoc' := hcoc k l k
    rw [hckk k, map_zero, hlt l k hlk] at hcoc'
    simp only [map_sub, smulM, resM, resZ] at hcoc'
    have hu := hE3 k l k
    simp only [hE1, map_one] at hu
    rw [smul_sub, ← mul_smul, ← hu, one_smul] at hcoc'
    have hc' := eq_neg_of_add_eq_zero_left hcoc'
    rw [← sub_eq_zero]
    apply hinj (inf_le_left : D k ⊓ D l ⊓ D k ≤ D k ⊓ D l) (le_inf le_rfl inf_le_left)
    simp only [map_sub, smulM, resM, resZ]
    rw [hc']
    abel

theorem wcpa_dj_scs_transpose {Y : Scheme.{u}} (M : ℕ) (D : Fin (M + 1) → Y.Opens)
    (x : ∀ J K, Γ(Y, D K)) (hxJJ : ∀ J, x J J = 1)
    (hxc : ∀ J K K',
      (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x J K') =
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K from
          inf_le_left.trans inf_le_right)).op).hom (x J K) *
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x K K'))
    (n : ℕ) (G : Y.Modules) :
    (∀ k, wcpaScE D x n k k = 1) ∧
    (∀ k l j,
      (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
        D k ⊓ D l ⊓ D j ≤ D k ⊓ D j)).op).hom (wcpaScE D x n k j) =
      (Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ⊓ D j ≤ D k ⊓ D l)).op).hom
        (wcpaScE D x n k l) *
      (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
        D k ⊓ D l ⊓ D j ≤ D l ⊓ D j)).op).hom (wcpaScE D x n l j)) ∧
    (wcpaScH1 D (wcpaScE D x n) G → wcpaSvTwV D (fun J K =>
      (Y.presheaf.map (homOfLE (show D J ⊓ D K ≤ D K from inf_le_right)).op).hom (x J K) ^ n) G) :=
by
  have resY : ∀ {U V W : Y.Opens} (h₁ : U ≤ V) (h₂ : V ≤ W) (s : Γ(Y, W)),
      (Y.presheaf.map (homOfLE h₁).op).hom ((Y.presheaf.map (homOfLE h₂).op).hom s) =
        (Y.presheaf.map (homOfLE (h₁.trans h₂)).op).hom s := by
    intro U V W h₁ h₂ s
    have e : Y.presheaf.map (homOfLE h₂).op ≫ Y.presheaf.map (homOfLE h₁).op =
        Y.presheaf.map (homOfLE (h₁.trans h₂)).op := by
      rw [← Functor.map_comp]; rfl
    have e2 := congrArg (fun φ => φ.hom s) e
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using e2
  have resG : ∀ {U V W : Y.Opens} (h₁ : U ≤ V) (h₂ : V ≤ W) (s : Γ(G, W)),
      (G.presheaf.map (homOfLE h₁).op).hom ((G.presheaf.map (homOfLE h₂).op).hom s) =
        (G.presheaf.map (homOfLE (h₁.trans h₂)).op).hom s := by
    intro U V W h₁ h₂ s
    have e : G.presheaf.map (homOfLE h₂).op ≫ G.presheaf.map (homOfLE h₁).op =
        G.presheaf.map (homOfLE (h₁.trans h₂)).op := by
      rw [← Functor.map_comp]; rfl
    have e2 := congrArg (fun φ => φ.hom s) e
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] using e2
  have resGid : ∀ {U : Y.Opens} (h : U ≤ U) (s : Γ(G, U)),
      (G.presheaf.map (homOfLE h).op).hom s = s := by
    intro U h s
    have e : homOfLE h = 𝟙 U := Subsingleton.elim _ _
    rw [e, op_id, CategoryTheory.Functor.map_id]
    rfl
  have smulG : ∀ {U V : Y.Opens} (h : U ≤ V) (r : Γ(Y, V)) (s : Γ(G, V)),
      (G.presheaf.map (homOfLE h).op).hom (r • s) =
        (Y.presheaf.map (homOfLE h).op).hom r • (G.presheaf.map (homOfLE h).op).hom s := by
    intro U V h r s
    exact Scheme.Modules.map_smul G (homOfLE h) r s
  refine ⟨?_, ?_, ?_⟩
  · intro k
    simp only [wcpaScE, hxJJ, map_one, one_pow]
  · intro k l j
    have hT : D k ⊓ D l ⊓ D j ≤ D j ⊓ D l ⊓ D k := fun _ h => ⟨⟨h.2, h.1.2⟩, h.1.1⟩
    have h1 := congrArg (Y.presheaf.map (homOfLE hT).op).hom (hxc j l k)
    simp only [map_mul, resY] at h1
    simp only [wcpaScE, map_pow, resY]
    rw [h1, mul_pow, mul_comm]
  · intro H c hc
    let c' : ∀ k l, Γ(G, D k ⊓ D l) := fun k l =>
      (G.presheaf.map (homOfLE (le_inf inf_le_right inf_le_left : D k ⊓ D l ≤ D l ⊓ D k)).op).hom
        (c l k)
    obtain ⟨b, hb⟩ := H c' (by
      intro k l j
      have hT : D k ⊓ D l ⊓ D j ≤ D j ⊓ D l ⊓ D k := fun _ h => ⟨⟨h.2, h.1.2⟩, h.1.1⟩
      have h1 := congrArg (G.presheaf.map (homOfLE hT).op).hom (hc j l k)
      simp only [map_add, smulG, resG, resY, map_pow] at h1
      simp only [c', resG, resY, wcpaScE, map_pow]
      exact h1.symm)
    refine ⟨b, fun ν μ => ?_⟩
    have h1 := congrArg
      (G.presheaf.map (homOfLE (le_inf inf_le_right inf_le_left : D ν ⊓ D μ ≤ D μ ⊓ D ν)).op).hom
      (hb μ ν)
    simp only [c', resG, resGid, map_sub, smulG, wcpaScE, map_pow, resY] at h1
    exact h1

theorem wcpa_dj_sv_chart_serre {Y : Scheme.{u}} (R : Type u) [CommRing R] [IsNoetherianRing R]
    (M : ℕ) (U₀ : Y.Opens) (φ₀ : R →+* Γ(Y, U₀)) (D : Fin (M + 1) → Y.Opens)
    (hDU : ∀ J, D J ≤ U₀) (x : ∀ J K, Γ(Y, D K)) (hD : ∀ J, IsAffineOpen (D J))
    (hxJJ : ∀ J, x J J = 1) (hx : ∀ J K, D J ⊓ D K = Y.basicOpen (x J K))
    (hxc : ∀ J K K',
      (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x J K') =
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K from
          inf_le_left.trans inf_le_right)).op).hom (x J K) *
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x K K'))
    (hgen : ∀ K (f : Γ(Y, D K)), ∃ P : MvPolynomial (Fin (M + 1)) R,
      f = MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)
        (fun l => x l K) P)
    (G : Y.Modules) (hG : wcQcoh G) (hGf : ∀ K, Module.Finite Γ(Y, D K) Γ(G, D K)) :
    ∃ k₀ : ℕ, ∀ k ≥ k₀, wcpaSvTwV D (fun J K =>
      (Y.presheaf.map (homOfLE (show D J ⊓ D K ≤ D K from inf_le_right)).op).hom (x J K) ^ k) G :=
by
  classical

  obtain ⟨N₀, hN₀⟩ := wcpa_dj_scs_power_cocycle M D x hD hx hxc
  set r := max N₀ 1 with hrdef
  have hr : 1 ≤ r := le_max_right _ _
  have hNr : N₀ ≤ r := le_max_left _ _
  have hpowr : wcpaScPow D x r := hN₀ r hNr

  have hres : ∀ s : ℕ, ∃ W : ℕ, ∀ w ≥ W, wcpaSvTwV D (fun J K =>
      (Y.presheaf.map (homOfLE (show D J ⊓ D K ≤ D K from inf_le_right)).op).hom (x J K) ^
        (r * w + s)) G := by
    intro s
    obtain ⟨d₀, q, σ, htw, hgn⟩ := wcpa_dj_scs_twisted_generators R M U₀ φ₀ D hDU x hD hxJJ hx
      hxc hgen G hG hGf N₀ r hr hNr hN₀ s
    have hchg := wcpa_dj_scs_chart_change R M U₀ φ₀ D hDU x G r (r * d₀ + s) q σ hpowr htw
    have hsurj := wcpa_dj_scs_chart_surj R M U₀ φ₀ D hDU x hD hx G hG r q σ hr hgn
    have hsat := wcpa_dj_scs_saturate R M U₀ φ₀ D hDU x hD hxJJ hx G hG r (r * d₀ + s) q σ hr
      hchg
    obtain ⟨K, Θ1, Θ2, Θ3, hK, hmod⟩ := wcpa_dj_scs_laurent_model R M U₀ φ₀ D hDU x hxJJ hx G
      r d₀ s q σ hr hpowr hchg hsurj hsat
    obtain ⟨w₀, hw₀⟩ := wc_cn_laurent_serre_vanishing R (M + 1) q (fun _ => d₀) K hK 1 le_rfl
    refine ⟨w₀.toNat, fun w hw => ?_⟩
    have hwz : w₀ ≤ (w : ℤ) := le_trans (Int.self_le_toNat w₀) (by exact_mod_cast hw)
    obtain ⟨hE1, hE3, hT⟩ := wcpa_dj_scs_transpose M D x hxJJ hxc (r * w + s) G
    exact hT (wcpa_dj_scs_abstract_h1 D (wcpaScE D x (r * w + s)) hE1 hE3 G R q (fun _ => d₀) K ⊤
      Θ1 Θ2 Θ3 w (hmod w) (hw₀ (w : ℤ) hwz))
  choose W hW using hres
  refine ⟨r * (Finset.range r).sup W, fun k hk => ?_⟩
  have hr0 : 0 < r := hr
  have hs : k % r < r := Nat.mod_lt _ hr0
  have hK : (Finset.range r).sup W ≤ k / r := by
    rw [Nat.le_div_iff_mul_le hr0, mul_comm]
    exact hk
  have h := hW (k % r) (k / r) (le_trans (Finset.le_sup (Finset.mem_range.mpr hs)) hK)
  rwa [Nat.div_add_mod] at h

theorem wcpa_dj_lr1k_ll_gc_df_hs_lift : ∀ (K : Type u) [Field K] (T : Scheme.{u}) {N : ℕ}
    (φ : T ⟶ wcProjK K N), IsClosedImmersion φ →
    ∀ (e : ℕ) (I : (wcProjK K N).Modules) (ι : I ⟶ wcStructMod (wcProjK K N)),
    (∀ V : (wcProjK K N).Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) →
    (∀ V : (wcProjK K N).Opens, IsAffineOpen V → ∀ g : Γ(wcProjK K N, V),
