        ∃ E ∈ wcpaDjEbcExc W (γ ≫ ι') (r ≫ uX) r x, y ∈ E :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι hM x σ' a' hP hwex X' r ι' _ _ hbl hι' hM' V hV hiso y hy
  obtain ⟨w, hw, hSm⟩ := hwex
  have ptw : ∀ {A B D : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ D} {h : A ⟶ D}, f ≫ g = h →
