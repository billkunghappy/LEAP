  have hlin : ∀ a : {a : C ≅ C // a.hom ≫ γ = γ},
      (wcProjK Ω 1).presheaf.stalkSpecializes hgen ≫ γ.stalkMap (genericPoint C) ≫
        C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
          a.1.hom.stalkMap (genericPoint C) =
      (wcProjK Ω 1).presheaf.stalkSpecializes hgen ≫ γ.stalkMap (genericPoint C) := by
    intro a
    apply TopCat.Presheaf.stalk_hom_ext
    intro U hU
