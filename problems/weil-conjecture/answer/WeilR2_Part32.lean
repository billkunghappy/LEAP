  haveI hsm : SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) := hcov.2.1
  haveI hfin : IsFinite γ := hcov.2.2.2.1
  haveI : IsAffineHom ι :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip inferInstance
  have hU' : IsAffineOpen ((γ ≫ ι) ⁻¹ᵁ V) := hV.preimage (γ ≫ ι)
  haveI hne : Nonempty ((γ ≫ ι) ⁻¹ᵁ V) := ⟨⟨genericPoint C, hgen⟩⟩
  haveI : Smooth (γ ≫ wcProjKStr Ω 1) := SmoothOfRelativeDimension.smooth 1 (γ ≫ wcProjKStr Ω 1)
  have hnorm : ∀ c : C, IsIntegrallyClosed (C.presheaf.stalk c) := fun c =>
    (wc_fntame_smooth_stalk_normal Ω C (γ ≫ wcProjKStr Ω 1) c).2
  haveI hIC : IsIntegrallyClosed Γ(C, (γ ≫ ι) ⁻¹ᵁ V) :=
