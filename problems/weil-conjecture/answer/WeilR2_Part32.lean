  obtain ⟨lam, e, m, hlam, he, hm1, hm2, hrad⟩ :=
    radius (l.map (fun β => α - β)) γ μ h0δ hγ hμ hγμ
  have hprod : (l.map (fun β => r - σ β)).prod =
      ((l.map (fun β => α - β)).map (fun d => (r - σ α) + σ d)).prod := by
    rw [List.map_map]
    congr 1
    apply List.map_congr_left
    intro β _
    simp only [Function.comp_apply, map_sub]
    ring
  obtain ⟨vi, hvi⟩ : ∃ vi : Q, u * σ e * vi = 1 := (hu.mul (he.map σ)).exists_right_inv
