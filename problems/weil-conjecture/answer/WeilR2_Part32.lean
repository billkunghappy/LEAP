  intro Ω K B O _ _ _ _ _ W φ t σ b₀ β ℓ G P _ hTr hGen hFT hβ hβσ hβb hGℓ hLoc hMem hσP hb₀P
    hIso c
  classical
  obtain ⟨g, hgP, hg⟩ := hIso

  have s1 : ∀ k : K, (Polynomial.eval₂RingHom (φ.comp W.subtype) t).IsIntegralElem k →
      ∃ a : Polynomial ↥W, a.eval₂ (φ.comp W.subtype) t = k := by
    intro k hk
    set ε := Polynomial.eval₂RingHom (φ.comp W.subtype) t with hε
    letI : Algebra (Polynomial ↥W) K := ε.toAlgebra
    have hεa : ∀ a : Polynomial ↥W, ε a = (a.map W.subtype).eval₂ φ t := by
      intro a
      rw [hε, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map]
    have hinj : Function.Injective ε := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      rw [hεa] at ha
      have h0 := hTr _ ha
      exact Polynomial.map_injective W.subtype Subtype.val_injective
        (by rw [h0, Polynomial.map_zero])
    haveI : FaithfulSMul (Polynomial ↥W) K :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    have hnorm : ∀ P₀ : Polynomial Ω, ∃ n : Polynomial ↥W, ∃ b : ↥W, b ≠ 0 ∧
        ε n = φ b * P₀.eval₂ φ t := by
      intro P₀
      obtain ⟨b, hb, hn⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors ↥W) P₀
      refine ⟨IsLocalization.integerNormalization (nonZeroDivisors ↥W) P₀, b,
        nonZeroDivisors.ne_zero hb, ?_⟩
      rw [hεa]
      have h1 : (algebraMap ↥W Ω) = W.subtype := rfl
      rw [← h1, hn, Algebra.smul_def, Polynomial.algebraMap_apply, Polynomial.eval₂_mul,
        Polynomial.eval₂_C]
      rfl
    have hC : ∀ b : ↥W, ε (Polynomial.C b) = φ b := fun b => by
      rw [hε, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rfl
    have hφ : ∀ b : ↥W, b ≠ 0 → φ b ≠ 0 := fun b hb => by
      rw [map_ne_zero]
      exact fun h => hb (Subtype.ext h)
