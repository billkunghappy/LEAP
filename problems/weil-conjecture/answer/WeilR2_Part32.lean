  exact ⟨R, inferInstance, fR, ρ, ψ, T, hR, hρl, hρinj, hρC, hρψ.trans hκ'.symm, hTu, hρT⟩

theorem wcpa_dj_lr1k_ebc_dlc_point_kernel : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (fR : Polynomial ↥W →+* R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR → ∀ α ∈ IsLocalRing.maximalIdeal ↥W, ∃ k : R →+* ↥W, k.comp fR = Polynomial.eval₂RingHom (RingHom.id ↥W) α ∧ ∀ r : R, k r = 0 → ∃ r' : R, r = (fR Polynomial.X - fR (Polynomial.C α)) * r' :=
by
  intro Ω _ _ W R _ fR hfR α hα
  classical
  haveI hRh : HenselianLocalRing R := hfR.1
  haveI hWh : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W
  have hCp : ∀ t ∈ IsLocalRing.maximalIdeal ↥W, Polynomial.C t ∈
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W)) :=
    fun t ht => Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ht)
  have hXp : (Polynomial.X : Polynomial ↥W) ∈
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W)) :=
    Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _))
  have hevq : ∀ q : Polynomial ↥W,
      Polynomial.eval₂RingHom (RingHom.id ↥W) α q = Polynomial.eval α q := fun q => rfl
  have hcrit : ∀ q : Polynomial ↥W, IsUnit (Polynomial.eval₂RingHom (RingHom.id ↥W) α q) ↔
      q ∉ (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W)) := by
    intro q
    rw [← IsLocalRing.notMem_maximalIdeal, not_iff_not, hevq]
    constructor
    · intro hq
      obtain ⟨c, hc⟩ := Polynomial.sub_dvd_eval_sub α 0 q
      have h0 : q.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [Polynomial.coeff_zero_eq_eval_zero]
