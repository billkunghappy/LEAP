    rw [← hjs]
    infer_instance
  haveI hP₁ : IsProper (ν₁ ≫ s₁) := hprop ν₁ s₁ c₁ hχ₁
  haveI hP₂ : IsProper (ν₂ ≫ s₂) := hprop ν₂ s₂ c₂ hχ₂
  haveI : IsLocallyNoetherian Zt₁ := LocallyOfFiniteType.isLocallyNoetherian (ν₁ ≫ s₁)
  haveI : IsLocallyNoetherian Zt₂ := LocallyOfFiniteType.isLocallyNoetherian (ν₂ ≫ s₂)
  have hdom₁ : ∀ x : Zt₁, IsDomain (Zt₁.presheaf.stalk x) := fun x => (hN₁.2.1 x).1
  have hdom₂ : ∀ x : Zt₂, IsDomain (Zt₂.presheaf.stalk x) := fun x => (hN₂.2.1 x).1
  haveI : ∀ x : Zt₁, _root_.IsReduced (Zt₁.presheaf.stalk x) := fun x => by
    haveI := hdom₁ x; infer_instance
  haveI : ∀ x : Zt₂, _root_.IsReduced (Zt₂.presheaf.stalk x) := fun x => by
    haveI := hdom₂ x; infer_instance
  haveI : AlgebraicGeometry.IsReduced Zt₁ := isReduced_of_isReduced_stalk Zt₁
  haveI : AlgebraicGeometry.IsReduced Zt₂ := isReduced_of_isReduced_stalk Zt₂

  obtain ⟨W₁, W₂, hW₁d, hW₂S, hclS, ψ, hψiso, hψs⟩ := wcpa_dj_lr1k_ebcnt_open_core κ Z₁ Z₂ Zt₁ Zt₂
