    wcpa_dj_lr1u_fn_vertex_rt Ω W hW hWt X uX ι hst hXp hpb η hη huη hncη
  obtain ⟨c1, c2, c3, g, hmob, hRT⟩ := wcpa_dj_lr1u_vtd_gauss_coordinate Ω W V hCC ⟨s₀, hs₀⟩
  have hdom := wcpa_dj_lr1u_fn_dom Ω W hW hWt X uX ι hst hXp hpb η hη V c1 c2 c3 g huη hncη hV
    hCC hmob hRT x hx hux hcl
  have hGηV : ∀ t : X.presheaf.stalk η, (wcLr1uGerm ι η hη).hom t ∈ V := by
    intro t
    have : (wcLr1uGerm ι η hη).hom t ∈ (V : Set (wcProjK Ω 1).functionField) := by
      rw [hV]; exact ⟨t, rfl⟩
