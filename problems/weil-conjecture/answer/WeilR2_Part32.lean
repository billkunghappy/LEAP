    ((f' ≫ r).fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) Ψ hφ
    ((f' ≫ r).fromNormalization ⁻¹ᵁ V) hΨiso
  set G := Limits.pullback.map (f'.fromNormalization ≫ (r ≫ uX))
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    ((f' ≫ r).fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) Ψ (𝟙 _) (𝟙 _)
