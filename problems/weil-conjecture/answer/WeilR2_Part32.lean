    rfl
  refine ⟨𝔮, h𝔮, hcomap.trans hP, fun _ => ?_⟩
  exact wcpa_dj_llsmg_fibre_stalk Ω W ↑Γ(X, V) ↑C.functionField (algebraMap ↥W ↑Γ(X, V))
    (γ ≫ ι).normalization ((γ ≫ ι).fromNormalization ≫ uX) ((γ ≫ ι).fromNormalization ⁻¹ᵁ V)
    hle' e hcompat y₀ hz 𝔮 hloc hgerm

theorem wcpa_dj_llsmgds_cover_sections : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
