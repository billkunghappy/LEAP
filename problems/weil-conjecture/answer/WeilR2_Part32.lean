      have key2 : ∀ (g g' : C ⟶ f.normalization), g = g' → ∀ h h',
          g.appLE (f.fromNormalization ⁻¹ᵁ V) (f ⁻¹ᵁ V) h =
            g'.appLE (f.fromNormalization ⁻¹ᵁ V) (f ⁻¹ᵁ V) h' := by
        rintro _ _ rfl _ _; rfl
      have e3 : Ψ.appLE (f.fromNormalization ⁻¹ᵁ V) (f.fromNormalization ⁻¹ᵁ V) hle ≫
          f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ V) (f ⁻¹ᵁ V) hle1 =
          f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ V) (f ⁻¹ᵁ V) hle1 ≫
            a.appLE (f ⁻¹ᵁ V) (f ⁻¹ᵁ V) h3 := by
        rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
        exact key2 _ _ hΨ1 _ _
      have compat : ∀ s : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ V),
          ((e ((Ψ.appLE (f.fromNormalization ⁻¹ᵁ V) (f.fromNormalization ⁻¹ᵁ V) hle).hom s) :
            integralClosure ↑Γ(X, V) ↑C.functionField) : C.functionField) =
          wcpaDjGslTr a (genericPoint C) (genericPoint C) hη
            ((e s : integralClosure ↑Γ(X, V) ↑C.functionField) : C.functionField) := by
        intro s
        rw [he1, he1, s4 a _ _ hη (f ⁻¹ᵁ V) (f ⁻¹ᵁ V) h3 hgen hgen]
        exact congrArg (fun φ => (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom
          (φ.hom s)) e3
      have crit : ∀ s : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ V),
          z₀ ∈ f.normalization.basicOpen
            ((Ψ.appLE (f.fromNormalization ⁻¹ᵁ V) (f.fromNormalization ⁻¹ᵁ V) hle).hom s) ↔
          z₀ ∈ f.normalization.basicOpen s := by
        intro s
        rw [← not_iff_not, ← hY, ← hY, compat]
        exact (hYa _).symm
      have hΨz : Ψ z₀ ∈ f.fromNormalization ⁻¹ᵁ V := hle hz₀
      have hpt : ∀ s, s ∈ (hU.primeIdealOf ⟨Ψ z₀, hΨz⟩).asIdeal ↔
          s ∈ (hU.primeIdealOf ⟨z₀, hz₀⟩).asIdeal := by
        intro s
        rw [s2, s2, ← crit s, Scheme.basicOpen_appLE]
        simp only [TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage, hz₀, true_and]
      have hPeq : hU.primeIdealOf ⟨Ψ z₀, hΨz⟩ = hU.primeIdealOf ⟨z₀, hz₀⟩ :=
        PrimeSpectrum.ext (Ideal.ext hpt)
      have h4 := congrArg hU.fromSpec hPeq
      rw [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf] at h4
      exact h4

  have hνz : (γ ≫ ι).fromNormalization (wcNdPt W (γ ≫ ι) uX y₀) =
      wcpaDjLkImg W (γ ≫ ι) uX y₀ := by
    unfold wcNdPt wcpaDjLkImg wcpaDjLkPi
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
    simp only [Limits.pullback.map, Limits.pullback.lift_fst]
  obtain ⟨ys, hP, hc, hfix⟩ := gen (γ ≫ ι) (wcNdPt W (γ ≫ ι) uX y₀) V hV
    (by rw [hνz]; exact hx) 𝔭 (fun g => by rw [hνz]; exact h𝔭 g) hgen hκ hint
  refine ⟨ys, hP, hc, fun a hγ hη hYa => ?_⟩
  have haf : a.hom ≫ γ ≫ ι = γ ≫ ι := by rw [← Category.assoc, hγ]
  obtain ⟨g', h1, h2, h3⟩ := hfix a.hom haf hη hYa
  exact ⟨hγ, g', h1, h2, h3⟩

theorem wcpa_dj_llsmg_dec_solvable : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ [AlgebraicGeometry.IsIntegral C] (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤)
      (g : MvPolynomial (Fin 1) ↥W →+* ↑Γ(X, V)) (𝔭 : Ideal ↑Γ(X, V)),
    wcG2cChart W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) V hle g 𝔭 →
    ∀ (hgen : genericPoint C ∈ (γ ≫ ι) ⁻¹ᵁ V)
      (K : Type u) [Field K] [Algebra ↑Γ(X, V) K] [IsFractionRing ↑Γ(X, V) K]
      [Algebra K ↑C.functionField] [Algebra ↑Γ(X, V) ↑C.functionField]
      [IsScalarTower ↑Γ(X, V) K ↑C.functionField] [FiniteDimensional K ↑C.functionField]
      [IsGalois K ↑C.functionField],
      algebraMap ↑Γ(X, V) ↑C.functionField = wcG2cKap (γ ≫ ι) V hgen →
    wcpaDjLlSolvStab W γ ι uX y₀ →
    ∀ y : Ideal ↥(integralClosure ↑Γ(X, V) ↑C.functionField), y.IsPrime →
      y.comap (algebraMap ↑Γ(X, V) ↥(integralClosure ↑Γ(X, V) ↑C.functionField)) = 𝔭 →
      Group.IsSolvable ↥(wcLlsDec ↑Γ(X, V) K ↑C.functionField y) :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm _ V hle g 𝔭 hch hgen K _ _ _ _ _
    _ _ _ hκ hss y hy hyc
  classical
  obtain ⟨hV, hx, hdom, -, -, h𝔭, hPD, -⟩ := hch
  haveI := hdom
  haveI hIC : IsIntegrallyClosed ↑Γ(X, V) := hPD.2.2.1

  have hηhom : ∀ a : Aut C, a.hom (genericPoint C) = genericPoint C := fun a => by
    haveI : IsOpenImmersion a.hom := @IsOpenImmersion.of_isIso _ _ a.hom (Iso.isIso_hom a)
    exact genericPoint_eq_of_isOpenImmersion a.hom

  have hlift_inv : ∀ a : Aut C, wcpaDjLlFixes W γ ι uX y₀ a → wcpaDjLlFixes W γ ι uX y₀ a⁻¹ := by
    rintro a ⟨ha, fa, h1, h2, h3⟩
    have hih : a.inv ≫ a.hom = 𝟙 C := Iso.inv_hom_id (a : C ≅ C)
    have hhi : a.hom ≫ a.inv = 𝟙 C := Iso.hom_inv_id (a : C ≅ C)
    have hinvγ : a.inv ≫ γ = γ := by
      calc a.inv ≫ γ = a.inv ≫ a.hom ≫ γ := by rw [ha]
        _ = γ := by rw [← Category.assoc, hih, Category.id_comp]
    have H : γ ≫ ι = (a.inv ≫ (γ ≫ ι).toNormalization) ≫ (γ ≫ ι).fromNormalization := by
      rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, ← Category.assoc, hinvγ]
    obtain ⟨g'', e1, e2⟩ : ∃ g'' : (γ ≫ ι).normalization ⟶ (γ ≫ ι).normalization,
        (γ ≫ ι).toNormalization ≫ g'' = a.inv ≫ (γ ≫ ι).toNormalization ∧
        g'' ≫ (γ ≫ ι).fromNormalization = (γ ≫ ι).fromNormalization :=
      ⟨_, Scheme.Hom.toNormalization_normalizationDesc _ _ _ H,
        Scheme.Hom.normalizationDesc_comp _ _ _ H⟩
    have e3 : fa ≫ g'' = 𝟙 _ := by
      apply Scheme.Hom.normalization.hom_ext (γ ≫ ι) _ _ (γ ≫ ι).fromNormalization
      · rw [← Category.assoc, h1, Category.assoc, e1, ← Category.assoc, hhi,
          Category.id_comp, Category.comp_id]
      · rw [Category.assoc, e2, h2]
      · rw [Category.id_comp]
    refine ⟨hinvγ, g'', e1, e2, ?_⟩
    calc g'' (wcNdPt W (γ ≫ ι) uX y₀) = g'' (fa (wcNdPt W (γ ≫ ι) uX y₀)) := by rw [h3]
      _ = (fa ≫ g'') (wcNdPt W (γ ≫ ι) uX y₀) := (Scheme.Hom.comp_apply _ _ _).symm
      _ = wcNdPt W (γ ≫ ι) uX y₀ := by rw [e3]; rfl
  let H : Subgroup (Aut C) :=
    { carrier := {a | wcpaDjLlFixes W γ ι uX y₀ a}
      one_mem' := by
        refine ⟨Category.id_comp γ, 𝟙 _, ?_, Category.id_comp _, rfl⟩
        rw [Category.comp_id]
        exact (Category.id_comp _).symm
      mul_mem' := by
        rintro a b ⟨ha, fa, ha1, ha2, ha3⟩ ⟨hb, fb, hb1, hb2, hb3⟩
        refine ⟨?_, fb ≫ fa, ?_, ?_, ?_⟩
        · show (b.hom ≫ a.hom) ≫ γ = γ
          rw [Category.assoc, ha, hb]
        · show _ = (b.hom ≫ a.hom) ≫ _
          rw [← Category.assoc, hb1, Category.assoc, ha1, Category.assoc]
        · rw [Category.assoc, ha2, hb2]
        · rw [Scheme.Hom.comp_apply, hb3, ha3]
      inv_mem' := fun {a} h => hlift_inv a h }
  have hHmem : ∀ a, a ∈ H ↔ wcpaDjLlFixes W γ ι uX y₀ a := fun a => Iff.rfl
  haveI hHsolv : Group.IsSolvable H := hss H hHmem

  have hint := wcpa_dj_llsmgds_cover_sections Ω W C γ hcov X uX ι hM.2.2 V hV hgen hκ
  obtain ⟨hfix, D, Φ, hD, hΦ⟩ := wcpa_dj_llsmgds_deck_galois_hom Ω C γ X ι V hgen K hκ
  have hdesc := wcpa_dj_llsmgds_deck_fixed_in_base Ω W hW hWt C γ hcov hgal X uX ι hM V hV hdom
    hgen K hκ hint hfix
  obtain ⟨ys, hysP, hysc, hfixes⟩ :=
    wcpa_dj_llsmgds_point_prime Ω W C γ X uX ι y₀ V hV hx 𝔭 h𝔭 hgen hκ hint

  have hsurj : Function.Surjective Φ := by
    have hrange : Φ.range = ⊤ := by
      have hbot : IntermediateField.fixedField Φ.range = ⊥ := by
        rw [eq_bot_iff]
        intro ℓ hℓ
        rw [IntermediateField.mem_fixedField_iff] at hℓ
        rw [IntermediateField.mem_bot]
        obtain ⟨k, hk⟩ := hdesc ℓ (fun a ha hη => by
          let a' : Aut C := a
          have hih : a.inv ≫ a.hom = 𝟙 C := Iso.inv_hom_id a
          have hmem : a'⁻¹ ∈ D := (hD _).mpr (by
            show a.inv ≫ γ = γ
            calc a.inv ≫ γ = a.inv ≫ a.hom ≫ γ := by rw [ha]
              _ = γ := by rw [← Category.assoc, hih, Category.id_comp])
          have h1 := hℓ (Φ ⟨a'⁻¹, hmem⟩) ⟨_, rfl⟩
          rw [hΦ ⟨a'⁻¹, hmem⟩ hη ℓ] at h1
          exact h1)
        exact ⟨k, hk⟩
      rw [← IntermediateField.fixingSubgroup_fixedField Φ.range, hbot,
        IntermediateField.fixingSubgroup_bot]
    intro σ
    have : σ ∈ Φ.range := hrange ▸ Subgroup.mem_top σ
    exact MonoidHom.mem_range.mp this

  open Pointwise in
  have hle : wcLlsDec ↑Γ(X, V) K ↑C.functionField ys ≤ (H.subgroupOf D).map Φ := by
    intro σ hσ
    obtain ⟨a, rfl⟩ := hsurj σ
    refine ⟨a, ?_, rfl⟩
    show a ∈ H.subgroupOf D
    rw [Subgroup.mem_subgroupOf]
    have hinv : Φ a⁻¹ ∈ wcLlsDec ↑Γ(X, V) K ↑C.functionField ys := by
      rw [map_inv]; exact inv_mem hσ
    have hY := MulAction.mem_stabilizer_iff.mp hinv
    have htr : ∀ m, wcpaDjGslTr a.1.hom (genericPoint C) (genericPoint C) (hηhom a.1) m =
        Φ a⁻¹ m := fun m => (hΦ a⁻¹ (hηhom a.1) m).symm
    refine hfixes a.1 ((hD _).mp a.2) (hηhom a.1) (fun ℓ => ?_)
    rw [htr]
    constructor
    · intro hℓ
      have h2 := Set.smul_mem_smul_set (a := Φ a⁻¹) hℓ
      rw [hY, AlgEquiv.smul_def] at h2
      exact h2
    · intro hℓ
      have h2 : Φ a⁻¹ • ℓ ∈ Φ a⁻¹ • (Subtype.val ''
          (ys : Set ↥(integralClosure ↑Γ(X, V) ↑C.functionField))) := by
        rw [hY, AlgEquiv.smul_def]; exact hℓ
      exact Set.smul_mem_smul_set_iff.mp h2

  have hDs : Group.IsSolvable (wcLlsDec ↑Γ(X, V) K ↑C.functionField ys) := by
    let fH : ↥(H.subgroupOf D) →* ↥H :=
      { toFun := fun k => ⟨k.1.1, Subgroup.mem_subgroupOf.mp k.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    have hfH : Function.Injective fH := fun a b h => by
      have h' : (fH a : Aut C) = (fH b : Aut C) := congrArg Subtype.val h
      exact Subtype.ext (Subtype.ext h')
    haveI : Group.IsSolvable ↥(H.subgroupOf D) := Group.isSolvable_of_isSolvable_injective hfH
    haveI : Group.IsSolvable ↥((H.subgroupOf D).map Φ) :=
      Group.isSolvable_of_surjective (Φ.subgroupMap_surjective _)
    exact Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hle)

  haveI : IsFractionRing ↥(integralClosure ↑Γ(X, V) ↑C.functionField) ↑C.functionField :=
    IsIntegralClosure.isFractionRing_of_finite_extension ↑Γ(X, V) K ↑C.functionField
      ↥(integralClosure ↑Γ(X, V) ↑C.functionField)
  letI : MulSemiringAction (↑C.functionField ≃ₐ[K] ↑C.functionField)
      ↥(integralClosure ↑Γ(X, V) ↑C.functionField) :=
    IsIntegralClosure.MulSemiringAction ↑Γ(X, V) K ↑C.functionField
      ↥(integralClosure ↑Γ(X, V) ↑C.functionField)
  have hact : ∀ (τ : ↑C.functionField ≃ₐ[K] ↑C.functionField)
      (b : ↥(integralClosure ↑Γ(X, V) ↑C.functionField)),
      ((τ • b : ↥(integralClosure ↑Γ(X, V) ↑C.functionField)) : ↑C.functionField) =
        τ (b : ↑C.functionField) := fun τ b => algebraMap_galRestrict_apply ↑Γ(X, V) τ b
  haveI : SMulCommClass (↑C.functionField ≃ₐ[K] ↑C.functionField) ↑Γ(X, V)
      ↥(integralClosure ↑Γ(X, V) ↑C.functionField) := ⟨fun τ a b => by
    apply Subtype.ext
    rw [hact, Algebra.smul_def, Algebra.smul_def]
    change τ (algebraMap ↑Γ(X, V) ↑C.functionField a * (b : ↑C.functionField)) =
      algebraMap ↑Γ(X, V) ↑C.functionField a * ((τ • b : ↥(integralClosure ↑Γ(X, V)
        ↑C.functionField)) : ↑C.functionField)
    rw [hact, map_mul, IsScalarTower.algebraMap_apply ↑Γ(X, V) K ↑C.functionField a,
      AlgEquiv.commutes]⟩
  haveI : Algebra.IsInvariant ↑Γ(X, V) ↥(integralClosure ↑Γ(X, V) ↑C.functionField)
      (↑C.functionField ≃ₐ[K] ↑C.functionField) :=
    Algebra.isInvariant_of_isGalois ↑Γ(X, V) K ↑C.functionField _
  obtain ⟨σ, hσ⟩ := Algebra.IsInvariant.exists_smul_of_under_eq ↑Γ(X, V)
    ↥(integralClosure ↑Γ(X, V) ↑C.functionField) (↑C.functionField ≃ₐ[K] ↑C.functionField)
    ys y (by show ys.comap _ = y.comap _; rw [hysc, hyc])
  open Pointwise in
  have hYset : Subtype.val '' (y : Set ↥(integralClosure ↑Γ(X, V) ↑C.functionField)) =
      σ • (Subtype.val '' (ys : Set ↥(integralClosure ↑Γ(X, V) ↑C.functionField))) := by
    ext x
    constructor
    · rintro ⟨b, hb, rfl⟩
      have hb2 : b ∈ σ • ys := by rw [← hσ]; exact hb
      have hb' : σ⁻¹ • b ∈ ys := Ideal.mem_pointwise_smul_iff_inv_smul_mem.mp hb2
      refine Set.mem_smul_set.mpr ⟨((σ⁻¹ • b : ↥(integralClosure ↑Γ(X, V) ↑C.functionField)) :
        ↑C.functionField), ⟨_, hb', rfl⟩, ?_⟩
      rw [hact, AlgEquiv.smul_def, ← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    · intro hx'
      obtain ⟨_, ⟨c, hc, rfl⟩, rfl⟩ := Set.mem_smul_set.mp hx'
      refine ⟨σ • c, ?_, ?_⟩
      · rw [hσ]; exact Ideal.smul_mem_pointwise_smul σ c ys hc
      · rw [hact, AlgEquiv.smul_def]
  open Pointwise in
  have hDec : wcLlsDec ↑Γ(X, V) K ↑C.functionField y =
      (wcLlsDec ↑Γ(X, V) K ↑C.functionField ys).map (MulAut.conj σ).toMonoidHom := by
    show MulAction.stabilizer _ _ = _
    rw [hYset, MulAction.stabilizer_smul_eq_stabilizer_map_conj]
    rfl
  rw [hDec]
  exact Group.isSolvable_of_surjective ((MulAut.conj σ).toMonoidHom.subgroupMap_surjective _)

theorem wcpa_dj_llsm_global_to_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkBad ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y₀) →
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∃ (A : Type u) (_ : CommRing A) (_ : IsDomain A) (_ : Algebra ↥W A) (K : Type u)
      (_ : Field K) (_ : Algebra A K) (_ : IsFractionRing A K) (L : Type u) (_ : Field L)
      (_ : Algebra K L) (_ : Algebra A L) (_ : IsScalarTower A K L) (_ : FiniteDimensional K L)
      (_ : IsGalois K L) (𝔭 : Ideal A) (t : A) (τ : (Spec (.of ↥W) ⟶ X) → ↥W),
      wcLlsPD W A 𝔭 (.disc t) ∧
      wcpaDjLlDiscParam W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) τ ∧
      (∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W),
        wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a →
        (wcpaDjLlExh W γ uX ι (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ a ↔
          wcLlsDiscSep W A K L t (τ σ) a)) ∧
      (wcpaDjLlSolvStab W γ ι uX y₀ →
        ∃ y : Ideal ↥(integralClosure A L), wcLlsSolvPt W A K L 𝔭 (.disc t) y) :=
by
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm
  classical
  haveI hintC : AlgebraicGeometry.IsIntegral C := by
    haveI : IrreducibleSpace C := hcov.2.2.1
    haveI : SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) := hcov.2.1
    haveI : ∀ c : C, _root_.IsReduced (C.presheaf.stalk c) := fun c => by
      haveI := wcpa_smooth_stalk_isDomain Ω C (γ ≫ wcProjKStr Ω 1) 1 c
      infer_instance
    haveI : IsReduced C := isReduced_of_isReduced_stalk C
    exact isIntegral_of_irreducibleSpace_of_isReduced C
  obtain ⟨V, hle, g, 𝔭, hch⟩ :=
    wcpa_dj_llsmg_chart Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
  obtain ⟨hgen, hinj, hgal'⟩ :=
    wcpa_dj_llsmg_function_field_galois Ω W hW hWt C γ hcov hgal X uX ι hM y₀ hy₀ hSm
      V hle g 𝔭 hch
  haveI hdom : IsDomain ↑Γ(X, V) := hch.2.2.1
  letI iWA : Algebra ↥W ↑Γ(X, V) := (wcG2cPhi W uX V hle).toAlgebra
  letI iAL : Algebra ↑Γ(X, V) ↑C.functionField := (wcG2cKap (γ ≫ ι) V hgen).toAlgebra
  letI iKL : Algebra (FractionRing ↑Γ(X, V)) ↑C.functionField :=
    (IsFractionRing.lift (K := FractionRing ↑Γ(X, V)) hinj).toAlgebra
  haveI iST : IsScalarTower ↑Γ(X, V) (FractionRing ↑Γ(X, V)) ↑C.functionField :=
    IsScalarTower.of_algebraMap_eq (fun a => (IsFractionRing.lift_algebraMap hinj a).symm)
  obtain ⟨hfd, hgalois⟩ := hgal' (FractionRing ↑Γ(X, V)) rfl
  refine ⟨↑Γ(X, V), inferInstance, hdom, iWA, FractionRing ↑Γ(X, V), inferInstance,
    inferInstance, inferInstance, ↑C.functionField, inferInstance, iKL, iAL, iST, hfd, hgalois,
    𝔭, g (MvPolynomial.X 0), wcG2cTau W V (g (MvPolynomial.X 0)), hch.2.2.2.2.2.2.1,
    wcpa_dj_llsmg_disc_param Ω W hW hWt X uX ι hM _ V hle g 𝔭 hch, ?_, ?_⟩
  · intro σ a hP
    have hBadT : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
        wcpaDjLkBad R → wcpaDjLkBad S := by
      intro R S _ _ e hb
      obtain ⟨h1, h2⟩ := wcpa_dj_lr1k_llfi_ringequiv R S e
      unfold wcpaDjLkBad at hb ⊢
      rw [← h1, ← h2]
      exact hb
