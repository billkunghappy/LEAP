    have hjinj : Function.Injective j := by
      intro x y hxy
      apply Subtype.ext
      apply hGinj
      exact congrArg Subtype.val hxy
    have hjsurj : Function.Surjective j := by
      intro b
      obtain ⟨d₀, hd₀⟩ := hint b.1 b.2
      have hd : IsIntegral ↑Γ(X, V) d₀ := by
        rw [← isIntegral_algHom_iff G hGinj]
        show IsIntegral ↑Γ(X, V) ((C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom d₀)
        rw [hd₀]; exact b.2
      exact ⟨⟨d₀, hd⟩, Subtype.ext hd₀⟩
    let e₁ := (f.normalizationObjIso hV).commRingCatIsoToRingEquiv
    let e := e₁.trans (RingEquiv.ofBijective j ⟨hjinj, hjsurj⟩)
    have he1 : ∀ (s : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ V)),
        ((e s : integralClosure ↑Γ(X, V) ↑C.functionField) : C.functionField) =
          (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom
            ((f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ V) (f ⁻¹ᵁ V) hle1).hom s) := by
      intro s
      have h1 : ((e₁ s : integralClosure ↑Γ(X, V) ↑Γ(C, f ⁻¹ᵁ V)) : Γ(C, f ⁻¹ᵁ V)) =
          (f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ V) (f ⁻¹ᵁ V) hle1).hom s :=
        congrArg (fun φ => φ.hom s) (f.normalizationObjIso_hom_val hV)
      show (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom
        ((e₁ s : integralClosure ↑Γ(X, V) ↑Γ(C, f ⁻¹ᵁ V)) : Γ(C, f ⁻¹ᵁ V)) = _
      rw [h1]
    have key : ∀ (g g' : C ⟶ X), g = g' → ∀ h h',
        g.appLE V (f ⁻¹ᵁ V) h = g'.appLE V (f ⁻¹ᵁ V) h' := by
      rintro _ _ rfl _ _; rfl
    have hcomp : f.fromNormalization.app V ≫
        f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ V) (f ⁻¹ᵁ V) hle1 = f.app V := by
      rw [Scheme.Hom.app_eq_appLE f.fromNormalization, Scheme.Hom.appLE_comp_appLE,
        Scheme.Hom.app_eq_appLE f]
