      apply IsFractionRing.of_field
      intro z
      obtain ⟨P₀, Q₀, hQ, hz⟩ := hGen z
      obtain ⟨nP, bP, hbP, hP⟩ := hnorm P₀
      obtain ⟨nQ, bQ, hbQ, hQ'⟩ := hnorm Q₀
      refine ⟨Polynomial.C bQ * nP, Polynomial.C bP * nQ, ?_⟩
      show z = ε (Polynomial.C bQ * nP) / ε (Polynomial.C bP * nQ)
      rw [map_mul, map_mul, hC, hC, hP, hQ', eq_div_iff
        (mul_ne_zero (hφ _ hbP) (mul_ne_zero (hφ _ hbQ) hQ)), ← hz]
      ring
    have hk' : _root_.IsIntegral (Polynomial ↥W) k := hk
