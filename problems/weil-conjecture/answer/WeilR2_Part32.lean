        rw [Nat.cast_add, h1, hadd, Nat.cast_sum, ← Finset.sum_add_distrib,
          Finset.sum_congr rfl (fun i _ => hDf i e (le_trans (hE3 i) he)), ← Nat.cast_sum]
        congr 1
        rw [Finset.sum_add_distrib, Finset.sum_mul, Finset.sum_const, Finset.card_univ,
          Fintype.card_fin, smul_eq_mul, mul_one]
      exact_mod_cast hc
    have a1 := star E₀ le_rfl
    have a2 := star (E₀ + 1) (Nat.le_succ _)
    have b1 := hH E₀ hE1
    have b2 := hH (E₀ + 1) (le_trans hE1 (Nat.le_succ _))
    have a1' : (wcGcHilb ψ E₀ : ℤ) + ((∑ i, g i : ℕ) : ℤ) =
        ((∑ i, D i : ℕ) : ℤ) * (E₀ : ℤ) + (m : ℤ) := by exact_mod_cast a1
    have a2' : (wcGcHilb ψ (E₀ + 1) : ℤ) + ((∑ i, g i : ℕ) : ℤ) =
        ((∑ i, D i : ℕ) : ℤ) * ((E₀ : ℤ) + 1) + (m : ℤ) := by
      have := a2
      push_cast at this ⊢
      exact_mod_cast this
    have b2' : (wcGcHilb ψ (E₀ + 1) : ℤ) = (d : ℤ) * ((E₀ : ℤ) + 1) + c := by
      rw [b2]; push_cast; ring
    have hdS : (d : ℤ) = ((∑ i, D i : ℕ) : ℤ) := by linarith
    linear_combination (a1' - b1) - (E₀ : ℤ) * hdS
  have k1 := key N₁ ψ₁ hψ₁ hψ₁s d₁ e₁ c₁ hH₁
  have k2 := key N₂ ψ₂ hψ₂ hψ₂s d₂ e₂ c₂ hH₂
  rw [k1, k2]

theorem wcpa_dj_lr1k_ebcc_rc_not_closed : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (Y : Scheme.{u}) (p : Y ⟶ Spec (.of κ)) [LocallyOfFiniteType p] (y : ↥Y), (∃ e : ↥(Y.presheaf.stalk y) ≃+* RatFunc κ, e.toRingHom.comp (wcNdSig p y) = algebraMap κ (RatFunc κ)) → ¬ IsClosed ({y} : Set ↥Y) :=
by
  intro κ _ _ Y p _ y ⟨e, he⟩ hy

  have hsurj : Function.Surjective ((Y.evaluation ⊤ y trivial).hom.comp
      (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom)) := by
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    set g := Y.fromSpecResidueField y ≫ p with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (Y.fromSpecResidueField y).appTop ≫ (Scheme.ΓSpecIso (Y.residueField y)).hom =
        Y.evaluation ⊤ y trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of κ)).inv ≫ p.appTop ≫
        Y.evaluation ⊤ y trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hφ : (Y.evaluation ⊤ y trivial).hom.comp
        (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom) =
        (Spec.preimage g).hom := by
      rw [heq]; rfl
    rw [hφ]
    letI : Algebra κ (Y.residueField y) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType κ (Y.residueField y) := hft
    haveI : Module.Finite κ (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing κ _
    intro s
    have hs : IsIntegral κ s := Algebra.IsIntegral.isIntegral s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible κ (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one κ s hdeg
    exact ⟨c, hc⟩

  have hs2 : ∀ c : κ, (Y.residue y).hom (wcNdSig p y c) =
      (Y.evaluation ⊤ y trivial).hom
        ((p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom) c) := by
    intro c
    have hid : (Y.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op) = 𝟙 _ := by
      have : homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤) = 𝟙 _ := Subsingleton.elim _ _
      rw [this, op_id, CategoryTheory.Functor.map_id]
    have h1 : wcNdSig p y c = (Y.presheaf.germ ⊤ y trivial).hom
        ((p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of κ)).inv.hom) c) := by
      simp only [wcNdSig, wcCnSigma, RingHom.comp_apply, hid]
      rfl
    rw [h1, ← CommRingCat.comp_apply]
    erw [Scheme.germ_residue]

  set z := e.symm RatFunc.X with hz
  obtain ⟨c, hc⟩ := hsurj ((Y.residue y).hom z)
  rw [RingHom.comp_apply] at hc
  have hres : (Y.residue y).hom (z - wcNdSig p y c) = 0 := by
    rw [map_sub, hs2]
    exact sub_eq_zero.mpr hc.symm

  have hec : e (wcNdSig p y c) = algebraMap κ (RatFunc κ) c := RingHom.congr_fun he c
  have hew : e (z - wcNdSig p y c) =
      algebraMap (Polynomial κ) (RatFunc κ) (Polynomial.X - Polynomial.C c) := by
    rw [map_sub, hec, hz, RingEquiv.apply_symm_apply, map_sub, RatFunc.algebraMap_X,
      RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
  have hne : e (z - wcNdSig p y c) ≠ 0 := by
    rw [hew]
    exact (map_ne_zero_iff _ (RatFunc.algebraMap_injective κ)).mpr (Polynomial.X_sub_C_ne_zero c)

  have hu : IsUnit (z - wcNdSig p y c) := by
    have := (Ne.isUnit hne).map e.symm
    rwa [RingEquiv.symm_apply_apply] at this
  have hu2 := hu.map (Y.residue y).hom
  rw [hres] at hu2
  exact not_isUnit_zero hu2

theorem wcpa_dj_lr1k_ebcc_rc_component_curve : ∀ (κ : Type u) [Field κ] (Z : Scheme.{u}) (s : Z ⟶ Spec (.of κ)), (∀ z : Z, IsDomain (Z.presheaf.stalk z) ∧ IsIntegrallyClosed (Z.presheaf.stalk z)) → topologicalKrullDim ↥Z ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (a : ↥Z) (D : Z.Opens), (D : Set ↥Z) = closure {a} → ¬ IsClosed ({a} : Set ↥Z) → (∃ e : ↥(Z.presheaf.stalk a) ≃+* RatFunc κ, e.toRingHom.comp (wcNdSig s a) = algebraMap κ (RatFunc κ)) → IrreducibleSpace ↥D.toScheme ∧ (∀ z : ↥D.toScheme, IsDomain (D.toScheme.presheaf.stalk z) ∧ IsIntegrallyClosed (D.toScheme.presheaf.stalk z)) ∧ topologicalKrullDim ↥D.toScheme = ((1 : ℕ) : WithBot ℕ∞) ∧ ∃ a' : ↥D.toScheme, D.ι a' = a ∧ closure ({a'} : Set ↥D.toScheme) = Set.univ ∧ ∃ e : ↥(D.toScheme.presheaf.stalk a') ≃+* RatFunc κ, e.toRingHom.comp (wcNdSig (D.ι ≫ s) a') = algebraMap κ (RatFunc κ) :=
by
  intro κ _ Z s hstalk hdim a D hD hna hrat
  classical
  have hemb : Topology.IsEmbedding (⇑D.ι) := D.ι.isOpenEmbedding.isEmbedding
  have hind := hemb.isInducing
  have hrange : Set.range (⇑D.ι) = closure ({a} : Set ↥Z) := (Scheme.Opens.range_ι D).trans hD
  obtain ⟨a', ha'⟩ : ∃ a' : ↥D.toScheme, D.ι a' = a := by
    have h : a ∈ Set.range (⇑D.ι) := by
      rw [hrange]; exact subset_closure (Set.mem_singleton a)
    exact h
  have hcl : closure ({a'} : Set ↥D.toScheme) = Set.univ := by
    rw [hind.closure_eq_preimage_closure_image, Set.image_singleton, ha', ← hrange,
      Set.preimage_range]
  have hirr : IrreducibleSpace ↥D.toScheme := by
    rw [irreducibleSpace_def, Set.top_eq_univ, ← hcl]
    exact isIrreducible_singleton.closure
  have hle : topologicalKrullDim ↥D.toScheme ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    (hind.topologicalKrullDim_le).trans hdim
  obtain ⟨b, hb, hba⟩ : ∃ b ∈ closure ({a} : Set ↥Z), b ≠ a := by
    by_contra h
    push_neg at h
    apply hna
    have h' : closure ({a} : Set ↥Z) ⊆ {a} := fun b hb => h b hb
    exact closure_subset_iff_isClosed.mp h'
  obtain ⟨b', hb'⟩ : ∃ b' : ↥D.toScheme, D.ι b' = b := by
    have h : b ∈ Set.range (⇑D.ι) := by rw [hrange]; exact hb
    exact h
  have hge : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥D.toScheme := by
    let C₁ : TopologicalSpace.IrreducibleCloseds ↥D.toScheme :=
      ⟨closure {b'}, isIrreducible_singleton.closure, isClosed_closure⟩
    let C₂ : TopologicalSpace.IrreducibleCloseds ↥D.toScheme :=
      ⟨closure {a'}, isIrreducible_singleton.closure, isClosed_closure⟩
    have h12 : C₁ < C₂ := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure ({b'} : Set ↥D.toScheme) ⊆ closure {a'}
        rw [hcl]; exact Set.subset_univ _
      · intro h
        have h' : closure ({b'} : Set ↥D.toScheme) = closure {a'} :=
          congrArg TopologicalSpace.IrreducibleCloseds.carrier h
        have hins : Inseparable b' a' := inseparable_iff_closure_eq.mpr h'
        have h2 := (hins.map D.ι.continuous).eq
        rw [hb', ha'] at h2
        exact hba h2
    rw [Nat.cast_one]
    show (1 : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥D.toScheme)
    exact Order.one_le_krullDim_iff.mpr ⟨C₁, C₂, h12⟩
  have hstD : ∀ z : ↥D.toScheme, IsDomain (D.toScheme.presheaf.stalk z) ∧
      IsIntegrallyClosed (D.toScheme.presheaf.stalk z) := by
    intro z
    obtain ⟨hD1, hD2⟩ := hstalk (D.ι z)
    haveI := hD1
    haveI := hD2
    let ρ := Iso.commRingCatIsoToRingEquiv (asIso (D.ι.stalkMap z))
    exact ⟨MulEquiv.isDomain _ ρ.symm.toMulEquiv, IsIntegrallyClosed.of_equiv ρ⟩
  have hcompat : ∀ {B : Type u} [CommRing B] {Y Z : Scheme.{u}} (g : Y ⟶ Z)
      (s : Z ⟶ Spec (.of B)) (y : ↥Y),
      wcNdSig (g ≫ s) y = (g.stalkMap y).hom.comp (wcNdSig s (g y)) := by
    intro B _ Y Z g s y
    have key : (Scheme.ΓSpecIso (.of B)).inv ≫ (g ≫ s).appTop ≫
        Y.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op ≫ Y.presheaf.germ ⊤ y trivial =
        (Scheme.ΓSpecIso (.of B)).inv ≫ s.appTop ≫
          Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op ≫
            Z.presheaf.germ ⊤ (g y) trivial ≫ g.stalkMap y := by
      have hY : (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
      have hZ : (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
      rw [hY, hZ, op_id, op_id, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id,
        Category.id_comp, Category.id_comp, Scheme.Hom.germ_stalkMap g ⊤ y trivial,
        Scheme.Hom.comp_appTop, Category.assoc]
      rfl
    ext b
    exact congrArg (fun f => CommRingCat.Hom.hom f b) key
  subst ha'
  obtain ⟨e, he⟩ := hrat
  let ρ := Iso.commRingCatIsoToRingEquiv (asIso (D.ι.stalkMap a'))
  refine ⟨hirr, hstD, le_antisymm hle hge, a', rfl, hcl, ρ.symm.trans e, ?_⟩
  rw [hcompat D.ι s a']
  refine RingHom.ext fun c => ?_
  have h5 := congrArg (fun f => f c) he
  have h6 : ∀ z, ρ.symm ((D.ι.stalkMap a').hom z) = z := fun z => ρ.symm_apply_apply z
  show e (ρ.symm ((D.ι.stalkMap a').hom (wcNdSig s (D.ι a') c))) = _
  rw [h6]
  exact h5

theorem wcpa_dj_lr1k_ebcc_rc_fn_field_iso : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) [IsIntegral X] (fX : X ⟶ Spec (.of Ω)) (U : X.Opens) [IsDedekindDomain Γ(X, U)], IsAffineOpen U → (∃ e : ↥(X.presheaf.stalk (genericPoint X)) ≃+* RatFunc Ω, e.toRingHom.comp (wcNdSig fX (genericPoint X)) = algebraMap Ω (RatFunc Ω)) → ∃ θ : RatFunc Ω ≃+* FractionRing Γ(X, U), θ.toRingHom.comp (algebraMap Ω (RatFunc Ω)) = wcCurveConst Ω X fX U :=
by
  intro Ω _ X _ fX U _ hU ⟨e, he⟩
  obtain ⟨p⟩ := (inferInstance : Nonempty (Spec Γ(X, U)))
  haveI : Nonempty U := ⟨hU.isoSpec.inv p⟩
  letI := functionField_isFractionRing_of_isAffineOpen X U hU
  refine ⟨e.symm.trans (IsLocalization.algEquiv (nonZeroDivisors Γ(X, U)) X.functionField
    (FractionRing Γ(X, U))).toRingEquiv, ?_⟩
  refine RingHom.ext fun c => ?_
  have h1 : e.symm (algebraMap Ω (RatFunc Ω) c) = wcNdSig fX (genericPoint X) c := by
    rw [← RingHom.congr_fun he c]
    exact e.symm_apply_apply _
  have h2 : wcNdSig fX (genericPoint X) c = algebraMap Γ(X, U) X.functionField
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) := by
    show (X.presheaf.germ ⊤ (genericPoint X) (show genericPoint X ∈ (⊤ : X.Opens) from trivial)).hom
        ((X.presheaf.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op).hom
          (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
      (X.germToFunctionField U).hom ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
          (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)))
    rw [Scheme.germToFunctionField, TopCat.Presheaf.germ_res_apply]
    exact (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top : U ≤ ⊤))
      (genericPoint X) _ _).symm
  show (IsLocalization.algEquiv (nonZeroDivisors Γ(X, U)) X.functionField
    (FractionRing Γ(X, U))) (e.symm (algebraMap Ω (RatFunc Ω) c)) = _
  rw [h1, h2, AlgEquiv.commutes]
  rfl

theorem wcpa_dj_lr1k_ebcc_rc_poles_rr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) [IrreducibleSpace X] (fX : X ⟶ Spec (.of Ω)) (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U) (ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ), wcCurveOrdData Ω X fX U hU ω → ∀ θ : RatFunc Ω ≃+* FractionRing Γ(X, U), θ.toRingHom.comp (algebraMap Ω (RatFunc Ω)) = wcCurveConst Ω X fX U → ∃ Dinf : X →₀ ℤ, Dinf (genericPoint X) = 0 ∧ 1 ≤ Dinf.sum (fun _ k => k) ∧ ∀ n : ℕ, (∀ k : ℕ, k ≤ n → θ (RatFunc.X ^ k) ∈ wcRRSpace Ω X fX U ω ((n : ℤ) • Dinf)) ∧ ∀ u ∈ wcRRSpace Ω X fX U ω ((n : ℤ) • Dinf), ∃ p : Polynomial Ω, p.natDegree ≤ n ∧ θ (algebraMap (Polynomial Ω) (RatFunc Ω) p) = u :=
by
  intro Ω _ _ X _ fX U _ hU ω hω θ hθ
  classical
  set c := wcCurveConst Ω X fX U with hc_def
  set x := θ RatFunc.X with hx_def

  have E1 : ∀ p : Polynomial Ω,
      θ (algebraMap (Polynomial Ω) (RatFunc Ω) p) = p.eval₂ c x := by
    have h : θ.toRingHom.comp (algebraMap (Polynomial Ω) (RatFunc Ω)) =
        Polynomial.eval₂RingHom c x := by
      apply Polynomial.ringHom_ext
      · intro a
        show θ (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C a)) =
          Polynomial.eval₂ c x (Polynomial.C a)
        rw [Polynomial.eval₂_C, Polynomial.C_eq_algebraMap,
          ← IsScalarTower.algebraMap_apply, ← hθ]
        rfl
      · show θ (algebraMap (Polynomial Ω) (RatFunc Ω) Polynomial.X) =
          Polynomial.eval₂ c x Polynomial.X
        rw [RatFunc.algebraMap_X, Polynomial.eval₂_X]
    intro p
    exact RingHom.congr_fun h p
  have E2 : ∀ p : Polynomial Ω, p ≠ 0 → p.eval₂ c x ≠ 0 := by
    intro p hp
    rw [← E1]
    exact (map_ne_zero θ).mpr (RatFunc.algebraMap_ne_zero hp)
  have E3 : ∀ r : Ω, x ≠ c r := by
    intro r h
    have := E2 (Polynomial.X - Polynomial.C r) (Polynomial.X_sub_C_ne_zero r)
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C, h, sub_self] at this
    exact this rfl
  have hx0 : x ≠ 0 := by
    have := E2 Polynomial.X Polynomial.X_ne_zero
    rwa [Polynomial.eval₂_X] at this

  have abs_val : ∀ w : FractionRing Γ(X, U) → ℤ,
      (∀ f g : FractionRing Γ(X, U), f ≠ 0 → g ≠ 0 → w (f * g) = w f + w g) →
      (∀ f g : FractionRing Γ(X, U), f ≠ 0 → g ≠ 0 → f + g ≠ 0 → min (w f) (w g) ≤ w (f + g)) →
      (∀ r : Ω, c r ≠ 0 → w (c r) = 0) →
      (w x < 0 → ∀ p : Polynomial Ω, p ≠ 0 → w (p.eval₂ c x) = (p.natDegree : ℤ) * w x) ∧
      (0 ≤ w x → ∀ p : Polynomial Ω, p ≠ 0 → 0 ≤ w (p.eval₂ c x)) ∧
      (∀ r : Ω, x - c r ≠ 0 → 0 < w (x - c r) →
        0 ≤ w x ∧ ∀ p : Polynomial Ω, p.eval r ≠ 0 → w (p.eval₂ c x) = 0) := by
    intro w wmul wult wc
    have htr := E2
    have w1 : w 1 = 0 := by
      have := wmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at this
      omega
    have wneg1 : w (-1) = 0 := by
      have := wmul (-1) (-1) (neg_ne_zero.mpr one_ne_zero) (neg_ne_zero.mpr one_ne_zero)
      rw [neg_one_mul, neg_neg, w1] at this
      omega
    have wneg : ∀ f : FractionRing Γ(X, U), f ≠ 0 → w (-f) = w f := by
      intro f hf
      have := wmul (-1) f (neg_ne_zero.mpr one_ne_zero) hf
      rw [neg_one_mul, wneg1, zero_add] at this
      exact this
    have wstrict : ∀ f g : FractionRing Γ(X, U), f ≠ 0 → g ≠ 0 → f + g ≠ 0 → w f < w g →
        w (f + g) = w f := by
      intro f g hf hg hfg hlt
      have h1 := wult f g hf hg hfg
      have h2 := wult (f + g) (-g) hfg (neg_ne_zero.mpr hg)
        (by rw [add_neg_cancel_right]; exact hf)
      rw [add_neg_cancel_right, wneg g hg] at h2
      rw [min_eq_left hlt.le] at h1
      rcases min_le_iff.mp h2 with h | h
      · omega
      · omega
    have wpow : ∀ n : ℕ, w (x ^ n) = (n : ℤ) * w x := by
      intro n
      induction n with
      | zero => simp [w1]
      | succ n ih =>
        rw [pow_succ, wmul _ _ (pow_ne_zero n hx0) hx0, ih]
        push_cast; ring
    have Pnn : 0 ≤ w x → ∀ p : Polynomial Ω, p.eval₂ c x = 0 ∨ 0 ≤ w (p.eval₂ c x) := by
      intro hx p
      induction p using Polynomial.induction_on with
      | C a =>
        rw [Polynomial.eval₂_C]
        by_cases h : c a = 0
        · exact Or.inl h
        · exact Or.inr (wc a h).ge
      | add p q hp hq =>
        rw [Polynomial.eval₂_add]
        by_cases hp0 : p.eval₂ c x = 0
        · rw [hp0, zero_add]; exact hq
        by_cases hq0 : q.eval₂ c x = 0
        · rw [hq0, add_zero]; exact hp
        by_cases hs : p.eval₂ c x + q.eval₂ c x = 0
        · exact Or.inl hs
        right
        have e1 := hp.resolve_left hp0
        have e2 := hq.resolve_left hq0
        have := wult _ _ hp0 hq0 hs
        rcases min_le_iff.mp this with h | h <;> omega
      | monomial n a ih =>
        rw [pow_succ, ← mul_assoc, Polynomial.eval₂_mul_X]
        by_cases h0 : Polynomial.eval₂ c x (Polynomial.C a * Polynomial.X ^ n) = 0
        · rw [h0, zero_mul]; exact Or.inl rfl
        right
        have e1 := ih.resolve_left h0
        rw [wmul _ _ h0 hx0]
        omega
    have Ppole : w x < 0 → ∀ p : Polynomial Ω, p ≠ 0 →
        w (p.eval₂ c x) = (p.natDegree : ℤ) * w x := by
      intro hx
      have key : ∀ n : ℕ, ∀ p : Polynomial Ω, p.natDegree ≤ n → p ≠ 0 →
          w (p.eval₂ c x) = (p.natDegree : ℤ) * w x := by
        intro n
        induction n with
        | zero =>
          intro p hpn hp
          have hn0 : p.natDegree = 0 := by omega
          have hpC := Polynomial.eq_C_of_natDegree_eq_zero hn0
          have hc0 : p.coeff 0 ≠ 0 := by
            intro h
            apply hp
            rw [hpC, h, map_zero]
          rw [hn0, Nat.cast_zero, zero_mul, hpC, Polynomial.eval₂_C]
          exact wc _ ((map_ne_zero c).mpr hc0)
        | succ n ih =>
          intro p hpn hp
          have hl : p.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp
          have hcl : c p.leadingCoeff ≠ 0 := (map_ne_zero c).mpr hl
          have hdec := Polynomial.eraseLead_add_C_mul_X_pow p
          have ht0 : c p.leadingCoeff * x ^ p.natDegree ≠ 0 :=
            mul_ne_zero hcl (pow_ne_zero _ hx0)
          have hwt : w (c p.leadingCoeff * x ^ p.natDegree) = (p.natDegree : ℤ) * w x := by
            rw [wmul _ _ hcl (pow_ne_zero _ hx0), wc _ hcl, wpow, zero_add]
          have hev : p.eval₂ c x =
              p.eraseLead.eval₂ c x + c p.leadingCoeff * x ^ p.natDegree := by
            conv_lhs => rw [← hdec]
            rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
              Polynomial.eval₂_X_pow]
          by_cases hq : p.eraseLead = 0
          · rw [hev, hq, Polynomial.eval₂_zero, zero_add, hwt]
          · have hlt : p.eraseLead.natDegree < p.natDegree := by
              rcases Polynomial.eraseLead_natDegree_lt_or_eraseLead_eq_zero p with h | h
              · exact h
              · exact absurd h hq
            have hq' := ih p.eraseLead (by omega) hq
            have hq0 : p.eraseLead.eval₂ c x ≠ 0 := htr _ hq
            have hp0 : p.eval₂ c x ≠ 0 := htr _ hp
            have hlt' : (p.eraseLead.natDegree : ℤ) < p.natDegree := by exact_mod_cast hlt
            rw [hev, add_comm] at hp0 ⊢
            rw [wstrict _ _ ht0 hq0 hp0 (by rw [hwt, hq']; nlinarith), hwt]
      intro p hp
      exact key p.natDegree p le_rfl hp
    have Pz : ∀ r : Ω, x - c r ≠ 0 → 0 < w (x - c r) →
        0 ≤ w x ∧ ∀ p : Polynomial Ω, p.eval r ≠ 0 → w (p.eval₂ c x) = 0 := by
      intro r hz hwz
      have hxint : 0 ≤ w x := by
        by_cases hr : c r = 0
        · rw [hr, sub_zero] at hwz; exact hwz.le
        · have := wstrict (c r) (x - c r) hr hz (by rw [add_sub_cancel]; exact hx0)
            (by rw [wc r hr]; exact hwz)
          rw [add_sub_cancel, wc r hr] at this
          rw [this]
      refine ⟨hxint, fun p hpr => ?_⟩
      have hp : p ≠ 0 := by rintro rfl; simp at hpr
      have hcr : c (p.eval r) ≠ 0 := (map_ne_zero c).mpr hpr
      have hdec : p.eval₂ c x = c (p.eval r) +
          (x - c r) * (p /ₘ (Polynomial.X - Polynomial.C r)).eval₂ c x := by
        have h : p %ₘ (Polynomial.X - Polynomial.C r) +
            (Polynomial.X - Polynomial.C r) * (p /ₘ (Polynomial.X - Polynomial.C r)) = p := by
          exact Polynomial.modByMonic_add_div p (Polynomial.X - Polynomial.C r)
        rw [Polynomial.modByMonic_X_sub_C_eq_C_eval] at h
        conv_lhs => rw [← h]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_sub,
          Polynomial.eval₂_X, Polynomial.eval₂_C]
      by_cases hq0 : (p /ₘ (Polynomial.X - Polynomial.C r)).eval₂ c x = 0
      · rw [hdec, hq0, mul_zero, add_zero, wc _ hcr]
      have hqn := (Pnn hxint (p /ₘ (Polynomial.X - Polynomial.C r))).resolve_left hq0
      have hm0 : (x - c r) * (p /ₘ (Polynomial.X - Polynomial.C r)).eval₂ c x ≠ 0 :=
        mul_ne_zero hz hq0
      have hp0 : p.eval₂ c x ≠ 0 := htr p hp
      rw [hdec] at hp0 ⊢
      rw [wstrict _ _ hcr hm0 hp0 (by rw [wc _ hcr, wmul _ _ hz hq0]; omega), wc _ hcr]
    exact ⟨Ppole, fun hx p hp => (Pnn hx p).resolve_left (htr p hp), Pz⟩

  obtain ⟨w, hw⟩ : ∃ w : X → FractionRing Γ(X, U) → ℤ, ∀ (y : X) (f : FractionRing Γ(X, U))
      (hf : f ≠ 0), ω y (Additive.ofMul (Units.mk0 f hf)) = w y f :=
    ⟨fun y f => if hf : f ≠ 0 then ω y (Additive.ofMul (Units.mk0 f hf)) else 0,
      fun y f hf => by dsimp only; rw [dif_pos hf]⟩
  have wmul : ∀ (y : X) (f g : FractionRing Γ(X, U)), f ≠ 0 → g ≠ 0 →
      w y (f * g) = w y f + w y g := by
    intro y f g hf hg
    rw [← hw y f hf, ← hw y g hg, ← hw y _ (mul_ne_zero hf hg)]
    rw [show Units.mk0 (f * g) (mul_ne_zero hf hg) = Units.mk0 f hf * Units.mk0 g hg from
      Units.ext (by simp), ofMul_mul, map_add]
  have wult : ∀ (y : X) (f g : FractionRing Γ(X, U)), f ≠ 0 → g ≠ 0 → f + g ≠ 0 →
      min (w y f) (w y g) ≤ w y (f + g) := by
    intro y f g hf hg hfg
    rw [← hw y f hf, ← hw y g hg, ← hw y _ hfg]
    exact hω.2.2.2.2.1 y _ _ _ (by simp)
  have wc : ∀ (y : X) (r : Ω), c r ≠ 0 → w y (c r) = 0 := by
    intro y r hr
    rw [← hw y _ hr]
    have h1 : ∀ z, 0 ≤ ω z (Additive.ofMul (Units.mk0 (c r) hr)) := by
      refine (hω.2.2.2.2.2 _).2 ⟨r, ?_⟩
      rfl
    have h2 : ∀ z, 0 ≤ ω z (Additive.ofMul (Units.mk0 (c r) hr)⁻¹) := by
      refine (hω.2.2.2.2.2 _).2 ⟨r⁻¹, ?_⟩
      rw [Units.val_inv_eq_inv_val]
      change c r⁻¹ = (c r)⁻¹
      exact map_inv₀ _ r
    have h3 : ω y (Additive.ofMul (Units.mk0 (c r) hr)) +
        ω y (Additive.ofMul (Units.mk0 (c r) hr)⁻¹) = 0 := by
      rw [← map_add, ← ofMul_mul, mul_inv_cancel, ofMul_one, map_zero]
    have e1 := h1 y
    have e2 := h2 y
    omega
  have K2 : ∀ g : FractionRing Γ(X, U), g ≠ 0 → (∀ y, 0 ≤ w y g) → ∃ r : Ω, c r = g := by
    intro g hg h
    obtain ⟨r, hr⟩ := (hω.2.2.2.2.2 (Units.mk0 g hg)).1 (fun y => by rw [hw]; exact h y)
    exact ⟨r, hr.trans (Units.val_mk0 hg)⟩
  have w1 : ∀ y, w y 1 = 0 := by
    intro y
    have := wmul y 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at this
    omega
  have winv : ∀ (y : X) (f : FractionRing Γ(X, U)), f ≠ 0 → w y f⁻¹ = - w y f := by
    intro y f hf
    have := wmul y f f⁻¹ hf (inv_ne_zero hf)
    rw [mul_inv_cancel₀ hf, w1] at this
    omega
  have wpow : ∀ (y : X) (n : ℕ), w y (x ^ n) = (n : ℤ) * w y x := by
    intro y n
    induction n with
    | zero => simp [w1]
    | succ n ih =>
      rw [pow_succ, wmul _ _ _ (pow_ne_zero n hx0) hx0, ih]
      push_cast; ring
  have AV := fun y => abs_val (w y) (wmul y) (wult y) (wc y)

  have crux : ∀ f : RatFunc Ω, θ f ≠ 0 → (∀ y, 0 ≤ w y x → 0 ≤ w y (θ f)) →
      ∃ P : Polynomial Ω, algebraMap (Polynomial Ω) (RatFunc Ω) P = f := by
    intro f hf hpole
    have hf0 : f ≠ 0 := by rintro rfl; exact hf (map_zero θ)
    have hQ0 : f.denom ≠ 0 := RatFunc.denom_ne_zero f
    have hP0 : f.num ≠ 0 := (RatFunc.num_ne_zero hf0)
    have hnd : algebraMap (Polynomial Ω) (RatFunc Ω) f.num =
        f * algebraMap (Polynomial Ω) (RatFunc Ω) f.denom :=
      (div_eq_iff (RatFunc.algebraMap_ne_zero hQ0)).mp (RatFunc.num_div_denom f)
    have hθf : θ f * f.denom.eval₂ c x = f.num.eval₂ c x := by
      rw [← E1, ← E1, hnd, map_mul]
    have hdeg : f.denom.natDegree = 0 := by
      by_contra hdeg
      have hdeg' : f.denom.degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hQ0]
        exact_mod_cast hdeg
      obtain ⟨r, hr⟩ := IsAlgClosed.exists_root f.denom hdeg'
      have hPr : f.num.eval r ≠ 0 := by
        intro h
        have d1 : Polynomial.X - Polynomial.C r ∣ f.num := Polynomial.dvd_iff_isRoot.mpr h
        have d2 : Polynomial.X - Polynomial.C r ∣ f.denom := Polynomial.dvd_iff_isRoot.mpr hr
        exact Polynomial.not_isUnit_X_sub_C r
          ((RatFunc.isCoprime_num_denom f).isUnit_of_dvd' d1 d2)
      have hz : x - c r ≠ 0 := sub_ne_zero.mpr (E3 r)
      obtain ⟨y, hy⟩ : ∃ y, 0 < w y (x - c r) := by
        by_contra hcon
        push_neg at hcon
        obtain ⟨b, hb⟩ := K2 (x - c r)⁻¹ (inv_ne_zero hz) (fun y => by
          rw [winv y _ hz]; have := hcon y; omega)
        have hb0 : b ≠ 0 := by
          rintro rfl
          rw [map_zero] at hb
          exact inv_ne_zero hz hb.symm
        apply E3 (r + b⁻¹)
        rw [map_add, map_inv₀, hb, inv_inv]
        ring
      obtain ⟨hpz1, hpz2⟩ := (AV y).2.2 r hz hy
      have hwf := hpole y hpz1
      have hwP : w y (f.num.eval₂ c x) = 0 := hpz2 f.num hPr
      have hQdec : (Polynomial.X - Polynomial.C r) * (f.denom /ₘ (Polynomial.X - Polynomial.C r))
          = f.denom := Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hr
      have hQ'0 : f.denom /ₘ (Polynomial.X - Polynomial.C r) ≠ 0 := by
        intro h
        rw [h, mul_zero] at hQdec
        exact hQ0 hQdec.symm
      have hQx : f.denom.eval₂ c x =
          (x - c r) * (f.denom /ₘ (Polynomial.X - Polynomial.C r)).eval₂ c x := by
        conv_lhs => rw [← hQdec]
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      have hQ'n := (AV y).2.1 hpz1 _ hQ'0
      have hwQ : w y (f.denom.eval₂ c x) = w y (x - c r) +
          w y ((f.denom /ₘ (Polynomial.X - Polynomial.C r)).eval₂ c x) := by
        rw [hQx, wmul _ _ _ hz (E2 _ hQ'0)]
      have hsum := wmul y (θ f) (f.denom.eval₂ c x) hf (E2 _ hQ0)
      rw [hθf, hwP] at hsum
      omega
    have hQ1 : f.denom = 1 := Polynomial.eq_one_of_monic_natDegree_zero (RatFunc.monic_denom f) hdeg
    refine ⟨f.num, ?_⟩
    conv_rhs => rw [← RatFunc.num_div_denom f]
    rw [hQ1, map_one, div_one]

  have memF : ∀ (D : X →₀ ℤ) (g : FractionRing Γ(X, U)), g ∈ wcRRSpace Ω X fX U ω D →
      g = 0 ∨ (g ≠ 0 ∧ ∀ y, 0 ≤ w y g + D y) := by
    intro D g hg
    letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
    unfold wcRRSpace at hg
    induction hg using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨ha0, hb⟩ := ha
      exact Or.inr ⟨ha0, fun y => by rw [← hw y a ha0]; exact hb y⟩
    | zero => exact Or.inl rfl
    | add a b _ _ ha hb =>
      rcases ha with rfl | ⟨ha0, ba⟩
      · rw [zero_add]; exact hb
      rcases hb with rfl | ⟨hb0, bb⟩
      · rw [add_zero]; exact Or.inr ⟨ha0, ba⟩
      by_cases hab : a + b = 0
      · exact Or.inl hab
      refine Or.inr ⟨hab, fun y => ?_⟩
      have hu := wult y a b ha0 hb0 hab
      have e1 := ba y
      have e2 := bb y
      rcases min_le_iff.mp hu with h | h <;> linarith
    | smul r a _ ha =>
      rw [show r • a = c r * a from rfl]
      rcases ha with rfl | ⟨ha0, ba⟩
      · exact Or.inl (mul_zero _)
      by_cases hc : c r = 0
      · left; rw [hc, zero_mul]
      refine Or.inr ⟨mul_ne_zero hc ha0, fun y => ?_⟩
      rw [wmul y _ _ hc ha0, wc y r hc, zero_add]
      exact ba y
  have memB : ∀ (D : X →₀ ℤ) (g : FractionRing Γ(X, U)) (hg : g ≠ 0),
      (∀ y, 0 ≤ w y g + D y) → g ∈ wcRRSpace Ω X fX U ω D := by
    intro D g hg h
    letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
    unfold wcRRSpace
    exact Submodule.subset_span ⟨hg, fun y => by rw [hw y g hg]; exact h y⟩

  have hfin : (Function.support (fun y => max 0 (-(w y x)))).Finite := by
    refine (hω.2.2.1 (Additive.ofMul (Units.mk0 x hx0))).subset ?_
    intro y hy
    simp only [Function.mem_support, Set.mem_setOf_eq] at hy ⊢
    rw [hw y x hx0]
    intro h
    apply hy
    rw [h]
    simp
  let Dinf : X →₀ ℤ := Finsupp.ofSupportFinite (fun y => max 0 (-(w y x))) hfin
  have hD : ∀ y, Dinf y = max 0 (-(w y x)) := fun y => by
    simp only [Dinf, Finsupp.ofSupportFinite_coe]
  have hD0 : ∀ y, 0 ≤ Dinf y := fun y => by rw [hD]; exact le_max_left _ _
  obtain ⟨y₀, hy₀⟩ : ∃ y, w y x < 0 := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨r, hr⟩ := K2 x hx0 hcon
    exact E3 r hr.symm
  refine ⟨Dinf, ?_, ?_, ?_⟩
  · rw [hD, ← hw _ x hx0, hω.1]
    simp
  · have hy₀D : 1 ≤ Dinf y₀ := by rw [hD]; omega
    have hmem : y₀ ∈ Dinf.support := Finsupp.mem_support_iff.mpr (by omega)
    calc (1 : ℤ) ≤ Dinf y₀ := hy₀D
      _ ≤ ∑ y ∈ Dinf.support, Dinf y := Finset.single_le_sum (fun y _ => hD0 y) hmem
      _ = Dinf.sum (fun _ k => k) := rfl
  · intro n
    refine ⟨fun k hk => ?_, fun u hu => ?_⟩
    · rw [map_pow]
      refine memB _ _ (pow_ne_zero k hx0) (fun y => ?_)
      rw [wpow, Finsupp.smul_apply, smul_eq_mul, hD]
      have hk' : (k : ℤ) ≤ n := by exact_mod_cast hk
      have hk0 : (0 : ℤ) ≤ k := by positivity
      rcases le_or_gt 0 (w y x) with h | h
      · rw [max_eq_left (by linarith)]
        nlinarith
      · rw [max_eq_right (by linarith)]
        nlinarith
    · rcases memF _ u hu with rfl | ⟨hu0, hmem⟩
      · exact ⟨0, by simp, by simp⟩
      have hθu : θ (θ.symm u) = u := RingEquiv.apply_symm_apply θ u
      obtain ⟨P, hP⟩ := crux (θ.symm u) (by rw [hθu]; exact hu0) (fun y hy => by
        rw [hθu]
        have := hmem y
        rw [Finsupp.smul_apply, smul_eq_mul, hD, max_eq_left (by linarith)] at this
        linarith)
      have hPu : P.eval₂ c x = u := by rw [← E1, hP, hθu]
      have hPne : P ≠ 0 := by
        rintro rfl
        rw [Polynomial.eval₂_zero] at hPu
        exact hu0 hPu.symm
      refine ⟨P, ?_, by rw [hP, hθu]⟩
      have hval := (AV y₀).1 hy₀ P hPne
      rw [hPu] at hval
      have h0 := hmem y₀
      rw [hval, Finsupp.smul_apply, smul_eq_mul, hD, max_eq_right (by linarith)] at h0
      have : (P.natDegree : ℤ) ≤ n := by
        by_contra hcon
        push_neg at hcon
        nlinarith
      exact_mod_cast this

theorem wcpa_dj_lr1k_ebcc_rc_genus_zero : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) [IrreducibleSpace X] (fX : X ⟶ Spec (.of Ω)) (U : X.Opens) [IsDedekindDomain Γ(X, U)] (ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ) (g c₀ : ℕ), (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c₀ : ℤ) ≤ D.sum (fun _ k => k) → @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _ (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧ (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _ (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) = D.sum (fun _ k => k) + 1 - g) → ∀ θ : RatFunc Ω ≃+* FractionRing Γ(X, U), θ.toRingHom.comp (algebraMap Ω (RatFunc Ω)) = wcCurveConst Ω X fX U → ∀ Dinf : X →₀ ℤ, Dinf (genericPoint X) = 0 → 1 ≤ Dinf.sum (fun _ k => k) → (∀ n : ℕ, (∀ k : ℕ, k ≤ n → θ (RatFunc.X ^ k) ∈ wcRRSpace Ω X fX U ω ((n : ℤ) • Dinf)) ∧ ∀ u ∈ wcRRSpace Ω X fX U ω ((n : ℤ) • Dinf), ∃ p : Polynomial Ω, p.natDegree ≤ n ∧ θ (algebraMap (Polynomial Ω) (RatFunc Ω) p) = u) → g = 0 :=
by
  intro Ω _ X _ fX U _ ω g c₀ hRR θ hθ Dinf hη hdeg hH

  have upA : ∀ (K : Type u) [CommRing K] (c : Ω →+* K) (θ : RatFunc Ω ≃+* K),
      θ.toRingHom.comp (algebraMap Ω (RatFunc Ω)) = c → ∀ (n : ℕ)
      (L : @Submodule Ω K _ _ c.toAlgebra.toModule),
      (∀ u ∈ L, ∃ p : Polynomial Ω, p.natDegree ≤ n ∧
        θ (algebraMap (Polynomial Ω) (RatFunc Ω) p) = u) →
      @Module.finrank Ω L _ _ (@Submodule.module Ω _ _ _ c.toAlgebra.toModule _) ≤ n + 1 := by
    intro K _ c θ hθ n L h
    letI : Algebra Ω K := c.toAlgebra
    have hc : ∀ a : Ω, θ (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C a)) = c a := by
      intro a
      rw [← hθ, RingHom.comp_apply, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
      rfl
    let b : Fin (n + 1) → K := fun k => θ (RatFunc.X ^ (k : ℕ))
    have hLS : L ≤ Submodule.span Ω (Set.range b) := by
      intro u hu
      obtain ⟨p, hp, rfl⟩ := h u hu
      rw [Polynomial.as_sum_range' p (n + 1) (by omega), map_sum, map_sum]
      refine Submodule.sum_mem _ (fun i hi => ?_)
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_mul, map_pow, map_pow,
        RatFunc.algebraMap_X, hc, ← map_pow]
      have : c (p.coeff i) * θ (RatFunc.X ^ i) = p.coeff i • θ (RatFunc.X ^ i) := by
        rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      rw [this]
      apply Submodule.smul_mem
      apply Submodule.subset_span
      exact ⟨⟨i, Finset.mem_range.mp hi⟩, rfl⟩
    haveI : FiniteDimensional Ω (Submodule.span Ω (Set.range b)) :=
      FiniteDimensional.span_of_finite Ω (Set.finite_range b)
    calc Module.finrank Ω L ≤ Module.finrank Ω (Submodule.span Ω (Set.range b)) :=
          Submodule.finrank_mono hLS
      _ ≤ Fintype.card (Fin (n + 1)) := finrank_range_le_card b
      _ = n + 1 := Fintype.card_fin _

  have loB : ∀ (K : Type u) [CommRing K] (c : Ω →+* K) (θ : RatFunc Ω ≃+* K),
      θ.toRingHom.comp (algebraMap Ω (RatFunc Ω)) = c → ∀ (n : ℕ)
      (L : @Submodule Ω K _ _ c.toAlgebra.toModule),
      (∀ k : ℕ, k ≤ n → θ (RatFunc.X ^ k) ∈ L) →
      @FiniteDimensional Ω L _ _ (@Submodule.module Ω _ _ _ c.toAlgebra.toModule _) →
      n + 1 ≤ @Module.finrank Ω L _ _ (@Submodule.module Ω _ _ _ c.toAlgebra.toModule _) := by
    intro K _ c θ hθ n L h1 hfd
    letI : Algebra Ω K := c.toAlgebra
    haveI := hfd
    have hc : ∀ a : Ω, θ (algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C a)) = c a := by
      intro a
      rw [← hθ, RingHom.comp_apply, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
      rfl
    let v : Fin (n + 1) → L := fun k =>
      ⟨θ (RatFunc.X ^ (k : ℕ)), h1 k (Nat.lt_succ_iff.mp k.isLt)⟩
    have hv : LinearIndependent Ω v := by
      rw [Fintype.linearIndependent_iff]
      intro w hw i
      have hw' : ∑ k, w k • θ (RatFunc.X ^ (k : ℕ)) = 0 := by
        have := congrArg Subtype.val hw
        rw [Submodule.coe_sum] at this
        exact this
      have hP : θ (algebraMap (Polynomial Ω) (RatFunc Ω)
          (∑ k : Fin (n + 1), Polynomial.C (w k) * Polynomial.X ^ (k : ℕ))) = 0 := by
        rw [← hw', map_sum, map_sum]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [map_mul, map_mul, map_pow, map_pow, RatFunc.algebraMap_X, hc, ← map_pow,
          Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      have h2 : algebraMap (Polynomial Ω) (RatFunc Ω)
          (∑ k : Fin (n + 1), Polynomial.C (w k) * Polynomial.X ^ (k : ℕ)) = 0 :=
