  refine ⟨N, p, ?_⟩
  rw [Polynomial.aeval_X_left_eq_map, hp]

theorem wcpa_dj_lr1k_odfgl_nt_flat_tensor_injective : ∀ (A D Q L : Type u) [CommRing A] [CommRing D] [CommRing Q] [CommRing L] [Algebra A D] [Algebra A Q] [Algebra A L] [Module.Flat A D] (fD : D →ₐ[A] L) (fQ : Q →ₐ[A] L) (a : A), Function.Injective fD → (∀ q : Q, a • q = 0 → q = 0) → (∀ q : Q, ∃ (N : ℕ) (p : A), a ^ N • q = algebraMap A Q p) → Function.Injective (Algebra.TensorProduct.productMap fD fQ) :=
by
  intro A D Q L _ _ _ _ _ _ _ _ fD fQ a hfD hT hC

  have s1 : ∀ z : TensorProduct A D Q, ∃ (N : ℕ) (d : D), a ^ N • z = d ⊗ₜ[A] (1 : Q) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by rw [smul_zero, TensorProduct.zero_tmul]⟩
