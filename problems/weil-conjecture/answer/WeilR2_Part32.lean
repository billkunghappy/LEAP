      congrArg (fun g => g.hom s) ((wcProjK κ N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e0).op)
    have sP : ((wcProjK κ N).presheaf.map (homOfLE (inf_le_right : wcSgD κ N a ⊓ wcSgD κ N b ≤
            wcSgD κ N b)).op).hom (wcEszSec κ N e F b) =
        ((wcProjK κ N).presheaf.map (homOfLE (inf_le_right : wcSgD κ N a ⊓ wcSgD κ N b ≤
