    ∃ b : ↥B', b ∉ 𝔫 ∧ Algebra.IsStandardSmoothOfRelativeDimension 1 ↥W (Localization.Away b) :=
by
  classical
  have t_s1 : ∀ (R : Type u) [CommRing R] (C X : Scheme.{u}) (f : C ⟶ X) [QuasiCompact f]
    [QuasiSeparated f] (V : X.Opens) (hV : IsAffineOpen V) (U' : C.Opens) (hle : U' ≤ f ⁻¹ᵁ V)
    (hge : f ⁻¹ᵁ V ≤ U') [Algebra R Γ(C, U')] (B' : Subalgebra R Γ(C, U'))
    (hB' : ∀ x, x ∈ B' ↔ (f.appLE V U' hle).hom.IsIntegralElem x), ∃ Φ : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ V) ≃+* B', ∀ a : Γ(X, V),
