  obtain ⟨hdomT, hopT, htrT⟩ := wcpa_dj_lr1k_ebcnt_open_sub_props Zt₂ T hdom₂ hop₂
  have loc₂ : ∀ p : ↥T.toScheme, ∃ (V : T.toScheme.Opens), p ∈ V ∧ ∃ h : V.toScheme ⟶ Zt₁,
      h ≫ ν₁ ≫ s₁ = V.ι ≫ T.ι ≫ ν₂ ≫ s₂ ∧
