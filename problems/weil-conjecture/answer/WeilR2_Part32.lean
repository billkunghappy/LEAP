theorem wcpa_dj_llsmgds_deck_galois_hom : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1) (X : Scheme.{u})
    (ι : wcProjK Ω 1 ⟶ X) (V : X.Opens) (hgen : genericPoint C ∈ (γ ≫ ι) ⁻¹ᵁ V)
    (K : Type u) [Field K] [Algebra ↑Γ(X, V) K] [IsFractionRing ↑Γ(X, V) K]
    [Algebra K ↑C.functionField] [Algebra ↑Γ(X, V) ↑C.functionField]
    [IsScalarTower ↑Γ(X, V) K ↑C.functionField] [FiniteDimensional K ↑C.functionField],
    algebraMap ↑Γ(X, V) ↑C.functionField = wcG2cKap (γ ≫ ι) V hgen →
    (∀ (f : C ⟶ C), f ≫ γ = γ → ∀ (hf : f (genericPoint C) = genericPoint C) (r : ↑Γ(X, V)),
      wcpaDjGslTr f (genericPoint C) (genericPoint C) hf
          (algebraMap ↑Γ(X, V) ↑C.functionField r) =
        algebraMap ↑Γ(X, V) ↑C.functionField r) ∧
    ∃ (D : Subgroup (Aut C)) (Φ : ↥D →* (↑C.functionField ≃ₐ[K] ↑C.functionField)),
      (∀ a : Aut C, a ∈ D ↔ a.hom ≫ γ = γ) ∧
      ∀ (a : ↥D) (h : a.1.inv (genericPoint C) = genericPoint C) (ℓ : ↑C.functionField),
        Φ a ℓ = wcpaDjGslTr a.1.inv (genericPoint C) (genericPoint C) h ℓ :=
by
  intro Ω _ C _ γ X ι V hgen K _ _ _ _ _ _ _ hκ

  have hgerm : ∀ {X₁ Y₁ : Scheme.{u}} (f : X₁ ⟶ Y₁) (x : X₁) (y : Y₁) (h : f x = y)
      (U : Y₁.Opens) (hy : y ∈ U) (hx : x ∈ f ⁻¹ᵁ U) (s : Γ(Y₁, U)),
      wcpaDjGslTr f x y h ((Y₁.presheaf.germ U y hy).hom s) =
        (X₁.presheaf.germ (f ⁻¹ᵁ U) x hx).hom ((f.app U).hom s) := by
    intro X₁ Y₁ f x y h U hy hx s
    subst h
    show (f.stalkMap x).hom ((Y₁.presheaf.stalkSpecializes (specializes_of_eq rfl)).hom
      ((Y₁.presheaf.germ U (f x) hy).hom s)) = _
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    exact Scheme.Hom.germ_stalkMap_apply f U x hx s

  have hcomp : ∀ {X₁ Y₁ Z₁ : Scheme.{u}} (f : X₁ ⟶ Y₁) (g : Y₁ ⟶ Z₁) (x : X₁) (y : Y₁) (z : Z₁)
      (hf : f x = y) (hg : g y = z) (hfg : (f ≫ g) x = z) (ℓ : Z₁.presheaf.stalk z),
      wcpaDjGslTr (f ≫ g) x z hfg ℓ = wcpaDjGslTr f x y hf (wcpaDjGslTr g y z hg ℓ) := by
    intro X₁ Y₁ Z₁ f g x y z hf hg hfg ℓ
    obtain ⟨U, hz, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq Z₁.presheaf ℓ
    have hy : y ∈ g ⁻¹ᵁ U := by rw [Scheme.Hom.mem_preimage, hg]; exact hz
    have hx : x ∈ f ⁻¹ᵁ (g ⁻¹ᵁ U) := by rw [Scheme.Hom.mem_preimage, hf]; exact hy
    rw [hgerm (f ≫ g) x z hfg U hz hx s, hgerm g y z hg U hz hy s,
      hgerm f x y hf (g ⁻¹ᵁ U) hy hx]
    rfl

  have hpartI : ∀ (f : C ⟶ C), f ≫ γ = γ → ∀ (hf : f (genericPoint C) = genericPoint C)
      (r : ↑Γ(X, V)), wcpaDjGslTr f (genericPoint C) (genericPoint C) hf
          (algebraMap ↑Γ(X, V) ↑C.functionField r) =
        algebraMap ↑Γ(X, V) ↑C.functionField r := by
    intro f hfγ hf r
    rw [hκ]
    have hx : genericPoint C ∈ f ⁻¹ᵁ ((γ ≫ ι) ⁻¹ᵁ V) := by
      rw [Scheme.Hom.mem_preimage, hf]; exact hgen
    have e : f ≫ γ ≫ ι = γ ≫ ι := by rw [← Category.assoc, hfγ]
    have htr : ∀ (h₁ h₂ : C ⟶ X), h₁ = h₂ → ∀ (p₁ : genericPoint C ∈ h₁ ⁻¹ᵁ V)
        (p₂ : genericPoint C ∈ h₂ ⁻¹ᵁ V),
        (C.presheaf.germ (h₁ ⁻¹ᵁ V) (genericPoint C) p₁).hom ((h₁.app V).hom r) =
          (C.presheaf.germ (h₂ ⁻¹ᵁ V) (genericPoint C) p₂).hom ((h₂.app V).hom r) := by
      rintro _ _ rfl _ _; rfl
    show wcpaDjGslTr f _ _ hf ((C.presheaf.germ ((γ ≫ ι) ⁻¹ᵁ V) (genericPoint C) hgen).hom
        (((γ ≫ ι).app V).hom r)) =
      (C.presheaf.germ ((γ ≫ ι) ⁻¹ᵁ V) (genericPoint C) hgen).hom (((γ ≫ ι).app V).hom r)
    rw [hgerm f _ _ hf _ hgen hx]
    exact htr (f ≫ γ ≫ ι) (γ ≫ ι) e hx hgen

  have hinv : ∀ a : Aut C, a.hom ≫ γ = γ → a.inv ≫ γ = γ := by
    intro a ha
    have hih : a.inv ≫ a.hom = 𝟙 C := Iso.inv_hom_id a
    calc a.inv ≫ γ = a.inv ≫ a.hom ≫ γ := by rw [ha]
      _ = γ := by rw [← Category.assoc, hih, Category.id_comp]
  let D : Subgroup (Aut C) :=
    { carrier := {a | a.hom ≫ γ = γ}
      one_mem' := Category.id_comp γ
      mul_mem' := by
        intro a b ha hb
        have ha' : a.hom ≫ γ = γ := ha
        have hb' : b.hom ≫ γ = γ := hb
        show (b.hom ≫ a.hom) ≫ γ = γ
        rw [Category.assoc, ha', hb']
      inv_mem' := by
        intro a ha
        exact hinv a ha }

  have hη : ∀ a : Aut C, a.inv (genericPoint C) = genericPoint C := fun a =>
    @genericPoint_eq_of_isOpenImmersion _ _ a.inv
      (@IsOpenImmersion.of_isIso _ _ a.inv (Iso.isIso_inv a)) _ _
  have halg : ∀ (τ : ↑C.functionField →+* ↑C.functionField),
      (∀ r : ↑Γ(X, V), τ (algebraMap ↑Γ(X, V) ↑C.functionField r) =
        algebraMap ↑Γ(X, V) ↑C.functionField r) →
      ∃ σ : ↑C.functionField ≃ₐ[K] ↑C.functionField, ∀ ℓ, σ ℓ = τ ℓ := by
    intro τ hτ
    have hjk : τ.comp (algebraMap K ↑C.functionField) = algebraMap K ↑C.functionField := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors ↑Γ(X, V))
      ext r
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply ↑Γ(X, V) K ↑C.functionField r, hτ]
    let τ' : ↑C.functionField →ₐ[K] ↑C.functionField :=
      { τ with commutes' := fun c => congrArg (fun φ => φ c) hjk }
    exact ⟨AlgEquiv.ofBijective τ' τ'.bijective, fun ℓ => rfl⟩
  have hfixA : ∀ (a : D) (r : ↑Γ(X, V)),
      wcpaDjGslTr a.1.inv (genericPoint C) (genericPoint C) (hη a.1)
        (algebraMap ↑Γ(X, V) ↑C.functionField r) = algebraMap ↑Γ(X, V) ↑C.functionField r :=
    fun a r => hpartI a.1.inv (hinv a.1 a.2) (hη a.1) r
  choose σ hσ using fun a : D =>
    halg (wcpaDjGslTr a.1.inv (genericPoint C) (genericPoint C) (hη a.1)) (hfixA a)
  have hmul : ∀ a b : D, σ (a * b) = σ a * σ b := by
    intro a b
    apply AlgEquiv.ext
    intro ℓ
    rw [AlgEquiv.mul_apply, hσ (a * b) ℓ, hσ a, hσ b ℓ]
    exact hcomp a.1.inv b.1.inv _ _ _ (hη a.1) (hη b.1) (hη (a * b).1) ℓ
  refine ⟨hpartI, D, MonoidHom.mk' σ hmul, fun a => Iff.rfl, ?_⟩
  intro a h ℓ
  rw [MonoidHom.mk'_apply]
  exact hσ a ℓ

theorem wcpa_dj_llsmgds_deck_fixed_in_base : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
