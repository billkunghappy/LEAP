  haveI : JacobsonSpace ↥(Limits.pullback u s) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd u s)
  by_cases h1 : x = x'
  · exact Or.inl h1
  by_cases h2 : x' = x''
  · exact Or.inr h2
  exfalso
  rcases hss.2.2 K s x' with ⟨W, hx'W, hsm⟩ | hnode
  · haveI := hsm
    have hdim := wc_smooth_alg_closed_dim_le K W.toScheme (W.ι ≫ Limits.pullback.snd u s) 1
    have hxW : x ∈ W := hxx'.mem_open W.isOpen hx'W
    obtain ⟨z, hzW, hx'z, hne⟩ := s3 (W : Set _) W.isOpen x' x'' hx'W hx'x'' h2
