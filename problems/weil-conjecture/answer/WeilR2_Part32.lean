      ∀ x : Scheme.Hom.normalization g,
        IsDomain ((Scheme.Hom.normalization g).presheaf.stalk x) ∧
        IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk x) := by
    intro X R g _ _ h x
    set b := Scheme.Hom.fromNormalization g
    obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
    have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
    have hx : x ∈ b ⁻¹ᵁ V := hbV
    letI := (g.app V).hom.toAlgebra
    let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
      (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
    let p := (hW.primeIdealOf ⟨x, hx⟩).asIdeal
    let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := p.comap e.symm.toRingHom
    haveI : Q.IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨hd, hic⟩ := h ⟨V, hV⟩ Q
    set y : (b ⁻¹ᵁ V : Scheme) := ⟨x, hx⟩
    show IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) ∧
      IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk y.1)
    letI : Algebra Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
        ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.normalization g).presheaf y
    haveI := hW.isLocalization_stalk y
    have hM : p.primeCompl.map e.toMonoidHom = Q.primeCompl := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        show e.symm (e w) ∉ p
        rw [e.symm_apply_apply]
        exact hw
      · intro hz
        exact ⟨e.symm z, hz, e.apply_symm_apply z⟩
    let f : (Scheme.Hom.normalization g).presheaf.stalk y.1 ≃+* Localization.AtPrime Q :=
      IsLocalization.ringEquivOfRingEquiv (M := p.primeCompl) (T := Q.primeCompl) _ _ e hM
    haveI : IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      MulEquiv.isDomain _ f.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv f.symm⟩

  have s6c : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g] (W : R.Opens),
      IsAffineOpen W → (letI := (g.app W).hom.toAlgebra;
        Function.Bijective (algebraMap Γ(R, W) (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) →
      IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro X R g _ _ W hW hbij
    set b := Scheme.Hom.fromNormalization g
    haveI : IsAffine W := hW
    haveI : IsAffine (b ⁻¹ᵁ W : Scheme) := hW.preimage b
    have hiso : IsIso (b.app W) := by
      rw [Scheme.Hom.fromNormalization_app g hW]
      letI := (g.app W).hom.toAlgebra
      haveI : IsIso (CommRingCat.ofHom (algebraMap Γ(R, W)
          (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) :=
        (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
      infer_instance
    have hiso' : ∀ U' : R.Opens, U' = W → IsIso (b.app U') := by
      rintro U' rfl; exact hiso
    have htop : IsIso (Scheme.Hom.appTop (b ∣_ W)) := by
      rw [morphismRestrict_appTop]
      have h3 := hiso' _ (Scheme.Opens.ι_image_top W)
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ h3 (Functor.map_isIso _ _)
    have := Scheme.isoSpec_hom_naturality (b ∣_ W)
    have h2 : b ∣_ W = (b ⁻¹ᵁ W : Scheme).isoSpec.hom ≫ Spec.map (Scheme.Hom.appTop (b ∣_ W)) ≫
        (W : Scheme).isoSpec.inv := by
      rw [← Category.assoc, this]; simp
    rw [h2]
    infer_instance

  have s10 : ∀ (X R : Scheme.{u}) (b : X ⟶ R) (U : R.Opens),
      (∀ y ∈ U, ∃ V : R.Opens, y ∈ V ∧ IsIso (b ∣_ V)) → IsIso (b ∣_ U) := by
    intro X R b U h
    have hmono : ∀ (V W : R.Opens), W ≤ V → IsIso (b ∣_ V) → IsIso (b ∣_ W) := by
      intro V W hWV hV
      have h1 : IsIso ((b ∣_ V) ∣_ (V.ι ⁻¹ᵁ W)) :=
        IsZariskiLocalAtTarget.restrict (P := MorphismProperty.isomorphisms Scheme) hV _
      have e : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hWV
      have h2 := (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b V (V.ι ⁻¹ᵁ W)) |>.mp h1
      rw [e] at h2
      exact h2
    choose! V hyV hV using h
    have key : ∀ y : U, IsIso ((b ∣_ U) ∣_ (U.ι ⁻¹ᵁ V y.1)) := by
      intro y
      have h1 : IsIso (b ∣_ (U.ι ''ᵁ (U.ι ⁻¹ᵁ V y.1))) := by
        apply hmono (V y.1) _ _ (hV y.1 y.2)
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
        exact inf_le_right
      exact (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b U (U.ι ⁻¹ᵁ V y.1)) |>.mpr h1
    have htop : ⨆ y : U, U.ι ⁻¹ᵁ V y.1 = ⊤ := by
      rw [eq_top_iff]
      intro z _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hyV z.1 z.2⟩
    exact (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := MorphismProperty.isomorphisms Scheme) _ htop).mpr key

  have s12 : ∀ (R : Scheme.{u}) (V : R.Opens) (hV : IsAffineOpen V) (y : R) (hy : y ∈ V),
      ((∀ y' : R, y' ⤳ y → y' = y) →
        (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∈ minimalPrimes Γ(R, V)) ∧
      ∀ f : Γ(R, V), f ∉ (hV.primeIdealOf ⟨y, hy⟩).asIdeal → y ∈ R.basicOpen f := by
    intro R V hV y hy
    have hfy : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hy⟩
    refine ⟨fun hgen => ?_, fun f hf => ?_⟩
    · refine ⟨⟨(hV.primeIdealOf ⟨y, hy⟩).isPrime, bot_le⟩, fun q ⟨hq, _⟩ hle => ?_⟩
      let q' : PrimeSpectrum Γ(R, V) := ⟨q, hq⟩
      have hsp : q' ⤳ hV.primeIdealOf ⟨y, hy⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have h1 : hV.fromSpec q' ⤳ y := hfy ▸ hsp.map hV.fromSpec.continuous
      have h2 : hV.fromSpec q' = hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) :=
        (hgen _ h1).trans hfy.symm
      have h3 := hV.fromSpec.isOpenEmbedding.injective h2
      have : q' = hV.primeIdealOf ⟨y, hy⟩ := h3
      rw [← this]
    · have h1 : hV.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen f := hf
      rw [← hV.fromSpec_preimage_basicOpen] at h1
      have h2 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ R.basicOpen f := h1
      rwa [hfy] at h2

  have c2 : ∀ (T : Type u) [TopologicalSpace T] [QuasiSober T] [T0Space T] (O : Set T),
      IsOpen O → O.Nonempty → ∃ y ∈ O, ∀ y' : T, y' ⤳ y → y' = y := by
    intro T _ _ _ O hO hOne
    obtain ⟨x, hx⟩ := hOne
    obtain ⟨C, hC, hxC⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := x)).closure
    have hCmax : Maximal IsIrreducible C := hC
    have hCirr : IsIrreducible C := hCmax.1
    have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hC
    have hgen := hCirr.isGenericPoint_genericPoint_closure
    rw [hCcl.closure_eq] at hgen
    have hxC' : x ∈ C := hxC (subset_closure rfl)
    have hηx : hCirr.genericPoint ⤳ x := hgen.specializes hxC'
    refine ⟨hCirr.genericPoint, hηx.mem_open hO hx, fun y' hy' => ?_⟩
    have h1 : closure {hCirr.genericPoint} ⊆ closure {y'} := specializes_iff_closure_subset.mp hy'
    rw [hgen.def] at h1
    have h2 : closure {y'} ⊆ C := hCmax.2 isIrreducible_singleton.closure h1
    have hy'C : y' ∈ C := h2 (subset_closure rfl)
    have hηy : hCirr.genericPoint ⤳ y' := hgen.specializes hy'C
    exact (hy'.antisymm hηy).eq

  intro κ _ _ Z N j hj hred _hdim
  haveI := hj
  haveI := hred
  haveI := wc_proj_space_isProper κ N
  haveI hfR : IsProper (j ≫ wcProjKStr κ N) := inferInstance
  obtain ⟨X, g, hqc, hqs, hL⟩ := generic_points_scheme κ Z (j ≫ wcProjKStr κ N)
  haveI := hqc
  haveI := hqs
  have hnoeth : ∀ (V : Z.Opens) (hV : IsAffineOpen V), IsNoetherianRing Γ(Z, V) := by
    intro V hV
    obtain ⟨φ, hφ⟩ := s0 κ Z (j ≫ wcProjKStr κ N) ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType κ Γ(Z, V) := hφ
    exact Algebra.FiniteType.isNoetherianRing κ _
  have hfinP : ∀ (V : Z.Opens) (hV : IsAffineOpen V), ∀ P ∈ minimalPrimes Γ(Z, V),
      Module.Finite (Γ(Z, V) ⧸ P)
        (integralClosure (Γ(Z, V) ⧸ P) (FractionRing (Γ(Z, V) ⧸ P))) := by
    intro V hV P hP
    obtain ⟨φ, hφ⟩ := s0 κ Z (j ≫ wcProjKStr κ N) ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType κ Γ(Z, V) := hφ
    haveI : P.IsPrime := hP.1.1
    exact noether_integralClosure_finite κ (Γ(Z, V) ⧸ P)

  haveI hfin : IsFinite (Scheme.Hom.fromNormalization g) := by
    apply s6a X Z g
    intro V
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_finite Γ(Z, V) Γ(X, g ⁻¹ᵁ V) (hL V) (hfinP V.1 V.2)

  have hnorm := s6b X Z g (fun V => by
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_stalks_normal Γ(Z, V) Γ(X, g ⁻¹ᵁ V) (hL V))

  have hgenP : ∀ (y : Z) (V : Z.Opens) (hV : IsAffineOpen V) (hy : y ∈ V),
      (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∈ minimalPrimes Γ(Z, V) →
      ∃ W : Z.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro y V hV hy hmin
    obtain ⟨-, hbasic⟩ := s12 Z V hV y hy
    haveI := hnoeth V hV
    obtain ⟨f, hf, hB⟩ := reduced_noetherian_generic_normal Γ(Z, V) (hfinP V hV) _ hmin
    have hW : IsAffineOpen (Z.basicOpen f) := hV.basicOpen f
    haveI := hV.isLocalization_basicOpen f
    obtain ⟨hdom, hic⟩ := hB Γ(Z, Z.basicOpen f)
    refine ⟨Z.basicOpen f, hbasic f hf, ?_⟩
    apply s6c X Z g _ hW
    letI := (g.app (Z.basicOpen f)).hom.toAlgebra
    exact s4b Γ(Z, Z.basicOpen f) Γ(X, g ⁻¹ᵁ Z.basicOpen f) (hL ⟨Z.basicOpen f, hW⟩)

  have c1 : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (x : X) (hx : g x ∈ V),
      (hV.primeIdealOf ⟨g x, hx⟩).asIdeal ∈ minimalPrimes Γ(Z, V) := by
    intro V hV x hx
    haveI := hnoeth V hV
    letI := (g.app V).hom.toAlgebra
    obtain ⟨e⟩ := hL ⟨V, hV⟩
    have hunit : ∀ s : Γ(Z, V), (∀ P ∈ minimalPrimes Γ(Z, V), s ∉ P) →
        s ∉ (hV.primeIdealOf ⟨g x, hx⟩).asIdeal := by
      intro s hs
      have h2 : IsUnit (e (algebraMap Γ(Z, V) Γ(X, g ⁻¹ᵁ V) s)) := by
        rw [e.commutes, Pi.isUnit_iff]
        intro P
        exact (IsLocalization.AtPrime.isUnit_to_map_iff _ P.1.asIdeal s).mpr (hs _ P.2)
      have h1 : IsUnit (algebraMap Γ(Z, V) Γ(X, g ⁻¹ᵁ V) s) := by
        have := h2.map e.symm
        rwa [AlgEquiv.symm_apply_apply] at this
      have h3 : IsUnit ((g.stalkMap x).hom ((Z.presheaf.germ V (g x) hx).hom s)) := by
        have e1 := Scheme.Hom.germ_stalkMap_apply g V x hx s
        have e2 : IsUnit ((X.presheaf.germ (g ⁻¹ᵁ V) x hx).hom ((g.app V).hom s)) :=
          h1.map (X.presheaf.germ (g ⁻¹ᵁ V) x hx).hom
        exact (congrArg IsUnit e1).mpr e2
      have h4 : IsUnit ((Z.presheaf.germ V (g x) hx).hom s) := isUnit_of_map_unit _ _ h3
      letI : Algebra Γ(Z, V) (Z.presheaf.stalk (g x)) :=
        TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨g x, hx⟩
      haveI := hV.isLocalization_stalk ⟨g x, hx⟩
      exact (IsLocalization.AtPrime.isUnit_to_map_iff _
        (hV.primeIdealOf ⟨g x, hx⟩).asIdeal s).mp h4
    have hfinM := minimalPrimes.finite_of_isNoetherianRing Γ(Z, V)
    obtain ⟨P, hPF, hpP⟩ := (Ideal.subset_union_prime (s := hfinM.toFinset) (f := fun i => i) ⊥ ⊥
        (fun i hi _ _ => (hfinM.mem_toFinset.mp hi).1.1)
        (I := (hV.primeIdealOf ⟨g x, hx⟩).asIdeal)).mp (by
      intro t ht
      by_contra hcon
      refine hunit t (fun P hP htP => hcon ?_) ht
      exact Set.mem_iUnion₂.mpr ⟨P, hfinM.mem_toFinset.mpr hP, htP⟩)
    have hPmin : P ∈ minimalPrimes Γ(Z, V) := hfinM.mem_toFinset.mp hPF
    have hle : P ≤ (hV.primeIdealOf ⟨g x, hx⟩).asIdeal :=
      hPmin.2 ⟨(hV.primeIdealOf ⟨g x, hx⟩).isPrime, bot_le⟩ hpP
    have heq : (hV.primeIdealOf ⟨g x, hx⟩).asIdeal = P := le_antisymm hpP hle
    rw [heq]
    exact hPmin

  let G : Set Z := {y | ∃ W : Z.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W)}
  have hGopen : IsOpen G := by
    rw [isOpen_iff_forall_mem_open]
    rintro y ⟨W, hyW, hW⟩
    exact ⟨W, fun z hz => ⟨W, hz, hW⟩, W.isOpen, hyW⟩
  let U : Z.Opens := ⟨G, hGopen⟩
  have hUiso : IsIso (Scheme.Hom.fromNormalization g ∣_ U) := s10 _ Z _ U (fun y hy => hy)

  have hUdense : Dense (U : Set Z) := by
    rw [dense_iff_inter_open]
    intro O hO hOne
    obtain ⟨y, hyO, hymax⟩ := c2 Z O hO hOne
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    obtain ⟨hmin, -⟩ := s12 Z V hV y hyV
    exact ⟨y, hyO, hgenP y V hV hyV (hmin hymax)⟩

  have hpre : Dense ((Scheme.Hom.fromNormalization g ⁻¹ᵁ U :
      (Scheme.Hom.normalization g).Opens) : Set (Scheme.Hom.normalization g)) := by
    refine Dense.mono ?_ (Scheme.Hom.denseRange (Scheme.Hom.toNormalization g))
    rintro _ ⟨x, rfl⟩
    show Scheme.Hom.fromNormalization g (Scheme.Hom.toNormalization g x) ∈ G
    have hx : Scheme.Hom.fromNormalization g (Scheme.Hom.toNormalization g x) = g x := by
      rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
    rw [hx]
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := g x) (U := ⊤) trivial
    exact hgenP (g x) V hV hyV (c1 V hV x hyV)
  exact ⟨Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g, hfin, hnorm, U, hUdense,
    hpre, hUiso⟩

theorem wcpa_dj_lr1k_ll_gc_df_serre_curve : ∀ (K : Type u) [Field K] (T : Scheme.{u}) {N : ℕ}
    (φ : T ⟶ wcProjK K N), IsClosedImmersion φ →
    topologicalKrullDim ↥T ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∃ m₀ : ℕ, ∀ m : ℕ, m₀ ≤ m → ∀ c, wcGcDfCoc φ m c → wcGcDfCob φ m c :=
by
  intro K _ T N φ hφ _
  classical
  haveI := hφ
  have chart := wcpa_dj_gsfp_chart_facts K N

  have hres : ∀ (U U' : (wcProjK K N).Opens) (hUU : U' ≤ U) (V : T.Opens)
      (h1 : V ≤ φ ⁻¹ᵁ U) (h2 : V ≤ φ ⁻¹ᵁ U') (y : Γ(wcProjK K N, U)),
      (T.presheaf.map (homOfLE h1).op).hom ((φ.app U).hom y) =
        (T.presheaf.map (homOfLE h2).op).hom
          ((φ.app U').hom (((wcProjK K N).presheaf.map (homOfLE hUU).op).hom y)) := by
    intro U U' hUU V h1 h2 y
    have e := Scheme.Hom.naturality φ (homOfLE hUU).op
    have e2 := congrArg (fun g => (g ≫ T.presheaf.map (homOfLE h2).op).hom y) e
    simp only [Category.assoc, ← Functor.map_comp] at e2
    change _ = (CommRingCat.Hom.hom ((wcProjK K N).presheaf.map (homOfLE hUU).op ≫
      Scheme.Hom.app φ U' ≫ T.presheaf.map (homOfLE h2).op)) y
    rw [e2]
    rfl

  have hD : ∀ a : Fin (N + 1), IsAffineOpen (φ ⁻¹ᵁ wcSgD K N a) := fun a =>
    (chart.1 a).preimage φ
  have hxJJ : ∀ a : Fin (N + 1), (φ.app (wcSgD K N a)).hom (wcSgE K N a a) = 1 := by
    intro a
    rw [(chart.2 a a a).1, map_one]
  have hx : ∀ a b : Fin (N + 1), φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b =
      T.basicOpen ((φ.app (wcSgD K N b)).hom (wcSgE K N b a)) := by
    intro a b
    rw [← Scheme.preimage_basicOpen, (chart.2 b a a).2.1, Scheme.Hom.preimage_inf, inf_comm]
  have hxc : ∀ a b b' : Fin (N + 1),
      (T.presheaf.map (homOfLE (show φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓
          φ ⁻¹ᵁ wcSgD K N b' ≤ φ ⁻¹ᵁ wcSgD K N b' from inf_le_right)).op).hom
          ((φ.app (wcSgD K N b')).hom (wcSgE K N b' a)) =
        (T.presheaf.map (homOfLE (show φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓
          φ ⁻¹ᵁ wcSgD K N b' ≤ φ ⁻¹ᵁ wcSgD K N b from inf_le_left.trans inf_le_right)).op).hom
          ((φ.app (wcSgD K N b)).hom (wcSgE K N b a)) *
        (T.presheaf.map (homOfLE (show φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓
          φ ⁻¹ᵁ wcSgD K N b' ≤ φ ⁻¹ᵁ wcSgD K N b' from inf_le_right)).op).hom
          ((φ.app (wcSgD K N b')).hom (wcSgE K N b' b)) := by
    intro a b b'
    have hV : φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b ⊓ φ ⁻¹ᵁ wcSgD K N b' ≤
        φ ⁻¹ᵁ (wcSgD K N b' ⊓ wcSgD K N b) := by
      rw [Scheme.Hom.preimage_inf]
      exact le_inf inf_le_right (inf_le_left.trans inf_le_right)
    have h3 := (chart.2 b' b a).2.2
    rw [hres _ _ (inf_le_left : wcSgD K N b' ⊓ wcSgD K N b ≤ wcSgD K N b') _ _ hV,
      hres _ _ (inf_le_right : wcSgD K N b' ⊓ wcSgD K N b ≤ wcSgD K N b) _ _ hV,
      hres _ _ (inf_le_left : wcSgD K N b' ⊓ wcSgD K N b ≤ wcSgD K N b') _ _ hV,
      ← map_mul, ← map_mul, mul_comm]
    exact congrArg (fun t => (T.presheaf.map (homOfLE hV).op).hom
      ((φ.app (wcSgD K N b' ⊓ wcSgD K N b)).hom t)) h3

  have hgen : ∀ (b : Fin (N + 1)) (f : Γ(T, φ ⁻¹ᵁ wcSgD K N b)),
      ∃ P : MvPolynomial (Fin (N + 1)) K, f = MvPolynomial.eval₂
        ((T.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcSgD K N b ≤ ⊤)).op).hom.comp
          ((φ ≫ wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
        (fun l => (φ.app (wcSgD K N b)).hom (wcSgE K N b l)) P := by
    intro b f
    obtain ⟨y, rfl⟩ := Scheme.Hom.app_surjective φ (wcSgD K N b) (chart.1 b) f
    set E := MvPolynomial.eval₂Hom
      ((T.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcSgD K N b ≤ ⊤)).op).hom.comp
          ((φ ≫ wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
        (fun l => (φ.app (wcSgD K N b)).hom (wcSgE K N b l)) with hE
    have hy : y ∈ E.range.comap (φ.app (wcSgD K N b)).hom := by
      refine (Subring.closure_le.mpr ?_) (wc_ldpi_oai_proj_gen K N b y)
      refine Set.union_subset ?_ ?_
      · rintro _ ⟨l, rfl⟩
        exact ⟨MvPolynomial.X l, MvPolynomial.eval₂Hom_X' _ _ _⟩
      · rintro _ ⟨c, rfl⟩
        refine ⟨MvPolynomial.C c, ?_⟩
        rw [hE, MvPolynomial.eval₂Hom_C]
        have e := Scheme.Hom.naturality φ (homOfLE (le_top : wcSgD K N b ≤ ⊤)).op
        have e2 := congrArg (fun g => g.hom
          ((wcProjKStr K N).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) e
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
        simp only [RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
        exact e2.symm
    obtain ⟨P, hP⟩ := hy
    exact ⟨P, hP.symm⟩
  obtain ⟨k₀, hk⟩ := wcpa_dj_sv_chart_serre K N ⊤
    ((φ ≫ wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)
    (fun a => φ ⁻¹ᵁ wcSgD K N a) (fun _ => le_top)
    (fun a b => (φ.app (wcSgD K N b)).hom (wcSgE K N b a)) hD hxJJ hx hxc hgen
    (wcStructMod T) (wc_struct_mod_coh T).1 (fun b => (wc_struct_mod_coh T).2 _ (hD b))
  refine ⟨k₀, fun m hm c hc => ?_⟩
  obtain ⟨s, hs⟩ := hk m hm c (fun a b l => ((hc a b l).symm.trans (add_comm _ _)))
  exact ⟨s, hs⟩

theorem wcpa_dj_lr1k_ll_gc_sj_cech_lift : ∀ (κ : Type u) [Field κ] (Z Zt : Scheme.{u}) {N : ℕ}
    (j : Z ⟶ wcProjK κ N) (ν : Zt ⟶ Z),
    (∀ V : Z.Opens, Function.Injective (ν.app V)) → ∀ e : ℕ,
    (∀ c, wcGcDfCoc j e c → wcGcDfCob j e c) →
    ∀ b ∈ wcGcSjRelSec j ν e, ∃ f ∈ wcGcDfSec (ν ≫ j) e, ∀ a : Fin (N + 1),
      f a - b a ∈ Set.range (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl) :=
by
  classical
  intro κ _ Z Zt N j ν hinj e hHV b hb

  have H1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V V' : X.Opens) (hV : V ≤ f ⁻¹ᵁ U)
      (h : V' ≤ V) (x : Γ(Y, U)),
      (X.presheaf.map (homOfLE h).op).hom ((f.appLE U V hV).hom x) =
        (f.appLE U V' (h.trans hV)).hom x := by
    intro X Y f U V V' hV h x
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  have H2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U U' : Y.Opens) (V : X.Opens) (hV : V ≤ f ⁻¹ᵁ U')
      (h : U' ≤ U) (x : Γ(Y, U)),
      (f.appLE U' V hV).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
        (f.appLE U V (hV.trans (Scheme.Hom.preimage_mono f h))).hom x := by
    intro X Y f U U' V hV h x
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have H3 : ∀ {X : Scheme.{u}} (U V W : X.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have H4 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (x : Γ(Y, U)),
