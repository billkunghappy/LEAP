theorem wcpa_dj_lr1k_ll_gc_sk_assembly : ∀ (κ : Type u) [Field κ] (Z Zt : Scheme.{u}) {N : ℕ}
    (j : Z ⟶ wcProjK κ N) (ν : Zt ⟶ Z),
    (∀ V : Z.Opens, Function.Injective (ν.app V)) → ∀ (e : ℕ) (Sg : Finset Z)
    (α : Z → Fin (N + 1)),
    (∀ z ∈ Sg, z ∈ j ⁻¹ᵁ wcSgD κ N (α z)) →
    (∀ (a : Fin (N + 1)) (z : Z), z ∈ j ⁻¹ᵁ wcSgD κ N a → z ∉ Sg →
        ∀ b : Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a), wcGcSkTriv ν (j ⁻¹ᵁ wcSgD κ N a) b z) →
    (∀ (a : Fin (N + 1)) (S : Finset Z) (V : Z → Z.Opens) (c : ∀ z, Γ(Zt, ν ⁻¹ᵁ V z))
        (hV : ∀ z, V z ≤ j ⁻¹ᵁ wcSgD κ N a), (∀ z ∈ S, z ∈ V z) →
        ∃ b : Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a), ∀ z ∈ S,
          wcGcSkTriv ν (V z) (Zt.presheaf.map (homOfLE (ν.preimage_mono (hV z))).op b - c z) z) →
    wcGcSjQRk j ν e = ∑ z ∈ Sg, wcGcSkLocRk j ν (α z) z :=
by
  classical
  intro κ _ Z Zt N j ν hinj e Sg α HS VAN APP
  have C1 : ∀ (K : Type u) [Field K] (N : ℕ) {P : Type u} (A' : Fin (N + 1) → Type u)
      [∀ a, CommRing (A' a)] (s' : ∀ a, K →+* A' a) (R : Set (∀ a, A' a)) (T : ∀ a, Set (A' a))
      (Sg : Finset P) (α : P → Fin (N + 1)) (L : ∀ z : P, Set (A' (α z))),
      (0 : ∀ a, A' a) ∈ R → (∀ x ∈ R, ∀ y ∈ R, x + y ∈ R) →
      (∀ (c : K), ∀ x ∈ R, (fun a => s' a c * x a) ∈ R) →
      (∀ z ∈ Sg, (0 : A' (α z)) ∈ L z ∧ (∀ x ∈ L z, ∀ y ∈ L z, x + y ∈ L z) ∧
        (∀ (c : K), ∀ x ∈ L z, s' (α z) c * x ∈ L z)) →
      (∀ b ∈ R, (∀ a, b a ∈ T a) → ∀ z ∈ Sg, b (α z) ∈ L z) →
      (∀ b ∈ R, (∀ z ∈ Sg, b (α z) ∈ L z) → ∀ a, b a ∈ T a) →
      (∀ w : ∀ z, A' (α z), ∃ b ∈ R, ∀ z ∈ Sg, b (α z) - w z ∈ L z) →
      (⨆ (n : ℕ) (v : Fin n → ↥R) (_ : ∀ c : Fin n → K,
          (∀ a, ∑ i, s' a (c i) * (v i).1 a ∈ T a) → ∀ i, c i = 0), (n : ℕ∞)) =
        ∑ z ∈ Sg, ⨆ (n : ℕ) (v : Fin n → A' (α z)) (_ : ∀ c : Fin n → K,
          (∑ i, s' (α z) (c i) * v i) ∈ L z → ∀ i, c i = 0), (n : ℕ∞) := by
    classical
    intro K _ N P A' _ s' R T Sg α L hR0 hRadd hRsm hL hb hc hd
    have B1 : ∀ {M : Type u} [AddCommGroup M] [Module K M] (Pm : Submodule K M)
        (Q : ∀ n : ℕ, (Fin n → M) → (Fin n → K) → Prop)
        (_ : ∀ n v c, Q n v c ↔ (∑ i, c i • v i) ∈ Pm),
        (⨆ (n : ℕ) (v : Fin n → M) (_ : ∀ c : Fin n → K, Q n v c → ∀ i, c i = 0), (n : ℕ∞)) =
          Cardinal.toENat (Module.rank K (M ⧸ Pm)) := by
      intro M _ _ Pm Q hQ
      have hcond : ∀ (n : ℕ) (v : Fin n → M), (∀ c : Fin n → K, Q n v c → ∀ i, c i = 0) ↔
          LinearIndependent K (fun i => Pm.mkQ (v i)) := by
        intro n v
        rw [Fintype.linearIndependent_iff]
        refine forall_congr' fun c => ?_
        have h1 : ∑ i, c i • Pm.mkQ (v i) = Pm.mkQ (∑ i, c i • v i) := by
          simp only [map_sum, map_smul]
        rw [h1, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hQ]
      have hle : ∀ (n : ℕ) (v : Fin n → (M ⧸ Pm)), LinearIndependent K v →
          (n : ℕ∞) ≤ Cardinal.toENat (Module.rank K (M ⧸ Pm)) := by
        intro n v hv
        have := hv.cardinal_lift_le_rank
        simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at this
        exact Cardinal.natCast_le_toENat.mpr this
      have hge : ∀ m : ℕ, (m : Cardinal) ≤ Module.rank K (M ⧸ Pm) →
          (m : ℕ∞) ≤ (⨆ (n : ℕ) (v : Fin n → M)
            (_ : ∀ c : Fin n → K, Q n v c → ∀ i, c i = 0), (n : ℕ∞)) := by
        intro m hm
        obtain ⟨s, hs, hli⟩ := le_rank_iff_exists_linearIndependent_finset.mp hm
        subst hs
        have hli' : LinearIndependent K (fun i : Fin s.card => ((s.equivFin.symm i : s) :
            M ⧸ Pm)) := hli.comp _ s.equivFin.symm.injective
        choose w hw using fun i : Fin s.card =>
          Submodule.mkQ_surjective Pm ((s.equivFin.symm i : s) : M ⧸ Pm)
        refine le_iSup_of_le s.card (le_iSup_of_le w (le_iSup_of_le ?_ le_rfl))
        rw [hcond]
        convert hli' using 1
        funext i
        exact hw i
      apply le_antisymm
      · exact iSup_le fun n => iSup_le fun v => iSup_le fun h => hle n _ ((hcond n v).mp h)
      · rcases lt_or_ge (Module.rank K (M ⧸ Pm)) Cardinal.aleph0 with h | h
        · obtain ⟨k, hk⟩ := Cardinal.lt_aleph0.mp h
          rw [hk, Cardinal.toENat_nat]
