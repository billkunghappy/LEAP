    intro C X _ f _ _ z₀ V hV hz 𝔭 h𝔭 hgen _ hκ hint

    have s4 : ∀ {Y Z : Scheme.{u}} (φ : Y ⟶ Z) (x : Y) (y : Z) (h : φ x = y) (U₁ : Z.Opens)
