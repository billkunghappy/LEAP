  have hrcl : IsClosed (⇑r ⁻¹' {x}) := hxcl.preimage r.continuous

  have hspec : ηL ⤳ (γ ≫ ι').fromNormalization
      (Limits.pullback.fst ((γ ≫ ι').fromNormalization ≫ r ≫ uX)
