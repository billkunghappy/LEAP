  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := hPb.2.2.2
  have hbc0 : b * c ≠ 0 := mul_ne_zero hb0 hc0
  have hbcm : b * c ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right c _ hbm
  have hσ₁u : σ₁ ≫ r₁ ≫ uX = 𝟙 _ := by rw [← Category.assoc, hσ₁, hP'b.1]

  have hIeq : σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b = σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX b := by
    apply le_antisymm
