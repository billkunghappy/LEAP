      IsAffineOpen Xs ∧
      (r''.appLE O Xs hXs).hom (O.topIso.hom.hom (m.appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)))) =
