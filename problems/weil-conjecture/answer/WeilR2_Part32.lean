    obtain ⟨b₁, b₂, hb₂, hb⟩ := IsFractionRing.div_surjective (A := ↑Γ(C, γ ⁻¹ᵁ V₀)) ℓ
    have halg : ∀ b, algebraMap ↑Γ(C, γ ⁻¹ᵁ V₀) ↑C.functionField b =
        (C.presheaf.germ (γ ⁻¹ᵁ V₀) (genericPoint C) hηV₁).hom b := fun b => rfl
