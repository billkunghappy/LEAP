    ∀ (Zt : Scheme.{u}) (ν : Zt ⟶ wcpaDjLkFib W (γ ≫ ι) uX) (ct : ℤ), wcGcNormDatum ν →
      wcGcChi (IsLocalRing.ResidueField ↥W) (ν ≫ wcGcFibStr W (γ ≫ ι) uX) ct →
    ∀ (Zt' : Scheme.{u}) (ν' : Zt' ⟶ wcpaDjLkFib W (γ ≫ ι') (r ≫ uX)) (ct' : ℤ),
      wcGcNormDatum ν' →
      wcGcChi (IsLocalRing.ResidueField ↥W) (ν' ≫ wcGcFibStr W (γ ≫ ι') (r ≫ uX)) ct' →
      ct + ((wcpaDjEbcExc W (γ ≫ ι') (r ≫ uX) r (wcpaDjLkImg W (γ ≫ ι) uX y₀)).ncard : ℤ) ≤ ct' :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y₀ hSm σ' a' hpair X' r ι' _ _ hbl hι' hM' V hV
    hiso hR Zt ν ct hND hχ Zt' ν' ct' hND' hχ'
  classical
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W

  have t0 : ∀ {Y : Scheme.{u}} (a b : ↥Y), closure ({a} : Set ↥Y) = closure {b} → a = b :=
