        ψ.appLE (wcSgD K M C) W hC (wcSgE K M C B) * ψ.appLE (wcSgD K M B) W hB (wcSgE K M B A) := by
    intro A B C W hB hC
    have hMle : W ≤ ψ ⁻¹ᵁ (wcSgD K M C ⊓ wcSgD K M B) := by
      rw [Scheme.Hom.preimage_inf]
      exact le_inf hC hB
    have K1 : ∀ x, ψ.appLE (wcSgD K M C) W hC x = ψ.appLE _ W hMle
        ((wcProjK K M).presheaf.map
          (homOfLE (inf_le_left : wcSgD K M C ⊓ wcSgD K M B ≤ wcSgD K M C)).op x) := by
      intro x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    have K2 : ∀ x, ψ.appLE (wcSgD K M B) W hB x = ψ.appLE _ W hMle
        ((wcProjK K M).presheaf.map
          (homOfLE (inf_le_right : wcSgD K M C ⊓ wcSgD K M B ≤ wcSgD K M B)).op x) := by
      intro x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    rw [K1 (wcSgE K M C A), K1 (wcSgE K M C B), K2 (wcSgE K M B A), (HSM C B A).2.2, map_mul]

  have hscal_gen : ∀ {n : ℕ} (φ : X ⟶ wcProjK K n) (V W : X.Opens) (h : W ≤ V) (c : K),
      X.presheaf.map (homOfLE h).op (wcEszScal φ V c) = wcEszScal φ W c := by
    intro n φ V W h c
    show X.presheaf.map (homOfLE h).op (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op
