  have hcomm : ∀ (a : C ≅ C), a.hom ≫ γ = γ →
      ∀ r : ↥((wcProjK Ω 1).presheaf.stalk (genericPoint (wcProjK Ω 1))),
      wcpaDjGslTr a.hom (genericPoint C) (genericPoint C) (hfixη a)
