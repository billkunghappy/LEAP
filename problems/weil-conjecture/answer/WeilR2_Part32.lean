    haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by haveI := hdom x; infer_instance
    haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
    haveI : AlgebraicGeometry.IsReduced D.toScheme := isReduced_of_isOpenImmersion D.ι
    haveI : IrreducibleSpace D.toScheme := Subtype.irreducibleSpace hC.1
    exact isIntegral_of_irreducibleSpace_of_isReduced _
  have s_push : ∀ (X Y S : Scheme.{u}) (sX : X ⟶ S) (sY : Y ⟶ S) (D W : X.Opens) (g : W.toScheme ⟶ Y) (VD : D.toScheme.Opens) (hD : VD.toScheme ⟶ Y) (hDs : hD ≫ sY = VD.ι ≫ D.ι ≫ sX) (hres : D.toScheme.homOfLE (inf_le_left : VD ⊓ D.ι ⁻¹ᵁ W ≤ VD) ≫ hD = D.toScheme.homOfLE (inf_le_right : VD ⊓ D.ι ⁻¹ᵁ W ≤ D.ι ⁻¹ᵁ W) ≫ (D.ι ∣_ W) ≫ g), ∃ (V : X.Opens), (∀ x : D.toScheme, x ∈ VD → D.ι x ∈ V) ∧ ∃ h : V.toScheme ⟶ Y, h ≫ sY = V.ι ≫ sX ∧ X.homOfLE (inf_le_left : V ⊓ W ≤ V) ≫ h = X.homOfLE (inf_le_right : V ⊓ W ≤ W) ≫ g := by
    intro X Y S sX sY D W g VD hD hDs hres
    refine ⟨D.ι ''ᵁ VD, fun x hx => ?_, (D.ι.isoImage VD).inv ≫ hD, ?_, ?_⟩
    · rw [← SetLike.mem_coe, Scheme.Hom.coe_image]; exact ⟨x, hx, rfl⟩
    · rw [Category.assoc, hDs, ← Scheme.Hom.isoImage_inv_ι D.ι VD]
