theorem wcpa_dj_lr1u_cc_rational_point : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsAlgClosed (IsLocalRing.ResidueField R)] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) [LocallyOfFiniteType uX] (x : X), uX x = IsLocalRing.closedPoint R → IsClosed ({x} : Set X) → ∀ (U : X.Opens) (hU : IsAffineOpen U) (hxU : x ∈ U), (∀ c : R, (uX.appLE ⊤ U le_top).hom ((Scheme.ΓSpecIso (.of R)).inv.hom c) ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal ↔ c ∈ IsLocalRing.maximalIdeal R) ∧ ∀ b : Γ(X, U), ∃ c : R, b - (uX.appLE ⊤ U le_top).hom ((Scheme.ΓSpecIso (.of R)).inv.hom c) ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
by
  intro R _ _ _ X uX _ x hux hxcl U hU hxU
  have hT := isAffineOpen_top (Spec (.of R))
  have hsq := IsAffineOpen.SpecMap_appLE_fromSpec uX hT hU le_top
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at hsq
  have hpt : uX x = Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ uX.appLE ⊤ U le_top)
      (hU.primeIdealOf ⟨x, hxU⟩) := by
    have e : (hU.fromSpec ≫ uX) (hU.primeIdealOf ⟨x, hxU⟩) = uX x :=
      (Scheme.Hom.comp_apply _ _ _).trans (congrArg uX (hU.fromSpec_primeIdealOf _))
    rw [hsq]; exact e.symm
  have ha : ∀ c : R, (uX.appLE ⊤ U le_top).hom ((Scheme.ΓSpecIso (.of R)).inv.hom c) ∈
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal ↔ c ∈ IsLocalRing.maximalIdeal R := by
    intro c
    have h2 := congrArg PrimeSpectrum.asIdeal (hux.symm.trans hpt)
    have h3 : c ∈ (IsLocalRing.closedPoint R).asIdeal ↔ c ∈ (Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫
        uX.appLE ⊤ U le_top) (hU.primeIdealOf ⟨x, hxU⟩)).asIdeal := by rw [h2]
    exact h3.symm
  refine ⟨ha, ?_⟩
  set ρ : R →+* Γ(X, U) := (uX.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom
    with hρ
  set P := (hU.primeIdealOf ⟨x, hxU⟩).asIdeal with hP
  haveI hmax : P.IsMaximal := hU.primeIdealOf_isMaximal_of_isClosed ⟨x, hxU⟩ hxcl
  have hft1 : (uX.appLE ⊤ U le_top).hom.FiniteType :=
    LocallyOfFiniteType.finiteType_appLE uX hT hU le_top
  have hsurj : Function.Surjective (Scheme.ΓSpecIso (.of R)).inv.hom := by
    intro y
    refine ⟨(Scheme.ΓSpecIso (.of R)).hom.hom y, ?_⟩
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
  have hft2 : ρ.FiniteType := hft1.comp (RingHom.FiniteType.of_surjective _ hsurj)
  letI : Field (Γ(X, U) ⧸ P) := Ideal.Quotient.field P
  have hf : ((Ideal.Quotient.mk P).comp ρ).FiniteType :=
    (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective).comp hft2
  have hker : ∀ c ∈ IsLocalRing.maximalIdeal R, (Ideal.Quotient.mk P).comp ρ c = 0 :=
    fun c hc => Ideal.Quotient.eq_zero_iff_mem.mpr ((ha c).mpr hc)
  let ι : IsLocalRing.ResidueField R →+* Γ(X, U) ⧸ P :=
    Ideal.Quotient.lift _ ((Ideal.Quotient.mk P).comp ρ) hker
  have hιf : ι.comp (IsLocalRing.residue R) = (Ideal.Quotient.mk P).comp ρ := by
    ext c
    rfl
  have hι : ι.FiniteType := by
    rw [← hιf] at hf
    exact RingHom.FiniteType.of_comp_finiteType hf
  letI := ι.toAlgebra
  haveI : Algebra.FiniteType (IsLocalRing.ResidueField R) (Γ(X, U) ⧸ P) := hι
  haveI : Module.Finite (IsLocalRing.ResidueField R) (Γ(X, U) ⧸ P) :=
    finite_of_finite_type_of_isJacobsonRing (IsLocalRing.ResidueField R) (Γ(X, U) ⧸ P)
  haveI : Algebra.IsIntegral (IsLocalRing.ResidueField R) (Γ(X, U) ⧸ P) :=
    Algebra.IsIntegral.of_finite (IsLocalRing.ResidueField R) (Γ(X, U) ⧸ P)
  have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral
    (k := IsLocalRing.ResidueField R) (K := Γ(X, U) ⧸ P)
  intro b
  obtain ⟨t, ht⟩ := hbij.2 (Ideal.Quotient.mk P b)
  obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective t
  refine ⟨c, ?_⟩
  have h1 : Ideal.Quotient.mk P (ρ c) = Ideal.Quotient.mk P b := ht
  exact Ideal.Quotient.eq.mp h1.symm

theorem wcpa_dj_lr1u_fn_tbv_gen_inv : ∀ (Ω K : Type u) [Field Ω] [Field K] (c : Ω →+* K) (g : K), g ≠ 0 → (∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ c g ≠ 0 ∧ f * q.eval₂ c g = p.eval₂ c g) → ∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ c g⁻¹ ≠ 0 ∧ f * q.eval₂ c g⁻¹ = p.eval₂ c g⁻¹ :=
by
  intro Ω K _ _ c g hg hgen f
  obtain ⟨p, q, hq, hfpq⟩ := hgen f
  letI : Invertible g := invertibleOfNonzero hg
  set N := max p.natDegree q.natDegree with hN
  have Hp : (Polynomial.reflect N p).eval₂ c g⁻¹ * g ^ N = p.eval₂ c g := by
    rw [← invOf_eq_inv g]
    exact Polynomial.eval₂_reflect_mul_pow c g N p (le_max_left _ _)
  have Hq : (Polynomial.reflect N q).eval₂ c g⁻¹ * g ^ N = q.eval₂ c g := by
    rw [← invOf_eq_inv g]
    exact Polynomial.eval₂_reflect_mul_pow c g N q (le_max_right _ _)
  have hgN : g ^ N ≠ 0 := pow_ne_zero N hg
  refine ⟨Polynomial.reflect N p, Polynomial.reflect N q, ?_, ?_⟩
  · intro h0
    apply hq
    rw [← Hq, h0, zero_mul]
  · apply mul_right_cancel₀ hgN
    rw [mul_assoc, Hq, hfpq, Hp]

theorem wcpa_dj_lr1u_fn_tbv_taylor_split : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (p : Polynomial R) (w₀ : R), (∃ i, IsUnit (p.coeff i)) → ∃ (m : ℕ) (P₁ Q : Polynomial R), p = (Polynomial.X - Polynomial.C w₀) ^ m * P₁ + Q ∧ IsUnit (P₁.eval w₀) ∧ ∀ i, Q.coeff i ∈ IsLocalRing.maximalIdeal R :=
by
  intro R _ _ p w₀ hunit
  classical
  have hpb0 : Polynomial.map (IsLocalRing.residue R) p ≠ 0 := by
    obtain ⟨i, hi⟩ := hunit
    intro h
    have h1 : (Polynomial.map (IsLocalRing.residue R) p).coeff i = 0 := by
      rw [h, Polynomial.coeff_zero]
    rw [Polynomial.coeff_map] at h1
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hi h1
  have hfac := Polynomial.pow_mul_divByMonic_rootMultiplicity_eq
    (Polynomial.map (IsLocalRing.residue R) p) (IsLocalRing.residue R w₀)
