        (B := K)).toRingHom
    have hι : ∀ k, ι k = (1 : MvPolynomial (Fin 2) R₀ ⧸ I) ⊗ₜ[R₀] k := fun k => rfl
    have hCk : ∀ (r : R₀) (k : K),
        Ideal.Quotient.mk I (MvPolynomial.C r) ⊗ₜ[R₀] k = ι (algebraMap R₀ K r * k) := by
      intro r k
      have e1 : Ideal.Quotient.mk I (MvPolynomial.C r) = r • (1 : MvPolynomial (Fin 2) R₀ ⧸ I) := by
        rw [← Algebra.algebraMap_eq_smul_one, IsScalarTower.algebraMap_apply R₀
          (MvPolynomial (Fin 2) R₀) (MvPolynomial (Fin 2) R₀ ⧸ I), Ideal.Quotient.algebraMap_eq,
