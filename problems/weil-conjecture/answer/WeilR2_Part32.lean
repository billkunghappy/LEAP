    rw [← e1]
    exact e2
  obtain ⟨fD, hfD⟩ : ∃ fD : Localization.Away (⟨g, hgB⟩ : ↥B₁) →ₐ[Polynomial ↥W]
      Localization.Away g, ∀ x, fD x = j x :=
    ⟨{ j.toRingHom with commutes' := fun _ => rfl }, fun _ => rfl⟩
  obtain ⟨fQ, hfQ⟩ : ∃ fQ : ↥Q →ₐ[Polynomial ↥W] Localization.Away g,
      ∀ q, fQ q = evA (q : Polynomial Ω) :=
    ⟨{ (evA.toRingHom.comp Q.val.toRingHom) with
      commutes' := fun p => by
        show evA ((algebraMap (Polynomial ↥W) ↥Q p : ↥Q) : Polynomial Ω) =
          j (algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) p)
        rw [hQev]
