  have repr : ∀ (a : Fin (N + 1)) (s : Γ(wcProjK K N, wcSgD K N a)), ∃ (m : ℕ)
      (P : MvPolynomial (Fin (N + 1)) K)
      (hP : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (m • 1)),
      s = (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a)).hom (HomogeneousLocalization.Away.mk
