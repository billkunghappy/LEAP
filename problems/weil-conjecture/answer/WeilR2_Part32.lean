  have hU₀ : genericPoint C ∈ γ ⁻¹ᵁ V₀ := hgen.mem_open V₀.isOpen hηV₀
  have hU₀a : IsAffineOpen (γ ⁻¹ᵁ V₀) := hV₀a.preimage γ
  haveI : Nonempty V₀ := ⟨⟨_, hηV₀⟩⟩
  haveI : Nonempty (γ ⁻¹ᵁ V₀) := ⟨⟨_, hU₀⟩⟩
  haveI : IsIntegrallyClosed Γ(wcProjK Ω 1, V₀) :=
    wc_fsus_affine_sections_intclosed (wcProjK Ω 1) hPnorm V₀ hV₀a inferInstance
  haveI : IsIntegrallyClosed Γ(C, γ ⁻¹ᵁ V₀) :=
    wc_fsus_affine_sections_intclosed C (fun x => (hCst x).2) _ hU₀a inferInstance
  haveI : IsProper (wcProjKStr Ω 1) := wc_proj_space_isProper Ω 1
  have hfa := HasRingHomProperty.appLE @LocallyOfFiniteType (wcProjKStr Ω 1) inferInstance
    ⟨⊤, isAffineOpen_top _⟩ ⟨V₀, hV₀a⟩ le_top
  have hinv : ((Scheme.ΓSpecIso (.of Ω)).inv).hom.FiniteType :=
    RingHom.FiniteType.of_surjective _ (by
      intro x
      refine ⟨(Scheme.ΓSpecIso (.of Ω)).hom x, ?_⟩
      simp)
  letI : Algebra Ω Γ(wcProjK Ω 1, V₀) :=
    ((Scheme.ΓSpecIso (.of Ω)).inv ≫ (wcProjKStr Ω 1).appLE ⊤ V₀ le_top).hom.toAlgebra
  haveI : Algebra.FiniteType Ω Γ(wcProjK Ω 1, V₀) := by
    have : ((Scheme.ΓSpecIso (.of Ω)).inv ≫ (wcProjKStr Ω 1).appLE ⊤ V₀ le_top).hom.FiniteType := by
      rw [CommRingCat.hom_comp]
      exact hfa.comp hinv
    exact this
  letI : Algebra Γ(wcProjK Ω 1, V₀) Γ(C, γ ⁻¹ᵁ V₀) := (γ.app V₀).hom.toAlgebra
  haveI : Algebra.IsIntegral Γ(wcProjK Ω 1, V₀) Γ(C, γ ⁻¹ᵁ V₀) :=
    ⟨IsIntegralHom.isIntegral_app γ V₀ hV₀a⟩
  haveI : IsFractionRing Γ(wcProjK Ω 1, V₀) (wcProjK Ω 1).functionField :=
    functionField_isFractionRing_of_isAffineOpen _ V₀ hV₀a
  haveI : IsFractionRing Γ(C, γ ⁻¹ᵁ V₀) C.functionField :=
    functionField_isFractionRing_of_isAffineOpen _ _ hU₀a
  letI : Algebra Γ(wcProjK Ω 1, V₀) C.functionField :=
    ((algebraMap Γ(C, γ ⁻¹ᵁ V₀) C.functionField).comp
      (algebraMap Γ(wcProjK Ω 1, V₀) Γ(C, γ ⁻¹ᵁ V₀))).toAlgebra
  haveI : IsScalarTower Γ(wcProjK Ω 1, V₀) Γ(C, γ ⁻¹ᵁ V₀) C.functionField :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower Γ(wcProjK Ω 1, V₀) (wcProjK Ω 1).functionField C.functionField :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      have := congrArg (fun f => f.hom x) (hcompat V₀ hηV₀ hU₀)
      exact this.symm)
  obtain ⟨m, -, Q', hQ'inj, hQ'⟩ := hcount Ω Γ(wcProjK Ω 1, V₀) Γ(C, γ ⁻¹ᵁ V₀)
