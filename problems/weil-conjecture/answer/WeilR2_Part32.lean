theorem wcpa_dj_lr1k_ebc_dsc_zmt_rep : ∀ (Ω K B O : Type u) [Field Ω] [Field K] [CommRing B] [CommRing O] [IsLocalRing O] (W : ValuationSubring Ω) (φ : Ω →+* K) (t : K) (σ : ↥W →+* B) (b₀ : B) (β : B →+* K) (ℓ : B →+* O) (G : O →+* K) (P : Ideal B) [P.IsPrime], (∀ p : Polynomial Ω, p.eval₂ φ t = 0 → p = 0) → (∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ φ t ≠ 0 ∧ f * q.eval₂ φ t = p.eval₂ φ t) → σ.FiniteType → Function.Injective ⇑β → β.comp σ = φ.comp W.subtype → β b₀ = t → G.comp ℓ = β → (∀ c : O, ∃ b u : B, u ∉ P ∧ c * ℓ u = ℓ b) → (∀ b : B, ℓ b ∈ IsLocalRing.maximalIdeal O ↔ b ∈ P) → (∀ c ∈ IsLocalRing.maximalIdeal ↥W, σ c ∈ P) → b₀ ∈ P → (∃ g : B, g ∉ P ∧ ∀ Q : Ideal B, Q.IsPrime → (∀ c ∈ IsLocalRing.maximalIdeal ↥W, σ c ∈ Q) → b₀ ∈ Q → g ∉ Q → Q = P) → ∀ c : O, ∃ p q : Polynomial ↥W, IsUnit (q.coeff 0) ∧ (c ∈ IsLocalRing.maximalIdeal O → p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W) ∧ G c * q.eval₂ (φ.comp W.subtype) t = p.eval₂ (φ.comp W.subtype) t :=
