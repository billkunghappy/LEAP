      rw [Category.assoc, hcomm]
      exact Q1.w
    let h := Limits.pullback.lift ((fst ∣_ V) ≫ mN) (O.ι ≫ snd) w
    have hfst : h ≫ Limits.pullback.fst str s₀ = (fst ∣_ V) ≫ mN := Limits.pullback.lift_fst _ _ _
    have hsnd : h ≫ Limits.pullback.snd str s₀ = O.ι ≫ snd := Limits.pullback.lift_snd _ _ _
    have Q3 : IsPullback (fst ∣_ V) h mN (Limits.pullback.fst str s₀) := by
