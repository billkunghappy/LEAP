    (hU.primeIdealOf ⟨a, haU⟩).asIdeal.primeCompl y
  have hspec := IsLocalization.mk'_spec' (A.presheaf.stalk a) s t
  have hunit := IsLocalization.map_units (A.presheaf.stalk a) t
  have hg : ∀ x, algebraMap Γ(A, h ⁻¹ᵁ V) (A.presheaf.stalk a) x =
      (A.presheaf.germ (h ⁻¹ᵁ V) a haU).hom x := fun x => rfl
  rw [hg, hg] at hspec
  rw [hg] at hunit
  show IsAlgebraic _ (IsLocalization.mk' (A.presheaf.stalk a) s t)
  refine IsAlgebraic.of_mul (IsUnit.mem_nonZeroDivisors hunit) (hgerm _).isAlgebraic ?_
