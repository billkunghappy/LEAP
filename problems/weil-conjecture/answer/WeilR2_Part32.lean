          γ.stalkMap (genericPoint C) ≫ C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
            a.1.hom.stalkMap (genericPoint C)
        = ((wcProjK Ω 1).presheaf.germ U _ hU ≫ (wcProjK Ω 1).presheaf.stalkSpecializes hgen ≫
          γ.stalkMap (genericPoint C)) ≫ C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
            a.1.hom.stalkMap (genericPoint C) := by simp only [Category.assoc]
      _ = γ.app U ≫ (C.presheaf.germ (γ ⁻¹ᵁ U) _ hU' ≫
            C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
            a.1.hom.stalkMap (genericPoint C)) := by rw [e1, Category.assoc]
      _ = (γ.app U ≫ a.1.hom.appLE (γ ⁻¹ᵁ U) (γ ⁻¹ᵁ U)
            (by rw [← Scheme.Hom.comp_preimage, a.2])) ≫ C.presheaf.germ (γ ⁻¹ᵁ U) _ hU' := by
