            (algebraMap (Polynomial R) κ (algebraMap R (Polynomial R) r))
        rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, AlgHom.commutes,
          ← IsScalarTower.algebraMap_apply]
      · show Algebra.TensorProduct.includeRight (algebraMap (Polynomial R) Q Polynomial.X) =
          algebraMap κ (TensorProduct R κ Q) (Polynomial.eval₂ (algebraMap R κ) 0 Polynomial.X)
        rw [Polynomial.eval₂_X, map_zero, Algebra.TensorProduct.includeRight_apply, hX0]
    intro p
