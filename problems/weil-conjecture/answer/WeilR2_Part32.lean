  · exact Or.inl (hl0 rfl)
  · exact Or.inr (hl1 rfl)

theorem wcpa_dj_lr1k_odfgl_bs_overlap : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W), c ≠ 0 → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)]))) r₀ → ∀ (c₀ : Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})) ⟶ M') (c₁ : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ M'), c₀ ≫ r₀ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp MvPolynomial.C) (fun _ : Fin 1 => Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 0)))) → c₁ ≫ r₀ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0))) → ∀ q : ↥(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 1) ∉ q.asIdeal → c₀ q ∈ Set.range c₁ :=
by
  intro Ω _ W c hc0 M' r₀ hr₀
  classical

  have invpull : ∀ {X T : Scheme.{u}} [IsAffine X] [IsAffine T] {ι : Type} [Finite ι]
      (g : ι → Γ(X, ⊤)) (h : T ⟶ X) (l : ι) (τ : ι → Γ(T, ⊤)),
      (∀ j, h.appTop.hom (g j) = τ j * h.appTop.hom (g l)) →
      h.appTop.hom (g l) ∈ nonZeroDivisors Γ(T, ⊤) →
      wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))) h := by
    intro X T _ _ ι _ g h l τ H1 H2
    let UX : X.affineOpens := ⟨⊤, by exact isAffineOpen_top X⟩
    let UT : T.affineOpens := ⟨⊤, by exact isAffineOpen_top T⟩
    have hVU : (UT : T.Opens) ≤ h ⁻¹ᵁ (UX : X.Opens) := le_of_eq rfl
    have hI : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))).ideal UX =
        Ideal.span (Set.range g) := by
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]
      have e : ∀ e' : (UX : X.Opens) ≤ ⊤, X.presheaf.map (homOfLE e').op = 𝟙 _ := by
        intro e'
        rw [show homOfLE e' = 𝟙 _ from Subsingleton.elim _ _]
        exact X.presheaf.map_id _
      rw [e]
      exact Ideal.map_id _
    have hA : h.appLE (UX : X.Opens) (UT : T.Opens) hVU = h.appTop := by
      have e : T.presheaf.map (homOfLE hVU).op = 𝟙 _ := by
        rw [show homOfLE hVU = 𝟙 _ from Subsingleton.elim _ _]
        exact T.presheaf.map_id _
      rw [Scheme.Hom.appLE, e]
      exact Category.comp_id _
    intro t
    refine ⟨UX, UT, hVU, g l, trivial, ?_, ?_, ?_⟩
    · rw [hI]
      exact Ideal.subset_span ⟨l, rfl⟩
    · rw [hA]
      exact H2
    · rw [hI, hA, Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro y ⟨x, ⟨j, rfl⟩, rfl⟩
        rw [SetLike.mem_coe, H1 j]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      · rw [Ideal.span_singleton_le_iff_mem]
        exact Ideal.subset_span ⟨g l, ⟨l, rfl⟩, rfl⟩
  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} with hIdef
  intro c₀ c₁ hc₀r hc₁r q hq
  set θ₀ : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 2) ↥W ⧸ I :=
    MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
      (fun _ : Fin 1 => Ideal.Quotient.mk I (MvPolynomial.X 0)) with hθ₀
  set θ₁ : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 1) ↥W :=
    MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0)
    with hθ₁
  have hθC : ∀ w : ↥W, θ₀ (MvPolynomial.C w) = Ideal.Quotient.mk I (MvPolynomial.C w) :=
    fun w => by simp [θ₀]
  have hθX : θ₀ (MvPolynomial.X 0) = Ideal.Quotient.mk I (MvPolynomial.X 0) := by simp [θ₀]
  have hθ₁C : ∀ w : ↥W, θ₁ (MvPolynomial.C w) = MvPolynomial.C w :=
    fun w => MvPolynomial.eval₂Hom_C _ _ _
  have hθ₁X : θ₁ (MvPolynomial.X 0) = MvPolynomial.C c * MvPolynomial.X 0 := by
    rw [hθ₁, MvPolynomial.eval₂Hom_X']
  have hAB : Ideal.Quotient.mk I (MvPolynomial.X 0) * Ideal.Quotient.mk I (MvPolynomial.X 1) =
      Ideal.Quotient.mk I (MvPolynomial.C c) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl

  have hAnzd : ∀ y : MvPolynomial (Fin 2) ↥W ⧸ I,
      y * Ideal.Quotient.mk I (MvPolynomial.X 0) = 0 → y = 0 := by
    intro y hy
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨σ₀, hσ0, hσ1, hσC⟩ : ∃ σ₀ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W,
        σ₀ (MvPolynomial.X 0) = 0 ∧ σ₀ (MvPolynomial.X 1) = MvPolynomial.X 1 ∧
        ∀ r, σ₀ (MvPolynomial.C r) = MvPolynomial.C r :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 1], by simp, by simp, by simp⟩
    have hdvd : ∀ f : MvPolynomial (Fin 2) ↥W, MvPolynomial.X 0 ∣ f - σ₀ f := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C r => rw [hσC, sub_self]; exact dvd_zero _
      | add f g hf hg => rw [map_add, add_sub_add_comm]; exact dvd_add hf hg
      | mul_X f n hf =>
        rw [map_mul]
        have e : f * MvPolynomial.X n - σ₀ f * σ₀ (MvPolynomial.X n) =
            (f - σ₀ f) * MvPolynomial.X n + σ₀ f * (MvPolynomial.X n - σ₀ (MvPolynomial.X n)) := by
          ring
        rw [e]
        refine dvd_add (dvd_mul_of_dvd_left hf _) (dvd_mul_of_dvd_right ?_ _)
        fin_cases n
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 0 - σ₀ (MvPolynomial.X 0)
          rw [hσ0, sub_zero]
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 1 - σ₀ (MvPolynomial.X 1)
          rw [hσ1, sub_self]; exact dvd_zero _
    have hσg : σ₀ g = 0 := by
      have h1 := congrArg σ₀ hg
      simp only [map_mul, map_sub, hσ0, hσ1, hσC] at h1
      have h2 : σ₀ g * MvPolynomial.C c = 0 := by linear_combination -h1
      exact (mul_eq_zero.mp h2).resolve_right (fun hc' => hc0 (MvPolynomial.C_eq_zero.mp hc'))
    obtain ⟨g', hg'⟩ := hdvd g
    rw [hσg, sub_zero] at hg'
    have hp : p * MvPolynomial.X 0 =
        (g' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c)) * MvPolynomial.X 0 := by
      rw [← hg, hg']; ring
    have hp' := mul_right_cancel₀ (MvPolynomial.X_ne_zero 0) hp
    rw [Ideal.Quotient.eq_zero_iff_mem, hp']
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

  obtain ⟨L, iL, iA, iLoc⟩ : ∃ (L : Type u) (_ : CommRing L)
      (_ : Algebra (MvPolynomial (Fin 2) ↥W ⧸ I) L),
      IsLocalization.Away (Ideal.Quotient.mk I (MvPolynomial.X 1)) L :=
    ⟨Localization.Away (Ideal.Quotient.mk I (MvPolynomial.X 1)), inferInstance, inferInstance,
      inferInstance⟩
  obtain ⟨lam, hlam⟩ : ∃ lam : MvPolynomial (Fin 2) ↥W ⧸ I →+* L,
      lam = @algebraMap (MvPolynomial (Fin 2) ↥W ⧸ I) L _ _ iA := ⟨_, rfl⟩
  have hu1 : IsUnit (lam (Ideal.Quotient.mk I (MvPolynomial.X 1))) := by
    rw [hlam]; exact IsLocalization.Away.algebraMap_isUnit _
  obtain ⟨ι, hsinv⟩ : ∃ ι : L, lam (Ideal.Quotient.mk I (MvPolynomial.X 1)) * ι = 1 :=
    ⟨_, by rw [hlam]; exact IsLocalization.Away.mul_invSelf _⟩
  have hlx0 : ∀ z : L, z * lam (Ideal.Quotient.mk I (MvPolynomial.X 0)) = 0 → z = 0 := by
    intro z hz
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj
      (Submonoid.powers (Ideal.Quotient.mk I (MvPolynomial.X 1))) z
    have hs' : z * lam (s : MvPolynomial (Fin 2) ↥W ⧸ I) = lam a := by rw [hlam]; exact hs
    have h1 : lam (a * Ideal.Quotient.mk I (MvPolynomial.X 0)) = 0 := by
      rw [map_mul, ← hs', mul_right_comm, hz, zero_mul]
    rw [hlam] at h1
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff
      (Submonoid.powers (Ideal.Quotient.mk I (MvPolynomial.X 1))) L _).mp h1
    have h2 : (m : MvPolynomial (Fin 2) ↥W ⧸ I) * a = 0 :=
      hAnzd _ (by rw [mul_assoc]; exact hm)
