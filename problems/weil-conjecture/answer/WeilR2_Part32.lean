      have hHm : Polynomial.aeval a H ∈ 𝔮 := by
        have : Polynomial.aeval a G * Polynomial.aeval a H ∈ 𝔮 := by rw [hFa]; exact 𝔮.zero_mem
        exact (h𝔮.mem_or_mem this).resolve_left hGn
