  haveI : IsProper (wcProjKStr K N) := wc_proj_space_isProper K N
  haveI : IsProper (wcProjKStr K M) := wc_proj_space_isProper K M
  haveI : IsProper (b ≫ wcProjKStr K N) := inferInstance
  have haffU : ∀ l, IsAffineOpen (b ⁻¹ᵁ wcSgD K N l) := fun l => (haffN l).preimage b
  have hci := wcpa_dj_gsfp_closed_imm K M (b ≫ wcProjKStr K N) ψ
    (fun l => b ⁻¹ᵁ wcSgD K N l) J0 hψ inferInstance (wcpa_dj_gsfp_chart_facts K M).1
    hover hU hpre haffU hsurj

  obtain ⟨-, HSM⟩ := wcpa_dj_gsfp_chart_facts K M
  have hQ1 : ∀ (A : Fin (M + 1)) (W : X.Opens) (hW : W ≤ ψ ⁻¹ᵁ wcSgD K M A),
      ψ.appLE (wcSgD K M A) W hW (wcSgE K M A A) = 1 := by
    intro A W hW
    rw [(HSM A A A).1, map_one]
  have hQ2 : ∀ (A B C : Fin (M + 1)) (W : X.Opens) (hB : W ≤ ψ ⁻¹ᵁ wcSgD K M B)
      (hC : W ≤ ψ ⁻¹ᵁ wcSgD K M C),
