  have hcomp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), (⇑(f ≫ g) : X → Z) = ⇑g ∘ ⇑f :=
    fun f g => funext fun x => Scheme.Hom.comp_apply f g x

  have c4 : ∀ {Y Z : Scheme.{u}} (ν : Y ⟶ Z) (U : Z.Opens), IsIso (ν ∣_ U) → ∀ G : Set ↥Y,
