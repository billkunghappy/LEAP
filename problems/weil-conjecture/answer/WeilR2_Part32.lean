    have h1 := (IsPreimmersion.isEmbedding (Zt.fromSpecStalk p)).isInducing.topologicalKrullDim_le
    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    exact h1

  have hnf : ¬ IsField ↥(Zt.presheaf.stalk p) := by
    intro hF
    obtain ⟨D, hD, hpD⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {p} isIrreducible_singleton
    have hpD' : p ∈ D := hpD (Set.mem_singleton p)
    have hirr : IsIrreducible D := hD.1
    have hη : IsGenericPoint hirr.genericPoint D := by
      have := hirr.isGenericPoint_genericPoint_closure
      rwa [(isClosed_of_mem_irreducibleComponents D hD).closure_eq] at this
    have hηr : hirr.genericPoint ∈ Set.range (Zt.fromSpecStalk p) := by
      rw [Scheme.range_fromSpecStalk]; exact hη.specializes hpD'
    obtain ⟨q, hq⟩ := hηr
    have hqc : q = IsLocalRing.closedPoint ↥(Zt.presheaf.stalk p) := by
      have hm := IsLocalRing.isField_iff_maximalIdeal_eq.mp hF
      have h1 : q.asIdeal ≤ IsLocalRing.maximalIdeal ↥(Zt.presheaf.stalk p) :=
