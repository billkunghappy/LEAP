  choose g hg using hcomp
  have hCIi : ∀ i, IsClosedImmersion (O i).ι := fun i =>
    (hfacts (O i) (by rw [hO i]; exact (E i).2)).1

  have key : ∀ (N : ℕ) (ψ : T ⟶ wcProjK κ N), IsClosedImmersion ψ → ψ ≫ wcProjKStr κ N = s →
      ∀ (d e₀ : ℕ) (c : ℤ), (∀ e : ℕ, e₀ ≤ e → (wcGcHilb ψ e : ℤ) = (d : ℤ) * (e : ℤ) + c) →
