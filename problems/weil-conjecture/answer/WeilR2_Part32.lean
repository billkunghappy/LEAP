    · obtain ⟨u, hu, w, hw⟩ := hy ⟨z, hz'⟩ hT'
      refine c1 _ (V z) (Z.basicOpen (f ⟨z, hz'⟩)) (hV z) (hf ⟨z, hz'⟩) z (hzf ⟨z, hz'⟩) _
        (u * f ⟨z, hz'⟩ ^ k ⟨z, hz'⟩) w ?_ ?_
