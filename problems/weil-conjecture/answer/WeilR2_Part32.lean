      zero_mem' := ⟨0, 1, by simp, by simp⟩
      neg_mem' := by
        rintro f ⟨p, q, hq, h⟩
        exact ⟨-p, q, hq, by rw [Polynomial.eval₂_neg, ← h]; ring⟩ }
  have memS : ∀ f : K, f ∈ S ↔ ∃ p q : Polynomial A, q.map (IsLocalRing.residue A) ≠ 0 ∧
      f * q.eval₂ φ g = p.eval₂ φ g := fun f => Iff.rfl
  have unitS : ∀ (f : K) (p q : Polynomial A), q.map (IsLocalRing.residue A) ≠ 0 →
      f * q.eval₂ φ g = p.eval₂ φ g → p.map (IsLocalRing.residue A) ≠ 0 →
      ∀ hf : f ∈ S, IsUnit (⟨f, hf⟩ : S) := by
    intro f p q hq h hp hf
    have hpg := hnv p hp
    have hf0 : f ≠ 0 := by
      rintro rfl
      rw [zero_mul] at h
