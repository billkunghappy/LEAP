  intro R _ κ _ _ _ D _ _ _ _ hD Q _ _ _ _ k ψ hψ
  classical

  have c1 : ∀ (E : Type u) [CommRing E] [Algebra κ E], Algebra.Etale κ E →
      ∃ r : ℕ, Nonempty (E ≃ₐ[κ] (Fin r → κ)) := by
    intro E _ _ hE
    obtain ⟨I, hI, Ai, iF, iA, e, hfin⟩ := (Algebra.Etale.iff_exists_algEquiv_prod κ E).mp hE
    have hb : ∀ i, Function.Bijective (algebraMap κ (Ai i)) := fun i => by
      have := (hfin i).1
      have : Algebra.IsIntegral κ (Ai i) := Algebra.IsIntegral.of_finite κ (Ai i)
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral
    let f : ∀ i, Ai i ≃ₐ[κ] κ := fun i =>
      (AlgEquiv.ofBijective (Algebra.ofId κ (Ai i)) (hb i)).symm
    have := Fintype.ofFinite I
    exact ⟨Fintype.card I, ⟨e.trans ((AlgEquiv.piCongrRight f).trans
      (AlgEquiv.piCongrLeft κ (fun _ => κ) (Fintype.equivFin I)))⟩⟩

  have c3 : ∀ (A : Type u) [CommRing A] [Algebra κ A] (r k : ℕ),
      Nonempty ((Fin r → Fin k → A) ≃ₐ[κ] (Fin (r * k) → A)) := by
    intro A _ _ r k
    exact ⟨{ toFun := fun f j => f (finProdFinEquiv.symm j).1 (finProdFinEquiv.symm j).2
             invFun := fun g i l => g (finProdFinEquiv (i, l))
             left_inv := fun f => by
               funext i l
               simp
             right_inv := fun g => by
               funext j
               exact congrArg g (finProdFinEquiv.apply_symm_apply j)
             map_mul' := fun _ _ => rfl
             map_add' := fun _ _ => rfl
             commutes' := fun _ => rfl }⟩

  letI iSκ : Algebra (Polynomial R) κ := (Polynomial.eval₂RingHom (algebraMap R κ) 0).toAlgebra
  have tRSκ : IsScalarTower R (Polynomial R) κ := IsScalarTower.of_algebraMap_eq (fun r => by
    show _ = Polynomial.eval₂ (algebraMap R κ) 0 (algebraMap R (Polynomial R) r)
    rw [Polynomial.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply, Polynomial.eval₂_C])
  have hX0 : TensorProduct.tmul R (1 : κ) (algebraMap (Polynomial R) Q Polynomial.X) = 0 :=
    ψ.injective (by rw [hψ, map_zero])
  have h : ∀ p : Polynomial R, TensorProduct.tmul R (1 : κ) (algebraMap (Polynomial R) Q p) =
      TensorProduct.tmul R (algebraMap (Polynomial R) κ p) (1 : Q) := by
    let f1 : Polynomial R →+* TensorProduct R κ Q :=
      (Algebra.TensorProduct.includeRight : Q →ₐ[R] TensorProduct R κ Q).toRingHom.comp
        (algebraMap (Polynomial R) Q)
