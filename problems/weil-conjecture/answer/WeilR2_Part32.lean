      ∀ {P : Type u} (π : P → Ideal A), Function.Injective π → ∀ (x : P → B) (σ : P → A),
      (∀ z, σ z ∉ π z) →
      ∃ y : B, ∀ z, π z ∈ T → ∃ u : A, u ∉ π z ∧ ∃ w : A, ψ u * (ψ (σ z) * y - x z) = ψ w := by
    intro A B _ _ ψ T hT H4 P π hπ x σ hσ
    obtain ⟨y, hy⟩ := H4 (fun m => if h : ∃ z, π z = m.1 then x h.choose else 0)
      (fun m => if h : ∃ z, π z = m.1 then σ h.choose else 1) (by
        intro m
        by_cases h : ∃ z, π z = m.1
        · rw [dif_pos h]
          have := hσ h.choose
          rwa [h.choose_spec] at this
        · rw [dif_neg h]
          exact (Ideal.ne_top_iff_one _).mp (hT m.1 m.2).ne_top)
    refine ⟨y, fun z hz => ?_⟩
    have h : ∃ z', π z' = (⟨π z, hz⟩ : T).1 := ⟨z, rfl⟩
    have hc : h.choose = z := hπ h.choose_spec
    obtain ⟨u, hu, w, hw⟩ := hy ⟨π z, hz⟩
    rw [dif_pos h, dif_pos h, hc] at hw
    exact ⟨u, hu, w, hw⟩

  have deltaEq : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) →
      wcpaDjLkDelta R = wcpaDjLkDelta S := by
    intro R S _ _ e
    let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
    have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) =
