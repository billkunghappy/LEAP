  refine ⟨g, ?_⟩
  intro N j hj hjs
  subst hjs
  obtain ⟨-, -, hEE, hbo, hcoc, -⟩ := wcpa_dj_lr1k_ll_gc_df_hs_proj_chart_data κ N
  have hcover : ∀ p : ↥(wcProjK κ N), ∃ b : Fin (N + 1), p ∈ wcSgD κ N b := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ) :=
      MvPolynomial.gradedAlgebra
    have hirr : (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) κ)) := by
      intro x hx
      have hx' : x ∈ HomogeneousIdeal.irrelevant
