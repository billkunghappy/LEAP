      intro A l m Y hYA hY
      rw [hQ2 (J0 l) (J0 m) A Y (hY.trans (inf_le_right.trans (hψ m))) hYA, hTG l m Y hY,
        hgres e g hg l m Y hY, mul_pow, ← pow_mul, mul_assoc]
    have hcovA : ∀ A : Fin (M + 1),
        ψ ⁻¹ᵁ wcSgD K M A ≤ ⨆ l, ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l := by
      intro A
      rw [← inf_iSup_eq, hU, inf_top_eq]
    have hglue : ∀ A : Fin (M + 1), ∃ s : Γ(X, ψ ⁻¹ᵁ wcSgD K M A), ∀ l : Fin (N + 1),
        X.presheaf.map (homOfLE (inf_le_left : ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l ≤
          ψ ⁻¹ᵁ wcSgD K M A)).op s =
        (ψ.appLE (wcSgD K M A) (ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l) inf_le_left
