theorem wcpa_dj_lr1k_odfgl_fibre_lines : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ]
    [IsAlgClosed κ] [Algebra R κ] (D : Type u) [CommRing D] [Algebra R D]
    [Algebra (Polynomial R) D] [IsScalarTower R (Polynomial R) D], Algebra.Etale (Polynomial R) D →
    ∀ (Q : Type u) [CommRing Q] [Algebra R Q] [Algebra (Polynomial R) Q]
      [IsScalarTower R (Polynomial R) Q] (k : ℕ)
