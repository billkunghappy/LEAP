theorem wcpa_dj_lr1k_odfgl_nt_poly_clear : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W → ∀ f : Polynomial Ω, ∃ (N : ℕ) (p : Polynomial ↥W), Polynomial.C ((c : Ω) ^ N) * f = Polynomial.aeval (Polynomial.X : Polynomial Ω) p :=
by
  intro Ω _ W hdim c _ hc f
  classical
  have hdimLE : Ring.KrullDimLE 1 W := Ring.krullDimLE_iff.mpr hdim
  have hmax : ∀ J : Ideal W, J.IsPrime → J ≠ ⊥ → J.IsMaximal := by
    intro J hJp hJne
    exact Ring.krullDimLE_one_iff_of_isPrime_bot.mp hdimLE J hJne hJp
  have hscalar : ∀ x : Ω, ∃ N : ℕ, (c : Ω) ^ N * x ∈ W := by
    intro x
    by_cases hx : x ∈ W
    · exact ⟨0, by simpa using hx⟩
    · have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
      have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
      set y : W := ⟨x⁻¹, hxi⟩ with hy
      have hyx : (y : Ω) * x = 1 := inv_mul_cancel₀ hx0
      have hy0 : y ≠ 0 := by
