theorem wcpa_dj_lr1k_ll_gc_df_reembed : ∀ (K : Type u) [Field K] {Zt Z : Scheme.{u}} {N : ℕ}
    (j : Z ⟶ wcProjK K N), IsClosedImmersion j → ∀ (ν : Zt ⟶ Z), IsFinite ν →
    ∃ (M : ℕ) (j' : Zt ⟶ wcProjK K M) (E : ℕ), IsClosedImmersion j' ∧
