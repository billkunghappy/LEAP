    subst hxy hyz
    simp only [wcpaDjGslTr, TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp,
      Scheme.Hom.stalkMap_comp]
    erw [TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]
    rfl
  have gcongr' : ∀ {X Y : Scheme.{u}} (f g : X ⟶ Y), f = g → ∀ (x : X) (y : Y)
      (hf : f x = y) (hg : g x = y), wcpaDjGslTr f x y hf = wcpaDjGslTr g x y hg := by
    intro X Y f g hfg x y hf hg
    subst hfg
