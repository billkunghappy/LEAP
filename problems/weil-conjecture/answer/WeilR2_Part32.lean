    have hginj : Function.Injective (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom :=
      germ_injective_of_isIntegral C _ hgen
    let iAD : Algebra ↑Γ(X, V) ↑Γ(C, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
    let G : Γ(C, f ⁻¹ᵁ V) →ₐ[↑Γ(X, V)] C.functionField :=
      { toRingHom := (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom
