    have h2 : n - m a + m a • 1 = n := by
      rw [smul_eq_mul, mul_one]; exact Nat.sub_add_cancel (hmn a)
    rw [h2] at h1
    exact h1
  have hPmem : ∀ a, MvPolynomial.X a ^ (n - m a) * P' a ∈
