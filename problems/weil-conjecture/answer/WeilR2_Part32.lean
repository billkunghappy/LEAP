    have hKint : IsIntegral K (algebraMap B L θ) := Algebra.IsIntegral.isIntegral _
    have hmin : minpoly K (algebraMap B L θ) = (minpoly A θ).map (algebraMap A K) :=
      minpoly.isIntegrallyClosed_eq_field_fractions K L hθint
    refine ⟨?_, ?_⟩
    · rw [← (minpoly.monic hθint).natDegree_map (algebraMap A K), ← hmin,
        ← IntermediateField.adjoin.finrank hKint, htop, IntermediateField.finrank_top']
