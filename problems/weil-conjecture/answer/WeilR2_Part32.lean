import WeilR2_Part31
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_lr1u_vgc_rt_mobius : ∀ (Ω K : Type u) [Field Ω] [Field K] (c : Ω →+* K) (W : ValuationSubring Ω) (V : ValuationSubring K), (∀ ω : Ω, c ω ∈ V ↔ ω ∈ W) → ∀ u : K, u ∈ V → (∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.eval₂ (c.comp W.subtype) u ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) u)⁻¹ ∈ V) → ∀ (α β γ δ : ↥W), IsUnit (α * δ - β * γ) → c (γ : Ω) * u + c (δ : Ω) ≠ 0 ∧ (c (α : Ω) * u + c (β : Ω)) * (c (γ : Ω) * u + c (δ : Ω))⁻¹ ∈ V ∧ ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.eval₂ (c.comp W.subtype) ((c (α : Ω) * u + c (β : Ω)) * (c (γ : Ω) * u + c (δ : Ω))⁻¹) ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) ((c (α : Ω) * u + c (β : Ω)) * (c (γ : Ω) * u + c (δ : Ω))⁻¹))⁻¹ ∈ V :=
by
  intro Ω K _ _ c W V hVW u hu hRTu α β γ δ hdet
  classical

  have hℓprim : ∃ i, IsUnit ((Polynomial.C γ * Polynomial.X + Polynomial.C δ :
      Polynomial ↥W).coeff i) := by
    by_cases hγ : IsUnit γ
    · exact ⟨1, by simpa using hγ⟩
    · by_cases hδ : IsUnit δ
      · exact ⟨0, by simpa using hδ⟩
      · exfalso
        have hγm : γ ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.mem_maximalIdeal _).2 (mem_nonunits_iff.2 hγ)
        have hδm : δ ∈ IsLocalRing.maximalIdeal ↥W :=
          (IsLocalRing.mem_maximalIdeal _).2 (mem_nonunits_iff.2 hδ)
        have hm : α * δ - β * γ ∈ IsLocalRing.maximalIdeal ↥W :=
          Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hδm) (Ideal.mul_mem_left _ _ hγm)
        exact (mem_nonunits_iff.1 ((IsLocalRing.mem_maximalIdeal _).1 hm)) hdet
  have hℓeval : (Polynomial.C γ * Polynomial.X + Polynomial.C δ : Polynomial ↥W).eval₂
      (c.comp W.subtype) u = c (γ : Ω) * u + c (δ : Ω) := by
    simp
  obtain ⟨hD0, hDinv⟩ := hRTu _ hℓprim
  rw [hℓeval] at hD0 hDinv
  have hmemc : ∀ w : ↥W, c (w : Ω) ∈ V := fun w => (hVW _).2 w.2
  have hyV : (c (α : Ω) * u + c (β : Ω)) * (c (γ : Ω) * u + c (δ : Ω))⁻¹ ∈ V :=
    mul_mem (add_mem (mul_mem (hmemc α) hu) (hmemc β)) hDinv
  refine ⟨hD0, hyV, ?_⟩

  let ψ : ↥W →+* ↥V := (c.comp W.subtype).codRestrict V (fun w => hmemc w)
  haveI : IsLocalHom ψ := by
    constructor
    intro w hw
    obtain ⟨v, hv⟩ := hw.exists_right_inv
    have hv' : c (w : Ω) * (v : K) = 1 := congrArg Subtype.val hv
    have hw0 : (w : Ω) ≠ 0 := by
      intro h
      rw [h, map_zero, zero_mul] at hv'
      exact zero_ne_one hv'
    have hinv : c ((w : Ω)⁻¹) ∈ V := by
      rw [map_inv₀, inv_eq_of_mul_eq_one_right hv']
      exact v.2
    exact isUnit_iff_exists_inv.2 ⟨⟨(w : Ω)⁻¹, (hVW _).1 hinv⟩, Subtype.ext (mul_inv_cancel₀ hw0)⟩
  let φ := IsLocalRing.ResidueField.map ψ
  have hφ : ∀ w, φ (IsLocalRing.residue ↥W w) = IsLocalRing.residue ↥V (ψ w) :=
    fun w => IsLocalRing.ResidueField.map_residue ψ w
  have hcomp : (IsLocalRing.residue ↥V).comp ψ = φ.comp (IsLocalRing.residue ↥W) :=
    RingHom.ext fun w => (hφ w).symm
  have hsub : V.subtype.comp ψ = c.comp W.subtype := RingHom.ext fun w => rfl
  have hev1 : ∀ (q : Polynomial ↥W) (x : ↥V),
      ((q.eval₂ ψ x : ↥V) : K) = q.eval₂ (c.comp W.subtype) (x : K) := by
    intro q x
    have := Polynomial.hom_eval₂ q ψ V.subtype x
    rw [hsub] at this
    exact this
  have hev2 : ∀ (q : Polynomial ↥W) (x : ↥V), IsLocalRing.residue ↥V (q.eval₂ ψ x) =
      (q.map (IsLocalRing.residue ↥W)).eval₂ φ (IsLocalRing.residue ↥V x) := by
    intro q x
    rw [Polynomial.hom_eval₂, hcomp, Polynomial.eval₂_map]

  have hfwd : ∀ x : ↥V, (∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) →
      q.eval₂ (c.comp W.subtype) (x : K) ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) (x : K))⁻¹ ∈ V) →
      ∀ p : Polynomial (IsLocalRing.ResidueField ↥W), p ≠ 0 →
        p.eval₂ φ (IsLocalRing.residue ↥V x) ≠ 0 := by
    intro x hx p hp
    obtain ⟨q, rfl⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥W)
      IsLocalRing.residue_surjective p
    have hprim : ∃ i, IsUnit (q.coeff i) := by
      by_contra hne
      push Not at hne
      apply hp
      ext i
      rw [Polynomial.coeff_map, Polynomial.coeff_zero]
      by_contra h
      exact hne i ((IsLocalRing.residue_ne_zero_iff_isUnit _).1 h)
    obtain ⟨hz0, hzinv⟩ := hx q hprim
    rw [← hev2, IsLocalRing.residue_ne_zero_iff_isUnit]
    refine isUnit_iff_exists_inv.2 ⟨(⟨_, hzinv⟩ : ↥V), Subtype.ext ?_⟩
    show ((q.eval₂ ψ x : ↥V) : K) * (q.eval₂ (c.comp W.subtype) (x : K))⁻¹ = 1
    rw [hev1]
    exact mul_inv_cancel₀ hz0

  have hbwd : ∀ x : ↥V, (∀ p : Polynomial (IsLocalRing.ResidueField ↥W), p ≠ 0 →
      p.eval₂ φ (IsLocalRing.residue ↥V x) ≠ 0) → ∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) →
      q.eval₂ (c.comp W.subtype) (x : K) ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) (x : K))⁻¹ ∈ V := by
    intro x hx q ⟨i, hi⟩
    have hp : q.map (IsLocalRing.residue ↥W) ≠ 0 := by
      intro h
      have h' := congrArg (fun r => r.coeff i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at h'
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).2 hi h'
    have hres := hx _ hp
    rw [← hev2, IsLocalRing.residue_ne_zero_iff_isUnit] at hres
    obtain ⟨Y', hY'⟩ := hres.exists_right_inv
    have hY'K : q.eval₂ (c.comp W.subtype) (x : K) * (Y' : K) = 1 := by
      rw [← hev1]
      exact congrArg Subtype.val hY'
    exact ⟨left_ne_zero_of_mul_eq_one hY'K, by rw [inv_eq_of_mul_eq_one_right hY'K]; exact Y'.2⟩

  have hmob : ∀ (x z : IsLocalRing.ResidueField ↥V) (a b c' d : IsLocalRing.ResidueField ↥W),
      a * d - b * c' ≠ 0 → z * (φ c' * x + φ d) = φ a * x + φ b →
      (∀ p : Polynomial (IsLocalRing.ResidueField ↥W), p ≠ 0 → p.eval₂ φ x ≠ 0) →
      ∀ p : Polynomial (IsLocalRing.ResidueField ↥W), p ≠ 0 → p.eval₂ φ z ≠ 0 := by
    intro x z a b c' d hdet' hrel hx p hp hpz
    letI : Algebra (IsLocalRing.ResidueField ↥W) (IsLocalRing.ResidueField ↥V) := φ.toAlgebra
    have hxT : ¬ IsAlgebraic (IsLocalRing.ResidueField ↥W) x := by
      rintro ⟨r, hr, hrx⟩
      rw [Polynomial.aeval_def] at hrx
      exact hx r hr hrx
    have hzA : IsAlgebraic (IsLocalRing.ResidueField ↥W) z :=
      ⟨p, hp, by rw [Polynomial.aeval_def]; exact hpz⟩
    have halg : ∀ e, IsAlgebraic (IsLocalRing.ResidueField ↥W) (φ e) :=
      fun e => isAlgebraic_algebraMap e
    have hxAB : x * (φ c' * z - φ a) = φ b - φ d * z := by linear_combination hrel
    by_cases hA : φ c' * z - φ a = 0
    · have hB : φ b - φ d * z = 0 := by rw [← hxAB, hA, mul_zero]
      apply hdet'
      apply φ.injective
      rw [map_sub, map_mul, map_mul, map_zero]
      linear_combination (-(φ d)) * hA - (φ c') * hB
    · apply hxT
      have hx_eq : x = (φ b - φ d * z) * (φ c' * z - φ a)⁻¹ := by
        rw [← hxAB, mul_assoc, mul_inv_cancel₀ hA, mul_one]
      rw [hx_eq]
      exact ((halg b).sub ((halg d).mul hzA)).mul (((halg c').mul hzA).sub (halg a)).inv

  have hrelV : (⟨_, hyV⟩ : ↥V) * (ψ γ * ⟨u, hu⟩ + ψ δ) = ψ α * ⟨u, hu⟩ + ψ β := by
    apply Subtype.ext
    show (c (α : Ω) * u + c (β : Ω)) * (c (γ : Ω) * u + c (δ : Ω))⁻¹ *
      (c (γ : Ω) * u + c (δ : Ω)) = c (α : Ω) * u + c (β : Ω)
    rw [mul_assoc, inv_mul_cancel₀ hD0, mul_one]
  have hrelR := congrArg (IsLocalRing.residue ↥V) hrelV
  simp only [map_mul, map_add, ← hφ] at hrelR
  have hdetR : IsLocalRing.residue ↥W α * IsLocalRing.residue ↥W δ -
      IsLocalRing.residue ↥W β * IsLocalRing.residue ↥W γ ≠ 0 := by
    rw [← map_mul, ← map_mul, ← map_sub]
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _).2 hdet
  exact hbwd ⟨_, hyV⟩ (hmob _ _ _ _ _ _ hdetR hrelR (hfwd ⟨u, hu⟩ hRTu))

theorem wcpa_dj_lr1u_vtd_gauss_coordinate : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (V : ValuationSubring (wcProjK Ω 1).functionField), (∀ ω : Ω, wcLr1uConst (wcProjKStr Ω 1) ω ∈ V ↔ ω ∈ W) → (∃ s : (wcProjK Ω 1).functionField, wcLr1uVtdRT W (wcProjKStr Ω 1) (V : Set (wcProjK Ω 1).functionField) s) → ∃ (c1 c2 c3 : ↥(wcProjK Ω 1)) (h : (wcProjK Ω 1).functionField), wcLr1uMob (wcProjKStr Ω 1) c1 c2 c3 h ∧ wcLr1uVtdRT W (wcProjKStr Ω 1) (V : Set (wcProjK Ω 1).functionField) h :=
by
  intro Ω _ _ W _ V hVW hex
  classical
  obtain ⟨s, hRTs⟩ := hex
  unfold wcLr1uVtdRT at hRTs

  obtain ⟨t, hgen, hpts⟩ := wcpa_dj_lr1u_dd_chart_coordinate Ω

  obtain ⟨a, b, hb, huV, hRTu⟩ := wcpa_dj_lr1u_vgc_linear_coordinate Ω
    (wcProjK Ω 1).functionField (wcLr1uConst (wcProjKStr Ω 1)) W V hVW t s hgen hRTs.1 hRTs.2
  obtain ⟨u, hu⟩ : ∃ u, u = (t - wcLr1uConst (wcProjKStr Ω 1) a) *
      (wcLr1uConst (wcProjKStr Ω 1) b)⁻¹ := ⟨_, rfl⟩
  rw [← hu] at huV hRTu
  have hCb : wcLr1uConst (wcProjKStr Ω 1) b ≠ 0 := (map_ne_zero _).mpr hb

  obtain ⟨w, hw⟩ : ∃ w : Ω, w * w - w + 1 = 0 := by
    have hdeg : (Polynomial.C (1:Ω) * Polynomial.X ^ 2 + Polynomial.C (-1) * Polynomial.X +
        Polynomial.C 1).degree ≠ 0 := by
      rw [Polynomial.degree_quadratic one_ne_zero]
      first | decide | simp | norm_num
    obtain ⟨w, hw⟩ := IsAlgClosed.exists_root _ hdeg
    refine ⟨w, ?_⟩
    simp only [Polynomial.IsRoot, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_pow, Polynomial.eval_X] at hw
    linear_combination hw
  have hw0 : w ≠ 0 := by
    rintro rfl
    norm_num at hw
  have hw1 : w ≠ 1 := by
    rintro rfl
    norm_num at hw
  have hwW : w ∈ W := by
    rcases W.mem_or_inv_mem w with h | h
    · exact h
    · have e : 1 - w = w⁻¹ := eq_inv_of_mul_eq_one_left (by linear_combination -hw)
      have e2 : w = 1 - w⁻¹ := by rw [← e]; ring
      rw [e2]
      exact W.sub_mem W.one_mem h

  obtain ⟨hD, hyV, hRTy⟩ := wcpa_dj_lr1u_vgc_rt_mobius Ω (wcProjK Ω 1).functionField
    (wcLr1uConst (wcProjKStr Ω 1)) W V hVW u huV hRTu 1 0 ⟨w, hwW⟩ 1 (by simp)
  simp only [OneMemClass.coe_one, ZeroMemClass.coe_zero, map_one, map_zero, one_mul,
    add_zero] at hD hyV hRTy
  obtain ⟨h, hh⟩ : ∃ h, h = u * (wcLr1uConst (wcProjKStr Ω 1) w * u + 1)⁻¹ := ⟨_, rfl⟩
  rw [← hh] at hyV hRTy

  have hh0 : h ≠ 0 := by
    have := (hRTy Polynomial.X ⟨1, by simp⟩).1
    simpa using this
  have hcw : wcLr1uConst (wcProjKStr Ω 1) w * h - 1 ≠ 0 := by
    have := (hRTy (Polynomial.C (⟨w, hwW⟩ : ↥W) * Polynomial.X - 1)
      ⟨0, by simp [Polynomial.coeff_one]⟩).1
    simpa using this

  have hut : t - wcLr1uConst (wcProjKStr Ω 1) a = u * wcLr1uConst (wcProjKStr Ω 1) b := by
    rw [hu, mul_assoc, inv_mul_cancel₀ hCb, mul_one]
  have hRel : h * (wcLr1uConst (wcProjKStr Ω 1) w * t + wcLr1uConst (wcProjKStr Ω 1) (b - w * a))
      = t - wcLr1uConst (wcProjKStr Ω 1) a := by
    have e : wcLr1uConst (wcProjKStr Ω 1) w * t + wcLr1uConst (wcProjKStr Ω 1) (b - w * a) =
        wcLr1uConst (wcProjKStr Ω 1) b * (wcLr1uConst (wcProjKStr Ω 1) w * u + 1) := by
      rw [map_sub, map_mul]
      linear_combination (wcLr1uConst (wcProjKStr Ω 1) w) * hut
    rw [e, hut, hh]
    rw [show u * (wcLr1uConst (wcProjKStr Ω 1) w * u + 1)⁻¹ *
        (wcLr1uConst (wcProjKStr Ω 1) b * (wcLr1uConst (wcProjKStr Ω 1) w * u + 1)) =
        u * wcLr1uConst (wcProjKStr Ω 1) b *
          ((wcLr1uConst (wcProjKStr Ω 1) w * u + 1)⁻¹ *
            (wcLr1uConst (wcProjKStr Ω 1) w * u + 1)) by ring,
      inv_mul_cancel₀ hD, mul_one]

  obtain ⟨P1, -, hP1⟩ := hpts a
  have hv1 : wcLr1uVanish (P1 (IsLocalRing.closedPoint Ω)) h := by
    have := (wcpa_dj_lr1u_dd_val_calculus Ω (P1 (IsLocalRing.closedPoint Ω))).1 t h 1 (-a) w
      (b - w * a) a hP1 (by rw [hRel, map_one, map_neg]; ring)
      (by rw [show w * a + (b - w * a) = b by ring]; exact hb)
    rw [show (1 * a + -a) / (w * a + (b - w * a)) = (0 : Ω) by ring] at this
    unfold wcLr1uValAt at this
    rwa [map_zero, sub_zero] at this

  obtain ⟨P2, -, hP2⟩ := hpts (a + b * w)
  have hden2 : w * (a + b * w) + (b - w * a) = b * w := by linear_combination b * hw
  have hbw : b * w ≠ 0 := mul_ne_zero hb hw0
  have hv2 : wcLr1uVanish (P2 (IsLocalRing.closedPoint Ω)) (h - 1) := by
    have := (wcpa_dj_lr1u_dd_val_calculus Ω (P2 (IsLocalRing.closedPoint Ω))).1 t h 1 (-a) w
      (b - w * a) (a + b * w) hP2 (by rw [hRel, map_one, map_neg]; ring)
      (by rw [hden2]; exact hbw)
    rw [show (1 * (a + b * w) + -a) / (w * (a + b * w) + (b - w * a)) = (1 : Ω) by
      rw [hden2, div_eq_one_iff_eq hbw]; ring] at this
    unfold wcLr1uValAt at this
    rwa [map_one] at this

  obtain ⟨P3, -, hP3⟩ := hpts (a - b + b * w)
  have hv3 : ∃ s ∈ IsLocalRing.maximalIdeal ((wcProjK Ω 1).presheaf.stalk
      (P3 (IsLocalRing.closedPoint Ω))), ((wcProjK Ω 1).presheaf.stalkSpecializes
        (genericPoint_specializes (P3 (IsLocalRing.closedPoint Ω)))).hom s * h = 1 := by
    have hrel3 : h⁻¹ * (wcLr1uConst (wcProjKStr Ω 1) 1 * t + wcLr1uConst (wcProjKStr Ω 1) (-a)) =
        wcLr1uConst (wcProjKStr Ω 1) w * t + wcLr1uConst (wcProjKStr Ω 1) (b - w * a) := by
      rw [map_one, map_neg, one_mul, ← sub_eq_add_neg, ← hRel, ← mul_assoc, inv_mul_cancel₀ hh0,
        one_mul]
    have := (wcpa_dj_lr1u_dd_val_calculus Ω (P3 (IsLocalRing.closedPoint Ω))).1 t h⁻¹ w
      (b - w * a) 1 (-a) (a - b + b * w) hP3 hrel3
      (by
        rw [show 1 * (a - b + b * w) + -a = b * (w - 1) by ring]
        exact mul_ne_zero hb (sub_ne_zero.mpr hw1))
    rw [show w * (a - b + b * w) + (b - w * a) = (0 : Ω) by linear_combination b * hw,
      zero_div] at this
    unfold wcLr1uValAt wcLr1uVanish at this
    rw [map_zero, sub_zero] at this
    obtain ⟨σ, hσm, hσ⟩ := this
    exact ⟨σ, hσm, by rw [hσ, inv_mul_cancel₀ hh0]⟩

  have hgenh : ∀ f : (wcProjK Ω 1).functionField, ∃ p q : Polynomial Ω,
      q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h ≠ 0 ∧
      f * q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h = p.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h := by
    let S : Subfield (wcProjK Ω 1).functionField :=
      { carrier := {f | ∃ p q : Polynomial Ω, q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h ≠ 0 ∧
          f * q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h = p.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h}
        mul_mem' := by
          rintro f₁ f₂ ⟨p₁, q₁, hq₁, e₁⟩ ⟨p₂, q₂, hq₂, e₂⟩
          refine ⟨p₁ * p₂, q₁ * q₂, ?_, ?_⟩
          · rw [Polynomial.eval₂_mul]; exact mul_ne_zero hq₁ hq₂
          · rw [Polynomial.eval₂_mul, Polynomial.eval₂_mul, ← e₁, ← e₂]; ring
        one_mem' := ⟨1, 1, by simp, by simp⟩
        add_mem' := by
          rintro f₁ f₂ ⟨p₁, q₁, hq₁, e₁⟩ ⟨p₂, q₂, hq₂, e₂⟩
          refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, ?_, ?_⟩
          · rw [Polynomial.eval₂_mul]; exact mul_ne_zero hq₁ hq₂
          · rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul,
              Polynomial.eval₂_mul, ← e₁, ← e₂]; ring
        zero_mem' := ⟨0, 1, by simp, by simp⟩
        neg_mem' := by
          rintro f ⟨p, q, hq, e⟩
          exact ⟨-p, q, hq, by rw [Polynomial.eval₂_neg, ← e]; ring⟩
        inv_mem' := by
          rintro f ⟨p, q, hq, e⟩
          by_cases hf : f = 0
          · exact ⟨0, 1, by simp, by simp [hf]⟩
          · refine ⟨q, p, ?_, ?_⟩
            · rw [← e]; exact mul_ne_zero hf hq
            · rw [← e, ← mul_assoc, inv_mul_cancel₀ hf, one_mul] }
    have hmem : ∀ f, f ∈ S ↔ ∃ p q : Polynomial Ω,
        q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h ≠ 0 ∧
        f * q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h =
          p.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) h := fun f => Iff.rfl
    have hconst : ∀ ω : Ω, wcLr1uConst (wcProjKStr Ω 1) ω ∈ S := by
      intro ω
      rw [hmem]
      exact ⟨Polynomial.C ω, 1, by simp, by simp⟩
    have htS : t ∈ S := by
      rw [hmem]
      refine ⟨-Polynomial.C a - Polynomial.C (b - w * a) * Polynomial.X,
        Polynomial.C w * Polynomial.X - 1, ?_, ?_⟩
      · simpa using hcw
      · simp only [Polynomial.eval₂_sub, Polynomial.eval₂_neg, Polynomial.eval₂_mul,
          Polynomial.eval₂_C, Polynomial.eval₂_X, Polynomial.eval₂_one]
        linear_combination hRel
    have hpolyS : ∀ r : Polynomial Ω, r.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) t ∈ S := by
      intro r
      rw [Polynomial.eval₂_eq_sum_range]
      exact Subfield.sum_mem _ (fun i _ => Subfield.mul_mem _ (hconst _) (Subfield.pow_mem _ htS _))
    intro f
    obtain ⟨p, q, hq, e⟩ := hgen f
    have hf : f = p.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) t *
        (q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) t)⁻¹ := by
