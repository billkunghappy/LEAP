    haveI : _root_.IsReduced Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := hAred
    haveI : IsNoetherianRing Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := hAnoeth
    haveI : Algebra.FiniteType κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := hAft
    have hfinB : Module.Finite Γ(Z, j ⁻¹ᵁ wcSgD κ N a) Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a) := hψfin
    obtain ⟨T, hTmax, hTloc, hTcrt⟩ :=
