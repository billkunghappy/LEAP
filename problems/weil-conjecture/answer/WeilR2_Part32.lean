    apply Subtype.val_injective
    have h1 := Polynomial.scaleRoots_eval₂_mul (p := p) (algebraMap T L) x b'
    rw [hpx, mul_zero] at h1
    have h2 : algebraMap T L c = algebraMap T L b' * x := rfl
    rw [← h2, Polynomial.eval₂_at_apply] at h1
    exact h1
  let K := FractionRing T
  let ψ := algebraMap T K
  have hψ : Function.Injective ψ := IsFractionRing.injective T K
  have hb'mem : b' ∈ nonZeroDivisors T := mem_nonZeroDivisors_of_ne_zero hb'0
  let y : K := IsLocalization.mk' K c ⟨b', hb'mem⟩
  have hy : ψ b' * y = ψ c := IsLocalization.mk'_spec' K c ⟨b', hb'mem⟩
  have hyint : IsIntegral T y := by
    refine ⟨p, hpm, ?_⟩
    have h1 := Polynomial.scaleRoots_eval₂_mul (p := p) ψ y b'
    rw [hy, Polynomial.eval₂_at_apply, hq, map_zero] at h1
    have hne : ψ b' ^ p.natDegree ≠ 0 :=
      pow_ne_zero _ ((map_ne_zero_iff ψ hψ).mpr hb'0)
    exact (mul_eq_zero.mp h1.symm).resolve_left hne
  obtain ⟨z, hz⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hyint
  have hbz : b' * z = c := by
    apply hψ
    rw [map_mul, hz, hy]
  have hbz' : b * (z : L) = b * x := congrArg Subtype.val hbz
  have hzx : (z : L) = x := mul_left_cancel₀ hb0 hbz'
  rw [← hzx]
  exact z.2

theorem wcpa_dj_lr1k_odfgl_nt_away_embed : ∀ (k₀ Λ : Type u) [CommRing k₀] [CommRing Λ] [IsDomain Λ] [Algebra k₀ Λ] (B : Subalgebra k₀ Λ) (g : Λ) (hg : g ∈ B), g ≠ 0 → ∃ j : Localization.Away (⟨g, hg⟩ : ↥B) →ₐ[k₀] Localization.Away g, Function.Injective j ∧ (∀ b : ↥B, j (algebraMap ↥B (Localization.Away (⟨g, hg⟩ : ↥B)) b) = algebraMap Λ (Localization.Away g) (b : Λ)) ∧ ∀ x : Localization.Away g, x ∈ j.range ↔ ∃ b ∈ B, ∃ n : ℕ, x * algebraMap Λ (Localization.Away g) g ^ n = algebraMap Λ (Localization.Away g) b :=
by
  intro k₀ Λ _ _ _ _ B g hg hg0
  set b₀ : ↥B := ⟨g, hg⟩ with hb₀
  let f : ↥B →ₐ[k₀] Localization.Away g := (IsScalarTower.toAlgHom k₀ Λ (Localization.Away g)).comp B.val
  have hfapp : ∀ b : ↥B, f b = algebraMap Λ (Localization.Away g) (b : Λ) := fun b => rfl
  have hGu : IsUnit (algebraMap Λ (Localization.Away g) g) := IsLocalization.Away.algebraMap_isUnit g
  have hf : ∀ y : Submonoid.powers b₀, IsUnit (f y) := by
    rintro ⟨y, m, rfl⟩
    rw [map_pow]
    exact (hfapp b₀ ▸ hGu).pow m
  let j : Localization.Away b₀ →ₐ[k₀] Localization.Away g := IsLocalization.liftAlgHom hf
  have hj : ∀ b : ↥B, j (algebraMap ↥B (Localization.Away b₀) b) = algebraMap Λ (Localization.Away g) (b : Λ) := by
    intro b
    show IsLocalization.liftAlgHom hf (algebraMap ↥B (Localization.Away b₀) b) = _
    rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    rfl
  have hιinj : Function.Injective (algebraMap Λ (Localization.Away g)) :=
    IsLocalization.injective (Localization.Away g) (powers_le_nonZeroDivisors_of_noZeroDivisors hg0)
  have hjinj : Function.Injective j := by
    have := IsLocalization.injective_of_map_algebraMap_zero (M := Submonoid.powers b₀)
      (S := Localization.Away b₀) (j : Localization.Away b₀ →+* Localization.Away g) (by
        intro x hx
        have h1 : algebraMap Λ (Localization.Away g) (x : Λ) = algebraMap Λ (Localization.Away g) 0 := by
          rw [map_zero, ← hj x]; exact hx
        have h2 : x = 0 := Subtype.ext (hιinj h1)
        rw [h2, map_zero])
    exact this
  set iv := IsLocalization.Away.invSelf (S := Localization.Away b₀) b₀ with hiv
  have hGj : algebraMap Λ (Localization.Away g) g * j iv = 1 := by
    have := congrArg j (IsLocalization.Away.mul_invSelf (S := Localization.Away b₀) b₀)
    rw [map_mul, map_one, hj b₀] at this
    exact this
  refine ⟨j, hjinj, hj, fun x => ⟨?_, ?_⟩⟩
  · rintro ⟨y, rfl⟩
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj b₀ y
    refine ⟨(a : Λ), a.2, n, ?_⟩
    have := congrArg j ha
    rw [map_mul, map_pow, hj b₀, hj a] at this
    exact this
  · rintro ⟨b, hb, n, h⟩
    refine ⟨algebraMap ↥B (Localization.Away b₀) ⟨b, hb⟩ * iv ^ n, ?_⟩
    show j (algebraMap ↥B (Localization.Away b₀) ⟨b, hb⟩ * iv ^ n) = x
    rw [map_mul, map_pow, hj ⟨b, hb⟩]
    show algebraMap Λ (Localization.Away g) b * j iv ^ n = x
    rw [← h, mul_assoc, ← mul_pow, hGj, one_pow, mul_one]

theorem wcpa_dj_lr1k_odfgl_normalization_tensor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (Λ : Type u) [CommRing Λ] [IsDomain Λ] [Algebra Ω Λ] [Algebra ↥W Λ] [IsScalarTower ↥W Ω Λ]
      (A₀ : Subalgebra ↥W Λ) (t s : Λ), t ∈ A₀ → algebraMap ↥W Λ c * s = t →
    ∀ (B₁ R'' : Subalgebra ↥W Λ),
      (∀ x : Λ, x ∈ B₁ ↔ ∃ p : Polynomial Λ, p.Monic ∧ (∀ i, p.coeff i ∈ A₀) ∧ p.eval x = 0) →
      (∀ x : Λ, x ∈ R'' ↔ ∃ p : Polynomial Λ, p.Monic ∧
        (∀ i, p.coeff i ∈ Algebra.adjoin ↥W ((A₀ : Set Λ) ∪ {s})) ∧ p.eval x = 0) →
      (∀ x : Λ, ∃ N : ℕ, algebraMap ↥W Λ c ^ N * x ∈ B₁) →
    ∀ (g : Λ) (hgB : g ∈ B₁) (hgR : g ∈ R'') (htB : t ∈ B₁)
      [Algebra (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁))]
      [IsScalarTower ↥W (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁))],
      Algebra.Etale (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) →
    ∀ (P : Polynomial ↥W) (ε : (Localization.Away (⟨g, hgB⟩ : ↥B₁))ˣ),
      algebraMap ↥B₁ (Localization.Away (⟨g, hgB⟩ : ↥B₁)) ⟨t, htB⟩ =
        ↑ε * algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) P →
    ∀ (Q : Subalgebra ↥W (Polynomial Ω)),
      (∀ f : Polynomial Ω, f ∈ Q ↔ ∃ p : Polynomial (Polynomial Ω), p.Monic ∧
        (∀ i, p.coeff i ∈ Algebra.adjoin ↥W
          {Polynomial.X, Polynomial.C ((c : Ω)⁻¹) * P.map (algebraMap ↥W Ω)}) ∧ p.eval f = 0) →
      IsIntegrallyClosed ↥Q →
    ∀ [Algebra (Polynomial ↥W) ↥Q] [IsScalarTower ↥W (Polynomial ↥W) ↥Q],
      (∀ p : Polynomial ↥W, ((algebraMap (Polynomial ↥W) ↥Q p : ↥Q) : Polynomial Ω) =
        Polynomial.aeval (Polynomial.X : Polynomial Ω) p) →
    Nonempty (Localization.Away (⟨g, hgR⟩ : ↥R'') ≃ₐ[↥W]
      TensorProduct (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) ↥Q) :=
by
  intro Ω _ _ W hW hWt c hc0 hcm Λ _ _ _ _ _ A₀ t s ht hcs B₁ R'' hB hR hh2 g hgB hgR htB _ _ hEt
    P ε hε Q hQ hQic _ _ hQev
  classical
  haveI := hEt
  haveI := hQic

  by_cases hg0 : g = 0
  · have h0R : (0 : ↥R'') ∈ Submonoid.powers (⟨g, hgR⟩ : ↥R'') := by
      refine ⟨1, ?_⟩
      show (⟨g, hgR⟩ : ↥R'') ^ 1 = 0
      rw [pow_one]
      exact Subtype.ext hg0
    have h0B : (0 : ↥B₁) ∈ Submonoid.powers (⟨g, hgB⟩ : ↥B₁) := by
      refine ⟨1, ?_⟩
      show (⟨g, hgB⟩ : ↥B₁) ^ 1 = 0
      rw [pow_one]
      exact Subtype.ext hg0
    letI uR := IsLocalization.uniqueOfZeroMem (S := Localization.Away (⟨g, hgR⟩ : ↥R'')) h0R
    letI uB := IsLocalization.uniqueOfZeroMem (S := Localization.Away (⟨g, hgB⟩ : ↥B₁)) h0B
    haveI hsub : Subsingleton
        (TensorProduct (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) ↥Q) := by
      apply subsingleton_of_zero_eq_one
      rw [Algebra.TensorProduct.one_def,
        Subsingleton.elim (1 : Localization.Away (⟨g, hgB⟩ : ↥B₁)) 0, TensorProduct.zero_tmul]
    refine ⟨{ toFun := fun _ => 0
              invFun := fun _ => 0
              left_inv := fun x => Subsingleton.elim _ _
              right_inv := fun x => Subsingleton.elim _ _
              map_mul' := fun x y => Subsingleton.elim _ _
              map_add' := fun x y => Subsingleton.elim _ _
              commutes' := fun x => Subsingleton.elim _ _ }⟩

  haveI hLdom : IsDomain (Localization.Away g) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hg0)
  have hιΛ : Function.Injective (algebraMap Λ (Localization.Away g)) :=
    IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hg0)
  have hcΩ : (c : Ω) ≠ 0 := fun h => hc0 (Subtype.ext h)
  obtain ⟨j, hjinj, hjmap, hjrange⟩ :=
    wcpa_dj_lr1k_odfgl_nt_away_embed ↥W Λ B₁ g hgB hg0
  obtain ⟨ι, hιinj, hιmap, hιrange⟩ :=
    wcpa_dj_lr1k_odfgl_nt_away_embed ↥W Λ R'' g hgR hg0

  have hlin : ∀ {A : Type u} [CommRing A] [Algebra ↥W A] (S : Subalgebra ↥W A) (a : A), a ∈ S →
      ∀ i, (Polynomial.X - Polynomial.C a).coeff i ∈ S := by
    intro A _ _ S a ha i
    rw [Polynomial.coeff_sub, Polynomial.coeff_X, Polynomial.coeff_C]
    refine S.sub_mem ?_ ?_
    · split_ifs
      · exact S.one_mem
      · exact S.zero_mem
    · split_ifs
      · exact ha
      · exact S.zero_mem
  have hA0B : ∀ a ∈ A₀, a ∈ B₁ := fun a ha =>
    (hB a).2 ⟨Polynomial.X - Polynomial.C a, Polynomial.monic_X_sub_C a, hlin A₀ a ha, by simp⟩
  have hBR : ∀ x ∈ B₁, x ∈ R'' := by
    intro x hx
    obtain ⟨p, hpm, hpc, hpe⟩ := (hB x).1 hx
    exact (hR x).2 ⟨p, hpm, fun i => Algebra.subset_adjoin (Set.mem_union_left _ (hpc i)), hpe⟩
  have hsS : s ∈ Algebra.adjoin ↥W ((A₀ : Set Λ) ∪ {s}) :=
    Algebra.subset_adjoin (Set.mem_union_right _ rfl)
  have hsR : s ∈ R'' :=
    (hR s).2 ⟨Polynomial.X - Polynomial.C s, Polynomial.monic_X_sub_C s, hlin _ s hsS, by simp⟩
  have hjR : ∀ d, j d ∈ ι.range := by
    intro d
    obtain ⟨b, hb, n, hn⟩ := (hjrange (j d)).1 ⟨d, rfl⟩
    exact (hιrange _).2 ⟨b, hBR b hb, n, hn⟩
  have hsι : algebraMap Λ (Localization.Away g) s ∈ ι.range :=
    ⟨algebraMap ↥R'' _ ⟨s, hsR⟩, hιmap ⟨s, hsR⟩⟩
  have hc' : algebraMap ↥W Ω c = (c : Ω) := rfl

  obtain ⟨u, hu⟩ : ∃ u : Localization.Away (⟨g, hgB⟩ : ↥B₁),
      u = algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) Polynomial.X :=
    ⟨_, rfl⟩
  obtain ⟨evA, hevX⟩ : ∃ evA : Polynomial Ω →ₐ[Ω] Localization.Away g,
      evA Polynomial.X = j u :=
    ⟨Polynomial.aeval (j u), Polynomial.aeval_X _⟩
  letI iL : Algebra (Polynomial ↥W) (Localization.Away g) :=
    (j.toRingHom.comp
      (algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)))).toAlgebra
  haveI tL : IsScalarTower ↥W (Polynomial ↥W) (Localization.Away g) :=
    IsScalarTower.of_algebraMap_eq (fun w => by
      show algebraMap ↥W (Localization.Away g) w =
        j (algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁))
          (algebraMap ↥W (Polynomial ↥W) w))
      rw [← IsScalarTower.algebraMap_apply ↥W (Polynomial ↥W)
        (Localization.Away (⟨g, hgB⟩ : ↥B₁)) w, AlgHom.commutes])
  have hkey : ∀ p : Polynomial ↥W, evA (Polynomial.aeval (Polynomial.X : Polynomial Ω) p) =
      j (algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) p) := by
    intro p
    have e1 := Polynomial.aeval_algHom_apply (evA.restrictScalars ↥W)
      (Polynomial.X : Polynomial Ω) p
    simp only [AlgHom.restrictScalars_apply, hevX] at e1
    have e2 := Polynomial.aeval_algHom_apply
