    haveI : IsNoetherianRing (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)) :=
      Algebra.FiniteType.isNoetherianRing ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) _
    haveI : IsNoetherianRing Γ(wcProjK K N, wcSgD K N a) :=
      isNoetherianRing_of_ringEquiv _
        (Proj.basicOpenIsoAway (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a) hX Nat.one_pos).commRingCatIsoToRingEquiv
    haveI : Module.Finite Γ(wcProjK K N, wcSgD K N a)
        Γ(wcStructMod (wcProjK K N), wcSgD K N a) := Module.Finite.self Γ(wcProjK K N, wcSgD K N a)
    haveI : IsNoetherian Γ(wcProjK K N, wcSgD K N a) Γ(wcStructMod (wcProjK K N), wcSgD K N a) :=
      isNoetherian_of_isNoetherianRing_of_finite _ _
    exact Module.Finite.of_injective (wcCnSecLin ι (wcSgD K N a)) (hinj (wcSgD K N a))
  exact ⟨I, ι, hIq, hinj, hchar, hfin⟩

theorem wcpa_dj_lr1k_ll_gc_df_hs_proj_chart_data : ∀ (K : Type u) [Field K] (N : ℕ),
    (∀ J : Fin (N + 1), IsAffineOpen (wcSgD K N J)) ∧
    (∀ J L : Fin (N + 1), IsAffineOpen (wcSgD K N J ⊓ wcSgD K N L)) ∧
    (∀ J : Fin (N + 1), wcSgE K N J J = 1) ∧
    (∀ J L : Fin (N + 1), wcSgD K N J ⊓ wcSgD K N L = (wcProjK K N).basicOpen (wcSgE K N L J)) ∧
    (∀ J L L' : Fin (N + 1),
      ((wcProjK K N).presheaf.map (homOfLE (show wcSgD K N J ⊓ wcSgD K N L ⊓ wcSgD K N L' ≤
          wcSgD K N L' from inf_le_right)).op).hom (wcSgE K N L' J) =
        ((wcProjK K N).presheaf.map (homOfLE (show wcSgD K N J ⊓ wcSgD K N L ⊓ wcSgD K N L' ≤
          wcSgD K N L from inf_le_left.trans inf_le_right)).op).hom (wcSgE K N L J) *
        ((wcProjK K N).presheaf.map (homOfLE (show wcSgD K N J ⊓ wcSgD K N L ⊓ wcSgD K N L' ≤
          wcSgD K N L' from inf_le_right)).op).hom (wcSgE K N L' L)) ∧
    (∀ (L : Fin (N + 1)) (f : Γ(wcProjK K N, wcSgD K N L)),
      ∃ P : MvPolynomial (Fin (N + 1)) K,
        f = MvPolynomial.eval₂ (((wcProjK K N).presheaf.map
            (homOfLE (le_top : wcSgD K N L ≤ ⊤)).op).hom.comp
          ((wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
          (fun l => wcSgE K N L l) P) :=
by
  intro K _ N
  have chart := wcpa_dj_gsfp_chart_facts K N
  have hres : ∀ (U U' V : (wcProjK K N).Opens) (hUU : U' ≤ U) (h1 : V ≤ U) (h2 : V ≤ U')
      (y : Γ(wcProjK K N, U)),
      ((wcProjK K N).presheaf.map (homOfLE h1).op).hom y =
        ((wcProjK K N).presheaf.map (homOfLE h2).op).hom
          (((wcProjK K N).presheaf.map (homOfLE hUU).op).hom y) := by
    intro U U' V hUU h1 h2 y
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have h4 : ∀ J L : Fin (N + 1),
      wcSgD K N J ⊓ wcSgD K N L = (wcProjK K N).basicOpen (wcSgE K N L J) := by
    intro J L
    rw [inf_comm]
    exact (chart.2 L J J).2.1.symm
  have h2 : ∀ J L : Fin (N + 1), IsAffineOpen (wcSgD K N J ⊓ wcSgD K N L) := by
    intro J L
    rw [h4 J L]
    exact (chart.1 L).basicOpen _
  have h5 : ∀ J L L' : Fin (N + 1),
      ((wcProjK K N).presheaf.map (homOfLE (show wcSgD K N J ⊓ wcSgD K N L ⊓ wcSgD K N L' ≤
          wcSgD K N L' from inf_le_right)).op).hom (wcSgE K N L' J) =
        ((wcProjK K N).presheaf.map (homOfLE (show wcSgD K N J ⊓ wcSgD K N L ⊓ wcSgD K N L' ≤
          wcSgD K N L from inf_le_left.trans inf_le_right)).op).hom (wcSgE K N L J) *
        ((wcProjK K N).presheaf.map (homOfLE (show wcSgD K N J ⊓ wcSgD K N L ⊓ wcSgD K N L' ≤
          wcSgD K N L' from inf_le_right)).op).hom (wcSgE K N L' L) := by
    intro J L L'
    have hV : wcSgD K N J ⊓ wcSgD K N L ⊓ wcSgD K N L' ≤ wcSgD K N L' ⊓ wcSgD K N L :=
      le_inf inf_le_right (inf_le_left.trans inf_le_right)
    have h3 := (chart.2 L' L J).2.2
    rw [hres _ _ _ (inf_le_left : wcSgD K N L' ⊓ wcSgD K N L ≤ wcSgD K N L') _ hV,
      hres _ _ _ (inf_le_right : wcSgD K N L' ⊓ wcSgD K N L ≤ wcSgD K N L) _ hV,
      hres _ _ _ (inf_le_left : wcSgD K N L' ⊓ wcSgD K N L ≤ wcSgD K N L') _ hV,
      ← map_mul, mul_comm]
    exact congrArg (fun t => ((wcProjK K N).presheaf.map (homOfLE hV).op).hom t) h3
  have h6 : ∀ (L : Fin (N + 1)) (f : Γ(wcProjK K N, wcSgD K N L)),
      ∃ P : MvPolynomial (Fin (N + 1)) K,
        f = MvPolynomial.eval₂ (((wcProjK K N).presheaf.map
            (homOfLE (le_top : wcSgD K N L ≤ ⊤)).op).hom.comp
          ((wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
          (fun l => wcSgE K N L l) P := by
    intro L f
    set E := MvPolynomial.eval₂Hom (((wcProjK K N).presheaf.map
            (homOfLE (le_top : wcSgD K N L ≤ ⊤)).op).hom.comp
          ((wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
          (fun l => wcSgE K N L l) with hE
    have hf : f ∈ E.range := by
      refine (Subring.closure_le.mpr ?_) (wc_ldpi_oai_proj_gen K N L f)
      refine Set.union_subset ?_ ?_
      · rintro _ ⟨l, rfl⟩
        exact ⟨MvPolynomial.X l, MvPolynomial.eval₂Hom_X' _ _ _⟩
      · rintro _ ⟨c, rfl⟩
        refine ⟨MvPolynomial.C c, ?_⟩
        rw [hE, MvPolynomial.eval₂Hom_C]
        rfl
    obtain ⟨P, hP⟩ := hf
    exact ⟨P, hP.symm⟩
  exact ⟨chart.1, h2, fun J => (chart.2 J J J).1, h4, h5, h6⟩

theorem wcpa_dj_scs_power_cocycle {Y : Scheme.{u}} (M : ℕ) (D : Fin (M + 1) → Y.Opens)
    (x : ∀ J K, Γ(Y, D K)) (hD : ∀ J, IsAffineOpen (D J))
    (hx : ∀ J K, D J ⊓ D K = Y.basicOpen (x J K))
    (hxc : ∀ J K K',
      (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x J K') =
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K from
          inf_le_left.trans inf_le_right)).op).hom (x J K) *
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x K K')) :
    ∃ N₀ : ℕ, ∀ n ≥ N₀, wcpaScPow D x n :=
by
  classical

  have ring_pow : ∀ {A : Type u} [CommRing A] (a b : A) (n : ℕ), a ^ n * (a - b) = 0 →
      b ^ n * (a - b) = 0 → ∀ m : ℕ, 2 * n ≤ m → a ^ m = b ^ m := by
    intro A _ a b n ha hb m hm
    rw [← sub_eq_zero, ← geom_sum₂_mul, Finset.sum_mul]
    apply Finset.sum_eq_zero
    intro p hp
    rw [Finset.mem_range] at hp
    by_cases hpn : n ≤ p
    · obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hpn
      calc a ^ (n + c) * b ^ (m - 1 - (n + c)) * (a - b)
          = a ^ c * b ^ (m - 1 - (n + c)) * (a ^ n * (a - b)) := by ring
        _ = 0 := by rw [ha, mul_zero]
    · obtain ⟨c, hc⟩ : ∃ c, m - 1 - p = n + c := ⟨m - 1 - p - n, by omega⟩
      rw [hc]
      calc a ^ p * b ^ (n + c) * (a - b) = a ^ p * b ^ c * (b ^ n * (a - b)) := by ring
        _ = 0 := by rw [hb, mul_zero]

  have res_res : ∀ (U V W : Y.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (s : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom s) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom s := by
    intro U V W h1 h2 s
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl

  have kill : ∀ i J K : Fin (M + 1), ∃ n : ℕ,
      ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x i K)) ^ n *
        ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x i K) -
          (Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (x i J) *
          (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K)) = 0 ∧
      ((Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (x i J) *
          (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K)) ^ n *
        ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x i K) -
          (Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (x i J) *
          (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K)) = 0 := by
    intro i J K
    have hO : IsAffineOpen (D J ⊓ D K) := by
      rw [hx J K]; exact (hD K).basicOpen (x J K)
    have hTO : D i ⊓ D J ⊓ D K ≤ D J ⊓ D K :=
      le_inf (inf_le_left.trans inf_le_right) inf_le_right
    set a := (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x i K) with ha
    set b := (Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (x i J) *
          (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) with hb
    have hδT : (Y.presheaf.map (homOfLE hTO).op).hom (a - b) = 0 := by
      rw [ha, hb, map_sub, map_mul, res_res, res_res, res_res, sub_eq_zero]
      exact hxc i J K
    have kill1 : ∀ f : Γ(Y, D J ⊓ D K), Y.basicOpen f ≤ D i ⊓ D J ⊓ D K →
        ∃ n : ℕ, f ^ n * (a - b) = 0 := by
      intro f hf
      apply exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Y hO
      have h := res_res _ _ _ hTO hf (a - b)
      rw [hδT, map_zero] at h
      exact h.symm
    have hba : Y.basicOpen a ≤ D i ⊓ D J ⊓ D K := by
      rw [ha, Scheme.basicOpen_res, ← hx i K]
      exact le_inf (le_inf (inf_le_right.trans inf_le_left) (inf_le_left.trans inf_le_left))
        (inf_le_left.trans inf_le_right)
    have hbb : Y.basicOpen b ≤ D i ⊓ D J ⊓ D K := by
      rw [hb, Scheme.basicOpen_mul, Scheme.basicOpen_res, ← hx i J]
      refine inf_le_left.trans ?_
      exact le_inf (le_inf (inf_le_right.trans inf_le_left) (inf_le_left.trans inf_le_left))
        (inf_le_left.trans inf_le_right)
    obtain ⟨n₁, hn₁⟩ := kill1 a hba
    obtain ⟨n₂, hn₂⟩ := kill1 b hbb
    refine ⟨n₁ + n₂, ?_, ?_⟩
    · rw [pow_add, mul_right_comm, hn₁, zero_mul]
    · rw [pow_add, mul_assoc, hn₂, mul_zero]
  choose n hn using kill
  refine ⟨Finset.univ.sup (fun t : Fin (M + 1) × Fin (M + 1) × Fin (M + 1) =>
    2 * n t.1 t.2.1 t.2.2), fun m hm => ?_⟩
  intro i J K
  rw [← mul_pow]
  refine ring_pow _ _ (n i J K) (hn i J K).1 (hn i J K).2 m (le_trans ?_ hm)
  exact Finset.le_sup (f := fun t : Fin (M + 1) × Fin (M + 1) × Fin (M + 1) =>
    2 * n t.1 t.2.1 t.2.2) (Finset.mem_univ (i, J, K))

theorem wcpa_dj_scs_twisted_generators {Y : Scheme.{u}} (R : Type u) [CommRing R]
    (M : ℕ) (U₀ : Y.Opens) (φ₀ : R →+* Γ(Y, U₀)) (D : Fin (M + 1) → Y.Opens)
    (hDU : ∀ J, D J ≤ U₀) (x : ∀ J K, Γ(Y, D K)) (hD : ∀ J, IsAffineOpen (D J))
    (hxJJ : ∀ J, x J J = 1) (hx : ∀ J K, D J ⊓ D K = Y.basicOpen (x J K))
    (hxc : ∀ J K K',
      (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x J K') =
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K from
          inf_le_left.trans inf_le_right)).op).hom (x J K) *
        (Y.presheaf.map (homOfLE (show D J ⊓ D K ⊓ D K' ≤ D K' from inf_le_right)).op).hom
          (x K K'))
    (hgen : ∀ K (f : Γ(Y, D K)), ∃ P : MvPolynomial (Fin (M + 1)) R,
      f = MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)
        (fun l => x l K) P)
    (G : Y.Modules) (hG : wcQcoh G) (hGf : ∀ K, Module.Finite Γ(Y, D K) Γ(G, D K))
    (N₀ r : ℕ) (hr : 1 ≤ r) (hNr : N₀ ≤ r) (hpow : ∀ n ≥ N₀, wcpaScPow D x n) (s : ℕ) :
    ∃ (d₀ q : ℕ) (σ : Fin q → ∀ K, Γ(G, D K)),
      wcpaScTw D x G σ (r * d₀ + s) ∧ wcpaScGen φ₀ hDU x r σ :=
by
  classical

  have rG : ∀ {V₁ V₂ V₃ : Y.Opens} (h₁ : V₂ ≤ V₁) (h₂ : V₃ ≤ V₂) (z : Γ(G, V₁)),
      (G.presheaf.map (homOfLE h₂).op).hom ((G.presheaf.map (homOfLE h₁).op).hom z) =
      (G.presheaf.map (homOfLE (h₂.trans h₁)).op).hom z := by
    intro V₁ V₂ V₃ h₁ h₂ z
    show _ = (G.presheaf.map ((homOfLE h₁).op ≫ (homOfLE h₂).op)).hom z
    rw [Functor.map_comp]; rfl
  have rY : ∀ {V₁ V₂ V₃ : Y.Opens} (h₁ : V₂ ≤ V₁) (h₂ : V₃ ≤ V₂) (z : Γ(Y, V₁)),
      (Y.presheaf.map (homOfLE h₂).op).hom ((Y.presheaf.map (homOfLE h₁).op).hom z) =
      (Y.presheaf.map (homOfLE (h₂.trans h₁)).op).hom z := by
    intro V₁ V₂ V₃ h₁ h₂ z
    show _ = (Y.presheaf.map ((homOfLE h₁).op ≫ (homOfLE h₂).op)).hom z
    rw [Functor.map_comp]; rfl
  have smG : ∀ {V₁ V₂ : Y.Opens} (h₁ : V₂ ≤ V₁) (a : Γ(Y, V₁)) (z : Γ(G, V₁)),
      (G.presheaf.map (homOfLE h₁).op).hom (a • z) =
        (Y.presheaf.map (homOfLE h₁).op).hom a • (G.presheaf.map (homOfLE h₁).op).hom z :=
    fun h₁ a z => Scheme.Modules.map_smul G (homOfLE h₁) a z
  have P3V : ∀ (a b c : Fin (M + 1)) (V : Y.Opens) (ha : V ≤ D a) (hb : V ≤ D b)
      (hc : V ≤ D c),
      (Y.presheaf.map (homOfLE hc).op).hom (x a c) =
        (Y.presheaf.map (homOfLE hb).op).hom (x a b) *
          (Y.presheaf.map (homOfLE hc).op).hom (x b c) := by
    intro a b c V ha hb hc
    have h4 := congrArg (Y.presheaf.map (homOfLE (le_inf (le_inf ha hb) hc :
      V ≤ D a ⊓ D b ⊓ D c)).op).hom (hxc a b c)
    rw [map_mul, rY, rY, rY] at h4
    exact h4
  have qc1 : ∀ (U : Y.Opens), IsAffineOpen U → ∀ (f : Γ(Y, U)) (V : Y.Opens) (hVU : V ≤ U),
      V = Y.basicOpen f → ∀ s : Γ(G, V), ∃ (n : ℕ) (t : Γ(G, U)),
        ((Y.presheaf.map (homOfLE hVU).op).hom f) ^ n • s =
          (G.presheaf.map (homOfLE hVU).op).hom t := by
    intro U hU f V hVU hV
    subst hV
    exact (hG U hU f).1
  have qc2 : ∀ (U : Y.Opens), IsAffineOpen U → ∀ (f : Γ(Y, U)) (V : Y.Opens) (hVU : V ≤ U),
      V = Y.basicOpen f → ∀ t : Γ(G, U), (G.presheaf.map (homOfLE hVU).op).hom t = 0 →
        ∃ n : ℕ, f ^ n • t = 0 := by
    intro U hU f V hVU hV
    subst hV
    exact (hG U hU f).2

  have key : ∀ (K₀ : Fin (M + 1)) (e₀ : Γ(G, D K₀)), ∃ B : ℕ, ∀ n ≥ B,
      ∃ τ : ∀ L, Γ(G, D L), τ K₀ = e₀ ∧ ∀ J K,
        (G.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (τ K) =
          (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) ^ n •
            (G.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (τ J) := by
    intro K₀ e₀
    have ha : ∀ L, ∃ (n : ℕ) (z : Γ(G, D L)),
        ((Y.presheaf.map (homOfLE (inf_le_right : D K₀ ⊓ D L ≤ D L)).op).hom (x K₀ L)) ^ n •
          (G.presheaf.map (homOfLE (inf_le_left : D K₀ ⊓ D L ≤ D K₀)).op).hom e₀ =
        (G.presheaf.map (homOfLE (inf_le_right : D K₀ ⊓ D L ≤ D L)).op).hom z :=
      fun L => qc1 _ (hD L) _ _ inf_le_right (hx K₀ L) _
    choose n z hz using ha
    obtain ⟨nS, hnS⟩ : ∃ m : ℕ, ∀ L, n L ≤ m :=
      ⟨Finset.univ.sup n, fun L => Finset.le_sup (f := n) (Finset.mem_univ L)⟩
    have hy' : ∀ L, (G.presheaf.map (homOfLE (inf_le_right : D K₀ ⊓ D L ≤ D L)).op).hom
          ((x K₀ L) ^ (nS - n L) • z L) =
        ((Y.presheaf.map (homOfLE (inf_le_right : D K₀ ⊓ D L ≤ D L)).op).hom (x K₀ L)) ^ nS •
          (G.presheaf.map (homOfLE (inf_le_left : D K₀ ⊓ D L ≤ D K₀)).op).hom e₀ := by
      intro L
      rw [smG, map_pow, ← hz L, smul_smul, ← pow_add, Nat.sub_add_cancel (hnS L)]
    obtain ⟨y, hyk, hy⟩ : ∃ y : ∀ L, Γ(G, D L), y K₀ = e₀ ∧ ∀ L,
        (G.presheaf.map (homOfLE (inf_le_right : D K₀ ⊓ D L ≤ D L)).op).hom (y L) =
        ((Y.presheaf.map (homOfLE (inf_le_right : D K₀ ⊓ D L ≤ D L)).op).hom (x K₀ L)) ^ nS •
          (G.presheaf.map (homOfLE (inf_le_left : D K₀ ⊓ D L ≤ D K₀)).op).hom e₀ := by
      refine ⟨Function.update (fun L => (x K₀ L) ^ (nS - n L) • z L) K₀ e₀,
        Function.update_self _ _ _, fun L => ?_⟩
      by_cases hL : L = K₀
      · subst hL
        rw [Function.update_self, hxJJ, map_one, one_pow, one_smul]
      · rw [Function.update_of_ne hL]
        exact hy' L
    have hyV : ∀ L (V : Y.Opens) (h1 : V ≤ D L) (h2 : V ≤ D K₀),
        (G.presheaf.map (homOfLE h1).op).hom (y L) =
          ((Y.presheaf.map (homOfLE h1).op).hom (x K₀ L)) ^ nS •
            (G.presheaf.map (homOfLE h2).op).hom e₀ := by
      intro L V h1 h2
      have h3 := congrArg (G.presheaf.map (homOfLE (le_inf h2 h1 :
        V ≤ D K₀ ⊓ D L)).op).hom (hy L)
      rw [smG, map_pow, rG, rY, rG] at h3
      exact h3
    have hC : ∀ J K, ∃ c : ℕ,
        ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x K₀ K)) ^ c •
        ((G.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (y K) -
          ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K)) ^ nS •
          (G.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (y J)) = 0 := by
      intro J K
      have hW : IsAffineOpen (D J ⊓ D K) := by
        rw [hx J K]; exact (hD K).basicOpen _
      have hK' : (D J ⊓ D K) ⊓ (D K₀ ⊓ D K) ≤ D K₀ := le_trans inf_le_right inf_le_left
      have hJ' : (D J ⊓ D K) ⊓ (D K₀ ⊓ D K) ≤ D J := le_trans inf_le_left inf_le_left
      have hKK : (D J ⊓ D K) ⊓ (D K₀ ⊓ D K) ≤ D K := le_trans inf_le_left inf_le_right
      refine qc2 _ hW _ ((D J ⊓ D K) ⊓ (D K₀ ⊓ D K)) inf_le_left ?_ _ ?_
      · have e1 := Scheme.basicOpen_res Y (x K₀ K)
          (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op
        rw [← hx K₀ K] at e1
        exact e1.symm
      · rw [map_sub, smG, map_pow, rG, rG, rY, hyV K _ hKK hK', hyV J _ hJ' hK',
          P3V K₀ J K _ hK' hJ' hKK, mul_pow, smul_smul, mul_comm]
        exact sub_self _
    choose c hc using hC
    obtain ⟨cS, hcS⟩ : ∃ m : ℕ, ∀ J K, c J K ≤ m :=
      ⟨Finset.univ.sup (fun p : Fin (M + 1) × Fin (M + 1) => c p.1 p.2), fun J K =>
        Finset.le_sup (f := fun p : Fin (M + 1) × Fin (M + 1) => c p.1 p.2)
          (Finset.mem_univ (J, K))⟩
    refine ⟨nS + (cS + N₀), fun nn hnn => ?_⟩
    obtain ⟨a, rfl⟩ : ∃ a, nn = nS + a := ⟨nn - nS, by omega⟩
    refine ⟨fun L => (x K₀ L) ^ a • y L, ?_, ?_⟩
    · show (x K₀ K₀) ^ a • y K₀ = e₀
      rw [hxJJ, one_pow, one_smul, hyk]
    · intro J K
      have hca : c J K ≤ a := by have := hcS J K; omega
      have hNa : N₀ ≤ a := by omega
      obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hca
      have h1 := hc J K
      have h2 : ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom
            (x K₀ K)) ^ a •
          ((G.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (y K) -
            ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom
              (x J K)) ^ nS •
            (G.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (y J)) = 0 := by
        rw [hd, pow_add, mul_comm _ (_ ^ d), mul_smul, h1, smul_zero]
      rw [smul_sub, smul_smul, sub_eq_zero] at h2
      dsimp only
      rw [smG, smG, map_pow, map_pow, h2, smul_smul, (hpow a hNa) K₀ J K]
      congr 1
      ring

  have split : ∀ (K : Fin (M + 1)) (P : MvPolynomial (Fin (M + 1)) R),
      ∃ Q : (Fin (M + 1) → Fin r) → MvPolynomial (Fin (M + 1)) R,
        MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)
            (fun l => x l K) P =
          ∑ γ : Fin (M + 1) → Fin r, (∏ i, x i K ^ (γ i : ℕ)) *
            MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)
              (fun i => x i K ^ r) (Q γ) := by
    intro K P
    induction P using MvPolynomial.induction_on' with
    | monomial μ a =>
      obtain ⟨γ₀, hγ₀⟩ : ∃ γ₀ : Fin (M + 1) → Fin r, ∀ i, (γ₀ i : ℕ) = μ i % r :=
        ⟨fun i => ⟨μ i % r, Nat.mod_lt _ hr⟩, fun i => rfl⟩
      obtain ⟨ν, hν⟩ : ∃ ν : Fin (M + 1) →₀ ℕ, ∀ i, ν i = μ i / r :=
        ⟨Finsupp.mapRange (fun t => t / r) (Nat.zero_div r) μ,
          fun i => Finsupp.mapRange_apply (hf := Nat.zero_div r)⟩
      refine ⟨fun γ => if γ = γ₀ then MvPolynomial.monomial ν a else 0, ?_⟩
      beta_reduce
      rw [Finset.sum_eq_single γ₀ (fun γ _ hγ => by
          simp only [hγ, if_false, MvPolynomial.eval₂_zero, mul_zero])
        (fun h => absurd (Finset.mem_univ _) h), if_pos rfl,
        MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial,
        Finsupp.prod_fintype _ _ (fun i => pow_zero _),
        Finsupp.prod_fintype _ _ (fun i => pow_zero _), mul_left_comm,
        ← Finset.prod_mul_distrib]
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      beta_reduce
      rw [hγ₀ i, hν i, ← pow_mul, ← pow_add, Nat.mod_add_div]
    | add p q hp hq =>
      obtain ⟨Qp, hQp⟩ := hp
      obtain ⟨Qq, hQq⟩ := hq
      refine ⟨fun γ => Qp γ + Qq γ, ?_⟩
      rw [MvPolynomial.eval₂_add, hQp, hQq, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [MvPolynomial.eval₂_add, mul_add]

  have hPEv : ∀ {q : ℕ} (σ : Fin q → ∀ K, Γ(G, D K)) (K : Fin (M + 1))
      (f : Fin q → MvPolynomial (Fin (M + 1)) R),
      wcpaScPEv φ₀ hDU x r σ K f =
        ∑ ρ, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)
          (fun i => x i K ^ r) (f ρ) • σ ρ K := by
    intro q σ K f
    unfold wcpaScPEv wcKlmPEv
    simp only [MvPolynomial.eval₂_eq', Finset.sum_smul]

  have hgens : ∀ K, ∃ (nk : ℕ) (gen : Fin nk → Γ(G, D K)),
      Submodule.span Γ(Y, D K) (Set.range gen) = ⊤ := by
    intro K
    have := hGf K
    exact Module.Finite.exists_fin
  choose nk gen hgen' using hgens
  obtain ⟨T, hT⟩ : ∃ m : ℕ, ∀ K, nk K ≤ m :=
    ⟨Finset.univ.sup nk, fun K => Finset.le_sup (f := nk) (Finset.mem_univ K)⟩
  let gs : ∀ K, Fin T → Γ(G, D K) := fun K j =>
    if h : (j : ℕ) < nk K then gen K ⟨j, h⟩ else 0
  have hgs : ∀ K, Submodule.span Γ(Y, D K) (Set.range (gs K)) = ⊤ := by
    intro K
    rw [eq_top_iff, ← hgen' K]
    apply Submodule.span_mono
    rintro _ ⟨i, rfl⟩
    have hi : (i : ℕ) < T := lt_of_lt_of_le i.2 (hT K)
    refine ⟨⟨i, hi⟩, ?_⟩
    show (if h : (i : ℕ) < nk K then gen K ⟨i, h⟩ else 0) = gen K i
    rw [dif_pos i.2]

  have hB : ∀ p : Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r), ∃ B : ℕ, ∀ n ≥ B,
      ∃ τ : ∀ L, Γ(G, D L), τ p.1 = (∏ i, x i p.1 ^ (p.2.2 i : ℕ)) • gs p.1 p.2.1 ∧ ∀ J K,
        (G.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (τ K) =
          (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) ^ n •
            (G.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (τ J) :=
    fun p => key p.1 _
  choose B hB using hB
  obtain ⟨d₀, hd₀⟩ : ∃ m : ℕ, ∀ p, B p ≤ m :=
    ⟨Finset.univ.sup B, fun p => Finset.le_sup (f := B) (Finset.mem_univ p)⟩
  have hτ : ∀ p : Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r),
      ∃ τ : ∀ L, Γ(G, D L), τ p.1 = (∏ i, x i p.1 ^ (p.2.2 i : ℕ)) • gs p.1 p.2.1 ∧ ∀ J K,
        (G.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (τ K) =
          (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) ^
            (r * d₀ + s) •
            (G.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom (τ J) := by
    intro p
    refine hB p _ ?_
    have h1 := hd₀ p
    have h2 : d₀ ≤ r * d₀ := Nat.le_mul_of_pos_left _ hr
    omega
  choose τ hτ1 hτ2 using hτ
  refine ⟨d₀, Fintype.card (Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r)),
    fun ρ => τ ((Fintype.equivFin (Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r))).symm ρ),
    ?_, ?_⟩
  · unfold wcpaScTw
    intro ρ J K
    exact hτ2 _ J K
  · unfold wcpaScGen
    intro K g
    have hg : g ∈ Submodule.span Γ(Y, D K) (Set.range (gs K)) := by
      rw [hgs K]; trivial
    obtain ⟨cc, hcc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hg
    have hQ : ∀ j : Fin T, ∃ Q : (Fin (M + 1) → Fin r) → MvPolynomial (Fin (M + 1)) R,
        cc j = ∑ γ : Fin (M + 1) → Fin r, (∏ i, x i K ^ (γ i : ℕ)) *
          MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)
            (fun i => x i K ^ r) (Q γ) := by
      intro j
      obtain ⟨P, hP⟩ := hgen K (cc j)
      obtain ⟨Q, hQ⟩ := split K P
      exact ⟨Q, hP.trans hQ⟩
    choose Q hQ using hQ
    have hτ1' : ∀ j γ, τ (K, j, γ) K = (∏ i, x i K ^ (γ i : ℕ)) • gs K j :=
      fun j γ => hτ1 (K, j, γ)
    refine ⟨fun ρ => if ((Fintype.equivFin
        (Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r))).symm ρ).1 = K then
      Q ((Fintype.equivFin (Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r))).symm ρ).2.1
        ((Fintype.equivFin (Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r))).symm ρ).2.2
      else 0, ?_⟩
    rw [hPEv, Equiv.sum_comp (Fintype.equivFin
        (Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r))).symm
      (fun p : Fin (M + 1) × Fin T × (Fin (M + 1) → Fin r) =>
        MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (hDU K)).op).hom.comp φ₀)
          (fun i => x i K ^ r) (if p.1 = K then Q p.2.1 p.2.2 else 0) • τ p K)]
    simp only [Fintype.sum_prod_type]
    rw [Fintype.sum_eq_single K (fun K' hK' => by simp [hK'])]
    rw [← hcc]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hQ j, Finset.sum_smul]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [if_pos rfl, hτ1' j γ, smul_smul, mul_comm]

theorem wcpa_dj_scs_chart_change {Y : Scheme.{u}} (R : Type u) [CommRing R]
    (M : ℕ) (U₀ : Y.Opens) (φ₀ : R →+* Γ(Y, U₀)) (D : Fin (M + 1) → Y.Opens)
    (hDU : ∀ J, D J ≤ U₀) (x : ∀ J K, Γ(Y, D K)) (G : Y.Modules) (r n q : ℕ)
    (σ : Fin q → ∀ K, Γ(G, D K)) (hpow : wcpaScPow D x r) (htw : wcpaScTw D x G σ n) :
    wcpaScChg φ₀ hDU x r n σ :=
by
  intro J K t f hf
  have hsm : ∀ {U V : Y.Opens} (i : U ⟶ V) (a : Γ(Y, V)) (m : Γ(G, V)),
      (G.presheaf.map i.op).hom (a • m) =
        (Y.presheaf.map i.op).hom a • (G.presheaf.map i.op).hom m :=
    fun i a m => Scheme.Modules.map_smul G i a m
  have hc : ∀ a : Γ(Y, U₀),
      (Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom
          ((Y.presheaf.map (homOfLE (hDU K)).op).hom a) =
        (Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom
          ((Y.presheaf.map (homOfLE (hDU J)).op).hom a) := by
    intro a
    show (Y.presheaf.map (homOfLE (hDU K)).op ≫
        Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom a =
      (Y.presheaf.map (homOfLE (hDU J)).op ≫
        Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom a
    rw [← Functor.map_comp, ← Functor.map_comp]
    rfl
  unfold wcpaScPEv wcKlmPEv
  simp only [map_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl (fun ρ _ => Finset.sum_congr rfl (fun μ hμ => ?_))
  simp only [hsm]
  rw [htw ρ J K, smul_smul, smul_smul]
  congr 1
  have hdeg : ∑ i, μ i = t := by
    have h1 := hf ρ (MvPolynomial.mem_support_iff.mp hμ)
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
  have hprod : ∏ i, ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom
        (x i K) ^ r) ^ μ i =
      (∏ i, ((Y.presheaf.map (homOfLE (inf_le_left : D J ⊓ D K ≤ D J)).op).hom
        (x i J) ^ r) ^ μ i) *
      ((Y.presheaf.map (homOfLE (inf_le_right : D J ⊓ D K ≤ D K)).op).hom (x J K) ^ r) ^ t := by
    rw [← hdeg, ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i _ => by rw [hpow i J K, mul_pow])
  simp only [RingHom.coe_comp, Function.comp_apply, map_mul, map_prod, map_pow]
  rw [hc, hprod, pow_add, pow_mul]
  ring

theorem wcpa_dj_scs_chart_surj {Y : Scheme.{u}} (R : Type u) [CommRing R]
    (M : ℕ) (U₀ : Y.Opens) (φ₀ : R →+* Γ(Y, U₀)) (D : Fin (M + 1) → Y.Opens)
    (hDU : ∀ J, D J ≤ U₀) (x : ∀ J K, Γ(Y, D K)) (hD : ∀ J, IsAffineOpen (D J))
    (hx : ∀ J K, D J ⊓ D K = Y.basicOpen (x J K)) (G : Y.Modules) (hG : wcQcoh G)
    (r q : ℕ) (σ : Fin q → ∀ K, Γ(G, D K)) (hr : 1 ≤ r) (hgen : wcpaScGen φ₀ hDU x r σ) :
    wcpaScSurj φ₀ hDU x r σ :=
by
  unfold wcpaScGen at hgen
  unfold wcpaScSurj
  intro k l c
  have hO : D k ⊓ D l = Y.basicOpen (x l k) := (inf_comm _ _).trans (hx l k)
  have resG : ∀ {U V W : Y.Opens} (h1 : V ≤ W) (h2 : W ≤ U) (h3 : V ≤ U) (m : Γ(G, U)),
      (G.presheaf.map (homOfLE h1).op).hom ((G.presheaf.map (homOfLE h2).op).hom m) =
        (G.presheaf.map (homOfLE h3).op).hom m := by
    intro U V W h1 h2 h3 m
    have e : G.presheaf.map (homOfLE h2).op ≫ G.presheaf.map (homOfLE h1).op =
        G.presheaf.map (homOfLE h3).op := by
      rw [← Functor.map_comp]; rfl
    rw [← e]; rfl
  have resY : ∀ {U V W : Y.Opens} (h1 : V ≤ W) (h2 : W ≤ U) (h3 : V ≤ U) (m : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h1).op).hom ((Y.presheaf.map (homOfLE h2).op).hom m) =
        (Y.presheaf.map (homOfLE h3).op).hom m := by
    intro U V W h1 h2 h3 m
    have e : Y.presheaf.map (homOfLE h2).op ≫ Y.presheaf.map (homOfLE h1).op =
        Y.presheaf.map (homOfLE h3).op := by
      rw [← Functor.map_comp]; rfl
    rw [← e]; rfl
  have resId : ∀ {U : Y.Opens} (h : U ≤ U) (m : Γ(G, U)),
      (G.presheaf.map (homOfLE h).op).hom m = m := by
    intro U h m
    have e : (homOfLE h).op = 𝟙 (Opposite.op U) := Subsingleton.elim _ _
    rw [e, CategoryTheory.Functor.map_id]; rfl
  obtain ⟨n₁, t, ht⟩ := (hG (D k) (hD k) (x l k)).1
    ((G.presheaf.map (homOfLE hO.ge).op).hom c)
  have E2 : ((Y.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom (x l k)) ^ n₁ • c =
      (G.presheaf.map (homOfLE (inf_le_left : D k ⊓ D l ≤ D k)).op).hom t := by
    have h1 := congrArg (G.presheaf.map (homOfLE hO.le).op).hom ht
    rw [Scheme.Modules.map_smul, map_pow, resY hO.le (Y.basicOpen_le (x l k)) inf_le_left,
      resG hO.le hO.ge le_rfl, resId, resG hO.le (Y.basicOpen_le (x l k)) inf_le_left] at h1
    exact h1
  obtain ⟨r', rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by omega⟩
  obtain ⟨f, hf⟩ := hgen k ((x l k) ^ (r' * n₁) • t)
  refine ⟨n₁, f, ?_⟩
  rw [← hf, Scheme.Modules.map_smul, map_pow, ← E2, smul_smul, ← pow_mul, ← pow_add,
    show (r' + 1) * n₁ = r' * n₁ + n₁ by ring]

theorem wcpa_dj_scs_saturate {Y : Scheme.{u}} (R : Type u) [CommRing R]
    (M : ℕ) (U₀ : Y.Opens) (φ₀ : R →+* Γ(Y, U₀)) (D : Fin (M + 1) → Y.Opens)
    (hDU : ∀ J, D J ≤ U₀) (x : ∀ J K, Γ(Y, D K)) (hD : ∀ J, IsAffineOpen (D J))
    (hxJJ : ∀ J, x J J = 1) (hx : ∀ J K, D J ⊓ D K = Y.basicOpen (x J K))
    (G : Y.Modules) (hG : wcQcoh G) (r n q : ℕ) (σ : Fin q → ∀ K, Γ(G, D K)) (hr : 1 ≤ r)
    (hchg : wcpaScChg φ₀ hDU x r n σ) :
    wcpaScSat φ₀ hDU x r σ :=
by
  classical

  have pevX1 : ∀ (K i : Fin (M + 1)) (f : Fin q → MvPolynomial (Fin (M + 1)) R),
      wcpaScPEv φ₀ hDU x r σ K (fun ρ => MvPolynomial.X i * f ρ) =
        x i K ^ r • wcpaScPEv φ₀ hDU x r σ K f := by
    intro K i f
    simp only [wcpaScPEv, wcKlmPEv]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [MvPolynomial.support_X_mul, Finset.sum_map, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    simp only [addLeftEmbedding_apply]
    rw [MvPolynomial.coeff_X_mul, smul_smul]
    congr 1
    have hp : ∀ (v : Fin (M + 1) → Γ(Y, D K)),
        ∏ i', v i' ^ ((Finsupp.single i 1 + μ : Fin (M + 1) →₀ ℕ) i') =
          v i * ∏ i', v i' ^ μ i' := by
      intro v
      simp only [Finsupp.add_apply, pow_add, Finset.prod_mul_distrib]
      congr 1
      rw [Fintype.prod_eq_single i (fun i' hi' => by simp [Finsupp.single_apply, Ne.symm hi'])]
      simp
    rw [hp (fun i' => x i' K ^ r)]
    ring
  have pevXn : ∀ (K i : Fin (M + 1)) (m : ℕ) (f : Fin q → MvPolynomial (Fin (M + 1)) R),
      wcpaScPEv φ₀ hDU x r σ K (fun ρ => MvPolynomial.X i ^ m * f ρ) =
        (x i K ^ r) ^ m • wcpaScPEv φ₀ hDU x r σ K f := by
    intro K i m
    induction m with
    | zero => intro f; simp
    | succ m ih =>
      intro f
      have e : (fun ρ => (MvPolynomial.X i : MvPolynomial (Fin (M + 1)) R) ^ (m + 1) * f ρ) =
          fun ρ => MvPolynomial.X i * (MvPolynomial.X i ^ m * f ρ) := by
        funext ρ; ring
      rw [e, pevX1, ih, smul_smul, ← pow_succ']
  have pev3 : ∀ (K a b c : Fin (M + 1)) (m : ℕ) (f : Fin q → MvPolynomial (Fin (M + 1)) R),
      wcpaScPEv φ₀ hDU x r σ K
          (fun ρ => (MvPolynomial.X a * MvPolynomial.X b * MvPolynomial.X c) ^ m * f ρ) =
        ((x a K ^ r) ^ m * (x b K ^ r) ^ m * (x c K ^ r) ^ m) • wcpaScPEv φ₀ hDU x r σ K f := by
    intro K a b c m f
    have h1 := pevXn K a m (fun ρ => MvPolynomial.X b ^ m * (MvPolynomial.X c ^ m * f ρ))
    have h2 := pevXn K b m (fun ρ => MvPolynomial.X c ^ m * f ρ)
    have h3 := pevXn K c m f
    have e : (fun ρ => (MvPolynomial.X a * MvPolynomial.X b * MvPolynomial.X c :
          MvPolynomial (Fin (M + 1)) R) ^ m * f ρ) =
        fun ρ => MvPolynomial.X a ^ m * (MvPolynomial.X b ^ m * (MvPolynomial.X c ^ m * f ρ)) := by
      funext ρ; ring
    rw [e, h1, h2, h3, smul_smul, smul_smul]

  have kill : ∀ (U V : Y.Opens), IsAffineOpen U → ∀ (a : Γ(Y, U)) (hVU : V ≤ U),
      Y.basicOpen a ≤ V → ∀ s : Γ(G, U), (G.presheaf.map (homOfLE hVU).op).hom s = 0 →
      ∃ m : ℕ, a ^ m • s = 0 := by
    intro U V hU a hVU hb s hs
    refine (hG U hU a).2 s ?_
    have e : G.presheaf.map (homOfLE (Y.basicOpen_le a)).op =
        G.presheaf.map (homOfLE hVU).op ≫ G.presheaf.map (homOfLE hb).op := by
      rw [← Functor.map_comp]; rfl
    rw [e]
    simp [hs]
  intro k l j t f hf hzero

  have hb : Y.basicOpen (x l k * x j k) ≤ D k ⊓ D l ⊓ D j := by
    rw [Scheme.basicOpen_mul, ← hx l k, ← hx j k]
    exact le_inf (le_inf (inf_le_left.trans inf_le_right) (inf_le_left.trans inf_le_left))
      (inf_le_right.trans inf_le_left)
  obtain ⟨N₁, hN₁⟩ := kill (D k) (D k ⊓ D l ⊓ D j) (hD k) (x l k * x j k)
    (inf_le_left.trans inf_le_left) hb _ hzero

  obtain ⟨g, hgdef⟩ : ∃ g : Fin q → MvPolynomial (Fin (M + 1)) R,
      g = fun ρ => (MvPolynomial.X k * MvPolynomial.X l * MvPolynomial.X j) ^ N₁ * f ρ :=
    ⟨_, rfl⟩
  have hgh : ∀ ρ, (g ρ).IsHomogeneous ((1 + 1 + 1) * N₁ + t) := by
    intro ρ
    rw [hgdef]
    exact ((((MvPolynomial.isHomogeneous_X R k).mul (MvPolynomial.isHomogeneous_X R l)).mul
      (MvPolynomial.isHomogeneous_X R j)).pow N₁).mul (hf ρ)
  have hg0 : wcpaScPEv φ₀ hDU x r σ k g = 0 := by
    rw [hgdef, pev3, hxJJ k]
    have e : ((1 : Γ(Y, D k)) ^ r) ^ N₁ * (x l k ^ r) ^ N₁ * (x j k ^ r) ^ N₁ =
        ((x l k * x j k) ^ N₁) ^ (r - 1) * (x l k * x j k) ^ N₁ := by
      rw [← pow_succ, Nat.sub_add_cancel hr]; ring
    rw [e, mul_smul, hN₁, smul_zero]

  have htr : ∀ J, ∃ m : ℕ, x k J ^ m • wcpaScPEv φ₀ hDU x r σ J g = 0 := by
    intro J
    have h := hchg k J _ g hgh
    rw [hg0, map_zero, smul_zero] at h
    exact kill (D J) (D k ⊓ D J) (hD J) (x k J) inf_le_right (hx k J).ge _ h
  choose mJ hmJ using htr

  refine ⟨N₁ + Finset.univ.sup mJ, fun J => ?_⟩
  have e : (fun ρ => (MvPolynomial.X k * MvPolynomial.X l * MvPolynomial.X j :
        MvPolynomial (Fin (M + 1)) R) ^ (N₁ + Finset.univ.sup mJ) * f ρ) =
      fun ρ => (MvPolynomial.X k * MvPolynomial.X l * MvPolynomial.X j) ^ (Finset.univ.sup mJ) *
        g ρ := by
    funext ρ; rw [hgdef]; ring
  rw [e, pev3]
  have hle : mJ J ≤ Finset.univ.sup mJ := Finset.le_sup (Finset.mem_univ J)
  have hmle : mJ J ≤ r * Finset.univ.sup mJ := by nlinarith
  have h1 : (x k J ^ r) ^ (Finset.univ.sup mJ) =
      x k J ^ (r * Finset.univ.sup mJ - mJ J) * x k J ^ mJ J := by
    rw [← pow_mul, ← pow_add, Nat.sub_add_cancel hmle]
  rw [h1]
  have e2 : x k J ^ (r * Finset.univ.sup mJ - mJ J) * x k J ^ mJ J *
        (x l J ^ r) ^ (Finset.univ.sup mJ) * (x j J ^ r) ^ (Finset.univ.sup mJ) =
      (x k J ^ (r * Finset.univ.sup mJ - mJ J) * (x l J ^ r) ^ (Finset.univ.sup mJ) *
        (x j J ^ r) ^ (Finset.univ.sup mJ)) * x k J ^ mJ J := by ring
  rw [e2, mul_smul, hmJ J, smul_zero]

theorem wcpa_dj_scs_laurent_model {Y : Scheme.{u}} (R : Type u) [CommRing R]
    (M : ℕ) (U₀ : Y.Opens) (φ₀ : R →+* Γ(Y, U₀)) (D : Fin (M + 1) → Y.Opens)
    (hDU : ∀ J, D J ≤ U₀) (x : ∀ J K, Γ(Y, D K))
    (hxJJ : ∀ J, x J J = 1) (hx : ∀ J K, D J ⊓ D K = Y.basicOpen (x J K))
    (G : Y.Modules) (r d₀ s q : ℕ) (σ : Fin q → ∀ K, Γ(G, D K)) (hr : 1 ≤ r)
    (hpow : wcpaScPow D x r) (hchg : wcpaScChg φ₀ hDU x r (r * d₀ + s) σ)
    (hsurj : wcpaScSurj φ₀ hDU x r σ) (hsat : wcpaScSat φ₀ hDU x r σ) :
    ∃ (K : Submodule (MvPolynomial (Fin (M + 1)) R) (Fin q → MvPolynomial (Fin (M + 1)) R))
      (Θ1 : ∀ k, (Fin q → (Fin (M + 1) → ℤ) →₀ R) → Γ(G, D k))
      (Θ2 : ∀ k l, (Fin q → (Fin (M + 1) → ℤ) →₀ R) → Γ(G, D k ⊓ D l))
      (Θ3 : ∀ k l j, (Fin q → (Fin (M + 1) → ℤ) →₀ R) → Γ(G, D k ⊓ D l ⊓ D j)),
      (∀ f ∈ K, ∀ t : ℕ, (fun ρ => if d₀ ≤ t then
        MvPolynomial.homogeneousComponent (t - d₀) (f ρ) else 0) ∈ K) ∧
      ∀ w : ℕ, wcpaScModel D (wcpaScE D x (r * w + s)) G R q (fun _ => d₀) K ⊤ Θ1 Θ2 Θ3 w :=
by
  classical

  have pevEq : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A →+* T) (u : Fin N → T) (ℓ : Fin Q → V)
      (f : Fin Q → MvPolynomial (Fin N) A),
      wcKlmPEv (⇑α) u ℓ f = ∑ ρ, MvPolynomial.eval₂ α u (f ρ) • ℓ ρ := by
    intro A T V _ _ _ _ N Q α u ℓ f
    unfold wcKlmPEv
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [MvPolynomial.eval₂_eq', Finset.sum_smul]
  have evAdd : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A →+* T) (u : Fin N → T) (ℓ : Fin Q → V)
      (v v' : Fin Q → (Fin N → ℤ) →₀ A),
      wcKlmEv (⇑α) u ℓ (v + v') = wcKlmEv (⇑α) u ℓ v + wcKlmEv (⇑α) u ℓ v' := by
    intro A T V _ _ _ _ N Q α u ℓ v v'
    unfold wcKlmEv
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.add_apply, Finsupp.sum_add_index' (fun _ => by simp)
      (fun _ _ _ => by rw [map_add, add_mul, add_smul])]
  have evZero : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A →+* T) (u : Fin N → T) (ℓ : Fin Q → V),
      wcKlmEv (⇑α) u ℓ (0 : Fin Q → (Fin N → ℤ) →₀ A) = 0 := by
    intro A T V _ _ _ _ N Q α u ℓ
    unfold wcKlmEv
    simp
  have evSmul : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A →+* T) (u : Fin N → T) (ℓ : Fin Q → V) (a : A)
      (v : Fin Q → (Fin N → ℤ) →₀ A),
      wcKlmEv (⇑α) u ℓ (a • v) = α a • wcKlmEv (⇑α) u ℓ v := by
    intro A T V _ _ _ _ N Q α u ℓ a v
    unfold wcKlmEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.smul_apply, Finsupp.sum_smul_index' (fun _ => by simp), Finsupp.smul_sum]
    refine Finsupp.sum_congr (fun β _ => ?_)
    rw [smul_eq_mul, map_mul, mul_assoc, mul_smul]
  have evScaleL : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A → T) (u : Fin N → T) (ℓ : Fin Q → V) (t : T)
      (v : Fin Q → (Fin N → ℤ) →₀ A),
      wcKlmEv α u (fun ρ => t • ℓ ρ) v = t • wcKlmEv α u ℓ v := by
    intro A T V _ _ _ _ N Q α u ℓ t v
    unfold wcKlmEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Finsupp.smul_sum]
    refine Finsupp.sum_congr (fun β _ => ?_)
    rw [smul_comm]

  have evMap : ∀ {A T T' V V' : Type u} [CommRing A] [CommRing T] [CommRing T']
      [AddCommGroup V] [Module T V] [AddCommGroup V'] [Module T' V'] {N Q : ℕ}
      (φ : T →+* T') (π : V →+ V'), (∀ (t : T) (z : V), π (t • z) = φ t • π z) →
      ∀ (α : A → T) (u : Fin N → T) (ℓ : Fin Q → V) (v : Fin Q → (Fin N → ℤ) →₀ A),
      (∀ ρ, ∀ β ∈ (v ρ).support, ∀ i, 0 ≤ β i ∨ IsUnit (u i)) →
      π (wcKlmEv α u ℓ v) =
        wcKlmEv (fun c => φ (α c)) (fun i => φ (u i)) (fun ρ => π (ℓ ρ)) v := by
    intro A T T' V V' _ _ _ _ _ _ _ N Q φ π hπ α u ℓ v hu
    have hLP : ∀ β : Fin N → ℤ, (∀ i, 0 ≤ β i ∨ IsUnit (u i)) →
        φ (wcKlmLP u β) = wcKlmLP (fun i => φ (u i)) β := by
      intro β hβ
      unfold wcKlmLP
      rw [map_prod]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow, map_pow]
      dsimp only
      rcases hβ i with h0 | h0
      · have : (-β i).toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
        rw [this, pow_zero, pow_zero]
      · obtain ⟨υ, hυ⟩ := h0
        rw [← hυ, Ring.inverse_unit]
        have h1 : φ (↑υ⁻¹ : T) = ((Units.map φ.toMonoidHom υ)⁻¹ : T'ˣ) := by
          simp
        have h2 : φ (υ : T) = (Units.map φ.toMonoidHom υ : T'ˣ) := by simp
        rw [h1, h2, Ring.inverse_unit]
    unfold wcKlmEv
    rw [map_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [map_finsuppSum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    rw [hπ, map_mul, hLP β (hu ρ β hβ)]

  have evChart : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V]
      [Module T V] {N Q : ℕ} (α : A → T) (u u' : Fin N → T) (ℓ ℓ' : Fin Q → V) (c : T)
      (w e0 : ℕ) (v : Fin Q → (Fin N → ℤ) →₀ A),
      IsUnit c → (∀ i, u i = c * u' i) →
      (∀ ρ, ∀ β ∈ (v ρ).support, ∑ i, β i = (w : ℤ) - (e0 : ℤ)) →
      (∀ ρ, ∀ β ∈ (v ρ).support, α (v ρ β) • ℓ ρ = α (v ρ β) • (c ^ e0 • ℓ' ρ)) →
      wcKlmEv α u ℓ v = c ^ w • wcKlmEv α u' ℓ' v := by
    intro A T V _ _ _ _ N Q α u u' ℓ ℓ' c w e0 v hc hu hdeg hℓ
    obtain ⟨υ, rfl⟩ := hc
    have hfac : ∀ (y : T) (b : ℤ),
        ((υ : T) * y) ^ b.toNat * Ring.inverse ((υ : T) * y) ^ (-b).toNat
        = ((υ ^ b : Tˣ) : T) * (y ^ b.toNat * Ring.inverse y ^ (-b).toNat) := by
      intro y b
      rw [Ring.mul_inverse_rev, Ring.inverse_unit, mul_pow, mul_pow]
      have : ((υ ^ b : Tˣ) : T) = (υ : T) ^ b.toNat * ((υ⁻¹ : Tˣ) : T) ^ (-b).toNat := by
        have hb : b = (b.toNat : ℤ) - ((-b).toNat : ℤ) := (Int.toNat_sub_toNat_neg b).symm
        conv_lhs => rw [hb]
        rw [zpow_sub, zpow_natCast, zpow_natCast, ← inv_pow, Units.val_mul,
          Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
      rw [this]; ring
    have hprodz : ∀ (s0 : Finset (Fin N)) (f : Fin N → ℤ),
        ∏ i ∈ s0, (υ ^ f i) = υ ^ (∑ i ∈ s0, f i) := by
      intro s0 f
      induction s0 using Finset.induction_on with
      | empty => simp
      | insert a s0 ha ih => rw [Finset.prod_insert ha, Finset.sum_insert ha, ih, zpow_add]
    have hLP : ∀ β : Fin N → ℤ, wcKlmLP (fun i => (υ : T) * u' i) β =
        ((υ ^ (∑ i, β i) : Tˣ) : T) * wcKlmLP u' β := by
      intro β
      unfold wcKlmLP
      rw [Finset.prod_congr rfl (fun i _ => hfac (u' i) (β i)), Finset.prod_mul_distrib, ← hprodz,
        Units.coe_prod]
    have hu' : u = fun i => (υ : T) * u' i := funext hu
    subst hu'
    unfold wcKlmEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Finsupp.smul_sum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    rw [hLP β, hdeg ρ β hβ]
    have key : ((υ ^ ((w : ℤ) - e0) : Tˣ) : T) * (υ : T) ^ e0 = (υ : T) ^ w := by
      rw [← Units.val_pow_eq_pow_val, ← Units.val_mul, ← zpow_natCast υ e0, ← zpow_add,
        sub_add_cancel, zpow_natCast, Units.val_pow_eq_pow_val]
    calc (α (v ρ β) * (((υ ^ ((w : ℤ) - e0) : Tˣ) : T) * wcKlmLP u' β)) • ℓ ρ
        = (((υ ^ ((w : ℤ) - e0) : Tˣ) : T) * wcKlmLP u' β) • (α (v ρ β) • ℓ ρ) := by
          rw [mul_comm, mul_smul]
      _ = (((υ ^ ((w : ℤ) - e0) : Tˣ) : T) * wcKlmLP u' β) •
            (α (v ρ β) • ((υ : T) ^ e0 • ℓ' ρ)) := by
          rw [hℓ ρ β hβ]
      _ = ((((υ ^ ((w : ℤ) - e0) : Tˣ) : T) * (υ : T) ^ e0) * (α (v ρ β) * wcKlmLP u' β)) •
            ℓ' ρ := by
          rw [smul_smul, smul_smul]; congr 1; ring
      _ = _ := by rw [key, mul_smul]

  have evTwist : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A → T) (u u' : Fin N → T) (ℓ ℓ' : Fin Q → V) (lam : T) (w : ℕ)
      (v : Fin Q → (Fin N → ℤ) →₀ A), IsUnit lam → (∀ i, u i = lam ^ r * u' i) →
      (∀ ρ, ℓ ρ = lam ^ (r * d₀ + s) • ℓ' ρ) →
      (∀ ρ, ∀ β ∈ (v ρ).support, ∑ i, β i = (w : ℤ) - (d₀ : ℤ)) →
      wcKlmEv α u ℓ v = lam ^ (r * w + s) • wcKlmEv α u' ℓ' v := by
    intro A T V _ _ _ _ N Q α u u' ℓ ℓ' lam w v hlam hu hℓ hdeg
    have h1 := evChart α u u' ℓ (fun ρ => lam ^ s • ℓ' ρ) (lam ^ r) w d₀ v (hlam.pow r) hu hdeg
      (fun ρ β _ => by rw [hℓ ρ, ← pow_mul, pow_add, mul_smul])
    rw [h1, evScaleL, smul_smul, ← pow_mul, ← pow_add]
  have unitPow : ∀ {T : Type u} [CommRing T] (y : T), IsUnit y → ∀ (a b c e : ℕ),
      (a : ℤ) - b = (c : ℤ) - e → y ^ a * Ring.inverse y ^ b = y ^ c * Ring.inverse y ^ e := by
    intro T _ y hy a b c e habce
    obtain ⟨υ, rfl⟩ := hy
    rw [Ring.inverse_unit]
    have key : υ ^ a * υ⁻¹ ^ b = υ ^ c * υ⁻¹ ^ e := by
      rw [inv_pow, inv_pow, ← zpow_natCast υ a, ← zpow_natCast υ b, ← zpow_natCast υ c,
        ← zpow_natCast υ e, ← zpow_neg, ← zpow_neg, ← zpow_add, ← zpow_add]
      congr 1
    have := congrArg (fun z : Tˣ => (z : T)) key
    simpa only [Units.val_mul, Units.val_pow_eq_pow_val] using this

  have evShift : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A →+* T) (u : Fin N → T) (ℓ : Fin Q → V) (σs : Finset (Fin N)) (κ : ℕ)
      (f : Fin Q → MvPolynomial (Fin N) A), (∀ i ∈ σs, IsUnit (u i)) →
      wcKlmEv (⇑α) u ℓ (fun ρ => ∑ μ ∈ (f ρ).support,
        Finsupp.single (fun i => (μ i : ℤ) - if i ∈ σs then (κ : ℤ) else 0) ((f ρ).coeff μ)) =
      (∏ i ∈ σs, Ring.inverse (u i)) ^ κ • wcKlmPEv (⇑α) u ℓ f := by
    intro A T V _ _ _ _ N Q α u ℓ σs κ f hσ
    have lpFactor : ∀ (μ : Fin N →₀ ℕ),
        wcKlmLP u (fun i => (μ i : ℤ) - if i ∈ σs then (κ : ℤ) else 0) =
          (∏ i ∈ σs, Ring.inverse (u i)) ^ κ * ∏ i, u i ^ μ i := by
      intro μ
      unfold wcKlmLP
      have hfac : ∀ i, u i ^ ((μ i : ℤ) - if i ∈ σs then (κ : ℤ) else 0).toNat *
          Ring.inverse (u i) ^ (-((μ i : ℤ) - if i ∈ σs then (κ : ℤ) else 0)).toNat =
          (if i ∈ σs then Ring.inverse (u i) ^ κ else 1) * u i ^ μ i := by
        intro i
        by_cases hi : i ∈ σs
        · simp only [hi, if_true]
          rw [mul_comm (Ring.inverse (u i) ^ κ)]
          exact unitPow _ (hσ i hi) _ _ _ _ (Int.toNat_sub_toNat_neg _)
        · simp only [hi, if_false, sub_zero, Int.toNat_natCast, one_mul]
          rw [Int.toNat_eq_zero.mpr (by omega), pow_zero, mul_one]
      rw [Finset.prod_congr rfl (fun i _ => hfac i), Finset.prod_mul_distrib, Finset.prod_ite_mem,
        Finset.univ_inter, Finset.prod_pow]
    unfold wcKlmEv wcKlmPEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [← Finsupp.sum_finsetSum_index (fun _ => by simp)
      (fun _ _ _ => by simp only [map_add, add_mul, add_smul]), Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [Finsupp.sum_single_index (by simp), lpFactor μ, smul_smul]
    congr 1
    ring

  have surjVec : ∀ {A T V : Type u} [CommRing A] [CommRing T] [AddCommGroup V] [Module T V]
      {N Q : ℕ} (α : A →+* T) (u : Fin N → T) (ℓ : Fin Q → V) (k l : Fin N), k ≠ l →
      u k = 1 → IsUnit (u l) → ∀ (e0 : ℕ) (w : ℤ) (n₀ : ℕ) (f : Fin Q → MvPolynomial (Fin N) A),
      ∃ v ∈ wcLaurC A N Q (fun _ => e0) w {k, l},
        wcKlmEv (⇑α) u ℓ v = Ring.inverse (u l) ^ n₀ • wcKlmPEv (⇑α) u ℓ f := by
    intro A T V _ _ _ _ N Q α u ℓ k l hkl hk hl e0 w n₀ f
    obtain ⟨β, hβ⟩ : ∃ β : (Fin N →₀ ℕ) → Fin N → ℤ, β = fun μ i => (μ i : ℤ) +
        (if i = k then w - e0 + n₀ - ∑ j, (μ j : ℤ) else 0) - (if i = l then (n₀ : ℤ) else 0) :=
      ⟨_, rfl⟩
    have hβi : ∀ μ i, β μ i = (μ i : ℤ) + (if i = k then w - e0 + n₀ - ∑ j, (μ j : ℤ) else 0) -
        (if i = l then (n₀ : ℤ) else 0) := by
      intro μ i; rw [hβ]
    refine ⟨fun ρ => ∑ μ ∈ (f ρ).support, Finsupp.single (β μ) ((f ρ).coeff μ), ?_, ?_⟩
    · intro ρ
      refine Submodule.sum_mem _ (fun μ _ => Finsupp.single_mem_supported A _ ?_)
      refine ⟨?_, ?_⟩
      · simp only [hβi, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_eq',
          Finset.mem_univ, if_true]
        ring
      · intro i hi
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hi
        rw [hβi, if_neg hi.1, if_neg hi.2]
        simp
    · have lp : ∀ μ : Fin N →₀ ℕ, wcKlmLP u (β μ) = Ring.inverse (u l) ^ n₀ * ∏ i, u i ^ μ i := by
        intro μ
        unfold wcKlmLP
        have hfac : ∀ i, u i ^ (β μ i).toNat * Ring.inverse (u i) ^ (-β μ i).toNat =
            (if i = l then Ring.inverse (u l) ^ n₀ else 1) * u i ^ μ i := by
          intro i
          by_cases hil : i = l
          · rw [hil, if_pos rfl, mul_comm (Ring.inverse (u l) ^ n₀)]
            refine unitPow _ hl _ _ _ _ ?_
            rw [Int.toNat_sub_toNat_neg, hβi, if_neg (Ne.symm hkl), if_pos rfl]
            ring
          · by_cases hik : i = k
            · rw [hik, if_neg hkl, hk, Ring.inverse_one]
              simp
