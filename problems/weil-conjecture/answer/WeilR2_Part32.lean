    apply hs ((wcLr1uGerm ι η hη).hom t) (hGηV t)
    rw [dagger, ← map_mul, ht, map_one]

  let σ : ↥W →+* X.presheaf.stalk x :=
    ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.germ ⊤ x trivial).hom
  have σ0 : ∀ (U : X.Opens) (hxU : x ∈ U) (w : ↥W), σ w =
