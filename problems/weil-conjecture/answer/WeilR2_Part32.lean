      calc _ = Polynomial.C (Ideal.Quotient.mk m D)⁻¹ * (u.map (Ideal.Quotient.mk m) *
              P.map (Ideal.Quotient.mk m) + v.map (Ideal.Quotient.mk m) *
              (Polynomial.derivative P).map (Ideal.Quotient.mk m)) := by ring
        _ = 1 := by rw [h, ← Polynomial.C_mul, inv_mul_cancel₀ hDπ, Polynomial.C_1]
    have hPbmon : (P.map (Ideal.Quotient.mk m)).Monic := hPmon.map _
    have hne : P.map (Ideal.Quotient.mk m) ≠ 0 := hPbmon.ne_zero
    have hcard : (P.map (Ideal.Quotient.mk m)).roots.toFinset.card = P.natDegree := by
      rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsepbar),
        IsAlgClosed.card_roots_eq_natDegree, hPmon.natDegree_map]
    set e := ((P.map (Ideal.Quotient.mk m)).roots.toFinset.equivFinOfCardEq hcard).symm with he
    choose a ha using fun i => Ideal.Quotient.mk_surjective (I := m) ((e i : A ⧸ m))
    refine ⟨a, fun i => ?_, fun i j hij => ?_⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem]
      have hroot : (e i : A ⧸ m) ∈ (P.map (Ideal.Quotient.mk m)).roots :=
        Multiset.mem_toFinset.mp (e i).2
      have h0 := (Polynomial.mem_roots hne).mp hroot
      rw [Polynomial.IsRoot, ← ha i, Polynomial.eval_map, Polynomial.eval₂_hom] at h0
      exact h0
    · intro hmem
      apply hij
      apply e.injective
      apply Subtype.ext
      rw [← ha i, ← ha j]
      exact Ideal.Quotient.eq.mpr hmem

  haveI : Module.IsTorsionFree A B := Module.isTorsionFree_iff_algebraMap_injective.mpr hAB
  have s4 : ∀ a0 : A, P.eval a0 ∈ m → ∃ Q : Ideal B, Q.IsMaximal ∧
      Q.comap (algebraMap A B) = m ∧ θ - algebraMap A B a0 ∈ Q := by
    intro a0 ha0
    haveI := hm
    letI : Field (A ⧸ m) := Ideal.Quotient.field m
    letI : Algebra (Polynomial A) B := (Polynomial.aeval θ).toRingHom.toAlgebra
    haveI : IsScalarTower A (Polynomial A) B := IsScalarTower.of_algebraMap_eq (fun x => by
      change algebraMap A B x = Polynomial.aeval θ (algebraMap A (Polynomial A) x)
      rw [Polynomial.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Polynomial.aeval_C])
    haveI : Algebra.IsIntegral (Polynomial A) B := Algebra.IsIntegral.tower_top A
    let φ : (Polynomial A) →+* A ⧸ m := Polynomial.eval₂RingHom (Ideal.Quotient.mk m)
