theorem wcpa_dj_lr1k_ebcnt_open_core : ∀ (κ : Type u) [Field κ] (Z₁ Z₂ Zt₁ Zt₂ : Scheme.{u}) (s₁ : Z₁ ⟶ Spec (.of κ)) (s₂ : Z₂ ⟶ Spec (.of κ)) (ν₁ : Zt₁ ⟶ Z₁) (ν₂ : Zt₂ ⟶ Z₂), wcGcNormDatum ν₁ → wcGcNormDatum ν₂ → ∀ (O₁ : Z₁.Opens) (O₂ : Z₂.Opens), Dense (O₁ : Set ↥Z₁) → ∀ (θ : O₁.toScheme ⟶ O₂.toScheme), IsIso θ → θ ≫ O₂.ι ≫ s₂ = O₁.ι ≫ s₁ → ∃ (W₁ : Zt₁.Opens) (W₂ : Zt₂.Opens), Dense (W₁ : Set ↥Zt₁) ∧ W₂ ≤ ν₂ ⁻¹ᵁ O₂ ∧ closure ((ν₂ ⁻¹ᵁ O₂ : Zt₂.Opens) : Set ↥Zt₂) ⊆ closure (W₂ : Set ↥Zt₂) ∧ ∃ ψ : W₁.toScheme ⟶ W₂.toScheme, IsIso ψ ∧ ψ ≫ W₂.ι ≫ ν₂ ≫ s₂ = W₁.ι ≫ ν₁ ≫ s₁ :=
by
  intro κ _ Z₁ Z₂ Zt₁ Zt₂ s₁ s₂ ν₁ ν₂ hN₁ hN₂ O₁ O₂ hO₁ θ hθ hθs
  obtain ⟨-, -, U₁, hU₁d, hU₁pd, hU₁iso⟩ := hN₁
  obtain ⟨-, -, U₂, hU₂d, hU₂pd, hU₂iso⟩ := hN₂

  have c1 : ∀ {X Y₁ Y₂ : Type u} [TopologicalSpace X] [TopologicalSpace Y₁] [TopologicalSpace Y₂]
      (e : X → Y₁) (t : X → Y₂), Topology.IsOpenEmbedding e → Topology.IsOpenEmbedding t →
      Dense (Set.range e) →
      ∀ (V₁ : Set Y₁) (V₂ : Set Y₂), IsOpen V₁ → IsOpen V₂ → Dense V₁ → Dense V₂ →
      Dense (e '' (e ⁻¹' V₁ ∩ t ⁻¹' V₂)) ∧ Set.range t ⊆ closure (t '' (e ⁻¹' V₁ ∩ t ⁻¹' V₂)) := by
    intro X Y₁ Y₂ _ _ _ e t he ht hed V₁ V₂ hV₁ hV₂ hV₁d hV₂d
    constructor
    · rw [dense_iff_inter_open]
      intro G hG hGne
      obtain ⟨_, ⟨hyG, hyV⟩, ⟨x₀, rfl⟩⟩ :=
        hed.inter_open_nonempty (G ∩ V₁) (hG.inter hV₁) (hV₁d.inter_open_nonempty G hG hGne)
      have hH : IsOpen (e ⁻¹' (G ∩ V₁)) := (hG.inter hV₁).preimage he.continuous
      obtain ⟨_, ⟨x₁, hx₁H, rfl⟩, hx₁V⟩ := hV₂d.inter_open_nonempty (t '' (e ⁻¹' (G ∩ V₁)))
        (ht.isOpenMap _ hH) ⟨t x₀, x₀, ⟨hyG, hyV⟩, rfl⟩
      exact ⟨e x₁, hx₁H.1, x₁, ⟨hx₁H.2, hx₁V⟩, rfl⟩
    · rintro _ ⟨x₀, rfl⟩
      rw [mem_closure_iff]
      intro G hG hx₀G
      have hH₀ : IsOpen (t ⁻¹' G) := hG.preimage ht.continuous
      obtain ⟨_, ⟨x₁, hx₁H₀, rfl⟩, hx₁V⟩ := hV₁d.inter_open_nonempty (e '' (t ⁻¹' G))
        (he.isOpenMap _ hH₀) ⟨e x₀, x₀, hx₀G, rfl⟩
      have hH : IsOpen (t ⁻¹' G ∩ e ⁻¹' V₁) := hH₀.inter (hV₁.preimage he.continuous)
      obtain ⟨_, ⟨x₂, ⟨hx₂G, hx₂V₁⟩, rfl⟩, hx₂V₂⟩ := hV₂d.inter_open_nonempty
        (t '' (t ⁻¹' G ∩ e ⁻¹' V₁)) (ht.isOpenMap _ hH) ⟨t x₁, x₁, ⟨hx₁H₀, hx₁V⟩, rfl⟩
      exact ⟨t x₂, hx₂G, x₂, ⟨hx₂V₁, hx₂V₂⟩, rfl⟩

  have c2 : ∀ {Y Z : Type u} [TopologicalSpace Y] [TopologicalSpace Z] (ν : Y → Z) (U : Set Z),
      Continuous ν → IsOpen U → Dense (ν ⁻¹' U) →
      (∀ G : Set Y, IsOpen G → G ⊆ ν ⁻¹' U → IsOpen (ν '' G)) →
