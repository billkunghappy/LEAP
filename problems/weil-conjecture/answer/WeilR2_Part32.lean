    rw [hTG l m _ le_rfl, hid] at h1
    show X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N l ⊓ b ⁻¹ᵁ wcSgD K N m ≤ _)).op
        (X.presheaf.map (homOfLE (hψ m)).op (f (J0 m))) =
      wcEszG b l m ^ (E * e) *
        X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ wcSgD K N l ⊓ b ⁻¹ᵁ wcSgD K N m ≤ _)).op
          (X.presheaf.map (homOfLE (hψ l)).op (f (J0 l)))
    rw [hres_comp, hres_comp, pow_mul]
    exact h1
  have hrefl1 : ∀ (e n : ℕ) (v : Fin n → ↥(wcGcDfSec ψ e)) (c : Fin n → K),
      (∀ l : Fin (N + 1), ∑ i, wcEszScal b (b ⁻¹ᵁ wcSgD K N l) (c i) *
