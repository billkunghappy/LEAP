theorem wcpa_dj_lr1k_ebcnt_valuation_off_dense : ∀ (κ : Type u) [Field κ] {Zt Z : Scheme.{u}} (ν : Zt ⟶ Z) (s : Z ⟶ Spec (.of κ)) (c : ℤ), wcGcNormDatum ν → wcGcChi κ (ν ≫ s) c → ∀ W : Zt.Opens, Dense (W : Set ↥Zt) → ∀ p : ↥Zt, p ∉ W → ∀ a b : ↥(Zt.presheaf.stalk p), a ∣ b ∨ b ∣ a :=
by
  intro κ _ Zt Z ν s c hND hχ W hW p hp a b
  classical

  have alg : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsLocalRing R]
      [IsIntegrallyClosed R], ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ IsField R →
      ∀ a b : R, a ∣ b ∨ b ∣ a := by
    intro R _ _ _ _ _ hd hnf a b
    haveI : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr hd
    have huniq : IsIntegrallyClosed R ∧ ∃! P : Ideal R, P ≠ ⊥ ∧ P.IsPrime := by
      refine ⟨inferInstance, IsLocalRing.maximalIdeal R, ⟨?_, inferInstance⟩, ?_⟩
      · intro h; exact hnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
      · rintro P ⟨hP0, hPp⟩
        rcases Ring.krullDimLE_one_iff.mp inferInstance P hPp with h | h
        · rw [IsDomain.minimalPrimes_eq_singleton_bot] at h; exact absurd h hP0
        · exact IsLocalRing.eq_maximalIdeal h
