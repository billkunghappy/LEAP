    exact h2 (wcpa_dj_sfi_rational_generization K _ (Limits.pullback.snd u s) x' x'' hx'x'' hres)

theorem wcpa_dj_lr1k_ebc_odf_going_down : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
