      (Spec.map (CommRingCat.ofHom (lam.comp θ₀))) := by
    refine invpull _ _ 1 ![(Scheme.ΓSpecIso (.of L)).inv.hom ι, 1] ?_ ?_
    · intro j
      fin_cases j
      · show (Spec.map (CommRingCat.ofHom (lam.comp θ₀))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
