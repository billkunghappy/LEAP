  have c3 : ∀ (W : Type u) [CommRing W] [IsLocalRing W] (T : Type u) [CommRing T] [Algebra W T]
      (β : T), IsUnit β → (∀ x : T, ∃ k : ℕ, IsIntegral W (β ^ k * x)) →
      ∀ 𝔮 : Ideal T, 𝔮.IsPrime →
      Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W) ≤ 𝔮 → 𝔮.IsMaximal := by
    intro W _ _ T _ _ β hβ hint 𝔮 h𝔮 hm
    haveI : (𝔮.comap (algebraMap (integralClosure W T) T)).IsPrime := Ideal.comap_isPrime _ 𝔮
    have hcomap : (𝔮.comap (algebraMap (integralClosure W T) T)).comap
        (algebraMap W (integralClosure W T)) = IsLocalRing.maximalIdeal W := by
      rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq]
