    have hgPinj : Function.Injective
        ((wcProjK Ω 1).presheaf.germ V₀ (genericPoint (wcProjK Ω 1)) hηV₀).hom :=
      germ_injective_of_isIntegral (wcProjK Ω 1) (genericPoint (wcProjK Ω 1)) hηV₀
    have N1 : ∀ c : ↑Γ(wcProjK Ω 1, V₀),
        (C.presheaf.germ (γ ⁻¹ᵁ V₀) (genericPoint C) hηV₁).hom ((γ.app V₀).hom c) =
          wcpaDjGslTr γ (genericPoint C) (genericPoint (wcProjK Ω 1)) hγ
            (((wcProjK Ω 1).presheaf.germ V₀ (genericPoint (wcProjK Ω 1)) hηV₀).hom c) := by
      intro c
