    have hcomap : ∀ i i', PrimeSpectrum.comap (γ.app V₀).hom (Q i) =
        PrimeSpectrum.comap (γ.app V₀).hom (Q i') := by
      intro i i'
      ext1
      show Ideal.comap _ (Q' i) = Ideal.comap _ (Q' i')
      exact ((hQ' i).2).trans ((hQ' i').2).symm
    rcases Nat.eq_zero_or_pos (Module.finrank (wcProjK Ω 1).functionField C.functionField)
      with h0 | hpos
    · rw [h0]; exact Nat.zero_le _
    have hc : ∀ i, ∃ a : C ≅ C, a.hom ≫ γ = γ ∧
        a.hom (hU₀a.fromSpec (Q ⟨0, hpos⟩)) = hU₀a.fromSpec (Q i) := fun i =>
      hgal _ _ (by rw [hγc, hγc, hcomap])
    choose f hf1 hf2 using hc
    have hfinj : Function.Injective (fun i => (⟨f i, hf1 i⟩ : {a : C ≅ C // a.hom ≫ γ = γ})) := by
      intro i i' h
      have h' : f i = f i' := congrArg Subtype.val h
      have : hU₀a.fromSpec (Q i) = hU₀a.fromSpec (Q i') := by rw [← hf2 i, ← hf2 i', h']
      exact hQinj (hU₀a.fromSpec.isOpenEmbedding.injective this)
    have := Nat.card_le_card_of_injective _ hfinj
    simpa using this

  have hfield : ∀ x : C.functionField, (∀ g, σ g x = x) →
      ∃ k, algebraMap (wcProjK Ω 1).functionField C.functionField k = x := by
    intro x hx
    let τ : {a : C ≅ C // a.hom ≫ γ = γ} →
        (C.functionField ≃ₐ[(wcProjK Ω 1).functionField] C.functionField) := fun g =>
      AlgEquiv.ofBijective (σ g) (Algebra.IsAlgebraic.algHom_bijective _)
    have hτ : Function.Injective τ := by
      intro g g' e
      apply hσinj
      ext y
      have := congrArg (fun f : C.functionField ≃ₐ[(wcProjK Ω 1).functionField] C.functionField
        => f y) e
      exact this
    have h1 := Nat.card_le_card_of_injective τ hτ
    have h2 : Nat.card (C.functionField ≃ₐ[(wcProjK Ω 1).functionField] C.functionField) ≤
        Module.finrank (wcProjK Ω 1).functionField C.functionField := by
      rw [Nat.card_eq_fintype_card]; exact AlgEquiv.card_le
    haveI : IsGalois (wcProjK Ω 1).functionField C.functionField :=
      IsGalois.of_card_aut_eq_finrank _ _ (by omega)
    have hτb := hτ.bijective_of_nat_card_le (by omega)
    have hbot : x ∈ (⊥ : IntermediateField (wcProjK Ω 1).functionField C.functionField) :=
      (IsGalois.mem_bot_iff_fixed x).mpr (fun f => by
        obtain ⟨g, rfl⟩ := hτb.2 f
        exact hx g)
    obtain ⟨k, hk⟩ := IntermediateField.mem_bot.mp hbot
    exact ⟨k, hk⟩
  refine ⟨hGfin, ?_⟩

  intro V hV s hs
  by_cases hη : genericPoint (wcProjK Ω 1) ∈ V
  · have hV' : genericPoint C ∈ γ ⁻¹ᵁ V := hgen.mem_open V.isOpen hη
    have hxfix : ∀ g, σ g ((C.presheaf.germ (γ ⁻¹ᵁ V) _ hV').hom s) =
        (C.presheaf.germ (γ ⁻¹ᵁ V) _ hV').hom s := by
      intro g
      rw [hσapp]
      have := congrArg (fun f => f.hom s) (hequiv g V hV')
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this ⊢
      rw [← this, hs g.1 g.2]
    obtain ⟨k, hk⟩ := hfield _ hxfix
    haveI : Nonempty V := ⟨⟨_, hη⟩⟩
    haveI : IsIntegrallyClosed Γ(wcProjK Ω 1, V) :=
      wc_fsus_affine_sections_intclosed (wcProjK Ω 1) hPnorm V hV inferInstance
    haveI : IsFractionRing Γ(wcProjK Ω 1, V) (wcProjK Ω 1).functionField :=
      functionField_isFractionRing_of_isAffineOpen _ V hV
    set j := ((wcProjK Ω 1).presheaf.stalkSpecializes hgen ≫ γ.stalkMap (genericPoint C)).hom
      with hjdef
    have hjk : j k = (C.presheaf.germ (γ ⁻¹ᵁ V) _ hV').hom s := hk
    have hcomp : j.comp ((wcProjK Ω 1).presheaf.germ V _ hη).hom =
        ((C.presheaf.germ (γ ⁻¹ᵁ V) _ hV').hom).comp (γ.app V).hom := by
      rw [hjdef, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp,
        hcompat V hη hV']
    obtain ⟨p, hpm, hp⟩ := IsIntegralHom.isIntegral_app γ V hV s
    have hpk : j (Polynomial.eval₂ ((wcProjK Ω 1).presheaf.germ V _ hη).hom k p) = 0 := by
      rw [Polynomial.hom_eval₂, hcomp, hjk, ← Polynomial.hom_eval₂, hp, map_zero]
    have hkint : IsIntegral Γ(wcProjK Ω 1, V) k :=
      ⟨p, hpm, (map_eq_zero_iff j j.injective).mp hpk⟩
    obtain ⟨t, ht⟩ := IsIntegrallyClosed.isIntegral_iff.mp hkint
    refine ⟨t, germ_injective_of_isIntegral C _ hV' ?_⟩
    have := congrArg (fun f => f.hom t) (hcompat V hη hV')
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [← this, ← hjk]
    show j _ = j k
    rw [← ht]
    rfl
  · have hVe : V = ⊥ := by
      ext x
      constructor
      · intro hx
        exact absurd (((genericPoint_spec (wcProjK Ω 1)).mem_open_set_iff V.isOpen).mpr
          ⟨x, Set.mem_univ _, hx⟩) hη
      · intro hx; exact absurd hx (by simp)
    have hUe : γ ⁻¹ᵁ V = ⊥ := by rw [hVe, Scheme.Hom.preimage_bot]
    have hsub : Subsingleton Γ(C, γ ⁻¹ᵁ V) :=
      CommRingCat.subsingleton_of_isTerminal (C.sheaf.isTerminalOfEqEmpty hUe)
    exact ⟨0, @Subsingleton.elim _ hsub _ _⟩

theorem wcpa_dj_llsmg_function_field_galois : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
