  haveI hqf' : Algebra.QuasiFiniteAt (Polynomial ↥W) P := hqf
  obtain ⟨r, hrP, hrI, hrZ⟩ := Algebra.zariskisMainProperty_iff.mp
    (Algebra.ZariskisMainProperty.of_finiteType (R := Polynomial ↥W) P)

