  have hVr : ∀ x y : Fin (N + 1),
      ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) ≤ (ν ≫ j) ⁻¹ᵁ wcSgD κ N y :=
    fun x y => (inf_le_right : (ν ≫ j) ⁻¹ᵁ wcSgD κ N x ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N y ≤ _)
  have hVl : ∀ x y : Fin (N + 1),
      ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) ≤ (ν ≫ j) ⁻¹ᵁ wcSgD κ N x :=
    fun x y => (inf_le_left : (ν ≫ j) ⁻¹ᵁ wcSgD κ N x ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N y ≤ _)
  have hVV : ∀ x y : Fin (N + 1), ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) ≤
      (ν ≫ j) ⁻¹ᵁ wcSgD κ N x ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N y :=
    fun x y => le_rfl
  have hVV' : ∀ x y : Fin (N + 1), (ν ≫ j) ⁻¹ᵁ wcSgD κ N x ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N y ≤
      ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) :=
    fun x y => le_rfl
  have hψG : ∀ (x y : Fin (N + 1)) (W' : Zt.Opens)
      (h : W' ≤ ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y)),
      (ν.appLE (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) W' h).hom (wcEszG j x y) =
        ((ν ≫ j).appLE (wcSgD κ N y) W' (h.trans (hVr x y))).hom (wcSgE κ N y x) := by
    intro x y W' h
    rw [hG0]
    exact H5 _ _ _ _ _ _ _ _ _

  simp only [wcGcSjRelSec, Set.mem_ofPred_eq] at hb
  choose g hg using hb
  have hgW : ∀ (x y : Fin (N + 1)) (W' : Zt.Opens)
      (h : W' ≤ ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y)),
      (ν.appLE (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) W' h).hom (g x y) =
        (Zt.presheaf.map (homOfLE (h.trans (hVr x y))).op).hom (b y) -
          ((ν ≫ j).appLE (wcSgD κ N y) W' (h.trans (hVr x y))).hom (wcSgE κ N y x) ^ e *
          (Zt.presheaf.map (homOfLE (h.trans (hVl x y))).op).hom (b x) := by
    intro x y W' h
    have := congrArg (Zt.presheaf.map (homOfLE (h.trans (hVV x y))).op).hom (hg x y)
    rw [map_sub, map_mul, map_pow, H3, H3, hG] at this
    refine Eq.trans ?_ this.symm
    exact (H1 ν _ _ W' (hVV' x y) (h.trans (hVV x y)) (g x y)).symm

  have hinjW : ∀ W : Z.Opens, Function.Injective (ν.appLE W (ν ⁻¹ᵁ W) le_rfl).hom := by
    intro W x y hxy
    apply hinj W
    rw [← Scheme.Hom.appLE_eq_app]
    exact hxy
  have alg : ∀ {R : Type u} [CommRing R] (Q P S Ba Bk Bl : R), S = Q * P →
      Q ^ e * (Bk - P ^ e * Ba) + (Bl - Q ^ e * Bk) = Bl - S ^ e * Ba := by
    intro R _ Q P S Ba Bk Bl hS
    rw [hS, mul_pow]
    ring
  have hcoc : wcGcDfCoc j e g := by
    intro a k l
    apply hinjW
    rw [map_add, map_mul, H2, H2, H2, H2, map_pow, hψG, hgW, hgW, hgW]
    refine alg _ _ _ _ _ _ ?_
    exact hcyc _ _ _ _ _ _

  obtain ⟨s, hs⟩ := hHV g hcoc

  refine ⟨fun a => b a -
    (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom (s a), ?_, ?_⟩
  · simp only [wcGcDfSec, Set.mem_ofPred_eq]
    intro a c
    have h1 := hgW a c _ (hVV' a c)
    have h2 := congrArg
      (ν.appLE (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N c) _ (hVV' a c)).hom (hs a c)
    rw [map_sub, map_mul, map_pow, H2, H2, hψG] at h2
    have ec := H1 ν (j ⁻¹ᵁ wcSgD κ N c) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N c)
      ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N c) le_rfl inf_le_right (s c)
    have ea := H1 ν (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a)
      ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N c) le_rfl inf_le_left (s a)
    rw [map_sub, map_sub, ec, ea, hG0]
    linear_combination h2 - h1
  · intro a
    refine ⟨-s a, ?_⟩
    rw [map_neg]
    exact (sub_sub_cancel_left _ _).symm

theorem wcpa_dj_lr1k_ll_gc_sj_rank_split : ∀ (κ : Type u) [Field κ] (Z Zt : Scheme.{u}) {N : ℕ}
    (j : Z ⟶ wcProjK κ N) (ν : Zt ⟶ Z) (e : ℕ),
    (∀ V : Z.Opens, Function.Injective (ν.app V)) →
    (∀ b ∈ wcGcSjRelSec j ν e, ∃ f ∈ wcGcDfSec (ν ≫ j) e, ∀ a : Fin (N + 1),
      f a - b a ∈ Set.range (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl)) →
    wcGcDfRk (ν ≫ j) e = wcGcDfRk j e + wcGcSjQRk j ν e :=
by
  intro κ _ Z Zt N j ν e hinj hlift

  have S6 : ∀ (K : Type u) [Field K] (N : ℕ) (A A' : Fin (N + 1) → Type u) [∀ a, CommRing (A a)] [∀ a, CommRing (A' a)] (s : ∀ a, K →+* A a) (s' : ∀ a, K →+* A' a) (ψ : ∀ a, A a →+* A' a) (S : Set (∀ a, A a)) (S' R : Set (∀ a, A' a)), (∀ a, Function.Injective (ψ a)) → (∀ a (c : K), ψ a (s a c) = s' a c) → (0 : ∀ a, A a) ∈ S → (∀ x ∈ S, ∀ y ∈ S, x + y ∈ S) → (∀ (c : K), ∀ x ∈ S, (fun a => s a c * x a) ∈ S) → (0 : ∀ a, A' a) ∈ S' → (∀ x ∈ S', ∀ y ∈ S', x + y ∈ S') → (∀ (c : K), ∀ x ∈ S', (fun a => s' a c * x a) ∈ S') → (0 : ∀ a, A' a) ∈ R → (∀ x ∈ R, ∀ y ∈ R, x + y ∈ R) → (∀ (c : K), ∀ x ∈ R, (fun a => s' a c * x a) ∈ R) → S' ⊆ R → (∀ x : ∀ a, A a, (fun a => ψ a (x a)) ∈ S' ↔ x ∈ S) → (∀ b ∈ R, ∃ f ∈ S', ∀ a, f a - b a ∈ Set.range (ψ a)) → (⨆ (n : ℕ) (v : Fin n → ↥S') (_ : ∀ c : Fin n → K, (∀ a, ∑ i, s' a (c i) * (v i).1 a = 0) → ∀ i, c i = 0), (n : ℕ∞)) = (⨆ (n : ℕ) (v : Fin n → ↥S) (_ : ∀ c : Fin n → K, (∀ a, ∑ i, s a (c i) * (v i).1 a = 0) → ∀ i, c i = 0), (n : ℕ∞)) + (⨆ (n : ℕ) (v : Fin n → ↥R) (_ : ∀ c : Fin n → K, (∀ a, ∑ i, s' a (c i) * (v i).1 a ∈ Set.range (ψ a)) → ∀ i, c i = 0), (n : ℕ∞)) := by
    intro K _ N A A' _ _ s s' ψ S S' R hinjψ hψs hS0 hSadd hSsm hS'0 hS'add hS'sm hR0 hRadd hRsm
      hS'R hiff hlift

    have B1 : ∀ {V : Type u} [AddCommGroup V] [Module K V]
        (W P : Submodule K V) (T : Set V) (_ : (W : Set V) = T)
        (Q : ∀ n : ℕ, (Fin n → ↥T) → (Fin n → K) → Prop)
        (_ : ∀ n v c, Q n v c ↔ (∑ i, c i • ((v i : V))) ∈ P),
        (⨆ (n : ℕ) (v : Fin n → ↥T) (_ : ∀ c : Fin n → K, Q n v c → ∀ i, c i = 0), (n : ℕ∞)) =
          Cardinal.toENat (Module.rank K (W ⧸ P.comap W.subtype)) := by
      intro V _ _ W P T hT Q hQ
      subst hT
      have hcond : ∀ (n : ℕ) (v : Fin n → ↥(W : Set V)),
          (∀ c : Fin n → K, Q n v c → ∀ i, c i = 0) ↔
          LinearIndependent K (fun i => (P.comap W.subtype).mkQ (⟨(v i).1, (v i).2⟩ : W)) := by
        intro n v
        rw [Fintype.linearIndependent_iff]
        have h1 : ∀ c : Fin n → K, ∑ i, c i • (P.comap W.subtype).mkQ (⟨(v i).1, (v i).2⟩ : W) =
            (P.comap W.subtype).mkQ (∑ i, c i • (⟨(v i).1, (v i).2⟩ : W)) := by
          intro c
          simp only [map_sum, map_smul]
        have h2 : ∀ c : Fin n → K,
            (P.comap W.subtype).mkQ (∑ i, c i • (⟨(v i).1, (v i).2⟩ : W)) = 0 ↔ Q n v c := by
          intro c
          rw [hQ, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
            Submodule.subtype_apply, Submodule.coe_sum]
          simp only [Submodule.coe_smul]
        simp only [h1, h2]
      have hle : ∀ (n : ℕ) (v : Fin n → (W ⧸ P.comap W.subtype)), LinearIndependent K v →
          (n : ℕ∞) ≤ Cardinal.toENat (Module.rank K (W ⧸ P.comap W.subtype)) := by
        intro n v hv
        have := hv.cardinal_lift_le_rank
        simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at this
        exact Cardinal.natCast_le_toENat.mpr this
      have hge : ∀ m : ℕ, (m : Cardinal) ≤ Module.rank K (W ⧸ P.comap W.subtype) →
          (m : ℕ∞) ≤ (⨆ (n : ℕ) (v : Fin n → ↥(W : Set V))
            (_ : ∀ c : Fin n → K, Q n v c → ∀ i, c i = 0), (n : ℕ∞)) := by
        intro m hm
        obtain ⟨s, hs, hli⟩ := le_rank_iff_exists_linearIndependent_finset.mp hm
        subst hs
        have hli' : LinearIndependent K (fun i : Fin s.card => ((s.equivFin.symm i : s) :
            W ⧸ P.comap W.subtype)) := hli.comp _ s.equivFin.symm.injective
        choose w hw using fun i : Fin s.card =>
          Submodule.mkQ_surjective (P.comap W.subtype) ((s.equivFin.symm i : s) :
            W ⧸ P.comap W.subtype)
        refine le_iSup_of_le s.card (le_iSup_of_le
          (fun i => (⟨(w i).1, (w i).2⟩ : ↥(W : Set V))) (le_iSup_of_le ?_ le_rfl))
