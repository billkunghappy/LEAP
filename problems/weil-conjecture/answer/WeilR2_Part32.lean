          (MvPolynomial.X a * MvPolynomial.X b) :=
      (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ) _ _).ge
    have kl : ∀ s : Γ(wcProjK κ N, wcSgD κ N a),
