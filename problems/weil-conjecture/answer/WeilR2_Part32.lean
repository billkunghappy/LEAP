  set φ : X.presheaf.stalk x →+* (wcProjK Ω 1).functionField := (wcLr1uGerm ι x hx).hom with hφ
  set σ : ↥W →+* X.presheaf.stalk x :=
    ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.germ ⊤ x trivial).hom with hσ

  have hcomp : φ.comp σ = (wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype := by
    rw [hφ, hσ, ← CommRingCat.hom_comp, wcLr1uConst]
    change _ = (CommRingCat.ofHom (algebraMap ↥W Ω) ≫ _).hom
    congr 1
    simp only [Category.assoc, wcLr1uGerm]
    have e1 : X.presheaf.germ ⊤ x trivial ≫ X.presheaf.stalkSpecializes hx =
        X.presheaf.germ ⊤ (ι (genericPoint (wcProjK Ω 1))) trivial :=
      TopCat.Presheaf.germ_stalkSpecializes _ _ _
    have e2 : X.presheaf.germ ⊤ (ι (genericPoint (wcProjK Ω 1))) trivial ≫
        ι.stalkMap (genericPoint (wcProjK Ω 1)) =
        ι.appTop ≫ (wcProjK Ω 1).presheaf.germ ⊤ (genericPoint (wcProjK Ω 1)) trivial :=
      Scheme.Hom.germ_stalkMap _ _ _ _
    rw [reassoc_of% e1, e2, ← Category.assoc uX.appTop, ← Scheme.Hom.comp_appTop, hpb.w,
      Scheme.Hom.comp_appTop, ← Category.assoc, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality]
    simp only [Category.assoc]

  haveI hAdom : IsDomain (X.presheaf.stalk x) := Function.Injective.isDomain φ hinj
  letI : Algebra (X.presheaf.stalk x) (wcProjK Ω 1).functionField := φ.toAlgebra
  haveI hfr : IsFractionRing (X.presheaf.stalk x) (wcProjK Ω 1).functionField := by
    refine ⟨fun y => ?_, fun z => ?_, fun {a₁ a₂} h => ?_⟩
    · have hy0 : (y : X.presheaf.stalk x) ≠ 0 := nonZeroDivisors.coe_ne_zero y
      have : φ y ≠ 0 := fun h0 => hy0 (hinj (h0.trans (map_zero φ).symm))
      exact IsUnit.mk0 _ this
    · obtain ⟨a, b, hb, hab⟩ := hfrac z
      have hb0 : b ≠ 0 := fun h0 => hb (by rw [h0, map_zero])
      exact ⟨⟨a, ⟨b, mem_nonZeroDivisors_of_ne_zero hb0⟩⟩, hab⟩
    · exact ⟨1, by rw [hinj h]⟩
  have hint : ∀ k : (wcProjK Ω 1).functionField,
      (∃ p : Polynomial (X.presheaf.stalk x), p.Monic ∧ p.eval₂ φ k = 0) → k ∈ Set.range φ := by
    rintro k ⟨p, hpm, hp⟩
    haveI := hnorm x
    have hk : IsIntegral (X.presheaf.stalk x) k := ⟨p, hpm, hp⟩
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff
      (R := X.presheaf.stalk x) (K := (wcProjK Ω 1).functionField)).mp hk
    exact ⟨y, hy⟩

  obtain ⟨V', hdom', hCC', hgV', hRT'⟩ := wcpa_dj_lr1u_fn_dom_alg Ω (X.presheaf.stalk x)
    (wcProjK Ω 1).functionField W φ σ (wcLr1uConst (wcProjKStr Ω 1))
    (fun w => RingHom.congr_fun hcomp w) hloc hint g hgx hgix
  have hRTV' : wcLr1uVtdRT W (wcProjKStr Ω 1) (V' : Set (wcProjK Ω 1).functionField) g :=
    ⟨hgV', hRT'⟩

  have hVV : V = V' := wcpa_dj_lr1u_fn_gauss_unique Ω W V V' c1 c2 c3 g hmob hCC hCC' hRT hRTV'
  have hdx : wcLr1uDom (wcLr1uGerm ι x hx).hom (V : Set (wcProjK Ω 1).functionField) := by
    rw [hVV]; exact hdom'

  have hxη : x = η := centre V x η hx hη hdx hdη
  rw [hxη] at hcl
  exact hnc hcl

theorem wcpa_dj_lr1u_fn_tb_lfp : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)), Flat uX → LocallyOfFiniteType uX → LocallyOfFinitePresentation uX :=
by
  intro Ω _ W X uX hflat hlft
  haveI := hflat
  haveI := hlft
  apply HasRingHomProperty.of_source_openCover (P := @LocallyOfFinitePresentation) X.affineCover
  intro i
  have hF : (Scheme.Hom.appTop (X.affineCover.f i ≫ uX)).hom.Flat :=
    HasRingHomProperty.appTop (P := @Flat) _ inferInstance
  have hT : (Scheme.Hom.appTop (X.affineCover.f i ≫ uX)).hom.FiniteType :=
    HasRingHomProperty.appTop (P := @LocallyOfFiniteType) _ inferInstance
  have hF' := (RingHom.Flat.respectsIso.cancel_left_isIso (Scheme.ΓSpecIso (.of ↥W)).inv
    (Scheme.Hom.appTop (X.affineCover.f i ≫ uX))).mpr hF
  have hT' := (RingHom.finiteType_respectsIso.cancel_left_isIso (Scheme.ΓSpecIso (.of ↥W)).inv
    (Scheme.Hom.appTop (X.affineCover.f i ≫ uX))).mpr hT
  refine (RingHom.finitePresentation_respectsIso.cancel_left_isIso (Scheme.ΓSpecIso (.of ↥W)).inv
    (Scheme.Hom.appTop (X.affineCover.f i ≫ uX))).mp ?_
  letI := ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ Scheme.Hom.appTop (X.affineCover.f i ≫ uX)).hom.toAlgebra
  exact wcpa_dj_lr1u_mnc_nagata_fp ↥W _ hT' hF'

theorem wcpa_dj_lr1u_cc_residue_algClosed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), IsAlgClosed (IsLocalRing.ResidueField ↥W) :=
by
  intro Ω _ _ W
  classical
  refine IsAlgClosed.of_exists_root _ ?_
  intro pb hmon hirr
  have hdeg : 0 < pb.degree := Polynomial.degree_pos_of_irreducible hirr
  have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
    rw [Polynomial.mem_lifts]
    exact Polynomial.map_surjective _ IsLocalRing.residue_surjective pb
  obtain ⟨p, hpmap, hpdeg, hpmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
  have hPdeg : (p.map (algebraMap ↥W Ω)).degree ≠ 0 := by
    rw [hpmon.degree_map, hpdeg]
    exact ne_of_gt hdeg
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hPdeg
  have hx' : Polynomial.eval x (p.map (algebraMap ↥W Ω)) = 0 := hx
  have hint : IsIntegral ↥W x := ⟨p, hpmon, by rw [← Polynomial.eval_map]; exact hx'⟩
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  have hpy : p.eval y = 0 := by
    apply IsFractionRing.injective ↥W Ω
    rw [map_zero, ← Polynomial.eval_map_apply, hy]
    exact hx'
  refine ⟨IsLocalRing.residue ↥W y, ?_⟩
  rw [← hpmap, Polynomial.eval_map_apply, hpy, map_zero]

theorem wcpa_dj_lr1u_fn_tb_fibre_noeth : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) [LocallyOfFiniteType g] (y : Y), IsNoetherianRing (Y.presheaf.stalk y ⧸ Ideal.map (g.stalkMap y).hom (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))) :=
by
  intro S Y g _ y
  classical
  have hf : (g.stalkMap y).hom.EssFiniteType := LocallyOfFiniteType.stalkMap g y
  have h2 : (Ideal.Quotient.mk (Ideal.map (g.stalkMap y).hom
      (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))))).EssFiniteType :=
    (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective).essFiniteType
  have h1 := hf.comp h2
  let φ : S.presheaf.stalk (g y) ⧸ IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)) →+*
      Y.presheaf.stalk y ⧸ Ideal.map (g.stalkMap y).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) :=
    Ideal.quotientMap _ (g.stalkMap y).hom Ideal.le_comap_map
  have hφ : φ.comp (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))) =
      (Ideal.Quotient.mk (Ideal.map (g.stalkMap y).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))))).comp (g.stalkMap y).hom :=
    Ideal.quotientMap_comp_mk _
  rw [← hφ] at h1
  have h5 : φ.EssFiniteType := RingHom.EssFiniteType.of_comp _ h1
  haveI : (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).IsMaximal :=
    IsLocalRing.maximalIdeal.isMaximal _
  letI : Field (S.presheaf.stalk (g y) ⧸ IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) :=
    Ideal.Quotient.field _
  letI := φ.toAlgebra
  haveI : Algebra.EssFiniteType
      (S.presheaf.stalk (g y) ⧸ IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
      (Y.presheaf.stalk y ⧸ Ideal.map (g.stalkMap y).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))) :=
    RingHom.essFiniteType_algebraMap.mp h5
  exact Algebra.EssFiniteType.isNoetherianRing
    (S.presheaf.stalk (g y) ⧸ IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) _

theorem wcpa_dj_lr1u_fn_tb_na_ps_branches : ∀ (k : Type u) [Field k], ∃ ρ₀ ρ₁ : (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries k, (∀ a : k, ρ₀ (Ideal.Quotient.mk _ (MvPowerSeries.C a)) = PowerSeries.C a) ∧ PowerSeries.coeff 1 (ρ₀ (Ideal.Quotient.mk _ (MvPowerSeries.X 1))) = 1 ∧ PowerSeries.coeff 1 (ρ₁ (Ideal.Quotient.mk _ (MvPowerSeries.X 0))) = 1 ∧ (∀ F ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) ^ 2, PowerSeries.coeff 1 (ρ₀ (Ideal.Quotient.mk _ F)) = 0 ∧ PowerSeries.coeff 1 (ρ₁ (Ideal.Quotient.mk _ F)) = 0) ∧ ∀ Q : Ideal (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), Q.IsPrime → Q = RingHom.ker ρ₀ ∨ Q = RingHom.ker ρ₁ ∨ Q = RingHom.ker (PowerSeries.constantCoeff.comp ρ₀) :=
by
  intro k _
  classical

  let σ : Fin 2 → MvPowerSeries (Fin 2) k →+* PowerSeries k := fun j =>
    { toFun := fun f => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
      map_one' := by
        ext n
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
        simp
      map_mul' := by
        intro f g
        ext n
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul,
          Finsupp.antidiagonal_single, Finset.sum_map]
        simp [PowerSeries.coeff_mk]
      map_zero' := by ext n; simp
      map_add' := by intro f g; ext n; simp }
  have hσc : ∀ (j : Fin 2) (f : MvPowerSeries (Fin 2) k) (n : ℕ),
      PowerSeries.coeff n (σ j f) = MvPowerSeries.coeff (Finsupp.single j n) f :=
    fun j f n => PowerSeries.coeff_mk n (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
  have hσX : ∀ i j : Fin 2, i ≠ j → σ j (MvPowerSeries.X i) = 0 := by
    intro i j hij
    ext n
    rw [hσc, MvPowerSeries.coeff_X, map_zero, if_neg]
    intro h
    have h2 := congrArg (fun m : Fin 2 →₀ ℕ => m i) h
    simp [Finsupp.single_apply, hij, Ne.symm hij] at h2
  have hσker : ∀ i j : Fin 2, i ≠ j → (∀ l : Fin 2, l ≠ j → l = i) →
      ∀ f, σ j f = 0 → MvPowerSeries.X i ∣ f := by
    intro i j hij hk f hf
    rw [MvPowerSeries.X_dvd_iff]
    intro m hm
    have hm' : m = Finsupp.single j (m j) := by
      ext l
      by_cases hlj : l = j
      · subst hlj; simp
      · rw [hk l hlj]
        simp [hm, Finsupp.single_apply, hij, Ne.symm hij]
    rw [hm', ← hσc, hf, map_zero]
  have hσsurj : ∀ j : Fin 2, Function.Surjective (σ j) := by
    intro j g
    let F : MvPowerSeries (Fin 2) k :=
      fun m => if m = Finsupp.single j (m j) then PowerSeries.coeff (m j) g else 0
    refine ⟨F, ?_⟩
    ext n
    have hF : MvPowerSeries.coeff (Finsupp.single j n) F =
        (if Finsupp.single j n = Finsupp.single j ((Finsupp.single j n) j)
          then PowerSeries.coeff ((Finsupp.single j n) j) g else 0) := rfl
    rw [hσc, hF]
    simp
  have hσspan : ∀ (j : Fin 2), ∀ a ∈ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)}, σ j a = 0 := by
    intro j a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_mul]
    fin_cases j
    · simp [hσX 1 0 (by decide)]
    · simp [hσX 0 1 (by decide)]
  have hcc : ∀ (j : Fin 2) (f : MvPowerSeries (Fin 2) k),
      PowerSeries.constantCoeff (σ j f) = MvPowerSeries.constantCoeff f := by
    intro j f
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, hσc, Finsupp.single_zero,
      ← MvPowerSeries.coeff_zero_eq_constantCoeff_apply]

  have hM : ∀ m ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k),
      MvPowerSeries.constantCoeff m = 0 := by
    intro m hm
    by_contra h
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hm))
      (MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr h))
  have hm2 : ∀ (j : Fin 2), ∀ F ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) ^ 2,
      PowerSeries.coeff 1 (σ j F) = 0 := by
    intro j F hF
    rw [pow_two] at hF
    refine Submodule.mul_induction_on hF ?_ ?_
    · intro m hm n hn
      have h0m : PowerSeries.coeff 0 (σ j m) = 0 := by
        rw [PowerSeries.coeff_zero_eq_constantCoeff_apply, hcc, hM m hm]
      have h0n : PowerSeries.coeff 0 (σ j n) = 0 := by
        rw [PowerSeries.coeff_zero_eq_constantCoeff_apply, hcc, hM n hn]
      rw [map_mul, PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
      simp [Finset.sum_range_succ, h0m, h0n]
    · intro x y hx hy
      rw [map_add, map_add, hx, hy, add_zero]

  let ρ₀ := Ideal.Quotient.lift _ (σ 1) (hσspan 1)
  let ρ₁ := Ideal.Quotient.lift _ (σ 0) (hσspan 0)
  have hρ₀ : ∀ F, ρ₀ (Ideal.Quotient.mk _ F) = σ 1 F := fun F => Ideal.Quotient.lift_mk _ _ _
  have hρ₁ : ∀ F, ρ₁ (Ideal.Quotient.mk _ F) = σ 0 F := fun F => Ideal.Quotient.lift_mk _ _ _
  have hρ₀s : Function.Surjective ρ₀ := by
    intro g
    obtain ⟨F, hF⟩ := hσsurj 1 g
    exact ⟨Ideal.Quotient.mk _ F, (hρ₀ F).trans hF⟩
  have hρ₁s : Function.Surjective ρ₁ := by
    intro g
    obtain ⟨F, hF⟩ := hσsurj 0 g
    exact ⟨Ideal.Quotient.mk _ F, (hρ₁ F).trans hF⟩
  have hccρ : PowerSeries.constantCoeff.comp ρ₁ = PowerSeries.constantCoeff.comp ρ₀ := by
    apply Ideal.Quotient.ringHom_ext
    apply RingHom.ext
    intro F
    simp only [RingHom.comp_apply, hρ₀, hρ₁, hcc]

  have hpp : ∀ (B : Type u) [CommRing B] (ρ : B →+* PowerSeries k), Function.Surjective ρ →
      ∀ Q : Ideal B, Q.IsPrime → RingHom.ker ρ ≤ Q →
      Q = RingHom.ker ρ ∨ Q = RingHom.ker (PowerSeries.constantCoeff.comp ρ) := by
    intro B _ ρ hρ Q hQ hkQ
    have : (Q.map ρ).IsPrime := Ideal.map_isPrime_of_surjective hρ hkQ
    have hQQ : (Q.map ρ).comap ρ = Q := by
      rw [Ideal.comap_map_of_surjective' ρ hρ]
      exact sup_eq_left.mpr hkQ
    by_cases hb : Q.map ρ = ⊥
    · left
      rw [← hQQ, hb, ← RingHom.ker_eq_comap_bot]
    · right
      have hmax : (Q.map ρ).IsMaximal := Ideal.IsPrime.isMaximal inferInstance hb
      have heq : Q.map ρ = RingHom.ker (PowerSeries.constantCoeff (R := k)) := by
        rw [IsLocalRing.eq_maximalIdeal hmax, PowerSeries.maximalIdeal_eq_span_X]
        ext p
        rw [Ideal.mem_span_singleton, PowerSeries.X_dvd_iff, RingHom.mem_ker]
      rw [← hQQ, heq, RingHom.comap_ker]
  have hker0 : ∀ Q : Ideal (MvPowerSeries (Fin 2) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)}),
      Ideal.Quotient.mk _ (MvPowerSeries.X 0) ∈ Q → RingHom.ker ρ₀ ≤ Q := by
    intro Q hX z hz
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [RingHom.mem_ker, hρ₀] at hz
    obtain ⟨G, hG⟩ := hσker 0 1 (by decide) (fun l hl => by fin_cases l <;> simp_all) F hz
    rw [hG, map_mul]
    exact Ideal.mul_mem_right _ _ hX
  have hker1 : ∀ Q : Ideal (MvPowerSeries (Fin 2) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)}),
      Ideal.Quotient.mk _ (MvPowerSeries.X 1) ∈ Q → RingHom.ker ρ₁ ≤ Q := by
    intro Q hX z hz
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [RingHom.mem_ker, hρ₁] at hz
    obtain ⟨G, hG⟩ := hσker 1 0 (by decide) (fun l hl => by fin_cases l <;> simp_all) F hz
    rw [hG, map_mul]
    exact Ideal.mul_mem_right _ _ hX
  refine ⟨ρ₀, ρ₁, ?_, ?_, ?_, ?_, ?_⟩
  · intro a
    rw [hρ₀]
    ext n
    rw [hσc, MvPowerSeries.coeff_C, PowerSeries.coeff_C]
    simp [Finsupp.single_eq_zero]
  · rw [hρ₀, hσc, MvPowerSeries.coeff_X, if_pos rfl]
  · rw [hρ₁, hσc, MvPowerSeries.coeff_X, if_pos rfl]
  · intro F hF
    rw [hρ₀, hρ₁]
    exact ⟨hm2 1 F hF, hm2 0 F hF⟩
  · intro Q hQ
    have h0 : Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
        (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) k) *
        Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
        (MvPowerSeries.X 1) ∈ Q := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)]
      exact Q.zero_mem
    rcases hQ.mem_or_mem h0 with h | h
    · rcases hpp _ ρ₀ hρ₀s Q hQ (hker0 Q h) with h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inr h')
    · rcases hpp _ ρ₁ hρ₁s Q hQ (hker1 Q h) with h' | h'
      · exact Or.inr (Or.inl h')
      · right; right
        rw [h', hccρ]

theorem wcpa_dj_lqr_completion_bridge : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), (∀ (n : ℕ) (t : MvPowerSeries (Fin 2) L), ∃ r : R, e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) r) - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n)) ∧ (∀ (n : ℕ) (r : R), e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) r) ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) ↔ r ∈ IsLocalRing.maximalIdeal R ^ n) :=
by
  intro L _ R _ _ _ e
  classical

  have hmax : ∀ (S : Type u) [CommRing S] (j : R →+* S),
      (∀ c : S, ∃ p : R, c - j p ∈ Ideal.map j (IsLocalRing.maximalIdeal R)) →
      (∀ p : R, j p ∈ Ideal.map j (IsLocalRing.maximalIdeal R) → p ∈ IsLocalRing.maximalIdeal R) →
      (Ideal.map j (IsLocalRing.maximalIdeal R)).IsMaximal := by
    intro S _ j hd hs
    rw [Ideal.isMaximal_iff]
    refine ⟨fun h1 => ?_, fun J x hle hx hxJ => ?_⟩
    · have h1' : (1 : R) ∈ IsLocalRing.maximalIdeal R := hs 1 (by rw [map_one]; exact h1)
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h1')
    · obtain ⟨p, hp⟩ := hd x
      have hpm : p ∉ IsLocalRing.maximalIdeal R := by
        intro hpm
        apply hx
        have h2 := Ideal.add_mem _ hp (Ideal.mem_map_of_mem j hpm)
        rwa [sub_add_cancel] at h2
      have hu : IsUnit (j p) := (IsLocalRing.notMem_maximalIdeal.mp hpm).map j
      have hjp : j p ∈ J := by
        have h3 := J.sub_mem hxJ (hle hp)
        rwa [sub_sub_cancel] at h3
      rw [Ideal.eq_top_of_isUnit_mem J hjp hu]
      exact Submodule.mem_top

  have hN : ∀ M : Ideal (MvPowerSeries (Fin 2) L ⧸
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), M.IsMaximal →
      M = Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
        (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) := by
    intro M hM
    have hle : M ≤ Ideal.map (Ideal.Quotient.mk
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
        (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) := by
      intro y hy
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
      apply Ideal.mem_map_of_mem
      by_contra hF
      have hu := (IsLocalRing.notMem_maximalIdeal.mp hF).map
        (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
      exact hM.ne_top (Ideal.eq_top_of_isUnit_mem M hy hu)
    have hne : Ideal.map (Ideal.Quotient.mk
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
        (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) ≠ ⊤ := by
      intro htop
      have h1 : 1 ∈ Ideal.map (Ideal.Quotient.mk
          (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L)) := by
        rw [htop]; exact Submodule.mem_top
      rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at h1
      obtain ⟨F, hF, hF1⟩ := h1
      rw [← map_one (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})),
        Ideal.Quotient.eq, Ideal.mem_span_singleton'] at hF1
      obtain ⟨G, hG⟩ := hF1
      have hc := congrArg MvPowerSeries.constantCoeff hG
      simp only [map_mul, map_sub, map_one, MvPowerSeries.constantCoeff_X, mul_zero] at hc
      have hF0 : MvPowerSeries.constantCoeff F ≠ 0 := by
        intro h0
        rw [h0] at hc
        simp at hc
      apply (IsLocalRing.mem_maximalIdeal _).mp hF
      exact MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr hF0)
    exact hM.eq_of_le hne hle


  have hlev : (∀ (k : ℕ) (c : AdicCompletion (IsLocalRing.maximalIdeal R) R), ∃ p : R, c - algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) (IsLocalRing.maximalIdeal R ^ k)) ∧ (∀ (k : ℕ) (p : R), algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) (IsLocalRing.maximalIdeal R ^ k) → p ∈ IsLocalRing.maximalIdeal R ^ k) := by
    have hfg : (IsLocalRing.maximalIdeal R).FG := IsNoetherian.noetherian _
    have hmem : ∀ (k : ℕ) (b : AdicCompletion (IsLocalRing.maximalIdeal R) R),
        b ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
          (IsLocalRing.maximalIdeal R ^ k) ↔
        AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k b = 0 := by
      intro k b
      have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := R) (n := k) hfg
      have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal R) R)
        (IsLocalRing.maximalIdeal R ^ k)
      have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
      rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
      exact h3
    have hof : ∀ (k : ℕ) (p : R), AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k
        (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p) =
        Submodule.Quotient.mk p := by
      intro k p
      change AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k
        (AdicCompletion.of (IsLocalRing.maximalIdeal R) R p) = _
      rw [AdicCompletion.eval_of]
      rfl
    refine ⟨fun k c => ?_, fun k p h => ?_⟩
    · obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _
        (AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k c)
      refine ⟨p, (hmem k _).mpr ?_⟩
      rw [map_sub, hof, hp, sub_self]
    · rw [hmem, hof, Submodule.Quotient.mk_eq_zero] at h
      have hle : IsLocalRing.maximalIdeal R ^ k • (⊤ : Submodule R R) ≤
          IsLocalRing.maximalIdeal R ^ k := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      exact hle h
  obtain ⟨L1, L2⟩ := hlev
  have h𝔐 := hmax (AdicCompletion (IsLocalRing.maximalIdeal R) R)
    (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
    (fun c => by have h := L1 1 c; rwa [pow_one] at h)
    (fun p hp => by
      have h := L2 1 p (by rwa [pow_one]); rwa [pow_one] at h)
  haveI := h𝔐
  have hEq := hN _ (Ideal.map_isMaximal_of_equiv e
    (p := Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
      (IsLocalRing.maximalIdeal R)))
  have hPow : ∀ n : ℕ, Ideal.map e (Ideal.map
      (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
      (IsLocalRing.maximalIdeal R ^ n)) =
      Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
        (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) := by
    intro n
    rw [Ideal.map_pow, Ideal.map_pow, hEq, Ideal.map_pow]
  refine ⟨fun n t => ?_, fun n r => ⟨fun h => ?_, fun h => ?_⟩⟩
  · obtain ⟨r, hr⟩ := L1 n (e.symm
      (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t))
    refine ⟨r, ?_⟩
    have h := Ideal.mem_map_of_mem e hr
    rw [hPow, map_sub, RingEquiv.apply_symm_apply] at h
    rw [← neg_sub]
    exact (Ideal.neg_mem_iff _).mpr h
  · rw [← hPow, Ideal.mem_map_iff_of_surjective e e.surjective] at h
    obtain ⟨x, hx, hxe⟩ := h
    have hx' := e.injective hxe
    rw [hx'] at hx
    exact L2 n r hx
  · rw [← hPow]
    exact Ideal.mem_map_of_mem e (Ideal.mem_map_of_mem _ h)

theorem wcpa_dj_lr1u_fn_tb_na_branch_ne_max : ∀ (k D : Type u) [Field k] [CommRing D] [IsLocalRing D] [IsNoetherianRing D] (J : Ideal D), J = IsLocalRing.maximalIdeal D → ∀ (e : AdicCompletion J D ≃+* (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (ρ : (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries k) (j : Fin 2), PowerSeries.coeff 1 (ρ (Ideal.Quotient.mk _ (MvPowerSeries.X j))) = 1 → (∀ F ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) ^ 2, PowerSeries.coeff 1 (ρ (Ideal.Quotient.mk _ F)) = 0) → RingHom.ker (ρ.comp (e.toRingHom.comp (algebraMap D (AdicCompletion J D)))) ≠ IsLocalRing.maximalIdeal D :=
by
  intro k D _ _ _ _ J hJ e ρ j h1 hM2
  subst hJ
  obtain ⟨hA, hB⟩ := wcpa_dj_lqr_completion_bridge k D e
  obtain ⟨d, hd⟩ := hA 2 (MvPowerSeries.X j)
  obtain ⟨F, hF, hFeq⟩ :=
    (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hd
  have hed : e (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D) d) =
      Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
        (MvPowerSeries.X j + F) := by
    rw [map_add, hFeq]; ring
  have hXj : (MvPowerSeries.X j : MvPowerSeries (Fin 2) k) ∈
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      MvPowerSeries.constantCoeff_X]
    exact not_isUnit_zero
  have hFM : F ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) :=
    Ideal.pow_le_self two_ne_zero hF
  have hdm : d ∈ IsLocalRing.maximalIdeal D := by
    have h2 : e (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D) d) ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) k) ^ 1) := by
      rw [hed, pow_one]
      exact Ideal.mem_map_of_mem _ (Ideal.add_mem _ hXj hFM)
    have h3 := (hB 1 d).mp h2
    rwa [pow_one] at h3
  have hcoeff : PowerSeries.coeff 1 ((ρ.comp (e.toRingHom.comp
      (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D)))) d) = 1 := by
    show PowerSeries.coeff 1 (ρ (e (algebraMap D
      (AdicCompletion (IsLocalRing.maximalIdeal D) D) d))) = 1
    rw [hed, map_add, map_add, map_add, h1, hM2 F hF, add_zero]
  intro hker
  have hdk : d ∈ RingHom.ker (ρ.comp (e.toRingHom.comp
      (algebraMap D (AdicCompletion (IsLocalRing.maximalIdeal D) D)))) := by
    rw [hker]; exact hdm
  rw [RingHom.mem_ker] at hdk
  rw [hdk, map_zero] at hcoeff
  exact zero_ne_one hcoeff

theorem wcpa_dj_nd_low_coeff_vanish_mem_pow : ∀ (S : Type u) [CommRing S] (n : ℕ) (F : MvPowerSeries (Fin 2) S), (∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < n → MvPowerSeries.coeff d F = 0) → F ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) S)) ^ n :=
by
  intro S _ n
  induction n with
  | zero => intro F _; simp
  | succ n ih =>
    intro F hF
    have h0 : MvPowerSeries.coeff (0 : Fin 2 →₀ ℕ) F = 0 := hF 0 (by simp)
    let G : MvPowerSeries (Fin 2) S := fun d => MvPowerSeries.coeff (d + Finsupp.single 0 1) F
    let H : MvPowerSeries (Fin 2) S := fun d =>
      if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 1) F else 0
    have hG : ∀ d, MvPowerSeries.coeff d G = MvPowerSeries.coeff (d + Finsupp.single 0 1) F :=
      fun d => rfl
    have hH : ∀ d, MvPowerSeries.coeff d H =
        if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 1) F else 0 := fun d => rfl
    clear_value G H
    have hsplit : F = MvPowerSeries.X 0 * G + MvPowerSeries.X 1 * H := by
      ext d
      rw [map_add, MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul,
        MvPowerSeries.coeff_monomial_mul, hG, hH]
      by_cases ha : d 0 = 0
      · by_cases hb : d 1 = 0
        · have hd : d = 0 := by
            ext i; fin_cases i
            · simpa using ha
            · simpa using hb
          subst hd
          have h1 : ¬ Finsupp.single (0 : Fin 2) 1 ≤ 0 := by
            rw [Finsupp.single_le_iff]; simp
          have h2 : ¬ Finsupp.single (1 : Fin 2) 1 ≤ 0 := by
            rw [Finsupp.single_le_iff]; simp
          rw [if_neg h1, if_neg h2, h0, add_zero]
        · have h1 : ¬ Finsupp.single (0 : Fin 2) 1 ≤ d := by
            rw [Finsupp.single_le_iff]; omega
          have h2 : Finsupp.single (1 : Fin 2) 1 ≤ d := by
            rw [Finsupp.single_le_iff]; omega
          have h3 : (d - Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = 0 := by simp [ha]
          rw [if_neg h1, if_pos h2, if_pos h3, tsub_add_cancel_of_le h2, zero_add, one_mul]
      · have h1 : Finsupp.single (0 : Fin 2) 1 ≤ d := by
          rw [Finsupp.single_le_iff]; omega
        rw [if_pos h1, tsub_add_cancel_of_le h1, one_mul]
        by_cases h2 : Finsupp.single (1 : Fin 2) 1 ≤ d
        · have h3 : ¬ (d - Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = 0 := by simpa using ha
          rw [if_pos h2, if_neg h3, mul_zero, add_zero]
        · rw [if_neg h2, add_zero]
    have hGmem : G ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) S)) ^ n := by
      apply ih G
      intro d hd
      rw [hG]
      apply hF
      simp
      omega
    have hHmem : H ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) S)) ^ n := by
      apply ih H
      intro d hd
      rw [hH]
      split_ifs
      · apply hF
        simp
        omega
      · rfl
    rw [hsplit, pow_succ']
    apply Ideal.add_mem
    · exact Ideal.mul_mem_mul (Ideal.subset_span (by simp)) hGmem
    · exact Ideal.mul_mem_mul (Ideal.subset_span (by simp)) hHmem

theorem wcpa_dj_fva_tg_node_arcs : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (φ : K →+* R) (e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → ∃ (θ₀ θ₁ : R →+* PowerSeries K) (r₀ r₁ : R), (∀ c : K, θ₀ (φ c) = PowerSeries.C c) ∧ (∀ c : K, θ₁ (φ c) = PowerSeries.C c) ∧ (∀ y ∈ IsLocalRing.maximalIdeal R, PowerSeries.constantCoeff (θ₀ y) = 0 ∧ PowerSeries.constantCoeff (θ₁ y) = 0) ∧ r₀ ∈ IsLocalRing.maximalIdeal R ∧ r₁ ∈ IsLocalRing.maximalIdeal R ∧ PowerSeries.coeff 1 (θ₀ r₀) = 1 ∧ PowerSeries.X ^ 2 ∣ θ₁ r₀ ∧ PowerSeries.X ^ 2 ∣ θ₀ r₁ ∧ PowerSeries.coeff 1 (θ₁ r₁) = 1 ∧ ∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c₀ c₁ : K, y - φ c₀ * r₀ - φ c₁ * r₁ ∈ IsLocalRing.maximalIdeal R ^ 2 :=
by
  intro K _ R _ _ _ φ e hH
  obtain ⟨B1, B2⟩ := wcpa_dj_lqr_completion_bridge K R e

  have hU : ∀ F : MvPowerSeries (Fin 2) K,
      F ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ↔
        MvPowerSeries.constantCoeff F = 0 := by
    intro F
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      isUnit_iff_ne_zero, not_not]

  have hσ : ∀ i : Fin 2, ∃ σ : MvPowerSeries (Fin 2) K →+* PowerSeries K,
      ∀ (F : MvPowerSeries (Fin 2) K) (n : ℕ),
        PowerSeries.coeff n (σ F) = MvPowerSeries.coeff (Finsupp.single i n) F := by
    intro i
    refine ⟨{ toFun := fun F => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single i n) F),
              map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ },
      fun F n => PowerSeries.coeff_mk (R := K) n
        (fun n => MvPowerSeries.coeff (Finsupp.single i n) F)⟩
    · ext n
      rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
      simp [Finsupp.single_eq_zero]
    · intro F G
      ext n
      rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul, MvPowerSeries.coeff_mul,
        Finsupp.antidiagonal_single, Finset.sum_map]
      simp [PowerSeries.coeff_mk]
    · ext n
      simp
    · intro F G
      ext n
      simp

  have hprops : ∀ (i : Fin 2) (σ : MvPowerSeries (Fin 2) K →+* PowerSeries K),
      (∀ (F : MvPowerSeries (Fin 2) K) (n : ℕ),
        PowerSeries.coeff n (σ F) = MvPowerSeries.coeff (Finsupp.single i n) F) →
      (∀ c : K, σ (MvPowerSeries.C c) = PowerSeries.C c) ∧ σ (MvPowerSeries.X i) = PowerSeries.X ∧
        (∀ j : Fin 2, j ≠ i → σ (MvPowerSeries.X j) = 0) ∧
        ∀ (n : ℕ) (G : MvPowerSeries (Fin 2) K),
          G ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ n → PowerSeries.X ^ n ∣ σ G := by
    intro i σ hs
    refine ⟨fun c => ?_, ?_, fun j hj => ?_, fun n G hG => ?_⟩
    · ext n
      rw [hs, MvPowerSeries.coeff_C, PowerSeries.coeff_C]
      simp [Finsupp.single_eq_zero]
    · ext n
      rw [hs, MvPowerSeries.coeff_X, PowerSeries.coeff_X]
      by_cases hn : n = 1
      · subst hn; simp
      · rw [if_neg hn, if_neg]
        exact fun h => hn (Finsupp.single_injective i h)
    · ext n
      rw [hs, MvPowerSeries.coeff_X, map_zero, if_neg]
      intro h
      have h' := congrArg (fun f : Fin 2 →₀ ℕ => f j) h
      simp [Finsupp.single_apply, hj, Ne.symm hj] at h'
    · have h1 : IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ≤
          (Ideal.span {(PowerSeries.X : PowerSeries K)}).comap σ := by
        intro y hy
        rw [Ideal.mem_comap, Ideal.mem_span_singleton, PowerSeries.X_dvd_iff,
          ← PowerSeries.coeff_zero_eq_constantCoeff_apply, hs, Finsupp.single_zero,
          MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        exact (hU y).mp hy
      have h2 := ((Ideal.pow_right_mono h1 n).trans (Ideal.le_comap_pow σ n)) hG
      rw [Ideal.mem_comap, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h2
      exact h2
  obtain ⟨σ0, hs0⟩ := hσ 0
  obtain ⟨σ1, hs1⟩ := hσ 1
  obtain ⟨C0, X0, Z0, M0⟩ := hprops 0 σ0 hs0
  obtain ⟨C1, X1, Z1, M1⟩ := hprops 1 σ1 hs1
  have k0 : ∀ a ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} :
      Ideal (MvPowerSeries (Fin 2) K)), σ0 a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_mul, Z0 1 (by decide), mul_zero, mul_zero]
  have k1 : ∀ a ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} :
      Ideal (MvPowerSeries (Fin 2) K)), σ1 a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_mul, Z1 0 (by decide), zero_mul, mul_zero]
  obtain ⟨j, hj⟩ : ∃ j : R →+* (MvPowerSeries (Fin 2) K ⧸
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      ∀ r, j r = e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) r) :=
    ⟨e.toRingHom.comp (algebraMap R _), fun r => rfl⟩
  have hφ : ∀ c : K, j (φ c) = Ideal.Quotient.mk _ (MvPowerSeries.C c) := by
    intro c
    rw [hj]
    exact RingHom.congr_fun hH c
  let ε0 := Ideal.Quotient.lift _ σ0 k0
  let ε1 := Ideal.Quotient.lift _ σ1 k1
  have KI0 : ∀ (r : R) (F : MvPowerSeries (Fin 2) K), j r = Ideal.Quotient.mk _ F →
      (ε0.comp j) r = σ0 F := by
    intro r F h
    rw [RingHom.comp_apply, h, Ideal.Quotient.lift_mk]
  have KI1 : ∀ (r : R) (F : MvPowerSeries (Fin 2) K), j r = Ideal.Quotient.mk _ F →
      (ε1.comp j) r = σ1 F := by
    intro r F h
    rw [RingHom.comp_apply, h, Ideal.Quotient.lift_mk]
  have lift : ∀ (n : ℕ) (y : R), y ∈ IsLocalRing.maximalIdeal R ^ n →
      ∃ F ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ n,
        Ideal.Quotient.mk _ F = j y := by
    intro n y hy
    rw [hj]
    exact (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp ((B2 n y).mpr hy)
  have mkr : ∀ i : Fin 2, ∃ (r : R) (G : MvPowerSeries (Fin 2) K),
      G ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ 2 ∧
      j r = Ideal.Quotient.mk _ (MvPowerSeries.X i + G) ∧ r ∈ IsLocalRing.maximalIdeal R := by
    intro i
    obtain ⟨r, hr⟩ := B1 2 (MvPowerSeries.X i)
    obtain ⟨G, hG, hGe⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hr
    have hjr : j r = Ideal.Quotient.mk _ (MvPowerSeries.X i + G) := by
      rw [map_add, hGe, hj]
      ring
    refine ⟨r, G, hG, hjr, ?_⟩
    have hXG : MvPowerSeries.X i + G ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) ^ 1 := by
      rw [pow_one]
      exact Ideal.add_mem _ ((hU _).mpr (by simp)) (Ideal.pow_le_self two_ne_zero hG)
    have h1 := (B2 1 r).mp (by rw [← hj, hjr]; exact Ideal.mem_map_of_mem _ hXG)
    rwa [pow_one] at h1
  obtain ⟨r0, G0, hG0, hjr0, hr0⟩ := mkr 0
  obtain ⟨r1, G1, hG1, hjr1, hr1⟩ := mkr 1
  refine ⟨ε0.comp j, ε1.comp j, r0, r1, ?_, ?_, ?_, hr0, hr1, ?_, ?_, ?_, ?_, ?_⟩
  · intro c
    rw [KI0 _ _ (hφ c), C0]
  · intro c
    rw [KI1 _ _ (hφ c), C1]
  · intro y hy
    obtain ⟨F, hF, hFe⟩ := lift 1 y (by rwa [pow_one])
    rw [KI0 _ _ hFe.symm, KI1 _ _ hFe.symm]
    exact ⟨PowerSeries.X_dvd_iff.mp (by simpa using M0 1 F hF),
      PowerSeries.X_dvd_iff.mp (by simpa using M1 1 F hF)⟩
  · rw [KI0 _ _ hjr0, map_add, X0, map_add, PowerSeries.coeff_X, if_pos rfl]
    have h := (PowerSeries.X_pow_dvd_iff.mp (M0 2 G0 hG0)) 1 (by norm_num)
    rw [h, add_zero]
  · rw [KI1 _ _ hjr0, map_add, Z1 0 (by decide), zero_add]
    exact M1 2 G0 hG0
