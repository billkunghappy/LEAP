    obtain ⟨_, ⟨v, hvU, rfl⟩, hvW⟩ := mem_closure_iff.mp hmem _ hUo ⟨u, hu, rfl⟩
    exact ⟨v, hvU, hvW⟩
  have hTc : IsOpen (T : Set ↥Zt₂)ᶜ := by
