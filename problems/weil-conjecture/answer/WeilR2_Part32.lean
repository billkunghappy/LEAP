  have hext : ∀ (e : ℕ) (g : ∀ l : Fin (N + 1), Γ(X, b ⁻¹ᵁ wcSgD K N l)),
      g ∈ wcGcDfSec b (E * e) →
      ∃ f ∈ wcGcDfSec ψ e, ∀ l : Fin (N + 1),
        X.presheaf.map (homOfLE (hψ l)).op (f (J0 l)) = g l := by
    intro e g hg
    have hkey : ∀ (A : Fin (M + 1)) (l m : Fin (N + 1)) (Y : X.Opens)
        (hYA : Y ≤ ψ ⁻¹ᵁ wcSgD K M A) (hY : Y ≤ b ⁻¹ᵁ wcSgD K N l ⊓ b ⁻¹ᵁ wcSgD K N m),
