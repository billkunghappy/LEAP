    ∀ (𝔭 : Ideal ↑Γ(X, V)),
      (∀ f : ↑Γ(X, V), f ∈ 𝔭 ↔ wcpaDjLkImg W (γ ≫ ι) uX y₀ ∉ X.basicOpen f) →
