        Polynomial.eval_X] at hpx
      simp only [map_add, map_pow, Polynomial.aeval_X, map_sum, map_mul, Polynomial.aeval_C]
      have e : ∀ i : Fin N, algebraMap ↥W Λ (w i) * x ^ (i : ℕ) =
          p.coeff i * x ^ (i : ℕ) - t * (a' i * x ^ (i : ℕ)) := by
        intro i
        rw [ha' i]
        ring
      rw [Finset.sum_congr rfl (fun i _ => e i), Finset.sum_sub_distrib, ← Finset.mul_sum]
      linear_combination hpx

  have hrep : ∀ x : ↥B₁, ∃ w : ↥W, x - algebraMap ↥W ↥B₁ w ∈ n := by
    intro x
    obtain ⟨f, hfm, y, hyB, hfy⟩ := hres_a (x : Λ) x.2
    obtain ⟨r, hr⟩ := hsplitN f.natDegree f hfm rfl
    have hmem : Polynomial.aeval x f ∈ n := by
      apply htn ⟨y, hyB⟩
      rw [← Subalgebra.aeval_coe]
      exact hfy
    rw [hr, map_multiset_prod, Multiset.map_map, hnP.multiset_prod_mem_iff_exists_mem] at hmem
    obtain ⟨q, hq, hqn⟩ := hmem
    obtain ⟨a, _, rfl⟩ := Multiset.mem_map.mp hq
    refine ⟨a, ?_⟩
    simpa [Polynomial.aeval_X, Polynomial.aeval_C] using hqn
  have hdisj : Disjoint (↑(Submonoid.powers (⟨b, hbB⟩ : ↥B₁)) : Set ↥B₁) ↑n := by
    rw [Set.disjoint_left]
    rintro x ⟨k, rfl⟩ hxn
    exact hbn (hnP.mem_of_pow_mem k hxn)

  have main : ∀ (E : Type u) [CommRing E] [Algebra ↥B₁ E] [Algebra ↥W E]
      [IsScalarTower ↥W ↥B₁ E] [IsLocalization.Away (⟨b, hbB⟩ : ↥B₁) E],
      Algebra.IsStandardSmoothOfRelativeDimension 1 ↥W E →
      ∃ z : ↥B₁, z ∉ n ∧ ∃ (hgB : b * (z : Λ) ∈ B₁),
      ∃ φ : Polynomial ↥W →+* Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁),
        RingHom.Etale (R := Polynomial ↥W) (S := Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁)) φ ∧
        (∀ w : ↥W, φ (Polynomial.C w) =
          algebraMap ↥W (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁)) w) ∧
      ∃ P : Polynomial ↥W, P.Monic ∧ 1 ≤ P.natDegree ∧
        P.map (IsLocalRing.residue ↥W) = Polynomial.X ^ P.natDegree ∧
      ∃ ε : (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁))ˣ,
        algebraMap ↥B₁ (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁)) ⟨t, htB⟩ = ↑ε * φ P := by
    intro E _ _ _ _ _ hsmE
    obtain ⟨nE, hnE⟩ : ∃ nE : Ideal E, nE = n.map (algebraMap ↥B₁ E) := ⟨_, rfl⟩
    haveI hnEP : nE.IsPrime := by
      rw [hnE]
      exact IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (⟨b, hbB⟩ : ↥B₁)) E n
        hnP hdisj
    have hcomap : ∀ x : ↥B₁, algebraMap ↥B₁ E x ∈ nE ↔ x ∈ n := by
      have := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers (⟨b, hbB⟩ : ↥B₁))
        E hnP hdisj
      intro x
      constructor
      · intro h
        rw [← this, ← hnE]
        exact h
      · intro h
        rw [hnE]
        exact Ideal.mem_map_of_mem _ h
    have hbE : IsUnit (algebraMap ↥B₁ E ⟨b, hbB⟩) := IsLocalization.Away.algebraMap_isUnit _
    have hresE : ∀ d : E, ∃ w : ↥W, d - algebraMap ↥W E w ∈ nE := by
      intro d
      obtain ⟨k, y, hy⟩ := IsLocalization.Away.surj (⟨b, hbB⟩ : ↥B₁) d
      obtain ⟨w₁, hw₁⟩ := hrep y
      obtain ⟨w₂, hw₂⟩ := hrep ⟨b, hbB⟩
      have hw₂u : IsUnit w₂ := by
        by_contra hcon
        have hm : w₂ ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hcon
        apply hbn
        have := n.add_mem hw₂ (hmn w₂ hm)
        rwa [sub_add_cancel] at this
      obtain ⟨u, hu⟩ := hw₂u
      refine ⟨w₁ * ↑(u⁻¹) ^ k, ?_⟩
      rw [← Ideal.mul_unit_mem_iff_mem nE (hbE.pow k), sub_mul, hy,
        IsScalarTower.algebraMap_apply ↥W ↥B₁ E, ← map_pow, ← map_mul, ← map_sub, hcomap]
      have h0 : w₁ * ↑(u⁻¹) ^ k * w₂ ^ k = w₁ := by
        rw [← hu, mul_assoc, ← mul_pow, Units.inv_mul, one_pow, mul_one]
      have h1 : algebraMap ↥W ↥B₁ (w₁ * ↑(u⁻¹) ^ k) * algebraMap ↥W ↥B₁ w₂ ^ k =
          algebraMap ↥W ↥B₁ w₁ := by
        rw [← map_pow, ← map_mul, h0]
      have key : y - algebraMap ↥W ↥B₁ (w₁ * ↑(u⁻¹) ^ k) * (⟨b, hbB⟩ : ↥B₁) ^ k =
          (y - algebraMap ↥W ↥B₁ w₁) - algebraMap ↥W ↥B₁ (w₁ * ↑(u⁻¹) ^ k) *
            ((⟨b, hbB⟩ : ↥B₁) ^ k - algebraMap ↥W ↥B₁ w₂ ^ k) := by
        linear_combination (-1 : ↥B₁) * h1
      rw [key]
      exact n.sub_mem hw₁ (n.mul_mem_left _ (Ideal.mem_of_dvd n (sub_dvd_pow_sub_pow _ _ k) hw₂))

    have hchart : ∃ φ₀ : Polynomial ↥W →+* E, φ₀.Etale ∧
        (∀ w : ↥W, φ₀ (Polynomial.C w) = algebraMap ↥W E w) ∧ φ₀ Polynomial.X ∈ nE := by
      obtain ⟨g, hgC, hget⟩ :=
        RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial
          ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hsmE)
      let e : Polynomial ↥W ≃ₐ[↥W] MvPolynomial (Fin 1) ↥W :=
        (MvPolynomial.uniqueAlgEquiv ↥W (Fin 1)).symm
      obtain ⟨a, ha⟩ := hresE (g (e Polynomial.X))
      let τ : Polynomial ↥W ≃ₐ[↥W] Polynomial ↥W := Polynomial.algEquivAevalXAddC (-a)
      let φ₀ : Polynomial ↥W →+* E :=
        g.comp ((e : Polynomial ↥W →+* MvPolynomial (Fin 1) ↥W).comp
          (τ : Polynomial ↥W →+* Polynomial ↥W))
      have hbij : Function.Bijective ((e : Polynomial ↥W →+* MvPolynomial (Fin 1) ↥W).comp
          (τ : Polynomial ↥W →+* Polynomial ↥W)) := (τ.trans e).bijective
      have h1 : RingHom.Etale (R := Polynomial ↥W) (S := MvPolynomial (Fin 1) ↥W)
          ((e : Polynomial ↥W →+* MvPolynomial (Fin 1) ↥W).comp
            (τ : Polynomial ↥W →+* Polynomial ↥W)) :=
        RingHom.Etale.of_bijective hbij
      have hC : ∀ w : ↥W, φ₀ (Polynomial.C w) = algebraMap ↥W E w := by
        intro w
        have e1 : ((e : Polynomial ↥W →+* MvPolynomial (Fin 1) ↥W).comp
            (τ : Polynomial ↥W →+* Polynomial ↥W)) (Polynomial.C w) = MvPolynomial.C w := by
          rw [Polynomial.C_eq_algebraMap]
          show e (τ (algebraMap ↥W (Polynomial ↥W) w)) = _
          rw [AlgEquiv.commutes, AlgEquiv.commutes, MvPolynomial.algebraMap_eq]
        show g (((e : Polynomial ↥W →+* MvPolynomial (Fin 1) ↥W).comp
            (τ : Polynomial ↥W →+* Polynomial ↥W)) (Polynomial.C w)) = _
        rw [e1, ← RingHom.comp_apply, hgC]
      refine ⟨φ₀, ?_, hC, ?_⟩
      · have h := RingHom.Etale.stableUnderComposition _ _ h1 hget
        exact h
      · show g (e (τ Polynomial.X)) ∈ nE
        have hτ : τ Polynomial.X = Polynomial.X + Polynomial.C (-a) := by
          show Polynomial.algEquivAevalXAddC (-a) Polynomial.X = _
          rw [Polynomial.algEquivAevalXAddC_apply, Polynomial.aeval_X]
        rw [hτ, map_add, map_add]
        have e2 : g (e (Polynomial.C (-a))) = - algebraMap ↥W E a := by
          rw [Polynomial.C_eq_algebraMap, AlgEquiv.commutes, MvPolynomial.algebraMap_eq,
            ← RingHom.comp_apply, hgC, map_neg]
        rw [e2, ← sub_eq_add_neg]
        exact ha
    obtain ⟨φ₀, hφ₀et, hφ₀C, hφ₀X⟩ := hchart
    haveI := hsmE
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1 (R := ↥W) (S := E)
    haveI : Algebra.FiniteType ↥W E := inferInstance

    obtain ⟨tE, htEdef⟩ : ∃ x : E, x = algebraMap ↥B₁ E ⟨t, htB⟩ := ⟨_, rfl⟩
    have hmE : Ideal.map (algebraMap ↥W E) (IsLocalRing.maximalIdeal ↥W) ≤ nE := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply ↥W ↥B₁ E, hcomap]
      exact hmn w hw
    have htE : tE ∈ nE := by
      rw [htEdef, hcomap]
      exact htn 1 ⟨t, htB⟩ (by show t = t * 1; rw [mul_one])
    have hint : ∀ y : ↥B₁, IsIntegral ↥W (Ideal.Quotient.mk (Ideal.span {tE})
        (algebraMap ↥B₁ E y)) := by
      intro y
      obtain ⟨f, hfm, y', hy'B, hfy⟩ := hres_a (y : Λ) y.2
      refine ⟨f, hfm, ?_⟩
      let ψ : ↥B₁ →ₐ[↥W] E ⧸ Ideal.span {tE} :=
        (Ideal.Quotient.mkₐ ↥W (Ideal.span {tE})).comp (IsScalarTower.toAlgHom ↥W ↥B₁ E)
      have e1 : Polynomial.eval₂ (algebraMap ↥W (E ⧸ Ideal.span {tE}))
          (Ideal.Quotient.mk (Ideal.span {tE}) (algebraMap ↥B₁ E y)) f =
          ψ (Polynomial.aeval y f) := by
        rw [← Polynomial.aeval_algHom_apply, Polynomial.aeval_def]
        rfl
      have e2 : Polynomial.aeval y f = (⟨t, htB⟩ : ↥B₁) * ⟨y', hy'B⟩ := by
        apply Subtype.ext
        rw [← Subalgebra.aeval_coe]
        exact hfy
      rw [e1, e2, map_mul]
      have h0 : ψ ⟨t, htB⟩ = 0 := by
        show Ideal.Quotient.mk (Ideal.span {tE}) (algebraMap ↥B₁ E ⟨t, htB⟩) = 0
        rw [← htEdef]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [h0, zero_mul]
    have hintx : ∀ x : E, ∃ k : ℕ, IsIntegral ↥W (Ideal.Quotient.mk (Ideal.span {tE})
        (algebraMap ↥B₁ E ⟨b, hbB⟩ ^ k * x)) := by
      intro x
      obtain ⟨k, y, hy⟩ := IsLocalization.Away.surj (⟨b, hbB⟩ : ↥B₁) x
      refine ⟨k, ?_⟩
      rw [mul_comm, hy]
      exact hint y
    obtain ⟨g', hg'n, P, hPm, hPd, hPres, ε', hε'⟩ := wcpa_dj_lr1k_odfgl_chart_weierstrass Ω W
      E φ₀ hφ₀et hφ₀C nE hmE hφ₀X hresE tE (algebraMap ↥B₁ E ⟨b, hbB⟩) htE hbE (hint _) hintx

    obtain ⟨r, z, hz⟩ := IsLocalization.Away.surj (⟨b, hbB⟩ : ↥B₁) g'
    have hzn : z ∉ n := by
      intro h
      apply hg'n
      rw [← hcomap, ← hz] at h
      exact (Ideal.mul_unit_mem_iff_mem nE (hbE.pow r)).mp h
    have hgB : b * (z : Λ) ∈ B₁ := B₁.mul_mem hbB z.2
    have hgBe : (⟨b * (z : Λ), hgB⟩ : ↥B₁) = ⟨b, hbB⟩ * z := rfl
    have hgG : IsUnit (algebraMap ↥B₁ (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁))
        ⟨b * (z : Λ), hgB⟩) := IsLocalization.Away.algebraMap_isUnit _
    have hbG : IsUnit (algebraMap ↥B₁ (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁))
        ⟨b, hbB⟩) := by
      rw [hgBe, map_mul] at hgG
      exact isUnit_of_mul_isUnit_left hgG
    have hzG : IsUnit (algebraMap ↥B₁ (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁)) z) := by
      rw [hgBe, map_mul] at hgG
      exact isUnit_of_mul_isUnit_right hgG
    let L1 : E →+* Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁) :=
      IsLocalization.Away.lift (⟨b, hbB⟩ : ↥B₁) hbG
    have hL1 : ∀ a : ↥B₁, L1 (algebraMap ↥B₁ E a) =
        algebraMap ↥B₁ (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁)) a :=
      IsLocalization.Away.lift_eq _ hbG
    have hg'G : IsUnit (L1 g') := by
      have h2 : IsUnit (L1 g' * L1 (algebraMap ↥B₁ E ⟨b, hbB⟩) ^ r) := by
        rw [← map_pow, ← map_mul, hz, hL1]
        exact hzG
      exact isUnit_of_mul_isUnit_left h2
    let F2 : Localization.Away g' →+* Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁) :=
      IsLocalization.Away.lift g' hg'G
    have hF2 : ∀ a : E, F2 (algebraMap E (Localization.Away g') a) = L1 a :=
      IsLocalization.Away.lift_eq _ hg'G
    have hβE' : IsUnit (algebraMap E (Localization.Away g') (algebraMap ↥B₁ E ⟨b, hbB⟩)) :=
      hbE.map _
    have hgE' : IsUnit (((algebraMap E (Localization.Away g')).comp
        (algebraMap ↥B₁ E)) ⟨b * (z : Λ), hgB⟩) := by
      rw [RingHom.comp_apply, hgBe, map_mul, ← hz, map_mul, map_mul, map_pow]
      exact hβE'.mul ((IsLocalization.Away.algebraMap_isUnit g').mul (hβE'.pow r))
    let F1 : Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁) →+* Localization.Away g' :=
      IsLocalization.Away.lift (⟨b * (z : Λ), hgB⟩ : ↥B₁) hgE'
    have hF1 : ∀ a : ↥B₁, F1 (algebraMap ↥B₁ (Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁)) a) =
        algebraMap E (Localization.Away g') (algebraMap ↥B₁ E a) :=
      IsLocalization.Away.lift_eq _ hgE'
    have h21 : ∀ x, F2 (F1 x) = x := by
      have : F2.comp F1 = RingHom.id _ :=
        IsLocalization.ringHom_ext (Submonoid.powers (⟨b * (z : Λ), hgB⟩ : ↥B₁))
          (RingHom.ext fun a => by
            simp only [RingHom.comp_apply, RingHom.id_apply, hF1, hF2, hL1])
      exact fun x => RingHom.congr_fun this x
    have h12 : ∀ x, F1 (F2 x) = x := by
      have hE : F1.comp L1 = algebraMap E (Localization.Away g') :=
        IsLocalization.ringHom_ext (Submonoid.powers (⟨b, hbB⟩ : ↥B₁))
          (RingHom.ext fun a => by simp only [RingHom.comp_apply, hL1, hF1])
      have : F1.comp F2 = RingHom.id _ :=
        IsLocalization.ringHom_ext (Submonoid.powers g')
          (RingHom.ext fun a => by
            simp only [RingHom.comp_apply, RingHom.id_apply, hF2]
            exact RingHom.congr_fun hE a)
      exact fun x => RingHom.congr_fun this x
    have hF2bij : Function.Bijective F2 :=
      Function.bijective_iff_has_inverse.mpr ⟨F1, h12, h21⟩
    have hlocet : (algebraMap E (Localization.Away g')).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway g')
    have hc1 : ((algebraMap E (Localization.Away g')).comp φ₀).Etale :=
      RingHom.Etale.stableUnderComposition φ₀ (algebraMap E (Localization.Away g')) hφ₀et hlocet
    have hF2et : RingHom.Etale (R := Localization.Away g')
        (S := Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁)) F2 :=
      RingHom.Etale.of_bijective hF2bij
    have hφet : RingHom.Etale (R := Polynomial ↥W)
        (S := Localization.Away (⟨b * (z : Λ), hgB⟩ : ↥B₁))
        (F2.comp ((algebraMap E (Localization.Away g')).comp φ₀)) := by
      have h := RingHom.Etale.stableUnderComposition _ _ hc1 hF2et
      exact h
    refine ⟨z, hzn, hgB, F2.comp ((algebraMap E (Localization.Away g')).comp φ₀), hφet, ?_,
      P, hPm, hPd, hPres, Units.map F2.toMonoidHom ε', ?_⟩
    · intro w
      simp only [RingHom.comp_apply, hφ₀C, hF2]
      rw [IsScalarTower.algebraMap_apply ↥W ↥B₁ E, hL1, ← IsScalarTower.algebraMap_apply]
    · have := congrArg F2 hε'
      rw [htEdef, hF2, hL1, map_mul] at this
      rw [this]
      rfl
  obtain ⟨z, hzn, hgB, φ, hφ, hφC, P, hPm, hPd, hPres, ε, hε⟩ :=
    main (Localization.Away (⟨b, hbB⟩ : ↥B₁)) hsmb
  refine ⟨b * (z : Λ), hgB, hBR_le hgB, htB, ?_, φ, hφ, hφC, P, hPm, hPd, hPres, ε, hε⟩
  intro h
  apply hzn
  have hg : (⟨b * (z : Λ), hgB⟩ : ↥B₁) ∈ n := by
    rw [hn, Ideal.mem_comap, hj]
    exact h
  exact (hnP.mem_or_mem hg).resolve_left hbn

theorem wcpa_dj_lr1k_odfgl_ln_archimedean : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ a : Ω, a ≠ 0 → W.valuation a < 1 → ∀ x : Ω, ∃ N : ℕ, W.valuation (a ^ N * x) ≤ 1 :=
by
  intro Ω _ W hdim a _ ha x
  by_cases hx : x ∈ W
  · refine ⟨0, ?_⟩
    rw [pow_zero, one_mul]
    exact (W.valuation_le_one_iff x).mpr hx
  have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
  have hx0 : x ≠ 0 := by
    intro h
    apply hx
    rw [h]
    exact W.zero_mem
  have haW : a ∈ W := (W.valuation_le_one_iff a).mp ha.le
  set y' : ↥W := ⟨x⁻¹, hxi⟩ with hy'
  set a' : ↥W := ⟨a, haW⟩ with ha'
  have hy0 : y' ≠ 0 := by
    intro h
    have : (x⁻¹ : Ω) = 0 := congrArg Subtype.val h
    exact inv_ne_zero hx0 this
  have ham : a' ∈ IsLocalRing.maximalIdeal ↥W := (W.valuation_lt_one_iff a').mpr ha
  have hmax : ∀ I : Ideal ↥W, I ≠ ⊥ → I.IsPrime → I.IsMaximal :=
    Ring.krullDimLE_one_iff_of_noZeroDivisors.mp (Ring.krullDimLE_iff.mpr hdim)
  have hrad : a' ∈ (Ideal.span {y'}).radical := by
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro P ⟨hle, hP⟩
    have hyP : y' ∈ P := (Ideal.span_singleton_le_iff_mem P).mp hle
    have hPne : P ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hyP
      exact hy0 hyP
    have hPm := IsLocalRing.eq_maximalIdeal (hmax P hPne hP)
    rw [hPm]
    exact ham
  obtain ⟨N, hN⟩ := (Ideal.mem_radical_iff).mp hrad
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hN
  refine ⟨N, ?_⟩
  have hbΩ : (b : Ω) * x⁻¹ = a ^ N := by
    have := congrArg Subtype.val hb
    simpa using this
  have : a ^ N * x = (b : Ω) := by
    rw [← hbΩ, mul_assoc, inv_mul_cancel₀ hx0, mul_one]
  rw [this]
  exact W.valuation_le_one b

theorem wcpa_dj_lr1k_odfgl_ln_archpoly : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    (∀ a : Ω, a ≠ 0 → W.valuation a < 1 → ∀ x : Ω, ∃ N : ℕ, W.valuation (a ^ N * x) ≤ 1) →
    ∀ F H : Polynomial Ω, (∀ j, W.valuation (F.coeff j) < 1) →
      ∃ N : ℕ, ∀ j, W.valuation ((F ^ N * H).coeff j) ≤ 1 :=
by
  intro Ω _ W harch F H hF
  classical

  have hmul : ∀ (P Q : Polynomial Ω) (α β : W.ValueGroup),
      (∀ j, W.valuation (P.coeff j) ≤ α) → (∀ j, W.valuation (Q.coeff j) ≤ β) →
      ∀ j, W.valuation ((P * Q).coeff j) ≤ α * β := by
    intro P Q α β hP hQ j
    rw [Polynomial.coeff_mul]
    apply Valuation.map_sum_le
    intro x _
    rw [Valuation.map_mul]
    exact mul_le_mul' (hP _) (hQ _)

  have hmax : ∀ G : Polynomial Ω, ∃ j₀, ∀ j,
      W.valuation (G.coeff j) ≤ W.valuation (G.coeff j₀) := by
    intro G
    obtain ⟨j₀, -, hj₀⟩ := Finset.exists_max_image (Finset.range (G.natDegree + 1))
      (fun j => W.valuation (G.coeff j)) ⟨0, Finset.mem_range.mpr (Nat.succ_pos _)⟩
    refine ⟨j₀, fun j => ?_⟩
    by_cases hj : j ∈ Finset.range (G.natDegree + 1)
    · exact hj₀ j hj
    · have hlt : G.natDegree < j := by
        rw [Finset.mem_range] at hj
        omega
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt, Valuation.map_zero]
      exact zero_le'
  obtain ⟨j₀, hj₀⟩ := hmax F
  obtain ⟨j₁, hj₁⟩ := hmax H
  have hpow : ∀ N : ℕ, ∀ j, W.valuation ((F ^ N).coeff j) ≤ W.valuation (F.coeff j₀) ^ N := by
    intro N
    induction N with
    | zero =>
      intro j
      simp only [pow_zero]
      rw [Polynomial.coeff_one]
      split_ifs
      · rw [Valuation.map_one]
      · rw [Valuation.map_zero]; exact zero_le'
    | succ N ih =>
      intro j
      simp only [pow_succ]
      exact hmul _ _ _ _ ih hj₀ j
  have hprod : ∀ N j, W.valuation ((F ^ N * H).coeff j) ≤
      W.valuation (F.coeff j₀) ^ N * W.valuation (H.coeff j₁) :=
    fun N => hmul _ _ _ _ (hpow N) hj₁
  by_cases ha : F.coeff j₀ = 0
  · refine ⟨1, fun j => (hprod 1 j).trans ?_⟩
    rw [ha, Valuation.map_zero, pow_one, zero_mul]
    exact zero_le'
  · obtain ⟨N, hN⟩ := harch (F.coeff j₀) ha (hF j₀) (H.coeff j₁)
    refine ⟨N, fun j => (hprod N j).trans ?_⟩
    rw [Valuation.map_mul, Valuation.map_pow] at hN
    exact hN

theorem wcpa_dj_lr1k_odfgl_ln_discs : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (s : Multiset Ω), s ≠ 0 → (∀ a ∈ s, W.valuation a < 1) →
    ∀ c : Ω, c ≠ 0 → W.valuation c < 1 →
    ∃ (k : ℕ) (β lam : Fin k → Ω),
      (∀ l, β l ∈ s) ∧
      (∀ l, lam l ≠ 0 ∧ W.valuation (lam l) ^ Multiset.card s ≤ W.valuation c) ∧
      (∀ l l', l ≠ l' → W.valuation (lam l) < W.valuation (β l - β l')) ∧
      (∀ l j, W.valuation (((s.map (fun a => Polynomial.X - Polynomial.C a)).prod.comp
          (Polynomial.C (β l) + Polynomial.C (lam l) * Polynomial.X)).coeff j) ≤ W.valuation c) ∧
      (∀ x : Ω, W.valuation ((s.map (fun a => x - a)).prod) ≤ W.valuation c →
          ∃ l, W.valuation (x - β l) ≤ W.valuation (lam l)) :=
by
  intro Ω _ _ W s hs _ c hc _
  classical

  have prodconst : ∀ (u : Multiset Ω) (f : Ω → W.ValueGroup) (d : W.ValueGroup),
      (∀ a ∈ u, f a = d) → (u.map f).prod = d ^ Multiset.card u := by
    intro u f d h
    rw [Multiset.map_congr rfl h, Multiset.map_const', Multiset.prod_replicate]
  have prodle : ∀ (u : Multiset Ω) (f : Ω → W.ValueGroup) (d : W.ValueGroup),
      (∀ a ∈ u, f a ≤ d) → (u.map f).prod ≤ d ^ Multiset.card u := by
    intro u f d h
    calc (u.map f).prod ≤ (u.map (fun _ => d)).prod := by
          apply Multiset.prod_map_le_prod_map; exact h
      _ = d ^ Multiset.card u := by rw [Multiset.map_const', Multiset.prod_replicate]
  have leprod : ∀ (u : Multiset Ω) (f : Ω → W.ValueGroup) (d : W.ValueGroup),
      (∀ a ∈ u, d ≤ f a) → d ^ Multiset.card u ≤ (u.map f).prod := by
    intro u f d h
    calc d ^ Multiset.card u = (u.map (fun _ => d)).prod := by
          rw [Multiset.map_const', Multiset.prod_replicate]
      _ ≤ (u.map f).prod := by
          apply Multiset.prod_map_le_prod_map; exact h

  have hcoef : ∀ (t : Multiset Ω) (β lam : Ω) (j : ℕ),
      W.valuation (((t.map (fun a => Polynomial.X - Polynomial.C a)).prod.comp
        (Polynomial.C β + Polynomial.C lam * Polynomial.X)).coeff j) ≤
      (t.map (fun a => max (W.valuation (β - a)) (W.valuation lam))).prod := by
    intro t β lam
    induction t using Multiset.induction_on with
    | empty =>
      intro j
      simp only [Multiset.map_zero, Multiset.prod_zero, Polynomial.one_comp, Polynomial.coeff_one]
      split_ifs <;> simp
    | cons a t ih =>
      intro j
      rw [Multiset.map_cons, Multiset.prod_cons, Polynomial.mul_comp, Multiset.map_cons,
        Multiset.prod_cons]
      have e : (Polynomial.X - Polynomial.C a).comp
          (Polynomial.C β + Polynomial.C lam * Polynomial.X) =
          Polynomial.C (β - a) + Polynomial.C lam * Polynomial.X := by
        simp only [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp, Polynomial.C_sub]
        ring
      rw [e, add_mul, Polynomial.coeff_add, Polynomial.coeff_C_mul, mul_assoc,
        Polynomial.coeff_C_mul]
      have hXH : W.valuation ((Polynomial.X * ((t.map (fun a => Polynomial.X - Polynomial.C a)).prod.comp
          (Polynomial.C β + Polynomial.C lam * Polynomial.X))).coeff j) ≤
          (t.map (fun a => max (W.valuation (β - a)) (W.valuation lam))).prod := by
        cases j with
        | zero => rw [Polynomial.coeff_X_mul_zero, map_zero]; exact zero_le
        | succ i => rw [Polynomial.coeff_X_mul]; exact ih i
      refine Valuation.map_add_le _ ?_ ?_
      · rw [map_mul]; exact mul_le_mul' (le_max_left _ _) (ih j)
      · rw [map_mul]; exact mul_le_mul' (le_max_right _ _) hXH

  have core : ∀ n : ℕ, ∀ (t : Multiset Ω) (c' : Ω), Multiset.card t = n → t ≠ 0 → c' ≠ 0 →
      ∃ (k : ℕ) (β lam : Fin k → Ω),
        (∀ l, β l ∈ t) ∧
        (∀ l, lam l ≠ 0 ∧ W.valuation (lam l) ^ Multiset.card t ≤ W.valuation c') ∧
        (∀ l l', l ≠ l' → W.valuation (lam l) < W.valuation (β l - β l')) ∧
        (∀ l, (t.map (fun a => max (W.valuation (β l - a)) (W.valuation (lam l)))).prod ≤
          W.valuation c') ∧
        (∀ x : Ω, (t.map (fun a => W.valuation (x - a))).prod ≤ W.valuation c' →
          ∃ l, W.valuation (x - β l) ≤ W.valuation (lam l)) := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih t c' htn ht hc'
    obtain ⟨a1, ha1⟩ := Multiset.exists_mem_of_ne_zero ht
    obtain ⟨b, hb, hbmax⟩ := Multiset.exists_max_image (fun a => W.valuation (a - a1)) ht
    have hcard : 0 < Multiset.card t := Multiset.card_pos_iff_exists_mem.mpr ⟨a1, ha1⟩
    set δ := W.valuation (b - a1) with hδ
    by_cases hbase : δ ^ Multiset.card t ≤ W.valuation c'
    ·
      obtain ⟨L, hL⟩ := IsAlgClosed.exists_pow_nat_eq c' hcard
      have hL0 : L ≠ 0 := by
        rintro rfl
        apply hc'
        rw [← hL, zero_pow hcard.ne']
      have hvL : W.valuation L ^ Multiset.card t = W.valuation c' := by rw [← map_pow, hL]
      have hkey : ∀ a ∈ t, W.valuation (a - a1) ≤ W.valuation L := by
        intro a ha
        refine (pow_le_pow_iff_left₀ zero_le zero_le hcard.ne').mp ?_
        rw [hvL]
        exact (pow_le_pow_left₀ zero_le (hbmax a ha) _).trans hbase
      refine ⟨1, fun _ => a1, fun _ => L, fun _ => ha1, fun _ => ⟨hL0, hvL.le⟩, ?_, ?_, ?_⟩
      · intro l l' h
        exact absurd (Subsingleton.elim l l') h
      · intro l
        calc (t.map (fun a => max (W.valuation (a1 - a)) (W.valuation L))).prod
            ≤ W.valuation L ^ Multiset.card t := by
              apply prodle
              intro a ha
              rw [Valuation.map_sub_swap]
              exact max_le (hkey a ha) le_rfl
          _ = W.valuation c' := hvL
      · intro x hx
        refine ⟨0, ?_⟩
        show W.valuation (x - a1) ≤ W.valuation L
        by_contra hlt
        push_neg at hlt
        have heq : ∀ a ∈ t, W.valuation (x - a) = W.valuation (x - a1) := by
          intro a ha
          have e : x - a = (x - a1) + (a1 - a) := by ring
          rw [e, Valuation.map_add_eq_of_lt_left]
          rw [Valuation.map_sub_swap]
          exact lt_of_le_of_lt (hkey a ha) hlt
        have h1 : W.valuation (x - a1) ^ Multiset.card t ≤
            (t.map (fun a => W.valuation (x - a))).prod :=
          leprod _ _ _ (fun a ha => (heq a ha).ge)
        have h2 : W.valuation L ^ Multiset.card t < W.valuation (x - a1) ^ Multiset.card t :=
          pow_lt_pow_left₀ hlt zero_le hcard.ne'
        rw [hvL] at h2
        exact absurd (lt_of_lt_of_le h2 (h1.trans hx)) (lt_irrefl _)
    ·
      push_neg at hbase
      have hδ0 : δ ≠ 0 := by
        intro h0
        rw [h0, zero_pow hcard.ne'] at hbase
        exact absurd hbase (not_lt.mpr zero_le)
      have hδpos : 0 < δ := zero_lt_iff.mpr hδ0
      have hδn : ∀ m : ℕ, 0 < δ ^ m := fun m => zero_lt_iff.mpr (pow_ne_zero m hδ0)
      set t1 := t.filter (fun a => W.valuation (a - a1) < δ) with ht1
      set t2 := t.filter (fun a => ¬ W.valuation (a - a1) < δ) with ht2
      have htt : t1 + t2 = t := Multiset.filter_add_not _ t
      have hm1 : ∀ a ∈ t1, a ∈ t := fun a ha => (Multiset.mem_filter.mp ha).1
      have hm2 : ∀ a ∈ t2, a ∈ t := fun a ha => (Multiset.mem_filter.mp ha).1
      have ha1t1 : a1 ∈ t1 :=
        Multiset.mem_filter.mpr ⟨ha1, by rw [sub_self, map_zero]; exact hδpos⟩
      have hbt2 : b ∈ t2 := Multiset.mem_filter.mpr ⟨hb, lt_irrefl _⟩
      have hcardsum : Multiset.card t1 + Multiset.card t2 = Multiset.card t := by
        rw [← Multiset.card_add, htt]
      have hc1pos : 0 < Multiset.card t1 := Multiset.card_pos_iff_exists_mem.mpr ⟨a1, ha1t1⟩
      have hc2pos : 0 < Multiset.card t2 := Multiset.card_pos_iff_exists_mem.mpr ⟨b, hbt2⟩
      have hin1 : ∀ a ∈ t1, W.valuation (a - a1) < δ := fun a ha => (Multiset.mem_filter.mp ha).2
      have hin2 : ∀ a ∈ t2, W.valuation (a - a1) = δ := fun a ha =>
        le_antisymm (hbmax a (Multiset.mem_filter.mp ha).1) (not_lt.mp (Multiset.mem_filter.mp ha).2)
      have hcross : ∀ p ∈ t1, ∀ q ∈ t2, W.valuation (p - q) = δ := by
        intro p hp q hq
        have e : p - q = (p - a1) - (q - a1) := by ring
        rw [e, Valuation.map_sub_eq_of_lt_right _ (by rw [hin2 q hq]; exact hin1 p hp), hin2 q hq]
      have hcross' : ∀ p ∈ t1, ∀ q ∈ t2, W.valuation (q - p) = δ := fun p hp q hq => by
        rw [Valuation.map_sub_swap]; exact hcross p hp q hq
      have hsplit : ∀ f : Ω → W.ValueGroup,
          (t.map f).prod = (t1.map f).prod * (t2.map f).prod := by
        intro f
        rw [← Multiset.prod_add, ← Multiset.map_add, htt]

      set p1 := (t2.map (fun a => a1 - a)).prod with hp1
      set p2 := (t1.map (fun a => b - a)).prod with hp2
      have hvp1 : W.valuation p1 = δ ^ Multiset.card t2 := by
        rw [hp1, map_multiset_prod, Multiset.map_map]
        exact prodconst _ _ _ (fun a ha => by
          show W.valuation (a1 - a) = δ
          rw [Valuation.map_sub_swap]; exact hin2 a ha)
      have hvp2 : W.valuation p2 = δ ^ Multiset.card t1 := by
        rw [hp2, map_multiset_prod, Multiset.map_map]
        exact prodconst _ _ _ (fun a ha => by
          show W.valuation (b - a) = δ
          have e : b - a = (b - a1) - (a - a1) := by ring
          rw [e, Valuation.map_sub_eq_of_lt_left _ (hin1 a ha)])
      have hvp1ne : W.valuation p1 ≠ 0 := by rw [hvp1]; exact pow_ne_zero _ hδ0
      have hvp2ne : W.valuation p2 ≠ 0 := by rw [hvp2]; exact pow_ne_zero _ hδ0
      have hp1ne : p1 ≠ 0 := (Valuation.ne_zero_iff _).mp hvp1ne
      have hp2ne : p2 ≠ 0 := (Valuation.ne_zero_iff _).mp hvp2ne
      have hc1ne : c' / p1 ≠ 0 := div_ne_zero hc' hp1ne
      have hc2ne : c' / p2 ≠ 0 := div_ne_zero hc' hp2ne
      have hvc1 : W.valuation (c' / p1) * δ ^ Multiset.card t2 = W.valuation c' := by
        rw [map_div₀, ← hvp1, div_mul_cancel₀ _ hvp1ne]
      have hvc2 : W.valuation (c' / p2) * δ ^ Multiset.card t1 = W.valuation c' := by
        rw [map_div₀, ← hvp2, div_mul_cancel₀ _ hvp2ne]

      obtain ⟨k1, β1, lam1, he1, hf1, hb1, hc1', hd1⟩ :=
        ih (Multiset.card t1) (by omega) t1 (c' / p1) rfl (Multiset.card_pos.mp hc1pos) hc1ne
      obtain ⟨k2, β2, lam2, he2, hf2, hb2, hc2', hd2⟩ :=
        ih (Multiset.card t2) (by omega) t2 (c' / p2) rfl (Multiset.card_pos.mp hc2pos) hc2ne

      have hR1 : ∀ i, W.valuation (lam1 i) < δ := by
        intro i
        by_contra hge
        push_neg at hge
        have h1 : δ ^ Multiset.card t1 ≤ W.valuation (c' / p1) :=
          (pow_le_pow_left₀ zero_le hge _).trans (hf1 i).2
        have h2 : δ ^ Multiset.card t1 * δ ^ Multiset.card t2 ≤ W.valuation c' := by
          rw [← hvc1]; exact mul_le_mul' h1 le_rfl
        rw [← pow_add, hcardsum] at h2
        exact absurd (lt_of_lt_of_le hbase h2) (lt_irrefl _)
      have hR2 : ∀ j, W.valuation (lam2 j) < δ := by
        intro j
        by_contra hge
        push_neg at hge
        have h1 : δ ^ Multiset.card t2 ≤ W.valuation (c' / p2) :=
          (pow_le_pow_left₀ zero_le hge _).trans (hf2 j).2
        have h2 : δ ^ Multiset.card t2 * δ ^ Multiset.card t1 ≤ W.valuation c' := by
          rw [← hvc2]; exact mul_le_mul' h1 le_rfl
        rw [← pow_add, add_comm, hcardsum] at h2
        exact absurd (lt_of_lt_of_le hbase h2) (lt_irrefl _)
      refine ⟨k1 + k2, Fin.append β1 β2, Fin.append lam1 lam2, ?_, ?_, ?_, ?_, ?_⟩
      ·
        intro l
        induction l using Fin.addCases with
        | left i => simp only [Fin.append_left]; exact hm1 _ (he1 i)
        | right j => simp only [Fin.append_right]; exact hm2 _ (he2 j)
      ·
        intro l
        induction l using Fin.addCases with
        | left i =>
          simp only [Fin.append_left]
          refine ⟨(hf1 i).1, ?_⟩
          rw [← hcardsum, pow_add, ← hvc1]
          exact mul_le_mul' (hf1 i).2 (pow_le_pow_left₀ zero_le (hR1 i).le _)
        | right j =>
          simp only [Fin.append_right]
          refine ⟨(hf2 j).1, ?_⟩
          rw [← hcardsum, pow_add, ← hvc2, mul_comm (W.valuation (c' / p2))]
          exact mul_le_mul' (pow_le_pow_left₀ zero_le (hR2 j).le _) (hf2 j).2
      ·
        intro l l'
        induction l using Fin.addCases with
        | left i =>
          induction l' using Fin.addCases with
          | left i' =>
            intro hll'
            simp only [Fin.append_left]
            exact hb1 i i' (fun h => hll' (by rw [h]))
          | right j' =>
            intro _
            simp only [Fin.append_left, Fin.append_right]
            rw [hcross _ (he1 i) _ (he2 j')]
            exact hR1 i
        | right j =>
          induction l' using Fin.addCases with
          | left i' =>
            intro _
            simp only [Fin.append_left, Fin.append_right]
            rw [hcross' _ (he1 i') _ (he2 j)]
            exact hR2 j
          | right j' =>
            intro hll'
            simp only [Fin.append_right]
            exact hb2 j j' (fun h => hll' (by rw [h]))
      ·
        intro l
        induction l using Fin.addCases with
        | left i =>
          simp only [Fin.append_left]
          rw [hsplit, ← hvc1]
          refine mul_le_mul' (hc1' i) ?_
          apply prodle
          intro a ha
          rw [hcross _ (he1 i) _ ha]
          exact max_le le_rfl (hR1 i).le
        | right j =>
          simp only [Fin.append_right]
          rw [hsplit, ← hvc2, mul_comm (W.valuation (c' / p2))]
          refine mul_le_mul' ?_ (hc2' j)
          apply prodle
          intro a ha
          rw [hcross' _ ha _ (he2 j)]
          exact max_le le_rfl (hR2 j).le
      ·
        intro x hx
        rw [hsplit] at hx
        by_cases hxa : W.valuation (x - a1) < δ
        · have h2 : (t2.map (fun a => W.valuation (x - a))).prod = δ ^ Multiset.card t2 :=
            prodconst _ _ _ (fun a ha => by
              have e : x - a = (x - a1) - (a - a1) := by ring
              rw [e, Valuation.map_sub_eq_of_lt_right _ (by rw [hin2 a ha]; exact hxa), hin2 a ha])
          rw [h2, ← hvc1] at hx
          have h3 := (mul_le_mul_iff_of_pos_right (hδn _)).mp hx
          obtain ⟨i, hi⟩ := hd1 x h3
          exact ⟨Fin.castAdd k2 i, by simpa only [Fin.append_left] using hi⟩
        · push_neg at hxa
          have h1 : δ ^ Multiset.card t1 ≤ (t1.map (fun a => W.valuation (x - a))).prod :=
            leprod _ _ _ (fun a ha => by
              have e : x - a = (x - a1) - (a - a1) := by ring
              rw [e, Valuation.map_sub_eq_of_lt_left _ (lt_of_lt_of_le (hin1 a ha) hxa)]
              exact hxa)
          have h3 : (t2.map (fun a => W.valuation (x - a))).prod * δ ^ Multiset.card t1 ≤
              W.valuation (c' / p2) * δ ^ Multiset.card t1 := by
            rw [hvc2, mul_comm]
            exact (mul_le_mul' h1 le_rfl).trans hx
          have h4 := (mul_le_mul_iff_of_pos_right (hδn _)).mp h3
          obtain ⟨j, hj⟩ := hd2 x h4
          exact ⟨Fin.natAdd k1 j, by simpa only [Fin.append_right] using hj⟩

  obtain ⟨k, β, lam, he, hf, hb, hc', hd⟩ := core _ s c rfl hs hc
  refine ⟨k, β, lam, he, hf, hb, fun l j => (hcoef s (β l) (lam l) j).trans (hc' l), ?_⟩
  intro x hx
  rw [map_multiset_prod, Multiset.map_map] at hx
  exact hd x hx

theorem wcpa_dj_lr1k_odfgl_ln_poly_values : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (g : Polynomial Ω),
    (∀ y₀ : Ω, W.valuation y₀ ≤ 1 → W.valuation (g.eval y₀) ≤ 1) →
    ∀ i, W.valuation (g.coeff i) ≤ 1 :=
by
  intro Ω _ _ W g hg i
  classical

  have hinf : Infinite (IsLocalRing.ResidueField W) := by
    by_contra hfin
    rw [not_infinite_iff_finite] at hfin
    letI := Fintype.ofFinite (IsLocalRing.ResidueField W)
    have hq2 : 1 < Fintype.card (IsLocalRing.ResidueField W) := Fintype.one_lt_card
    set q := Fintype.card (IsLocalRing.ResidueField W) with hq
    set T : Polynomial Ω := Polynomial.X ^ q - (Polynomial.X + Polynomial.C 1) with hT
    have hTnat : T.natDegree = q := by
      rw [hT, Polynomial.natDegree_sub_eq_left_of_natDegree_lt] <;>
        rw [Polynomial.natDegree_X_pow]
      rw [Polynomial.natDegree_X_add_C]
      exact hq2
    have hTdeg : T.degree ≠ 0 := by
      have h0 : 0 < T.natDegree := by omega
      exact ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp h0)
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_root T hTdeg
    have hz' : z ^ q = z + 1 := by
      have := hz
      rw [Polynomial.IsRoot.def, hT] at this
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_add,
        Polynomial.eval_C] at this
      exact sub_eq_zero.mp this
    have hzv : W.valuation z ≤ 1 := by
      by_contra hzv
      rw [not_le] at hzv
      have h1 : W.valuation z ^ 1 < W.valuation z ^ q := pow_lt_pow_right₀ hzv hq2
      rw [pow_one, ← map_pow, hz'] at h1
      have h2 : W.valuation (z + 1) ≤ max (W.valuation z) (W.valuation 1) :=
        Valuation.map_add _ _ _
      rw [map_one, max_eq_left hzv.le] at h2
      exact absurd (lt_of_lt_of_le h1 h2) (lt_irrefl _)
    set zW : W := ⟨z, (W.valuation_le_one_iff z).mp hzv⟩ with hzW
    have hzW' : zW ^ q = zW + 1 := by
      apply Subtype.ext
      simp only [hzW, SubmonoidClass.coe_pow, AddMemClass.coe_add, OneMemClass.coe_one]
      exact hz'
    have h1 : (IsLocalRing.residue W zW) ^ q = IsLocalRing.residue W zW + 1 := by
      rw [← map_pow, hzW', map_add, map_one]
    have h2 : (IsLocalRing.residue W zW) ^ q = IsLocalRing.residue W zW :=
      FiniteField.pow_card _
    have h3 : (1 : IsLocalRing.ResidueField W) = 0 := by linear_combination h2 - h1
    exact one_ne_zero h3

  by_contra hi
  rw [not_le] at hi
  have hci : g.coeff i ≠ 0 := by
    intro h
    rw [h, map_zero] at hi
    exact absurd hi (not_lt.mpr zero_le')
  have hne : g.support.Nonempty := ⟨i, Polynomial.mem_support_iff.mpr hci⟩
  obtain ⟨i₀, hi₀, hmax⟩ := Finset.exists_max_image g.support (fun j => W.valuation (g.coeff j)) hne
  set a := g.coeff i₀ with ha_def
  have hA1 : ∀ j, W.valuation (g.coeff j) ≤ W.valuation a := by
    intro j
    by_cases hj : j ∈ g.support
    · exact hmax j hj
    · rw [Polynomial.notMem_support_iff.mp hj, map_zero]
      exact zero_le'
  have hva : 1 < W.valuation a := lt_of_lt_of_le hi (hA1 i)
  have hva0 : W.valuation a ≠ 0 := ne_of_gt (lt_trans zero_lt_one hva)
  have ha : a ≠ 0 := fun h => hva0 (by rw [h, map_zero])

  set h : Polynomial Ω := Polynomial.C a⁻¹ * g with hh
  have hcoeff : ∀ j, W.valuation (h.coeff j) ≤ 1 := by
    intro j
    rw [hh, Polynomial.coeff_C_mul, map_mul, map_inv₀]
    calc (W.valuation a)⁻¹ * W.valuation (g.coeff j)
        ≤ (W.valuation a)⁻¹ * W.valuation a := by gcongr; exact hA1 j
      _ = 1 := inv_mul_cancel₀ hva0
  have hlift : h ∈ Polynomial.lifts (algebraMap W Ω) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    exact ⟨⟨h.coeff n, (W.valuation_le_one_iff _).mp (hcoeff n)⟩, rfl⟩
  obtain ⟨hW, hWmap⟩ := (Polynomial.mem_lifts h).mp hlift
  have hWi₀ : hW.coeff i₀ = 1 := by
    apply Subtype.ext
    have := congrArg (fun p => Polynomial.coeff p i₀) hWmap
    simp only [Polynomial.coeff_map] at this
    rw [OneMemClass.coe_one]
    rw [ValuationSubring.algebraMap_apply] at this
    rw [this, hh, Polynomial.coeff_C_mul, ← ha_def]
    exact inv_mul_cancel₀ ha

  set hbar := hW.map (IsLocalRing.residue W) with hhbar
  have hbar0 : hbar ≠ 0 := by
    intro h0
    have := congrArg (fun p => Polynomial.coeff p i₀) h0
    simp only [hhbar, Polynomial.coeff_map, hWi₀, map_one, Polynomial.coeff_zero] at this
    exact one_ne_zero this
  obtain ⟨r, hr⟩ : ∃ r, hbar.eval r ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hbar0 (Polynomial.zero_of_eval_zero _ hcon)
  obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective r

  have hres : hbar.eval (IsLocalRing.residue W w) = IsLocalRing.residue W (hW.eval w) := by
    rw [hhbar, Polynomial.eval_map, Polynomial.eval₂_at_apply]
  have hunit : IsUnit (hW.eval w) := by
    by_contra hnu
    apply hr
    rw [hres, IsLocalRing.residue_eq_zero_iff]
    exact hnu
  have hv1 : W.valuation ((hW.eval w : W) : Ω) = 1 := (W.valuation_eq_one_iff _).mp hunit

  have htr : ((hW.eval w : W) : Ω) = a⁻¹ * g.eval (w : Ω) := by
    have e1 : ((hW.eval w : W) : Ω) = algebraMap W Ω (hW.eval w) := rfl
    have e2 : (w : Ω) = algebraMap W Ω w := rfl
    rw [e1, e2, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hWmap, hh,
      Polynomial.eval_mul, Polynomial.eval_C]
  rw [htr, map_mul, map_inv₀, inv_mul_eq_one₀ hva0] at hv1
  have hgw := hg (w : Ω) (W.valuation_le_one w)
  rw [← hv1] at hgw
  exact absurd (lt_of_lt_of_le hva hgw) (lt_irrefl _)

theorem wcpa_dj_lr1k_odfgl_ln_bounded_integral : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω),
    (∀ g : Polynomial Ω, (∀ y₀ : Ω, W.valuation y₀ ≤ 1 → W.valuation (g.eval y₀) ≤ 1) →
      ∀ i, W.valuation (g.coeff i) ≤ 1) →
    ∀ c : Ω, c ≠ 0 → ∀ P : Polynomial Ω, P.Monic → 1 ≤ P.natDegree →
    ∀ f : Polynomial Ω,
      (∀ x : Ω, W.valuation (P.eval x) ≤ W.valuation c → W.valuation (f.eval x) ≤ 1) →
    ∃ p : Polynomial (Polynomial Ω), p.Monic ∧
      (∀ i, p.coeff i ∈ Algebra.adjoin ↥W {Polynomial.C c⁻¹ * P}) ∧ p.eval f = 0 :=
by
  intro Ω _ _ W hval c hc P hP hPd f hf
  classical

  have s3 : ∀ (q : Polynomial Ω), q.Monic → (∀ z : Ω, q.IsRoot z → W.valuation z ≤ 1) →
      ∀ i, W.valuation (q.coeff i) ≤ 1 := by
    intro q hq hr i
    rw [W.valuation_le_one_iff]
    by_cases hi : q.natDegree < i
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi]; exact W.zero_mem
    push_neg at hi
    rw [Polynomial.coeff_eq_esymm_roots_of_card (IsAlgClosed.card_roots_eq_natDegree) hi,
      hq.leadingCoeff, one_mul]
    refine W.mul_mem _ _ (W.pow_mem (W.neg_mem _ W.one_mem) _) ?_
    unfold Multiset.esymm
    refine multiset_sum_mem _ (fun t ht => ?_)
    obtain ⟨s, hs, rfl⟩ := Multiset.mem_map.mp ht
    refine multiset_prod_mem _ (fun a ha => ?_)
    have hsle := (Multiset.mem_powersetCard.mp hs).1
    have haR : a ∈ q.roots := Multiset.mem_of_le hsle ha
    exact (W.valuation_le_one_iff a).mp (hr a ((Polynomial.mem_roots hq.ne_zero).mp haR))

  have s1 : ∀ (FF gg : Polynomial (Polynomial Ω)), FF.Monic →
      ∃ M : Matrix (Fin FF.natDegree) (Fin FF.natDegree) (Polynomial Ω),
        (∀ j : Fin FF.natDegree, FF ∣ gg * Polynomial.X ^ (j : ℕ) -
          ∑ i : Fin FF.natDegree, Polynomial.C (M i j) * Polynomial.X ^ (i : ℕ)) ∧
        FF ∣ Polynomial.aeval gg M.charpoly := by
    intro FF gg hF
    let pb := AdjoinRoot.powerBasis' hF
    have hb : ∀ i : Fin FF.natDegree, pb.basis i = AdjoinRoot.root FF ^ (i : ℕ) := by
      intro i
      rw [PowerBasis.coe_basis]
      rfl
    have hmk : ∀ (r : Polynomial Ω) (k : ℕ),
        AdjoinRoot.mk FF (Polynomial.C r * Polynomial.X ^ k) = r • AdjoinRoot.root FF ^ k := by
      intro r k
      rw [map_mul, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, Algebra.smul_def,
        AdjoinRoot.algebraMap_eq]
    let M : Matrix (Fin FF.natDegree) (Fin FF.natDegree) (Polynomial Ω) :=
      Algebra.leftMulMatrix pb.basis (AdjoinRoot.mk FF gg)
    refine ⟨M, ?_, ?_⟩
    · intro j
      rw [← AdjoinRoot.mk_eq_zero, map_sub, sub_eq_zero, map_mul, map_pow, AdjoinRoot.mk_X,
        map_sum]
      simp only [hmk]
      have hsum : ∑ i : Fin FF.natDegree, pb.basis.repr (AdjoinRoot.mk FF gg * pb.basis j) i •
          pb.basis i = AdjoinRoot.mk FF gg * pb.basis j := pb.basis.sum_repr _
      simp only [hb] at hsum
      rw [← hsum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      congr 1
      have hM := Algebra.leftMulMatrix_eq_repr_mul pb.basis (AdjoinRoot.mk FF gg) i j
      rw [hb j] at hM
      exact hM.symm
    · rw [← AdjoinRoot.mk_eq_zero]
      have h1 : Polynomial.aeval (AdjoinRoot.mk FF gg) M.charpoly = 0 := by
        apply Algebra.leftMulMatrix_injective pb.basis
        rw [map_zero, ← Polynomial.aeval_algHom_apply]
        exact Matrix.aeval_self_charpoly M
      have h2 : AdjoinRoot.mk FF (Polynomial.aeval gg M.charpoly) =
          Polynomial.aeval (AdjoinRoot.mk FF gg) M.charpoly := by
        rw [show AdjoinRoot.mk FF gg = AdjoinRoot.mkₐ FF gg from rfl,
          Polynomial.aeval_algHom_apply]
        rfl
      rw [h2, h1]

  have s2 : ∀ (φ : Polynomial Ω →+* Ω) (n : ℕ) (FF gg : Polynomial (Polynomial Ω))
      (M : Matrix (Fin n) (Fin n) (Polynomial Ω)), FF.Monic → FF.natDegree = n →
      (∀ j : Fin n, FF ∣ gg * Polynomial.X ^ (j : ℕ) -
        ∑ i : Fin n, Polynomial.C (M i j) * Polynomial.X ^ (i : ℕ)) →
      ∀ z : Ω, (M.charpoly.map φ).IsRoot z →
      ∃ x : Ω, (FF.map φ).eval x = 0 ∧ (gg.map φ).eval x = z := by
    intro φ n FF gg M hF hn hrel z hz
    set F₀ := FF.map φ with hF₀def
    set g₀ := gg.map φ with hg₀def
    set N := M.map φ with hNdef
    have hF₀ : F₀.Monic := hF.map φ
    have hF₀d : F₀.natDegree = n := by rw [hF₀def, hF.natDegree_map]; exact hn
    have hrel0 : ∀ j : Fin n, F₀ ∣ g₀ * Polynomial.X ^ (j : ℕ) -
        ∑ i : Fin n, Polynomial.C (N i j) * Polynomial.X ^ (i : ℕ) := by
      intro j
      have := Polynomial.map_dvd φ (hrel j)
      simpa [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_sum,
        hNdef] using this
    have hz' : N.charpoly.IsRoot z := by rw [hNdef, Matrix.charpoly_map]; exact hz
    have hdet : (Matrix.scalar (Fin n) z - N).det = 0 := by
      rw [← Matrix.eval_charpoly]; exact hz'
    obtain ⟨w, hw0, hw⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hE : ∀ i, (N.mulVec w) i = z * w i := by
      intro i
      have := congrFun hw i
      rw [Matrix.sub_mulVec, Pi.sub_apply, Matrix.scalar_apply, Matrix.mulVec_diagonal,
        Pi.zero_apply, sub_eq_zero] at this
      exact this.symm
    set h : Polynomial Ω := ∑ j : Fin n, Polynomial.C (w j) * Polynomial.X ^ (j : ℕ) with hhdef
    have hcoeff : ∀ i : Fin n, h.coeff i = w i := by
      intro i
      rw [hhdef, Polynomial.finset_sum_coeff]
      rw [Finset.sum_eq_single i]
      · rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl]
      · intro j _ hji
        rw [Polynomial.coeff_C_mul_X_pow, if_neg]
        intro hc'
        exact hji (Fin.ext hc'.symm)
      · intro hi; exact absurd (Finset.mem_univ i) hi
    have hh0 : h ≠ 0 := by
      intro h0
      apply hw0
      funext i
      rw [← hcoeff i, h0, Polynomial.coeff_zero, Pi.zero_apply]
    have hhdeg : h.degree < n := Polynomial.degree_sum_fin_lt _
    have e1 : ∑ j : Fin n, Polynomial.C (w j) *
          ∑ i : Fin n, Polynomial.C (N i j) * Polynomial.X ^ (i : ℕ) =
        ∑ i : Fin n, Polynomial.C z * (Polynomial.C (w i) * Polynomial.X ^ (i : ℕ)) := by
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← mul_assoc, ← Polynomial.C_mul, ← hE i, Matrix.mulVec, dotProduct, map_sum,
        Finset.sum_mul]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Polynomial.C_mul]; ring
    have key : h * (g₀ - Polynomial.C z) =
        ∑ j : Fin n, Polynomial.C (w j) * (g₀ * Polynomial.X ^ (j : ℕ) -
          ∑ i : Fin n, Polynomial.C (N i j) * Polynomial.X ^ (i : ℕ)) := by
      simp only [mul_sub, Finset.sum_sub_distrib]
      rw [e1]
      have e2 : ∑ j : Fin n, Polynomial.C (w j) * (g₀ * Polynomial.X ^ (j : ℕ)) = h * g₀ := by
        rw [hhdef, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      have e3 : ∑ i : Fin n, Polynomial.C z * (Polynomial.C (w i) * Polynomial.X ^ (i : ℕ)) =
          h * Polynomial.C z := by
        rw [← Finset.mul_sum, ← hhdef, mul_comm]
      rw [e2, e3]
    have hdvd : F₀ ∣ h * (g₀ - Polynomial.C z) := by
      rw [key]
      exact Finset.dvd_sum (fun j _ => Dvd.dvd.mul_left (hrel0 j) _)
    have hncop : ¬ IsCoprime F₀ (g₀ - Polynomial.C z) := by
      intro hcop
      have := hcop.dvd_of_dvd_mul_right hdvd
      apply hh0
      apply Polynomial.eq_zero_of_dvd_of_degree_lt this
      rw [Polynomial.degree_eq_natDegree hF₀.ne_zero, hF₀d]
      exact hhdeg
    rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed Ω Ω] at hncop
    push_neg at hncop
    obtain ⟨x, hx1, hx2⟩ := hncop
    rw [Polynomial.coe_aeval_eq_eval] at hx1 hx2
    refine ⟨x, hx1, ?_⟩
    rw [Polynomial.eval_sub, Polynomial.eval_C, sub_eq_zero] at hx2
    exact hx2

  have s4 : ∀ (χ : Polynomial (Polynomial Ω)), χ.Monic →
      (∀ i j, W.valuation ((χ.coeff i).coeff j) ≤ 1) →
      (P.map Polynomial.C - Polynomial.C (Polynomial.C c * Polynomial.X)) ∣
        Polynomial.aeval (f.map Polynomial.C) χ →
      ∃ p : Polynomial (Polynomial Ω), p.Monic ∧
        (∀ i, p.coeff i ∈ Algebra.adjoin ↥W {Polynomial.C c⁻¹ * P}) ∧ p.eval f = 0 := by
    intro χ hχ hco hdvd
    set y : Polynomial Ω := Polynomial.C c⁻¹ * P with hy
    let ρ : Polynomial Ω →+* Polynomial Ω :=
      (Polynomial.aeval y : Polynomial Ω →ₐ[Ω] Polynomial Ω)
    have hρC : ∀ a : Ω, ρ (Polynomial.C a) = Polynomial.C a := fun a => by
      simp [ρ]
    have hρX : ρ Polynomial.X = y := by simp [ρ]
    refine ⟨χ.map ρ, hχ.map _, ?_, ?_⟩
    · intro i
      rw [Polynomial.coeff_map]
      set a := χ.coeff i with ha
      have e : ρ a = ∑ j ∈ Finset.range (a.natDegree + 1),
          Polynomial.C (a.coeff j) * y ^ j := by
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow a]
        rw [map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, map_pow, hρC, hρX]
      rw [e]
      refine Subalgebra.sum_mem _ (fun j _ => Subalgebra.mul_mem _ ?_
        (Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton _)) _))
      have hm : a.coeff j ∈ W := (W.valuation_le_one_iff _).mp (hco i j)
      have e2 : Polynomial.C (a.coeff j) = algebraMap ↥W (Polynomial Ω) ⟨a.coeff j, hm⟩ := by
        rw [Polynomial.algebraMap_apply]; rfl
      rw [e2]
      exact Subalgebra.algebraMap_mem _ _
    · let θ : Polynomial (Polynomial Ω) →+* Polynomial Ω :=
        Polynomial.eval₂RingHom ρ Polynomial.X
      have hθf : θ (f.map Polynomial.C) = f := by
        simp only [θ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map]
        have : ρ.comp Polynomial.C = Polynomial.C := RingHom.ext hρC
        rw [this, Polynomial.eval₂_C_X]
      have hθF : θ (P.map Polynomial.C - Polynomial.C (Polynomial.C c * Polynomial.X)) = 0 := by
        have hθP : θ (P.map Polynomial.C) = P := by
          simp only [θ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map]
          have : ρ.comp Polynomial.C = Polynomial.C := RingHom.ext hρC
          rw [this, Polynomial.eval₂_C_X]
        have hθc : θ (Polynomial.C (Polynomial.C c * Polynomial.X)) = P := by
          simp only [θ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          rw [map_mul, hρC, hρX, hy, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hc,
            Polynomial.C_1, one_mul]
        rw [map_sub, hθP, hθc, sub_self]
      obtain ⟨G, hG⟩ := hdvd
      have h1 : θ (Polynomial.aeval (f.map Polynomial.C) χ) = (χ.map ρ).eval f := by
        rw [Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.eval_map, hθf]
        congr 1
        refine RingHom.ext fun a => ?_
        rw [RingHom.comp_apply, Polynomial.algebraMap_apply, Algebra.algebraMap_self,
          RingHom.id_apply]
        simp only [θ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rw [← h1, hG, map_mul, hθF, zero_mul]

  set F : Polynomial (Polynomial Ω) :=
    P.map Polynomial.C - Polynomial.C (Polynomial.C c * Polynomial.X) with hFdef
  have hPC : (P.map (Polynomial.C : Ω →+* Polynomial Ω)).Monic := hP.map _
  have hPCd : (P.map (Polynomial.C : Ω →+* Polynomial Ω)).natDegree = P.natDegree :=
    hP.natDegree_map _
  have hFm : F.Monic := by
    apply hPC.sub_of_left
    refine lt_of_le_of_lt Polynomial.degree_C_le ?_
    rw [Polynomial.degree_eq_natDegree hPC.ne_zero, hPCd]
    exact_mod_cast (show 0 < P.natDegree by omega)
  obtain ⟨M, hrel, hdvd⟩ := s1 F (f.map Polynomial.C) hFm
  have hχ : M.charpoly.Monic := Matrix.charpoly_monic M
  have hco : ∀ i j, W.valuation ((M.charpoly.coeff i).coeff j) ≤ 1 := by
    intro i
    apply hval
    intro y₀ hy₀
    let φ : Polynomial Ω →+* Ω := Polynomial.evalRingHom y₀
    have hφC : φ.comp Polynomial.C = RingHom.id Ω := by
      ext a
      simp [φ]
    have hroots : ∀ z : Ω, (M.charpoly.map φ).IsRoot z → W.valuation z ≤ 1 := by
      intro z hz
      obtain ⟨x, hx1, hx2⟩ :=
        s2 φ F.natDegree F (f.map Polynomial.C) M hFm rfl hrel z hz
      rw [Polynomial.map_map, hφC, Polynomial.map_id] at hx2
      have hFφ : F.map φ = P - Polynomial.C (c * y₀) := by
        rw [hFdef, Polynomial.map_sub, Polynomial.map_map, hφC, Polynomial.map_id,
          Polynomial.map_C]
        simp [φ]
      rw [hFφ, Polynomial.eval_sub, Polynomial.eval_C, sub_eq_zero] at hx1
      rw [← hx2]
      apply hf
      rw [hx1, map_mul]
      exact mul_le_of_le_one_right' hy₀
    have := s3 (M.charpoly.map φ) (hχ.map φ) hroots i
    simpa [φ, Polynomial.coeff_map] using this
  exact s4 M.charpoly hχ hco hdvd

theorem wcpa_dj_lr1k_odfgl_ln_integral_coeffs : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (S : Set (Polynomial Ω)) (q : Polynomial Ω),
    (∀ a ∈ S, ∀ j, (a.comp q).coeff j ∈ W) →
    ∀ f : Polynomial Ω, (∃ p : Polynomial (Polynomial Ω), p.Monic ∧
      (∀ i, p.coeff i ∈ Algebra.adjoin ↥W S) ∧ p.eval f = 0) →
    ∀ j, (f.comp q).coeff j ∈ W :=
by
  intro Ω _ W S q hS f hp
  obtain ⟨p, hpm, hpc, hpe⟩ := hp
  classical

  have s1 : ∀ c ∈ Algebra.adjoin ↥W S, ∀ j, (c.comp q).coeff j ∈ W := by
    intro c hc
    induction hc using Algebra.adjoin_induction with
    | mem x hx => exact hS x hx
    | algebraMap r =>
      intro j
      rw [Polynomial.algebraMap_apply, Polynomial.C_comp, Polynomial.coeff_C]
      split_ifs
      · exact r.2
      · exact W.zero_mem
    | add x y _ _ hx hy =>
      intro j
      rw [Polynomial.add_comp, Polynomial.coeff_add]
      exact add_mem (hx j) (hy j)
    | mul x y _ _ hx hy =>
      intro j
      rw [Polynomial.mul_comp, Polynomial.coeff_mul]
      exact sum_mem (fun k _ => mul_mem (hx k.1) (hy k.2))

  have s2 : ∀ (g : Polynomial Ω) (P : Polynomial (Polynomial Ω)), P.Monic →
      (∀ i j, (P.coeff i).coeff j ∈ W) → P.eval g = 0 → ∀ j, g.coeff j ∈ W := by
    intro g P hPm hPc hPe j
    letI : Algebra (Polynomial ↥W) (Polynomial Ω) := Polynomial.algebra ↥W Ω
    have hlift : P ∈ Polynomial.lifts (algebraMap (Polynomial ↥W) (Polynomial Ω)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      have h1 : P.coeff i ∈ Polynomial.lifts (algebraMap ↥W Ω) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro k
        exact ⟨⟨_, hPc i k⟩, rfl⟩
      obtain ⟨r, hr⟩ := (Polynomial.mem_lifts _).mp h1
      exact ⟨r, by rw [Polynomial.algebraMap_def, Polynomial.coe_mapRingHom]; exact hr⟩
    obtain ⟨P', hP'map, _, hP'm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hPm
    have hint : IsIntegral (Polynomial ↥W) g := by
      refine ⟨P', hP'm, ?_⟩
      rw [Polynomial.eval₂_eq_eval_map, hP'map]
      exact hPe
    have hc : IsIntegral ↥W (g.coeff j) :=
      (Polynomial.isIntegral_iff_isIntegral_coeff.mp hint) j
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := Ω)).mp hc
    rw [← hy]
    exact y.2

  set φ : Polynomial Ω →+* Polynomial Ω := Polynomial.compRingHom q with hφ
  have hφapp : ∀ r : Polynomial Ω, φ r = r.comp q := fun r => rfl
  apply s2 (f.comp q) (p.map φ) (hpm.map φ)
  · intro i j
    rw [Polynomial.coeff_map, hφapp]
    exact s1 _ (hpc i) j
  · rw [Polynomial.eval_map, ← hφapp, Polynomial.eval₂_at_apply, hpe, map_zero]

theorem wcpa_dj_lr1k_odfgl_ln_separation : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω),
    (∀ F H : Polynomial Ω, (∀ j, W.valuation (F.coeff j) < 1) →
      ∃ N : ℕ, ∀ j, W.valuation ((F ^ N * H).coeff j) ≤ 1) →
    ∀ (k : ℕ) (β lam : Fin k → Ω),
    (∀ i j, i ≠ j → W.valuation (lam i) < W.valuation (β i - β j)) →
    ∀ l, ∃ E : Polynomial Ω, ∀ i j,
      W.valuation ((E.comp (Polynomial.C (β i) + Polynomial.C (lam i) * Polynomial.X)).coeff j)
        ≤ 1 ∧
      W.valuation ((E.comp (Polynomial.C (β i) + Polynomial.C (lam i) * Polynomial.X) -
        (if i = l then 1 else 0)).coeff j) < 1 :=
by
  intro Ω _ W harch k β lam hsep l
  classical

  have hz : ∀ x : Ω, 0 ≤ W.valuation x := fun x => zero_le'
  have hSI : ∀ p : Polynomial Ω, (∀ j, W.valuation (p.coeff j) < 1) →
      ∀ j, W.valuation (p.coeff j) ≤ 1 := fun p h j => le_of_lt (h j)
  have hint1 : ∀ j, W.valuation ((1 : Polynomial Ω).coeff j) ≤ 1 := by
    intro j
    rw [Polynomial.coeff_one]
    split_ifs
    · rw [map_one]
    · rw [map_zero]; exact zero_le'
  have hmulI : ∀ p r : Polynomial Ω, (∀ j, W.valuation (p.coeff j) ≤ 1) →
      (∀ j, W.valuation (r.coeff j) ≤ 1) → ∀ j, W.valuation ((p * r).coeff j) ≤ 1 := by
    intro p r hp hr j
    rw [Polynomial.coeff_mul]
    apply Valuation.map_sum_le
    intro x _
    rw [map_mul]
    exact mul_le_one' (hp _) (hr _)
  have hmulS : ∀ p r : Polynomial Ω, (∀ j, W.valuation (p.coeff j) < 1) →
      (∀ j, W.valuation (r.coeff j) ≤ 1) → ∀ j, W.valuation ((p * r).coeff j) < 1 := by
    intro p r hp hr j
    rw [Polynomial.coeff_mul]
    apply Valuation.map_sum_lt _ one_ne_zero
    intro x _
    rw [map_mul]
    exact mul_lt_one_of_lt_of_le (hp _) (hr _)
  have haddI : ∀ p r : Polynomial Ω, (∀ j, W.valuation (p.coeff j) ≤ 1) →
      (∀ j, W.valuation (r.coeff j) ≤ 1) → ∀ j, W.valuation ((p + r).coeff j) ≤ 1 := by
    intro p r hp hr j
    rw [Polynomial.coeff_add]
    exact Valuation.map_add_le _ (hp j) (hr j)
  have haddS : ∀ p r : Polynomial Ω, (∀ j, W.valuation (p.coeff j) < 1) →
      (∀ j, W.valuation (r.coeff j) < 1) → ∀ j, W.valuation ((p + r).coeff j) < 1 := by
    intro p r hp hr j
    rw [Polynomial.coeff_add]
    exact Valuation.map_add_lt _ (hp j) (hr j)
  have hIofS : ∀ p d : Polynomial Ω, (∀ j, W.valuation ((p - d).coeff j) < 1) →
      (∀ j, W.valuation (d.coeff j) ≤ 1) → ∀ j, W.valuation (p.coeff j) ≤ 1 := by
    intro p d h hd j
    have e : p = (p - d) + d := by ring
    rw [e]
    exact haddI _ _ (hSI _ h) hd j
  have hmulOne : ∀ p r : Polynomial Ω, (∀ j, W.valuation ((p - 1).coeff j) < 1) →
      (∀ j, W.valuation ((r - 1).coeff j) < 1) → ∀ j, W.valuation ((p * r - 1).coeff j) < 1 := by
    intro p r hp hr
    have e : p * r - 1 = (p - 1) * r + (r - 1) := by ring
    rw [e]
    exact haddS _ _ (hmulS _ _ hp (hIofS _ _ hr hint1)) hr
  have hpowI : ∀ (p : Polynomial Ω) (n : ℕ), (∀ j, W.valuation (p.coeff j) ≤ 1) →
      ∀ j, W.valuation ((p ^ n).coeff j) ≤ 1 := by
    intro p n hp
    induction n with
    | zero => rw [pow_zero]; exact hint1
    | succ n ih => rw [pow_succ]; exact hmulI _ _ ih hp
  have hpowOne : ∀ (p : Polynomial Ω) (n : ℕ), (∀ j, W.valuation ((p - 1).coeff j) < 1) →
      ∀ j, W.valuation ((p ^ n - 1).coeff j) < 1 := by
    intro p n hp
    induction n with
    | zero =>
      intro j
      rw [pow_zero, sub_self, Polynomial.coeff_zero, map_zero]
      exact zero_lt_one
    | succ n ih => rw [pow_succ]; exact hmulOne _ _ ih hp
  have hlinI : ∀ a d : Ω, W.valuation a ≤ 1 → W.valuation d ≤ 1 →
      ∀ j, W.valuation ((Polynomial.C a + Polynomial.C d * Polynomial.X).coeff j) ≤ 1 := by
    intro a d ha hd j
    rw [Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul_X]
    apply Valuation.map_add_le
    · split_ifs
      · exact ha
      · rw [map_zero]; exact zero_le'
    · split_ifs
      · exact hd
      · rw [map_zero]; exact zero_le'
  have hlinS : ∀ a d : Ω, W.valuation a < 1 → W.valuation d < 1 →
      ∀ j, W.valuation ((Polynomial.C a + Polynomial.C d * Polynomial.X).coeff j) < 1 := by
    intro a d ha hd j
    rw [Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul_X]
    apply Valuation.map_add_lt
    · split_ifs
      · exact ha
      · rw [map_zero]; exact zero_lt_one
    · split_ifs
      · exact hd
      · rw [map_zero]; exact zero_lt_one
  have hcomp : ∀ c b x0 y0 : Ω, (Polynomial.C c * (Polynomial.C b - Polynomial.X)).comp
      (Polynomial.C x0 + Polynomial.C y0 * Polynomial.X) =
      Polynomial.C (c * (b - x0)) + Polynomial.C (-(c * y0)) * Polynomial.X := by
    intro c b x0 y0
    simp only [Polynomial.mul_comp, Polynomial.sub_comp, Polynomial.C_comp, Polynomial.X_comp,
      map_mul, map_sub, map_neg]
    ring
  have hCsub1 : ∀ x y : Ω, Polynomial.C x + Polynomial.C y * Polynomial.X - 1 =
      Polynomial.C (x - 1) + Polynomial.C y * Polynomial.X := by
    intro x y
    rw [map_sub, map_one]
    ring
  have hvdiv : ∀ D a : Ω, 0 < W.valuation D → W.valuation a < W.valuation D →
      W.valuation (D⁻¹ * a) < 1 := by
    intro D a hD ha
    rw [map_mul, map_inv₀, inv_mul_lt_one₀ hD]
    exact ha
  have hvdivle : ∀ D a : Ω, 0 < W.valuation D → W.valuation a ≤ W.valuation D →
      W.valuation (D⁻¹ * a) ≤ 1 := by
    intro D a hD ha
    rw [map_mul, map_inv₀, inv_mul_le_one₀ hD]
    exact ha

  obtain ⟨q, hq⟩ : ∃ q : Fin k → Polynomial Ω,
      ∀ i, q i = Polynomial.C (β i) + Polynomial.C (lam i) * Polynomial.X := ⟨_, fun _ => rfl⟩
  obtain ⟨δ, hδ⟩ : ∃ δ : Fin k → Polynomial Ω,
      ∀ i, δ i = if i = l then 1 else 0 := ⟨_, fun _ => rfl⟩
  have hδI : ∀ i j, W.valuation ((δ i).coeff j) ≤ 1 := by
    intro i j
    rw [hδ]
    split_ifs
    · exact hint1 j
    · rw [Polynomial.coeff_zero, map_zero]; exact zero_le'

  have key : ∀ I : Finset (Fin k), l ∈ I → ∃ E : Polynomial Ω, ∀ i ∈ I, ∀ j,
      W.valuation ((E.comp (q i) - δ i).coeff j) < 1 := by
    intro I
    induction I using Finset.strongInduction with
    | H I ih =>
    intro hlI
    by_cases hcard : I.card ≤ 1
    · refine ⟨1, ?_⟩
      intro i hi j
      have hil : i = l := Finset.card_le_one.mp hcard i hi l hlI
      rw [hδ, if_pos hil, Polynomial.one_comp, sub_self, Polynomial.coeff_zero, map_zero]
      exact zero_lt_one
    push_neg at hcard
    obtain ⟨a, b, ha, hb, hab⟩ := Finset.one_lt_card_iff.mp hcard
    have hne : I.offDiag.Nonempty := ⟨(a, b), Finset.mem_offDiag.mpr ⟨ha, hb, hab⟩⟩
    obtain ⟨p0, hp0, hmax⟩ :=
      Finset.exists_max_image I.offDiag (fun p => W.valuation (β p.1 - β p.2)) hne
    obtain ⟨M, hM⟩ : ∃ M, M = W.valuation (β p0.1 - β p0.2) := ⟨_, rfl⟩
    have hstar : ∀ x ∈ I, ∀ y ∈ I, W.valuation (β x - β y) ≤ M := by
      intro x hx y hy
      by_cases hxy : x = y
      · rw [hxy, sub_self, map_zero]; exact zero_le'
      · rw [hM]; exact hmax (x, y) (Finset.mem_offDiag.mpr ⟨hx, hy, hxy⟩)
    have hlamM : ∀ i ∈ I, W.valuation (lam i) < M := by
      intro i hi
      by_cases hia : i = a
      · exact lt_of_lt_of_le (hsep i b (by rw [hia]; exact hab)) (hstar i hi b hb)
      · exact lt_of_lt_of_le (hsep i a hia) (hstar i hi a ha)
    have hMpos : 0 < M := lt_of_le_of_lt (hz _) (hlamM a ha)
    obtain ⟨G, hG⟩ : ∃ G : Finset (Fin k),
        G = I.filter (fun i => W.valuation (β i - β l) < M) := ⟨_, rfl⟩
    have hmemG : ∀ i, i ∈ G ↔ i ∈ I ∧ W.valuation (β i - β l) < M := by
      intro i; rw [hG, Finset.mem_filter]
    have hlG : l ∈ G := (hmemG l).mpr ⟨hlI, by rw [sub_self, map_zero]; exact hMpos⟩
    have hGsub : G ⊂ I := by
      rw [Finset.ssubset_iff_subset_ne]
      refine ⟨fun i hi => ((hmemG i).mp hi).1, ?_⟩
      intro hGI
      obtain ⟨h1, h2, _⟩ := Finset.mem_offDiag.mp hp0
      have e1 : W.valuation (β p0.1 - β l) < M := ((hmemG _).mp (hGI ▸ h1)).2
      have e2 : W.valuation (β p0.2 - β l) < M := ((hmemG _).mp (hGI ▸ h2)).2
      have e3 := Valuation.map_sub W.valuation (β p0.1 - β l) (β p0.2 - β l)
      rw [sub_sub_sub_cancel_right, ← hM] at e3
      exact lt_irrefl M (lt_of_le_of_lt e3 (max_lt e1 e2))
    have hjD : ∀ j ∈ I \ G, M ≤ W.valuation (β j - β l) := by
      intro j hj
      obtain ⟨hjI, hjG⟩ := Finset.mem_sdiff.mp hj
      by_contra hcon
      push_neg at hcon
      exact hjG ((hmemG j).mpr ⟨hjI, hcon⟩)
    have hDpos : ∀ j ∈ I \ G, 0 < W.valuation (β j - β l) :=
      fun j hj => lt_of_lt_of_le hMpos (hjD j hj)
    have hDne : ∀ j ∈ I \ G, β j - β l ≠ 0 := by
      intro j hj h
      have := hDpos j hj
      rw [h, map_zero] at this
      exact lt_irrefl _ this

    obtain ⟨F, hF⟩ : ∃ F : Polynomial Ω, F = ∏ j ∈ I \ G,
        Polynomial.C ((β j - β l)⁻¹) * (Polynomial.C (β j) - Polynomial.X) := ⟨_, rfl⟩
    have hFcomp : ∀ i, F.comp (q i) = ∏ j ∈ I \ G,
        (Polynomial.C ((β j - β l)⁻¹ * (β j - β i)) +
          Polynomial.C (-((β j - β l)⁻¹ * lam i)) * Polynomial.X) := by
      intro i
      rw [hF, Polynomial.prod_comp]
      apply Finset.prod_congr rfl
      intro j _
      rw [hq]
      exact hcomp _ _ _ _
    have hFG : ∀ i ∈ G, ∀ j, W.valuation ((F.comp (q i) - 1).coeff j) < 1 := by
      intro i hi
      have hiI : i ∈ I := ((hmemG i).mp hi).1
      rw [hFcomp]
      refine Finset.prod_induction _
        (fun p : Polynomial Ω => ∀ j, W.valuation ((p - 1).coeff j) < 1)
        (fun a b ha hb => hmulOne a b ha hb) ?_ ?_
      · intro j
        rw [sub_self, Polynomial.coeff_zero, map_zero]
        exact zero_lt_one
      · intro j hj
        rw [hCsub1]
        apply hlinS
        · have e : (β j - β l)⁻¹ * (β j - β i) - 1 = (β j - β l)⁻¹ * (β l - β i) := by
            linear_combination inv_mul_cancel₀ (hDne j hj)
          rw [e]
          apply hvdiv _ _ (hDpos j hj)
          rw [Valuation.map_sub_swap]
          exact lt_of_lt_of_le ((hmemG i).mp hi).2 (hjD j hj)
        · rw [Valuation.map_neg]
          exact hvdiv _ _ (hDpos j hj) (lt_of_lt_of_le (hlamM i hiI) (hjD j hj))
    have hFnG : ∀ i ∈ I \ G, ∀ j, W.valuation ((F.comp (q i)).coeff j) < 1 := by
      intro i hi
      have hiI : i ∈ I := (Finset.mem_sdiff.mp hi).1
      rw [hFcomp, ← Finset.mul_prod_erase _ _ hi]
      apply hmulS
      · apply hlinS
        · rw [sub_self, mul_zero, map_zero]; exact zero_lt_one
        · rw [Valuation.map_neg]
          exact hvdiv _ _ (hDpos i hi) (lt_of_lt_of_le (hlamM i hiI) (hjD i hi))
      · refine Finset.prod_induction _
          (fun p : Polynomial Ω => ∀ j, W.valuation (p.coeff j) ≤ 1)
          (fun a b ha hb => hmulI a b ha hb) hint1 ?_
        intro j hj
        have hj' : j ∈ I \ G := Finset.mem_of_mem_erase hj
        have hjI : j ∈ I := (Finset.mem_sdiff.mp hj').1
        apply hlinI
        · exact hvdivle _ _ (hDpos j hj') (le_trans (hstar j hjI i hiI) (hjD j hj'))
        · rw [Valuation.map_neg]
          exact le_of_lt (hvdiv _ _ (hDpos j hj') (lt_of_lt_of_le (hlamM i hiI) (hjD j hj')))

    obtain ⟨E₀, hE₀⟩ := ih G hGsub hlG
    have hN : ∀ i ∈ I \ G, ∃ N : ℕ,
        ∀ j, W.valuation (((F.comp (q i)) ^ N * E₀.comp (q i)).coeff j) ≤ 1 :=
      fun i hi => harch _ _ (hFnG i hi)
    choose! Nf hNf using hN
    refine ⟨E₀ * F ^ ((∑ i ∈ I \ G, Nf i) + 1), ?_⟩
    intro i hiI j
    rw [Polynomial.mul_comp, Polynomial.pow_comp]
    by_cases hiG : i ∈ G
    · have hA := hE₀ i hiG
      by_cases hil : i = l
      · rw [hδ, if_pos hil] at hA ⊢
        exact hmulOne _ _ hA (hpowOne _ _ (hFG i hiG)) j
      · rw [hδ, if_neg hil, sub_zero] at hA ⊢
        exact hmulS _ _ hA (hpowI _ _ (hIofS _ _ (hFG i hiG) hint1)) j
    · have hi : i ∈ I \ G := Finset.mem_sdiff.mpr ⟨hiI, hiG⟩
      have hil : i ≠ l := fun h => hiG (h ▸ hlG)
      rw [hδ, if_neg hil, sub_zero]
      have hle : Nf i ≤ ∑ i ∈ I \ G, Nf i :=
        Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi
      obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hle
      rw [hd]
      have e : E₀.comp (q i) * F.comp (q i) ^ (Nf i + d + 1) =
          F.comp (q i) * (F.comp (q i) ^ d * (F.comp (q i) ^ Nf i * E₀.comp (q i))) := by
        ring
      rw [e]
      exact hmulS _ _ (hFnG i hi) (hmulI _ _ (hpowI _ _ (hSI _ (hFnG i hi))) (hNf i hi)) j
  obtain ⟨E, hE⟩ := key Finset.univ (Finset.mem_univ l)
  refine ⟨E, fun i j => ?_⟩
  have h := hE i (Finset.mem_univ i)
  rw [← hq i, ← hδ i]
  exact ⟨hIofS _ _ h (hδI i) j, h j⟩

theorem wcpa_dj_lr1k_odfgl_ln_fibre_iso : ∀ (W : Type u) [CommRing W] [IsLocalRing W]
    (Q : Type u) [CommRing Q] [Algebra W Q]
    (B : Type u) [CommRing B] [Algebra (IsLocalRing.ResidueField W) B] [Algebra W B]
    [IsScalarTower W (IsLocalRing.ResidueField W) B]
    (Φ : Q →ₐ[W] B), Function.Surjective Φ →
    RingHom.ker Φ = Ideal.map (algebraMap W Q) (IsLocalRing.maximalIdeal W) →
    ∃ ψ : TensorProduct W (IsLocalRing.ResidueField W) Q ≃ₐ[IsLocalRing.ResidueField W] B,
      ∀ q : Q, ψ (TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) q) = Φ q :=
by
  intro W _ _ Q _ _ B _ _ _ _ Φ hsurj hker
  let ψ₀ : TensorProduct W (IsLocalRing.ResidueField W) Q →ₐ[IsLocalRing.ResidueField W] B :=
    Algebra.TensorProduct.lift (Algebra.ofId (IsLocalRing.ResidueField W) B) Φ
      (fun _ _ => Commute.all _ _)
  have hψ₀ : ∀ q : Q, ψ₀ (TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) q) = Φ q := by
    intro q
    simp [ψ₀, Algebra.TensorProduct.lift_tmul]
  have hS : Function.Surjective ψ₀ := by
    intro b
    obtain ⟨q, rfl⟩ := hsurj b
    exact ⟨_, hψ₀ q⟩
  have hres : Function.Surjective (algebraMap W (IsLocalRing.ResidueField W)) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_surjective
  have hIR := Algebra.TensorProduct.includeRight_surjective (R := W)
    (S := IsLocalRing.ResidueField W) (T := Q) hres
  have hzero : ∀ q ∈ Ideal.map (algebraMap W Q) (IsLocalRing.maximalIdeal W),
      (TensorProduct.tmul W (1 : IsLocalRing.ResidueField W) q) = 0 := by
    intro q hq
    have hle : Ideal.map (algebraMap W Q) (IsLocalRing.maximalIdeal W) ≤
        RingHom.ker (Algebra.TensorProduct.includeRight (R := W)
          (A := IsLocalRing.ResidueField W) (B := Q)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker, Algebra.TensorProduct.includeRight_apply,
        Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul,
        Algebra.smul_def, mul_one, IsLocalRing.ResidueField.algebraMap_eq,
        (IsLocalRing.residue_eq_zero_iff w).mpr hw, TensorProduct.zero_tmul]
    have := hle hq
    rw [RingHom.mem_ker, Algebra.TensorProduct.includeRight_apply] at this
    exact this
  have hI : Function.Injective ψ₀ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨q, rfl⟩ := hIR x
    rw [Algebra.TensorProduct.includeRight_apply] at hx ⊢
    rw [hψ₀] at hx
    have hq : q ∈ RingHom.ker Φ := (RingHom.mem_ker).mpr hx
    rw [hker] at hq
    exact hzero q hq
  have hB : Function.Bijective ψ₀ := ⟨hI, hS⟩
  exact ⟨AlgEquiv.ofBijective ψ₀ hB, fun q => hψ₀ q⟩

theorem wcpa_dj_lr1k_odfgl_ln_fibre_map : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (k : ℕ), 1 ≤ k → ∀ (β lam : Fin k → Ω),
    (∀ l, W.valuation (β l) < 1 ∧ lam l ≠ 0 ∧ W.valuation (lam l) < 1) →
    (∀ F H : Polynomial Ω, (∀ j, W.valuation (F.coeff j) < 1) →
      ∃ N : ℕ, ∀ j, W.valuation ((F ^ N * H).coeff j) ≤ 1) →
    (∀ l, ∃ E : Polynomial Ω, ∀ i j,
      W.valuation ((E.comp (Polynomial.C (β i) + Polynomial.C (lam i) * Polynomial.X)).coeff j)
        ≤ 1 ∧
      W.valuation ((E.comp (Polynomial.C (β i) + Polynomial.C (lam i) * Polynomial.X) -
        (if i = l then 1 else 0)).coeff j) < 1) →
    ∀ Q : Subalgebra ↥W (Polynomial Ω),
    (∀ f : Polynomial Ω, f ∈ Q ↔ ∀ l j,
      (f.comp (Polynomial.C (β l) + Polynomial.C (lam l) * Polynomial.X)).coeff j ∈ W) →
    ∃ Φ : ↥Q →ₐ[↥W] (Fin k → Polynomial (IsLocalRing.ResidueField ↥W)),
      Function.Surjective Φ ∧
      RingHom.ker Φ = Ideal.map (algebraMap ↥W ↥Q) (IsLocalRing.maximalIdeal ↥W) ∧
      ∀ hX : (Polynomial.X : Polynomial Ω) ∈ Q, Φ ⟨Polynomial.X, hX⟩ = 0 :=
by
  intro Ω _ W k hk β lam hβl harch hsep Q hQ
  classical
  let φ : Fin k → Polynomial Ω := fun l =>
    Polynomial.C (β l) + Polynomial.C (lam l) * Polynomial.X
  let T : Polynomial W →+* Polynomial Ω := Polynomial.mapRingHom (algebraMap W Ω)
  have hTinj : Function.Injective T := Polynomial.map_injective _ Subtype.val_injective
  let eT : Polynomial W ≃+* T.range := RingEquiv.ofBijective T.rangeRestrict
    ⟨fun a b h => hTinj (congrArg Subtype.val h), T.rangeRestrict_surjective⟩
  let red : T.range →+* Polynomial (IsLocalRing.ResidueField W) :=
    (Polynomial.mapRingHom (IsLocalRing.residue W)).comp eT.symm.toRingHom
  have hL : ∀ (y : T.range) (j : ℕ),
      (((eT.symm y).coeff j : W) : Ω) = (y : Polynomial Ω).coeff j := by
    intro y j
    have h1 : T (eT.symm y) = (y : Polynomial Ω) :=
      congrArg Subtype.val (eT.apply_symm_apply y)
    rw [← h1]
    show _ = ((eT.symm y).map (algebraMap W Ω)).coeff j
    rw [Polynomial.coeff_map]
    rfl
  have hredc : ∀ (y : T.range) (j : ℕ),
      (red y).coeff j = IsLocalRing.residue W ((eT.symm y).coeff j) := by
    intro y j
    show ((eT.symm y).map (IsLocalRing.residue W)).coeff j = _
    rw [Polynomial.coeff_map]
  have hcoefT : ∀ (y : T.range) (j : ℕ), (y : Polynomial Ω).coeff j ∈ W := by
    intro y j
    rw [← hL]
    exact ((eT.symm y).coeff j).2
  have hmemT : ∀ p : Polynomial Ω, (∀ j, p.coeff j ∈ W) → p ∈ T.range := by
    intro p hp
    obtain ⟨q, hq⟩ := (Polynomial.mem_lifts p).mp
      ((Polynomial.lifts_iff_coeff_lifts (f := algebraMap W Ω) p).mpr fun n =>
        Set.mem_range.mpr ⟨⟨p.coeff n, hp n⟩, rfl⟩)
    exact ⟨q, hq⟩
  have hcrit : ∀ (y : T.range) (q : Polynomial W),
      (∀ j, W.valuation (((y : Polynomial Ω) - q.map (algebraMap W Ω)).coeff j) < 1) →
      red y = q.map (IsLocalRing.residue W) := by
    intro y q h
    ext j
    rw [hredc, Polynomial.coeff_map]
    have h1 := h j
    rw [Polynomial.coeff_sub, Polynomial.coeff_map, ← hL y j] at h1
    have h2 : (eT.symm y).coeff j - q.coeff j ∈ IsLocalRing.maximalIdeal W := by
      rw [ValuationSubring.valuation_lt_one_iff]
      exact h1
    rw [← sub_eq_zero, ← map_sub]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr h2
  have hred0 : ∀ y : T.range, red y = 0 →
      ∀ j, W.valuation ((y : Polynomial Ω).coeff j) < 1 := by
    intro y hy j
    have h1 := hredc y j
    rw [hy, Polynomial.coeff_zero] at h1
    have h2 := (IsLocalRing.residue_eq_zero_iff _).mp h1.symm
    rw [ValuationSubring.valuation_lt_one_iff, hL] at h2
    exact h2
  have hmemcomp : ∀ (f : Q) (l : Fin k), (f : Polynomial Ω).comp (φ l) ∈ T.range :=
    fun f l => hmemT _ ((hQ f).mp f.2 l)
  let Φ₀ : Q →+* (Fin k → Polynomial (IsLocalRing.ResidueField W)) :=
    RingHom.pi fun l => red.comp
      (((Polynomial.compRingHom (φ l)).comp Q.val.toRingHom).codRestrict T.range
        (fun f => hmemcomp f l))
  let Φ : Q →ₐ[W] (Fin k → Polynomial (IsLocalRing.ResidueField W)) :=
    { toRingHom := Φ₀
      commutes' := fun w => by
        funext l
        show red ⟨((algebraMap W Q w : Q) : Polynomial Ω).comp (φ l), hmemcomp _ l⟩ = _
        rw [hcrit _ (Polynomial.C w) ?_]
        · rw [Polynomial.map_C, Pi.algebraMap_apply, Polynomial.algebraMap_apply,
            IsLocalRing.ResidueField.algebraMap_eq]
        · intro j
          show W.valuation ((((algebraMap W Q w : Q) : Polynomial Ω).comp (φ l) -
            (Polynomial.C w).map (algebraMap W Ω)).coeff j) < 1
          rw [Subalgebra.coe_algebraMap, Polynomial.algebraMap_apply, Polynomial.C_comp,
            Polynomial.map_C, sub_self, Polynomial.coeff_zero, map_zero]
          exact zero_lt_one }
  have hΦeq : ∀ (f : Q) (l : Fin k),
      Φ f l = red ⟨(f : Polynomial Ω).comp (φ l), hmemcomp f l⟩ :=
    fun f l => rfl
  have hXb : ∀ j, (Polynomial.X : Polynomial Ω).coeff j ∈ W := by
    intro j
    rw [Polynomial.coeff_X]
    split_ifs
    · exact W.one_mem
    · exact W.zero_mem

  have hXz : ∀ hX : (Polynomial.X : Polynomial Ω) ∈ Q, Φ ⟨Polynomial.X, hX⟩ = 0 := by
    intro hX
    funext l
    rw [hΦeq, Pi.zero_apply, hcrit _ 0 ?_, Polynomial.map_zero]
    intro j
    show W.valuation (((Polynomial.X : Polynomial Ω).comp (φ l) -
      (0 : Polynomial W).map (algebraMap W Ω)).coeff j) < 1
    rw [Polynomial.map_zero, sub_zero, Polynomial.X_comp]
    simp only [φ, Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul_X]
    apply Valuation.map_add_lt
    · split_ifs
      · exact (hβl l).1
      · rw [map_zero]; exact zero_lt_one
    · split_ifs
      · exact (hβl l).2.2
      · rw [map_zero]; exact zero_lt_one

  have hker1 : Ideal.map (algebraMap W Q) (IsLocalRing.maximalIdeal W) ≤ RingHom.ker Φ := by
    rw [Ideal.map_le_iff_le_comap]
    intro w hw
    rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes]
    funext l
    rw [Pi.algebraMap_apply, Polynomial.algebraMap_apply, IsLocalRing.ResidueField.algebraMap_eq,
      (IsLocalRing.residue_eq_zero_iff w).mpr hw, Polynomial.C_0, Pi.zero_apply]

  have hker2 : RingHom.ker Φ ≤ Ideal.map (algebraMap W Q) (IsLocalRing.maximalIdeal W) := by
    intro f hf
    rw [RingHom.mem_ker] at hf
    have hsmall : ∀ l j, W.valuation (((f : Polynomial Ω).comp (φ l)).coeff j) < 1 := by
      intro l
      exact hred0 ⟨_, hmemcomp f l⟩ (by rw [← hΦeq f l, hf]; rfl)
    by_cases hf0 : (f : Polynomial Ω) = 0
    · have : f = 0 := Subtype.ext hf0
      rw [this]
      exact zero_mem _
    let l0 : Fin k := ⟨0, hk⟩
    have hc0 : (f : Polynomial Ω).comp (φ l0) ≠ 0 := by
      intro h
      rcases Polynomial.comp_eq_zero_iff.mp h with h | ⟨_, h⟩
      · exact hf0 h
      · have h1 := congrArg (fun p => Polynomial.coeff p 1) h
        simp only [φ, Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul_X] at h1
        simp at h1
        exact (hβl l0).2.1 h1
    obtain ⟨j0, hj0⟩ : ∃ j, ((f : Polynomial Ω).comp (φ l0)).coeff j ≠ 0 := by
      by_contra h
      push Not at h
      exact hc0 (Polynomial.ext fun n => by rw [h n, Polynomial.coeff_zero])
    let S : Finset (Fin k × ℕ) := Finset.univ ×ˢ
      (Finset.univ.biUnion fun l => ((f : Polynomial Ω).comp (φ l)).support)
    have hmemS : ∀ l j, ((f : Polynomial Ω).comp (φ l)).coeff j ≠ 0 → (l, j) ∈ S :=
      fun l j h => Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_biUnion.mpr
        ⟨l, Finset.mem_univ _, Polynomial.mem_support_iff.mpr h⟩⟩
    obtain ⟨p, -, hpmax⟩ := Finset.exists_max_image S
      (fun p => W.valuation (((f : Polynomial Ω).comp (φ p.1)).coeff p.2)) ⟨_, hmemS l0 j0 hj0⟩
    obtain ⟨a, ha⟩ : ∃ a, a = ((f : Polynomial Ω).comp (φ p.1)).coeff p.2 := ⟨_, rfl⟩
    have hdom : ∀ l j,
        W.valuation (((f : Polynomial Ω).comp (φ l)).coeff j) ≤ W.valuation a := by
      intro l j
      rw [ha]
      by_cases h : ((f : Polynomial Ω).comp (φ l)).coeff j = 0
      · rw [h, map_zero]; exact zero_le
      · exact hpmax (l, j) (hmemS l j h)
    have ha0 : a ≠ 0 := by
      intro h
      have h1 := hdom l0 j0
      rw [h, map_zero] at h1
      exact hj0 ((Valuation.zero_iff _).mp (le_antisymm h1 zero_le))
    have hav : W.valuation a < 1 := by rw [ha]; exact hsmall p.1 p.2
    have hva0 : W.valuation a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha0
    have hf'Q : Polynomial.C a⁻¹ * (f : Polynomial Ω) ∈ Q := by
      refine (hQ _).mpr fun l j => (W.valuation_le_one_iff _).mp ?_
      rw [Polynomial.mul_comp, Polynomial.C_comp, Polynomial.coeff_C_mul, map_mul, map_inv₀]
      calc (W.valuation a)⁻¹ * W.valuation (((f : Polynomial Ω).comp (φ l)).coeff j)
          ≤ (W.valuation a)⁻¹ * W.valuation a := by gcongr; exact hdom l j
        _ = 1 := inv_mul_cancel₀ hva0
    let aW : W := ⟨a, (W.valuation_le_one_iff a).mp hav.le⟩
    have haWm : aW ∈ IsLocalRing.maximalIdeal W := (W.valuation_lt_one_iff aW).mpr hav
    have hfact : f = algebraMap W Q aW * ⟨_, hf'Q⟩ := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Polynomial.algebraMap_apply]
      show (f : Polynomial Ω) = Polynomial.C a * (Polynomial.C a⁻¹ * (f : Polynomial Ω))
      rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ ha0, Polynomial.C_1, one_mul]
    rw [hfact]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ haWm)

  have hE : ∀ l, ∃ a : Q, Φ a = Pi.single l 1 := by
    intro l
    obtain ⟨E, hE⟩ := hsep l
    have hEQ : E ∈ Q := (hQ E).mpr fun i j => (W.valuation_le_one_iff _).mp (hE i j).1
    refine ⟨⟨E, hEQ⟩, funext fun i => ?_⟩
    rw [hΦeq, hcrit _ (if i = l then 1 else 0) ?_, Pi.single_apply]
    · split_ifs <;> simp
    · intro j
      have h1 := (hE i j).2
      split_ifs at h1 ⊢
      · rw [Polynomial.map_one]; exact h1
      · rw [Polynomial.map_zero]; exact h1

  have hG : ∀ l, ∃ a : Q, Φ a = Pi.single l (Polynomial.X : Polynomial (IsLocalRing.ResidueField W)) := by
    intro l
    obtain ⟨E, hE⟩ := hsep l
    have hEb : ∀ i, E.comp (φ i) ∈ T.range :=
      fun i => hmemT _ fun j => (W.valuation_le_one_iff _).mp (hE i j).1
    have hEs : ∀ i, i ≠ l → ∀ j, W.valuation ((E.comp (φ i)).coeff j) < 1 := by
      intro i hi j
      have h1 := (hE i j).2
      rw [if_neg hi, sub_zero] at h1
      exact h1
    have hE1 : ∀ j, W.valuation ((E.comp (φ l) -
        (1 : Polynomial W).map (algebraMap W Ω)).coeff j) < 1 := by
      intro j
      have h1 := (hE l j).2
      rw [if_pos rfl] at h1
      rw [Polynomial.map_one]
      exact h1
    obtain ⟨u, hu⟩ : ∃ u : Polynomial Ω,
        u = Polynomial.C (lam l)⁻¹ * (Polynomial.X - Polynomial.C (β l)) := ⟨_, rfl⟩
    have hul : u.comp (φ l) = Polynomial.X := by
      rw [hu, Polynomial.mul_comp, Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp,
        Polynomial.C_comp]
      show Polynomial.C (lam l)⁻¹ * (Polynomial.C (β l) + Polynomial.C (lam l) * Polynomial.X -
        Polynomial.C (β l)) = Polynomial.X
      rw [add_sub_cancel_left, ← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ (hβl l).2.1,
        Polynomial.C_1, one_mul]
    have hN : ∀ i, ∃ N : ℕ, i ≠ l →
        ∀ j, W.valuation (((E.comp (φ i)) ^ N * u.comp (φ i)).coeff j) ≤ 1 := by
      intro i
      by_cases hi : i = l
      · exact ⟨0, fun h => absurd hi h⟩
      · obtain ⟨N, hN⟩ := harch (E.comp (φ i)) (u.comp (φ i)) (hEs i hi)
        exact ⟨N, fun _ => hN⟩
    choose N hN using hN
    obtain ⟨M, hM⟩ : ∃ M, M = ∑ i, N i := ⟨_, rfl⟩
    have hNM : ∀ i, N i ≤ M := fun i => by
      rw [hM]; exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    have hkey : ∀ i, ∃ y : T.range, (y : Polynomial Ω) = (E ^ (M + 1) * u).comp (φ i) ∧
        red y = (Pi.single l (Polynomial.X : Polynomial (IsLocalRing.ResidueField W)) :
          Fin k → Polynomial (IsLocalRing.ResidueField W)) i := by
      intro i
      have hGc : (E ^ (M + 1) * u).comp (φ i) = (E.comp (φ i)) ^ (M + 1) * u.comp (φ i) := by
        rw [Polynomial.mul_comp, Polynomial.pow_comp]
      by_cases hi : i = l
      · subst hi
        have h1 : red ⟨E.comp (φ i), hEb i⟩ = 1 := by
          rw [hcrit ⟨E.comp (φ i), hEb i⟩ 1 hE1, Polynomial.map_one]
        have h2 : red ⟨Polynomial.X, hmemT _ hXb⟩ = Polynomial.X := by
          have h3 : ∀ j, W.valuation ((((⟨Polynomial.X, hmemT _ hXb⟩ : T.range) : Polynomial Ω) -
              (Polynomial.X : Polynomial W).map (algebraMap W Ω)).coeff j) < 1 := by
            intro j
            show W.valuation ((Polynomial.X - (Polynomial.X : Polynomial W).map
              (algebraMap W Ω)).coeff j) < 1
            rw [Polynomial.map_X, sub_self, Polynomial.coeff_zero, map_zero]
            exact zero_lt_one
          rw [hcrit ⟨Polynomial.X, hmemT _ hXb⟩ Polynomial.X h3, Polynomial.map_X]
        refine ⟨(⟨E.comp (φ i), hEb i⟩ : T.range) ^ (M + 1) * ⟨Polynomial.X, hmemT _ hXb⟩,
          ?_, ?_⟩
        · rw [hGc, hul]
          rfl
        · rw [map_mul, map_pow, h1, h2, one_pow, one_mul, Pi.single_eq_same]
      · have hR : (E.comp (φ i)) ^ (N i) * u.comp (φ i) ∈ T.range :=
          hmemT _ fun j => (W.valuation_le_one_iff _).mp (hN i hi j)
        have hle := hNM i
        refine ⟨(⟨E.comp (φ i), hEb i⟩ : T.range) ^ (M + 1 - N i) * ⟨_, hR⟩, ?_, ?_⟩
        · rw [hGc]
          show (E.comp (φ i)) ^ (M + 1 - N i) * ((E.comp (φ i)) ^ (N i) * u.comp (φ i)) = _
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel (by omega)]
        · have h1 : red ⟨E.comp (φ i), hEb i⟩ = 0 := by
            have h3 : ∀ j, W.valuation ((((⟨E.comp (φ i), hEb i⟩ : T.range) : Polynomial Ω) -
                (0 : Polynomial W).map (algebraMap W Ω)).coeff j) < 1 := by
              intro j
              show W.valuation ((E.comp (φ i) - (0 : Polynomial W).map (algebraMap W Ω)).coeff j) < 1
              rw [Polynomial.map_zero, sub_zero]
              exact hEs i hi j
            rw [hcrit ⟨E.comp (φ i), hEb i⟩ 0 h3, Polynomial.map_zero]
          rw [map_mul, map_pow, h1, zero_pow (by omega), zero_mul, Pi.single_eq_of_ne hi]
    have hGQ : E ^ (M + 1) * u ∈ Q := by
      refine (hQ _).mpr fun i j => ?_
      obtain ⟨y, hy, -⟩ := hkey i
      have h := hcoefT y j
      rw [hy] at h
      exact h
    refine ⟨⟨_, hGQ⟩, funext fun i => ?_⟩
    obtain ⟨y, hy, hred⟩ := hkey i
    rw [hΦeq, ← hred]
    exact congrArg red (Subtype.ext hy.symm)

  have hsurj : Function.Surjective Φ := by
    have hsingle : ∀ (l : Fin k) (p : Polynomial (IsLocalRing.ResidueField W)),
        Pi.single l p ∈ Φ.range := by
      intro l p
      obtain ⟨e, he⟩ := hE l
      obtain ⟨x, hx⟩ := hG l
      induction p using Polynomial.induction_on' with
      | add p q hp hq => rw [Pi.single_add]; exact add_mem hp hq
      | monomial n c =>
        obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective c
        have h1 : Pi.single l (Polynomial.monomial n (IsLocalRing.residue W w)) =
            algebraMap W _ w * (Φ e * Φ x ^ n) := by
          rw [he, hx]
          funext i
          rw [Pi.mul_apply, Pi.mul_apply, Pi.pow_apply, Pi.algebraMap_apply,
            Polynomial.algebraMap_apply, IsLocalRing.ResidueField.algebraMap_eq]
          by_cases hi : i = l
          · subst hi
            rw [Pi.single_eq_same, Pi.single_eq_same, Pi.single_eq_same, one_mul,
              Polynomial.C_mul_X_pow_eq_monomial]
          · rw [Pi.single_eq_of_ne hi, Pi.single_eq_of_ne hi, Pi.single_eq_of_ne hi, zero_mul,
              mul_zero]
        rw [h1]
        exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
          (Subalgebra.mul_mem _ (AlgHom.mem_range_self Φ e)
            (Subalgebra.pow_mem _ (AlgHom.mem_range_self Φ x) n))
    intro g
    have : g ∈ Φ.range := by
      rw [← Finset.univ_sum_single g]
      exact Subalgebra.sum_mem _ fun l _ => hsingle l (g l)
    rw [AlgHom.mem_range] at this
    obtain ⟨a, ha⟩ := this
    exact ⟨a, ha⟩
  exact ⟨Φ, hsurj, le_antisymm hker2 hker1, hXz⟩

theorem wcpa_dj_lr1k_odfgl_ln_integrally_closed : ∀ (R : Type u) (B : Type u) [CommRing R]
    [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [Algebra R B] (Q : Subalgebra R B),
    (∀ b : B, IsIntegral ↥Q b → b ∈ Q) →
    ∀ c : B, c ∈ Q → c ≠ 0 → (∀ b : B, ∃ N : ℕ, c ^ N * b ∈ Q) →
    IsIntegrallyClosed ↥Q :=
by
  intro R B _ _ _ _ _ Q hQ _ _ _ _
  haveI : IsIntegrallyClosedIn ↥Q B := by
    refine isIntegrallyClosedIn_iff.mpr ⟨?_, ?_⟩
    · exact (faithfulSMul_iff_algebraMap_injective ↥Q B).mp inferInstance
    · intro x hx
      exact ⟨⟨x, hQ x hx⟩, rfl⟩
  exact IsIntegrallyClosed.of_isIntegrallyClosed_of_isIntegrallyClosedIn ↥Q B

theorem wcpa_dj_lr1k_odfgl_lemniscate_normalization : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ c : ↥W, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ P : Polynomial ↥W, P.Monic → 1 ≤ P.natDegree →
      P.map (IsLocalRing.residue ↥W) = Polynomial.X ^ P.natDegree →
    ∃ Q : Subalgebra ↥W (Polynomial Ω),
      (∀ f : Polynomial Ω, f ∈ Q ↔ ∃ p : Polynomial (Polynomial Ω), p.Monic ∧
        (∀ i, p.coeff i ∈ Algebra.adjoin ↥W
          {Polynomial.X, Polynomial.C ((c : Ω)⁻¹) * P.map (algebraMap ↥W Ω)}) ∧ p.eval f = 0) ∧
      IsIntegrallyClosed ↥Q ∧
      ∃ (hX : (Polynomial.X : Polynomial Ω) ∈ Q) (k : ℕ)
        (ψ : TensorProduct ↥W (IsLocalRing.ResidueField ↥W) ↥Q ≃ₐ[IsLocalRing.ResidueField ↥W]
          (Fin k → Polynomial (IsLocalRing.ResidueField ↥W))),
        ψ (TensorProduct.tmul ↥W (1 : IsLocalRing.ResidueField ↥W) (⟨Polynomial.X, hX⟩ : ↥Q)) = 0 :=
by
  intro Ω _ _ W hW _ c hc0 hcm P hPm hPd hPres
  classical

  have hcΩ : (c : Ω) ≠ 0 := fun h => hc0 (Subtype.ext (by simpa using h))
  have hcv : W.valuation (c : Ω) < 1 := (W.valuation_lt_one_iff c).mp hcm
  have hvc0 : W.valuation (c : Ω) ≠ 0 := (Valuation.ne_zero_iff _).mpr hcΩ
  have harch := wcpa_dj_lr1k_odfgl_ln_archimedean Ω W hW
  have harchpoly := wcpa_dj_lr1k_odfgl_ln_archpoly Ω W harch
  have hval := wcpa_dj_lr1k_odfgl_ln_poly_values Ω W
  have hmemW : ∀ z : Ω, W.valuation z ≤ 1 → z ∈ W := fun z hz => (W.valuation_le_one_iff z).mp hz

  set Pt : Polynomial Ω := P.map (algebraMap ↥W Ω) with hPt
  have hPtm : Pt.Monic := hPm.map _
  have hPtd : Pt.natDegree = P.natDegree := hPm.natDegree_map _
  set s : Multiset Ω := Pt.roots with hs
  have hscard : Multiset.card s = P.natDegree := by
    rw [hs, IsAlgClosed.card_roots_eq_natDegree, hPtd]
  have hsprod : (s.map (fun a => Polynomial.X - Polynomial.C a)).prod = Pt :=
    Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hPtm
      IsAlgClosed.card_roots_eq_natDegree
  have hs0 : s ≠ 0 := by
    intro h
    rw [h, Multiset.card_zero] at hscard
    omega
  have hsv : ∀ a ∈ s, W.valuation a < 1 := by
    intro a ha
    have hroot : Pt.eval a = 0 := (Polynomial.mem_roots hPtm.ne_zero).mp ha
    have hint : IsIntegral ↥W a := ⟨P, hPm, by rw [Polynomial.eval₂_eq_eval_map]; exact hroot⟩
    obtain ⟨a', rfl⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hPa : P.eval a' = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_hom, ← Polynomial.eval_map]
      exact hroot
    have hres : IsLocalRing.residue ↥W a' = 0 := by
      have h1 : (P.map (IsLocalRing.residue ↥W)).eval (IsLocalRing.residue ↥W a') = 0 := by
        rw [Polynomial.eval_map, Polynomial.eval₂_hom, hPa, map_zero]
      rw [hPres, Polynomial.eval_pow, Polynomial.eval_X] at h1
      exact (pow_eq_zero_iff (by omega)).mp h1
    exact (W.valuation_lt_one_iff a').mp ((IsLocalRing.residue_eq_zero_iff a').mp hres)
  have hPteval : ∀ x : Ω, Pt.eval x = (s.map (fun a => x - a)).prod := by
    intro x
    rw [← hsprod, Polynomial.eval_multiset_prod, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro a _
    simp

  obtain ⟨k, β, lam, hβs, hlam, hsep, hcoef, hcover⟩ :=
    wcpa_dj_lr1k_odfgl_ln_discs Ω W s hs0 hsv (c : Ω) hcΩ hcv
