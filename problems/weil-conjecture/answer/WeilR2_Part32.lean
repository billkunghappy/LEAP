      rw [hPf, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]
    have hQe : Q.eval₂ (wcLr1uConst (wcProjKStr Ω 1)) g = wcLr1uConst (wcProjKStr Ω 1) eQ *
        Qt.eval₂ ((wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype) g := by
      rw [hQf, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]
    obtain ⟨hp0, hpinv⟩ := hRA.2 Pt ⟨i, by rw [hi]; exact isUnit_one⟩
    obtain ⟨hq0, hqinv⟩ := hRB.2 Qt ⟨j, by rw [hj]; exact isUnit_one⟩
    have hqA := evalMem A hA g hRA.1 Qt
    have hpB := evalMem B hB g hRB.1 Pt
    have hceQ : wcLr1uConst (wcProjKStr Ω 1) eQ ≠ 0 := (map_ne_zero _).mpr heQ
    rw [hPe, hQe] at hrel
    generalize Pt.eval₂ ((wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype) g = p at hrel hp0 hpinv hpB
    generalize Qt.eval₂ ((wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype) g = q at hrel hq0 hqinv hqA
    have k1 : wcLr1uConst (wcProjKStr Ω 1) (eP / eQ) = f * q * p⁻¹ := by
      rw [map_div₀, div_eq_iff hceQ]
      calc wcLr1uConst (wcProjKStr Ω 1) eP
          = wcLr1uConst (wcProjKStr Ω 1) eP * p * p⁻¹ := by
            rw [mul_assoc, mul_inv_cancel₀ hp0, mul_one]
        _ = f * (wcLr1uConst (wcProjKStr Ω 1) eQ * q) * p⁻¹ := by rw [hrel]
