  have hcov : ∀ x : ↥T, ∃ i, x ∈ O i := by
    intro x
    obtain ⟨A, hA, hxA⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {x} isIrreducible_singleton
    refine ⟨E.symm ⟨A, hA⟩, ?_⟩
    rw [hmem, Equiv.apply_symm_apply]
