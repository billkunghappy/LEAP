      TensorProduct κ (TensorProduct (Polynomial R) κ D) (TensorProduct R κ Q) :=
    Algebra.TensorProduct.lift (Algebra.ofId κ _) g (fun _ _ => Commute.all _ _)

  let hT : TensorProduct R κ Q →ₐ[κ] TensorProduct R κ (TensorProduct (Polynomial R) D Q) :=
    Algebra.TensorProduct.map (AlgHom.id κ κ)
      ((Algebra.TensorProduct.includeRight : Q →ₐ[Polynomial R]
        TensorProduct (Polynomial R) D Q).restrictScalars R)
  have hT_apply : ∀ (a : κ) (q : Q), hT (TensorProduct.tmul R a q) =
      TensorProduct.tmul R a (TensorProduct.tmul (Polynomial R) (1 : D) q) := fun a q => rfl
  let hD' : D →ₐ[Polynomial R] TensorProduct R κ (TensorProduct (Polynomial R) D Q) :=
    { toRingHom := (Algebra.TensorProduct.includeRight : TensorProduct (Polynomial R) D Q →ₐ[R]
          TensorProduct R κ (TensorProduct (Polynomial R) D Q)).toRingHom.comp
          (Algebra.TensorProduct.includeLeft : D →ₐ[Polynomial R]
            TensorProduct (Polynomial R) D Q).toRingHom
      commutes' := fun s => by
        show TensorProduct.tmul R (1 : κ)
          (TensorProduct.tmul (Polynomial R) (algebraMap (Polynomial R) D s) (1 : Q)) = _
        have e1 : TensorProduct.tmul (Polynomial R) (algebraMap (Polynomial R) D s) (1 : Q) =
            TensorProduct.tmul (Polynomial R) (1 : D) (algebraMap (Polynomial R) Q s) := by
          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul]
