    have hδ := wcpa_dj_lr1k_ll_gc_sk_local_count κ _ hAdim _ hfinB hBiso
    refine wcpa_dj_lr1k_ll_gc_sk_chart_dictionary κ Z j hj Zt ν hν a
      (fun x y hxy => hψinj hxy) T hTmax ?_ ?_ ?_
    · intro p hp hpT b
      obtain ⟨s, hs, x, hx⟩ := hTloc p hp hpT b
      exact ⟨s, hs, x, hx⟩
    · intro x s hs
      obtain ⟨y, hy⟩ := hTcrt x s hs
      refine ⟨y, fun m => ?_⟩
      obtain ⟨u, hu, w, hw⟩ := hy m
      exact ⟨u, hu, w, hw⟩
    · intro p _
      exact hδ p
  choose Sa hVAN using fun a => (hchart a).1
  have hLOC := fun a => (hchart a).2.1
  have hAPP := fun a => (hchart a).2.2

  have hcovtop : (⨆ a : Fin (N + 1), wcSgD κ N a) = ⊤ := by
    have hadj : Algebra.adjoin (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ 0))
        (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) κ)) = ⊤ := by
      rw [eq_top_iff]
      rintro p -
      induction p using MvPolynomial.induction_on with
      | C r =>
        exact Subalgebra.algebraMap_mem _
          (⟨MvPolynomial.C r, (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr
            (MvPolynomial.isHomogeneous_C _ r)⟩ :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ 0))
      | add p q hp hq => exact add_mem hp hq
      | mul_X p i hp => exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
    exact Proj.iSup_basicOpen_eq_top' (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ)
      (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) κ)
      (fun i => ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X κ i)⟩) hadj
  have hcov : ∀ z : Z, ∃ a, z ∈ j ⁻¹ᵁ wcSgD κ N a := by
    intro z
    have h : j z ∈ (⨆ a : Fin (N + 1), wcSgD κ N a) := by
      rw [hcovtop]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp h
    exact ⟨a, ha⟩
  choose α hα using hcov
  set Sg : Finset Z := Finset.univ.biUnion Sa with hSg
  have hnot : ∀ z, z ∉ Sg → ∀ a, z ∉ Sa a := fun z hz a h =>
    hz (Finset.mem_biUnion.mpr ⟨a, Finset.mem_univ a, h⟩)
  have h5 := wcpa_dj_lr1k_ll_gc_sk_assembly κ Z Zt j ν hinj e Sg α (fun z _ => hα z)
    (fun a z hz hzS b => hVAN a z hz (hnot z hzS a) _ le_rfl hz b) hAPP

  have hzero : ∀ z, z ∉ Sg → wcpaDjLkDelta (Z.presheaf.stalk z) = 0 := by
    intro z hz
    rw [← hLOC (α z) z (hα z)]
    unfold wcGcSkLocRk
    refine le_antisymm (iSup_le fun n => iSup_le fun v => iSup_le fun hv => ?_) bot_le
    rcases Nat.eq_zero_or_pos n with h | h
    · subst h; simp
    · exfalso
      have h1 := hv (fun _ => 1)
        (hVAN (α z) z (hα z) (hnot z hz _) _ le_rfl (hα z) _) ⟨0, h⟩
      exact one_ne_zero h1
  rw [h5, Finset.sum_congr rfl (fun z _ => hLOC (α z) z (hα z))]
  apply le_antisymm
  · exact le_iSup (fun t : Finset Z => ∑ z ∈ t, wcpaDjLkDelta (Z.presheaf.stalk z)) Sg
  · refine iSup_le fun t => ?_
    calc ∑ z ∈ t, wcpaDjLkDelta (Z.presheaf.stalk z)
