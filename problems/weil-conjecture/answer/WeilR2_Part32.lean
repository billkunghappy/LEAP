    refine wcpa_dj_lr1k_ll_gc_df_dim_le_one κ T ψ₁ hψ₁ ⟨d₁, c₁.toNat, e₁, fun e he => ?_⟩
    have h1 := hH₁ e he
    have h0 := Int.self_le_toNat c₁
    have h2 : (wcGcHilb ψ₁ e : ℤ) ≤ (d₁ : ℤ) * (e : ℤ) + (c₁.toNat : ℤ) := by linarith
    exact_mod_cast h2

  haveI := hψ₁
  haveI := wc_proj_space_isProper κ N₁
  haveI hsP : IsProper s := by rw [← hψ₁s]; infer_instance

  have hND : wcGcNormDatum (𝟙 T) := by
