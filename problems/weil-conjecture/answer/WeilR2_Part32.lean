theorem wcpa_dj_lr1k_llfi_fibre_count : ∀ (Ω A B K L : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Algebra Ω A] [Algebra.FiniteType Ω A] [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [Algebra A B] [Algebra.IsIntegral A B] [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L] [FiniteDimensional K L] [Algebra.IsSeparable K L], ∃ m : Ideal A, m.IsMaximal ∧ ∃ Q : Fin (Module.finrank K L) → Ideal B, Function.Injective Q ∧ ∀ i, (Q i).IsMaximal ∧ (Q i).comap (algebraMap A B) = m :=
by
  intro Ω A B K L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
  classical

  have hAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp hAK
  have hAB : Function.Injective (algebraMap A B) := by
    rw [IsScalarTower.algebraMap_eq A B L] at hAL
    exact Function.Injective.of_comp hAL

  obtain ⟨θ, hdeg, hsep⟩ : ∃ b : B, (minpoly A b).natDegree = Module.finrank K L ∧
      ((minpoly A b).map (algebraMap A K)).Separable := by
    obtain ⟨α, hα⟩ := Field.exists_primitive_element K L
    have halg : IsAlgebraic A α :=
      (IsFractionRing.isAlgebraic_iff A K L).mpr (Algebra.IsAlgebraic.isAlgebraic α)
    obtain ⟨y, hy0, hyint⟩ := halg.exists_integral_multiple
    obtain ⟨θ, hθ⟩ := IsIntegrallyClosed.isIntegral_iff.mp
      (IsIntegral.tower_top hyint : IsIntegral B (y • α))
    refine ⟨θ, ?_⟩
    set c := algebraMap A K y with hc
    have hc0 : c ≠ 0 := fun h => hy0 (hAK (by rw [← hc, h, map_zero]))
    have hβ : y • α = c • α := (IsScalarTower.algebraMap_smul K y α).symm
    have htop : IntermediateField.adjoin K {algebraMap B L θ} = ⊤ := by
      rw [eq_top_iff, ← hα, IntermediateField.adjoin_simple_le_iff]
      have h1 : algebraMap B L θ ∈ IntermediateField.adjoin K {algebraMap B L θ} :=
        IntermediateField.mem_adjoin_simple_self K _
      have h2 := IntermediateField.smul_mem (IntermediateField.adjoin K {algebraMap B L θ})
        (x := c⁻¹) h1
      have h3 : c⁻¹ • algebraMap B L θ = α := by
        rw [hθ, hβ, smul_smul, inv_mul_cancel₀ hc0, one_smul]
      rwa [h3] at h2
