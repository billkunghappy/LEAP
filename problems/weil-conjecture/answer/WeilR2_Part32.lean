  have hθint : IsIntegral A θ := Algebra.IsIntegral.isIntegral θ
  have hPmon : P.Monic := minpoly.monic hθint

  obtain ⟨D, u, v, hD0, huv⟩ : ∃ (D : A) (u v : (Polynomial A)), D ≠ 0 ∧
      u * P + v * Polynomial.derivative P = Polynomial.C D := by
    obtain ⟨a, b, hab⟩ : IsCoprime _ _ := hsep
    obtain ⟨c1, hc1m, hc1⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) a
    obtain ⟨c2, hc2m, hc2⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors A) b
    refine ⟨c1 * c2,
      Polynomial.C c2 * IsLocalization.integerNormalization (nonZeroDivisors A) a,
