  have hcomp : (algebraMap Γ(C, (γ ≫ ι) ⁻¹ᵁ V) C.functionField).comp ((γ ≫ ι).app V).hom =
      (RingHom.id C.functionField).comp (algebraMap Γ(X, V) C.functionField) := by
