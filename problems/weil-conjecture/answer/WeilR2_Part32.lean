  let σ : Z.presheaf.stalk z ≃+* V.toScheme.presheaf.stalk z' :=
    (asIso (V.ι.stalkMap z')).commRingCatIsoToRingEquiv
  have hc := s15 K (V.ι ≫ q) q V.ι rfl z'
  let e : Z.presheaf.stalk z ≃ₐ[K] V.toScheme.presheaf.stalk z' :=
    AlgEquiv.ofRingEquiv (f := σ) (fun c => RingHom.congr_fun hc c)
  exact transport _ _ e hfs hfree hfin hrk

theorem wcpa_dj_lr1k_gs_stalk_eft : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (s : Z ⟶ Spec (.of K)) [LocallyOfFiniteType s] (z : Z), letI := (wcLdpConst K s z).toAlgebra; Algebra.EssFiniteType K (Z.presheaf.stalk z) :=
by
  intro K _ Z s _ z
  set ε : K →+* (Spec (.of K)).presheaf.stalk (s z) :=
    ((Spec (.of K)).presheaf.germ ⊤ (s z) trivial).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom with hε
  have h1 : wcLdpConst K s z = (Scheme.Hom.stalkMap s z).hom.comp ε := by
    ext c
    have key := congrArg (fun ψ => ψ.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c))
      (Scheme.Hom.germ_stalkMap s ⊤ z trivial)
    simp only [hε, wcLdpConst, RingHom.comp_apply]
    exact key.symm
  have h2 : Function.Surjective ε := by
    intro t
    obtain ⟨U, m, σ, hσ⟩ := TopCat.Presheaf.exists_germ_eq _ t
    have hU : U = ⊤ := by
      apply TopologicalSpace.Opens.coe_eq_univ.mp
      apply Set.eq_univ_of_forall
