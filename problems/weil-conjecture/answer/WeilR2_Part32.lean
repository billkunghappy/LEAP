        (s4 γ V₀ (genericPoint C) (genericPoint (wcProjK Ω 1)) hγ hηV₀ hηV₁)
      exact this
    have N2 : ∀ (a : C ≅ C) (e : γ ⁻¹ᵁ V₀ ≤ a.hom ⁻¹ᵁ (γ ⁻¹ᵁ V₀)) (t : ↑Γ(C, γ ⁻¹ᵁ V₀)),
        (C.presheaf.germ (γ ⁻¹ᵁ V₀) (genericPoint C) hηV₁).hom
