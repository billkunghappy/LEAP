            (wcLr1uConst (wcProjKStr Ω 1) eQ * q)⁻¹ := by
            rw [mul_assoc, mul_inv_cancel₀ (mul_ne_zero hceQ hq0), mul_one]
        _ = wcLr1uConst (wcProjKStr Ω 1) eP * p * (wcLr1uConst (wcProjKStr Ω 1) eQ * q)⁻¹ := by
            rw [hrel]
        _ = wcLr1uConst (wcProjKStr Ω 1) (eP / eQ) * p * q⁻¹ := by
            rw [map_div₀]; ring
    have hcA : wcLr1uConst (wcProjKStr Ω 1) (eP / eQ) ∈ A := by
