theorem wcpa_dj_llsmgn_generic_in_chart : ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (X : Scheme.{u}) (V : X.Opens) (hV : IsAffineOpen V) [IsDomain ↑Γ(X, V)] (f : C ⟶ X)
    (hgen : genericPoint C ∈ f ⁻¹ᵁ V)
    (K : Type u) [Field K] [Algebra ↑Γ(X, V) K] [IsFractionRing ↑Γ(X, V) K]
    [Algebra K ↑C.functionField] [Algebra ↑Γ(X, V) ↑C.functionField]
    [IsScalarTower ↑Γ(X, V) K ↑C.functionField],
    algebraMap ↑Γ(X, V) ↑C.functionField = wcG2cKap f V hgen →
    ∀ (I : X.IdealSheafData) (z b : ↑Γ(X, V)), z ≠ 0 → I.ideal ⟨V, hV⟩ = Ideal.span {z, b} →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (f' : C ⟶ X'), wcCsdIsBlowup I r → f' ≫ r = f →
    ∀ (U' : X'.Opens) (hU' : U' ≤ r ⁻¹ᵁ V)
      (e : ↑Γ(X', U') ≃+* ↥(Algebra.adjoin ↑Γ(X, V)
        {algebraMap ↑Γ(X, V) K b / algebraMap ↑Γ(X, V) K z})),
      IsAffineOpen U' →
      (∀ f : ↑Γ(X, V), e ((r.appLE V U' hU').hom f) = algebraMap ↑Γ(X, V) _ f) →
    ∃ hgen' : genericPoint C ∈ f' ⁻¹ᵁ U',
      ∀ y : ↑Γ(X', U'), algebraMap _ ↑C.functionField (e y) = wcG2cKap f' U' hgen' y :=
by
  intro C _ X V hV _ f hgen K _ _ _ _ _ _ hκ I z b hz hI X' r f' hbl hf' U' hU' e hU'a he
  classical

  have factor : ∀ (Y : Scheme.{u}) (g : C ⟶ Y) (W : Y.Opens) (hW : IsAffineOpen W)
      (hg : genericPoint C ∈ g ⁻¹ᵁ W),
      C.fromSpecStalk (genericPoint C) ≫ g =
        Spec.map (g.app W ≫ C.presheaf.germ (g ⁻¹ᵁ W) (genericPoint C) hg) ≫ hW.fromSpec := by
    intro Y g W hW hg
    have hx : g (genericPoint C) ∈ W := (Scheme.Hom.mem_preimage g).mp hg
    rw [← Scheme.SpecMap_stalkMap_fromSpecStalk g, ← hW.fromSpecStalk_eq_fromSpecStalk hx,
      IsAffineOpen.fromSpecStalk, ← Category.assoc, ← Spec.map_comp, Scheme.Hom.germ_stalkMap]

  have hκz : wcG2cKap f V hgen z ≠ 0 := by
    rw [← hκ, IsScalarTower.algebraMap_apply ↑Γ(X, V) K ↑C.functionField]
    exact (map_ne_zero_iff _ (algebraMap K ↑C.functionField).injective).mpr
      ((map_ne_zero_iff _ (IsFractionRing.injective ↑Γ(X, V) K)).mpr hz)
  have hzI : z ∈ I.ideal ⟨V, hV⟩ := by
    rw [hI]; exact Ideal.subset_span (Set.mem_insert z {b})
  have hpfac := factor X f V hV hgen

  have hle : (⊤ : (Spec (C.presheaf.stalk (genericPoint C))).Opens) ≤
      (C.fromSpecStalk (genericPoint C) ≫ f) ⁻¹ᵁ V := by
    rintro x -
    rw [Scheme.Hom.mem_preimage, hpfac, Scheme.Hom.comp_apply]
    have h3 : hV.fromSpec (Spec.map (f.app V ≫ C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen) x)
        ∈ Set.range hV.fromSpec := ⟨_, rfl⟩
    rwa [hV.range_fromSpec] at h3
  have hid : ∀ (g : Opposite.op (⊤ : (Spec (C.presheaf.stalk (genericPoint C))).Opens) ⟶
      Opposite.op ⊤), (Spec (C.presheaf.stalk (genericPoint C))).presheaf.map g = 𝟙 _ := by
    intro g
    rw [Subsingleton.elim g (𝟙 _), CategoryTheory.Functor.map_id]
  have hcomp : (C.fromSpecStalk (genericPoint C) ≫ f).appLE V ⊤ hle =
      (f.app V ≫ C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen) ≫
        (Scheme.ΓSpecIso (C.presheaf.stalk (genericPoint C))).inv := by
    rw [Scheme.Hom.comp_appLE]
    simp only [Scheme.Hom.appLE, Scheme.fromSpecStalk_app hgen, Category.assoc,
      ← Functor.map_comp]
    rw [hid, Category.comp_id]
  have hunit : IsUnit (((C.fromSpecStalk (genericPoint C) ≫ f).appLE V ⊤ hle).hom z) := by
    rw [hcomp, CommRingCat.hom_comp, RingHom.comp_apply]
    exact (Ne.isUnit hκz).map _
  have hpull : wcCsdInvPull I (C.fromSpecStalk (genericPoint C) ≫ f) := by
    intro t
    refine ⟨⟨V, hV⟩, ⟨⊤, isAffineOpen_top _⟩, hle, z, trivial, hzI, ?_, ?_⟩
    · exact hunit.mem_nonZeroDivisors
    · show Ideal.map ((C.fromSpecStalk (genericPoint C) ≫ f).appLE V ⊤ hle).hom
          (I.ideal ⟨V, hV⟩) =
        Ideal.span {((C.fromSpecStalk (genericPoint C) ≫ f).appLE V ⊤ hle).hom z}
      rw [Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hzI) hunit, eq_comm,
        Ideal.span_singleton_eq_top]
      exact hunit

  have h1 : (C.fromSpecStalk (genericPoint C) ≫ f') ≫ r = C.fromSpecStalk (genericPoint C) ≫ f := by
    rw [Category.assoc, hf']

  let ψ : Γ(X', U') ⟶ C.presheaf.stalk (genericPoint C) :=
    CommRingCat.ofHom ((algebraMap _ ↑C.functionField).comp e.toRingHom)
  have hstar : r.appLE V U' hU' ≫ ψ =
      f.app V ≫ C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen := by
    ext a
    change algebraMap _ ↑C.functionField (e ((r.appLE V U' hU').hom a)) = wcG2cKap f V hgen a
    rw [he, ← hκ, Subalgebra.algebraMap_eq, RingHom.comp_apply,
      IsScalarTower.algebraMap_apply ↑Γ(X, V) K ↑C.functionField]
    rfl
  have h2 : (Spec.map ψ ≫ hU'a.fromSpec) ≫ r = C.fromSpecStalk (genericPoint C) ≫ f := by
    rw [Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec r hV hU'a hU', ← Category.assoc,
      ← Spec.map_comp, hstar, hpfac]

  have h12 := (hbl.2 _ _ hpull).unique h1 h2

  have hgen' : genericPoint C ∈ f' ⁻¹ᵁ U' := by
    rw [Scheme.Hom.mem_preimage]
    obtain ⟨c, hc⟩ : ∃ c, C.fromSpecStalk (genericPoint C) c = genericPoint C :=
      ⟨_, Scheme.fromSpecStalk_closedPoint⟩
    have h5 : f' (C.fromSpecStalk (genericPoint C) c) = hU'a.fromSpec (Spec.map ψ c) := by
      have := congrArg (fun g => g c) h12
      simp only [Scheme.Hom.comp_apply] at this
      exact this
    rw [← hc, h5]
    have h6 : hU'a.fromSpec (Spec.map ψ c) ∈ Set.range hU'a.fromSpec := ⟨_, rfl⟩
    rw [hU'a.range_fromSpec] at h6
    exact h6

  refine ⟨hgen', fun y => ?_⟩
  have h4 := factor X' f' U' hU'a hgen'
  rw [h12] at h4
  have := hU'a.isOpenImmersion_fromSpec
  have h5 := Spec.map_injective ((cancel_mono hU'a.fromSpec).mp h4)
  have h7 := congrArg (fun φ => φ.hom y) h5
  exact h7

theorem wcpa_dj_llsmg_np_chart_flat : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [IsDomain A] [Algebra ↥W A]
    (g : MvPolynomial (Fin 1) ↥W →+* A), g.Etale → g.comp MvPolynomial.C = algebraMap ↥W A →
    ∀ (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (c a : ↥W), a ≠ 0 →
    g (MvPolynomial.X 0) - algebraMap ↥W A c ≠ 0 ∧
    ∃ ρ : wcNpR0 W a →+* ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A a) /
          algebraMap A K (g (MvPolynomial.X 0) - algebraMap ↥W A c)}),
      ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0)) =
        algebraMap A _ (g (MvPolynomial.X 0) - algebraMap ↥W A c) ∧
      ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 1)) =
        ⟨algebraMap A K (algebraMap ↥W A a) /
            algebraMap A K (g (MvPolynomial.X 0) - algebraMap ↥W A c),
          Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∧
      ρ.comp ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C) =
        (algebraMap A _).comp (algebraMap ↥W A) ∧
      RingHom.Flat (R := wcNpR0 W a) (S := ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A a) /
          algebraMap A K (g (MvPolynomial.X 0) - algebraMap ↥W A c)})) ρ :=
by
  intro Ω _ W A _ _ _ g hg hC K _ _ _ c a ha

  have s1 : ∀ (P R A' B : Type u) [CommRing P] [CommRing R] [CommRing A'] [CommRing B]
      (j : P →+* R) (g' : P →+* A') (ρ : R →+* B) (ι : A' →+* B), g'.Flat →
      Function.Injective ι → ρ.comp j = ι.comp g' →
      (∀ Q : B → Prop, (∀ r, Q (ρ r)) → (∀ α, Q (ι α)) → (∀ u v, Q u → Q v → Q (u + v)) →
        (∀ u v, Q u → Q v → Q (u * v)) → ∀ b, Q b) → ∀ (x : R),
      (∃ p₀ : P, j p₀ = x) → (∀ r : R, x * r = 0 → r = 0) →
      (∀ r : R, ∃ (N : ℕ) (p : P), x ^ N * r = j p) → ρ.Flat := by
    intro P R A' B _ _ _ _ j g' ρ ι hg' hι hcomp hgen x hx hnzd hspan
    letI : Algebra P R := j.toAlgebra
    letI : Algebra P A' := g'.toAlgebra
    letI : Algebra R B := ρ.toAlgebra
    letI : Algebra P B := (ρ.comp j).toAlgebra
    haveI : IsScalarTower P R B := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Module.Flat P A' := hg'
    obtain ⟨p₀, hp₀⟩ := hx
    let gA : A' →ₐ[P] B :=
      { ι with
        commutes' := fun p => by
          show ι (g' p) = ρ (j p)
          exact (RingHom.congr_fun hcomp p).symm }
    let Φ : TensorProduct P R A' →ₐ[R] B :=
      Algebra.TensorProduct.lift (Algebra.ofId R B) gA (fun _ _ => Commute.all _ _)
    have hΦ : ∀ (r : R) (α : A'), Φ (TensorProduct.tmul P r α) = ρ r * ι α := fun r α => by
      simp only [Φ, Algebra.TensorProduct.lift_tmul]
      rfl
    have hsurj : Function.Surjective Φ := by
      refine hgen (fun b => ∃ ξ, Φ ξ = b) ?_ ?_ ?_ ?_
      · intro r; exact ⟨TensorProduct.tmul P r 1, by rw [hΦ, map_one, mul_one]⟩
      · intro α; exact ⟨TensorProduct.tmul P 1 α, by rw [hΦ, map_one, one_mul]⟩
      · rintro u v ⟨ξ, rfl⟩ ⟨η, rfl⟩; exact ⟨ξ + η, map_add _ _ _⟩
      · rintro u v ⟨ξ, rfl⟩ ⟨η, rfl⟩; exact ⟨ξ * η, map_mul _ _ _⟩
    have hjx : ∀ k : ℕ, j (p₀ ^ k) = x ^ k := fun k => by rw [map_pow, hp₀]
    have habs : ∀ (p : P) (α : A'),
        (TensorProduct.tmul P (j p) α : TensorProduct P R A') = TensorProduct.tmul P 1 (g' p * α) := by
      intro p α
      have h1 : j p = p • (1 : R) := by rw [Algebra.smul_def, mul_one]; rfl
      rw [h1, TensorProduct.smul_tmul, Algebra.smul_def]
      rfl
    have hQ : ∀ ξ : TensorProduct P R A', ∃ (N : ℕ) (α : A'),
        TensorProduct.tmul P (x ^ N) (1 : A') * ξ = TensorProduct.tmul P 1 α := by
      intro ξ
      induction ξ using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, by rw [mul_zero, TensorProduct.tmul_zero]⟩
      | tmul r α =>
        obtain ⟨N, p, hN⟩ := hspan r
        refine ⟨N, g' p * α, ?_⟩
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hN, habs]
      | add ξ₁ ξ₂ ih₁ ih₂ =>
        obtain ⟨N₁, α₁, h₁⟩ := ih₁
        obtain ⟨N₂, α₂, h₂⟩ := ih₂
        refine ⟨N₁ + N₂, g' (p₀ ^ N₂) * α₁ + g' (p₀ ^ N₁) * α₂, ?_⟩
        have e1 : (TensorProduct.tmul P (x ^ (N₁ + N₂)) (1 : A') : TensorProduct P R A') =
            TensorProduct.tmul P (x ^ N₂) (1 : A') * TensorProduct.tmul P (x ^ N₁) (1 : A') := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← pow_add, add_comm N₂]
        have e2 : (TensorProduct.tmul P (x ^ (N₁ + N₂)) (1 : A') : TensorProduct P R A') =
            TensorProduct.tmul P (x ^ N₁) (1 : A') * TensorProduct.tmul P (x ^ N₂) (1 : A') := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← pow_add]
        have f1 : (TensorProduct.tmul P (x ^ (N₁ + N₂)) (1 : A') : TensorProduct P R A') * ξ₁ =
            TensorProduct.tmul P 1 (g' (p₀ ^ N₂) * α₁) := by
          rw [e1, mul_assoc, h₁, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, ← hjx,
            habs]
        have f2 : (TensorProduct.tmul P (x ^ (N₁ + N₂)) (1 : A') : TensorProduct P R A') * ξ₂ =
            TensorProduct.tmul P 1 (g' (p₀ ^ N₁) * α₂) := by
          rw [e2, mul_assoc, h₂, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, ← hjx,
            habs]
        rw [mul_add, f1, f2, TensorProduct.tmul_add]
    have hpow : ∀ (N : ℕ) (r : R), x ^ N * r = 0 → r = 0 := by
      intro N
      induction N with
      | zero => intro r h; rwa [pow_zero, one_mul] at h
      | succ n ih =>
        intro r h
        apply hnzd
        apply ih
        rw [← mul_assoc, ← pow_succ]
        exact h
    have hmul : ∀ (N : ℕ) (ξ : TensorProduct P R A'),
        TensorProduct.tmul P (x ^ N) (1 : A') * ξ =
          ((LinearMap.mulLeft P (x ^ N)).rTensor A') ξ := by
      intro N ξ
      induction ξ using TensorProduct.induction_on with
      | zero => rw [mul_zero, map_zero]
      | tmul r α =>
        rw [LinearMap.rTensor_tmul, LinearMap.mulLeft_apply, Algebra.TensorProduct.tmul_mul_tmul,
          one_mul]
      | add ξ₁ ξ₂ ih₁ ih₂ => rw [mul_add, map_add, ih₁, ih₂]
    have hinj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro ξ hξ
      obtain ⟨N, α, hN⟩ := hQ ξ
      have h1 : ι α = 0 := by
        have := congrArg Φ hN
        rw [map_mul, hξ, mul_zero, hΦ, map_one, one_mul] at this
        exact this.symm
      have hα : α = 0 := hι (h1.trans (map_zero ι).symm)
      rw [hα, TensorProduct.tmul_zero, hmul] at hN
      have hinjN : Function.Injective (LinearMap.mulLeft P (x ^ N)) := by
        intro r₁ r₂ h
        rw [LinearMap.mulLeft_apply, LinearMap.mulLeft_apply] at h
        have := hpow N (r₁ - r₂) (by rw [mul_sub, h, sub_self])
        exact sub_eq_zero.mp this
      exact Module.Flat.rTensor_preserves_injective_linearMap _ hinjN
        (hN.trans (map_zero _).symm)
    let e : TensorProduct P R A' ≃ₐ[R] B := AlgEquiv.ofBijective Φ ⟨hinj, hsurj⟩
    show Module.Flat R B
    exact Module.Flat.of_linearEquiv e.toLinearEquiv.symm

  have s2 : ∀ r : wcNpR0 W a,
      Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0) * r = 0 → r = 0 := by
    intro r hr
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hr
    obtain ⟨h, hh⟩ := hr
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
    let e := MvPolynomial.finSuccEquiv (↥W) 1
    have e0 : e (MvPolynomial.X 0) = Polynomial.X := MvPolynomial.finSuccEquiv_X_zero
    have e1 : e (MvPolynomial.X 1) = Polynomial.C (MvPolynomial.X 0) :=
      MvPolynomial.finSuccEquiv_X_succ (j := 0)
    have eC : e (MvPolynomial.C a) = Polynomial.C (MvPolynomial.C a) := by
      have := e.commutes a
      rw [MvPolynomial.algebraMap_eq, Polynomial.algebraMap_apply,
        MvPolynomial.algebraMap_eq] at this
      exact this
    have hh' := congrArg e hh
    rw [map_mul, map_mul, map_sub, map_mul, e0, e1, eC] at hh'
    have hCa : (MvPolynomial.C a : MvPolynomial (Fin 1) ↥W) ≠ 0 := by
      rwa [Ne, MvPolynomial.C_eq_zero]
    have hc : (e h).coeff 0 = 0 := by
      have := congrArg (fun p => Polynomial.coeff p 0) hh'
      simp only [Polynomial.mul_coeff_zero, Polynomial.coeff_sub, Polynomial.coeff_X_zero,
        Polynomial.coeff_C_zero, zero_mul, zero_sub] at this
      rcases mul_eq_zero.mp this with h0 | h0
      · exact h0
      · exact absurd (neg_eq_zero.mp h0) hCa
    obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hc
    rw [hq, mul_assoc] at hh'
    have hF := mul_left_cancel₀ Polynomial.X_ne_zero hh'
    refine ⟨e.symm q, ?_⟩
    apply e.injective
    rw [map_mul, AlgEquiv.apply_symm_apply, map_sub, map_mul, e0, e1, eC, hF]

  have s3 : ∀ r : wcNpR0 W a, ∃ (N : ℕ) (p : MvPolynomial (Fin 1) ↥W),
      Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0) ^ N * r =
        MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C)
          (fun _ => Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0) +
            Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.C c)) p := by
    intro r
    set mk := Ideal.Quotient.mk (wcNpI W a) with hmk
    set j := MvPolynomial.eval₂Hom (mk.comp MvPolynomial.C)
      (fun _ : Fin 1 => mk (MvPolynomial.X 0) + mk (MvPolynomial.C c)) with hj
    have hjC : ∀ w, j (MvPolynomial.C w) = mk (MvPolynomial.C w) := fun w =>
      MvPolynomial.eval₂Hom_C _ _ w
    have hjT : j (MvPolynomial.X 0 - MvPolynomial.C c) = mk (MvPolynomial.X 0) := by
      rw [map_sub, hjC, hj, MvPolynomial.eval₂Hom_X', add_sub_cancel_right]
    have hjTk : ∀ k : ℕ, j ((MvPolynomial.X 0 - MvPolynomial.C c) ^ k) =
        mk (MvPolynomial.X 0) ^ k := fun k => by rw [map_pow, hjT]
    have hX01 : mk (MvPolynomial.X 0) * mk (MvPolynomial.X 1) = mk (MvPolynomial.C a) := by
      rw [← map_mul, hmk, Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    induction f using MvPolynomial.induction_on with
    | C w => exact ⟨0, MvPolynomial.C w, by rw [pow_zero, one_mul, hjC]⟩
    | add f₁ f₂ ih₁ ih₂ =>
      obtain ⟨N₁, p₁, h₁⟩ := ih₁
      obtain ⟨N₂, p₂, h₂⟩ := ih₂
      refine ⟨N₁ + N₂, (MvPolynomial.X 0 - MvPolynomial.C c) ^ N₂ * p₁ +
        (MvPolynomial.X 0 - MvPolynomial.C c) ^ N₁ * p₂, ?_⟩
      rw [map_add (j), map_mul j, map_mul j, hjTk, hjTk, ← h₁, ← h₂, map_add mk]
      ring
    | mul_X f i ih =>
      obtain ⟨N, p, h⟩ := ih
      rcases (by decide : ∀ i : Fin 2, i = 0 ∨ i = 1) i with rfl | rfl
      · refine ⟨N, p * (MvPolynomial.X 0 - MvPolynomial.C c), ?_⟩
        rw [map_mul j, hjT, ← h, map_mul mk]
        ring
      · refine ⟨N + 1, p * MvPolynomial.C a, ?_⟩
        rw [map_mul j, hjC, ← h, map_mul mk, ← hX01]
        ring

  have s4 : ∀ (z : A), z ≠ 0 →
      ∃ ρ : wcNpR0 W a →+* ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A a) /
          algebraMap A K z}),
        ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0)) = algebraMap A _ z ∧
        ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 1)) =
          ⟨algebraMap A K (algebraMap ↥W A a) / algebraMap A K z,
            Algebra.subset_adjoin (Set.mem_singleton _)⟩ ∧
        ρ.comp ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C) =
          (algebraMap A _).comp (algebraMap ↥W A) ∧
        ∀ Q : ↥(Algebra.adjoin A {algebraMap A K (algebraMap ↥W A a) / algebraMap A K z}) → Prop,
          (∀ r, Q (ρ r)) → (∀ α, Q (algebraMap A _ α)) → (∀ u v, Q u → Q v → Q (u + v)) →
          (∀ u v, Q u → Q v → Q (u * v)) → ∀ b, Q b := by
    intro z hz
    set s : K := algebraMap A K (algebraMap ↥W A a) / algebraMap A K z with hs
    set S := Algebra.adjoin A {s} with hS
    let s' : S := ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩
    let F : MvPolynomial (Fin 2) ↥W →+* S :=
      MvPolynomial.eval₂Hom ((algebraMap A S).comp (algebraMap ↥W A)) ![algebraMap A S z, s']
    have hzK : algebraMap A K z ≠ 0 := fun h =>
      hz (IsFractionRing.injective A K (h.trans (map_zero _).symm))
    have hF0 : F (MvPolynomial.X 0) = algebraMap A S z := by
      simp only [F, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
    have hF1 : F (MvPolynomial.X 1) = s' := by
      simp only [F, MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero]
    have hFC : ∀ w, F (MvPolynomial.C w) = algebraMap A S (algebraMap ↥W A w) := fun w => by
      simp only [F, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    have hFG : F (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 := by
      rw [map_sub, map_mul, hF0, hF1, hFC]
      apply Subtype.ext
      show algebraMap A K z * s - algebraMap A K (algebraMap ↥W A a) = 0
      rw [hs, mul_div_cancel₀ _ hzK, sub_self]
    have hF : ∀ q ∈ wcNpI W a, F q = 0 := by
      intro q hq
      obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton'.mp hq
      rw [map_mul, hFG, mul_zero]
    let ρ := Ideal.Quotient.lift (wcNpI W a) F hF
    have hρ1 : ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 1)) = s' := by
      rw [Ideal.Quotient.lift_mk, hF1]
    refine ⟨ρ, ?_, hρ1, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk, hF0]
    · ext w
      rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk, hFC, RingHom.comp_apply]
    · intro Q hQρ hQA hQadd hQmul b
      obtain ⟨y, hy⟩ := b
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        obtain rfl := Set.mem_singleton_iff.mp hx
        have h1 := hQρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 1))
        rw [hρ1] at h1
        exact h1
      | algebraMap r => exact hQA r
      | add x y hx hy ihx ihy => exact hQadd _ _ ihx ihy
      | mul x y hx hy ihx ihy => exact hQmul _ _ ihx ihy

  have hgflat : g.Flat := by
    letI : Algebra (MvPolynomial (Fin 1) ↥W) A := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 1) ↥W) A := hg
    exact (inferInstance : Module.Flat (MvPolynomial (Fin 1) ↥W) A)

  have hz0 : g (MvPolynomial.X 0) - algebraMap ↥W A c ≠ 0 := by
    letI : Algebra (MvPolynomial (Fin 1) ↥W) A := g.toAlgebra
    haveI : Module.Flat (MvPolynomial (Fin 1) ↥W) A := hgflat
    set q : MvPolynomial (Fin 1) ↥W := MvPolynomial.X 0 - MvPolynomial.C c with hqdef
    have hq0 : q ≠ 0 := by
      intro h
      have := congrArg (MvPolynomial.eval (fun _ => c + 1)) h
      simp [q] at this
    have hreg : IsSMulRegular A q :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hq0)
    have hgq : g q = g (MvPolynomial.X 0) - algebraMap ↥W A c := by
      rw [hqdef, map_sub, ← RingHom.comp_apply g MvPolynomial.C, hC]
    rw [← hgq]
    intro h0
    apply one_ne_zero (α := A)
    apply hreg
    show q • (1 : A) = q • (0 : A)
    rw [smul_zero, Algebra.smul_def, mul_one]
    exact h0
  refine ⟨hz0, ?_⟩
  obtain ⟨ρ, hρ0, hρ1, hρC, hgen⟩ := s4 _ hz0
  refine ⟨ρ, hρ0, hρ1, hρC, ?_⟩

  obtain ⟨j, hj⟩ : ∃ j : MvPolynomial (Fin 1) ↥W →+* wcNpR0 W a,
      j = MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C)
        (fun _ => Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0) +
          Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.C c)) := ⟨_, rfl⟩
  have hjC : ∀ w, j (MvPolynomial.C w) = Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.C w) :=
    fun w => by rw [hj]; exact MvPolynomial.eval₂Hom_C _ _ w
  have hjX : j (MvPolynomial.X 0) = Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0) +
      Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.C c) := by
    rw [hj]; exact MvPolynomial.eval₂Hom_X' _ _ 0
  have hp₀ : j (MvPolynomial.X 0 - MvPolynomial.C c) =
      Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0) := by
    rw [map_sub, hjC, hjX, add_sub_cancel_right]
  have hspan : ∀ r : wcNpR0 W a, ∃ (N : ℕ) (p : MvPolynomial (Fin 1) ↥W),
      Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0) ^ N * r = j p := by
    intro r; rw [hj]; exact s3 r
  have hι : Function.Injective (algebraMap A ↥(Algebra.adjoin A
      {algebraMap A K (algebraMap ↥W A a) /
        algebraMap A K (g (MvPolynomial.X 0) - algebraMap ↥W A c)})) := by
    intro α β h
    exact IsFractionRing.injective A K (congrArg Subtype.val h)
  have hρc := RingHom.congr_fun hρC c
  have hcomp : ρ.comp j = (algebraMap A ↥(Algebra.adjoin A
      {algebraMap A K (algebraMap ↥W A a) /
        algebraMap A K (g (MvPolynomial.X 0) - algebraMap ↥W A c)})).comp g := by
    apply MvPolynomial.ringHom_ext
    · intro w
      have h1 := RingHom.congr_fun hρC w
      have h2 := RingHom.congr_fun hC w
      simp only [RingHom.comp_apply] at h1 h2 ⊢
      rw [hjC, h1, h2]
    · intro i
      rw [Fin.fin_one_eq_zero i]
      simp only [RingHom.comp_apply] at hρc ⊢
      rw [hjX, map_add, hρ0, hρc, ← map_add, sub_add_cancel]
  exact @s1 (MvPolynomial (Fin 1) ↥W) (wcNpR0 W a) A _ _ _ _ _ j g ρ (algebraMap A _) hgflat hι hcomp
    hgen (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0)) ⟨_, hp₀⟩ s2 hspan

theorem wcpa_dj_llsmg_np_node_nonzero : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W),
    a ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ (B : Type u) [CommRing B] (ρ : wcNpR0 W a →+* B), RingHom.Flat (R := wcNpR0 W a) (S := B) ρ →
    ∀ (𝔫 : Ideal B) [𝔫.IsPrime],
      ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0)) ∈ 𝔫 →
      ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 1)) ∈ 𝔫 →
      (IsLocalRing.maximalIdeal ↥W).map (ρ.comp ((Ideal.Quotient.mk (wcNpI W a)).comp
        MvPolynomial.C)) ≤ 𝔫 →
      Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map (ρ.comp ((Ideal.Quotient.mk
          (wcNpI W a)).comp MvPolynomial.C))).map (algebraMap B (Localization.AtPrime 𝔫)))
        (algebraMap B (Localization.AtPrime 𝔫)
          (ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0)))) ≠ 0 ∧
      Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map (ρ.comp ((Ideal.Quotient.mk
          (wcNpI W a)).comp MvPolynomial.C))).map (algebraMap B (Localization.AtPrime 𝔫)))
        (algebraMap B (Localization.AtPrime 𝔫)
          (ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 1)))) ≠ 0 :=
by
  classical
  intro Ω _ W a ha B _ ρ hρ 𝔫 _ h0 h1 hm

  have hJP : (IsLocalRing.maximalIdeal ↥W).map
      ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C) ≤ 𝔫.comap ρ := by
    rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap]
    exact Ideal.map_le_iff_le_comap.mp hm

  have descentGen : ∀ (R : Type u) [CommRing R] (f : R →+* B), f.Flat →
      ∀ (J : Ideal R) (x : R),
      algebraMap B (Localization.AtPrime 𝔫) (f x) ∈
        (J.map f).map (algebraMap B (Localization.AtPrime 𝔫)) →
      ∃ s : R, s ∉ 𝔫.comap f ∧ s * x ∈ J := by
    intro R _ f hf J x hx
    haveI : (𝔫.comap f).IsPrime := Ideal.comap_isPrime f 𝔫
    have hφ : (Localization.localRingHom (𝔫.comap f) 𝔫 f rfl).Flat :=
      RingHom.Flat.localRingHom hf 𝔫 (𝔫.comap f) rfl
    letI : Algebra (Localization.AtPrime (𝔫.comap f)) (Localization.AtPrime 𝔫) :=
      (Localization.localRingHom (𝔫.comap f) 𝔫 f rfl).toAlgebra
    haveI : Module.Flat (Localization.AtPrime (𝔫.comap f)) (Localization.AtPrime 𝔫) := hφ
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (𝔫.comap f))
        (Localization.AtPrime 𝔫)) := by
      rw [RingHom.algebraMap_toAlgebra]
      exact Localization.isLocalHom_localRingHom (𝔫.comap f) 𝔫 f rfl
    haveI : Module.FaithfullyFlat (Localization.AtPrime (𝔫.comap f))
        (Localization.AtPrime 𝔫) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hcomp : (Localization.localRingHom (𝔫.comap f) 𝔫 f rfl).comp
        (algebraMap R (Localization.AtPrime (𝔫.comap f))) =
        (algebraMap B (Localization.AtPrime 𝔫)).comp f := by
      apply RingHom.ext
      intro y
      exact Localization.localRingHom_to_map (𝔫.comap f) 𝔫 f rfl y
    have hx' : algebraMap R (Localization.AtPrime (𝔫.comap f)) x ∈
        J.map (algebraMap R (Localization.AtPrime (𝔫.comap f))) := by
      rw [← Ideal.comap_map_eq_self_of_faithfullyFlat
        (A := Localization.AtPrime (𝔫.comap f)) (B := Localization.AtPrime 𝔫)
        (J.map (algebraMap R (Localization.AtPrime (𝔫.comap f))))]
      rw [Ideal.mem_comap, RingHom.algebraMap_toAlgebra, Ideal.map_map, hcomp,
        ← Ideal.map_map, Localization.localRingHom_to_map]
      exact hx
    obtain ⟨s, hs, hsx⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
      (𝔫.comap f).primeCompl (Localization.AtPrime (𝔫.comap f)) J x).mp hx'
    exact ⟨s, hs, hsx⟩
  have genA : ∀ (A : Type u) [CommRing A] (I : Ideal A) (ρ' : A ⧸ I →+* B), ρ'.Flat →
      ∀ (K : Ideal A) (y : A),
      algebraMap B (Localization.AtPrime 𝔫) (ρ' (Ideal.Quotient.mk I y)) ∈
        (K.map (ρ'.comp (Ideal.Quotient.mk I))).map (algebraMap B (Localization.AtPrime 𝔫)) →
      ∃ s : A ⧸ I, s ∉ 𝔫.comap ρ' ∧ s * Ideal.Quotient.mk I y ∈ K.map (Ideal.Quotient.mk I) := by
    intro A _ I ρ' hρ' K y hx
    rw [← Ideal.map_map] at hx
    exact descentGen (A ⧸ I) ρ' hρ' _ _ hx

  have hXS : ∀ j : Fin 2, MvPolynomial.X j ∈
      (𝔫.comap ρ).comap (Ideal.Quotient.mk (wcNpI W a)) := by
    intro j
    match j with
    | ⟨0, _⟩ => exact h0
    | ⟨1, _⟩ => exact h1
  have hCS : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, MvPolynomial.C w ∈
      (𝔫.comap ρ).comap (Ideal.Quotient.mk (wcNpI W a)) := fun w hw =>
    Ideal.mem_comap.mpr (hJP (Ideal.mem_map_of_mem _ hw))
  have hind : ∀ q : MvPolynomial (Fin 2) ↥W,
      q - MvPolynomial.C (MvPolynomial.constantCoeff q) ∈
        (𝔫.comap ρ).comap (Ideal.Quotient.mk (wcNpI W a)) := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C r =>
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    | mul_X p n _ =>
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hXS n)
  have kernel : ∀ (i : Fin 2) (p : MvPolynomial (Fin 2) ↥W),
      Ideal.Quotient.mk (wcNpI W a) p * Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X i) ∈
        ((IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
          (Ideal.Quotient.mk (wcNpI W a)) →
      p ∈ (𝔫.comap ρ).comap (Ideal.Quotient.mk (wcNpI W a)) := by
    intro i p hs0
    have hs : Ideal.Quotient.mk (wcNpI W a) p * Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X i) ∈
        (IsLocalRing.maximalIdeal ↥W).map
          ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C) := by
      rw [← Ideal.map_map]; exact hs0
    set ψ : MvPolynomial (Fin 2) ↥W →+* Polynomial (IsLocalRing.ResidueField ↥W) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp (IsLocalRing.residue ↥W))
        (fun j : Fin 2 => if j = i then Polynomial.X else 0) with hψdef
    have hres0 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, IsLocalRing.residue ↥W w = 0 :=
      fun w hw => (IsLocalRing.residue_eq_zero_iff w).mpr hw
    have hψC : ∀ w, ψ (MvPolynomial.C w) = Polynomial.C (IsLocalRing.residue ↥W w) :=
      fun w => MvPolynomial.eval₂Hom_C _ _ _
    have hψX : ∀ j, ψ (MvPolynomial.X j) = if j = i then Polynomial.X else 0 :=
      fun j => MvPolynomial.eval₂Hom_X' _ _ _
    have hprod : ((if (0 : Fin 2) = i then Polynomial.X else 0) *
        (if (1 : Fin 2) = i then Polynomial.X else 0) :
          Polynomial (IsLocalRing.ResidueField ↥W)) = 0 := by
      by_cases h : (0 : Fin 2) = i
      · have h' : (1 : Fin 2) ≠ i := by rw [← h]; exact Fin.zero_ne_one.symm
        rw [if_neg h', mul_zero]
      · rw [if_neg h, zero_mul]
    have hker : ∀ p ∈ wcNpI W a, ψ p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, map_sub, map_mul, hψX, hψX, hψC, hres0 a ha, map_zero, hprod, sub_zero,
        mul_zero]
    have hlift : ∀ p, Ideal.Quotient.lift (wcNpI W a) ψ hker
          (Ideal.Quotient.mk (wcNpI W a) p) = ψ p :=
      fun p => Ideal.Quotient.lift_mk _ _ _
    have hJk : (IsLocalRing.maximalIdeal ↥W).map
          ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C) ≤
        RingHom.ker (Ideal.Quotient.lift (wcNpI W a) ψ hker) := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, hlift, hψC, hres0 w hw,
        map_zero]
    have h := RingHom.mem_ker.mp (hJk hs)
    rw [map_mul, hlift, hlift, hψX, if_pos rfl] at h
    have hp0 := (mul_eq_zero.mp h).resolve_right Polynomial.X_ne_zero
    have hev : (Polynomial.evalRingHom 0).comp ψ =
        (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.comp_apply, hψC, MvPolynomial.constantCoeff_C,
          Polynomial.coe_evalRingHom, Polynomial.eval_C]
      · intro j
        rw [RingHom.comp_apply, RingHom.comp_apply, hψX, MvPolynomial.constantCoeff_X, map_zero]
        split_ifs <;> simp
    have hc : MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      have h2 := RingHom.congr_fun hev p
      rw [RingHom.comp_apply, RingHom.comp_apply, hp0, map_zero] at h2
      exact h2.symm
    have h3 := Ideal.add_mem _ (hind p) (hCS _ hc)
    rw [sub_add_cancel] at h3
    exact h3

  have main : ∀ i : Fin 2, Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map
      (ρ.comp ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C))).map
        (algebraMap B (Localization.AtPrime 𝔫)))
      (algebraMap B (Localization.AtPrime 𝔫)
        (ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X i)))) ≠ 0 := by
    intro i hzero
    rw [Ideal.Quotient.eq_zero_iff_mem, ← RingHom.comp_assoc, ← Ideal.map_map] at hzero
    obtain ⟨s, hsP, hsx⟩ := genA _ (wcNpI W a) ρ hρ _ _ hzero
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective s
    exact hsP (Ideal.mem_comap.mp (kernel i p hsx))
  exact ⟨main 0, main 1⟩

theorem wcpa_dj_llsmg_np_not_smooth : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Y : Scheme.{u}) (uY : Y ⟶ Spec (.of ↥W)) (U : Y.Opens) (hU : IsAffineOpen U)
    (hle : U ≤ uY ⁻¹ᵁ ⊤) (R : Type u) [CommRing R] (e : ↑Γ(Y, U) ≃+* R) (ψ : ↥W →+* R),
    (∀ w, e ((uY.appLE ⊤ U hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) = ψ w) →
    ∀ (𝔫 : Ideal R) [𝔫.IsPrime] (u v : R), u * v ∈ (IsLocalRing.maximalIdeal ↥W).map ψ →
    Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map ψ).map
        (algebraMap R (Localization.AtPrime 𝔫))) (algebraMap R (Localization.AtPrime 𝔫) u) ≠ 0 →
    Ideal.Quotient.mk (((IsLocalRing.maximalIdeal ↥W).map ψ).map
        (algebraMap R (Localization.AtPrime 𝔫))) (algebraMap R (Localization.AtPrime 𝔫) v) ≠ 0 →
    ∀ (w : ↥(Limits.pullback uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))
      (h : Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w ∈ U),
      (hU.primeIdealOf ⟨_, h⟩).asIdeal = 𝔫.comap e →
      ¬ wcpaDjLkSmAt W uY w :=
by
  intro Ω _ W Y uY U hU hle R _ e ψ hψ 𝔫 _ u v huv hu hv w h hprime hSm
  classical

  obtain ⟨O, hwO, hsm⟩ := hSm
  haveI := hsm
  haveI hdomO : IsDomain (O.toScheme.presheaf.stalk ⟨w, hwO⟩) :=
    wcpa_smooth_stalk_isDomain (IsLocalRing.ResidueField ↥W) O.toScheme
      (O.ι ≫ Limits.pullback.snd uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) 1 ⟨w, hwO⟩
  haveI hdom : IsDomain ((Limits.pullback uY
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) :=
    MulEquiv.isDomain _ (Iso.commRingCatIsoToRingEquiv (O.stalkIso ⟨w, hwO⟩)).symm.toMulEquiv

  obtain ⟨hpt, -, -, hker, -⟩ := wcpa_dj_lr1k_lfnc_fibre_stalk_data (↥W) Y uY w
  have hPprime := RingHom.ker_isPrime ((Limits.pullback.fst uY
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).stalkMap w).hom

  have hmax3 : ∀ (p : ↥(Spec (.of ↥W))), p = IsLocalRing.closedPoint ↥W →
      ((IsLocalRing.maximalIdeal ↥W).map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫
        (Spec (.of ↥W)).presheaf.germ ⊤ p trivial).hom).IsMaximal := by
    rintro p rfl
    have hc : (Scheme.ΓSpecIso (.of ↥W)).inv ≫ (Spec (.of ↥W)).presheaf.germ ⊤
        (IsLocalRing.closedPoint ↥W) trivial = (stalkClosedPointIso (.of ↥W)).inv := by
      rw [← ΓSpecIso_hom_stalkClosedPointIso_inv, Iso.inv_hom_id_assoc]
    rw [hc]
    exact Ideal.map_isMaximal_of_equiv
      (Iso.commRingCatIsoToRingEquiv (stalkClosedPointIso (.of ↥W)).symm)
      (p := IsLocalRing.maximalIdeal ↥W)
  have s3 : ∀ (p : ↥(Spec (.of ↥W))), p = IsLocalRing.closedPoint ↥W →
      (IsLocalRing.maximalIdeal ↥W).map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫
        (Spec (.of ↥W)).presheaf.germ ⊤ p trivial).hom =
        IsLocalRing.maximalIdeal ↥((Spec (.of ↥W)).presheaf.stalk p) := fun p hp =>
    IsLocalRing.eq_maximalIdeal (hmax3 p hp)

  have s4 : ∀ s : ↑Γ(Spec (.of ↥W), ⊤),
      (uY.stalkMap (Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)).hom
        (((Spec (.of ↥W)).presheaf.germ ⊤ (uY (Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w))
          trivial).hom s) =
      (Y.presheaf.germ U _ h).hom ((uY.appLE ⊤ U hle).hom s) := by
    intro s
    erw [Scheme.Hom.germ_stalkMap_apply]
    rw [Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply]
    erw [TopCat.Presheaf.germ_res_apply]

  letI : Algebra ↑Γ(Y, U) ↑(Y.presheaf.stalk ((⟨_, h⟩ : ↥U) : ↥Y)) :=
    TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨_, h⟩
  haveI hloc := hU.isLocalization_stalk ⟨_, h⟩
  have H : Submonoid.map e.symm.toMonoidHom 𝔫.primeCompl =
      (hU.primeIdealOf ⟨_, h⟩).asIdeal.primeCompl := by
    ext z
    rw [Ideal.mem_primeCompl_iff, hprime, Ideal.mem_comap, Submonoid.mem_map]
    constructor
    · rintro ⟨r, hr, rfl⟩
      simpa using hr
    · intro hz
      exact ⟨e z, Ideal.mem_primeCompl_iff.mpr hz, by simp⟩
  obtain ⟨j, hjb, hj⟩ : ∃ j : Localization.AtPrime 𝔫 →+* ↑(Y.presheaf.stalk
      (Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)),
      Function.Bijective j ∧
      ∀ r : R, j (algebraMap R _ r) = (Y.presheaf.germ U _ h).hom (e.symm r) := by
    refine ⟨(IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔫)
      (Y.presheaf.stalk (⟨_, h⟩ : ↥U)) e.symm H : Localization.AtPrime 𝔫 →+* _),
      (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔫)
      (Y.presheaf.stalk (⟨_, h⟩ : ↥U)) e.symm H).bijective, ?_⟩
    intro r
    rw [RingEquiv.coe_toRingHom, IsLocalization.ringEquivOfRingEquiv_eq,
      TopCat.Presheaf.stalk_open_algebraMap]

  have hcomp1 : (uY.stalkMap (Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)).hom.comp
      ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ (Spec (.of ↥W)).presheaf.germ ⊤ (uY (Limits.pullback.fst uY
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w))
          trivial).hom =
      ((j.comp (algebraMap R (Localization.AtPrime 𝔫))).comp ψ) := by
    ext w'
    rw [RingHom.comp_apply, CommRingCat.hom_comp, RingHom.comp_apply, s4]
    rw [RingHom.comp_apply, RingHom.comp_apply, hj]
    congr 1
    exact (e.symm_apply_eq.mpr (hψ w').symm).symm
  have hPI : RingHom.ker ((Limits.pullback.fst uY
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).stalkMap w).hom =
      (((IsLocalRing.maximalIdeal ↥W).map ψ).map (algebraMap R (Localization.AtPrime 𝔫))).map j := by
    rw [hker, ← s3 _ hpt, Ideal.map_map, Ideal.map_map, Ideal.map_map, hcomp1]
  have hI : (((IsLocalRing.maximalIdeal ↥W).map ψ).map
      (algebraMap R (Localization.AtPrime 𝔫))).IsPrime := by
    rw [← Ideal.comap_map_of_bijective j hjb
      (I := ((IsLocalRing.maximalIdeal ↥W).map ψ).map (algebraMap R (Localization.AtPrime 𝔫))),
      ← hPI]
    exact Ideal.comap_isPrime _ _
  have hmem : algebraMap R (Localization.AtPrime 𝔫) u * algebraMap R (Localization.AtPrime 𝔫) v ∈
      ((IsLocalRing.maximalIdeal ↥W).map ψ).map (algebraMap R (Localization.AtPrime 𝔫)) := by
    rw [← map_mul]
    exact Ideal.mem_map_of_mem _ huv
  rcases hI.mem_or_mem hmem with h1 | h1
  · exact hu (Ideal.Quotient.eq_zero_iff_mem.mpr h1)
  · exact hv (Ideal.Quotient.eq_zero_iff_mem.mpr h1)

theorem wcpa_dj_llsmg_pt_norm_sections : ∀ (C X : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f], (∀ c : C, IsIntegrallyClosed (C.presheaf.stalk c)) → ∀ (V : X.Opens) (hV : IsAffineOpen V), IsAffineOpen (f ⁻¹ᵁ V) → ∀ (hgen : genericPoint C ∈ f ⁻¹ᵁ V) [Algebra ↑Γ(X, V) ↑C.functionField], algebraMap ↑Γ(X, V) ↑C.functionField = wcG2cKap f V hgen → ∃ e : ↑Γ(f.normalization, f.fromNormalization ⁻¹ᵁ V) ≃+* ↥(integralClosure ↑Γ(X, V) ↑C.functionField), ∀ a : ↑Γ(X, V), e ((f.fromNormalization.appLE V (f.fromNormalization ⁻¹ᵁ V) le_rfl).hom a) = algebraMap ↑Γ(X, V) ↥(integralClosure ↑Γ(X, V) ↑C.functionField) a :=
by
  intro C X _ f _ _ hnorm V hV hfV hgen _ hκ
  classical
  have hIC : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S],
      (∀ x : S, IsIntegrallyClosed (S.presheaf.stalk x)) →
      ∀ (U : S.Opens), IsAffineOpen U → Nonempty U → IsIntegrallyClosed Γ(S, U) := by
    intro S _ hst U hU hne
    haveI := hne
    have key : ∀ q : PrimeSpectrum Γ(S, U),
        IsIntegrallyClosed (Localization.AtPrime q.asIdeal) := by
      intro q
      have hqU' : hU.fromSpec q ∈ (U : Set S) := by
        rw [← hU.range_fromSpec]
        exact Set.mem_range_self q
      have hqU : hU.fromSpec q ∈ U := hqU'
      obtain ⟨x, hx⟩ : ∃ x : U, (x : S) = hU.fromSpec q := ⟨⟨_, hqU⟩, rfl⟩
      have hpx : hU.primeIdealOf x = q := by
        apply (Scheme.Hom.isOpenEmbedding hU.fromSpec).injective
        rw [hU.fromSpec_primeIdealOf x, hx]
      haveI := hU.isLocalization_stalk x
      haveI := hst (x : S)
      have h6 : IsIntegrallyClosed (Localization.AtPrime (hU.primeIdealOf x).asIdeal) :=
        IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv (hU.primeIdealOf x).asIdeal.primeCompl
          (S.presheaf.stalk (x : S)) (Localization.AtPrime (hU.primeIdealOf x).asIdeal)).toRingEquiv
      subst hpx
      exact h6
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hmax
    exact key ⟨p, hmax.isPrime⟩
  letI algAD : Algebra Γ(X, V) Γ(C, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  haveI hne : Nonempty (f ⁻¹ᵁ V) := ⟨⟨genericPoint C, hgen⟩⟩
  letI algDL : Algebra Γ(C, f ⁻¹ᵁ V) C.functionField :=
    (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom.toAlgebra
  haveI hfrac : IsFractionRing Γ(C, f ⁻¹ᵁ V) C.functionField :=
    functionField_isFractionRing_of_isAffineOpen C (f ⁻¹ᵁ V) hfV
  haveI hic : IsIntegrallyClosed Γ(C, f ⁻¹ᵁ V) :=
    hIC C hnorm (f ⁻¹ᵁ V) hfV hne
  haveI htow : IsScalarTower Γ(X, V) Γ(C, f ⁻¹ᵁ V) C.functionField := by
    refine IsScalarTower.of_algebraMap_eq (fun a => ?_)
    rw [hκ]
    rfl
  have hinj0 : Function.Injective (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom :=
    germ_injective_of_isIntegral C (genericPoint C) hgen
  let Ψ₀ : Γ(C, f ⁻¹ᵁ V) →ₐ[Γ(X, V)] C.functionField :=
    IsScalarTower.toAlgHom Γ(X, V) Γ(C, f ⁻¹ᵁ V) C.functionField
  have hΨ₀ : ∀ d, Ψ₀ d = (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom d := fun d => rfl
  have hinj : Function.Injective Ψ₀ := fun x y h => hinj0 (by rw [← hΨ₀, ← hΨ₀]; exact h)
  let Ψ : ↥(integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V)) →ₐ[Γ(X, V)]
      ↥(integralClosure Γ(X, V) C.functionField) :=
    (Ψ₀.comp (integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V)).val).codRestrict
      (integralClosure Γ(X, V) C.functionField)
      (fun x => (isIntegral_algHom_iff Ψ₀ hinj).mpr x.2)
  have hΨbij : Function.Bijective Ψ := by
    constructor
    · intro x y h
      apply Subtype.ext
      apply hinj
      exact congrArg Subtype.val h
    · rintro ⟨l, hl⟩
      have hl' : IsIntegral Γ(X, V) l := hl
      have hlD : IsIntegral Γ(C, f ⁻¹ᵁ V) l := hl'.tower_top
      obtain ⟨d, hd⟩ := IsIntegrallyClosed.isIntegral_iff.mp hlD
      have hdA : IsIntegral Γ(X, V) d := by
        apply (isIntegral_algHom_iff Ψ₀ hinj).mp
        have : Ψ₀ d = l := hd
        rw [this]; exact hl'
      exact ⟨⟨d, hdA⟩, Subtype.ext hd⟩
  let Ψe := AlgEquiv.ofBijective Ψ hΨbij
  let e₁ := (f.normalizationObjIso hV).commRingCatIsoToRingEquiv
  refine ⟨e₁.trans Ψe.toRingEquiv, fun a => ?_⟩
  have h1 : e₁ ((f.fromNormalization.appLE V (f.fromNormalization ⁻¹ᵁ V) le_rfl).hom a) =
      algebraMap Γ(X, V) ↥(integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V)) a := by
    rw [Scheme.Hom.appLE_eq_app, Scheme.Hom.fromNormalization_app]
    show (f.normalizationObjIso hV).hom.hom ((f.normalizationObjIso hV).inv.hom _) = _
    rw [← CommRingCat.comp_apply, Iso.inv_hom_id]
    rfl
  rw [RingEquiv.trans_apply, h1]
  exact Ψe.commutes a

theorem wcpa_dj_llsmg_fibre_stalk : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R L : Type u) [CommRing R] [Field L] [Algebra R L] (wR : ↥W →+* R) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)) (U : Y.Opens) (hle : U ≤ g ⁻¹ᵁ ⊤) (e : Γ(Y, U) ≃+* ↥(integralClosure R L)), (∀ s : ↥W, e ((g.appLE ⊤ U hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom s)) = algebraMap R ↥(integralClosure R L) (wR s)) → ∀ (w : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) (hw : Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w ∈ U) (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime] [Algebra ↥(integralClosure R L) ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w))], IsLocalization.AtPrime ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) 𝔮 → (∀ b : Γ(Y, U), algebraMap ↥(integralClosure R L) ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) (e b) = Y.presheaf.germ U (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) hw b) → Nonempty (↑((Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) ≃+* wcLlsFS W ((algebraMap R L).comp wR) R 𝔮) :=
by
  intro Ω _ W R L _ _ _ wR Y g U hle e hcomp w hw 𝔮 _ _ hloc hgerm
  classical
  obtain ⟨hcl, _θ, hsurj, hker, -⟩ := wcpa_dj_lr1k_lfnc_fibre_stalk_data (↥W) Y g w

  have hmax : ∀ (p : ↥(Spec (.of ↥W))), p = IsLocalRing.closedPoint ↥W →
      IsLocalRing.maximalIdeal ↑((Spec (.of ↥W)).presheaf.stalk p) =
      Ideal.map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫
        (Spec (.of ↥W)).presheaf.germ ⊤ p trivial).hom (IsLocalRing.maximalIdeal ↥W) := by
    rintro p rfl
    have h1 : (Scheme.ΓSpecIso (.of ↥W)).inv ≫
        (Spec (.of ↥W)).presheaf.germ ⊤ (IsLocalRing.closedPoint ↥W) trivial =
        (stalkClosedPointIso (.of ↥W)).inv := by
      rw [← ΓSpecIso_hom_stalkClosedPointIso_inv, Iso.inv_hom_id_assoc]
    rw [h1]
    let ε := (stalkClosedPointIso (.of ↥W)).symm.commRingCatIsoToRingEquiv
    have h2 : (stalkClosedPointIso (.of ↥W)).inv.hom = (ε : ↥W →+* _) := rfl
    rw [h2]
    have key : ∀ (S : Type u) [CommRing S] (hS : IsLocalRing S) (φ : ↥W ≃+* S),
        @IsLocalRing.maximalIdeal S _ hS = Ideal.map (φ : ↥W →+* S) (IsLocalRing.maximalIdeal ↥W) := by
      intro S _ hS φ
      symm
      apply IsLocalRing.eq_maximalIdeal
      exact Ideal.map_isMaximal_of_equiv φ
    exact key _ _ ε
  have hψ : ∀ s : ↥W, (algebraMap R ↥(integralClosure R L)).comp wR s =
      algebraMap R ↥(integralClosure R L) (wR s) := fun s => rfl

  have hRH : (g.stalkMap (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)).hom.comp ((Scheme.ΓSpecIso (.of ↥W)).inv ≫
      (Spec (.of ↥W)).presheaf.germ ⊤ (g (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) trivial).hom =
      (algebraMap ↥(integralClosure R L) ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w))).comp
        ((algebraMap R ↥(integralClosure R L)).comp wR) := by
    ext s
    have k1 := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom s))
      (Scheme.Hom.germ_stalkMap g ⊤ (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) trivial)
    have k2 : g.app ⊤ ≫ Y.presheaf.germ (g ⁻¹ᵁ ⊤) (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) (hle hw) =
        g.appLE ⊤ U hle ≫ Y.presheaf.germ U (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) hw := by
      rw [← Y.presheaf.germ_res (homOfLE hle) _ hw, ← Category.assoc, Scheme.Hom.app_eq_appLE,
        Scheme.Hom.appLE_map]
    have k3 := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom s)) k2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at k1 k3 ⊢
    refine k1.trans (k3.trans ((hgerm _).symm.trans ?_))
    rw [hcomp s]

  have hker' : RingHom.ker ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).stalkMap w).hom =
      Ideal.map ((algebraMap ↥(integralClosure R L) ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w))).comp
        ((algebraMap R ↥(integralClosure R L)).comp wR))
        (IsLocalRing.maximalIdeal ↥W) := by
    rw [hker, hmax _ hcl, Ideal.map_map, hRH]

  have hGset : {b : ↥(integralClosure R L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
      (b : L) = ((algebraMap R L).comp wR) x} =
      ⇑((algebraMap R ↥(integralClosure R L)).comp wR) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W) := by
    ext b
    constructor
    · rintro ⟨x, hx, hb⟩
      exact ⟨x, hx, Subtype.ext hb.symm⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨x, hx, rfl⟩
  have hG : Ideal.span {b : ↥(integralClosure R L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
      (b : L) = ((algebraMap R L).comp wR) x} =
      Ideal.map ((algebraMap R ↥(integralClosure R L)).comp wR) (IsLocalRing.maximalIdeal ↥W) := by
    rw [hGset]; rfl

  let ρ := @IsLocalization.algEquiv _ _ 𝔮.primeCompl ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) _ _ hloc
    (Localization.AtPrime 𝔮) _ _ _
  have hρ : (ρ.toRingEquiv : ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) →+* Localization.AtPrime 𝔮).comp
      (algebraMap ↥(integralClosure R L) ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w))) =
      algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮) :=
    RingHom.ext fun b => ρ.commutes b
  have hI : Ideal.map (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮))
      (Ideal.span {b : ↥(integralClosure R L) | ∃ x ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = ((algebraMap R L).comp wR) x}) =
      Ideal.map (ρ.toRingEquiv : ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) →+* Localization.AtPrime 𝔮)
        (Ideal.map ((algebraMap ↥(integralClosure R L) ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w))).comp
          ((algebraMap R ↥(integralClosure R L)).comp wR))
          (IsLocalRing.maximalIdeal ↥W)) := by
    rw [Ideal.map_map, ← RingHom.comp_assoc, hρ, hG, Ideal.map_map]
  exact ⟨((RingHom.quotientKerEquivOfSurjective hsurj).symm.trans
    (Ideal.quotEquivOfEq hker')).trans (Ideal.quotientEquiv _ _ ρ.toRingEquiv hI)⟩

theorem wcpa_dj_llsmg_np_norm_points : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (C Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral C],
    (∀ c : C, IsIntegrallyClosed (C.presheaf.stalk c)) →
    ∀ (uY : Y ⟶ Spec (.of ↥W)) (f : C ⟶ Y) [QuasiCompact f] [QuasiSeparated f]
      (U' : Y.Opens) (hU' : IsAffineOpen U'), IsAffineOpen (f ⁻¹ᵁ U') →
    ∀ (hgen' : genericPoint C ∈ f ⁻¹ᵁ U') (hle : U' ≤ uY ⁻¹ᵁ ⊤)
      (R : Type u) [CommRing R] [Algebra R ↑C.functionField] (e' : ↑Γ(Y, U') ≃+* R),
      (∀ y, algebraMap R ↑C.functionField (e' y) = wcG2cKap f U' hgen' y) →
    ∀ (ψ : ↥W →+* R),
      (∀ w, e' ((uY.appLE ⊤ U' hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) = ψ w) →
    ∀ (wL : ↥W →+* ↑C.functionField), (∀ w, wL w = algebraMap R ↑C.functionField (ψ w)) →
    ∀ (𝔮 : Ideal ↥(integralClosure R ↑C.functionField)) [𝔮.IsPrime],
      (IsLocalRing.maximalIdeal ↥W).map
        ((algebraMap R ↥(integralClosure R ↑C.functionField)).comp ψ) ≤ 𝔮 →
      ∃ (y' : ↥(wcpaDjLkFib W f uY)) (h : wcpaDjLkImg W f uY y' ∈ U'),
        (hU'.primeIdealOf ⟨_, h⟩).asIdeal =
          (𝔮.comap (algebraMap R ↥(integralClosure R ↑C.functionField))).comap e' ∧
        Nonempty (↑((wcpaDjLkFib W f uY).presheaf.stalk y') ≃+* wcLlsFS W wL R 𝔮) :=
by
  classical
  intro Ω _ W C Y _ hCnorm uY f _ _ U' hU' hfaff hgen' hle R _ _ e' hkap ψ hψ wL hwL 𝔮 _ hm
  have hwL' : wL = (algebraMap R ↑C.functionField).comp ψ := RingHom.ext hwL
  subst hwL'

  have s1 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (x : ↥X) (hx : x ∈ U)
      (b : ↑Γ(X, U)), b ∈ (hU.primeIdealOf ⟨x, hx⟩).asIdeal ↔ x ∉ X.basicOpen b := by
    intro X U hU x hx b
    have h1 : hU.primeIdealOf ⟨x, hx⟩ ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen b ↔
        hU.fromSpec (hU.primeIdealOf ⟨x, hx⟩) ∈ X.basicOpen b := Iff.rfl
    rw [hU.fromSpec_preimage_basicOpen, hU.fromSpec_primeIdealOf] at h1
    have h2 : b ∉ (hU.primeIdealOf ⟨x, hx⟩).asIdeal ↔ x ∈ X.basicOpen b := h1
    rw [← h2, not_not]
  have s1b : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (p : PrimeSpectrum ↑Γ(X, U))
      (x : ↥X) (hx : x ∈ U), hU.fromSpec p = x → hU.primeIdealOf ⟨x, hx⟩ = p := by
    intro X U hU p x hx hpx
    have key : ∀ (b : ↑Γ(X, U)), b ∈ p.asIdeal ↔ hU.fromSpec p ∉ X.basicOpen b := fun b => by
      have h1 : p ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen b ↔ hU.fromSpec p ∈ X.basicOpen b := Iff.rfl
      rw [hU.fromSpec_preimage_basicOpen] at h1
      have h2 : b ∉ p.asIdeal ↔ hU.fromSpec p ∈ X.basicOpen b := h1
      rw [← h2, not_not]
    apply PrimeSpectrum.ext
    ext b
    rw [s1, key, hpx]

  letI iAL : Algebra ↑Γ(Y, U') ↑C.functionField := (wcG2cKap f U' hgen').toAlgebra
  obtain ⟨Ψ₀, hΨ₀⟩ := wcpa_dj_llsmg_pt_norm_sections C Y f hCnorm U' hU' hfaff hgen' rfl

  have h₁ : (algebraMap R ↑C.functionField).comp e'.toRingHom =
      algebraMap ↑Γ(Y, U') ↑C.functionField := RingHom.ext fun a => hkap a
  have h₂ : (algebraMap ↑Γ(Y, U') ↑C.functionField).comp e'.symm.toRingHom =
      algebraMap R ↑C.functionField := RingHom.ext fun r => by
    show wcG2cKap f U' hgen' (e'.symm r) = _
    rw [← hkap, RingEquiv.apply_symm_apply]
  have hAR : ∀ x : ↑C.functionField, IsIntegral ↑Γ(Y, U') x → IsIntegral R x := by
    rintro x ⟨p, hp, hpx⟩
    refine ⟨p.map e'.toRingHom, hp.map _, ?_⟩
    rw [Polynomial.eval₂_map, h₁]; exact hpx
  have hRA : ∀ x : ↑C.functionField, IsIntegral R x → IsIntegral ↑Γ(Y, U') x := by
    rintro x ⟨p, hp, hpx⟩
    refine ⟨p.map e'.symm.toRingHom, hp.map _, ?_⟩
    rw [Polynomial.eval₂_map, h₂]; exact hpx
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ↥(integralClosure ↑Γ(Y, U') ↑C.functionField) ≃+*
      ↥(integralClosure R ↑C.functionField),
      ∀ x, ((Φ x : ↥(integralClosure R ↑C.functionField)) : ↑C.functionField) = x :=
    ⟨{ toFun := fun x => ⟨x.1, hAR x.1 x.2⟩
       invFun := fun y => ⟨y.1, hRA y.1 y.2⟩
       left_inv := fun _ => rfl
       right_inv := fun _ => rfl
       map_mul' := fun _ _ => rfl
       map_add' := fun _ _ => rfl }, fun _ => rfl⟩
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ↑Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U') ≃+*
      ↥(integralClosure R ↑C.functionField),
      ∀ a : ↑Γ(Y, U'), Ψ ((f.fromNormalization.appLE U' (f.fromNormalization ⁻¹ᵁ U') le_rfl).hom a)
        = algebraMap R ↥(integralClosure R ↑C.functionField) (e' a) := by
    refine ⟨Ψ₀.trans Φ, fun a => ?_⟩
    apply Subtype.ext
    rw [RingEquiv.trans_apply, hΦ, hΨ₀ a]
    exact (hkap a).symm

  have hŨ : IsAffineOpen (f.fromNormalization ⁻¹ᵁ U') := hU'.preimage f.fromNormalization
  have hleŨ : f.fromNormalization ⁻¹ᵁ U' ≤ (f.fromNormalization ≫ uY) ⁻¹ᵁ ⊤ := by
    rw [Scheme.Hom.preimage_top]; exact le_top
  have hgψ : ∀ s : ↥W, Ψ (((f.fromNormalization ≫ uY).appLE ⊤ (f.fromNormalization ⁻¹ᵁ U')
      hleŨ).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom s)) =
      algebraMap R ↥(integralClosure R ↑C.functionField) (ψ s) := by
    intro s
    rw [← Scheme.Hom.appLE_comp_appLE f.fromNormalization uY ⊤ U' (f.fromNormalization ⁻¹ᵁ U')
      hle le_rfl, CommRingCat.hom_comp, RingHom.comp_apply, hΨ, hψ]

  obtain ⟨P, hP⟩ : ∃ P : PrimeSpectrum ↑Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U'),
      P.asIdeal = Ideal.comap Ψ 𝔮 := ⟨⟨_, Ideal.IsPrime.comap Ψ⟩, rfl⟩
  obtain ⟨z, hzP⟩ : ∃ z, hŨ.fromSpec P = z := ⟨_, rfl⟩
  have hz : z ∈ f.fromNormalization ⁻¹ᵁ U' := by
    have h0 : z ∈ Set.range hŨ.fromSpec := ⟨P, hzP⟩
    rw [hŨ.range_fromSpec] at h0
    exact h0
  have hPz : hŨ.primeIdealOf ⟨z, hz⟩ = P := s1b _ _ hŨ P z hz hzP

  have hmz : IsLocalRing.maximalIdeal ↥W ≤ ((f.fromNormalization ≫ uY) z).asIdeal := by
    intro a ha
    have hmem : ((f.fromNormalization ≫ uY).appLE ⊤ (f.fromNormalization ⁻¹ᵁ U') hleŨ).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) ∈ (hŨ.primeIdealOf ⟨z, hz⟩).asIdeal := by
      rw [hPz, hP, Ideal.mem_comap, hgψ]
      exact hm (Ideal.mem_map_of_mem _ ha)
    rw [s1, Scheme.basicOpen_appLE] at hmem
    have h3 : (f.fromNormalization ≫ uY) z ∉
        (Spec (.of ↥W)).basicOpen ((Scheme.ΓSpecIso (.of ↥W)).inv a) := fun h =>
      hmem (TopologicalSpace.Opens.mem_inf.mpr ⟨hz, h⟩)
    rw [basicOpen_eq_of_affine] at h3
    exact not_not.mp h3
  have hcl : (f.fromNormalization ≫ uY) z = IsLocalRing.closedPoint ↥W := by
    apply PrimeSpectrum.ext
    exact ((IsLocalRing.maximalIdeal.isMaximal ↥W).eq_of_le
      (PrimeSpectrum.isPrime _).ne_top hmz).symm

  obtain ⟨y', hy'⟩ := (wcpa_dj_p1g_cf_fibre_stalk ↥W f.normalization (f.fromNormalization ≫ uY)).1
    z hcl
  have hImg : wcpaDjLkImg W f uY y' = f.fromNormalization (Limits.pullback.fst
      (f.fromNormalization ≫ uY)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y') := by
    simp only [wcpaDjLkImg, wcpaDjLkPi, ← Scheme.Hom.comp_apply, Limits.pullback.lift_fst,
      Limits.pullback.map]
  have h : wcpaDjLkImg W f uY y' ∈ U' := by
    rw [hImg, hy']; exact hz
  have hw : Limits.pullback.fst (f.fromNormalization ≫ uY)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y' ∈
      f.fromNormalization ⁻¹ᵁ U' := by
    rw [hy']; exact hz
  refine ⟨y', h, ?_, ?_⟩
  ·
    have hfs : hU'.fromSpec (Spec.map (f.fromNormalization.appLE U' (f.fromNormalization ⁻¹ᵁ U')
        le_rfl) P) = wcpaDjLkImg W f uY y' := by
      have h2 : ∀ p : ↥(Spec Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U')),
          hU'.fromSpec (Spec.map (f.fromNormalization.appLE U' (f.fromNormalization ⁻¹ᵁ U')
            le_rfl) p) = f.fromNormalization (hŨ.fromSpec p) := fun p =>
        congrArg (fun h' : Spec Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U') ⟶ Y => h' p)
          (IsAffineOpen.SpecMap_appLE_fromSpec f.fromNormalization hU' hŨ le_rfl)
      exact (h2 P).trans (by rw [hImg, hy', ← hzP])
    rw [s1b Y U' hU' _ _ h hfs]
    ext a
    show (f.fromNormalization.appLE U' (f.fromNormalization ⁻¹ᵁ U') le_rfl).hom a ∈ P.asIdeal ↔ _
    rw [hP]
    simp only [Ideal.mem_comap, hΨ]
  ·
    have hPw : hŨ.primeIdealOf ⟨_, hw⟩ = P := s1b _ _ hŨ P _ hw (hzP.trans hy'.symm)
    have hmemP : ∀ s, s ∈ (hŨ.primeIdealOf ⟨_, hw⟩).asIdeal ↔ Ψ s ∈ 𝔮 := fun s => by
      rw [hPw, hP, Ideal.mem_comap]
    haveI h0 := hŨ.isLocalization_stalk ⟨_, hw⟩
    letI iBO : Algebra ↥(integralClosure R ↑C.functionField)
        ↑(f.normalization.presheaf.stalk (Limits.pullback.fst (f.fromNormalization ≫ uY)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y')) :=
      ((f.normalization.presheaf.germ (f.fromNormalization ⁻¹ᵁ U') _ hw).hom.comp
        Ψ.symm.toRingHom).toAlgebra
    have hc' : ∀ b : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U'),
        algebraMap ↥(integralClosure R ↑C.functionField)
          ↑(f.normalization.presheaf.stalk (Limits.pullback.fst (f.fromNormalization ≫ uY)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y'))
          (Ψ b) = f.normalization.presheaf.germ (f.fromNormalization ⁻¹ᵁ U')
            (Limits.pullback.fst (f.fromNormalization ≫ uY)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y') hw b := by
      intro b
      show (f.normalization.presheaf.germ (f.fromNormalization ⁻¹ᵁ U') _ hw).hom (Ψ.symm (Ψ b)) =
        (f.normalization.presheaf.germ (f.fromNormalization ⁻¹ᵁ U') _ hw).hom b
      exact congrArg _ (Ψ.symm_apply_apply b)
    have s4 : ∀ (S T O : Type u) [CommRing S] [CommRing T] [CommRing O] {iSO : Algebra S O}
        {iTO : Algebra T O} (Ψ : S ≃+* T), (∀ s, algebraMap T O (Ψ s) = algebraMap S O s) →
        ∀ (P : Ideal S) [P.IsPrime] (𝔮 : Ideal T) [𝔮.IsPrime], (∀ s, s ∈ P ↔ Ψ s ∈ 𝔮) →
        IsLocalization.AtPrime O P → IsLocalization.AtPrime O 𝔮 := by
      intro S T O _ _ _ iSO iTO Ψ hc P _ 𝔮 _ hPq hl
      have hc2 : ∀ t, algebraMap T O t = algebraMap S O (Ψ.symm t) := fun t => by
        rw [← hc, RingEquiv.apply_symm_apply]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨t, ht⟩
        have hpc : Ψ.symm t ∈ P.primeCompl := by
          intro hmem
          have h5 := (hPq _).mp hmem
          rw [RingEquiv.apply_symm_apply] at h5
          exact ht h5
        show IsUnit (algebraMap T O t)
        rw [hc2]
        exact IsLocalization.map_units (M := P.primeCompl) O ⟨Ψ.symm t, hpc⟩
      · intro zz
        obtain ⟨⟨s, p⟩, hsp⟩ := IsLocalization.surj P.primeCompl zz
        have hp : Ψ p.1 ∈ 𝔮.primeCompl := fun hmem => p.2 ((hPq _).mpr hmem)
        refine ⟨⟨Ψ s, ⟨Ψ p.1, hp⟩⟩, ?_⟩
        show zz * algebraMap T O (Ψ p.1) = algebraMap T O (Ψ s)
        rw [hc, hc]
