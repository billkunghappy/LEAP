theorem wcpa_dj_lr1k_llfi_ringequiv : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) → wcpaDjLkDelta R = wcpaDjLkDelta S ∧ wcpaDjLkBranches R = wcpaDjLkBranches S :=
by
  intro R S _ _ e
  classical
  let eF : FractionRing R ≃+* FractionRing S := IsFractionRing.ringEquivOfRingEquiv e
  have H1 : ∀ r : R, eF (algebraMap R (FractionRing R) r) = algebraMap S (FractionRing S) (e r) :=
    fun r => IsFractionRing.ringEquivOfRingEquiv_algebraMap e r
  have H2 : ∀ s : S, eF.symm (algebraMap S (FractionRing S) s) =
      algebraMap R (FractionRing R) (e.symm s) := by
    intro s
    rw [RingEquiv.symm_apply_eq, H1, RingEquiv.apply_symm_apply]
  have C1 : (algebraMap S (FractionRing S)).comp (e : R →+* S) =
      (eF : FractionRing R →+* FractionRing S).comp (algebraMap R (FractionRing R)) := by
    ext r
    simp only [RingHom.comp_apply, RingHom.coe_coe]
    exact (H1 r).symm
  have C2 : (algebraMap R (FractionRing R)).comp (e.symm : S →+* R) =
      (eF.symm : FractionRing S →+* FractionRing R).comp (algebraMap S (FractionRing S)) := by
    ext s
    simp only [RingHom.comp_apply, RingHom.coe_coe]
    exact (H2 s).symm
  have I1 : ∀ x : FractionRing R, _root_.IsIntegral R x → _root_.IsIntegral S (eF x) := fun x hx =>
    hx.map_of_comp_eq (e : R →+* S) (eF : FractionRing R →+* FractionRing S) C1
  have I2 : ∀ y : FractionRing S, _root_.IsIntegral S y → _root_.IsIntegral R (eF.symm y) := fun y hy =>
    hy.map_of_comp_eq (e.symm : S →+* R) (eF.symm : FractionRing S →+* FractionRing R) C2
  let eI : ↥(integralClosure R (FractionRing R)) ≃+* ↥(integralClosure S (FractionRing S)) :=
    { toFun := fun x => ⟨eF x, I1 x x.2⟩
      invFun := fun y => ⟨eF.symm y, I2 y y.2⟩
      left_inv := fun x => Subtype.ext (eF.symm_apply_apply x)
      right_inv := fun y => Subtype.ext (eF.apply_symm_apply y)
      map_mul' := fun x y => Subtype.ext (map_mul eF (x : FractionRing R) y)
      map_add' := fun x y => Subtype.ext (map_add eF (x : FractionRing R) y) }
  have heI : ∀ r : R, eI (algebraMap R _ r) = algebraMap S _ (e r) := fun r => Subtype.ext (H1 r)
  have heI' : ∀ s : S, eI.symm (algebraMap S _ s) = algebraMap R _ (e.symm s) := by
    intro s
    rw [RingEquiv.symm_apply_eq, heI, RingEquiv.apply_symm_apply]
  constructor
  · letI : RingHomInvPair (e : R →+* S) (e.symm : S →+* R) := RingHomInvPair.of_ringEquiv e
    letI : RingHomInvPair (e.symm : S →+* R) (e : R →+* S) := RingHomInvPair.symm _ _
    let LeI : ↥(integralClosure R (FractionRing R)) →ₛₗ[(e : R →+* S)]
        ↥(integralClosure S (FractionRing S)) :=
      { toFun := eI
        map_add' := map_add eI
        map_smul' := fun r a => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI]
          rfl }
    let LeI' : ↥(integralClosure S (FractionRing S)) →ₛₗ[(e.symm : S →+* R)]
        ↥(integralClosure R (FractionRing R)) :=
      { toFun := eI.symm
        map_add' := map_add eI.symm
        map_smul' := fun s b => by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, heI']
          rfl }
    let p := LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))
    let q := LinearMap.range (Algebra.linearMap S ↥(integralClosure S (FractionRing S)))
    have h1 : p ≤ q.comap LeI := by
      rintro _ ⟨r, rfl⟩
      exact ⟨e r, (heI r).symm⟩
    have h2 : q ≤ p.comap LeI' := by
      rintro _ ⟨s, rfl⟩
      exact ⟨e.symm s, (heI' s).symm⟩
    let Φ := p.mapQ q LeI h1
    let Φ' := q.mapQ p LeI' h2
    let Φe : (↥(integralClosure R (FractionRing R)) ⧸ p) ≃ₛₗ[(e : R →+* S)]
        (↥(integralClosure S (FractionRing S)) ⧸ q) :=
      { Φ with
        invFun := Φ'
        left_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H a =>
            show Φ' (Φ (Submodule.Quotient.mk a)) = Submodule.Quotient.mk a
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.symm_apply_apply a)
        right_inv := fun x => by
          induction x using Submodule.Quotient.induction_on with
          | H b =>
            show Φ (Φ' (Submodule.Quotient.mk b)) = Submodule.Quotient.mk b
            rw [Submodule.mapQ_apply, Submodule.mapQ_apply]
            exact congrArg _ (eI.apply_symm_apply b) }
    let O := Submodule.orderIsoMapComap Φe
    unfold wcpaDjLkDelta
    rw [Module.length_eq_height, Module.length_eq_height, ← Order.height_orderIso O ⊤,
      OrderIso.map_top]
  · unfold wcpaDjLkBranches
    apply ENat.card_congr
    exact
      { toFun := fun M => ⟨M.asIdeal.comap (eI.symm : _ →+* _), by
          haveI := M.isMaximal
          exact Ideal.comap_isMaximal_of_surjective _ eI.symm.surjective⟩
        invFun := fun N => ⟨N.asIdeal.comap (eI : _ →+* _), by
          haveI := N.isMaximal
          exact Ideal.comap_isMaximal_of_surjective _ eI.surjective⟩
        left_inv := fun M => by
          ext x
          show eI.symm (eI x) ∈ M.asIdeal ↔ x ∈ M.asIdeal
          rw [RingEquiv.symm_apply_apply]
        right_inv := fun N => by
          ext x
          show eI (eI.symm x) ∈ N.asIdeal ↔ x ∈ N.asIdeal
          rw [RingEquiv.apply_symm_apply] }

theorem wcpa_dj_llsmg_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ →
