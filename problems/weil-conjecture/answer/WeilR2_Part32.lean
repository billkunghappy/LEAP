        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C y) (by rw [hmul]; exact hf)
      have hd₁ : (f /ₘ (Polynomial.X - Polynomial.C y)).natDegree = n := by
        rw [Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C y),
          Polynomial.natDegree_X_sub_C, hd]
        simp
      obtain ⟨r₁, hr₁⟩ := ih _ hf₁ hd₁
      refine ⟨y ::ₘ r₁, ?_⟩
      rw [Multiset.map_cons, Multiset.prod_cons, ← hr₁, hmul]
  have c2 : ∀ (W : Type u) [CommRing W] [IsLocalRing W] (T : Type u) [CommRing T] [Algebra W T]
      (a : T) (r : Multiset W),
      Polynomial.aeval a (r.map (fun α => Polynomial.X - Polynomial.C α)).prod = 0 →
      ∃ e : T, IsIdempotentElem e ∧ (∃ q : Polynomial W, a * Polynomial.aeval a q * e = e) ∧
        ∀ 𝔮 : Ideal T, 𝔮.IsPrime → Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W) ≤ 𝔮 →
          (e ∉ 𝔮 ↔ a ∉ 𝔮) := by
    intro W _ _ T _ _ a r hF
    classical
    obtain ⟨r₀, r₁, hr, h₀, h₁⟩ : ∃ r₀ r₁ : Multiset W, r₀ + r₁ = r ∧
