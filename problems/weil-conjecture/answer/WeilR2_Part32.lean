  intro Ω K _ _ W φ t x ϖ α β γ δ H0 hdet HM hϖ H1 H2

  have polyId : ∀ (y : K) (a b c d : Ω) (p q : Polynomial ↥W),
      y * (φ c * t + φ d) = φ a * t + φ b →
      y * q.eval₂ (φ.comp W.subtype) t = p.eval₂ (φ.comp W.subtype) t →
      (Polynomial.C a * Polynomial.X + Polynomial.C b) * q.map W.subtype =
        (Polynomial.C c * Polynomial.X + Polynomial.C d) * p.map W.subtype := by
    intro y a b c d p q hM hq
    rw [← sub_eq_zero]
    apply H0
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_mul, Polynomial.eval₂_map,
      Polynomial.eval₂_map]
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X]
    linear_combination (-(q.eval₂ (φ.comp W.subtype) t)) * hM + (φ c * t + φ d) * hq

  have unitEval : ∀ (q : Polynomial ↥W) (τ : ↥W), IsUnit (q.coeff 0) →
      τ ∈ IsLocalRing.maximalIdeal ↥W → IsUnit (q.eval τ) := by
    intro q τ hq hτ
    by_contra hne
    obtain ⟨k, hk⟩ := Polynomial.sub_dvd_eval_sub τ 0 q
    have h1 : q.eval τ ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hne
    have h2 : q.coeff 0 = q.eval τ - (τ - 0) * k := by
      rw [Polynomial.coeff_zero_eq_eval_zero, ← hk]; ring
    have h3 : q.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [h2]
      exact Ideal.sub_mem _ h1 (Ideal.mul_mem_right _ _ (by rw [sub_zero]; exact hτ))
    exact (IsLocalRing.notMem_maximalIdeal.mpr hq) h3

  have poleBound : ∀ (a b c d : Ω) (p q : Polynomial ↥W), a * d - b * c ≠ 0 →
      IsUnit (q.coeff 0) → p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W →
      (Polynomial.C a * Polynomial.X + Polynomial.C b) * q.map W.subtype =
        (Polynomial.C c * Polynomial.X + Polynomial.C d) * p.map W.subtype →
      d ≠ 0 ∧ c / d ∈ W ∧ ∃ e : ↥W, (e : Ω) = b / d ∧ e ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a b c d p q hdet' hq hp hE
    have h0 : b * (q.coeff 0 : Ω) = d * (p.coeff 0 : Ω) := by
      have := congrArg (fun r => r.coeff 0) hE
      simpa [Polynomial.mul_coeff_zero, Polynomial.coeff_map] using this
    have hQ0 : (q.coeff 0 : Ω) ≠ 0 := fun h => hq.ne_zero (by exact_mod_cast h)
    have hd : d ≠ 0 := by
      intro hd0
      rw [hd0, zero_mul] at h0
      have hb : b = 0 := (mul_eq_zero.mp h0).resolve_right hQ0
      apply hdet'; rw [hd0, hb]; ring
    refine ⟨hd, ?_, ⟨p.coeff 0 * ↑(hq.unit⁻¹), ?_, Ideal.mul_mem_right _ _ hp⟩⟩
    · by_contra hcd
      have hc : c ≠ 0 := by
        intro hc0; apply hcd; rw [hc0, zero_div]; exact W.zero_mem
      have hdc : d / c ∈ W := by
        have := W.mem_or_inv_mem (c / d)
        rw [inv_div] at this
        exact this.resolve_left hcd
      have hcc : c * c⁻¹ = 1 := mul_inv_cancel₀ hc
      have hσm : (⟨d / c, hdc⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra hσn
        have hσu : IsUnit (⟨d / c, hdc⟩ : ↥W) := IsLocalRing.notMem_maximalIdeal.mp hσn
        apply hcd
        have h1 : ((hσu.unit⁻¹ : (↥W)ˣ) : ↥W) * ⟨d / c, hdc⟩ = 1 := hσu.val_inv_mul
        have h2 : (((hσu.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω) * (d / c) = 1 := congrArg Subtype.val h1
        have h3 : c / d = (((hσu.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω) :=
          calc c / d = (d / c)⁻¹ := (inv_div d c).symm
            _ = _ := (eq_inv_of_mul_eq_one_left h2).symm
        rw [h3]; exact SetLike.coe_mem _
      have hτm : -(⟨d / c, hdc⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := (Ideal.neg_mem_iff _).mpr hσm
      have hev := congrArg (Polynomial.eval ((-(⟨d / c, hdc⟩ : ↥W) : ↥W) : Ω)) hE
      simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_X,
        Polynomial.eval_map] at hev
      have hτ : ((-(⟨d / c, hdc⟩ : ↥W) : ↥W) : Ω) = -(d * c⁻¹) := by
        rw [← div_eq_mul_inv]; rfl
      have hz : c * ((-(⟨d / c, hdc⟩ : ↥W) : ↥W) : Ω) + d = 0 := by
        rw [hτ]; linear_combination (-d) * hcc
      have hnz : a * ((-(⟨d / c, hdc⟩ : ↥W) : ↥W) : Ω) + b ≠ 0 := by
        rw [hτ]; intro h; apply hdet'
        linear_combination (-c) * h - (a * d) * hcc
      have hqz : q.eval₂ W.subtype ((-(⟨d / c, hdc⟩ : ↥W) : ↥W) : Ω) ≠ 0 := by
        have e : q.eval₂ W.subtype ((-(⟨d / c, hdc⟩ : ↥W) : ↥W) : Ω) =
            ((q.eval (-(⟨d / c, hdc⟩ : ↥W)) : ↥W) : Ω) :=
          Polynomial.eval₂_at_apply (p := q) W.subtype (-(⟨d / c, hdc⟩ : ↥W))
        rw [e]; intro h
        exact (unitEval q _ hq hτm).ne_zero (by exact_mod_cast h)
      rw [hz, zero_mul] at hev
      exact mul_ne_zero hnz hqz hev
    · have hu : (((hq.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω) * (q.coeff 0 : Ω) = 1 :=
        congrArg Subtype.val hq.val_inv_mul
      have hdd : d * d⁻¹ = 1 := mul_inv_cancel₀ hd
      show (p.coeff 0 : Ω) * (((hq.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω) = b / d
      rw [div_eq_mul_inv]
      linear_combination (-((((hq.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω) * d⁻¹)) * h0
        + (b * d⁻¹) * hu - ((p.coeff 0 : Ω) * (((hq.unit⁻¹ : (↥W)ˣ) : ↥W) : Ω)) * hdd

  obtain ⟨p, q, hq0, hp0, hxq⟩ := H1
  obtain ⟨p', q', hq0', hp0', hyq⟩ := H2
  have hϖ' : (ϖ : Ω) ≠ 0 := fun h => hϖ (by exact_mod_cast h)
  have hE := polyId x α β γ δ p q HM hxq
  obtain ⟨hδ, hg, c, hc, hcm⟩ := poleBound α β γ δ p q hdet hq0 hp0 hE

  have hx : x ≠ 0 := by
    intro hx0
    rw [hx0, zero_mul] at HM
    have h := H0 (Polynomial.C α * Polynomial.X + Polynomial.C β) (by
      simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
        Polynomial.eval₂_X]
      exact HM.symm)
    have hα : α = 0 := by
      have := congrArg (fun r => r.coeff 1) h
      simpa using this
    have hβ : β = 0 := by
      have := congrArg (fun r => r.coeff 0) h
      simpa using this
    apply hdet; rw [hα, hβ]; ring
  have HMy : (φ (ϖ : Ω) * x⁻¹) * (φ α * t + φ β) =
      φ ((ϖ : Ω) * γ) * t + φ ((ϖ : Ω) * δ) := by
    rw [← HM, map_mul, map_mul]
    have hxx : x⁻¹ * x = 1 := inv_mul_cancel₀ hx
    linear_combination (φ (ϖ : Ω) * (φ γ * t + φ δ)) * hxx
  have hE' := polyId _ _ _ _ _ p' q' HMy hyq
  have hdet' : (ϖ : Ω) * γ * β - (ϖ : Ω) * δ * α ≠ 0 := by
    have e : (ϖ : Ω) * γ * β - (ϖ : Ω) * δ * α = -((ϖ : Ω) * (α * δ - β * γ)) := by ring
    rw [e]; exact neg_ne_zero.mpr (mul_ne_zero hϖ' hdet)
  obtain ⟨hβ, hf, -⟩ := poleBound _ _ _ _ p' q' hdet' hq0' hp0' hE'
  have hbb : β * β⁻¹ = 1 := mul_inv_cancel₀ hβ
  have hdd : δ * δ⁻¹ = 1 := mul_inv_cancel₀ hδ
  refine ⟨c, ⟨γ / δ, hg⟩, ⟨α / β - γ / δ, W.sub_mem hf hg⟩, hcm, ?_, ?_, ?_⟩
  · intro h0
    have h1 : (c : Ω) = 0 := by rw [h0]; rfl
    rw [hc] at h1
    exact div_ne_zero hβ hδ h1
  · intro h0
    have h1 : α / β - γ / δ = 0 := congrArg Subtype.val h0
    apply hdet
    rw [div_eq_mul_inv, div_eq_mul_inv] at h1
    linear_combination (β * δ) * h1 - (α * δ) * hbb + (β * γ) * hdd
  · show x * (1 + φ (γ / δ) * t) = φ (c : Ω) * (1 + φ (γ / δ + (α / β - γ / δ)) * t)
    have e1 : γ / δ + (α / β - γ / δ) = α / β := by ring
    rw [e1, hc, map_div₀, map_div₀, map_div₀, div_eq_mul_inv, div_eq_mul_inv, div_eq_mul_inv]
    have hφd : φ δ * (φ δ)⁻¹ = 1 := mul_inv_cancel₀ (map_ne_zero φ |>.mpr hδ)
    have hφb : φ β * (φ β)⁻¹ = 1 := mul_inv_cancel₀ (map_ne_zero φ |>.mpr hβ)
    linear_combination (φ δ)⁻¹ * HM - x * hφd - (φ α * t * (φ δ)⁻¹) * hφb

theorem wcpa_dj_lr1k_ebc_dad_recoord : ∀ (Ω K : Type u) [Field Ω] [Field K]
    (W : ValuationSubring Ω) (φ : Ω →+* K) (O : Type u) [CommRing O] [IsLocalRing O]
    (G : O →+* K) (t : K) (g : ↥W),
    (∀ p : Polynomial Ω, p.eval₂ φ t = 0 → p = 0) → 1 + φ (g : Ω) * t ≠ 0 →
    (∀ c : O, ∃ p q : Polynomial ↥W, IsUnit (q.coeff 0) ∧
      (c ∈ IsLocalRing.maximalIdeal O → p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W) ∧
      G c * q.eval₂ (φ.comp W.subtype) t = p.eval₂ (φ.comp W.subtype) t) →
    (∀ p : Polynomial Ω, p.eval₂ φ (t * (1 + φ (g : Ω) * t)⁻¹) = 0 → p = 0) ∧
    (∀ c : O, ∃ p q : Polynomial ↥W, IsUnit (q.coeff 0) ∧
      (c ∈ IsLocalRing.maximalIdeal O → p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W) ∧
      G c * q.eval₂ (φ.comp W.subtype) (t * (1 + φ (g : Ω) * t)⁻¹) =
        p.eval₂ (φ.comp W.subtype) (t * (1 + φ (g : Ω) * t)⁻¹)) :=
by
  intro Ω K _ _ W φ O _ _ G t g hT hD hFr
  have hDu : (1 + φ (g : Ω) * t) * (1 + φ (g : Ω) * t)⁻¹ = 1 := mul_inv_cancel₀ hD
  have hu0 : (1 + φ (g : Ω) * t)⁻¹ ≠ 0 := inv_ne_zero hD
  generalize (1 + φ (g : Ω) * t)⁻¹ = u at hDu hu0 ⊢
  have hc : 1 - φ (g : Ω) * (t * u) = u := by linear_combination (-1 : K) * hDu
  have hψg : (φ.comp W.subtype) g = φ (g : Ω) := rfl
  refine ⟨fun p hp => ?_, fun c => ?_⟩
  ·
    letI : Algebra Ω K := φ.toAlgebra
    have hT' : ¬ IsAlgebraic Ω t := by
      rintro ⟨r, hr0, hr⟩
      exact hr0 (hT r (by rw [Polynomial.aeval_def] at hr; exact hr))
    by_contra hp0
    have h1 : IsAlgebraic Ω (t * u) := ⟨p, hp0, by rw [Polynomial.aeval_def]; exact hp⟩
    have h2 : IsAlgebraic Ω (1 - algebraMap Ω K (g : Ω) * (t * u)) :=
      isAlgebraic_one.sub ((isAlgebraic_algebraMap _).mul h1)
    have h3 := h1.mul h2.inv
    apply hT'
    have e : t * u * (1 - algebraMap Ω K (g : Ω) * (t * u))⁻¹ = t := by
      show t * u * (1 - φ (g : Ω) * (t * u))⁻¹ = t
      rw [hc, mul_inv_cancel_right₀ hu0]
    rw [e] at h3
    exact h3
  ·
    have sharp : ∀ (r : Polynomial ↥W) (n : ℕ), r.natDegree < n + 1 →
        (∑ i ∈ Finset.range (n + 1), Polynomial.C (r.coeff i) * Polynomial.X ^ i *
          (1 - Polynomial.C g * Polynomial.X) ^ (n + 1 - i)).eval₂ (φ.comp W.subtype) (t * u) =
          u ^ (n + 1) * r.eval₂ (φ.comp W.subtype) t ∧
        (∑ i ∈ Finset.range (n + 1), Polynomial.C (r.coeff i) * Polynomial.X ^ i *
          (1 - Polynomial.C g * Polynomial.X) ^ (n + 1 - i)).coeff 0 = r.coeff 0 := by
      intro r n hn
      constructor
      · rw [Polynomial.eval₂_finsetSum, Polynomial.eval₂_eq_sum_range' _ hn, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i hi => ?_)
        simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
          Polynomial.eval₂_sub, Polynomial.eval₂_one, Polynomial.eval₂_X]
        rw [hψg, hc, mul_pow]
        have := pow_mul_pow_sub u (le_of_lt (Finset.mem_range.mp hi))
        rw [← this]
        ring
      · rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_finsetSum,
          Finset.sum_range_succ']
        simp [Polynomial.coeff_zero_eq_eval_zero]
    obtain ⟨p, q, hq, hp, hrel⟩ := hFr c
    have hpN : p.natDegree < max p.natDegree q.natDegree + 1 := by omega
    have hqN : q.natDegree < max p.natDegree q.natDegree + 1 := by omega
    obtain ⟨hpe, hp0⟩ := sharp p _ hpN
    obtain ⟨hqe, hq0⟩ := sharp q _ hqN
    refine ⟨∑ i ∈ Finset.range (max p.natDegree q.natDegree + 1),
        Polynomial.C (p.coeff i) * Polynomial.X ^ i *
          (1 - Polynomial.C g * Polynomial.X) ^ (max p.natDegree q.natDegree + 1 - i),
      ∑ i ∈ Finset.range (max p.natDegree q.natDegree + 1),
        Polynomial.C (q.coeff i) * Polynomial.X ^ i *
          (1 - Polynomial.C g * Polynomial.X) ^ (max p.natDegree q.natDegree + 1 - i),
      ?_, ?_, ?_⟩
    · rw [hq0]; exact hq
    · rw [hp0]; exact hp
    · rw [hpe, hqe, ← hrel]; ring

theorem wcpa_dj_lr1k_ebc_dad_node_pres : ∀ (Ω K O P : Type u) [Field Ω] [Field K] [CommRing O]
    [IsLocalRing O] [CommRing P] (W : ValuationSubring Ω) (φ : Ω →+* K) (σ : ↥W →+* O)
    (G : O →+* K) (h : K) (ϖ : ↥W) (a a' : O),
    Function.Injective G → G.comp σ = φ.comp W.subtype →
    (∀ p : Polynomial Ω, p.eval₂ φ h = 0 → p = 0) → ϖ ≠ 0 →
    a ∈ IsLocalRing.maximalIdeal O → a' ∈ IsLocalRing.maximalIdeal O →
    G a = h → G a' = φ (ϖ : Ω) * h⁻¹ →
    (∀ c : O, ∃ p q : MvPolynomial (Fin 2) ↥W, IsUnit (MvPolynomial.constantCoeff q) ∧
      (c ∈ IsLocalRing.maximalIdeal O → MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W) ∧
      G c * MvPolynomial.eval₂ (φ.comp W.subtype) ![h, φ (ϖ : Ω) * h⁻¹] q =
        MvPolynomial.eval₂ (φ.comp W.subtype) ![h, φ (ϖ : Ω) * h⁻¹] p) →
    ∀ e : O →+* P, wcNdIsHens (IsLocalRing.maximalIdeal O) P e →
    ∃ f : wcEbntN W ϖ →+* P, wcEbntPres W (e.comp σ) ϖ f ∧ f (wcEbntX W ϖ 0) = e a :=
by
  intro Ω K O P _ _ _ _ _ W φ σ G h ϖ a a' hGinj hGσ htr hϖ0 ha ha' hGa hGa' hfrac e he
  classical
  set ψ : ↥W →+* K := φ.comp W.subtype with hψ
  have hmO : ∀ x : O, x ∈ IsLocalRing.maximalIdeal O ↔ ¬ IsUnit x := fun x =>
    (IsLocalRing.mem_maximalIdeal x).trans mem_nonunits_iff

  have hh0 : h ≠ 0 := by
    intro h0
    have := htr Polynomial.X (by rw [Polynomial.eval₂_X, h0])
    exact Polynomial.X_ne_zero this
  have hGσψ : ∀ w : ↥W, G (σ w) = ψ w := fun w => by rw [← RingHom.comp_apply, hGσ]

  have haa : a * a' = σ ϖ := by
    apply hGinj
    rw [map_mul, hGa, hGa', hGσψ, mul_left_comm, mul_inv_cancel₀ hh0, mul_one]
    rfl

  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal ↥W := by
    by_contra hn
    have hu : IsUnit ϖ := IsLocalRing.notMem_maximalIdeal.mp hn
    have hu2 : IsUnit (a * a') := by rw [haa]; exact hu.map σ
    exact (hmO a).mp ha (isUnit_of_mul_isUnit_left hu2)

  have hρ₀I : ∀ y ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ :
      MvPolynomial (Fin 2) ↥W)}, MvPolynomial.eval₂Hom σ ![a, a'] y = 0 := by
    intro y hy
    obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    simp [haa]
  obtain ⟨ρ, hρmk⟩ : ∃ ρ : wcEbntN W ϖ →+* O, ∀ F, ρ (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ :
        MvPolynomial (Fin 2) ↥W)}) F) = MvPolynomial.eval₂ σ ![a, a'] F :=
    ⟨Ideal.Quotient.lift _ _ hρ₀I, fun F => Ideal.Quotient.lift_mk _ _ _⟩
  have hρX0 : ρ (wcEbntX W ϖ 0) = a :=
    (hρmk (MvPolynomial.X 0)).trans (by rw [MvPolynomial.eval₂_X]; simp)
  have hρX1 : ρ (wcEbntX W ϖ 1) = a' :=
    (hρmk (MvPolynomial.X 1)).trans (by rw [MvPolynomial.eval₂_X]; simp)

  have hGρ : ∀ F, G (ρ (Ideal.Quotient.mk
      (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ :
        MvPolynomial (Fin 2) ↥W)}) F)) = MvPolynomial.eval₂ ψ ![h, φ (ϖ : Ω) * h⁻¹] F := by
    intro F
    rw [hρmk, MvPolynomial.eval₂_comp_left, hGσ]
    congr 1
    funext i
    fin_cases i <;> simp [hGa, hGa']
  have htrW : ∀ p : Polynomial ↥W, p.eval₂ ψ h = 0 → p = 0 := by
    intro p hp
    have h1 : (p.map W.subtype).eval₂ φ h = 0 := by rw [Polynomial.eval₂_map]; exact hp
    have h2 := htr _ h1
    exact Polynomial.map_injective W.subtype (fun x y hxy => Subtype.ext hxy)
      (by rw [h2, Polynomial.map_zero])

  have hρinj : Function.Injective ρ := by
    have hx0d : (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)})) (MvPolynomial.X 0) = wcEbntX W ϖ 0 := rfl
    have hx1d : (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)})) (MvPolynomial.X 1) = wcEbntX W ϖ 1 := rfl
    have hXX : wcEbntX W ϖ 0 * wcEbntX W ϖ 1 =
        ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) ϖ := by
      rw [← hx0d, ← hx1d, RingHom.comp_apply, ← map_mul, Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    set c := ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) with hc
    set ev : Polynomial ↥W →+* wcEbntN W ϖ := Polynomial.eval₂RingHom c (wcEbntX W ϖ 0) with hev
    have e2 : ev Polynomial.X = wcEbntX W ϖ 0 := Polynomial.eval₂_X _ _
    have e3 : ∀ w : ↥W, ev (Polynomial.C w) = c w := fun w => Polynomial.eval₂_C _ _
    have habs : ∀ F : MvPolynomial (Fin 2) ↥W, ∃ (k : ℕ) (r : Polynomial ↥W),
        wcEbntX W ϖ 0 ^ k * (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)})) F = ev r := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C w =>
        refine ⟨0, Polynomial.C w, ?_⟩
        rw [pow_zero, one_mul, e3, hc, RingHom.comp_apply]
      | add p q hp hq =>
        obtain ⟨k₁, r₁, h₁⟩ := hp
        obtain ⟨k₂, r₂, h₂⟩ := hq
        refine ⟨k₁ + k₂, Polynomial.X ^ k₂ * r₁ + Polynomial.X ^ k₁ * r₂, ?_⟩
        rw [map_add ev, map_mul ev, map_mul ev, map_pow ev, map_pow ev, e2, ← h₁, ← h₂, map_add]
        ring
      | mul_X p n hp =>
        obtain ⟨k, r, hk⟩ := hp
        have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
        rcases hn with rfl | rfl
        · refine ⟨k, r * Polynomial.X, ?_⟩
          rw [map_mul ev, e2, ← hk, map_mul, hx0d]
          ring
        · refine ⟨k + 1, Polynomial.C ϖ * r, ?_⟩
          rw [map_mul ev, e3, ← hk, map_mul, hx1d, ← hXX]
          ring
    have hnzd : ∀ t : wcEbntN W ϖ, wcEbntX W ϖ 0 * t = 0 → t = 0 := by
      intro t ht
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective t
      rw [← hx0d, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at ht
      obtain ⟨Q, hQ⟩ := ht
      have hp : Prime (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) := MvPolynomial.X_prime
      have hdvd : (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) ∣
          Q * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ) := ⟨F, hQ⟩
      rcases hp.dvd_or_dvd hdvd with ⟨Q', hQ'⟩ | hf
      · rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
        refine ⟨Q', ?_⟩
        have h3 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) *
            (Q' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ)) =
            MvPolynomial.X 0 * F := by
          rw [← hQ, hQ']; ring
        exact mul_left_cancel₀ hp.ne_zero h3
      · exfalso
        have h2 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) ∣ MvPolynomial.C ϖ := by
          have e : (MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W) =
              MvPolynomial.X 0 * MvPolynomial.X 1 -
                (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ) := by ring
          rw [e]
          exact dvd_sub (dvd_mul_right _ _) hf
        obtain ⟨h', hh'⟩ := h2
        have h4 := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (0 : ↥W))) hh'
        simp only [MvPolynomial.eval_C, map_mul, MvPolynomial.eval_X, zero_mul] at h4
        exact hϖ0 h4
    have hpow : ∀ (k : ℕ) (t : wcEbntN W ϖ), wcEbntX W ϖ 0 ^ k * t = 0 → t = 0 := by
      intro k
      induction k with
      | zero => intro t ht; simpa using ht
      | succ k ih =>
        intro t ht
        apply ih
        apply hnzd
        rw [← mul_assoc, ← pow_succ']
        exact ht
    have hGc : (G.comp ρ).comp c = ψ := by
      apply RingHom.ext
      intro w
      rw [RingHom.comp_apply, RingHom.comp_apply, hc, RingHom.comp_apply, hρmk,
        MvPolynomial.eval₂_C, hGσψ]
    have hGx : (G.comp ρ) (wcEbntX W ϖ 0) = h := by
      rw [RingHom.comp_apply, hρX0, hGa]
    rw [injective_iff_map_eq_zero]
    intro t ht
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective t
    obtain ⟨k, r, hkr⟩ := habs F
    have hr : r = 0 := by
      apply htrW
      have e5 : (G.comp ρ) (ev r) =
          Polynomial.eval₂ ((G.comp ρ).comp c) ((G.comp ρ) (wcEbntX W ϖ 0)) r :=
        Polynomial.hom_eval₂ _ _ _ _
      rw [hGc, hGx] at e5
      rw [← e5, ← hkr, map_mul]
      simp only [RingHom.comp_apply, ht, map_zero, mul_zero]
    rw [hr, map_zero] at hkr
    exact hpow k _ hkr

  have hker : ∀ r : MvPolynomial (Fin 2) ↥W,
      MvPolynomial.eval₂ ψ ![h, φ (ϖ : Ω) * h⁻¹] r = 0 →
      MvPolynomial.constantCoeff r ∈ IsLocalRing.maximalIdeal ↥W := by
    intro r hr
    have h1 : ρ (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)}) r) = 0 := by
      apply hGinj; rw [hGρ, hr, map_zero]
    have h2 := hρinj (h1.trans (map_zero ρ).symm)
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h2
    obtain ⟨s, hs⟩ := h2
    rw [← hs, map_mul, map_sub, map_mul, MvPolynomial.constantCoeff_X,
      MvPolynomial.constantCoeff_C, zero_mul, zero_sub, mul_neg]
    exact neg_mem (Ideal.mul_mem_left _ _ hϖm)

  have hσm : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → σ w ∈ IsLocalRing.maximalIdeal O := by
    intro w hw
    by_contra hn
    have hu : IsUnit (σ w) := IsLocalRing.notMem_maximalIdeal.mp hn
    obtain ⟨p, q, hq, -, hE⟩ := hfrac (↑hu.unit⁻¹)
    have h1 : G (σ w) * G (↑hu.unit⁻¹) = 1 := by rw [← map_mul, hu.mul_val_inv, map_one]
    have h3 : MvPolynomial.eval₂ ψ ![h, φ (ϖ : Ω) * h⁻¹] (q - MvPolynomial.C w * p) = 0 := by
      rw [MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, ← hE, ← hGσψ]
      linear_combination (-(MvPolynomial.eval₂ ψ ![h, φ (ϖ : Ω) * h⁻¹] q)) * h1
    have h4 := hker _ h3
    rw [map_sub, map_mul, MvPolynomial.constantCoeff_C] at h4
    have h5 : MvPolynomial.constantCoeff q ∈ IsLocalRing.maximalIdeal ↥W := by
      have := Ideal.add_mem _ h4 (Ideal.mul_mem_right (MvPolynomial.constantCoeff p) _ hw)
      rwa [sub_add_cancel] at this
    exact ((IsLocalRing.mem_maximalIdeal _).trans mem_nonunits_iff).mp h5 hq

  have hcc : ∀ F : MvPolynomial (Fin 2) ↥W, MvPolynomial.eval₂ σ ![a, a'] F -
      σ (MvPolynomial.constantCoeff F) ∈ IsLocalRing.maximalIdeal O := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C r =>
      rw [MvPolynomial.eval₂_C, MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    | add p q hp hq =>
      have e : MvPolynomial.eval₂ σ ![a, a'] (p + q) - σ (MvPolynomial.constantCoeff (p + q)) =
          (MvPolynomial.eval₂ σ ![a, a'] p - σ (MvPolynomial.constantCoeff p)) +
            (MvPolynomial.eval₂ σ ![a, a'] q - σ (MvPolynomial.constantCoeff q)) := by
        rw [MvPolynomial.eval₂_add, map_add, map_add]; ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    | mul_X p n _ =>
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, map_mul, MvPolynomial.constantCoeff_X,
        mul_zero, map_zero, sub_zero]
      apply Ideal.mul_mem_left
      fin_cases n
      · simpa using ha
      · simpa using ha'

  have hunit : ∀ t, IsUnit (ρ t) ↔ t ∉ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ})) := by
    have hX0 : ¬ IsUnit (ρ (wcEbntX W ϖ 0)) := by rw [hρX0]; exact (hmO a).mp ha
    have hX1 : ¬ IsUnit (ρ (wcEbntX W ϖ 1)) := by rw [hρX1]; exact (hmO a').mp ha'
    have hC : ∀ c ∈ IsLocalRing.maximalIdeal ↥W,
        ¬ IsUnit (ρ (Ideal.Quotient.mk _ (MvPolynomial.C c))) := by
      intro c hc
      rw [hρmk, MvPolynomial.eval₂_C]
      exact (hmO _).mp (hσm c hc)
    intro t
    have hnu : ∀ x : O, ¬ IsUnit x → x ∈ IsLocalRing.maximalIdeal O := fun x hx =>
      (IsLocalRing.mem_maximalIdeal x).mpr hx
    have hle : ∀ s, s ∈ (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W),
        MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)).map
        (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ :
          MvPolynomial (Fin 2) ↥W)})) → ρ s ∈ IsLocalRing.maximalIdeal O := by
      intro s hs
      have h : (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)).map
          (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)})) ≤
            (IsLocalRing.maximalIdeal O).comap ρ := by
        rw [Ideal.map_le_iff_le_comap]
        refine sup_le ?_ ?_
        · rw [Ideal.span_le]
          intro x hx
          simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
          rcases hx with rfl | rfl
          · exact hnu _ hX0
          · exact hnu _ hX1
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          exact hnu _ (hC c hc)
      exact h hs
    have s2 : ∀ p : MvPolynomial (Fin 2) ↥W, p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r =>
        simp
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
          rw [map_add, MvPolynomial.C_add]; ring
        rw [e]
        exact add_mem hp hq
      | mul_X p n _ =>
        have e : p * MvPolynomial.X n -
            MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n)) =
            p * MvPolynomial.X n := by
          simp
        rw [e]
        apply Ideal.mul_mem_left
        apply Ideal.subset_span
        have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
        rcases hn with rfl | rfl
        · exact Set.mem_insert _ _
        · exact Set.mem_insert_of_mem _ rfl
    constructor
    · intro hu ht
      exact (IsLocalRing.mem_maximalIdeal _).mp (hle t ht) hu
    · intro ht
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
      obtain ⟨p₀, hp₀⟩ : ∃ p₀, MvPolynomial.constantCoeff p = p₀ := ⟨_, rfl⟩
      have hr := s2 p
      rw [hp₀] at hr
      have hp0 : p₀ ∉ IsLocalRing.maximalIdeal ↥W := by
        intro hm
        apply ht
        apply Ideal.mem_map_of_mem
        have e : p = (p - MvPolynomial.C p₀) + MvPolynomial.C p₀ := by ring
        rw [e]
        exact add_mem (Ideal.mem_sup_left hr) (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hm))
      have hu : IsUnit (ρ (Ideal.Quotient.mk _ (MvPolynomial.C p₀))) :=
        IsUnit.map ρ (IsUnit.map _ (IsUnit.map MvPolynomial.C
          (IsLocalRing.notMem_maximalIdeal.mp hp0)))
      have hn : ρ (Ideal.Quotient.mk _ (p - MvPolynomial.C p₀)) ∈ IsLocalRing.maximalIdeal O :=
        hle _ (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left hr))
      have heq : ρ (Ideal.Quotient.mk _ p) = ρ (Ideal.Quotient.mk _ (MvPolynomial.C p₀)) +
          ρ (Ideal.Quotient.mk _ (p - MvPolynomial.C p₀)) := by
        rw [← map_add, ← map_add]; congr 2; ring
      rw [heq]
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hsum
      have hm : ρ (Ideal.Quotient.mk _ (MvPolynomial.C p₀)) ∈ IsLocalRing.maximalIdeal O := by
        have h2 := Ideal.sub_mem _ hsum hn
        rwa [add_sub_cancel_right] at h2
      exact (IsLocalRing.mem_maximalIdeal _).mp hm hu
  obtain ⟨𝔭, h𝔭⟩ : ∃ 𝔭 : Ideal (wcEbntN W ϖ), 𝔭 = (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ϖ})) := ⟨_, rfl⟩
  rw [← h𝔭] at hunit
  have hmax : ∀ t, ρ t ∈ IsLocalRing.maximalIdeal O ↔ t ∈ 𝔭 := fun t =>
    (hmO _).trans ((not_congr (hunit t)).trans not_not)

  have hfrac' : ∀ c : O, ∃ p q : wcEbntN W ϖ, IsUnit (ρ q) ∧ c * ρ q = ρ p := by
    intro c
    obtain ⟨p, q, hq, -, hE⟩ := hfrac c
    refine ⟨Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)}) p, Ideal.Quotient.mk
        (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ϖ : MvPolynomial (Fin 2) ↥W)}) q, ?_, ?_⟩
    · rw [hρmk]
      by_contra hn
      have h1 : MvPolynomial.eval₂ σ ![a, a'] q ∈ IsLocalRing.maximalIdeal O := (hmO _).mpr hn
      have h2 := Ideal.sub_mem _ h1 (hcc q)
      rw [sub_sub_cancel] at h2
      exact (hmO _).mp h2 (hq.map σ)
    · apply hGinj
      rw [map_mul, hGρ, hGρ, hE]

  have htransfer : ∀ (A : Type u) [CommRing A] (𝔫 : Ideal A) (ρ : A →+* O),
      Function.Injective ρ → (∀ x : A, ρ x ∈ IsLocalRing.maximalIdeal O ↔ x ∈ 𝔫) →
      (∀ c : O, ∃ p q : A, IsUnit (ρ q) ∧ c * ρ q = ρ p) →
      wcNdIsHens 𝔫 P (e.comp ρ) := by
    intro A _ 𝔫 ρ hρinj hmax hfrac'
    obtain ⟨H1, H2, H3⟩ := he
    refine ⟨H1, ?_, ?_⟩
    · intro t
      rw [RingHom.comp_apply, H2]
      exact not_congr (hmax t)
    · intro B _ hB g hg
      letI : Algebra A O := ρ.toAlgebra
      let M : Submonoid A := Submonoid.comap ρ (IsUnit.submonoid O)
      have hM : ∀ x, x ∈ M ↔ IsUnit (ρ x) := fun x => by
        simp only [M, Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
      haveI hloc : IsLocalization M O :=
        ⟨fun y => (hM y).mp y.2,
         fun z => by
            obtain ⟨p, q, hq, hE⟩ := hfrac' z
            exact ⟨(p, ⟨q, (hM q).mpr hq⟩), hE⟩,
         fun {x y} hxy => ⟨1, by rw [hρinj hxy]⟩⟩
      have hgM : ∀ y : M, IsUnit (g y) := by
        intro y
        apply (hg y).mpr
        intro hy
        have := (hmax y).mpr hy
        exact (hmO _).mp this ((hM y).mp y.2)
      let g' : O →+* B := IsLocalization.lift (M := M) (S := O) hgM
      have hg'ρ : ∀ x, g' (ρ x) = g x := fun x => IsLocalization.lift_eq hgM x
      have hg'comp : g'.comp ρ = g := RingHom.ext hg'ρ
      have hlocal : ∀ c, IsUnit (g' c) ↔ c ∉ IsLocalRing.maximalIdeal O := by
        intro c
        obtain ⟨p, q, hq, hE⟩ := hfrac' c
        have hgq : IsUnit (g q) := hgM ⟨q, (hM q).mpr hq⟩
        have e1 : g' c * g q = g p := by rw [← hg'ρ q, ← hg'ρ p, ← map_mul, hE]
        calc IsUnit (g' c) ↔ IsUnit (g' c * g q) := hgq.mul_right_iff.symm
          _ ↔ IsUnit (g p) := by rw [e1]
          _ ↔ p ∉ 𝔫 := hg p
          _ ↔ ρ p ∉ IsLocalRing.maximalIdeal O := not_congr (hmax p).symm
          _ ↔ IsUnit (ρ p) := IsLocalRing.notMem_maximalIdeal
          _ ↔ IsUnit (c * ρ q) := by rw [hE]
          _ ↔ IsUnit c := hq.mul_right_iff
          _ ↔ c ∉ IsLocalRing.maximalIdeal O := IsLocalRing.notMem_maximalIdeal.symm
      obtain ⟨k, ⟨hk, hkloc⟩, huniq⟩ := H3 B hB g' hlocal
      refine ⟨k, ⟨?_, hkloc⟩, ?_⟩
      · rw [← RingHom.comp_assoc, hk, hg'comp]
      · rintro k' ⟨hk', hloc'⟩
        apply huniq k'
        refine ⟨?_, hloc'⟩
        apply IsLocalization.ringHom_ext M
        show (k'.comp e).comp ρ = g'.comp ρ
        rw [RingHom.comp_assoc, hk', hg'comp]
  have hH : wcNdIsHens (A := wcEbntN W ϖ) 𝔭 P (e.comp ρ) :=
    htransfer (wcEbntN W ϖ) 𝔭 ρ hρinj hmax hfrac'
  refine ⟨e.comp ρ, ⟨hϖm, hϖ0, ?_, ?_⟩, ?_⟩
  · apply RingHom.ext
    intro w
    simp only [RingHom.comp_apply]
    rw [hρmk, MvPolynomial.eval₂_C]
  · subst h𝔭
    exact hH
  · rw [RingHom.comp_apply, hρX0]

theorem wcpa_dj_lr1k_ebc_dad_disc_pres : ∀ (Ω K O P : Type u) [Field Ω] [Field K] [CommRing O]
    [IsLocalRing O] [CommRing P] (W : ValuationSubring Ω) (φ : Ω →+* K) (σ : ↥W →+* O)
    (G : O →+* K) (t : K) (s : O),
    Function.Injective G → G.comp σ = φ.comp W.subtype →
    (∀ p : Polynomial Ω, p.eval₂ φ t = 0 → p = 0) →
    s ∈ IsLocalRing.maximalIdeal O → G s = t →
    (∀ c : O, ∃ p q : Polynomial ↥W, IsUnit (q.coeff 0) ∧
      (c ∈ IsLocalRing.maximalIdeal O → p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W) ∧
      G c * q.eval₂ (φ.comp W.subtype) t = p.eval₂ (φ.comp W.subtype) t) →
    ∀ e : O →+* P, wcNdIsHens (IsLocalRing.maximalIdeal O) P e →
    ∃ f : Polynomial ↥W →+* P, f.comp Polynomial.C = e.comp σ ∧
      wcNdIsHens (Ideal.span {Polynomial.X} ⊔
        Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) P f ∧
      f Polynomial.X = e s :=
by
  intro Ω K O P _ _ _ _ _ W φ σ G t s hGinj hGσ htr hs hGs hfrac e he
  classical
  set ψ : ↥W →+* K := φ.comp W.subtype with hψ
  set ρ : Polynomial ↥W →+* O := Polynomial.eval₂RingHom σ s with hρ
  have hρa : ∀ p : Polynomial ↥W, ρ p = p.eval₂ σ s := fun p => rfl

  have g1 : ∀ p : Polynomial ↥W, G (ρ p) = p.eval₂ ψ t := by
    intro p
    rw [hρa, Polynomial.hom_eval₂, hGσ, hGs]

  have g2 : ∀ p : Polynomial ↥W, p.eval₂ ψ t = 0 → p = 0 := by
    intro p hp
    have h1 : (p.map W.subtype).eval₂ φ t = 0 := by
      rw [Polynomial.eval₂_map]; exact hp
    have h2 := htr _ h1
    exact Polynomial.map_injective W.subtype (fun a b h => Subtype.ext h)
      (by rw [h2, Polynomial.map_zero])

  have g3 : Function.Injective ρ := by
    rw [injective_iff_map_eq_zero]
    intro p hp
    apply g2
    rw [← g1, hp, map_zero]

  have hσm : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → σ w ∈ IsLocalRing.maximalIdeal O := by
    intro w hw
    by_contra hn
    have hu : IsUnit (σ w) := by
      by_contra h
      exact hn ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h))
    obtain ⟨p, q, hq, -, hE⟩ := hfrac (↑hu.unit⁻¹)
    have h1 : G (σ w) * G (↑hu.unit⁻¹) = 1 := by
      rw [← map_mul, hu.mul_val_inv, map_one]
    have h2 : G (σ w) = ψ w := by rw [← RingHom.comp_apply, hGσ]
    have h3 : (q - Polynomial.C w * p).eval₂ ψ t = 0 := by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C, ← hE, ← h2]
      linear_combination (-(q.eval₂ ψ t)) * h1
    have h4 := g2 _ h3
    have h5 : q = Polynomial.C w * p := sub_eq_zero.mp h4
    have h6 : q.coeff 0 = w * p.coeff 0 := by rw [h5, Polynomial.coeff_C_mul]
    rw [h6] at hq
    have h7 : IsUnit w := isUnit_of_mul_isUnit_left hq
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hw) h7

  have s4 : ∀ a : Polynomial ↥W, ρ a ∈ IsLocalRing.maximalIdeal O ↔
      a.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a
    have hdec : ρ a = ρ a.divX * s + σ (a.coeff 0) := by
      have h := Polynomial.X_mul_divX_add a
      calc ρ a = ρ (Polynomial.X * a.divX + Polynomial.C (a.coeff 0)) := by rw [h]
        _ = _ := by
          simp only [hρa, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X,
            Polynomial.eval₂_C]
          ring
    have hmem : ρ a.divX * s ∈ IsLocalRing.maximalIdeal O := Ideal.mul_mem_left _ _ hs
    rw [hdec, Ideal.add_mem_iff_right _ hmem]
    constructor
    · intro h
      by_contra hn
      have hu : IsUnit (a.coeff 0) := by
        by_contra h'
        exact hn ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h'))
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h) (hu.map σ)
    · exact hσm _

  have s5 : ∀ a : Polynomial ↥W, a ∈ (Ideal.span {Polynomial.X} ⊔
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) ↔
      a.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a
    constructor
    · intro ha
      have hle : Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)
          ≤ Ideal.comap (Polynomial.constantCoeff) (IsLocalRing.maximalIdeal ↥W) := by
        apply sup_le
        · rw [Ideal.span_le]
          intro x hx
          rw [Set.mem_singleton_iff] at hx
          subst hx
          simp only [SetLike.mem_coe, Ideal.mem_comap]
          first
            | (simp only [Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
               exact Ideal.zero_mem _)
            | simp
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          simp only [Ideal.mem_comap]
          first
            | (simp only [Polynomial.constantCoeff_apply, Polynomial.coeff_C_zero]; exact hw)
            | simpa using hw
      have := hle ha
      simp only [Ideal.mem_comap] at this
      first
        | (rwa [Polynomial.constantCoeff_apply] at this)
        | simpa using this
    · intro ha
      rw [← Polynomial.X_mul_divX_add a]
      apply Ideal.add_mem
      · exact Submodule.mem_sup_left
          (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
      · exact Submodule.mem_sup_right (Ideal.mem_map_of_mem _ ha)
  have hmax : ∀ a : Polynomial ↥W, ρ a ∈ IsLocalRing.maximalIdeal O ↔
      a ∈ (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
    fun a => (s4 a).trans (s5 a).symm

  have hfrac' : ∀ c : O, ∃ p q : Polynomial ↥W, IsUnit (ρ q) ∧ c * ρ q = ρ p := by
    intro c
    obtain ⟨p, q, hq, -, hE⟩ := hfrac c
    refine ⟨p, q, ?_, ?_⟩
    · by_contra hn
      have h1 : ρ q ∈ IsLocalRing.maximalIdeal O :=
        (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hn)
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp ((s4 q).mp h1)) hq
    · apply hGinj
      rw [map_mul, g1, g1, hE]

  obtain ⟨H1, H2, H3⟩ := he
  refine ⟨e.comp ρ, ?_, ⟨H1, ?_, ?_⟩, ?_⟩
  · ext w
    show e (ρ (Polynomial.C w)) = e (σ w)
    rw [hρa, Polynomial.eval₂_C]
  · intro a
    rw [RingHom.comp_apply, H2]
    exact not_congr (hmax a)
  · intro B _ hB g hg
    letI : Algebra (Polynomial ↥W) O := ρ.toAlgebra
    let M : Submonoid (Polynomial ↥W) := Submonoid.comap ρ (IsUnit.submonoid O)
    have hM : ∀ a, a ∈ M ↔ IsUnit (ρ a) := fun a => by
      simp only [M, Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
