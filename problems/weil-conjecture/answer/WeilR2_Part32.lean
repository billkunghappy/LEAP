          (Spec.map (CommRingCat.ofHom (lam.comp θ₀))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c))
        rw [keyB, keyB, ← map_mul]
        congr 1
        rw [RingHom.comp_apply, RingHom.comp_apply, hθX, hθC, ← hAB, map_mul]
        linear_combination (-(lam (Ideal.Quotient.mk I (MvPolynomial.X 0)))) * hsinv
      · show (Spec.map (CommRingCat.ofHom (lam.comp θ₀))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) =
          1 * (Spec.map (CommRingCat.ofHom (lam.comp θ₀))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c))
        rw [one_mul]
    · show (Spec.map (CommRingCat.ofHom (lam.comp θ₀))).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) ∈ _
      rw [keyB, RingHom.comp_apply, hθC, mem_nonZeroDivisors_iff_right]
      intro y hy
      have h1 := congrArg (Scheme.ΓSpecIso (.of L)).hom.hom hy
      rw [map_mul, hinvhom, map_zero] at h1
      have h2 := hlc _ h1
      rw [← hhominv _ y, h2, map_zero]
  have e0 : (Spec.map (CommRingCat.ofHom lam) ≫ c₀) ≫ r₀ =
      Spec.map (CommRingCat.ofHom (lam.comp θ₀)) := by
    rw [Category.assoc, hc₀r, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have e1 : (Spec.map (CommRingCat.ofHom β) ≫ c₁) ≫ r₀ =
      Spec.map (CommRingCat.ofHom (lam.comp θ₀)) := by
    rw [Category.assoc, hc₁r, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hβθ]
  have hf : Spec.map (CommRingCat.ofHom lam) ≫ c₀ = Spec.map (CommRingCat.ofHom β) ≫ c₁ :=
    (hr₀.2 _ _ hInv).unique e0 e1
  have hmem : q ∈ Set.range (PrimeSpectrum.comap lam) := by
    rw [hlam, PrimeSpectrum.localization_away_comap_range L
