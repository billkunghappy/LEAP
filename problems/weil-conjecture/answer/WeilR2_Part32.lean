      rw [Polynomial.eval₂_map]
      congr 1
      exact RingHom.ext fun w => (hcomp w).symm
    rw [heq]
    refine ⟨hnv _ hqAm, memV _ ((memS _).mpr ⟨1, q.map σ, hqAm, ?_⟩)⟩
    rw [Polynomial.eval₂_one, inv_mul_cancel₀ (hnv _ hqAm)]

theorem wcpa_dj_lr1u_fn_gauss_unique : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (V V' : ValuationSubring (wcProjK Ω 1).functionField) (c1 c2 c3 : wcProjK Ω 1) (g : (wcProjK Ω 1).functionField), wcLr1uMob (wcProjKStr Ω 1) c1 c2 c3 g → (∀ ω : Ω, wcLr1uConst (wcProjKStr Ω 1) ω ∈ V ↔ ω ∈ W) → (∀ ω : Ω, wcLr1uConst (wcProjKStr Ω 1) ω ∈ V' ↔ ω ∈ W) → wcLr1uVtdRT W (wcProjKStr Ω 1) (V : Set (wcProjK Ω 1).functionField) g → wcLr1uVtdRT W (wcProjKStr Ω 1) (V' : Set (wcProjK Ω 1).functionField) g → V = V' :=
