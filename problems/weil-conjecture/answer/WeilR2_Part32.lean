        have e : a 0 * a 1 * ι (algebraMap R₀ K c)⁻¹ =
            ι (algebraMap R₀ K c) * ι (algebraMap R₀ K c)⁻¹ := by rw [hP0]
        rw [← map_mul, mul_inv_cancel₀ hc, map_one] at e
        exact (mul_assoc (a 0) (a 1) (ι (algebraMap R₀ K c)⁻¹)).symm.trans e
      exact ⟨⟨a 0, a 1 * ι (algebraMap R₀ K c)⁻¹, hone,
        (mul_comm (a 1 * ι (algebraMap R₀ K c)⁻¹) (a 0)).trans hone⟩, rfl⟩
