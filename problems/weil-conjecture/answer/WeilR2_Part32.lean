      · exact hCp _ h0
    · intro hq
      have hle : (Ideal.span {Polynomial.X} ⊔
          Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) : Ideal (Polynomial ↥W)) ≤
          Ideal.comap (Polynomial.eval₂RingHom (RingHom.id ↥W) α)
            (IsLocalRing.maximalIdeal ↥W) := by
        apply sup_le
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
            hevq, Polynomial.eval_X]
          exact hα
        · rw [Ideal.map_le_iff_le_comap]
          intro t ht
          rw [Ideal.mem_comap, Ideal.mem_comap, hevq, Polynomial.eval_C]
          exact ht
      exact hle hq
  obtain ⟨k, ⟨hk, hkl⟩, -⟩ := hfR.2.2 ↥W hWh (Polynomial.eval₂RingHom (RingHom.id ↥W) α) hcrit
  have hkf : ∀ q, k (fR q) = Polynomial.eval α q := fun q => by
    rw [← RingHom.comp_apply, hk]; rfl
  refine ⟨k, hk, ?_⟩
  have h𝔞p : Ideal.span {Polynomial.X - Polynomial.C α} ≤
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W)) := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.sub_mem _ hXp (hCp α hα)
  have hQ := wcNd_hens_quotient (Polynomial ↥W) _ _ R fR hfR h𝔞p
  haveI hQh : HenselianLocalRing (R ⧸ Ideal.map fR (Ideal.span {Polynomial.X - Polynomial.C α})) :=
    hQ.1
  haveI hπl : IsLocalHom (Ideal.Quotient.mk
      (Ideal.map fR (Ideal.span {Polynomial.X - Polynomial.C α}))) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  haveI hτl : IsLocalHom ((Ideal.Quotient.mk
