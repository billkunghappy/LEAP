      exact Q1
    refine ⟨h, MorphismProperty.of_isPullback (P := @Etale) Q3 hmN, hsnd, ?_⟩
    have k1 : ∀ p : O.toScheme, Limits.pullback.fst str s₀ (h p) = mN ((fst ∣_ V) p) := by
      intro p
      rw [← Scheme.Hom.comp_apply, hfst, Scheme.Hom.comp_apply]
    have k2 : ∀ p : O.toScheme, V.ι ((fst ∣_ V) p) = fst (O.ι p) := by
