      exact unitS f p q hq h hp hf

  have nonunit : ∀ a : A, ¬ IsUnit a → ∀ t ∈ S, φ a * t ≠ 1 := by
    intro a ha t ht hat
    obtain ⟨p', q', hq', h'⟩ := (memS t).mp ht
    apply hnv (Polynomial.C a * p' - q')
    · rw [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C,
        (IsLocalRing.residue_eq_zero_iff a).mpr ((IsLocalRing.mem_maximalIdeal _).mpr ha),
        Polynomial.C_0, zero_mul, zero_sub, neg_ne_zero]
      exact hq'
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C, ← h']
      linear_combination q'.eval₂ φ g * hat
  have hφS : ∀ a : A, φ a ∈ S := fun a => (memS _).mpr ⟨Polynomial.C a, 1, by simp, by simp⟩
  have hgS : g ∈ S := (memS _).mpr ⟨Polynomial.X, 1, by simp, by simp⟩

  let B : LocalSubring K := @LocalSubring.mk K _ S hSloc
  obtain ⟨V, hBV⟩ := LocalSubring.exists_le_valuationSubring B
  obtain ⟨hle, hlocal⟩ := (LocalSubring.le_def).mp hBV
  have memV : ∀ x ∈ S, x ∈ V := fun x hx => hle hx
  have key : ∀ a : A, ¬ IsUnit a → ∀ s ∈ V, φ a * s ≠ 1 := by
    intro a ha s hs has
    have hu : IsUnit (Subring.inclusion hle ⟨φ a, hφS a⟩) :=
      isUnit_iff_exists_inv.mpr ⟨⟨s, hs⟩, Subtype.ext has⟩
    have hu' : IsUnit (⟨φ a, hφS a⟩ : B.toSubring) := isUnit_of_map_unit (Subring.inclusion hle) _ hu
    obtain ⟨t, ht⟩ := hu'.exists_right_inv
    exact nonunit a ha t.1 t.2 (congrArg Subtype.val ht)
  refine ⟨V, ⟨fun a => memV _ (hφS a), fun a s hs has => ?_⟩,
    fun ω => ⟨fun hcω => ?_, fun hω => ?_⟩, memV _ hgS, fun q hq => ?_⟩
  · by_contra ha
    exact key a ha s hs has
  · by_contra hω
    have hω0 : ω ≠ 0 := by
      rintro rfl
      exact hω W.zero_mem
    have hωi : ω⁻¹ ∈ W := (W.mem_or_inv_mem ω).resolve_left hω
    have hwnu : ¬ IsUnit (⟨ω⁻¹, hωi⟩ : W) := by
