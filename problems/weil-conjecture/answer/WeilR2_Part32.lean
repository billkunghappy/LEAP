  have hEQ : Polynomial.C (c : Ω)⁻¹ * P.map (algebraMap ↥W Ω) ∈ Q := by
    refine (hQ _).2 ⟨Polynomial.X - Polynomial.C (Polynomial.C (c : Ω)⁻¹ *
      P.map (algebraMap ↥W Ω)), Polynomial.monic_X_sub_C _, hlin _ _ (Algebra.subset_adjoin
        (Set.mem_insert_of_mem _ (Set.mem_singleton _))), by simp⟩

  have hEι : ∀ e ∈ Algebra.adjoin ↥W ({Polynomial.X, Polynomial.C (c : Ω)⁻¹ *
      P.map (algebraMap ↥W Ω)} : Set (Polynomial Ω)), evA e ∈ ι.range := by
    intro e he
    have hle : Algebra.adjoin ↥W ({Polynomial.X, Polynomial.C (c : Ω)⁻¹ *
        P.map (algebraMap ↥W Ω)} : Set (Polynomial Ω)) ≤
        Subalgebra.comap (evA.restrictScalars ↥W) ι.range := by
      apply Algebra.adjoin_le
      intro e' he'
      rcases he' with rfl | rfl
      · show evA Polynomial.X ∈ ι.range
        rw [hevX]
        exact hjR u
      · show evA (Polynomial.C (c : Ω)⁻¹ * P.map (algebraMap ↥W Ω)) ∈ ι.range
        rw [hval]
        exact ι.range.mul_mem (hjR _) hsι
    exact hle he
  have hevι : ∀ q : ↥Q, evA (q : Polynomial Ω) ∈ ι.range := by
    intro q
    obtain ⟨p, hpm, hpc, hpe⟩ := (hQ q).1 q.2
    have hcoef : ∀ i, ∃ r ∈ R'', ∃ n : ℕ, (p.map evA.toRingHom).coeff i *
        algebraMap Λ (Localization.Away g) g ^ n = algebraMap Λ (Localization.Away g) r := by
      intro i
      rw [Polynomial.coeff_map]
      exact (hιrange _).1 (hEι _ (hpc i))
    have heval : (p.map evA.toRingHom).eval (evA (q : Polynomial Ω)) = 0 := by
      rw [Polynomial.eval_map]
