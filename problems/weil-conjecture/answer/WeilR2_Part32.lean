      ∃ a : S ⟶ Y, IsOpenImmersion a ∧ a ≫ ν = f ∧ Set.range ⇑a = ⇑ν ⁻¹' Set.range ⇑f := by
    intro Y Z S ν U hiso f hf hfU
    haveI := hiso
    haveI := hf
    have h' : Set.range f ⊆ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hfU
    obtain ⟨f', hf'⟩ : ∃ f' : S ⟶ U.toScheme, f' ≫ U.ι = f :=
      ⟨IsOpenImmersion.lift U.ι f h', IsOpenImmersion.lift_fac _ _ _⟩
    haveI : IsOpenImmersion f' := by
      have : IsOpenImmersion (f' ≫ U.ι) := by rw [hf']; infer_instance
