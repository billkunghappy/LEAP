theorem wcpa_dj_lr1k_odfgl_nt_intclosed_criterion : ∀ (R L : Type u) [CommRing R] [CommRing L] [IsDomain L] [Algebra R L] (T : Subalgebra R L), IsIntegrallyClosed ↥T → ∀ (x b : L), b ∈ T → b ≠ 0 → b * x ∈ T → IsIntegral (↥T) x → x ∈ T :=
