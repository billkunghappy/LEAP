      rw [hlam]; exact IsLocalization.map_units L s
    exact hsu.mul_left_eq_zero.mp h4
  have hlc : ∀ z : L, z * lam (Ideal.Quotient.mk I (MvPolynomial.C c)) = 0 → z = 0 := by
    intro z hz
    rw [← hAB, map_mul, ← mul_assoc] at hz
    exact hlx0 z (hu1.mul_left_eq_zero.mp hz)

  obtain ⟨β, hβC, hβX⟩ : ∃ β : MvPolynomial (Fin 1) ↥W →+* L,
      (∀ w : ↥W, β (MvPolynomial.C w) = lam (Ideal.Quotient.mk I (MvPolynomial.C w))) ∧
      β (MvPolynomial.X 0) = ι :=
    ⟨MvPolynomial.eval₂Hom (lam.comp ((Ideal.Quotient.mk I).comp MvPolynomial.C)) (fun _ => ι),
      fun w => by simp, by simp⟩
  have hβθ : β.comp θ₁ = lam.comp θ₀ := by
    apply MvPolynomial.ringHom_ext
    · intro w
      rw [RingHom.comp_apply, RingHom.comp_apply, hθ₁C, hβC, hθC]
    · intro i
      obtain rfl := Fin.fin_one_eq_zero i
      rw [RingHom.comp_apply, RingHom.comp_apply, hθ₁X, hθX, map_mul, hβC, hβX, ← hAB, map_mul]
      linear_combination (lam (Ideal.Quotient.mk I (MvPolynomial.X 0))) * hsinv
