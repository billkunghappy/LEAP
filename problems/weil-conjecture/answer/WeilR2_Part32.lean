        (fR.comp Polynomial.C)) := by
    refine ⟨fun t ht => ?_⟩
    have h1 : IsUnit (fR (Polynomial.C t)) := isUnit_of_map_unit (Ideal.Quotient.mk
      (Ideal.map fR (Ideal.span {Polynomial.X - Polynomial.C α}))) _ ht
    have h2 := (hfR.2.1 _).mp h1
    by_contra hnu
    exact h2 (hCp t ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)))
  haveI : IsLocalHom k := hkl
  have hcrit2 : ∀ a, IsUnit (((Ideal.Quotient.mk
      (Ideal.map fR (Ideal.span {Polynomial.X - Polynomial.C α}))).comp fR) a) ↔
      a ∉ (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W)) := fun a => by
    rw [RingHom.comp_apply, isUnit_map_iff]
    exact hfR.2.1 a
  have hcomp : (((Ideal.Quotient.mk
      (Ideal.map fR (Ideal.span {Polynomial.X - Polynomial.C α}))).comp
        (fR.comp Polynomial.C)).comp k).comp fR =
      (Ideal.Quotient.mk (Ideal.map fR (Ideal.span {Polynomial.X - Polynomial.C α}))).comp fR := by
    apply Polynomial.ringHom_ext
    · intro t
      simp only [RingHom.comp_apply, hkf, Polynomial.eval_C]
    · simp only [RingHom.comp_apply, hkf, Polynomial.eval_X]
      rw [Ideal.Quotient.eq, ← map_sub,
        show Polynomial.C α - Polynomial.X = -(Polynomial.X - Polynomial.C α) by ring, map_neg]
      exact (Ideal.neg_mem_iff _).mpr (Ideal.mem_map_of_mem fR (Ideal.subset_span rfl))
  have huniq := (hfR.2.2 _ hQh _ hcrit2).unique ⟨rfl, hπl⟩ ⟨hcomp, inferInstance⟩
  intro r hr
  have h1 : Ideal.Quotient.mk (Ideal.map fR (Ideal.span {Polynomial.X - Polynomial.C α})) r = 0 := by
    rw [huniq, RingHom.comp_apply, hr, map_zero]
  have h2 := Ideal.Quotient.eq_zero_iff_mem.mp h1
  rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton'] at h2
  obtain ⟨a, ha⟩ := h2
  exact ⟨a, by rw [← ha, map_sub, mul_comm]⟩

theorem wcpa_dj_lr1k_ebc_dlc_quot_prime : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (fR : Polynomial ↥W →+* R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR → (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)).IsPrime ∧ Ideal.comap fR (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :=
by
  intro Ω _ W R _ fR hfR
  classical

  have hp₀eq : (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
      Ideal (Polynomial ↥W)) =
      Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
    apply le_antisymm
    · apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        simp [Ideal.mem_comap]
      · rw [Ideal.map_le_iff_le_comap]
        intro t ht
        simpa [Ideal.mem_comap] using ht
    · intro q hq
      rw [Ideal.mem_comap, Polynomial.constantCoeff_apply] at hq
      have h1 : q = (q - Polynomial.C (q.coeff 0)) + Polynomial.C (q.coeff 0) := by ring
      rw [h1]
      apply Ideal.add_mem
      · apply Ideal.mem_sup_left
        rw [Ideal.mem_span_singleton]
        exact Polynomial.X_dvd_sub_C
      · apply Ideal.mem_sup_right
        exact Ideal.mem_map_of_mem _ hq
  haveI hp₀ : (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
      Ideal (Polynomial ↥W)).IsPrime := by
    rw [hp₀eq]; infer_instance
  have h𝔟le : Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ≤
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W)) := le_sup_right

  have H := wcNd_hens_quotient (Polynomial ↥W) _
    (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR hfR h𝔟le

  have hκd : IsDomain (Polynomial (IsLocalRing.ResidueField ↥W)) := inferInstance
  have hκic : IsIntegrallyClosed (Polynomial (IsLocalRing.ResidueField ↥W)) := inferInstance
  haveI hκd' : IsDomain (Polynomial (↥W ⧸ IsLocalRing.maximalIdeal ↥W)) := hκd
  haveI hκic' : IsIntegrallyClosed (Polynomial (↥W ⧸ IsLocalRing.maximalIdeal ↥W)) := hκic
  haveI hAd : IsDomain (Polynomial ↥W ⧸ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
    MulEquiv.isDomain (Polynomial (↥W ⧸ IsLocalRing.maximalIdeal ↥W))
      (Ideal.polynomialQuotientEquivQuotientPolynomial (IsLocalRing.maximalIdeal ↥W)).symm.toMulEquiv
  haveI hAic : IsIntegrallyClosed
      (Polynomial ↥W ⧸ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
    IsIntegrallyClosed.of_equiv (R := Polynomial (↥W ⧸ IsLocalRing.maximalIdeal ↥W))
      (Ideal.polynomialQuotientEquivQuotientPolynomial (IsLocalRing.maximalIdeal ↥W))

  have hpbar : (Ideal.map (Ideal.Quotient.mk (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)))
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
        Ideal (Polynomial ↥W))).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact h𝔟le)

  obtain ⟨hRd, -⟩ := wcNd_hens_normal_domain _ _ hpbar _ _ H
  have h𝔟R : (Ideal.map fR (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W))).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp hRd
  have hmm : Ideal.map fR (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) =
      Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) := Ideal.map_map _ _

  have hinj := (wcpa_dj_lr1k_ebnb_hens_inj _ _ hpbar _ _ H).1
  refine ⟨hmm ▸ h𝔟R, ?_⟩
  rw [← hmm]
  apply le_antisymm
  · intro x hx
    rw [Ideal.mem_comap] at hx
    have h1 : Ideal.quotientMap (Ideal.map fR (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)))
        fR Ideal.le_comap_map
        (Ideal.Quotient.mk (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) x) = 0 := by
      rw [Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem]; exact hx
    have h2 : Ideal.Quotient.mk (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) x = 0 :=
      hinj (h1.trans (map_zero _).symm)
    exact Ideal.Quotient.eq_zero_iff_mem.mp h2
  · exact Ideal.le_comap_map

theorem wcpa_dj_lr1k_ebc_dlc_etale_gauss : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (E : Type u) [CommRing E] [Algebra (Polynomial ↥W) E] [Algebra.Etale (Polynomial ↥W) E] (q : Ideal E), q.IsPrime → Ideal.comap (algebraMap (Polynomial ↥W) E) q = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) → ∀ b : E, ∃ (a : ↥W) (s₁ s₂ : E), s₁ ∉ q ∧ s₂ ∉ q ∧ b * s₂ = algebraMap (Polynomial ↥W) E (Polynomial.C a) * s₁ :=
by
  intro Ω _ _ W E _ _ _ q hqP hq b
  classical
  haveI : q.IsPrime := hqP
  obtain ⟨𝔭, h𝔭⟩ : ∃ 𝔭 : Ideal (Polynomial ↥W), 𝔭 = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :=
    ⟨_, rfl⟩
  rw [← h𝔭] at hq
  haveI h𝔭P : 𝔭.IsPrime := by rw [h𝔭]; infer_instance

  have s1 : ∀ p : Polynomial ↥W, ∃ (γ : ↥W) (p₀ : Polynomial ↥W), p = Polynomial.C γ * p₀ ∧ p₀ ∉ 𝔭 := by
    intro p
    rw [h𝔭]
    by_cases hp : p = 0
    · refine ⟨0, 1, by rw [hp, map_zero, zero_mul], ?_⟩
      rw [Ideal.mem_map_C_iff]
      intro h
      have h0 := h 0
      rw [Polynomial.coeff_one_zero] at h0
      exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h0)
    · have hmin : ∀ T : Finset ℕ, T.Nonempty → ∃ j ∈ T, ∀ i ∈ T, p.coeff j ∣ p.coeff i := by
        intro T
        induction T using Finset.induction_on with
        | empty => intro h; exact absurd h Finset.not_nonempty_empty
        | insert a T haT ih =>
          intro _
          by_cases hT : T.Nonempty
          · obtain ⟨j, hj, hjT⟩ := ih hT
            rcases ValuationRing.dvd_total (p.coeff a) (p.coeff j) with h | h
            · refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
              intro i hi
              rcases Finset.mem_insert.mp hi with rfl | hi
              · exact dvd_rfl
              · exact h.trans (hjT i hi)
            · refine ⟨j, Finset.mem_insert_of_mem hj, ?_⟩
              intro i hi
              rcases Finset.mem_insert.mp hi with rfl | hi
              · exact h
              · exact hjT i hi
          · rw [Finset.not_nonempty_iff_eq_empty] at hT
            subst hT
            refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
            intro i hi
            rw [Finset.mem_insert] at hi
            rcases hi with rfl | hi
            · exact dvd_rfl
            · simp at hi
      obtain ⟨j, hj, hjmin⟩ := hmin p.support (Polynomial.support_nonempty.mpr hp)
      have hdvd : Polynomial.C (p.coeff j) ∣ p := by
        rw [Polynomial.C_dvd_iff_dvd_coeff]
        intro i
        by_cases hi : i ∈ p.support
        · exact hjmin i hi
        · rw [Polynomial.notMem_support_iff.mp hi]; exact dvd_zero _
      obtain ⟨p₀, hp₀⟩ := hdvd
      refine ⟨p.coeff j, p₀, hp₀, ?_⟩
      rw [Ideal.mem_map_C_iff]
      intro h
      have hcj : p.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
      have e1 : p.coeff j * 1 = p.coeff j * p₀.coeff j := by
        rw [mul_one]
        conv_lhs => rw [hp₀]
        rw [Polynomial.coeff_C_mul]
      have e2 := mul_left_cancel₀ hcj e1
      have h1 := h j
      rw [← e2] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have s2 : ∀ x y : Localization.AtPrime 𝔭, x ∣ y ∨ y ∣ x := by
    have hrep : ∀ x : Localization.AtPrime 𝔭, ∃ (γ : ↥W) (U : Localization.AtPrime 𝔭),
        IsUnit U ∧ x = algebraMap (Polynomial ↥W) (Localization.AtPrime 𝔭) (Polynomial.C γ) * U := by
      intro x
      obtain ⟨⟨p, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl x
      obtain ⟨γ, p₀, hp, hp₀⟩ := s1 p
      refine ⟨γ, IsLocalization.mk' (Localization.AtPrime 𝔭) p₀ s, ?_, ?_⟩
      · exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime 𝔭) 𝔭 p₀ s).mpr hp₀
      · show IsLocalization.mk' (Localization.AtPrime 𝔭) p s = _
        rw [IsLocalization.mul_mk'_eq_mk'_of_mul, ← hp]
    intro x y
    obtain ⟨γ₁, U₁, hU₁, rfl⟩ := hrep x
    obtain ⟨γ₂, U₂, hU₂, rfl⟩ := hrep y
    obtain ⟨V₁, hV₁⟩ := hU₁.exists_left_inv
    obtain ⟨V₂, hV₂⟩ := hU₂.exists_left_inv
    rcases ValuationRing.dvd_total γ₁ γ₂ with ⟨ρ, hρ⟩ | ⟨ρ, hρ⟩
    · left
      refine ⟨V₁ * algebraMap (Polynomial ↥W) (Localization.AtPrime 𝔭) (Polynomial.C ρ) * U₂, ?_⟩
      rw [hρ, map_mul, map_mul]
      calc _ = algebraMap (Polynomial ↥W) (Localization.AtPrime 𝔭) (Polynomial.C γ₁) *
              algebraMap (Polynomial ↥W) (Localization.AtPrime 𝔭) (Polynomial.C ρ) * U₂ * 1 := by
            rw [mul_one]
        _ = _ := by rw [← hV₁]; ring
    · right
      refine ⟨V₂ * algebraMap (Polynomial ↥W) (Localization.AtPrime 𝔭) (Polynomial.C ρ) * U₁, ?_⟩
      rw [hρ, map_mul, map_mul]
      calc _ = algebraMap (Polynomial ↥W) (Localization.AtPrime 𝔭) (Polynomial.C γ₂) *
              algebraMap (Polynomial ↥W) (Localization.AtPrime 𝔭) (Polynomial.C ρ) * U₁ * 1 := by
            rw [mul_one]
        _ = _ := by rw [← hV₂]; ring

  have s3gen : ∀ (A E : Type u) [CommRing A] [IsDomain A] [CommRing E] [Algebra A E]
      [Algebra.Etale A E] (𝔭 : Ideal A) [𝔭.IsPrime] (q : Ideal E) [q.IsPrime],
      Ideal.comap (algebraMap A E) q = 𝔭 → (∀ x y : Localization.AtPrime 𝔭, x ∣ y ∨ y ∣ x) →
      ∀ I : Ideal (Localization.AtPrime q), Module.Flat (Localization.AtPrime q) ↥I := by
    intro A E _ _ _ _ _ 𝔭 _ q _ hq hG I
    let φ : Localization.AtPrime 𝔭 →+* Localization.AtPrime q :=
      Localization.localRingHom 𝔭 q (algebraMap A E) hq.symm
    letI : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime q) := φ.toAlgebra
    haveI : IsScalarTower A (Localization.AtPrime 𝔭) (Localization.AtPrime q) := by
      apply IsScalarTower.of_algebraMap_eq
      intro a
      show algebraMap A (Localization.AtPrime q) a = φ (algebraMap A (Localization.AtPrime 𝔭) a)
      rw [Localization.localRingHom_to_map,
        IsScalarTower.algebraMap_apply A E (Localization.AtPrime q)]
    haveI hflatA : Module.Flat A (Localization.AtPrime q) := inferInstance
    haveI hflatG : Module.Flat (Localization.AtPrime 𝔭) (Localization.AtPrime q) := by
      haveI := isLocalizedModule_id 𝔭.primeCompl (Localization.AtPrime q) (Localization.AtPrime 𝔭)
      exact Module.Flat.of_isLocalizedModule (Localization.AtPrime 𝔭) 𝔭.primeCompl
        (LinearMap.id : Localization.AtPrime q →ₗ[A] Localization.AtPrime q)
    haveI : ValuationRing (Localization.AtPrime 𝔭) := ValuationRing.iff_dvd_total.mpr ⟨hG⟩
    haveI : Module.Flat (Localization.AtPrime 𝔭) I := by
      rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout]
      rw [eq_bot_iff]
      intro i hi
      rw [Submodule.mem_torsion_iff] at hi
      obtain ⟨g, hg⟩ := hi
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors
        (R := Localization.AtPrime 𝔭) (M := Localization.AtPrime q) g.2
      rw [Submodule.mem_bot]
      apply Subtype.ext
      apply hreg
      have := congrArg Subtype.val hg
      show (g : Localization.AtPrime 𝔭) • (i : Localization.AtPrime q) =
        (g : Localization.AtPrime 𝔭) • ((0 : I) : Localization.AtPrime q)
      rw [ZeroMemClass.coe_zero, smul_zero]
      exact this
    haveI : Algebra.FormallyUnramified A (Localization.AtPrime q) := inferInstance
    haveI : Algebra.EssFiniteType A (Localization.AtPrime q) := inferInstance
    haveI : Algebra.FormallyUnramified (Localization.AtPrime 𝔭) (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.localization_base 𝔭.primeCompl
    haveI : Algebra.EssFiniteType (Localization.AtPrime 𝔭) (Localization.AtPrime q) :=
      Algebra.EssFiniteType.of_comp A _ _
    exact Algebra.FormallyUnramified.flat_of_restrictScalars (Localization.AtPrime 𝔭)
      (Localization.AtPrime q) I
  have s3 : ∀ I : Ideal (Localization.AtPrime q), Module.Flat (Localization.AtPrime q) ↥I :=
    s3gen (Polynomial ↥W) E 𝔭 q hq s2

  have s4 : ∀ x y : Localization.AtPrime q, x ∣ y ∨ y ∣ x := by
    intro x y
    have hflat := s3 (Ideal.span {x, y})
    have hx : x ∈ Ideal.span {x, y} := Ideal.subset_span (by simp)
    have hy : y ∈ Ideal.span {x, y} := Ideal.subset_span (by simp)
    have hrel : ∑ i, (![y, -x] i) • (![⟨x, hx⟩, ⟨y, hy⟩] : Fin 2 → ↥(Ideal.span {x, y})) i = 0 := by
      apply Subtype.ext
      simp [Fin.sum_univ_two]
      ring
    obtain ⟨k, a, z, hz, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    have hzm : ∀ j, ∃ r t : Localization.AtPrime q, r * x + t * y = (z j : Localization.AtPrime q) :=
      fun j => Ideal.mem_span_pair.mp (z j).2
    choose r t hrt using hzm
    have h0 := congrArg Subtype.val (hz 0)
    simp only [Matrix.cons_val_zero, Submodule.coe_sum,
      Submodule.coe_smul, smul_eq_mul] at h0
    have ha' : ∀ j, y * a 0 j = x * a 1 j := by
      intro j
      have := ha j
      simp [Fin.sum_univ_two] at this
      linear_combination this
    set α := ∑ j, a 0 j * r j with hα
    set β := ∑ j, a 0 j * t j with hβ
    set γ := ∑ j, a 1 j * r j with hγ
    have E1 : x = α * x + β * y := by
      have e : α * x + β * y = ∑ j, a 0 j * (z j : Localization.AtPrime q) := by
        rw [hα, hβ, Finset.sum_mul, Finset.sum_mul, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro j _
        rw [← hrt j]
        ring
      rw [e]; exact h0
    have E2 : α * y = x * γ := by
      rw [hα, hγ, Finset.sum_mul, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      linear_combination r j * ha' j
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self α with hu | hu
    · left
      obtain ⟨w, hw⟩ := hu.exists_left_inv
      refine ⟨γ * w, ?_⟩
      linear_combination w * E2 - y * hw
    · right
      obtain ⟨w, hw⟩ := hu.exists_left_inv
      refine ⟨β * w, ?_⟩
      linear_combination w * E1 - x * hw

  haveI hBnzd : NoZeroDivisors (Localization.AtPrime q) := by
    refine ⟨fun {x y} hxy => ?_⟩
    have hflat := s3 (Ideal.span {x})
    have hx : x ∈ Ideal.span {x} := Ideal.subset_span (Set.mem_singleton x)
    have hrel : ∑ i, (![y] i) • (![⟨x, hx⟩] : Fin 1 → ↥(Ideal.span {x})) i = 0 := by
      apply Subtype.ext
      simp only [Fin.sum_univ_one, Matrix.cons_val_zero, Submodule.coe_smul, smul_eq_mul,
        ZeroMemClass.coe_zero]
      rw [mul_comm]; exact hxy
    obtain ⟨k, a, z, hz, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    have hzm : ∀ j, ∃ r : Localization.AtPrime q, r * x = (z j : Localization.AtPrime q) :=
      fun j => Ideal.mem_span_singleton'.mp (z j).2
    choose r hr using hzm
    have h0 := congrArg Subtype.val (hz 0)
    simp only [Matrix.cons_val_zero, Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul] at h0
    have ha' : ∀ j, y * a 0 j = 0 := by
      intro j
      have := ha j
      simpa [Fin.sum_univ_one] using this
    set α := ∑ j, a 0 j * r j with hα
    have E1 : x = α * x := by
      have e : α * x = ∑ j, a 0 j * (z j : Localization.AtPrime q) := by
        rw [hα, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro j _
        rw [← hr j]; ring
      rw [e]; exact h0
    have E2 : y * α = 0 := by
      rw [hα, Finset.mul_sum]
      apply Finset.sum_eq_zero
      intro j _
      rw [← mul_assoc, ha' j, zero_mul]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self α with hu | hu
    · right
      obtain ⟨w, hw⟩ := hu.exists_left_inv
      calc y = y * (w * α) := by rw [hw, mul_one]
        _ = w * (y * α) := by ring
        _ = 0 := by rw [E2, mul_zero]
    · left
      obtain ⟨w, hw⟩ := hu.exists_left_inv
      calc x = (w * (1 - α)) * x := by rw [hw, one_mul]
        _ = w * (x - α * x) := by ring
        _ = 0 := by rw [← E1, sub_self, mul_zero]
  haveI hBd : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _

  set σ : ↥W →+* Localization.AtPrime q :=
    (algebraMap E (Localization.AtPrime q)).comp ((algebraMap (Polynomial ↥W) E).comp Polynomial.C)
    with hσdef
  have hσA : ∀ γ : ↥W, σ γ = algebraMap (Polynomial ↥W) (Localization.AtPrime q) (Polynomial.C γ) := by
    intro γ
    rw [IsScalarTower.algebraMap_apply (Polynomial ↥W) E (Localization.AtPrime q)]
    rfl
  have hσinj : Function.Injective σ := by
    rw [injective_iff_map_eq_zero]
    intro γ hγ
    by_contra hne
    have hC : Polynomial.C γ ∈ nonZeroDivisors (Polynomial ↥W) :=
      mem_nonZeroDivisors_of_ne_zero (Polynomial.C_ne_zero.mpr hne)
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors
      (R := Polynomial ↥W) (M := Localization.AtPrime q) hC
    apply one_ne_zero (α := Localization.AtPrime q)
    apply hreg
    show Polynomial.C γ • (1 : Localization.AtPrime q) = Polynomial.C γ • 0
    rw [smul_zero, Algebra.smul_def, mul_one, ← hσA]
    exact hγ

  have s5 : ∀ (N : ℕ) (c : ℕ → ↥W) (u : ℕ → Localization.AtPrime q) (b : Localization.AtPrime q),
      (∃ i ≤ N, c i ≠ 0) → (∀ i ≤ N, IsUnit (u i)) →
      ∑ i ∈ Finset.range (N + 1), σ (c i) * u i * b ^ i = 0 →
      ∃ (δ : ↥W) (v : Localization.AtPrime q), IsUnit v ∧ b = σ δ * v := by
    intro N c u b hc hu hrel
    by_cases hb : b = 0
    · exact ⟨0, 1, isUnit_one, by simp [hb]⟩
    set t : ℕ → Localization.AtPrime q := fun i => σ (c i) * u i * b ^ i with ht
    set S := (Finset.range (N + 1)).filter (fun i => c i ≠ 0) with hS
    have hσ0 : ∀ x : ↥W, x ≠ 0 → σ x ≠ 0 := fun x hx h0 =>
      hx (hσinj (h0.trans (map_zero σ).symm))
    have hmemS : ∀ i ∈ S, i ≤ N ∧ c i ≠ 0 := by
      intro i hi
      rw [hS, Finset.mem_filter, Finset.mem_range] at hi
      exact ⟨by omega, hi.2⟩
    have ht0 : ∀ i ∈ S, t i ≠ 0 := by
      intro i hi
      obtain ⟨hiN, hci⟩ := hmemS i hi
      exact mul_ne_zero (mul_ne_zero (hσ0 _ hci) (hu i hiN).ne_zero) (pow_ne_zero _ hb)
    have hsumS : ∑ i ∈ S, t i = 0 := by
      rw [hS, Finset.sum_filter_of_ne]
      · exact hrel
      · intro i _ hne h0
        apply hne
        show σ (c i) * u i * b ^ i = 0
        rw [h0, map_zero, zero_mul, zero_mul]
    have hSne : S.Nonempty := by
      obtain ⟨i, hi, hci⟩ := hc
      exact ⟨i, by rw [hS, Finset.mem_filter, Finset.mem_range]; exact ⟨by omega, hci⟩⟩
    have hmin : ∀ T : Finset ℕ, T.Nonempty → ∃ j ∈ T, ∀ i ∈ T, t j ∣ t i := by
      intro T
      induction T using Finset.induction_on with
      | empty => intro h; exact absurd h Finset.not_nonempty_empty
      | insert a T haT ih =>
        intro _
        by_cases hT : T.Nonempty
        · obtain ⟨j, hj, hjT⟩ := ih hT
          rcases s4 (t a) (t j) with h | h
          · refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
            intro i hi
            rcases Finset.mem_insert.mp hi with rfl | hi
            · exact dvd_rfl
            · exact h.trans (hjT i hi)
          · refine ⟨j, Finset.mem_insert_of_mem hj, ?_⟩
            intro i hi
            rcases Finset.mem_insert.mp hi with rfl | hi
            · exact h
            · exact hjT i hi
        · rw [Finset.not_nonempty_iff_eq_empty] at hT
          subst hT
          refine ⟨a, Finset.mem_insert_self _ _, ?_⟩
          intro i hi
          rw [Finset.mem_insert] at hi
          rcases hi with rfl | hi
          · exact dvd_rfl
          · simp at hi
    obtain ⟨j, hjS, hjmin⟩ := hmin S hSne
    have htwice : ∃ i ∈ S, i ≠ j ∧ t i ∣ t j := by
      by_contra hcon
      push_neg at hcon
      have hm : ∀ i ∈ S, ∃ m : Localization.AtPrime q, t i = t j * m := fun i hi => hjmin i hi
      choose! m hm using hm
      have hmn : ∀ i ∈ S.erase j, m i ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
        intro i hi
        obtain ⟨hij, hiS⟩ := Finset.mem_erase.mp hi
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hmu
        apply hcon i hiS hij
        obtain ⟨w, hw⟩ := hmu.exists_left_inv
        exact ⟨w, by rw [hm i hiS, mul_assoc, mul_comm (m i) w, hw, mul_one]⟩
      have hM : ∑ i ∈ S.erase j, m i ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        Ideal.sum_mem _ hmn
      have hsplit : ∑ i ∈ S, t i = t j * (1 + ∑ i ∈ S.erase j, m i) := by
        rw [← Finset.add_sum_erase S t hjS, mul_add, mul_one, Finset.mul_sum]
        congr 1
        apply Finset.sum_congr rfl
        intro i hi
        exact hm i (Finset.mem_of_mem_erase hi)
      have hunit : IsUnit (1 + ∑ i ∈ S.erase j, m i) := by
        by_contra hnu
        have h1 : (1 + ∑ i ∈ S.erase j, m i) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hnu
        have h2 : (1 : Localization.AtPrime q) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          have := Ideal.sub_mem _ h1 hM
          rwa [add_sub_cancel_right] at this
        exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime q)).ne_top
          ((Ideal.eq_top_iff_one _).mpr h2)
      rw [hsplit] at hsumS
      exact ht0 j hjS ((mul_eq_zero.mp hsumS).resolve_right hunit.ne_zero)
    obtain ⟨i, hiS, hij, hidvd⟩ := htwice
    have hassoc : ∀ x y : Localization.AtPrime q, x ≠ 0 → x ∣ y → y ∣ x →
        ∃ w : Localization.AtPrime q, IsUnit w ∧ y = x * w := by
      intro x y hx ⟨w, hw⟩ ⟨e, he⟩
      refine ⟨w, ?_, hw⟩
      have : x * (w * e) = x * 1 := by rw [mul_one, ← mul_assoc, ← hw, ← he]
      exact isUnit_iff_exists_inv.mpr ⟨e, mul_left_cancel₀ hx this⟩
    have hhl : ∃ h ∈ S, ∃ l ∈ S, l < h ∧ ∃ w : Localization.AtPrime q, IsUnit w ∧ t h = t l * w := by
      rcases lt_or_gt_of_ne hij with hlt | hlt
      · obtain ⟨w, hw, hw'⟩ := hassoc (t i) (t j) (ht0 i hiS) hidvd (hjmin i hiS)
        exact ⟨j, hjS, i, hiS, hlt, w, hw, hw'⟩
      · obtain ⟨w, hw, hw'⟩ := hassoc (t j) (t i) (ht0 j hjS) (hjmin i hiS) hidvd
        exact ⟨i, hiS, j, hjS, hlt, w, hw, hw'⟩
    obtain ⟨h, hhS, l, hlS, hlh, w, hw, hthl⟩ := hhl
    obtain ⟨hhN, hch⟩ := hmemS h hhS
    obtain ⟨hlN, hcl⟩ := hmemS l hlS
    set n := h - l with hn
    have hn1 : 1 ≤ n := by omega
    have hpow : b ^ h = b ^ l * b ^ n := by rw [← pow_add]; congr 1; omega
    obtain ⟨uh', huh'⟩ := (hu h hhN).exists_left_inv
    have hkey : σ (c h) * b ^ n = σ (c l) * (u l * w * uh') := by
      have e1 : σ (c h) * u h * (b ^ l * b ^ n) = σ (c l) * u l * b ^ l * w := by
        rw [← hpow]; exact hthl
      have e2 : b ^ l * (σ (c h) * b ^ n) = b ^ l * (σ (c l) * (u l * w * uh')) := by
        linear_combination uh' * e1 - σ (c h) * b ^ l * b ^ n * huh'
      exact mul_left_cancel₀ (pow_ne_zero l hb) e2
    have hw' : IsUnit (u l * w * uh') :=
      ((hu l hlN).mul hw).mul (isUnit_iff_exists_inv.mpr ⟨u h, huh'⟩)
    set w' := u l * w * uh' with hw'def
    rcases ValuationRing.dvd_total (c h) (c l) with ⟨ρ, hρ⟩ | ⟨ρ, hρ⟩
    · have hρ0 : ρ ≠ 0 := by rintro rfl; rw [mul_zero] at hρ; exact hcl hρ
      have hbn : b ^ n = σ ρ * w' := by
        apply mul_left_cancel₀ (hσ0 _ hch)
        rw [hkey, hρ, map_mul]; ring
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((ρ : ↥W) : Ω) (by omega : 0 < n)
      have hρΩ : ((ρ : ↥W) : Ω) ≠ 0 := by
        intro h0; apply hρ0; exact Subtype.ext h0
      have hz0 : z ≠ 0 := by rintro rfl; rw [zero_pow (by omega)] at hz; exact hρΩ hz.symm
      have hzW : z ∈ W := by
        rcases W.mem_or_inv_mem z with hzW | hzW
        · exact hzW
        · set y : ↥W := ⟨z⁻¹, hzW⟩ with hy
          have hyρ : y ^ n * ρ = 1 := by
            apply Subtype.ext
            simp only [hy, SubmonoidClass.coe_pow, MulMemClass.coe_mul, OneMemClass.coe_one]
            rw [← hz, inv_pow, inv_mul_cancel₀ (pow_ne_zero _ hz0)]
          have hyu : IsUnit y := (isUnit_pow_iff (by omega : n ≠ 0)).mp
            (isUnit_iff_exists_inv.mpr ⟨ρ, hyρ⟩)
          obtain ⟨y', hy'⟩ := hyu.exists_right_inv
          have hy'Ω : ((y' : ↥W) : Ω) = z := by
            have := congrArg (Subtype.val) hy'
            simp only [hy, MulMemClass.coe_mul, OneMemClass.coe_one] at this
            field_simp at this
            exact this
          rw [← hy'Ω]; exact y'.2
      set δ : ↥W := ⟨z, hzW⟩ with hδ
      have hδn : δ ^ n = ρ := Subtype.ext (by simp only [hδ, SubmonoidClass.coe_pow]; exact hz)
      have hδ0 : δ ≠ 0 := by
        intro h0; rw [h0, zero_pow (by omega)] at hδn; exact hρ0 hδn.symm
      have hbn' : b ^ n = σ δ ^ n * w' := by rw [hbn, ← hδn, map_pow]
      rcases s4 b (σ δ) with ⟨v', hv'⟩ | ⟨v, hv⟩
      · have e1 : b ^ n * 1 = b ^ n * (v' ^ n * w') := by
          rw [mul_one]; nth_rewrite 1 [hbn', hv']; ring
        have e2 := mul_left_cancel₀ (pow_ne_zero n hb) e1
        have hv'u : IsUnit v' := (isUnit_pow_iff (by omega : n ≠ 0)).mp
          (isUnit_iff_exists_inv.mpr ⟨w', e2.symm⟩)
        refine ⟨δ, ↑hv'u.unit⁻¹, Units.isUnit _, ?_⟩
        rw [hv', mul_assoc, IsUnit.mul_val_inv, mul_one]
      · refine ⟨δ, v, ?_, hv⟩
        have e1 : σ δ ^ n * v ^ n = σ δ ^ n * w' := by rw [← mul_pow, ← hv, hbn']
        have e2 := mul_left_cancel₀ (pow_ne_zero n (hσ0 δ hδ0)) e1
        exact (isUnit_pow_iff (by omega : n ≠ 0)).mp (e2 ▸ hw')
    · have hbn : σ ρ * b ^ n = w' := by
        apply mul_left_cancel₀ (hσ0 _ hcl)
        rw [← hkey, hρ, map_mul]; ring
      have hbu : IsUnit b := by
        have e : b * (σ ρ * b ^ (n - 1)) = w' := by
          rw [← hbn]
          have : b ^ n = b * b ^ (n - 1) := by rw [← pow_succ']; congr 1; omega
          rw [this]; ring
        exact isUnit_of_mul_isUnit_left (e ▸ hw')
      exact ⟨1, b, hbu, by rw [map_one, one_mul]⟩

  have halg : ∀ (A E : Type u) [CommRing A] [IsDomain A] [CommRing E] [Algebra A E]
      [Algebra.Etale A E] (y : E), ∃ c : Polynomial A, c ≠ 0 ∧ Polynomial.aeval y c = 0 := by
    intro A E _ _ _ _ _ y
    have : Module.Finite (FractionRing A) (TensorProduct A (FractionRing A) E) :=
      Algebra.FormallyUnramified.finite_of_free (FractionRing A) (TensorProduct A (FractionRing A) E)
    have hx : IsIntegral (FractionRing A)
        (Algebra.TensorProduct.includeRight y : TensorProduct A (FractionRing A) E) :=
      Algebra.IsIntegral.isIntegral _
    obtain ⟨p, hpm, hpx⟩ := hx
    have hp0 : p ≠ 0 := hpm.ne_zero
    have hc₀ : IsLocalization.integerNormalization (nonZeroDivisors A) p ≠ 0 := by
      intro h
      exact hp0 ((IsFractionRing.integerNormalization_eq_zero_iff (K := FractionRing A)).mp h)
    have hc₀x : Polynomial.aeval
        (Algebra.TensorProduct.includeRight y : TensorProduct A (FractionRing A) E)
        (IsLocalization.integerNormalization (nonZeroDivisors A) p) = 0 :=
      IsLocalization.integerNormalization_aeval_eq_zero (M := nonZeroDivisors A)
        (R' := TensorProduct A (FractionRing A) E) p hpx
    rw [Polynomial.aeval_algHom_apply, Algebra.TensorProduct.includeRight_apply] at hc₀x
    have hmk : TensorProduct.mk A (FractionRing A) E 1
        (Polynomial.aeval y (IsLocalization.integerNormalization (nonZeroDivisors A) p)) =
        TensorProduct.mk A (FractionRing A) E 1 0 := by
      rw [TensorProduct.mk_apply, TensorProduct.mk_apply, hc₀x, TensorProduct.tmul_zero]
    obtain ⟨s, hs⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors A) hmk
    refine ⟨Polynomial.C (s : A) * IsLocalization.integerNormalization (nonZeroDivisors A) p, ?_, ?_⟩
    · exact mul_ne_zero (Polynomial.C_ne_zero.mpr (nonZeroDivisors.ne_zero s.2)) hc₀
    · rw [map_mul, Polynomial.aeval_C, ← Algebra.smul_def]
      rw [smul_zero] at hs
      exact hs
  obtain ⟨P, hP0, hPb⟩ := halg (Polynomial ↥W) E b
  choose cf pf hcp hpf using fun i => s1 (P.coeff i)
  set N := P.natDegree with hN
  have hunit : ∀ i, IsUnit (algebraMap (Polynomial ↥W) (Localization.AtPrime q) (pf i)) := by
    intro i
    rw [IsScalarTower.algebraMap_apply (Polynomial ↥W) E (Localization.AtPrime q),
      IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q]
    intro hmem
    apply hpf i
    rw [← hq, Ideal.mem_comap]
    exact hmem
  have hcN : ∃ i ≤ N, cf i ≠ 0 := by
    refine ⟨N, le_rfl, ?_⟩
    intro h0
    apply hP0
    apply Polynomial.leadingCoeff_eq_zero.mp
    rw [Polynomial.leadingCoeff, ← hN, hcp N, h0, map_zero, zero_mul]
  have hrel : ∑ i ∈ Finset.range (N + 1), σ (cf i) *
      algebraMap (Polynomial ↥W) (Localization.AtPrime q) (pf i) *
      (algebraMap E (Localization.AtPrime q) b) ^ i = 0 := by
    have h := congrArg (algebraMap E (Localization.AtPrime q)) hPb
    rw [Polynomial.aeval_eq_sum_range, map_sum, map_zero] at h
    rw [← h]
    apply Finset.sum_congr rfl
    intro i _
    rw [Algebra.smul_def, map_mul, map_pow, hσA, ← map_mul, ← hcp i,
      IsScalarTower.algebraMap_apply (Polynomial ↥W) E (Localization.AtPrime q)]
  obtain ⟨δ, v, hv, hbv⟩ := s5 N cf _ _ hcN (fun i _ => hunit i) hrel

  obtain ⟨⟨e, t⟩, hvet⟩ := IsLocalization.mk'_surjective q.primeCompl v
  simp only at hvet
  have he : e ∈ q.primeCompl := by
    rw [← IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime q) q e t, hvet]
    exact hv
  have h1 : algebraMap E (Localization.AtPrime q) (b * t) =
      algebraMap E (Localization.AtPrime q) (algebraMap (Polynomial ↥W) E (Polynomial.C δ) * e) := by
    rw [map_mul, hbv, ← hvet, map_mul, mul_assoc, IsLocalization.mk'_spec]
    rfl
  obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists q.primeCompl (Localization.AtPrime q)).mp h1
  refine ⟨δ, c * e, c * t, ?_, ?_, ?_⟩
  · intro hm
    rcases hqP.mem_or_mem hm with h | h
    · exact c.2 h
    · exact he h
  · intro hm
    rcases hqP.mem_or_mem hm with h | h
    · exact c.2 h
    · exact t.2 h
  · linear_combination hc

theorem wcNd_hzf_isolated_quasiFiniteAt : ∀ (Q S : Type u) [CommRing Q] [IsLocalRing Q] [CommRing S] [Algebra Q S] [Algebra.FiniteType Q S] (𝔫 : Ideal S) [𝔫.IsPrime], 𝔫.IsMaximal → Ideal.comap (algebraMap Q S) 𝔫 = IsLocalRing.maximalIdeal Q → (∀ 𝔑 : Ideal S, 𝔑.IsPrime → Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q) ≤ 𝔑 → 𝔑 ≤ 𝔫 → 𝔑 = 𝔫) → Algebra.QuasiFiniteAt Q 𝔫 :=
by
  intro Q S _ _ _ _ _ 𝔫 _ hmax hcomap hmin
  classical

  have hfin : (Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q)).minimalPrimes.Finite := by
    letI : Field (Q ⧸ IsLocalRing.maximalIdeal Q) := Ideal.Quotient.field _
    haveI : Algebra.FiniteType (Q ⧸ IsLocalRing.maximalIdeal Q)
        (S ⧸ Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q)) :=
      Algebra.FiniteType.of_restrictScalars_finiteType Q _ _
    haveI : IsNoetherianRing (S ⧸ Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q)) :=
      Algebra.FiniteType.isNoetherianRing (Q ⧸ IsLocalRing.maximalIdeal Q) _
    rw [Ideal.minimalPrimes_eq_comap]
    exact (minimalPrimes.finite_of_isNoetherianRing _).image _

  have hex : ∀ 𝔭 ∈ (Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q)).minimalPrimes,
      𝔭 ≠ 𝔫 → ∃ a, a ∈ 𝔭 ∧ a ∉ 𝔫 := by
    intro 𝔭 h𝔭 hne
    by_contra hcon
    push_neg at hcon
    exact hne (hmin 𝔭 h𝔭.1.1 h𝔭.1.2 hcon)
  choose! g hg using hex
  let s := hfin.toFinset.filter (· ≠ 𝔫)
  let t := ∏ 𝔭 ∈ s, g 𝔭
  have ht𝔫 : t ∉ 𝔫 := by
    intro h
    obtain ⟨𝔭, h𝔭s, h𝔭⟩ := (Ideal.IsPrime.prod_mem_iff (p := 𝔫)).mp h
    rw [Finset.mem_filter, Set.Finite.mem_toFinset] at h𝔭s
    exact (hg 𝔭 h𝔭s.1 h𝔭s.2).2 h𝔭
  have htp : ∀ 𝔭 ∈ (Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q)).minimalPrimes,
      𝔭 ≠ 𝔫 → t ∈ 𝔭 := by
    intro 𝔭 h𝔭 hne
    have hs : 𝔭 ∈ s := by
      rw [Finset.mem_filter, Set.Finite.mem_toFinset]; exact ⟨h𝔭, hne⟩
    exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem g hs) (hg 𝔭 h𝔭 hne).1

  apply Algebra.QuasiFiniteAt.of_isOpen_singleton_fiber (R := Q)
    (⟨𝔫, inferInstance⟩ : PrimeSpectrum S)
  have heq : ({⟨(⟨𝔫, inferInstance⟩ : PrimeSpectrum S), rfl⟩} :
      Set (PrimeSpectrum.comap (algebraMap Q S) ⁻¹'
        {PrimeSpectrum.comap (algebraMap Q S) (⟨𝔫, inferInstance⟩ : PrimeSpectrum S)})) =
      Subtype.val ⁻¹' (PrimeSpectrum.basicOpen t : Set (PrimeSpectrum S)) := by
    ext ⟨y, hy⟩
    rw [Set.mem_singleton_iff, Set.mem_preimage, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    constructor
    · intro h
      have hy0 : y = ⟨𝔫, inferInstance⟩ := congrArg Subtype.val h
      subst hy0
      exact ht𝔫
    · intro hty
      have hy2 : PrimeSpectrum.comap (algebraMap Q S) y =
          PrimeSpectrum.comap (algebraMap Q S) (⟨𝔫, inferInstance⟩ : PrimeSpectrum S) := hy
      have hy' : Ideal.comap (algebraMap Q S) y.asIdeal = Ideal.comap (algebraMap Q S) 𝔫 :=
        congrArg PrimeSpectrum.asIdeal hy2
      have hIy : Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q) ≤ y.asIdeal := by
        rw [Ideal.map_le_iff_le_comap, hy', hcomap]
      obtain ⟨𝔭, h𝔭, h𝔭y⟩ := Ideal.exists_minimalPrimes_le hIy
      have h𝔭eq : 𝔭 = 𝔫 := by
        by_contra hne
        exact hty (h𝔭y (htp 𝔭 h𝔭 hne))
      rw [h𝔭eq] at h𝔭y
      have h2 : 𝔫 = y.asIdeal := hmax.eq_of_le y.isPrime.ne_top h𝔭y
      apply Subtype.ext
      apply PrimeSpectrum.ext
      exact h2.symm
  rw [heq]
  exact PrimeSpectrum.isOpen_basicOpen.preimage continuous_subtype_val

theorem wcNd_hzf_zmt_subalgebra : ∀ (Q S : Type u) [CommRing Q] [CommRing S] [Algebra Q S] [Algebra.FiniteType Q S] (𝔫 : Ideal S) [𝔫.IsPrime], Algebra.QuasiFiniteAt Q 𝔫 → ∃ (S' : Subalgebra Q S) (r : S), r ∈ S' ∧ r ∉ 𝔫 ∧ Module.Finite Q ↥S' ∧ ∀ s : S, ∃ M : ℕ, r ^ M * s ∈ S' :=
by
  intro Q S _ _ _ _ 𝔫 _ h𝔫
  classical
  haveI : Algebra.QuasiFiniteAt Q 𝔫 := h𝔫
  have hZ : Algebra.ZariskisMainProperty Q 𝔫 := Algebra.ZariskisMainProperty.of_finiteType 𝔫
  obtain ⟨r, hr𝔫, hrint, hm⟩ := Algebra.zariskisMainProperty_iff.mp hZ
  choose m hm using hm
  obtain ⟨t, htop⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra Q S).FG)
  let T : Set S := {r} ∪ (fun g => r ^ m g * g) '' (t : Set S)
  have hTfin : T.Finite := (Set.finite_singleton r).union (t.finite_toSet.image _)
  have hTint : ∀ x ∈ T, IsIntegral Q x := by
    rintro x (hx | ⟨g, -, rfl⟩)
    · rw [Set.mem_singleton_iff.mp hx]; exact hrint
    · exact hm g
  have hfin : Module.Finite Q ↥(Algebra.adjoin Q T) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral hTfin hTint
  have hrS' : r ∈ Algebra.adjoin Q T := Algebra.subset_adjoin (Set.mem_union_left _ rfl)
  refine ⟨Algebra.adjoin Q T, r, hrS', hr𝔫, hfin, ?_⟩
  intro s
  have hs : s ∈ Algebra.adjoin Q (t : Set S) := by rw [htop]; exact Algebra.mem_top
  induction hs using Algebra.adjoin_induction with
  | mem x hx => exact ⟨m x, Algebra.subset_adjoin (Set.mem_union_right _ ⟨x, hx, rfl⟩)⟩
  | algebraMap a => exact ⟨0, by rw [pow_zero, one_mul]; exact Subalgebra.algebraMap_mem _ a⟩
  | add x y _ _ hx hy =>
    obtain ⟨M₁, h₁⟩ := hx
    obtain ⟨M₂, h₂⟩ := hy
    refine ⟨M₁ + M₂, ?_⟩
    have e : r ^ (M₁ + M₂) * (x + y) = r ^ M₂ * (r ^ M₁ * x) + r ^ M₁ * (r ^ M₂ * y) := by ring
    rw [e]
    exact add_mem (mul_mem (pow_mem hrS' _) h₁) (mul_mem (pow_mem hrS' _) h₂)
  | mul x y _ _ hx hy =>
    obtain ⟨M₁, h₁⟩ := hx
    obtain ⟨M₂, h₂⟩ := hy
    refine ⟨M₁ + M₂, ?_⟩
    have e : r ^ (M₁ + M₂) * (x * y) = (r ^ M₁ * x) * (r ^ M₂ * y) := by ring
    rw [e]
    exact mul_mem h₁ h₂

theorem wcNd_hzf_away_extend : ∀ (Q S T P : Type u) [CommRing Q] [CommRing S] [Algebra Q S] [CommRing T] [CommRing P] (S' : Subalgebra Q S) (r : S) (hr : r ∈ S'), (∀ s : S, ∃ M : ℕ, r ^ M * s ∈ S') → ∀ (κ : ↥S' →+* T) (l : T →+* P) (jS : S →+* P), IsUnit (κ ⟨r, hr⟩) → l.comp κ = jS.comp S'.val.toRingHom → ∃ j' : S →+* T, l.comp j' = jS :=
by
  intro Q S T P _ _ _ _ _ S' r hr hrM κ l jS hu hlκ
  classical
  choose M hM using hrM
  obtain ⟨v, huv⟩ : ∃ v : T, κ ⟨r, hr⟩ * v = 1 := ⟨(hu.unit⁻¹ : Tˣ), hu.mul_val_inv⟩
  have hpow : ∀ (N : ℕ) (h : r ^ N ∈ S'), κ ⟨r ^ N, h⟩ = κ ⟨r, hr⟩ ^ N := by
    intro N h
    have e : (⟨r ^ N, h⟩ : S') = (⟨r, hr⟩ : S') ^ N := Subtype.ext (by simp)
    rw [e, map_pow]
  have hshift : ∀ (s : S) (N K : ℕ) (h1 : r ^ N * s ∈ S') (h2 : r ^ (N + K) * s ∈ S'),
      κ ⟨r ^ N * s, h1⟩ * v ^ N = κ ⟨r ^ (N + K) * s, h2⟩ * v ^ (N + K) := by
    intro s N K h1 h2
    have e : (⟨r ^ (N + K) * s, h2⟩ : S') = ⟨r ^ K, S'.pow_mem hr K⟩ * ⟨r ^ N * s, h1⟩ :=
      Subtype.ext (by simp only [Subalgebra.coe_mul]; ring)
    rw [e, map_mul, hpow]
    calc κ ⟨r ^ N * s, h1⟩ * v ^ N
        = κ ⟨r ^ N * s, h1⟩ * v ^ N * (κ ⟨r, hr⟩ * v) ^ K := by rw [huv, one_pow, mul_one]
      _ = _ := by ring
  have hind : ∀ (s : S) (N K : ℕ) (h1 : r ^ N * s ∈ S') (h2 : r ^ K * s ∈ S'),
      κ ⟨r ^ N * s, h1⟩ * v ^ N = κ ⟨r ^ K * s, h2⟩ * v ^ K := by
    intro s N K h1 h2
    have h3 : r ^ (N + K) * s ∈ S' := by
      have e : r ^ (N + K) * s = r ^ K * (r ^ N * s) := by ring
      rw [e]; exact S'.mul_mem (S'.pow_mem hr K) h1
    have h4 : r ^ (K + N) * s ∈ S' := by rw [Nat.add_comm]; exact h3
    rw [hshift s N K h1 h3, hshift s K N h2 h4]
    have e : (⟨r ^ (N + K) * s, h3⟩ : S') = ⟨r ^ (K + N) * s, h4⟩ :=
      Subtype.ext (by simp only [Nat.add_comm N K])
    rw [e, Nat.add_comm N K]
  obtain ⟨f, hfdef⟩ : ∃ f : S → T, ∀ s, f s = κ ⟨r ^ M s * s, hM s⟩ * v ^ M s :=
    ⟨_, fun s => rfl⟩
  have hf : ∀ (s : S) (N : ℕ) (h : r ^ N * s ∈ S'), f s = κ ⟨r ^ N * s, h⟩ * v ^ N :=
    fun s N h => (hfdef s).trans (hind s (M s) N (hM s) h)
  let j' : S →+* T :=
    { toFun := f
      map_one' := by
        have h : r ^ 0 * (1 : S) ∈ S' := by simpa using S'.one_mem
        rw [hf 1 0 h]
        have e : (⟨r ^ 0 * 1, h⟩ : S') = 1 := Subtype.ext (by simp)
        rw [e, map_one, pow_zero, mul_one]
      map_mul' := by
        intro s t
        have h : r ^ (M s + M t) * (s * t) ∈ S' := by
          have e : r ^ (M s + M t) * (s * t) = (r ^ M s * s) * (r ^ M t * t) := by ring
          rw [e]; exact S'.mul_mem (hM s) (hM t)
        rw [hf (s * t) _ h, hfdef s, hfdef t]
        have e : (⟨r ^ (M s + M t) * (s * t), h⟩ : S') = ⟨_, hM s⟩ * ⟨_, hM t⟩ :=
          Subtype.ext (by simp only [Subalgebra.coe_mul]; ring)
        rw [e, map_mul, pow_add]
        ring
      map_zero' := by
        have h : r ^ 0 * (0 : S) ∈ S' := by simpa using S'.zero_mem
        rw [hf 0 0 h]
        have e : (⟨r ^ 0 * 0, h⟩ : S') = 0 := Subtype.ext (by simp)
        rw [e, map_zero, zero_mul]
      map_add' := by
        intro s t
        have h1 : r ^ (M s + M t) * s ∈ S' := by
          have e : r ^ (M s + M t) * s = r ^ M t * (r ^ M s * s) := by ring
          rw [e]; exact S'.mul_mem (S'.pow_mem hr _) (hM s)
        have h2 : r ^ (M s + M t) * t ∈ S' := by
          have e : r ^ (M s + M t) * t = r ^ M s * (r ^ M t * t) := by ring
          rw [e]; exact S'.mul_mem (S'.pow_mem hr _) (hM t)
        have h3 : r ^ (M s + M t) * (s + t) ∈ S' := by
          have e : r ^ (M s + M t) * (s + t) = r ^ (M s + M t) * s + r ^ (M s + M t) * t := by
            ring
          rw [e]; exact S'.add_mem h1 h2
        rw [hf (s + t) _ h3, hf s _ h1, hf t _ h2]
        have e : (⟨r ^ (M s + M t) * (s + t), h3⟩ : S') = ⟨_, h1⟩ + ⟨_, h2⟩ :=
          Subtype.ext (by simp only [Subalgebra.coe_add]; ring)
        rw [e, map_add, add_mul] }
  refine ⟨j', RingHom.ext fun s => ?_⟩
  show l (f s) = jS s
  have hl1 : l (κ ⟨r ^ M s * s, hM s⟩) = jS r ^ M s * jS s := by
    have := RingHom.congr_fun hlκ ⟨r ^ M s * s, hM s⟩
    rw [RingHom.comp_apply, RingHom.comp_apply] at this
    rw [this]
    show jS (r ^ M s * s) = _
    rw [map_mul, map_pow]
  have hl2 : l (κ ⟨r, hr⟩) = jS r := by
    have := RingHom.congr_fun hlκ ⟨r, hr⟩
    rw [RingHom.comp_apply, RingHom.comp_apply] at this
    exact this
  have hl3 : l (κ ⟨r, hr⟩) * l v = 1 := by rw [← map_mul, huv, map_one]
  rw [hfdef, map_mul, map_pow, hl1, ← hl2]
  calc l (κ ⟨r, hr⟩) ^ M s * jS s * l v ^ M s
      = (l (κ ⟨r, hr⟩) * l v) ^ M s * jS s := by ring
    _ = jS s := by rw [hl3, one_pow, one_mul]

theorem wcNd_hzf_local_factor : ∀ (Q B : Type u) [CommRing Q] [HenselianLocalRing Q] [CommRing B] [Algebra Q B], Module.Finite Q B → ∀ 𝔪 : Ideal B, 𝔪.IsPrime → ∃ e : B, IsIdempotentElem e ∧ e ∉ 𝔪 ∧ HenselianLocalRing (Localization.Away e) ∧ Module.Finite Q (Localization.Away e) :=
by
  intro Q B _ _ _ _ hB 𝔪 h𝔪
  classical
  have hI : IsLocalRing.maximalIdeal Q ≤ (⊥ : Ideal Q).jacobson :=
    IsLocalRing.maximalIdeal_le_jacobson ⊥
  have hR1 : ∀ (B : Type u) [CommRing B] [Algebra Q B] [Module.Finite Q B] (b : B),
      b * b - b ∈ (IsLocalRing.maximalIdeal Q).map (algebraMap Q B) →
      (∀ x : B, ∃ a : Q, b * x - algebraMap Q B a * b ∈
        (IsLocalRing.maximalIdeal Q).map (algebraMap Q B)) →
      ∃ e : B, IsIdempotentElem e ∧ e - b ∈ (IsLocalRing.maximalIdeal Q).map (algebraMap Q B) :=
    fun B _ _ _ b hb hrk => wc_hp_rank_one_idempotent_lift Q (IsLocalRing.maximalIdeal Q) B b hb hrk
  have hsec : ∀ (R : Type u) [CommRing R] [Algebra Q R] [Module.Finite Q R] (J : R)
      [Algebra.Etale Q (Localization.Away J)]
      (σ₀ : Localization.Away J →ₐ[Q] Q ⧸ IsLocalRing.maximalIdeal Q),
      ∃ σ : Localization.Away J →ₐ[Q] Q,
        (Ideal.Quotient.mkₐ Q (IsLocalRing.maximalIdeal Q)).comp σ = σ₀ :=
    fun R _ _ _ J _ σ₀ =>
      wc_hp_finite_away_section_lift Q (IsLocalRing.maximalIdeal Q) hI hR1 R J σ₀
  have Hidem := wc_idempotent_lift_of_factor_lift Q
    (fun f g₀ h₀ hf hg₀ hh₀ hcop hfac =>
      wc_hp_lift_coprime_factorization_of_section Q (IsLocalRing.maximalIdeal Q) hsec
        f hf g₀ h₀ hg₀ hh₀ hfac hcop)
  obtain ⟨n, e, hidem, -, hsum, hloc⟩ := wc_finite_alg_local_idempotents Q Hidem B hB
  have hex : ∃ i, e i ∉ 𝔪 := by
    by_contra h
    push_neg at h
    apply h𝔪.ne_top
    rw [Ideal.eq_top_iff_one, ← hsum]
    exact Ideal.sum_mem 𝔪 (fun i _ => h i)
  obtain ⟨i, hi⟩ := hex
  haveI := hloc i
  have hε : algebraMap B (Localization.Away (e i)) (e i) = 1 :=
    (IsIdempotentElem.iff_eq_one_of_isUnit (IsLocalization.Away.algebraMap_isUnit (e i))).mp
      ((hidem i).map (algebraMap B (Localization.Away (e i))))
  have hsurj : Function.Surjective (algebraMap B (Localization.Away (e i))) := by
    intro z
    obtain ⟨⟨a, ⟨s, k, rfl⟩⟩, hk⟩ :=
      IsLocalization.surj (Submonoid.powers (e i)) z
    simp only at hk
    rw [map_pow, hε, one_pow, mul_one] at hk
    exact ⟨a, hk.symm⟩
  have hBT : Module.Finite B (Localization.Away (e i)) :=
    RingHom.finite_algebraMap.mp (RingHom.Finite.of_surjective _ hsurj)
  have hTfin : Module.Finite Q (Localization.Away (e i)) := Module.Finite.trans B _
  have hTloc : IsLocalHom (algebraMap Q (Localization.Away (e i))) := by
    haveI : Algebra.IsIntegral Q (Localization.Away (e i)) := Algebra.IsIntegral.of_finite Q _
    have hmx : (Ideal.comap (algebraMap Q (Localization.Away (e i)))
        (IsLocalRing.maximalIdeal (Localization.Away (e i)))).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _
        (RingHom.IsIntegral.of_finite (RingHom.finite_algebraMap.mpr hTfin)) _
    have heq := IsLocalRing.eq_maximalIdeal hmx
    refine ⟨fun q hq => ?_⟩
    have hq' : q ∉ Ideal.comap (algebraMap Q (Localization.Away (e i)))
        (IsLocalRing.maximalIdeal (Localization.Away (e i))) := by
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]; exact hq
    rw [heq] at hq'
    exact IsLocalRing.notMem_maximalIdeal.mp hq'
  exact ⟨e i, hidem i, hi, wc_finite_local_henselian Q Hidem _ hTfin hTloc, hTfin⟩

theorem wcNd_hens_zmt_finite : ∀ (Q S P : Type u) [CommRing Q] [HenselianLocalRing Q] [CommRing S] [Algebra Q S] [Algebra.FiniteType Q S] [CommRing P] [HenselianLocalRing P] (jS : S →+* P), wcNdIsHens (Ideal.comap jS (IsLocalRing.maximalIdeal P)) P jS → IsLocalHom (jS.comp (algebraMap Q S)) → (∀ z : P, ∃ a : Q, z - jS (algebraMap Q S a) ∈ IsLocalRing.maximalIdeal P) → (∀ 𝔓 : Ideal P, 𝔓.IsPrime → Ideal.map (jS.comp (algebraMap Q S)) (IsLocalRing.maximalIdeal Q) ≤ 𝔓 → 𝔓 = IsLocalRing.maximalIdeal P) → (jS.comp (algebraMap Q S)).Finite :=
by
  intro Q S P _ _ _ _ _ _ _ jS hH hθ hres hiso
  classical
  haveI := hθ

  have hcomap : Ideal.comap (algebraMap Q S) (Ideal.comap jS (IsLocalRing.maximalIdeal P)) =
      IsLocalRing.maximalIdeal Q := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal,
      IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, mem_nonunits_iff]
    exact not_congr (isUnit_map_iff (jS.comp (algebraMap Q S)) a)
  have h𝔫max : (Ideal.comap jS (IsLocalRing.maximalIdeal P)).IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨?_, ?_⟩
    · intro h1
      rw [Ideal.mem_comap, map_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal P).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    · intro J x hle hx hxJ
      obtain ⟨a, ha⟩ := hres (jS x)
      have hθa : IsUnit (jS (algebraMap Q S a)) := by
        by_contra hna
        apply hx
        rw [Ideal.mem_comap]
        have hm : jS (algebraMap Q S a) ∈ IsLocalRing.maximalIdeal P :=
          (IsLocalRing.mem_maximalIdeal _).mpr hna
        have e : jS x = (jS x - jS (algebraMap Q S a)) + jS (algebraMap Q S a) := by ring
        rw [e]; exact Ideal.add_mem _ ha hm
      have hau : IsUnit a := (isUnit_map_iff (jS.comp (algebraMap Q S)) a).mp hθa
      obtain ⟨b, hb⟩ : ∃ b : Q, a * b = 1 := ⟨(hau.unit⁻¹ : Qˣ), hau.mul_val_inv⟩
      have hmem : x * algebraMap Q S b - 1 ∈ Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
        rw [Ideal.mem_comap, map_sub, map_mul, map_one]
        have hab : jS (algebraMap Q S a) * jS (algebraMap Q S b) = 1 := by
          rw [← map_mul, ← map_mul, hb, map_one, map_one]
        have e : jS x * jS (algebraMap Q S b) - 1 =
            (jS x - jS (algebraMap Q S a)) * jS (algebraMap Q S b) := by
          linear_combination hab
        rw [e]; exact Ideal.mul_mem_right _ _ ha
      have e : (1 : S) = x * algebraMap Q S b - (x * algebraMap Q S b - 1) := by ring
      rw [e]
      exact J.sub_mem (J.mul_mem_right _ hxJ) (hle hmem)
  haveI h𝔫prime : (Ideal.comap jS (IsLocalRing.maximalIdeal P)).IsPrime := h𝔫max.isPrime

  have hmin : ∀ 𝔑 : Ideal S, 𝔑.IsPrime →
      Ideal.map (algebraMap Q S) (IsLocalRing.maximalIdeal Q) ≤ 𝔑 →
      𝔑 ≤ Ideal.comap jS (IsLocalRing.maximalIdeal P) →
      𝔑 = Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
    intro 𝔑 h𝔑 hI hle
    haveI := h𝔑
    have hker : RingHom.ker (Ideal.Quotient.mk 𝔑) ≤ Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
      rw [Ideal.mk_ker]; exact hle
    have hp : ((Ideal.comap jS (IsLocalRing.maximalIdeal P)).map (Ideal.Quotient.mk 𝔑)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
    obtain ⟨V, _, hV, g, hginj, hgu⟩ := wcNd_hne_valuation_witness (S ⧸ 𝔑)
      ((Ideal.comap jS (IsLocalRing.maximalIdeal P)).map (Ideal.Quotient.mk 𝔑)) hp
    have hmemmap : ∀ s : S, Ideal.Quotient.mk 𝔑 s ∈
        (Ideal.comap jS (IsLocalRing.maximalIdeal P)).map (Ideal.Quotient.mk 𝔑) ↔
        s ∈ Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
      intro s
      constructor
      · intro hs
        rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hs
        obtain ⟨t, ht, hts⟩ := hs
        rw [Ideal.Quotient.eq] at hts
        have e : s = t - (t - s) := by ring
        rw [e]; exact Ideal.sub_mem _ ht (hle hts)
      · intro hs; exact Ideal.mem_map_of_mem _ hs
    have hcond : ∀ s, IsUnit ((g.comp (Ideal.Quotient.mk 𝔑)) s) ↔
        s ∉ Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
      intro s
      rw [RingHom.comp_apply, hgu, hmemmap]
    obtain ⟨h, ⟨hh, -⟩, -⟩ := hH.2.2 V hV (g.comp (Ideal.Quotient.mk 𝔑)) hcond
    have hbot : (⊥ : Ideal (S ⧸ 𝔑)) ∈ minimalPrimes (S ⧸ 𝔑) :=
      ⟨⟨inferInstance, le_rfl⟩, fun _ _ _ => bot_le⟩
    obtain ⟨p', hp', hp'g⟩ := Ideal.exists_comap_eq_of_mem_minimalPrimes_of_injective hginj ⊥ hbot
    have hc : Ideal.comap jS (Ideal.comap h p') = 𝔑 := by
      rw [Ideal.comap_comap, hh, ← Ideal.comap_comap, hp'g, ← RingHom.ker_eq_comap_bot,
        Ideal.mk_ker]
    have h𝔓 : (Ideal.comap h p').IsPrime := Ideal.comap_isPrime h p'
    have hle' : Ideal.map (jS.comp (algebraMap Q S)) (IsLocalRing.maximalIdeal Q) ≤
        Ideal.comap h p' := by
      rw [Ideal.map_le_iff_le_comap, ← Ideal.comap_comap, hc, ← Ideal.map_le_iff_le_comap]
      exact hI
    have h2 := hiso _ h𝔓 hle'
    rw [← hc, h2]

  have hqf := wcNd_hzf_isolated_quasiFiniteAt Q S (Ideal.comap jS (IsLocalRing.maximalIdeal P))
    h𝔫max hcomap hmin
  obtain ⟨S', r, hrS', hr𝔫, hS'fin, hrM⟩ :=
    wcNd_hzf_zmt_subalgebra Q S (Ideal.comap jS (IsLocalRing.maximalIdeal P)) hqf

  obtain ⟨e, -, he𝔫, hThens, hTfin⟩ := wcNd_hzf_local_factor Q S' hS'fin
    (Ideal.comap S'.val.toRingHom (Ideal.comap jS (IsLocalRing.maximalIdeal P)))
    (Ideal.comap_isPrime _ _)
  haveI := hThens
  have heu : IsUnit ((jS.comp S'.val.toRingHom) e) := (hH.2.1 _).mpr he𝔫
  let l : Localization.Away e →+* P :=
    IsLocalization.Away.lift (S := Localization.Away e) e (g := jS.comp S'.val.toRingHom) heu
  have hlκ : l.comp (algebraMap S' (Localization.Away e)) = jS.comp S'.val.toRingHom :=
    IsLocalization.Away.lift_comp _ _
  have hlalg : l.comp (algebraMap Q (Localization.Away e)) = jS.comp (algebraMap Q S) := by
    rw [IsScalarTower.algebraMap_eq Q S' (Localization.Away e), ← RingHom.comp_assoc, hlκ]
    exact RingHom.ext fun _ => rfl

  have hlloc : IsLocalHom l := by
    haveI : Algebra.IsIntegral Q (Localization.Away e) := Algebra.IsIntegral.of_finite Q _
    haveI hpr : (Ideal.comap l (IsLocalRing.maximalIdeal P)).IsPrime := Ideal.comap_isPrime _ _
    have hc : Ideal.comap (algebraMap Q (Localization.Away e))
        (Ideal.comap l (IsLocalRing.maximalIdeal P)) = IsLocalRing.maximalIdeal Q := by
      rw [Ideal.comap_comap, hlalg, ← Ideal.comap_comap]; exact hcomap
    have hmx : (Ideal.comap l (IsLocalRing.maximalIdeal P)).IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap Q (Localization.Away e))
        (RingHom.IsIntegral.of_finite (RingHom.finite_algebraMap.mpr hTfin)) _
        (by rw [hc]; exact IsLocalRing.maximalIdeal.isMaximal Q)
    have heq := IsLocalRing.eq_maximalIdeal hmx
    refine ⟨fun t ht => ?_⟩
    have ht' : t ∉ Ideal.comap l (IsLocalRing.maximalIdeal P) := by
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]; exact ht
    rw [heq] at ht'
    exact IsLocalRing.notMem_maximalIdeal.mp ht'

  have hκr : IsUnit (algebraMap S' (Localization.Away e) ⟨r, hrS'⟩) := by
    apply isUnit_of_map_unit l
    rw [← RingHom.comp_apply, hlκ]
    exact (hH.2.1 _).mpr hr𝔫
  obtain ⟨j', hj'⟩ := wcNd_hzf_away_extend Q S (Localization.Away e) P S' r hrS' hrM
    (algebraMap S' (Localization.Away e)) l jS hκr hlκ

  have hcondj : ∀ s, IsUnit (j' s) ↔ s ∉ Ideal.comap jS (IsLocalRing.maximalIdeal P) := by
    intro s
    rw [← hH.2.1 s]
    constructor
    · intro hu
      rw [← hj']
      exact hu.map l
    · intro hu
      apply isUnit_of_map_unit l
      rw [← RingHom.comp_apply, hj']
      exact hu
  obtain ⟨h, ⟨hh, hhloc⟩, -⟩ := hH.2.2 (Localization.Away e) hThens j' hcondj
  obtain ⟨k, -, hk⟩ := hH.2.2 P hH.1 jS hH.2.1
  have e1 : l.comp h = k := by
    apply hk
    refine ⟨?_, ?_⟩
    · rw [RingHom.comp_assoc, hh, hj']
    · haveI := hhloc
      exact RingHom.isLocalHom_comp l h
  have e2 : RingHom.id P = k := hk _ ⟨RingHom.id_comp _, inferInstance⟩
  have hsurj : Function.Surjective l := by
    intro z
    refine ⟨h z, ?_⟩
    have := congrArg (fun φ : P →+* P => φ z) (e1.trans e2.symm)
    simpa using this
  have hlfin : l.Finite := RingHom.Finite.of_surjective l hsurj
  have hTf : (algebraMap Q (Localization.Away e)).Finite := RingHom.finite_algebraMap.mpr hTfin
  rw [← hlalg]
  exact hlfin.comp hTf

theorem wcNd_hens_etale_chart : ∀ (A : Type u) [CommRing A] (p : Ideal A), p.IsPrime → ∀ (P : Type u) [CommRing P] [HenselianLocalRing P] (e : A →+* P), wcNdIsHens p P e → ∀ F : Finset P, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A E) (_ : Algebra.Etale A E) (j : E →+* P), j.comp (algebraMap A E) = e ∧ (∀ z ∈ F, ∃ b : E, j b = z) ∧ wcNdIsHens (Ideal.comap j (IsLocalRing.maximalIdeal P)) P j :=
by
  intro A _ p hp P _ _ e hP F
  classical
  haveI := hp
  obtain ⟨E, iE, iAE, iEt, j, hj, hF⟩ := wcNd_hne_etale_approx A p P e hP F

  have hres : ∀ z : P, ∃ a s : A, s ∉ p ∧ e s * z - e a ∈ IsLocalRing.maximalIdeal P := by
    intro z
    let K := FractionRing (A ⧸ p)
    let ψ : A →+* K := (algebraMap (A ⧸ p) K).comp (Ideal.Quotient.mk p)
    have hψ : ∀ a, IsUnit (ψ a) ↔ a ∉ p := by
      intro a
      constructor
      · intro hu ha
        apply hu.ne_zero
        show algebraMap (A ⧸ p) K (Ideal.Quotient.mk p a) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
      · intro ha
        apply isUnit_iff_ne_zero.mpr
        intro h0
        apply ha
        have h1 : algebraMap (A ⧸ p) K (Ideal.Quotient.mk p a) = algebraMap (A ⧸ p) K 0 :=
          h0.trans (map_zero _).symm
        exact Ideal.Quotient.eq_zero_iff_mem.mp (IsFractionRing.injective (A ⧸ p) K h1)
    obtain ⟨k₀, ⟨hk₀, _⟩, -⟩ := hP.2.2 K inferInstance ψ hψ
    obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A ⧸ p) (k₀ z)
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hy0 : Ideal.Quotient.mk p s ≠ 0 := nonZeroDivisors.ne_zero hy
    have hs : s ∉ p := fun h => hy0 (Ideal.Quotient.eq_zero_iff_mem.mpr h)
    have hy0' : algebraMap (A ⧸ p) K (Ideal.Quotient.mk p s) ≠ 0 := fun h =>
      hy0 (IsFractionRing.injective (A ⧸ p) K (h.trans (map_zero _).symm))
    refine ⟨a, s, hs, ?_⟩
    have hk : ∀ t, k₀ (e t) = ψ t := fun t => by rw [← RingHom.comp_apply, hk₀]
    have hker : k₀ (e s * z - e a) = 0 := by
      rw [map_sub, map_mul, hk, hk, ← hxy]
      show algebraMap (A ⧸ p) K (Ideal.Quotient.mk p s) *
          (algebraMap (A ⧸ p) K (Ideal.Quotient.mk p a) /
            algebraMap (A ⧸ p) K (Ideal.Quotient.mk p s)) -
          algebraMap (A ⧸ p) K (Ideal.Quotient.mk p a) = 0
      rw [mul_div_assoc', mul_div_cancel_left₀ _ hy0', sub_self]
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hu.map k₀).ne_zero hker

  have hu𝔮 : ∀ b : E, IsUnit (j b) ↔ b ∉ Ideal.comap j (IsLocalRing.maximalIdeal P) := by
    intro b
    rw [Ideal.mem_comap, IsLocalRing.notMem_maximalIdeal]
  refine ⟨E, iE, iAE, iEt, j, hj, fun z hz => RingHom.mem_range.mp (hF z hz), hP.1, hu𝔮, ?_⟩

  intro B _ hB g hg
  haveI := hB
  have hje : ∀ a, j (algebraMap A E a) = e a := fun a => by rw [← RingHom.comp_apply, hj]
  have hg' : ∀ a, IsUnit ((g.comp (algebraMap A E)) a) ↔ a ∉ p := by
    intro a
    rw [RingHom.comp_apply, hg, ← hu𝔮, hje]
    exact hP.2.1 a
  obtain ⟨k, ⟨hk, hkl⟩, hku⟩ := hP.2.2 B hB (g.comp (algebraMap A E)) hg'
  haveI := hkl
  have hke : ∀ a, k (e a) = g (algebraMap A E a) := fun a => by
    rw [← RingHom.comp_apply, hk, RingHom.comp_apply]

  have hresid : ∀ b : E, k (j b) - g b ∈ IsLocalRing.maximalIdeal B := by
    intro b
    obtain ⟨a, s, hs, hm⟩ := hres (j b)
    have hjw : j (algebraMap A E s * b - algebraMap A E a) = e s * j b - e a := by
      rw [map_sub, map_mul, hje, hje]
    have hw : algebraMap A E s * b - algebraMap A E a ∈
        Ideal.comap j (IsLocalRing.maximalIdeal P) := by
      rw [Ideal.mem_comap, hjw]; exact hm
    have h1 : g (algebraMap A E s * b - algebraMap A E a) ∈ IsLocalRing.maximalIdeal B := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hg]
      exact not_not.mpr hw
    have h2 : k (j (algebraMap A E s * b - algebraMap A E a)) ∈ IsLocalRing.maximalIdeal B :=
      map_nonunit k _ (by rw [hjw]; exact hm)
    have hσ : IsUnit (g (algebraMap A E s)) := (hg' s).mpr hs
    have h3 : g (algebraMap A E s) * (k (j b) - g b) ∈ IsLocalRing.maximalIdeal B := by
      have e1 : g (algebraMap A E s) * (k (j b) - g b) =
          k (j (algebraMap A E s * b - algebraMap A E a)) -
            g (algebraMap A E s * b - algebraMap A E a) := by
        rw [hjw, map_sub, map_mul, hke, hke, map_sub, map_mul]
        ring
      rw [e1]
      exact Ideal.sub_mem _ h2 h1
    by_contra hd
    rw [IsLocalRing.notMem_maximalIdeal] at hd
    exact (IsLocalRing.notMem_maximalIdeal.mpr (hσ.mul hd)) h3

  have hkj : k.comp j = g := by
    letI : Algebra A B := (g.comp (algebraMap A E)).toAlgebra
    let τ : E →ₐ[A] B := { g with commutes' := fun a => rfl }
    let τ' : E →ₐ[A] B :=
      { k.comp j with
        commutes' := fun a => by
          show k (j (algebraMap A E a)) = g (algebraMap A E a)
          rw [hje, hke] }
    have hττ := wc_hnas_hs_etale_hom_unique_residue A E B τ' τ (fun x => by
      show IsLocalRing.residue B (k (j x)) = IsLocalRing.residue B (g x)
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact hresid x)
    ext x
    exact congrArg (fun φ : E →ₐ[A] B => φ x) hττ

  refine ⟨k, ⟨hkj, hkl⟩, ?_⟩
  rintro h ⟨hh, hhl⟩
  apply hku h
  refine ⟨?_, hhl⟩
  rw [← hj, ← RingHom.comp_assoc, hh]

theorem wcNd_typeA_special_fibre : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (f : Polynomial ↥W →+* P), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C) P f → ∃ (_ : IsDomain (P ⧸ (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C))), IsDiscreteValuationRing (P ⧸ (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C)) ∧ Irreducible (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C)) (f Polynomial.X)) ∧ ∀ z : P, ∃ c : ↥W, ¬ IsUnit (z - f (Polynomial.C c)) :=
by
  intro Ω _ W P _ f hf
  classical
  obtain ⟨𝔞, h𝔞⟩ : ∃ 𝔞 : Ideal (Polynomial ↥W),
      𝔞 = (IsLocalRing.maximalIdeal ↥W).map Polynomial.C := ⟨_, rfl⟩
  obtain ⟨pA, hpA⟩ : ∃ pA : Ideal (Polynomial ↥W),
      pA = Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map Polynomial.C :=
    ⟨_, rfl⟩
  rw [← hpA] at hf
  have h𝔞p : 𝔞 ≤ pA := by rw [h𝔞, hpA]; exact le_sup_right

  have charA : ∀ a : Polynomial ↥W, a ∈ pA ↔ a.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    intro a
    rw [hpA]
    constructor
    · intro ha
      have hle : (Ideal.span {Polynomial.X} ⊔ (IsLocalRing.maximalIdeal ↥W).map
          (Polynomial.C : ↥W →+* Polynomial ↥W)) ≤
          Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff]
          show Polynomial.constantCoeff Polynomial.X ∈ IsLocalRing.maximalIdeal ↥W
          rw [Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
          exact Ideal.zero_mem _
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          rw [Ideal.mem_comap, Ideal.mem_comap, Polynomial.constantCoeff_apply,
            Polynomial.coeff_C_zero]
          exact hc
      have := hle ha
      rwa [Ideal.mem_comap, Polynomial.constantCoeff_apply] at this
    · intro ha
      rw [← Polynomial.X_mul_divX_add a]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha))

  have hres : ∀ z : P, ∃ c : ↥W, ¬ IsUnit (z - f (Polynomial.C c)) := by
    obtain ⟨_, _, hUP⟩ := hf
    have hg : ∀ a : Polynomial ↥W,
        IsUnit (((IsLocalRing.residue ↥W).comp Polynomial.constantCoeff) a) ↔ a ∉ pA := by
      intro a
      rw [RingHom.comp_apply, Polynomial.constantCoeff_apply, isUnit_iff_ne_zero, Ne,
        IsLocalRing.residue_eq_zero_iff, charA]
    obtain ⟨h, ⟨hh, _⟩, _⟩ := hUP _ inferInstance _ hg
    intro z
    obtain ⟨c, hc⟩ := IsLocalRing.residue_surjective (h z)
    refine ⟨c, fun hu => ?_⟩
    have h0 : h (z - f (Polynomial.C c)) = 0 := by
      rw [map_sub, ← RingHom.comp_apply h f, hh, RingHom.comp_apply,
        Polynomial.constantCoeff_apply, Polynomial.coeff_C_zero, hc, sub_self]
    have := hu.map h
    rw [h0] at this
    exact not_isUnit_zero this

  have hq := wcNd_hens_quotient (Polynomial ↥W) pA 𝔞 P f hf h𝔞p

  have hρs : Function.Surjective (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) :=
    Polynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue ↥W)) = 𝔞 := by
    rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, h𝔞]
  obtain ⟨ε, hε⟩ : ∃ ε : (Polynomial ↥W ⧸ 𝔞) ≃+* Polynomial (IsLocalRing.ResidueField ↥W),
      ∀ a, ε (Ideal.Quotient.mk 𝔞 a) = Polynomial.mapRingHom (IsLocalRing.residue ↥W) a :=
    ⟨(Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hρs),
      fun a => by
        rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
          RingHom.quotientKerEquivOfSurjective_apply_mk]⟩
  have hkey : ∀ a : Polynomial ↥W,
      Polynomial.mapRingHom (IsLocalRing.residue ↥W) a ∈ Ideal.span {Polynomial.X} ↔
        Ideal.Quotient.mk 𝔞 a ∈ pA.map (Ideal.Quotient.mk 𝔞) := by
    intro a
    rw [Ideal.mem_quotient_iff_mem h𝔞p, charA, Ideal.mem_span_singleton, Polynomial.X_dvd_iff,
      Polynomial.coe_mapRingHom, Polynomial.coeff_map, IsLocalRing.residue_eq_zero_iff]
  have hmem : ∀ b : Polynomial (IsLocalRing.ResidueField ↥W),
      b ∈ Ideal.span {Polynomial.X} ↔ ε.symm b ∈ pA.map (Ideal.Quotient.mk 𝔞) := by
    intro b
    obtain ⟨a, rfl⟩ := hρs b
    have e : ε.symm (Polynomial.mapRingHom (IsLocalRing.residue ↥W) a) =
        Ideal.Quotient.mk 𝔞 a := ε.symm_apply_eq.mpr (hε a).symm
    rw [e]
    exact hkey a

  have hl : wcNdIsHens (Ideal.span {Polynomial.X}) (P ⧸ 𝔞.map f)
      ((Ideal.quotientMap (𝔞.map f) f Ideal.le_comap_map).comp
        (ε.symm : Polynomial (IsLocalRing.ResidueField ↥W) →+* Polynomial ↥W ⧸ 𝔞)) := by
    obtain ⟨hH', hU', hUP'⟩ := hq
    refine ⟨hH', ?_, ?_⟩
    · intro b
      rw [hmem]
      exact hU' (ε.symm b)
    · intro B _ hB g' hg'
      have hg : ∀ a, IsUnit ((g'.comp (ε : (Polynomial ↥W ⧸ 𝔞) →+*
          Polynomial (IsLocalRing.ResidueField ↥W))) a) ↔
          a ∉ pA.map (Ideal.Quotient.mk 𝔞) := by
        intro a
        have := hg' (ε a)
        rw [hmem, RingEquiv.symm_apply_apply] at this
        exact this
      obtain ⟨h, ⟨hh, hloc⟩, huniq⟩ := hUP' B hB _ hg
      refine ⟨h, ⟨?_, hloc⟩, ?_⟩
      · apply RingHom.ext
        intro b
        have := RingHom.congr_fun hh (ε.symm b)
        simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom,
          RingEquiv.apply_symm_apply] at this ⊢
        exact this
      · rintro h' ⟨hh', hloc'⟩
        apply huniq h'
        refine ⟨?_, hloc'⟩
        apply RingHom.ext
        intro a
        have := RingHom.congr_fun hh' (ε a)
        simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom,
          RingEquiv.symm_apply_apply] at this ⊢
        exact this

  obtain ⟨hdom, hdvr, hirr⟩ := wcNd_line_hens_dvr (IsLocalRing.ResidueField ↥W) _ _ hl
  have hX : ((Ideal.quotientMap (𝔞.map f) f Ideal.le_comap_map).comp
        (ε.symm : Polynomial (IsLocalRing.ResidueField ↥W) →+* Polynomial ↥W ⧸ 𝔞))
        Polynomial.X = Ideal.Quotient.mk (𝔞.map f) (f Polynomial.X) := by
    have h1 : ε.symm Polynomial.X = Ideal.Quotient.mk 𝔞 Polynomial.X := by
      rw [RingEquiv.symm_apply_eq, hε, Polynomial.coe_mapRingHom, Polynomial.map_X]
    rw [RingHom.comp_apply, RingEquiv.coe_toRingHom, h1, Ideal.quotientMap_mk]
  rw [hX] at hirr

  have hJ : 𝔞.map f = (IsLocalRing.maximalIdeal ↥W).map (f.comp Polynomial.C) := by
    rw [h𝔞, Ideal.map_map]
  have key : ∀ J : Ideal P, J = 𝔞.map f → ∃ (_ : IsDomain (P ⧸ J)),
      IsDiscreteValuationRing (P ⧸ J) ∧ Irreducible (Ideal.Quotient.mk J (f Polynomial.X)) := by
    rintro J rfl
    exact ⟨hdom, hdvr, hirr⟩
  obtain ⟨hd, hv, hi⟩ := key _ hJ.symm
  exact ⟨hd, hv, hi, hres⟩

theorem wcpa_dj_lr1k_ebc_dlp_quot_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (fR : Polynomial ↥W →+* R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR → ∀ g : R, ¬ IsUnit g → g ∉ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) → ((Ideal.Quotient.mk (Ideal.span {g})).comp (fR.comp Polynomial.C)).Finite :=
by
  intro Ω _ _ W R _ fR hfR g hgu hg
  classical
  haveI hRh : HenselianLocalRing R := hfR.1

  have hp₀eq : (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
      Ideal (Polynomial ↥W)) =
      Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
    apply le_antisymm
    · apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        simp [Ideal.mem_comap]
      · rw [Ideal.map_le_iff_le_comap]
        intro t ht
        simpa [Ideal.mem_comap] using ht
    · intro q hq
      rw [Ideal.mem_comap, Polynomial.constantCoeff_apply] at hq
      have h1 : q = (q - Polynomial.C (q.coeff 0)) + Polynomial.C (q.coeff 0) := by ring
      rw [h1]
      apply Ideal.add_mem
      · apply Ideal.mem_sup_left
        rw [Ideal.mem_span_singleton]
        exact Polynomial.X_dvd_sub_C
      · apply Ideal.mem_sup_right
        exact Ideal.mem_map_of_mem _ hq
  have hp₀ : (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
      Ideal (Polynomial ↥W)).IsPrime := by
    rw [hp₀eq]; infer_instance

  have hmR : ∀ x : R, x ∈ IsLocalRing.maximalIdeal R ↔ ¬ IsUnit x := fun x =>
    (IsLocalRing.mem_maximalIdeal x).trans mem_nonunits_iff
  have hjac : (⊥ : Ideal R).jacobson = IsLocalRing.maximalIdeal R :=
    IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top
  have hgm : Ideal.span {g} ≤ IsLocalRing.maximalIdeal R :=
    (Ideal.span_singleton_le_iff_mem _).mpr ((hmR g).mpr hgu)
  haveI hmkl : IsLocalHom (Ideal.Quotient.mk (Ideal.span {g})) :=
    isLocalHom_of_le_jacobson_bot _ (by rw [hjac]; exact hgm)

  obtain ⟨E, iE, iA, hEt, j, hjc, hjb, hj⟩ :=
    wcNd_hens_etale_chart (Polynomial ↥W) _ hp₀ R fR hfR {g}
  obtain ⟨b, hb⟩ := hjb g (Finset.mem_singleton_self g)
  have hbp : (Ideal.span {b} : Ideal E) ≤ Ideal.comap j (IsLocalRing.maximalIdeal R) := by
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hb]
    exact (hmR g).mpr hgu
  have hq0 := wcNd_hens_quotient E (Ideal.comap j (IsLocalRing.maximalIdeal R))
    (Ideal.span {b}) R j hj hbp
  have hspan : (Ideal.span {b} : Ideal E).map j = Ideal.span {g} := by
    rw [Ideal.map_span, Set.image_singleton, hb]
  have hq1 := wcpa_dj_lr1k_ebnt_hens_transport _ _ (R ⧸ Ideal.span {g}) _ _
    (Ideal.quotEquivOfEq hspan).toRingHom hq0 (Ideal.quotEquivOfEq hspan).bijective
  letI : Algebra ↥W (E ⧸ (Ideal.span {b} : Ideal E)) :=
    ((Ideal.Quotient.mk (Ideal.span {b})).comp
      ((algebraMap (Polynomial ↥W) E).comp Polynomial.C)).toAlgebra
  haveI hSft : Algebra.FiniteType ↥W (E ⧸ (Ideal.span {b} : Ideal E)) := by
    rw [← RingHom.finiteType_algebraMap]
    show ((Ideal.Quotient.mk (Ideal.span {b})).comp
      ((algebraMap (Polynomial ↥W) E).comp Polynomial.C)).FiniteType
    refine RingHom.FiniteType.comp
      (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
      (RingHom.FiniteType.comp ?_ ?_)
    · haveI : Algebra.FinitePresentation (Polynomial ↥W) E := hEt.finitePresentation
      exact RingHom.finiteType_algebraMap.mpr Algebra.FiniteType.of_finitePresentation
    · rw [← Polynomial.algebraMap_eq]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
  have hjS'0 : ((Ideal.quotEquivOfEq hspan).toRingHom.comp
      (Ideal.quotientMap ((Ideal.span {b} : Ideal E).map j) j Ideal.le_comap_map)).comp
        (algebraMap ↥W (E ⧸ (Ideal.span {b} : Ideal E))) =
      (Ideal.Quotient.mk (Ideal.span {g})).comp (fR.comp Polynomial.C) := by
    apply RingHom.ext
    intro c
    show (Ideal.quotEquivOfEq hspan) (Ideal.quotientMap _ j Ideal.le_comap_map
      (Ideal.Quotient.mk (Ideal.span {b}) (algebraMap (Polynomial ↥W) E (Polynomial.C c)))) =
      Ideal.Quotient.mk (Ideal.span {g}) (fR (Polynomial.C c))
    rw [Ideal.quotientMap_mk, Ideal.quotEquivOfEq_mk]
    exact congrArg _ (RingHom.congr_fun hjc (Polynomial.C c))
  obtain ⟨jS, hjS', hq2⟩ : ∃ jS : (E ⧸ (Ideal.span {b} : Ideal E)) →+* (R ⧸ Ideal.span {g}),
      jS.comp (algebraMap ↥W (E ⧸ (Ideal.span {b} : Ideal E))) =
        (Ideal.Quotient.mk (Ideal.span {g})).comp (fR.comp Polynomial.C) ∧
      wcNdIsHens ((Ideal.comap j (IsLocalRing.maximalIdeal R)).map
        (Ideal.Quotient.mk (Ideal.span {b}))) (R ⧸ Ideal.span {g}) jS :=
    ⟨_, hjS'0, hq1⟩
  haveI hPh : HenselianLocalRing (R ⧸ Ideal.span {g}) := hq2.1
  have hmP : ∀ x : R ⧸ Ideal.span {g}, x ∈ IsLocalRing.maximalIdeal (R ⧸ Ideal.span {g}) ↔
      ¬ IsUnit x := fun x => (IsLocalRing.mem_maximalIdeal x).trans mem_nonunits_iff
  have hqeq : (Ideal.comap j (IsLocalRing.maximalIdeal R)).map
      (Ideal.Quotient.mk (Ideal.span {b})) =
      Ideal.comap jS (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {g})) := by
    ext a
    rw [Ideal.mem_comap, hmP, hq2.2.1 a]
    exact not_not.symm
  have hq' : wcNdIsHens (Ideal.comap jS (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {g})))
      (R ⧸ Ideal.span {g}) jS := hqeq ▸ hq2

  obtain ⟨hdom, hDVR, -, hres0⟩ := wcNd_typeA_special_fibre Ω W R fR hfR

  have hloc : IsLocalHom (jS.comp (algebraMap ↥W (E ⧸ (Ideal.span {b} : Ideal E)))) := by
    rw [hjS']
    refine ⟨fun c hc => ?_⟩
    have h1 : IsUnit (fR (Polynomial.C c)) := (isUnit_map_iff (Ideal.Quotient.mk _) _).mp hc
    have h2 := (hfR.2.1 (Polynomial.C c)).mp h1
    by_contra hc'
    exact h2 (Ideal.mem_sup_right (Ideal.mem_map_of_mem _
      ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hc'))))

  have hres : ∀ z : R ⧸ Ideal.span {g}, ∃ a : ↥W,
      z - jS (algebraMap ↥W (E ⧸ (Ideal.span {b} : Ideal E)) a) ∈
        IsLocalRing.maximalIdeal (R ⧸ Ideal.span {g}) := by
    intro z
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨c, hc⟩ := hres0 y
    refine ⟨c, ?_⟩
    have e : jS (algebraMap ↥W (E ⧸ (Ideal.span {b} : Ideal E)) c) =
        Ideal.Quotient.mk _ (fR (Polynomial.C c)) := RingHom.congr_fun hjS' c
    rw [e, ← map_sub, hmP]
    intro hu
    exact hc ((isUnit_map_iff _ _).mp hu)

  have hfib : ∀ 𝔓 : Ideal (R ⧸ Ideal.span {g}), 𝔓.IsPrime →
      Ideal.map (jS.comp (algebraMap ↥W (E ⧸ (Ideal.span {b} : Ideal E))))
        (IsLocalRing.maximalIdeal ↥W) ≤ 𝔓 →
      𝔓 = IsLocalRing.maximalIdeal (R ⧸ Ideal.span {g}) := by
    intro 𝔓 h𝔓 hle
    rw [hjS'] at hle
    apply le_antisymm (IsLocalRing.le_maximalIdeal h𝔓.ne_top)
    intro z hz
    haveI := hdom
    haveI := hDVR
    have hIm : Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) ≤
        IsLocalRing.maximalIdeal R := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, hmR]
      intro hu
      exact (hfR.2.1 _).mp hu (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hm))
    haveI hπl : IsLocalHom (Ideal.Quotient.mk
        (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))) :=
      isLocalHom_of_le_jacobson_bot _ (by rw [hjac]; exact hIm)
    haveI h𝔓' : (Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓).IsPrime :=
      Ideal.comap_isPrime _ _
    have hg𝔓 : g ∈ Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓 := by
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g)]
      exact 𝔓.zero_mem
    have hI𝔓 : Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) ≤
        Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓 := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_map]
      exact hle
    have hker : RingHom.ker (Ideal.Quotient.mk
        (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))) ≤
        Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓 := by
      rw [Ideal.mk_ker]; exact hI𝔓
    haveI h𝔔 : (Ideal.map (Ideal.Quotient.mk
        (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)))
        (Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
    have h𝔔0 : Ideal.map (Ideal.Quotient.mk
        (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)))
        (Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓) ≠ ⊥ := by
      intro h0
      have h3 := Ideal.mem_map_of_mem (Ideal.Quotient.mk
        (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))) hg𝔓
      rw [h0, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at h3
      exact hg h3
    have h𝔔eq := IsLocalRing.eq_maximalIdeal (h𝔔.isMaximal h𝔔0)
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    have hy : ¬ IsUnit y := fun hu => (hmP _).mp hz (hu.map _)
    have hπy : Ideal.Quotient.mk
        (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) y ∈
        Ideal.map (Ideal.Quotient.mk
          (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)))
          (Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓) := by
      rw [h𝔔eq, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact hy ((isUnit_map_iff _ _).mp hu)
    have h4 : y ∈ Ideal.comap (Ideal.Quotient.mk
        (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)))
        (Ideal.map (Ideal.Quotient.mk
          (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)))
          (Ideal.comap (Ideal.Quotient.mk (Ideal.span {g})) 𝔓)) := hπy
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, sup_eq_left.mpr hker] at h4
    exact h4

  haveI : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W
  have hfin := wcNd_hens_zmt_finite ↥W (E ⧸ (Ideal.span {b} : Ideal E)) (R ⧸ Ideal.span {g})
    jS hq' hloc hres hfib
  rw [hjS'] at hfin
  exact hfin

theorem wcpa_dj_lr1k_ebc_dlp_order : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (fR : Polynomial ↥W →+* R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR → ∀ g : R, g ∉ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) → ∃ (d : ℕ) (u : R), IsUnit u ∧ g - u * fR Polynomial.X ^ d ∈ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) :=
by
  intro Ω _ W R _ fR hfR g hg
  classical
  obtain ⟨hdom, hdvr, hirr, -⟩ := wcNd_typeA_special_fibre Ω W R fR hfR
  haveI := hdom
  haveI := hdvr
  haveI : HenselianLocalRing R := hfR.1
  have hle : Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) ≤
      IsLocalRing.maximalIdeal R := by
    rw [Ideal.map_le_iff_le_comap]
    intro m hm
    rw [Ideal.mem_comap, RingHom.comp_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hfR.2.1 (Polynomial.C m)).mp hu
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem Polynomial.C hm))
  have hg0 : Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) g
      ≠ 0 := fun h => hg (Ideal.Quotient.eq_zero_iff_mem.mp h)
  obtain ⟨d, U, hU⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hg0 hirr
  obtain ⟨u, hu⟩ := Ideal.Quotient.mk_surjective (↑U : R ⧸ Ideal.map (fR.comp Polynomial.C)
    (IsLocalRing.maximalIdeal ↥W))
  obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (↑U⁻¹ : R ⧸ Ideal.map (fR.comp Polynomial.C)
    (IsLocalRing.maximalIdeal ↥W))
  have hut : u * t - 1 ∈ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hu, ht, map_one, Units.mul_inv,
      sub_self]
  have huu : IsUnit u := by
    by_contra hnu
    have h1 : u ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal u).mpr hnu
    have h2 : u * t ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right _ _ h1
    have h3 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
      have := Ideal.sub_mem _ h2 (hle hut)
      rwa [sub_sub_cancel] at this
    exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  refine ⟨d, u, huu, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_pow, hu, ← hU, sub_self]

theorem wcpa_dj_lr1k_ebc_dlp_fibre_span : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (fR : Polynomial ↥W →+* R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR → ∀ (k : ℕ) (z : R), ∃ a : Fin k → ↥W, z - ∑ i : Fin k, fR (Polynomial.C (a i)) * fR Polynomial.X ^ (i : ℕ) ∈ Ideal.span {fR Polynomial.X ^ k} ⊔ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) :=
by
  intro Ω _ W R _ fR hfR k
  classical
  haveI hRh : HenselianLocalRing R := hfR.1

  have quot_hens : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (I : Ideal A), I ≠ ⊤ →
      HenselianLocalRing (A ⧸ I) := by
    intro A _ _ I hI
    haveI : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    haveI : IsLocalRing (A ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    haveI hπl : IsLocalHom (Ideal.Quotient.mk I) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hmem : ∀ r : A, Ideal.Quotient.mk I r ∈ IsLocalRing.maximalIdeal (A ⧸ I) ↔
        r ∈ IsLocalRing.maximalIdeal A := by
      intro r
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
      exact map_mem_nonunits_iff _ r
    have hev : ∀ (p : Polynomial A) (r : A), (p.map (Ideal.Quotient.mk I)).eval
        (Ideal.Quotient.mk I r) = Ideal.Quotient.mk I (p.eval r) := by
      intro p r
      rw [Polynomial.eval_map, Polynomial.eval₂_hom]
    refine @HenselianLocalRing.mk _ _ inferInstance ?_
    intro fb hfb a₀ h1 h2
    obtain ⟨f, hfmap, -, hfm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts fb).mpr
        (Polynomial.map_surjective _ Ideal.Quotient.mk_surjective fb)) hfb
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a₀
    subst hfmap
    rw [hev, hmem] at h1
    rw [Polynomial.derivative_map, hev] at h2
    have h2' : IsUnit (f.derivative.eval a) := isUnit_of_map_unit _ _ h2
    obtain ⟨b, hb, hba⟩ := HenselianLocalRing.is_henselian f hfm a h1 h2'
    refine ⟨Ideal.Quotient.mk I b, ?_, ?_⟩
    · show Polynomial.eval _ _ = 0
      rw [hev, hb.eq_zero, map_zero]
    · rw [← map_sub, hmem]
      exact hba

  have hp₀eq : (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) :
      Ideal (Polynomial ↥W)) =
      Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
    apply le_antisymm
    · apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        simp [Ideal.mem_comap]
      · rw [Ideal.map_le_iff_le_comap]
        intro t ht
        simpa [Ideal.mem_comap] using ht
    · intro q hq
      rw [Ideal.mem_comap, Polynomial.constantCoeff_apply] at hq
      have h1 : q = (q - Polynomial.C (q.coeff 0)) + Polynomial.C (q.coeff 0) := by ring
      rw [h1]
      apply Ideal.add_mem
      · apply Ideal.mem_sup_left
        rw [Ideal.mem_span_singleton]
        exact Polynomial.X_dvd_sub_C
      · apply Ideal.mem_sup_right
        exact Ideal.mem_map_of_mem _ hq

  have hnu : ∀ q ∈ (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C
      (IsLocalRing.maximalIdeal ↥W) : Ideal (Polynomial ↥W)),
      fR q ∈ IsLocalRing.maximalIdeal R := by
    intro q hq
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hfR.2.1 q).mp hu hq
  obtain ⟨J, hJ⟩ : ∃ J : Ideal R, J = Ideal.span {fR Polynomial.X} ⊔
    Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) := ⟨_, rfl⟩
  have hxJ : fR Polynomial.X ∈ J := by
    rw [hJ]
    exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  have hMJ' : ∀ m ∈ IsLocalRing.maximalIdeal ↥W, fR (Polynomial.C m) ∈ J := by
    intro m hm
    rw [hJ]
    exact Ideal.mem_sup_right (Ideal.mem_map_of_mem (fR.comp Polynomial.C) hm)
  have hJm : J ≤ IsLocalRing.maximalIdeal R := by
    rw [hJ]
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hnu _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
    · rw [Ideal.map_le_iff_le_comap]
      intro t ht
      rw [Ideal.mem_comap, RingHom.comp_apply]
      exact hnu _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ht))
  have hJne : J ≠ ⊤ := by
    intro h
    rw [h] at hJm
    exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp hJm)
  haveI hS : HenselianLocalRing (R ⧸ J) := quot_hens R J hJne

  let g : Polynomial ↥W →+* IsLocalRing.ResidueField ↥W :=
    (IsLocalRing.residue ↥W).comp Polynomial.constantCoeff
  have hg : ∀ a, IsUnit (g a) ↔ a ∉ (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C
      (IsLocalRing.maximalIdeal ↥W) : Ideal (Polynomial ↥W)) := by
    intro a
    rw [hp₀eq, Ideal.mem_comap]
    show IsUnit (IsLocalRing.residue ↥W (Polynomial.constantCoeff a)) ↔ _
    rw [isUnit_iff_ne_zero, Ne, IsLocalRing.residue_eq_zero_iff]
  obtain ⟨h, ⟨hh, hhloc⟩, -⟩ := hfR.2.2 (IsLocalRing.ResidueField ↥W) inferInstance g hg
  have hMJ : ∀ m ∈ IsLocalRing.maximalIdeal ↥W,
      ((Ideal.Quotient.mk J).comp (fR.comp Polynomial.C)) m = 0 := by
    intro m hm
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hMJ' m hm
  let ι : IsLocalRing.ResidueField ↥W →+* R ⧸ J :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W)
      ((Ideal.Quotient.mk J).comp (fR.comp Polynomial.C)) hMJ
  have hι : ∀ c : ↥W, ι (IsLocalRing.residue ↥W c) = Ideal.Quotient.mk J (fR (Polynomial.C c)) :=
    fun c => rfl
  haveI hπl : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  haveI hιl : IsLocalHom ι := inferInstance
  haveI := hhloc
  have hφ₂l : IsLocalHom (ι.comp h) := RingHom.isLocalHom_comp ι h
  have hg' : ∀ a, IsUnit (((Ideal.Quotient.mk J).comp fR) a) ↔ a ∉
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C
      (IsLocalRing.maximalIdeal ↥W) : Ideal (Polynomial ↥W)) := by
    intro a
    rw [RingHom.comp_apply, isUnit_map_iff (Ideal.Quotient.mk J)]
    exact hfR.2.1 a
  have hx0 : Ideal.Quotient.mk J (fR Polynomial.X) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr hxJ
  have hcomp : (ι.comp h).comp fR = (Ideal.Quotient.mk J).comp fR := by
    apply Polynomial.ringHom_ext
    · intro w
      simp only [RingHom.comp_apply]
      rw [show h (fR (Polynomial.C w)) = g (Polynomial.C w) from RingHom.congr_fun hh _]
      show ι (IsLocalRing.residue ↥W (Polynomial.constantCoeff (Polynomial.C w))) = _
      rw [Polynomial.constantCoeff_apply, Polynomial.coeff_C_zero]
      exact hι w
    · simp only [RingHom.comp_apply]
      rw [show h (fR Polynomial.X) = g Polynomial.X from RingHom.congr_fun hh _, hx0]
      show ι (IsLocalRing.residue ↥W (Polynomial.constantCoeff Polynomial.X)) = 0
      rw [Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero, map_zero, map_zero]
  have hEU := hfR.2.2 (R ⧸ J) hS ((Ideal.Quotient.mk J).comp fR) hg'
  have heq : Ideal.Quotient.mk J = ι.comp h := hEU.unique ⟨rfl, hπl⟩ ⟨hcomp, hφ₂l⟩
  have RS : ∀ y : R, ∃ (c : ↥W) (y' : R), y - fR (Polynomial.C c) - y' * fR Polynomial.X ∈
      Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) := by
    intro y
    obtain ⟨c, hc⟩ := IsLocalRing.residue_surjective (h y)
    have h1 : Ideal.Quotient.mk J y = Ideal.Quotient.mk J (fR (Polynomial.C c)) := by
      rw [RingHom.congr_fun heq y, RingHom.comp_apply, ← hc, hι]
    have h2 : y - fR (Polynomial.C c) ∈ J := Ideal.Quotient.eq.mp h1
    rw [hJ] at h2
    obtain ⟨s, hs, m, hm, hsm⟩ := Submodule.mem_sup.mp h2
    obtain ⟨y', rfl⟩ := Ideal.mem_span_singleton'.mp hs
    refine ⟨c, y', ?_⟩
    have e : y - fR (Polynomial.C c) - y' * fR Polynomial.X = m := by
      linear_combination -hsm
    rw [e]
    exact hm

  induction k with
  | zero =>
    intro z
    refine ⟨Fin.elim0, ?_⟩
    rw [pow_zero, Ideal.span_singleton_one]
    exact Ideal.mem_sup_left Submodule.mem_top
  | succ k ih =>
    intro z
    obtain ⟨a, ha⟩ := ih z
    obtain ⟨s, hs, m, hm, hsm⟩ := Submodule.mem_sup.mp ha
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hs
    obtain ⟨c, y', hy⟩ := RS y
    refine ⟨Fin.snoc a c, ?_⟩
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.coe_castSucc, Fin.val_last]
    have key : z - (∑ i : Fin k, fR (Polynomial.C (a i)) * fR Polynomial.X ^ (i : ℕ) +
        fR (Polynomial.C c) * fR Polynomial.X ^ k) =
        y' * fR Polynomial.X ^ (k + 1) +
          (fR Polynomial.X ^ k * (y - fR (Polynomial.C c) - y' * fR Polynomial.X) + m) := by
      linear_combination -hsm
    rw [key]
    exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨y', rfl⟩))
      (Ideal.mem_sup_right (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy) hm))

theorem wcpa_dj_lr1k_ebc_dlp_unit_coeff : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (R : Type u) [CommRing R] (fR : Polynomial ↥W →+* R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR → ∀ (g u w : R) (d : ℕ) (a : Fin d → ↥W), IsUnit u → g - u * fR Polynomial.X ^ d ∈ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) → fR Polynomial.X ^ d - ∑ i : Fin d, fR (Polynomial.C (a i)) * fR Polynomial.X ^ (i : ℕ) = g * w → (∀ i, a i ∈ IsLocalRing.maximalIdeal ↥W) ∧ IsUnit w :=
by
  intro Ω _ W R _ fR hfR g u w d a _hu hgu hrel
  classical

  have key : ∀ (S : Type u) [CommRing S] [IsDomain S] (π c : S) (b : Fin d → S),
      π ≠ 0 → ¬ IsUnit π → (∀ i, b i = 0 ∨ IsUnit (b i)) →
      ∑ i : Fin d, b i * π ^ (i : ℕ) = π ^ d * c → ∀ i, b i = 0 := by
    intro S _ _ π c b hπ0 hπ hb hs
    have hall : ∀ k : ℕ, ∀ hk : k < d, b ⟨k, hk⟩ = 0 := by
      intro k
      induction k using Nat.strong_induction_on with
      | _ k ih =>
        intro hk
        rcases hb ⟨k, hk⟩ with h | h
        · exact h
        exfalso
        apply hπ
        have hsplit : b ⟨k, hk⟩ * π ^ k +
            ∑ i ∈ Finset.univ.erase (⟨k, hk⟩ : Fin d), b i * π ^ (i : ℕ) =
            ∑ i : Fin d, b i * π ^ (i : ℕ) :=
          Finset.add_sum_erase Finset.univ (fun i : Fin d => b i * π ^ (i : ℕ))
            (Finset.mem_univ _)
        have h1 : π ^ (k + 1) ∣
            ∑ i ∈ Finset.univ.erase (⟨k, hk⟩ : Fin d), b i * π ^ (i : ℕ) := by
          apply Finset.dvd_sum
          intro i hi
          have hik : (i : ℕ) ≠ k := fun h => (Finset.mem_erase.mp hi).1 (Fin.ext h)
          rcases lt_or_gt_of_ne hik with hlt | hgt
          · have h0 : b i = 0 := ih _ hlt i.isLt
            rw [h0, zero_mul]
            exact dvd_zero _
          · exact Dvd.dvd.mul_left (pow_dvd_pow π hgt) _
        have h2 : π ^ (k + 1) ∣ π ^ d * c := Dvd.dvd.mul_right (pow_dvd_pow π hk) _
        have h3 : π ^ (k + 1) ∣ b ⟨k, hk⟩ * π ^ k := by
          have e : b ⟨k, hk⟩ * π ^ k = π ^ d * c -
              ∑ i ∈ Finset.univ.erase (⟨k, hk⟩ : Fin d), b i * π ^ (i : ℕ) := by
            rw [← hs, ← hsplit]; ring
          rw [e]
          exact dvd_sub h2 h1
        rw [pow_succ, mul_comm (b _)] at h3
        have h4 : π ∣ b ⟨k, hk⟩ := (mul_dvd_mul_iff_left (pow_ne_zero k hπ0)).mp h3
        exact isUnit_of_dvd_unit h4 h
    intro i
    exact hall i.val i.isLt
  obtain ⟨hdom, -, hirr, -⟩ := wcNd_typeA_special_fibre Ω W R fR hfR
  haveI := hdom
  haveI : HenselianLocalRing R := hfR.1
  have hle : Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) ≤
      IsLocalRing.maximalIdeal R := by
    rw [Ideal.map_le_iff_le_comap]
    intro m hm
    rw [Ideal.mem_comap, RingHom.comp_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hfR.2.1 (Polynomial.C m)).mp hu
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem Polynomial.C hm))
  have hz : ∀ t ∈ IsLocalRing.maximalIdeal ↥W,
      Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR (Polynomial.C t)) = 0 := fun t ht =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem (fR.comp Polynomial.C) ht)
  have hu' : ∀ t : ↥W, t ∉ IsLocalRing.maximalIdeal ↥W →
      IsUnit (Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR (Polynomial.C t))) := by
    intro t ht
    have htu : IsUnit t := by
      by_contra h
      exact ht ((IsLocalRing.mem_maximalIdeal t).mpr h)
    exact ((htu.map Polynomial.C).map fR).map _
  have e1 : Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) g =
      Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) u *
      Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR Polynomial.X) ^ d := by
    have h := Ideal.Quotient.eq_zero_iff_mem.mpr hgu
    rw [map_sub, map_mul, map_pow, sub_eq_zero] at h
    exact h
  have e2 := congrArg
    (Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))) hrel
  simp only [map_sub, map_pow, map_sum, map_mul] at e2
  have hstar : ∑ i : Fin d,
      Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR (Polynomial.C (a i))) *
      Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR Polynomial.X) ^ (i : ℕ) =
      Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR Polynomial.X) ^ d *
      (1 - Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) u *
        Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) w) := by
    rw [e1] at e2
    linear_combination -e2
  have hπ0 := hirr.ne_zero
  have hb : ∀ i : Fin d,
      Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR (Polynomial.C (a i))) = 0 ∨
      IsUnit (Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR (Polynomial.C (a i)))) := by
    intro i
    by_cases h : a i ∈ IsLocalRing.maximalIdeal ↥W
    · exact Or.inl (hz _ h)
    · exact Or.inr (hu' _ h)
  have hall := key _ _ _
    (fun i => Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
        (fR (Polynomial.C (a i)))) hπ0 hirr.not_isUnit hb hstar
  refine ⟨fun i => ?_, ?_⟩
  · by_contra h
    have h1 := hu' _ h
    rw [hall i] at h1
    exact not_isUnit_zero h1
  · have hc : Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W))
          (fR Polynomial.X) ^ d *
        (1 - Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) u *
          Ideal.Quotient.mk (Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W)) w)
          = 0 := by
      rw [← hstar]
      exact Finset.sum_eq_zero (fun i _ => by rw [hall i, zero_mul])
    have hc' := (mul_eq_zero.mp hc).resolve_left (pow_ne_zero d hπ0)
    have hmem : u * w - 1 ∈ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_one]
      linear_combination -hc'
    have hnu : 1 - u * w ∈ nonunits R := by
      rw [← IsLocalRing.mem_maximalIdeal]
      have e : 1 - u * w = -(u * w - 1) := by ring
      rw [e]
      exact (Ideal.neg_mem_iff _).mpr (hle hmem)
    exact isUnit_of_mul_isUnit_right (IsLocalRing.isUnit_of_mem_nonunits_one_sub_self _ hnu)

theorem wcpa_dj_lr1k_ebc_dl_prep : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (R : Type u) [CommRing R] (fR : Polynomial ↥W →+* R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR → ∀ g : R, g ∉ Ideal.map (fR.comp Polynomial.C) (IsLocalRing.maximalIdeal ↥W) → ∃ (v : R) (P : Polynomial ↥W), IsUnit v ∧ P.Monic ∧ (∀ i < P.natDegree, P.coeff i ∈ IsLocalRing.maximalIdeal ↥W) ∧ g = v * fR P :=
