  have hint : (h.app V).hom.IsIntegral := Scheme.Hom.isIntegral_app h V hV
  have hgerm : ∀ s : Γ(A, h ⁻¹ᵁ V),
      IsIntegral (B.presheaf.stalk (h a)) ((A.presheaf.germ (h ⁻¹ᵁ V) a haU).hom s) := by
    intro s
    have h1 := (hint s).map (A.presheaf.germ (h ⁻¹ᵁ V) a haU).hom
    have hnat := congrArg CommRingCat.Hom.hom (Scheme.Hom.germ_stalkMap h V a hav)
    simp only [CommRingCat.hom_comp] at hnat
    rw [← hnat] at h1
