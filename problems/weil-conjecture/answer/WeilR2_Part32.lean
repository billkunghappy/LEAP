      by_contra hcon
      push_neg at hcon
      have h0 : Ring.KrullDimLE 0 ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk ξ) :=
        Ring.krullDimLE_zero_iff.mpr hcon
      have h1 : ringKrullDim ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk ξ) ≤
          ((0 : ℕ) : WithBot ℕ∞) := Ring.krullDimLE_iff.mp h0
      have h2 := hdim.trans h1
      have h3 : (1 : ℕ) ≤ 0 := by exact_mod_cast h2
      omega
    obtain ⟨p, hpp, hpm⟩ := hp
    let P : PrimeSpectrum ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk ξ) := ⟨p, hpp⟩
    have hPne : P ≠ IsLocalRing.closedPoint _ := by
      intro h
      apply hpm
      have e : P.asIdeal = IsLocalRing.maximalIdeal _ := by rw [h]; rfl
      have e' : p = P.asIdeal := rfl
      rw [e', e]
      exact IsLocalRing.maximalIdeal.isMaximal _
    have hsp : (wcpaDjLkFib W (γ ≫ ι) uX).fromSpecStalk ξ P ⤳ ξ := by
      have h1 : (wcpaDjLkFib W (γ ≫ ι) uX).fromSpecStalk ξ P ∈
          Set.range ((wcpaDjLkFib W (γ ≫ ι) uX).fromSpecStalk ξ) := ⟨P, rfl⟩
      rw [Scheme.range_fromSpecStalk] at h1
      exact h1
    have hne : (wcpaDjLkFib W (γ ≫ ι) uX).fromSpecStalk ξ P ≠ ξ := by
      intro h
      apply hPne
      apply ((wcpaDjLkFib W (γ ≫ ι) uX).fromSpecStalk ξ).isEmbedding.injective
      rw [Scheme.fromSpecStalk_closedPoint]
      exact h
    have hsub : E ⊆ closure {(wcpaDjLkFib W (γ ≫ ι) uX).fromSpecStalk ξ P} := by
      rw [← hcl]
      exact hsp.closure_subset
    have heq := hEmax.eq_of_subset isIrreducible_singleton.closure hsub
    have hmem : (wcpaDjLkFib W (γ ≫ ι) uX).fromSpecStalk ξ P ∈
        ({ξ} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) := by
      rw [← hξc.closure_eq, hcl, heq]
      exact subset_closure (Set.mem_singleton _)
    exact hne hmem

  have hPnc : ¬ IsClosed ({wcpaDjLkPi W (γ ≫ ι) uX ξ} : Set ↥(Limits.pullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) := by
    intro hP
    have hex : ∃ y ∈ closure ({ξ} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)), y ≠ ξ := by
      by_contra hcon
      push_neg at hcon
      apply hnc
      have e : closure ({ξ} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) = {ξ} :=
        Set.Subset.antisymm (fun y hy => hcon y hy) subset_closure
      rw [← e]
      exact isClosed_closure
    obtain ⟨y, hy, hyne⟩ := hex
    have hsp : ξ ⤳ y := specializes_iff_mem_closure.mpr hy
    have hsp' := hsp.map Pm.continuous
    have hmem : Pm y ∈ ({wcpaDjLkPi W (γ ≫ ι) uX ξ} : Set _) := by
      rw [← hP.closure_eq, hPiEq]
      exact specializes_iff_mem_closure.mp hsp'
    have heq : Pm ξ = Pm y := by
      rw [← hPiEq ξ]
      exact (Set.mem_singleton_iff.mp hmem).symm
    exact hyne (wcpa_dj_lr1k_gs_integral_incomparable Pm ξ y hsp heq).symm

  have hss : wcpaDjSemistable uX := hM.1
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI : IsProper uX := hss.2.1
  have hsm : wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX ξ) := by
    rcases hss.2.2 (IsLocalRing.ResidueField ↥W)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
        (wcpaDjLkPi W (γ ≫ ι) uX ξ) with h | ⟨e, he⟩
    · exact h
    · exfalso
      have hres := wcpa_dj_nf_node_residue (IsLocalRing.ResidueField ↥W) _ _ ⟨e, he⟩
      exact hPnc (wcpa_dj_lr1k_gs_rational_closed (IsLocalRing.ResidueField ↥W) _
        (Limits.pullback.snd uX
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) _ hres)
  exact ⟨ξ, hξE, hcl, hsm⟩

theorem wcpa_dj_lr1k_odfdl_line_infinity : ∀ (k : Type u) [Field k] (Y : Scheme.{u})
    (q : Y ⟶ Spec (.of k)), IsSeparated q →
    ∀ (U : Y.Opens) (e : U.toScheme ≅ Spec (.of (Polynomial k))),
      e.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) = U.ι ≫ q →
      ∀ y z : Y, y ∈ closure (U : Set Y) → z ∈ closure (U : Set Y) → y ∉ U → z ∉ U → y = z :=
by
  intro k _ Y q hsep U e he y z hy hz hyU hzU

  have s0 : ∀ y : Y, y ∈ closure (U : Set Y) →
      (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) (FractionRing (Polynomial k)))) ≫
        e.inv ≫ U.ι) (IsLocalRing.closedPoint (FractionRing (Polynomial k))) ⤳ y := by
    intro y hy
    set ξ := (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k)
      (FractionRing (Polynomial k)))) ≫ e.inv ≫ U.ι)
      (IsLocalRing.closedPoint (FractionRing (Polynomial k))) with hξ
    have hsub : (U : Set Y) ⊆ closure {ξ} := by
      intro u hu
      rw [← Scheme.Opens.range_ι] at hu
      obtain ⟨u', rfl⟩ := hu
      rw [← specializes_iff_mem_closure]
      have h1 : e.inv (e.hom u') = u' := by
        rw [← Scheme.Hom.comp_apply, e.hom_inv_id]; rfl
      have h2 : (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k)
          (FractionRing (Polynomial k))))) (IsLocalRing.closedPoint (FractionRing (Polynomial k)))
          ⤳ e.hom u' := by
        apply (PrimeSpectrum.le_iff_specializes _ _).mp
        intro a ha
        have ha' : algebraMap (Polynomial k) (FractionRing (Polynomial k)) a ∈
            IsLocalRing.maximalIdeal (FractionRing (Polynomial k)) := ha
        rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot] at ha'
        have : a = 0 := (IsFractionRing.injective (Polynomial k) (FractionRing (Polynomial k)))
          (by rw [ha', map_zero])
        rw [this]; exact Ideal.zero_mem _
      have h3 := h2.map (e.inv ≫ U.ι).continuous
      have h4 : (e.inv ≫ U.ι) (e.hom u') = U.ι u' := by rw [Scheme.Hom.comp_apply, h1]
      rw [h4] at h3
      exact h3
    have := closure_minimal hsub isClosed_closure hy
    rwa [← specializes_iff_mem_closure] at this

  have s1 : ∀ (g : Spec (.of (FractionRing (Polynomial k))) ⟶ Y) (y : Y),
      g (IsLocalRing.closedPoint (FractionRing (Polynomial k))) ⤳ y →
      ∃ (A : ValuationSubring (FractionRing (Polynomial k))) (t : Spec (.of ↥A) ⟶ Y),
        Spec.map (CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k)))) ≫ t = g ∧
        t (IsLocalRing.closedPoint ↥A) = y := by
    intro g y h
    set φ := Scheme.stalkClosedPointTo g
    set ψ := Y.presheaf.stalkSpecializes h
    obtain ⟨A, hA, hloc⟩ := IsLocalRing.exists_factor_valuationRing (ψ ≫ φ).hom
    let f' : Y.presheaf.stalk y ⟶ CommRingCat.of ↥A :=
      CommRingCat.ofHom ((ψ ≫ φ).hom.codRestrict A.toSubring hA)
    have : IsLocalHom f'.hom := hloc
    refine ⟨A, Spec.map f' ≫ Y.fromSpecStalk y, ?_, ?_⟩
    · have e1 : f' ≫ CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k))) = ψ ≫ φ := by
        ext x; rfl
      rw [← Category.assoc, ← Spec.map_comp, e1, Spec.map_comp, Category.assoc,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
    · show Y.fromSpecStalk y (Spec.map f' (IsLocalRing.closedPoint ↥A)) = y
      rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]

  have s2 : ∀ (A : ValuationSubring (FractionRing (Polynomial k))) (t₁ t₂ : Spec (.of ↥A) ⟶ Y),
      Spec.map (CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k)))) ≫ t₁ =
        Spec.map (CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k)))) ≫ t₂ →
      t₁ = t₂ := by
    intro A t₁ t₂ ht
    have hq : t₁ ≫ q = t₂ ≫ q := by
      have e1 : Spec.preimage (t₁ ≫ q) ≫
            CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k))) =
          Spec.preimage (t₂ ≫ q) ≫
            CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k))) := by
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_comp, Spec.map_preimage, Spec.map_preimage,
          ← Category.assoc, ht, Category.assoc]
      have e2 : Spec.preimage (t₁ ≫ q) = Spec.preimage (t₂ ≫ q) := by
        ext r
        exact congrArg (fun f => f.hom r) e1
      rw [← Spec.map_preimage (t₁ ≫ q), ← Spec.map_preimage (t₂ ≫ q), e2]
    let S : ValuativeCommSq q := ⟨↥A, FractionRing (Polynomial k),
      Spec.map (CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k)))) ≫ t₁, t₁ ≫ q,
      ⟨by simp only [Category.assoc]⟩⟩
    have hU := IsSeparated.valuativeCriterion q S
    let L₁ : S.commSq.LiftStruct := ⟨t₁, rfl, rfl⟩
    let L₂ : S.commSq.LiftStruct := ⟨t₂, ht.symm, hq.symm⟩
    exact congrArg CommSq.LiftStruct.l (Subsingleton.elim L₁ L₂)

  have s3 : ∀ (A : ValuationSubring (FractionRing (Polynomial k))) (t : Spec (.of ↥A) ⟶ Y),
      Spec.map (CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k)))) ≫ t =
        Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) (FractionRing (Polynomial k)))) ≫
          e.inv ≫ U.ι →
      ∀ c : k, algebraMap (Polynomial k) (FractionRing (Polynomial k)) (Polynomial.C c) ∈ A := by
    intro A t ht c
    have e1 : Spec.preimage (t ≫ q) ≫
          CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k))) =
        CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) ≫
          CommRingCat.ofHom (algebraMap (Polynomial k) (FractionRing (Polynomial k))) := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, Spec.map_preimage, ← Category.assoc, ht,
        Category.assoc, Category.assoc, ← he, Iso.inv_hom_id_assoc]
    have h2 : algebraMap ↥A (FractionRing (Polynomial k)) ((Spec.preimage (t ≫ q)).hom c) =
        algebraMap (Polynomial k) (FractionRing (Polynomial k)) (Polynomial.C c) :=
      congrArg (fun f => f.hom c) e1
    rw [← h2]
    exact ((Spec.preimage (t ≫ q)).hom c).2

  have s4 : ∀ (A : ValuationSubring (FractionRing (Polynomial k))),
      (∀ c : k, algebraMap (Polynomial k) (FractionRing (Polynomial k)) (Polynomial.C c) ∈ A) →
      algebraMap (Polynomial k) (FractionRing (Polynomial k)) Polynomial.X ∈ A →
      ∃ s : Spec (.of ↥A) ⟶ Y,
        Spec.map (CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k)))) ≫ s =
          Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) (FractionRing (Polynomial k)))) ≫
            e.inv ≫ U.ι ∧
        s (IsLocalRing.closedPoint ↥A) ∈ U := by
    intro A hc hX
    have hall : ∀ p : Polynomial k,
        algebraMap (Polynomial k) (FractionRing (Polynomial k)) p ∈ A.toSubring := by
      intro p
      induction p using Polynomial.induction_on with
      | C a => exact hc a
      | add p r hp hr => rw [map_add]; exact Subring.add_mem _ hp hr
      | monomial n a ih => rw [pow_succ, ← mul_assoc, map_mul]; exact Subring.mul_mem _ ih hX
    let β : Polynomial k →+* ↥A :=
      (algebraMap (Polynomial k) (FractionRing (Polynomial k))).codRestrict A.toSubring hall
    refine ⟨Spec.map (CommRingCat.ofHom β) ≫ e.inv ≫ U.ι, ?_, ?_⟩
    · have e1 : CommRingCat.ofHom β ≫
          CommRingCat.ofHom (algebraMap ↥A (FractionRing (Polynomial k))) =
          CommRingCat.ofHom (algebraMap (Polynomial k) (FractionRing (Polynomial k))) :=
        CommRingCat.hom_ext (RingHom.ext fun x => rfl)
      rw [← Category.assoc, ← Spec.map_comp, e1]
    · have : (Spec.map (CommRingCat.ofHom β) ≫ e.inv ≫ U.ι) (IsLocalRing.closedPoint ↥A) ∈
          Set.range U.ι := ⟨(Spec.map (CommRingCat.ofHom β) ≫ e.inv) (IsLocalRing.closedPoint ↥A),
            rfl⟩
      rwa [Scheme.Opens.range_ι] at this

  have s5 : ∀ (A : ValuationSubring (FractionRing (Polynomial k))),
      (∀ c : k, algebraMap (Polynomial k) (FractionRing (Polynomial k)) (Polynomial.C c) ∈ A) →
      algebraMap (Polynomial k) (FractionRing (Polynomial k)) Polynomial.X ∉ A →
      ∀ p r : Polynomial k, p ≠ 0 → r ≠ 0 →
        (algebraMap (Polynomial k) (FractionRing (Polynomial k)) p /
          algebraMap (Polynomial k) (FractionRing (Polynomial k)) r ∈ A ↔
          p.natDegree ≤ r.natDegree) := by
    intro A hc hX
    set j := algebraMap (Polynomial k) (FractionRing (Polynomial k)) with hj
    set v := A.valuation with hv
    have hv1 : 1 < v (j Polynomial.X) :=
      lt_of_not_ge (fun h => hX ((A.valuation_le_one_iff _).mp h))
    have hv0 : 0 < v (j Polynomial.X) := zero_lt_one.trans hv1
    have hvc : ∀ c : k, c ≠ 0 → v (j (Polynomial.C c)) = 1 := by
      intro c hc0
      have hu : IsUnit (⟨j (Polynomial.C c), hc c⟩ : A) := by
        refine isUnit_iff_exists_inv.mpr ⟨⟨j (Polynomial.C c⁻¹), hc c⁻¹⟩, ?_⟩
        apply Subtype.ext
        show j (Polynomial.C c) * j (Polynomial.C c⁻¹) = 1
        rw [← map_mul, ← map_mul, mul_inv_cancel₀ hc0, map_one, map_one]
      exact (A.valuation_eq_one_iff _).mp hu
    have hcle : ∀ c : k, v (j (Polynomial.C c)) ≤ 1 :=
      fun c => (A.valuation_le_one_iff _).mpr (hc c)
    have hdeg : ∀ p : Polynomial k, p ≠ 0 → v (j p) = v (j Polynomial.X) ^ p.natDegree := by
      intro p hp
      have hexp : j p = ∑ i ∈ Finset.range p.natDegree,
            j (Polynomial.C (p.coeff i)) * j Polynomial.X ^ i +
          j (Polynomial.C p.leadingCoeff) * j Polynomial.X ^ p.natDegree := by
        conv_lhs => rw [p.as_sum_range_C_mul_X_pow]
        rw [Finset.sum_range_succ, map_add, map_sum]
        simp only [map_mul, map_pow, Polynomial.leadingCoeff]
      have hlead : v (j (Polynomial.C p.leadingCoeff) * j Polynomial.X ^ p.natDegree) =
          v (j Polynomial.X) ^ p.natDegree := by
        rw [map_mul, map_pow, hvc _ (Polynomial.leadingCoeff_ne_zero.mpr hp), one_mul]
      have hlow : v (∑ i ∈ Finset.range p.natDegree,
            j (Polynomial.C (p.coeff i)) * j Polynomial.X ^ i) <
          v (j Polynomial.X) ^ p.natDegree := by
        apply Valuation.map_sum_lt _ (pow_ne_zero _ hv0.ne')
        intro i hi
        rw [map_mul, map_pow]
        calc v (j (Polynomial.C (p.coeff i))) * v (j Polynomial.X) ^ i
            ≤ v (j Polynomial.X) ^ i := by
              exact mul_le_of_le_one_left' (hcle _)
          _ < v (j Polynomial.X) ^ p.natDegree := pow_lt_pow_right₀ hv1 (Finset.mem_range.mp hi)
      rw [hexp, Valuation.map_add_eq_of_lt_right _ (hlow.trans_eq hlead.symm), hlead]
    intro p r hp hr
    rw [← A.valuation_le_one_iff, map_div₀, hdeg p hp, hdeg r hr, div_le_one₀ (pow_pos hv0 _),
      pow_le_pow_iff_right₀ hv1]

  have hξy := s0 y hy
  have hξz := s0 z hz
  obtain ⟨A₁, t₁, ht₁, ht₁y⟩ := s1 _ y hξy
  obtain ⟨A₂, t₂, ht₂, ht₂z⟩ := s1 _ z hξz
  have hc₁ := s3 A₁ t₁ ht₁
  have hc₂ := s3 A₂ t₂ ht₂
  have hX₁ : algebraMap (Polynomial k) (FractionRing (Polynomial k)) Polynomial.X ∉ A₁ := by
    intro hX
    obtain ⟨s, hs, hsU⟩ := s4 A₁ hc₁ hX
    have h := s2 A₁ t₁ s (ht₁.trans hs.symm)
    apply hyU
    rw [← ht₁y, h]
    exact hsU
  have hX₂ : algebraMap (Polynomial k) (FractionRing (Polynomial k)) Polynomial.X ∉ A₂ := by
    intro hX
    obtain ⟨s, hs, hsU⟩ := s4 A₂ hc₂ hX
    have h := s2 A₂ t₂ s (ht₂.trans hs.symm)
    apply hzU
    rw [← ht₂z, h]
    exact hsU
  have hA : A₁ = A₂ := by
    ext w
    obtain ⟨p, r, hr, rfl⟩ := IsFractionRing.div_surjective (Polynomial k) w
    have hr0 : r ≠ 0 := nonZeroDivisors.ne_zero hr
    by_cases hp : p = 0
    · rw [hp, map_zero, zero_div]
      exact ⟨fun _ => A₂.zero_mem, fun _ => A₁.zero_mem⟩
    · rw [s5 A₁ hc₁ hX₁ p r hp hr0, s5 A₂ hc₂ hX₂ p r hp hr0]
  subst hA
  have h := s2 A₁ t₁ t₂ (ht₁.trans ht₂.symm)
  rw [← ht₁y, ← ht₂z, h]

theorem wcpa_dj_lr1k_odfdl_line_stalks : ∀ (k : Type u) [Field k] (Y : Scheme.{u})
    (q : Y ⟶ Spec (.of k)) (U : Y.Opens) (e : U.toScheme ≅ Spec (.of (Polynomial k))),
    e.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) = U.ι ≫ q →
    (∀ y ∈ U, wcpaDjLkDelta (Y.presheaf.stalk y) = 0) ∧
    ∃ ξ ∈ U, closure {ξ} = closure (U : Set Y) ∧
      ∃ φ : ↥(Y.presheaf.stalk ξ) ≃+* RatFunc k,
        φ.toRingHom.comp (wcNdSig q ξ) = algebraMap k (RatFunc k) :=
by
  intro k _ Y q U e hH
  classical
  have hUaff : IsAffine U.toScheme := IsAffine.of_isIso e.hom
  have hU : IsAffineOpen U := hUaff

  let ψ : Polynomial k ≃+* Γ(Y, U) :=
    ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).symm ≪≫ Scheme.Γ.mapIso e.op ≪≫
      U.topIso).commRingCatIsoToRingEquiv
  have h2 := congrArg (fun f => Scheme.Hom.appTop f) hH
  simp only [Scheme.Hom.comp_appTop] at h2
  have h3 : U.ι.appTop ≫ U.topIso.hom = Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op := by
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
    exact (Y.presheaf.map_comp _ _).symm
  have hkey : CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k) ≫
      (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫ e.hom.appTop ≫ U.topIso.hom =
      (Scheme.ΓSpecIso (.of k)).inv ≫ q.appTop ≫
        Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op := by
    rw [← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc, reassoc_of% h2, h3]
  have hψC : ∀ c : k, ψ (Polynomial.C c) = (Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
      (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c)) := by
    intro c
    exact congrArg (fun f => CommRingCat.Hom.hom f c) hkey

  haveI hdom : IsDomain Γ(Y, U) := MulEquiv.isDomain (Polynomial k) ψ.symm.toMulEquiv
  haveI hic : IsIntegrallyClosed Γ(Y, U) := IsIntegrallyClosed.of_equiv ψ
  refine ⟨?_, ?_⟩
  ·
    intro y hy
    let x : U := ⟨y, hy⟩
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk (x : Y)) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf x
    let P := (hU.primeIdealOf x).asIdeal
    haveI hloc : IsLocalization.AtPrime (Y.presheaf.stalk (x : Y)) P := hU.isLocalization_stalk x
    have hle : P.primeCompl ≤ nonZeroDivisors Γ(Y, U) := Ideal.primeCompl_le_nonZeroDivisors P
    haveI : IsDomain (Y.presheaf.stalk (x : Y)) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (M := P.primeCompl) _ hle
    haveI : IsIntegrallyClosed (Y.presheaf.stalk (x : Y)) :=
      isIntegrallyClosed_of_isLocalization _ P.primeCompl hle
    have hbot := IsIntegrallyClosed.integralClosure_eq_bot (Y.presheaf.stalk (x : Y))
      (FractionRing (Y.presheaf.stalk (x : Y)))
    have hrange : LinearMap.range (Algebra.linearMap (Y.presheaf.stalk (x : Y))
        ↥(integralClosure (Y.presheaf.stalk (x : Y)) (FractionRing (Y.presheaf.stalk (x : Y))))) =
        ⊤ := by
      rw [LinearMap.range_eq_top]
      intro z
      have hz : (z : FractionRing (Y.presheaf.stalk (x : Y))) ∈
