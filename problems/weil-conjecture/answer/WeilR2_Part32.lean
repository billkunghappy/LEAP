  obtain ⟨ηL, hηx, hηgen, p₀, hp₀x, hp₀ne⟩ :=
    wcpa_dj_lr1k_ebc_odfgd_exc_line Ω W hW hWt X uX ι hM σ' hP.1 w (hw.trans hP.2.1.symm) hSm
