    (IsLocalRing.residue R w₀) hpb0
  obtain ⟨P₁, hP₁⟩ := Polynomial.map_surjective (IsLocalRing.residue R)
    IsLocalRing.residue_surjective
    (Polynomial.map (IsLocalRing.residue R) p /ₘ
      (Polynomial.X - Polynomial.C (IsLocalRing.residue R w₀)) ^
        (Polynomial.map (IsLocalRing.residue R) p).rootMultiplicity (IsLocalRing.residue R w₀))
  refine ⟨(Polynomial.map (IsLocalRing.residue R) p).rootMultiplicity (IsLocalRing.residue R w₀),
    P₁, p - (Polynomial.X - Polynomial.C w₀) ^
      (Polynomial.map (IsLocalRing.residue R) p).rootMultiplicity (IsLocalRing.residue R w₀) * P₁,
    by ring, ?_, ?_⟩
  · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ← Polynomial.eval₂_at_apply,
      ← Polynomial.eval_map, hP₁]
    exact hev
  · intro i
    rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.coeff_map, Polynomial.map_sub,
      Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_sub, Polynomial.map_X,
      Polynomial.map_C, hP₁, hfac, sub_self, Polynomial.coeff_zero]

theorem wcpa_dj_lr1u_fn_tbv_content : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (r : Polynomial Ω), r ≠ 0 → ∃ (α : Ω) (r' : Polynomial ↥W), α ≠ 0 ∧ (∃ i, IsUnit (r'.coeff i)) ∧ r = Polynomial.C α * r'.map W.subtype :=
by
  intro Ω _ W r hr
  classical
  have hS : r.support.Nonempty := Polynomial.support_nonempty.mpr hr
  obtain ⟨j, hjS, hj⟩ := Finset.exists_max_image r.support (fun i => W.valuation (r.coeff i)) hS
  set α := r.coeff j with hαdef
  have hα : α ≠ 0 := Polynomial.mem_support_iff.mp hjS
  have hvα : 0 < W.valuation α := (Valuation.pos_iff _).mpr hα
  have key : ∀ i, α⁻¹ * r.coeff i ∈ W := by
    intro i
    by_cases hi : r.coeff i = 0
    · rw [hi, mul_zero]; exact W.zero_mem
    · have hle : W.valuation (r.coeff i) ≤ W.valuation α :=
        hj i (Polynomial.mem_support_iff.mpr hi)
      rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_mul, Valuation.map_inv]
      exact (inv_mul_le_one₀ hvα).mpr hle
  have hlift : Polynomial.C α⁻¹ * r ∈ Polynomial.lifts W.subtype := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    rw [Polynomial.coeff_C_mul]
    exact ⟨⟨_, key n⟩, rfl⟩
  obtain ⟨r', hr'⟩ := Polynomial.mem_lifts _ |>.mp hlift
  refine ⟨α, r', hα, ⟨j, ?_⟩, ?_⟩
  · have h1 : ((r'.coeff j : W) : Ω) = 1 := by
      have := congrArg (fun p => Polynomial.coeff p j) hr'
      simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at this
      rw [← hαdef, inv_mul_cancel₀ hα] at this
      exact this
    have h2 : r'.coeff j = 1 := Subtype.ext h1
    rw [h2]; exact isUnit_one
  · rw [hr', ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hα, Polynomial.C_1, one_mul]

theorem wcpa_dj_lr1u_fn_tbv_res_factor : ∀ (Ω K : Type u) [Field Ω] [Field K] (c : Ω →+* K) (W : ValuationSubring Ω) (V : ValuationSubring K) (g : K), (∀ ω : Ω, c ω ∈ V ↔ ω ∈ W) → g ∈ V → (∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.eval₂ (c.comp W.subtype) g ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) g)⁻¹ ∈ V) → (∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ c g ≠ 0 ∧ f * q.eval₂ c g = p.eval₂ c g) → (∀ (p : Polynomial ↥W) (w₀ : ↥W), (∃ i, IsUnit (p.coeff i)) → ∃ (m : ℕ) (P₁ Q : Polynomial ↥W), p = (Polynomial.X - Polynomial.C w₀) ^ m * P₁ + Q ∧ IsUnit (P₁.eval w₀) ∧ ∀ i, Q.coeff i ∈ IsLocalRing.maximalIdeal ↥W) → (∀ r : Polynomial Ω, r ≠ 0 → ∃ (α : Ω) (r' : Polynomial ↥W), α ≠ 0 ∧ (∃ i, IsUnit (r'.coeff i)) ∧ r = Polynomial.C α * r'.map W.subtype) → ∀ (w₀ : ↥W) (f : K), f ∈ V → ∃ (l : ↥W) (m n : ℕ) (P₁ Q₁ : Polynomial ↥W), IsUnit (P₁.eval w₀) ∧ IsUnit (Q₁.eval w₀) ∧ ∀ v ∈ V, (f * (g - c (w₀ : Ω)) ^ n * Q₁.eval₂ (c.comp W.subtype) g - c (l : Ω) * (g - c (w₀ : Ω)) ^ m * P₁.eval₂ (c.comp W.subtype) g) * v ≠ 1 :=
