by
  intro K _ T N φ hφ


  have afs : ∀ (Z : Scheme.{u}) (M : Z.Modules) (S : ∀ V : Z.Opens, IsAffineOpen V → Submodule Γ(Z, V) Γ(M, V)), (∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V) (s : Γ(M, V)), s ∈ S V hV → (M.presheaf.map (homOfLE hWV).op).hom s ∈ S W hW) → (∀ (V : Z.Opens) (hV : IsAffineOpen V) (m : Γ(M, V)), (∀ x ∈ V, ∃ (W : Z.Opens) (hW : IsAffineOpen W) (hWV : W ≤ V), x ∈ W ∧ (M.presheaf.map (homOfLE hWV).op).hom m ∈ S W hW) → m ∈ S V hV) → ∃ (K : Z.Modules) (ι : K ⟶ M), Mono ι ∧ (∀ V : Z.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) ∧ ∀ (V : Z.Opens) (hV : IsAffineOpen V) (m : Γ(M, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = m) ↔ m ∈ S V hV := by
    intro Z M S hR hL
