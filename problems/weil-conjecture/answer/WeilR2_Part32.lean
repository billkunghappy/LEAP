      (hz : Limits.pullback.fst (r ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w' ∈ O'),
      PrimeSpectrum.asIdeal (n ⟨_, hz⟩) = wcEbNode W a →
    ∃ h : Limits.pullback.fst (r ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w' ∈ U',
      Ideal.comap e.symm (hU'a.primeIdealOf ⟨_, h⟩).asIdeal =
        Ideal.span {algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V)
            {algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a) /
              algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
                algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ))})
            (g (MvPolynomial.X 0) -
              algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)),
          ⟨algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a) /
              algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
                algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)),
