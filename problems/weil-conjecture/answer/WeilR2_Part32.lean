    · rw [TopologicalSpace.Opens.coe_top]; exact dense_univ
    · rw [Scheme.Hom.preimage_top, TopologicalSpace.Opens.coe_top]; exact dense_univ
  have hχid : wcGcChi κ (𝟙 T ≫ s) c₁ := by rw [Category.id_comp]; exact hχ₁c
  obtain ⟨hfin, hopen, -, -⟩ := wcpa_dj_lr1k_ebcn_normdatum_generic κ (𝟙 T) s c₁ hND hχid
  haveI : Finite ↑(irreducibleComponents ↥T) := hfin.to_subtype
  obtain ⟨m, hm⟩ : ∃ m : ℕ, Nat.card ↑(irreducibleComponents ↥T) = m := ⟨_, rfl⟩
