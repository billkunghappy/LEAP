    have hne' : (hV.primeIdealOf ⟨a, haV⟩).asIdeal ≠ (hV.primeIdealOf ⟨b, hbV⟩).asIdeal := by
      intro h; apply hne; rw [← hPa, ← hQb, PrimeSpectrum.ext h]
