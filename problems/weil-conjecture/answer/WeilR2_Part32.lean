    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by rw [smul_eq_mul, mul_one]; exact hPh a)
  have hR : ∀ a, f a = (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
