theorem wcpa_dj_llsmgn_node_identify : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
    wcpaDjLkModel W uX ι →
    ∀ (x : ↥X) (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) ↥W →+* ↑Γ(X, V))
      (𝔭 : Ideal ↑Γ(X, V)), wcG2cChart W uX x V hle g 𝔭 →
    ∀ [Algebra ↥W ↑Γ(X, V)], algebraMap ↥W ↑Γ(X, V) = wcG2cPhi W uX V hle →
    ∀ (K : Type u) [Field K] [Algebra ↑Γ(X, V) K] [IsFractionRing ↑Γ(X, V) K]
      (σ : Spec (.of ↥W) ⟶ X) (a : ↥W), wcpaDjLlPair W uX x σ a →
      g (MvPolynomial.X 0) - algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ) ≠ 0 →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X'),
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r → wcpaDjLkModel W (r ≫ uX) ι' →
    ∀ (O : X.Opens) (hOV : O ≤ V) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))),
      O.topIso.hom.hom (m.appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) =
        (X.presheaf.map (homOfLE hOV).op).hom (g (MvPolynomial.X 0) -
          algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)) →
    ∀ (O' : X'.Opens) (hle' : O' ≤ r ⁻¹ᵁ O) (n : O'.toScheme ⟶ Spec (.of ↥(wcEbRing W a))),
