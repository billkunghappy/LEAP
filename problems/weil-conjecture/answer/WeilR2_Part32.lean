  refine ⟨κ₁.opensRange, hle, sX, haff, hrel, hgen, ?_, ?_, ?_⟩
  ·
    intro x hx hxcp
    obtain ⟨p, hp1, hp2⟩ := Scheme.exists_preimage_of_isPullback
