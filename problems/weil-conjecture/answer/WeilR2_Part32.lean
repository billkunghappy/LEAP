    apply Valuation.map_sum_lt _ one_ne_zero
    intro i _
    rw [mul_comm]
    exact hmul _ _ (by rw [Valuation.map_pow]; exact pow_le_one' hg1 i) (hcoef _ (hR i))
  obtain ⟨p, q, hq0, hfpq⟩ := hGEN f
  by_cases hp : p = 0
