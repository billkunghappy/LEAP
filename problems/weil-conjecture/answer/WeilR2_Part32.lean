    intro n
    induction n with
    | zero =>
      intro f hf hd
      exact ⟨0, by simp [Polynomial.eq_one_of_monic_natDegree_zero hf hd]⟩
    | succ n ih =>
      intro f hf hd
      have hgd : (f.map (algebraMap ↥W Ω)).natDegree = n + 1 := by
        rw [hf.natDegree_map]; exact hd
      have hgdeg : (f.map (algebraMap ↥W Ω)).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree (hf.map _).ne_zero, hgd]
