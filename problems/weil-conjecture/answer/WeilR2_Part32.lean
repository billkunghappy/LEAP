  obtain ⟨m, hm, a, ha, hadist⟩ : ∃ m : Ideal A, m.IsMaximal ∧ ∃ a : Fin P.natDegree → A,
      (∀ i, P.eval (a i) ∈ m) ∧ ∀ i j, i ≠ j → a i - a j ∉ m := by
    haveI : IsJacobsonRing A := isJacobsonRing_of_finiteType (A := Ω)
