    have hB := (E k).2
    have hBc : IsClosed (E k).1 := isClosed_of_mem_irreducibleComponents _ hB
    have hBo : IsOpen (E k).1 := hopen _ hB
    have hAB : (E i).1 ⊆ (E k).1 := by
      by_contra hns
      obtain ⟨y, hyA, hyB⟩ := Set.not_subset.mp hns
      obtain ⟨z, -, hz1, hz2⟩ := hA.1.2 _ _ hBo hBc.isOpen_compl
        ⟨x, (hmem i x).mp hxi, (hmem k x).mp hxk⟩ ⟨y, hyA, hyB⟩
      exact hz2 hz1
