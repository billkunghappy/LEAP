  have hW''d : Dense ((W₂ ⊔ ⟨(T : Set ↥Zt₂)ᶜ, hTc⟩ : Zt₂.Opens) : Set ↥Zt₂) := by
    intro x
    rw [TopologicalSpace.Opens.coe_sup]
