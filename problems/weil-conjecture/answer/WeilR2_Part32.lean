    · intro hx
      obtain ⟨p', hp'm, hp'c, hp'e⟩ := (hR x).mp hx
      have hl : p' ∈ Polynomial.lifts (algebraMap (↥S) Λ) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro i
        exact ⟨⟨p'.coeff i, hp'c i⟩, rfl⟩
      obtain ⟨P, hP, -, hPm⟩ := Polynomial.lifts_and_degree_eq_and_monic hl hp'm
      refine ⟨P, hPm, ?_⟩
      rw [← Polynomial.eval_map, hP, hp'e]
    · rintro ⟨P, hPm, hPe⟩
      refine (hR x).mpr ⟨P.map (algebraMap (↥S) Λ), hPm.map _, fun i => ?_, ?_⟩
      · rw [Polynomial.coeff_map]
