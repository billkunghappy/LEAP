  have loc₁ : ∀ p : ↥Zt₁, ∃ (V : Zt₁.Opens), p ∈ V ∧ ∃ h : V.toScheme ⟶ Zt₂,
      h ≫ ν₂ ≫ s₂ = V.ι ≫ ν₁ ≫ s₁ ∧
      Zt₁.homOfLE (inf_le_left : V ⊓ W₁ ≤ V) ≫ h =
        Zt₁.homOfLE (inf_le_right : V ⊓ W₁ ≤ W₁) ≫ (ψ ≫ W₂.ι) := by
    intro p
    by_cases hp : p ∈ W₁
    · exact ⟨W₁, hp, ψ ≫ W₂.ι, hcompat₁, rfl⟩
    · exact wcpa_dj_lr1k_ebcnt_local_extension κ Zt₁ Zt₂ (ν₁ ≫ s₁) (ν₂ ≫ s₂) hdom₁ hop₁ W₁ hW₁d
        (ψ ≫ W₂.ι) hcompat₁ p
        (wcpa_dj_lr1k_ebcnt_valuation_off_dense κ ν₁ s₁ c₁ hN₁ hχ₁ W₁ hW₁d p hp)
  obtain ⟨Φ', hΦ'W, hΦ's⟩ := wcpa_dj_lr1k_ebcnt_glue_extension κ Zt₁ Zt₂ (ν₁ ≫ s₁) (ν₂ ≫ s₂) W₁
