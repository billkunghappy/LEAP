  have hPD : algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) P =
      ↑ε⁻¹ * algebraMap ↥B₁ (Localization.Away (⟨g, hgB⟩ : ↥B₁)) ⟨t, htB⟩ := by
    rw [hε, ← mul_assoc, Units.inv_mul, one_mul]
  have htL : algebraMap Λ (Localization.Away g) t =
      algebraMap Ω (Localization.Away g) (c : Ω) * algebraMap Λ (Localization.Away g) s := by
    rw [← hcs, map_mul, ← IsScalarTower.algebraMap_apply ↥W Λ (Localization.Away g),
      IsScalarTower.algebraMap_apply ↥W Ω (Localization.Away g), hc']
