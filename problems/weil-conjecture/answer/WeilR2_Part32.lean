        rw [Scheme.Hom.coe_image] at hyV
        obtain ⟨x, hx, rfl⟩ := hyV
        have hxI : x ∈ I := ⟨hx, hyW⟩
        refine ⟨(⟨x, hxI⟩ : I.toScheme), ?_⟩
        rfl
      let k := IsOpenImmersion.lift (I.ι ≫ D.ι) (D.ι ''ᵁ VD ⊓ W).ι hrange
      have hk : k ≫ I.ι ≫ D.ι = (D.ι ''ᵁ VD ⊓ W).ι := IsOpenImmersion.lift_fac _ _ _
      have R1 : X.homOfLE (inf_le_left : D.ι ''ᵁ VD ⊓ W ≤ D.ι ''ᵁ VD) ≫ (D.ι.isoImage VD).inv = k ≫ D.toScheme.homOfLE (inf_le_left : I ≤ VD) := by
        rw [← cancel_mono (VD.ι ≫ D.ι)]
        rw [Category.assoc, Scheme.Hom.isoImage_inv_ι, Scheme.homOfLE_ι, Category.assoc, Scheme.homOfLE_ι_assoc, hk]
      have R2 : X.homOfLE (inf_le_right : D.ι ''ᵁ VD ⊓ W ≤ W) = k ≫ D.toScheme.homOfLE (inf_le_right : I ≤ D.ι ⁻¹ᵁ W) ≫ (D.ι ∣_ W) := by
        rw [← cancel_mono W.ι]
        rw [Scheme.homOfLE_ι, Category.assoc, Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι_assoc, hk]
      rw [← Category.assoc, R1, Category.assoc, hres, R2]
      simp only [Category.assoc]
  have s_div : ∀ (X : Scheme.{u}) (D : X.Opens) (x : D.toScheme) (hdiv : ∀ a b : ↥(X.presheaf.stalk (D.ι x)), a ∣ b ∨ b ∣ a), ∀ a b : ↥(D.toScheme.presheaf.stalk x), a ∣ b ∨ b ∣ a := by
    intro X D x hdiv
    intro a b
    let e := Iso.commRingCatIsoToRingEquiv (D.stalkIso x)
    rcases hdiv (e a) (e b) with h | h
    · left; have h2 := map_dvd e.symm h; rwa [e.symm_apply_apply, e.symm_apply_apply] at h2
    · right; have h2 := map_dvd e.symm h; rwa [e.symm_apply_apply, e.symm_apply_apply] at h2
  obtain ⟨D, hpD, hDint⟩ := s_comp X hdom hcomp p
  haveI := hDint
  let x₀ : D.toScheme := ⟨p, hpD⟩
  let WD : D.toScheme.Opens := D.ι ⁻¹ᵁ W
