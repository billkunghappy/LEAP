  have hchart : ∃ a : Fin (N + 1), ψ (genericPoint ↥T) ∈ wcSgD κ N a := by
    have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
