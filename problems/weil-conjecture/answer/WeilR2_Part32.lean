by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM E hE
  classical

  have hint_gen : ∀ {A B S T : Scheme.{u}} (ν : A ⟶ B) (u : B ⟶ S) (s : T ⟶ S) [IsIntegralHom ν],
      IsIntegralHom (Limits.pullback.map (ν ≫ u) s u s ν (𝟙 _) (𝟙 _) (by simp) (by simp)) := by
    intro A B S T ν u s _
    have hpb : IsPullback (Limits.pullback.map (ν ≫ u) s u s ν (𝟙 _) (𝟙 _) (by simp) (by simp))
