    · rw [RingHom.comp_apply, hιAX, hβb, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
  have hβι' : ∀ a : Polynomial ↥W, β (ιA a) = a.eval₂ (φ.comp W.subtype) t := fun a => by
    rw [← RingHom.comp_apply, hβι, Polynomial.coe_eval₂RingHom]
  have hσι : σ = ιA.comp Polynomial.C := by
    ext a
    rw [RingHom.comp_apply, hιAC]
  have hft : ιA.FiniteType := by
    rw [hσι] at hFT
