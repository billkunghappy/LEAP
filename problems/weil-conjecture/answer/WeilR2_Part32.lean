      exact m
    subst hU
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom σ, ?_⟩
    simp only [hε, RingHom.comp_apply]
    rw [← hσ]
    congr 1
    exact CategoryTheory.Iso.hom_inv_id_apply _ _
  have h3 : ε.EssFiniteType := (RingHom.FiniteType.of_surjective ε h2).essFiniteType
  have h4 : (Scheme.Hom.stalkMap s z).hom.EssFiniteType := LocallyOfFiniteType.stalkMap s z
  have h5 : (wcLdpConst K s z).EssFiniteType := by
    rw [h1]
    exact h3.comp h4
  letI := (wcLdpConst K s z).toAlgebra
  exact RingHom.essFiniteType_algebraMap.mp h5

theorem wcpa_dj_lr1k_gs_integral_stalk_algebraic : ∀ {A B : Scheme.{u}} (h : A ⟶ B) [IsIntegralHom h] (a : A), IsField (A.presheaf.stalk a) → IsField (B.presheaf.stalk (h a)) → letI := (h.stalkMap a).hom.toAlgebra; Algebra.IsAlgebraic (B.presheaf.stalk (h a)) (A.presheaf.stalk a) :=
