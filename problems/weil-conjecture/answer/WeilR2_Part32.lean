    · rw [reassoc_of% hΨW, hg'def, Category.assoc, Category.assoc, hΦ'W,
        IsIso.inv_hom_id_assoc, hisoι]
  refine ⟨Φ, ⟨Ψ, hΦΨ, hΨΦ⟩, ?_⟩
  rw [reassoc_of% hΦfac]
