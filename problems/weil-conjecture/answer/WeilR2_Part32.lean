    nlinarith
  obtain ⟨hfd, hrk⟩ := hRR ((e : ℤ) • D) hEη hEc
  have hsec := wc_gcf_chl_sections_rr κ T (j ≫ wcProjKStr κ N) hdim hclosed U hU ω hω ι hinj
    hres hord' hhart N j hEE hcoc hcov a ha D hDη ht hDt e
  letI : Algebra κ (FractionRing Γ(T, U)) := (wcCurveConst κ T (j ≫ wcProjKStr κ N) U).toAlgebra
  haveI : FiniteDimensional κ (wcRRSpace κ T (j ≫ wcProjKStr κ N) U ω ((e : ℤ) • D)) := hfd
  have hsemi : ∀ (c : κ) (s : Γ(T, j ⁻¹ᵁ wcSgD κ N a)),
      ι (j ⁻¹ᵁ wcSgD κ N a) ha (wcEszScal j (j ⁻¹ᵁ wcSgD κ N a) c * s) =
