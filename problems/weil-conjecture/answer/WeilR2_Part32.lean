      rw [← hq, hqc, Scheme.fromSpecStalk_closedPoint]
    obtain ⟨w, hwD, hwW⟩ := dense_iff_inter_open.mp hW D (hgen.2.1 D hD) ⟨p, hpD'⟩
    have hηW : hirr.genericPoint ∈ (W : Set ↥Zt) := (hη.specializes hwD).mem_open W.isOpen hwW
