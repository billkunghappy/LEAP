theorem wcpa_dj_lr1k_ebc_dad_mobius_normal_form : ∀ (Ω K : Type u) [Field Ω] [Field K]
    (W : ValuationSubring Ω) (φ : Ω →+* K) (t x : K) (ϖ : ↥W) (α β γ δ : Ω),
    (∀ p : Polynomial Ω, p.eval₂ φ t = 0 → p = 0) → α * δ - β * γ ≠ 0 →
    x * (φ γ * t + φ δ) = φ α * t + φ β → ϖ ≠ 0 →
    (∃ p q : Polynomial ↥W, IsUnit (q.coeff 0) ∧ p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W ∧
      x * q.eval₂ (φ.comp W.subtype) t = p.eval₂ (φ.comp W.subtype) t) →
    (∃ p q : Polynomial ↥W, IsUnit (q.coeff 0) ∧ p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W ∧
      (φ (ϖ : Ω) * x⁻¹) * q.eval₂ (φ.comp W.subtype) t = p.eval₂ (φ.comp W.subtype) t) →
    ∃ c g μ : ↥W, c ∈ IsLocalRing.maximalIdeal ↥W ∧ c ≠ 0 ∧ μ ≠ 0 ∧
      x * (1 + φ (g : Ω) * t) = φ (c : Ω) * (1 + φ ((g + μ : ↥W) : Ω) * t) :=
