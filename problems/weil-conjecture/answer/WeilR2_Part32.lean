      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd u s) (h₂₂ := u) (v₁₃ := s) ?_ ?_
        (IsPullback.of_hasPullback u s).flip
      · have e : Limits.pullback.map (ν ≫ u) s u s ν (𝟙 _) (𝟙 _) (by simp) (by simp) ≫
            Limits.pullback.snd u s = Limits.pullback.snd (ν ≫ u) s := by
          unfold Limits.pullback.map
          rw [Limits.pullback.lift_snd, Category.comp_id]
        rw [e]
        exact (IsPullback.of_hasPullback (ν ≫ u) s).flip
      · unfold Limits.pullback.map
        rw [Limits.pullback.lift_fst]
    exact MorphismProperty.of_isPullback hpb.flip inferInstance
  set Pm := Limits.pullback.map ((γ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      (γ ≫ ι).fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp) with hPm
  have hPiInt : IsIntegralHom Pm := hint_gen (γ ≫ ι).fromNormalization uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
  have hPiEq : ∀ y, wcpaDjLkPi W (γ ≫ ι) uX y = Pm y := fun y => rfl

  have hEmax : Maximal IsIrreducible E := hE
  have hEirr : IsIrreducible E := hEmax.1
  have hEc : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  obtain ⟨ξ, hξdef⟩ : ∃ ξ, ξ = hEirr.genericPoint := ⟨_, rfl⟩
  have hcl : closure ({ξ} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) = E := by
    have h1 := hEirr.isGenericPoint_genericPoint_closure
    rw [hEc.closure_eq, ← hξdef] at h1
    exact h1
  have hξE : ξ ∈ E := by
    rw [← hcl]
    exact subset_closure (Set.mem_singleton ξ)

  have hnc : ¬ IsClosed ({ξ} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) := by
    intro hξc
    have hdim := wcpa_dj_lr1k_gn_closed_dim_ge Ω W hW hWt C γ hcov X uX ι hM ξ hξc
    have hp : ∃ p : Ideal ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk ξ),
