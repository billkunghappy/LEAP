        (Localization.AtPrime (hU.primeIdealOf ⟨z, hz⟩).asIdeal)
        (Z.presheaf.stalk ((⟨z, hz⟩ : (j ⁻¹ᵁ wcSgD κ N a)) : Z))).toRingEquiv
    rw [← e1, H5 (hU.primeIdealOf ⟨z, hz⟩).asIdeal]
    unfold wcGcSkLocRk
    refine iSup_congr fun n => iSup_congr fun v => iSup_congr_Prop ?_ (fun _ => rfl)
    refine forall_congr' fun c => imp_congr_left ?_
    have hsc : ∀ i, wcEszScal (ν ≫ j) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) (c i) =
        ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl
