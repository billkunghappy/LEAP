          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
      rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hj, hj']
    exact isPullback_SpecMap_of_isPushout _ _ _ _ P
  have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
      (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
    simp only [Proj.opensRange_awayι]
    exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
  have hcomm : ∀ a : Fin (N + 1),
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
        Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos := fun a =>
    Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
  have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
        Nat.one_pos).opensRange =
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
    rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
  have H := s6 (Proj.map f hf)
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
    (Spec.map (CommRingCat.ofHom (algebraMap F F')))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
      (hX a) Nat.one_pos)
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
      (f.map_mem (hX a)) Nat.one_pos)
    (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
    hcov hcomm hpre hchart
  exact ⟨f, hf, hfmap, H⟩

theorem wc_gcf_ring_chart_facts (R : Type u) [CommRing R] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of R))
    (N : ℕ)
    (j : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hq : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = q)
    (a : Fin (N + 1)) :
    IsAffineOpen (j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
      (MvPolynomial.X a)) ∧
    Function.Surjective (wcGcfPsi j a) ∧
    (∀ r : R, wcGcfPsi j a (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0) r)) =
      wcGcfStr q (j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        (MvPolynomial.X a)) r) ∧
    ∀ (t : ℕ) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R t),
      wcGcfPsi j a (wcGcfMk R N a t G) = 0 →
      ∃ M : ℕ, ∀ b : Fin (N + 1), wcGcfPsi j b (wcGcfMk R N b (t + M) (wcGcfXMul a M G)) = 0 :=
by
  classical

  have htop : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), ⊤ ≤ g ⁻¹ᵁ ⊤ := fun g =>
    le_of_eq (Scheme.Hom.preimage_top g).symm
  have H1 : ∀ {X Y : Scheme.{u}} (g g' : X ⟶ Y) (hg : g = g') (U : Y.Opens) (V : X.Opens)
      (e : V ≤ g ⁻¹ᵁ U), g.appLE U V e = g'.appLE U V (hg ▸ e) := by
    intro X Y g g' hg U V e
    subst hg
    rfl
  have H2 : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (e : ⊤ ≤ g ⁻¹ᵁ ⊤), g.appLE ⊤ ⊤ e = g.appTop := by
    intro X Y g e
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl
  have ΓI : ∀ (S : CommRingCat.{u}) (y : S),
      (Scheme.ΓSpecIso S).hom.hom ((Scheme.ΓSpecIso S).inv.hom y) = y := by
    intro S y
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
      RingHom.id_apply]
  have chart : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (c : A) {m : ℕ} (hc : c ∈ 𝒜 m) (hm : 0 < m)
      (e : ⊤ ≤ Proj.awayι 𝒜 c hc hm ⁻¹ᵁ Proj.basicOpen 𝒜 c)
      (x : HomogeneousLocalization.Away 𝒜 c),
      ((Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ e).hom
          ((Proj.awayToSection 𝒜 c).hom x) =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 c))).inv.hom x := by
    intro σ A _ _ _ 𝒜 _ c m hc hm e x
    have hi : ∀ y, (Proj.basicOpenIsoSpec 𝒜 c hc hm).hom.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 c))).inv.hom y) =
        (Proj.basicOpen 𝒜 c).topIso.inv.hom ((Proj.awayToSection 𝒜 c).hom y) := by
      intro y
      rw [Proj.basicOpenIsoSpec_hom, Scheme.Hom.appTop, Proj.basicOpenToSpec_app_top]
      simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [ΓI]
    have e1 : (Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ e =
        (Proj.basicOpen 𝒜 c).ι.appLE (Proj.basicOpen 𝒜 c) ⊤
            (Scheme.Opens.ι_preimage_self (Proj.basicOpen 𝒜 c)).symm.le ≫
          (Proj.basicOpenIsoSpec 𝒜 c hc hm).inv.appLE ⊤ ⊤ (htop _) := by
      rw [Scheme.Hom.appLE_comp_appLE, H1 _ _ (Proj.basicOpenIsoSpec_inv_ι 𝒜 c hc hm).symm]
    have e2 : (Proj.basicOpen 𝒜 c).ι.appLE (Proj.basicOpen 𝒜 c) ⊤
        (Scheme.Opens.ι_preimage_self (Proj.basicOpen 𝒜 c)).symm.le =
        (Proj.basicOpen 𝒜 c).topIso.inv := by
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
      rfl
    rw [e1, e2, H2, CommRingCat.hom_comp, RingHom.comp_apply, ← hi, ← RingHom.comp_apply,
      ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop,
      CommRingCat.hom_id, RingHom.id_apply]

  have csec : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (c : A) {m : ℕ} (hc : c ∈ 𝒜 m) (hm : 0 < m)
      (S : CommRingCat.{u}) (φ : S ⟶ CommRingCat.of (𝒜 0))
      (h : Proj.basicOpen 𝒜 c ≤ (Proj.toSpecZero 𝒜 ≫ Spec.map φ) ⁻¹ᵁ ⊤) (r : S),
      (Proj.awayToSection 𝒜 c).hom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers c) (φ.hom r)) =
        ((Scheme.ΓSpecIso S).inv ≫
          (Proj.toSpecZero 𝒜 ≫ Spec.map φ).appLE ⊤ (Proj.basicOpen 𝒜 c) h).hom r := by
    intro σ A _ _ _ 𝒜 _ c m hc hm S φ h r
    have eA : ⊤ ≤ Proj.awayι 𝒜 c hc hm ⁻¹ᵁ Proj.basicOpen 𝒜 c := by
      intro z _
      show Proj.awayι 𝒜 c hc hm z ∈ Proj.basicOpen 𝒜 c
      rw [← Proj.opensRange_awayι 𝒜 c hc hm]
      exact ⟨z, rfl⟩
    have inj : ∀ z₁ z₂ : Γ(Proj 𝒜, Proj.basicOpen 𝒜 c),
        ((Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ eA).hom z₁ =
          ((Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ eA).hom z₂ → z₁ = z₂ := by
      have hsur : ∀ z : Γ(Proj 𝒜, Proj.basicOpen 𝒜 c), ∃ y,
          (Proj.awayToSection 𝒜 c).hom y = z := by
        intro z
        refine ⟨(Proj.basicOpenIsoAway 𝒜 c hc hm).inv.hom z, ?_⟩
        rw [← Proj.basicOpenIsoAway_hom 𝒜 c hc hm, ← RingHom.comp_apply,
          ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id, RingHom.id_apply]
      intro z₁ z₂ hz
      obtain ⟨y₁, rfl⟩ := hsur z₁
      obtain ⟨y₂, rfl⟩ := hsur z₂
      rw [chart, chart] at hz
      have hz' := congrArg (Scheme.ΓSpecIso _).hom.hom hz
      rw [ΓI, ΓI] at hz'
      rw [hz']
    apply inj
    rw [chart]
    have c1 := congrArg (fun ψ => ψ.hom ((Scheme.ΓSpecIso S).inv.hom r))
      (Scheme.Hom.appLE_comp_appLE (Proj.awayι 𝒜 c hc hm) (Proj.toSpecZero 𝒜 ≫ Spec.map φ) ⊤
        (Proj.basicOpen 𝒜 c) ⊤ h eA)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at c1 ⊢
    rw [c1, H2, ← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp]
    have c3 := congrArg (fun ψ => ψ.hom r) (Scheme.ΓSpecIso_inv_naturality
      (φ ≫ CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers c))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at c3
    exact c3

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine
        (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen
            ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

  have := hj
  have hX : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) R) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hD : ∀ c : Fin (N + 1), IsAffineOpen
      (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X c)) :=
    fun c => Proj.isAffineOpen_basicOpen _ _ (hX c) one_pos
  have hU : ∀ c : Fin (N + 1), IsAffineOpen
      (j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        (MvPolynomial.X c)) :=
    fun c => (hD c).preimage j

  have hsurj : ∀ c : Fin (N + 1), Function.Surjective (wcGcfPsi j c) := by
    intro c
    have h1 : Function.Surjective (Proj.awayToSection
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X c)).hom := by
      intro z
      refine ⟨(Proj.basicOpenIsoAway _ (MvPolynomial.X c) (hX c) one_pos).inv.hom z, ?_⟩
      rw [← Proj.basicOpenIsoAway_hom _ (MvPolynomial.X c) (hX c) one_pos, ← RingHom.comp_apply,
        ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id, RingHom.id_apply]
    have h2 := Scheme.Hom.app_surjective j _ (hD c)
    unfold wcGcfPsi
    rw [CommRingCat.hom_comp]
    exact h2.comp h1

  have hiii : ∀ r : R, wcGcfPsi j a (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0) r)) =
      wcGcfStr q (j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        (MvPolynomial.X a)) r := by
    intro r
    subst hq
    have hle : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        (MvPolynomial.X a) ≤
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0)))) ⁻¹ᵁ ⊤ :=
      le_top.trans (htop _)
    have hc := csec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X a)
      (hX a) one_pos (CommRingCat.of R)
      (CommRingCat.ofHom (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0)))
      hle r
    have e' := congrArg (fun ψ => ψ.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))
      (Scheme.Hom.appLE_comp_appLE j
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))))
        ⊤ _ _ hle le_rfl)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e' hc
    unfold wcGcfPsi wcGcfStr
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hc, Scheme.Hom.app_eq_appLE]
    exact e'
  refine ⟨hU a, hsurj a, hiii, ?_⟩

  intro t G h0

  have Imul : ∀ (b : Fin (N + 1)) (M : ℕ),
      wcGcfMk R N b (t + M) (wcGcfXMul a M G) =
        wcGcfMk R N b t G * (wcGcfMk R N b 1 ⟨MvPolynomial.X a, hX a⟩) ^ M := by
    intro b M
    apply HomogeneousLocalization.val_injective
    simp only [wcGcfMk, wcGcfXMul, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk, Localization.mk_pow,
      Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one, one_mul]; ring⟩
  have hkill : ∀ b : Fin (N + 1), ∃ n : ℕ,
      (wcGcfPsi j b (wcGcfMk R N b 1 ⟨MvPolynomial.X a, hX a⟩)) ^ n *
        wcGcfPsi j b (wcGcfMk R N b t G) = 0 := by
    intro b

    have hbo : Y.basicOpen (wcGcfPsi j b (wcGcfMk R N b 1 ⟨MvPolynomial.X a, hX a⟩)) ≤
        j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b) ⊓
          j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X a) := by
      have h1 : Y.basicOpen (wcGcfPsi j b (wcGcfMk R N b 1 ⟨MvPolynomial.X a, hX a⟩)) =
          j ⁻¹ᵁ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b) ⊓
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X a)) := by
        rw [L1 _ (MvPolynomial.X b) (MvPolynomial.X a) (hX b) (hX a), Scheme.preimage_basicOpen]
        rfl
      rw [h1, Scheme.Hom.preimage_inf]

    have hV : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          (MvPolynomial.X b) ⊓
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X a) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          (MvPolynomial.X b * MvPolynomial.X a) :=
      (Proj.basicOpen_mul _ _ _).ge
    have hVb : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          (MvPolynomial.X b * MvPolynomial.X a) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X b) :=
      (Proj.basicOpen_mul _ _ _).le.trans inf_le_left
    have hVa : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          (MvPolynomial.X b * MvPolynomial.X a) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X a) :=
      (Proj.basicOpen_mul _ _ _).le.trans inf_le_right
    have hO : j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b) ⊓
          j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X a) ≤
        j ⁻¹ᵁ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b) ⊓
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X a)) :=
      (Scheme.Hom.preimage_inf j).ge
    let θ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        (MvPolynomial.X b * MvPolynomial.X a) →+*
        Γ(Y, j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b) ⊓
          j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X a)) :=
      (j.appLE _ _ hO).hom.comp
        (((@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          MvPolynomial.gradedAlgebra).presheaf.map (homOfLE hV).op).hom.comp
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          (MvPolynomial.X b * MvPolynomial.X a)).hom)
    have key : ∀ (m : Fin (N + 1)) (g : MvPolynomial (Fin (N + 1)) R)
        (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 1)
        (hx : MvPolynomial.X b * MvPolynomial.X a = MvPolynomial.X m * g)
        (hle1 : j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b) ⊓
          j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X a) ≤
          j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X m))
        (hle2 : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          (MvPolynomial.X b * MvPolynomial.X a) ≤
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X m))
        (z : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          (MvPolynomial.X m)),
        (Y.presheaf.map (homOfLE hle1).op).hom (wcGcfPsi j m z) =
          θ (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            hg hx z) := by
      intro m g hg hx hle1 hle2 z
      have e1 : j.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X m)) ≫ Y.presheaf.map (homOfLE hle1).op =
          (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            MvPolynomial.gradedAlgebra).presheaf.map (homOfLE hle2).op ≫
            (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
              MvPolynomial.gradedAlgebra).presheaf.map (homOfLE hV).op ≫ j.appLE _ _ hO := by
        rw [← Category.assoc, ← Functor.map_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map,
          Scheme.Hom.map_appLE]
      have e3 := Proj.awayMap_awayToSection
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) hg hx
      have E : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X m) ≫ j.app (Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (MvPolynomial.X m)) ≫
            Y.presheaf.map (homOfLE hle1).op =
          CommRingCat.ofHom (HomogeneousLocalization.awayMap
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) hg hx) ≫
            Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
              (MvPolynomial.X b * MvPolynomial.X a) ≫
            (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
              MvPolynomial.gradedAlgebra).presheaf.map (homOfLE hV).op ≫ j.appLE _ _ hO := by
        rw [e1, ← Category.assoc, ← Category.assoc, ← e3]
        rfl
      exact congrArg (fun φ => φ.hom z) E
    have Ifrac : HomogeneousLocalization.awayMap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (hX a)
          (rfl : MvPolynomial.X b * MvPolynomial.X a = MvPolynomial.X b * MvPolynomial.X a)
          (wcGcfMk R N b t G) =
        (HomogeneousLocalization.awayMap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (hX a)
          (rfl : MvPolynomial.X b * MvPolynomial.X a = MvPolynomial.X b * MvPolynomial.X a)
          (wcGcfMk R N b 1 ⟨MvPolynomial.X a, hX a⟩)) ^ t *
        HomogeneousLocalization.awayMap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (hX b)
          (mul_comm _ _ : MvPolynomial.X b * MvPolynomial.X a = MvPolynomial.X a * MvPolynomial.X b)
          (wcGcfMk R N a t G) := by
      apply HomogeneousLocalization.val_injective
      simp only [wcGcfMk, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk,
        Localization.mk_pow, Localization.mk_mul]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow, OneMemClass.coe_one, one_mul]; ring⟩
    have hres : (Y.presheaf.map (homOfLE (inf_le_left :
        j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b) ⊓
          j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X a) ≤
          j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
            (MvPolynomial.X b))).op).hom (wcGcfPsi j b (wcGcfMk R N b t G)) = 0 := by
      rw [key b (MvPolynomial.X a) (hX a) rfl inf_le_left hVb, Ifrac, map_mul, map_pow,
        ← key a (MvPolynomial.X b) (hX b) (mul_comm _ _) inf_le_right hVa, h0, map_zero, mul_zero]

    obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Y (hU b)
      (wcGcfPsi j b (wcGcfMk R N b t G))
      (wcGcfPsi j b (wcGcfMk R N b 1 ⟨MvPolynomial.X a, hX a⟩)) (by
        change (Y.presheaf.map (homOfLE (Y.basicOpen_le _)).op).hom _ = 0
        have e : Y.presheaf.map (homOfLE (Y.basicOpen_le
            (wcGcfPsi j b (wcGcfMk R N b 1 ⟨MvPolynomial.X a, hX a⟩)))).op =
            Y.presheaf.map (homOfLE inf_le_left).op ≫ Y.presheaf.map (homOfLE hbo).op := by
          rw [← Functor.map_comp]; rfl
        rw [e, CommRingCat.hom_comp, RingHom.comp_apply, hres, map_zero])
    exact ⟨n, hn⟩
  choose n hn using hkill
  refine ⟨∑ b, n b, fun b => ?_⟩
  rw [Imul b, map_mul, map_pow]
  have hle : n b ≤ ∑ b, n b :=
    Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ b)
  obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le hle
  rw [hk, pow_add, ← mul_assoc, mul_comm (wcGcfPsi j b (wcGcfMk R N b t G)), hn b, zero_mul]

theorem wc_gcf_generic_span (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (N e : ℕ)
    (B C : Fin (N + 1) → CommRingCat.{u})
    (ψ : ∀ a : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a) →+* B a)
    (ψ' : ∀ a : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X a) →+* C a)
    (ρ : ∀ a : Fin (N + 1), B a →+* C a)
    (H3 : ∀ (a : Fin (N + 1)) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e),
      ψ' a (wcGcfMk Ω N a e (wcGcfPush (algebraMap ↥W Ω) N e F)) = ρ a (ψ a (wcGcfMk (↥W) N a e F)))
    (H4 : ∀ a : Fin (N + 1), Function.Injective (ρ a)) :
    Submodule.span Ω (wcGcfKer ψ' e) =
      Submodule.span Ω (wcGcfPush (algebraMap ↥W Ω) N e '' wcGcfKer ψ e) :=
by
  classical
  have hinj : Function.Injective (algebraMap ↥W Ω) := IsFractionRing.injective ↥W Ω

  have hclear : ∀ F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω e,
      ∃ c : Ω, c ≠ 0 ∧ ∃ F' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e,
        wcGcfPush (algebraMap ↥W Ω) N e F' = c • F := by
    intro F
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors ↥W)
      (S := Ω) (F : MvPolynomial (Fin (N + 1)) Ω).coeffs
    have hc0 : algebraMap ↥W Ω (b : ↥W) ≠ 0 := by
      intro h
      apply nonZeroDivisors.ne_zero b.2
      apply hinj
      rw [map_zero]; exact h
    have hrange : algebraMap ↥W Ω (b : ↥W) • (F : MvPolynomial (Fin (N + 1)) Ω) ∈
        Set.range (MvPolynomial.map (algebraMap ↥W Ω)) := by
      rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
      intro y hy
      rw [Finset.mem_coe, MvPolynomial.mem_coeffs_iff] at hy
      obtain ⟨m, hm, rfl⟩ := hy
      have hm' : (F : MvPolynomial (Fin (N + 1)) Ω).coeff m ≠ 0 := by
        intro h0
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_smul, h0, smul_zero] at hm
        exact hm rfl
      obtain ⟨w, hw⟩ := hb _ (MvPolynomial.mem_coeffs_iff.mpr
        ⟨m, MvPolynomial.mem_support_iff.mpr hm', rfl⟩)
      refine ⟨w, ?_⟩
      rw [MvPolynomial.coeff_smul, smul_eq_mul, hw, Algebra.smul_def]
    obtain ⟨Q, hQ⟩ := hrange
    have hQh : Q ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      intro m hm
      have hF := (MvPolynomial.mem_homogeneousSubmodule _ _).mp F.2
      apply hF
      intro h0
      apply hm
      apply hinj
      rw [map_zero, ← MvPolynomial.coeff_map, hQ, MvPolynomial.coeff_smul, h0, smul_zero]
    refine ⟨algebraMap ↥W Ω (b : ↥W), hc0, ⟨Q, hQh⟩, ?_⟩
    apply Subtype.ext
    exact hQ

  have hmk : ∀ (a : Fin (N + 1)) (c : Ω) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω e),
      ∃ u, wcGcfMk Ω N a e (c • F) = u * wcGcfMk Ω N a e F := by
    intro a c F
    refine ⟨HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)) 0
      (MvPolynomial.C c) ?_, ?_⟩
    · convert (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ c)
        using 2 <;> simp
    · apply HomogeneousLocalization.val_injective
      simp only [wcGcfMk, HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk]
      rw [Localization.mk_mul]
      congr 1
      · simp [Submodule.coe_smul, MvPolynomial.smul_eq_C_mul]
      · ext; simp
  apply le_antisymm
  · rw [Submodule.span_le]
    intro F hF
    simp only [wcGcfKer, Set.mem_setOf_eq] at hF
    obtain ⟨c, hc0, F', hF'⟩ := hclear F
    have hF'mem : F' ∈ wcGcfKer ψ e := by
      simp only [wcGcfKer, Set.mem_setOf_eq]
      intro a
      apply H4 a
      rw [map_zero, ← H3, hF']
      obtain ⟨u, hu⟩ := hmk a c F
      rw [hu, map_mul, hF a, mul_zero]
    have hFeq : F = c⁻¹ • wcGcfPush (algebraMap ↥W Ω) N e F' := by
      rw [hF', inv_smul_smul₀ hc0]
    rw [SetLike.mem_coe, hFeq]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨F', hF'mem, rfl⟩)
  · apply Submodule.span_mono
    rintro _ ⟨F, hF, rfl⟩
    simp only [wcGcfKer, Set.mem_setOf_eq] at hF ⊢
    intro a
    rw [H3, hF a, map_zero]

theorem wc_gcf_special_span (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (N : ℕ)
    (B C : Fin (N + 1) → CommRingCat.{u})
    (ψ : ∀ a : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a) →+* B a)
    (ψ' : ∀ a : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (IsLocalRing.ResidueField ↥W))
        (MvPolynomial.X a) →+* C a)
    (ρ : ∀ a : Fin (N + 1), B a →+* C a) (ιB : ∀ a : Fin (N + 1), ↥W →+* B a)
    (H1 : ∀ (a : Fin (N + 1)) (w : ↥W), ψ a (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0) w)) = ιB a w)
    (H3 : ∀ (a : Fin (N + 1)) (e : ℕ) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e),
      ψ' a (wcGcfMk (IsLocalRing.ResidueField ↥W) N a e
        (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e F)) =
        ρ a (ψ a (wcGcfMk (↥W) N a e F)))
    (H4 : ∀ (a : Fin (N + 1)) (b : B a), ρ a b = 0 →
      b ∈ Ideal.map (ιB a) (IsLocalRing.maximalIdeal ↥W))
    (H5 : ∀ a : Fin (N + 1), Function.Surjective (ψ a))
    (H6 : ∀ (a : Fin (N + 1)) (t : ℕ) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t),
      ψ a (wcGcfMk (↥W) N a t G) = 0 →
      ∃ M : ℕ, ∀ b : Fin (N + 1), ψ b (wcGcfMk (↥W) N b (t + M) (wcGcfXMul a M G)) = 0) :
    ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e →
      Submodule.span (IsLocalRing.ResidueField ↥W) (wcGcfKer ψ' e) =
        Submodule.span (IsLocalRing.ResidueField ↥W)
          (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e '' wcGcfKer ψ e) :=
by
  classical

  have hval : ∀ (a : Fin (N + 1)) (t : ℕ)
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t),
      (wcGcfMk (↥W) N a t G).val = (Localization.mk G.1 ⟨MvPolynomial.X a ^ t, t, rfl⟩ :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) ↥W)) := by
    intro a t G
    unfold wcGcfMk
    rw [HomogeneousLocalization.Away.val_mk]
  have mkA : ∀ (a : Fin (N + 1)) (t s n : ℕ)
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t)
      (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W s)
      (P : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W n), n = t + s → P.1 = G.1 * H.1 →
      wcGcfMk (↥W) N a n P = wcGcfMk (↥W) N a t G * wcGcfMk (↥W) N a s H := by
    intro a t s n G H P hn hP
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, hval, hval, hval, Localization.mk_mul, hP]
    congr 1
    apply Subtype.ext
    simp [hn, pow_add]
  have mkB : ∀ (a : Fin (N + 1)) (t t' : ℕ)
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t)
      (G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t'),
      MvPolynomial.X a ^ t' * G.1 = MvPolynomial.X a ^ t * G'.1 →
      wcGcfMk (↥W) N a t G = wcGcfMk (↥W) N a t' G' := by
    intro a t t' G G' h
    apply HomogeneousLocalization.val_injective
    rw [hval, hval, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul]
    exact h
  have mkC : ∀ (a : Fin (N + 1)) (t : ℕ)
      (G H P : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t),
      P.1 = G.1 + H.1 → wcGcfMk (↥W) N a t P = wcGcfMk (↥W) N a t G + wcGcfMk (↥W) N a t H := by
    intro a t G H P hP
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_add, hval, hval, hval, Localization.add_mk_self, hP]
  have mkE : ∀ (a : Fin (N + 1)) (t : ℕ) (P : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t),
      P.1 = 0 → wcGcfMk (↥W) N a t P = 0 := by
    intro a t P hP
    apply HomogeneousLocalization.val_injective
    rw [hval, hP, HomogeneousLocalization.val_zero, Localization.mk_zero]
  have mkD : ∀ (a : Fin (N + 1)) (r : ↥W) (P : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0),
      P.1 = MvPolynomial.C r → wcGcfMk (↥W) N a 0 P = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0) r) := by
    intro a r P hP
    apply HomogeneousLocalization.val_injective
    rw [hval]
    simp only [HomogeneousLocalization.fromZeroRingHom]
    rw [hP]
    congr 1 <;> first | rfl | (apply Subtype.ext; simp) | simp [MvPolynomial.algebraMap_eq]

  obtain ⟨S, hS⟩ : ∃ S : Set (MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W)),
      S = {P | ∃ (t : ℕ) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t),
        G ∈ wcGcfKer ψ t ∧
          P = (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N t G).1} := ⟨_, rfl⟩
  have hSmem : ∀ P, P ∈ S ↔ ∃ (t : ℕ) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t),
      G ∈ wcGcfKer ψ t ∧
        P = (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N t G).1 := by
    intro P; subst hS; exact Iff.rfl

  have s1 : ∀ J : Ideal (MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W)),
      ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e →
        ∀ F : MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W), F.IsHomogeneous e →
          (∀ a : Fin (N + 1), ∃ M : ℕ, MvPolynomial.X a ^ M * F ∈ J) → F ∈ J := by
    intro J
    obtain ⟨Sig, hSig⟩ : ∃ Sig : Set (MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W)),
        Sig = {G | ∃ d : ℕ, G.IsHomogeneous d ∧ ∀ a : Fin (N + 1), ∃ M : ℕ,
          MvPolynomial.X a ^ M * G ∈ J} := ⟨_, rfl⟩
    have hSigmem : ∀ G, G ∈ Sig ↔ ∃ d : ℕ, G.IsHomogeneous d ∧ ∀ a : Fin (N + 1), ∃ M : ℕ,
        MvPolynomial.X a ^ M * G ∈ J := by
      intro G; subst hSig; exact Iff.rfl
    have hfg : (Submodule.span (MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W)) Sig).FG :=
      IsNoetherian.noetherian _
    obtain ⟨s, hsS, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset Sig).mp hfg
    have hch : ∀ G : MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W), ∃ (d : ℕ) (M : ℕ),
        G ∈ Sig → (G.IsHomogeneous d ∧ ∀ a : Fin (N + 1), MvPolynomial.X a ^ M * G ∈ J) := by
      intro G
      by_cases hG : G ∈ Sig
      · obtain ⟨d, hd, hM⟩ := (hSigmem G).mp hG
        choose M hM using hM
        refine ⟨d, ∑ b, M b, fun _ => ⟨hd, fun a => ?_⟩⟩
        have hle : M a ≤ ∑ b, M b :=
          Finset.single_le_sum (f := M) (fun b _ => Nat.zero_le _) (Finset.mem_univ a)
        have heq : MvPolynomial.X a ^ (∑ b, M b) * G =
            MvPolynomial.X a ^ (∑ b, M b - M a) * (MvPolynomial.X a ^ M a * G) := by
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
        rw [heq]
        exact J.mul_mem_left _ (hM a)
      · exact ⟨0, 0, fun h => absurd h hG⟩
    choose d M hdM using hch
    refine ⟨∑ G ∈ s, (d G + (N + 1) * M G), ?_⟩
    intro e he F hF hsat
    have hFS : F ∈ Sig := (hSigmem F).mpr ⟨e, hF, hsat⟩
    have hFT : F ∈ Submodule.span (MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W))
        (↑s : Set (MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W))) := by
      rw [← hspan]; exact Submodule.subset_span hFS
    obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp hFT
    have key : ∀ G ∈ s, ∀ p : MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W),
        MvPolynomial.homogeneousComponent e (p * G) ∈ J := by
      intro G hGs p
      have hGS : G ∈ Sig := hsS hGs
      obtain ⟨hGd, hGM⟩ := hdM G hGS
      have hle : d G + (N + 1) * M G ≤ e :=
        le_trans (Finset.single_le_sum (f := fun G => d G + (N + 1) * M G)
          (fun _ _ => Nat.zero_le _) hGs) he
      induction p using MvPolynomial.induction_on' with
      | monomial ν r =>
        have hhom : (MvPolynomial.monomial ν r * G).IsHomogeneous (Finsupp.degree ν + d G) :=
          (MvPolynomial.isHomogeneous_monomial r rfl).mul hGd
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hhom)]
        split_ifs with heq
        · have hex : ∃ a, M G ≤ ν a := by
            by_contra hcon
            push_neg at hcon
            have h1 : Finsupp.degree ν < (N + 1) * M G := by
              rw [Finsupp.degree_eq_sum]
              calc ∑ i, ν i < ∑ _i : Fin (N + 1), M G :=
                    Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty (fun i _ => hcon i)
                _ = (N + 1) * M G := by simp
            generalize (N + 1) * M G = K at h1 hle
            omega
          obtain ⟨a, ha⟩ := hex
          have hν : ν = (ν - Finsupp.single a (M G)) + Finsupp.single a (M G) :=
            (tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr ha)).symm
          rw [hν, MvPolynomial.monomial_add_single, mul_assoc]
          exact J.mul_mem_left _ (hGM a)
        · exact J.zero_mem
      | add p q hp hq =>
        rw [add_mul, map_add]
        exact J.add_mem hp hq
    have hFe : F = MvPolynomial.homogeneousComponent e F :=
      (MvPolynomial.homogeneousComponent_eq_self hF).symm
    rw [hFe, ← hc, map_sum]
    exact J.sum_mem (fun G hG => by rw [smul_eq_mul]; exact key G hG (c G))

  have s3 : ∀ (e : ℕ)
      (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (IsLocalRing.ResidueField ↥W) e),
      F.1 ∈ Ideal.span S →
      F ∈ Submodule.span (IsLocalRing.ResidueField ↥W)
        (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e '' wcGcfKer ψ e) := by
    have stab : ∀ (t n : ℕ) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t)
        (ν : Fin (N + 1) →₀ ℕ) (G'' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W n),
        n = t + Finsupp.degree ν → G''.1 = G.1 * MvPolynomial.monomial ν 1 →
        G ∈ wcGcfKer ψ t → G'' ∈ wcGcfKer ψ n := by
      intro t n G ν G'' hn hG'' hG
      have hG' : ∀ b, ψ b (wcGcfMk (↥W) N b t G) = 0 := hG
      have hm : MvPolynomial.monomial ν (1 : ↥W) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W (Finsupp.degree ν) :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_monomial 1 rfl)
      show ∀ b, ψ b (wcGcfMk (↥W) N b n G'') = 0
      intro b
      rw [mkA b t (Finsupp.degree ν) n G ⟨_, hm⟩ G'' hn hG'', map_mul, hG' b, zero_mul]
    intro e F hF
    have key : ∀ P ∈ S, ∀ c : MvPolynomial (Fin (N + 1)) (IsLocalRing.ResidueField ↥W),
        MvPolynomial.homogeneousComponent e (c * P) ∈ Submodule.map
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (IsLocalRing.ResidueField ↥W) e).subtype
          (Submodule.span (IsLocalRing.ResidueField ↥W)
            (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e '' wcGcfKer ψ e)) := by
      intro P hP c
      obtain ⟨t, G, hG, rfl⟩ := (hSmem P).mp hP
      have hPh : (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N t G).1.IsHomogeneous t :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mp
          (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N t G).2
      induction c using MvPolynomial.induction_on' with
      | monomial ν r =>
        have hhom := (MvPolynomial.isHomogeneous_monomial r (rfl : Finsupp.degree ν = _)).mul hPh
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hhom)]
        split_ifs with heq
        · have hG''mem : G.1 * MvPolynomial.monomial ν 1 ∈
              MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e := by
            rw [MvPolynomial.mem_homogeneousSubmodule, heq, add_comm (Finsupp.degree ν) t]
            exact ((MvPolynomial.mem_homogeneousSubmodule _ _).mp G.2).mul
              (MvPolynomial.isHomogeneous_monomial 1 rfl)
          have hker := stab t e G ν ⟨_, hG''mem⟩ (by omega) rfl hG
          have hpush : MvPolynomial.monomial ν r *
              (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N t G).1 =
              r • (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e ⟨_, hG''mem⟩).1 := by
            show MvPolynomial.monomial ν r *
                MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) G.1 =
              r • MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
                (G.1 * MvPolynomial.monomial ν 1)
            rw [map_mul, MvPolynomial.map_monomial, map_one, MvPolynomial.smul_eq_C_mul,
              mul_comm (MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) G.1),
              ← mul_assoc, MvPolynomial.C_mul_monomial, mul_one]
          rw [hpush]
          exact Submodule.smul_mem _ r
            (Submodule.mem_map_of_mem (Submodule.subset_span (Set.mem_image_of_mem _ hker)))
        · exact Submodule.zero_mem _
      | add p q hp hq =>
        rw [add_mul, map_add]
        exact Submodule.add_mem _ hp hq
    obtain ⟨T, hTS, hFT⟩ := Submodule.mem_span_finite_of_mem_span hF
    obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp hFT
    have hFe : F.1 ∈ Submodule.map
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (IsLocalRing.ResidueField ↥W) e).subtype
        (Submodule.span (IsLocalRing.ResidueField ↥W)
          (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e '' wcGcfKer ψ e)) := by
      have h1 : F.1 = MvPolynomial.homogeneousComponent e F.1 :=
        (MvPolynomial.homogeneousComponent_eq_self
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mp F.2)).symm
      rw [h1, ← hf, map_sum]
      exact Submodule.sum_mem _ (fun P hP => by rw [smul_eq_mul]; exact key P (hTS hP) (f P))
    obtain ⟨y, hy, hyF⟩ := Submodule.mem_map.mp hFe
    have hyF' : y = F := Subtype.ext hyF
    rw [← hyF']; exact hy

  have s2 : ∀ (a : Fin (N + 1)) (e : ℕ)
      (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (IsLocalRing.ResidueField ↥W) e),
      ψ' a (wcGcfMk (IsLocalRing.ResidueField ↥W) N a e F) = 0 →
      ∃ M : ℕ, MvPolynomial.X a ^ M * F.1 ∈ Ideal.span S := by
    intro a e F hF

    have hφs : Function.Surjective (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective
    obtain ⟨P, hP⟩ := MvPolynomial.map_surjective _ hφs F.1
    obtain ⟨F', hF'def⟩ : ∃ F' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e,
        F'.1 = MvPolynomial.homogeneousComponent e P :=
      ⟨⟨_, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        (MvPolynomial.homogeneousComponent_isHomogeneous e P)⟩, rfl⟩
    have hF'F : MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) F'.1 = F.1 := by
      have h1 := MvPolynomial.homogeneousComponent_eq_self
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mp F.2)
      rw [← hP] at h1 ⊢
      rw [← h1, hF'def]
      ext d
      simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent]
      split_ifs <;> simp
    have hpushF' : wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e F' = F :=
      Subtype.ext hF'F

    have hb0 : ρ a (ψ a (wcGcfMk (↥W) N a e F')) = 0 := by
      rw [← H3 a e F', hpushF', hF]
    have hmem : ψ a (wcGcfMk (↥W) N a e F') ∈
        Submodule.span (B a) ((ιB a) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)) := H4 a _ hb0

    have hQ : ∀ b ∈ Submodule.span (B a) ((ιB a) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W)),
        ∃ (t : ℕ) (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W t),
          MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) H.1 = 0 ∧
          ψ a (wcGcfMk (↥W) N a t H) = b := by
      intro b hb
      induction hb using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨m, hm, rfl⟩ := hx
        have hC : MvPolynomial.C m ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ _)
        refine ⟨0, ⟨_, hC⟩, ?_, ?_⟩
        · show MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) (MvPolynomial.C m) = 0
          rw [MvPolynomial.map_C, MvPolynomial.C_eq_zero]
          exact (IsLocalRing.residue_eq_zero_iff m).mpr hm
        · rw [mkD a m ⟨_, hC⟩ rfl, H1]
      | zero =>
        refine ⟨0, 0, ?_, ?_⟩
        · simp
        · rw [mkE a 0 0 rfl, map_zero]
      | add x y _ _ hx hy =>
        obtain ⟨t₁, H₁, h₁, rfl⟩ := hx
        obtain ⟨t₂, H₂, h₂, rfl⟩ := hy
        have m1 : MvPolynomial.X a ^ t₂ * H₁.1 ∈
            MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W (t₁ + t₂) := by
          rw [MvPolynomial.mem_homogeneousSubmodule, add_comm t₁ t₂]
          exact (MvPolynomial.isHomogeneous_X_pow a t₂).mul
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mp H₁.2)
        have m2 : MvPolynomial.X a ^ t₁ * H₂.1 ∈
            MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W (t₁ + t₂) :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mpr ((MvPolynomial.isHomogeneous_X_pow a t₁).mul
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mp H₂.2))
        refine ⟨t₁ + t₂, ⟨_, Submodule.add_mem _ m1 m2⟩, ?_, ?_⟩
        · show MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
            (MvPolynomial.X a ^ t₂ * H₁.1 + MvPolynomial.X a ^ t₁ * H₂.1) = 0
          rw [map_add, map_mul, map_mul, h₁, h₂, mul_zero, mul_zero, add_zero]
        · have e1 : MvPolynomial.X a ^ (t₁ + t₂) * H₁.1 =
              MvPolynomial.X a ^ t₁ * (MvPolynomial.X a ^ t₂ * H₁.1) := by ring
          have e2 : MvPolynomial.X a ^ (t₁ + t₂) * H₂.1 =
              MvPolynomial.X a ^ t₂ * (MvPolynomial.X a ^ t₁ * H₂.1) := by ring
          rw [mkC a (t₁ + t₂) ⟨_, m1⟩ ⟨_, m2⟩ ⟨_, Submodule.add_mem _ m1 m2⟩ rfl, map_add,
            ← mkB a t₁ (t₁ + t₂) H₁ ⟨_, m1⟩ e1, ← mkB a t₂ (t₁ + t₂) H₂ ⟨_, m2⟩ e2]
      | smul c x _ hx =>
        obtain ⟨t, H, hH, rfl⟩ := hx
        obtain ⟨y, rfl⟩ := H5 a c
        obtain ⟨s, Q, hQ, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ _)) y
        have hQ' : Q ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W s := by simpa using hQ
        have hy : ∀ hf hQ, HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) hf s Q hQ =
            wcGcfMk (↥W) N a s ⟨Q, hQ'⟩ := fun _ _ => rfl
        have mQH : Q * H.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W (s + t) :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
            (((MvPolynomial.mem_homogeneousSubmodule _ _).mp hQ').mul
              ((MvPolynomial.mem_homogeneousSubmodule _ _).mp H.2))
        refine ⟨s + t, ⟨_, mQH⟩, ?_, ?_⟩
        · show MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) (Q * H.1) = 0
          rw [map_mul, hH, mul_zero]
        · rw [hy, smul_eq_mul, ← map_mul, ← mkA a s t (s + t) ⟨Q, hQ'⟩ H ⟨_, mQH⟩ rfl rfl]
    obtain ⟨t, H, hH, hHe⟩ := hQ _ hmem

    have mD1 : MvPolynomial.X a ^ t * F'.1 ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W (e + t) := by
      rw [MvPolynomial.mem_homogeneousSubmodule, add_comm e t]
      exact (MvPolynomial.isHomogeneous_X_pow a t).mul
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mp F'.2)
    have mD2 : MvPolynomial.X a ^ e * H.1 ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W (e + t) :=
      (MvPolynomial.mem_homogeneousSubmodule _ _).mpr ((MvPolynomial.isHomogeneous_X_pow a e).mul
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mp H.2))
    have mD : MvPolynomial.X a ^ t * F'.1 - MvPolynomial.X a ^ e * H.1 ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W (e + t) := Submodule.sub_mem _ mD1 mD2
    have e1 : MvPolynomial.X a ^ (e + t) * F'.1 =
        MvPolynomial.X a ^ e * (MvPolynomial.X a ^ t * F'.1) := by ring
    have e2 : MvPolynomial.X a ^ (e + t) * H.1 =
        MvPolynomial.X a ^ t * (MvPolynomial.X a ^ e * H.1) := by ring
    have hD0 : ψ a (wcGcfMk (↥W) N a (e + t) ⟨_, mD⟩) = 0 := by
      have h1 := mkC a (e + t) ⟨_, mD⟩ ⟨_, mD2⟩ ⟨_, mD1⟩ (sub_add_cancel _ _).symm
      have h2 : ψ a (wcGcfMk (↥W) N a (e + t) ⟨_, mD1⟩) =
          ψ a (wcGcfMk (↥W) N a (e + t) ⟨_, mD2⟩) := by
        rw [← mkB a e (e + t) F' ⟨_, mD1⟩ e1, ← mkB a t (e + t) H ⟨_, mD2⟩ e2, hHe]
      rw [h1, map_add] at h2
      linear_combination h2

    obtain ⟨M, hM⟩ := H6 a (e + t) ⟨_, mD⟩ hD0
    refine ⟨t + M, ?_⟩
    have hJ : (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N (e + t + M)
        (wcGcfXMul a M ⟨_, mD⟩)).1 ∈ Ideal.span S :=
      Ideal.subset_span ((hSmem _).mpr ⟨_, _, hM, rfl⟩)
    have heq : (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N (e + t + M)
        (wcGcfXMul a M ⟨_, mD⟩)).1 = MvPolynomial.X a ^ (t + M) * F.1 := by
      show MvPolynomial.map (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
        ((MvPolynomial.X a ^ t * F'.1 - MvPolynomial.X a ^ e * H.1) * MvPolynomial.X a ^ M) = _
      rw [map_mul, map_sub, map_mul, map_mul, hH, hF'F]
      simp only [map_pow, MvPolynomial.map_X]
      ring
    rw [← heq]; exact hJ

  obtain ⟨e₀, he₀⟩ := s1 (Ideal.span S)
  refine ⟨e₀, fun e he => le_antisymm ?_ ?_⟩
  · rw [Submodule.span_le]
    intro F hF
    have hF' : ∀ a, ψ' a (wcGcfMk (IsLocalRing.ResidueField ↥W) N a e F) = 0 := hF
    apply s3 e F
    apply he₀ e he F.1 ((MvPolynomial.mem_homogeneousSubmodule _ _).mp F.2)
    intro a
    exact s2 a e F (hF' a)
  · apply Submodule.span_mono
    rintro _ ⟨G, hG, rfl⟩
    have hG' : ∀ a, ψ a (wcGcfMk (↥W) N a e G) = 0 := hG
    show ∀ a, ψ' a (wcGcfMk (IsLocalRing.ResidueField ↥W) N a e
      (wcGcfPush (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) N e G)) = 0
    intro a
    rw [H3 a e G, hG' a, map_zero]

theorem wc_gcf_graded_free_rank (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (N e : ℕ)
    (B : Fin (N + 1) → CommRingCat.{u})
    (ψ : ∀ a : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a) →+* B a)
    (ιB : ∀ a : Fin (N + 1), ↥W →+* B a)
    (H1 : ∀ (a : Fin (N + 1)) (w : ↥W), ψ a (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0) w)) = ιB a w)
    (Htf : ∀ (a : Fin (N + 1)) (w : ↥W), w ≠ 0 → ∀ b : B a, ιB a w * b = 0 → b = 0) :
    ∃ r : ℕ, ∀ (K : Type u) [Field K] (φ : ↥W →+* K),
      Module.finrank K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ⧸
        Submodule.span K (wcGcfPush φ N e '' wcGcfKer ψ e)) = r :=
by
  classical

  obtain ⟨Jf, hJ⟩ : ∃ Jf : Finset (Fin (N + 1) →₀ ℕ), ∀ d, d ∈ Jf ↔ Finsupp.degree d = e :=
    ⟨(Finset.univ : Finset (Fin (N + 1))).finsuppAntidiag e, fun d => by
      rw [Finset.mem_finsuppAntidiag, Finsupp.degree_eq_sum]; simp⟩
  obtain ⟨mon, hmon⟩ : ∃ mon : ∀ (R : Type u) [CommRing R], ↥Jf →
      ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e),
      ∀ (R : Type u) [CommRing R] (d : ↥Jf),
        ((mon R d : MvPolynomial (Fin (N + 1)) R)) = MvPolynomial.monomial d.1 1 :=
    ⟨fun R _ d => ⟨MvPolynomial.monomial d.1 1, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
      (MvPolynomial.isHomogeneous_monomial _ ((hJ _).mp d.2))⟩, fun _ _ _ => rfl⟩

  have F1 : ∀ (R : Type u) [CommRing R]
      (x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e)),
      x = ∑ d : ↥Jf, (x : MvPolynomial (Fin (N + 1)) R).coeff d.1 • mon R d := by
    intro R _ x
    apply Subtype.ext
    rw [Submodule.coe_sum]
    simp only [Submodule.coe_smul, hmon, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    rw [Finset.sum_coe_sort Jf
      (fun d => MvPolynomial.monomial d ((x : MvPolynomial (Fin (N + 1)) R).coeff d))]
    conv_lhs => rw [MvPolynomial.as_sum (x : MvPolynomial (Fin (N + 1)) R)]
    apply Finset.sum_subset
    · intro d hd
      rw [hJ]
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hd)
        (((MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2).coeff_eq_zero hne)
    · intro d _ hd
      rw [MvPolynomial.notMem_support_iff.mp hd, map_zero]

  have hmk_add : ∀ (a : Fin (N + 1))
      (F G : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e)),
      wcGcfMk (↥W) N a e (F + G) = wcGcfMk (↥W) N a e F + wcGcfMk (↥W) N a e G := by
    intro a F G
    apply HomogeneousLocalization.val_injective
    simp only [wcGcfMk, HomogeneousLocalization.val_add, HomogeneousLocalization.Away.val_mk,
      Localization.add_mk_self, Submodule.coe_add]
  have hmk_zero : ∀ (a : Fin (N + 1)), wcGcfMk (↥W) N a e 0 = 0 := by
    intro a
    apply HomogeneousLocalization.val_injective
    simp [wcGcfMk, HomogeneousLocalization.Away.val_mk, Localization.mk_zero]
  have hmk_smul : ∀ (a : Fin (N + 1)) (w : ↥W)
      (F : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e)),
      wcGcfMk (↥W) N a e (w • F) = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0) w) *
        wcGcfMk (↥W) N a e F := by
    intro a w F
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul]
    have hz : (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0) w)).val =
        Localization.mk (MvPolynomial.C w) 1 := by
      rfl
    rw [hz]
    simp only [wcGcfMk, HomogeneousLocalization.Away.val_mk]
    rw [Localization.mk_mul, one_mul]
    congr 1
    rw [Submodule.coe_smul, MvPolynomial.smul_eq_C_mul]

  have h0 : ∀ a, ψ a (wcGcfMk (↥W) N a e 0) = 0 := fun a => by rw [hmk_zero, map_zero]
  have hadd : ∀ (F G : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e)),
      (∀ a, ψ a (wcGcfMk (↥W) N a e F) = 0) → (∀ a, ψ a (wcGcfMk (↥W) N a e G) = 0) →
      ∀ a, ψ a (wcGcfMk (↥W) N a e (F + G)) = 0 := fun F G hF hG a => by
    rw [hmk_add, map_add, hF a, hG a, add_zero]
  have hsm : ∀ (w : ↥W) (F : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e)),
      (∀ a, ψ a (wcGcfMk (↥W) N a e F) = 0) →
      ∀ a, ψ a (wcGcfMk (↥W) N a e (w • F)) = 0 := fun w F hF a => by
    rw [hmk_smul, map_mul, H1, hF a, mul_zero]
  have hst : ∀ (w : ↥W) (F : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W e)),
      w ≠ 0 → (∀ a, ψ a (wcGcfMk (↥W) N a e (w • F)) = 0) →
      ∀ a, ψ a (wcGcfMk (↥W) N a e F) = 0 := fun w F hw hF a => by
    have h := hF a
    rw [hmk_smul, map_mul, H1] at h
    exact Htf a w hw _ h

  have key : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsBezout R] [IsLocalRing R]
      (P : Set ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e)),
      (0 ∈ P) → (∀ F G, F ∈ P → G ∈ P → F + G ∈ P) → (∀ (w : R) F, F ∈ P → w • F ∈ P) →
      (∀ (w : R) F, w ≠ 0 → w • F ∈ P → F ∈ P) →
      ∃ r : ℕ, ∀ (K : Type u) [Field K] (φ : R →+* K),
        Module.finrank K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ⧸
          Submodule.span K (wcGcfPush φ N e '' P)) = r := by
    intro R _ _ _ _ P hP0 hPadd hPsm hPst
    obtain ⟨I, hI⟩ : ∃ I : Submodule R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e),
        (I : Set _) = P :=
      ⟨{ carrier := P
         add_mem' := fun {F G} hF hG => hPadd F G hF hG
         zero_mem' := hP0
         smul_mem' := fun w F hF => hPsm w F hF }, rfl⟩
    have hsat : ∀ (w : R) (x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e)),
        w ≠ 0 → w • x ∈ I → x ∈ I := by
      intro w x hw hx
      rw [← SetLike.mem_coe, hI] at hx ⊢
      exact hPst w x hw hx

    haveI hfinS : Module.Finite R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) := by
      refine ⟨⟨Finset.univ.image (mon R), ?_⟩⟩
      rw [eq_top_iff]
      intro x _
      rw [F1 R x]
      exact Submodule.sum_mem _ fun d _ => Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
    haveI : Module.Finite R (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ⧸ I) :=
      Module.Finite.quotient R I
    have htors : Submodule.torsion R
        (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ⧸ I) = ⊥ := by
      rw [eq_bot_iff]
      intro q hq
      obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff q).mp hq
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective I q
      rw [Submonoid.smul_def, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at ha
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
      exact hsat _ _ (nonZeroDivisors.ne_zero a.2) ha
    haveI : Module.Flat R (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ⧸ I) :=
      Module.Flat.flat_iff_torsion_eq_bot_of_isBezout.mpr htors
    haveI : Module.Free R (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ⧸ I) :=
      Module.free_of_flat_of_isLocalRing
    obtain ⟨r, hr⟩ : ∃ r, Module.finrank R
        (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ⧸ I) = r := ⟨_, rfl⟩
    obtain ⟨b⟩ : Nonempty (Module.Basis (Fin r) R
        (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ⧸ I)) :=
      ⟨(Module.finBasis _ _).reindex (finCongr hr)⟩
    choose c hc using fun i => Submodule.Quotient.mk_surjective I (b i)
    refine ⟨r, fun K _ φ => ?_⟩

    obtain ⟨πL, hπ⟩ : ∃ πL : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) →ₛₗ[φ]
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e), ∀ x, πL x = wcGcfPush φ N e x :=
      ⟨{ toFun := wcGcfPush φ N e
         map_add' := fun x y => Subtype.ext (by simp [wcGcfPush])
         map_smul' := fun w x => Subtype.ext (by simp [wcGcfPush, MvPolynomial.smul_eq_C_mul]) },
       fun _ => rfl⟩
    have hπmon : ∀ d, πL (mon R d) = mon K d := by
      intro d
      rw [hπ]
      apply Subtype.ext
      show MvPolynomial.map φ (mon R d : MvPolynomial (Fin (N + 1)) R) = _
      rw [hmon, hmon, MvPolynomial.map_monomial, map_one]
    have hπcoeff : ∀ x d, (πL x : MvPolynomial (Fin (N + 1)) K).coeff d =
        φ ((x : MvPolynomial (Fin (N + 1)) R).coeff d) := by
      intro x d
      rw [hπ]
      exact MvPolynomial.coeff_map _ _ _
    obtain ⟨v, hv⟩ : ∃ v : ↥Jf → (Fin r →₀ R),
        ∀ d, v d = b.repr (Submodule.Quotient.mk (mon R d)) := ⟨_, fun _ => rfl⟩
    obtain ⟨Λ, hΛ⟩ : ∃ Λ : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) →ₗ[K] (Fin r → K),
        ∀ y, Λ y = ∑ d : ↥Jf, (y : MvPolynomial (Fin (N + 1)) K).coeff d.1 • (fun i => φ (v d i)) :=
      ⟨∑ d : ↥Jf, LinearMap.smulRight ((MvPolynomial.lcoeff K d.1).comp (Submodule.subtype _))
        (fun i => φ (v d i)), fun y => by simp [LinearMap.sum_apply]⟩
    have hrepr : ∀ x, b.repr (Submodule.Quotient.mk x) =
        ∑ d : ↥Jf, (x : MvPolynomial (Fin (N + 1)) R).coeff d.1 • v d := by
      intro x
      have hx := congrArg (fun z => b.repr (I.mkQ z)) (F1 R x)
      simp only [map_sum, map_smul, Submodule.mkQ_apply] at hx
      rw [hx]
      simp only [hv]
    have hΛπ : ∀ x, Λ (πL x) = fun i => φ (b.repr (Submodule.Quotient.mk x) i) := by
      intro x
      funext i
      rw [hΛ, hrepr]
      simp only [hπcoeff, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finsupp.coe_finset_sum,
        Finsupp.smul_apply, map_sum, map_mul]
    have hs : ∀ i j : Fin r, φ (Finsupp.single i (1 : R) j) = if i = j then 1 else 0 := by
      intro i j
      rw [Finsupp.single_apply]
      split_ifs <;> simp
    have hΛc : ∀ i, Λ (πL (c i)) = fun j => if i = j then 1 else 0 := by
      intro i
      rw [hΛπ, hc, b.repr_self]
      funext j
      exact hs i j
    obtain ⟨V, hV⟩ : ∃ V : Submodule K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e),
        V = Submodule.span K (wcGcfPush φ N e '' (I : Set _)) := ⟨_, rfl⟩
    rw [← hI, ← hV]
    have hmemV : ∀ x ∈ I, πL x ∈ V := fun x hx => by
      rw [hV, hπ]
      exact Submodule.subset_span ⟨x, hx, rfl⟩
    have hVΛ : V ≤ LinearMap.ker Λ := by
      rw [hV, Submodule.span_le]
      rintro _ ⟨x, hx, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, ← hπ, hΛπ, (Submodule.Quotient.mk_eq_zero I).mpr hx,
        map_zero]
      funext i
      simp
    have ht : ∀ d, mon R d - ∑ i, v d i • c i ∈ I := by
      intro d
      rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, map_sub, map_sum]
      simp only [map_smul, Submodule.mkQ_apply, hc, hv, b.sum_repr, sub_self]
    have KC : ∀ y, y - ∑ i, Λ y i • πL (c i) ∈ V := by
      intro y
      have e1 : ∑ d : ↥Jf, (y : MvPolynomial (Fin (N + 1)) K).coeff d.1 •
          πL (mon R d - ∑ i, v d i • c i) =
          (∑ d : ↥Jf, (y : MvPolynomial (Fin (N + 1)) K).coeff d.1 • mon K d) -
            ∑ i, Λ y i • πL (c i) := by
        simp only [map_sub, map_sum, map_smulₛₗ, hπmon, smul_sub, Finset.sum_sub_distrib,
          Finset.smul_sum, hΛ, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_smul,
          smul_smul]
        congr 1
        exact Finset.sum_comm
      rw [← F1 K y] at e1
      rw [← e1]
      exact Submodule.sum_mem _ fun d _ => Submodule.smul_mem _ _ (hmemV _ (ht d))
    have hinj : Function.Injective (V.liftQ Λ hVΛ) := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro q hq
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective V q
      rw [LinearMap.mem_ker, Submodule.liftQ_apply] at hq
      have h := KC y
      rw [hq] at h
      simp only [Pi.zero_apply, zero_smul, Finset.sum_const_zero, sub_zero] at h
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
      exact h
    have hsurj : Function.Surjective (V.liftQ Λ hVΛ) := by
      intro z
      refine ⟨Submodule.Quotient.mk (∑ i, z i • πL (c i)), ?_⟩
      rw [Submodule.liftQ_apply, map_sum]
      simp only [map_smul, hΛc]
      funext j
      simp
    rw [LinearEquiv.finrank_eq (LinearEquiv.ofBijective _ ⟨hinj, hsurj⟩), Module.finrank_fin_fun]
  exact key (↥W) (wcGcfKer ψ e) h0 hadd hsm hst

theorem wc_gcf_flat_hilb_const : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (q : Y ⟶ Spec (.of ↥W)) (N : ℕ) (j : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), Flat q → IsClosedImmersion j → j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = q → ∃ (jκ : Limits.pullback q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⟶ wcProjK (IsLocalRing.ResidueField ↥W) N) (jΩ : Limits.pullback q (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ⟶ wcProjK Ω N), IsClosedImmersion jκ ∧ jκ ≫ wcProjKStr (IsLocalRing.ResidueField ↥W) N = Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ∧ IsClosedImmersion jΩ ∧ jΩ ≫ wcProjKStr Ω N = Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧ ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → wcGcHilb jκ e = wcGcHilb jΩ e :=
by
  intro Ω _ W Y q N j hfl hj hq

  have s8 : ∀ (V : Y.Opens), IsAffineOpen V →
      ∀ w : ↥W, w ≠ 0 → ∀ b : Γ(Y, V), wcGcfStr q V w * b = 0 → b = 0 := by
    intro V hV w hw b hb
    have h1 : RingHom.Flat (q.appLE ⊤ V (by simp)).hom :=
      HasRingHomProperty.appLE @Flat q hfl ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ _
    have h2 : RingHom.Flat (Scheme.ΓSpecIso (.of ↥W)).inv.hom :=
      RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)
    have h3 : RingHom.Flat (wcGcfStr q V) := by
      unfold wcGcfStr
      rw [CommRingCat.hom_comp]
      exact h2.comp h1
    letI := (wcGcfStr q V).toAlgebra
    have : Module.Flat ↥W Γ(Y, V) := h3
    have hreg := Module.IsTorsionFree.isSMulRegular (R := ↥W) (M := Γ(Y, V))
      (IsRegular.of_ne_zero hw)
    apply hreg
    show w • b = w • 0
    rw [smul_zero, Algebra.smul_def]
    exact hb

  have s7a : ∀ (B C : CommRingCat.{u}) (f : CommRingCat.of ↥W ⟶ B)
      (ρ : B ⟶ C) (ι : CommRingCat.of (IsLocalRing.ResidueField ↥W) ⟶ C),
      IsPushout f (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ρ ι →
      ∀ b : B, ρ.hom b = 0 → b ∈ Ideal.map f.hom (IsLocalRing.maximalIdeal ↥W) := by
    intro B C f ρ ι h b hb
    set I := Ideal.map f.hom (IsLocalRing.maximalIdeal ↥W) with hI
    have hker : ∀ r ∈ IsLocalRing.maximalIdeal ↥W, (Ideal.Quotient.mk I) (f.hom r) = 0 :=
      fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hr)
    let k : IsLocalRing.ResidueField ↥W →+* B ⧸ I :=
      Ideal.Quotient.lift _ ((Ideal.Quotient.mk I).comp f.hom) hker
    have hw : f ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
        CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) ≫
          CommRingCat.ofHom k := by
      ext r
      rfl
    have hd := h.inl_desc (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom k) hw
    have e := congrArg (fun g : B ⟶ CommRingCat.of (B ⧸ I) => g.hom b) hd
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, hb, map_zero,
      CommRingCat.hom_ofHom] at e
    exact Ideal.Quotient.eq_zero_iff_mem.mp e.symm

  have s7b : ∀ (B C : CommRingCat.{u}) (f : CommRingCat.of ↥W ⟶ B)
      (ρ : B ⟶ C) (ι : CommRingCat.of Ω ⟶ C),
      IsPushout f (CommRingCat.ofHom (algebraMap ↥W Ω)) ρ ι →
      (∀ r : ↥W, r ≠ 0 → ∀ b : B, f.hom r * b = 0 → b = 0) → Function.Injective ρ.hom := by
    intro B C f ρ ι h htf
    letI : Algebra ↥W B := f.hom.toAlgebra
    let S := Algebra.algebraMapSubmonoid B (nonZeroDivisors ↥W)
    have hu : ∀ y : nonZeroDivisors ↥W,
        IsUnit (((algebraMap B (Localization S)).comp f.hom) y) := by
      intro y
      exact IsLocalization.map_units (Localization S) (⟨f.hom y, ⟨y, y.2, rfl⟩⟩ : S)
    let k : Ω →+* Localization S := IsLocalization.lift hu
    have hw : f ≫ CommRingCat.ofHom (algebraMap B (Localization S)) =
        CommRingCat.ofHom (algebraMap ↥W Ω) ≫ CommRingCat.ofHom k := by
      ext r
      change algebraMap B (Localization S) (f.hom r) = k (algebraMap ↥W Ω r)
      rw [IsLocalization.lift_eq]
      rfl
    have hd := h.inl_desc _ _ hw
    have key : ∀ b, ρ.hom b = 0 → b = 0 := by
      intro b hb
      have e := congrArg (fun g : B ⟶ CommRingCat.of (Localization S) => g.hom b) hd
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, hb, map_zero,
        CommRingCat.hom_ofHom] at e
      obtain ⟨⟨m, hm⟩, hmb⟩ := (IsLocalization.map_eq_zero_iff S (Localization S) b).mp e.symm
      obtain ⟨r, hr, rfl⟩ := hm
      exact htf r (nonZeroDivisors.ne_zero hr) b hmb
    intro x y hxy
    have : ρ.hom (x - y) = 0 := by rw [map_sub, hxy, sub_self]
    exact sub_eq_zero.mp (key _ this)
  obtain ⟨jκ, hjκ, hjκs, ρκ, hρκ, hpκ⟩ := wc_gcf_closed_bc_charts (↥W)
    (IsLocalRing.ResidueField ↥W) (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) Y q N j hj hq
  obtain ⟨jΩ, hjΩ, hjΩs, ρΩ, hρΩ, hpΩ⟩ :=
    wc_gcf_closed_bc_charts (↥W) Ω (algebraMap ↥W Ω) Y q N j hj hq
  have hc := wc_gcf_ring_chart_facts (↥W) Y q N j hj hq
  have htf : ∀ (a : Fin (N + 1)) (w : ↥W), w ≠ 0 → ∀ b : Γ(Y, j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a)),
      wcGcfStr q (j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
        (MvPolynomial.X a)) w * b = 0 → b = 0 :=
    fun a => s8 _ (hc a).1
  have hH4κ : ∀ (a : Fin (N + 1)) (b : Γ(Y, j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a))),
      (ρκ a).hom b = 0 → b ∈ Ideal.map (wcGcfStr q (j ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a)))
        (IsLocalRing.maximalIdeal ↥W) :=
    fun a => s7a _ _ _ (ρκ a) _ (hpκ a)
  have hH4Ω : ∀ a : Fin (N + 1), Function.Injective (ρΩ a).hom :=
    fun a => s7b _ _ _ (ρΩ a) _ (hpΩ a) (htf a)
  obtain ⟨e₀, he₀⟩ := wc_gcf_special_span Ω W N _ _ (wcGcfPsi j) (wcGcfPsi jκ)
    (fun a => (ρκ a).hom)
    (fun a => wcGcfStr q (j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a)))
    (fun a => (hc a).2.2.1) hρκ hH4κ (fun a => (hc a).2.1) (fun a => (hc a).2.2.2)
  refine ⟨jκ, jΩ, hjκ, hjκs, hjΩ, hjΩs, e₀, fun e he => ?_⟩
  obtain ⟨r, hr⟩ := wc_gcf_graded_free_rank Ω W N e _ (wcGcfPsi j)
    (fun a => wcGcfStr q (j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) (MvPolynomial.X a)))
    (fun a => (hc a).2.2.1) htf
  have hg := wc_gcf_generic_span Ω W N e _ _ (wcGcfPsi j) (wcGcfPsi jΩ) (fun a => (ρΩ a).hom)
    (fun a F => hρΩ a e F) hH4Ω
  have h1 : wcGcHilb jκ e = Module.finrank (IsLocalRing.ResidueField ↥W)
      (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (IsLocalRing.ResidueField ↥W) e) ⧸
        Submodule.span (IsLocalRing.ResidueField ↥W) (wcGcfKer (wcGcfPsi jκ) e)) := rfl
  have h2 : wcGcHilb jΩ e = Module.finrank Ω
      (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω e) ⧸
        Submodule.span Ω (wcGcfKer (wcGcfPsi jΩ) e)) := rfl
  rw [h1, h2, he₀ e he, hg, hr (IsLocalRing.ResidueField ↥W) (algebraMap ↥W _),
    hr Ω (algebraMap ↥W Ω)]

theorem wc_gcf_chl_curve_setup : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) [IrreducibleSpace C] (ct : C ⟶ Spec (.of Ω)), wcpaDjIsProjOver Ω ct → SmoothOfRelativeDimension 1 ct → IsProper ct ∧ (∀ x : C, IsDomain (C.presheaf.stalk x) ∧ IsIntegrallyClosed (C.presheaf.stalk x)) ∧ topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞) ∧ (∀ y : C, y ≠ genericPoint C → IsClosed ({y} : Set C)) ∧ ∃ (U : C.Opens) (hU : IsAffineOpen U) (_ : IsDedekindDomain Γ(C, U)), ((U : Set C)ᶜ).Finite ∧ ∃ ω : C → Additive (FractionRing Γ(C, U))ˣ →+ ℤ, wcCurveOrdData Ω C ct U hU ω ∧ wcTrueOrd C U ω ∧ ∃ g c₀ : ℕ, ∀ D : C →₀ ℤ, D (genericPoint C) = 0 → (c₀ : ℤ) ≤ D.sum (fun _ k => k) → @FiniteDimensional Ω (wcRRSpace Ω C ct U ω D) _ _ (@Submodule.module Ω _ _ _ (wcCurveConst Ω C ct U).toAlgebra.toModule _) ∧ (@Module.finrank Ω (wcRRSpace Ω C ct U ω D) _ _ (@Submodule.module Ω _ _ _ (wcCurveConst Ω C ct U).toAlgebra.toModule _) : ℤ) = D.sum (fun _ k => k) + 1 - g :=
by
  intro Ω _ _ C _ ct hproj hsm
  haveI := hsm
  have hprop : IsProper ct := wcpa_dj_proj_proper Ω ct hproj
  haveI := hprop
  have hstalk : ∀ x : C, IsDomain (C.presheaf.stalk x) ∧
      IsIntegrallyClosed (C.presheaf.stalk x) := by
    intro x
    haveI := wcpa_smooth_stalk_isDomain Ω C ct 1 x
    haveI := wcpa_dj_sgt_smooth_curve_stalk_valuation Ω C ct x
    exact ⟨inferInstance, inferInstance⟩
  have hdim : topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le Ω C ct 1) (wc_smooth_irreducible_dim_ge Ω C ct 1)
  have hclosed : ∀ y : C, y ≠ genericPoint C → IsClosed ({y} : Set C) := by
    intro y hy
    exact (wc_curve_points_closed_opens_compact Ω C ct hdim).1 {y} (Set.finite_singleton y)
      (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  obtain ⟨U, hU, hUfin, hDed⟩ := wc_curve_dedekind_affine_open Ω C ct inferInstance hstalk hdim
  haveI := hDed
  obtain ⟨ord, hord⟩ := wc_curve_ord_data_exists Ω C ct hstalk hdim U hU hUfin
  obtain ⟨g₁, c₁, hRR₁⟩ := wc_curve_riemann_roch_large_degree Ω C ct hstalk hdim U hU hUfin ord hord
  obtain ⟨σ, ordT, -, -, hordT, htrue⟩ :=
    wc_curve_ord_transport Ω C ct hstalk hdim U hU hUfin ord hord g₁ c₁ hRR₁
  obtain ⟨g, c₀, hRR⟩ :=
    wc_curve_riemann_roch_large_degree Ω C ct hstalk hdim U hU hUfin ordT hordT
  exact ⟨hprop, hstalk, hdim, hclosed, U, hU, hDed, hUfin, ordT, hordT, htrue, g, c₀, hRR⟩

theorem wc_gcf_chl_fn_embed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite → ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω → wcTrueOrd X U ω → ∃ ι : ∀ W : X.Opens, genericPoint X ∈ W → Γ(X, W) →+* FractionRing Γ(X, U), (∀ (W : X.Opens) (hW : genericPoint X ∈ W), Function.Injective (ι W hW)) ∧ (∀ (W W' : X.Opens) (h : W' ≤ W) (hW' : genericPoint X ∈ W') (s : Γ(X, W)), ι W' hW' ((X.presheaf.map (homOfLE h).op).hom s) = ι W (h hW') s) ∧ (∀ (W : X.Opens) (hW : genericPoint X ∈ W) (c : Ω), ι W hW ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) = wcCurveConst Ω X fX U c) ∧ (∀ (W : X.Opens) (hW : genericPoint X ∈ W) (y : X) (hy : y ∈ W), IsClosed ({y} : Set X) → ∀ (s : Γ(X, W)) (hs : ι W hW s ≠ 0), 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ∧ (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ↔ (X.evaluation W y hy).hom s = 0)) ∧ (∀ (W : X.Opens) (hW : genericPoint X ∈ W) (u : FractionRing Γ(X, U)), (∀ y : X, y ∈ W → IsClosed ({y} : Set X) → u = 0 ∨ ∃ hu : u ≠ 0, 0 ≤ ω y (Additive.ofMul (Units.mk0 u hu))) → ∃ s : Γ(X, W), ι W hW s = u) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω htrue
  classical
  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hηU : genericPoint X ∈ U := (wc_dedekind_affine_points X U hU).1
  haveI : Nonempty U := ⟨⟨_, hηU⟩⟩
  have hmemη : ∀ (V : X.Opens) (x : X), x ∈ V → genericPoint X ∈ V :=
    fun V x hx => (genericPoint_specializes x).mem_open V.isOpen hx
  have hcl : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    (wc_curve_points_closed_opens_compact Ω X fX hdim).1 {y} (Set.finite_singleton y)
      (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hηnc : ¬ IsClosed ({genericPoint X} : Set X) := by
    intro h
    have h1 : closure ({genericPoint X} : Set X) = Set.univ :=
      isGenericPoint_def.mp (genericPoint_spec X)
    rw [h.closure_eq] at h1
    haveI : Subsingleton X := ⟨fun x y => by
      have hx : x ∈ ({genericPoint X} : Set X) := h1 ▸ Set.mem_univ x
      have hy : y ∈ ({genericPoint X} : Set X) := h1 ▸ Set.mem_univ y
      rw [Set.mem_singleton_iff] at hx hy
      rw [hx, hy]⟩
    haveI : DiscreteTopology X := Subsingleton.discreteTopology
    have h2 := topologicalKrullDim_zero_of_discreteTopology X
    rw [hdim] at h2
    have h3 : (1 : ℕ) ≤ 0 := by exact_mod_cast h2
    omega
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let α := FractionRing.algEquiv Γ(X, U) X.functionField
  have hαalg : ∀ a : Γ(X, U), α (algebraMap Γ(X, U) (FractionRing Γ(X, U)) a) =
      (X.presheaf.germ U (genericPoint X) hηU).hom a := by
    intro a
    rw [AlgEquiv.commutes]
    rfl
  have hspec : ∀ (V : X.Opens) (x : X) (hx : x ∈ V) (s : Γ(X, V)),
      algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ V x hx).hom s) =
        (X.presheaf.germ V (genericPoint X) (hmemη V x hx)).hom s :=
    fun V x hx s => TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hx _ s
  have hφinj : ∀ x : X, Function.Injective (algebraMap (X.presheaf.stalk x) X.functionField) :=
    fun x => IsFractionRing.injective _ _
  have hinjη : ∀ (V : X.Opens) (hV : genericPoint X ∈ V),
      Function.Injective (X.presheaf.germ V (genericPoint X) hV).hom :=
    fun V hV => germ_injective_of_isIntegral X _ hV
  have hres0 : ∀ (V V' : X.Opens) (h : V' ≤ V) (hV' : genericPoint X ∈ V') (s : Γ(X, V)),
      (X.presheaf.germ V' (genericPoint X) hV').hom ((X.presheaf.map (homOfLE h).op).hom s) =
        (X.presheaf.germ V (genericPoint X) (h hV')).hom s :=
    fun V V' h hV' s => TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h) _ hV' s

  have hB : ∀ (x : X) (f : (FractionRing Γ(X, U))ˣ), wcStalkReg X U x f ↔
      ∃ t : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField t =
        α (f : FractionRing Γ(X, U)) := by
    intro x f
    constructor
    · rintro ⟨V, hxV, s, a, b, hb, hfab, hsec⟩
      refine ⟨(X.presheaf.germ V x hxV).hom s, ?_⟩
      rw [hspec]
      have hηVU : genericPoint X ∈ V ⊓ U := ⟨hmemη V x hxV, hηU⟩
      have h1 := congrArg (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom hsec
      rw [map_mul, hres0 V (V ⊓ U) inf_le_left hηVU, hres0 U (V ⊓ U) inf_le_right hηVU,
        hres0 U (V ⊓ U) inf_le_right hηVU] at h1
      have h2 := congrArg α hfab
      rw [map_mul, hαalg, hαalg] at h2
      have hb' : (X.presheaf.germ U (genericPoint X) hηU).hom b ≠ 0 := by
        rw [← hαalg]
        intro h
        exact hb (α.injective (h.trans (map_zero α).symm))
      exact mul_right_cancel₀ hb' (h1.trans h2.symm)
    · rintro ⟨t, ht⟩
      obtain ⟨V, hxV, s, hs⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf t
      have hsη : (X.presheaf.germ V (genericPoint X) (hmemη V x hxV)).hom s =
          α (f : FractionRing Γ(X, U)) := by
        rw [← hspec V x hxV s, hs]
        exact ht
      obtain ⟨a, b, hb, hab⟩ :=
        IsFractionRing.div_surjective (A := Γ(X, U)) (f : FractionRing Γ(X, U))
      have hb0 : algebraMap Γ(X, U) (FractionRing Γ(X, U)) b ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
      have hηVU : genericPoint X ∈ V ⊓ U := ⟨hmemη V x hxV, hηU⟩
      refine ⟨V, hxV, s, a, b, hb0, ?_, ?_⟩
      · rw [← hab, div_mul_cancel₀ _ hb0]
      · apply hinjη (V ⊓ U) hηVU
        rw [map_mul, hres0 V (V ⊓ U) inf_le_left hηVU, hres0 U (V ⊓ U) inf_le_right hηVU,
          hres0 U (V ⊓ U) inf_le_right hηVU, hsη, ← hαalg b, ← hαalg a, ← map_mul, ← hab,
          div_mul_cancel₀ _ hb0]
  have hT : ∀ x : X, x ≠ genericPoint X → ∀ f : (FractionRing Γ(X, U))ˣ,
      0 ≤ ω x (Additive.ofMul f) ↔ ∃ t : X.presheaf.stalk x,
        algebraMap (X.presheaf.stalk x) X.functionField t = α (f : FractionRing Γ(X, U)) :=
    fun x hx f => (htrue x hx f).trans (hB x f)

  have hunit : ∀ (x : X) (r : X.presheaf.stalk x),
      algebraMap (X.presheaf.stalk x) X.functionField r ≠ 0 →
      ((∃ t : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField t =
        (algebraMap (X.presheaf.stalk x) X.functionField r)⁻¹) ↔ IsUnit r) := by
    intro x r hr
    constructor
    · rintro ⟨t, ht⟩
      have h1 : r * t = 1 := by
        apply hφinj x
        rw [map_mul, ht, mul_inv_cancel₀ hr, map_one]
      exact ⟨⟨r, t, h1, by rw [mul_comm]; exact h1⟩, rfl⟩
    · rintro ⟨v, rfl⟩
      refine ⟨(↑v⁻¹ : X.presheaf.stalk x), ?_⟩
      apply eq_inv_of_mul_eq_one_left
      rw [← map_mul, Units.inv_mul, map_one]
  have hev : ∀ (V : X.Opens) (y : X) (hy : y ∈ V) (s : Γ(X, V)),
      (X.evaluation V y hy).hom s = 0 ↔ ¬ IsUnit ((X.presheaf.germ V y hy).hom s) := by
    intro V y hy s
    rw [← X.mem_basicOpen s y hy, ← X.evaluation_ne_zero_iff_mem_basicOpen y hy s, not_not]

  let ι : ∀ W : X.Opens, genericPoint X ∈ W → Γ(X, W) →+* FractionRing Γ(X, U) :=
    fun W hW => α.symm.toAlgHom.toRingHom.comp (X.presheaf.germ W (genericPoint X) hW).hom
  have hια : ∀ (W : X.Opens) (hW : genericPoint X ∈ W) (s : Γ(X, W)),
      α (ι W hW s) = (X.presheaf.germ W (genericPoint X) hW).hom s :=
    fun W hW s => α.apply_symm_apply _
  have hinj : ∀ (W : X.Opens) (hW : genericPoint X ∈ W), Function.Injective (ι W hW) := by
    intro W hW a b h
    apply hinjη W hW
    rw [← hια, ← hια, h]
  have hres : ∀ (W W' : X.Opens) (h : W' ≤ W) (hW' : genericPoint X ∈ W') (s : Γ(X, W)),
      ι W' hW' ((X.presheaf.map (homOfLE h).op).hom s) = ι W (h hW') s := by
    intro W W' h hW' s
    apply α.injective
    rw [hια, hια, hres0 W W' h hW' s]
  have hii : ∀ (W : X.Opens) (hW : genericPoint X ∈ W) (c : Ω),
      ι W hW ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
          wcCurveConst Ω X fX U c := by
    intro W hW c
    apply α.injective
    rw [hια, hres0 ⊤ W le_top hW]
    change _ = α (algebraMap Γ(X, U) (FractionRing Γ(X, U))
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))))
    rw [hαalg, hres0 ⊤ U le_top hηU]
  have hiii : ∀ (W : X.Opens) (hW : genericPoint X ∈ W) (y : X) (hy : y ∈ W),
      IsClosed ({y} : Set X) → ∀ (s : Γ(X, W)) (hs : ι W hW s ≠ 0),
      0 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ∧
      (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ↔ (X.evaluation W y hy).hom s = 0) := by
    intro W hW y hy hyc s hs
    have hyη : y ≠ genericPoint X := fun h => hηnc (h ▸ hyc)
    have hg : α ((Units.mk0 (ι W hW s) hs : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)) =
        algebraMap (X.presheaf.stalk y) X.functionField ((X.presheaf.germ W y hy).hom s) := by
      rw [Units.val_mk0, hια, hspec]
    have hne : algebraMap (X.presheaf.stalk y) X.functionField
        ((X.presheaf.germ W y hy).hom s) ≠ 0 := by
      rw [← hg]
      intro h
      exact hs (α.injective (h.trans (map_zero α).symm))
    have h0 : 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) :=
      (hT y hyη _).mpr ⟨_, hg.symm⟩
    have hinv : ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)⁻¹) =
        - ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) := by
      rw [ofMul_inv, map_neg]
    have key : 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)⁻¹) ↔
        IsUnit ((X.presheaf.germ W y hy).hom s) := by
      rw [hT y hyη, Units.val_inv_eq_inv_val, map_inv₀, hg]
      exact hunit y _ hne
    refine ⟨h0, ?_⟩
    rw [hev]
    constructor
    · intro h1 hu
      have h2 := key.mpr hu
      rw [hinv] at h2
      omega
    · intro hnu
      by_contra h1
      apply hnu
      apply key.mp
      rw [hinv]
      omega
  have hvi : ∀ (W : X.Opens) (hW : genericPoint X ∈ W) (u : FractionRing Γ(X, U)),
      (∀ y : X, y ∈ W → IsClosed ({y} : Set X) →
        u = 0 ∨ ∃ hu : u ≠ 0, 0 ≤ ω y (Additive.ofMul (Units.mk0 u hu))) →
      ∃ s : Γ(X, W), ι W hW s = u := by
    intro W hW u hu
    by_cases hu0 : u = 0
    · exact ⟨0, by rw [hu0, map_zero]⟩
    haveI : Nonempty W := ⟨⟨_, hW⟩⟩
    obtain ⟨s, hs⟩ := wc_integral_hartogs_sections X W (α u) (by
      rintro ⟨x, hxW⟩
      by_cases hx : x = genericPoint X
      · subst hx
        obtain ⟨V, hV, s, hs⟩ :=
          TopCat.Presheaf.exists_germ_eq X.presheaf (x := genericPoint X)
            (α u : X.presheaf.stalk (genericPoint X))
        exact ⟨(X.presheaf.germ V _ hV).hom s, (hspec V _ hV s).trans hs⟩
      · rcases hu x hxW (hcl x hx) with h0 | ⟨hu', hω'⟩
        · exact absurd h0 hu0
        · exact (hT x hx (Units.mk0 u hu')).mp hω')
    refine ⟨s, α.injective ?_⟩
    rw [hια]
    exact hs
  exact ⟨ι, hinj, hres, hii, hiii, hvi⟩

theorem wc_gcf_chl_not_in_chart : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (N : ℕ) (j : X ⟶ wcProjK Ω N), IsClosedImmersion j → j ≫ wcProjKStr Ω N = fX → ∀ a : Fin (N + 1), ∃ y : X, y ∉ j ⁻¹ᵁ wcSgD Ω N a :=
by
  intro Ω _ X fX _ hdim N j hj _ a
  by_contra h
  push_neg at h
  have hV : j ⁻¹ᵁ wcSgD Ω N a = ⊤ := eq_top_iff.mpr fun y _ => h y
  have hD : IsAffineOpen (wcSgD Ω N a) :=
    Proj.isAffineOpen_basicOpen _ _
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a))
      Nat.one_pos
  haveI := hj
  have hpre : IsAffineOpen (j ⁻¹ᵁ wcSgD Ω N a) := hD.preimage j
  rw [hV] at hpre
  haveI : IsAffine (⊤ : X.Opens).toScheme := hpre
  haveI : IsAffine X := IsAffine.of_isIso X.topIso.inv
  haveI : IsAffineHom fX := isAffineHom_of_isAffine fX
  haveI : IsFinite fX := IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩
  have hfin : (fX.app ⊤).hom.Finite := IsFinite.finite_app fX ⊤ (isAffineOpen_top _)
  have hsurj : Function.Surjective (Scheme.ΓSpecIso (.of Ω)).inv.hom := fun y =>
    ⟨(Scheme.ΓSpecIso (.of Ω)).hom.hom y, by simp⟩
  have hφ : ((fX.app ⊤).hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom).Finite :=
    RingHom.Finite.comp hfin (RingHom.Finite.of_surjective _ hsurj)
  letI : Algebra Ω Γ(X, ⊤) := ((fX.app ⊤).hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom).toAlgebra
  haveI : Module.Finite Ω Γ(X, ⊤) := hφ
  haveI : Ring.KrullDimLE 0 Γ(X, ⊤) := (Module.finite_iff_krullDimLE_zero Ω Γ(X, ⊤)).mp inferInstance
  have hR : ringKrullDim Γ(X, ⊤) ≤ ((0 : ℕ) : WithBot ℕ∞) := Ring.krullDimLE_iff.mp inferInstance
  have hT : topologicalKrullDim X = ringKrullDim Γ(X, ⊤) :=
    (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso X.isoSpec).isHomeomorph).trans
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(X, ⊤))
  rw [← hT, hdim] at hR
  exact absurd hR (by norm_num)

theorem wc_gcf_chl_pole_divisor : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X], topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → (∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X)) → ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω → ∀ ι : ∀ W : X.Opens, genericPoint X ∈ W → Γ(X, W) →+* FractionRing Γ(X, U), (∀ (W W' : X.Opens) (h : W' ≤ W) (hW' : genericPoint X ∈ W') (s : Γ(X, W)), ι W' hW' ((X.presheaf.map (homOfLE h).op).hom s) = ι W (h hW') s) → (∀ (W : X.Opens) (hW : genericPoint X ∈ W) (y : X) (hy : y ∈ W), IsClosed ({y} : Set X) → ∀ (s : Γ(X, W)) (hs : ι W hW s ≠ 0), 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ∧ (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ↔ (X.evaluation W y hy).hom s = 0)) → ∀ (N : ℕ) (j : X ⟶ wcProjK Ω N), (∀ J : Fin (N + 1), wcSgE Ω N J J = 1) → (∀ J L : Fin (N + 1), wcSgD Ω N J ⊓ wcSgD Ω N L = (wcProjK Ω N).basicOpen (wcSgE Ω N L J)) → (∀ J L L' : Fin (N + 1), ((wcProjK Ω N).presheaf.map (homOfLE (show wcSgD Ω N J ⊓ wcSgD Ω N L ⊓ wcSgD Ω N L' ≤ wcSgD Ω N L' from inf_le_right)).op).hom (wcSgE Ω N L' J) = ((wcProjK Ω N).presheaf.map (homOfLE (show wcSgD Ω N J ⊓ wcSgD Ω N L ⊓ wcSgD Ω N L' ≤ wcSgD Ω N L from inf_le_left.trans inf_le_right)).op).hom (wcSgE Ω N L J) * ((wcProjK Ω N).presheaf.map (homOfLE (show wcSgD Ω N J ⊓ wcSgD Ω N L ⊓ wcSgD Ω N L' ≤ wcSgD Ω N L' from inf_le_right)).op).hom (wcSgE Ω N L' L)) → (∀ x : X, ∃ b : Fin (N + 1), x ∈ j ⁻¹ᵁ wcSgD Ω N b) → ∀ a : Fin (N + 1), genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N a → ∃ D : X →₀ ℤ, D (genericPoint X) = 0 ∧ (∀ x, 0 ≤ D x) ∧ (∀ y : X, y ∉ j ⁻¹ᵁ wcSgD Ω N a → 1 ≤ D y) ∧ (∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b), ι (j ⁻¹ᵁ wcSgD Ω N b) hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ≠ 0) ∧ ∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b) (ht : ι (j ⁻¹ᵁ wcSgD Ω N b) hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ≠ 0) (x : X), x ∈ j ⁻¹ᵁ wcSgD Ω N b → x ≠ genericPoint X → D x = ω x (Additive.ofMul (Units.mk0 _ ht)) :=
by
  classical
  intro Ω _ X fX _ _ _hdim hclosed U _ hU ω hω ι hres hord N j _hEE hBO hCOC hcov a ha

  have s0 : ∀ (V : X.Opens) (x : X), x ∈ V → genericPoint X ∈ V := fun V x hx =>
    ((genericPoint_spec X).mem_open_set_iff V.isOpen).mpr ⟨x, trivial, hx⟩

  have s1 : ∀ J L : Fin (N + 1), j ⁻¹ᵁ wcSgD Ω N J ⊓ j ⁻¹ᵁ wcSgD Ω N L =
      X.basicOpen ((j.app (wcSgD Ω N L)).hom (wcSgE Ω N L J)) := by
    intro J L
    rw [← Scheme.Hom.preimage_inf, hBO J L, Scheme.preimage_basicOpen]

  have s3 : ∀ (W : X.Opens) (hW : genericPoint X ∈ W) (s : Γ(X, W)),
      genericPoint X ∈ X.basicOpen s →
      ∃ hs : ι W hW s ≠ 0, ∀ y : X, IsClosed ({y} : Set X) → y ∈ X.basicOpen s →
        ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) = 0 := by
    intro W hW s hη
    have hle : X.basicOpen s ≤ W := X.basicOpen_le s
    have hu : IsUnit ((X.presheaf.map (homOfLE hle).op).hom s) :=
      RingedSpace.isUnit_res_basicOpen X.toRingedSpace s
    have hu' : IsUnit (ι (X.basicOpen s) hη ((X.presheaf.map (homOfLE hle).op).hom s)) :=
      hu.map _
    rw [hres] at hu'
    have hs : ι W hW s ≠ 0 := hu'.ne_zero
    refine ⟨hs, fun y hyc hyV => ?_⟩
    have h1 := hord W hW y (hle hyV) hyc s hs
    have h2 : (X.evaluation W y (hle hyV)).hom s ≠ 0 :=
      (Scheme.evaluation_ne_zero_iff_mem_basicOpen X y (hle hyV) s).mpr hyV
    have h3 : ¬ (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs))) := fun h => h2 (h1.2.mp h)
    have h4 := h1.1
    omega

  have nat : ∀ (V V' : (wcProjK Ω N).Opens) (h : V' ≤ V) (s : Γ(wcProjK Ω N, V)),
      (j.app V').hom (((wcProjK Ω N).presheaf.map (homOfLE h).op).hom s) =
      (X.presheaf.map (homOfLE (show j ⁻¹ᵁ V' ≤ j ⁻¹ᵁ V from fun x hx => h hx)).op).hom
        ((j.app V).hom s) := by
    intro V V' h s
    exact congrArg (fun f => f.hom s) (j.naturality (homOfLE h).op)

  have s2 : ∀ (b b' : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b)
      (hb' : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b'),
      ι (j ⁻¹ᵁ wcSgD Ω N b) hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) =
        ι (j ⁻¹ᵁ wcSgD Ω N b') hb' ((j.app (wcSgD Ω N b')).hom (wcSgE Ω N b' a)) *
        ι (j ⁻¹ᵁ wcSgD Ω N b) hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b b')) := by
    intro b b' hb hb'
    have hT' : genericPoint X ∈ j ⁻¹ᵁ (wcSgD Ω N a ⊓ wcSgD Ω N b' ⊓ wcSgD Ω N b) := by
      rw [Scheme.Hom.preimage_inf, Scheme.Hom.preimage_inf]
      exact TopologicalSpace.Opens.mem_inf.mpr
        ⟨TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hb'⟩, hb⟩
    have key : ∀ (c : Fin (N + 1)) (h : wcSgD Ω N a ⊓ wcSgD Ω N b' ⊓ wcSgD Ω N b ≤ wcSgD Ω N c)
        (hc : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N c) (s : Γ(wcProjK Ω N, wcSgD Ω N c)),
        ι (j ⁻¹ᵁ (wcSgD Ω N a ⊓ wcSgD Ω N b' ⊓ wcSgD Ω N b)) hT'
          ((j.app (wcSgD Ω N a ⊓ wcSgD Ω N b' ⊓ wcSgD Ω N b)).hom
            (((wcProjK Ω N).presheaf.map (homOfLE h).op).hom s)) =
        ι (j ⁻¹ᵁ wcSgD Ω N c) hc ((j.app (wcSgD Ω N c)).hom s) := by
      intro c h hc s
      rw [nat]
      exact hres _ _ _ _ _
    have hc3 := congrArg (fun z => ι (j ⁻¹ᵁ (wcSgD Ω N a ⊓ wcSgD Ω N b' ⊓ wcSgD Ω N b)) hT'
      ((j.app (wcSgD Ω N a ⊓ wcSgD Ω N b' ⊓ wcSgD Ω N b)).hom z)) (hCOC a b' b)
    simp only [map_mul] at hc3
    rw [key b _ hb, key b' _ hb', key b _ hb] at hc3
    exact hc3

  have hmemB : ∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b),
      genericPoint X ∈ X.basicOpen ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) := by
    intro b hb
    rw [← s1 a b]
    exact TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hb⟩
  have ht : ∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b),
      ι (j ⁻¹ᵁ wcSgD Ω N b) hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ≠ 0 :=
    fun b hb => (s3 _ hb _ (hmemB b hb)).1

  have hcons : ∀ (b b' : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b)
      (hb' : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b') (x : X),
      x ∈ j ⁻¹ᵁ wcSgD Ω N b → x ∈ j ⁻¹ᵁ wcSgD Ω N b' → x ≠ genericPoint X →
      ω x (Additive.ofMul (Units.mk0 _ (ht b hb))) =
        ω x (Additive.ofMul (Units.mk0 _ (ht b' hb'))) := by
    intro b b' hb hb' x hx hx' hne
    have hmem : genericPoint X ∈ X.basicOpen ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b b')) := by
      rw [← s1 b' b]
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hb', hb⟩
    obtain ⟨hu, hz⟩ := s3 _ hb _ hmem
    have hxm : x ∈ X.basicOpen ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b b')) := by
      rw [← s1 b' b]
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hx', hx⟩
    have h0 := hz x (hclosed x hne) hxm
    have heq : Units.mk0 _ (ht b hb) = Units.mk0 _ (ht b' hb') * Units.mk0 _ hu := by
      apply Units.ext
      rw [Units.val_mul, Units.val_mk0, Units.val_mk0, Units.val_mk0]
      exact s2 b b' hb hb'
    rw [heq, ofMul_mul, map_add, h0, add_zero]

  let φ : Fin (N + 1) → X → ℤ := fun b x =>
    if hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b then
      ω x (Additive.ofMul (Units.mk0 _ (ht b hb))) else 0
  have hφfin : ∀ b, {x : X | φ b x ≠ 0}.Finite := by
    intro b
    by_cases hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b
    · refine (hω.2.2.1 (Additive.ofMul (Units.mk0 _ (ht b hb)))).subset ?_
      intro x hx
      have e : φ b x = ω x (Additive.ofMul (Units.mk0 _ (ht b hb))) := dif_pos hb
      exact fun h => hx (e.trans h)
    · refine Set.finite_empty.subset ?_
      intro x hx
      have e : φ b x = 0 := dif_neg hb
      exact absurd e hx
  let β : X → Fin (N + 1) := fun x => Classical.choose (hcov x)
  have hβ : ∀ x, x ∈ j ⁻¹ᵁ wcSgD Ω N (β x) := fun x => Classical.choose_spec (hcov x)
  let D₀ : X → ℤ := fun x => if x = genericPoint X then 0 else φ (β x) x
  have hfin : (Function.support D₀).Finite := by
    refine (Set.finite_iUnion hφfin).subset ?_
    intro x hx
    rw [Function.mem_support] at hx
    by_cases hne : x = genericPoint X
    · exact absurd (if_pos hne) hx
    · rw [Set.mem_iUnion]
      exact ⟨β x, by
        show φ (β x) x ≠ 0
        have : D₀ x = φ (β x) x := if_neg hne
        rw [← this]; exact hx⟩
  let D : X →₀ ℤ := Finsupp.ofSupportFinite D₀ hfin
  have hDφ : ∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b) (x : X),
      x ∈ j ⁻¹ᵁ wcSgD Ω N b → x ≠ genericPoint X →
      D x = ω x (Additive.ofMul (Units.mk0 _ (ht b hb))) := by
    intro b hb x hx hne
    have e1 : D x = φ (β x) x := if_neg hne
    have e2 : φ (β x) x = ω x (Additive.ofMul (Units.mk0 _ (ht (β x) (s0 _ x (hβ x))))) :=
      dif_pos (s0 _ x (hβ x))
    rw [e1, e2]
    exact hcons (β x) b _ hb x (hβ x) hx hne
  refine ⟨D, if_pos rfl, ?_, ?_, ht, ?_⟩
  · intro x
    by_cases hne : x = genericPoint X
    · have e1 : D x = 0 := if_pos hne
      rw [e1]
    · obtain ⟨b, hx⟩ := hcov x
      have hb := s0 _ x hx
      rw [hDφ b hb x hx hne]
      exact (hord _ hb x hx (hclosed x hne) _ (ht b hb)).1
  · intro y hy
    have hne : y ≠ genericPoint X := fun h => hy (by rw [h]; exact ha)
    obtain ⟨b, hyb⟩ := hcov y
    have hb := s0 _ y hyb
    rw [hDφ b hb y hyb hne]
    apply (hord _ hb y hyb (hclosed y hne) _ (ht b hb)).2.mpr
    by_contra hev
    have h1 := (Scheme.evaluation_ne_zero_iff_mem_basicOpen X y hyb _).mp hev
    rw [← s1 a b] at h1
    exact hy (TopologicalSpace.Opens.mem_inf.mp h1).1
  · intro b hb ht' x hx hne
    exact hDφ b hb x hx hne

theorem wc_gcf_chl_sections_rr : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X], topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → (∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X)) → ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω → ∀ ι : ∀ W : X.Opens, genericPoint X ∈ W → Γ(X, W) →+* FractionRing Γ(X, U), (∀ (W : X.Opens) (hW : genericPoint X ∈ W), Function.Injective (ι W hW)) → (∀ (W W' : X.Opens) (h : W' ≤ W) (hW' : genericPoint X ∈ W') (s : Γ(X, W)), ι W' hW' ((X.presheaf.map (homOfLE h).op).hom s) = ι W (h hW') s) → (∀ (W : X.Opens) (hW : genericPoint X ∈ W) (y : X) (hy : y ∈ W), IsClosed ({y} : Set X) → ∀ (s : Γ(X, W)) (hs : ι W hW s ≠ 0), 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ∧ (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι W hW s) hs)) ↔ (X.evaluation W y hy).hom s = 0)) → (∀ (W : X.Opens) (hW : genericPoint X ∈ W) (u : FractionRing Γ(X, U)), (∀ y : X, y ∈ W → IsClosed ({y} : Set X) → u = 0 ∨ ∃ hu : u ≠ 0, 0 ≤ ω y (Additive.ofMul (Units.mk0 u hu))) → ∃ s : Γ(X, W), ι W hW s = u) → ∀ (N : ℕ) (j : X ⟶ wcProjK Ω N), (∀ J : Fin (N + 1), wcSgE Ω N J J = 1) → (∀ J L L' : Fin (N + 1), ((wcProjK Ω N).presheaf.map (homOfLE (show wcSgD Ω N J ⊓ wcSgD Ω N L ⊓ wcSgD Ω N L' ≤ wcSgD Ω N L' from inf_le_right)).op).hom (wcSgE Ω N L' J) = ((wcProjK Ω N).presheaf.map (homOfLE (show wcSgD Ω N J ⊓ wcSgD Ω N L ⊓ wcSgD Ω N L' ≤ wcSgD Ω N L from inf_le_left.trans inf_le_right)).op).hom (wcSgE Ω N L J) * ((wcProjK Ω N).presheaf.map (homOfLE (show wcSgD Ω N J ⊓ wcSgD Ω N L ⊓ wcSgD Ω N L' ≤ wcSgD Ω N L' from inf_le_right)).op).hom (wcSgE Ω N L' L)) → (∀ x : X, ∃ b : Fin (N + 1), x ∈ j ⁻¹ᵁ wcSgD Ω N b) → ∀ (a : Fin (N + 1)) (ha : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N a) (D : X →₀ ℤ), D (genericPoint X) = 0 → (∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b), ι (j ⁻¹ᵁ wcSgD Ω N b) hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ≠ 0) → (∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b) (ht : ι (j ⁻¹ᵁ wcSgD Ω N b) hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ≠ 0) (x : X), x ∈ j ⁻¹ᵁ wcSgD Ω N b → x ≠ genericPoint X → D x = ω x (Additive.ofMul (Units.mk0 _ ht))) → ∀ e : ℕ, (∀ f ∈ wcGcDfSec j e, ι (j ⁻¹ᵁ wcSgD Ω N a) ha (f a) ∈ wcRRSpace Ω X fX U ω ((e : ℤ) • D)) ∧ (∀ f ∈ wcGcDfSec j e, ι (j ⁻¹ᵁ wcSgD Ω N a) ha (f a) = 0 → ∀ b, f b = 0) ∧ (∀ u ∈ wcRRSpace Ω X fX U ω ((e : ℤ) • D), ∃ f ∈ wcGcDfSec j e, ι (j ⁻¹ᵁ wcSgD Ω N a) ha (f a) = u) :=
by
  intro Ω _ X fX _ _ hdim hclosed U _ hU ω hω ι hinj hres hord hhart N j hEE hcoc hcov a ha D hDη ht hDt e
  classical

  have hRR : ∀ (D' : X →₀ ℤ) (f : FractionRing Γ(X, U)), f ∈ wcRRSpace Ω X fX U ω D' ↔
      (f = 0 ∨ ∃ hf : f ≠ 0, ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + D' x) := by
    intro D' f
    letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
    have hconst : ∀ (c : Ω) (hc : wcCurveConst Ω X fX U c ≠ 0) (x : X),
        ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) = 0 := by
      intro c hc x
      have h1 : ∀ y, 0 ≤ ω y (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) := by
        refine (hω.2.2.2.2.2 _).2 ⟨c, ?_⟩
        rfl
      have h2 : ∀ y, 0 ≤ ω y (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)⁻¹) := by
        refine (hω.2.2.2.2.2 _).2 ⟨c⁻¹, ?_⟩
        rw [Units.val_inv_eq_inv_val]
        change wcCurveConst Ω X fX U c⁻¹ = (wcCurveConst Ω X fX U c)⁻¹
        exact map_inv₀ _ c
      have h3 : ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) +
          ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)⁻¹) = 0 := by
        rw [← map_add, ← ofMul_mul, mul_inv_cancel, ofMul_one, map_zero]
      have e1 := h1 x
      have e2 := h2 x
      omega
    constructor
    · intro hg
      unfold wcRRSpace at hg
      induction hg using Submodule.span_induction with
      | mem a ha => exact Or.inr ha
      | zero => exact Or.inl rfl
      | add a b _ _ ha hb =>
        rcases ha with rfl | ⟨ha0, ba⟩
        · rw [zero_add]; exact hb
        rcases hb with rfl | ⟨hb0, bb⟩
        · rw [add_zero]; exact Or.inr ⟨ha0, ba⟩
        by_cases hab : a + b = 0
        · exact Or.inl hab
        refine Or.inr ⟨hab, fun x => ?_⟩
        have hu := hω.2.2.2.2.1 x (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab)
          (by simp)
        have e1 := ba x
        have e2 := bb x
        rcases min_le_iff.mp hu with h | h <;> linarith
      | smul c a _ ha =>
        rw [show c • a = wcCurveConst Ω X fX U c * a from rfl]
        rcases ha with rfl | ⟨ha0, ba⟩
        · exact Or.inl (mul_zero _)
        by_cases hc : wcCurveConst Ω X fX U c = 0
        · left; rw [hc, zero_mul]
        have hca : wcCurveConst Ω X fX U c * a ≠ 0 := mul_ne_zero hc ha0
        refine Or.inr ⟨hca, fun x => ?_⟩
        have e : Units.mk0 _ hca = Units.mk0 _ hc * Units.mk0 a ha0 := Units.ext (by simp)
        rw [e, ofMul_mul, map_add, hconst c hc x, zero_add]
        exact ba x
    · rintro (rfl | ⟨hf, hb⟩)
      · exact Submodule.zero_mem _
      · unfold wcRRSpace
        exact Submodule.subset_span ⟨hf, hb⟩

  have hgen : ∀ (W : X.Opens) (x : X), x ∈ W → genericPoint X ∈ W := by
    intro W x hx
    exact ((genericPoint_spec X).mem_open_set_iff W.isOpen).mpr ⟨x, Set.mem_univ x, hx⟩
  have hsub : ∀ (W : X.Opens), genericPoint X ∉ W → Subsingleton Γ(X, W) := by
    intro W hW
    have h : W = ⊥ := eq_bot_iff.mpr (fun x hx => absurd (hgen W x hx) hW)
    exact CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty h)

  have hordmul : ∀ (x : X) (s t w : FractionRing Γ(X, U)) (hs : s ≠ 0) (ht : t ≠ 0) (hw : w ≠ 0),
      s = t ^ e * w → ω x (Additive.ofMul (Units.mk0 s hs)) =
        (e : ℤ) * ω x (Additive.ofMul (Units.mk0 t ht)) + ω x (Additive.ofMul (Units.mk0 w hw)) := by
    intro x s t w hs ht hw hst
    have hu : Units.mk0 s hs = (Units.mk0 t ht) ^ e * Units.mk0 w hw := Units.ext (by simp [hst])
    rw [hu, ofMul_mul, ofMul_pow, map_add, map_nsmul, nsmul_eq_mul]

  have hsec1 : ∀ f ∈ wcGcDfSec j e, ∀ (p q : Fin (N + 1))
      (hp : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N p) (hq : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N q),
      ι (j ⁻¹ᵁ wcSgD Ω N q) hq (f q) =
        ι (j ⁻¹ᵁ wcSgD Ω N q) hq ((j.app (wcSgD Ω N q)).hom (wcSgE Ω N q p)) ^ e *
          ι (j ⁻¹ᵁ wcSgD Ω N p) hp (f p) := by
    intro f hf p q hp hq
    simp only [wcGcDfSec, Set.mem_setOf_eq] at hf
    have hV : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N p ⊓ j ⁻¹ᵁ wcSgD Ω N q := ⟨hp, hq⟩
    have h1 := congrArg (ι _ hV) (hf p q)
    unfold wcEszG at h1
    rw [map_mul, map_pow, hres, hres, hres] at h1
    exact h1
  have hsec2 : ∀ f : (∀ b : Fin (N + 1), Γ(X, j ⁻¹ᵁ wcSgD Ω N b)),
      (∀ (p q : Fin (N + 1)) (hp : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N p)
        (hq : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N q),
        ι (j ⁻¹ᵁ wcSgD Ω N q) hq (f q) =
          ι (j ⁻¹ᵁ wcSgD Ω N q) hq ((j.app (wcSgD Ω N q)).hom (wcSgE Ω N q p)) ^ e *
            ι (j ⁻¹ᵁ wcSgD Ω N p) hp (f p)) → f ∈ wcGcDfSec j e := by
    intro f hf
    simp only [wcGcDfSec, Set.mem_setOf_eq]
    intro p q
    by_cases hV : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N p ⊓ j ⁻¹ᵁ wcSgD Ω N q
    · apply hinj _ hV
      unfold wcEszG
      rw [map_mul, map_pow, hres, hres, hres]
      exact hf p q _ _
    · haveI := hsub _ hV
      exact Subsingleton.elim _ _

  have nat : ∀ (V V' : (wcProjK Ω N).Opens) (h : V' ≤ V) (s : Γ(wcProjK Ω N, V)),
      (j.app V').hom (((wcProjK Ω N).presheaf.map (homOfLE h).op).hom s) =
        (X.presheaf.map (homOfLE (show j ⁻¹ᵁ V' ≤ j ⁻¹ᵁ V from fun x hx => h hx)).op).hom
          ((j.app V).hom s) := by
    intro V V' h s
    have := congrArg (fun φ => φ.hom s) (j.naturality (homOfLE h).op)
    exact this

  have hcoc' : ∀ (p q : Fin (N + 1)) (hp : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N p)
      (hq : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N q),
      ι (j ⁻¹ᵁ wcSgD Ω N q) hq ((j.app (wcSgD Ω N q)).hom (wcSgE Ω N q a)) =
        ι (j ⁻¹ᵁ wcSgD Ω N p) hp ((j.app (wcSgD Ω N p)).hom (wcSgE Ω N p a)) *
          ι (j ⁻¹ᵁ wcSgD Ω N q) hq ((j.app (wcSgD Ω N q)).hom (wcSgE Ω N q p)) := by
    intro p q hp hq
    have hT : genericPoint X ∈ j ⁻¹ᵁ (wcSgD Ω N a ⊓ wcSgD Ω N p ⊓ wcSgD Ω N q) := ⟨⟨ha, hp⟩, hq⟩
    have h1 := congrArg (ι _ hT) (congrArg (j.app (wcSgD Ω N a ⊓ wcSgD Ω N p ⊓ wcSgD Ω N q)).hom
      (hcoc a p q))
    rw [map_mul, map_mul, nat, nat, nat, hres, hres, hres] at h1
    exact h1
  have hta : ι (j ⁻¹ᵁ wcSgD Ω N a) ha ((j.app (wcSgD Ω N a)).hom (wcSgE Ω N a a)) = 1 := by
    rw [hEE a, map_one, map_one]
  refine ⟨?_, ?_, ?_⟩
  ·
    intro f hf
    rw [hRR]
    by_cases hu : ι (j ⁻¹ᵁ wcSgD Ω N a) ha (f a) = 0
    · exact Or.inl hu
    refine Or.inr ⟨hu, fun x => ?_⟩
    rw [Finsupp.smul_apply, smul_eq_mul]
    by_cases hx : x = genericPoint X
    · subst hx
      simp [hω.1, hDη]
    · obtain ⟨b, hb⟩ := hcov x
      have hbη : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b := hgen _ x hb
      have hfb := hsec1 f hf a b ha hbη
      have hs : ι _ hbη (f b) ≠ 0 := by
        rw [hfb]; exact mul_ne_zero (pow_ne_zero _ (ht b hbη)) hu
      have h0 := (hord _ hbη x hb (hclosed x hx) (f b) hs).1
      rw [hordmul x _ _ _ hs (ht b hbη) hu hfb, ← hDt b hbη (ht b hbη) x hb hx] at h0
      linarith
  ·
    intro f hf hf0 b
    by_cases hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b
    · apply hinj _ hb
      rw [hsec1 f hf a b ha hb, hf0, mul_zero, map_zero]
    · haveI := hsub _ hb
      exact Subsingleton.elim _ _
  ·
    intro u hu
    rw [hRR] at hu
    have hcl : ∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b), ∀ y : X,
        y ∈ j ⁻¹ᵁ wcSgD Ω N b → IsClosed ({y} : Set X) →
        ι _ hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ^ e * u = 0 ∨
          ∃ h : ι _ hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ^ e * u ≠ 0,
            0 ≤ ω y (Additive.ofMul (Units.mk0 _ h)) := by
      intro b hb y hy _
      rcases hu with rfl | ⟨hu0, hux⟩
      · left; exact mul_zero _
      · have hne : ι _ hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ^ e * u ≠ 0 :=
          mul_ne_zero (pow_ne_zero _ (ht b hb)) hu0
        refine Or.inr ⟨hne, ?_⟩
        by_cases hyη : y = genericPoint X
        · subst hyη
          exact le_of_eq (hω.1 _).symm
        · rw [hordmul y _ _ _ hne (ht b hb) hu0 rfl, ← hDt b hb (ht b hb) y hy hyη]
          have := hux y
          rw [Finsupp.smul_apply, smul_eq_mul] at this
          linarith
    let f : ∀ b : Fin (N + 1), Γ(X, j ⁻¹ᵁ wcSgD Ω N b) := fun b =>
      if hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b then Classical.choose (hhart _ hb _ (hcl b hb))
      else 0
    have hf : ∀ (b : Fin (N + 1)) (hb : genericPoint X ∈ j ⁻¹ᵁ wcSgD Ω N b),
        ι _ hb (f b) = ι _ hb ((j.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) ^ e * u := by
      intro b hb
      simp only [f, dif_pos hb]
      exact Classical.choose_spec (hhart _ hb _ (hcl b hb))
    refine ⟨f, hsec2 f ?_, ?_⟩
    · intro p q hp hq
      rw [hf q hq, hf p hp, hcoc' p q hp hq]
      ring
    · rw [hf a ha, hta, one_pow, one_mul]

theorem wcpa_dj_lr1k_ll_gc_df_hs_dh_linear : ∀ (K : Type u) [Field K] (T : Scheme.{u}) {N : ℕ}
    (φ : T ⟶ wcProjK K N) (e : ℕ),
    (∀ (F F' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) (a : Fin (N + 1)),
      wcEszDh φ e (F + F') a = wcEszDh φ e F a + wcEszDh φ e F' a) ∧
    (∀ (c : K) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) (a : Fin (N + 1)),
      wcEszDh φ e (c • F) a = wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) c * wcEszDh φ e F a) ∧
    (∀ F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e,
      (fun a => wcEszDh φ e F a) ∈ wcGcDfSec φ e) :=
by
  intro K _ T N φ e
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra
  have hXdeg : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
  have hFdeg : ∀ F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e,
      (F : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1) := fun F => by
    simpa only [smul_eq_mul, mul_one] using F.2
  have hsec : ∀ (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) (a : Fin (N + 1)),
      wcEszSec K N e F a =
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a)).hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (hXdeg a) e (F : MvPolynomial (Fin (N + 1)) K) (hFdeg F)) := fun F a => rfl

  have nat : ∀ {U V : (wcProjK K N).Opens} (h : U ≤ V) (z : Γ(wcProjK K N, V)),
      (φ.app U).hom (((wcProjK K N).presheaf.map (homOfLE h).op).hom z) =
        (T.presheaf.map (homOfLE ((TopologicalSpace.Opens.map φ.base).map (homOfLE h)).le).op).hom
          ((φ.app V).hom z) := fun h z =>
    congrArg (fun ψ => ψ.hom z) (Scheme.Hom.naturality φ (homOfLE h).op)

  have hA : ∀ (F F' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) (a : Fin (N + 1)),
      wcEszDh φ e (F + F') a = wcEszDh φ e F a + wcEszDh φ e F' a := by
    intro F F' a
    have hmk : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hXdeg a) e ((F + F' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) :
            MvPolynomial (Fin (N + 1)) K) (hFdeg (F + F')) =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hXdeg a) e (F : MvPolynomial (Fin (N + 1)) K) (hFdeg F) +
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hXdeg a) e (F' : MvPolynomial (Fin (N + 1)) K) (hFdeg F') := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_add, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.add_mk_self]
      rfl
    unfold wcEszDh
    rw [hsec (F + F') a, hsec F a, hsec F' a, hmk, map_add, map_add]

  have hconst : ∀ (a : Fin (N + 1)) (c : K),
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) =
      ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op).hom
        ((wcProjKStr K N).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)) := by
    intro a c
    have f_deg := hXdeg a
    have h1 : (wcSgD K N a).ι =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)
            f_deg one_pos := by
      rw [← Proj.basicOpenIsoSpec_hom _ _ f_deg one_pos,
        ← Proj.basicOpenIsoSpec_inv_ι _ _ f_deg one_pos, Iso.hom_inv_id_assoc]
    have h2 : (wcSgD K N a).ι ≫ wcProjKStr K N =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              (Submonoid.powers (MvPolynomial.X a)))) := by
      rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ f_deg one_pos]
      simp only [wcProjKStr, Category.assoc]
    have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a)).appTop =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a)))).hom ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K N a).topIso.inv :=
      Proj.basicOpenToSpec_app_top _ _
    have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K N).appTop ≫
          (wcSgD K N a).ι.appTop =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K N a).topIso.inv := by
      rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, h4]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have h3 : (wcSgD K N a).ι.appTop ≫ (wcSgD K N a).topIso.hom =
        (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      first
        | (erw [← Functor.map_comp]; rfl)
        | (simp only [← Functor.map_comp]; rfl)
        | exact ((wcProjK K N).presheaf.map_comp _ _).symm
    have H' : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K N).appTop ≫
          (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N a ≤ ⊤)).op =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X a) := by
      rw [← h3, reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
    have e' := congrArg (fun ψ => ψ.hom c) H'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e'
    exact e'.symm

  have hB : ∀ (c : K) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) (a : Fin (N + 1)),
      wcEszDh φ e (c • F) a = wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) c * wcEszDh φ e F a := by
    intro c F a
    have hmk : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hXdeg a) e ((c • F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) :
            MvPolynomial (Fin (N + 1)) K) (hFdeg (c • F)) =
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c) *
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hXdeg a) e (F : MvPolynomial (Fin (N + 1)) K) (hFdeg F) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk]
      have h0 : (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
          Localization.mk (algebraMap K (MvPolynomial (Fin (N + 1)) K) c) 1 := by
        rfl
      rw [h0, Localization.mk_mul, one_mul, Submodule.coe_smul, Algebra.smul_def]
    unfold wcEszDh wcEszScal
    rw [hsec (c • F) a, hsec F a, hmk, map_mul, map_mul, hconst, nat, Scheme.Hom.comp_appTop]
    rfl

  have hC : ∀ F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e,
