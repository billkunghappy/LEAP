  have hPmax : P.IsMaximal := hU.primeIdealOf_isMaximal_of_isClosed ⟨x, hxU⟩ hxcl
  have hunit' : IsUnit ((X.presheaf.stalkSpecializes hξx).hom
      ((X.presheaf.germ U x hxU).hom s₀)) := by rw [hgerm]; exact hunit
  have hloc : ∀ Q : Ideal Γ(X, U), Q.IsPrime → J ≤ Q → Q ≤ P → Q = P := by
    intro Q hQ hJQ hQP
    obtain ⟨h1, h2⟩ := (hJle Q).mp hJQ
    have hsp := (t_special ↥W X uX U hU ⟨Q, hQ⟩).mpr h1
    have := t_local ↥W X uX x ξ hξx huniq U hU hxU s₀ hunit' ⟨Q, hQ⟩ hsp h2 hQP
