    intro 𝔮 h𝔮 hm
    have hmem : ∀ α ∈ IsLocalRing.maximalIdeal W, algebraMap W T α ∈ 𝔮 :=
      fun α hα => hm (Ideal.mem_map_of_mem _ hα)
    constructor
    · intro he𝔮 ha𝔮
      apply he𝔮
      rw [← hq]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ ha𝔮)
    · intro ha𝔮 he𝔮
      have hGn : Polynomial.aeval a G ∉ 𝔮 := by
        intro hG𝔮
        rw [hG, map_multiset_prod, Multiset.map_map, h𝔮.multiset_prod_mem_iff_exists_mem] at hG𝔮
        obtain ⟨p, hp, hp𝔮⟩ := hG𝔮
        obtain ⟨α, hα, rfl⟩ := Multiset.mem_map.mp hp
        simp only [Function.comp, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at hp𝔮
