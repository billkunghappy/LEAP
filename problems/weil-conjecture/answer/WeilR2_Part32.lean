      (Ideal.Quotient.mk I (MvPolynomial.X 0)) ⊗ₜ[R₀] (1 : K) ∈ q.asIdeal →
      (Ideal.Quotient.mk I (MvPolynomial.X 1)) ⊗ₜ[R₀] (1 : K) ∈ q.asIdeal →
      ¬ IsDomain (Localization.AtPrime q.asIdeal) := by
    intro R₀ _ c K _ _ I hI q h0 h1
    classical
    let a : Fin 2 → TensorProduct R₀ (MvPolynomial (Fin 2) R₀ ⧸ I) K :=
