    ∃ (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) ↥W →+* ↑Γ(X, V))
      (𝔭 : Ideal ↑Γ(X, V)), wcG2cChart W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) V hle g 𝔭 :=
by
  classical
  intro Ω _ _ W hW hWt C γ hcov hgal X uX ι _ _ hM y₀ hy₀ hSm




  have etale_fibre : ∀ {P A : Type u} [CommRing P] [CommRing A] (g : P →+* A) (Q : Ideal P),
      Q.IsMaximal → g.Etale →
      (Q.map g).IsRadical ∧ {q : Ideal A | q.IsPrime ∧ Q.map g ≤ q}.Finite ∧
        ∀ q : Ideal A, q.IsPrime → Q.map g ≤ q → q.IsMaximal := by
    intro P A _ _ g Q hQ hg
    letI := g.toAlgebra
    haveI : Algebra.Etale P A := hg
    letI : Field (P ⧸ Q) := Ideal.Quotient.field Q
    haveI : Algebra.Etale (P ⧸ Q) (TensorProduct P (P ⧸ Q) A) :=
      Algebra.Etale.baseChange P A (P ⧸ Q)
    haveI : Module.Finite (P ⧸ Q) (TensorProduct P (P ⧸ Q) A) :=
      Algebra.FormallyUnramified.finite_of_free _ _
    haveI : IsArtinianRing (TensorProduct P (P ⧸ Q) A) := IsArtinianRing.of_finite (P ⧸ Q) _
    haveI : IsReduced (TensorProduct P (P ⧸ Q) A) :=
      Algebra.FormallyUnramified.isReduced_of_field (P ⧸ Q) _
    let e : (A ⧸ Q.map g) ≃+* TensorProduct P (P ⧸ Q) A :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A Q).toRingEquiv.trans
        (Algebra.TensorProduct.comm P A (P ⧸ Q)).toRingEquiv
    haveI : IsArtinianRing (A ⧸ Q.map g) := e.symm.isArtinianRing
    haveI : IsReduced (A ⧸ Q.map g) := isReduced_of_injective e e.injective
    have hker : RingHom.ker (Ideal.Quotient.mk (Q.map g)) = Q.map g := Ideal.mk_ker
    have hcm : ∀ q : Ideal A, q.IsPrime → Q.map g ≤ q →
        (Ideal.map (Ideal.Quotient.mk (Q.map g)) q).IsPrime ∧
        Ideal.comap (Ideal.Quotient.mk (Q.map g))
          (Ideal.map (Ideal.Quotient.mk (Q.map g)) q) = q := by
      intro q hq hJq
      refine ⟨Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [hker]; exact hJq), ?_⟩
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, hker]
      exact sup_eq_left.mpr hJq
    refine ⟨(Ideal.isRadical_iff_quotient_reduced _).mpr inferInstance, ?_, ?_⟩
    · refine ((IsArtinianRing.setOf_isPrime_finite (A ⧸ Q.map g)).image
        (Ideal.comap (Ideal.Quotient.mk (Q.map g)))).subset ?_
      rintro q ⟨hq, hJq⟩
      obtain ⟨h1, h2⟩ := hcm q hq hJq
