  have hΦmem : ∀ (e : ℕ) (f : ∀ A : Fin (M + 1), Γ(X, ψ ⁻¹ᵁ wcSgD K M A)), f ∈ wcGcDfSec ψ e →
      (fun l : Fin (N + 1) => X.presheaf.map (homOfLE (hψ l)).op (f (J0 l))) ∈
