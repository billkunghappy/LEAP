theorem wcpa_dj_lr1k_ebc_otc_chart_off_support : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X) (t : ↥T), h t ∉ (I.support : Set ↥X) → ∃ (U : X.affineOpens) (a : Γ(X, U.1)), a ∈ I.ideal U ∧ wcCsdChartAt I h U a t :=
by
  intro X T I h t hsupp
  obtain ⟨U₀', hU₀', hxU₀, -⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X))
      (show h t ∈ (⊤ : X.Opens) from trivial)
  set U₀ : X.affineOpens := ⟨U₀', hU₀'⟩ with hU₀def
  have hxU₀' : h t ∈ (U₀ : X.Opens) := hxU₀
  have hnz : h t ∉ X.zeroLocus (↑(I.ideal U₀) : Set Γ(X, U₀.1)) := by
    intro hz
    exact hsupp ((Scheme.IdealSheafData.mem_support_iff_of_mem hxU₀').mpr hz)
  rw [Scheme.mem_zeroLocus_iff] at hnz
  push_neg at hnz
  obtain ⟨f, hfI, hfx⟩ := hnz
  have hmapI := I.map_ideal_basicOpen U₀ f
  set U : X.affineOpens := X.affineBasicOpen f with hUdef
  set a : Γ(X, U.1) := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f with hadef
  have ha : a ∈ I.ideal U := by
    rw [← hmapI]
    exact Ideal.mem_map_of_mem _ hfI
  have hunit : IsUnit a := RingedSpace.isUnit_res_basicOpen X.toRingedSpace f
  have htU : t ∈ h ⁻¹ᵁ U.1 := by
    rw [Scheme.Hom.mem_preimage]
    exact hfx
  obtain ⟨V', hV', htV, hVle⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens T)) htU
  refine ⟨U, a, ha, ⟨V', hV'⟩, hVle, htV, ?_, ?_⟩
  · exact (hunit.map (h.appLE U.1 V' hVle).hom).mem_nonZeroDivisors
  · rw [Ideal.eq_top_of_isUnit_mem _ ha hunit, Ideal.map_top]
    exact (Ideal.span_singleton_eq_top.mpr (hunit.map _)).symm

theorem wcpa_dj_lr1k_ebc_otc_invpull_precomp : ∀ (X T T' : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X) (k : T' ⟶ T) (s : Γ(X, ⊤)), wcCsdInvPull I h → (∀ U : X.affineOpens, (X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op).hom s ∈ I.ideal U) → (∀ V : T'.affineOpens, ((k ≫ h).appLE ⊤ V.1 (by simp)).hom s ∈ nonZeroDivisors Γ(T', V.1)) → wcCsdInvPull I (k ≫ h) :=
by
  intro X T T' I h k s hI hs hnzd t'
  obtain ⟨U, V, eV, a, htV, haI, hga, hspan⟩ := hI (k t')
  obtain ⟨V', hV', ht'V', hsub⟩ :=
    exists_isAffineOpen_mem_and_subset (U := k ⁻¹ᵁ V.1) (x := t')
      ((Scheme.Hom.mem_preimage k).mpr htV)
  have hV'k : V' ≤ k ⁻¹ᵁ V.1 := hsub
  have e' : V' ≤ (k ≫ h) ⁻¹ᵁ U.1 := fun x hx => eV (hV'k hx)
  have key : h.appLE U.1 V.1 eV ≫ k.appLE V.1 V' hV'k = (k ≫ h).appLE U.1 V' e' := by
    rw [Scheme.Hom.appLE_comp_appLE]
  have hcomp : ((k ≫ h).appLE U.1 V' e').hom =
      (k.appLE V.1 V' hV'k).hom.comp (h.appLE U.1 V.1 eV).hom := by
    rw [← key, CommRingCat.hom_comp]
  have hgen : Ideal.map ((k ≫ h).appLE U.1 V' e').hom (I.ideal U) =
      Ideal.span {((k ≫ h).appLE U.1 V' e').hom a} := by
    rw [hcomp, ← Ideal.map_map, hspan, Ideal.map_span, Set.image_singleton, RingHom.comp_apply]
  have hres : ((k ≫ h).appLE U.1 V' e').hom
      ((X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op).hom s)
      = ((k ≫ h).appLE ⊤ V' (by simp)).hom s := by
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
  have hmem : ((k ≫ h).appLE U.1 V' e').hom
      ((X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op).hom s)
      ∈ Ideal.span {((k ≫ h).appLE U.1 V' e').hom a} := by
    rw [← hgen]
    exact Ideal.mem_map_of_mem _ (hs U)
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
  have hN := hnzd ⟨V', hV'⟩
  have hN' : c * ((k ≫ h).appLE U.1 V' e').hom a ∈ nonZeroDivisors Γ(T', V') := by
    rw [hc, hres]
    exact hN
  exact ⟨U, ⟨V', hV'⟩, e', a, ht'V', haI, (mul_mem_nonZeroDivisors.mp hN').2, hgen⟩

theorem wcpa_dj_lr1k_ebc_otc_gen_rigid : ∀ (X Y Y' : Scheme.{u}) (I : X.IdealSheafData) (r : Y ⟶ X) (q : Y' ⟶ Y) (s : Γ(X, ⊤)) (p : ↥Y'), wcCsdInvPull I r → (∀ U : X.affineOpens, (X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op).hom s ∈ I.ideal U) → (∃ U' : X.affineOpens, wcCsdChartAt I (q ≫ r) U' ((X.presheaf.map (homOfLE (le_top : U'.1 ≤ ⊤)).op).hom s) p) → ∃ U : X.affineOpens, wcCsdChartAt I r U ((X.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op).hom s) (q p) :=
by
  have hmap : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (χ : B ⟶ C) (J : Ideal A) (y : B),
      Ideal.map φ.hom J = Ideal.span {y} →
      Ideal.map (φ ≫ χ).hom J = Ideal.span {χ.hom y} := by
    intro A B C φ χ J y hy
    rw [CommRingCat.hom_comp, ← Ideal.map_map, hy, Ideal.map_span, Set.image_singleton]

  have rigid : ∀ (X T T' : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X) (g : T' ⟶ T)
      (U : X.affineOpens) (a b : Γ(X, U.1)) (t' : T'), a ∈ I.ideal U →
      wcCsdChartAt I h U b (g t') → wcCsdChartAt I (g ≫ h) U a t' →
      wcCsdChartAt I h U a (g t') := by
    intro X T T' I h g U a b t' ha H1 H2
    obtain ⟨V, e, hgV, hε, hρ⟩ := H1
    obtain ⟨V', e', ht', hA', hρ'⟩ := H2
    have hmem : (h.appLE U.1 V.1 e).hom a ∈ Ideal.span {(h.appLE U.1 V.1 e).hom b} := by
      rw [← hρ]; exact Ideal.mem_map_of_mem _ ha
    obtain ⟨c0, hc0⟩ := Ideal.mem_span_singleton'.mp hmem
    have htO : t' ∈ V'.1 ⊓ g ⁻¹ᵁ V.1 := ⟨ht', (g.mem_preimage).mpr hgV⟩
    obtain ⟨f, hfO, hft⟩ := V'.2.exists_basicOpen_le (V := V'.1 ⊓ g ⁻¹ᵁ V.1) ⟨t', htO⟩ ht'
    have iD : T'.basicOpen f ≤ V'.1 := T'.basicOpen_le f
    have eg : T'.basicOpen f ≤ g ⁻¹ᵁ V.1 := hfO.trans inf_le_right
    have F1 : (g ≫ h).appLE U.1 V'.1 e' ≫ T'.presheaf.map (homOfLE iD).op =
