    ⟨MvPolynomial.eval₂Hom (fR.comp Polynomial.C)
      ![fR (Polynomial.C β) * T, fR (Polynomial.C d) * Ti], by simp, by simp, fun c => by simp⟩
  have hg₀ : ∀ a ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b},
      g₀ a = 0 := by
    intro a ha
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
