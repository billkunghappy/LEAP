  letI : Algebra (Polynomial ↥W) B := ιA.toAlgebra
  haveI : Algebra.FiniteType (Polynomial ↥W) B := hft
  have hqf : Algebra.QuasiFiniteAt (Polynomial ↥W)
      (⟨P, inferInstance⟩ : PrimeSpectrum B).asIdeal := by
    apply Algebra.QuasiFiniteAt.of_isOpen_singleton_fiber
    convert (PrimeSpectrum.isOpen_basicOpen (a := g)).preimage continuous_subtype_val using 1
    ext ⟨x, hx⟩
    rw [Set.mem_singleton_iff, Set.mem_preimage, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
