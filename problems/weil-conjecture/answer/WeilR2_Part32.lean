      have := congrArg (fun f => f x) hab
      exact this
    have h2 : C.fromSpecStalk (genericPoint C) ≫ a.1.hom =
        C.fromSpecStalk (genericPoint C) ≫ b.1.hom := by rw [hιa, hιa, h1]
    have h3 : a.1.hom = b.1.hom :=
      ext_of_isDominant_of_isSeparated γ (by rw [a.2, b.2]) _ h2
    exact Subtype.ext (Iso.ext h3)
  haveI hGfin : Finite {a : C ≅ C // a.hom ≫ γ = γ} := Finite.of_injective σ hσinj

  obtain ⟨V₀, hV₀, hηV₀, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens (wcProjK Ω 1)))
    (show genericPoint (wcProjK Ω 1) ∈ (⊤ : (wcProjK Ω 1).Opens) from trivial)
