          rcases ValuationRing.dvd_total a x with h | h
          · exact ⟨x, List.mem_cons_of_mem a hx, fun d hd => by
              rcases List.mem_cons.mp hd with rfl | hd
              · exact h
              · exact hxd d hd⟩
          · exact ⟨a, List.mem_cons_self, fun d hd => by
              rcases List.mem_cons.mp hd with rfl | hd
              · exact dvd_rfl
              · exact (hxd d hd).trans h⟩
    have key : ∀ n : ℕ, ∀ D : List ↥W, D.length = n → ∀ k : ℕ, 1 ≤ k → ∀ N : ↥W, N ≠ 0 →
        ∃ lam : ↥W, lam ≠ 0 ∧ Associated (lam ^ k * (D.map (M lam)).prod) N := by
      intro n
      induction n with
      | zero =>
        intro D hD k hk N hN
        rw [List.length_eq_zero_iff] at hD
        subst hD
        obtain ⟨lam, hlam⟩ := hroot k hk N
        refine ⟨lam, ?_, ?_⟩
        · rintro rfl
          rw [zero_pow (by omega)] at hlam
          exact hN hlam.symm
        · rw [List.map_nil, List.prod_nil, mul_one, hlam]
      | succ n ih =>
        intro D hD k hk N hN
        have hDne : D ≠ [] := by rintro rfl; simp at hD
        obtain ⟨x, hx, hxd⟩ := hmaxdiv D hDne
        have hperm : D.Perm (x :: D.erase x) := List.perm_cons_erase hx
        have hlen : (D.erase x).length = n := by
          rw [List.length_erase_of_mem hx, hD]; rfl
        have hDprod : D.prod = x * (D.erase x).prod := by
          rw [hperm.prod_eq, List.prod_cons]
        have hDMprod : ∀ lam, (D.map (M lam)).prod =
            M lam x * ((D.erase x).map (M lam)).prod := by
          intro lam
          rw [(hperm.map (M lam)).prod_eq, List.map_cons, List.prod_cons]
        by_cases hT : x ^ k * D.prod ∣ N
        · obtain ⟨c, hc⟩ := hT
          obtain ⟨lam, hlam⟩ := hroot k hk (x ^ k * c)
          have hN'' : x ^ k * c ≠ 0 := by
            rintro h0
            apply hN
            rw [hc, mul_comm (x ^ k) D.prod, mul_assoc, h0, mul_zero]
          have hlam0 : lam ≠ 0 := by
            rintro rfl
            rw [zero_pow (by omega)] at hlam
            exact hN'' hlam.symm
          have hxlam : x ∣ lam := by
            rcases ValuationRing.dvd_total x lam with h | h
            · exact h
            · obtain ⟨e, he⟩ := h
              have h1 : lam ^ k * 1 = lam ^ k * (e ^ k * c) := by
                rw [mul_one]
                calc lam ^ k = x ^ k * c := hlam
                  _ = _ := by rw [he]; ring
              have h2 := mul_left_cancel₀ (pow_ne_zero k hlam0) h1
              have heu : IsUnit e := by
                have h3 : IsUnit (e ^ k) := IsUnit.of_mul_eq_one c h2.symm
                exact (isUnit_pow_iff (by omega)).mp h3
              obtain ⟨ei, hei⟩ := heu.exists_right_inv
              exact ⟨ei, by rw [he, mul_assoc, hei, mul_one]⟩
          refine ⟨lam, hlam0, ?_⟩
          have hA : Associated (D.map (M lam)).prod D.prod :=
            hprodassoc D (M lam) (fun d hd => hMassoc lam d ((hxd d hd).trans hxlam))
          have hA2 := hA.mul_left (lam ^ k)
          refine hA2.trans ?_
          rw [hlam, hc]
          apply Associated.of_eq
          ring
        · obtain ⟨lam, hlam0, hA⟩ := ih (D.erase x) hlen (k + 1) (by omega) N hN
          have hlx : lam ∣ x := by
            by_contra hnd
            have hxl : x ∣ lam := (ValuationRing.dvd_total lam x).resolve_left hnd
            apply hT
            have hA' : Associated ((D.erase x).map (M lam)).prod (D.erase x).prod :=
              hprodassoc _ (M lam) (fun d hd =>
                hMassoc lam d ((hxd d (List.mem_of_mem_erase hd)).trans hxl))
            have h1 : x ^ k * D.prod ∣ lam ^ (k + 1) * (D.erase x).prod := by
              rw [hDprod, ← mul_assoc, ← pow_succ]
              exact mul_dvd_mul_right (pow_dvd_pow_of_dvd hxl _) _
            exact h1.trans ((hA'.symm.mul_left (lam ^ (k + 1))).trans hA).dvd
          refine ⟨lam, hlam0, ?_⟩
          rw [hDMprod, hM1 lam x hlx]
          refine Associated.trans (Associated.of_eq ?_) hA
          ring
    obtain ⟨N, rfl⟩ := hγμ
    have hN : N ≠ 0 := by rintro rfl; exact hμ (mul_zero γ)
    obtain ⟨lam, hlam0, hA⟩ := key _ (δ.erase 0) rfl 1 le_rfl N hN
    obtain ⟨v, hv⟩ := hA
    refine ⟨lam, ↑v⁻¹, M lam, hlam0, Units.isUnit _, hM1 lam, hM2 lam, ?_⟩
    have hperm : δ.Perm (0 :: δ.erase 0) := List.perm_cons_erase h0
    rw [(hperm.map (M lam)).prod_eq, List.map_cons, List.prod_cons, hM1 lam 0 (dvd_zero lam)]
    rw [pow_one] at hv
    rw [← hv]
    simp only [mul_assoc, Units.mul_inv, mul_one]



  have unit_shift : ∀ (l : List ↥W), ∃ c : ↥W, IsUnit c ∧ ∀ a ∈ l, IsUnit (c + a) := by
    intro l
    set q : Polynomial Ω := (l.map (fun a : ↥W => Polynomial.X + Polynomial.C (a : Ω))).prod
      with hq
    have hq0 : q ≠ 0 := by
      apply List.prod_ne_zero
      intro h0
      obtain ⟨a, -, ha⟩ := List.mem_map.mp h0
      exact Polynomial.X_add_C_ne_zero (a : Ω) ha
    set p : Polynomial Ω := q * Polynomial.X - 1 with hp
    have hdeg : p.natDegree = q.natDegree + 1 := by
      rw [hp, Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_mul_X hq0]
      rw [Polynomial.natDegree_mul_X hq0, Polynomial.natDegree_one]
      omega
    have hdeg' : p.degree ≠ 0 :=
      (Polynomial.natDegree_pos_iff_degree_pos.mp (by omega)).ne'
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p hdeg'
    have hc' : (l.map (fun a : ↥W => c + (a : Ω))).prod * c = 1 := by
      have h := hc
      rw [Polynomial.IsRoot.def, hp, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_X,
        Polynomial.eval_one, hq, Polynomial.eval_list_prod, List.map_map, sub_eq_zero] at h
      rw [← h]
      congr 2
      apply List.map_congr_left
      intro a _
      simp
    have hcW : c ∈ W := by
      by_contra hcn
      have hv : 1 < W.valuation c := by
        rw [← not_le, ValuationSubring.valuation_le_one_iff]; exact hcn
      have hva : ∀ a : ↥W, W.valuation (c + (a : Ω)) = W.valuation c := by
        intro a
        apply Valuation.map_add_eq_of_lt_left
        exact lt_of_le_of_lt ((ValuationSubring.valuation_le_one_iff W _).mpr a.2) hv
      have h1 := congrArg W.valuation hc'
      rw [map_mul, map_list_prod, List.map_map, map_one] at h1
      have h2 : 1 ≤ (l.map (W.valuation ∘ fun a : ↥W => c + (a : Ω))).prod := by
        apply List.one_le_prod_of_one_le
        intro x hx
        obtain ⟨a, -, rfl⟩ := List.mem_map.mp hx
        simp only [Function.comp_apply, hva a]
        exact hv.le
      have h3 : W.valuation c ≤ (l.map (W.valuation ∘ fun a : ↥W => c + (a : Ω))).prod *
          W.valuation c := le_mul_of_one_le_left' h2
      rw [h1] at h3
      exact absurd (lt_of_lt_of_le hv h3) (lt_irrefl _)
    have hW : (l.map (fun a : ↥W => (⟨c, hcW⟩ : ↥W) + a)).prod * ⟨c, hcW⟩ = 1 := by
      apply Subtype.ext
      rw [MulMemClass.coe_mul, SubmonoidClass.coe_list_prod, List.map_map, OneMemClass.coe_one,
        ← hc']
      rfl
    have hWu := IsUnit.mul_iff.mp (hW ▸ isUnit_one)
    refine ⟨⟨c, hcW⟩, hWu.2, ?_⟩
    intro a ha
    exact List.prod_isUnit_iff.mp hWu.1 _ (List.mem_map.mpr ⟨a, ha, rfl⟩)



  have mobius : ∀ (G : Polynomial Q) (y : FractionRing Q), IsUnit (G.coeff 0) →
      Polynomial.aeval y G = 0 → ∃ q : Q, algebraMap Q (FractionRing Q) q * y = 1 := by
    intro G y hG hy
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [Polynomial.aeval_def, Polynomial.eval₂_at_zero] at hy
      exact hG.ne_zero (hιi (hy.trans (map_zero _).symm))
    letI : Invertible y := invertibleOfNonzero hy0
    have h1 : Polynomial.eval₂ (algebraMap Q (FractionRing Q)) (⅟y) G.reverse *
        y ^ G.natDegree = 0 := by
      rw [Polynomial.eval₂_reverse_mul_pow, ← Polynomial.aeval_def, hy]
    have h2 : Polynomial.eval₂ (algebraMap Q (FractionRing Q)) (⅟y) G.reverse = 0 :=
      (mul_eq_zero.mp h1).resolve_right (pow_ne_zero _ hy0)
    have htr : G.trailingCoeff = G.coeff 0 := by
      rw [Polynomial.trailingCoeff, Polynomial.natTrailingDegree_eq_zero.mpr (Or.inr hG.ne_zero)]
    obtain ⟨g, hg⟩ := hG
    have hmon : (Polynomial.C (↑g⁻¹ : Q) * G.reverse).Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
        Polynomial.reverse_leadingCoeff, htr, ← hg, Units.inv_mul]
    have hint : _root_.IsIntegral Q (⅟y) := by
      refine ⟨_, hmon, ?_⟩
      rw [Polynomial.eval₂_mul, h2, mul_zero]
    obtain ⟨q, hq⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    exact ⟨q, by rw [hq, invOf_mul_self]⟩



  have integral : ∀ (B : ValuationSubring (FractionRing Q)),
      (∀ q : Q, algebraMap Q (FractionRing Q) q ∈ B) →
      (∀ q ∈ IsLocalRing.maximalIdeal Q, B.valuation (algebraMap Q (FractionRing Q) q) < 1) →
      ∀ (x₀ s : Q) (lam : ↥W) (δ : List ↥W) (m : ↥W → ↥W), lam ≠ 0 →
      s ∈ IsLocalRing.maximalIdeal Q → (∀ d, lam ∣ d → m d = lam) →
      (∀ d, ¬ lam ∣ d → m d = d) → (δ.map (fun d => x₀ + σ d)).prod = σ (δ.map m).prod * s →
      B.valuation (algebraMap Q (FractionRing Q) x₀) <
        B.valuation (algebraMap Q (FractionRing Q) (σ lam)) →
      ∃ z ∈ IsLocalRing.maximalIdeal Q, x₀ = σ lam * z := by
    intro B hBQ hBm x₀ s lam δ m hlam hs hm1 hm2 hrel hv
    have hunit1 : ∀ x : Q, IsUnit x → B.valuation (algebraMap Q (FractionRing Q) x) = 1 := by
      intro x hx
      obtain ⟨y, hy⟩ := hx.exists_right_inv
      have hB : IsUnit (⟨algebraMap Q (FractionRing Q) x, hBQ x⟩ : B) :=
        IsUnit.of_mul_eq_one ⟨algebraMap Q (FractionRing Q) y, hBQ y⟩
          (Subtype.ext (by
            show algebraMap Q (FractionRing Q) x * algebraMap Q (FractionRing Q) y = 1
            rw [← map_mul, hy, map_one]))
      exact (ValuationSubring.valuation_eq_one_iff B _).mp hB
    have hadd1 : ∀ x : Q, x ∈ IsLocalRing.maximalIdeal Q → IsUnit (x + 1) := by
      intro x hx
      by_contra h
      have h2 := Ideal.sub_mem _ ((hmQ _).mpr h) hx
      rw [add_sub_cancel_left] at h2
      exact (hmQ 1).mp h2 isUnit_one
    have hl0 : algebraMap Q (FractionRing Q) (σ lam) ≠ 0 := hι0 _ (hσ0 _ hlam)
    set z : FractionRing Q :=
      algebraMap Q (FractionRing Q) x₀ / algebraMap Q (FractionRing Q) (σ lam) with hzdef
    have hz : algebraMap Q (FractionRing Q) (σ lam) * z = algebraMap Q (FractionRing Q) x₀ := by
      rw [hzdef, mul_div_cancel₀ _ hl0]
    have hwz : B.valuation z < 1 := by
      rw [hzdef, map_div₀]
      exact (div_lt_one₀ (lt_of_le_of_lt zero_le' hv)).mpr hv
    have hfac : ∀ d : ↥W, ∃ (L : Polynomial Q) (a : ↥W),
        algebraMap Q (FractionRing Q) (x₀ + σ d) =
          algebraMap Q (FractionRing Q) (σ (m d)) * Polynomial.aeval z L ∧
        ∀ c : ↥W, IsUnit (c + a) → IsUnit (Polynomial.eval (σ c) L) := by
      intro d
      by_cases hd : lam ∣ d
      · obtain ⟨a, ha⟩ := hd
        refine ⟨Polynomial.X + Polynomial.C (σ a), a, ?_, ?_⟩
        · rw [hm1 d ⟨a, ha⟩]
          simp only [map_add, Polynomial.aeval_X, Polynomial.aeval_C]
          rw [mul_add, hz, ha, map_mul, map_mul]
        · intro c hc
          simp only [Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C]
          rw [← map_add]
          exact hc.map σ
      · obtain ⟨b, hb⟩ := (ValuationRing.dvd_total lam d).resolve_left hd
        have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [hmW]
          intro hbu
          apply hd
          obtain ⟨bi, hbi⟩ := hbu.exists_right_inv
          exact ⟨bi, by rw [hb, mul_assoc, hbi, mul_one]⟩
        refine ⟨Polynomial.C (σ b) * Polynomial.X + 1, 0, ?_, ?_⟩
        · rw [hm2 d hd]
          simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, map_one]
          rw [mul_add, mul_one, ← mul_assoc, ← map_mul, ← map_mul, ← hb, hz]
        · intro c _
          simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X,
            Polynomial.eval_C, Polynomial.eval_one]
          exact hadd1 _ (Ideal.mul_mem_right _ _ (hσm b hbm))
    choose L a hL hLu using hfac
    obtain ⟨c, hcu, hca⟩ := unit_shift (δ.map a)
    have hm0 : ∀ d, m d ≠ 0 := by
      intro d
      by_cases hd : lam ∣ d
      · rw [hm1 d hd]; exact hlam
      · rw [hm2 d hd]; rintro rfl; exact hd (dvd_zero _)
    have hpm0 : algebraMap Q (FractionRing Q) (σ (δ.map m).prod) ≠ 0 := by
      apply hι0; apply hσ0
      apply List.prod_ne_zero
      intro h0
      obtain ⟨d, -, hd⟩ := List.mem_map.mp h0
      exact hm0 d hd
    have hP1 : algebraMap Q (FractionRing Q) ((δ.map (fun d => x₀ + σ d)).prod) =
        algebraMap Q (FractionRing Q) (σ (δ.map m).prod) *
          Polynomial.aeval z (δ.map L).prod := by
      rw [map_list_prod, map_list_prod σ, map_list_prod (algebraMap Q (FractionRing Q)),
        map_list_prod (Polynomial.aeval z), List.map_map, List.map_map, List.map_map,
        List.map_map, ← List.prod_map_mul]
      congr 1
      apply List.map_congr_left
      intro d _
      exact hL d
    set G₀ : Polynomial Q := (δ.map L).prod - Polynomial.C s with hG₀
    have hG₀z : Polynomial.aeval z G₀ = 0 := by
      have h := hP1
      rw [hrel, map_mul] at h
      have h2 := mul_left_cancel₀ hpm0 h
      rw [hG₀, map_sub, Polynomial.aeval_C, ← h2, sub_self]
    have hG₀t : IsUnit (Polynomial.eval (σ c) G₀) := by
      rw [hG₀, Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_list_prod]
      have hpu : IsUnit ((δ.map L).map (Polynomial.eval (σ c))).prod := by
        apply List.prod_isUnit_iff.mpr
        intro x hx
        rw [List.map_map] at hx
        obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hx
        exact hLu d c (hca _ (List.mem_map.mpr ⟨d, hd, rfl⟩))
      by_contra h
      have h2 := Ideal.add_mem _ ((hmQ _).mpr h) hs
      rw [sub_add_cancel] at h2
      exact (hmQ _).mp h2 hpu
    set G : Polynomial Q := Polynomial.taylor (σ c) G₀ with hG
    have hG0 : IsUnit (G.coeff 0) := by rw [hG, Polynomial.taylor_coeff_zero]; exact hG₀t
    have hGz : Polynomial.aeval (z - algebraMap Q (FractionRing Q) (σ c)) G = 0 := by
      rw [hG, Polynomial.taylor_apply, Polynomial.aeval_comp]
      simp only [map_add, Polynomial.aeval_X, Polynomial.aeval_C, sub_add_cancel]
      exact hG₀z
    obtain ⟨q, hq⟩ := mobius G _ hG0 hGz
    have ht1 : B.valuation (algebraMap Q (FractionRing Q) (σ c)) = 1 := hunit1 _ (hcu.map σ)
    have hzt : B.valuation (z - algebraMap Q (FractionRing Q) (σ c)) = 1 := by
      rw [Valuation.map_sub_eq_of_lt_right _ (by rw [ht1]; exact hwz), ht1]
    have hq1 : B.valuation (algebraMap Q (FractionRing Q) q) = 1 := by
      have h := congrArg B.valuation hq
      rw [map_mul, hzt, mul_one, map_one] at h
      exact h
    have hqu : IsUnit q := by
      by_contra h
      have := hBm q ((hmQ q).mpr h)
      rw [hq1] at this
      exact lt_irrefl _ this
    obtain ⟨qi, hqi⟩ := hqu.exists_right_inv
    have hzQ : algebraMap Q (FractionRing Q) (σ c + qi) = z := by
      have hq0 : algebraMap Q (FractionRing Q) q ≠ 0 := hι0 _ hqu.ne_zero
      have h1 : algebraMap Q (FractionRing Q) q * algebraMap Q (FractionRing Q) qi = 1 := by
        rw [← map_mul, hqi, map_one]
      have h2 := mul_left_cancel₀ hq0 (hq.trans h1.symm)
      rw [map_add, ← h2, add_sub_cancel]
    refine ⟨σ c + qi, ?_, ?_⟩
    · by_contra h
      have h1 := hunit1 _ (not_not.mp (fun h' => h ((hmQ _).mpr h')))
      rw [hzQ] at h1
      rw [h1] at hwz
      exact lt_irrefl _ hwz
    · apply hιi
      rw [map_mul, hzQ, hz]



  by_cases hγμ : γ ∣ μ
  swap
  ·
    obtain ⟨e, he⟩ := (ValuationRing.dvd_total γ μ).resolve_left hγμ
    have hem : e ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [hmW]
      intro heu
      apply hγμ
      rw [he]
      exact heu.mul_right_dvd.mpr dvd_rfl
    by_cases hl0 : l = []
    · subst hl0
      refine ⟨r, 0, 1, Polynomial.C e, hr, zero_mem _, one_ne_zero, ?_, ?_, ?_⟩
      · rw [Polynomial.coeff_C_zero]; exact hem
      · rw [map_zero, map_one, zero_add, one_mul]
      · rw [he, Polynomial.C_mul]; simp
