  have hsupp := (wcpa_dj_nc_centre_props Ω W hW X₁ (r₁ ≫ uX) σ₁ c hLFP₁ inferInstance hσ₁u
    hc0 hcm).2.1
  have hdisj : ((σ₁.ker ⊔ wcNcPrincipal (.of ↥W) X₁ (r₁ ≫ uX) c).support : Set X₁) ∩
