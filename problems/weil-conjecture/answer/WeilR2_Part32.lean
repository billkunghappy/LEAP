theorem wcpa_dj_lr1k_ebcnt_local_extension : ∀ (κ : Type u) [Field κ] (X Y : Scheme.{u}) (sX : X ⟶ Spec (.of κ)) (sY : Y ⟶ Spec (.of κ)) [IsProper sY] [IsLocallyNoetherian X], (∀ x : X, IsDomain (X.presheaf.stalk x)) → (∀ D ∈ irreducibleComponents ↥X, IsOpen D) → ∀ (W : X.Opens), Dense (W : Set ↥X) → ∀ (g : W.toScheme ⟶ Y), g ≫ sY = W.ι ≫ sX → ∀ p : ↥X, (∀ a b : ↥(X.presheaf.stalk p), a ∣ b ∨ b ∣ a) → ∃ (V : X.Opens), p ∈ V ∧ ∃ h : V.toScheme ⟶ Y, h ≫ sY = V.ι ≫ sX ∧ X.homOfLE (inf_le_left : V ⊓ W ≤ V) ≫ h = X.homOfLE (inf_le_right : V ⊓ W ≤ W) ≫ g :=
by
  intro κ _ X Y sX sY _ _ hdom hcomp W hWd g hg p hdiv
  have s3a : ∀ (X Y S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [IsLocallyNoetherian X] (sX : X ⟶ S) (sY : Y ⟶ S) [IsProper sY] (W : X.Opens) (hW : genericPoint ↥X ∈ W) (g : W.toScheme ⟶ Y) (hg : g ≫ sY = W.ι ≫ sX) (p : X) (hdiv : ∀ a b : ↥(X.presheaf.stalk p), a ∣ b ∨ b ∣ a), ∃ (V : X.Opens) (_ : p ∈ V) (hV : genericPoint ↥X ∈ V) (h : V.toScheme ⟶ Y), h ≫ sY = V.ι ≫ sX ∧ V.fromSpecStalkOfMem (genericPoint ↥X) hV ≫ h = W.fromSpecStalkOfMem (genericPoint ↥X) hW ≫ g := by
    intro X Y S _ _ sX sY _ W hW g hg p hdiv
    have hηp : genericPoint X ⤳ p := (genericPoint_spec X).specializes (Set.mem_univ p)
    haveI : ValuationRing (X.presheaf.stalk p) := ValuationRing.iff_dvd_total.mpr ⟨hdiv⟩
    have hVC : ValuativeCriterion sY := by
      have h : (ValuativeCriterion ⊓ @QuasiCompact ⊓ @QuasiSeparated ⊓ @LocallyOfFiniteType) sY := by
        rw [← IsProper.eq_valuativeCriterion]; infer_instance
      exact h.1.1.1
    have hsp : Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk p) X.functionField)) ≫ X.fromSpecStalk p = X.fromSpecStalk (genericPoint X) :=
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk hηp
    have hsq : (W.fromSpecStalkOfMem (genericPoint X) hW ≫ g) ≫ sY = Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk p) X.functionField)) ≫ (X.fromSpecStalk p ≫ sX) := by
      rw [Category.assoc, hg, ← Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι, ← Category.assoc, hsp]
    let Sq : ValuativeCommSq sY := ⟨X.presheaf.stalk p, X.functionField, _, _, ⟨hsq⟩⟩
    obtain ⟨hu⟩ := hVC Sq
    let L := hu.default
    have hl1 : Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk p) X.functionField)) ≫ L.l = W.fromSpecStalkOfMem (genericPoint X) hW ≫ g := L.fac_left
    have hl2 : L.l ≫ sY = X.fromSpecStalk p ≫ sX := L.fac_right
    obtain ⟨V, hpV, h, hlV, hhs⟩ := spread_out_of_isGermInjective' sX sY L.l hl2
    have hηV : genericPoint X ∈ V := hηp.mem_open V.isOpen hpV
    refine ⟨V, hpV, hηV, h, hhs, ?_⟩
    have hfs : V.fromSpecStalkOfMem (genericPoint X) hηV = Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk p) X.functionField)) ≫ V.fromSpecStalkOfMem p hpV := by
      rw [← cancel_mono V.ι, Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι, Scheme.Opens.fromSpecStalkOfMem_ι, hsp]
    rw [hfs, Category.assoc, ← hlV, hl1]
  have s3b : ∀ (X Y S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [IsLocallyNoetherian X] (sX : X ⟶ S) (sY : Y ⟶ S) [IsSeparated sY] (V W : X.Opens) (h : V.toScheme ⟶ Y) (g : W.toScheme ⟶ Y) (hh : h ≫ sY = V.ι ≫ sX) (hg : g ≫ sY = W.ι ≫ sX) (hV : genericPoint ↥X ∈ V) (hW : genericPoint ↥X ∈ W) (heq : V.fromSpecStalkOfMem (genericPoint ↥X) hV ≫ h = W.fromSpecStalkOfMem (genericPoint ↥X) hW ≫ g), X.homOfLE (inf_le_left : V ⊓ W ≤ V) ≫ h = X.homOfLE (inf_le_right : V ⊓ W ≤ W) ≫ g := by
    intro X Y S _ _ sX sY _ V W h g hh hg hV hW heq
    have dV : Dense (V : Set X) := V.isOpen.dense ⟨_, hV⟩
    have dW : Dense (W : Set X) := W.isOpen.dense ⟨_, hW⟩
    let f₁ : X.PartialMap Y := ⟨V, dV, h⟩
    let f₂ : X.PartialMap Y := ⟨W, dW, g⟩
    obtain ⟨U, dU, hUV, hUW, hUeq⟩ := Scheme.PartialMap.equiv_of_fromSpecStalkOfMem_eq f₁ f₂ hV hW heq
    have hUeq' : X.homOfLE hUV ≫ h = X.homOfLE hUW ≫ g := hUeq
    haveI : AlgebraicGeometry.IsReduced (V ⊓ W).toScheme := isReduced_of_isOpenImmersion (V ⊓ W).ι
    have hU' : U ≤ V ⊓ W := le_inf hUV hUW
    haveI : IsDominant U.ι := IsDominant.mk (by
      show Dense (Set.range U.ι)
      rw [Scheme.Opens.range_ι]; exact dU)
    haveI : IsDominant (X.homOfLE hU' ≫ (V ⊓ W).ι) := by rw [Scheme.homOfLE_ι]; infer_instance
    haveI : IsDominant (X.homOfLE hU') := IsDominant.of_comp_of_isOpenImmersion _ (V ⊓ W).ι
    refine ext_of_isDominant_of_isSeparated sY ?_ (X.homOfLE hU') ?_
    · rw [Category.assoc, Category.assoc, hh, hg, Scheme.homOfLE_ι_assoc, Scheme.homOfLE_ι_assoc]
    · rw [Scheme.homOfLE_homOfLE_assoc, Scheme.homOfLE_homOfLE_assoc]; exact hUeq'
  have s_comp : ∀ (X : Scheme.{u}) (hdom : ∀ x : X, IsDomain (X.presheaf.stalk x)) (hcomp : ∀ C ∈ irreducibleComponents ↥X, IsOpen C) (p : X), ∃ D : X.Opens, p ∈ D ∧ AlgebraicGeometry.IsIntegral D.toScheme := by
    intro X hdom hcomp p
    obtain ⟨C, hC, hpC⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible {p} isIrreducible_singleton
