    by_contra hem
    rw [Set.not_nonempty_iff_eq_empty] at hem
    rw [hem, closure_empty] at hC
    have hx' : z' ∈ closure ({z'} : Set V.toScheme) := subset_closure rfl
    rw [← hC] at hx'
    exact hx'
  obtain ⟨z₁, hz₁c, hz₁p⟩ := hne
  have hsp : z' ⤳ z₁ := specializes_iff_mem_closure.mpr hz₁c
  have hne' : z' ≠ z₁ := by
    intro h
    apply hnc'
    rw [h]
    exact hz₁p
  have key01 : ∀ x : WithBot ℕ∞, x < ((1 : ℕ) : WithBot ℕ∞) → x ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro x hx
    induction x using WithBot.recBotCoe with
    | bot => exact bot_le
    | coe n =>
      have h1 : n < 1 := by
        have h2 : ((n : ℕ∞) : WithBot ℕ∞) < ((1 : ℕ∞) : WithBot ℕ∞) := by simpa using hx
        exact WithBot.coe_lt_coe.mp h2
      rw [ENat.lt_one_iff_eq_zero.mp h1]
      simp
  have hd1 := wc_lfi_smooth_stalk_dim K V.toScheme (V.ι ≫ q) 1 z₁ hz₁p
  have hlt := wcpa_dj_rtsx_dim_lt_of_specializes V.toScheme z' z₁ hsp hne'
  rw [hd1] at hlt
  haveI : Ring.KrullDimLE 0 (V.toScheme.presheaf.stalk z') :=
    Ring.krullDimLE_iff.mpr (key01 _ hlt)
  haveI : IsDomain (V.toScheme.presheaf.stalk z') :=
    (wc_fntame_smooth_stalk_normal K V.toScheme (V.ι ≫ q) z').1
  have hF : IsField (V.toScheme.presheaf.stalk z') := Ring.KrullDimLE.isField_of_isReduced
  have e := (V.stalkIso z').symm.commRingCatIsoToRingEquiv
  exact MulEquiv.isField hF e.toMulEquiv

theorem wcpa_dj_lr1k_gs_open_smooth_stalk_data : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (q : Z ⟶ Spec (.of K)) (m : ℕ) (z : Z) (V : Z.Opens), z ∈ V → SmoothOfRelativeDimension m (V.ι ≫ q) → letI := (wcLdpConst K q z).toAlgebra; Algebra.FormallySmooth K (Z.presheaf.stalk z) ∧ Module.Free (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄K] ∧ Module.Finite (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄K] ∧ Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄K] = m :=
by
  intro K _ Z q m z V hz hsm

  have s15 : ∀ (K : Type u) [Field K] {A B : Scheme.{u}} (sA : A ⟶ Spec (.of K))
      (sB : B ⟶ Spec (.of K)) (h : A ⟶ B), h ≫ sB = sA → ∀ a : A,
      (h.stalkMap a).hom.comp (wcLdpConst K sB (h a)) = wcLdpConst K sA a := by
    intro K _ A B sA sB h hh a
    subst hh
    ext c
    have key := congrArg
      (fun ψ => ψ.hom (sB.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)))
      (Scheme.Hom.germ_stalkMap h ⊤ a trivial)
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop]
    exact key

  have transport : ∀ (A B : Type u) [CommRing A] [CommRing B] [Nontrivial A] [Algebra K A]
      [Algebra K B] (e : A ≃ₐ[K] B), Algebra.FormallySmooth K B → Module.Free B Ω[B⁄K] →
      Module.Finite B Ω[B⁄K] → Module.finrank B Ω[B⁄K] = m →
      Algebra.FormallySmooth K A ∧ Module.Free A Ω[A⁄K] ∧ Module.Finite A Ω[A⁄K] ∧
        Module.finrank A Ω[A⁄K] = m := by
    intro A B _ _ _ _ _ e h1 h2 h3 h4
    haveI : Nontrivial B := e.symm.toEquiv.nontrivial
    letI : Algebra B A := (e.symm : B →+* A).toAlgebra
    haveI : IsScalarTower K B A := IsScalarTower.of_algebraMap_eq (fun x => by
      change _ = e.symm (algebraMap K B x)
      exact (e.symm.commutes x).symm)
    let e' : B ≃ₐ[B] A := AlgEquiv.ofRingEquiv (f := e.symm.toRingEquiv) (fun x => rfl)
    haveI : Algebra.FormallyEtale B A := Algebra.FormallyEtale.of_equiv e'
    let τ := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K B A
    refine ⟨Algebra.FormallySmooth.of_equiv e.symm, Module.Free.of_equiv τ,
      Module.Finite.equiv τ, ?_⟩
    rw [← τ.finrank_eq, Module.finrank_baseChange, h4]
  set z' : V := ⟨z, hz⟩ with hz'
  haveI : SmoothOfRelativeDimension m (V.ι ≫ q) := hsm
  haveI := IsOpenImmersion.instIsIsoCommRingCatStalkMap V.ι z'
  obtain ⟨hfs, hfree, hfin, hrk, -⟩ := wc_ldp_il_stalk_of_smooth_field K (V.ι ≫ q) m z'
  letI := (wcLdpConst K q z).toAlgebra
