theorem wcpa_dj_lr1k_ebcc_cu_curve_rank : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (T : Scheme.{u}) (s : T ⟶ Spec (.of κ)) [IsProper s] [IrreducibleSpace ↥T], (∀ z : T, IsDomain (T.presheaf.stalk z) ∧ IsIntegrallyClosed (T.presheaf.stalk z)) → topologicalKrullDim ↥T = ((1 : ℕ) : WithBot ℕ∞) → ∃ g : ℕ, ∀ (N : ℕ) (ψ : T ⟶ wcProjK κ N), IsClosedImmersion ψ → ψ ≫ wcProjKStr κ N = s → ∃ d e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → wcGcDfRk ψ e + (g : ℕ∞) = ((d * e + 1 : ℕ) : ℕ∞) :=
