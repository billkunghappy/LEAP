      intro z hz s
      have h1 := hU.fromSpec_primeIdealOf ⟨z, hz⟩
      have h3 := SetLike.ext_iff.mp (hU.fromSpec_preimage_basicOpen s) (hU.primeIdealOf ⟨z, hz⟩)
      have h4 : hU.fromSpec (hU.primeIdealOf ⟨z, hz⟩) ∈ f.normalization.basicOpen s ↔
