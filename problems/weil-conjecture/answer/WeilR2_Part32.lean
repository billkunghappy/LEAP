    intro x y hx hy
    rw [Valuation.map_mul]
    calc V.valuation x * V.valuation y ≤ 1 * V.valuation y := mul_le_mul' hx le_rfl
      _ = V.valuation y := one_mul _
      _ < 1 := hy
  have hcoef : ∀ w : ↥W, w ∈ IsLocalRing.maximalIdeal ↥W → V.valuation (c (w : Ω)) < 1 := by
    intro w hw
    have h1 : V.valuation (c (w : Ω)) ≤ 1 := hle _ ((hCC _).mpr w.2)
    refine lt_of_le_of_ne h1 ?_
