  have hy'y : y' ⤳ y := hp₁ind.isInducing.specializes_iff.mp (by rw [hy'1]; exact hyh)
  have hImg' : wcpaDjLkImg W (γ ≫ ι') (r ≫ uX) y' = ηL := by rw [hG1, hy'1, hνyh]

  have hmax : ∀ ξ, ξ ⤳ y' → ξ = y' := by
    intro ξ hξ
    have h1 : wcpaDjLkPi W (γ ≫ ι') (r ≫ uX) ξ ⤳ wcpaDjLkPi W (γ ≫ ι') (r ≫ uX) y' :=
