    have haV : a ∈ f ⁻¹ᵁ U := hab.mem_open (f ⁻¹ᵁ U).isOpen hbV
    haveI := hV.isOpenImmersion_fromSpec
    haveI := hU.isOpenImmersion_fromSpec
    have hPa : hV.fromSpec (hV.primeIdealOf ⟨a, haV⟩) = a := hV.fromSpec_primeIdealOf ⟨a, haV⟩
    have hQb : hV.fromSpec (hV.primeIdealOf ⟨b, hbV⟩) = b := hV.fromSpec_primeIdealOf ⟨b, hbV⟩
    have hPQ : hV.primeIdealOf ⟨a, haV⟩ ≤ hV.primeIdealOf ⟨b, hbV⟩ := by
