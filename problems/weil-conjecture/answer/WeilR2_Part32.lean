    refine ⟨f' ≫ inv (ν ∣_ U) ≫ (ν ⁻¹ᵁ U).ι, inferInstance, ha, ?_⟩
    ext z
    constructor
    · rintro ⟨s, rfl⟩
      exact ⟨s, by rw [← Scheme.Hom.comp_apply, ha]⟩
    · rintro ⟨s, hs⟩
      have hzU : z ∈ Set.range (ν ⁻¹ᵁ U).ι := by
        rw [Scheme.Opens.range_ι, SetLike.mem_coe, Scheme.Hom.mem_preimage, ← hs]
        exact hfU ⟨s, rfl⟩
      obtain ⟨w, hw⟩ := hzU
      have hr : (ν ∣_ U) w = f' s := by
        apply U.ι.isOpenEmbedding.isEmbedding.injective
        rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, ← Scheme.Hom.comp_apply, hf',
