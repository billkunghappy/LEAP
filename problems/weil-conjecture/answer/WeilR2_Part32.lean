  haveI hflat : Module.Flat (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) :=
    Algebra.Smooth.flat (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁))
  have htors : ∀ q : ↥Q, (Polynomial.C c : Polynomial ↥W) • q = 0 → q = 0 := by
    intro q hq
    have h1 := congrArg Subtype.val hq
    rw [Algebra.smul_def, Subalgebra.coe_mul, hQev, Polynomial.aeval_C,
      Polynomial.algebraMap_apply] at h1
    have h2 : Polynomial.C (algebraMap ↥W Ω c) * (q : Polynomial Ω) = 0 := h1
    have h3 : (q : Polynomial Ω) = 0 :=
      (mul_eq_zero.mp h2).resolve_left (Polynomial.C_ne_zero.mpr hcΩ)
    exact Subtype.ext h3
  have hclear : ∀ q : ↥Q, ∃ (N : ℕ) (p : Polynomial ↥W),
      (Polynomial.C c : Polynomial ↥W) ^ N • q = algebraMap (Polynomial ↥W) ↥Q p := by
    intro q
    obtain ⟨N, p, hp⟩ := wcpa_dj_lr1k_odfgl_nt_poly_clear Ω W hW c hc0 hcm (q : Polynomial Ω)
    refine ⟨N, p, Subtype.ext ?_⟩
    rw [Algebra.smul_def, Subalgebra.coe_mul, hQev, hQev, ← hp, map_pow, Polynomial.aeval_C,
      Polynomial.algebraMap_apply, hc', Polynomial.C_pow]
  have hθinj0 := wcpa_dj_lr1k_odfgl_nt_flat_tensor_injective (Polynomial ↥W)
      (Localization.Away (⟨g, hgB⟩ : ↥B₁)) ↥Q (Localization.Away g) fD fQ (Polynomial.C c)
      hfDinj htors hclear
  obtain ⟨θ, hθdef⟩ : ∃ θ : TensorProduct (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁))
      ↥Q →ₐ[Polynomial ↥W] Localization.Away g, θ = Algebra.TensorProduct.productMap fD fQ :=
    ⟨_, rfl⟩
  have hθtmul : ∀ (d : Localization.Away (⟨g, hgB⟩ : ↥B₁)) (q : ↥Q),
      θ (TensorProduct.tmul (Polynomial ↥W) d q) = j d * evA (q : Polynomial Ω) := by
    intro d q
    rw [hθdef, Algebra.TensorProduct.productMap_apply_tmul, hfD, hfQ]
  have hθinj : Function.Injective θ := by
    rw [hθdef]
    exact hθinj0

  have hcinv : algebraMap Ω (Localization.Away g) (c : Ω)⁻¹ *
      algebraMap Ω (Localization.Away g) (c : Ω) = 1 := by
    rw [← map_mul, inv_mul_cancel₀ hcΩ, map_one]
  have hC : evA (Polynomial.C (c : Ω)⁻¹) = algebraMap Ω (Localization.Away g) (c : Ω)⁻¹ := by
    have := AlgHom.commutes evA (c : Ω)⁻¹
    rwa [Polynomial.algebraMap_eq] at this
  have hPm : evA (P.map (algebraMap ↥W Ω)) =
      j (algebraMap (Polynomial ↥W) (Localization.Away (⟨g, hgB⟩ : ↥B₁)) P) := by
    rw [← Polynomial.aeval_X_left_eq_map]
