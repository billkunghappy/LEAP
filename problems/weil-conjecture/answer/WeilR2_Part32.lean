          rw [← hc]; ring
        rw [e]
        exact Ideal.sub_mem _ hq (Ideal.mul_mem_right _ _ (by rw [sub_zero]; exact hα))
      have h1 : q = (q - Polynomial.C (q.coeff 0)) + Polynomial.C (q.coeff 0) := by ring
