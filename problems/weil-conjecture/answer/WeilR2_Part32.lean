theorem wcpa_dj_lcc_cm_fio_chain_short : ∀ (T Z : Scheme.{u}) (u : Z ⟶ T), wcpaDjSemistable u →
    ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T)
    (x x' x'' : ↥(Limits.pullback u s)), x ⤳ x' → x' ⤳ x'' → x = x' ∨ x' = x'' :=
by
  intro T Z u hss K _ _ s x x' x'' hxx' hx'x''
  classical

  have s2 : ∀ {W : Type u} [TopologicalSpace W] [T0Space W],
      topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ a b c : W, a ⤳ b → b ⤳ c → a = b ∨ b = c := by
    intro W _ _ hdim a b c hab hbc
    by_contra hne
    push_neg at hne
    obtain ⟨hne1, hne2⟩ := hne
    let Ca : TopologicalSpace.IrreducibleCloseds W :=
      ⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Cb : TopologicalSpace.IrreducibleCloseds W :=
      ⟨closure {b}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Cc : TopologicalSpace.IrreducibleCloseds W :=
      ⟨closure {c}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hlt : ∀ (p q : W) (Cp Cq : TopologicalSpace.IrreducibleCloseds W),
        (Cp : Set W) = closure {p} → (Cq : Set W) = closure {q} → p ⤳ q → p ≠ q → Cq < Cp := by
      intro p q Cp Cq hCp hCq hpq hne
      refine lt_of_le_of_ne ?_ ?_
      · rw [← SetLike.coe_subset_coe, hCp, hCq]
        exact specializes_iff_closure_subset.mp hpq
      · intro h
        have e : closure ({q} : Set W) = closure {p} := by rw [← hCp, ← hCq, h]
        apply hne
        have hqp : q ⤳ p := specializes_iff_mem_closure.mpr (e ▸ subset_closure rfl)
        exact (hpq.antisymm hqp).eq
    have h1 : Cc < Cb := hlt b c Cb Cc rfl rfl hbc hne2
    have h2 : Cb < Ca := hlt a b Ca Cb rfl rfl hab hne1
    let p : LTSeries (TopologicalSpace.IrreducibleCloseds W) :=
      ⟨2, ![Cc, Cb, Ca], fun i => by fin_cases i <;> [exact h1; exact h2]⟩
    have hp := Order.LTSeries.length_le_krullDim p
    unfold topologicalKrullDim at hdim
    have h3 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := hp.trans hdim
    exact absurd h3 (by decide)

  have s3 : ∀ {X : Type u} [TopologicalSpace X] [JacobsonSpace X] (U : Set X), IsOpen U →
      ∀ x y : X, x ∈ U → x ⤳ y → x ≠ y → ∃ z ∈ U, x ⤳ z ∧ x ≠ z := by
    intro X _ _ U hU x y hxU hxy hne
    by_contra hcon
    push_neg at hcon
    have hEq : U ∩ closure {x} = {x} := by
      ext z
      constructor
      · rintro ⟨hzU, hz⟩
        exact (hcon z hzU (specializes_iff_mem_closure.mpr hz)).symm
      · intro hz
        rw [Set.mem_singleton_iff] at hz
        subst hz
        exact ⟨hxU, subset_closure rfl⟩
    have hlc : IsLocallyClosed ({x} : Set X) := by
      rw [← hEq]
      exact hU.isLocallyClosed.inter isClosed_closure.isLocallyClosed
    have hcl := isClosed_singleton_of_isLocallyClosed_singleton hlc
    have hy : y ∈ closure ({x} : Set X) := specializes_iff_mem_closure.mp hxy
    rw [hcl.closure_eq, Set.mem_singleton_iff] at hy
    exact hne hy.symm
