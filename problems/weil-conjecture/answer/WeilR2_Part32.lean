    rwa [hV.fromSpec_primeIdealOf, hV.fromSpec_primeIdealOf] at this
  have t_s3 : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of R)) (V : Y.Opens)
