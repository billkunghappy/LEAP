      letI inst : ∀ V : (X.Opens)ᵒᵖ, Module ↑(X.ringCatSheaf.obj.obj V) ↑(P.obj V) := fun V =>
        (inferInstance : Module Γ(X, V.unop) (S V.unop))
      let Pm : PresheafOfModules X.ringCatSheaf.obj := PresheafOfModules.ofPresheaf P (by
        intro V W f r p
