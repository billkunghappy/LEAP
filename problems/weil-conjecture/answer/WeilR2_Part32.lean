      apply PrimeSpectrum.ext
      have hp' := congrArg PrimeSpectrum.asIdeal hp
      simp only [PrimeSpectrum.sigmaToPi, PrimeSpectrum.comap_asIdeal] at hp'
      change Ideal.comap ((Pi.evalRingHom (fun _ : Fin n => Polynomial k₀) l).comp
