  exact ⟨r * k, ⟨E1.trans (E2.trans (E3.trans E4))⟩⟩

theorem wcpa_dj_lr1k_odfgl_away_basechange : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S]
    [Algebra R S] (A : Type u) [CommRing A] [Algebra R A] (g : A),
    Nonempty (Localization.Away (TensorProduct.tmul R (1 : S) g) ≃ₐ[S]
      TensorProduct R S (Localization.Away g)) :=
by
  intro R _ S _ _ A _ _ g
  set x : TensorProduct R S A := TensorProduct.tmul R (1 : S) g with hx
  let L := Localization.Away x
  let Ag := Localization.Away g
  have : IsScalarTower R S L := IsScalarTower.of_algebraMap_eq (fun r => by
    rw [IsScalarTower.algebraMap_apply R (TensorProduct R S A) L,
      IsScalarTower.algebraMap_apply S (TensorProduct R S A) L,
      ← IsScalarTower.algebraMap_apply R S (TensorProduct R S A)])
  let f₀ : TensorProduct R S A →ₐ[S] TensorProduct R S Ag :=
    Algebra.TensorProduct.map (AlgHom.id S S) (IsScalarTower.toAlgHom R A Ag)
  have hf₀ : IsUnit (f₀ x) := by
    have : f₀ x = Algebra.TensorProduct.includeRight (algebraMap A Ag g) := by
      simp [f₀, x, Algebra.TensorProduct.map_tmul]
    rw [this]
    exact (IsLocalization.Away.algebraMap_isUnit g).map _
  let φ : L →ₐ[S] TensorProduct R S Ag := IsLocalization.Away.liftAlgHom (A := S) x hf₀
  have hφ : ∀ t, φ (algebraMap _ L t) = f₀ t := by
    intro t
    show (IsLocalization.Away.liftAlgHom (A := S) x hf₀).toRingHom (algebraMap _ L t) = _
    rw [IsLocalization.Away.liftAlgHom_toRingHom, IsLocalization.Away.lift_eq]
    rfl
  let h₀ : A →ₐ[R] L :=
    (IsScalarTower.toAlgHom R (TensorProduct R S A) L).comp Algebra.TensorProduct.includeRight
  have hh₀ : IsUnit (h₀ g) := IsLocalization.Away.algebraMap_isUnit x
  let k : Ag →ₐ[R] L := IsLocalization.Away.liftAlgHom (A := R) g hh₀
  have hk : ∀ a, k (algebraMap A Ag a) = algebraMap _ L (TensorProduct.tmul R (1 : S) a) := by
    intro a
    show (IsLocalization.Away.liftAlgHom (A := R) g hh₀).toRingHom (algebraMap A Ag a) = _
    rw [IsLocalization.Away.liftAlgHom_toRingHom, IsLocalization.Away.lift_eq]
    rfl
  let ψ : TensorProduct R S Ag →ₐ[S] L :=
    Algebra.TensorProduct.lift (Algebra.ofId S L) k (fun _ _ => Commute.all _ _)
  have hψ : ∀ s y, ψ (TensorProduct.tmul R s y) = algebraMap S L s * k y := by
    intro s y
    simp [ψ, Algebra.TensorProduct.lift_tmul]
  have h1 : ψ.comp φ = AlgHom.id S L := by
    apply IsLocalization.algHom_ext (Submonoid.powers x)
    apply Algebra.TensorProduct.ext'
    intro s a
    simp only [AlgHom.comp_apply, AlgHom.id_apply]
    show ψ (φ (algebraMap _ L (TensorProduct.tmul R s a))) = algebraMap _ L (TensorProduct.tmul R s a)
    rw [hφ]
    simp only [f₀, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, IsScalarTower.coe_toAlgHom']
    rw [hψ, hk, IsScalarTower.algebraMap_apply S (TensorProduct R S A) L,
