  obtain ⟨α, pt, hα, hpt, hpeq⟩ := hCONT p hp
  obtain ⟨β, qt, hβ, hqt, hqeq⟩ := hCONT q hq
  have hpev : p.eval₂ c g = c α * pt.eval₂ (c.comp W.subtype) g := by
    rw [hpeq, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]
  have hqev : q.eval₂ c g = c β * qt.eval₂ (c.comp W.subtype) g := by
    rw [hqeq, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]
  obtain ⟨hP0, hPinv⟩ := hRT pt hpt
  have hcβ : c β ≠ 0 := (map_ne_zero c).mpr hβ
  rw [hpev, hqev] at hfpq
  have e : c (α * β⁻¹) = f * qt.eval₂ (c.comp W.subtype) g *
      (pt.eval₂ (c.comp W.subtype) g)⁻¹ := by
    rw [map_mul, map_inv₀, eq_mul_inv_iff_mul_eq₀ hP0]
    calc c α * (c β)⁻¹ * pt.eval₂ (c.comp W.subtype) g
        = (c α * pt.eval₂ (c.comp W.subtype) g) * (c β)⁻¹ := by ring
      _ = f * (c β * qt.eval₂ (c.comp W.subtype) g) * (c β)⁻¹ := by rw [hfpq]
      _ = f * qt.eval₂ (c.comp W.subtype) g := by
        rw [mul_comm (c β), ← mul_assoc, mul_assoc _ (c β), mul_inv_cancel₀ hcβ, mul_one]
  have hqtV : qt.eval₂ (c.comp W.subtype) g ∈ V := (V.valuation_le_one_iff _).mp (hev_le qt)
  have hlamV : c (α * β⁻¹) ∈ V := by
    rw [e]
    exact mul_mem (mul_mem hf hqtV) hPinv
  have hlamW : α * β⁻¹ ∈ W := (hCC _).mp hlamV
  set l : ↥W := ⟨α * β⁻¹, hlamW⟩ with hl
  have hcl : c (l : Ω) = c (α * β⁻¹) := rfl
  have star : c (l : Ω) * pt.eval₂ (c.comp W.subtype) g = f * qt.eval₂ (c.comp W.subtype) g := by
    rw [hcl, e, inv_mul_cancel_right₀ hP0]
  obtain ⟨m, P₁, Rp, hsp, hP₁u, hRp⟩ := hSPLIT pt w₀ hpt
  obtain ⟨n, Q₁, Rq, hsq, hQ₁u, hRq⟩ := hSPLIT qt w₀ hqt
  have hX : (Polynomial.X - Polynomial.C w₀).eval₂ (c.comp W.subtype) g = g - c (w₀ : Ω) := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
    rfl
  have Ep : pt.eval₂ (c.comp W.subtype) g = (g - c (w₀ : Ω)) ^ m * P₁.eval₂ (c.comp W.subtype) g
      + Rp.eval₂ (c.comp W.subtype) g := by
    conv_lhs => rw [hsp]
    rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_pow, hX]
  have Eq' : qt.eval₂ (c.comp W.subtype) g = (g - c (w₀ : Ω)) ^ n * Q₁.eval₂ (c.comp W.subtype) g
      + Rq.eval₂ (c.comp W.subtype) g := by
    conv_lhs => rw [hsq]
    rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_pow, hX]
  refine ⟨l, m, n, P₁, Q₁, hP₁u, hQ₁u, ?_⟩
  intro v hv
  have hD : f * (g - c (w₀ : Ω)) ^ n * Q₁.eval₂ (c.comp W.subtype) g
      - c (l : Ω) * (g - c (w₀ : Ω)) ^ m * P₁.eval₂ (c.comp W.subtype) g
      = c (l : Ω) * Rp.eval₂ (c.comp W.subtype) g - f * Rq.eval₂ (c.comp W.subtype) g := by
    linear_combination (-f) * Eq' + c (l : Ω) * Ep - star
  rw [hD]
  intro h1
  have hs : V.valuation (c (l : Ω) * Rp.eval₂ (c.comp W.subtype) g
      - f * Rq.eval₂ (c.comp W.subtype) g) < 1 := by
    apply lt_of_le_of_lt (Valuation.map_sub _ _ _)
    apply max_lt
    · exact hmul _ _ (hle _ ((hCC _).mpr l.2)) (hev_lt Rp hRp)
    · exact hmul _ _ (hle _ hf) (hev_lt Rq hRq)
  have hlt := hmul _ _ (hle v hv) hs
  rw [mul_comm, h1, Valuation.map_one] at hlt
  exact lt_irrefl _ hlt

theorem wcpa_dj_lr1u_fn_tbv_core : ∀ (Ω K A : Type u) [Field Ω] [Field K] [CommRing A] [IsLocalRing A] (W : ValuationSubring Ω) (c : Ω →+* K) (V : ValuationSubring K) (G : A →+* K) (σ : ↥W →+* A) (g : K) (b : A), (∀ ω : Ω, c ω ∈ V ↔ ω ∈ W) → (∀ a : A, G a ∈ V) → (∀ w : ↥W, G (σ w) = c (w : Ω)) → (∀ a : A, ∃ w : ↥W, a - σ w ∈ IsLocalRing.maximalIdeal A) → G b = g → (∀ w₀ : ↥W, g - c (w₀ : Ω) ≠ 0 ∧ (g - c (w₀ : Ω))⁻¹ ∈ V) → (∀ (w₀ : ↥W) (f : K), f ∈ V → ∃ (l : ↥W) (m n : ℕ) (P₁ Q₁ : Polynomial ↥W), IsUnit (P₁.eval w₀) ∧ IsUnit (Q₁.eval w₀) ∧ ∀ v ∈ V, (f * (g - c (w₀ : Ω)) ^ n * Q₁.eval₂ (c.comp W.subtype) g - c (l : Ω) * (g - c (w₀ : Ω)) ^ m * P₁.eval₂ (c.comp W.subtype) g) * v ≠ 1) → ∀ a₁ a₂ : A, ∃ e : A, (∀ v ∈ V, G (a₂ - a₁ * e) * v ≠ 1) ∨ (∀ v ∈ V, G (a₁ - a₂ * e) * v ≠ 1) :=
by
  intro Ω K A _ _ _ _ W c V G σ g b hCC hGV hGσ hRP hGb hY hH a₁ a₂

  have nu_mem : ∀ z : K, (∀ v ∈ V, z * v ≠ 1) → z ∈ V := by
    intro z hz
    rcases V.mem_or_inv_mem z with h | h
    · exact h
    · by_cases hz0 : z = 0
      · rw [hz0]; exact V.zero_mem
      · exact absurd (mul_inv_cancel₀ hz0) (hz _ h)
  have nu_mul : ∀ z t : K, (∀ v ∈ V, z * v ≠ 1) → t ∈ V → ∀ v ∈ V, z * t * v ≠ 1 := by
    intro z t hz ht v hv
    rw [mul_assoc]
    exact hz _ (mul_mem ht hv)
  have nu_iff : ∀ (z : K) (hz : z ∈ V),
      (∀ v ∈ V, z * v ≠ 1) ↔ (⟨z, hz⟩ : V) ∈ IsLocalRing.maximalIdeal V := by
    intro z hz
    constructor
    · intro h
      by_contra hn
      obtain ⟨w, hw⟩ := (IsLocalRing.notMem_maximalIdeal.mp hn).exists_right_inv
      apply h w w.2
      have := congrArg Subtype.val hw
      simpa using this
    · intro h v hv hzv
      apply IsLocalRing.notMem_maximalIdeal.mpr _ h
      exact isUnit_iff_exists_inv.mpr ⟨⟨v, hv⟩, Subtype.ext (by simpa using hzv)⟩
  have nu_add : ∀ z₁ z₂ : K, (∀ v ∈ V, z₁ * v ≠ 1) → (∀ v ∈ V, z₂ * v ≠ 1) →
      ∀ v ∈ V, (z₁ + z₂) * v ≠ 1 := by
    intro z₁ z₂ h1 h2
    have m1 := nu_mem _ h1
    have m2 := nu_mem _ h2
    rw [nu_iff _ (add_mem m1 m2)]
    exact Ideal.add_mem _ ((nu_iff _ m1).mp h1) ((nu_iff _ m2).mp h2)

  have unit_lift : ∀ (w₀ : W) (P : Polynomial W), b - σ w₀ ∈ IsLocalRing.maximalIdeal A →
      IsUnit (P.eval w₀) →
      IsUnit ((P.map σ).eval b) ∧ G ((P.map σ).eval b) = P.eval₂ (c.comp W.subtype) g := by
    intro w₀ P hE hP
    constructor
    · have hd : (P.map σ).eval b - (P.map σ).eval (σ w₀) ∈ IsLocalRing.maximalIdeal A :=
        Ideal.mem_of_dvd _ (Polynomial.sub_dvd_eval_sub b (σ w₀) (P.map σ)) hE
      have he : (P.map σ).eval (σ w₀) = σ (P.eval w₀) := by
        rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
      by_contra hn
      have hm : (P.map σ).eval b ∈ IsLocalRing.maximalIdeal A := by
        by_contra h'
        exact hn (IsLocalRing.notMem_maximalIdeal.mp h')
      have h2 : σ (P.eval w₀) ∈ IsLocalRing.maximalIdeal A := by
        rw [← he]
        have := Ideal.sub_mem _ hm hd
        simpa using this
      exact (IsLocalRing.notMem_maximalIdeal.mpr (hP.map σ)) h2
    · rw [Polynomial.eval_map, Polynomial.hom_eval₂, hGb]
      congr 1
      ext w
      exact hGσ w

  by_cases hA : ∀ v ∈ V, G a₁ * v ≠ 1
  · refine ⟨0, Or.inr ?_⟩
    simpa using hA
  push Not at hA
  obtain ⟨v₁, hv₁, h1⟩ := hA
  have hf : G a₂ * v₁ ∈ V := mul_mem (hGV a₂) hv₁
  have hu : G a₁ ∈ V := hGV a₁
  have huf : G a₂ = G a₁ * (G a₂ * v₁) := by linear_combination (-G a₂) * h1
  obtain ⟨w₀, hE⟩ := hRP b
  have hGE : G (b - σ w₀) = g - c (w₀ : Ω) := by rw [map_sub, hGb, hGσ]
  obtain ⟨hy0, hyinv⟩ := hY w₀
  have hyV : g - c (w₀ : Ω) ∈ V := hGE ▸ hGV _
  obtain ⟨l, m, n, P₁, Q₁, hP₁, hQ₁, hD⟩ := hH w₀ (G a₂ * v₁) hf
  obtain ⟨hP₁u, hGP₁⟩ := unit_lift w₀ P₁ hE hP₁
  obtain ⟨hQ₁u, hGQ₁⟩ := unit_lift w₀ Q₁ hE hQ₁
  obtain ⟨u₁, hu₁⟩ := hP₁u.exists_right_inv
  obtain ⟨u₂, hu₂⟩ := hQ₁u.exists_right_inv
  have hπu : P₁.eval₂ (c.comp W.subtype) g * G u₁ = 1 := by
    rw [← hGP₁, ← map_mul, hu₁, map_one]
  have hκu : Q₁.eval₂ (c.comp W.subtype) g * G u₂ = 1 := by
    rw [← hGQ₁, ← map_mul, hu₂, map_one]
  have hπV : P₁.eval₂ (c.comp W.subtype) g ∈ V := hGP₁ ▸ hGV _
  have hLV : c (l : Ω) ∈ V := (hCC _).mpr l.2
  set u := G a₁ with hu_def
  set f := G a₂ * v₁ with hf_def
  set y := g - c (w₀ : Ω) with hy_def
  set π := P₁.eval₂ (c.comp W.subtype) g with hπ_def
  set κ := Q₁.eval₂ (c.comp W.subtype) g with hκ_def
  set L := c (l : Ω) with hL_def
  have hπ0 : π ≠ 0 := left_ne_zero_of_mul_eq_one hπu
  have hκ0 : κ ≠ 0 := left_ne_zero_of_mul_eq_one hκu
  have hπinv : π⁻¹ = G u₁ := inv_eq_of_mul_eq_one_right hπu
  have hκinv : κ⁻¹ = G u₂ := inv_eq_of_mul_eq_one_right hκu
  have hπinvV : π⁻¹ ∈ V := hπinv ▸ hGV _
  have hκinvV : κ⁻¹ ∈ V := hκinv ▸ hGV _
  have htV : u * y⁻¹ ^ n * κ⁻¹ ∈ V := mul_mem (mul_mem hu (pow_mem hyinv n)) hκinvV
  have hX : κ * κ⁻¹ = 1 := mul_inv_cancel₀ hκ0
  have hPi : π * π⁻¹ = 1 := mul_inv_cancel₀ hπ0
  have hYn : y ^ n * y⁻¹ ^ n = 1 := by rw [← mul_pow, mul_inv_cancel₀ hy0, one_pow]
  have hYm : y ^ m * y⁻¹ ^ m = 1 := by rw [← mul_pow, mul_inv_cancel₀ hy0, one_pow]
  by_cases hnm : n ≤ m
  ·
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnm
    refine ⟨σ l * (b - σ w₀) ^ k * (P₁.map σ).eval b * u₂, Or.inl ?_⟩
    have hGe : G (a₂ - a₁ * (σ l * (b - σ w₀) ^ k * (P₁.map σ).eval b * u₂)) =
        (f * y ^ n * κ - L * y ^ (n + k) * π) * (u * y⁻¹ ^ n * κ⁻¹) := by
      rw [map_sub, map_mul, map_mul, map_mul, map_mul, map_pow, hGσ, hGE, hGP₁, ← hκinv, huf,
        ← hu_def, ← hL_def]
      linear_combination (-(u*f)) * hX + (u*L*y^k*π*κ⁻¹ - u*f*κ*κ⁻¹) * hYn
    rw [hGe]
    exact nu_mul _ _ hD htV
  · by_cases hl : IsUnit l
    ·
      obtain ⟨l', hl'⟩ := hl.exists_right_inv
      have hLl' : L * c (l' : Ω) = 1 := by
        rw [hL_def, ← map_mul]
        have : ((l * l' : W) : Ω) = (l : Ω) * (l' : Ω) := rfl
        rw [← this, hl']
        simp
      have hL0 : L ≠ 0 := left_ne_zero_of_mul_eq_one hLl'
      have hLinv : L⁻¹ = c (l' : Ω) := inv_eq_of_mul_eq_one_right hLl'
      have hLinvV : L⁻¹ ∈ V := hLinv ▸ (hCC _).mpr l'.2
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (le_of_lt (not_le.mp hnm))
      refine ⟨σ l' * (b - σ w₀) ^ k * (Q₁.map σ).eval b * u₁, Or.inr ?_⟩
      have hGe : G (a₁ - a₂ * (σ l' * (b - σ w₀) ^ k * (Q₁.map σ).eval b * u₁)) =
          (f * y ^ (m + k) * κ - L * y ^ m * π) * (-(u * L⁻¹ * y⁻¹ ^ m * π⁻¹)) := by
        rw [map_sub, map_mul, map_mul, map_mul, map_mul, map_pow, hGσ, hGE, hGQ₁, ← hπinv,
          ← hLinv, huf, ← hu_def]
        have hLam : L * L⁻¹ = 1 := mul_inv_cancel₀ hL0
        linear_combination (-u) * hLam + (-(u*L*L⁻¹)) * hPi +
          (u*f*L⁻¹*y^k*κ*π⁻¹ - u*L*L⁻¹*π*π⁻¹) * hYm
      rw [hGe]
      refine nu_mul _ _ hD ?_
      exact neg_mem (mul_mem (mul_mem (mul_mem hu hLinvV) (pow_mem hyinv m)) hπinvV)
    ·
      have hNL : ∀ v ∈ V, L * v ≠ 1 := by
        intro v hv hLv
        apply hl
        have hL0 : L ≠ 0 := left_ne_zero_of_mul_eq_one hLv
        have hl0 : (l : Ω) ≠ 0 := by
          intro h0
          apply hL0
          rw [hL_def, h0, map_zero]
        have hvL : v = c ((l : Ω)⁻¹) := by
          rw [map_inv₀, ← hL_def]
          exact (inv_eq_of_mul_eq_one_right hLv).symm
        have hW : (l : Ω)⁻¹ ∈ W := (hCC _).mp (hvL ▸ hv)
        exact isUnit_iff_exists_inv.mpr ⟨⟨(l : Ω)⁻¹, hW⟩,
          Subtype.ext (by simp [mul_inv_cancel₀ hl0])⟩
      have hN1 : ∀ v ∈ V, L * (y ^ m * π) * v ≠ 1 :=
        nu_mul _ _ hNL (mul_mem (pow_mem hyV m) hπV)
      have hN2 : ∀ v ∈ V, ((f * y ^ n * κ - L * y ^ m * π) + L * (y ^ m * π)) * v ≠ 1 :=
        nu_add _ _ hD hN1
      refine ⟨0, Or.inl ?_⟩
      have hGe : G (a₂ - a₁ * 0) =
          ((f * y ^ n * κ - L * y ^ m * π) + L * (y ^ m * π)) * (u * y⁻¹ ^ n * κ⁻¹) := by
        rw [mul_zero, sub_zero, huf]
        linear_combination (-(u*f)) * hX + (-(u*f*κ*κ⁻¹)) * hYn
      rw [hGe]
      exact nu_mul _ _ hN2 htV

theorem wcpa_dj_lr1u_fn_tb_branch_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjSemistable uX → (∃ (N : ℕ) (j : X ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uX) → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → ∀ x : X, uX x = IsLocalRing.closedPoint ↥W → IsClosed ({x} : Set X) → ∀ (η : X) (hη : ι (genericPoint (wcProjK Ω 1)) ⤳ η) (hηx : η ⤳ x), uX η = IsLocalRing.closedPoint ↥W → ¬ IsClosed ({η} : Set X) → ∀ a b : X.presheaf.stalk x, ∃ c : X.presheaf.stalk x, b - a * c ∈ (IsLocalRing.maximalIdeal (X.presheaf.stalk η)).comap (X.presheaf.stalkSpecializes hηx).hom ∨ a - b * c ∈ (IsLocalRing.maximalIdeal (X.presheaf.stalk η)).comap (X.presheaf.stalkSpecializes hηx).hom :=
