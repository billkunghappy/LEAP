        rw [map_sum]
        refine (Finset.sum_congr rfl fun i _ => ?_).trans (hc l)
        rw [map_mul, hscal]
      have h1 := congrArg (fun x => X.presheaf.map (homOfLE
        (le_inf (inf_le_right.trans (hψ l)) inf_le_left : ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l ≤
          ψ ⁻¹ᵁ wcSgD K M (J0 l) ⊓ ψ ⁻¹ᵁ wcSgD K M A)).op x) (hrel' (J0 l) A)
      simp only [map_mul, map_pow, hres_comp] at h1
      rw [← hres_comp _ _ _ (hψ l) (inf_le_right : ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l ≤ _), h0,
