by
  intro Ω _ W C _ γ X uX ι _ _ y₀ V hV hx 𝔭 h𝔭 hgen _ hκ hint
  classical
  have gen : ∀ {C X : Scheme.{u}} [AlgebraicGeometry.IsIntegral C] (f : C ⟶ X) [QuasiCompact f]
