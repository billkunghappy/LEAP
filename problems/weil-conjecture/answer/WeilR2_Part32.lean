    intro a b hab
    have h1 : (C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
        a.1.hom.stalkMap (genericPoint C)) =
        (C.presheaf.stalkSpecializes (specializes_of_eq (hfix b)) ≫
        b.1.hom.stalkMap (genericPoint C)) := by
