  have c4 : ∀ (W : Type u) [CommRing W] [IsLocalRing W] (T : Type u) [CommRing T] [Algebra W T]
      [Algebra.FiniteType W T],
      (∀ 𝔮 : Ideal T, 𝔮.IsPrime →
        Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W) ≤ 𝔮 → 𝔮.IsMaximal) →
      ∀ (𝔫 : Ideal T) [𝔫.IsPrime],
      Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W) ≤ 𝔫 →
      ∃ f : T, f ∉ 𝔫 ∧ ∀ 𝔮 : Ideal T, 𝔮.IsPrime →
        Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W) ≤ 𝔮 → 𝔮 ≠ 𝔫 → f ∈ 𝔮 := by
    intro W _ _ T _ _ _ hmax 𝔫 h𝔫 _hn
    classical
    haveI hWmax : (IsLocalRing.maximalIdeal W).IsMaximal := IsLocalRing.maximalIdeal.isMaximal W
    letI : Field (W ⧸ IsLocalRing.maximalIdeal W) := Ideal.Quotient.field _
    haveI : IsNoetherianRing (W ⧸ IsLocalRing.maximalIdeal W) := inferInstance
    haveI : Algebra.FiniteType (W ⧸ IsLocalRing.maximalIdeal W)
        (T ⧸ Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W)) :=
      Algebra.FiniteType.of_restrictScalars_finiteType W (W ⧸ IsLocalRing.maximalIdeal W) _
    haveI : IsNoetherianRing (T ⧸ Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W)) :=
      Algebra.FiniteType.isNoetherianRing (W ⧸ IsLocalRing.maximalIdeal W) _
    have hfin : {𝔮 : Ideal T | 𝔮.IsPrime ∧
        Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W) ≤ 𝔮}.Finite := by
      apply ((minimalPrimes.finite_of_isNoetherianRing
        (T ⧸ Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W))).image
          (Ideal.comap (Ideal.Quotient.mk
            (Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W))))).subset
      rintro 𝔮 ⟨h𝔮, hI𝔮⟩
      have hker : RingHom.ker (Ideal.Quotient.mk
          (Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W))) ≤ 𝔮 := by
        rw [Ideal.mk_ker]; exact hI𝔮
      haveI := h𝔮
      haveI hP : (𝔮.map (Ideal.Quotient.mk
          (Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W)))).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
      obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ 𝔮.map (Ideal.Quotient.mk
          (Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W))))
      refine ⟨Q, hQ, ?_⟩
      haveI : Q.IsPrime := hQ.1.1
      have hcQ : (Q.comap (Ideal.Quotient.mk
          (Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W)))).IsMaximal := by
        apply hmax _ (Ideal.comap_isPrime _ _)
        intro x hx
        rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact Q.zero_mem
      have hle : Q.comap (Ideal.Quotient.mk
          (Ideal.map (algebraMap W T) (IsLocalRing.maximalIdeal W))) ≤ 𝔮 := by
        refine (Ideal.comap_mono hQP).trans ?_
        rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, sup_eq_left.mpr hker]
      exact hcQ.eq_of_le h𝔮.ne_top hle
    have hnotle : ¬ (∏ 𝔮 ∈ hfin.toFinset.erase 𝔫, 𝔮) ≤ 𝔫 := by
      rw [h𝔫.prod_le]
      rintro ⟨𝔮, h𝔮S, hle⟩
      obtain ⟨hne, h𝔮⟩ := Finset.mem_erase.mp h𝔮S
      rw [Set.Finite.mem_toFinset] at h𝔮
      exact hne ((hmax 𝔮 h𝔮.1 h𝔮.2).eq_of_le h𝔫.ne_top hle)
    obtain ⟨f, hfJ, hfn⟩ := Set.not_subset.mp hnotle
    refine ⟨f, hfn, fun 𝔮 h𝔮 hI𝔮 hne => ?_⟩
    have h𝔮S : 𝔮 ∈ hfin.toFinset.erase 𝔫 :=
      Finset.mem_erase.mpr ⟨hne, (Set.Finite.mem_toFinset _).mpr ⟨h𝔮, hI𝔮⟩⟩
    exact (Ideal.prod_le_inf.trans (Finset.inf_le h𝔮S)) hfJ
  have c5 : ∀ (W : Type u) [CommRing W] (T : Type u) [CommRing T] [Algebra W T]
      [Algebra.FiniteType W T] (β e γ : T), IsIdempotentElem e → IsIntegral W γ →
      β * γ * e = e → (∀ x : T, ∃ k : ℕ, IsIntegral W (β ^ k * x)) →
      Module.Finite W (Localization.Away e) := by
    intro W _ T _ _ _ β e γ he hγ hβγ hint
    have he1 : algebraMap T (Localization.Away e) e = 1 :=
      (IsIdempotentElem.iff_eq_one_of_isUnit (IsLocalization.Away.algebraMap_isUnit e)).mp
        (he.map _)
    have hinv : algebraMap T (Localization.Away e) β * algebraMap T (Localization.Away e) γ = 1 := by
      have := congrArg (algebraMap T (Localization.Away e)) hβγ
      rw [map_mul, map_mul, he1, mul_one] at this
      exact this
    haveI : Algebra.IsIntegral W (Localization.Away e) := by
      constructor
      intro z
      obtain ⟨n, y, hy⟩ := IsLocalization.Away.surj e z
      rw [he1, one_pow, mul_one] at hy
      obtain ⟨k, hk⟩ := hint y
      have hz : z = algebraMap T (Localization.Away e) γ ^ k *
          algebraMap T (Localization.Away e) (β ^ k * y) := by
        rw [hy, map_mul, map_pow, ← mul_assoc, ← mul_pow,
          mul_comm (algebraMap T (Localization.Away e) γ), hinv, one_pow, one_mul]
      rw [hz]
      exact ((hγ.algebraMap).pow k).mul hk.algebraMap
    haveI : Algebra.FiniteType T (Localization.Away e) :=
      IsLocalization.finiteType_of_monoid_fg (Submonoid.powers e) _
    haveI : Algebra.FiniteType W (Localization.Away e) :=
      Algebra.FiniteType.trans (S := T) inferInstance inferInstance
    exact Algebra.IsIntegral.finite

  have hsurj : Function.Surjective (Ideal.Quotient.mk (Ideal.span {t})) :=
    Ideal.Quotient.mk_surjective
  have hmapT : Ideal.map (algebraMap ↥W (D ⧸ Ideal.span {t})) (IsLocalRing.maximalIdeal ↥W) =
      (Ideal.map (algebraMap ↥W D) (IsLocalRing.maximalIdeal ↥W)).map
        (Ideal.Quotient.mk (Ideal.span {t})) := by
    rw [Ideal.map_map, IsScalarTower.algebraMap_eq ↥W D (D ⧸ Ideal.span {t}),
      Ideal.Quotient.algebraMap_eq]
  have htrans : ∀ 𝔮 : Ideal D, 𝔮.IsPrime → t ∈ 𝔮 →
      (𝔮.map (Ideal.Quotient.mk (Ideal.span {t}))).IsPrime ∧
      (𝔮.map (Ideal.Quotient.mk (Ideal.span {t}))).comap (Ideal.Quotient.mk (Ideal.span {t})) = 𝔮 := by
    intro 𝔮 h𝔮 ht𝔮
    have hker : RingHom.ker (Ideal.Quotient.mk (Ideal.span {t})) ≤ 𝔮 := by
      rw [Ideal.mk_ker, Ideal.span_le, Set.singleton_subset_iff]; exact ht𝔮
    exact ⟨Ideal.map_isPrime_of_surjective hsurj hker,
      by rw [Ideal.comap_map_of_surjective' _ hsurj, sup_eq_left.mpr hker]⟩
  have hItrans : ∀ 𝔮 : Ideal D, Ideal.map (algebraMap ↥W D) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔮 →
      Ideal.map (algebraMap ↥W (D ⧸ Ideal.span {t})) (IsLocalRing.maximalIdeal ↥W) ≤
        𝔮.map (Ideal.Quotient.mk (Ideal.span {t})) := by
    intro 𝔮 h; rw [hmapT]; exact Ideal.map_mono h
  obtain ⟨h𝔫P, h𝔫c⟩ := htrans n' hn'P htn
  haveI := h𝔫P
  have hI𝔫 := hItrans n' hJn
  have hβT : IsUnit (Ideal.Quotient.mk (Ideal.span {t}) β) := hβ.map _
  have hintT : ∀ z : D ⧸ Ideal.span {t}, ∃ k : ℕ,
      IsIntegral ↥W (Ideal.Quotient.mk (Ideal.span {t}) β ^ k * z) := by
    intro z
    obtain ⟨x, rfl⟩ := hsurj z
    obtain ⟨k, hk⟩ := hint x
    exact ⟨k, by rw [← map_pow, ← map_mul]; exact hk⟩

  have hmax := fun 𝔮 h𝔮 hm => c3 ↥W (D ⧸ Ideal.span {t}) _ hβT hintT 𝔮 h𝔮 hm

  obtain ⟨f₀, hf₀n, hf₀q⟩ := c4 ↥W (D ⧸ Ideal.span {t}) hmax _ hI𝔫
  obtain ⟨k, hk⟩ := hintT f₀
  set βT := Ideal.Quotient.mk (Ideal.span {t}) β with hβTdef
  set 𝔫 := n'.map (Ideal.Quotient.mk (Ideal.span {t})) with h𝔫def
  have hunit_notmem : ∀ (𝔮 : Ideal (D ⧸ Ideal.span {t})), 𝔮.IsPrime → ∀ u, IsUnit u → u ∉ 𝔮 :=
    fun 𝔮 h𝔮 u hu hm => h𝔮.ne_top (Ideal.eq_top_of_isUnit_mem _ hm hu)
  have hain : βT * (βT ^ k * f₀) ∉ 𝔫 := by
    intro h
    rcases h𝔫P.mem_or_mem h with h | h
    · exact hunit_notmem 𝔫 h𝔫P _ hβT h
    rcases h𝔫P.mem_or_mem h with h | h
    · exact hunit_notmem 𝔫 h𝔫P _ (hβT.pow k) h
    · exact hf₀n h
  have haq : ∀ 𝔮 : Ideal (D ⧸ Ideal.span {t}), 𝔮.IsPrime →
      Ideal.map (algebraMap ↥W (D ⧸ Ideal.span {t})) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔮 → 𝔮 ≠ 𝔫 →
      βT * (βT ^ k * f₀) ∈ 𝔮 := fun 𝔮 h𝔮 hm hne =>
    Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hf₀q 𝔮 h𝔮 hm hne))
  have haint : IsIntegral ↥W (βT * (βT ^ k * f₀)) := hβint.mul hk

  obtain ⟨F, hFm, hFa⟩ := haint
  obtain ⟨r, hr⟩ := c1 F.natDegree F hFm rfl
  obtain ⟨e, hidem, ⟨q, hq⟩, hsep⟩ := c2 ↥W (D ⧸ Ideal.span {t}) (βT * (βT ^ k * f₀)) r
    (by rw [← hr, Polynomial.aeval_def]; exact hFa)
  have hen : e ∉ 𝔫 := (hsep 𝔫 h𝔫P hI𝔫).mpr hain
  have heq : ∀ 𝔮 : Ideal (D ⧸ Ideal.span {t}), 𝔮.IsPrime →
      Ideal.map (algebraMap ↥W (D ⧸ Ideal.span {t})) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔮 → 𝔮 ≠ 𝔫 →
      e ∈ 𝔮 := fun 𝔮 h𝔮 hm hne => by
    by_contra h
    exact ((hsep 𝔮 h𝔮 hm).mp h) (haq 𝔮 h𝔮 hm hne)

  have hqint : IsIntegral ↥W (Polynomial.aeval (βT * (βT ^ k * f₀)) q) := by
    have h1 := Polynomial.aeval_mem_adjoin_singleton ↥W (x := βT * (βT ^ k * f₀)) (p := q)
    have h2 : Algebra.adjoin ↥W {βT * (βT ^ k * f₀)} ≤ integralClosure ↥W (D ⧸ Ideal.span {t}) :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr (hβint.mul hk))
    exact h2 h1
  have hγ : βT * ((βT ^ k * f₀) * Polynomial.aeval (βT * (βT ^ k * f₀)) q) * e = e := by
    linear_combination hq

  obtain ⟨f, rfl⟩ := hsurj e
  refine ⟨f, ?_, c5 ↥W (D ⧸ Ideal.span {t}) βT _ _ hidem (hk.mul hqint) hγ hintT, ?_⟩
  · intro hf
    exact hen (Ideal.mem_map_of_mem _ hf)
  · intro 𝔮 h𝔮 hm ht𝔮 hf𝔮
    obtain ⟨h𝔮'P, h𝔮'c⟩ := htrans 𝔮 h𝔮 ht𝔮
    have hen' : Ideal.Quotient.mk (Ideal.span {t}) f ∉ 𝔮.map (Ideal.Quotient.mk (Ideal.span {t})) := by
      intro h
      apply hf𝔮
      rw [← h𝔮'c, Ideal.mem_comap]; exact h
    by_contra hne
    apply hen'
    apply heq _ h𝔮'P (hItrans 𝔮 hm)
    intro h
    apply hne
    rw [← h𝔮'c, h, h𝔫c]

theorem wcpa_dj_lr1k_odfgl_cw_fibre_etale : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (D : Type u) [CommRing D] [Algebra R D] (φ : Polynomial R →+* D), φ.Etale → (∀ r : R, φ (Polynomial.C r) = algebraMap R D r) → ∃ ψ : Polynomial (IsLocalRing.ResidueField R) →+* D ⧸ Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R), ψ.Etale ∧ ψ Polynomial.X = Ideal.Quotient.mk (Ideal.map (algebraMap R D) (IsLocalRing.maximalIdeal R)) (φ Polynomial.X) :=
by
  intro R _ _ D _ _ φ hφ hC
  classical
  letI : Algebra (Polynomial R) D := φ.toAlgebra
  haveI : Algebra.Etale (Polynomial R) D := hφ.toAlgebra
  set m := IsLocalRing.maximalIdeal R with hm
  set I : Ideal (Polynomial R) := Ideal.map Polynomial.C m with hI
  have hIJ : Ideal.map (algebraMap (Polynomial R) D) I = Ideal.map (algebraMap R D) m := by
    rw [hI, Ideal.map_map]
    congr 1
    exact RingHom.ext hC
  let e₁ : Polynomial (IsLocalRing.ResidueField R) ≃+* Polynomial R ⧸ I :=
    Ideal.polynomialQuotientEquivQuotientPolynomial m
  let instT : Algebra (Polynomial R ⧸ I) (TensorProduct (Polynomial R) (Polynomial R ⧸ I) D) :=
    inferInstance
  let ψ₁ := @algebraMap (Polynomial R ⧸ I) (TensorProduct (Polynomial R) (Polynomial R ⧸ I) D)
    _ _ instT
  let e₂ := (Algebra.TensorProduct.comm (Polynomial R) (Polynomial R ⧸ I) D)
  let e₃ := (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D I).symm
  let e₄ : D ⧸ Ideal.map (algebraMap (Polynomial R) D) I ≃+* D ⧸ Ideal.map (algebraMap R D) m :=
    Ideal.quotEquivOfEq hIJ
  refine ⟨((e₄.toRingHom.comp (e₃.toRingEquiv.toRingHom.comp
    (e₂.toRingEquiv.toRingHom.comp ψ₁))).comp e₁.toRingHom), ?_, ?_⟩
  · have hE : @Algebra.Etale (Polynomial R ⧸ I)
        (TensorProduct (Polynomial R) (Polynomial R ⧸ I) D) _ _ instT := inferInstance
    have h1 := RingHom.etale_algebraMap.mpr hE
    have hb : ∀ {S T : Type u} [CommRing S] [CommRing T] (e : S ≃+* T), e.toRingHom.Etale :=
      fun e => RingHom.Etale.of_bijective e.bijective
    have hb2 := hb (S := TensorProduct (Polynomial R) (Polynomial R ⧸ I) D)
      (T := TensorProduct (Polynomial R) D (Polynomial R ⧸ I)) e₂.toRingEquiv
    have hb3 := hb (S := TensorProduct (Polynomial R) D (Polynomial R ⧸ I))
      (T := D ⧸ Ideal.map (algebraMap (Polynomial R) D) I) e₃.toRingEquiv
    have h2 := RingHom.Etale.stableUnderComposition _ _ h1 hb2
    have h3 := RingHom.Etale.stableUnderComposition _ _ h2 hb3
    have h4 := RingHom.Etale.stableUnderComposition _ _ h3 (hb e₄)
    exact RingHom.Etale.stableUnderComposition _ _ (hb e₁) h4
  · have hX1 : e₁ Polynomial.X = Ideal.Quotient.mk I Polynomial.X := by
      have := Ideal.polynomialQuotientEquivQuotientPolynomial_map_mk m Polynomial.X
      rw [Polynomial.map_X] at this
      exact this
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      AlgEquiv.coe_ringEquiv]
    rw [hX1]
    have h2 : ψ₁ (Ideal.Quotient.mk I Polynomial.X) =
        TensorProduct.tmul (Polynomial R) (Ideal.Quotient.mk I Polynomial.X) (1 : D) := rfl
    rw [h2]
    simp only [e₂, Algebra.TensorProduct.comm_tmul, e₃]
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
    rw [Algebra.smul_def, mul_one, Ideal.Quotient.mk_eq_mk]
    simp only [e₄, Ideal.quotEquivOfEq_mk]
    rfl

theorem wcpa_dj_lr1k_odfgl_cw_unramified_local : ∀ (k : Type u) [Field k] (E : Type u) [CommRing E] (ψ : Polynomial k →+* E), ψ.Etale → ∀ (𝔭 : Ideal E) [𝔭.IsPrime], ψ Polynomial.X ∈ 𝔭 → IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) = Ideal.span {algebraMap E (Localization.AtPrime 𝔭) (ψ Polynomial.X)} ∧ algebraMap E (Localization.AtPrime 𝔭) (ψ Polynomial.X) ∈ nonZeroDivisors (Localization.AtPrime 𝔭) ∧ IsNoetherianRing (Localization.AtPrime 𝔭) :=
by
  intro k _ E _ ψ hψ 𝔭 _ hX
  letI : Algebra (Polynomial k) E := ψ.toAlgebra
  haveI hEt : Algebra.Etale (Polynomial k) E := hψ
  have hπ : algebraMap (Polynomial k) (Localization.AtPrime 𝔭) Polynomial.X =
      algebraMap E (Localization.AtPrime 𝔭) (ψ Polynomial.X) := by
    rw [IsScalarTower.algebraMap_apply (Polynomial k) E (Localization.AtPrime 𝔭)]
    rfl

  have hp0 : Ideal.comap ψ 𝔭 = Ideal.span {Polynomial.X} := by
    have hmax : (Ideal.span {(Polynomial.X : Polynomial k)}).IsMaximal :=
      PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
    refine (hmax.eq_of_le (Ideal.IsPrime.comap ψ).ne_top ?_).symm
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hX
  refine ⟨?_, ?_, ?_⟩
  ·
    set p0 := Ideal.comap ψ 𝔭 with hp0def
    haveI : p0.IsPrime := Ideal.IsPrime.comap ψ
    let σ : Localization.AtPrime p0 →+* Localization.AtPrime 𝔭 :=
      Localization.localRingHom p0 𝔭 ψ rfl
    letI : Algebra (Localization.AtPrime p0) (Localization.AtPrime 𝔭) := σ.toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime p0) (Localization.AtPrime 𝔭)) :=
      Localization.isLocalHom_localRingHom p0 𝔭 ψ rfl
    have hσ : ∀ r : Polynomial k, σ (algebraMap (Polynomial k) (Localization.AtPrime p0) r) =
        algebraMap E (Localization.AtPrime 𝔭) (ψ r) :=
      fun r => Localization.localRingHom_to_map p0 𝔭 ψ rfl r
    haveI : IsScalarTower (Polynomial k) (Localization.AtPrime p0) (Localization.AtPrime 𝔭) :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [IsScalarTower.algebraMap_apply (Polynomial k) E (Localization.AtPrime 𝔭)]
        exact (hσ r).symm)
    haveI : Algebra.FormallyUnramified E (Localization.AtPrime 𝔭) :=
      Algebra.FormallyUnramified.of_isLocalization 𝔭.primeCompl
    haveI : Algebra.FormallyUnramified (Polynomial k) (Localization.AtPrime 𝔭) :=
      Algebra.FormallyUnramified.comp (Polynomial k) E (Localization.AtPrime 𝔭)
    haveI : Algebra.FormallyUnramified (Localization.AtPrime p0) (Localization.AtPrime 𝔭) :=
      Algebra.FormallyUnramified.localization_base (M := p0.primeCompl)
    haveI : Algebra.EssFiniteType E (Localization.AtPrime 𝔭) :=
      Algebra.EssFiniteType.of_isLocalization (Localization.AtPrime 𝔭) 𝔭.primeCompl
    haveI : Algebra.EssFiniteType (Polynomial k) (Localization.AtPrime 𝔭) :=
      Algebra.EssFiniteType.comp (Polynomial k) E (Localization.AtPrime 𝔭)
    haveI : Algebra.EssFiniteType (Localization.AtPrime p0) (Localization.AtPrime 𝔭) :=
      Algebra.EssFiniteType.of_comp (Polynomial k) (Localization.AtPrime p0)
        (Localization.AtPrime 𝔭)
    have hmain := Algebra.FormallyUnramified.map_maximalIdeal
      (R := Localization.AtPrime p0) (S := Localization.AtPrime 𝔭)
    rw [← hmain, ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
      ← IsScalarTower.algebraMap_eq, hp0, Ideal.map_span, Set.image_singleton, hπ]
  ·
    haveI : Module.Flat E (Localization.AtPrime 𝔭) := IsLocalization.flat _ 𝔭.primeCompl
    haveI : Module.Flat (Polynomial k) (Localization.AtPrime 𝔭) :=
      Module.Flat.trans (Polynomial k) E (Localization.AtPrime 𝔭)
    have hXnz : (Polynomial.X : Polynomial k) ∈ nonZeroDivisors (Polynomial k) :=
      mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero
    have hreg : IsSMulRegular (Localization.AtPrime 𝔭) (Polynomial.X : Polynomial k) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hXnz
    have key : ∀ y : Localization.AtPrime 𝔭,
        y * algebraMap (Polynomial k) (Localization.AtPrime 𝔭) Polynomial.X = 0 → y = 0 := by
      intro y hy
      apply hreg
      show (Polynomial.X : Polynomial k) • y = (Polynomial.X : Polynomial k) • (0 : Localization.AtPrime 𝔭)
      rw [Algebra.smul_def, Algebra.smul_def, mul_zero, mul_comm, hy]
    rw [← hπ, mem_nonZeroDivisors_iff]
    first
      | exact key
      | exact fun y hy => key y (by rw [mul_comm]; exact hy)
      | exact ⟨key, fun y hy => key y (by rw [mul_comm]; exact hy)⟩
      | exact ⟨fun y hy => key y (by rw [mul_comm]; exact hy), key⟩
  ·
    haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing (Polynomial k) E
    exact IsLocalization.isNoetherianRing 𝔭.primeCompl _ inferInstance

theorem wcpa_dj_lr1k_odfgl_cw_dvr_criterion : ∀ (L : Type u) [CommRing L] [IsLocalRing L] [IsNoetherianRing L] (π : L), IsLocalRing.maximalIdeal L = Ideal.span {π} → π ∈ nonZeroDivisors L → ∃ _ : IsDomain L, IsDiscreteValuationRing L :=
by
  intro L _ _ _ π hm hπ
  classical
  have s1 : ∀ x : L, x ≠ 0 → ∃ (n : ℕ) (a : L), IsUnit a ∧ x = a * π ^ n := by
    intro x hx
    have hinf : ⨅ i : ℕ, (IsLocalRing.maximalIdeal L) ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal L).ne_top
    have hex : ∃ N : ℕ, x ∉ Ideal.span {π ^ N} := by
      by_contra h
      push_neg at h
      apply hx
      have hmem : x ∈ ⨅ i : ℕ, (IsLocalRing.maximalIdeal L) ^ i := by
        rw [Submodule.mem_iInf]
        intro i
        rw [hm, Ideal.span_singleton_pow]
        exact h i
      rw [hinf] at hmem
      exact (Submodule.mem_bot L).mp hmem
    have hN : x ∉ Ideal.span {π ^ (Nat.find hex)} := Nat.find_spec hex
    have hN0 : Nat.find hex ≠ 0 := by
      intro h0
      apply hN
      rw [h0, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hN0
    have hxn : x ∈ Ideal.span {π ^ n} := by
      have h' := Nat.find_min hex (show n < Nat.find hex by omega)
      exact not_not.mp h'
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hxn
    refine ⟨n, a, ?_, ha.symm⟩
    by_contra hau
    have ham : a ∈ IsLocalRing.maximalIdeal L := (IsLocalRing.mem_maximalIdeal a).mpr hau
    rw [hm] at ham
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ham
    apply hN
    rw [hn]
    refine Ideal.mem_span_singleton'.mpr ⟨b, ?_⟩
    rw [← ha, ← hb, pow_succ]
    ring
  have s2 : ∀ k : ℕ, π ^ k ≠ 0 := fun k => nonZeroDivisors.ne_zero (pow_mem hπ k)
  haveI hnzd : NoZeroDivisors L := ⟨fun {x y} hxy => by
    by_contra h
    push_neg at h
    obtain ⟨n, a, ha, rfl⟩ := s1 x h.1
    obtain ⟨k, b, hb, rfl⟩ := s1 y h.2
    apply s2 (n + k)
    have e : (a * b) * π ^ (n + k) = 0 := by rw [← hxy, pow_add]; ring
    exact (IsUnit.mul_right_eq_zero (ha.mul hb)).mp e⟩
  let hdom : IsDomain L := NoZeroDivisors.to_isDomain L
  haveI := hdom
  have hnf : ¬ IsField L := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, hm]
    intro h
    apply s2 1
    rw [pow_one]
    have hp : π ∈ Ideal.span {π} := Ideal.subset_span rfl
    rw [h] at hp
    exact (Submodule.mem_bot L).mp hp
  have hprin : Submodule.IsPrincipal (IsLocalRing.maximalIdeal L) := ⟨⟨π, hm⟩⟩
  refine ⟨hdom, ?_⟩
  exact ((IsDiscreteValuationRing.TFAE L hnf).out 1 5).mpr hprin

theorem wcpa_dj_lr1k_odfgl_cw_residue_loc : ∀ (W : Type u) [CommRing W] [IsLocalRing W] (R : Type u) [CommRing R] [Algebra W R] (𝔭 : Ideal R) [𝔭.IsPrime], (∀ w ∈ IsLocalRing.maximalIdeal W, algebraMap W R w ∈ 𝔭) → (∀ d : R, ∃ w : W, d - algebraMap W R w ∈ 𝔭) → ∀ y : Localization.AtPrime 𝔭, ∃ w : W, y - algebraMap W (Localization.AtPrime 𝔭) w ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
by
  intro W _ _ R _ _ 𝔭 _ H1 H2 y
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl y
  dsimp only
  obtain ⟨wa, hwa⟩ := H2 a
  obtain ⟨ws, hws⟩ := H2 (s : R)
  have hs : (s : R) ∉ 𝔭 := s.2
  have hunit : IsUnit ws := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hm
    apply hs
    have := 𝔭.add_mem hws (H1 ws hm)
    simpa using this
  obtain ⟨v, hv⟩ := hunit.exists_left_inv
  refine ⟨wa * v, ?_⟩
  have hmem : a - algebraMap W R (wa * v) * (s : R) ∈ 𝔭 := by
    have e : a - algebraMap W R (wa * v) * (s : R)
        = (a - algebraMap W R wa) - algebraMap W R (wa * v) * ((s : R) - algebraMap W R ws) := by
      have : algebraMap W R (wa * v) * algebraMap W R ws = algebraMap W R wa := by
        rw [← map_mul, mul_assoc, hv, mul_one]
      linear_combination (-1 : R) * this
    rw [e]
    exact 𝔭.sub_mem hwa (𝔭.mul_mem_left _ hws)
  have heq : IsLocalization.mk' (Localization.AtPrime 𝔭) a s
      - algebraMap W (Localization.AtPrime 𝔭) (wa * v)
      = IsLocalization.mk' (Localization.AtPrime 𝔭) (a - algebraMap W R (wa * v) * (s : R)) s := by
    rw [IsScalarTower.algebraMap_apply W R (Localization.AtPrime 𝔭),
      IsLocalization.eq_mk'_iff_mul_eq, sub_mul, IsLocalization.mk'_spec]
    simp only [map_sub, map_mul]
  rw [heq]
  exact (IsLocalization.AtPrime.mk'_mem_maximal_iff (S := Localization.AtPrime 𝔭) (I := 𝔭) _ _).mpr hmem

theorem wcpa_dj_lr1k_odfgl_cw_tbar_ne_zero : ∀ (R : Type u) [CommRing R] (J : Ideal R) (t f : R) (n' : Ideal R) [n'.IsPrime], f ∉ n' → (∀ 𝔮 : Ideal R, 𝔮.IsPrime → J ≤ 𝔮 → t ∈ 𝔮 → f ∉ 𝔮 → 𝔮 = n') → ∀ (𝔭 : Ideal (R ⧸ J)) [𝔭.IsPrime], 𝔭.comap (Ideal.Quotient.mk J) = n' → IsDomain (Localization.AtPrime 𝔭) → ∀ u ∈ n', algebraMap (R ⧸ J) (Localization.AtPrime 𝔭) (Ideal.Quotient.mk J u) ≠ 0 → algebraMap (R ⧸ J) (Localization.AtPrime 𝔭) (Ideal.Quotient.mk J t) ≠ 0 :=
by
  intro R _ J t f n' _ hfn hU 𝔭 _ h𝔭c hdom u hu hlu ht
  haveI := hdom
  set lam : R →+* Localization.AtPrime 𝔭 :=
    (algebraMap (R ⧸ J) (Localization.AtPrime 𝔭)).comp (Ideal.Quotient.mk J) with hlam
  have hprime : (RingHom.ker lam).IsPrime := RingHom.ker_isPrime lam
  have hJ : J ≤ RingHom.ker lam := by
    intro x hx
    rw [RingHom.mem_ker, hlam, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
  have htq : t ∈ RingHom.ker lam := RingHom.mem_ker.mpr ht
  have hfq : f ∉ RingHom.ker lam := by
    intro hf
    have hmk : Ideal.Quotient.mk J f ∉ 𝔭 := by
      intro h
      apply hfn
      rw [← h𝔭c, Ideal.mem_comap]
      exact h
    have hunit : IsUnit (algebraMap (R ⧸ J) (Localization.AtPrime 𝔭) (Ideal.Quotient.mk J f)) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭
        (Ideal.Quotient.mk J f)).mpr hmk
    exact hunit.ne_zero (RingHom.mem_ker.mp hf)
  have heq := hU (RingHom.ker lam) hprime hJ htq hfq
  rw [← heq] at hu
  exact hlu (RingHom.mem_ker.mp hu)

theorem wcpa_dj_lr1k_odfgl_cw_dvr_expand : ∀ (W : Type u) [CommRing W] [IsLocalRing W] (L : Type u) [CommRing L] [IsDomain L] [IsDiscreteValuationRing L] (ι : W →+* L) (π : L), IsLocalRing.maximalIdeal L = Ideal.span {π} → (∀ w ∈ IsLocalRing.maximalIdeal W, ι w = 0) → (∀ y : L, ∃ w : W, y - ι w ∈ IsLocalRing.maximalIdeal L) → (∀ (e : ℕ) (y : L), ∃ c : Fin e → W, y - ∑ i, ι (c i) * π ^ (i : ℕ) ∈ Ideal.span {π ^ e}) ∧ (∀ (e : ℕ) (c : Fin e → W), ∑ i, ι (c i) * π ^ (i : ℕ) ∈ Ideal.span {π ^ e} → ∀ i, c i ∈ IsLocalRing.maximalIdeal W) ∧ (∀ τ : L, τ ≠ 0 → τ ∈ IsLocalRing.maximalIdeal L → ∃ (e : ℕ) (v : Lˣ), 1 ≤ e ∧ τ = ↑v * π ^ e) :=
by
  intro W _ _ L _ _ _ ι π Hmax Hkill Hres
  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr Hmax
  have hπ : π ≠ 0 := hirr.ne_zero
  refine ⟨?_, ?_, ?_⟩
  · intro e y
    induction e with
    | zero => exact ⟨Fin.elim0, by simp⟩
    | succ e ih =>
      obtain ⟨c, hc⟩ := ih
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hc
      obtain ⟨w, hw⟩ := Hres a
      rw [Hmax] at hw
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hw
      refine ⟨Fin.snoc (α := fun _ => W) c w, ?_⟩
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.val_castSucc, Fin.val_last]
      refine Ideal.mem_span_singleton'.mpr ⟨b, ?_⟩
      linear_combination π ^ e * hb + ha
  · intro e
    induction e with
    | zero => intro c _ i; exact i.elim0
    | succ e ih =>
      intro c hc
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hc
      rw [Fin.sum_univ_succ] at ha
      simp only [Fin.val_zero, pow_zero, mul_one, Fin.val_succ] at ha
      have hS : ∑ i : Fin e, ι (c i.succ) * π ^ ((i : ℕ) + 1)
          = π * ∑ i : Fin e, ι (c i.succ) * π ^ (i : ℕ) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      rw [hS] at ha
      have h0mem : ι (c 0) ∈ IsLocalRing.maximalIdeal L := by
        rw [Hmax]
        refine Ideal.mem_span_singleton'.mpr
          ⟨a * π ^ e - ∑ i : Fin e, ι (c i.succ) * π ^ (i : ℕ), ?_⟩
        linear_combination ha
      have h0 : c 0 ∈ IsLocalRing.maximalIdeal W := by
        by_contra hn
        have hu : IsUnit (c 0) := IsLocalRing.notMem_maximalIdeal.mp hn
        exact (IsLocalRing.mem_maximalIdeal _).mp h0mem (hu.map ι)
      have hz := Hkill _ h0
      rw [hz, zero_add] at ha
      have hcancel : ∑ i : Fin e, ι (c i.succ) * π ^ (i : ℕ) = a * π ^ e := by
        apply mul_left_cancel₀ hπ
        linear_combination -ha
      have ih' := ih (fun i => c i.succ) (Ideal.mem_span_singleton'.mpr ⟨a, hcancel.symm⟩)
      intro i
      exact Fin.cases h0 (fun j => ih' j) i
  · intro τ hτ hτm
    obtain ⟨n, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hτ hirr
    refine ⟨n, v, ?_, hv⟩
    rcases Nat.eq_zero_or_pos n with h | h
    · exfalso
      rw [h, pow_zero, mul_one] at hv
      exact (IsLocalRing.mem_maximalIdeal _).mp hτm (hv ▸ v.isUnit)
    · exact h

theorem wcpa_dj_lr1k_odfgl_cw_loc_descent : ∀ (R : Type u) [CommRing R] (J : Ideal R) (t f : R) (n' : Ideal R) [n'.IsPrime], f ∉ n' → (∀ 𝔮 : Ideal R, 𝔮.IsPrime → J ≤ 𝔮 → t ∈ 𝔮 → f ∉ 𝔮 → 𝔮 = n') → ∀ (𝔭 : Ideal (R ⧸ J)) [𝔭.IsPrime], 𝔭.comap (Ideal.Quotient.mk J) = n' → ∀ d : R, algebraMap (R ⧸ J) (Localization.AtPrime 𝔭) (Ideal.Quotient.mk J d) ∈ Ideal.span {algebraMap (R ⧸ J) (Localization.AtPrime 𝔭) (Ideal.Quotient.mk J t)} → ∃ j : ℕ, f ^ j * d ∈ J ⊔ Ideal.span {t} :=
by
  intro R _ J t f n' hn' _hfn hU 𝔭 _ h𝔭 d hL
  classical
  set I : Ideal R := J ⊔ Ideal.span {t} with hI
  by_contra hne
  push_neg at hne
  let C : Ideal R :=
    { carrier := {r | r * d ∈ I}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at *
        rw [add_mul]
        exact I.add_mem ha hb
      zero_mem' := by
        simp only [Set.mem_setOf_eq, zero_mul]
        exact I.zero_mem
      smul_mem' := fun c x hx => by
        simp only [Set.mem_setOf_eq, smul_eq_mul] at *
        rw [mul_assoc]
        exact I.mul_mem_left c hx }
  have hmemC : ∀ r, r ∈ C ↔ r * d ∈ I := fun r => Iff.rfl
  have hdisj : Disjoint (C : Set R) (Submonoid.powers f) := by
    rw [Set.disjoint_left]
    rintro x hxC ⟨j, rfl⟩
    exact hne j ((hmemC _).mp hxC)
  obtain ⟨q, hq, hCq, hqdisj⟩ := Ideal.exists_le_prime_disjoint C (Submonoid.powers f) hdisj
  have hIC : I ≤ C := fun r hr => (hmemC r).mpr (I.mul_mem_right d hr)
  have hJq : J ≤ q := le_trans le_sup_left (le_trans hIC hCq)
  have htq : t ∈ q := hCq (hIC (Ideal.mem_sup_right (Ideal.mem_span_singleton_self t)))
  have hfq : f ∉ q := fun h => Set.disjoint_left.mp hqdisj h (Submonoid.mem_powers f)
  have hqn := hU q hq hJq htq hfq
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hL
  obtain ⟨⟨a', s'⟩, hys⟩ := IsLocalization.surj 𝔭.primeCompl y
  have heq : algebraMap (R ⧸ J) (Localization.AtPrime 𝔭) (Ideal.Quotient.mk J d * s') =
      algebraMap (R ⧸ J) (Localization.AtPrime 𝔭) (a' * Ideal.Quotient.mk J t) := by
    rw [map_mul, map_mul, ← hy]
    simp only at hys
    rw [← hys]
    ring
  obtain ⟨c', hc'⟩ := (IsLocalization.eq_iff_exists 𝔭.primeCompl _).mp heq
  obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (c' : R ⧸ J)
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (s' : R ⧸ J)
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective a'
  have hJmem : c * (d * s) - c * (a * t) ∈ J := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simp only [map_sub, map_mul]
    rw [hc, hs, ha, hc', sub_self]
  have hcsC : c * s ∈ C := by
    rw [hmemC]
    have e : c * s * d = (c * (d * s) - c * (a * t)) + (c * a) * t := by ring
    rw [e]
    exact I.add_mem (Ideal.mem_sup_left hJmem)
      (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self t)))
  have hcn : c ∉ n' := by
    intro h
    rw [← h𝔭, Ideal.mem_comap, hc] at h
    exact c'.2 h
  have hsn : s ∉ n' := by
    intro h
    rw [← h𝔭, Ideal.mem_comap, hs] at h
    exact s'.2 h
  have hcs : c * s ∈ n' := hqn ▸ hCq hcsC
  rcases hn'.mem_or_mem hcs with h | h
  · exact hcn h
  · exact hsn h

theorem wcpa_dj_lr1k_odfgl_cw_nakayama_poly : ∀ (W : Type u) [CommRing W] [IsLocalRing W] (N : Type u) [CommRing N] [Algebra W N] [Module.Finite W N] (u : N) (e : ℕ), (∀ x : N, ∃ c : Fin e → W, x - ∑ i, algebraMap W N (c i) * u ^ (i : ℕ) ∈ Ideal.map (algebraMap W N) (IsLocalRing.maximalIdeal W)) → (∀ c : Fin e → W, u ^ e = ∑ i, algebraMap W N (c i) * u ^ (i : ℕ) → ∀ i, c i ∈ IsLocalRing.maximalIdeal W) → ∃ P : Polynomial W, P.Monic ∧ P.natDegree = e ∧ P.map (IsLocalRing.residue W) = Polynomial.X ^ e ∧ Polynomial.aeval u P = 0 :=
by
  intro W _ _ N _ _ _ u e H1 H2
  classical
  set M : Submodule W N := Submodule.span W (Set.range (fun i : Fin e => u ^ (i : ℕ))) with hM
  have hsum_mem : ∀ c : Fin e → W, ∑ i, algebraMap W N (c i) * u ^ (i : ℕ) ∈ M := by
    intro c
    refine Submodule.sum_mem _ (fun i _ => ?_)
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hle : (⊤ : Submodule W N) ≤ M ⊔ (IsLocalRing.maximalIdeal W) • ⊤ := by
    intro x _
    obtain ⟨c, hc⟩ := H1 x
    have hy : x - ∑ i, algebraMap W N (c i) * u ^ (i : ℕ) ∈
        (IsLocalRing.maximalIdeal W) • (⊤ : Submodule W N) := by
      rw [Ideal.smul_top_eq_map]
      exact hc
    have := Submodule.add_mem_sup (hsum_mem c) hy
    rwa [add_sub_cancel] at this
  have hMtop : (⊤ : Submodule W N) ≤ M :=
    Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hle
  have hue : u ^ e ∈ M := hMtop Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun W).mp hue
  have hrel : u ^ e = ∑ i, algebraMap W N (c i) * u ^ (i : ℕ) := by
    rw [← hc]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def]
  have hcm := H2 c hrel
  set S : Polynomial W := ∑ i : Fin e, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ) with hS
  have hSdeg : S.degree < e := Polynomial.degree_sum_fin_lt c
  have hmon : (Polynomial.X ^ e - S).Monic := Polynomial.monic_X_pow_sub hSdeg
  refine ⟨Polynomial.X ^ e - S, hmon, ?_, ?_, ?_⟩
  · have hlt : S.degree < (Polynomial.X ^ e : Polynomial W).degree := by
      rw [Polynomial.degree_X_pow]; exact hSdeg
    have hd : (Polynomial.X ^ e - S).degree = (e : WithBot ℕ) := by
      rw [Polynomial.degree_sub_eq_left_of_degree_lt hlt, Polynomial.degree_X_pow]
    exact Polynomial.natDegree_eq_of_degree_eq_some hd
  · rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, hS, Polynomial.map_sum]
    have : ∑ i : Fin e, (Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)).map
        (IsLocalRing.residue W) = 0 := by
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X,
        (IsLocalRing.residue_eq_zero_iff _).mpr (hcm i), map_zero, zero_mul]
    rw [this, sub_zero]
  · rw [map_sub, Polynomial.aeval_X_pow, hS, map_sum]
    simp only [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
    rw [← hrel, sub_self]

theorem wcpa_dj_lr1k_odfgl_chart_weierstrass : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (D : Type u) [CommRing D] [Algebra ↥W D] [Algebra.FiniteType ↥W D] (φ : Polynomial ↥W →+* D), φ.Etale → (∀ w : ↥W, φ (Polynomial.C w) = algebraMap ↥W D w) → ∀ (n' : Ideal D) [n'.IsPrime], Ideal.map (algebraMap ↥W D) (IsLocalRing.maximalIdeal ↥W) ≤ n' → φ Polynomial.X ∈ n' → (∀ d : D, ∃ w : ↥W, d - algebraMap ↥W D w ∈ n') → ∀ (t β : D), t ∈ n' → IsUnit β → IsIntegral ↥W (Ideal.Quotient.mk (Ideal.span {t}) β) → (∀ x : D, ∃ k : ℕ, IsIntegral ↥W (Ideal.Quotient.mk (Ideal.span {t}) (β ^ k * x))) → ∃ g' : D, g' ∉ n' ∧ ∃ P : Polynomial ↥W, P.Monic ∧ 1 ≤ P.natDegree ∧ P.map (IsLocalRing.residue ↥W) = Polynomial.X ^ P.natDegree ∧ ∃ ε : (Localization.Away g')ˣ, algebraMap D (Localization.Away g') t = ↑ε * algebraMap D (Localization.Away g') (φ P) :=
by
  intro Ω _ _ W D _ _ _ φ hφ hC n' _ hJn hun hres t β htn hβ hβint hint
  classical

  obtain ⟨f, hfn, hNfin, hU⟩ :=
    wcpa_dj_lr1k_odfgl_cw_finite_piece Ω W D n' hJn t β htn hβ hβint hint
  set J : Ideal D := Ideal.map (algebraMap ↥W D) (IsLocalRing.maximalIdeal ↥W) with hJ

  obtain ⟨ψ, hψet, hψX⟩ := wcpa_dj_lr1k_odfgl_cw_fibre_etale ↥W D φ hφ hC
  have hmkJ : Function.Surjective (Ideal.Quotient.mk J) := Ideal.Quotient.mk_surjective
  have hkerJ : RingHom.ker (Ideal.Quotient.mk J) ≤ n' := by rw [Ideal.mk_ker]; exact hJn
  set 𝔭 : Ideal (D ⧸ J) := n'.map (Ideal.Quotient.mk J) with h𝔭
  haveI h𝔭P : 𝔭.IsPrime := Ideal.map_isPrime_of_surjective hmkJ hkerJ
  have h𝔭c : 𝔭.comap (Ideal.Quotient.mk J) = n' := by
    rw [h𝔭, Ideal.comap_map_of_surjective' _ hmkJ, sup_eq_left.mpr hkerJ]
