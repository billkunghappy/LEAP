    haveI := functionField_isFractionRing_of_isAffineOpen C (γ ⁻¹ᵁ V₀) hV₁aff
    have hginj : Function.Injective (C.presheaf.germ (γ ⁻¹ᵁ V₀) (genericPoint C) hηV₁).hom :=
