    rcases hAB with hA | hB
    · exfalso
      have hpr := wcpa_dj_lr1k_ebnt_modelA_fibre Ω W hW hWt QZ (jZ.comp σZ) hA
      have hmem : jZ (fZ (wcEbntX W a 0)) * jZ (fZ (wcEbntX W a 1)) ∈
          (IsLocalRing.maximalIdeal ↥W).map (jZ.comp σZ) := by
        rw [hFG]; exact Ideal.mem_map_of_mem _ hfZ.1
      rcases hpr.mem_or_mem hmem with hF | hG
      · apply hF𝔔₁
        exact (Ideal.map_le_iff_le_comap.mpr (fun t ht => Ideal.mem_comap.mpr (hσ𝔔₁ t ht))) hF
      · apply hG𝔔₀
        exact (Ideal.map_le_iff_le_comap.mpr (fun t ht => Ideal.mem_comap.mpr (hσ𝔔₀ t ht))) hG
    · exact hB

  unfold wcNdModelB at hB₁
  obtain ⟨b, hbm, hb0, f'₀, hf'σ, hf'H⟩ := hB₁
  have hf'₀ : wcEbntPres W (jZ.comp σZ) b f'₀ := ⟨hbm, hb0, hf'σ, hf'H⟩
  haveI : HenselianLocalRing QZ := hf'H.1
  obtain ⟨f', hf', hw𝔔⟩ : ∃ f' : wcEbntN W b →+* QZ, wcEbntPres W (jZ.comp σZ) b f' ∧
      f' (wcEbntX W b 1) ∈ 𝔔₁ := by
    have hm : f'₀ (wcEbntX W b 0) * f'₀ (wcEbntX W b 1) ∈ 𝔔₁ := by
      rw [hrel _ _ _ _ hf'₀]; exact hσ𝔔₁ b hbm
    rcases h𝔔₁p.mem_or_mem hm with h0 | h1
    · obtain ⟨f'', hf'', -, h1'⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W QZ _ b f'₀ hf'₀
      exact ⟨f'', hf'', by rw [h1']; exact h0⟩
    · exact ⟨f'₀, hf'₀, h1⟩

  obtain ⟨α, n, η, hα0, hη, hdm⟩ := wcpa_dj_lr1k_ebnt_dominant_monomial Ω W hW hWt QZ
    (jZ.comp σZ) b f' hf' (jZ (fZ (wcEbntX W a 0))) (jZ (fZ (wcEbntX W a 1))) a hfZ.2.1 hFG
  have hFu : jZ (fZ (wcEbntX W a 0)) = η * (jZ.comp σZ) α * f' (wcEbntX W b 0) ^ n := by
    rcases hdm with h0 | h1
    · exact h0
    · rcases n with _ | k
      · rw [h1, pow_zero, pow_zero]
      · exfalso; apply hF𝔔₁; rw [h1]
        exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hw𝔔 _ (Nat.succ_pos k))
  have hαu : IsUnit α := by
    by_contra hα
    apply hF𝔔₁; rw [hFu]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _
      (hσ𝔔₁ α ((IsLocalRing.mem_maximalIdeal _).mpr hα)))
  obtain ⟨η₀, hη₀def⟩ : ∃ η₀, η₀ = η * (jZ.comp σZ) α := ⟨_, rfl⟩
  rw [← hη₀def] at hFu
  have hη₀ : IsUnit η₀ := by rw [hη₀def]; exact hη.mul (hαu.map _)
  have hn : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · exfalso
      rw [h0, pow_zero, mul_one] at hFu
      apply hXnu PZ σZ a fZ hfZ 0
      exact (isUnit_map_iff jZ _).mp (by rw [hFu]; exact hη₀)
    · exact h0

  obtain ⟨hQd, -⟩ := hN QZ _ b f' hf'
  haveI := hQd
  have hσZinj : Function.Injective σZ :=
    wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W PZ σZ a fZ hfZ
  have hσ0 : ∀ t : ↥W, t ≠ 0 → jZ (σZ t) ≠ 0 := fun t ht h0 =>
    ht (hσZinj (hjZi (by rw [h0, map_zero, map_zero])))
  have hUw : f' (wcEbntX W b 0) * f' (wcEbntX W b 1) = jZ (σZ b) := by
    rw [hrel _ _ _ _ hf']; rfl
  have hU0 : f' (wcEbntX W b 0) ≠ 0 := fun h0 => hσ0 b hb0 (by rw [← hUw, h0, zero_mul])
  have hUn0 : f' (wcEbntX W b 0) ^ n ≠ 0 := pow_ne_zero n hU0
  have hη₀n : η₀ ∉ 𝔔₀ := fun h => h𝔔₀p.ne_top (Ideal.eq_top_of_isUnit_mem _ h hη₀)
  rcases ValuationRing.dvd_total a (b ^ n) with ⟨d, hd⟩ | ⟨ν, hν⟩
  ·
    by_cases hdu : IsUnit d
    · refine ⟨b, f', η₀, n, ↑hdu.unit⁻¹, hf', hη₀, hn, Units.isUnit _, hFu, ?_⟩
      rw [hd, mul_assoc, IsUnit.mul_val_inv, mul_one]
    · exfalso
      have hdm' : d ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hdu
      have heq : f' (wcEbntX W b 1) ^ n =
          η₀ * jZ (fZ (wcEbntX W a 1)) * jZ (σZ d) := by
        apply mul_left_cancel₀ hUn0
        calc f' (wcEbntX W b 0) ^ n * f' (wcEbntX W b 1) ^ n
            = (f' (wcEbntX W b 0) * f' (wcEbntX W b 1)) ^ n := by ring
          _ = jZ (σZ (b ^ n)) := by rw [hUw, map_pow, map_pow]
          _ = jZ (fZ (wcEbntX W a 0)) * jZ (fZ (wcEbntX W a 1)) * jZ (σZ d) := by
              rw [hd, map_mul, map_mul, hFG']
          _ = _ := by rw [hFu]; ring
      obtain ⟨f's, hf's, hf's0, hf's1⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W QZ _ b f' hf'
      obtain ⟨hb'p, hwnb, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt QZ _ b f's hf's
      rw [hf's1] at hb'p
      rw [hf's0, hf's1] at hwnb
      apply hwnb
      apply hb'p.mem_of_pow_mem n
      rw [heq]
      exact Ideal.mem_sup_right (Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem (jZ.comp σZ) hdm'))
  ·
    by_cases hνu : IsUnit ν
    · exact ⟨b, f', η₀, n, ν, hf', hη₀, hn, hνu, hFu, hν⟩
    · exfalso
      have hνm : ν ∈ IsLocalRing.maximalIdeal ↥W := (IsLocalRing.mem_maximalIdeal _).mpr hνu
      have heq : η₀ * jZ (fZ (wcEbntX W a 1)) = f' (wcEbntX W b 1) ^ n * jZ (σZ ν) := by
        apply mul_left_cancel₀ hUn0
        calc f' (wcEbntX W b 0) ^ n * (η₀ * jZ (fZ (wcEbntX W a 1)))
            = jZ (fZ (wcEbntX W a 0)) * jZ (fZ (wcEbntX W a 1)) := by rw [hFu]; ring
          _ = jZ (σZ a) := hFG'
          _ = (f' (wcEbntX W b 0) * f' (wcEbntX W b 1)) ^ n * jZ (σZ ν) := by
              rw [hUw, hν, map_mul, map_mul, map_pow, map_pow]
          _ = _ := by ring
      have hmem : η₀ * jZ (fZ (wcEbntX W a 1)) ∈ 𝔔₀ := by
        rw [heq]; exact Ideal.mul_mem_left _ _ (hσ𝔔₀ ν hνm)
      rcases h𝔔₀p.mem_or_mem hmem with h | h
      · exact hη₀n h
      · exact hG𝔔₀ h

theorem wcpa_dj_lr1k_ebc_dia_hens_residue : ∀ (A P : Type u) [CommRing A] [CommRing P] (p : Ideal A) (e : A →+* P), wcNdIsHens p P e → ∀ x : P, ∃ a s : A, s ∉ p ∧ ¬ IsUnit (x * e s - e a) :=
by
  intro A P _ _ p e he x
  obtain ⟨hP, hu, huniv⟩ := he
  haveI : HenselianLocalRing P := hP
  have hm : ∀ c : P, c ∈ IsLocalRing.maximalIdeal P ↔ ¬ IsUnit c := fun c =>
    (IsLocalRing.mem_maximalIdeal c).trans mem_nonunits_iff
  have hmul : ∀ s t : A, s ∉ p → t ∉ p → s * t ∉ p := by
    intro s t hs ht
    rw [← hu, map_mul]
    exact ((hu s).2 hs).mul ((hu t).2 ht)
  have h1 : (1 : A) ∉ p := by
    rw [← hu, map_one]
    exact isUnit_one
  let M := IsLocalRing.maximalIdeal P
  let R : Subring P :=
    { carrier := {y | ∃ a s : A, s ∉ p ∧ y * e s - e a ∈ M}
      mul_mem' := by
        rintro x y ⟨a, s, hs, hx⟩ ⟨b, t, ht, hy⟩
        refine ⟨a * b, s * t, hmul s t hs ht, ?_⟩
        have : x * y * e (s * t) - e (a * b) =
            (y * e t) * (x * e s - e a) + e a * (y * e t - e b) := by
          rw [map_mul, map_mul]; ring
        rw [this]
        exact M.add_mem (M.mul_mem_left _ hx) (M.mul_mem_left _ hy)
      one_mem' := ⟨1, 1, h1, by simp⟩
      add_mem' := by
        rintro x y ⟨a, s, hs, hx⟩ ⟨b, t, ht, hy⟩
        refine ⟨a * t + b * s, s * t, hmul s t hs ht, ?_⟩
        have : (x + y) * e (s * t) - e (a * t + b * s) =
            e t * (x * e s - e a) + e s * (y * e t - e b) := by
          rw [map_mul, map_add, map_mul, map_mul]; ring
        rw [this]
        exact M.add_mem (M.mul_mem_left _ hx) (M.mul_mem_left _ hy)
      zero_mem' := ⟨0, 1, h1, by simp⟩
      neg_mem' := by
        rintro x ⟨a, s, hs, hx⟩
        refine ⟨-a, s, hs, ?_⟩
        have : -x * e s - e (-a) = -(x * e s - e a) := by rw [map_neg]; ring
        rw [this]
        exact M.neg_mem_iff.mpr hx }
  have hnon : ∀ c : P, ¬ IsUnit c → c ∈ R := by
    intro c hc
    refine ⟨0, 1, h1, ?_⟩
    rw [map_one, map_zero, mul_one, sub_zero]
    exact (hm c).2 hc
  have hinv : ∀ y ∈ R, ∀ z : P, y * z = 1 → z ∈ R := by
    rintro y ⟨a, s, hs, hy⟩ z hyz
    have ha : a ∉ p := by
      intro ha
      have hea : e a ∈ M := (hm _).2 (fun h => ((hu a).1 h) ha)
      have hys : y * e s ∈ M := by
        have := M.add_mem hy hea
        simpa using this
      exact (hm _).1 hys ((IsUnit.of_mul_eq_one z hyz).mul ((hu s).2 hs))
    refine ⟨s, a, ha, ?_⟩
    have : z * e a - e s = -(z * (y * e s - e a)) + e s * (z * y - 1) := by ring
    rw [this, mul_comm z y, hyz, sub_self, mul_zero, add_zero]
    exact M.neg_mem_iff.mpr (M.mul_mem_left _ hy)
  have hrange : ∀ a : A, e a ∈ R := fun a => ⟨a, 1, h1, by simp⟩
  have hRu : ∀ r : R, IsUnit r ↔ IsUnit (r : P) := by
    intro r
    constructor
    · intro h
      exact h.map R.subtype
    · intro h
      obtain ⟨z, hz⟩ := h.exists_right_inv
      have hzR : z ∈ R := hinv r r.2 z hz
      exact IsUnit.of_mul_eq_one (⟨z, hzR⟩ : R) (Subtype.ext hz)
  haveI : Nontrivial R := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
  have hRloc : IsLocalRing R := IsLocalRing.of_nonunits_add (by
    intro a b ha hb
    have ha' : (a : P) ∈ nonunits P := fun h => ha ((hRu a).2 h)
    have hb' : (b : P) ∈ nonunits P := fun h => hb ((hRu b).2 h)
    have hab := IsLocalRing.nonunits_add ha' hb'
    exact fun h => hab ((hRu (a + b)).1 h))
  have hRh : HenselianLocalRing R := by
    refine { toIsLocalRing := hRloc, is_henselian := ?_ }
    intro f hf a₀ h₁ h₂
    have hFm : (f.map R.subtype).Monic := hf.map _
    have hFe : (f.map R.subtype).eval (R.subtype a₀) ∈ M := by
      rw [Polynomial.eval_map_apply, hm]
      intro h
      exact ((IsLocalRing.mem_maximalIdeal _).1 h₁) ((hRu _).2 h)
    have hFd : IsUnit ((f.map R.subtype).derivative.eval (R.subtype a₀)) := by
      rw [Polynomial.derivative_map, Polynomial.eval_map_apply]
      exact h₂.map R.subtype
    obtain ⟨b, hbroot, hbm⟩ :=
      HenselianLocalRing.is_henselian (f.map R.subtype) hFm (R.subtype a₀) hFe hFd
    have hbR : b ∈ R := by
      have h3 : b - R.subtype a₀ ∈ R := hnon _ ((hm _).1 hbm)
      have := R.add_mem h3 a₀.2
      simpa using this
    refine ⟨⟨b, hbR⟩, ?_, ?_⟩
    · have e1 := Polynomial.eval_map_apply (p := f) R.subtype (⟨b, hbR⟩ : R)
      have e2 : R.subtype (f.eval ⟨b, hbR⟩) = 0 := by
        rw [← e1]
        exact hbroot
      exact Subtype.ext e2
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hRu]
      exact (hm _).1 hbm
  let g : A →+* R := e.codRestrict R hrange
  have hg : ∀ a, IsUnit (g a) ↔ a ∉ p := fun a => (hRu (g a)).trans (hu a)
  obtain ⟨h, ⟨hhe, hhloc⟩, -⟩ := huniv R hRh g hg
  haveI : IsLocalHom R.subtype := ⟨fun r hr => (hRu r).2 hr⟩
  haveI := hhloc
  let k : P →+* P := R.subtype.comp h
  have hk : IsLocalHom k := RingHom.isLocalHom_comp _ _
  have hke : k.comp e = e := by
    ext a
    show ((h (e a) : R) : P) = e a
    rw [← RingHom.comp_apply, hhe]
    rfl
  have hkid : k = RingHom.id P :=
    ExistsUnique.unique (huniv P hP e hu) ⟨hke, hk⟩ ⟨RingHom.id_comp e, isLocalHom_id P⟩
  have hxR : x ∈ R := by
    have h0 : k x ∈ R := (h x).2
    have h0' : k x = x := by rw [hkid]; rfl
    rwa [h0'] at h0
  obtain ⟨a, s, hs, hxm⟩ := hxR
  exact ⟨a, s, hs, (hm _).1 hxm⟩

theorem wcpa_dj_lr1k_ebc_dia_monic_splits : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (P : Polynomial ↥W), P.Monic → ∃ l : List ↥W, P = (l.map (fun α => Polynomial.X - Polynomial.C α)).prod :=
by
  intro Ω _ _ W P₀ hP₀
  classical
  suffices H : ∀ n : ℕ, ∀ P : Polynomial ↥W, P.Monic → P.natDegree = n →
      ∃ l : List ↥W, P = (l.map (fun α => Polynomial.X - Polynomial.C α)).prod from
    H _ P₀ hP₀ rfl
  intro n
  induction n with
  | zero =>
    intro P hP hn
    refine ⟨[], ?_⟩
    rw [Polynomial.eq_one_of_monic_natDegree_zero hP hn]
    simp
  | succ n ih =>
    intro P hP hn
    have hQ : (P.map (algebraMap ↥W Ω)).Monic := hP.map _
    have hQd : (P.map (algebraMap ↥W Ω)).natDegree = n + 1 := by
      rw [hP.natDegree_map]; exact hn
    have hdeg : (P.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hQ.ne_zero, hQd]
      exact_mod_cast (Nat.succ_ne_zero n)
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hdeg
    have hx' : Polynomial.eval₂ (algebraMap ↥W Ω) x P = 0 := by
      rw [Polynomial.IsRoot, Polynomial.eval_map] at hx; exact hx
    have hint : IsIntegral ↥W x := ⟨P, hP, hx'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hroot : P.IsRoot y := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy]
      exact hx'
    have hmul := Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot
    have hP' : (P /ₘ (Polynomial.X - Polynomial.C y)).Monic :=
      Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C y) (by rw [hmul]; exact hP)
    have hd' : (P /ₘ (Polynomial.X - Polynomial.C y)).natDegree = n := by
      have h1 := (Polynomial.monic_X_sub_C y).natDegree_mul hP'
      rw [hmul, hn, Polynomial.natDegree_X_sub_C] at h1
      omega
    obtain ⟨l', hl'⟩ := ih _ hP' hd'
    refine ⟨y :: l', ?_⟩
    rw [List.map_cons, List.prod_cons, ← hl', hmul]

theorem wcpa_dj_lr1k_ebc_dia_circle_factor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (QZ Q₂ : Type u) [CommRing QZ] [CommRing Q₂] (σ' : ↥W →+* QZ) (b : ↥W) (f' : wcEbntN W b →+* QZ), wcEbntPres W σ' b f' → ∀ (κ : QZ →+* Q₂), IsLocalHom κ → Function.Injective κ → HenselianLocalRing Q₂ → IsDomain Q₂ → ∀ (β d t₀ : ↥W) (ω : Q₂), β ∈ IsLocalRing.maximalIdeal ↥W → β ≠ 0 → d ∈ IsLocalRing.maximalIdeal ↥W → b = β * d → IsUnit t₀ → κ (f' (wcEbntX W b 0)) = κ (σ' β) * ω → ¬ IsUnit (ω - κ (σ' t₀)) → ∃ (R : Type u) (_ : CommRing R) (fR : Polynomial ↥W →+* R) (ρ : R →+* Q₂) (ψ : QZ →+* R) (T : R), wcNdIsHens (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) R fR ∧ IsLocalHom ρ ∧ Function.Injective ρ ∧ ρ.comp (fR.comp Polynomial.C) = κ.comp σ' ∧ ρ.comp ψ = κ ∧ IsUnit T ∧ ρ T = ω :=
by
  intro Ω _ _ W hW hWt QZ Q₂ _ _ σ' b f' hf' κ hκl hκi hQh hQd β d t₀ ω hβm hβ0 hdm hb ht₀
    hκu hθ
  classical
  haveI := hκl; haveI := hQh; haveI := hQd
  have hf'0 := hf'
  obtain ⟨hbm, hb0, hf'C, hf'H⟩ := hf'
  have hf'Cc : ∀ c : ↥W, f' (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) (MvPolynomial.C c)) =
      σ' c := by
    intro c
    have := RingHom.congr_fun hf'C c
    simpa only [RingHom.comp_apply] using this

  have hp0mem : ∀ p : Polynomial ↥W, p ∈ (Ideal.span {Polynomial.X} ⊔
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) ↔
      p.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
    intro p
    constructor
    · intro hp
      have hle : Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W) ≤
          Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
            Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
          exact Ideal.zero_mem _
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          rw [Ideal.mem_comap, Ideal.mem_comap, Polynomial.constantCoeff_apply,
            Polynomial.coeff_C_zero]
          exact hc
      have := hle hp
      rwa [Ideal.mem_comap, Polynomial.constantCoeff_apply] at this
    · intro hc
      rw [← Polynomial.divX_mul_X_add p]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
  have hp0eq : (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) =
      Ideal.comap Polynomial.constantCoeff (IsLocalRing.maximalIdeal ↥W) := by
    ext p
    rw [hp0mem, Ideal.mem_comap, Polynomial.constantCoeff_apply]
  have hp0prime : (Ideal.span {Polynomial.X} ⊔
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)).IsPrime := by
    rw [hp0eq]
    haveI : (IsLocalRing.maximalIdeal ↥W).IsPrime := (IsLocalRing.maximalIdeal.isMaximal ↥W).isPrime
    infer_instance

  obtain ⟨R, _, fR, hR⟩ := wcNd_hens_exists (Polynomial ↥W) _ hp0prime
  haveI : HenselianLocalRing R := hR.1
  have hm2 : ∀ x : Q₂, x ∈ IsLocalRing.maximalIdeal Q₂ ↔ ¬ IsUnit x := fun x =>
    (IsLocalRing.mem_maximalIdeal x).trans mem_nonunits_iff
  have hσu : ∀ c : ↥W, IsUnit (κ (σ' c)) ↔ c ∉ IsLocalRing.maximalIdeal ↥W := by
    intro c
    constructor
    · intro hu hc
      refine (hf'H.2.1 (Ideal.Quotient.mk _ (MvPolynomial.C c))).mp ?_
        (Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc)))
      rw [hf'Cc]
      exact (isUnit_map_iff κ _).mp hu
    · intro hc
      have : IsUnit c := by
        by_contra h
        exact hc ((IsLocalRing.mem_maximalIdeal c).mpr h)
      exact (this.map σ').map κ
  obtain ⟨T, hTdef⟩ : ∃ T : R, T = fR (Polynomial.C t₀ + Polynomial.X) := ⟨_, rfl⟩
  have hTu : IsUnit T := by
