theorem wcpa_dj_lr1k_gn_generic_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)], wcpaDjLkModel W uX ι → ∀ w : ↥(wcpaDjLkFib W (φ ≫ ι) uX), ¬ IsClosed ({w} : Set ↥(wcpaDjLkFib W (φ ≫ ι) uX)) → ∃ U : (wcpaDjLkFib W (φ ≫ ι) uX).Opens, w ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX) (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
