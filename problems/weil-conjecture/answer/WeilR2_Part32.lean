theorem wcpa_dj_lr1k_odfgl_bs_open_chart_transport : ∀ {P X M T : Scheme.{u}} (j : P ⟶ X) [IsOpenImmersion j] (h : P ⟶ M) [Etale h] (c : T ⟶ M) [IsOpenImmersion c] (p : ↥P) (t : ↥T), h p = c t → ∃ (V : X.Opens) (mN : V.toScheme ⟶ T) (e : V.toScheme ⟶ P) (hx : j p ∈ V), Etale mN ∧ e ≫ j = V.ι ∧ mN ≫ c = e ≫ h ∧ mN ⟨j p, hx⟩ = t :=
by
  intro P X M T j _ h _ c _ p t hpt
  classical
  let P' : P.Opens := h ⁻¹ᵁ c.opensRange
  have hp : p ∈ P' := by
    show h p ∈ c.opensRange
    rw [Scheme.Hom.mem_opensRange]
    exact ⟨t, hpt.symm⟩
  let V : X.Opens := j ''ᵁ P'
  have hVset : (V : Set X) = j '' (P' : Set P) := Scheme.Hom.coe_image ..
  have hx : j p ∈ V := by
    show j p ∈ (V : Set X)
    rw [hVset]
    exact Set.mem_image_of_mem _ hp
  have H₁ : Set.range V.ι ⊆ Set.range j := by
    rw [Scheme.Opens.range_ι, hVset]
    exact Set.image_subset_range _ _
  let e : V.toScheme ⟶ P := IsOpenImmersion.lift j V.ι H₁
  have he : e ≫ j = V.ι := IsOpenImmersion.lift_fac j V.ι H₁
  have hjinj : Function.Injective j := (Scheme.Hom.isOpenEmbedding j).injective
  have hcinj : Function.Injective c := (Scheme.Hom.isOpenEmbedding c).injective
  have hje : ∀ v : V.toScheme, j (e v) = V.ι v := by
    intro v
    rw [← Scheme.Hom.comp_apply, he]
  have heP : ∀ v : V.toScheme, e v ∈ P' := by
    intro v
    have hv : V.ι v ∈ (V : Set X) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨v, rfl⟩
    rw [hVset] at hv
    obtain ⟨q, hq, hqv⟩ := hv
    have : e v = q := hjinj (by rw [hje, hqv])
    rw [this]
    exact hq
  have H₂ : Set.range (e ≫ h) ⊆ Set.range c := by
    rintro _ ⟨v, rfl⟩
    have h1 : h (e v) ∈ c.opensRange := heP v
    rw [Scheme.Hom.mem_opensRange] at h1
    obtain ⟨x, hx⟩ := h1
    exact ⟨x, by rw [hx, Scheme.Hom.comp_apply]⟩
  let mN : V.toScheme ⟶ T := IsOpenImmersion.lift c (e ≫ h) H₂
  have hmN : mN ≫ c = e ≫ h := IsOpenImmersion.lift_fac c (e ≫ h) H₂
  have : IsOpenImmersion (e ≫ j) := by rw [he]; infer_instance
  have : IsOpenImmersion e := IsOpenImmersion.of_comp e j
  have : Etale (mN ≫ c) := by rw [hmN]; infer_instance
  have hEt : Etale mN := Etale.of_comp mN c
  have key : ∀ v : V.toScheme, V.ι v = j p → mN v = t := by
    intro v hv
    have hep : e v = p := hjinj (by rw [hje, hv])
    apply hcinj
    rw [← Scheme.Hom.comp_apply, hmN, Scheme.Hom.comp_apply, hep, hpt]
  refine ⟨V, mN, e, hx, hEt, he, hmN, ?_⟩
  exact key _ rfl

theorem wcpa_dj_lr1k_odfgl_bs_model_points : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (c : ↥W), c ≠ 0 → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (c₀ : Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})) ⟶ M') (c₁ : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ M'), c₀ ≫ r₀ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp MvPolynomial.C) (fun _ : Fin 1 => Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 0)))) → (∀ p : ↥M', p ∈ Set.range c₀ ∨ p ∈ Set.range c₁) → (∀ q : ↥(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 1) ∉ q.asIdeal → c₀ q ∈ Set.range c₁) → (∀ p : ↥M', (r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) p ≠ IsLocalRing.closedPoint ↥W → p ∈ Set.range c₁) ∧ (∀ p : ↥M', p ∉ Set.range c₁ → r₀ p = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) (IsLocalRing.closedPoint ↥W) → ∃ q : ↥(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))), c₀ q = p ∧ Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 0) ∈ q.asIdeal ∧ Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 1) ∈ q.asIdeal) :=
by
  intro Ω _ W hW c hc0 M' r₀ c₀ c₁ hc₀r hcov hov
  have hcomap : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (x : ↥(Spec S)) (r : R),
      r ∈ (Spec.map f x).asIdeal ↔ f.hom r ∈ x.asIdeal := by
    intro R S f x r
    rw [Spec.map_apply]
    rfl
  have key : ∀ p : ↥M', p ∉ Set.range c₁ → ∃ q, c₀ q = p ∧
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
        (MvPolynomial.X 1) ∈ q.asIdeal := by
    intro p hp
    rcases hcov p with ⟨q, hq⟩ | h
    · refine ⟨q, hq, ?_⟩
      by_contra hx
      exact hp (hq ▸ hov q hx)
    · exact absurd h hp
  have hpt : ∀ q, r₀ (c₀ q) = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
      ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp
        MvPolynomial.C) (fun _ : Fin 1 => Ideal.Quotient.mk
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 0)))) q := by
    intro q
    rw [← Scheme.Hom.comp_apply, hc₀r]
  have hrel : Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} : Ideal (MvPolynomial (Fin 2) ↥W))
      (MvPolynomial.C c) =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} : Ideal (MvPolynomial (Fin 2) ↥W))
        (MvPolynomial.X 0) *
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} : Ideal (MvPolynomial (Fin 2) ↥W))
        (MvPolynomial.X 1) := by
    rw [← map_mul]
    symm
    rw [Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  refine ⟨?_, ?_⟩
  · intro p hp
    by_contra hpc
    obtain ⟨q, rfl, hx₁⟩ := key p hpc
    apply hp
    have : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    apply PrimeSpectrum.ext
    rw [Scheme.Hom.comp_apply, hpt]
    set P := (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
      ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp
        MvPolynomial.C) (fun _ : Fin 1 => Ideal.Quotient.mk
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X 0)))) q))
      with hP
    have hmem : ∀ w : ↥W, w ∈ P.asIdeal ↔
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
          (MvPolynomial.C w) ∈ q.asIdeal := by
      intro w
      rw [hP, hcomap, hcomap]
      simp only [CommRingCat.hom_ofHom, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    have hcP : c ∈ P.asIdeal := by
      have h0 := Ideal.mul_mem_left q.asIdeal
        (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
          (MvPolynomial.X 0)) hx₁
      refine (hmem c).2 ?_
      rw [hrel]
      exact h0
    have hne : P.asIdeal ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hcP
      exact hc0 hcP
    have hmax := Ideal.IsPrime.isMaximal_of_ne_bot P.isPrime hne
    exact IsLocalRing.eq_maximalIdeal hmax
  · intro p hpc hr
    obtain ⟨q, rfl, hx₁⟩ := key p hpc
    refine ⟨q, rfl, ?_, hx₁⟩
    rw [hpt] at hr
    have h3 : (MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W) ∈
        (Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
          ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})).comp
            MvPolynomial.C) (fun _ : Fin 1 => Ideal.Quotient.mk
              (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
                (MvPolynomial.X 0)))) q).asIdeal := by
      rw [hr]
      refine (hcomap (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))
        (IsLocalRing.closedPoint ↥W : ↥(Spec (.of ↥W))) _).2 ?_
      simp only [CommRingCat.hom_ofHom, MvPolynomial.eval_X]
      exact Ideal.zero_mem _
    rw [hcomap] at h3
    simp only [CommRingCat.hom_ofHom, MvPolynomial.eval₂Hom_X'] at h3
    exact h3

