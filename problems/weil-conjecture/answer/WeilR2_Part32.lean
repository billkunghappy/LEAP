      letI : Algebra Γ(X, U') (X.presheaf.stalk x) := (X.presheaf.germ U' x hxU').hom.toAlgebra
      haveI : IsLocalization.AtPrime (X.presheaf.stalk x) (hU'.primeIdealOf ⟨x, hxU'⟩).asIdeal :=
        hU'.isLocalization_stalk ⟨x, hxU'⟩
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (X.presheaf.stalk x) (hU'.primeIdealOf ⟨x, hxU'⟩).asIdeal _).mpr hc
    rw [map_sub, hb₁, hconst] at key
    exact key

  have hgerm : (wcLr1uGerm ι x hx).hom (b - wcNdSig uX x a) =
      g' - wcLr1uConst (wcProjKStr Ω 1) (a : Ω) := by
    rw [map_sub, hb]
    congr 1
    exact RingHom.congr_fun (wcpa_dj_lr1k_ebc_dad_germ_const Ω W X uX ι hpb x hx) a

  have hg0 : g ≠ 0 := by
    obtain ⟨-, -, ⟨t, -, ht⟩, -⟩ := hg
    intro h0
    rw [h0, mul_zero] at ht
    exact zero_ne_one ht
  obtain ⟨α, β, γ, δ, hdet, hid⟩ : ∃ α β γ δ : ↥W, IsUnit (α * δ - β * γ) ∧
      (wcLr1uConst (wcProjKStr Ω 1) (α : Ω) * g + wcLr1uConst (wcProjKStr Ω 1) (β : Ω)) *
        (wcLr1uConst (wcProjKStr Ω 1) (γ : Ω) * g + wcLr1uConst (wcProjKStr Ω 1) (δ : Ω))⁻¹ =
      g' - wcLr1uConst (wcProjKStr Ω 1) (a : Ω) := by
    rcases hg' with rfl | rfl
    · refine ⟨1, -a, 0, 1, by simp, ?_⟩
      simp [sub_eq_add_neg]
    · refine ⟨-a, 1, 1, 0, by simp, ?_⟩
      simp only [NegMemClass.coe_neg, OneMemClass.coe_one, ZeroMemClass.coe_zero,
        map_neg, map_one, map_zero, one_mul, add_zero]
      rw [add_mul, mul_assoc, mul_inv_cancel₀ hg0]
      ring
  have hdetΩ : (α : Ω) * (δ : Ω) - (β : Ω) * (γ : Ω) ≠ 0 := by
    intro h
    apply hdet.ne_zero
    exact Subtype.ext h
  unfold wcLr1uVtdRT at hgRT
  obtain ⟨-, hmemV, hRTq⟩ := wcpa_dj_lr1u_vgc_rt_mobius Ω (wcProjK Ω 1).functionField
    (wcLr1uConst (wcProjKStr Ω 1)) W V hCC g hgRT.1 hgRT.2 α β γ δ hdet
  rw [hid] at hmemV hRTq
  obtain ⟨d1, d2, d3, -, hMob⟩ :=
    wcpa_dj_lr1u_fn_mob_moebius Ω c1 c2 c3 g (α : Ω) (β : Ω) (γ : Ω) (δ : Ω) hg hdetΩ
  rw [hid] at hMob
  refine ⟨_, d1, d2, d3, b - wcNdSig uX x a, hMob, hgerm, ha, ?_⟩
  unfold wcLr1uVtdRT
  exact ⟨hmemV, hRTq⟩

theorem wcpa_dj_lr1k_ebc_dsc_unique_generization : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (x : X), uX x = IsLocalRing.closedPoint ↥W → IsClosed ({x} : Set X) → (∃ U : X.Opens, x ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ uX)) → ∀ ζ ζ' : X, ζ ⤳ x → ζ' ⤳ x → uX ζ = IsLocalRing.closedPoint ↥W → uX ζ' = IsLocalRing.closedPoint ↥W → ζ ≠ x → ζ' ≠ x → ζ = ζ' :=
by
  intro Ω _ W X uX x hux hxcl hU ζ ζ' hζ hζ' huζ huζ' hζx hζ'x
  obtain ⟨U, hxU, hsm⟩ := hU

  have c1 : ∀ (Y : Scheme.{u}) (w : Y), IsDomain (Y.presheaf.stalk w) →
      ringKrullDim (Y.presheaf.stalk w) ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ y y' : Y, y ⤳ w → y' ⤳ w → y ≠ w → y' ≠ w → y = y' := by
    intro Y w hdom hdim y y' hy hy' hyw hy'w
    haveI := hdom
    haveI : Ring.KrullDimLE 1 (Y.presheaf.stalk w) := Ring.krullDimLE_iff.mpr hdim
    have key : ∀ z : Y, z ⤳ w → z ≠ w → ∃ p : PrimeSpectrum (Y.presheaf.stalk w),
        p.asIdeal = ⊥ ∧ Y.fromSpecStalk w p = z := by
      intro z hz hzw
      have hz' : z ∈ Set.range (Y.fromSpecStalk w) := by
        rw [Scheme.range_fromSpecStalk]; exact hz
      obtain ⟨p, rfl⟩ := hz'
      refine ⟨p, ?_, rfl⟩
      have hnm : ¬ p.asIdeal.IsMaximal := by
        intro hmax
        apply hzw
        have hp : p = IsLocalRing.closedPoint (Y.presheaf.stalk w) :=
          PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
        rw [hp, Scheme.fromSpecStalk_closedPoint]
      have hmin : p.asIdeal ∈ minimalPrimes (Y.presheaf.stalk w) :=
        (Ring.krullDimLE_one_iff.mp inferInstance p.asIdeal p.isPrime).resolve_right hnm
      rw [IsDomain.minimalPrimes_eq_singleton_bot] at hmin
      exact hmin
    obtain ⟨p, hp, rfl⟩ := key y hy hyw
    obtain ⟨p', hp', rfl⟩ := key y' hy' hy'w
    rw [PrimeSpectrum.ext (hp.trans hp'.symm)]

  have c2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u}) (g : Z ⟶ Spec (.of R)),
      Topology.IsEmbedding ⇑(Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) ∧
      ∀ z : Z, g z = IsLocalRing.closedPoint R → z ∈ Set.range ⇑(Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) := by
    intro R _ _ Z g
    haveI : IsClosedImmersion
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) :=
      IsClosedImmersion.spec_of_surjective _ (by
        rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective)
    haveI : IsClosedImmersion (Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) :=
      inferInstance
    refine ⟨(Scheme.Hom.isClosedEmbedding _).isEmbedding, ?_⟩
    intro z hz
    rw [Scheme.Pullback.range_fst, Set.mem_preimage, hz]
    refine ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField R), ?_⟩
    show PrimeSpectrum.comap (IsLocalRing.residue R)
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField R)) = IsLocalRing.closedPoint R
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue R)

  have eU : Topology.IsEmbedding ⇑U.ι := U.ι.isOpenEmbedding.isEmbedding
  have mem : ∀ y : X, y ∈ U → ∃ yU : U.toScheme, U.ι yU = y := by
    intro y hy
    have : y ∈ Set.range ⇑U.ι := by rw [Scheme.Opens.range_ι]; exact hy
    exact this
  obtain ⟨xU, hxU'⟩ := mem x hxU
  obtain ⟨ζU, hζU'⟩ := mem ζ (hζ.mem_open U.isOpen hxU)
  obtain ⟨ζ'U, hζ'U'⟩ := mem ζ' (hζ'.mem_open U.isOpen hxU)
  have hsζ : ζU ⤳ xU := eU.isInducing.specializes_iff.mp (by rw [hζU', hxU']; exact hζ)
  have hsζ' : ζ'U ⤳ xU := eU.isInducing.specializes_iff.mp (by rw [hζ'U', hxU']; exact hζ')
  have hneζ : ζU ≠ xU := fun h => hζx (by rw [← hζU', ← hxU', h])
  have hneζ' : ζ'U ≠ xU := fun h => hζ'x (by rw [← hζ'U', ← hxU', h])
  have spx : (U.ι ≫ uX) xU = IsLocalRing.closedPoint ↥W := by
    rw [Scheme.Hom.comp_apply, hxU']; exact hux
  have spζ : (U.ι ≫ uX) ζU = IsLocalRing.closedPoint ↥W := by
    rw [Scheme.Hom.comp_apply, hζU']; exact huζ
  have spζ' : (U.ι ≫ uX) ζ'U = IsLocalRing.closedPoint ↥W := by
    rw [Scheme.Hom.comp_apply, hζ'U']; exact huζ'
  have hxUcl : IsClosed ({xU} : Set U.toScheme) := by
    have e : ({xU} : Set U.toScheme) = ⇑U.ι ⁻¹' {x} := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hxU'
      · intro h; exact eU.injective (h.trans hxU'.symm)
    rw [e]; exact hxcl.preimage U.ι.continuous

  obtain ⟨hf, hrange⟩ := c2 ↥W U.toScheme (U.ι ≫ uX)
  obtain ⟨w, hw⟩ := hrange xU spx
  obtain ⟨wζ, hwζ⟩ := hrange ζU spζ
  obtain ⟨wζ', hwζ'⟩ := hrange ζ'U spζ'
  haveI hπ : SmoothOfRelativeDimension 1 (Limits.pullback.snd (U.ι ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback _ _) hsm
  have hwcl : IsClosed ({w} : Set ↥(Limits.pullback (U.ι ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) := by
    have e : ({w} : Set ↥(Limits.pullback (U.ι ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) =
        ⇑(Limits.pullback.fst (U.ι ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹'
          {xU} := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hw
      · intro h; exact hf.injective (h.trans hw.symm)
    rw [e]; exact hxUcl.preimage (Scheme.Hom.continuous _)
  have hdom := wcpa_smooth_stalk_isDomain (IsLocalRing.ResidueField ↥W) _ (Limits.pullback.snd (U.ι ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) 1 w
  have hdim := wc_lfi_smooth_stalk_dim (IsLocalRing.ResidueField ↥W) _ (Limits.pullback.snd (U.ι ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) 1 w hwcl
  have h1 : wζ ⤳ w := hf.isInducing.specializes_iff.mp (by rw [hwζ, hw]; exact hsζ)
  have h2 : wζ' ⤳ w := hf.isInducing.specializes_iff.mp (by rw [hwζ', hw]; exact hsζ')
  have h3 : wζ ≠ w := fun h => hneζ (by rw [← hwζ, ← hw, h])
  have h4 : wζ' ≠ w := fun h => hneζ' (by rw [← hwζ', ← hw, h])
  have heq := c1 _ w hdom hdim.le wζ wζ' h1 h2 h3 h4
  rw [← hζU', ← hζ'U', ← hwζ, ← hwζ', heq]

theorem wcpa_dj_lr1k_ebc_dsc_isolate : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) [LocallyOfFiniteType uX] (x ξ : X) (hξx : ξ ⤳ x), uX x = IsLocalRing.closedPoint ↥W → IsClosed ({x} : Set X) → (∀ ζ : X, ζ ⤳ x → uX ζ = IsLocalRing.closedPoint ↥W → ζ ≠ x → ζ = ξ) → ∀ s : X.presheaf.stalk x, s ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) → IsUnit ((X.presheaf.stalkSpecializes hξx).hom s) → ∃ (U : X.Opens) (hU : IsAffineOpen U) (hxU : x ∈ U) (s₀ : Γ(X, U)), (X.presheaf.germ U x hxU).hom s₀ = s ∧ (wcCnSigma uX U).FiniteType ∧ (∀ c ∈ IsLocalRing.maximalIdeal ↥W, wcCnSigma uX U c ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) ∧ s₀ ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal ∧ ∃ g : Γ(X, U), g ∉ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal ∧ ∀ Q : Ideal Γ(X, U), Q.IsPrime → (∀ c ∈ IsLocalRing.maximalIdeal ↥W, wcCnSigma uX U c ∈ Q) → s₀ ∈ Q → g ∉ Q → Q = (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
by
  have t_avoid : ∀ (B : Type u) [CommRing B] (J P : Ideal B) (hP : P.IsMaximal) (hN : IsNoetherianRing (B ⧸ J)) (hloc : ∀ Q : Ideal B, Q.IsPrime → J ≤ Q → Q ≤ P → Q = P), ∃ g : B, g ∉ P ∧ ∀ Q : Ideal B, Q.IsPrime → J ≤ Q → g ∉ Q → Q = P := by
    intro B _ J P hP hN hloc
    classical
    have hfin : J.minimalPrimes.Finite := by
      rw [Ideal.minimalPrimes_eq_comap]
      exact (minimalPrimes.finite_of_isNoetherianRing (B ⧸ J)).image _
    set S := {Q' ∈ J.minimalPrimes | ¬ Q' ≤ P} with hS
    have hSfin : S.Finite := hfin.subset (fun _ h => h.1)
    have hf : ∀ Q' : Ideal B, ∃ f : B, Q' ∈ S → f ∈ Q' ∧ f ∉ P := by
      intro Q'
      by_cases h : Q' ∈ S
      · obtain ⟨f, hf1, hf2⟩ := SetLike.not_le_iff_exists.mp h.2
        exact ⟨f, fun _ => ⟨hf1, hf2⟩⟩
      · exact ⟨1, fun h' => absurd h' h⟩
    choose f hf using hf
    refine ⟨∏ Q' ∈ hSfin.toFinset, f Q', ?_, ?_⟩
    · intro hmem
      obtain ⟨Q', hQ', hfQ'⟩ := (hP.isPrime.prod_mem_iff).mp hmem
      exact (hf Q' (hSfin.mem_toFinset.mp hQ')).2 hfQ'
    · intro Q hQ hJQ hgQ
      obtain ⟨Q', hQ'min, hQ'Q⟩ := Ideal.exists_minimalPrimes_le hJQ
      by_cases hQ'P : Q' ≤ P
      · have e := hloc Q' hQ'min.1.1 hQ'min.1.2 hQ'P
        have hPQ : P ≤ Q := e ▸ hQ'Q
        exact (hP.eq_of_le hQ.ne_top hPQ).symm
      · exfalso
        apply hgQ
        have hmemS : Q' ∈ S := ⟨hQ'min, hQ'P⟩
        apply hQ'Q
        exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem f (hSfin.mem_toFinset.mpr hmemS))
          (hf Q' hmemS).1
  have t_noeth : ∀ (R B : Type u) [CommRing R] [IsLocalRing R] [CommRing B] (σ : R →+* B) (J : Ideal B) (hσ : σ.FiniteType) (hJ : ∀ c ∈ IsLocalRing.maximalIdeal R, σ c ∈ J), IsNoetherianRing (B ⧸ J) := by
    intro R B _ _ _ σ J hσ hJ
    let τ : R →+* B ⧸ J := (Ideal.Quotient.mk J).comp σ
    have hτ : τ.FiniteType :=
      RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective) hσ
    have hker : ∀ c ∈ IsLocalRing.maximalIdeal R, τ c = 0 := fun c hc =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (hJ c hc)
    let τb : R ⧸ IsLocalRing.maximalIdeal R →+* B ⧸ J :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) τ hker
    have hcomp : τb.comp (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)) = τ :=
      RingHom.ext fun c => by simp only [RingHom.comp_apply, τb, Ideal.Quotient.lift_mk]
    have hτb : τb.FiniteType :=
      RingHom.FiniteType.of_comp_finiteType (f := Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))
        (by rw [hcomp]; exact hτ)
    letI : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
    letI := τb.toAlgebra
    haveI : Algebra.FiniteType (R ⧸ IsLocalRing.maximalIdeal R) (B ⧸ J) := hτb
    exact Algebra.FiniteType.isNoetherianRing (R ⧸ IsLocalRing.maximalIdeal R) (B ⧸ J)
  have t_sigma_eq : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) (U : X.Opens), wcCnSigma uX U = (uX.appLE ⊤ U (fun _ _ => trivial)).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom := by
    intro R _ X uX U
    exact rfl
  have t_fintype : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) [LocallyOfFiniteType uX] (U : X.Opens) (hU : IsAffineOpen U), (wcCnSigma uX U).FiniteType := by
    intro R _ X uX _ U hU
    rw [t_sigma_eq]
    refine RingHom.FiniteType.comp ?_ ?_
    · exact HasRingHomProperty.appLE @LocallyOfFiniteType uX inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ _
    · exact RingHom.FiniteType.of_surjective _ (fun y =>
        ⟨(Scheme.ΓSpecIso (.of R)).hom.hom y, by
          rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]⟩)
  have t_point : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) (U : X.Opens) (hU : IsAffineOpen U) (Q : PrimeSpectrum Γ(X, U)), uX (hU.fromSpec Q) = PrimeSpectrum.comap (wcCnSigma uX U) Q := by
    intro R _ X uX U hU Q
    have h := IsAffineOpen.SpecMap_appLE_fromSpec uX (isAffineOpen_top (Spec (.of R))) hU
      (fun _ _ => trivial)
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at h
    rw [show uX (hU.fromSpec Q) = (hU.fromSpec ≫ uX) Q from rfl, ← h, t_sigma_eq]
    rfl
  have t_special : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) (U : X.Opens) (hU : IsAffineOpen U) (Q : PrimeSpectrum Γ(X, U)), uX (hU.fromSpec Q) = IsLocalRing.closedPoint R ↔ ∀ c ∈ IsLocalRing.maximalIdeal R, wcCnSigma uX U c ∈ Q.asIdeal := by
    intro R _ _ X uX U hU Q
    rw [t_point]
    constructor
    · intro h c hc
      have e : (PrimeSpectrum.comap (wcCnSigma uX U) Q).asIdeal = IsLocalRing.maximalIdeal R := by
        rw [h]; rfl
      rw [PrimeSpectrum.comap_asIdeal] at e
      have : c ∈ Ideal.comap (wcCnSigma uX U) Q.asIdeal := e ▸ hc
      exact this
    · intro h
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      show _ = IsLocalRing.maximalIdeal R
      exact le_antisymm (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.comap _).ne_top)
        (fun c hc => h c hc)
  have t_local : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u}) (uX : X ⟶ Spec (.of R)) (x ξ : X) (hξx : ξ ⤳ x) (huniq : ∀ ζ : X, ζ ⤳ x → uX ζ = IsLocalRing.closedPoint R → ζ ≠ x → ζ = ξ) (U : X.Opens) (hU : IsAffineOpen U) (hxU : x ∈ U) (s₀ : Γ(X, U)) (hunit : IsUnit ((X.presheaf.stalkSpecializes hξx).hom ((X.presheaf.germ U x hxU).hom s₀))) (Q : PrimeSpectrum Γ(X, U)) (hQsp : uX (hU.fromSpec Q) = IsLocalRing.closedPoint R) (hs₀ : s₀ ∈ Q.asIdeal) (hle : Q ≤ hU.primeIdealOf ⟨x, hxU⟩), Q = hU.primeIdealOf ⟨x, hxU⟩ := by
    intro R _ _ X uX x ξ hξx huniq U hU hxU s₀ hunit Q hQsp hs₀ hle
    have hinj : Function.Injective hU.fromSpec := hU.fromSpec.isOpenEmbedding.injective
    have hPx : hU.fromSpec (hU.primeIdealOf ⟨x, hxU⟩) = x := hU.fromSpec_primeIdealOf ⟨x, hxU⟩
    have hzx : hU.fromSpec Q ⤳ x := by
      rw [← hPx]
      exact ((PrimeSpectrum.le_iff_specializes _ _).mp hle).map hU.fromSpec.continuous
    by_cases hz : hU.fromSpec Q = x
    · exact hinj (hz.trans hPx.symm)
    · exfalso
      have hzξ := huniq _ hzx hQsp hz
      have hzU : hU.fromSpec Q ∈ U := by
        show hU.fromSpec Q ∈ (U : Set X)
        rw [← hU.range_fromSpec]; exact ⟨Q, rfl⟩
      have hξU : ξ ∈ U := hzξ ▸ hzU
      have hQeq : Q = hU.primeIdealOf ⟨ξ, hξU⟩ :=
        hinj (hzξ.trans (hU.fromSpec_primeIdealOf ⟨ξ, hξU⟩).symm)
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨ξ, hξU⟩
      haveI := hU.isLocalization_stalk ⟨ξ, hξU⟩
      have hm : (X.presheaf.germ U ξ hξU).hom s₀ ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk ξ) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk ξ)
          (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal s₀).mpr
          (by rw [← hQeq]; exact hs₀)
      rw [TopCat.Presheaf.germ_stalkSpecializes_apply] at hunit
      exact (IsLocalRing.mem_maximalIdeal _).mp hm hunit
  intro Ω _ W X uX _ x ξ hξx hux hxcl huniq s hs hunit
  obtain ⟨U₁, hxU₁, s₁, hs₁⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf s
  obtain ⟨U, hUaff, hxU, hle⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hxU₁
  have hU : IsAffineOpen U := hUaff
  set s₀ : Γ(X, U) := (X.presheaf.map (homOfLE hle).op).hom s₁ with hs₀def
  have hgerm : (X.presheaf.germ U x hxU).hom s₀ = s := by
    rw [hs₀def, TopCat.Presheaf.germ_res_apply]; exact hs₁
  set P := (hU.primeIdealOf ⟨x, hxU⟩).asIdeal with hPdef
  have hft := t_fintype ↥W X uX U hU
