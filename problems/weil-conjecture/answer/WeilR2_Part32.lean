  obtain ⟨ψ, ⟨hψf, hψl⟩, -⟩ := hf'H.2.2 R hR.1 g hgu
  haveI := hψl

  have hxy : f' (wcEbntX W b 0) * f' (wcEbntX W b 1) = σ' b := by
