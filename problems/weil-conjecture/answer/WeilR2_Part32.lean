theorem wcpa_dj_lr1k_ebcnt_glue_extension : ∀ (κ : Type u) [Field κ] (X Y : Scheme.{u}) [AlgebraicGeometry.IsReduced X] (sX : X ⟶ Spec (.of κ)) (sY : Y ⟶ Spec (.of κ)) [IsSeparated sY] (W : X.Opens), Dense (W : Set ↥X) → ∀ (g : W.toScheme ⟶ Y), g ≫ sY = W.ι ≫ sX → (∀ p : ↥X, ∃ (V : X.Opens), p ∈ V ∧ ∃ h : V.toScheme ⟶ Y, h ≫ sY = V.ι ≫ sX ∧ X.homOfLE (inf_le_left : V ⊓ W ≤ V) ≫ h = X.homOfLE (inf_le_right : V ⊓ W ≤ W) ≫ g) → ∃ G : X ⟶ Y, W.ι ≫ G = g ∧ G ≫ sY = sX :=
by
  intro κ _ X Y _ sX sY _ W hW g hg hloc
  classical
  have agree : ∀ (A B : X.Opens) (a : A.toScheme ⟶ Y) (b : B.toScheme ⟶ Y),
      a ≫ sY = A.ι ≫ sX → b ≫ sY = B.ι ≫ sX →
      X.homOfLE (inf_le_left : A ⊓ W ≤ A) ≫ a = X.homOfLE (inf_le_right : A ⊓ W ≤ W) ≫ g →
      X.homOfLE (inf_le_left : B ⊓ W ≤ B) ≫ b = X.homOfLE (inf_le_right : B ⊓ W ≤ W) ≫ g →
      X.homOfLE (inf_le_left : A ⊓ B ≤ A) ≫ a = X.homOfLE (inf_le_right : A ⊓ B ≤ B) ≫ b := by
    intro A B a b ha hb haW hbW
    have hj : A ⊓ B ⊓ W ≤ A ⊓ B := inf_le_left
    have : IsDominant (X.homOfLE hj) := by
      refine IsDominant.mk ?_
      have hd : Dense ((A ⊓ B).ι ⁻¹' (W : Set X)) :=
        hW.preimage (A ⊓ B).ι.isOpenEmbedding.isOpenMap
      refine hd.mono ?_
      intro x hx
      have hx' : x.1 ∈ W := hx
      refine ⟨⟨x.1, TopologicalSpace.Opens.mem_inf.mpr ⟨x.2, hx'⟩⟩, ?_⟩
      apply Subtype.ext
      simp [Scheme.homOfLE_apply]
    refine ext_of_isDominant_of_isSeparated sY ?_ (X.homOfLE hj) ?_
    · simp only [Category.assoc, ha, hb, Scheme.homOfLE_ι_assoc]
    · have e1 : A ⊓ B ⊓ W ≤ A ⊓ W := fun x hx => ⟨hx.1.1, hx.2⟩
      have e2 : A ⊓ B ⊓ W ≤ B ⊓ W := fun x hx => ⟨hx.1.2, hx.2⟩
      calc X.homOfLE hj ≫ X.homOfLE inf_le_left ≫ a
            = X.homOfLE e1 ≫ X.homOfLE (inf_le_left : A ⊓ W ≤ A) ≫ a := by
              simp only [Scheme.homOfLE_homOfLE_assoc]
        _ = X.homOfLE e1 ≫ X.homOfLE (inf_le_right : A ⊓ W ≤ W) ≫ g := by rw [haW]
        _ = X.homOfLE e2 ≫ X.homOfLE (inf_le_right : B ⊓ W ≤ W) ≫ g := by
              simp only [Scheme.homOfLE_homOfLE_assoc]
        _ = X.homOfLE e2 ≫ X.homOfLE (inf_le_left : B ⊓ W ≤ B) ≫ b := by rw [hbW]
        _ = X.homOfLE hj ≫ X.homOfLE inf_le_right ≫ b := by
              simp only [Scheme.homOfLE_homOfLE_assoc]
  choose V hpV h hhs hhg using hloc
  let U : Option X → X.Opens := fun i => Option.rec (motive := fun _ => X.Opens) W V i
  let k : ∀ i, (U i).toScheme ⟶ Y := fun i =>
    Option.rec (motive := fun i => (U i).toScheme ⟶ Y) g h i
  have hP : ∀ i, k i ≫ sY = (U i).ι ≫ sX ∧
      X.homOfLE (inf_le_left : U i ⊓ W ≤ U i) ≫ k i =
        X.homOfLE (inf_le_right : U i ⊓ W ≤ W) ≫ g := by
    intro i
    cases i with
    | none => exact ⟨hg, rfl⟩
    | some p => exact ⟨hhs p, hhg p⟩
  have hsup : iSup U = ⊤ := by
    rw [eq_top_iff]
    intro x _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨some x, hpV x⟩
  let 𝒰 := X.openCoverOfIsOpenCover U (TopologicalSpace.IsOpenCover.mk hsup)
  have hf0 : ∀ i j : Option X, Limits.pullback.fst (U i).ι (U j).ι ≫ k i =
      Limits.pullback.snd (U i).ι (U j).ι ≫ k j := by
    intro i j
    have hpb := isPullback_opens_inf (U i) (U j)
    have e := agree (U i) (U j) (k i) (k j) (hP i).1 (hP j).1 (hP i).2 (hP j).2
    rw [← hpb.isoPullback_inv_fst, ← hpb.isoPullback_inv_snd, Category.assoc,
      Category.assoc, e]
  have hf : ∀ i j : 𝒰.I₀, Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ k i =
      Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ k j := hf0
  refine ⟨𝒰.glueMorphisms k hf, ?_, ?_⟩
  · exact 𝒰.ι_glueMorphisms k hf none
  · refine 𝒰.hom_ext _ _ (fun (i : Option X) => ?_)
    rw [reassoc_of% (𝒰.ι_glueMorphisms k hf i)]
    exact (hP i).1

theorem wcpa_dj_lr1k_ebcnt_open_sub_props : ∀ (X : Scheme.{u}) (T : X.Opens), (∀ x : X, IsDomain (X.presheaf.stalk x)) → (∀ D ∈ irreducibleComponents ↥X, IsOpen D) → (∀ x : T.toScheme, IsDomain (T.toScheme.presheaf.stalk x)) ∧ (∀ D ∈ irreducibleComponents ↥T.toScheme, IsOpen D) ∧ ∀ x : T.toScheme, (∀ a b : ↥(X.presheaf.stalk (T.ι x)), a ∣ b ∨ b ∣ a) → ∀ a b : ↥(T.toScheme.presheaf.stalk x), a ∣ b ∨ b ∣ a :=
by
  intro X T hdom hop
  refine ⟨?_, ?_, ?_⟩
  · intro x
    haveI := hdom (T.ι x)
    let e : X.presheaf.stalk (T.ι x) ≃+* T.toScheme.presheaf.stalk x :=
      (asIso (T.ι.stalkMap x)).commRingCatIsoToRingEquiv
    exact MulEquiv.isDomain (X.presheaf.stalk (T.ι x)) e.symm.toMulEquiv
  · intro C hC
    have hCi : IsIrreducible C := hC.1
    have hfc : Continuous (T.ι : T.toScheme → X) := T.ι.continuous
    have hI : IsIrreducible ((T.ι : T.toScheme → X) '' C) := hCi.image _ hfc.continuousOn
    obtain ⟨D, hD, hCD⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _ hI
    obtain ⟨c, hc⟩ := hCi.nonempty
    have hpre : IsIrreducible ((T.ι : T.toScheme → X) ⁻¹' D) :=
      (hD.1 : IsIrreducible D).preimage T.ι.isOpenEmbedding ⟨T.ι c, hCD ⟨c, hc, rfl⟩, c, rfl⟩
    have hsub : C ⊆ (T.ι : T.toScheme → X) ⁻¹' D := Set.image_subset_iff.mp hCD
    have heq : C = (T.ι : T.toScheme → X) ⁻¹' D := hC.eq_of_subset hpre hsub
    rw [heq]
    exact (hop D hD).preimage hfc
  · intro x hv a b
    let e : X.presheaf.stalk (T.ι x) ≃+* T.toScheme.presheaf.stalk x :=
      (asIso (T.ι.stalkMap x)).commRingCatIsoToRingEquiv
    rcases hv (e.symm a) (e.symm b) with h | h
    · left
      have := map_dvd e h
      simpa only [RingEquiv.apply_symm_apply] using this
    · right
      have := map_dvd e h
      simpa only [RingEquiv.apply_symm_apply] using this

theorem wcpa_dj_lr1k_ebcn_normdatum_transport : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (Z₁ Z₂ Zt₁ Zt₂ : Scheme.{u}) (s₁ : Z₁ ⟶ Spec (.of κ)) (s₂ : Z₂ ⟶ Spec (.of κ)) (ν₁ : Zt₁ ⟶ Z₁) (ν₂ : Zt₂ ⟶ Z₂) (c₁ c₂ : ℤ), wcGcNormDatum ν₁ → wcGcNormDatum ν₂ → wcGcChi κ (ν₁ ≫ s₁) c₁ → wcGcChi κ (ν₂ ≫ s₂) c₂ → ∀ (O₁ : Z₁.Opens) (O₂ : Z₂.Opens), Dense (O₁ : Set ↥Z₁) → ∀ (θ : O₁.toScheme ⟶ O₂.toScheme), IsIso θ → θ ≫ O₂.ι ≫ s₂ = O₁.ι ≫ s₁ → ∃ T : Zt₂.Opens, (T : Set ↥Zt₂) = closure ((ν₂ ⁻¹ᵁ O₂ : Zt₂.Opens) : Set ↥Zt₂) ∧ ∃ φ : Zt₁ ⟶ T.toScheme, IsIso φ ∧ φ ≫ T.ι ≫ ν₂ ≫ s₂ = ν₁ ≫ s₁ :=
