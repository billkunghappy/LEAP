theorem wcpa_dj_lr1k_ll_gc_sj_skyscraper_count : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ]
    (Z : Scheme.{u}) {N : ℕ} (j : Z ⟶ wcProjK κ N), IsClosedImmersion j →
    AlgebraicGeometry.IsReduced Z → topologicalKrullDim ↥Z ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (Zt : Scheme.{u}) (ν : Zt ⟶ Z), wcGcNormDatum ν → ∀ e : ℕ,
    wcGcSjQRk j ν e = ⨆ t : Finset ↥Z, ∑ z ∈ t, wcpaDjLkDelta (Z.presheaf.stalk z) :=
by
  classical
  intro κ _ _ Z N j hj hred hdim Zt ν hν e
  have hν' := hν
  obtain ⟨_, _, U, hUd, _, hiso⟩ := hν'
  haveI := hred
  haveI := hiso

  have hinj : ∀ V : Z.Opens, Function.Injective (ν.app V) := by
    intro V
    rw [injective_iff_map_eq_zero (ν.app V).hom]
    intro s hs
    rw [← basicOpen_eq_bot_iff]
    by_contra hne
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    obtain ⟨x', hx'B, hx'U⟩ := hUd.inter_open_nonempty _ (Z.basicOpen s).isOpen ⟨x, hx⟩
    obtain ⟨y, hy⟩ := (ν ∣_ U).surjective ⟨x', hx'U⟩
    have h1 := morphismRestrict_base_coe ν U y
    rw [hy] at h1
    have hmem : y.1 ∈ ν ⁻¹ᵁ (Z.basicOpen s) := by
      apply (Scheme.Hom.mem_preimage ν).mpr
      rw [← h1]
      exact hx'B
    rw [Scheme.preimage_basicOpen] at hmem
    have hs' : (ν.app V) s = 0 := hs
    rw [hs', Scheme.basicOpen_zero] at hmem
    exact hmem

  have hchart : ∀ a : Fin (N + 1),
      (∃ Sa : Finset Z, ∀ z : Z, z ∈ j ⁻¹ᵁ wcSgD κ N a → z ∉ Sa → ∀ V : Z.Opens,
        V ≤ j ⁻¹ᵁ wcSgD κ N a → z ∈ V → ∀ b : Γ(Zt, ν ⁻¹ᵁ V), wcGcSkTriv ν V b z) ∧
      (∀ z : Z, z ∈ j ⁻¹ᵁ wcSgD κ N a →
        wcGcSkLocRk j ν a z = wcpaDjLkDelta (Z.presheaf.stalk z)) ∧
      (∀ (S : Finset Z) (V : Z → Z.Opens) (c : ∀ z, Γ(Zt, ν ⁻¹ᵁ V z))
        (hV : ∀ z, V z ≤ j ⁻¹ᵁ wcSgD κ N a), (∀ z ∈ S, z ∈ V z) →
        ∃ b : Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a), ∀ z ∈ S,
          wcGcSkTriv ν (V z) (Zt.presheaf.map (homOfLE (ν.preimage_mono (hV z))).op b - c z) z) := by
    intro a
    obtain ⟨hAred, hAnoeth, hAdim, hAft, hψfin, hψinj, hBiso⟩ :=
      wcpa_dj_lr1k_ll_gc_sk_chart_normalization κ Z j hj hred hdim Zt ν hν a
    letI iκA : Algebra κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := (wcEszScal j (j ⁻¹ᵁ wcSgD κ N a)).toAlgebra
    letI iAB : Algebra Γ(Z, j ⁻¹ᵁ wcSgD κ N a) Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a) :=
