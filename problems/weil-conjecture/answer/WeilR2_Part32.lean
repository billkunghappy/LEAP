          RingHom.id_apply, hφC]
      rw [hcomp, Ideal.mk_ker]
    · have hmem : (Polynomial.X - Polynomial.C a0 : (Polynomial A)) ∈ Q.comap (algebraMap (Polynomial A) B) := by
        rw [hQ', RingHom.mem_ker]
        simp [φ]
      rw [Ideal.mem_comap] at hmem
      convert hmem using 1
      change θ - algebraMap A B a0 = Polynomial.aeval θ (Polynomial.X - Polynomial.C a0)
      simp

  choose Qf hQ1 hQ2 hQ3 using fun i => s4 (a i) (ha i)
  refine ⟨m, hm, fun i => Qf (Fin.cast hdeg.symm i), ?_, fun i => ⟨hQ1 _, hQ2 _⟩⟩
  intro i j hij
  by_contra hne
  have hne' : Fin.cast hdeg.symm i ≠ Fin.cast hdeg.symm j :=
    fun h => hne (Fin.cast_injective _ h)
  apply hadist _ _ hne'
  rw [← hQ2 (Fin.cast hdeg.symm i), Ideal.mem_comap]
  have h1 := hQ3 (Fin.cast hdeg.symm i)
  have h2 := hQ3 (Fin.cast hdeg.symm j)
  have hij' : Qf (Fin.cast hdeg.symm i) = Qf (Fin.cast hdeg.symm j) := hij
  rw [← hij'] at h2
  have h3 := Ideal.sub_mem _ h2 h1
  rw [map_sub]
  convert h3 using 1
  ring

theorem wcpa_dj_lr1k_llfi_galois_descent : ∀ (_hcount : ∀ (Ω A B K L : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Algebra Ω A] [Algebra.FiniteType Ω A] [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [Algebra A B] [Algebra.IsIntegral A B] [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsFractionRing B L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [IsScalarTower A B L] [FiniteDimensional K L] [Algebra.IsSeparable K L], ∃ m : Ideal A, m.IsMaximal ∧ ∃ Q : Fin (Module.finrank K L) → Ideal B, Function.Injective Q ∧ ∀ i, (Q i).IsMaximal ∧ (Q i).comap (algebraMap A B) = m) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → wcpaDjLkGalois γ → Finite {a : C ≅ C // a.hom ≫ γ = γ} ∧ ∀ V : (wcProjK Ω 1).Opens, IsAffineOpen V → ∀ s : Γ(C, γ ⁻¹ᵁ V), (∀ (a : C ≅ C) (h : a.hom ≫ γ = γ), (a.hom.appLE (γ ⁻¹ᵁ V) (γ ⁻¹ᵁ V) (by rw [← Scheme.Hom.comp_preimage, h])).hom s = s) → ∃ t : Γ(wcProjK Ω 1, V), (γ.app V).hom t = s :=
by
  classical
  intro hcount Ω _ _ C γ hcov hgal
  obtain ⟨_hproj, hsm, hirr, hfin, het⟩ := hcov
  haveI := hirr
  haveI : IsFinite γ := hfin
  haveI : SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) := hsm
  haveI : Smooth (γ ≫ wcProjKStr Ω 1) := SmoothOfRelativeDimension.smooth 1 _
  have hCst : ∀ x : C, IsDomain (C.presheaf.stalk x) ∧ IsIntegrallyClosed (C.presheaf.stalk x) :=
    fun x => wc_fntame_smooth_stalk_normal Ω C (γ ≫ wcProjKStr Ω 1) x
  haveI : ∀ x : C, IsDomain (C.presheaf.stalk x) := fun x => (hCst x).1
  haveI : ∀ x : C, _root_.IsReduced (C.presheaf.stalk x) := fun x => inferInstance
  haveI : AlgebraicGeometry.IsReduced C := isReduced_of_isReduced_stalk C
  haveI : AlgebraicGeometry.IsIntegral C := isIntegral_of_irreducibleSpace_of_isReduced C
  obtain ⟨hPint, hPnorm, -, -⟩ := wc_projK_integral_normal Ω 1
  haveI := hPint
  obtain ⟨hgen, hfd, hsep⟩ :=
    wcpa_dj_lr1k_gc_function_field_separable (wcProjK Ω 1) C γ hfin het
  letI : Algebra (wcProjK Ω 1).functionField C.functionField :=
    ((wcProjK Ω 1).presheaf.stalkSpecializes hgen ≫ γ.stalkMap (genericPoint C)).hom.toAlgebra
  haveI := hfd

  have hcompat : ∀ (V : (wcProjK Ω 1).Opens) (hη : genericPoint (wcProjK Ω 1) ∈ V)
      (hV' : genericPoint C ∈ γ ⁻¹ᵁ V),
      (wcProjK Ω 1).presheaf.germ V _ hη ≫ (wcProjK Ω 1).presheaf.stalkSpecializes hgen ≫
        γ.stalkMap (genericPoint C) = γ.app V ≫ C.presheaf.germ (γ ⁻¹ᵁ V) _ hV' := by
    intro V hη hV'
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap]

  have hfix : ∀ a : {a : C ≅ C // a.hom ≫ γ = γ}, a.1.hom (genericPoint C) = genericPoint C := by
    intro a
    have hsurj : Function.Surjective a.1.hom := fun x =>
      ⟨a.1.inv x, by rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl⟩
    have h1 := (genericPoint_spec C).image a.1.hom.continuous
    rw [Set.image_univ_of_surjective hsurj, closure_univ] at h1
    exact h1.eq (genericPoint_spec C)
  have key : ∀ (f g : C ⟶ wcProjK Ω 1) (_ : f = g) (U : (wcProjK Ω 1).Opens) (W : C.Opens)
      (e : W ≤ f ⁻¹ᵁ U) (e' : W ≤ g ⁻¹ᵁ U), f.appLE U W e = g.appLE U W e' := by
    rintro f g rfl U W e e'
    rfl

  have hequiv : ∀ (a : {a : C ≅ C // a.hom ≫ γ = γ}) (V : (wcProjK Ω 1).Opens)
      (hV' : genericPoint C ∈ γ ⁻¹ᵁ V),
      a.1.hom.appLE (γ ⁻¹ᵁ V) (γ ⁻¹ᵁ V) (by rw [← Scheme.Hom.comp_preimage, a.2]) ≫
        C.presheaf.germ (γ ⁻¹ᵁ V) _ hV' =
      C.presheaf.germ (γ ⁻¹ᵁ V) _ hV' ≫
        C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
          a.1.hom.stalkMap (genericPoint C) := by
    intro a V hV'
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap]
    unfold Scheme.Hom.appLE
    rw [Category.assoc, TopCat.Presheaf.germ_res]
  have happ : ∀ (a : {a : C ≅ C // a.hom ≫ γ = γ}) (U : (wcProjK Ω 1).Opens),
      γ.app U ≫ a.1.hom.appLE (γ ⁻¹ᵁ U) (γ ⁻¹ᵁ U) (by rw [← Scheme.Hom.comp_preimage, a.2]) =
        γ.app U := by
    intro a U
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
