          ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)) * sX ∧
      (∀ a : Γ(X'', Xs), a ∈ Subring.closure (Set.range (r''.appLE O Xs hXs).hom ∪ {sX})) ∧
      (∀ x : X'', x ∈ r'' ⁻¹ᵁ O → (r'' ≫ u₁) x ≠ IsLocalRing.closedPoint ↥W → x ∈ Xs) ∧
      (∀ w : ↥(Limits.pullback (r'' ≫ u₁)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        Limits.pullback.fst (r'' ≫ u₁)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w ∈ Xs →
