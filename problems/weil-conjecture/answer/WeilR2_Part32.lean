    have hsepbar : (P.map (Ideal.Quotient.mk m)).Separable := by
      show IsCoprime _ _
      refine ⟨Polynomial.C (Ideal.Quotient.mk m D)⁻¹ * u.map (Ideal.Quotient.mk m),
        Polynomial.C (Ideal.Quotient.mk m D)⁻¹ * v.map (Ideal.Quotient.mk m), ?_⟩
      have h := congrArg (Polynomial.map (Ideal.Quotient.mk m)) huv
