          ((((AlgHom.id κ _).comp _).comp _).commutes a).symm
      · apply AlgHom.ext
        intro d
        simp [Φ, Ψ, g, hP, gD_apply, gQ_apply, hD'_apply] <;> rfl
    · apply Algebra.TensorProduct.ext
      · exact AlgHom.ext fun a => (((Φ.comp Ψ).comp _).comp _).commutes a |>.trans
          ((((AlgHom.id κ _).comp _).comp _).commutes a).symm
      · apply AlgHom.ext
        intro q
        simp [Φ, Ψ, g, hP, gD_apply, gQ_apply, hT_apply] <;> rfl
  let E1 := AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ

  have hD0 : Algebra.Etale κ (TensorProduct (Polynomial R) κ D) :=
    Algebra.Etale.baseChange (Polynomial R) D κ
  obtain ⟨r, ⟨e₀⟩⟩ := c1 _ hD0
  obtain ⟨E4⟩ := c3 (Polynomial κ) r k
  let E2 := Algebra.TensorProduct.congr e₀ ψ
  let E3 : TensorProduct κ (Fin r → κ) (Fin k → Polynomial κ) ≃ₐ[κ]
      (Fin r → Fin k → Polynomial κ) :=
    (Algebra.TensorProduct.comm κ (Fin r → κ) (Fin k → Polynomial κ)).trans
      ((Algebra.TensorProduct.piRight κ κ (Fin k → Polynomial κ) (fun _ : Fin r => κ)).trans
