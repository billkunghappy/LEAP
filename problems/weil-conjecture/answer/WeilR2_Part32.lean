    rw [hcomp]
    show c ω⁻¹ * c ω = 1
    rw [← map_mul, inv_mul_cancel₀ hω0, map_one]
  · rw [← show φ (σ ⟨ω, hω⟩) = c ω from hcomp _]
    exact memV _ (hφS _)
  · have hqAm : (q.map σ).map (IsLocalRing.residue A) ≠ 0 := by
      obtain ⟨i, hi⟩ := hq
      intro h0
      have h1 := congrArg (fun r => r.coeff i) h0
