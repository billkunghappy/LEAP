        (∀ ℓ : ↑C.functionField, IsIntegral ↑Γ(X, V) ℓ →
          ∃ d : Γ(C, f ⁻¹ᵁ V), (C.presheaf.germ (f ⁻¹ᵁ V) (genericPoint C) hgen).hom d = ℓ) →
        ∃ ys : Ideal ↥(integralClosure ↑Γ(X, V) ↑C.functionField), ys.IsPrime ∧
          ys.comap (algebraMap ↑Γ(X, V) ↥(integralClosure ↑Γ(X, V) ↑C.functionField)) = 𝔭 ∧
          ∀ (a : C ⟶ C), a ≫ f = f → ∀ (ha : a (genericPoint C) = genericPoint C),
