        rw [smul_smul, ← pow_add, add_comm]
      have h2 : a ^ (N₁ + N₂) • z₂ = a ^ N₁ • (a ^ N₂ • z₂) := by
        rw [smul_smul, ← pow_add]
      rw [smul_add, h1, h2, e₁, e₂, TensorProduct.add_tmul, TensorProduct.smul_tmul',
        TensorProduct.smul_tmul']

  have s2 : ∀ (N : ℕ) (q : Q), a ^ N • q = 0 → q = 0 := by
    intro N
    induction N with
    | zero => intro q h; rwa [pow_zero, one_smul] at h
    | succ n ih =>
      intro q h
      rw [pow_succ', mul_smul] at h
      exact ih q (hT _ h)

  have s3 : ∀ (N : ℕ) (z : TensorProduct A D Q), a ^ N • z = 0 → z = 0 := by
    intro N z hz
    have hinj : Function.Injective (LinearMap.lsmul A Q (a ^ N)) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro q hq
      exact s2 N q (by simpa using hq)
    have hl := Module.Flat.lTensor_preserves_injective_linearMap (M := D) _ hinj
    have heq : ∀ w : TensorProduct A D Q,
        (LinearMap.lsmul A Q (a ^ N)).lTensor D w = a ^ N • w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul d q => simp [LinearMap.lTensor_tmul, TensorProduct.tmul_smul]
      | add x y hx hy => rw [map_add, hx, hy, smul_add]
    apply hl
    rw [heq, hz, map_zero]

  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨N, d, hd⟩ := s1 z
  have h1 : fD d = 0 := by
    have : Algebra.TensorProduct.productMap fD fQ (a ^ N • z) = fD d := by
      rw [hd, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
    rw [← this, map_smul, hz, smul_zero]
  have h2 : d = 0 := hfD (h1.trans (map_zero fD).symm)
  rw [h2, TensorProduct.zero_tmul] at hd
  exact s3 N z hd

theorem wcpa_dj_lr1k_odfgl_nt_away_intclosed : ∀ (k₀ Λ : Type u) [CommRing k₀] [CommRing Λ] [IsDomain Λ] [Algebra k₀ Λ] (S R : Subalgebra k₀ Λ), (∀ x : Λ, x ∈ R ↔ ∃ p : Polynomial Λ, p.Monic ∧ (∀ i, p.coeff i ∈ S) ∧ p.eval x = 0) → ∀ g : Λ, g ∈ R → g ≠ 0 → ∀ (z : Localization.Away g) (p : Polynomial (Localization.Away g)), p.Monic → p.eval z = 0 → (∀ i, ∃ r ∈ R, ∃ n : ℕ, p.coeff i * algebraMap Λ (Localization.Away g) g ^ n = algebraMap Λ (Localization.Away g) r) → ∃ r ∈ R, ∃ n : ℕ, z * algebraMap Λ (Localization.Away g) g ^ n = algebraMap Λ (Localization.Away g) r :=
