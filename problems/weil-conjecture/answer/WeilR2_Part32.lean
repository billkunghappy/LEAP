  haveI := hθ
  obtain ⟨A', hA'⟩ : ∃ A' : O₁.toScheme.Opens,
      (A' : Set O₁.toScheme) = O₁.ι ⁻¹' (U₁ : Set Z₁) ∩ (θ ≫ O₂.ι) ⁻¹' (U₂ : Set Z₂) :=
    ⟨O₁.ι ⁻¹ᵁ U₁ ⊓ (θ ≫ O₂.ι) ⁻¹ᵁ U₂, rfl⟩
  have hr1 : Set.range (A'.ι ≫ O₁.ι) =
