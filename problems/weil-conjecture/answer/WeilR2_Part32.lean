  let Q' : ↥(Spec (.of L)) := P'
  refine ⟨Spec.map (CommRingCat.ofHom β) Q', ?_⟩
  have h1 : Spec.map (CommRingCat.ofHom lam) Q' = q := by
    rw [Spec.map_apply]; exact hP'
  have h2 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom β)) c₁ Q'
  have h3 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom lam)) c₀ Q'
  rw [← h2, ← hf, h3, h1]

theorem wcpa_dj_lr1k_odfgl_bs_pb_open_chart : ∀ {P M A O T : Scheme.{u}} (h₂ : P ⟶ M) (sP : P ⟶ O) (r₀ : M ⟶ A) (m : O ⟶ A), IsPullback h₂ sP r₀ m → ∀ (c : T ⟶ M) [IsOpenImmersion c] (h : T ⟶ A), c ≫ r₀ = h → ∃ κ : Limits.pullback h m ⟶ P, IsOpenImmersion κ ∧ κ ≫ h₂ = Limits.pullback.fst h m ≫ c ∧ κ ≫ sP = Limits.pullback.snd h m ∧ ∀ p : ↥P, h₂ p ∈ Set.range c → p ∈ Set.range κ :=
by
  intro P M A O T h₂ sP r₀ m hP c _ h hc
  subst hc
  have w : (Limits.pullback.fst (c ≫ r₀) m ≫ c) ≫ r₀ = Limits.pullback.snd (c ≫ r₀) m ≫ m := by
    rw [Category.assoc]; exact Limits.pullback.condition
  have hκh : hP.lift _ _ w ≫ h₂ = Limits.pullback.fst (c ≫ r₀) m ≫ c := hP.lift_fst _ _ w
  have hκs : hP.lift _ _ w ≫ sP = Limits.pullback.snd (c ≫ r₀) m := hP.lift_snd _ _ w
  have outer : IsPullback (Limits.pullback.fst (c ≫ r₀) m) (hP.lift _ _ w ≫ sP) (c ≫ r₀) m := by
    rw [hκs]; exact IsPullback.of_hasPullback _ _
  have sq : IsPullback (Limits.pullback.fst (c ≫ r₀) m) (hP.lift _ _ w) c h₂ :=
    IsPullback.of_bot outer hκh.symm hP
  refine ⟨hP.lift _ _ w, MorphismProperty.of_isPullback (P := @IsOpenImmersion) sq inferInstance,
    hκh, hκs, ?_⟩
  rintro p ⟨t, ht⟩
  obtain ⟨z, _, hz⟩ := Scheme.exists_preimage_of_isPullback sq t p ht
  exact ⟨z, hz⟩

theorem wcpa_dj_lr1k_odfgl_bs_pullback_gen : ∀ (Y Z S : Scheme.{u}) [IsAffine Y] [IsAffine Z] [IsAffine S] (f : Y ⟶ S) (g : Z ⟶ S) (a : Γ(Limits.pullback f g, ⊤)), a ∈ Subring.closure (Set.range (Limits.pullback.fst f g).appTop.hom ∪ Set.range (Limits.pullback.snd f g).appTop.hom) :=
by
  intro Y Z S _ _ _ f g a
  have hPO := isPushout_appTop_of_isPullback (IsPullback.of_hasPullback f g)
  set T : Subring Γ(Limits.pullback f g, ⊤) :=
    Subring.closure (Set.range (Limits.pullback.fst f g).appTop.hom ∪
      Set.range (Limits.pullback.snd f g).appTop.hom) with hT
  have hp : ∀ x, (Limits.pullback.fst f g).appTop.hom x ∈ T :=
    fun x => Subring.subset_closure (Or.inl ⟨x, rfl⟩)
  have hq : ∀ x, (Limits.pullback.snd f g).appTop.hom x ∈ T :=
    fun x => Subring.subset_closure (Or.inr ⟨x, rfl⟩)
  let ι : CommRingCat.of T ⟶ Γ(Limits.pullback f g, ⊤) := CommRingCat.ofHom T.subtype
  let h : Γ(Y, ⊤) ⟶ CommRingCat.of T :=
    CommRingCat.ofHom ((Limits.pullback.fst f g).appTop.hom.codRestrict T hp)
  let k : Γ(Z, ⊤) ⟶ CommRingCat.of T :=
    CommRingCat.ofHom ((Limits.pullback.snd f g).appTop.hom.codRestrict T hq)
  have hhι : h ≫ ι = (Limits.pullback.fst f g).appTop := by
    ext x; rfl
  have hkι : k ≫ ι = (Limits.pullback.snd f g).appTop := by
    ext x; rfl
  have hw : f.appTop ≫ h = g.appTop ≫ k := by
    ext s
    have := congrArg (fun m => m.hom s) hPO.toCommSq.w
    simpa [h, k] using this
  let d := hPO.desc h k hw
  have hd : d ≫ ι = 𝟙 _ := by
    apply hPO.hom_ext
    · rw [← Category.assoc, hPO.inl_desc, hhι, Category.comp_id]
    · rw [← Category.assoc, hPO.inr_desc, hkι, Category.comp_id]
  have e : (d ≫ ι).hom a = a := by rw [hd]; rfl
  rw [← e]
  exact (d.hom a).2

theorem wcpa_dj_lr1k_odfgl_bs_chart_sections : ∀ (Q X Y : Scheme.{u}) (κ : Q ⟶ X) [IsOpenImmersion κ] (r : X ⟶ Y) (O : Y.Opens) (sQ : Q ⟶ O.toScheme), κ ≫ r = sQ ≫ O.ι → ∃ (hle : κ.opensRange ≤ r ⁻¹ᵁ O) (hκ : (⊤ : Q.Opens) ≤ κ ⁻¹ᵁ κ.opensRange), Function.Bijective (κ.appLE κ.opensRange ⊤ hκ).hom ∧ ∀ a : Γ(Y, O), (κ.appLE κ.opensRange ⊤ hκ).hom ((r.appLE O κ.opensRange hle).hom a) = sQ.appTop.hom (O.topIso.inv.hom a) :=
by
  intro Q X Y κ _ r O sQ h
  have hle : κ.opensRange ≤ r ⁻¹ᵁ O := by
    intro x hx
    obtain ⟨y, rfl⟩ := Scheme.Hom.mem_opensRange.mp hx
    show r (κ y) ∈ O
    rw [← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply]
    have hm : O.ι (sQ y) ∈ Set.range O.ι := ⟨_, rfl⟩
    rwa [Scheme.Opens.range_ι] at hm
  have hκ : (⊤ : Q.Opens) ≤ κ ⁻¹ᵁ κ.opensRange := κ.preimage_opensRange.ge
  refine ⟨hle, hκ, ?_, ?_⟩
  · have key : ∀ (U : X.Opens) (_ : U = κ.opensRange) (e : (⊤ : Q.Opens) ≤ κ ⁻¹ᵁ U),
        Function.Bijective (κ.appLE U ⊤ e).hom →
          Function.Bijective (κ.appLE κ.opensRange ⊤ hκ).hom := by
      rintro U rfl e hb
      exact hb
    have hb := ConcreteCategory.bijective_of_isIso (κ.appIso ⊤).hom
    rw [Scheme.Hom.appIso_hom'] at hb
    exact key _ κ.image_top_eq_opensRange _ hb
  · intro a
    have hc : ∀ (f g : Q ⟶ Y), f = g → ∀ e e', f.appLE O ⊤ e = g.appLE O ⊤ e' := by
      rintro f g rfl e e'
      rfl
    have e3 : (⊤ : O.toScheme.Opens) ≤ O.ι ⁻¹ᵁ O := O.ι_preimage_self.ge
    have e4 : (⊤ : Q.Opens) ≤ sQ ⁻¹ᵁ ⊤ := sQ.preimage_top.ge
    have hι : O.ι.appLE O ⊤ e3 = O.topIso.inv := by
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
      exact congrArg _ (Subsingleton.elim _ _)
    have hs : sQ.appLE ⊤ ⊤ e4 = sQ.appTop := by
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      rfl
    have e5 : (⊤ : Q.Opens) ≤ (sQ ≫ O.ι) ⁻¹ᵁ O := by
      rw [← h]; exact hκ.trans (κ.preimage_mono hle)
    have s4 : r.appLE O κ.opensRange hle ≫ κ.appLE κ.opensRange ⊤ hκ =
        O.topIso.inv ≫ sQ.appTop := by
      rw [Scheme.Hom.appLE_comp_appLE, hc _ _ h _ e5,
        ← Scheme.Hom.appLE_comp_appLE sQ O.ι O ⊤ ⊤ e3 e4, hι, hs]
    have := congrArg (fun φ => φ.hom a) s4
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this

theorem wcpa_dj_lr1k_odfgl_bs_schart_ring : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W) (X₁ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (O : X₁.Opens) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), IsAffineOpen O → m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = O.ι ≫ u₁ → ∀ (h₁ : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), h₁ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0))) → ∀ (X'' : Scheme.{u}) (r'' : X'' ⟶ X₁) (κ : Limits.pullback h₁ m ⟶ X'') [IsOpenImmersion κ], κ ≫ r'' = Limits.pullback.snd h₁ m ≫ O.ι → (∀ a : Γ(Limits.pullback h₁ m, ⊤), a ∈ Subring.closure (Set.range (Limits.pullback.fst h₁ m).appTop.hom ∪ Set.range (Limits.pullback.snd h₁ m).appTop.hom)) → ∀ (hXs : κ.opensRange ≤ r'' ⁻¹ᵁ O) (hκ : (⊤ : (Limits.pullback h₁ m).Opens) ≤ κ ⁻¹ᵁ κ.opensRange), Function.Bijective (κ.appLE κ.opensRange ⊤ hκ).hom → (∀ a : Γ(X₁, O), (κ.appLE κ.opensRange ⊤ hκ).hom ((r''.appLE O κ.opensRange hXs).hom a) = (Limits.pullback.snd h₁ m).appTop.hom (O.topIso.inv.hom a)) → ∃ sX : Γ(X'', κ.opensRange), IsAffineOpen κ.opensRange ∧ (r''.appLE O κ.opensRange hXs).hom (O.topIso.hom.hom (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)))) = (r''.appLE O κ.opensRange hXs).hom ((u₁.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)) * sX ∧ (∀ a : Γ(X'', κ.opensRange), a ∈ Subring.closure (Set.range (r''.appLE O κ.opensRange hXs).hom ∪ {sX})) :=
by
  intro Ω _ W c X₁ u₁ O m hO hmq h₁ hh₁ X'' r'' κ _ hκr hgenQ hXs hκ hbij hcomp
  haveI : IsAffine O.toScheme := hO

  have isoAux : ∀ {A B : CommRingCat.{u}} (e : A ≅ B) (x : A), e.inv.hom (e.hom.hom x) = x := by
    intro A B e x
    have := congrArg (fun φ => φ.hom x) e.hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id, RingHom.id_apply]
      using this

  have F1 : ∀ z, (Limits.pullback.snd h₁ m).appTop.hom (m.appTop.hom z) =
      (Limits.pullback.fst h₁ m).appTop.hom (h₁.appTop.hom z) := by
    intro z
    have := congrArg (fun φ => φ.appTop.hom z) (Limits.pullback.condition (f := h₁) (g := m))
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this.symm

  have F2 : ∀ p, h₁.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p) =
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.eval₂Hom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)
          (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0) p) := by
    intro p
    subst hh₁
    have := congrArg (fun φ => φ.hom p) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom
      (MvPolynomial.eval₂Hom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)
        (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    exact this.symm

  have F2' : ∀ w : ↥W, (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))).appTop.hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w) =
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w) := by
    intro w
    have := congrArg (fun φ => φ.hom w) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom
      (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    exact this.symm

  have s4 : ∀ x, O.topIso.inv.hom ((u₁.appLE ⊤ O le_top).hom x) = (O.ι ≫ u₁).appTop.hom x := by
    have h : u₁.appLE ⊤ O le_top ≫ O.topIso.inv = (O.ι ≫ u₁).appTop := by
      simp only [Scheme.Hom.comp_appTop, Scheme.Opens.topIso_inv, Scheme.Opens.ι_appTop]
      erw [Scheme.Hom.appLE_map]
      rfl
    intro x
    rw [← h]
    rfl

  have F3 : ∀ w : ↥W, (κ.appLE κ.opensRange ⊤ hκ).hom ((r''.appLE O κ.opensRange hXs).hom
      ((u₁.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w))) =
      (Limits.pullback.fst h₁ m).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w)) := by
    intro w
    rw [hcomp, s4, ← hmq]
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [F2', F1, F2, MvPolynomial.eval₂Hom_C]

  obtain ⟨sX, hsX⟩ : ∃ sX, (κ.appLE κ.opensRange ⊤ hκ).hom sX =
      (Limits.pullback.fst h₁ m).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) :=
    hbij.2 _
  refine ⟨sX, ?_, ?_, ?_⟩
  · exact isAffineOpen_opensRange κ
  · apply hbij.1
    have hL : (κ.appLE κ.opensRange ⊤ hκ).hom ((r''.appLE O κ.opensRange hXs).hom
        (O.topIso.hom.hom (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.X 0))))) =
        (Limits.pullback.fst h₁ m).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) *
        (Limits.pullback.fst h₁ m).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) := by
      rw [hcomp, isoAux, F1, F2]
      simp only [MvPolynomial.eval₂Hom_X', map_mul]
    rw [hL, map_mul, F3 c, hsX]
  · intro a
    let M : Subring Γ(Limits.pullback h₁ m, ⊤) :=
      (Subring.closure (Set.range (r''.appLE O κ.opensRange hXs).hom ∪ {sX})).map
        (κ.appLE κ.opensRange ⊤ hκ).hom
    have hG : ∀ y, (Limits.pullback.snd h₁ m).appTop.hom y ∈ M := by
      intro y
      refine Subring.mem_map.mpr ⟨(r''.appLE O κ.opensRange hXs).hom (O.topIso.hom.hom y),
        Subring.subset_closure (Or.inl ⟨_, rfl⟩), ?_⟩
      rw [hcomp, isoAux]
    have hC : ∀ w : ↥W, (Limits.pullback.fst h₁ m).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w)) ∈ M := by
      intro w
      exact Subring.mem_map.mpr ⟨_, Subring.subset_closure (Or.inl ⟨_, rfl⟩), F3 w⟩
    have hXm : (Limits.pullback.fst h₁ m).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) ∈ M :=
      Subring.mem_map.mpr ⟨sX, Subring.subset_closure (Or.inr rfl), hsX⟩
    have hP : ∀ p : MvPolynomial (Fin 1) ↥W, (Limits.pullback.fst h₁ m).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p) ∈ M := by
      intro p
      induction p using MvPolynomial.induction_on
      · exact hC _
      · rw [map_add, map_add]
        exact M.add_mem ‹_› ‹_›
      · rename_i n hp
        rw [Fin.fin_one_eq_zero n, map_mul, map_mul]
        exact M.mul_mem hp hXm
    have hF : ∀ z, (Limits.pullback.fst h₁ m).appTop.hom z ∈ M := by
      intro z
      have := hP ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom z)
      rwa [isoAux] at this
    have hle : Subring.closure (Set.range (Limits.pullback.fst h₁ m).appTop.hom ∪
        Set.range (Limits.pullback.snd h₁ m).appTop.hom) ≤ M := by
      rw [Subring.closure_le]
      rintro s (⟨z, rfl⟩ | ⟨y, rfl⟩)
      · exact hF z
      · exact hG y
    obtain ⟨a', ha', he⟩ := Subring.mem_map.mp (hle (hgenQ ((κ.appLE κ.opensRange ⊤ hκ).hom a)))
    rw [← hbij.1 he]
    exact ha'

theorem wcpa_dj_lr1k_odfgl_bs_schart_smooth : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W) (X₁ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (O : X₁.Opens) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), Etale m → m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = O.ι ≫ u₁ → ∀ (h₁ : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), h₁ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0))) → ∀ (X'' : Scheme.{u}) (r'' : X'' ⟶ X₁) (κ : Limits.pullback h₁ m ⟶ X'') [IsOpenImmersion κ], κ ≫ r'' = Limits.pullback.snd h₁ m ≫ O.ι → SmoothOfRelativeDimension 1 (κ.opensRange.ι ≫ r'' ≫ u₁) :=
by
  intro Ω _ W c X₁ u₁ O m hm hmq h₁ hh₁ X'' r'' κ _ hκ
  haveI := hm
  have hqsm : SmoothOfRelativeDimension 1
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) := by
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1)]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    rw [CommRingCat.hom_ofHom, ← MvPolynomial.algebraMap_eq]
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial (↥W) (Fin 1)
    simpa using this
  have hh₁q : h₁ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) := by
    rw [hh₁, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext w
    simp
  have hcomp : κ ≫ r'' ≫ u₁ = Limits.pullback.fst h₁ m ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) := by
    rw [← Category.assoc, hκ, Category.assoc, ← hmq, ← Category.assoc,
      ← Limits.pullback.condition, Category.assoc, hh₁q]
  have hι : κ.opensRange.ι = κ.isoOpensRange.inv ≫ κ :=
    ((Iso.inv_comp_eq _).mpr (Scheme.Hom.isoOpensRange_hom_ι κ).symm).symm
  have e : κ.opensRange.ι ≫ r'' ≫ u₁ = κ.isoOpensRange.inv ≫ (Limits.pullback.fst h₁ m ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) := by
    rw [hι, Category.assoc, hcomp]
  rw [e]
  haveI := hqsm
  haveI h1 : SmoothOfRelativeDimension 1 (Limits.pullback.fst h₁ m ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) :=
    smoothOfRelativeDimension_comp 0 1 _ _
  exact smoothOfRelativeDimension_comp 0 1 _ _

theorem wcpa_dj_lr1k_odfgl_bs_point_unique : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Y : Scheme.{u}) [IsAffine Y] (uY : Y ⟶ Spec (.of R)) (σ : Spec (.of R) ⟶ Y) (T : Γ(Y, ⊤)), σ ≫ uY = 𝟙 _ → RingHom.ker σ.appTop.hom = Ideal.span {T} → ∀ z : ↥Y, uY z = IsLocalRing.closedPoint R → z ∉ Y.basicOpen T → z = σ (IsLocalRing.closedPoint R) :=
by
  intro R _ _ Y _ uY σ T hσ hker z hz hzT

  have s1 : ∀ y₁ y₂ : Y, (∀ a : Γ(Y, ⊤), y₁ ∈ Y.basicOpen a ↔ y₂ ∈ Y.basicOpen a) →
      y₁ = y₂ := by
    intro y₁ y₂ h
    apply Y.toSpecΓ.isOpenEmbedding.isEmbedding.injective
    apply PrimeSpectrum.ext
    ext a
    have key : ∀ y : Y, a ∈ (Y.toSpecΓ y).asIdeal ↔ ¬ (y ∈ Y.basicOpen a) := by
      intro y
      rw [← Scheme.toSpecΓ_preimage_basicOpen]
      change a ∈ (Y.toSpecΓ y).asIdeal ↔ ¬ (Y.toSpecΓ y ∈ PrimeSpectrum.basicOpen a)
      exact not_not.symm
    rw [key, key, h]

  have s2 : ∀ (y : Y) (a c : Γ(Y, ⊤)), y ∉ Y.basicOpen T →
      (y ∈ Y.basicOpen (a + c * T) ↔ y ∈ Y.basicOpen a) := by
    intro y a c hy
    rw [Scheme.mem_basicOpen_top] at hy
    rw [Scheme.mem_basicOpen_top, Scheme.mem_basicOpen_top, map_add, map_mul]
    have hT := (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hy)
    have hcT := Ideal.mul_mem_left (IsLocalRing.maximalIdeal _)
      ((Y.presheaf.germ ⊤ y trivial).hom c) hT
    constructor
    · intro hu
      by_contra ha
      have h1 := Ideal.add_mem _
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr ha)) hcT
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)) hu
    · intro hu
      by_contra ha
      have h1 := Ideal.sub_mem _
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr ha)) hcT
      rw [add_sub_cancel_right] at h1
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)) hu

  have s3 : ∀ b, σ.appTop.hom (uY.appTop.hom b) = b := by
    intro b
    change (uY.appTop ≫ σ.appTop).hom b = b
    rw [← Scheme.Hom.comp_appTop, hσ, Scheme.Hom.id_appTop]
    rfl

  have s4 : ∀ a, ∃ c, a = uY.appTop.hom (σ.appTop.hom a) + c * T := by
    intro a
    have hmem : a - uY.appTop.hom (σ.appTop.hom a) ∈ RingHom.ker σ.appTop.hom := by
      rw [RingHom.mem_ker, map_sub, s3, sub_self]
    rw [hker, Ideal.mem_span_singleton'] at hmem
    obtain ⟨c, hc⟩ := hmem
    exact ⟨c, by rw [hc]; ring⟩

  have hTσ : σ.appTop.hom T = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self T
  have s5 : σ (IsLocalRing.closedPoint R) ∉ Y.basicOpen T := by
    intro h
    have h' : IsLocalRing.closedPoint R ∈ σ ⁻¹ᵁ Y.basicOpen T := h
    rw [Scheme.preimage_basicOpen_top, hTσ, Scheme.basicOpen_zero] at h'
    exact h'
  have hσp : uY (σ (IsLocalRing.closedPoint R)) = IsLocalRing.closedPoint R := by
    have e : (σ ≫ uY) (IsLocalRing.closedPoint R) = uY (σ (IsLocalRing.closedPoint R)) :=
      Scheme.Hom.comp_apply _ _ _
    rw [← e, hσ]
    rfl

  have s6 : ∀ (y : Y) (b : Γ(Spec (.of R), ⊤)),
      y ∈ Y.basicOpen (uY.appTop.hom b) ↔ uY y ∈ (Spec (.of R)).basicOpen b := by
    intro y b
    rw [← Scheme.preimage_basicOpen_top]
    rfl

  apply s1
  intro a
  obtain ⟨c, hc⟩ := s4 a
  rw [hc, s2 z _ c hzT, s2 _ _ c s5, s6, s6, hz, hσp]

theorem wcpa_dj_lr1k_odfgl_bs_schart_points : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W → ∀ (X₁ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (O : X₁.Opens) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = O.ι ≫ u₁ → ∀ (σ₁ : Spec (.of ↥W) ⟶ X₁) (σO : Spec (.of ↥W) ⟶ O.toScheme), σO ≫ O.ι = σ₁ → (∀ y : ↥O.toScheme, (O.ι ≫ u₁) y = IsLocalRing.closedPoint ↥W → y ∉ O.toScheme.basicOpen (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) → y = σO (IsLocalRing.closedPoint ↥W)) → ∀ (h₁ : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), h₁ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0))) → ∀ (X'' : Scheme.{u}) (r'' : X'' ⟶ X₁) (κ : Limits.pullback h₁ m ⟶ X''), κ ≫ r'' = Limits.pullback.snd h₁ m ≫ O.ι → ∀ z : ↥(Limits.pullback h₁ m), (r'' ≫ u₁) (κ z) = IsLocalRing.closedPoint ↥W → r'' (κ z) = σ₁ (IsLocalRing.closedPoint ↥W) :=
by
  intro Ω _ W c hcm X₁ u₁ O m hmq σ₁ σO hσO hpu h₁ hh₁ X'' r'' κ hκ z hz

  have hy : (O.ι ≫ u₁) (Limits.pullback.snd h₁ m z) = IsLocalRing.closedPoint ↥W := by
    have e : (O.ι ≫ u₁) (Limits.pullback.snd h₁ m z) =
        ((Limits.pullback.snd h₁ m ≫ O.ι) ≫ u₁) z := by
      simp only [Scheme.Hom.comp_apply]
    rw [e, ← hκ, Category.assoc, Scheme.Hom.comp_apply]
    exact hz

  have hq : h₁ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) := by
    rw [hh₁, ← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.eval₂Hom_comp_C]

  have hF : Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))
      (Limits.pullback.fst h₁ m z) = IsLocalRing.closedPoint ↥W := by
    have e : Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))
        (Limits.pullback.fst h₁ m z) =
        (Limits.pullback.fst h₁ m ≫ h₁ ≫
          Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) z := by
      rw [hq, Scheme.Hom.comp_apply]
    rw [e, ← Category.assoc, Limits.pullback.condition, Category.assoc, hmq,
      Scheme.Hom.comp_apply]
    exact hy

  have hC : (MvPolynomial.C c : MvPolynomial (Fin 1) ↥W) ∈ (Limits.pullback.fst h₁ m z).asIdeal := by
    have h1 : c ∈ (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))
        (Limits.pullback.fst h₁ m z)).asIdeal := by
      rw [hF]; exact hcm
    rw [Spec.map_apply] at h1
    exact h1

  have hX : (MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W) ∈ (m (Limits.pullback.snd h₁ m z)).asIdeal := by
    have e : m (Limits.pullback.snd h₁ m z) = h₁ (Limits.pullback.fst h₁ m z) := by
      rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
    rw [e]
    subst hh₁
    rw [Spec.map_apply]
    show (MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0))
      (MvPolynomial.X 0) ∈ (Limits.pullback.fst _ m z).asIdeal
    rw [MvPolynomial.eval₂Hom_X']
    exact Ideal.mul_mem_right _ _ hC

  have hnb : Limits.pullback.snd h₁ m z ∉ O.toScheme.basicOpen (m.appTop.hom
