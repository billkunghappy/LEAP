        (IsLocalRing.maximalIdeal ↥W).map
          ((algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V)
            {algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a) /
              algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
                algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ))})).comp
            (algebraMap ↥W ↑Γ(X, V))) :=
by

  have s3 : ∀ (R A K : Type u) [CommRing R] [CommRing A] [CommRing K] [Algebra A K] (φ : R →+* A)
      (M : Ideal R) (𝔭 : Ideal A) (z : A) (s : K), 𝔭.IsMaximal →
      𝔭 = Ideal.span {z} ⊔ M.map φ → ∀ (Q : Ideal ↥(Algebra.adjoin A {s})), Q.IsPrime →
      algebraMap A ↥(Algebra.adjoin A {s}) z ∈ Q →
      (⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin A {s})) ∈ Q →
      (∀ w ∈ M, algebraMap A ↥(Algebra.adjoin A {s}) (φ w) ∈ Q) →
      Q = Ideal.span {algebraMap A ↥(Algebra.adjoin A {s}) z,
        ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩} ⊔
        M.map ((algebraMap A ↥(Algebra.adjoin A {s})).comp φ) := by
    intro R A K _ _ _ _ φ M 𝔭 z s h𝔭 h𝔭eq Q hQ hz hs hM
    set B := ↥(Algebra.adjoin A {s})
    set ŝ : B := ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩ with hŝ
    set N := Ideal.span {algebraMap A B z, ŝ} ⊔ M.map ((algebraMap A B).comp φ) with hN
    have hNQ : N ≤ Q := by
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | hx
        · exact hz
        · rw [Set.mem_singleton_iff] at hx; rw [hx]; exact hs
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hM w hw
    have star : ∀ q : B, ∃ f : A, q - algebraMap A B f ∈ N := by
      rintro ⟨q, hq⟩
      induction hq using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        subst hx
        refine ⟨0, ?_⟩
        rw [map_zero, sub_zero]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
      | algebraMap r =>
        refine ⟨r, ?_⟩
        have : (⟨algebraMap A K r, Subalgebra.algebraMap_mem _ r⟩ : B) = algebraMap A B r := rfl
        rw [this, sub_self]
        exact N.zero_mem
      | add x y hx hy ihx ihy =>
        obtain ⟨f, hf⟩ := ihx
        obtain ⟨f', hf'⟩ := ihy
        refine ⟨f + f', ?_⟩
        have e : (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : B) = (⟨x, hx⟩ : B) + ⟨y, hy⟩ := rfl
        rw [e, map_add, add_sub_add_comm]
        exact N.add_mem hf hf'
      | mul x y hx hy ihx ihy =>
        obtain ⟨f, hf⟩ := ihx
        obtain ⟨f', hf'⟩ := ihy
        refine ⟨f * f', ?_⟩
        have e : (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : B) = (⟨x, hx⟩ : B) * ⟨y, hy⟩ := rfl
        have e2 : (⟨x, hx⟩ : B) * ⟨y, hy⟩ - algebraMap A B (f * f') =
            ((⟨x, hx⟩ : B) - algebraMap A B f) * ⟨y, hy⟩ +
              algebraMap A B f * ((⟨y, hy⟩ : B) - algebraMap A B f') := by
          rw [map_mul]; ring
        rw [e, e2]
        exact N.add_mem (N.mul_mem_right _ hf) (N.mul_mem_left _ hf')
    have hpN : 𝔭.map (algebraMap A B) ≤ N := by
      rw [h𝔭eq, Ideal.map_sup, Ideal.map_span, Ideal.map_map]
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.image_singleton, Set.mem_singleton_iff] at hx
        rw [hx]
        exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · exact le_sup_right
    apply le_antisymm _ hNQ
    intro q hq
    obtain ⟨f, hf⟩ := star q
    have hfQ : algebraMap A B f ∈ Q := by
      have : algebraMap A B f = q - (q - algebraMap A B f) := by ring
      rw [this]
      exact Q.sub_mem hq (hNQ hf)
    have hle : 𝔭 ≤ Q.comap (algebraMap A B) := by
      rw [h𝔭eq]
      apply sup_le
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hz
      · rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact hM w hw
    have hPeq : 𝔭 = Q.comap (algebraMap A B) :=
      h𝔭.eq_of_le (Ideal.IsPrime.comap (algebraMap A B)).ne_top hle
    have hf𝔭 : f ∈ 𝔭 := by rw [hPeq]; exact hfQ
    have : q = (q - algebraMap A B f) + algebraMap A B f := by ring
    rw [this]
    exact N.add_mem hf (hpN (Ideal.mem_map_of_mem _ hf𝔭))

  have s6 : ∀ (Y : Scheme.{u}) (U : Y.Opens) (hU : IsAffineOpen U) (B : Type u) [CommRing B]
      [IsDomain B] (e : ↑Γ(Y, U) ≃+* B) (p : ↥Y) (hp : p ∈ U),
      IsDomain (Y.presheaf.stalk p) ∧
      (∀ b : B, (Y.presheaf.germ U p hp).hom (e.symm b) = 0 → b = 0) ∧
      ∀ b : B, ((Y.presheaf.germ U p hp).hom (e.symm b) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk p) ↔
          b ∈ Ideal.comap e.symm (hU.primeIdealOf ⟨p, hp⟩).asIdeal) := by
    intro Y U hU B _ _ e p hp
    have : IsDomain ↑Γ(Y, U) := MulEquiv.isDomain B e.toMulEquiv
    letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨p, hp⟩ : U)
    have := hU.isLocalization_stalk ⟨p, hp⟩
    have hle : (hU.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl ≤ nonZeroDivisors ↑Γ(Y, U) :=
      le_nonZeroDivisors_of_noZeroDivisors (fun h => h (Ideal.zero_mem _))
    have halg : ∀ f : ↑Γ(Y, U), algebraMap ↑Γ(Y, U) (Y.presheaf.stalk p) f =
        (Y.presheaf.germ U p hp).hom f := fun f => rfl
    refine ⟨IsLocalization.isDomain_of_le_nonZeroDivisors _ hle, ?_, ?_⟩
    · intro b hb
      have hinj := IsLocalization.injective (Y.presheaf.stalk p) hle
      rw [← halg] at hb
      have h0 : e.symm b = 0 := hinj (hb.trans (map_zero _).symm)
      simpa using h0
    · intro b
      rw [← halg, Ideal.mem_comap]
      exact IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _

  have s2 : ∀ (Y : Scheme.{u}) (O' : Y.Opens) (R : CommRingCat.{u}) (n : O'.toScheme ⟶ Spec R)
      (p : ↥Y) (hp : p ∈ O') (T : ↑R),
      T ∈ (n ⟨p, hp⟩).asIdeal ↔ (Y.presheaf.germ O' p hp).hom (O'.topIso.hom.hom
        (n.appTop.hom ((Scheme.ΓSpecIso R).inv.hom T))) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk p) := by
    intro Y O' R n p hp T
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    set q : ↥(O'.toScheme) := ⟨p, hp⟩ with hq
    have h1 : T ∈ (n q).asIdeal ↔
        ¬ (q ∈ n ⁻¹ᵁ (Spec R).basicOpen ((Scheme.ΓSpecIso R).inv.hom T)) := by
      rw [basicOpen_eq_of_affine]
      exact ⟨fun h h' => (PrimeSpectrum.mem_basicOpen _ _).mp h' h,
        fun h => by_contra fun h' => h ((PrimeSpectrum.mem_basicOpen _ _).mpr h')⟩
    rw [h1, Scheme.preimage_basicOpen]
    refine (not_congr (Scheme.mem_basicOpen (O'.toScheme) (U := ⊤) _ q trivial)).trans ?_
    change ¬ IsUnit ((O'.toScheme.presheaf.germ ⊤ q trivial).hom
      (n.appTop.hom ((Scheme.ΓSpecIso R).inv.hom T))) ↔ _
    have h3 := Scheme.Opens.germ_stalkIso_hom O' (V := ⊤) q trivial
    have h4 : ∀ y : ↑Γ(O'.toScheme, ⊤), (Y.presheaf.germ O' p hp).hom (O'.topIso.hom.hom y) =
        (O'.stalkIso q).hom.hom ((O'.toScheme.presheaf.germ ⊤ q trivial).hom y) := by
      intro y
      have := congrArg (fun φ => φ.hom y) h3
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this, Scheme.Opens.topIso_hom]
      exact TopCat.Presheaf.germ_res_apply Y.presheaf _ p hp y
    rw [h4]
    constructor
    · intro h hu
      exact h ((isUnit_map_iff (O'.stalkIso q).hom.hom _).mp hu)
    · intro h hu
      exact h (hu.map _)

  have s5 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Y : Scheme.{u})
      (f : Y ⟶ Spec (.of ↥W)), Flat f → ∀ (p : ↥Y) (a : ↥W), a ≠ 0 →
      (Y.presheaf.germ ⊤ p trivial).hom (f.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) ∈
        nonZeroDivisors (Y.presheaf.stalk p) := by
    intro Ω _ W Y f hf p a ha
    set ψ : ↥W →+* ↑(Y.presheaf.stalk p) :=
      (f.stalkMap p).hom.comp (((Spec (.of ↥W)).presheaf.germ ⊤ (f p) trivial).hom.comp
        (Scheme.ΓSpecIso (.of ↥W)).inv.hom) with hψ
    have h1 : ((Scheme.ΓSpecIso (.of ↥W)).inv.hom).Flat := by
      apply RingHom.Flat.of_bijective
      exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of ↥W)).inv)
    have h2 : (((Spec (.of ↥W)).presheaf.germ ⊤ (f p) trivial).hom).Flat := by
      letI := TopCat.Presheaf.algebra_section_stalk (Spec (.of ↥W)).presheaf
        (⟨f p, trivial⟩ : (⊤ : (Spec (.of ↥W)).Opens))
      have := (isAffineOpen_top (Spec (.of ↥W))).isLocalization_stalk ⟨f p, trivial⟩
      have h := IsLocalization.flat (Spec (.of ↥W) |>.presheaf.stalk (f p))
        ((isAffineOpen_top (Spec (.of ↥W))).primeIdealOf ⟨f p, trivial⟩).asIdeal.primeCompl
      exact RingHom.flat_algebraMap_iff.mpr h
    have h3 : (f.stalkMap p).hom.Flat := Flat.stalkMap f p
    have hψf : ψ.Flat := (h1.comp h2).comp h3
    have hψa : ψ a = (Y.presheaf.germ ⊤ p trivial).hom
        (f.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) := by
      simp only [hψ, RingHom.comp_apply]
      exact Scheme.Hom.germ_stalkMap_apply f ⊤ p trivial _
    rw [← hψa]
    letI := ψ.toAlgebra
    haveI : Module.Flat ↥W ↑(Y.presheaf.stalk p) := hψf
    have hreg : IsSMulRegular (↑(Y.presheaf.stalk p)) a :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ha)
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hreg
    change ψ a * x = ψ a * 0
    rw [mul_zero, mul_comm, hx]

  have natSpec : ∀ (R₀ R : Type u) [CommRing R₀] [CommRing R] (ρ : R₀ →+* R) (T : Scheme.{u})
      (n : T ⟶ Spec (.of R)) (y : R₀),
      n.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom (ρ y)) =
        (n ≫ Spec.map (CommRingCat.ofHom ρ)).appTop.hom ((Scheme.ΓSpecIso (.of R₀)).inv.hom y) := by
    intro R₀ R _ _ ρ T n y
    have h := congrArg (fun φ => φ.hom y) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ρ))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
    rw [h, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  have resTop : ∀ {X X' : Scheme.{u}} (f : X' ⟶ X) (O : X.Opens) (O' : X'.Opens)
      (hle : O' ≤ f ⁻¹ᵁ O) (y : Γ(O.toScheme, ⊤)),
      O'.topIso.hom.hom ((f.resLE O O' hle).appTop.hom y) =
        (f.appLE O O' hle).hom (O.topIso.hom.hom y) := by
    intro X X' f O O' hle y
    have h₁ : O' ≤ f ⁻¹ᵁ (O.ι ''ᵁ ⊤) := by rw [Scheme.Opens.ι_image_top]; exact hle
    have e1 : (f.resLE O O' hle).appTop = f.appLE (O.ι ''ᵁ ⊤) (O'.ι ''ᵁ ⊤)
        (by rw [Scheme.Opens.ι_image_top]; exact h₁) := by
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE]
      rfl
    calc O'.topIso.hom.hom ((f.resLE O O' hle).appTop.hom y)
        = (f.appLE (O.ι ''ᵁ ⊤) O' h₁).hom y := by
          rw [e1, Scheme.Opens.topIso_hom]
          have := congrArg (fun φ => φ.hom y) (f.appLE_map (U := O.ι ''ᵁ ⊤) (V := O'.ι ''ᵁ ⊤)
            (V' := O') (by rw [Scheme.Opens.ι_image_top]; exact h₁) (eqToHom (by
              rw [Scheme.Opens.ι_image_top])).op)
          simp only [CommRingCat.hom_comp] at this
          exact this
      _ = (f.appLE O O' hle).hom (O.topIso.hom.hom y) := by
          rw [Scheme.Opens.topIso_hom]
          have := congrArg (fun φ => φ.hom y) (f.map_appLE (U := O) (U' := O.ι ''ᵁ ⊤) (V := O')
            hle (eqToHom (by rw [Scheme.Opens.ι_image_top])).op)
          simp only [CommRingCat.hom_comp] at this
          exact this.symm
  have iotaTop : ∀ {X' Z : Scheme.{u}} (g : X' ⟶ Z) (O' : X'.Opens) (y : Γ(Z, ⊤)),
      O'.topIso.hom.hom ((O'.ι ≫ g).appTop.hom y) = (g.appLE ⊤ O' le_top).hom y := by
    intro X' Z g O' y
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, Scheme.Opens.ι_appTop,
      Scheme.Opens.topIso_hom]
    have := congrArg (fun φ => φ.hom y) (g.appLE_map (U := ⊤) (V := O'.ι ''ᵁ ⊤) (V' := O')
      (by rw [Scheme.Opens.ι_image_top]; exact le_top) (eqToHom (by
        rw [Scheme.Opens.ι_image_top])).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [← this]
    have h2 := congrArg (fun φ => φ.hom y) (g.appLE_map (U := ⊤) (V := ⊤) (V' := O'.ι ''ᵁ ⊤)
      le_top (homOfLE le_top).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    rw [← h2, Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl

  intro Ω _ _ W hW hWt X uX ι hM x V hle g 𝔭 hch _ hφ K _ _ _ σ a hP hz0 X' r ι' hbl hM'
    O hOV m hcoord O' hle' n hn1 hn2 U' hU' hU'a e hei heii w' hz hzp
  have hAdom : IsDomain ↑Γ(X, V) := hch.2.2.1
  revert e hei
  generalize hsdef : algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a) /
    algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
      algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)) = s
  intro e hei
  set z := g (MvPolynomial.X 0) -
    algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ) with hzdef
  set p := Limits.pullback.fst (r ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w' with hpdef
  have hOV' : O' ≤ r ⁻¹ᵁ V := hle'.trans (r.preimage_mono hOV)
  have hpV : p ∈ r ⁻¹ᵁ V := hOV' hz

  set θ : ↑Γ(X, V) →+* ↑(X'.presheaf.stalk p) :=
    (X'.presheaf.germ (r ⁻¹ᵁ V) p hpV).hom.comp (r.appLE V (r ⁻¹ᵁ V) le_rfl).hom with hθ
  have GI : ∀ (Y : X'.Opens) (hY : Y ≤ r ⁻¹ᵁ V) (hpY : p ∈ Y) (f : ↑Γ(X, V)),
      (X'.presheaf.germ Y p hpY).hom ((r.appLE V Y hY).hom f) = θ f := by
    intro Y hY hpY f
    have h := congrArg (fun φ => φ.hom f)
      (r.appLE_map (U := V) (V := r ⁻¹ᵁ V) (V' := Y) le_rfl (homOfLE hY).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [← h]
    exact TopCat.Presheaf.germ_res_apply X'.presheaf (homOfLE hY) p hpY _

  set ν : ↥(wcEbRing W a) →+* ↑(X'.presheaf.stalk p) :=
    (X'.presheaf.germ O' p hz).hom.comp (O'.topIso.hom.hom.comp (n.appTop.hom.comp
      (Scheme.ΓSpecIso (.of ↥(wcEbRing W a))).inv.hom)) with hν
  set Xh : ↥(wcEbRing W a) :=
    ⟨RatFunc.X, Subring.subset_closure (Or.inr (Set.mem_insert _ _))⟩ with hXh
  set Sh : ↥(wcEbRing W a) := ⟨algebraMap Ω (RatFunc Ω) ↑a * RatFunc.X⁻¹,
    Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))⟩ with hSh
  have hρX : wcEbCdRho W a (MvPolynomial.X 0) = Xh := MvPolynomial.eval₂Hom_X' _ _ _
  have E1 : ν Xh = θ z := by
    have h1 := natSpec (MvPolynomial (Fin 1) ↥W) ↥(wcEbRing W a) (wcEbCdRho W a) O'.toScheme n
      (MvPolynomial.X 0)
    rw [hρX, hn1, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    show (X'.presheaf.germ O' p hz).hom (O'.topIso.hom.hom (n.appTop.hom
      ((Scheme.ΓSpecIso (.of ↥(wcEbRing W a))).inv.hom Xh))) = θ z
    rw [h1, resTop r O O' hle', hcoord, ← GI O' hOV' hz z]
    have h := congrArg (fun φ => φ.hom z)
      (r.map_appLE (U := O) (U' := V) (V := O') hle' (homOfLE hOV).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h]
  have E2 : ∀ w : ↥W, ν (wcEbW W a w) = θ (algebraMap ↥W ↑Γ(X, V) w) := by
    intro w
    have h1 := natSpec ↥W ↥(wcEbRing W a) (wcEbW W a) O'.toScheme n w
    rw [hn2] at h1
    show (X'.presheaf.germ O' p hz).hom (O'.topIso.hom.hom (n.appTop.hom
      ((Scheme.ΓSpecIso (.of ↥(wcEbRing W a))).inv.hom (wcEbW W a w)))) = _
    rw [h1, iotaTop (r ≫ uX) O', ← GI O' hOV' hz]
    have hw : algebraMap ↥W ↑Γ(X, V) w =
        (uX.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w) := by rw [hφ]; rfl
    rw [hw]
    have h := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w))
      (Scheme.Hom.appLE_comp_appLE r uX ⊤ V O' hle hOV')
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h]
  have hXS : Xh * Sh = wcEbW W a a := by
    apply Subtype.ext
    show RatFunc.X * (algebraMap Ω (RatFunc Ω) ↑a * RatFunc.X⁻¹) = algebraMap Ω (RatFunc Ω) ↑a
    rw [mul_left_comm, mul_inv_cancel₀ RatFunc.X_ne_zero, mul_one]
  set α := ν Sh with hα
  have E3 : θ (algebraMap ↥W ↑Γ(X, V) a) = θ z * α := by
    rw [← E2, ← hXS, map_mul, E1]

  have hnode : ∀ T, T ∈ wcEbNode W a → ν T ∈ IsLocalRing.maximalIdeal (X'.presheaf.stalk p) := by
    intro T hT
    exact (s2 X' O' (.of ↥(wcEbRing W a)) n p hz T).mp (by rw [hzp]; exact hT)
  have hXhm : ν Xh ∈ IsLocalRing.maximalIdeal (X'.presheaf.stalk p) :=
    hnode Xh (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
  have hαm : α ∈ IsLocalRing.maximalIdeal (X'.presheaf.stalk p) :=
    hnode Sh (Ideal.mem_sup_left (Ideal.subset_span
      (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
  have hWm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ν (wcEbW W a w) ∈ IsLocalRing.maximalIdeal (X'.presheaf.stalk p) :=
    fun w hw => hnode _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hw))

  have hflat : Flat (r ≫ uX) := by
    obtain ⟨⟨hf, -⟩, -⟩ := hM'
    exact hf
  have hnzd : θ (algebraMap ↥W ↑Γ(X, V) a) ∈ nonZeroDivisors (X'.presheaf.stalk p) := by
    have h := s5 Ω W X' (r ≫ uX) hflat p a hP.2.2.1
    have heq : θ (algebraMap ↥W ↑Γ(X, V) a) = (X'.presheaf.germ ⊤ p trivial).hom
        ((r ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a)) := by
      have hw : algebraMap ↥W ↑Γ(X, V) a =
          (uX.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) := by rw [hφ]; rfl
      rw [hw, ← GI (r ⁻¹ᵁ V) le_rfl hpV]
      have h1 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))
        (Scheme.Hom.appLE_comp_appLE r uX ⊤ V (r ⁻¹ᵁ V) hle le_rfl)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
      rw [h1]
      have h2 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a))
        ((r ≫ uX).appLE_map (U := ⊤) (V := ⊤) (V' := r ⁻¹ᵁ V) le_top (homOfLE le_top).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
      rw [← h2]
      refine (TopCat.Presheaf.germ_res_apply X'.presheaf (homOfLE le_top) p hpV _).trans ?_
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      rfl
    rw [heq]
    exact h

  by_cases hpU : p ∈ U'
  swap
  · exfalso
    obtain ⟨Y, hY, u, hpY, hYeq⟩ := heii p hpV hpU
    have h1 := congrArg (X'.presheaf.germ Y p hpY).hom hYeq
    rw [map_mul, GI Y hY hpY, GI Y hY hpY] at h1
    set ū := (X'.presheaf.germ Y p hpY).hom u with hū
    have h2 : θ (algebraMap ↥W ↑Γ(X, V) a) = ū * α * θ (algebraMap ↥W ↑Γ(X, V) a) := by
      calc θ (algebraMap ↥W ↑Γ(X, V) a) = θ z * α := E3
        _ = ū * θ (algebraMap ↥W ↑Γ(X, V) a) * α := by rw [h1]
        _ = ū * α * θ (algebraMap ↥W ↑Γ(X, V) a) := by ring
    have h3 : (1 - ū * α) * θ (algebraMap ↥W ↑Γ(X, V) a) = 0 := by linear_combination h2
    have h4 := (mem_nonZeroDivisors_iff_right.mp hnzd) _ h3
    have hunit : IsUnit α := isUnit_iff_exists_inv.mpr ⟨ū, by linear_combination -h4⟩
    exact IsLocalRing.notMem_maximalIdeal.mpr hunit hαm
  refine ⟨hpU, ?_⟩
  obtain ⟨hSdom, hinj, hmax⟩ := s6 X' U' hU'a _ e p hpU
  set loc : ↥(Algebra.adjoin ↑Γ(X, V) {s}) →+* ↑(X'.presheaf.stalk p) :=
    (X'.presheaf.germ U' p hpU).hom.comp e.symm.toRingHom with hlocdef
  have hloc : ∀ f : ↑Γ(X, V), loc (algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) f) = θ f := by
    intro f
    show (X'.presheaf.germ U' p hpU).hom
      (e.symm (algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) f)) = θ f
    rw [← hei f, RingEquiv.symm_apply_apply, GI U' hU' hpU]
  have hzK : algebraMap ↑Γ(X, V) K z ≠ 0 := fun h =>
    hz0 (IsFractionRing.injective ↑Γ(X, V) K (h.trans (map_zero _).symm))
  set ŝ : ↥(Algebra.adjoin ↑Γ(X, V) {s}) := ⟨s, Algebra.subset_adjoin (Set.mem_singleton _)⟩
    with hŝ
  have hzs : algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) z * ŝ =
      algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) (algebraMap ↥W ↑Γ(X, V) a) := by
    apply Subtype.ext
    show algebraMap ↑Γ(X, V) K z * s = algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a)
    rw [← hsdef]
    field_simp
  have hθz : θ z ≠ 0 := by
    rw [← hloc z]
    intro h
    have h' := hinj _ h
    exact hzK (congrArg Subtype.val h')
  haveI := hSdom
  have hαeq : α = loc ŝ := by
    apply mul_left_cancel₀ hθz
    calc θ z * α = θ (algebraMap ↥W ↑Γ(X, V) a) := E3.symm
      _ = loc (algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s})
            (algebraMap ↥W ↑Γ(X, V) a)) := (hloc _).symm
      _ = loc (algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) z * ŝ) := by rw [hzs]
      _ = θ z * loc ŝ := by rw [map_mul, hloc]
  have hsQ : ŝ ∈ Ideal.comap e.symm (hU'a.primeIdealOf ⟨p, hpU⟩).asIdeal := by
    apply (hmax ŝ).mp
    have h := hαm
    rw [hαeq] at h
    exact h
  have hzQ : algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) z ∈
      Ideal.comap e.symm (hU'a.primeIdealOf ⟨p, hpU⟩).asIdeal := by
    apply (hmax _).mp
    show loc (algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) z) ∈ _
    rw [hloc, ← E1]
    exact hXhm
  have hMQ : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) (algebraMap ↥W ↑Γ(X, V) w) ∈
        Ideal.comap e.symm (hU'a.primeIdealOf ⟨p, hpU⟩).asIdeal := by
    intro w hw
    apply (hmax _).mp
    show loc (algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V) {s}) (algebraMap ↥W ↑Γ(X, V) w)) ∈ _
    rw [hloc, ← E2]
    exact hWm w hw

  have hσV : σ (IsLocalRing.closedPoint ↥W) ∈ V := by rw [hP.2.1]; exact hch.2.1
  obtain ⟨-, -, -, h𝔭max, -, ht𝔭, h𝔭eq0, -⟩ := hch.2.2.2.2.2.2.1
  have hc : wcG2cTau W V (g (MvPolynomial.X 0)) σ ∈ IsLocalRing.maximalIdeal ↥W := by
    have hnot : x ∉ X.basicOpen (g (MvPolynomial.X 0)) := (hch.2.2.2.2.2.1 _).mp ht𝔭
    rw [← hP.2.1] at hnot
    have BO : ∀ (e₀ : ⊤ ≤ σ ⁻¹ᵁ V), IsUnit ((Scheme.ΓSpecIso (.of ↥W)).hom.hom
        ((σ.appLE V ⊤ e₀).hom (g (MvPolynomial.X 0)))) →
        σ (IsLocalRing.closedPoint ↥W) ∈ X.basicOpen (g (MvPolynomial.X 0)) := by
      intro e₀ hu
      have key := Scheme.basicOpen_appLE σ ⊤ V e₀ (g (MvPolynomial.X 0))
      rw [top_inf_eq] at key
      have H : ∀ y : Spec (.of ↥W), σ y ∈ X.basicOpen (g (MvPolynomial.X 0)) ↔
          y ∈ (Spec (.of ↥W)).basicOpen ((σ.appLE V ⊤ e₀).hom (g (MvPolynomial.X 0))) := by
        intro y
        rw [key, Scheme.Hom.mem_preimage]
      refine (H (IsLocalRing.closedPoint ↥W)).mpr ?_
      rw [basicOpen_eq_of_affine']
      exact (PrimeSpectrum.mem_basicOpen _ _).mpr (IsLocalRing.notMem_maximalIdeal.mpr hu)
    unfold wcG2cTau
    rw [dif_pos hσV, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    exact hnot (BO _ hunit)
  have hφc : algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ) ∈
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↑Γ(X, V)) := Ideal.mem_map_of_mem _ hc
  have h𝔭eq1 : 𝔭 = Ideal.span {g (MvPolynomial.X 0)} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↑Γ(X, V)) := by
    have h0 : 𝔭 = Ideal.span {g (MvPolynomial.X 0)} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (wcG2cPhi W uX V hle) := h𝔭eq0
    rw [hφ]
    exact h0
  have h𝔭eq2 : 𝔭 = Ideal.span {z} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W ↑Γ(X, V)) := by
    rw [h𝔭eq1]
    apply le_antisymm
    · apply sup_le _ le_sup_right
      rw [Ideal.span_le, Set.singleton_subset_iff]
      have : g (MvPolynomial.X 0) =
          z + algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ) := by
        rw [hzdef]; ring
      rw [this]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self z))
        (Ideal.mem_sup_right hφc)
    · apply sup_le _ le_sup_right
      rw [Ideal.span_le, Set.singleton_subset_iff, hzdef]
      exact Ideal.sub_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
        (Ideal.mem_sup_right hφc)
  exact s3 ↥W ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V)) (IsLocalRing.maximalIdeal ↥W) 𝔭 z s
    h𝔭max h𝔭eq2 _ (Ideal.IsPrime.comap e.symm) hzQ hsQ hMQ

theorem wcpa_dj_llsmgn_np_prime_natural : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (U : Y.Opens)
    (hU : IsAffineOpen U) (hV : IsAffineOpen (f ⁻¹ᵁ U)) (x : ↥X) (hx : x ∈ f ⁻¹ᵁ U) (y : ↥Y)
    (hy : y ∈ U), f x = y →
    Ideal.comap (f.app U).hom (hV.primeIdealOf ⟨x, hx⟩).asIdeal = (hU.primeIdealOf ⟨y, hy⟩).asIdeal :=
by
  have D : ∀ (Z : Scheme.{u}) (W : Z.Opens) (hW : IsAffineOpen W) (z : Z) (hz : z ∈ W)
      (b : Γ(Z, W)), b ∈ (hW.primeIdealOf ⟨z, hz⟩).asIdeal ↔ z ∉ Z.basicOpen b := by
    intro Z W hW z hz b
    have h1 : hW.fromSpec (hW.primeIdealOf ⟨z, hz⟩) = z := hW.fromSpec_primeIdealOf ⟨z, hz⟩
    have h3 := hW.fromSpec_preimage_basicOpen b
    have e1 : z ∈ Z.basicOpen b ↔ hW.fromSpec (hW.primeIdealOf ⟨z, hz⟩) ∈ Z.basicOpen b := by
      rw [h1]
    have e2 : hW.fromSpec (hW.primeIdealOf ⟨z, hz⟩) ∈ Z.basicOpen b ↔
        (show Spec Γ(Z, W) from hW.primeIdealOf ⟨z, hz⟩) ∈ hW.fromSpec ⁻¹ᵁ Z.basicOpen b :=
      Iff.rfl
    have e3 : (show Spec Γ(Z, W) from hW.primeIdealOf ⟨z, hz⟩) ∈ hW.fromSpec ⁻¹ᵁ Z.basicOpen b ↔
        b ∉ (hW.primeIdealOf ⟨z, hz⟩).asIdeal := by
      rw [h3]; exact Iff.rfl
    rw [e1.trans (e2.trans e3), not_not]
  intro X Y f U hU hV x hx y hy hxy
  subst hxy
  ext a
  rw [Ideal.mem_comap, D, D]
  have h3 : x ∈ X.basicOpen ((f.app U).hom a) ↔ f x ∈ Y.basicOpen a := by
    rw [← Scheme.preimage_basicOpen, Scheme.Hom.mem_preimage]
  exact not_congr h3

theorem wcpa_dj_llsmgn_np_intclosure_transport : ∀ (A D L R : Type u) [CommRing A] [CommRing D]
    [Field L] [CommRing R] [Algebra A D] [Algebra D L] [IsFractionRing D L] [IsIntegrallyClosed D]
    [Algebra R L] (e : A ≃+* R),
    (∀ y : A, algebraMap R L (e y) = algebraMap D L (algebraMap A D y)) →
    ∃ Φ : ↥(integralClosure A D) ≃+* ↥(integralClosure R L),
      ∀ d : ↥(integralClosure A D), ((Φ d : ↥(integralClosure R L)) : L) = algebraMap D L (d : D) :=
by
  intro A D L R _ _ _ _ _ _ _ _ _ e hyp
  have hsq : (algebraMap R L).comp (e : A →+* R) = (algebraMap D L).comp (algebraMap A D) :=
    RingHom.ext hyp
  have hsq' : (algebraMap D L).comp ((algebraMap A D).comp (e.symm : R →+* A)) =
      (RingHom.id L).comp (algebraMap R L) := by
    ext r
    simp only [RingHom.comp_apply, RingHom.id_apply, RingEquiv.coe_toRingHom]
    rw [← hyp (e.symm r), RingEquiv.apply_symm_apply]
  have hfwd : ∀ d : ↥(integralClosure A D),
      ((algebraMap D L).comp (integralClosure A D).val.toRingHom) d ∈ integralClosure R L := by
    intro d
    rw [mem_integralClosure_iff]
    exact IsIntegral.map_of_comp_eq (e : A →+* R) (algebraMap D L) hsq
      ((mem_integralClosure_iff A D).mp d.2)
  let Φ₀ : ↥(integralClosure A D) →+* ↥(integralClosure R L) :=
    RingHom.codRestrict ((algebraMap D L).comp (integralClosure A D).val.toRingHom)
      (integralClosure R L) hfwd
  have hinj : Function.Injective Φ₀ := by
    intro x y hxy
    have h1 := congrArg Subtype.val hxy
    apply Subtype.ext
    exact IsFractionRing.injective D L h1
  have hsurj : Function.Surjective Φ₀ := by
    rintro ⟨ℓ, hℓ⟩
    have hℓ' : IsIntegral R ℓ := hℓ
    have hD : IsIntegral D ℓ := by
      have := IsIntegral.map_of_comp_eq ((algebraMap A D).comp (e.symm : R →+* A))
        (RingHom.id L) hsq' hℓ'
      simpa using this
    obtain ⟨d, hd⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hD
    obtain ⟨q, hqm, hq⟩ := hℓ'
    have hdA : IsIntegral A d := by
      refine ⟨q.map (e.symm : R →+* A), hqm.map _, ?_⟩
      apply IsFractionRing.injective D L
      rw [map_zero, Polynomial.hom_eval₂, Polynomial.eval₂_map, hd]
      have : ((algebraMap D L).comp (algebraMap A D)).comp (e.symm : R →+* A) =
          algebraMap R L := by
        rw [RingHom.comp_assoc, hsq']; rfl
      rw [this]; exact hq
    refine ⟨⟨d, hdA⟩, ?_⟩
    apply Subtype.ext
    exact hd
  exact ⟨RingEquiv.ofBijective Φ₀ ⟨hinj, hsurj⟩, fun d => rfl⟩

theorem wcpa_dj_llsmgn_np_cover_sections : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → ∀ [AlgebraicGeometry.IsIntegral C]
    (X' : Scheme.{u}) (uX' : X' ⟶ Spec (.of ↥W)) (ι' : wcProjK Ω 1 ⟶ X'), wcpaDjLkModel W uX' ι' →
    ∀ (U' : X'.Opens), IsAffineOpen U' → genericPoint C ∈ (γ ≫ ι') ⁻¹ᵁ U' →
    IsAffineOpen ((γ ≫ ι') ⁻¹ᵁ U') ∧ IsIntegrallyClosed ↑Γ(C, (γ ≫ ι') ⁻¹ᵁ U') :=
by
  intro Ω _ W C γ hcov _ X' uX' ι' hM U' hU' hgen
  haveI : IsAffineHom ι' :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hM.2.2.flip inferInstance
  haveI : IsFinite γ := hcov.2.2.2.1
  have haff : IsAffineOpen ((γ ≫ ι') ⁻¹ᵁ U') := hU'.preimage (γ ≫ ι')
  haveI : SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) := hcov.2.1
  haveI : Smooth (γ ≫ wcProjKStr Ω 1) := SmoothOfRelativeDimension.smooth 1 _
  have hst : ∀ c : C, IsIntegrallyClosed (C.presheaf.stalk c) := fun c =>
    (wc_fntame_smooth_stalk_normal Ω C (γ ≫ wcProjKStr Ω 1) c).2
  have hne : Nonempty ↥((γ ≫ ι') ⁻¹ᵁ U') := ⟨⟨genericPoint C, hgen⟩⟩
  exact ⟨haff, wc_fsus_affine_sections_intclosed C hst _ haff hne⟩

theorem wcpa_dj_llsmgn_np_fibre_stalk : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (L : Type u) [Field L] (wL : ↥W →+* L) (R : Type u) [CommRing R] [Algebra R L]
    (Y : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W)) (U : Y.Opens) (hU : IsAffineOpen U)
    (Ψ : ↑Γ(Y, U) ≃+* ↥(integralClosure R L)),
    (∀ w : ↥W, ((Ψ ((g.appLE ⊤ U le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) :
      ↥(integralClosure R L)) : L) = wL w) →
    ∀ (w : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))
      (hw : Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w ∈ U)
      (𝔮 : Ideal ↥(integralClosure R L)) [𝔮.IsPrime],
      𝔮 = Ideal.comap Ψ.symm (hU.primeIdealOf ⟨_, hw⟩).asIdeal →
      Nonempty (↑((Limits.pullback g (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.stalk w) ≃+*
        wcLlsFS W wL R 𝔮) :=
by
  intro Ω _ W L _ wL R _ _ Y g U hU Ψ hΨ w hw 𝔮 _ h𝔮
  classical
  obtain ⟨-, h2⟩ := wcpa_dj_p1g_cf_fibre_stalk ↥W Y g
  obtain ⟨-, hsurj, hker⟩ := h2 w
  letI : Algebra ↑Γ(Y, U) ↑(Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) :=
    TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨_, hw⟩
  haveI hloc := hU.isLocalization_stalk ⟨_, hw⟩
  let τ : ↥W →+* ↑Γ(Y, U) := (g.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom
  have hgerm : g.appTop ≫ Y.presheaf.germ ⊤ (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) trivial =
      g.appLE ⊤ U le_top ≫ Y.presheaf.germ U _ hw := by
    rw [← Y.presheaf.germ_res (homOfLE le_top) _ hw, ← Category.assoc]
    rfl
  have hker' : RingHom.ker ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).stalkMap w).hom =
      Ideal.map ((algebraMap ↑Γ(Y, U) _).comp τ) (IsLocalRing.maximalIdeal ↥W) := by
    rw [hker, hgerm]
    rfl
  have key : ∀ x, x ∈ 𝔮 ↔ Ψ.symm x ∈ (hU.primeIdealOf ⟨_, hw⟩).asIdeal := fun x => by
    rw [h𝔮]; rfl
  have hsub : Submonoid.map Ψ.toMonoidHom (hU.primeIdealOf ⟨_, hw⟩).asIdeal.primeCompl =
      𝔮.primeCompl := by
    ext x
    rw [Submonoid.mem_map, Ideal.mem_primeCompl_iff, key]
    constructor
    · rintro ⟨a, ha, rfl⟩
      rw [Ideal.mem_primeCompl_iff] at ha
      simpa using ha
    · intro hx
      exact ⟨Ψ.symm x, by rw [Ideal.mem_primeCompl_iff]; exact hx, by simp⟩
  let ε := IsLocalization.ringEquivOfRingEquiv (M := (hU.primeIdealOf ⟨_, hw⟩).asIdeal.primeCompl)
    (Y.presheaf.stalk (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w)) (Localization.AtPrime 𝔮) Ψ hsub
  have hS : {b : ↥(integralClosure R L) | ∃ w₀ ∈ IsLocalRing.maximalIdeal ↥W, (b : L) = wL w₀} =
      (Ψ.toRingHom.comp τ) '' (IsLocalRing.maximalIdeal ↥W : Set ↥W) := by
    ext b
    constructor
    · rintro ⟨w₀, hw₀, hb⟩
      exact ⟨w₀, hw₀, Subtype.val_injective ((hΨ w₀).trans hb.symm)⟩
    · rintro ⟨w₀, hw₀, rfl⟩
      exact ⟨w₀, hw₀, hΨ w₀⟩
  have hc : ε.toRingHom.comp ((algebraMap ↑Γ(Y, U) _).comp τ) =
      (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮)).comp (Ψ.toRingHom.comp τ) := by
    ext x
    exact IsLocalization.ringEquivOfRingEquiv_eq hsub (τ x)
  have hJ : Ideal.map (algebraMap ↥(integralClosure R L) (Localization.AtPrime 𝔮))
      (Ideal.span {b : ↥(integralClosure R L) | ∃ w₀ ∈ IsLocalRing.maximalIdeal ↥W,
        (b : L) = wL w₀}) =
      Ideal.map ε.toRingHom
        (Ideal.map ((algebraMap ↑Γ(Y, U) _).comp τ) (IsLocalRing.maximalIdeal ↥W)) := by
    rw [Ideal.map_map, hc, ← Ideal.map_map, hS, ← Ideal.map_span, Ideal.span_eq]
  exact ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans
    ((Ideal.quotEquivOfEq hker').trans (Ideal.quotientEquiv _ _ ε (by exact hJ)))⟩

theorem wcpa_dj_llsmgn_norm_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ [AlgebraicGeometry.IsIntegral C] (X' : Scheme.{u}) (uX' : X' ⟶ Spec (.of ↥W))
      (ι' : wcProjK Ω 1 ⟶ X') [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcpaDjLkModel W uX' ι' →
    ∀ (U' : X'.Opens) (hU' : IsAffineOpen U') (hgen' : genericPoint C ∈ (γ ≫ ι') ⁻¹ᵁ U')
      (R : Type u) [CommRing R] [Algebra R ↑C.functionField] (e : ↑Γ(X', U') ≃+* R),
      (∀ y : ↑Γ(X', U'), algebraMap R ↑C.functionField (e y) = wcG2cKap (γ ≫ ι') U' hgen' y) →
    ∀ (wL : ↥W →+* ↑C.functionField),
      (∀ w : ↥W, algebraMap R ↑C.functionField
          (e ((uX'.appLE ⊤ U' le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w))) = wL w) →
    ∀ (y' : ↥(wcpaDjLkFib W (γ ≫ ι') uX')) (h : wcpaDjLkImg W (γ ≫ ι') uX' y' ∈ U'),
    ∃ (𝔮 : Ideal ↥(integralClosure R ↑C.functionField)) (_ : 𝔮.IsPrime),
      𝔮.comap (algebraMap R ↥(integralClosure R ↑C.functionField)) =
        Ideal.comap e.symm (hU'.primeIdealOf ⟨_, h⟩).asIdeal ∧
      Nonempty (↑((wcpaDjLkFib W (γ ≫ ι') uX').presheaf.stalk y') ≃+* wcLlsFS W wL R 𝔮) :=
by
  intro Ω _ _ W C γ hcov _ X' uX' ι' _ _ hM U' hU' hgen' R _ _ e he wL hwL y' h

  have hcomp : Limits.pullback.map ((γ ≫ ι').fromNormalization ≫ uX')
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uX'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      (γ ≫ ι').fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp) ≫
      Limits.pullback.fst uX' (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) =
      Limits.pullback.fst ((γ ≫ ι').fromNormalization ≫ uX')
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ≫
        (γ ≫ ι').fromNormalization :=
    Limits.pullback.lift_fst _ _ _
  have hImg : wcpaDjLkImg W (γ ≫ ι') uX' y' = (γ ≫ ι').fromNormalization
      (Limits.pullback.fst ((γ ≫ ι').fromNormalization ≫ uX')
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y') := by
    show (Limits.pullback.map ((γ ≫ ι').fromNormalization ≫ uX')
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uX'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
      (γ ≫ ι').fromNormalization (𝟙 _) (𝟙 _) (by simp) (by simp) ≫
      Limits.pullback.fst uX' (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) y' = _
    rw [hcomp]
    rfl
  have hz : Limits.pullback.fst ((γ ≫ ι').fromNormalization ≫ uX')
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) y' ∈
      (γ ≫ ι').fromNormalization ⁻¹ᵁ U' := by
    show (γ ≫ ι').fromNormalization _ ∈ U'
    rw [← hImg]
    exact h

  obtain ⟨haffC, hic⟩ := wcpa_dj_llsmgn_np_cover_sections Ω W C γ hcov X' uX' ι' hM U' hU' hgen'
  have hne : Nonempty ↥(((γ ≫ ι') ⁻¹ᵁ U' : C.Opens) : Set ↥C) := ⟨⟨genericPoint C, hgen'⟩⟩
  haveI := hic
  letI iDL : Algebra ↑Γ(C, (γ ≫ ι') ⁻¹ᵁ U') ↑C.functionField :=
    @AlgebraicGeometry.instAlgebraCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensFunctionFieldOfNonemptyToScheme
      C _ ((γ ≫ ι') ⁻¹ᵁ U') hne
  haveI : IsFractionRing ↑Γ(C, (γ ≫ ι') ⁻¹ᵁ U') ↑C.functionField :=
    @functionField_isFractionRing_of_isAffineOpen C _ _ haffC hne

  letI : Algebra ↑Γ(X', U') ↑Γ(C, (γ ≫ ι') ⁻¹ᵁ U') := ((γ ≫ ι').app U').hom.toAlgebra
  obtain ⟨Φ, hΦ⟩ := wcpa_dj_llsmgn_np_intclosure_transport ↑Γ(X', U') ↑Γ(C, (γ ≫ ι') ⁻¹ᵁ U')
    ↑C.functionField R e (fun y => by rw [he y]; rfl)
  let Ψ := (Iso.commRingCatIsoToRingEquiv ((γ ≫ ι').normalizationObjIso hU')).trans Φ
  have hA : ∀ y : ↑Γ(X', U'), Ψ (((γ ≫ ι').fromNormalization.app U').hom y) =
      algebraMap R ↥(integralClosure R ↑C.functionField) (e y) := by
    intro y
    have h1 : ((γ ≫ ι').normalizationObjIso hU').hom.hom
        (((γ ≫ ι').fromNormalization.app U').hom y) =
        algebraMap ↑Γ(X', U') ↥(integralClosure ↑Γ(X', U') ↑Γ(C, (γ ≫ ι') ⁻¹ᵁ U')) y := by
      rw [Scheme.Hom.fromNormalization_app _ hU']
      first
        | exact CategoryTheory.Iso.inv_hom_id_apply ((γ ≫ ι').normalizationObjIso hU') _
        | exact congrArg (fun φ => (CommRingCat.Hom.hom φ) (algebraMap ↑Γ(X', U')
            ↥(integralClosure ↑Γ(X', U') ↑Γ(C, (γ ≫ ι') ⁻¹ᵁ U')) y))
            ((γ ≫ ι').normalizationObjIso hU').inv_hom_id
        | (rw [← CommRingCat.comp_apply, Iso.inv_hom_id]; rfl)
    apply Subtype.ext
    show ((Φ (((γ ≫ ι').normalizationObjIso hU').hom.hom
      (((γ ≫ ι').fromNormalization.app U').hom y)) : ↥(integralClosure R ↑C.functionField)) :
        ↑C.functionField) = algebraMap R ↑C.functionField (e y)
    rw [h1, hΦ, he y]
    rfl

  have hV : IsAffineOpen ((γ ≫ ι').fromNormalization ⁻¹ᵁ U') := hU'.preimage _
  let 𝔮 : Ideal ↥(integralClosure R ↑C.functionField) :=
    Ideal.comap Ψ.symm (hV.primeIdealOf ⟨_, hz⟩).asIdeal
  haveI h𝔮 : 𝔮.IsPrime := Ideal.IsPrime.comap _
  refine ⟨𝔮, h𝔮, ?_, ?_⟩
