      ((X.presheaf.map (homOfLE hle).op).hom t')
    refine ⟨w, ?_⟩
    letI : Algebra Γ(X, U) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxU⟩
    haveI := hU.isLocalization_stalk ⟨x, hxU⟩
    have key := (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x)
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal _).mpr hw
    rw [map_sub] at key
