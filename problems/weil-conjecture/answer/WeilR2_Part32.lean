      (hSV : ∀ a ∈ S, a ∈ V) (f : K) (hf : S.subtype.IsIntegralElem f) : f ∈ V := by
    obtain ⟨P, hPm, hP⟩ := hf
    let ι : S →+* V := S.subtype.codRestrict V (fun a => hSV a a.2)
    have hint : IsIntegral V f := ⟨P.map ι, hPm.map ι, by
      rw [Polynomial.eval₂_map]; exact hP⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    rw [← hy]; exact y.2

  have s4 (Ω K : Type u) [Field Ω] [Field K] (W : ValuationSubring Ω) (c : Ω →+* K)
      (V : ValuationSubring K) (hCC : ∀ ω : Ω, c ω ∈ V ↔ ω ∈ W) (g : K)
      (hRT : ∀ q : Polynomial W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) g ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) g)⁻¹ ∈ V)
      (R : Polynomial Ω) (hR : R.eval₂ c g ∈ V) : ∀ i, R.coeff i ∈ W := by
    classical
    by_cases hR0 : R = 0
    · intro i; rw [hR0, Polynomial.coeff_zero]; exact W.zero_mem
    obtain ⟨j, hj, hjmax⟩ := Finset.exists_max_image R.support
      (fun i => W.valuation (R.coeff i)) (Polynomial.support_nonempty.mpr hR0)
    have hrj : R.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
    have hdiv : ∀ i, R.coeff i / R.coeff j ∈ W := by
      intro i
      by_cases hi : i ∈ R.support
      · rw [← ValuationSubring.valuation_le_one_iff, map_div₀]
        exact div_le_one_of_le₀ (hjmax i hi) zero_le'
      · rw [Polynomial.notMem_support_iff.mp hi, zero_div]; exact W.zero_mem
    have hlift : Polynomial.C (R.coeff j)⁻¹ * R ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      refine ⟨⟨R.coeff i / R.coeff j, hdiv i⟩, ?_⟩
      rw [Polynomial.coeff_C_mul, ValuationSubring.coe_subtype]
      simp [div_eq_inv_mul]
    obtain ⟨q, hq⟩ := Polynomial.mem_lifts _ |>.mp hlift
    have hqj : q.coeff j = 1 := by
      apply Subtype.ext
      have := congrArg (fun p => Polynomial.coeff p j) hq
      simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at this
      rw [inv_mul_cancel₀ hrj] at this
      simpa using this
    obtain ⟨hq0, hqinv⟩ := hRT q ⟨j, by rw [hqj]; exact isUnit_one⟩
    have hqe : q.eval₂ (c.comp W.subtype) g = c (R.coeff j)⁻¹ * R.eval₂ c g := by
      rw [← Polynomial.eval₂_map, hq, Polynomial.eval₂_mul, Polynomial.eval₂_C]
    have hRg0 : R.eval₂ c g ≠ 0 := by
      intro h0; apply hq0; rw [hqe, h0, mul_zero]
    have hcj : c (R.coeff j) = R.eval₂ c g * (q.eval₂ (c.comp W.subtype) g)⁻¹ := by
      rw [hqe, map_inv₀]
      have : c (R.coeff j) ≠ 0 := (map_ne_zero c).mpr hrj
      field_simp
    have hjW : R.coeff j ∈ W := (hCC _).mp (by rw [hcj]; exact V.mul_mem _ _ hR hqinv)
    intro i
    have : R.coeff i = R.coeff j * (R.coeff i / R.coeff j) := by field_simp
    rw [this]; exact W.mul_mem _ _ hjW (hdiv i)

  have s2 (Ω K : Type u) [Field Ω] [Field K] (W : ValuationSubring Ω) (c : Ω →+* K) (h : K)
      (ϖ : W) (hh : h ≠ 0) :
      ∀ a ∈ (MvPolynomial.eval₂Hom (c.comp W.subtype) ![h, c (ϖ : Ω) * h⁻¹]).range,
        ∃ (R : Polynomial Ω) (M : ℕ), a * h ^ M = R.eval₂ c h := by
    rintro a ⟨p, rfl⟩
    induction p using MvPolynomial.induction_on with
    | C w => exact ⟨Polynomial.C (w : Ω), 0, by simp⟩
    | add p q hp hq =>
      obtain ⟨R₁, M₁, h₁⟩ := hp
      obtain ⟨R₂, M₂, h₂⟩ := hq
      refine ⟨R₁ * Polynomial.X ^ M₂ + R₂ * Polynomial.X ^ M₁, M₁ + M₂, ?_⟩
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow,
        Polynomial.eval₂_X_pow, ← h₁, ← h₂, map_add]
      ring
    | mul_X p n hp =>
      obtain ⟨R, M, hR⟩ := hp
      fin_cases n
      · refine ⟨R * Polynomial.X, M, ?_⟩
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, ← hR]
        simp
        ring
      · refine ⟨Polynomial.C (ϖ : Ω) * R, M + 1, ?_⟩
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, ← hR]
        simp
        field_simp
        ring

  have s6 (Ω K : Type u) [Field Ω] [Field K] (W : ValuationSubring Ω) (c : Ω →+* K) (h : K)
      (ϖ : W) (hh : h ≠ 0) (hϖ : (ϖ : Ω) ≠ 0) (f : K) (R : Polynomial Ω) (N : ℕ)
      (hf : f * h ^ N = R.eval₂ c h) (h1 : ∀ i, R.coeff i ∈ W)
      (h2 : ∀ i, i < N → R.coeff i / (ϖ : Ω) ^ (N - i) ∈ W) :
      f ∈ (MvPolynomial.eval₂Hom (c.comp W.subtype) ![h, c (ϖ : Ω) * h⁻¹]).range := by
    have hhN : h ^ N ≠ 0 := pow_ne_zero _ hh
    have hf' : f = ∑ i ∈ Finset.range (R.natDegree + 1), c (R.coeff i) * h ^ i * (h ^ N)⁻¹ := by
      rw [← Finset.sum_mul, ← Polynomial.eval₂_eq_sum_range, ← hf, mul_inv_cancel_right₀ hhN]
    rw [hf']
    refine Subring.sum_mem _ (fun i _ => ?_)
    rcases le_or_gt N i with hNi | hiN
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hNi
      refine ⟨MvPolynomial.C ⟨R.coeff (N + d), h1 _⟩ * MvPolynomial.X 0 ^ d, ?_⟩
      simp only [map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        RingHom.coe_comp, Function.comp_apply, Matrix.cons_val_zero]
      simp only [ValuationSubring.coe_subtype]
      rw [pow_add]
      field_simp
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hiN
      have hd : i + d + 1 - i = d + 1 := by omega
      refine ⟨MvPolynomial.C ⟨R.coeff i / (ϖ : Ω) ^ (d + 1), hd ▸ h2 i hiN⟩ *
        MvPolynomial.X 1 ^ (d + 1), ?_⟩
      simp only [map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        RingHom.coe_comp, Function.comp_apply, Matrix.cons_val_one, Matrix.cons_val_zero]
      simp only [ValuationSubring.coe_subtype, map_div₀, map_pow]
      have hcϖ : c (ϖ : Ω) ≠ 0 := (map_ne_zero c).mpr hϖ
      rw [pow_add, pow_add]
      simp only [inv_pow, mul_pow]
      field_simp
      ring

  have s3 (Ω K : Type u) [Field Ω] [Field K] (c : Ω →+* K) (h : K)
      (htr : ∀ p : Polynomial Ω, p.eval₂ c h = 0 → p = 0)
      (hfr : ∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ c h ≠ 0 ∧ f * q.eval₂ c h = p.eval₂ c h)
      (S : Subring K) (hS : ∀ a ∈ S, ∃ (R : Polynomial Ω) (M : ℕ), a * h ^ M = R.eval₂ c h)
      (f : K) (hf : S.subtype.IsIntegralElem f) :
      ∃ (R : Polynomial Ω) (N : ℕ), f * h ^ N = R.eval₂ c h := by
    classical
    obtain ⟨P, hPm, hP⟩ := hf
    choose Rf Mf hRM using fun a : S => hS a a.2
    set n := P.natDegree with hn
    set M := ∑ i ∈ Finset.range n, Mf (P.coeff i) with hM
    let φ : Polynomial Ω →+* K := Polynomial.eval₂RingHom c h
    have hφ : ∀ p : Polynomial Ω, φ p = p.eval₂ c h := fun p => rfl
    letI : Algebra (Polynomial Ω) K := φ.toAlgebra
    have hφinj : Function.Injective φ := (injective_iff_map_eq_zero φ).mpr htr
    haveI : FaithfulSMul (Polynomial Ω) K :=
      (faithfulSMul_iff_algebraMap_injective (Polynomial Ω) K).mpr hφinj
    haveI : IsFractionRing (Polynomial Ω) K := IsFractionRing.of_field _ _ (fun z => by
      obtain ⟨p, q, hq, hzq⟩ := hfr z
      exact ⟨p, q, eq_div_of_mul_eq hq hzq⟩)
    set P' : Polynomial K := P.map S.subtype with hP'
    have hP'deg : P'.natDegree = n := hPm.natDegree_map S.subtype
    have hP'm : P'.Monic := hPm.map S.subtype
    have hP'eval : P'.eval₂ (RingHom.id K) f = 0 := by
      rw [hP', Polynomial.eval₂_map, RingHom.id_comp]; exact hP
    set P'' := P'.scaleRoots (h ^ M) with hP''
    have hP''m : P''.Monic := (Polynomial.monic_scaleRoots_iff _).mpr hP'm
    have hP''eval : P''.eval₂ (RingHom.id K) (h ^ M * f) = 0 :=
      Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id K) hP'eval
    have hlift : P'' ∈ Polynomial.lifts φ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [hP'', Polynomial.coeff_scaleRoots, hP'deg, hP', Polynomial.coeff_map]
      rcases lt_trichotomy i n with hi | hi | hi
      · have hle : Mf (P.coeff i) ≤ M :=
          Finset.single_le_sum (f := fun j => Mf (P.coeff j)) (fun _ _ => Nat.zero_le _)
            (Finset.mem_range.mpr hi)
        have hle2 : M ≤ M * (n - i) := Nat.le_mul_of_pos_right _ (by omega)
        refine ⟨Rf (P.coeff i) * Polynomial.X ^ (M * (n - i) - Mf (P.coeff i)), ?_⟩
        rw [hφ, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow, ← hRM, mul_assoc, ← pow_add,
          Nat.add_sub_cancel' (hle.trans hle2), ← pow_mul]
        rfl
      · refine ⟨1, ?_⟩
        rw [map_one, hi, Nat.sub_self, pow_zero, mul_one]
        have : P.coeff n = 1 := hPm.coeff_natDegree
        rw [this]; rfl
      · refine ⟨0, ?_⟩
        rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt hi]
        simp
    obtain ⟨Q, hQ, -, hQm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hP''m
    have hint : IsIntegral (Polynomial Ω) (h ^ M * f) := ⟨Q, hQm, by
      rw [Polynomial.eval₂_eq_eval_map]
      change Polynomial.eval _ (Q.map φ) = 0
      rw [hQ]; exact hP''eval⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    exact ⟨y, M, by rw [mul_comm]; exact hy.symm⟩


  have main (Ω K : Type u) [Field Ω] [Field K] (W : ValuationSubring Ω) (c : Ω →+* K)
      (V₁ V₂ : ValuationSubring K) (h : K) (ϖ : W)
      (hCC₁ : ∀ ω : Ω, c ω ∈ V₁ ↔ ω ∈ W) (hCC₂ : ∀ ω : Ω, c ω ∈ V₂ ↔ ω ∈ W)
      (htr : ∀ p : Polynomial Ω, p.eval₂ c h = 0 → p = 0)
      (hfr : ∀ f : K, ∃ p q : Polynomial Ω, q.eval₂ c h ≠ 0 ∧ f * q.eval₂ c h = p.eval₂ c h)
      (hϖ : ϖ ≠ 0)
      (hRT₁ : h ∈ (V₁ : Set K) ∧ ∀ q : Polynomial W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) h ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) h)⁻¹ ∈ (V₁ : Set K))
      (hRT₂ : c ((ϖ : Ω)⁻¹) * h ∈ (V₂ : Set K) ∧ ∀ q : Polynomial W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) (c ((ϖ : Ω)⁻¹) * h) ≠ 0 ∧
        (q.eval₂ (c.comp W.subtype) (c ((ϖ : Ω)⁻¹) * h))⁻¹ ∈ (V₂ : Set K))
      (f : K)
      (hf : (MvPolynomial.eval₂Hom (c.comp W.subtype) ![h, c (ϖ : Ω) * h⁻¹]).range.subtype.IsIntegralElem f) :
      f ∈ (MvPolynomial.eval₂Hom (c.comp W.subtype) ![h, c (ϖ : Ω) * h⁻¹]).range := by
    have rtinv : ∀ (V : ValuationSubring K) (g : K), (∀ q : Polynomial W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) g ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) g)⁻¹ ∈ (V : Set K)) →
        g ≠ 0 ∧ g⁻¹ ∈ V := by
      intro V g hg
      have := hg Polynomial.X ⟨1, by rw [Polynomial.coeff_X_one]; exact isUnit_one⟩
      rw [Polynomial.eval₂_X] at this
      exact this
    obtain ⟨hh0, hhinv1⟩ := rtinv V₁ h hRT₁.2
    obtain ⟨hk0, hkinv2⟩ := rtinv V₂ _ hRT₂.2
    have hϖ0 : (ϖ : Ω) ≠ 0 := fun h0 => hϖ (Subtype.ext h0)
    have hkinv : (c ((ϖ : Ω)⁻¹) * h)⁻¹ = c (ϖ : Ω) * h⁻¹ := by
      rw [mul_inv_rev, map_inv₀, inv_inv, mul_comm]
    have hhk : c (ϖ : Ω) * (c ((ϖ : Ω)⁻¹) * h) = h := by
      rw [← mul_assoc, ← map_mul, mul_inv_cancel₀ hϖ0, map_one, one_mul]
    have hh2 : h ∈ V₂ := by
      rw [← hhk]; exact V₂.mul_mem _ _ ((hCC₂ _).mpr ϖ.2) hRT₂.1
    have hsub : ∀ (V : ValuationSubring K), (∀ ω : Ω, c ω ∈ V ↔ ω ∈ W) → h ∈ V →
        c (ϖ : Ω) * h⁻¹ ∈ V →
        ∀ a ∈ (MvPolynomial.eval₂Hom (c.comp W.subtype) ![h, c (ϖ : Ω) * h⁻¹]).range, a ∈ V := by
      intro V hCC hhV hϖV
      rintro a ⟨p, rfl⟩
      induction p using MvPolynomial.induction_on with
      | C w =>
        rw [MvPolynomial.eval₂Hom_C]
        exact (hCC _).mpr w.2
      | add p q hp hq => rw [map_add]; exact V.add_mem _ _ hp hq
      | mul_X p n hp =>
        rw [map_mul, MvPolynomial.eval₂Hom_X']
        refine V.mul_mem _ _ hp ?_
        fin_cases n
        · exact hhV
        · exact hϖV
    have hA1 := hsub V₁ hCC₁ hRT₁.1 (V₁.mul_mem _ _ ((hCC₁ _).mpr ϖ.2) hhinv1)
    have hA2 := hsub V₂ hCC₂ hh2 (by rw [← hkinv]; exact hkinv2)
    have hf1 := s5 K _ V₁ hA1 f hf
    have hf2 := s5 K _ V₂ hA2 f hf
    obtain ⟨R, N, hRN⟩ := s3 Ω K c h htr hfr _ (s2 Ω K W c h ϖ hh0) f hf
    have hc1 : ∀ i, R.coeff i ∈ W := s4 Ω K W c V₁ hCC₁ h hRT₁.2 R (by
      rw [← hRN]; exact V₁.mul_mem _ _ hf1 (V₁.pow_mem hRT₁.1 N))
    set R' : Polynomial Ω := Polynomial.C (((ϖ : Ω) ^ N)⁻¹) *
      R.comp (Polynomial.C (ϖ : Ω) * Polynomial.X) with hR'
    have hR'eval : R'.eval₂ c (c ((ϖ : Ω)⁻¹) * h) = f * (c ((ϖ : Ω)⁻¹) * h) ^ N := by
      rw [hR', Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_comp, Polynomial.eval₂_mul,
        Polynomial.eval₂_C, Polynomial.eval₂_X, hhk, ← hRN]
      simp only [map_inv₀, map_pow, mul_pow, inv_pow]
      have : c (ϖ : Ω) ^ N ≠ 0 := pow_ne_zero _ ((map_ne_zero c).mpr hϖ0)
      field_simp
    have hc2 : ∀ i, R'.coeff i ∈ W := s4 Ω K W c V₂ hCC₂ _ hRT₂.2 R' (by
      rw [hR'eval]; exact V₂.mul_mem _ _ hf2 (V₂.pow_mem hRT₂.1 N))
    refine s6 Ω K W c h ϖ hh0 hϖ0 f R N hRN hc1 (fun i hi => ?_)
    have e : R.coeff i / (ϖ : Ω) ^ (N - i) = R'.coeff i := by
      rw [hR', Polynomial.coeff_C_mul, Polynomial.comp_C_mul_X_coeff]
      have : (ϖ : Ω) ^ N = (ϖ : Ω) ^ (N - i) * (ϖ : Ω) ^ i := by
        rw [← pow_add, Nat.sub_add_cancel hi.le]
      rw [this]
      field_simp
    rw [e]; exact hc2 i
  have s0 (Ω K : Type u) [Field Ω] [Field K] (W : ValuationSubring Ω) (c : Ω →+* K) (g : K)
      (hRT : ∀ q : Polynomial W, (∃ i, IsUnit (q.coeff i)) →
        q.eval₂ (c.comp W.subtype) g ≠ 0 ∧ (q.eval₂ (c.comp W.subtype) g)⁻¹ ∈ (⊤ : Set K)) :
      ∀ R : Polynomial Ω, R.eval₂ c g = 0 → R = 0 := by
    classical
    intro R hR
    by_contra hR0
    obtain ⟨j, hj, hjmax⟩ := Finset.exists_max_image R.support
      (fun i => W.valuation (R.coeff i)) (Polynomial.support_nonempty.mpr hR0)
    have hrj : R.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
    have hdiv : ∀ i, R.coeff i / R.coeff j ∈ W := by
      intro i
      by_cases hi : i ∈ R.support
      · rw [← ValuationSubring.valuation_le_one_iff, map_div₀]
        exact div_le_one_of_le₀ (hjmax i hi) zero_le
      · rw [Polynomial.notMem_support_iff.mp hi, zero_div]; exact W.zero_mem
    have hlift : Polynomial.C (R.coeff j)⁻¹ * R ∈ Polynomial.lifts W.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      refine ⟨⟨R.coeff i / R.coeff j, hdiv i⟩, ?_⟩
      rw [Polynomial.coeff_C_mul, ValuationSubring.coe_subtype]
      simp [div_eq_inv_mul]
    obtain ⟨q, hq⟩ := Polynomial.mem_lifts _ |>.mp hlift
    have hqj : q.coeff j = 1 := by
      apply Subtype.ext
      have := congrArg (fun p => Polynomial.coeff p j) hq
      simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul] at this
      rw [inv_mul_cancel₀ hrj] at this
      simpa using this
    obtain ⟨hq0, -⟩ := hRT q ⟨j, by rw [hqj]; exact isUnit_one⟩
    apply hq0
    rw [← Polynomial.eval₂_map, hq, Polynomial.eval₂_mul, Polynomial.eval₂_C, hR, mul_zero]
  intro Ω _ _ W _ V₁ V₂ q1 q2 q3 h ϖ hCC₁ hCC₂ hmob hϖ _hϖm hRT₁ hRT₂ f hf
  exact main Ω (wcProjK Ω 1).functionField W (wcLr1uConst (wcProjKStr Ω 1)) V₁ V₂ h ϖ hCC₁ hCC₂
    (s0 Ω (wcProjK Ω 1).functionField W (wcLr1uConst (wcProjKStr Ω 1)) h
      (fun q hq => ⟨(hRT₁.2 q hq).1, Set.mem_univ _⟩))
    hmob.2.2.2 hϖ hRT₁ hRT₂ f hf

