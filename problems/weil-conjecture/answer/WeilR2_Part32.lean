        exact hw i
      apply le_antisymm
      · exact iSup_le fun n => iSup_le fun v => iSup_le fun h => hle n _ ((hcond n v).mp h)
      · rcases lt_or_ge (Module.rank K (W ⧸ P.comap W.subtype)) Cardinal.aleph0 with h | h
        · obtain ⟨k, hk⟩ := Cardinal.lt_aleph0.mp h
          rw [hk, Cardinal.toENat_nat]
          exact hge k hk.ge
        · rw [Cardinal.toENat_eq_top.mpr h]
          exact (ENat.eq_top_iff_forall_ge.mpr
            (fun m => hge m ((Cardinal.natCast_lt_aleph0 (n := m)).le.trans h))).ge

    have B2 : ∀ {M M' : Type u} [AddCommGroup M] [Module K M] [AddCommGroup M'] [Module K M']
        (μ : M →ₗ[K] M') (_ : Function.Injective μ) (S : Submodule K M) (S' R : Submodule K M')
        (_ : S' ≤ R) (_ : ∀ x, μ x ∈ S' ↔ x ∈ S)
        (_ : ∀ b ∈ R, ∃ f ∈ S', f - b ∈ LinearMap.range μ),
        Cardinal.toENat (Module.rank K S') = Cardinal.toENat (Module.rank K S) +
          Cardinal.toENat (Module.rank K (R ⧸ (LinearMap.range μ).comap R.subtype)) := by
      intro M M' _ _ _ _ μ hμ S S' R hS'R hiff hlift
      let π : S' →ₗ[K] R ⧸ (LinearMap.range μ).comap R.subtype :=
        ((LinearMap.range μ).comap R.subtype).mkQ ∘ₗ Submodule.inclusion hS'R
      have hπ : ∀ f : S', π f = 0 ↔ (f : M') ∈ LinearMap.range μ := by
        intro f
        simp only [π, LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
          Submodule.mem_comap, Submodule.subtype_apply, Submodule.coe_inclusion]
      have hsurj : Function.Surjective π := by
        intro q
        obtain ⟨⟨b, hb⟩, rfl⟩ := Submodule.mkQ_surjective _ q
        obtain ⟨f, hf, hfb⟩ := hlift b hb
        refine ⟨⟨f, hf⟩, ?_⟩
        simp only [π, LinearMap.comp_apply, Submodule.mkQ_apply]
        rw [Submodule.Quotient.eq, Submodule.mem_comap, map_sub]
        exact hfb
      let g : S →ₗ[K] LinearMap.ker π :=
        { toFun := fun x => ⟨⟨μ x, (hiff x).2 x.2⟩, (hπ _).2 ⟨x, rfl⟩⟩
          map_add' := fun x y => by ext; simp
          map_smul' := fun c x => by ext; simp }
      have hg : Function.Bijective g := by
        constructor
        · intro x y hxy
          have h1 : μ x = μ y := congrArg (fun z : LinearMap.ker π => ((z.1 : S') : M')) hxy
          exact Subtype.ext (hμ h1)
        · rintro ⟨⟨f, hf⟩, hk⟩
          obtain ⟨x, rfl⟩ := (hπ _).1 hk
          exact ⟨⟨x, (hiff x).1 hf⟩, rfl⟩
      have e1 := (LinearEquiv.ofBijective g hg).rank_eq
      have e2 := LinearMap.rank_range_add_rank_ker π
      rw [rank_range_of_surjective π hsurj, ← e1] at e2
      rw [← e2, map_add, add_comm]
    have hbot : ∀ {V : Type u} [AddCommGroup V] [Module K V] (W : Submodule K V),
        Module.rank K (W ⧸ (⊥ : Submodule K V).comap W.subtype) = Module.rank K W := by
      intro V _ _ W
      exact (Submodule.quotEquivOfEqBot _ (by rw [Submodule.comap_bot, Submodule.ker_subtype])).rank_eq

    letI iM : Module K (∀ a, A a) := (Pi.ringHom s).toModule
    letI iM' : Module K (∀ a, A' a) := (Pi.ringHom s').toModule
    have hsum : ∀ (n : ℕ) (c : Fin n → K) (v : Fin n → ∀ a, A a) (a : Fin (N + 1)),
        (∑ i, c i • v i) a = ∑ i, s a (c i) * v i a := by
      intro n c v a
      rw [Finset.sum_apply]
      rfl
    have hsum' : ∀ (n : ℕ) (c : Fin n → K) (v : Fin n → ∀ a, A' a) (a : Fin (N + 1)),
        (∑ i, c i • v i) a = ∑ i, s' a (c i) * v i a := by
      intro n c v a
      rw [Finset.sum_apply]
      rfl
    let SK : Submodule K (∀ a, A a) :=
      { carrier := S
        add_mem' := fun {x y} hx hy => hSadd x hx y hy
        zero_mem' := hS0
        smul_mem' := fun c x hx => hSsm c x hx }
    let S'K : Submodule K (∀ a, A' a) :=
      { carrier := S'
        add_mem' := fun {x y} hx hy => hS'add x hx y hy
        zero_mem' := hS'0
        smul_mem' := fun c x hx => hS'sm c x hx }
    let RK : Submodule K (∀ a, A' a) :=
      { carrier := R
        add_mem' := fun {x y} hx hy => hRadd x hx y hy
        zero_mem' := hR0
        smul_mem' := fun c x hx => hRsm c x hx }
    let μ : (∀ a, A a) →ₗ[K] (∀ a, A' a) :=
      { toFun := fun x a => ψ a (x a)
        map_add' := fun x y => by funext a; simp
        map_smul' := fun c x => by
          funext a
          show ψ a (s a c * x a) = s' a c * ψ a (x a)
          rw [map_mul, hψs] }
    have hμ : Function.Injective μ := fun x y h => funext fun a => hinjψ a (congrFun h a)
    have hrange : ∀ y : ∀ a, A' a, y ∈ LinearMap.range μ ↔ ∀ a, y a ∈ Set.range (ψ a) := by
      intro y
      constructor
      · rintro ⟨x, rfl⟩ a
        exact ⟨x a, rfl⟩
      · intro h
        choose x hx using h
        exact ⟨x, funext hx⟩
    have e1 := B1 S'K ⊥ S' rfl
      (fun n v c => ∀ a, ∑ i, s' a (c i) * (v i).1 a = 0) (by
        intro n v c
        rw [Submodule.mem_bot, funext_iff]
        simp only [hsum', Pi.zero_apply])
    have e2 := B1 SK ⊥ S rfl
      (fun n v c => ∀ a, ∑ i, s a (c i) * (v i).1 a = 0) (by
        intro n v c
        rw [Submodule.mem_bot, funext_iff]
        simp only [hsum, Pi.zero_apply])
    have e3 := B1 RK (LinearMap.range μ) R rfl
      (fun n v c => ∀ a, ∑ i, s' a (c i) * (v i).1 a ∈ Set.range (ψ a)) (by
        intro n v c
        rw [hrange]
        simp only [hsum'])
    rw [hbot] at e1 e2
    have key := B2 μ hμ SK S'K RK (fun x hx => hS'R hx) hiff (by
      intro b hb
      obtain ⟨f, hf, hfb⟩ := hlift b hb
      exact ⟨f, hf, (hrange _).2 hfb⟩)
    exact e1.trans (key.trans (congrArg₂ (· + ·) e2 e3).symm)

  have H1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V V' : X.Opens) (hV : V ≤ f ⁻¹ᵁ U)
      (h : V' ≤ V) (x : Γ(Y, U)),
      (X.presheaf.map (homOfLE h).op).hom ((f.appLE U V hV).hom x) =
        (f.appLE U V' (h.trans hV)).hom x := by
    intro X Y f U V V' hV h x
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  have H2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U U' : Y.Opens) (V : X.Opens) (hV : V ≤ f ⁻¹ᵁ U')
      (h : U' ≤ U) (x : Γ(Y, U)),
      (f.appLE U' V hV).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
        (f.appLE U V (hV.trans (Scheme.Hom.preimage_mono f h))).hom x := by
    intro X Y f U U' V hV h x
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have H3 : ∀ {X : Scheme.{u}} (U V W : X.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have H4 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (x : Γ(Y, U)),
      (f.app U).hom x = (f.appLE U (f ⁻¹ᵁ U) le_rfl).hom x := by
    intro X Y f U x
    rw [Scheme.Hom.app_eq_appLE]
  have H5 : ∀ {X Y T : Scheme.{u}} (f : X ⟶ Y) (g' : Y ⟶ T) (U : T.Opens) (V : Y.Opens)
      (W : X.Opens) (e₁ : V ≤ g' ⁻¹ᵁ U) (e₂ : W ≤ f ⁻¹ᵁ V) (e₃ : W ≤ (f ≫ g') ⁻¹ᵁ U)
      (x : Γ(T, U)),
      (f.appLE V W e₂).hom ((g'.appLE U V e₁).hom x) = ((f ≫ g').appLE U W e₃).hom x := by
    intro X Y T f g' U V W e₁ e₂ e₃ x
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
  have hG0 : ∀ {T : Scheme.{u}} (φ : T ⟶ wcProjK κ N) (a c : Fin (N + 1)),
      wcEszG φ a c = (φ.appLE (wcSgD κ N c) (φ ⁻¹ᵁ wcSgD κ N a ⊓ φ ⁻¹ᵁ wcSgD κ N c)
        inf_le_right).hom (wcSgE κ N c a) := by
    intro T φ a c
    unfold wcEszG
    rw [H4, H1]
  have hVr : ∀ x y : Fin (N + 1),
      ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) ≤ (ν ≫ j) ⁻¹ᵁ wcSgD κ N y :=
    fun x y => (inf_le_right : (ν ≫ j) ⁻¹ᵁ wcSgD κ N x ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N y ≤ _)
  have hψG : ∀ (x y : Fin (N + 1)) (W' : Zt.Opens)
      (h : W' ≤ ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y)),
      (ν.appLE (j ⁻¹ᵁ wcSgD κ N x ⊓ j ⁻¹ᵁ wcSgD κ N y) W' h).hom (wcEszG j x y) =
        ((ν ≫ j).appLE (wcSgD κ N y) W' (h.trans (hVr x y))).hom (wcSgE κ N y x) := by
    intro x y W' h
    rw [hG0]
    exact H5 _ _ _ _ _ _ _ _ _
  have hinjW : ∀ W : Z.Opens, Function.Injective (ν.appLE W (ν ⁻¹ᵁ W) le_rfl).hom := by
    intro W x y hxy
    apply hinj W
    rw [← Scheme.Hom.appLE_eq_app]
    exact hxy

  have Hscal : ∀ {T : Scheme.{u}} (φ : T ⟶ wcProjK κ N) (V W : T.Opens) (h : W ≤ V) (c : κ),
      (T.presheaf.map (homOfLE h).op).hom (wcEszScal φ V c) = wcEszScal φ W c := by
    intro T φ V W h c
    unfold wcEszScal
    simp only [RingHom.comp_apply]
    rw [H3]

  have hs2 : ∀ (U : Z.Opens) (V : Zt.Opens) (h : V ≤ ν ⁻¹ᵁ U) (c : κ),
      (ν.appLE U V h).hom (wcEszScal j U c) = wcEszScal (ν ≫ j) V c := by
    intro U V h c
    have hT : ∀ z, (((ν ≫ j) ≫ wcProjKStr κ N).appTop).hom z =
        (ν.app ⊤).hom (((j ≫ wcProjKStr κ N).appTop).hom z) := by
      intro z
      rw [Category.assoc, Scheme.Hom.comp_appTop ν (j ≫ wcProjKStr κ N)]
      rfl
    have key : ∀ y : Γ(Z, ⊤), (Zt.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
        ((ν.app ⊤).hom y) = (ν.appLE ⊤ V (h.trans (Scheme.Hom.preimage_mono ν le_top))).hom y := by
      intro y
      rw [H4]
      exact H1 ν ⊤ (ν ⁻¹ᵁ ⊤) V le_rfl le_top y
    unfold wcEszScal
    simp only [RingHom.comp_apply]
    rw [H2, hT, key]

  have hsec0 : ∀ {T : Scheme.{u}} (φ : T ⟶ wcProjK κ N),
      (0 : ∀ a : Fin (N + 1), Γ(T, φ ⁻¹ᵁ wcSgD κ N a)) ∈ wcGcDfSec φ e := by
    intro T φ
    simp only [wcGcDfSec, Set.mem_ofPred_eq]
    intro a b
    simp only [Pi.zero_apply, map_zero, mul_zero]
  have hsecadd : ∀ {T : Scheme.{u}} (φ : T ⟶ wcProjK κ N), ∀ x ∈ wcGcDfSec φ e,
      ∀ y ∈ wcGcDfSec φ e, x + y ∈ wcGcDfSec φ e := by
    intro T φ x hx y hy
    simp only [wcGcDfSec, Set.mem_ofPred_eq] at hx hy ⊢
    intro a b
    simp only [Pi.add_apply, map_add, hx a b, hy a b, mul_add]
  have hsecsm : ∀ {T : Scheme.{u}} (φ : T ⟶ wcProjK κ N) (c : κ), ∀ x ∈ wcGcDfSec φ e,
      (fun a => wcEszScal φ (φ ⁻¹ᵁ wcSgD κ N a) c * x a) ∈ wcGcDfSec φ e := by
    intro T φ c x hx
    simp only [wcGcDfSec, Set.mem_ofPred_eq] at hx ⊢
    intro a b
    rw [map_mul, map_mul, hx a b, Hscal, Hscal]
    ring

  have hrel0 : (0 : ∀ a : Fin (N + 1), Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a)) ∈ wcGcSjRelSec j ν e := by
    simp only [wcGcSjRelSec, Set.mem_ofPred_eq]
    intro a c
    refine ⟨0, ?_⟩
    refine Eq.trans ?_ (map_zero (ν.appLE (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N c)
      ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N c) le_rfl).hom).symm
    simp only [Pi.zero_apply, map_zero, mul_zero, sub_zero]
  have hreladd : ∀ x ∈ wcGcSjRelSec j ν e, ∀ y ∈ wcGcSjRelSec j ν e,
      x + y ∈ wcGcSjRelSec j ν e := by
    intro x hx y hy
    simp only [wcGcSjRelSec, Set.mem_ofPred_eq] at hx hy ⊢
    intro a c
    obtain ⟨g1, hg1⟩ := hx a c
    obtain ⟨g2, hg2⟩ := hy a c
    refine ⟨g1 + g2, ?_⟩
    rw [map_add, ← hg1, ← hg2]
    simp only [Pi.add_apply, map_add]
    ring
  have hrelsm : ∀ (c : κ), ∀ x ∈ wcGcSjRelSec j ν e,
      (fun a => wcEszScal (ν ≫ j) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) c * x a) ∈ wcGcSjRelSec j ν e := by
    intro c x hx
    simp only [wcGcSjRelSec, Set.mem_ofPred_eq] at hx ⊢
    intro a b
    obtain ⟨g, hg⟩ := hx a b
    refine ⟨wcEszScal j (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b) c * g, ?_⟩
    have h2 := hs2 (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b)
      ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N b) le_rfl c
    have hm := map_mul (ν.appLE (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b)
      ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N b) le_rfl).hom
      (wcEszScal j (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b) c) g
    have e2 := hm.trans (congrArg₂ (· * ·) h2 hg.symm)
    refine Eq.trans ?_ e2.symm
    rw [map_mul, map_mul, Hscal, Hscal]
    ring
  have hS'R : wcGcDfSec (ν ≫ j) e ⊆ wcGcSjRelSec j ν e := by
    intro f hf
    simp only [wcGcDfSec, Set.mem_ofPred_eq] at hf
    simp only [wcGcSjRelSec, Set.mem_ofPred_eq]
    intro a c
    refine ⟨0, ?_⟩
    rw [map_zero, hf a c, sub_self]

  have hiff : ∀ x : ∀ a : Fin (N + 1), Γ(Z, j ⁻¹ᵁ wcSgD κ N a),
      (fun a => (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom (x a)) ∈
        wcGcDfSec (ν ≫ j) e ↔ x ∈ wcGcDfSec j e := by
    intro x
    simp only [wcGcDfSec, Set.mem_ofPred_eq]
    refine forall_congr' fun a => forall_congr' fun b => ?_
    refine Iff.trans ?_ (hinjW (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b)).eq_iff
    have eL1 := H1 ν (j ⁻¹ᵁ wcSgD κ N b) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N b)
      ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N b) le_rfl inf_le_right (x b)
    have eL2 := H1 ν (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a)
      ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a ⊓ (ν ≫ j) ⁻¹ᵁ wcSgD κ N b) le_rfl inf_le_left (x a)
    have eR1 := H2 ν (j ⁻¹ᵁ wcSgD κ N b) (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b)
      (ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b)) le_rfl inf_le_right (x b)
    have eR2 := H2 ν (j ⁻¹ᵁ wcSgD κ N a) (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b)
      (ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N a ⊓ j ⁻¹ᵁ wcSgD κ N b)) le_rfl inf_le_left (x a)
    have eG' := hG0 (ν ≫ j) a b
    have eG := hψG a b _ le_rfl
    rw [map_mul, map_pow, eR1, eR2, eG, eL1, eL2, eG']
    exact Iff.rfl

  unfold wcGcDfRk wcGcSjQRk
  exact S6 κ N (fun a => Γ(Z, j ⁻¹ᵁ wcSgD κ N a)) (fun a => Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a))
    (fun a => wcEszScal j (j ⁻¹ᵁ wcSgD κ N a))
    (fun a => wcEszScal (ν ≫ j) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a))
    (fun a => (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom)
    (wcGcDfSec j e) (wcGcDfSec (ν ≫ j) e) (wcGcSjRelSec j ν e)
    (fun a => hinjW (j ⁻¹ᵁ wcSgD κ N a))
    (fun a c => hs2 (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl c)
    (hsec0 j) (hsecadd j) (hsecsm j)
    (hsec0 (ν ≫ j)) (hsecadd (ν ≫ j)) (hsecsm (ν ≫ j))
    hrel0 hreladd hrelsm hS'R hiff hlift

theorem wcpa_dj_lr1k_ll_gc_sk_chart_normalization : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ]
    (Z : Scheme.{u}) {N : ℕ} (j : Z ⟶ wcProjK κ N), IsClosedImmersion j →
    AlgebraicGeometry.IsReduced Z → topologicalKrullDim ↥Z ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (Zt : Scheme.{u}) (ν : Zt ⟶ Z), wcGcNormDatum ν → ∀ a : Fin (N + 1),
    _root_.IsReduced Γ(Z, j ⁻¹ᵁ wcSgD κ N a) ∧ IsNoetherianRing Γ(Z, j ⁻¹ᵁ wcSgD κ N a) ∧
    ringKrullDim Γ(Z, j ⁻¹ᵁ wcSgD κ N a) ≤ ((1 : ℕ) : WithBot ℕ∞) ∧
    (letI : Algebra κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := (wcEszScal j (j ⁻¹ᵁ wcSgD κ N a)).toAlgebra
     Algebra.FiniteType κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a)) ∧
    (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom.Finite ∧
    Function.Injective (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom ∧
    (letI : Algebra Γ(Z, j ⁻¹ᵁ wcSgD κ N a) Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a) :=
        (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom.toAlgebra
     Nonempty (Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a) ≃ₐ[Γ(Z, j ⁻¹ᵁ wcSgD κ N a)]
       integralClosure Γ(Z, j ⁻¹ᵁ wcSgD κ N a) (FractionRing Γ(Z, j ⁻¹ᵁ wcSgD κ N a)))) :=
by
  intro κ _ _ Z N j hj hred hdim Zt ν hν a

  have proj_gen : ∀ (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1))
      (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro K _ n J x
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩

  have normal_scaleRoots : ∀ (B : Type u) [CommRing B],
      (∀ (M : Ideal B) [M.IsPrime],
        IsDomain (Localization.AtPrime M) ∧ IsIntegrallyClosed (Localization.AtPrime M)) →
      ∀ (c d : B), d ∈ nonZeroDivisors B → ∀ p : Polynomial B, p.Monic →
        Polynomial.eval c (p.scaleRoots d) = 0 → ∃ e : B, c = d * e := by
    intro B _ hB c d hd p hp h
    classical
    let J : Ideal B := Submodule.comap (LinearMap.mulLeft B c) (Ideal.span {d})
    have hJmem : ∀ x : B, x ∈ J ↔ c * x ∈ Ideal.span {d} := fun x => by
      simp [J]
    by_cases hJ : J = ⊤
    · have h1 : (1 : B) ∈ J := hJ ▸ Submodule.mem_top
      rw [hJmem, mul_one, Ideal.mem_span_singleton'] at h1
      obtain ⟨e, he⟩ := h1
      exact ⟨e, by rw [← he, mul_comm]⟩
    · exfalso
      obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal J hJ
      haveI := hM.isPrime
      obtain ⟨hdom, hic⟩ := hB M
      let f := algebraMap B (Localization.AtPrime M)
      let g := algebraMap (Localization.AtPrime M) (FractionRing (Localization.AtPrime M))
      have hg : Function.Injective g := IsFractionRing.injective _ _
      have hfd : f d ≠ 0 := by
        intro h0
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M.primeCompl _ d).mp h0
        have : (m : B) = 0 := (mem_nonZeroDivisors_iff_right.mp hd) _ hm
        exact m.2 (this ▸ M.zero_mem)
      have hgfd : g (f d) ≠ 0 := fun h0 => hfd (hg (h0.trans (map_zero g).symm))
      set y := g (f c) / g (f d) with hy
      have hyd : g (f d) * y = g (f c) := by
        rw [hy]; field_simp
      have hqm : (p.map f).Monic := hp.map f
      have hmap : (p.scaleRoots d).map f = (p.map f).scaleRoots (f d) := by
        apply Polynomial.map_scaleRoots
        rw [hp.leadingCoeff, map_one]; exact one_ne_zero
      have hev : Polynomial.eval₂ g y (p.map f) = 0 := by
        have e1 := Polynomial.scaleRoots_eval₂_mul (p := p.map f) g y (f d)
        rw [hyd, ← hmap, Polynomial.eval₂_map] at e1
        have e2 : Polynomial.eval₂ (g.comp f) (g (f c)) (p.scaleRoots d) = 0 := by
          have := Polynomial.eval₂_hom (p := p.scaleRoots d) (g.comp f) c
          rw [RingHom.comp_apply] at this
          rw [this, h, map_zero]
        rw [e2] at e1
        exact (mul_eq_zero.mp e1.symm).resolve_left (pow_ne_zero _ hgfd)
      have hint : IsIntegral (Localization.AtPrime M) y := ⟨p.map f, hqm, hev⟩
      obtain ⟨e', he'⟩ := (IsIntegrallyClosed.isIntegral_iff (R := Localization.AtPrime M)
        (K := FractionRing (Localization.AtPrime M))).mp hint
      have hde : f d * e' = f c := by
        apply hg
        rw [map_mul]
        rw [he', hyd]
      obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.mk'_surjective M.primeCompl e'
      have hspec := IsLocalization.mk'_spec (Localization.AtPrime M) x s
      have hxs' : IsLocalization.mk' (Localization.AtPrime M) x s = e' := hxs
      rw [hxs'] at hspec
      have h3 : f (d * x) = f (c * ↑s) := by
        rw [map_mul, map_mul, ← hspec, ← hde]
        ring
      obtain ⟨u, hu⟩ := (IsLocalization.eq_iff_exists M.primeCompl (Localization.AtPrime M)).mp h3
      have hus : (u : B) * s ∈ J := by
        rw [hJmem, Ideal.mem_span_singleton']
        exact ⟨u * x, by linear_combination hu⟩
      have hus' := hJM hus
      rcases hM.isPrime.mem_or_mem hus' with h4 | h4
      · exact u.2 h4
      · exact s.2 h4

  have integralClosure_criterion : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B],
      Function.Injective (algebraMap A B) → Module.Finite A B →
      ∀ t ∈ nonZeroDivisors A, algebraMap A B t ∈ nonZeroDivisors B →
      (∀ b : B, ∃ (k : ℕ) (a : A), algebraMap A B t ^ k * b = algebraMap A B a) →
      (∀ (c d : B), d ∈ nonZeroDivisors B → ∀ p : Polynomial B, p.Monic →
        Polynomial.eval c (p.scaleRoots d) = 0 → ∃ e : B, c = d * e) →
      Nonempty (B ≃ₐ[A] integralClosure A (FractionRing A)) := by
    intro A B _ _ _ hψ hfin t ht hτ hloc hnorm
    haveI := hfin
    choose k a hka using hloc
    let K := FractionRing A
    have hι : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
    have hunit : ∀ m : ℕ, IsUnit (algebraMap A K (t ^ m)) := fun m =>
      IsLocalization.map_units K (⟨t ^ m, pow_mem ht m⟩ : nonZeroDivisors A)
    let ε : B → K := fun b =>
      IsLocalization.mk' K (a b) (⟨t ^ k b, pow_mem ht _⟩ : nonZeroDivisors A)
    have hkey : ∀ (b : B) (m : ℕ) (c : A), algebraMap A B t ^ m * b = algebraMap A B c →
        ε b * algebraMap A K (t ^ m) = algebraMap A K c := by
      intro b m c hc
      have hspec : ε b * algebraMap A K (t ^ k b) = algebraMap A K (a b) :=
        IsLocalization.mk'_spec K (a b) ⟨t ^ k b, pow_mem ht _⟩
      have hA : a b * t ^ m = c * t ^ k b := by
        apply hψ
        rw [map_mul, map_mul, map_pow, map_pow, ← hka b, ← hc]; ring
      rw [← (hunit (k b)).mul_left_inj]
      calc ε b * algebraMap A K (t ^ m) * algebraMap A K (t ^ k b)
          = (ε b * algebraMap A K (t ^ k b)) * algebraMap A K (t ^ m) := by ring
        _ = algebraMap A K c * algebraMap A K (t ^ k b) := by
            rw [hspec, ← map_mul, hA, map_mul]
    have hεadd : ∀ b b', ε (b + b') = ε b + ε b' := by
      intro b b'
      have h1 : algebraMap A B t ^ (k b + k b') * (b + b') =
          algebraMap A B (t ^ k b' * a b + t ^ k b * a b') := by
        rw [map_add, map_mul, map_mul, map_pow, map_pow, ← hka b, ← hka b']; ring
      have e1 := hkey _ _ _ h1
      have e2 := hkey b _ _ (hka b)
      have e3 := hkey b' _ _ (hka b')
      rw [← (hunit (k b + k b')).mul_left_inj, e1]
      simp only [pow_add, map_add, map_mul]
      rw [← e2, ← e3]; ring
    have hεmul : ∀ b b', ε (b * b') = ε b * ε b' := by
      intro b b'
      have h1 : algebraMap A B t ^ (k b + k b') * (b * b') =
          algebraMap A B (a b * a b') := by
        rw [map_mul, ← hka b, ← hka b']; ring
      have e1 := hkey _ _ _ h1
      have e2 := hkey b _ _ (hka b)
      have e3 := hkey b' _ _ (hka b')
      rw [← (hunit (k b + k b')).mul_left_inj, e1]
      simp only [pow_add, map_mul]
      rw [← e2, ← e3]; ring
    have hεalg : ∀ c : A, ε (algebraMap A B c) = algebraMap A K c := by
      intro c
      have := hkey (algebraMap A B c) 0 c (by simp)
      simpa using this
    have hε0 : ε 0 = 0 := by
      have := hεalg 0
      rwa [map_zero, map_zero] at this
    have hε1 : ε 1 = 1 := by
      have := hεalg 1
      rwa [map_one, map_one] at this
    let εR : B →+* K :=
      { toFun := ε, map_one' := hε1, map_mul' := hεmul, map_zero' := hε0, map_add' := hεadd }
    let εA : B →ₐ[A] K := { εR with commutes' := hεalg }
    let εI : B →ₐ[A] integralClosure A K :=
      εA.codRestrict (integralClosure A K) (fun b => (Algebra.IsIntegral.isIntegral b).map εA)
    have hεinj : Function.Injective εR := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      have hb' : ε b = 0 := hb
      have e1 := hkey b _ _ (hka b)
      rw [hb', zero_mul] at e1
      have e2 : a b = 0 := hι (e1.symm.trans (map_zero _).symm)
      have e3 : algebraMap A B t ^ k b * b = 0 := by rw [hka b, e2, map_zero]
      exact (mem_nonZeroDivisors_iff.mp (pow_mem hτ (k b))).1 b e3
    have hsB : ∀ s ∈ nonZeroDivisors A, algebraMap A B s ∈ nonZeroDivisors B := by
      intro s hs
      rw [mem_nonZeroDivisors_iff_right]
      intro b hb
      have h1 : algebraMap A B (a b * s) = 0 := by
        rw [map_mul, ← hka b, mul_assoc, hb, mul_zero]
      have h2 : a b * s = 0 := hψ (h1.trans (map_zero _).symm)
      have h3 : a b = 0 := (mem_nonZeroDivisors_iff_right.mp hs) _ h2
      have e3 : algebraMap A B t ^ k b * b = 0 := by rw [hka b, h3, map_zero]
      exact (mem_nonZeroDivisors_iff.mp (pow_mem hτ (k b))).1 b e3
    have hinjI : Function.Injective εI := by
      intro b b' h
      apply hεinj
      exact congrArg Subtype.val h
    have hsurjI : Function.Surjective εI := by
      rintro ⟨x, hx⟩
      obtain ⟨p, hpm, hpx⟩ := hx
      obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) x
      have hrs' : IsLocalization.mk' K r s = x := hrs
      have hpx' : Polynomial.aeval (IsLocalization.mk' K r s) p = 0 := by
        rw [hrs', Polynomial.aeval_def]; exact hpx
      have h1 := scaleRoots_aeval_eq_zero_of_aeval_mk'_eq_zero hpx'
      rw [Polynomial.aeval_algebraMap_apply] at h1
      have h2 : Polynomial.aeval r (p.scaleRoots s) = 0 := hι (h1.trans (map_zero _).symm)
      rw [Polynomial.coe_aeval_eq_eval] at h2
      have h3 : Polynomial.eval (algebraMap A B r)
          ((p.map (algebraMap A B)).scaleRoots (algebraMap A B s)) = 0 := by
        rcases subsingleton_or_nontrivial B with hB | hB
        · exact Subsingleton.elim _ _
        · rw [← Polynomial.map_scaleRoots, Polynomial.eval_map, Polynomial.eval₂_hom, h2, map_zero]
          rw [hpm.leadingCoeff, map_one]; exact one_ne_zero
      obtain ⟨e, he⟩ := hnorm _ _ (hsB s s.2) _ (hpm.map _) h3
      refine ⟨e, Subtype.ext ?_⟩
      show ε e = x
      rw [← hrs', IsLocalization.eq_mk'_iff_mul_eq]
      have hA : s * a e = t ^ k e * r := by
        apply hψ; rw [map_mul, map_mul, ← hka e, map_pow, he]; ring
      rw [← (hunit (k e)).mul_left_inj]
      calc ε e * algebraMap A K ↑s * algebraMap A K (t ^ k e)
          = (ε e * algebraMap A K (t ^ k e)) * algebraMap A K ↑s := by ring
        _ = algebraMap A K r * algebraMap A K (t ^ k e) := by
            rw [hkey e _ _ (hka e), ← map_mul, ← map_mul, mul_comm (a e) (s : A), hA]
            congr 1; ring
    exact ⟨AlgEquiv.ofBijective εI ⟨hinjI, hsurjI⟩⟩

  have generic_avoid : ∀ (X : Scheme.{u}) (V : X.Opens), IsAffineOpen V →
      IsNoetherianRing Γ(X, V) → ∀ U : X.Opens, Dense (U : Set X) →
      ∃ t : Γ(X, V), X.basicOpen t ≤ U ∧ ∀ p ∈ minimalPrimes Γ(X, V), t ∉ p := by
    intro X V hV hnoeth U hUd
    classical
    set R := Γ(X, V)
    let f := hV.fromSpec
    let W : Set (PrimeSpectrum R) := f ⁻¹' (U : Set X)
    have hWopen : IsOpen W := U.isOpen.preimage f.continuous
    have hfin : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
    have ha : ∀ p (hp : p ∈ minimalPrimes R), (⟨p, hp.1.1⟩ : PrimeSpectrum R) ∈ W := by
      intro p hp
      let O : Set (PrimeSpectrum R) :=
        ⋂ q ∈ (minimalPrimes R \ {p}), (PrimeSpectrum.zeroLocus (q : Set R))ᶜ
      have hOopen : IsOpen O :=
        (hfin.diff).isOpen_biInter (fun q _ => (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl)
      have hpO : (⟨p, hp.1.1⟩ : PrimeSpectrum R) ∈ O := by
        simp only [O, Set.mem_iInter, Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus]
        intro q hq hqp
        have hq' := hq.1
        have hne : q ≠ p := hq.2
        apply hne
        exact le_antisymm hqp (hp.2 hq'.1 hqp)
      have hfO : IsOpen (f '' O) := f.isOpenEmbedding.isOpenMap _ hOopen
      obtain ⟨x, ⟨P, hPO, rfl⟩, hxU⟩ := hUd.inter_open_nonempty _ hfO ⟨_, ⟨_, hpO, rfl⟩⟩
      haveI := P.isPrime
      obtain ⟨q, hq, hqP⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ P.asIdeal)
      have hqp : q = p := by
        by_contra hne
        have := Set.mem_iInter₂.mp hPO q ⟨hq, hne⟩
        exact this hqP
      subst hqp
      have hspec : (⟨q, hp.1.1⟩ : PrimeSpectrum R) ⤳ P :=
        (PrimeSpectrum.le_iff_specializes _ P).mp hqP
      exact hspec.mem_open hWopen hxU
    let I : Ideal R := PrimeSpectrum.vanishingIdeal Wᶜ
    have hb : ∃ t ∈ I, ∀ p ∈ minimalPrimes R, t ∉ p := by
      by_contra hcon
      push_neg at hcon
      have hsub : (I : Set R) ⊆ ⋃ p ∈ minimalPrimes R, (id p : Set R) := by
        intro t ht
        obtain ⟨p, hp, htp⟩ := hcon t ht
        exact Set.mem_biUnion hp htp
      obtain ⟨p, hp, hIp⟩ := (Ideal.subset_union_prime_finite hfin (f := id) ⊥ ⊥
        (fun i hi _ _ => hi.1.1)).mp hsub
      have h1 : (⟨p, hp.1.1⟩ : PrimeSpectrum R) ∈ PrimeSpectrum.zeroLocus (I : Set R) :=
        (PrimeSpectrum.mem_zeroLocus _ _).mpr hIp
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
        hWopen.isClosed_compl.closure_eq] at h1
      exact h1 (ha p hp)
    obtain ⟨t, htI, htmin⟩ := hb
    refine ⟨t, ?_, htmin⟩
    intro z hz
    have hzV : z ∈ V := X.basicOpen_le t hz
    obtain ⟨q, rfl⟩ : z ∈ Set.range f := by rw [hV.range_fromSpec]; exact hzV
    have hq : q ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen t := hz
    rw [hV.fromSpec_preimage_basicOpen] at hq
    by_contra hqU
    have hqW : q ∈ Wᶜ := hqU
    exact hq ((PrimeSpectrum.mem_vanishingIdeal _ _).mp htI q hqW)

  have iso_locus_localization : ∀ (Z Zt : Scheme.{u}) (ν : Zt ⟶ Z)
      (U : Z.Opens), IsIso (ν ∣_ U) →
      ∀ V : Z.Opens, IsAffineOpen V → IsAffineOpen (ν ⁻¹ᵁ V) →
      ∀ t : Γ(Z, V), Z.basicOpen t ≤ U →
      ∀ b : Γ(Zt, ν ⁻¹ᵁ V), ∃ (k : ℕ) (a : Γ(Z, V)),
        (ν.app V).hom t ^ k * b = (ν.app V).hom a := by
    intro Z Zt ν U hiso V hV hTV t htU b
    have hiso' : IsIso (ν.app (Z.basicOpen t)) := by
      have hgen : ∀ (A B : Zt.Opens) (e : A = B), IsIso (Zt.presheaf.map (eqToHom e).op) := by
        rintro A B rfl
        rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
        infer_instance
      have h1 : IsIso ((ν ∣_ U).app (U.ι ⁻¹ᵁ Z.basicOpen t)) := inferInstance
      rw [morphismRestrict_app] at h1
      have h2 : IsIso (ν.app (U.ι ''ᵁ U.ι ⁻¹ᵁ Z.basicOpen t)) := by
        refine @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (hgen _ _ _) h1
      have heq : U.ι ''ᵁ U.ι ⁻¹ᵁ Z.basicOpen t = Z.basicOpen t := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr htU
      rw [heq] at h2
      exact h2
    have hbij := ConcreteCategory.bijective_of_isIso (ν.app (Z.basicOpen t))
    have hle : ν ⁻¹ᵁ Z.basicOpen t ≤ ν ⁻¹ᵁ V := ν.preimage_mono (Z.basicOpen_le t)
    obtain ⟨g, hg⟩ := hbij.2 (Zt.presheaf.map (homOfLE hle).op b)
    haveI := hV.isLocalization_basicOpen t
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers t) g
    change g * (Z.presheaf.map (homOfLE (Z.basicOpen_le t)).op) s.1 =
      (Z.presheaf.map (homOfLE (Z.basicOpen_le t)).op) a at hs
    have hnat : ∀ x : Γ(Z, V),
        (ν.app (Z.basicOpen t)) (Z.presheaf.map (homOfLE (Z.basicOpen_le t)).op x) =
        Zt.presheaf.map (homOfLE hle).op ((ν.app V) x) := by
      intro x
      exact congrArg (fun φ => φ.hom x) (ν.naturality (homOfLE (Z.basicOpen_le t)).op)
    have h3 := congrArg (ν.app (Z.basicOpen t)) hs
    rw [map_mul, hnat, hnat, hg, ← map_mul] at h3
    have h4 : Zt.presheaf.map (homOfLE hle).op (b * (ν.app V) s.1 - (ν.app V) a) = 0 := by
      rw [map_sub, h3, sub_self]
    have hpre : ν ⁻¹ᵁ Z.basicOpen t = Zt.basicOpen ((ν.app V) t) :=
      Scheme.preimage_basicOpen ν t
    have h5 : ∀ (W : Zt.Opens) (hW : W = Zt.basicOpen ((ν.app V) t)) (h : W ≤ ν ⁻¹ᵁ V),
        Zt.presheaf.map (homOfLE h).op (b * (ν.app V) s.1 - (ν.app V) a) = 0 →
        Zt.presheaf.map (homOfLE (Scheme.basicOpen_le Zt ((ν.app V) t))).op
          (b * (ν.app V) s.1 - (ν.app V) a) = 0 := by
      rintro W rfl h hW
      exact hW
    obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact Zt
      hTV.isCompact _ ((ν.app V) t) (h5 _ hpre hle h4)
    obtain ⟨m, hm⟩ := s.2
    have hm' : (s : Γ(Z, V)) = t ^ m := hm.symm
    rw [hm', map_pow] at hn
    refine ⟨n + m, t ^ n * a, ?_⟩
    rw [map_mul, map_pow, pow_add]
    linear_combination hn

  have iso_locus_nzd : ∀ (Z Zt : Scheme.{u}) (ν : Zt ⟶ Z) (U : Z.Opens),
      Dense ((ν ⁻¹ᵁ U : Zt.Opens) : Set Zt) → IsIso (ν ∣_ U) → AlgebraicGeometry.IsReduced Zt →
      ∀ V : Z.Opens, IsAffineOpen V → ∀ t : Γ(Z, V), Z.basicOpen t ≤ U →
      (∀ p ∈ minimalPrimes Γ(Z, V), t ∉ p) →
      (ν.app V).hom t ∈ nonZeroDivisors Γ(Zt, ν ⁻¹ᵁ V) := by
    intro Z Zt ν U hUd' hiso hred V hV t htU htmin
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    rw [← basicOpen_eq_bot_iff]
    by_contra hne
    obtain ⟨y0, hy0⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    obtain ⟨y1, hy1O, hy1U⟩ := hUd'.inter_open_nonempty _ (Zt.basicOpen x).isOpen ⟨y0, hy0⟩
    haveI : IsOpenImmersion (ν ∣_ U) := IsOpenImmersion.of_isIso _
    let W' : Set ↥(ν ⁻¹ᵁ U) := (ν ⁻¹ᵁ U).ι ⁻¹' (Zt.basicOpen x : Set Zt)
    have hW'open : IsOpen W' := (Zt.basicOpen x).isOpen.preimage (ν ⁻¹ᵁ U).ι.continuous
    let S : Set Z := U.ι '' ((ν ∣_ U) '' W')
    have hSopen : IsOpen S :=
      U.ι.isOpenEmbedding.isOpenMap _ ((ν ∣_ U).isOpenEmbedding.isOpenMap _ hW'open)
    have hSν : ∀ z ∈ S, ∃ w : Zt, w ∈ Zt.basicOpen x ∧ ν w = z := by
      rintro z ⟨z', ⟨w, hw, rfl⟩, rfl⟩
      refine ⟨w.1, hw, ?_⟩
      have := morphismRestrict_base_coe ν U w
      exact this.symm
    have hz1 : U.ι ((ν ∣_ U) ⟨y1, hy1U⟩) ∈ S := ⟨_, ⟨⟨y1, hy1U⟩, hy1O, rfl⟩, rfl⟩
    have hSV : S ⊆ (V : Set Z) := by
      intro z hz
      obtain ⟨w, hw, rfl⟩ := hSν z hz
      have : w ∈ ν ⁻¹ᵁ V := Scheme.basicOpen_le Zt x hw
      exact this
    obtain ⟨q, hq⟩ : U.ι ((ν ∣_ U) ⟨y1, hy1U⟩) ∈ Set.range hV.fromSpec := by
      rw [hV.range_fromSpec]; exact hSV hz1
    haveI := q.isPrime
    obtain ⟨p, hp, hpq⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ q.asIdeal)
    let P : PrimeSpectrum Γ(Z, V) := ⟨p, hp.1.1⟩
    have hPq : P ⤳ q := (PrimeSpectrum.le_iff_specializes P q).mp hpq
    have hfP : hV.fromSpec P ∈ S :=
      (hPq.map hV.fromSpec.continuous).mem_open hSopen (hq ▸ hz1)
    have hPt : hV.fromSpec P ∈ Z.basicOpen t := by
      have : P ∈ hV.fromSpec ⁻¹ᵁ Z.basicOpen t := by
        rw [hV.fromSpec_preimage_basicOpen]
        exact htmin p hp
      exact this
    obtain ⟨w, hwO, hwν⟩ := hSν _ hfP
    have hw1 : w ∈ ν ⁻¹ᵁ Z.basicOpen t := by
      show ν w ∈ Z.basicOpen t
      rw [hwν]; exact hPt
    rw [Scheme.preimage_basicOpen] at hw1
    have hw2 : w ∈ Zt.basicOpen (x * (ν.app V).hom t) := by
      rw [Scheme.basicOpen_mul]; exact ⟨hwO, hw1⟩
    rw [hx, Scheme.basicOpen_zero] at hw2
    exact hw2

  obtain ⟨hfin, hst, U, hUd, hUd', hiso⟩ := hν
  haveI := hred
  haveI := hfin
  haveI := hiso
  haveI : IsAffineHom j := (isClosedImmersion_iff_isAffineHom.mp hj).1
  haveI : IsAffineHom ν := ((isFinite_iff ν).mp hfin).1
  have hD : IsAffineOpen (wcSgD κ N a) :=
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X κ a))
      Nat.one_pos
  have hUa : IsAffineOpen (j ⁻¹ᵁ wcSgD κ N a) := hD.preimage j
  have hTa : IsAffineOpen (ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N a)) := hUa.preimage ν
  have hψ : ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl =
      ν.app (j ⁻¹ᵁ wcSgD κ N a) := Scheme.Hom.appLE_eq_app ν
  have hinj : ∀ V : Z.Opens, Function.Injective (ν.app V) := by
    intro V
    rw [injective_iff_map_eq_zero (ν.app V).hom]
    intro s hs
    rw [← basicOpen_eq_bot_iff]
    by_contra hne
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    obtain ⟨x', hx'B, hx'U⟩ := hUd.inter_open_nonempty _ (Z.basicOpen s).isOpen ⟨x, hx⟩
    obtain ⟨y, hy⟩ := (ν ∣_ U).surjective ⟨x', hx'U⟩
    have h1 := morphismRestrict_base_coe ν U y
    rw [hy] at h1
    have hmem : y.1 ∈ ν ⁻¹ᵁ (Z.basicOpen s) := by
      apply (Scheme.Hom.mem_preimage ν).mpr
      rw [← h1]
      exact hx'B
    rw [Scheme.preimage_basicOpen] at hmem
    have hs' : (ν.app V) s = 0 := hs
    rw [hs', Scheme.basicOpen_zero] at hmem
    exact hmem

  have hft : letI : Algebra κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) :=
      (wcEszScal j (j ⁻¹ᵁ wcSgD κ N a)).toAlgebra
      Algebra.FiniteType κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := by
    letI : Algebra κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := (wcEszScal j (j ⁻¹ᵁ wcSgD κ N a)).toAlgebra
    have hsurj : Function.Surjective (j.app (wcSgD κ N a)) :=
      (isClosedImmersion_iff_isAffineHom.mp hj).2 _ hD
    let φ := (j.app (wcSgD κ N a)).hom
    have hscal : ∀ c : κ, φ ((wcProjK κ N).presheaf.map (homOfLE (le_top : wcSgD κ N a ≤ ⊤)).op
        ((wcProjKStr κ N).appTop ((Scheme.ΓSpecIso (.of κ)).inv c))) =
        algebraMap κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) c := by
      intro c
      rw [RingHom.algebraMap_toAlgebra]
      simp only [wcEszScal, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
      have := congrArg (fun f => f.hom ((wcProjKStr κ N).appTop ((Scheme.ΓSpecIso (.of κ)).inv c)))
        (j.naturality (homOfLE (le_top : wcSgD κ N a ≤ ⊤)).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this.trans rfl
    let s : Set Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := Set.range (fun L => φ (wcSgE κ N a L))
    have hsfin : s.Finite := Set.finite_range _
    refine ⟨⟨hsfin.toFinset, ?_⟩⟩
    rw [Set.Finite.coe_toFinset, eq_top_iff]
    intro y _
    obtain ⟨x, rfl⟩ := hsurj y
    have hx := proj_gen κ N a x
    have hcl : Subring.closure (Set.range (wcSgE κ N a) ∪ Set.range (fun c : κ =>
        (wcProjK κ N).presheaf.map (homOfLE (le_top : wcSgD κ N a ≤ ⊤)).op
          ((wcProjKStr κ N).appTop ((Scheme.ΓSpecIso (.of κ)).inv c))))
        ≤ (Algebra.adjoin κ s).toSubring.comap φ := by
      rw [Subring.closure_le]
      rintro z (⟨L, rfl⟩ | ⟨c, rfl⟩)
      · exact Algebra.subset_adjoin ⟨L, rfl⟩
      · show φ _ ∈ Algebra.adjoin κ s
        rw [hscal]
        exact Subalgebra.algebraMap_mem _ c
    exact hcl hx
  have hnoeth : IsNoetherianRing Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := by
    letI : Algebra κ Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := (wcEszScal j (j ⁻¹ᵁ wcSgD κ N a)).toAlgebra
    haveI := hft
    exact Algebra.FiniteType.isNoetherianRing κ _
  have h5 : (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom.Finite := by
    rw [hψ]; exact IsFinite.finite_app ν _ hUa
  have h6 : Function.Injective
      (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom := by
    rw [hψ]; exact hinj _
  have hdimA : ringKrullDim Γ(Z, j ⁻¹ᵁ wcSgD κ N a) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    exact le_trans (hUa.fromSpec.isOpenEmbedding.isInducing.topologicalKrullDim_le) hdim
  refine ⟨IsReduced.component_reduced _, hnoeth, hdimA, hft, h5, h6, ?_⟩

  obtain ⟨t, htU, htmin⟩ := generic_avoid Z _ hUa hnoeth U hUd
  have hZtred : AlgebraicGeometry.IsReduced Zt := by
    haveI : ∀ x : Zt, _root_.IsReduced (Zt.presheaf.stalk x) := fun x => by
      haveI := (hst x).1
      infer_instance
    exact isReduced_of_isReduced_stalk Zt
  have hτ := iso_locus_nzd Z Zt ν U hUd' hiso hZtred _ hUa t htU htmin
  have hloc := iso_locus_localization Z Zt ν U hiso _ hUa hTa t htU
  have hlocnorm : ∀ (M : Ideal Γ(Zt, ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N a))) [M.IsPrime],
      IsDomain (Localization.AtPrime M) ∧ IsIntegrallyClosed (Localization.AtPrime M) := by
    intro M hM
    let y : PrimeSpectrum Γ(Zt, ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N a)) := ⟨M, hM⟩
    have hx : hTa.fromSpec y ∈ ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N a) := by
      rw [← SetLike.mem_coe, ← hTa.range_fromSpec]
      exact ⟨y, rfl⟩
    letI : Algebra Γ(Zt, ν ⁻¹ᵁ (j ⁻¹ᵁ wcSgD κ N a)) (Zt.presheaf.stalk (hTa.fromSpec y)) :=
      TopCat.Presheaf.algebra_section_stalk Zt.presheaf ⟨hTa.fromSpec y, hx⟩
    haveI hL : IsLocalization.AtPrime (Zt.presheaf.stalk (hTa.fromSpec y)) M :=
      hTa.isLocalization_stalk' y hx
    let e := IsLocalization.algEquiv M.primeCompl (Zt.presheaf.stalk (hTa.fromSpec y))
      (Localization.AtPrime M)
    obtain ⟨h1, h2⟩ := hst (hTa.fromSpec y)
    exact ⟨MulEquiv.isDomain (Zt.presheaf.stalk (hTa.fromSpec y)) e.symm.toRingEquiv.toMulEquiv,
      IsIntegrallyClosed.of_equiv e.toRingEquiv⟩
  have hnorm := normal_scaleRoots _ hlocnorm
  letI : Algebra Γ(Z, j ⁻¹ᵁ wcSgD κ N a) Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a) :=
    (ν.appLE (j ⁻¹ᵁ wcSgD κ N a) ((ν ≫ j) ⁻¹ᵁ wcSgD κ N a) le_rfl).hom.toAlgebra
  have halg : algebraMap Γ(Z, j ⁻¹ᵁ wcSgD κ N a) Γ(Zt, (ν ≫ j) ⁻¹ᵁ wcSgD κ N a) =
      (ν.app (j ⁻¹ᵁ wcSgD κ N a)).hom :=
    congrArg CommRingCat.Hom.hom hψ
  have ht0 : t ∈ nonZeroDivisors Γ(Z, j ⁻¹ᵁ wcSgD κ N a) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hinj (j ⁻¹ᵁ wcSgD κ N a)
    have h1 := congrArg (ν.app (j ⁻¹ᵁ wcSgD κ N a)).hom hx
    rw [map_mul, map_zero] at h1
    rw [map_zero]
    exact (mem_nonZeroDivisors_iff_right.mp hτ) _ h1
  refine integralClosure_criterion _ _ ?_ h5 t ht0 ?_ ?_ hnorm
  · rw [halg]; exact hinj _
  · rw [halg]; exact hτ
  · rw [halg]; exact hloc

theorem wcpa_dj_lr1k_ll_gc_sk_conductor_crt : ∀ (A : Type u) [CommRing A] [_root_.IsReduced A]
    [IsNoetherianRing A],
    ringKrullDim A ≤ 1 → ∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B →
    Nonempty (B ≃ₐ[A] integralClosure A (FractionRing A)) →
    ∃ T : Finset (Ideal A), (∀ m ∈ T, m.IsMaximal) ∧
      (∀ p : Ideal A, p.IsPrime → p ∉ T → ∀ b : B, ∃ s : A, s ∉ p ∧ ∃ a : A,
        s • b = algebraMap A B a) ∧
      (∀ (x : T → B) (s : T → A), (∀ m : T, s m ∉ m.1) → ∃ y : B, ∀ m : T,
        ∃ u : A, u ∉ m.1 ∧ ∃ a : A, u • (s m • y - x m) = algebraMap A B a) :=
by
  intro A _ _ _ hA B _ _ hfin he
  classical

  have s1 : ∃ d ∈ nonZeroDivisors A, ∀ b : B, ∃ a : A, d • b = algebraMap A B a := by
    obtain ⟨e⟩ := he
    obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := A) (M := B)
    obtain ⟨b₀, hb₀⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors A)
      (Finset.univ.image
        (fun i => ((e (g i) : integralClosure A (FractionRing A)) : FractionRing A)))
    refine ⟨(b₀ : A), b₀.2, ?_⟩
    have hgen : ∀ i, ∃ a : A, (b₀ : A) • g i = algebraMap A B a := by
      intro i
      obtain ⟨a, ha⟩ := hb₀ _ (Finset.mem_image_of_mem _ (Finset.mem_univ i))
      refine ⟨a, ?_⟩
      apply e.injective
      apply Subtype.val_injective
      rw [map_smul, AlgEquiv.commutes]
      simp only [SetLike.val_smul, Subalgebra.coe_algebraMap]
      exact ha.symm
    intro b
    have hb : b ∈ Submodule.span A (Set.range g) := hg ▸ Submodule.mem_top
    induction hb using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hgen i
    | zero => exact ⟨0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨a', ha'⟩ := hy
      exact ⟨a + a', by rw [smul_add, ha, ha', map_add]⟩
    | smul r x _ hx =>
      obtain ⟨a, ha⟩ := hx
      exact ⟨r * a, by rw [smul_comm, ha, Algebra.smul_def, map_mul]⟩

  have s2 : ∀ I : Ideal A, (∃ d ∈ nonZeroDivisors A, d ∈ I) →
      ∃ T : Finset (Ideal A), (∀ m ∈ T, m.IsMaximal) ∧
        (∀ P : Ideal A, P.IsPrime → I ≤ P → P ∈ T) ∧ ∃ K : ℕ, (∏ m ∈ T, m) ^ K ≤ I := by
    intro I hI
    obtain ⟨d, hd, hdI⟩ := hI
    have : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.mpr (by exact_mod_cast hA)
    have hmax : ∀ P : Ideal A, P.IsPrime → I ≤ P → P.IsMaximal := by
      intro P hP hIP
      rcases Ring.krullDimLE_one_iff.mp ‹_› P hP with h | h
      · exact absurd (Set.disjoint_left.mp
          (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes h) (hIP hdI)) (fun h' => h' hd)
      · exact h
    have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing A I
    refine ⟨hfin.toFinset, ?_, ?_, ?_⟩
    · intro m hm
      rw [Set.Finite.mem_toFinset] at hm
      exact hmax m hm.1.1 hm.1.2
    · intro P hP hIP
      obtain ⟨q, hq, hqP⟩ := Ideal.exists_minimalPrimes_le hIP
      have hqe := (hmax q hq.1.1 hq.1.2).eq_of_le hP.ne_top hqP
      rw [Set.Finite.mem_toFinset, ← hqe]
      exact hq
    · have hle : (∏ m ∈ hfin.toFinset, m) ≤ I.radical := by
        rw [← Ideal.sInf_minimalPrimes]
        refine le_sInf fun q hq => ?_
        exact Ideal.prod_le_inf.trans (Finset.inf_le ((Set.Finite.mem_toFinset _).mpr hq))
      exact Ideal.exists_pow_le_of_le_radical_of_fg hle (IsNoetherian.noetherian _)

  obtain ⟨d, hd, hdC⟩ := s1
  let C : Ideal A :=
    { carrier := {c | ∀ b : B, ∃ a : A, c • b = algebraMap A B a}
      add_mem' := by
        intro c c' hc hc' b
        obtain ⟨a, ha⟩ := hc b
        obtain ⟨a', ha'⟩ := hc' b
        exact ⟨a + a', by rw [add_smul, ha, ha', map_add]⟩
      zero_mem' := by
        intro b
        exact ⟨0, by rw [zero_smul, map_zero]⟩
      smul_mem' := by
        intro r c hc b
        obtain ⟨a, ha⟩ := hc b
        exact ⟨r * a, by rw [smul_eq_mul, mul_smul, ha, Algebra.smul_def, map_mul]⟩ }
  have hC : ∀ c : A, c ∈ C ↔ ∀ b : B, ∃ a : A, c • b = algebraMap A B a := fun c => Iff.rfl
  obtain ⟨T, hT, hTall, K, hK⟩ := s2 C ⟨d, hd, (hC d).mpr hdC⟩
  refine ⟨T, hT, ?_, ?_⟩
  · intro p hp hpT b
    have hnle : ¬ C ≤ p := fun hle => hpT (hTall p hp hle)
    obtain ⟨s, hsC, hsp⟩ := SetLike.not_le_iff_exists.mp hnle
    obtain ⟨a, ha⟩ := (hC s).mp hsC b
    exact ⟨s, hsp, a, ha⟩
  · intro x s hs

    set N : Submodule A B := LinearMap.range (Algebra.linearMap A B) with hN
    have hkill : ∀ c ∈ (∏ m ∈ T, m) ^ K, ∀ z : B, c • z ∈ N := by
      intro c hc z
      obtain ⟨a, ha⟩ := (hC c).mp (hK hc) z
      exact ⟨a, by rw [Algebra.linearMap_apply]; exact ha.symm⟩
    have key : ∃ y : B, ∀ m : T, ∃ u : A, u ∉ m.1 ∧ u • (s m • y - x m) ∈ N := by
      have hJ' : (∏ m ∈ T, m) = ∏ m : T, m.1 := (Finset.prod_coe_sort T (fun m => m)).symm
      have hmax : ∀ m : T, m.1.IsMaximal := fun m => hT m.1 m.2
      have hsep : ∀ m m' : T, ∃ g : A, m ≠ m' → (g ∈ m'.1 ∧ g ∉ m.1) := by
        intro m m'
        by_cases h : m = m'
        · exact ⟨0, fun h' => absurd h h'⟩
        · have hnle : ¬ m'.1 ≤ m.1 := by
            intro hle
            exact h (Subtype.ext ((hmax m').eq_of_le (hmax m).ne_top hle).symm)
          obtain ⟨g, hg1, hg2⟩ := SetLike.not_le_iff_exists.mp hnle
          exact ⟨g, fun _ => ⟨hg1, hg2⟩⟩
      choose g hg using hsep
      set t : T → A := fun m => ∏ m' ∈ Finset.univ.erase m, g m m' with ht
      have htm : ∀ m : T, t m ∉ m.1 := by
        intro m hmem
        have := (hmax m).isPrime
        obtain ⟨m', hm', hgm⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
        exact (hg m m' (Finset.ne_of_mem_erase hm').symm).2 hgm
      have htK : ∀ m : T, t m ^ K ∉ m.1 := fun m h =>
        htm m ((hmax m).isPrime.mem_of_pow_mem K h)
      have hwm : ∀ m : T, s m * t m ^ K ∉ m.1 := fun m h =>
        ((hmax m).isPrime.mem_or_mem h).elim (hs m) (htK m)
      choose r a ha hra using fun m => (hmax m).exists_inv (hwm m)
      have hstar : ∀ m, r m * (s m * t m ^ K) * (∑ i ∈ Finset.range K, a m ^ i) =
          1 - a m ^ K := by
        intro m
        have h1 : r m * (s m * t m ^ K) = 1 - a m := by rw [← hra m]; ring
        rw [h1]
        exact mul_neg_geom_sum (a m) K
      have hgen : ∀ (m : T) (v : A), v ∈ m.1 → t m * v ∈ ∏ m ∈ T, m := by
        intro m v hv
        have hz := Ideal.prod_mem_prod (s := (Finset.univ : Finset T))
          (I := fun m'' : T => m''.1)
          (x := fun m'' => if m'' = m then v else g m m'') (by
            intro m'' _
            by_cases h : m'' = m
            · subst h
              simp only [if_pos rfl]
              exact hv
            · simp only [if_neg h]
              exact (hg m m'' (Ne.symm h)).1)
        rw [← hJ'] at hz
        rw [← Finset.mul_prod_erase Finset.univ (fun m'' => if m'' = m then v else g m m'')
          (Finset.mem_univ m)] at hz
        simp only [if_pos rfl] at hz
        rw [Finset.prod_congr rfl (fun m'' hm'' => if_neg (Finset.ne_of_mem_erase hm''))] at hz
        rw [mul_comm]
        exact hz
      have hP2 : ∀ m m' : T, m ≠ m' → t m * t m' ∈ ∏ m ∈ T, m := by
        intro m m' hne
        have h1 := hgen m (g m' m) (hg m' m (Ne.symm hne)).1
        have h2 : t m' = g m' m * ∏ m'' ∈ (Finset.univ.erase m').erase m, g m' m'' :=
          (Finset.mul_prod_erase (Finset.univ.erase m') (g m')
            (Finset.mem_erase.mpr ⟨hne, Finset.mem_univ m⟩)).symm
        rw [h2, ← mul_assoc, mul_comm (t m) (g m' m)]
        exact Ideal.mul_mem_right _ _ (by rw [mul_comm]; exact h1)
      refine ⟨∑ m', (t m' ^ K * r m' * ∑ i ∈ Finset.range K, a m' ^ i) • x m',
        fun m => ⟨t m ^ K, htK m, ?_⟩⟩
      rw [smul_sub, Finset.smul_sum, Finset.smul_sum,
        ← Finset.add_sum_erase _ _ (Finset.mem_univ m)]
      have hdiag : t m ^ K • s m • (t m ^ K * r m * ∑ i ∈ Finset.range K, a m ^ i) • x m -
          t m ^ K • x m ∈ N := by
        rw [smul_smul, smul_smul, ← sub_smul]
        have e : t m ^ K * s m * (t m ^ K * r m * ∑ i ∈ Finset.range K, a m ^ i) - t m ^ K =
            -(t m * a m) ^ K := by
          linear_combination (t m ^ K) * hstar m
        rw [e]
        exact hkill _ (neg_mem (Ideal.pow_mem_pow (hgen m (a m) (ha m)) K)) _
      have hoff : ∀ m' ∈ Finset.univ.erase m,
          t m ^ K • s m • (t m' ^ K * r m' * ∑ i ∈ Finset.range K, a m' ^ i) • x m' ∈ N := by
        intro m' hm'
        rw [smul_smul, smul_smul]
        have e : t m ^ K * s m * (t m' ^ K * r m' * ∑ i ∈ Finset.range K, a m' ^ i) =
            (t m * t m') ^ K * (s m * r m' * ∑ i ∈ Finset.range K, a m' ^ i) := by ring
        rw [e]
        exact hkill _ (Ideal.mul_mem_right _ _
          (Ideal.pow_mem_pow (hP2 m m' (Finset.ne_of_mem_erase hm').symm) K)) _
      have hre : ∀ (X S Y : B), X + S - Y = (X - Y) + S := fun X S Y => by abel
      rw [hre]
      exact N.add_mem hdiag (N.sum_mem hoff)
    obtain ⟨y, hy⟩ := key
    refine ⟨y, fun m => ?_⟩
    obtain ⟨u, hu, hmem⟩ := hy m
    obtain ⟨a, ha⟩ := LinearMap.mem_range.mp hmem
    exact ⟨u, hu, a, by rw [← ha, Algebra.linearMap_apply]⟩

theorem wcpa_dj_lr1k_ll_gc_sk_local_count : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (A : Type u)
    [CommRing A] [_root_.IsReduced A]
    [IsNoetherianRing A] [Algebra κ A] [Algebra.FiniteType κ A], ringKrullDim A ≤ 1 →
    ∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B →
    Nonempty (B ≃ₐ[A] integralClosure A (FractionRing A)) →
    ∀ (p : Ideal A) [p.IsPrime],
      wcpaDjLkDelta (Localization.AtPrime p) =
      ⨆ (n : ℕ) (v : Fin n → B) (_ : ∀ c : Fin n → κ,
          (∃ s : A, s ∉ p ∧ ∃ a : A, s • ∑ i, (algebraMap κ A (c i)) • v i = algebraMap A B a) →
          ∀ i, c i = 0), (n : ℕ∞) :=
by
  have s1 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → Nonempty (B ≃ₐ[A] integralClosure A (FractionRing A)) → ∃ d ∈ nonZeroDivisors A, ∀ b : B, ∃ a : A, d • b = algebraMap A B a := by
    intro A _ B _ _ hfin ⟨e⟩
    obtain ⟨m, g, hg⟩ := Module.Finite.exists_fin (R := A) (M := B)
    classical
    obtain ⟨⟨d, hd⟩, hint⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors A)
      (Finset.univ.image (fun i => ((e (g i) : integralClosure A (FractionRing A)) : FractionRing A)))
    refine ⟨d, hd, ?_⟩
    let S : Submodule A B :=
      { carrier := {b | ∃ a : A, d • b = algebraMap A B a}
        add_mem' := by
          rintro x y ⟨a, ha⟩ ⟨a', ha'⟩
          exact ⟨a + a', by rw [smul_add, ha, ha', map_add]⟩
        zero_mem' := ⟨0, by simp⟩
        smul_mem' := by
          rintro r x ⟨a, ha⟩
          refine ⟨r * a, ?_⟩
          rw [smul_comm, ha, map_mul, Algebra.smul_def] }
    have hgS : ∀ i, g i ∈ S := by
      intro i
      obtain ⟨a, ha⟩ := hint _ (Finset.mem_image_of_mem _ (Finset.mem_univ i))
      refine ⟨a, ?_⟩
      apply e.injective
      apply Subtype.val_injective
      rw [map_smul, AlgEquiv.commutes]
      simp only at ha
      rw [Subalgebra.coe_smul, ← ha]
      rfl
    have hS : S = ⊤ := by
      rw [eq_top_iff, ← hg, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact hgS i
    intro b
    have : b ∈ S := by rw [hS]; trivial
    exact this

  have s2 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A], ringKrullDim A ≤ 1 → ∀ d ∈ nonZeroDivisors A, ∀ s : A, ∃ (n : ℕ) (y : A), s ^ (n + 1) * y - s ^ n ∈ Ideal.span {d} := by
    intro A _ _ hdim d hd s
    haveI : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.mpr hdim
    haveI : Ring.KrullDimLE 0 (A ⧸ Ideal.span {d}) := by
      rw [Ring.krullDimLE_zero_iff]
      intro P' hP'
      set P := P'.comap (Ideal.Quotient.mk (Ideal.span {d}))
      haveI : P.IsPrime := Ideal.comap_isPrime _ _
      have hdP : d ∈ P := by
        show Ideal.Quotient.mk _ d ∈ P'
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self d)]
        exact P'.zero_mem
      have hnotmin : P ∉ minimalPrimes A := by
        intro hmin
        exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hmin) hdP hd
      have hPmax : P.IsMaximal := by
        rcases (Ring.krullDimLE_one_iff.mp inferInstance) P inferInstance with h | h
        · exact absurd h hnotmin
        · exact h
      have hmap : P.map (Ideal.Quotient.mk (Ideal.span {d})) = P' :=
        Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective P'
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk (Ideal.span {d}))
        Ideal.Quotient.mk_surjective hPmax with h | h
      · rw [hmap] at h; exact absurd h hP'.ne_top
      · rw [hmap] at h; exact h
    haveI : IsArtinianRing (A ⧸ Ideal.span {d}) := IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
    obtain ⟨n, y', hy'⟩ := IsArtinian.exists_pow_succ_smul_dvd (Ideal.Quotient.mk (Ideal.span {d}) s) (1 : A ⧸ Ideal.span {d})
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y'
    refine ⟨n, y, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_pow, map_pow]
    rw [smul_eq_mul, smul_eq_mul, mul_one] at hy'
    rw [hy', sub_self]

  have s3 : ∀ (A : Type u) [CommRing A] (M : Type u) [AddCommGroup M] [Module A M] (d : A), (∀ s : A, ∃ (n : ℕ) (y : A), s ^ (n + 1) * y - s ^ n ∈ Ideal.span {d}) → (∀ m : M, d • m = 0) → ∀ (p : Ideal A) [p.IsPrime], Function.Surjective (LocalizedModule.mkLinearMap p.primeCompl M) := by
    intro A _ M _ _ d hpow hd p _ x
    induction x using LocalizedModule.induction_on with
    | h m s =>
      obtain ⟨n, y, hy⟩ := hpow s
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hy
      refine ⟨y • m, ?_⟩
      rw [LocalizedModule.mkLinearMap_apply, LocalizedModule.mk_eq]
      refine ⟨⟨(s : A) ^ n, fun h => s.2 (Ideal.IsPrime.mem_of_pow_mem ‹_› n h)⟩, ?_⟩
      have key : ((s : A) ^ n) • m = ((s : A) ^ (n + 1) * y) • m := by
        rw [show (s : A) ^ n = (s : A) ^ (n + 1) * y - z * d by rw [hz]; ring, sub_smul, mul_smul z d,
          hd, smul_zero, sub_zero]
      simp only [Submonoid.smul_def, one_smul, smul_smul, Submonoid.coe_one]
      rw [key]
      congr 1
      ring

  have s4 : ∀ (κ : Type u) [Field κ] (A : Type u) [CommRing A] [Algebra κ A] (B : Type u) [CommRing B] [Algebra A B] (p : Ideal A) [p.IsPrime] (n : ℕ) (v : Fin n → B), letI : Module κ (LocalizedModule p.primeCompl (B ⧸ LinearMap.range (Algebra.linearMap A B))) := Module.compHom _ (algebraMap κ (Localization.AtPrime p)); ((∀ c : Fin n → κ, (∃ s : A, s ∉ p ∧ ∃ a : A, s • ∑ i, (algebraMap κ A (c i)) • v i = algebraMap A B a) → ∀ i, c i = 0) ↔ LinearIndependent κ (fun i => (LocalizedModule.mk (Submodule.Quotient.mk (v i) : B ⧸ LinearMap.range (Algebra.linearMap A B)) (1 : p.primeCompl) : LocalizedModule p.primeCompl (B ⧸ LinearMap.range (Algebra.linearMap A B))))) := by
    intro κ _ A _ _ B _ _ p _ n v
    letI : Module κ (LocalizedModule p.primeCompl (B ⧸ LinearMap.range (Algebra.linearMap A B))) :=
      Module.compHom _ (algebraMap κ (Localization.AtPrime p))
    let π : B →ₗ[A] LocalizedModule p.primeCompl (B ⧸ LinearMap.range (Algebra.linearMap A B)) :=
      (LocalizedModule.mkLinearMap p.primeCompl _).comp (LinearMap.range (Algebra.linearMap A B)).mkQ
    have hπ : ∀ b, π b = LocalizedModule.mk (Submodule.Quotient.mk b) 1 := fun b => rfl
    have hsm : ∀ (g : κ) (b : B), g • π b = π (algebraMap κ A g • b) := by
      intro g b
      rw [map_smul]
      show (algebraMap κ (Localization.AtPrime p) g) • π b = _
      rw [IsScalarTower.algebraMap_apply κ A (Localization.AtPrime p), algebraMap_smul]
    have hsum : ∀ g : Fin n → κ, ∑ i, g i • π (v i) = π (∑ i, algebraMap κ A (g i) • v i) := by
      intro g
      rw [map_sum]
      exact Finset.sum_congr rfl (fun i _ => hsm _ _)
    have hker : ∀ w : B, π w = 0 ↔ ∃ s : A, s ∉ p ∧ ∃ a : A, s • w = algebraMap A B a := by
      intro w
      rw [hπ, ← LocalizedModule.zero_mk (1 : p.primeCompl), LocalizedModule.mk_eq]
      constructor
      · rintro ⟨u, hu⟩
        simp only [one_smul, smul_zero] at hu
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hu
        obtain ⟨a, ha⟩ := hu
        exact ⟨u, u.2, a, ha.symm⟩
      · rintro ⟨s, hs, a, ha⟩
        refine ⟨⟨s, hs⟩, ?_⟩
        simp only [one_smul, smul_zero]
        rw [Submonoid.smul_def, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
        exact ⟨a, ha.symm⟩
    rw [Fintype.linearIndependent_iff]
    constructor
    · intro h g hg
      apply h g
      rw [← hker, ← hsum]
      exact hg
    · intro h c hc
      apply h c
      change ∑ i, c i • π (v i) = 0
      rw [hsum, hker]
      exact hc

  have s5 : ∀ (K : Type u) [Field K] (V : Type u) [AddCommGroup V] [Module K V] (X : Type u) (π : X → V), Function.Surjective π → (⨆ (n : ℕ) (v : Fin n → X) (_ : LinearIndependent K (fun i => π (v i))), (n : ℕ∞)) = Module.length K V := by
    intro K _ V _ _ X π hπ
    rw [Module.length_eq_rank]
    apply le_antisymm
    · refine iSup_le fun n => iSup_le fun v => iSup_le fun hv => ?_
      have h1 := hv.cardinal_lift_le_rank
      have h2 : (n : Cardinal) ≤ Module.rank K V := by simpa using h1
      exact Cardinal.natCast_le_toENat.mpr h2
    · rw [← ENat.forall_natCast_le_iff_le]
      intro m hm
      have hm' : (m : Cardinal) ≤ Module.rank K V := Cardinal.natCast_le_toENat.mp hm
      obtain ⟨s, hs, hli⟩ := le_rank_iff_exists_linearIndependent_finset.mp hm'
      let w : Fin m → V := fun i => ((s.equivFin.symm (Fin.cast hs.symm i)) : V)
      have hw : LinearIndependent K w := by
        apply hli.comp
        intro i j hij
        have := s.equivFin.symm.injective hij
        exact Fin.cast_injective _ this
      refine le_trans ?_ (le_iSup _ m)
      refine le_trans ?_ (le_iSup _ (fun i => Function.surjInv hπ (w i)))
      refine le_trans ?_ (le_iSup _ ?_)
      · exact le_rfl
      · simpa [Function.surjInv_eq hπ] using hw

  have s6 : ∀ (κ R : Type u) [Field κ] [CommRing R] [IsLocalRing R] [Algebra κ R], (∀ x : R, ∃ c : κ, x - algebraMap κ R c ∈ IsLocalRing.maximalIdeal R) → ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module κ N] [IsScalarTower κ R N], Module.length R N = Module.length κ N := by
    intro κ R _ _ _ _ hres N _ _ _ _
    apply le_antisymm
    · rw [Module.length_eq_height, Module.length_eq_height]
      have h := Order.height_le_height_apply_of_strictMono
        (Submodule.restrictScalarsEmbedding κ R N) (Submodule.restrictScalarsEmbedding κ R N).strictMono ⊤
      simpa [Submodule.restrictScalarsEmbedding, Submodule.restrictScalars_top] using h
    · by_cases htop : Module.length R N = ⊤
      · rw [htop]; exact le_top
      have hfin : IsFiniteLength R N := Module.length_ne_top_iff.mp htop
      refine IsFiniteLength.recOn (motive := fun M _ _ _ => ∀ [Module κ M] [IsScalarTower κ R M],
        Module.length κ M ≤ Module.length R M) hfin ?_ ?_
      · intro M _ _ _ _ _
        rw [(Module.length_eq_zero_iff (R := κ)).mpr inferInstance]
        exact zero_le
      · intro M _ _ N₀ _ _ ih _ _
        have ih' := @ih (Submodule.module' N₀) (Submodule.isScalarTower' N₀)
        letI : Module κ ↥N₀ := Submodule.module' N₀
        letI : Module κ (M ⧸ N₀) := Submodule.Quotient.module' N₀
        have hexR := LinearMap.exact_subtype_mkQ N₀
        have hR := Module.length_eq_add_of_exact N₀.subtype N₀.mkQ N₀.injective_subtype
          (Submodule.mkQ_surjective N₀) hexR
        have hκ := Module.length_eq_add_of_exact (N₀.subtype.restrictScalars κ)
          (N₀.mkQ.restrictScalars κ) N₀.injective_subtype (Submodule.mkQ_surjective N₀) hexR
        rw [Module.length_eq_one R (M ⧸ N₀)] at hR
        have hS : Module.length κ (M ⧸ N₀) ≤ 1 := by
          haveI : Nontrivial (M ⧸ N₀) := IsSimpleModule.nontrivial R (M ⧸ N₀)
          obtain ⟨x, hx⟩ := exists_ne (0 : M ⧸ N₀)
          have hspan : ∀ y : M ⧸ N₀, ∃ c : κ, c • x = y := by
            intro y
            obtain ⟨r, hr⟩ := IsSimpleModule.toSpanSingleton_surjective R hx y
            rw [LinearMap.toSpanSingleton_apply] at hr
            obtain ⟨c, hc⟩ := hres r
            have hkill : ∀ t ∈ IsLocalRing.maximalIdeal R, t • x = 0 := by
              intro t ht
              by_contra hne
              obtain ⟨r', hr'⟩ := IsSimpleModule.toSpanSingleton_surjective R hne x
              rw [LinearMap.toSpanSingleton_apply, smul_smul] at hr'
              have hu : IsUnit (1 - r' * t) := by
                apply IsLocalRing.isUnit_one_sub_self_of_mem_nonunits
                exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mul_mem_left _ r' ht)
              apply hx
              have : (1 - r' * t) • x = 0 := by rw [sub_smul, one_smul, hr', sub_self]
              exact (hu.smul_left_cancel).mp (this.trans (smul_zero _).symm)
            refine ⟨c, ?_⟩
            rw [← hr, ← algebraMap_smul R c x]
            have := hkill _ hc
            rw [sub_smul, sub_eq_zero] at this
            exact this.symm
          rw [Module.length_eq_rank]
          have hrk : Module.rank κ (M ⧸ N₀) ≤ 1 := rank_le_one_iff.mpr ⟨x, hspan⟩
          have := Cardinal.toENat.monotone' hrk
          simpa using this
        calc Module.length κ M = Module.length κ ↥N₀ + Module.length κ (M ⧸ N₀) := hκ
          _ ≤ Module.length R ↥N₀ + 1 := add_le_add ih' hS
          _ = Module.length R M := hR.symm

  have s7 : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (A : Type u) [CommRing A] [Algebra κ A] [Algebra.FiniteType κ A] (p : Ideal A) [p.IsPrime], p.IsMaximal → ∀ x : Localization.AtPrime p, ∃ c : κ, x - algebraMap κ (Localization.AtPrime p) c ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
    intro κ _ _ A _ _ _ p _ hmax x
    haveI := hmax
    letI : Field (A ⧸ p) := Ideal.Quotient.field p
    haveI : Algebra.FiniteType κ (A ⧸ p) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ κ p) (Ideal.Quotient.mkₐ_surjective κ p)
    haveI : Module.Finite κ (A ⧸ p) := finite_of_finite_type_of_isJacobsonRing κ (A ⧸ p)
    haveI : Algebra.IsIntegral κ (A ⧸ p) := Algebra.IsIntegral.of_finite κ _
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ) (K := A ⧸ p)
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
    obtain ⟨c₁, hc₁⟩ := hbij.2 (Ideal.Quotient.mk p a)
    obtain ⟨c₂, hc₂⟩ := hbij.2 (Ideal.Quotient.mk p s)
    have hc₂0 : c₂ ≠ 0 := by
      rintro rfl
      rw [map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem] at hc₂
      exact s.2 hc₂
    refine ⟨c₁ / c₂, ?_⟩
    have hmem : a - algebraMap κ A (c₁ / c₂) * s ∈ p := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, Ideal.Quotient.mk_algebraMap, ← hc₁, ← hc₂,
        ← map_mul, div_mul_cancel₀ _ hc₂0, sub_self]
    have heq : IsLocalization.mk' (Localization.AtPrime p) a s -
        algebraMap κ (Localization.AtPrime p) (c₁ / c₂) =
        IsLocalization.mk' (Localization.AtPrime p) (a - algebraMap κ A (c₁ / c₂) * s) s := by
      rw [eq_comm, IsLocalization.mk'_eq_iff_eq_mul, sub_mul, IsLocalization.mk'_spec,
        IsScalarTower.algebraMap_apply κ A (Localization.AtPrime p), map_sub, map_mul]
    rw [heq, IsLocalization.mk'_mem_iff (M := p.primeCompl) (S := Localization.AtPrime p),
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime p) p]
    exact hmem

  have s8 : ∀ (A : Type u) [CommRing A] (p : Ideal A) [p.IsPrime], ∃ ι : FractionRing A →ₐ[A] FractionRing (Localization.AtPrime p), ∀ x : FractionRing A, ι x = 0 → ∃ u : A, u ∉ p ∧ u • x = 0 := by
    intro A _ p _
    have hnz : ∀ d ∈ nonZeroDivisors A, algebraMap A (Localization.AtPrime p) d ∈ nonZeroDivisors (Localization.AtPrime p) := by
      intro d hd
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
      simp only at hx ⊢
      rw [mul_comm, IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_eq_zero_iff] at hx
      obtain ⟨m, hm⟩ := hx
      rw [IsLocalization.mk'_eq_zero_iff]
      refine ⟨m, ?_⟩
      exact (mul_right_mem_nonZeroDivisors_eq_zero_iff hd).mp (by rw [← hm]; ring)
    have hunit : ∀ y : nonZeroDivisors A,
        IsUnit ((Algebra.ofId A (FractionRing (Localization.AtPrime p))) (y : A)) := by
      intro ⟨d, hd⟩
      rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply A (Localization.AtPrime p)]
      exact IsLocalization.map_units (FractionRing (Localization.AtPrime p))
        (⟨_, hnz d hd⟩ : nonZeroDivisors (Localization.AtPrime p))
    refine ⟨IsLocalization.liftAlgHom (M := nonZeroDivisors A) (S := FractionRing A) hunit, ?_⟩
    intro x hx
    obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) x
    simp only at hx ⊢
    have hspec := congrArg (IsLocalization.liftAlgHom (M := nonZeroDivisors A) (S := FractionRing A) hunit)
      (IsLocalization.mk'_spec (FractionRing A) a t)
    rw [map_mul, hx, zero_mul, AlgHom.commutes, IsScalarTower.algebraMap_apply A (Localization.AtPrime p)] at hspec
    have h1 : algebraMap A (Localization.AtPrime p) a = 0 := by
      apply IsFractionRing.injective (Localization.AtPrime p) (FractionRing (Localization.AtPrime p))
      rw [← hspec, map_zero]
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ a).mp h1
    refine ⟨m, m.2, ?_⟩
    rw [Algebra.smul_def, IsLocalization.mul_mk'_eq_mk'_of_mul, hm, IsLocalization.mk'_zero]

  have s9 : ∀ (A : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A] (p : Ideal A) [p.IsPrime] (c : A), algebraMap A (Localization.AtPrime p) c ∈ nonZeroDivisors (Localization.AtPrime p) → ∃ d ∈ nonZeroDivisors A, ∃ t : A, t ∉ p ∧ ∃ w : A, w ∉ p ∧ w * d = w * (c * t) := by
    classical
    intro A _ _ _ p _ c hc
    have hfin : (minimalPrimes A).Finite := minimalPrimes.finite_of_isNoetherianRing A
    set F := hfin.toFinset with hF
    have hmemF : ∀ q, q ∈ F ↔ q ∈ minimalPrimes A := fun q => hfin.mem_toFinset
    have hprime : ∀ q ∈ minimalPrimes A, q.IsPrime := fun q hq => hq.1.1
    have R1 : ∀ x : A, (∀ q ∈ minimalPrimes A, x ∈ q) → x = 0 := by
      intro x hx
      have h1 : x ∈ sInf (Ideal.minimalPrimes (⊥ : Ideal A)) := Ideal.mem_sInf.mpr (fun q hq => hx q hq)
      rw [Ideal.sInf_minimalPrimes] at h1
      obtain ⟨n, hn⟩ := h1
      exact IsReduced.eq_zero x ⟨n, (Ideal.mem_bot).mp hn⟩
    have R2 : ∀ x : A, (∀ q ∈ minimalPrimes A, x ∉ q) → x ∈ nonZeroDivisors A := by
      intro x hx
      rw [mem_nonZeroDivisors_iff_right]
      intro y hy
      apply R1
      intro q hq
      have : x * y ∈ q := by rw [mul_comm, hy]; exact q.zero_mem
      exact ((hprime q hq).mem_or_mem this).resolve_left (hx q hq)
    have hinc : ∀ q ∈ minimalPrimes A, ∀ q' ∈ minimalPrimes A, q' ≤ q → q' = q := by
      intro q hq q' hq' hle
      exact le_antisymm hle (hq.2 ⟨hprime q' hq', bot_le⟩ hle)
    have hsep : ∀ q ∈ minimalPrimes A, ∃ y : A, y ∉ q ∧ ∀ q' ∈ minimalPrimes A, q' ≠ q → y ∈ q' := by
      intro q hq
      have hx : ∀ q' ∈ minimalPrimes A, q' ≠ q → ∃ x, x ∈ q' ∧ x ∉ q := by
        intro q' hq' hne
        by_contra h
        push Not at h
        exact hne (hinc q hq q' hq' h)
      choose! x hx1 hx2 using hx
      refine ⟨∏ q' ∈ F.erase q, x q', ?_, ?_⟩
      · intro hmem
        obtain ⟨q', hq', hxq⟩ := ((hprime q hq).prod_mem_iff).mp hmem
        have hq'F := Finset.mem_erase.mp hq'
        exact hx2 q' ((hmemF q').mp hq'F.2) hq'F.1 hxq
      · intro q' hq' hne
        have hq'e : q' ∈ F.erase q := Finset.mem_erase.mpr ⟨hne, (hmemF q').mpr hq'⟩
        rw [← Finset.mul_prod_erase _ _ hq'e]
        exact Ideal.mul_mem_right _ _ (hx1 q' hq' hne)
    have step1 : ∀ q ∈ minimalPrimes A, q ≤ p → c ∉ q := by
      intro q hq hqp hcq
      obtain ⟨y, hyq, hy⟩ := hsep q hq
      have hcy : c * y = 0 := by
        apply R1
        intro q' hq'
        by_cases h : q' = q
        · subst h; exact Ideal.mul_mem_right _ _ hcq
        · exact Ideal.mul_mem_left _ _ (hy q' hq' h)
      have hy0 : algebraMap A (Localization.AtPrime p) y ≠ 0 := by
        intro h0
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ y).mp h0
        have : (m : A) * y ∈ q := by rw [hm]; exact q.zero_mem
        rcases (hprime q hq).mem_or_mem this with h | h
        · exact m.2 (hqp h)
        · exact hyq h
      exact hy0 ((mul_left_mem_nonZeroDivisors_eq_zero_iff hc).mp (by rw [← map_mul, hcy, map_zero]))
    set M₂ := F.filter (fun q => ¬ q ≤ p) with hM₂
    have ha : ∀ q ∈ M₂, ∃ a, a ∈ q ∧ a ∉ p := by
      intro q hq
      obtain ⟨a, h1, h2⟩ := SetLike.not_le_iff_exists.mp (Finset.mem_filter.mp hq).2
      exact ⟨a, h1, h2⟩
    choose! a ha1 ha2 using ha
    set t' := ∏ q ∈ M₂, a q with ht'
    have ht'p : t' ∉ p := by
      intro h
      obtain ⟨q, hq, hqa⟩ := ((inferInstance : p.IsPrime).prod_mem_iff).mp h
      exact ha2 q hq hqa
    have ht'q : ∀ q ∈ M₂, t' ∈ q := by
      intro q hq
      rw [ht', ← Finset.mul_prod_erase _ _ hq]
      exact Ideal.mul_mem_right _ _ (ha1 q hq)
    choose! y hy1 hy2 using hsep
    set z := ∑ q ∈ M₂, y q with hz
    have hzM1 : ∀ q ∈ minimalPrimes A, q ≤ p → z ∈ q := by
      intro q hq hqp
      apply Ideal.sum_mem
      intro q₂ hq₂
      have hq₂F := Finset.mem_filter.mp hq₂
      apply hy2 q₂ ((hmemF q₂).mp hq₂F.1) q hq
      rintro rfl
      exact hq₂F.2 hqp
    have hzM2 : ∀ q ∈ M₂, z ∉ q := by
      intro q hq hzq
      have hqm := (hmemF q).mp (Finset.mem_filter.mp hq).1
      rw [hz, ← Finset.add_sum_erase _ _ hq] at hzq
      apply hy1 q hqm
      have hrest : ∑ x ∈ M₂.erase q, y x ∈ q := by
        apply Ideal.sum_mem
        intro q₂ hq₂
        have h := Finset.mem_erase.mp hq₂
        exact hy2 q₂ ((hmemF q₂).mp (Finset.mem_filter.mp h.2).1) q hqm (Ne.symm h.1)
      exact (Submodule.add_mem_iff_left q hrest).mp hzq
    have hprod0 : t' * z = 0 := by
      apply R1
      intro q hq
      by_cases hqp : q ≤ p
      · exact Ideal.mul_mem_left _ _ (hzM1 q hq hqp)
      · exact Ideal.mul_mem_right _ _ (ht'q q (Finset.mem_filter.mpr ⟨(hmemF q).mpr hq, hqp⟩))
    refine ⟨c * t' + z, R2 _ ?_, t', ht'p, t', ht'p, ?_⟩
    · intro q hq hdq
      by_cases hqp : q ≤ p
      · have hct : c * t' ∉ q := by
          intro h
          rcases (hprime q hq).mem_or_mem h with h | h
          · exact step1 q hq hqp h
          · exact ht'p (hqp h)
        exact hct ((Submodule.add_mem_iff_left q (hzM1 q hq hqp)).mp hdq)
      · have hq2 : q ∈ M₂ := Finset.mem_filter.mpr ⟨(hmemF q).mpr hq, hqp⟩
        exact hzM2 q hq2 ((Submodule.add_mem_iff_right q (Ideal.mul_mem_left _ _ (ht'q q hq2))).mp hdq)
    · rw [mul_add, hprod0, add_zero]

  have s10 : ∀ (A : Type u) [CommRing A] (p : Ideal A) [p.IsPrime], (∀ c : A, algebraMap A (Localization.AtPrime p) c ∈ nonZeroDivisors (Localization.AtPrime p) → ∃ d ∈ nonZeroDivisors A, ∃ t : A, t ∉ p ∧ ∃ w : A, w ∉ p ∧ w * d = w * (c * t)) → ∀ (ι : FractionRing A →ₐ[A] FractionRing (Localization.AtPrime p)) (y : FractionRing (Localization.AtPrime p)), ∃ k : FractionRing A, ∃ s : A, s ∉ p ∧ ι k = algebraMap A (FractionRing (Localization.AtPrime p)) s * y := by
    intro A _ p _ H ι y
    have hD : ∀ a : A, algebraMap A (FractionRing (Localization.AtPrime p)) a = algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) (algebraMap A (Localization.AtPrime p) a) :=
      fun a => IsScalarTower.algebraMap_apply A (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) a
    have hunitS : ∀ s : A, s ∉ p → IsUnit (algebraMap A (FractionRing (Localization.AtPrime p)) s) := by
      intro s hs
      rw [hD]
      exact (IsLocalization.map_units (Localization.AtPrime p) (⟨s, hs⟩ : p.primeCompl)).map _
    obtain ⟨⟨x', c'⟩, hxc⟩ := IsLocalization.surj (nonZeroDivisors (Localization.AtPrime p)) y
    obtain ⟨⟨x, s₁⟩, hx⟩ := IsLocalization.surj p.primeCompl x'
    obtain ⟨⟨c, s₂⟩, hc⟩ := IsLocalization.surj p.primeCompl (c' : (Localization.AtPrime p))
    simp only at hxc hx hc
    have hcnz : algebraMap A (Localization.AtPrime p) c ∈ nonZeroDivisors (Localization.AtPrime p) := by
      rw [← hc]
      exact mul_mem c'.2 (IsLocalization.map_units (Localization.AtPrime p) s₂).mem_nonZeroDivisors
    obtain ⟨d, hd, t, ht, w, hw, hwd⟩ := H c hcnz
    have hDd : algebraMap A (FractionRing (Localization.AtPrime p)) d = algebraMap A (FractionRing (Localization.AtPrime p)) c * algebraMap A (FractionRing (Localization.AtPrime p)) t := by
      have := congrArg (algebraMap A (FractionRing (Localization.AtPrime p))) hwd
      rw [map_mul, map_mul, map_mul] at this
      exact (hunitS w hw).mul_left_cancel this
    have hDc : IsUnit (algebraMap A (FractionRing (Localization.AtPrime p)) c) := by
      rw [hD]
      exact IsLocalization.map_units (FractionRing (Localization.AtPrime p)) (⟨_, hcnz⟩ : nonZeroDivisors (Localization.AtPrime p))
    refine ⟨IsLocalization.mk' (FractionRing A) (x * s₂ * t) ⟨d, hd⟩, s₁, s₁.2, ?_⟩
    have hk : ι (IsLocalization.mk' (FractionRing A) (x * s₂ * t) ⟨d, hd⟩) * algebraMap A (FractionRing (Localization.AtPrime p)) d =
        algebraMap A (FractionRing (Localization.AtPrime p)) (x * s₂ * t) := by
      have := congrArg ι (IsLocalization.mk'_spec (FractionRing A) (x * s₂ * t) ⟨d, hd⟩)
      rw [map_mul, AlgHom.commutes, AlgHom.commutes] at this
      exact this
    rw [hDd] at hk
    have hu : IsUnit (algebraMap A (FractionRing (Localization.AtPrime p)) c * algebraMap A (FractionRing (Localization.AtPrime p)) t) := hDc.mul (hunitS t ht)
    apply hu.mul_left_inj.mp
    rw [hk]
    have e1 : algebraMap A (FractionRing (Localization.AtPrime p)) c = algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) (c' : (Localization.AtPrime p)) * algebraMap A (FractionRing (Localization.AtPrime p)) s₂ := by
      rw [hD, hD, ← hc, map_mul]
    have e2 : algebraMap A (FractionRing (Localization.AtPrime p)) x = algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) x' * algebraMap A (FractionRing (Localization.AtPrime p)) s₁ := by
      rw [hD, hD, ← hx, map_mul]
    rw [e1, map_mul, map_mul, e2]
    have e3 : y * algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) (c' : (Localization.AtPrime p)) = algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) x' := hxc
    rw [← e3]
    ring

  have s11 : ∀ (A K L : Type u) [CommRing A] [CommRing K] [CommRing L] [Algebra A K] [Algebra A L] (p : Ideal A) [p.IsPrime] (ι : K →ₐ[A] L), (∀ x : K, ι x = 0 → ∃ u : A, u ∉ p ∧ u • x = 0) → ∀ k : K, IsIntegral A (ι k) → ∃ u : A, u ∉ p ∧ IsIntegral A (u • k) := by
    intro A K L _ _ _ _ _ p _ ι hker k ⟨f, hf, hfk⟩
    haveI : Nontrivial A := ⟨⟨0, 1, fun h => (‹p.IsPrime›).ne_top ((Ideal.eq_top_iff_one p).mpr (h ▸ p.zero_mem))⟩⟩
    set g := f * Polynomial.X with hg
    have hgm : g.Monic := hf.mul Polynomial.monic_X
    have hgdeg : 1 ≤ g.natDegree := by
      rw [hg, Polynomial.natDegree_mul_X hf.ne_zero]; omega
    have hgk : Polynomial.aeval (ι k) g = 0 := by
      rw [hg, map_mul, Polynomial.aeval_def, hfk, zero_mul]
    have h0 : ι (Polynomial.aeval k g) = 0 := by
      rw [← Polynomial.aeval_algHom_apply, hgk]
    obtain ⟨u, hu, hu0⟩ := hker _ h0
    refine ⟨u, hu, g.scaleRoots u, (Polynomial.monic_scaleRoots_iff u).mpr hgm, ?_⟩
    rw [Algebra.smul_def, Polynomial.scaleRoots_eval₂_mul]
    obtain ⟨N, hN⟩ : ∃ N, g.natDegree = N + 1 := ⟨g.natDegree - 1, by omega⟩
    rw [hN, pow_succ, mul_assoc, ← Algebra.smul_def, ← Polynomial.aeval_def, hu0, mul_zero]

  have s12 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B] (p : Ideal A) [p.IsPrime] (e : B ≃ₐ[A] integralClosure A (FractionRing A)) (ι : FractionRing A →ₐ[A] FractionRing (Localization.AtPrime p)), (∀ k : FractionRing A, IsIntegral A (ι k) → ∃ u : A, u ∉ p ∧ IsIntegral A (u • k)) → (∀ y : FractionRing (Localization.AtPrime p), ∃ k : FractionRing A, ∃ s : A, s ∉ p ∧ ι k = algebraMap A (FractionRing (Localization.AtPrime p)) s * y) → ∀ y : FractionRing (Localization.AtPrime p), IsIntegral (Localization.AtPrime p) y → ∃ b : B, ∃ s : A, s ∉ p ∧ ι (e b : FractionRing A) = algebraMap A (FractionRing (Localization.AtPrime p)) s * y := by
    intro A _ B _ _ p _ e ι hpull hden y hy
    obtain ⟨k, s₁, hs₁, hk⟩ := hden y
    have hik : IsIntegral (Localization.AtPrime p) (ι k) := by
      rw [hk, IsScalarTower.algebraMap_apply A (Localization.AtPrime p)]
      exact (isIntegral_algebraMap).mul hy
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization p.primeCompl (ι k) hik
    rw [Submonoid.smul_def, ← map_smul] at hm
    obtain ⟨u, hu, hu'⟩ := hpull _ hm
    refine ⟨e.symm ⟨u • (m : A) • k, hu'⟩, u * m * s₁, ?_, ?_⟩
    · intro h
      rcases Ideal.IsPrime.mem_or_mem ‹_› h with h | h
      · rcases Ideal.IsPrime.mem_or_mem ‹_› h with h | h
        · exact hu h
        · exact m.2 h
      · exact hs₁ h
    · rw [AlgEquiv.apply_symm_apply]
      show ι (u • (m : A) • k) = _
      rw [map_smul, map_smul, hk, Algebra.smul_def, Algebra.smul_def, map_mul, map_mul]
      ring

  have s13 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B] (p : Ideal A) [p.IsPrime] (e : B ≃ₐ[A] integralClosure A (FractionRing A)) (ι : FractionRing A →ₐ[A] FractionRing (Localization.AtPrime p)), (∀ x : FractionRing A, ι x = 0 → ∃ u : A, u ∉ p ∧ u • x = 0) → ∀ (b : B) (r : Localization.AtPrime p), ι (e b : FractionRing A) = algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) r → ∃ u : A, u ∉ p ∧ ∃ a : A, u • b = algebraMap A B a := by
    intro A _ B _ _ p _ e ι hker b r hr
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl r
    simp only at hr
    have hspec := congrArg (algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)))
      (IsLocalization.mk'_spec (Localization.AtPrime p) a s)
    rw [map_mul, ← hr, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply] at hspec
    have h0 : ι ((s : A) • (e b : FractionRing A) - algebraMap A (FractionRing A) a) = 0 := by
      rw [map_sub, map_smul, AlgHom.commutes, Algebra.smul_def, mul_comm, hspec, sub_self]
    obtain ⟨u, hu, hu0⟩ := hker _ h0
    refine ⟨u * s, fun h => (Ideal.IsPrime.mem_or_mem ‹_› h).elim hu s.2, u * a, ?_⟩
    apply e.injective
    apply Subtype.val_injective
    rw [AlgEquiv.commutes, map_smul, Subalgebra.coe_smul]
    rw [smul_sub, sub_eq_zero, smul_smul] at hu0
    rw [hu0, Algebra.smul_def, ← map_mul]
    rfl

  have s14 : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B] (p : Ideal A) [p.IsPrime] (e : B ≃ₐ[A] integralClosure A (FractionRing A)) (ι : FractionRing A →ₐ[A] FractionRing (Localization.AtPrime p)), (∀ y : FractionRing (Localization.AtPrime p), IsIntegral (Localization.AtPrime p) y → ∃ b : B, ∃ s : A, s ∉ p ∧ ι (e b : FractionRing A) = algebraMap A (FractionRing (Localization.AtPrime p)) s * y) → (∀ (b : B) (r : Localization.AtPrime p), ι (e b : FractionRing A) = algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) r → ∃ u : A, u ∉ p ∧ ∃ a : A, u • b = algebraMap A B a) → wcpaDjLkDelta (Localization.AtPrime p) = Module.length (Localization.AtPrime p) (LocalizedModule p.primeCompl (B ⧸ LinearMap.range (Algebra.linearMap A B))) := by
    intro A _ B _ _ p _ e ι hlift hkern
    have hint : ∀ b : B, IsIntegral (Localization.AtPrime p) (ι (e b : FractionRing A)) := fun b =>
      IsIntegral.tower_top (A := Localization.AtPrime p) ((e b).2.map ι)
    let g : B →ₗ[A] integralClosure (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) :=
      { toFun := fun b => ⟨ι (e b : FractionRing A), hint b⟩
        map_add' := fun x y => by
          apply Subtype.ext
          show ι ((e (x + y) : integralClosure A (FractionRing A)) : FractionRing A) =
