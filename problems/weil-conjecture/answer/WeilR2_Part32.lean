  obtain ⟨N, j, hj, hjs, d, e₀, hH⟩ := hχ
  obtain ⟨hdomp, hicp⟩ := hND.2.1 p
  haveI := hdomp
  haveI := hicp

  have hdim : topologicalKrullDim ↥Zt ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    refine wcpa_dj_lr1k_ll_gc_df_dim_le_one κ Zt j hj ⟨d, c.toNat, e₀, fun e he => ?_⟩
    have h1 := hH e he
    have h2 := Int.self_le_toNat c
    have h3 : ((wcGcHilb j e : ℕ) : ℤ) ≤ ((d * e + c.toNat : ℕ) : ℤ) := by
      push_cast; linarith
    exact_mod_cast h3

  haveI := hj
  haveI := wc_proj_space_isProper κ N
  haveI : IsProper (ν ≫ s) := by rw [← hjs]; infer_instance
  haveI : IsLocallyNoetherian Zt := LocallyOfFiniteType.isLocallyNoetherian (ν ≫ s)

