  have dagger : ∀ s : X.presheaf.stalk x, (wcLr1uGerm ι x hx).hom s =
      (wcLr1uGerm ι η hη).hom ((X.presheaf.stalkSpecializes hηx).hom s) := by
    intro s
    show (X.presheaf.stalkSpecializes hx ≫ ι.stalkMap (genericPoint (wcProjK Ω 1))).hom s =
