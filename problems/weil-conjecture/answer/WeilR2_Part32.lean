theorem wc_gcf_chl_rank_transfer : ∀ (K : Type u) [Field K] (T : Scheme.{u}) {N : ℕ} (φ : T ⟶ wcProjK K N) (e : ℕ) (a : Fin (N + 1)) (V : Type u) [AddCommGroup V] [Module K V] (L : Submodule K V) [FiniteDimensional K L] (Φ : Γ(T, φ ⁻¹ᵁ wcSgD K N a) → V), (∀ s t, Φ (s + t) = Φ s + Φ t) → (∀ (c : K) s, Φ (wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) c * s) = c • Φ s) → (∀ f ∈ wcGcDfSec φ e, Φ (f a) ∈ L) → (∀ f ∈ wcGcDfSec φ e, Φ (f a) = 0 → ∀ b, f b = 0) → (∀ v ∈ L, ∃ f ∈ wcGcDfSec φ e, Φ (f a) = v) → wcGcDfRk φ e = (Module.finrank K L : ℕ∞) :=
