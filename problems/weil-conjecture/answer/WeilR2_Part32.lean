    exfalso
    subst hl0
    obtain ⟨e, rfl⟩ := hγμ
    simp only [List.map_nil, List.prod_nil, mul_one, map_mul] at hstar
    have h1 : σ γ * u = σ γ * (σ e * s) := by rw [hstar]; ring
    have h2 := mul_left_cancel₀ (hσ0 γ hγ) h1
    have h3 : u ∈ IsLocalRing.maximalIdeal Q := by rw [h2]; exact Ideal.mul_mem_left _ _ hs
    exact (hmQ u).mp h3 hu


  obtain ⟨B, hBQ, hBm⟩ : ∃ B : ValuationSubring (FractionRing Q),
      (∀ q : Q, algebraMap Q (FractionRing Q) q ∈ B) ∧
      ∀ q ∈ IsLocalRing.maximalIdeal Q, B.valuation (algebraMap Q (FractionRing Q) q) < 1 := by
    obtain ⟨A, hA, hloc⟩ :=
