theorem wcpa_dj_lr1k_odfgl_cw_finite_piece : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (D : Type u) [CommRing D] [Algebra ↥W D] [Algebra.FiniteType ↥W D] (n' : Ideal D) [n'.IsPrime], Ideal.map (algebraMap ↥W D) (IsLocalRing.maximalIdeal ↥W) ≤ n' → ∀ (t β : D), t ∈ n' → IsUnit β → IsIntegral ↥W (Ideal.Quotient.mk (Ideal.span {t}) β) → (∀ x : D, ∃ k : ℕ, IsIntegral ↥W (Ideal.Quotient.mk (Ideal.span {t}) (β ^ k * x))) → ∃ f : D, f ∉ n' ∧ Module.Finite ↥W (Localization.Away (Ideal.Quotient.mk (Ideal.span {t}) f)) ∧ ∀ 𝔮 : Ideal D, 𝔮.IsPrime → Ideal.map (algebraMap ↥W D) (IsLocalRing.maximalIdeal ↥W) ≤ 𝔮 → t ∈ 𝔮 → f ∉ 𝔮 → 𝔮 = n' :=
by
  intro Ω _ _ W D _ _ _ n' hn'P hJn t β htn hβ hβint hint
  classical
  have c1 : ∀ (n : ℕ) (f : Polynomial ↥W), f.Monic → f.natDegree = n →
