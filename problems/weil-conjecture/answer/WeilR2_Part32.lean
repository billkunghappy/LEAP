  have Vc : ∀ (z : Z) (hz : z ∈ j ⁻¹ᵁ wcSgD κ N a), (hU.primeIdealOf ⟨z, hz⟩).asIdeal ∉ T →
      ∀ V : Z.Opens, V ≤ j ⁻¹ᵁ wcSgD κ N a → z ∈ V → ∀ b : Γ(Zt, ν ⁻¹ᵁ V),
