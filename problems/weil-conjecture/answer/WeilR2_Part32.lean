    refine ⟨A, hA, ?_⟩
    intro q hq
    refine (ValuationSubring.valuation_lt_one_iff A ⟨_, hA q⟩).mp ?_
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu'
    have : IsUnit ((algebraMap Q (FractionRing Q)).codRestrict A.toSubring hA q) := hu'
    exact (hmQ q).mp hq (isUnit_of_map_unit _ q this)

  obtain ⟨α, hαl, hαmin⟩ := l.toFinset.exists_min_image
    (fun β => B.valuation (algebraMap Q (FractionRing Q) (r - σ β)))
    (by
      obtain ⟨a, ha⟩ := List.exists_mem_of_ne_nil l hl0
      exact ⟨a, List.mem_toFinset.mpr ha⟩)
