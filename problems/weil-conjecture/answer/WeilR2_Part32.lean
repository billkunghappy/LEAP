by
  intro Ω _ _ W hW hWt C γ hcov hgal _ X uX ι hM V hVaff _ hgen K _ _ _ _ _ _ _ hK _ _ ℓ hℓ
  classical
  have s1 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X) (y : Y) (z : Z)
      (hxy : f x = y) (hyz : g y = z) (hxz : (f ≫ g) x = z),
