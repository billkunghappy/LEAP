    have h := fun i => hg i N ((O i).ι ≫ ψ) (by haveI := hCIi i; infer_instance)
      (by rw [Category.assoc, hψs])
    choose D f hDf using h
    obtain ⟨h₁, hh₁⟩ := wcpa_dj_lr1k_ll_gc_df_hilb_sections κ T ψ hψ hdim
    obtain ⟨E₀, hE₀⟩ : ∃ E₀ : ℕ, E₀ = max e₀ (max h₁ (Finset.univ.sup f)) := ⟨_, rfl⟩
    have hE1 : e₀ ≤ E₀ := by rw [hE₀]; exact le_max_left _ _
    have hE2 : h₁ ≤ E₀ := by rw [hE₀]; exact le_trans (le_max_left _ _) (le_max_right _ _)
    have hE3 : ∀ i, f i ≤ E₀ := fun i => by
      rw [hE₀]
      exact le_trans (Finset.le_sup (f := f) (Finset.mem_univ i))
        (le_trans (le_max_right _ _) (le_max_right _ _))
    have star : ∀ e : ℕ, E₀ ≤ e → wcGcHilb ψ e + ∑ i, g i = (∑ i, D i) * e + m := by
      intro e he
