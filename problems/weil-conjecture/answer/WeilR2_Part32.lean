      (f.app U ≫ Y.presheaf.germ (f ⁻¹ᵁ U) y hy).hom =
        (wcpaDjGslTr f y z hz).comp (Z.presheaf.germ U z hU).hom := by
    intro Y Z f U y z hz hU hy
    subst hz
    unfold wcpaDjGslTr
    erw [TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]
    rw [← CommRingCat.hom_comp, Scheme.Hom.germ_stalkMap f U y hU]
  have gpf : ∀ (Y : Scheme.{u}) [IrreducibleSpace Y] (z : Y), z ⤳ genericPoint Y →
      z = genericPoint Y := fun Y _ z hz =>
    (hz.antisymm (genericPoint_specializes z)).eq
  obtain ⟨hPint, -, -, -⟩ := wc_projK_integral_normal Ω 1
  haveI := hPint
  haveI : IsFinite γ := hcov.2.2.2.1
  obtain ⟨hspec, -, -⟩ :=
    wcpa_dj_lr1k_gc_function_field_separable (wcProjK Ω 1) C γ hcov.2.2.2.1 hcov.2.2.2.2
