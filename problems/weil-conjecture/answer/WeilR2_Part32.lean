theorem wcpa_dj_lr1k_gs_integral_incomparable : ∀ {A B : Scheme.{u}} (h : A ⟶ B) [IsIntegralHom h] (a a₁ : A), a ⤳ a₁ → h a = h a₁ → a = a₁ :=
by
  intro A B h _ a a₁ hsp heq
  obtain ⟨U₀, hU, hb, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := h a₁) (U := ⊤) trivial
  have hV : IsAffineOpen (h ⁻¹ᵁ U₀) := hU.preimage h
  have ha₁V : a₁ ∈ h ⁻¹ᵁ U₀ := hb
  have haV : a ∈ h ⁻¹ᵁ U₀ := hsp.mem_open (h ⁻¹ᵁ U₀).isOpen ha₁V
  obtain ⟨p, hp⟩ : a ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact haV
  obtain ⟨p₁, hp₁⟩ : a₁ ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact ha₁V
  have hsp' : p ⤳ p₁ := by
    rw [← hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hp, hp₁]; exact hsp
  have hle : p.asIdeal ≤ p₁.asIdeal := (PrimeSpectrum.le_iff_specializes p p₁).mpr hsp'
  have hsq := hU.SpecMap_appLE_fromSpec h hV le_rfl
  rw [Scheme.Hom.appLE_eq_app] at hsq
  have e : (Spec.map (h.app U₀)) p = (Spec.map (h.app U₀)) p₁ := by
    apply hU.fromSpec.isOpenEmbedding.injective
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply,
      Scheme.Hom.comp_apply, hp, hp₁, heq]
  have e2 : Ideal.comap (h.app U₀).hom p.asIdeal = Ideal.comap (h.app U₀).hom p₁.asIdeal :=
    congrArg PrimeSpectrum.asIdeal e
  have hint : (h.app U₀).hom.IsIntegral := ((isIntegralHom_iff h).mp inferInstance).2 U₀ hU
  have hpp : p.asIdeal = p₁.asIdeal := by
    by_contra hne
    obtain ⟨x, hx1, hx0⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hle hne)
    letI := (h.app U₀).hom.toAlgebra
    haveI := p.isPrime
    have hxi : IsIntegral Γ(B, U₀) x := hint x
    have := Ideal.under_lt_under_of_integral_mem_sdiff (R := Γ(B, U₀)) hle ⟨hx1, hx0⟩ hxi
    exact (ne_of_lt this) e2
  have : p = p₁ := PrimeSpectrum.ext hpp
  rw [← hp, ← hp₁, this]

theorem wcpa_dj_lr1k_gs_rational_closed : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (s : Z ⟶ Spec (.of K)) [LocallyOfFiniteType s] (z : Z), (∀ a : Z.presheaf.stalk z, ∃ c : K, a - ((Scheme.ΓSpecIso (.of K)).inv ≫ s.appTop ≫ Z.presheaf.germ ⊤ z trivial).hom c ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) → IsClosed ({z} : Set Z) :=
by
  intro K _ Z s _ z hH
  haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace s
  have hsurj : Function.Surjective (s.residueFieldMap z).hom := by
    intro y
    obtain ⟨a, rfl⟩ := Z.residue_surjective z y
    obtain ⟨c, hc⟩ := hH a
    refine ⟨((Spec (.of K)).residue (s z)).hom
      (((Spec (.of K)).presheaf.germ ⊤ (s z) trivial).hom
        ((Scheme.ΓSpecIso (.of K)).inv.hom c)), ?_⟩
    have h1 := congrArg (fun f => f.hom (((Spec (.of K)).presheaf.germ ⊤ (s z) trivial).hom
        ((Scheme.ΓSpecIso (.of K)).inv.hom c))) (Scheme.residue_residueFieldMap s z)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [h1]
    have h2 : (s.stalkMap z).hom (((Spec (.of K)).presheaf.germ ⊤ (s z) trivial).hom
        ((Scheme.ΓSpecIso (.of K)).inv.hom c)) =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ s.appTop ≫ Z.presheaf.germ ⊤ z trivial).hom c := by
      have key := congrArg (fun ψ => ψ.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))
        (Scheme.Hom.germ_stalkMap s ⊤ z trivial)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key ⊢
      exact key
    rw [h2]
    have h3 := (IsLocalRing.residue_eq_zero_iff _).mpr hc
    rw [map_sub, sub_eq_zero] at h3
    exact h3.symm
  haveI : LocallyOfFiniteType (Spec.map (s.residueFieldMap z)) :=
    HasRingHomProperty.Spec_iff.mpr (RingHom.FiniteType.of_surjective _ hsurj)
  haveI : LocallyOfFiniteType ((Spec (.of K)).fromSpecResidueField (s z)) := by
    rw [← isClosed_singleton_iff_locallyOfFiniteType]
    have hu : ({s z} : Set (Spec (.of K))) = Set.univ :=
      Set.eq_univ_of_forall fun q => Subsingleton.elim q (s z)
    rw [hu]
    exact isClosed_univ
  haveI : LocallyOfFiniteType (Z.fromSpecResidueField z ≫ s) := by
    rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
    infer_instance
  haveI := locallyOfFiniteType_of_comp (Z.fromSpecResidueField z) s
  exact isClosed_singleton_iff_locallyOfFiniteType.mpr inferInstance

theorem wcpa_dj_lr1k_gs_smooth_nonclosed_field : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (q : Z ⟶ Spec (.of K)) [LocallyOfFiniteType q] (z : Z) (V : Z.Opens), z ∈ V → SmoothOfRelativeDimension 1 (V.ι ≫ q) → ¬ IsClosed ({z} : Set Z) → IsField (Z.presheaf.stalk z) :=
by
  intro K _ Z q _ z V hz hsm hnc
  haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace q
  haveI : SmoothOfRelativeDimension 1 (V.ι ≫ q) := hsm
  haveI : Smooth (V.ι ≫ q) := SmoothOfRelativeDimension.smooth 1 (V.ι ≫ q)
  haveI : LocallyOfFiniteType (V.ι ≫ q) := inferInstance
