  obtain ⟨g', hg'def⟩ : ∃ g' : (T.ι ⁻¹ᵁ W₂).toScheme ⟶ Zt₁, g' = iso.hom ≫ inv ψ ≫ W₁.ι :=
    ⟨_, rfl⟩
