    · have hle : n i ≤ K * (d - i) := by
        have h1 : n i ≤ N := hnle i h
        have h2 : N ≤ K := by omega
        have h3 : K ≤ K * (d - i) := Nat.le_mul_of_pos_right K (by omega)
        omega
      obtain ⟨e, he⟩ := Nat.exists_eq_add_of_le hle
      refine ⟨r i * g ^ e, R.mul_mem (hrR i) (R.pow_mem hgR e), ?_⟩
      rw [← pow_mul, he, pow_add, ← mul_assoc, hn i, map_mul, map_pow]
    · refine ⟨1, R.one_mem, ?_⟩
      rw [h, Nat.sub_self, pow_zero, mul_one, map_one]
      exact hpm.coeff_natDegree
    · refine ⟨0, R.zero_mem, ?_⟩
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul, map_zero]
  have hlift : q ∈ Polynomial.lifts ι := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    obtain ⟨c, -, hc⟩ := hqc i
