            algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ))})).comp
        (algebraMap ↥W ↑Γ(X, V))) := by
    have heq : algebraMap ↑Γ(X, V) _ (g (MvPolynomial.X 0) -
        algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)) *
        (⟨algebraMap ↑Γ(X, V) K
        (algebraMap ↥W ↑Γ(X, V) a) / algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
          algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)),
        Algebra.subset_adjoin (Set.mem_singleton _)⟩ : ↥(Algebra.adjoin ↑Γ(X, V)
        {algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a) /
          algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
            algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ))})) =
        ((algebraMap ↑Γ(X, V) ↥(Algebra.adjoin ↑Γ(X, V)
          {algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a) /
            algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
              algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ))})).comp
          (algebraMap ↥W ↑Γ(X, V))) a := by
      have hzK : algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
          algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)) ≠ 0 := fun h =>
        hz0 ((IsFractionRing.injective ↑Γ(X, V) K) (h.trans (map_zero _).symm))
      apply Subtype.ext
      show algebraMap ↑Γ(X, V) K (g (MvPolynomial.X 0) -
          algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ)) *
        (algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a) / algebraMap ↑Γ(X, V) K
          (g (MvPolynomial.X 0) -
            algebraMap ↥W ↑Γ(X, V) (wcG2cTau W V (g (MvPolynomial.X 0)) σ))) =
        algebraMap ↑Γ(X, V) K (algebraMap ↥W ↑Γ(X, V) a)
      field_simp
    rw [heq]
    exact Ideal.mem_map_of_mem _ hP.2.2.2

  obtain ⟨hu, hv⟩ := wcpa_dj_llsmg_np_node_nonzero Ω W a hP.2.2.2 _ ρ hρflat _
    (by rw [hρ0]; exact hz𝔫) (by rw [hρ1]; exact hs𝔫) (by rw [hρC]; exact hm𝔫)
  have hψρ : ∀ w, e' (((r ≫ uX).appLE ⊤ U' hleU').hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) =
      (ρ.comp ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C)) w :=
    fun w => (hψ w).trans (RingHom.congr_fun hρC w).symm
  have huv' : ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 0)) *
      ρ (Ideal.Quotient.mk (wcNpI W a) (MvPolynomial.X 1)) ∈
      (IsLocalRing.maximalIdeal ↥W).map
        (ρ.comp ((Ideal.Quotient.mk (wcNpI W a)).comp MvPolynomial.C)) := by
    rw [hρ0, hρ1, hρC]; exact huv

  have hns := wcpa_dj_llsmg_np_not_smooth Ω W X' (r ≫ uX) U' hU' hleU' _ e' _ hψρ _ _ _ huv'
    hu hv (wcpaDjLkPi W (γ ≫ ι') (r ≫ uX) y') hy'U hprime
  exact ⟨y', hr, hns, ⟨eS⟩⟩

theorem wcpa_dj_llsmgn_coord_ne_zero : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (x : ↥X) (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤)
    (g : MvPolynomial (Fin 1) ↥W →+* ↑Γ(X, V)) (𝔭 : Ideal ↑Γ(X, V)),
    wcG2cChart W uX x V hle g 𝔭 → ∀ c : ↥W,
    g (MvPolynomial.X 0) - wcG2cPhi W uX V hle c ≠ 0 :=
by
  intro Ω _ W X uX x V hle g 𝔭 hch c
  have hdom : IsDomain ↑Γ(X, V) := hch.2.2.1
  have het : g.Etale := hch.2.2.2.1
  have hgC : g.comp MvPolynomial.C = wcG2cPhi W uX V hle := hch.2.2.2.2.1
  have hφc : wcG2cPhi W uX V hle c = g (MvPolynomial.C c) := by
    rw [← hgC, RingHom.comp_apply]
  rw [hφc, ← map_sub]
  set p : MvPolynomial (Fin 1) ↥W := MvPolynomial.X 0 - MvPolynomial.C c with hp
  have hp0 : p ≠ 0 := by
    intro h
    have h1 := congrArg (MvPolynomial.eval (fun _ : Fin 1 => c + 1)) h
    rw [hp, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, map_zero] at h1
    have : (1 : ↥W) = 0 := by rw [← h1]; ring
    exact one_ne_zero this
  have hpnz : p ∈ nonZeroDivisors (MvPolynomial (Fin 1) ↥W) := mem_nonZeroDivisors_of_ne_zero hp0
  have hflat : g.Flat := ((RingHom.etale_iff_formallyUnramified_and_smooth g).mp het).2.flat
  letI : Algebra (MvPolynomial (Fin 1) ↥W) ↑Γ(X, V) := g.toAlgebra
  haveI : Module.Flat (MvPolynomial (Fin 1) ↥W) ↑Γ(X, V) := hflat
  have hreg : IsSMulRegular ↑Γ(X, V) p := Module.Flat.isSMulRegular_of_nonZeroDivisors hpnz
  intro h
  have h2 : p • (1 : ↑Γ(X, V)) = 0 := by
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, h, zero_mul]
  exact one_ne_zero (IsSMulRegular.right_eq_zero_of_smul hreg h2)

theorem wcpa_dj_llsmgn_section_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
    wcpaDjLkModel W uX ι →
    ∀ (x : ↥X) (V : X.Opens) (hle : V ≤ uX ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) ↥W →+* ↑Γ(X, V))
      (𝔭 : Ideal ↑Γ(X, V)), wcG2cChart W uX x V hle g 𝔭 →
    ∀ (σ : Spec (.of ↥W) ⟶ X), σ ≫ uX = 𝟙 _ → σ (IsLocalRing.closedPoint ↥W) = x →
    ∃ (O : X.Opens) (hOV : O ≤ V) (m : O.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (σO : Spec (.of ↥W) ⟶ O.toScheme),
      IsAffineOpen O ∧ x ∈ O ∧ Etale m ∧
      m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
        O.ι ≫ uX ∧
      σO ≫ O.ι = σ ∧
      σO ≫ m = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) ∧
      RingHom.ker σO.appTop.hom = Ideal.span {m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} ∧
      O.topIso.hom.hom (m.appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) =
        (X.presheaf.map (homOfLE hOV).op).hom (g (MvPolynomial.X 0) -
          wcG2cPhi W uX V hle (wcG2cTau W V (g (MvPolynomial.X 0)) σ)) :=
by

  have isoHI : ∀ {R S : CommRingCat.{u}} (e : R ≅ S) (z : ↑R), e.inv.hom (e.hom.hom z) = z := by
    intro R S e z
    have h := congrArg (fun f => f.hom z) e.hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using h
  have isoIH : ∀ {R S : CommRingCat.{u}} (e : R ≅ S) (z : ↑S), e.hom.hom (e.inv.hom z) = z := by
    intro R S e z
    have h := congrArg (fun f => f.hom z) e.inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using h

  have hsa : ∀ {R A B : Type u} [CommRing R] [CommRing A]
      [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale →
      Function.Bijective (θ.comp (g.comp MvPolynomial.C)) →
      ∀ a : R, θ (g (MvPolynomial.C a)) = θ (g (MvPolynomial.X 0)) →
      ∃ r : A, θ r = 1 ∧ ∀ j ∈ RingHom.ker θ, ∃ y : A,
        r * j = y * (g (MvPolynomial.X 0) - g (MvPolynomial.C a)) := by
    intro R A B _ _ _ g θ hg hbij a ha
    classical
    let e : R ≃+* B := RingEquiv.ofBijective (θ.comp (g.comp MvPolynomial.C)) hbij
    let σ : A →+* R := (e.symm : B →+* R).comp θ
    have hσψ : ∀ b, σ (g (MvPolynomial.C b)) = b := by
      intro b
      exact e.symm_apply_apply b
    have hker : RingHom.ker σ = RingHom.ker θ :=
      RingHom.ker_comp_of_injective θ e.symm.injective
    have hσX : σ (g (MvPolynomial.X 0)) = a := by
      show e.symm (θ (g (MvPolynomial.X 0))) = a
      rw [← ha]
      exact e.symm_apply_apply a
    have hdiff : ∀ x, x - g (MvPolynomial.C (σ x)) ∈ RingHom.ker σ := by
      intro x
      rw [RingHom.mem_ker, map_sub, hσψ, sub_self]
    have hfg : (RingHom.ker σ).FG := by
      letI : Algebra R A := (g.comp MvPolynomial.C).toAlgebra
      have hgfp : g.FinitePresentation := by
        letI := g.toAlgebra
        haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
        exact Algebra.Etale.finitePresentation
      have hCfp : (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R).FinitePresentation := by
        rw [← MvPolynomial.algebraMap_eq]
        exact RingHom.finitePresentation_algebraMap.mpr inferInstance
      haveI : Algebra.FinitePresentation R A := hgfp.comp hCfp
      let σa : A →ₐ[R] R := { σ with commutes' := fun b => hσψ b }
      exact Algebra.FinitePresentation.ker_fG_of_surjective σa
        (fun b => ⟨g (MvPolynomial.C b), hσψ b⟩)
    have hcot : RingHom.ker σ ≤ RingHom.ker σ ^ 2 ⊔
        Ideal.span {g (MvPolynomial.X 0) - g (MvPolynomial.C a)} := by
      letI : Algebra (MvPolynomial (Fin 1) R) A := g.toAlgebra
      haveI : Algebra.FormallyUnramified (MvPolynomial (Fin 1) R) A :=
        RingHom.Etale.formallyUnramified g hg
      let I : Ideal A := RingHom.ker σ ^ 2 ⊔
        Ideal.span {g (MvPolynomial.X 0) - g (MvPolynomial.C a)}
      let π : A →+* A ⧸ I := Ideal.Quotient.mk I
      have htI : π (g (MvPolynomial.X 0)) = π (g (MvPolynomial.C a)) := by
        rw [← sub_eq_zero, ← map_sub]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
      have hcomm : (π.comp ((g.comp MvPolynomial.C).comp σ)).comp g = π.comp g := by
        apply MvPolynomial.ringHom_ext
        · intro b
          simp only [RingHom.comp_apply]
          rw [hσψ]
        · intro i
          rw [Fin.fin_one_eq_zero i]
          simp only [RingHom.comp_apply]
          rw [hσX, htI]
      let F₁ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ I := Ideal.Quotient.mkₐ _ I
      let F₂ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ I :=
        { toRingHom := π.comp ((g.comp MvPolynomial.C).comp σ)
          commutes' := by
            intro p
            exact congrArg (fun f => f p) hcomm }
      have hN : (Ideal.map π (RingHom.ker σ)) ^ 2 = ⊥ := by
        rw [← Ideal.map_pow]
        exact le_bot_iff.mp ((Ideal.map_mono le_sup_left).trans (Ideal.map_quotient_self I).le)
      have hF : F₁ = F₂ := by
        refine Algebra.FormallyUnramified.ext (Ideal.map π (RingHom.ker σ)) ⟨2, hN⟩ ?_
        intro x
        rw [Ideal.Quotient.eq]
        show π x - π (g (MvPolynomial.C (σ x))) ∈ _
        rw [← map_sub]
        exact Ideal.mem_map_of_mem _ (hdiff x)
      intro x hx
      have h1 : F₁ x = F₂ x := by rw [hF]
      have h2 : F₂ x = 0 := by
        show π (g (MvPolynomial.C (σ x))) = 0
        rw [RingHom.mem_ker.mp hx, map_zero, map_zero, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp (h1.trans h2)
    obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
      (I := RingHom.ker σ) (N := Ideal.span {g (MvPolynomial.X 0) - g (MvPolynomial.C a)})
      (N' := RingHom.ker σ) (P := RingHom.ker σ) hfg le_rfl (by
        rw [Ideal.smul_eq_mul, ← sq, sup_comm]
        exact hcot)
    refine ⟨r, ?_, ?_⟩
    · have h : r - 1 ∈ RingHom.ker θ := hker ▸ hr1
      rw [RingHom.mem_ker, map_sub, map_one, sub_eq_zero] at h
      exact h
    · intro j hj
      have hjK : j ∈ RingHom.ker σ := hker.symm ▸ hj
      have h2 := hr (Submodule.smul_mem_pointwise_smul j r (RingHom.ker σ) hjK)
      rw [smul_eq_mul, Ideal.mem_span_singleton'] at h2
      obtain ⟨y, hy⟩ := h2
      exact ⟨y, hy.symm⟩

  have s4 : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] [Algebra A B]
      (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* R) (θB : B →+* R) (ρ : A) (c : R),
      g.Etale → IsLocalization.Away ρ B → (∀ w : R, θ (g (MvPolynomial.C w)) = w) →
      θ (g (MvPolynomial.X 0)) = c →
      (∀ j ∈ RingHom.ker θ, ∃ y : A,
        ρ * j = y * (g (MvPolynomial.X 0) - g (MvPolynomial.C c))) →
      θB.comp (algebraMap A B) = θ →
      ((algebraMap A B).comp (g.comp (MvPolynomial.eval₂Hom MvPolynomial.C
          (fun _ : Fin 1 => MvPolynomial.X 0 - MvPolynomial.C c)))).Etale ∧
      θB.comp ((algebraMap A B).comp (g.comp (MvPolynomial.eval₂Hom MvPolynomial.C
          (fun _ : Fin 1 => MvPolynomial.X 0 - MvPolynomial.C c)))) =
        MvPolynomial.eval (fun _ : Fin 1 => (0 : R)) ∧
      RingHom.ker θB =
        Ideal.span {algebraMap A B (g (MvPolynomial.X 0) - g (MvPolynomial.C c))} := by
    intro R A B _ _ _ _ g θ θB ρ c hg hloc hθC hθX hρ hθB
    have hθBa : ∀ a, θB (algebraMap A B a) = θ a := fun a => RingHom.congr_fun hθB a
    refine ⟨?_, ?_, ?_⟩
    · let sh : MvPolynomial (Fin 1) R →+* MvPolynomial (Fin 1) R :=
        MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.X 0 - MvPolynomial.C c)
      let sh' : MvPolynomial (Fin 1) R →+* MvPolynomial (Fin 1) R :=
        MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.X 0 + MvPolynomial.C c)
      have h1 : ∀ p, sh (sh' p) = p := by
        intro p
        have : sh.comp sh' = RingHom.id _ := by
          apply MvPolynomial.ringHom_ext
          · intro r; simp [sh, sh']
          · intro i; rw [Fin.fin_one_eq_zero i]; simp [sh, sh']
        exact RingHom.congr_fun this p
      have h2 : ∀ p, sh' (sh p) = p := by
        intro p
        have : sh'.comp sh = RingHom.id _ := by
          apply MvPolynomial.ringHom_ext
          · intro r; simp [sh, sh']
          · intro i; rw [Fin.fin_one_eq_zero i]; simp [sh, sh']
        exact RingHom.congr_fun this p
      have hbij : Function.Bijective sh :=
        ⟨Function.LeftInverse.injective h2, Function.RightInverse.surjective h1⟩
      have hshE : sh.Etale := RingHom.Etale.of_bijective hbij
      have hαE : (algebraMap A B).Etale := by
        haveI := hloc
        haveI : Algebra.Etale A B := Algebra.Etale.of_isLocalizationAway ρ
        exact RingHom.etale_algebraMap.mpr inferInstance
      exact RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _ hshE hg) hαE
    · apply MvPolynomial.ringHom_ext
      · intro w
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hθBa, hθC, MvPolynomial.eval_C]
      · intro i
        rw [Fin.fin_one_eq_zero i]
        simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', map_sub, hθBa, hθC, hθX,
          sub_self, MvPolynomial.eval_X]
    · haveI := hloc
      apply le_antisymm
      · intro b hb
        rw [RingHom.mem_ker] at hb
        obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj ρ b
        have ha0 : a ∈ RingHom.ker θ := by
          rw [RingHom.mem_ker, ← hθBa, ← hna, map_mul, hb, zero_mul]
        obtain ⟨y, hy⟩ := hρ a ha0
        obtain ⟨u, hu⟩ := (IsLocalization.Away.algebraMap_isUnit (S := B) ρ).pow (n + 1)
        have e1 := congrArg (algebraMap A B) hy
        rw [map_mul, map_mul] at e1
        rw [Ideal.mem_span_singleton']
        refine ⟨algebraMap A B y * ↑u⁻¹, ?_⟩
        have key : b * ↑u = algebraMap A B y *
            algebraMap A B (g (MvPolynomial.X 0) - g (MvPolynomial.C c)) := by
          linear_combination b * hu + algebraMap A B ρ * hna + e1
        calc algebraMap A B y * ↑u⁻¹ *
              algebraMap A B (g (MvPolynomial.X 0) - g (MvPolynomial.C c))
            = (algebraMap A B y * algebraMap A B (g (MvPolynomial.X 0) - g (MvPolynomial.C c)))
                * ↑u⁻¹ := by ring
          _ = b * ↑u * ↑u⁻¹ := by rw [key]
          _ = b := by rw [mul_assoc, Units.mul_inv, mul_one]
      · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, hθBa, map_sub, hθX, hθC, sub_self]

  have s6 : ∀ (S : Type u) [CommRing S] (T : Scheme.{u}) (f f' : T ⟶ Spec (.of S)),
      (∀ p : S, f.appTop.hom ((Scheme.ΓSpecIso (.of S)).inv.hom p) =
        f'.appTop.hom ((Scheme.ΓSpecIso (.of S)).inv.hom p)) → f = f' := by
    intro S _ T f f' h
    apply ext_of_isAffine
    ext z
    have h2 := h ((Scheme.ΓSpecIso (.of S)).hom.hom z)
    rwa [isoHI] at h2
  intro Ω _ _ W hW hWt X uX ι hM x V hle g 𝔭 hch σ hσ hσx
  classical
  have pm : ∀ {U₁ U₂ U₃ : X.Opens} (f : Opposite.op U₁ ⟶ Opposite.op U₂)
      (f' : Opposite.op U₂ ⟶ Opposite.op U₃) (h : Opposite.op U₁ ⟶ Opposite.op U₃),
      X.presheaf.map f ≫ X.presheaf.map f' = X.presheaf.map h := fun f f' h =>
    (X.presheaf.map_comp f f').symm.trans
      (congrArg X.presheaf.map (Quiver.Hom.unop_inj (Subsingleton.elim _ _)))
  have pm3 : ∀ {U₁ U₂ U₃ U₄ : X.Opens} (f : Opposite.op U₁ ⟶ Opposite.op U₂)
      (f' : Opposite.op U₂ ⟶ Opposite.op U₃) (f'' : Opposite.op U₃ ⟶ Opposite.op U₄)
      (h : Opposite.op U₁ ⟶ Opposite.op U₄),
      X.presheaf.map f ≫ X.presheaf.map f' ≫ X.presheaf.map f'' = X.presheaf.map h :=
    fun f f' f'' h =>
      (congrArg (fun z => X.presheaf.map f ≫ z) (pm f' f'' (f' ≫ f''))).trans (pm _ _ h)
  obtain ⟨hV, hxV, -, hgE, hgC, -⟩ := hch
  have hσV : σ (IsLocalRing.closedPoint ↥W) ∈ V := hσx ▸ hxV
  have eσ : (⊤ : (Spec (.of ↥W)).Opens) ≤ σ ⁻¹ᵁ V :=
    (Scheme.preimage_eq_top_of_closedPoint_mem σ hσV).ge
  let θ : ↑Γ(X, V) →+* ↥W := (Scheme.ΓSpecIso (.of ↥W)).hom.hom.comp (σ.appLE V ⊤ eσ).hom
  have hθφ : ∀ w : ↥W, θ (wcG2cPhi W uX V hle w) = w := by
    intro w
    have key : ∀ (Y : Scheme.{u}) (f : Y ⟶ Y), f = 𝟙 Y → ∀ h : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ ⊤,
        f.appLE ⊤ ⊤ h = 𝟙 _ := by
      intro Y f hf h
      subst hf
      exact (Scheme.Hom.appLE_eq_app (𝟙 Y) (U := ⊤)).trans (Scheme.Hom.id_app (X := Y) ⊤)
    have h2 : uX.appLE ⊤ V hle ≫ σ.appLE V ⊤ eσ = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact key _ _ hσ _
    have h3 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) h2
    simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.comp_apply,
      RingHom.id_apply] at h3
    show (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE V ⊤ eσ).hom ((uX.appLE ⊤ V hle).hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w))) = w
