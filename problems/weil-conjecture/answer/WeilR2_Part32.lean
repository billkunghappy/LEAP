    have hαH : ∀ α ∈ IsLocalRing.maximalIdeal W, IsCoprime (Polynomial.X - Polynomial.C α) H := by
      intro α hα
      have key : ∀ s : Multiset W, (∀ γ ∈ s, γ ∉ IsLocalRing.maximalIdeal W) →
          IsCoprime (Polynomial.X - Polynomial.C α)
            (s.map (fun α => Polynomial.X - Polynomial.C α)).prod := by
        intro s
        induction s using Multiset.induction_on with
        | empty => intro _; simp [isCoprime_one_right]
        | cons γ s ih =>
