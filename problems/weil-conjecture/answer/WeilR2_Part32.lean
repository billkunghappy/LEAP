  intro Ω _ _ W hW hWt C γ hcov X₁ u₁ ι₁ _ _ hM σ₁ hσ₁ w₁ hw₁ hsm₁ hN c hc0 hcm X'' r'' ι'' _ _
    hbl hι hM'' V'' hV'' hiso y hyx hysm

  have hext : ∀ (k₀ : Type u) [Field k₀] (Y : Scheme.{u})
      (q : Y ⟶ Spec (.of k₀)) (U₀ : Y.Opens) (T : Type u) [CommRing T] [Algebra k₀ T]
