            X.presheaf.map (homOfLE (inf_le_right : ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l ≤
              b ⁻¹ᵁ wcSgD K N l)).op (g l) := ⟨_, fun l => rfl⟩
      have hc : ∀ l m : Fin (N + 1),
          X.presheaf.map (homOfLE (inf_le_left : (ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l) ⊓
            (ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N m) ≤
              ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l)).op (P l) =
          X.presheaf.map (homOfLE (inf_le_right : (ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l) ⊓
            (ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N m) ≤
              ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N m)).op (P m) := by
        intro l m
        rw [hP, hP, map_mul, map_pow, map_mul, map_pow, happLE_res, happLE_res, hres_comp,
          hres_comp]
        exact hkey A l m _ _
          (le_inf (inf_le_left.trans inf_le_right) (inf_le_right.trans inf_le_right))
      obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf
        (fun l => ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l) (ψ ⁻¹ᵁ wcSgD K M A)
        (fun l => homOfLE inf_le_left) (hcovA A) P hc
      exact ⟨s, fun l => (hs l).trans (hP l)⟩
    choose f hf using hglue
    have hfres : ∀ (A : Fin (M + 1)) (l : Fin (N + 1)) (Y : X.Opens)
        (hY : Y ≤ ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l),
        X.presheaf.map (homOfLE (hY.trans inf_le_left)).op (f A) =
          (ψ.appLE (wcSgD K M A) Y (hY.trans inf_le_left) (wcSgE K M A (J0 l))) ^ e *
            X.presheaf.map (homOfLE (hY.trans inf_le_right)).op (g l) := by
      intro A l Y hY
      rw [← hres_comp _ _ _ inf_le_left hY, hf A l, map_mul, map_pow, happLE_res, hres_comp]
    refine ⟨f, ?_, ?_⟩
    · intro A B
      refine TopCat.Sheaf.eq_of_locally_eq' X.sheaf
        (fun l => (ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B) ⊓ b ⁻¹ᵁ wcSgD K N l) _
        (fun l => homOfLE inf_le_left) ?_ _ _ ?_
      · rw [← inf_iSup_eq, hU, inf_top_eq]
      · intro l
        have hXA : (ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B) ⊓ b ⁻¹ᵁ wcSgD K N l ≤
            ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l :=
          le_inf (inf_le_left.trans inf_le_left) inf_le_right
        have hXB : (ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B) ⊓ b ⁻¹ᵁ wcSgD K N l ≤
            ψ ⁻¹ᵁ wcSgD K M B ⊓ b ⁻¹ᵁ wcSgD K N l :=
          le_inf (inf_le_left.trans inf_le_right) inf_le_right
        have e1 := hfres B l _ hXB
        have e2 := hfres A l _ hXA
        have e3 := hQ2 (J0 l) A B _ (hXA.trans inf_le_left) (hXB.trans inf_le_left)
        have e4 := hGψ A B ((ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B) ⊓ b ⁻¹ᵁ wcSgD K N l)
          inf_le_left
        show X.presheaf.map (homOfLE (inf_le_left : (ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B) ⊓
              b ⁻¹ᵁ wcSgD K N l ≤ _)).op
            (X.presheaf.map (homOfLE (inf_le_right : ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B ≤
              _)).op (f B)) =
          X.presheaf.map (homOfLE (inf_le_left : (ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B) ⊓
              b ⁻¹ᵁ wcSgD K N l ≤ _)).op
            (wcEszG ψ A B ^ e * X.presheaf.map (homOfLE (inf_le_left :
              ψ ⁻¹ᵁ wcSgD K M A ⊓ ψ ⁻¹ᵁ wcSgD K M B ≤ _)).op (f A))
        rw [map_mul, map_pow, hres_comp, hres_comp, e4, e1, e2, e3]
        ring
    · intro l
      have h := hfres (J0 l) l (b ⁻¹ᵁ wcSgD K N l) (le_inf (hψ l) le_rfl)
      rw [hQ1, one_pow, one_mul, hid] at h
      exact h

  have rk_mono : ∀ {N₁ N₂ : ℕ} (φ₁ : X ⟶ wcProjK K N₁) (φ₂ : X ⟶ wcProjK K N₂) (e₁ e₂ : ℕ)
      (Φ : ↥(wcGcDfSec φ₁ e₁) → ↥(wcGcDfSec φ₂ e₂)),
      (∀ (n : ℕ) (v : Fin n → ↥(wcGcDfSec φ₁ e₁)) (c : Fin n → K),
        (∀ a : Fin (N₂ + 1), ∑ i, wcEszScal φ₂ (φ₂ ⁻¹ᵁ wcSgD K N₂ a) (c i) * (Φ (v i)).1 a = 0) →
        ∀ a : Fin (N₁ + 1), ∑ i, wcEszScal φ₁ (φ₁ ⁻¹ᵁ wcSgD K N₁ a) (c i) * (v i).1 a = 0) →
      wcGcDfRk φ₁ e₁ ≤ wcGcDfRk φ₂ e₂ := by
    intro N₁ N₂ φ₁ φ₂ e₁ e₂ Φ hΦ
    unfold wcGcDfRk
    refine iSup_le fun n => iSup_le fun v => iSup_le fun hv => ?_
    exact le_iSup_of_le n (le_iSup_of_le (fun i => Φ (v i))
      (le_iSup_of_le (fun c hc => hv c (hΦ n v c hc)) le_rfl))
  refine ⟨M, ψ, E, hci, hover, hE, 0, fun e _ => le_antisymm ?_ ?_⟩
  · refine rk_mono ψ b e (E * e)
      (fun f => ⟨fun l => X.presheaf.map (homOfLE (hψ l)).op (f.1 (J0 l)), hΦmem e f.1 f.2⟩) ?_
    intro n v c hc
    exact hrefl1 e n v c hc
  · choose F hFmem hFext using hext e
    refine rk_mono b ψ (E * e) e (fun g => ⟨F g.1 g.2, hFmem g.1 g.2⟩) ?_
    intro n w c hc l
    have h0 := congrArg (fun x => X.presheaf.map (homOfLE (hψ l)).op x) (hc (J0 l))
    simp only [map_sum, map_mul, map_zero, hscal, hFext] at h0
    exact h0

theorem wcpa_dj_lr1k_ll_gc_delta_formula : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ]
    (Z : Scheme.{u}) (s : Z ⟶ Spec (.of κ)) (c : ℤ),
    AlgebraicGeometry.IsReduced Z → wcGcChi κ s c →
    ∃ (Zt : Scheme.{u}) (ν : Zt ⟶ Z) (ct : ℤ), wcGcNormDatum ν ∧ wcGcChi κ (ν ≫ s) ct ∧
      c ≤ ct ∧
      (⨆ t : Finset ↥Z, ∑ z ∈ t, wcpaDjLkDelta (Z.presheaf.stalk z)) =
        (((ct - c).toNat : ℕ) : ℕ∞) :=
by
  intro κ _ _ Z s c hred hchi
  obtain ⟨N, j, hj, hjs, d, e₀, hH⟩ := hchi

  have hdim : topologicalKrullDim ↥Z ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    refine wcpa_dj_lr1k_ll_gc_df_dim_le_one κ Z j hj ⟨d, c.toNat, e₀, fun e he => ?_⟩
    have h1 := hH e he
    have h2 : c ≤ ((c.toNat : ℕ) : ℤ) := by omega
    have h3 : ((wcGcHilb j e : ℕ) : ℤ) ≤ ((d * e + c.toNat : ℕ) : ℤ) := by
      rw [Nat.cast_add, Nat.cast_mul]
      linarith
    exact Int.ofNat_le.mp h3

  obtain ⟨Zt, ν, hν⟩ := wcpa_dj_lr1k_ll_gc_df_norm_exists κ Z j hj hred hdim
  haveI : IsFinite ν := hν.1
  have hdimt : topologicalKrullDim ↥Zt ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    (wc_finite_topologicalKrullDim_le ν).trans hdim

  obtain ⟨e₂, hjump⟩ := wcpa_dj_lr1k_ll_gc_df_sections_jump κ Z j hj hred hdim Zt ν hν
    (wcpa_dj_lr1k_ll_gc_df_serre_curve κ Z j hj hdim)

  obtain ⟨M, j', E, hj', hj's, hE, e₃, hre⟩ := wcpa_dj_lr1k_ll_gc_df_reembed κ j hj ν hν.1

  obtain ⟨e₁, hs1⟩ := wcpa_dj_lr1k_ll_gc_df_hilb_sections κ Z j hj hdim
  obtain ⟨e₄, hs4⟩ := wcpa_dj_lr1k_ll_gc_df_hilb_sections κ Zt j' hj' hdimt
  set S : ℕ∞ := ⨆ t : Finset ↥Z, ∑ z ∈ t, wcpaDjLkDelta (Z.presheaf.stalk z) with hS
  set e' : ℕ := max (max e₀ e₁) (max (max e₂ e₃) (max e₄ 1)) with he'
  have key : ∀ e : ℕ, e' ≤ e →
      ((wcGcHilb j' e : ℕ) : ℕ∞) = ((wcGcHilb j (E * e) : ℕ) : ℕ∞) + S := by
    intro e he
    simp only [he', max_le_iff] at he
    obtain ⟨⟨_, h1⟩, ⟨h2, h3⟩, h4, _⟩ := he
    have hEe : e ≤ E * e := le_mul_of_one_le_left (Nat.zero_le e) hE
    rw [hs4 e h4, hre e h3, hjump (E * e) (le_trans h2 hEe), ← hs1 (E * e) (le_trans h1 hEe)]
  have hStop : S ≠ ⊤ := by
    intro htop
    have h := key e' le_rfl
    rw [htop, add_top] at h
    exact ENat.coe_ne_top _ h
  set D : ℕ := S.toNat with hD
  have hSD : S = (D : ℕ∞) := (ENat.coe_toNat hStop).symm
  have keyN : ∀ e : ℕ, e' ≤ e → wcGcHilb j' e = wcGcHilb j (E * e) + D := by
    intro e he
    have h := key e he
    rw [hSD] at h
    exact_mod_cast h
  refine ⟨Zt, ν, c + (D : ℤ), hν, ⟨M, j', hj', by rw [hj's, hjs], d * E, e', fun e he => ?_⟩,
    ?_, ?_⟩
  · have h1 := keyN e he
    have he0 : e₀ ≤ e := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) he
    have hEe : e ≤ E * e := le_mul_of_one_le_left (Nat.zero_le e) hE
    have h2 := hH (E * e) (le_trans he0 hEe)
    have h1' : ((wcGcHilb j' e : ℕ) : ℤ) = ((wcGcHilb j (E * e) : ℕ) : ℤ) + (D : ℤ) := by
      exact_mod_cast h1
    rw [h1', h2]
    push_cast
    ring
  · have : (0 : ℤ) ≤ (D : ℤ) := Nat.cast_nonneg D
    linarith
  · rw [hSD]
    congr 1
    omega

theorem wcpa_dj_lr1k_ebc_exc_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι →
    ∀ y₀ : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
      wcpaDjLkSmAt W uX (wcpaDjLkPi W (γ ≫ ι) uX y₀) →
    ∀ (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
      wcpaDjLlPair W uX (wcpaDjLkImg W (γ ≫ ι) uX y₀) σ' a' →
    ∀ (X' : Scheme.{u}) (r : X' ⟶ X) (ι' : wcProjK Ω 1 ⟶ X')
      [QuasiCompact (γ ≫ ι')] [QuasiSeparated (γ ≫ ι')],
      wcCsdIsBlowup (σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a') r → ι' ≫ r = ι →
      wcpaDjLkModel W (r ≫ uX) ι' →
      ∀ V : X.Opens, (V : Set X) = {wcpaDjLkImg W (γ ≫ ι) uX y₀}ᶜ → IsIso (r ∣_ V) →
      (wcpaDjEbcExc W (γ ≫ ι') (r ≫ uX) r (wcpaDjLkImg W (γ ≫ ι) uX y₀)).Finite :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y₀ hSm σ' a' hP X' r ι' _ _ hbl hι' hM' V hV hiso
  haveI hν : IsFinite (γ ≫ ι').fromNormalization :=
    wcpa_dj_lr1s_normalization_finite Ω W hW hWt C (γ ≫ wcProjKStr Ω 1) γ hcov.1 hcov.2.1
      hcov.2.2.1 hcov.2.2.2.1 rfl hcov.2.2.2.2 X' (r ≫ uX) ι' hM'.1 hM'.2.1 hM'.2.2
  haveI hprop : IsProper (r ≫ uX) := hM'.1.2.1
  haveI hLN : IsLocallyNoetherian (Limits.pullback ((γ ≫ ι').fromNormalization ≫ (r ≫ uX))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd
      ((γ ≫ ι').fromNormalization ≫ (r ≫ uX))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  haveI hCS : CompactSpace ↥(Limits.pullback ((γ ≫ ι').fromNormalization ≫ (r ≫ uX))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd
      ((γ ≫ ι').fromNormalization ≫ (r ≫ uX))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  haveI hN : AlgebraicGeometry.IsNoetherian (Limits.pullback ((γ ≫ ι').fromNormalization ≫ (r ≫ uX))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    AlgebraicGeometry.IsNoetherian.mk
  have hfin : (irreducibleComponents ↥(Limits.pullback ((γ ≫ ι').fromNormalization ≫ (r ≫ uX))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  exact hfin.subset (fun E hE => hE.1)

theorem wcpa_dj_lr1k_ebcn_normdatum_generic : ∀ (κ : Type u) [Field κ] {Zt Z : Scheme.{u}} (ν : Zt ⟶ Z) (s : Z ⟶ Spec (.of κ)) (c : ℤ), wcGcNormDatum ν → wcGcChi κ (ν ≫ s) c → (irreducibleComponents ↥Zt).Finite ∧ (∀ D ∈ irreducibleComponents ↥Zt, IsOpen D) ∧ (∀ a : ↥Zt, closure {a} ∈ irreducibleComponents ↥Zt → closure {ν a} ∈ irreducibleComponents ↥Z) ∧ (∀ ξ : ↥Z, closure {ξ} ∈ irreducibleComponents ↥Z → ∃ a : ↥Zt, ν a = ξ ∧ closure {a} ∈ irreducibleComponents ↥Zt ∧ IsIso (ν.stalkMap a) ∧ ∀ a' : ↥Zt, ν a' = ξ → a' = a) :=
by
  intro κ _ Zt Z ν s c hND hχ
  classical
  obtain ⟨hfin, hstalk, U, hUd, hVd, hiso⟩ := hND
  haveI := hfin
  haveI := hiso

  have hP : ∀ n : ℕ, IsProper (wcProjKStr κ n) := by
    intro n
    letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) κ _
    letI : IsScalarTower κ ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) 0)
        (MvPolynomial (Fin (n+1)) κ) :=
      IsScalarTower.of_algebraMap_eq (R := κ)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) 0)
        (A := MvPolynomial (Fin (n+1)) κ) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) 0)
        (MvPolynomial (Fin (n+1)) κ) :=
      Algebra.FiniteType.of_restrictScalars_finiteType κ _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap κ ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) 0 =>
          (x : MvPolynomial (Fin (n+1)) κ)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (n+1)) κ).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (n+1)) κ).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (n+1)) κ).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap κ ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap κ ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) κ) 0))))
    infer_instance

  have gen : ∀ {Y : Scheme.{u}} (E : Set ↥Y), E ∈ irreducibleComponents ↥Y →
      ∃ η : ↥Y, closure ({η} : Set ↥Y) = E := by
    intro Y E hE
    have hirr : IsIrreducible E := hE.1
    refine ⟨hirr.genericPoint, ?_⟩
    have h1 : closure ({hirr.genericPoint} : Set ↥Y) = closure E :=
      hirr.isGenericPoint_genericPoint_closure
    rw [h1, (isClosed_of_mem_irreducibleComponents E hE).closure_eq]

  have s4 : ∀ {Y : Scheme.{u}} (x : ↥Y), closure ({x} : Set ↥Y) ∈ irreducibleComponents ↥Y ↔
      ∀ w : ↥Y, w ⤳ x → w = x := by
    intro Y x
    constructor
    · intro hx w hw
      have h1 : closure ({x} : Set ↥Y) ⊆ closure {w} := specializes_iff_closure_subset.mp hw
      have h2 : closure ({x} : Set ↥Y) = closure {w} :=
        hx.eq_of_subset isIrreducible_singleton.closure h1
      exact (inseparable_iff_closure_eq.mpr h2.symm).eq
    · intro hmax
      obtain ⟨D, hD, hxD⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
        (isIrreducible_singleton (x := x)).closure
      obtain ⟨d, hd⟩ := gen D hD
      have hdx : d ⤳ x := by
        rw [specializes_iff_mem_closure, hd]; exact hxD (subset_closure (Set.mem_singleton x))
      rw [← hmax d hdx, hd]; exact hD

  have s3 : ∀ {Y : Scheme.{u}}, (irreducibleComponents ↥Y).Finite → ∀ (O : Set ↥Y), IsOpen O →
      Dense O → ∀ x : ↥Y, closure ({x} : Set ↥Y) ∈ irreducibleComponents ↥Y → x ∈ O := by
    intro Y hF O hO hOd x hx
    have hR : IsClosed (⋃₀ (irreducibleComponents ↥Y \ {closure ({x} : Set ↥Y)})) :=
      (hF.subset Set.diff_subset).isClosed_sUnion
        (fun E hE => isClosed_of_mem_irreducibleComponents E hE.1)
    have hxR : x ∉ ⋃₀ (irreducibleComponents ↥Y \ {closure ({x} : Set ↥Y)}) := by
      rintro ⟨E, ⟨hE, hED⟩, hxE⟩
      apply hED
      have hsub : closure ({x} : Set ↥Y) ⊆ E :=
        closure_minimal (Set.singleton_subset_iff.mpr hxE)
          (isClosed_of_mem_irreducibleComponents E hE)
      exact (hx.eq_of_subset hE.1 hsub).symm
    obtain ⟨p, hpR, hpO⟩ := hOd.inter_open_nonempty _ hR.isOpen_compl ⟨x, hxR⟩
    obtain ⟨E, hE, hpE⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {p} isIrreducible_singleton
    have hED : E = closure ({x} : Set ↥Y) := by
      by_contra hne
      exact hpR ⟨E, ⟨hE, hne⟩, hpE (Set.mem_singleton p)⟩
    have hpD : p ∈ closure ({x} : Set ↥Y) := hED ▸ hpE (Set.mem_singleton p)
    have hxp : x ⤳ p := specializes_iff_mem_closure.mpr hpD
    exact hxp.mem_open hO hpO

  have s2 : ∀ D₁ ∈ irreducibleComponents ↥Zt, ∀ D₂ ∈ irreducibleComponents ↥Zt,
      (D₁ ∩ D₂).Nonempty → D₁ = D₂ := by
    intro D₁ hD₁ D₂ hD₂ hne
    obtain ⟨z, hz₁, hz₂⟩ := hne
    haveI : IsDomain (Zt.presheaf.stalk z) := (hstalk z).1
    let g₀ : ↥(Spec (Zt.presheaf.stalk z)) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum _)
    have key : ∀ D ∈ irreducibleComponents ↥Zt, z ∈ D →
        D = closure ({Zt.fromSpecStalk z g₀} : Set ↥Zt) := by
      intro D hD hzD
      obtain ⟨d, hd⟩ := gen D hD
      have hdz : d ⤳ z := by rw [specializes_iff_mem_closure, hd]; exact hzD
      have hmem : d ∈ Set.range (Zt.fromSpecStalk z) := by
        rw [Scheme.range_fromSpecStalk]; exact hdz
      obtain ⟨p, hp⟩ := hmem
      have hg₀p : g₀ ⤳ p := (PrimeSpectrum.le_iff_specializes _ _).mp
        (show (⊥ : Ideal (Zt.presheaf.stalk z)) ≤ (p : PrimeSpectrum _).asIdeal from bot_le)
      have hgd : Zt.fromSpecStalk z g₀ ⤳ d := by
        rw [← hp]; exact hg₀p.map (Zt.fromSpecStalk z).continuous
      have hsub : D ⊆ closure ({Zt.fromSpecStalk z g₀} : Set ↥Zt) := by
        rw [← hd]; exact specializes_iff_closure_subset.mp hgd
      exact hD.eq_of_subset isIrreducible_singleton.closure hsub
    rw [key D₁ hD₁ hz₁, key D₂ hD₂ hz₂]

  have hstar : ∀ x : (ν ⁻¹ᵁ U).toScheme, U.ι ((ν ∣_ U) x) = ν ((ν ⁻¹ᵁ U).ι x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι]
  have hinvθ : ∀ y : U.toScheme, (ν ∣_ U) (inv (ν ∣_ U) y) = y := by
    intro y
    rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]; rfl
  have hθinv : ∀ x : (ν ⁻¹ᵁ U).toScheme, inv (ν ∣_ U) ((ν ∣_ U) x) = x := by
    intro x
    rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]; rfl
  have hUι : ∀ ξ : ↥Z, ξ ∈ U → ∃ y : U.toScheme, U.ι y = ξ := by
    intro ξ hξ
    have h : ξ ∈ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hξ
    exact h
  have hVι : ∀ a : ↥Zt, ν a ∈ U → ∃ x : (ν ⁻¹ᵁ U).toScheme, (ν ⁻¹ᵁ U).ι x = a := by
    intro a ha
    have h : a ∈ Set.range (ν ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]; exact (Scheme.Hom.mem_preimage ν).mpr ha
    exact h
  have hex : ∀ ξ : ↥Z, ξ ∈ U → ∃ a : ↥Zt, ν a = ξ := by
    intro ξ hξ
    obtain ⟨y, rfl⟩ := hUι ξ hξ
    refine ⟨(ν ⁻¹ᵁ U).ι (inv (ν ∣_ U) y), ?_⟩
    rw [← hstar, hinvθ]
  have huniq : ∀ a : ↥Zt, ν a ∈ U → ∀ a' : ↥Zt, ν a' = ν a → a' = a := by
    intro a ha a' ha'
    obtain ⟨x, rfl⟩ := hVι a ha
    obtain ⟨x', rfl⟩ := hVι a' (ha'.symm ▸ ha)
    have h1 : U.ι ((ν ∣_ U) x') = U.ι ((ν ∣_ U) x) := by
      rw [hstar, hstar]; exact ha'
    have h2 : (ν ∣_ U) x' = (ν ∣_ U) x := U.ι.isOpenEmbedding.isEmbedding.injective h1
    have h3 := congrArg (inv (ν ∣_ U)) h2
    rw [hθinv, hθinv] at h3
    rw [h3]
  have hstk : ∀ a : ↥Zt, ν a ∈ U → IsIso (ν.stalkMap a) := by
    intro a ha
    obtain ⟨x, rfl⟩ := hVι a ha
    have h := (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms CommRingCat)
      (morphismRestrictStalkMap ν U x)).mp
        ((MorphismProperty.isomorphisms.iff _).mpr inferInstance)
    have h' := (MorphismProperty.isomorphisms.iff _).mp h
    exact h'
  have hdown : ∀ a : ↥Zt, ν a ∈ U → (∀ w : ↥Z, w ⤳ ν a → w = ν a) →
      ∀ w : ↥Zt, w ⤳ a → w = a := by
    intro a ha hmax w hw
    exact huniq a ha w (hmax (ν w) (hw.map ν.continuous))
  have hup : ∀ a : ↥Zt, ν a ∈ U → (∀ w : ↥Zt, w ⤳ a → w = a) →
      ∀ w : ↥Z, w ⤳ ν a → w = ν a := by
    intro a ha hmax w hw
    have hwU : w ∈ U := hw.mem_open U.isOpen ha
    obtain ⟨x, rfl⟩ := hVι a ha
    obtain ⟨yw, rfl⟩ := hUι w hwU
    rw [← hstar] at hw ⊢
    have hsp : yw ⤳ (ν ∣_ U) x := (U.ι.isOpenEmbedding.isInducing.specializes_iff).mp hw
    have hsp2 := hsp.map (inv (ν ∣_ U)).continuous
    rw [hθinv] at hsp2
    have hsp3 := hsp2.map (ν ⁻¹ᵁ U).ι.continuous
    have hb := hmax _ hsp3
    have hb' : inv (ν ∣_ U) yw = x := (ν ⁻¹ᵁ U).ι.isOpenEmbedding.isEmbedding.injective hb
    rw [← hb', hinvθ]

  have hsurj : Function.Surjective ν := by
    intro ξ
    have hcl : IsClosed (Set.range ν) := ν.isClosedMap.isClosed_range
    have hsub : (U : Set ↥Z) ⊆ Set.range ν := fun ξ hξ => hex ξ hξ
    have h := closure_minimal hsub hcl
    rw [hUd.closure_eq] at h
    exact h (Set.mem_univ ξ)

  obtain ⟨N, j, hj, hjt, -⟩ := hχ
  haveI := hj
  haveI : IsProper (wcProjKStr κ N) := hP N
  haveI : QuasiCompact (j ≫ wcProjKStr κ N) := inferInstance
  haveI : LocallyOfFiniteType (j ≫ wcProjKStr κ N) := inferInstance
  haveI : IsLocallyNoetherian Zt := LocallyOfFiniteType.isLocallyNoetherian (j ≫ wcProjKStr κ N)
  haveI : CompactSpace Zt := QuasiCompact.compactSpace_of_compactSpace (j ≫ wcProjKStr κ N)
  haveI : AlgebraicGeometry.IsNoetherian Zt := AlgebraicGeometry.IsNoetherian.mk
  haveI : TopologicalSpace.NoetherianSpace Zt := inferInstance
  haveI : TopologicalSpace.NoetherianSpace Z :=
    TopologicalSpace.noetherianSpace_of_surjective ν ν.continuous hsurj
  have hfinZt : (irreducibleComponents ↥Zt).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hfinZ : (irreducibleComponents ↥Z).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  refine ⟨hfinZt, ?_, ?_, ?_⟩
  · intro D hD
    have hEq : Dᶜ = ⋃₀ (irreducibleComponents ↥Zt \ {D}) := by
      ext z
      constructor
      · intro hz
        obtain ⟨E, hE, hzE⟩ :=
          exists_mem_irreducibleComponents_subset_of_isIrreducible {z} isIrreducible_singleton
        refine ⟨E, ⟨hE, ?_⟩, hzE (Set.mem_singleton z)⟩
        intro hED
        rw [Set.mem_singleton_iff] at hED
        exact hz (hED ▸ hzE (Set.mem_singleton z))
      · rintro ⟨E, ⟨hE, hED⟩, hzE⟩ hzD
        exact hED (Set.mem_singleton_iff.mpr (s2 E hE D hD ⟨z, hzE, hzD⟩))
    have hcl : IsClosed Dᶜ := by
      rw [hEq]
      exact (hfinZt.subset Set.diff_subset).isClosed_sUnion
        (fun E hE => isClosed_of_mem_irreducibleComponents E hE.1)
    exact isClosed_compl_iff.mp hcl
  · intro a ha
    have hmem : a ∈ ((ν ⁻¹ᵁ U : Zt.Opens) : Set ↥Zt) :=
      s3 hfinZt _ (ν ⁻¹ᵁ U).isOpen hVd a ha
    have hνa : ν a ∈ U := (Scheme.Hom.mem_preimage ν).mp hmem
    exact (s4 (ν a)).mpr (hup a hνa ((s4 a).mp ha))
  · intro ξ hξ
    have hξU : ξ ∈ (U : Set ↥Z) := s3 hfinZ _ U.isOpen hUd ξ hξ
    obtain ⟨a, rfl⟩ := hex ξ hξU
    refine ⟨a, rfl, (s4 a).mpr (hdown a hξU ((s4 (ν a)).mp hξ)), hstk a hξU, huniq a hξU⟩

theorem wcpa_dj_lr1k_ebcc_rank_additive : ∀ (K : Type u) [Field K] (T : Scheme.{u}) {N : ℕ} (φ : T ⟶ wcProjK K N) (m : ℕ) (O : Fin m → T.Opens), (∀ i k : Fin m, i ≠ k → ∀ x : ↥T, x ∈ O i → x ∉ O k) → (∀ x : ↥T, ∃ i, x ∈ O i) → ∀ e : ℕ, wcGcDfRk φ e = ∑ i, wcGcDfRk ((O i).ι ≫ φ) e :=
by
  intro K _ T N φ m O hdisj hcov e
  classical

  have hD : ∀ (M : Type u) [AddCommGroup M] [Module K M],
      (⨆ (n : ℕ) (v : Fin n → M) (_ : LinearIndependent K v), (n : ℕ∞)) =
        Cardinal.toENat (Module.rank K M) := by
    intro M _ _
    apply le_antisymm
    · refine iSup_le fun n => iSup_le fun v => iSup_le fun hv => ?_
      exact Cardinal.natCast_le_toENat.mpr (Module.le_rank_iff.mpr ⟨v, hv⟩)
    · rw [← ENat.forall_natCast_le_iff_le]
      intro n hn
      obtain ⟨v, hv⟩ := Module.le_rank_iff.mp (Cardinal.natCast_le_toENat.mp hn)
      exact le_iSup_of_le n (le_iSup_of_le v (le_iSup_of_le hv le_rfl))

  have hpi : ∀ (M' : Fin m → Type u) [∀ i, AddCommGroup (M' i)] [∀ i, Module K (M' i)],
      Cardinal.toENat (Module.rank K (∀ i, M' i)) = ∑ i, Cardinal.toENat (Module.rank K (M' i)) := by
    intro M' _ _
    have hfin : ∀ (P : Type u) [AddCommGroup P] [Module K P] [Module.Finite K P],
        Cardinal.toENat (Module.rank K P) = (Module.finrank K P : ℕ∞) := by
      intro P _ _ _
      rw [← Module.finrank_eq_rank, Cardinal.toENat_nat]
    have hinf : ∀ (P : Type u) [AddCommGroup P] [Module K P], ¬ Module.Finite K P →
        Cardinal.toENat (Module.rank K P) = ⊤ := by
      intro P _ _ h
      exact Cardinal.toENat_eq_top.mpr (not_lt.mp (fun h' => h (Module.rank_lt_aleph0_iff.mp h')))
    by_cases hall : ∀ i, Module.Finite K (M' i)
    · haveI := hall
      rw [hfin (∀ i, M' i), Module.finrank_pi_fintype]
      push_cast
      exact Finset.sum_congr rfl (fun i _ => (hfin (M' i)).symm)
    · push_neg at hall
      obtain ⟨k, hk⟩ := hall
      have hPinf : ¬ Module.Finite K (∀ i, M' i) := fun h => by
        haveI := h
        exact hk (Module.Finite.of_surjective (LinearMap.proj k) (LinearMap.proj_surjective k))
      rw [hinf _ hPinf]
      symm
      rw [eq_top_iff, ← hinf _ hk]
      exact Finset.single_le_sum (f := fun i => Cardinal.toENat (Module.rank K (M' i)))
        (fun i _ => zero_le) (Finset.mem_univ k)

  have hR : ∀ {S : Scheme.{u}} (κ : S ⟶ wcProjK K N) {W W' : S.Opens} (h : W' ≤ W) (c : K),
      (S.presheaf.map (homOfLE h).op).hom (wcEszScal κ W c) = wcEszScal κ W' c := by
    intro S κ W W' h c
    have key := congrArg (fun g => CommRingCat.Hom.hom g
        ((Scheme.Hom.appTop (κ ≫ wcProjKStr K N)).hom
          ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)))
      (S.presheaf.map_comp (homOfLE (le_top : W ≤ ⊤)).op (homOfLE h).op)
    exact key.symm

  have mkSub : ∀ {S : Scheme.{u}} (κ : S ⟶ wcProjK K N)
      [inst : ∀ a, Module K Γ(S, κ ⁻¹ᵁ wcSgD K N a)],
      (∀ a (c : K) (x : Γ(S, κ ⁻¹ᵁ wcSgD K N a)), c • x = wcEszScal κ _ c * x) →
      ∃ MS : Submodule K (∀ a, Γ(S, κ ⁻¹ᵁ wcSgD K N a)), ∀ f, f ∈ MS ↔ f ∈ wcGcDfSec κ e := by
    intro S κ _ hsmul
    refine ⟨{ carrier := wcGcDfSec κ e
              add_mem' := fun {f g} hf hg a b => by
                simp only [Pi.add_apply, map_add, hf a b, hg a b, mul_add]
              zero_mem' := fun a b => by
                simp only [Pi.zero_apply, map_zero, mul_zero]
              smul_mem' := fun c f hf a b => by
                simp only [Pi.smul_apply, hsmul, map_mul, hR, hf a b]
                ring },
      fun f => Iff.rfl⟩
  have ident : ∀ {S : Scheme.{u}} (κ : S ⟶ wcProjK K N)
      [inst : ∀ a, Module K Γ(S, κ ⁻¹ᵁ wcSgD K N a)],
      (∀ a (c : K) (x : Γ(S, κ ⁻¹ᵁ wcSgD K N a)), c • x = wcEszScal κ _ c * x) →
      ∀ MS : Submodule K (∀ a, Γ(S, κ ⁻¹ᵁ wcSgD K N a)), (∀ f, f ∈ MS ↔ f ∈ wcGcDfSec κ e) →
      wcGcDfRk κ e = Cardinal.toENat (Module.rank K MS) := by
    intro S κ _ hsmul MS hMS
    refine Eq.trans ?_ (hD ↥MS)
    unfold wcGcDfRk
    apply le_antisymm
    · refine iSup_le fun n => iSup_le fun v => iSup_le fun hv => ?_
      refine le_iSup_of_le n (le_iSup_of_le (fun j => (⟨(v j).1, (hMS _).mpr (v j).2⟩ : MS))
        (le_iSup_of_le ?_ le_rfl))
      rw [Fintype.linearIndependent_iff]
      intro g hg
      apply hv g
      intro a
      have h1 := congrArg (fun x : MS => (x : ∀ a, Γ(S, κ ⁻¹ᵁ wcSgD K N a)) a) hg
      simpa [Submodule.coe_sum, Finset.sum_apply, hsmul] using h1
    · refine iSup_le fun n => iSup_le fun w => iSup_le fun hw => ?_
      refine le_iSup_of_le n (le_iSup_of_le
        (fun j => (⟨(w j).1, (hMS _).mp (w j).2⟩ : ↥(wcGcDfSec κ e))) (le_iSup_of_le ?_ le_rfl))
      intro c hc
      apply (Fintype.linearIndependent_iff.mp hw) c
      apply Subtype.ext
      funext a
      simpa [Submodule.coe_sum, Finset.sum_apply, hsmul] using hc a

  have N' : ∀ {S₁ : Scheme.{u}} (θ : S₁ ⟶ T) {U U' : T.Opens} (h : U' ≤ U) (x : Γ(T, U)),
      (θ.app U').hom ((T.presheaf.map (homOfLE h).op).hom x) =
        (S₁.presheaf.map (homOfLE (θ.preimage_mono h)).op).hom ((θ.app U).hom x) := by
    intro S₁ θ U U' h x
    exact congrArg (fun g => g.hom x) (θ.naturality (homOfLE h).op)
  have hs : ∀ {S₁ : Scheme.{u}} (θ : S₁ ⟶ T) (a : Fin (N + 1)) (c : K),
      wcEszScal (θ ≫ φ) ((θ ≫ φ) ⁻¹ᵁ wcSgD K N a) c =
        (θ.app (φ ⁻¹ᵁ wcSgD K N a)).hom (wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) c) := by
    intro S₁ θ a c
    have e1 : Scheme.Hom.appTop ((θ ≫ φ) ≫ wcProjKStr K N) =
        Scheme.Hom.appTop (φ ≫ wcProjKStr K N) ≫ θ.appTop := by
      rw [Category.assoc, Scheme.Hom.comp_appTop]
    simp only [wcEszScal, RingHom.comp_apply, e1, CommRingCat.hom_comp]
    exact (N' θ (U := ⊤) (U' := φ ⁻¹ᵁ wcSgD K N a) le_top _).symm
  have hG : ∀ {S₁ : Scheme.{u}} (θ : S₁ ⟶ T) (a b : Fin (N + 1)), wcEszG (θ ≫ φ) a b =
      (θ.app (φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b)).hom (wcEszG φ a b) := by
    intro S₁ θ a b
    unfold wcEszG
    rw [N']
    rw [Scheme.Hom.comp_app]
    rfl
  have hsec : ∀ {S₁ : Scheme.{u}} (θ : S₁ ⟶ T), ∀ f ∈ wcGcDfSec φ e,
      (show ∀ a, Γ(S₁, (θ ≫ φ) ⁻¹ᵁ wcSgD K N a) from
        fun a => (θ.app (φ ⁻¹ᵁ wcSgD K N a)).hom (f a)) ∈ wcGcDfSec (θ ≫ φ) e := by
    intro S₁ θ f hf a b
    have h1 := congrArg (θ.app (φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b)).hom (hf a b)
    rw [map_mul, map_pow, N', N', ← hG] at h1
    exact h1

  have hU : ∀ (V : T.Opens) (i : Fin m), (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V) = O i ⊓ V := by
    intro V i
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have hUle : ∀ (V : T.Opens) (i : Fin m), (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V) ≤ V := by
    intro V i
    rw [hU]
    exact inf_le_right
  have hcovV : ∀ V : T.Opens, V ≤ iSup (fun i => (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V)) := by
    intro V x hx
    obtain ⟨i, hi⟩ := hcov x
    have hxi : x ∈ (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V) := by
      rw [hU]; exact TopologicalSpace.Opens.mem_inf.mpr ⟨hi, hx⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hxi⟩
  have hext : ∀ (V : T.Opens) (s t : Γ(T, V)),
      (∀ i, ((O i).ι.app V).hom s = ((O i).ι.app V).hom t) → s = t := by
    intro V s t h
    refine TopCat.Sheaf.eq_of_locally_eq' T.sheaf (fun i => (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V)) V
      (fun i => homOfLE (hUle V i)) (hcovV V) s t ?_
    intro i
    have := h i
    rw [Scheme.Opens.ι_app] at this
    exact this
  have hglue : ∀ (V : T.Opens) (g : ∀ i, Γ((O i).toScheme, (O i).ι ⁻¹ᵁ V)),
      ∃ s : Γ(T, V), ∀ i, ((O i).ι.app V).hom s = g i := by
    intro V g
    have hcompat : TopCat.Presheaf.IsCompatible T.sheaf.obj
        (fun i => (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V)) g := by
      intro i j
      by_cases hij : i = j
      · subst hij; rfl
      · have hbot : (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V) ⊓ (O j).ι ''ᵁ ((O j).ι ⁻¹ᵁ V) = ⊥ := by
          rw [hU, hU, eq_bot_iff]
          intro x hx
          simp only [TopologicalSpace.Opens.mem_inf] at hx
          exact absurd hx.2.1 (hdisj i j hij x hx.1.1)
        have hsub : ∀ W : T.Opens, W = ⊥ → Subsingleton Γ(T, W) := by
          rintro W rfl; infer_instance
        exact @Subsingleton.elim _ (hsub _ hbot) _ _
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' T.sheaf
      (fun i => (O i).ι ''ᵁ ((O i).ι ⁻¹ᵁ V)) V (fun i => homOfLE (hUle V i)) (hcovV V) g hcompat
    refine ⟨s, fun i => ?_⟩
    rw [Scheme.Opens.ι_app]
    exact hs i

  letI iP : ∀ a, Module K Γ(T, φ ⁻¹ᵁ wcSgD K N a) :=
    fun a => (wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a)).toModule
  letI iQ : ∀ i a, Module K Γ((O i).toScheme, ((O i).ι ≫ φ) ⁻¹ᵁ wcSgD K N a) :=
    fun i a => (wcEszScal ((O i).ι ≫ φ) (((O i).ι ≫ φ) ⁻¹ᵁ wcSgD K N a)).toModule
  obtain ⟨MP, hMP⟩ := mkSub (inst := iP) φ (fun _ _ _ => rfl)
  have hQex := fun i => mkSub (inst := iQ i) ((O i).ι ≫ φ) (fun _ _ _ => rfl)
  choose MQ hMQ using hQex
  have hP : wcGcDfRk φ e = Cardinal.toENat (Module.rank K MP) :=
    ident (inst := iP) φ (fun _ _ _ => rfl) MP hMP
  have hQ : ∀ i, wcGcDfRk ((O i).ι ≫ φ) e = Cardinal.toENat (Module.rank K (MQ i)) :=
    fun i => ident (inst := iQ i) ((O i).ι ≫ φ) (fun _ _ _ => rfl) (MQ i) (hMQ i)
  let Φ : MP →ₗ[K] (∀ i, MQ i) :=
    { toFun := fun f i => ⟨fun a => ((O i).ι.app (φ ⁻¹ᵁ wcSgD K N a)).hom (f.1 a),
        (hMQ i _).mpr (hsec (O i).ι f.1 ((hMP _).mp f.2))⟩
      map_add' := fun f g => by
        funext i
        apply Subtype.ext
        funext a
        show ((O i).ι.app (φ ⁻¹ᵁ wcSgD K N a)).hom (f.1 a + g.1 a) =
          ((O i).ι.app (φ ⁻¹ᵁ wcSgD K N a)).hom (f.1 a) +
            ((O i).ι.app (φ ⁻¹ᵁ wcSgD K N a)).hom (g.1 a)
        exact map_add _ _ _
      map_smul' := fun c f => by
        funext i
        apply Subtype.ext
        funext a
        change ((O i).ι.app (φ ⁻¹ᵁ wcSgD K N a)).hom
          (wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) c * f.1 a) = _
        rw [map_mul, ← hs (O i).ι a c]
        rfl }
  have hinj : Function.Injective Φ := by
    intro f g hfg
    apply Subtype.ext
    funext a
    apply hext
    intro i
    exact congrArg (fun F => (F i).1 a) hfg
  have hsurj : Function.Surjective Φ := by
    intro y
    have hg : ∀ a, ∃ s : Γ(T, φ ⁻¹ᵁ wcSgD K N a),
        ∀ i, ((O i).ι.app (φ ⁻¹ᵁ wcSgD K N a)).hom s = (y i).1 a :=
      fun a => hglue (φ ⁻¹ᵁ wcSgD K N a) (fun i => (y i).1 a)
    choose f hf using hg
    have hfS : f ∈ wcGcDfSec φ e := by
      intro a b
      apply hext
      intro i
      rw [map_mul, map_pow, N', N', ← hG, hf b i, hf a i]
      exact (hMQ i _).mp (y i).2 a b
    refine ⟨⟨f, (hMP f).mpr hfS⟩, ?_⟩
    funext i
    apply Subtype.ext
    funext a
    exact hf a i
  have hbij : Function.Bijective Φ := ⟨hinj, hsurj⟩
  rw [hP, LinearEquiv.rank_eq (LinearEquiv.ofBijective Φ hbij)]
  refine (hpi (fun i => ↥(MQ i))).trans ?_
  exact Finset.sum_congr rfl (fun i _ => (hQ i).symm)

theorem wcpa_dj_lr1k_ebcc_rank_iso : ∀ (K : Type u) [Field K] {T₁ T₂ : Scheme.{u}} {N : ℕ} (θ : T₁ ⟶ T₂), IsIso θ → ∀ (φ : T₂ ⟶ wcProjK K N) (e : ℕ), wcGcDfRk (θ ≫ φ) e = wcGcDfRk φ e :=
by
  intro K _ T₁ T₂ N θ hθ φ e
  have mono : ∀ {S₁ S₂ : Scheme.{u}} (θ : S₁ ⟶ S₂), (∀ U, Function.Injective (θ.app U).hom) →
      ∀ (φ : S₂ ⟶ wcProjK K N), wcGcDfRk φ e ≤ wcGcDfRk (θ ≫ φ) e := by
    intro S₁ S₂ θ hinj φ

    have N' : ∀ {U U' : S₂.Opens} (h : U' ≤ U) (x : Γ(S₂, U)),
        (θ.app U').hom ((S₂.presheaf.map (homOfLE h).op).hom x) =
          (S₁.presheaf.map (homOfLE (θ.preimage_mono h)).op).hom ((θ.app U).hom x) := by
      intro U U' h x
      exact congrArg (fun g => g.hom x) (θ.naturality (homOfLE h).op)

    have hs : ∀ (a : Fin (N + 1)) (c : K),
        wcEszScal (θ ≫ φ) ((θ ≫ φ) ⁻¹ᵁ wcSgD K N a) c =
          (θ.app (φ ⁻¹ᵁ wcSgD K N a)).hom (wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) c) := by
      intro a c
      have e1 : Scheme.Hom.appTop ((θ ≫ φ) ≫ wcProjKStr K N) =
          Scheme.Hom.appTop (φ ≫ wcProjKStr K N) ≫ θ.appTop := by
        rw [Category.assoc, Scheme.Hom.comp_appTop]
      simp only [wcEszScal, RingHom.comp_apply, e1, CommRingCat.hom_comp]
      exact (N' (U := ⊤) (U' := φ ⁻¹ᵁ wcSgD K N a) le_top _).symm

    have hG : ∀ a b : Fin (N + 1), wcEszG (θ ≫ φ) a b =
        (θ.app (φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b)).hom (wcEszG φ a b) := by
      intro a b
      unfold wcEszG
      rw [N']
      rw [Scheme.Hom.comp_app]
      rfl

    have hsec : ∀ f ∈ wcGcDfSec φ e,
        (show ∀ a, Γ(S₁, (θ ≫ φ) ⁻¹ᵁ wcSgD K N a) from
          fun a => (θ.app (φ ⁻¹ᵁ wcSgD K N a)).hom (f a)) ∈ wcGcDfSec (θ ≫ φ) e := by
      intro f hf a b
      have h1 := congrArg (θ.app (φ ⁻¹ᵁ wcSgD K N a ⊓ φ ⁻¹ᵁ wcSgD K N b)).hom (hf a b)
      rw [map_mul, map_pow, N', N', ← hG] at h1
      exact h1

    unfold wcGcDfRk
    refine iSup_le fun n => iSup_le fun v => iSup_le fun hv => ?_
    refine le_iSup_of_le n (le_iSup_of_le (fun i => ⟨_, hsec _ (v i).2⟩) (le_iSup_of_le ?_ le_rfl))
    intro c hc
    apply hv c
    intro a
    apply hinj (φ ⁻¹ᵁ wcSgD K N a)
    rw [map_sum, map_zero]
    refine Eq.trans ?_ (hc a)
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, hs]
    rfl
  have inj : ∀ {S₁ S₂ : Scheme.{u}} (θ : S₁ ⟶ S₂) [IsIso θ] (U : S₂.Opens),
      Function.Injective (θ.app U).hom :=
    fun θ _ U => (ConcreteCategory.bijective_of_isIso (θ.app U)).1
  apply le_antisymm
  · have h := mono (inv θ) (inj (inv θ)) (θ ≫ φ)
    rwa [IsIso.inv_hom_id_assoc] at h
  · exact mono θ (inj θ) φ

theorem wcpa_dj_lr1k_ebcc_cu_point_rank : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (T : Scheme.{u}) (s : T ⟶ Spec (.of κ)) [IrreducibleSpace ↥T], (∀ z : T, IsDomain (T.presheaf.stalk z)) → topologicalKrullDim ↥T ≤ 0 → ∀ (N : ℕ) (ψ : T ⟶ wcProjK κ N), IsClosedImmersion ψ → ψ ≫ wcProjKStr κ N = s → ∀ e : ℕ, wcGcDfRk ψ e = 1 :=
by
  intro κ _ _ T s _ hdom hdim N ψ hψ _ e
  classical

  have rank_transfer : ∀ (K : Type u) [Field K] (T : Scheme.{u}) {N : ℕ} (φ : T ⟶ wcProjK K N)
      (e : ℕ) (a : Fin (N + 1)) (V : Type u) [AddCommGroup V] [Module K V] (L : Submodule K V)
      [FiniteDimensional K L] (Φ : Γ(T, φ ⁻¹ᵁ wcSgD K N a) → V),
      (∀ s t, Φ (s + t) = Φ s + Φ t) →
      (∀ (c : K) s, Φ (wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) c * s) = c • Φ s) →
      (∀ f ∈ wcGcDfSec φ e, Φ (f a) ∈ L) → (∀ f ∈ wcGcDfSec φ e, Φ (f a) = 0 → ∀ b, f b = 0) →
      (∀ v ∈ L, ∃ f ∈ wcGcDfSec φ e, Φ (f a) = v) →
      wcGcDfRk φ e = (Module.finrank K L : ℕ∞) := by
    intro K _ T N φ e a V _ _ L _ Φ hadd hscal hmemL hinj hsurj
    have hR : ∀ (W W' : T.Opens) (h : W' ≤ W) (c : K),
        (T.presheaf.map (homOfLE h).op).hom (wcEszScal φ W c) = wcEszScal φ W' c := by
      intro W W' h c
      simp only [wcEszScal, RingHom.comp_apply]
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    have hclos : ∀ (n : ℕ) (c : Fin n → K)
        (v : Fin n → (∀ b : Fin (N + 1), Γ(T, φ ⁻¹ᵁ wcSgD K N b))),
        (∀ i, v i ∈ wcGcDfSec φ e) →
        (fun b => ∑ i, wcEszScal φ (φ ⁻¹ᵁ wcSgD K N b) (c i) * v i b) ∈ wcGcDfSec φ e := by
      intro n c v hv a' b'
      simp only [map_sum, map_mul, hR]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hv i a' b']
      ring
    have hsum : ∀ (n : ℕ) (x : Fin n → Γ(T, φ ⁻¹ᵁ wcSgD K N a)),
        Φ (∑ i, x i) = ∑ i, Φ (x i) := fun n x =>
      map_sum (AddMonoidHom.mk' Φ hadd) x Finset.univ
    have hΦ0 : Φ 0 = 0 := map_zero (AddMonoidHom.mk' Φ hadd)
    apply le_antisymm
    · unfold wcGcDfRk
      refine iSup_le fun n => iSup_le fun v => iSup_le fun hP => ?_
      let w : Fin n → L := fun i => ⟨Φ ((v i).1 a), hmemL (v i).1 (v i).2⟩
      have hli : LinearIndependent K w := by
        rw [Fintype.linearIndependent_iff]
        intro c hc
        have hc' : ∑ i, c i • Φ ((v i).1 a) = 0 := by
          have := congrArg Subtype.val hc
          simpa [w] using this
        apply hP c
        intro b
        have hg := hclos n c (fun i => (v i).1) (fun i => (v i).2)
        refine hinj _ hg ?_ b
        show Φ (∑ i, wcEszScal φ (φ ⁻¹ᵁ wcSgD K N a) (c i) * (v i).1 a) = 0
        rw [hsum]
        simp only [hscal]
        exact hc'
      have := hli.fintype_card_le_finrank
      rw [Fintype.card_fin] at this
      exact_mod_cast this
    · set β := Module.finBasis K L with hβ
      choose f hf hΦf using fun i => hsurj (β i : V) (β i).2
      unfold wcGcDfRk
      refine le_iSup_of_le (Module.finrank K L)
        (le_iSup_of_le (fun i => (⟨f i, hf i⟩ : wcGcDfSec φ e)) (le_iSup_of_le ?_ le_rfl))
      intro c hc
      have h0 := hc a
      dsimp only at h0
      have h1 := congrArg Φ h0
      rw [hsum, hΦ0] at h1
      simp only [hscal, hΦf] at h1
      exact Fintype.linearIndependent_iff.mp β.linearIndependent c
        (Subtype.ext (by simpa using h1))

  have residue_surj : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Y : Scheme.{u}) (p : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType p] (y : Y),
      IsClosed ({y} : Set Y) →
      Function.Surjective ((Y.evaluation ⊤ y trivial).hom.comp
        (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) := by
    intro Ω _ _ Y p _ y hy
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    set g := Y.fromSpecResidueField y ≫ p with hg
    have hψ' : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ']; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (Y.fromSpecResidueField y).appTop ≫ (Scheme.ΓSpecIso (Y.residueField y)).hom =
        Y.evaluation ⊤ y trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p.appTop ≫
        Y.evaluation ⊤ y trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ', hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hφ : (Y.evaluation ⊤ y trivial).hom.comp
        (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) =
        (Spec.preimage g).hom := by
      rw [heq]; rfl
    rw [hφ]
    letI : Algebra Ω (Y.residueField y) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
    haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
    intro s
    have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩

  have hall : ∀ x : ↥T, x = genericPoint ↥T := by
    intro x
    rw [topologicalKrullDim.eq_1, Order.krullDim_nonpos_iff_forall_isMax] at hdim
    let Zx : TopologicalSpace.IrreducibleCloseds ↥T :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Zt : TopologicalSpace.IrreducibleCloseds ↥T :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥T, isClosed_univ⟩
    have hle : Zx ≤ Zt := SetLike.coe_subset_coe.mp (fun y _ => Set.mem_univ y)
    have hge : Zt ≤ Zx := hdim Zx hle
    have hmem : genericPoint ↥T ∈ closure ({x} : Set ↥T) :=
      (SetLike.coe_subset_coe.mpr hge) (Set.mem_univ (genericPoint ↥T))
    have h1 : x ⤳ genericPoint ↥T := specializes_iff_mem_closure.mpr hmem
    have h2 : genericPoint ↥T ⤳ x := (genericPoint_spec ↥T).specializes (Set.mem_univ x)
    exact (Specializes.antisymm h1 h2).eq

