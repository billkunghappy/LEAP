    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  obtain ⟨t₀⟩ : Nonempty ↥(Spec (.of (IsLocalRing.ResidueField ↥W))) :=
    ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)⟩

  have hinc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [IsIntegralHom f] (a b : ↥A), a ⤳ b →
      f a = f b → a = b := by
    intro A B f _ a b hab hfab
    obtain ⟨U, hU, hbU, -⟩ := exists_isAffineOpen_mem_and_subset (X := B) (x := f b) (U := ⊤) trivial
    have hV : IsAffineOpen (f ⁻¹ᵁ U) := IsAffineHom.isAffine_preimage U hU
