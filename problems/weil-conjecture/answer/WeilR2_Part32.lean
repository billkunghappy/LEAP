      have h1 : Polynomial.C (↑hu.unit⁻¹ : W) * Polynomial.C (γ - α) = 1 := by
        rw [← Polynomial.C_mul, IsUnit.val_inv_mul, Polynomial.C_1]
      rw [Polynomial.C_sub] at h1
