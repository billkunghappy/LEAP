          rw [Multiset.map_cons, Multiset.prod_cons]
          exact (hlin α hα γ (hs γ (Multiset.mem_cons_self γ s))).mul_right
            (ih (fun δ hδ => hs δ (Multiset.mem_cons_of_mem hδ)))
      rw [hH]; exact key r₁ h₁
    have hGHc : IsCoprime G H := by
      have key : ∀ s : Multiset W, (∀ α ∈ s, α ∈ IsLocalRing.maximalIdeal W) →
          IsCoprime (s.map (fun α => Polynomial.X - Polynomial.C α)).prod H := by
        intro s
        induction s using Multiset.induction_on with
        | empty => intro _; simp [isCoprime_one_left]
        | cons α s ih =>
          intro hs
          rw [Multiset.map_cons, Multiset.prod_cons]
          exact (hαH α (hs α (Multiset.mem_cons_self α s))).mul_left
            (ih (fun δ hδ => hs δ (Multiset.mem_cons_of_mem hδ)))
      rw [hG]; exact key r₀ h₀
    obtain ⟨σ, ρ, hσρ⟩ := hGHc
    have hFa : Polynomial.aeval a G * Polynomial.aeval a H = 0 := by
      rw [← map_mul, hGH]; exact hF
    obtain ⟨e, he⟩ : ∃ e : T, e = Polynomial.aeval a (σ * G) := ⟨_, rfl⟩
    have h1e : 1 - e = Polynomial.aeval a (ρ * H) := by
      have := congrArg (Polynomial.aeval a) hσρ
      rw [map_add, map_one] at this
      rw [he]; linear_combination -this
    have heH : e * Polynomial.aeval a H = 0 := by
      rw [he, map_mul]
      linear_combination (Polynomial.aeval a σ) * hFa
    have hidem : IsIdempotentElem e := by
      unfold IsIdempotentElem
      have : e * (1 - e) = 0 := by
        rw [h1e, map_mul]
        linear_combination (Polynomial.aeval a ρ) * heH
      linear_combination -this
    have hh0 : IsUnit (H.coeff 0) := by
      have key : ∀ s : Multiset W, (∀ γ ∈ s, γ ∉ IsLocalRing.maximalIdeal W) →
          IsUnit ((s.map (fun α => Polynomial.X - Polynomial.C α)).prod.coeff 0) := by
        intro s
        induction s using Multiset.induction_on with
        | empty => intro _; simp
        | cons γ s ih =>
          intro hs
          rw [Multiset.map_cons, Multiset.prod_cons, Polynomial.mul_coeff_zero]
          refine IsUnit.mul ?_ (ih (fun δ hδ => hs δ (Multiset.mem_cons_of_mem hδ)))
          simpa using (hunit γ (hs γ (Multiset.mem_cons_self γ s))).neg
      rw [hH]; exact key r₁ h₁
    have hq : a * Polynomial.aeval a (-Polynomial.C ((hh0.unit⁻¹ : Wˣ) : W) * H.divX) * e = e := by
      have hHdec : Polynomial.aeval a H =
          Polynomial.aeval a H.divX * a + algebraMap W T (H.coeff 0) := by
        conv_lhs => rw [← Polynomial.divX_mul_X_add H]
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      have hu : algebraMap W T ((hh0.unit⁻¹ : Wˣ) : W) * algebraMap W T (H.coeff 0) = 1 := by
        rw [← map_mul, IsUnit.val_inv_mul, map_one]
      rw [map_mul, map_neg, Polynomial.aeval_C]
