      _ = (wcProjK Ω 1).presheaf.germ U _ hU ≫ (wcProjK Ω 1).presheaf.stalkSpecializes hgen ≫
            γ.stalkMap (genericPoint C) := by rw [happ, e1]

  let σ : {a : C ≅ C // a.hom ≫ γ = γ} →
      (C.functionField →ₐ[(wcProjK Ω 1).functionField] C.functionField) := fun a =>
    { toRingHom := wcpaDjGslTr a.1.hom (genericPoint C) (genericPoint C) (hfix a)
      commutes' := fun k => by
        have := congrArg (fun f => f.hom k) (hlin a)
        simpa [wcpaDjGslTr, RingHom.algebraMap_toAlgebra] using this }
  have hσapp : ∀ a x, σ a x = (C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
      a.1.hom.stalkMap (genericPoint C)).hom x := fun a x => rfl

  have hdom : IsDominant (C.fromSpecStalk (genericPoint C)) := by
    rw [isDominant_iff]
    have hd : Dense ({genericPoint C} : Set C) := dense_iff_closure_eq.mpr (genericPoint_spec C)
    refine hd.mono ?_
    rw [Set.singleton_subset_iff, Scheme.range_fromSpecStalk]
    exact specializes_rfl
  have hιa : ∀ a : {a : C ≅ C // a.hom ≫ γ = γ}, C.fromSpecStalk (genericPoint C) ≫ a.1.hom =
      Spec.map (C.presheaf.stalkSpecializes (specializes_of_eq (hfix a)) ≫
        a.1.hom.stalkMap (genericPoint C)) ≫ C.fromSpecStalk (genericPoint C) := by
    intro a
    rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
      Scheme.SpecMap_stalkMap_fromSpecStalk]
