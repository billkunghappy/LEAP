    intro F
    unfold wcGcDfSec
    rw [Set.mem_setOf_eq]
    intro a b
    have hXa := hXdeg a
    have hXb := hXdeg b
    have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N a := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).1
    have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N b := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).2
    have hAa : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
            (HomogeneousLocalization.Away.mk _ hXa e (F : MvPolynomial (Fin (N + 1)) K)
              (hFdeg F))) =
        ((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom (wcEszSec K N e F a) :=
      congrArg (fun ψ => ψ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXa e
        (F : MvPolynomial (Fin (N + 1)) K) (hFdeg F)))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X a) hXb (x := MvPolynomial.X a * MvPolynomial.X b) rfl)
    have hBb : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb e (F : MvPolynomial (Fin (N + 1)) K)
              (hFdeg F))) =
        ((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom (wcEszSec K N e F b) :=
      congrArg (fun ψ => ψ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXb e
        (F : MvPolynomial (Fin (N + 1)) K) (hFdeg F)))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have hEb : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa)) =
        ((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom (wcSgE K N b a) :=
      congrArg (fun ψ => ψ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hXb 1
        (MvPolynomial.X a) hXa))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))

    have c1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb e (F : MvPolynomial (Fin (N + 1)) K) (hFdeg F)) =
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa) ^ e *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
          (HomogeneousLocalization.Away.mk _ hXa e (F : MvPolynomial (Fin (N + 1)) K)
            (hFdeg F)) := by
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk,
        Localization.mk_pow, Localization.mk_mul]
      rw [Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow]
      ring
    have e0 : wcSgD K N a ⊓ wcSgD K N b ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b) :=
      (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).ge
    have kl : ∀ s : Γ(wcProjK K N, wcSgD K N a),
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op).hom s =
          ((wcProjK K N).presheaf.map (homOfLE e0).op).hom
            (((wcProjK K N).presheaf.map (homOfLE hle_a).op).hom s) := fun s =>
      congrArg (fun ψ => ψ.hom s) ((wcProjK K N).presheaf.map_comp (homOfLE hle_a).op (homOfLE e0).op)
    have kr : ∀ s : Γ(wcProjK K N, wcSgD K N b),
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom s =
          ((wcProjK K N).presheaf.map (homOfLE e0).op).hom
            (((wcProjK K N).presheaf.map (homOfLE hle_b).op).hom s) := fun s =>
      congrArg (fun ψ => ψ.hom s) ((wcProjK K N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e0).op)
    have sP : ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom (wcEszSec K N e F b) =
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N b)).op).hom (wcSgE K N b a) ^ e *
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N a ⊓ wcSgD K N b ≤
            wcSgD K N a)).op).hom (wcEszSec K N e F a) := by
      rw [kl, kr, kr, ← hAa, ← hBb, ← hEb, c1, map_mul, map_mul, map_pow, map_pow]
    have key := congrArg (φ.app (wcSgD K N a ⊓ wcSgD K N b)).hom sP
    rw [map_mul, map_pow, nat, nat, nat] at key
    exact key
  exact ⟨hA, hB, hC⟩

theorem wcpa_dj_lr1k_ll_gc_df_hs_proj_forms : ∀ (K : Type u) [Field K] (N e : ℕ)
    (f : ∀ a : Fin (N + 1), Γ(wcProjK K N, wcSgD K N a)),
    (∀ a b : Fin (N + 1),
      ((wcProjK K N).presheaf.map (homOfLE (inf_le_right :
          wcSgD K N a ⊓ wcSgD K N b ≤ wcSgD K N b)).op).hom (f b) =
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_right :
          wcSgD K N a ⊓ wcSgD K N b ≤ wcSgD K N b)).op).hom (wcSgE K N b a) ^ e *
        ((wcProjK K N).presheaf.map (homOfLE (inf_le_left :
          wcSgD K N a ⊓ wcSgD K N b ≤ wcSgD K N a)).op).hom (f a)) →
    ∃ F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e, ∀ a, f a = wcEszSec K N e F a :=
by
  intro K _ N e f hf
  classical
  letI := (MvPolynomial.gradedAlgebra :
