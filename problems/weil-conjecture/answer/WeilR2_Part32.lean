      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = y) :
    ¬ wcpaDjLkSmAt W uY w :=
by
  have s1 : ∀ (R₀ : Type u) [CommRing R₀] (c : R₀) (K : Type u) [Field K] [Algebra R₀ K]
