theorem wcpa_dj_lr1k_ebcc_chi_unique : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (T : Scheme.{u}) (s : T ⟶ Spec (.of κ)) (c₁ c₂ : ℤ), wcGcChi κ s c₁ → wcGcChi κ s c₂ → (∀ z : T, IsDomain (T.presheaf.stalk z) ∧ IsIntegrallyClosed (T.presheaf.stalk z)) → c₁ = c₂ :=
