      rw [hvi]
      ring
    refine TopCat.Sheaf.eq_of_locally_eq' X.sheaf
      (fun l => ψ ⁻¹ᵁ wcSgD K M A ⊓ b ⁻¹ᵁ wcSgD K N l) _ (fun l => homOfLE inf_le_left) ?_ _ 0 ?_
    · rw [← inf_iSup_eq, hU, inf_top_eq]
    · intro l
      have h0 : X.presheaf.map (homOfLE (hψ l)).op
