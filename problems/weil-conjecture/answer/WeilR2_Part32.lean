    have hinv : (w : Ω)⁻¹ ∈ W := by
      apply (hCC _).mp
      rw [map_inv₀]
      apply (V.valuation_le_one_iff _).mp
      rw [map_inv₀, heq, inv_one]
    exact IsUnit.of_mul_eq_one (⟨(w : Ω)⁻¹, hinv⟩ : ↥W)
      (Subtype.ext (show (w : Ω) * (w : Ω)⁻¹ = 1 from mul_inv_cancel₀ hw0))
  have hg1 : V.valuation g ≤ 1 := hle g hgV
  have hev_le : ∀ r : Polynomial ↥W, V.valuation (r.eval₂ (c.comp W.subtype) g) ≤ 1 := by
    intro r
    rw [Polynomial.eval₂_eq_sum_range]
    apply Valuation.map_sum_le
    intro i _
    rw [Valuation.map_mul, Valuation.map_pow]
    have hc : V.valuation ((c.comp W.subtype) (r.coeff i)) ≤ 1 := hle _ ((hCC _).mpr (r.coeff i).2)
    calc V.valuation ((c.comp W.subtype) (r.coeff i)) * V.valuation g ^ i
        ≤ 1 * 1 := mul_le_mul' hc (pow_le_one' hg1 i)
      _ = 1 := one_mul 1
  have hev_lt : ∀ R : Polynomial ↥W, (∀ i, R.coeff i ∈ IsLocalRing.maximalIdeal ↥W) →
      V.valuation (R.eval₂ (c.comp W.subtype) g) < 1 := by
    intro R hR
