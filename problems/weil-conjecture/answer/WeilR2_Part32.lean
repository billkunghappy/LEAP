    let P₀ := hU.primeIdealOf ⟨z₀, hz₀⟩
    let ys : Ideal ↥(integralClosure ↑Γ(X, V) ↑C.functionField) := P₀.asIdeal.comap e.symm
    have hY : ∀ r : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ V),
        ((e r : integralClosure ↑Γ(X, V) ↑C.functionField) : C.functionField) ∈
