    have hg : ∀ b, (algebraMap (HomogeneousLocalization
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))) L) (HomogeneousLocalization.Away.mk
