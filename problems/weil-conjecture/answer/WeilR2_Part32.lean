  let gD : D →ₐ[Polynomial R] TensorProduct κ (TensorProduct (Polynomial R) κ D)
      (TensorProduct R κ Q) :=
    (Algebra.TensorProduct.includeLeft : TensorProduct (Polynomial R) κ D →ₐ[Polynomial R]
      TensorProduct κ (TensorProduct (Polynomial R) κ D) (TensorProduct R κ Q)).comp
      (Algebra.TensorProduct.includeRight : D →ₐ[Polynomial R] TensorProduct (Polynomial R) κ D)
  let gQ : Q →ₐ[Polynomial R] TensorProduct κ (TensorProduct (Polynomial R) κ D)
