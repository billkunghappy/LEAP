      [Algebra R T] (x : ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R S)))
        (Spec.map (CommRingCat.ofHom (algebraMap R T))))),
      Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap R S)))
        (Spec.map (CommRingCat.ofHom (algebraMap R T))) x =
      PrimeSpectrum.comap (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := S) (B := T))
        ((pullbackSpecIso R S T).hom x) := by
    intro R S T _ _ _ _ _ x
    rw [← pullbackSpecIso_hom_fst, Scheme.Hom.comp_apply]
    rfl

  rintro ⟨U, hwU, hsm⟩
  subst hw
  have hwO : w ∈ Limits.pullback.fst uY
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ V := hy
  obtain ⟨U', hwU', hsm'⟩ := s4 _ _ _ _ U w hwO hwU hsm
  obtain ⟨h, hEt, hsnd, hpt⟩ :=
    s3 ↥W (wcNcRing W c) (IsLocalRing.ResidueField ↥W) Y uY V mN hmN hcomm
  rw [← hsnd] at hsm'
  obtain ⟨U₂, hU₂, hsm₂⟩ :=
    (wcpa_dj_nc_smooth_etale_transfer _ _ _ h _ ⟨w, hwO⟩ hEt).mpr ⟨U', hwU', hsm'⟩
  have hdom := @wcpa_smooth_stalk_isDomain (IsLocalRing.ResidueField ↥W) _ U₂.toScheme _ 1 hsm₂
    ⟨h ⟨w, hwO⟩, hU₂⟩
  have hloc := s2 _ _ (pullbackSpecIso ↥W (wcNcRing W c) (IsLocalRing.ResidueField ↥W)) U₂
    (h ⟨w, hwO⟩) hU₂ _ rfl hdom
  have hp := hpt w hwO hy
  rw [hfstP] at hp
  have h0' := (congrArg (fun P : PrimeSpectrum (wcNcRing W c) =>
    Ideal.Quotient.mk (wcNcIdeal W c) (MvPolynomial.X 0) ∈ P.asIdeal) hp).mpr h0
  have h1' := (congrArg (fun P : PrimeSpectrum (wcNcRing W c) =>
    Ideal.Quotient.mk (wcNcIdeal W c) (MvPolynomial.X 1) ∈ P.asIdeal) hp).mpr h1
  refine s1 ↥W c (IsLocalRing.ResidueField ↥W) (wcNcIdeal W c) rfl _ ?_ ?_ hloc
  · exact h0'
  · exact h1'

theorem wcpa_dj_lr1k_odfgl_normalization_affine (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (C X : Scheme.{u}) (f : C ⟶ X) [QuasiCompact f] [QuasiSeparated f]
    (uX : X ⟶ Spec (.of ↥W)) (V : X.Opens) (hV : IsAffineOpen V)
    (U' : C.Opens) (hle : U' ≤ f ⁻¹ᵁ V) (hge : f ⁻¹ᵁ V ≤ U') [Algebra ↥W Γ(C, U')]
    (hcompat : ∀ w : ↥W, algebraMap ↥W Γ(C, U') w =
      (f.appLE V U' hle).hom ((uX.appLE ⊤ V le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)))
    (R' : Subalgebra ↥W Γ(C, U'))
    (hR' : ∀ x, x ∈ R' ↔ (f.appLE V U' hle).hom.IsIntegralElem x) :
    ∃ (U₀ : (wcpaDjLkFib W f uX).Opens)
      (e₀ : U₀.toScheme ≅ Spec (.of (TensorProduct ↥W (IsLocalRing.ResidueField ↥W) ↥R'))),
      e₀.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField ↥W)
          (TensorProduct ↥W (IsLocalRing.ResidueField ↥W) ↥R'))) =
        U₀.ι ≫ Limits.pullback.snd (f.fromNormalization ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ∧
      (∀ z, z ∈ U₀ ↔ wcpaDjLkImg W f uX z ∈ V) ∧
      ∀ (z : ↥(wcpaDjLkFib W f uX)) (hz : z ∈ U₀) (a : Γ(X, V))
        (ha : (f.appLE V U' hle).hom a ∈ R'),
        (TensorProduct.tmul ↥W (1 : IsLocalRing.ResidueField ↥W) (⟨_, ha⟩ : ↥R') ∈
            (e₀.hom ⟨z, hz⟩).asIdeal ↔ wcpaDjLkImg W f uX z ∉ X.basicOpen a) :=
by
  classical

  have s2 : ∀ (R : Type u) [CommRing R] (k : Type u) [CommRing k] [Algebra R k] (Y : Scheme.{u})
      (g : Y ⟶ Spec (.of R)) (A : Type u) [CommRing A] [Algebra R A]
      (j : Spec (.of A) ⟶ Y) [IsOpenImmersion j]
      (_hj : j ≫ g = Spec.map (CommRingCat.ofHom (algebraMap R A))),
      ∃ e : ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R k)))) ⁻¹ᵁ
          j.opensRange).toScheme ≅ Spec (.of (TensorProduct R k A)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap k (TensorProduct R k A))) =
          ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R k)))) ⁻¹ᵁ
            j.opensRange).ι ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap R k))) ∧
        ∀ (z : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap R k)))))
          (hz : z ∈ (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R k)))) ⁻¹ᵁ
            j.opensRange),
          ∃ r : ↥(Spec (.of A)),
            j r = Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R k))) z ∧
            Ideal.comap (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R k A).toRingHom
              (e.hom ⟨z, hz⟩).asIdeal = r.asIdeal := by
    intro R _ k _ _ Y g A _ _ j _ hj
    set s := Spec.map (CommRingCat.ofHom (algebraMap R k)) with hs
    set O := (Limits.pullback.fst g s) ⁻¹ᵁ j.opensRange with hO
    have hrange : Set.range (Limits.pullback.snd j (Limits.pullback.fst g s)) = Set.range O.ι := by
      rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.range_ι]
    let e₁ := IsOpenImmersion.isoOfRangeEq _ _ hrange
    let e₂ := Limits.pullbackRightPullbackFstIso g s j
    let e₃ := Limits.pullback.congrHom hj (rfl : s = s)
    let e₄ := pullbackSpecIso R A k
    let cm : TensorProduct R k A ≃+* TensorProduct R A k :=
      (Algebra.TensorProduct.comm R k A).toRingEquiv
    let e₅ : Spec (.of (TensorProduct R A k)) ≅ Spec (.of (TensorProduct R k A)) :=
      asIso (Spec.map cm.toCommRingCatIso.hom)
    have h1 : e₁.inv ≫ Limits.pullback.snd j (Limits.pullback.fst g s) = O.ι :=
      IsOpenImmersion.isoOfRangeEq_inv_fac _ _ hrange
    have h2s : e₂.hom ≫ Limits.pullback.snd (j ≫ g) s =
        Limits.pullback.snd j (Limits.pullback.fst g s) ≫ Limits.pullback.snd g s :=
      Limits.pullbackRightPullbackFstIso_hom_snd g s j
    have h2f : e₂.hom ≫ Limits.pullback.fst (j ≫ g) s =
        Limits.pullback.fst j (Limits.pullback.fst g s) :=
      Limits.pullbackRightPullbackFstIso_hom_fst g s j
    have h3s : e₃.hom ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap R A))) s =
        Limits.pullback.snd (j ≫ g) s := by
      simp only [e₃, Limits.pullback.congrHom_hom, Limits.pullback.map, Limits.pullback.lift_snd,
        Category.comp_id]
    have h3f : e₃.hom ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap R A))) s =
        Limits.pullback.fst (j ≫ g) s := by
      simp only [e₃, Limits.pullback.congrHom_hom, Limits.pullback.map, Limits.pullback.lift_fst,
        Category.comp_id]
    have h4s := pullbackSpecIso_hom_snd R A k
    have h4f := pullbackSpecIso_hom_fst R A k
    have h5s : e₅.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap k (TensorProduct R k A))) =
        Spec.map (CommRingCat.ofHom
          ((Algebra.TensorProduct.includeRight : k →ₐ[R] TensorProduct R A k) :
            k →+* TensorProduct R A k)) := by
      show Spec.map cm.toCommRingCatIso.hom ≫ _ = _
      rw [← Spec.map_comp]
      congr 1
    have h5f : e₅.hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R k A).toRingHom) =
        Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct R A k)) := by
      show Spec.map cm.toCommRingCatIso.hom ≫ _ = _
      rw [← Spec.map_comp]
      congr 1
    refine ⟨e₁.symm ≪≫ e₂ ≪≫ e₃ ≪≫ e₄ ≪≫ e₅, ?_, ?_⟩
    · simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc]
      rw [h5s, h4s, h3s, h2s, ← Category.assoc, h1]
    · intro z hz
      refine ⟨Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R k A).toRingHom)
          ((e₁.symm ≪≫ e₂ ≪≫ e₃ ≪≫ e₄ ≪≫ e₅).hom ⟨z, hz⟩), ?_, rfl⟩
      have key : (e₁.symm ≪≫ e₂ ≪≫ e₃ ≪≫ e₄ ≪≫ e₅).hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R k A).toRingHom) ≫ j =
          O.ι ≫ Limits.pullback.fst g s := by
        simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc]
        rw [reassoc_of% h5f, reassoc_of% h4f, reassoc_of% h3f, reassoc_of% h2f,
          Limits.pullback.condition, ← Category.assoc, h1]
      calc _ = ((e₁.symm ≪≫ e₂ ≪≫ e₃ ≪≫ e₄ ≪≫ e₅).hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R k A).toRingHom) ≫ j)
            ⟨z, hz⟩ := rfl
        _ = (O.ι ≫ Limits.pullback.fst g s) ⟨z, hz⟩ := by rw [key]
        _ = _ := rfl

  obtain rfl : U' = f ⁻¹ᵁ V := le_antisymm hle hge
  letI algXC : Algebra Γ(X, V) Γ(C, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  have happ : f.appLE V (f ⁻¹ᵁ V) hle = f.app V := (Scheme.Hom.app_eq_appLE f).symm
  have hmem : ∀ x, x ∈ integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V) ↔ x ∈ R' := by
    intro x
    rw [hR', happ]
    exact Iff.rfl
  let ψ : ↥(integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V)) ≃+* ↥R' :=
    { toFun := fun x => ⟨x.1, (hmem x.1).1 x.2⟩
      invFun := fun y => ⟨y.1, (hmem y.1).2 y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }
  let VA : X.affineOpens := ⟨V, hV⟩
  obtain ⟨ιV, hoi, h, hr⟩ : ∃ (ιV : Spec (.of ↥(integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V))) ⟶
      f.normalization) (_ : IsOpenImmersion ιV),
      ιV ≫ f.fromNormalization =
        Spec.map (CommRingCat.ofHom
          (algebraMap Γ(X, V) ↥(integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V)))) ≫ hV.fromSpec ∧
      f.fromNormalization ⁻¹ᵁ V = ιV.opensRange :=
    ⟨f.normalizationOpenCover.f VA, f.normalizationOpenCover.map_prop VA,
      Scheme.Hom.ι_fromNormalization f VA, Scheme.Hom.fromNormalization_preimage f VA⟩
  haveI := hoi
  haveI hψiso : IsIso (Spec.map (CommRingCat.ofHom (ψ : _ →+* ↥R'))) := by
    change IsIso (Spec.map ψ.toCommRingCatIso.hom)
    infer_instance
  let j : Spec (.of ↥R') ⟶ f.normalization := Spec.map (CommRingCat.ofHom (ψ : _ →+* ↥R')) ≫ ιV
  haveI : IsOpenImmersion j := by
    dsimp only [j]
    infer_instance
  let ρ : Γ(X, V) →+* ↥R' :=
    (ψ : _ →+* ↥R').comp (algebraMap Γ(X, V) ↥(integralClosure Γ(X, V) Γ(C, f ⁻¹ᵁ V)))
  have hN2 : j.opensRange = f.fromNormalization ⁻¹ᵁ V := by
    dsimp only [j]
    rw [Scheme.Hom.opensRange_comp_of_isIso, hr]
  have hN3 : j ≫ f.fromNormalization = Spec.map (CommRingCat.ofHom ρ) ≫ hV.fromSpec := by
    dsimp only [j]
    rw [Category.assoc, h, ← Category.assoc, ← Spec.map_comp]
    rfl

  have hS : hV.fromSpec ≫ uX =
      Spec.map ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appLE ⊤ V le_top) := by
    rw [← IsAffineOpen.SpecMap_appLE_fromSpec uX (isAffineOpen_top _) hV le_top,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, Spec.map_comp]
  have hj : j ≫ (f.fromNormalization ≫ uX) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥R')) := by
    rw [← Category.assoc, hN3, Category.assoc, hS, ← Spec.map_comp]
    congr 1
    ext w
    show (f.app V).hom ((uX.appLE ⊤ V le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) =
      algebraMap ↥W Γ(C, f ⁻¹ᵁ V) w
    rw [hcompat w, happ]

  obtain ⟨e, hG1, hG2⟩ := s2 ↥W (IsLocalRing.ResidueField ↥W) f.normalization
    (f.fromNormalization ≫ uX) ↥R' j hj
  have hImg : ∀ z : ↥(wcpaDjLkFib W f uX), wcpaDjLkImg W f uX z =
      f.fromNormalization (Limits.pullback.fst (f.fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) z) := by
    intro z
    change (Limits.pullback.map _ _ _ _ _ _ _ _ _ ≫ Limits.pullback.fst uX _) z =
      (Limits.pullback.fst _ _ ≫ f.fromNormalization) z
    simp only [Limits.pullback.map, Limits.pullback.lift_fst]
  refine ⟨_, e, hG1, ?_, ?_⟩
  · intro z
    rw [Scheme.Hom.mem_preimage, hN2, Scheme.Hom.mem_preimage, hImg]
  · intro z hz a ha
    obtain ⟨r, hr1, hr2⟩ := hG2 z hz
    have hx : (⟨_, ha⟩ : ↥R') = ρ a := by
      apply Subtype.ext
      show (f.appLE V (f ⁻¹ᵁ V) hle).hom a = (f.app V).hom a
      rw [happ]
    have e1 : (TensorProduct.tmul ↥W (1 : IsLocalRing.ResidueField ↥W) (⟨_, ha⟩ : ↥R') ∈
        (e.hom ⟨z, hz⟩).asIdeal) ↔ ρ a ∈ r.asIdeal := by
      rw [← hx, ← hr2, Ideal.mem_comap]
      exact Iff.rfl
    have hp : hV.fromSpec (Spec.map (CommRingCat.ofHom ρ) r) = wcpaDjLkImg W f uX z := by
      rw [hImg, ← hr1]
      calc _ = (Spec.map (CommRingCat.ofHom ρ) ≫ hV.fromSpec) r := rfl
        _ = (j ≫ f.fromNormalization) r := by rw [hN3]
        _ = _ := rfl
    rw [e1, ← hp]
    have e3 : ρ a ∈ r.asIdeal ↔ a ∈ (Spec.map (CommRingCat.ofHom ρ) r).asIdeal := Iff.rfl
    rw [e3, ← Scheme.Hom.mem_preimage, IsAffineOpen.fromSpec_preimage_basicOpen]
    constructor
    · intro h1 h2
      exact (PrimeSpectrum.mem_basicOpen _ _).1 h2 h1
    · intro h1
      by_contra h2
      exact h1 ((PrimeSpectrum.mem_basicOpen _ _).2 h2)

theorem wcpa_dj_lr1k_ebc_otc_flat_nzd : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (T : Scheme.{u}) (u : T ⟶ Spec (.of ↥W)), Flat u → ∀ (V : T.affineOpens) (b : ↥W), b ≠ 0 → (u.appLE ⊤ V.1 (by simp)).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom b) ∈ nonZeroDivisors Γ(T, V.1) :=
by
  intro Ω _ W T u hu V b hb
  have hflat : RingHom.Flat (u.appLE ⊤ V.1 (by simp)).hom :=
    HasRingHomProperty.appLE (P := @Flat) u hu ⟨⊤, isAffineOpen_top _⟩ V (by simp)
  have hinvhom : ∀ y : ↥W,
      (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom y) = y := by
    intro y
    rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
  have hhominv : ∀ x : Γ(Spec (.of ↥W), ⊤),
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom ((Scheme.ΓSpecIso (.of ↥W)).hom.hom x) = x := by
    intro x
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
  have hb'nzd : (Scheme.ΓSpecIso (.of ↥W)).inv.hom b ∈ nonZeroDivisors Γ(Spec (.of ↥W), ⊤) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have h1 : (Scheme.ΓSpecIso (.of ↥W)).hom.hom x * b = 0 := by
      have h2 := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom hx
      rw [map_mul, map_zero, hinvhom] at h2
      exact h2
    have h3 : (Scheme.ΓSpecIso (.of ↥W)).hom.hom x = 0 := (mul_eq_zero.mp h1).resolve_right hb
    rw [← hhominv x, h3, map_zero]
  letI := (u.appLE ⊤ V.1 (by simp)).hom.toAlgebra
  haveI : Module.Flat Γ(Spec (.of ↥W), ⊤) Γ(T, V.1) := hflat
  have hreg : IsSMulRegular Γ(T, V.1) ((Scheme.ΓSpecIso (.of ↥W)).inv.hom b) :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors hb'nzd
  rw [mem_nonZeroDivisors_iff_right]
  intro y hy
  apply hreg.right_eq_zero_of_smul
  rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_comm]
  exact hy

theorem wcpa_dj_lr1k_odfgl_function_ring (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (hW : ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞)) (hWt : W ≠ ⊤)
    (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1) (hcov : wcpaDjLkCov Ω γ)
    (X₁ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (ι₁ : wcProjK Ω 1 ⟶ X₁)
    (hM : wcpaDjLkModel W u₁ ι₁) (σ₁ : Spec (.of ↥W) ⟶ X₁) (hσ₁ : σ₁ ≫ u₁ = 𝟙 _)
    (O : X₁.Opens) (hO : IsAffineOpen O) (hσO : σ₁ (IsLocalRing.closedPoint ↥W) ∈ O)
    (U' : C.Opens) (hle : U' ≤ (γ ≫ ι₁) ⁻¹ᵁ O) (hge : (γ ≫ ι₁) ⁻¹ᵁ O ≤ U')
    (c : ↥W) (hc0 : c ≠ 0) (hcm : c ∈ IsLocalRing.maximalIdeal ↥W) :
    IsDomain Γ(C, U') ∧ Function.Injective ((γ ≫ ι₁).appLE O U' hle).hom ∧
      (∀ w : ↥W, ((γ ≫ ι₁).appLE O U' hle).hom
          ((u₁.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) =
        ((γ ≫ wcProjKStr Ω 1).appLE ⊤ U' le_top).hom
          ((Scheme.ΓSpecIso (.of Ω)).inv.hom (algebraMap ↥W Ω w))) ∧
      ∀ x : Γ(C, U'), ∃ N : ℕ, ((γ ≫ ι₁).appLE O U' hle).hom.IsIntegralElem
        (((γ ≫ ι₁).appLE O U' hle).hom
          ((u₁.appLE ⊤ O le_top).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)) ^ N * x) :=
by
  classical
  unfold wcpaDjLkCov at hcov
  unfold wcpaDjLkModel at hM
  unfold wcpaDjSemistable at hM
  obtain ⟨-, hsm, hirr, hfin, V, hVd, hVet⟩ := hcov
  obtain ⟨⟨hflat, -, -⟩, -, hpb⟩ := hM

  have s8gen : ∀ (A B S : Type u) [CommRing A] [CommRing B] [CommRing S] (f : A →+* B)
      (g : B →+* S) (a : A), (letI := f.toAlgebra; IsLocalization.Away a B) → g.IsIntegral →
      ∀ x : S, ∃ N : ℕ, (g.comp f).IsIntegralElem ((g (f a)) ^ N * x) := by
    intro A B S _ _ _ f g a hloc hg x
    letI := f.toAlgebra
    letI := g.toAlgebra
    letI := (g.comp f).toAlgebra
    haveI : IsScalarTower A B S := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨⟨_, N, rfl⟩, h⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers a) (Rₘ := B) x (hg x)
    refine ⟨N, ?_⟩
    rw [Submonoid.smul_def, Algebra.smul_def] at h
    have e : algebraMap A S (a ^ N) = g (f a) ^ N := by
      rw [map_pow]; rfl
    rw [e] at h
    exact h

  have s3gen : ∀ (C P : Scheme.{u}) [IrreducibleSpace P] [AlgebraicGeometry.IsReduced P]
      (γ : C ⟶ P), (∃ V : C.Opens, (V : Set C).Nonempty ∧ Etale (V.ι ≫ γ)) →
      ∀ (U₀ : P.Opens) (U' : C.Opens) (h : U' ≤ γ ⁻¹ᵁ U₀), γ ⁻¹ᵁ U₀ ≤ U' →
      ((U₀ : Set P).Nonempty → (U' : Set C).Nonempty) ∧
        ∀ s : Γ(P, U₀), (γ.appLE U₀ U' h).hom s = 0 → s = 0 := by
    intro C P _ _ γ hV U₀ U' h h'
    obtain ⟨V, ⟨v0, hv0⟩, hVet⟩ := hV
    haveI := hVet
    have hopen : IsOpen (Set.range (V.ι ≫ γ)) := (V.ι ≫ γ).isOpenMap.isOpen_range
    have K : ∀ D : P.Opens, (D : Set P).Nonempty → D ≤ U₀ → ∃ v : C, v ∈ U' ∧ γ v ∈ D := by
      intro D hD hDU
      obtain ⟨p, ⟨v, hv⟩, hpD⟩ := nonempty_preirreducible_inter hopen D.isOpen
        ⟨_, ⟨⟨v0, hv0⟩, rfl⟩⟩ hD
      have e : (V.ι ≫ γ) v = γ (V.ι v) := Scheme.Hom.comp_apply _ _ _
      rw [e] at hv
      subst hv
      exact ⟨V.ι v, h' ((Scheme.Hom.mem_preimage _).mpr (hDU hpD)), hpD⟩
    refine ⟨fun hU => ?_, fun s hs => ?_⟩
    · obtain ⟨v, hv, -⟩ := K U₀ hU le_rfl
      exact ⟨v, hv⟩
    · by_contra hne
      have hD : (P.basicOpen s : Set P).Nonempty := by
        have : P.basicOpen s ≠ ⊥ := fun h0 => hne ((basicOpen_eq_bot_iff s).mp h0)
        exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp this
      obtain ⟨v, hvU, hvD⟩ := K _ hD (P.basicOpen_le s)
      have h0 := Scheme.basicOpen_appLE γ U' U₀ h s
      rw [hs, Scheme.basicOpen_zero] at h0
