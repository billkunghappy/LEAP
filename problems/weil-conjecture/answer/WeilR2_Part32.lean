        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) κ 1 := fun m =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ m)
    exact L2 _ (MvPolynomial.X l) (MvPolynomial.X k) (MvPolynomial.X a) (hX l) (hX k) (hX a)
  have hcyc : ∀ (W' : Zt.Opens) (a k l : Fin (N + 1)) (h : W' ≤ (ν ≫ j) ⁻¹ᵁ wcSgD κ N l)
      (h' : W' ≤ (ν ≫ j) ⁻¹ᵁ wcSgD κ N k),
      ((ν ≫ j).appLE (wcSgD κ N l) W' h).hom (wcSgE κ N l a) =
        ((ν ≫ j).appLE (wcSgD κ N l) W' h).hom (wcSgE κ N l k) *
