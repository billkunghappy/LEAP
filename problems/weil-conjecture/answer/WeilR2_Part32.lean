  obtain ⟨y, hy⟩ := wc_gcf_chl_not_in_chart κ T (j ≫ wcProjKStr κ N) hdim N j hj rfl a
  have hdeg : 1 ≤ D.sum (fun _ k => k) := by
    have hyD := hDa y hy
