    haveI : (RingHom.ker φ).IsMaximal := RingHom.ker_isMaximal_of_surjective φ hφs
    have hker : RingHom.ker (algebraMap (Polynomial A) B) ≤ RingHom.ker φ := by
      intro p hp
      rw [RingHom.mem_ker] at hp ⊢
      have hp' : Polynomial.aeval θ p = 0 := hp
      obtain ⟨q, rfl⟩ := minpoly.isIntegrallyClosed_dvd hθint hp'
      rw [map_mul]
      have hφP : φ P = 0 := by
        show P.eval₂ (Ideal.Quotient.mk m) (Ideal.Quotient.mk m a0) = 0
        rw [Polynomial.eval₂_hom, Ideal.Quotient.eq_zero_iff_mem]; exact ha0
      rw [hφP, zero_mul]
    obtain ⟨Q, hQmax, hQ⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral (RingHom.ker φ) hker
    have hQ' : Q.comap (algebraMap (Polynomial A) B) = RingHom.ker φ := hQ
