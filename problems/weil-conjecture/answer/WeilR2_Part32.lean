  by_contra hA

  have sdh : ∀ (m : ℕ) (P : MvPolynomial (Fin (N + 1)) K)
      (hP : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (m • 1)),
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
