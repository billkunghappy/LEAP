      (wcIntSheaf (wcP1Over F'').left ℓ) 1, y = 0 :=
    wc_proet_int_ext_vanish_of_zmod_deg (wcP1Over F'').left ℓ (wcPunctGeom F'' u0 hP) 0 s6

  obtain ⟨hcq, hqs⟩ := wc_punct_geom_qcqs F'' u0 hP
  haveI := hcq
  haveI := hqs
  have hLad : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctGeom F'' u0 hP))
      (wcLadicSheaf (wcP1Over F'').left ℓ) 1, x = 0 := by
