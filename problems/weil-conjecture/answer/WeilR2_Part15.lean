    ((((wcEtPush (Limits.pullback.snd D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom)).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex).homology q) 2
  haveI hfinPro := @Finite.of_equiv _ _ hfinEt E3.symm
  obtain ⟨e⟩ := @wc_proet_rightDerived_push_epsInv (AlgebraicClosure F'') _
