    have h3 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out : ℓ.Prime)).mp h2
    have h4 : ringChar F'' ∣ Fintype.card F'' :=
      (ringChar.spec F'' _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [← h3, Nat.card_eq_fintype_card]
    exact h4

  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  have hZ : ∀ q, 2 * (n - 1) < q →
      Limits.IsZero (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])) := by
    intro q hq
