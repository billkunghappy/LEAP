      ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).map θ)).mp ?_
    let ρ : Φ ⋙ (evaluation _ AddCommGrpCat.{u+1}).obj j ≅
        sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⋙
          (evaluation (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op j.unop.obj.right) :=
      NatIso.ofComponents (fun _ => Iso.refl _) (by
        intro X Y f
        simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
        rfl)
    exact L5 _ _ (Functor.mapHomologicalComplexCompIso ρ (ComplexShape.up ℕ))
      (hV j.unop.obj.right j.unop.property)
  haveI := hpt
  haveI : IsIso (HomologicalComplex.homologyMap
      ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).map θ) p) := NatIso.isIso_of_isIso_app _
  infer_instance

theorem wc_qm_open_push_compare_stalk_iso : ∀ (Z : Scheme.{u}) (O U W : Z.Opens) (hWO : W ≤ O) (hWU : W ≤ U) (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (O : Scheme.{u})) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (W : Scheme.{u})) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), ∃ ψ : ((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex ⟶ ((wcEtPush U.ι).mapHomologicalComplex (ComplexShape.up ℕ)).obj (((wcEtPush (Z.homOfLE hWU)).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex), ∀ y : Z, (∃ N : Z.Opens, y ∈ N ∧ N ⊓ O = N ⊓ W) → ∀ p : ℕ, IsIso ((wcEtStalk Z y).map (HomologicalComplex.homologyMap ψ p)) :=
by
  intro Z O U W hWO hWU m I J
  classical

