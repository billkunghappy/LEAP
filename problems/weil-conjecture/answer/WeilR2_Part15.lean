    exact ⟨(((((wcEtPush j).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).sc q).mapHomologyIso S).symm ≪≫
      HomologicalComplex.homologyMapIso e q ≪≫ (K.sc q).mapHomologyIso T⟩
