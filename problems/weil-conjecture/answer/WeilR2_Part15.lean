        ((θ.hom.hom.app (Opposite.op (Over.mk (f' ≫ h')))).hom
        ((G.obj.map (𝟙 V').op).hom ((G.obj.map (f' ≫ h).op).hom x))).down) w) i‖ ≤ 1 :=
      hx V' (f' ≫ h) hf' V' (𝟙 V') (f' ≫ h') w i
    have e1 : (G.obj.map (𝟙 V').op).hom ((G.obj.map (f' ≫ h).op).hom x) =
        (G.obj.map f'.op).hom ((G.obj.map h.op).hom x) := by
      rw [op_id, G.obj.map_id, op_comp, G.obj.map_comp]
      rfl
    have hnat : (θ.hom.hom.app (Opposite.op (Over.mk (f' ≫ h')))).hom
          ((G.obj.map f'.op).hom ((G.obj.map h.op).hom x)) =
        (((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.map
          (Over.homMk f' : Over.mk (f' ≫ h') ⟶ Over.mk h').op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x)) := by
      have := θ.hom.hom.naturality (Over.homMk f' : Over.mk (f' ≫ h') ⟶ Over.mk h').op
      exact congrArg (fun φ => φ.hom ((G.obj.map h.op).hom x)) this
    rw [e1, hnat] at h1
    rw [← hw]
    exact h1
  let Q : ∀ T : S.ProEt, AddSubgroup (G.obj.obj (Opposite.op T)) := fun T =>
    { carrier := {x | Cond T x}
      zero_mem' := by
        intro V h h' z i
        have e1 : (G.obj.map h.op).hom 0 = 0 := map_zero _
        have e : (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom 0) = 0 :=
          (congrArg (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom e1).trans (map_zero _)
        show ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          ((G.obj.map h.op).hom 0)).down) z) i‖ ≤ 1
        rw [e]
        exact lat0 V h' z i
      add_mem' := by
        intro a b ha hb V h h' z i
        have e1 : (G.obj.map h.op).hom (a + b) =
            (G.obj.map h.op).hom a + (G.obj.map h.op).hom b := map_add _ _ _
        have e2 : (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              ((G.obj.map h.op).hom a + (G.obj.map h.op).hom b) =
            (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom a) +
              (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom b) :=
          map_add _ _ _
        show ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          ((G.obj.map h.op).hom (a + b))).down) z) i‖ ≤ 1
        rw [e1, e2]
