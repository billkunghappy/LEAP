    apply hξ
    have hle : IsLocalRing.maximalIdeal A ≤ (ξ (IsLocalRing.closedPoint Ω)).asIdeal := by
      rw [hπ, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, hker]
      exact h0
    have hge : (ξ (IsLocalRing.closedPoint Ω)).asIdeal ≤ IsLocalRing.maximalIdeal A :=
      IsLocalRing.le_maximalIdeal (ξ (IsLocalRing.closedPoint Ω)).isPrime.ne_top
    exact PrimeSpectrum.ext (le_antisymm hge hle)

  have hconn_of : ∀ (Y : Scheme.{u}), Nat.card (wcEtCoh Y ℓ 0) = ℓ → ConnectedSpace Y := by
    intro Y hcard0
    haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
    let T₀ : Y.Etale := Scheme.Etale.mk (𝟙 Y)
    have hT : Limits.IsTerminal T₀ :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv Y T₀ hT
    obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant Y ℓ
      (fun V S hS x hx => wc_et_locallyConstant_glue Y V S hS ℓ x hx)
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    let E₁ : wcEtCoh Y ℓ 0 ≃ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) :=
      (Abelian.Ext.addEquiv₀).toEquiv
    let E : wcEtCoh Y ℓ 0 ≃ LocallyConstant Y (ZMod ℓ) := E₁.trans ((ε _).trans (e T₀).toEquiv)
    have hcard : Nat.card (LocallyConstant Y (ZMod ℓ)) = ℓ := (Nat.card_congr E).symm.trans hcard0
    have h2 : 2 ≤ ℓ := hℓ.two_le
    haveI hfin : Finite (LocallyConstant Y (ZMod ℓ)) := Nat.finite_of_card_ne_zero (by omega)
    have hne : Nonempty Y := by
      by_contra hY0
      rw [not_nonempty_iff] at hY0
      have hsub : Subsingleton (LocallyConstant Y (ZMod ℓ)) :=
        ⟨fun f g => LocallyConstant.ext (fun y => (IsEmpty.false y).elim)⟩
      have := Finite.card_le_one_iff_subsingleton.mpr hsub
      omega
    have hpre : PreconnectedSpace Y := by
      rw [preconnectedSpace_iff_clopen]
      intro U hU
      by_contra hne'
      push_neg at hne'
      obtain ⟨hU0, hU1⟩ := hne'
      obtain ⟨u, hu⟩ := hU0
      obtain ⟨v, hv⟩ : ∃ v, v ∉ U := by
        by_contra h
        push_neg at h
        exact hU1 (Set.eq_univ_of_forall h)
      let g := LocallyConstant.charFn (ZMod ℓ) hU
      let f : ZMod ℓ × ZMod ℓ → LocallyConstant Y (ZMod ℓ) :=
        fun p => p.1 • g + LocallyConstant.const Y p.2
      have ev : ∀ p : ZMod ℓ × ZMod ℓ, f p v = p.2 ∧ f p u = p.1 + p.2 := by
        intro p
        simp [f, g, LocallyConstant.coe_charFn, Set.indicator_of_mem hu, hv]
      have hf : Function.Injective f := by
        intro p q hpq
        have hv' : f p v = f q v := by rw [hpq]
        have hu' : f p u = f q u := by rw [hpq]
        rw [(ev p).1, (ev q).1] at hv'
        rw [(ev p).2, (ev q).2, hv'] at hu'
        exact Prod.ext (add_right_cancel hu') hv'
      have hle := Nat.card_le_card_of_injective f hf
      rw [Nat.card_prod, Nat.card_zmod, hcard] at hle
      nlinarith
    exact { toPreconnectedSpace := hpre, toNonempty := hne }

  have hC := wc_quadric_model_milnor_generic_fibre_coh_equiv A ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX
    hx₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀ Ω ξ hξ

  obtain ⟨θ⟩ := wc_quadric_model_generic_fibre_hyperbolic_iso A n hn hn2 π c hc Ω ξ hπ0

  obtain ⟨h0, hvan⟩ := wc_hyperbolic_affine_quadric_low_vanishing Ω ℓ hℓ hℓΩ n hn hn2
  have K : ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) ℓ q ≃
      wcEtCoh (Spec (.of (wcQuadModelRing Ω n 1 (Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)))) ℓ q) := by
    intro q
    obtain ⟨G⟩ := hC q
    obtain ⟨F⟩ := wc_et_coh_iso_invariance θ.hom ℓ q
    exact ⟨G.trans F.symm⟩
  refine ⟨?_, ?_⟩
  · obtain ⟨K0⟩ := K 0
    exact hconn_of _ ((Nat.card_congr K0).trans h0)
  · intro q hq1 hq2
    obtain ⟨Kq⟩ := K q
    haveI := hvan q hq1 hq2
    exact Kq.subsingleton

theorem wc_pencil_odp_shens_milnor_fibre_low : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), Even n → 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ Nat.card F'' → ∀ (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left), wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a → ∀ (x : ↥(Limits.pullback D.f a)), Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'') → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x)) (Scheme.Etale.forget (Limits.pullback D.f a))) (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a), wcHalShData x B Λ' W'' φ' a' → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → Nat.card (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) 0) = ℓ ^ k ∧ ∀ q : ℕ, 1 ≤ q → q + 2 ≤ n → Subsingleton (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) q) :=
by
  intro F' F'' _ _ _ _ Y n hn hn2 D ℓ hℓ hℓF k i A _ _ _ Λ _ _ W' φ a hA x hx B _ _ _ Λ' _ _ W''
    φ' a' hB Ω _ _ ξ hξ
  classical

  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      (hℓ.eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓF
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ : ℕ) : F'')) := isUnit_iff_ne_zero.mpr hℓK
  have hunitℓ : IsUnit (((ℓ : ℕ) : A)) := by
    have h1 := hunitK.map (Spec.preimage (a ≫ (wcP1Over F'').hom)).hom
    rwa [map_natCast] at h1

  obtain ⟨hdom, hdvr, π, c, hπ, hc, x₀, hX, hx₀, B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, hB₀, θ, hθ⟩ :=
    wc_pencil_odp_shens_morse_model F' F'' Y n hn hn2 D i A Λ W' φ a hA x hx B Λ' W'' φ' a' hB
  haveI := hdom
  haveI := hdvr

  obtain ⟨hconn, hvan⟩ := wc_quadric_model_shens_milnor_fibre_low A ℓ hℓ hunitℓ n hn hn2 π c hπ hc
    x₀ hX hx₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀ Ω ξ hξ

  have h1 : (a' ≫ Limits.pullback.snd D.f a) ≫ 𝟙 _ = θ.hom ≫ (a₀ ≫ wcQuadModelStr A n π c) := by
    rw [Category.comp_id, hθ]
  have h2 : ξ ≫ 𝟙 _ = 𝟙 _ ≫ ξ := by simp
  let ψ := Limits.pullback.map (a' ≫ Limits.pullback.snd D.f a) ξ (a₀ ≫ wcQuadModelStr A n π c) ξ
    θ.hom (𝟙 _) (𝟙 _) h1 h2
  haveI : IsIso ψ := by
    first
    | exact inferInstance
    | exact Limits.pullback_map_isIso _ _ _ _ _ _ _ _ _

  haveI := hconn
  have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero _ hℓ.ne_zero
  refine ⟨?_, ?_⟩
  · obtain ⟨e0⟩ := wc_et_coh_iso_invariance ψ (ℓ ^ k) 0
    exact (Nat.card_congr e0).symm.trans (wc_et_coh_zero_connected_card _ (ℓ ^ k) hm0)

  · have hdev : ∀ (T : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh T ℓ q) →
        ∀ k : ℕ, Subsingleton (wcEtCoh T (ℓ ^ k) q) := by
      intro T q hq
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _

      have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
          (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})),
          S.ShortExact → Subsingleton (Abelian.Ext X S.X₁ q) →
          Subsingleton (Abelian.Ext X S.X₃ q) → Subsingleton (Abelian.Ext X S.X₂ q) := by
        intro X S hS h1 h3
        let ψ' : Abelian.Ext X S.X₂ q →+ Abelian.Ext X S.X₃ q :=
          (Abelian.Ext.mk₀ S.g).postcomp X (add_zero q)
        let φ'' : Abelian.Ext X S.X₁ q →+ Abelian.Ext X S.X₂ q :=
          (Abelian.Ext.mk₀ S.f).postcomp X (add_zero q)
        have hex : ∀ b, ψ' b = 0 → ∃ a, φ'' a = b := fun b hb =>
          Abelian.Ext.covariant_sequence_exact₂ X hS b hb
        have hz : ∀ b : Abelian.Ext X S.X₂ q, b = 0 := by
          intro b
          obtain ⟨a, ha⟩ := hex b (Subsingleton.elim _ _)
          rw [← ha, Subsingleton.elim a 0, map_zero]
        exact ⟨fun a b => by rw [hz a, hz b]⟩

      have hzero : ∀ (X Z : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}),
          Limits.IsZero Z → Subsingleton (Abelian.Ext X Z q) := by
        intro X Z hZ
        have hx : ∀ x : Abelian.Ext X Z q, x = 0 := by
          intro x
          have := Abelian.Ext.comp_mk₀_id x
          rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
          exact this.symm
        exact ⟨fun x y => by rw [hx x, hx y]⟩

      have hses : ∀ (p k : ℕ), p ≠ 0 →
          ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶
              AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
            (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶
              AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
            (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
        intro p k hp
        have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
          rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
            ZMod.natCast_self]
        let α : ZMod k →+ ZMod (p * k) :=
          ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
        have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
          intro z
          show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩)
            (z : ZMod k) = _
          rw [ZMod.lift_coe]
          change z • (p : ZMod (p * k)) = _
          rw [zsmul_eq_mul]
          push_cast
          ring
        let β : ZMod (p * k) →+ ZMod p :=
          (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
        have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
          map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
        have hαinj : Function.Injective α := by
          rw [injective_iff_map_eq_zero]
          intro x hx
          obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
          rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
          rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
          have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
          push_cast at hx
          rw [mul_comm z] at hx
          exact (mul_dvd_mul_iff_left hp').mp hx
        have hβsurj : Function.Surjective β := by
          intro y
          obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
          exact ⟨(z : ZMod (p * k)), hβ z⟩
        have hβα : ∀ x, β (α x) = 0 := by
          intro x
          obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
          rw [hα, hβ]
          push_cast
          rw [ZMod.natCast_self, mul_zero]
        have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
          intro y hy
          obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
          rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
          obtain ⟨t, rfl⟩ := hy
          refine ⟨(t : ZMod k), ?_⟩
          rw [hα]
          congr 1
          ring
        let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶
            AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
          AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
            AddEquiv.ulift.toAddMonoidHom)
        let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶
            AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
          AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
            AddEquiv.ulift.toAddMonoidHom)
        have hw : f ≫ g = 0 := by
          ext x
          exact hβα x.down
        refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
        · rw [ShortComplex.ab_exact_iff]
          intro x₂ hx₂
          obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
          exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
        · rw [AddCommGrpCat.mono_iff_injective]
          intro a b hab
          exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
        · rw [AddCommGrpCat.epi_iff_surjective]
          intro y
          obtain ⟨x, hx⟩ := hβsurj y.down
          exact ⟨ULift.up x, congrArg ULift.up hx⟩

      haveI : Limits.PreservesFiniteLimits
          (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
        Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale T)ᵒᵖ)
          (presheafToSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
      intro k
      induction k with
      | zero =>
        rw [pow_zero]
        have hz : Limits.IsZero ((constantSheaf (Scheme.smallEtaleTopology T)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod 1)))) :=
          Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)
        exact hzero _ _ hz
      | succ k IH =>
        rw [pow_succ']
        obtain ⟨f, g, hw, hS₀⟩ := hses ℓ (ℓ ^ k) hℓ.ne_zero
        have hS := hS₀.map_of_exact
          (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
        exact hmid _ _ hS IH hq
    intro q hq1 hq2
    obtain ⟨eq⟩ := wc_et_coh_iso_invariance ψ (ℓ ^ k) q
    haveI := hdev _ q (hvan q hq1 hq2) k
    exact eq.symm.subsingleton

theorem wc_pencil_odp_shens_pull_injective (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hξ : ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A)
    (D' : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) :
    Function.Injective (wcEtPull D' (n - 1)) :=
by
  classical

  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    exact IsProper.of_comp D.f (wcP1Over F'').hom
