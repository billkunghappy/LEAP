    have hstep : ∀ (U1 U2 W : Z.Opens), W ≤ U1 ⊔ U2 →
        (∀ W' : Z.Opens, W' ≤ U1 → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W') ℓ), Function.Bijective (wcEtPull D j)) →
        (∀ W' : Z.Opens, W' ≤ U2 → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W') ℓ), Function.Bijective (wcEtPull D j)) →
        ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W) ℓ), Function.Bijective (wcEtPull D j) := by
