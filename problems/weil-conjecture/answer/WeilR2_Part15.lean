theorem wc_strict_nbhd_punct_excision (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V₀ : (wcP1Over F'').left.ProEt) (g₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom u0) :
    ∃ κ : Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
          (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) ⟶
        Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' u0 hP)),
      IsIso κ ∧
      Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
          (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' u0) V₀)) ≫ κ =
        wcFreeSheafMap (wcP1Over F'').left g₀ ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' u0 hP)) :=
by
  classical

  have hs3 : ∀ (L : Type u) [Field L] (c : Spec (.of L) ⟶ Spec (.of F'')) (X : Scheme.{u})
      (π : X ⟶ Spec (.of F'')) (s : Spec (.of F'') ⟶ X), s ≫ π = 𝟙 _ →
      ∃ w : Spec (.of L) ⟶ Limits.pullback π c,
        w ≫ Limits.pullback.snd π c = 𝟙 _ ∧
        IsPullback c w s (Limits.pullback.fst π c) ∧
        ∀ y : ↥(Limits.pullback π c),
          Limits.pullback.fst π c y ∈ closure {s (IsLocalRing.closedPoint F'')} ↔
            y = w (IsLocalRing.closedPoint L) := by
    intro L _ c X π s hs
    have hw : (c ≫ s) ≫ π = 𝟙 _ ≫ c := by
      rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
    refine ⟨Limits.pullback.lift (c ≫ s) (𝟙 _) hw, Limits.pullback.lift_snd _ _ _, ?_⟩
    have hpb : IsPullback c (Limits.pullback.lift (c ≫ s) (𝟙 _) hw) s
        (Limits.pullback.fst π c) := by
      refine IsPullback.of_bot ?_ (Limits.pullback.lift_fst _ _ _).symm
        (IsPullback.of_hasPullback π c)
      rw [Limits.pullback.lift_snd, hs]
      exact IsPullback.id_vert c
    refine ⟨hpb, ?_⟩
    haveI : IsClosedImmersion s := isClosedImmersion_of_comp_eq_id π s hs
    have hrange : Set.range s = {s (IsLocalRing.closedPoint F'')} := by
      ext z
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        exact Set.mem_singleton _
      · intro hz
        rw [Set.mem_singleton_iff.mp hz]
        exact ⟨_, rfl⟩
    have hclosed : IsClosed ({s (IsLocalRing.closedPoint F'')} : Set X) := by
      rw [← hrange]; exact s.isClosedEmbedding.isClosed_range
    rw [hclosed.closure_eq]
    intro y
    constructor
    · intro hy
      obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback (f := s)
        (g := Limits.pullback.fst π c) (IsLocalRing.closedPoint F'') y
        (Set.mem_singleton_iff.mp hy).symm
      have h2 : hpb.isoPullback.hom (hpb.isoPullback.inv z) = z := by
        rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
        first
          | rfl
          | simp
      rw [← hz, ← h2, ← Scheme.Hom.comp_apply hpb.isoPullback.hom
        (Limits.pullback.snd s (Limits.pullback.fst π c)), IsPullback.isoPullback_hom_snd hpb,
        Subsingleton.elim (hpb.isoPullback.inv z) (IsLocalRing.closedPoint L)]
    · rintro rfl
      apply Set.mem_singleton_iff.mpr
      have h1 := congrArg (fun φ : Spec (.of L) ⟶ X => φ (IsLocalRing.closedPoint L))
        (Limits.pullback.lift_fst (c ≫ s) (𝟙 _) hw)
      have h2 : c (IsLocalRing.closedPoint L) = IsLocalRing.closedPoint F'' :=
        Subsingleton.elim _ _
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans
        (h1.trans ((Scheme.Hom.comp_apply _ _ _).trans (congrArg s h2)))

