    have h3 : (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ u0)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) =
        u0 (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))
