  obtain ⟨xb, hxb⟩ : ∃ xb : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      xb = ub (IsLocalRing.closedPoint (AlgebraicClosure F'')) := ⟨_, rfl⟩
  haveI hci1 : IsClosedImmersion (ub ≫ Limits.pullback.snd (wcP1Over F'').hom
