theorem wc_et_module_hom_unit_eq_zero_of_closed_stalks : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) [IsProper f] (m : ℕ), 0 < m → ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y m)) (s : SheafOfModules.unit (wcEtZModRing Y m) ⟶ M), (∀ y : Y, f y = IsLocalRing.closedPoint A → (wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y m)).map s) = 0) → s = 0 :=
