    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc
