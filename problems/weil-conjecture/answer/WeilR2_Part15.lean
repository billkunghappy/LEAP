  exact ⟨h3.coconePointUniqueUpToIso h2'⟩

theorem wc_pencil_Rq_connected_trivialization_all_q (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (q : ℕ) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ),
      QuasiCompact w.left ∧ ConnectedSpace W.left ∧
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      Nonempty ((wcRq D.f ℓ q).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W) :=
by
  classical

  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP

  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance

  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors

  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht⟩ :=
    wc_fet_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance

  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial

  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q').obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have h := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩

  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres q
  have hQ := wc_proet_Rq_rat_const_of_int_const D.f ℓ W hW₀cpt hW₀qs q a b e hZ

  refine ⟨W, w, a, ?_, hW₀conn, ?_, hQ⟩
  · show QuasiCompact (p ≫ Ub.ι)
    infer_instance
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]

theorem wc_kss_frame_change (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ W : S.ProEt) (w : W ⟶ B₀)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))
    (hU : ∀ (V₀ : S.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ W)
      (x : G.obj.obj (Opposite.op V₀)),
      (∀ z : V₀.left, wcContEval S V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V₀.left, wcContEval S V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U)
    (hfix : ∀ (V₀ : S.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ W)
      (x : G.obj.obj (Opposite.op V₀)),
      (∀ z : V₀.left, wcContEval S V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V₀.left,
        wcContEval S V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval S V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) :
    (∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U) ∧
    (∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
        wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) :=
by
  classical

  have hS3 : ∀ (V V' : S.ProEt) (k : V' ⟶ V) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V))
      (z' : V'.left),
      wcContEval S V' ((θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h')))).hom
          ((G.obj.map k.op).hom y)) z' =
        wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) (k.left z') := by
    intro V V' k h' y z'
    have e : (θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h')))).hom ((G.obj.map k.op).hom y) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map k.op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) :=
      congrArg (fun φ => φ.hom y)
        (θ.hom.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)
    rw [e]
    rfl

  have hconn : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
    intro R _
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨IsLocalRing.closedPoint R⟩, fun s hs => ?_⟩
    by_cases hc : (IsLocalRing.closedPoint R : ↥(Spec R)) ∈ s
    · right
      exact Set.eq_univ_of_forall fun y =>
        (IsLocalRing.specializes_closedPoint (R := R) y).mem_open hs.isOpen hc
    · left
      exact Set.eq_empty_iff_forall_notMem.mpr fun y hy =>
        ((IsLocalRing.specializes_closedPoint (R := R) y).mem_open
          (isOpen_compl_iff.mpr hs.isClosed) hc) hy


  have hWE : ∀ (X : Scheme.{u}) (x : X), WeaklyEtale (X.fromSpecStalk x) := by
    have hLoc : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (M : Submonoid A)
        [IsLocalization M L], Algebra.WeaklyEtale A L := by
      intro A L _ _ _ M _
      haveI hc : TensorProduct.CompatibleSMul A L L L :=
        IsLocalization.tensorProduct_compatibleSMul M L L L
      have key : ∀ z : TensorProduct A L L,
          z = (Algebra.TensorProduct.lmul' A (S := L) z) ⊗ₜ[A] (1 : L) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rw [map_zero, TensorProduct.zero_tmul]
        | tmul a b =>
          rw [Algebra.TensorProduct.lmul'_apply_tmul]
          have h := TensorProduct.smul_tmul (R := A) b a (1 : L)
          rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm b a] at h
          exact h.symm
        | add x y hx hy =>
          rw [map_add, TensorProduct.add_tmul, ← hx, ← hy]
      have hbij : Function.Bijective (Algebra.TensorProduct.lmul' A (S := L)) := by
        refine ⟨fun z₁ z₂ h => ?_, fun c => ⟨c ⊗ₜ[A] (1 : L), ?_⟩⟩
        · rw [key z₁, key z₂, h]
        · rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
      exact Algebra.WeaklyEtale.mk (IsLocalization.flat L M)
        (RingHom.Flat.of_bijective (f := (Algebra.TensorProduct.lmul' A (S := L)).toRingHom) hbij)
    have hSpec : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Algebra.WeaklyEtale R S →
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
      intro R S _ _ _ hwe
      haveI := hwe
      have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat)]
        exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := R) (S := S))
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R S)))) := by
        rw [diagonal_SpecMap]
        haveI : Flat (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) :=
          HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' R S)
        infer_instance
      exact WeaklyEtale.mk hf hd
    intro X x
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
    rw [← hW.fromSpecStalk_eq_fromSpecStalk hxW, IsAffineOpen.fromSpecStalk.eq_1]
    letI : Algebra Γ(X, W) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : W)
    haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) (hW.primeIdealOf ⟨x, hxW⟩).asIdeal :=
      hW.isLocalization_stalk ⟨x, hxW⟩
    have h5 : Algebra.WeaklyEtale Γ(X, W) (X.presheaf.stalk x) :=
      hLoc Γ(X, W) (X.presheaf.stalk x) (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
    have h6 : WeaklyEtale (Spec.map (X.presheaf.germ W x hxW)) :=
      hSpec _ _ h5
    haveI : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    exact MorphismProperty.comp_mem @WeaklyEtale _ _ h6 inferInstance

  have key : ∀ (V : S.ProEt) (z : V.left), ∃ (Vz : S.ProEt) (k : Vz ⟶ V) (z₀ : Vz.left),
      ConnectedSpace Vz.left ∧ k.left z₀ = z := by
    intro V z
    haveI := hWE V.left z
    haveI : WeaklyEtale V.hom := V.prop
    refine ⟨Scheme.ProEt.mk (V.left.fromSpecStalk z ≫ V.hom),
      MorphismProperty.Over.homMk (A := Scheme.ProEt.mk (V.left.fromSpecStalk z ≫ V.hom)) (B := V)
        (V.left.fromSpecStalk z) rfl trivial,
      IsLocalRing.closedPoint (V.left.presheaf.stalk z), hconn _, ?_⟩
    exact Scheme.fromSpecStalk_closedPoint
  refine ⟨?_, ?_⟩
  · intro V h₁ h₂ x hx z
    obtain ⟨Vz, k, z₀, hVz, hz⟩ := key V z
    have := hU Vz hVz (k ≫ h₁) (k ≫ h₂) ((G.obj.map k.op).hom x)
      (fun z' => by rw [hS3]; exact hx _) z₀
    rw [hS3, hz] at this
    exact this
  · intro V h₁ h₂ x hx hw z
    obtain ⟨Vz, k, z₀, hVz, hz⟩ := key V z
    have := hfix Vz hVz (k ≫ h₁) (k ≫ h₂) ((G.obj.map k.op).hom x)
      (fun z' => by rw [hS3]; exact hx _) (by rw [Category.assoc, Category.assoc, hw]) z₀
    rw [hS3, hS3, hz] at this
    exact this

theorem wc_kss_descend_section (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ W : S.ProEt) (w : W ⟶ B₀) (hqc : QuasiCompact w.left)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))
    (hfix' : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
        wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z)
    (T : S.ProEt) (g : T ⟶ B₀) (hlift : ∀ z : T.left, ∃ p : W.left, w.left p = g.left z)
    (f : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op T))
    (hf : ∀ z : T.left, wcContEval S T f z ∈ U) :
    ∃ x : G.obj.obj (Opposite.op T), ∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
      (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map h.op).hom f :=
by
  classical
  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      {A B C : S.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hCext : ∀ (V : S.ProEt)
      (f₁ f₂ : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval S V f₁ z = wcContEval S V f₂ z) → f₁ = f₂ := by
    intro V f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin N → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin N → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ (V : S.ProEt) (_ : V ⟶ W),
      G.obj.obj (Opposite.op V) →+ (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V),
      ∀ V h' y, Θ V h' y = (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y :=
    ⟨fun V h' => (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom, fun _ _ _ => rfl⟩
  have hN : ∀ (V V' : S.ProEt) (k : V' ⟶ V) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V)),
      Θ V' (k ≫ h') ((G.obj.map k.op).hom y) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map k.op).hom (Θ V h' y) := by
    intro V V' k h' y
    rw [hΘ, hΘ]
    exact congrArg (fun φ => φ.hom y)
      (θ.hom.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)
  have hI : ∀ (V : S.ProEt) (h' : V ⟶ W) (a b : G.obj.obj (Opposite.op V)),
      Θ V h' a = Θ V h' b → a = b := by
    intro V h' a b hab
    rw [hΘ, hΘ] at hab
    have ha : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom a) = a :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom a) θ.hom_inv_id
    have hb : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom b) = b :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom b) θ.hom_inv_id
    rw [← ha, ← hb, hab]
  have hR : ∀ (V : S.ProEt) (h' : V ⟶ W)
      (y : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      ∃ x₀ : G.obj.obj (Opposite.op V), Θ V h' x₀ = y := by
    intro V h' y
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk h'))).hom y, ?_⟩
    exact (hΘ V h' _).trans
      (congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom y) θ.inv_hom_id)
  have hfixΘ : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V (Θ V h₁ x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
        wcContEval S V (Θ V h₂ x) z = wcContEval S V (Θ V h₁ x) z := by
    intro V h₁ h₂ x h1 h2 z
    rw [hΘ, hΘ]
    exact hfix' V h₁ h₂ x (fun z => by rw [← hΘ]; exact h1 z) h2 z

  have bc : ∀ (B W' : S.ProEt) (w' : W' ⟶ B), QuasiCompact w'.left →
      ∀ (V : S.ProEt) (g' : V ⟶ B),
      ∃ (V₁ : S.ProEt) (a : V₁ ⟶ V) (b : V₁ ⟶ W'), a ≫ g' = b ≫ w' ∧ QuasiCompact a.left ∧
        ∀ z : V.left, (∃ p : W'.left, w'.left p = g'.left z) → ∃ y : V₁.left, a.left y = z := by
    intro B W' w' hqc' V g'
    haveI := hqc'
    haveI hWp : WeaklyEtale W'.hom := W'.prop
    haveI hBp : WeaklyEtale B.hom := B.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w'.left ≫ B.hom) := by
      rw [MorphismProperty.Over.w w']; exact hWp
    haveI : WeaklyEtale w'.left := WeaklyEtale.of_comp w'.left B.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst g'.left w'.left ≫ V.hom) := inferInstance
    let V₁ : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g'.left w'.left ≫ V.hom)
    let a : V₁ ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst g'.left w'.left) rfl trivial
    have hb : Limits.pullback.snd g'.left w'.left ≫ W'.hom =
        Limits.pullback.fst g'.left w'.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w', ← MorphismProperty.Over.w g', ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : V₁ ⟶ W' :=
      MorphismProperty.Over.homMk (Limits.pullback.snd g'.left w'.left) hb trivial
    refine ⟨V₁, a, b, ?_, hfstq, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · rintro z ⟨p, hp⟩
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      exact ⟨τ, hτ⟩

  have glue : ∀ (T₀ V₁ : S.ProEt) (a : V₁ ⟶ T₀), QuasiCompact a.left →
      (∀ z : T₀.left, ∃ y : V₁.left, a.left y = z) → ∀ (x₁ : G.obj.obj (Opposite.op V₁)),
      (∀ (Z : S.ProEt) (c d : Z ⟶ V₁), c ≫ a = d ≫ a →
        (G.obj.map c.op).hom x₁ = (G.obj.map d.op).hom x₁) →
      ∃ x : G.obj.obj (Opposite.op T₀), (G.obj.map a.op).hom x = x₁ := by
    intro T₀ V₁ a haq hsurj x₁ hcomp
    haveI := haq
    haveI hTp : WeaklyEtale T₀.hom := T₀.prop
    haveI hVp : WeaklyEtale V₁.hom := V₁.prop
    haveI hwB : WeaklyEtale (a.left ≫ T₀.hom) := by
      rw [MorphismProperty.Over.w a]; exact hVp
    haveI hae : WeaklyEtale a.left := WeaklyEtale.of_comp a.left T₀.hom
    have hsurj' : ∀ x : T₀.left, ∃ (_ : PUnit.{u+2}) (y : V₁.left), a.left y = x := by
      intro p
      obtain ⟨y, hy⟩ := hsurj p
      exact ⟨PUnit.unit, y, hy⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T₀.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => V₁.left)
        (fun _ => a.left) hsurj' (fun _ => hae)
    have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
    have hR0 : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁.left) (fun _ => a.left) ∈
        Scheme.proetalePrecoverage.coverings T₀.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S)
      (Y := fun _ : PUnit.{u+2} => V₁) (fun _ => a)
    have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a) ∈
        (Scheme.ProEt.precoverage S).coverings T₀ :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR0)
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a)) ∈
        (Scheme.ProEt.topology S) T₀ :=
      Precoverage.generate_mem_toGrothendieck hR'
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj G).property
    have h1 := hsh _ hRJ
    rw [← Presieve.isSheafFor_iff_generate, Presieve.ofArrows_pUnit] at h1
    obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_singleton.mp h1) x₁
      (fun p₁ p₂ hp => hcomp _ p₁ p₂ hp)
    exact ⟨t, ht⟩

  obtain ⟨V₁, p₁, p₂, hsq, hqc₁, hlift₁⟩ := bc B₀ W w hqc T g
  have hsurj₁ : ∀ z : T.left, ∃ y : V₁.left, p₁.left y = z := fun z => hlift₁ z (hlift z)
  have hsqk : ∀ {Z : S.ProEt} (k : Z ⟶ V₁), (k ≫ p₂) ≫ w = (k ≫ p₁) ≫ g := by
    intro Z k
    simp only [Category.assoc, hsq]
  obtain ⟨x₁, hx₁⟩ := hR V₁ p₂ (((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map p₁.op).hom f)
  have hK : ∀ (Z : S.ProEt) (k : Z ⟶ V₁),
      Θ Z (k ≫ p₂) ((G.obj.map k.op).hom x₁) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map (k ≫ p₁).op).hom f := by
    intro Z k
    rw [hN, hx₁, hF]
  have hUV : ∀ (Z : S.ProEt) (m : Z ⟶ T) (z : Z.left),
      wcContEval S Z (((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map m.op).hom f) z ∈ U :=
    fun Z m z => hf (m.left z)

  have hdesc : ∀ (Z : S.ProEt) (c d : Z ⟶ V₁), c ≫ p₁ = d ≫ p₁ →
      (G.obj.map c.op).hom x₁ = (G.obj.map d.op).hom x₁ := by
    intro Z c d hcd
    have hw : (c ≫ p₂) ≫ w = (d ≫ p₂) ≫ w := by
      rw [hsqk c, hsqk d, hcd]
    have hfx := hfixΘ Z (c ≫ p₂) (d ≫ p₂) ((G.obj.map c.op).hom x₁)
      (fun z => by rw [hK]; exact hUV Z _ z) hw
    apply hI Z (d ≫ p₂)
    apply hCext
    intro z
    rw [hfx z, hK, hK, hcd]
  obtain ⟨x, hx⟩ := glue T V₁ p₁ hqc₁ hsurj₁ x₁ hdesc
  refine ⟨x, fun V h h' hc => ?_⟩
  rw [← hΘ]
  obtain ⟨V', q, r, hsq₂, -, hlift₂⟩ := bc T V₁ p₁ hqc₁ V h
  have hy : (G.obj.map (q ≫ h).op).hom x = (G.obj.map r.op).hom x₁ := by
    rw [hsq₂, ← hF G r p₁, hx]
  have hw2 : (r ≫ p₂) ≫ w = (q ≫ h') ≫ w := by
    rw [hsqk r, ← hsq₂]
    simp only [Category.assoc, hc]
  have hfx := hfixΘ V' (r ≫ p₂) (q ≫ h') ((G.obj.map (q ≫ h).op).hom x)
    (fun z => by rw [hy, hK]; exact hUV V' _ z) hw2
  have e2 : Θ V' (r ≫ p₂) ((G.obj.map (q ≫ h).op).hom x) =
      ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map (q ≫ h).op).hom f := by
    rw [hy, hK, hsq₂]
  have e3 : Θ V' (q ≫ h') ((G.obj.map (q ≫ h).op).hom x) =
      ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map q.op).hom (Θ V h' ((G.obj.map h.op).hom x)) := by
    rw [← hF G q h, hN]
  apply hCext
  intro v
  obtain ⟨v', hv'⟩ := hlift₂ v (hsurj₁ (h.left v))
  have e1 := hfx v'
  rw [e2, e3, ← hF _ q h] at e1
  rw [← hv']
  exact e1

theorem wc_kss_descend_function (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ W : S.ProEt) (w : W ⟶ B₀) (hqc : QuasiCompact w.left)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))
    (hfix' : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
        wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z)
    (T : S.ProEt) (g : T ⟶ B₀) (hlift : ∀ z : T.left, ∃ p : W.left, w.left p = g.left z)
    (x : G.obj.obj (Opposite.op T))
    (hx : ∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g → ∀ z : V.left,
      wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x)) z ∈ U) :
    ∃ f : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op T),
      (∀ z : T.left, wcContEval S T f z ∈ U) ∧
      ∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x) =
          ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map h.op).hom f :=
by
  classical
  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      {A B C : S.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hCext : ∀ (V : S.ProEt)
      (f₁ f₂ : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval S V f₁ z = wcContEval S V f₂ z) → f₁ = f₂ := by
    intro V f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin N → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin N → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ (V : S.ProEt) (_ : V ⟶ W),
      G.obj.obj (Opposite.op V) →+ (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V),
      ∀ V h' y, Θ V h' y = (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y :=
    ⟨fun V h' => (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom, fun _ _ _ => rfl⟩
  have hN : ∀ (V V' : S.ProEt) (k : V' ⟶ V) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V)),
      Θ V' (k ≫ h') ((G.obj.map k.op).hom y) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map k.op).hom (Θ V h' y) := by
    intro V V' k h' y
    rw [hΘ, hΘ]
    exact congrArg (fun φ => φ.hom y)
      (θ.hom.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)
  have hfixΘ : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V (Θ V h₁ x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
        wcContEval S V (Θ V h₂ x) z = wcContEval S V (Θ V h₁ x) z := by
    intro V h₁ h₂ x h1 h2 z
    rw [hΘ, hΘ]
    exact hfix' V h₁ h₂ x (fun z => by rw [← hΘ]; exact h1 z) h2 z

  have bc : ∀ (B W' : S.ProEt) (w' : W' ⟶ B), QuasiCompact w'.left →
      ∀ (V : S.ProEt) (g' : V ⟶ B),
      ∃ (V₁ : S.ProEt) (a : V₁ ⟶ V) (b : V₁ ⟶ W'), a ≫ g' = b ≫ w' ∧ QuasiCompact a.left ∧
        ∀ z : V.left, (∃ p : W'.left, w'.left p = g'.left z) → ∃ y : V₁.left, a.left y = z := by
    intro B W' w' hqc' V g'
    haveI := hqc'
    haveI hWp : WeaklyEtale W'.hom := W'.prop
    haveI hBp : WeaklyEtale B.hom := B.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w'.left ≫ B.hom) := by
      rw [MorphismProperty.Over.w w']; exact hWp
    haveI : WeaklyEtale w'.left := WeaklyEtale.of_comp w'.left B.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst g'.left w'.left ≫ V.hom) := inferInstance
    let V₁ : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g'.left w'.left ≫ V.hom)
    let a : V₁ ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst g'.left w'.left) rfl trivial
    have hb : Limits.pullback.snd g'.left w'.left ≫ W'.hom =
        Limits.pullback.fst g'.left w'.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w', ← MorphismProperty.Over.w g', ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : V₁ ⟶ W' :=
      MorphismProperty.Over.homMk (Limits.pullback.snd g'.left w'.left) hb trivial
    refine ⟨V₁, a, b, ?_, hfstq, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · rintro z ⟨p, hp⟩
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      exact ⟨τ, hτ⟩

  have glue : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (T₀ V₁ : S.ProEt) (a : V₁ ⟶ T₀), QuasiCompact a.left →
      (∀ z : T₀.left, ∃ y : V₁.left, a.left y = z) → ∀ (x₁ : F.obj.obj (Opposite.op V₁)),
      (∀ (Z : S.ProEt) (c d : Z ⟶ V₁), c ≫ a = d ≫ a →
        (F.obj.map c.op).hom x₁ = (F.obj.map d.op).hom x₁) →
      ∃ x : F.obj.obj (Opposite.op T₀), (F.obj.map a.op).hom x = x₁ := by
    intro F T₀ V₁ a haq hsurj x₁ hcomp
    haveI := haq
    haveI hTp : WeaklyEtale T₀.hom := T₀.prop
    haveI hVp : WeaklyEtale V₁.hom := V₁.prop
    haveI hwB : WeaklyEtale (a.left ≫ T₀.hom) := by
      rw [MorphismProperty.Over.w a]; exact hVp
    haveI hae : WeaklyEtale a.left := WeaklyEtale.of_comp a.left T₀.hom
    have hsurj' : ∀ x : T₀.left, ∃ (_ : PUnit.{u+2}) (y : V₁.left), a.left y = x := by
      intro p
      obtain ⟨y, hy⟩ := hsurj p
      exact ⟨PUnit.unit, y, hy⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T₀.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => V₁.left)
        (fun _ => a.left) hsurj' (fun _ => hae)
    have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
    have hR0 : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁.left) (fun _ => a.left) ∈
        Scheme.proetalePrecoverage.coverings T₀.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S)
      (Y := fun _ : PUnit.{u+2} => V₁) (fun _ => a)
    have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a) ∈
        (Scheme.ProEt.precoverage S).coverings T₀ :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR0)
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a)) ∈
        (Scheme.ProEt.topology S) T₀ :=
      Precoverage.generate_mem_toGrothendieck hR'
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology S) (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj F).property
    have h1 := hsh _ hRJ
    rw [← Presieve.isSheafFor_iff_generate, Presieve.ofArrows_pUnit] at h1
    obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_singleton.mp h1) x₁
      (fun p₁ p₂ hp => hcomp _ p₁ p₂ hp)
    exact ⟨t, ht⟩

  obtain ⟨V₁, p₁, p₂, hsq, hqc₁, hlift₁⟩ := bc B₀ W w hqc T g
  have hsurj₁ : ∀ z : T.left, ∃ y : V₁.left, p₁.left y = z := fun z => hlift₁ z (hlift z)
  have hsqk : ∀ {Z : S.ProEt} (k : Z ⟶ V₁), (k ≫ p₂) ≫ w = (k ≫ p₁) ≫ g := by
    intro Z k
    simp only [Category.assoc, hsq]

  obtain ⟨f₁, hf₁⟩ : ∃ f₁ : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V₁),
      f₁ = Θ V₁ p₂ ((G.obj.map p₁.op).hom x) := ⟨_, rfl⟩
  have hK : ∀ (Z : S.ProEt) (k : Z ⟶ V₁),
      ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map k.op).hom f₁ =
        Θ Z (k ≫ p₂) ((G.obj.map (k ≫ p₁).op).hom x) := by
    intro Z k
    rw [hf₁, ← hN, hF]
  have hUV : ∀ (Z : S.ProEt) (k : Z ⟶ V₁) (z : Z.left),
      wcContEval S Z (Θ Z (k ≫ p₂) ((G.obj.map (k ≫ p₁).op).hom x)) z ∈ U := by
    intro Z k z
    rw [hΘ]
    exact hx Z (k ≫ p₁) (k ≫ p₂) (hsqk k) z

  have hdesc : ∀ (Z : S.ProEt) (c d : Z ⟶ V₁), c ≫ p₁ = d ≫ p₁ →
      ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map c.op).hom f₁ =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map d.op).hom f₁ := by
    intro Z c d hcd
    have hw : (c ≫ p₂) ≫ w = (d ≫ p₂) ≫ w := by
      rw [hsqk c, hsqk d, hcd]
    have hfx := hfixΘ Z (c ≫ p₂) (d ≫ p₂) ((G.obj.map (c ≫ p₁).op).hom x) (hUV Z c) hw
    rw [hK, hK, ← hcd]
    apply hCext
    intro z
    exact (hfx z).symm
  obtain ⟨f, hf⟩ := glue (wcContSheaf S (Fin N → ℚ_[ℓ])) T V₁ p₁ hqc₁ hsurj₁ f₁ hdesc
  refine ⟨f, ?_, ?_⟩
  · intro z
    obtain ⟨y, rfl⟩ := hsurj₁ z
    have h1 := hx V₁ p₁ p₂ hsq.symm y
    rw [← hΘ, ← hf₁, ← hf] at h1
    exact h1
  · intro V h h' hc
    rw [← hΘ]
    obtain ⟨V', q, r, hsq₂, -, hlift₂⟩ := bc T V₁ p₁ hqc₁ V h
    have hw2 : (r ≫ p₂) ≫ w = (q ≫ h') ≫ w := by
      rw [hsqk r, ← hsq₂]
      simp only [Category.assoc, hc]
    have hfx := hfixΘ V' (r ≫ p₂) (q ≫ h') ((G.obj.map (r ≫ p₁).op).hom x) (hUV V' r) hw2
    have e2 : Θ V' (r ≫ p₂) ((G.obj.map (r ≫ p₁).op).hom x) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map q.op).hom
          (((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map h.op).hom f) := by
      rw [← hK, ← hf, hF, hF, hsq₂]
    have e3 : Θ V' (q ≫ h') ((G.obj.map (r ≫ p₁).op).hom x) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map q.op).hom (Θ V h' ((G.obj.map h.op).hom x)) := by
      rw [← hsq₂, ← hF G q h, hN]
    apply hCext
    intro v
    obtain ⟨v', hv'⟩ := hlift₂ v (hsurj₁ (h.left v))
    have e1 := hfx v'
    rw [e2, e3] at e1
    rw [← hv']
    exact e1

theorem wc_sheaf_iso_of_bijective_relation {C : Type*} [Category C] (J : GrothendieckTopology C)
    (A B : Sheaf J AddCommGrpCat.{v})
    (Rl : ∀ X : Cᵒᵖ, A.obj.obj X → B.obj.obj X → Prop)
    (hfun : ∀ X a, ∃! b, Rl X a b) (hinj : ∀ X b, ∃! a, Rl X a b)
    (hadd : ∀ X a a' b b', Rl X a b → Rl X a' b' → Rl X (a + a') (b + b'))
    (hnat : ∀ (X Y : Cᵒᵖ) (k : X ⟶ Y) a b, Rl X a b →
      Rl Y ((A.obj.map k).hom a) ((B.obj.map k).hom b)) :
    Nonempty (A ≅ B) :=
by
  classical
  let f : ∀ X : Cᵒᵖ, A.obj.obj X → B.obj.obj X := fun X a => (hfun X a).exists.choose
  have hf : ∀ X a, Rl X a (f X a) := fun X a => (hfun X a).exists.choose_spec
  have huniq : ∀ X a b, Rl X a b → b = f X a := fun X a b h => (hfun X a).unique h (hf X a)
  let φ : ∀ X : Cᵒᵖ, A.obj.obj X →+ B.obj.obj X := fun X =>
    AddMonoidHom.mk' (f X) (fun a a' =>
      (huniq X (a + a') _ (hadd X a a' _ _ (hf X a) (hf X a'))).symm)
  have hφ : ∀ X a, φ X a = f X a := fun X a => rfl
  have hbij : ∀ X, Function.Bijective (φ X) := by
    intro X
    constructor
    · intro a a' h
      rw [hφ, hφ] at h
      have h1 : Rl X a (f X a) := hf X a
      have h2 : Rl X a' (f X a) := h ▸ hf X a'
      exact (hinj X (f X a)).unique h1 h2
    · intro b
      obtain ⟨a, ha, -⟩ := hinj X b
      exact ⟨a, by rw [hφ]; exact (huniq X a b ha).symm⟩
  let e : ∀ X : Cᵒᵖ, A.obj.obj X ≅ B.obj.obj X := fun X =>
    (AddEquiv.ofBijective (φ X) (hbij X)).toAddCommGrpIso
  have hnatf : ∀ (X Y : Cᵒᵖ) (k : X ⟶ Y) (a : A.obj.obj X),
      f Y ((A.obj.map k).hom a) = (B.obj.map k).hom (f X a) := fun X Y k a =>
    (huniq Y _ _ (hnat X Y k a (f X a) (hf X a))).symm
  let eP : A.obj ≅ B.obj := NatIso.ofComponents e (by
    intro X Y k
    ext a
    exact hnatf X Y k a)
  exact ⟨(fullyFaithfulSheafToPresheaf J _).preimageIso eP⟩

theorem wc_proet_section_zero_of_qc_image : ∀ (S : Scheme.{u}) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (B W : S.ProEt) (w : W ⟶ B), QuasiCompact w.left →
    ∀ (s : G.obj.obj (Opposite.op B)), (G.obj.map w.op).hom s = 0 →
    ∀ (V : S.ProEt) (g : V ⟶ B), (∀ p : V.left, ∃ z : W.left, w.left z = g.left p) →
    (G.obj.map g.op).hom s = 0 :=
by
  intro S G B W w hqc s hs V g hlift
  haveI := hqc
  haveI hWp : WeaklyEtale W.hom := W.prop
  haveI hBp : WeaklyEtale B.hom := B.prop
  haveI hVp : WeaklyEtale V.hom := V.prop
  haveI hwB : WeaklyEtale (w.left ≫ B.hom) := by
    rw [MorphismProperty.Over.w w]; exact hWp
  haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left B.hom
  haveI hfst : WeaklyEtale (Limits.pullback.fst g.left w.left) := inferInstance
  haveI hfstq : QuasiCompact (Limits.pullback.fst g.left w.left) := inferInstance
  haveI : WeaklyEtale (Limits.pullback.fst g.left w.left ≫ V.hom) := inferInstance
  let T : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g.left w.left ≫ V.hom)
  let a : T ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst g.left w.left) rfl trivial
  have hb : Limits.pullback.snd g.left w.left ≫ W.hom =
      Limits.pullback.fst g.left w.left ≫ V.hom := by
    rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w g, ← Category.assoc,
      ← Category.assoc, Limits.pullback.condition]
  let b : T ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd g.left w.left) hb trivial
  have hsq : a ≫ g = b ≫ w := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.condition
  have hsurj : ∀ x : V.left, ∃ (_ : PUnit.{u+2}) (y : T.left), a.left y = x := by
    intro p
    obtain ⟨z, hz⟩ := hlift p
    obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback p z hz.symm
    exact ⟨PUnit.unit, τ, hτ⟩
  haveI hae : WeaklyEtale a.left := hfst
  haveI haq : QuasiCompact a.left := hfstq
  let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) V.left :=
    Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => T.left) (fun _ => a.left)
      hsurj (fun _ => hae)
  have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
    @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
      (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
  have hR : Presieve.ofArrows (fun _ : PUnit.{u+2} => T.left) (fun _ => a.left) ∈
      Scheme.proetalePrecoverage.coverings V.left :=
    Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
  have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S)
    (Y := fun _ : PUnit.{u+2} => T) (fun _ => a)
  have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => T) (fun _ => a) ∈
      (Scheme.ProEt.precoverage S).coverings V :=
    Precoverage.mem_comap_iff.mpr (e ▸ hR)
  have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => T) (fun _ => a)) ∈
      (Scheme.ProEt.topology S) V :=
    Precoverage.generate_mem_toGrothendieck hR'
  have ht : (G.obj.map a.op).hom ((G.obj.map g.op).hom s) = 0 := by
    have h1 := congrArg (fun c => (G.obj.map c.op).hom s) hsq
    simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hs,
      map_zero] at h1
    exact h1
  refine Sheaf.isSeparated G V _ hRJ ((G.obj.map g.op).hom s) 0 ?_
  rintro Y f ⟨Y', h, k, hk, rfl⟩
  rcases hk with ⟨i⟩
  change (G.obj.map (h ≫ a).op).hom ((G.obj.map g.op).hom s) = (G.obj.map (h ≫ a).op).hom 0
  rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, ht, map_zero,
    map_zero]

theorem wc_proet_frame_fixed_descent (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ W : S.ProEt) (w : W ⟶ B₀) (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : B₀.left, ∃ z : W.left, w.left z = p)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W)
    (hfix : ∀ (V : S.ProEt), ConnectedSpace V.left → ∀ (h₁ h₂ : V ⟶ W)
      (x : G.obj.obj (Opposite.op V)), h₁ ≫ w = h₂ ≫ w →
      (θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x =
        (θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) :
    Nonempty (G.over B₀ ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over B₀) :=
by
  classical

  obtain ⟨-, hfix'⟩ := wc_kss_frame_change S ℓ B₀ W w G r θ ⊤
    (fun _ _ _ _ _ _ _ => Submodule.mem_top)
    (fun V₀ hV₀ h₁ h₂ x _ hc z => by rw [hfix V₀ hV₀ h₁ h₂ x hc])

  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      {A B C : S.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hFid : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      {A : S.ProEt} (y : F.obj.obj (Opposite.op A)),
      (F.obj.map (𝟙 A).op).hom y = y := by
    intro F A y
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have hCext : ∀ (V : S.ProEt)
      (f₁ f₂ : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval S V f₁ z = wcContEval S V f₂ z) → f₁ = f₂ := by
    intro V f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ (V : S.ProEt) (_ : V ⟶ W),
      G.obj.obj (Opposite.op V) →+ (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V),
      ∀ V h' y, Θ V h' y = (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y :=
    ⟨fun V h' => (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom, fun _ _ _ => rfl⟩
  have hI : ∀ (V : S.ProEt) (h' : V ⟶ W) (a b : G.obj.obj (Opposite.op V)),
      Θ V h' a = Θ V h' b → a = b := by
    intro V h' a b hab
    rw [hΘ, hΘ] at hab
    have ha : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom a) = a :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom a) θ.hom_inv_id
    have hb : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom b) = b :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom b) θ.hom_inv_id
    rw [← ha, ← hb, hab]

  have bc : ∀ (B W' : S.ProEt) (w' : W' ⟶ B), QuasiCompact w'.left →
      ∀ (V : S.ProEt) (g' : V ⟶ B),
      ∃ (V₁ : S.ProEt) (a : V₁ ⟶ V) (b : V₁ ⟶ W'), a ≫ g' = b ≫ w' ∧ QuasiCompact a.left ∧
        ∀ z : V.left, (∃ p : W'.left, w'.left p = g'.left z) → ∃ y : V₁.left, a.left y = z := by
    intro B W' w' hqc' V g'
    haveI := hqc'
    haveI hWp : WeaklyEtale W'.hom := W'.prop
    haveI hBp : WeaklyEtale B.hom := B.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w'.left ≫ B.hom) := by
      rw [MorphismProperty.Over.w w']; exact hWp
    haveI : WeaklyEtale w'.left := WeaklyEtale.of_comp w'.left B.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst g'.left w'.left ≫ V.hom) := inferInstance
    let V₁ : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g'.left w'.left ≫ V.hom)
    let a : V₁ ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst g'.left w'.left) rfl trivial
    have hb : Limits.pullback.snd g'.left w'.left ≫ W'.hom =
        Limits.pullback.fst g'.left w'.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w', ← MorphismProperty.Over.w g', ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : V₁ ⟶ W' :=
      MorphismProperty.Over.homMk (Limits.pullback.snd g'.left w'.left) hb trivial
    refine ⟨V₁, a, b, ?_, hfstq, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · rintro z ⟨p, hp⟩
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      exact ⟨τ, hτ⟩

  have hUC : ∀ (T : S.ProEt) (g : T ⟶ B₀) (x : G.obj.obj (Opposite.op T))
      (f₁ f₂ : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T)),
      (∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        Θ V h' ((G.obj.map h.op).hom x) =
          ((wcContSheaf S (Fin r → ℚ_[ℓ])).obj.map h.op).hom f₁) →
      (∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        Θ V h' ((G.obj.map h.op).hom x) =
          ((wcContSheaf S (Fin r → ℚ_[ℓ])).obj.map h.op).hom f₂) →
      f₁ = f₂ := by
    intro T g x f₁ f₂ h1 h2
    obtain ⟨V₁, p₁, p₂, hsq, -, hl⟩ := bc B₀ W w hqc T g
    have e := (h1 V₁ p₁ p₂ hsq.symm).symm.trans (h2 V₁ p₁ p₂ hsq.symm)
    apply hCext
    intro z
    obtain ⟨y, hy⟩ := hl z (hsurj _)
    subst hy
    exact congrArg (fun f => wcContEval S V₁ f y) e

  have hUR : ∀ (T : S.ProEt) (g : T ⟶ B₀) (x₁ x₂ : G.obj.obj (Opposite.op T))
      (f : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T)),
      (∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        Θ V h' ((G.obj.map h.op).hom x₁) =
          ((wcContSheaf S (Fin r → ℚ_[ℓ])).obj.map h.op).hom f) →
      (∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        Θ V h' ((G.obj.map h.op).hom x₂) =
          ((wcContSheaf S (Fin r → ℚ_[ℓ])).obj.map h.op).hom f) →
      x₁ = x₂ := by
    intro T g x₁ x₂ f h1 h2
    obtain ⟨V₁, p₁, p₂, hsq, hqc₁, hl⟩ := bc B₀ W w hqc T g
    have e := (h1 V₁ p₁ p₂ hsq.symm).trans (h2 V₁ p₁ p₂ hsq.symm).symm
    have e2 : (G.obj.map p₁.op).hom (x₁ - x₂) = 0 := by
      rw [map_sub, hI V₁ p₂ _ _ e, sub_self]
    have e3 := wc_proet_section_zero_of_qc_image S G T V₁ p₁ hqc₁ (x₁ - x₂) e2 T (𝟙 T)
      (fun p => by
        obtain ⟨y, hy⟩ := hl p (hsurj _)
        exact ⟨y, hy⟩)
    rw [hFid] at e3
    exact sub_eq_zero.mp e3

  refine wc_sheaf_iso_of_bijective_relation _ (G.over B₀)
    ((wcContSheaf S (Fin r → ℚ_[ℓ])).over B₀)
    (fun X (a : G.obj.obj (Opposite.op X.unop.left))
        (b : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op X.unop.left)) =>
      ∀ (V : S.ProEt) (h : V ⟶ X.unop.left) (h' : V ⟶ W), h' ≫ w = h ≫ X.unop.hom →
        Θ V h' ((G.obj.map h.op).hom a) =
          ((wcContSheaf S (Fin r → ℚ_[ℓ])).obj.map h.op).hom b) ?_ ?_ ?_ ?_
  ·
    intro X a
    obtain ⟨f, -, hf⟩ := wc_kss_descend_function S ℓ B₀ W w hqc G r θ ⊤ hfix'
      X.unop.left X.unop.hom (fun z => hsurj _) a (fun _ _ _ _ _ => Submodule.mem_top)
    refine ⟨f, fun V h h' hc => (hΘ _ _ _).trans (hf V h h' hc), fun f' hf' => ?_⟩
    exact hUC X.unop.left X.unop.hom a f' f hf'
      (fun V h h' hc => (hΘ _ _ _).trans (hf V h h' hc))
  ·
    intro X b
    obtain ⟨a, ha⟩ := wc_kss_descend_section S ℓ B₀ W w hqc G r θ ⊤ hfix'
      X.unop.left X.unop.hom (fun z => hsurj _) b (fun _ => Submodule.mem_top)
    refine ⟨a, fun V h h' hc => (hΘ _ _ _).trans (ha V h h' hc), fun a' ha' => ?_⟩
    exact hUR X.unop.left X.unop.hom a' a b ha'
      (fun V h h' hc => (hΘ _ _ _).trans (ha V h h' hc))
  ·
    intro X a a' b b' hab hab' V h h' hc
    have e : _ + _ = _ + _ := congrArg₂ (· + ·) (hab V h h' hc) (hab' V h h' hc)
    have ha2 := map_add (G.obj.map h.op).hom a a'
    have hb2 := map_add ((wcContSheaf S (Fin r → ℚ_[ℓ])).obj.map h.op).hom b b'
    have hΘa := map_add (Θ V h') ((G.obj.map h.op).hom a) ((G.obj.map h.op).hom a')
    exact (congrArg (Θ V h') ha2).trans (hΘa.trans (e.trans hb2.symm))
  ·
    intro X Y k a b hab V h h' hc
    have e := hab V (h ≫ k.unop.left) h' (by rw [hc, Category.assoc, Over.w k.unop])
    have e2 := (hF (wcContSheaf S (Fin r → ℚ_[ℓ])) h k.unop.left b).symm
    exact (congrArg (Θ V h') (hF G h k.unop.left a)).trans (e.trans e2)

theorem wc_pencil_Rq_galois_scalar_cover (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (q : ℕ) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
      (θ : (wcRq D.f ℓ q).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W),
      (∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
            (wcRqScalar D.f ℓ q c) ≫ θ.hom =
          θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
            AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c)) ∧
      QuasiCompact w.left ∧ ConnectedSpace W.left ∧
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
        a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) :=
by
  classical
  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP
  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors
  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht, hgal₀⟩ :=
    wc_fet_galois_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial
  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q').obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have h := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩
  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres q
  obtain ⟨τ, hτ⟩ := wc_proet_Rq_rat_linear_triv D.f ℓ W hW₀conn hW₀cpt hW₀qs q a b e hZ
  refine ⟨W, w, a, τ, fun c' => hτ c', ?_, hW₀conn, ?_, ?_⟩
  · show QuasiCompact (p ≫ Ub.ι)
    infer_instance
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]
  · intro V a' b'' hV hab
    have h1 : a'.left ≫ p ≫ Ub.ι = b''.left ≫ p ≫ Ub.ι := by
      have := congrArg (fun f => f.left) hab
      exact this
    have h2' : (a'.left ≫ p) ≫ Ub.ι = (b''.left ≫ p) ≫ Ub.ι := by
      have e1 := Category.assoc a'.left p Ub.ι
      have e2 := Category.assoc b''.left p Ub.ι
      exact e1.trans (h1.trans e2.symm)
    have h2 : a'.left ≫ p = b''.left ≫ p := (cancel_mono Ub.ι).1 h2'
    obtain ⟨γ₀, hγp, hγb⟩ := hgal₀ V.left a'.left b''.left hV h2
    let γ : W ⟶ W := MorphismProperty.Over.homMk γ₀
      (show γ₀ ≫ p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, hγp]) trivial
    refine ⟨γ, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      show γ₀ ≫ p ≫ Ub.ι = p ≫ Ub.ι
      rw [← Category.assoc, hγp]
    · apply MorphismProperty.Over.Hom.ext
      show b''.left = a'.left ≫ γ₀
      exact hγb

theorem wc_P1bar_strict_local_lift (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hz : ∃ z : W.left, w.left z = g.left (e.inv (IsLocalRing.closedPoint A))) :
    ∃ ι : V ⟶ W, ι ≫ w = g :=
by
  classical
  obtain ⟨z, hz⟩ := hz

  haveI h1 : WeaklyEtale (w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
    rw [MorphismProperty.Over.w w]; exact W.prop
  haveI h2 : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    (wcGeomPoint F'' (wcP1Over F'') hP).prop
  have hw : WeaklyEtale w.left := WeaklyEtale.of_comp w.left (wcGeomPoint F'' (wcP1Over F'') hP).hom

  have hq : WeaklyEtale (Limits.pullback.fst g.left w.left) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback g.left w.left).flip
      hw

  obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := g.left) (g := w.left)
    (e.inv (IsLocalRing.closedPoint A)) z hz.symm

  haveI : WeaklyEtale (Limits.pullback.fst g.left w.left) := hq
  haveI : WeaklyEtale ((Limits.pullback g.left w.left).fromSpecStalk t) :=
    wc_fromSpecStalk_weaklyEtale _ t
  obtain ⟨k, hkdef⟩ : ∃ k, k = (Limits.pullback g.left w.left).fromSpecStalk t ≫
      Limits.pullback.fst g.left w.left ≫ e.hom := ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have hk_pt : k (IsLocalRing.closedPoint ((Limits.pullback g.left w.left).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h1 : k (IsLocalRing.closedPoint ((Limits.pullback g.left w.left).presheaf.stalk t)) =
        e.hom ((Limits.pullback.fst g.left w.left) ((Limits.pullback g.left w.left).fromSpecStalk t
          (IsLocalRing.closedPoint ((Limits.pullback g.left w.left).presheaf.stalk t)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    have h2 : ∀ y : Spec (CommRingCat.of A), e.hom (e.inv y) = y := by
      intro y
      first
        | simp
        | (rw [← Scheme.Hom.comp_apply, e.inv_hom_id]; rfl)
        | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f y) e.inv_hom_id
    rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
    first
      | exact h2 _
      | simp
      | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f _) e.inv_hom_id
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint ((Limits.pullback g.left w.left).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h5 : (Spec.map (Spec.preimage k))
        (IsLocalRing.closedPoint ((Limits.pullback g.left w.left).presheaf.stalk t)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint ((Limits.pullback g.left w.left).presheaf.stalk t)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance
  have hcq : (Limits.pullback g.left w.left).fromSpecStalk t ≫ Limits.pullback.fst g.left w.left =
      k ≫ e.inv := by
    rw [hkdef]; simp
  obtain ⟨s, hs⟩ : ∃ s : V.left ⟶ Limits.pullback g.left w.left,
      s ≫ Limits.pullback.fst g.left w.left = 𝟙 _ :=
    ⟨e.hom ≫ inv k ≫ (Limits.pullback g.left w.left).fromSpecStalk t, by
      rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩

  have hfw : (s ≫ Limits.pullback.snd g.left w.left) ≫ w.left = g.left := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
  have hh : (s ≫ Limits.pullback.snd g.left w.left) ≫ W.hom = V.hom := by
    rw [← MorphismProperty.Over.w w, ← Category.assoc, hfw, MorphismProperty.Over.w g]
  refine ⟨MorphismProperty.Over.homMk (s ≫ Limits.pullback.snd g.left w.left) hh trivial,
    MorphismProperty.Over.Hom.ext ?_⟩
  show (s ≫ Limits.pullback.snd g.left w.left) ≫ w.left = g.left
  exact hfw

theorem wc_geomPoint_pullback_iso (F' : Type u) [Field F'] [Finite F'] (Y W : Over (Spec (.of F')))
    (p : W ⟶ Y)
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) :
    ∃ e : wcGeomPoint F' W hW ≅ (wcProEtPullback p.left).obj (wcGeomPoint F' Y hY),
      e.hom ≫ (wcProEtPullback p.left).map (wcGeomFrob F' Y hY) = wcGeomFrob F' W hW ≫ e.hom :=
by
  have key : ∀ (S K A B : Scheme.{u}) (σ : K ⟶ S) (φ : K ⟶ K) (a : A ⟶ S) (b : B ⟶ S) (f : B ⟶ A)
      (hf : f ≫ a = b) (FrA : Limits.pullback a σ ⟶ Limits.pullback a σ)
      (FrB : Limits.pullback b σ ⟶ Limits.pullback b σ)
      (hA1 : FrA ≫ Limits.pullback.fst a σ = Limits.pullback.fst a σ)
      (_hA2 : FrA ≫ Limits.pullback.snd a σ = Limits.pullback.snd a σ ≫ φ)
      (hB1 : FrB ≫ Limits.pullback.fst b σ = Limits.pullback.fst b σ)
      (_hB2 : FrB ≫ Limits.pullback.snd b σ = Limits.pullback.snd b σ ≫ φ),
      ∃ ε : Limits.pullback b σ ≅ Limits.pullback (Limits.pullback.fst a σ) f,
        ε.hom ≫ Limits.pullback.snd (Limits.pullback.fst a σ) f = Limits.pullback.fst b σ ∧
        ε.hom ≫ Limits.pullback.lift (Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ FrA)
          (Limits.pullback.snd (Limits.pullback.fst a σ) f)
          (by rw [Category.assoc, hA1]; exact Limits.pullback.condition) = FrB ≫ ε.hom := by
    intro S K A B σ φ a b f hf FrA FrB hA1 hA2 hB1 hB2
    let E₁ : Limits.pullback b σ ⟶ Limits.pullback a σ :=
      Limits.pullback.lift (Limits.pullback.fst b σ ≫ f) (Limits.pullback.snd b σ)
        (by rw [Category.assoc, hf]; exact Limits.pullback.condition)
    have E₁f : E₁ ≫ Limits.pullback.fst a σ = Limits.pullback.fst b σ ≫ f :=
      Limits.pullback.lift_fst _ _ _
    have E₁s : E₁ ≫ Limits.pullback.snd a σ = Limits.pullback.snd b σ :=
      Limits.pullback.lift_snd _ _ _
    let E : Limits.pullback b σ ⟶ Limits.pullback (Limits.pullback.fst a σ) f :=
      Limits.pullback.lift E₁ (Limits.pullback.fst b σ) E₁f
    have Ef : E ≫ Limits.pullback.fst (Limits.pullback.fst a σ) f = E₁ :=
      Limits.pullback.lift_fst _ _ _
    have Es : E ≫ Limits.pullback.snd (Limits.pullback.fst a σ) f = Limits.pullback.fst b σ :=
      Limits.pullback.lift_snd _ _ _
    have hc : Limits.pullback.snd (Limits.pullback.fst a σ) f ≫ b =
        (Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ Limits.pullback.snd a σ) ≫ σ := by
      simp only [Category.assoc]
      rw [← Limits.pullback.condition, ← hf, Limits.pullback.condition_assoc]
    let E' : Limits.pullback (Limits.pullback.fst a σ) f ⟶ Limits.pullback b σ :=
      Limits.pullback.lift (Limits.pullback.snd (Limits.pullback.fst a σ) f)
        (Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ Limits.pullback.snd a σ) hc
    have E'f : E' ≫ Limits.pullback.fst b σ = Limits.pullback.snd (Limits.pullback.fst a σ) f :=
      Limits.pullback.lift_fst _ _ _
    have E's : E' ≫ Limits.pullback.snd b σ =
        Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ Limits.pullback.snd a σ :=
      Limits.pullback.lift_snd _ _ _
    have h1 : E ≫ E' = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, E'f, Es, Category.id_comp]
      · rw [Category.assoc, E's, ← Category.assoc, Ef, E₁s, Category.id_comp]
    have h2 : E' ≫ E = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Ef, Category.id_comp]
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, E₁f, ← Category.assoc, E'f, ← Limits.pullback.condition]
        · rw [Category.assoc, E₁s, E's]
      · rw [Category.assoc, Es, E'f, Category.id_comp]
    have hE₁Fr : E₁ ≫ FrA = FrB ≫ E₁ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hA1, E₁f, Category.assoc, E₁f, ← Category.assoc, hB1]
      · rw [Category.assoc, hA2, ← Category.assoc, E₁s, Category.assoc, E₁s, hB2]
    refine ⟨Iso.mk E E' h1 h2, Es, ?_⟩
    show E ≫ _ = FrB ≫ E
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Ef, Category.assoc, Ef,
        hE₁Fr]
    · rw [Category.assoc, Limits.pullback.lift_snd, Es, Category.assoc, Es, hB1]
  have hp : p.left ≫ Y.hom = W.hom := Over.w p
  obtain ⟨ε, hε1, hε2⟩ := key _ _ _ _
    (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
    (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F' _
      (Fintype.ofFinite F') (AlgebraicClosure F') _ _ _).symm :
        AlgebraicClosure F' →+* AlgebraicClosure F')))
    Y.hom W.hom p.left hp (wcGeomFrob F' Y hY).left (wcGeomFrob F' W hW).left
    (MorphismProperty.Over.w (wcGeomFrob F' Y hY)) (Limits.pullback.lift_snd _ _ _)
    (MorphismProperty.Over.w (wcGeomFrob F' W hW)) (Limits.pullback.lift_snd _ _ _)
  refine ⟨MorphismProperty.Over.isoMk ε hε1, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  exact hε2

theorem wc_proet_push_free_adjunction (F'' : Type u) [Field F''] [Finite F'']
    (X W : Over (Spec (.of F''))) (p : W ⟶ X)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ (L : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.ProEt.topology W.left) AddCommGrpCat.{u+1}) (_ : L ⊣ wcProEtPush p.left),
      Limits.PreservesFiniteLimits L ∧
      ∃ θ : L.obj (wcFreeSheaf X.left (wcGeomPoint F'' X hX)) ≅
          wcFreeSheaf W.left (wcGeomPoint F'' W hW),
        L.map (wcFreeSheafMap X.left (wcGeomFrob F'' X hX)) ≫ θ.hom =
          θ.hom ≫ wcFreeSheafMap W.left (wcGeomFrob F'' W hW) :=
by
  haveI hcont := (wc_proet_pullback_continuous_flat p.left).1
  haveI hflat := (wc_proet_pullback_continuous_flat p.left).2
  let L := (wcProEtPullback p.left).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology X.left) (Scheme.ProEt.topology W.left)
  let adj₀ : L ⊣ (wcProEtPullback p.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology X.left) (Scheme.ProEt.topology W.left) :=
    (wcProEtPullback p.left).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology X.left) (Scheme.ProEt.topology W.left)
  let ι : (wcProEtPullback p.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology X.left) (Scheme.ProEt.topology W.left) ≅ wcProEtPush p.left :=
    (Functor.rightUnitor _).symm ≪≫
      Functor.isoWhiskerLeft _ (sheafificationNatIso (Scheme.ProEt.topology X.left)
        AddCommGrpCat.{u+1}) ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight ((wcProEtPullback p.left).sheafPushforwardContinuousCompSheafToPresheafIso
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology X.left) (Scheme.ProEt.topology W.left))
        (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _
  obtain ⟨θ₀, hθ₀⟩ := wc_sheafPullback_free_natIso (Scheme.ProEt.topology X.left)
    (Scheme.ProEt.topology W.left) (wcProEtPullback p.left) L adj₀
  obtain ⟨e, he⟩ := wc_geomPoint_pullback_iso F'' X W p hX hW
  let Z : W.left.ProEt ⥤ Sheaf (Scheme.ProEt.topology W.left) AddCommGrpCat.{u+1} :=
    yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
      presheafToSheaf (Scheme.ProEt.topology W.left) AddCommGrpCat.{u+1}
  have hE' : (wcProEtPullback p.left).map (wcGeomFrob F'' X hX) ≫ e.inv =
      e.inv ≫ wcGeomFrob F'' W hW := by
    refine (Iso.eq_inv_comp e).2 ?_
    calc e.hom ≫ (wcProEtPullback p.left).map (wcGeomFrob F'' X hX) ≫ e.inv
        = (e.hom ≫ (wcProEtPullback p.left).map (wcGeomFrob F'' X hX)) ≫ e.inv :=
          (Category.assoc _ _ _).symm
      _ = (wcGeomFrob F'' W hW ≫ e.hom) ≫ e.inv := congrArg (· ≫ e.inv) he
      _ = wcGeomFrob F'' W hW ≫ (e.hom ≫ e.inv) := Category.assoc _ _ _
      _ = wcGeomFrob F'' W hW := by rw [Iso.hom_inv_id, Category.comp_id]
  have h1 : L.map (wcFreeSheafMap X.left (wcGeomFrob F'' X hX)) ≫ (θ₀ (wcGeomPoint F'' X hX)).hom =
      (θ₀ (wcGeomPoint F'' X hX)).hom ≫ Z.map ((wcProEtPullback p.left).map (wcGeomFrob F'' X hX)) :=
    hθ₀ (wcGeomFrob F'' X hX)
  have h2 : Z.map ((wcProEtPullback p.left).map (wcGeomFrob F'' X hX)) ≫ Z.map e.inv =
      Z.map e.inv ≫ Z.map (wcGeomFrob F'' W hW) := by
    rw [← Z.map_comp, ← Z.map_comp, hE']
  refine ⟨L, adj₀.ofNatIsoRight ι,
    wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.ProEt.topology X.left)
      (Scheme.ProEt.topology W.left) (wcProEtPullback p.left),
    θ₀ (wcGeomPoint F'' X hX) ≪≫ Z.mapIso e.symm, ?_⟩
  show L.map (wcFreeSheafMap X.left (wcGeomFrob F'' X hX)) ≫
      ((θ₀ (wcGeomPoint F'' X hX)).hom ≫ Z.map e.inv) =
    ((θ₀ (wcGeomPoint F'' X hX)).hom ≫ Z.map e.inv) ≫ Z.map (wcGeomFrob F'' W hW)
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ Z.map e.inv) h1).trans
      ((Category.assoc _ _ _).trans
        ((congrArg ((θ₀ (wcGeomPoint F'' X hX)).hom ≫ ·) h2).trans
          (Category.assoc _ _ _).symm)))

theorem wc_proet_ML_tower_shift_epi : ∀ (S : Scheme.{u}) (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (pr : ∀ n, Y ⟶ B n), Limits.IsLimit (Limits.Fan.mk Y pr) → ∀ (c' : ∀ k m, m ≤ k → (B k ⟶ B m)), (∀ k j m (h1 : m ≤ j) (h2 : j ≤ k), c' k j h2 ≫ c' j m h1 = c' k m (h1.trans h2)) → (∀ m, ∃ m', ∃ hm : m ≤ m', ∀ k (hk : m' ≤ k), Limits.imageSubobject (c' k m (hm.trans hk)) = Limits.imageSubobject (c' m' m hm)) → ∀ T : Y ⟶ Y, (∀ m, T ≫ pr m = pr m - pr (m + 1) ≫ c' (m + 1) m (Nat.le_succ m)) → Epi T :=
by
  intro S Y B pr hY c' hcoc hML T hT

  have hcompapp : ∀ {A A' A'' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (φ : A ⟶ A') (ψ : A' ⟶ A'') (V : (S.ProEt)ᵒᵖ) (z : A.obj.obj V),
      (φ ≫ ψ).hom.app V z = ψ.hom.app V (φ.hom.app V z) := fun _ _ _ _ => rfl
  have hsubapp : ∀ {A A' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (φ ψ : A ⟶ A') (V : (S.ProEt)ᵒᵖ) (z : A.obj.obj V),
      (φ - ψ).hom.app V z = φ.hom.app V z - ψ.hom.app V z := fun _ _ _ _ => rfl
  have haddapp : ∀ {A A' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (φ ψ : A ⟶ A') (V : (S.ProEt)ᵒᵖ) (z : A.obj.obj V),
      (φ + ψ).hom.app V z = φ.hom.app V z + ψ.hom.app V z := fun _ _ _ _ => rfl

  have hsec : ∀ (W : S.ProEt), (∀ b : ∀ n, (B n).obj.obj (Opposite.op W),
      ∃ x : Y.obj.obj (Opposite.op W), ∀ n, (pr n).hom.app (Opposite.op W) x = b n) ∧
      ∀ x x' : Y.obj.obj (Opposite.op W),
        (∀ n, (pr n).hom.app (Opposite.op W) x = (pr n).hom.app (Opposite.op W) x') → x = x' := by
    intro W
    let G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ Type (u+1) :=
      sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op W) ⋙ forget AddCommGrpCat.{u+1}
    have hcG : Limits.IsLimit (G.mapCone (Limits.Fan.mk Y pr)) := Limits.isLimitOfPreserves G hY
    constructor
    · intro b
      let sec : (Discrete.functor B ⋙ G).sections := ⟨fun j => b j.as, by
        intro i j f
        obtain rfl : i = j := Discrete.ext (Discrete.eq_of_hom f)
        rw [show f = 𝟙 i from Subsingleton.elim _ _]
        exact FunctorToTypes.map_id_apply _ _⟩
      refine ⟨(Limits.Types.isLimitEquivSections hcG).symm sec, fun n => ?_⟩
      exact Limits.Types.isLimitEquivSections_symm_apply hcG sec ⟨n⟩
    · intro x x' hxx
      apply (Limits.Types.isLimitEquivSections hcG).injective
      apply Subtype.ext
      funext j
      rw [Limits.Types.isLimitEquivSections_apply, Limits.Types.isLimitEquivSections_apply]
      exact hxx j.as

  have hlift : ∀ {A A' D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : A ⟶ D)
      (g : A' ⟶ D), Limits.imageSubobject f ≤ Limits.imageSubobject g → ∀ (V : S.ProEt),
      IsAffine V.left → ∀ (s : A.obj.obj (Opposite.op V)), ∃ (V' : S.ProEt) (h : V' ⟶ V)
      (t : A'.obj.obj (Opposite.op V')), IsAffine V'.left ∧ Surjective h.left ∧
      g.hom.app (Opposite.op V') t = D.obj.map h.op (f.hom.app (Opposite.op V) s) := by
    intro A A' D f g hle V hV s
    let I := Limits.imageSubobject g
    let p : A' ⟶ (I : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      Limits.factorThruImageSubobject g
    let k : A ⟶ (I : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      Limits.factorThruImageSubobject f ≫ Subobject.ofLE _ _ hle
    have hp : p ≫ I.arrow = g := Limits.imageSubobject_arrow_comp g
    have hk : k ≫ I.arrow = f := by
      simp only [k, Category.assoc, Subobject.ofLE_arrow, Limits.imageSubobject_arrow_comp]
    obtain ⟨V', h, t, hV', hh, ht⟩ :=
      wc_proet_epi_affine_lift S p (by infer_instance) V hV (k.hom.app (Opposite.op V) s)
    refine ⟨V', h, t, hV', hh, ?_⟩
    rw [← hp, ← hk, hcompapp, hcompapp, ht, NatTrans.naturality_apply]

  choose m' hm hm' using hML
  obtain ⟨K, hK0, hKs⟩ : ∃ K : ℕ → ℕ, K 0 = m' 0 ∧ ∀ n, K (n + 1) = K n + m' (n + 1) + 1 :=
    ⟨fun n => Nat.rec (motive := fun _ => ℕ) (m' 0) (fun j Kj => Kj + m' (j + 1) + 1) n,
      rfl, fun n => rfl⟩
  have hmK : ∀ n, m' n ≤ K n := by
    intro n
    cases n with
    | zero => rw [hK0]
    | succ n => rw [hKs]; omega
  have hnK : ∀ n, n ≤ K n := fun n => (hm n).trans (hmK n)
  have hKK : ∀ n, K n + 1 ≤ K (n + 1) := by intro n; rw [hKs]; omega
  have hle1 : ∀ n, n ≤ K n + 1 := fun n => Nat.le_succ_of_le (hnK n)
  have hle2 : ∀ n, n ≤ K (n + 1) + 1 := fun n => by have := hnK n; have := hKK n; omega
  have hIm : ∀ n, Limits.imageSubobject (c' (K n + 1) n (hle1 n)) ≤
      Limits.imageSubobject (c' (K (n + 1) + 1) n (hle2 n)) := by
    intro n
    have e1 := hm' n (K n + 1) (by have := hmK n; omega)
    have e2 := hm' n (K (n + 1) + 1) (by have := hmK n; have := hKK n; omega)
    exact le_of_eq (e1.trans e2.symm)

  obtain ⟨Fm, hFpos, hFneg⟩ : ∃ Fm : ∀ a k, Y ⟶ B a,
      (∀ a k (h : a < k), Fm a k = pr k ≫ c' k a h.le) ∧ ∀ a k, ¬ a < k → Fm a k = 0 :=
    ⟨fun a k => if h : a < k then pr k ≫ c' k a h.le else 0,
      fun a k h => dif_pos h, fun a k h => dif_neg h⟩
  obtain ⟨Qm, hQ0, hQs⟩ : ∃ Qm : ∀ a, ℕ → (Y ⟶ B a),
      (∀ a, Qm a 0 = pr a) ∧ ∀ a b, Qm a (b + 1) = Qm a b + Fm a (b + 1) :=
    ⟨fun a b => Nat.rec (motive := fun _ => Y ⟶ B a) (pr a) (fun j Qj => Qj + Fm a (j + 1)) b,
      fun a => rfl, fun a b => rfl⟩
  have hQle : ∀ a b, b ≤ a → Qm a b = pr a := by
    intro a b
    induction b with
    | zero => intro _; exact hQ0 a
    | succ b ih => intro hb; rw [hQs, ih (by omega), hFneg a (b + 1) (by omega), add_zero]
  have hFc : ∀ a c k (hac : a ≤ c), c < k → Fm c k ≫ c' c a hac = Fm a k := by
    intro a c k hac hck
    rw [hFpos c k hck, hFpos a k (lt_of_le_of_lt hac hck), Category.assoc, hcoc]
  have hsplit : ∀ a d (had : a ≤ d) j, Qm a (d + 1 + j) =
      Qm a d + Qm (d + 1) (d + 1 + j) ≫ c' (d + 1) a (Nat.le_succ_of_le had) := by
    intro a d had j
    induction j with
    | zero =>
      show Qm a (d + 1) = Qm a d + Qm (d + 1) (d + 1) ≫ c' (d + 1) a (Nat.le_succ_of_le had)
      rw [hQs a d, hQle (d + 1) (d + 1) le_rfl, hFpos a (d + 1) (Nat.lt_succ_of_le had)]
    | succ j ih =>
      rw [show d + 1 + (j + 1) = d + 1 + j + 1 by omega, hQs a (d + 1 + j),
        hQs (d + 1) (d + 1 + j), ih, Preadditive.add_comp,
        ← hFc a (d + 1) (d + 1 + j + 1) (Nat.le_succ_of_le had) (by omega)]
      abel
  have hfin : ∀ n, Qm n (K n) + Qm (K n + 1) (K (n + 1)) ≫ c' (K n + 1) n (hle1 n) -
      Qm (n + 1) (K (n + 1)) ≫ c' (n + 1) n (Nat.le_succ n) = pr n := by
    intro n
    obtain ⟨j, hj⟩ := Nat.exists_eq_add_of_le (hKK n)
    obtain ⟨j', hj'⟩ := Nat.exists_eq_add_of_le (hnK (n + 1))
    have e1 := hsplit n (K n) (hnK n) j
    have e2 := hsplit n n le_rfl j'
    rw [← hj] at e1
    rw [← hj', hQle n n le_rfl] at e2
    rw [← e1, e2]
    exact add_sub_cancel_right _ _

  apply wc_proet_epi_of_affine_lift S T
  intro U hU y
  obtain ⟨e, he⟩ : ∃ e : ∀ n, (B (K n + 1)).obj.obj (Opposite.op U),
      ∀ n, e n = (Qm (K n + 1) (K (n + 1))).hom.app (Opposite.op U) y := ⟨_, fun n => rfl⟩
  have hstep : ∀ n (V : S.ProEt), IsAffine V.left → ∀ s : (B (K n + 1)).obj.obj (Opposite.op V),
      ∃ (V' : S.ProEt) (h : V' ⟶ V) (t : (B (K (n + 1) + 1)).obj.obj (Opposite.op V')),
      IsAffine V'.left ∧ Surjective h.left ∧
      (c' (K (n + 1) + 1) n (hle2 n)).hom.app (Opposite.op V') t =
        (B n).obj.map h.op ((c' (K n + 1) n (hle1 n)).hom.app (Opposite.op V) s) :=
    fun n V hV s => hlift _ _ (hIm n) V hV s
  choose V' hmap t hV' hh ht using hstep
  let seq : ∀ n : ℕ, Σ' (V : S.ProEt) (_ : IsAffine V.left) (_ : V ⟶ U),
      (B (K n + 1)).obj.obj (Opposite.op V) :=
    fun n => Nat.rec (motive := fun n => Σ' (V : S.ProEt) (_ : IsAffine V.left) (_ : V ⟶ U),
        (B (K n + 1)).obj.obj (Opposite.op V))
      ⟨U, hU, 𝟙 U, 0⟩
      (fun n st => ⟨V' n st.1 st.2.1 (st.2.2.2 + (B (K n + 1)).obj.map st.2.2.1.op (e n)),
        hV' n _ _ _, hmap n _ _ _ ≫ st.2.2.1, t n _ _ _⟩) n
  let Us : ℕ → S.ProEt := fun n => (seq n).1
  let π : ∀ n, Us n ⟶ U := fun n => (seq n).2.2.1
  let ws : ∀ n, (B (K n + 1)).obj.obj (Opposite.op (Us n)) := fun n => (seq n).2.2.2
  have hUs : ∀ n, IsAffine (Us n).left := fun n => (seq n).2.1
  let sv : ∀ n, (B (K n + 1)).obj.obj (Opposite.op (Us n)) :=
    fun n => ws n + (B (K n + 1)).obj.map (π n).op (e n)
  have hsv : ∀ n, sv n = ws n + (B (K n + 1)).obj.map (π n).op (e n) := fun n => rfl
  let p : ∀ n, Us (n + 1) ⟶ Us n := fun n => hmap n (Us n) (hUs n) (sv n)
  have hp : ∀ n, Surjective (p n).left := fun n => hh n _ _ _
  have hπs : ∀ n, π (n + 1) = p n ≫ π n := fun n => rfl
  have hws : ∀ n, (c' (K (n + 1) + 1) n (hle2 n)).hom.app (Opposite.op (Us (n + 1))) (ws (n + 1)) =
      (B n).obj.map (p n).op ((c' (K n + 1) n (hle1 n)).hom.app (Opposite.op (Us n)) (sv n)) :=
    fun n => ht n (Us n) (hUs n) (sv n)
  obtain ⟨W, q, hW, hq, hq0⟩ := wc_proet_affine_tower_limit S Us p hUs hp
  obtain ⟨q0, hq0def⟩ : ∃ q0 : W ⟶ U, q0 = q 0 := ⟨_, rfl⟩
  have hq0s : Surjective q0.left := by rw [hq0def]; exact hq0
  have hqπ : ∀ n, q n ≫ π n = q0 := by
    intro n
    induction n with
    | zero => rw [hq0def]; exact Category.comp_id _
    | succ n ih => rw [hπs n, ← Category.assoc, hq n, ih]
  obtain ⟨y', hy'⟩ : ∃ y' : Y.obj.obj (Opposite.op W), y' = Y.obj.map q0.op y := ⟨_, rfl⟩
  obtain ⟨ws', hws'⟩ : ∃ ws' : ∀ n, (B (K n + 1)).obj.obj (Opposite.op W),
      ∀ n, ws' n = (B (K n + 1)).obj.map (q n).op (ws n) := ⟨_, fun n => rfl⟩
  have hey : ∀ n, (B (K n + 1)).obj.map q0.op (e n) =
      (Qm (K n + 1) (K (n + 1))).hom.app (Opposite.op W) y' := by
    intro n
    rw [he n, hy']
    exact (NatTrans.naturality_apply (Qm (K n + 1) (K (n + 1))).hom q0.op y).symm
  have hkey : ∀ n, (c' (K (n + 1) + 1) n (hle2 n)).hom.app (Opposite.op W) (ws' (n + 1)) =
      (c' (K n + 1) n (hle1 n)).hom.app (Opposite.op W)
        (ws' n + (Qm (K n + 1) (K (n + 1))).hom.app (Opposite.op W) y') := by
    intro n
    have e1 : ws' n + (Qm (K n + 1) (K (n + 1))).hom.app (Opposite.op W) y' =
        (B (K n + 1)).obj.map (q n).op (sv n) := by
      rw [hws' n, ← hey n, hsv n, map_add, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
        ← op_comp, hqπ n]
    rw [e1, hws' (n + 1),
      NatTrans.naturality_apply (c' (K (n + 1) + 1) n (hle2 n)).hom (q (n + 1)).op (ws (n + 1)),
      hws n, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hq n,
      NatTrans.naturality_apply (c' (K n + 1) n (hle1 n)).hom (q n).op (sv n)]
  obtain ⟨x', hx'⟩ : ∃ x' : ∀ n, (B n).obj.obj (Opposite.op W), ∀ n,
      x' n = (Qm n (K n)).hom.app (Opposite.op W) y' -
        (c' (K n + 1) n (hle1 n)).hom.app (Opposite.op W) (ws' n) := ⟨_, fun n => rfl⟩
  have hx'rel : ∀ n, x' n - (c' (n + 1) n (Nat.le_succ n)).hom.app (Opposite.op W) (x' (n + 1)) =
      (pr n).hom.app (Opposite.op W) y' := by
    intro n
    have h1 := congrArg (fun φ : Y ⟶ B n => φ.hom.app (Opposite.op W) y') (hfin n)
    simp only [hsubapp, haddapp, hcompapp] at h1
    have h3 : (c' (n + 1) n (Nat.le_succ n)).hom.app (Opposite.op W)
        ((c' (K (n + 1) + 1) (n + 1) (hle1 (n + 1))).hom.app (Opposite.op W) (ws' (n + 1))) =
        (c' (K (n + 1) + 1) n (hle2 n)).hom.app (Opposite.op W) (ws' (n + 1)) := by
      rw [← hcompapp, hcoc]
    rw [hx' n, hx' (n + 1), map_sub, h3, hkey n, map_add, ← h1]
    abel
  obtain ⟨x, hx⟩ := (hsec W).1 x'
  refine ⟨W, q0, x, hW, hq0s, ?_⟩
  rw [← hy']
  apply (hsec W).2
  intro n
  rw [← hcompapp, hT n, hsubapp, hcompapp, hx n, hx (n + 1)]
  exact hx'rel n

theorem wc_contSheaf_zmod_const_natIso : ∀ (Y : Scheme.{u}), ∃ c : ∀ N : ℕ, wcContSheaf Y (ZMod N) ≅ (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod N))), ∀ (a b : ℕ) (h : a ∣ b), wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom continuous_of_discreteTopology ≫ (c a).hom = (c b).hom ≫ (constantSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp ((ZMod.castHom h (ZMod a)).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom))) :=
by
  intro Y

  have key : ∀ (A : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
      [IsTopologicalAddGroup A],
      ∃ c : (Functor.const Y.ProEtᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} A)) ⟶
        (wcContSheaf Y A).obj,
        (∀ (U : Y.ProEtᵒᵖ) (x : ULift.{u+1} A), (c.app U).hom x =
          (ULift.up (ContinuousMap.const _ x.down) :
            ULift.{u+1} C(↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj (Opposite.unop U)), A))) ∧
        IsIso ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map c) := by
    intro A _ _ _ _
    let c : (Functor.const Y.ProEtᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} A)) ⟶
        (wcContSheaf Y A).obj :=
      { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk'
            (fun a : ULift.{u+1} A =>
              (ULift.up (ContinuousMap.const _ a.down) :
                ULift.{u+1} C(↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj (Opposite.unop U)),
                  A)))
            (fun a b => rfl))
        naturality := fun U V f => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro a
          apply ULift.ext
          apply ContinuousMap.ext
          intro t
          rfl }
    have hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology Y) c := by
      refine ⟨fun {X} x y hxy => ?_⟩
      rcases isEmpty_or_nonempty (X.unop.left) with hE | ⟨⟨p⟩⟩
      · exact (Scheme.ProEt.topology Y).superset_covering bot_le
          (Scheme.ProEt.bot_mem_topology X.unop)
      · change (ULift.up (ContinuousMap.const _ x.down) : ULift.{u+1} C(↥X.unop.left, A)) =
            ULift.up (ContinuousMap.const _ y.down) at hxy
        have h1 := congrArg (fun z : ULift.{u+1} C(↥X.unop.left, A) => z.down p) hxy
        have hxy' : x = y := by
          apply ULift.ext
          exact h1
        subst hxy'
        refine (Scheme.ProEt.topology Y).superset_covering ?_ ((Scheme.ProEt.topology Y).top_mem _)
        intro V f _
        rw [Presheaf.equalizerSieve_apply]
    have hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) c := by
      refine ⟨fun {U} s => ?_⟩
      let s' : C(↥U.left, A) := ULift.down s
      let O : A → U.left.Opens := fun a =>
        ⟨s' ⁻¹' {a}, s'.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
      haveI := U.prop
      let W : ULift.{u+1} A → Y.ProEt := fun i => Scheme.ProEt.mk ((O i.down).ι ≫ U.hom)
      let f : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (O i.down).ι rfl trivial
      have hcov : ∀ x : ↥U.left, ∃ (i : ULift.{u+1} A) (y : ↥(O i.down).toScheme),
          (O i.down).ι y = x := fun x =>
        ⟨ULift.up (s' x), ⟨x, rfl⟩, Scheme.Opens.ι_apply _ _⟩
      let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) U.left :=
        Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} A)
          (fun i => (O i.down).toScheme) (fun i => (O i.down).ι) hcov (fun i => inferInstance)
      have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
        @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
          (fun i => (Scheme.Hom.isOpenEmbedding (O i.down).ι).isOpenMap)
      have hR : Presieve.ofArrows (fun i : ULift.{u+1} A => (O i.down).toScheme)
          (fun i => (O i.down).ι) ∈ Scheme.proetalePrecoverage.coverings U.left :=
        Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
      have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) (Y := W) f
      have hR' : Presieve.ofArrows W f ∈ (Scheme.ProEt.precoverage Y).coverings U :=
        Precoverage.mem_comap_iff.mpr (e ▸ hR)
      have hRJ : Sieve.generate (Presieve.ofArrows W f) ∈ (Scheme.ProEt.topology Y) U :=
        Precoverage.generate_mem_toGrothendieck hR'
      refine (Scheme.ProEt.topology Y).superset_covering ?_ hRJ
      rintro V g ⟨W', h, f', hf', rfl⟩
      rcases hf' with ⟨i⟩
      rw [Presheaf.imageSieve_apply]
      refine ⟨ULift.up i.down, ?_⟩
      apply ULift.ext
      apply ContinuousMap.ext
      intro v
      let y : ↥(O i.down) := (h.left : V.left ⟶ (O i.down).toScheme) v
      change i.down = s' ((O i.down).ι y)
      have h2 := Scheme.Opens.ι_apply (O i.down) y
      have hm : s' y.1 = i.down := y.2
      rw [h2]
      exact hm.symm
    haveI := hinj
    haveI := hsurj
    haveI : IsIso ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map c) :=
      (GrothendieckTopology.W_iff (Scheme.ProEt.topology Y) c).mp
        (GrothendieckTopology.W_of_isLocallyBijective (Scheme.ProEt.topology Y) c)
    exact ⟨c, fun U x => rfl, inferInstance⟩
  choose cc hcc hiso using fun N : ℕ => key (ZMod N)

  have s2 : ∀ {P Q : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f : P ⟶ Q),
      (sheafificationIso P).hom ≫
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map f.hom =
        f ≫ (sheafificationIso Q).hom := by
    intro P Q f
    apply Sheaf.hom_ext
    change toSheafify (Scheme.ProEt.topology Y) P.obj ≫
        sheafifyMap (Scheme.ProEt.topology Y) f.hom =
      f.hom ≫ toSheafify (Scheme.ProEt.topology Y) Q.obj
    exact (toSheafify_naturality (Scheme.ProEt.topology Y) f.hom).symm
  refine ⟨fun N => (@asIso _ _ _ _
      ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc N)) (hiso N) ≪≫
      (sheafificationIso (wcContSheaf Y (ZMod N))).symm).symm, fun a b h => ?_⟩
  haveI := hiso a
  haveI := hiso b

  have s3 : cc b ≫ (wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
        continuous_of_discreteTopology).hom =
      (Functor.const Y.ProEtᵒᵖ).map (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
        ((ZMod.castHom h (ZMod a)).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom))) ≫ cc a := by
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    change ((wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
        continuous_of_discreteTopology).hom.app U).hom (((cc b).app U).hom x) =
      ((cc a).app U).hom ((((Functor.const Y.ProEtᵒᵖ).map (AddCommGrpCat.ofHom
        (AddEquiv.ulift.symm.toAddMonoidHom.comp
        ((ZMod.castHom h (ZMod a)).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom)))).app U).hom x)
    rw [hcc b U x, hcc a U]
    all_goals (apply ULift.ext; apply ContinuousMap.ext; intro t; rfl)
  have s3' : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc b) ≫
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
        (wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
          continuous_of_discreteTopology).hom =
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map ((Functor.const Y.ProEtᵒᵖ).map
        (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
          ((ZMod.castHom h (ZMod a)).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom)))) ≫
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc a) := by
    rw [← Functor.map_comp, s3, Functor.map_comp]
    all_goals rfl
  have e2 := s2 (wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
    continuous_of_discreteTopology)
  have star : (sheafificationIso (wcContSheaf Y (ZMod b))).inv ≫
      wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom continuous_of_discreteTopology =
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
        (wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
          continuous_of_discreteTopology).hom ≫
      (sheafificationIso (wcContSheaf Y (ZMod a))).inv := by
    rw [Iso.eq_comp_inv, Category.assoc, ← e2, Iso.inv_hom_id_assoc]
  have alg : ∀ {X1 X2 Y1 Y2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      (α : X1 ≅ Y1) (β : X2 ≅ Y2) (f : X1 ⟶ X2) (g : Y1 ⟶ Y2),
      α.inv ≫ f = g ≫ β.inv → f ≫ β.hom = α.hom ≫ g := by
    intro X1 X2 Y1 Y2 α β f g H
    rw [← Iso.inv_comp_eq, ← Category.assoc, H, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]
  have inv_form :
      ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc b) ≫
        (sheafificationIso (wcContSheaf Y (ZMod b))).inv) ≫
        wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom continuous_of_discreteTopology =
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map ((Functor.const Y.ProEtᵒᵖ).map
        (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
          ((ZMod.castHom h (ZMod a)).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom)))) ≫
      ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc a) ≫
        (sheafificationIso (wcContSheaf Y (ZMod a))).inv) := by
    calc _ = (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc b) ≫
          ((sheafificationIso (wcContSheaf Y (ZMod b))).inv ≫
            wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
              continuous_of_discreteTopology) := Category.assoc _ _ _
      _ = (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc b) ≫
          ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
            (wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
              continuous_of_discreteTopology).hom ≫
          (sheafificationIso (wcContSheaf Y (ZMod a))).inv) :=
          congrArg (fun t => (presheafToSheaf (Scheme.ProEt.topology Y)
            AddCommGrpCat.{u+1}).map (cc b) ≫ t) star
      _ = ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc b) ≫
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
            (wcContSheafMap Y (ZMod.castHom h (ZMod a)).toAddMonoidHom
              continuous_of_discreteTopology).hom) ≫
          (sheafificationIso (wcContSheaf Y (ZMod a))).inv := (Category.assoc _ _ _).symm
      _ = ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map ((Functor.const Y.ProEtᵒᵖ).map
            (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
              ((ZMod.castHom h (ZMod a)).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom)))) ≫
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map (cc a)) ≫
          (sheafificationIso (wcContSheaf Y (ZMod a))).inv :=
          congrArg (fun t => t ≫ (sheafificationIso (wcContSheaf Y (ZMod a))).inv) s3'
      _ = _ := Category.assoc _ _ _
  exact alg _ _ _ _ inv_form

theorem wc_rightDerived_postcomp_exact_natIso : ∀ {C D D' : Type*} [Category C] [Category D] [Category D'] [Abelian C] [Abelian D] [Abelian D'] [HasInjectiveResolutions C] (F : C ⥤ D) [F.Additive] (E' : D ⥤ D') [E'.Additive] [Limits.PreservesFiniteLimits E'] [Limits.PreservesFiniteColimits E'] (q : ℕ), Nonempty ((F ⋙ E').rightDerived q ≅ F.rightDerived q ⋙ E') :=
by
  intro C D D' _ _ _ _ _ _ _ F _ E' _ _ _ q
  let K : C → HomologicalComplex D (ComplexShape.up ℕ) := fun X =>
    (F.mapHomologicalComplex _).obj (injectiveResolution X).cocomplex
  let ιFE : ∀ X : C, ((F ⋙ E').rightDerived q).obj X ≅
      (((F ⋙ E').mapHomologicalComplex (ComplexShape.up ℕ)).obj
        (injectiveResolution X).cocomplex).homology q := fun X =>
    (injectiveResolution X).isoRightDerivedObj (F ⋙ E') q
  let ιF : ∀ X : C, (F.rightDerived q).obj X ≅ (K X).homology q := fun X =>
    (injectiveResolution X).isoRightDerivedObj F q
  let γ : ∀ X : C, ((F ⋙ E').mapHomologicalComplex (ComplexShape.up ℕ)).obj
      (injectiveResolution X).cocomplex ≅ (E'.mapHomologicalComplex _).obj (K X) :=
    fun X => HomologicalComplex.Hom.isoOfComponents (fun n => Iso.refl _) (by intro i j _; simp [K])
  let μ : ∀ X : C, ((E'.mapHomologicalComplex _).obj (K X)).homology q ≅
      E'.obj ((K X).homology q) := fun X => ((K X).sc q).mapHomologyIso E'
  let e : ∀ X : C, ((F ⋙ E').rightDerived q).obj X ≅ (F.rightDerived q ⋙ E').obj X := fun X =>
    ιFE X ≪≫ HomologicalComplex.homologyMapIso (γ X) q ≪≫ μ X ≪≫ E'.mapIso (ιF X).symm
  refine ⟨NatIso.ofComponents e ?_⟩
  intro X Y f
  have hδ := InjectiveResolution.desc_commutes_zero f (injectiveResolution Y) (injectiveResolution X)
  set δ := InjectiveResolution.desc f (injectiveResolution Y) (injectiveResolution X) with hδdef
  let ψ : K X ⟶ K Y := (F.mapHomologicalComplex _).map δ
  have N1 : ((F ⋙ E').rightDerived q).map f ≫ (ιFE Y).hom =
      (ιFE X).hom ≫
        HomologicalComplex.homologyMap (((F ⋙ E').mapHomologicalComplex _).map δ) q :=
    InjectiveResolution.isoRightDerivedObj_hom_naturality f (injectiveResolution X)
      (injectiveResolution Y) δ hδ (F ⋙ E') q
  have N2 : (F.rightDerived q).map f ≫ (ιF Y).hom =
      (ιF X).hom ≫ HomologicalComplex.homologyMap ψ q :=
    InjectiveResolution.isoRightDerivedObj_hom_naturality f (injectiveResolution X)
      (injectiveResolution Y) δ hδ F q
  have Sq1 : ((F ⋙ E').mapHomologicalComplex _).map δ ≫ (γ Y).hom =
      (γ X).hom ≫ (E'.mapHomologicalComplex _).map ψ := by
    ext n
    first
    | simp [γ, ψ, K]
    | (dsimp [γ, ψ, K]; simp)
  have H1 : HomologicalComplex.homologyMap (((F ⋙ E').mapHomologicalComplex _).map δ) q ≫
        HomologicalComplex.homologyMap (γ Y).hom q =
      HomologicalComplex.homologyMap (γ X).hom q ≫
        HomologicalComplex.homologyMap ((E'.mapHomologicalComplex _).map ψ) q := by
    rw [← HomologicalComplex.homologyMap_comp, ← HomologicalComplex.homologyMap_comp, Sq1]
  have H2 : HomologicalComplex.homologyMap ((E'.mapHomologicalComplex _).map ψ) q ≫ (μ Y).hom =
      (μ X).hom ≫ E'.map (HomologicalComplex.homologyMap ψ q) :=
    ShortComplex.mapHomologyIso_hom_naturality
      ((HomologicalComplex.shortComplexFunctor D (ComplexShape.up ℕ) q).map ψ) E'
  have N2' : (F.rightDerived q).map f =
      (ιF X).hom ≫ HomologicalComplex.homologyMap ψ q ≫ (ιF Y).inv := by
    rw [← Category.assoc, ← N2, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  show ((F ⋙ E').rightDerived q).map f ≫ (e Y).hom = (e X).hom ≫ E'.map ((F.rightDerived q).map f)
  simp only [e, Iso.trans_hom, Functor.mapIso_hom, Iso.symm_hom,
    HomologicalComplex.homologyMapIso_hom, Category.assoc]
  rw [reassoc_of% N1, reassoc_of% H1, reassoc_of% H2, N2', Functor.map_comp, Functor.map_comp,
    Iso.map_inv_hom_id_assoc]

theorem wc_rightDerived_precomp_exact_acyclic_natIso : ∀ {C C' D' : Type*} [Category C] [Category C'] [Category D'] [Abelian C] [Abelian C'] [Abelian D'] [HasInjectiveResolutions C] [HasInjectiveResolutions C'] (E : C ⥤ C') [E.Additive] [Limits.PreservesFiniteLimits E] [Limits.PreservesFiniteColimits E] (F' : C' ⥤ D') [F'.Additive] [Limits.PreservesFiniteLimits F'], (∀ (I : C) [Injective I] (n : ℕ), Limits.IsZero ((F'.rightDerived (n + 1)).obj (E.obj I))) → ∀ q : ℕ, Nonempty ((E ⋙ F').rightDerived q ≅ E ⋙ F'.rightDerived q) :=
by
  intro C C' D' _ _ _ _ _ _ _ _ E _ _ _ F' _ _ hacyc q

  have s2 : ∀ (M : C') (K L : CochainComplex C' ℕ) (u : M ⟶ K.X 0) (hu : u ≫ K.d 0 1 = 0),
      (ShortComplex.mk u (K.d 0 1) hu).Exact → (∀ k, K.ExactAt (k + 1)) →
      (∀ k, Injective (L.X k)) → ∀ (φ₁ φ₂ : K ⟶ L), u ≫ φ₁.f 0 = u ≫ φ₂.f 0 →
      Nonempty (Homotopy φ₁ φ₂) := by
    intro M K L u hu hex0 hexs hinj φ₁ φ₂ hφ
    have hS : ∀ n : ℕ, (K.sc' n (n + 1) (n + 2)).Exact := fun n =>
      (HomologicalComplex.exactAt_iff' K n (n + 1) (n + 2) (CochainComplex.prev_nat_succ n)
        (CochainComplex.next ℕ (n + 1))).1 (hexs n)
    have h0 : u ≫ (φ₁ - φ₂).f 0 = 0 := by
      rw [HomologicalComplex.sub_f_apply, Preadditive.comp_sub, hφ, sub_self]
    haveI : Injective (L.X 0) := hinj 0
    haveI : Injective (L.X 1) := hinj 1
    let z : K.X 1 ⟶ L.X 0 := hex0.descToInjective ((φ₁ - φ₂).f 0) h0
    have hz : K.d 0 1 ≫ z = (φ₁ - φ₂).f 0 := hex0.comp_descToInjective _ h0
    have hS0 : (K.sc' 0 1 2).Exact := hS 0
    have hg1 : (K.sc' 0 1 2).f ≫ ((φ₁ - φ₂).f 1 - z ≫ L.d 0 1) = 0 := by
      show K.d 0 1 ≫ ((φ₁ - φ₂).f 1 - z ≫ L.d 0 1) = 0
      rw [Preadditive.comp_sub, ← (φ₁ - φ₂).comm, ← Category.assoc, hz, sub_self]
    let o : K.X 2 ⟶ L.X 1 := hS0.descToInjective ((φ₁ - φ₂).f 1 - z ≫ L.d 0 1) hg1
    have ho : K.d 1 2 ≫ o = (φ₁ - φ₂).f 1 - z ≫ L.d 0 1 := hS0.comp_descToInjective _ hg1
    refine ⟨Homotopy.equivSubZero.symm (Homotopy.mkCoinductive (φ₁ - φ₂) z hz.symm o ?_ ?_)⟩
    · rw [ho]; abel
    · intro n p
      obtain ⟨f, f', hp⟩ := p
      haveI : Injective (L.X (n + 2)) := hinj (n + 2)
      have hSn : (K.sc' (n + 1) (n + 2) (n + 3)).Exact := hS (n + 1)
      have hg : (K.sc' (n + 1) (n + 2) (n + 3)).f ≫
          ((φ₁ - φ₂).f (n + 2) - f' ≫ L.d (n + 1) (n + 2)) = 0 := by
        show K.d (n + 1) (n + 2) ≫ ((φ₁ - φ₂).f (n + 2) - f' ≫ L.d (n + 1) (n + 2)) = 0
        rw [Preadditive.comp_sub, ← (φ₁ - φ₂).comm, hp]
        simp only [Preadditive.add_comp, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero, zero_add, sub_self]
      refine ⟨hSn.descToInjective _ hg, ?_⟩
      have h3 : K.d (n + 2) (n + 3) ≫ hSn.descToInjective _ hg =
          (φ₁ - φ₂).f (n + 2) - f' ≫ L.d (n + 1) (n + 2) := hSn.comp_descToInjective _ hg
      show (φ₁ - φ₂).f (n + 2) = f' ≫ L.d (n + 1) (n + 2) +
        K.d (n + 2) (n + 3) ≫ hSn.descToInjective _ hg
      rw [h3]; abel

  haveI : E.PreservesHomology := Functor.preservesHomologyOfExact E
  have s1 : ∀ (X : C) (I : InjectiveResolution X), Mono (E.map (I.ι.f 0)) ∧
      (∃ hz : E.map (I.ι.f 0) ≫ ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d 0 1 = 0,
        (ShortComplex.mk (E.map (I.ι.f 0))
          (((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d 0 1) hz).Exact) ∧
      ∀ k : ℕ, ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).ExactAt (k + 1) := by
    intro X I
    refine ⟨inferInstance, ⟨?_, ?_⟩, ?_⟩
    · show E.map (I.ι.f 0) ≫ E.map (I.cocomplex.d 0 1) = 0
      rw [← E.map_comp, I.ι_f_zero_comp_complex_d, E.map_zero]
    · exact I.exact₀.map E
    · intro k
      exact (HomologicalComplex.exactAt_iff' _ k (k + 1) (k + 2) (CochainComplex.prev_nat_succ k)
        (CochainComplex.next ℕ (k + 1))).2 ((I.exact_succ k).map E)

  haveI : EnoughInjectives C' := ⟨fun Y => ⟨InjectivePresentation.mk
    (J := (injectiveResolution Y).cocomplex.X 0) (f := (injectiveResolution Y).ι.f 0)
    (injective := (injectiveResolution Y).injective 0)
    (mono := (inferInstance : Mono ((injectiveResolution Y).ι.f 0)))⟩⟩
  have s3 : ∀ (M : C') (K : CochainComplex C' ℕ) (u : M ⟶ K.X 0) (hu : u ≫ K.d 0 1 = 0), Mono u →
      (ShortComplex.mk u (K.d 0 1) hu).Exact → (∀ k, K.ExactAt (k + 1)) →
      (∀ k i, Limits.IsZero ((F'.rightDerived (i + 1)).obj (K.X k))) →
      ∃ (J : InjectiveResolution M) (χ : K ⟶ J.cocomplex), u ≫ χ.f 0 = J.ι.f 0 ∧
        ∀ n : ℕ, IsIso (HomologicalComplex.homologyMap
          ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).map χ) n) := by
    intro M K u hu hmono hex hexs hac
    let e : (CochainComplex.single₀ C').obj M ⟶ K := (K.fromSingle₀Equiv M).symm ⟨u, hu⟩
    have he0 : e.f 0 = u := CochainComplex.fromSingle₀Equiv_symm_apply_f_zero u hu
    have hmono' : Mono (e.f 0) := by rw [he0]; exact hmono
    have hex' : ∃ hz : e.f 0 ≫ K.d 0 1 = 0, (ShortComplex.mk (e.f 0) (K.d 0 1) hz).Exact := by
      rw [he0]; exact ⟨hu, hex⟩
    have qe : QuasiIso e := (wc_rdsc_quasiIso_single0_iff M K e).2 ⟨hmono', hex', hexs⟩
    obtain ⟨χ₀, hχ₀⟩ :=
      wc_rdsc_lift_to_injective_resolution M K e hmono' hex' hexs (injectiveResolution M)
    obtain ⟨J, χ, hχ, hmχ⟩ :=
      wc_rdsc_mono_replacement M K e hmono' hex' (injectiveResolution M) χ₀ hχ₀
    have hles := fun (S : ShortComplex C') (hS : S.ShortExact) => wc_rightDerived_les_package F' S hS
    refine ⟨J, χ, ?_, wc_rdsc_quasiIso_map_of_acyclic F' hles (wc_rdsc_acyclic_exact_map F' hles)
      (fun K L χ h1 h2 => wc_rdsc_cokernel_exact_of_mono_quasiIso K L χ h1 h2) M K e qe hac J χ hχ hmχ⟩
    have h := congrArg (fun t => HomologicalComplex.Hom.f t 0) hχ
    simp only [HomologicalComplex.comp_f, he0] at h
    exact h

  have key : ∀ X : C, ∃ (J : InjectiveResolution (E.obj X))
      (χ : (E.mapHomologicalComplex (ComplexShape.up ℕ)).obj (injectiveResolution X).cocomplex ⟶
        J.cocomplex),
      E.map ((injectiveResolution X).ι.f 0) ≫ χ.f 0 = J.ι.f 0 ∧
      ∀ n : ℕ, IsIso (HomologicalComplex.homologyMap
        ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).map χ) n) := by
    intro X
    obtain ⟨hmono, ⟨hu, hex⟩, hexs⟩ := s1 X (injectiveResolution X)
    exact s3 (E.obj X) ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        (injectiveResolution X).cocomplex) (E.map ((injectiveResolution X).ι.f 0)) hu hmono hex hexs
      (fun k i => by
        haveI := (injectiveResolution X).injective k
        exact hacyc ((injectiveResolution X).cocomplex.X k) i)
  choose J χ hχ hiso using key

  refine ⟨NatIso.ofComponents (fun X =>
      ((injectiveResolution X).isoRightDerivedObj (E ⋙ F') q) ≪≫
        (@asIso _ _ _ _ (HomologicalComplex.homologyMap
          ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).map (χ X)) q) (hiso X q)) ≪≫
        ((J X).isoRightDerivedObj F' q).symm) ?_⟩

  intro X Y f
  obtain ⟨φ, hφ⟩ : ∃ φ : (injectiveResolution X).cocomplex ⟶ (injectiveResolution Y).cocomplex,
      (injectiveResolution X).ι.f 0 ≫ φ.f 0 = f ≫ (injectiveResolution Y).ι.f 0 :=
    ⟨_, InjectiveResolution.desc_commutes_zero f (injectiveResolution Y) (injectiveResolution X)⟩
  obtain ⟨ψ, hψ⟩ : ∃ ψ : (J X).cocomplex ⟶ (J Y).cocomplex,
      (J X).ι.f 0 ≫ ψ.f 0 = E.map f ≫ (J Y).ι.f 0 :=
    ⟨_, InjectiveResolution.desc_commutes_zero (E.map f) (J Y) (J X)⟩
  have n1 : ((E ⋙ F').rightDerived q).map f ≫
        ((injectiveResolution Y).isoRightDerivedObj (E ⋙ F') q).hom =
      ((injectiveResolution X).isoRightDerivedObj (E ⋙ F') q).hom ≫
        HomologicalComplex.homologyMap ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).map
          ((E.mapHomologicalComplex (ComplexShape.up ℕ)).map φ)) q :=
    InjectiveResolution.isoRightDerivedObj_hom_naturality f _ _ φ hφ (E ⋙ F') q
  have n2 : (F'.rightDerived q).map (E.map f) ≫ ((J Y).isoRightDerivedObj F' q).hom =
      ((J X).isoRightDerivedObj F' q).hom ≫
        HomologicalComplex.homologyMap ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).map ψ) q :=
    InjectiveResolution.isoRightDerivedObj_hom_naturality (E.map f) _ _ ψ hψ F' q
  obtain ⟨-, ⟨hu, hex⟩, hexs⟩ := s1 X (injectiveResolution X)
  have e1 : E.map ((injectiveResolution X).ι.f 0) ≫ (χ X ≫ ψ).f 0 = E.map f ≫ (J Y).ι.f 0 := by
    rw [HomologicalComplex.comp_f, ← Category.assoc, hχ X]
    exact hψ
  have hφE : E.map ((injectiveResolution X).ι.f 0) ≫ E.map (φ.f 0) =
      E.map f ≫ E.map ((injectiveResolution Y).ι.f 0) :=
    (E.map_comp _ _).symm.trans ((congrArg E.map hφ).trans (E.map_comp _ _))
  have e2 : E.map ((injectiveResolution X).ι.f 0) ≫
      ((E.mapHomologicalComplex (ComplexShape.up ℕ)).map φ ≫ χ Y).f 0 = E.map f ≫ (J Y).ι.f 0 := by
    rw [HomologicalComplex.comp_f, ← Category.assoc, Functor.mapHomologicalComplex_map_f, hφE]
    exact (Category.assoc _ _ _).trans (congrArg (fun t => E.map f ≫ t) (hχ Y))
  obtain ⟨H⟩ := s2 (E.obj X) ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      (injectiveResolution X).cocomplex) (J Y).cocomplex (E.map ((injectiveResolution X).ι.f 0))
    hu hex hexs (J Y).injective (χ X ≫ ψ) ((E.mapHomologicalComplex (ComplexShape.up ℕ)).map φ ≫ χ Y)
    (e1.trans e2.symm)
  have n3 := (F'.mapHomotopy H).homologyMap_eq q
  rw [Functor.map_comp, Functor.map_comp, HomologicalComplex.homologyMap_comp,
    HomologicalComplex.homologyMap_comp] at n3

  have chase : ∀ {A B P Q T U V W : D'} (r : A ⟶ B) (iX : A ≅ P) (iY : B ≅ Q) (m : P ⟶ Q)
      (cX : P ⟶ T) (cY : Q ⟶ U) (ps : T ⟶ U) (jX : V ≅ T) (jY : W ≅ U) (s : V ⟶ W)
      (hX : IsIso cX) (hY : IsIso cY),
      r ≫ iY.hom = iX.hom ≫ m → s ≫ jY.hom = jX.hom ≫ ps → cX ≫ ps = m ≫ cY →
      r ≫ (iY ≪≫ @asIso _ _ _ _ cY hY ≪≫ jY.symm).hom =
        (iX ≪≫ @asIso _ _ _ _ cX hX ≪≫ jX.symm).hom ≫ s := by
    intro A B P Q T U V W r iX iY m cX cY ps jX jY s hX hY h1 h2 h3
    have h2' : jX.inv ≫ s = ps ≫ jY.inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← h2, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    simp only [Iso.trans_hom, Iso.symm_hom, asIso_hom, Category.assoc]
    rw [h2', reassoc_of% h1, ← reassoc_of% h3]
  exact chase (((E ⋙ F').rightDerived q).map f)
    ((injectiveResolution X).isoRightDerivedObj (E ⋙ F') q)
    ((injectiveResolution Y).isoRightDerivedObj (E ⋙ F') q) _
    (HomologicalComplex.homologyMap ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).map (χ X)) q)
    (HomologicalComplex.homologyMap ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).map (χ Y)) q)
    _ ((J X).isoRightDerivedObj F' q) ((J Y).isoRightDerivedObj F' q)
    ((F'.rightDerived q).map (E.map f)) (hiso X q) (hiso Y q) n1 n2 n3

theorem wc_proet_push_rightDerived_contSheaf_epsInv_nat : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsProper g] [HasInjectiveResolutions (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})] (j : ℕ), ∃ α : ∀ N : ℕ, ((wcProEtPush g).rightDerived j).obj (wcContSheaf X (ZMod N)) ≅ (wcEpsInv B).obj (((wcEtPush g).rightDerived j).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod N))))), ∀ (a b : ℕ) (h : a ∣ b), ((wcProEtPush g).rightDerived j).map (wcContSheafMap X (ZMod.castHom h (ZMod a)).toAddMonoidHom continuous_of_discreteTopology) ≫ (α a).hom = (α b).hom ≫ (wcEpsInv B).map (((wcEtPush g).rightDerived j).map ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp ((ZMod.castHom h (ZMod a)).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom))))) :=
by
  intro X B g _ _ j

  have hexact : ∀ S : Scheme.{u},
      (wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) ∧
      (wcEpsInv S).Additive ∧ Limits.PreservesFiniteLimits (wcEpsInv S) ∧
      Limits.PreservesFiniteColimits (wcEpsInv S) := by
    intro S
    obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont S
    haveI := hlim
    haveI := hcont
    haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt S)
    let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
    haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv S) := by
      haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt S)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
      exact Limits.preservesFiniteLimits_of_natIso
        (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt S)
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)) adj)
    haveI hladj : (wcEpsInv S).IsLeftAdjoint := adj.isLeftAdjoint
    haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv S) := by
      haveI := adj.leftAdjoint_preservesColimits.{0, 0}
      exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
    haveI : (wcEpsInv S).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    exact ⟨hcont, Functor.additive_of_preserves_binary_products _, hpl, hpc⟩
  obtain ⟨hcX, haX, hlX, hcolX⟩ := hexact X
  obtain ⟨hcB, haB, hlB, hcolB⟩ := hexact B

  obtain ⟨β⟩ := wc_epsInv_push_base_change g

  have hacyc : ∀ (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) [Injective J]
      (n : ℕ), Limits.IsZero (((wcProEtPush g).rightDerived (n + 1)).obj ((wcEpsInv X).obj J)) := by
    intro J _ n
    apply wc_proet_push_rightDerived_zero_of_local
    intro U
    refine GrothendieckTopology.superset_covering _ ?_ (wc_proet_affIndEt_covering B U)
    apply Sieve.generate_mono
    rintro T f ⟨A, hA, hT⟩
    exact fun e => wc_proet_push_epsInv_injective_affine_vanishing g A hA T hT J n e

  obtain ⟨Φ1⟩ := wc_rightDerived_precomp_exact_acyclic_natIso (wcEpsInv X) (wcProEtPush g) hacyc j
  have Φ2 : (wcEtPush g ⋙ wcEpsInv B).rightDerived j ≅ (wcEpsInv X ⋙ wcProEtPush g).rightDerived j :=
    { hom := NatTrans.rightDerived β.hom j, inv := NatTrans.rightDerived β.inv j,
      hom_inv_id := by rw [← NatTrans.rightDerived_comp, β.hom_inv_id, NatTrans.rightDerived_id],
      inv_hom_id := by rw [← NatTrans.rightDerived_comp, β.inv_hom_id, NatTrans.rightDerived_id] }
  obtain ⟨Φ3⟩ := wc_rightDerived_postcomp_exact_natIso (wcEtPush g) (wcEpsInv B) j
  have Θ : wcEpsInv X ⋙ (wcProEtPush g).rightDerived j ≅
      (wcEtPush g).rightDerived j ⋙ wcEpsInv B := Φ1.symm ≪≫ Φ2.symm ≪≫ Φ3

  have hTet : Limits.IsTerminal (Scheme.Etale.mk (𝟙 X)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTpro : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 X)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  let adj1 := constantSheafAdj (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} hTet
  let adj2 := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt X)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)
  let ρ : (wcEtToProEt X).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X) ⋙
      (sheafSections (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (Opposite.op (Scheme.Etale.mk (𝟙 X))) ≅
      (sheafSections (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj
        (Opposite.op (Scheme.ProEt.mk (𝟙 X))) := Iso.refl _
  let adj3 := (adj1.comp adj2).ofNatIsoRight ρ
  let adj4 := constantSheafAdj (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} hTpro
  obtain ⟨θ⟩ : Nonempty (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
      wcEpsInv X ≅ constantSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) :=
    ⟨adj3.leftAdjointUniq adj4⟩

  obtain ⟨c₁, hc₁⟩ := wc_contSheaf_zmod_const_natIso X

  have hgen : ∀ {A A' : AddCommGrpCat.{u+1}} (κ : A ⟶ A'),
      ((wcProEtPush g).rightDerived j).map
          ((constantSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map κ) ≫
        ((wcProEtPush g).rightDerived j).map (θ.inv.app A') ≫
          Θ.hom.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A') =
      ((wcProEtPush g).rightDerived j).map (θ.inv.app A) ≫
        Θ.hom.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A) ≫
          (wcEpsInv B).map (((wcEtPush g).rightDerived j).map
            ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ)) := by
    intro A A' κ
    rw [← Category.assoc, ← Functor.map_comp, θ.inv.naturality κ, Functor.map_comp,
      Category.assoc]
    congr 1
    exact Θ.hom.naturality ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ)

  refine ⟨fun N => ((wcProEtPush g).rightDerived j).mapIso
      (c₁ N ≪≫ (θ.app (AddCommGrpCat.of (ULift.{u+1} (ZMod N)))).symm) ≪≫
      Θ.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod N)))), fun a b h => ?_⟩
  simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.app_hom, Iso.symm_hom, Iso.app_inv,
    Functor.map_comp, Category.assoc]
  rw [← Functor.map_comp_assoc, hc₁ a b h, Functor.map_comp_assoc, hgen]

theorem wc_epsInv_preserves_mono_epi : ∀ (Y : Scheme.{u}) {G H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (g : G ⟶ H), (Mono g → Mono ((wcEpsInv Y).map g)) ∧ (Epi g → Epi ((wcEpsInv Y).map g)) :=
by
  intro Y G H g

  haveI h1 : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
      (Scheme.ProEt.forget Y)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
      (wcEtToProEt Y) := by
    refine ⟨fun {V} {R} hR => ?_⟩
    obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
    have hP : Presieve.map (wcEtToProEt Y) (@Scheme.Cover.toPresieveOverProp _ _ _ _ _ 𝒰 h₁ h) ∈
        (Scheme.ProEt.precoverage Y).coverings ((wcEtToProEt Y).obj V) :=
      Precoverage.mem_comap_iff.2
        ((congrArg (· ∈ Scheme.proetalePrecoverage.coverings V.left)
            ((congrArg (Presieve.map (Scheme.ProEt.forget Y ⋙ Over.forget Y))
              (Presieve.map_ofArrows (F := wcEtToProEt Y) _)).trans
              (Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) _))).mpr
          (Scheme.etalePrecoverage_le_proetalePrecoverage _ 𝒰.mem₀))
    have hgen := Precoverage.generate_mem_toGrothendieck hP
    refine GrothendieckTopology.superset_covering _ ?_ hgen
    rw [Sieve.generate_le_iff]
    intro W f hf
    cases hf with
    | of hg => exact ⟨_, _, 𝟙 _, (by apply hle; exact hg), (Category.id_comp _).symm⟩
  haveI hflat : RepresentablyFlat (wcEtToProEt Y) := flat_of_preservesFiniteLimits (wcEtToProEt Y)
  haveI hcont : (wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y) := Functor.isContinuous_of_coverPreserving
    (compatiblePreservingOfFlat (Scheme.ProEt.topology Y) (wcEtToProEt Y)) hcov

  let adj : wcEpsInv Y ⊣ (wcEtToProEt Y).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  have wc_lan_pfl_of_filtered : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, IsFiltered (CostructuredArrow L Y)) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hfilt
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := wc_lan_eval_iso L Y
    haveI := hfilt Y
    haveI : HasExactColimitsOfShape (CostructuredArrow L Y) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (ULiftHom.equiv : CostructuredArrow L Y ≌ ULiftHom.{u+1} (CostructuredArrow L Y)).symm
    exact Limits.preservesLimitsOfShape_of_natIso θ.symm
  haveI : Limits.PreservesFiniteLimits
      ((wcEtToProEt Y).op.lan : (Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤
        (Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_pfl_of_filtered (wcEtToProEt Y).op (fun Y => inferInstance)
  haveI hpfl : Limits.PreservesFiniteLimits ((wcEtToProEt Y).sheafPullback AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) :=
    Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)

  have e : (wcEtToProEt Y).sheafPullback AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) ≅ wcEpsInv Y :=
    ((wcEtToProEt Y).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)).leftAdjointUniq adj
  haveI hpflE : Limits.PreservesFiniteLimits (wcEpsInv Y) :=
    Limits.preservesFiniteLimits_of_natIso e
  haveI : Limits.PreservesLimitsOfShape Limits.WalkingCospan (wcEpsInv Y) :=
    Limits.PreservesFiniteLimits.preservesFiniteLimits (F := wcEpsInv Y) Limits.WalkingCospan
  haveI : (wcEpsInv Y).PreservesMonomorphisms := inferInstance
  haveI : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
  haveI : (wcEpsInv Y).PreservesEpimorphisms := Functor.preservesEpimorphisms_of_isLeftAdjoint _
  refine ⟨fun hg => ?_, fun hg => ?_⟩
  · exact Functor.map_mono (wcEpsInv Y) g
  · exact Functor.map_epi (wcEpsInv Y) g

theorem wc_et_tower_ML_of_stalk_card : ∀ (B : Scheme.{u}) (L : ℕ → Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (c : ∀ k m, m ≤ k → (L k ⟶ L m)), (∀ k i m (h1 : m ≤ i) (h2 : i ≤ k), c k i h2 ≫ c i m h1 = c k m (h1.trans h2)) → ∀ m : ℕ, (∀ b : B, Finite ((wcEtStalk B b).obj (L m))) → ∀ (E : Set B), E.Finite → (∀ b b' : B, b ∉ E → b' ∉ E → ∀ (k : ℕ) (hk : m ≤ k), Nat.card (Set.range ((wcEtStalk B b).map (c k m hk))) = Nat.card (Set.range ((wcEtStalk B b').map (c k m hk)))) → ∃ m', ∃ hm : m ≤ m', ∀ (k : ℕ) (hk : m' ≤ k), Limits.imageSubobject (c k m (hm.trans hk)) = Limits.imageSubobject (c m' m hm) :=
by
  classical
  intro B L c hcoc m hfin E hE hcard

  have hfs : ∀ (b : B) (s : Set ((wcEtStalk B b).obj (L m))), s.Finite := fun b s => by
    haveI := hfin b
    exact Set.toFinite s

  have hanti : ∀ (b : B) (k k' : ℕ) (hk : m ≤ k) (hkk' : k ≤ k'),
      Set.range ((wcEtStalk B b).map (c k' m (hk.trans hkk'))) ⊆
        Set.range ((wcEtStalk B b).map (c k m hk)) := by
    intro b k k' hk hkk' y hy
    obtain ⟨x, rfl⟩ := hy
    refine ⟨(wcEtStalk B b).map (c k' k hkk') x, ?_⟩
    have e : (wcEtStalk B b).map (c k' k hkk') ≫ (wcEtStalk B b).map (c k m hk) =
        (wcEtStalk B b).map (c k' m (hk.trans hkk')) := by
      rw [← Functor.map_comp, hcoc]
    have := ConcreteCategory.congr_hom e x
    rw [CategoryTheory.comp_apply] at this
    exact this

  obtain ⟨a, ha⟩ : ∃ a : B → ℕ, ∀ (b : B) (t : ℕ),
      Nat.card (Set.range ((wcEtStalk B b).map (c (m + a b) m (Nat.le_add_right m (a b))))) ≤
        Nat.card (Set.range ((wcEtStalk B b).map (c (m + t) m (Nat.le_add_right m t)))) :=
    ⟨fun b => Function.argmin (fun t : ℕ =>
        Nat.card (Set.range ((wcEtStalk B b).map (c (m + t) m (Nat.le_add_right m t))))),
      fun b t => Function.argmin_le (fun t : ℕ =>
        Nat.card (Set.range ((wcEtStalk B b).map (c (m + t) m (Nat.le_add_right m t))))) t⟩

  have hstab1 : ∀ (b : B) (k : ℕ) (h1 : m + a b ≤ k),
      Set.range ((wcEtStalk B b).map (c k m ((Nat.le_add_right m (a b)).trans h1))) =
        Set.range ((wcEtStalk B b).map (c (m + a b) m (Nat.le_add_right m (a b)))) := by
    intro b k h1
    obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le ((Nat.le_add_right m (a b)).trans h1)
    apply Set.Finite.eq_of_subset_of_card_le (hfs b _)
    · exact hanti b (m + a b) (m + t) (Nat.le_add_right m (a b)) h1
    · exact ha b t

  obtain ⟨A, hA⟩ : ∃ A : ℕ, ∀ b ∈ E, a b ≤ A :=
    ⟨hE.toFinset.sup a, fun b hb => Finset.le_sup (f := a) (hE.mem_toFinset.mpr hb)⟩

  have key : ∃ m', ∃ hm : m ≤ m', ∀ (b : B) (k : ℕ) (hk : m' ≤ k),
      Set.range ((wcEtStalk B b).map (c k m (hm.trans hk))) =
        Set.range ((wcEtStalk B b).map (c m' m hm)) := by
    by_cases hη : ∃ η, η ∉ E
    · obtain ⟨η, hηE⟩ := hη
      refine ⟨m + A + a η, by omega, ?_⟩
      intro b k hk
      by_cases hb : b ∈ E
      · have hab := hA b hb
        exact (hstab1 b k (by omega)).trans (hstab1 b (m + A + a η) (by omega)).symm
      · apply Set.Finite.eq_of_subset_of_card_le (hfs b _)
        · exact hanti b (m + A + a η) k (by omega) hk
        · have e1 := hcard b η hb hηE (m + A + a η) (by omega)
          have e2 := congrArg (fun s : Set ((wcEtStalk B η).obj (L m)) => Nat.card s)
            (hstab1 η (m + A + a η) (by omega))
          have e3 := congrArg (fun s : Set ((wcEtStalk B η).obj (L m)) => Nat.card s)
            (hstab1 η k (by omega))
          have e4 := hcard b η hb hηE k (by omega)
          exact le_of_eq (e1.trans (e2.trans (e3.symm.trans e4.symm)))
    · push_neg at hη
      refine ⟨m + A, by omega, ?_⟩
      intro b k hk
      have hab := hA b (hη b)
      exact (hstab1 b k (by omega)).trans (hstab1 b (m + A) (by omega)).symm

  obtain ⟨m', hm, hstab⟩ := key
  refine ⟨m', hm, fun k hk => ?_⟩
  rw [← hcoc k m' m hm hk]
  apply le_antisymm (Limits.imageSubobject_comp_le _ _)
  have hrange : ∀ b : B, Set.range ((wcEtStalk B b).map (c m' m hm)) ⊆
      Set.range ((wcEtStalk B b).map (Limits.imageSubobject (c k m' hk ≫ c m' m hm)).arrow) := by
    intro b y hy
    have hy' : y ∈ Set.range ((wcEtStalk B b).map (c k m (hm.trans hk))) := by
      rw [hstab b k hk]
      exact hy
    obtain ⟨x, rfl⟩ := hy'
    refine ⟨(wcEtStalk B b).map (Limits.factorThruImageSubobject (c k m' hk ≫ c m' m hm)) x, ?_⟩
    have e : (wcEtStalk B b).map (Limits.factorThruImageSubobject (c k m' hk ≫ c m' m hm)) ≫
        (wcEtStalk B b).map (Limits.imageSubobject (c k m' hk ≫ c m' m hm)).arrow =
        (wcEtStalk B b).map (c k m (hm.trans hk)) := by
      rw [← Functor.map_comp, Limits.imageSubobject_arrow_comp, hcoc]
    have := ConcreteCategory.congr_hom e x
    rw [CategoryTheory.comp_apply] at this
    exact this
  obtain ⟨φ, hφ⟩ := wc_et_mono_factor_of_stalk_range B
    (fun b => wc_et_geomstalk_cofiltered B b wc_etale_maps_agree_near_geom_point)
    wc_etale_lift_alg_closed_point wc_etale_jointly_surjective_covers
    (L m) _ (L m') (Limits.imageSubobject (c k m' hk ≫ c m' m hm)).arrow (c m' m hm)
    inferInstance hrange
  exact Limits.imageSubobject_le _ φ hφ

theorem wc_pencil_et_Rj_stalk_finite : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ¬ ℓ ∣ Nat.card F'' → ∀ [HasInjectiveResolutions (Sheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1})] (j k : ℕ) (b : (wcP1Over F'').left), Finite ((wcEtStalk (wcP1Over F'').left b).obj (((wcEtPush D.f).rightDerived j).obj ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))))) :=
by
  intro F' F'' _ _ _ _ Y n D ℓ _ hℓ _ j k b
  classical
  haveI : IsProper D.f := by
    haveI : IsProper (wcProjKStr F'' 1) := wc_proj_space_isProper F'' 1
    have h' : D.f ≫ wcProjKStr F'' 1 = D.Yt.hom := D.hf
    haveI : IsProper (D.f ≫ wcProjKStr F'' 1) := by
      rw [h']
      exact D.proper
    exact IsProper.of_comp D.f (wcProjKStr F'' 1)
  have hℓp : Nat.Prime ℓ := Fact.out
  have hm : ℓ ^ k ≠ 0 := pow_ne_zero k hℓp.ne_zero
  let I := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))
  have ι := I.isoRightDerivedObj (wcEtPush D.f) j
  obtain ⟨e₂⟩ := wc_et_proper_stalk_coh D.f (ℓ ^ k) hm wc_et_henselian_proper_vanishing I b j
  have hK : ((ℓ ^ k : ℕ) : AlgebraicClosure ((wcP1Over F'').left.residueField b)) ≠ 0 := by
    let φ : F'' →+* AlgebraicClosure ((wcP1Over F'').left.residueField b) :=
      (Spec.preimage (wcEtGeomPt (wcP1Over F'').left b ≫ (wcP1Over F'').hom)).hom
    have hp : Nat.Prime (ringChar F'') := CharP.char_is_prime F'' (ringChar F'')
    haveI : CharP (AlgebraicClosure ((wcP1Over F'').left.residueField b)) (ringChar F'') :=
      (RingHom.charP_iff_charP φ (ringChar F'')).mp (ringChar.charP F'')
    have hdvd : ringChar F'' ∣ Nat.card F'' := by
      letI := Fintype.ofFinite F''
      rw [Nat.card_eq_fintype_card]
      exact (ringChar.spec F'' _).mp (Nat.cast_card_eq_zero F'')
    intro h0
    rw [CharP.cast_eq_zero_iff _ (ringChar F'')] at h0
    have h1 := hp.dvd_of_dvd_pow h0
    have h2 := (Nat.prime_dvd_prime_iff_eq hp hℓp).mp h1
    exact hℓ (h2 ▸ hdvd)
  have hfin := wc_etale_proper_finite (AlgebraicClosure ((wcP1Over F'').left.residueField b)) _
    (Limits.pullback.snd D.f (wcEtGeomPt (wcP1Over F'').left b)) (ℓ ^ k) hK j
  have h2 : Finite ((wcEtStalk (wcP1Over F'').left b).obj
      ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology j)) :=
    Finite.of_equiv _ e₂.symm
  exact @Finite.of_equiv _ _ h2
    ((wcEtStalk (wcP1Over F'').left b).mapIso ι).addCommGroupIsoToAddEquiv.toEquiv.symm

theorem wc_pencil_f_smooth_off_crit : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n), ∃ U : (wcP1Over F'').left.Opens, (∀ x : (wcP1Over F'').left, x ∈ U ↔ ∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) ∧ Smooth (D.f ∣_ U) :=
by
  intro F' F'' _ _ _ Y n D

  have hcl : ∀ i, IsClosed (Set.range (D.S i)) := by
    intro i
    haveI : IsClosedImmersion (D.S i) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
    exact (D.S i).isClosedEmbedding.isClosed_range
  have hZ : IsClosed (⋃ i, Set.range (D.S i)) := isClosed_iUnion_of_finite hcl
  let U : (wcP1Over F'').left.Opens := ⟨(⋃ i, Set.range (D.S i))ᶜ, hZ.isOpen_compl⟩
  have hU : ∀ x : (wcP1Over F'').left, x ∈ U ↔ ∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro x
    show x ∈ (⋃ i, Set.range (D.S i))ᶜ ↔ _
    simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_range, not_exists]
    constructor
    · intro h i hx
      exact h i (IsLocalRing.closedPoint F'') hx.symm
    · intro h i w hw
      apply h i
      rw [← hw, Subsingleton.elim w (IsLocalRing.closedPoint F'')]
  refine ⟨U, hU, ?_⟩

  have hloc : ∀ y : D.Yt.left, D.f y ∈ U →
      ∃ O : D.Yt.left.Opens, y ∈ O ∧ Smooth (O.ι ≫ D.f) := by
    intro y hy
    apply D.smooth_off y
    intro i hyi
    apply (hU (D.f y)).1 hy i
    have e : (D.xs i ≫ D.f) (IsLocalRing.closedPoint F'') =
        D.S i (IsLocalRing.closedPoint F'') := by rw [D.hxs i]
    rw [hyi]
    refine Eq.trans ?_ e
    first
      | exact (Scheme.Hom.comp_apply _ _ _).symm
      | rfl
      | simp [Scheme.Hom.comp_apply]
  haveI : IsZariskiLocalAtSource @Smooth :=
    HasRingHomProperty.instIsZariskiLocalAtSource (P := @Smooth)
  haveI : IsZariskiLocalAtTarget @Smooth :=
    HasRingHomProperty.instIsZariskiLocalAtTarget @Smooth
  choose O hyO hO using fun y : (D.f ⁻¹ᵁ U).toScheme => hloc ((D.f ⁻¹ᵁ U).ι y) y.2
  have hcov : ⨆ y, (D.f ⁻¹ᵁ U).ι ⁻¹ᵁ O y = ⊤ := by
    rw [eq_top_iff]
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨z, hyO z⟩
  refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @Smooth) _ hcov (fun y => ?_)
  have hrange : Set.range ((((D.f ⁻¹ᵁ U).ι ⁻¹ᵁ O y).ι ≫ (D.f ⁻¹ᵁ U).ι)) ⊆
      Set.range (O y).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    exact z.2
  have hfac := IsOpenImmersion.lift_fac (O y).ι _ hrange
  haveI : IsOpenImmersion (IsOpenImmersion.lift (O y).ι _ hrange ≫ (O y).ι) := by
    rw [hfac]; infer_instance
  haveI : IsOpenImmersion (IsOpenImmersion.lift (O y).ι _ hrange) :=
    IsOpenImmersion.of_comp _ (O y).ι
  have hcomp : Smooth ((((D.f ⁻¹ᵁ U).ι ⁻¹ᵁ O y).ι ≫ D.f ∣_ U) ≫ U.ι) := by
    have e : (((D.f ⁻¹ᵁ U).ι ⁻¹ᵁ O y).ι ≫ D.f ∣_ U) ≫ U.ι =
        IsOpenImmersion.lift (O y).ι _ hrange ≫ ((O y).ι ≫ D.f) := by
      rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, ← Category.assoc, hfac]
    rw [e]
    exact IsZariskiLocalAtSource.comp (hO y) _
  have hpb : IsPullback (𝟙 _) (((D.f ⁻¹ᵁ U).ι ⁻¹ᵁ O y).ι ≫ D.f ∣_ U)
      ((((D.f ⁻¹ᵁ U).ι ⁻¹ᵁ O y).ι ≫ D.f ∣_ U) ≫ U.ι) U.ι :=
    IsPullback.of_horiz_isIso_mono ⟨by rw [Category.id_comp]⟩
  exact IsZariskiLocalAtTarget.of_isPullback hpb hcomp

theorem wc_pencil_et_Rj_cospec_iso : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ¬ ℓ ∣ Nat.card F'' → ∀ [HasInjectiveResolutions (Sheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1})] (j : ℕ) (b b' : (wcP1Over F'').left), (∀ i, b ≠ D.S i (IsLocalRing.closedPoint F'')) → (∀ i, b' ≠ D.S i (IsLocalRing.closedPoint F'')) → ∃ θ : ∀ k : ℕ, (wcEtStalk (wcP1Over F'').left b).obj (((wcEtPush D.f).rightDerived j).obj ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))) ≅ (wcEtStalk (wcP1Over F'').left b').obj (((wcEtPush D.f).rightDerived j).obj ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))), ∀ (k m : ℕ) (h : m ≤ k), (wcEtStalk (wcP1Over F'').left b).map (((wcEtPush D.f).rightDerived j).map ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).map (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp ((ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom))))) ≫ (θ m).hom = (θ k).hom ≫ (wcEtStalk (wcP1Over F'').left b').map (((wcEtPush D.f).rightDerived j).map ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).map (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp ((ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom.comp AddEquiv.ulift.toAddMonoidHom))))) :=
by
  intro F' F'' _ _ _ _ Y n D ℓ _ hℓ _ j b b' hb hb'
  classical

  haveI : IsProper D.f := by
    haveI : IsProper (wcProjKStr F'' 1) := wc_proj_space_isProper F'' 1
    have h' : D.f ≫ wcProjKStr F'' 1 = D.Yt.hom := D.hf
    haveI : IsProper (D.f ≫ wcProjKStr F'' 1) := by
      rw [h']
      exact D.proper
    exact IsProper.of_comp D.f (wcProjKStr F'' 1)
  haveI : IrreducibleSpace ↥(wcP1Over F'').left := wc_proj_space_irreducible F'' 1
  obtain ⟨η, hη⟩ : ∃ η : (wcP1Over F'').left, ∀ x : (wcP1Over F'').left, η ⤳ x :=
    ⟨genericPoint _, fun x => (genericPoint_spec _).specializes (Set.mem_univ x)⟩
  obtain ⟨U, hU, hsm⟩ := wc_pencil_f_smooth_off_crit F' F'' Y n D

  have hF0 : ∀ k : ℕ, ((ℓ ^ k : ℕ) : F'') ≠ 0 := by
    intro k h0
    letI := Fintype.ofFinite F''
    have hd : ringChar F'' ∣ ℓ ^ k := (ringChar.spec F'' (ℓ ^ k)).1 h0
    obtain ⟨nn, hp, hcard⟩ := FiniteField.card F'' (ringChar F'')
    have hpl : ringChar F'' ∣ ℓ := Nat.Prime.dvd_of_dvd_pow hp hd
    have hpl' : ringChar F'' = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hpl).resolve_left (Nat.Prime.ne_one hp)
    apply hℓ
    rw [← hpl', Nat.card_eq_fintype_card, hcard]
    exact dvd_pow_self _ (PNat.ne_zero nn)

  have key : ∀ c : (wcP1Over F'').left, c ∈ U →
      ∃ sp : wcEtStalk (wcP1Over F'').left c ⟶ wcEtStalk (wcP1Over F'').left η, ∀ k : ℕ,
        IsIso (sp.app (((wcEtPush D.f).rightDerived j).obj
          ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))))) := by
    intro c hc
    obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, he, hpt⟩ :=
      wc_et_geom_strict_henselization c
    obtain ⟨ξ, hξ⟩ := wc_shens_geom_point_over_generalization c η (hη c) A Λ W' φ a haff hφ hφa hlim
    have hlift : ∀ l, (ξ ≫ φ l) ≫ (W'.obj l).right.hom = wcEtGeomPt (wcP1Over F'').left η :=
      fun l => (Category.assoc _ _ _).trans ((congrArg (fun k => ξ ≫ k) (hφa l)).trans hξ)
    have hcompat : ∀ {l l' : Λ} (t : l ⟶ l'), (ξ ≫ φ l) ≫ (W'.map t).right.left = ξ ≫ φ l' :=
      fun t => (Category.assoc _ _ _).trans (congrArg (fun k => ξ ≫ k) (hφ t))
    obtain ⟨sp, hsp⟩ := wc_et_cospec_stalk_nat _ c η Λ W' hinit (fun l => ξ ≫ φ l) hlift hcompat
    refine ⟨sp, fun k => ?_⟩

    have hac : a (IsLocalRing.closedPoint A) = c := by
      have h1 := congrArg (fun g => g (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over F'').left.residueField c)))) hpt
      have hres : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
          ((Spec.map (CommRingCat.ofHom e)) (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField c)))) =
          IsLocalRing.closedPoint A := by
        first
          | exact (Spec.map_apply _ _).trans (IsLocalRing.PrimeSpectrum.comap_residue A _)
          | exact IsLocalRing.PrimeSpectrum.comap_residue A _
      have h2 : a ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
          ((Spec.map (CommRingCat.ofHom e)) (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField c))))) = c := by
        refine h1.trans ?_
        first
          | exact Scheme.fromSpecResidueField_apply c _
          | exact Scheme.fromSpecResidueField_apply (X := (wcP1Over F'').left) c
              ((Spec.map (CommRingCat.ofHom (algebraMap ((wcP1Over F'').left.residueField c)
                (AlgebraicClosure ((wcP1Over F'').left.residueField c))))) (IsLocalRing.closedPoint
                  (AlgebraicClosure ((wcP1Over F'').left.residueField c))))
          | simp [Scheme.Hom.comp_apply, wcEtGeomPt]
      rw [hres] at h2
      exact h2
    have hrange : Set.range a ⊆ (U : Set (wcP1Over F'').left) := by
      rintro _ ⟨p, rfl⟩
      have hsp' : a p ⤳ c := by
        rw [← hac]
        exact (IsLocalRing.specializes_closedPoint p).map a.continuous
      exact hsp'.mem_open U.isOpen hc
    have hsm1 : Smooth (Limits.pullback.snd (Limits.pullback.snd D.f a) (𝟙 _)) :=
      wc_smooth_restrict_base_change _ _ _ _ D.f U hsm a (𝟙 _)
        (by rw [Category.id_comp]; exact hrange)
    have hsm2 : Smooth (Limits.pullback.snd D.f a) := by
      have e1 : Limits.pullback.snd D.f a =
          inv (Limits.pullback.fst (Limits.pullback.snd D.f a) (𝟙 _)) ≫
            Limits.pullback.snd (Limits.pullback.snd D.f a) (𝟙 _) := by
        rw [IsIso.eq_inv_comp, Limits.pullback.condition, Category.comp_id]
      rw [e1]
      haveI := hsm1
      infer_instance
    haveI : IsProper (Limits.pullback.snd D.f a) := by
      first
        | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback D.f a)
            ‹IsProper D.f›
        | infer_instance
    have hunit : IsUnit ((ℓ ^ k : ℕ) : A) := by
      have := (isUnit_iff_ne_zero.mpr (hF0 k)).map (Spec.preimage (a ≫ (wcP1Over F'').hom)).hom
      rwa [map_natCast] at this
    have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
    have HSPBC := wc_smooth_proper_shens_pull_bij A (Limits.pullback D.f a)
      (Limits.pullback.snd D.f a) hsm2 (ℓ ^ k) hunit
      (AlgebraicClosure ((wcP1Over F'').left.residueField η)) ξ
    obtain ⟨hS, hK⟩ := wc_et_push_Rj_cospec_germ_of_pull_bij D.f (ℓ ^ k) hm0 j c η A Λ W' φ a e
      hinit haff hφ hφa hlim he hpt ξ hξ HSPBC
    exact wc_et_cospec_isIso_of_germ _ c η Λ W' hinit (fun l => ξ ≫ φ l) hlift _ _
      (hsp _) hS hK

  obtain ⟨spb, hspb⟩ := key b ((hU b).2 hb)
  obtain ⟨spb', hspb'⟩ := key b' ((hU b').2 hb')
  refine ⟨fun k => @asIso _ _ _ _ (spb.app _) (hspb k) ≪≫
    (@asIso _ _ _ _ (spb'.app _) (hspb' k)).symm, ?_⟩
  intro k m h
  haveI := hspb k
  haveI := hspb m
  haveI := hspb' k
  haveI := hspb' m
  simp only [Iso.trans_hom, Iso.symm_hom, asIso_hom, asIso_inv]
  rw [← Category.assoc, spb.naturality, Category.assoc, Category.assoc]
  congr 1
  rw [IsIso.eq_inv_comp, ← Category.assoc, ← spb'.naturality, Category.assoc, IsIso.hom_inv_id,
    Category.comp_id]

theorem wc_pencil_Rq_tower_ML (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (j m : ℕ), ∃ m', ∃ hm : m ≤ m', ∀ (k : ℕ) (hk : m' ≤ k),
      Limits.imageSubobject (((wcProEtPush D.f).rightDerived j).map (wcContSheafMap D.Yt.left
        (ZMod.castHom (pow_dvd_pow ℓ (hm.trans hk)) (ZMod (ℓ ^ m))).toAddMonoidHom
        continuous_of_discreteTopology)) =
      Limits.imageSubobject (((wcProEtPush D.f).rightDerived j).map (wcContSheafMap D.Yt.left
        (ZMod.castHom (pow_dvd_pow ℓ hm) (ZMod (ℓ ^ m))).toAddMonoidHom
        continuous_of_discreteTopology)) :=
by
  classical
  intro j m

  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives D.Yt.left
  haveI : IsProper D.f := by
    haveI : IsProper (wcProjKStr F'' 1) := wc_proj_space_isProper F'' 1
    have h' : D.f ≫ wcProjKStr F'' 1 = D.Yt.hom := D.hf
    haveI : IsProper (D.f ≫ wcProjKStr F'' 1) := by
      rw [h']
      exact D.proper
    exact IsProper.of_comp D.f (wcProjKStr F'' 1)

  have hE : (Set.range (fun i : Fin D.m => D.S i (IsLocalRing.closedPoint F''))).Finite :=
    Set.finite_range _
  have hcard : ∀ b b' : (wcP1Over F'').left,
      b ∉ Set.range (fun i : Fin D.m => D.S i (IsLocalRing.closedPoint F'')) →
      b' ∉ Set.range (fun i : Fin D.m => D.S i (IsLocalRing.closedPoint F'')) →
      ∀ (k : ℕ) (hk : m ≤ k),
      Nat.card (Set.range ((wcEtStalk (wcP1Over F'').left b).map
        (((wcEtPush D.f).rightDerived j).map
          ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).map
            (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
              ((ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ m))).toAddMonoidHom.comp
                AddEquiv.ulift.toAddMonoidHom))))))) =
      Nat.card (Set.range ((wcEtStalk (wcP1Over F'').left b').map
        (((wcEtPush D.f).rightDerived j).map
          ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).map
            (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
              ((ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ m))).toAddMonoidHom.comp
                AddEquiv.ulift.toAddMonoidHom))))))) := by
    intro b b' hb hb' k hk
    have hbS : ∀ i, b ≠ D.S i (IsLocalRing.closedPoint F'') := fun i h => hb ⟨i, h.symm⟩
    have hbS' : ∀ i, b' ≠ D.S i (IsLocalRing.closedPoint F'') := fun i h => hb' ⟨i, h.symm⟩
    obtain ⟨θ, hθ⟩ := wc_pencil_et_Rj_cospec_iso F' F'' Y n D ℓ hℓ j b b' hbS hbS'
    have cardT : ∀ {A₁ B₁ A₂ B₂ : AddCommGrpCat.{u+1}} (f₁ : A₁ ⟶ B₁) (f₂ : A₂ ⟶ B₂)
        (θA : A₁ ≅ A₂) (θB : B₁ ≅ B₂), f₁ ≫ θB.hom = θA.hom ≫ f₂ →
        Nat.card (Set.range f₁) = Nat.card (Set.range f₂) := by
      intro A₁ B₁ A₂ B₂ f₁ f₂ θA θB h
      have hr : Set.range f₂ = θB.hom '' Set.range f₁ := by
        ext z
        constructor
        · rintro ⟨w, rfl⟩
          refine ⟨f₁ (θA.inv w), ⟨_, rfl⟩, ?_⟩
          have e := ConcreteCategory.congr_hom h (θA.inv w)
          simp only [CategoryTheory.comp_apply, Iso.inv_hom_id_apply] at e
          exact e
        · rintro ⟨_, ⟨w, rfl⟩, rfl⟩
          refine ⟨θA.hom w, ?_⟩
          have e := ConcreteCategory.congr_hom h w
          simp only [CategoryTheory.comp_apply] at e
          exact e.symm
      rw [hr, Nat.card_image_of_injective (ConcreteCategory.bijective_of_isIso θB.hom).1]
    exact cardT _ _ (θ k) (θ m) (hθ k m hk)

  let L : ℕ → Sheaf (Scheme.smallEtaleTopology (wcP1Over F'').left) AddCommGrpCat.{u+1} :=
    fun k => ((wcEtPush D.f).rightDerived j).obj
      ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))
  let c : ∀ k m, m ≤ k → (L k ⟶ L m) := fun k m h => ((wcEtPush D.f).rightDerived j).map
      ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left) AddCommGrpCat.{u+1}).map
        (AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
          ((ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom.comp
            AddEquiv.ulift.toAddMonoidHom))))
  have hcoc' : ∀ k i m (h1 : m ≤ i) (h2 : i ≤ k), c k i h2 ≫ c i m h1 = c k m (h1.trans h2) := by
    intro k i m h1 h2
    have hκ : AddCommGrpCat.ofHom.{u+1} (AddEquiv.ulift.symm.toAddMonoidHom.comp
          ((ZMod.castHom (pow_dvd_pow ℓ h2) (ZMod (ℓ ^ i))).toAddMonoidHom.comp
            AddEquiv.ulift.toAddMonoidHom)) ≫
        AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
          ((ZMod.castHom (pow_dvd_pow ℓ h1) (ZMod (ℓ ^ m))).toAddMonoidHom.comp
            AddEquiv.ulift.toAddMonoidHom)) =
        AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
          ((ZMod.castHom (pow_dvd_pow ℓ (h1.trans h2)) (ZMod (ℓ ^ m))).toAddMonoidHom.comp
            AddEquiv.ulift.toAddMonoidHom)) := by
      ext x
      exact RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow ℓ h1) (pow_dvd_pow ℓ h2)) x.down
    simp only [c]
    rw [← Functor.map_comp, ← Functor.map_comp, hκ]
  have hfin : ∀ b : (wcP1Over F'').left, Finite ((wcEtStalk (wcP1Over F'').left b).obj (L m)) := by
    intro b
    simp only [L]
    exact wc_pencil_et_Rj_stalk_finite F' F'' Y n D ℓ hℓ j m b
  have hcard' : ∀ b b' : (wcP1Over F'').left,
      b ∉ Set.range (fun i : Fin D.m => D.S i (IsLocalRing.closedPoint F'')) →
      b' ∉ Set.range (fun i : Fin D.m => D.S i (IsLocalRing.closedPoint F'')) →
      ∀ (k : ℕ) (hk : m ≤ k),
      Nat.card (Set.range ((wcEtStalk (wcP1Over F'').left b).map (c k m hk))) =
      Nat.card (Set.range ((wcEtStalk (wcP1Over F'').left b').map (c k m hk))) := by
    intro b b' hb hb' k hk
    simp only [c, L]
    exact hcard b b' hb hb' k hk
  obtain ⟨m', hm, hML⟩ := wc_et_tower_ML_of_stalk_card (wcP1Over F'').left L c hcoc' m hfin
    _ hE hcard'
  refine ⟨m', hm, fun k hk => ?_⟩

  have transport : ∀ {X₀ Z₀ : Sheaf (Scheme.smallEtaleTopology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {A W : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (a : X₀ ⟶ Z₀) (α₀ : A ≅ (wcEpsInv (wcP1Over F'').left).obj X₀)
      (ω : W ≅ (wcEpsInv (wcP1Over F'').left).obj Z₀) (a' : A ⟶ W),
      a' ≫ ω.hom = α₀.hom ≫ (wcEpsInv (wcP1Over F'').left).map a →
      Limits.imageSubobject a' = Limits.imageSubobject
        ((wcEpsInv (wcP1Over F'').left).map (Limits.imageSubobject a).arrow ≫ ω.inv) := by
    intro X₀ Z₀ A W a α₀ ω a' h
    haveI : Mono ((wcEpsInv (wcP1Over F'').left).map (Limits.imageSubobject a).arrow) :=
      (wc_epsInv_preserves_mono_epi _ _).1 inferInstance
    haveI : Epi ((wcEpsInv (wcP1Over F'').left).map (Limits.factorThruImageSubobject a)) :=
      (wc_epsInv_preserves_mono_epi _ _).2 inferInstance
    haveI : StrongEpi (α₀.hom ≫ (wcEpsInv (wcP1Over F'').left).map
        (Limits.factorThruImageSubobject a)) := strongEpi_of_epi _
    have comm : (α₀.hom ≫ (wcEpsInv (wcP1Over F'').left).map (Limits.factorThruImageSubobject a)) ≫
        ((wcEpsInv (wcP1Over F'').left).map (Limits.imageSubobject a).arrow ≫ ω.inv) = a' := by
      have h2 : (wcEpsInv (wcP1Over F'').left).map (Limits.factorThruImageSubobject a) ≫
          (wcEpsInv (wcP1Over F'').left).map (Limits.imageSubobject a).arrow =
          (wcEpsInv (wcP1Over F'').left).map a := by
        rw [← Functor.map_comp, Limits.imageSubobject_arrow_comp]
      calc _ = α₀.hom ≫ ((wcEpsInv (wcP1Over F'').left).map (Limits.factorThruImageSubobject a) ≫
            (wcEpsInv (wcP1Over F'').left).map (Limits.imageSubobject a).arrow) ≫ ω.inv := by
              simp only [Category.assoc]
        _ = α₀.hom ≫ (wcEpsInv (wcP1Over F'').left).map a ≫ ω.inv := by rw [h2]
        _ = a' := by
          rw [← Category.assoc, ← h, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have e1 := Subobject.mk_eq_mk_of_comm _ _ (Limits.image.isoStrongEpiMono _ _ comm)
      (Limits.image.isoStrongEpiMono_hom_comp_ι _ _ comm)
    have e2 := Subobject.mk_eq_mk_of_comm _ _
      (Limits.image.isoStrongEpiMono (𝟙 _)
        ((wcEpsInv (wcP1Over F'').left).map (Limits.imageSubobject a).arrow ≫ ω.inv)
        (Category.id_comp _))
      (Limits.image.isoStrongEpiMono_hom_comp_ι _ _ (Category.id_comp _))
    exact e1.symm.trans e2
  have key : ∀ {X₀ X₁ Z₀ : Sheaf (Scheme.smallEtaleTopology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {A A' W : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (a : X₀ ⟶ Z₀) (b : X₁ ⟶ Z₀) (α₀ : A ≅ (wcEpsInv (wcP1Over F'').left).obj X₀)
      (α₁ : A' ≅ (wcEpsInv (wcP1Over F'').left).obj X₁)
      (ω : W ≅ (wcEpsInv (wcP1Over F'').left).obj Z₀) (a' : A ⟶ W) (b' : A' ⟶ W),
      a' ≫ ω.hom = α₀.hom ≫ (wcEpsInv (wcP1Over F'').left).map a →
      b' ≫ ω.hom = α₁.hom ≫ (wcEpsInv (wcP1Over F'').left).map b →
      Limits.imageSubobject a = Limits.imageSubobject b →
      Limits.imageSubobject a' = Limits.imageSubobject b' := by
    intro X₀ X₁ Z₀ A A' W a b α₀ α₁ ω a' b' ha hb hab
    refine (transport a α₀ ω a' ha).trans (Eq.trans ?_ (transport b α₁ ω b' hb).symm)
    exact congrArg (fun P : Subobject Z₀ => Limits.imageSubobject
      ((wcEpsInv (wcP1Over F'').left).map P.arrow ≫ ω.inv)) hab
  obtain ⟨α, hα⟩ := wc_proet_push_rightDerived_contSheaf_epsInv_nat D.f j
  exact key (c k m (hm.trans hk)) (c m' m hm) (α (ℓ ^ k)) (α (ℓ ^ m')) (α (ℓ ^ m)) _ _
    (hα (ℓ ^ m) (ℓ ^ k) (pow_dvd_pow ℓ (hm.trans hk)))
    (hα (ℓ ^ m) (ℓ ^ m') (pow_dvd_pow ℓ hm)) (hML k hk)

theorem wc_rightDerived_nsmul_eq_zero : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (F : C ⥤ D) [F.Additive] (m q : ℕ) (X : C), m • 𝟙 X = 0 → m • 𝟙 ((F.rightDerived q).obj X) = 0 :=
by
  intro C D _ _ _ _ _ F _ m q X hX
  obtain ⟨P, hP⟩ : ∃ P : InjectiveResolution X, P = injectiveResolution X := ⟨_, rfl⟩
  have hc1 : P.ι ≫ (m • 𝟙 P.cocomplex) = (CochainComplex.single₀ C).map (m • 𝟙 X) ≫ P.ι := by
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.comp_nsmul,
      Category.comp_id, Preadditive.nsmul_comp, Category.id_comp]
  have hc2 : P.ι ≫ (0 : P.cocomplex ⟶ P.cocomplex) = (CochainComplex.single₀ C).map (m • 𝟙 X) ≫ P.ι := by
    rw [hX, CategoryTheory.Functor.map_zero, Limits.comp_zero, Limits.zero_comp]
  have h1 := F.rightDerived_map_eq q (m • 𝟙 X) (m • 𝟙 P.cocomplex) hc1
  have h2 := F.rightDerived_map_eq q (m • 𝟙 X) (0 : P.cocomplex ⟶ P.cocomplex) hc2
  have h3 := h1.symm.trans h2
  rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
    CategoryTheory.Functor.map_zero, Limits.zero_comp, Limits.comp_zero,
    Preadditive.nsmul_comp] at h3
  erw [Category.id_comp] at h3
  rw [Preadditive.comp_nsmul, Iso.hom_inv_id] at h3
  exact h3

theorem wc_proet_Rq_push_torsion_epsInv : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsProper g] (m q : ℕ), ∃ H : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}, m • 𝟙 H = 0 ∧ Nonempty (((wcProEtPush g).rightDerived q).obj (wcContSheaf X (ZMod m)) ≅ (wcEpsInv B).obj H) :=
by
  intro X B g _ m q
  haveI := wc_et_enough_injectives X
  haveI := wc_et_enough_injectives B
  have hexact : ∀ S : Scheme.{u},
      (wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) ∧
      (wcEpsInv S).Additive ∧ Limits.PreservesFiniteLimits (wcEpsInv S) ∧
      Limits.PreservesFiniteColimits (wcEpsInv S) := by
    intro S
    obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont S
    haveI := hlim
    haveI := hcont
    haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt S)
    let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
    haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv S) := by
      haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt S)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
      exact Limits.preservesFiniteLimits_of_natIso
        (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt S)
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)) adj)
    haveI hladj : (wcEpsInv S).IsLeftAdjoint := adj.isLeftAdjoint
    haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv S) := by
      haveI := adj.leftAdjoint_preservesColimits.{0, 0}
      exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
    haveI : (wcEpsInv S).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    exact ⟨hcont, Functor.additive_of_preserves_binary_products _, hpl, hpc⟩
  obtain ⟨hcX, haX, hlX, hcolX⟩ := hexact X
  obtain ⟨hcB, haB, hlB, hcolB⟩ := hexact B
  obtain ⟨β⟩ := wc_epsInv_push_base_change g
  have hacyc : ∀ (I : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) [Injective I]
      (n : ℕ), Limits.IsZero (((wcProEtPush g).rightDerived (n + 1)).obj ((wcEpsInv X).obj I)) := by
    intro I _ n
    apply wc_proet_push_rightDerived_zero_of_local
    intro U
    refine GrothendieckTopology.superset_covering _ ?_ (wc_proet_affIndEt_covering B U)
    apply Sieve.generate_mono
    rintro T f ⟨A, hA, hT⟩
    exact fun e => wc_proet_push_epsInv_injective_affine_vanishing g A hA T hT I n e
  obtain ⟨Φ⟩ := wc_rightDerived_exact_conj_iso (wcEtPush g) (wcProEtPush g) (wcEpsInv X)
    (wcEpsInv B) ⟨β⟩ hacyc
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q
  obtain ⟨c₁⟩ := wc_contSheaf_discrete_const X (ZMod m)
  obtain ⟨c₂⟩ := wc_epsInv_const X (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
  have h0 : m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
    ext x
    first
      | (simp [nsmul_eq_mul]; done)
      | (change (m • x).down = (0 : ULift.{u+1} (ZMod m)).down
         simp [nsmul_eq_mul])
  have htorΛ : m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
    rw [← (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map_id,
      ← Functor.map_nsmul, h0, Functor.map_zero]
  exact ⟨_, wc_rightDerived_nsmul_eq_zero (wcEtPush g) m q _ htorΛ,
    ⟨((wcProEtPush g).rightDerived q).mapIso (c₁ ≪≫ c₂.symm) ≪≫ Φ⟩⟩

theorem wc_ext_free_slice_epsInv_torsion : ∀ (S : Scheme.{u}) (U : S.ProEt) (m : ℕ) (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}), m • 𝟙 H = 0 → ∃ H' : Sheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}, m • 𝟙 H' = 0 ∧ ∀ i : ℕ, Nonempty (Abelian.Ext (wcFreeSheaf S U) ((wcEpsInv S).obj H) i ≃ Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ((wcEpsInv U.left).obj H') i) :=
by

  have hflat : ∀ (Y : Scheme.{u}), Limits.PreservesFiniteLimits (wcEtToProEt Y) ∧
      (wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) := by
    intro Y
    haveI h1 : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
        (Scheme.ProEt.forget Y)
        (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
    have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
        (wcEtToProEt Y) := by
      refine ⟨fun {V} {R} hR => ?_⟩
      obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
      have hP : Presieve.map (wcEtToProEt Y) (@Scheme.Cover.toPresieveOverProp _ _ _ _ _ 𝒰 h₁ h) ∈
          (Scheme.ProEt.precoverage Y).coverings ((wcEtToProEt Y).obj V) :=
        Precoverage.mem_comap_iff.2
          ((congrArg (· ∈ Scheme.proetalePrecoverage.coverings V.left)
              ((congrArg (Presieve.map (Scheme.ProEt.forget Y ⋙ Over.forget Y))
                (Presieve.map_ofArrows (F := wcEtToProEt Y) _)).trans
                (Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) _))).mpr
            (Scheme.etalePrecoverage_le_proetalePrecoverage _ 𝒰.mem₀))
      have hgen := Precoverage.generate_mem_toGrothendieck hP
      refine GrothendieckTopology.superset_covering _ ?_ hgen
      rw [Sieve.generate_le_iff]
      intro W f hf
      cases hf with
