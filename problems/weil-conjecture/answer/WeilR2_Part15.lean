          (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero k) :=
      (Abelian.Ext.comp_assoc _ _ _ (zero_add k) (add_zero k) (by omega)).symm
    rw [h1, h3, hRs]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add k) (add_zero k) (by omega)).symm
  ·
    intro y
