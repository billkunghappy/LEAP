  have extMk_congr : ∀ {X : C} {m : ℕ} {h h' : X ⟶ I.cocomplex.X m} (_ : h = h')
      (hh : h ≫ I.cocomplex.d m (m + 1) = 0) (hh' : h' ≫ I.cocomplex.d m (m + 1) = 0),
      I.extMk h (m + 1) rfl hh = I.extMk h' (m + 1) rfl hh' := by
    intro X m h h' e hh hh'
    subst e
    rfl


  have hstep : ∀ (n j t : ℕ) (h1 : j + (n + 1) = t) (h2 : j + 1 + n = t)
      (x : Abelian.Ext A (Limits.image (R.map (g n))) j) (Z : Abelian.Ext (L.obj A) B t),
      (τ (Y (n + 1)) j (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero j))).comp
        (I.extMk (f (n + 1)) (n + 1 + 1) rfl (hfd (n + 1))) h1 = Z →
      ∃ v : Abelian.Ext A (R.obj (Y n)) (j + 1),
        (τ (Y n) (j + 1) v).comp (I.extMk (f n) (n + 1) rfl (hfd n)) h2 = Z := by
    intro n j t h1 h2 x Z hZ
    have e2 : (τ (Y n) (j + 1) (x.comp (hT n).extClass rfl)).comp
        (I.extMk (f n) (n + 1) rfl (hfd n)) h2 =
        (τ (Y (n + 1)) j (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero j))).comp
          ((hS n).extClass.comp (I.extMk (f n) (n + 1) rfl (hfd n)) (add_comm 1 n)) h1 := by
      rw [s1b' n j x, Abelian.Ext.comp_assoc _ _ _ rfl (add_comm 1 n) h2]
    rcases urec n with hu | hu
    · refine ⟨x.comp (hT n).extClass rfl, ?_⟩
      rw [e2, hu]
      exact hZ
    · refine ⟨-(x.comp (hT n).extClass rfl), ?_⟩
      rw [map_neg, Abelian.Ext.neg_comp, e2, hu, Abelian.Ext.comp_neg, neg_neg]
      exact hZ

  have hc₀ : (μ.hom ≫ c) ≫ I.cocomplex.d (M + 1) (M + 1 + 1) = 0 := by
    rw [Category.assoc, hc, Limits.comp_zero]


  have claim : ∀ j, 1 ≤ j → ∀ n (hn : n + j = M + 1), ∃ v : Abelian.Ext A (R.obj (Y n)) j,
      (τ (Y n) j v).comp (I.extMk (f n) (n + 1) rfl (hfd n)) (by omega) =
        I.extMk (μ.hom ≫ c) (M + 1 + 1) rfl hc₀ := by
    intro j hj
    induction j, hj using Nat.le_induction with
    | base =>
      intro n hn
      obtain rfl : M = n := by omega
      obtain ⟨c', hc'⟩ := hlift (M + 1) c hc
      have hβ : adj.homEquiv _ _ (μ.hom ≫ c') ≫ Limits.cokernel.π (R.map (g M)) = 0 :=
        hκlift M (adj.homEquiv _ _ (μ.hom ≫ c')) (adj.homEquiv _ _ (μ.hom ≫ c)) hf
          (by rw [← Adjunction.homEquiv_naturality_right, Category.assoc, hc']) hκ
      have h0 : (Abelian.Ext.mk₀ (adj.homEquiv _ _ (μ.hom ≫ c'))).comp
          (Abelian.Ext.mk₀ (Limits.cokernel.π (R.map (g M)))) (add_zero 0) = 0 := by
        rw [Abelian.Ext.mk₀_comp_mk₀, hβ, Abelian.Ext.mk₀_zero]
      obtain ⟨x₀, hx₀⟩ : ∃ x₀ : Abelian.Ext A (Limits.image (R.map (g M))) 0,
          x₀.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g M)))) (add_zero 0) =
            Abelian.Ext.mk₀ (adj.homEquiv _ _ (μ.hom ≫ c')) :=
        Abelian.Ext.covariant_sequence_exact₂ A (hU M) _ h0
      have hcu : L.map ((adj.homEquiv A (Y (M + 1))) (μ.hom ≫ c')) ≫ adj.counit.app (Y (M + 1)) =
          μ.hom ≫ c' := by
        have := adj.homEquiv_counit A (Y (M + 1)) ((adj.homEquiv A (Y (M + 1))) (μ.hom ≫ c'))
        rw [Equiv.symm_apply_apply] at this
        exact this.symm
      obtain ⟨v, hv⟩ := hstep M 0 (M + 1) (by omega) (by omega) x₀
        (I.extMk (μ.hom ≫ c) (M + 1 + 1) rfl hc₀) (by
          rw [hx₀, hτ, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
          erw [hcu]
          rw [InjectiveResolution.mk₀_comp_extMk]
          exact extMk_congr (by rw [Category.assoc, hc']) _ _)
      exact ⟨v, hv⟩
    | succ j hj ih =>
      intro n hn
      obtain ⟨v', hv'⟩ := ih (n + 1) (by omega)
      haveI := hQ n j (by omega)
      have h0 : v'.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (R.map (g n)))) (add_zero j) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨x, hx⟩ : ∃ x : Abelian.Ext A (Limits.image (R.map (g n))) j,
          x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero j) = v' :=
        Abelian.Ext.covariant_sequence_exact₂ A (hU n) v' h0
      exact hstep n j (M + 1) (by omega) (by omega) x (I.extMk (μ.hom ≫ c) (M + 1 + 1) rfl hc₀)
        (by rw [hx]; exact hv')


  obtain ⟨v₀, hv₀⟩ := claim (M + 1) (by omega) 0 (by omega)
  obtain ⟨ρ, hρ⟩ : ∃ ρ : Y 0 ⟶ B, Abelian.Ext.mk₀ ρ = I.extMk (f 0) (0 + 1) rfl (hfd 0) :=
    ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply _⟩
  have hw : τ B (M + 1) (v₀.comp (Abelian.Ext.mk₀ (R.map ρ)) (add_zero (M + 1))) =
      I.extMk (μ.hom ≫ c) (M + 1 + 1) rfl hc₀ := by
    rw [s1a, hρ]
    exact hv₀
  obtain ⟨y₀, hy₀⟩ := (H1 (M + 1)).2 (v₀.comp (Abelian.Ext.mk₀ (R.map ρ)) (add_zero (M + 1)))
  have hy₀' : y₀.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero (M + 1)) =
      v₀.comp (Abelian.Ext.mk₀ (R.map ρ)) (add_zero (M + 1)) := hy₀
  have hfinal : (Abelian.Ext.mapExactFunctor L y₀).comp (Abelian.Ext.mk₀ μ.hom) (add_zero (M + 1)) =
      I.extMk (μ.hom ≫ c) (M + 1 + 1) rfl hc₀ := by
    rw [← hw, ← hy₀', hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero (M + 1)) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, key]
  refine ⟨y₀, ?_⟩
  show (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L y₀).comp
      (Abelian.Ext.mk₀ μ.hom) (add_zero (M + 1))) (zero_add (M + 1)) = I.extMk c (M + 1 + 1) rfl hc
  rw [hfinal, InjectiveResolution.mk₀_comp_extMk]
  exact extMk_congr (Iso.inv_hom_id_assoc μ c) _ _

theorem wc_et_inj_res_pull_zero_local_coboundary : ∀ {S : Scheme.{u}} (m : ℕ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing S m))) (N : ℕ) (c : SheafOfModules.unit (wcEtZModRing S m) ⟶ I.cocomplex.X N) (hc : c ≫ I.cocomplex.d N (N + 1) = 0) (T : S.Etale) (E : wcEtPullData T.hom m), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S m)) := HasExt.standard _; wcEtPull E N (I.extMk c (N + 1) rfl hc) = 0 → ∃ (i' : ℕ) (e : (I.cocomplex.X i').val.obj (Opposite.op T)), ((I.cocomplex.d i' N).val.app (Opposite.op T)).hom e = (c.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)) :=
by
  intro S m I N c hc T E
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S m)) := HasExt.standard _
  intro hz
  cases N with
  | succ q =>
    obtain ⟨cl, -, h2, -, h4⟩ := wc_et_inj_res_cycle_class_coeff m I q
    obtain ⟨Du, hDu⟩ := h4 T T.hom rfl
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 T.left) m
    have h1 := wc_et_pull_comp T.hom (𝟙 T.left) T.hom (Category.id_comp _) Du Did E (q + 1)
      (I.extMk c (q + 1 + 1) rfl hc)
    rw [hz] at h1
    have h3 := wc_et_pull_id_injective Did (q + 1) _ h1.symm
    have hcl : cl T ((c.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op T))) = 0 := by
      rw [← hDu c hc]
      exact h3
    have hcyc : ((I.cocomplex.d (q + 1) (q + 2)).val.app (Opposite.op T)).hom
        ((c.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op T))) = 0 := by
      have h0 : ((c ≫ I.cocomplex.d (q + 1) (q + 1 + 1)).val.app (Opposite.op T)).hom
          (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)) = 0 := by
        rw [hc]
        rfl
      exact h0
    obtain ⟨e, he⟩ := (h2 T _ hcyc).mp hcl
    exact ⟨q, e, he⟩
  | zero =>
    obtain ⟨c₀, hlift⟩ : ∃ c₀ : SheafOfModules.unit (wcEtZModRing S m) ⟶
        SheafOfModules.unit (wcEtZModRing S m), c₀ ≫ I.ι.f 0 = c :=
      ⟨I.exact₀.lift c hc, I.exact₀.lift_f c hc⟩
    subst hlift
    have h5 := wc_ext_extMk_iota_zero I c₀ hc
    rw [h5] at hz
    have key : ∀ {S₁ S₂ : Scheme.{u}} {g : S₂ ⟶ S₁} (D : wcEtPullData g m)
        (f : SheafOfModules.unit (wcEtZModRing S₁ m) ⟶ SheafOfModules.unit (wcEtZModRing S₁ m)),
        letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S₁ m)) := HasExt.standard _;
        wcEtPull D 0 (Abelian.Ext.mk₀ f) = 0 → D.Φ.map f = 0 := by
      intro S₁ S₂ g D f
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S₁ m)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S₂ m)) := HasExt.standard _
      haveI := D.additive
      haveI := D.presLim
      haveI := D.presColim
      intro hD
      have h : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
          (Abelian.Ext.mk₀ f)).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) = 0 := hD
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        ← Abelian.Ext.mk₀_zero] at h
      have h' := (Abelian.Ext.mk₀_bijective _ _).1 h
      calc D.Φ.map f = D.μ.hom ≫ (D.μ.inv ≫ D.Φ.map f ≫ D.μ.hom) ≫ D.μ.inv := by simp
        _ = 0 := by rw [h']; simp
    have hΦ : E.Φ.map c₀ = 0 := key E c₀ hz
    obtain ⟨θ, hθnat, -, hθ1⟩ := wc_et_etale_pull_sections_dict T m E
    have hV := hθnat _ _ c₀ (wcEtTop T.left)
      ((E.μ.inv.val.app (Opposite.op (wcEtTop T.left))).hom
        (1 : (wcEtZModRing T.left m).obj.obj (Opposite.op (wcEtTop T.left))))
    rw [hθ1, hΦ] at hV
    have hV0 : (c₀.val.app (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))).hom
        (1 : (wcEtZModRing S m).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))) = 0 := by
      have hz0 : ((0 : E.Φ.obj (SheafOfModules.unit (wcEtZModRing S m)) ⟶
          E.Φ.obj (SheafOfModules.unit (wcEtZModRing S m))).val.app
            (Opposite.op (wcEtTop T.left))).hom
          ((E.μ.inv.val.app (Opposite.op (wcEtTop T.left))).hom
        (1 : (wcEtZModRing T.left m).obj.obj (Opposite.op (wcEtTop T.left)))) = 0 := by
        first
        | rfl
        | simp
      erw [hz0, map_zero] at hV
      exact hV.symm
    let ι' : T ⟶ (wcEtSlice T).obj (wcEtTop T.left) :=
      MorphismProperty.Over.homMk (𝟙 T.left)
        (by show 𝟙 T.left ≫ (𝟙 T.left ≫ T.hom) = T.hom; simp) trivial
    have hT : (c₀.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)) = 0 := by
      have hn := PresheafOfModules.naturality_apply c₀.val ι'.op
        (1 : (wcEtZModRing S m).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))
      have e1 : ((SheafOfModules.unit (wcEtZModRing S m)).val.map ι'.op).hom
          (1 : (wcEtZModRing S m).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))) =
          (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)) :=
        PresheafOfModules.unit_map_one _ _
      erw [hV0, map_zero] at hn
      erw [e1] at hn
      exact hn
    refine ⟨0, 0, ?_⟩
    rw [map_zero]
    change 0 = ((I.ι.f 0).val.app (Opposite.op T)).hom ((c₀.val.app (Opposite.op T)).hom
      (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)))
    rw [hT]
    exact (map_zero _).symm

theorem wc_et_push_edge_section_zero_of_local_coboundary : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (m : ℕ) (D : wcEtPullData g m) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing S' m))) (N : ℕ) (c : SheafOfModules.unit (wcEtZModRing S' m) ⟶ I.cocomplex.X N), letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; ∀ (hf : D.adj.homEquiv _ _ (D.μ.hom ≫ c) ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d N (N + 1) = 0) (V : S.Etale), (∃ (i' : ℕ) (e : (I.cocomplex.X i').val.obj (Opposite.op ((wcEtBaseChange g).obj V))), ((I.cocomplex.d i' N).val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom e = (c.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)))) → (((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (D.adj.homEquiv _ _ (D.μ.hom ≫ c)) (N + 1) (by simp) hf ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ N).val.app (Opposite.op V)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op V)) = 0 :=
by
  intro S S' g m D I N c hf V hex
  obtain ⟨i', e, he⟩ := hex

  have s1 : ∀ (K : HomologicalComplex (SheafOfModules.{u+1} (wcEtZModRing S m)) (ComplexShape.up ℕ))
      (k : SheafOfModules.unit (wcEtZModRing S m) ⟶ K.X N) (hk : k ≫ K.d N (N + 1) = 0)
      (x : (K.X i').val.obj (Opposite.op V)),
      ((K.d i' N).val.app (Opposite.op V)).hom x =
        (k.val.app (Opposite.op V)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op V)) →
      ((K.liftCycles k (N + 1) (by simp) hk ≫ K.homologyπ N).val.app (Opposite.op V)).hom
        (1 : (wcEtZModRing S m).obj.obj (Opposite.op V)) = 0 := by
    intro K k hk x hx
    obtain ⟨P, ev, hnat, hadd⟩ :=
      sheafOfModules_free_yoneda (Scheme.smallEtaleTopology S) (wcEtZModRing S m) V
    have hev0 : ∀ M, ev M 0 = 0 := fun M => by
      have h := hadd M 0 0
      rw [add_zero] at h
      exact left_eq_add.mp h
    obtain ⟨g₁, hg₁⟩ : ∃ g₁, ev (SheafOfModules.unit (wcEtZModRing S m)) g₁ =
        (1 : (wcEtZModRing S m).obj.obj (Opposite.op V)) := ⟨_, Equiv.apply_symm_apply _ _⟩
    obtain ⟨y, hy⟩ : ∃ y, ev (K.X i') y = x := ⟨_, Equiv.apply_symm_apply _ _⟩
    have hbd : g₁ ≫ k = y ≫ K.d i' N := by
      apply (ev (K.X N)).injective
      rw [hnat, hnat, hg₁, hy, hx]
    have h0 : g₁ ≫ (K.liftCycles k (N + 1) (by simp) hk ≫ K.homologyπ N) = 0 := by
      rw [← Category.assoc, HomologicalComplex.comp_liftCycles]
      exact K.liftCycles_homologyπ_eq_zero_of_boundary _ _ _ y hbd
    have h1 := hnat _ _ (K.liftCycles k (N + 1) (by simp) hk ≫ K.homologyπ N) g₁
    rw [h0, hev0, hg₁] at h1
    exact h1.symm

  have key : ((D.adj.homEquiv _ _ (D.μ.hom ≫ c)).val.app (Opposite.op V)).hom
        (1 : (wcEtZModRing S m).obj.obj (Opposite.op V)) =
      (c.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
        ((D.μ.hom.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
          (((D.adj.unit.app (SheafOfModules.unit (wcEtZModRing S m))).val.app (Opposite.op V)).hom
            (1 : (wcEtZModRing S m).obj.obj (Opposite.op V)))) := by
    rw [Adjunction.homEquiv_unit]
    rfl
  obtain ⟨w, hw⟩ : ∃ w : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)),
      w = (D.μ.hom.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
        (((D.adj.unit.app (SheafOfModules.unit (wcEtZModRing S m))).val.app (Opposite.op V)).hom
          (1 : (wcEtZModRing S m).obj.obj (Opposite.op V))) := ⟨_, rfl⟩
  rw [← hw] at key
  have e1 : (c.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom w =
      w • (c.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))) :=
    (congrArg (c.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom (mul_one w).symm).trans
      ((c.val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom.map_smul w
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))))
  have hx : ((I.cocomplex.d i' N).val.app (Opposite.op ((wcEtBaseChange g).obj V))).hom (w • e) =
      ((D.adj.homEquiv _ _ (D.μ.hom ≫ c)).val.app (Opposite.op V)).hom
        (1 : (wcEtZModRing S m).obj.obj (Opposite.op V)) := by
    rw [LinearMap.map_smul, he, key, e1]
  refine s1 _ _ hf
    (show ((I.cocomplex.X i').val.obj (Opposite.op ((wcEtBaseChange g).obj V))) from w • e) ?_
  exact hx

theorem wc_et_shens_milnor_pull_kill_level : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) (m : ℕ), 0 < m → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (x : Y) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a' : Spec (.of B) ⟶ Y), wcHalShData x B Λ W' φ a' → ∀ (r : Limits.pullback (a' ≫ f) z ⟶ Limits.pullback f z), r ≫ Limits.pullback.fst f z = Limits.pullback.fst (a' ≫ f) z ≫ a' → r ≫ Limits.pullback.snd f z = Limits.pullback.snd (a' ≫ f) z → ∀ (Dr : wcEtPullData r m) (N : ℕ) (ζ : wcEtZModExt (Limits.pullback f z) m N), wcEtPull Dr N ζ = 0 → ∃ l : Λ, ∀ E : wcEtPullData ((wcEtBaseChange (Limits.pullback.fst f z)).obj (W'.obj l).right).hom m, wcEtPull E N ζ = 0 :=
by
  intro A _ Y f m hm Ω _ _ z x B _ _ _ Λ _ _ W' φ a' hB r hr₁ hr₂ Dr N ζ hz
  obtain ⟨-, haff, hφ, hφa, hlim, -⟩ := hB
  let W : Λ ⥤ Y.Etale :=
    W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)
  have hφ' : ∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l' := fun t => hφ t
  have hφa' : ∀ l, φ l ≫ (W.obj l).hom = a' := fun l => hφa l
  have hlim' : ∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ (W.obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), w l ≫ (W.map t).left = w l') →
      ∃! z₀ : T ⟶ Spec (.of B), ∀ l, z₀ ≫ φ l = w l := fun T w hw => hlim T w hw
  have hpb : IsPullback r (Limits.pullback.fst (a' ≫ f) z) (Limits.pullback.fst f z) a' := by
    refine IsPullback.of_right (h₁₂ := Limits.pullback.snd f z) (h₂₂ := f) (v₁₃ := z) ?_ hr₁
      (IsPullback.of_hasPullback f z).flip
    rw [hr₂]
    exact (IsPullback.of_hasPullback (a' ≫ f) z).flip
  obtain ⟨π, hπ, -, hπc, hπlim⟩ := wc_et_baseChange_limit_cone (Limits.pullback.fst f z) B Λ W
