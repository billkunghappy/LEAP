  haveI := wc_et_enough_injectives (Limits.pullback D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom)
  obtain ⟨I⟩ : Nonempty (InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))) := ⟨InjectiveResolution.of _⟩

  obtain ⟨hint, hdim⟩ := wc_P1bar_facts F'' hP
