    let φ : TensorProduct R R' R' →+* Γ(Z, ⊤) :=
      ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv ≫ w.appTop).hom
    let ψ1 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z1.appTop).hom
    let ψ2 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z2.appTop).hom
    have hψ1 : ∀ x : R', φ (x ⊗ₜ[R] 1) = ψ1 x := by
      intro x
      have e := hN (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) w
      rw [hw1] at e
      exact (congrArg (fun k => k.hom x) e).symm
    have hψ2 : ∀ y : R', φ ((1 : R') ⊗ₜ[R] y) = ψ2 y := by
      intro y
      have e := hN (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) w
      rw [hw2] at e
      exact (congrArg (fun k => k.hom y) e).symm
    set c₀ := h1⁻¹ * h2 with hc₀
    have hunit : IsUnit (φ (e c₀)) := by
      have hrw : φ (e c₀) = (Scheme.Hom.app w ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
          (e c₀)) := rfl
      rw [hrw]
      apply RingedSpace.isUnit_of_isUnit_germ Z.toRingedSpace
      intro x _
      have hpre := Scheme.Hom.preimage_basicOpen w (U := ⊤)
        ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e c₀))
      have hmem : x ∈ w ⁻¹ᵁ (Spec (.of (TensorProduct R R' R'))).basicOpen
          ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e c₀)) := by
        rw [Scheme.Hom.mem_preimage, basicOpen_eq_of_affine]
        exact (PrimeSpectrum.mem_basicOpen _ _).mpr (hnot x)
      rw [hpre] at hmem
      exact (Scheme.mem_basicOpen_top Z _ x).mp hmem
    have hone : φ (e c₀) = 1 := (IsIdempotentElem.iff_eq_one_of_isUnit hunit).mp ((hidem c₀).map φ)
    have hzero : ∀ c, c ≠ c₀ → φ (e c) = 0 := by
      intro c hc
      rw [← mul_one (φ (e c)), ← hone, ← map_mul, horth c c₀ hc, map_zero]
    have hh : h2 * c₀⁻¹ = h1 := by rw [hc₀]; group
    have hring : ∀ b : B, ψ1 (ι b h1) = ψ2 (ι b h2) := by
      intro b
      have e1 := congrArg φ (hDC b h2)
      rw [hψ2, map_sum, Finset.sum_eq_single c₀] at e1
      · rw [e1, map_mul, hone, one_mul, hh, hψ1]
      · intro c _ hc
        rw [map_mul, hzero c hc, zero_mul]
      · intro hc
        exact absurd (Finset.mem_univ _) hc
    apply ext_of_isAffine
    rw [← cancel_epi (Scheme.ΓSpecIso (.of B)).inv, hN, hN]
    ext b
    have := hring b
    exact this
