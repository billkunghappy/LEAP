  obtain ⟨e, he⟩ := wc_qm_smooth_locus_resolution A ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX Ω ξ hξ
    Xb pb j hcomm hsm I z hz

  obtain ⟨hm, hex, hK⟩ := (wc_rdsc_quasiIso_single0_iff _ _ e).mp he
  obtain ⟨χ, hχ⟩ := wc_rdsc_lift_to_injective_resolution _ _ e hm hex hK J
  have hχq : QuasiIso χ := by
    haveI := he
    haveI : QuasiIso (e ≫ χ) := by rw [hχ]; exact J.quasiIso
    exact quasiIso_of_comp_left e χ

  obtain ⟨adj⟩ := wc_qm_inv_push_adj ((Limits.pullback pb (wcQmSp A)).homOfLE
    (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z))
  let φ : ((wcQmInv (wcQmUs z).ι).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      (wcQmCx (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j)
        (Limits.pullback.fst pb (wcQmSp A)) I.cocomplex) ⟶
      ((wcEtPush ((Limits.pullback pb (wcQmSp A)).homOfLE
        (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z))).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj J.cocomplex :=
    { f := fun k => (adj.homEquiv _ _) (χ.f k)
      comm' := fun i k _ => by
        simp only [Functor.mapHomologicalComplex_obj_d]
        rw [← adj.homEquiv_naturality_right, ← adj.homEquiv_naturality_left]
        congr 1
        exact χ.comm i k }
  refine ⟨J, φ, ?_⟩

  rw [quasiIso_iff]
  intro q
  rw [quasiIsoAt_iff_isIso_homologyMap]
  apply wc_et_isIso_of_geom_stalks_bijective
  intro y
  by_cases hy : (wcQmUs z).ι y ∈
      (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z : Set ↥(Limits.pullback pb (wcQmSp A)))
  ·
    let w : ↥(wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z : Scheme.{u}) := ⟨(wcQmUs z).ι y, hy⟩
    have hw : (Limits.pullback pb (wcQmSp A)).homOfLE
        (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z) w = y := by
      apply Subtype.ext
      rw [Scheme.homOfLE_apply]
      rfl
    have key := wc_qm_open_imm_transpose_stalk_bij ((Limits.pullback pb (wcQmSp A)).homOfLE
      (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z)) adj _ J.cocomplex
      χ hχq φ (fun k => rfl) w q
    rw [hw] at key
    exact key
  ·
    exact wc_qm_boundary_stalk_bij A ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX Ω ξ hξ Xb pb j hcomm hsm
      hbd I z hz (wc_coord_punct_tube_fibre_restr_bij A ℓ hℓ hunit) adj J χ hχq φ (fun k => rfl)
      y hy q

theorem wc_qm_vertex_point_closed : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (n : ℕ) (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (x₀ : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) → ∀ (Xb : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) [LocallyOfFiniteType pb] (j : Spec (.of (wcQuadModelRing A n π c)) ⟶ Xb) [IsOpenImmersion j], j ≫ pb = wcQuadModelStr A n π c → ∀ (z : ↥(Limits.pullback pb (wcQmSp A))), Limits.pullback.fst pb (wcQmSp A) z = j x₀ → IsClosed ({z} : Set ↥(Limits.pullback pb (wcQmSp A))) ∧ IsSepClosed ((Limits.pullback pb (wcQmSp A)).residueField z) ∧ closure ({z} : Set ↥(Limits.pullback pb (wcQmSp A))) = {z} :=
by
  intro A _ _ _ n π c hπ x₀ hX Xb pb _ j _ _hcomm z hz
  classical

  have hmax : (PrimeSpectrum.asIdeal x₀).IsMaximal := by
    have hQ : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (∑ p, ∑ q, MvPolynomial.C (c p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_singleton _)
    have ha : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) ∈
        PrimeSpectrum.asIdeal x₀ := by
      have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) =
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (∑ p, ∑ q, MvPolynomial.C (c p q) *
            MvPolynomial.X p * MvPolynomial.X q) := by
        rw [map_sub, sub_eq_zero] at hQ
        exact hQ.symm
      rw [e, map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hX q)
    have hb : ∀ a ∈ IsLocalRing.maximalIdeal A,
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a) ∈
          PrimeSpectrum.asIdeal x₀ := by
      intro a ha'
      rw [hπ, Ideal.mem_span_singleton'] at ha'
      obtain ⟨b, rfl⟩ := ha'
      rw [MvPolynomial.C_mul, map_mul]
      exact Ideal.mul_mem_left _ _ ha
    have hc : ∀ f : MvPolynomial (Fin n) A, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) f -
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ PrimeSpectrum.asIdeal x₀ := by
      intro f
      induction f using MvPolynomial.induction_on
      · rename_i a
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact Ideal.zero_mem _
      · rename_i p q hp hq
        have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (p + q) -
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
              (MvPolynomial.C (MvPolynomial.constantCoeff (p + q))) =
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) p -
              Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
                (MvPolynomial.C (MvPolynomial.constantCoeff p))) +
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) q -
              Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
                (MvPolynomial.C (MvPolynomial.constantCoeff q))) := by
          simp only [map_add]
          ring
        rw [e]
        exact Ideal.add_mem _ hp hq
      · rename_i p i _
        have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (p * MvPolynomial.X i) -
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
              (MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X i))) =
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c) p *
              Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X i) := by
          rw [map_mul MvPolynomial.constantCoeff, MvPolynomial.constantCoeff_X, mul_zero,
            map_zero, map_zero, sub_zero, map_mul]
        rw [e]
        exact Ideal.mul_mem_left _ _ (hX i)
    rw [Ideal.isMaximal_iff]
    refine ⟨fun h1 => x₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1), ?_⟩
    intro J r hPJ hrP hrJ
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    have hnm : MvPolynomial.constantCoeff f ∉ IsLocalRing.maximalIdeal A := by
      intro hm
      apply hrP
      have h2 := Ideal.add_mem _ (hc f) (hb _ hm)
      rwa [sub_add_cancel] at h2
    have hu : IsUnit (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.C (MvPolynomial.constantCoeff f))) :=
      ((IsLocalRing.notMem_maximalIdeal.mp hnm).map MvPolynomial.C).map _
    have hJ : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
      have h2 := Ideal.sub_mem _ hrJ (hPJ (hc f))
      rwa [sub_sub_cancel] at h2
    rw [Ideal.eq_top_of_isUnit_mem J hJ hu]
    exact Submodule.mem_top

  have hx₀ : IsClosed ({x₀} : Set (Spec (.of (wcQuadModelRing A n π c)))) :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal x₀).mpr hmax
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
      IsLocalRing.residue_surjective
  have hinj : Function.Injective (Limits.pullback.fst pb (wcQmSp A)) :=
    (Limits.pullback.fst pb (wcQmSp A)).isClosedEmbedding.isEmbedding.injective
  have hloc0 : IsLocallyClosed ({j x₀} : Set Xb) := by
    have h1 := hx₀.isLocallyClosed.image j.isOpenEmbedding.isInducing
      j.isOpenEmbedding.isOpen_range.isLocallyClosed
    rwa [Set.image_singleton] at h1
  have hpre : (Limits.pullback.fst pb (wcQmSp A)) ⁻¹' {j x₀} = {z} := by
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    rw [← hz]
    exact hinj.eq_iff
  have hloc : IsLocallyClosed ({z} : Set ↥(Limits.pullback pb (wcQmSp A))) := by
    rw [← hpre]
    exact hloc0.preimage (Limits.pullback.fst pb (wcQmSp A)).continuous
  haveI : JacobsonSpace ↥(Limits.pullback pb (wcQmSp A)) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd pb (wcQmSp A))
  have hzcl : IsClosed ({z} : Set ↥(Limits.pullback pb (wcQmSp A))) :=
    isClosed_singleton_of_isLocallyClosed_singleton hloc

  have hsep : IsSepClosed ((Limits.pullback pb (wcQmSp A)).residueField z) := by
    haveI : LocallyOfFiniteType ((Limits.pullback pb (wcQmSp A)).fromSpecResidueField z) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hzcl
    have hg : LocallyOfFiniteType ((Limits.pullback pb (wcQmSp A)).fromSpecResidueField z ≫
        Limits.pullback.snd pb (wcQmSp A)) := inferInstance
    have hg' : LocallyOfFiniteType (Spec.map (Spec.preimage
        ((Limits.pullback pb (wcQmSp A)).fromSpecResidueField z ≫
          Limits.pullback.snd pb (wcQmSp A)))) := by
      rwa [Spec.map_preimage]
    have hft := HasRingHomProperty.Spec_iff.mp hg'
    letI : Algebra (IsLocalRing.ResidueField A) ((Limits.pullback pb (wcQmSp A)).residueField z) :=
      (Spec.preimage ((Limits.pullback pb (wcQmSp A)).fromSpecResidueField z ≫
          Limits.pullback.snd pb (wcQmSp A))).hom.toAlgebra
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField A)
        ((Limits.pullback pb (wcQmSp A)).residueField z) := hft
    haveI : Module.Finite (IsLocalRing.ResidueField A)
        ((Limits.pullback pb (wcQmSp A)).residueField z) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsAlgebraic (IsLocalRing.ResidueField A)
        ((Limits.pullback pb (wcQmSp A)).residueField z) := Algebra.IsAlgebraic.of_finite _ _
    exact Algebra.IsAlgebraic.isSepClosed (F := IsLocalRing.ResidueField A)
  exact ⟨hzcl, hsep, hzcl.closure_eq⟩

theorem wc_qm_psg_vanish_crit : ∀ (Z : Scheme.{u}) (z : Z) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), (∀ y : Z, y ≠ z → Subsingleton ((wcEtStalk Z y).obj G)) → ∀ (T : Z.Etale) (g : G.obj.obj (Opposite.op T)), (∀ τ : T.left, T.hom τ = z → ∃ (T' : Z.Etale) (c : T' ⟶ T), τ ∈ Set.range c.left ∧ (G.obj.map c.op).hom g = 0) → g = 0 :=
by
  intro Z z G hstalk T g hloc
  classical
  let S : Sieve T :=
    { arrows := fun _ f => (G.obj.map f.op).hom g = 0
      downward_closed := by
        intro Y W f hf h
        show (G.obj.map (h ≫ f).op).hom g = 0
        rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hf,
          map_zero] }
  have hS : S ∈ Scheme.smallEtaleTopology Z T := by
    apply wc_etale_jointly_surjective_covers
    intro τ
    by_cases h : T.hom τ = z
    · obtain ⟨T', c, hτ, hc⟩ := hloc τ h
      exact ⟨T', c, hc, hτ⟩
    · haveI hsub := hstalk (T.hom τ) h
      obtain ⟨V₁, c, hτ, hc⟩ := wc_et_vanish_off_of_stalks G T g τ hsub
      exact ⟨V₁, c, hc, hτ⟩
  apply G.isSeparated T S hS g 0
  intro Y f hf
  rw [map_zero]
  exact hf

theorem wc_etale_residue_surj_of_sepClosed : ∀ {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (x : E), IsSepClosed (S.residueField (e x)) → Function.Surjective (e.residueFieldMap x).hom :=
by
  intro E S e _ x hsep
  letI : Algebra (S.presheaf.stalk (e x)) (E.presheaf.stalk x) := (e.stalkMap x).hom.toAlgebra
  haveI : IsLocalHom (algebraMap (S.presheaf.stalk (e x)) (E.presheaf.stalk x)) :=
    (inferInstance : IsLocalHom (e.stalkMap x).hom)
  haveI : Algebra.FormallyUnramified (S.presheaf.stalk (e x)) (E.presheaf.stalk x) :=
    FormallyUnramified.stalkMap e x
  haveI : Algebra.EssFiniteType (S.presheaf.stalk (e x)) (E.presheaf.stalk x) :=
    LocallyOfFiniteType.stalkMap e x
  haveI : Algebra.IsSeparable (IsLocalRing.ResidueField (S.presheaf.stalk (e x)))
      (IsLocalRing.ResidueField (E.presheaf.stalk x)) :=
    Algebra.instIsSeparableResidueFieldOfFormallyUnramified
  haveI : IsSepClosed (IsLocalRing.ResidueField (S.presheaf.stalk (e x))) := hsep
  have hs : Function.Surjective (algebraMap (IsLocalRing.ResidueField (S.presheaf.stalk (e x)))
      (IsLocalRing.ResidueField (E.presheaf.stalk x))) := IsSepClosed.algebraMap_surjective _ _
  exact hs

theorem wc_spec_residue_maps_eq_of_surj : ∀ {P E S : Scheme.{u}} (e : E ⟶ S) (a b : P ⟶ E), a ≫ e = b ≫ e → ∀ (p : P), a p = b p → Function.Surjective (e.residueFieldMap (a p)).hom → P.fromSpecResidueField p ≫ a = P.fromSpecResidueField p ≫ b :=
by
  intro P E S e a b hab p h hs
  set φ : E.residueField (a p) ⟶ P.residueField p := a.residueFieldMap p with hφ
  set ψ : E.residueField (a p) ⟶ P.residueField p :=
    (Scheme.residueFieldCongr h).hom ≫ b.residueFieldMap p with hψ
  have F1 : P.fromSpecResidueField p ≫ a = Spec.map φ ≫ E.fromSpecResidueField (a p) :=
    (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField a p).symm
  have F2 : P.fromSpecResidueField p ≫ b = Spec.map ψ ≫ E.fromSpecResidueField (a p) := by
    rw [hψ, Spec.map_comp, Category.assoc, Scheme.residueFieldCongr_fromSpecResidueField h]
    exact (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField b p).symm
  have F3 : ∀ χ : E.residueField (a p) ⟶ P.residueField p,
      Spec.map χ ≫ E.fromSpecResidueField (a p) ≫ e =
        Spec.map (e.residueFieldMap (a p) ≫ χ) ≫ S.fromSpecResidueField (e (a p)) := by
    intro χ
    rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField e (a p), Spec.map_comp,
      Category.assoc]
  have h5 : Spec.map (e.residueFieldMap (a p) ≫ φ) ≫ S.fromSpecResidueField (e (a p)) =
      Spec.map (e.residueFieldMap (a p) ≫ ψ) ≫ S.fromSpecResidueField (e (a p)) := by
    rw [← F3, ← F3, ← Category.assoc, ← Category.assoc, ← F1, ← F2, Category.assoc,
      Category.assoc, hab]
  have h6 := (cancel_mono (S.fromSpecResidueField (e (a p)))).mp h5
  have h7 := Spec.map_injective h6
  have h8 : φ = ψ := by
    ext y
    obtain ⟨z, rfl⟩ := hs y
    have := congrArg (fun f => f.hom z) h7
    simpa using this
  rw [F1, F2, h8]

theorem wc_qm_psg_isolated_rep : ∀ (B : Scheme.{u}) (b : B) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (x : (wcEtStalk B b).obj F), ∃ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s = x ∧ A.right.hom (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) = b ∧ ∀ w : A.right.left, A.right.hom w = b → w = A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) :=
by
  intro B b F x
  have hcof := wc_et_geomstalk_cofiltered B b wc_etale_maps_agree_near_geom_point
  obtain ⟨hrep, -, -⟩ := wc_et_stalk_germ_facts B b hcof F
  obtain ⟨A₁, s₁, hx₁⟩ := hrep x
  have hlie : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B),
      A.right.hom (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) = b := by
    intro A
    have hw := Over.w A.hom
    change (A.hom.left ≫ ((Scheme.Etale.forget B).obj A.right).hom)
      (IsLocalRing.closedPoint _) = b
    rw [hw]
    simp only [Over.mk_hom, wcEtGeomPt]
    exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  set c := IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)) with hc
  haveI : Etale A₁.right.hom := A₁.right.prop
  obtain ⟨U, hv₁U, hiso⟩ := @wc_etale_fibre_point_isolated A₁.right.left B A₁.right.hom _
    (A₁.hom.left c)
  have H : Set.range A₁.hom.left ⊆ Set.range U.ι := by
    rintro p ⟨y, rfl⟩
    exact ⟨⟨_, hv₁U⟩, (Scheme.Opens.ι_apply U ⟨_, hv₁U⟩).trans
      (congrArg A₁.hom.left (Subsingleton.elim c y))⟩
  let t := IsOpenImmersion.lift U.ι A₁.hom.left H
  have ht₁ : t ≫ U.ι = A₁.hom.left := IsOpenImmersion.lift_fac _ _ _
  let V : B.Etale := Scheme.Etale.mk (U.ι ≫ A₁.right.hom)
  let ι₁ : V ⟶ A₁.right := MorphismProperty.Over.homMk U.ι rfl trivial
  have ht : t ≫ (U.ι ≫ A₁.right.hom) = wcEtGeomPt B b :=
    (IsOpenImmersion.lift_fac_assoc U.ι A₁.hom.left H A₁.right.hom).trans (Over.w A₁.hom)
  let A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := V)
      (Over.homMk t ht : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)
  let φ : A ⟶ A₁ := StructuredArrow.homMk ι₁ (by
    ext
    exact ht₁)
  refine ⟨A, (F.obj.map ι₁.op).hom s₁, ?_, hlie A, ?_⟩
  · have key := congrArg (fun f => f.hom s₁) (Limits.colimit.w
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) φ.op)
    exact key.trans hx₁
  · intro w hw
    have h1 : A₁.right.hom (U.ι w) = A₁.right.hom (A₁.hom.left c) :=
      ((Scheme.Hom.comp_apply U.ι A₁.right.hom w).symm.trans hw).trans (hlie A₁).symm
    have hmem : U.ι w ∈ U := by
      have e := Scheme.Opens.ι_apply U w
      first
      | (rw [e]; exact w.2)
      | exact e ▸ w.2
      | exact e.symm ▸ w.2
    have h2 : U.ι w = A₁.hom.left c := hiso _ hmem h1
    apply (Scheme.Hom.isOpenEmbedding U.ι).injective
    refine h2.trans ?_
    show A₁.hom.left c = U.ι (t c)
    first
    | exact (congrArg (fun f => f c) ht₁).symm.trans (Scheme.Hom.comp_apply t U.ι c)
    | (rw [← Scheme.Hom.comp_apply t U.ι c, ht₁]; rfl)
    | (rw [← Scheme.Hom.comp_apply t U.ι c, ht₁]; congr 1)

theorem wc_qm_psg_rigid : ∀ (Z : Scheme.{u}) (z : Z) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), (∀ (T : Z.Etale) (g : G.obj.obj (Opposite.op T)), (∀ τ : T.left, T.hom τ = z → ∃ (T' : Z.Etale) (c : T' ⟶ T), τ ∈ Set.range c.left ∧ (G.obj.map c.op).hom g = 0) → g = 0) → ∀ (V : Z.Etale) (v₀ : V.left), (∀ w : V.left, V.hom w = z → w = v₀) → (∀ (T : Z.Etale) (a b : T ⟶ V) (τ : T.left), V.hom (a.left τ) = z → a.left τ = b.left τ → T.left.fromSpecResidueField τ ≫ a.left = T.left.fromSpecResidueField τ ≫ b.left) → ∀ (s : G.obj.obj (Opposite.op V)) (T : Z.Etale) (a b : T ⟶ V), (G.obj.map a.op).hom s = (G.obj.map b.op).hom s :=
by
  intro Z z G hVC V v₀ hfib hagree s T a b
  rw [← sub_eq_zero]
  apply hVC T
  intro τ hτ
  have ha : V.hom (a.left τ) = z := by
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w a]; exact hτ
  have hb : V.hom (b.left τ) = z := by
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w b]; exact hτ
  have heq : a.left τ = b.left τ := (hfib _ ha).trans (hfib _ hb).symm
  have hπ := hagree T a b τ ha heq
  obtain ⟨U, hU, hUab⟩ := wc_etale_maps_agree_near_geom_point (P := T.left) V.hom a.left b.left
    ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm)
    (T.left.residueField τ) (T.left.fromSpecResidueField τ) hπ
  have hτU : τ ∈ U := by
    have h1 : (T.left.fromSpecResidueField τ) (IsLocalRing.closedPoint (T.left.residueField τ))
        = τ := by
      first
      | exact Scheme.fromSpecResidueField_apply _ _
      | exact Scheme.fromSpecResidueField_apply _
      | simp
    exact h1 ▸ hU
  let c : Scheme.Etale.mk (U.ι ≫ T.hom) ⟶ T := MorphismProperty.Over.homMk U.ι rfl trivial
  have hca : c ≫ a = c ≫ b := by
    apply MorphismProperty.Over.Hom.ext
    first
    | exact hUab
    | (rw [MorphismProperty.Comma.comp_left, MorphismProperty.Comma.comp_left]; exact hUab)
  have key : ∀ f : T ⟶ V, (G.obj.map c.op).hom ((G.obj.map f.op).hom s) =
      (G.obj.map (c ≫ f).op).hom s := by
    intro f
    rw [op_comp, Functor.map_comp]
    rfl
  refine ⟨Scheme.Etale.mk (U.ι ≫ T.hom), c, ?_, ?_⟩
  · show τ ∈ Set.range U.ι
    rw [Scheme.Opens.range_ι]
    exact hτU
  · rw [map_sub, key, key, hca, sub_self]

theorem wc_qm_psg_glue : ∀ (Z : Scheme.{u}) (z : Z), IsClosed ({z} : Set Z) → ∀ (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (V : Z.Etale) (v₀ : V.left), V.hom v₀ = z → ∀ (s : G.obj.obj (Opposite.op V)), (∀ (T : Z.Etale) (a b : T ⟶ V), (G.obj.map a.op).hom s = (G.obj.map b.op).hom s) → (∀ (T : Z.Etale) (g : G.obj.obj (Opposite.op T)), (∀ τ : T.left, T.hom τ ≠ z) → g = 0) → ∀ (r : V ⟶ Scheme.Etale.mk (𝟙 Z)), ∃ y : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Z))), (G.obj.map r.op).hom y = s :=
by
  intro Z z hzcl G V v₀ hv₀ s hrig hvan r
  classical
  have hrleft : r.left = V.hom :=
    (Category.comp_id r.left).symm.trans (MorphismProperty.Over.w r)
  let O : Z.Opens := ⟨({z} : Set Z)ᶜ, hzcl.isOpen_compl⟩
  let Oet : Z.Etale := Scheme.Etale.mk O.ι
  let cO : Oet ⟶ Scheme.Etale.mk (𝟙 Z) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  have haux : ∀ (T : Z.Etale) (β : T ⟶ Oet) (g : G.obj.obj (Opposite.op T)), g = 0 := by
    intro T β g
    apply hvan T g
    intro τ hτ
    have hw : β.left ≫ O.ι = T.hom := MorphismProperty.Over.w β
    have h1 : (β.left ≫ O.ι) τ = T.hom τ := congrArg (fun f : T.left ⟶ Z => f τ) hw
    have h3 : T.hom τ ∈ Set.range O.ι := ⟨β.left τ, by
      refine Eq.trans ?_ h1
      first
      | rfl
      | exact (Scheme.Hom.comp_apply _ _ _).symm⟩
    rw [Scheme.Opens.range_ι] at h3
    exact h3 (Set.mem_singleton_iff.mpr hτ)
  let W : Fin 2 → Z.Etale := ![V, Oet]
  let c : ∀ i, W i ⟶ Scheme.Etale.mk (𝟙 Z) := Fin.cons r (Fin.cons cO finZeroElim)
  let x : ∀ i, G.obj.obj (Opposite.op (W i)) :=
    Fin.cons s (Fin.cons (0 : G.obj.obj (Opposite.op Oet)) finZeroElim)
  have hcov : ∀ v : (Scheme.Etale.mk (𝟙 Z)).left, ∃ (i : Fin 2) (w : (W i).left),
      (c i).left w = v := by
    intro v
    by_cases hv : v = z
    · refine ⟨0, v₀, ?_⟩
      show r.left v₀ = v
      exact (congrArg (fun f : V.left ⟶ Z => f v₀) hrleft).trans (hv₀.trans hv.symm)
    · have hv' : v ∈ O := hv
      refine ⟨1, (⟨v, hv'⟩ : O), ?_⟩
      show O.ι (⟨v, hv'⟩ : O) = v
      first
      | rfl
      | exact Scheme.Opens.ι_apply O ⟨v, hv'⟩
  have hcompat : ∀ (i j : Fin 2) (T : Z.Etale) (a : T ⟶ W i) (b : T ⟶ W j),
      a ≫ c i = b ≫ c j → (G.obj.map a.op).hom (x i) = (G.obj.map b.op).hom (x j) := by
    intro i j T a b _
    fin_cases i <;> fin_cases j
    · exact hrig T a b
    · exact (haux T b _).trans (haux T b _).symm
    · exact (haux T a _).trans (haux T a _).symm
    · exact (haux T a _).trans (haux T a _).symm
  have hS : Sieve.generate (Presieve.ofArrows W c) ∈
      Scheme.smallEtaleTopology Z (Scheme.Etale.mk (𝟙 Z)) := by
    change Sieve.generate (Presieve.ofArrows W c) ∈
      Scheme.smallGrothendieckTopology @Etale Z (Scheme.Etale.mk (𝟙 Z))
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    obtain ⟨i, w, hw⟩ := hcov v
    have hEt : Etale (c i).left := by
      have hw' : (c i).left ≫ (Scheme.Etale.mk (𝟙 Z)).hom = (W i).hom :=
        MorphismProperty.Over.w (c i)
      have h1 : Etale (Scheme.Etale.mk (𝟙 Z)).hom := (Scheme.Etale.mk (𝟙 Z)).prop
      have h2 : Etale ((c i).left ≫ (Scheme.Etale.mk (𝟙 Z)).hom) := by
        rw [hw']; exact (W i).prop
      exact Etale.of_comp (c i).left (Scheme.Etale.mk (𝟙 Z)).hom
    exact ⟨W i, c i, w, ⟨_, 𝟙 _, c i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hEt, hw⟩
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Z) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology Z) (forget AddCommGrpCat.{u+1})).obj G).property
  have hSF := (Presieve.isSheafFor_arrows_iff _ c).mp (hP.isSheafFor _ hS)
  obtain ⟨y, hy, -⟩ := hSF x (fun i j T a b hab => hcompat i j T a b hab)
  exact ⟨y, hy 0⟩

theorem wc_qm_point_sheaf_germ_bij : ∀ (Z : Scheme.{u}) (z : Z), IsClosed ({z} : Set Z) → IsSepClosed (Z.residueField z) → ∀ (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), (∀ y : Z, y ≠ z → Subsingleton ((wcEtStalk Z y).obj G)) → Function.Bijective (wcEtGlobalGerm G z) :=
by
  intro Z z hzcl hzsep G hstalk
  have hcrit := wc_qm_psg_vanish_crit Z z G hstalk
  have hrleft : ∀ {W : Z.Etale} (r : W ⟶ Scheme.Etale.mk (𝟙 Z)), r.left = W.hom :=
    fun r => (Category.comp_id r.left).symm.trans (MorphismProperty.Over.w r)
  let Fz := (StructuredArrow.proj (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z)).op ⋙ G.obj
  let topArr : StructuredArrow (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z) :=
    StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 Z)) (Over.homMk (wcEtGeomPt Z z) (by simp))
  have hgerm : ∀ s, wcEtGlobalGerm G z s = (Limits.colimit.ι Fz (Opposite.op topArr)).hom s :=
    fun s => rfl
  constructor
  · intro a b hab
    have h0 : wcEtGlobalGerm G z (a - b) = 0 := by
      rw [hgerm, map_sub, ← hgerm, ← hgerm, hab, sub_self]
    obtain ⟨W, r, w, hw, hr⟩ := wc_et_germ_zero_local Z z G (a - b) h0
    have hab0 : a - b = 0 := by
      apply hcrit (Scheme.Etale.mk (𝟙 Z)) (a - b)
      intro τ hτ
      refine ⟨W, r, ⟨w, ?_⟩, hr⟩
      rw [hrleft r]
      first
      | exact hw.trans hτ.symm
      | (have hτ' : τ = z := by simpa using hτ
         exact hw.trans hτ'.symm)
    exact sub_eq_zero.mp hab0
  · intro x
    obtain ⟨A, s, hx, hv₀, hfib⟩ := wc_qm_psg_isolated_rep Z z G x
    have hagree : ∀ (T : Z.Etale) (a b : T ⟶ A.right) (τ : T.left),
        A.right.hom (a.left τ) = z → a.left τ = b.left τ →
        T.left.fromSpecResidueField τ ≫ a.left = T.left.fromSpecResidueField τ ≫ b.left := by
      intro T a b τ h heq
      haveI : Etale A.right.hom := A.right.prop
      have hsep : IsSepClosed (Z.residueField (A.right.hom (a.left τ))) := by
        rw [h]; exact hzsep
      have hsurj := wc_etale_residue_surj_of_sepClosed A.right.hom (a.left τ) hsep
      exact wc_spec_residue_maps_eq_of_surj A.right.hom a.left b.left
        ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) τ heq hsurj
    have hrig := wc_qm_psg_rigid Z z G hcrit A.right _ hfib hagree s
    have hvan : ∀ (T : Z.Etale) (g : G.obj.obj (Opposite.op T)), (∀ τ : T.left, T.hom τ ≠ z) →
        g = 0 := fun T g h => hcrit T g (fun τ hτ => absurd hτ (h τ))
    let r : A.right ⟶ Scheme.Etale.mk (𝟙 Z) :=
      MorphismProperty.Over.homMk A.right.hom (Category.comp_id _) trivial
    obtain ⟨y, hy⟩ := wc_qm_psg_glue Z z hzcl G A.right _ hv₀ s hrig hvan r
    refine ⟨y, ?_⟩
    let ψ : A ⟶ topArr := StructuredArrow.homMk r (by
      ext
      exact Over.w A.hom)
    have key := congrArg (fun φ => φ.hom y) (Limits.colimit.w Fz ψ.op)
    calc wcEtGlobalGerm G z y
        = (Limits.colimit.ι Fz (Opposite.op A)).hom ((G.obj.map r.op).hom y) := key.symm
      _ = x := by rw [hy, hx]

theorem wc_qm_point_sheaf_ext_vanish : ∀ (Z : Scheme.{u}) (z : Z), IsClosed ({z} : Set Z) → IsSepClosed (Z.residueField z) → ∀ (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), (∀ y : Z, y ≠ z → Subsingleton ((wcEtStalk Z y).obj G)) → ∀ p : ℕ, 1 ≤ p → Subsingleton (wcEtExt Z G p) :=
by
  intro Z z hzcl hzsep G hG p hp
  haveI : IsClosedImmersion (Z.fromSpecResidueField z) :=
    isClosed_singleton_iff_isClosedImmersion.mp hzcl
  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint (Z.fromSpecResidueField z)
  have hunit : IsIso (adj.unit.app G) := by
    refine (wc_et_closed_push_adj_isos (Z.fromSpecResidueField z) L adj).2 G ?_
    intro V s v hv
    have hne : V.hom v ≠ z := by
      intro h
      apply hv
      rw [Scheme.range_fromSpecResidueField]
      exact h
    exact wc_et_vanish_off_of_stalks G V s v (hG _ hne)
  obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
  obtain ⟨E₁⟩ := wc_et_finite_push_ext_equiv (Z.fromSpecResidueField z) (L.obj G) (q + 1)
  have hinj : Function.Injective (IsLocalRing.residue (Z.residueField z)) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.maximalIdeal_eq_bot] at hx
    simpa using hx
  haveI hsep' : IsSepClosed (IsLocalRing.ResidueField (Z.residueField z)) :=
    wc_henselian_sepClosed_transfer.2 _ _
      (RingEquiv.ofBijective (IsLocalRing.residue (Z.residueField z))
        ⟨hinj, IsLocalRing.residue_surjective⟩) hzsep
  haveI : HenselianLocalRing (Z.residueField z) := Field.henselian _
  haveI hsub : Subsingleton (wcEtExt (Spec (Z.residueField z)) (L.obj G) (q + 1)) :=
    @wc_et_strictly_local_ext_vanishing (Z.residueField z) _ (Field.henselian _) hsep' (L.obj G) q
  have hsub' : Subsingleton (wcEtExt Z ((wcEtPush (Z.fromSpecResidueField z)).obj (L.obj G)) (q + 1)) :=
    E₁.subsingleton
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  let e : G ≅ (wcEtPush (Z.fromSpecResidueField z)).obj (L.obj G) := asIso (adj.unit.app G)
  have hsub'' : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((wcEtPush (Z.fromSpecResidueField z)).obj (L.obj G)) (q + 1)) := hsub'
  have h0 : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G (q + 1), x = 0 := by
    intro x
    have h1 : (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv)
        (add_zero _) = x := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero _) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id]
      exact Abelian.Ext.comp_mk₀_id x
    have h2 : x.comp (Abelian.Ext.mk₀ e.hom) (add_zero _) = 0 :=
      @Subsingleton.elim _ hsub'' _ _
    rw [← h1, h2]
    simp
  show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G (q + 1))
  exact ⟨fun x y => (h0 x).trans (h0 y).symm⟩

theorem wc_qm_sig_triangle_iff_inl : ∀ (Z : Scheme.{u}) (z : Z), letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}); let σ := fun (M : DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})) (e : (DerivedCategory.singleFunctor _ 0).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ M) => wcEtGlobalGerm _ z ((((DerivedCategory.singleFunctorCompHomologyFunctorIso _ 0).inv.app ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ (DerivedCategory.homologyFunctor _ 0).map e).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom (((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Scheme.Etale Z)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom (ULift.up 1))); ∀ (T : Pretriangulated.Triangle (DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}))), T ∈ Pretriangulated.distinguishedTriangles → (∀ n : ℤ, Function.Bijective (σ ((shiftFunctor _ n).obj T.obj₃))) → ((∀ n : ℤ, Function.Bijective (σ ((shiftFunctor _ n).obj T.obj₁))) ↔ (∀ n : ℤ, Function.Bijective (σ ((shiftFunctor _ n).obj T.obj₂)))) :=
by
  intro Z z σ T hT hW
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})

  have germ_nat : ∀ (F F' : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (f : F ⟶ F')
      (s : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Z)))),
      wcEtGlobalGerm F' z ((f.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom s) =
        ((wcEtStalk Z z).map f).hom (wcEtGlobalGerm F z s) := by
    intro F F' f s
    have h := Limits.ι_colimMap (Functor.whiskerLeft
      (StructuredArrow.proj (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z)).op f.hom)
      (Opposite.op (StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 Z))
        (Over.homMk (wcEtGeomPt Z z) (by simp))))
    exact (congrArg (fun g => g.hom s) h).symm

  have hadd : ∀ (M : DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}))
      (e₁ e₂ : (DerivedCategory.singleFunctor _ 0).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ M),
      σ M (e₁ + e₂) = σ M e₁ + σ M e₂ := by
    intro M e₁ e₂
    simp only [σ, Functor.map_add, Preadditive.comp_add, Sheaf.Hom.add_app, AddCommGrpCat.hom_add,
      AddMonoidHom.add_apply]
    simp only [wcEtGlobalGerm]
    first
      | (erw [AddMonoidHom.add_apply, map_add])
      | (exact (congrArg _ (AddMonoidHom.add_apply _ _ _)).trans (map_add _ _ _))
      | (exact map_add _ _ _)

  have hnat : ∀ (M N : DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}))
      (φ : M ⟶ N)
      (e : (DerivedCategory.singleFunctor _ 0).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ M),
      σ N (e ≫ φ) = ((wcEtStalk Z z).map ((DerivedCategory.homologyFunctor _ 0).map φ)).hom
        (σ M e) := by
    intro M N φ e
    refine Eq.trans ?_ (germ_nat _ _ ((DerivedCategory.homologyFunctor _ 0).map φ) _)
    simp only [σ, Functor.map_comp]
    rfl

  have hstalk : Limits.PreservesFiniteLimits (wcEtStalk Z z) ∧
      Limits.PreservesFiniteColimits (wcEtStalk Z z) := by
    haveI : AB5OfSize.{u, u} AddCommGrpCat.{u+1} :=
      AB5OfSize_shrink.{u, u, u+1, u+1} AddCommGrpCat.{u+1}
    let Φ := Scheme.pointSmallEtale (wcEtGeomPt Z z)
    let E : StructuredArrow (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z) ⥤ Φ.fiber.Elements :=
      { obj := fun A => Φ.fiber.elementsMk A.right A.hom
        map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
        map_id := fun A => rfl
        map_comp := fun f g => rfl }
    let Einv : Φ.fiber.Elements ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z) :=
      { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget Z) (Y := x.1) x.2
        map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
        map_id := fun x => rfl
        map_comp := fun f g => rfl }
    let eqv : StructuredArrow (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z) ≌ Φ.fiber.Elements :=
      CategoryTheory.Equivalence.mk E Einv (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
        (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
    haveI : E.IsEquivalence := eqv.isEquivalence_functor
    haveI : E.IsLeftAdjoint := Functor.isLeftAdjoint_of_isEquivalence
    haveI : E.Initial := Functor.initial_of_isLeftAdjoint E
    haveI : E.op.Final := Functor.final_op_of_initial E
    let i0 := Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) E.op
    let i1 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z)).op ⋙ Limits.colim ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (Functor.Elements.π Φ.fiber).op ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (Functor.Elements.π Φ.fiber).op) i0
    let j : Φ.sheafFiber (A := AddCommGrpCat.{u+1}) ≅ wcEtStalk Z z :=
      Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) i1.symm
    exact ⟨Limits.preservesFiniteLimits_of_natIso j, Limits.preservesFiniteColimits_of_natIso j⟩
  obtain ⟨hsl, hsc⟩ := hstalk
  have hex : ∀ T' ∈ (Pretriangulated.distinguishedTriangles : Set (Pretriangulated.Triangle
      (DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})))),
      Function.Exact ((wcEtStalk Z z).map ((DerivedCategory.homologyFunctor _ 0).map T'.mor₁)).hom
        ((wcEtStalk Z z).map ((DerivedCategory.homologyFunctor _ 0).map T'.mor₂)).hom := by
    intro T' hT'
    have hS := (DerivedCategory.HomologySequence.exact₂ T' hT' 0).map (wcEtStalk Z z)
    rw [ShortComplex.ab_exact_iff_function_exact] at hS
    exact hS

  have hhom : ∀ T' ∈ (Pretriangulated.distinguishedTriangles : Set (Pretriangulated.Triangle
      (DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})))),
      ∀ (P : DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})),
      Function.Exact (Preadditive.rightComp P T'.mor₁) (Preadditive.rightComp P T'.mor₂) := by
    intro T' hT' P h
    constructor
    · intro hh
      obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ T' hT' h hh
      exact ⟨g, hg.symm⟩
    · rintro ⟨g, rfl⟩
