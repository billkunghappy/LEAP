theorem wc_et_push_H0_resolution_iso : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (I : InjectiveResolution F), Nonempty ((wcEtPush g).obj F ≅ (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 0) :=
