      have h2 : (((wcEtBaseChange O.ι).obj V).hom ≫ O.ι) v ∈ O := by
        have : (((wcEtBaseChange O.ι).obj V).hom ≫ O.ι) v ∈ Set.range O.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at this
      have h3 : (((wcEtBaseChange O.ι).obj V).hom ≫ O.ι) v ∈ N ⊓ W := by
        rw [← hN]
        exact ⟨h1, h2⟩
      exact h3.2
    have hfac : ∃ s : ((wcEtBaseChange O.ι).obj V).left ⟶ T.left,
        s ≫ T.hom = ((wcEtBaseChange O.ι).obj V).hom := by
      haveI hWι : IsOpenImmersion W.ι := inferInstance
      let s : ((wcEtBaseChange O.ι).obj V).left ⟶ (W : Scheme.{u}) :=
        @IsOpenImmersion.lift _ _ _ W.ι (((wcEtBaseChange O.ι).obj V).hom ≫ O.ι) hWι hrange
      have hs : s ≫ W.ι = ((wcEtBaseChange O.ι).obj V).hom ≫ O.ι :=
        @IsOpenImmersion.lift_fac _ _ _ W.ι (((wcEtBaseChange O.ι).obj V).hom ≫ O.ι) hWι hrange
      refine ⟨s, ?_⟩
      rw [← cancel_mono O.ι]
      show (s ≫ Z.homOfLE hWO) ≫ O.ι = _
      rw [Category.assoc, Scheme.homOfLE_ι, hs]
    haveI : ∀ n, IsIso ((((sheafToPresheaf (Scheme.smallEtaleTopology (O : Scheme.{u}))
        AddCommGrpCat.{u+1} ⋙ (evaluation ((O : Scheme.{u}).Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op ((wcEtBaseChange O.ι).obj V))).mapHomologicalComplex
            (ComplexShape.up ℕ)).map ηI).f n) :=
      fun n => hη (I.cocomplex.X n) _ hfac
    haveI := HomologicalComplex.Hom.isIso_of_components
      (((sheafToPresheaf (Scheme.smallEtaleTopology (O : Scheme.{u}))
        AddCommGrpCat.{u+1} ⋙ (evaluation ((O : Scheme.{u}).Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op ((wcEtBaseChange O.ι).obj V))).mapHomologicalComplex
            (ComplexShape.up ℕ)).map ηI)
    infer_instance
  have hmapψ₀ : ((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map ψ₀ =
      ((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map ηI ≫
      ((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map
        (((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).map h.hom) :=
    Functor.map_comp _ _ _
  have hsplit : HomologicalComplex.homologyMap
      (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map ψ₀ ≫ κ.hom) p =
      HomologicalComplex.homologyMap
        (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map ηI) p ≫
      (HomologicalComplex.homologyMap
        (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).map h.hom)) p ≫
      HomologicalComplex.homologyMap κ.hom p) :=
    (HomologicalComplex.homologyMap_comp _ _ p).trans
      ((congrArg (fun f => HomologicalComplex.homologyMap f p ≫
          HomologicalComplex.homologyMap κ.hom p) hmapψ₀).trans
        ((congrArg (fun g => g ≫ HomologicalComplex.homologyMap κ.hom p)
          (HomologicalComplex.homologyMap_comp _ _ p)).trans (Category.assoc _ _ _)))
  haveI hBκ : IsIso (HomologicalComplex.homologyMap
        (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).map h.hom)) p ≫
      HomologicalComplex.homologyMap κ.hom p) := @IsIso.comp_isIso _ _ _ _ _ _ _ hB hκ
  haveI hBκ' : IsIso ((wcEtStalk Z y).map (HomologicalComplex.homologyMap
        (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).map h.hom)) p ≫
      HomologicalComplex.homologyMap κ.hom p)) := Functor.map_isIso _ _
  have hfin : (wcEtStalk Z y).map (HomologicalComplex.homologyMap
      (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map ψ₀ ≫ κ.hom) p) =
      (wcEtStalk Z y).map (HomologicalComplex.homologyMap
        (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map ηI) p) ≫
      (wcEtStalk Z y).map (HomologicalComplex.homologyMap
        (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map
          (((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).map h.hom)) p ≫
      HomologicalComplex.homologyMap κ.hom p) :=
    (congrArg (wcEtStalk Z y).map hsplit).trans (Functor.map_comp _ _ _)
  exact cast (congrArg (fun f => IsIso f) hfin.symm) (@IsIso.comp_isIso _ _ _ _ _ _ _ hA hBκ')

theorem wc_qm_special_chart_iso : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ) (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (Xb : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) (j : Spec (.of (wcQuadModelRing A n π c)) ⟶ Xb) [IsOpenImmersion j], j ≫ pb = wcQuadModelStr A n π c → Nonempty (((Limits.pullback.fst pb (wcQmSp A)) ⁻¹ᵁ j.opensRange).toScheme ≅ Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0 (c.map (IsLocalRing.residue A))))) :=
by
  intro A _ _ n π c hπ Xb pb j _ hcomm
  classical

  have s1 : ∀ {X Y S T : Scheme.{u}} (pb : X ⟶ S) (g : T ⟶ S) (j : Y ⟶ X) [IsOpenImmersion j]
      (f : Y ⟶ S), j ≫ pb = f →
      Nonempty (((Limits.pullback.fst pb g) ⁻¹ᵁ j.opensRange).toScheme ≅ Limits.pullback f g) := by
    intro X Y S T pb g j _ f h
    have he : j.isoOpensRange.inv ≫ j = j.opensRange.ι :=
      (Iso.inv_comp_eq _).mpr (Scheme.Hom.isoOpensRange_hom_ι j).symm
    refine ⟨(pullbackRestrictIsoRestrict (Limits.pullback.fst pb g) j.opensRange).symm ≪≫
      Limits.pullbackSymmetry _ _ ≪≫ Limits.pullbackRightPullbackFstIso pb g j.opensRange.ι ≪≫
      ?_ ≪≫ Limits.pullback.congrHom h rfl⟩
    exact asIso (Limits.pullback.map (j.opensRange.ι ≫ pb) g (j ≫ pb) g j.isoOpensRange.inv
      (𝟙 T) (𝟙 S) (by rw [Category.comp_id, ← Category.assoc, he]) (by simp))

  set k := IsLocalRing.ResidueField A with hk
  set r := IsLocalRing.residue A with hr
  have hrA : algebraMap A k = r := IsLocalRing.ResidueField.algebraMap_eq A
  have F0 : r π = 0 :=
    (IsLocalRing.residue_eq_zero_iff π).mpr (hπ ▸ Ideal.mem_span_singleton_self π)
  set Rm := wcQuadModelRing A n π c with hRm
  set R' := wcQuadModelRing k n 0 (c.map r) with hR'
  set I := wcQuadModelIdeal A n π c with hI
  set I' := wcQuadModelIdeal k n 0 (c.map r) with hI'
  set G : MvPolynomial (Fin n) A := ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
    MvPolynomial.X q - MvPolynomial.C π with hG
  have F1 : MvPolynomial.map r G = ∑ p, ∑ q, MvPolynomial.C (c.map r p q) * MvPolynomial.X p *
      MvPolynomial.X q - MvPolynomial.C 0 := by
    simp [G, F0, map_sum, Matrix.map_apply]
  have hGI : G ∈ I := Ideal.mem_span_singleton_self _
  have hGI' : MvPolynomial.map r G ∈ I' := by
    rw [F1]; exact Ideal.mem_span_singleton_self _
  let y : Fin n → R' := fun i => Ideal.Quotient.mk I' (MvPolynomial.X i)
  have hf0 : (MvPolynomial.aeval (R := A) y).toRingHom =
      (Ideal.Quotient.mk I').comp (MvPolynomial.map r) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C, RingHom.coe_comp,
        Function.comp_apply, MvPolynomial.map_C]
      rw [IsScalarTower.algebraMap_apply A k, hrA, ← Ideal.Quotient.mk_algebraMap,
        MvPolynomial.algebraMap_eq]
    · intro i
      simp [y]
  have hf : ∀ a ∈ I, MvPolynomial.aeval (R := A) y a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have h1 : MvPolynomial.aeval (R := A) y G = 0 := by
      have := RingHom.congr_fun hf0 G
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, RingHom.coe_comp,
        Function.comp_apply] at this
      rw [this, Ideal.Quotient.eq_zero_iff_mem]
      exact hGI'
    rw [map_mul, h1, mul_zero]
  let f : Rm →ₐ[A] R' := Ideal.Quotient.liftₐ I (MvPolynomial.aeval y) hf
  let φ : TensorProduct A k Rm →ₐ[k] R' :=
    Algebra.TensorProduct.lift (Algebra.ofId k R') f (fun _ _ => Commute.all _ _)
  let x : Fin n → TensorProduct A k Rm :=
    fun i => (1 : k) ⊗ₜ[A] (Ideal.Quotient.mk I (MvPolynomial.X i))
  let ψ₀ : MvPolynomial (Fin n) k →ₐ[k] TensorProduct A k Rm := MvPolynomial.aeval x
  have hψ0 : ψ₀.toRingHom.comp (MvPolynomial.map r) =
      (Algebra.TensorProduct.includeRight : Rm →ₐ[A] TensorProduct A k Rm).toRingHom.comp
        (Ideal.Quotient.mk I) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_comp, RingHom.coe_coe,
        Function.comp_apply, MvPolynomial.map_C, ψ₀, MvPolynomial.aeval_C,
        Algebra.TensorProduct.includeRight_apply]
      have e1 : (MvPolynomial.C a : MvPolynomial (Fin n) A) =
          algebraMap A (MvPolynomial (Fin n) A) a := rfl
      rw [e1, Ideal.Quotient.mk_algebraMap, ← Algebra.TensorProduct.algebraMap_apply',
        IsScalarTower.algebraMap_apply A k (TensorProduct A k Rm), hrA]
    · intro i
      simp [ψ₀, x]
  have hψ : ∀ a ∈ I', ψ₀ a = 0 := by
    have h1 : ψ₀ (MvPolynomial.map r G) = 0 := by
      have := RingHom.congr_fun hψ0 G
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, RingHom.coe_comp,
        Function.comp_apply] at this
      rw [this, Ideal.Quotient.eq_zero_iff_mem.mpr hGI, map_zero]
    have hle : I' ≤ RingHom.ker ψ₀.toRingHom := by
      rw [hI', Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, ← F1]
      exact h1
    intro a ha
    exact hle ha
  let ψ : R' →ₐ[k] TensorProduct A k Rm := Ideal.Quotient.liftₐ I' ψ₀ hψ
  have hfX : ∀ i, f (Ideal.Quotient.mk I (MvPolynomial.X i)) = y i := by
    intro i
    show MvPolynomial.aeval y (MvPolynomial.X i) = y i
    exact MvPolynomial.aeval_X _ _
  have hψX : ∀ i, ψ (Ideal.Quotient.mk I' (MvPolynomial.X i)) = x i := by
    intro i
    show MvPolynomial.aeval x (MvPolynomial.X i) = x i
    exact MvPolynomial.aeval_X _ _
  have hφX : ∀ m : Rm, φ ((1 : k) ⊗ₜ[A] m) = f m := by
    intro m
    simp only [φ]
    rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  have h1 : φ.comp ψ = AlgHom.id k R' := by
    apply Ideal.Quotient.algHom_ext k
    apply MvPolynomial.algHom_ext
    intro i
    show φ (ψ (Ideal.Quotient.mk I' (MvPolynomial.X i))) = Ideal.Quotient.mk I' (MvPolynomial.X i)
    rw [hψX, hφX, hfX]
  have h2 : ψ.comp φ = AlgHom.id k (TensorProduct A k Rm) := by
    apply Algebra.TensorProduct.ext_ring
    apply Ideal.Quotient.algHom_ext A
    apply MvPolynomial.algHom_ext
    intro i
    show ψ (φ ((1 : k) ⊗ₜ[A] Ideal.Quotient.mk I (MvPolynomial.X i))) =
      (1 : k) ⊗ₜ[A] Ideal.Quotient.mk I (MvPolynomial.X i)
    rw [hφX, hfX, hψX]
  let ρ : TensorProduct A Rm k ≃+* R' :=
    (Algebra.TensorProduct.comm A Rm k).toRingEquiv.trans (AlgEquiv.ofAlgHom φ ψ h1 h2).toRingEquiv
  have hσ : wcQmSp A = Spec.map (CommRingCat.ofHom (algebraMap A k)) := by rw [hrA]
  obtain ⟨e1⟩ := s1 pb (wcQmSp A) j (wcQuadModelStr A n π c) hcomm
  exact ⟨e1 ≪≫ Limits.pullback.congrHom rfl hσ ≪≫ pullbackSpecIso A Rm k ≪≫
    (Scheme.Spec.mapIso ρ.toCommRingCatIso.op).symm⟩

theorem wc_qm_vertex_local_global : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (n : ℕ), Even n → 2 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det → ∀ (x₀ : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → ∀ (Xb : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) [LocallyOfFiniteType pb] (j : Spec (.of (wcQuadModelRing A n π c)) ⟶ Xb) [IsOpenImmersion j], j ≫ pb = wcQuadModelStr A n π c → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback (wcQuadModelStr A n π c) ξ)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (z : ↥(Limits.pullback pb (wcQmSp A))), Limits.pullback.fst pb (wcQmSp A) z = j x₀ → wcQmOffV (wcQmUs z) (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z) inf_le_left (wcQmCx (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j) (Limits.pullback.fst pb (wcQmSp A)) I.cocomplex) ℓ → ∀ q : ℕ, Nonempty (wcQmHyp (Limits.pullback pb (wcQmSp A)) (wcQmCx (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j) (Limits.pullback.fst pb (wcQmSp A)) I.cocomplex) q ≃ (wcEtStalk (Limits.pullback pb (wcQmSp A)) z).obj ((wcQmCx (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j) (Limits.pullback.fst pb (wcQmSp A)) I.cocomplex).homology q)) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX Ω _ _ ξ hξ Xb pb _ j _ hcomm I z hz hoff q
  classical

  obtain ⟨hzcl, hzsep, hzclos⟩ :=
    wc_qm_vertex_point_closed A n π c hπ x₀ hX Xb pb j hcomm z hz
  have hUs : ∀ y : ↥(Limits.pullback pb (wcQmSp A)), y ≠ z → y ∈ wcQmUs z := by
    intro y hy
    show y ∈ (closure ({z} : Set ↥(Limits.pullback pb (wcQmSp A))))ᶜ
    rw [hzclos]
    simpa using hy

  obtain ⟨J, φ, hφ⟩ := hoff
  obtain ⟨ψ₁, hψ₁⟩ := wc_qm_open_restrict_push_stalk_iso (Limits.pullback pb (wcQmSp A))
    (wcQmUs z) _ _ φ hφ

  haveI := wc_et_enough_injectives
    ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u})
  let IO := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
    ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u}))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
  obtain ⟨ψ₂, hψ₂⟩ := wc_qm_open_push_compare_stalk_iso (Limits.pullback pb (wcQmSp A))
    (Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange) (wcQmUs z)
    (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z) inf_le_right inf_le_left ℓ IO J

  obtain ⟨e⟩ := wc_qm_special_chart_iso A n π c hπ Xb pb j hcomm
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have h1 := hunit.map (IsLocalRing.residue A)
    rw [map_natCast] at h1
    exact h1.ne_zero
  obtain ⟨h0, hv⟩ := wc_et_quadric_cone_acyclic (IsLocalRing.ResidueField A) ℓ hℓ hℓk n
    (c.map (IsLocalRing.residue A))
  have h0O : Nat.card (wcEtCoh
      ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u})
        ℓ 0) = ℓ := by
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e.hom ℓ 0
    rw [← Nat.card_congr E]
    exact h0
  have hvO : ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh
      ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u})
        ℓ q) := by
    intro q hq
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e.hom ℓ q
    haveI := hv q hq
    exact E.symm.subsingleton
  have hzO : z ∈ (Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) := by
    show Limits.pullback.fst pb (wcQmSp A) z ∈ j.opensRange
    rw [Scheme.Hom.mem_opensRange]
    exact ⟨x₀, hz.symm⟩

  have hE1 := wc_qm_edge_open_push_acyclic (Limits.pullback pb (wcQmSp A))
    (Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange) z hzO ℓ hℓ.ne_zero IO h0O hvO

  have hE2 := (wc_qm_edge_two_of_three (Limits.pullback pb (wcQmSp A)) z hzcl hzsep _ _ ψ₂
    (fun y hy p => hψ₂ y ⟨wcQmUs z, hUs y hy, (inf_left_idem _ _).symm⟩ p)).mp hE1
  have hE3 := (wc_qm_edge_two_of_three (Limits.pullback pb (wcQmSp A)) z hzcl hzsep _ _ ψ₁
    (fun y hy p => hψ₁ y (hUs y hy) p)).mpr hE2
  exact ⟨Equiv.ofBijective _ (hE3 q)⟩

theorem wc_qm_nearby_stalk_milnor : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X Xb : Scheme.{u}) (f : X ⟶ Spec (.of A)) (pb : Xb ⟶ Spec (.of A)) (j : X ⟶ Xb) [IsOpenImmersion j], j ≫ pb = f → ∀ (Ω : Type u) [Field Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (x₀ : X) (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x₀)) (Scheme.Etale.forget X)) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ X), wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ → ∀ (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f ξ)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (z : ↥(Limits.pullback pb (wcQmSp A))), Limits.pullback.fst pb (wcQmSp A) z = j x₀ → ∀ q : ℕ, Nonempty ((wcEtStalk (Limits.pullback pb (wcQmSp A)) z).obj ((wcQmCx (Limits.pullback.fst f ξ ≫ j) (Limits.pullback.fst pb (wcQmSp A)) I.cocomplex).homology q) ≃ wcEtCoh (Limits.pullback (a₀ ≫ f) ξ) m q) :=
by
  intro A _ _ X Xb f pb j _ hcomm Ω _ ξ x₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hB₀ m I z hz q
  obtain ⟨hinit, haff, hcomp, hφa, huniv, -⟩ := hB₀

  have e1 : Nonempty ((wcEtStalk (Limits.pullback pb (wcQmSp A)) z).obj
      ((wcQmCx (Limits.pullback.fst f ξ ≫ j) (Limits.pullback.fst pb (wcQmSp A)) I.cocomplex).homology q) ≃
      (wcEtStalk Xb (j x₀)).obj ((((wcEtPush (Limits.pullback.fst f ξ ≫ j)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) := by
    obtain ⟨σ⟩ := wc_qm_inv_stalk (Limits.pullback.fst pb (wcQmSp A)) z
    rw [hz] at σ
    obtain ⟨hl1, hc1⟩ := wc_et_stalk_exact (Limits.pullback pb (wcQmSp A)) z
    obtain ⟨hl2, hc2⟩ := wc_et_stalk_exact Xb (j x₀)
    haveI := hl1
    haveI := hc1
    haveI := hl2
    haveI := hc2
    haveI : (wcEtStalk (Limits.pullback pb (wcQmSp A)) z).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_preserves_terminal_object
    haveI : (wcEtStalk Xb (j x₀)).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_preserves_terminal_object
    haveI := Functor.preservesHomologyOfExact (wcEtStalk (Limits.pullback pb (wcQmSp A)) z)
    haveI := Functor.preservesHomologyOfExact (wcEtStalk Xb (j x₀))
    let K := ((wcEtPush (Limits.pullback.fst f ξ ≫ j)).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex
    let L := ((wcQmInv (Limits.pullback.fst pb (wcQmSp A))).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj K
    let S := wcEtStalk (Limits.pullback pb (wcQmSp A)) z
    let S' := wcEtStalk Xb (j x₀)
    let i1 : ((S.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).homology q ≅ S.obj (L.homology q) :=
      ShortComplex.mapHomologyIso (L.sc q) S
    let i2 : (S.mapHomologicalComplex (ComplexShape.up ℕ)).obj L ≅
        (S'.mapHomologicalComplex (ComplexShape.up ℕ)).obj K :=
      (Functor.mapHomologicalComplexCompIso σ (ComplexShape.up ℕ)).app K
    let i3 := HomologicalComplex.homologyMapIso i2 q
    let i4 : ((S'.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q ≅ S'.obj (K.homology q) :=
      ShortComplex.mapHomologyIso (K.sc q) S'
    exact ⟨(i1.symm ≪≫ i3 ≪≫ i4).addCommGroupIsoToAddEquiv.toEquiv⟩

  obtain ⟨W₀', hinit', ⟨θ⟩⟩ := wc_et_open_imm_shens_transport j x₀ Λ₀ W₀ hinit

  obtain ⟨e2⟩ := wc_et_stalk_push_homology (Limits.pullback.fst f ξ ≫ j) (j x₀) Λ₀ W₀' hinit'
    I.cocomplex q

  have hβ : ∀ {M : Scheme.{u}} (g : M ⟶ X),
      Nonempty (wcEtSliceOf X j inferInstance ⋙ wcEtBaseChange (g ≫ j) ≅ wcEtBaseChange g) := by
    intro M g
    let βe : ∀ V : X.Etale, Limits.pullback (V.hom ≫ j) (g ≫ j) ≅ Limits.pullback V.hom g := fun V =>
      { hom := Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _)
          (by
            haveI := IsOpenImmersion.mono j
            rw [← cancel_mono j, Category.assoc, Category.assoc]; exact Limits.pullback.condition)
        inv := Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _)
          (by rw [← Category.assoc, Limits.pullback.condition, Category.assoc])
        hom_inv_id := by
          apply Limits.pullback.hom_ext
          · erw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst, Category.id_comp]
          · erw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]
        inv_hom_id := by
          apply Limits.pullback.hom_ext
          · erw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst, Category.id_comp]
          · erw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp] }
    let βc : ∀ V : X.Etale, (wcEtSliceOf X j inferInstance ⋙ wcEtBaseChange (g ≫ j)).obj V ≅
        (wcEtBaseChange g).obj V := fun V =>
      MorphismProperty.Over.isoMk (βe V) (Limits.pullback.lift_snd _ _ _)
    refine ⟨NatIso.ofComponents βc ?_⟩
    intro V V' φ
    apply MorphismProperty.Over.Hom.ext
    show ((wcEtSliceOf X j inferInstance ⋙ wcEtBaseChange (g ≫ j)).map φ).left ≫ (βe V').hom =
      (βe V).hom ≫ ((wcEtBaseChange g).map φ).left
    have a1 : (βe V').hom ≫ Limits.pullback.fst V'.hom g = Limits.pullback.fst _ _ :=
      Limits.pullback.lift_fst _ _ _
    have a2 : ((wcEtBaseChange g).map φ).left ≫ Limits.pullback.fst V'.hom g =
        Limits.pullback.fst V.hom g ≫ φ.left := by
      first
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]
    have a3 : ((wcEtSliceOf X j inferInstance ⋙ wcEtBaseChange (g ≫ j)).map φ).left ≫
        Limits.pullback.fst (V'.hom ≫ j) (g ≫ j) = Limits.pullback.fst (V.hom ≫ j) (g ≫ j) ≫ φ.left := by
      first
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]
    have a4' : (βe V).hom ≫ Limits.pullback.fst V.hom g = Limits.pullback.fst (V.hom ≫ j) (g ≫ j) :=
      Limits.pullback.lift_fst _ _ _
    have b1 : (βe V').hom ≫ Limits.pullback.snd V'.hom g = Limits.pullback.snd _ _ :=
      Limits.pullback.lift_snd _ _ _
    have b2 : ((wcEtBaseChange g).map φ).left ≫ Limits.pullback.snd V'.hom g =
        Limits.pullback.snd V.hom g := by
      first
      | exact Limits.pullback.lift_snd _ _ _
      | simp [wcEtBaseChange]
    have b3 : ((wcEtSliceOf X j inferInstance ⋙ wcEtBaseChange (g ≫ j)).map φ).left ≫
        Limits.pullback.snd (V'.hom ≫ j) (g ≫ j) = Limits.pullback.snd (V.hom ≫ j) (g ≫ j) := by
      first
      | exact Limits.pullback.lift_snd _ _ _
      | simp [wcEtBaseChange]
    have b4 : (βe V).hom ≫ Limits.pullback.snd V.hom g = Limits.pullback.snd _ _ :=
      Limits.pullback.lift_snd _ _ _
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans ((congrArg (fun t => _ ≫ t) a1).trans (a3.trans
        (((congrArg (fun t => t ≫ φ.left) a4').symm.trans (Category.assoc _ _ _)).trans
          ((congrArg (fun t => (βe V).hom ≫ t) a2).symm.trans (Category.assoc _ _ _).symm))))
    · exact (Category.assoc _ _ _).trans ((congrArg (fun t => _ ≫ t) b1).trans (b3.trans
        (b4.symm.trans
          ((congrArg (fun t => (βe V).hom ≫ t) b2).symm.trans (Category.assoc _ _ _).symm))))
  obtain ⟨β⟩ := hβ (Limits.pullback.fst f ξ)
  let PX := StructuredArrow.proj (Over.mk (wcEtGeomPt X x₀)) (Scheme.Etale.forget X)
  let PXb := StructuredArrow.proj (Over.mk (wcEtGeomPt Xb (j x₀))) (Scheme.Etale.forget Xb)
  let γ : (W₀' ⋙ PXb) ⋙ wcEtBaseChange (Limits.pullback.fst f ξ ≫ j) ≅
      (W₀ ⋙ PX) ⋙ wcEtBaseChange (Limits.pullback.fst f ξ) :=
    Functor.isoWhiskerRight θ _ ≪≫ Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft W₀ (Functor.associator _ _ _) ≪≫
      Functor.isoWhiskerLeft W₀ (Functor.isoWhiskerLeft PX β) ≪≫
      (Functor.associator _ _ _).symm

  let δ : (Functor.whiskeringLeft (Xb.Etale)ᵒᵖ ((Limits.pullback f ξ).Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (wcEtBaseChange (Limits.pullback.fst f ξ ≫ j)).op ⋙
        (Functor.whiskeringLeft Λ₀ᵒᵖ (Xb.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (W₀' ⋙ PXb).op ≅
      (Functor.whiskeringLeft (X.Etale)ᵒᵖ ((Limits.pullback f ξ).Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (wcEtBaseChange (Limits.pullback.fst f ξ)).op ⋙
        (Functor.whiskeringLeft Λ₀ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (W₀ ⋙ PX).op :=
    (Functor.whiskeringLeftObjCompIso (E := AddCommGrpCat.{u+1}) (W₀' ⋙ PXb).op
        (wcEtBaseChange (Limits.pullback.fst f ξ ≫ j)).op).symm ≪≫
      ((Functor.whiskeringLeft Λ₀ᵒᵖ ((Limits.pullback f ξ).Etale)ᵒᵖ AddCommGrpCat.{u+1}).mapIso
        (NatIso.op γ)).symm ≪≫
      Functor.whiskeringLeftObjCompIso (E := AddCommGrpCat.{u+1}) (W₀ ⋙ PX).op
        (wcEtBaseChange (Limits.pullback.fst f ξ)).op
  let ε := Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology (Limits.pullback f ξ))
      AddCommGrpCat.{u+1})
    ((Functor.associator _ _ Limits.colim).symm ≪≫ Functor.isoWhiskerRight δ Limits.colim ≪≫
      Functor.associator _ _ Limits.colim)
  have e3 := (HomologicalComplex.homologyMapIso
    ((NatIso.mapHomologicalComplex ε (ComplexShape.up ℕ)).app I.cocomplex) q).addCommGroupIsoToAddEquiv.toEquiv

  haveI : MorphismProperty.IsStableUnderBaseChangeAlong (@IsAffineHom : MorphismProperty Scheme.{u}) f :=
    (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@IsAffineHom : MorphismProperty Scheme.{u})
  haveI hgaff : IsAffineHom (Limits.pullback.fst f ξ) :=
    MorphismProperty.pullback_fst (P := @IsAffineHom) f ξ (isAffineHom_of_isAffine ξ)

  obtain ⟨e4⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst f ξ) B₀ Λ₀ (W₀ ⋙ PX) φ₀ a₀
    haff hcomp hφa huniv m I q

  let P0iso : Limits.pullback (Limits.pullback.fst f ξ) a₀ ≅ Limits.pullback (a₀ ≫ f) ξ :=
    Limits.pullbackSymmetry _ _ ≪≫ Limits.pullbackRightPullbackFstIso f ξ a₀
  obtain ⟨e5⟩ := wc_et_coh_iso_invariance P0iso.hom m q
  obtain ⟨e1⟩ := e1
  exact ⟨e1.trans (e2.trans (e3.trans (e4.trans e5.symm)))⟩

theorem wc_quadric_model_milnor_generic_fibre_coh_equiv : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (n : ℕ), Even n → 2 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det → ∀ (x₀ : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) → wcQuadModelStr A n π c x₀ = IsLocalRing.closedPoint A → ∀ (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀)) (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))), wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → ∀ q : ℕ, Nonempty (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) ℓ q ≃ wcEtCoh (Limits.pullback (wcQuadModelStr A n π c) ξ) ℓ q) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX hx₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hB₀ Ω _ _ ξ
    hξ q
  obtain ⟨Xb, pb, j, hprop, hopen, hcomm, hsm, hbd⟩ :=
    wc_qm_projective_closure_geometry A n hn hn2 π c hπ hc x₀ hX
  haveI := hprop
  haveI := hopen
  haveI := wc_et_enough_injectives (Limits.pullback (wcQuadModelStr A n π c) ξ)
  let I := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
    (Limits.pullback (wcQuadModelStr A n π c) ξ)) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
  have hσ : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      IsLocalRing.closedPoint A :=
    IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
  have hpt : pb (j x₀) = (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    rw [hσ, ← hx₀, ← hcomm, Scheme.Hom.comp_apply]
  obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (j x₀) _ hpt
  obtain ⟨e1⟩ := wc_qm_leray_hyper _ _
    (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j) ℓ I q
  obtain ⟨e2⟩ := wc_qm_pbc_hyper A Xb _ pb
    (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j) ℓ hℓ.ne_zero I q
  have hoff := wc_qm_off_vertex_comparison A ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX Ω ξ hξ Xb pb j
    hcomm hsm hbd I z hz
  obtain ⟨e3⟩ := wc_qm_vertex_local_global A ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX Ω ξ hξ Xb pb j
    hcomm I z hz hoff q
  obtain ⟨e4⟩ := wc_qm_nearby_stalk_milnor A _ Xb (wcQuadModelStr A n π c) pb j hcomm Ω ξ x₀ B₀
    Λ₀ W₀ φ₀ a₀ hB₀ ℓ I z hz q
  exact ⟨(e1.trans (e2.trans (e3.trans e4))).symm⟩

theorem wc_quadric_model_generic_fibre_hyperbolic_iso : ∀ (A : Type u) [CommRing A] (n : ℕ), Even n → 2 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A), IsUnit (c + c.transpose).det → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), (Spec.preimage ξ).hom π ≠ 0 → Nonempty (Limits.pullback (wcQuadModelStr A n π c) ξ ≅ Spec (.of (wcQuadModelRing Ω n 1 (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)))) :=
by
  suffices hnf : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (d : ℕ), Even d → ∀ (A : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) Ω), (A + A.transpose).det ≠ 0 → ∃ P : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) Ω, IsUnit P.det ∧ wcLdpQuad Ω (d + 1) (fun p q => (P.transpose * A * P) p q) = wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) by

    have t_bc : ∀ (A : Type u) [CommRing A] (n : ℕ) (π : A) (c : Matrix (Fin n) (Fin n) A)
        (B : Type u) [CommRing B] (ξ : Spec (.of B) ⟶ Spec (.of A)),
        Nonempty (Limits.pullback (wcQuadModelStr A n π c) ξ ≅
          Spec (.of (wcQuadModelRing B n ((Spec.preimage ξ).hom π)
            (c.map (Spec.preimage ξ).hom)))) := by
      intro A _ n π c B _ ξ
      classical
      letI : Algebra A B := (Spec.preimage ξ).hom.toAlgebra
      have hξ : ξ = Spec.map (CommRingCat.ofHom (algebraMap A B)) := by
        rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
      let I := wcQuadModelIdeal A n π c
      let J := wcQuadModelIdeal B n ((Spec.preimage ξ).hom π) (c.map (Spec.preimage ξ).hom)
      let e₁ := Limits.pullback.congrHom (rfl : wcQuadModelStr A n π c = _) hξ
      let e₂ := pullbackSpecIso A (wcQuadModelRing A n π c) B
      let E₁ := Algebra.TensorProduct.comm A (wcQuadModelRing A n π c) B
      let E₂ := Algebra.TensorProduct.tensorQuotientEquiv (R := A) B (MvPolynomial (Fin n) A) B I
      let f := (MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) A B).toRingEquiv
      have hJ : J = Ideal.map
          (f : TensorProduct A B (MvPolynomial (Fin n) A) →+* MvPolynomial (Fin n) B)
          (Ideal.map (Algebra.TensorProduct.includeRight :
            MvPolynomial (Fin n) A →ₐ[A] TensorProduct A B (MvPolynomial (Fin n) A)) I) := by
        show Ideal.span _ = Ideal.map _ (Ideal.map _ (Ideal.span _))
        rw [Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
        refine congrArg (fun x => Ideal.span {x}) ?_
        rw [Algebra.TensorProduct.includeRight_apply]
        show _ = MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) A B (1 ⊗ₜ[A] _)
        rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
        simp [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X,
          Matrix.map_apply, RingHom.algebraMap_toAlgebra]
      let E₃ := Ideal.quotientEquiv _ J f hJ
      let E := E₁.toRingEquiv.trans (E₂.toRingEquiv.trans E₃)
      exact ⟨e₁ ≪≫ e₂ ≪≫ Scheme.Spec.mapIso E.symm.toCommRingCatIso.op⟩

    have t_subst : ∀ (K : Type u) [Field K] (n : ℕ) (c c' P : Matrix (Fin n) (Fin n) K)
        (u t t' : K), IsUnit P.det → u ≠ 0 → t = u * t' →
        (∑ p, ∑ q, MvPolynomial.C ((P.transpose * c * P) p q) * MvPolynomial.X p *
          MvPolynomial.X q : MvPolynomial (Fin n) K) =
          MvPolynomial.C u * ∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p *
            MvPolynomial.X q →
        Nonempty (wcQuadModelRing K n t c ≃+* wcQuadModelRing K n t' c') := by
      intro K _ n c c' P u t t' hP hu ht hQ
      classical
      let σ : Matrix (Fin n) (Fin n) K → (MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin n) K) :=
        fun M => MvPolynomial.aeval (fun p => ∑ i, MvPolynomial.C (M p i) * MvPolynomial.X i)
      have hσX : ∀ M p, σ M (MvPolynomial.X p) =
          ∑ i, MvPolynomial.C (M p i) * MvPolynomial.X i := by
        intro M p
        simp only [σ, MvPolynomial.aeval_X]
      have hσC : ∀ M (r : K), σ M (MvPolynomial.C r) = MvPolynomial.C r := by
        intro M r
        rw [MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq]
      have hcomp : ∀ M N, (σ M).comp (σ N) = σ (N * M) := by
        intro M N
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply, hσX, hσX, map_sum]
        simp only [map_mul, hσC, hσX, Finset.mul_sum, Matrix.mul_apply, map_sum, Finset.sum_mul]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => ?_
        ring
      have hone : σ 1 = AlgHom.id K _ := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [hσX]
        simp [Matrix.one_apply]
      have h1 : (σ P).comp (σ P⁻¹) = AlgHom.id K _ := by
        rw [hcomp, Matrix.nonsing_inv_mul _ hP, hone]
      have h2 : (σ P⁻¹).comp (σ P) = AlgHom.id K _ := by
        rw [hcomp, Matrix.mul_nonsing_inv _ hP, hone]
      let e := AlgEquiv.ofAlgHom (σ P) (σ P⁻¹) h1 h2
      have hsum : ∀ (f : Fin n → Fin n → Fin n → Fin n → MvPolynomial (Fin n) K),
          ∑ p, ∑ q, ∑ i, ∑ j, f p q i j = ∑ i, ∑ j, ∑ q, ∑ p, f p q j i := by
        intro f
        calc ∑ p, ∑ q, ∑ i, ∑ j, f p q i j = ∑ p, ∑ i, ∑ q, ∑ j, f p q i j :=
              Finset.sum_congr rfl (fun p _ => Finset.sum_comm)
          _ = ∑ i, ∑ p, ∑ q, ∑ j, f p q i j := Finset.sum_comm
          _ = ∑ i, ∑ p, ∑ j, ∑ q, f p q i j :=
              Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun p _ => Finset.sum_comm))
          _ = ∑ i, ∑ j, ∑ p, ∑ q, f p q i j := Finset.sum_congr rfl (fun i _ => Finset.sum_comm)
          _ = ∑ i, ∑ j, ∑ q, ∑ p, f p q i j :=
              Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => Finset.sum_comm))
          _ = ∑ j, ∑ i, ∑ q, ∑ p, f p q i j := Finset.sum_comm
      have hkey : ∀ M : Matrix (Fin n) (Fin n) K,
          σ P (∑ p, ∑ q, MvPolynomial.C (M p q) * MvPolynomial.X p * MvPolynomial.X q) =
          ∑ p, ∑ q, MvPolynomial.C ((P.transpose * M * P) p q) * MvPolynomial.X p *
            MvPolynomial.X q := by
        intro M
        simp only [map_sum, map_mul, hσC, hσX]
        simp only [Matrix.mul_apply, Matrix.transpose_apply, map_sum, map_mul, Finset.sum_mul,
          Finset.mul_sum]
        refine (hsum _).trans ?_
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
          Finset.sum_congr rfl fun q _ => Finset.sum_congr rfl fun p _ => ?_
        ring
      have hgen : σ P (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C t) = MvPolynomial.C u * (∑ p, ∑ q, MvPolynomial.C (c' p q) *
            MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C t') := by
        rw [map_sub, hkey, hQ, hσC, ht, map_mul, mul_sub]
      have hJ : wcQuadModelIdeal K n t' c' =
          Ideal.map (e.toRingEquiv : MvPolynomial (Fin n) K →+* MvPolynomial (Fin n) K)
            (wcQuadModelIdeal K n t c) := by
        show Ideal.span _ = Ideal.map _ (Ideal.span _)
        rw [Ideal.map_span, Set.image_singleton]
        show _ = Ideal.span {σ P _}
        rw [hgen]
        exact (Ideal.span_singleton_mul_left_unit
          ((isUnit_iff_ne_zero.mpr hu).map MvPolynomial.C) _).symm
      exact ⟨Ideal.quotientEquiv _ _ e.toRingEquiv hJ⟩

    intro A _ n hn hn2 π c hc Ω _ _ ξ hπ0
    classical
    obtain ⟨d, rfl⟩ : ∃ d, n = d + 1 + 1 := ⟨n - 2, by omega⟩
    have hd : Even d := by
      obtain ⟨k, hk⟩ := hn
      exact ⟨k - 1, by omega⟩
    have hdet : (c.map (Spec.preimage ξ).hom + (c.map (Spec.preimage ξ).hom).transpose).det ≠ 0 := by
      have h1 := hc.map (Spec.preimage ξ).hom
      rw [RingHom.map_det, RingHom.mapMatrix_apply, Matrix.map_add _ (map_add _),
        Matrix.transpose_map] at h1
      exact h1.ne_zero
    obtain ⟨P₀, hP₀, hNF⟩ := hnf Ω d hd _ hdet
    have hNF' : (∑ p, ∑ q, MvPolynomial.C ((P₀.transpose * c.map (Spec.preimage ξ).hom * P₀) p q) *
        (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (d + 1 + 1)) Ω) =
        ∑ p, ∑ q, MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) *
          (MvPolynomial.X p * MvPolynomial.X q) :=
      congrArg Subtype.val hNF
    obtain ⟨s, hs⟩ := IsAlgClosed.exists_pow_nat_eq ((Spec.preimage ξ).hom π) (by norm_num : 0 < 2)
    have hs0 : s ≠ 0 := by
      rintro rfl
      apply hπ0
      rw [← hs]
      ring
    have hm : (s • P₀).transpose * c.map (Spec.preimage ξ).hom * (s • P₀) =
        (s ^ 2) • (P₀.transpose * c.map (Spec.preimage ξ).hom * P₀) := by
      rw [Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, Matrix.smul_mul, smul_smul, sq]
    have hQ : (∑ p, ∑ q, MvPolynomial.C (((s • P₀).transpose * c.map (Spec.preimage ξ).hom *
        (s • P₀)) p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (d + 1 + 1)) Ω) =
        MvPolynomial.C (s ^ 2) * ∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) p q) * MvPolynomial.X p *
            MvPolynomial.X q := by
      rw [hm]
      calc _ = ∑ p, ∑ q, MvPolynomial.C (s ^ 2) *
              (MvPolynomial.C ((P₀.transpose * c.map (Spec.preimage ξ).hom * P₀) p q) *
                (MvPolynomial.X p * MvPolynomial.X q)) := by
            refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
            rw [Matrix.smul_apply, smul_eq_mul, map_mul]
            ring
        _ = MvPolynomial.C (s ^ 2) * ∑ p, ∑ q,
              MvPolynomial.C ((P₀.transpose * c.map (Spec.preimage ξ).hom * P₀) p q) *
                (MvPolynomial.X p * MvPolynomial.X q) := by
            simp only [Finset.mul_sum]
        _ = MvPolynomial.C (s ^ 2) * ∑ p, ∑ q,
              MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) *
                (MvPolynomial.X p * MvPolynomial.X q) := by
            rw [hNF']
        _ = _ := by
            refine congrArg _ ?_
            refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
            rw [Matrix.of_apply]
            ring
    have hdetP : IsUnit (s • P₀).det := by
      rw [Matrix.det_smul]
      exact ((isUnit_iff_ne_zero.mpr hs0).pow _).mul hP₀
    obtain ⟨e⟩ := t_subst Ω (d + 1 + 1) (c.map (Spec.preimage ξ).hom)
      (Matrix.of fun p q : Fin (d + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)
      (s • P₀) (s ^ 2) ((Spec.preimage ξ).hom π) 1 hdetP (pow_ne_zero 2 hs0)
      (by rw [hs, mul_one]) hQ
    obtain ⟨θ₁⟩ := t_bc A (d + 1 + 1) π c Ω ξ
    exact ⟨θ₁ ≪≫ Scheme.Spec.mapIso e.symm.toCommRingCatIso.op⟩


  have t_s1 : ∀ (L : Type u) [Field L] (N : ℕ) (a b : Fin (N + 1) → Fin (N + 1) → L),
      (∀ p, a p p = b p p) → (∀ p q, a p q + a q p = b p q + b q p) →
      wcLdpQuad L N a = wcLdpQuad L N b := by
    intro L _ N a b hd hs
    apply Subtype.ext
    show (∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
      ∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C (b p q) * (MvPolynomial.X p * MvPolynomial.X q)
    obtain ⟨F, hF⟩ : ∃ F : Fin (N + 1) → Fin (N + 1) → MvPolynomial (Fin (N + 1)) L,
        ∀ p q, F p q = MvPolynomial.C (a p q - b p q) * (MvPolynomial.X p * MvPolynomial.X q) :=
      ⟨_, fun _ _ => rfl⟩
    have key : ∑ x : Fin (N + 1) × Fin (N + 1), F x.1 x.2 = 0 := by
      refine Finset.sum_involution (fun x _ => (x.2, x.1)) ?_ ?_
        (fun _ _ => Finset.mem_univ _) (fun _ _ => rfl)
      · intro x _
        show F x.1 x.2 + F x.2 x.1 = 0
        rw [hF, hF, mul_comm (MvPolynomial.X x.2) (MvPolynomial.X x.1), ← add_mul, ← map_add]
        have h0 : a x.1 x.2 - b x.1 x.2 + (a x.2 x.1 - b x.2 x.1) = 0 := by
          linear_combination hs x.1 x.2
        rw [h0, map_zero, zero_mul]
      · intro x _ hx heq
        apply hx
        have h21 : x.2 = x.1 := congrArg Prod.fst heq
        rw [hF, h21, hd, sub_self, map_zero, zero_mul]
    have key2 : ∑ x : Fin (N + 1), ∑ y : Fin (N + 1), F x y = 0 :=
      (Fintype.sum_prod_type' F).symm.trans key
    rw [← sub_eq_zero]
    refine Eq.trans ?_ key2
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [hF, map_sub, sub_mul]
  have t_s2a : ∀ (K : Type u) [Field K] (n m : ℕ) (f : ℕ → Fin n → K), m + 2 ≤ n →
      ∃ u₁ u₂ : Fin n → K, (∀ p < m, f p ⬝ᵥ u₁ = 0) ∧ (∀ p < m, f p ⬝ᵥ u₂ = 0) ∧
        ∀ s t : K, s • u₁ + t • u₂ = 0 → s = 0 ∧ t = 0 := by
    intro K _ n m f hmn
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin n → K) →ₗ[K] (Fin m → K), ∀ u p, Φ u p = f p.val ⬝ᵥ u :=
      ⟨(Matrix.of (fun (p : Fin m) (i : Fin n) => f p.val i)).mulVecLin, fun _ _ => rfl⟩
    have hrank := LinearMap.finrank_range_add_finrank_ker Φ
    rw [Module.finrank_fin_fun] at hrank
    have hr : Module.finrank K (LinearMap.range Φ) ≤ m := by
      have := Submodule.finrank_le (LinearMap.range Φ)
      rwa [Module.finrank_fin_fun] at this
    have hk : 1 < Module.finrank K (LinearMap.ker Φ) := by omega
    obtain ⟨x, hx⟩ := Module.finrank_pos_iff_exists_ne_zero.mp
      (by omega : 0 < Module.finrank K (LinearMap.ker Φ))
    obtain ⟨y, hy⟩ := exists_linearIndependent_pair_of_one_lt_finrank hk hx
    refine ⟨(x : Fin n → K), (y : Fin n → K), ?_, ?_, ?_⟩
    · intro p hp
      have h0 : Φ x = 0 := x.2
      have := congrFun h0 ⟨p, hp⟩
      rw [hΦ] at this
      exact this
    · intro p hp
      have h0 : Φ y = 0 := y.2
      have := congrFun h0 ⟨p, hp⟩
      rw [hΦ] at this
      exact this
    · intro s t hst
      apply LinearIndependent.pair_iff.mp hy
      apply Subtype.ext
      simpa using hst
  have t_s2b : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ) (A : Matrix (Fin n) (Fin n) Ω)
      (u₁ u₂ : Fin n → Ω), ∃ s t : Ω, (s ≠ 0 ∨ t ≠ 0) ∧
        (s • u₁ + t • u₂) ⬝ᵥ (A.mulVec (s • u₁ + t • u₂)) = 0 := by
    intro Ω _ _ n A u₁ u₂
    have expand : ∀ s t : Ω, (s • u₁ + t • u₂) ⬝ᵥ (A.mulVec (s • u₁ + t • u₂)) =
        s ^ 2 * (u₁ ⬝ᵥ A.mulVec u₁) + s * t * (u₁ ⬝ᵥ A.mulVec u₂ + u₂ ⬝ᵥ A.mulVec u₁) +
          t ^ 2 * (u₂ ⬝ᵥ A.mulVec u₂) := by
      intro s t
      simp only [Matrix.mulVec_add, Matrix.mulVec_smul, dotProduct_add, add_dotProduct,
        dotProduct_smul, smul_dotProduct, smul_eq_mul]
      ring
    by_cases hα : u₁ ⬝ᵥ A.mulVec u₁ = 0
    · exact ⟨1, 0, Or.inl one_ne_zero, by rw [expand, hα]; ring⟩
    · obtain ⟨r, hr⟩ := IsAlgClosed.exists_root
        (Polynomial.C (u₁ ⬝ᵥ A.mulVec u₁) * Polynomial.X ^ 2 +
          Polynomial.C (u₁ ⬝ᵥ A.mulVec u₂ + u₂ ⬝ᵥ A.mulVec u₁) * Polynomial.X +
          Polynomial.C (u₂ ⬝ᵥ A.mulVec u₂))
        (by rw [Polynomial.degree_quadratic hα]; decide)
      refine ⟨r, 1, Or.inr one_ne_zero, ?_⟩
      rw [expand]
      simp only [Polynomial.IsRoot, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X] at hr
      linear_combination hr
  have t_s3 : ∀ (K : Type u) [Field K] (n : ℕ) (A M : Matrix (Fin n) (Fin n) K),
      M = A + A.transpose → M.det ≠ 0 → ∀ (m : ℕ) (e : ℕ → Fin n → K), Even m →
      (∀ p < m, ∀ q < m, e p ⬝ᵥ M.mulVec (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
      ∀ v : Fin n → K, v ≠ 0 → v ⬝ᵥ A.mulVec v = 0 → (∀ p < m, e p ⬝ᵥ M.mulVec v = 0) →
      ∃ w : Fin n → K, w ⬝ᵥ A.mulVec w = 0 ∧ v ⬝ᵥ M.mulVec w = 1 ∧
        ∀ p < m, e p ⬝ᵥ M.mulVec w = 0 := by
    intro K _ n A M hMdef hA m e hm he v hv hQv hve
    have hMT : M.transpose = M := by
      rw [hMdef, Matrix.transpose_add, Matrix.transpose_transpose]; exact add_comm _ _
    have hB : ∀ x y : Fin n → K, x ⬝ᵥ M.mulVec y = y ⬝ᵥ M.mulVec x := by
      intro x y
      rw [Matrix.dotProduct_mulVec, dotProduct_comm, ← Matrix.mulVec_transpose, hMT]
    have hI3 : ∀ x y : Fin n → K, x ⬝ᵥ A.mulVec y + y ⬝ᵥ A.mulVec x = x ⬝ᵥ M.mulVec y := by
      intro x y
      rw [hMdef, Matrix.add_mulVec, dotProduct_add, Matrix.mulVec_transpose,
        Matrix.dotProduct_mulVec y A x, dotProduct_comm (Matrix.vecMul y A) x]
    have hMv : M.mulVec v ≠ 0 := by
      intro h
      exact hA (Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv, h⟩)
    obtain ⟨r, hr⟩ := Function.ne_iff.mp hMv
    have hr' : M.mulVec v r ≠ 0 := hr
    obtain ⟨y, hy⟩ : ∃ y : Fin n → K, y = Pi.single r (M.mulVec v r)⁻¹ := ⟨_, rfl⟩
    have hvy : v ⬝ᵥ M.mulVec y = 1 := by
      rw [hB, hy, single_dotProduct, inv_mul_cancel₀ hr']
    obtain ⟨π, hπdef⟩ : ∃ π : ℕ → ℕ, π = fun j => if j % 2 = 0 then j + 1 else j - 1 :=
      ⟨_, rfl⟩
    have hπ1 : ∀ q j, (q / 2 = j / 2 ∧ q ≠ j) ↔ j = π q := by
      intro q j
      rw [hπdef]
      dsimp only
      split_ifs <;> constructor <;> intro h <;> omega
    have hπ2 : ∀ q, π (π q) = q := by
      intro q
      rw [hπdef]
      dsimp only
      split_ifs <;> omega
    obtain ⟨t, ht⟩ := hm
    have hπ3 : ∀ q < m, π q < m := by
      intro q hq
      rw [hπdef]
      dsimp only
      split_ifs <;> omega
    obtain ⟨z, hz⟩ : ∃ z : Fin n → K,
        z = y - ∑ j ∈ Finset.range m, (e (π j) ⬝ᵥ M.mulVec y) • e j := ⟨_, rfl⟩
    have hBz : ∀ x : Fin n → K, x ⬝ᵥ M.mulVec z = x ⬝ᵥ M.mulVec y -
        ∑ j ∈ Finset.range m, (e (π j) ⬝ᵥ M.mulVec y) * (x ⬝ᵥ M.mulVec (e j)) := by
      intro x
      rw [hz, Matrix.mulVec_sub, dotProduct_sub, Matrix.mulVec_sum, dotProduct_sum]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Matrix.mulVec_smul, dotProduct_smul, smul_eq_mul]
    have hez : ∀ q < m, e q ⬝ᵥ M.mulVec z = 0 := by
      intro q hq
      rw [hBz, Finset.sum_eq_single (π q)]
      · rw [he q hq (π q) (hπ3 q hq), if_pos ((hπ1 q (π q)).mpr rfl), hπ2, mul_one, sub_self]
      · intro j hj hjne
        rw [he q hq j (Finset.mem_range.mp hj), if_neg (fun h => hjne ((hπ1 q j).mp h)),
          mul_zero]
      · intro hnot
        exact absurd (Finset.mem_range.mpr (hπ3 q hq)) hnot
    have hvz : v ⬝ᵥ M.mulVec z = 1 := by
      rw [hBz, hvy, Finset.sum_eq_zero, sub_zero]
      intro j hj
      rw [hB v (e j), hve j (Finset.mem_range.mp hj), mul_zero]
    have hvv : v ⬝ᵥ M.mulVec v = 0 := by
      rw [← hI3, hQv, add_zero]
    refine ⟨z - (z ⬝ᵥ A.mulVec z) • v, ?_, ?_, ?_⟩
    · have hzv : z ⬝ᵥ A.mulVec v + v ⬝ᵥ A.mulVec z = 1 := by
        rw [hI3, hB, hvz]
      simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, sub_dotProduct,
        dotProduct_smul, smul_dotProduct, smul_eq_mul]
      linear_combination (-(z ⬝ᵥ A.mulVec z)) * hzv + (z ⬝ᵥ A.mulVec z) ^ 2 * hQv
    · rw [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, dotProduct_smul, hvz, hvv,
        smul_zero, sub_zero]
    · intro p hp
      rw [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, dotProduct_smul, hez p hp,
        hve p hp, smul_zero, sub_zero]
  have t_s4 : ∀ (K : Type u) [Field K] (n : ℕ) (Q : (Fin n → K) → K)
      (B : (Fin n → K) → (Fin n → K) → K), (∀ x y, B x y = B y x) → (∀ x, B x x = 2 * Q x) →
      (∀ (m : ℕ) (e : ℕ → Fin n → K), Even m → m + 2 ≤ n → (∀ p < m, Q (e p) = 0) →
        (∀ p < m, ∀ q < m, B (e p) (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
        ∃ v w : Fin n → K, Q v = 0 ∧ Q w = 0 ∧ B v w = 1 ∧ (∀ p < m, B (e p) v = 0) ∧
          (∀ p < m, B (e p) w = 0)) →
      ∀ k : ℕ, 2 * k ≤ n → ∃ e : ℕ → Fin n → K, (∀ p < 2 * k, Q (e p) = 0) ∧
        ∀ p < 2 * k, ∀ q < 2 * k, B (e p) (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0 := by
    intro K _ n Q B hBs hBd step k
    induction k with
    | zero =>
      intro _
      exact ⟨fun _ => 0, fun p hp => absurd hp (by omega), fun p hp => absurd hp (by omega)⟩
    | succ k ih =>
      intro hk
      obtain ⟨e, hQ, hBe⟩ := ih (by omega)
      obtain ⟨v, w, hQv, hQw, hvw, hev, hew⟩ := step (2 * k) e ⟨k, by ring⟩ (by omega) hQ hBe
      obtain ⟨e', he'⟩ : ∃ e' : ℕ → Fin n → K,
          ∀ p, e' p = if p = 2 * k then v else if p = 2 * k + 1 then w else e p :=
        ⟨_, fun _ => rfl⟩
      have e1 : e' (2 * k) = v := by rw [he', if_pos rfl]
      have e2 : e' (2 * k + 1) = w := by
        rw [he', if_neg (show ¬ (2 * k + 1 = 2 * k) by omega), if_pos rfl]
      have e3 : ∀ p < 2 * k, e' p = e p := by
        intro p hp
        rw [he', if_neg (show ¬ (p = 2 * k) by omega), if_neg (show ¬ (p = 2 * k + 1) by omega)]
      refine ⟨e', ?_, ?_⟩
      · intro p hp
        rcases (show p < 2 * k ∨ p = 2 * k ∨ p = 2 * k + 1 by omega) with h | rfl | rfl
        · rw [e3 p h]; exact hQ p h
        · rw [e1]; exact hQv
        · rw [e2]; exact hQw
      · intro p hp q hq
        rcases (show p < 2 * k ∨ p = 2 * k ∨ p = 2 * k + 1 by omega) with h | rfl | rfl <;>
        rcases (show q < 2 * k ∨ q = 2 * k ∨ q = 2 * k + 1 by omega) with h' | rfl | rfl
        · rw [e3 p h, e3 q h']; exact hBe p h q h'
        · rw [e3 p h, e1, hev p h, if_neg]; omega
        · rw [e3 p h, e2, hew p h, if_neg]; omega
        · rw [e1, e3 q h', hBs, hev q h', if_neg]; omega
        · rw [e1, hBd, hQv, mul_zero, if_neg]; omega
        · rw [e1, e2, hvw, if_pos]; omega
        · rw [e2, e3 q h', hBs, hew q h', if_neg]; omega
        · rw [e2, e1, hBs, hvw, if_pos]; omega
        · rw [e2, hBd, hQw, mul_zero, if_neg]; omega
  have t_s6 : ∀ (K : Type u) [Field K] (n : ℕ) (M : Matrix (Fin n) (Fin n) K)
      (e : ℕ → Fin n → K), Even n →
      (∀ p < n, ∀ q < n, e p ⬝ᵥ M.mulVec (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
      IsUnit (Matrix.of fun (i : Fin n) (p : Fin n) => e p.val i).det := by
    intro K _ n M e hn he
    rw [isUnit_iff_ne_zero]
    intro hdet
    obtain ⟨c, hc, hPc⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    apply hc
    have hsum : (Matrix.of fun (i : Fin n) (p : Fin n) => e p.val i).mulVec c =
        ∑ p : Fin n, c p • e p.val := by
      ext i
      rw [Finset.sum_apply]
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.smul_apply, smul_eq_mul, mul_comm]
    rw [hsum] at hPc
    obtain ⟨t, ht⟩ := hn
    funext q
    obtain ⟨q', hq'n, hq'⟩ : ∃ q' : ℕ, q' < n ∧
        ∀ j : ℕ, (q' / 2 = j / 2 ∧ q' ≠ j) ↔ j = q.val := by
      refine ⟨if q.val % 2 = 0 then q.val + 1 else q.val - 1, ?_, ?_⟩
      · have := q.isLt
        split_ifs <;> omega
      · intro j
        have := q.isLt
        split_ifs <;> constructor <;> intro h <;> omega
    have h0 := congrArg (fun x => e q' ⬝ᵥ M.mulVec x) hPc
    simp only [Matrix.mulVec_sum, Matrix.mulVec_smul, dotProduct_sum, dotProduct_smul,
      Matrix.mulVec_zero, dotProduct_zero, smul_eq_mul] at h0
    rw [Finset.sum_eq_single q] at h0
    · rw [he q' hq'n q.val q.isLt, if_pos ((hq' q.val).mpr rfl), mul_one] at h0
      exact h0
    · intro p _ hpq
      rw [he q' hq'n p.val p.isLt, if_neg, mul_zero]
      intro h
      exact hpq (Fin.ext ((hq' p.val).mp h))
    · intro h
      exact absurd (Finset.mem_univ q) h
  intro Ω _ _ d hd A hA
  obtain ⟨M, hMdef⟩ : ∃ M, M = A + A.transpose := ⟨_, rfl⟩
  have hMT : M.transpose = M := by
    rw [hMdef, Matrix.transpose_add, Matrix.transpose_transpose]; exact add_comm _ _
  have hB : ∀ x y : Fin (d + 1 + 1) → Ω, x ⬝ᵥ M.mulVec y = y ⬝ᵥ M.mulVec x := by
    intro x y
    rw [Matrix.dotProduct_mulVec, dotProduct_comm, ← Matrix.mulVec_transpose, hMT]
  have hI3 : ∀ x y : Fin (d + 1 + 1) → Ω,
      x ⬝ᵥ A.mulVec y + y ⬝ᵥ A.mulVec x = x ⬝ᵥ M.mulVec y := by
    intro x y
    rw [hMdef, Matrix.add_mulVec, dotProduct_add, Matrix.mulVec_transpose,
      Matrix.dotProduct_mulVec y A x, dotProduct_comm (Matrix.vecMul y A) x]
  have hAM : M.det ≠ 0 := by rw [hMdef]; exact hA
  have step : ∀ (m : ℕ) (e : ℕ → Fin (d + 1 + 1) → Ω), Even m → m + 2 ≤ d + 1 + 1 →
      (∀ p < m, e p ⬝ᵥ A.mulVec (e p) = 0) →
      (∀ p < m, ∀ q < m, e p ⬝ᵥ M.mulVec (e q) = if p / 2 = q / 2 ∧ p ≠ q then 1 else 0) →
      ∃ v w : Fin (d + 1 + 1) → Ω, v ⬝ᵥ A.mulVec v = 0 ∧ w ⬝ᵥ A.mulVec w = 0 ∧
        v ⬝ᵥ M.mulVec w = 1 ∧ (∀ p < m, e p ⬝ᵥ M.mulVec v = 0) ∧
        (∀ p < m, e p ⬝ᵥ M.mulVec w = 0) := by
    intro m e hm hmn _ hBe
    obtain ⟨u₁, u₂, h1, h2, hind⟩ :=
      t_s2a Ω (d + 1 + 1) m (fun p => Matrix.vecMul (e p) M) hmn
    obtain ⟨s, s', hss, hQv⟩ := t_s2b Ω (d + 1 + 1) A u₁ u₂
    have hv0 : s • u₁ + s' • u₂ ≠ 0 := by
      intro h0
      obtain ⟨hs0, hs'0⟩ := hind s s' h0
      rcases hss with h | h
      · exact h hs0
      · exact h hs'0
    have hev : ∀ p < m, e p ⬝ᵥ M.mulVec (s • u₁ + s' • u₂) = 0 := by
      intro p hp
      have k1 : Matrix.vecMul (e p) M ⬝ᵥ u₁ = 0 := h1 p hp
      have k2 : Matrix.vecMul (e p) M ⬝ᵥ u₂ = 0 := h2 p hp
      rw [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, dotProduct_add,
        dotProduct_smul, dotProduct_smul, Matrix.dotProduct_mulVec, Matrix.dotProduct_mulVec,
        k1, k2, smul_zero, smul_zero, add_zero]
    obtain ⟨w, hQw, hvw, hew⟩ :=
      t_s3 Ω (d + 1 + 1) A M hMdef hAM m e hm hBe (s • u₁ + s' • u₂) hv0 hQv hev
    exact ⟨s • u₁ + s' • u₂, w, hQv, hQw, hvw, hev, hew⟩
  obtain ⟨t, ht⟩ := hd
  obtain ⟨e, hQe, hBe⟩ := t_s4 Ω (d + 1 + 1) (fun x => x ⬝ᵥ A.mulVec x)
    (fun x y => x ⬝ᵥ M.mulVec y) hB
    (fun x => by
      show x ⬝ᵥ M.mulVec x = 2 * (x ⬝ᵥ A.mulVec x)
      rw [← hI3, two_mul])
    step (t + 1) (by omega)
  have hPdet := t_s6 Ω (d + 1 + 1) M e ⟨t + 1, by omega⟩
    (fun p hp q hq => hBe p (by omega) q (by omega))
  have hent : ∀ p q : Fin (d + 1 + 1),
      ((Matrix.of fun (i : Fin (d + 1 + 1)) (p : Fin (d + 1 + 1)) => e p.val i).transpose * A *
        (Matrix.of fun (i : Fin (d + 1 + 1)) (p : Fin (d + 1 + 1)) => e p.val i)) p q =
      e p.val ⬝ᵥ A.mulVec (e q.val) := by
    intro p q
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Matrix.mulVec,
      dotProduct, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
  refine ⟨_, hPdet, t_s1 Ω (d + 1) _ _ ?_ ?_⟩
  · intro p
    rw [hent, if_neg]
    · exact hQe p.val (by omega)
    · omega
  · intro p q
    rw [hent, hent, hI3]
    have hpq : e p.val ⬝ᵥ M.mulVec (e q.val) =
        if p.val / 2 = q.val / 2 ∧ p.val ≠ q.val then 1 else 0 :=
      hBe p.val (by omega) q.val (by omega)
    rw [hpq]
    split_ifs <;> first | (norm_num; done) | (exfalso; omega)

theorem wc_rpss_punct_affine_low_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (n ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (O : (Spec (.of (MvPolynomial (Fin n) K))).Opens), (O : Set (Spec (.of (MvPolynomial (Fin n) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K))))ᶜ → ∀ q : ℕ, 1 ≤ q → q + 2 ≤ 2 * n → Subsingleton (wcEtCoh O ℓ q) :=
by
  intro K _ _ n ℓ _ hℓK O hO q hq1 hq2
  have hn1 : 1 ≤ n := by omega
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  let p : Spec (.of (MvPolynomial (Fin n) K)) ⟶ Spec (.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))
  let orig : Spec (.of K) ⟶ Spec (.of (MvPolynomial (Fin n) K)) :=
    Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K))
  have hsec : orig ≫ p = 𝟙 (Spec (.of K)) := by
    show Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K))) = 𝟙 _
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext x
    simp
  have hcompat : orig ≫ 𝟙 (Spec (.of (MvPolynomial (Fin n) K))) =
      𝟙 (Spec (.of K)) ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K)) := by
    rw [Category.comp_id, Category.id_comp]
  haveI : SmoothOfRelativeDimension 0 (𝟙 (Spec (.of K))) := inferInstance
  have D : wcEtPullData (O.ι ≫ p) ℓ := (wc_et_zmod_pull_data_exists (O.ι ≫ p) ℓ).some
  have hb := (wc_et_pull_punctured_bundle K (Spec (.of K)) (𝟙 _) 0 n
    (Spec (.of (MvPolynomial (Fin n) K))) p (𝟙 _) orig (IsPullback.id_vert p) hsec hcompat hn1
    O hO ℓ hℓK D q).2 hq2
  haveI hpt : Subsingleton (wcEtCoh (Spec (.of K)) ℓ q) :=
    wc_et_zero_dim_vanishing K (Spec (.of K)) (𝟙 _)
      (le_of_eq ((PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim K).trans
        (ringKrullDim_eq_zero_of_field K))) ℓ hℓ0 q (by omega)
  obtain ⟨E₀⟩ := wc_et_zmodext_coh_equiv (Spec (.of K)) ℓ q
  haveI := E₀.subsingleton
  haveI := hb.subsingleton
  obtain ⟨E₁⟩ := wc_et_zmodext_coh_equiv (O : Scheme.{u}) ℓ q
  exact E₁.symm.subsingleton

theorem wc_hyperbolic_affine_quadric_low_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ), ℓ.Prime → ((ℓ : ℕ) : Ω) ≠ 0 → ∀ (n : ℕ), Even n → 2 ≤ n → Nat.card (wcEtCoh (Spec (.of (wcQuadModelRing Ω n 1 (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)))) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → q + 2 ≤ n → Subsingleton (wcEtCoh (Spec (.of (wcQuadModelRing Ω n 1 (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)))) ℓ q) :=
by
  intro Ω _ _ ℓ hℓ hℓΩ n hn hn2
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓ⟩
  obtain ⟨r, hr⟩ := hn
  obtain ⟨e, rfl⟩ : ∃ e, n = 2 * (e + 1) := ⟨r - 1, by omega⟩

  obtain ⟨φe, hφe⟩ : ∃ f : MvPolynomial (Fin (e + 1)) Ω →+* MvPolynomial (Fin (2 * (e + 1))) Ω ⧸ wcQuadModelIdeal Ω (2 * (e + 1)) 1 (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0), f = (MvPolynomial.aeval (R := Ω) (fun j : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal Ω (2 * (e + 1)) 1 (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)) (MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin (2 * (e + 1)))))).toRingHom := ⟨_, rfl⟩

  obtain ⟨O, hO⟩ : ∃ O : (Spec (.of (MvPolynomial (Fin (e + 1)) Ω))).Opens, O = ⨆ k : Fin (e + 1), PrimeSpectrum.basicOpen (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω) := ⟨_, rfl⟩



  have hs3 : ∀ k : Fin (e + 1), ∃ Ψ : TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω) ≃+* Localization.Away (φe (MvPolynomial.X k)), Ψ.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom = Localization.awayMap φe (MvPolynomial.X k) := by
    intro k
    subst hφe
    classical

    have C0 : ∀ (A : Type u) [CommRing A] (v : Fin (2 * (e + 1)) → A),
        ∑ p : Fin (2 * (e + 1)), ∑ q : Fin (2 * (e + 1)),
          (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) * v p * v q =
        ∑ j : Fin (e + 1), v ⟨2 * j.val, by omega⟩ * v ⟨2 * j.val + 1, by omega⟩ := by
      intro A _ v
      symm
      refine Fintype.sum_of_injective (fun j : Fin (e + 1) => (⟨2 * j.val, by omega⟩ : Fin (2 * (e + 1))))
        ?_ _ _ ?_ ?_
      · intro a b hab
        have := congrArg Fin.val hab
        simp only at this
        exact Fin.ext (by omega)
      · intro p hp
        apply Finset.sum_eq_zero
        intro q _
        have hpodd : ¬ (p.val % 2 = 0) := by
          intro h
          exact hp ⟨⟨p.val / 2, by omega⟩, Fin.ext (by simp only; omega)⟩
        simp [hpodd]
      · intro j
        rw [Fintype.sum_eq_single (⟨2 * j.val + 1, by omega⟩ : Fin (2 * (e + 1)))]
        · simp
        · intro q hq
          have hq' : ¬ (q.val = 2 * j.val + 1) := fun h => hq (Fin.ext h)
          simp [hq']
    have hQ : (∑ p : Fin (2 * (e + 1)), ∑ q : Fin (2 * (e + 1)), MvPolynomial.C ((Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (2 * (e + 1))) Ω) = ∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ := by
      refine Eq.trans ?_ (C0 _ (fun p => MvPolynomial.X p))
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
      simp only [Matrix.of_apply]
      split_ifs <;> simp
    set I := wcQuadModelIdeal Ω (2 * (e + 1)) 1 (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) with hI
    have hgen : (∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ - MvPolynomial.C 1 : MvPolynomial (Fin (2 * (e + 1))) Ω) ∈ I := by
      rw [← hQ]
      exact Ideal.subset_span rfl
    have hrel : ∑ j : Fin (e + 1), Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val, by omega⟩) * Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val + 1, by omega⟩) = 1 := by
      have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr hgen
      rw [map_sub, sub_eq_zero, map_sum, MvPolynomial.C_1, map_one] at h0
      simpa only [map_mul] using h0
    set φ : MvPolynomial (Fin (e + 1)) Ω →+* MvPolynomial (Fin (2 * (e + 1))) Ω ⧸ I := (MvPolynomial.aeval (R := Ω) (fun j : Fin (e + 1) => Ideal.Quotient.mk I (MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin (2 * (e + 1)))))).toRingHom with hφ
    have hφX : ∀ j : Fin (e + 1), φ (MvPolynomial.X j) = Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val, by omega⟩) := by
      intro j
      simp [hφ]
    have hφC : ∀ c : Ω, φ (MvPolynomial.C c) = algebraMap Ω _ c := by
      intro c
      simp [hφ]

    set fL : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω) →+* Localization.Away (φ (MvPolynomial.X k)) := Localization.awayMap φ (MvPolynomial.X k) with hfL
    have hfL_alg : ∀ a, fL (algebraMap _ _ a) = algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) (φ a) := by
      intro a
      exact IsLocalization.map_eq _ _
    have hRkΩ : ∀ c : Ω, algebraMap (MvPolynomial (Fin (2 * (e + 1))) Ω ⧸ I) (Localization.Away (φ (MvPolynomial.X k))) (algebraMap Ω _ c) = algebraMap Ω (Localization.Away (φ (MvPolynomial.X k))) c := by
      intro c
      exact (IsScalarTower.algebraMap_apply Ω _ _ c).symm
    let fA : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω) →ₐ[Ω] Localization.Away (φ (MvPolynomial.X k)) :=
      { fL with
        commutes' := fun c => by
          show fL (algebraMap Ω _ c) = _
          rw [IsScalarTower.algebraMap_apply Ω (MvPolynomial (Fin (e + 1)) Ω) _ c, hfL_alg,
            MvPolynomial.algebraMap_eq, hφC, hRkΩ] }
    let gA : MvPolynomial (Fin e) Ω →ₐ[Ω] Localization.Away (φ (MvPolynomial.X k)) :=
      MvPolynomial.aeval (fun i : Fin e => algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
        (Ideal.Quotient.mk I (MvPolynomial.X (⟨2 * (k.succAbove i).val + 1, by omega⟩ : Fin (2 * (e + 1))))))
    let ΘA := Algebra.TensorProduct.productMap fA gA
    have G1 : ∀ a, ΘA (a ⊗ₜ[Ω] (1 : MvPolynomial (Fin e) Ω)) = fL a := by
      intro a
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    have G2 : ∀ b, ΘA ((1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) ⊗ₜ[Ω] b) = gA b := by
      intro b
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
    have G3 : ∀ c : Ω, ΘA (algebraMap Ω _ c) = algebraMap Ω _ c := fun c => ΘA.commutes c
    have hgAX : ∀ i : Fin e, gA (MvPolynomial.X i) = algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
        (Ideal.Quotient.mk I (MvPolynomial.X (⟨2 * (k.succAbove i).val + 1, by omega⟩ : Fin (2 * (e + 1))))) := by
      intro i
      simp [gA]

    set yinv : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω) := IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω) with hyinvdef
    have hyinv : algebraMap _ _ (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω) * yinv = 1 :=
      IsLocalization.Away.mul_invSelf _
    obtain ⟨Y, hY⟩ : ∃ Y : Fin (e + 1) → TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω),
        ∀ j, Y j = algebraMap (MvPolynomial (Fin (e + 1)) Ω) (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial.X j) ⊗ₜ[Ω] (1 : MvPolynomial (Fin e) Ω) :=
      ⟨fun j => algebraMap (MvPolynomial (Fin (e + 1)) Ω) (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial.X j) ⊗ₜ[Ω] (1 : MvPolynomial (Fin e) Ω), fun _ => rfl⟩
    obtain ⟨z, hz⟩ : ∃ z : Fin e → TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω),
        ∀ i, z i = (1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) ⊗ₜ[Ω] (MvPolynomial.X i : MvPolynomial (Fin e) Ω) :=
      ⟨fun i => (1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) ⊗ₜ[Ω] (MvPolynomial.X i : MvPolynomial (Fin e) Ω), fun _ => rfl⟩
    obtain ⟨sv, hsv⟩ : ∃ sv : TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω),
        sv = (yinv ⊗ₜ[Ω] (1 : MvPolynomial (Fin e) Ω)) * (1 - ∑ i : Fin e, Y (k.succAbove i) * z i) :=
      ⟨_, rfl⟩
    obtain ⟨o, ho_k, ho_sa⟩ : ∃ o : Fin (e + 1) → TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω),
        o k = sv ∧ ∀ i, o (k.succAbove i) = z i :=
      ⟨Fin.insertNth (α := fun _ => TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω)) k sv z,
        Fin.insertNth_apply_same _ _ _, fun i => Fin.insertNth_apply_succAbove _ _ _ _⟩
    obtain ⟨vβ, hve, hvo⟩ : ∃ vβ : Fin (2 * (e + 1)) → TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω),
        (∀ j : Fin (e + 1), vβ ⟨2 * j.val, by omega⟩ = Y j) ∧ (∀ j : Fin (e + 1), vβ ⟨2 * j.val + 1, by omega⟩ = o j) := by
      refine ⟨fun p => if p.val % 2 = 0 then Y ⟨p.val / 2, by omega⟩ else o ⟨p.val / 2, by omega⟩, ?_, ?_⟩
      · intro j
        have h1 : (2 * j.val) % 2 = 0 := by omega
        have h2 : (⟨(2 * j.val) / 2, by omega⟩ : Fin (e + 1)) = j := Fin.ext (by simp only; omega)
        simp only [h1, if_true, h2]
      · intro j
        have h1 : ¬ ((2 * j.val + 1) % 2 = 0) := by omega
        have h2 : (⟨(2 * j.val + 1) / 2, by omega⟩ : Fin (e + 1)) = j := Fin.ext (by simp only; omega)
        simp only [h1, if_false, h2]
    have hYk : Y k * (yinv ⊗ₜ[Ω] (1 : MvPolynomial (Fin e) Ω)) = 1 := by
      rw [hY, Algebra.TensorProduct.tmul_mul_tmul, hyinv, mul_one]
      rfl
    set β₀ : MvPolynomial (Fin (2 * (e + 1))) Ω →+* TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω) :=
      MvPolynomial.eval₂Hom (algebraMap Ω _) vβ with hβ₀def
    have hβ₀X : ∀ p, β₀ (MvPolynomial.X p) = vβ p := fun p => MvPolynomial.eval₂Hom_X' _ _ _
    have hβ₀C : ∀ c, β₀ (MvPolynomial.C c) = algebraMap Ω _ c := fun c => MvPolynomial.eval₂Hom_C _ _ _
    have hβ₀gen : β₀ (∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ - MvPolynomial.C 1) = 0 := by
      rw [map_sub, map_sum, hβ₀C, map_one]
      simp only [map_mul, hβ₀X, hve, hvo]
      rw [Fin.sum_univ_succAbove _ k, ho_k]
      simp only [ho_sa]
      rw [hsv]
      linear_combination (1 - ∑ i : Fin e, Y (k.succAbove i) * z i) * hYk
    have hker : ∀ a ∈ I, β₀ a = 0 := by
      intro a ha
      have ha' : a ∈ Ideal.span {(∑ j : Fin (e + 1), MvPolynomial.X ⟨2 * j.val, by omega⟩ * MvPolynomial.X ⟨2 * j.val + 1, by omega⟩ - MvPolynomial.C 1 : MvPolynomial (Fin (2 * (e + 1))) Ω)} := by
        rw [← hQ]
        exact ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha'
      rw [map_mul, hβ₀gen, mul_zero]
    set β : MvPolynomial (Fin (2 * (e + 1))) Ω ⧸ I →+* TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω) :=
      Ideal.Quotient.lift I β₀ hker with hβdef
    have hβmk : ∀ a, β (Ideal.Quotient.mk I a) = β₀ a := fun a => Ideal.Quotient.lift_mk _ _ _
    have hunit : IsUnit (β (φ (MvPolynomial.X k))) := by
      rw [hφX, hβmk, hβ₀X, hve]
      exact IsUnit.of_mul_eq_one _ hYk
    set Θ' : Localization.Away (φ (MvPolynomial.X k)) →+* TensorProduct Ω (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) (MvPolynomial (Fin e) Ω) :=
      IsLocalization.Away.lift (φ (MvPolynomial.X k)) hunit with hΘ'def
    have hΘ'alg : ∀ a, Θ' (algebraMap _ _ a) = β a := fun a => IsLocalization.Away.lift_eq _ _ _
    have F1 : ∀ p, Θ' (algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) (Ideal.Quotient.mk I (MvPolynomial.X p))) = vβ p := by
      intro p
      rw [hΘ'alg, hβmk, hβ₀X]
    have F2 : ∀ c : Ω, Θ' (algebraMap Ω (Localization.Away (φ (MvPolynomial.X k))) c) = algebraMap Ω _ c := by
      intro c
      rw [← hRkΩ, hΘ'alg, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, hβmk, hβ₀C]
    set Θ := ΘA.toRingHom with hΘdef
    have hparity : ∀ p : Fin (2 * (e + 1)), ∃ j : Fin (e + 1),
        p = ⟨2 * j.val, by omega⟩ ∨ p = ⟨2 * j.val + 1, by omega⟩ := by
      intro p
      refine ⟨⟨p.val / 2, by omega⟩, ?_⟩
      rcases Nat.mod_two_eq_zero_or_one p.val with h | h
      · left; exact Fin.ext (by simp only; omega)
      · right; exact Fin.ext (by simp only; omega)
    have hA : Θ.comp Θ' = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (φ (MvPolynomial.X k)))
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hRkΩ, F2]
        exact G3 c
      · intro p
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [F1]
        obtain ⟨j, hj | hj⟩ := hparity p
        · subst hj
          rw [hve, hY]
          show ΘA _ = _
          rw [G1, hfL_alg]
          exact congrArg _ (hφX j)
        · subst hj
          rw [hvo]
          by_cases hjk : j = k
          · subst hjk
            rw [ho_k, hsv]
            show ΘA _ = _
            rw [map_mul, G1, map_sub, map_one, map_sum]
            simp only [map_mul, hY, hz, G1, G2, hfL_alg, hφX, hgAX]
            have hu : algebraMap _ (Localization.Away (φ (MvPolynomial.X j))) (Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val, by omega⟩)) * fL yinv = 1 := by
              rw [← hφX, ← hfL_alg, ← map_mul, hyinv, map_one]
            have hr := congrArg (algebraMap _ (Localization.Away (φ (MvPolynomial.X j)))) hrel
            rw [map_sum, map_one, Fin.sum_univ_succAbove _ j] at hr
            simp only [map_mul] at hr
            linear_combination (-(fL yinv)) * hr + algebraMap _ (Localization.Away (φ (MvPolynomial.X j))) (Ideal.Quotient.mk I (MvPolynomial.X ⟨2 * j.val + 1, by omega⟩)) * hu
          · obtain ⟨i, rfl⟩ := Fin.exists_succAbove_eq hjk
            rw [ho_sa, hz]
            show ΘA _ = _
            rw [G2, hgAX]
    have hB : Θ'.comp Θ = RingHom.id _ := by
      have HL : Θ'.comp fL = Algebra.TensorProduct.includeLeftRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω))
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
          rw [hfL_alg, hφC, hRkΩ, F2, Algebra.TensorProduct.algebraMap_apply,
            ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
        · intro j
          simp only [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
          rw [hfL_alg, hφX j, F1, hve, hY]
      have HR : ∀ b, Θ' (gA b) = (1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) ⊗ₜ[Ω] b := by
        intro b
        have : Θ'.comp gA.toRingHom = Algebra.TensorProduct.includeRight.toRingHom := by
          apply MvPolynomial.ringHom_ext
          · intro c
            show Θ' (gA (MvPolynomial.C c)) = Algebra.TensorProduct.includeRight (MvPolynomial.C c)
            rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes, F2]
          · intro i
            show Θ' (gA (MvPolynomial.X i)) = Algebra.TensorProduct.includeRight (MvPolynomial.X i)
            rw [hgAX, F1, hvo, ho_sa, hz]
            rfl
        exact congrArg (fun f => f b) this
      apply RingHom.ext
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        have hab : a ⊗ₜ[Ω] b = (a ⊗ₜ[Ω] (1 : MvPolynomial (Fin e) Ω)) * ((1 : Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω)) ⊗ₜ[Ω] b) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hab, map_mul, map_mul, RingHom.id_apply]
