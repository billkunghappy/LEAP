      ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from X.down) z) i‖ ≤ 1 →
      ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from Y.down) z) i‖ ≤ 1 →
      ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from (X + Y).down) z) i‖ ≤ 1 := by
    intro V h' z i X Y hX hY
    have e3 : (show C(↥V.left, Fin k → ℚ_[ℓ]) from (X + Y).down) z =
        (show C(↥V.left, Fin k → ℚ_[ℓ]) from X.down) z +
          (show C(↥V.left, Fin k → ℚ_[ℓ]) from Y.down) z := rfl
    rw [e3, map_add, Pi.add_apply]
    exact (Padic.nonarchimedean _ _).trans (max_le hX hY)
  have latneg : ∀ (V : S.ProEt) (h' : V ⟶ W) (z : V.left) (i : Fin k)
      (X : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk h'))),
      ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from X.down) z) i‖ ≤ 1 →
      ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from (-X).down) z) i‖ ≤ 1 := by
    intro V h' z i X hX
    have e3 : (show C(↥V.left, Fin k → ℚ_[ℓ]) from (-X).down) z =
