    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (k : ℕ) (hk : 1 ≤ k) (Dk : wcZModPullData ((wcProEtPullback D.f).map a₀).left (ℓ ^ k))
    (hDk : wcZModPullCanonical Dk) :
    Function.Injective (wcZModPull Dk (n - 1)) :=
by
  classical

  have s4 : ∀ {X₁ Pb T₁ T₂ E₁ T₃ : Scheme.{u}} (ff : X₁ ⟶ Pb) (uu : T₁ ⟶ Pb) (aa : T₂ ⟶ Pb)
      (γh : T₂ ⟶ T₁) (γi : T₁ ⟶ T₂), γi ≫ γh = 𝟙 T₁ → γh ≫ uu = aa →
      ∀ (ee : E₁ ⟶ Pb) (αα : E₁ ⟶ T₁), αα ≫ uu = ee → ∀ (ττ : T₃ ⟶ E₁) (ξ : T₃ ⟶ T₂),
      ττ ≫ αα ≫ γi = ξ → ∀ (m j : ℕ),
      (∀ D' : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd ff aa) ξ) m,
        Function.Injective (wcEtPull D' j)) →
      ∀ (q : Limits.pullback ee ff ⟶ Limits.pullback uu ff),
      q ≫ Limits.pullback.fst uu ff = Limits.pullback.fst ee ff ≫ αα →
      q ≫ Limits.pullback.snd uu ff = Limits.pullback.snd ee ff →
      ∀ Dq : wcEtPullData q m, Function.Injective (wcEtPull Dq j) := by
    intro X₁ Pb T₁ T₂ E₁ T₃ ff uu aa γh γi hγ1 hγ ee αα hα ττ ξ hξ m j hinj q hq1 hq2 Dq
    have hγi : γi ≫ aa = uu := by rw [← hγ, ← Category.assoc, hγ1, Category.id_comp]
    have hξa : ξ ≫ aa = ττ ≫ ee := by
      rw [← hξ, Category.assoc, Category.assoc, hγi, hα]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback uu ff ⟶ Limits.pullback ff aa,
        κ ≫ Limits.pullback.fst ff aa = Limits.pullback.snd uu ff ∧
        κ ≫ Limits.pullback.snd ff aa = Limits.pullback.fst uu ff ≫ γi :=
      ⟨Limits.pullback.lift (Limits.pullback.snd uu ff) (Limits.pullback.fst uu ff ≫ γi)
        (by rw [Category.assoc, hγi]; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨κ', hκ'1, hκ'2⟩ : ∃ κ' : Limits.pullback ff aa ⟶ Limits.pullback uu ff,
        κ' ≫ Limits.pullback.fst uu ff = Limits.pullback.snd ff aa ≫ γh ∧
        κ' ≫ Limits.pullback.snd uu ff = Limits.pullback.fst ff aa :=
      ⟨Limits.pullback.lift (Limits.pullback.snd ff aa ≫ γh) (Limits.pullback.fst ff aa)
        (by rw [Category.assoc, hγ]; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hκκ' : κ ≫ κ' = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hκ'1, reassoc_of% hκ2, hγ1, Category.comp_id,
          Category.id_comp]
      · simp only [Category.assoc, hκ'2, hκ1, Category.id_comp]
    have c2 : Limits.pullback.fst (Limits.pullback.snd ff aa) ξ ≫
        Limits.pullback.snd ff aa =
        Limits.pullback.snd (Limits.pullback.snd ff aa) ξ ≫ ξ :=
      Limits.pullback.condition
    have c1 : Limits.pullback.fst ff aa ≫ ff = Limits.pullback.snd ff aa ≫ aa :=
      Limits.pullback.condition
    obtain ⟨g, hg1, hg2⟩ : ∃ g : Limits.pullback (Limits.pullback.snd ff aa) ξ ⟶
        Limits.pullback ee ff,
        g ≫ Limits.pullback.fst ee ff =
          Limits.pullback.snd (Limits.pullback.snd ff aa) ξ ≫ ττ ∧
        g ≫ Limits.pullback.snd ee ff =
          Limits.pullback.fst (Limits.pullback.snd ff aa) ξ ≫
            Limits.pullback.fst ff aa :=
      ⟨Limits.pullback.lift
        (Limits.pullback.snd (Limits.pullback.snd ff aa) ξ ≫ ττ)
        (Limits.pullback.fst (Limits.pullback.snd ff aa) ξ ≫
