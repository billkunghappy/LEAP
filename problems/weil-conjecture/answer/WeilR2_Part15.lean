    Abelian.Ext.eq_zero_of_projective (n := 1) _
  obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS_V G _ h1
    (show 1 + 1 = 2 from rfl)
  refine ⟨x, ?_⟩
  have hpre : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {n a b : ℕ} (α : Abelian.Ext X Y n) (h : n + a = b) (β : Abelian.Ext Y Z a),
      α.precomp Z h β = α.comp β h := fun _ _ _ => rfl
  unfold wcPunctGys
  rw [dif_pos hc]
  simp only [AddMonoidHom.comp_apply, hpre]
  rw [hx, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 2) (by omega),
    Abelian.Ext.mk₀_comp_mk₀, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  exact hy₁

theorem wc_stpf_chart (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [IsLocalRing A]
    (e : V₀.left ≅ Spec (.of A))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F'')) :
    ∃ (c : F'') (ψ : Polynomial F'' →+* A) (j : Spec (.of (Polynomial F'')) ⟶ (wcP1Over F'').left),
      IsOpenImmersion j ∧
      e.inv ≫ V₀.hom = Spec.map (CommRingCat.ofHom ψ) ≫ j ∧
      Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)) ≫ j = u0 ∧
      WeaklyEtale (e.inv ≫ V₀.hom) ∧
      @Algebra.WeaklyEtale (Polynomial F'') A _ _ ψ.toAlgebra :=
by
  classical

  have hcover : (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff
        (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩

  have hchart : ∀ (a : Fin (1 + 1)), ∃ eW : (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
      (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial F'')),
      eW.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (Polynomial F''))) =
        (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
          MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι ≫ wcProjKStr F'' 1 := by
    intro a
    show ∃ e : (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial F'')), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (Polynomial F''))) = (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι ≫ (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0))))
    have hrev : a.rev ≠ a := by revert a; decide
    have hcases : ∀ i : Fin (1 + 1), i = a ∨ i = a.rev := by revert a; decide
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      MvPolynomial.gradedAlgebra
    have hscale : ∀ {S : Type u} [CommRing S] (f : F'' →+* S) (x : Fin (1 + 1) → S) (s : S)
        (p : MvPolynomial (Fin (1 + 1)) F'') (n : ℕ), p.IsHomogeneous n →
        MvPolynomial.eval₂ f (fun i => s * x i) p = s ^ n * MvPolynomial.eval₂ f x p := by
      intro S _ f x s p n hp
      rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : ∑ i ∈ d.support, d i = n := by
        have h := hp (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum] using h
      simp_rw [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    have hf : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'') ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 1 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]; exact MvPolynomial.isHomogeneous_X F'' a
    have hb : (MvPolynomial.X a.rev : MvPolynomial (Fin (1 + 1)) F'') ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' (1 • 1) := by
      rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X F'' a.rev
    let T : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
        (MvPolynomial.X a) :=
      HomogeneousLocalization.Away.mk _ hf 1 (MvPolynomial.X a.rev) hb
    let ι₀ := HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (Submonoid.powers (MvPolynomial.X a))
    let c₀ := algebraMap F'' (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)
    let ψ : Polynomial F'' →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X a) :=
      Polynomial.eval₂RingHom (ι₀.comp c₀) T
    let χ₀ : MvPolynomial (Fin (1 + 1)) F'' →+* Polynomial F'' :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = a then 1 else Polynomial.X)
    have hχa : χ₀ (MvPolynomial.X a) = 1 := by simp [χ₀]
    have hχb : χ₀ (MvPolynomial.X a.rev) = Polynomial.X := by simp [χ₀, hrev]
    have hχC : ∀ k, χ₀ (MvPolynomial.C k) = Polynomial.C k := by intro k; simp [χ₀]
    let Λ : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'') →+*
        Polynomial F'' :=
      IsLocalization.Away.lift (MvPolynomial.X a) (g := χ₀) (by rw [hχa]; exact isUnit_one)
    have hΛ : ∀ p, Λ (algebraMap _ (Localization.Away (MvPolynomial.X a :
        MvPolynomial (Fin (1 + 1)) F'')) p) = χ₀ p := fun p => IsLocalization.Away.lift_eq _ _ p
    let χ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
        (MvPolynomial.X a) →+* Polynomial F'' :=
      Λ.comp (algebraMap _ (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'')))
    have hΛ1 : ∀ y : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F''),
        Λ (IsLocalization.mk' (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) F'')) 1 y) = 1 := by
      intro y
      have h := congrArg Λ (IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) F'')) (1 : MvPolynomial (Fin (1 + 1)) F'') y)
      rw [map_mul, hΛ, hΛ] at h
      obtain ⟨n, hn⟩ := y.2
      rw [← hn, map_pow, hχa, one_pow, mul_one, map_one] at h
      exact h
    have F1 : ∀ n p hp, χ (HomogeneousLocalization.Away.mk _ hf n p hp) = χ₀ p := by
      intro n p hp
      simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one, map_mul, hΛ, hΛ1, mul_one]
    have F0 : ∀ k : F'', (ι₀ (c₀ k)).val = algebraMap (MvPolynomial (Fin (1 + 1)) F'')
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F''))
        (MvPolynomial.C k) := by
      intro k
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    have hψC : ∀ k, ψ (Polynomial.C k) = ι₀ (c₀ k) := by
      intro k; simp [ψ]
    have hψX : ψ Polynomial.X = T := by simp [ψ]
    have hi : χ.comp ψ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, hψC, RingHom.id_apply]
        simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [F0, hΛ, hχC]
      · rw [RingHom.comp_apply, hψX, RingHom.id_apply, F1, hχb]
    have hii : ψ.comp χ = RingHom.id _ := by
      apply RingHom.ext
      intro y
      obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hf y
      rw [RingHom.comp_apply, F1, RingHom.id_apply]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      let u : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'') :=
        Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩
      let V : MvPolynomial (Fin (1 + 1)) F'' →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'') :=
        (algebraMap _ _).comp (ψ.comp χ₀)
      let W : MvPolynomial (Fin (1 + 1)) F'' →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'') :=
        MvPolynomial.eval₂Hom (algebraMap F'' _) (fun i : Fin (1 + 1) => u *
          algebraMap (MvPolynomial (Fin (1 + 1)) F'')
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F''))
            (MvPolynomial.X i))
      have hKA : ∀ k : F'', algebraMap (MvPolynomial (Fin (1 + 1)) F'')
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F''))
          (MvPolynomial.C k) = algebraMap F'' _ k := by
        intro k
        rw [IsScalarTower.algebraMap_apply F'' (MvPolynomial (Fin (1 + 1)) F'')
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'')),
          MvPolynomial.algebraMap_eq]
      have hVW : V = W := by
        apply MvPolynomial.ringHom_ext
        · intro k
          simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hχC, hψC,
            HomogeneousLocalization.algebraMap_apply]
          rw [F0, hKA]
        · intro i
          rcases hcases i with rfl | rfl
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχa, map_one, u]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            exact (Localization.mk_self (⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ :
              Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) F''))).symm
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχb, hψX, u,
              HomogeneousLocalization.algebraMap_apply, T, HomogeneousLocalization.Away.val_mk]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            congr 1
            ext
            simp
      have hval : (ψ (χ₀ p)).val = V p := by
        simp only [V, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      have hph : p.IsHomogeneous n := by
        have hp' := hp
        rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hp'
        exact hp'
      have heta : MvPolynomial.eval₂ (algebraMap F'' (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) F''))) (fun i : Fin (1 + 1) =>
            algebraMap (MvPolynomial (Fin (1 + 1)) F'')
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F''))
            (MvPolynomial.X i)) p =
          algebraMap (MvPolynomial (Fin (1 + 1)) F'')
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'')) p := by
        have h := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (1 + 1)) F'')
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) F'')))
          MvPolynomial.C MvPolynomial.X p
        rw [MvPolynomial.eval₂_eta] at h
        rw [h, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
        rfl
      rw [hval, hVW]
      simp only [W, MvPolynomial.coe_eval₂Hom]
      rw [hscale _ _ u p n hph, heta, ← Localization.mk_one_eq_algebraMap]
      simp only [u]
      rw [Localization.mk_pow, Localization.mk_mul, one_pow, one_mul, mul_one]
      congr 1
    let e2 : Spec (.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X a))) ≅
        Spec (.of (Polynomial F'')) :=
      { hom := Spec.map (CommRingCat.ofHom ψ)
        inv := Spec.map (CommRingCat.ofHom χ)
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hii]
          exact Spec.map_id _
        inv_hom_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hi]
          exact Spec.map_id _ }
    have hcomp : ψ.comp (algebraMap F'' (Polynomial F'')) =
        (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
          (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap F'' (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)) := by
      rw [Polynomial.algebraMap_eq]
      exact RingHom.ext hψC
    refine ⟨Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
      (MvPolynomial.X a) hf Nat.one_pos ≪≫ e2, ?_⟩
    rw [Iso.trans_hom, Category.assoc]
    change _ ≫ Spec.map (CommRingCat.ofHom ψ) ≫ _ = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp, CommRingCat.ofHom_comp, Spec.map_comp,
      ← Proj.awayι_toSpecZero _ _ hf Nat.one_pos, ← Proj.basicOpenIsoSpec_inv_ι _ _ hf Nat.one_pos]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]

  have hx0 : u0 (IsLocalRing.closedPoint F'') ∈ (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) := by
    rw [hcover]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx0
  obtain ⟨eW, heW⟩ := hchart a
  obtain ⟨j, hjdef⟩ : ∃ j : Spec (.of (Polynomial F'')) ⟶ (wcP1Over F'').left,
      j = eW.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι := ⟨_, rfl⟩
  haveI hj : IsOpenImmersion j := by rw [hjdef]; infer_instance
  have hxj : u0 (IsLocalRing.closedPoint F'') ∈ Set.range j := by
    have hxW : u0 (IsLocalRing.closedPoint F'') ∈ Set.range (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι := by
      rw [Scheme.Opens.range_ι]; exact ha
    obtain ⟨w, hw⟩ := hxW
    refine ⟨eW.hom w, ?_⟩
    rw [hjdef, ← Scheme.Hom.comp_apply, Iso.hom_inv_id_assoc]
    exact hw
  have hjs : j ≫ (wcP1Over F'').hom =
      Spec.map (CommRingCat.ofHom (algebraMap F'' (Polynomial F''))) := by
    rw [hjdef, Category.assoc]
    change eW.inv ≫ _ ≫ wcProjKStr F'' 1 = _
    rw [← heW, Iso.inv_hom_id_assoc]

  have hloc : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (g : Spec (.of R) ⟶ (wcP1Over F'').left),
      g (IsLocalRing.closedPoint R) ∈ Set.range j → Set.range g ⊆ Set.range j := by
    intro R _ _ g hg y hy
    obtain ⟨p, rfl⟩ := hy
    exact ((IsLocalRing.specializes_closedPoint (R := R) p).map g.continuous).mem_open
      (IsOpenImmersion.isOpen_range j) hg

  have hWE : WeaklyEtale (e.inv ≫ V₀.hom) := by
    haveI : WeaklyEtale V₀.hom := V₀.prop
    infer_instance

  have hk : Set.range (e.inv ≫ V₀.hom) ⊆ Set.range j :=
    hloc A (e.inv ≫ V₀.hom) (by
      change V₀.hom (e.inv (IsLocalRing.closedPoint A)) ∈ Set.range j
      rw [hv]; exact hxj)
  have hg : IsOpenImmersion.lift j (e.inv ≫ V₀.hom) hk ≫ j = e.inv ≫ V₀.hom :=
    IsOpenImmersion.lift_fac _ _ _
  let ψ : Polynomial F'' →+* A :=
    (Spec.preimage (IsOpenImmersion.lift j (e.inv ≫ V₀.hom) hk)).hom
  have hψ : Spec.map (CommRingCat.ofHom ψ) = IsOpenImmersion.lift j (e.inv ≫ V₀.hom) hk := by
    simp only [ψ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hfac : e.inv ≫ V₀.hom = Spec.map (CommRingCat.ofHom ψ) ≫ j := by rw [hψ, hg]

  have hu : Set.range u0 ⊆ Set.range j := hloc F'' u0 hxj
  have hg₀ : IsOpenImmersion.lift j u0 hu ≫ j = u0 := IsOpenImmersion.lift_fac _ _ _
  have hsec : IsOpenImmersion.lift j u0 hu ≫
      Spec.map (CommRingCat.ofHom (algebraMap F'' (Polynomial F''))) = 𝟙 _ := by
    rw [← hjs, ← Category.assoc, hg₀, hu0]
  let γ : Polynomial F'' →+* F'' := (Spec.preimage (IsOpenImmersion.lift j u0 hu)).hom
  have hγ : Spec.map (CommRingCat.ofHom γ) = IsOpenImmersion.lift j u0 hu := by
    simp only [γ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hγC : γ.comp (algebraMap F'' (Polynomial F'')) = RingHom.id F'' := by
    have h1 : Spec.map (CommRingCat.ofHom (γ.comp (algebraMap F'' (Polynomial F'')))) =
        Spec.map (𝟙 (CommRingCat.of F'')) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp, hγ, hsec, Spec.map_id]
    have h2 := Spec.map_injective h1
    have h3 := congrArg CommRingCat.Hom.hom h2
    rw [CommRingCat.hom_ofHom, CommRingCat.hom_id] at h3
    exact h3
  have hev : Polynomial.evalRingHom (γ Polynomial.X) = γ := by
    apply Polynomial.ringHom_ext
    · intro r
      have h := DFunLike.congr_fun hγC r
      rw [RingHom.comp_apply, Polynomial.algebraMap_eq, RingHom.id_apply] at h
      rw [Polynomial.coe_evalRingHom, Polynomial.eval_C, h]
    · rw [Polynomial.coe_evalRingHom, Polynomial.eval_X]
  have hU : Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (γ Polynomial.X))) ≫ j = u0 := by
    rw [hev, hγ, hg₀]

  have hlpkt : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)
  have hW : @Algebra.WeaklyEtale (Polynomial F'') A _ _ ψ.toAlgebra := by
    haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ) ≫ j) := by rw [← hfac]; exact hWE
    haveI : WeaklyEtale j := etale_le_weaklyEtale _ _ _ (inferInstance : Etale j)
    exact hlpkt _ _ ψ (WeaklyEtale.of_comp _ j)
  exact ⟨γ Polynomial.X, ψ, j, hj, hfac, hU, hWE, hW⟩

theorem wc_stpf_fibre_maximal (F : Type u) [Field F] {Xs V : Scheme.{u}}
    (k : V ⟶ Xs) (u0 : Spec (.of F) ⟶ Xs)
    (A : Type u) [CommRing A] [IsLocalRing A] (e : V ≅ Spec (.of A))
    (c : F) (ψ : Polynomial F →+* A) (j : Spec (.of (Polynomial F)) ⟶ Xs) (hj : IsOpenImmersion j)
    (hk : e.inv ≫ k = Spec.map (CommRingCat.ofHom ψ) ≫ j)
    (hu : Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)) ≫ j = u0)
    (Ω : Type u) [Field Ω] (ε : Limits.pullback k u0 ≅ Spec (.of Ω)) :
    Ideal.span {ψ (Polynomial.X - Polynomial.C c)} = IsLocalRing.maximalIdeal A :=
by
  classical
  have : Mono j := IsOpenImmersion.mono j
  have hk' : k = (e.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ j := by
    rw [Category.assoc, ← hk, Iso.hom_inv_id_assoc]
  let φ1 : Limits.pullback k u0 ≅ Limits.pullback ((e.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ j)
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)) ≫ j) :=
    Limits.pullback.congrHom hk' hu.symm
  let φ2 : Limits.pullback ((e.hom ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ j)
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)) ≫ j) ≅
      Limits.pullback (e.hom ≫ Spec.map (CommRingCat.ofHom ψ))
        (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))) :=
    Limits.IsLimit.conePointUniqueUpToIso (Limits.pullbackIsPullback _ _)
      (Limits.pullbackIsPullbackOfCompMono (e.hom ≫ Spec.map (CommRingCat.ofHom ψ))
        (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))) j)
  let φ3 : Limits.pullback (e.hom ≫ Spec.map (CommRingCat.ofHom ψ))
        (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))) ≅
      Limits.pullback (Spec.map (CommRingCat.ofHom ψ))
        (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))) :=
    asIso (Limits.pullback.map (e.hom ≫ Spec.map (CommRingCat.ofHom ψ))
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)))
      (Spec.map (CommRingCat.ofHom ψ)) (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)))
      e.hom (𝟙 _) (𝟙 _) (by simp) (by simp))
  letI : Algebra (Polynomial F) A := ψ.toAlgebra
  letI : Algebra (Polynomial F) F := (Polynomial.evalRingHom c).toAlgebra
  let φ4 : Limits.pullback (Spec.map (CommRingCat.ofHom ψ))
        (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))) ≅
      Spec (.of (TensorProduct (Polynomial F) A F)) :=
    pullbackSpecIso (Polynomial F) A F
  let ι : Spec (.of (TensorProduct (Polynomial F) A F)) ≅ Spec (.of Ω) :=
    (ε.symm ≪≫ φ1 ≪≫ φ2 ≪≫ φ3 ≪≫ φ4).symm
  let ρ : Ω ≃+* TensorProduct (Polynomial F) A F :=
    (Spec.fullyFaithful.preimageIso (X := Opposite.op (CommRingCat.of (TensorProduct (Polynomial F) A F)))
      (Y := Opposite.op (CommRingCat.of Ω)) ι).unop.commRingCatIsoToRingEquiv
  set I : Ideal (Polynomial F) := Ideal.span {Polynomial.X - Polynomial.C c} with hI
  have hsurj : Function.Surjective (Algebra.ofId (Polynomial F) F) := fun x =>
    ⟨Polynomial.C x, by simp [Algebra.ofId_apply, RingHom.algebraMap_toAlgebra]⟩
  have hker : I = RingHom.ker (Algebra.ofId (Polynomial F) F) := by
    rw [hI, ← Polynomial.ker_evalRingHom c]
    ext r
    simp [RingHom.mem_ker, Algebra.ofId_apply, RingHom.algebraMap_toAlgebra]
  let Q : (Polynomial F ⧸ I) ≃ₐ[Polynomial F] F :=
    (Ideal.quotientEquivAlgOfEq (Polynomial F) hker).trans
      (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  let E1 := Algebra.TensorProduct.quotIdealMapEquivTensorQuot A I
  let E2 : TensorProduct (Polynomial F) A (Polynomial F ⧸ I) ≃ₐ[Polynomial F]
      TensorProduct (Polynomial F) A F :=
    Algebra.TensorProduct.congr AlgEquiv.refl Q
  let E : (A ⧸ Ideal.map (algebraMap (Polynomial F) A) I) ≃+* Ω :=
    (E1.toRingEquiv.trans E2.toRingEquiv).trans ρ.symm
  have hfield : IsField (A ⧸ Ideal.map (algebraMap (Polynomial F) A) I) :=
    MulEquiv.isField (Field.toIsField Ω) E.toMulEquiv
  have hmax : (Ideal.map (algebraMap (Polynomial F) A) I).IsMaximal :=
    Ideal.Quotient.maximal_of_isField _ hfield
  have hJ : Ideal.map (algebraMap (Polynomial F) A) I =
      Ideal.span {ψ (Polynomial.X - Polynomial.C c)} := by
    rw [hI, Ideal.map_span, Set.image_singleton]
    rfl
  rw [← hJ]
  exact IsLocalRing.eq_maximalIdeal hmax

theorem wc_stpf_punct_range (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [IsLocalRing A] (e : V₀.left ≅ Spec (.of A))
    (Ω : Type u) [Field Ω] (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of Ω))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F'')) :
    ∀ x : PrimeSpectrum A,
      x ∈ Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom) ↔
        x ≠ IsLocalRing.closedPoint A :=
by
  classical
  set y : (wcP1Over F'').left := u0 (IsLocalRing.closedPoint F'') with hy

  haveI hsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (wcProjKStr F'' 1); infer_instance
  haveI : IsClosedImmersion (u0 ≫ (wcP1Over F'').hom) := by rw [hu0]; infer_instance
  haveI : IsClosedImmersion u0 := IsClosedImmersion.of_comp u0 (wcP1Over F'').hom
  have hyc : IsClosed ({y} : Set (wcP1Over F'').left) := by
    have h1 := u0.isClosedEmbedding.isClosed_range
    have h2 : Set.range u0 = {y} := by
      ext z
      constructor
      · rintro ⟨w, rfl⟩
        rw [Set.mem_singleton_iff, hy]
        congr 1
        have hbot : ∀ w' : PrimeSpectrum F'', w'.asIdeal = ⊥ :=
          fun w' => @Ideal.eq_bot_of_prime F'' _ w'.asIdeal w'.isPrime
        exact PrimeSpectrum.ext ((hbot w).trans (hbot _).symm)
      · intro hz
        rw [Set.mem_singleton_iff] at hz
        exact ⟨_, hz.symm⟩
    rwa [h2] at h1

  have hrange : Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom) =
      V₀.hom ⁻¹' (closure {y})ᶜ := by
    rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
    rfl
  rw [hyc.closure_eq] at hrange

  have hfib : ∀ z : V₀.left, V₀.hom z = y → z = e.inv (IsLocalRing.closedPoint A) := by
    intro z hz
    obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := u0)
      z (IsLocalRing.closedPoint F'') hz
    obtain ⟨p', hp1', -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := u0)
      (e.inv (IsLocalRing.closedPoint A)) (IsLocalRing.closedPoint F'') hv
    have hpp : p = p' := by
      have h1 : ε.hom p = ε.hom p' := Subsingleton.elim _ _
      have h2 := congrArg ε.inv h1
      rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at h2
    rw [← hp1, ← hp1', hpp]

  intro x
  constructor
  · rintro ⟨w, hw⟩ hx
    rw [Scheme.Hom.comp_apply] at hw
    have h1 : e.inv x = (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom) w := by
      rw [← hw, Scheme.hom_inv_apply]
    have h2 : (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom) w ∈
        Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom) := ⟨w, rfl⟩
    rw [hrange, ← h1, hx] at h2
    exact h2 hv
  · intro hx
    have hih : ∀ p : Spec (.of A), e.hom (e.inv p) = p := by
      intro p
      first
      | exact Scheme.inv_hom_apply e p
      | exact congrArg (fun f : Spec (.of A) ⟶ Spec (.of A) => f p) e.inv_hom_id
    have h1 : e.inv x ∈ Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom) := by
      rw [hrange]
      intro h
      apply hx
      have h3 := hfib _ h
      have h4 := congrArg e.hom h3
      exact (hih x).symm.trans (h4.trans (hih _))
    obtain ⟨w, hw⟩ := h1
    refine ⟨w, ?_⟩
    rw [Scheme.Hom.comp_apply, hw]
    exact hih x

theorem wc_stpf_weaklyEtale_prime_mem : ∀ (k A : Type u) [Field k] [CommRing A] [IsDomain A]
    [IsLocalRing A] (ψ : Polynomial k →+* A),
    @Algebra.WeaklyEtale (Polynomial k) A _ _ ψ.toAlgebra →
    ∀ t : Polynomial k, t ≠ 0 → ψ t ∈ IsLocalRing.maximalIdeal A →
    ψ t ≠ 0 ∧ ∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → ψ t ∈ P :=
by
  intro k A _ _ _ _ ψ hW t ht htm
  letI : Algebra (Polynomial k) A := ψ.toAlgebra
  have hflat : Module.Flat (Polynomial k) A := hW.flat
  have h1 : ψ t ≠ 0 := by
    intro h0
    have hreg : IsSMulRegular A t :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ht)
    apply one_ne_zero (α := A)
    apply hreg
    show t • (1 : A) = t • (0 : A)
    rw [smul_zero, Algebra.smul_def, mul_one]
    exact h0
  have rc : ∀ (b : A), b ≠ 0 → ∀ n : ℕ, ∀ g : Polynomial A, g.natDegree ≤ n → g ≠ 0 →
      g.eval b = 0 → ∃ i, g.coeff i ≠ 0 ∧ b ∣ g.coeff i := by
    intro b hb n
    induction n with
    | zero =>
      intro g hg hg0 hgb
      refine ⟨0, ?_, ?_⟩
      · intro h
        apply hg0
        rw [Polynomial.eq_C_of_natDegree_le_zero hg, h, map_zero]
      · rw [Polynomial.eq_C_of_natDegree_le_zero hg, Polynomial.eval_C] at hgb
        rw [hgb]
        exact dvd_zero b
    | succ n ih =>
      intro g hg hg0 hgb
      have hdec := Polynomial.divX_mul_X_add g
      have hev0 := congrArg (Polynomial.eval b) hdec
      rw [hgb, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X,
        Polynomial.eval_C] at hev0
      by_cases hc : g.coeff 0 = 0
      · have hg1 : g.divX ≠ 0 := by
          intro h
          apply hg0
          rw [← hdec, h, hc]
          simp
        have hev : g.divX.eval b = 0 := by
          rw [hc, add_zero] at hev0
          exact (mul_eq_zero.mp hev0).resolve_right hb
        have hdeg : g.divX.natDegree ≤ n := by
          rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
          omega
        obtain ⟨i, hi1, hi2⟩ := ih g.divX hdeg hg1 hev
        refine ⟨i + 1, ?_, ?_⟩
        · rw [← Polynomial.coeff_divX]; exact hi1
        · rw [← Polynomial.coeff_divX]; exact hi2
      · refine ⟨0, hc, ?_⟩
        exact ⟨-(g.divX.eval b), by linear_combination hev0⟩
  refine ⟨h1, ?_⟩
  intro P hP hP0
  obtain ⟨b, hbP, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP0
  have hφ : Function.Injective (algebraMap A (FractionRing A)) := IsFractionRing.injective A _
  obtain ⟨f, hf0, hfb⟩ :=
    wc_weaklyEtale_point_algebraic (Polynomial k) A (FractionRing A) hW
      (algebraMap A (FractionRing A)) b
  have hψ : algebraMap (Polynomial k) A = ψ := rfl
  rw [hψ] at hf0 hfb
  set g := f.map ψ with hg
  have hgmap : g.map (algebraMap A (FractionRing A)) =
      f.map ((algebraMap A (FractionRing A)).comp ψ) := by
    rw [hg, Polynomial.map_map]
  have hg0 : g ≠ 0 := by
    intro h
    apply hf0
    rw [← hgmap, h, Polynomial.map_zero]
  have hgb : g.eval b = 0 := by
    apply hφ
    rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hgmap, Polynomial.eval_map]
    exact hfb
  obtain ⟨i, hi0, ⟨d, hd⟩⟩ := rc b hb0 g.natDegree g le_rfl hg0 hgb
  have hci : ψ (f.coeff i) = g.coeff i := by rw [hg, Polynomial.coeff_map]
  have hcP : ψ (f.coeff i) ∈ P := by
    rw [hci, hd]
    exact P.mul_mem_right d hbP
  have hc0 : f.coeff i ≠ 0 := by
    intro h
    apply hi0
    rw [← hci, h, map_zero]
  have hQ : (P.comap ψ).IsPrime := Ideal.comap_isPrime ψ P
  have hQ0 : P.comap ψ ≠ ⊥ := by
    intro h
    have hmem : f.coeff i ∈ P.comap ψ := Ideal.mem_comap.mpr hcP
    rw [h, Ideal.mem_bot] at hmem
    exact hc0 hmem
  have hQmax : (P.comap ψ).IsMaximal := Ideal.IsPrime.isMaximal hQ hQ0
  have hPm : P ≤ IsLocalRing.maximalIdeal A := IsLocalRing.le_maximalIdeal hP.ne_top
  have hQM : P.comap ψ ≤ (IsLocalRing.maximalIdeal A).comap ψ := Ideal.comap_mono hPm
  have hMne : (IsLocalRing.maximalIdeal A).comap ψ ≠ ⊤ := by
    intro h
    have h1m : (1 : Polynomial k) ∈ (IsLocalRing.maximalIdeal A).comap ψ := by
      rw [h]; exact Submodule.mem_top
    rw [Ideal.mem_comap, map_one] at h1m
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h1m)
  have heq := hQmax.eq_of_le hMne hQM
  have htQ : t ∈ P.comap ψ := by
    rw [heq]
    exact Ideal.mem_comap.mpr htm
  exact Ideal.mem_comap.mp htQ

theorem wc_stpf_normal_form : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A] (ϖ : A),
    ϖ ≠ 0 → Ideal.span {ϖ} = IsLocalRing.maximalIdeal A →
    (∀ P : Ideal A, P.IsPrime → P ≠ ⊥ → ϖ ∈ P) →
    ∀ a : A, a ≠ 0 → ∃ (u : Aˣ) (n : ℕ), a = u * ϖ ^ n :=
by
  classical
  intro A _ _ _ ϖ hϖ hm hP a ha
  have s1 : ¬ ϖ ∣ 1 := by
    intro h
    have h1 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
      rw [← hm]; exact Ideal.mem_span_singleton.mpr h
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
      (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
  have s3 : ∀ x : A, (∀ n : ℕ, ϖ ^ n ∣ x) → x = 0 := by
    intro x hx
    by_contra hx0
    let I : Ideal A := ⨅ n : ℕ, Ideal.span {ϖ ^ n}
    have hdisj : Disjoint (I : Set A) (Submonoid.powers ϖ : Set A) := by
      rw [Set.disjoint_left]
      intro y hyI hyS
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hyS
      have h1 : ϖ ^ k ∈ Ideal.span {ϖ ^ (k + 1)} := (Submodule.mem_iInf _).mp hyI (k + 1)
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp h1
      apply s1
      refine ⟨c, ?_⟩
      have hk : ϖ ^ k ≠ 0 := pow_ne_zero k hϖ
      apply mul_left_cancel₀ hk
      rw [mul_one]
      calc ϖ ^ k = ϖ ^ (k + 1) * c := hc
        _ = ϖ ^ k * (ϖ * c) := by ring
    obtain ⟨P, hPp, hIP, hPS⟩ := Ideal.exists_le_prime_disjoint I _ hdisj
    have hϖP : ϖ ∉ P := by
      intro h
      exact Set.disjoint_left.mp hPS h (Submonoid.mem_powers ϖ)
    have hxI : x ∈ I :=
      (Submodule.mem_iInf _).mpr (fun n => Ideal.mem_span_singleton.mpr (hx n))
    have hPne : P ≠ ⊥ := by
      intro hb
      apply hx0
      have h2 := hIP hxI
      rw [hb] at h2
      exact (Ideal.mem_bot).mp h2
    exact hϖP (hP P hPp hPne)
  have s4 : ∃ N : ℕ, ¬ ϖ ^ N ∣ a := by
    by_contra h
    push_neg at h
    exact ha (s3 a h)
  have hN : ¬ ϖ ^ (Nat.find s4) ∣ a := Nat.find_spec s4
  have hN0 : Nat.find s4 ≠ 0 := by
    intro h0; apply hN; rw [h0, pow_zero]; exact one_dvd a
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hN0
  have hdiv : ϖ ^ n ∣ a := by
    have h3 := Nat.find_min s4 (show n < Nat.find s4 by omega)
    exact not_not.mp h3
  obtain ⟨c, hc⟩ := hdiv
  have hcu : IsUnit c := by
    by_contra hcu
    have hcm : c ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal c).mpr hcu
    rw [← hm] at hcm
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp hcm
    apply hN
    rw [hn, Nat.succ_eq_add_one]
    exact ⟨d, by rw [hc, hd, pow_succ]; ring⟩
  exact ⟨hcu.unit, n, by rw [hcu.unit_spec, hc, mul_comm]⟩

theorem wc_stpf_hensel_roots : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (N : ℕ), IsUnit (N : A) →
    (∀ u : Aˣ, ∃ v : A, v ^ N = u) ∧ ∃ s : Finset A, s.card = N ∧ ∀ ζ ∈ s, ζ ^ N = 1 :=
by
  classical
  intro A _ _ _ N hN
  have hNk : ((N : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have h1 := hN.map (IsLocalRing.residue A)
    rw [map_natCast] at h1
    exact h1.ne_zero
  have hN0 : N ≠ 0 := by
    rintro rfl
    exact hNk (by simp)
  haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField A) := ⟨hNk⟩
  have lift : ∀ u : A, IsUnit u → ∀ a₀ : IsLocalRing.ResidueField A,
      a₀ ^ N = IsLocalRing.residue A u →
      ∃ a : A, a ^ N = u ∧ IsLocalRing.residue A a = a₀ := by
    intro u hu a₀ ha₀
    have hu0 : IsLocalRing.residue A u ≠ 0 := (hu.map (IsLocalRing.residue A)).ne_zero
    have ha0 : a₀ ≠ 0 := by
      rintro rfl
      rw [zero_pow hN0] at ha₀
      exact hu0 ha₀.symm
    obtain ⟨b, hb⟩ := IsLocalRing.residue_surjective a₀
    have hbu : IsUnit b := (IsLocalRing.residue_ne_zero_iff_isUnit b).mp (by rw [hb]; exact ha0)
    have hmon : (Polynomial.X ^ N - Polynomial.C u : Polynomial A).Monic :=
      Polynomial.monic_X_pow_sub_C u hN0
    have hmem : (Polynomial.X ^ N - Polynomial.C u : Polynomial A).eval b ∈
        IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        map_sub, map_pow, hb, ha₀, sub_self]
    have hder : IsUnit ((Polynomial.derivative (Polynomial.X ^ N - Polynomial.C u :
        Polynomial A)).eval b) := by
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
      exact hN.mul (hbu.pow _)
    obtain ⟨a, ha, hab⟩ := HenselianLocalRing.is_henselian _ hmon b hmem hder
    refine ⟨a, ?_, ?_⟩
    · have := ha.eq_zero
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at this
      exact sub_eq_zero.mp this
    · rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero] at hab
      rw [hab, hb]
  refine ⟨?_, ?_⟩
  · intro u
    obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue A (u : A)) N
    obtain ⟨a, ha, -⟩ := lift (u : A) u.isUnit z hz
    exact ⟨a, ha⟩
  · obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot
      (IsLocalRing.ResidueField A) N
    obtain ⟨ζ, hζ, hζr⟩ := lift 1 isUnit_one ζ₀ (by rw [hζ₀.pow_eq_one, map_one])
    refine ⟨(Finset.range N).image (fun i => ζ ^ i), ?_, ?_⟩
    · rw [Finset.card_image_of_injOn, Finset.card_range]
      intro i hi j hj hij
      have h2 : IsLocalRing.residue A (ζ ^ i) = IsLocalRing.residue A (ζ ^ j) := by
        simp only at hij
        rw [hij]
      rw [map_pow, map_pow, hζr] at h2
      exact hζ₀.pow_inj (Finset.mem_range.mp (Finset.mem_coe.mp hi))
        (Finset.mem_range.mp (Finset.mem_coe.mp hj)) h2
    · intro x hx
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hx
      rw [← pow_mul, mul_comm, pow_mul, hζ, one_pow]

theorem wc_stpf_punct_iso {S : Scheme.{u}} (O : S.Opens) (V : S.ProEt)
    (A : Type u) [CommRing A] (e : V.left ≅ Spec (.of A)) (ϖ : A)
    (K : Type u) [CommRing K] [Algebra A K] [IsLocalization.Away ϖ K]
    (hr : ∀ x : PrimeSpectrum A,
      x ∈ Set.range (Limits.pullback.snd O.ι V.hom ≫ e.hom) ↔ ϖ ∉ x.asIdeal) :
    Nonempty ((wcOpenRestr S O V).left ≅ Spec (CommRingCat.of K)) :=
by
  classical
  let f₁ : Limits.pullback O.ι V.hom ⟶ Spec (.of A) := Limits.pullback.snd O.ι V.hom ≫ e.hom
  let f₂ : Spec (.of K) ⟶ Spec (.of A) := Spec.map (CommRingCat.ofHom (algebraMap A K))
  haveI i1 : IsOpenImmersion f₁ := inferInstance
  haveI i2 : IsOpenImmersion f₂ := IsOpenImmersion.of_isLocalization ϖ
  have h2 := PrimeSpectrum.localization_away_comap_range K ϖ
  rw [Set.ext_iff] at h2
  have hrange : Set.range f₁.base = Set.range f₂.base := by
    ext x
    refine (hr x).trans ?_
    refine (Iff.trans ?_ (h2 x).symm).trans ?_
    · first
      | exact Iff.symm (PrimeSpectrum.mem_basicOpen _ _)
      | exact (PrimeSpectrum.mem_basicOpen (x := (x : PrimeSpectrum A)) ϖ).symm
      | (show ϖ ∉ (x : PrimeSpectrum A).asIdeal ↔ (x : PrimeSpectrum A) ∈ PrimeSpectrum.basicOpen ϖ
         exact (PrimeSpectrum.mem_basicOpen _ _).symm)
    · first
      | exact Iff.rfl
      | (constructor <;> rintro ⟨y, hy⟩ <;> exact ⟨y, hy⟩)
      | simp [f₂, Spec.map_base]
  let iso : Limits.pullback O.ι V.hom ≅ Spec (.of K) :=
    @IsOpenImmersion.isoOfRangeEq _ _ _ f₁ f₂ i1 i2 hrange
  exact ⟨iso⟩

theorem wc_stpf_kummer_frac : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    (ϖ : A) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ϖ ∈ IsLocalRing.maximalIdeal A → ϖ ≠ 0 →
    (∀ a : A, a ≠ 0 → ∃ (u : Aˣ) (n : ℕ), a = u * ϖ ^ n) →
    IsUnit ((ℓ : ℕ) : A) →
    (∀ m : ℕ, ∀ u : Aˣ, ∃ v : A, v ^ (ℓ ^ m) = u) →
    (∀ m : ℕ, ∃ s : Finset A, s.card = ℓ ^ m ∧ ∀ ζ ∈ s, ζ ^ (ℓ ^ m) = 1) →
    IsLocalization.Away ϖ (FractionRing A) ∧
    ((ℓ : ℕ) : FractionRing A) ≠ 0 ∧ algebraMap A (FractionRing A) ϖ ≠ 0 ∧
    (∀ m : ℕ, Nat.card {ζ : FractionRing A // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) ∧
    (∀ m : ℕ, ∀ x : FractionRing A, x ≠ 0 → ∃ (k : ℤ) (y : FractionRing A), y ≠ 0 ∧
      x = algebraMap A (FractionRing A) ϖ ^ k * y ^ (ℓ ^ m)) ∧
    (∀ m : ℕ, ∀ k : ℤ, (∃ y : FractionRing A, algebraMap A (FractionRing A) ϖ ^ k = y ^ (ℓ ^ m)) →
      ((ℓ ^ m : ℕ) : ℤ) ∣ k) :=
by
  intro A _ _ _ ϖ ℓ hℓp hϖm hϖ0 hnf hℓA hroot hmu
  have hinj : Function.Injective (algebraMap A (FractionRing A)) :=
    IsFractionRing.injective A (FractionRing A)
  have hπ0 : algebraMap A (FractionRing A) ϖ ≠ 0 := by
    intro h
    exact hϖ0 (hinj (h.trans (map_zero _).symm))
  have hnu : ¬ IsUnit ϖ := (IsLocalRing.mem_maximalIdeal ϖ).mp hϖm
  have hNpos : ∀ m : ℕ, 0 < ℓ ^ m := fun m => pow_pos hℓp.out.pos m

  have hNF : ∀ x : FractionRing A, x ≠ 0 → ∃ (w : Aˣ) (j : ℤ),
      x = algebraMap A (FractionRing A) (w : A) * algebraMap A (FractionRing A) ϖ ^ j := by
    intro x hx
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := A) x
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have ha0 : a ≠ 0 := by
      rintro rfl
      apply hx
      rw [map_zero, zero_div]
    obtain ⟨u, n, rfl⟩ := hnf a ha0
    obtain ⟨u', n', rfl⟩ := hnf b hb0
    refine ⟨u * u'⁻¹, (n : ℤ) - n', ?_⟩
    have hu' : algebraMap A (FractionRing A) (u' : A) ≠ 0 := by
      intro h
      exact u'.ne_zero (hinj (h.trans (map_zero _).symm))
    have hinv : algebraMap A (FractionRing A) ((u'⁻¹ : Aˣ) : A) =
        (algebraMap A (FractionRing A) (u' : A))⁻¹ :=
      (inv_eq_of_mul_eq_one_right (by rw [← map_mul, Units.mul_inv, map_one])).symm
    rw [Units.val_mul]
    simp only [map_mul, map_pow, hinv]
    rw [zpow_sub₀ hπ0, zpow_natCast, zpow_natCast, div_eq_mul_inv, div_eq_mul_inv, mul_inv]
    ring

  have hrig : ∀ (w : Aˣ) (j : ℤ),
      algebraMap A (FractionRing A) (w : A) = algebraMap A (FractionRing A) ϖ ^ j → j = 0 := by
    intro w j h
    rcases Int.eq_nat_or_neg j with ⟨n, rfl | rfl⟩
    · rw [zpow_natCast, ← map_pow] at h
      have h2 := hinj h
      rcases n with _ | n
      · simp
      · exfalso
        apply hnu
        have : IsUnit (ϖ ^ (n + 1)) := by rw [← h2]; exact w.isUnit
        exact (isUnit_pow_iff (Nat.succ_ne_zero n)).mp this
    · rw [zpow_neg, zpow_natCast, ← map_pow] at h
      have hp0 : algebraMap A (FractionRing A) (ϖ ^ n) ≠ 0 := by
        rw [map_pow]; exact pow_ne_zero _ hπ0
      have h3 : algebraMap A (FractionRing A) ((w : A) * ϖ ^ n) =
          algebraMap A (FractionRing A) 1 := by
        rw [map_mul, h, inv_mul_cancel₀ hp0, map_one]
      have h4 := hinj h3
      rcases n with _ | n
      · simp
      · exfalso
        apply hnu
        have h5 : IsUnit ((w : A) * ϖ ^ (n + 1)) := by rw [h4]; exact isUnit_one
        have : IsUnit (ϖ ^ (n + 1)) := (IsUnit.mul_iff.mp h5).2
        exact (isUnit_pow_iff (Nat.succ_ne_zero n)).mp this

  have hAway : IsLocalization.Away ϖ (FractionRing A) := by
    refine IsLocalization.Away.mk ϖ (Ne.isUnit hπ0) ?_ ?_
    · intro s
      by_cases hs : s = 0
      · exact ⟨0, 0, by rw [hs, zero_mul, map_zero]⟩
      · obtain ⟨w, j, rfl⟩ := hNF s hs
        rcases Int.eq_nat_or_neg j with ⟨n, rfl | rfl⟩
        · exact ⟨0, (w : A) * ϖ ^ n, by rw [pow_zero, mul_one, zpow_natCast, map_mul, map_pow]⟩
        · refine ⟨n, (w : A), ?_⟩
          rw [zpow_neg, zpow_natCast, mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hπ0), mul_one]
    · intro a b h
      exact ⟨0, by rw [hinj h]⟩

  have hℓK : ((ℓ : ℕ) : FractionRing A) ≠ 0 := by
    rw [← map_natCast (algebraMap A (FractionRing A))]
    intro h
    exact hℓA.ne_zero (hinj (h.trans (map_zero _).symm))

  have hK1 : ∀ m : ℕ, Nat.card {ζ : FractionRing A // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m := by
    intro m
    have hN := hNpos m
    obtain ⟨s, hs, hsζ⟩ := hmu m
    rw [Nat.card_congr (Equiv.subtypeEquivRight (fun ζ =>
      (Polynomial.mem_nthRootsFinset hN (1 : FractionRing A)).symm)), Nat.card_eq_finsetCard]
    apply le_antisymm
    · calc (Polynomial.nthRootsFinset (ℓ ^ m) (1 : FractionRing A)).card
          ≤ (Polynomial.nthRoots (ℓ ^ m) (1 : FractionRing A)).card := by
            unfold Polynomial.nthRootsFinset
            convert Multiset.toFinset_card_le _
        _ ≤ ℓ ^ m := Polynomial.card_nthRoots _ _
    · have hle := Finset.card_le_card_of_injOn (algebraMap A (FractionRing A)) (s := s)
        (t := Polynomial.nthRootsFinset (ℓ ^ m) (1 : FractionRing A)) ?_ hinj.injOn
      · rw [hs] at hle; exact hle
      · intro ζ hζ
        have hζ' : ζ ∈ s := hζ
        show algebraMap A (FractionRing A) ζ ∈ Polynomial.nthRootsFinset (ℓ ^ m) (1 : FractionRing A)
        rw [Polynomial.mem_nthRootsFinset hN, ← map_pow, hsζ ζ hζ', map_one]

  have hK2 : ∀ m : ℕ, ∀ x : FractionRing A, x ≠ 0 → ∃ (k : ℤ) (y : FractionRing A), y ≠ 0 ∧
      x = algebraMap A (FractionRing A) ϖ ^ k * y ^ (ℓ ^ m) := by
    intro m x hx
    obtain ⟨w, j, rfl⟩ := hNF x hx
    obtain ⟨v, hv⟩ := hroot m w
    refine ⟨j, algebraMap A (FractionRing A) v, ?_, ?_⟩
    · intro h0
      apply w.ne_zero
      rw [← hv, hinj (h0.trans (map_zero _).symm), zero_pow (hNpos m).ne']
    · rw [← map_pow, hv, mul_comm]

  have hK3 : ∀ m : ℕ, ∀ k : ℤ, (∃ y : FractionRing A,
      algebraMap A (FractionRing A) ϖ ^ k = y ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k := by
    rintro m k ⟨y, hy⟩
    have hN : ℓ ^ m ≠ 0 := (hNpos m).ne'
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hN] at hy
      exact zpow_ne_zero k hπ0 hy
    obtain ⟨w, i, rfl⟩ := hNF y hy0
    have h1 : algebraMap A (FractionRing A) ((w ^ (ℓ ^ m) : Aˣ) : A) =
        algebraMap A (FractionRing A) ϖ ^ (k - i * ((ℓ ^ m : ℕ) : ℤ)) := by
      have hpi : algebraMap A (FractionRing A) ϖ ^ i ≠ 0 := zpow_ne_zero _ hπ0
      rw [zpow_sub₀ hπ0, hy, mul_pow, Units.val_pow_eq_pow_val, map_pow, zpow_mul, zpow_natCast]
      field_simp
    have h2 := hrig _ _ h1
    exact ⟨i, by linear_combination h2⟩
  exact ⟨hAway, hℓK, hπ0, hK1, hK2, hK3⟩

theorem wc_strict_trait_punct_field_data (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom u0) :
    ∃ (K : Type u) (_ : Field K)
      (iK : (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀).left ≅
        Spec (CommRingCat.of K)) (ϖ : K),
      ((ℓ : ℕ) : K) ≠ 0 ∧ ϖ ≠ 0 ∧
      (∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) ∧
      (∀ m : ℕ, ∀ x : K, x ≠ 0 → ∃ (k : ℤ) (y : K), y ≠ 0 ∧ x = ϖ ^ k * y ^ (ℓ ^ m)) ∧
      (∀ m : ℕ, ∀ k : ℤ, (∃ y : K, ϖ ^ k = y ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k) :=
by
  classical

  obtain ⟨c, ψ, j, hj, hfac, hu, hWE, hW⟩ := wc_stpf_chart F'' u0 hu0 V₀ A e hv

  have hm : Ideal.span {ψ (Polynomial.X - Polynomial.C c)} = IsLocalRing.maximalIdeal A :=
    wc_stpf_fibre_maximal F'' V₀.hom u0 A e c ψ j hj hfac hu (AlgebraicClosure F'') ε
  have hϖm : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    rw [← hm]; exact Ideal.subset_span (Set.mem_singleton _)

  haveI := wc_proj_space_smooth F'' 1
  haveI hdom : IsDomain A :=
    wc_strictHensel_weaklyEtale_smooth_isDomain F'' (wcProjKStr F'' 1) 1 (CommRingCat.of A)
      (e.inv ≫ V₀.hom) hWE

  obtain ⟨hϖ0, hprime⟩ := wc_stpf_weaklyEtale_prime_mem F'' A ψ hW
    (Polynomial.X - Polynomial.C c) (Polynomial.X_sub_C_ne_zero c) hϖm

  have hnf := wc_stpf_normal_form A (ψ (Polynomial.X - Polynomial.C c)) hϖ0 hm hprime

  have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI : CharP F'' (ringChar F'') := ringChar.charP F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    letI := Fintype.ofFinite F''
    have hcard : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F''
    have h1 : ringChar F'' ∣ Nat.card F'' :=
      (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp hcard
    have h2 : ringChar F'' ∣ ℓ := (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp h0
    rcases (Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ h2 with h3 | h3
    · exact hp.one_lt.ne' h3
    · rw [h3] at h1
      exact hℓ h1
  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have h1 : IsUnit (Polynomial.C ((ℓ : ℕ) : F'')) := Polynomial.isUnit_C.mpr (Ne.isUnit hℓF)
    simpa only [map_natCast] using h1.map ψ
  have hℓpow : ∀ m : ℕ, IsUnit (((ℓ ^ m : ℕ)) : A) := fun m => by
    rw [Nat.cast_pow]; exact hℓA.pow m

  have hroot : ∀ m : ℕ, ∀ u : Aˣ, ∃ v : A, v ^ (ℓ ^ m) = u :=
    fun m => (wc_stpf_hensel_roots A (ℓ ^ m) (hℓpow m)).1
  have hmu : ∀ m : ℕ, ∃ s : Finset A, s.card = ℓ ^ m ∧ ∀ ζ ∈ s, ζ ^ (ℓ ^ m) = 1 :=
    fun m => (wc_stpf_hensel_roots A (ℓ ^ m) (hℓpow m)).2

  obtain ⟨hAway, hℓK, hπ, hK1, hK2, hK3⟩ :=
    wc_stpf_kummer_frac A (ψ (Polynomial.X - Polynomial.C c)) ℓ hϖm hϖ0 hnf hℓA hroot hmu

  have hr0 := wc_stpf_punct_range F'' u0 hu0 V₀ A e (AlgebraicClosure F'') ε hv
  have hr : ∀ x : PrimeSpectrum A,
      x ∈ Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom) ↔
        ψ (Polynomial.X - Polynomial.C c) ∉ x.asIdeal := by
    intro x
    rw [hr0 x]
    constructor
    · intro hx hmem
      apply hx
      have hle : IsLocalRing.maximalIdeal A ≤ x.asIdeal := by
        rw [← hm]
        exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem)
      have hge : x.asIdeal ≤ IsLocalRing.maximalIdeal A :=
        IsLocalRing.le_maximalIdeal x.isPrime.ne_top
      exact PrimeSpectrum.ext (le_antisymm hge hle)
    · intro hx hmem
      apply hx
      rw [hmem]
      exact hϖm

  haveI := hAway
  obtain ⟨iK⟩ := wc_stpf_punct_iso (wcPunctOpen F'' u0) V₀ A e
    (ψ (Polynomial.X - Polynomial.C c)) (FractionRing A) hr
  exact ⟨FractionRing A, inferInstance, iK, _, hℓK, hπ, hK1, hK2, hK3⟩

theorem wc_contSheaf_rank_one_over_triv (S : Scheme.{u}) (U : S.ProEt) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ τ : (wcContSheaf S ℚ_[ℓ]).over U ≅ (wcContSheaf S (Fin 1 → ℚ_[ℓ])).over U,
      (∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c)) ≫ τ.hom =
          τ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin 1 → ℚ_[ℓ]) c)
              (continuous_const_smul c))) ∧
      (∀ (W : S.ProEt) (w : W ⟶ U),
        τ.hom.hom.app (Opposite.op (Over.mk (w ≫ 𝟙 U))) =
          τ.hom.hom.app (Opposite.op (Over.mk w)) ≫
            (wcContSheafMap S
              (LinearMap.id : (Fin 1 → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin 1 → ℚ_[ℓ])).toAddMonoidHom
              (LinearMap.continuous_of_finiteDimensional
                (LinearMap.id : (Fin 1 → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin 1 → ℚ_[ℓ])))).hom.app
                  (Opposite.op W)) :=
by
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (V : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj V : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app V x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop V))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop V)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ V x
    rfl
  have hid : ∀ {A : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      (h : Continuous (AddMonoidHom.id A)), wcContSheafMap S (AddMonoidHom.id A) h = 𝟙 _ := by
    intro A _ _ _ h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    rfl
  have hcomp : ∀ {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C]
      (φ : A →+ B) (ψ : B →+ C) (χ : A →+ C) (_ : ψ.comp φ = χ) (hφ : Continuous φ)
      (hψ : Continuous ψ) (hχ : Continuous χ),
      wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ = wcContSheafMap S χ hχ := by
    intro A B C _ _ _ _ _ _ _ _ _ φ ψ χ h hφ hψ hχ
    subst h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    rfl
  let δ : ℚ_[ℓ] →+ (Fin 1 → ℚ_[ℓ]) :=
    { toFun := fun x _ => x, map_zero' := rfl, map_add' := fun _ _ => rfl }
  have hδ : Continuous δ := continuous_pi (fun _ => continuous_id)
  let ev : (Fin 1 → ℚ_[ℓ]) →+ ℚ_[ℓ] := Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0
  have hev : Continuous ev := continuous_apply 0
  have I1 : ev.comp δ = AddMonoidHom.id ℚ_[ℓ] := AddMonoidHom.ext fun x => rfl
  have I2 : δ.comp ev = AddMonoidHom.id (Fin 1 → ℚ_[ℓ]) :=
    AddMonoidHom.ext fun v => funext fun i => by
      rw [Fin.fin_one_eq_zero i]
      rfl
  have I3 : ∀ c : ℚ_[ℓ], δ.comp (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) =
      (DistribSMul.toAddMonoidHom (Fin 1 → ℚ_[ℓ]) c).comp δ :=
    fun c => AddMonoidHom.ext fun x => funext fun i => rfl
  let θ : wcContSheaf S ℚ_[ℓ] ≅ wcContSheaf S (Fin 1 → ℚ_[ℓ]) :=
    { hom := wcContSheafMap S δ hδ
      inv := wcContSheafMap S ev hev
      hom_inv_id := (hcomp δ ev (AddMonoidHom.id _) I1 hδ hev continuous_id).trans (hid _)
      inv_hom_id := (hcomp ev δ (AddMonoidHom.id _) I2 hev hδ continuous_id).trans (hid _) }
  have hsheaf : ∀ c : ℚ_[ℓ],
      wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c) ≫
        wcContSheafMap S δ hδ =
      wcContSheafMap S δ hδ ≫
        wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin 1 → ℚ_[ℓ]) c) (continuous_const_smul c) := by
    intro c
    exact (hcomp _ _ ((DistribSMul.toAddMonoidHom (Fin 1 → ℚ_[ℓ]) c).comp δ) (I3 c) _ _
        ((continuous_const_smul c).comp hδ)).trans
      (hcomp _ _ ((DistribSMul.toAddMonoidHom (Fin 1 → ℚ_[ℓ]) c).comp δ) rfl _ _
        ((continuous_const_smul c).comp hδ)).symm
  refine ⟨((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).mapIso θ,
    fun c => ?_, fun W w => ?_⟩
  · rw [Functor.mapIso_hom, ← Functor.map_comp, ← Functor.map_comp]
    exact congrArg _ (hsheaf c)
  · rw [Category.comp_id]
    have h1 : wcContSheafMap S
        (LinearMap.id : (Fin 1 → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin 1 → ℚ_[ℓ])).toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional
          (LinearMap.id : (Fin 1 → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin 1 → ℚ_[ℓ]))) = 𝟙 _ := hid _
    rw [h1]
    rfl

theorem wc_fpe_sepClosure_extend (K : Type u) [Field K] (ρK : K ≃+* K) :
    ∃ ρL : SeparableClosure K ≃+* SeparableClosure K, ∀ x : K,
      ρL (algebraMap K (SeparableClosure K) x) = algebraMap K (SeparableClosure K) (ρK x) :=
by
  classical
  obtain ⟨ι', hι'⟩ : ∃ ι' : K →+* SeparableClosure K,
      ι' = (algebraMap K (SeparableClosure K)).comp (ρK : K →+* K) := ⟨_, rfl⟩
  have hsep' : @Algebra.IsSeparable K (SeparableClosure K) _ _ ι'.toAlgebra := by
    refine @Algebra.IsSeparable.of_equiv_equiv K (SeparableClosure K) K (SeparableClosure K)
      _ _ _ _ _ ι'.toAlgebra ρK.symm (RingEquiv.refl _) ?_ inferInstance
    ext x
    rw [RingHom.algebraMap_toAlgebra, hι']
    simp
  have hcl' : @IsSepClosure K _ (SeparableClosure K) _ ι'.toAlgebra :=
    @IsSepClosure.mk K _ (SeparableClosure K) _ ι'.toAlgebra inferInstance hsep'
  have e := @IsSepClosure.equiv K _ (SeparableClosure K) (SeparableClosure K) _ _ ι'.toAlgebra
    hcl' _ inferInstance
  have h := @AlgEquiv.commutes K (SeparableClosure K) (SeparableClosure K) _ _ _ _ ι'.toAlgebra e
  obtain ⟨ρL, hρL⟩ : ∃ ρL : SeparableClosure K ≃+* SeparableClosure K, ∀ y, ρL y = e y :=
    ⟨@AlgEquiv.toRingEquiv K (SeparableClosure K) (SeparableClosure K) _ _ _ _ ι'.toAlgebra e,
      fun y => rfl⟩
  refine ⟨ρL, fun x => ?_⟩
  rw [hρL, h x, RingHom.algebraMap_toAlgebra, hι']
  rfl

theorem wc_fpe_tensor_galois_homeo (K : Type u) [Field K] :
    ∃ e : (SeparableClosure K ≃ₐ[K] SeparableClosure K) ≃ₜ PrimeSpectrum (wcFpeT2 K),
      ∀ g : SeparableClosure K ≃ₐ[K] SeparableClosure K,
        (e g).asIdeal = RingHom.ker (wcFpeMu2 K g) :=
by
  classical

  have hμ0 : ∀ (h : SeparableClosure K ≃ₐ[K] SeparableClosure K) (x : SeparableClosure K),
      wcFpeMu2 K h (wcFpeInc0 K x) = x := fun h x => by
    show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
        (h : SeparableClosure K →ₐ[K] SeparableClosure K) (x ⊗ₜ[K] (1 : SeparableClosure K)) = x
    rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
    rfl
  have hμ1 : ∀ (h : SeparableClosure K ≃ₐ[K] SeparableClosure K) (x : SeparableClosure K),
      wcFpeMu2 K h (wcFpeInc1 K x) = h x := fun h x => by
    show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
        (h : SeparableClosure K →ₐ[K] SeparableClosure K) ((1 : SeparableClosure K) ⊗ₜ[K] x) = h x
    rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
    rfl

  have hinj : ∀ g h : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      RingHom.ker (wcFpeMu2 K g) = RingHom.ker (wcFpeMu2 K h) → g = h := by
    intro g h hgh
    apply AlgEquiv.ext
    intro y
    have hw : wcFpeInc1 K y - wcFpeInc0 K (g y) ∈ RingHom.ker (wcFpeMu2 K g) := by
      rw [RingHom.mem_ker, map_sub, hμ0, hμ1, sub_self]
    rw [hgh, RingHom.mem_ker, map_sub, hμ0, hμ1, sub_eq_zero] at hw
    exact hw.symm

  have hsurj : ∀ P : PrimeSpectrum (wcFpeT2 K),
      ∃ g : SeparableClosure K ≃ₐ[K] SeparableClosure K, P.asIdeal = RingHom.ker (wcFpeMu2 K g) := by
    intro P
    have := P.isPrime
    have : IsDomain (wcFpeT2 K ⧸ P.asIdeal) := Ideal.Quotient.isDomain _
    let q : wcFpeT2 K →ₐ[K] (wcFpeT2 K ⧸ P.asIdeal) := Ideal.Quotient.mkₐ K P.asIdeal
    let k₀ : SeparableClosure K →ₐ[K] (wcFpeT2 K ⧸ P.asIdeal) :=
      q.comp (Algebra.TensorProduct.includeLeft :
        SeparableClosure K →ₐ[K] TensorProduct K (SeparableClosure K) (SeparableClosure K))
    let k₁ : SeparableClosure K →ₐ[K] (wcFpeT2 K ⧸ P.asIdeal) :=
      q.comp (Algebra.TensorProduct.includeRight :
        SeparableClosure K →ₐ[K] TensorProduct K (SeparableClosure K) (SeparableClosure K))
    have hk₀inj : Function.Injective k₀ :=
      (k₀ : SeparableClosure K →+* (wcFpeT2 K ⧸ P.asIdeal)).injective
    have hrange : ∀ x : SeparableClosure K, k₁ x ∈ k₀.range := by
      intro x
      have hint : IsIntegral K x := Algebra.IsIntegral.isIntegral x
      have hsep : (minpoly K x).Separable := Algebra.IsSeparable.isSeparable K x
      have hsplit : ((minpoly K x).map (algebraMap K (SeparableClosure K))).Splits :=
        IsSepClosed.splits_of_separable _ hsep.map
      have hne : (minpoly K x).map (algebraMap K (SeparableClosure K)) ≠ 0 :=
        ((minpoly.monic hint).map _).ne_zero
      have hroot : (((minpoly K x).map (algebraMap K (SeparableClosure K))).map
          (k₀ : SeparableClosure K →+* (wcFpeT2 K ⧸ P.asIdeal))).IsRoot (k₁ x) := by
        rw [Polynomial.map_map, AlgHom.comp_algebraMap, Polynomial.IsRoot.def,
          Polynomial.eval_map_algebraMap, Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
      obtain ⟨y, hy⟩ := RingHom.mem_range.mp (Polynomial.Splits.mem_range_of_isRoot hsplit hne hroot)
      exact ⟨y, hy⟩
    let ψ : SeparableClosure K →ₐ[K] SeparableClosure K :=
      ((AlgEquiv.ofInjective k₀ hk₀inj).symm : k₀.range →ₐ[K] SeparableClosure K).comp
        (k₁.codRestrict k₀.range hrange)
    let σ : SeparableClosure K ≃ₐ[K] SeparableClosure K :=
      AlgEquiv.ofBijective ψ (Algebra.IsAlgebraic.algHom_bijective ψ)
    have hσ : ∀ y, k₀ (σ y) = k₁ y := by
      intro y
      rw [← AlgEquiv.ofInjective_apply k₀ hk₀inj (σ y)]
      show (((AlgEquiv.ofInjective k₀ hk₀inj) ((AlgEquiv.ofInjective k₀ hk₀inj).symm
        (k₁.codRestrict k₀.range hrange y)) : k₀.range) : wcFpeT2 K ⧸ P.asIdeal) = k₁ y
      rw [AlgEquiv.apply_symm_apply]
      rfl
    have hq : ∀ t : wcFpeT2 K, q t = k₀ (wcFpeMu2 K σ t) := by
      intro t
      refine TensorProduct.induction_on (R := K) (M := SeparableClosure K) (N := SeparableClosure K)
        (motive := fun t : TensorProduct K (SeparableClosure K) (SeparableClosure K) =>
          q t = k₀ (wcFpeMu2 K σ t)) t ?_ ?_ ?_
      · exact (map_zero q).trans ((congrArg k₀ (map_zero (wcFpeMu2 K σ))).trans (map_zero k₀)).symm
      · intro x y
        have e : (x ⊗ₜ[K] y : wcFpeT2 K) = wcFpeInc0 K x * wcFpeInc1 K y := by
          show x ⊗ₜ[K] y = (x ⊗ₜ[K] (1 : SeparableClosure K)) * ((1 : SeparableClosure K) ⊗ₜ[K] y)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        show q (x ⊗ₜ[K] y : wcFpeT2 K) = k₀ (wcFpeMu2 K σ (x ⊗ₜ[K] y : wcFpeT2 K))
        rw [e, map_mul, map_mul, map_mul, hμ0, hμ1, hσ]
        rfl
      · intro x y hx hy
        exact (map_add q x y).trans ((congrArg₂ (· + ·) hx hy).trans
          ((congrArg k₀ (map_add (wcFpeMu2 K σ) x y)).trans (map_add k₀ _ _)).symm)
    refine ⟨σ, ?_⟩
    ext t
    rw [RingHom.mem_ker]
    constructor
    · intro ht
      have h1 : q t = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ht
      rw [hq] at h1
      exact (map_eq_zero_iff k₀ hk₀inj).mp h1
    · intro ht
      have h1 : q t = 0 := by rw [hq, ht, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1

  have hopen_set : ∀ t : wcFpeT2 K,
      IsOpen {g : SeparableClosure K ≃ₐ[K] SeparableClosure K | wcFpeMu2 K g t ≠ 0} := by
    intro t
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset (R := K) (M := SeparableClosure K)
      (N := SeparableClosure K) t
    have hform : ∀ h : SeparableClosure K ≃ₐ[K] SeparableClosure K,
        wcFpeMu2 K h t = ∑ s ∈ S, s.1 * h s.2 := by
      intro h
      show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
        (h : SeparableClosure K →ₐ[K] SeparableClosure K) t = _
      rw [hS, map_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [Algebra.TensorProduct.productMap_apply_tmul]
      rfl
    let E : IntermediateField K (SeparableClosure K) :=
      IntermediateField.adjoin K ((S.image Prod.snd : Finset (SeparableClosure K)) :
        Set (SeparableClosure K))
    have hEfd : FiniteDimensional K E :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
    rw [isOpen_iff_forall_mem_open]
    intro g₀ hg₀
    refine ⟨(fun h => g₀⁻¹ * h) ⁻¹'
      (E.fixingSubgroup : Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)), ?_, ?_, ?_⟩
    · intro h hh
      have hh' : g₀⁻¹ * h ∈ E.fixingSubgroup := hh
      have hagree : ∀ s ∈ S, h s.2 = g₀ s.2 := by
        intro s hs
        have hmem : s.2 ∈ E := IntermediateField.subset_adjoin K _
          (Finset.mem_coe.mpr (Finset.mem_image_of_mem Prod.snd hs))
        have h1 := (IntermediateField.mem_fixingSubgroup_iff E _).mp hh' s.2 hmem
        have e1 : (g₀ * (g₀⁻¹ * h)) s.2 = g₀ s.2 := by rw [AlgEquiv.mul_apply, h1]
        rwa [mul_inv_cancel_left] at e1
      show wcFpeMu2 K h t ≠ 0
      rw [hform, Finset.sum_congr rfl (fun s hs => by rw [hagree s hs]), ← hform]
      exact hg₀
    · exact (IntermediateField.fixingSubgroup_isOpen E).preimage (continuous_id.const_mul g₀⁻¹)
    · show g₀⁻¹ * g₀ ∈ E.fixingSubgroup
      rw [inv_mul_cancel]
      exact one_mem _

  have hsep_elt : ∀ (g : SeparableClosure K ≃ₐ[K] SeparableClosure K)
      (E : IntermediateField K (SeparableClosure K)), FiniteDimensional K E →
      ∃ t : wcFpeT2 K, ∀ h : SeparableClosure K ≃ₐ[K] SeparableClosure K,
        wcFpeMu2 K h t ≠ 0 ↔ ∀ x ∈ E, h x = g x := by
    intro g E hE
    let b := Module.finBasis K E
    let α : Fin (Module.finrank K E) → SeparableClosure K := fun i => (b i : SeparableClosure K)
    let R : Fin (Module.finrank K E) → Finset (SeparableClosure K) := fun i =>
      ((minpoly K (α i)).aroots (SeparableClosure K)).toFinset
    have hR : ∀ (h : SeparableClosure K ≃ₐ[K] SeparableClosure K) i, h (α i) ∈ R i := by
      intro h i
      rw [Multiset.mem_toFinset, Polynomial.mem_aroots]
      refine ⟨minpoly.ne_zero (Algebra.IsIntegral.isIntegral _), ?_⟩
      rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
    refine ⟨∏ i, ∏ β ∈ (R i).erase (g (α i)), (wcFpeInc1 K (α i) - wcFpeInc0 K β), ?_⟩
    intro h
    have hval : wcFpeMu2 K h (∏ i, ∏ β ∈ (R i).erase (g (α i)),
        (wcFpeInc1 K (α i) - wcFpeInc0 K β)) =
        ∏ i, ∏ β ∈ (R i).erase (g (α i)), (h (α i) - β) := by
      simp only [map_prod, map_sub, hμ0, hμ1]
    have key : (∀ i, h (α i) = g (α i)) ↔ ∀ x ∈ E, h x = g x := by
      constructor
      · intro hall x hx
        have hx' := b.sum_repr ⟨x, hx⟩
        have hxs : x = ∑ i, (b.repr ⟨x, hx⟩ i) • α i := by
          have h2 := congrArg E.val hx'
          rw [map_sum] at h2
          simp only [map_smul] at h2
          exact h2.symm
        rw [hxs, map_sum, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_smul, map_smul, hall i]
      · intro hall i
        exact hall _ (b i).2
    rw [hval, ← key]
    constructor
    · intro hne i
      by_contra hneq
      apply hne
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      exact Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hneq, hR h i⟩) (sub_self _)
    · intro hall
      rw [Finset.prod_ne_zero_iff]
      intro i _
      rw [Finset.prod_ne_zero_iff]
      intro β hβ
      rw [hall i]
      exact sub_ne_zero.mpr (Finset.mem_erase.mp hβ).1.symm

  let Φ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → PrimeSpectrum (wcFpeT2 K) :=
    fun g => ⟨RingHom.ker (wcFpeMu2 K g), RingHom.ker_isPrime _⟩
  have hΦinj : Function.Injective Φ := fun g h hgh =>
    hinj g h (congrArg PrimeSpectrum.asIdeal hgh)
  have hΦsurj : Function.Surjective Φ := fun P => by
    obtain ⟨g, hg⟩ := hsurj P
    exact ⟨g, PrimeSpectrum.ext hg.symm⟩

  have hcont : Continuous Φ := by
    rw [PrimeSpectrum.isTopologicalBasis_basic_opens.continuous_iff]
    rintro s ⟨r, rfl⟩
    have h1 : Φ ⁻¹' (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum (wcFpeT2 K))) =
        {g | wcFpeMu2 K g r ≠ 0} := by
      ext g
      exact (PrimeSpectrum.mem_basicOpen r (Φ g)).trans (not_congr RingHom.mem_ker)
    rw [h1]
    exact hopen_set r

  have hopen : IsOpenMap Φ := by
    intro W hW
    rw [isOpen_iff_forall_mem_open]
    rintro _ ⟨g, hgW, rfl⟩
    have hN : (fun k => g * k) ⁻¹' W ∈ nhds (1 : SeparableClosure K ≃ₐ[K] SeparableClosure K) := by
      apply IsOpen.mem_nhds (hW.preimage (continuous_id.const_mul g))
      show g * 1 ∈ W
      rw [mul_one]
      exact hgW
    obtain ⟨E, hE, hEN⟩ := (krullTopology_mem_nhds_one_iff K (SeparableClosure K) _).mp hN
    obtain ⟨t, ht⟩ := hsep_elt g E hE
    refine ⟨(PrimeSpectrum.basicOpen t : Set (PrimeSpectrum (wcFpeT2 K))), ?_,
      PrimeSpectrum.isOpen_basicOpen, ?_⟩
    · intro Q hQ
      obtain ⟨h, rfl⟩ := hΦsurj Q
      have h1 : t ∉ (Φ h).asIdeal := (PrimeSpectrum.mem_basicOpen t (Φ h)).mp hQ
      have hne : wcFpeMu2 K h t ≠ 0 := fun h0 => h1 (RingHom.mem_ker.mpr h0)
      have hagree := (ht h).mp hne
      have hfix : g⁻¹ * h ∈ E.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        rw [AlgEquiv.mul_apply, hagree x hx, ← AlgEquiv.mul_apply, inv_mul_cancel,
          AlgEquiv.one_apply]
      have h2 : g * (g⁻¹ * h) ∈ W := hEN hfix
      rw [mul_inv_cancel_left] at h2
      exact ⟨h, h2, rfl⟩
    · exact (PrimeSpectrum.mem_basicOpen t (Φ g)).mpr
        (fun h0 => ((ht g).mpr (fun _ _ => rfl)) (RingHom.mem_ker.mp h0))

  exact ⟨(Equiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩).toHomeomorphOfContinuousOpen hcont hopen,
    fun g => rfl⟩

theorem wc_fpe_tensor3_primes (K : Type u) [Field K] (P : PrimeSpectrum (wcFpeT3 K)) :
    ∃ g h : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      P.asIdeal = RingHom.ker (wcFpeMu3 K g h) :=
by
  classical

  have s1 : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra K D]
      (k₀ k₁ : SeparableClosure K →ₐ[K] D),
      ∃ σ : SeparableClosure K ≃ₐ[K] SeparableClosure K, ∀ x, k₁ x = k₀ (σ x) := by
    intro D _ _ _ k₀ k₁
    have hrange : ∀ x, k₁ x ∈ k₀.range := by
      intro x
      have hint : IsIntegral K x := Algebra.IsSeparable.isIntegral K x
      have hsep : (minpoly K x).Separable := Algebra.IsSeparable.isSeparable K x
      have hspl : ((minpoly K x).map (algebraMap K (SeparableClosure K))).Splits :=
        IsSepClosed.splits_codomain _ hsep
      have hmon : ((minpoly K x).map (algebraMap K (SeparableClosure K))).Monic :=
        (minpoly.monic hint).map _
      obtain ⟨R, hR⟩ : ∃ R : Multiset (SeparableClosure K),
          (minpoly K x).map (algebraMap K (SeparableClosure K)) =
            (R.map (fun r => Polynomial.X - Polynomial.C r)).prod :=
        ⟨_, hspl.eq_prod_roots_of_monic hmon⟩
      have h1 : (minpoly K x).map (algebraMap K D) =
          (R.map (fun r => Polynomial.X - Polynomial.C (k₀ r))).prod := by
        have e1 : (minpoly K x).map (algebraMap K D) =
            ((minpoly K x).map (algebraMap K (SeparableClosure K))).map
              (k₀ : SeparableClosure K →+* D) := by
          rw [Polynomial.map_map, AlgHom.comp_algebraMap]
        rw [e1, hR, Polynomial.map_multiset_prod, Multiset.map_map]
        congr 1
        apply Multiset.map_congr rfl
        intro r _
        simp
      have h2 : Polynomial.eval (k₁ x) ((minpoly K x).map (algebraMap K D)) = 0 := by
        rw [Polynomial.eval_map, ← Polynomial.aeval_def, Polynomial.aeval_algHom_apply,
          minpoly.aeval, map_zero]
      rw [h1, Polynomial.eval_multiset_prod, Multiset.map_map, Multiset.prod_eq_zero_iff] at h2
      obtain ⟨r, _, hr⟩ := Multiset.mem_map.mp h2
      simp only [Function.comp_apply, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C] at hr
      rw [sub_eq_zero.mp hr]
      exact AlgHom.mem_range_self k₀ r
    have hinj : Function.Injective k₀ := (k₀ : SeparableClosure K →+* D).injective
    let e : SeparableClosure K ≃ₐ[K] k₀.range := AlgEquiv.ofInjective k₀ hinj
    let c : SeparableClosure K →ₐ[K] k₀.range := k₁.codRestrict k₀.range hrange
    let ψ : SeparableClosure K →ₐ[K] SeparableClosure K :=
      (e.symm : k₀.range →ₐ[K] SeparableClosure K).comp c
    have hψ : ∀ x, k₀ (ψ x) = k₁ x := by
      intro x
      have h1 : e (ψ x) = c x := e.apply_symm_apply (c x)
      have h2 := congrArg Subtype.val h1
      have h3 : (e (ψ x) : D) = k₀ (ψ x) := AlgEquiv.ofInjective_apply k₀ hinj (ψ x)
      exact h3.symm.trans h2
    have hbij : Function.Bijective ψ := Algebra.IsAlgebraic.algHom_bijective ψ
    refine ⟨AlgEquiv.ofBijective ψ hbij, fun x => ?_⟩
    rw [AlgEquiv.ofBijective_apply, hψ]

  haveI := P.isPrime
  letI : Algebra K (wcFpeT3 K ⧸ P.asIdeal) :=
    ((Ideal.Quotient.mk P.asIdeal).comp
      ((wcFpeInc30 K).comp (algebraMap K (SeparableClosure K)))).toAlgebra
  have T1 : ∀ c : K, wcFpeIncR3 K (wcFpeInc0 K (algebraMap K (SeparableClosure K) c)) =
      wcFpeInc30 K (algebraMap K (SeparableClosure K) c) := by
    intro c
    have h0 : wcFpeInc0 K (algebraMap K (SeparableClosure K) c) = algebraMap K (wcFpeT2 K) c := rfl
    rw [h0]
    exact (Algebra.TensorProduct.includeRight :
      wcFpeT2 K →ₐ[K] TensorProduct K (SeparableClosure K) (wcFpeT2 K)).commutes c
  have T2 : ∀ c : K, wcFpeIncR3 K (wcFpeInc1 K (algebraMap K (SeparableClosure K) c)) =
      wcFpeInc30 K (algebraMap K (SeparableClosure K) c) := by
    intro c
    have h1 : wcFpeInc1 K (algebraMap K (SeparableClosure K) c) = algebraMap K (wcFpeT2 K) c :=
      (Algebra.TensorProduct.includeRight : SeparableClosure K →ₐ[K]
        TensorProduct K (SeparableClosure K) (SeparableClosure K)).commutes c
    rw [h1]
    exact (Algebra.TensorProduct.includeRight :
      wcFpeT2 K →ₐ[K] TensorProduct K (SeparableClosure K) (wcFpeT2 K)).commutes c
  let k₀ : SeparableClosure K →ₐ[K] (wcFpeT3 K ⧸ P.asIdeal) :=
    { toRingHom := (Ideal.Quotient.mk P.asIdeal).comp (wcFpeInc30 K)
      commutes' := fun c => rfl }
  let k₁ : SeparableClosure K →ₐ[K] (wcFpeT3 K ⧸ P.asIdeal) :=
    { toRingHom := (Ideal.Quotient.mk P.asIdeal).comp ((wcFpeIncR3 K).comp (wcFpeInc0 K))
      commutes' := fun c => by
        show Ideal.Quotient.mk P.asIdeal
            (wcFpeIncR3 K (wcFpeInc0 K (algebraMap K (SeparableClosure K) c))) =
          Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (algebraMap K (SeparableClosure K) c))
        rw [T1] }
  let k₂ : SeparableClosure K →ₐ[K] (wcFpeT3 K ⧸ P.asIdeal) :=
    { toRingHom := (Ideal.Quotient.mk P.asIdeal).comp ((wcFpeIncR3 K).comp (wcFpeInc1 K))
      commutes' := fun c => by
        show Ideal.Quotient.mk P.asIdeal
            (wcFpeIncR3 K (wcFpeInc1 K (algebraMap K (SeparableClosure K) c))) =
          Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (algebraMap K (SeparableClosure K) c))
        rw [T2] }

  obtain ⟨g, hg⟩ := s1 (wcFpeT3 K ⧸ P.asIdeal) k₀ k₁
  obtain ⟨h, hh⟩ := s1 (wcFpeT3 K ⧸ P.asIdeal) k₀ k₂
  have hg' : ∀ y, Ideal.Quotient.mk P.asIdeal (wcFpeIncR3 K (wcFpeInc0 K y)) =
      Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (g y)) := fun y => hg y
  have hh' : ∀ z, Ideal.Quotient.mk P.asIdeal (wcFpeIncR3 K (wcFpeInc1 K z)) =
      Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (h z)) := fun z => hh z

  have hμ3l : ∀ x, wcFpeMu3 K g h (wcFpeInc30 K x) = x := fun x => by
    have hx := Algebra.TensorProduct.productMap_apply_tmul (AlgHom.id K (SeparableClosure K))
      (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
        (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
      x (1 : wcFpeT2 K)
    have h1 : (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
        (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
        (1 : wcFpeT2 K) = 1 := map_one _
    exact hx.trans ((congrArg (fun y => (AlgHom.id K (SeparableClosure K)) x * y) h1).trans
      (mul_one _))
  have hμ3rl : ∀ x, wcFpeMu3 K g h (wcFpeIncR3 K (wcFpeInc0 K x)) = g x := fun x => by
    show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
      (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
        (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
      ((1 : SeparableClosure K) ⊗ₜ[K]
        ((x ⊗ₜ[K] (1 : SeparableClosure K) : TensorProduct K (SeparableClosure K) (SeparableClosure K)) :
          wcFpeT2 K)) = g x
    rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.productMap_apply_tmul,
      map_one, map_one, one_mul, mul_one]
    rfl
  have hμ3rr : ∀ x, wcFpeMu3 K g h (wcFpeIncR3 K (wcFpeInc1 K x)) = h x := fun x => by
    show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
      (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
        (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
      ((1 : SeparableClosure K) ⊗ₜ[K]
        (((1 : SeparableClosure K) ⊗ₜ[K] x : TensorProduct K (SeparableClosure K) (SeparableClosure K)) :
          wcFpeT2 K)) = h x
    rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.productMap_apply_tmul,
      map_one, map_one, one_mul, one_mul]
    rfl

  have inner : ∀ s : wcFpeT2 K, Ideal.Quotient.mk P.asIdeal (wcFpeIncR3 K s) =
      Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h (wcFpeIncR3 K s))) := by
    intro s
    refine TensorProduct.induction_on (R := K) (M := SeparableClosure K) (N := SeparableClosure K)
      (motive := fun s : TensorProduct K (SeparableClosure K) (SeparableClosure K) =>
        Ideal.Quotient.mk P.asIdeal (wcFpeIncR3 K s) =
          Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h (wcFpeIncR3 K s))))
      s ?_ ?_ ?_
    · show Ideal.Quotient.mk P.asIdeal (wcFpeIncR3 K 0) =
        Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h (wcFpeIncR3 K 0)))
      simp only [map_zero]
    · intro y z
      have e : (y ⊗ₜ[K] z : wcFpeT2 K) = wcFpeInc0 K y * wcFpeInc1 K z := by
        show y ⊗ₜ[K] z = (y ⊗ₜ[K] (1 : SeparableClosure K)) * ((1 : SeparableClosure K) ⊗ₜ[K] z)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      show Ideal.Quotient.mk P.asIdeal (wcFpeIncR3 K (y ⊗ₜ[K] z : wcFpeT2 K)) =
        Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h (wcFpeIncR3 K (y ⊗ₜ[K] z : wcFpeT2 K))))
      rw [e]
      simp only [map_mul]
      rw [hμ3rl, hμ3rr]
      exact congrArg₂ (· * ·) (hg' y) (hh' z)
    · intro a b ha hb
      exact (map_add ((Ideal.Quotient.mk P.asIdeal).comp (wcFpeIncR3 K)) a b).trans
        ((congrArg₂ (· + ·) ha hb).trans
        (map_add ((Ideal.Quotient.mk P.asIdeal).comp ((wcFpeInc30 K).comp
          ((wcFpeMu3 K g h).comp (wcFpeIncR3 K)))) a b).symm)
  have hq : ∀ t, Ideal.Quotient.mk P.asIdeal t =
      Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h t)) := by
    intro t
    refine TensorProduct.induction_on (R := K) (M := SeparableClosure K) (N := wcFpeT2 K)
      (motive := fun t : TensorProduct K (SeparableClosure K) (wcFpeT2 K) =>
        Ideal.Quotient.mk P.asIdeal t =
          Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h t)))
      t ?_ ?_ ?_
    · show Ideal.Quotient.mk P.asIdeal (0 : wcFpeT3 K) =
        Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h (0 : wcFpeT3 K)))
      simp only [map_zero]
    · intro x s
      have e : (x ⊗ₜ[K] s : wcFpeT3 K) = wcFpeInc30 K x * wcFpeIncR3 K s := by
        show x ⊗ₜ[K] s = (x ⊗ₜ[K] (1 : wcFpeT2 K)) * ((1 : SeparableClosure K) ⊗ₜ[K] s)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      show Ideal.Quotient.mk P.asIdeal (x ⊗ₜ[K] s : wcFpeT3 K) =
        Ideal.Quotient.mk P.asIdeal (wcFpeInc30 K (wcFpeMu3 K g h (x ⊗ₜ[K] s : wcFpeT3 K)))
      rw [e]
      simp only [map_mul]
      rw [hμ3l]
      exact congrArg₂ (· * ·) rfl (inner s)
    · intro a b ha hb
      exact (map_add (Ideal.Quotient.mk P.asIdeal) a b).trans ((congrArg₂ (· + ·) ha hb).trans
        (map_add ((Ideal.Quotient.mk P.asIdeal).comp ((wcFpeInc30 K).comp (wcFpeMu3 K g h)))
          a b).symm)

  refine ⟨g, h, ?_⟩
  have hinj : Function.Injective ((Ideal.Quotient.mk P.asIdeal).comp (wcFpeInc30 K)) :=
    RingHom.injective _
  have hcomp : Ideal.Quotient.mk P.asIdeal =
      ((Ideal.Quotient.mk P.asIdeal).comp (wcFpeInc30 K)).comp (wcFpeMu3 K g h) :=
    RingHom.ext hq
  rw [← RingHom.ker_comp_of_injective (wcFpeMu3 K g h) hinj, ← hcomp, Ideal.mk_ker]

theorem wc_fpe_nerve_tensor_model (S : Scheme.{u}) (U Ω : S.ProEt) (p : Ω ⟶ U) (K : Type u) [Field K]
    (iK : U.left ≅ Spec (CommRingCat.of K))
    (iΩ : Ω.left ≅ Spec (CommRingCat.of (SeparableClosure K)))
    (hp : iΩ.inv ≫ p.left ≫ iK.hom =
      Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))) :
    ∃ (κ₂ : (wcFpeNerve S U Ω p 2).left ≅ Spec (CommRingCat.of (wcFpeT2 K)))
      (κ₃ : (wcFpeNerve S U Ω p 3).left ≅ Spec (CommRingCat.of (wcFpeT3 K))),
      κ₂.hom ≫ Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) =
        (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left ≫ iΩ.hom ∧
      κ₂.hom ≫ Spec.map (CommRingCat.ofHom (wcFpeInc1 K)) =
        (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left ≫ iΩ.hom ∧
      κ₃.hom ≫ Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) =
        (Limits.WidePullback.π (fun _ : Fin 3 => p) 0).left ≫ iΩ.hom ∧
      κ₃.hom ≫ Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc0 K))) =
        (Limits.WidePullback.π (fun _ : Fin 3 => p) 1).left ≫ iΩ.hom ∧
      κ₃.hom ≫ Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc1 K))) =
        (Limits.WidePullback.π (fun _ : Fin 3 => p) 2).left ≫ iΩ.hom :=
by
  classical
  have hspec : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C), Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom (g.comp f)) := by
    intro A B C _ _ _ f g
    rw [CommRingCat.ofHom_comp, Spec.map_comp]

  have T1 : ∀ (n : ℕ) (T : Scheme.{u}) (t₀ : T ⟶ U.left) (t : Fin n → (T ⟶ Ω.left)),
      (∀ l, t l ≫ p.left = t₀) → ∃! f : T ⟶ (wcFpeNerve S U Ω p n).left,
        (∀ l, f ≫ (Limits.WidePullback.π (fun _ : Fin n => p) l).left = t l) ∧
        f ≫ (Limits.WidePullback.base (fun _ : Fin n => p)).left = t₀ := by
    intro n T t₀ t ht
    let D := Limits.WidePullbackShape.wideCospan U (fun _ : Fin n => Ω) (fun _ => p)
    have hc : Limits.IsLimit
        ((Scheme.ProEt.forget S ⋙ Over.forget S).mapCone (Limits.limit.cone D)) :=
      Limits.isLimitOfPreserves _ (Limits.limit.isLimit D)
    let s : Limits.Cone (D ⋙ (Scheme.ProEt.forget S ⋙ Over.forget S)) :=
      Limits.WidePullbackShape.mkCone (F := D ⋙ (Scheme.ProEt.forget S ⋙ Over.forget S))
        t₀ t (fun l => ht l)
    refine ⟨hc.lift s, ⟨fun l => hc.fac s (some l), hc.fac s none⟩, ?_⟩
    rintro f' ⟨h1, h2⟩
    apply hc.hom_ext
    rintro (_ | l)
    · exact h2.trans (hc.fac s none).symm
    · exact (h1 l).trans (hc.fac s (some l)).symm

  let P : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))))
      (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))) ≅
      Spec (CommRingCat.of (wcFpeT2 K)) :=
    pullbackSpecIso K (SeparableClosure K) (SeparableClosure K)
  have e0 : P.hom ≫ Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) = Limits.pullback.fst _ _ :=
    pullbackSpecIso_hom_fst _ _ _
  have e1 : P.hom ≫ Spec.map (CommRingCat.ofHom (wcFpeInc1 K)) = Limits.pullback.snd _ _ :=
    pullbackSpecIso_hom_snd _ _ _
  have i0 : P.inv ≫ Limits.pullback.fst _ _ = Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) :=
    pullbackSpecIso_inv_fst _ _ _
  have i1 : P.inv ≫ Limits.pullback.snd _ _ = Spec.map (CommRingCat.ofHom (wcFpeInc1 K)) :=
    pullbackSpecIso_inv_snd _ _ _
  have T2 : ∀ (T : Scheme.{u}) (a₁ a₂ : T ⟶ Spec (CommRingCat.of (SeparableClosure K))),
      a₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
        a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) →
      ∃! f : T ⟶ Spec (CommRingCat.of (wcFpeT2 K)),
        f ≫ Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) = a₁ ∧
        f ≫ Spec.map (CommRingCat.ofHom (wcFpeInc1 K)) = a₂ := by
    intro T a₁ a₂ h
    refine ⟨Limits.pullback.lift a₁ a₂ h ≫ P.hom, ⟨?_, ?_⟩, ?_⟩
    · rw [Category.assoc, e0, Limits.pullback.lift_fst]
    · rw [Category.assoc, e1, Limits.pullback.lift_snd]
    · rintro f' ⟨h1, h2⟩
      have hf : f' ≫ P.inv = Limits.pullback.lift a₁ a₂ h := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, i0, h1]
        · rw [Limits.pullback.lift_snd, Category.assoc, i1, h2]
      rw [← hf, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have c2 : Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      Spec.map (CommRingCat.ofHom (wcFpeInc1 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) := by
    rw [← i0, ← i1, Category.assoc, Category.assoc, Limits.pullback.condition]
  have hSβ : Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      Spec.map (CommRingCat.ofHom (algebraMap K (wcFpeT2 K))) := by
    rw [hspec]
    refine congrArg (fun f : K →+* wcFpeT2 K => Spec.map (CommRingCat.ofHom f)) ?_
    refine RingHom.ext fun r => ?_
    rfl

  let Q : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))))
      (Spec.map (CommRingCat.ofHom (algebraMap K (wcFpeT2 K)))) ≅
      Spec (CommRingCat.of (wcFpeT3 K)) :=
    pullbackSpecIso K (SeparableClosure K) (wcFpeT2 K)
  have f0 : Q.hom ≫ Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) = Limits.pullback.fst _ _ :=
    pullbackSpecIso_hom_fst _ _ _
  have fR : Q.hom ≫ Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)) = Limits.pullback.snd _ _ :=
    pullbackSpecIso_hom_snd _ _ _
  have g0 : Q.inv ≫ Limits.pullback.fst _ _ = Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) :=
    pullbackSpecIso_inv_fst _ _ _
  have gR : Q.inv ≫ Limits.pullback.snd _ _ = Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)) :=
    pullbackSpecIso_inv_snd _ _ _
  have c3 : Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (wcFpeT2 K))) := by
    rw [← g0, ← gR, Category.assoc, Category.assoc, Limits.pullback.condition]
  have T3 : ∀ (T : Scheme.{u}) (a₁ a₂ a₃ : T ⟶ Spec (CommRingCat.of (SeparableClosure K))),
      a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
        a₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) →
      a₃ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
        a₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) →
      ∃! f : T ⟶ Spec (CommRingCat.of (wcFpeT3 K)),
        f ≫ Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) = a₁ ∧
        f ≫ Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc0 K))) = a₂ ∧
        f ≫ Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc1 K))) = a₃ := by
    intro T a₁ a₂ a₃ h₂ h₃
    obtain ⟨g, ⟨hg0, hg1⟩, hgu⟩ := T2 T a₂ a₃ (h₂.trans h₃.symm)
    have w : a₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
        g ≫ Spec.map (CommRingCat.ofHom (algebraMap K (wcFpeT2 K))) := by
      rw [← hSβ, ← Category.assoc, hg0, h₂]
    refine ⟨Limits.pullback.lift a₁ g w ≫ Q.hom, ⟨?_, ?_, ?_⟩, ?_⟩
    · rw [Category.assoc, f0, Limits.pullback.lift_fst]
    · rw [← hspec, Category.assoc, reassoc_of% fR, Limits.pullback.lift_snd_assoc, hg0]
    · rw [← hspec, Category.assoc, reassoc_of% fR, Limits.pullback.lift_snd_assoc, hg1]
    · rintro f' ⟨h1, h2, h3⟩
      have hgR : f' ≫ Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)) = g := by
        refine hgu _ ⟨?_, ?_⟩
        · rw [Category.assoc, hspec, h2]
        · rw [Category.assoc, hspec, h3]
      have hf : f' ≫ Q.inv = Limits.pullback.lift a₁ g w := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, g0, h1]
        · rw [Limits.pullback.lift_snd, Category.assoc, gR, hgR]
      rw [← hf, Category.assoc, Iso.inv_hom_id, Category.comp_id]

  have hp1 : iΩ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      p.left ≫ iK.hom := by
    rw [← hp, Iso.hom_inv_id_assoc]
  have hp2 : iΩ.inv ≫ p.left =
      Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) ≫ iK.inv := by
    rw [← hp]; simp
  have hp3 : iΩ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) ≫
      iK.inv = p.left := by
    rw [← Category.assoc, hp1, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hπ : ∀ (n : ℕ) (l : Fin n), (Limits.WidePullback.π (fun _ : Fin n => p) l).left ≫ p.left =
      (Limits.WidePullback.base (fun _ : Fin n => p)).left := by
    intro n l
    exact congrArg (fun f => f.left) (Limits.WidePullback.π_arrow (fun _ : Fin n => p) l)
  have haN : ∀ (n : ℕ) (l : Fin n),
      ((Limits.WidePullback.π (fun _ : Fin n => p) l).left ≫ iΩ.hom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      (Limits.WidePullback.base (fun _ : Fin n => p)).left ≫ iK.hom := by
    intro n l
    rw [Category.assoc, hp1, ← Category.assoc, hπ]

  obtain ⟨φ₂, ⟨hφ0, hφ1⟩, -⟩ := T2 _ _ _ ((haN 2 0).trans (haN 2 1).symm)
  let c2v : Fin 2 → (Spec (CommRingCat.of (wcFpeT2 K)) ⟶ Spec (CommRingCat.of (SeparableClosure K))) :=
    ![Spec.map (CommRingCat.ofHom (wcFpeInc0 K)), Spec.map (CommRingCat.ofHom (wcFpeInc1 K))]
  have hc2v : ∀ l, c2v l ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) := by
    intro l
    fin_cases l
    exacts [rfl, c2.symm]
  have hφc2 : ∀ l, φ₂ ≫ c2v l = (Limits.WidePullback.π (fun _ : Fin 2 => p) l).left ≫ iΩ.hom := by
    intro l
    fin_cases l
    exacts [hφ0, hφ1]
  obtain ⟨ψ₂, ⟨hψπ2, hψb2⟩, -⟩ := T1 2 (Spec (CommRingCat.of (wcFpeT2 K)))
    (Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) ≫ iK.inv)
    (fun l => c2v l ≫ iΩ.inv)
    (fun l => by rw [Category.assoc, hp2, ← Category.assoc, hc2v l, Category.assoc])
  have hψ20 : ψ₂ ≫ (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left =
      Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) ≫ iΩ.inv := hψπ2 0
  have hψ21 : ψ₂ ≫ (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left =
      Spec.map (CommRingCat.ofHom (wcFpeInc1 K)) ≫ iΩ.inv := hψπ2 1
  have hhi2 : φ₂ ≫ ψ₂ = 𝟙 _ := by
    obtain ⟨_, _, hu⟩ := T1 2 _ (Limits.WidePullback.base (fun _ : Fin 2 => p)).left
      (fun l => (Limits.WidePullback.π (fun _ : Fin 2 => p) l).left) (hπ 2)
    refine (hu _ ⟨?_, ?_⟩).trans (hu _ ⟨fun l => Category.id_comp _, Category.id_comp _⟩).symm
    · intro l
      rw [Category.assoc, hψπ2 l, ← Category.assoc, hφc2 l, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    · rw [Category.assoc, hψb2, ← Category.assoc, hφ0, Category.assoc, hp3, hπ]
  have hih2 : ψ₂ ≫ φ₂ = 𝟙 _ := by
    obtain ⟨_, _, hu⟩ := T2 _ (Spec.map (CommRingCat.ofHom (wcFpeInc0 K)))
      (Spec.map (CommRingCat.ofHom (wcFpeInc1 K))) c2
    refine (hu _ ⟨?_, ?_⟩).trans (hu _ ⟨Category.id_comp _, Category.id_comp _⟩).symm
    · rw [Category.assoc, hφ0, ← Category.assoc, hψ20, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
    · rw [Category.assoc, hφ1, ← Category.assoc, hψ21, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]

  obtain ⟨φ₃, ⟨hφ30, hφ31, hφ32⟩, -⟩ :=
    T3 _ _ _ _ ((haN 3 1).trans (haN 3 0).symm) ((haN 3 2).trans (haN 3 0).symm)
  let c3v : Fin 3 → (Spec (CommRingCat.of (wcFpeT3 K)) ⟶ Spec (CommRingCat.of (SeparableClosure K))) :=
    ![Spec.map (CommRingCat.ofHom (wcFpeInc30 K)),
      Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc0 K))),
      Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc1 K)))]
  have hc31 : Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc0 K))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) := by
    rw [← hspec, Category.assoc, hSβ, c3]
  have hc32 : Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc1 K))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) := by
    rw [← hspec, Category.assoc, ← c2, hSβ, c3]
  have hc3v : ∀ l, c3v l ≫ Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) =
      Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) := by
    intro l
    fin_cases l
    exacts [rfl, hc31, hc32]
  have hφc3 : ∀ l, φ₃ ≫ c3v l = (Limits.WidePullback.π (fun _ : Fin 3 => p) l).left ≫ iΩ.hom := by
    intro l
    fin_cases l
    exacts [hφ30, hφ31, hφ32]
  obtain ⟨ψ₃, ⟨hψπ3, hψb3⟩, -⟩ := T1 3 (Spec (CommRingCat.of (wcFpeT3 K)))
    (Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))) ≫ iK.inv)
    (fun l => c3v l ≫ iΩ.inv)
    (fun l => by rw [Category.assoc, hp2, ← Category.assoc, hc3v l, Category.assoc])
  have hψ30 : ψ₃ ≫ (Limits.WidePullback.π (fun _ : Fin 3 => p) 0).left =
      Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) ≫ iΩ.inv := hψπ3 0
  have hψ31 : ψ₃ ≫ (Limits.WidePullback.π (fun _ : Fin 3 => p) 1).left =
      Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc0 K))) ≫ iΩ.inv := hψπ3 1
  have hψ32 : ψ₃ ≫ (Limits.WidePullback.π (fun _ : Fin 3 => p) 2).left =
      Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc1 K))) ≫ iΩ.inv := hψπ3 2
  have hhi3 : φ₃ ≫ ψ₃ = 𝟙 _ := by
    obtain ⟨_, _, hu⟩ := T1 3 _ (Limits.WidePullback.base (fun _ : Fin 3 => p)).left
      (fun l => (Limits.WidePullback.π (fun _ : Fin 3 => p) l).left) (hπ 3)
    refine (hu _ ⟨?_, ?_⟩).trans (hu _ ⟨fun l => Category.id_comp _, Category.id_comp _⟩).symm
    · intro l
      rw [Category.assoc, hψπ3 l, ← Category.assoc, hφc3 l, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    · rw [Category.assoc, hψb3, ← Category.assoc, hφ30, Category.assoc, hp3, hπ]
  have hih3 : ψ₃ ≫ φ₃ = 𝟙 _ := by
    obtain ⟨_, _, hu⟩ := T3 _ (Spec.map (CommRingCat.ofHom (wcFpeInc30 K)))
      (Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc0 K))))
      (Spec.map (CommRingCat.ofHom ((wcFpeIncR3 K).comp (wcFpeInc1 K)))) hc31 hc32
    refine (hu _ ⟨?_, ?_, ?_⟩).trans
      (hu _ ⟨Category.id_comp _, Category.id_comp _, Category.id_comp _⟩).symm
    · rw [Category.assoc, hφ30, ← Category.assoc, hψ30, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
    · rw [Category.assoc, hφ31, ← Category.assoc, hψ31, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
    · rw [Category.assoc, hφ32, ← Category.assoc, hψ32, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
  exact ⟨⟨φ₂, ψ₂, hhi2, hih2⟩, ⟨φ₃, ψ₃, hhi3, hih3⟩, hφ0, hφ1, hφ30, hφ31, hφ32⟩

theorem wc_fpe_nerve_points (S : Scheme.{u}) (U : S.ProEt) (a : U ⟶ U) (K : Type u) [Field K]
    (iK : U.left ≅ Spec (CommRingCat.of K)) (ρK : K ≃+* K)
    (hρ : iK.inv ≫ a.left ≫ iK.hom = Spec.map (CommRingCat.ofHom (ρK : K →+* K))) :
    ∃ (Ω : S.ProEt) (p : Ω ⟶ U) (ρL : SeparableClosure K ≃+* SeparableClosure K) (b : Ω ⟶ Ω)
      (b₂ : wcFpeNerve S U Ω p 2 ⟶ wcFpeNerve S U Ω p 2)
      (h₂ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) ≃ₜ ↥(wcFpeNerve S U Ω p 2).left),
      Projective (wcFreeSheaf S Ω) ∧
      Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S U ∧
      Subsingleton ↥Ω.left ∧
      (∀ x : K, ρL (algebraMap K (SeparableClosure K) x) =
        algebraMap K (SeparableClosure K) (ρK x)) ∧
      b ≫ p = p ≫ a ∧
      (∀ l : Fin 2, b₂ ≫ Limits.WidePullback.π (fun _ : Fin 2 => p) l =
        Limits.WidePullback.π (fun _ : Fin 2 => p) l ≫ b) ∧
      b₂ ≫ Limits.WidePullback.base (fun _ : Fin 2 => p) =
        Limits.WidePullback.base (fun _ : Fin 2 => p) ≫ a ∧
      (∀ g g' : SeparableClosure K ≃ₐ[K] SeparableClosure K, (∀ z, ρL (g' z) = g (ρL z)) →
        b₂.left (h₂ g) = h₂ g') ∧
      (∀ v : ↥(wcFpeNerve S U Ω p 3).left, ∃ g h : SeparableClosure K ≃ₐ[K] SeparableClosure K,
        (wcFpeFace S U Ω p 0).left v = h₂ (g⁻¹ * h) ∧ (wcFpeFace S U Ω p 1).left v = h₂ h ∧
        (wcFpeFace S U Ω p 2).left v = h₂ g) ∧
      (∀ g h : SeparableClosure K ≃ₐ[K] SeparableClosure K, ∃ v : ↥(wcFpeNerve S U Ω p 3).left,
        (wcFpeFace S U Ω p 0).left v = h₂ (g⁻¹ * h) ∧ (wcFpeFace S U Ω p 1).left v = h₂ h ∧
        (wcFpeFace S U Ω p 2).left v = h₂ g) :=
by
  classical
  have hspec : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B) (g : B →+* C),
      Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom (g.comp f)) := by
    intro A B C _ _ _ f g
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  have hofHom_inj : ∀ {A B : Type u} [CommRing A] [CommRing B] (f g : A →+* B),
      Spec.map (CommRingCat.ofHom f) = Spec.map (CommRingCat.ofHom g) → f = g := by
    intro A B _ _ f g h
    exact congrArg CommRingCat.Hom.hom (Spec.map_injective h)
  have hcl : ∀ {X Y Z : S.ProEt} (f : X ⟶ Y) (g : Y ⟶ Z), (f ≫ g).left = f.left ≫ g.left :=
    fun _ _ => rfl

  have hR2 : ∀ (f₁ f₂ : wcFpeT2 K →+* SeparableClosure K),
      f₁.comp (wcFpeInc0 K) = f₂.comp (wcFpeInc0 K) →
      f₁.comp (wcFpeInc1 K) = f₂.comp (wcFpeInc1 K) → f₁ = f₂ := by
    intro f₁ f₂ h1 h2
    refine RingHom.ext fun t => ?_
    refine TensorProduct.induction_on (R := K) (M := SeparableClosure K) (N := SeparableClosure K)
      (motive := fun t : TensorProduct K (SeparableClosure K) (SeparableClosure K) => f₁ t = f₂ t)
      t ?_ ?_ ?_
    · exact (map_zero f₁).trans (map_zero f₂).symm
    · intro x y
      have e : (x ⊗ₜ[K] y : wcFpeT2 K) = wcFpeInc0 K x * wcFpeInc1 K y := by
        show x ⊗ₜ[K] y = (x ⊗ₜ[K] (1 : SeparableClosure K)) * ((1 : SeparableClosure K) ⊗ₜ[K] y)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      show f₁ (x ⊗ₜ[K] y : wcFpeT2 K) = f₂ (x ⊗ₜ[K] y : wcFpeT2 K)
      rw [e, map_mul, map_mul]
      exact congrArg₂ (· * ·) (RingHom.congr_fun h1 x) (RingHom.congr_fun h2 y)
    · intro x y hx hy
      exact (map_add f₁ x y).trans ((congrArg₂ (· + ·) hx hy).trans (map_add f₂ x y).symm)
  have hR3 : ∀ (f₁ f₂ : wcFpeT3 K →+* SeparableClosure K),
      f₁.comp (wcFpeInc30 K) = f₂.comp (wcFpeInc30 K) →
      f₁.comp (wcFpeIncR3 K) = f₂.comp (wcFpeIncR3 K) → f₁ = f₂ := by
    intro f₁ f₂ h1 h2
    refine RingHom.ext fun t => ?_
    refine TensorProduct.induction_on (R := K) (M := SeparableClosure K) (N := wcFpeT2 K)
      (motive := fun t : TensorProduct K (SeparableClosure K) (wcFpeT2 K) => f₁ t = f₂ t)
      t ?_ ?_ ?_
    · exact (map_zero f₁).trans (map_zero f₂).symm
    · intro x y
      have e : (x ⊗ₜ[K] y : wcFpeT3 K) = wcFpeInc30 K x * wcFpeIncR3 K y := by
        show x ⊗ₜ[K] y = (x ⊗ₜ[K] (1 : wcFpeT2 K)) * ((1 : SeparableClosure K) ⊗ₜ[K] y)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      show f₁ (x ⊗ₜ[K] y : wcFpeT3 K) = f₂ (x ⊗ₜ[K] y : wcFpeT3 K)
      rw [e, map_mul, map_mul]
      exact congrArg₂ (· * ·) (RingHom.congr_fun h1 x) (RingHom.congr_fun h2 y)
    · intro x y hx hy
      exact (map_add f₁ x y).trans ((congrArg₂ (· + ·) hx hy).trans (map_add f₂ x y).symm)
  have hSpecExt2 : ∀ (f : Spec (CommRingCat.of (SeparableClosure K)) ⟶ Spec (CommRingCat.of (wcFpeT2 K)))
      (μ : wcFpeT2 K →+* SeparableClosure K),
      f ≫ Spec.map (CommRingCat.ofHom (wcFpeInc0 K)) =
        Spec.map (CommRingCat.ofHom (μ.comp (wcFpeInc0 K))) →
      f ≫ Spec.map (CommRingCat.ofHom (wcFpeInc1 K)) =
        Spec.map (CommRingCat.ofHom (μ.comp (wcFpeInc1 K))) →
      f = Spec.map (CommRingCat.ofHom μ) := by
    intro f μ h0 h1
    obtain ⟨ψ, rfl⟩ : ∃ ψ : wcFpeT2 K →+* SeparableClosure K, f = Spec.map (CommRingCat.ofHom ψ) :=
      ⟨(Spec.preimage f).hom, (Spec.map_preimage f).symm⟩
    rw [hspec] at h0 h1
    rw [hR2 ψ μ (hofHom_inj _ _ h0) (hofHom_inj _ _ h1)]
  have hSpecExt3 : ∀ (f : Spec (CommRingCat.of (SeparableClosure K)) ⟶ Spec (CommRingCat.of (wcFpeT3 K)))
      (μ : wcFpeT3 K →+* SeparableClosure K),
      f ≫ Spec.map (CommRingCat.ofHom (wcFpeInc30 K)) =
        Spec.map (CommRingCat.ofHom (μ.comp (wcFpeInc30 K))) →
      f ≫ Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)) =
        Spec.map (CommRingCat.ofHom (μ.comp (wcFpeIncR3 K))) →
      f = Spec.map (CommRingCat.ofHom μ) := by
    intro f μ h0 h1
    obtain ⟨ψ, rfl⟩ : ∃ ψ : wcFpeT3 K →+* SeparableClosure K, f = Spec.map (CommRingCat.ofHom ψ) :=
      ⟨(Spec.preimage f).hom, (Spec.map_preimage f).symm⟩
    rw [hspec] at h0 h1
    rw [hR3 ψ μ (hofHom_inj _ _ h0) (hofHom_inj _ _ h1)]
  have hbot : ∀ x : PrimeSpectrum (SeparableClosure K), x.asIdeal = ⊥ := fun x =>
    (Ideal.eq_bot_or_top _).resolve_right x.isPrime.ne_top

  let φ : Spec (CommRingCat.of (SeparableClosure K)) ⟶ Spec (CommRingCat.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))
  have hφW : WeaklyEtale φ := wc_fpe_sepClosure_weaklyEtale K
  have hiso : WeaklyEtale iK.inv := etale_le_weaklyEtale _ _ _ (inferInstance : Etale iK.inv)
  have hpW : WeaklyEtale (φ ≫ iK.inv) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ φ iK.inv hφW hiso
  have hW : WeaklyEtale ((φ ≫ iK.inv) ≫ U.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U.hom hpW U.prop
  let Ω : S.ProEt := MorphismProperty.Over.mk ⊤ ((φ ≫ iK.inv) ≫ U.hom) hW
  let p : Ω ⟶ U := MorphismProperty.Over.homMk (φ ≫ iK.inv) rfl trivial
  haveI hsub : Subsingleton ↥Ω.left :=
    inferInstanceAs (Subsingleton (PrimeSpectrum (SeparableClosure K)))
  let pt : ↥Ω.left := (IsLocalRing.closedPoint (SeparableClosure K) : PrimeSpectrum (SeparableClosure K))

  haveI : Surjective φ := by
    constructor
    intro y
    exact ⟨pt, Subsingleton.elim (α := PrimeSpectrum K) _ _⟩
  haveI : Surjective (φ ≫ iK.inv) := inferInstance
  haveI : QuasiCompact φ := by
    show QuasiCompact (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))))
    infer_instance
  haveI : QuasiCompact (φ ≫ iK.inv) := inferInstance
  have hcov : Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S U := by
    apply Precoverage.generate_mem_toGrothendieck
    change Presieve.singleton p ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
      Scheme.proetalePrecoverage).coverings U
    rw [Precoverage.mem_comap_iff, Presieve.map_singleton]
    exact Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale) (f := φ ≫ iK.inv) hpW

  have hresb : Function.Bijective (IsLocalRing.residue (SeparableClosure K)) :=
    ⟨(IsLocalRing.residue (SeparableClosure K)).injective, IsLocalRing.residue_surjective⟩
  haveI : IsSepClosed (IsLocalRing.ResidueField (SeparableClosure K)) :=
    wc_henselian_sepClosed_transfer.2 _ _ (RingEquiv.ofBijective _ hresb) inferInstance
  have hproj : Projective (wcFreeSheaf S Ω) :=
    wc_proet_free_projective_strict_local S Ω (SeparableClosure K) (Iso.refl _)

  obtain ⟨ρL, hρL⟩ := wc_fpe_sepClosure_extend K ρK
  have hρφ : Spec.map (CommRingCat.ofHom (ρL : SeparableClosure K →+* SeparableClosure K)) ≫ φ =
      φ ≫ iK.inv ≫ a.left ≫ iK.hom := by
    rw [hρ]
    dsimp only [φ]
    rw [hspec, hspec]
    exact congrArg (fun f => Spec.map (CommRingCat.ofHom f)) (RingHom.ext fun x => hρL x)
  have hpa : Spec.map (CommRingCat.ofHom (ρL : SeparableClosure K →+* SeparableClosure K)) ≫
      φ ≫ iK.inv = (φ ≫ iK.inv) ≫ a.left := by
    rw [← Category.assoc, hρφ]
    simp
  have hbw : Spec.map (CommRingCat.ofHom (ρL : SeparableClosure K →+* SeparableClosure K)) ≫
      Ω.hom = Ω.hom := by
    show _ ≫ (φ ≫ iK.inv) ≫ U.hom = (φ ≫ iK.inv) ≫ U.hom
    rw [← Category.assoc, hpa, Category.assoc, MorphismProperty.Over.w a]
  let b : Ω ⟶ Ω := MorphismProperty.Over.homMk
    (Spec.map (CommRingCat.ofHom (ρL : SeparableClosure K →+* SeparableClosure K))) hbw trivial
  have hbp : b ≫ p = p ≫ a := by
    apply MorphismProperty.Over.Hom.ext
    exact hpa

  have hgφ : ∀ g : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      Spec.map (CommRingCat.ofHom (g : SeparableClosure K →+* SeparableClosure K)) ≫ φ = φ := by
    intro g
    dsimp only [φ]
    rw [hspec]
    exact congrArg (fun f => Spec.map (CommRingCat.ofHom f)) (RingHom.ext fun x => g.commutes x)
  let e : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Ω ⟶ Ω) := fun g =>
    MorphismProperty.Over.homMk
      (Spec.map (CommRingCat.ofHom (g : SeparableClosure K →+* SeparableClosure K)))
      (by
        show _ ≫ (φ ≫ iK.inv) ≫ U.hom = (φ ≫ iK.inv) ≫ U.hom
        rw [← Category.assoc, ← Category.assoc, hgφ]) trivial
  have hep : ∀ g, e g ≫ p = p := by
    intro g
    apply MorphismProperty.Over.Hom.ext
    show Spec.map (CommRingCat.ofHom (g : SeparableClosure K →+* SeparableClosure K)) ≫ φ ≫ iK.inv =
      φ ≫ iK.inv
    rw [← Category.assoc, hgφ]
  have hemul : ∀ g k, e g ≫ e k = e (g * k) := by
    intro g k
    apply MorphismProperty.Over.Hom.ext
    show Spec.map (CommRingCat.ofHom (g : SeparableClosure K →+* SeparableClosure K)) ≫
        Spec.map (CommRingCat.ofHom (k : SeparableClosure K →+* SeparableClosure K)) =
      Spec.map (CommRingCat.ofHom
        ((g * k : SeparableClosure K ≃ₐ[K] SeparableClosure K) : SeparableClosure K →+* SeparableClosure K))
    rw [hspec]
    exact congrArg (fun f => Spec.map (CommRingCat.ofHom f)) (RingHom.ext fun x => rfl)

  let Y2 : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Ω ⟶ wcFpeNerve S U Ω p 2) := fun g =>
    Limits.WidePullback.lift p ![𝟙 Ω, e g] (by
      intro l
      fin_cases l
      exacts [Category.id_comp p, hep g])
  let Y3 : (SeparableClosure K ≃ₐ[K] SeparableClosure K) →
      (SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Ω ⟶ wcFpeNerve S U Ω p 3) := fun g h =>
    Limits.WidePullback.lift p ![𝟙 Ω, e g, e h] (by
      intro l
      fin_cases l
      exacts [Category.id_comp p, hep g, hep h])
  have hY2π : ∀ g (l : Fin 2), Y2 g ≫ Limits.WidePullback.π (fun _ : Fin 2 => p) l =
      ![𝟙 Ω, e g] l := fun g l => Limits.WidePullback.lift_π _ _ _ _ _
  have hY2base : ∀ g, Y2 g ≫ Limits.WidePullback.base (fun _ : Fin 2 => p) = p :=
    fun g => Limits.WidePullback.lift_base _ _ _ _
  have hY3π : ∀ g h (l : Fin 3), Y3 g h ≫ Limits.WidePullback.π (fun _ : Fin 3 => p) l =
      ![𝟙 Ω, e g, e h] l := fun g h l => Limits.WidePullback.lift_π _ _ _ _ _
  have hY3base : ∀ g h, Y3 g h ≫ Limits.WidePullback.base (fun _ : Fin 3 => p) = p :=
    fun g h => Limits.WidePullback.lift_base _ _ _ _
  let b₂ : wcFpeNerve S U Ω p 2 ⟶ wcFpeNerve S U Ω p 2 :=
    Limits.WidePullback.lift (Limits.WidePullback.base (fun _ : Fin 2 => p) ≫ a)
      (fun l => Limits.WidePullback.π (fun _ : Fin 2 => p) l ≫ b) (by
        intro l
        rw [Category.assoc, hbp, ← Category.assoc]
        exact congrArg (· ≫ a) (Limits.WidePullback.π_arrow (fun _ : Fin 2 => p) l))
  have hb₂π : ∀ l : Fin 2, b₂ ≫ Limits.WidePullback.π (fun _ : Fin 2 => p) l =
      Limits.WidePullback.π (fun _ : Fin 2 => p) l ≫ b :=
    fun l => Limits.WidePullback.lift_π _ _ _ _ _
  have hb₂base : b₂ ≫ Limits.WidePullback.base (fun _ : Fin 2 => p) =
      Limits.WidePullback.base (fun _ : Fin 2 => p) ≫ a := Limits.WidePullback.lift_base _ _ _ _

  obtain ⟨κ₂, κ₃, hκ0, hκ1, hκ30, hκ31, hκ32⟩ :=
    wc_fpe_nerve_tensor_model S U Ω p K iK (Iso.refl (Spec (CommRingCat.of (SeparableClosure K))))
      (by
        show 𝟙 _ ≫ (φ ≫ iK.inv) ≫ iK.hom = φ
        simp)
  have hμ2l : ∀ g, (wcFpeMu2 K g).comp (wcFpeInc0 K) = RingHom.id _ := fun g =>
    RingHom.ext fun x => by
      show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
        (g : SeparableClosure K →ₐ[K] SeparableClosure K) (x ⊗ₜ[K] (1 : SeparableClosure K)) = x
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
  have hμ2r : ∀ g, (wcFpeMu2 K g).comp (wcFpeInc1 K) =
      (g : SeparableClosure K →+* SeparableClosure K) := fun g =>
    RingHom.ext fun x => by
      show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
        (g : SeparableClosure K →ₐ[K] SeparableClosure K) ((1 : SeparableClosure K) ⊗ₜ[K] x) = g x
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
      rfl
  have hμ3l : ∀ g h, (wcFpeMu3 K g h).comp (wcFpeInc30 K) = RingHom.id _ := fun g h =>
    RingHom.ext fun x => by
      have hx := Algebra.TensorProduct.productMap_apply_tmul (AlgHom.id K (SeparableClosure K))
        (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
          (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
        x (1 : wcFpeT2 K)
      have h1 : (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
          (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
          (1 : wcFpeT2 K) = 1 := map_one _
      exact hx.trans ((congrArg (fun y => (AlgHom.id K (SeparableClosure K)) x * y) h1).trans
        (mul_one _))
  have hμ3rl : ∀ g h, ((wcFpeMu3 K g h).comp (wcFpeIncR3 K)).comp (wcFpeInc0 K) =
      (g : SeparableClosure K →+* SeparableClosure K) := fun g h =>
    RingHom.ext fun x => by
      show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
        (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
          (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
        ((1 : SeparableClosure K) ⊗ₜ[K]
          ((x ⊗ₜ[K] (1 : SeparableClosure K) : TensorProduct K (SeparableClosure K) (SeparableClosure K)) :
            wcFpeT2 K)) = g x
      rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.productMap_apply_tmul,
        map_one, map_one, one_mul, mul_one]
      rfl
  have hμ3rr : ∀ g h, ((wcFpeMu3 K g h).comp (wcFpeIncR3 K)).comp (wcFpeInc1 K) =
      (h : SeparableClosure K →+* SeparableClosure K) := fun g h =>
    RingHom.ext fun x => by
      show Algebra.TensorProduct.productMap (AlgHom.id K (SeparableClosure K))
        (Algebra.TensorProduct.productMap (g : SeparableClosure K →ₐ[K] SeparableClosure K)
          (h : SeparableClosure K →ₐ[K] SeparableClosure K) : wcFpeT2 K →ₐ[K] SeparableClosure K)
        ((1 : SeparableClosure K) ⊗ₜ[K]
          (((1 : SeparableClosure K) ⊗ₜ[K] x : TensorProduct K (SeparableClosure K) (SeparableClosure K)) :
            wcFpeT2 K)) = h x
      rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.productMap_apply_tmul,
        map_one, map_one, one_mul, one_mul]
      rfl
  have key : ∀ {X Y Z W : Scheme.{u}} (y : X ⟶ Y) (k : Y ⟶ Z) (s : Z ⟶ W) (t : Y ⟶ W) (m : X ⟶ W),
      k ≫ s = t → y ≫ t = m → (y ≫ k) ≫ s = m := by
    intro X Y Z W y k s t m h1 h2
    rw [Category.assoc, h1, h2]
  have key4 : ∀ {X Y Z V W : Scheme.{u}} (y : X ⟶ Y) (k : Y ⟶ Z) (c : Z ⟶ V) (s : V ⟶ W)
      (t : Y ⟶ W) (m : X ⟶ W), k ≫ c ≫ s = t → y ≫ t = m → ((y ≫ k) ≫ c) ≫ s = m := by
    intro X Y Z V W y k c s t m h1 h2
    rw [Category.assoc, Category.assoc, h1, h2]
  have hY2 : ∀ g, (Y2 g).left ≫ κ₂.hom = Spec.map (CommRingCat.ofHom (wcFpeMu2 K g)) := by
    intro g
    refine hSpecExt2 ((Y2 g).left ≫ κ₂.hom) (wcFpeMu2 K g) ?_ ?_
    · have h1 : (Y2 g ≫ Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left = (𝟙 Ω : Ω ⟶ Ω).left :=
        congrArg (fun f : Ω ⟶ Ω => f.left) (hY2π g 0)
      have r : Spec.map (CommRingCat.ofHom ((wcFpeMu2 K g).comp (wcFpeInc0 K))) = 𝟙 _ := by
        rw [hμ2l, CommRingCat.ofHom_id, Spec.map_id]
      exact key _ _ _ _ _ (hκ0.trans (Category.comp_id _)) (h1.trans r.symm)
    · have h1 : (Y2 g ≫ Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left = (e g).left :=
        congrArg (fun f : Ω ⟶ Ω => f.left) (hY2π g 1)
      have r : Spec.map (CommRingCat.ofHom ((wcFpeMu2 K g).comp (wcFpeInc1 K))) =
          Spec.map (CommRingCat.ofHom (g : SeparableClosure K →+* SeparableClosure K)) := by
        rw [hμ2r]
      exact key _ _ _ _ _ (hκ1.trans (Category.comp_id _)) (h1.trans r.symm)
  have hY3 : ∀ g h, (Y3 g h).left ≫ κ₃.hom = Spec.map (CommRingCat.ofHom (wcFpeMu3 K g h)) := by
    intro g h
    refine hSpecExt3 ((Y3 g h).left ≫ κ₃.hom) (wcFpeMu3 K g h) ?_ ?_
    · have h1 : (Y3 g h ≫ Limits.WidePullback.π (fun _ : Fin 3 => p) 0).left = (𝟙 Ω : Ω ⟶ Ω).left :=
        congrArg (fun f : Ω ⟶ Ω => f.left) (hY3π g h 0)
      have r : Spec.map (CommRingCat.ofHom ((wcFpeMu3 K g h).comp (wcFpeInc30 K))) = 𝟙 _ := by
        rw [hμ3l, CommRingCat.ofHom_id, Spec.map_id]
      exact key _ _ _ _ _ (hκ30.trans (Category.comp_id _)) (h1.trans r.symm)
    · refine hSpecExt2 (((Y3 g h).left ≫ κ₃.hom) ≫ Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)))
        ((wcFpeMu3 K g h).comp (wcFpeIncR3 K)) ?_ ?_
      · have h1 : (Y3 g h ≫ Limits.WidePullback.π (fun _ : Fin 3 => p) 1).left = (e g).left :=
          congrArg (fun f : Ω ⟶ Ω => f.left) (hY3π g h 1)
        have r : Spec.map (CommRingCat.ofHom (((wcFpeMu3 K g h).comp (wcFpeIncR3 K)).comp (wcFpeInc0 K))) =
            Spec.map (CommRingCat.ofHom (g : SeparableClosure K →+* SeparableClosure K)) := by
          rw [hμ3rl]
        have hk : κ₃.hom ≫ (Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)) ≫
            Spec.map (CommRingCat.ofHom (wcFpeInc0 K))) =
            (Limits.WidePullback.π (fun _ : Fin 3 => p) 1).left :=
          (congrArg (κ₃.hom ≫ ·) (hspec (wcFpeInc0 K) (wcFpeIncR3 K))).trans
            (hκ31.trans (Category.comp_id _))
        exact key4 _ _ _ _ _ _ hk (h1.trans r.symm)
      · have h1 : (Y3 g h ≫ Limits.WidePullback.π (fun _ : Fin 3 => p) 2).left = (e h).left :=
          congrArg (fun f : Ω ⟶ Ω => f.left) (hY3π g h 2)
        have r : Spec.map (CommRingCat.ofHom (((wcFpeMu3 K g h).comp (wcFpeIncR3 K)).comp (wcFpeInc1 K))) =
            Spec.map (CommRingCat.ofHom (h : SeparableClosure K →+* SeparableClosure K)) := by
          rw [hμ3rr]
        have hk : κ₃.hom ≫ (Spec.map (CommRingCat.ofHom (wcFpeIncR3 K)) ≫
            Spec.map (CommRingCat.ofHom (wcFpeInc1 K))) =
            (Limits.WidePullback.π (fun _ : Fin 3 => p) 2).left :=
          (congrArg (κ₃.hom ≫ ·) (hspec (wcFpeInc1 K) (wcFpeIncR3 K))).trans
            (hκ32.trans (Category.comp_id _))
        exact key4 _ _ _ _ _ _ hk (h1.trans r.symm)

  obtain ⟨e4, he4⟩ := wc_fpe_tensor_galois_homeo K
  let h₂ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) ≃ₜ ↥(wcFpeNerve S U Ω p 2).left :=
    e4.trans (Scheme.homeoOfIso κ₂.symm)
  have hP2 : ∀ g, κ₂.hom ((Y2 g).left pt) = e4 g := by
    intro g
    apply PrimeSpectrum.ext
    rw [he4 g, ← Scheme.Hom.comp_apply (Y2 g).left κ₂.hom pt, hY2 g]
    exact (congrArg (Ideal.comap (wcFpeMu2 K g)) (hbot pt)).trans (RingHom.ker_eq_comap_bot _).symm
  have hH2 : ∀ g, h₂ g = (Y2 g).left pt := by
    intro g
    show κ₂.inv (e4 g) = _
    rw [← hP2 g, ← Scheme.Hom.comp_apply κ₂.hom κ₂.inv, Iso.hom_inv_id]
    rfl

  have hYb : ∀ g g' : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      (∀ z, ρL (g' z) = g (ρL z)) → Y2 g ≫ b₂ = b ≫ Y2 g' := by
    intro g g' hgg
    apply Limits.WidePullback.hom_ext
    · intro l
      rw [Category.assoc, hb₂π, ← Category.assoc, hY2π, Category.assoc, hY2π]
      fin_cases l
      · show 𝟙 Ω ≫ b = b ≫ 𝟙 Ω
        rw [Category.id_comp, Category.comp_id]
      · show e g ≫ b = b ≫ e g'
        apply MorphismProperty.Over.Hom.ext
        show Spec.map (CommRingCat.ofHom (g : SeparableClosure K →+* SeparableClosure K)) ≫
            Spec.map (CommRingCat.ofHom (ρL : SeparableClosure K →+* SeparableClosure K)) =
          Spec.map (CommRingCat.ofHom (ρL : SeparableClosure K →+* SeparableClosure K)) ≫
            Spec.map (CommRingCat.ofHom (g' : SeparableClosure K →+* SeparableClosure K))
        rw [hspec, hspec]
        exact congrArg (fun f => Spec.map (CommRingCat.ofHom f))
          (RingHom.ext fun z => (hgg z).symm)
    · rw [Category.assoc, Category.assoc, hb₂base, hY2base, ← Category.assoc, hY2base]
      exact hbp.symm
  have hb₂pt : ∀ g g' : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      (∀ z, ρL (g' z) = g (ρL z)) → b₂.left (h₂ g) = h₂ g' := by
    intro g g' hgg
    rw [hH2, hH2, ← Scheme.Hom.comp_apply (Y2 g).left b₂.left pt, ← hcl (Y2 g) b₂, hYb g g' hgg,
      hcl b (Y2 g'), Scheme.Hom.comp_apply]
    congr 1
    exact Subsingleton.elim _ _

  have hdπ : ∀ (j : Fin 3) (l : Fin 2), wcFpeFace S U Ω p j ≫
      Limits.WidePullback.π (fun _ : Fin 2 => p) l =
      Limits.WidePullback.π (fun _ : Fin 3 => p) (j.succAbove l) := by
    intro j l
    unfold wcFpeFace wcCechFace
    exact Limits.WidePullback.lift_π _ _ _ _ _
  have hdbase : ∀ j : Fin 3, wcFpeFace S U Ω p j ≫ Limits.WidePullback.base (fun _ : Fin 2 => p) =
      Limits.WidePullback.base (fun _ : Fin 3 => p) := by
    intro j
    unfold wcFpeFace wcCechFace
    exact Limits.WidePullback.lift_base _ _ _ _
  have hF2 : ∀ g h, Y3 g h ≫ wcFpeFace S U Ω p 2 = Y2 g := by
    intro g h
    apply Limits.WidePullback.hom_ext
    · intro l
      rw [Category.assoc, hdπ, hY3π, hY2π]
      fin_cases l
      exacts [rfl, rfl]
    · rw [Category.assoc, hdbase, hY3base, hY2base]
  have hF1 : ∀ g h, Y3 g h ≫ wcFpeFace S U Ω p 1 = Y2 h := by
    intro g h
    apply Limits.WidePullback.hom_ext
    · intro l
      rw [Category.assoc, hdπ, hY3π, hY2π]
      fin_cases l
      exacts [rfl, rfl]
    · rw [Category.assoc, hdbase, hY3base, hY2base]
  have hF0 : ∀ g h, Y3 g h ≫ wcFpeFace S U Ω p 0 = e g ≫ Y2 (g⁻¹ * h) := by
    intro g h
    apply Limits.WidePullback.hom_ext
    · intro l
      rw [Category.assoc, hdπ, hY3π, Category.assoc, hY2π]
      fin_cases l
      · show e g = e g ≫ 𝟙 Ω
        rw [Category.comp_id]
      · show e h = e g ≫ e (g⁻¹ * h)
        rw [hemul, mul_inv_cancel_left]
    · rw [Category.assoc, Category.assoc, hdbase, hY3base, hY2base, hep]
  have hP3 : ∀ g h, PrimeSpectrum.asIdeal (κ₃.hom ((Y3 g h).left pt)) =
      RingHom.ker (wcFpeMu3 K g h) := by
    intro g h
    rw [← Scheme.Hom.comp_apply (Y3 g h).left κ₃.hom pt, hY3 g h]
    exact (congrArg (Ideal.comap (wcFpeMu3 K g h)) (hbot pt)).trans (RingHom.ker_eq_comap_bot _).symm
  have hv : ∀ v : ↥(wcFpeNerve S U Ω p 3).left, ∃ g h, v = (Y3 g h).left pt := by
    intro v
    obtain ⟨g, h, hgh⟩ := wc_fpe_tensor3_primes K (κ₃.hom v)
    refine ⟨g, h, ?_⟩
    have h1 : κ₃.hom v = κ₃.hom ((Y3 g h).left pt) := PrimeSpectrum.ext (hgh.trans (hP3 g h).symm)
    have h2 := congrArg κ₃.inv h1
    rw [← Scheme.Hom.comp_apply κ₃.hom κ₃.inv v, ← Scheme.Hom.comp_apply κ₃.hom κ₃.inv,
      Iso.hom_inv_id] at h2
    exact h2
  have hfacept : ∀ g h, (wcFpeFace S U Ω p 0).left ((Y3 g h).left pt) = h₂ (g⁻¹ * h) ∧
      (wcFpeFace S U Ω p 1).left ((Y3 g h).left pt) = h₂ h ∧
      (wcFpeFace S U Ω p 2).left ((Y3 g h).left pt) = h₂ g := by
    intro g h
    refine ⟨?_, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply (Y3 g h).left (wcFpeFace S U Ω p 0).left pt,
        ← hcl (Y3 g h) (wcFpeFace S U Ω p 0), hF0, hcl (e g) (Y2 (g⁻¹ * h)),
        Scheme.Hom.comp_apply, hH2]
      congr 1
      exact Subsingleton.elim _ _
    · rw [← Scheme.Hom.comp_apply (Y3 g h).left (wcFpeFace S U Ω p 1).left pt,
        ← hcl (Y3 g h) (wcFpeFace S U Ω p 1), hF1, hH2]
    · rw [← Scheme.Hom.comp_apply (Y3 g h).left (wcFpeFace S U Ω p 2).left pt,
        ← hcl (Y3 g h) (wcFpeFace S U Ω p 2), hF2, hH2]
  refine ⟨Ω, p, ρL, b, b₂, h₂, hproj, hcov, hsub, hρL, hbp, hb₂π, hb₂base, hb₂pt, ?_, ?_⟩
  · intro v
    obtain ⟨g, h, rfl⟩ := hv v
    exact ⟨g, h, hfacept g h⟩
  · intro g h
    exact ⟨_, hfacept g h⟩

theorem wc_fpe_singleton_cech : ∀ (S : Scheme.{u}) (U Ω : S.ProEt) (p : Ω ⟶ U), Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S U → (∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (x : F.obj.obj (Opposite.op Ω)), F.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op x = F.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op x → ∃ s : F.obj.obj (Opposite.op U), F.obj.map p.op s = x) ∧ (∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (s s' : F.obj.obj (Opposite.op U)), F.obj.map p.op s = F.obj.map p.op s' → s = s') ∧ (∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (t : F.obj.obj (Opposite.op Ω)), wcFpeCocycle S U Ω p F (F.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - F.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t)) ∧ (∀ (I : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) [Injective I] (y : I.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2))), wcFpeCocycle S U Ω p I y → ∃ t : I.obj.obj (Opposite.op Ω), y = I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t) :=
by
  intro S U Ω p hcov

  have mapc : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) {A B C : S.ProEt}
      (f : A ⟶ B) (g : B ⟶ C) (x : F.obj.obj (Opposite.op C)),
      F.obj.map (f ≫ g).op x = F.obj.map f.op (F.obj.map g.op x) := by
    intro F A B C f g x
    rw [op_comp, Functor.map_comp_apply]
  have mapid : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) {A : S.ProEt}
      (x : F.obj.obj (Opposite.op A)), F.obj.map (𝟙 A).op x = x := by
    intro F A x
    simp

  have s20 : (0 : Fin 2).succAbove (0 : Fin 1) = 1 := by decide
  have s21 : (1 : Fin 2).succAbove (0 : Fin 1) = 0 := by decide
  have s300 : (0 : Fin 3).succAbove (0 : Fin 2) = 1 := by decide
  have s301 : (0 : Fin 3).succAbove (1 : Fin 2) = 2 := by decide
  have s310 : (1 : Fin 3).succAbove (0 : Fin 2) = 0 := by decide
  have s311 : (1 : Fin 3).succAbove (1 : Fin 2) = 2 := by decide
  have s320 : (2 : Fin 3).succAbove (0 : Fin 2) = 0 := by decide
  have s321 : (2 : Fin 3).succAbove (1 : Fin 2) = 1 := by decide

  have hfπ : ∀ (j : Fin 3) (l : Fin 2), wcFpeFace S U Ω p j ≫
      Limits.WidePullback.π (fun _ : Fin 2 => p) l =
      Limits.WidePullback.π (fun _ : Fin 3 => p) (j.succAbove l) := by
    intro j l
    unfold wcFpeFace wcCechFace
    exact Limits.WidePullback.lift_π _ _ _ _ _
  have hD : ∀ (τ : Fin 2 → Fin 1) (j : Fin 2),
      wcCechFace (fun _ : Fin 1 => Ω) (fun _ => p) τ j ≫
        Limits.WidePullback.π (fun _ : Fin 1 => p) 0 =
      Limits.WidePullback.π (fun _ : Fin 2 => p) (j.succAbove 0) := by
    intro τ j
    unfold wcCechFace
    exact Limits.WidePullback.lift_π _ _ _ _ _
  have hbase : Limits.WidePullback.base (fun _ : Fin 1 => p) =
      Limits.WidePullback.π (fun _ : Fin 1 => p) 0 ≫ p :=
    (Limits.WidePullback.π_arrow _ 0).symm

  obtain ⟨j₀, hj1, hj2⟩ : ∃ j₀ : Ω ⟶ Limits.widePullback U (fun _ : Fin 1 => Ω) (fun _ => p),
      j₀ ≫ Limits.WidePullback.π (fun _ : Fin 1 => p) 0 = 𝟙 Ω ∧
      Limits.WidePullback.π (fun _ : Fin 1 => p) 0 ≫ j₀ = 𝟙 _ := by
    refine ⟨Limits.WidePullback.lift (arrows := fun _ : Fin 1 => p) p (fun _ => 𝟙 Ω)
      (fun _ => Category.id_comp p), Limits.WidePullback.lift_π _ _ _ _ _, ?_⟩
    apply Limits.WidePullback.hom_ext
    · intro i
      rw [Category.assoc, Limits.WidePullback.lift_π, Category.comp_id, Category.id_comp,
        Subsingleton.elim i 0]
    · rw [Category.assoc, Limits.WidePullback.lift_base, Category.id_comp]
      exact Limits.WidePullback.π_arrow _ 0
  have e0inj : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (a b : F.obj.obj (Opposite.op Ω)),
      F.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op a =
        F.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op b → a = b := by
    intro F a b h
    have h2 : F.obj.map j₀.op (F.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op a) =
        F.obj.map j₀.op (F.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op b) := by
      rw [h]
    rw [← mapc, ← mapc, hj1, mapid, mapid] at h2
    exact h2

  have hcov' : Sieve.generate (Presieve.ofArrows (fun _ : Fin 1 => Ω) (fun _ => p)) ∈
      Scheme.ProEt.topology S U := by
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨⟩
    exact ⟨Ω, 𝟙 Ω, p, Presieve.ofArrows.mk (0 : Fin 1), Category.id_comp p⟩

  have hc : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (t : F.obj.obj (Opposite.op Ω)), wcFpeCocycle S U Ω p F
        (F.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          F.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t) := by
    intro F t
    unfold wcFpeCocycle
    rw [map_sub, map_sub, map_sub, ← mapc, ← mapc, ← mapc, ← mapc, ← mapc, ← mapc,
      hfπ, hfπ, hfπ, hfπ, hfπ, hfπ, s300, s301, s310, s311, s320, s321]
    abel
  refine ⟨fun F x hx => ?_, fun F s s' hss' => ?_, hc, fun I _ y hy => ?_⟩
  ·
    obtain ⟨t, ht⟩ := (wc_proet_sheaf_cech_glue S F (fun _ : Fin 1 => Ω) (fun _ => p) hcov').1
      (fun _ => F.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op x) (by
        intro τ
        show ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) •
          F.obj.map (wcCechFace (fun _ : Fin 1 => Ω) (fun _ => p) τ j).op
            (F.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op x) = 0
        rw [Fin.sum_univ_two, ← mapc, ← mapc, hD, hD, s20, s21]
        simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul, neg_smul]
        rw [hx, add_neg_cancel])
    refine ⟨t, e0inj F _ _ ?_⟩
    have h1 : F.obj.map (Limits.WidePullback.base (fun _ : Fin 1 => p)).op t =
        F.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op x := ht (fun _ => 0)
    rw [hbase, mapc] at h1
    exact h1
  ·
    refine (wc_proet_sheaf_cech_glue S F (fun _ : Fin 1 => Ω) (fun _ => p) hcov').2 s s'
      (fun σ => ?_)
    show F.obj.map (Limits.WidePullback.base (fun _ : Fin 1 => p)).op s =
      F.obj.map (Limits.WidePullback.base (fun _ : Fin 1 => p)).op s'
    rw [hbase, mapc, mapc, hss']
  ·
    have hy' : I.obj.map (wcFpeFace S U Ω p 0).op y - I.obj.map (wcFpeFace S U Ω p 1).op y +
        I.obj.map (wcFpeFace S U Ω p 2).op y = 0 := hy
    obtain ⟨b, hb⟩ := (wc_injective_cech_acyclic (Scheme.ProEt.topology S) I
      (fun _ : Fin 1 => Ω) (fun _ => p)).2 0 (fun _ => y) (by
        intro ρ
        obtain rfl : ρ = fun _ => 0 := Subsingleton.elim _ _
        show ∑ j : Fin 3, ((-1 : ℤ) ^ (j : ℕ)) • I.obj.map (wcFpeFace S U Ω p j).op y = 0
        rw [Fin.sum_univ_three]
        simp only [Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one, neg_one_sq,
          one_smul, neg_smul]
        rw [← hy']
        abel)
    have h : ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) •
        I.obj.map (wcCechFace (fun _ : Fin 1 => Ω) (fun _ => p) (fun _ : Fin 2 => (0 : Fin 1)) j).op
          (b (fun _ => 0)) = y := hb (fun _ => 0)
    obtain ⟨t, ht⟩ : ∃ t : I.obj.obj (Opposite.op Ω), b (fun _ => 0) =
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 1 => p) 0).op t :=
      ⟨I.obj.map j₀.op (b (fun _ => 0)), by rw [← mapc, hj2, mapid]⟩
    rw [ht, Fin.sum_univ_two, ← mapc, ← mapc, hD, hD, s20, s21] at h
    simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul, neg_smul] at h
    exact ⟨t, by rw [← h, sub_eq_add_neg]⟩

theorem wc_fpe_ext1_boundary : ∀ (S : Scheme.{u}) (U : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), ∃ δ : (Limits.cokernel (Injective.ι G)).obj.obj (Opposite.op U) →+ Abelian.Ext (wcFreeSheaf S U) G 1, (∀ x, ∃ q, δ q = x) ∧ (∀ q, δ q = 0 ↔ ∃ s : (Injective.under G).obj.obj (Opposite.op U), (Limits.cokernel.π (Injective.ι G)).hom.app (Opposite.op U) s = q) ∧ (∀ σ : G ⟶ G, ∃ (σ₁ : Injective.under G ⟶ Injective.under G) (σ₂ : Limits.cokernel (Injective.ι G) ⟶ Limits.cokernel (Injective.ι G)), Injective.ι G ≫ σ₁ = σ ≫ Injective.ι G ∧ Limits.cokernel.π (Injective.ι G) ≫ σ₂ = σ₁ ≫ Limits.cokernel.π (Injective.ι G) ∧ ∀ q, δ (σ₂.hom.app (Opposite.op U) q) = (δ q).comp (Abelian.Ext.mk₀ σ) (add_zero 1)) ∧ (∀ (a : U ⟶ U) q, δ ((Limits.cokernel (Injective.ι G)).obj.map a.op q) = (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (δ q) (zero_add 1)) :=
by
  intro S U G
  classical
  obtain ⟨η, hη, hηc⟩ : ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
      (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (s : G.obj.obj (Opposite.op T)),
        ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
      ∀ (T T' : S.ProEt) (c : T' ⟶ T),
        ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
          ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
    let J := Scheme.ProEt.topology S
    let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
      fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
        (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
        (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
        e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
    refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
    · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
    · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
    · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let w : P' ⟶ P :=
        Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
      let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
      have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
            ((w.app (Opposite.op T')).hom x') :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
      have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans
          (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
        congr 1
      have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
        NatTrans.naturality_apply (toSheafify J P) c.op x
      change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
      rw [h1, h2, hn]

  obtain ⟨ev, hevF, heva⟩ : ∃ ev : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      (wcFreeSheaf S U ⟶ F) ≃+ F.obj.obj (Opposite.op U),
      (∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf S U ⟶ F), ev F' (g ≫ φ) = φ.hom.app (Opposite.op U) (ev F g)) ∧
      (∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (a : U ⟶ U)
        (g : wcFreeSheaf S U ⟶ F), ev F (wcFreeSheafMap S a ≫ g) = F.obj.map a.op (ev F g)) := by
    have evbij : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        Function.Bijective (fun g : wcFreeSheaf S U ⟶ F => (g.hom.app (Opposite.op U)).hom (η U)) := by
      intro F
      refine ⟨fun g g' h => (hη U F ((g.hom.app (Opposite.op U)).hom (η U))).unique rfl h.symm,
        fun s => ?_⟩
      obtain ⟨g, hg, -⟩ := hη U F s
      exact ⟨g, hg⟩
    have evadd : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (g g' : wcFreeSheaf S U ⟶ F),
        ((g + g').hom.app (Opposite.op U)).hom (η U) =
          (g.hom.app (Opposite.op U)).hom (η U) + (g'.hom.app (Opposite.op U)).hom (η U) := by
      intro F g g'
      rw [Sheaf.Hom.add_app]
      rfl
    refine ⟨fun F => AddEquiv.mk' (Equiv.ofBijective _ (evbij F)) (evadd F), ?_, ?_⟩
    · intro F F' φ g
      rfl
    · intro F a g
      show (g.hom.app (Opposite.op U)).hom
          (((wcFreeSheafMap S a).hom.app (Opposite.op U)).hom (η U)) =
        F.obj.map a.op ((g.hom.app (Opposite.op U)).hom (η U))
      rw [hηc U U a]
      exact NatTrans.naturality_apply g.hom a.op (η U)

  have hS : (ShortComplex.mk (Injective.ι G) (Limits.cokernel.π (Injective.ι G))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance

  have hsurj : ∀ x : Abelian.Ext (wcFreeSheaf S U) G 1,
      ∃ g : wcFreeSheaf S U ⟶ Limits.cokernel (Injective.ι G),
        (Abelian.Ext.mk₀ g).comp hS.extClass (zero_add 1) = x := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ (Injective.ι G)) (add_zero 1) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ :=
      Abelian.Ext.covariant_sequence_exact₁ (wcFreeSheaf S U) hS x h0 (n₀ := 0) rfl
    exact ⟨Abelian.Ext.homEquiv₀ x₃, by rw [Abelian.Ext.mk₀_homEquiv₀_apply]; exact hx₃⟩

  have hker : ∀ g : wcFreeSheaf S U ⟶ Limits.cokernel (Injective.ι G),
      (Abelian.Ext.mk₀ g).comp hS.extClass (zero_add 1) = 0 ↔
        ∃ h : wcFreeSheaf S U ⟶ Injective.under G,
          h ≫ Limits.cokernel.π (Injective.ι G) = g := by
    intro g
    constructor
    · intro h0
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ (wcFreeSheaf S U) hS
        (Abelian.Ext.mk₀ g) (zero_add 1) h0
      refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₂
    · rintro ⟨h, rfl⟩
      rw [← Abelian.Ext.mk₀_comp_mk₀_assoc]
      have h1 : (Abelian.Ext.mk₀ (Limits.cokernel.π (Injective.ι G))).comp hS.extClass
          (zero_add 1) = 0 := hS.comp_extClass
      rw [h1, Abelian.Ext.comp_zero]

  let δ : (Limits.cokernel (Injective.ι G)).obj.obj (Opposite.op U) →+
      Abelian.Ext (wcFreeSheaf S U) G 1 :=
    AddMonoidHom.mk'
      (fun q => (Abelian.Ext.mk₀ ((ev (Limits.cokernel (Injective.ι G))).symm q)).comp
        hS.extClass (zero_add 1))
      (fun q q' => by rw [map_add, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp])
  have hδ : ∀ q, δ q = (Abelian.Ext.mk₀ ((ev (Limits.cokernel (Injective.ι G))).symm q)).comp
      hS.extClass (zero_add 1) := fun q => rfl
  refine ⟨δ, ?_, ?_, ?_, ?_⟩
  ·
    intro x
    obtain ⟨g, hg⟩ := hsurj x
    refine ⟨ev _ g, ?_⟩
    rw [hδ, AddEquiv.symm_apply_apply]
    exact hg
  ·
    intro q
    rw [hδ, hker]
    constructor
    · rintro ⟨h, hh⟩
      refine ⟨ev _ h, ?_⟩
      rw [← hevF, hh, AddEquiv.apply_symm_apply]
    · rintro ⟨s, hs⟩
      refine ⟨(ev _).symm s, ?_⟩
      rw [AddEquiv.eq_symm_apply, hevF, AddEquiv.apply_symm_apply, hs]
  ·
    intro σ
    let σ₁ : Injective.under G ⟶ Injective.under G :=
      Injective.factorThru (σ ≫ Injective.ι G) (Injective.ι G)
    have e₁ : Injective.ι G ≫ σ₁ = σ ≫ Injective.ι G := Injective.comp_factorThru _ _
    have hw : Injective.ι G ≫ σ₁ ≫ Limits.cokernel.π (Injective.ι G) = 0 := by
      rw [← Category.assoc, e₁, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let σ₂ : Limits.cokernel (Injective.ι G) ⟶ Limits.cokernel (Injective.ι G) :=
      Limits.cokernel.desc (Injective.ι G) (σ₁ ≫ Limits.cokernel.π (Injective.ι G)) hw
    have e₂ : Limits.cokernel.π (Injective.ι G) ≫ σ₂ = σ₁ ≫ Limits.cokernel.π (Injective.ι G) :=
      Limits.cokernel.π_desc _ _ _
    let fS : ShortComplex.mk (Injective.ι G) (Limits.cokernel.π (Injective.ι G))
          (Limits.cokernel.condition _) ⟶
        ShortComplex.mk (Injective.ι G) (Limits.cokernel.π (Injective.ι G))
          (Limits.cokernel.condition _) :=
      ShortComplex.Hom.mk σ σ₁ σ₂ e₁.symm e₂.symm
    have hnat' : (Abelian.Ext.mk₀ σ₂).comp hS.extClass (zero_add 1) =
        hS.extClass.comp (Abelian.Ext.mk₀ σ) (add_zero 1) :=
      (hS.extClass_naturality hS fS).symm
    refine ⟨σ₁, σ₂, e₁, e₂, fun q => ?_⟩
    have hT2 : (ev (Limits.cokernel (Injective.ι G))).symm (σ₂.hom.app (Opposite.op U) q) =
        (ev (Limits.cokernel (Injective.ι G))).symm q ≫ σ₂ := by
      rw [AddEquiv.symm_apply_eq, hevF, AddEquiv.apply_symm_apply]
    rw [hδ, hδ, hT2, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hnat']
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  ·
    intro a q
    have hT3 : (ev (Limits.cokernel (Injective.ι G))).symm
        ((Limits.cokernel (Injective.ι G)).obj.map a.op q) =
        wcFreeSheafMap S a ≫ (ev (Limits.cokernel (Injective.ι G))).symm q := by
      rw [AddEquiv.symm_apply_eq, heva, AddEquiv.apply_symm_apply]
    rw [hδ, hδ, hT3, ← Abelian.Ext.mk₀_comp_mk₀_assoc]

theorem wc_fpe_cech_connecting : ∀ (S : Scheme.{u}) (U Ω : S.ProEt) (p : Ω ⟶ U) {G I Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (ι : G ⟶ I) (π : I ⟶ Q) {E : Type*} [AddCommGroup E] (δ : Q.obj.obj (Opposite.op U) →+ E), (∀ (W : S.ProEt) (x : G.obj.obj (Opposite.op W)), ι.hom.app (Opposite.op W) x = 0 → x = 0) → (∀ (W : S.ProEt) (y : I.obj.obj (Opposite.op W)), π.hom.app (Opposite.op W) y = 0 → ∃ x, ι.hom.app (Opposite.op W) x = y) → (∀ (W : S.ProEt) (x : G.obj.obj (Opposite.op W)), π.hom.app (Opposite.op W) (ι.hom.app (Opposite.op W) x) = 0) → (∀ q : Q.obj.obj (Opposite.op Ω), ∃ t, π.hom.app (Opposite.op Ω) t = q) → (∀ x : I.obj.obj (Opposite.op Ω), I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op x = I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op x → ∃ s : I.obj.obj (Opposite.op U), I.obj.map p.op s = x) → (∀ x : Q.obj.obj (Opposite.op Ω), Q.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op x = Q.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op x → ∃ s : Q.obj.obj (Opposite.op U), Q.obj.map p.op s = x) → (∀ s s' : Q.obj.obj (Opposite.op U), Q.obj.map p.op s = Q.obj.map p.op s' → s = s') → (∀ t : I.obj.obj (Opposite.op Ω), wcFpeCocycle S U Ω p I (I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t)) → (∀ y : I.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2)), wcFpeCocycle S U Ω p I y → ∃ t : I.obj.obj (Opposite.op Ω), y = I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t) → (∀ x : E, ∃ q, δ q = x) → (∀ q, δ q = 0 ↔ ∃ s : I.obj.obj (Opposite.op U), π.hom.app (Opposite.op U) s = q) → ∃ Φ : G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2)) → E, (∀ c c', wcFpeCocycle S U Ω p G c → wcFpeCocycle S U Ω p G c' → Φ (c + c') = Φ c + Φ c') ∧ (∀ x, ∃ c, wcFpeCocycle S U Ω p G c ∧ Φ c = x) ∧ (∀ c, wcFpeCocycle S U Ω p G c → (Φ c = 0 ↔ ∃ t : G.obj.obj (Opposite.op Ω), c = G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t)) ∧ (∀ c, wcFpeCocycle S U Ω p G c → ∃ (q : Q.obj.obj (Opposite.op U)) (t : I.obj.obj (Opposite.op Ω)), ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c = I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t ∧ π.hom.app (Opposite.op Ω) t = Q.obj.map p.op q) ∧ (∀ c (t : I.obj.obj (Opposite.op Ω)), ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c = I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t → wcFpeCocycle S U Ω p G c) ∧ (∀ c q (t : I.obj.obj (Opposite.op Ω)), ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c = I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t - I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t → π.hom.app (Opposite.op Ω) t = Q.obj.map p.op q → Φ c = δ q) :=
by
  intro S U Ω p G I Q ι π E _ δ hinj hex hzero hsurjΩ hglueI hglueQ hsepQ hddI hacycI hδsurj hδker
  classical

  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : A ⟶ B)
      {W W' : S.ProEt} (f : W' ⟶ W) (x : A.obj.obj (Opposite.op W)),
      φ.hom.app (Opposite.op W') (A.obj.map f.op x) =
        B.obj.map f.op (φ.hom.app (Opposite.op W) x) :=
    by
      intro A B φ W W' f x
      exact NatTrans.naturality_apply φ.hom f.op x

  have s1 : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : A ⟶ B)
      (t : A.obj.obj (Opposite.op Ω)),
      φ.hom.app (Opposite.op (wcFpeNerve S U Ω p 2))
        (A.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          A.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t) =
      B.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op (φ.hom.app (Opposite.op Ω) t) -
        B.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op
          (φ.hom.app (Opposite.op Ω) t) := by
    intro A B φ t
    rw [map_sub, nat, nat]

  have hπ : ∀ l : Fin 2, Limits.WidePullback.π (fun _ : Fin 2 => p) l ≫ p =
      Limits.WidePullback.base (fun _ : Fin 2 => p) := fun l => Limits.WidePullback.π_arrow _ l
  have s2 : ∀ (A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (s : A.obj.obj (Opposite.op U)),
      A.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op (A.obj.map p.op s) =
        A.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op (A.obj.map p.op s) := by
    intro A s
    rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, hπ 0, hπ 1]

  have hZ : ∀ c : G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2)),
      wcFpeCocycle S U Ω p G c ↔
        wcFpeCocycle S U Ω p I (ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c) := by
    intro c
    have key : ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 3))
        (G.obj.map (wcFpeFace S U Ω p 0).op c - G.obj.map (wcFpeFace S U Ω p 1).op c +
          G.obj.map (wcFpeFace S U Ω p 2).op c) =
        I.obj.map (wcFpeFace S U Ω p 0).op (ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c) -
          I.obj.map (wcFpeFace S U Ω p 1).op (ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c) +
          I.obj.map (wcFpeFace S U Ω p 2).op (ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c) := by
      rw [map_add, map_sub, nat, nat, nat]
    unfold wcFpeCocycle
    constructor
    · intro h
      rw [← key, h, map_zero]
    · intro h
      exact hinj _ _ (by rw [key]; exact h)

  have h5 : ∀ c (t : I.obj.obj (Opposite.op Ω)),
      ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c =
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t →
      wcFpeCocycle S U Ω p G c := by
    intro c t h
    exact (hZ c).2 (by rw [h]; exact hddI t)

  have hex5 : ∀ c, wcFpeCocycle S U Ω p G c → ∃ (q : Q.obj.obj (Opposite.op U))
      (t : I.obj.obj (Opposite.op Ω)), ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c =
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t ∧
      π.hom.app (Opposite.op Ω) t = Q.obj.map p.op q := by
    intro c hc
    obtain ⟨t, ht⟩ := hacycI _ ((hZ c).1 hc)
    have h1 : Q.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op
          (π.hom.app (Opposite.op Ω) t) -
        Q.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op
          (π.hom.app (Opposite.op Ω) t) = 0 := by
      rw [← s1 π t, ← ht]
      exact hzero _ _
    obtain ⟨q, hq⟩ := hglueQ (π.hom.app (Opposite.op Ω) t) (sub_eq_zero.mp h1).symm
    exact ⟨q, t, ht, hq.symm⟩

  have hwd : ∀ c (q : Q.obj.obj (Opposite.op U)) (t : I.obj.obj (Opposite.op Ω))
      (q' : Q.obj.obj (Opposite.op U)) (t' : I.obj.obj (Opposite.op Ω)),
      ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c =
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t →
      π.hom.app (Opposite.op Ω) t = Q.obj.map p.op q →
      ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c =
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t' -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t' →
      π.hom.app (Opposite.op Ω) t' = Q.obj.map p.op q' → δ q = δ q' := by
    intro c q t q' t' h1 h2 h3 h4
    have e : I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op (t - t') -
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op (t - t') = 0 := by
      rw [map_sub, map_sub, sub_sub_sub_comm, sub_eq_zero]
      exact h1.symm.trans h3
    obtain ⟨s, hs⟩ := hglueI (t - t') (sub_eq_zero.mp e).symm
    have e2 : Q.obj.map p.op (q - q') = Q.obj.map p.op (π.hom.app (Opposite.op U) s) := by
      have e1 : π.hom.app (Opposite.op Ω) (t - t') =
          Q.obj.map p.op (π.hom.app (Opposite.op U) s) := by
        rw [← hs, nat]
      rw [map_sub, ← h2, ← h4, ← e1, map_sub]
    have e3 := hsepQ _ _ e2
    have e4 : δ (q - q') = 0 := (hδker _).2 ⟨s, e3.symm⟩
    rw [map_sub, sub_eq_zero] at e4
    exact e4

  let Φ : G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2)) → E := fun c =>
    if h : wcFpeCocycle S U Ω p G c then δ (Classical.choose (hex5 c h)) else 0

  have h6 : ∀ c q (t : I.obj.obj (Opposite.op Ω)),
      ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c =
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t →
      π.hom.app (Opposite.op Ω) t = Q.obj.map p.op q → Φ c = δ q := by
    intro c q t h1 h2
    have hc := h5 c t h1
    obtain ⟨t₀, ht₀1, ht₀2⟩ := Classical.choose_spec (hex5 c hc)
    show (if h : wcFpeCocycle S U Ω p G c then δ (Classical.choose (hex5 c h)) else 0) = δ q
    rw [dif_pos hc]
    exact hwd c _ t₀ q t ht₀1 ht₀2 h1 h2
  refine ⟨Φ, ?_, ?_, ?_, hex5, h5, h6⟩
  ·
    intro c c' hc hc'
    obtain ⟨q, t, h1, h2⟩ := hex5 c hc
    obtain ⟨q', t', h1', h2'⟩ := hex5 c' hc'
    have k1 : ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) (c + c') =
        I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op (t + t') -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op (t + t') := by
      rw [map_add, map_add, map_add, h1, h1']
      abel
    have k2 : π.hom.app (Opposite.op Ω) (t + t') = Q.obj.map p.op (q + q') := by
      rw [map_add, map_add, h2, h2']
    rw [h6 _ _ _ k1 k2, h6 c q t h1 h2, h6 c' q' t' h1' h2', map_add]
  ·
    intro x
    obtain ⟨q, hq⟩ := hδsurj x
    obtain ⟨t, ht⟩ := hsurjΩ (Q.obj.map p.op q)
    have e : π.hom.app (Opposite.op (wcFpeNerve S U Ω p 2))
        (I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t) = 0 := by
      rw [s1 π t, ht, s2 Q q, sub_self]
    obtain ⟨c, hc⟩ := hex _ _ e
    exact ⟨c, h5 c t hc, (h6 c q t hc ht).trans hq⟩
  ·
    intro c hc
    constructor
    · intro h0
      obtain ⟨q, t, h1, h2⟩ := hex5 c hc
      have hq0 : δ q = 0 := (h6 c q t h1 h2).symm.trans h0
      obtain ⟨s, hs⟩ := (hδker q).1 hq0
      have e : π.hom.app (Opposite.op Ω) (t - I.obj.map p.op s) = 0 := by
        rw [map_sub, nat, hs, h2, sub_self]
      obtain ⟨t₀, ht₀⟩ := hex _ _ e
      refine ⟨t₀, ?_⟩
      have e2 : ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2))
          (G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t₀ -
            G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t₀) =
          ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c := by
        rw [s1 ι t₀, ht₀, h1, map_sub, map_sub, s2 I s]
        abel
      have e3 : ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2))
          (c - (G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t₀ -
            G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t₀)) = 0 := by
        rw [map_sub, e2, sub_self]
      exact sub_eq_zero.mp (hinj _ _ e3)
    · rintro ⟨t₀, ht₀⟩
      have h1 : ι.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c =
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op
            (ι.hom.app (Opposite.op Ω) t₀) -
          I.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op
            (ι.hom.app (Opposite.op Ω) t₀) := by
        rw [ht₀, s1 ι t₀]
      have h2 : π.hom.app (Opposite.op Ω) (ι.hom.app (Opposite.op Ω) t₀) =
          Q.obj.map p.op 0 := by
        rw [hzero, map_zero]
      rw [h6 c 0 _ h1 h2, map_zero]

theorem wc_fpe_ext1_cech (S : Scheme.{u}) (U Ω : S.ProEt) (p : Ω ⟶ U)
    (hproj : Projective (wcFreeSheaf S Ω))
    (hcov : Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S U)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :
    ∃ Φ : G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2)) → Abelian.Ext (wcFreeSheaf S U) G 1,
      (∀ c c', wcFpeCocycle S U Ω p G c → wcFpeCocycle S U Ω p G c' →
        Φ (c + c') = Φ c + Φ c') ∧
      (∀ x, ∃ c, wcFpeCocycle S U Ω p G c ∧ Φ c = x) ∧
      (∀ c, wcFpeCocycle S U Ω p G c → (Φ c = 0 ↔ ∃ t : G.obj.obj (Opposite.op Ω),
        c = G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
          G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t)) ∧
      (∀ (σ : G ⟶ G) c, wcFpeCocycle S U Ω p G c →
        wcFpeCocycle S U Ω p G (σ.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c) ∧
        Φ (σ.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c) =
          (Φ c).comp (Abelian.Ext.mk₀ σ) (add_zero 1)) ∧
      (∀ (a : U ⟶ U) (b : Ω ⟶ Ω) (b₂ : wcFpeNerve S U Ω p 2 ⟶ wcFpeNerve S U Ω p 2),
        b ≫ p = p ≫ a →
        (∀ l : Fin 2, b₂ ≫ Limits.WidePullback.π (fun _ : Fin 2 => p) l =
          Limits.WidePullback.π (fun _ : Fin 2 => p) l ≫ b) →
        ∀ c, wcFpeCocycle S U Ω p G c →
          wcFpeCocycle S U Ω p G (G.obj.map b₂.op c) ∧
          Φ (G.obj.map b₂.op c) =
            (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Φ c) (zero_add 1)) :=
by
  classical
  have := hproj
  have hcomp : ∀ {A B C : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (g : B ⟶ C) (W : S.ProEt) (x : A.obj.obj (Opposite.op W)),
      (f ≫ g).hom.app (Opposite.op W) x = g.hom.app (Opposite.op W) (f.hom.app (Opposite.op W) x) :=
    fun _ _ _ _ => rfl
  have hS : (ShortComplex.mk (Injective.ι G) (Limits.cokernel.π (Injective.ι G))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  obtain ⟨hinj, hex, hzero, -⟩ := wc_proet_ses_sectionwise S (Injective.ι G)
    (Limits.cokernel.π (Injective.ι G)) (Limits.cokernel.condition _) hS
  obtain ⟨hglue, hsep, hdd, hacyc⟩ := wc_fpe_singleton_cech S U Ω p hcov
  obtain ⟨δ, hδs, hδk, hδσ, hδa⟩ := wc_fpe_ext1_boundary S U G
  obtain ⟨η, hη, -⟩ := wc_proet_free_sheaf_yoneda S

  have hsurjΩ : ∀ q : (Limits.cokernel (Injective.ι G)).obj.obj (Opposite.op Ω),
      ∃ t, (Limits.cokernel.π (Injective.ι G)).hom.app (Opposite.op Ω) t = q := by
    intro q
    obtain ⟨g, hg, -⟩ := hη Ω _ q
    refine ⟨((Projective.factorThru g (Limits.cokernel.π (Injective.ι G))).hom.app
      (Opposite.op Ω)).hom (η Ω), ?_⟩
    rw [← hg]
    exact congrArg (fun φ : wcFreeSheaf S Ω ⟶ Limits.cokernel (Injective.ι G) =>
      (φ.hom.app (Opposite.op Ω)).hom (η Ω))
      (Projective.factorThru_comp g (Limits.cokernel.π (Injective.ι G)))
  obtain ⟨Φ, h1, h2, h3, h4, h5, h6⟩ := wc_fpe_cech_connecting S U Ω p (Injective.ι G)
    (Limits.cokernel.π (Injective.ι G)) δ hinj hex hzero hsurjΩ (hglue _) (hglue _) (hsep _)
    (hdd _) (hacyc (Injective.under G)) hδs hδk
  refine ⟨Φ, h1, h2, h3, ?_, ?_⟩
  · intro σ c hc
    obtain ⟨q, t, hct, htq⟩ := h4 c hc
    obtain ⟨σ₁, σ₂, e₁, e₂, e₃⟩ := hδσ σ
    have hι : (Injective.ι G).hom.app (Opposite.op (wcFpeNerve S U Ω p 2))
        (σ.hom.app (Opposite.op (wcFpeNerve S U Ω p 2)) c) =
        (Injective.under G).obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op
            (σ₁.hom.app (Opposite.op Ω) t) -
          (Injective.under G).obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op
            (σ₁.hom.app (Opposite.op Ω) t) := by
      rw [← hcomp σ (Injective.ι G), ← e₁, hcomp, hct, map_sub,
        NatTrans.naturality_apply σ₁.hom, NatTrans.naturality_apply σ₁.hom]
    have hπ : (Limits.cokernel.π (Injective.ι G)).hom.app (Opposite.op Ω)
        (σ₁.hom.app (Opposite.op Ω) t) =
        (Limits.cokernel (Injective.ι G)).obj.map p.op (σ₂.hom.app (Opposite.op U) q) := by
      rw [← hcomp σ₁ (Limits.cokernel.π (Injective.ι G)), ← e₂, hcomp, htq,
        NatTrans.naturality_apply σ₂.hom]
    refine ⟨h5 _ _ hι, ?_⟩
    rw [h6 _ _ _ hι hπ, e₃ q, h6 c q t hct htq]
  · intro a b b₂ hbp hb₂ c hc
    obtain ⟨q, t, hct, htq⟩ := h4 c hc
    have e : ∀ l : Fin 2, (Injective.under G).obj.map b₂.op
        ((Injective.under G).obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) l).op t) =
        (Injective.under G).obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) l).op
          ((Injective.under G).obj.map b.op t) := by
      intro l
      rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, hb₂ l]
    have hι : (Injective.ι G).hom.app (Opposite.op (wcFpeNerve S U Ω p 2))
        (G.obj.map b₂.op c) =
        (Injective.under G).obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op
            ((Injective.under G).obj.map b.op t) -
          (Injective.under G).obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op
            ((Injective.under G).obj.map b.op t) := by
      rw [NatTrans.naturality_apply (Injective.ι G).hom, hct, map_sub, e 0, e 1]
    have hπ : (Limits.cokernel.π (Injective.ι G)).hom.app (Opposite.op Ω)
        ((Injective.under G).obj.map b.op t) =
        (Limits.cokernel (Injective.ι G)).obj.map p.op
          ((Limits.cokernel (Injective.ι G)).obj.map a.op q) := by
      rw [NatTrans.naturality_apply (Limits.cokernel.π (Injective.ι G)).hom, htq,
        ← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, hbp]
    refine ⟨h5 _ _ hι, ?_⟩
    rw [h6 _ _ _ hι hπ, hδa a q, h6 c q t hct htq]

theorem wc_fpe_tau_sections (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (S : Scheme.{u}) (U : S.ProEt)
    (a : U ⟶ U) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (s : ℚ_[ℓ] → (G ⟶ G)) (r : ℕ) (T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
    (τ : G.over U ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over U)
    (hτs : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map (s c) ≫ τ.hom =
        τ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hτT : ∀ (W : S.ProEt) (w : W ⟶ U),
      τ.hom.hom.app (Opposite.op (Over.mk (w ≫ a))) =
        τ.hom.hom.app (Opposite.op (Over.mk w)) ≫
          (wcContSheafMap S T.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional T)).hom.app (Opposite.op W)) :
    ∃ θ : ∀ (W : S.ProEt) (_ : W ⟶ U), G.obj.obj (Opposite.op W) ≃+ C(↥W.left, Fin r → ℚ_[ℓ]),
      (∀ (W W' : S.ProEt) (f : W' ⟶ W) (w : W ⟶ U) (x : G.obj.obj (Opposite.op W))
        (y : ↥W'.left), θ W' (f ≫ w) (G.obj.map f.op x) y = θ W w x (f.left y)) ∧
      (∀ (W : S.ProEt) (w : W ⟶ U) (c : ℚ_[ℓ]) (x : G.obj.obj (Opposite.op W)),
        θ W w ((s c).hom.app (Opposite.op W) x) = c • θ W w x) ∧
      (∀ (W : S.ProEt) (w : W ⟶ U) (x : G.obj.obj (Opposite.op W)) (y : ↥W.left),
        θ W (w ≫ a) x y = T (θ W w x y)) :=
by
  classical
  let e : ∀ (W : S.ProEt) (w : W ⟶ U),
      G.obj.obj (Opposite.op W) ≃+ ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) :=
    fun W w => Iso.addCommGroupIsoToAddEquiv
      (((sheafToPresheaf _ _).mapIso τ).app (Opposite.op (Over.mk w)))
  refine ⟨fun W w => (e W w).trans AddEquiv.ulift, ?_, ?_, ?_⟩
  · intro W W' f w x y
    have hn := τ.hom.hom.naturality (Over.homMk f : Over.mk (f ≫ w) ⟶ Over.mk w).op
    have h := ConcreteCategory.congr_hom hn x
    exact congrArg (fun v : ULift.{u+1} C(↥W'.left, Fin r → ℚ_[ℓ]) => ULift.down v y) h
  · intro W w c x
    refine ContinuousMap.ext (fun y => ?_)
    have hc := congrArg (fun φ => φ.hom.app (Opposite.op (Over.mk w))) (hτs c)
    have h := ConcreteCategory.congr_hom hc x
    have h2 := congrArg (fun v : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => ULift.down v y) h
    first
    | exact h2
    | exact h2.trans rfl
    | (refine h2.trans ?_; funext j; rfl)
  · intro W w x y
    have h := ConcreteCategory.congr_hom (hτT W w) x
    exact congrArg (fun v : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => ULift.down v y) h

theorem wc_fpe_ext0 (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (S : Scheme.{u}) (U : S.ProEt)
    (a : U ⟶ U) (K : Type u) [Field K] (iK : U.left ≅ Spec (CommRingCat.of K))
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (s : ℚ_[ℓ] → (G ⟶ G)) (r : ℕ) (T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
    (τ : G.over U ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over U)
    (hτs : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map (s c) ≫ τ.hom =
        τ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hτT : ∀ (W : S.ProEt) (w : W ⟶ U),
      τ.hom.hom.app (Opposite.op (Over.mk (w ≫ a))) =
        τ.hom.hom.app (Opposite.op (Over.mk w)) ≫
          (wcContSheafMap S T.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional T)).hom.app (Opposite.op W)) :
    ∃ Φ0 : Abelian.Ext (wcFreeSheaf S U) G 0 ≃+ (Fin r → ℚ_[ℓ]),
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf S U) G 0),
        Φ0 (y.comp (Abelian.Ext.mk₀ (s c)) (add_zero 0)) = c • Φ0 y) ∧
      (∀ y : Abelian.Ext (wcFreeSheaf S U) G 0,
        T (Φ0 ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp y (zero_add 0))) = Φ0 y) :=
by
  classical

  let u₀ : U.left := iK.inv (IsLocalRing.closedPoint K)
  have hconst : ∀ (f : C(U.left, Fin r → ℚ_[ℓ])) (x : U.left), f x = f u₀ := by
    intro f x
    have h1 : iK.hom x ⤳ (IsLocalRing.closedPoint K : Spec (.of K)) :=
      IsLocalRing.specializes_closedPoint (R := K) (iK.hom x)
    have h2 : iK.inv (iK.hom x) ⤳ u₀ := h1.map (Scheme.Hom.continuous iK.inv)
    rw [Scheme.hom_inv_apply] at h2
    exact (h2.map f.continuous).eq

  let J := Scheme.ProEt.topology S
  let P := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let η : (wcFreeSheaf S U).obj.obj (Opposite.op U) :=
    ((toSheafify J P).app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))
  let eqv : (wcFreeSheaf S U ⟶ G) ≃ G.obj.obj (Opposite.op U) :=
    ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv P G).trans
      (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G.obj).trans
        (uliftYonedaEquiv.{u+1} (X := U) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
  have heqv : ∀ g : wcFreeSheaf S U ⟶ G, eqv g = (g.hom.app (Opposite.op U)).hom η :=
    fun _ => rfl
  have hadd : ∀ g g' : wcFreeSheaf S U ⟶ G, eqv (g + g') = eqv g + eqv g' := by
    intro g g'
    rw [heqv, heqv, heqv]
    first
      | rfl
      | simp [Sheaf.Hom.add_app]
      | simp
  let eqvA : (wcFreeSheaf S U ⟶ G) ≃+ G.obj.obj (Opposite.op U) := AddEquiv.mk' eqv hadd
  have hnat : ((wcFreeSheafMap S a).hom.app (Opposite.op U)).hom η =
      ((wcFreeSheaf S U).obj.map a.op).hom η := by
    let w : P ⟶ P :=
      Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let x : P.obj (Opposite.op U) := FreeAbelianGroup.of (ULift.up (𝟙 U))
    have h1 : ((sheafifyMap J w).app (Opposite.op U)).hom (((toSheafify J P).app
        (Opposite.op U)).hom x) = ((toSheafify J P).app (Opposite.op U)).hom
          ((w.app (Opposite.op U)).hom x) :=
      (ConcreteCategory.congr_hom
        (congrArg (fun ψ => ψ.app (Opposite.op U)) (toSheafify_naturality J w)) x).symm
    have h2 : (w.app (Opposite.op U)).hom x = (P.map a.op).hom x := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
        FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      refine (FreeAbelianGroup.map_of_apply _).trans
        (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
      congr 1
    have hn : ((toSheafify J P).app (Opposite.op U)).hom ((P.map a.op).hom x) =
        ((sheafify J P).map a.op).hom (((toSheafify J P).app (Opposite.op U)).hom x) :=
      NatTrans.naturality_apply (toSheafify J P) a.op x
    change ((sheafifyMap J w).app (Opposite.op U)).hom (((toSheafify J P).app
        (Opposite.op U)).hom x) =
      ((sheafify J P).map a.op).hom (((toSheafify J P).app (Opposite.op U)).hom x)
    rw [h1, h2, hn]
  have hnatG : ∀ g : wcFreeSheaf S U ⟶ G,
      eqv (wcFreeSheafMap S a ≫ g) = (G.obj.map a.op).hom (eqv g) := by
    intro g
    rw [heqv, heqv]
    change (g.hom.app (Opposite.op U)).hom
      (((wcFreeSheafMap S a).hom.app (Opposite.op U)).hom η) = _
    rw [hnat]
    exact NatTrans.naturality_apply g.hom a.op η
  have hpostG : ∀ (ψ : G ⟶ G) (g : wcFreeSheaf S U ⟶ G),
      eqv (g ≫ ψ) = (ψ.hom.app (Opposite.op U)).hom (eqv g) := by
    intro ψ g
    rw [heqv, heqv]
    rfl

  let X₀ : Over U := Over.mk (𝟙 U)
  let X₁ : Over U := Over.mk (𝟙 U ≫ a)
  let hX : X₁ ⟶ X₀ := Over.homMk a (by simp [X₀, X₁])
  let τ₀ : G.obj.obj (Opposite.op U) → C(U.left, Fin r → ℚ_[ℓ]) :=
    fun x => (show ULift.{u+1} C(U.left, Fin r → ℚ_[ℓ]) from
      (τ.hom.hom.app (Opposite.op X₀)).hom x).down
  let τ₁ : G.obj.obj (Opposite.op U) → C(U.left, Fin r → ℚ_[ℓ]) :=
    fun x => (show ULift.{u+1} C(U.left, Fin r → ℚ_[ℓ]) from
      (τ.hom.hom.app (Opposite.op X₁)).hom x).down
  let τe : G.obj.obj (Opposite.op U) ≃+ ULift.{u+1} C(U.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso τ).app (Opposite.op X₀)).addCommGroupIsoToAddEquiv
  let ev : ULift.{u+1} C(U.left, Fin r → ℚ_[ℓ]) ≃+ (Fin r → ℚ_[ℓ]) :=
    { toFun := fun F => F.down u₀
      invFun := fun m => ULift.up (ContinuousMap.const _ m)
      left_inv := fun F => ULift.ext _ _ (ContinuousMap.ext fun x => (hconst F.down x).symm)
      right_inv := fun m => rfl
      map_add' := fun F F' => rfl }
  let β : G.obj.obj (Opposite.op U) ≃+ (Fin r → ℚ_[ℓ]) := τe.trans ev
  have hβ : ∀ x, β x = τ₀ x u₀ := fun _ => rfl
  have hscal : ∀ (c : ℚ_[ℓ]) (x : G.obj.obj (Opposite.op U)),
      β (((s c).hom.app (Opposite.op U)).hom x) = c • β x := by
    intro c x
    have h1 := NatTrans.congr_app (congrArg (fun f => f.hom) (hτs c)) (Opposite.op X₀)
    have h2 := congrArg ULift.down (ConcreteCategory.congr_hom h1 x)
    have h3 := congrArg (fun f : C(U.left, Fin r → ℚ_[ℓ]) => f u₀) h2
    exact h3
  have key : ∀ x : G.obj.obj (Opposite.op U),
      τ₁ ((G.obj.map a.op).hom x) = (τ₀ x).comp a.left.base.hom := by
    intro x
    exact congrArg ULift.down
      (congrArg (fun f => AddCommGrpCat.Hom.hom f x) (τ.hom.hom.naturality hX.op))
  have hH : ∀ y : G.obj.obj (Opposite.op U), τ₁ y u₀ = T (τ₀ y u₀) := by
    intro y
    have h1 := hτT U (𝟙 U)
    have h2 := congrArg ULift.down (ConcreteCategory.congr_hom h1 y)
    have h3 := congrArg (fun f : C(U.left, Fin r → ℚ_[ℓ]) => f u₀) h2
    exact h3
  have hfrob : ∀ x : G.obj.obj (Opposite.op U), T (β ((G.obj.map a.op).hom x)) = β x := by
    intro x
    rw [hβ, hβ, ← hH, key, ContinuousMap.comp_apply]
    exact hconst _ _

  let E0 : Abelian.Ext (wcFreeSheaf S U) G 0 ≃+ (wcFreeSheaf S U ⟶ G) := Abelian.Ext.addEquiv₀
  have hE0 : ∀ h : wcFreeSheaf S U ⟶ G, E0 (Abelian.Ext.mk₀ h) = h := by
    intro h
    apply (Abelian.Ext.mk₀_bijective _ _).1
    exact Abelian.Ext.mk₀_addEquiv₀_apply _
  let b : Abelian.Ext (wcFreeSheaf S U) G 0 ≃+ (Fin r → ℚ_[ℓ]) := E0.trans (eqvA.trans β)
  have hb : ∀ h : wcFreeSheaf S U ⟶ G, b (Abelian.Ext.mk₀ h) = β (eqv h) := by
    intro h
    show β (eqvA (E0 (Abelian.Ext.mk₀ h))) = β (eqv h)
    rw [hE0]
    rfl
  refine ⟨b, ?_, ?_⟩
  · intro c y
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    rw [Abelian.Ext.mk₀_comp_mk₀, hb, hb, hpostG]
    exact hscal c (eqv g)
  · intro y
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    rw [Abelian.Ext.mk₀_comp_mk₀, hb, hb, hnatG]
    exact hfrob (eqv g)

theorem wc_field_point_ext_galois (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (S : Scheme.{u}) (U : S.ProEt)
    (a : U ⟶ U) (K : Type u) [Field K] (iK : U.left ≅ Spec (CommRingCat.of K)) (ρK : K ≃+* K)
    (hρ : iK.inv ≫ a.left ≫ iK.hom = Spec.map (CommRingCat.ofHom (ρK : K →+* K)))
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (s : ℚ_[ℓ] → (G ⟶ G)) (r : ℕ) (T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
    (τ : G.over U ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over U)
    (hτs : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map (s c) ≫ τ.hom =
        τ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hτT : ∀ (W : S.ProEt) (w : W ⟶ U),
      τ.hom.hom.app (Opposite.op (Over.mk (w ≫ a))) =
        τ.hom.hom.app (Opposite.op (Over.mk w)) ≫
          (wcContSheafMap S T.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional T)).hom.app (Opposite.op W)) :
    ∃ (ρL : SeparableClosure K ≃+* SeparableClosure K)
      (Φ1 : Abelian.Ext (wcFreeSheaf S U) G 1 →+
        ((SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Fin r → ℚ_[ℓ])))
      (Φ0 : Abelian.Ext (wcFreeSheaf S U) G 0 ≃+ (Fin r → ℚ_[ℓ])),
      (∀ x : K, ρL (algebraMap K (SeparableClosure K) x) =
        algebraMap K (SeparableClosure K) (ρK x)) ∧
      Function.Injective Φ1 ∧
      (∀ x, Continuous (Φ1 x) ∧ ∀ g h, Φ1 x (g * h) = Φ1 x g + Φ1 x h) ∧
      (∀ f : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Fin r → ℚ_[ℓ]),
        Continuous f → (∀ g h, f (g * h) = f g + f h) → ∃ x, Φ1 x = f) ∧
      (∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf S U) G 1),
        Φ1 (x.comp (Abelian.Ext.mk₀ (s c)) (add_zero 1)) = c • Φ1 x) ∧
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf S U) G 0),
        Φ0 (y.comp (Abelian.Ext.mk₀ (s c)) (add_zero 0)) = c • Φ0 y) ∧
      (∀ (x : Abelian.Ext (wcFreeSheaf S U) G 1)
          (g g' : SeparableClosure K ≃ₐ[K] SeparableClosure K), (∀ z, ρL (g' z) = g (ρL z)) →
        T (Φ1 ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp x (zero_add 1)) g) = Φ1 x g') ∧
      (∀ y : Abelian.Ext (wcFreeSheaf S U) G 0,
        T (Φ0 ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp y (zero_add 0))) = Φ0 y) :=
by
  classical
  obtain ⟨Ω, p, ρL, b, b₂, h₂, hproj, hcov, hΩpt, hρL, hbp, hb₂π, hb₂base, hb₂pt, hfaces,
    hfaces'⟩ := wc_fpe_nerve_points S U a K iK ρK hρ
  haveI := hΩpt
  obtain ⟨Φ, hΦadd, hΦsurj, hΦker, hΦσ, hΦa⟩ := wc_fpe_ext1_cech S U Ω p hproj hcov G
  obtain ⟨θ, hθnat, hθs, hθT⟩ := wc_fpe_tau_sections ℓ S U a G s r T τ hτs hτT
  obtain ⟨Φ0, hΦ0s, hΦ0T⟩ := wc_fpe_ext0 ℓ S U a K iK G s r T τ hτs hτT

  have hface_base : ∀ j : Fin 3, wcFpeFace S U Ω p j ≫ Limits.WidePullback.base (fun _ : Fin 2 => p) =
      Limits.WidePullback.base (fun _ : Fin 3 => p) := by
    intro j
    unfold wcFpeFace wcCechFace
    exact Limits.WidePullback.lift_base _ _ _ _
  have hface : ∀ (c : G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2))) (j : Fin 3)
      (v : ↥(wcFpeNerve S U Ω p 3).left),
      θ (wcFpeNerve S U Ω p 3) (Limits.WidePullback.base (fun _ : Fin 3 => p))
          (G.obj.map (wcFpeFace S U Ω p j).op c) v =
        θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p)) c
          ((wcFpeFace S U Ω p j).left v) := by
    intro c j v
    have := hθnat (wcFpeNerve S U Ω p 2) (wcFpeNerve S U Ω p 3) (wcFpeFace S U Ω p j)
      (Limits.WidePullback.base (fun _ : Fin 2 => p)) c v
    rw [hface_base j] at this
    exact this

  let Fm : G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2)) →+
      ((SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Fin r → ℚ_[ℓ])) :=
    { toFun := fun c g => θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p))
        c (h₂ g)
      map_zero' := by funext g; simp
      map_add' := fun c c' => by funext g; simp }
  have hFm : ∀ c g, Fm c g = θ (wcFpeNerve S U Ω p 2)
      (Limits.WidePullback.base (fun _ : Fin 2 => p)) c (h₂ g) := fun c g => rfl

  have hZiff : ∀ c, wcFpeCocycle S U Ω p G c ↔ ∀ g h, Fm c (g * h) = Fm c g + Fm c h := by
    intro c
    constructor
    · intro hc g k
      unfold wcFpeCocycle at hc
      obtain ⟨v, h0, h1, h2⟩ := hfaces' g (g * k)
      have e := congrArg (fun x => θ (wcFpeNerve S U Ω p 3)
        (Limits.WidePullback.base (fun _ : Fin 3 => p)) x v) hc
      simp only [map_add, map_sub, map_zero, ContinuousMap.add_apply, ContinuousMap.sub_apply,
        ContinuousMap.zero_apply, hface, h0, h1, h2, inv_mul_cancel_left] at e
      rw [hFm, hFm, hFm]
      refine sub_eq_zero.mp ?_
      rw [← neg_eq_zero, ← e]
      abel
    · intro hhom
      unfold wcFpeCocycle
      apply (θ (wcFpeNerve S U Ω p 3) (Limits.WidePullback.base (fun _ : Fin 3 => p))).injective
      refine ContinuousMap.ext (fun v => ?_)
      obtain ⟨g, h, h0, h1, h2⟩ := hfaces v
      simp only [map_add, map_sub, map_zero, ContinuousMap.add_apply, ContinuousMap.sub_apply,
        ContinuousMap.zero_apply, hface, h0, h1, h2]
      have e := hhom g (g⁻¹ * h)
      rw [mul_inv_cancel_left, hFm, hFm, hFm] at e
      rw [e]
      abel

  have hπ : ∀ l : Fin 2, Limits.WidePullback.π (fun _ : Fin 2 => p) l ≫ p =
      Limits.WidePullback.base (fun _ : Fin 2 => p) := fun l => Limits.WidePullback.π_arrow _ l
  have hB : ∀ t : G.obj.obj (Opposite.op Ω),
      Fm (G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).op t -
        G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).op t) = 0 := by
    intro t
    funext g
    rw [hFm]
    have e : ∀ l : Fin 2, θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p))
        (G.obj.map (Limits.WidePullback.π (fun _ : Fin 2 => p) l).op t) (h₂ g) =
        θ Ω p t ((Limits.WidePullback.π (fun _ : Fin 2 => p) l).left (h₂ g)) := by
      intro l
      have := hθnat Ω (wcFpeNerve S U Ω p 2) (Limits.WidePullback.π (fun _ : Fin 2 => p) l) p t
        (h₂ g)
      rw [hπ l] at this
      exact this
    rw [map_sub, ContinuousMap.sub_apply, e 1, e 0,
      Subsingleton.elim ((Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left (h₂ g))
        ((Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left (h₂ g)), sub_self]
    rfl

  let Z : AddSubgroup (G.obj.obj (Opposite.op (wcFpeNerve S U Ω p 2))) :=
    { carrier := {c | wcFpeCocycle S U Ω p G c}
      add_mem' := fun {c c'} hc hc' => (hZiff _).2 (fun g h => by
        rw [map_add, Pi.add_apply, Pi.add_apply, Pi.add_apply, (hZiff c).1 hc g h,
          (hZiff c').1 hc' g h]; abel)
      zero_mem' := (hZiff _).2 (fun g h => by rw [map_zero]; simp)
      neg_mem' := fun {c} hc => (hZiff _).2 (fun g h => by
        rw [map_neg, Pi.neg_apply, Pi.neg_apply, Pi.neg_apply, (hZiff c).1 hc g h]; abel) }
  have hΦ00 : Φ 0 = 0 := by
    have h0 : wcFpeCocycle S U Ω p G 0 := Z.zero_mem
    have := hΦadd 0 0 h0 h0
    rw [add_zero] at this
    exact add_left_cancel (this.symm.trans (add_zero _).symm)
  let Φ' : Z →+ Abelian.Ext (wcFreeSheaf S U) G 1 :=
    { toFun := fun c => Φ c.1
      map_zero' := hΦ00
      map_add' := fun c c' => hΦadd c.1 c'.1 c.2 c'.2 }
  have hs : Function.Surjective Φ' := by
    intro x
    obtain ⟨c, hc, hcx⟩ := hΦsurj x
    exact ⟨⟨c, hc⟩, hcx⟩
  have hker : Φ'.ker ≤ (Fm.comp Z.subtype).ker := by
    intro c hc
    rw [AddMonoidHom.mem_ker] at hc ⊢
    obtain ⟨t, ht⟩ := (hΦker c.1 c.2).1 hc
    show Fm c.1 = 0
    rw [ht]
    exact hB t
  let Φ1 : Abelian.Ext (wcFreeSheaf S U) G 1 →+
      ((SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Fin r → ℚ_[ℓ])) :=
    (QuotientAddGroup.lift Φ'.ker (Fm.comp Z.subtype) hker).comp
      (QuotientAddGroup.quotientKerEquivOfSurjective Φ' hs).symm.toAddMonoidHom
  have hΦ1 : ∀ c (hc : wcFpeCocycle S U Ω p G c), Φ1 (Φ c) = Fm c := by
    intro c hc
    have e : (QuotientAddGroup.quotientKerEquivOfSurjective Φ' hs).symm (Φ c) =
        (QuotientAddGroup.mk (⟨c, hc⟩ : Z) : Z ⧸ Φ'.ker) := by
      rw [AddEquiv.symm_apply_eq]
      rfl
    show QuotientAddGroup.lift Φ'.ker (Fm.comp Z.subtype) hker
      ((QuotientAddGroup.quotientKerEquivOfSurjective Φ' hs).symm (Φ c)) = Fm c
    rw [e]
    rfl
  refine ⟨ρL, Φ1, Φ0, hρL, ?_, ?_, ?_, ?_, hΦ0s, ?_, hΦ0T⟩
  ·
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨c, hc, rfl⟩ := hΦsurj x
    rw [hΦ1 c hc] at hx
    have hθ0 : θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p)) c = 0 := by
      refine ContinuousMap.ext (fun y => ?_)
      obtain ⟨g, rfl⟩ := h₂.surjective y
      have := congrFun hx g
      rw [Pi.zero_apply, hFm] at this
      rw [ContinuousMap.zero_apply]
      exact this
    have hc0 : c = 0 :=
      (θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p))).injective
        (hθ0.trans (map_zero _).symm)
    exact (hΦker c hc).2 ⟨0, by simp [hc0]⟩
  ·
    intro x
    obtain ⟨c, hc, rfl⟩ := hΦsurj x
    rw [hΦ1 c hc]
    refine ⟨?_, (hZiff c).1 hc⟩
    exact (θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p))
      c).continuous.comp h₂.continuous
  ·
    intro f hf hhom
    let fc : C(↥(wcFpeNerve S U Ω p 2).left, Fin r → ℚ_[ℓ]) :=
      ⟨f ∘ h₂.symm, hf.comp h₂.symm.continuous⟩
    let c := (θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p))).symm fc
    have hFc : Fm c = f := by
      funext g
      rw [hFm]
      show θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p))
        ((θ (wcFpeNerve S U Ω p 2) (Limits.WidePullback.base (fun _ : Fin 2 => p))).symm fc)
          (h₂ g) = f g
      rw [AddEquiv.apply_symm_apply]
      show f (h₂.symm (h₂ g)) = f g
      rw [Homeomorph.symm_apply_apply]
    have hc : wcFpeCocycle S U Ω p G c := (hZiff c).2 (by rw [hFc]; exact hhom)
    exact ⟨Φ c, by rw [hΦ1 c hc, hFc]⟩
  ·
    intro c' x
    obtain ⟨c, hc, rfl⟩ := hΦsurj x
    obtain ⟨hc2, e⟩ := hΦσ (s c') c hc
    rw [← e, hΦ1 _ hc2, hΦ1 c hc]
    funext g
    rw [Pi.smul_apply, hFm, hFm, hθs, ContinuousMap.smul_apply]
  ·
    intro x g g' hgg'
    obtain ⟨c, hc, rfl⟩ := hΦsurj x
    obtain ⟨hc2, e⟩ := hΦa a b b₂ hbp hb₂π c hc
    rw [← e, hΦ1 _ hc2, hΦ1 c hc, hFm, hFm, ← hθT, ← hb₂base, hθnat, hb₂pt g g' hgg']

theorem wc_padicInt_of_compatible (p : ℕ) [Fact (Nat.Prime p)] (x : ∀ m : ℕ, ZMod (p ^ m))
    (hx : ∀ m : ℕ, ZMod.castHom (pow_dvd_pow p (Nat.le_succ m)) (ZMod (p ^ m)) (x (m + 1)) = x m) :
    ∃ z : ℤ_[p], ∀ m : ℕ, PadicInt.toZModPow m z = x m :=
by
  classical
  let S : Subring (∀ m : ℕ, ZMod (p ^ m)) :=
    { carrier := {y | ∀ m : ℕ,
        ZMod.castHom (pow_dvd_pow p (Nat.le_succ m)) (ZMod (p ^ m)) (y (m + 1)) = y m}
      mul_mem' := by
        intro a b ha hb m
        simp only [Set.mem_setOf_eq] at ha hb
        simp only [Pi.mul_apply, map_mul, ha m, hb m]
      one_mem' := by
        intro m
        simp only [Pi.one_apply, map_one]
      add_mem' := by
        intro a b ha hb m
        simp only [Set.mem_setOf_eq] at ha hb
        simp only [Pi.add_apply, map_add, ha m, hb m]
      zero_mem' := by
        intro m
        simp only [Pi.zero_apply, map_zero]
      neg_mem' := by
        intro a ha m
        simp only [Set.mem_setOf_eq] at ha
        simp only [Pi.neg_apply, map_neg, ha m] }
  let f : ∀ k : ℕ, S →+* ZMod (p ^ k) := fun k =>
    (Pi.evalRingHom (fun m : ℕ => ZMod (p ^ m)) k).comp S.subtype
  have hf : ∀ k (y : S), f k y = (y : ∀ m : ℕ, ZMod (p ^ m)) k := fun k y => rfl
  have compat : ∀ k1 k2 (hk : k1 ≤ k2),
      (ZMod.castHom (pow_dvd_pow p hk) (ZMod (p ^ k1))).comp (f k2) = f k1 := by
    intro k1 k2 hk
    induction k2, hk using Nat.le_induction with
    | base =>
      ext y
      rw [RingHom.comp_apply, hf, ZMod.castHom_apply]
      exact ZMod.cast_id _ _
    | succ k2 hk ih =>
      ext y
      have hy : ∀ m : ℕ, ZMod.castHom (pow_dvd_pow p (Nat.le_succ m)) (ZMod (p ^ m))
          ((y : ∀ m : ℕ, ZMod (p ^ m)) (m + 1)) = (y : ∀ m : ℕ, ZMod (p ^ m)) m := y.2
      have h1 := congrArg (fun g => g y) ih
      simp only [RingHom.comp_apply, hf] at h1
      rw [RingHom.comp_apply, hf, hf, ← h1, ← hy k2]
      exact (RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow p hk)
        (pow_dvd_pow p (Nat.le_succ k2))) _).symm
  refine ⟨PadicInt.lift compat ⟨x, hx⟩, fun m => ?_⟩
  have h := congrArg (fun g => g (⟨x, hx⟩ : S)) (PadicInt.lift_spec compat m)
  simpa only [RingHom.comp_apply, hf] using h

theorem wc_padicInt_hom_continuous {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (p : ℕ) [Fact (Nat.Prime p)] (χ : G → ℤ_[p]) (hχ : ∀ g h, χ (g * h) = χ g + χ h)
    (hopen : ∀ m : ℕ, IsOpen {g : G | PadicInt.toZModPow m (χ g) = 0}) : Continuous χ :=
by
  have h1 : χ 1 = 0 := by
    have h := hχ 1 1
    rw [mul_one] at h
    have h' : χ 1 + χ 1 = χ 1 + 0 := by rw [add_zero]; exact h.symm
    exact add_left_cancel h'
  rw [Metric.continuous_iff']
  intro g₀ ε hε
  obtain ⟨k, hk⟩ := PadicInt.exists_pow_neg_lt p hε
  have hV : IsOpen ((fun g => g₀⁻¹ * g) ⁻¹' {g : G | PadicInt.toZModPow k (χ g) = 0}) :=
    (hopen k).preimage (continuous_const.mul continuous_id : Continuous fun g : G => g₀⁻¹ * g)
  have hmem : g₀ ∈ (fun g => g₀⁻¹ * g) ⁻¹' {g : G | PadicInt.toZModPow k (χ g) = 0} := by
    simp only [Set.mem_preimage, Set.mem_setOf_eq, inv_mul_cancel, h1, map_zero]
  filter_upwards [hV.mem_nhds hmem] with g hg
  simp only [Set.mem_preimage, Set.mem_setOf_eq] at hg
  have hdiff : χ g - χ g₀ = χ (g₀⁻¹ * g) := by
    have := hχ g₀ (g₀⁻¹ * g)
    rw [mul_inv_cancel_left] at this
    rw [this]; ring
  have hker : χ (g₀⁻¹ * g) ∈ Ideal.span {(p : ℤ_[p]) ^ k} := by
    rw [← PadicInt.ker_toZModPow]; exact RingHom.mem_ker.mpr hg
  have hn := (PadicInt.norm_le_pow_iff_mem_span_pow _ k).mpr hker
  rw [dist_eq_norm, hdiff]
  exact lt_of_le_of_lt hn hk

theorem wc_kummer_hilbert90_hom (K : Type u) [Field K]
    (c : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → Kˣ)
    (hc : ∀ g h, c (g * h) = c g * c h) (hopen : IsOpen {g | c g = 1}) :
    ∃ b : SeparableClosure K, b ≠ 0 ∧
      ∀ g, g b = algebraMap K (SeparableClosure K) (c g : K) * b :=
by
  classical

  have h90 : ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
      (c' : (L ≃ₐ[K] L) → Kˣ), (∀ σ τ, c' (σ * τ) = c' σ * c' τ) →
      ∃ x : L, x ≠ 0 ∧ ∀ σ : L ≃ₐ[K] L, σ x = algebraMap K L (c' σ : K) * x := by
    intro L _ _ _ c' hc'mul
    let f : (L ≃ₐ[K] L) → Lˣ := fun σ => Units.map (algebraMap K L : K →* L) (c' σ)
    have hfval : ∀ σ, ((f σ : Lˣ) : L) = algebraMap K L (c' σ : K) := fun σ => rfl
    have hcoc : groupCohomology.IsMulCocycle₁ f := by
      intro σ τ
      apply Units.ext
      show algebraMap K L (c' (σ * τ) : K) =
          σ (algebraMap K L (c' τ : K)) * algebraMap K L (c' σ : K)
      rw [AlgEquiv.commutes, hc'mul, Units.val_mul, map_mul, mul_comm]
    obtain ⟨y, hy⟩ := groupCohomology.isMulCoboundary₁_of_isMulCocycle₁_of_aut_to_units f hcoc
    refine ⟨(y : L), y.ne_zero, ?_⟩
    intro σ
    have h := hy σ
    rw [div_eq_iff_eq_mul] at h
    have h2 := congrArg Units.val h
    rw [Units.val_mul, hfval] at h2
    exact h2
  have hc1 : c 1 = 1 := by
    have h := hc 1 1
    rw [mul_one] at h
    exact (mul_eq_left.mp h.symm)
  have hnhds : {g | c g = 1} ∈ nhds (1 : SeparableClosure K ≃ₐ[K] SeparableClosure K) :=
    hopen.mem_nhds hc1
  obtain ⟨E, hfd, hnorm, hsub⟩ := (krullTopology_mem_nhds_one_iff_of_normal K
    (SeparableClosure K) _).mp hnhds
  have : FiniteDimensional K E := hfd
  have : Normal K E := hnorm
  let r := AlgEquiv.restrictNormalHom (F := K) (K₁ := SeparableClosure K) E
  have hrapp : ∀ (τ : SeparableClosure K ≃ₐ[K] SeparableClosure K) (x : E),
      ((r τ x : E) : SeparableClosure K) = τ (x : SeparableClosure K) :=
    fun τ x => AlgEquiv.restrictNormalHom_apply E τ x
  have hsurj : Function.Surjective r := AlgEquiv.restrictNormalHom_surjective (SeparableClosure K)
  have key : ∀ g g', r g = r g' → c g = c g' := by
    intro g g' hgg
    have hτ : r (g⁻¹ * g') = 1 := by rw [map_mul, map_inv, hgg, inv_mul_cancel]
    have hfix : g⁻¹ * g' ∈ E.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have h0 := hrapp (g⁻¹ * g') ⟨x, hx⟩
      rw [hτ] at h0
      exact h0.symm
    have h1 : c (g⁻¹ * g') = 1 := hsub hfix
    have h2 : g' = g * (g⁻¹ * g') := by rw [mul_inv_cancel_left]
    rw [h2, hc, h1, mul_one]
  let s := Function.surjInv hsurj
  have hrs : ∀ σ, r (s σ) = σ := Function.surjInv_eq hsurj
  let c' : (E ≃ₐ[K] E) → Kˣ := fun σ => c (s σ)
  have hfac : ∀ g, c g = c' (r g) := fun g => key _ _ (hrs (r g)).symm
  have hc'mul : ∀ σ τ, c' (σ * τ) = c' σ * c' τ := by
    intro σ τ
    show c (s (σ * τ)) = c (s σ) * c (s τ)
    rw [← hc]
    apply key
    rw [hrs, map_mul, hrs, hrs]
  obtain ⟨x, hx0, hx⟩ := h90 E c' hc'mul
  refine ⟨(x : SeparableClosure K), ?_, ?_⟩
  · intro h0
    exact hx0 (by exact_mod_cast h0)
  · intro g
    rw [← hrapp g x, hx, hfac g]
    simp

theorem wc_kummer_modN_rigidity (K : Type u) [Field K] (N : ℕ) [NeZero N] (ζ ϖ : K)
    (hζ : IsPrimitiveRoot ζ N)
    (hK2 : ∀ x : K, x ≠ 0 → ∃ (k : ℤ) (y : K), y ≠ 0 ∧ x = ϖ ^ k * y ^ N)
    (α : SeparableClosure K) (hα0 : α ≠ 0) (hα : α ^ N = algebraMap K (SeparableClosure K) ϖ)
    (χ0 φ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → ZMod N)
    (hχ0 : ∀ g, g α = algebraMap K (SeparableClosure K) ζ ^ (χ0 g).val * α)
    (b : SeparableClosure K) (hb0 : b ≠ 0)
    (hb : ∀ g, g b = algebraMap K (SeparableClosure K) ζ ^ (φ g).val * b) :
    ∃ k : ZMod N, ∀ g, φ g = k * χ0 g :=
by
  have hN : N ≠ 0 := NeZero.ne N
  have hζ' : IsPrimitiveRoot (algebraMap K (SeparableClosure K) ζ) N :=
    hζ.map_of_injective (algebraMap K (SeparableClosure K)).injective
  have hζ'0 : algebraMap K (SeparableClosure K) ζ ≠ 0 := hζ'.ne_zero hN
  have hfix : ∀ g : SeparableClosure K ≃ₐ[K] SeparableClosure K, g (b ^ N) = b ^ N := by
    intro g
    rw [map_pow, hb g, mul_pow, ← pow_mul, mul_comm (φ g).val N, pow_mul, hζ'.pow_eq_one,
      one_pow, one_mul]
  have hbot : b ^ N ∈ (⊥ : IntermediateField K (SeparableClosure K)) :=
    (InfiniteGalois.mem_bot_iff_fixed (b ^ N)).mpr hfix
  obtain ⟨x, hx⟩ := IntermediateField.mem_bot.mp hbot
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [map_zero] at hx
    exact hb0 ((pow_eq_zero_iff hN).mp hx.symm)
  obtain ⟨k, y, hy0, hxy⟩ := hK2 x hx0
  have hιy : algebraMap K (SeparableClosure K) y ≠ 0 :=
    (map_ne_zero (algebraMap K (SeparableClosure K))).mpr hy0
  have hD0 : α ^ k * algebraMap K (SeparableClosure K) y ≠ 0 :=
    mul_ne_zero (zpow_ne_zero k hα0) hιy
  have hbN : b ^ N = (α ^ k * algebraMap K (SeparableClosure K) y) ^ N := by
    rw [← hx, hxy, map_mul, map_zpow₀, map_pow, ← hα, mul_pow]
    congr 1
    rw [← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, mul_comm]
  have hw : (b / (α ^ k * algebraMap K (SeparableClosure K) y)) ^ N = 1 := by
    rw [div_pow, hbN, div_self (pow_ne_zero N hD0)]
  obtain ⟨j, -, hj⟩ := hζ'.eq_pow_of_pow_eq_one hw
  have hbdec : b = algebraMap K (SeparableClosure K) ζ ^ j *
      (α ^ k * algebraMap K (SeparableClosure K) y) := by
    rw [hj, div_mul_cancel₀ b hD0]
  refine ⟨(k : ZMod N), fun g => ?_⟩
  have hgb : g b = (algebraMap K (SeparableClosure K) ζ ^ (χ0 g).val) ^ k * b := by
    conv_lhs => rw [hbdec]
    rw [map_mul, map_mul, map_pow, map_zpow₀, hχ0 g, AlgEquiv.commutes, AlgEquiv.commutes,
      mul_zpow]
    conv_rhs => rw [hbdec]
    ring
  have heq : algebraMap K (SeparableClosure K) ζ ^ (φ g).val =
      (algebraMap K (SeparableClosure K) ζ ^ (χ0 g).val) ^ k := by
    apply mul_right_cancel₀ hb0
    rw [← hb g, hgb]
  have h1 : algebraMap K (SeparableClosure K) ζ ^ (((φ g).val : ℤ) - ((χ0 g).val : ℤ) * k) = 1 := by
    rw [zpow_sub₀ hζ'0, zpow_mul, zpow_natCast, zpow_natCast, heq,
      div_self (zpow_ne_zero _ (pow_ne_zero _ hζ'0))]
  have h2 := (hζ'.zpow_eq_one_iff_dvd _).mp h1
  have h3 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ N).mpr h2
  push_cast at h3
  rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, sub_eq_zero] at h3
  rw [h3, mul_comm]

theorem wc_kummer_frobenius_level (K : Type u) [Field K] (N q : ℕ) [NeZero N] (ζ ϖ : K)
    (hζ : IsPrimitiveRoot ζ N) (ρK : K ≃+* K) (hρϖ : ρK ϖ = ϖ) (hρζ : (ρK ζ) ^ q = ζ)
    (α : SeparableClosure K) (hα0 : α ≠ 0) (hα : α ^ N = algebraMap K (SeparableClosure K) ϖ)
    (ρL : SeparableClosure K ≃+* SeparableClosure K)
    (hρL : ∀ x : K, ρL (algebraMap K _ x) = algebraMap K _ (ρK x))
    (γ γ' : SeparableClosure K ≃ₐ[K] SeparableClosure K) (hγγ' : ∀ z, ρL (γ' z) = γ (ρL z))
    (hγ : γ α = algebraMap K _ ζ * α) (c : ℕ) (hc : γ' α = algebraMap K _ ζ ^ c * α) :
    (c : ZMod N) = (q : ZMod N) :=
by
  have hιinj : Function.Injective (algebraMap K (SeparableClosure K)) :=
    (algebraMap K (SeparableClosure K)).injective
  have hβ0 : ρL α ≠ 0 := by
    intro h
    apply hα0
    exact ρL.injective (h.trans (map_zero ρL).symm)
  have hβN : (ρL α) ^ N = α ^ N := by
    rw [← map_pow, hα, hρL, hρϖ]
  have hζL : IsPrimitiveRoot (algebraMap K (SeparableClosure K) ζ) N :=
    hζ.map_of_injective hιinj
  have hη : IsPrimitiveRoot (ρK ζ) N := hζ.map_of_injective ρK.injective
  have hαN0 : α ^ N ≠ 0 := pow_ne_zero _ hα0
  have hu : (ρL α / α) ^ N = 1 := by rw [div_pow, hβN, div_self hαN0]
  obtain ⟨k, -, hk⟩ := hζL.eq_pow_of_pow_eq_one hu
  have hβk : ρL α = algebraMap K (SeparableClosure K) ζ ^ k * α := by
    rw [hk, div_mul_cancel₀ _ hα0]
  have hγβ : γ (ρL α) = algebraMap K (SeparableClosure K) ζ * ρL α := by
    rw [hβk, map_mul, map_pow, AlgEquiv.commutes, hγ]
    ring
  have hs5 : ρL (γ' α) = algebraMap K (SeparableClosure K) (ρK ζ) ^ c * ρL α := by
    rw [hc, map_mul, map_pow, hρL]
  have hs6 : ρK ζ ^ c = ζ := by
    have h1 : algebraMap K (SeparableClosure K) (ρK ζ) ^ c * ρL α =
        algebraMap K (SeparableClosure K) ζ * ρL α := by
      rw [← hs5, ← hγβ, hγγ']
    have h2 := mul_right_cancel₀ hβ0 h1
    apply hιinj
    rw [map_pow]
    exact h2
  have h7 : ρK ζ ^ c = ρK ζ ^ q := by rw [hs6, hρζ]
  have hfin : IsOfFinOrder (ρK ζ) :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨N, Nat.pos_of_ne_zero (NeZero.ne N), hη.pow_eq_one⟩
  have hmod := (IsOfFinOrder.pow_eq_pow_iff_modEq hfin).mp h7
  rw [← hη.eq_orderOf] at hmod
  exact (ZMod.natCast_eq_natCast_iff c q N).mpr hmod

theorem wc_ladic_rigidity {G : Type*} [Group G] [TopologicalSpace G] [CompactSpace G]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (γ : G)
    (hmod : ∀ (m : ℕ) (φ : G → ZMod (ℓ ^ m)), (∀ g h, φ (g * h) = φ g + φ h) →
      IsOpen {g | φ g = 0} → φ γ = 0 → ∀ g, φ g = 0)
    (ψ : G → ℚ_[ℓ]) (hψc : Continuous ψ) (hψ : ∀ g h, ψ (g * h) = ψ g + ψ h)
    (hψγ : ψ γ = 0) : ∀ g, ψ g = 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  obtain ⟨C, hC⟩ := (isCompact_univ (X := G)).exists_bound_of_continuousOn hψc.continuousOn
  have h1 : (1 : ℝ) < ℓ := by exact_mod_cast hℓp.one_lt
  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt C h1
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) ^ N := by positivity
  have hbd : ∀ g, ‖(ℓ : ℚ_[ℓ]) ^ N * ψ g‖ ≤ 1 := by
    intro g
    rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
    have := hC g (Set.mem_univ g)
    rw [inv_mul_le_iff₀ hℓpos]
    linarith
  let χ : G → ℤ_[ℓ] := fun g => ⟨(ℓ : ℚ_[ℓ]) ^ N * ψ g, hbd g⟩
  have hχc : Continuous χ := (continuous_const.mul hψc).subtype_mk _
  have hχ : ∀ g h, χ (g * h) = χ g + χ h := by
    intro g h
    apply Subtype.ext
    show (ℓ : ℚ_[ℓ]) ^ N * ψ (g * h) = (ℓ : ℚ_[ℓ]) ^ N * ψ g + (ℓ : ℚ_[ℓ]) ^ N * ψ h
    rw [hψ, mul_add]
  have hχγ : χ γ = 0 := by
    apply Subtype.ext
    show (ℓ : ℚ_[ℓ]) ^ N * ψ γ = 0
    rw [hψγ, mul_zero]
  have hχ0 : ∀ g, χ g = 0 := by
    intro g
    apply PadicInt.ext_of_toZModPow.mp
    intro m
    rw [map_zero]
    let φ : G → ZMod (ℓ ^ m) := fun g => PadicInt.toZModPow m (χ g)
    have hset : {g | φ g = 0} = {g | ‖χ g‖ < (ℓ : ℝ) ^ (-(m : ℤ) + 1)} := by
      ext x
      simp only [Set.mem_setOf_eq, φ]
      rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, ← PadicInt.norm_le_pow_iff_mem_span_pow,
        PadicInt.norm_le_pow_iff_norm_lt_pow_add_one]
    refine hmod m φ ?_ ?_ ?_ g
    · intro g h
      simp only [φ, hχ, map_add]
    · rw [hset]
      exact isOpen_lt (continuous_norm.comp hχc) continuous_const
    · simp only [φ, hχγ, map_zero]
  intro g
  have h : (ℓ : ℚ_[ℓ]) ^ N * ψ g = 0 :=
    congrArg (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) (hχ0 g)
  have hne : (ℓ : ℚ_[ℓ]) ^ N ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓp.ne_zero)
  exact (mul_eq_zero.mp h).resolve_left hne

theorem wc_kummer_ladic_galois (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (ϖ : K) (ρK : K ≃+* K) (hℓK : ((ℓ : ℕ) : K) ≠ 0) (hϖ : ϖ ≠ 0) (hρϖ : ρK ϖ = ϖ)
    (hK1 : ∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m)
    (hK2 : ∀ m : ℕ, ∀ x : K, x ≠ 0 → ∃ (k : ℤ) (y : K), y ≠ 0 ∧ x = ϖ ^ k * y ^ (ℓ ^ m))
    (hK3 : ∀ m : ℕ, ∀ k : ℤ, (∃ y : K, ϖ ^ k = y ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k)
    (hρζ : ∀ m : ℕ, ∀ ζ : K, ζ ^ (ℓ ^ m) = 1 → (ρK ζ) ^ q = ζ) (r : ℕ) :
    ∃ γ : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      (∀ f : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Fin r → ℚ_[ℓ]),
        Continuous f → (∀ g h, f (g * h) = f g + f h) → f γ = 0 → f = 0) ∧
      (∀ v : Fin r → ℚ_[ℓ], ∃ f : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Fin r → ℚ_[ℓ]),
        Continuous f ∧ (∀ g h, f (g * h) = f g + f h) ∧ f γ = v) ∧
      ∀ (ρL : SeparableClosure K ≃+* SeparableClosure K),
        (∀ x : K, ρL (algebraMap K (SeparableClosure K) x) =
          algebraMap K (SeparableClosure K) (ρK x)) →
        ∀ γ' : SeparableClosure K ≃ₐ[K] SeparableClosure K, (∀ z, ρL (γ' z) = γ (ρL z)) →
        ∀ f : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → (Fin r → ℚ_[ℓ]),
          Continuous f → (∀ g h, f (g * h) = f g + f h) → f γ' = (q : ℚ_[ℓ]) • f γ :=
by
  classical

  have hι : Function.Injective (algebraMap K (SeparableClosure K)) :=
    (algebraMap K (SeparableClosure K)).injective
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  haveI hℓL : NeZero ((ℓ : ℕ) : SeparableClosure K) := ⟨by
    rw [← map_natCast (algebraMap K (SeparableClosure K))]
    exact (map_ne_zero _).mpr hℓK⟩
  haveI hNZ : ∀ m : ℕ, NeZero (ℓ ^ m) := fun m => ⟨(pow_pos hℓpos m).ne'⟩
  obtain ⟨ζ, hζ, hζc⟩ := wc_kummer_compatible_roots K ℓ hK1
  choose rt hrt using fun a : SeparableClosure K => IsSepClosed.exists_pow_nat_eq a ℓ
  set α : ℕ → SeparableClosure K := fun m => rt^[m] (algebraMap K (SeparableClosure K) ϖ)
    with hαdef
  have hα0 : α 0 = algebraMap K (SeparableClosure K) ϖ := rfl
  have hαc : ∀ m, α (m + 1) ^ ℓ = α m := by
    intro m
    show (rt^[m + 1] (algebraMap K (SeparableClosure K) ϖ)) ^ ℓ =
      rt^[m] (algebraMap K (SeparableClosure K) ϖ)
    rw [Function.iterate_succ_apply', hrt]
  have hαpow : ∀ m, α m ^ (ℓ ^ m) = algebraMap K (SeparableClosure K) ϖ := by
    intro m
    induction m with
    | zero => rw [pow_zero, pow_one, hα0]
    | succ m ih => rw [pow_succ' ℓ m, pow_mul, hαc, ih]
  have hαne : ∀ m, α m ≠ 0 := by
    intro m h
    have h1 := hαpow m
    rw [h, zero_pow (pow_pos hℓpos m).ne'] at h1
    exact hϖ (hι (by rw [← h1, map_zero]))

  have hlev : ∀ m, ∃ χ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → ZMod (ℓ ^ m),
      (∀ g, g (α m) = algebraMap K (SeparableClosure K) (ζ m) ^ (χ g).val * α m) ∧
      (∀ g h, χ (g * h) = χ g + χ h) ∧
      ∀ (g : SeparableClosure K ≃ₐ[K] SeparableClosure K) (v : ℕ),
        g (α m) = algebraMap K (SeparableClosure K) (ζ m) ^ v * α m →
          χ g = (v : ZMod (ℓ ^ m)) :=
    fun m => wc_kummer_level_char K (ℓ ^ m) (ζ m) (hζ m) (α m) (hαne m) ⟨ϖ, hαpow m⟩
  choose χm hχm hχadd hχuniq using hlev
  have hcompat : ∀ (g : SeparableClosure K ≃ₐ[K] SeparableClosure K) (m : ℕ),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) (χm (m + 1) g) = χm m g := by
    intro g m
    have h1 : g (α m) =
        algebraMap K (SeparableClosure K) (ζ m) ^ (χm (m + 1) g).val * α m := by
      rw [← hαc m, map_pow, hχm (m + 1) g, mul_pow, ← pow_mul,
        mul_comm (χm (m + 1) g).val ℓ, pow_mul,
        ← map_pow (algebraMap K (SeparableClosure K)) (ζ (m + 1)) ℓ, hζc m]
    rw [hχuniq m g _ h1]
    conv_lhs => rw [← ZMod.natCast_zmod_val (χm (m + 1) g)]
    exact map_natCast _ _
  have hker : ∀ (m : ℕ) (g : SeparableClosure K ≃ₐ[K] SeparableClosure K),
      χm m g = 0 ↔ g (α m) = α m := by
    intro m g
    constructor
    · intro h
      rw [hχm m g, h, ZMod.val_zero, pow_zero, one_mul]
    · intro h
      have h2 := hχuniq m g 0 (by rw [pow_zero, one_mul]; exact h)
      rw [h2, Nat.cast_zero]

  have hχex : ∀ g : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      ∃ z : ℤ_[ℓ], ∀ m, PadicInt.toZModPow m z = χm m g :=
    fun g => wc_padicInt_of_compatible ℓ (fun m => χm m g) (fun m => hcompat g m)
  choose χ hχ using hχex
  have hχhom : ∀ g h, χ (g * h) = χ g + χ h := by
    intro g h
    apply PadicInt.ext_of_toZModPow.mp
    intro m
    rw [map_add, hχ, hχ, hχ, hχadd]
  have hχcont : Continuous χ := by
    apply wc_padicInt_hom_continuous ℓ χ hχhom
    intro m
    haveI : FiniteDimensional K (IntermediateField.adjoin K {α m}) :=
      IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (α m))
    have hfix : IsOpen ((IntermediateField.adjoin K {α m}).fixingSubgroup :
        Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) :=
      IntermediateField.fixingSubgroup_isOpen _
    have hle : (IntermediateField.adjoin K {α m}).fixingSubgroup ≤
        MulAction.stabilizer (SeparableClosure K ≃ₐ[K] SeparableClosure K) (α m) := by
      intro g hg
      rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hg (α m)
        (IntermediateField.mem_adjoin_simple_self K (α m))
    have hopen := Subgroup.isOpen_mono hle hfix
    convert hopen using 1
    ext g
    rw [Set.mem_setOf_eq, SetLike.mem_coe, MulAction.mem_stabilizer_iff, AlgEquiv.smul_def,
      hχ, hker]

  have hnot : ¬ ∃ y : K, ϖ = y ^ ℓ := by
    rintro ⟨y, hy⟩
    have h := hK3 1 1 ⟨y, by rw [zpow_one, pow_one, hy]⟩
    rw [pow_one] at h
    have h2 : (ℓ : ℤ) = 1 := Int.eq_one_of_dvd_one (by positivity) h
    have h3 : ℓ = 1 := by exact_mod_cast h2
    exact (Fact.out : Nat.Prime ℓ).one_lt.ne' h3
  obtain ⟨γ, hγ⟩ := wc_kummer_generator_exists K ℓ ϖ hnot ζ hζ hζc α hα0 hαc χm hχm hχadd
  have hχmγ : ∀ m, χm m γ = 1 := by
    intro m
    have h := hχuniq m γ 1 (by rw [pow_one]; exact hγ m)
    rw [h, Nat.cast_one]
  have hχγ : χ γ = 1 := by
    apply PadicInt.ext_of_toZModPow.mp
    intro m
    rw [hχ, hχmγ, map_one]

  have hmod : ∀ (m : ℕ) (φ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → ZMod (ℓ ^ m)),
      (∀ g h, φ (g * h) = φ g + φ h) → IsOpen {g | φ g = 0} → φ γ = 0 → ∀ g, φ g = 0 := by
    intro m φ hφ hφo hφγ
    have hζne : ζ m ≠ 0 := by
      intro h0
      have h1 := (hζ m).pow_eq_one
      rw [h0, zero_pow (pow_pos hℓpos m).ne'] at h1
      exact zero_ne_one h1
    obtain ⟨u, huval⟩ := isUnit_iff_ne_zero.mpr hζne
    have hupow : ∀ n : ℕ, u ^ n = 1 ↔ ℓ ^ m ∣ n := by
      intro n
      rw [← Units.val_eq_one, Units.val_pow_eq_pow_val, huval]
      exact (hζ m).pow_eq_one_iff_dvd n
    let c : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → Kˣ := fun g => u ^ (φ g).val
    have hc : ∀ g h, c (g * h) = c g * c h := by
      intro g h
      show u ^ (φ (g * h)).val = u ^ (φ g).val * u ^ (φ h).val
      rw [hφ, ZMod.val_add, ← pow_add]
      conv_rhs => rw [← Nat.mod_add_div ((φ g).val + (φ h).val) (ℓ ^ m)]
      rw [pow_add, pow_mul, (hupow (ℓ ^ m)).mpr dvd_rfl, one_pow, mul_one]
    have hcker : {g | c g = 1} = {g | φ g = 0} := by
      ext g
      show u ^ (φ g).val = 1 ↔ φ g = 0
      rw [hupow, ← ZMod.val_eq_zero]
      constructor
      · intro h
        exact Nat.eq_zero_of_dvd_of_lt h (ZMod.val_lt _)
      · intro h
        rw [h]
        exact dvd_zero _
    have hco : IsOpen {g | c g = 1} := by rw [hcker]; exact hφo
    obtain ⟨b, hb0, hb⟩ := wc_kummer_hilbert90_hom K c hc hco
    have hb' : ∀ g : SeparableClosure K ≃ₐ[K] SeparableClosure K,
        g b = algebraMap K (SeparableClosure K) (ζ m) ^ (φ g).val * b := by
      intro g
      rw [hb g]
      show algebraMap K _ ((u ^ (φ g).val : Kˣ) : K) * b = _
      rw [Units.val_pow_eq_pow_val, huval, map_pow]
    obtain ⟨k, hk⟩ := wc_kummer_modN_rigidity K (ℓ ^ m) (ζ m) ϖ (hζ m) (hK2 m) (α m) (hαne m)
      (hαpow m) (χm m) φ (hχm m) b hb0 hb'
    have hk0 : k = 0 := by
      have h := hk γ
      rw [hφγ, hχmγ, mul_one] at h
      exact h.symm
    intro g
    rw [hk g, hk0, zero_mul]

  have hcoe : Continuous (fun g => ((χ g : ℤ_[ℓ]) : ℚ_[ℓ])) :=
    continuous_subtype_val.comp hχcont
  have hrig : ∀ ψ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → ℚ_[ℓ], Continuous ψ →
      (∀ g h, ψ (g * h) = ψ g + ψ h) → ∀ g, ψ g = ψ γ * ((χ g : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro ψ hψc hψ g
    have h := wc_ladic_rigidity ℓ γ hmod (fun g => ψ g - ψ γ * ((χ g : ℤ_[ℓ]) : ℚ_[ℓ]))
      (hψc.sub (continuous_const.mul hcoe))
      (by intro g h; simp only [hψ, hχhom, PadicInt.coe_add]; ring)
      (by simp only [hχγ, PadicInt.coe_one, mul_one, sub_self]) g
    exact sub_eq_zero.mp h

  have hfrob : ∀ (ρL : SeparableClosure K ≃+* SeparableClosure K),
      (∀ x : K, ρL (algebraMap K (SeparableClosure K) x) =
        algebraMap K (SeparableClosure K) (ρK x)) →
      ∀ γ' : SeparableClosure K ≃ₐ[K] SeparableClosure K, (∀ z, ρL (γ' z) = γ (ρL z)) →
      χ γ' = (q : ℤ_[ℓ]) := by
    intro ρL hρL γ' hγ'
    apply PadicInt.ext_of_toZModPow.mp
    intro m
    have h := wc_kummer_frobenius_level K (ℓ ^ m) q (ζ m) ϖ (hζ m) ρK hρϖ
      (hρζ m (ζ m) (hζ m).pow_eq_one) (α m) (hαne m) (hαpow m) ρL hρL γ γ' hγ' (hγ m)
      (χm m γ').val (hχm m γ')
    rw [hχ, map_natCast, ← h, ZMod.natCast_zmod_val]

  refine ⟨γ, ?_, ?_, ?_⟩
  · intro f hfc hf hfγ
    funext g i
    have h : f g i = f γ i * ((χ g : ℤ_[ℓ]) : ℚ_[ℓ]) :=
      hrig (fun g => f g i) ((continuous_apply i).comp hfc)
        (fun g h => congrFun (hf g h) i) g
    rw [h, hfγ]
    simp
  · intro v
    refine ⟨fun g => ((χ g : ℤ_[ℓ]) : ℚ_[ℓ]) • v, hcoe.smul continuous_const, ?_, ?_⟩
    · intro g h
      simp only [hχhom, PadicInt.coe_add, add_smul]
    · simp only [hχγ, PadicInt.coe_one, one_smul]
  · intro ρL hρL γ' hγ' f hfc hf
    have hq := hfrob ρL hρL γ' hγ'
    funext i
    have h : f γ' i = f γ i * ((χ γ' : ℤ_[ℓ]) : ℚ_[ℓ]) :=
      hrig (fun g => f g i) ((continuous_apply i).comp hfc)
        (fun g h => congrFun (hf g h) i) γ'
    rw [h, hq, PadicInt.coe_natCast, Pi.smul_apply, smul_eq_mul, mul_comm]

theorem wc_strict_trait_punct_H1_cyclic (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom u0) :
    ∃ κ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
        (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀))
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) 1,
      ∀ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
          (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀))
          (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) 1,
        ∃ a : ℚ_[ℓ], z = κ.comp (Abelian.Ext.mk₀ (wcContSheafMap (wcP1Over F'').left
          (DistribSMul.toAddMonoidHom ℚ_[ℓ] a) (continuous_const_smul a))) (add_zero 1) :=
by
  obtain ⟨K, _, iK, ϖ, hℓK, hϖ, hK1, hK2, hK3⟩ :=
    wc_strict_trait_punct_field_data F'' u0 hu0 ℓ hℓ V₀ A e ε hv hε
  obtain ⟨τ, hτs, hτT⟩ := wc_contSheaf_rank_one_over_triv (wcP1Over F'').left
    (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀) ℓ
  have h2 : Spec.map (CommRingCat.ofHom ((RingEquiv.refl K : K ≃+* K) : K →+* K)) = 𝟙 _ := by
    first
    | rw [RingEquiv.toRingHom_refl, CommRingCat.ofHom_id, Spec.map_id]
    | (rw [show ((RingEquiv.refl K : K ≃+* K) : K →+* K) = RingHom.id K from rfl,
        CommRingCat.ofHom_id, Spec.map_id])
    | simp
  have h3 : iK.inv ≫ 𝟙 _ ≫ iK.hom = 𝟙 _ := by rw [Category.id_comp, Iso.inv_hom_id]
  obtain ⟨ρL, Φ1, Φ0, -, hΦinj, hΦhom, hΦsurj, hΦsc, -, -, -⟩ :=
    wc_field_point_ext_galois ℓ (wcP1Over F'').left
      (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' u0) V₀) (𝟙 _) K iK (RingEquiv.refl K)
      (h3.trans h2.symm)
      (wcContSheaf (wcP1Over F'').left ℚ_[ℓ])
      (fun a => wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom ℚ_[ℓ] a)
        (continuous_const_smul a)) 1 LinearMap.id τ hτs hτT
  obtain ⟨γ, hγ0, hγv, -⟩ := wc_kummer_ladic_galois K ℓ 1 ϖ (RingEquiv.refl K) hℓK hϖ rfl
    hK1 hK2 hK3 (fun m ζ _ => pow_one ζ) 1
  obtain ⟨f₀, hf₀c, hf₀h, hf₀γ⟩ := hγv (fun _ => 1)
  obtain ⟨κ, hκ⟩ := hΦsurj f₀ hf₀c hf₀h
  refine ⟨κ, fun z => ⟨Φ1 z γ 0, ?_⟩⟩
  have hΦy : Φ1 (κ.comp (Abelian.Ext.mk₀ (wcContSheafMap (wcP1Over F'').left
      (DistribSMul.toAddMonoidHom ℚ_[ℓ] (Φ1 z γ 0)) (continuous_const_smul (Φ1 z γ 0))))
      (add_zero 1)) = Φ1 z γ 0 • f₀ := by
    have h := hΦsc (Φ1 z γ 0) κ
    rw [hκ] at h
    exact h
  have hd : Φ1 (z - κ.comp (Abelian.Ext.mk₀ (wcContSheafMap (wcP1Over F'').left
      (DistribSMul.toAddMonoidHom ℚ_[ℓ] (Φ1 z γ 0)) (continuous_const_smul (Φ1 z γ 0))))
      (add_zero 1)) = 0 := by
    obtain ⟨hdc, hdh⟩ := hΦhom (z - κ.comp (Abelian.Ext.mk₀ (wcContSheafMap (wcP1Over F'').left
      (DistribSMul.toAddMonoidHom ℚ_[ℓ] (Φ1 z γ 0)) (continuous_const_smul (Φ1 z γ 0))))
      (add_zero 1))
    apply hγ0 _ hdc hdh
    funext i
    rw [Fin.fin_one_eq_zero i, map_sub, hΦy]
    simp [hf₀γ]
  exact sub_eq_zero.mp (hΦinj (by rw [hd, map_zero]))

theorem wc_punct_frame_pkg_exists (F'' : Type u) [Field F''] [Finite F''] (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') (V₀ : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (e : V₀.left ≅ Spec (.of A)) (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F''))) (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F'')) (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) = Limits.pullback.snd V₀.hom u0) : ∃ Fr, wcPunctFramePkg F'' u0 V₀ ℓ Fr :=
by
  classical

  have key : ∀ (S : Scheme.{u}) {A B : Type} [AddCommGroup A] [TopologicalSpace A]
      [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) :
            _) := by
    intro S A B _ _ _ _ _ _ φ hφ U x
    rfl
  have haddG : ∀ (S : Scheme.{u}) {A B : Type} [AddCommGroup A] [TopologicalSpace A]
      [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ ψ χ : A →+ B) (hφ : Continuous φ) (hψ : Continuous ψ) (hχ : Continuous χ),
      (∀ a, χ a = φ a + ψ a) →
      wcContSheafMap S χ hχ = wcContSheafMap S φ hφ + wcContSheafMap S ψ hψ := by
    intro S A B _ _ _ _ _ _ φ ψ χ hφ hψ hχ hsum
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    exact hsum _
  have hcompG : ∀ (S : Scheme.{u}) {A B C : Type} [AddCommGroup A] [TopologicalSpace A]
      [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C]
      (φ : A →+ B) (ψ : B →+ C) (χ : A →+ C) (hφ : Continuous φ)
      (hψ : Continuous ψ) (hχ : Continuous χ), (∀ a, ψ (φ a) = χ a) →
      wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ = wcContSheafMap S χ hχ := by
    intro S A B C _ _ _ _ _ _ _ _ _ φ ψ χ hφ hψ hχ h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    exact h _
  have hidG : ∀ (S : Scheme.{u}) {A : Type} [AddCommGroup A] [TopologicalSpace A]
      [IsTopologicalAddGroup A] (χ : A →+ A) (hχ : Continuous χ), (∀ a, χ a = a) →
      wcContSheafMap S χ hχ = 𝟙 _ := by
    intro S A _ _ _ χ hχ h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    exact h _
  have hsumG : ∀ (S : Scheme.{u}) {A B : Type} [AddCommGroup A] [TopologicalSpace A]
      [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      {ι : Type} [Fintype ι] (f : ι → (A →+ B)) (hf : ∀ i, Continuous (f i))
      (χ : A →+ B) (hχ : Continuous χ), (∀ a, χ a = ∑ i, f i a) →
      wcContSheafMap S χ hχ = ∑ i, wcContSheafMap S (f i) (hf i) := by
    intro S A B _ _ _ _ _ _ ι _ f hf χ hχ h
    suffices H : ∀ s : Finset ι, ∀ (χ : A →+ B) (hχ : Continuous χ),
        (∀ a, χ a = ∑ i ∈ s, f i a) →
          wcContSheafMap S χ hχ = ∑ i ∈ s, wcContSheafMap S (f i) (hf i) from
      H Finset.univ χ hχ h
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro χ hχ h
      rw [Finset.sum_empty]
      have h2 := haddG S χ χ χ hχ hχ hχ (fun a => by rw [h a, Finset.sum_empty, add_zero])
      exact add_left_cancel (h2.symm.trans (add_zero _).symm)
    | insert a s ha ih =>
      intro χ hχ h
      rw [Finset.sum_insert ha]
      have hψ : Continuous ⇑(∑ i ∈ s, f i) := by
        have e : ⇑(∑ i ∈ s, f i) = fun x => ∑ i ∈ s, f i x :=
          funext fun x => AddMonoidHom.finset_sum_apply _ _ _
        rw [e]
        exact continuous_finset_sum _ (fun i _ => hf i)
      rw [haddG S (f a) (∑ i ∈ s, f i) χ (hf a) hψ hχ
        (fun x => by rw [h x, Finset.sum_insert ha, AddMonoidHom.finset_sum_apply]),
        ih _ hψ (fun x => AddMonoidHom.finset_sum_apply _ _ _)]

  have s3 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (k : ℕ)
      (κ : Abelian.Ext P (wcContSheaf S ℚ_[ℓ]) 1),
      (∀ z : Abelian.Ext P (wcContSheaf S ℚ_[ℓ]) 1, ∃ a : ℚ_[ℓ],
        z = κ.comp (Abelian.Ext.mk₀ (wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] a)
          (continuous_const_smul a))) (add_zero 1)) →
      ∀ x : Abelian.Ext P (wcContSheaf S (Fin k → ℚ_[ℓ])) 1, ∃ v : Fin k → ℚ_[ℓ],
        x = κ.comp (Abelian.Ext.mk₀ (wcContSheafMap S
          (LinearMap.toSpanSingleton ℚ_[ℓ] (Fin k → ℚ_[ℓ]) v).toAddMonoidHom
          (LinearMap.continuous_of_finiteDimensional _))) (add_zero 1) := by
    intro S P k κ hκ x
    have hCa : ∀ {X Y Z T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
        (w : Abelian.Ext X Y 1) (a : Y ⟶ Z) (b : Z ⟶ T),
        (w.comp (Abelian.Ext.mk₀ a) (add_zero 1)).comp (Abelian.Ext.mk₀ b) (add_zero 1) =
          w.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero 1) := by
      intro X Y Z T w a b
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    obtain ⟨π, hπ⟩ : ∃ π : Fin k → (wcContSheaf S (Fin k → ℚ_[ℓ]) ⟶ wcContSheaf S ℚ_[ℓ]),
        ∀ j, π j = wcContSheafMap S (Pi.evalAddMonoidHom (fun _ : Fin k => ℚ_[ℓ]) j)
          (continuous_apply j) :=
      ⟨fun j => wcContSheafMap S (Pi.evalAddMonoidHom (fun _ : Fin k => ℚ_[ℓ]) j)
          (continuous_apply j), fun j => rfl⟩
    have hsing : ∀ j : Fin k, Continuous ⇑(AddMonoidHom.single (fun _ : Fin k => ℚ_[ℓ]) j) :=
      fun j => by
        have h := continuous_single (A := fun _ : Fin k => ℚ_[ℓ]) j
        exact h
    obtain ⟨ι, hι⟩ : ∃ ι : Fin k → (wcContSheaf S ℚ_[ℓ] ⟶ wcContSheaf S (Fin k → ℚ_[ℓ])),
        ∀ j, ι j = wcContSheafMap S (AddMonoidHom.single (fun _ : Fin k => ℚ_[ℓ]) j)
          (hsing j) :=
      ⟨fun j => wcContSheafMap S (AddMonoidHom.single (fun _ : Fin k => ℚ_[ℓ]) j)
          (hsing j), fun j => rfl⟩
    have I1 : (𝟙 (wcContSheaf S (Fin k → ℚ_[ℓ]))) = ∑ j : Fin k, π j ≫ ι j := by
      rw [← hidG S (AddMonoidHom.id (Fin k → ℚ_[ℓ])) continuous_id (fun _ => rfl),
        hsumG S (fun j : Fin k => (AddMonoidHom.single (fun _ : Fin k => ℚ_[ℓ]) j).comp
            (Pi.evalAddMonoidHom (fun _ : Fin k => ℚ_[ℓ]) j))
          (fun j => (hsing j).comp (continuous_apply j)) (AddMonoidHom.id _)
          continuous_id (fun w => by
            simp only [AddMonoidHom.id_apply, AddMonoidHom.comp_apply,
              Pi.evalAddMonoidHom_apply, AddMonoidHom.single_apply]
            exact (Finset.univ_sum_single w).symm)]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hπ, hι]
      exact (hcompG S _ _ _ _ _ _ (fun _ => rfl)).symm
