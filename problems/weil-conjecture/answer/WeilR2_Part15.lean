    exact ⟨E1.trans (E2.trans E3)⟩
  obtain ⟨Ec⟩ := cosp (Limits.pullback g a) (Limits.pullback.snd g a) hfs
    (AlgebraicClosure (S.residueField (genericPoint S))) ζ

  exact Nat.card_congr ((Es.symm.trans Ec).trans Eg.symm)

theorem wc_pencil_bar_smooth_off (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ W : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens,
      Smooth (Limits.pullback.snd D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom ∣_ W) ∧
      ∀ y : (wcGeomPoint F'' (wcP1Over F'') hP).left, y ∉ W →
        IsClosed ({y} : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) :=
by
  classical
  haveI hLS := HasRingHomProperty.instIsZariskiLocalAtSource
    (P := (@Smooth : MorphismProperty Scheme.{u}))
  haveI hLT := HasRingHomProperty.instIsZariskiLocalAtTarget (@Smooth : MorphismProperty Scheme.{u})

  have s1 : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (O : X.Opens),
      (∀ x ∈ O, ∃ V : X.Opens, x ∈ V ∧ Smooth (V.ι ≫ g)) → Smooth (O.ι ≫ g) := by
    intro X Y g O h
    have hmem : ∀ x : O.toScheme, O.ι x ∈ O := fun x => by
      have : O.ι x ∈ Set.range O.ι := ⟨x, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    choose V hxV hV using fun x : O.toScheme => h (O.ι x) (hmem x)
    refine IsZariskiLocalAtSource.of_iSup_eq_top (fun x : O.toScheme => O.ι ⁻¹ᵁ V x) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxV x⟩
    · intro x
      have hsub : Set.range ((O.ι ⁻¹ᵁ V x).ι ≫ O.ι) ⊆ Set.range (V x).ι := by
        rintro _ ⟨w, rfl⟩
        rw [Scheme.Opens.range_ι]
        have hw : (O.ι ⁻¹ᵁ V x).ι w ∈ O.ι ⁻¹ᵁ V x := by
          have h2 : (O.ι ⁻¹ᵁ V x).ι w ∈ Set.range (O.ι ⁻¹ᵁ V x).ι := ⟨w, rfl⟩
          rwa [Scheme.Opens.range_ι] at h2
        exact hw
      have hfac := IsOpenImmersion.lift_fac (V x).ι ((O.ι ⁻¹ᵁ V x).ι ≫ O.ι) hsub
      haveI : IsOpenImmersion (IsOpenImmersion.lift (V x).ι ((O.ι ⁻¹ᵁ V x).ι ≫ O.ι) hsub) := by
        haveI : IsOpenImmersion
            (IsOpenImmersion.lift (V x).ι ((O.ι ⁻¹ᵁ V x).ι ≫ O.ι) hsub ≫ (V x).ι) := by
          rw [hfac]; infer_instance
        exact IsOpenImmersion.of_comp _ (V x).ι
      have h3 := IsZariskiLocalAtSource.comp (hV x)
        (IsOpenImmersion.lift (V x).ι ((O.ι ⁻¹ᵁ V x).ι ≫ O.ι) hsub)
      rw [← Category.assoc, hfac, Category.assoc] at h3
      exact h3

  have s2 : ∀ {X S T : Scheme.{u}} (f : X ⟶ S) (π : T ⟶ S) (U : S.Opens),
      Smooth ((f ⁻¹ᵁ U).ι ≫ f) → Smooth (Limits.pullback.snd f π ∣_ (π ⁻¹ᵁ U)) := by
    intro X S T f π U hf
    have hsq := IsPullback.paste_vert
      (isPullback_morphismRestrict (Limits.pullback.fst f π) (f ⁻¹ᵁ U))
      (IsPullback.of_hasPullback f π)
    have hd : Smooth ((Limits.pullback.fst f π ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ Limits.pullback.snd f π) :=
      MorphismProperty.of_isPullback (P := @Smooth) hsq hf
    have hO : Limits.pullback.snd f π ⁻¹ᵁ (π ⁻¹ᵁ U) =
        Limits.pullback.fst f π ⁻¹ᵁ (f ⁻¹ᵁ U) := by
      ext z
      show π (Limits.pullback.snd f π z) ∈ U ↔ f (Limits.pullback.fst f π z) ∈ U
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    rw [← hO, ← morphismRestrict_ι] at hd
    exact IsZariskiLocalAtTarget.of_isPullback (iY := (π ⁻¹ᵁ U).ι) (iX := 𝟙 _)
      (IsPullback.of_horiz_isIso_mono (fst := 𝟙 _)
        (snd := Limits.pullback.snd f π ∣_ (π ⁻¹ᵁ U))
        (f := Limits.pullback.snd f π ∣_ (π ⁻¹ᵁ U) ≫ (π ⁻¹ᵁ U).ι)
        (g := (π ⁻¹ᵁ U).ι) ⟨by simp⟩) hd

  have s3a : ∀ (P B : Scheme.{u}) (p : P ⟶ B) [IsSeparated p] (s : B ⟶ P),
      s ≫ p = 𝟙 _ → IsClosed (Set.range s) := by
    intro P B p _ s hs
    haveI : IsProper (s ≫ p) := by rw [hs]; infer_instance
    haveI : IsProper s := IsProper.of_comp s p
    exact s.isClosedMap.isClosed_range

  have s3b : ∀ (P T B : Scheme.{u}) (p : P ⟶ B) [IsSeparated p] (a : T ⟶ B) [Subsingleton ↥T]
      (s : B ⟶ P), s ≫ p = 𝟙 _ → ∀ y : ↥(Limits.pullback p a : Scheme.{u}),
        Limits.pullback.fst p a y ∈ Set.range s →
          IsClosed ({y} : Set ↥(Limits.pullback p a : Scheme.{u})) := by
    intro P T B p _ a _ s hs y hy
    have hcl := s3a P B p s hs
    haveI : IsIso (s ≫ p) := by rw [hs]; infer_instance
    obtain ⟨φ, hφ⟩ : ∃ φ, φ = (Limits.pullbackRightPullbackFstIso p a s).hom ≫
        Limits.pullback.snd (s ≫ p) a := ⟨_, rfl⟩
    haveI : IsIso φ := by rw [hφ]; infer_instance
    haveI : Subsingleton ↥(Limits.pullback s (Limits.pullback.fst p a) : Scheme.{u}) :=
      φ.homeomorph.injective.subsingleton
    have hrange := Scheme.Pullback.range_snd s (Limits.pullback.fst p a)
    have hy' : y ∈ Set.range (Limits.pullback.snd s (Limits.pullback.fst p a)) := by
      rw [hrange]; exact hy
    have heq : Set.range (Limits.pullback.snd s (Limits.pullback.fst p a)) = {y} :=
      (Set.subsingleton_range _).eq_singleton_of_mem hy'
    rw [← heq, hrange]
    exact hcl.preimage (Limits.pullback.fst p a).continuous

  haveI hP1 : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (_ ≫ _)
    infer_instance
  obtain ⟨Zs, hZs⟩ : ∃ Zs : Set (wcP1Over F'').left, Zs = ⋃ i, Set.range (D.S i) := ⟨_, rfl⟩
  have hZc : IsClosed Zs := by
    rw [hZs]
    exact isClosed_iUnion_of_finite fun i =>
      s3a (wcP1Over F'').left (Spec (.of F'')) (wcP1Over F'').hom (D.S i) (D.hS i)
  obtain ⟨U, hU⟩ : ∃ U : (wcP1Over F'').left.Opens, U = ⟨Zsᶜ, hZc.isOpen_compl⟩ := ⟨_, rfl⟩
  have hmemU : ∀ z, z ∈ U ↔ z ∉ Zs := fun z => by rw [hU]; rfl
  refine ⟨(wcGeomPoint F'' (wcP1Over F'') hP).hom ⁻¹ᵁ U, ?_, ?_⟩
  · apply s2
    apply s1
    intro y hy
    apply D.smooth_off y
    intro i hyi
    have h1 : D.f y ∈ U := hy
    rw [hmemU] at h1
    apply h1
    rw [hZs]
    refine Set.mem_iUnion.mpr ⟨i, IsLocalRing.closedPoint F'', ?_⟩
    rw [hyi, ← D.hxs i]
    exact Scheme.Hom.comp_apply _ _ _
  · intro y hy
    have h1 : (wcGeomPoint F'' (wcP1Over F'') hP).hom y ∈ Zs := by
      by_contra hc
      exact hy ((hmemU _).mpr hc)
    rw [hZs, Set.mem_iUnion] at h1
    obtain ⟨i, hi⟩ := h1
    exact s3b (wcP1Over F'').left (Spec (.of (AlgebraicClosure F''))) (Spec (.of F''))
      (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      (D.S i) (D.hS i) y hi

theorem wc_dim_one_integral_specialization : ∀ (X : Scheme.{u}) [IsIntegral X], topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ¬ IsClosed ({genericPoint X} : Set X) ∧ ∀ η y : X, η ≠ genericPoint X → η ⤳ y → y = η :=
by
  intro X _ hdim
  have hdim' : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) = 1 := by
    have : topologicalKrullDim X = Order.krullDim (TopologicalSpace.IrreducibleCloseds X) := rfl
    rw [← this, hdim]; simp
  have h1le : 1 ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds X) := hdim'.ge
  have hle1 : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 1 := hdim'.le
  have hgen : IsGenericPoint (genericPoint X) (Set.univ : Set X) := genericPoint_spec X
  have hcl : closure ({genericPoint X} : Set X) = Set.univ := hgen
  let Z : X → TopologicalSpace.IrreducibleCloseds X := fun p =>
    ⟨closure {p}, isIrreducible_singleton.closure, isClosed_closure⟩
  let T : TopologicalSpace.IrreducibleCloseds X :=
    ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
  refine ⟨?_, ?_⟩
  · intro hc
    have hsing : ({genericPoint X} : Set X) = Set.univ := by
      rw [← hcl, hc.closure_eq]
    have hall : ∀ z : X, z = genericPoint X := by
      intro z
      have : z ∈ ({genericPoint X} : Set X) := by rw [hsing]; exact Set.mem_univ z
      exact Set.mem_singleton_iff.mp this
    obtain ⟨s, t, hst⟩ := Order.one_le_krullDim_iff.mp h1le
    obtain ⟨_, a, hat, has⟩ := SetLike.lt_iff_le_and_exists.mp hst
    obtain ⟨b, hb⟩ := s.isIrreducible.nonempty
    apply has
    rw [hall a, ← hall b]
    exact hb
  · intro η y hη hηy
    rcases Order.krullDim_le_one_iff.mp hle1 (Z η) with hmin | hmax
    · have hyle : Z y ≤ Z η := by
        show closure ({y} : Set X) ⊆ closure {η}
        exact specializes_iff_closure_subset.mp hηy
      have hle : Z η ≤ Z y := hmin hyle
      have hmem : η ∈ closure ({y} : Set X) := by
        have h' : closure ({η} : Set X) ⊆ closure {y} := hle
        exact h' (subset_closure (Set.mem_singleton η))
      have hyη : y ⤳ η := specializes_iff_mem_closure.mpr hmem
      exact (hyη.antisymm hηy).eq
    · exfalso
      have hZT : Z η ≤ T := by
        show closure ({η} : Set X) ⊆ Set.univ
        exact Set.subset_univ _
      have hTZ : T ≤ Z η := hmax hZT
      have huniv : closure ({η} : Set X) = Set.univ := by
        have h' : (Set.univ : Set X) ⊆ closure {η} := hTZ
        exact Set.eq_univ_of_univ_subset h'
      have hgη : IsGenericPoint η (Set.univ : Set X) := huniv
      exact hη (hgη.eq hgen)

theorem wc_pencil_Rq_torsion_ext2_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
