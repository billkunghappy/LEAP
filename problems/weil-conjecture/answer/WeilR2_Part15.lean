theorem wc_pencil_odp_shens_milnor_fibre_top_cyclic : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), Even n → 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ Nat.card F'' → ∀ (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left), wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a → ∀ (x : ↥(Limits.pullback D.f a)), Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'') → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x)) (Scheme.Etale.forget (Limits.pullback D.f a))) (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a), wcHalShData x B Λ' W'' φ' a' → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → IsAddCyclic (wcEtZModExt (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1)) :=
by
  intro F' F'' _ _ _ _ Y n hn hn2 D ℓ hℓ hℓF k i A _ _ _ Λ _ _ W' φ a hA x hx B _ _ _ Λ' _ _ W''
    φ' a' hB Ω _ _ ξ hξ
  classical
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓ⟩
  have hℓZ : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ.ne_zero



  have L1 : ∀ (Z : Scheme.{u}) (m : ℕ), 1 ≤ m →
      ∀ (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}),
      (G ≅ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) →
      Nonempty (Limits.kernel (ℓ • 𝟙 G) ≅
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) := by
    intro Z m hm G e
    obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
    have hℓjZ : (ℓ : ℤ) ^ j ≠ 0 := pow_ne_zero _ hℓZ
    have hk0 : (zmultiplesHom (ZMod (ℓ ^ (j + 1))) ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))))
        (ℓ : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, ← pow_succ',
        ZMod.natCast_self]
    let α : ZMod ℓ →+ ZMod (ℓ ^ (j + 1)) :=
      ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (j + 1))) ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod ℓ) = ((z * ((ℓ ^ j : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (j + 1))) := by
      intro z
      show (ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (j + 1)))
        ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))), hk0⟩) (z : ZMod ℓ) = _
      rw [ZMod.lift_coe]
      change z • ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast at hy
      rw [pow_succ, mul_comm z] at hy
      exact (mul_dvd_mul_iff_left hℓjZ).mp hy
    let α' : ULift.{u+1} (ZMod ℓ) →+ ULift.{u+1} (ZMod (ℓ ^ (j + 1))) :=
      (AddEquiv.ulift.symm : ZMod (ℓ ^ (j + 1)) ≃+ ULift.{u+1} (ZMod (ℓ ^ (j + 1)))).toAddMonoidHom.comp
        (α.comp (AddEquiv.ulift : ULift.{u+1} (ZMod ℓ) ≃+ ZMod ℓ).toAddMonoidHom)
    have hα' : ∀ y, (α' y).down = α y.down := fun y => rfl
    have hα'inj : Function.Injective α' := fun y₁ y₂ h =>
      ULift.ext _ _ (hαinj ((hα' y₁).symm.trans ((congrArg ULift.down h).trans (hα' y₂))))
    have hS : α'.range = (AddCommGrpCat.Hom.hom
        (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1))))))).ker := by
      ext y
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
      constructor
      · rintro ⟨y₀, rfl⟩
        apply ULift.ext
        show ℓ • α y₀.down = 0
        obtain ⟨z, hz⟩ := ZMod.intCast_surjective y₀.down
        rw [← hz, hα, nsmul_eq_mul]
        have h1 : ((ℓ : ℕ) : ZMod (ℓ ^ (j + 1))) * ((z * ((ℓ ^ j : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (j + 1)))
            = ((z * ((ℓ ^ (j + 1) : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (j + 1))) := by
          push_cast; ring
        rw [h1, ZMod.intCast_zmod_eq_zero_iff_dvd]
        exact ⟨z, by ring⟩
      · intro hy
        have hy' : ℓ • y.down = 0 := congrArg ULift.down hy
        obtain ⟨t, ht⟩ := ZMod.intCast_surjective y.down
        rw [← ht, nsmul_eq_mul] at hy'
        have h1 : ((ℓ : ℕ) : ZMod (ℓ ^ (j + 1))) * (t : ZMod (ℓ ^ (j + 1)))
            = (((ℓ : ℤ) * t : ℤ) : ZMod (ℓ ^ (j + 1))) := by
          push_cast; ring
        rw [h1, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy'
        push_cast at hy'
        rw [pow_succ'] at hy'
        obtain ⟨s, hs⟩ := (mul_dvd_mul_iff_left hℓZ).mp hy'
        refine ⟨⟨(s : ZMod ℓ)⟩, ULift.ext _ _ ?_⟩
        rw [hα']
        show α (s : ZMod ℓ) = y.down
        rw [hα, ← ht, hs]
        congr 1
        push_cast
        ring
    let E : ULift.{u+1} (ZMod ℓ) ≃+ ↥(AddCommGrpCat.Hom.hom
        (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1))))))).ker :=
      (AddMonoidHom.ofInjective hα'inj).trans (AddEquiv.addSubgroupCongr hS)
    let iso4 : Limits.kernel (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1)))))) ≅
        AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)) :=
      AddCommGrpCat.kernelIsoKer _ ≪≫ E.symm.toAddCommGrpIso
    have w : (ℓ • 𝟙 G) ≫ e.hom = e.hom ≫ (ℓ • 𝟙 _) := by
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
    have h : ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1)))))) =
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).map
          (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1)))))) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Z)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    exact ⟨Limits.kernel.mapIso _ _ e e w ≪≫ Limits.kernelIsoOfEq h ≪≫
      (Limits.PreservesKernel.iso
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) _).symm ≪≫
      (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).mapIso iso4⟩



  have L2 : ∀ (Z : Scheme.{u}) (p : ℕ), Finite (wcEtCoh Z ℓ p) → Nat.card (wcEtCoh Z ℓ p) ≤ ℓ →
      Subsingleton (wcEtCoh Z ℓ (p + 1)) → ∀ m : ℕ, IsAddCyclic (wcEtZModExt Z (ℓ ^ m) p) := by
    intro Z p hfinZ hcardZ hsubZ m
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z (ℓ ^ m))) := HasExt.standard _
    obtain ⟨α, _, _, hR⟩ := wc_et_zmod_ring_locbij Z (ℓ ^ m)
    have T : ∀ M' : SheafOfModules.{u+1} (wcEtZModRing Z (ℓ ^ m)), (ℓ ^ m) • 𝟙 M' = 0 := by
      intro M'
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      ext s
      have h0 : ((0 : M' ⟶ M').val.app V).hom s = 0 := by
        first
          | rfl
          | simp
          | (rw [SheafOfModules.zero_val]; rfl)
      have hz : ∀ k : ℕ, ((k • 𝟙 M').val.app V).hom s = k • s := by
        intro k
        induction k with
        | zero => rw [zero_nsmul, zero_nsmul]; exact h0
        | succ k ih =>
          rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
            LinearMap.add_apply, ih, succ_nsmul]
          rfl
      rw [hz, ← Nat.cast_smul_eq_nsmul (R := ↑((wcEtZModRing Z (ℓ ^ m)).obj.obj V)), hR V,
        zero_smul, h0]
    have s2 : ∀ {X W : SheafOfModules.{u+1} (wcEtZModRing Z (ℓ ^ m))} {k : ℕ}
        (x : Abelian.Ext X W k) (n : ℕ), x.comp (Abelian.Ext.mk₀ (n • 𝟙 W)) (add_zero k) = n • x := by
      intro X W k x n
      induction n with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
          Abelian.Ext.comp_mk₀_id]
    have hM : ∀ x : wcEtZModExt Z (ℓ ^ m) p, ℓ ^ m • x = 0 := by
      intro x
      have h := s2 x (ℓ ^ m)
      rw [T, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at h
      exact h.symm
    have s1 : ∀ (M A : Type (u+2)) [AddCommGroup M] [AddCommGroup A] [Finite A] (φ : M →+ A),
        (∀ x : M, ℓ ^ m • x = 0) → Nat.card A ≤ ℓ → (∀ x : M, φ x = 0 → ∃ y : M, x = ℓ • y) →
        IsAddCyclic M := by
      intro M A _ _ _ φ hM hA hker
      have hp : Nat.Prime ℓ := Fact.out
      by_cases h0 : ∀ x, φ x = 0
      · have key : ∀ k (x : M), ∃ y, x = ℓ ^ k • y := by
          intro k
          induction k with
          | zero => intro x; exact ⟨x, by simp⟩
          | succ k ih =>
            intro x
            obtain ⟨y, rfl⟩ := ih x
            obtain ⟨z, rfl⟩ := hker y (h0 y)
            exact ⟨z, by rw [smul_smul, pow_succ]⟩
        have : Subsingleton M := ⟨fun a b => by
          obtain ⟨y, hy⟩ := key m a
          obtain ⟨z, hz⟩ := key m b
          rw [hy, hz, hM, hM]⟩
        exact isAddCyclic_of_subsingleton
      · push_neg at h0
        obtain ⟨g, hg⟩ := h0
        have hord : ℓ ≤ addOrderOf (φ g) := by
          have hdvd : addOrderOf (φ g) ∣ ℓ ^ m :=
            addOrderOf_dvd_of_nsmul_eq_zero (by rw [← map_nsmul, hM, map_zero])
          obtain ⟨k, _, hk'⟩ := (Nat.dvd_prime_pow hp).mp hdvd
          rcases k with _ | k
          · exfalso; apply hg; rw [pow_zero] at hk'; exact AddMonoid.addOrderOf_eq_one_iff.mp hk'
          · rw [hk']; exact Nat.le_self_pow (by omega) ℓ
        have htop : AddSubgroup.zmultiples (φ g) = ⊤ := by
          apply AddSubgroup.eq_top_of_le_card
          rw [Nat.card_zmultiples]
          omega
        have hstep : ∀ x : M, ∃ (k : ℤ) (y : M), x = k • g + ℓ • y := by
          intro x
          have hx : φ x ∈ AddSubgroup.zmultiples (φ g) := by rw [htop]; trivial
          obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
          obtain ⟨y, hy⟩ := hker (x - k • g) (by rw [map_sub, map_zsmul, hk, sub_self])
          exact ⟨k, y, by rw [← hy]; abel⟩
        have hiter : ∀ (j : ℕ) (x : M), ∃ (k : ℤ) (y : M), x = k • g + ℓ ^ j • y := by
          intro j
          induction j with
          | zero => intro x; exact ⟨0, x, by simp⟩
          | succ j ih =>
            intro x
            obtain ⟨k, y, rfl⟩ := ih x
            obtain ⟨k', y', rfl⟩ := hstep y
            refine ⟨k + ((ℓ ^ j : ℕ) : ℤ) * k', y', ?_⟩
            have e1 : (((ℓ ^ j : ℕ) : ℤ) * k') • g = ℓ ^ j • (k' • g) := by
              rw [mul_smul, natCast_zsmul]
            have e2 : ℓ ^ j • (ℓ • y') = ℓ ^ (j + 1) • y' := by
              rw [smul_smul, pow_succ]
            rw [add_smul, e1, ← e2, smul_add]
            abel
        rw [isAddCyclic_iff_exists_zmultiples_eq_top]
        refine ⟨g, ?_⟩
