  have G1 := congrArg (fun v => ((wcEtStalk (wcQmUs z : Scheme.{u}) y).map (HomologicalComplex.homologyMap φ q)).hom (Ψ0 ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Xb (Limits.pullback.fst pb (wcQmSp A) ((wcQmUs z).ι y)))) (Scheme.Etale.forget Xb)).op ⋙ ((((wcEtPush (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j)).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj) (Opposite.op (W'.obj l))).hom v))) hzF2
