    calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
      _ = ((Abelian.Ext.mk₀ ψ.hom).comp (Abelian.Ext.mk₀ ψ.inv) (add_zero 0)).comp e
            (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = (Abelian.Ext.mk₀ ψ.hom).comp ((Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)))
            (zero_add (n + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

  have hΦ := wc_ext_transfer_exact (wcEpsInv Y) Zet ha hb G i
  let Φ := Equiv.ofBijective _ hΦ

  have pre : ∀ {A A' B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : A ≅ A'),
      Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A' B i) := by
    intro A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add i)
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add i)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  obtain ⟨E1⟩ := pre (B := (wcEpsInv Y).obj G) ψ.symm
  exact ⟨E1.trans Φ.symm⟩

theorem wc_pencil_Rq_torsion_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (k q p : ℕ), 3 ≤ p → ∀ x : wcCohG F'' (wcP1Over F'') hP
      (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))) p, x = 0 :=
by
  intro k q p hp x

  haveI hP1 : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI := D.proper
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  have hm : ((ℓ ^ k : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro hk
    have hk' : ((ℓ ^ k : ℕ) : F'') = 0 := by
      apply (algebraMap F'' (AlgebraicClosure F'')).injective
      rw [map_natCast, map_zero]
      exact hk
    haveI : Fintype F'' := Fintype.ofFinite F''
    have hprime : Nat.Prime (ringChar F'') := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp hk'
    have h2 : ringChar F'' ∣ ℓ := hprime.dvd_of_dvd_pow h1
    have h3 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hprime (Fact.out : ℓ.Prime)).mp h2
    have h4 : ringChar F'' ∣ Nat.card F'' := by
      rw [Nat.card_eq_fintype_card]
      exact (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp (FiniteField.cast_card_eq_zero F'')
    exact hℓ (h3 ▸ h4)

  have key : ∀ (Yb : Scheme.{u}) (fY : Yb ⟶ Spec (.of (AlgebraicClosure F''))) [IsProper fY]
      [SmoothOfRelativeDimension 1 fY] (G : Sheaf (Scheme.smallEtaleTopology Yb) AddCommGrpCat.{u+1}),
      (ℓ ^ k) • 𝟙 G = 0 →
      ∀ z : Abelian.Ext (wcFreeSheaf Yb (Scheme.ProEt.mk (𝟙 Yb))) ((wcEpsInv Yb).obj G) p, z = 0 := by
    intro Yb fY _ _ G hG z
    have hdim := wc_smooth_alg_closed_dim_le (AlgebraicClosure F'') Yb fY 1
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Yb) AddCommGrpCat.{u+1}) := HasExt.standard _
    have het : ∀ ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Yb)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p, ξ = 0 :=
      wc_et_cd_proper_torsion (AlgebraicClosure F'') Yb fY 1 hdim (ℓ ^ k) hm G hG p (by omega)
    obtain ⟨E3⟩ := wc_proet_etale_comparison_epsInv (AlgebraicClosure F'') Yb fY G p
    exact E3.injective ((het (E3 z)).trans (het (E3 0)).symm)

  have hPr : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  have hS : SmoothOfRelativeDimension 1 (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) (wc_p1_smooth_reldim_one F'')

  obtain ⟨H, htor, ⟨e⟩⟩ := wc_proet_Rq_push_torsion_epsInv D.f (ℓ ^ k) q

  obtain ⟨H', htor', E2⟩ := wc_ext_free_slice_epsInv_torsion (wcP1Over F'').left
    (wcGeomPoint F'' (wcP1Over F'') hP) (ℓ ^ k) H htor
  obtain ⟨E⟩ := E2 p
  have hY := @key (wcGeomPoint F'' (wcP1Over F'') hP).left (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hPr hS H' htor'
  have hB : ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
      ((wcEpsInv (wcP1Over F'').left).obj H) p, w = 0 :=
    fun w => E.injective ((hY (E w)).trans (hY (E 0)).symm)

  have h1 : x.comp (Abelian.Ext.mk₀ e.hom) (add_zero p) = 0 := hB _
  calc x = (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero p)).comp (Abelian.Ext.mk₀ e.inv)
        (add_zero p) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    _ = 0 := by rw [h1, Abelian.Ext.zero_comp]

theorem wc_proet_push_slice_ext_equiv : ∀ (B X : Scheme.{u}) (U : B.ProEt) (g : X ⟶ B) (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] (q p : ℕ), Nonempty (Abelian.Ext (wcFreeSheaf B U) (((wcProEtPush g).rightDerived q).obj (wcContSheaf X A)) p ≃ Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) (((wcProEtPush (Limits.pullback.snd g U.hom)).rightDerived q).obj (wcContSheaf (Limits.pullback g U.hom) A)) p) :=
by

  have crit : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl

  have hπ : ∀ {S₁ S₂ : Scheme.{u}} (f : S₁ ⟶ S₂),
      (wcProEtBaseChange f).IsContinuous (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁) := by
    intro S₁ S₂ f
    have hpres : Limits.PreservesFiniteLimits (wcProEtBaseChange f) := by
      let e : Scheme.ProEt.forget S₂ ⋙ Over.pullback f ≅
          wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁ :=
        NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)
      haveI : Limits.PreservesFiniteLimits (wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁) :=
        Limits.preservesFiniteLimits_of_natIso e
      exact Limits.preservesFiniteLimits_of_reflects_of_preserves (wcProEtBaseChange f)
        (Scheme.ProEt.forget S₁)
    haveI := hpres
    haveI hflat : RepresentablyFlat (wcProEtBaseChange f) :=
      flat_of_preservesFiniteLimits (wcProEtBaseChange f)
    have hle : ∀ (U : S₂.ProEt) (R : Sieve U),
        Sieve.pullback (Limits.pullback.fst U.hom f)
          (Sieve.functorPushforward (Scheme.ProEt.forget S₂ ⋙ Over.forget S₂) R) ≤
        Sieve.functorPushforward (Scheme.ProEt.forget S₁ ⋙ Over.forget S₁)
          (Sieve.functorPushforward (wcProEtBaseChange f) R) := by
      intro U R Z h hh
      obtain ⟨V, g, k, hg, hk⟩ := hh
      change h ≫ Limits.pullback.fst U.hom f = k ≫ g.left at hk
      have hw : g.left ≫ U.hom = V.hom := MorphismProperty.Over.w g
      have w : k ≫ V.hom = (h ≫ Limits.pullback.snd U.hom f) ≫ f :=
        calc k ≫ V.hom = k ≫ (g.left ≫ U.hom) := congrArg (k ≫ ·) hw.symm
        _ = (k ≫ g.left) ≫ U.hom := (Category.assoc _ _ _).symm
        _ = (h ≫ Limits.pullback.fst U.hom f) ≫ U.hom := congrArg (· ≫ U.hom) hk.symm
        _ = h ≫ (Limits.pullback.fst U.hom f ≫ U.hom) := Category.assoc _ _ _
        _ = h ≫ (Limits.pullback.snd U.hom f ≫ f) := congrArg (h ≫ ·) Limits.pullback.condition
        _ = (h ≫ Limits.pullback.snd U.hom f) ≫ f := (Category.assoc _ _ _).symm
      refine ⟨(wcProEtBaseChange f).obj V, (wcProEtBaseChange f).map g,
        Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w,
        Sieve.image_mem_functorPushforward (wcProEtBaseChange f) R hg, ?_⟩
      have hmap : ((wcProEtBaseChange f).map g).left =
          Limits.pullback.lift (Limits.pullback.fst V.hom f ≫ g.left) (Limits.pullback.snd V.hom f)
            (by rw [Category.assoc, MorphismProperty.Over.w g]; exact Limits.pullback.condition) :=
        rfl
      change h = Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫
        ((wcProEtBaseChange f).map g).left
      rw [hmap]
      apply Limits.pullback.hom_ext
      · refine hk.trans ?_
        refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_fst _ _ _)).trans ?_
        refine (Category.assoc _ _ _).symm.trans ?_
        exact congrArg (fun x => x ≫ g.left) (Limits.pullback.lift_fst _ _ _)
      · refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_snd _ _ _)).trans ?_
        exact Limits.pullback.lift_snd _ _ _
    have hcov : CoverPreserving (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁)
        (wcProEtBaseChange f) := by
      refine ⟨fun {U} {R} hR => ?_⟩
      have hS := (crit S₂ U R).1 hR
      have hP := Scheme.proetaleTopology.pullback_stable (Limits.pullback.fst U.hom f) hS
      have hQ := Scheme.proetaleTopology.superset_covering (hle U R) hP
      exact (crit S₁ ((wcProEtBaseChange f).obj U)
        (Sieve.functorPushforward (wcProEtBaseChange f) R)).2 hQ
    exact Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.ProEt.topology S₁) (wcProEtBaseChange f)) hcov

  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e

  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc

  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcSliceFunctor S U).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
