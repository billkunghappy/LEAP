    exact gen _ _ _ _ hθ (Iso.isIso_hom _) (Iso.isIso_hom _) e

  have hB : IsIso (HomologicalComplex.homologyMap
      (((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map
        (((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).map h.hom)) p) :=
    Iso.isIso_hom (((wcEtPush O.ι).mapHomotopyEquiv
