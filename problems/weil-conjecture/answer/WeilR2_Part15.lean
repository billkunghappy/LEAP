    exact AddCommGrpCat.isZero_iff_subsingleton.mp hZ

theorem wc_qm_edge_iff_sig_inl : ∀ (Z : Scheme.{u}) (z : Z) (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ) (q : ℕ), letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}); let σ := fun (M : DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})) (e : (DerivedCategory.singleFunctor _ 0).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ M) => wcEtGlobalGerm _ z ((((DerivedCategory.singleFunctorCompHomologyFunctorIso _ 0).inv.app ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ (DerivedCategory.homologyFunctor _ 0).map e).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom (((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Scheme.Etale Z)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom (ULift.up 1))); (Function.Bijective (wcQmEdge Z z K q) ↔ Function.Bijective (σ ((shiftFunctor _ (q : ℤ)).obj (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat))))) :=
by
  intro Z z K q
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
  intro σ

  have hnat : ∀ (G G' : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (f : G ⟶ G')
      (s : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Z)))),
      wcEtGlobalGerm G' z ((f.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom s) =
        ((wcEtStalk Z z).map f).hom (wcEtGlobalGerm G z s) := by
    intro G G' f s
    have h := Limits.colimit.ι_map
      (Functor.whiskerLeft
        (StructuredArrow.proj (Over.mk (wcEtGeomPt Z z)) (Scheme.Etale.forget Z)).op f.hom)
      (Opposite.op (StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 Z))
        (Over.homMk (wcEtGeomPt Z z) (by simp))))
    exact (ConcreteCategory.congr_hom h s).symm
  let M := (shiftFunctor (DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}))
    (q : ℤ)).obj (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat))
  let θI : (DerivedCategory.homologyFunctor
      (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).obj M ≅ K.homology q :=
    ((DerivedCategory.homologyFunctor
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).shiftIso
              (q : ℤ) 0 (q : ℤ) (add_zero _)).app
            (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≪≫
          (DerivedCategory.homologyFunctorFactors
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (q : ℤ)).app
            (K.extend ComplexShape.embeddingUpNat) ≪≫
          (K.extendHomologyIso ComplexShape.embeddingUpNat rfl)
  let θ := θI.hom
  have hkey : ∀ {X Y W : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}}
      (g : X ⟶ Y) (h : Y ⟶ W) (x : X.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Z)))),
      ((g ≫ h).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom x =
        (h.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom
          ((g.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom x) := fun _ _ _ => rfl
  have hpt : ∀ e' : ((DerivedCategory.singleFunctor
      (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).obj
        ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ M),
      wcQmEdge Z z K q e' = ((wcEtStalk Z z).map θ).hom (σ M e') := by
    intro e'
    refine Eq.trans ?_ (hnat _ _ θ _)
    have hmor : (DerivedCategory.singleFunctorCompHomologyFunctorIso
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).inv.app
            ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫
          (DerivedCategory.homologyFunctor
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).map e' ≫
          ((DerivedCategory.homologyFunctor
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).shiftIso
              (q : ℤ) 0 (q : ℤ) (add_zero _)).hom.app
            (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≫
          (DerivedCategory.homologyFunctorFactors
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (q : ℤ)).hom.app
            (K.extend ComplexShape.embeddingUpNat) ≫
          (K.extendHomologyIso ComplexShape.embeddingUpNat rfl).hom =
        ((DerivedCategory.singleFunctorCompHomologyFunctorIso
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).inv.app
            ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫
          (DerivedCategory.homologyFunctor
            (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) 0).map e') ≫ θ :=
      (Category.assoc _ _ _).symm
    exact congrArg (fun φ => wcEtGlobalGerm (K.homology q) z
      ((φ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom
        (((toSheafify (Scheme.smallEtaleTopology Z)
            ((Functor.const (Scheme.Etale Z)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app
            (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom (ULift.up 1)))) hmor
  have hfac : wcQmEdge Z z K q = ((wcEtStalk Z z).map θ).hom ∘ σ M := by
    funext e
    exact hpt e
  have hb : Function.Bijective ((wcEtStalk Z z).map θ).hom :=
    ConcreteCategory.bijective_of_isIso ((wcEtStalk Z z).map θ)
  rw [hfac]
  exact Function.Bijective.of_comp_iff' hb _

theorem wc_qm_edge_two_of_three : ∀ (Z : Scheme.{u}) (z : Z), IsClosed ({z} : Set Z) → IsSepClosed (Z.residueField z) → ∀ (K₁ K₂ : CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ) (ψ : K₁ ⟶ K₂), (∀ y : Z, y ≠ z → ∀ p : ℕ, IsIso ((wcEtStalk Z y).map (HomologicalComplex.homologyMap ψ p))) → ((∀ q, Function.Bijective (wcQmEdge Z z K₁ q)) ↔ (∀ q, Function.Bijective (wcQmEdge Z z K₂ q))) :=
by
  intro Z z hzcl hzsep K₁ K₂ ψ hψ
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})

  let σ := fun (M : DerivedCategory (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}))
      (e : (DerivedCategory.singleFunctor _ 0).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ M) =>
    wcEtGlobalGerm _ z ((((DerivedCategory.singleFunctorCompHomologyFunctorIso _ 0).inv.app
      ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ (DerivedCategory.homologyFunctor _ 0).map e).hom.app
          (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom
      (((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Scheme.Etale Z)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app (Opposite.op (Scheme.Etale.mk (𝟙 Z)))).hom
          (ULift.up 1)))

  have hgood : ∀ K : CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ,
      (∀ q, Function.Bijective (wcQmEdge Z z K q)) ↔
        (∀ n : ℤ, Function.Bijective (σ ((shiftFunctor _ n).obj
          (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat))))) := by
    intro K
    have hGE : (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)).IsGE 0 := by
      rw [DerivedCategory.isGE_Q_obj_iff]
      infer_instance
    constructor
    · intro h n
      rcases le_or_gt 0 n with hn | hn
      · obtain ⟨q, rfl⟩ := Int.eq_ofNat_of_zero_le hn
        exact (wc_qm_edge_iff_sig_inl Z z K q).mp (h q)
      · exact wc_qm_sig_bij_of_isGE_inl Z z _ 0 n hGE hn
    · intro h q
      exact (wc_qm_edge_iff_sig_inl Z z K q).mpr (h q)

  obtain ⟨hcGE, hcSupp⟩ := wc_qm_cone_supp Z z K₁ K₂ ψ hψ
  have hcone : ∀ n : ℤ, Function.Bijective (σ ((shiftFunctor _ n).obj
      (DerivedCategory.Q.obj (CochainComplex.mappingCone
        (HomologicalComplex.extendMap ψ ComplexShape.embeddingUpNat))))) :=
    wc_qm_sig_derived_support_inl Z z
      (fun G hG => wc_qm_point_sheaf_germ_bij Z z hzcl hzsep G hG)
      (fun G hG p hp => wc_qm_point_sheaf_ext_vanish Z z hzcl hzsep G hG p hp)
      _ (-1) hcGE hcSupp

  have hT := DerivedCategory.mappingCone_triangle_distinguished
    (HomologicalComplex.extendMap ψ ComplexShape.embeddingUpNat)
  rw [hgood K₁, hgood K₂]
  exact wc_qm_sig_triangle_iff_inl Z z _ hT hcone

theorem wc_et_quadric_cone_acyclic : ∀ (K : Type u) [Field K] [IsSepClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (n : ℕ) (c : Matrix (Fin n) (Fin n) K), Nat.card (wcEtCoh (Spec (.of (wcQuadModelRing K n 0 c))) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Spec (.of (wcQuadModelRing K n 0 c))) ℓ q) :=
by
  intro K₀ _ _ ℓ hℓ hℓK₀ n₀ c₀
  classical
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓ⟩

  have s2 : ∀ (Ω : Type u) [Field Ω] (n : ℕ) (c : Matrix (Fin n) (Fin n) Ω),
      ∃ (H : Limits.pullback (wcQuadModelStr Ω n 0 c) (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))) ⟶ Spec (.of (wcQuadModelRing Ω n 0 c)))
        (j₀ j₁ : Spec (.of (wcQuadModelRing Ω n 0 c)) ⟶ Limits.pullback (wcQuadModelStr Ω n 0 c) (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))))
        (v : Spec (.of Ω) ⟶ Spec (.of (wcQuadModelRing Ω n 0 c))),
        j₀ ≫ Limits.pullback.fst (wcQuadModelStr Ω n 0 c) (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))) = 𝟙 _ ∧
        j₁ ≫ Limits.pullback.fst (wcQuadModelStr Ω n 0 c) (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))) = 𝟙 _ ∧
        j₁ ≫ H = 𝟙 _ ∧ j₀ ≫ H = wcQuadModelStr Ω n 0 c ≫ v ∧ v ≫ wcQuadModelStr Ω n 0 c = 𝟙 _ := by
    intro Ω _ n c
    let I := wcQuadModelIdeal Ω n 0 c
    let R := wcQuadModelRing Ω n 0 c
    have hFI : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C (0 : Ω) : MvPolynomial (Fin n) Ω) ∈ I := Ideal.subset_span rfl
    have hI : ∀ {B : Type u} [CommRing B] [Algebra Ω B] (f : MvPolynomial (Fin n) Ω →ₐ[Ω] B),
        f (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C (0 : Ω)) = 0 → ∀ a ∈ I, f a = 0 := by
      intro B _ _ f hf a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hf, mul_zero]
    let x : Fin n → R := fun p => Ideal.Quotient.mk I (MvPolynomial.X p)
    have hrel : ∑ p, ∑ q, algebraMap Ω R (c p q) * x p * x q = 0 := by
      have h := Ideal.Quotient.eq_zero_iff_mem.mpr hFI
      simp only [map_sub, map_sum, map_mul, MvPolynomial.C_0, map_zero, sub_zero] at h
      rw [← h]
      rfl
    let y : Fin n → TensorProduct Ω R (Polynomial Ω) :=
      fun p => x p ⊗ₜ[Ω] (Polynomial.X : Polynomial Ω)
    have hAyF : (MvPolynomial.aeval y) (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C (0 : Ω)) = 0 := by
      rw [map_sub, map_sum, MvPolynomial.C_0, map_zero, sub_zero]
      have e1 : ∀ p, (MvPolynomial.aeval y) (∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
          MvPolynomial.X q) = (∑ q, algebraMap Ω R (c p q) * x p * x q) ⊗ₜ[Ω]
            (Polynomial.X * Polynomial.X : Polynomial Ω) := by
        intro p
        rw [map_sum, TensorProduct.sum_tmul]
        refine Finset.sum_congr rfl (fun q _ => ?_)
        rw [map_mul, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, MvPolynomial.aeval_X,
          Algebra.TensorProduct.algebraMap_apply]
        show (algebraMap Ω R (c p q) ⊗ₜ[Ω] (1 : Polynomial Ω)) *
            (x p ⊗ₜ[Ω] (Polynomial.X : Polynomial Ω)) *
              (x q ⊗ₜ[Ω] (Polynomial.X : Polynomial Ω)) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      rw [Finset.sum_congr rfl (fun p _ => e1 p), ← TensorProduct.sum_tmul, hrel,
        TensorProduct.zero_tmul]
    let η : R →ₐ[Ω] TensorProduct Ω R (Polynomial Ω) :=
      Ideal.Quotient.liftₐ I (MvPolynomial.aeval y) (hI (MvPolynomial.aeval y) hAyF)
    let ev : Ω → (TensorProduct Ω R (Polynomial Ω) →ₐ[Ω] R) := fun a =>
      Algebra.TensorProduct.lift (AlgHom.id Ω R) (Polynomial.aeval (algebraMap Ω R a))
        (fun _ _ => Commute.all _ _)
    let ε : R →ₐ[Ω] Ω := Ideal.Quotient.liftₐ I (MvPolynomial.aeval (fun _ => (0 : Ω)))
      (hI _ (by simp))
    have hηX : ∀ p, η (Ideal.Quotient.mk I (MvPolynomial.X p)) = y p := by
      intro p
      show MvPolynomial.aeval y (MvPolynomial.X p) = y p
      exact MvPolynomial.aeval_X _ _
    have hevy : ∀ a p, ev a (y p) = x p * algebraMap Ω R a := by
      intro a p
      simp only [ev, y, Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, Polynomial.aeval_X]
    have hεX : ∀ p, ε (Ideal.Quotient.mk I (MvPolynomial.X p)) = 0 := by
      intro p
      show MvPolynomial.aeval (fun _ => (0 : Ω)) (MvPolynomial.X p) = 0
      exact MvPolynomial.aeval_X _ _
    have hevη1 : (ev 1).comp η = AlgHom.id Ω R := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro p
      show ev 1 (η (Ideal.Quotient.mk I (MvPolynomial.X p))) =
        Ideal.Quotient.mk I (MvPolynomial.X p)
      rw [hηX, hevy, map_one, mul_one]
    have hevη0 : (ev 0).comp η = (Algebra.ofId Ω R).comp ε := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro p
      show ev 0 (η (Ideal.Quotient.mk I (MvPolynomial.X p))) =
        algebraMap Ω R (ε (Ideal.Quotient.mk I (MvPolynomial.X p)))
      rw [hηX, hevy, hεX, map_zero, mul_zero]
    let P := TensorProduct Ω R (Polynomial Ω)
    let evC : Ω → (CommRingCat.of P ⟶ CommRingCat.of R) := fun a =>
      CommRingCat.ofHom (R := P) (S := R) (ev a).toRingHom
    let ηC : CommRingCat.of R ⟶ CommRingCat.of P :=
      CommRingCat.ofHom (R := R) (S := P) η.toRingHom
    let εC : CommRingCat.of R ⟶ CommRingCat.of Ω :=
      CommRingCat.ofHom (R := R) (S := Ω) ε.toRingHom
    have hevi : ∀ a, CommRingCat.ofHom (R := R) (S := P)
        (Algebra.TensorProduct.includeLeftRingHom (R := Ω) (A := R) (B := Polynomial Ω)) ≫ evC a
          = 𝟙 _ := by
      intro a
      refine CommRingCat.hom_ext (RingHom.ext fun r => ?_)
      show ev a (r ⊗ₜ[Ω] (1 : Polynomial Ω)) = r
      simp only [ev, Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one]
    let ι := pullbackSpecIso Ω R (Polynomial Ω)
    refine ⟨ι.hom ≫ Spec.map ηC, Spec.map (evC 0) ≫ ι.inv, Spec.map (evC 1) ≫ ι.inv,
      Spec.map εC, ?_, ?_, ?_, ?_, ?_⟩
    · rw [Category.assoc, pullbackSpecIso_inv_fst, ← Spec.map_comp, hevi, Spec.map_id]
    · rw [Category.assoc, pullbackSpecIso_inv_fst, ← Spec.map_comp, hevi, Spec.map_id]
    · rw [Category.assoc, Iso.inv_hom_id_assoc, ← Spec.map_comp]
      have : ηC ≫ evC 1 = 𝟙 _ :=
        CommRingCat.hom_ext (RingHom.ext fun r => DFunLike.congr_fun hevη1 r)
      rw [this, Spec.map_id]
    · rw [Category.assoc, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← Spec.map_comp]
      congr 1
      exact CommRingCat.hom_ext (RingHom.ext fun r => DFunLike.congr_fun hevη0 r)
    · rw [← Spec.map_comp]
      have : CommRingCat.ofHom (algebraMap Ω R) ≫ εC = 𝟙 _ :=
        CommRingCat.hom_ext (RingHom.ext fun r => ε.commutes r)
      rw [this, Spec.map_id]

  have s1 : ∀ (K : Type u) [Field K] (Ω : Type u) [Field Ω] [Algebra K Ω] (n : ℕ)
      (c : Matrix (Fin n) (Fin n) K),
      ∃ θ : Spec (.of (wcQuadModelRing Ω n 0 (c.map (algebraMap K Ω)))) ⟶
        Limits.pullback (wcQuadModelStr K n 0 c) (Spec.map (CommRingCat.ofHom (algebraMap K Ω))),
        IsIso θ := by
    intro K _ Ω _ _ n c
    let IK := wcQuadModelIdeal K n 0 c
    let RK := wcQuadModelRing K n 0 c
    let IΩ := wcQuadModelIdeal Ω n 0 (c.map (algebraMap K Ω))
    let RΩ := wcQuadModelRing Ω n 0 (c.map (algebraMap K Ω))
    let FK : MvPolynomial (Fin n) K := ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
      MvPolynomial.X q - MvPolynomial.C 0
    let FΩ : MvPolynomial (Fin n) Ω := ∑ p, ∑ q, MvPolynomial.C ((c.map (algebraMap K Ω)) p q) *
      MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C 0
    have hFK : FK ∈ IK := Ideal.subset_span rfl
    have hFΩ : FΩ ∈ IΩ := Ideal.subset_span rfl
    have hmapF : MvPolynomial.map (algebraMap K Ω) FK = FΩ := by
      simp [FK, FΩ, map_sum, Matrix.map_apply]
    have haevF : MvPolynomial.aeval (R := K)
        (fun p => (MvPolynomial.X p : MvPolynomial (Fin n) Ω)) FK = FΩ := by
      simp [FK, FΩ, map_sum, Matrix.map_apply, MvPolynomial.algebraMap_apply]
    let f₁ : RK →ₐ[K] RΩ := Ideal.Quotient.liftₐ IK ((Ideal.Quotient.mkₐ K IΩ).comp
      (MvPolynomial.aeval (fun p => (MvPolynomial.X p : MvPolynomial (Fin n) Ω)))) (by
        intro a ha
        obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        have : ((Ideal.Quotient.mkₐ K IΩ).comp
            (MvPolynomial.aeval (fun p => (MvPolynomial.X p : MvPolynomial (Fin n) Ω)))) FK = 0 := by
          rw [AlgHom.comp_apply, haevF, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
          exact hFΩ
        show ((Ideal.Quotient.mkₐ K IΩ).comp
            (MvPolynomial.aeval (fun p => (MvPolynomial.X p : MvPolynomial (Fin n) Ω)))) (b * FK) = 0
        rw [map_mul, this, mul_zero])
    let φ : TensorProduct K RK Ω →ₐ[K] RΩ := Algebra.TensorProduct.lift f₁
      (IsScalarTower.toAlgHom K Ω RΩ) (fun _ _ => Commute.all _ _)
    let g₀ : MvPolynomial (Fin n) Ω →+* TensorProduct K RK Ω := MvPolynomial.eval₂Hom
      (Algebra.TensorProduct.includeRight : Ω →ₐ[K] TensorProduct K RK Ω).toRingHom
      (fun p => Ideal.Quotient.mk IK (MvPolynomial.X p) ⊗ₜ[K] (1 : Ω))
    have hg₀C : ∀ a : Ω, g₀ (MvPolynomial.C a) = (1 : RK) ⊗ₜ[K] a := by
      intro a
      simp only [g₀, MvPolynomial.eval₂Hom_C]
      rfl
    have hg₀X : ∀ p, g₀ (MvPolynomial.X p) =
        Ideal.Quotient.mk IK (MvPolynomial.X p) ⊗ₜ[K] (1 : Ω) := by
      intro p
      simp only [g₀, MvPolynomial.eval₂Hom_X']
    have hg₀ : ∀ a : MvPolynomial (Fin n) K, g₀ (MvPolynomial.map (algebraMap K Ω) a) =
        (Ideal.Quotient.mk IK a) ⊗ₜ[K] (1 : Ω) := by
      intro a
      induction a using MvPolynomial.induction_on with
      | C k =>
        rw [MvPolynomial.map_C, hg₀C, ← Algebra.TensorProduct.algebraMap_apply',
          Algebra.TensorProduct.algebraMap_apply, ← MvPolynomial.algebraMap_eq,
          Ideal.Quotient.mk_algebraMap]
      | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, TensorProduct.add_tmul]
      | mul_X a p ha =>
        rw [map_mul, map_mul, ha, MvPolynomial.map_X, hg₀X, map_mul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    have hg₀I : ∀ a ∈ IΩ, g₀ a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      have : g₀ FΩ = 0 := by
        rw [← hmapF, hg₀, Ideal.Quotient.eq_zero_iff_mem.mpr hFK, TensorProduct.zero_tmul]
      show g₀ (b * FΩ) = 0
      rw [map_mul, this]
      exact mul_zero (g₀ b)
    let ψ : RΩ →+* TensorProduct K RK Ω :=
      Ideal.Quotient.lift (S := TensorProduct K RK Ω) IΩ g₀ hg₀I
    have hψC : ∀ a : Ω, ψ (algebraMap Ω RΩ a) = (1 : RK) ⊗ₜ[K] a := by
      intro a
      rw [← hg₀C]
      rfl
    let ψₐ : RΩ →ₐ[K] TensorProduct K RK Ω :=
      { ψ with
        commutes' := fun k => by
          have : algebraMap K RΩ k = algebraMap Ω RΩ (algebraMap K Ω k) :=
            IsScalarTower.algebraMap_apply K Ω RΩ k
          simp only [RingHom.toMonoidHom_eq_coe, OneHom.toFun_eq_coe, MonoidHom.toOneHom_coe,
            MonoidHom.coe_coe]
          rw [this, hψC, Algebra.TensorProduct.algebraMap_apply'] }
    have hf1X : ∀ p, f₁ (Ideal.Quotient.mk IK (MvPolynomial.X p)) =
        Ideal.Quotient.mk IΩ (MvPolynomial.X p) := by
      intro p
      show ((Ideal.Quotient.mkₐ K IΩ).comp (MvPolynomial.aeval
        (fun p => (MvPolynomial.X p : MvPolynomial (Fin n) Ω)))) (MvPolynomial.X p) = _
      rw [AlgHom.comp_apply, MvPolynomial.aeval_X]
      rfl
    have hφX : ∀ p, φ (Ideal.Quotient.mk IK (MvPolynomial.X p) ⊗ₜ[K] (1 : Ω)) =
        Ideal.Quotient.mk IΩ (MvPolynomial.X p) := by
      intro p
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, hf1X]
    have hφC : ∀ a : Ω, φ ((1 : RK) ⊗ₜ[K] a) = algebraMap Ω RΩ a := by
      intro a
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have hψX : ∀ p, ψ (Ideal.Quotient.mk IΩ (MvPolynomial.X p)) =
        Ideal.Quotient.mk IK (MvPolynomial.X p) ⊗ₜ[K] (1 : Ω) := by
      intro p
      rw [← hg₀X]
      rfl
    have h1 : φ.toRingHom.comp ψ = RingHom.id RΩ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        show φ (ψ (algebraMap Ω RΩ a)) = algebraMap Ω RΩ a
        rw [hψC, hφC]
      · intro p
        show φ (ψ (Ideal.Quotient.mk IΩ (MvPolynomial.X p))) = _
        rw [hψX, hφX]
        rfl
    have h2 : ψ.comp φ.toRingHom = RingHom.id _ := by
      have : ψₐ.comp φ = AlgHom.id K _ := by
        apply Algebra.TensorProduct.ext
        · apply Ideal.Quotient.algHom_ext
          apply MvPolynomial.algHom_ext
          intro p
          show ψ (φ (Ideal.Quotient.mk IK (MvPolynomial.X p) ⊗ₜ[K] (1 : Ω))) = _
          rw [hφX, hψX]
          rfl
        · apply AlgHom.ext
          intro a
          show ψ (φ ((1 : RK) ⊗ₜ[K] a)) = (1 : RK) ⊗ₜ[K] a
          rw [hφC, hψC]
      exact congrArg AlgHom.toRingHom this
    let e : TensorProduct K RK Ω ≃+* RΩ := RingEquiv.ofRingHom φ.toRingHom ψ h1 h2
    exact ⟨Spec.map e.toCommRingCatIso.hom ≫ (pullbackSpecIso K RK Ω).inv, inferInstance⟩

  have hid : ∀ {X : Scheme.{u}} (E : wcEtPullData (𝟙 X) ℓ) (i : ℕ) (x : wcEtZModExt X ℓ i),
      wcEtPull E i x = x := by
    intro X E i x
    have h := wc_et_pull_comp (𝟙 X) (𝟙 X) (𝟙 X) (Category.id_comp _) E E E i x
    have h0 : wcEtPull E i (wcEtPull E i x - x) = 0 := by
      rw [map_sub, ← h, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective E i _ h0)

  have s3 : ∀ {X S Q : Scheme.{u}} (g : X ⟶ S) (v : S ⟶ X) (π H : Q ⟶ X) (j₀ j₁ : X ⟶ Q),
      v ≫ g = 𝟙 S → j₀ ≫ π = 𝟙 X → j₁ ≫ π = 𝟙 X → j₁ ≫ H = 𝟙 X → j₀ ≫ H = g ≫ v →
      (∀ (E : wcEtPullData π ℓ) (i : ℕ), Function.Bijective (wcEtPull E i)) →
      ∀ (D : wcEtPullData g ℓ) (i : ℕ), Function.Bijective (wcEtPull D i) := by
    intro X S Q g v π H j₀ j₁ hvg h0π h1π h1H h0H hπ D i
    obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v ℓ
    obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists π ℓ
    obtain ⟨D₀⟩ := wc_et_zmod_pull_data_exists j₀ ℓ
    obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists j₁ ℓ
    obtain ⟨DH⟩ := wc_et_zmod_pull_data_exists H ℓ
    obtain ⟨Dgv⟩ := wc_et_zmod_pull_data_exists (g ≫ v) ℓ
    obtain ⟨EX⟩ := wc_et_zmod_pull_data_exists (𝟙 X) ℓ
    obtain ⟨ES⟩ := wc_et_zmod_pull_data_exists (𝟙 S) ℓ
    have hc : ∀ z, wcEtPull D₀ i z = wcEtPull D₁ i z := by
      intro z
      obtain ⟨w, rfl⟩ := (hπ Dπ i).2 z
      have e0 := wc_et_pull_comp π j₀ (𝟙 X) h0π Dπ D₀ EX i w
      have e1 := wc_et_pull_comp π j₁ (𝟙 X) h1π Dπ D₁ EX i w
      rw [hid] at e0 e1
      rw [← e0]
      exact e1
    have hd : ∀ y, wcEtPull Dgv i y = y := by
      intro y
      have e0 := wc_et_pull_comp H j₀ (g ≫ v) h0H DH D₀ Dgv i y
      have e1 := wc_et_pull_comp H j₁ (𝟙 X) h1H DH D₁ EX i y
      rw [hid] at e1
      rw [e0, hc]
      exact e1.symm
    refine ⟨fun x y hxy => ?_, fun y => ⟨wcEtPull Dv i y, ?_⟩⟩
    · have hx := wc_et_pull_comp g v (𝟙 S) hvg D Dv ES i x
      have hy := wc_et_pull_comp g v (𝟙 S) hvg D Dv ES i y
      rw [hid] at hx hy
      calc x = wcEtPull Dv i (wcEtPull D i x) := hx
        _ = wcEtPull Dv i (wcEtPull D i y) := by rw [hxy]
        _ = y := hy.symm
    · have h := wc_et_pull_comp v g (g ≫ v) rfl Dv D Dgv i y
      rw [hd] at h
      exact h.symm

  have s4 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω], (ℓ : Ω) ≠ 0 →
      ∀ (T : Scheme.{u}) (fT : T ⟶ Spec (.of Ω)) [LocallyOfFiniteType fT]
      (E : wcEtPullData (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω))))) ℓ) (i : ℕ),
      Function.Bijective (wcEtPull E i) := by
    intro Ω _ _ hℓΩ T fT _ E i
    have h7a := wc_et_affine_line_push_acyclic Ω ℓ (Fact.out) hℓΩ T fT
    obtain ⟨I, hI⟩ := wc_et_module_push_acyclic_of_ab _ ℓ E h7a
    have h6 := wc_et_affine_line_unit_iso Ω T fT ℓ E
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))))) _ _ E.cont E.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ E.adj E.additive
    haveI := E.additive
    haveI := E.presLim
    haveI := E.presColim
    exact wc_ext_map_bijective_of_degenerate_leray E.Φ
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))))) _ _ E.cont E.φ)
      E.adj _ _ E.μ h6 I hI i

  have s5 : ∀ (k : Type u) [Field k] [IsSepClosed k] (m q : ℕ), 1 ≤ q →
      Subsingleton (wcEtCoh (Spec (.of k)) m q) := by
    intro k _ _ m q hq
    have hsec : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of k)), Etale f → Nonempty X →
        ∃ σ : Spec (.of k) ⟶ X, σ ≫ f = 𝟙 _ := by
      intro X f hf hX
      obtain ⟨x⟩ := hX
      obtain ⟨V, hV, hxV, -⟩ :=
        exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) trivial
      haveI := hV.isOpenImmersion_fromSpec
      have hjx : x ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hxV
      obtain ⟨y, -⟩ := hjx
      have hA : Nontrivial Γ(X, V) :=
        PrimeSpectrum.nonempty_iff_nontrivial.mp (⟨y⟩ : Nonempty (PrimeSpectrum Γ(X, V)))
      haveI : Etale (hV.fromSpec ≫ f) := inferInstance
      have hφ : Spec.map (Spec.preimage (hV.fromSpec ≫ f)) = hV.fromSpec ≫ f :=
        Spec.map_preimage _
      have hφe : (Spec.preimage (hV.fromSpec ≫ f)).hom.Etale :=
        (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp
          (by rw [hφ]; infer_instance)
      letI : Algebra k Γ(X, V) := (Spec.preimage (hV.fromSpec ≫ f)).hom.toAlgebra
      haveI : Algebra.Etale k Γ(X, V) := RingHom.Etale.toAlgebra hφe
      obtain ⟨I, _, Ai, _, _, e, hAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k Γ(X, V)).mp inferInstance
      have hI : Nonempty I := by
        by_contra hne
        rw [not_nonempty_iff] at hne
        haveI : Subsingleton (∀ i, Ai i) := ⟨fun a b => funext fun i => (hne.false i).elim⟩
        exact not_subsingleton Γ(X, V) e.toEquiv.subsingleton
      obtain ⟨i⟩ := hI
      haveI := (hAi i).2
      have hsurj := IsSepClosed.algebraMap_surjective k (Ai i)
      let ε : k ≃ₐ[k] Ai i := AlgEquiv.ofBijective (Algebra.ofId k (Ai i))
        ⟨(algebraMap k (Ai i)).injective, hsurj⟩
      let ρ₀ : Γ(X, V) →ₐ[k] k := ε.symm.toAlgHom.comp ((Pi.evalAlgHom k Ai i).comp e.toAlgHom)
      have hφρ : Spec.preimage (hV.fromSpec ≫ f) ≫ CommRingCat.ofHom ρ₀.toRingHom = 𝟙 _ := by
        ext c
        exact ρ₀.commutes c
      refine ⟨Spec.map (CommRingCat.ofHom ρ₀.toRingHom) ≫ hV.fromSpec, ?_⟩
      rw [Category.assoc, ← hφ, ← Spec.map_comp, hφρ, Spec.map_id]
    let T : (Spec (.of k)).Etale := Scheme.Etale.mk (𝟙 (Spec (.of k)))
    have hT : Limits.IsTerminal T :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    have hcov : ∀ R ∈ (Scheme.smallEtaleTopology (Spec (.of k))) T, R.arrows (𝟙 T) := by
      intro R hR
      change R ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of k)) T at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
      obtain ⟨x⟩ : Nonempty (Spec (.of k)) := inferInstance
      obtain ⟨Y, f, y, hf, -, -⟩ := hR' x
      obtain ⟨σ, hσ⟩ := hsec Y.left Y.hom Y.prop ⟨y⟩
      let σ' : T ⟶ Y := MorphismProperty.Over.homMk σ (by exact hσ)
      have h := R.downward_closed hf σ'
      rwa [hT.hom_ext (σ' ≫ f) (𝟙 T)] at h
    have hsurjT : ∀ {F G : (Spec (.of k)).Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}} (φ : F ⟶ G),
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology (Spec (.of k))) φ →
        Function.Surjective (φ.app (Opposite.op T)) := by
      intro F G φ hφ s
      have h1 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology (Spec (.of k))) φ s
      have h2 := hcov _ h1
      rw [Presheaf.imageSieve_apply] at h2
      obtain ⟨t, ht⟩ := h2
      exact ⟨t, by simpa using ht⟩
    haveI : ((sheafSections (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}).obj
        (Opposite.op T)).PreservesEpimorphisms := by
      constructor
      intro F G φ hφ
      have h1 : Sheaf.IsLocallySurjective φ :=
        (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
      exact (AddCommGrpCat.epi_iff_surjective _).mpr (hsurjT φ.hom h1)
    have hP : Projective (AddCommGrpCat.of (ULift.{u+1} ℤ)) := by
      refine ⟨fun {E X} f e he => ?_⟩
      have hs := (AddCommGrpCat.epi_iff_surjective e).mp he
      obtain ⟨y, hy⟩ := hs (f ⟨1⟩)
      refine ⟨AddCommGrpCat.ofHom ((zmultiplesHom E y).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
      ext ⟨n⟩
      have h1 : (⟨n⟩ : ULift.{u+1} ℤ) = n • (⟨1⟩ : ULift.{u+1} ℤ) := by
        ext; simp
      change e (n • y) = f ⟨n⟩
      rw [h1, map_zsmul, map_zsmul, hy]
    have adj := constantSheafAdj (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1} hT
    haveI hproj := adj.map_projective _ hP
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of k))) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨q', rfl⟩ := Nat.exists_eq_add_of_le' hq
    unfold wcEtCoh
    exact Abelian.Ext.subsingleton_of_projective _ _ q'

  have overΩ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω], (ℓ : Ω) ≠ 0 →
      ∀ (n : ℕ) (c : Matrix (Fin n) (Fin n) Ω) (q : ℕ),
      Nonempty (wcEtCoh (Spec (.of (wcQuadModelRing Ω n 0 c))) ℓ q ≃
        wcEtCoh (Spec (.of Ω)) ℓ q) := by
    intro Ω _ _ hℓΩ n c q
    haveI hlft : LocallyOfFiniteType (wcQuadModelStr Ω n 0 c) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.finiteType_algebraMap.mpr inferInstance)
    obtain ⟨H, j₀, j₁, v, h1, h2, h3, h4, h5⟩ := s2 Ω n c
    have hπ := s4 Ω hℓΩ (Spec (.of (wcQuadModelRing Ω n 0 c))) (wcQuadModelStr Ω n 0 c)
    have hg := s3 (wcQuadModelStr Ω n 0 c) v _ H j₀ j₁ h5 h1 h2 h3 h4 hπ
    obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists (wcQuadModelStr Ω n 0 c) ℓ
    obtain ⟨a⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing Ω n 0 c))) ℓ q
    obtain ⟨b⟩ := wc_et_zmodext_coh_equiv (Spec (.of Ω)) ℓ q
    exact ⟨a.symm.trans ((Equiv.ofBijective _ (hg Dg q)).symm.trans b)⟩

  have hℓΩ : (ℓ : AlgebraicClosure K₀) ≠ 0 := by
    rw [← map_natCast (algebraMap K₀ (AlgebraicClosure K₀))]
    exact (map_ne_zero _).mpr hℓK₀
  have hint : (algebraMap K₀ (AlgebraicClosure K₀)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  obtain ⟨θ, hθ⟩ := s1 K₀ (AlgebraicClosure K₀) n₀ c₀
  have eK : ∀ q, Nonempty (wcEtCoh (Spec (.of (wcQuadModelRing K₀ n₀ 0 c₀))) ℓ q ≃
      wcEtCoh (Spec (.of (AlgebraicClosure K₀))) ℓ q) := by
    intro q
    obtain ⟨a⟩ := wc_et_coh_purely_inseparable_invariance K₀ (AlgebraicClosure K₀) hint _
      (wcQuadModelStr K₀ n₀ 0 c₀) ℓ q
    obtain ⟨b⟩ := wc_et_coh_iso_invariance θ ℓ q
    obtain ⟨d⟩ := overΩ (AlgebraicClosure K₀) hℓΩ n₀
      (c₀.map (algebraMap K₀ (AlgebraicClosure K₀))) q
    exact ⟨a.symm.trans (b.trans d)⟩
  refine ⟨?_, ?_⟩
  · obtain ⟨e⟩ := eK 0
    rw [Nat.card_congr e]
    exact wc_et_coh_zero_connected_card (Spec (.of (AlgebraicClosure K₀))) ℓ hℓ.ne_zero
  · intro q hq
    obtain ⟨e⟩ := eK q
    haveI := s5 (AlgebraicClosure K₀) ℓ q hq
    exact e.subsingleton

theorem wc_derived_single_hom_deg0_lift : ∀ {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C] (X : C) (K : CochainComplex C ℕ) (φ : X ⟶ K.homology 0), ∃ e : (DerivedCategory.singleFunctor C 0).obj X ⟶ (shiftFunctor (DerivedCategory C) ((0 : ℕ) : ℤ)).obj (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)), (DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).inv.app X ≫ (DerivedCategory.homologyFunctor C 0).map e ≫ ((DerivedCategory.homologyFunctor C 0).shiftIso ((0 : ℕ) : ℤ) 0 ((0 : ℕ) : ℤ) (add_zero _)).hom.app (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≫ (DerivedCategory.homologyFunctorFactors C ((0 : ℕ) : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat) ≫ (K.extendHomologyIso ComplexShape.embeddingUpNat rfl).hom = φ :=
by
  intro C _ _ _ X K φ

  let A := K.cycles 0
  let S := (HomologicalComplex.single C (ComplexShape.up ℕ) 0).obj A
  let g : S ⟶ K := HomologicalComplex.mkHomFromSingle (K.iCycles 0) (fun k _ => K.iCycles_d 0 k)
  have hg : IsIso (HomologicalComplex.homologyMap g 0) := by
    have h1 : IsIso (S.homologyπ 0) :=
      S.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero
        (by apply HomologicalComplex.single_obj_d)
    have h2 : IsIso (K.homologyπ 0) :=
      K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))
    have h3 : HomologicalComplex.cyclesMap g 0 =
        (HomologicalComplex.singleObjCyclesSelfIso (ComplexShape.up ℕ) 0 A).hom := by
      rw [← cancel_mono (K.iCycles 0), HomologicalComplex.cyclesMap_i,
        HomologicalComplex.mkHomFromSingle_f, HomologicalComplex.singleObjCyclesSelfIso_hom,
        Category.assoc]
    have h3' : IsIso (HomologicalComplex.cyclesMap g 0) := by rw [h3]; infer_instance
    have h4 := HomologicalComplex.homologyπ_naturality g 0
    have h5 : IsIso (S.homologyπ 0 ≫ HomologicalComplex.homologyMap g 0) := by
      rw [h4]; exact IsIso.comp_isIso' h3' h2
    exact IsIso.of_isIso_comp_left (S.homologyπ 0) _

  let f : (HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj A ⟶
      K.extend ComplexShape.embeddingUpNat :=
    (HomologicalComplex.extendSingleIso ComplexShape.embeddingUpNat A 0 0 rfl).inv ≫
      HomologicalComplex.extendMap g ComplexShape.embeddingUpNat
  have hf : IsIso (HomologicalComplex.homologyMap f 0) := by
    have e1 := HomologicalComplex.extendHomologyIso_hom_naturality g ComplexShape.embeddingUpNat
      (j := 0) (j' := 0) rfl
    have i1 : IsIso (HomologicalComplex.homologyMap
        (HomologicalComplex.extendMap g ComplexShape.embeddingUpNat) 0 ≫
        (K.extendHomologyIso ComplexShape.embeddingUpNat (j := 0) (j' := 0) rfl).hom) := by
      rw [e1]; exact IsIso.comp_isIso' inferInstance hg
    have i2 := IsIso.of_isIso_comp_right (HomologicalComplex.homologyMap
        (HomologicalComplex.extendMap g ComplexShape.embeddingUpNat) 0)
        (K.extendHomologyIso ComplexShape.embeddingUpNat (j := 0) (j' := 0) rfl).hom
    show IsIso (HomologicalComplex.homologyMap (_ ≫ _) 0)
    rw [HomologicalComplex.homologyMap_comp]
    exact IsIso.comp_isIso' inferInstance i2

  let u : (DerivedCategory.singleFunctor C 0).obj A ⟶ (shiftFunctor (DerivedCategory C)
      ((0 : ℕ) : ℤ)).obj (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) :=
    (DerivedCategory.singleFunctorIsoCompQ C 0).hom.app A ≫ DerivedCategory.Q.map f ≫
      (shiftFunctorZero' (DerivedCategory C) ((0 : ℕ) : ℤ) rfl).inv.app _
  have hQ : IsIso ((DerivedCategory.homologyFunctor C 0).map (DerivedCategory.Q.map f)) := by
    have e2 := DerivedCategory.homologyFunctorFactors_hom_naturality f 0
    have i3 : IsIso ((DerivedCategory.homologyFunctor C 0).map (DerivedCategory.Q.map f) ≫
        (DerivedCategory.homologyFunctorFactors C 0).hom.app _) := by
      rw [e2]; exact IsIso.comp_isIso' inferInstance hf
    exact IsIso.of_isIso_comp_right _ ((DerivedCategory.homologyFunctorFactors C 0).hom.app _)
  have hu : IsIso ((DerivedCategory.homologyFunctor C 0).map u) := by
    show IsIso ((DerivedCategory.homologyFunctor C 0).map (_ ≫ _ ≫ _))
    rw [Functor.map_comp, Functor.map_comp]
    exact IsIso.comp_isIso' inferInstance (IsIso.comp_isIso' hQ inferInstance)
  let ψ : A ⟶ K.homology 0 := (DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).inv.app A ≫ (DerivedCategory.homologyFunctor C 0).map u ≫ ((DerivedCategory.homologyFunctor C 0).shiftIso ((0 : ℕ) : ℤ) 0 ((0 : ℕ) : ℤ) (add_zero _)).hom.app (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≫ (DerivedCategory.homologyFunctorFactors C ((0 : ℕ) : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat) ≫ (K.extendHomologyIso ComplexShape.embeddingUpNat rfl).hom
  have hψ : IsIso ψ :=
    IsIso.comp_isIso' inferInstance (IsIso.comp_isIso' hu
      (IsIso.comp_isIso'
        (Iso.isIso_hom (((DerivedCategory.homologyFunctor C 0).shiftIso ((0 : ℕ) : ℤ) 0 ((0 : ℕ) : ℤ) (add_zero _)).app (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat))))
        (IsIso.comp_isIso'
          (Iso.isIso_hom ((DerivedCategory.homologyFunctorFactors C ((0 : ℕ) : ℤ)).app (K.extend ComplexShape.embeddingUpNat)))
          (Iso.isIso_hom (K.extendHomologyIso ComplexShape.embeddingUpNat rfl)))))

  have hnat : ∀ a : X ⟶ A, (DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).inv.app X ≫ (DerivedCategory.homologyFunctor C 0).map ((DerivedCategory.singleFunctor C 0).map a ≫ u) ≫ ((DerivedCategory.homologyFunctor C 0).shiftIso ((0 : ℕ) : ℤ) 0 ((0 : ℕ) : ℤ) (add_zero _)).hom.app (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≫ (DerivedCategory.homologyFunctorFactors C ((0 : ℕ) : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat) ≫ (K.extendHomologyIso ComplexShape.embeddingUpNat rfl).hom = a ≫ ψ := by
    intro a
    have nat := (DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).inv.naturality a
    simp only [Functor.id_map, Functor.comp_map] at nat
    have nat' := congrArg (fun t => t ≫ (DerivedCategory.homologyFunctor C 0).map u ≫ ((DerivedCategory.homologyFunctor C 0).shiftIso ((0 : ℕ) : ℤ) 0 ((0 : ℕ) : ℤ) (add_zero _)).hom.app (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≫ (DerivedCategory.homologyFunctorFactors C ((0 : ℕ) : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat) ≫ (K.extendHomologyIso ComplexShape.embeddingUpNat rfl).hom) nat
    simp only [Category.assoc] at nat'
    simp only [Functor.map_comp, Category.assoc]
    exact nat'.symm
  refine ⟨(DerivedCategory.singleFunctor C 0).map (φ ≫ inv ψ) ≫ u, ?_⟩
  exact (hnat (φ ≫ inv ψ)).trans (by rw [Category.assoc, IsIso.inv_hom_id, Category.comp_id])

theorem wc_et_open_imm_stalk_push_homology_iso : ∀ {W U : Scheme.{u}} (j : W ⟶ U) [IsOpenImmersion j] (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) ℕ) (w : W) (q : ℕ), Nonempty ((wcEtStalk U (j w)).obj ((((wcEtPush j).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q) ≅ (wcEtStalk W w).obj (K.homology q)) :=
