          DerivedCategory.Q.map ((F.mapCochainComplexSingleFunctor 0).hom.app Y) :=
        Functor.mapDerivedCategoryFactors_inv_app_mapDerivedCategorySingleFunctor_hom_app F Y
      rw [Functor.map_comp, Functor.map_comp, ← hl]
      simp
    set φ := CochainComplex.HomComplex.Cocycle.equivHomShift.symm
      (CochainComplex.HomComplex.Cocycle.fromSingleMk (f ≫ (R.cochainComplexXIso (q : ℤ) q rfl).inv)
        (zero_add _) ((q + 1 : ℕ) : ℤ) (by push_cast; rfl) (by
          rw [InjectiveResolution.cochainComplex_d R q (q + 1 : ℕ) q (q + 1) rfl rfl]
          simp [reassoc_of% hf])) with hφ
    set φ' := CochainComplex.HomComplex.Cocycle.equivHomShift.symm
      (CochainComplex.HomComplex.Cocycle.fromSingleMk (g ≫ (R'.cochainComplexXIso (q : ℤ) q rfl).inv)
        (zero_add _) ((q + 1 : ℕ) : ℤ) (by push_cast; rfl) (by
          rw [InjectiveResolution.cochainComplex_d R' q (q + 1 : ℕ) q (q + 1) rfl rfl]
          simp [reassoc_of% hg])) with hφ'
    have E1 : (R.extMk f (q + 1) rfl hf).hom = DerivedCategory.Q.map φ ≫
        (DerivedCategory.Q.commShiftIso (q : ℤ)).hom.app R.cochainComplex ≫
        (shiftFunctor (DerivedCategory C) (q : ℤ)).map (inv (DerivedCategory.Q.map R.ι')) := by
      rw [InjectiveResolution.extMk_hom]
      simp only [ShiftedHom.mk₀_comp, ShiftedHom.comp_mk₀, ShiftedHom.map,
        DerivedCategory.singleFunctorIsoCompQ_hom_app,
        DerivedCategory.singleFunctorIsoCompQ_inv_app, Category.id_comp, Category.assoc]
      erw [Category.comp_id]
    have E2 : (R'.extMk g (q + 1) rfl hg).hom = DerivedCategory.Q.map φ' ≫
        (DerivedCategory.Q.commShiftIso (q : ℤ)).hom.app R'.cochainComplex ≫
        (shiftFunctor (DerivedCategory D) (q : ℤ)).map (inv (DerivedCategory.Q.map R'.ι')) := by
      rw [InjectiveResolution.extMk_hom]
      simp only [ShiftedHom.mk₀_comp, ShiftedHom.comp_mk₀, ShiftedHom.map,
        DerivedCategory.singleFunctorIsoCompQ_hom_app,
        DerivedCategory.singleFunctorIsoCompQ_inv_app, Category.id_comp, Category.assoc]
      erw [Category.comp_id]
    have Cb : (F.mapCochainComplexSingleFunctor 0).inv.app X ≫
        (F.mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫
        ((F.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso (q : ℤ)).hom.app R.cochainComplex ≫
        (shiftFunctor (CochainComplex D ℤ) (q : ℤ)).map Θ = φ' := by
      apply HomologicalComplex.from_single_hom_ext
      simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_commShiftIso_hom_app_f,
        Functor.mapHomologicalComplex_map_f, CochainComplex.shiftFunctor_map_f']
      rw [hφ, hφ', CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply,
        CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply,
        CochainComplex.HomComplex.Cocycle.homOf_f, CochainComplex.HomComplex.Cocycle.homOf_f,
        CochainComplex.HomComplex.Cocycle.rightShift_coe, CochainComplex.HomComplex.Cocycle.rightShift_coe,
        CochainComplex.HomComplex.Cochain.rightShift_v _ _ _ _ 0 0 _ (q : ℤ) (by simp),
        CochainComplex.HomComplex.Cochain.rightShift_v _ _ _ _ 0 0 _ (q : ℤ) (by simp),
        CochainComplex.HomComplex.Cocycle.fromSingleMk_coe, CochainComplex.HomComplex.Cocycle.fromSingleMk_coe,
        CochainComplex.HomComplex.Cochain.fromSingleMk_v, CochainComplex.HomComplex.Cochain.fromSingleMk_v]
      have gen : ∀ (a b : ℤ) (h : a = b), F.map (eqToHom (congrArg R.cochainComplex.X h)) ≫ Θ.f b =
          Θ.f a ≫ eqToHom (congrArg R'.cochainComplex.X h) := by
        intro a b h; subst h; simp
      have hq0 : (q : ℤ) = 0 + (q : ℤ) := (zero_add _).symm
      have k1 : F.map (R.cochainComplex.shiftFunctorObjXIso (q : ℤ) 0 (q : ℤ) (by simp)).inv ≫
          Θ.f (0 + (q : ℤ)) =
          Θ.f (q : ℤ) ≫ (R'.cochainComplex.shiftFunctorObjXIso (q : ℤ) 0 (q : ℤ) (by simp)).inv := by
        simpa [CochainComplex.shiftFunctorObjXIso, HomologicalComplex.XIsoOfEq] using gen _ _ hq0
      rw [hgΘ]
      simp only [Functor.mapCochainComplexSingleFunctor,
        HomologicalComplex.singleMapHomologicalComplex_inv_app_self, Functor.map_comp, Category.assoc,
        Iso.map_inv_hom_id_assoc, Iso.hom_inv_id_assoc]
      exact congrArg (fun t => _ ≫ _ ≫ _ ≫ t)
        ((congrArg (fun t => F.map (R.cochainComplex.shiftFunctorObjXIso (q : ℤ) 0 (q : ℤ) (by simp)).inv ≫ t)
          (Category.id_comp _)).trans k1)
    have hsX : (F.mapDerivedCategorySingleFunctor 0).inv.app X ≫
        F.mapDerivedCategoryFactors.hom.app ((CochainComplex.singleFunctor C 0).obj X) =
        DerivedCategory.Q.map ((F.mapCochainComplexSingleFunctor 0).inv.app X) :=
      Functor.mapDerivedCategorySingleFunctor_inv_app_mapDerivedCategoryFactors_hom_app F X
    have n1 : F.mapDerivedCategory.map
          ((shiftFunctor (DerivedCategory C) (q : ℤ)).map (inv (DerivedCategory.Q.map R.ι'))) ≫
        (F.mapDerivedCategory.commShiftIso (q : ℤ)).hom.app ((DerivedCategory.singleFunctor C 0).obj Y) =
        (F.mapDerivedCategory.commShiftIso (q : ℤ)).hom.app (DerivedCategory.Q.obj R.cochainComplex) ≫
        (shiftFunctor (DerivedCategory D) (q : ℤ)).map
          (F.mapDerivedCategory.map (inv (DerivedCategory.Q.map R.ι'))) :=
      Functor.commShiftIso_hom_naturality _ _ _
    have tail : (shiftFunctor (DerivedCategory D) (q : ℤ)).map
          (F.mapDerivedCategory.map (inv (DerivedCategory.Q.map R.ι'))) ≫
        (shiftFunctor (DerivedCategory D) (q : ℤ)).map ((F.mapDerivedCategorySingleFunctor 0).hom.app Y) ≫
        (shiftFunctor (DerivedCategory D) (q : ℤ)).map ((DerivedCategory.singleFunctor D 0).map κ) =
        (shiftFunctor (DerivedCategory D) (q : ℤ)).map (F.mapDerivedCategoryFactors.hom.app R.cochainComplex) ≫
        (shiftFunctor (DerivedCategory D) (q : ℤ)).map (DerivedCategory.Q.map Θ) ≫
        (shiftFunctor (DerivedCategory D) (q : ℤ)).map (inv (DerivedCategory.Q.map R'.ι')) := by
      rw [← Functor.map_comp, ← Functor.map_comp, star, Functor.map_comp, Functor.map_comp]
    have h2 := (Functor.commShiftIso_comp_hom_app DerivedCategory.Q F.mapDerivedCategory (q : ℤ)
      R.cochainComplex).symm
    have h4 := NatTrans.shift_app_comm F.mapDerivedCategoryFactors.hom (q : ℤ) R.cochainComplex
    have h5 := Functor.commShiftIso_comp_hom_app (F.mapHomologicalComplex (ComplexShape.up ℤ))
      DerivedCategory.Q (q : ℤ) R.cochainComplex
    have h6 := (Functor.commShiftIso_hom_naturality DerivedCategory.Q Θ (q : ℤ)).symm
    have h7 := Functor.mapDerivedCategoryFactors_hom_naturality F φ
    apply Abelian.Ext.ext
    rw [Abelian.Ext.comp_hom, Abelian.Ext.mk₀_hom, ShiftedHom.comp_mk₀, Abelian.Ext.mapExactFunctor_hom,
      E1, E2]
    simp only [ShiftedHom.map, Functor.map_comp, Category.assoc]
    rw [reassoc_of% n1, tail, reassoc_of% h2, reassoc_of% h4, h5, Category.assoc, reassoc_of% h6,
      reassoc_of% h7, reassoc_of% hsX, ← DerivedCategory.Q.map_comp_assoc, ← DerivedCategory.Q.map_comp_assoc,
      ← DerivedCategory.Q.map_comp_assoc]
    simp only [Category.assoc]
    rw [Cb]

  have hev : ∀ (M : Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}),
      Function.Injective (fun g : (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M =>
        (g.hom.app (Opposite.op (wcEtTop S'))).hom
          (wcConstSec S' (ULift.{u+1} ℤ) (wcEtTop S') (ULift.up 1))) := by
    intro M
    have hT : Limits.IsTerminal (wcEtTop S') :=
      @MorphismProperty.Over.mkIdTerminal Scheme _ @AlgebraicGeometry.Etale S'
        MorphismProperty.IsMultiplicative.toContainsIdentities
    let adj := constantSheafAdj (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1} hT
    let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
      { toFun := fun φ => φ.hom (ULift.up 1)
        invFun := fun x => AddCommGrpCat.ofHom
          ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
        left_inv := fun φ => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          rintro ⟨n⟩
          have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
            apply ULift.ext
            simp
          change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
          rw [zmultiplesHom_apply, hn, map_zsmul]
        right_inv := fun x => by
          change (zmultiplesHom X x) (1 : ℤ) = x
          rw [zmultiplesHom_apply, one_zsmul] }
    have key : (fun g : (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M =>
          (g.hom.app (Opposite.op (wcEtTop S'))).hom
            (wcConstSec S' (ULift.{u+1} ℤ) (wcEtTop S') (ULift.up 1))) =
        ⇑((adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans
          (ev (M.obj.obj (Opposite.op (wcEtTop S'))))) := by
      funext g
      rfl
    rw [key]
    exact Equiv.injective _
  have hgq : f' = A.ε ≫ A.L.map f ≫ θ.f q := by
    apply hev
    show _ = ((θ.f q).hom.app _).hom (((A.L.map f).hom.app _).hom ((A.ε.hom.app _).hom _))
    rw [A.epsNorm ((Category.comp_id _).trans (Category.id_comp _).symm)]
    exact hval.trans (congrArg (fun y => ((θ.f q).hom.app (Opposite.op (wcEtTop S'))).hom y)
      (A.nut.2 _ _ f _ _ _ _ _))

  obtain ⟨Θ, hΘf, hΘ⟩ := G2 A.L A.κ.hom R R' θ hθ
  have hg : (A.L.map f ≫ θ.f q) ≫ R'.cocomplex.d q (q + 1) = 0 := by
    have hc := θ.comm q (q + 1)
    rw [Functor.mapHomologicalComplex_obj_d] at hc
    rw [Category.assoc, hc, ← A.L.map_comp_assoc, hf, Functor.map_zero, Limits.zero_comp]
  have hgΘ : A.L.map f ≫ θ.f q = A.L.map (f ≫ (R.cochainComplexXIso q q rfl).inv) ≫ Θ.f q ≫
      (R'.cochainComplexXIso q q rfl).hom := by
    rw [hΘf q]
    simp only [Functor.map_comp, Category.assoc, Iso.map_inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}) := HasExt.standard _
  have key := G3 A.L A.κ.hom R R' Θ hΘ q f hf _ hg hgΘ
  subst hgq
  show (Abelian.Ext.mk₀ A.ε).comp ((Abelian.Ext.mapExactFunctor A.L (R.extMk f (q + 1) rfl hf)).comp
    (Abelian.Ext.mk₀ A.κ.hom) (add_zero q)) (zero_add q) = _
  rw [key, InjectiveResolution.mk₀_comp_extMk]

theorem wc_lsi_adjdata_inv : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (m : ℕ), ∃ (A : wcR2gsAdjData g m) (e : A.L ≅ wcEtInv g), ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) (x : G.obj.obj (Opposite.op V)), ((e.hom.app G).hom.app (Opposite.op O)).hom ((A.ρ G).ρ V O h hh x) = wcEtInvRho g G V O h hh x :=
by
  intro S Z g m
  obtain ⟨hadd, hlim, hcolim⟩ := wc_etInv_exact g
  have hadj : Nonempty (wcEtInv g ⊣ wcEtPush g) := wc_qm_inv_push_adj g
  choose ρ hρ using fun G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} =>
    wc_etInvRho_univ_transport g G
  have nut : wcR2gsNUT g (wcEtInv g) ρ := by
    refine ⟨fun G => (hρ G).2, ?_⟩
    intro G G' ψ V O h hh x
    rw [(hρ G').1, (hρ G).1, wc_etInvRho_natural]
  have hg0 : g ≫ (wcEtTop S).hom = (wcEtTop Z).hom ≫ g :=
    (Category.comp_id g).trans (Category.id_comp g).symm
  obtain ⟨ε, hε⟩ := (wc_et_const_hom_eval_bij Z ((wcEtInv g).obj (wcR2gsZ S))).2
    ((ρ (wcR2gsZ S)).ρ (wcEtTop S) (wcEtTop Z) g hg0
      (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1)))
  obtain ⟨κ, hκ⟩ := wc_r2gs_adj_const_zmod_norm g m (wcEtInv g) hadj ρ nut
  refine ⟨wcR2gsAdjData.mk (wcEtInv g) hadj hadd hlim hcolim ρ nut ε (fun _ => hε) κ hκ,
    Iso.refl _, ?_⟩
  intro G V O h hh x
  exact (hρ G).1 V O h hh x

theorem wc_lsi_exact_aug_lift : ∀ {C D : Type*} [Category C] [Abelian C] [Category D] [Abelian D] (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] (M : C) (K : CochainComplex C ℕ) (ι : (CochainComplex.single₀ C).obj M ⟶ K), QuasiIso ι → ∀ (M' : D) (κ : F.obj M ≅ M') (R : InjectiveResolution M'), ∃ θ : (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K ⟶ R.cocomplex, F.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0) ≫ θ.f 0 = κ.hom ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M').inv ≫ R.ι.f 0 :=
by
  intro C D _ _ _ _ F _ _ _ M K ι hι M' κ R
  have hcyc : IsIso (HomologicalComplex.cyclesMap ι 0) := by
    have h1 := HomologicalComplex.homologyπ_naturality ι 0
    have : IsIso (HomologicalComplex.cyclesMap ι 0 ≫ K.homologyπ 0) := by
      rw [← h1]; infer_instance
    exact IsIso.of_isIso_comp_right _ (K.homologyπ 0)
  let φ : M ⟶ K.cycles 0 :=
    (HomologicalComplex.singleObjCyclesSelfIso (ComplexShape.up ℕ) 0 M).inv ≫
      HomologicalComplex.cyclesMap ι 0
  have : IsIso φ := by dsimp only [φ]; infer_instance
  have hφ : φ ≫ K.iCycles 0 =
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0 := by
    simp only [φ, Category.assoc, HomologicalComplex.cyclesMap_i,
      HomologicalComplex.singleObjCyclesSelfIso_inv_iCycles_assoc]
  have hw : ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0) ≫ K.d 0 1 = 0 := by
    rw [← hφ, Category.assoc, HomologicalComplex.iCycles_d, Limits.comp_zero]
  have hSc : (ShortComplex.mk (K.iCycles 0) (K.d 0 1) (K.iCycles_d 0 1)).Exact :=
    ShortComplex.exact_of_f_is_kernel _ (K.cyclesIsKernel 0 1 (by simp))
  have hSa : (ShortComplex.mk _ (K.d 0 1) hw).Exact := by
    have e : ShortComplex.mk _ (K.d 0 1) hw ≅
        ShortComplex.mk (K.iCycles 0) (K.d 0 1) (K.iCycles_d 0 1) :=
      ShortComplex.isoMk (asIso φ) (Iso.refl _) (Iso.refl _)
        (by dsimp; rw [Category.comp_id]; exact hφ) (by simp)
    exact ShortComplex.exact_of_iso e.symm hSc
  have hD0 := hSa.map F
  have hmono0 : Mono ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0) := by
    rw [← hφ]; infer_instance
  have hmono : Mono (F.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0)) := by
    infer_instance
  have hsucc : ∀ n : ℕ, ((K.sc' n (n+1) (n+2)).map F).Exact := by
    intro n
    have h1 : K.ExactAt (n+1) :=
      (quasiIsoAt_iff_exactAt ι (n+1) (CochainComplex.exactAt_succ_single_obj M n)).1 inferInstance
    exact ((K.exactAt_iff' n (n+1) (n+2) (CochainComplex.prev_nat_succ n) (by simp)).1 h1).map F
  let P := (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K
  let g : F.obj M ⟶ R.cocomplex.X 0 :=
    κ.hom ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M').inv ≫ R.ι.f 0
  have hg : g ≫ R.cocomplex.d 0 1 = 0 := by
    simp only [g, Category.assoc, InjectiveResolution.ι_f_zero_comp_complex_d, Limits.comp_zero]
  let θ₀ : P.X 0 ⟶ R.cocomplex.X 0 :=
    Injective.factorThru g (F.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0))
  have hθ₀ : F.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0) ≫ θ₀ = g :=
    Injective.comp_factorThru _ _
  have hx1 : (ShortComplex.map (ShortComplex.mk _ (K.d 0 1) hw) F).f ≫ (θ₀ ≫ R.cocomplex.d 0 1) = 0 := by
    show F.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0) ≫
      θ₀ ≫ R.cocomplex.d 0 1 = 0
    rw [reassoc_of% hθ₀, hg]
  let θ₁ : P.X 1 ⟶ R.cocomplex.X 1 := hD0.descToInjective (θ₀ ≫ R.cocomplex.d 0 1) hx1
  have hθ₁ : P.d 0 1 ≫ θ₁ = θ₀ ≫ R.cocomplex.d 0 1 := hD0.comp_descToInjective _ _
  let θ : P ⟶ R.cocomplex := CochainComplex.mkHom P R.cocomplex θ₀ θ₁ hθ₁.symm
    (fun n p => ⟨(hsucc n).descToInjective (p.2.1 ≫ R.cocomplex.d (n+1) (n+2)) (by
        show P.d n (n+1) ≫ p.2.1 ≫ R.cocomplex.d (n+1) (n+2) = 0
        rw [← Category.assoc, ← p.2.2, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero]),
      ((hsucc n).comp_descToInjective _ _).symm⟩)
  refine ⟨θ, ?_⟩
  show _ ≫ (CochainComplex.mkHom P R.cocomplex θ₀ θ₁ hθ₁.symm _).f 0 = g
  rw [CochainComplex.mkHom_f_0]
  exact hθ₀

theorem wc_lsi_inv_comp_transport : ∀ {P' P M : Scheme.{u}} (a : P' ⟶ P) (p : P ⟶ M) (p' : P' ⟶ M) (hap : a ≫ p = p') (m : ℕ) (A : wcR2gsAdjData p m) (Ad : wcR2gsAdjData a m) (A' : wcR2gsAdjData p' m) (e : A.L ≅ wcEtInv p) (ea : Ad.L ≅ wcEtInv a) (e' : A'.L ≅ wcEtInv p'), (∀ (G : Sheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}) (V : M.Etale) (O : P.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p) (x : G.obj.obj (Opposite.op V)), ((e.hom.app G).hom.app (Opposite.op O)).hom ((A.ρ G).ρ V O h hh x) = wcEtInvRho p G V O h hh x) → (∀ (G : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) (V : P.Etale) (O : P'.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ a) (x : G.obj.obj (Opposite.op V)), ((ea.hom.app G).hom.app (Opposite.op O)).hom ((Ad.ρ G).ρ V O h hh x) = wcEtInvRho a G V O h hh x) → (∀ (G : Sheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}) (V : M.Etale) (O : P'.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p') (x : G.obj.obj (Opposite.op V)), ((e'.hom.app G).hom.app (Opposite.op O)).hom ((A'.ρ G).ρ V O h hh x) = wcEtInvRho p' G V O h hh x) → ∃ Φ : A'.L ⟶ A.L ⋙ Ad.L, ∀ (F : Sheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}) (V : M.Etale) (O₁ : P.Etale) (h₁ : O₁.left ⟶ V.left) (hh₁ : h₁ ≫ V.hom = O₁.hom ≫ p) (O₂ : P'.Etale) (h₂ : O₂.left ⟶ O₁.left) (hh₂ : h₂ ≫ O₁.hom = O₂.hom ≫ a) (k : O₂.left ⟶ V.left) (hk : h₂ ≫ h₁ = k) (hh : k ≫ V.hom = O₂.hom ≫ p') (x : F.obj.obj (Opposite.op V)), ((Φ.app F).hom.app (Opposite.op O₂)).hom ((A'.ρ F).ρ V O₂ k hh x) = (Ad.ρ (A.L.obj F)).ρ O₁ O₂ h₂ hh₂ ((A.ρ F).ρ V O₁ h₁ hh₁ x) :=
by
  intro P' P M a p p' hap m A Ad A' e ea e' He Hea He'
  let CI : wcEtInv p' ⟶ wcEtInv p ⋙ wcEtInv a :=
    { app := fun F => wcEtInvCompInv a p p' hap F
      naturality := fun F₁ F₂ γ => wc_etInvCompInv_natural a p p' hap γ }
  refine ⟨e'.hom ≫ CI ≫ Functor.whiskerLeft (wcEtInv p) ea.inv ≫
    Functor.whiskerRight e.inv Ad.L, ?_⟩
  intro F V O₁ h₁ hh₁ O₂ h₂ hh₂ k hk hh x
  subst hk
  have s1 := He' F V O₂ (h₂ ≫ h₁) hh x
