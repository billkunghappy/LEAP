    intro k
    exact wc_proet_push_torsion_zero_above F'' D.Yt.left (wcP1Over F'').left (wcP1Over F'').hom
      D.f (ℓ ^ k) (n - 1) (hchar k)
      (fun b => wc_pencil_geom_fibre_dim_le F' F'' Y n hn2 D _ (wcEtGeomPt (wcP1Over F'').left b))
      q hq

  have hD : ∀ p q : ℕ, 2 * n - 1 < p + q →
      ∀ y : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p, y = 0 := by
    intro p q hpq y
    by_cases h3 : 3 ≤ p
    · exact wc_pencil_E2_vanish F' F'' Y n hn2 D ℓ hℓ hP p q h3 y
    by_cases hq : 2 * (n - 1) < q
    · obtain ⟨g, y', rfl⟩ := wc_pencil_Rq_ladic_lift F' F'' Y n hn2 D ℓ hℓ hP q p y
      have h1 : (𝟙 (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ]))) = 0 :=
