theorem wc_qmbst_inv_homology_class : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (C : CochainComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ℕ) (q : ℕ), ∃ ε : (wcQmInv g).obj (C.homology q) ≅ (((wcQmInv g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology q, ∀ (V : Y.Etale) (O : X.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) (zc : (C.cycles q).obj.obj (Opposite.op V)), ∃ zc' : ((((wcQmInv g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).cycles q).obj.obj (Opposite.op O), (((((wcQmInv g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).iCycles q).hom.app (Opposite.op O)).hom zc' = wcEtInvRho g (C.X q) V O h hh (((C.iCycles q).hom.app (Opposite.op V)).hom zc) ∧ (ε.hom.hom.app (Opposite.op O)).hom (wcEtInvRho g (C.homology q) V O h hh (((C.homologyπ q).hom.app (Opposite.op V)).hom zc)) = (((((wcQmInv g).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homologyπ q).hom.app (Opposite.op O)).hom zc' :=
