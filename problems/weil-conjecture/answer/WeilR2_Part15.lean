  have hsepA : IsSepClosed (IsLocalRing.ResidueField A) := inferInstance

  obtain ⟨ι', hι'⟩ : ∃ ι' : (wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk xb ⟶
      CommRingCat.of A, ι'.hom = ι := ⟨CommRingCat.ofHom ι, rfl⟩
  haveI hι'loc : IsLocalHom ι'.hom := by rw [hι']; exact hιloc
  obtain ⟨γ, hγ⟩ : ∃ γ : Spec (CommRingCat.of A) ⟶ (wcGeomPoint F'' (wcP1Over F'') hP).left,
      γ = Spec.map ι' ≫ (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk xb := ⟨_, rfl⟩
  have hSW : WeaklyEtale (Spec.map ι') := by
    letI : Algebra ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk xb) A := ι.toAlgebra
    have hι'eq : ι' = CommRingCat.ofHom ι := CommRingCat.hom_ext hι'
    rw [hι'eq]
    exact wc_lfi_specMap_weaklyEtale _ _ hwe
  have hγwe : WeaklyEtale γ := by
    rw [hγ]
    exact MorphismProperty.comp_mem @WeaklyEtale _ _ hSW
      (wc_lfi_fromSpecStalk_weaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).left xb)
  have hT : WeaklyEtale (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) :=
    MorphismProperty.comp_mem @WeaklyEtale γ (wcGeomPoint F'' (wcP1Over F'') hP).hom hγwe hP
  let V₀ : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hT
  let g₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP := MorphismProperty.Over.homMk γ rfl trivial

  obtain ⟨θ, hθloc, hθ1⟩ : ∃ θ : (wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk xb ⟶
      (wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk xb,
      IsLocalHom θ.hom ∧ Spec.map θ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk xb =
        (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk xb ≫
          (wcGeomFrob F'' (wcP1Over F'') hP).left := by
    refine ⟨((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalkCongr
      (Inseparable.of_eq hφx)).inv ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left.stalkMap xb, ?_, ?_⟩
    · rw [CommRingCat.hom_comp]; infer_instance
    · have key : ∀ (y z : (wcGeomPoint F'' (wcP1Over F'') hP).left) (hy : y = z),
          Spec.map ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalkCongr
            (Inseparable.of_eq hy)).inv ≫
            (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk z =
            (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecStalk y := by
        intro y z hy; subst hy; simp
      rw [Spec.map_comp, Category.assoc, key _ _ hφx, Scheme.SpecMap_stalkMap_fromSpecStalk]
  haveI := hθloc
  obtain ⟨ρ, ⟨hρloc, hρι⟩, -⟩ := huniv A (ι.comp θ.hom) (RingHom.isLocalHom_comp ι θ.hom)
  have hcomp : ι' ≫ CommRingCat.ofHom ρ = θ ≫ ι' := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, hι']
    exact hρι
  have hI2 : Spec.map (CommRingCat.ofHom ρ) ≫ γ = γ ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left := by
    rw [hγ, ← Category.assoc, ← Spec.map_comp, hcomp, Spec.map_comp]
    simp only [Category.assoc]
    rw [hθ1]
  have hw : Spec.map (CommRingCat.ofHom ρ) ≫ γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
      γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
    rw [← Category.assoc, hI2, Category.assoc, hΦfst]
  let φ₀ : V₀ ⟶ V₀ := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom ρ)) hw trivial
  have hφ₀g : φ₀ ≫ g₀ = g₀ ≫ wcGeomFrob F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.Hom.ext hI2

  have hmax' : Ideal.map ι'.hom (IsLocalRing.maximalIdeal
      ((wcGeomPoint F'' (wcP1Over F'') hP).left.presheaf.stalk xb)) =
      IsLocalRing.maximalIdeal A := by rw [hι']; exact hmax
  have hres' : ∀ a : A, ∃ b, a - ι'.hom b ∈ IsLocalRing.maximalIdeal A := by rw [hι']; exact hres
  have hLF := wc_lfi_local_spec_fibre (wcGeomPoint F'' (wcP1Over F'') hP).left xb A ι' hmax' hres'
  rw [← hγ] at hLF
  haveI hLF2 := hLF.2
  obtain ⟨τ, hτ⟩ : ∃ τ : (wcGeomPoint F'' (wcP1Over F'') hP).left.residueField xb ⟶
      CommRingCat.of (AlgebraicClosure F''),
      Spec.map τ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecResidueField xb = ub := by
    rw [hxb]
    exact ⟨_, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ _ ub⟩
  have hfibAux : ∀ t (_ : Spec.map τ ≫
      (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecResidueField xb = t),
      IsIso (Limits.pullback.snd γ t) := by
    rintro t rfl
    have h2 : Limits.pullback.snd γ (Spec.map τ ≫
        (wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecResidueField xb) =
        (Limits.pullbackLeftPullbackSndIso γ
          ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecResidueField xb) (Spec.map τ)).inv ≫
          Limits.pullback.snd (Limits.pullback.snd γ
            ((wcGeomPoint F'' (wcP1Over F'') hP).left.fromSpecResidueField xb)) (Spec.map τ) := by
      rw [← Limits.pullbackLeftPullbackSndIso_hom_snd, Iso.inv_hom_id_assoc]
    rw [h2]
    infer_instance
  haveI hfib : IsIso (Limits.pullback.snd γ ub) := hfibAux ub hτ

  have hγpt : γ (IsLocalRing.closedPoint A) = xb := by
    have h1 : IsLocalRing.closedPoint A ∈ γ ⁻¹' {xb} := by
      rw [hLF.1]; exact Set.mem_singleton _
    exact h1
  have hv : (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (IsLocalRing.closedPoint A) =
      u0 (IsLocalRing.closedPoint F'') := by
    have h2 : (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (IsLocalRing.closedPoint A) =
        (wcGeomPoint F'' (wcP1Over F'') hP).hom (γ (IsLocalRing.closedPoint A)) := by
      first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
    exact h2.trans ((congrArg _ hγpt).trans hfx)

  have hpaste := IsPullback.paste_vert (IsPullback.of_hasPullback γ ub) hsq
  have key : inv (Limits.pullback.snd γ ub) ≫ Limits.pullback.fst γ ub ≫
      Spec.map (CommRingCat.ofHom ρ) =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        inv (Limits.pullback.snd γ ub) ≫ Limits.pullback.fst γ ub := by
    have e1 : (inv (Limits.pullback.snd γ ub) ≫ Limits.pullback.fst γ ub ≫
        Spec.map (CommRingCat.ofHom ρ)) ≫ γ =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ ub := by
      simp only [Category.assoc]
      rw [hI2, Limits.pullback.condition_assoc, IsIso.inv_hom_id_assoc, hfr]
    have e2 : (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        inv (Limits.pullback.snd γ ub) ≫ Limits.pullback.fst γ ub) ≫ γ =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ ub := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition, IsIso.inv_hom_id_assoc]
    have hl : Limits.pullback.lift _ _ e1 = Limits.pullback.lift _ _ e2 := by
      rw [← cancel_mono (Limits.pullback.snd γ ub), Limits.pullback.lift_snd,
        Limits.pullback.lift_snd]
    have h3 := congrArg (fun k => k ≫ Limits.pullback.fst γ ub) hl
    simpa only [Limits.pullback.lift_fst] using h3
  have hψf : ∀ {Z : Scheme.{u}} (h : Spec (CommRingCat.of A) ⟶ Z),
      hpaste.isoPullback.hom ≫ Limits.pullback.fst
        (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) u0 ≫ h =
      Limits.pullback.fst γ ub ≫ h := by
    intro Z h
    rw [← Category.assoc, hpaste.isoPullback_hom_fst]
  refine ⟨V₀, g₀, φ₀, A, iA, iAh, hsepA, Iso.refl _,
    hpaste.isoPullback.symm ≪≫ asIso (Limits.pullback.snd γ ub), ?_, hφ₀g, ?_, ?_⟩
  · first
      | exact hv
      | simpa using hv
  · show (hpaste.isoPullback.inv ≫ Limits.pullback.snd γ ub) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
        Limits.pullback.snd (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) u0
    have e := hpaste.isoPullback_hom_snd
    exact (Category.assoc _ _ _).trans ((congrArg (hpaste.isoPullback.inv ≫ ·) e.symm).trans
      (Iso.inv_hom_id_assoc _ _))
  · show (inv (Limits.pullback.snd γ ub) ≫ hpaste.isoPullback.hom) ≫
        Limits.pullback.fst (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) u0 ≫
          Spec.map (CommRingCat.ofHom ρ) =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        (inv (Limits.pullback.snd γ ub) ≫ hpaste.isoPullback.hom) ≫
          Limits.pullback.fst (γ ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) u0
    simp only [Category.assoc]
    rw [hψf, hpaste.isoPullback_hom_fst]
    exact key

theorem wc_pencil_fibre_gi (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) :
    GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f D.u0)).hom :=
by
  classical
  have hB := IsPullback.of_hasPullback D.f D.u0

  have hsm : Smooth (Limits.pullback.snd D.f D.u0) := by
    haveI : IsZariskiLocalAtSource @Smooth := HasRingHomProperty.instIsZariskiLocalAtSource
    have hpt : ∀ x : (Limits.pullback D.f D.u0 : Scheme), ∃ U : D.Yt.left.Opens,
        (Limits.pullback.fst D.f D.u0) x ∈ U ∧ Smooth (U.ι ≫ D.f) := by
      intro x
      apply D.smooth_off
      intro i hi
      have h1 : D.f ((Limits.pullback.fst D.f D.u0) x) = (D.S i) (IsLocalRing.closedPoint F'') := by
        rw [hi, ← D.hxs i]
        rfl
      have h2 : D.f ((Limits.pullback.fst D.f D.u0) x) =
          D.u0 ((Limits.pullback.snd D.f D.u0) x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
      have h3 : (Limits.pullback.snd D.f D.u0) x = IsLocalRing.closedPoint F'' :=
        Subsingleton.elim _ _
      have h4 := h2.symm.trans h1
      rw [h3] at h4
      exact D.hu0S i h4
    choose U hU hUs using hpt
    refine IsZariskiLocalAtSource.of_iSup_eq_top
      (fun x => (Limits.pullback.fst D.f D.u0) ⁻¹ᵁ (U x)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hU x⟩
    · intro x
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst D.f D.u0) (U x)) hB
      exact MorphismProperty.of_isPullback (P := @Smooth) hsq (hUs x)
  show GeometricallyIrreducible (Limits.pullback.snd D.f D.u0)
  rw [GeometricallyIrreducible.eq_geometrically]
  intro K _ y Z fst snd h

  haveI : Smooth snd := MorphismProperty.of_isPullback (P := @Smooth) h hsm
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian snd

  haveI : ConnectedSpace Z := by
    let yb : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of K) :=
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    have hZ' := IsPullback.paste_horiz h hB
    haveI := D.fconn (AlgebraicClosure K) (yb ≫ y ≫ D.u0)
    have hQ := IsPullback.of_hasPullback D.f (yb ≫ y ≫ D.u0)
    have w : Limits.pullback.fst D.f (yb ≫ y ≫ D.u0) ≫ D.f =
        (Limits.pullback.snd D.f (yb ≫ y ≫ D.u0) ≫ yb) ≫ (y ≫ D.u0) := by
      rw [Limits.pullback.condition, Category.assoc]
    let c := hZ'.lift _ _ w
    have hc1 : c ≫ (fst ≫ Limits.pullback.fst D.f D.u0) =
        Limits.pullback.fst D.f (yb ≫ y ≫ D.u0) := hZ'.lift_fst _ _ w
    have hc2 : c ≫ snd = Limits.pullback.snd D.f (yb ≫ y ≫ D.u0) ≫ yb := hZ'.lift_snd _ _ w
    have houter : IsPullback (c ≫ (fst ≫ Limits.pullback.fst D.f D.u0))
        (Limits.pullback.snd D.f (yb ≫ y ≫ D.u0)) D.f (yb ≫ (y ≫ D.u0)) := by
      rw [hc1]; exact hQ
    have hc : IsPullback c (Limits.pullback.snd D.f (yb ≫ y ≫ D.u0)) snd yb :=
      IsPullback.of_right houter hc2 hZ'
    haveI : Surjective c := MorphismProperty.of_isPullback (P := @Surjective) hc.flip inferInstance
    exact Function.Surjective.connectedSpace (Surjective.surj (f := c)) c.continuous

  have hdom : ∀ w : Z, IsDomain (Z.presheaf.stalk w) := by
    intro w
    obtain ⟨U, hU, V, hV, hwV, e, hss⟩ := Smooth.exists_isStandardSmooth snd w
    letI := (Scheme.Hom.appLE snd U V e).hom.toAlgebra
    have hss' : Algebra.IsStandardSmooth Γ(Spec (.of K), U) Γ(Z, V) := hss
    obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hss'.out
    have hrel : RingHom.IsStandardSmoothOfRelativeDimension P.dimension
        (Scheme.Hom.appLE snd U V e).hom := ⟨⟨ι, σ, hσ, hι, P, rfl⟩⟩
    have himg : V.ι ''ᵁ ⊤ = V := Scheme.Opens.ι_image_top V
    have hsmV : SmoothOfRelativeDimension P.dimension (V.ι ≫ snd) := by
      haveI : IsAffine (V : Scheme) := hV
      have e2 : ⊤ ≤ V.ι ⁻¹ᵁ V := (Scheme.Opens.ι_preimage_self V).ge
      have e' : ⊤ ≤ (V.ι ≫ snd) ⁻¹ᵁ U := by
        intro z hz
        exact e (e2 hz)
      refine SmoothOfRelativeDimension.mk (fun x => ⟨U, hU, ⊤, isAffineOpen_top _, trivial,
        e', ?_⟩)
      rw [← Scheme.Hom.appLE_comp_appLE V.ι snd U V ⊤ e e2, CommRingCat.hom_comp,
        Scheme.Opens.ι_appLE]
      have hle : V.ι ''ᵁ ⊤ ≤ V := himg.le
      haveI : IsIso (homOfLE hle) :=
        ⟨⟨homOfLE himg.ge, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
      have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0
          (Z.presheaf.map (homOfLE hle).op).hom :=
        RingHom.IsStandardSmoothOfRelativeDimension.equiv
          (asIso (Z.presheaf.map (homOfLE hle).op)).commRingCatIsoToRingEquiv
      have := h0.comp hrel
      rwa [zero_add] at this
    have hV' := wcpa_smooth_stalk_isDomain K V (V.ι ≫ snd) P.dimension ⟨w, hwV⟩
    exact MulEquiv.isDomain _
      (Scheme.Opens.stalkIso V ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.toMulEquiv
  exact wcpa_irreducible_of_connected_domain_stalks Z hdom

theorem wc_pencil_fibre_props (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) :
    GeometricallyIrreducible (Limits.pullback.snd D.f D.u0) ∧
      IsProper (Limits.pullback.snd D.f D.u0) ∧
      SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd D.f D.u0) :=
by
  classical
  have hB := IsPullback.of_hasPullback D.f D.u0
  refine ⟨wc_pencil_fibre_gi F' F'' Y n D, ?_, ?_⟩
  ·
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    haveI : IsSeparated (wcP1Over F'').hom := by
      dsimp only [wcP1Over, wcProjKStr, Over.mk_hom]
      infer_instance
    haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
    infer_instance
  ·
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (n - 1)) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) :=
      HasRingHomProperty.instIsZariskiLocalAtSource

    have hpt : ∀ x : (Limits.pullback D.f D.u0 : Scheme), ∃ U : D.Yt.left.Opens,
        (Limits.pullback.fst D.f D.u0) x ∈ U ∧ Smooth (U.ι ≫ D.f) := by
      intro x
      apply D.smooth_off
      intro i hi
      have h1 : D.f ((Limits.pullback.fst D.f D.u0) x) =
          (D.S i) (IsLocalRing.closedPoint F'') := by
        rw [hi, ← D.hxs i]
        rfl
      have h2 : D.f ((Limits.pullback.fst D.f D.u0) x) =
          D.u0 ((Limits.pullback.snd D.f D.u0) x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
      have h3 : (Limits.pullback.snd D.f D.u0) x = IsLocalRing.closedPoint F'' :=
        Subsingleton.elim _ _
      have h4 := h2.symm.trans h1
      rw [h3] at h4
      exact D.hu0S i h4
    choose U hU hUs using hpt

    have hUd : ∀ x, SmoothOfRelativeDimension (n - 1) ((U x).ι ≫ D.f) := by
      intro x
      haveI := hUs x
      haveI := wc_p1_smooth_reldim_one F''
      haveI : SmoothOfRelativeDimension n (((U x).ι ≫ D.f) ≫ (wcP1Over F'').hom) := by
        rw [Category.assoc, D.hf]
        exact IsZariskiLocalAtSource.comp D.smooth (U x).ι
      exact wc_smooth_reldim_of_comp_reldim ((U x).ι ≫ D.f) (wcP1Over F'').hom n 1
    refine IsZariskiLocalAtSource.of_iSup_eq_top
      (fun x => (Limits.pullback.fst D.f D.u0) ⁻¹ᵁ (U x)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hU x⟩
    · intro x
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst D.f D.u0) (U x)) hB
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq (hUd x)

theorem ext_rightDerived_adj_projective {C D : Type*} [Category C] [Category D]
    [Abelian C] [Abelian D] [HasExt C] [HasExt D] [HasInjectiveResolutions C]
    (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) (P : D) [Projective P] (A : C) (n : ℕ) :
    ∃ Λ : Abelian.Ext P ((R.rightDerived n).obj A) 0 ≃+ Abelian.Ext (L.obj P) A n,
      (∀ (σ : A ⟶ A) (y : Abelian.Ext P ((R.rightDerived n).obj A) 0),
        Λ (y.comp (Abelian.Ext.mk₀ ((R.rightDerived n).map σ)) (add_zero 0)) =
          (Λ y).comp (Abelian.Ext.mk₀ σ) (add_zero n)) ∧
      (∀ (τ : P ⟶ P) (y : Abelian.Ext P ((R.rightDerived n).obj A) 0),
        Λ ((Abelian.Ext.mk₀ τ).comp y (zero_add 0)) =
          (Abelian.Ext.mk₀ (L.map τ)).comp (Λ y) (zero_add n)) :=
by
  classical
  haveI : L.Additive := adj.left_adjoint_additive
  obtain ⟨I⟩ : Nonempty (InjectiveResolution A) := ⟨injectiveResolution A⟩
  let K : CochainComplex D ℕ := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  let ι : (R.rightDerived n).obj A ≅ K.homology n := I.isoRightDerivedObj R n

  have esymm_zero : ∀ k : ℕ, (adj.homEquiv P (I.cocomplex.X k)).symm 0 = 0 := fun k => by
    rw [← adj.homAddEquiv_symm_apply, map_zero]
  have e_zero : ∀ k : ℕ, (adj.homEquiv P (I.cocomplex.X k)) 0 = 0 := fun k => by
    rw [← esymm_zero k, Equiv.apply_symm_apply]
  have esymm_add : ∀ (k : ℕ) (a b : P ⟶ R.obj (I.cocomplex.X k)),
      (adj.homEquiv P (I.cocomplex.X k)).symm (a + b) =
        (adj.homEquiv P (I.cocomplex.X k)).symm a + (adj.homEquiv P (I.cocomplex.X k)).symm b := by
    intro k a b
    simp only [← adj.homAddEquiv_symm_apply, map_add]
  have hfk : ∀ k : P ⟶ R.obj (I.cocomplex.X n), k ≫ R.map (I.cocomplex.d n (n + 1)) = 0 →
      (adj.homEquiv P (I.cocomplex.X n)).symm k ≫ I.cocomplex.d n (n + 1) = 0 := by
    intro k hk
    rw [← adj.homEquiv_naturality_right_symm, hk, esymm_zero]
  have extMk_congr : ∀ (f f' : L.obj P ⟶ I.cocomplex.X n) (h : f = f')
      (hf : f ≫ I.cocomplex.d n (n + 1) = 0) (hf' : f' ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk f (n + 1) rfl hf = I.extMk f' (n + 1) rfl hf' := by
    intro f f' h hf hf'
    subst h
    rfl

  have extMk_add : ∀ (f g : L.obj P ⟶ I.cocomplex.X n) (hf : f ≫ I.cocomplex.d n (n + 1) = 0)
      (hg : g ≫ I.cocomplex.d n (n + 1) = 0) (hfg : (f + g) ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk (f + g) (n + 1) rfl hfg = I.extMk f (n + 1) rfl hf + I.extMk g (n + 1) rfl hg := by
    intro f g hf hg hfg
    apply I.extEquivCohomologyClass.injective
    rw [InjectiveResolution.extEquivCohomologyClass_add,
      InjectiveResolution.extEquivCohomologyClass_extMk,
      InjectiveResolution.extEquivCohomologyClass_extMk,
      InjectiveResolution.extEquivCohomologyClass_extMk,
      ← CochainComplex.HomComplex.CohomologyClass.mk_add,
      ← CochainComplex.HomComplex.Cocycle.fromSingleMk_add]
    congr 1
    simp only [Preadditive.add_comp]

  let Z : AddSubgroup (P ⟶ R.obj (I.cocomplex.X n)) :=
    { carrier := {k | k ≫ R.map (I.cocomplex.d n (n + 1)) = 0}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at ha hb ⊢
        rw [Preadditive.add_comp, ha, hb, add_zero]
      zero_mem' := by simp
      neg_mem' := fun {a} ha => by
        simp only [Set.mem_setOf_eq] at ha ⊢
        rw [Preadditive.neg_comp, ha, neg_zero] }
  have hZ : ∀ z : Z, z.1 ≫ K.d n (n + 1) = 0 := fun z => z.2

  have liftAdd : ∀ (k k' : P ⟶ K.X n) (hk : k ≫ K.d n (n + 1) = 0)
      (hk' : k' ≫ K.d n (n + 1) = 0) (hkk : (k + k') ≫ K.d n (n + 1) = 0),
      K.liftCycles (k + k') (n + 1) (CochainComplex.next ℕ n) hkk =
        K.liftCycles k (n + 1) (CochainComplex.next ℕ n) hk +
          K.liftCycles k' (n + 1) (CochainComplex.next ℕ n) hk' := by
    intro k k' hk hk' hkk
    rw [← cancel_mono (K.iCycles n)]
    simp [Preadditive.add_comp]
  let αf : Z → (P ⟶ (R.rightDerived n).obj A) := fun z =>
    K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ z) ≫ K.homologyπ n ≫ ι.inv
  let α : Z →+ (P ⟶ (R.rightDerived n).obj A) := AddMonoidHom.mk' αf (by
    intro a b
    simp only [αf]
    rw [← Preadditive.add_comp]
    congr 1
    exact liftAdd _ _ (hZ a) (hZ b) _)
  let βf : Z → Abelian.Ext (L.obj P) A n := fun z =>
    I.extMk ((adj.homEquiv P (I.cocomplex.X n)).symm z.1) (n + 1) rfl (hfk z.1 z.2)
  let β : Z →+ Abelian.Ext (L.obj P) A n := AddMonoidHom.mk' βf (by
    intro a b
    simp only [βf]
    rw [← extMk_add _ _ (hfk a.1 a.2) (hfk b.1 b.2)]
    · exact extMk_congr _ _ (by rw [AddSubgroup.coe_add, esymm_add]) _ _
    · rw [← esymm_add]; exact hfk _ (a + b).2)
  have hα : ∀ z, α z = αf z := fun z => rfl
  have hβ : ∀ z, β z = βf z := fun z => rfl
  have hZ' : ∀ z : Z, z.1 ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := fun z => z.2

  have hαs : Function.Surjective α := by
    intro h
    let h' : P ⟶ K.cycles n := Projective.factorThru (h ≫ ι.hom) (K.homologyπ n)
    have hk : (h' ≫ K.iCycles n) ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := by
      rw [Category.assoc]
      erw [HomologicalComplex.iCycles_d]
      rw [Limits.comp_zero]
    refine ⟨⟨h' ≫ K.iCycles n, hk⟩, ?_⟩
    rw [hα]
    have hl : K.liftCycles (h' ≫ K.iCycles n) (n + 1) (CochainComplex.next ℕ n) hk = h' := by
      rw [← cancel_mono (K.iCycles n)]
      simp
    show K.liftCycles (h' ≫ K.iCycles n) (n + 1) (CochainComplex.next ℕ n) hk ≫
      K.homologyπ n ≫ ι.inv = h
    rw [hl, ← Category.assoc, Projective.factorThru_comp, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]

  have hβs : Function.Surjective β := by
    intro x
    obtain ⟨f, hf, rfl⟩ := I.extMk_surjective x (n + 1) rfl
    have hk : (adj.homEquiv P (I.cocomplex.X n)) f ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := by
      rw [← adj.homEquiv_naturality_right, hf, e_zero]
    refine ⟨⟨_, hk⟩, ?_⟩
    rw [hβ]
    exact extMk_congr _ _ (Equiv.symm_apply_apply _ _) _ _

  have αker : ∀ z : Z, α z = 0 ↔ ∃ g : P ⟶ R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev n)),
      g ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev n) n) = z.1 := by
    intro z
    have h1 : α z = 0 ↔
        K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ z) ≫ K.homologyπ n = 0 := by
      rw [hα]
      show (K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ z) ≫ K.homologyπ n ≫ ι.inv)
        = 0 ↔ _
      rw [← Category.assoc]
      constructor
      · intro h
        have := congrArg (· ≫ ι.hom) h
        simpa using this
      · intro h
        rw [h, Limits.zero_comp]
    rw [h1]
    constructor
    · intro h0
      let S := ShortComplex.mk (K.toCycles ((ComplexShape.up ℕ).prev n) n) (K.homologyπ n)
        (K.toCycles_comp_homologyπ _ n)
      have hS : S.Exact := S.exact_of_g_is_cokernel (K.homologyIsCokernel _ n rfl)
      refine ⟨hS.liftFromProjective
        (K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ z)) h0, ?_⟩
      have h2 := hS.liftFromProjective_comp
        (K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ z)) h0
      have h3 := congrArg (· ≫ K.iCycles n) h2
      simp only [S, Category.assoc, HomologicalComplex.toCycles_i,
        HomologicalComplex.liftCycles_i] at h3
      exact h3
    · rintro ⟨g, hg⟩
      exact K.liftCycles_homologyπ_eq_zero_of_boundary z.1 (n + 1) (CochainComplex.next ℕ n) g
        hg.symm

  have extMk_zero_iff : ∀ (m : ℕ) (f : L.obj P ⟶ I.cocomplex.X m)
      (hf : f ≫ I.cocomplex.d m (m + 1) = 0),
      I.extMk f (m + 1) rfl hf = 0 ↔ ∃ g' : L.obj P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev m),
        g' ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev m) m = f := by
    intro m
    cases m with
    | zero =>
      intro f hf
      rw [CochainComplex.prev_nat_zero]
      have hd : I.cocomplex.d 0 0 = 0 := I.cocomplex.shape 0 0 (by simp)
      simp only [hd, Limits.comp_zero]
      constructor
      · intro hx
        have hx' := congrArg I.extEquivCohomologyClass hx
        rw [InjectiveResolution.extEquivCohomologyClass_extMk,
          InjectiveResolution.extEquivCohomologyClass_zero,
          CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
          CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
            (by simp)] at hx'
        obtain ⟨g, hg⟩ := hx'
        have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
          HomologicalComplex.isZero_extend_X I.cocomplex ComplexShape.embeddingUpNat (-1)
            (fun i => by rw [ComplexShape.embeddingUpNat_f]; omega)
        rw [hz.eq_of_tgt g 0, Limits.zero_comp] at hg
        have hf0 : f = 0 := by
          rw [← cancel_mono (I.cochainComplexXIso (↑(0 : ℕ)) 0 rfl).inv, Limits.zero_comp]
          exact hg.symm
        exact ⟨0, hf0.symm⟩
      · rintro ⟨g', hg'⟩
        subst hg'
        exact I.extMk_zero 1 rfl
    | succ p =>
      intro f hf
      rw [CochainComplex.prev_nat_succ]
      exact I.extMk_eq_zero_iff f _ rfl hf p rfl

  have βker : ∀ z : Z, β z = 0 ↔ ∃ g : P ⟶ R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev n)),
      g ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev n) n) = z.1 := by
    intro z
    rw [hβ]
    show I.extMk _ (n + 1) rfl _ = 0 ↔ _
    rw [extMk_zero_iff]
    constructor
    · rintro ⟨g', hg'⟩
      refine ⟨adj.homEquiv _ _ g', ?_⟩
      rw [← adj.homEquiv_naturality_right, hg', Equiv.apply_symm_apply]
    · rintro ⟨g, hg⟩
      refine ⟨(adj.homEquiv _ _).symm g, ?_⟩
      rw [← adj.homEquiv_naturality_right_symm, hg]
  have hker : α.ker = β.ker := by
    ext z
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker]
    exact (αker z).trans (βker z).symm

  let Θ : (P ⟶ (R.rightDerived n).obj A) ≃+ Abelian.Ext (L.obj P) A n :=
    (QuotientAddGroup.quotientKerEquivOfSurjective α hαs).symm.trans
      ((QuotientAddGroup.quotientAddEquivOfEq hker).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective β hβs))
  have hΘ : ∀ z : Z, Θ (α z) = β z := by
    intro z
    have h1 : (QuotientAddGroup.quotientKerEquivOfSurjective α hαs).symm (α z) =
        (z : Z ⧸ α.ker) := by
      rw [AddEquiv.symm_apply_eq]
      rfl
    simp only [Θ, AddEquiv.trans_apply, h1]
    rfl
  let Λ : Abelian.Ext P ((R.rightDerived n).obj A) 0 ≃+ Abelian.Ext (L.obj P) A n :=
    Abelian.Ext.addEquiv₀.trans Θ
  have hΛ : ∀ h, Λ (Abelian.Ext.mk₀ h) = Θ h := by
    intro h
    show Θ (Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ h)) = Θ h
    rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
  have hmk : ∀ y : Abelian.Ext P ((R.rightDerived n).obj A) 0, ∃ h, Abelian.Ext.mk₀ h = y :=
    fun y => ⟨Abelian.Ext.addEquiv₀ y, by
      rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.symm_apply_apply]⟩
  refine ⟨Λ, ?_, ?_⟩
  · intro σ y
    obtain ⟨h, rfl⟩ := hmk y
    rw [Abelian.Ext.mk₀_comp_mk₀, hΛ, hΛ]
    obtain ⟨z, rfl⟩ := hαs h
    let φ := InjectiveResolution.desc σ I I
    have hφ0 : I.ι.f 0 ≫ φ.f 0 = σ ≫ I.ι.f 0 := InjectiveResolution.desc_commutes_zero σ I I
    have hz' : (z.1 ≫ R.map (φ.f n)) ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := by
      rw [Category.assoc, ← R.map_comp, φ.comm, R.map_comp, ← Category.assoc, hZ' z,
        Limits.zero_comp]
    let z' : Z := ⟨z.1 ≫ R.map (φ.f n), hz'⟩
    have key : ι.inv ≫ (R.rightDerived n).map σ =
        HomologicalComplex.homologyMap ((R.mapHomologicalComplex _).map φ) n ≫ ι.inv :=
      InjectiveResolution.isoRightDerivedObj_inv_naturality σ I I φ hφ0 R n
    have hαz' : α z' = α z ≫ (R.rightDerived n).map σ := by
      rw [hα, hα]
      show K.liftCycles (z.1 ≫ R.map (φ.f n)) (n + 1) (CochainComplex.next ℕ n) (hZ z') ≫
          K.homologyπ n ≫ ι.inv =
        (K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ z) ≫ K.homologyπ n ≫ ι.inv) ≫
          (R.rightDerived n).map σ
      have e := HomologicalComplex.liftCycles_comp_cyclesMap (K := K) z.1 (n + 1)
        (CochainComplex.next ℕ n) (hZ z) ((R.mapHomologicalComplex _).map φ)
      rw [Category.assoc, Category.assoc, key, ← Category.assoc (K.homologyπ n),
        HomologicalComplex.homologyπ_naturality, Category.assoc, reassoc_of% e]
      rfl
    let φh : I.Hom I σ := ⟨φ, by rw [CochainComplex.single₀_map_f_zero]; exact hφ0⟩
    have hβz' : β z' = (β z).comp (Abelian.Ext.mk₀ σ) (add_zero n) := by
      rw [hβ, hβ]
      show I.extMk _ (n + 1) rfl _ = (I.extMk _ (n + 1) rfl _).comp (Abelian.Ext.mk₀ σ) _
      rw [InjectiveResolution.extMk_comp_mk₀ _ _ _ _ φh]
      exact extMk_congr _ _ (adj.homEquiv_naturality_right_symm _ _) _ _
    rw [← hαz', hΘ, hΘ, hβz']
  · intro τ y
    obtain ⟨h, rfl⟩ := hmk y
    rw [Abelian.Ext.mk₀_comp_mk₀, hΛ, hΛ]
    obtain ⟨z, rfl⟩ := hαs h
    let z' : Z := ⟨τ ≫ z.1, by
      show (τ ≫ z.1) ≫ R.map (I.cocomplex.d n (n + 1)) = 0
      rw [Category.assoc, hZ' z, Limits.comp_zero]⟩
    have hαz' : α z' = τ ≫ α z := by
      rw [hα, hα]
      show K.liftCycles (τ ≫ z.1) (n + 1) (CochainComplex.next ℕ n) (hZ z') ≫
          K.homologyπ n ≫ ι.inv =
        τ ≫ K.liftCycles z.1 (n + 1) (CochainComplex.next ℕ n) (hZ z) ≫ K.homologyπ n ≫ ι.inv
      rw [← Category.assoc τ, HomologicalComplex.comp_liftCycles]
    have hβz' : β z' = (Abelian.Ext.mk₀ (L.map τ)).comp (β z) (zero_add n) := by
      rw [hβ, hβ]
      show I.extMk _ (n + 1) rfl _ = (Abelian.Ext.mk₀ (L.map τ)).comp (I.extMk _ (n + 1) rfl _) _
      rw [InjectiveResolution.mk₀_comp_extMk]
      exact extMk_congr _ _ (adj.homEquiv_naturality_left_symm _ _) _ _
    rw [← hαz', hΘ, hΘ, hβz']

theorem wc_contPull_ladicScalar {Y Z : Scheme.{u}} (i : Z ⟶ Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (c : ℚ_[ℓ]) :
    wcLadicScalar Y ℓ c ≫ wcContPull i ℚ_[ℓ] =
      wcContPull i ℚ_[ℓ] ≫ (wcProEtPush i).map (wcLadicScalar Z ℓ c) :=
by
  apply Sheaf.hom_ext
  change (wcLadicScalar Y ℓ c).hom ≫ (_ ≫ toSheafify _ _) =
    (_ ≫ toSheafify _ _) ≫ sheafifyMap (Scheme.ProEt.topology Y)
      (Functor.whiskerLeft (wcProEtBaseChange i).op (wcLadicScalar Z ℓ c).hom)
  have H : ∀ {P Q : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (s : P ⟶ P) (α : P ⟶ Q) (η : Q ⟶ Q),
      s ≫ α = α ≫ η →
      s ≫ α ≫ toSheafify (Scheme.ProEt.topology Y) Q =
        (α ≫ toSheafify (Scheme.ProEt.topology Y) Q) ≫ sheafifyMap (Scheme.ProEt.topology Y) η := by
    intro P Q s α η h
    rw [Category.assoc, ← toSheafify_naturality, ← Category.assoc, ← Category.assoc, h]
  refine H _ _ _ ?_
  ext V x
  rfl

theorem wc_pencil_closed_fibre_geom_iso (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom D.u0) :
    ∃ β : (wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀) ≅
        wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX,
      (wcProEtPullback (Limits.pullback.fst D.f D.u0)).map ((wcProEtPullback D.f).map φ₀) ≫
          β.hom = β.hom ≫ wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX :=
by
  classical

  have key : ∀ {V Yt P S Sb : Scheme.{u}} (v : V ⟶ P) (f : Yt ⟶ P) (u : S ⟶ P) (a : Sb ⟶ S)
      (ε : Limits.pullback v u ≅ Sb) (hε : ε.hom ≫ a = Limits.pullback.snd v u),
      ∃ β₀ : Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≅
          Limits.pullback (Limits.pullback.snd f u) a,
        β₀.hom ≫ Limits.pullback.fst (Limits.pullback.snd f u) a =
            Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ∧
        β₀.hom ≫ Limits.pullback.snd (Limits.pullback.snd f u) a ≫ ε.inv ≫
            Limits.pullback.fst v u =
          Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
            Limits.pullback.fst v f := by
    intro V Yt P S Sb v f u a ε hε
    have hε' : ε.inv ≫ Limits.pullback.snd v u = a := by rw [← hε, Iso.inv_hom_id_assoc]
    have hε'' := reassoc_of% hε'
    have hκc : (Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
          Limits.pullback.fst v f) ≫ v =
        (Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
          Limits.pullback.snd f u) ≫ u := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition (f := v) (g := f),
        Limits.pullback.condition_assoc (f := Limits.pullback.snd v f)
          (g := Limits.pullback.fst f u),
        Limits.pullback.condition (f := f) (g := u)]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback (Limits.pullback.snd v f)
        (Limits.pullback.fst f u) ⟶ Limits.pullback v u,
        κ ≫ Limits.pullback.fst v u =
          Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
            Limits.pullback.fst v f ∧
        κ ≫ Limits.pullback.snd v u =
          Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
            Limits.pullback.snd f u :=
      ⟨Limits.pullback.lift _ _ hκc, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hbc : Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
        Limits.pullback.snd f u = (κ ≫ ε.hom) ≫ a := by
      rw [Category.assoc, hε, hκ2]
    obtain ⟨βl, hb1, hb2⟩ : ∃ βl : Limits.pullback (Limits.pullback.snd v f)
        (Limits.pullback.fst f u) ⟶ Limits.pullback (Limits.pullback.snd f u) a,
        βl ≫ Limits.pullback.fst (Limits.pullback.snd f u) a =
          Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ∧
        βl ≫ Limits.pullback.snd (Limits.pullback.snd f u) a = κ ≫ ε.hom :=
      ⟨Limits.pullback.lift _ _ hbc, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hwc : (Limits.pullback.snd (Limits.pullback.snd f u) a ≫ ε.inv ≫
          Limits.pullback.fst v u) ≫ v =
        (Limits.pullback.fst (Limits.pullback.snd f u) a ≫ Limits.pullback.fst f u) ≫ f := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition (f := v) (g := u), hε'',
        ← Limits.pullback.condition_assoc (f := Limits.pullback.snd f u) (g := a),
        ← Limits.pullback.condition (f := f) (g := u)]
    obtain ⟨w0, hw1, hw2⟩ : ∃ w0 : Limits.pullback (Limits.pullback.snd f u) a ⟶
        Limits.pullback v f,
        w0 ≫ Limits.pullback.fst v f = Limits.pullback.snd (Limits.pullback.snd f u) a ≫
          ε.inv ≫ Limits.pullback.fst v u ∧
        w0 ≫ Limits.pullback.snd v f = Limits.pullback.fst (Limits.pullback.snd f u) a ≫
          Limits.pullback.fst f u :=
      ⟨Limits.pullback.lift _ _ hwc, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨γ, hg1, hg2⟩ : ∃ γ : Limits.pullback (Limits.pullback.snd f u) a ⟶
        Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u),
        γ ≫ Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) = w0 ∧
        γ ≫ Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) =
          Limits.pullback.fst (Limits.pullback.snd f u) a :=
      ⟨Limits.pullback.lift _ _ hw2, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hκ1' := reassoc_of% hκ1
    have hκ2' := reassoc_of% hκ2
    have hb1' := reassoc_of% hb1
    have hb2' := reassoc_of% hb2
    have hg1' := reassoc_of% hg1
    have hg2' := reassoc_of% hg2
    have hγκ : γ ≫ κ = Limits.pullback.snd (Limits.pullback.snd f u) a ≫ ε.inv := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hκ1, hg1', hw1]
      · simp only [Category.assoc, hκ2, hg2', hε']
        exact Limits.pullback.condition
    have hγκ' := reassoc_of% hγκ
    have hβw : βl ≫ w0 =
        Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hw1, hb2', Iso.hom_inv_id_assoc, hκ1]
      · simp only [Category.assoc, hw2, hb1']
        exact Limits.pullback.condition.symm
    have hβw' := reassoc_of% hβw
    have h1 : βl ≫ γ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hg1, hβw, Category.id_comp]
      · simp only [Category.assoc, hg2, hb1, Category.id_comp]
    have h2 : γ ≫ βl = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hb1, hg2, Category.id_comp]
      · simp only [Category.assoc, hb2, hγκ', Iso.inv_hom_id, Category.comp_id,
          Category.id_comp]
    refine ⟨⟨βl, γ, h1, h2⟩, hb1, ?_⟩
    show βl ≫ _ = _
    simp only [hb2', Iso.hom_inv_id_assoc, hκ1]

  have frob : ∀ {V Yt P S Sb : Scheme.{u}} (v : V ⟶ P) (f : Yt ⟶ P) (u : S ⟶ P) (a : Sb ⟶ S)
      (ε : Limits.pullback v u ≅ Sb) (hε : ε.hom ≫ a = Limits.pullback.snd v u)
      (φ : V ⟶ V) (σ : Sb ⟶ Sb) (hσ : σ ≫ a = a)
      (hεφ : ε.inv ≫ Limits.pullback.fst v u ≫ φ = σ ≫ ε.inv ≫ Limits.pullback.fst v u)
      (β' : Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u) ⟶
          Limits.pullback (Limits.pullback.snd f u) a)
      (hβ1 : β' ≫ Limits.pullback.fst (Limits.pullback.snd f u) a =
          Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u))
      (hβ2 : β' ≫ Limits.pullback.snd (Limits.pullback.snd f u) a ≫ ε.inv ≫
          Limits.pullback.fst v u =
        Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
          Limits.pullback.fst v f)
      (Φ : Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u) ⟶
          Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u))
      (hΦ1 : Φ ≫ Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) =
          Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u))
      (hΦ2 : Φ ≫ Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
          Limits.pullback.fst v f =
        Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
          Limits.pullback.fst v f ≫ φ)
      (Fr : Limits.pullback (Limits.pullback.snd f u) a ⟶
          Limits.pullback (Limits.pullback.snd f u) a)
      (hF1 : Fr ≫ Limits.pullback.fst (Limits.pullback.snd f u) a =
          Limits.pullback.fst (Limits.pullback.snd f u) a)
      (hF2 : Fr ≫ Limits.pullback.snd (Limits.pullback.snd f u) a =
          Limits.pullback.snd (Limits.pullback.snd f u) a ≫ σ),
      Φ ≫ β' = β' ≫ Fr := by
    intro V Yt P S Sb v f u a ε hε φ σ hσ hεφ β' hβ1 hβ2 Φ hΦ1 hΦ2 Fr hF1 hF2
    have hε' : ε.inv ≫ Limits.pullback.snd v u = a := by rw [← hε, Iso.inv_hom_id_assoc]
    have hX' : Limits.pullback.snd (Limits.pullback.snd f u) a ≫ a =
        Limits.pullback.fst (Limits.pullback.snd f u) a ≫ Limits.pullback.snd f u :=
      Limits.pullback.condition.symm
    have hβ1' := reassoc_of% hβ1
    have hβ2' := reassoc_of% hβ2
    have hΦ1' := reassoc_of% hΦ1
    have hF2' := reassoc_of% hF2
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hβ1, hF1, hΦ1]
    · rw [← cancel_mono ε.inv]
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hβ2, hΦ2, hF2', ← hεφ, hβ2']
      · simp only [Category.assoc, hε', hF2', hσ, hX', hβ1', hΦ1']

  obtain ⟨β₀, hE1, hE2⟩ := key V₀.hom D.f D.u0
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ε hε
  have hσ : Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _ (Fintype.ofFinite F'')
      (AlgebraicClosure F'') _ _ _).symm.commutes x)
  have hΦ1 : ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map
        ((wcProEtPullback D.f).map φ₀)).left ≫
      Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) =
      Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) :=
    Limits.pullback.lift_snd _ _ _
  have e1 : ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map
        ((wcProEtPullback D.f).map φ₀)).left ≫
      Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) =
      Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ≫
        ((wcProEtPullback D.f).map φ₀).left :=
    Limits.pullback.lift_fst _ _ _
  have e2 : ((wcProEtPullback D.f).map φ₀).left ≫ Limits.pullback.fst V₀.hom D.f =
      Limits.pullback.fst V₀.hom D.f ≫ φ₀.left :=
    Limits.pullback.lift_fst _ _ _
  have hΦ2 : ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map
        ((wcProEtPullback D.f).map φ₀)).left ≫
      Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ≫
        Limits.pullback.fst V₀.hom D.f =
      Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ≫
        Limits.pullback.fst V₀.hom D.f ≫ φ₀.left :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ Limits.pullback.fst V₀.hom D.f) e1).trans
        ((Category.assoc _ _ _).trans
          (congrArg (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f)
            (Limits.pullback.fst D.f D.u0) ≫ ·) e2)))
  have hF1 : (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX).left ≫
      Limits.pullback.fst (Limits.pullback.snd D.f D.u0)
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.fst (Limits.pullback.snd D.f D.u0)
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hF2 : (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX).left ≫
      Limits.pullback.snd (Limits.pullback.snd D.f D.u0)
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (Limits.pullback.snd D.f D.u0)
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) :=
    Limits.pullback.lift_snd _ _ _
  have hfr := frob V₀.hom D.f D.u0
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ε hε φ₀.left _ hσ hεφ
    β₀.hom hE1 hE2 _ hΦ1 hΦ2 _ hF1 hF2
  refine ⟨MorphismProperty.Over.isoMk β₀ hE1, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  exact hfr

theorem wc_proet_zmod_coh_finite_qcsep : ∀ (Y : Scheme.{u}) [CompactSpace Y] [IsSeparated (Limits.terminal.from Y)] (m j : ℕ), Finite (wcEtCoh Y m j) → Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcContSheaf Y (ZMod m)) j) :=
by
  intro Y _ _ m j hfin
  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hcont
  obtain ⟨c₁⟩ := wc_contSheaf_discrete_const Y (ZMod m)
  obtain ⟨c₂⟩ := wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
  let c := c₁ ≪≫ c₂.symm
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E⟩ := wc_proet_etale_comparison_epsInv_qcsep Y
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) j
  haveI h1 := @Finite.of_equiv _ _ hfin E.symm
  refine Finite.of_injective (fun x => x.comp (Abelian.Ext.mk₀ c.hom) (add_zero j)) ?_
  intro x y hxy
  have key : ∀ z : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcContSheaf Y (ZMod m)) j,
      (z.comp (Abelian.Ext.mk₀ c.hom) (add_zero j)).comp (Abelian.Ext.mk₀ c.inv) (add_zero j) = z := by
    intro z
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
    exact Abelian.Ext.comp_mk₀_id z
  rw [← key x, ← key y]
  exact congrArg (fun w => w.comp (Abelian.Ext.mk₀ c.inv) (add_zero j)) hxy

theorem wc_pencil_nbhd_zmod_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) (j k : ℕ) :
    Finite (Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) j) :=
by
  classical
  haveI := D.proper
  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI : IsClosedImmersion (D.u0 ≫ (wcP1Over F'').hom) := by rw [D.hu0]; infer_instance
  haveI hu0 : IsClosedImmersion D.u0 := IsClosedImmersion.of_comp D.u0 (wcP1Over F'').hom

  obtain ⟨g, hg⟩ : ∃ g : ((wcProEtPullback D.f).obj V₀).left ⟶ Spec (.of A), IsProper g :=
    ⟨_, (inferInstance : IsProper (Limits.pullback.fst V₀.hom D.f ≫ e.hom))⟩
  haveI := hg
  haveI hWc : CompactSpace ((wcProEtPullback D.f).obj V₀).left :=
    QuasiCompact.compactSpace_of_compactSpace g
  haveI hWs : IsSeparated (Limits.terminal.from ((wcProEtPullback D.f).obj V₀).left) := by
    rw [show Limits.terminal.from ((wcProEtPullback D.f).obj V₀).left =
      g ≫ Limits.terminal.from _ from Limits.terminal.hom_ext _ _]
    infer_instance

  haveI hc : IsClosedImmersion (ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom) := inferInstance
  have hψ : IsClosedImmersion (Spec.map (Spec.preimage
      (ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom))) := by
    rw [Spec.map_preimage]; exact hc
  set ψ := Spec.preimage (ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom) with hψdef
  have hsurjTop := (IsClosedImmersion.isAffine_surjective_of_isAffine (Spec.map ψ)).2
  have hψs : Function.Surjective ψ.hom := by
    intro y
    obtain ⟨y', hy'⟩ := hsurjTop ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F''))).inv y)
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of A)).hom y', ?_⟩
    have h := congrArg (fun φ => φ.hom y') (Scheme.ΓSpecIso_naturality ψ)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [← h, hy']
    change ((Scheme.ΓSpecIso _).inv ≫ (Scheme.ΓSpecIso _).hom).hom y = y
    rw [Iso.inv_hom_id]
    rfl
  haveI : IsLocalHom ψ.hom := IsLocalHom.of_surjective ψ.hom hψs
  have hφs : Function.Surjective (IsLocalRing.ResidueField.lift ψ.hom) := by
    intro y
    obtain ⟨x, rfl⟩ := hψs y
    exact ⟨IsLocalRing.residue A x, IsLocalRing.ResidueField.lift_residue_apply ψ.hom x⟩
  let φ : IsLocalRing.ResidueField A ≃+* AlgebraicClosure F'' :=
    RingEquiv.ofBijective (IsLocalRing.ResidueField.lift ψ.hom)
      ⟨(IsLocalRing.ResidueField.lift ψ.hom).injective, hφs⟩
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) :=
    IsAlgClosed.of_ringEquiv (AlgebraicClosure F'') _ φ.symm

  have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
  have hmF : ((ℓ ^ k : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    obtain ⟨p, hp⟩ := CharP.exists F''
    haveI := hp
    have hpp : p.Prime := CharP.char_is_prime F'' p
    have h1 : p ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F'' p _).mp h0
    have h2 : p ∣ ℓ := hpp.dvd_of_dvd_pow h1
    have h3 : p = ℓ := (Nat.prime_dvd_prime_iff_eq hpp Fact.out).mp h2
    have h4 : p ∣ Fintype.card F'' :=
      (CharP.cast_eq_zero_iff F'' p _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [← h3, Nat.card_eq_fintype_card]
    exact h4
  have hmFb : ((ℓ ^ k : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro h0
    apply hmF
    apply (algebraMap F'' (AlgebraicClosure F'')).injective
    rw [map_natCast, map_zero]
    exact h0
  have hmκ : ((ℓ ^ k : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    intro h0
    apply hmFb
    rw [← map_natCast φ (ℓ ^ k), h0, map_zero]

  have hs := wc_etale_proper_finite (IsLocalRing.ResidueField A) _
    (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) (ℓ ^ k) hmκ j
  obtain ⟨E₁⟩ := wc_et_henselian_closed_fibre_coh A _ g (ℓ ^ k) hm0
    wc_et_henselian_proper_vanishing j
  haveI := hs
  haveI hfW : Finite (wcEtCoh ((wcProEtPullback D.f).obj V₀).left (ℓ ^ k) j) :=
    Finite.of_equiv _ E₁.symm

  haveI := wc_proet_zmod_coh_finite_qcsep ((wcProEtPullback D.f).obj V₀).left (ℓ ^ k) j hfW
  obtain ⟨E₂⟩ := wc_ext_free_slice_cont D.Yt.left ((wcProEtPullback D.f).obj V₀) (ZMod (ℓ ^ k)) j
  exact Finite.of_equiv _ E₂.symm

theorem wc_proet_push_closed_preservesFiniteColimits {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y] :
    Limits.PreservesFiniteColimits (wcProEtPush i) :=
by
  classical

  haveI hc : (wcProEtBC i).IsContinuous (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) :=
    (wc_proet_pullback_continuous_flat i).1

  have affine_local : ∀ (U : Y.ProEt) (R : Sieve U),
      (∀ (V : Y.ProEt) (f : V ⟶ U), IsAffine V.left → R.pullback f ∈ Scheme.ProEt.topology Y V) →
      R ∈ Scheme.ProEt.topology Y U := by
    intro U R hR
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → Y.ProEt := fun j =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f j ≫ U.hom) inferInstance
    let e : ∀ j, W j ⟶ U := fun j =>
      MorphismProperty.Over.homMk (U.left.affineCover.f j) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage Y).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Y ⋙ Over.forget Y)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun j => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) R ?_
    intro T f hf
    obtain ⟨T', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨j⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hR (W j) (e j) (show IsAffine (U.left.affineCover.X j) by infer_instance))

  have hepi : ∀ {F F' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}} (φ : F ⟶ F'),
      Epi φ → Epi ((@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) hc).map φ) := by
    intro F F' φ hφ
    have hF' : Presieve.IsSheaf (Scheme.ProEt.topology Z) (F'.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp ((Presheaf.isSheaf_iff_isSheaf_forget
        (Scheme.ProEt.topology Z) F'.obj (forget AddCommGrpCat.{u+1})).mp F'.property)
    have hloc : ∀ (V : Y.ProEt), IsAffine V.left →
        ∀ (y' : F'.obj.obj (Opposite.op ((wcProEtBC i).obj V))),
        ∃ (n : ℕ) (Wf : Fin n → Y.ProEt) (wf : ∀ k, Wf k ⟶ V),
          Sieve.generate (Presieve.ofArrows Wf wf) ∈ Scheme.ProEt.topology Y V ∧
          ∀ k, ∃ x : F.obj.obj (Opposite.op ((wcProEtBC i).obj (Wf k))),
            φ.hom.app (Opposite.op ((wcProEtBC i).obj (Wf k))) x =
              F'.obj.map ((wcProEtBC i).map (wf k)).op y' := by
      intro V hV y'
      haveI : IsAffine V.left := hV
      haveI hGV : IsAffine ((wcProEtBC i).obj V).left := by
        show IsAffine (Limits.pullback V.hom i)
        exact (@IsClosedImmersion.isAffine_surjective_of_isAffine _ _ hV
          (Limits.pullback.fst V.hom i) _).1
      obtain ⟨V', g', x', hV', hg', hx'⟩ :=
        wc_proet_epi_affine_lift Z φ hφ ((wcProEtBC i).obj V) hGV y'
      obtain ⟨W₀, w₀, a, hW₀, ha, hcov₀⟩ := wc_closed_proet_cover_extension_affine i V V' g' hV' hg'
        wc_weaklyEtale_cover_lift_along_surjection
      obtain ⟨m, W, w, hWaff, hWempty, hcovW⟩ := wc_closed_compl_proet_finite_cover i V
      refine ⟨m + 1, fun k => Fin.cases W₀ W k, fun k => Fin.cases w₀ w k, ?_, ?_⟩
      · apply proet_finite_affine_jointly_surjective_covers Y V (m + 1)
        · intro k
          refine Fin.cases ?_ (fun j => ?_) k
          · exact hW₀
          · exact hWaff j
        · intro y
          by_cases hy : y ∈ Set.range (Limits.pullback.fst V.hom i)
          · exact ⟨0, hcov₀ y hy⟩
          · obtain ⟨j, hj⟩ := hcovW y hy
            exact ⟨j.succ, hj⟩
      · intro k
        refine Fin.cases ?_ (fun j => ?_) k
        · refine ⟨F.obj.map a.op x', ?_⟩
          show φ.hom.app (Opposite.op ((wcProEtBC i).obj W₀)) (F.obj.map a.op x') =
            F'.obj.map ((wcProEtBC i).map w₀).op y'
          rw [NatTrans.naturality_apply, hx', ← ha, op_comp, Functor.map_comp,
            ConcreteCategory.comp_apply]
        · haveI : IsEmpty ((wcProEtBC i).obj (W j)).left := hWempty j
          refine ⟨0, ?_⟩
          show φ.hom.app (Opposite.op ((wcProEtBC i).obj (W j))) 0 =
            F'.obj.map ((wcProEtBC i).map (w j)).op y'
          have hbot : Presieve.IsSheafFor (F'.obj ⋙ forget AddCommGrpCat.{u+1})
              (⊥ : Presieve ((wcProEtBC i).obj (W j))) :=
            hF'.isSheafFor ⊥ (by rw [Sieve.generate_bot]; exact Scheme.ProEt.bot_mem_topology _)
          exact hbot.isSeparatedFor (fun _ _ h => h.elim) _ _ (fun _ _ h => h.elim)
            (fun _ _ h => h.elim)
    refine (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp ⟨fun {U} y => ?_⟩
    apply affine_local U
    intro V f hV
    obtain ⟨n, Wf, wf, hcov, hx⟩ := hloc V hV (F'.obj.map ((wcProEtBC i).map f).op y)
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    obtain ⟨x, hxk⟩ := hx k
    show ∃ t, φ.hom.app (Opposite.op ((wcProEtBC i).obj (Wf k))) t =
      F'.obj.map ((wcProEtBC i).map (wf k ≫ f)).op y
    refine ⟨x, hxk.trans ?_⟩
    show (F'.obj.map ((wcProEtBC i).map (wf k)).op) ((F'.obj.map ((wcProEtBC i).map f).op) y) =
      (F'.obj.map ((wcProEtBC i).map (wf k ≫ f)).op) y
    rw [Functor.map_comp, op_comp, Functor.map_comp]
    rfl

  haveI hPE : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) hc).PreservesEpimorphisms :=
    ⟨by intro A B f hf; exact hepi f hf⟩
  haveI hPH : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) hc).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hPA : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) hc).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI hPC : Limits.PreservesFiniteColimits
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) hc) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  have eIso : wcProEtPush i ≅
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) hc) :=
    Functor.isoWhiskerRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso (wcProEtBC i)
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z)).symm
        (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.ProEt.topology Y)
        AddCommGrpCat.{u+1}).counit) ≪≫
      Functor.rightUnitor _
  exact Limits.preservesFiniteColimits_of_natIso eIso.symm

theorem wc_contPull_zmod_pow_epi {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) : Epi (wcContPull i (ZMod (ℓ ^ k))) :=
by
  classical
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero k hℓpos.ne'⟩
  have hℓR : (0 : ℝ) < ℓ := by exact_mod_cast hℓpos
  have hℓ1 : (1 : ℝ) ≤ ℓ := by exact_mod_cast hℓpos

  let ρ : ℚ_[ℓ] → ZMod (ℓ ^ k) := fun c =>
    if h : ‖c‖ ≤ 1 then PadicInt.toZModPow k ⟨c, h⟩ else 0
  have hρ : ∀ a : ZMod (ℓ ^ k), ρ (((a.val : ℕ) : ℚ_[ℓ])) = a := by
    intro a
    have h : ‖((a.val : ℕ) : ℚ_[ℓ])‖ ≤ 1 := by
      rw [← Int.cast_natCast]; exact Padic.norm_int_le_one _
    have e1 : ρ (((a.val : ℕ) : ℚ_[ℓ])) = PadicInt.toZModPow k ⟨_, h⟩ := dif_pos h
    have e : PadicInt.toZModPow k ⟨((a.val : ℕ) : ℚ_[ℓ]), h⟩ =
        PadicInt.toZModPow k ((a.val : ℕ) : ℤ_[ℓ]) :=
      congrArg (PadicInt.toZModPow k) (Subtype.ext (PadicInt.coe_natCast _).symm)
    rw [e1, e, map_natCast, ZMod.natCast_zmod_val]
  have hρc : Continuous ρ := by
    rw [continuous_discrete_rng]
    intro b
    rw [isOpen_iff_forall_mem_open]
    intro c₀ hc₀
    by_cases h0 : ‖c₀‖ ≤ 1
    · have hr : (0 : ℝ) < (ℓ : ℝ) ^ (-(k : ℤ)) := zpow_pos hℓR _
      have hr1 : (ℓ : ℝ) ^ (-(k : ℤ)) ≤ 1 := zpow_le_one_of_nonpos₀ hℓ1 (by omega)
      refine ⟨Metric.closedBall c₀ ((ℓ : ℝ) ^ (-(k : ℤ))), ?_,
        IsUltrametricDist.isOpen_closedBall _ hr.ne', Metric.mem_closedBall_self hr.le⟩
      intro c hc
      rw [Metric.mem_closedBall, dist_eq_norm] at hc
      have hc1 : ‖c‖ ≤ 1 := by
        have := IsUltrametricDist.norm_add_le_max (c - c₀) c₀
        rw [sub_add_cancel] at this
        exact this.trans (max_le (hc.trans hr1) h0)
      have key : ∀ x y : ℤ_[ℓ], ‖(x : ℚ_[ℓ]) - (y : ℚ_[ℓ])‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) →
          PadicInt.toZModPow k x = PadicInt.toZModPow k y := by
        intro x y hxy
        rw [← sub_eq_zero, ← map_sub, ← RingHom.mem_ker, PadicInt.ker_toZModPow,
          ← PadicInt.norm_le_pow_iff_mem_span_pow, PadicInt.norm_def, PadicInt.coe_sub]
        exact hxy
      have h1 : PadicInt.toZModPow k (⟨c, hc1⟩ : ℤ_[ℓ]) =
          PadicInt.toZModPow k (⟨c₀, h0⟩ : ℤ_[ℓ]) := key ⟨c, hc1⟩ ⟨c₀, h0⟩ hc
      have e1 : ρ c = PadicInt.toZModPow k ⟨c, hc1⟩ := dif_pos hc1
      have e2 : ρ c₀ = PadicInt.toZModPow k ⟨c₀, h0⟩ := dif_pos h0
      show ρ c ∈ ({b} : Set (ZMod (ℓ ^ k)))
      rw [e1, h1, ← e2]
      exact hc₀
    · refine ⟨{c | 1 < ‖c‖}, ?_, isOpen_lt continuous_const continuous_norm, not_le.mp h0⟩
      intro c hc
      have hc' : ¬ ‖c‖ ≤ 1 := not_le.mpr hc
      have e1 : ρ c = 0 := dif_neg hc'
      have e2 : ρ c₀ = 0 := dif_neg h0
      show ρ c ∈ ({b} : Set (ZMod (ℓ ^ k)))
      rw [e1, ← e2]
      exact hc₀

  haveI hcont : (wcProEtBaseChange i).IsContinuous (Scheme.ProEt.topology Y)
      (Scheme.ProEt.topology Z) := (wc_proet_pullback_continuous_flat i).1
  let P := (wcProEtBaseChange i).op ⋙ (wcContSheaf Z (ZMod (ℓ ^ k))).obj
  let φ := toSheafify (Scheme.ProEt.topology Y) P
  haveI hiso : IsIso φ :=
    isIso_toSheafify (Scheme.ProEt.topology Y)
      (Functor.op_comp_isSheaf (wcProEtBaseChange i) (Scheme.ProEt.topology Y)
        (Scheme.ProEt.topology Z) (wcContSheaf Z (ZMod (ℓ ^ k))))

  apply wc_proet_epi_of_affine_lift Y
  intro U hU y
  have hy₀ : (φ.app (Opposite.op U)).hom (((inv φ).app (Opposite.op U)).hom y) = y := by
    have e := NatTrans.congr_app (IsIso.inv_hom_id φ) (Opposite.op U)
    exact congrArg (fun f : ((sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op U) ⟶
      (sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op U)) => f.hom y) e
  obtain ⟨y₀, rfl⟩ : ∃ y₀ : P.obj (Opposite.op U), (φ.app (Opposite.op U)).hom y₀ = y :=
    ⟨_, hy₀⟩
  let s : C(↥(Limits.pullback U.hom i), ZMod (ℓ ^ k)) :=
    (show ULift.{u+1} C(↥(Limits.pullback U.hom i), ZMod (ℓ ^ k)) from y₀).down
  let s' : C(↥(Limits.pullback U.hom i), ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun z => ULift.up (((s z).val : ℕ) : ℚ_[ℓ]),
      (continuous_of_discreteTopology
        (f := fun a : ZMod (ℓ ^ k) => (ULift.up.{u+1} (((a.val : ℕ) : ℚ_[ℓ]))))).comp
        s.continuous⟩
  obtain ⟨W, g, t', hW, hg, ht'⟩ := wc_fibre_function_local_extension i ℓ U hU s'
  let t : C(↥W.left, ZMod (ℓ ^ k)) :=
    ⟨fun w => ρ (t' w).down, hρc.comp (continuous_uliftDown.comp t'.continuous)⟩
  refine ⟨W, g, (ULift.up t : ULift.{u+1} C(↥W.left, ZMod (ℓ ^ k))), hW, hg, ?_⟩
  have nat := congrArg (fun f : (P.obj (Opposite.op U) ⟶
      (sheafify (Scheme.ProEt.topology Y) P).obj (Opposite.op W)) => f.hom y₀) (φ.naturality g.op)
  refine Eq.trans ?_ nat
  change (φ.app (Opposite.op W)).hom
      (ULift.up.{u+1} (t.comp (Limits.pullback.fst W.hom i).base.hom)) =
    (φ.app (Opposite.op W)).hom ((P.map g.op).hom y₀)
  refine congrArg (φ.app (Opposite.op W)).hom (ULift.ext _ _ (ContinuousMap.ext fun z => ?_))
  have e := congrArg (fun f : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ]) => (f z).down) ht'
  show ρ (t' ((Limits.pullback.fst W.hom i).base.hom z)).down =
    s (((wcProEtBaseChange i).map g).left.base.hom z)
  have e' : (t' ((Limits.pullback.fst W.hom i).base.hom z)).down =
      (((s (((wcProEtBC i).map g).left.base.hom z)).val : ℕ) : ℚ_[ℓ]) := e
  rw [e']
  exact hρ _

theorem wc_contPull_kernel_vanSub {Y Z : Scheme.{u}} (i : Z ⟶ Y) (n : ℕ) :
    ∃ ι : Limits.kernel (wcContPull i (ZMod n)) ⟶
        (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).obj
          (SheafOfModules.unit (wcZModRingSheaf Y n)),
      Mono ι ∧ ∀ (T : Y.ProEt)
        (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).obj
          (SheafOfModules.unit (wcZModRingSheaf Y n))).obj.obj (Opposite.op T)),
        (∃ k, (ι.hom.app (Opposite.op T)).hom k = f) ↔
          ∀ z : T.left, T.hom z ∈ Set.range i →
            (show C(↥T.left, ULift.{u+1} (ZMod n)) from f) z = 0 :=
by
  classical

  have crit : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl

  have hπ : ∀ {S₁ S₂ : Scheme.{u}} (f : S₁ ⟶ S₂),
      (wcProEtBaseChange f).IsContinuous (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁) := by
    intro S₁ S₂ f
    have hpres : Limits.PreservesFiniteLimits (wcProEtBaseChange f) := by
      let e : Scheme.ProEt.forget S₂ ⋙ Over.pullback f ≅
          wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁ :=
        NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)
      haveI : Limits.PreservesFiniteLimits (wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁) :=
        Limits.preservesFiniteLimits_of_natIso e
      exact Limits.preservesFiniteLimits_of_reflects_of_preserves (wcProEtBaseChange f)
        (Scheme.ProEt.forget S₁)
    haveI := hpres
    haveI hflat : RepresentablyFlat (wcProEtBaseChange f) :=
      flat_of_preservesFiniteLimits (wcProEtBaseChange f)
    have hle : ∀ (U : S₂.ProEt) (R : Sieve U),
        Sieve.pullback (Limits.pullback.fst U.hom f)
          (Sieve.functorPushforward (Scheme.ProEt.forget S₂ ⋙ Over.forget S₂) R) ≤
        Sieve.functorPushforward (Scheme.ProEt.forget S₁ ⋙ Over.forget S₁)
          (Sieve.functorPushforward (wcProEtBaseChange f) R) := by
      intro U R Z h hh
      obtain ⟨V, g, k, hg, hk⟩ := hh
      change h ≫ Limits.pullback.fst U.hom f = k ≫ g.left at hk
      have hw : g.left ≫ U.hom = V.hom := MorphismProperty.Over.w g
      have w : k ≫ V.hom = (h ≫ Limits.pullback.snd U.hom f) ≫ f :=
        calc k ≫ V.hom = k ≫ (g.left ≫ U.hom) := congrArg (k ≫ ·) hw.symm
        _ = (k ≫ g.left) ≫ U.hom := (Category.assoc _ _ _).symm
        _ = (h ≫ Limits.pullback.fst U.hom f) ≫ U.hom := congrArg (· ≫ U.hom) hk.symm
        _ = h ≫ (Limits.pullback.fst U.hom f ≫ U.hom) := Category.assoc _ _ _
        _ = h ≫ (Limits.pullback.snd U.hom f ≫ f) := congrArg (h ≫ ·) Limits.pullback.condition
        _ = (h ≫ Limits.pullback.snd U.hom f) ≫ f := (Category.assoc _ _ _).symm
      refine ⟨(wcProEtBaseChange f).obj V, (wcProEtBaseChange f).map g,
        Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w,
        Sieve.image_mem_functorPushforward (wcProEtBaseChange f) R hg, ?_⟩
      have hmap : ((wcProEtBaseChange f).map g).left =
          Limits.pullback.lift (Limits.pullback.fst V.hom f ≫ g.left) (Limits.pullback.snd V.hom f)
            (by rw [Category.assoc, MorphismProperty.Over.w g]; exact Limits.pullback.condition) :=
        rfl
      change h = Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫
        ((wcProEtBaseChange f).map g).left
      rw [hmap]
      apply Limits.pullback.hom_ext
      · refine hk.trans ?_
        refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_fst _ _ _)).trans ?_
        refine (Category.assoc _ _ _).symm.trans ?_
        exact congrArg (fun x => x ≫ g.left) (Limits.pullback.lift_fst _ _ _)
      · refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_snd _ _ _)).trans ?_
        exact Limits.pullback.lift_snd _ _ _
    have hcov : CoverPreserving (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁)
        (wcProEtBaseChange f) := by
      refine ⟨fun {U} {R} hR => ?_⟩
      have hS := (crit S₂ U R).1 hR
      have hP := Scheme.proetaleTopology.pullback_stable (Limits.pullback.fst U.hom f) hS
      have hQ := Scheme.proetaleTopology.superset_covering (hle U R) hP
      exact (crit S₁ ((wcProEtBaseChange f).obj U)
        (Sieve.functorPushforward (wcProEtBaseChange f) R)).2 hQ
    exact Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.ProEt.topology S₁) (wcProEtBaseChange f)) hcov

  have K1 : ∀ {F G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (g : F ⟶ G)
      (T : Y.ProEt) (s : F.obj.obj (Opposite.op T)),
      (∃ k, ((Limits.kernel.ι g).hom.app (Opposite.op T)).hom k = s) ↔
        (g.hom.app (Opposite.op T)).hom s = 0 := by
    intro F G g T s
    let E : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} :=
      sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⋙
        (evaluation (Y.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T)
    constructor
    · rintro ⟨k, rfl⟩
      have h : E.map (Limits.kernel.ι g) ≫ E.map g = 0 := by
        rw [← E.map_comp, Limits.kernel.condition, E.map_zero]
      have h2 : (E.map (Limits.kernel.ι g) ≫ E.map g).hom k =
          (0 : E.obj (Limits.kernel g) ⟶ E.obj G).hom k := by rw [h]
      exact h2
    · intro hs
      have hl := Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel g) E
      let k' : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ E.obj F :=
        AddCommGrpCat.ofHom ((zmultiplesHom (E.obj F) s).comp AddEquiv.ulift.toAddMonoidHom)
      have hk'1 : k'.hom (ULift.up 1) = s := one_zsmul s
      have hk' : k' ≫ E.map g = 0 := by
        apply AddCommGrpCat.ext
        intro m
        change (g.hom.app (Opposite.op T)).hom (m.down • s) = 0
        rw [map_zsmul, hs, smul_zero]
      obtain ⟨l, hl'⟩ := Limits.KernelFork.IsLimit.lift' hl k' hk'
      refine ⟨l.hom (ULift.up 1), ?_⟩
      have e : (l ≫ E.map (Limits.kernel.ι g)).hom (ULift.up 1) = k'.hom (ULift.up 1) :=
        congrArg (fun φ => AddCommGrpCat.Hom.hom φ (ULift.up 1)) hl'
      exact e.trans hk'1

  have K2 : ∀ (T : Y.ProEt) (x : (wcContSheaf Y (ZMod n)).obj.obj (Opposite.op T)),
      ((wcContPull i (ZMod n)).hom.app (Opposite.op T)).hom x = 0 ↔
        ∀ z : T.left, T.hom z ∈ Set.range i →
          (show ULift.{u+1} C(↥T.left, ZMod n) from x).down z = 0 := by
    intro T x
    haveI := hπ i
    have hQ : Presheaf.IsSheaf (Scheme.ProEt.topology Y)
        ((wcProEtBaseChange i).op ⋙ (wcContSheaf Z (ZMod n)).obj) :=
      Functor.op_comp_isSheaf (wcProEtBaseChange i) _ _ (wcContSheaf Z (ZMod n))
    haveI := isIso_toSheafify (Scheme.ProEt.topology Y) hQ
    have hinj : Function.Injective ((toSheafify (Scheme.ProEt.topology Y)
        ((wcProEtBaseChange i).op ⋙ (wcContSheaf Z (ZMod n)).obj)).app (Opposite.op T)).hom := by
      apply (AddCommGrpCat.mono_iff_injective _).1
      infer_instance
    have e : ((wcContPull i (ZMod n)).hom.app (Opposite.op T)).hom x =
        ((toSheafify (Scheme.ProEt.topology Y)
          ((wcProEtBaseChange i).op ⋙ (wcContSheaf Z (ZMod n)).obj)).app (Opposite.op T)).hom
          (ULift.up ((show ULift.{u+1} C(↥T.left, ZMod n) from x).down.comp
            (Limits.pullback.fst T.hom i).base.hom)) := rfl
    rw [e]
    constructor
    · intro h0 z hz
      have h1 := hinj (h0.trans (map_zero _).symm)
      have h1' : (ULift.up ((show ULift.{u+1} C(↥T.left, ZMod n) from x).down.comp
            (Limits.pullback.fst T.hom i).base.hom) :
            ULift.{u+1} C(↥(Limits.pullback T.hom i), ZMod n)) = 0 := h1
      have h2 : ((show ULift.{u+1} C(↥T.left, ZMod n) from x).down.comp
            (Limits.pullback.fst T.hom i).base.hom : C(↥(Limits.pullback T.hom i), ZMod n)) = 0 :=
        congrArg ULift.down h1'
      have hz' : z ∈ Set.range (Limits.pullback.fst T.hom i) := by
        rw [Scheme.Pullback.range_fst]
        exact hz
      obtain ⟨p, rfl⟩ := hz'
      exact DFunLike.congr_fun h2 p
    · intro H
      have h0' : (ULift.up ((show ULift.{u+1} C(↥T.left, ZMod n) from x).down.comp
            (Limits.pullback.fst T.hom i).base.hom) :
            ULift.{u+1} C(↥(Limits.pullback T.hom i), ZMod n)) = 0 := by
        apply ULift.ext
        refine ContinuousMap.ext fun p => ?_
        have hp : T.hom (Limits.pullback.fst T.hom i p) ∈ Set.range i := by
          refine ⟨Limits.pullback.snd T.hom i p, ?_⟩
          first
            | exact (congrArg (fun φ : Limits.pullback T.hom i ⟶ Y => φ p)
                (Limits.pullback.condition (f := T.hom) (g := i))).symm
            | rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
            | rw [← Scheme.comp_base_apply, ← Limits.pullback.condition, Scheme.comp_base_apply]
        exact H _ hp
      have h0 : (ULift.up ((show ULift.{u+1} C(↥T.left, ZMod n) from x).down.comp
            (Limits.pullback.fst T.hom i).base.hom) :
            ↑(((wcProEtBaseChange i).op ⋙ (wcContSheaf Z (ZMod n)).obj).obj (Opposite.op T))) = 0 :=
        h0'
      exact (congrArg ((toSheafify (Scheme.ProEt.topology Y)
          ((wcProEtBaseChange i).op ⋙ (wcContSheaf Z (ZMod n)).obj)).app (Opposite.op T)).hom
            h0).trans (map_zero _)

  let GY := (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).obj
    (SheafOfModules.unit (wcZModRingSheaf Y n))
  let jY := wcContSheaf Y (ZMod n)
  let eY : ∀ V : (Y.ProEt)ᵒᵖ, GY.obj.obj V ≅ jY.obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod n)))) :
              ULift.{u+1} C(↥(Opposite.unop V).left, ZMod n))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥(Opposite.unop V).left, ZMod n)) :
              C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod n)))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let NY : GY.obj ≅ jY.obj := NatIso.ofComponents eY (fun {V W} f => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let φ : GY ≅ jY := ObjectProperty.isoMk _ NY
  refine ⟨Limits.kernel.ι (wcContPull i (ZMod n)) ≫ φ.inv, inferInstance, ?_⟩
  intro T f
  have step1 : (∃ k, ((Limits.kernel.ι (wcContPull i (ZMod n)) ≫ φ.inv).hom.app
        (Opposite.op T)).hom k = f) ↔
      ∃ k, ((Limits.kernel.ι (wcContPull i (ZMod n))).hom.app (Opposite.op T)).hom k =
        (eY (Opposite.op T)).hom.hom f := by
    constructor
    · rintro ⟨k, hk⟩
      refine ⟨k, ?_⟩
      rw [← hk]
      rfl
    · rintro ⟨k, hk⟩
      refine ⟨k, ?_⟩
      change (eY (Opposite.op T)).inv.hom
        (((Limits.kernel.ι (wcContPull i (ZMod n))).hom.app (Opposite.op T)).hom k) = f
      rw [hk]
      rfl
  refine (step1.trans ((K1 _ T _).trans (K2 T _))).trans ?_
  refine forall_congr' fun z => imp_congr_right fun _ => ?_
  change ((show C(↥T.left, ULift.{u+1} (ZMod n)) from f) z).down = 0 ↔
    (show C(↥T.left, ULift.{u+1} (ZMod n)) from f) z = 0
  exact ⟨fun h => ULift.ext _ _ h, fun h => congrArg ULift.down h⟩

theorem wc_pencil_nbhd_fibre_geom (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [IsLocalRing A]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F'')) :
    ∃ q : ((wcProEtPullback D.f).obj V₀).left ⟶ Spec (.of A), IsProper q ∧
      CompactSpace ((wcProEtPullback D.f).obj V₀).left ∧
      IsSeparated (Limits.terminal.from ((wcProEtPullback D.f).obj V₀).left) ∧
      ∀ z : ((wcProEtPullback D.f).obj V₀).left,
        ((wcProEtPullback D.f).obj V₀).hom z ∈ Set.range (Limits.pullback.fst D.f D.u0) ↔
          q z = IsLocalRing.closedPoint A :=
by
  classical
  haveI := D.proper
  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI h1 : IsProper (Limits.pullback.fst V₀.hom D.f) := by
    first
    | infer_instance
    | exact MorphismProperty.pullback_fst (P := @IsProper) _ _ hfp
  obtain ⟨q, hqdef⟩ : ∃ q : Limits.pullback V₀.hom D.f ⟶ Spec (.of A),
      q = Limits.pullback.fst V₀.hom D.f ≫ e.hom := ⟨_, rfl⟩
  haveI hq : IsProper q := by rw [hqdef]; infer_instance
  have hc : CompactSpace (Limits.pullback (C := Scheme.{u}) V₀.hom D.f) :=
    QuasiCompact.compactSpace_of_compactSpace q
  have hsep : IsSeparated (Limits.terminal.from (Limits.pullback (C := Scheme.{u}) V₀.hom D.f)) := by
    rw [Limits.terminal.hom_ext (Limits.terminal.from _) (q ≫ Limits.terminal.from (Spec (.of A)))]
    infer_instance
  have hrng0 : Set.range D.u0 = {D.u0 (IsLocalRing.closedPoint F'')} := by
    ext x
    constructor
    · rintro ⟨s, rfl⟩
      rw [Subsingleton.elim s (IsLocalRing.closedPoint F'')]
      exact Set.mem_singleton _
    · rintro rfl
      exact ⟨_, rfl⟩
  have hsub : ∀ v : V₀.left, V₀.hom v = D.u0 (IsLocalRing.closedPoint F'') ↔
      e.hom v = IsLocalRing.closedPoint A := by
    intro v
    constructor
    · intro h
      obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := D.u0)
        v (IsLocalRing.closedPoint F'') h
      obtain ⟨w₀, hw₀1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom)
        (g := D.u0) (e.inv (IsLocalRing.closedPoint A)) (IsLocalRing.closedPoint F'') hv
      have hww : w = w₀ := by
        rw [← Scheme.hom_inv_apply ε w, ← Scheme.hom_inv_apply ε w₀,
          Subsingleton.elim (ε.hom w) (ε.hom w₀)]
      rw [← hw1, hww, hw₀1]
      first
        | exact Scheme.inv_hom_apply e (IsLocalRing.closedPoint A)
        | exact (Scheme.inv_hom_apply e (IsLocalRing.closedPoint A) :)
        | (rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl)
    · intro h
      rw [← Scheme.hom_inv_apply e v, h]
      exact hv
  have hfib : ∀ z : Limits.pullback (C := Scheme.{u}) V₀.hom D.f,
      Limits.pullback.snd V₀.hom D.f z ∈ Set.range (Limits.pullback.fst D.f D.u0) ↔
        q z = IsLocalRing.closedPoint A := by
    intro z
    rw [Scheme.Pullback.range_fst, Set.mem_preimage, hrng0, Set.mem_singleton_iff]
    have hcond : V₀.hom (Limits.pullback.fst V₀.hom D.f z) =
        D.f (Limits.pullback.snd V₀.hom D.f z) := by
      have e1 := Scheme.Hom.comp_apply (Limits.pullback.fst V₀.hom D.f) V₀.hom z
      have e2 := Scheme.Hom.comp_apply (Limits.pullback.snd V₀.hom D.f) D.f z
      rw [Limits.pullback.condition] at e1
      exact e1.symm.trans e2
    rw [← hcond, hsub, hqdef]
    all_goals first
      | exact Iff.rfl
      | rw [Scheme.Hom.comp_apply]
      | simp only [Scheme.Hom.comp_apply]
  exact ⟨q, hq, hc, hsep, hfib⟩

theorem wc_pencil_nbhd_torsion_restriction_injective (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (L : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology (Limits.pullback D.f D.u0)) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush (Limits.pullback.fst D.f D.u0))
    (θ : ∀ V : D.Yt.left.ProEt, L.obj (wcFreeSheaf D.Yt.left V) ≅
      wcFreeSheaf (Limits.pullback D.f D.u0) ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj V))
    (j k : ℕ) :
    Function.Injective (wcProEtRes (Limits.pullback.fst D.f D.u0) L adj θ (ZMod (ℓ ^ k))
      ((wcProEtPullback D.f).obj V₀) j) :=
by
  classical

  haveI hsub : Subsingleton ↥(Spec (.of F'')) := by
    constructor
    intro a b
    apply PrimeSpectrum.ext
    have ha := (Ideal.eq_bot_or_top (PrimeSpectrum.asIdeal a)).resolve_right
      (PrimeSpectrum.isPrime a).ne_top
    have hb := (Ideal.eq_bot_or_top (PrimeSpectrum.asIdeal b)).resolve_right
      (PrimeSpectrum.isPrime b).ne_top
    rw [ha, hb]
  haveI hu0 : IsClosedImmersion D.u0 :=
    isClosedImmersion_of_comp_eq_id (Y := Spec (.of F'')) (wcP1Over F'').hom D.u0 D.hu0
  haveI hcl : IsClosedImmersion (Limits.pullback.fst D.f D.u0) := by
    first
      | exact inferInstance
      | exact MorphismProperty.pullback_fst (P := @IsClosedImmersion) _ _ hu0
  haveI : IsProper D.Yt.hom := D.proper
  haveI : IsLocallyNoetherian D.Yt.left :=
    LocallyOfFiniteType.isLocallyNoetherian (Y := Spec (.of F'')) D.Yt.hom

  haveI : (wcProEtPush (Limits.pullback.fst D.f D.u0)).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesLimitsOfSize.{0, 0} (wcProEtPush (Limits.pullback.fst D.f D.u0)) :=
    adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (wcProEtPush (Limits.pullback.fst D.f D.u0)) :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  haveI : Limits.PreservesFiniteColimits (wcProEtPush (Limits.pullback.fst D.f D.u0)) :=
    wc_proet_push_closed_preservesFiniteColimits (Limits.pullback.fst D.f D.u0)
  haveI : (wcProEtPush (Limits.pullback.fst D.f D.u0)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : (wcProEtPush (Limits.pullback.fst D.f D.u0)).Additive :=
    Functor.additive_of_preserves_binary_products _

  obtain ⟨q, hq, hcpt, hsep, hfib⟩ := wc_pencil_nbhd_fibre_geom F' F'' Y n D V₀ A e ε hv
  haveI := hq
  haveI := hcpt
  haveI := hsep
  have hn : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  obtain ⟨ι, hιm, hchar⟩ := wc_contPull_kernel_vanSub (Limits.pullback.fst D.f D.u0) (ℓ ^ k)

  have hvan : ∀ (m : ℕ) (y : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (Limits.kernel (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k)))) m), y = 0 := by
    intro m y
    cases m with
    | succ m' =>
      have hC : IsClosed (Set.range (Limits.pullback.fst D.f D.u0)) :=
        (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst D.f D.u0)).isClosed_range
      have hopen : IsOpen ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
        apply isOpen_compl_iff.mpr
        first
          | exact IsLocalRing.isClosed_singleton_closedPoint A
          | exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
              (IsLocalRing.maximalIdeal.isMaximal A)
      have hne : ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) ≠ Set.univ := by
        intro h
        have h' : IsLocalRing.closedPoint A ∈ ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) :=
          h ▸ Set.mem_univ _
        exact h' (Set.mem_singleton _)
      have het : ∀ q' : ℕ, Subsingleton (wcEtExt ((wcProEtPullback D.f).obj V₀).left
          (wcEtExtZero ((wcProEtPullback D.f).obj V₀).left
            (((wcProEtPullback D.f).obj V₀).hom ⁻¹' Set.range (Limits.pullback.fst D.f D.u0))ᶜ
            (ℓ ^ k)) (q' + 1)) := by
        intro q'
        have hset : (((wcProEtPullback D.f).obj V₀).hom ⁻¹'
            Set.range (Limits.pullback.fst D.f D.u0))ᶜ =
            q ⁻¹' ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
          ext z
          simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_singleton_iff]
          exact not_congr (hfib z)
        rw [hset]
        exact wc_et_henselian_proper_vanishing A _ q (ℓ ^ k) hn.ne' _ hopen hne (q' + 1)
      exact wc_proet_vanishing_subsheaf_zmod_of_et D.Yt.left ((wcProEtPullback D.f).obj V₀)
        (Set.range (Limits.pullback.fst D.f D.u0)) hC (ℓ ^ k) hn _ ι hιm hchar het m' y
    | zero =>
      obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      obtain ⟨ev, -, hev0⟩ := proet_free_sheaf_hom_equiv D.Yt.left ((wcProEtPullback D.f).obj V₀)
      have hvz := (hchar ((wcProEtPullback D.f).obj V₀)
        ((ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom (ev _ φ))).1 ⟨_, rfl⟩
      let r : C(↥((wcProEtPullback D.f).obj V₀).left, ULift.{u+1} (ZMod (ℓ ^ k))) :=
        (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom (ev _ φ)
      have hrz : ∀ z, r z = 0 := by
        intro z
        have hT : IsClosed (r ⁻¹' {r z}) := (isClosed_discrete _).preimage r.continuous
        have h1 : IsClosed (q '' (r ⁻¹' {r z})) := Scheme.Hom.isClosedMap q _ hT
        have h2 : q z ∈ q '' (r ⁻¹' {r z}) := ⟨z, rfl, rfl⟩
        obtain ⟨z', hz'1, hz'2⟩ := (IsLocalRing.specializes_closedPoint (q z)).mem_closed h1 h2
        have h3 : r z' = r z := hz'1
        rw [← h3]
        exact hvz z' ((hfib z').2 hz'2)
      have hr0 : r = 0 := ContinuousMap.ext hrz
      have hmono : Mono (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))) := by
        have h1 : Mono ι.hom := (Sheaf.Hom.mono_iff_presheaf_mono _ _ ι).1 hιm
        exact (NatTrans.mono_iff_mono_app _).1 h1 _
      have hinj : Function.Injective
          (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom :=
        (AddCommGrpCat.mono_iff_injective _).1 hmono
      have hs : ev _ φ = 0 := by
        apply hinj
        rw [map_zero]
        exact hr0
      have hφ : φ = 0 := (ev _).injective (hs.trans (hev0 _).symm)
      rw [hφ]
      first
        | exact Abelian.Ext.mk₀_zero
        | simp

  rw [injective_iff_map_eq_zero]
  intro x hx
  change (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
    ((Abelian.Ext.mapExactFunctor L x).comp
      (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k))))) (add_zero j))
    (zero_add j) = 0 at hx

  have h1 : (Abelian.Ext.mapExactFunctor L x).comp
      (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k))))) (add_zero j) = 0 := by
    have h4 : (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).hom).comp
        ((Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
          ((Abelian.Ext.mapExactFunctor L x).comp
            (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
              (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
                (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k))))) (add_zero j))
          (zero_add j)) (zero_add j) =
        (Abelian.Ext.mapExactFunctor L x).comp
          (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
            (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
              (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k))))) (add_zero j) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [← h4, hx, Abelian.Ext.comp_zero]

  have h2 : (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f D.u0))
      (Abelian.Ext.mapExactFunctor L x)).comp
      (Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f D.u0)).map
        ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
          (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
            (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k)))))) (add_zero j) = 0 := by
    have e1 := congrArg (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f D.u0))) h1
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀] at e1
    rw [e1]
    exact map_zero ((wcProEtPush (Limits.pullback.fst D.f D.u0)).mapExtAddHom _ _ j)

  have hη : x.comp (Abelian.Ext.mk₀ (adj.unit.app (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))))
      (add_zero j) =
      (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)))).comp
        (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f D.u0))
          (Abelian.Ext.mapExactFunctor L x)) (zero_add j) := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x adj.unit
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.id_mapExactFunctor] at h
    exact h
  have hu : adj.unit.app (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) ≫
      (wcProEtPush (Limits.pullback.fst D.f D.u0)).map
        ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
          (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
            (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k)))) =
      wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k)) := by
    have e2 := adj.homEquiv_unit (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
      (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))
      ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k))))
    rw [Equiv.apply_symm_apply] at e2
    exact e2.symm
  have h3 : x.comp (Abelian.Ext.mk₀ (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k))))
      (add_zero j) = 0 := by
    have e1 : (Abelian.Ext.mk₀ (adj.unit.app
        (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)))).comp
        ((Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f D.u0))
          (Abelian.Ext.mapExactFunctor L x)).comp
          (Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f D.u0)).map
            ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
              (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))).symm
                (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k)))))) (add_zero j))
        (zero_add j) = 0 := by
      rw [h2, Abelian.Ext.comp_zero]
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add j) (add_zero j) (show 0 + j + 0 = j by omega),
      ← hη, Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (show j + 0 + 0 = j by omega),
      Abelian.Ext.mk₀_comp_mk₀, hu] at e1
    exact e1

  have hepi : Epi (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k))) :=
    wc_contPull_zmod_pow_epi (Limits.pullback.fst D.f D.u0) ℓ k
  have hSE : (ShortComplex.mk (Limits.kernel.ι (wcContPull (Limits.pullback.fst D.f D.u0)
      (ZMod (ℓ ^ k)))) (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k)))
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
  obtain ⟨x', hx'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSE x h3

  rw [← hx', hvan j x', Abelian.Ext.zero_comp]

theorem wc_contPull_intToLadic {Y Z : Scheme.{u}} (i : Z ⟶ Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    wcIntToLadic Y ℓ ≫ wcContPull i ℚ_[ℓ] =
      wcContPull i ℤ_[ℓ] ≫ (wcProEtPush i).map (wcIntToLadic Z ℓ) :=
by
  apply Sheaf.hom_ext
  change (wcIntToLadic Y ℓ).hom ≫ (_ ≫ toSheafify _ _) =
    (_ ≫ toSheafify _ _) ≫ sheafifyMap (Scheme.ProEt.topology Y)
      (Functor.whiskerLeft (wcProEtBaseChange i).op (wcIntToLadic Z ℓ).hom)
  refine (Category.assoc _ _ _).symm.trans ?_
  refine Eq.trans ?_ (Category.assoc _ _ _).symm
  refine Eq.trans ?_ (whisker_eq _ (toSheafify_naturality ..))
  refine Eq.trans ?_ (Category.assoc _ _ _)
  refine eq_whisker ?_ _
  first
    | (ext V x; rfl)
    | (ext V x; exact ULift.ext _ _ (ContinuousMap.ext fun p => rfl))
    | (apply NatTrans.ext; funext V; rfl)

theorem wc_contPull_contSheafMap {Y Z : Scheme.{u}} (i : Z ⟶ Y) {M N : Type} [AddCommGroup M]
    [TopologicalSpace M] [IsTopologicalAddGroup M] [AddCommGroup N] [TopologicalSpace N]
    [IsTopologicalAddGroup N] (φ : M →+ N) (hφ : Continuous φ) :
    wcContSheafMap Y φ hφ ≫ wcContPull i N =
      wcContPull i M ≫ (wcProEtPush i).map (wcContSheafMap Z φ hφ) :=
by
  apply Sheaf.hom_ext
  change (wcContSheafMap Y φ hφ).hom ≫ (_ ≫ toSheafify _ _) =
    (_ ≫ toSheafify _ _) ≫ sheafifyMap (Scheme.ProEt.topology Y)
      (Functor.whiskerLeft (wcProEtBaseChange i).op (wcContSheafMap Z φ hφ).hom)
  refine (Category.assoc _ _ _).symm.trans ?_
  refine Eq.trans ?_ (Category.assoc _ _ _).symm
  refine Eq.trans ?_ (whisker_eq _ (toSheafify_naturality ..))
  refine Eq.trans ?_ (Category.assoc _ _ _)
  refine eq_whisker ?_ _
  ext V x
  rfl

theorem wc_proet_int_separated_of_finite (S : Scheme.{u}) (U : S.ProEt) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom))
    (hfin : ∀ j k : ℕ, Finite (Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod (ℓ ^ k))) j)) :
    ∀ (i : ℕ) (y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) i),
      (∀ k : ℕ, y.comp (Abelian.Ext.mk₀ (wcContSheafMap S
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero i) = 0) → y = 0 :=
by
  intro i y hy
  refine wc_int_ext_separated_of_finite S (wcFreeSheaf S U) ℓ (fun n k => hfin k n) i y ?_
  intro n
  have hℓ0 : (ℓ : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero
  have hc0 : ((ℓ : ℤ_[ℓ]) ^ n) ≠ 0 := pow_ne_zero n hℓ0
  have hφc : Continuous (AddMonoidHom.mulLeft ((ℓ : ℤ_[ℓ]) ^ n)) := by
    change Continuous (fun x : ℤ_[ℓ] => (ℓ : ℤ_[ℓ]) ^ n * x)
    exact continuous_const.mul continuous_id
  have hemb : Topology.IsEmbedding (AddMonoidHom.mulLeft ((ℓ : ℤ_[ℓ]) ^ n)) :=
    (hφc.isClosedEmbedding (mul_right_injective₀ hc0)).isEmbedding
  have hker : ∀ b : ℤ_[ℓ], (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom b = 0 ↔
      ∃ a : ℤ_[ℓ], AddMonoidHom.mulLeft ((ℓ : ℤ_[ℓ]) ^ n) a = b := by
    intro b
    change PadicInt.toZModPow n b = 0 ↔ ∃ a : ℤ_[ℓ], (ℓ : ℤ_[ℓ]) ^ n * a = b
    rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨a, ha⟩
      exact ⟨a, by rw [mul_comm]; exact ha⟩
    · rintro ⟨a, ha⟩
      exact ⟨a, by rw [mul_comm]; exact ha⟩
  have hsec : ∃ σ : ZMod (ℓ ^ n) → ℤ_[ℓ], Continuous σ ∧
      ∀ c, (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom (σ c) = c := by
    haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n (Fact.out : ℓ.Prime).ne_zero⟩
    refine ⟨fun c => ((c.val : ℕ) : ℤ_[ℓ]), continuous_of_discreteTopology, fun c => ?_⟩
    change PadicInt.toZModPow n ((c.val : ℕ) : ℤ_[ℓ]) = c
    rw [map_natCast, ZMod.natCast_zmod_val]
  obtain ⟨hz, hS⟩ := wc_contSheaf_shortExact S (AddMonoidHom.mulLeft ((ℓ : ℤ_[ℓ]) ^ n)) hφc
    (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom (hc n) hemb hker hsec
  have hM : wcContSheafMap S (AddMonoidHom.mulLeft ((ℓ : ℤ_[ℓ]) ^ n)) hφc =
      wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro f
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    rfl
  have hπ0 : wcContSheafMap S (AddMonoidHom.mulLeft ((ℓ : ℤ_[ℓ]) ^ n)) hφc ≫
      Limits.cokernel.π (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n)) = 0 := by
    rw [hM]
    exact Limits.cokernel.condition _
  obtain ⟨d, hd⟩ := Limits.CokernelCofork.IsColimit.desc' hS.gIsCokernel
    (Limits.cokernel.π (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n))) hπ0
  have hd' : wcContSheafMap S (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom (hc n) ≫ d =
      Limits.cokernel.π (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n)) := hd
  calc y.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n))))
        (add_zero i)
      = y.comp ((Abelian.Ext.mk₀ (wcContSheafMap S
          (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom (hc n))).comp
          (Abelian.Ext.mk₀ d) (add_zero 0)) (add_zero i) := by
        rw [Abelian.Ext.mk₀_comp_mk₀]
        exact congrArg (fun m => y.comp (Abelian.Ext.mk₀ m) (add_zero i)) hd'.symm
    _ = (y.comp (Abelian.Ext.mk₀ (wcContSheafMap S
          (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom (hc n))) (add_zero i)).comp
          (Abelian.Ext.mk₀ d) (add_zero i) :=
        (Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega)).symm
    _ = 0 := by rw [hy n, Abelian.Ext.zero_comp]

theorem wc_res_ladic_injective_of_torsion {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
    [CompactSpace ((wcProEtPullback i).obj U).left]
    [QuasiSeparatedSpace ((wcProEtPullback i).obj U).left]
    (hfin : ∀ j k : ℕ, Finite (Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ k))) j))
    (htor : ∀ j k : ℕ, Function.Injective (wcProEtRes i L adj θ (ZMod (ℓ ^ k)) U j))
    (j : ℕ) : Function.Injective (wcProEtRes i L adj θ ℚ_[ℓ] U j) :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := fun k =>
    ((continuous_apply k).comp (wc_padic_tower_facts ℓ).1).congr (fun _ => rfl)
  have ratY := proet_qcqs_ladic_rationalization Y U ℓ j
  have ratX := proet_qcqs_ladic_rationalization Z ((wcProEtPullback i).obj U) ℓ j

  let R : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (G' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (_ : L.obj G ⟶ G') (q : ℕ),
      Abelian.Ext (wcFreeSheaf Y U) G q →+
        Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) G' q :=
    fun G G' a q => ((Abelian.Ext.mk₀ (θ U).inv).precomp G'
      (zero_add q)).comp (((Abelian.Ext.mk₀ a).postcomp _ (add_zero q)).comp (L.mapExtAddHom _ _ q))
  have hR : ∀ G G' (a : L.obj G ⟶ G') (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G q),
      R G G' a q z = (Abelian.Ext.mk₀ (θ U).inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a) (add_zero q)) (zero_add q) := by
    intro G G' a q z
    first
      | rfl
      | (simp only [R, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2') (a1 : L.obj G1 ⟶ G1') (a2 : L.obj G2 ⟶ G2'),
      L.map κY ≫ a2 = a1 ≫ κX → ∀ (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G1 q),
      R G2 G2' a2 q (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (R G1 G1' a1 q z).comp (Abelian.Ext.mk₀ κX) (add_zero q) := by
    intro G1 G2 G1' G2' κY κX a1 a2 h q z
    have e1 : Abelian.Ext.mapExactFunctor L (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e2 : ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q)).comp
        (Abelian.Ext.mk₀ a2) (add_zero q) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a1) (add_zero q)).comp
        (Abelian.Ext.mk₀ κX) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [hR, hR, e1, e2]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm
  have hAdj : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2')
      (p1 : G1 ⟶ (wcProEtPush i).obj G1')
      (p2 : G2 ⟶ (wcProEtPush i).obj G2'),
      κY ≫ p2 = p1 ≫ (wcProEtPush i).map κX →
      L.map κY ≫ (adj.homEquiv _ _).symm p2 = (adj.homEquiv _ _).symm p1 ≫ κX := by
    intro G1 G2 G1' G2' κY κX p1 p2 h
    rw [← adj.homEquiv_naturality_left_symm, h, adj.homEquiv_naturality_right_symm]
  let Ψ0 : Abelian.Ext (wcFreeSheaf Y U) (wcLadicSheaf Y ℓ) j →+
      Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcLadicSheaf Z ℓ) j :=
    R (wcLadicSheaf Y ℓ) (wcLadicSheaf Z ℓ) ((adj.homEquiv _ _).symm (wcContPull i ℚ_[ℓ])) j
  let ρI : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j →+
      Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcIntSheaf Z ℓ) j :=
    R (wcIntSheaf Y ℓ) (wcIntSheaf Z ℓ) ((adj.homEquiv _ _).symm (wcContPull i ℤ_[ℓ])) j
  let ρT : ∀ k : ℕ, Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ k))) j →+
      Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcContSheaf Z (ZMod (ℓ ^ k))) j :=
    fun k => R (wcContSheaf Y (ZMod (ℓ ^ k))) (wcContSheaf Z (ZMod (ℓ ^ k)))
      ((adj.homEquiv _ _).symm (wcContPull i (ZMod (ℓ ^ k)))) j
  have hΨ0 : ∀ z, wcProEtRes i L adj θ ℚ_[ℓ] U j z = Ψ0 z := fun z => rfl
  have hρT : ∀ k x, wcProEtRes i L adj θ (ZMod (ℓ ^ k)) U j x = ρT k x := fun k x => rfl
  have hNatQ : ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j,
      Ψ0 (y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero j)) =
        (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic Z ℓ)) (add_zero j) := by
    intro y
    have hsq : wcIntToLadic Y ℓ ≫ wcContPull i ℚ_[ℓ] =
        wcContPull i ℤ_[ℓ] ≫ (wcProEtPush i).map (wcIntToLadic Z ℓ) :=
      wc_contPull_intToLadic i ℓ
    exact hN _ _ _ _ (hAdj _ _ _ _ hsq) j y
  have hNatI : ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j),
      ρT k (x.comp (Abelian.Ext.mk₀ (wcContSheafMap Y
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j)) =
        (ρI x).comp (Abelian.Ext.mk₀ (wcContSheafMap Z
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j) :=
    fun k x => hN _ _ _ _ (hAdj _ _ _ _ (wc_contPull_contSheafMap i _ (hc k))) j x

  have hρIinj : ∀ x, ρI x = 0 → x = 0 := by
    intro x hx
    refine wc_proet_int_separated_of_finite Y U ℓ hc hfin j x ?_
    intro k
    apply htor j k
    rw [hρT, hρT, map_zero, hNatI k x, hx]
    exact Abelian.Ext.zero_comp _ _ _ _ _

  have Q1 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q N : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q),
      N • x = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (N : ℚ_[ℓ]))) (add_zero q) := by
    intro S P q N x
    obtain ⟨h1, -, hadd⟩ := wc_ladic_scalar_ring S ℓ
    induction N with
    | zero =>
      have h0 : wcLadicScalar S ℓ 0 = 0 := by
        have h := congrArg (fun t => t - wcLadicScalar S ℓ 0) (hadd 0 0)
        simp only [add_zero, sub_self, add_sub_cancel_right] at h
        exact h.symm
      rw [zero_nsmul, Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]
  have hinv : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q) (c : ℚ_[ℓ]), c ≠ 0 →
      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero q)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c⁻¹)) (add_zero q) = x := by
    intro S P q x c hc0
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring S ℓ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hmul,
      inv_mul_cancel₀ hc0, h1, Abelian.Ext.comp_mk₀_id]
  have hΨ0inj : Function.Injective Ψ0 := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨a, y, hy⟩ := ratY.1 z
    have h2 : (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic Z ℓ)) (add_zero j) = 0 := by
      rw [← hNatQ y, ← hy, map_nsmul, hz, smul_zero]
    obtain ⟨b, hb⟩ := ratX.2 (ρI y) h2
    have h3 : ℓ ^ b • y = 0 := hρIinj _ (by rw [map_nsmul, hb])
    have h4 : (ℓ ^ b * ℓ ^ a) • z = 0 := by
      calc (ℓ ^ b * ℓ ^ a) • z = ℓ ^ b • (y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ))
            (add_zero j)) := by rw [mul_smul, hy]
        _ = ((Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)).postcomp
              (wcFreeSheaf Y U) (add_zero j)) (ℓ ^ b • y) :=
            (by rw [map_nsmul]; rfl)
        _ = 0 := by rw [h3, map_zero]
    have h5 : z.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ ((ℓ ^ b * ℓ ^ a : ℕ) : ℚ_[ℓ])))
        (add_zero j) = 0 := by
      rw [← Q1, h4]
    have hN0 : ((ℓ ^ b * ℓ ^ a : ℕ) : ℚ_[ℓ]) ≠ 0 :=
      Nat.cast_ne_zero.mpr (mul_ne_zero (pow_ne_zero _ hℓ0) (pow_ne_zero _ hℓ0))
    have h6 := hinv _ _ j z _ hN0
    rw [h5, Abelian.Ext.zero_comp] at h6
    exact h6.symm
  intro z z' h
  exact hΨ0inj h

theorem wc_pencil_nbhd_zmod_card_le (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) (j k : ℕ) :
    Finite (Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k))) j) ∧
    Nat.card (Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k))) j) ≤
    Nat.card (Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) j) :=
by

  have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro hk
    have hk' : ((ℓ : ℕ) : F'') = 0 := by
      apply (algebraMap F'' (AlgebraicClosure F'')).injective
      rw [map_natCast, map_zero]
      exact hk
    haveI : Fintype F'' := Fintype.ofFinite F''
    have hprime : Nat.Prime (ringChar F'') := CharP.char_is_prime F'' (ringChar F'')
    have h2 : ringChar F'' ∣ ℓ := (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp hk'
    have h3 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hprime (Fact.out : ℓ.Prime)).mp h2
    have h4 : ringChar F'' ∣ Nat.card F'' := by
      rw [Nat.card_eq_fintype_card]
      exact (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp (FiniteField.cast_card_eq_zero F'')
    exact hℓ (h3 ▸ h4)
  have hmK : ((ℓ ^ k : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    rw [Nat.cast_pow]
    exact pow_ne_zero _ hℓK

  haveI := D.proper
  haveI hpP : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hpsep : IsSeparated (wcP1Over F'').hom := inferInstance
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI : IsClosedImmersion (D.u0 ≫ (wcP1Over F'').hom) := by rw [D.hu0]; infer_instance
  haveI : IsClosedImmersion D.u0 := IsClosedImmersion.of_comp D.u0 (wcP1Over F'').hom

  haveI hfW : IsProper (Limits.pullback.fst V₀.hom D.f ≫ e.hom) := inferInstance
  haveI ht : IsClosedImmersion (ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom) :=
    inferInstance

  have qcsep : ∀ {X : Scheme.{u}} {R : CommRingCat.{u}} (g : X ⟶ Spec R) [IsProper g],
      CompactSpace X ∧ IsSeparated (Limits.terminal.from X) := by
    intro X R g _
    refine ⟨QuasiCompact.compactSpace_of_compactSpace g, ?_⟩
    rw [show Limits.terminal.from X = g ≫ Limits.terminal.from (Spec R) from
      Limits.terminal.hom_ext _ _]
    infer_instance

  obtain ⟨φ', hφ'⟩ : ∃ φ' : A →+* AlgebraicClosure F'',
      Spec.map (CommRingCat.ofHom φ') = ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom :=
    ⟨(Spec.preimage (ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom)).hom, by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  have hsurj : Function.Surjective φ' := by
    have h1 : Function.Surjective (Spec.map (CommRingCat.ofHom φ')).appTop.hom := by
      rw [hφ']
      exact (IsClosedImmersion.isAffine_surjective_of_isAffine _).2
    intro y
    obtain ⟨x, hx⟩ := h1 ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F''))).inv.hom y)
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom x, ?_⟩
    have h2 : (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F''))).hom.hom
        ((Spec.map (CommRingCat.ofHom φ')).appTop.hom x) =
        φ' ((Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom x) := by
      have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ'))
      exact this
    rw [← h2, hx]
    have h3 := congrArg (fun g => g.hom y)
      (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F''))).inv_hom_id
    exact h3
  haveI : IsLocalHom φ' := IsLocalHom.of_surjective φ' hsurj
  have hψbij : Function.Bijective (IsLocalRing.ResidueField.lift φ') := by
    refine ⟨(IsLocalRing.ResidueField.lift φ').injective, ?_⟩
    intro y
    obtain ⟨a, rfl⟩ := hsurj y
    exact ⟨IsLocalRing.residue A a, IsLocalRing.ResidueField.lift_residue_apply φ' a⟩
  haveI hσiso : IsIso (Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ'))) :=
    isIso_SpecMap_iff.mpr hψbij
  have hcomp : CommRingCat.ofHom (IsLocalRing.residue A) ≫
      CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ') = CommRingCat.ofHom φ' := by
    ext a
    exact IsLocalRing.ResidueField.lift_residue_apply φ' a
  have hσr : Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ')) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) =
      ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom := by
    rw [← Spec.map_comp, hcomp, hφ']

  have paste : ∀ {T : Scheme.{u}} (r : T ⟶ Spec (.of A)) (τ : Limits.pullback V₀.hom D.u0 ≅ T),
      τ.hom ≫ r = Limits.pullback.fst V₀.hom D.u0 ≫ e.hom →
      ∃ g : Limits.pullback (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ⟶ T,
        IsPullback g (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f)
          (Limits.pullback.fst D.f D.u0)) r (Limits.pullback.fst V₀.hom D.f ≫ e.hom) := by
    intro T r τ hτ
    have hL : IsPullback (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f)
          (Limits.pullback.fst D.f D.u0))
        (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0))
        (Limits.pullback.fst D.f D.u0) (Limits.pullback.snd V₀.hom D.f) :=
      (IsPullback.of_hasPullback _ _).flip
    have hR : IsPullback (Limits.pullback.snd D.f D.u0) (Limits.pullback.fst D.f D.u0)
        D.u0 D.f := (IsPullback.of_hasPullback _ _).flip
    have hO := hL.paste_horiz hR
    have hR2 : IsPullback (Limits.pullback.snd V₀.hom D.u0) (Limits.pullback.fst V₀.hom D.u0)
        D.u0 V₀.hom := (IsPullback.of_hasPullback _ _).flip
    have hcw : (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f)
          (Limits.pullback.fst D.f D.u0) ≫ Limits.pullback.fst V₀.hom D.f) ≫ V₀.hom =
        (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ≫
          Limits.pullback.snd D.f D.u0) ≫ D.u0 := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition (f := V₀.hom) (g := D.f)]
      have hw := hO.w
      simp only [Category.assoc] at hw
      exact hw.symm
    let c : Limits.pullback (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ⟶
        Limits.pullback V₀.hom D.u0 :=
      Limits.pullback.lift _ _ hcw
    have hc1 : c ≫ Limits.pullback.fst V₀.hom D.u0 =
        Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ≫
          Limits.pullback.fst V₀.hom D.f := Limits.pullback.lift_fst _ _ _
    have hc2 : c ≫ Limits.pullback.snd V₀.hom D.u0 =
        Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0) ≫
          Limits.pullback.snd D.f D.u0 := Limits.pullback.lift_snd _ _ _
    have s : IsPullback (c ≫ Limits.pullback.snd V₀.hom D.u0)
        (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0))
        D.u0 (Limits.pullback.fst V₀.hom D.f ≫ V₀.hom) := by
      rw [hc2, Limits.pullback.condition (f := V₀.hom) (g := D.f)]
      exact hO
    have hLeft := IsPullback.of_right s hc1 hR2
    refine ⟨c ≫ τ.hom, ?_⟩
    refine hLeft.of_iso (Iso.refl _) τ (Iso.refl _) e ?_ ?_ ?_ ?_ <;> simp [hτ]

  obtain ⟨g₂, hP2⟩ := paste (ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ e.hom) ε
    (Iso.hom_inv_id_assoc _ _)
  obtain ⟨g₁, hP1⟩ := paste (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
    (ε ≪≫ asIso (Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ')))) (by
      rw [Iso.trans_hom, asIso_hom, Category.assoc, hσr, Iso.hom_inv_id_assoc])
  haveI hg₂ : IsProper g₂ := MorphismProperty.of_isPullback (P := @IsProper) hP2.flip hfW
  let β₁ := hP1.flip.isoPullback

  obtain ⟨hW1, hW2⟩ := qcsep (Limits.pullback.fst V₀.hom D.f ≫ e.hom)
  obtain ⟨hW'1, hW'2⟩ := qcsep g₂

  have L1 : ∀ (S : Scheme.{u}) (U : S.ProEt) [CompactSpace U.left]
      [IsSeparated (Limits.terminal.from U.left)],
      Nonempty (Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod (ℓ ^ k))) j ≃
        wcEtCoh U.left (ℓ ^ k) j) := by
    intro S U _ _
    obtain ⟨E₁⟩ := wc_ext_free_slice_cont S U (ZMod (ℓ ^ k)) j
    obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont U.left
    haveI := hcont
    obtain ⟨c₁⟩ := wc_contSheaf_discrete_const U.left (ZMod (ℓ ^ k))
    obtain ⟨c₂⟩ := wc_epsInv_const U.left (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))
    let c := c₁ ≪≫ c₂.symm
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨E₃⟩ := wc_proet_etale_comparison_epsInv_qcsep U.left
      ((constantSheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))) j
    have key1 : ∀ x : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcContSheaf U.left (ZMod (ℓ ^ k))) j,
        (x.comp (Abelian.Ext.mk₀ c.hom) (add_zero j)).comp (Abelian.Ext.mk₀ c.inv)
          (add_zero j) = x := by
      intro x
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      exact Abelian.Ext.comp_mk₀_id x
    have key2 : ∀ y : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        ((wcEpsInv U.left).obj ((constantSheaf (Scheme.smallEtaleTopology U.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))) j,
        (y.comp (Abelian.Ext.mk₀ c.inv) (add_zero j)).comp (Abelian.Ext.mk₀ c.hom)
          (add_zero j) = y := by
      intro y
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
      exact Abelian.Ext.comp_mk₀_id y
    let E₂ : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcContSheaf U.left (ZMod (ℓ ^ k))) j ≃
        Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        ((wcEpsInv U.left).obj ((constantSheaf (Scheme.smallEtaleTopology U.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))) j :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ c.hom) (add_zero j)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ c.inv) (add_zero j)
        left_inv := key1
        right_inv := key2 }
    exact ⟨E₁.trans (E₂.trans E₃)⟩

  obtain ⟨eS⟩ := @L1 D.Yt.left ((wcProEtPullback D.f).obj V₀) hW1 hW2
  obtain ⟨eT⟩ := @L1 (Limits.pullback D.f D.u0)
    ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀))
    hW'1 hW'2
  obtain ⟨eH⟩ := wc_et_henselian_closed_fibre_coh A (Limits.pullback V₀.hom D.f)
    (Limits.pullback.fst V₀.hom D.f ≫ e.hom) (ℓ ^ k) hm0 wc_et_henselian_proper_vanishing j
  obtain ⟨eI⟩ := wc_et_coh_iso_invariance β₁.hom (ℓ ^ k) j
  have hfinW' := wc_etale_proper_finite (AlgebraicClosure F'')
    (Limits.pullback (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f D.u0)) g₂
    (ℓ ^ k) hmK j
  have hfinT := @Finite.of_equiv _ _ hfinW' eT.symm
  exact ⟨hfinT, le_of_eq (Nat.card_congr (eS.trans (eH.trans (eI.trans eT.symm)))).symm⟩

theorem wc_res_ladic_surjective_of_torsion {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
    [CompactSpace ((wcProEtPullback i).obj U).left]
    [QuasiSeparatedSpace ((wcProEtPullback i).obj U).left]
    (hfin' : ∀ j k : ℕ, Finite (Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U))
      (wcContSheaf Z (ZMod (ℓ ^ k))) j))
    (htor : ∀ j k : ℕ, Function.Bijective (wcProEtRes i L adj θ (ZMod (ℓ ^ k)) U j))
    (j : ℕ) : Function.Surjective (wcProEtRes i L adj θ ℚ_[ℓ] U j) :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := fun k =>
    ((continuous_apply k).comp (wc_padic_tower_facts ℓ).1).congr (fun _ => rfl)
  have hcongr : ∀ (S : Scheme.{u}) {A B : Type} [AddCommGroup A] [TopologicalSpace A]
      [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ φ' : A →+ B) (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap S φ hφ = wcContSheafMap S φ' hφ' := by
    intro S A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl

  have g1 : ∀ (S : Scheme.{u}) (m : ℕ),
      wcContSheafMap S (PadicInt.toZModPow (p := ℓ) (m + 1)).toAddMonoidHom (hc (m + 1)) ≫
        wcContSheafMap S (wcTowerCast ℓ m) continuous_of_discreteTopology =
      wcContSheafMap S (PadicInt.toZModPow (p := ℓ) m).toAddMonoidHom (hc m) := by
    intro S m
    rw [← (wc_contSheafMap_comp_sub S (PadicInt.toZModPow (p := ℓ) (m + 1)).toAddMonoidHom
      (PadicInt.toZModPow (p := ℓ) (m + 1)).toAddMonoidHom (hc (m + 1)) (hc (m + 1))
      (wcTowerCast ℓ m) continuous_of_discreteTopology).1]
    exact hcongr S _ _ (AddMonoidHom.ext fun a => RingHom.congr_fun
      (PadicInt.zmod_cast_comp_toZModPow (p := ℓ) m (m + 1) (Nat.le_succ m)) a) _ _

  let R : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (G' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (_ : L.obj G ⟶ G') (q : ℕ),
      Abelian.Ext (wcFreeSheaf Y U) G q →+
        Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) G' q :=
    fun G G' a q => ((Abelian.Ext.mk₀ (θ U).inv).precomp G'
      (zero_add q)).comp (((Abelian.Ext.mk₀ a).postcomp _ (add_zero q)).comp (L.mapExtAddHom _ _ q))
  have hR : ∀ G G' (a : L.obj G ⟶ G') (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G q),
      R G G' a q z = (Abelian.Ext.mk₀ (θ U).inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a) (add_zero q)) (zero_add q) := by
    intro G G' a q z
    first
      | rfl
      | (simp only [R, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2') (a1 : L.obj G1 ⟶ G1') (a2 : L.obj G2 ⟶ G2'),
      L.map κY ≫ a2 = a1 ≫ κX → ∀ (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G1 q),
      R G2 G2' a2 q (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (R G1 G1' a1 q z).comp (Abelian.Ext.mk₀ κX) (add_zero q) := by
    intro G1 G2 G1' G2' κY κX a1 a2 h q z
    have e1 : Abelian.Ext.mapExactFunctor L (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e2 : ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY))
        (add_zero q)).comp (Abelian.Ext.mk₀ a2) (add_zero q) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a1) (add_zero q)).comp
        (Abelian.Ext.mk₀ κX) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [hR, hR, e1, e2]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm
  have hAdj : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2')
      (p1 : G1 ⟶ (wcProEtPush i).obj G1')
      (p2 : G2 ⟶ (wcProEtPush i).obj G2'),
      κY ≫ p2 = p1 ≫ (wcProEtPush i).map κX →
      L.map κY ≫ (adj.homEquiv _ _).symm p2 = (adj.homEquiv _ _).symm p1 ≫ κX := by
    intro G1 G2 G1' G2' κY κX p1 p2 h
    rw [← adj.homEquiv_naturality_left_symm, h, adj.homEquiv_naturality_right_symm]
  let Ψ0 : Abelian.Ext (wcFreeSheaf Y U) (wcLadicSheaf Y ℓ) j →+
      Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcLadicSheaf Z ℓ) j :=
    R (wcLadicSheaf Y ℓ) (wcLadicSheaf Z ℓ) ((adj.homEquiv _ _).symm (wcContPull i ℚ_[ℓ])) j
  let ρI : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j →+
      Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcIntSheaf Z ℓ) j :=
    R (wcIntSheaf Y ℓ) (wcIntSheaf Z ℓ) ((adj.homEquiv _ _).symm (wcContPull i ℤ_[ℓ])) j
  have hNatQ : ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j,
      Ψ0 (y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero j)) =
        (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic Z ℓ)) (add_zero j) := by
    intro y
    exact hN (wcIntToLadic Y ℓ) (wcIntToLadic Z ℓ) _ _
      (hAdj (wcIntToLadic Y ℓ) (wcIntToLadic Z ℓ) (wcContPull i ℤ_[ℓ]) (wcContPull i ℚ_[ℓ])
        (wc_contPull_intToLadic i ℓ)) j y
  have hNatS : ∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf Y U) (wcLadicSheaf Y ℓ) j),
      Ψ0 (z.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ c)) (add_zero j)) =
        (Ψ0 z).comp (Abelian.Ext.mk₀ (wcLadicScalar Z ℓ c)) (add_zero j) := by
    intro c z
    exact hN (wcLadicScalar Y ℓ c) (wcLadicScalar Z ℓ c) _ _
      (hAdj (wcLadicScalar Y ℓ c) (wcLadicScalar Z ℓ c) (wcContPull i ℚ_[ℓ])
        (wcContPull i ℚ_[ℓ]) (wc_contPull_ladicScalar i ℓ c)) j z
  have hNatI : ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j),
      wcProEtRes i L adj θ (ZMod (ℓ ^ k)) U j (x.comp (Abelian.Ext.mk₀ (wcContSheafMap Y
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j)) =
        (ρI x).comp (Abelian.Ext.mk₀ (wcContSheafMap Z
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j) := by
    intro k x
    exact hN (G1 := wcIntSheaf Y ℓ) (G1' := wcIntSheaf Z ℓ) _ _ _ _
      (hAdj (G1 := wcIntSheaf Y ℓ) (G1' := wcIntSheaf Z ℓ) _ _ (wcContPull i ℤ_[ℓ])
        (wcContPull i (ZMod (ℓ ^ k))) (wc_contPull_contSheafMap i _ (hc k))) j x
  have hNatT : ∀ (m : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ (m + 1)))) j),
      wcProEtRes i L adj θ (ZMod (ℓ ^ m)) U j (z.comp (Abelian.Ext.mk₀
        (wcContSheafMap Y (wcTowerCast ℓ m) continuous_of_discreteTopology)) (add_zero j)) =
        (wcProEtRes i L adj θ (ZMod (ℓ ^ (m + 1))) U j z).comp (Abelian.Ext.mk₀
          (wcContSheafMap Z (wcTowerCast ℓ m) continuous_of_discreteTopology)) (add_zero j) := by
    intro m z
    exact hN _ _ _ _ (hAdj _ _ (wcContPull i (ZMod (ℓ ^ (m + 1))))
      (wcContPull i (ZMod (ℓ ^ m))) (wc_contPull_contSheafMap i _ continuous_of_discreteTopology))
      j z

  have Q1 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q N : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q),
      N • x = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (N : ℚ_[ℓ]))) (add_zero q) := by
    intro S P q N x
    obtain ⟨h1, -, hadd⟩ := wc_ladic_scalar_ring S ℓ
    induction N with
    | zero =>
      have h0 : wcLadicScalar S ℓ 0 = 0 := by
        have h := hadd 0 0
        rw [add_zero] at h
        exact add_left_cancel (h.symm.trans (add_zero _).symm)
      rw [zero_nsmul, Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]
  have hinv : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q) (c : ℚ_[ℓ]), c ≠ 0 →
      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero q)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c⁻¹)) (add_zero q) = x := by
    intro S P q x c hc0
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring S ℓ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hmul,
      inv_mul_cancel₀ hc0, h1, Abelian.Ext.comp_mk₀_id]

  obtain ⟨hcont_incl, hemb_incl, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact Y (wcTowerIncl ℓ) hcont_incl
    (wcTowerShift ℓ) hcont_shift hemb_incl hker hsec
  haveI := wc_proet_products_exact Y
  have hYl := (wc_contSheaf_pi_isLimit Y (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf Y U)
    (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hYl N
  have hTn : ∀ n, wcContSheafMap Y (wcTowerShift ℓ) hcont_shift ≫
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap Y (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub Y (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
      hcont_shift (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub Y
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub Y
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr Y _ _ (AddMonoidHom.ext fun a => rfl) _ _
  have e1 : ∀ m, wcContSheafMap Y (wcTowerIncl ℓ) hcont_incl ≫
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) m) (continuous_apply m) =
      wcContSheafMap Y (PadicInt.toZModPow (p := ℓ) m).toAddMonoidHom (hc m) := by
    intro m
    rw [← (wc_contSheafMap_comp_sub Y (wcTowerIncl ℓ) (wcTowerIncl ℓ) hcont_incl hcont_incl
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) m) (continuous_apply m)).1]
    exact hcongr Y _ _ (AddMonoidHom.ext fun a => rfl) _ _
  have hsubmk : ∀ {A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
      Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A B a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A B C : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} {p : ℕ}
      (α : Abelian.Ext A B p) (β₁ β₂ : Abelian.Ext B C 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A B C p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]

  intro x'
  obtain ⟨a, y', hy'⟩ := (proet_qcqs_ladic_rationalization Z ((wcProEtPullback i).obj U) ℓ j).1 x'
  have hsurj : ∀ m : ℕ, ∃ t : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ m))) j,
      wcProEtRes i L adj θ (ZMod (ℓ ^ m)) U j t =
        y'.comp (Abelian.Ext.mk₀ (wcContSheafMap Z
          (PadicInt.toZModPow (p := ℓ) m).toAddMonoidHom (hc m))) (add_zero j) :=
    fun m => (htor j m).2 _
  choose ym hym using hsurj
  have htow : ∀ m, (ym (m + 1)).comp (Abelian.Ext.mk₀
      (wcContSheafMap Y (wcTowerCast ℓ m) continuous_of_discreteTopology)) (add_zero j) = ym m := by
    intro m
    apply (htor j m).1
    rw [hNatT m (ym (m + 1)), hym, hym]
    refine (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).trans ?_
    exact congrArg (fun t : Abelian.Ext (wcIntSheaf Z ℓ) (wcContSheaf Z (ZMod (ℓ ^ m))) 0 =>
      y'.comp t (add_zero j)) ((Abelian.Ext.mk₀_comp_mk₀ _ _).trans (congrArg Abelian.Ext.mk₀ (g1 Z m)))
  obtain ⟨x₀, hx₀⟩ := (hprod j).2 ym
  have hx₀s : x₀.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerShift ℓ) hcont_shift))
      (add_zero j) = 0 := by
    apply (hprod j).1
    intro n
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hTn n, hsubmk, hcompsub, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega), hx₀, hx₀, htow n,
      sub_self]
  obtain ⟨y, hy⟩ : ∃ y : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j,
      y.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerIncl ℓ) hcont_incl)) (add_zero j) = x₀ :=
    Abelian.Ext.covariant_sequence_exact₂ _ hS2 x₀ hx₀s
  have hyred : ∀ m, y.comp (Abelian.Ext.mk₀ (wcContSheafMap Y
      (PadicInt.toZModPow (p := ℓ) m).toAddMonoidHom (hc m))) (add_zero j) = ym m := by
    intro m
    have h1 : (y.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerIncl ℓ) hcont_incl))
        (add_zero j)).comp (Abelian.Ext.mk₀ (wcContSheafMap Y
          (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) m) (continuous_apply m))) (add_zero j) =
        ym m := by
      rw [hy]
      exact hx₀ m
    have h2 : (y.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerIncl ℓ) hcont_incl))
        (add_zero j)).comp (Abelian.Ext.mk₀ (wcContSheafMap Y
          (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) m) (continuous_apply m))) (add_zero j) =
        y.comp (Abelian.Ext.mk₀ (wcContSheafMap Y
          (PadicInt.toZModPow (p := ℓ) m).toAddMonoidHom (hc m))) (add_zero j) := by
      refine (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).trans ?_
      exact congrArg (fun t : Abelian.Ext (wcIntSheaf Y ℓ) (wcContSheaf Y (ZMod (ℓ ^ m))) 0 =>
        y.comp t (add_zero j)) ((Abelian.Ext.mk₀_comp_mk₀ _ _).trans (congrArg Abelian.Ext.mk₀ (e1 m)))
    exact h2.symm.trans h1
  have hd : ρI y = y' := by
    rw [← sub_eq_zero]
    refine wc_proet_int_separated_of_finite Z ((wcProEtPullback i).obj U) ℓ hc hfin' j
      (ρI y - y') (fun k => ?_)
    have e : wcProEtRes i L adj θ (ZMod (ℓ ^ k)) U j (y.comp (Abelian.Ext.mk₀ (wcContSheafMap Y
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j)) =
        (ρI y).comp (Abelian.Ext.mk₀ (wcContSheafMap Z
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j) := hNatI k y
    rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg, ← e,
      hyred k, hym k, sub_self]
  have hN0 : ((ℓ ^ a : ℕ) : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓ0)
  refine ⟨(y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero j)).comp
    (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ ((ℓ ^ a : ℕ) : ℚ_[ℓ])⁻¹)) (add_zero j), ?_⟩
  show Ψ0 _ = _
  rw [hNatS, hNatQ, hd, ← hy', Q1 Z _ j (ℓ ^ a) x']
  exact hinv Z _ j x' _ hN0

theorem wc_pencil_strict_nbhd_sections_pbc (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (k : ℕ) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom D.u0) :
    ∃ Ψ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0 →+
        wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ k,
      Function.Bijective Ψ ∧
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0),
        Ψ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 0)) =
          wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ k c (Ψ y)) ∧
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0,
        Ψ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp y (zero_add 0)) =
          wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ k (Ψ y) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    simp only [wcFreeSheafMap, Functor.map_comp, Functor.whiskerRight_comp] <;> rfl
  have Fid : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    simp only [wcFreeSheafMap, CategoryTheory.Functor.map_id, Functor.whiskerRight_id'] <;> rfl

  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local (wcP1Over F'').left V₀ A e
  obtain ⟨L, adj, _, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat D.f
  obtain ⟨Λ, hΛσ, hΛτ⟩ := ext_rightDerived_adj_projective L (wcProEtPush D.f) adj
    (wcFreeSheaf (wcP1Over F'').left V₀) (wcLadicSheaf D.Yt.left ℓ) k

  obtain ⟨L', adj', hL'lim, θ', hθ'⟩ :=
    wc_proet_push_left_adjoint_free_nat (Limits.pullback.fst D.f D.u0)
  haveI := hL'lim
  haveI : L'.IsLeftAdjoint := ⟨_, ⟨adj'⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L' := adj'.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L' :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L'
  haveI : L'.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L'
  haveI : L'.Additive := Functor.additive_of_preserves_binary_products L'

  obtain ⟨β, hβ⟩ := wc_pencil_closed_fibre_geom_iso F' F'' Y n D hX V₀ φ₀ ε hε hεφ
  obtain ⟨hW1, hW2, hW3, hW4⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V₀ A e

  have htor : ∀ j k' : ℕ, Function.Bijective (wcProEtRes (Limits.pullback.fst D.f D.u0) L' adj' θ'
      (ZMod (ℓ ^ k')) ((wcProEtPullback D.f).obj V₀) j) := by
    intro j k'
    obtain ⟨hfinT, hcard⟩ := wc_pencil_nbhd_zmod_card_le F' F'' Y n D ℓ hℓ V₀ A e ε hv hε j k'
    exact @Function.Injective.bijective_of_nat_card_le _ _ hfinT _
      (wc_pencil_nbhd_torsion_restriction_injective F' F'' Y n D ℓ hℓ V₀ A e ε hv hε
        L' adj' θ' j k') hcard

  obtain ⟨R, hR⟩ : ∃ R : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) k →+
      Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
        (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) k,
      R = wcProEtRes (Limits.pullback.fst D.f D.u0) L' adj' θ' ℚ_[ℓ]
      ((wcProEtPullback D.f).obj V₀) k := ⟨_, rfl⟩
  have hRbij : Function.Bijective R := by
    rw [hR]
    refine ⟨?_, ?_⟩
    · exact wc_res_ladic_injective_of_torsion (Limits.pullback.fst D.f D.u0) L' adj' θ' ℓ
        ((wcProEtPullback D.f).obj V₀)
        (fun j k' => wc_pencil_nbhd_zmod_finite F' F'' Y n hn2 D ℓ hℓ hX V₀ A e ε hv hε j k')
        (fun j k' => (htor j k').1) k
    · exact wc_res_ladic_surjective_of_torsion (Limits.pullback.fst D.f D.u0) L' adj' θ' ℓ
        ((wcProEtPullback D.f).obj V₀)
        (fun j k' => (wc_pencil_nbhd_zmod_card_le F' F'' Y n D ℓ hℓ V₀ A e ε hv hε j k').1)
        htor k
  obtain ⟨π, hπ⟩ : ∃ π : L'.obj (wcLadicSheaf D.Yt.left ℓ) ⟶
      wcLadicSheaf (Limits.pullback D.f D.u0) ℓ, π = (adj'.homEquiv (wcContSheaf D.Yt.left ℚ_[ℓ])
      (wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])).symm
        (wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ]) := ⟨_, rfl⟩
  have hRz : ∀ z, R z = (Abelian.Ext.mk₀ (θ' ((wcProEtPullback D.f).obj V₀)).inv).comp
      ((Abelian.Ext.mapExactFunctor L' z).comp (Abelian.Ext.mk₀ π) (add_zero k)) (zero_add k) := by
    intro z
    rw [hR, hπ]
    rfl

  have hRs : ∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) k),
      R (z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero k)) =
        (R z).comp (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f D.u0) ℓ c)) (add_zero k) := by
    intro c z
    have hkey : L'.map (wcLadicScalar D.Yt.left ℓ c) ≫ π =
        π ≫ wcLadicScalar (Limits.pullback D.f D.u0) ℓ c := by
      have e1 := adj'.homEquiv_naturality_left_symm (X' := wcContSheaf D.Yt.left ℚ_[ℓ])
        (X := wcContSheaf D.Yt.left ℚ_[ℓ]) (Y := wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])
        (wcLadicScalar D.Yt.left ℓ c) (wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ])
      have e2 := adj'.homEquiv_naturality_right_symm (X := wcContSheaf D.Yt.left ℚ_[ℓ])
        (Y := wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])
        (Y' := wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])
        (wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ])
        (wcLadicScalar (Limits.pullback D.f D.u0) ℓ c)
      have e3 := wc_contPull_ladicScalar (Limits.pullback.fst D.f D.u0) ℓ c
      rw [hπ]
      exact e1.symm.trans ((congrArg _ e3).trans e2)
    rw [hRz, hRz, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hkey]

  have hθφ' : (θ' ((wcProEtPullback D.f).obj V₀)).inv ≫
      L'.map (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀)) =
      wcFreeSheafMap (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map ((wcProEtPullback D.f).map φ₀)) ≫
        (θ' ((wcProEtPullback D.f).obj V₀)).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ' ((wcProEtPullback D.f).map φ₀), Category.assoc,
      Iso.hom_inv_id, Category.comp_id]
  have hRF : ∀ z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) k,
      R ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp z
          (zero_add k)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0)
          ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map
            ((wcProEtPullback D.f).map φ₀)))).comp (R z) (zero_add k) := by
    intro z
    rw [hRz, hRz, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hθφ']

  have hβinv : β.inv ≫ (wcProEtPullback (Limits.pullback.fst D.f D.u0)).map
      ((wcProEtPullback D.f).map φ₀) =
      wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ≫ β.inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← hβ, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  have hβF : wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv ≫
      wcFreeSheafMap (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map ((wcProEtPullback D.f).map φ₀)) =
      wcFreeSheafMap (Limits.pullback D.f D.u0)
        (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ≫
        wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv := by
    rw [← F0, ← F0, hβinv]
  have hθφ : (θ V₀).inv ≫ L.map (wcFreeSheafMap (wcP1Over F'').left φ₀) =
      wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀) ≫ (θ V₀).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ φ₀, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]

  let Ψ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0 →+
      wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ k :=
    ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).precomp
      (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) (zero_add k)).comp
      (R.comp (((Abelian.Ext.mk₀ (θ V₀).inv).precomp (wcLadicSheaf D.Yt.left ℓ)
        (zero_add k)).comp Λ.toAddMonoidHom))
  have hΨ : ∀ y, Ψ y = (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp
      (R ((Abelian.Ext.mk₀ (θ V₀).inv).comp (Λ y) (zero_add k))) (zero_add k) := fun y => rfl
  refine ⟨Ψ, ?_, ?_, ?_⟩
  ·
    have b1 : Function.Bijective (fun t : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V₀))
        (wcLadicSheaf D.Yt.left ℓ) k => (Abelian.Ext.mk₀ (θ V₀).inv).comp t (zero_add k)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun t => (Abelian.Ext.mk₀ (θ V₀).hom).comp t (zero_add k), ?_, ?_⟩
      · intro t
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      · intro t
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    have b2 : Function.Bijective (fun t : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
        (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) k =>
        (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp t
          (zero_add k)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun t => (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.hom)).comp t
