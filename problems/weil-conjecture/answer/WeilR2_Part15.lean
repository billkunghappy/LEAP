  have hs2 : ∀ {Z' Z : Scheme.{u}} (g : Z' ⟶ Z) {ι : Type} [Fintype ι] (k₀ : ι) (V : ι → Z.Opens), (⨆ k, V k) = ⊤ → (∀ (k : ι) (W : Z.Opens), W ≤ V k → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W) ℓ), Function.Bijective (wcEtPull D j)) → ∀ (j : ℕ) (D : wcEtPullData g ℓ), Function.Bijective (wcEtPull D j) := by
