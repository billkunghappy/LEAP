      · intro y hy _
        exact @wc_et_smooth_proper_fibre_card_const (AlgebraicClosure F'') _ _
          (wcGeomPoint F'' (wcP1Over F'') hP).left _
          (Limits.pullback.snd (wcP1Over F'').hom
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hPr _
          (Limits.pullback.snd D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom) hfbar hdim.le W hWsm
          (ℓ ^ k) hm q y hy
    · refine ⟨Set.univ, isOpen_univ, Set.mem_univ _, fun y _ hy => ?_⟩
      rw [hsp η y hη hy]
  have hnoeth := @wc_et_proper_push_noetherian_of_generic_card (AlgebraicClosure F'') _ _ _
    (wcGeomPoint F'' (wcP1Over F'') hP).left
    (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hPr
    (Limits.pullback.snd D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom) hfbar (ℓ ^ k) hm q hgen I

  have htor := wc_et_push_homology_const_torsion
    (Limits.pullback.snd D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom) (ℓ ^ k) I q
  have hfinEt := @wc_et_noetherian_torsion_coh_finite (AlgebraicClosure F'') _ _
    (wcGeomPoint F'' (wcP1Over F'') hP).left
    (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hPr
    ℓ (Fact.out : ℓ.Prime) hℓK k _ hnoeth htor 2
  obtain ⟨E3⟩ := @wc_proet_etale_comparison_epsInv (AlgebraicClosure F'') _
