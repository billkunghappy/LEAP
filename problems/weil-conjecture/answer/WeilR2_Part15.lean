    have e2 := hT (wcEtTop Y) (wcEtTop Z) g ((Category.comp_id _).trans (Category.id_comp _).symm) x
    have H1 : T.ρ (wcEtTop Y) N' (N'.hom ≫ g) hh' x = 0 :=
      calc T.ρ (wcEtTop Y) N' (N'.hom ≫ g) hh' x
          = T.ρ (wcEtTop Y) N' (N'.hom ≫ g) hh' (F'.obj.map (𝟙 (wcEtTop Y)).op x) :=
            (congrArg (fun y => T.ρ (wcEtTop Y) N' (N'.hom ≫ g) hh' y) e1).symm
        _ = ConcreteCategory.hom (((wcEtInv g).obj F').obj.map d.op)
