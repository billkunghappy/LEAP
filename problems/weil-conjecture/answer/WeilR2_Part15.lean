      (Scheme.smallEtaleTopology T.left) := @wc_et_basechange_isContinuous T.left O T.hom
  haveI hb2 := wc_et_basechange_isContinuous O.ι
  haveI hmono : Mono T.hom := (inferInstance : Mono (Z.homOfLE hWO))
  let R := (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology (O : Scheme.{u}))

  obtain ⟨h⟩ := wc_et_slice_injres_homotopy_equiv T m I J

  obtain ⟨η, hη⟩ := @wc_et_open_slice_unit_iso_of_factor (O : Scheme.{u}) T hmono hc1 hb1
  let ηI : I.cocomplex ⟶ ((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) :=
    { f := fun n => η.app (I.cocomplex.X n)
      comm' := fun i j _ => (η.naturality (I.cocomplex.d i j)).symm }

  let ψ₀ : I.cocomplex ⟶ ((wcEtPush (Z.homOfLE hWO)).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      J.cocomplex := ηI ≫ ((wcEtPush T.hom).mapHomologicalComplex (ComplexShape.up ℕ)).map h.hom
  obtain ⟨e₁⟩ := (wc_et_push_id_comp_iso (Z.homOfLE hWO) O.ι).2
  obtain ⟨e₂⟩ := (wc_et_push_id_comp_iso (Z.homOfLE hWU) U.ι).2
  have hc : Z.homOfLE hWO ≫ O.ι = Z.homOfLE hWU ≫ U.ι := by
    rw [Scheme.homOfLE_ι, Scheme.homOfLE_ι]
  let ε : wcEtPush (Z.homOfLE hWO) ⋙ wcEtPush O.ι ≅ wcEtPush (Z.homOfLE hWU) ⋙ wcEtPush U.ι :=
    e₁ ≪≫ eqToIso (congrArg wcEtPush hc) ≪≫ e₂.symm
  let κ := (NatIso.mapHomologicalComplex ε (ComplexShape.up ℕ)).app J.cocomplex
  refine ⟨((wcEtPush O.ι).mapHomologicalComplex (ComplexShape.up ℕ)).map ψ₀ ≫ κ.hom, ?_⟩
  rintro y ⟨N, hyN, hN⟩ p
  obtain ⟨hex1, hex2⟩ := wc_et_stalk_exact Z y

  have s5 : ∀ (K₁ K₂ : CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ)
      (θ : K₁ ⟶ K₂), IsIso (HomologicalComplex.homologyMap
        (((wcEtStalk Z y).mapHomologicalComplex (ComplexShape.up ℕ)).map θ) p) →
      IsIso ((wcEtStalk Z y).map (HomologicalComplex.homologyMap θ p)) := by
    intro K₁ K₂ θ hθ
    have e := ShortComplex.mapHomologyIso_hom_naturality
