      show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Limits.pullback g (wcEtGeomPt B b))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
          (Scheme.smallEtaleTopology (Limits.pullback g (wcEtGeomPt B b))) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q)
      exact ⟨fun a b => (h a).trans (h b).symm⟩
    exact eb.subsingleton
  have hH := wc_et_stalks_zero _ hstalk
  obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont B
  haveI := hlim
  haveI := hcont
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt B)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.ProEt.topology B)
