  obtain ⟨⟨adj⟩, hlim, -⟩ := wc_qm_inv_adjunction g
  haveI := hlim
  haveI : Limits.PreservesColimitsOfSize.{0, 0} (wcQmInv g) := adj.leftAdjoint_preservesColimits
