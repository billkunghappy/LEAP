        Abelian.Ext.comp_mk₀_id]
  obtain ⟨N, y', hy⟩ := ext_seq_colimit_lift_of_acyclic
    (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) H0 H1lift 2
    _ (Limits.Cocone.mk _ κ) hκ y
  refine ⟨N, y'.comp (Abelian.Ext.mk₀
    (Subobject.pullbackπ ((ℓ ^ N : ℕ) • 𝟙 (Subobject.underlying.obj M)) J)) (add_zero 2), ?_⟩
  have hw := (Subobject.isPullback ((ℓ ^ N : ℕ) • 𝟙 (Subobject.underlying.obj M)) J).w
  rw [← s7 y (ℓ ^ N), hy, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hw]

theorem wc_qclift_integral_frame (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : S.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : S.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : S.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∃ ψ : (Subobject.underlying.obj J).over W ≅ (wcContSheaf S (Fin k → ℤ_[ℓ])).over W,
      ∀ (V : S.ProEt) (b : V ⟶ W) (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V))
        (z : V.left) (i : Fin k),
        (((show C(↥V.left, Fin k → ℤ_[ℓ]) from
          ((ψ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z i : ℤ_[ℓ]) : ℚ_[ℓ]) =
        P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            ((J.arrow.hom.app (Opposite.op V)).hom t)).down) z) i :=
by
  have hPc : Continuous ⇑P :=
    LinearMap.continuous_of_finiteDimensional (P : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
  have hPsc : Continuous ⇑P.symm :=
    LinearMap.continuous_of_finiteDimensional
      (P.symm : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))

  have hbound : ∀ (V : S.ProEt) (b : V ⟶ W)
      (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)) (z : V.left) (i : Fin k),
      ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((J.arrow.hom.app (Opposite.op V)).hom t)).down) z) i‖ ≤ 1 := by
    intro V b t z i
    have h := (hJ V ((J.arrow.hom.app (Opposite.op V)).hom t)).mp ⟨t, rfl⟩ V (𝟙 V) b z i
    have e : (G.obj.map (𝟙 V).op).hom ((J.arrow.hom.app (Opposite.op V)).hom t) =
        (J.arrow.hom.app (Opposite.op V)).hom t := by
      rw [op_id, G.obj.map_id]
      rfl
    rw [e] at h
    exact h

  have hex : ∀ (V : S.ProEt) (b : V ⟶ W)
      (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
      ∃ F : C(↥V.left, Fin k → ℤ_[ℓ]), ∀ (z : V.left) (i : Fin k),
        ((F z i : ℤ_[ℓ]) : ℚ_[ℓ]) = P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            ((J.arrow.hom.app (Opposite.op V)).hom t)).down) z) i := by
    intro V b t
    refine ⟨⟨fun z i => ⟨P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            ((J.arrow.hom.app (Opposite.op V)).hom t)).down) z) i, hbound V b t z i⟩, ?_⟩,
      fun _ _ => rfl⟩
    exact continuous_pi fun i => Continuous.subtype_mk (((continuous_apply i).comp hPc).comp
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            ((J.arrow.hom.app (Opposite.op V)).hom t)).down).continuous) (fun z => hbound V b t z i)
  choose Fn hcoe using hex

  have hadd : ∀ (V : S.ProEt) (b : V ⟶ W)
      (t t' : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
      (ULift.up (Fn V b (t + t')) : ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk b))) =
        (ULift.up (Fn V b t) : ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk b))) +
        (ULift.up (Fn V b t') : ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk b))) := by
    intro V b t t'
    apply ULift.ext
    refine ContinuousMap.ext fun (z : V.left) => ?_
    funext i
    apply PadicInt.ext
    show ((Fn V b (t + t') z i : ℤ_[ℓ]) : ℚ_[ℓ]) =
      ((Fn V b t z i + Fn V b t' z i : ℤ_[ℓ]) : ℚ_[ℓ])
    rw [PadicInt.coe_add, hcoe, hcoe, hcoe]
    have hsum : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
        ((J.arrow.hom.app (Opposite.op V)).hom (t + t')) =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((J.arrow.hom.app (Opposite.op V)).hom t) +
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((J.arrow.hom.app (Opposite.op V)).hom t') := by
      rw [map_add (J.arrow.hom.app (Opposite.op V)).hom]
      exact map_add _ _ _
    have h1 := congrArg (fun w : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op (Over.mk b)) => P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from w.down) z) i) hsum
    refine h1.trans ?_
    show P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((J.arrow.hom.app (Opposite.op V)).hom t)).down) z +
        (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((J.arrow.hom.app (Opposite.op V)).hom t')).down) z) i = _
    rw [map_add, Pi.add_apply]

  let α : ((Subobject.underlying.obj J).over W).obj ⟶
      ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk'
        (fun t => (ULift.up (Fn U.unop.left U.unop.hom t) :
          ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk U.unop.hom))))
        (hadd U.unop.left U.unop.hom))
      naturality := by
        intro U U' f
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro t
        apply ULift.ext
        refine ContinuousMap.ext fun (z : U'.unop.left.left) => ?_
        funext i
        apply PadicInt.ext
        show ((Fn U'.unop.left U'.unop.hom
            (((Subobject.underlying.obj J).obj.map f.unop.left.op).hom t) z i : ℤ_[ℓ]) : ℚ_[ℓ]) =
          ((Fn U.unop.left U.unop.hom t (f.unop.left.left z) i : ℤ_[ℓ]) : ℚ_[ℓ])
        rw [hcoe U'.unop.left U'.unop.hom _ z i, hcoe U.unop.left U.unop.hom t _ i]
        have h1 : (J.arrow.hom.app (Opposite.op U'.unop.left)).hom
            (((Subobject.underlying.obj J).obj.map f.unop.left.op).hom t) =
            (G.obj.map f.unop.left.op).hom ((J.arrow.hom.app (Opposite.op U.unop.left)).hom t) :=
          congrArg (fun φ => φ.hom t) (J.arrow.hom.naturality f.unop.left.op)
        have h2 : ∀ x : G.obj.obj (Opposite.op U.unop.left),
            (θ.hom.hom.app (Opposite.op (Over.mk U'.unop.hom))).hom
              ((G.obj.map f.unop.left.op).hom x) =
            (((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.map f).hom
              ((θ.hom.hom.app (Opposite.op (Over.mk U.unop.hom))).hom x) := fun x =>
          congrArg (fun φ => φ.hom x) (θ.hom.hom.naturality f)
        rw [h1, h2]
        rfl }
  let φ : (Subobject.underlying.obj J).over W ⟶ (wcContSheaf S (Fin k → ℤ_[ℓ])).over W :=
    ObjectProperty.homMk α

  have hθinv : ∀ (V : S.ProEt) (b : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x) = x :=
    fun V b x => congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom x) θ.hom_inv_id
  have hθhominv : ∀ (V : S.ProEt) (b : V ⟶ W)
      (y : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk b))),
      (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk b))).hom y) = y :=
    fun V b y => congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom y) θ.inv_hom_id
  have hιinj : ∀ V : S.ProEt, Function.Injective (J.arrow.hom.app (Opposite.op V)).hom := by
    intro V
    haveI h1 : Mono J.arrow.hom :=
      Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) J.arrow
    haveI h2 : Mono (J.arrow.hom.app (Opposite.op V)) := (NatTrans.mono_iff_mono_app _).mp h1 _
    exact (AddCommGrpCat.mono_iff_injective _).mp h2

  have hinj : ∀ (V : S.ProEt) (b : V ⟶ W), Function.Injective
      (fun t : (Subobject.underlying.obj J).obj.obj (Opposite.op V) =>
        (ULift.up (Fn V b t) : ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk b)))) := by
    intro V b t t' htt
    have hF : Fn V b t = Fn V b t' := congrArg ULift.down htt
    have hpt : ∀ z : V.left, (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((J.arrow.hom.app (Opposite.op V)).hom t)).down) z =
        (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((J.arrow.hom.app (Opposite.op V)).hom t')).down) z := by
      intro z
      apply P.injective
      funext i
      rw [← hcoe V b t z i, ← hcoe V b t' z i, hF]
    have hθeq : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
        ((J.arrow.hom.app (Opposite.op V)).hom t) =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
        ((J.arrow.hom.app (Opposite.op V)).hom t') := by
      apply ULift.ext
      apply ContinuousMap.ext
      exact hpt
    have hιeq := congrArg (θ.inv.hom.app (Opposite.op (Over.mk b))).hom hθeq
    rw [hθinv, hθinv] at hιeq
    exact hιinj V hιeq

  have hsurj : ∀ (V : S.ProEt) (b : V ⟶ W)
      (s : ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk b))),
      ∃ t : (Subobject.underlying.obj J).obj.obj (Opposite.op V),
        (ULift.up (Fn V b t) : ((wcContSheaf S (Fin k → ℤ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk b))) = s := by
    intro V b s
    let f : C(↥V.left, Fin k → ℤ_[ℓ]) := s.down
    let g : C(↥V.left, Fin k → ℚ_[ℓ]) :=
      ⟨fun z => P.symm (fun j => ((f z j : ℤ_[ℓ]) : ℚ_[ℓ])),
        hPsc.comp (continuous_pi fun j =>
          continuous_subtype_val.comp ((continuous_apply j).comp f.continuous))⟩
    let y : G.obj.obj (Opposite.op V) :=
      (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
        (ULift.up g : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk b)))
    have hy : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom y =
        (ULift.up g : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk b))) := hθhominv V b _
    have hyJ : ∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = y := by
      refine (hJ V y).mpr ?_
      intro V' c b' z i
      refine hint V' (c ≫ b) b' ((G.obj.map c.op).hom y) z (fun i' => ?_) i
      have hnat : (θ.hom.hom.app (Opposite.op (Over.mk (c ≫ b)))).hom ((G.obj.map c.op).hom y) =
          (((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.map
            (Over.homMk c : Over.mk (c ≫ b) ⟶ Over.mk b).op).hom
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y) :=
        congrArg (fun φ => φ.hom y)
          (θ.hom.hom.naturality (Over.homMk c : Over.mk (c ≫ b) ⟶ Over.mk b).op)
      have e : (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (c ≫ b)))).hom ((G.obj.map c.op).hom y)).down) z =
          P.symm (fun j => ((f (c.left z) j : ℤ_[ℓ]) : ℚ_[ℓ])) := by
        rw [hnat, hy]
        rfl
      rw [e, LinearEquiv.apply_symm_apply]
      exact PadicInt.norm_le_one _
    obtain ⟨t, ht⟩ := hyJ
    refine ⟨t, ?_⟩
    apply ULift.ext
    refine ContinuousMap.ext fun (z : V.left) => ?_
    funext i
    apply PadicInt.ext
    show ((Fn V b t z i : ℤ_[ℓ]) : ℚ_[ℓ]) = ((f z i : ℤ_[ℓ]) : ℚ_[ℓ])
    rw [hcoe V b t z i, ht, hy]
    exact congrFun (P.apply_symm_apply (fun j => ((f z j : ℤ_[ℓ]) : ℚ_[ℓ]))) i

  haveI hiso : ∀ U : (Over W)ᵒᵖ, IsIso (α.app U) := fun U =>
    (ConcreteCategory.isIso_iff_bijective (α.app U)).mpr
      ⟨hinj U.unop.left U.unop.hom, hsurj U.unop.left U.unop.hom⟩
  haveI hαiso : IsIso α := NatIso.isIso_of_isIso_app α
  haveI : IsIso ((sheafToPresheaf ((Scheme.ProEt.topology S).over W) AddCommGrpCat.{u+1}).map φ) :=
    hαiso
  haveI : IsIso φ :=
    isIso_of_reflects_iso φ (sheafToPresheaf ((Scheme.ProEt.topology S).over W) AddCommGrpCat.{u+1})
  refine ⟨asIso φ, ?_⟩
  intro V b t z i
  exact hcoe V b t z i

theorem wc_tower_defect_isZero_of_exact_functor : ∀ {C D : Type*} [Category C] [Abelian C] [Category D] [Abelian D] (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] [Limits.PreservesLimitsOfShape (Discrete ℕ) F] (ℓ : ℕ) (G Yt : C) (pr : ∀ r : ℕ, Yt ⟶ Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 G)) (hY : Limits.IsLimit (Limits.Fan.mk Yt pr)) (c : ∀ r : ℕ, Limits.cokernel ((ℓ ^ (r + 1) : ℕ) • 𝟙 G) ⟶ Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 G)) (hc : ∀ r, Limits.cokernel.π ((ℓ ^ (r + 1) : ℕ) • 𝟙 G) ≫ c r = Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 G)) (T : Yt ⟶ Yt) (hT : ∀ r, T ≫ pr r = pr r - pr (r + 1) ≫ c r) (ι : G ⟶ Yt) (hιpr : ∀ r, ι ≫ pr r = Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 G)) (hι : ι ≫ T = 0) (A Ym : C) (Bm : ℕ → C) (red : ∀ r, A ⟶ Bm r) (hred : ∀ r, ∃ h : ((ℓ ^ r : ℕ) • 𝟙 A) ≫ red r = 0, (ShortComplex.mk _ _ h).ShortExact) (cst : ∀ r, Bm (r + 1) ⟶ Bm r) (hcst : ∀ r, red (r + 1) ≫ cst r = red r) (prm : ∀ r, Ym ⟶ Bm r) (hYm : Limits.IsLimit (Limits.Fan.mk Ym prm)) (incl : A ⟶ Ym) (hincl : ∀ r, incl ≫ prm r = red r) (shift : Ym ⟶ Ym) (hshift : ∀ r, shift ≫ prm r = prm r - prm (r + 1) ≫ cst r) (hses : ∃ h : incl ≫ shift = 0, (ShortComplex.mk incl shift h).ShortExact) (ψ : F.obj G ≅ F.obj A), Limits.IsZero (F.obj (Limits.kernel (Limits.kernel.lift T ι hι))) ∧ Limits.IsZero (F.obj (Limits.cokernel (Limits.kernel.lift T ι hι))) :=
by
  intro C D _ _ _ _ F _ _ _ _ ℓ G Yt pr hY c hc T hT ι hιpr hι A Ym Bm red hred cst hcst prm hYm
    incl hincl shift hshift hses ψ

  have s1 : ∀ (n : ℕ) (B : C) (rd : A ⟶ B),
      (∃ h : (n • 𝟙 A) ≫ rd = 0, (ShortComplex.mk _ _ h).ShortExact) →
      ∃ β : F.obj (Limits.cokernel (n • 𝟙 G)) ≅ F.obj B,
        F.map (Limits.cokernel.π (n • 𝟙 G)) ≫ β.hom = ψ.hom ≫ F.map rd := by
    intro n B rd hrd
    obtain ⟨h, hS⟩ := hrd
    have hA := hS.map_of_exact F
    have hGex : (ShortComplex.mk _ _ (Limits.cokernel.condition (n • 𝟙 G))).Exact :=
      ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel _)
    have hGF := hGex.map F
    haveI : Epi ((ShortComplex.mk _ _ (Limits.cokernel.condition (n • 𝟙 G))).map F).g := by
      dsimp; infer_instance
    haveI : Epi ((ShortComplex.mk _ _ h).map F).g := hA.epi_g
    haveI : Epi (F.map rd) := hA.epi_g
    have e1 : F.map (n • 𝟙 G) ≫ ψ.hom ≫ F.map rd = 0 := by
      have h0 : F.map ((n • 𝟙 A) ≫ rd) = 0 := by rw [h, F.map_zero]
      rw [F.map_comp, F.map_nsmul, F.map_id, Preadditive.nsmul_comp, Category.id_comp] at h0
      rw [F.map_nsmul, F.map_id, Preadditive.nsmul_comp, Category.id_comp,
        ← Preadditive.comp_nsmul, h0, Limits.comp_zero]
    have e2 : F.map (n • 𝟙 A) ≫ ψ.inv ≫ F.map (Limits.cokernel.π (n • 𝟙 G)) = 0 := by
      have h0 : F.map ((n • 𝟙 G) ≫ Limits.cokernel.π (n • 𝟙 G)) = 0 := by
        rw [Limits.cokernel.condition, F.map_zero]
      rw [F.map_comp, F.map_nsmul, F.map_id, Preadditive.nsmul_comp, Category.id_comp] at h0
      rw [F.map_nsmul, F.map_id, Preadditive.nsmul_comp, Category.id_comp,
        ← Preadditive.comp_nsmul, h0, Limits.comp_zero]
    let bh : F.obj (Limits.cokernel (n • 𝟙 G)) ⟶ F.obj B := hGF.desc (ψ.hom ≫ F.map rd) e1
    let bi : F.obj B ⟶ F.obj (Limits.cokernel (n • 𝟙 G)) :=
      hA.exact.desc (ψ.inv ≫ F.map (Limits.cokernel.π (n • 𝟙 G))) e2
    have hbh : F.map (Limits.cokernel.π (n • 𝟙 G)) ≫ bh = ψ.hom ≫ F.map rd := hGF.g_desc _ _
    have hbi : F.map rd ≫ bi = ψ.inv ≫ F.map (Limits.cokernel.π (n • 𝟙 G)) :=
      hA.exact.g_desc _ _
    refine ⟨⟨bh, bi, ?_, ?_⟩, hbh⟩
    · rw [← cancel_epi (F.map (Limits.cokernel.π (n • 𝟙 G))), reassoc_of% hbh, hbi,
        ψ.hom_inv_id_assoc, Category.comp_id]
    · rw [← cancel_epi (F.map rd), reassoc_of% hbi, hbh, ψ.inv_hom_id_assoc, Category.comp_id]
  choose β hβ using fun r => s1 (ℓ ^ r) (Bm r) (red r) (hred r)

  have hg2 : ∀ r, F.map (c r) ≫ (β r).hom = (β (r + 1)).hom ≫ F.map (cst r) := by
    intro r
    rw [← cancel_epi (F.map (Limits.cokernel.π ((ℓ ^ (r + 1) : ℕ) • 𝟙 G))), ← F.map_comp_assoc,
      hc, hβ, reassoc_of% (hβ (r + 1)), ← F.map_comp, hcst]

  have hYF := Limits.isLimitFanMkObjOfIsLimit F _ pr hY
  have hYmF := Limits.isLimitFanMkObjOfIsLimit F _ prm hYm
  let gh : F.obj Yt ⟶ F.obj Ym :=
    Limits.Fan.IsLimit.lift hYmF (fun r => F.map (pr r) ≫ (β r).hom)
  let gi : F.obj Ym ⟶ F.obj Yt :=
    Limits.Fan.IsLimit.lift hYF (fun r => F.map (prm r) ≫ (β r).inv)
  have hgh : ∀ r, gh ≫ F.map (prm r) = F.map (pr r) ≫ (β r).hom :=
    fun r => Limits.Fan.IsLimit.fac hYmF _ r
  have hgi : ∀ r, gi ≫ F.map (pr r) = F.map (prm r) ≫ (β r).inv :=
    fun r => Limits.Fan.IsLimit.fac hYF _ r
  let γ : F.obj Yt ≅ F.obj Ym :=
    { hom := gh
      inv := gi
      hom_inv_id := by
        apply Limits.Fan.IsLimit.hom_ext hYF
        intro r
        show (gh ≫ gi) ≫ F.map (pr r) = 𝟙 _ ≫ F.map (pr r)
        rw [Category.assoc, hgi, reassoc_of% (hgh r), Iso.hom_inv_id, Category.comp_id,
          Category.id_comp]
      inv_hom_id := by
        apply Limits.Fan.IsLimit.hom_ext hYmF
        intro r
        show (gi ≫ gh) ≫ F.map (prm r) = 𝟙 _ ≫ F.map (prm r)
        rw [Category.assoc, hgh, reassoc_of% (hgi r), Iso.inv_hom_id, Category.comp_id,
          Category.id_comp] }

  have sq1 : F.map ι ≫ gh = ψ.hom ≫ F.map incl := by
    apply Limits.Fan.IsLimit.hom_ext hYmF
    intro r
    show (F.map ι ≫ gh) ≫ F.map (prm r) = (ψ.hom ≫ F.map incl) ≫ F.map (prm r)
    rw [Category.assoc, Category.assoc, hgh, ← F.map_comp_assoc, hιpr, hβ, ← F.map_comp, hincl]
  have sq2 : F.map T ≫ gh = gh ≫ F.map shift := by
    apply Limits.Fan.IsLimit.hom_ext hYmF
    intro r
    show (F.map T ≫ gh) ≫ F.map (prm r) = (gh ≫ F.map shift) ≫ F.map (prm r)
    rw [Category.assoc, Category.assoc, hgh, ← F.map_comp, hshift, ← F.map_comp_assoc, hT,
      F.map_sub, F.map_sub, F.map_comp, F.map_comp, Preadditive.sub_comp, Preadditive.comp_sub,
      hgh, Category.assoc, hg2, reassoc_of% (hgh (r + 1))]

  obtain ⟨h₀, hS₀⟩ := hses
  have hS₂ := hS₀.map_of_exact F
  have h₁ : F.map ι ≫ F.map T = 0 := by rw [← F.map_comp, hι, F.map_zero]
  let e : ShortComplex.mk (F.map ι) (F.map T) h₁ ≅ (ShortComplex.mk incl shift h₀).map F :=
    ShortComplex.isoMk ψ γ γ sq1.symm sq2.symm
  have hS1 : (ShortComplex.mk (F.map ι) (F.map T) h₁).ShortExact :=
    ShortComplex.shortExact_of_iso e.symm hS₂

  haveI : Mono (F.map ι) := hS1.mono_f
  have hk0 : F.map (Limits.kernel.ι T) ≫ F.map T = 0 := by
    rw [← F.map_comp, Limits.kernel.condition, F.map_zero]
  let u : F.obj (Limits.kernel T) ⟶ F.obj G := hS1.exact.lift (F.map (Limits.kernel.ι T)) hk0
  have hu : u ≫ F.map ι = F.map (Limits.kernel.ι T) := hS1.exact.lift_f _ _
  have hqk : F.map (Limits.kernel.lift T ι hι) ≫ F.map (Limits.kernel.ι T) = F.map ι := by
    rw [← F.map_comp, Limits.kernel.lift_ι]
  have c1 : F.map (Limits.kernel.lift T ι hι) ≫ u = 𝟙 _ := by
    rw [← cancel_mono (F.map ι), Category.assoc, hu, hqk, Category.id_comp]
  have c2 : u ≫ F.map (Limits.kernel.lift T ι hι) = 𝟙 _ := by
    rw [← cancel_mono (F.map (Limits.kernel.ι T)), Category.assoc, hqk, hu, Category.id_comp]
  refine ⟨Limits.IsZero.of_mono_eq_zero (F.map (Limits.kernel.ι (Limits.kernel.lift T ι hι))) ?_,
    Limits.IsZero.of_epi_eq_zero (F.map (Limits.cokernel.π (Limits.kernel.lift T ι hι))) ?_⟩
  · rw [← Category.comp_id (F.map (Limits.kernel.ι (Limits.kernel.lift T ι hι))), ← c1,
      ← Category.assoc, ← F.map_comp, Limits.kernel.condition, F.map_zero, Limits.zero_comp]
  · rw [← Category.id_comp (F.map (Limits.cokernel.π (Limits.kernel.lift T ι hι))), ← c2,
      Category.assoc, ← F.map_comp, Limits.cokernel.condition, F.map_zero, Limits.comp_zero]

theorem wc_contSheaf_intvec_tower_model : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ), ∃ (Ym : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (Bm : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (red : ∀ r, wcContSheaf S (Fin k → ℤ_[ℓ]) ⟶ Bm r) (cst : ∀ r, Bm (r + 1) ⟶ Bm r) (prm : ∀ r, Ym ⟶ Bm r) (incl : wcContSheaf S (Fin k → ℤ_[ℓ]) ⟶ Ym) (shift : Ym ⟶ Ym), (∀ r, ∃ h : ((ℓ ^ r : ℕ) • 𝟙 (wcContSheaf S (Fin k → ℤ_[ℓ]))) ≫ red r = 0, (ShortComplex.mk _ _ h).ShortExact) ∧ (∀ r, red (r + 1) ≫ cst r = red r) ∧ Nonempty (Limits.IsLimit (Limits.Fan.mk Ym prm)) ∧ (∀ r, incl ≫ prm r = red r) ∧ (∀ r, shift ≫ prm r = prm r - prm (r + 1) ≫ cst r) ∧ ∃ h : incl ≫ shift = 0, (ShortComplex.mk incl shift h).ShortExact :=
by
  intro S ℓ _ k
  obtain ⟨hTI, -, -, hTker, ⟨σ₀, hσ₀c, hσ₀⟩⟩ := wc_padic_tower_facts ℓ

  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ ψ : A →+ B)
      (hφ : Continuous φ) (hψ : Continuous ψ), φ = ψ →
      wcContSheafMap S φ hφ = wcContSheafMap S ψ hψ := by
    intro A B _ _ _ _ _ _ φ ψ hφ hψ h
    subst h
    rfl
  have htz : ∀ r : ℕ, Continuous (fun a : ℤ_[ℓ] => PadicInt.toZModPow r a) :=
    fun r => (continuous_apply r).comp hTI

  let red' : ∀ r : ℕ, (Fin k → ℤ_[ℓ]) →+ (Fin k → ZMod (ℓ ^ r)) :=
    fun r => (PadicInt.toZModPow (p := ℓ) r).toAddMonoidHom.compLeft (Fin k)
  let cstv : ∀ r : ℕ, (Fin k → ZMod (ℓ ^ (r + 1))) →+ (Fin k → ZMod (ℓ ^ r)) :=
    fun r => (wcTowerCast ℓ r).compLeft (Fin k)
  let ev : ∀ n : ℕ, ((m : ℕ) → Fin k → ZMod (ℓ ^ m)) →+ (Fin k → ZMod (ℓ ^ n)) :=
    fun n => Pi.evalAddMonoidHom (fun m : ℕ => Fin k → ZMod (ℓ ^ m)) n
  let incl' : (Fin k → ℤ_[ℓ]) →+ ((m : ℕ) → Fin k → ZMod (ℓ ^ m)) := AddMonoidHom.pi red'
  let shift' : ((m : ℕ) → Fin k → ZMod (ℓ ^ m)) →+ ((m : ℕ) → Fin k → ZMod (ℓ ^ m)) :=
    AddMonoidHom.pi (fun n => ev n - (cstv n).comp (ev (n + 1)))
  let sc : ∀ r : ℕ, (Fin k → ℤ_[ℓ]) →+ (Fin k → ℤ_[ℓ]) :=
    fun r => DistribSMul.toAddMonoidHom (Fin k → ℤ_[ℓ]) ((ℓ ^ r : ℕ) : ℤ_[ℓ])

  have hred'c : ∀ r, Continuous (red' r) := by
    intro r
    show Continuous (fun (b : Fin k → ℤ_[ℓ]) (i : Fin k) => PadicInt.toZModPow r (b i))
    exact continuous_pi (fun i => (htz r).comp (continuous_apply i))
  have hcstc : ∀ r, Continuous (cstv r) := fun r => continuous_of_discreteTopology
  have hevc : ∀ n, Continuous (ev n) := fun n => continuous_apply n
  have hinc : Continuous incl' := by
    show Continuous (fun (x : Fin k → ℤ_[ℓ]) (n : ℕ) => red' n x)
    exact continuous_pi (fun n => hred'c n)
  have hsubc : ∀ n, Continuous (ev n - (cstv n).comp (ev (n + 1))) := fun n =>
    (hevc n).sub ((hcstc n).comp (hevc (n + 1)))
  have hshc : Continuous shift' := by
    show Continuous (fun (y : (m : ℕ) → Fin k → ZMod (ℓ ^ m)) (n : ℕ) =>
      (ev n - (cstv n).comp (ev (n + 1))) y)
    exact continuous_pi (fun n => hsubc n)
  have hscc : ∀ r, Continuous (sc r) := fun r => continuous_const_smul _

  have hc0 : ∀ r : ℕ, ((ℓ ^ r : ℕ) : ℤ_[ℓ]) ≠ 0 := fun r =>
    Nat.cast_ne_zero.mpr (pow_ne_zero r (Fact.out : ℓ.Prime).ne_zero)
  have hscEmb : ∀ r, Topology.IsEmbedding (sc r) := by
    intro r
    have hinj : Function.Injective (sc r) := by
      intro x y hxy
      funext i
      have h1 : ((ℓ ^ r : ℕ) : ℤ_[ℓ]) * x i = ((ℓ ^ r : ℕ) : ℤ_[ℓ]) * y i := congrFun hxy i
      exact mul_left_cancel₀ (hc0 r) h1
    exact ((hscc r).isClosedEmbedding hinj).isEmbedding
  have hscKer : ∀ r (b : Fin k → ℤ_[ℓ]), red' r b = 0 ↔ ∃ a, sc r a = b := by
    intro r b
    constructor
    · intro hb
      have hmem : ∀ i, ∃ a : ℤ_[ℓ], a * (ℓ : ℤ_[ℓ]) ^ r = b i := by
        intro i
        have h1 : PadicInt.toZModPow r (b i) = 0 := congrFun hb i
        have h2 : b i ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) r) := h1
        rw [PadicInt.ker_toZModPow] at h2
        exact Ideal.mem_span_singleton'.mp h2
      choose a ha using hmem
      refine ⟨a, funext fun i => ?_⟩
      show ((ℓ ^ r : ℕ) : ℤ_[ℓ]) * a i = b i
      rw [Nat.cast_pow, mul_comm]
      exact ha i
    · rintro ⟨a, rfl⟩
      funext i
      show PadicInt.toZModPow r (((ℓ ^ r : ℕ) : ℤ_[ℓ]) * a i) = 0
      rw [map_mul, map_natCast, ZMod.natCast_self, zero_mul]
  have hscSec : ∀ r, ∃ σ : (Fin k → ZMod (ℓ ^ r)) → (Fin k → ℤ_[ℓ]),
      Continuous σ ∧ ∀ c, red' r (σ c) = c := by
    intro r
    refine ⟨fun c i => (((c i).val : ℕ) : ℤ_[ℓ]), continuous_of_discreteTopology,
      fun c => funext fun i => ?_⟩
    show PadicInt.toZModPow r (((c i).val : ℕ) : ℤ_[ℓ]) = c i
    rw [map_natCast, ZMod.natCast_zmod_val]

  have hincEmb : Topology.IsEmbedding incl' := by
    have hinj : Function.Injective incl' := by
      intro x y hxy
      funext i
      apply PadicInt.ext_of_toZModPow.mp
      intro n
      exact congrFun (congrFun hxy n) i
    exact (hinc.isClosedEmbedding hinj).isEmbedding
  have hker : ∀ y, shift' y = 0 ↔ ∃ x, incl' x = y := by
    intro y
    constructor
    · intro hy
      have hmem : ∀ i : Fin k, ∃ a : ℤ_[ℓ], wcTowerIncl ℓ a = fun m => y m i := by
        intro i
        apply (hTker _).mp
        funext n
        exact congrFun (congrFun hy n) i
      choose a ha using hmem
      exact ⟨a, funext fun n => funext fun i => congrFun (ha i) n⟩
    · rintro ⟨x, rfl⟩
      funext n i
      exact congrFun ((hTker (wcTowerIncl ℓ (x i))).mpr ⟨x i, rfl⟩) n
  have hsec : ∃ σ : ((m : ℕ) → Fin k → ZMod (ℓ ^ m)) → ((m : ℕ) → Fin k → ZMod (ℓ ^ m)),
      Continuous σ ∧ ∀ c, shift' (σ c) = c := by
    refine ⟨fun z n i => σ₀ (fun m => z m i) n, ?_, fun z => funext fun n => funext fun i => ?_⟩
    · have hcoord : ∀ i : Fin k, Continuous
          (fun (z : (m : ℕ) → Fin k → ZMod (ℓ ^ m)) (m : ℕ) => z m i) := fun i =>
        continuous_pi fun m => (continuous_apply i).comp (continuous_apply m)
      exact continuous_pi fun n => continuous_pi fun i =>
        (continuous_apply n).comp (hσ₀c.comp (hcoord i))
    · exact congrFun (hσ₀ (fun m => z m i)) n

  refine ⟨wcContSheaf S ((m : ℕ) → Fin k → ZMod (ℓ ^ m)), fun r => wcContSheaf S (Fin k → ZMod (ℓ ^ r)),
    fun r => wcContSheafMap S (red' r) (hred'c r),
    fun r => wcContSheafMap S (cstv r) (hcstc r),
    fun r => wcContSheafMap S (ev r) (hevc r),
    wcContSheafMap S incl' hinc, wcContSheafMap S shift' hshc, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro r
    beta_reduce
    obtain ⟨hz, hse⟩ := wc_contSheaf_shortExact S (sc r) (hscc r) (red' r) (hred'c r)
      (hscEmb r) (hscKer r) (hscSec r)
    have heq : wcContSheafMap S (sc r) (hscc r) =
        (ℓ ^ r : ℕ) • 𝟙 (wcContSheaf S (Fin k → ℤ_[ℓ])) :=
      (wc_contSheafMap_scalar_facts S ℓ k).2.1 (ℓ ^ r)
    revert hz hse
    rw [heq]
    exact fun hz hse => ⟨hz, hse⟩
  ·
    intro r
    beta_reduce
    have hcomp : (cstv r).comp (red' (r + 1)) = red' r :=
      AddMonoidHom.ext fun x => funext fun i =>
        PadicInt.cast_toZModPow r (r + 1) (Nat.le_succ r) (x i)
    exact (wc_contSheafMap_comp_sub S (red' (r + 1)) (red' (r + 1)) (hred'c (r + 1))
      (hred'c (r + 1)) (cstv r) (hcstc r)).1.symm.trans (hcongr _ _ _ _ hcomp)
  ·
    exact wc_contSheaf_pi_isLimit S (fun n => Fin k → ZMod (ℓ ^ n))
  ·
    intro r
    beta_reduce
    have hcomp : (ev r).comp incl' = red' r := AddMonoidHom.ext fun x => rfl
    exact (wc_contSheafMap_comp_sub S incl' incl' hinc hinc (ev r) (hevc r)).1.symm.trans
      (hcongr _ _ _ _ hcomp)
  ·
    intro r
    beta_reduce
    have h1 := (wc_contSheafMap_comp_sub S shift' shift' hshc hshc (ev r) (hevc r)).1
    have h2 := (wc_contSheafMap_comp_sub S (ev r) ((cstv r).comp (ev (r + 1))) (hevc r)
      ((hcstc r).comp (hevc (r + 1))) (AddMonoidHom.id _) continuous_id).2
    have h3 := (wc_contSheafMap_comp_sub S (ev (r + 1)) (ev (r + 1)) (hevc (r + 1))
      (hevc (r + 1)) (cstv r) (hcstc r)).1
    have h4 : (ev r).comp shift' = ev r - (cstv r).comp (ev (r + 1)) :=
      AddMonoidHom.ext fun y => rfl
    refine h1.symm.trans ((hcongr _ _ _ (hsubc r) h4).trans ?_)
    rw [h2, ← h3]
  ·
    exact wc_contSheaf_shortExact S incl' hinc shift' hshc hincEmb hker hsec

theorem wc_proet_detect_through_cover (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) :
    ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : G.obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        (G.obj.map h.op).hom x = 0) →
      ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        (G.obj.map h.op).hom x = 0 :=
by


  have key : ∀ (B W : (wcP1Over K).left.ProEt) (w : W ⟶ B), QuasiCompact w.left →
      ∀ (s : G.obj.obj (Opposite.op B)), (G.obj.map w.op).hom s = 0 →
      ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ B),
        (∀ p : V.left, ∃ z : W.left, w.left z = g.left p) →
      (G.obj.map g.op).hom s = 0 := by
    intro B W w hqc s hs V g hlift
    haveI := hqc
    haveI hWp : WeaklyEtale W.hom := W.prop
    haveI hBp : WeaklyEtale B.hom := B.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w.left ≫ B.hom) := by
      rw [MorphismProperty.Over.w w]; exact hWp
    haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left B.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst g.left w.left) := inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst g.left w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst g.left w.left ≫ V.hom) := inferInstance
    let T : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g.left w.left ≫ V.hom)
    let a : T ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst g.left w.left) rfl trivial
    have hb : Limits.pullback.snd g.left w.left ≫ W.hom =
        Limits.pullback.fst g.left w.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w g, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : T ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd g.left w.left) hb trivial
    have hsq : a ≫ g = b ≫ w := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    have hsurj : ∀ x : V.left, ∃ (_ : PUnit.{u+2}) (y : T.left), a.left y = x := by
      intro p
      obtain ⟨z, hz⟩ := hlift p
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback p z hz.symm
      exact ⟨PUnit.unit, τ, hτ⟩
    haveI hae : WeaklyEtale a.left := hfst
    haveI haq : QuasiCompact a.left := hfstq
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) V.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => T.left) (fun _ => a.left)
        hsurj (fun _ => hae)
    have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
    have hR : Presieve.ofArrows (fun _ : PUnit.{u+2} => T.left) (fun _ => a.left) ∈
        Scheme.proetalePrecoverage.coverings V.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget (wcP1Over K).left ⋙
      Over.forget (wcP1Over K).left) (Y := fun _ : PUnit.{u+2} => T) (fun _ => a)
    have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => T) (fun _ => a) ∈
        (Scheme.ProEt.precoverage (wcP1Over K).left).coverings V :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR)
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => T) (fun _ => a)) ∈
        (Scheme.ProEt.topology (wcP1Over K).left) V :=
      Precoverage.generate_mem_toGrothendieck hR'
    have ht : (G.obj.map a.op).hom ((G.obj.map g.op).hom s) = 0 := by
      have h1 := congrArg (fun c => (G.obj.map c.op).hom s) hsq
      simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hs,
        map_zero] at h1
      exact h1
    refine Sheaf.isSeparated G V _ hRJ ((G.obj.map g.op).hom s) 0 ?_
    rintro Y f ⟨Y', h, k, hk, rfl⟩
    rcases hk with ⟨i⟩
    change (G.obj.map (h ≫ a).op).hom ((G.obj.map g.op).hom s) = (G.obj.map (h ≫ a).op).hom 0
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, ht, map_zero,
      map_zero]
  intro T g x H V h hV
  haveI := hqc
  haveI hWp : WeaklyEtale W.hom := W.prop
  haveI hUp : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom :=
    (wcGeomPoint K (wcP1Over K) hP).prop
  haveI hwU : WeaklyEtale (w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
    rw [MorphismProperty.Over.w w]; exact hWp
  haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left (wcGeomPoint K (wcP1Over K) hP).hom
  haveI hTp : WeaklyEtale T.hom := T.prop
  haveI hfst : WeaklyEtale (Limits.pullback.fst g.left w.left) := inferInstance
  haveI hfstq : QuasiCompact (Limits.pullback.fst g.left w.left) := inferInstance
  haveI : WeaklyEtale (Limits.pullback.fst g.left w.left ≫ T.hom) := inferInstance
  let WT : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g.left w.left ≫ T.hom)
  let a : WT ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst g.left w.left) rfl trivial
  have hb : Limits.pullback.snd g.left w.left ≫ W.hom =
      Limits.pullback.fst g.left w.left ≫ T.hom := by
    rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w g, ← Category.assoc,
      ← Category.assoc, Limits.pullback.condition]
  let b : WT ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd g.left w.left) hb trivial
  have hsq : a ≫ g = b ≫ w := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.condition
  have hx : (G.obj.map a.op).hom x = 0 := H WT a b hsq.symm
  haveI haq : QuasiCompact a.left := hfstq
  refine key T WT a haq x hx V h ?_
  intro p
  have e1 : (wcGeomPoint K (wcP1Over K) hP).hom (g.left (h.left p)) = V.hom p := by
    have h1 : (h.left ≫ g.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) = V.hom := by
      rw [MorphismProperty.Over.w g, MorphismProperty.Over.w h]
    have h2 := congrArg (fun f => f p) h1
    simpa only [Scheme.Hom.comp_apply] using h2
  have hu : ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom (g.left (h.left p)) ≠
      S i (IsLocalRing.closedPoint K) := by
    intro i
    rw [e1]
    exact hV p i
  obtain ⟨z, hz⟩ := hsurj _ hu
  obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback (h.left p) z hz.symm
  exact ⟨τ, hτ⟩

theorem wc_P1_offS_sections_zero_of_over_zero : ∀ (F'' : Type u) [Field F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)) (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (hqc : QuasiCompact w.left) (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S i (IsLocalRing.closedPoint F'')) → ∃ z : W.left, w.left z = p) (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) (hG : Limits.IsZero (G.over W)), ∀ (V : (wcP1Over F'').left.ProEt), (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint F'')) → ∀ s : G.obj.obj (Opposite.op V), s = 0 :=
by
  intro F'' _ hP m S W w hqc hsurj G hG V hV s

  have hzero : ∀ (V' : (wcP1Over F'').left.ProEt) (b : V' ⟶ W)
      (y : G.obj.obj (Opposite.op V')), y = 0 := by
    intro V' b y
    have h1 := Functor.map_isZero
      (sheafToPresheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over W) AddCommGrpCat.{u+1} ⋙
        (evaluation (Over W)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op (Over.mk b))) hG
    have h2 : Limits.IsZero (G.obj.obj (Opposite.op V')) := h1
    haveI := AddCommGrpCat.subsingleton_of_isZero h2
    exact Subsingleton.elim _ _
  haveI hqcP : QuasiCompact (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    (inferInstance : QuasiCompact (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  haveI hsP : Surjective (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    (inferInstance : Surjective (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  let T : (wcP1Over F'').left.ProEt :=
    Scheme.ProEt.mk (Limits.pullback.fst V.hom (wcGeomPoint F'' (wcP1Over F'') hP).hom ≫ V.hom)
  let p₁ : T ⟶ V := MorphismProperty.Over.homMk
    (Limits.pullback.fst V.hom (wcGeomPoint F'' (wcP1Over F'') hP).hom) rfl trivial
  let p₂ : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP := MorphismProperty.Over.homMk
    (Limits.pullback.snd V.hom (wcGeomPoint F'' (wcP1Over F'') hP).hom)
    Limits.pullback.condition.symm trivial
  have hp₁qc : QuasiCompact p₁.left :=
    (inferInstance : QuasiCompact
      (Limits.pullback.fst V.hom (wcGeomPoint F'' (wcP1Over F'') hP).hom))
  have hTavoid : ∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint F'') := by
    intro t i
    have e : T.hom t =
        V.hom (Limits.pullback.fst V.hom (wcGeomPoint F'' (wcP1Over F'') hP).hom t) :=
      Scheme.Hom.comp_apply _ _ t
    rw [e]
    exact hV _ i
  have hx : (G.obj.map p₁.op).hom s = 0 := by
    have h := wc_proet_detect_through_cover F'' hP m S W w hqc hsurj G T p₂
      ((G.obj.map p₁.op).hom s) (fun V' _ h' _ => hzero V' h' _) T (𝟙 T) hTavoid
    simpa using h
  have hs := wc_proet_section_zero_of_qc_image (wcP1Over F'').left G V T p₁ hp₁qc s hx V (𝟙 V)
    (by
      intro p
      obtain ⟨q, hq⟩ := (wcGeomPoint F'' (wcP1Over F'') hP).hom.surjective (V.hom p)
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback p q hq.symm
      exact ⟨z, hz⟩)
  simpa using hs

theorem wc_qclift_tower_defect_offS_zero (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (k : ℕ)
    (θ : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W) (x : (Subobject.underlying.obj M).obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject (Subobject.underlying.obj M))
    (hJ : ∀ (V : (wcP1Over F'').left.ProEt) (s : (Subobject.underlying.obj M).obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over F'').left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom (((Subobject.underlying.obj M).obj.map c.op).hom s)).down) z) i‖ ≤ 1)
    (Yt : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (pr : ∀ r : ℕ, Yt ⟶ Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))
    (hY : Limits.IsLimit (Limits.Fan.mk Yt pr))
    (c : ∀ r : ℕ, Limits.cokernel ((ℓ ^ (r + 1) : ℕ) • 𝟙 (Subobject.underlying.obj J)) ⟶
      Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))
    (hc : ∀ r, Limits.cokernel.π ((ℓ ^ (r + 1) : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫ c r =
      Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))
    (T : Yt ⟶ Yt) (hT : ∀ r, T ≫ pr r = pr r - pr (r + 1) ≫ c r)
    (ι : Subobject.underlying.obj J ⟶ Yt)
    (hιpr : ∀ r, ι ≫ pr r = Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))
    (hι : ι ≫ T = 0) :
    ∀ (V : (wcP1Over F'').left.ProEt),
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      (∀ s : (Limits.kernel (Limits.kernel.lift T ι hι)).obj.obj (Opposite.op V), s = 0) ∧
      (∀ s : (Limits.cokernel (Limits.kernel.lift T ι hι)).obj.obj (Opposite.op V), s = 0) :=
by
  intro V hV
  obtain ⟨ψ, -⟩ := wc_qclift_integral_frame (wcP1Over F'').left ℓ (Subobject.underlying.obj M) W k θ
    P hint J hJ
  obtain ⟨Ym, Bm, red, cst, prm, incl, shift, hred, hcst, ⟨hYm⟩, hincl, hshift, hses⟩ :=
    wc_contSheaf_intvec_tower_model (wcP1Over F'').left ℓ k
  haveI : Limits.PreservesFiniteColimits
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W) := by
    have hpc : Limits.PreservesColimitsOfSize.{0, 0}
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W) :=
      (Functor.sheafAdjunctionCocontinuous (Over.forget W) AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology (wcP1Over F'').left).over W)
        (Scheme.ProEt.topology (wcP1Over F'').left)).leftAdjoint_preservesColimits
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W)
  haveI : ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).Additive :=
    Functor.additive_of_preserves_binary_products _
  obtain ⟨hK, hC⟩ := wc_tower_defect_isZero_of_exact_functor
    ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W) ℓ
    (Subobject.underlying.obj J) Yt pr hY c hc T hT ι hιpr hι
    (wcContSheaf (wcP1Over F'').left (Fin k → ℤ_[ℓ])) Ym Bm red hred cst hcst prm hYm incl hincl
    shift hshift hses ψ
  exact ⟨wc_P1_offS_sections_zero_of_over_zero F'' hP D.m D.S W w hqc hsurj _ hK V hV,
    wc_P1_offS_sections_zero_of_over_zero F'' hP D.m D.S W w hqc hsurj _ hC V hV⟩

theorem wc_proet_ext_free_vanish_of_sections_zero : ∀ (S : Scheme.{u}) (V : S.ProEt) (K : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), (∀ (W : S.ProEt) (b : W ⟶ V) (s : K.obj.obj (Opposite.op W)), s = 0) → ∀ (n : ℕ) (x : Abelian.Ext (wcFreeSheaf S V) K n), x = 0 :=
by
  intro S V K hK i x

  have wc_over_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (Over.forget U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (Over.forget U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (Over.forget U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Over.mk f))
        (hk : (Over.forget U).op.map k ≫ (𝟙 W).op = c.hom),
        (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom ∧
          f = Quiver.Hom.unop c.hom ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : 𝟙 W ≫ (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
        congrArg Quiver.Hom.unop hk
      have h1 : (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
        (Category.id_comp _).symm.trans h0
      refine ⟨h1, ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Over.mk f).hom :=
        Over.w (Quiver.Hom.unop k)
      exact hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1)
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply Over.OverMorphism.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U, fc = Quiver.Hom.unop c.hom ≫ c.left.unop.hom :=
      ⟨_, rfl⟩
    obtain ⟨κc, hκc⟩ : ∃ κc : Over.mk fc ⟶ c.left.unop,
        κc.left = Quiver.Hom.unop c.hom :=
      ⟨Over.homMk (Quiver.Hom.unop c.hom) hfc.symm, rfl⟩
    have hw : (Over.forget U).op.map κc.op ≫ (𝟙 W).op = c.hom := by
      apply Quiver.Hom.unop_inj
      exact (Category.id_comp _).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Over.mk fc)) (𝟙 W).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := fun s =>
      (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  have wc_leftAdjoint_freeYoneda_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (Φ : C ⥤ D) [Φ.IsContinuous J K]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
      (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (X : C),
      Nonempty (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
        (presheafToSheaf K AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro C D _ _ J K _ _ Φ _ L adj X
    have rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      intro E _ J' _ Y
      exact
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    have r1 := rep J X
    have r2 := rep K (Φ.obj X)
    let r3 : (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans r1.homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show r1.homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]
          rfl }
    exact ⟨r3.uniqueUpToIso r2⟩
  letI : HasExt (Sheaf ((Scheme.ProEt.topology S).over V) AddCommGrpCat.{u+1}) := HasExt.standard _

  haveI hlan : Limits.PreservesFiniteLimits ((Over.forget V).op.lan :
      ((Over V)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (Over.forget V).op
      (fun W => wc_lan_eval_iso (Over.forget V).op W)
      (fun W => wc_over_costructuredArrow_final S V W.unop)

  let Gr := (Over.forget V).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology S)
  let Fl := (Over.forget V).sheafPullback AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology S)
  let adj : Fl ⊣ Gr := (Over.forget V).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology S)
  let adj2 := (Over.forget V).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Fl := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Fl :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Fl
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Gr := adj2.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Gr :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Gr
  haveI : Gr.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Gr
  haveI : Gr.Additive := Functor.additive_of_preserves_binary_products Gr
  haveI : Fl.Additive := adj.left_adjoint_additive
  let Z := (presheafToSheaf ((Scheme.ProEt.topology S).over V) AddCommGrpCat.{u+1}).obj
    (yoneda.obj (Over.mk (𝟙 V)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)

  obtain ⟨e⟩ := wc_leftAdjoint_freeYoneda_iso ((Scheme.ProEt.topology S).over V)
    (Scheme.ProEt.topology S) (Over.forget V) Fl adj (Over.mk (𝟙 V))
  let e' : Fl.obj Z ≅ wcFreeSheaf S V := e

  let E₀ : Abelian.Ext (wcFreeSheaf S V) K i ≃+ Abelian.Ext (Fl.obj Z) K i :=
    { toFun := fun x => (Abelian.Ext.mk₀ e'.hom).comp x (zero_add i)
      invFun := fun y => (Abelian.Ext.mk₀ e'.inv).comp y (zero_add i)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ x y (zero_add i) }
  let E : Abelian.Ext (wcFreeSheaf S V) K i ≃+ Abelian.Ext Z (Gr.obj K) i :=
    E₀.trans (adj.extEquiv (X := Z) (Y := K) (n := i))

  have hZ : Limits.IsZero (Gr.obj K) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext
    ext X s
    have h0 : s = 0 := hK X.unop.left X.unop.hom s
    rw [h0, map_zero, map_zero]

  have hE0 : ∀ y : Abelian.Ext Z (Gr.obj K) i, y = 0 := by
    intro y
    rw [← Abelian.Ext.comp_mk₀_id y, hZ.eq_of_src (𝟙 (Gr.obj K)) 0, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]

  rw [← E.symm_apply_apply x, hE0 (E x), map_zero]

theorem wc_P1_punct_coker_ext_vanish : ∀ (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)), (∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _) → ∀ (K : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}), (∀ (V : (wcP1Over F'').left.ProEt), (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint F'')) → ∀ (n : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) K n), x = 0) → ∀ (i0 : Fin m) (j : ℕ), 1 ≤ j → ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' (S i0) hP))) K j, x = 0 :=
by
  classical
  intro F'' _ _ hP m S hS K hvan i0 j hj x
  obtain ⟨V₀, g₀, φ₀, A, iA₁, iA₂, iA₃, e, ε, hv, -, hε, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' (S i0) (hS i0) hP
  obtain ⟨κ, hκ, -⟩ := wc_strict_nbhd_punct_excision F'' (S i0) (hS i0) hP V₀ g₀ A e ε hv hε
  haveI := hκ
  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local (wcP1Over F'').left V₀ A e

  have hclosedS : ∀ i : Fin m, IsClosed ({S i (IsLocalRing.closedPoint F'')} :
      Set (wcP1Over F'').left) := by
    intro i
    haveI : IsClosedImmersion (S i) := isClosedImmersion_of_comp_eq_id _ (S i) (hS i)
    have hrange : Set.range (S i) = {S i (IsLocalRing.closedPoint F'')} := by
      ext z
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        exact Set.mem_singleton _
      · intro hz
        rw [Set.mem_singleton_iff.mp hz]
        exact ⟨_, rfl⟩
    rw [← hrange]
    exact (S i).isClosedEmbedding.isClosed_range
  have hVT : ∀ (t : (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).left)
      (i : Fin m), (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).hom t ≠
        S i (IsLocalRing.closedPoint F'') := by
    intro t i h
    set p := Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom t with hp
    have h1 : (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).hom t = V₀.hom p := by
      first
        | exact Scheme.Hom.comp_apply (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom)
            V₀.hom t
        | rfl
    have h2 : V₀.hom p ∈ (wcPunctOpen F'' (S i0) : Set (wcP1Over F'').left) := by
      have key : ∀ q : ↥(Limits.pullback (wcPunctOpen F'' (S i0)).ι V₀.hom),
          (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom ≫ V₀.hom) q ∈
            (wcPunctOpen F'' (S i0) : Set (wcP1Over F'').left) := by
        intro q
        rw [← Limits.pullback.condition, Scheme.Hom.comp_apply,
          ← Scheme.Opens.range_ι (wcPunctOpen F'' (S i0))]
        exact Set.mem_range_self _
      have k2 := key t
      rw [← h1]
      exact k2
    have h3 : p ⤳ e.inv (IsLocalRing.closedPoint A) := by
      have := (IsLocalRing.specializes_closedPoint (e.hom p)).map e.inv.continuous
      rwa [Scheme.hom_inv_apply] at this
    have h4 : V₀.hom p ⤳ S i0 (IsLocalRing.closedPoint F'') := by
      rw [← hv]; exact h3.map V₀.hom.continuous
    have h5 : S i0 (IsLocalRing.closedPoint F'') ∈
        closure {S i (IsLocalRing.closedPoint F'')} := by
      rw [← h, h1]; exact specializes_iff_mem_closure.mp h4
    rw [(hclosedS i).closure_eq] at h5
    have h6 : V₀.hom p = S i0 (IsLocalRing.closedPoint F'') := by
      rw [← h1, h, ← Set.mem_singleton_iff.mp h5]
    have h7 : V₀.hom p ∈ ((closure {S i0 (IsLocalRing.closedPoint F'')})ᶜ :
        Set (wcP1Over F'').left) := h2
