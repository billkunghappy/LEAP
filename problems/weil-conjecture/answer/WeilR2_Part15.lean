    intro V hV
    apply wc_et_push_sections_homology_isIso O.ι
    have hrange : Set.range (((wcEtBaseChange O.ι).obj V).hom ≫ O.ι) ⊆ Set.range W.ι := by
      rintro _ ⟨v, rfl⟩
