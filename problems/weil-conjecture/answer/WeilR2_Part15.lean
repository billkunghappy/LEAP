theorem wc_lsiaq_aug_restr_zero_empty : ∀ {M Xb : Scheme.{u}} (G : M ⟶ Xb) (ℓ : ℕ), ℓ ≠ 1 → ∀ (I : InjectiveResolution (wcConstZ M ℓ)) (V : Xb.Etale) (c : V ⟶ wcEtTop Xb), (((wcEtPush G).obj (I.cocomplex.X 0)).obj.map c.op).hom (((toSheafify (Scheme.smallEtaleTopology Xb) ((wcEtBaseChange G).op ⋙ (I.cocomplex.X 0).obj)).app (Opposite.op (wcEtTop Xb))).hom (((wcInjAug I).hom.app (Opposite.op ((wcEtBaseChange G).obj (wcEtTop Xb)))).hom (wcConstSec M (ULift.{u+1} (ZMod ℓ)) ((wcEtBaseChange G).obj (wcEtTop Xb)) (ULift.up 1)))) = 0 → IsEmpty ↥(Limits.pullback V.hom G) :=
