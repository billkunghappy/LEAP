    have ht3 : t ≫ q₃ = d := by
      have hf2 : t ≫ f2 = Limits.pullback.lift b d hbd := Limits.pullback.lift_snd _ _ _
      show t ≫ f2 ≫ Limits.pullback.snd V.hom V.hom = d
      rw [← Category.assoc, hf2, Limits.pullback.lift_snd]
    have key := hGc () () () T' a' b' d' (t z)
    have e_ad : t ≫ Limits.pullback.lift q₁ q₃ h23.symm = Limits.pullback.lift a d had := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst, ht1]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, ht3]
    have e_ab : t ≫ Limits.pullback.lift q₁ q₂ h12.symm = Limits.pullback.lift a b hab := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst, ht1]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, ht2]
    have e_bd : t ≫ Limits.pullback.lift q₂ q₃ (h12.trans h23.symm) =
        Limits.pullback.lift b d hbd := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst, ht2]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, ht3]
    rw [← e_ad, ← e_ab, ← e_bd, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
      Scheme.Hom.comp_apply]
    exact key

  have tr : ∀ {Z : Scheme.{u}} (a b : Z ⟶ V.left), a ≫ p = b ≫ p → a ≫ V.hom = b ≫ V.hom := by
    intro Z a b h
    rw [← hpq, ← Category.assoc, h, Category.assoc]
  let m : Limits.pullback p p ⟶ Limits.pullback V.hom V.hom :=
    Limits.pullback.lift (Limits.pullback.fst p p) (Limits.pullback.snd p p)
      (tr _ _ Limits.pullback.condition)
  have hcomp : ∀ (Z : Scheme.{u}) (a b : Z ⟶ V.left) (hab : a ≫ p = b ≫ p)
      (hab' : a ≫ V.hom = b ≫ V.hom),
      Limits.pullback.lift a b hab ≫ m = Limits.pullback.lift a b hab' := by
    intro Z a b hab hab'
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
        Limits.pullback.lift_fst]
    · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd,
        Limits.pullback.lift_snd]
  let c : ↥(Limits.pullback p p) → Multiplicative (AddAut M) := fun w => g (m w)
  have hc_eq : ∀ (Z : Scheme.{u}) (a b : Z ⟶ V.left) (hab : a ≫ p = b ≫ p)
      (hab' : a ≫ V.hom = b ≫ V.hom) (z : Z),
      c (Limits.pullback.lift a b hab z) = g (Limits.pullback.lift a b hab' z) := by
    intro Z a b hab hab' z
    change g (m (Limits.pullback.lift a b hab z)) = _
    rw [← hcomp Z a b hab hab', Scheme.Hom.comp_apply]
  refine ⟨c, ?_, ?_, ?_⟩
  · exact hgl.comp_continuous (Scheme.Hom.continuous m)
  · intro Z a b d hab hbd had z
    rw [hc_eq Z a d had (tr a d had), hc_eq Z a b hab (tr a b hab), hc_eq Z b d hbd (tr b d hbd)]
    exact hsch Z a b d _ _ _ z
  · intro Z a b hab x z
    rw [hc_eq Z.left a.left b.left hab
      ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) z]
    exact hGt () () Z a b x z

theorem wc_fgtor_affine_sheeted : ∀ (U : Scheme.{u}) (Γ : Type) [Group Γ] [Finite Γ] (ι : Type) [Finite ι] (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U), (∀ j, Flat (v j)) → (∀ j, QuasiCompact (v j)) → ∀ (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → Γ), (∀ i j, IsLocallyConstant (g i j)) → wcGCocycle v g → wcGTorDescHyp.{u} → ∀ (O : U.Opens), IsAffineOpen O → (∀ x : U, x ∈ O → ∃ j, x ∈ Set.range (v j)) → ∃ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (E : Scheme.{u}) (π : E ⟶ (O : Scheme.{u})) (σ : ∀ m, Γ → (W m ⟶ E)), IsFinite π ∧ Etale π ∧ (∀ m, IsAffine (W m)) ∧ (∀ m, IsOpenImmersion (w m)) ∧ (∀ m γ, σ m γ ≫ π ≫ O.ι = w m ≫ v (k m)) ∧ (∀ x : U, x ∈ O → ∃ m y, (w m ≫ v (k m)) y = x) ∧ (∀ y : E, ∃ m γ x, σ m γ x = y) ∧ ∀ (m m' : Fin n) (γ γ' : Γ) (Z : Scheme.{u}) (a : Z ⟶ W m) (b : Z ⟶ W m') (hab : (a ≫ w m) ≫ v (k m) = (b ≫ w m') ≫ v (k m')), (a ≫ σ m γ = b ≫ σ m' γ' ↔ ∀ z : Z, γ' = γ * g (k m) (k m') (Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab z)) :=
by

  have wc_gas_lc_glue : ∀ (S : Scheme.{u}) (K : Type) (Y : K → Scheme.{u}) (ε : ∀ k, Y k ⟶ S), (∀ k, IsOpenImmersion (ε k)) → (∀ (k k' : K) (y : Y k) (y' : Y k'), ε k y = ε k' y' → k = k') → (∀ s : S, ∃ k y, ε k y = s) → ∀ (T : Type) (f : ∀ k, Y k → T), (∀ k, IsLocallyConstant (f k)) → ∃ F : S → T, IsLocallyConstant F ∧ ∀ k (y : Y k), F (ε k y) = f k y := by
    intro S K Y ε hopen hdisj hcov T f hf
    classical
    have hemb : ∀ k, Topology.IsOpenEmbedding (ε k) := fun k => by
      haveI := hopen k
      exact (ε k).isOpenEmbedding
    choose κ yy hyy using hcov
    have claim : ∀ k₁ (y₁ : Y k₁) k (y : Y k), ε k₁ y₁ = ε k y → f k₁ y₁ = f k y := by
      intro k₁ y₁ k y h
      obtain rfl := hdisj k₁ k y₁ y h
      rw [(hemb k₁).injective h]
    refine ⟨fun s => f (κ s) (yy s), ?_, fun k y => claim _ _ _ _ (hyy _)⟩
    rw [IsLocallyConstant.iff_exists_open]
    intro s
    obtain ⟨N, hN, hyN, hconst⟩ := (IsLocallyConstant.iff_exists_open _).1 (hf (κ s)) (yy s)
    refine ⟨(ε (κ s)) '' N, (hemb (κ s)).isOpenMap _ hN, ⟨yy s, hyN, hyy s⟩, ?_⟩
    rintro _ ⟨y', hy'N, rfl⟩
    show f (κ _) (yy _) = f (κ s) (yy s)
    rw [claim _ _ _ _ (hyy _), hconst y' hy'N]

  have wc_fgas_affine_cover : ∀ (U : Scheme.{u}) (ι : Type) [Finite ι] (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U), (∀ j, Flat (v j)) → (∀ j, QuasiCompact (v j)) → ∀ (O : U.Opens) (hO : IsAffineOpen O), (∀ x : U, x ∈ O → ∃ j, x ∈ Set.range (v j)) → ∃ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (φ : ∀ m, W m ⟶ Spec (.of Γ(U, O))), (∀ m, IsAffine (W m)) ∧ (∀ m, IsOpenImmersion (w m)) ∧ (∀ m, Flat (φ m)) ∧ (∀ m, φ m ≫ hO.fromSpec = w m ≫ v (k m)) ∧ (∀ x : Spec (.of Γ(U, O)), ∃ m y, φ m y = x) ∧ (∀ x : U, x ∈ O → ∃ m y, (w m ≫ v (k m)) y = x) := by
    intro U ι _ V v hflat hqc O hO hcov
    classical
    have hpick : ∀ (j : ι) (y : ↥(v j ⁻¹ᵁ O)), ∃ A : (V j).Opens, IsAffineOpen A ∧
        (y : V j) ∈ A ∧ (∀ z : V j, z ∈ A → v j z ∈ O) := by
      intro j y
      obtain ⟨A, hA, hyA, hAle⟩ :=
        exists_isAffineOpen_mem_and_subset (x := (y : V j)) (U := v j ⁻¹ᵁ O) y.2
      exact ⟨A, hA, hyA, fun z hz => hAle hz⟩
    choose A hA hyA hAO using hpick
    have hfin : ∀ j : ι, ∃ t : Finset ↥(v j ⁻¹ᵁ O),
        ((v j ⁻¹ᵁ O : (V j).Opens) : Set (V j)) ⊆ ⋃ y ∈ t, (A j y : Set (V j)) := by
      intro j
      haveI := hqc j
      have hc : IsCompact ((v j ⁻¹ᵁ O : (V j).Opens) : Set (V j)) :=
        (v j).isCompact_preimage hO.isCompact
      exact hc.elim_finite_subcover (fun y => (A j y : Set (V j))) (fun y => (A j y).isOpen)
        (fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hyA j ⟨z, hz⟩⟩)
    choose t ht using hfin
    let S : Type u := Σ j : ι, ↥(t j)
    haveI hSfin : Finite S := inferInstanceAs (Finite (Σ j : ι, ↥(t j)))
    let e : S ≃ Fin (Nat.card S) := Finite.equivFin S
    let idx : Fin (Nat.card S) → S := fun m => e.symm m
    have hrange : ∀ m, Set.range ((A (idx m).1 (idx m).2.1).ι ≫ v (idx m).1) ⊆ Set.range O.ι := by
      intro m
      rintro _ ⟨y, rfl⟩
      rw [Scheme.Opens.range_ι]
      show v (idx m).1 ((A (idx m).1 (idx m).2.1).ι y) ∈ O
      first
        | exact hAO _ _ _ y.2
        | (simp only [Scheme.Opens.ι_apply]; exact hAO _ _ _ y.2)
    let f : ∀ m, ((A (idx m).1 (idx m).2.1 : (V (idx m).1).Opens) : Scheme.{u}) ⟶
        (O : Scheme.{u}) := fun m =>
      IsOpenImmersion.lift O.ι ((A (idx m).1 (idx m).2.1).ι ≫ v (idx m).1) (hrange m)
    have hf : ∀ m, f m ≫ O.ι = (A (idx m).1 (idx m).2.1).ι ≫ v (idx m).1 := fun m =>
      IsOpenImmersion.lift_fac _ _ _
    have hcov' : ∀ z : U, z ∈ O →
        ∃ m y, ((A (idx m).1 (idx m).2.1).ι ≫ v (idx m).1) y = z := by
      intro z hz
      obtain ⟨j, y₀, hy₀⟩ := hcov z hz
      have hy₀O : y₀ ∈ ((v j ⁻¹ᵁ O : (V j).Opens) : Set (V j)) := by
        show v j y₀ ∈ O
        rw [hy₀]
        exact hz
      obtain ⟨y, hyt, hy₀A⟩ := Set.mem_iUnion₂.mp (ht j hy₀O)
      have hr : y₀ ∈ Set.range (A j y).ι := by
        rw [Scheme.Opens.range_ι]
        exact hy₀A
      obtain ⟨y', hy'⟩ := hr
      have key : ∀ s' : S, s' = (⟨j, ⟨y, hyt⟩⟩ : S) →
          ∃ y'' : ((A s'.1 s'.2.1 : (V s'.1).Opens) : Scheme.{u}),
            ((A s'.1 s'.2.1).ι ≫ v s'.1) y'' = z := by
        rintro _ rfl
        refine ⟨y', ?_⟩
        show v j ((A j y).ι y') = z
        rw [hy']
        exact hy₀
      exact ⟨e ⟨j, ⟨y, hyt⟩⟩, key _ (Equiv.symm_apply_apply _ _)⟩
    haveI hpost : MorphismProperty.HasOfPostcompProperty @Flat @IsOpenImmersion :=
      (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal (P := @Flat)
        (Q := @IsOpenImmersion)).2
        (fun X Y f hf => MorphismProperty.diagonal_iff.2
          (by have : IsOpenImmersion f := hf; infer_instance))
    refine ⟨Nat.card S, fun m => (A (idx m).1 (idx m).2.1 : Scheme.{u}), fun m => (idx m).1,
      fun m => (A (idx m).1 (idx m).2.1).ι,
      fun m => f m ≫ hO.isoSpec.hom, fun m => hA _ _, fun m => inferInstance, ?_, ?_, ?_, hcov'⟩
    · intro m
      haveI := hflat (idx m).1
      have h1 : Flat (f m ≫ O.ι) := by rw [hf m]; infer_instance
      have h2 : Flat (f m) := MorphismProperty.of_postcomp (W := @Flat) (W' := @IsOpenImmersion)
        _ O.ι inferInstance h1
      infer_instance
    · intro m
      show (f m ≫ hO.isoSpec.hom) ≫ hO.fromSpec = (A (idx m).1 (idx m).2.1).ι ≫ v (idx m).1
      rw [← hO.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc, hf m]
    · intro x
      obtain ⟨m, y, hy⟩ := hcov' (O.ι (hO.isoSpec.inv x)) (by
        have : O.ι (hO.isoSpec.inv x) ∈ Set.range O.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at this)
      refine ⟨m, y, ?_⟩
      have h1 : O.ι (f m y) = O.ι (hO.isoSpec.inv x) := by
        rw [← Scheme.Hom.comp_apply, hf m, hy]
      have h2 : f m y = hO.isoSpec.inv x := O.ι.isOpenEmbedding.injective h1
      show (f m ≫ hO.isoSpec.hom) y = x
      rw [Scheme.Hom.comp_apply, h2, ← Scheme.Hom.comp_apply, Iso.inv_hom_id]
      rfl

  have wc_fgas_pi_chart : ∀ (R : Type u) [CommRing R] (n : ℕ) (W : Fin n → Scheme.{u}) (φ : ∀ m, W m ⟶ Spec (.of R)), (∀ m, IsAffine (W m)) → (∀ m, Flat (φ m)) → (∀ x : Spec (.of R), ∃ m y, φ m y = x) → ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Module.Flat R R') (j : ∀ m, W m ⟶ Spec (.of R')), Function.Surjective (PrimeSpectrum.comap (algebraMap R R')) ∧ (∀ m, IsOpenImmersion (j m)) ∧ (∀ (m m' : Fin n) (y : W m) (y' : W m'), j m y = j m' y' → m = m') ∧ (∀ x : Spec (.of R'), ∃ m y, j m y = x) ∧ (∀ m, j m ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) = φ m) := by
    intro R _ n W φ haff hflat hcov
    classical
    let A : Fin n → Type u := fun i => Γ(W i, ⊤)
    letI hAring : ∀ i, CommRing (A i) := fun i => inferInstanceAs (CommRing Γ(W i, ⊤))
    let ρ : ∀ i, R →+* A i := fun i =>
      ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ Scheme.Hom.appTop (φ i)).hom
    have hρ : ∀ i, (ρ i).Flat := by
      intro i
      haveI := haff i
      have h1 : RingHom.Flat (Scheme.Hom.appTop (φ i)).hom :=
        HasRingHomProperty.appTop @Flat (φ i) (hflat i)
      have h2 : RingHom.Flat (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
        RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)
      change RingHom.Flat ((Scheme.Hom.appTop (φ i)).hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom)
      exact RingHom.Flat.comp h2 h1
    letI hAalg : ∀ i, Algebra R (A i) := fun i => (ρ i).toAlgebra
    haveI hAfl : ∀ i, Module.Flat R (A i) := fun i => RingHom.flat_algebraMap_iff.mp (hρ i)
    haveI hR'fl : Module.Flat R (∀ i, A i) :=
      Module.Flat.of_linearEquiv (DirectSum.linearEquivFunOnFintype R (Fin n) A).symm
    have hring : ∀ i, CommRingCat.ofHom (algebraMap R (∀ i, A i)) ≫
        CommRingCat.ofHom (Pi.evalRingHom A i) =
        (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ Scheme.Hom.appTop (φ i) := by
      intro i
      ext a
      rfl
    let j : ∀ i, W i ⟶ Spec (CommRingCat.of (∀ i, A i)) := fun i =>
      (@Scheme.isoSpec (W i) (haff i)).hom ≫ Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))
    have hkey : ∀ i, j i ≫ Spec.map (CommRingCat.ofHom (algebraMap R (∀ i, A i))) = φ i := by
      intro i
      have e1 : Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i)) ≫
          Spec.map (CommRingCat.ofHom (algebraMap R (∀ i, A i))) =
          Spec.map (Scheme.Hom.appTop (φ i)) ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of R)).inv := by
        rw [← Spec.map_comp, hring i, Spec.map_comp]
        try rfl
      have hn : (W i).toSpecΓ ≫ Spec.map (Scheme.Hom.appTop (φ i)) =
          φ i ≫ (Spec (CommRingCat.of R)).toSpecΓ :=
        (Scheme.toSpecΓ_naturality (φ i)).symm
      have hiso : (@Scheme.isoSpec (W i) (haff i)).hom = (W i).toSpecΓ :=
        @Scheme.isoSpec_hom (W i) (haff i)
      change ((@Scheme.isoSpec (W i) (haff i)).hom ≫
        Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (∀ i, A i))) = φ i
      rw [Category.assoc, e1, ← Category.assoc, hiso, hn]
      exact (Category.assoc _ _ _).trans ((congrArg (fun z => φ i ≫ z)
        (toSpecΓ_SpecMap_ΓSpecIso_inv (CommRingCat.of R))).trans (Category.comp_id _))
    have hopen : ∀ i, IsOpenImmersion (j i) := by
      intro i
      haveI := haff i
      show IsOpenImmersion ((W i).isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i)))
      infer_instance
    have hdisj : ∀ (i i' : Fin n) (a : W i) (b : W i'), j i a = j i' b → i = i' := by
      intro i i' a b hab
      by_contra hii'
      haveI := haff i
      haveI := haff i'
      have h1 : (Pi.single i (1 : A i) : ∀ l, A l) ∉
          @PrimeSpectrum.asIdeal (∀ l, A l) _ (j i a) := by
        intro h
        change (Pi.single i (1 : A i) : ∀ l, A l) i ∈
          @PrimeSpectrum.asIdeal (A i) _ ((W i).isoSpec.hom a) at h
        rw [Pi.single_eq_same] at h
        exact (PrimeSpectrum.isPrime _).ne_top ((Ideal.eq_top_iff_one _).mpr h)
      have h2 : (Pi.single i (1 : A i) : ∀ l, A l) ∈
          @PrimeSpectrum.asIdeal (∀ l, A l) _ (j i' b) := by
        change (Pi.single i (1 : A i) : ∀ l, A l) i' ∈
          @PrimeSpectrum.asIdeal (A i') _ ((W i').isoSpec.hom b)
        rw [Pi.single_eq_of_ne (Ne.symm hii')]
        exact Ideal.zero_mem _
      rw [← hab] at h2
      exact h1 h2
    have hcov' : ∀ x : Spec (CommRingCat.of (∀ i, A i)), ∃ i y, j i y = x := by
      intro x
      obtain ⟨⟨i, p⟩, hp⟩ := (PrimeSpectrum.sigmaToPi_bijective A).2
        (show PrimeSpectrum (∀ l, A l) from x)
      haveI := haff i
      refine ⟨i, (W i).isoSpec.inv p, ?_⟩
      have e1 := Scheme.Hom.comp_apply (W i).isoSpec.inv (W i).isoSpec.hom p
      rw [Iso.inv_hom_id] at e1
      change Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))
        ((W i).isoSpec.hom ((W i).isoSpec.inv p)) = x
      rw [← e1, ← hp, PrimeSpectrum.sigmaToPi_apply]
      rfl
    have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R (∀ i, A i))) := by
      intro P
      obtain ⟨i, v, hv⟩ := hcov P
      refine ⟨j i v, ?_⟩
      rw [← hv, ← hkey i, Scheme.Hom.comp_apply]
      rfl
    exact ⟨∀ i, A i, inferInstance, inferInstance, hR'fl, j, hsurj, hopen, hdisj, hcov', hkey⟩

  have wc_gas_lc_link : (∀ (S : Scheme.{u}) (K : Type) (Y : K → Scheme.{u}) (ε : ∀ k, Y k ⟶ S), (∀ k, IsOpenImmersion (ε k)) → (∀ (k k' : K) (y : Y k) (y' : Y k'), ε k y = ε k' y' → k = k') → (∀ s : S, ∃ k y, ε k y = s) → ∀ (T : Type) (f : ∀ k, Y k → T), (∀ k, IsLocallyConstant (f k)) → ∃ F : S → T, IsLocallyConstant F ∧ ∀ k (y : Y k), F (ε k y) = f k y) → ∀ (U : Scheme.{u}) (G : Type) (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → G), (∀ i j, IsLocallyConstant (g i j)) → ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (t : Spec (.of R) ⟶ U), Mono t → ∀ (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (j : ∀ m, W m ⟶ Spec (.of R')), (∀ m, IsOpenImmersion (j m)) → (∀ (m m' : Fin n) (y : W m) (y' : W m'), j m y = j m' y' → m = m') → (∀ x : Spec (.of R'), ∃ m y, j m y = x) → (∀ m, j m ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t = w m ≫ v (k m)) → ∃ lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) G, wcGLcLink v g R R' w j lc := by
    intro hglue U G ι V v g hgloc R R' _ _ _ t ht n W k w j hjopen hjdisj hjcov hj
    classical
    let α : Spec (.of R') ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom (algebraMap R R'))
    let ϕ : ∀ m, W m ⟶ Spec (.of R) := fun m => j m ≫ α
    let Iso := pullbackSpecIso R R' R'
    let K := Fin n × Fin n
    let Y : K → Scheme.{u} := fun p => Limits.pullback (ϕ p.1) (ϕ p.2)
    have c1 : ∀ m, ϕ m ≫ 𝟙 _ = j m ≫ α := fun m => Category.comp_id _
    let PM : ∀ p : K, Y p ⟶ Limits.pullback α α := fun p =>
      Limits.pullback.map (ϕ p.1) (ϕ p.2) α α (j p.1) (j p.2) (𝟙 _) (c1 p.1) (c1 p.2)
    let ε : ∀ p : K, Y p ⟶ Spec (.of (TensorProduct R R' R')) := fun p => PM p ≫ Iso.hom
    have hPMfst : ∀ p : K, PM p ≫ Limits.pullback.fst α α = Limits.pullback.fst _ _ ≫ j p.1 :=
      fun p => Limits.pullback.lift_fst _ _ _
    have hPMsnd : ∀ p : K, PM p ≫ Limits.pullback.snd α α = Limits.pullback.snd _ _ ≫ j p.2 :=
      fun p => Limits.pullback.lift_snd _ _ _
    have hεopen : ∀ p, IsOpenImmersion (ε p) := by
      intro p
      haveI := hjopen p.1
      haveI := hjopen p.2
      have : IsOpenImmersion (PM p) := Scheme.pullback_map_isOpenImmersion _ _ _ _ _ _ _ _ _
      infer_instance
    have hIsoinj : Function.Injective Iso.hom := Iso.hom.isOpenEmbedding.injective
    have hεdisj : ∀ (p p' : K) (y : Y p) (y' : Y p'), ε p y = ε p' y' → p = p' := by
      intro p p' y y' h
      have h0 : PM p y = PM p' y' := hIsoinj h
      have h1 : j p.1 (Limits.pullback.fst (ϕ p.1) (ϕ p.2) y) =
          j p'.1 (Limits.pullback.fst (ϕ p'.1) (ϕ p'.2) y') := by
        have := congrArg (fun z => Limits.pullback.fst α α z) h0
        simp only at this
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hPMfst, hPMfst,
          Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at this
        exact this
      have h2 : j p.2 (Limits.pullback.snd (ϕ p.1) (ϕ p.2) y) =
          j p'.2 (Limits.pullback.snd (ϕ p'.1) (ϕ p'.2) y') := by
        have := congrArg (fun z => Limits.pullback.snd α α z) h0
        simp only at this
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hPMsnd, hPMsnd,
          Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at this
        exact this
      exact Prod.ext (hjdisj _ _ _ _ h1) (hjdisj _ _ _ _ h2)
    have hεcov : ∀ s : Spec (.of (TensorProduct R R' R')), ∃ p y, ε p y = s := by
      intro s
      obtain ⟨m1, y1, hy1⟩ := hjcov (Limits.pullback.fst α α (Iso.inv s))
      obtain ⟨m2, y2, hy2⟩ := hjcov (Limits.pullback.snd α α (Iso.inv s))
      have hx : Iso.inv s ∈ Set.range (Limits.pullback.map (ϕ m1) (ϕ m2) α α (j m1) (j m2) (𝟙 _)
          (c1 m1) (c1 m2)) := by
        rw [Scheme.Pullback.range_map]
        exact ⟨⟨y1, hy1⟩, ⟨y2, hy2⟩⟩
      obtain ⟨y, hy⟩ := hx
      refine ⟨(m1, m2), y, ?_⟩
      show Iso.hom (Limits.pullback.map (ϕ m1) (ϕ m2) α α (j m1) (j m2) (𝟙 _)
          (c1 m1) (c1 m2) y) = s
      rw [hy, ← Scheme.Hom.comp_apply, Iso.inv_hom_id]
      rfl
    have e₁ : ∀ m, ϕ m ≫ t = w m ≫ v (k m) := fun m => by
      simp only [ϕ, α, Category.assoc]; exact hj m
    let Ψ : ∀ p : K, Y p ⟶ Limits.pullback (v (k p.1)) (v (k p.2)) := fun p =>
      Limits.pullback.map (ϕ p.1) (ϕ p.2) (v (k p.1)) (v (k p.2)) (w p.1) (w p.2) t (e₁ p.1) (e₁ p.2)
    let f : ∀ p : K, Y p → G := fun p y => g (k p.1) (k p.2) (Ψ p y)
    have hf : ∀ p, IsLocallyConstant (f p) := fun p =>
      (hgloc _ _).comp_continuous (Ψ p).continuous
    obtain ⟨F, hF, hFε⟩ := hglue _ K Y ε hεopen hεdisj hεcov G f hf
    refine ⟨⟨F, hF⟩, ?_⟩
    intro m m' Z a b hab wz hw1 hw2 ζ
    have hab' : a ≫ ϕ m = b ≫ ϕ m' := by
      apply (cancel_mono t).1
      simp only [Category.assoc]
      rw [e₁ m, e₁ m']
      simpa only [Category.assoc] using hab
    let lP : Z ⟶ Y (m, m') := Limits.pullback.lift a b hab'
    have hlP1 : lP ≫ Limits.pullback.fst (ϕ m) (ϕ m') = a := Limits.pullback.lift_fst _ _ _
    have hlP2 : lP ≫ Limits.pullback.snd (ϕ m) (ϕ m') = b := Limits.pullback.lift_snd _ _ _
    have hIfst : Iso.inv ≫ Limits.pullback.fst α α = Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) := by
      rw [Iso.inv_comp_eq]
      exact (pullbackSpecIso_hom_fst R R' R').symm
    have hIsnd : Iso.inv ≫ Limits.pullback.snd α α = Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) := by
      rw [Iso.inv_comp_eq]
      exact (pullbackSpecIso_hom_snd R R' R').symm
    have hwz : wz = lP ≫ ε (m, m') := by
      rw [← cancel_mono Iso.inv]
      apply Limits.pullback.hom_ext
      · calc (wz ≫ Iso.inv) ≫ Limits.pullback.fst α α
              = wz ≫ (Iso.inv ≫ Limits.pullback.fst α α) := Category.assoc _ _ _
          _ = a ≫ j m := by rw [hIfst, hw1]
          _ = lP ≫ Limits.pullback.fst (ϕ m) (ϕ m') ≫ j m := by rw [reassoc_of% hlP1]
          _ = lP ≫ PM (m, m') ≫ Limits.pullback.fst α α := by rw [hPMfst]
          _ = ((lP ≫ ε (m, m')) ≫ Iso.inv) ≫ Limits.pullback.fst α α := by
              simp only [ε, Category.assoc, Iso.hom_inv_id_assoc]
      · calc (wz ≫ Iso.inv) ≫ Limits.pullback.snd α α
              = wz ≫ (Iso.inv ≫ Limits.pullback.snd α α) := Category.assoc _ _ _
          _ = b ≫ j m' := by rw [hIsnd, hw2]
          _ = lP ≫ Limits.pullback.snd (ϕ m) (ϕ m') ≫ j m' := by rw [reassoc_of% hlP2]
          _ = lP ≫ PM (m, m') ≫ Limits.pullback.snd α α := by rw [hPMsnd]
          _ = ((lP ≫ ε (m, m')) ≫ Iso.inv) ≫ Limits.pullback.snd α α := by
              simp only [ε, Category.assoc, Iso.hom_inv_id_assoc]
    have hlΨ : lP ≫ Ψ (m, m') = Limits.pullback.lift (a ≫ w m) (b ≫ w m') hab := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc]
        have : Ψ (m, m') ≫ Limits.pullback.fst _ _ = Limits.pullback.fst (ϕ m) (ϕ m') ≫ w m :=
          Limits.pullback.lift_fst _ _ _
        rw [this, reassoc_of% hlP1]
      · rw [Limits.pullback.lift_snd, Category.assoc]
        have : Ψ (m, m') ≫ Limits.pullback.snd _ _ = Limits.pullback.snd (ϕ m) (ϕ m') ≫ w m' :=
          Limits.pullback.lift_snd _ _ _
        rw [this, reassoc_of% hlP2]
    show F (wz ζ) = _
    rw [hwz, Scheme.Hom.comp_apply, hFε]
    show g (k m) (k m') (Ψ (m, m') (lP ζ)) = _
    rw [← Scheme.Hom.comp_apply, hlΨ]

  have wc_gas_lc_cocycle : ∀ (U : Scheme.{u}) (G : Type) [Group G] (ι : Type) (V : ι → Scheme.{u}) (v : ∀ j, V j ⟶ U) (g : ∀ i j, ↥(Limits.pullback (v i) (v j)) → G), wcGCocycle v g → ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (t : Spec (.of R) ⟶ U) (n : ℕ) (W : Fin n → Scheme.{u}) (k : Fin n → ι) (w : ∀ m, W m ⟶ V (k m)) (j : ∀ m, W m ⟶ Spec (.of R')), (∀ m, IsOpenImmersion (j m)) → (∀ x : Spec (.of R'), ∃ m y, j m y = x) → (∀ m, j m ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t = w m ≫ v (k m)) → ∀ lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) G, wcGLcLink v g R R' w j lc → wcGLcCoc R R' G lc := by
    intro U G _ ι V v g hG R R' _ _ _ t n W k w j hjopen hjcov hj lc hlink P
    classical
    set p12 : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R') :=
      (Algebra.TensorProduct.map (AlgHom.id R R')
        (Algebra.TensorProduct.includeLeft : R' →ₐ[R] TensorProduct R R' R')).toRingHom with hp12
    set p13 : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R') :=
      (Algebra.TensorProduct.map (AlgHom.id R R')
        (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R')).toRingHom with hp13
    set p23 : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R') :=
      (Algebra.TensorProduct.includeRight :
        TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')).toRingHom with hp23
    let q1a : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
      Algebra.TensorProduct.includeLeft
    let q2a : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
      (Algebra.TensorProduct.includeRight :
        TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')).comp
        Algebra.TensorProduct.includeLeft
    let q3a : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
      (Algebra.TensorProduct.includeRight :
        TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')).comp
        Algebra.TensorProduct.includeRight
    have r12L : p12.comp (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R') =
        q1a.toRingHom := by
      ext x; simp [hp12, q1a]
    have r12R : p12.comp (Algebra.TensorProduct.includeRight :
        R' →ₐ[R] TensorProduct R R' R').toRingHom = q2a.toRingHom := by
      ext x; simp [hp12, q2a]
    have r13L : p13.comp (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R') =
        q1a.toRingHom := by
      ext x; simp [hp13, q1a]
    have r13R : p13.comp (Algebra.TensorProduct.includeRight :
        R' →ₐ[R] TensorProduct R R' R').toRingHom = q3a.toRingHom := by
      ext x; simp [hp13, q3a]
    have r23L : p23.comp (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R') =
        q2a.toRingHom := by
      ext x; simp [hp23, q2a]
    have r23R : p23.comp (Algebra.TensorProduct.includeRight :
        R' →ₐ[R] TensorProduct R R' R').toRingHom = q3a.toRingHom := by
      ext x; simp [hp23, q3a]
    have hS : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
        (g : B →+* C), Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
          Spec.map (CommRingCat.ofHom (g.comp f)) := by
      intro A B C _ _ _ f g
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hq : ∀ qa : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R'),
        Spec.map (CommRingCat.ofHom qa.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) =
          Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct R R' (TensorProduct R R' R')))) := by
      intro qa
      rw [hS, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]
    haveI := hjopen
    obtain ⟨m1, y1, hy1⟩ := hjcov (Spec.map (CommRingCat.ofHom q1a.toRingHom) P)
    obtain ⟨m2, y2, hy2⟩ := hjcov (Spec.map (CommRingCat.ofHom q2a.toRingHom) P)
    obtain ⟨m3, y3, hy3⟩ := hjcov (Spec.map (CommRingCat.ofHom q3a.toRingHom) P)
    haveI := hjopen m1
    haveI := hjopen m2
    haveI := hjopen m3
    let Uo : (Spec (.of (TensorProduct R R' (TensorProduct R R' R')))).Opens :=
      Spec.map (CommRingCat.ofHom q1a.toRingHom) ⁻¹ᵁ (j m1).opensRange ⊓
        Spec.map (CommRingCat.ofHom q2a.toRingHom) ⁻¹ᵁ (j m2).opensRange ⊓
        Spec.map (CommRingCat.ofHom q3a.toRingHom) ⁻¹ᵁ (j m3).opensRange
    have hUo : ∀ x, x ∈ Uo →
        (Spec.map (CommRingCat.ofHom q1a.toRingHom) x ∈ Set.range (j m1) ∧
          Spec.map (CommRingCat.ofHom q2a.toRingHom) x ∈ Set.range (j m2)) ∧
        Spec.map (CommRingCat.ofHom q3a.toRingHom) x ∈ Set.range (j m3) := fun x hx => hx
    have hP : (P : Spec (.of (TensorProduct R R' (TensorProduct R R' R')))) ∈ Uo :=
      show (Spec.map (CommRingCat.ofHom q1a.toRingHom) P ∈ Set.range (j m1) ∧
          Spec.map (CommRingCat.ofHom q2a.toRingHom) P ∈ Set.range (j m2)) ∧
        Spec.map (CommRingCat.ofHom q3a.toRingHom) P ∈ Set.range (j m3) from
        ⟨⟨⟨y1, hy1⟩, ⟨y2, hy2⟩⟩, ⟨y3, hy3⟩⟩
    have hr : ∀ (q : Spec (.of (TensorProduct R R' (TensorProduct R R' R'))) ⟶ Spec (.of R'))
        (m : Fin n), (∀ x, x ∈ Uo → q x ∈ Set.range (j m)) →
        Set.range (Uo.ι ≫ q) ⊆ Set.range (j m) := by
      intro q m h
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact h _ z.2
    let a1 := IsOpenImmersion.lift (j m1) (Uo.ι ≫ Spec.map (CommRingCat.ofHom q1a.toRingHom))
      (hr _ m1 (fun x hx => (hUo x hx).1.1))
    let a2 := IsOpenImmersion.lift (j m2) (Uo.ι ≫ Spec.map (CommRingCat.ofHom q2a.toRingHom))
      (hr _ m2 (fun x hx => (hUo x hx).1.2))
    let a3 := IsOpenImmersion.lift (j m3) (Uo.ι ≫ Spec.map (CommRingCat.ofHom q3a.toRingHom))
      (hr _ m3 (fun x hx => (hUo x hx).2))
    have ha1 : a1 ≫ j m1 = Uo.ι ≫ Spec.map (CommRingCat.ofHom q1a.toRingHom) :=
      IsOpenImmersion.lift_fac _ _ _
    have ha2 : a2 ≫ j m2 = Uo.ι ≫ Spec.map (CommRingCat.ofHom q2a.toRingHom) :=
      IsOpenImmersion.lift_fac _ _ _
    have ha3 : a3 ≫ j m3 = Uo.ι ≫ Spec.map (CommRingCat.ofHom q3a.toRingHom) :=
      IsOpenImmersion.lift_fac _ _ _
    have hD : ∀ (m : Fin n) (a : (Uo : Scheme.{u}) ⟶ W m)
        (qa : R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')),
        a ≫ j m = Uo.ι ≫ Spec.map (CommRingCat.ofHom qa.toRingHom) →
        (a ≫ w m) ≫ v (k m) = Uo.ι ≫ Spec.map (CommRingCat.ofHom
          (algebraMap R (TensorProduct R R' (TensorProduct R R' R')))) ≫ t := by
      intro m a qa ha
      rw [Category.assoc, ← hj m, ← Category.assoc, ha]
      simp only [Category.assoc]
      rw [reassoc_of% (hq qa)]
    have hab12 := (hD m1 a1 q1a ha1).trans (hD m2 a2 q2a ha2).symm
    have hab13 := (hD m1 a1 q1a ha1).trans (hD m3 a3 q3a ha3).symm
    have hab23 := (hD m2 a2 q2a ha2).trans (hD m3 a3 q3a ha3).symm
    let ζ : (Uo : Scheme.{u}) := ⟨P, hP⟩
    have hev : ∀ f : TensorProduct R R' R' →+* TensorProduct R R' (TensorProduct R R' R'),
        (Uo.ι ≫ Spec.map (CommRingCat.ofHom f)) ζ = PrimeSpectrum.comap f P := by
      intro f
      rw [Scheme.Hom.comp_apply, Spec.map_apply]
      rfl
    have hL12 := hlink m1 m2 Uo a1 a2 hab12 (Uo.ι ≫ Spec.map (CommRingCat.ofHom p12))
      (by rw [Category.assoc, hS, r12L, ha1]) (by rw [Category.assoc, hS, r12R, ha2]) ζ
    have hL13 := hlink m1 m3 Uo a1 a3 hab13 (Uo.ι ≫ Spec.map (CommRingCat.ofHom p13))
      (by rw [Category.assoc, hS, r13L, ha1]) (by rw [Category.assoc, hS, r13R, ha3]) ζ
    have hL23 := hlink m2 m3 Uo a2 a3 hab23 (Uo.ι ≫ Spec.map (CommRingCat.ofHom p23))
      (by rw [Category.assoc, hS, r23L, ha2]) (by rw [Category.assoc, hS, r23R, ha3]) ζ
    have c := hG (k m1) (k m2) (k m3) Uo (a1 ≫ w m1) (a2 ≫ w m2) (a3 ≫ w m3) hab12 hab23 hab13 ζ
    rw [hev] at hL12 hL13 hL23
    rw [hL12, hL13, hL23]
    exact c

  have wc_gas_idem_cocycle : ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (G : Type) [Group G] [Fintype G] (lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) G), wcGLcCoc R R' G lc → ∃ e : G → TensorProduct R R' R', wcGTorDescCocyc R R' G e ∧ ∀ (c : G) (P : PrimeSpectrum (TensorProduct R R' R')), e c ∉ P.asIdeal ↔ lc P = c := by
    intro R R' _ _ _ G _ _ lc hcoc
    classical
    have s1 : ∀ (A : Type u) [CommRing A] (x y : A), IsIdempotentElem x → IsIdempotentElem y →
        (∀ P : PrimeSpectrum A, x ∉ P.asIdeal ↔ y ∉ P.asIdeal) → x = y := by
      intro A _ x y hx hy H
      have key : ∀ x y : A, IsIdempotentElem x → IsIdempotentElem y →
          (∀ P : PrimeSpectrum A, x ∉ P.asIdeal → y ∉ P.asIdeal) → x * (1 - y) = 0 := by
        intro x y hx hy H
        apply IsIdempotentElem.eq_zero_of_isNilpotent (hx.mul hy.one_sub)
        rw [nilpotent_iff_mem_prime]
        intro J hJ
        by_cases hxJ : x ∈ J
        · exact J.mul_mem_right _ hxJ
        · have hyJ : y ∉ J := H ⟨J, hJ⟩ hxJ
          have h0 : y * (1 - y) ∈ J := by
            rw [mul_sub, mul_one, hy.eq, sub_self]; exact J.zero_mem
          rcases hJ.mem_or_mem h0 with h | h
          · exact absurd h hyJ
          · exact J.mul_mem_left _ h
      have h1 := key x y hx hy (fun P => (H P).1)
      have h2 := key y x hy hx (fun P => (H P).2)
      have e1 : x = x * y := by rw [mul_sub, mul_one, sub_eq_zero] at h1; exact h1
      have e2 : y = y * x := by rw [mul_sub, mul_one, sub_eq_zero] at h2; exact h2
      calc x = x * y := e1
        _ = y * x := mul_comm _ _
        _ = y := e2.symm
    have s2 : ∀ (A : Type u) [CommRing A] (x : G → A),
        (∀ a b, a ≠ b → x a * x b = 0) → ∀ P : PrimeSpectrum A,
        ((∑ a, x a) ∉ P.asIdeal ↔ ∃ a, x a ∉ P.asIdeal) := by
      intro A _ x hx P
      constructor
      · intro h
        by_contra hc
        push_neg at hc
        exact h (Ideal.sum_mem _ (fun a _ => hc a))
      · rintro ⟨a0, ha0⟩ hs
        apply ha0
        have h1 : x a0 * ∑ a, x a = x a0 * x a0 := by
          rw [Finset.mul_sum, Fintype.sum_eq_single a0]
          intro a ha
          exact hx a0 a (Ne.symm ha)
        have h2 : x a0 * x a0 ∈ P.asIdeal := by
          rw [← h1]; exact P.asIdeal.mul_mem_left _ hs
        rcases P.isPrime.mem_or_mem h2 with h | h <;> exact h
    have s4 : ∀ (A : Type u) [CommRing A] (x : G → A), (∀ a, IsIdempotentElem (x a)) →
        (∀ a b, a ≠ b → x a * x b = 0) → IsIdempotentElem (∑ a, x a) := by
      intro A _ x hi ho
      exact (OrthogonalIdempotents.mk hi (fun a b hab => ho a b hab)).isIdempotentElem_sum
    have s3 : ∀ c : G, ∃ x : TensorProduct R R' R', IsIdempotentElem x ∧
        ∀ P : PrimeSpectrum (TensorProduct R R' R'), x ∉ P.asIdeal ↔ lc P = c := by
      intro c
      have hS : IsClopen {P | lc P = c} := lc.isLocallyConstant.isClopen_fiber c
      let C : TopologicalSpace.Clopens (PrimeSpectrum (TensorProduct R R' R')) := ⟨_, hS⟩
      let E := PrimeSpectrum.isIdempotentElemEquivClopens.symm C
      refine ⟨E.1, E.2, fun P => ?_⟩
      have h1 : (PrimeSpectrum.isIdempotentElemEquivClopens E).toOpens =
          PrimeSpectrum.basicOpen E.1 :=
        PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens E
      have h2 : PrimeSpectrum.isIdempotentElemEquivClopens E = C := OrderIso.apply_symm_apply _ _
      rw [h2] at h1
      have h3 : P ∈ C.toOpens ↔ P ∈ PrimeSpectrum.basicOpen E.1 := by rw [h1]
      rw [PrimeSpectrum.mem_basicOpen] at h3
      exact h3.symm
    choose e he hmem using s3
    have hortho : ∀ c c', c ≠ c' → e c * e c' = 0 := by
      intro c c' hcc'
      apply s1 _ _ _ ((he c).mul (he c')) IsIdempotentElem.zero
      intro P
      constructor
      · intro h
        exfalso
        have hc : e c ∉ P.asIdeal := fun h' => h (P.asIdeal.mul_mem_right _ h')
        have hc' : e c' ∉ P.asIdeal := fun h' => h (P.asIdeal.mul_mem_left _ h')
        exact hcc' (((hmem c P).1 hc).symm.trans ((hmem c' P).1 hc'))
      · intro h
        exact absurd P.asIdeal.zero_mem h
    have hsum : ∑ c, e c = 1 := by
      apply s1 _ _ _ (s4 _ e he hortho) IsIdempotentElem.one
      intro P
      constructor
      · intro _ h
        exact P.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h)
      · intro _
        exact (s2 _ e hortho P).2 ⟨lc P, (hmem (lc P) P).2 rfl⟩
    have gen : ∀ (φ13 φ12 φ23 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')),
        (∀ P : PrimeSpectrum (TensorProduct R R' (TensorProduct R R' R')),
          lc (PrimeSpectrum.comap φ13.toRingHom P) =
            lc (PrimeSpectrum.comap φ12.toRingHom P) * lc (PrimeSpectrum.comap φ23.toRingHom P)) →
        ∀ c, φ13 (e c) = ∑ a, φ12 (e a) * φ23 (e (a⁻¹ * c)) := by
      intro φ13 φ12 φ23 H c
      have ht_idem : ∀ a, IsIdempotentElem (φ12 (e a) * φ23 (e (a⁻¹ * c))) :=
        fun a => ((he a).map φ12).mul ((he (a⁻¹ * c)).map φ23)
      have ht_orth : ∀ a b, a ≠ b →
          (φ12 (e a) * φ23 (e (a⁻¹ * c))) * (φ12 (e b) * φ23 (e (b⁻¹ * c))) = 0 := by
        intro a b hab
        rw [mul_mul_mul_comm, ← map_mul, hortho a b hab, map_zero, zero_mul]
      apply s1 _ _ _ ((he c).map φ13)
        (s4 _ (fun a => φ12 (e a) * φ23 (e (a⁻¹ * c))) ht_idem ht_orth)
      intro P
      have hprod : ∀ a, φ12 (e a) * φ23 (e (a⁻¹ * c)) ∉ P.asIdeal ↔
          (lc (PrimeSpectrum.comap φ12.toRingHom P) = a ∧
            lc (PrimeSpectrum.comap φ23.toRingHom P) = a⁻¹ * c) := by
        intro a
        constructor
        · intro h
          exact ⟨(hmem a (PrimeSpectrum.comap φ12.toRingHom P)).1
              (fun h' => h (P.asIdeal.mul_mem_right _ h')),
            (hmem (a⁻¹ * c) (PrimeSpectrum.comap φ23.toRingHom P)).1
              (fun h' => h (P.asIdeal.mul_mem_left _ h'))⟩
        · rintro ⟨h1, h2⟩ h
          have g1 : φ12 (e a) ∉ P.asIdeal := (hmem a (PrimeSpectrum.comap φ12.toRingHom P)).2 h1
          have g2 : φ23 (e (a⁻¹ * c)) ∉ P.asIdeal :=
            (hmem (a⁻¹ * c) (PrimeSpectrum.comap φ23.toRingHom P)).2 h2
          rcases P.isPrime.mem_or_mem h with h' | h'
          · exact g1 h'
          · exact g2 h'
      refine Iff.trans ?_ (s2 _ (fun a => φ12 (e a) * φ23 (e (a⁻¹ * c))) ht_orth P).symm
      refine Iff.trans (hmem c (PrimeSpectrum.comap φ13.toRingHom P)) ?_
      rw [H P]
      constructor
      · intro h
        exact ⟨lc (PrimeSpectrum.comap φ12.toRingHom P), (hprod _).2 ⟨rfl, eq_inv_mul_of_mul_eq h⟩⟩
      · rintro ⟨a, ha⟩
        obtain ⟨h1, h2⟩ := (hprod a).1 ha
        rw [h1, h2, mul_inv_cancel_left]
    exact ⟨e, ⟨he, hortho, hsum, fun c => gen _ _ _ hcoc c⟩, hmem⟩

  have wc_gas_copies_cover : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B] [Algebra R R'] [Algebra R B] (G : Type) [Finite G] (ι : B →ₐ[R] (G → R')), Function.Surjective (PrimeSpectrum.comap (algebraMap R R')) → Function.Bijective (wcGTorDescL R R' G B ι) → ∀ P : Spec (.of B), ∃ (γ : G) (Q : Spec (.of R')), Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ).comp ι.toRingHom)) Q = P := by
    intro R R' B _ _ _ _ _ G _ ι hsurj hbij P
    classical
    obtain ⟨x₀, hx⟩ := hsurj (PrimeSpectrum.comap (algebraMap R B) P)
    let x : Spec (.of R') := x₀
    have hx' : (Spec.map (CommRingCat.ofHom (algebraMap R R'))) x =
        (Spec.map (CommRingCat.ofHom (algebraMap R B))) P := by
      rw [Spec.map_apply, Spec.map_apply]
      exact hx
    obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback x P hx'
    let Q' : Spec (.of (TensorProduct R R' B)) := (pullbackSpecIso R R' B).hom z
    have hE1 : (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R R' B).toRingHom)) Q' = P := by
      rw [← hz, ← pullbackSpecIso_hom_snd R R' B, Scheme.Hom.comp_apply]
      rfl
    have hP : ∀ b : B, b ∈ P.asIdeal ↔ ((1 : R') ⊗ₜ[R] b) ∈ Q'.asIdeal := by
      intro b
      rw [← hE1, Spec.map_apply]
      rfl
    let e := RingEquiv.ofBijective (wcGTorDescL R R' G B ι) hbij
    have hL : ∀ b : B, wcGTorDescL R R' G B ι ((1 : R') ⊗ₜ[R] b) = ι b := by
      intro b
      simp only [wcGTorDescL, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    have he : ∀ b : B, e.symm (ι b) = (1 : R') ⊗ₜ[R] b := by
      intro b
      rw [RingEquiv.symm_apply_eq]
      exact (hL b).symm
    obtain ⟨h, Q, hQ⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq (R := fun _ : G => R')
      (PrimeSpectrum.comap (e.symm : (G → R') →+* TensorProduct R R' B) Q')
    let Q₁ : Spec (.of R') := Q
    refine ⟨h, Q₁, ?_⟩
    rw [Spec.map_apply]
    apply PrimeSpectrum.ext
    ext b
    rw [hP b, ← he b]
    have key : (ι b) ∈ (PrimeSpectrum.comap (e.symm : (G → R') →+* TensorProduct R R' B)
        Q').asIdeal ↔ ι b h ∈ Q.asIdeal := by
      rw [← hQ]
      rfl
    exact key.symm

  have wc_gas_overlap_unit : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B] [Algebra R R'] [Algebra R B] (G : Type) [Group G] [Fintype G] (e : G → TensorProduct R R' R') (ι : B →ₐ[R] (G → R')), (∀ b, wcGTorDescCond R R' G e (ι b)) → Function.Surjective (wcGTorDescL R R' G B ι) → ∀ (Z : Scheme.{u}) (z1 z2 : Z ⟶ Spec (.of R')) (wz : Z ⟶ Spec (.of (TensorProduct R R' R'))), wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) = z1 → wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) = z2 → ∀ γ γ' : G, z1 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ).comp ι.toRingHom)) = z2 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ').comp ι.toRingHom)) → ∀ ζ : Z, e (γ⁻¹ * γ') ∉ @PrimeSpectrum.asIdeal (TensorProduct R R' R') _ (wz ζ) := by
    intro R R' B _ _ _ _ _ G _ _ e ι hDC hL Z z1 z2 w hw1 hw2 h1 h2 hz
    classical
    have hN : ∀ {C D : CommRingCat.{u}} (f : C ⟶ D) (v : Z ⟶ Spec D),
        (Scheme.ΓSpecIso C).inv ≫ (v ≫ Spec.map f).appTop =
          f ≫ (Scheme.ΓSpecIso D).inv ≫ v.appTop := by
      intro C D f v
      rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
        Category.assoc]
    let φ : TensorProduct R R' R' →+* Γ(Z, ⊤) :=
      ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv ≫ w.appTop).hom
    let ψ1 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z1.appTop).hom
    let ψ2 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z2.appTop).hom
    have hψ1 : ∀ x : R', φ (x ⊗ₜ[R] 1) = ψ1 x := by
      intro x
      have e := hN (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) w
      rw [hw1] at e
      exact (congrArg (fun k => k.hom x) e).symm
    have hψ2 : ∀ y : R', φ ((1 : R') ⊗ₜ[R] y) = ψ2 y := by
      intro y
      have e := hN (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) w
      rw [hw2] at e
      exact (congrArg (fun k => k.hom y) e).symm
    have hφ : ∀ x y : R', φ (x ⊗ₜ[R] y) = ψ1 x * ψ2 y := by
      intro x y
      have : x ⊗ₜ[R] y = (x ⊗ₜ[R] (1 : R')) * ((1 : R') ⊗ₜ[R] y) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [this, map_mul, hψ1, hψ2]
    have hψ : ∀ b : B, ψ1 (ι b h1) = ψ2 (ι b h2) := by
      intro b
      have e1 := hN (CommRingCat.ofHom
        ((Pi.evalRingHom (fun _ : G => R') h1).comp ι.toRingHom)) z1
      have e2 := hN (CommRingCat.ofHom
        ((Pi.evalRingHom (fun _ : G => R') h2).comp ι.toRingHom)) z2
      rw [hz, e2] at e1
      exact (congrArg (fun k => k.hom b) e1).symm
    have hLt : ∀ (r : R') (b : B) (h : G), wcGTorDescL R R' G B ι (r ⊗ₜ[R] b) h = r * ι b h := by
      intro r b h
      simp [wcGTorDescL, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply]
    have hK : ∀ y : TensorProduct R R' B,
        φ (∑ d, e d * ((wcGTorDescL R R' G B ι y) (h2 * d⁻¹) ⊗ₜ[R] (1 : R'))) =
          ψ1 ((wcGTorDescL R R' G B ι y) h1) := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul r b =>
        simp only [hLt]
        have e : ∑ d, e d * ((r * ι b (h2 * d⁻¹)) ⊗ₜ[R] (1 : R')) =
            (r ⊗ₜ[R] (1 : R')) * ∑ d, e d * (ι b (h2 * d⁻¹) ⊗ₜ[R] (1 : R')) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun d _ => ?_
          rw [show (r * ι b (h2 * d⁻¹)) ⊗ₜ[R] (1 : R') =
              (r ⊗ₜ[R] (1 : R')) * (ι b (h2 * d⁻¹) ⊗ₜ[R] (1 : R')) by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]]
          ring
        rw [e, ← hDC b h2, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, hφ, ← hψ,
          map_mul]
      | add y1 y2 ih1 ih2 =>
        simp only [map_add, Pi.add_apply, TensorProduct.add_tmul, mul_add,
          Finset.sum_add_distrib]
        rw [ih1, ih2]
    have hone : φ (e (h1⁻¹ * h2)) = 1 := by
      obtain ⟨y, hy⟩ := hL (Pi.single h1 1)
      have e' := hK y
      rw [hy, Pi.single_eq_same, map_one] at e'
      rw [← e']
      congr 1
      rw [Finset.sum_eq_single (h1⁻¹ * h2)]
      · rw [show h2 * (h1⁻¹ * h2)⁻¹ = h1 by group, Pi.single_eq_same,
          ← Algebra.TensorProduct.one_def, mul_one]
      · intro d _ hd
        have hne : h2 * d⁻¹ ≠ h1 := by
          intro hc
          apply hd
          rw [← hc]
          group
        rw [Pi.single_eq_of_ne hne, TensorProduct.zero_tmul, mul_zero]
      · intro hc
        exact absurd (Finset.mem_univ _) hc
    have hunit : IsUnit ((Scheme.Hom.app w ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
        (e (h1⁻¹ * h2)))) := by
      have : (Scheme.Hom.app w ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
          (e (h1⁻¹ * h2))) = φ (e (h1⁻¹ * h2)) := rfl
      rw [this, hone]
      exact isUnit_one
    intro ζ
    have hpre := Scheme.Hom.preimage_basicOpen w (U := ⊤)
      ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e (h1⁻¹ * h2)))
    have hmem : ζ ∈ w ⁻¹ᵁ (Spec (.of (TensorProduct R R' R'))).basicOpen
        ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (e (h1⁻¹ * h2))) := by
      rw [hpre, Scheme.basicOpen_of_isUnit _ hunit]
      trivial
    rw [Scheme.Hom.mem_preimage, basicOpen_eq_of_affine] at hmem
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hmem

  have wc_gas_copies_agree : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B] [Algebra R R'] [Algebra R B] (G : Type) [Group G] [Fintype G] (e : G → TensorProduct R R' R') (ι : B →ₐ[R] (G → R')), (∀ c, IsIdempotentElem (e c)) → (∀ c c', c ≠ c' → e c * e c' = 0) → (∀ b, wcGTorDescCond R R' G e (ι b)) → ∀ (Z : Scheme.{u}) (z1 z2 : Z ⟶ Spec (.of R')) (wz : Z ⟶ Spec (.of (TensorProduct R R' R'))), wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) = z1 → wz ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) = z2 → ∀ γ γ' : G, (∀ ζ : Z, e (γ⁻¹ * γ') ∉ @PrimeSpectrum.asIdeal (TensorProduct R R' R') _ (wz ζ)) → z1 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ).comp ι.toRingHom)) = z2 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : G => R') γ').comp ι.toRingHom)) := by
    intro R R' B _ _ _ _ _ G _ _ e ι hidem horth hDC Z z1 z2 w hw1 hw2 h1 h2 hnot
    classical
    have hN : ∀ {C D : CommRingCat.{u}} (f : C ⟶ D) (v : Z ⟶ Spec D),
