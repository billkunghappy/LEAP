            (Functor.whiskerLeft (wcEtSlice T).op f.hom) :=
          NatTrans.ext (funext fun V => (f.hom.naturality (c.app V.unop).op).symm)
        rw [← Category.assoc, key, Category.assoc]
        exact congrArg (fun k => α G ≫ k)
          (toSheafify_naturality (Scheme.smallEtaleTopology X) _) }
  refine ⟨η, fun G V hV => ?_⟩
  have := hc V hV
  have : IsIso (toSheafify (Scheme.smallEtaleTopology X)
      ((wcEtBaseChange T.hom).op ⋙ (R.obj G).obj)) :=
    isIso_toSheafify (Scheme.smallEtaleTopology X) (hsh G)
  have : IsIso ((α G).app (Opposite.op V)) := by
    show IsIso (G.obj.map (c.app V).op)
    infer_instance
  show IsIso ((α G).app (Opposite.op V) ≫ (toSheafify (Scheme.smallEtaleTopology X)
      ((wcEtBaseChange T.hom).op ⋙ (R.obj G).obj)).app (Opposite.op V))
  infer_instance

theorem wc_et_stalk_homology_isIso_of_nbhd : ∀ (B : Scheme.{u}) (y : B), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)) → ∀ (N : B.Opens), y ∈ N → ∀ (K₁ K₂ : CochainComplex (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ℕ) (θ : K₁ ⟶ K₂) (p : ℕ), (∀ V : B.Etale, (∀ x : V.left, V.hom x ∈ N) → IsIso (HomologicalComplex.homologyMap (((sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⋙ (evaluation (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)).mapHomologicalComplex (ComplexShape.up ℕ)).map θ) p)) → IsIso (HomologicalComplex.homologyMap (((wcEtStalk B y).mapHomologicalComplex (ComplexShape.up ℕ)).map θ) p) :=
by
  intro B y hcof N hyN K₁ K₂ θ p hV
  have key : ∀ {X : Scheme.{u}} (f : X ⟶ B) (x : ((f ⁻¹ᵁ N : X.Opens) : Scheme.{u})),
      ((f ⁻¹ᵁ N).ι ≫ f) x ∈ N := by
    intro X f x
    have h : (f ⁻¹ᵁ N).ι x ∈ (f ⁻¹ᵁ N : X.Opens) := by
      have hr := Scheme.Opens.range_ι (f ⁻¹ᵁ N)
      have h2 : (f ⁻¹ᵁ N).ι x ∈ Set.range (f ⁻¹ᵁ N).ι := ⟨x, rfl⟩
      rw [hr] at h2
      exact h2
    rw [Scheme.Hom.comp_apply]
    exact h
  haveI := hcof

  have L1 : ∀ (P : ObjectProperty (StructuredArrow (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B))),
      (∀ X, ∃ Y, P Y ∧ Nonempty (Y ⟶ X)) → IsCofiltered P.FullSubcategory ∧ P.ι.Initial := by
    intro P hP
    have h1 : IsCofilteredOrEmpty P.FullSubcategory := by
      refine IsCofilteredOrEmpty.mk ?_ ?_
      · intro a b
        obtain ⟨Y, hY, ⟨k⟩⟩ := hP (IsCofiltered.min a.obj b.obj)
        exact ⟨⟨Y, hY⟩, P.ι.preimage (k ≫ IsCofiltered.minToLeft _ _),
          P.ι.preimage (k ≫ IsCofiltered.minToRight _ _), trivial⟩
      · intro a b f g
        obtain ⟨Y, hY, ⟨k⟩⟩ := hP (IsCofiltered.eq (P.ι.map f) (P.ι.map g))
        refine ⟨⟨Y, hY⟩, P.ι.preimage (k ≫ IsCofiltered.eqHom (P.ι.map f) (P.ι.map g)), ?_⟩
        apply P.ι.map_injective
        simp only [Functor.map_comp, Functor.map_preimage, Category.assoc]
        rw [IsCofiltered.eq_condition]
    haveI := h1
    have h2 : IsCofiltered P.FullSubcategory := by
      obtain ⟨X⟩ := IsCofiltered.nonempty (C := StructuredArrow (Over.mk (wcEtGeomPt B y))
        (Scheme.Etale.forget B))
      obtain ⟨Y, hY, -⟩ := hP X
      haveI : Nonempty P.FullSubcategory := ⟨⟨Y, hY⟩⟩
      exact IsCofiltered.mk
    refine ⟨h2, ?_⟩
    apply Functor.initial_of_exists_of_isCofiltered P.ι
    · intro d
      obtain ⟨Y, hY, hk⟩ := hP d
      exact ⟨⟨Y, hY⟩, hk⟩
    · intro d c s s'
      obtain ⟨Y, hY, ⟨k⟩⟩ := hP (IsCofiltered.eq s s')
      refine ⟨⟨Y, hY⟩, P.ι.preimage (k ≫ IsCofiltered.eqHom s s'), ?_⟩
      simp only [Functor.map_preimage, Category.assoc]
      rw [IsCofiltered.eq_condition]

  have L2 : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)),
      ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)),
        (∀ x : A'.right.left, A'.right.hom x ∈ N) ∧ Nonempty (A' ⟶ A) := by
    intro A
    let V := A.right
    let U : V.left.Opens := V.hom ⁻¹ᵁ N
    let g : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ V.left := A.hom.left
    have hg : g ≫ V.hom = wcEtGeomPt B y := Over.w A.hom
    haveI : Etale V.hom := V.prop
    let V' : B.Etale := MorphismProperty.Over.mk ⊤ (U.ι ≫ V.hom) (by infer_instance)
    let i : V' ⟶ V := MorphismProperty.Over.homMk U.ι rfl trivial
    have hrange : Set.range g ⊆ Set.range U.ι := by
      rintro _ ⟨s, rfl⟩
      rw [Scheme.Opens.range_ι]
      show V.hom (g s) ∈ N
      rw [← Scheme.Hom.comp_apply, hg, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
      exact hyN
    let t := IsOpenImmersion.lift U.ι g hrange
    have ht : t ≫ U.ι = g := IsOpenImmersion.lift_fac _ _ _
    have ht' : t ≫ (U.ι ≫ V.hom) = wcEtGeomPt B y := by
      rw [← Category.assoc, ht, hg]
    have hU : ∀ x : (U : Scheme.{u}), (U.ι ≫ V.hom) x ∈ N := fun x => key V.hom x
    let A' : StructuredArrow (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Y := V') (Over.homMk t ht')
    refine ⟨A', ?_, ⟨StructuredArrow.homMk i ?_⟩⟩
    · intro x
      exact hU x
    · apply Over.OverMorphism.ext
      exact ht
  let P : ObjectProperty (StructuredArrow (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)) :=
    fun A => ∀ x : A.right.left, A.right.hom x ∈ N
  obtain ⟨hPc, hPi⟩ := L1 P L2
  haveI := hPc
  haveI := hPi
  haveI : P.ι.op.Final := Functor.final_op_of_initial P.ι
  haveI : IsFiltered (P.FullSubcategory)ᵒᵖ := isFiltered_op_of_isCofiltered _

  have gen : ∀ {A₀ B₀ C₀ D₀ : AddCommGrpCat.{u+1}} (a : A₀ ⟶ B₀) (b : B₀ ⟶ D₀) (c : A₀ ⟶ C₀)
      (g : C₀ ⟶ D₀), IsIso a → IsIso b → IsIso c → a ≫ b = c ≫ g → IsIso g := by
    intro A₀ B₀ C₀ D₀ a b c g ha hb hc hw
    have hg : g = inv c ≫ a ≫ b := by rw [hw, IsIso.inv_hom_id_assoc]
    rw [hg]
    infer_instance
  have gen' : ∀ {A₀ B₀ C₀ D₀ : AddCommGrpCat.{u+1}} (a : A₀ ⟶ B₀) (b : B₀ ⟶ D₀) (c : A₀ ⟶ C₀)
      (g : C₀ ⟶ D₀), IsIso g → IsIso b → IsIso c → a ≫ b = c ≫ g → IsIso a := by
    intro A₀ B₀ C₀ D₀ a b c g hg hb hc hw
    have ha : a = c ≫ g ≫ inv b := by
      rw [← Category.assoc, ← hw, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    rw [ha]
    infer_instance
  have L4 : ∀ (F : ((P.FullSubcategory)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ AddCommGrpCat.{u+1})
      [F.PreservesZeroMorphisms] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (L₁ L₂ : CochainComplex ((P.FullSubcategory)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ℕ) (φ : L₁ ⟶ L₂),
      IsIso (HomologicalComplex.homologyMap ((F.mapHomologicalComplex (ComplexShape.up ℕ)).map φ) p) ↔
        IsIso (F.map (HomologicalComplex.homologyMap φ p)) := by
    intro F _ _ _ L₁ L₂ φ
    have e := ShortComplex.mapHomologyIso_hom_naturality
      ((HomologicalComplex.shortComplexFunctor _ (ComplexShape.up ℕ) p).map φ) F
    constructor
    · intro h
      exact gen _ _ _ _ h (Iso.isIso_hom _) (Iso.isIso_hom _) e
    · intro h
      exact gen' _ _ _ _ h (Iso.isIso_hom _) (Iso.isIso_hom _) e

  have L5 : ∀ (F G : CochainComplex (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ℕ ⥤
      CochainComplex AddCommGrpCat.{u+1} ℕ), (F ≅ G) →
      IsIso (HomologicalComplex.homologyMap (G.map θ) p) →
      IsIso (HomologicalComplex.homologyMap (F.map θ) p) := by
    intro F G α h
    have e : F.map θ = α.hom.app K₁ ≫ G.map θ ≫ α.inv.app K₂ := by
      rw [← Category.assoc, ← α.hom.naturality, Category.assoc, Iso.hom_inv_id_app,
        Category.comp_id]
    haveI h1 : IsIso (HomologicalComplex.homologyMap (α.hom.app K₁) p) :=
      Iso.isIso_hom ((HomologicalComplex.homologyFunctor _ (ComplexShape.up ℕ) p).mapIso (α.app K₁))
    haveI h2 : IsIso (HomologicalComplex.homologyMap (α.inv.app K₂) p) :=
      Iso.isIso_hom ((HomologicalComplex.homologyFunctor _ (ComplexShape.up ℕ) p).mapIso
        (α.app K₂).symm)
    rw [e, HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp]
    infer_instance

  let Φ : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤
      ((P.FullSubcategory)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⋙
    (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
      (StructuredArrow.proj (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)).op ⋙
    (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj P.ι.op
  let e : Φ ⋙ Limits.colim ≅ wcEtStalk B y :=
    Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt B y)) (Scheme.Etale.forget B)).op)
      (Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) P.ι.op)
  apply L5 _ _ (Functor.mapHomologicalComplexCompIso e (ComplexShape.up ℕ)).symm
  show IsIso (HomologicalComplex.homologyMap ((Limits.colim.mapHomologicalComplex
    (ComplexShape.up ℕ)).map ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).map θ)) p)
  haveI : AB5OfSize.{u, u+1} AddCommGrpCat.{u+1} :=
    AB5OfSize_shrink.{u, u+1, u+1, u+1} AddCommGrpCat.{u+1}
  refine (L4 Limits.colim _ _ ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).map θ)).mpr ?_
  have hpt : ∀ j : (P.FullSubcategory)ᵒᵖ, IsIso ((HomologicalComplex.homologyMap
