        (Scheme.ProEt.topology X) hcU hπg ≪≫
      @Functor.sheafPushforwardContinuousIso _ _ _ _ _ _ σ.symm AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology X) hc1 hc2 ≪≫
      (@Functor.sheafPushforwardContinuousComp _ _ _ _ _ _
        (wcProEtBaseChange (Limits.pullback.snd g U.hom))
        (wcSliceFunctor X W) AddCommGrpCat.{u+1} _ (Scheme.ProEt.topology U.left)
        (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology X) hπgU hcW).symm ≪≫
      Functor.isoWhiskerLeft LW ηgU.symm
  let θq : (wcProEtPush g ⋙ LU).rightDerived q ≅
      (LW ⋙ wcProEtPush (Limits.pullback.snd g U.hom)).rightDerived q :=
    { hom := NatTrans.rightDerived θ.hom q
      inv := NatTrans.rightDerived θ.inv q
      hom_inv_id := by
        rw [← NatTrans.rightDerived_comp, θ.hom_inv_id, NatTrans.rightDerived_id] <;> rfl
      inv_hom_id := by
        rw [← NatTrans.rightDerived_comp, θ.inv_hom_id, NatTrans.rightDerived_id] <;> rfl }

  let I := injectiveResolution (wcContSheaf X A)
  haveI : LU.PreservesHomology := Functor.preservesHomologyOfExact LU
  let K := ((wcProEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  let e41 : LU.obj (((wcProEtPush g).rightDerived q).obj (wcContSheaf X A)) ≅
      LU.obj ((K.sc q).homology) :=
    LU.mapIso (I.isoRightDerivedObj (wcProEtPush g) q)
  let e42 : ((K.sc q).map LU).homology ≅ LU.obj ((K.sc q).homology) :=
    ShortComplex.mapHomologyIso (K.sc q) LU
  let e43 : ((wcProEtPush g ⋙ LU).rightDerived q).obj (wcContSheaf X A) ≅
      ((K.sc q).map LU).homology :=
    I.isoRightDerivedObj (wcProEtPush g ⋙ LU) q
  let e4 : LU.obj (((wcProEtPush g).rightDerived q).obj (wcContSheaf X A)) ≅
      ((wcProEtPush g ⋙ LU).rightDerived q).obj (wcContSheaf X A) :=
    e41 ≪≫ e42.symm ≪≫ e43.symm

  haveI : LW.PreservesHomology := Functor.preservesHomologyOfExact LW
  haveI : ∀ n, Injective (((LW.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).X n) :=
    fun n => by
      haveI := I.injective n
      exact LW.injective_obj (I.cocomplex.X n)
  haveI := I.quasiIso
  let ι : (CochainComplex.single₀ _).obj (LW.obj (wcContSheaf X A)) ⟶
      (LW.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex :=
    (HomologicalComplex.singleMapHomologicalComplex LW (ComplexShape.up ℕ) 0).inv.app
        (wcContSheaf X A) ≫
      (LW.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι
  haveI : QuasiIso ((LW.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι) :=
    HomologicalComplex.quasiIso_map_of_preservesHomology I.ι LW
  haveI : QuasiIso ι := by
    dsimp only [ι]
    infer_instance
  let I' : InjectiveResolution (LW.obj (wcContSheaf X A)) :=
    { cocomplex := (LW.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
      ι := ι }
  let e5 : ((LW ⋙ wcProEtPush (Limits.pullback.snd g U.hom)).rightDerived q).obj
        (wcContSheaf X A) ≅
      ((wcProEtPush (Limits.pullback.snd g U.hom)).rightDerived q).obj
        (LW.obj (wcContSheaf X A)) :=
    I.isoRightDerivedObj (LW ⋙ wcProEtPush (Limits.pullback.snd g U.hom)) q ≪≫
      (I'.isoRightDerivedObj (wcProEtPush (Limits.pullback.snd g U.hom)) q).symm
  let e : LU.obj (((wcProEtPush g).rightDerived q).obj (wcContSheaf X A)) ≅
      ((wcProEtPush (Limits.pullback.snd g U.hom)).rightDerived q).obj
        (wcContSheaf (Limits.pullback g U.hom) A) :=
    e4 ≪≫ θq.app (wcContSheaf X A) ≪≫ e5
  obtain ⟨E₁⟩ := extU (((wcProEtPush g).rightDerived q).obj (wcContSheaf X A)) p
  let E₂ : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (LU.obj (((wcProEtPush g).rightDerived q).obj (wcContSheaf X A))) p ≃
      Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (((wcProEtPush (Limits.pullback.snd g U.hom)).rightDerived q).obj
          (wcContSheaf (Limits.pullback g U.hom) A)) p :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero p)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
  exact ⟨E₁.trans E₂⟩

theorem wc_et_push_homology_const_torsion : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), ((m : ℕ) : ℤ) • 𝟙 ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) = 0 :=
by
  intro X B g m I q
  have hM : ((m : ℕ) : ℤ) • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
    have h0 : ((m : ℕ) : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
      ext x
      simp
    rw [← CategoryTheory.Functor.map_id (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      ← CategoryTheory.Functor.map_zsmul, h0, CategoryTheory.Functor.map_zero]
  have h1 : I.ι ≫ (((m : ℕ) : ℤ) • 𝟙 I.cocomplex) =
      (CochainComplex.single₀ _).map (((m : ℕ) : ℤ) • 𝟙 _) ≫ I.ι := by
    rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id, Preadditive.zsmul_comp,
      Category.id_comp, Preadditive.comp_zsmul, Category.comp_id]
  have h2 : I.ι ≫ (0 : I.cocomplex ⟶ I.cocomplex) =
      (CochainComplex.single₀ _).map (((m : ℕ) : ℤ) • 𝟙 _) ≫ I.ι := by
    rw [hM, CategoryTheory.Functor.map_zero, Limits.comp_zero, Limits.zero_comp]
  have ho := (wcEtPush g).mapHomotopy (InjectiveResolution.descHomotopy _ _ _ h1 h2)
  have e1 := Homotopy.homologyMap_eq ho q
  rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id,
    CategoryTheory.Functor.map_zero, HomologicalComplex.homologyMap_zero] at e1
  have e2 : HomologicalComplex.homologyMap (((m : ℕ) : ℤ) • 𝟙 (((wcEtPush g).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex)) q = ((m : ℕ) : ℤ) • 𝟙 _ := by
    rw [← HomologicalComplex.homologyFunctor_map, CategoryTheory.Functor.map_zsmul,
      CategoryTheory.Functor.map_id]
    rfl
  rw [← e2]
  exact e1

theorem wc_et_noetherian_torsion_coh_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K] (B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (k : ℕ) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), IsNoetherianObject G → ((ℓ ^ k : ℕ) : ℤ) • 𝟙 G = 0 → ∀ p : ℕ, Finite (wcEtExt B G p) :=
by
  intro K _ _ B fB _ ℓ hℓ hℓK
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})), S.ShortExact →
      ∀ n : ℕ, Finite (Abelian.Ext X S.X₁ n) → Finite (Abelian.Ext X S.X₃ n) →
        Finite (Abelian.Ext X S.X₂ n) := by
    intro X S hS n h1 h3
    let ψ : Abelian.Ext X S.X₂ n →+ Abelian.Ext X S.X₃ n :=
      (Abelian.Ext.mk₀ S.g).postcomp X (add_zero n)
    let φ : Abelian.Ext X S.X₁ n →+ Abelian.Ext X S.X₂ n :=
      (Abelian.Ext.mk₀ S.f).postcomp X (add_zero n)
    have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
      Abelian.Ext.covariant_sequence_exact₂ X hS b hb
    let σ : Abelian.Ext X S.X₃ n → Abelian.Ext X S.X₂ n :=
      fun c => if h : ∃ b, ψ b = c then h.choose else 0
    have hσ : ∀ b, ψ (σ (ψ b)) = ψ b := by
      intro b
      have h : ∃ b', ψ b' = ψ b := ⟨b, rfl⟩
      simp only [σ, dif_pos h]
      exact h.choose_spec
    have hpre : ∀ b, ∃ a, φ a = b - σ (ψ b) := fun b =>
      hex _ (by rw [map_sub, hσ, sub_self])
    choose τ hτ using hpre
    refine Finite.of_injective (fun b => (ψ b, τ b)) ?_
    intro b b' hbb
    simp only [Prod.mk.injEq] at hbb
    obtain ⟨e1, e2⟩ := hbb
    have := hτ b
    rw [e2, hτ b', e1] at this
    exact (sub_left_inj.mp this).symm

  have hsub : ∀ (X : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})), S.ShortExact →
      ∀ n : ℕ, Finite (Abelian.Ext X S.X₂ n) → (∀ m : ℕ, n = m + 1 → Finite (Abelian.Ext X S.X₃ m)) →
        Finite (Abelian.Ext X S.X₁ n) := by
    intro X S hS n h2 h3
    cases n with
    | zero =>
      refine Finite.of_injective
        (fun x : Abelian.Ext X S.X₁ 0 => x.comp (Abelian.Ext.mk₀ S.f) (add_zero 0)) ?_
      intro x y hxy
      obtain ⟨a, rfl⟩ := (Abelian.Ext.mk₀_bijective X S.X₁).2 x
      obtain ⟨b, rfl⟩ := (Abelian.Ext.mk₀_bijective X S.X₁).2 y
      have e : Abelian.Ext.mk₀ (a ≫ S.f) = Abelian.Ext.mk₀ (b ≫ S.f) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀]
        exact hxy
      have hab : a ≫ S.f = b ≫ S.f := (Abelian.Ext.mk₀_bijective X S.X₂).1 e
      haveI := hS.mono_f
      rw [cancel_mono] at hab
      rw [hab]
    | succ m =>
      haveI := h3 m rfl
      let φ : Abelian.Ext X S.X₁ (m + 1) →+ Abelian.Ext X S.X₂ (m + 1) :=
        (Abelian.Ext.mk₀ S.f).postcomp X (add_zero (m + 1))
      let σ : Abelian.Ext X S.X₂ (m + 1) → Abelian.Ext X S.X₁ (m + 1) :=
        fun c => if h : ∃ b, φ b = c then h.choose else 0
      have hσ : ∀ b, φ (σ (φ b)) = φ b := by
        intro b
        have h : ∃ b', φ b' = φ b := ⟨b, rfl⟩
        simp only [σ, dif_pos h]
        exact h.choose_spec
      have hpre : ∀ b, ∃ y : Abelian.Ext X S.X₃ m, y.comp hS.extClass rfl = b - σ (φ b) := by
        intro b
        have h0 : φ (b - σ (φ b)) = 0 := by rw [map_sub, hσ, sub_self]
        exact Abelian.Ext.covariant_sequence_exact₁ X hS _ h0 rfl
      choose τ hτ using hpre
      refine Finite.of_injective (fun b => (φ b, τ b)) ?_
      intro b b' hbb
      simp only [Prod.mk.injEq] at hbb
      obtain ⟨e1, e2⟩ := hbb
      have := hτ b
      rw [e2, hτ b', e1] at this
      exact (sub_left_inj.mp this).symm

  have hret : ∀ (X E : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (r : ℕ)
      (A : Fin r → Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
      (pr : ∀ i, E ⟶ A i) (ι' : ∀ i, A i ⟶ E), ∑ i, pr i ≫ ι' i = 𝟙 E →
      ∀ n : ℕ, (∀ i, Finite (Abelian.Ext X (A i) n)) → Finite (Abelian.Ext X E n) := by
    intro X E r A pr ι' hsum n hA
    have key : ∀ x : Abelian.Ext X E n, x = ∑ i, (x.comp (Abelian.Ext.mk₀ (pr i)) (add_zero n)).comp
        (Abelian.Ext.mk₀ (ι' i)) (add_zero n) := by
      intro x
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 E)) (add_zero n) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (Abelian.Ext.mk₀ (∑ i, pr i ≫ ι' i)) (add_zero n) := by rw [hsum]
        _ = ∑ i, x.comp (Abelian.Ext.mk₀ (pr i ≫ ι' i)) (add_zero n) := by
          rw [Abelian.Ext.mk₀_sum, Abelian.Ext.comp_sum]
        _ = _ := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀]
    haveI : ∀ i, Finite (Abelian.Ext X (A i) n) := hA
    refine Finite.of_injective (fun x i => x.comp (Abelian.Ext.mk₀ (pr i)) (add_zero n)) ?_
    intro x y hxy
    rw [key x, key y]
    exact Finset.sum_congr rfl (fun i _ =>
      congrArg (fun z => z.comp (Abelian.Ext.mk₀ (ι' i)) (add_zero n)) (congrFun hxy i))

  have hsplit : ∀ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (k : ℕ),
      IsNoetherianObject G → ((ℓ ^ (k + 1) : ℕ) : ℤ) • 𝟙 G = 0 →
      ∃ (G₁ G₃ : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (i : G₁ ⟶ G) (q : G ⟶ G₃)
        (hz : i ≫ q = 0), (ShortComplex.mk i q hz).ShortExact ∧ IsNoetherianObject G₁ ∧
        IsNoetherianObject G₃ ∧ (ℓ : ℤ) • 𝟙 G₁ = 0 ∧ ((ℓ ^ k : ℕ) : ℤ) • 𝟙 G₃ = 0 := by
    intro G k hG htor
    haveI := hG
    refine ⟨Limits.kernel ((ℓ : ℤ) • 𝟙 G), Abelian.coimage ((ℓ : ℤ) • 𝟙 G),
      Limits.kernel.ι ((ℓ : ℤ) • 𝟙 G), Abelian.coimage.π ((ℓ : ℤ) • 𝟙 G),
      Limits.cokernel.condition (Limits.kernel.ι ((ℓ : ℤ) • 𝟙 G)), ?_, ?_, ?_, ?_, ?_⟩
    · exact ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.cokernelIsCokernel (Limits.kernel.ι ((ℓ : ℤ) • 𝟙 G)))) inferInstance inferInstance
    · exact isNoetherianObject_of_mono (Limits.kernel.ι ((ℓ : ℤ) • 𝟙 G))
    · exact isNoetherianObject_of_mono (Abelian.factorThruCoimage ((ℓ : ℤ) • 𝟙 G))
    · rw [← cancel_mono (Limits.kernel.ι ((ℓ : ℤ) • 𝟙 G)), Preadditive.zsmul_comp,
        Category.id_comp, Limits.zero_comp]
      have h0 : Limits.kernel.ι ((ℓ : ℤ) • 𝟙 G) ≫ ((ℓ : ℤ) • 𝟙 G) = 0 := Limits.kernel.condition _
      rw [Preadditive.comp_zsmul, Category.comp_id] at h0
      exact h0
    · rw [← cancel_epi (Abelian.coimage.π ((ℓ : ℤ) • 𝟙 G)),
        ← cancel_mono (Abelian.factorThruCoimage ((ℓ : ℤ) • 𝟙 G)), Limits.comp_zero,
        Limits.zero_comp, Preadditive.comp_zsmul, Category.comp_id, Preadditive.zsmul_comp,
        Abelian.coimage.fac, smul_smul]
      rw [show (((ℓ ^ k : ℕ) : ℤ) * (ℓ : ℤ)) = ((ℓ ^ (k + 1) : ℕ) : ℤ) by push_cast; ring]
      exact htor

  have hstep : ∀ (p : ℕ) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}),
      IsNoetherianObject G → (ℓ : ℤ) • 𝟙 G = 0 →
      (∀ m : ℕ, p = m + 1 → ∀ G' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1},
        IsNoetherianObject G' → (ℓ : ℤ) • 𝟙 G' = 0 →
        Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) G' m)) →
      Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p) := by
    intro p G hG htor IH
    obtain ⟨E, ι, r, B', π, pr, ι', hmono, hfin, hsum, hnoeth, htorQ⟩ :=
      wc_et_noetherian_torsion_embedding K B fB ℓ hℓ G hG htor
    have hS : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.cokernelIsCokernel ι)) hmono inferInstance
    have hE : Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) E p) := by
      refine hret _ E r _ pr ι' hsum p (fun i => ?_)
      haveI := hfin i
      obtain ⟨e⟩ := wc_et_finite_push_ext_equiv (π i)
        ((constantSheaf (Scheme.smallEtaleTopology (B' i)) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) p
      haveI hc : Finite (wcEtCoh (B' i) ℓ p) := wc_etale_proper_finite K (B' i) (π i ≫ fB) ℓ hℓK p
      haveI : Finite (wcEtExt (B' i) ((constantSheaf (Scheme.smallEtaleTopology (B' i))
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) p) := hc
      exact Finite.of_equiv _ e.symm
    exact hsub _ _ hS p hE (fun m hm => IH m hm _ hnoeth htorQ)
  have hell : ∀ (p : ℕ) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}),
      IsNoetherianObject G → (ℓ : ℤ) • 𝟙 G = 0 →
      Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p) := by
    intro p
    induction p with
    | zero =>
      intro G hG htor
      exact hstep 0 G hG htor (fun m hm => absurd hm (by omega))
    | succ m ih =>
      intro G hG htor
      refine hstep (m + 1) G hG htor (fun m' hm' => ?_)
      obtain rfl : m' = m := by omega
      exact ih

  intro k
  induction k with
  | zero =>
    intro G hG htor p
    have h1 : 𝟙 G = 0 := by simpa using htor
    have hx : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p, x = 0 := by
      intro x
      have := Abelian.Ext.comp_mk₀_id x
      rw [h1, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
      exact this.symm
    haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p) :=
      ⟨fun x y => by rw [hx x, hx y]⟩
    exact (Finite.of_subsingleton : Finite (Abelian.Ext ((constantSheaf
      (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p))
  | succ k ih =>
    intro G hG htor p
    obtain ⟨G₁, G₃, i, q, hz, hS, h1, h3, t1, t3⟩ := hsplit G k hG htor
    exact hmid _ _ hS p (hell p G₁ h1 t1) (ih G₃ h3 t3 p)

theorem wc_et_proper_push_noetherian_of_generic_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (m : ℕ), (m : K) ≠ 0 → ∀ q : ℕ, (∀ η : B, ∃ W : Set B, IsOpen W ∧ η ∈ W ∧ ∀ y ∈ W, η ⤳ y → Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt B y)) m q) = Nat.card (wcEtCoh (Limits.pullback g (wcEtGeomPt B η)) m q)) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), IsNoetherianObject ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  intro K _ _ X B fB _ g _ m hmK q hgen I
  classical

  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hmK (by simp)
  haveI : IsLocallyNoetherian B := LocallyOfFiniteType.isLocallyNoetherian fB
  haveI : CompactSpace B := QuasiCompact.compactSpace_of_compactSpace fB
  haveI : IsNoetherian B := AlgebraicGeometry.IsNoetherian.mk

  have hst : ∀ b : B, Nonempty ((wcEtStalk B b).obj
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) ≃
      wcEtCoh (Limits.pullback g (wcEtGeomPt B b)) m q) := fun b =>
    wc_et_proper_stalk_coh g m hm0 wc_et_henselian_proper_vanishing I b q

