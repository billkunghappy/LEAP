  have hs5 : ∀ {P Y T B : Scheme.{u}} (π : P ⟶ Y) (V W : Y.Opens) (hWV : W ≤ V) (fY : Y ⟶ B) (q : ((π ⁻¹ᵁ V : P.Opens) : Scheme.{u}) ⟶ T) (t : T ⟶ B), IsPullback (π ∣_ V) q (V.ι ≫ fY) t → IsPullback (π ∣_ W) (P.homOfLE (Scheme.Hom.preimage_mono π hWV) ≫ q) (W.ι ≫ fY) t := by
