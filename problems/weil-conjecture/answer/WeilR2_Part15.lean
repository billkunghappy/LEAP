    (Limits.pullback.snd D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom) hfbar (ℓ ^ k) I q
  obtain ⟨E2⟩ := wc_proet_push_slice_ext_equiv (wcP1Over F'').left D.Yt.left
    (wcGeomPoint F'' (wcP1Over F'') hP) D.f (ZMod (ℓ ^ k)) q 2
  refine @Finite.of_equiv _ _ ?_ E2.symm
  refine @Finite.of_injective _ _ hfinPro
    (fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero 2)) ?_
  intro x y hxy
  have key : ∀ z : Abelian.Ext (wcFreeSheaf (wcGeomPoint F'' (wcP1Over F'') hP).left
      (Scheme.ProEt.mk (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP).left)))
      (((wcProEtPush (Limits.pullback.snd D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom)).rightDerived
        q).obj (wcContSheaf (Limits.pullback D.f (wcGeomPoint F'' (wcP1Over F'') hP).hom)
          (ZMod (ℓ ^ k)))) 2,
      (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero 2)).comp (Abelian.Ext.mk₀ e.inv) (add_zero 2) = z := by
    intro z
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 2) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  rw [← key x, ← key y]
  exact congrArg (fun w => w.comp (Abelian.Ext.mk₀ e.inv) (add_zero 2)) hxy

theorem wc_ext_tower_vanishing_finite : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (P Z Y : C) (B : ℕ → C) (pr : ∀ n, Y ⟶ B n) (c : ∀ n, B (n + 1) ⟶ B n) (T : Y ⟶ Y) (hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n) (f : Z ⟶ Y) (hzero : f ≫ T = 0) (hS : (ShortComplex.mk f T hzero).ShortExact) (M : ℕ) (hinj : ∀ (N : ℕ) (x : Abelian.Ext P Y N), (∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = 0) → x = 0) (hsurj : ∀ (N : ℕ) (y : ∀ n, Abelian.Ext P (B n) N), ∃ x : Abelian.Ext P Y N, ∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = y n) (hB : ∀ (n i : ℕ), M < i → ∀ x : Abelian.Ext P (B n) i, x = 0) (hfin : ∀ n, Finite (Abelian.Ext P (B n) M)), ∀ i : ℕ, M < i → ∀ x : Abelian.Ext P Z i, x = 0 :=
by
  intro C _ _ _ P Z Y B pr c T hT f hzero hS M hinj hsurj hB hfin
  have s1 : ∀ j, M < j → ∀ x : Abelian.Ext P Y j, x = 0 := fun j hj x =>
    hinj j x (fun n => hB n j hj _)
  have thread : ∀ (ψ : ∀ n, Abelian.Ext P (B (n + 1)) M → Abelian.Ext P (B n) M),
      ∃ x : ∀ n, Abelian.Ext P (B n) M, ∀ n, ψ n (x (n + 1)) = x n := by
    intro ψ
    let F : ℕᵒᵖ ⥤ Type _ := Functor.ofOpSequence (X := fun n => Abelian.Ext P (B n) M)
      (fun n => TypeCat.ofHom (ψ n))
    have : ∀ j, Finite (F.obj j) := fun j => hfin j.unop
    have : ∀ j, Nonempty (F.obj j) := fun j =>
      (⟨0⟩ : Nonempty (Abelian.Ext P (B j.unop) M))
    obtain ⟨s, hs⟩ := nonempty_sections_of_finite_inverse_system F
    refine ⟨fun n => s (Opposite.op n), fun n => ?_⟩
    have h := hs (homOfLE (Nat.le_succ n)).op
    rw [Functor.ofOpSequence_map_homOfLE_succ] at h
    exact h
  have s4 : ∀ y : Abelian.Ext P Y M, ∃ w : Abelian.Ext P Y M,
      w.comp (Abelian.Ext.mk₀ T) (add_zero M) = y := by
    intro y
    obtain ⟨x, hx0⟩ := thread (fun n u => u.comp (Abelian.Ext.mk₀ (c n)) (add_zero M) +
      y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero M))
    have hx : ∀ n, (x (n + 1)).comp (Abelian.Ext.mk₀ (c n)) (add_zero M) =
        x n - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero M) := fun n =>
      eq_sub_of_add_eq (hx0 n)
    obtain ⟨w, hw⟩ := hsurj M x
    refine ⟨w, ?_⟩
    rw [← sub_eq_zero]
    apply hinj M
    intro n
    have key : ∀ (a b : Abelian.Ext P Y M) (g : Y ⟶ B n),
        (a - b).comp (Abelian.Ext.mk₀ g) (add_zero M) =
          a.comp (Abelian.Ext.mk₀ g) (add_zero M) - b.comp (Abelian.Ext.mk₀ g) (add_zero M) := by
      intro a b g
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
    have h1 : (w.comp (Abelian.Ext.mk₀ T) (add_zero M)).comp (Abelian.Ext.mk₀ (pr n)) (add_zero M) =
        w.comp (Abelian.Ext.mk₀ (pr n)) (add_zero M) -
          (w.comp (Abelian.Ext.mk₀ (pr (n + 1))) (add_zero M)).comp (Abelian.Ext.mk₀ (c n))
            (add_zero M) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hT n,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, Abelian.Ext.comp_add,
        Abelian.Ext.comp_neg, ← sub_eq_add_neg]
    rw [key, h1, hw, hw, hx]
    abel
  intro i hi z
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  have h0 : z.comp (Abelian.Ext.mk₀ f) (add_zero (k + 1)) = 0 := s1 _ hi _
  obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS z h0 (rfl : k + 1 = k + 1)
  rw [← hx₃]
  rcases Nat.lt_or_ge M k with hk | hk
  · rw [s1 k hk x₃, Abelian.Ext.zero_comp]
  · have hkM : k = M := by omega
    subst hkM
    obtain ⟨w, hw⟩ := s4 x₃
    rw [← hw, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h2 := hS.comp_extClass
    erw [h2, Abelian.Ext.comp_zero]

theorem wc_pencil_Rq_ladic_lift (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (q p : ℕ) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p),
      ∃ (g : ((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ]) ⟶ wcRq D.f ℓ q)
        (y : wcCohG F'' (wcP1Over F'') hP
          (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])) p),
        x = y.comp (Abelian.Ext.mk₀ g) (add_zero p) :=
by
  classical
  intro q p x

  haveI hRfin : Limits.PreservesFiniteLimits (wcProEtPush D.f) := inferInstance

  haveI hexY : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _
      (Scheme.ProEt.topology D.Yt.left) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  haveI hexB : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _
      (Scheme.ProEt.topology (wcP1Over F'').left) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))

  haveI := D.proper
  haveI hP1 : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  obtain ⟨κ, ⟨hκ⟩, -⟩ := wc_ladic_tower_colimit D.Yt.left ℓ

  obtain ⟨hq⟩ := wc_rightDerived_preserves_seq_colimit (wcProEtPush D.f)
    (fun G c hc => wc_proet_push_preserves_seq_colimit D.f G c hc)
    (fun I hI c hc k => wc_proet_push_colim_injective_acyclic D.f I hI c hc k) _ _ hκ q

  haveI hsnd : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  have hqc : QuasiCompact (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := by
    haveI := hsnd.toUniversallyClosed
    infer_instance
  have hqs : QuasiSeparated (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := by
    haveI := hsnd.toIsSeparated
    infer_instance
  haveI hU0c : CompactSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hqc _
  haveI hU0s : QuasiSeparatedSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) _ hqs
  have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP) ⟶ c.pt,
        ∃ (n : ℕ) (g' : wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
          G.obj n), g = g' ≫ c.ι.app n :=
    fun G c hc =>
      (proet_free_hom_seq_colimit (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)
        G c hc).1
  have H1 : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
        (α : G ⟶ I), Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext
            (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) c.pt (k + 1)),
            x = 0 := by
    intro G
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    exact ⟨I, α, hα, fun c hc k x => proet_ext_colimit_injectives_vanish (wcP1Over F'').left
      (wcGeomPoint F'' (wcP1Over F'') hP) I hI c hc k x⟩

  obtain ⟨m, y, hxy⟩ := ext_seq_colimit_lift_of_acyclic
    (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) H0 H1 p _ _ hq x
  exact ⟨((wcProEtPush D.f).rightDerived q).map (κ.app m), y, hxy⟩

theorem wc_pencil_E2_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ p q : ℕ, 3 ≤ p → ∀ x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p, x = 0 :=
by
  classical
  intro p q hp x

  have ht : WeaklyEtale (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨L, adj, -, -⟩ := wc_proet_push_free_adjunction F'' (wcP1Over F'') D.Yt
    (Over.homMk D.f D.hf) hP ht
  haveI := wc_proet_products_exact D.Yt.left
  haveI := wc_proet_products_exact (wcP1Over F'').left
  haveI hRlim : Limits.PreservesLimitsOfSize.{0, 0} (wcProEtPush D.f) :=
    adj.rightAdjoint_preservesLimits
  haveI hRlim' : Limits.PreservesLimitsOfSize.{u+1, u+1} (wcProEtPush D.f) :=
    adj.rightAdjoint_preservesLimits
  haveI hRfin : Limits.PreservesFiniteLimits (wcProEtPush D.f) := inferInstance

  obtain ⟨hci, hemb, hcs, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact D.Yt.left (wcTowerIncl ℓ) hci
    (wcTowerShift ℓ) hcs hemb hker hsec
  have hY := (wc_contSheaf_pi_isLimit D.Yt.left (fun n => ZMod (ℓ ^ n))).some
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap D.Yt.left φ hφ = wcContSheafMap D.Yt.left φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl
  have hTn : ∀ k, wcContSheafMap D.Yt.left (wcTowerShift ℓ) hcs ≫
      wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k) =
      wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k) -
      wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1))
        (continuous_apply (k + 1)) ≫
      wcContSheafMap D.Yt.left (wcTowerCast ℓ k) continuous_of_discreteTopology := by
    intro k
    have e1 := (wc_contSheafMap_comp_sub D.Yt.left (wcTowerShift ℓ) (wcTowerShift ℓ) hcs
      hcs (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k) (continuous_apply k)).1
    have e2 := (wc_contSheafMap_comp_sub D.Yt.left
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1)) (continuous_apply (k + 1))
      (continuous_apply (k + 1)) (wcTowerCast ℓ k) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub D.Yt.left
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k)
      ((wcTowerCast ℓ k).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1)))
      (continuous_apply k)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ k))).comp (continuous_apply (k + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ k))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _

  obtain ⟨hadd, hmono0, hles⟩ := wc_rightDerived_les_package (wcProEtPush D.f) _ hS2

  have hlim : ∀ j, Limits.IsLimit (Limits.Fan.mk
      (((wcProEtPush D.f).rightDerived j).obj (wcContSheaf D.Yt.left ((n : ℕ) → ZMod (ℓ ^ n))))
      (fun k => ((wcProEtPush D.f).rightDerived j).map
        (wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k)
          (continuous_apply k)))) :=
    fun j => (wc_rightDerived_preserves_nat_products (wcProEtPush D.f) _ _ _ hY j).some
  have hTj : ∀ j k, ((wcProEtPush D.f).rightDerived j).map
        (wcContSheafMap D.Yt.left (wcTowerShift ℓ) hcs) ≫
      ((wcProEtPush D.f).rightDerived j).map
        (wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k)
          (continuous_apply k)) =
      ((wcProEtPush D.f).rightDerived j).map
        (wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k)
          (continuous_apply k)) -
      ((wcProEtPush D.f).rightDerived j).map
        (wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (k + 1))
          (continuous_apply (k + 1))) ≫
      ((wcProEtPush D.f).rightDerived j).map
        (wcContSheafMap D.Yt.left (wcTowerCast ℓ k) continuous_of_discreteTopology) := by
    intro j k
    rw [← Functor.map_comp, hTn k, hadd, Functor.map_comp]

  have hcoc : ∀ j k i m (h1 : m ≤ i) (h2 : i ≤ k),
      ((wcProEtPush D.f).rightDerived j).map (wcContSheafMap D.Yt.left
        (ZMod.castHom (pow_dvd_pow ℓ h2) (ZMod (ℓ ^ i))).toAddMonoidHom
        continuous_of_discreteTopology) ≫
      ((wcProEtPush D.f).rightDerived j).map (wcContSheafMap D.Yt.left
        (ZMod.castHom (pow_dvd_pow ℓ h1) (ZMod (ℓ ^ m))).toAddMonoidHom
        continuous_of_discreteTopology) =
      ((wcProEtPush D.f).rightDerived j).map (wcContSheafMap D.Yt.left
        (ZMod.castHom (pow_dvd_pow ℓ (h1.trans h2)) (ZMod (ℓ ^ m))).toAddMonoidHom
        continuous_of_discreteTopology) := by
    intro j k i m h1 h2
    rw [← Functor.map_comp, ← (wc_contSheafMap_comp_sub D.Yt.left
      (ZMod.castHom (pow_dvd_pow ℓ h2) (ZMod (ℓ ^ i))).toAddMonoidHom
      (ZMod.castHom (pow_dvd_pow ℓ h2) (ZMod (ℓ ^ i))).toAddMonoidHom
      continuous_of_discreteTopology continuous_of_discreteTopology
      (ZMod.castHom (pow_dvd_pow ℓ h1) (ZMod (ℓ ^ m))).toAddMonoidHom
      continuous_of_discreteTopology).1]
    exact congrArg _ (hcongr _ _ (AddMonoidHom.ext fun t =>
      RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow ℓ h1) (pow_dvd_pow ℓ h2)) t) _ _)
  have hepi : ∀ j, Epi (((wcProEtPush D.f).rightDerived j).map
      (wcContSheafMap D.Yt.left (wcTowerShift ℓ) hcs)) := fun j =>
    wc_proet_ML_tower_shift_epi (wcP1Over F'').left _ _ _ (hlim j)
      (fun k m h => ((wcProEtPush D.f).rightDerived j).map (wcContSheafMap D.Yt.left
        (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ m))).toAddMonoidHom
        continuous_of_discreteTopology))
      (hcoc j) (wc_pencil_Rq_tower_ML F' F'' Y n hn2 D ℓ hℓ hP j) _ (hTj j)

  have hSE : ∀ j, ∃ hz : ((wcProEtPush D.f).rightDerived j).map
        (wcContSheafMap D.Yt.left (wcTowerIncl ℓ) hci) ≫
      ((wcProEtPush D.f).rightDerived j).map (wcContSheafMap D.Yt.left (wcTowerShift ℓ) hcs) = 0,
      (ShortComplex.mk _ _ hz).ShortExact := by
    intro j
    obtain ⟨⟨h0, hex⟩, -⟩ := hles j
    refine ⟨h0, ShortComplex.ShortExact.mk' hex ?_ (hepi j)⟩
    cases j with
    | zero => exact hmono0
    | succ j' =>
      obtain ⟨-, δ', h1', h2', -, hex2'⟩ := hles j'
      haveI := hepi j'
      have hδ : δ' = 0 := (cancel_epi _).1 (h1'.trans Limits.comp_zero.symm)
      exact hex2'.mono_g hδ

  have hprod := fun N => wc_ext_prod_bijective
    (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) _ _ _ (hlim q) N
  obtain ⟨hzq, hSq⟩ := hSE q
  have hInt := wc_ext_tower_vanishing_finite
    (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) _ _
    (fun k => ((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))))
    (fun k => ((wcProEtPush D.f).rightDerived q).map
        (wcContSheafMap D.Yt.left (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) k)
          (continuous_apply k)))
    (fun k => ((wcProEtPush D.f).rightDerived q).map
        (wcContSheafMap D.Yt.left (wcTowerCast ℓ k) continuous_of_discreteTopology))
    _ (hTj q) _ hzq hSq 2 (fun N => (hprod N).1) (fun N => (hprod N).2)
    (fun k i hi y => wc_pencil_Rq_torsion_vanish F' F'' Y n hn2 D ℓ hℓ hP k q i hi y)
    (fun k => wc_pencil_Rq_torsion_ext2_finite F' F'' Y n hn2 D ℓ hℓ hP k q)

  obtain ⟨g, y, hxy⟩ := wc_pencil_Rq_ladic_lift F' F'' Y n hn2 D ℓ hℓ hP q p x
  rw [hxy, hInt p hp y, Abelian.Ext.zero_comp]

theorem wc_pencil_geom_fibre_dim_le (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ (wcP1Over F'').left) : topologicalKrullDim ↥(Limits.pullback D.f t) ≤ ((n - 1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  have topo : ∀ (X Z : Type u) [TopologicalSpace X] [TopologicalSpace Z] [IrreducibleSpace X]
      (j : Z → X) (d : ℕ), Topology.IsClosedEmbedding j → ¬ Function.Surjective j →
      topologicalKrullDim X ≤ ((d + 1 : ℕ) : WithBot ℕ∞) →
      topologicalKrullDim Z ≤ (d : WithBot ℕ∞) := by
    intro X Z _ _ _ j d hj hns hX
    obtain ⟨x₀, hx₀⟩ : ∃ x₀, x₀ ∉ Set.range j := by
      by_contra h
      push_neg at h
      exact hns (fun x => h x)
    let φ := TopologicalSpace.IrreducibleCloseds.map j hj.continuous
    have hφ : StrictMono φ :=
      TopologicalSpace.IrreducibleCloseds.map_strictMono_of_isInducing hj.isInducing
    let top : TopologicalSpace.IrreducibleCloseds X :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
    have hlt : ∀ a, φ a < top := by
      intro a
      rw [SetLike.lt_iff_le_and_exists]
      refine ⟨fun x _ => Set.mem_univ x, x₀, Set.mem_univ _, ?_⟩
      intro hx
      apply hx₀
      have hx' : x₀ ∈ (φ a : Set X) := hx
      rw [TopologicalSpace.IrreducibleCloseds.coe_map] at hx'
      exact closure_minimal (Set.image_subset_range j _) hj.isClosed_range hx'
    unfold topologicalKrullDim Order.krullDim
    apply iSup_le
    intro p
    let q := (p.map φ hφ).snoc top (hlt p.last)
    have h1 := Order.LTSeries.length_le_krullDim q
    have h2 : (q.length : WithBot ℕ∞) ≤ ((d + 1 : ℕ) : WithBot ℕ∞) := h1.trans hX
    have h3 : q.length = p.length + 1 := RelSeries.snoc_length _ _ _
    rw [h3] at h2
    have h4 : p.length + 1 ≤ d + 1 := by exact_mod_cast h2
    exact_mod_cast (by omega : p.length ≤ d)

  haveI hprop : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1

  let j := Limits.pullback.mapDesc D.f t (wcP1Over F'').hom
  have hj : Topology.IsClosedEmbedding j := Scheme.Hom.isClosedEmbedding j

  have hjfst : j ≫ Limits.pullback.fst (D.f ≫ (wcP1Over F'').hom) (t ≫ (wcP1Over F'').hom) =
      Limits.pullback.fst D.f t := by
    dsimp only [j, Limits.pullback.mapDesc, Limits.pullback.map]
    rw [Limits.pullback.lift_fst, Category.comp_id]

  have himg : ∀ w : ↥(Limits.pullback D.f t),
      D.f (Limits.pullback.fst D.f t w) = t (IsLocalRing.closedPoint Ω) := by
    intro w
    have e := (Scheme.Hom.comp_apply _ _ w).symm.trans
      ((congrArg (fun g : Limits.pullback D.f t ⟶ (wcP1Over F'').left => g w)
        Limits.pullback.condition).trans (Scheme.Hom.comp_apply _ _ w))
    rw [e]
    exact congrArg _ (Subsingleton.elim _ _)

  obtain ⟨x₁, hx₁⟩ : ∃ x₁ : ↥(wcP1Over F'').left, x₁ ≠ t (IsLocalRing.closedPoint Ω) := by
    have hgen := (wc_P1_sections_closed_generize F'' 1 (fun _ => D.u0) (fun _ => D.hu0)).2
      (Scheme.ProEt.mk (𝟙 (wcP1Over F'').left)) (D.u0 (IsLocalRing.closedPoint F''))
      ⟨0, rfl⟩
    obtain ⟨t', -, ht'⟩ := hgen
    have hne : t' ≠ D.u0 (IsLocalRing.closedPoint F'') := by
      intro h
      exact ht' ⟨0, h⟩
