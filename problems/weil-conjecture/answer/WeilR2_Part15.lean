  have hφx : (wcGeomFrob F'' (wcP1Over F'') hP).left xb = xb := by
    have h1 : (ub ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) =
        (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ ub)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) := by
      first | rw [hfr] | exact congrArg (fun k => k (IsLocalRing.closedPoint _)) hfr
    have h2 : (ub ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) =
        (wcGeomFrob F'' (wcP1Over F'') hP).left (ub (IsLocalRing.closedPoint _)) := by
      first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
    have h3 : (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ ub)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) =
        ub (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F''))
          (IsLocalRing.closedPoint (AlgebraicClosure F''))) := by
      first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
    have h4 := h2.symm.trans (h1.trans (h3.trans (congrArg ub (hptK _))))
    rw [← hxb] at h4
    exact h4
  have hfx : (wcGeomPoint F'' (wcP1Over F'') hP).hom xb = u0 (IsLocalRing.closedPoint F'') := by
    have h1 : (ub ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) =
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ u0)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) := by
      first | rw [hub1] | exact congrArg (fun k => k (IsLocalRing.closedPoint _)) hub1
    have h2 : (ub ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom)
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) =
        (wcGeomPoint F'' (wcP1Over F'') hP).hom (ub (IsLocalRing.closedPoint _)) := by
