  obtain ⟨Θ, hΘbij, hΘnat⟩ := wc_zmod_et_proet_natural_comparison_all (ℓ ^ k) q
  obtain ⟨Ep⟩ := wc_et_zmod_pull_data_exists ((wcProEtPullback D.f).map a₀).left (ℓ ^ k)
