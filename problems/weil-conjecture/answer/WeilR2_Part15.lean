  haveI hRfin : Limits.PreservesFiniteLimits (wcProEtPush g) := inferInstance

  haveI hOcol : Limits.PreservesColimitsOfSize.{0, 0}
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V) :=
    Adjunction.leftAdjoint_preservesColimits ((Over.forget V).sheafAdjunctionCocontinuous
