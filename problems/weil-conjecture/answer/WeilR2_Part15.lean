theorem wc_lsi_class_indep : ∀ {P M : Scheme.{u}} (p : P ⟶ M) (m q : ℕ) (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}) ℕ) (ι : (CochainComplex.single₀ (Sheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1})).obj (wcConstZ M m) ⟶ K), QuasiIso ι → ∀ (O : M.Etale) (h : P ⟶ O.left) (hh : h ≫ O.hom = (wcEtTop P).hom ≫ p) (s : (K.X q).obj.obj (Opposite.op O)), ((K.d q (q + 1)).hom.app (Opposite.op O)).hom s = 0 → ∀ (A₁ A₂ : wcR2gsAdjData p m) (R₁ R₂ : InjectiveResolution (wcConstZ P m)) (θ₁ : (A₁.L.mapHomologicalComplex (ComplexShape.up ℕ)).obj K ⟶ R₁.cocomplex) (θ₂ : (A₂.L.mapHomologicalComplex (ComplexShape.up ℕ)).obj K ⟶ R₂.cocomplex), A₁.L.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ M m)).inv ≫ ι.f 0) ≫ θ₁.f 0 = A₁.κ.hom ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ P m)).inv ≫ R₁.ι.f 0 → A₂.L.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ M m)).inv ≫ ι.f 0) ≫ θ₂.f 0 = A₂.κ.hom ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ P m)).inv ≫ R₂.ι.f 0 → ∀ (f₁ : wcEtUnitSheaf P ⟶ R₁.cocomplex.X q) (hf₁ : f₁ ≫ R₁.cocomplex.d q (q + 1) = 0) (f₂ : wcEtUnitSheaf P ⟶ R₂.cocomplex.X q) (hf₂ : f₂ ≫ R₂.cocomplex.d q (q + 1) = 0), (f₁.hom.app (Opposite.op (wcEtTop P))).hom (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1)) = ((θ₁.f q).hom.app (Opposite.op (wcEtTop P))).hom ((A₁.ρ (K.X q)).ρ O (wcEtTop P) h hh s) → (f₂.hom.app (Opposite.op (wcEtTop P))).hom (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1)) = ((θ₂.f q).hom.app (Opposite.op (wcEtTop P))).hom ((A₂.ρ (K.X q)).ρ O (wcEtTop P) h hh s) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) := HasExt.standard _; R₁.extMk f₁ (q + 1) rfl hf₁ = R₂.extMk f₂ (q + 1) rfl hf₂ :=
by
  intro P M p m q K ι hι O h hh s hs A₁ A₂ R₁ R₂ θ₁ θ₂ hθ₁ hθ₂ f₁ hf₁ f₂ hf₂ hv₁ hv₂
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) := HasExt.standard _

  have evb : ∀ (N : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : (constantSheaf (Scheme.smallEtaleTopology P)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ N =>
        (g.hom.app (Opposite.op (wcEtTop P))).hom
          (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))) := by
    intro N
    have hT : Limits.IsTerminal (wcEtTop P) :=
      @MorphismProperty.Over.mkIdTerminal Scheme _ @AlgebraicGeometry.Etale P
        MorphismProperty.IsMultiplicative.toContainsIdentities
    let adj := constantSheafAdj (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1} hT
    let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
      { toFun := fun φ => φ.hom (ULift.up 1)
        invFun := fun x => AddCommGrpCat.ofHom
          ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
        left_inv := fun φ => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          rintro ⟨n⟩
          have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
            apply ULift.ext
            simp
          change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
          rw [zmultiplesHom_apply, hn, map_zsmul]
        right_inv := fun x => by
          change (zmultiplesHom X x) (1 : ℤ) = x
          rw [zmultiplesHom_apply, one_zsmul] }
    have key : (fun g : (constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ N =>
          (g.hom.app (Opposite.op (wcEtTop P))).hom
            (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))) =
        ⇑((adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) N).trans
          (ev (N.obj.obj (Opposite.op (wcEtTop P))))) := by
      funext g
      rfl
    rw [key]
    exact Equiv.bijective _

  have hext : ∀ (N : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1})
      (φ₁ φ₂ : N ⟶ wcConstZ P m) (r : N.obj.obj (Opposite.op (wcEtTop P))), IsIso φ₁ →
      (φ₁.hom.app (Opposite.op (wcEtTop P))).hom r =
        wcConstSec P (ULift.{u+1} (ZMod m)) (wcEtTop P) (ULift.up 1) →
      (φ₂.hom.app (Opposite.op (wcEtTop P))).hom r =
        wcConstSec P (ULift.{u+1} (ZMod m)) (wcEtTop P) (ULift.up 1) → φ₁ = φ₂ := by
    intro N φ₁ φ₂ r hiso h₁ h₂
    haveI := hiso
    let rm : ULift.{u+1} ℤ →+ ULift.{u+1} (ZMod m) :=
      AddEquiv.ulift.symm.toAddMonoidHom.comp
        ((Int.castAddHom (ZMod m)).comp AddEquiv.ulift.toAddMonoidHom)
    let ιc : (constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ wcConstZ P m :=
      (constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).map (AddCommGrpCat.ofHom rm)
    have hsurj : Function.Surjective rm := by
      intro b
      obtain ⟨n, hn⟩ := ZMod.intCast_surjective b.down
      refine ⟨ULift.up n, ?_⟩
      apply ULift.ext
      exact hn
    haveI : Epi (AddCommGrpCat.ofHom rm) := (AddCommGrpCat.epi_iff_surjective _).2 hsurj
    haveI hιepi : Epi ιc := Functor.map_epi _ _
    have hr : rm (ULift.up 1) = ULift.up 1 := by
      show (ULift.up ((1 : ℤ) : ZMod m) : ULift.{u+1} (ZMod m)) = ULift.up 1
      rw [Int.cast_one]
    have hι1 : (ιc.hom.app (Opposite.op (wcEtTop P))).hom
        (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1)) =
        wcConstSec P (ULift.{u+1} (ZMod m)) (wcEtTop P) (ULift.up 1) := by
      have h := congrArg (fun φ => (φ.app (Opposite.op (wcEtTop P))).hom
          (ULift.up (1 : ℤ) : ULift.{u+1} ℤ))
        (toSheafify_naturality (Scheme.smallEtaleTopology P)
          ((Functor.const (P.Etale)ᵒᵖ).map (AddCommGrpCat.ofHom rm)))
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
        Functor.const_map_app, AddCommGrpCat.hom_ofHom] at h
      rw [hr] at h
      exact h.symm
    obtain ⟨η, hη⟩ := (evb N).2 r
    have hη' : (η.hom.app (Opposite.op (wcEtTop P))).hom
        (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1)) = r := hη
    have key : ∀ φ : N ⟶ wcConstZ P m, (φ.hom.app (Opposite.op (wcEtTop P))).hom r =
        wcConstSec P (ULift.{u+1} (ZMod m)) (wcEtTop P) (ULift.up 1) → η ≫ φ = ιc := by
      intro φ hφ
      apply (evb (wcConstZ P m)).1
      show (φ.hom.app (Opposite.op (wcEtTop P))).hom ((η.hom.app (Opposite.op (wcEtTop P))).hom
          (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))) =
        (ιc.hom.app (Opposite.op (wcEtTop P))).hom
          (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))
      rw [hη', hφ, hι1]
    have e1 := key φ₁ h₁
    have e2 := key φ₂ h₂
    have hηeq : ιc ≫ inv φ₁ = η := by
      rw [← e1, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    haveI : Epi η := by
      rw [← hηeq]
      infer_instance
    exact (cancel_epi η).1 (e1.trans e2.symm)

  have hzero : ∀ (F G : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1})
      (x : F.obj.obj (Opposite.op (wcEtTop P))),
      ((0 : F ⟶ G).hom.app (Opposite.op (wcEtTop P))).hom x = 0 := by
    intro F G x
    have h0 := Sheaf.Hom.add_app (0 : F ⟶ G) 0 (Opposite.op (wcEtTop P))
    rw [add_zero] at h0
    have h2 : (0 : F ⟶ G).hom.app (Opposite.op (wcEtTop P)) = 0 :=
      add_left_cancel (h0.symm.trans (add_zero _).symm)
    rw [h2]
    rfl

  have hcongr : ∀ (R : InjectiveResolution (wcConstZ P m)) (f f' : wcEtUnitSheaf P ⟶ R.cocomplex.X q)
      (_ : f = f') (hf : f ≫ R.cocomplex.d q (q + 1) = 0) (hf' : f' ≫ R.cocomplex.d q (q + 1) = 0),
      R.extMk f (q + 1) rfl hf = R.extMk f' (q + 1) rfl hf' := by
    intro R f f' e hf hf'
    subst e
    rfl

  have s3 : ∀ (K' J' : CochainComplex (Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) ℕ)
      [∀ n, Injective (J'.X n)] {M' : Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}}
      (a : M' ⟶ K'.X 0) (ha : a ≫ K'.d 0 1 = 0), (ShortComplex.mk a (K'.d 0 1) ha).Exact →
      (∀ k, (K'.sc' k (k + 1) (k + 2)).Exact) → ∀ (f g : K' ⟶ J'), a ≫ f.f 0 = a ≫ g.f 0 →
      Nonempty (Homotopy f g) := by
    intro K' J' _ M' a ha hex0 hK' f g hfg
    let φ := f - g
    have h0 : a ≫ φ.f 0 = 0 := by
      simp only [φ, HomologicalComplex.sub_f_apply, Preadditive.comp_sub, hfg, sub_self]
    let z : K'.X 1 ⟶ J'.X 0 := hex0.descToInjective (φ.f 0) h0
    have hz : K'.d 0 1 ≫ z = φ.f 0 := hex0.comp_descToInjective _ _
    have hK0 : (K'.sc' 0 1 2).Exact := hK' 0
    have h1 : K'.d 0 1 ≫ (φ.f 1 - z ≫ J'.d 0 1) = 0 := by
      rw [Preadditive.comp_sub, ← φ.comm 0 1, ← Category.assoc, hz, sub_self]
    let o : K'.X 2 ⟶ J'.X 1 := hK0.descToInjective (φ.f 1 - z ≫ J'.d 0 1) h1
    have ho : K'.d 1 2 ≫ o = φ.f 1 - z ≫ J'.d 0 1 := hK0.comp_descToInjective _ _
    refine ⟨Homotopy.equivSubZero.symm (Homotopy.mkCoinductive φ z hz.symm o
      (by rw [ho]; abel) (fun n pp => ?_))⟩
    have hKn : (K'.sc' (n + 1) (n + 2) (n + 3)).Exact := hK' (n + 1)
    have e' := congrArg (· ≫ J'.d (n + 1) (n + 2)) pp.2.2
    simp only [Preadditive.add_comp, Category.assoc, HomologicalComplex.d_comp_d, Limits.comp_zero,
      zero_add] at e'
    have hu : K'.d (n + 1) (n + 2) ≫ (φ.f (n + 2) - pp.2.1 ≫ J'.d (n + 1) (n + 2)) = 0 := by
      rw [Preadditive.comp_sub, ← φ.comm (n + 1) (n + 2), e', sub_self]
    refine ⟨hKn.descToInjective _ hu, ?_⟩
    have hw := hKn.comp_descToInjective _ hu
    change K'.d (n + 2) (n + 3) ≫ hKn.descToInjective _ hu = _ at hw
    rw [hw]
    abel

  have s4 : ∀ (q' : ℕ) (R : InjectiveResolution (wcConstZ P m))
      (L : CochainComplex (Sheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}) ℕ)
      (α β : L ⟶ R.cocomplex) (_ : Homotopy α β) (y : wcEtUnitSheaf P ⟶ L.X q')
      (_ : y ≫ L.d q' (q' + 1) = 0)
      (hα : (y ≫ α.f q') ≫ R.cocomplex.d q' (q' + 1) = 0)
      (hβ : (y ≫ β.f q') ≫ R.cocomplex.d q' (q' + 1) = 0),
      R.extMk (y ≫ α.f q') (q' + 1) rfl hα = R.extMk (y ≫ β.f q') (q' + 1) rfl hβ := by
    intro q' R L α β H y hy hα hβ
    have hcg : ∀ (f f' : wcEtUnitSheaf P ⟶ R.cocomplex.X q') (_ : f = f')
        (hf : f ≫ R.cocomplex.d q' (q' + 1) = 0) (hf' : f' ≫ R.cocomplex.d q' (q' + 1) = 0),
        R.extMk f (q' + 1) rfl hf = R.extMk f' (q' + 1) rfl hf' := by
      intro f f' e hf hf'
      subst e
      rfl
    have hc := H.comm q'
    rw [Homotopy.dNext_cochainComplex] at hc
    have hyα : y ≫ α.f q' = y ≫ prevD q' H.hom + y ≫ β.f q' := by
      rw [hc, Preadditive.comp_add, Preadditive.comp_add, ← Category.assoc, hy, Limits.zero_comp,
        zero_add]
    rcases q' with _ | k
    · apply hcg
      rw [hyα, Homotopy.prevD_zero_cochainComplex, Limits.comp_zero, zero_add]
    · rw [Homotopy.prevD_succ_cochainComplex] at hyα
      have hb : (y ≫ H.hom (k + 1) k ≫ R.cocomplex.d k (k + 1)) ≫
          R.cocomplex.d (k + 1) (k + 1 + 1) = 0 := by
        simp only [Category.assoc, HomologicalComplex.d_comp_d, Limits.comp_zero]
      rw [hcg _ _ hyα hα (by rw [Preadditive.add_comp, hb, hβ, add_zero]),
        ← R.add_extMk _ _ _ rfl hb hβ]
      have h0 : R.extMk (y ≫ H.hom (k + 1) k ≫ R.cocomplex.d k (k + 1)) (k + 1 + 1) rfl hb = 0 :=
        (R.extMk_eq_zero_iff _ _ rfl hb k rfl).2 ⟨y ≫ H.hom (k + 1) k, by rw [Category.assoc]⟩
      rw [h0, zero_add]

  obtain ⟨U₁, N₁⟩ := A₁.nut
  obtain ⟨_, N₂⟩ := A₂.nut
  choose σc hσc using fun G => (U₁ G (A₂.L.obj G) (A₂.ρ G)).exists
  let Tnat : ∀ (G G' : Sheaf (Scheme.smallEtaleTopology M) AddCommGrpCat.{u+1}) (_ : G ⟶ G'),
      wcEtTransport p G (A₂.L.obj G') := fun G G' ψ =>
    { ρ := fun V O k hk => ((A₂.ρ G').ρ V O k hk).comp (ψ.hom.app (Opposite.op V)).hom
      nat := by
        intro V V' c O O' d k hk k' hk' hc x
        have e : (ψ.hom.app (Opposite.op V')).hom ((G.obj.map c.op).hom x) =
            (G'.obj.map c.op).hom ((ψ.hom.app (Opposite.op V)).hom x) :=
          congrArg (fun t => t.hom x) (ψ.hom.naturality c.op)
        show ((A₂.ρ G').ρ V' O' k' hk') ((ψ.hom.app (Opposite.op V')).hom ((G.obj.map c.op).hom x)) =
          ((A₂.L.obj G').obj.map d.op).hom
            (((A₂.ρ G').ρ V O k hk) ((ψ.hom.app (Opposite.op V)).hom x))
        rw [e]
        exact (A₂.ρ G').nat V V' c O O' d k hk k' hk' hc _ }
  let σ : A₁.L ⟶ A₂.L :=
    { app := σc
      naturality := by
        intro G G' ψ
        refine (U₁ G (A₂.L.obj G') (Tnat G G' ψ)).unique ?_ ?_
        · intro V O k hk x
          show ((σc G').hom.app (Opposite.op O)).hom (((A₁.L.map ψ).hom.app (Opposite.op O)).hom
              ((A₁.ρ G).ρ V O k hk x)) = ((A₂.ρ G').ρ V O k hk) ((ψ.hom.app (Opposite.op V)).hom x)
          rw [← N₁ G G' ψ V O k hk x]
          exact hσc G' V O k hk _
        · intro V O k hk x
          show ((A₂.L.map ψ).hom.app (Opposite.op O)).hom (((σc G).hom.app (Opposite.op O)).hom
              ((A₁.ρ G).ρ V O k hk x)) = ((A₂.ρ G').ρ V O k hk) ((ψ.hom.app (Opposite.op V)).hom x)
          rw [hσc G V O k hk x]
          exact (N₂ G G' ψ V O k hk x).symm }
  have hg : p ≫ (wcEtTop M).hom = (wcEtTop P).hom ≫ p :=
    (Category.comp_id _).trans (Category.id_comp _).symm
  have hκ : A₁.κ.hom = σ.app (wcConstZ M m) ≫ A₂.κ.hom := by
    refine hext _ _ _ ((A₁.ρ (wcConstZ M m)).ρ (wcEtTop M) (wcEtTop P) p hg
      (wcConstSec M (ULift.{u+1} (ZMod m)) (wcEtTop M) (ULift.up 1))) inferInstance
      (A₁.kapNorm hg) ?_
    show (A₂.κ.hom.hom.app (Opposite.op (wcEtTop P))).hom
      (((σc (wcConstZ M m)).hom.app (Opposite.op (wcEtTop P))).hom
        ((A₁.ρ (wcConstZ M m)).ρ (wcEtTop M) (wcEtTop P) p hg
          (wcConstSec M (ULift.{u+1} (ZMod m)) (wcEtTop M) (ULift.up 1)))) = _
    exact (congrArg (fun t => (A₂.κ.hom.hom.app (Opposite.op (wcEtTop P))).hom t)
      (hσc (wcConstZ M m) (wcEtTop M) (wcEtTop P) p hg
        (wcConstSec M (ULift.{u+1} (ZMod m)) (wcEtTop M) (ULift.up 1)))).trans (A₂.kapNorm hg)

  let σK : (A₁.L.mapHomologicalComplex (ComplexShape.up ℕ)).obj K ⟶
      (A₂.L.mapHomologicalComplex (ComplexShape.up ℕ)).obj K :=
    (NatTrans.mapHomologicalComplex σ (ComplexShape.up ℕ)).app K
  let θ₂' := σK ≫ θ₂
  have eθ : ∀ n, θ₂'.f n = σ.app (K.X n) ≫ θ₂.f n := fun n => rfl
  have aug2 : A₁.L.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ M m)).inv ≫
      ι.f 0) ≫ θ₂'.f 0 = A₁.κ.hom ≫
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ P m)).inv ≫ R₂.ι.f 0 := by
    rw [eθ 0, ← Category.assoc, σ.naturality, Category.assoc, hθ₂, ← Category.assoc, ← hκ]

  let φ := InjectiveResolution.desc (𝟙 (wcConstZ P m)) R₂ R₁
  have hΦ0 : R₁.ι.f 0 ≫ φ.f 0 = R₂.ι.f 0 := by
    have := HomologicalComplex.congr_hom (InjectiveResolution.desc_commutes (𝟙 (wcConstZ P m)) R₂ R₁) 0
    simp only [HomologicalComplex.comp_f, CategoryTheory.Functor.map_id, HomologicalComplex.id_f,
      Category.id_comp] at this
    exact this
  let Φ : R₁.Hom R₂ (𝟙 (wcConstZ P m)) := InjectiveResolution.Hom.mk φ (by
    rw [hΦ0, CategoryTheory.Functor.map_id, HomologicalComplex.id_f, Category.id_comp])
  have hφ1 : (f₁ ≫ φ.f q) ≫ R₂.cocomplex.d q (q + 1) = 0 := by
    rw [Category.assoc, φ.comm, ← Category.assoc, hf₁, Limits.zero_comp]
  have E1 : R₁.extMk f₁ (q + 1) rfl hf₁ = R₂.extMk (f₁ ≫ φ.f q) (q + 1) rfl hφ1 := by
    have := InjectiveResolution.extMk_comp_mk₀ f₁ (q + 1) rfl hf₁ Φ
    rw [Abelian.Ext.comp_mk₀_id] at this
    exact this
  have aug1 : A₁.L.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ M m)).inv ≫
      ι.f 0) ≫ (θ₁ ≫ φ).f 0 = A₁.κ.hom ≫
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (wcConstZ P m)).inv ≫ R₂.ι.f 0 := by
    rw [HomologicalComplex.comp_f, ← Category.assoc, hθ₁, Category.assoc, Category.assoc, hΦ0]
  have hfg : A₁.L.map (ι.f 0) ≫ θ₂'.f 0 = A₁.L.map (ι.f 0) ≫ (θ₁ ≫ φ).f 0 := by
    have := aug2.trans aug1.symm
    rw [A₁.L.map_comp, Category.assoc, Category.assoc] at this
    exact (cancel_epi _).1 this

  have hqa : ∀ i, QuasiIsoAt ι i := by
    have h' := hι
    rw [quasiIso_iff] at h'
    exact h'
  have hK : ∀ k : ℕ, (K.sc' k (k + 1) (k + 2)).Exact := by
    intro k
    have h2 := (quasiIsoAt_iff_exactAt ι (k + 1)
      (CochainComplex.exactAt_succ_single_obj _ k)).1 (hqa (k + 1))
    exact (HomologicalComplex.exactAt_iff' K k (k + 1) (k + 2) (by simp) (by simp)).1 h2
  have hz0 : ι.f 0 ≫ K.d 0 1 = 0 := by
    rw [ι.comm 0 1, HomologicalComplex.single_obj_d, Limits.zero_comp]
  have hex0 : (ShortComplex.mk (ι.f 0) (K.d 0 1) hz0).Exact := by
    have hf1 : ((CochainComplex.single₀ (Sheaf (Scheme.smallEtaleTopology M)
        AddCommGrpCat.{u+1})).obj (wcConstZ M m)).d 0 0 = 0 :=
      HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 _ 0 0
    have hg1 : ((CochainComplex.single₀ (Sheaf (Scheme.smallEtaleTopology M)
        AddCommGrpCat.{u+1})).obj (wcConstZ M m)).d 0 1 = 0 :=
      HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 _ 0 1
    have h0 := hqa 0
    rw [CochainComplex.quasiIsoAt₀_iff] at h0
    exact ((ShortComplex.quasiIso_iff_of_zeros _ hf1 hg1 (K.shape 0 0 (by simp))).1 h0).1
  let LK := (A₁.L.mapHomologicalComplex (ComplexShape.up ℕ)).obj K
  have hLK : ∀ k : ℕ, (LK.sc' k (k + 1) (k + 2)).Exact := fun k => (hK k).map A₁.L
  have ha : A₁.L.map (ι.f 0) ≫ LK.d 0 1 = 0 := by
    show A₁.L.map (ι.f 0) ≫ A₁.L.map (K.d 0 1) = 0
    rw [← A₁.L.map_comp, hz0, A₁.L.map_zero]
  have hLex0 : (ShortComplex.mk (A₁.L.map (ι.f 0)) (LK.d 0 1) ha).Exact := hex0.map A₁.L

  obtain ⟨H⟩ := s3 LK R₂.cocomplex (A₁.L.map (ι.f 0)) ha hLex0 hLK θ₂' (θ₁ ≫ φ) hfg

  obtain ⟨y, hyv⟩ := (evb (A₁.L.obj (K.X q))).2 ((A₁.ρ (K.X q)).ρ O (wcEtTop P) h hh s)
  replace hyv : (y.hom.app (Opposite.op (wcEtTop P))).hom
      (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1)) =
      (A₁.ρ (K.X q)).ρ O (wcEtTop P) h hh s := hyv
  have hy : y ≫ LK.d q (q + 1) = 0 := by
    apply (evb _).1
    show ((A₁.L.map (K.d q (q + 1))).hom.app (Opposite.op (wcEtTop P))).hom
        ((y.hom.app (Opposite.op (wcEtTop P))).hom
          (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))) =
      ((0 : wcEtUnitSheaf P ⟶ A₁.L.obj (K.X (q + 1))).hom.app (Opposite.op (wcEtTop P))).hom
        (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))
    rw [hyv, ← N₁ _ _ (K.d q (q + 1)) O (wcEtTop P) h hh s, hs, map_zero, hzero]
  have Y2 : f₂ = y ≫ θ₂'.f q := by
    apply (evb _).1
    show (f₂.hom.app (Opposite.op (wcEtTop P))).hom
        (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1)) =
      ((θ₂.f q).hom.app (Opposite.op (wcEtTop P))).hom
        (((σc (K.X q)).hom.app (Opposite.op (wcEtTop P))).hom
          ((y.hom.app (Opposite.op (wcEtTop P))).hom
            (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))))
    rw [hv₂, hyv]
    exact (congrArg (fun t => ((θ₂.f q).hom.app (Opposite.op (wcEtTop P))).hom t)
      (hσc (K.X q) O (wcEtTop P) h hh s)).symm
  have Y1 : f₁ ≫ φ.f q = y ≫ (θ₁ ≫ φ).f q := by
    apply (evb _).1
    show ((φ.f q).hom.app (Opposite.op (wcEtTop P))).hom ((f₁.hom.app (Opposite.op (wcEtTop P))).hom
        (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))) =
      ((φ.f q).hom.app (Opposite.op (wcEtTop P))).hom
        (((θ₁.f q).hom.app (Opposite.op (wcEtTop P))).hom
          ((y.hom.app (Opposite.op (wcEtTop P))).hom
            (wcConstSec P (ULift.{u+1} ℤ) (wcEtTop P) (ULift.up 1))))
    rw [hv₁, hyv]

  have hα : (y ≫ θ₂'.f q) ≫ R₂.cocomplex.d q (q + 1) = 0 := by
    rw [← Y2]
    exact hf₂
  have hβ : (y ≫ (θ₁ ≫ φ).f q) ≫ R₂.cocomplex.d q (q + 1) = 0 := by
    rw [← Y1]
    exact hφ1
  have S4 := s4 q R₂ LK θ₂' (θ₁ ≫ φ) H y hy hα hβ
  rw [E1]
  exact (hcongr R₂ _ _ Y1 hφ1 hβ).trans (S4.symm.trans (hcongr R₂ _ _ Y2.symm hα hf₂))

theorem wc_lsi_adjdata_exists : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (m : ℕ), Nonempty (wcR2gsAdjData g m) :=
by
  intro S Z g m
  haveI := wc_et_basechange_isContinuous g
  obtain ⟨L, ⟨adj⟩, hLlim, -⟩ := wc_et_push_left_adjoint g
  haveI := hLlim
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L
  haveI : Limits.PreservesColimits L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := inferInstance
  obtain ⟨ρ, hu, hn⟩ := wc_et_adjoint_univ_transport g L ⟨adj⟩
  have hg : g ≫ (wcEtTop S).hom = (wcEtTop Z).hom ≫ g :=
    (Category.comp_id _).trans (Category.id_comp _).symm
  obtain ⟨ε, hε⟩ := (wc_et_const_hom_eval_bij Z (L.obj (wcR2gsZ S))).2
    ((ρ (wcR2gsZ S)).ρ (wcEtTop S) (wcEtTop Z) g hg
      (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1)))
  obtain ⟨κ, hκ⟩ := wc_r2gs_adj_const_zmod_norm g m L ⟨adj⟩ ρ ⟨hu, hn⟩
  exact ⟨wcR2gsAdjData.mk L ⟨adj⟩ inferInstance inferInstance inferInstance ρ ⟨hu, hn⟩ ε
    (fun _ => hε) κ hκ⟩

theorem wc_lsi_etale_inv_injective : ∀ {T : Scheme.{u}} (V : T.Etale) (Q : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}), Injective Q → Injective ((wcEtInv V.hom).obj Q) :=
by
  intro T V Q hQ
  haveI := (wc_et_slice_continuous V).1
  haveI := wc_et_slice_lan_finite_limits V
  haveI := hQ
  haveI : ((wcEtSlice V).op.lan : ((V.left.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((T.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})).PreservesMonomorphisms :=
    preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : (Functor.sheafPullbackConstruction.sheafPullback (wcEtSlice V) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology T)).PreservesMonomorphisms :=
    Functor.preservesMonomorphisms_comp (sheafToPresheaf _ _) ((wcEtSlice V).op.lan ⋙ presheafToSheaf _ _)
  let adj : wcEtSlice V ⊣ wcEtBaseChange V.hom :=
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) V.hom := ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) V.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong V.hom)) (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    MorphismProperty.Over.mapPullbackAdj (@Etale : MorphismProperty Scheme.{u}) ⊤ V.hom V.prop trivial
  let e : (wcEtInv V.hom).obj Q ≅ ((wcEtSlice V).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology T)).obj Q :=
    (presheafToSheaf (Scheme.smallEtaleTopology V.left) AddCommGrpCat.{u+1}).mapIso
      ((Adjunction.leftAdjointUniq ((wcEtBaseChange V.hom).op.lanAdjunction AddCommGrpCat.{u+1})
        (Adjunction.whiskerLeft AddCommGrpCat.{u+1} adj.op)).app Q.obj) ≪≫
    (sheafificationIso (((wcEtSlice V).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology T)).obj Q)).symm
  exact Injective.of_iso e.symm (Injective.injective_of_adjoint
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtSlice V) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology T)) Q)

theorem wc_lsi_exact_aug_quasiIso : ∀ {C D : Type*} [Category C] [Abelian C] [Category D] [Abelian D] (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] (M : C) (K : CochainComplex C ℕ) (ι : (CochainComplex.single₀ C).obj M ⟶ K), QuasiIso ι → ∀ (M' : D) (κ : F.obj M ≅ M'), ∃ e : (CochainComplex.single₀ D).obj M' ⟶ (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K, e.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M').hom ≫ κ.inv ≫ F.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ι.f 0) ∧ QuasiIso e :=
by
  intro C D _ _ _ _ F _ _ _ M K ι hι M' κ
  have := hι
  refine ⟨(CochainComplex.single₀ D).map κ.inv ≫
      (HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℕ) 0).inv.app M ≫
      (F.mapHomologicalComplex (ComplexShape.up ℕ)).map ι, ?_, inferInstance⟩
  rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, HomologicalComplex.single_map_f_self,
    HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
    Functor.mapHomologicalComplex_map_f, Functor.map_comp]
  simp

theorem wc_lsi_sections_ext_bij : ∀ {Y : Scheme.{u}} (Kc : CochainComplex ((Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ℕ) (q : ℕ) (V : Scheme.Etale Y) {C : Type*} [Category C] [Abelian C] [HasExt C] {X Z : C} (R : InjectiveResolution Z) (τ : ∀ n, (Kc.X n).obj (Opposite.op V) →+ (X ⟶ R.cocomplex.X n)), (∀ n, Function.Bijective (τ n)) → (∀ (n : ℕ) (s : (Kc.X n).obj (Opposite.op V)), τ (n + 1) (((Kc.d n (n + 1)).app (Opposite.op V)).hom s) = τ n s ≫ R.cocomplex.d n (n + 1)) → ∃ κ : (Kc.homology q).obj (Opposite.op V) →+ Abelian.Ext X Z q, Function.Bijective κ ∧ ∀ (cy : (Kc.cycles q).obj (Opposite.op V)) (hf : τ q (((Kc.iCycles q).app (Opposite.op V)).hom cy) ≫ R.cocomplex.d q (q + 1) = 0), κ (((Kc.homologyπ q).app (Opposite.op V)).hom cy) = R.extMk (τ q (((Kc.iCycles q).app (Opposite.op V)).hom cy)) (q + 1) rfl hf :=
by
  intro Y Kc q V C _ _ _ X Z R τ hτ hcomm
  let ev := (evaluation (Scheme.Etale Y)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)

  have hπs : Function.Surjective ((Kc.homologyπ q).app (Opposite.op V)).hom := by
    have h1 : Epi ((Kc.homologyπ q).app (Opposite.op V)) :=
      (NatTrans.epi_iff_epi_app _).1 inferInstance (Opposite.op V)
    exact (AddCommGrpCat.epi_iff_surjective _).1 h1

  have hi : Function.Injective ((Kc.iCycles q).app (Opposite.op V)).hom := by
    have h1 : Mono ((Kc.iCycles q).app (Opposite.op V)) :=
      (NatTrans.mono_iff_mono_app _).1 inferInstance (Opposite.op V)
    exact (AddCommGrpCat.mono_iff_injective _).1 h1

  have hlift : ∀ s : (Kc.X q).obj (Opposite.op V),
      ((Kc.d q (q + 1)).app (Opposite.op V)).hom s = 0 →
      ∃ x, ((Kc.iCycles q).app (Opposite.op V)).hom x = s := by
    have hS : (ShortComplex.mk (Kc.iCycles q) (Kc.d q (q + 1)) (by simp)).Exact :=
      ShortComplex.exact_of_f_is_kernel _ (Kc.cyclesIsKernel q (q + 1) (by simp))
    have hS' := hS.map ev
    rw [ShortComplex.ab_exact_iff] at hS'
    intro s hs
    exact hS' s hs

  have hcrit : ∀ p, (ComplexShape.up ℕ).prev q = p → ∀ x,
      ((Kc.homologyπ q).app (Opposite.op V)).hom x = 0 ↔
        ∃ b : (Kc.X p).obj (Opposite.op V), ((Kc.d p q).app (Opposite.op V)).hom b =
          ((Kc.iCycles q).app (Opposite.op V)).hom x := by
    intro p hp x
    have hS : (ShortComplex.mk (Kc.toCycles p q) (Kc.homologyπ q) (by simp)).Exact :=
      ShortComplex.exact_of_g_is_cokernel _ (Kc.homologyIsCokernel p q hp)
    have hS' := hS.map ev
    rw [ShortComplex.ab_exact_iff] at hS'
    have hti : ∀ b : (Kc.X p).obj (Opposite.op V),
        ((Kc.iCycles q).app (Opposite.op V)).hom (((Kc.toCycles p q).app (Opposite.op V)).hom b)
          = ((Kc.d p q).app (Opposite.op V)).hom b := by
      intro b
      rw [← Kc.toCycles_i p q]
      rfl
    constructor
    · intro hx
      obtain ⟨b, hb⟩ := hS' x hx
      refine ⟨b, ?_⟩
      rw [← hti]
      exact congrArg _ hb
    · rintro ⟨b, hb⟩
      have hbx : ((Kc.toCycles p q).app (Opposite.op V)).hom b = x := by
        apply hi
        rw [hti, hb]
      rw [← hbx]
      have h0 : ((Kc.toCycles p q ≫ Kc.homologyπ q).app (Opposite.op V)).hom b = 0 := by
        rw [Kc.toCycles_comp_homologyπ]; simp
      exact h0

  have hd0 : ∀ z : (Kc.cycles q).obj (Opposite.op V),
      ((Kc.d q (q + 1)).app (Opposite.op V)).hom (((Kc.iCycles q).app (Opposite.op V)).hom z) = 0 := by
    intro z
    have h : ((Kc.iCycles q ≫ Kc.d q (q + 1)).app (Opposite.op V)).hom z = 0 := by
      rw [Kc.iCycles_d]; simp
    exact h
  have hz : ∀ z : (Kc.cycles q).obj (Opposite.op V),
      τ q (((Kc.iCycles q).app (Opposite.op V)).hom z) ≫ R.cocomplex.d q (q + 1) = 0 := by
    intro z
    rw [← hcomm, hd0, map_zero]
  have hcong : ∀ (f f' : X ⟶ R.cocomplex.X q) (_ : f = f') (hf : f ≫ R.cocomplex.d q (q + 1) = 0)
      (hf' : f' ≫ R.cocomplex.d q (q + 1) = 0), R.extMk f (q + 1) rfl hf = R.extMk f' (q + 1) rfl hf' := by
    intro f f' h _ _
    subst h
    rfl

  have hker : ∀ z : (Kc.cycles q).obj (Opposite.op V),
      ((Kc.homologyπ q).app (Opposite.op V)).hom z = 0 ↔
        R.extMk (τ q (((Kc.iCycles q).app (Opposite.op V)).hom z)) (q + 1) rfl (hz z) = 0 := by
    intro z
    cases q with
    | zero =>
      have hd00 : Kc.d 0 0 = 0 := Kc.shape 0 0 (by simp)
      have hπ0 : ((Kc.homologyπ 0).app (Opposite.op V)).hom z = 0 ↔ z = 0 := by
        rw [hcrit 0 (by simp) z, hd00]
        constructor
        · rintro ⟨b, hb⟩
          apply hi
          rw [map_zero, ← hb]
          rfl
        · intro h
          refine ⟨0, ?_⟩
          rw [h, map_zero, map_zero]
      rw [hπ0]
      constructor
      · intro h
