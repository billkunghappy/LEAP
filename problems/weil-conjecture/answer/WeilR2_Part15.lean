          (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
          (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
      haveI : E.IsEquivalence := eqv.isEquivalence_functor
      haveI : E.IsLeftAdjoint := Functor.isLeftAdjoint_of_isEquivalence
      haveI : E.Initial := Functor.initial_of_isLeftAdjoint E
      haveI : E.op.Final := Functor.final_op_of_initial E
      let i0 := Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) E.op
      let i1 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
          (StructuredArrow.proj (Over.mk (wcEtGeomPt Z y)) (Scheme.Etale.forget Z)).op ⋙
            Limits.colim ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (Functor.Elements.π Φ.fiber).op ⋙
            Limits.colim :=
        Functor.isoWhiskerLeft ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
          (Functor.Elements.π Φ.fiber).op) i0
      let j : Φ.sheafFiber (A := AddCommGrpCat.{u+1}) ≅ wcEtStalk Z y :=
        Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
          i1.symm
      exact ⟨Limits.preservesFiniteLimits_of_natIso j, Limits.preservesFiniteColimits_of_natIso j⟩
    haveI := hex2.1
    haveI := hex2.2
    let F := wcEtStalk Z y
    let C := Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}
    let ψ' := HomologicalComplex.extendMap ψ ComplexShape.embeddingUpNat
    let T := DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle ψ')
    have hT : T ∈ Pretriangulated.distinguishedTriangles :=
      DerivedCategory.mappingCone_triangle_distinguished ψ'
    have hiso : ∀ n : ℤ, IsIso (F.map ((DerivedCategory.homologyFunctor C n).map T.mor₁)) := by
      intro n
