theorem wc_et_module_unit_hom_stalk_zero_of_level : ∀ (Y : Scheme.{u}) (m : ℕ) (x : Y) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)), W'.Initial → ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y m)) (κ : SheafOfModules.unit (wcEtZModRing Y m) ⟶ M) (l : Λ), (κ.val.app (Opposite.op (W'.obj l).right)).hom (1 : (wcEtZModRing Y m).obj.obj (Opposite.op (W'.obj l).right)) = 0 → (wcEtStalk Y x).map ((SheafOfModules.toSheaf (wcEtZModRing Y m)).map κ) = 0 :=
