theorem wc_pencil_shens_odp_fibre_point_unique : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left), wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a → ∀ (x y : ↥(Limits.pullback D.f a)), Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'') → Limits.pullback.fst D.f a y = D.xs i (IsLocalRing.closedPoint F'') → x = y :=
by

  have vnr : ∀ (Y : Scheme.{u}) (x y : Y) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Y), wcHalShData y A Λ W' φ a → IsAffine (Limits.pullback (Y.fromSpecResidueField x) a) ∧ ∀ g : Γ(Limits.pullback (Y.fromSpecResidueField x) a, ⊤), ∃ s : Γ(Limits.pullback (Y.fromSpecResidueField x) a, ⊤), g * g * s = g := by
    intro Y x y A _ _ _ Λ _ _ W' φ a hd
    obtain ⟨-, haff, hcomp, hφa, hlim, -⟩ := hd
    haveI hiaff : IsAffineHom (Y.fromSpecResidueField x) := by
      constructor
      intro U _
      have hsub : ∀ p q : PrimeSpectrum (Y.residueField x), p = q := by
        intro p q
        apply PrimeSpectrum.ext
        rw [Ideal.eq_bot_of_prime p.asIdeal, Ideal.eq_bot_of_prime q.asIdeal]
      by_cases h : ∃ p, p ∈ (Y.fromSpecResidueField x) ⁻¹ᵁ U
      · obtain ⟨p, hp⟩ := h
        have htop : (Y.fromSpecResidueField x) ⁻¹ᵁ U = ⊤ := by
          ext q
