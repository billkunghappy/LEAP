  have hmonoκ : ∀ n, Mono (κ.app n) := fun n => Subobject.arrow_mono _
  have hepi : Epi (Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
      (Limits.Cocone.mk _ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology (wcP1Over F'').left)
        (Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
          (Limits.Cocone.mk _ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W₁ f hW₁
      haveI : CompactSpace W₁.left := inferInstance
      obtain ⟨m, t, ht⟩ := hbd W₁ inferInstance
        (((Subobject.underlying.obj M).obj.map f.op).hom s)
      obtain ⟨e, hnat, -⟩ := proet_free_sheaf_hom_equiv (wcP1Over F'').left W₁
      let gs := (e (Subobject.underlying.obj M)).symm
        (((Subobject.underlying.obj M).obj.map f.op).hom s)
      let gt := (e (Subobject.underlying.obj J)).symm t
      have hcomm : gt ≫ J.arrow = gs ≫ ((ℓ ^ m : ℕ) • 𝟙 (Subobject.underlying.obj M)) := by
        apply (e (Subobject.underlying.obj M)).injective
        rw [hnat, hnat, Equiv.apply_symm_apply, Equiv.apply_symm_apply, hns]
        exact ht
      have hPm := Subobject.isPullback ((ℓ ^ m : ℕ) • 𝟙 (Subobject.underlying.obj M)) J
      let g' := hPm.lift gt gs hcomm
      have hg' : g' ≫ κ.app m = gs := hPm.lift_snd _ _ _
      refine ⟨(Limits.colimit.ι (Monotone.functor hmono ⋙ Subobject.underlying) m).hom.app
        (Opposite.op W₁) (e _ g'), ?_⟩
      change (Limits.colimit.ι (Monotone.functor hmono ⋙ Subobject.underlying) m ≫
          Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
            (Limits.Cocone.mk _ κ)).hom.app (Opposite.op W₁) (e _ g') = _
      rw [Limits.colimit.ι_desc]
      change (κ.app m).hom.app (Opposite.op W₁) (e _ g') = _
      rw [← hnat, hg']
      exact Equiv.apply_symm_apply (e (Subobject.underlying.obj M)) _
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls
  obtain ⟨hκ⟩ := crit _ _ κ hmonoκ hepi

  have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP) ⟶ c.pt,
        ∃ (n : ℕ) (g' : wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
          G.obj n), g = g' ≫ c.ι.app n :=
    fun G c hc => (proet_free_hom_seq_colimit (wcP1Over F'').left
      (wcGeomPoint F'' (wcP1Over F'') hP) G c hc).1
  have H1lift : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
        (α : G ⟶ I), Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
            (wcGeomPoint F'' (wcP1Over F'') hP)) c.pt (k + 1)), x = 0 := by
    intro G
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    exact ⟨I, α, hα, fun c hc k x => proet_ext_colimit_injectives_vanish (wcP1Over F'').left
      (wcGeomPoint F'' (wcP1Over F'') hP) I hI c hc k x⟩
  have s7 : ∀ {X Y : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {n : ℕ} (x : Abelian.Ext X Y n) (m : ℕ),
      x.comp (Abelian.Ext.mk₀ (m • 𝟙 Y)) (add_zero n) = m • x := by
    intro X Y n x m
    induction m with
