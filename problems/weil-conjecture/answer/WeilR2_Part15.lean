theorem wc_et_open_slice_unit_iso_of_factor : ∀ {X : Scheme.{u}} (T : X.Etale) [Mono T.hom] [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] [(wcEtBaseChange T.hom).IsContinuous (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology T.left)], ∃ η : 𝟭 (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ⟶ (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) ⋙ wcEtPush T.hom, ∀ (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (V : X.Etale), (∃ s : V.left ⟶ T.left, s ≫ T.hom = V.hom) → IsIso ((η.app G).hom.app (Opposite.op V)) :=
