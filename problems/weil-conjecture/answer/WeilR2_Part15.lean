        (wcQmInv g).map hl.cyclesIso.inv ≫ (wcQmInv g).map (C.sc q).homologyπ :=
      (((wcQmInv g).map_comp _ _).symm.trans (congrArg (wcQmInv g).map c3)).trans
        ((wcQmInv g).map_comp _ _)
    have s2 := congrArg (fun k => (hl.map (wcQmInv g)).cyclesIso.hom ≫ k) s3
