      have h2 : ((Scheme.ΓSpecIso (.of Ω)).inv).hom.Etale :=
        RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
      have h3 : ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.Etale := by
        rw [CommRingCat.hom_comp]
        exact RingHom.Etale.stableUnderComposition _ _ h2 h1
      letI := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.toAlgebra
      have hE : Algebra.Etale Ω Γ(E, ⊤) := RingHom.Etale.toAlgebra h3
      obtain ⟨I, _, Ai, _, _, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod Ω Γ(E, ⊤)).mp hE
      refine ⟨e.symm (fun i => (e g i)⁻¹), ?_⟩
      apply e.injective
      rw [map_mul, map_mul, AlgEquiv.apply_symm_apply]
      funext i
      simp only [Pi.mul_apply]
      exact mul_self_mul_inv _
    have hw : ∀ {l l' : Λ} (t : l ⟶ l'),
        (W'.map t).right.left ≫ (W'.obj l').right.hom = (W'.obj l).right.hom := by
      intro l l' t
      have := (W'.map t).right.w
      simpa using this
    let h : ∀ l, (W'.obj l).right.left ⟶ Y := fun l => (W'.obj l).right.hom
    let mp : ∀ {l l' : Λ} (t : l ⟶ l'), Limits.pullback (Y.fromSpecResidueField x) (h l) ⟶
        Limits.pullback (Y.fromSpecResidueField x) (h l') :=
      fun t =>
      Limits.pullback.lift (Limits.pullback.fst _ _)
        (Limits.pullback.snd _ _ ≫ (W'.map t).right.left)
        (by rw [Category.assoc, hw t]; exact Limits.pullback.condition)
    have mp_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
        mp t ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ :=
      fun t => Limits.pullback.lift_fst _ _ _
    have mp_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
        mp t ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ (W'.map t).right.left := fun t =>
      Limits.pullback.lift_snd _ _ _
    let G : Λ ⥤ Scheme.{u} :=
      { obj := fun l => Limits.pullback (Y.fromSpecResidueField x) (h l)
        map := fun t => mp t
        map_id := fun l => by
          apply Limits.pullback.hom_ext
          · rw [mp_fst, Category.id_comp]
          · rw [mp_snd, Category.id_comp, W'.map_id]
            rfl
        map_comp := fun {l₁ l₂ l₃} t₁ t₂ => by
          apply Limits.pullback.hom_ext
          · rw [mp_fst, Category.assoc, mp_fst, mp_fst]
          · rw [mp_snd, Category.assoc, mp_snd, ← Category.assoc, mp_snd, Category.assoc,
              W'.map_comp]
            rfl }
    have Gmap_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
        G.map t ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') =
          Limits.pullback.fst (Y.fromSpecResidueField x) (h l) := mp_fst
    have Gmap_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
        G.map t ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l') =
          Limits.pullback.snd (Y.fromSpecResidueField x) (h l) ≫ (W'.map t).right.left := mp_snd
    let ψ : ∀ l, Limits.pullback (Y.fromSpecResidueField x) a ⟶ G.obj l := fun l =>
      Limits.pullback.lift (Limits.pullback.fst (Y.fromSpecResidueField x) a)
        (Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ φ l)
        (by rw [Category.assoc]; erw [hφa l]; exact Limits.pullback.condition)
    have ψ_fst : ∀ l, ψ l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
        Limits.pullback.fst (Y.fromSpecResidueField x) a :=
      fun l => Limits.pullback.lift_fst _ _ _
    have ψ_snd : ∀ l, ψ l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l) =
        Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ φ l := fun l =>
      Limits.pullback.lift_snd _ _ _
    let sG : ∀ l, G.obj l ⟶ Spec (Y.residueField x) := fun l =>
      Limits.pullback.fst (Y.fromSpecResidueField x) (h l)
    have hGaff : ∀ l, IsAffine (G.obj l) := by
      intro l
      haveI := haff l
      show IsAffine (Limits.pullback (Y.fromSpecResidueField x) (h l))
      infer_instance
    have hGet : ∀ l, Etale (sG l) := by
      intro l
      haveI : Etale (h l) := (W'.obj l).right.prop
      show Etale (Limits.pullback.fst (Y.fromSpecResidueField x) (h l))
      infer_instance
    have hψc : ∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l' := by
      intro l l' t
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Gmap_fst, ψ_fst, ψ_fst]
      · rw [Category.assoc, Gmap_snd, ← Category.assoc, ψ_snd, Category.assoc, hcomp, ψ_snd]
    have hψlim : ∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
        (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') →
          ∃! z₀ : T ⟶ Limits.pullback (Y.fromSpecResidueField x) a, ∀ l, z₀ ≫ ψ l = zz l := by
      intro T zz hzz
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      have hfst1 : ∀ {l l' : Λ} (t : l ⟶ l'),
          zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
            zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') := by
        intro l l' t
        rw [← hzz t, Category.assoc, Gmap_fst]
      have hfst : ∀ l l' : Λ,
          zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
            zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') := by
        intro l l'
        rw [← hfst1 (IsCofiltered.minToLeft l l'), hfst1 (IsCofiltered.minToRight l l')]
      let v : T ⟶ Spec (Y.residueField x) :=
        zz l₀ ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l₀)
      have hzz' : ∀ {l l' : Λ} (t : l ⟶ l'),
          (zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l)) ≫ (W'.map t).right.left =
            zz l' ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l') := by
        intro l l' t
        rw [← hzz t, Category.assoc, Category.assoc, Gmap_snd]
      obtain ⟨w, hw1, hw2⟩ :=
        hlim T (fun l => zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l)) hzz'
      have hwa : v ≫ Y.fromSpecResidueField x = w ≫ a := by
        rw [← hφa l₀, ← Category.assoc, hw1 l₀]
        simp only [v, Category.assoc]
        exact congrArg (zz l₀ ≫ ·) Limits.pullback.condition
      refine ⟨Limits.pullback.lift v w hwa, fun l => ?_, fun z₁ hz₁ => ?_⟩
      · apply Limits.pullback.hom_ext
        · rw [Category.assoc, ψ_fst, Limits.pullback.lift_fst]
          exact hfst l₀ l
        · rw [Category.assoc, ψ_snd, ← Category.assoc, Limits.pullback.lift_snd]
          exact hw1 l
      · apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← ψ_fst l₀, ← Category.assoc, hz₁ l₀]
        · rw [Limits.pullback.lift_snd]
          apply hw2
          intro l
          rw [Category.assoc, ← ψ_snd, ← Category.assoc, hz₁ l]
    intro g
    obtain ⟨l, g₀, hg⟩ := s1 G (Limits.pullback (Y.fromSpecResidueField x) a) ψ hGaff hψc hψlim g
    haveI := hGaff l
    obtain ⟨t₀, ht₀⟩ := s3 (Y.residueField x) (G.obj l) (sG l) (hGet l) g₀
    refine ⟨(ψ l).appTop t₀, ?_⟩
    rw [← hg, ← map_mul, ← map_mul, ht₀]

  have main : ∀ {P X : Scheme.{u}} (F'' : Type u) [Field F''] (hom : P ⟶ Spec (.of F''))
      (f : X ⟶ P) (S : Spec (.of F'') ⟶ P), S ≫ hom = 𝟙 _ → ∀ (xs : Spec (.of F'') ⟶ X), xs ≫ f = S →
      ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt P (S (IsLocalRing.closedPoint F''))))
        (Scheme.Etale.forget P))
      (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ P),
      wcHalShData (S (IsLocalRing.closedPoint F'')) A Λ W' φ a → ∀ (x y : ↥(Limits.pullback f a)),
      Limits.pullback.fst f a x = xs (IsLocalRing.closedPoint F'') →
      Limits.pullback.fst f a y = xs (IsLocalRing.closedPoint F'') → x = y := by
    intro P X F'' _ hom f S hS xs hxs A _ _ _ Λ _ _ W' φ a hA x y hx hy
    have comp_ap : ∀ {X₁ Y₁ Z₁ : Scheme.{u}} (f₁ : X₁ ⟶ Y₁) (g₁ : Y₁ ⟶ Z₁) (x₁ : X₁),
        (f₁ ≫ g₁) x₁ = g₁ (f₁ x₁) := by
      intro X₁ Y₁ Z₁ f₁ g₁ x₁
      first
      | rfl
      | simp
    have hγ : ∀ (B : Scheme.{u}) (c : B) (t : Spec (.of (AlgebraicClosure (B.residueField c)))),
        wcEtGeomPt B c t = c := by
      intro B c t
      first
      | exact Scheme.fromSpecResidueField_apply c _
      | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
      | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
      | (simp [wcEtGeomPt])

    have s1 : ∀ (V : Scheme.{u}) [IsAffine V], (∀ g : Γ(V, ⊤), ∃ s : Γ(V, ⊤), g * g * s = g) →
        ∀ v w : V, v ⤳ w → v = w := by
      intro V _ hV v w hvw
      have h1 : V.isoSpec.hom v ⤳ V.isoSpec.hom w := hvw.map V.isoSpec.hom.continuous
      have h2 : (V.isoSpec.hom v).asIdeal ≤ (V.isoSpec.hom w).asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((PrimeSpectrum.le_iff_specializes _ _).mpr h1)
      have h3 : (V.isoSpec.hom w).asIdeal ≤ (V.isoSpec.hom v).asIdeal := by
        intro g hg
        obtain ⟨s, hs⟩ := hV g
        have h0 : g * (g * s - 1) ∈ (V.isoSpec.hom v).asIdeal := by
          have : g * (g * s - 1) = 0 := by rw [mul_sub, ← mul_assoc, hs, mul_one, sub_self]
          rw [this]; exact Ideal.zero_mem _
        rcases (V.isoSpec.hom v).isPrime.mem_or_mem h0 with h | h
        · exact h
        · exfalso
          have h4 : g * s - 1 ∈ (V.isoSpec.hom w).asIdeal := h2 h
          have h5 : g * s ∈ (V.isoSpec.hom w).asIdeal := Ideal.mul_mem_right _ _ hg
          have h6 : (1 : Γ(V, ⊤)) ∈ (V.isoSpec.hom w).asIdeal := by
            have := Ideal.sub_mem _ h5 h4
            rwa [sub_sub_cancel] at this
          exact (V.isoSpec.hom w).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h6)
      have h7 : V.isoSpec.hom v = V.isoSpec.hom w := PrimeSpectrum.ext (le_antisymm h2 h3)
      exact (Scheme.Hom.isEmbedding V.isoSpec.hom).injective h7
    have hvnr := vnr P (S (IsLocalRing.closedPoint F'')) (S (IsLocalRing.closedPoint F'')) A Λ W' φ a hA

    have ha_cl : a (IsLocalRing.closedPoint A) = S (IsLocalRing.closedPoint F'') := by
      obtain ⟨e, -, he⟩ := hA.2.2.2.2.2
      have h2 : Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom e)
          (IsLocalRing.closedPoint (AlgebraicClosure (P.residueField (S (IsLocalRing.closedPoint F''))))))
          = IsLocalRing.closedPoint A :=
        IsLocalRing.PrimeSpectrum.comap_residue A _
      calc a (IsLocalRing.closedPoint A)
          = a (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) (Spec.map (CommRingCat.ofHom e)
              (IsLocalRing.closedPoint
                (AlgebraicClosure (P.residueField (S (IsLocalRing.closedPoint F''))))))) :=
            congrArg a h2.symm
        _ = (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a)
              (IsLocalRing.closedPoint
                (AlgebraicClosure (P.residueField (S (IsLocalRing.closedPoint F''))))) :=
            ((comp_ap _ _ _).trans (comp_ap _ _ _)).symm
        _ = wcEtGeomPt P (S (IsLocalRing.closedPoint F'')) (IsLocalRing.closedPoint
                (AlgebraicClosure (P.residueField (S (IsLocalRing.closedPoint F''))))) :=
            congrArg (fun g : Spec (.of (AlgebraicClosure (P.residueField
              (S (IsLocalRing.closedPoint F''))))) ⟶ P => g (IsLocalRing.closedPoint
                (AlgebraicClosure (P.residueField (S (IsLocalRing.closedPoint F'')))))) he
        _ = S (IsLocalRing.closedPoint F'') := hγ _ _ _

    obtain ⟨haffV, hvnrV⟩ := hvnr
    haveI := haffV
    have hrig := s1 _ hvnrV
    have hfib : ∀ p : ↥(Spec (.of A)), a p = S (IsLocalRing.closedPoint F'') →
        p = IsLocalRing.closedPoint A := by
      intro p hp
      obtain ⟨v, -, hv⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := P.fromSpecResidueField (S (IsLocalRing.closedPoint F''))) (g := a)
        (IsLocalRing.closedPoint (P.residueField (S (IsLocalRing.closedPoint F'')))) p
        ((Scheme.fromSpecResidueField_apply _ _).trans hp.symm)
      obtain ⟨w, -, hw⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := P.fromSpecResidueField (S (IsLocalRing.closedPoint F''))) (g := a)
        (IsLocalRing.closedPoint (P.residueField (S (IsLocalRing.closedPoint F''))))
        (IsLocalRing.closedPoint A)
        ((Scheme.fromSpecResidueField_apply _ _).trans ha_cl.symm)
      have hsp : Limits.pullback.snd (P.fromSpecResidueField (S (IsLocalRing.closedPoint F''))) a v ⤳
          Limits.pullback.snd (P.fromSpecResidueField (S (IsLocalRing.closedPoint F''))) a w := by
        have h0 := IsLocalRing.specializes_closedPoint p
        exact hv.symm ▸ hw.symm ▸ h0
      have hvw : v ⤳ w := (Scheme.Hom.isEmbedding (Limits.pullback.snd
        (P.fromSpecResidueField (S (IsLocalRing.closedPoint F''))) a)).isInducing.specializes_iff.mp hsp
      exact hv.symm.trans ((congrArg _ (hrig v w hvw)).trans hw)

    haveI hci : IsClosedImmersion (xs ≫ f) :=
      isClosedImmersion_of_comp_eq_id hom (xs ≫ f) (by rw [hxs, hS])

    have hq : ∀ z : ↥(Limits.pullback f a), Limits.pullback.fst f a z = xs (IsLocalRing.closedPoint F'') →
        Limits.pullback.snd f a z = IsLocalRing.closedPoint A := by
      intro z hz
      apply hfib
      calc a (Limits.pullback.snd f a z) = (Limits.pullback.snd f a ≫ a) z := (comp_ap _ _ _).symm
        _ = (Limits.pullback.fst f a ≫ f) z :=
            congrArg (fun g : Limits.pullback f a ⟶ P => g z) Limits.pullback.condition.symm
        _ = f (Limits.pullback.fst f a z) := comp_ap _ _ _
        _ = (xs ≫ f) (IsLocalRing.closedPoint F'') := (congrArg f hz).trans (comp_ap _ _ _).symm
        _ = S (IsLocalRing.closedPoint F'') :=
            congrArg (fun g : Spec (.of F'') ⟶ P => g (IsLocalRing.closedPoint F'')) hxs

    haveI hgci : IsClosedImmersion
        (Limits.pullback.snd xs (Limits.pullback.fst f a) ≫ Limits.pullback.snd f a) := by
      rw [← Limits.pullbackRightPullbackFstIso_hom_snd]
      infer_instance
    obtain ⟨wx, -, hwx⟩ := Scheme.Pullback.exists_preimage_pullback (f := xs)
      (g := Limits.pullback.fst f a) (IsLocalRing.closedPoint F'') x hx.symm
    obtain ⟨wy, -, hwy⟩ := Scheme.Pullback.exists_preimage_pullback (f := xs)
      (g := Limits.pullback.fst f a) (IsLocalRing.closedPoint F'') y hy.symm
    have hinj := (Scheme.Hom.isEmbedding
      (Limits.pullback.snd xs (Limits.pullback.fst f a) ≫ Limits.pullback.snd f a)).injective
    have hw : wx = wy := hinj ((comp_ap _ _ _).trans (((congrArg _ hwx).trans
      ((hq x hx).trans ((hq y hy).symm.trans (congrArg _ hwy.symm)))).trans (comp_ap _ _ _).symm))
    exact hwx.symm.trans ((congrArg _ hw).trans hwy)
  intro F' F'' _ _ _ Y n D i A _ _ _ Λ _ _ W' φ a hA x y hx hy
  exact main F'' (wcP1Over F'').hom D.f (D.S i) (D.hS i) (D.xs i) (D.hxs i) A Λ W' φ a hA x y hx hy

theorem wc_pencil_odp_shens_restrict_ker_le_range : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), Even n → 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ Nat.card F'' → ∀ (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left), wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a → ∀ (x : ↥(Limits.pullback D.f a)), Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'') → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x)) (Scheme.Etale.forget (Limits.pullback D.f a))) (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a), wcHalShData x B Λ' W'' φ' a' → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → ∀ (D' : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (r : Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ ⟶ Limits.pullback (Limits.pullback.snd D.f a) ξ), r ≫ Limits.pullback.fst (Limits.pullback.snd D.f a) ξ = Limits.pullback.fst (a' ≫ Limits.pullback.snd D.f a) ξ ≫ a' → r ≫ Limits.pullback.snd (Limits.pullback.snd D.f a) ξ = Limits.pullback.snd (a' ≫ Limits.pullback.snd D.f a) ξ → ∀ (Dr : wcEtPullData r (ℓ ^ k)) (z : wcEtZModExt (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1)), wcEtPull Dr (n - 1) z = 0 → ∃ y : wcEtZModExt (Limits.pullback D.f a) (ℓ ^ k) (n - 1), wcEtPull D' (n - 1) y = z :=
by
  classical
  intro F' F'' _ _ _ _ Y n hn hn2 D ℓ hℓp hℓ k i A _ _ _ Λ _ _ W' φ a hA x hx B _ _ _ Λ' _ _ W'' φ' a' hB
    Ω _ _ ξ hξ D' r hr₁ hr₂ Dr z hz
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓp⟩

  have comp_ap : ∀ {X Y : Scheme.{u}} {Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X),
      (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hfA : IsProper (Limits.pullback.snd D.f a) := by
    first
    | exact inferInstance
    | exact MorphismProperty.of_isPullback (IsPullback.of_hasPullback D.f a) hfp
    | exact MorphismProperty.of_isPullback (IsPullback.of_hasPullback D.f a).flip hfp
  have hm0 : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ ^ k : ℕ) : F'')) :=
    isUnit_iff_ne_zero.mpr (by rw [Nat.cast_pow]; exact pow_ne_zero _ hℓK)
  have hmu : IsUnit (((ℓ ^ k : ℕ) : A)) := by
    have h1 := hunitK.map (Spec.preimage (a ≫ (wcP1Over F'').hom)).hom
    rwa [map_natCast] at h1
  have hγ : ∀ (c : (wcP1Over F'').left)
      (x : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField c)))),
      wcEtGeomPt (wcP1Over F'').left c x = c := by
    intro c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
