        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
