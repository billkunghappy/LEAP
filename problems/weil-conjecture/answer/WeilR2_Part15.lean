theorem wc_pencil_R2_H2_nonzero (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ y : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (2 * (n - 1))) 2, y ≠ 0 :=
by
  classical
  by_contra hne
  push_neg at hne

  haveI := D.gi
  haveI := D.proper
  haveI := D.smooth
  have ht : WeaklyEtale (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨x0, hx0⟩ := wc_top_coh_nonzero F'' D.Yt n ℓ hℓ ht
  obtain ⟨L, adj, hL, θ, -⟩ := wc_proet_push_free_adjunction F'' (wcP1Over F'') D.Yt
    (Over.homMk D.f D.hf) hP ht
  haveI := hL

  have hchar : ∀ k : ℕ, ((ℓ ^ k : ℕ) : F'') ≠ 0 := by
    intro k hk
