theorem wc_quadric_model_shens_milnor_fibre_low : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (n : ℕ), Even n → 2 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det → ∀ (x₀ : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) → wcQuadModelStr A n π c x₀ = IsLocalRing.closedPoint A → ∀ (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀)) (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))), wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → ConnectedSpace ↥(Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) ∧ ∀ q : ℕ, 1 ≤ q → q + 2 ≤ n → Subsingleton (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) ℓ q) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunit n hn hn2 π c hπ hc x₀ hX hx₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hB₀ Ω _ _ ξ hξ
  classical

  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    have h1 := hunit.map (Spec.preimage ξ).hom
    rw [map_natCast] at h1
    exact h1.ne_zero

  have hπ0 : (Spec.preimage ξ).hom π ≠ 0 := by
    have hker : ∀ x : A, x ∈ (ξ (IsLocalRing.closedPoint Ω)).asIdeal ↔
        (Spec.preimage ξ).hom x = 0 := by
      intro x
      conv_lhs => rw [← Spec.map_preimage ξ]
      show x ∈ Ideal.comap (Spec.preimage ξ).hom (IsLocalRing.maximalIdeal Ω) ↔ _
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_ne_zero,
