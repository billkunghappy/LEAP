      · intro t
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, Iso.inv_hom_id, Fid, Abelian.Ext.mk₀_id_comp]
    exact b2.comp (hRbij.comp (b1.comp Λ.bijective))
  ·
    intro c y
    rw [hΨ, hΨ]
    show _ = ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp
      (R ((Abelian.Ext.mk₀ (θ V₀).inv).comp (Λ y) (zero_add k))) (zero_add k)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f D.u0) ℓ c)) (add_zero k)
    have h1 : Λ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 0)) =
        (Λ y).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero k) :=
      hΛσ (wcLadicScalar D.Yt.left ℓ c) y
    have h3 : (Abelian.Ext.mk₀ (θ V₀).inv).comp
          ((Λ y).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero k)) (zero_add k) =
