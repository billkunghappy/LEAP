    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
