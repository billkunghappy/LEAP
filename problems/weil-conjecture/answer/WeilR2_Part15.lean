    Triangulated.TStructure.isGE_shift DerivedCategory.TStructure.t Y (c + 1) n (c + 1 - n) (by omega)
  have b1 : Function.Bijective (σ ((shiftFunctor _ (-1 : ℤ)).obj ((shiftFunctor _ n).obj Y))) :=
    hsmall _ (c + 1 - n) (-1) hYn (by omega)
  have b2 : Function.Bijective (σ ((shiftFunctor _ n).obj X)) := hGX n
  have b4 : Function.Bijective (σ ((shiftFunctor _ n).obj Y)) := hsmall Y (c + 1) n hYge (by omega)
  have b5 : Function.Bijective (σ ((shiftFunctor _ (1 : ℤ)).obj ((shiftFunctor _ n).obj X))) :=
    (hiso _ _ ((shiftFunctorAdd' _ n 1 (n + 1) rfl).app X)).mp (hGX (n + 1))
  exact hfive _ hTn b1 b2 b4 b5

theorem wc_qm_cone_supp : ∀ (Z : Scheme.{u}) (z : Z) (K₁ K₂ : CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ) (ψ : K₁ ⟶ K₂), (∀ y : Z, y ≠ z → ∀ p : ℕ, IsIso ((wcEtStalk Z y).map (HomologicalComplex.homologyMap ψ p))) → letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}); (DerivedCategory.Q.obj (CochainComplex.mappingCone (HomologicalComplex.extendMap ψ ComplexShape.embeddingUpNat))).IsGE (-1) ∧ ∀ (p : ℤ) (y : Z), y ≠ z → Subsingleton ((wcEtStalk Z y).obj ((DerivedCategory.homologyFunctor _ p).obj (DerivedCategory.Q.obj (CochainComplex.mappingCone (HomologicalComplex.extendMap ψ ComplexShape.embeddingUpNat))))) :=
by
  intro Z z K₁ K₂ ψ hψ
  letI := HasDerivedCategory.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
  refine ⟨?_, ?_⟩
  · haveI := CochainComplex.isStrictlyGE_mappingCone
      (HomologicalComplex.extendMap ψ ComplexShape.embeddingUpNat) 0 0 (-1)
    rw [DerivedCategory.isGE_Q_obj_iff]
    infer_instance
  · intro p y hy

    have hex2 : Limits.PreservesFiniteLimits (wcEtStalk Z y) ∧
        Limits.PreservesFiniteColimits (wcEtStalk Z y) := by
      haveI : AB5OfSize.{u, u} AddCommGrpCat.{u+1} :=
        AB5OfSize_shrink.{u, u, u+1, u+1} AddCommGrpCat.{u+1}
      let Φ := Scheme.pointSmallEtale (wcEtGeomPt Z y)
      let E : StructuredArrow (Over.mk (wcEtGeomPt Z y)) (Scheme.Etale.forget Z) ⥤
          Φ.fiber.Elements :=
        { obj := fun A => Φ.fiber.elementsMk A.right A.hom
          map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
          map_id := fun A => rfl
