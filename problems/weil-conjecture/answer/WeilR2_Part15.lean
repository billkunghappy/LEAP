theorem wc_qclift_ext_rationalize (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (k : ℕ)
    (θ : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W) (x : (Subobject.underlying.obj M).obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject (Subobject.underlying.obj M))
    (hJ : ∀ (V : (wcP1Over F'').left.ProEt) (s : (Subobject.underlying.obj M).obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over F'').left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom (((Subobject.underlying.obj M).obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∀ y : wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 2,
      ∃ (N : ℕ) (y₀ : wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj J) 2),
        (ℓ ^ N : ℕ) • y = y₀.comp (Abelian.Ext.mk₀ J.arrow) (add_zero 2) :=
by
  classical
  intro y

  haveI hprop : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hprop' : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    IsProper.instSndScheme _ _
  have hqc0 : QuasiCompact (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  have hqs0 : QuasiSeparated (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  haveI : CompactSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hqc0 _
  haveI : QuasiSeparatedSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) _ hqs0
  have hW : QuasiCompact W.hom := by
    have hwB : w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom = W.hom := MorphismProperty.Over.w w
    haveI : QuasiCompact (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
      show QuasiCompact (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      infer_instance
    haveI := hqc
    rw [← hwB]
    infer_instance

  have hbd : ∀ (V : (wcP1Over F'').left.ProEt), CompactSpace V.left →
      ∀ s : (Subobject.underlying.obj M).obj.obj (Opposite.op V),
      ∃ (m : ℕ) (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
        (J.arrow.hom.app (Opposite.op V)).hom t = (ℓ ^ m : ℕ) • s := by
    intro V hV s
    haveI := hV
    haveI := hW
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hWp : WeaklyEtale W.hom := W.prop
    let p₁ := Limits.pullback.fst V.hom W.hom
    let p₂ := Limits.pullback.snd V.hom W.hom
    haveI : WeaklyEtale p₁ := inferInstance
    haveI : WeaklyEtale (p₁ ≫ V.hom) := inferInstance
    let Zl : (wcP1Over F'').left.ProEt := Scheme.ProEt.mk (p₁ ≫ V.hom)
    have e₂ : p₂ ≫ W.hom = Zl.hom := by
      show p₂ ≫ W.hom = p₁ ≫ V.hom
      exact Limits.pullback.condition.symm
    let P₁ : Zl ⟶ V := MorphismProperty.Over.homMk p₁ rfl trivial
    let P₂ : Zl ⟶ W := MorphismProperty.Over.homMk p₂ e₂ trivial
    haveI hqp : QuasiCompact p₁ := inferInstance
    haveI hZc : CompactSpace (Limits.pullback V.hom W.hom : Scheme) :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ p₁ hqp hV
    haveI hZc' : CompactSpace ↥Zl.left := hZc
    let s₁ : (Subobject.underlying.obj M).obj.obj (Opposite.op Zl) :=
      ((Subobject.underlying.obj M).obj.map P₁.op).hom s
    let σ : C(↥Zl.left, Fin k → ℚ_[ℓ]) :=
      (show C(↥Zl.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom s₁).down)
    obtain ⟨C, hC⟩ := (isCompact_univ (X := ↥Zl.left)).exists_bound_of_continuousOn
      ((LinearMap.continuous_of_finiteDimensional P.toLinearMap).comp σ.continuous).continuousOn
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt C hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ m := pow_pos (by linarith) m
    refine ⟨m, (hJ V ((ℓ ^ m : ℕ) • s)).2 ?_⟩
    intro V' c b z i
    have hcV : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
    have hbW : b.left ≫ W.hom = V'.hom := MorphismProperty.Over.w b
    let h : V'.left ⟶ Limits.pullback V.hom W.hom :=
      Limits.pullback.lift c.left b.left (hcV.trans hbW.symm)
    have hh1 : h ≫ p₁ = c.left := Limits.pullback.lift_fst _ _ _
    have hh2 : h ≫ p₂ = b.left := Limits.pullback.lift_snd _ _ _
    have eh : h ≫ Zl.hom = V'.hom := by
      show h ≫ p₁ ≫ V.hom = V'.hom
      rw [← Category.assoc, hh1, hcV]
    let Ht : V' ⟶ Zl := MorphismProperty.Over.homMk h eh trivial
    have hHt1 : Ht ≫ P₁ = c := MorphismProperty.Over.Hom.ext (by exact hh1)
    have hHt2 : Ht ≫ P₂ = b := MorphismProperty.Over.Hom.ext (by exact hh2)
    let a : (Over.mk b : Over W) ⟶ Over.mk P₂ := Over.homMk Ht hHt2
    have hN : (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((((Subobject.underlying.obj M).over W).obj.map a.op).hom s₁)).down) z = σ (h z) := by
      have N2 := congrArg (fun F : ((Subobject.underlying.obj M).over W).obj.obj
            (Opposite.op (Over.mk P₂)) ⟶
          ((wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W).obj.obj
            (Opposite.op (Over.mk b : Over W)) => F.hom s₁)
        (θ.hom.hom.naturality a.op)
      exact congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin k → ℚ_[ℓ]) => y.down z) N2
    have hsec : ((Subobject.underlying.obj M).obj.map c.op).hom s =
        (((Subobject.underlying.obj M).over W).obj.map a.op).hom s₁ := by
      have e := congrArg (fun φ => φ.hom s) ((Subobject.underlying.obj M).obj.map_comp P₁.op Ht.op)
      rw [← op_comp, hHt1] at e
      exact e
    have e1 : ((Subobject.underlying.obj M).obj.map c.op).hom ((ℓ ^ m : ℕ) • s) =
        (ℓ ^ m : ℕ) • (((Subobject.underlying.obj M).over W).obj.map a.op).hom s₁ := by
      rw [map_nsmul]
      exact congrArg (fun x => (ℓ ^ m : ℕ) • x) hsec
    have e2 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
        (((Subobject.underlying.obj M).obj.map c.op).hom ((ℓ ^ m : ℕ) • s)) =
        (ℓ ^ m : ℕ) • (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((((Subobject.underlying.obj M).over W).obj.map a.op).hom s₁) := by
      rw [e1, map_nsmul]
    have key : P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((Subobject.underlying.obj M).obj.map c.op).hom ((ℓ ^ m : ℕ) • s))).down) z) =
        (ℓ ^ m : ℕ) • P (σ (h z)) := by
      rw [e2, ← map_nsmul P]
      congr 1
      rw [← hN]
      rfl
    have hb2 : ‖P (σ (h z))‖ ≤ C := hC (h z) (Set.mem_univ _)
    have hb3 := norm_le_pi_norm (P (σ (h z))) i
    rw [key, Pi.smul_apply, nsmul_eq_mul, norm_mul, Nat.cast_pow, Padic.norm_p_pow, zpow_neg,
      zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
    linarith

  have hns : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (m : ℕ) (U : ((wcP1Over F'').left.ProEt)ᵒᵖ) (x : (X.obj.obj U : Type (u+1))),
      (m • 𝟙 X).hom.app U x = m • x := by
    intro X m U x
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ m ih =>
      rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih, succ_nsmul]
      rfl
  have hmono : Monotone (fun n : ℕ =>
      (Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj M))).obj J) := by
    apply monotone_nat_of_le_succ
    intro n
    show (Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj M))).obj J ≤
      (Subobject.pullback ((ℓ ^ (n + 1) : ℕ) • 𝟙 (Subobject.underlying.obj M))).obj J
    have hPn := Subobject.isPullback ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj M)) J
    have hPn1 := Subobject.isPullback ((ℓ ^ (n + 1) : ℕ) • 𝟙 (Subobject.underlying.obj M)) J
    have hw := hPn.w
    have heq : (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj M)) J ≫
        (ℓ • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow =
        ((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj M))).obj J).arrow ≫
          ((ℓ ^ (n + 1) : ℕ) • 𝟙 (Subobject.underlying.obj M)) := by
      calc (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj M)) J ≫
          (ℓ • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow
