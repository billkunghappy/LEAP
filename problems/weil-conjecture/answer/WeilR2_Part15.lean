    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue A))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField A)) w _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue A)).mp inferInstance)
  have hacl : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    have key : ∀ x₀ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField
        (D.S i (IsLocalRing.closedPoint F''))))),
        a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
      intro x₀
      have h1 : (Spec.map (CommRingCat.ofHom eA) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a) x₀ =
          (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))) x₀ := by
        rw [heq]
      simp only [Scheme.Hom.comp_apply, wcEtGeomPt, hres] at h1
      exact h1.trans (Scheme.fromSpecResidueField_apply _ _)
    exact key (IsLocalRing.closedPoint _)

  have hWa : WeaklyEtale a := wc_shdata_weaklyEtale _ A Λ W' φ a hA
  let VA : (wcP1Over F'').left.ProEt := MorphismProperty.Over.mk ⊤ a hWa
  obtain ⟨vA⟩ := wc_P1_strict_local_geomPoint_map F'' hP VA A (Iso.refl _)
  obtain ⟨v₀⟩ := wc_P1_strict_local_geomPoint_map F'' hP V₀ A₀ e₀
  obtain ⟨c, -⟩ := wc_pencil_PL_shens_nbhd_rigid F'' hP (D.S i) (D.hS i) VA vA A (Iso.refl _)
    hacl V₀ v₀ A₀ e₀ hV₀
  have hγ1 : c.inv.left ≫ c.hom.left = 𝟙 V₀.left :=
    (MorphismProperty.Comma.comp_left c.inv c.hom).symm.trans
      ((congrArg (fun (f : V₀ ⟶ V₀) => f.left) c.inv_hom_id).trans rfl)
