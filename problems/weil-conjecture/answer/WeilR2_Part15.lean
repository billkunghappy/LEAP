theorem wc_qmbJ_level_affine : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Xb X : Scheme.{u}) (pb : Xb ⟶ Spec (.of A)) (j : X ⟶ Xb) [IsOpenImmersion j] (z : ↥(Limits.pullback pb (wcQmSp A))) (E : Scheme.{u}) (h : E ⟶ Xb), (∀ w : E, h w ∉ (Limits.pullback.fst pb (wcQmSp A)) '' closure {z}) → IsAffine (Limits.pullback h j) → ∀ (N : Scheme.Etale (wcQmUs z : Scheme.{u})) (ν : N.left ≅ Limits.pullback h ((wcQmUs z).ι ≫ Limits.pullback.fst pb (wcQmSp A))), ν.hom ≫ Limits.pullback.snd h ((wcQmUs z).ι ≫ Limits.pullback.fst pb (wcQmSp A)) = N.hom → IsAffine (Limits.pullback N.hom ((Limits.pullback pb (wcQmSp A)).homOfLE (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z))) :=
by
  have s1 : ∀ {E Y U W N : Scheme.{u}} (h : E ⟶ Y) (g : U ⟶ Y) (jW : W ⟶ U) (Nh : N ⟶ U)
      (g' : W ⟶ Y) (ν : N ≅ Limits.pullback h g), ν.hom ≫ Limits.pullback.snd h g = Nh →
      jW ≫ g = g' → IsAffine (Limits.pullback h g') → IsAffine (Limits.pullback Nh jW) := by
    intro E Y U W N h g jW Nh g' ν hν hg hA
    subst hg
    subst hν
    let φ₁ := Limits.pullback.map (ν.hom ≫ Limits.pullback.snd h g) jW (Limits.pullback.snd h g)
      jW ν.hom (𝟙 W) (𝟙 U) (by simp) (by simp)
    haveI : IsIso φ₁ := by dsimp [φ₁]; infer_instance
    exact IsAffine.of_isIso (φ₁ ≫ (Limits.pullbackLeftPullbackSndIso h g jW).hom)
  have s2 : ∀ {Xb X E S S' : Scheme.{u}} (pb : Xb ⟶ S) (σ : S' ⟶ S) [IsAffine S] [IsAffine S']
      (j : X ⟶ Xb) [IsOpenImmersion j] (h : E ⟶ Xb) (W : (Limits.pullback pb σ).Opens),
      (∀ p : ↥(Limits.pullback pb σ), p ∈ W → Limits.pullback.fst pb σ p ∈ Set.range j) →
      (∀ p : ↥(Limits.pullback pb σ), Limits.pullback.fst pb σ p ∈ Set.range h →
        Limits.pullback.fst pb σ p ∈ Set.range j → p ∈ W) →
      IsAffine (Limits.pullback h j) →
      IsAffine (Limits.pullback h (W.ι ≫ Limits.pullback.fst pb σ)) := by
    intro Xb X E S S' pb σ _ _ j _ h W ha hb hR
    have hWX : Set.range (W.ι ≫ Limits.pullback.fst pb σ) ⊆ Set.range j := by
      rintro _ ⟨x, rfl⟩
      have hx : W.ι x ∈ (W : Set _) := by rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact ha _ hx
    obtain ⟨wX, hwX⟩ : ∃ wX : (W : Scheme.{u}) ⟶ X, wX ≫ j = W.ι ≫ Limits.pullback.fst pb σ :=
      ⟨IsOpenImmersion.lift j _ hWX, IsOpenImmersion.lift_fac _ _ _⟩
    obtain ⟨rr, hrr1, hrr2⟩ : ∃ rr : Limits.pullback h (W.ι ≫ Limits.pullback.fst pb σ) ⟶
        Limits.pullback h j,
        rr ≫ Limits.pullback.fst h j = Limits.pullback.fst h (W.ι ≫ Limits.pullback.fst pb σ) ∧
        rr ≫ Limits.pullback.snd h j =
          Limits.pullback.snd h (W.ι ≫ Limits.pullback.fst pb σ) ≫ wX :=
      ⟨Limits.pullback.lift _ _ (by rw [Category.assoc, hwX]; exact Limits.pullback.condition),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have key : Limits.pullback.snd h j ≫ j ≫ pb = Limits.pullback.fst h j ≫ h ≫ pb := by
      rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc]
    obtain ⟨α, hα1, hα2⟩ : ∃ α : Limits.pullback h (W.ι ≫ Limits.pullback.fst pb σ) ⟶
        Limits.pullback (Limits.pullback.fst h j ≫ h ≫ pb) σ,
        α ≫ Limits.pullback.fst _ _ = rr ∧
        α ≫ Limits.pullback.snd _ _ = Limits.pullback.snd h (W.ι ≫ Limits.pullback.fst pb σ) ≫
          W.ι ≫ Limits.pullback.snd pb σ :=
      ⟨Limits.pullback.lift rr _ (by
          rw [reassoc_of% hrr1, Limits.pullback.condition_assoc, Category.assoc, Category.assoc,
            Category.assoc, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨zQ, hz1, hz2⟩ : ∃ zQ : Limits.pullback (Limits.pullback.fst h j ≫ h ≫ pb) σ ⟶
        Limits.pullback pb σ,
        zQ ≫ Limits.pullback.fst pb σ =
          Limits.pullback.fst _ _ ≫ Limits.pullback.snd h j ≫ j ∧
        zQ ≫ Limits.pullback.snd pb σ = Limits.pullback.snd _ _ :=
      ⟨Limits.pullback.lift _ _ (by
          simp only [Category.assoc]
          rw [key]
          exact Limits.pullback.condition),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have e1 : zQ ≫ Limits.pullback.fst pb σ =
        Limits.pullback.fst _ _ ≫ Limits.pullback.fst h j ≫ h := by
      rw [hz1, Limits.pullback.condition (f := h) (g := j)]
    have hzW : Set.range zQ ⊆ Set.range W.ι := by
      rintro _ ⟨τ, rfl⟩
      rw [Scheme.Opens.range_ι]
      have c1 := congrArg (fun f => f τ) hz1
      have c2 := congrArg (fun f => f τ) e1
      simp only [Scheme.Hom.comp_apply] at c1 c2
      apply hb
      · exact ⟨_, c2.symm⟩
      · exact ⟨_, c1.symm⟩
    obtain ⟨wQ, hwQ⟩ : ∃ wQ : Limits.pullback (Limits.pullback.fst h j ≫ h ≫ pb) σ ⟶
        (W : Scheme.{u}), wQ ≫ W.ι = zQ :=
      ⟨IsOpenImmersion.lift W.ι zQ hzW, IsOpenImmersion.lift_fac _ _ _⟩
    obtain ⟨β, hβ1, hβ2⟩ : ∃ β : Limits.pullback (Limits.pullback.fst h j ≫ h ≫ pb) σ ⟶
        Limits.pullback h (W.ι ≫ Limits.pullback.fst pb σ),
        β ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ Limits.pullback.fst h j ∧
        β ≫ Limits.pullback.snd _ _ = wQ :=
      ⟨Limits.pullback.lift _ wQ (by rw [reassoc_of% hwQ, e1, Category.assoc]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have h1 : α ≫ β = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hβ1, reassoc_of% hα1, hrr1, Category.id_comp]
      · rw [Category.assoc, hβ2, Category.id_comp, ← cancel_mono W.ι, Category.assoc, hwQ]
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, hz1, reassoc_of% hα1, reassoc_of% hrr2, hwX]
        · simp only [Category.assoc, hz2, hα2]
    have h2 : β ≫ α = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hα1, Category.id_comp]
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hrr1, hβ1]
        · rw [← cancel_mono j]
          simp only [Category.assoc, reassoc_of% hrr2, reassoc_of% hβ2, hwX, reassoc_of% hwQ, hz1]
      · rw [Category.assoc, hα2, reassoc_of% hβ2, reassoc_of% hwQ, hz2, Category.id_comp]
    haveI : IsIso α := ⟨⟨β, h1, h2⟩⟩
    exact IsAffine.of_isIso α
  intro A _ _ Xb X pb j _ z E h Hav Haff N ν Hν
  have e : (Limits.pullback pb (wcQmSp A)).homOfLE (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z) ≫ ((wcQmUs z).ι ≫ Limits.pullback.fst pb (wcQmSp A)) = (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z).ι ≫ Limits.pullback.fst pb (wcQmSp A) := by
    rw [← Category.assoc, Scheme.homOfLE_ι]
  refine s1 h _ _ N.hom _ ν Hν e ?_
  refine s2 pb (wcQmSp A) j h _ ?_ ?_ Haff
  · intro p hp
    have hp2 := (TopologicalSpace.Opens.mem_inf.mp hp).2
    rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hp2
    exact hp2
  · rintro p ⟨w, hw⟩ hj
    refine TopologicalSpace.Opens.mem_inf.mpr ⟨?_, ?_⟩
    · intro hcl
      exact Hav w ⟨p, hcl, hw.symm⟩
    · rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact hj

theorem wc_et_stalk_tube_of_cone : ∀ {U W Tk : Scheme.{u}} (jW : W ⟶ U) (y : ↥U) (ℓ q : ℕ) (F : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) (P : (Scheme.Etale U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ρ : P ⟶ F.obj) (κ : ∀ V : Scheme.Etale U, P.obj (Opposite.op V) →+ wcEtZModExt (Limits.pullback V.hom jW) ℓ q), (∀ V, Function.Bijective (κ V)) → (∀ (V V' : Scheme.Etale U) (ff : V' ⟶ V), ∃ DD : wcEtPullData (Limits.pullback.map V'.hom jW V.hom jW ff.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w ff).symm) ((Category.comp_id _).trans (Category.id_comp _).symm)) ℓ, ∀ cx : P.obj (Opposite.op V), κ V' ((P.map ff.op).hom cx) = wcEtPull DD q (κ V cx)) → (∀ (Aw : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)) (ss : F.obj.obj (Opposite.op Aw.right)), ∃ (Aw' : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)) (ff : Aw' ⟶ Aw) (cx : P.obj (Opposite.op Aw'.right)), (F.obj.map ff.right.op).hom ss = (ρ.app (Opposite.op Aw'.right)).hom cx) → (∀ (Aw : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)) (cx : P.obj (Opposite.op Aw.right)), (ρ.app (Opposite.op Aw.right)).hom cx = 0 → ∃ (Aw' : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)) (ff : Aw' ⟶ Aw), (P.map ff.right.op).hom cx = 0) → ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (Af : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)), Af.Initial → ∀ (wk : Tk ⟶ W) (n : ∀ l, Tk ⟶ Limits.pullback (Af.obj l).right.hom jW), (∀ l, n l ≫ Limits.pullback.snd (Af.obj l).right.hom jW = wk) → (∀ {l l' : Λ} (tt : l ⟶ l'), n l ≫ Limits.pullback.map (Af.obj l).right.hom jW (Af.obj l').right.hom jW (Af.map tt).right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map tt).right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm) = n l') → (∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ Limits.pullback (Af.obj l).right.hom jW), (∀ {l l' : Λ} (tt : l ⟶ l'), w l ≫ Limits.pullback.map (Af.obj l).right.hom jW (Af.obj l').right.hom jW (Af.map tt).right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map tt).right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm) = w l') → ∃! w₀ : T ⟶ Tk, ∀ l, w₀ ≫ n l = w l) → (∀ l, IsAffine (Limits.pullback (Af.obj l).right.hom jW)) → IsAffine Tk → ∃ e : ↑((wcEtStalk U y).obj F) ≃+ wcEtZModExt Tk ℓ q, ∀ (l : Λ) (d : P.obj (Opposite.op (Af.obj l).right)) (E : wcEtPullData (n l) ℓ), e ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)).op ⋙ F.obj) (Opposite.op (Af.obj l))).hom ((ρ.app (Opposite.op (Af.obj l).right)).hom d)) = wcEtPull E q (κ (Af.obj l).right d) :=
by
  intro U W Tk jW y ℓ q F P ρ κ hκb hκn hs hi Λ _ _ Af hAf wk n hC1 hC2 hC3 hP hT
  classical
  haveI : Af.Initial := hAf

  have hres : ∀ {V V' V'' : U.Etale} (f : V' ⟶ V) (f' : V'' ⟶ V') (x : P.obj (Opposite.op V)),
      (P.map (f' ≫ f).op).hom x = (P.map f'.op).hom ((P.map f.op).hom x) := by
    intro V V' V'' f f' x
    rw [op_comp, Functor.map_comp]
    rfl
  have hres1 : ∀ {V : U.Etale} (x : P.obj (Opposite.op V)), (P.map (𝟙 V).op).hom x = x := by
    intro V x
    rw [op_id, P.map_id]
    rfl

  have claim : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)) (c l : Λ)
      (σ : c ⟶ l) (k : Af.obj l ⟶ A) (x : P.obj (Opposite.op A.right)) (E : wcEtPullData (n l) ℓ)
      (Ec : wcEtPullData (n c) ℓ),
      wcEtPull E q (κ (Af.obj l).right ((P.map k.right.op).hom x)) =
        wcEtPull Ec q (κ (Af.obj c).right ((P.map (Af.map σ ≫ k).right.op).hom x)) := by
    intro A c l σ k x E Ec
    obtain ⟨DD, hDD⟩ := hκn (Af.obj l).right (Af.obj c).right (Af.map σ).right
    rw [StructuredArrow.comp_right, hres, hDD]
    exact wc_et_pull_comp _ (n c) (n l) (hC2 σ) DD Ec E q _

  have ri : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U)) (l₁ l₂ : Λ)
      (k₁ : Af.obj l₁ ⟶ A) (k₂ : Af.obj l₂ ⟶ A) (x : P.obj (Opposite.op A.right))
      (E₁ : wcEtPullData (n l₁) ℓ) (E₂ : wcEtPullData (n l₂) ℓ),
      wcEtPull E₁ q (κ (Af.obj l₁).right ((P.map k₁.right.op).hom x)) =
        wcEtPull E₂ q (κ (Af.obj l₂).right ((P.map k₂.right.op).hom x)) := by
    intro A l₁ l₂ k₁ k₂ x E₁ E₂
    obtain ⟨c₂, t, ht⟩ := ((Functor.initial_iff_of_isCofiltered Af).mp hAf).2
      (Af.map (IsCofiltered.minToLeft l₁ l₂) ≫ k₁) (Af.map (IsCofiltered.minToRight l₁ l₂) ≫ k₂)
    obtain ⟨Ec⟩ := wc_et_zmod_pull_data_exists (n c₂) ℓ
    rw [claim A c₂ l₁ (t ≫ IsCofiltered.minToLeft l₁ l₂) k₁ x E₁ Ec,
      claim A c₂ l₂ (t ≫ IsCofiltered.minToRight l₁ l₂) k₂ x E₂ Ec]
    have h : Af.map (t ≫ IsCofiltered.minToLeft l₁ l₂) ≫ k₁ =
        Af.map (t ≫ IsCofiltered.minToRight l₁ l₂) ≫ k₂ := by
      rw [Af.map_comp, Af.map_comp, Category.assoc, Category.assoc]
      exact ht
    rw [h]

  have pm_id : ∀ l : Λ, Limits.pullback.map (Af.obj l).right.hom jW (Af.obj l).right.hom jW (Af.map (𝟙 l)).right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map (𝟙 l)).right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm) = 𝟙 _ := by
    intro l
    have hid : (Af.map (𝟙 l)).right.left = 𝟙 _ := by rw [Af.map_id]; rfl
    apply Limits.pullback.hom_ext
    · simp only [Limits.pullback.map, Limits.pullback.lift_fst, hid]
      simp
    · simp only [Limits.pullback.map, Limits.pullback.lift_snd, Category.comp_id, Category.id_comp]
  have pm_comp : ∀ {l l' l'' : Λ} (t : l ⟶ l') (t' : l' ⟶ l''),
      Limits.pullback.map (Af.obj l).right.hom jW (Af.obj l'').right.hom jW (Af.map (t ≫ t')).right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map (t ≫ t')).right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm) =
      Limits.pullback.map (Af.obj l).right.hom jW (Af.obj l').right.hom jW (Af.map t).right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map t).right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm) ≫
      Limits.pullback.map (Af.obj l').right.hom jW (Af.obj l'').right.hom jW (Af.map t').right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map t').right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm) := by
    intro l l' l'' t t'
    have hc : (Af.map (t ≫ t')).right.left = (Af.map t).right.left ≫ (Af.map t').right.left := by
      rw [Af.map_comp]; rfl
    apply Limits.pullback.hom_ext
    · simp only [Limits.pullback.map, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc, hc, Category.assoc]
    · simp only [Limits.pullback.map, Limits.pullback.lift_snd, Category.comp_id, Category.assoc]
  let D : Λ ⥤ W.Etale :=
    { obj := fun l => MorphismProperty.Over.mk ⊤ (Limits.pullback.snd (Af.obj l).right.hom jW) inferInstance
      map := fun {l l'} t => MorphismProperty.Over.homMk
        (Limits.pullback.map (Af.obj l).right.hom jW (Af.obj l').right.hom jW (Af.map t).right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map t).right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm))
        (by first
              | exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
              | simp) trivial
      map_id := fun l => MorphismProperty.Over.Hom.ext (pm_id l)
      map_comp := fun t t' => MorphismProperty.Over.Hom.ext (pm_comp t t') }
  have hPc : ∀ l, CompactSpace (D.obj l).left := fun l => by
    haveI := hP l
    show CompactSpace ↥(Limits.pullback (Af.obj l).right.hom jW)
    infer_instance
  have hPq : ∀ l, QuasiSeparatedSpace (D.obj l).left := fun l => by
    haveI := hP l
    show QuasiSeparatedSpace ↥(Limits.pullback (Af.obj l).right.hom jW)
    infer_instance
  have hPa : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left := fun {l l'} t =>
    @isAffineHom_of_isAffine _ _ (D.map t).left (hP l) (hP l')
  haveI := hT
  have hsurj : ∀ y₀ : wcEtZModExt Tk ℓ q, ∃ (l : Λ)
      (x : wcEtZModExt (Limits.pullback (Af.obj l).right.hom jW) ℓ q),
      ∀ E : wcEtPullData (n l) ℓ, wcEtPull E q x = y₀ :=
    fun y₀ => wc_et_limit_pull_surj_qcqs_all wk Λ D n hC1 @hC2 hC3 hPc hPq @hPa inferInstance
      inferInstance ℓ q y₀
  have hkill : ∀ (l : Λ) (x : wcEtZModExt (Limits.pullback (Af.obj l).right.hom jW) ℓ q)
      (E : wcEtPullData (n l) ℓ), wcEtPull E q x = 0 → ∃ (l' : Λ) (tt : l' ⟶ l),
      ∀ DD : wcEtPullData (Limits.pullback.map (Af.obj l').right.hom jW (Af.obj l).right.hom jW (Af.map tt).right.left (𝟙 W) (𝟙 U) ((Category.comp_id _).trans (MorphismProperty.Over.w (Af.map tt).right).symm) ((Category.comp_id _).trans (Category.id_comp _).symm)) ℓ,
        wcEtPull DD q x = 0 := by
    intro l x E hE
    obtain ⟨l', t, E', hE'⟩ := wc_et_limit_pull_kill_qcqs_all wk Λ D n hC1 @hC2 hC3 hPc hPq @hPa
      inferInstance inferInstance ℓ q l x E hE
    exact ⟨l', t, fun DD => (wc_et_pull_data_indep _ DD E' q x).trans hE'⟩

  let E0 : ∀ l, wcEtPullData (n l) ℓ := fun l => Classical.choice (wc_et_zmod_pull_data_exists (n l) ℓ)
  let θ : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U),
      P.obj (Opposite.op A.right) →+ wcEtZModExt Tk ℓ q := fun A =>
    (wcEtPull (E0 (Functor.Initial.lift Af A)) q).comp
      ((κ (Af.obj (Functor.Initial.lift Af A)).right).comp
        (P.map (Functor.Initial.homToLift Af A).right.op).hom)
  have hθ : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U))
      (x : P.obj (Opposite.op A.right)), θ A x = wcEtPull (E0 (Functor.Initial.lift Af A)) q
        (κ (Af.obj (Functor.Initial.lift Af A)).right
          ((P.map (Functor.Initial.homToLift Af A).right.op).hom x)) := fun _ _ => rfl
  have h2 : ∀ {V V' : U.Etale} (f : V' ⟶ V) (x : P.obj (Opposite.op V)),
      (F.obj.map f.op).hom ((ρ.app (Opposite.op V)).hom x) =
        (ρ.app (Opposite.op V')).hom ((P.map f.op).hom x) := by
    intro V V' f x
    have := congrArg (fun φ => φ.hom x) (ρ.naturality f.op)
    exact this.symm
  have h4 : ∀ (A A' : StructuredArrow (Over.mk (wcEtGeomPt U y)) (Scheme.Etale.forget U))
      (f : A' ⟶ A) (x : P.obj (Opposite.op A.right)),
      θ A x = θ A' ((P.map f.right.op).hom x) := by
