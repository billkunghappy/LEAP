      rw [Iso.comp_inv_eq, Category.assoc, c1, Iso.inv_hom_id_assoc]
    have hH : ((C.sc q).mapHomologyIso (wcQmInv g)).hom =
        (hl.map (wcQmInv g)).homologyIso.hom ≫ (wcQmInv g).map hl.homologyIso.inv :=
      congrArg Iso.hom (ShortComplex.LeftHomologyData.mapHomologyIso_eq hl (wcQmInv g))
    have hC : ((C.sc q).mapCyclesIso (wcQmInv g)).hom =
        (hl.map (wcQmInv g)).cyclesIso.hom ≫ (wcQmInv g).map hl.cyclesIso.inv :=
