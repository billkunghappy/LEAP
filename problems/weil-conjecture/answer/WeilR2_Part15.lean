      (Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcIntScalar X ℓ (ℓ : ℤ_[ℓ])) = ℓ • 𝟙 _ := by
    rw [Functor.comp_map, wc_intScalar_natCast_eq_nsmul, wc_rightDerived_map_nsmul_id,
      Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  obtain ⟨κ3, ⟨h3⟩⟩ := seq_colimit_transport_iso ((wcProEtPush g).rightDerived q ⋙
      (Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)
    (wcIntSheaf X ℓ) (wcLadicSheaf X ℓ) (wcIntScalar X ℓ (ℓ : ℤ_[ℓ])) κ ⟨h2⟩ _ θ (ℓ • 𝟙 _)
