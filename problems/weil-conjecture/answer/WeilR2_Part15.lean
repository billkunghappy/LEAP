    rw [injective_iff_map_eq_zero]
    intro x hx
    have e1 : wcEtPull Dκ j (wcEtPull Dκ' j x) = x := by
      rw [← wc_et_pull_comp κ' κ (𝟙 _) hκκ' Dκ' Dκ Did j x, hid]
    have e2 : wcEtPull Dρ j (wcEtPull Dκ' j x) = 0 := by
      rw [wc_et_pull_comp (q ≫ κ) g _ hgq Dqκ Dg Dρ j,
        wc_et_pull_comp κ q (q ≫ κ) rfl Dκ Dq Dqκ j, e1, hx, map_zero]
    have e3 : wcEtPull Dκ' j x = 0 := (injective_iff_map_eq_zero _).mp (hinj Dρ) _ e2
    rw [← e1, e3, map_zero]

  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨hc1, hq1, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V₀ A₀ e₀
  obtain ⟨hc2, hq2, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D E L eE

  obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, eA, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (D.S i (IsLocalRing.closedPoint F''))
  have hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a := by
    unfold wcHalShData
    exact ⟨hI, haff, hcomp, hφa, hlim, eA, hint, heq⟩
  have hres : ∀ w : Spec (.of (IsLocalRing.ResidueField A)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) w = IsLocalRing.closedPoint A := by
    intro w
