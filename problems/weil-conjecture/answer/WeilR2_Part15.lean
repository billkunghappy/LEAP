    exact (wc_et_mv_pull_five g ℓ ⊤ ⊤ (sup_idem _) (htop ⊤) (htop ⊤)).mp (htop _)



  have hchart : ∀ (k : Fin (e + 1)) (W : (Spec (.of (MvPolynomial (Fin (e + 1)) Ω))).Opens), W ≤ PrimeSpectrum.basicOpen (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) Ω) → ∀ (j : ℕ) (Dd : wcEtPullData (Spec.map (CommRingCat.ofHom φe) ∣_ W) ℓ), Function.Bijective (wcEtPull Dd j) := by
