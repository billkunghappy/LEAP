  have G3 := congrArg (fun v => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt (wcQmUs z : Scheme.{u}) y)) (Scheme.Etale.forget (wcQmUs z : Scheme.{u}))).op ⋙ ((((wcEtPush ((Limits.pullback pb (wcQmSp A)).homOfLE (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z))).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology q).obj) (Opposite.op (Af.obj l))).hom v) (hnat.trans ((congrArg (fun w => (((((wcEtPush ((Limits.pullback pb (wcQmSp A)).homOfLE (inf_le_left : wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z ≤ wcQmUs z))).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homologyπ q).hom.app (Opposite.op (Af.obj l).right)).hom w) hcz).trans hzJ2.symm))
