  obtain ⟨hξ, hsp⟩ := wc_dim_one_integral_specialization _ hdim
  have hgen : ∀ η : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      ∃ W' : Set (wcGeomPoint F'' (wcP1Over F'') hP).left, IsOpen W' ∧ η ∈ W' ∧
        ∀ y ∈ W', η ⤳ y →
          Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd D.f
              (wcGeomPoint F'' (wcP1Over F'') hP).hom)
            (wcEtGeomPt (wcGeomPoint F'' (wcP1Over F'') hP).left y)) (ℓ ^ k) q) =
          Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd D.f
              (wcGeomPoint F'' (wcP1Over F'') hP).hom)
            (wcEtGeomPt (wcGeomPoint F'' (wcP1Over F'') hP).left η)) (ℓ ^ k) q) := by
    intro η
    by_cases hη : η = genericPoint (wcGeomPoint F'' (wcP1Over F'') hP).left
    · subst hη
