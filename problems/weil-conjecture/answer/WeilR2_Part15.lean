  have hφe : φ (HomogeneousLocalization.Away.isLocalizationElem hX hh) = 0 := by
    rw [he, map_sub, ← ha, hconst a, sub_self]
  have hx0h : h ∈ x0.asHomogeneousIdeal := by
    have hnot : x0 ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') h := by
      intro hmem
      have hz : (Spec.map (CommRingCat.ofHom φ)) pt ∈
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X j)
            hX one_pos ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') h := by
        rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hfac, hpt]
        exact hmem
      rw [Proj.awayι_preimage_basicOpen _ hX one_pos hh one_pos] at hz
      apply (PrimeSpectrum.mem_basicOpen _ _).mp hz
      change φ (HomogeneousLocalization.Away.isLocalizationElem hX hh) ∈
        (show PrimeSpectrum F'' from pt).asIdeal
      rw [hφe]
      exact Ideal.zero_mem _
    rw [Proj.mem_basicOpen] at hnot
    exact not_not.mp hnot
  have hx0X : MvPolynomial.X j ∉ x0.asHomogeneousIdeal :=
    (Proj.mem_basicOpen _ _ _).mp hj

  have s2 : ∀ (P Q : Ideal (MvPolynomial (Fin (1 + 1)) F'')),
      Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') P → P.IsPrime →
      MvPolynomial.X j ∉ P → h ∈ P → h ∈ Q → P ≤ Q := by
    intro P Q hPh hPp hXj hhP hhQ
    obtain ⟨e, he_def⟩ : ∃ e : Fin (1 + 1) → F'', e = fun i => if i = j then 1 else a :=
      ⟨_, rfl⟩
    have hA : ∀ (d : ℕ) (F : MvPolynomial (Fin (1 + 1)) F''), F.IsHomogeneous d →
        F - MvPolynomial.C (MvPolynomial.eval e F) * MvPolynomial.X j ^ d ∈ Ideal.span {h} := by
      intro d F hF
      have hπX : ∀ i, (Ideal.Quotient.mk (Ideal.span {h})) (MvPolynomial.X i) =
          (Ideal.Quotient.mk (Ideal.span {h})) (MvPolynomial.X j) *
            ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C) (e i) := by
        intro i
        rcases Fin.eq_self_or_eq_succAbove j i with hi | ⟨k, hk⟩
        · subst hi
          simp [he_def]
        · have hk0 : k = 0 := Subsingleton.elim k 0
          subst hk0
          subst hk
          have hne : j.succAbove 0 ≠ j := Fin.succAbove_ne j 0
          simp only [he_def, RingHom.comp_apply, hne, ↓reduceIte]
          have h0 : (Ideal.Quotient.mk (Ideal.span {h})) h = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self h)
          have h0' : (Ideal.Quotient.mk (Ideal.span {h})) (MvPolynomial.X (j.succAbove 0)) -
              (Ideal.Quotient.mk (Ideal.span {h})) (MvPolynomial.C a) *
                (Ideal.Quotient.mk (Ideal.span {h})) (MvPolynomial.X j) = 0 := by
            rw [← map_mul, ← map_sub, ← hh_def]
            exact h0
          rw [sub_eq_zero] at h0'
          rw [h0', mul_comm]
      have h1 : (Ideal.Quotient.mk (Ideal.span {h})) F = MvPolynomial.eval₂
          ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C)
          (fun i => (Ideal.Quotient.mk (Ideal.span {h})) (MvPolynomial.X j) *
            ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C) (e i)) F := by
        conv_lhs => rw [← MvPolynomial.eval₂_eta F]
        rw [MvPolynomial.eval₂_comp_left]
        congr 1
        funext i
        exact hπX i
      have h1' := h1.trans (scale ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C)
        (fun i => ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C) (e i))
        ((Ideal.Quotient.mk (Ideal.span {h})) (MvPolynomial.X j)) d F hF)
      have h2 : ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C)
          (MvPolynomial.eval e F) = MvPolynomial.eval₂
            ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C)
            (fun i => ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C) (e i)) F := by
        have := MvPolynomial.eval₂_comp_left
          ((Ideal.Quotient.mk (Ideal.span {h})).comp MvPolynomial.C) (RingHom.id F'') e F
        rw [RingHom.comp_id] at this
        exact this
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [map_sub, map_mul, map_pow, h1', ← h2, RingHom.comp_apply]
      ring
    have hB : ∀ (d : ℕ) (F : MvPolynomial (Fin (1 + 1)) F''), F.IsHomogeneous d → F ∈ P →
        F ∈ Ideal.span {h} := by
      intro d F hF hFP
      have hspan : Ideal.span {h} ≤ P := (Ideal.span_singleton_le_iff_mem P).mpr hhP
      have hmem := hA d F hF
      by_cases hc : MvPolynomial.eval e F = 0
      · rw [hc, map_zero, zero_mul, sub_zero] at hmem
        exact hmem
      · exfalso
        have h1 : MvPolynomial.C (MvPolynomial.eval e F) * MvPolynomial.X j ^ d ∈ P := by
          have := P.sub_mem hFP (hspan hmem)
          rwa [sub_sub_cancel] at this
        have h2 : MvPolynomial.X j ^ d ∈ P := by
          have := P.mul_mem_left (MvPolynomial.C (MvPolynomial.eval e F)⁻¹) h1
          rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul] at this
        exact hXj (hPp.mem_of_pow_mem d h2)
    intro f hf
    have hspanQ : Ideal.span {h} ≤ Q := (Ideal.span_singleton_le_iff_mem Q).mpr hhQ
    rw [← MvPolynomial.sum_homogeneousComponent f]
    refine Q.sum_mem (fun i _ => hspanQ ?_)
    apply hB i _ (MvPolynomial.homogeneousComponent_isHomogeneous i f)
    have hi := hPh i hf
    rw [← MvPolynomial.decomposition.decompose'_apply]
    exact hi

  have hW : wcPunctOpen F'' u0 =
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') h := by
    ext y
    show y ∉ closure {u0 (IsLocalRing.closedPoint F'')} ↔
      y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') h
    rw [Proj.mem_basicOpen, ← hx0]
    apply not_congr
    refine Iff.trans (((ProjectiveSpectrum.as_ideal_le_as_ideal _ x0 y).trans
      (ProjectiveSpectrum.le_iff_mem_closure _ x0 y)).symm) ?_
    constructor
    · intro hle
      exact hle hx0h
    · intro hyh
      have hle := s2 x0.asHomogeneousIdeal.toIdeal y.asHomogeneousIdeal.toIdeal
        x0.asHomogeneousIdeal.isHomogeneous x0.isPrime hx0X hx0h hyh
      exact fun f hf => hle hf

  have hWaff : IsAffineOpen (wcPunctOpen F'' u0) := by
    rw [hW]
    exact Proj.isAffineOpen_basicOpen _ h hh one_pos
  haveI : IsAffine (wcPunctOpen F'' u0).toScheme := hWaff

  show IsAffine (Limits.pullback (wcPunctOpen F'' u0).ι (Limits.pullback.fst (wcP1Over F'').hom
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  exact IsAffine.of_isIso (Limits.pullbackRightPullbackFstIso (wcP1Over F'').hom
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) (wcPunctOpen F'' u0).ι).hom

theorem wc_pencil_Rq_torsion_punct_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (k q i : ℕ), 2 ≤ i → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctGeom F'' D.u0 hP))
      (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))) i, x = 0 :=
by
  intro k q i hi x

  haveI hP1 : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI := D.proper
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  have hm : ((ℓ ^ k : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro hk
    have hk' : ((ℓ ^ k : ℕ) : F'') = 0 := by
      apply (algebraMap F'' (AlgebraicClosure F'')).injective
      rw [map_natCast, map_zero]
      exact hk
    haveI : Fintype F'' := Fintype.ofFinite F''
    have hprime : Nat.Prime (ringChar F'') := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp hk'
    have h2 : ringChar F'' ∣ ℓ := hprime.dvd_of_dvd_pow h1
    have h3 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hprime (Fact.out : ℓ.Prime)).mp h2
    have h4 : ringChar F'' ∣ Nat.card F'' := by
      rw [Nat.card_eq_fintype_card]
      exact (CharP.cast_eq_zero_iff F'' (ringChar F'') _).mp (FiniteField.cast_card_eq_zero F'')
    exact hℓ (h3 ▸ h4)

  haveI hPr : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  haveI hS : SmoothOfRelativeDimension 1 (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) (wc_p1_smooth_reldim_one F'')

  haveI hA : IsAffine (wcPunctGeom F'' D.u0 hP).left := wc_punct_geom_isAffine F'' D.u0 D.hu0 hP
  haveI hoi : IsOpenImmersion (wcPunctIncl F'' D.u0 hP).left := by
    show IsOpenImmersion (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
      (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    infer_instance

  obtain ⟨H, htor, ⟨e⟩⟩ := wc_proet_Rq_push_torsion_epsInv D.f (ℓ ^ k) q

  obtain ⟨H', htor', E2⟩ := wc_ext_free_slice_epsInv_torsion (wcP1Over F'').left
    (wcPunctGeom F'' D.u0 hP) (ℓ ^ k) H htor
  obtain ⟨E⟩ := E2 i

  have hY : ∀ z : Abelian.Ext (wcFreeSheaf (wcPunctGeom F'' D.u0 hP).left
      (Scheme.ProEt.mk (𝟙 (wcPunctGeom F'' D.u0 hP).left)))
      ((wcEpsInv (wcPunctGeom F'' D.u0 hP).left).obj H') i, z = 0 := by
    intro z
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (wcPunctGeom F'' D.u0 hP).left)
      AddCommGrpCat.{u+1}) := HasExt.standard _
    have het := @wc_et_affine_curve_torsion_vanishing (AlgebraicClosure F'') _ _
      (wcGeomPoint F'' (wcP1Over F'') hP).left
      (Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hPr hS
      (wcPunctGeom F'' D.u0 hP).left (wcPunctIncl F'' D.u0 hP).left hoi hA (ℓ ^ k) hm H' htor' i hi
    obtain ⟨E3⟩ := wc_proet_etale_comparison_epsInv_qcsep (wcPunctGeom F'' D.u0 hP).left H' i
    exact E3.injective ((het (E3 z)).trans (het (E3 0)).symm)
  have hB : ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctGeom F'' D.u0 hP))
      ((wcEpsInv (wcP1Over F'').left).obj H) i, w = 0 :=
    fun w => E.injective ((hY (E w)).trans (hY (E 0)).symm)

  have h1 : x.comp (Abelian.Ext.mk₀ e.hom) (add_zero i) = 0 := hB _
  calc x = (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)).comp (Abelian.Ext.mk₀ e.inv)
        (add_zero i) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    _ = 0 := by rw [h1, Abelian.Ext.zero_comp]

theorem wc_cycles_ext_three_column : ∀ {D : Type*} [Category D] [Abelian D] [HasExt D]
    (K : CochainComplex D ℕ) (P : D), (∀ j, Injective (K.X j)) →
    (∀ p q : ℕ, 3 ≤ p → ∀ y : Abelian.Ext P (K.homology q) p, y = 0) →
    (∀ j : ℕ, ∀ z : Abelian.Ext P (K.cycles j) 2,
      z.comp (Abelian.Ext.mk₀ (K.homologyπ j)) (add_zero 2) = 0 → z = 0) ∧
    (∀ j : ℕ, ∀ y : Abelian.Ext P (K.homology j) 1, ∃ z : Abelian.Ext P (K.cycles j) 1,
      z.comp (Abelian.Ext.mk₀ (K.homologyπ j)) (add_zero 1) = y) :=
by
  intro D _ _ _ K P hinj hvan
  have hS1 : ∀ j, (ShortComplex.mk (Limits.kernel.ι (K.homologyπ j)) (K.homologyπ j)
      (Limits.kernel.condition (K.homologyπ j))).ShortExact := fun j =>
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (K.homologyπ j)) inferInstance
      inferInstance
  have hS2 : ∀ j : ℕ, ∃ (g : K.X j ⟶ Limits.kernel (K.homologyπ (j + 1)))
      (hg : K.iCycles j ≫ g = 0), (ShortComplex.mk (K.iCycles j) g hg).ShortExact := by
    intro j
    let π' := K.homologyπ (j + 1)
    let t : K.X j ⟶ K.cycles (j + 1) := K.toCycles j (j + 1)
    let g : K.X j ⟶ Limits.kernel π' :=
      Limits.kernel.lift π' t (K.toCycles_comp_homologyπ j (j + 1))
    have hgd : g ≫ (Limits.kernel.ι π' ≫ K.iCycles (j + 1)) = K.d j (j + 1) := by
      rw [← Category.assoc, Limits.kernel.lift_ι]
      exact K.toCycles_i j (j + 1)
    have hg : K.iCycles j ≫ g = 0 := by
      rw [← cancel_mono (Limits.kernel.ι π' ≫ K.iCycles (j + 1)), Category.assoc, hgd,
        K.iCycles_d, Limits.zero_comp]
    refine ⟨g, hg, ?_⟩
    have hS' : (ShortComplex.mk (K.iCycles j) (K.d j (j + 1)) (K.iCycles_d j (j + 1))).Exact :=
      ShortComplex.exact_of_f_is_kernel _ (K.cyclesIsKernel j (j + 1) (CochainComplex.next ℕ j))
    let φ : ShortComplex.mk (K.iCycles j) g hg ⟶
        ShortComplex.mk (K.iCycles j) (K.d j (j + 1)) (K.iCycles_d j (j + 1)) :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := Limits.kernel.ι π' ≫ K.iCycles (j + 1)
        comm₁₂ := by simp
        comm₂₃ := by
          dsimp
          rw [Category.id_comp]
          exact hgd.symm }
    have : Epi φ.τ₁ := by dsimp [φ]; infer_instance
    have : IsIso φ.τ₂ := by dsimp [φ]; infer_instance
    have : Mono φ.τ₃ := by dsimp [φ]; infer_instance
    have hex : (ShortComplex.mk (K.iCycles j) g hg).Exact :=
      (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).2 hS'
    have hT : (ShortComplex.mk t π' (K.toCycles_comp_homologyπ j (j + 1))).Exact :=
      ShortComplex.exact_of_g_is_cokernel _
        (K.homologyIsCokernel j (j + 1) (CochainComplex.prev_nat_succ j))
    have : Epi g := hT.epi_kernelLift
    exact ShortComplex.ShortExact.mk' hex inferInstance inferInstance
  have hZ0 : ∀ {Y : D}, Limits.IsZero Y → ∀ (n : ℕ) (b : Abelian.Ext P Y n), b = 0 := by
    intro Y hY n b
    rw [← Abelian.Ext.comp_mk₀_id b, hY.eq_of_tgt (𝟙 Y) 0, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]
  have hB : ∀ j n : ℕ, 2 ≤ n → ∀ b : Abelian.Ext P (Limits.kernel (K.homologyπ j)) n,
      b = 0 := by
    intro j
    induction j with
    | zero =>
      intro n _ b
      have : IsIso (K.homologyπ 0) :=
        K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))
      exact hZ0 (Limits.isZero_kernel_of_mono _) n b
    | succ j ih =>
      have hV : ∀ m : ℕ, 3 ≤ m → ∀ z : Abelian.Ext P (K.cycles j) m, z = 0 := by
        intro m hm z
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS1 j) z (hvan m j hm _)
        rw [← hx₁, ih m (by omega) x₁, Abelian.Ext.zero_comp]
      intro n hn b
      obtain ⟨g, hg, hS⟩ := hS2 j
      obtain ⟨x₂, hx₂⟩ :=
        Abelian.Ext.covariant_sequence_exact₃ P hS b rfl (hV (n + 1) (by omega) _)
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      have := hinj j
      rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp]
  refine ⟨fun j z hz => ?_, fun j y => ?_⟩
  · obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS1 j) z hz
    rw [← hx₁, hB j 2 le_rfl x₁, Abelian.Ext.zero_comp]
  · obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 j) y rfl (hB j 2 le_rfl _)
    exact ⟨z, hz⟩

theorem wc_leray_col1_quotient : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C]
    [Abelian D] [HasExt C] [HasExt D] [HasInjectiveResolutions C] (L : D ⥤ C) (R : C ⥤ D)
    [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C)
    (I : InjectiveResolution A) {S : Type*} (s : S → (A ⟶ A)),
    (∀ j : ℕ, ∀ y : Abelian.Ext P
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology j) 1,
      ∃ z : Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cycles j) 1,
        z.comp (Abelian.Ext.mk₀
          (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ j))
          (add_zero 1) = y) →
    ∀ q : ℕ, ∃ (M : AddSubgroup (Abelian.Ext (L.obj P) A (q + 1)))
      (hM : ∀ (c : S), ∀ x ∈ M,
        (Abelian.Ext.mk₀ (s c)).postcomp (L.obj P) (add_zero (q + 1)) x ∈ M)
      (φ : M →+ Abelian.Ext P ((R.rightDerived q).obj A) 1),
      Function.Surjective φ ∧ ∀ (c : S) (x : M),
        φ ⟨(Abelian.Ext.mk₀ (s c)).postcomp (L.obj P) (add_zero (q + 1)) x, hM c x x.2⟩ =
          (Abelian.Ext.mk₀ ((R.rightDerived q).map (s c))).postcomp P (add_zero 1) (φ x) :=
by
  intro C D _ _ _ _ _ _ _ L R _ adj _ P A I S s hlift q
  set K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hK
  have hinj : Injective (K.X q) := by
    haveI := I.injective q
    exact Injective.injective_of_adjoint adj (I.cocomplex.X q)

  obtain ⟨B, u, v, h1, h2, hS1, hS2, huv⟩ : ∃ (B : D) (u : K.X q ⟶ B)
      (v : B ⟶ K.cycles (q + 1)) (h1 : K.iCycles q ≫ u = 0) (h2 : v ≫ K.homologyπ (q + 1) = 0),
      (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
        u ≫ v = K.toCycles q (q + 1) := by
    have hv : Limits.image.ι (K.d q (q + 1)) ≫ K.d (q + 1) (q + 1 + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d q (q + 1))), Limits.image.fac_assoc,
        K.d_comp_d, Limits.comp_zero]
    let v := K.liftCycles (Limits.image.ι (K.d q (q + 1))) (q + 1 + 1)
      (CochainComplex.next ℕ (q + 1)) hv
    have hvi : v ≫ K.iCycles (q + 1) = Limits.image.ι (K.d q (q + 1)) :=
      K.liftCycles_i _ _ _ _
    have huv : Limits.factorThruImage (K.d q (q + 1)) ≫ v = K.toCycles q (q + 1) := by
      rw [← cancel_mono (K.iCycles (q + 1)), Category.assoc, hvi, Limits.image.fac,
        K.toCycles_i]
    have h1 : K.iCycles q ≫ Limits.factorThruImage (K.d q (q + 1)) = 0 := by
      rw [← cancel_mono (Limits.image.ι (K.d q (q + 1))), Category.assoc, Limits.image.fac,
        Limits.zero_comp]
      exact K.iCycles_d q (q + 1)
    have h2 : v ≫ K.homologyπ (q + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d q (q + 1))), ← Category.assoc, huv,
        Limits.comp_zero]
      exact K.toCycles_comp_homologyπ q (q + 1)
    haveI : Mono v := mono_of_mono_fac hvi
    refine ⟨Limits.image (K.d q (q + 1)), Limits.factorThruImage (K.d q (q + 1)), v, h1, h2,
      ?_, ?_, huv⟩
    · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => K.liftCycles g' (q + 1) (CochainComplex.next ℕ q) (by
            rw [← Limits.image.fac (K.d q (q + 1)), ← Category.assoc,
              show g' ≫ Limits.factorThruImage (K.d q (q + 1)) = 0 from hg', Limits.zero_comp]))
          (fun g' hg' => K.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (K.iCycles q), K.liftCycles_i]
            exact hm))) inferInstance inferInstance
    · have hprev : (ComplexShape.up ℕ).prev (q + 1) = q := by simp
      refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel q (q + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel q (q + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
          (fun g' hg' m hm => by
            rw [← cancel_epi (K.homologyπ (q + 1))]
            exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel q (q + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
        inferInstance inferInstance
  haveI : Mono v := hS2.mono_f
  haveI : Epi u := hS1.epi_g

  have hβ : ∀ f : K ⟶ K, ∃ β : B ⟶ B, u ≫ β = f.f q ≫ u ∧
      β ≫ v = v ≫ HomologicalComplex.cyclesMap f (q + 1) := by
    intro f
    have hk : K.iCycles q ≫ f.f q ≫ u = 0 := by
      rw [← Category.assoc, ← HomologicalComplex.cyclesMap_i, Category.assoc, h1,
        Limits.comp_zero]
    have hub : u ≫ hS1.exact.desc (f.f q ≫ u) hk = f.f q ≫ u := hS1.exact.g_desc _ _
    refine ⟨hS1.exact.desc (f.f q ≫ u) hk, hub, ?_⟩
    rw [← cancel_epi u, ← cancel_mono (K.iCycles (q + 1))]
    simp only [Category.assoc, HomologicalComplex.cyclesMap_i]
    rw [reassoc_of% hub, reassoc_of% huv, reassoc_of% huv, HomologicalComplex.toCycles_i,
      HomologicalComplex.toCycles_i_assoc]
    exact f.comm q (q + 1)

  obtain ⟨lam, hlam⟩ : ∃ lam : S → (I.cocomplex ⟶ I.cocomplex),
      ∀ c, I.ι.f 0 ≫ (lam c).f 0 = s c ≫ I.ι.f 0 :=
    ⟨fun c => InjectiveResolution.desc (s c) I I,
      fun c => InjectiveResolution.desc_commutes_zero (s c) I I⟩
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : S → (K ⟶ K),
      ∀ c, Λ c = (R.mapHomologicalComplex (ComplexShape.up ℕ)).map (lam c) :=
    ⟨fun c => (R.mapHomologicalComplex (ComplexShape.up ℕ)).map (lam c), fun c => rfl⟩
  obtain ⟨ιh, ιi, hιhi, hιih, hιnat⟩ : ∃ (ιh : (R.rightDerived q).obj A ⟶ K.homology q)
      (ιi : K.homology q ⟶ (R.rightDerived q).obj A), ιh ≫ ιi = 𝟙 _ ∧ ιi ≫ ιh = 𝟙 _ ∧
      ∀ c, HomologicalComplex.homologyMap (Λ c) q ≫ ιi = ιi ≫ (R.rightDerived q).map (s c) := by
    refine ⟨(I.isoRightDerivedObj R q).hom, (I.isoRightDerivedObj R q).inv,
      (I.isoRightDerivedObj R q).hom_inv_id, (I.isoRightDerivedObj R q).inv_hom_id,
      fun c => ?_⟩
    have hstar := InjectiveResolution.isoRightDerivedObj_hom_naturality (s c) I I (lam c)
      (hlam c) R q
    have key : (R.mapHomologicalComplex (ComplexShape.up ℕ) ⋙
        HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map (lam c) ≫
          (I.isoRightDerivedObj R q).inv =
        (I.isoRightDerivedObj R q).inv ≫ (R.rightDerived q).map (s c) := by
      rw [Iso.comp_inv_eq, Category.assoc, hstar, Iso.inv_hom_id_assoc]
    rw [hΛ c]
    exact key

  have hadd : ∀ (Y : C) (a b : L.obj P ⟶ Y),
      adj.homEquiv P Y (a + b) = adj.homEquiv P Y a + adj.homEquiv P Y b := by
    intro Y a b
    simp only [Adjunction.homEquiv_unit, Functor.map_add, Preadditive.comp_add]
  have hsymm_add : ∀ (Y : C) (a b : P ⟶ R.obj Y),
      (adj.homEquiv P Y).symm (a + b) = (adj.homEquiv P Y).symm a + (adj.homEquiv P Y).symm b := by
    intro Y a b
    rw [Equiv.symm_apply_eq, hadd, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  have hφs0 : ∀ Y : C, (adj.homEquiv P Y).symm 0 = 0 := by
    intro Y
    rw [Equiv.symm_apply_eq, Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hzc : ∀ z : P ⟶ K.cycles (q + 1),
      (adj.homEquiv P (I.cocomplex.X (q + 1))).symm (z ≫ K.iCycles (q + 1)) ≫
        I.cocomplex.d (q + 1) (q + 1 + 1) = 0 := by
    intro z
    rw [← adj.homEquiv_naturality_right_symm, Category.assoc]
    have h3 : K.iCycles (q + 1) ≫ R.map (I.cocomplex.d (q + 1) (q + 1 + 1)) = 0 :=
      K.iCycles_d (q + 1) (q + 1 + 1)
    rw [h3, Limits.comp_zero, hφs0]
  have hextc : ∀ (f g : L.obj P ⟶ I.cocomplex.X (q + 1))
      (hf : f ≫ I.cocomplex.d (q + 1) (q + 1 + 1) = 0)
      (hg : g ≫ I.cocomplex.d (q + 1) (q + 1 + 1) = 0), f = g →
      I.extMk f (q + 1 + 1) rfl hf = I.extMk g (q + 1 + 1) rfl hg := by
    rintro f g hf hg rfl
    rfl
  obtain ⟨Θ, hΘapply⟩ : ∃ Θ : (P ⟶ K.cycles (q + 1)) →+ Abelian.Ext (L.obj P) A (q + 1),
      ∀ z, Θ z = I.extMk ((adj.homEquiv P (I.cocomplex.X (q + 1))).symm
        (z ≫ K.iCycles (q + 1))) (q + 1 + 1) rfl (hzc z) :=
    ⟨AddMonoidHom.mk' (fun z => I.extMk ((adj.homEquiv P (I.cocomplex.X (q + 1))).symm
        (z ≫ K.iCycles (q + 1))) (q + 1 + 1) rfl (hzc z)) (fun a b => by
        rw [I.add_extMk]
        apply hextc
        rw [Preadditive.add_comp, hsymm_add]), fun z => rfl⟩
  have hΘker : ∀ z, Θ z = 0 → ∃ e : P ⟶ K.X q, e ≫ K.toCycles q (q + 1) = z := by
    intro z hz
    rw [hΘapply, I.extMk_eq_zero_iff _ _ _ _ q rfl] at hz
    obtain ⟨g, hg⟩ := hz
    refine ⟨adj.homEquiv P _ g, ?_⟩
    rw [← cancel_mono (K.iCycles (q + 1)), Category.assoc, K.toCycles_i]
    show adj.homEquiv P _ g ≫ R.map (I.cocomplex.d q (q + 1)) = z ≫ K.iCycles (q + 1)
    rw [← adj.homEquiv_naturality_right, hg, Equiv.apply_symm_apply]
  have hΘnat : ∀ (c : S) z, Θ (z ≫ HomologicalComplex.cyclesMap (Λ c) (q + 1)) =
      (Θ z).comp (Abelian.Ext.mk₀ (s c)) (add_zero (q + 1)) := by
    intro c z
    let φ' : I.Hom I (s c) := InjectiveResolution.Hom.mk (lam c)
      (by rw [CochainComplex.single₀_map_f_zero]; exact hlam c)
    rw [hΘapply, hΘapply, InjectiveResolution.extMk_comp_mk₀ _ _ _ _ φ']
    apply hextc
    rw [Category.assoc, HomologicalComplex.cyclesMap_i, ← Category.assoc, hΛ c,
      Functor.mapHomologicalComplex_map_f]
    exact adj.homEquiv_naturality_right_symm _ _

  let N : AddSubgroup (P ⟶ K.cycles (q + 1)) :=
    { carrier := {z | z ≫ K.homologyπ (q + 1) = 0}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq] at *
        rw [Preadditive.add_comp, ha, hb, add_zero]
      zero_mem' := by
        simp only [Set.mem_setOf_eq]
        exact Limits.zero_comp
      neg_mem' := fun {a} ha => by
        simp only [Set.mem_setOf_eq] at *
        rw [Preadditive.neg_comp, ha, neg_zero] }
  have hb0 : ∀ z : N, z.1 ≫ K.homologyπ (q + 1) = 0 := fun z => z.2
  have hNstab : ∀ (c : S) z, z ∈ N → z ≫ HomologicalComplex.cyclesMap (Λ c) (q + 1) ∈ N := by
    intro c z hz
    have hz' : z ≫ K.homologyπ (q + 1) = 0 := hz
    show (z ≫ HomologicalComplex.cyclesMap (Λ c) (q + 1)) ≫ K.homologyπ (q + 1) = 0
    rw [Category.assoc, ← HomologicalComplex.homologyπ_naturality, ← Category.assoc, hz',
      Limits.zero_comp]
  let M : AddSubgroup (Abelian.Ext (L.obj P) A (q + 1)) := AddSubgroup.map Θ N
  have hM : ∀ (c : S), ∀ x ∈ M,
      (Abelian.Ext.mk₀ (s c)).postcomp (L.obj P) (add_zero (q + 1)) x ∈ M := by
    intro c x hx
    obtain ⟨z, hzN, rfl⟩ := AddSubgroup.mem_map.mp hx
    exact AddSubgroup.mem_map.mpr ⟨_, hNstab c z hzN, hΘnat c z⟩

  obtain ⟨bh, hb⟩ : ∃ bh : N →+ (P ⟶ B), ∀ z, bh z ≫ v = z.1 := by
    refine ⟨AddMonoidHom.mk' (fun z => hS2.exact.lift z.1 (hb0 z)) ?_,
      fun z => hS2.exact.lift_f _ _⟩
    intro a b
    rw [← cancel_mono v, Preadditive.add_comp]
    erw [hS2.exact.lift_f, hS2.exact.lift_f, hS2.exact.lift_f]
    all_goals rfl
  have hU : ∀ (z : N) (b' : P ⟶ B), b' ≫ v = z.1 → bh z = b' := fun z b' h => by
    rw [← cancel_mono v, hb, h]

  obtain ⟨πι, hπι⟩ : ∃ πι : K.cycles q ⟶ (R.rightDerived q).obj A,
      πι = K.homologyπ q ≫ ιi := ⟨_, rfl⟩
  obtain ⟨ψ0, hψ0⟩ : ∃ ψ0 : (P ⟶ B) →+ Abelian.Ext P ((R.rightDerived q).obj A) 1,
      ∀ b, ψ0 b = ((Abelian.Ext.mk₀ b).comp hS1.extClass (zero_add 1)).comp
        (Abelian.Ext.mk₀ πι) (add_zero 1) :=
    ⟨AddMonoidHom.mk' (fun b => ((Abelian.Ext.mk₀ b).comp hS1.extClass (zero_add 1)).comp
        (Abelian.Ext.mk₀ πι) (add_zero 1))
      (fun a b => by simp only [Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]), fun b => rfl⟩
  have hext0 : (Abelian.Ext.mk₀ u).comp hS1.extClass (zero_add 1) = 0 := hS1.comp_extClass
  have hψu : ∀ e : P ⟶ K.X q, ψ0 (e ≫ u) = 0 := by
    intro e
    rw [hψ0, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero, hext0,
      Abelian.Ext.comp_zero, Abelian.Ext.zero_comp]

  let ψ : N →+ Abelian.Ext P ((R.rightDerived q).obj A) 1 := ψ0.comp bh
  have hkey : ∀ a b : N, Θ a.1 = Θ b.1 → ψ a = ψ b := by
    intro a b hab
    have h0 : Θ (a - b).1 = 0 := by
      rw [AddSubgroup.coe_sub, map_sub, hab, sub_self]
    obtain ⟨e, he⟩ := hΘker _ h0
    have hbe : bh (a - b) = e ≫ u := hU _ _ (by rw [Category.assoc, huv, he])
    rw [← sub_eq_zero, ← map_sub]
    show ψ0 (bh (a - b)) = 0
    rw [hbe, hψu]
  have hsurjΘ := Θ.addSubgroupMap_surjective N
  let σ := Function.surjInv hsurjΘ
  have hσv : ∀ x : M, Θ (σ x).1 = x.1 := fun x =>
    (Θ.addSubgroupMap_apply_coe N (σ x)).symm.trans
      (congrArg Subtype.val (Function.surjInv_eq hsurjΘ x))
  let φ : M →+ Abelian.Ext P ((R.rightDerived q).obj A) 1 :=
    AddMonoidHom.mk' (fun x => ψ (σ x)) (fun x y => by
      rw [← map_add]
      apply hkey
      rw [AddSubgroup.coe_add, map_add, hσv, hσv, hσv, AddSubgroup.coe_add])
  have hφval : ∀ (m : M) (z : N), m.1 = Θ z.1 → φ m = ψ z := fun m z h =>
    show ψ (σ m) = ψ z from hkey (σ m) z (by rw [hσv, h])

  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨z₁, hz₁⟩ := hlift q (y.comp (Abelian.Ext.mk₀ ιh) (add_zero 1))
    have h0 : z₁.comp (Abelian.Ext.mk₀ (K.iCycles q)) (add_zero 1) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS1 z₁ h0 (zero_add 1)
    obtain ⟨b₀, hb₀⟩ : ∃ b₀ : P ⟶ B, Abelian.Ext.mk₀ b₀ = x₃ :=
      ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x₃⟩
    let zN : N := ⟨b₀ ≫ v, by
      show (b₀ ≫ v) ≫ K.homologyπ (q + 1) = 0
      rw [Category.assoc, h2, Limits.comp_zero]⟩
    refine ⟨⟨Θ zN.1, AddSubgroup.mem_map_of_mem Θ zN.2⟩,
      (hφval ⟨Θ zN.1, AddSubgroup.mem_map_of_mem Θ zN.2⟩ zN rfl).trans ?_⟩
    show ψ0 (bh zN) = y
    rw [hU zN b₀ rfl, hψ0, hb₀, hx₃, hπι, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hz₁, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, hιhi, Abelian.Ext.comp_mk₀_id]
  refine ⟨M, hM, φ, hsurj, ?_⟩

  intro c x
  obtain ⟨xv, hx⟩ := x
  obtain ⟨z, hzN, rfl⟩ := AddSubgroup.mem_map.mp hx
  obtain ⟨βc, hub, hβv⟩ := hβ (Λ c)
  let zc : N := ⟨z ≫ HomologicalComplex.cyclesMap (Λ c) (q + 1), hNstab c z hzN⟩
  have hbzc : bh zc = bh ⟨z, hzN⟩ ≫ βc :=
    hU zc _ (by rw [Category.assoc, hβv, ← Category.assoc, hb])
  have hN : hS1.extClass.comp (Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap (Λ c) q))
      (add_zero 1) = (Abelian.Ext.mk₀ βc).comp hS1.extClass (zero_add 1) :=
    hS1.extClass_naturality hS1
      (ShortComplex.Hom.mk (S₁ := ShortComplex.mk (K.iCycles q) u h1)
        (S₂ := ShortComplex.mk (K.iCycles q) u h1)
        (HomologicalComplex.cyclesMap (Λ c) q) ((Λ c).f q) βc
        (HomologicalComplex.cyclesMap_i _ _) hub.symm)
  have hc5 : (Abelian.Ext.mk₀ (bh ⟨z, hzN⟩ ≫ βc)).comp hS1.extClass (zero_add 1) =
      ((Abelian.Ext.mk₀ (bh ⟨z, hzN⟩)).comp hS1.extClass (zero_add 1)).comp
        (Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap (Λ c) q)) (add_zero 1) := by
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero, ← hN,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hfin : HomologicalComplex.cyclesMap (Λ c) q ≫ πι = πι ≫ (R.rightDerived q).map (s c) := by
    rw [hπι, Category.assoc,
      ← reassoc_of% (HomologicalComplex.homologyπ_naturality (Λ c) q), hιnat c]
  refine Eq.trans (b := ψ zc) (hφval _ zc ?_) ?_
  · exact (hΘnat c z).symm
  · rw [hφval ⟨Θ z, hx⟩ ⟨z, hzN⟩ rfl]
    show ψ0 (bh zc) = (ψ0 (bh ⟨z, hzN⟩)).comp
      (Abelian.Ext.mk₀ ((R.rightDerived q).map (s c))) (add_zero 1)
    rw [hbzc, hψ0, hψ0, hc5]
    generalize (Abelian.Ext.mk₀ (bh ⟨z, hzN⟩)).comp hS1.extClass (zero_add 1) = X
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hfin]

theorem wc_et_smooth_divisor_complement_coh_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y Z : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) [IsProper fY] (n : ℕ) [SmoothOfRelativeDimension n fY] [IrreducibleSpace Y] (iZ : Z ⟶ Y) [IsClosedImmersion iZ] [SmoothOfRelativeDimension (n - 1) (iZ ≫ fY)] [IrreducibleSpace Z], 1 ≤ n → ∀ (U : Y.Opens), (U : Set Y) = (Set.range iZ)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ q : ℕ, Finite (wcEtCoh U ℓ q) :=
by
  intro K _ _ Y Z fY _ n _ _ iZ _ _ _ hn U hU ℓ _ hℓ q
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _

  have hses : ∀ (S : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing Y ℓ))), S.ShortExact →
      ∀ (T : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (k : ℕ), Finite (Abelian.Ext S.X₂ T k) →
      Finite (Abelian.Ext S.X₃ T (k + 1)) → Finite (Abelian.Ext S.X₁ T k) := by
    intro S hS T k h2 h3
    let φ : Abelian.Ext S.X₂ T k →+ Abelian.Ext S.X₁ T k :=
      (Abelian.Ext.mk₀ S.f).precomp T (zero_add k)
    let ψ : Abelian.Ext S.X₁ T k →+ Abelian.Ext S.X₃ T (k + 1) :=
      hS.extClass.precomp T (Nat.add_comm 1 k)
    have hex : ∀ x, ψ x = 0 → ∃ y, φ y = x := fun x hx =>
      Abelian.Ext.contravariant_sequence_exact₁ hS T x (Nat.add_comm 1 k) hx
    let σ : Abelian.Ext S.X₃ T (k + 1) → Abelian.Ext S.X₁ T k :=
      fun c => if h : ∃ x, ψ x = c then h.choose else 0
    have hσ : ∀ x, ψ (σ (ψ x)) = ψ x := by
      intro x
      have h : ∃ x', ψ x' = ψ x := ⟨x, rfl⟩
      simp only [σ, dif_pos h]
      exact h.choose_spec
    have hpre : ∀ x, ∃ y, φ y = x - σ (ψ x) := fun x =>
      hex _ (by rw [map_sub, hσ, sub_self])
    choose τ hτ using hpre
    refine Finite.of_injective (fun x => (ψ x, τ x)) ?_
    intro x x' hxx
    simp only [Prod.mk.injEq] at hxx
    obtain ⟨e1, e2⟩ := hxx
    have := hτ x
    rw [e2, hτ x', e1] at this
    exact (sub_left_inj.mp this).symm

  have hsupp : ∀ (D : wcEtPullData iZ ℓ) (j : ℕ), Finite (wcEtSuppExt D j) := by
    intro D j
    haveI := D.additive
    haveI hPadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _
        D.cont D.φ).Additive :=
      Adjunction.right_adjoint_additive D.adj
    haveI hPlim : Limits.PreservesFiniteLimits
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ) := by
      haveI := D.adj.rightAdjoint_preservesLimits.{0, 0}
      exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} _
    haveI hLA := wc_et_closed_push_modules_isLeftAdjoint_u1 iZ ℓ D
    haveI hRadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _
        D.cont D.φ).rightAdjoint.Additive :=
      Adjunction.right_adjoint_additive
        (Adjunction.ofIsLeftAdjoint
          (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ))
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Z) (wcEtZModRing Z ℓ)
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Y) (wcEtZModRing Y ℓ)
    haveI hZp : IsProper (iZ ≫ fY) := inferInstance

    have hzeroFin : ∀ (p : ℕ) (T : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)), Limits.IsZero T →
        Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ)) T p) := by
      intro p T hT
      have h0 : ∀ y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ)) T p, y = 0 := by
        intro y
        calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id y).symm
          _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hT.eq_of_tgt (𝟙 _) 0]
          _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      haveI : Subsingleton (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ)) T p) :=
        ⟨fun a b => (h0 a).trans (h0 b).symm⟩
      exact Finite.of_subsingleton
    exact wc_leray_ext_finite
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ)
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ).rightAdjoint
      (Adjunction.ofIsLeftAdjoint
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ))
      (SheafOfModules.unit (wcEtZModRing Z ℓ)) (SheafOfModules.unit (wcEtZModRing Y ℓ))
      (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ)))
      (by
        intro p b
        rcases lt_trichotomy b 2 with hb | hb | hb
        · exact hzeroFin p _ (wc_et_closed_rightAdj_low_homology_zero K fY n (n - 1) 1 (by omega)
            iZ ℓ hℓ D
            (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _
              D.cont D.φ).rightAdjoint
            (Adjunction.ofIsLeftAdjoint
              (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ))
            (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) b (by omega))
        · subst hb
          obtain ⟨φ, hφ⟩ : ∃ φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
              ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _
                D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology 2),
              IsIso φ :=
            wc_et_closed_rightAdj_top_homology_unit_iso K fY n (n - 1) 1 (by omega) iZ ℓ hℓ D
              (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _
                D.cont D.φ).rightAdjoint
              (Adjunction.ofIsLeftAdjoint
                (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ))
              (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ)))
          haveI := hφ
          haveI hfinZ : Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
              (SheafOfModules.unit (wcEtZModRing Z ℓ)) p) := by
            obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Z ℓ p
            haveI := wc_etale_proper_finite K Z (iZ ≫ fY) ℓ hℓ p
            exact Finite.of_equiv _ E.symm
          refine Finite.of_injective (fun x => x.comp (Abelian.Ext.mk₀ (inv φ)) (add_zero p)) ?_
          intro x y hxy
          have key : ∀ z : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
              ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _
                D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology 2) p,
              (z.comp (Abelian.Ext.mk₀ (inv φ)) (add_zero p)).comp (Abelian.Ext.mk₀ φ)
                (add_zero p) = z := by
            intro z
            rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
              IsIso.inv_hom_id]
            exact Abelian.Ext.comp_mk₀_id z
          rw [← key x, ← key y]
          exact congrArg (fun w => w.comp (Abelian.Ext.mk₀ φ) (add_zero p)) hxy
        · exact hzeroFin p _ (wc_et_closed_push_rightAdj_high_vanishing K Y fY n (n - 1) Z iZ ℓ hℓ D
            (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _
              D.cont D.φ).rightAdjoint
            (Adjunction.ofIsLeftAdjoint
              (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iZ) _ _ D.cont D.φ))
            (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) b (by omega)))
      j

  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  obtain ⟨N, ι, hι, he⟩ := wc_et_extzero_module_mono Y U ℓ hℓpos
  haveI := hι
  obtain ⟨E1⟩ := wc_et_extzero_module_ext_open_coh Y U ℓ hℓpos N he q
  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iZ ℓ
  obtain ⟨c⟩ := wc_et_closed_coker_supp_obj_iso iZ ℓ U hU N ι hι he D
  have hS : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hι inferInstance
  have h2 : Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y ℓ))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) q) := by
    obtain ⟨E2⟩ := wc_et_zmodext_coh_equiv Y ℓ q
    haveI := wc_etale_proper_finite K Y fY ℓ hℓ q
    exact Finite.of_equiv _ E2.symm
  have h3 : Finite (Abelian.Ext (Limits.cokernel ι) (SheafOfModules.unit (wcEtZModRing Y ℓ))
      (q + 1)) := by
    haveI := hsupp D (q + 1)
    refine Finite.of_injective (β := wcEtSuppExt D (q + 1))
      (fun x => (Abelian.Ext.mk₀ c.inv).comp x (zero_add (q + 1))) ?_
    intro x y hxy
    have key : ∀ z : Abelian.Ext (Limits.cokernel ι) (SheafOfModules.unit (wcEtZModRing Y ℓ))
        (q + 1), (Abelian.Ext.mk₀ c.hom).comp ((Abelian.Ext.mk₀ c.inv).comp z (zero_add (q + 1)))
          (zero_add (q + 1)) = z := by
      intro z
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [← key x, ← key y]
    exact congrArg (fun w => (Abelian.Ext.mk₀ c.hom).comp w (zero_add (q + 1))) hxy
  haveI hN := hses _ hS _ q h2 h3
  exact Finite.of_equiv _ E1

theorem wc_pencil_punct_total_divisor_complement (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    CompactSpace ((wcProEtPullback D.f).obj (wcPunctGeom F'' D.u0 hP)).left ∧
    IsSeparated (Limits.terminal.from ((wcProEtPullback D.f).obj (wcPunctGeom F'' D.u0 hP)).left) ∧
    ∃ (Yb Zb : Scheme.{u}) (fY : Yb ⟶ Spec (.of (AlgebraicClosure F''))) (_ : IsProper fY)
      (_ : SmoothOfRelativeDimension n fY) (_ : IrreducibleSpace Yb) (iZ : Zb ⟶ Yb)
      (_ : IsClosedImmersion iZ) (_ : SmoothOfRelativeDimension (n - 1) (iZ ≫ fY))
      (_ : IrreducibleSpace Zb) (U : Yb.Opens),
      (U : Set Yb) = (Set.range iZ)ᶜ ∧
      Nonempty (((wcProEtPullback D.f).obj (wcPunctGeom F'' D.u0 hP)).left ≅ (U : Scheme.{u})) :=
by
  classical
  haveI := D.gi
  haveI := D.proper
  haveI := D.smooth
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange n
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange (n - 1)
  obtain ⟨hgiX, -, hsmX⟩ := wc_pencil_fibre_props F' F'' Y n hn2 D
  obtain ⟨hcO, -⟩ := wc_punct_geom_qcqs F'' D.u0 hP
  haveI hpB : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    exact IsProper.of_comp D.f (wcP1Over F'').hom

  have rng : ∀ {X X' Z : Scheme.{u}} (ι : X ≅ X') (h : X' ⟶ Z),
      Set.range (ι.hom ≫ h) = Set.range h := by
    intro X X' Z ι h
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨ι.hom w, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨z, rfl⟩
      exact ⟨ι.inv z, by rw [Scheme.Hom.comp_apply, Scheme.inv_hom_apply]⟩
  set g : Spec (.of (AlgebraicClosure F'')) ⟶ Spec (.of F'') :=
    Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) with hg
  haveI : CompactSpace (Limits.pullback (C := Scheme.{u})
      ((wcPunctOpen F'' D.u0 : (wcP1Over F'').left.Opens).ι)
      (Limits.pullback.fst (wcP1Over F'').hom g)) := hcO
  have hW : ((wcProEtPullback D.f).obj (wcPunctGeom F'' D.u0 hP)).left =
      Limits.pullback (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
        D.f := rfl
  rw [hW]

  have hw0 : (g ≫ D.u0) ≫ (wcP1Over F'').hom = 𝟙 _ ≫ g := by
    rw [Category.assoc, D.hu0, Category.comp_id, Category.id_comp]
  obtain ⟨ub, hub1, hub2⟩ : ∃ ub : Spec (.of (AlgebraicClosure F'')) ⟶
      Limits.pullback (wcP1Over F'').hom g,
      ub ≫ Limits.pullback.fst (wcP1Over F'').hom g = g ≫ D.u0 ∧
      ub ≫ Limits.pullback.snd (wcP1Over F'').hom g = 𝟙 _ :=
    ⟨Limits.pullback.lift (g ≫ D.u0) (𝟙 _) hw0, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  haveI hubc : IsClosedImmersion ub :=
    isClosedImmersion_of_comp_eq_id (Limits.pullback.snd (wcP1Over F'').hom g) ub hub2

  have hsq1 : IsPullback ub g (Limits.pullback.fst (wcP1Over F'').hom g) D.u0 := by
    refine IsPullback.of_right ?_ hub1 (IsPullback.of_hasPullback (wcP1Over F'').hom g).flip
    rw [hub2, D.hu0]
    exact IsPullback.id_horiz g
  obtain ⟨ι1, hι1⟩ : ∃ ι1 : Spec (.of (AlgebraicClosure F'')) ≅
      Limits.pullback (Limits.pullback.fst (wcP1Over F'').hom g) D.u0,
      ι1.hom ≫ Limits.pullback.fst (Limits.pullback.fst (wcP1Over F'').hom g) D.u0 = ub :=
    ⟨_, IsPullback.isoPullback_hom_fst hsq1⟩
  have hrub : Set.range ub =
      (Limits.pullback.fst (wcP1Over F'').hom g) ⁻¹' Set.range D.u0 := by
    rw [← hι1, rng, Scheme.Pullback.range_fst]

  have hwe : Limits.pullback.snd (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
        D.f ≫ D.f =
      (Limits.pullback.fst (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
        D.f ≫ Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g)) ≫
        Limits.pullback.fst (wcP1Over F'').hom g :=
    Limits.pullback.condition.symm.trans (Category.assoc _ _ _).symm
  obtain ⟨e, he1, he2⟩ : ∃ e : Limits.pullback (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
        D.f ⟶ Limits.pullback D.f (Limits.pullback.fst (wcP1Over F'').hom g),
      e ≫ Limits.pullback.fst D.f (Limits.pullback.fst (wcP1Over F'').hom g) =
        Limits.pullback.snd (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
          (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
          D.f ∧
      e ≫ Limits.pullback.snd D.f (Limits.pullback.fst (wcP1Over F'').hom g) =
        Limits.pullback.fst (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
          (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
          D.f ≫ Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
          (Limits.pullback.fst (wcP1Over F'').hom g) :=
    ⟨Limits.pullback.lift _ _ hwe, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsq : IsPullback e
      (Limits.pullback.fst (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
        D.f)
      (Limits.pullback.snd D.f (Limits.pullback.fst (wcP1Over F'').hom g))
      (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g)) := by
    refine IsPullback.of_right ?_ he2
      (IsPullback.of_hasPullback D.f (Limits.pullback.fst (wcP1Over F'').hom g))
    rw [he1]
    exact (IsPullback.of_hasPullback _ D.f).flip
  obtain ⟨ι, hι⟩ : ∃ ι : Limits.pullback (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
        (Limits.pullback.fst (wcP1Over F'').hom g) ≫ Limits.pullback.fst (wcP1Over F'').hom g)
        D.f ≅ Limits.pullback (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
          (Limits.pullback.fst (wcP1Over F'').hom g))
          (Limits.pullback.snd D.f (Limits.pullback.fst (wcP1Over F'').hom g)),
      ι.hom ≫ Limits.pullback.snd (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
          (Limits.pullback.fst (wcP1Over F'').hom g))
          (Limits.pullback.snd D.f (Limits.pullback.fst (wcP1Over F'').hom g)) = e :=
    ⟨_, IsPullback.isoPullback_hom_snd hsq.flip⟩
  haveI heo : IsOpenImmersion e := by rw [← hι]; infer_instance
