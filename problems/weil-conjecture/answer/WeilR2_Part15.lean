    have hdef := transfer _ _ (I.isoRightDerivedObj (wcProEtPush D.f) q) p (hD p q hpq)
    exact (@Abelian.Ext.chgUniv _ _ _ (HasExt.standard _) inferInstance _ _ p).injective
      ((hdef _).trans (hdef _).symm)

  have hz : (Abelian.Ext.mk₀ θ.hom).comp x0 (zero_add (2 * n)) = 0 := by
    exact (@Abelian.Ext.chgUniv _ _ _ (HasExt.standard _) inferInstance _ _ (2 * n)).symm.injective
      ((key _).trans (key _).symm)
  have hx : (Abelian.Ext.mk₀ θ.inv).comp ((Abelian.Ext.mk₀ θ.hom).comp x0 (zero_add (2 * n)))
      (zero_add (2 * n)) = x0 := by
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add (2 * n)) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  exact hx0 (by rw [← hx, hz, Abelian.Ext.comp_zero])

theorem wc_weaklyEtale_away_idem_lift (D C : Type u) [CommRing D] [IsDomain D] [CommRing C]
    [Algebra D C] (hW : Algebra.WeaklyEtale D C)
    (hnorm : ∀ (c : C) (s : D), s ≠ 0 → c * c = s • c → ∃ c' : C, c = s • c')
    (π : D) (hπ : π ≠ 0) :
    ∀ e : Localization.Away (algebraMap D C π), IsIdempotentElem e →
      ∃ c : C, IsIdempotentElem c ∧ algebraMap C (Localization.Away (algebraMap D C π)) c = e :=
by
  intro e he
  have : Module.Flat D C := hW.flat
  have REG : ∀ (m : ℕ) (x y : C), algebraMap D C π ^ m * x = algebraMap D C π ^ m * y →
      x = y := by
    intro m x y hxy
    have hreg : IsSMulRegular C (π ^ m) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors
        (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m hπ))
    apply hreg
    simp only [Algebra.smul_def, map_pow]
    exact hxy
  obtain ⟨n, a, E1⟩ := IsLocalization.Away.surj (algebraMap D C π) e
  have he' : e * e = e := he
  have s3 : algebraMap C (Localization.Away (algebraMap D C π)) (a * a) =
      algebraMap C (Localization.Away (algebraMap D C π)) (algebraMap D C π ^ n * a) := by
    rw [map_mul, map_mul, map_pow, ← E1]
    linear_combination
      (algebraMap C (Localization.Away (algebraMap D C π)) (algebraMap D C π) ^ n) ^ 2 * he'
  obtain ⟨⟨c, hc⟩, hc'⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers (algebraMap D C π))
    (Localization.Away (algebraMap D C π))).mp s3
  obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff c (algebraMap D C π)).mp hc
  have s5 : a * a = algebraMap D C π ^ n * a := REG k _ _ hc'
  have s5' : a * a = (π ^ n) • a := by rw [Algebra.smul_def, map_pow]; exact s5
  obtain ⟨c', E2⟩ := hnorm a (π ^ n) (pow_ne_zero n hπ) s5'
  have E2' : a = algebraMap D C π ^ n * c' := by rw [E2, Algebra.smul_def, map_pow]
  refine ⟨c', ?_, ?_⟩
  · show c' * c' = c'
    apply REG (n + n)
    have h1 : algebraMap D C π ^ (n + n) * (c' * c') = a * a := by rw [E2']; ring
    rw [h1, s5, E2']
    ring
  · have hu : IsUnit (algebraMap C (Localization.Away (algebraMap D C π)) (algebraMap D C π) ^ n) :=
      IsLocalization.Away.algebraMap_pow_isUnit (algebraMap D C π) n
    apply hu.mul_right_cancel
    rw [E1, E2', map_mul, map_pow]
    ring

theorem wc_basicOpen_clopen_lift (B : Type u) [CommRing B] (b : B)
    (hidem : ∀ e : Localization.Away b, IsIdempotentElem e →
      ∃ c : B, IsIdempotentElem c ∧ algebraMap B (Localization.Away b) c = e) :
    ∀ S : Set ↥(PrimeSpectrum.basicOpen b : Set (PrimeSpectrum B)), IsClopen S →
      ∃ C : Set (PrimeSpectrum B), IsClopen C ∧ Subtype.val ⁻¹' C = S :=
by
  intro S hS
  have hrange : Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away b))) =
      (PrimeSpectrum.basicOpen b : Set (PrimeSpectrum B)) :=
    PrimeSpectrum.localization_away_comap_range (Localization.Away b) b
  have hmem : ∀ q : PrimeSpectrum (Localization.Away b),
      PrimeSpectrum.comap (algebraMap B (Localization.Away b)) q ∈
        (PrimeSpectrum.basicOpen b : Set (PrimeSpectrum B)) := by
    intro q
    rw [← hrange]
    exact Set.mem_range_self q
  let ι' : PrimeSpectrum (Localization.Away b) →
      ↥(PrimeSpectrum.basicOpen b : Set (PrimeSpectrum B)) :=
    fun q => ⟨PrimeSpectrum.comap (algebraMap B (Localization.Away b)) q, hmem q⟩
  have hcont : Continuous ι' :=
    Continuous.subtype_mk (PrimeSpectrum.continuous_comap _) _
  have hT : IsClopen (ι' ⁻¹' S) := hS.preimage hcont
  obtain ⟨e, he, hTe⟩ := PrimeSpectrum.isClopen_iff.mp hT
  obtain ⟨c, hc, hce⟩ := hidem e he
  refine ⟨(PrimeSpectrum.basicOpen c : Set (PrimeSpectrum B)),
    PrimeSpectrum.isClopen_iff.mpr ⟨c, hc, rfl⟩, ?_⟩
  ext x
  obtain ⟨q, hq⟩ : ∃ q, PrimeSpectrum.comap (algebraMap B (Localization.Away b)) q = x.1 := by
    have hx1 : x.1 ∈ Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away b))) := by
      rw [hrange]; exact x.2
    exact hx1
  have hxq : ι' q = x := Subtype.ext hq
  have key : q ∈ ι' ⁻¹' S ↔ q ∈ (PrimeSpectrum.basicOpen e : Set _) := by
    rw [hTe]
  rw [Set.mem_preimage, hxq] at key
  rw [Set.mem_preimage, key, ← hq]
  simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal,
    Ideal.mem_comap, hce]

theorem wc_cont_approx_of_clopen_lift {X : Type u} {A : Type v} [TopologicalSpace X]
    [NormedAddCommGroup A] [IsUltrametricDist A] (U : Set X) (hU : IsCompact U)
    (hlift : ∀ S : Set U, IsClopen S → ∃ C : Set X, IsClopen C ∧ Subtype.val ⁻¹' C = S)
    (y : C(U, A)) (r : ℝ) (hr : 0 < r) :
    ∃ g : C(X, A), ∀ u : U, dist (g u) (y u) < r :=
by
  classical
  have hB : ∀ u : U, IsClopen (y ⁻¹' Metric.ball (y u) r) := fun u =>
    (IsUltrametricDist.isClopen_ball (y u) r).preimage y.continuous
  choose C hCcl hCpre using fun u : U => hlift _ (hB u)
  have hmem : ∀ v u : U, (v : X) ∈ C u ↔ dist (y v) (y u) < r := by
    intro v u
    have h1 : v ∈ Subtype.val ⁻¹' (C u) ↔ v ∈ y ⁻¹' Metric.ball (y u) r := by rw [hCpre u]
    simpa [Metric.mem_ball] using h1
  have hcov : U ⊆ ⋃ i, C i := by
    intro x hx
    rw [Set.mem_iUnion]
    refine ⟨⟨x, hx⟩, ?_⟩
    have := (hmem ⟨x, hx⟩ ⟨x, hx⟩).2 (by rw [dist_self]; exact hr)
    exact this
  obtain ⟨t, ht⟩ := hU.elim_finite_subcover C (fun i => (hCcl i).isOpen) hcov
  have key : ∀ s : Finset U, ∃ g : C(X, A), ∀ v : U, (v : X) ∈ ⋃ i ∈ s, C i →
      dist (g v) (y v) < r := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      refine ⟨ContinuousMap.const X 0, ?_⟩
      intro v hv
      simp at hv
    | insert a s has ih =>
      obtain ⟨g₀, hg₀⟩ := ih
      have hcont : Continuous ((C a).piecewise (fun _ => y a) g₀) := by
        apply Continuous.piecewise
        · intro x hx
          rw [(hCcl a).frontier_eq] at hx
          exact absurd hx (Set.notMem_empty x)
        · exact continuous_const
        · exact g₀.continuous
      refine ⟨⟨_, hcont⟩, ?_⟩
      intro v hv
      show dist ((C a).piecewise (fun _ => y a) g₀ v) (y v) < r
      by_cases hva : (v : X) ∈ C a
      · rw [Set.piecewise_eq_of_mem _ _ _ hva, dist_comm]
        exact (hmem v a).1 hva
      · rw [Set.piecewise_eq_of_notMem _ _ _ hva]
        apply hg₀ v
        rw [Set.mem_iUnion₂] at hv ⊢
        obtain ⟨i, hi, hvi⟩ := hv
        rcases Finset.mem_insert.mp hi with h | h
        · subst h; exact absurd hvi hva
        · exact ⟨i, h, hvi⟩
  obtain ⟨g, hg⟩ := key t
  exact ⟨g, fun u => hg u (ht u.2)⟩

theorem wc_cont_extend_of_approx {X : Type u} {A : Type v} [TopologicalSpace X]
    [NormedAddCommGroup A] [IsUltrametricDist A] [CompleteSpace A] (U : Set X) (y : U → A)
    (happrox : ∀ r : ℝ, 0 < r → ∃ g : C(X, A), ∀ u : U, dist (g u) (y u) < r) :
    ∃ F : C(X, A), ∀ u : U, F u = y u :=
by
  classical
  have trunc : ∀ (D : C(X, A)) (c : ℝ), 0 < c →
      ∃ T : C(X, A), (∀ x : X, ‖D x‖ < c → T x = D x) ∧ ∀ x : X, ‖T x‖ ≤ c := by
    intro D c hc
    have hclo : IsClopen {x : X | ‖D x‖ < c} := by
      have hset : {x : X | ‖D x‖ < c} = D ⁻¹' Metric.ball 0 c := by
        ext x; simp
      rw [hset]
      exact (IsUltrametricDist.isClopen_ball (0 : A) c).preimage D.continuous
    have hcont : Continuous (fun x => if ‖D x‖ < c then D x else 0) := by
      apply Continuous.if
      · intro a ha
        rw [hclo.frontier_eq] at ha
        exact absurd ha (Set.notMem_empty a)
      · exact D.continuous
      · exact continuous_const
    refine ⟨⟨_, hcont⟩, ?_, ?_⟩
    · intro x hx
      simp [hx]
    · intro x
      by_cases hx : ‖D x‖ < c
      · simp only [ContinuousMap.coe_mk, if_pos hx]; exact hx.le
      · simp only [ContinuousMap.coe_mk, if_neg hx, norm_zero]; exact hc.le
  have ulim : ∀ (S : ℕ → C(X, A)) (C : ℝ),
      (∀ (n : ℕ) (x : X), dist (S n x) (S (n + 1) x) ≤ C / 2 / 2 ^ n) →
      ∃ F : C(X, A), ∀ (n : ℕ) (x : X), dist (S n x) (F x) ≤ C / 2 ^ n := by
    intro S C hS
    have hlim : ∀ x, ∃ a, Filter.Tendsto (fun n => S n x) Filter.atTop (nhds a) := fun x =>
      cauchySeq_tendsto_of_complete (cauchySeq_of_le_geometric_two (fun n => hS n x))
    choose F₀ hF₀ using hlim
    have hrate : ∀ n x, dist (S n x) (F₀ x) ≤ C / 2 ^ n := fun n x =>
      dist_le_of_le_geometric_two_of_tendsto (fun n => hS n x) (hF₀ x) n
    have hunif : TendstoUniformly (fun n x => S n x) F₀ Filter.atTop := by
      rw [Metric.tendstoUniformly_iff]
      intro ε hε
      have ht : Filter.Tendsto (fun n : ℕ => C * (1/2 : ℝ) ^ n) Filter.atTop (nhds (C * 0)) :=
        (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).const_mul C
      rw [mul_zero] at ht
      filter_upwards [(tendsto_order.1 ht).2 ε hε] with n hn
      intro x
      rw [dist_comm]
      calc dist (S n x) (F₀ x) ≤ C / 2 ^ n := hrate n x
        _ = C * (1/2 : ℝ) ^ n := by rw [one_div_pow, mul_one_div]
        _ < ε := hn
    have hcont : Continuous F₀ :=
      hunif.continuous (Filter.Frequently.of_forall fun n => (S n).continuous)
    exact ⟨⟨F₀, hcont⟩, hrate⟩
  choose g hg using fun n : ℕ => happrox (1 / 2 ^ n) (by positivity)
  choose T hTeq hTle using fun n : ℕ => trunc (g (n+1) - g n) (4 / 2 / 2 ^ n) (by positivity)
  have hTU : ∀ n (u : U), T n u = g (n+1) u - g n u := by
    intro n u
    have h1 := hg (n+1) u
    have h2 := hg n u
    have hlt : ‖(g (n+1) - g n) (u : X)‖ < 4 / 2 / 2 ^ n := by
      rw [ContinuousMap.sub_apply, ← dist_eq_norm]
      have htri := dist_triangle (g (n+1) (u:X)) (y u) (g n (u:X))
      rw [dist_comm (y u)] at htri
      have e1 : (1:ℝ) / 2 ^ (n+1) = 1 / 2 * (1 / 2 ^ n) := by rw [pow_succ]; field_simp
      have e2 : (4:ℝ) / 2 / 2 ^ n = 2 * (1 / 2 ^ n) := by ring
      have hq : 0 < 1 / (2:ℝ)^n := by positivity
      rw [e1] at h1
      rw [e2]
      linarith
    rw [hTeq n u hlt, ContinuousMap.sub_apply]
  obtain ⟨S, hSdef⟩ : ∃ S : ℕ → C(X, A), S = fun N => g 0 + ∑ n ∈ Finset.range N, T n :=
    ⟨_, rfl⟩
  have hSapp : ∀ N x, S N x = g 0 x + ∑ n ∈ Finset.range N, T n x := by
    intro N x
    rw [hSdef]
    simp [ContinuousMap.sum_apply]
  have hSstep : ∀ N x, dist (S N x) (S (N+1) x) ≤ 4 / 2 / 2 ^ N := by
    intro N x
    rw [hSapp, hSapp, Finset.sum_range_succ, dist_eq_norm]
    have hh : g 0 x + ∑ n ∈ Finset.range N, T n x
        - (g 0 x + (∑ n ∈ Finset.range N, T n x + T N x)) = - T N x := by abel
    rw [hh, norm_neg]
    exact hTle N x
  have hSU : ∀ N (u : U), S N u = g N u := by
    intro N u
    induction N with
    | zero => rw [hSapp]; simp
    | succ N ih =>
      rw [hSapp, Finset.sum_range_succ, ← add_assoc, ← hSapp, ih, hTU]
      abel
  obtain ⟨F, hF⟩ := ulim S 4 hSstep
  refine ⟨F, fun u => ?_⟩
  have hbound : ∀ N : ℕ, dist (F u) (y u) ≤ 5 * (1/2 : ℝ) ^ N := by
    intro N
    have h1 := hF N u
    have h2 := hg N u
    rw [hSU] at h1
    have htri := dist_triangle (F (u:X)) (g N (u:X)) (y u)
    rw [dist_comm] at h1
    have e : (5:ℝ) * (1/2)^N = 4 / 2^N + 1/2^N := by rw [one_div_pow]; ring
    rw [e]; linarith
  apply dist_le_zero.mp
  by_contra hpos
  push_neg at hpos
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one
    (show 0 < dist (F u) (y u) / 5 by positivity) (show (1/2:ℝ) < 1 by norm_num)
  have := hbound N
  linarith

theorem wc_cont_extend_of_local_generize {X : Type u} {A : Type v} [TopologicalSpace X]
    [TopologicalSpace A] [T2Space A] (U : Set X) (y : C(U, A))
    (hgen : ∀ x : X, ∃ u ∈ U, u ⤳ x)
    (hloc : ∀ x : X, ∃ (Y : Type u) (_ : TopologicalSpace Y) (φ : Y → X) (G : C(Y, A)),
      Topology.IsOpenEmbedding φ ∧ x ∈ Set.range φ ∧
      ∀ (q : Y) (hq : φ q ∈ U), G q = y ⟨φ q, hq⟩) :
    ∃ F : C(X, A), ∀ u : U, F u = y u :=
by
  have s1 : ∀ (Y : Type u) (_ : TopologicalSpace Y) (φ : Y → X) (G : C(Y, A)),
      Topology.IsOpenEmbedding φ →
      (∀ (q : Y) (hq : φ q ∈ U), G q = y ⟨φ q, hq⟩) →
      ∀ (q : Y) (u : X) (hu : u ∈ U), u ⤳ φ q → y ⟨u, hu⟩ = G q := by
    intro Y _ φ G hemb hagree q u hu hsp
    have hmem : u ∈ Set.range φ := hsp.mem_open hemb.isOpen_range (Set.mem_range_self q)
    obtain ⟨p, rfl⟩ := hmem
    have hpq : p ⤳ q := hemb.isInducing.specializes_iff.mp hsp
    have hG : G p ⤳ G q := hpq.map G.continuous
    rw [← hagree p hu]
    exact hG.eq
  choose g hgU hgsp using hgen
  let F₀ : X → A := fun x => y ⟨g x, hgU x⟩
  have s3 : ∀ (Y : Type u) (_ : TopologicalSpace Y) (φ : Y → X) (G : C(Y, A)),
      Topology.IsOpenEmbedding φ →
      (∀ (q : Y) (hq : φ q ∈ U), G q = y ⟨φ q, hq⟩) →
      ∀ q : Y, F₀ (φ q) = G q := by
    intro Y _ φ G hemb hagree q
    exact s1 Y _ φ G hemb hagree q (g (φ q)) (hgU (φ q)) (hgsp (φ q))
  have hcont : Continuous F₀ := by
    rw [continuous_iff_continuousAt]
    intro x
    obtain ⟨Y, _, φ, G, hemb, ⟨q, rfl⟩, hagree⟩ := hloc x
    have hfun : F₀ ∘ φ = G := funext (fun q => s3 Y _ φ G hemb hagree q)
    have h1 : ContinuousAt (F₀ ∘ φ) q := by
      rw [hfun]; exact G.continuous.continuousAt
    exact (hemb.continuousAt_iff).mp h1
  refine ⟨⟨F₀, hcont⟩, ?_⟩
  intro u
  obtain ⟨Y, _, φ, G, hemb, ⟨q, hq⟩, hagree⟩ := hloc u
  have hqU : φ q ∈ U := hq ▸ u.2
  show F₀ (u : X) = y u
  have e1 : F₀ (φ q) = G q := s3 Y _ φ G hemb hagree q
  have e2 : G q = y ⟨φ q, hqU⟩ := hagree q hqU
  have e3 : y ⟨φ q, hqU⟩ = y u := congrArg y (Subtype.ext hq)
  exact (congrArg F₀ hq.symm).trans (e1.trans (e2.trans e3))

theorem wc_proet_P1_affine_chart (K : Type u) [Field K] (T : (wcP1Over K).left.ProEt)
    (x : T.left) :
    ∃ (B : Type u) (_ : CommRing B) (φ : Spec (.of B) ⟶ T.left) (ψ : Polynomial K →+* B)
      (j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left),
      IsOpenImmersion φ ∧ x ∈ Set.range φ ∧ IsOpenImmersion j ∧
      φ ≫ T.hom = Spec.map (CommRingCat.ofHom ψ) ≫ j ∧
      @Algebra.WeaklyEtale (Polynomial K) B _ _ ψ.toAlgebra :=
by
  classical

  have hcover : (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff
        (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩

  have hchart : ∀ (a : Fin (1 + 1)), ∃ eW : (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial K)), True := by
    intro a
    have hrev : a.rev ≠ a := by revert a; decide
    have hcases : ∀ i : Fin (1 + 1), i = a ∨ i = a.rev := by revert a; decide
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hscale : ∀ {S : Type u} [CommRing S] (f : K →+* S) (x : Fin (1 + 1) → S) (s : S)
        (p : MvPolynomial (Fin (1 + 1)) K) (n : ℕ), p.IsHomogeneous n →
        MvPolynomial.eval₂ f (fun i => s * x i) p = s ^ n * MvPolynomial.eval₂ f x p := by
      intro S _ f x s p n hp
      rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : ∑ i ∈ d.support, d i = n := by
        have h := hp (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum] using h
      simp_rw [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    have hf : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]; exact MvPolynomial.isHomogeneous_X K a
    have hb : (MvPolynomial.X a.rev : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := by
      rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X K a.rev
    let T : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a) :=
      HomogeneousLocalization.Away.mk _ hf 1 (MvPolynomial.X a.rev) hb
    let ι₀ := HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X a))
    let c₀ := algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)
    let ψ : Polynomial K →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a) :=
      Polynomial.eval₂RingHom (ι₀.comp c₀) T
    let χ₀ : MvPolynomial (Fin (1 + 1)) K →+* Polynomial K :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = a then 1 else Polynomial.X)
    have hχa : χ₀ (MvPolynomial.X a) = 1 := by simp [χ₀]
    have hχb : χ₀ (MvPolynomial.X a.rev) = Polynomial.X := by simp [χ₀, hrev]
    have hχC : ∀ k, χ₀ (MvPolynomial.C k) = Polynomial.C k := by intro k; simp [χ₀]
    let Λ : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) →+*
        Polynomial K :=
      IsLocalization.Away.lift (MvPolynomial.X a) (g := χ₀) (by rw [hχa]; exact isUnit_one)
    have hΛ : ∀ p, Λ (algebraMap _ (Localization.Away (MvPolynomial.X a :
        MvPolynomial (Fin (1 + 1)) K)) p) = χ₀ p := fun p => IsLocalization.Away.lift_eq _ _ p
    let χ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a) →+* Polynomial K :=
      Λ.comp (algebraMap _ (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
    have hΛ1 : ∀ y : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K),
        Λ (IsLocalization.mk' (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K)) 1 y) = 1 := by
      intro y
      have h := congrArg Λ (IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K)) (1 : MvPolynomial (Fin (1 + 1)) K) y)
      rw [map_mul, hΛ, hΛ] at h
      obtain ⟨n, hn⟩ := y.2
      rw [← hn, map_pow, hχa, one_pow, mul_one, map_one] at h
      exact h
    have F1 : ∀ n p hp, χ (HomogeneousLocalization.Away.mk _ hf n p hp) = χ₀ p := by
      intro n p hp
      simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one, map_mul, hΛ, hΛ1, mul_one]
    have F0 : ∀ k : K, (ι₀ (c₀ k)).val = algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.C k) := by
      intro k
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    have hψC : ∀ k, ψ (Polynomial.C k) = ι₀ (c₀ k) := by
      intro k; simp [ψ]
    have hψX : ψ Polynomial.X = T := by simp [ψ]
    have hi : χ.comp ψ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, hψC, RingHom.id_apply]
        simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [F0, hΛ, hχC]
      · rw [RingHom.comp_apply, hψX, RingHom.id_apply, F1, hχb]
    have hii : ψ.comp χ = RingHom.id _ := by
      apply RingHom.ext
      intro y
      obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hf y
      rw [RingHom.comp_apply, F1, RingHom.id_apply]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      let u : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩
      let V : MvPolynomial (Fin (1 + 1)) K →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        (algebraMap _ _).comp (ψ.comp χ₀)
      let W : MvPolynomial (Fin (1 + 1)) K →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        MvPolynomial.eval₂Hom (algebraMap K _) (fun i : Fin (1 + 1) => u *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X i))
      have hKA : ∀ k : K, algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.C k) = algebraMap K _ k := by
        intro k
        rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)),
          MvPolynomial.algebraMap_eq]
      have hVW : V = W := by
        apply MvPolynomial.ringHom_ext
        · intro k
          simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hχC, hψC,
            HomogeneousLocalization.algebraMap_apply]
          rw [F0, hKA]
        · intro i
          rcases hcases i with rfl | rfl
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχa, map_one, u]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            exact (Localization.mk_self (⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ :
              Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K))).symm
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχb, hψX, u,
              HomogeneousLocalization.algebraMap_apply, T, HomogeneousLocalization.Away.val_mk]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            congr 1
            ext
            simp
      have hval : (ψ (χ₀ p)).val = V p := by
        simp only [V, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      have hph : p.IsHomogeneous n := by
        have hp' := hp
        rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hp'
        exact hp'
      have heta : MvPolynomial.eval₂ (algebraMap K (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K))) (fun i : Fin (1 + 1) =>
            algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X i)) p =
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) p := by
        have h := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
          MvPolynomial.C MvPolynomial.X p
        rw [MvPolynomial.eval₂_eta] at h
        rw [h, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
        rfl
      rw [hval, hVW]
      simp only [W, MvPolynomial.coe_eval₂Hom]
      rw [hscale _ _ u p n hph, heta, ← Localization.mk_one_eq_algebraMap]
      simp only [u]
      rw [Localization.mk_pow, Localization.mk_mul, one_pow, one_mul, mul_one]
      congr 1
    let e2 : Spec (.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a))) ≅
        Spec (.of (Polynomial K)) :=
      { hom := Spec.map (CommRingCat.ofHom ψ)
        inv := Spec.map (CommRingCat.ofHom χ)
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hii]
          exact Spec.map_id _
        inv_hom_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hi]
          exact Spec.map_id _ }
    exact ⟨Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X a) hf Nat.one_pos ≪≫ e2, trivial⟩

  have hx0 : T.hom x ∈ (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) := by
    rw [hcover]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx0
  obtain ⟨eW, -⟩ := hchart a
  obtain ⟨j, hjdef⟩ : ∃ j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left,
      j = eW.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι := ⟨_, rfl⟩
  haveI hj : IsOpenImmersion j := by rw [hjdef]; infer_instance
  have hxj : T.hom x ∈ Set.range j := by
    have hxW : T.hom x ∈ Set.range (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι := by
      rw [Scheme.Opens.range_ι]; exact ha
    obtain ⟨w, hw⟩ := hxW
    refine ⟨eW.hom w, ?_⟩
    rw [hjdef, ← Scheme.Hom.comp_apply, Iso.hom_inv_id_assoc]
    exact hw

  let Uj : (wcP1Over K).left.Opens := ⟨Set.range j, IsOpenImmersion.isOpen_range j⟩
  obtain ⟨W, hWa, hxW, hWsub⟩ :=
    exists_isAffineOpen_mem_and_subset (U := T.hom ⁻¹ᵁ Uj) (x := x) hxj
  let φ : Spec (.of ↑Γ(T.left, W)) ⟶ T.left := hWa.fromSpec
  haveI hφ : IsOpenImmersion φ := hWa.isOpenImmersion_fromSpec
  have hxφ : x ∈ Set.range φ := by
    show x ∈ Set.range hWa.fromSpec
    rw [hWa.range_fromSpec]; exact hxW

  have hk : Set.range (φ ≫ T.hom) ⊆ Set.range j := by
    rintro _ ⟨q, rfl⟩
    have h1 : φ q ∈ (W : Set T.left) := by
      have : φ q ∈ Set.range hWa.fromSpec := ⟨q, rfl⟩
      rwa [hWa.range_fromSpec] at this
    have h2 : T.hom (φ q) ∈ Set.range j := hWsub h1
    rw [Scheme.Hom.comp_apply]
    exact h2
  have hg : IsOpenImmersion.lift j (φ ≫ T.hom) hk ≫ j = φ ≫ T.hom :=
    IsOpenImmersion.lift_fac _ _ _
  let ψ : Polynomial K →+* ↑Γ(T.left, W) :=
    (Spec.preimage (IsOpenImmersion.lift j (φ ≫ T.hom) hk)).hom
  have hψ : Spec.map (CommRingCat.ofHom ψ) = IsOpenImmersion.lift j (φ ≫ T.hom) hk := by
    simp only [ψ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hfac : φ ≫ T.hom = Spec.map (CommRingCat.ofHom ψ) ≫ j := by rw [hψ, hg]

  have hlpkt : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)
  have hWE : @Algebra.WeaklyEtale (Polynomial K) ↑Γ(T.left, W) _ _ ψ.toAlgebra := by
    haveI : WeaklyEtale T.hom := T.prop
    haveI : WeaklyEtale (φ ≫ T.hom) := inferInstance
    haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ) ≫ j) := by rw [← hfac]; infer_instance
    haveI : WeaklyEtale j := etale_le_weaklyEtale _ _ _ (inferInstance : Etale j)
    exact hlpkt _ _ ψ (WeaklyEtale.of_comp _ j)
  exact ⟨↑Γ(T.left, W), inferInstance, φ, ψ, j, hφ, hxφ, hj, hfac, hWE⟩

theorem wc_polynomial_chart_closed_principal (K : Type u) [Field K] (X : Scheme.{u})
    (Z : Set X) (hZ : IsClosed Z) (hZpt : ∀ z ∈ Z, IsClosed ({z} : Set X))
    (j : Spec (.of (Polynomial K)) ⟶ X) (hj : IsOpenImmersion j) :
    ∃ π : Polynomial K, π ≠ 0 ∧ ∀ p : PrimeSpectrum (Polynomial K), j p ∈ Z ↔ π ∈ p.asIdeal :=
by
  classical
  haveI := hj
  set W : Set (PrimeSpectrum (Polynomial K)) :=
    (fun p : PrimeSpectrum (Polynomial K) => j p) ⁻¹' Z with hW
  have hcont : Continuous (fun p : PrimeSpectrum (Polynomial K) => j p) := j.continuous
  have hWc : IsClosed W := hZ.preimage hcont
  have hinj : Function.Injective (fun p : PrimeSpectrum (Polynomial K) => j p) :=
    j.isOpenEmbedding.isEmbedding.injective
  have hmax : ∀ p ∈ W, p.asIdeal.IsMaximal := by
    intro p hp
    have h1 : IsClosed ((fun q : PrimeSpectrum (Polynomial K) => j q) ⁻¹' {j p}) :=
      (hZpt (j p) hp).preimage hcont
    have h2 : (fun q : PrimeSpectrum (Polynomial K) => j q) ⁻¹' {j p} = {p} := by
      ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => hinj h, fun h => by rw [h]⟩
    rw [h2] at h1
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mp h1
  have hbot : ¬ (⊥ : Ideal (Polynomial K)).IsMaximal := by
    intro h
    have hne : Ideal.span {(Polynomial.X : Polynomial K)} ≠ ⊤ := by
      rw [Ne, Ideal.span_singleton_eq_top]; exact Polynomial.not_isUnit_X
    have h3 : Ideal.span {(Polynomial.X : Polynomial K)} = ⊥ := (h.eq_of_le hne bot_le).symm
    rw [Ideal.span_singleton_eq_bot] at h3
    exact Polynomial.X_ne_zero h3
  let g : PrimeSpectrum (Polynomial K) := ⟨⊥, Ideal.isPrime_bot⟩
  have hg : g ∉ W := fun h => hbot (hmax g h)
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal W).mp hWc
  set π := Submodule.IsPrincipal.generator I with hπdef
  have hπ : Ideal.span {π} = I := Submodule.IsPrincipal.span_singleton_generator I
  have key : ∀ p : PrimeSpectrum (Polynomial K), p ∈ W ↔ π ∈ p.asIdeal := by
    intro p
    rw [hI, PrimeSpectrum.mem_zeroLocus, ← hπ, SetLike.coe_subset_coe,
      Ideal.span_singleton_le_iff_mem]
  refine ⟨π, ?_, fun p => key p⟩
  intro h0
  apply hg
  rw [key, h0]
  exact Submodule.zero_mem _

theorem wc_P1_contSheaf_extend_family (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (a m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) :
    ∀ (T : (wcP1Over K).left.ProEt)
      (fs : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V) (h : V ⟶ T)
        (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K))
        (hV' : ∀ (v : V'.left) (i : Fin m), V'.hom v ≠ S i (IsLocalRing.closedPoint K)),
        ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map k.op).hom (fs V h hV) =
          fs V' (k ≫ h) hV') →
      ∃ f : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T),
        ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T)
          (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)),
          ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom f = fs V h hV :=
by
  classical
  intro T fs compat

  obtain ⟨hZc, hgenZ⟩ := wc_P1_sections_closed_generize K m S hS
  have hZpt0 : ∀ z ∈ {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)},
      IsClosed ({z} : Set (wcP1Over K).left) := by
    rintro z ⟨i, rfl⟩
    have h1 := (wc_P1_sections_closed_generize K 1 (fun _ => S i) (fun _ => hS i)).1
    have e : {p : (wcP1Over K).left | ∃ _ : Fin 1, p = S i (IsLocalRing.closedPoint K)} =
        {S i (IsLocalRing.closedPoint K)} := by
      ext p
      simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
      exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨0, h⟩⟩
    rw [e] at h1
    exact h1

  let U' : (wcP1Over K).left.Opens :=
    ⟨{p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)}ᶜ,
      hZc.isOpen_compl⟩
  haveI hTwe : WeaklyEtale T.hom := T.prop
  let O : T.left.Opens := T.hom ⁻¹ᵁ U'
  have hmemO : ∀ t : T.left, t ∈ (O : Set T.left) ↔
      T.hom t ∉ {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)} :=
    fun t => Iff.rfl
  have hOw : WeaklyEtale O.ι := by
    first
      | exact etale_le_weaklyEtale _ (inferInstance : Etale O.ι)
      | exact etale_le_weaklyEtale _ _ _ (inferInstance : Etale O.ι)
      | infer_instance
  let V : (wcP1Over K).left.ProEt := MorphismProperty.Over.mk ⊤ (O.ι ≫ T.hom)
    (@MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hOw T.prop)
  let h : V ⟶ T := MorphismProperty.Over.homMk O.ι rfl trivial
  have hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K) := by
    intro v i hv
    have h1 : O.ι v ∈ (O : Set T.left) := (Scheme.Opens.range_ι O).subset ⟨v, rfl⟩
    exact (hmemO _).1 h1 ⟨i, hv⟩
  let dn : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V) →
      C(↥V.left, Fin a → ℚ_[ℓ]) := fun s => s.down
  let y : C(↥(O : Set T.left), Fin a → ℚ_[ℓ]) := dn (fs V h hV)

  have hgen : ∀ x : T.left, ∃ u ∈ (O : Set T.left), u ⤳ x := by
    intro x
    by_cases hx : T.hom x ∈
        {p : (wcP1Over K).left | ∃ i : Fin m, p = S i (IsLocalRing.closedPoint K)}
    · obtain ⟨t', ht', hn⟩ := hgenZ T x hx
      exact ⟨t', (hmemO t').2 hn, ht'⟩
    · exact ⟨x, (hmemO x).2 hx, specializes_refl x⟩

  have hloc : ∀ x : T.left, ∃ (Y : Type u) (_ : TopologicalSpace Y) (φ : Y → T.left)
      (G : C(Y, Fin a → ℚ_[ℓ])),
      Topology.IsOpenEmbedding φ ∧ x ∈ Set.range φ ∧
      ∀ (q : Y) (hq : φ q ∈ (O : Set T.left)), G q = y ⟨φ q, hq⟩ := by
    intro x
    obtain ⟨B, _, φ, ψ, j, hφ, hx, hj, hfac, hW⟩ := wc_proet_P1_affine_chart K T x
    obtain ⟨π, hπ, hπZ⟩ :=
      wc_polynomial_chart_closed_principal K (wcP1Over K).left _ hZc hZpt0 j hj
    have htrace : ∀ q : PrimeSpectrum B,
        φ q ∈ (O : Set T.left) ↔ q ∈ PrimeSpectrum.basicOpen (ψ π) := by
      intro q
      refine (hmemO _).trans ?_
      rw [PrimeSpectrum.mem_basicOpen]
      have e1 : T.hom (φ q) = j (Spec.map (CommRingCat.ofHom ψ) q) := by
        rw [← Scheme.Hom.comp_apply φ T.hom q, hfac]
        first
          | rfl
          | exact Scheme.Hom.comp_apply _ _ _
      rw [e1]
      refine not_congr ((hπZ _).trans ?_)
      have e2 := Spec.map_apply (CommRingCat.ofHom ψ) (show ↥(Spec (.of B)) from q)
      first
        | exact Iff.rfl
        | (erw [e2, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]; rfl)
        | (erw [e2]; rfl)
    letI : Algebra (Polynomial K) B := ψ.toAlgebra
    have hidem0 := wc_weaklyEtale_away_idem_lift (Polynomial K) B hW
      (wc_weaklyEtale_normal_idem (Polynomial K) B hW) π hπ
    have hidem : ∀ e : Localization.Away (ψ π), IsIdempotentElem e →
        ∃ c : B, IsIdempotentElem c ∧ algebraMap B (Localization.Away (ψ π)) c = e := hidem0
    have hlift := wc_basicOpen_clopen_lift B (ψ π) hidem
    let yB : C(↥(PrimeSpectrum.basicOpen (ψ π) : Set (PrimeSpectrum B)), Fin a → ℚ_[ℓ]) :=
      ⟨fun q => y ⟨φ q.1, (htrace q.1).2 q.2⟩, by
        apply y.continuous.comp
        exact Continuous.subtype_mk (φ.continuous.comp continuous_subtype_val) _⟩
    obtain ⟨FB, hFB⟩ := wc_cont_extend_of_approx (X := PrimeSpectrum B) _ ⇑yB
      (fun r hr => wc_cont_approx_of_clopen_lift _ (PrimeSpectrum.isCompact_basicOpen (ψ π))
        hlift yB r hr)
    refine ⟨PrimeSpectrum B, inferInstance, φ, FB, Scheme.Hom.isOpenEmbedding φ, hx, ?_⟩
    intro q hq
    exact (hFB ⟨q, (htrace q).1 hq⟩).trans rfl

  obtain ⟨F, hF⟩ := wc_cont_extend_of_local_generize (O : Set T.left) y hgen hloc
  let f : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T) :=
    (show ULift.{u+1} C(↥T.left, Fin a → ℚ_[ℓ]) from ULift.up F)
  have hresV : ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom f =
      fs V h hV := by
    have : (show ULift.{u+1} C(↥V.left, Fin a → ℚ_[ℓ]) from
          ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom f) =
        (show ULift.{u+1} C(↥V.left, Fin a → ℚ_[ℓ]) from fs V h hV) := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro v
      have h1 : O.ι v ∈ (O : Set T.left) := (Scheme.Opens.range_ι O).subset ⟨v, rfl⟩
      have e1 := hF ⟨O.ι v, h1⟩
      have e2 : (⟨O.ι v, h1⟩ : ↥(O : Set T.left)) = v := Subtype.ext (Scheme.Opens.ι_apply O v)
      exact e1.trans (congrArg y e2)
    exact this
  refine ⟨f, ?_⟩
  intro V' h' hV'
  have hrange : Set.range h'.left ⊆ Set.range O.ι := by
    rintro _ ⟨v, rfl⟩
    rw [Scheme.Opens.range_ι]
    refine (hmemO _).2 ?_
    rintro ⟨i, hi⟩
    apply hV' v i
    rw [← hi, ← Scheme.Hom.comp_apply h'.left T.hom v, MorphismProperty.Over.w h']
  let κ := IsOpenImmersion.lift O.ι h'.left hrange
  let k : V' ⟶ V := MorphismProperty.Over.homMk κ (by
      show κ ≫ (O.ι ≫ T.hom) = V'.hom
      rw [← Category.assoc, IsOpenImmersion.lift_fac, MorphismProperty.Over.w h']) trivial
  have hkh : k ≫ h = h' := by
    apply MorphismProperty.Over.Hom.ext
    first
      | exact IsOpenImmersion.lift_fac O.ι h'.left hrange
      | (erw [MorphismProperty.Comma.comp_left]; exact IsOpenImmersion.lift_fac O.ι h'.left hrange)
  have hcomp : ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map (k ≫ h).op).hom f =
      ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map k.op).hom
        (((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom f) := by
    rw [op_comp, Functor.map_comp]
    rfl
  have e3 : fs V' (k ≫ h) hV' = fs V' h' hV' := by rw [hkh]
  have e4 : ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h'.op).hom f =
      ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map (k ≫ h).op).hom f := by
    rw [hkh]
  rw [e4, hcomp, hresV, compat V V' k h hV hV', e3]

theorem wc_P1_contSheaf_off_points_vanish (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (a m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) :
    ∀ (T : (wcP1Over K).left.ProEt)
      (x : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T)),
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom x = 0) → x = 0 :=
by
  intro T x hx
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have hprime : (⊥ : HomogeneousIdeal
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).toIdeal.IsPrime := by
    rw [HomogeneousIdeal.toIdeal_bot]
    exact Ideal.isPrime_bot
  have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      ≤ ⊥ := by
    intro h
    have hX0 := HomogeneousIdeal.mem_irrelevant_of_mem
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1))))
    have h0 := h hX0
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
    exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
  let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    ⟨⊥, hprime, hirr⟩
  have hcl : ∀ y : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
      y ∈ closure ({η} : Set _) := fun y =>
    (ProjectiveSpectrum.le_iff_mem_closure _ η y).mp
      ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η y).mp bot_le)
  let ηP : (wcP1Over K).left := η
  have hspec : ∀ y : (wcP1Over K).left, ηP ⤳ y := fun y =>
    specializes_iff_mem_closure.mpr (hcl y)

  have hX0h : ∀ x ∈ ({MvPolynomial.X (0 : Fin (1 + 1))} : Set (MvPolynomial (Fin (1 + 1)) K)),
      SetLike.IsHomogeneousElem (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) x := by
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
      (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1)))⟩
  let I0 : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    ⟨Ideal.span {MvPolynomial.X (0 : Fin (1 + 1))},
      Ideal.homogeneous_span (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) _ hX0h⟩
  have hI0toIdeal : I0.toIdeal = Ideal.span {MvPolynomial.X (0 : Fin (1 + 1))} := rfl
  have hprime0 : I0.toIdeal.IsPrime := by
    rw [hI0toIdeal]
    exact (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero _)).mpr MvPolynomial.X_prime
  have hirr0 : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      ≤ I0 := by
    intro h
    have hX1 := HomogeneousIdeal.mem_irrelevant_of_mem
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K (1 : Fin (1 + 1))))
    have h1 := h hX1
    rw [← HomogeneousIdeal.mem_iff, hI0toIdeal, Ideal.mem_span_singleton,
      MvPolynomial.X_dvd_X] at h1
    exact absurd h1 (by decide)
  let p : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    ⟨I0, hprime0, hirr0⟩
  have hηp : η ≠ p := by
    intro hEq
    have e := congrArg (fun q : ProjectiveSpectrum
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) => q.asHomogeneousIdeal.toIdeal) hEq
    have hmem : MvPolynomial.X (0 : Fin (1 + 1)) ∈ p.asHomogeneousIdeal.toIdeal := by
      show MvPolynomial.X (0 : Fin (1 + 1)) ∈ I0.toIdeal
      rw [hI0toIdeal]
      exact Ideal.subset_span (Set.mem_singleton _)
    have e' : η.asHomogeneousIdeal.toIdeal = p.asHomogeneousIdeal.toIdeal := e
    rw [← e'] at hmem
    have hb : η.asHomogeneousIdeal.toIdeal = ⊥ := HomogeneousIdeal.toIdeal_bot
    rw [hb, Ideal.mem_bot] at hmem
    exact MvPolynomial.X_ne_zero _ hmem
  let pP : (wcP1Over K).left := p
  have hηpP : ηP ≠ pP := hηp

  have hclosed : ∀ i, IsClosed ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) := by
    intro i
    haveI : IsSeparated (wcP1Over K).hom := by
      first
        | infer_instance
        | (show IsSeparated (_ ≫ _); infer_instance)
    haveI : IsClosedImmersion (S i ≫ (wcP1Over K).hom) := by
      rw [hS i]; infer_instance
    haveI : IsClosedImmersion (S i) := IsClosedImmersion.of_comp (S i) (wcP1Over K).hom
    have hr : IsClosed (Set.range (S i)) := (S i).isClosedEmbedding.isClosed_range
    have hrange : Set.range (S i) = {S i (IsLocalRing.closedPoint K)} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rwa [hrange] at hr

  have hηS : ∀ i, ηP ≠ S i (IsLocalRing.closedPoint K) := by
    intro i hEq
    have h1 : pP ∈ closure ({ηP} : Set (wcP1Over K).left) :=
      specializes_iff_mem_closure.mp (hspec pP)
    rw [hEq, (hclosed i).closure_eq, Set.mem_singleton_iff] at h1
    exact hηpP (hEq.trans h1.symm)

  let U' : (wcP1Over K).left.Opens :=
    ⟨⋂ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)ᶜ,
      isOpen_iInter_of_finite (fun i => (hclosed i).isOpen_compl)⟩
  have hηU : ηP ∈ U' := by
    show ηP ∈ ⋂ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)ᶜ
    rw [Set.mem_iInter]
    intro i
    exact hηS i
  haveI hTwe : WeaklyEtale T.hom := T.prop
  haveI hTfl : Flat T.hom := inferInstance
  let O : T.left.Opens := T.hom ⁻¹ᵁ U'
  have hOw : WeaklyEtale O.ι := by
    first
      | exact etale_le_weaklyEtale _ (inferInstance : Etale O.ι)
      | exact etale_le_weaklyEtale _ _ _ (inferInstance : Etale O.ι)
      | infer_instance
  let V : (wcP1Over K).left.ProEt := MorphismProperty.Over.mk ⊤ (O.ι ≫ T.hom)
    (@MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hOw T.prop)
  let h : V ⟶ T := MorphismProperty.Over.homMk O.ι rfl trivial
  have hav : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K) := by
    intro v i
    have hv : O.ι v ∈ O := by
      exact (Scheme.Opens.range_ι O).subset ⟨v, rfl⟩
    have hv' : T.hom (O.ι v) ∈ U' := hv
    have hv'' : T.hom (O.ι v) ∈ ⋂ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)ᶜ :=
      hv'
    rw [Set.mem_iInter] at hv''
    have e : V.hom v = T.hom (O.ι v) := rfl
    rw [e]
    exact hv'' i
  have hzero := hx V h hav
  let f : C(↥T.left, Fin a → ℚ_[ℓ]) := x.down
  have hfO : ∀ t : T.left, T.hom t ∈ U' → f t = 0 := by
    intro t ht
    have htO : t ∈ O := ht
    obtain ⟨v, rfl⟩ := (Scheme.Opens.range_ι O).symm.subset htO
    let dn : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V) →
        C(↥V.left, Fin a → ℚ_[ℓ]) := fun y => y.down
    have e2 : ∀ y : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V),
        y = 0 → dn y v = 0 := by
      intro y hy
      subst hy
      first
        | rfl
        | simp [dn]
    have e1 : dn (((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom x) v =
        f (h.left v) := rfl
    exact e1.symm.trans (e2 _ hzero)
  have hall : ∀ t : T.left, f t = 0 := by
    intro t
    obtain ⟨t', ht't, hη⟩ := Flat.generalizingMap T.hom (hspec (T.hom t))
    have h1 : f t' = 0 := hfO t' (by rw [hη]; exact hηU)
    have h2 : f t' ⤳ f t := ht't.map f.continuous
    rw [← h2.eq]
    exact h1
  apply ULift.ext
  apply ContinuousMap.ext
  intro t
  exact hall t

theorem wc_P1_contSheaf_openRestr_bij (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (O : (wcP1Over K).left.Opens) (hO : ∀ p : (wcP1Over K).left, p ∈ O ↔ ∀ i : Fin m, p ≠ S i (IsLocalRing.closedPoint K)) : ∀ T : (wcP1Over K).left.ProEt, Function.Bijective ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map (wcOpenRestrIncl (wcP1Over K).left O T).op) :=
by
  classical
  intro T
  have hres : ∀ {T₁ T₂ T₃ : (wcP1Over K).left.ProEt} (h : T₁ ⟶ T₂) (k : T₂ ⟶ T₃)
      (z : (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T₃)),
      ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map (h ≫ k).op).hom z =
        ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map h.op).hom
          (((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map k.op).hom z) := by
    intro T₁ T₂ T₃ h k z
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  have hinO : ∀ (p : (wcOpenRestr (wcP1Over K).left O T).left),
      (wcOpenRestr (wcP1Over K).left O T).hom p ∈ O := by
    intro p
    have e : (wcOpenRestr (wcP1Over K).left O T).hom = Limits.pullback.fst O.ι T.hom ≫ O.ι :=
      Limits.pullback.condition.symm
    have h2 : (wcOpenRestr (wcP1Over K).left O T).hom p = O.ι (Limits.pullback.fst O.ι T.hom p) := by
      rw [e]
      first
        | exact Scheme.Hom.comp_apply _ _ _
        | rfl
        | exact (Scheme.Hom.comp_apply (Limits.pullback.fst O.ι T.hom) O.ι p)
    rw [h2]
    have hm : O.ι (Limits.pullback.fst O.ι T.hom p) ∈ Set.range O.ι := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at hm
    exact hm
  have fac : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T), (∀ v : V.left, V.hom v ∈ O) →
      ∃ hO' : V ⟶ wcOpenRestr (wcP1Over K).left O T,
        hO' ≫ wcOpenRestrIncl (wcP1Over K).left O T = h := by
    intro V h hV
    have hr : Set.range V.hom ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨v, rfl⟩
      exact hV v
    have hw : IsOpenImmersion.lift O.ι V.hom hr ≫ O.ι = h.left ≫ T.hom := by
      rw [IsOpenImmersion.lift_fac, MorphismProperty.Over.w h]
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hw) ?_ trivial, ?_⟩
    · show Limits.pullback.lift _ _ hw ≫ Limits.pullback.snd O.ι T.hom ≫ T.hom = V.hom
      rw [Limits.pullback.lift_snd_assoc, MorphismProperty.Over.w h]
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_snd _ _ _
  have uniq : ∀ (V : (wcP1Over K).left.ProEt) (p q : V ⟶ wcOpenRestr (wcP1Over K).left O T),
      p ≫ wcOpenRestrIncl (wcP1Over K).left O T = q ≫ wcOpenRestrIncl (wcP1Over K).left O T →
      p = q := by
    intro V p q hpq
    apply MorphismProperty.Over.Hom.ext
    have h1 : (p.left : V.left ⟶ Limits.pullback O.ι T.hom) ≫ Limits.pullback.snd O.ι T.hom =
        (q.left : V.left ⟶ Limits.pullback O.ι T.hom) ≫ Limits.pullback.snd O.ι T.hom :=
      congrArg (fun r => r.left) hpq
    haveI : Mono (Limits.pullback.snd O.ι T.hom) := inferInstance
    exact (cancel_mono (Limits.pullback.snd O.ι T.hom)).mp h1
  have hfac : ∀ (V' : (wcP1Over K).left.ProEt) (h : V' ⟶ T),
      (∀ (v : V'.left) (i : Fin m), V'.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ hO' : V' ⟶ wcOpenRestr (wcP1Over K).left O T,
        hO' ≫ wcOpenRestrIncl (wcP1Over K).left O T = h :=
    fun V' h hV' => fac V' h (fun v => (hO _).2 (hV' v))
  choose g hg using hfac
  refine ⟨?_, ?_⟩
  ·
    show Function.Injective
      ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map
        (wcOpenRestrIncl (wcP1Over K).left O T).op).hom
    rw [injective_iff_map_eq_zero]
    intro x hx
    apply wc_P1_contSheaf_off_points_vanish K ℓ a m S hS T x
    intro V h hV
    rw [← hg V h hV, hres, hx, map_zero]
  ·
    intro y
    have hcompat : ∀ (V₁ V₂ : (wcP1Over K).left.ProEt) (k : V₂ ⟶ V₁) (h : V₁ ⟶ T)
        (hV₁ : ∀ (v : V₁.left) (i : Fin m), V₁.hom v ≠ S i (IsLocalRing.closedPoint K))
        (hV₂ : ∀ (v : V₂.left) (i : Fin m), V₂.hom v ≠ S i (IsLocalRing.closedPoint K)),
        ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map k.op).hom
          (((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map (g V₁ h hV₁).op).hom y) =
          ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map (g V₂ (k ≫ h) hV₂).op).hom y := by
      intro V₁ V₂ k h hV₁ hV₂
      have e : k ≫ g V₁ h hV₁ = g V₂ (k ≫ h) hV₂ :=
        uniq _ _ _ (by rw [Category.assoc, hg, hg])
      rw [← e, hres k (g V₁ h hV₁) y]
    obtain ⟨f, hf⟩ := wc_P1_contSheaf_extend_family K ℓ a m S hS T
      (fun V' h hV' => ((wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).obj.map
        (g V' h hV').op).hom y) hcompat
    have hTO : ∀ (v : (wcOpenRestr (wcP1Over K).left O T).left) (i : Fin m),
        (wcOpenRestr (wcP1Over K).left O T).hom v ≠ S i (IsLocalRing.closedPoint K) :=
      fun v => (hO _).1 (hinO v)
    have hid : g _ (wcOpenRestrIncl (wcP1Over K).left O T) hTO = 𝟙 _ :=
      uniq _ _ _ (by rw [hg, Category.id_comp])
    refine ⟨f, (hf _ (wcOpenRestrIncl (wcP1Over K).left O T) hTO).trans ?_⟩
    beta_reduce
    rw [hid, op_id, CategoryTheory.Functor.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]

theorem wc_P1_contSheaf_hom_extend_offS (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (a m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (B₀ : (wcP1Over K).left.ProEt) (O : (wcP1Over K).left.Opens)
    (hO : ∀ p : (wcP1Over K).left, p ∈ O ↔ ∀ i : Fin m, p ≠ S i (IsLocalRing.closedPoint K))
    (τ : G.over (wcOpenRestr (wcP1Over K).left O B₀) ⟶
      (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).over (wcOpenRestr (wcP1Over K).left O B₀)) :
    ∃ φ : G.over B₀ ⟶ (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ])).over B₀,
      ∀ (V : (wcP1Over K).left.ProEt) (g' : V ⟶ wcOpenRestr (wcP1Over K).left O B₀)
        (x : G.obj.obj (Opposite.op V)),
        (φ.hom.app (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl (wcP1Over K).left O B₀)))).hom x =
          (τ.hom.app (Opposite.op (Over.mk g'))).hom x :=
by
  classical
  have key : ∀ (Sc : Scheme.{u}) (O : Sc.Opens)
      (G C : Sheaf (Scheme.ProEt.topology Sc) AddCommGrpCat.{u+1})
      (hC : ∀ T : Sc.ProEt, Function.Bijective (C.obj.map (wcOpenRestrIncl Sc O T).op))
      (B₀ : Sc.ProEt) (τ : G.over (wcOpenRestr Sc O B₀) ⟶ C.over (wcOpenRestr Sc O B₀)),
      ∃ φ : G.over B₀ ⟶ C.over B₀, ∀ (V : Sc.ProEt) (g' : V ⟶ wcOpenRestr Sc O B₀)
        (x : G.obj.obj (Opposite.op V)),
        (φ.hom.app (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀)))).hom x =
          (τ.hom.app (Opposite.op (Over.mk g'))).hom x := by
    intro Sc O G C hC B₀ τ
    have hmono : ∀ T : Sc.ProEt, Mono (wcOpenRestrIncl Sc O T) := by
      intro T
      constructor
      intro Z a b h
      apply MorphismProperty.Over.Hom.ext
      have h' : a.left ≫ Limits.pullback.snd O.ι T.hom = b.left ≫ Limits.pullback.snd O.ι T.hom :=
        congrArg (fun f => f.left) h
      exact (cancel_mono (Limits.pullback.snd O.ι T.hom)).mp h'
    have hlift : ∀ (T T' : Sc.ProEt) (c : T' ⟶ T), ∃ cO : wcOpenRestr Sc O T' ⟶ wcOpenRestr Sc O T,
        cO ≫ wcOpenRestrIncl Sc O T = wcOpenRestrIncl Sc O T' ≫ c := by
      intro T T' c
      have hm : Limits.pullback.fst O.ι T'.hom ≫ O.ι =
          (Limits.pullback.snd O.ι T'.hom ≫ c.left) ≫ T.hom := by
        rw [Category.assoc, MorphismProperty.Over.w c, Limits.pullback.condition]
      let m := Limits.pullback.lift (Limits.pullback.fst O.ι T'.hom)
        (Limits.pullback.snd O.ι T'.hom ≫ c.left) hm
      have hms : m ≫ Limits.pullback.snd O.ι T.hom = Limits.pullback.snd O.ι T'.hom ≫ c.left :=
        Limits.pullback.lift_snd _ _ _
      refine ⟨MorphismProperty.Over.homMk m ?_ trivial, ?_⟩
      · show m ≫ (Limits.pullback.snd O.ι T.hom ≫ T.hom) = Limits.pullback.snd O.ι T'.hom ≫ T'.hom
        rw [← Category.assoc, hms, Category.assoc, MorphismProperty.Over.w c]
      · apply MorphismProperty.Over.Hom.ext
        exact hms
    choose gO hgO using fun (X : (Over B₀)ᵒᵖ) => hlift B₀ X.unop.left X.unop.hom
    let XO : (Over B₀)ᵒᵖ → (Over (wcOpenRestr Sc O B₀))ᵒᵖ := fun X => Opposite.op (Over.mk (gO X))
    let eC : ∀ T : Sc.ProEt, C.obj.obj (Opposite.op T) ≃+
        C.obj.obj (Opposite.op (wcOpenRestr Sc O T)) := fun T =>
      AddEquiv.ofBijective (C.obj.map (wcOpenRestrIncl Sc O T).op).hom (hC T)
    have heC : ∀ T x, eC T x = (C.obj.map (wcOpenRestrIncl Sc O T).op).hom x := fun T x => rfl
    let E : ∀ X : (Over B₀)ᵒᵖ, G.obj.obj (Opposite.op X.unop.left) →+
        C.obj.obj (Opposite.op X.unop.left) := fun X =>
      (eC X.unop.left).symm.toAddMonoidHom.comp
        ((τ.hom.app (XO X)).hom.comp (G.obj.map (wcOpenRestrIncl Sc O X.unop.left).op).hom)
    have hE : ∀ X x, eC X.unop.left (E X x) =
        (τ.hom.app (XO X)).hom ((G.obj.map (wcOpenRestrIncl Sc O X.unop.left).op).hom x) := by
      intro X x
      exact AddEquiv.apply_symm_apply _ _
    have hnat : ∀ (X Y : (Over B₀)ᵒᵖ) (k : X ⟶ Y) (x : G.obj.obj (Opposite.op X.unop.left)),
        E Y ((G.obj.map k.unop.left.op).hom x) = (C.obj.map k.unop.left.op).hom (E X x) := by
      intro X Y k x
      obtain ⟨cO, hc⟩ := hlift X.unop.left Y.unop.left k.unop.left
      have hcg : cO ≫ gO X = gO Y := by
        rw [← cancel_mono (wcOpenRestrIncl Sc O B₀)]
        rw [Category.assoc, hgO X, ← Category.assoc, hc, Category.assoc, Over.w k.unop, hgO Y]
      have hfG : ∀ y, (G.obj.map (wcOpenRestrIncl Sc O Y.unop.left).op).hom
          ((G.obj.map k.unop.left.op).hom y) =
          (G.obj.map cO.op).hom ((G.obj.map (wcOpenRestrIncl Sc O X.unop.left).op).hom y) := by
        intro y
        have := congrArg (fun f => (G.obj.map f.op).hom y) hc
        simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
          at this
        exact this.symm
      have hfC : ∀ y, (C.obj.map (wcOpenRestrIncl Sc O Y.unop.left).op).hom
          ((C.obj.map k.unop.left.op).hom y) =
          (C.obj.map cO.op).hom ((C.obj.map (wcOpenRestrIncl Sc O X.unop.left).op).hom y) := by
        intro y
        have := congrArg (fun f => (C.obj.map f.op).hom y) hc
        simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
          at this
        exact this.symm
      let κ : XO X ⟶ XO Y := (Over.homMk cO hcg : Over.mk (gO Y) ⟶ Over.mk (gO X)).op
      have hτnat : ∀ y, (τ.hom.app (XO Y)).hom ((G.obj.map cO.op).hom y) =
          (C.obj.map cO.op).hom ((τ.hom.app (XO X)).hom y) := by
        intro y
        have := congrArg (fun f => f.hom y) (τ.hom.naturality κ)
        simp only [AddCommGrpCat.hom_comp] at this
        exact this
      apply (eC Y.unop.left).injective
      rw [hE, hfG, hτnat, ← hE, heC, heC, hfC]
    let eP : (G.over B₀).obj ⟶ (C.over B₀).obj :=
      { app := fun X => AddCommGrpCat.ofHom (E X)
        naturality := by
          intro X Y k
          ext x
          exact hnat X Y k x }
    refine ⟨(fullyFaithfulSheafToPresheaf _ _).preimage eP, ?_⟩
    intro V g' x
    change E (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀))) x = _
    have h1 : gO (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀))) ≫
        wcOpenRestrIncl Sc O B₀ =
        wcOpenRestrIncl Sc O V ≫ (g' ≫ wcOpenRestrIncl Sc O B₀) :=
      hgO (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀)))
    have hι : wcOpenRestrIncl Sc O V ≫ g' =
        gO (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀))) := by
      rw [← cancel_mono (wcOpenRestrIncl Sc O B₀), Category.assoc, h1]
    let lam : Opposite.op (Over.mk g') ⟶
        XO (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀))) :=
      (Over.homMk (wcOpenRestrIncl Sc O V) hι :
        Over.mk (gO (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀)))) ⟶ Over.mk g').op
    have hτ : (τ.hom.app (XO (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀))))).hom
          ((G.obj.map (wcOpenRestrIncl Sc O V).op).hom x) =
        (C.obj.map (wcOpenRestrIncl Sc O V).op).hom
          ((τ.hom.app (Opposite.op (Over.mk g'))).hom x) := by
      have := congrArg (fun f => f.hom x) (τ.hom.naturality lam)
      simp only [AddCommGrpCat.hom_comp] at this
      exact this
    apply (eC V).injective
    exact (hE (Opposite.op (Over.mk (g' ≫ wcOpenRestrIncl Sc O B₀))) x).trans hτ
  exact key (wcP1Over K).left O G (wcContSheaf (wcP1Over K).left (Fin a → ℚ_[ℓ]))
    (wc_P1_contSheaf_openRestr_bij K ℓ a m S hS O hO) B₀ τ

theorem wc_P1bar_strict_local_nbhd (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ (V₀ : (wcP1Over F'').left.ProEt) (g₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (φ₀ : V₀ ⟶ V₀) (A : Type u) (_ : CommRing A) (_ : HenselianLocalRing A)
      (_ : IsSepClosed (IsLocalRing.ResidueField A)) (e : V₀.left ≅ Spec (.of A))
      (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F''))),
      V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F'') ∧
      φ₀ ≫ g₀ = g₀ ≫ wcGeomFrob F'' (wcP1Over F'') hP ∧
      ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
        Limits.pullback.snd V₀.hom u0 ∧
      ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ φ₀.left =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
          ε.inv ≫ Limits.pullback.fst V₀.hom u0 :=
by
  classical

  haveI hprop : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hlft : LocallyOfFiniteType (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback _ _)
      inferInstance
  haveI hsep : IsSeparated (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @IsSeparated) (IsPullback.of_hasPullback _ _)
      inferInstance
  haveI hln : IsLocallyNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hlft inferInstance
  haveI hWEc : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hΦfst : (wcGeomFrob F'' (wcP1Over F'') hP).left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
      (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    MorphismProperty.Over.w (wcGeomFrob F'' (wcP1Over F'') hP)
  have hΦsnd : (wcGeomFrob F'' (wcP1Over F'') hP).left ≫ Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) := by
    first
      | exact Limits.pullback.lift_snd _ _ _
      | simp [wcGeomFrob, wcGeomPoint]
  have hSσJ : Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _ (Fintype.ofFinite F'')
      (AlgebraicClosure F'') _ _ _).symm.commutes x)

  have hsq0 : (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ u0) ≫
      (wcP1Over F'').hom =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    rw [Category.assoc, hu0, Category.comp_id, Category.id_comp]
  obtain ⟨ub, hub1, hub2⟩ : ∃ ub : Spec (.of (AlgebraicClosure F'')) ⟶
      (wcGeomPoint F'' (wcP1Over F'') hP).left,
      ub ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ u0 ∧
      ub ≫ Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = 𝟙 _ :=
    ⟨Limits.pullback.lift _ (𝟙 _) hsq0, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hsq : IsPullback ub (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      (wcGeomPoint F'' (wcP1Over F'') hP).hom u0 := by
    refine IsPullback.of_right ?_ hub1 (IsPullback.of_hasPullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))).flip
    rw [hub2, hu0]
    exact IsPullback.id_horiz _
  have hfr : ub ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ ub := by
    apply Limits.pullback.hom_ext
    · have e1 : (ub ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left) ≫
          (wcGeomPoint F'' (wcP1Over F'') hP).hom = ub ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
        (Category.assoc _ _ _).trans (congrArg (ub ≫ ·) hΦfst)
      have e2 : (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ ub) ≫
          (wcGeomPoint F'' (wcP1Over F'') hP).hom = ub ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
        (Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) hub1).trans
          ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ u0) hSσJ).trans hub1.symm)))
      exact e1.trans e2.symm
    · have e1 : (ub ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left) ≫ Limits.pullback.snd
          (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) :=
        (Category.assoc _ _ _).trans ((congrArg (ub ≫ ·) hΦsnd).trans
          ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ _) hub2).trans
            (Category.id_comp _))))
      have e2 : (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ ub) ≫ Limits.pullback.snd
          (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) :=
        (Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) hub2).trans (Category.comp_id _))
