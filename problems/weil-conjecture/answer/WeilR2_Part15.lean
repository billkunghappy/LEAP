theorem wc_proet_push_torsion_zero_above : ∀ (K : Type u) [Field K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (m d : ℕ), ((m : ℕ) : K) ≠ 0 → (∀ b : B, topologicalKrullDim ↥(Limits.pullback g (wcEtGeomPt B b)) ≤ (d : WithBot ℕ∞)) → ∀ q : ℕ, 2 * d < q → Limits.IsZero (((wcProEtPush g).rightDerived q).obj (wcContSheaf X (ZMod m))) :=
