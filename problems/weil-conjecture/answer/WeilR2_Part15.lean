        ((wcContSheaf S ℚ_[ℓ]).over V ⟶ G.over V) →+ Abelian.Ext (wcFreeSheaf S U) G 1,
        ∀ G μ, Fr G μ = (E G).symm ((E (wcContSheaf S ℚ_[ℓ]) κ).comp (Abelian.Ext.mk₀ μ)
          (add_zero 1)) :=
      ⟨fun G => AddMonoidHom.mk' (fun μ => (E G).symm ((E (wcContSheaf S ℚ_[ℓ]) κ).comp
          (Abelian.Ext.mk₀ μ) (add_zero 1))) (fun μ ν => by
            rw [Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, map_add]),
        fun G μ => rfl⟩
    refine ⟨Fr, ?_, ?_⟩
    · intro G G' σ μ
      apply (E G').injective
      rw [hN G G' σ (Fr G μ), hFr, hFr, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
      exact (hCs _ _ _).symm
    · intro G k φ x
      obtain ⟨v, hv'⟩ := s3 S (wcFreeSheaf S U) k κ hκ
        ((E (wcContSheaf S (Fin k → ℚ_[ℓ]))).symm ((E G x).comp (Abelian.Ext.mk₀ φ.hom)
          (add_zero 1)))
      refine ⟨v, ?_⟩
      apply (E G).injective
      rw [hFr, AddEquiv.apply_symm_apply]
      have hy : (E (wcContSheaf S ℚ_[ℓ]) κ).comp (Abelian.Ext.mk₀ (Gr.map (wcContSheafMap S
            (LinearMap.toSpanSingleton ℚ_[ℓ] (Fin k → ℚ_[ℓ]) v).toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional _)))) (add_zero 1) =
          (E G x).comp (Abelian.Ext.mk₀ φ.hom) (add_zero 1) := by
        rw [← hN _ _ _ κ, ← hv', AddEquiv.apply_symm_apply]
      have hy' := congrArg (fun w => w.comp (Abelian.Ext.mk₀ φ.inv) (add_zero 1)) hy
      refine ((hCs _ _ _).symm.trans hy').trans ?_
      show ((E G x).comp (Abelian.Ext.mk₀ φ.hom) (add_zero 1)).comp (Abelian.Ext.mk₀ φ.inv)
        (add_zero 1) = E G x
      rw [hCs, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]

  obtain ⟨κ, hκ⟩ := wc_strict_trait_punct_H1_cyclic F'' u0 hu0 ℓ hℓ V₀ A e ε hv hε
  obtain ⟨Fr, h1, h2⟩ := main (wcP1Over F'').left V₀ _
    (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' u0) V₀) κ hκ
  exact ⟨Fr, h1, h2⟩

theorem wc_qtl_transition_matrix_field (S : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (k ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W) :
    ∃ τ : ↥(Limits.pullback W.hom W.hom) → ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])),
      (∀ v : Fin k → ℚ_[ℓ], Continuous (fun p => τ p v)) ∧
      ∀ (V : S.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z =
        τ ((Limits.pullback.lift a.left b.left
            ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm)) z)
          ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) :=
by
  classical
  haveI hWet : WeaklyEtale W.hom := W.prop
  haveI : WeaklyEtale (Limits.pullback.fst W.hom W.hom ≫ W.hom) := inferInstance
  let Zo : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst W.hom W.hom ≫ W.hom)
  let π₁ : Zo ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.fst W.hom W.hom) rfl trivial
  let π₂ : Zo ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd W.hom W.hom)
    Limits.pullback.condition.symm trivial
  let T : (wcContSheaf S (Fin k → ℚ_[ℓ])).over Zo ⟶ (wcContSheaf S (Fin k → ℚ_[ℓ])).over Zo :=
    (((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} π₁).mapIso θ).inv ≫
      (((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} π₂).mapIso θ).hom
  obtain ⟨Gp, hGp⟩ := wc_contSheaf_over_hom_padic_pointwise S ℓ k k Zo T

  have hlin : ∀ p : Zo.left, ∃ A : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]),
      ∀ v, Gp p v = A v := by
    intro p
    haveI := wc_fromSpecStalk_weaklyEtale Zo.left p
    haveI : WeaklyEtale Zo.hom := Zo.prop
    let U : S.ProEt := Scheme.ProEt.mk (Zo.left.fromSpecStalk p ≫ Zo.hom)
    let ι : U ⟶ Zo := MorphismProperty.Over.homMk (Zo.left.fromSpecStalk p) rfl trivial
    have hU : ConnectedSpace U.left := by
      show ConnectedSpace (Spec (Zo.left.presheaf.stalk p))
      rw [connectedSpace_iff_clopen]
      refine ⟨⟨IsLocalRing.closedPoint _⟩, fun s hs => ?_⟩
      by_cases h : IsLocalRing.closedPoint (Zo.left.presheaf.stalk p) ∈ s
      · right
        ext y
        simp only [Set.mem_univ, iff_true]
        exact (IsLocalRing.specializes_closedPoint y).mem_open hs.isOpen h
      · left
        ext y
        simp only [Set.mem_empty_iff_false, iff_false]
        intro hy
        exact (IsLocalRing.specializes_closedPoint y).mem_open hs.isClosed.isOpen_compl h hy
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ U hU k k
      (((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} ι).map T)
    refine ⟨A, fun v => ?_⟩
    have h1 := congrArg (fun ψ : (wcContSheaf S (Fin k → ℚ_[ℓ])).over U ⟶
        (wcContSheaf S (Fin k → ℚ_[ℓ])).over U =>
      (show C(↥U.left, Fin k → ℚ_[ℓ]) from ((ψ.hom.app (Opposite.op (Over.mk (𝟙 U)))).hom
        (ULift.up (ContinuousMap.const _ v))).down)
        (IsLocalRing.closedPoint (Zo.left.presheaf.stalk p))) hA
    have h2 := hGp (Over.mk (𝟙 U ≫ ι)) (ULift.up (ContinuousMap.const _ v))
      (IsLocalRing.closedPoint (Zo.left.presheaf.stalk p))
    have h3 : (Over.mk (𝟙 U ≫ ι)).hom.left
        (IsLocalRing.closedPoint (Zo.left.presheaf.stalk p)) = p := by
      show (Zo.left.fromSpecStalk p) (IsLocalRing.closedPoint (Zo.left.presheaf.stalk p)) = p
      exact Scheme.fromSpecStalk_closedPoint
    have key : Gp ((Over.mk (𝟙 U ≫ ι)).hom.left
        (IsLocalRing.closedPoint (Zo.left.presheaf.stalk p))) v = A v := by
      refine h2.symm.trans ?_
      exact h1
    rw [h3] at key
    exact key
  choose τ hτ using hlin

  have s3 : ∀ (V : S.ProEt) (c : V ⟶ Zo) (a b : V ⟶ W), c ≫ π₁ = a → c ≫ π₂ = b →
      ∀ x : G.obj.obj (Opposite.op V),
      (θ.hom.hom.app (Opposite.op (Over.mk b))).hom x =
        (T.hom.app (Opposite.op (Over.mk c))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x) := by
    intro V c a b ha hb x
    subst ha hb
    have e : (θ.inv.hom.app (Opposite.op (Over.mk (c ≫ π₁)))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk (c ≫ π₁)))).hom x) = x := by
      have := congrArg (fun f => (f.hom.app (Opposite.op (Over.mk (c ≫ π₁)))).hom x) θ.hom_inv_id
      exact this
    show _ = (θ.hom.hom.app (Opposite.op (Over.mk (c ≫ π₂)))).hom
      ((θ.inv.hom.app (Opposite.op (Over.mk (c ≫ π₁)))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk (c ≫ π₁)))).hom x))
    rw [e]
  refine ⟨τ, fun v => ?_, fun V a b x z => ?_⟩
  · refine (ContinuousMap.continuous
      (show C(↥Zo.left, Fin k → ℚ_[ℓ]) from ((T.hom.app (Opposite.op (Over.mk (𝟙 Zo)))).hom
        (ULift.up (ContinuousMap.const _ v))).down)).congr ?_
    intro t
    exact (hGp (Over.mk (𝟙 Zo)) (ULift.up (ContinuousMap.const _ v)) t).trans (hτ _ _)
  · have hc : Limits.pullback.lift a.left b.left
        ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) ≫
        (Limits.pullback.fst W.hom W.hom ≫ W.hom) = V.hom := by
      rw [Limits.pullback.lift_fst_assoc]
      exact MorphismProperty.Over.w a
    let c : V ⟶ Zo := MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left
        ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm)) hc trivial
    have ha : c ≫ π₁ = a := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_fst _ _ _
    have hb : c ≫ π₂ = b := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_snd _ _ _
    have h2 := congrArg (fun s => (show C(↥V.left, Fin k → ℚ_[ℓ]) from s.down) z)
      (s3 V c a b ha hb x)
    refine h2.trans ?_
    exact (hGp (Over.mk c) _ z).trans (hτ _ _)

theorem wc_qtl_transition_cocycle (S : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (k ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (τ : ↥(Limits.pullback W.hom W.hom) → ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])))
    (hτ : ∀ (V : S.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z =
      τ ((Limits.pullback.lift a.left b.left
          ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm)) z)
        ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z)) :
    ∀ p q : ↥(Limits.pullback W.hom W.hom),
      (Limits.pullback.snd W.hom W.hom) p = (Limits.pullback.fst W.hom W.hom) q →
      ∃ r : ↥(Limits.pullback W.hom W.hom), τ r = τ q ∘ₗ τ p :=
by
  intro p q hpq
  obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := Limits.pullback.snd W.hom W.hom) (g := Limits.pullback.fst W.hom W.hom) p q hpq
  have hW : Limits.pullback.fst W.hom W.hom ≫ W.hom = Limits.pullback.snd W.hom W.hom ≫ W.hom :=
    Limits.pullback.condition
  have hY : Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom)
      ≫ Limits.pullback.snd W.hom W.hom =
      Limits.pullback.snd (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom)
      ≫ Limits.pullback.fst W.hom W.hom :=
    Limits.pullback.condition
  let V : S.ProEt := Scheme.ProEt.mk
    (Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
      Limits.pullback.fst W.hom W.hom ≫ W.hom)
  let a : V ⟶ W := MorphismProperty.Over.homMk
    (Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
      Limits.pullback.fst W.hom W.hom) (Category.assoc _ _ _) trivial
  let b : V ⟶ W := MorphismProperty.Over.homMk
    (Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
      Limits.pullback.snd W.hom W.hom)
    (by
      show (Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
        Limits.pullback.snd W.hom W.hom) ≫ W.hom =
        Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
        Limits.pullback.fst W.hom W.hom ≫ W.hom
      rw [Category.assoc, hW]) trivial
  let c : V ⟶ W := MorphismProperty.Over.homMk
    (Limits.pullback.snd (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
      Limits.pullback.snd W.hom W.hom)
    (by
      show (Limits.pullback.snd (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
        Limits.pullback.snd W.hom W.hom) ≫ W.hom =
        Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) ≫
        Limits.pullback.fst W.hom W.hom ≫ W.hom
      rw [Category.assoc, ← hW, ← Category.assoc, ← hY, Category.assoc, hW]) trivial
  have L1 : Limits.pullback.lift a.left b.left
      ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm) =
      Limits.pullback.fst (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) := by
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]; rfl
    · rw [Limits.pullback.lift_snd]; rfl
  have L2 : Limits.pullback.lift b.left c.left
      ((MorphismProperty.Over.w b).trans (MorphismProperty.Over.w c).symm) =
      Limits.pullback.snd (Limits.pullback.snd W.hom W.hom) (Limits.pullback.fst W.hom W.hom) := by
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]; exact hY
    · rw [Limits.pullback.lift_snd]; rfl
  have hp : (Limits.pullback.lift a.left b.left
      ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm)) z = p := by
    rw [L1]; exact hz1
  have hq : (Limits.pullback.lift b.left c.left
      ((MorphismProperty.Over.w b).trans (MorphismProperty.Over.w c).symm)) z = q := by
    rw [L2]; exact hz2
  refine ⟨(Limits.pullback.lift a.left c.left
      ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w c).symm)) z, ?_⟩
  apply LinearMap.ext
  intro v
  let y₀ : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk a)) :=
    (ULift.up (ContinuousMap.const (↥V.left) v) : ULift.{u+1} C(↥V.left, Fin k → ℚ_[ℓ]))
  let x : G.obj.obj (Opposite.op V) := (θ.inv.hom.app (Opposite.op (Over.mk a))).hom y₀
  have E0 : (θ.hom.hom.app (Opposite.op (Over.mk a))).hom x = y₀ :=
    Iso.inv_hom_id_app_apply ((sheafToPresheaf _ AddCommGrpCat).mapIso θ) (Opposite.op (Over.mk a)) y₀
  have hE0 : (show C(↥V.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z = v := by
    rw [E0]; rfl
  have E1 := hτ V a b x z
  have E2 := hτ V b c x z
  have E3 := hτ V a c x z
  rw [hp, hE0] at E1
  rw [hq, E1] at E2
  rw [hE0] at E3
  rw [LinearMap.comp_apply]
  exact E3.symm.trans E2

theorem wc_qtl_generic_pair_generization {X Y : Scheme.{u}} (g : X ⟶ Y) [WeaklyEtale g]
    [IrreducibleSpace ↥X] (p : ↥(Limits.pullback g g)) :
    ∃ p' : ↥(Limits.pullback g g), p' ⤳ p ∧ (Limits.pullback.fst g g) p' = genericPoint ↥X ∧
      (Limits.pullback.snd g g) p' = genericPoint ↥X :=
by
  haveI : Flat g := WeaklyEtale.flat
  haveI : Flat (Limits.pullback.fst g g) := inferInstance
  haveI : Flat (Limits.pullback.snd g g) := inferInstance
  obtain ⟨p₁, h1, e1⟩ := Flat.generalizingMap (Limits.pullback.fst g g)
    (genericPoint_specializes ((Limits.pullback.fst g g) p))
  obtain ⟨p', h2, e2⟩ := Flat.generalizingMap (Limits.pullback.snd g g)
    (genericPoint_specializes ((Limits.pullback.snd g g) p₁))
  have h3 : (Limits.pullback.fst g g) p' ⤳ genericPoint ↥X := by
    have := h2.map (Limits.pullback.fst g g).continuous
    rw [e1] at this
    exact this
  exact ⟨p', h2.trans h1, (h3.antisymm (genericPoint_specializes _)).eq, e2⟩

theorem wc_qtl_bounded_monoid_lattice (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ)
    (H : Set ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])))
    (hbd : ∃ C : ℝ, ∀ h ∈ H, ∀ j : Fin k, ‖h (Pi.single j 1)‖ ≤ C)
    (hmul : ∀ h₁ ∈ H, ∀ h₂ ∈ H, h₂ ∘ₗ h₁ ∈ H) :
    ∃ P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]), ∀ h ∈ H, ∀ u : Fin k → ℚ_[ℓ],
      (∀ i, ‖P u i‖ ≤ 1) → ∀ i, ‖P (h u) i‖ ≤ 1 :=
by
  classical
  obtain ⟨C, hC⟩ := hbd
  obtain ⟨D, hD1, hCD⟩ : ∃ D : ℝ, 1 ≤ D ∧ C ≤ D := ⟨max C 1, le_max_right _ _, le_max_left _ _⟩
  have hsmul : ∀ (a : ℤ_[ℓ]) (x : Fin k → ℚ_[ℓ]), a • x = (a : ℚ_[ℓ]) • x := by
    intro a x
    rw [← algebraMap_smul ℚ_[ℓ] a x]
    rfl

  have hcol : ∀ h ∈ H, ∀ u : Fin k → ℚ_[ℓ], (∀ i, ‖u i‖ ≤ 1) → ∀ i, ‖h u i‖ ≤ D := by
    intro h hh u hu i
    have hu' : u = ∑ j, u j • (Pi.single j (1 : ℚ_[ℓ]) : Fin k → ℚ_[ℓ]) := by
      ext m
      simp [Finset.sum_apply, Pi.single_apply]
    rw [hu', map_sum, Finset.sum_apply]
    apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (le_trans zero_le_one hD1)
    intro j _
    rw [map_smul, Pi.smul_apply, smul_eq_mul, norm_mul]
    calc ‖u j‖ * ‖h (Pi.single j 1) i‖ ≤ 1 * ‖h (Pi.single j 1)‖ :=
          mul_le_mul (hu j) (norm_le_pi_norm _ i) (norm_nonneg _) zero_le_one
      _ ≤ D := by rw [one_mul]; exact (hC h hh j).trans hCD

  let S : Set (Fin k → ℚ_[ℓ]) :=
    {x | ∃ u : Fin k → ℚ_[ℓ], (∀ i, ‖u i‖ ≤ 1) ∧ (x = u ∨ ∃ h ∈ H, x = h u)}
  let L : Submodule ℤ_[ℓ] (Fin k → ℚ_[ℓ]) := Submodule.span ℤ_[ℓ] S
  have hlo : ∀ u : Fin k → ℚ_[ℓ], (∀ i, ‖u i‖ ≤ 1) → u ∈ L :=
    fun u hu => Submodule.subset_span ⟨u, hu, Or.inl rfl⟩
  have hhi : ∀ x ∈ L, ∀ i, ‖x i‖ ≤ D := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨u, hu, rfl | ⟨h, hh, rfl⟩⟩ := hx
      · exact fun i => (hu i).trans hD1
      · exact hcol h hh u hu
    | zero => intro i; simp; linarith
    | add x y _ _ hx hy =>
      intro i
      rw [Pi.add_apply]
      exact (Padic.nonarchimedean _ _).trans (max_le (hx i) (hy i))
    | smul a x _ hx =>
      intro i
      rw [hsmul, Pi.smul_apply, smul_eq_mul, norm_mul]
      calc ‖(a : ℚ_[ℓ])‖ * ‖x i‖ ≤ 1 * ‖x i‖ :=
            mul_le_mul_of_nonneg_right a.2 (norm_nonneg _)
        _ ≤ D := by rw [one_mul]; exact hx i
  have hinv : ∀ h ∈ H, ∀ x ∈ L, h x ∈ L := by
    intro h hh x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨u, hu, hxu | ⟨h', hh', hxu⟩⟩ := hx
      · rw [hxu]; exact Submodule.subset_span ⟨u, hu, Or.inr ⟨h, hh, rfl⟩⟩
      · rw [hxu]
        exact Submodule.subset_span ⟨u, hu, Or.inr ⟨h ∘ₗ h', hmul h' hh' h hh, rfl⟩⟩
    | zero => rw [map_zero]; exact L.zero_mem
    | add x y _ _ hx hy => rw [map_add]; exact L.add_mem hx hy
    | smul a x _ hx => rw [hsmul, map_smul, ← hsmul]; exact L.smul_mem a hx

  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt D hℓ1
  obtain ⟨t, ht0, htn⟩ : ∃ t : ℚ_[ℓ], t ≠ 0 ∧ ‖t‖ = ((ℓ : ℝ) ^ m)⁻¹ :=
    ⟨(ℓ : ℚ_[ℓ]) ^ m, pow_ne_zero _ (by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero),
      by rw [norm_pow, Padic.norm_p, inv_pow]⟩
  let w : Fin k → (Fin k → ℚ_[ℓ]) := fun j => t⁻¹ • Pi.single j 1
  have hwQ : LinearIndependent ℚ_[ℓ] w := by
    rw [Fintype.linearIndependent_iff]
    intro g hg j
    have h1 := congrFun hg j
    simp [w, Finset.sum_apply, Pi.single_apply] at h1
    rcases h1 with h1 | h1
    · exact h1
    · exact absurd h1 ht0
  have hw : LinearIndependent ℤ_[ℓ] w := (LinearIndependent.iff_fractionRing ℤ_[ℓ] ℚ_[ℓ]).mpr hwQ
  have hLw : L ≤ Submodule.span ℤ_[ℓ] (Set.range w) := by
    intro x hx
    rw [Submodule.mem_span_range_iff_exists_fun]
    have hc : ∀ j, ‖t * x j‖ ≤ 1 := by
      intro j
      rw [norm_mul, htn]
      have h1 := hhi x hx j
      have h2 : (0 : ℝ) < (ℓ : ℝ) ^ m := by positivity
      rw [inv_mul_le_iff₀ h2]
      linarith
    let c : Fin k → ℤ_[ℓ] := fun j => ⟨t * x j, hc j⟩
    refine ⟨c, ?_⟩
    have hterm : ∀ j, c j • w j = (Pi.single j (x j) : Fin k → ℚ_[ℓ]) := by
      intro j
      rw [hsmul]
      ext i
      rw [Pi.smul_apply, smul_eq_mul]
      show (t * x j) * ((t⁻¹ • (Pi.single j (1 : ℚ_[ℓ]) : Fin k → ℚ_[ℓ])) i) =
        (Pi.single j (x j) : Fin k → ℚ_[ℓ]) i
      rw [Pi.smul_apply, smul_eq_mul]
      by_cases hij : i = j
      · subst hij
        rw [Pi.single_eq_same, Pi.single_eq_same, mul_one, mul_comm t (x i), mul_assoc,
          mul_inv_cancel₀ ht0, mul_one]
      · rw [Pi.single_eq_of_ne hij, Pi.single_eq_of_ne hij, mul_zero, mul_zero]
    simp only [hterm]
    exact Finset.univ_sum_single x

  obtain ⟨n, b⟩ := Submodule.basisOfPidOfLESpan hw hLw
  let v : Fin n → (Fin k → ℚ_[ℓ]) := fun i => (b i : Fin k → ℚ_[ℓ])
  have hv : LinearIndependent ℤ_[ℓ] v := b.linearIndependent.map' L.subtype (Submodule.ker_subtype L)
  have hspan : Submodule.span ℤ_[ℓ] (Set.range v) = L := by
    have : Set.range v = L.subtype '' Set.range b := by rw [← Set.range_comp]; rfl
    rw [this, Submodule.span_image, b.span_eq, Submodule.map_subtype_top]

  have hliQ : LinearIndependent ℚ_[ℓ] v := (LinearIndependent.iff_fractionRing ℤ_[ℓ] ℚ_[ℓ]).mp hv
  have hspQ : ⊤ ≤ Submodule.span ℚ_[ℓ] (Set.range v) := by
    rw [← (Pi.basisFun ℚ_[ℓ] (Fin k)).span_eq, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    have h1 : (Pi.basisFun ℚ_[ℓ] (Fin k)) j ∈ Submodule.span ℤ_[ℓ] (Set.range v) := by
      rw [hspan]
      apply hlo
      intro i
      rw [Pi.basisFun_apply, Pi.single_apply]
      split_ifs <;> simp
    exact Submodule.span_le_restrictScalars ℤ_[ℓ] ℚ_[ℓ] _ h1
  let bQ := Module.Basis.mk hliQ hspQ
  let e := bQ.indexEquiv (Pi.basisFun ℚ_[ℓ] (Fin k))
  let b' := bQ.reindex e
  let P := b'.equivFun
  have hrange : Set.range b' = Set.range v := by
    rw [Module.Basis.range_reindex, Module.Basis.coe_mk]
  have hL' : ∀ u, u ∈ L ↔ ∃ c : Fin k → ℤ_[ℓ], ∑ i, c i • b' i = u := by
    intro u
    rw [← hspan, ← hrange, Submodule.mem_span_range_iff_exists_fun]
  have hchar : ∀ u, u ∈ L ↔ ∀ i, ‖P u i‖ ≤ 1 := by
    intro u
    rw [hL']
    constructor
    · rintro ⟨c, rfl⟩ i
      have h1 : ∑ j, c j • b' j = ∑ j, (c j : ℚ_[ℓ]) • b' j := by
        simp only [hsmul]
      rw [h1]
      show ‖b'.equivFun (∑ j, (c j : ℚ_[ℓ]) • b' j) i‖ ≤ 1
      rw [Module.Basis.equivFun_apply, Module.Basis.repr_sum_self]
      exact (c i).2
    · intro hu
      refine ⟨fun i => ⟨P u i, hu i⟩, ?_⟩
      simp only [hsmul]
      exact b'.sum_equivFun u
  refine ⟨P, fun h hh u hu => ?_⟩
  exact (hchar (h u)).mp (hinv h hh u ((hchar u).mpr hu))

theorem wcqi_top_generic_set_preconnected : ∀ {X : Type*} [TopologicalSpace X] [PreconnectedSpace X] (E : Set X), (∀ x : X, ∃ e ∈ E, e ⤳ x) → (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ IsCompact (E ∩ U) ∧ (∀ e₁ ∈ E ∩ U, ∀ e₂ ∈ E ∩ U, e₁ ⤳ e₂ → e₁ = e₂) ∧ ∀ e ∈ E ∩ U, ∀ V : Set X, IsOpen V → e ∈ V → ∃ D : Set X, IsOpen D ∧ IsOpen (U \ D) ∧ D ⊆ U ∧ e ∈ D ∧ D ∩ E ⊆ V) → IsPreconnected E :=
by
  intro X _ _ E hG hL
  have s1 : ∀ (x : X) (U D : Set X) (e : X), x ∈ U → IsOpen (U \ D) → e ∈ D → e ⤳ x → x ∈ D := by
    intro x U D e hxU hUD heD hex
    by_contra hxD
    have h1 : e ∈ U \ D := hex.mem_open hUD ⟨hxU, hxD⟩
    exact h1.2 heD
  have s2 : ∀ W : Set X, IsOpen W → IsOpen {x : X | ∃ e ∈ E, e ∈ W ∧ e ⤳ x} := by
    intro W hW
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨e, heE, heW, hex⟩
    obtain ⟨U, hUo, hxU, -, -, hD⟩ := hL x
    have heU : e ∈ U := hex.mem_open hUo hxU
    obtain ⟨D, hDo, hUD, -, heD, hDE⟩ := hD e ⟨heE, heU⟩ W hW heW
    refine ⟨D, ?_, hDo, s1 x U D e hxU hUD heD hex⟩
    intro y hy
    obtain ⟨e', he'E, he'y⟩ := hG y
    have he'D : e' ∈ D := he'y.mem_open hDo hy
    exact ⟨e', he'E, hDE ⟨he'D, he'E⟩, he'y⟩
  intro u v hu hv hEuv ⟨a, haE, hau⟩ ⟨b, hbE, hbv⟩
  have hcov : (Set.univ : Set X) ⊆ {x : X | ∃ e ∈ E, e ∈ u ∧ e ⤳ x} ∪
      {x : X | ∃ e ∈ E, e ∈ v ∧ e ⤳ x} := by
    intro x _
    obtain ⟨e, heE, hex⟩ := hG x
    rcases hEuv heE with h | h
    · exact Or.inl ⟨e, heE, h, hex⟩
    · exact Or.inr ⟨e, heE, h, hex⟩
  obtain ⟨x, -, ⟨e₁, he₁E, he₁u, he₁x⟩, ⟨e₂, he₂E, he₂v, he₂x⟩⟩ :=
    isPreconnected_univ _ _ (s2 u hu) (s2 v hv) hcov
      ⟨a, Set.mem_univ _, a, haE, hau, specializes_rfl⟩
      ⟨b, Set.mem_univ _, b, hbE, hbv, specializes_rfl⟩
  obtain ⟨U, hUo, hxU, -, -, hD⟩ := hL x
  have he₁U : e₁ ∈ U := he₁x.mem_open hUo hxU
  obtain ⟨D, hDo, hUD, -, he₁D, hDE⟩ := hD e₁ ⟨he₁E, he₁U⟩ u hu he₁u
  have hxD : x ∈ D := s1 x U D e₁ hxU hUD he₁D he₁x
  have he₂D : e₂ ∈ D := he₂x.mem_open hDo hxD
  exact ⟨e₂, he₂E, hDE ⟨he₂D, he₂E⟩, he₂v⟩

theorem wcqi_top_irreducible_of_generic_set : ∀ {X : Type*} [TopologicalSpace X] [CompactSpace X] (E : Set X), E.Nonempty → IsPreconnected E → (∀ x : X, ∃ e ∈ E, e ⤳ x) → (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ IsCompact (E ∩ U) ∧ (∀ e₁ ∈ E ∩ U, ∀ e₂ ∈ E ∩ U, e₁ ⤳ e₂ → e₁ = e₂) ∧ ∀ e ∈ E ∩ U, ∀ V : Set X, IsOpen V → e ∈ V → ∃ D : Set X, IsOpen D ∧ IsOpen (U \ D) ∧ D ⊆ U ∧ e ∈ D ∧ D ∩ E ⊆ V) → IrreducibleSpace X :=
by
  intro X _ _ E hne hpc hgen hchart
  classical

  have s1 : ∀ (U K : Set X), (∀ e₁ ∈ E ∩ U, ∀ e₂ ∈ E ∩ U, e₁ ⤳ e₂ → e₁ = e₂) →
      (∀ e ∈ E ∩ U, ∀ V : Set X, IsOpen V → e ∈ V → ∃ D : Set X, IsOpen D ∧ IsOpen (U \ D) ∧
        D ⊆ U ∧ e ∈ D ∧ D ∩ E ⊆ V) →
      IsCompact K → K ⊆ E ∩ U → ∀ e ∈ E ∩ U, e ∉ K →
      ∃ G : Set X, IsOpen G ∧ e ∈ G ∧ G ∩ K = ∅ := by
    intro U K hinc hsep hK hKsub e he heK
    have hD : ∀ k : K, ∃ D : Set X, IsOpen D ∧ IsOpen (U \ D) ∧ D ⊆ U ∧ (k : X) ∈ D ∧ e ∉ D := by
      intro ⟨k, hk⟩
      have hns : ¬ e ⤳ k := fun h => heK (by rw [hinc e he k (hKsub hk) h]; exact hk)
      rw [specializes_iff_forall_open] at hns
      push_neg at hns
      obtain ⟨V, hV, hkV, heV⟩ := hns
      obtain ⟨D, hD1, hD2, hD3, hD4, hD5⟩ := hsep k (hKsub hk) V hV hkV
      exact ⟨D, hD1, hD2, hD3, hD4, fun h => heV (hD5 ⟨h, he.1⟩)⟩
    choose D hDo hDUo hDU hkD heD using hD
    obtain ⟨s, hs⟩ := hK.elim_finite_subcover D hDo
      (fun k hk => Set.mem_iUnion.mpr ⟨⟨k, hk⟩, hkD _⟩)
    refine ⟨⋂ k ∈ s, (U \ D k), isOpen_biInter_finset (fun k _ => hDUo k), ?_, ?_⟩
    · simp only [Set.mem_iInter]
      intro k _
      exact ⟨he.2, heD k⟩
    · ext z
      simp only [Set.mem_inter_iff, Set.mem_iInter, Set.mem_empty_iff_false, iff_false, not_and]
      intro hz hzK
      obtain ⟨k, hk, hzk⟩ := Set.mem_iUnion₂.mp (hs hzK)
      exact (hz k hk).2 hzk

  choose U hUo hxU hUP using hchart
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover U (fun x => (hUo x).mem_nhds (hxU x))
  have hcov : ∀ x, ∃ y ∈ t, x ∈ U y := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, U y := by rw [ht]; trivial
    simpa using hx
  let I : X → Finset X := fun z => t.filter (fun y => z ∈ U y)
  have hSfin : (I '' E).Finite := by
    apply (t.powerset.finite_toSet).subset
    rintro _ ⟨z, _, rfl⟩
    exact Finset.mem_coe.mpr (Finset.mem_powerset.mpr (Finset.filter_subset _ _))
  obtain ⟨s0, ⟨e₀, he₀, rfl⟩, hmax⟩ := Set.exists_max_image (I '' E) Finset.card hSfin (hne.image I)
  have hmax' : ∀ e ∈ E, (I e).card ≤ (I e₀).card := fun e he => hmax _ ⟨e, he, rfl⟩
  set O : Set X := ⋂ y ∈ I e₀, U y with hOdef
  have hOo : IsOpen O := isOpen_biInter_finset (fun y _ => hUo y)
  have he₀O : e₀ ∈ O := by
    simp only [O, Set.mem_iInter]
    intro y hy
    exact (Finset.mem_filter.mp hy).2
  have factA : ∀ e ∈ E, e ∈ O → I e = I e₀ := by
    intro e he heO
    symm
    apply Finset.eq_of_subset_of_card_le
    · intro y hy
      simp only [O, Set.mem_iInter] at heO
      exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hy).1, heO y hy⟩
    · exact hmax' e he
  have hdich : ∀ x, ∃ y, x ∈ U y ∧ (O ⊆ U y ∨ E ∩ O ∩ U y = ∅) := by
    intro x
    obtain ⟨y, hyt, hxy⟩ := hcov x
    refine ⟨y, hxy, ?_⟩
    by_cases hy : y ∈ I e₀
    · left
      exact Set.iInter₂_subset y hy
    · right
      ext z
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
      rintro ⟨hzE, hzO⟩ hzU
      apply hy
      rw [← factA z hzE hzO]
      exact Finset.mem_filter.mpr ⟨hyt, hzU⟩

  obtain ⟨y0, he₀U0, hd0⟩ := hdich e₀
  have hOU0 : O ⊆ U y0 := by
    rcases hd0 with h | h
    · exact h
    · exfalso
      have hmem : e₀ ∈ E ∩ O ∩ U y0 := ⟨⟨he₀, he₀O⟩, he₀U0⟩
      rw [h] at hmem
      exact hmem
  obtain ⟨hcpt0, hinc0, hsep0⟩ := hUP y0
  obtain ⟨D, hDo, hUDo, hDU, he₀D, hDE⟩ := hsep0 e₀ ⟨he₀, he₀U0⟩ O hOo he₀O

  have hKeq : D ∩ E = (E ∩ U y0) ∩ (U y0 \ D)ᶜ := by
    ext z
    simp only [Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_diff, not_and, not_not]
    constructor
    · rintro ⟨hzD, hzE⟩
      exact ⟨⟨hzE, hDU hzD⟩, fun _ => hzD⟩
    · rintro ⟨⟨hzE, hzU⟩, h⟩
      exact ⟨h hzU, hzE⟩
  have hKc : IsCompact (D ∩ E) := by
    rw [hKeq]
    exact hcpt0.inter_right hUDo.isClosed_compl
  have hKO : D ∩ E ⊆ O := hDE

  have hsepK : ∀ e ∈ E, e ∉ D → ∃ G : Set X, IsOpen G ∧ e ∈ G ∧ G ∩ (D ∩ E) = ∅ := by
    intro e he heD
    obtain ⟨y, hey, hd⟩ := hdich e
    rcases hd with h | h
    · obtain ⟨_, hinc, hsep⟩ := hUP y
      exact s1 (U y) (D ∩ E) hinc hsep hKc (fun z hz => ⟨hz.2, h (hKO hz)⟩) e ⟨he, hey⟩
        (fun hk => heD hk.1)
    · refine ⟨U y, hUo y, hey, ?_⟩
      ext z
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
      intro hzU hzD hzE
      have hmem : z ∈ E ∩ O ∩ U y := ⟨⟨hzE, hKO ⟨hzD, hzE⟩⟩, hzU⟩
      rw [h] at hmem
      exact hmem

  have hED : E ⊆ D := by
    by_contra hsub
    obtain ⟨e₁, he₁E, he₁D⟩ := Set.not_subset.mp hsub
    choose! G hGo heG hGK using hsepK
    have hG'o : IsOpen (⋃ e ∈ E \ D, G e) := isOpen_biUnion (fun e he => hGo e he.1 he.2)
    obtain ⟨z, hzE, hzD, hzG⟩ := hpc D (⋃ e ∈ E \ D, G e) hDo hG'o
      (fun e he => by
        by_cases h : e ∈ D
        · exact Or.inl h
        · exact Or.inr (Set.mem_biUnion ⟨he, h⟩ (heG e he h)))
      ⟨e₀, he₀, he₀D⟩ ⟨e₁, he₁E, Set.mem_biUnion ⟨he₁E, he₁D⟩ (heG e₁ he₁E he₁D)⟩
    obtain ⟨e, he, hzGe⟩ := Set.mem_iUnion₂.mp hzG
    have hmem : z ∈ G e ∩ (D ∩ E) := ⟨hzGe, hzD, hzE⟩
    rw [hGK e he.1 he.2] at hmem
    exact hmem

  have hsing : ∀ e ∈ E, e = e₀ := by
    intro e he
    by_contra hne'
    have hnspec : ¬ e ⤳ e₀ := fun h => hne' (hinc0 e ⟨he, hDU (hED he)⟩ e₀ ⟨he₀, he₀U0⟩ h)
    rw [specializes_iff_forall_open] at hnspec
    push_neg at hnspec
    obtain ⟨V, hV, he₀V, heV⟩ := hnspec
    obtain ⟨D', hD'o, hUD'o, hD'U, he₀D', hD'E⟩ := hsep0 e₀ ⟨he₀, he₀U0⟩ V hV he₀V
    have heD' : e ∉ D' := fun h => heV (hD'E ⟨h, he⟩)
    obtain ⟨z, _, hzD', hzU⟩ := hpc D' (U y0 \ D') hD'o hUD'o
      (fun x hx => by
        by_cases h : x ∈ D'
        · exact Or.inl h
        · exact Or.inr ⟨hDU (hED hx), h⟩)
      ⟨e₀, he₀, he₀D'⟩ ⟨e, he, hDU (hED he), heD'⟩
    exact hzU.2 hzD'

  have hcl : closure ({e₀} : Set X) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro x
    obtain ⟨e, he, hex⟩ := hgen x
    rw [hsing e he] at hex
    exact specializes_iff_mem_closure.mp hex
  have hirr := (isIrreducible_singleton (x := e₀)).closure
  rw [hcl] at hirr
  rw [irreducibleSpace_def]
  exact hirr

theorem wcqi_weaklyEtale_comap_bot_incomparable : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B], Algebra.WeaklyEtale A B → ∀ (q₁ q₂ : Ideal B), q₁.IsPrime → q₂.IsPrime → q₁ ≤ q₂ → q₁.comap (algebraMap A B) = ⊥ → q₂.comap (algebraMap A B) = ⊥ → q₁ = q₂ :=
by
  intro A B _ _ _ _ hW q₁ q₂ hq₁ hq₂ hle h₁ h₂
  haveI := hq₁
  by_contra hne
  obtain ⟨b, hb₂, hb₁⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hle hne)
  set mk := Ideal.Quotient.mk q₁ with hmk
  have hb0 : mk b ≠ 0 := by
    rw [hmk, Ne, Ideal.Quotient.eq_zero_iff_mem]; exact hb₁
  have hbI : mk b ∈ Ideal.map mk q₂ := Ideal.mem_map_of_mem mk hb₂
  set g := algebraMap (B ⧸ q₁) (FractionRing (B ⧸ q₁)) with hg
  obtain ⟨f, hf1, hf2⟩ := wc_weaklyEtale_point_algebraic A B (FractionRing (B ⧸ q₁)) hW
    (g.comp mk) b
  have hcomp : (g.comp mk).comp (algebraMap A B) = g.comp (algebraMap A (B ⧸ q₁)) := by
    rw [RingHom.comp_assoc, hmk, Ideal.Quotient.mk_comp_algebraMap]
  have hf0 : f ≠ 0 := by
    rintro rfl
    exact hf1 (Polynomial.map_zero _)
  have hev : Polynomial.aeval (mk b) f = 0 := by
    have hginj : Function.Injective g := IsFractionRing.injective (B ⧸ q₁) (FractionRing (B ⧸ q₁))
    apply hginj
    rw [map_zero, Polynomial.aeval_def, Polynomial.hom_eval₂, ← hcomp]
    exact hf2
  have halg : IsAlgebraic A (mk b) := ⟨f, hf0, hev⟩
  have hne' := Ideal.under_ne_bot_of_algebraic_mem hb0 hbI halg
  apply hne'
  rw [eq_bot_iff]
  intro a ha
  rw [Ideal.under_def, Ideal.mem_comap, ← Ideal.Quotient.mk_comp_algebraMap, RingHom.comp_apply,
    ← hmk] at ha
  have h3 : algebraMap A B a ∈ Ideal.comap mk (Ideal.map mk q₂) := ha
  rw [Ideal.comap_map_of_surjective' mk Ideal.Quotient.mk_surjective, hmk, Ideal.mk_ker,
    sup_eq_left.mpr hle] at h3
  have h4 : a ∈ q₂.comap (algebraMap A B) := h3
  rw [h₂] at h4
  exact h4

theorem wcqi_weaklyEtale_generic_idem_sep : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [CommRing B] [Algebra A B], Algebra.WeaklyEtale A B → (∀ (q₁ q₂ : Ideal B), q₁.IsPrime → q₂.IsPrime → q₁ ≤ q₂ → q₁.comap (algebraMap A B) = ⊥ → q₂.comap (algebraMap A B) = ⊥ → q₁ = q₂) → ∀ b : B, ∃ c : B, IsIdempotentElem c ∧ ∀ q : Ideal B, q.IsPrime → q.comap (algebraMap A B) = ⊥ → (b ∈ q ↔ c ∈ q) :=
by
  intro A B _ _ _ _ _ hW hinc b
  classical
  set S : Submonoid B := Algebra.algebraMapSubmonoid B (nonZeroDivisors A) with hS
  have hmemS : ∀ y : B, y ∈ S ↔ ∃ a ∈ nonZeroDivisors A, algebraMap A B a = y :=
    fun y => Submonoid.mem_map
  have hD' : ∀ q : Ideal B, Disjoint (S : Set B) (q : Set B) → q.comap (algebraMap A B) = ⊥ := by
    intro q hq
    rw [eq_bot_iff]
    intro a ha
    rw [Ideal.mem_bot]
    by_contra h0
    have h1 : algebraMap A B a ∈ S := (hmemS _).2 ⟨a, mem_nonZeroDivisors_of_ne_zero h0, rfl⟩
    exact Set.disjoint_left.mp hq h1 (Ideal.mem_comap.mp ha)
  have hD : ∀ q : Ideal B, q.comap (algebraMap A B) = ⊥ → Disjoint (S : Set B) (q : Set B) := by
    intro q hq
    rw [Set.disjoint_left]
    intro y hyS hyq
    obtain ⟨a, ha, rfl⟩ := (hmemS y).1 hyS
    have h2 : a ∈ q.comap (algebraMap A B) := Ideal.mem_comap.mpr hyq
    rw [hq, Ideal.mem_bot] at h2
    exact nonZeroDivisors.ne_zero ha h2

  have hmax : ∀ P : Ideal (Localization S), P.IsPrime → P.IsMaximal := by
    intro P hP
    obtain ⟨M, hM, hPM⟩ := Ideal.exists_le_maximal P hP.ne_top
    have hP' := (IsLocalization.isPrime_iff_isPrime_disjoint S (Localization S) P).1 hP
    have hM' := (IsLocalization.isPrime_iff_isPrime_disjoint S (Localization S) M).1 hM.isPrime
    have heq : Ideal.under B P = Ideal.under B M :=
      hinc _ _ hP'.1 hM'.1 (Ideal.comap_mono hPM) (hD' _ hP'.2) (hD' _ hM'.2)
    have hPMeq : P = M := by
      rw [← IsLocalization.map_under S (Localization S) P,
        ← IsLocalization.map_under S (Localization S) M, heq]
    rw [hPMeq]
    exact hM

  have : Module.Flat A B := Algebra.WeaklyEtale.flat
  have hreg : ∀ r ∈ nonZeroDivisors A, ∀ x y : B, r • x = r • y → x = y :=
    fun r hr x y h => (Module.Flat.isSMulRegular_of_nonZeroDivisors hr) h

  have hlift : ∀ ε : Localization S, IsIdempotentElem ε →
      ∃ c : B, IsIdempotentElem c ∧ algebraMap B (Localization S) c = ε := by
    intro ε hε
    obtain ⟨⟨x, y⟩, hxy⟩ := IsLocalization.mk'_surjective S (S := Localization S) ε
    change IsLocalization.mk' (Localization S) x y = ε at hxy
    subst hxy
    obtain ⟨σ, hσ, hyσ⟩ := (hmemS y).1 y.2
    have hε2 : IsLocalization.mk' (Localization S) (x * x) (y * y) =
        IsLocalization.mk' (Localization S) x y := by
      rw [IsLocalization.mk'_mul]; exact hε.eq
    obtain ⟨u, hu⟩ := IsLocalization.eq.mp hε2
    obtain ⟨τ, hτ, hτu⟩ := (hmemS u).1 u.2
    have hρ : τ * σ ∈ nonZeroDivisors A := Submonoid.mul_mem _ hτ hσ
    have hxx : x * x = σ • x := by
      apply hreg (τ * σ) hρ
      simp only [Algebra.smul_def, map_mul, Submonoid.coe_mul] at hu ⊢
      rw [hτu, hyσ]
      linear_combination hu
    have hσ0 : σ ≠ 0 := nonZeroDivisors.ne_zero hσ
    obtain ⟨c, hc⟩ := wc_weaklyEtale_normal_idem A B hW x σ hσ0 hxx
    refine ⟨c, ?_, ?_⟩
    · show c * c = c
      apply hreg (σ * σ) (Submonoid.mul_mem _ hσ hσ)
      have h3 : (σ * σ) • (c * c) = x * x := by
        rw [hc]; simp only [Algebra.smul_def, map_mul]; ring
      rw [h3, hxx, hc]
      simp only [Algebra.smul_def, map_mul]
      ring
    · rw [hc, Algebra.smul_def, hyσ, IsLocalization.mk'_mul_cancel_left]

  obtain ⟨ε, hεi, hε⟩ := wc_zeroDim_idempotent_vanishing (Localization S) hmax
    wc_reduced_zeroDim_vnr (algebraMap B (Localization S) b)
  obtain ⟨c, hci, hcε⟩ := hlift ε hεi
  refine ⟨c, hci, fun q hq hbot => ?_⟩
  have hdisj := hD q hbot
  have hQ : (Ideal.map (algebraMap B (Localization S)) q).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint S _ q hq hdisj
  have htr : ∀ x : B, x ∈ q ↔
      algebraMap B (Localization S) x ∈ Ideal.map (algebraMap B (Localization S)) q := by
    intro x
    have h := IsLocalization.under_map_of_isPrime_disjoint S (Localization S) hq hdisj
    rw [← Ideal.mem_comap]
    change x ∈ q ↔ x ∈ Ideal.under B (Ideal.map (algebraMap B (Localization S)) q)
    rw [h]
  rw [htr b, htr c, hε _ hQ, hcε]

theorem wcqi_proet_P1_generic_chart : ∀ (K : Type u) [Field K], (∀ (B : Type u) [CommRing B] [Algebra (Polynomial K) B], Algebra.WeaklyEtale (Polynomial K) B → ∀ (q₁ q₂ : Ideal B), q₁.IsPrime → q₂.IsPrime → q₁ ≤ q₂ → q₁.comap (algebraMap (Polynomial K) B) = ⊥ → q₂.comap (algebraMap (Polynomial K) B) = ⊥ → q₁ = q₂) → (∀ (B : Type u) [CommRing B] [Algebra (Polynomial K) B], Algebra.WeaklyEtale (Polynomial K) B → ∀ b : B, ∃ c : B, IsIdempotentElem c ∧ ∀ q : Ideal B, q.IsPrime → q.comap (algebraMap (Polynomial K) B) = ⊥ → (b ∈ q ↔ c ∈ q)) → ∀ (T : (wcP1Over K).left.ProEt) (η : (wcP1Over K).left), (∀ y : (wcP1Over K).left, η ⤳ y) → ∀ x : T.left, ∃ U : Set T.left, IsOpen U ∧ x ∈ U ∧ IsCompact ({z : T.left | T.hom z = η} ∩ U) ∧ (∀ e₁ ∈ {z : T.left | T.hom z = η} ∩ U, ∀ e₂ ∈ {z : T.left | T.hom z = η} ∩ U, e₁ ⤳ e₂ → e₁ = e₂) ∧ ∀ e ∈ {z : T.left | T.hom z = η} ∩ U, ∀ V : Set T.left, IsOpen V → e ∈ V → ∃ D : Set T.left, IsOpen D ∧ IsOpen (U \ D) ∧ D ⊆ U ∧ e ∈ D ∧ D ∩ {z : T.left | T.hom z = η} ⊆ V :=
by
  intro K _ hinc hsep T η hη x
  obtain ⟨B, _, φ, ψ, j, hφ, hx, hj, hsq, hwe⟩ := wc_proet_P1_affine_chart K T x
  letI : Algebra (Polynomial K) B := ψ.toAlgebra
  haveI := hφ
  haveI := hj
  let jf : PrimeSpectrum (Polynomial K) → (wcP1Over K).left := fun p => j p
  let φf : PrimeSpectrum B → T.left := fun q => φ q
  have hjemb : Topology.IsOpenEmbedding jf := j.isOpenEmbedding
  have hφemb : Topology.IsOpenEmbedding φf := φ.isOpenEmbedding
  have hxr : x ∈ Set.range φf := hx
  have hjbot : jf ⊥ = η := by
    obtain ⟨p₀, hp₀⟩ : η ∈ Set.range jf :=
      (hη (jf ⊥)).mem_open hjemb.isOpen_range ⟨⊥, rfl⟩
    have h1 : p₀ ⤳ (⊥ : PrimeSpectrum (Polynomial K)) := by
      rw [← hjemb.isInducing.specializes_iff, hp₀]
      exact hη _
    have h2 : p₀ ≤ ⊥ := (PrimeSpectrum.le_iff_specializes p₀ ⊥).mpr h1
    rw [← hp₀, le_bot_iff.mp h2]
  have hkey : ∀ q : PrimeSpectrum B, T.hom (φf q) = jf (PrimeSpectrum.comap ψ q) := by
    intro q
    have h := congrArg (fun f : Spec (.of B) ⟶ (wcP1Over K).left => f q) hsq
    first
    | exact h
    | simpa using h
  have hgen : ∀ q : PrimeSpectrum B, T.hom (φf q) = η ↔ Ideal.comap ψ q.asIdeal = ⊥ := by
    intro q
    rw [hkey, ← hjbot, hjemb.isEmbedding.injective.eq_iff]
    constructor
    · intro h
      have h' := congrArg PrimeSpectrum.asIdeal h
      simpa using h'
    · intro h
      ext1
      simpa using h
  let Gen : Set (PrimeSpectrum B) := {q | Ideal.comap ψ q.asIdeal = ⊥}
  have hGc : IsCompact Gen := by
    let M : Submonoid B := Submonoid.map ψ (nonZeroDivisors (Polynomial K))
    have hr := PrimeSpectrum.localization_comap_range (Localization M) M
    have hG : Gen = Set.range (PrimeSpectrum.comap (algebraMap B (Localization M))) := by
      rw [hr]
      ext p
      simp only [Gen, Set.mem_setOf_eq]
      constructor
      · intro hp
        rw [Set.disjoint_left]
        rintro s ⟨a, ha, rfl⟩ hsp
        have ha' : a ∈ Ideal.comap ψ p.asIdeal := hsp
        rw [hp, Ideal.mem_bot] at ha'
        exact nonZeroDivisors.ne_zero ha ha'
      · intro hp
        rw [eq_bot_iff]
        intro a ha
        rw [Ideal.mem_bot]
        by_contra hne
        exact Set.disjoint_left.mp hp ⟨a, mem_nonZeroDivisors_of_ne_zero hne, rfl⟩ ha
    rw [hG]
    exact isCompact_range (PrimeSpectrum.continuous_comap _)
  have hGi : ∀ q₁ ∈ Gen, ∀ q₂ ∈ Gen, q₁ ⤳ q₂ → q₁ = q₂ := by
    intro q₁ h₁ q₂ h₂ hs
    have hle : q₁ ≤ q₂ := (PrimeSpectrum.le_iff_specializes q₁ q₂).mpr hs
    exact PrimeSpectrum.ext (hinc B hwe q₁.asIdeal q₂.asIdeal q₁.isPrime q₂.isPrime hle h₁ h₂)
  have hGs : ∀ q ∈ Gen, ∀ V : Set (PrimeSpectrum B), IsOpen V → q ∈ V →
      ∃ C : Set (PrimeSpectrum B), IsClopen C ∧ q ∈ C ∧ ∀ q' ∈ C, q' ∈ Gen → q' ∈ V := by
    intro q hq V hV hqV
    obtain ⟨v, ⟨b, rfl⟩, hqv, hvV⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hqV hV
    obtain ⟨c, hc, hbc⟩ := hsep B hwe b
    refine ⟨(PrimeSpectrum.basicOpen c : Set (PrimeSpectrum B)),
      PrimeSpectrum.isClopen_iff.mpr ⟨c, hc, rfl⟩, ?_, ?_⟩
    · have hb : b ∉ q.asIdeal := hqv
      show c ∉ q.asIdeal
      rwa [← hbc q.asIdeal q.isPrime hq]
    · intro q' hq'C hq'G
      apply hvV
      show b ∉ q'.asIdeal
      rw [hbc q'.asIdeal q'.isPrime hq'G]
      exact hq'C
  have hEq : {z : T.left | T.hom z = η} ∩ Set.range φf = φf '' Gen := by
    ext z
    constructor
    · rintro ⟨hz, q, rfl⟩
      exact ⟨q, (hgen q).mp hz, rfl⟩
    · rintro ⟨q, hq, rfl⟩
      exact ⟨(hgen q).mpr hq, q, rfl⟩
  refine ⟨Set.range φf, hφemb.isOpen_range, hxr, ?_, ?_, ?_⟩
  · rw [hEq]
    exact hGc.image hφemb.continuous
  · intro e₁ he₁ e₂ he₂ hs
    rw [hEq] at he₁ he₂
    obtain ⟨q₁, hq₁, rfl⟩ := he₁
    obtain ⟨q₂, hq₂, rfl⟩ := he₂
    rw [hφemb.isInducing.specializes_iff] at hs
    rw [hGi q₁ hq₁ q₂ hq₂ hs]
  · intro e he V hV heV
    rw [hEq] at he
    obtain ⟨q, hq, rfl⟩ := he
    obtain ⟨C, hC, hqC, hCV⟩ := hGs q hq (φf ⁻¹' V) (hV.preimage hφemb.continuous) heV
    refine ⟨φf '' C, hφemb.isOpenMap C hC.isOpen, ?_, Set.image_subset_range _ _,
      Set.mem_image_of_mem _ hqC, ?_⟩
    · rw [Set.range_sdiff_image hφemb.isEmbedding.injective]
      exact hφemb.isOpenMap _ hC.compl.isOpen
    · rintro z ⟨⟨q', hq'C, rfl⟩, hz⟩
      exact hCV q' hq'C ((hgen q').mp hz)

theorem wc_proet_P1bar_qc_conn_irreducible (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left) : IrreducibleSpace W.left :=
by
  classical

  haveI hirrP : IrreducibleSpace (wcP1Over F'').left := wc_proj_space_irreducible F'' 1
  obtain ⟨η, hη⟩ : ∃ η : (wcP1Over F'').left, ∀ y : (wcP1Over F'').left, η ⤳ y :=
    ⟨genericPoint (wcP1Over F'').left,
      fun y => (genericPoint_spec (wcP1Over F'').left).specializes (Set.mem_univ y)⟩

  haveI hWet : WeaklyEtale W.hom := W.prop
  have hgm : GeneralizingMap W.hom := Flat.generalizingMap W.hom
  have hgen : ∀ x : W.left, ∃ e ∈ {z : W.left | W.hom z = η}, e ⤳ x := by
    intro x
    obtain ⟨x', hx', hx'η⟩ := hgm (hη (W.hom x))
    exact ⟨x', hx'η, hx'⟩

  have hprop : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  have hqcbc : ∀ {X₁ Y₁ Z₁ : Scheme.{u}} (f₁ : X₁ ⟶ Z₁) (g₁ : Y₁ ⟶ Z₁), IsProper f₁ →
      QuasiCompact (Limits.pullback.snd f₁ g₁) := by
    intro X₁ Y₁ Z₁ f₁ g₁ h₁
    haveI := h₁
    infer_instance
  have hqcsnd := hqcbc (wcP1Over F'').hom
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) hprop
  haveI hcPbar : CompactSpace (wcGeomPoint F'' (wcP1Over F'') hP).left := by
    have hc := @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd
      (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      hqcsnd inferInstance
    exact hc
  haveI hcW : CompactSpace W.left := QuasiCompact.compactSpace_of_compactSpace w.left

  have hchart := wcqi_proet_P1_generic_chart F''
    (fun B _ _ hB => wcqi_weaklyEtale_comap_bot_incomparable (Polynomial F'') B hB)
    (fun B _ _ hB => wcqi_weaklyEtale_generic_idem_sep (Polynomial F'') B hB
      (wcqi_weaklyEtale_comap_bot_incomparable (Polynomial F'') B hB)) W η hη

  have hpre := wcqi_top_generic_set_preconnected {z : W.left | W.hom z = η} hgen hchart

  obtain ⟨x⟩ := (inferInstance : Nonempty W.left)
  obtain ⟨e, he, -⟩ := hgen x

  exact wcqi_top_irreducible_of_generic_set {z : W.left | W.hom z = η} ⟨e, he⟩ hpre hgen hchart

theorem wc_qclift_transition_lattice (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W) :
    ∃ P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]),
    ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1 :=
by
  classical
  obtain ⟨τ, hcont, htr⟩ := wc_qtl_transition_matrix_field (wcP1Over F'').left G W k ℓ θ

  haveI hP1proper : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hP1c : CompactSpace ↥(wcP1Over F'').left :=
    QuasiCompact.compactSpace_of_compactSpace (wcP1Over F'').hom
  haveI : QuasiCompact (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
    show QuasiCompact (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    infer_instance
  haveI hWqc : QuasiCompact W.hom := by
    rw [← MorphismProperty.Over.w w]
    infer_instance
  haveI hWc : CompactSpace ↥W.left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ W.hom hWqc hP1c
  haveI : CompactSpace ↥(Limits.pullback W.hom W.hom) :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst W.hom W.hom) inferInstance
      hWc

  have hbd : ∃ C : ℝ, ∀ h ∈ Set.range τ, ∀ j : Fin k, ‖h (Pi.single j 1)‖ ≤ C := by
    have hf : Continuous (fun p => fun j : Fin k => τ p (Pi.single j 1)) :=
      continuous_pi (fun j => hcont _)
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
    refine ⟨C, ?_⟩
    rintro _ ⟨p, rfl⟩ j
    exact (norm_le_pi_norm (fun j : Fin k => τ p (Pi.single j 1)) j).trans (hC p (Set.mem_univ p))

  haveI hWirr : IrreducibleSpace ↥W.left :=
    wc_proet_P1bar_qc_conn_irreducible F'' hP W w hqc hconn
  haveI hWet : WeaklyEtale W.hom := W.prop
  have hgen : ∀ p : ↥(Limits.pullback W.hom W.hom), ∃ p' : ↥(Limits.pullback W.hom W.hom),
      τ p' = τ p ∧ (Limits.pullback.fst W.hom W.hom) p' = genericPoint ↥W.left ∧
        (Limits.pullback.snd W.hom W.hom) p' = genericPoint ↥W.left := by
    intro p
    obtain ⟨p', hsp, h1, h2⟩ := @wc_qtl_generic_pair_generization _ _ W.hom hWet hWirr p
    refine ⟨p', ?_, h1, h2⟩
    apply LinearMap.ext
    intro v
    exact (hsp.map (hcont v)).eq
  have hmul : ∀ h₁ ∈ Set.range τ, ∀ h₂ ∈ Set.range τ, h₂ ∘ₗ h₁ ∈ Set.range τ := by
    rintro _ ⟨p, rfl⟩ _ ⟨q, rfl⟩
    obtain ⟨p', hp', -, hp2⟩ := hgen p
    obtain ⟨q', hq', hq1, -⟩ := hgen q
    obtain ⟨r, hr⟩ := wc_qtl_transition_cocycle (wcP1Over F'').left G W k ℓ θ τ htr p' q'
      (hp2.trans hq1.symm)
    exact ⟨r, by rw [hr, hp', hq']⟩

  obtain ⟨P, hPH⟩ := wc_qtl_bounded_monoid_lattice ℓ k (Set.range τ) hbd hmul
  refine ⟨P, fun V a b x z ha => ?_⟩
  rw [htr V a b x z]
  exact hPH _ ⟨_, rfl⟩ _ ha

theorem wc_qclift_integral_subsheaf (S : Scheme.{u})
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (k ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) :
    ∃ J : Subobject G,
    ∀ (V : S.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : S.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1 :=
by
  classical
  have hcov : ∀ (T : S.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology S T →
      ∀ τ : T.left, ∃ (W' : S.ProEt) (f : W' ⟶ T), R.arrows f ∧ τ ∈ Set.range f.left := by
    intro T R hR τ
    have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ T.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
          (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows g →
        ∃ (W' : S.ProEt) (f : W' ⟶ T) (e : Z ⟶ W'.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W', φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W', φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget S) R) ∈ Scheme.proetaleTopology T.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget S) (Scheme.ProEt.topology S)
          (Scheme.proetaleTopology.over S)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition
        (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose W' f e hf he using fun j => fact (𝒰.f j) (hmem j)
    obtain ⟨Ua, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
    have hτ' : τ ∈ (Ua : Set T.left) := hτU
    rw [← hUeq] at hτ'
    obtain ⟨i, z, hz, hzτ⟩ := Set.mem_iUnion.mp hτ'
    refine ⟨W' (c i), f (c i), hf _, e (c i) z, ?_⟩
    rw [← hzτ, he (c i), Scheme.Hom.comp_apply]

  let Cond : ∀ T : S.ProEt, G.obj.obj (Opposite.op T) → Prop := fun T x =>
    ∀ (V' : S.ProEt) (c : V' ⟶ T) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
      ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom x)).down) z) i‖ ≤ 1

  have lat0 : ∀ (V : S.ProEt) (h' : V ⟶ W) (z : V.left) (i : Fin k),
      ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        (0 : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk h'))).down) z) i‖ ≤ 1 := by
    intro V h' z i
    have e3 : (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        (0 : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk h'))).down) z = 0 := rfl
