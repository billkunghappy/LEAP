      have hC : ∀ (U : Z.Opens), (∀ W' : Z.Opens, W' ≤ U → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W') ℓ), Function.Bijective (wcEtPull D j)) → ∀ C : (W : Scheme.{u}).Opens, W.ι ''ᵁ C ≤ U → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W ∣_ C) ℓ), Function.Bijective (wcEtPull D j) := by
        intro U hU C hCU
