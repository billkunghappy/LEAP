  let κ : (Monotone.functor hmono ⋙ Subobject.underlying) ⟶
      (Functor.const ℕ).obj (Subobject.underlying.obj M) :=
    { app := fun n =>
        ((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj M))).obj J).arrow
