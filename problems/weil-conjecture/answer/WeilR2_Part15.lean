        = (φ l₁ ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint A) := by rw [hφa l₁]
      _ = (W'.obj l₁).right.hom (φ l₁ (IsLocalRing.closedPoint A)) := comp_ap _ _ _
      _ = (W'.obj l₁).right.hom ((W'.obj l₁).hom.left (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F'')))))) := by rw [hcl]
      _ = ((W'.obj l₁).hom.left ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F''))))) := (comp_ap _ _ _).symm
      _ = D.S i (IsLocalRing.closedPoint F'') := by rw [hwN _ (W'.obj l₁)]; exact hγ _ _
  have hxs : D.f (D.xs i (IsLocalRing.closedPoint F'')) = D.S i (IsLocalRing.closedPoint F'') := by
    calc D.f (D.xs i (IsLocalRing.closedPoint F''))
        = (D.xs i ≫ D.f) (IsLocalRing.closedPoint F'') := (comp_ap _ _ _).symm
      _ = D.S i (IsLocalRing.closedPoint F'') := by rw [D.hxs i]
  obtain ⟨x₀, hx₀, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := D.f) (g := a)
    (D.xs i (IsLocalRing.closedPoint F'')) (IsLocalRing.closedPoint A) (hxs.trans ha_cl.symm)

  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', e, hinit, haff, hφ, hφa', hlim, he, hcompB⟩ :=
    wc_et_geom_strict_henselization x₀
  have hB : wcHalShData x₀ B Λ' W'' φ' a' := ⟨hinit, haff, hφ, hφa', hlim, e, he, hcompB⟩
  let r : Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ ⟶
      Limits.pullback (Limits.pullback.snd D.f a) ξ :=
    Limits.pullback.lift (Limits.pullback.fst (a' ≫ Limits.pullback.snd D.f a) ξ ≫ a')
      (Limits.pullback.snd (a' ≫ Limits.pullback.snd D.f a) ξ)
      (by rw [Category.assoc]; exact Limits.pullback.condition)
  have hr₁ : r ≫ Limits.pullback.fst (Limits.pullback.snd D.f a) ξ =
      Limits.pullback.fst (a' ≫ Limits.pullback.snd D.f a) ξ ≫ a' := Limits.pullback.lift_fst _ _ _
  have hr₂ : r ≫ Limits.pullback.snd (Limits.pullback.snd D.f a) ξ =
      Limits.pullback.snd (a' ≫ Limits.pullback.snd D.f a) ξ := Limits.pullback.lift_snd _ _ _
  obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists r (ℓ ^ k)

  haveI := wc_pencil_odp_shens_milnor_fibre_top_cyclic F' F'' Y n hn hn2 D ℓ Fact.out hℓ k i A Λ
    W' φ a hA x₀ hx₀ B Λ' W'' φ' a' hB Ω ξ hξ
  haveI := AddSubgroup.isAddCyclic (wcEtPull Dr (n - 1)).range
  obtain ⟨h, hh⟩ := IsAddCyclic.exists_generator (α := (wcEtPull Dr (n - 1)).range)
  obtain ⟨g, hg⟩ := AddMonoidHom.mem_range.mp h.2
  have hs3 := fun z hz => wc_pencil_odp_shens_restrict_ker_le_range F' F'' Y n hn hn2 D ℓ Fact.out
    hℓ k i A Λ W' φ a hA x₀ hx₀ B Λ' W'' φ' a' hB Ω ξ hξ D' r hr₁ hr₂ Dr z hz
  obtain ⟨y₀, hy₀⟩ := hs3 ((ℓ ^ k) • g) (by rw [map_nsmul, hg]; exact htors _ _ _)
  have hG2 : ∀ x, ∃ c : ℤ, ∃ y, wcEtPull D' (n - 1) y = x - c • g := by
    intro x
    obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp (hh ⟨wcEtPull Dr (n - 1) x, x, rfl⟩)
    have hc' : c • (h : wcEtZModExt (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ)
        (ℓ ^ k) (n - 1)) = wcEtPull Dr (n - 1) x := by
      rw [← AddSubgroup.coe_zsmul, hc]
    refine ⟨c, hs3 (x - c • g) ?_⟩
    rw [map_sub, map_zsmul, hg, hc', sub_self]

  have P1 : (ℓ ^ k) • Θ₁ g ∈ Set.range (wcZModPull Dk (n - 1)) :=
    ⟨Θ₀ y₀, by rw [hΘ, hy₀, map_nsmul]⟩
  have P2 : ∀ z, ∃ c : ℤ, z - c • Θ₁ g ∈ Set.range (wcZModPull Dk (n - 1)) := by
    intro z
    obtain ⟨c, y, hy⟩ := hG2 (Θ₁.symm z)
    exact ⟨c, Θ₀ y, by rw [hΘ, hy, map_sub, map_zsmul, AddEquiv.apply_symm_apply]⟩

  have hring : ∀ a b : ZMod (ℓ ^ k),
      ∃ e₁ e₂ : ZMod (ℓ ^ k), (IsUnit e₁ ∨ IsUnit e₂) ∧ e₁ * a + e₂ * b = 0 := by
    have hℓp : ℓ.Prime := Fact.out
    intro a b
    by_cases ha : a = 0
    · exact ⟨1, 0, Or.inl isUnit_one, by rw [ha]; ring⟩
    by_cases hb : b = 0
    · exact ⟨0, 1, Or.inr isUnit_one, by rw [hb]; ring⟩
    have hav : a.val ≠ 0 := fun h => ha ((ZMod.val_eq_zero a).mp h)
    have hbv : b.val ≠ 0 := fun h => hb ((ZMod.val_eq_zero b).mp h)
    obtain ⟨α, a₁, ha₁, haeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hav ℓ hℓp.one_lt.ne'
    obtain ⟨β, b₁, hb₁, hbeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hbv ℓ hℓp.one_lt.ne'
    have hunit : ∀ x : ℕ, ¬ ℓ ∣ x → IsUnit (x : ZMod (ℓ ^ k)) := by
      intro x hx
      exact (ZMod.isUnit_iff_coprime x (ℓ ^ k)).mpr
        (((Nat.Prime.coprime_iff_not_dvd hℓp).mpr hx).symm.pow_right k)
    have ha' : a = (ℓ : ZMod (ℓ ^ k)) ^ α * (a₁ : ZMod (ℓ ^ k)) := by
      rw [← ZMod.natCast_zmod_val a, haeq]; push_cast; ring
    have hb' : b = (ℓ : ZMod (ℓ ^ k)) ^ β * (b₁ : ZMod (ℓ ^ k)) := by
      rw [← ZMod.natCast_zmod_val b, hbeq]; push_cast; ring
    rcases le_or_gt α β with hαβ | hαβ
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hαβ
      have hu := hunit a₁ ha₁
      refine ⟨-((ℓ : ZMod (ℓ ^ k)) ^ d * (b₁ : ZMod (ℓ ^ k))) * ↑hu.unit⁻¹, 1,
        Or.inr isUnit_one, ?_⟩
      have hw := hu.val_inv_mul
      rw [ha', hb', pow_add]
      linear_combination (-((ℓ : ZMod (ℓ ^ k)) ^ d * (b₁ : ZMod (ℓ ^ k)) *
        (ℓ : ZMod (ℓ ^ k)) ^ α)) * hw
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hαβ.le
      have hu := hunit b₁ hb₁
      refine ⟨1, -((ℓ : ZMod (ℓ ^ k)) ^ d * (a₁ : ZMod (ℓ ^ k))) * ↑hu.unit⁻¹,
        Or.inl isUnit_one, ?_⟩
      have hw := hu.val_inv_mul
      rw [ha', hb', pow_add]
      linear_combination (-((ℓ : ZMod (ℓ ^ k)) ^ d * (a₁ : ZMod (ℓ ^ k)) *
        (ℓ : ZMod (ℓ ^ k)) ^ β)) * hw
  intro z₁ z₂
  obtain ⟨c₁, hc₁⟩ := P2 z₁
  obtain ⟨c₂, hc₂⟩ := P2 z₂
  obtain ⟨e₁, e₂, hu, he⟩ := hring (c₁ : ZMod (ℓ ^ k)) (c₂ : ZMod (ℓ ^ k))
  refine ⟨e₁, e₂, hu, ?_⟩
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
  have hdiv : ((ℓ ^ k : ℕ) : ℤ) ∣ (e₁.val : ℤ) * c₁ + (e₂.val : ℤ) * c₂ := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_add, Int.cast_mul, Int.cast_mul,
      Int.cast_natCast, Int.cast_natCast, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    exact he
  obtain ⟨t, ht⟩ := hdiv
  have key : (e₁.val : ℤ) • (z₁ - c₁ • Θ₁ g) + (e₂.val : ℤ) • (z₂ - c₂ • Θ₁ g) +
      t • (((ℓ ^ k : ℕ) : ℤ) • Θ₁ g) = (e₁.val : ℤ) • z₁ + (e₂.val : ℤ) • z₂ := by
    rw [smul_smul t, mul_comm t, ← ht, add_smul, smul_sub, smul_sub, smul_smul, smul_smul]
    abel
  have m1 : z₁ - c₁ • Θ₁ g ∈ (wcZModPull Dk (n - 1)).range := AddMonoidHom.mem_range.mpr hc₁
  have m2 : z₂ - c₂ • Θ₁ g ∈ (wcZModPull Dk (n - 1)).range := AddMonoidHom.mem_range.mpr hc₂
  have m3 : ((ℓ ^ k : ℕ) : ℤ) • Θ₁ g ∈ (wcZModPull Dk (n - 1)).range := by
    rw [natCast_zsmul]; exact AddMonoidHom.mem_range.mpr P1
  have hmem : (e₁.val : ℤ) • z₁ + (e₂.val : ℤ) • z₂ ∈ (wcZModPull Dk (n - 1)).range := by
    rw [← key]
    exact add_mem (add_mem (zsmul_mem m1 _) (zsmul_mem m2 _)) (zsmul_mem m3 _)
  rw [← natCast_zsmul z₁ e₁.val, ← natCast_zsmul z₂ e₂.val]
  exact AddMonoidHom.mem_range.mp hmem

theorem wc_ladic_pull_injective_of_torsion {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (hDk : ∀ k : ℕ, wcZModPullCanonical (Dk k))
    (q : ℕ) (hfinY : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) (q - 1)))
    (hinj : ∀ k : ℕ, 1 ≤ k → Function.Injective (wcZModPull (Dk k) q)) :
    Function.Injective (wcHMPull D q) :=
by
  classical
  obtain ⟨P⟩ := wc_ladic_milnor_package ℓ p D hD Dk hDk q
  letI := P.instMY
  letI := P.instMT
  obtain ⟨L1, L2, L3, L4⟩ := wc_hmScalar_laws Y ℓ q
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨N, y, hy⟩ := P.denomY x
  have hy' : P.ρY y = (ℓ ^ N : ℕ) • x := by
    rw [L4, Nat.cast_pow, ← hy]
  have hT0 : P.ρT (P.pI y) = 0 := by
    rw [P.ρ_pI y, hy', map_nsmul, hx, smul_zero]
  obtain ⟨s, hs⟩ := P.torsT (P.pI y) hT0
  have hpI : P.pI ((ℓ ^ s : ℕ) • y) = 0 := by
    rw [map_nsmul, hs]
  have hred : ∀ k, 1 ≤ k → P.redY k ((ℓ ^ s : ℕ) • y) = 0 := by
    intro k hk
    have h1 : wcZModPull (Dk k) q (P.redY k ((ℓ ^ s : ℕ) • y)) = 0 := by
      rw [← P.red_pI k, hpI, map_zero]
    exact hinj k hk (h1.trans (map_zero _).symm)
  have hy0 : (ℓ ^ s : ℕ) • y = 0 := by
    refine P.sepY ?_ _ hred
    apply (config := { synthAssignedInstances := false }) wc_tower_lim1_of_ml
    apply (config := { synthAssignedInstances := false }) wc_tower_ml_of_finite
    exact hfinY
  have hK : (ℓ ^ N * ℓ ^ s : ℕ) • x = 0 := by
    rw [mul_nsmul, ← hy', ← map_nsmul, hy0, map_zero]
  have hKne : ((ℓ ^ N * ℓ ^ s : ℕ) : ℚ_[ℓ]) ≠ 0 := by
    have hl : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
    exact_mod_cast mul_ne_zero (pow_ne_zero N hl) (pow_ne_zero s hl)
  rw [L4] at hK
  rw [← L2 x, ← mul_inv_cancel₀ hKne, ← L1, hK, map_zero]

theorem wc_ladic_pull_codim_one_of_torsion {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (hDk : ∀ k : ℕ, wcZModPullCanonical (Dk k))
    (q : ℕ) (hfinT : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt T (ℓ ^ k) (q - 1)))
    (hinj : ∀ k : ℕ, 1 ≤ k → Function.Injective (wcZModPull (Dk k) q))
    (hcyc : ∀ k : ℕ, 1 ≤ k → ∀ z₁ z₂ : wcZModProEtExt T (ℓ ^ k) q,
      ∃ e₁ e₂ : ZMod (ℓ ^ k), (IsUnit e₁ ∨ IsUnit e₂) ∧
        e₁.val • z₁ + e₂.val • z₂ ∈ Set.range (wcZModPull (Dk k) q)) :
    ∀ t₁ t₂ : wcHM T ℓ q, ∃ c₁ c₂ : ℚ_[ℓ], (c₁ ≠ 0 ∨ c₂ ≠ 0) ∧
      wcHMScalar T ℓ q c₁ t₁ + wcHMScalar T ℓ q c₂ t₂ ∈ Set.range (wcHMPull D q) :=
by
  classical
  intro t₁ t₂
  obtain ⟨P⟩ := wc_ladic_milnor_package ℓ p D hD Dk hDk q
  letI := P.instMY
  letI := P.instModY
  letI := P.instMT
  haveI hEZ : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) :=
    fun n => HasExt.standard _
  haveI hEZY : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf Y n)) :=
    fun n => HasExt.standard _
  haveI hER : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  obtain ⟨L1, -, -, -⟩ := wc_hmScalar_laws T ℓ q
  have hℓ : Nat.Prime ℓ := Fact.out

  have c2 : ∀ (n : ℕ) (f f' : C(↥T, ULift.{u+1} (ZMod n))),
      wcZModFun T n (f + f') = wcZModFun T n f + wcZModFun T n f' := by
    intro n f f'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (f₀ : C(↥T, ULift.{u+1} (ZMod n))),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun T n f₀)).1 V =
          (f₀.comp (Opposite.unop V).hom.base.hom :
            C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod n))) := by
      intro f₀
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun T n f)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun T n f')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have c1one : ∀ n : ℕ, wcZModFun T n 1 = 𝟙 _ := by
    intro n
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hconst : ∀ (n d : ℕ), (ContinuousMap.const (↥T) (ULift.up (d : ZMod n)) :
      C(↥T, ULift.{u+1} (ZMod n))) = d • (1 : C(↥T, ULift.{u+1} (ZMod n))) := by
    intro n d
    induction d with
    | zero =>
      rw [zero_nsmul]
      ext t
      simp
    | succ d ih =>
      rw [succ_nsmul, ← ih]
      ext t
      simp
  have hs1 : ∀ (k : ℕ) (x : wcZModProEtExt T (ℓ ^ k) q) (d : ℕ),
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
        (ContinuousMap.const _ (ULift.up (d : ZMod (ℓ ^ k)))))).comp x (zero_add q) = d • x := by
    intro k x d
    let F : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k))) →+
        Abelian.Ext (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))
          (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) 0 :=
      AddMonoidHom.mk' (fun f => Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f)) (fun f f' => by
        show Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (f + f')) =
          Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f) + Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f')
        rw [c2, Abelian.Ext.mk₀_add])
    have h1 : Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
        (ContinuousMap.const _ (ULift.up (d : ZMod (ℓ ^ k))))) =
        d • Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))) := by
      rw [hconst, ← c1one (ℓ ^ k)]
      exact map_nsmul F d 1
    have hnc : ∀ (α : Abelian.Ext (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))
        (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) 0) (j : ℕ),
        (j • α).comp x (zero_add q) = j • α.comp x (zero_add q) := fun α j =>
      map_nsmul (AddMonoidHom.mk' (fun α' : Abelian.Ext
          (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))
          (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) 0 => α'.comp x (zero_add q))
        (fun a a' => Abelian.Ext.add_comp a a' x (zero_add q))) j α
    rw [h1, hnc, Abelian.Ext.mk₀_id_comp]
  have htors : ∀ (k : ℕ) (w : wcZModProEtExt T (ℓ ^ k) q), (ℓ ^ k) • w = 0 := by
    intro k w
    have h1 := hs1 k w (ℓ ^ k)
    have h0 := hs1 k w 0
    rw [zero_nsmul] at h0
    have e : ((ℓ ^ k : ℕ) : ZMod (ℓ ^ k)) = ((0 : ℕ) : ZMod (ℓ ^ k)) := by
      rw [ZMod.natCast_self, Nat.cast_zero]
    rw [e] at h1
    exact h1.symm.trans h0

  have hval : ∀ (k : ℕ) (e : ZMod (ℓ ^ (k + 1))) (w : wcZModProEtExt T (ℓ ^ k) q),
      e.val • w = (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) e).val • w := by
    intro k e w
    haveI : NeZero (ℓ ^ (k + 1)) := ⟨pow_ne_zero _ hℓ.ne_zero⟩
    rw [ZMod.castHom_apply, ← ZMod.natCast_val, ZMod.val_natCast]
    conv_lhs => rw [← Nat.div_add_mod e.val (ℓ ^ k)]
    rw [add_nsmul, mul_nsmul, htors k w, nsmul_zero, zero_add]

  have c1 : ∀ k : ℕ, IsLocallyConstant (fun x : ℤ_[ℓ] => PadicInt.toZModPow k x) := by
    intro k
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro y
    rw [isOpen_iff_forall_mem_open]
    intro x₀ hx₀
    have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓ.pos
    refine ⟨Metric.closedBall x₀ ((ℓ : ℝ) ^ (-(k : ℤ))), ?_,
      IsUltrametricDist.isOpen_closedBall x₀ (zpow_ne_zero _ hℓpos.ne'),
      Metric.mem_closedBall_self (zpow_pos hℓpos _).le⟩
    intro x hx
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    have h1 := (PadicInt.norm_le_pow_iff_mem_span_pow (x - x₀) k).mp hx
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    show PadicInt.toZModPow k x ∈ ({y} : Set (ZMod (ℓ ^ k)))
    rw [h1]
    exact hx₀
  have hcast : ∀ (k : ℕ) (x : ℤ_[ℓ]),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k))
        (PadicInt.toZModPow (k + 1) x) = PadicInt.toZModPow k x := by
    intro k x
    rw [ZMod.castHom_apply]
    exact PadicInt.cast_toZModPow k (k + 1) (Nat.le_succ k) x

  have hρact : ∀ (c : ℤ_[ℓ]) (z : P.MT),
      P.ρT (P.act (ContinuousMap.const _ (ULift.up c)) z) =
        wcHMScalar T ℓ q (c : ℚ_[ℓ]) (P.ρT z) := by
    intro c z
    refine (P.ρ_act (ContinuousMap.const _ (ULift.up c))
      (ContinuousMap.const _ (ULift.up (c : ℚ_[ℓ]))) (fun t => rfl) z).trans ?_
    refine (wc_hmFun_scalar_smul T ℓ q 1 (ContinuousMap.const _ (ULift.up (c : ℚ_[ℓ])))
      (c : ℚ_[ℓ]) (fun x => by simp) (P.ρT z)).trans ?_
    refine congrArg (wcHMScalar T ℓ q (c : ℚ_[ℓ])) ?_
    rw [(wc_hm_fun_one_mul T ℓ).1]
    exact Abelian.Ext.mk₀_id_comp _

  have hred_act : ∀ (k : ℕ) (c : ℤ_[ℓ]) (z : P.MT),
      P.redT k (P.act (ContinuousMap.const _ (ULift.up c)) z) =
        (PadicInt.toZModPow k c).val • P.redT k z := by
    intro k c z
    haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ hℓ.ne_zero⟩
    rw [P.red_act k _ (ContinuousMap.const _
      (ULift.up (((PadicInt.toZModPow k c).val : ℕ) : ZMod (ℓ ^ k))))
      (fun t => by
        show (((PadicInt.toZModPow k c).val : ℕ) : ZMod (ℓ ^ k)) = PadicInt.toZModPow k c
        exact ZMod.natCast_zmod_val _) z]
    exact hs1 k (P.redT k z) _

  have hlift : ∀ m : P.MT, (∀ k, 1 ≤ k → P.redT k m ∈ Set.range (wcZModPull (Dk k) q)) →
      ∃ y : P.MY, P.pI y = m := by
    intro m hm
    have hpre : ∀ k, 1 ≤ k → ∃ a, wcZModPull (Dk k) q a = P.redT k m := fun k hk => hm k hk
    choose α' hα' using hpre
    let α : ∀ k, wcZModProEtExt Y (ℓ ^ k) q := fun k => if h : 1 ≤ k then α' k h else 0
    have hα : ∀ k (hk : 1 ≤ k), α k = α' k hk := fun k hk => dif_pos hk
    have hcompat : ∀ k, 1 ≤ k → P.τY k q (α (k + 1)) = α k := by
      intro k hk
      apply hinj k hk
      rw [← P.τ_pull, hα (k + 1) (by omega), hα k hk, hα' (k + 1) (by omega), hα' k hk,
        P.redT_compat k m hk]
    obtain ⟨y, hy⟩ := P.liftY α hcompat
    have hdiff : ∀ k, 1 ≤ k → P.redT k (P.pI y - m) = 0 := by
      intro k hk
      rw [map_sub, P.red_pI, hy k hk, hα k hk, hα' k hk, sub_self]
    have hML := wc_tower_ml_of_finite (fun k => P.τT k (q - 1)) hfinT
    have hlim := wc_tower_lim1_of_ml _ hML
    exact ⟨y, sub_eq_zero.mp (P.sepT hlim _ hdiff)⟩

  obtain ⟨N₁, m₁, hm₁⟩ := P.denomT t₁
  obtain ⟨N₂, m₂, hm₂⟩ := P.denomT t₂
  obtain ⟨G, hG⟩ : ∃ G : ∀ k : ℕ, Set (ZMod (ℓ ^ k) × ZMod (ℓ ^ k)), ∀ k e, e ∈ G k ↔
      ((IsUnit e.1 ∨ IsUnit e.2) ∧
        e.1.val • P.redT k m₁ + e.2.val • P.redT k m₂ ∈ Set.range (wcZModPull (Dk k) q)) :=
    ⟨fun k => {e | (IsUnit e.1 ∨ IsUnit e.2) ∧
        e.1.val • P.redT k m₁ + e.2.val • P.redT k m₂ ∈ Set.range (wcZModPull (Dk k) q)},
      fun k e => Iff.rfl⟩
  have hGne : ∀ k, 1 ≤ k → (G k).Nonempty := by
    intro k hk
    obtain ⟨e₁, e₂, hu, hmem⟩ := hcyc k hk (P.redT k m₁) (P.redT k m₂)
    exact ⟨(e₁, e₂), (hG k _).mpr ⟨hu, hmem⟩⟩
  have hGcomp : ∀ k, 1 ≤ k → ∀ e ∈ G (k + 1),
      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) e.1,
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) e.2) ∈ G k := by
    intro k hk e he
    obtain ⟨hu, y, hy⟩ := (hG (k + 1) e).mp he
    refine (hG k _).mpr ⟨?_, P.τY k q y, ?_⟩
    · rcases hu with h | h
      · exact Or.inl (h.map _)
      · exact Or.inr (h.map _)
    · show wcZModPull (Dk k) q (P.τY k q y) = _
      rw [← P.τ_pull k q y, hy, map_add, map_nsmul, map_nsmul, P.redT_compat k m₁ hk,
        P.redT_compat k m₂ hk, hval k e.1, hval k e.2]

  let C : ℕ → Set (ℤ_[ℓ] × ℤ_[ℓ]) := fun j =>
    (fun c : ℤ_[ℓ] × ℤ_[ℓ] => (PadicInt.toZModPow (j + 1) c.1, PadicInt.toZModPow (j + 1) c.2))
      ⁻¹' G (j + 1)
  have hφ : ∀ j : ℕ, IsLocallyConstant (fun c : ℤ_[ℓ] × ℤ_[ℓ] =>
      (PadicInt.toZModPow (j + 1) c.1, PadicInt.toZModPow (j + 1) c.2)) := fun j =>
    IsLocallyConstant.prodMk ((c1 (j + 1)).comp_continuous continuous_fst)
      ((c1 (j + 1)).comp_continuous continuous_snd)
  have hclosed : ∀ j, IsClosed (C j) := by
    intro j
    rw [← isOpen_compl_iff]
    have := hφ j (G (j + 1))ᶜ
    rw [Set.preimage_compl] at this
    exact this
  have hCne : ∀ j, (C j).Nonempty := by
    intro j
    obtain ⟨e, he⟩ := hGne (j + 1) (by omega)
    obtain ⟨a, ha⟩ := ZMod.ringHom_surjective (PadicInt.toZModPow (j + 1)) e.1
    obtain ⟨b, hb⟩ := ZMod.ringHom_surjective (PadicInt.toZModPow (j + 1)) e.2
    refine ⟨(a, b), ?_⟩
    show (PadicInt.toZModPow (j + 1) a, PadicInt.toZModPow (j + 1) b) ∈ G (j + 1)
    rw [ha, hb]
    exact he
  have hdec : ∀ j, C (j + 1) ⊆ C j := by
    intro j c hc
    have h := hGcomp (j + 1) (by omega)
      (PadicInt.toZModPow (j + 1 + 1) c.1, PadicInt.toZModPow (j + 1 + 1) c.2) hc
    show (PadicInt.toZModPow (j + 1) c.1, PadicInt.toZModPow (j + 1) c.2) ∈ G (j + 1)
    rw [← hcast (j + 1) c.1, ← hcast (j + 1) c.2]
    exact h
  obtain ⟨c, hc⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed C hdec
    hCne (hclosed 0).isCompact hclosed
  have hgood : ∀ k, 1 ≤ k → (PadicInt.toZModPow k c.1, PadicInt.toZModPow k c.2) ∈ G k := by
    intro k hk
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    exact Set.mem_iInter.mp hc j

  obtain ⟨y, hy⟩ := hlift (P.act (ContinuousMap.const _ (ULift.up c.1)) m₁ +
      P.act (ContinuousMap.const _ (ULift.up c.2)) m₂) (by
    intro k hk
    rw [map_add, hred_act, hred_act]
    exact ((hG k _).mp (hgood k hk)).2)

  haveI : Fact (1 < ℓ ^ 1) := ⟨by rw [pow_one]; exact hℓ.one_lt⟩
  have hnz : ∀ (N : ℕ) (x : ℤ_[ℓ]), IsUnit (PadicInt.toZModPow 1 x) →
      (ℓ : ℚ_[ℓ]) ^ N * (x : ℚ_[ℓ]) ≠ 0 := by
    intro N x hx
    refine mul_ne_zero (pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓ.ne_zero)) ?_
    intro h0
    rw [PadicInt.coe_eq_zero] at h0
    rw [h0, map_zero] at hx
    exact not_isUnit_zero hx
  have hu1 := ((hG 1 _).mp (hgood 1 le_rfl)).1
  refine ⟨(ℓ : ℚ_[ℓ]) ^ N₁ * (c.1 : ℚ_[ℓ]), (ℓ : ℚ_[ℓ]) ^ N₂ * (c.2 : ℚ_[ℓ]), ?_,
    P.ρY y, ?_⟩
  · rcases hu1 with h | h
    · exact Or.inl (hnz N₁ c.1 h)
    · exact Or.inr (hnz N₂ c.2 h)
  · rw [← P.ρ_pI, hy, map_add, hρact, hρact, ← hm₁, ← hm₂, L1, L1]

theorem wc_pencil_PL_specialization (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A₀ : Type u) [CommRing A₀] [HenselianLocalRing A₀]
    [IsSepClosed (IsLocalRing.ResidueField A₀)]
    (e₀ : V₀.left ≅ Spec (.of A₀))
    (hV₀ : V₀.hom (e₀.inv (IsLocalRing.closedPoint A₀)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V₀) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    Function.Injective ((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom ∧
      ∀ t₁ t₂ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op E),
        ∃ c₁ c₂ : ℚ_[ℓ], (c₁ ≠ 0 ∨ c₂ ≠ 0) ∧
          ((wcRqScalar D.f ℓ (n - 1) c₁).hom.app (Opposite.op E)).hom t₁ +
            ((wcRqScalar D.f ℓ (n - 1) c₂).hom.app (Opposite.op E)).hom t₂ ∈
            Set.range ((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom :=
by
  classical

  have hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hbij : Function.Bijective (IsLocalRing.residue L) :=
      ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    let e : L ≃+* IsLocalRing.ResidueField L := RingEquiv.ofBijective _ hbij
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    have hdeg : (p.map (e.symm : IsLocalRing.ResidueField L →+* L)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      intro h
      have := hirr.natDegree_pos
      rw [Polynomial.natDegree_eq_of_degree_eq_some h] at this
      exact lt_irrefl 0 this
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root
      (p.map (e.symm : IsLocalRing.ResidueField L →+* L)) hdeg hsep.map
    refine ⟨e x, ?_⟩
    have := hx.map (f := (e : L →+* IsLocalRing.ResidueField L))
    have hc : ((e : L →+* IsLocalRing.ResidueField L).comp
        (e.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
      ext y; simp
    rw [Polynomial.map_map, hc, Polynomial.map_id] at this
    exact this
  haveI := hres

  obtain ⟨Φ, hΦsc, hΦnat⟩ := wc_pencil_Rq_hm_comparison F' F'' Y n D ℓ
  have hV₀p : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local _ V₀ A₀ e₀
  have hEp : Projective (wcFreeSheaf (wcP1Over F'').left E) :=
    wc_proet_free_projective_strict_local _ E L eE
  obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists ((wcProEtPullback D.f).map a₀).left ℓ
  choose Dk hDk using fun k : ℕ =>
    wc_zmod_pull_data_exists ((wcProEtPullback D.f).map a₀).left (ℓ ^ k)
  obtain ⟨hc1, hq1, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V₀ A₀ e₀
  obtain ⟨hc2, hq2, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D E L eE
  haveI := hc1
  haveI := hq1
  haveI := hc2
  haveI := hq2
  have hfY : ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt ((wcProEtPullback D.f).obj V₀).left (ℓ ^ k) (n - 1 - 1)) :=
    fun k hk => (wc_pencil_PL_sp_zmod_finite F' F'' Y n D ℓ hℓ V₀ A₀ e₀ E L eE k
      (n - 1 - 1) hk).1
  have hfT : ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt ((wcProEtPullback D.f).obj E).left (ℓ ^ k) (n - 1 - 1)) :=
    fun k hk => (wc_pencil_PL_sp_zmod_finite F' F'' Y n D ℓ hℓ V₀ A₀ e₀ E L eE k
      (n - 1 - 1) hk).2
  have hinj : ∀ k : ℕ, 1 ≤ k → Function.Injective (wcZModPull (Dk k) (n - 1)) :=
    fun k hk => wc_pencil_PL_sp_torsion_injective F' F'' Y n hn hn2 D ℓ hℓ i V₀ A₀ e₀ hV₀
      E a₀ L eE hE k hk (Dk k) (hDk k)
  have hcyc := fun k (hk : 1 ≤ k) =>
    wc_pencil_PL_sp_torsion_coker_cyclic F' F'' Y n hn hn2 D ℓ hℓ i V₀ A₀ e₀ hV₀
      E a₀ L eE hE k hk (Dk k) (hDk k)
  have hpinj := wc_ladic_pull_injective_of_torsion ℓ ((wcProEtPullback D.f).map a₀).left
    Da hDa Dk hDk (n - 1) hfY hinj
  have hpcod := wc_ladic_pull_codim_one_of_torsion ℓ ((wcProEtPullback D.f).map a₀).left
    Da hDa Dk hDk (n - 1) hfT hinj hcyc
  have hnat : ∀ y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₀),
      Φ (n - 1) E hEp (((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom y) =
        wcHMPull Da (n - 1) (Φ (n - 1) V₀ hV₀p y) :=
    fun y => hΦnat (n - 1) V₀ E hV₀p hEp a₀ Da hDa y
  refine ⟨fun y y' h => ?_, fun t₁ t₂ => ?_⟩
  ·
    apply (Φ (n - 1) V₀ hV₀p).injective
    apply hpinj
    rw [← hnat, ← hnat, h]
  ·
    obtain ⟨c₁, c₂, hne, x, hx⟩ := hpcod (Φ (n - 1) E hEp t₁) (Φ (n - 1) E hEp t₂)
    refine ⟨c₁, c₂, hne, (Φ (n - 1) V₀ hV₀p).symm x, ?_⟩
    apply (Φ (n - 1) E hEp).injective
    rw [hnat, AddEquiv.apply_symm_apply, hx, map_add, hΦsc, hΦsc]

theorem wc_skc_chart_factor (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [IsLocalRing A]
    (e : V₀.left ≅ Spec (.of A))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F'')) :
    ∃ (c : F'') (ψ : Polynomial F'' →+* A) (j : Spec (.of (Polynomial F'')) ⟶ (wcP1Over F'').left),
      IsOpenImmersion j ∧
      e.inv ≫ V₀.hom = Spec.map (CommRingCat.ofHom ψ) ≫ j ∧
      @Algebra.WeaklyEtale (Polynomial F'') A _ _ ψ.toAlgebra ∧
      ∀ v : V₀.left, V₀.hom v ∈ closure {u0 (IsLocalRing.closedPoint F'')} ↔
        ψ (Polynomial.X - Polynomial.C c) ∈ (e.hom v).asIdeal :=
by
  classical

  have hx₀top : u0 (IsLocalRing.closedPoint F'') ∈ (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) := by
    rw [wc_pp_basicOpen_cover F'' 1]
    first
    | trivial
    | simp
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx₀top
  obtain ⟨eW, heW⟩ := wc_projK_one_affine_chart F'' a
  obtain ⟨j, hjdef⟩ : ∃ j : Spec (.of (Polynomial F'')) ⟶ (wcP1Over F'').left,
      j = eW.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι := ⟨_, rfl⟩
  haveI hjI : IsOpenImmersion j := by rw [hjdef]; infer_instance
  have hjS : j ≫ (wcP1Over F'').hom = Spec.map (CommRingCat.ofHom Polynomial.C) := by
    have h1 : j ≫ (wcP1Over F'').hom = eW.inv ≫ ((@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι ≫ wcProjKStr F'' 1) := by
      rw [hjdef]; exact Category.assoc _ _ _
    rw [h1, ← heW, Iso.inv_hom_id_assoc, Polynomial.algebraMap_eq]
  have hx₀ : u0 (IsLocalRing.closedPoint F'') ∈ Set.range j := by
    refine ⟨eW.hom ⟨_, ha⟩, ?_⟩
    rw [hjdef, Scheme.Hom.comp_apply]
    first
    | exact (congrArg (fun z => (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι z) (Scheme.hom_inv_apply eW _)).trans (Scheme.Opens.ι_apply _ _)
    | (erw [Scheme.hom_inv_apply]; rfl)
    | simp

  have hloc : ∀ (B : Type u) [CommRing B] [IsLocalRing B]
      (f : Spec (.of B) ⟶ (wcP1Over F'').left),
      f (IsLocalRing.closedPoint B) ∈ Set.range j → Set.range f ⊆ Set.range j := by
    intro B _ _ f hf
    rintro _ ⟨p, rfl⟩
    exact ((IsLocalRing.specializes_closedPoint p).map f.continuous).mem_open
      j.isOpenEmbedding.isOpen_range hf

  have hfr : Set.range (e.inv ≫ V₀.hom) ⊆ Set.range j :=
    hloc A (e.inv ≫ V₀.hom) (by
      convert hx₀ using 1
      exact (Scheme.Hom.comp_apply _ _ _).trans hv)
  obtain ⟨G, hG⟩ : ∃ G : Spec (.of A) ⟶ Spec (.of (Polynomial F'')), G ≫ j = e.inv ≫ V₀.hom :=
    ⟨IsOpenImmersion.lift j _ hfr, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Polynomial F'' →+* A, Spec.map (CommRingCat.ofHom ψ) = G :=
    ⟨(Spec.preimage G).hom, by rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage _⟩
  have hfac : e.inv ≫ V₀.hom = Spec.map (CommRingCat.ofHom ψ) ≫ j := by
    rw [hψ]; exact hG.symm

  have hfW : WeaklyEtale (e.inv ≫ V₀.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ (etale_le_weaklyEtale _ _ _ inferInstance) V₀.prop
  have hW1 : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ) ≫ j) := by
    first
    | exact hfac ▸ hfW
    | (rw [← hfac]; exact hfW)
  haveI : WeaklyEtale j := etale_le_weaklyEtale _ _ _ inferInstance
  haveI := hW1
  have hW2 : WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) := WeaklyEtale.of_comp _ j
  have hG3 := wc_lpkt_specMap_weaklyEtale_ring _ _ ψ hW2

  have hu0r : Set.range u0 ⊆ Set.range j := hloc F'' u0 hx₀
  obtain ⟨G₀, hG₀⟩ : ∃ G₀ : Spec (.of F'') ⟶ Spec (.of (Polynomial F'')), G₀ ≫ j = u0 :=
    ⟨IsOpenImmersion.lift j _ hu0r, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨γ, hγ⟩ : ∃ γ : Polynomial F'' →+* F'', Spec.map (CommRingCat.ofHom γ) = G₀ :=
    ⟨(Spec.preimage G₀).hom, by rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage _⟩
  have hsec : Spec.map (CommRingCat.ofHom γ) ≫
      Spec.map (CommRingCat.ofHom (Polynomial.C : F'' →+* Polynomial F'')) = 𝟙 _ := by
    rw [hγ, ← hjS, ← Category.assoc, hG₀, hu0]
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← Spec.map_id (CommRingCat.of F'')] at hsec
  have hγC0 := congrArg CommRingCat.Hom.hom (Spec.map_injective hsec)
  rw [CommRingCat.hom_ofHom, CommRingCat.hom_id] at hγC0
  have hγC : ∀ x : F'', γ (Polynomial.C x) = x := fun x => RingHom.congr_fun hγC0 x
  obtain ⟨c, hc⟩ : ∃ c : F'', γ Polynomial.X = c := ⟨_, rfl⟩
  have hγev : γ = Polynomial.evalRingHom c := by
    apply Polynomial.ringHom_ext
    · intro x
      rw [hγC, Polynomial.coe_evalRingHom, Polynomial.eval_C]
    · rw [hc, Polynomial.coe_evalRingHom, Polynomial.eval_X]
  have hy₀ : (G₀ (IsLocalRing.closedPoint F'')).asIdeal =
      Ideal.span {Polynomial.X - Polynomial.C c} := by
    rw [← hγ]
    have h1 : ((Spec.map (CommRingCat.ofHom γ)) (IsLocalRing.closedPoint F'')).asIdeal =
        Ideal.comap γ (IsLocalRing.maximalIdeal F'') := by
      first
      | rfl
      | (erw [Spec.map_apply]; rfl)
    refine h1.trans ?_
    rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot, hγev,
      Polynomial.ker_evalRingHom]
  have key : ∀ y₀ y : PrimeSpectrum (Polynomial F''),
      y ∈ closure ({y₀} : Set (PrimeSpectrum (Polynomial F''))) ↔ y₀.asIdeal ≤ y.asIdeal :=
    fun y₀ y => (PrimeSpectrum.le_iff_mem_closure y₀ y).symm.trans
      (PrimeSpectrum.asIdeal_le_asIdeal _ _).symm
  have hclos : ∀ y : Spec (.of (Polynomial F'')),
      y ∈ closure {G₀ (IsLocalRing.closedPoint F'')} ↔
        Polynomial.X - Polynomial.C c ∈ y.asIdeal := by
    intro y
    refine (key (G₀ (IsLocalRing.closedPoint F'')) y).trans ?_
    rw [hy₀, Ideal.span_singleton_le_iff_mem]

  have hind := j.isOpenEmbedding.isInducing
  have htr : ∀ y : Spec (.of (Polynomial F'')),
      j y ∈ closure {j (G₀ (IsLocalRing.closedPoint F''))} ↔
        y ∈ closure {G₀ (IsLocalRing.closedPoint F'')} := by
    intro y
    rw [hind.closure_eq_preimage_closure_image {G₀ (IsLocalRing.closedPoint F'')},
      Set.image_singleton, Set.mem_preimage]
  have hx0eq : j (G₀ (IsLocalRing.closedPoint F'')) = u0 (IsLocalRing.closedPoint F'') := by
    rw [← hG₀]
    exact (Scheme.Hom.comp_apply _ _ _).symm
  refine ⟨c, ψ, j, hjI, hfac, hG3, ?_⟩
  intro v
  have hv1 : V₀.hom v = j (Spec.map (CommRingCat.ofHom ψ) (e.hom v)) := by
    have h1 : (e.inv ≫ V₀.hom) (e.hom v) = (Spec.map (CommRingCat.ofHom ψ) ≫ j) (e.hom v) := by
      rw [hfac]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Scheme.hom_inv_apply] at h1
    exact h1
  have hy : (Spec.map (CommRingCat.ofHom ψ) (e.hom v)).asIdeal =
      Ideal.comap ψ (e.hom v).asIdeal := by
    first
    | rfl
    | (erw [Spec.map_apply]; rfl)
  have H : j (Spec.map (CommRingCat.ofHom ψ) (e.hom v)) ∈
      closure {j (G₀ (IsLocalRing.closedPoint F''))} ↔
        ψ (Polynomial.X - Polynomial.C c) ∈ (e.hom v).asIdeal := by
    refine (htr _).trans ((hclos _).trans ?_)
    rw [hy, Ideal.mem_comap]
  rw [hv1, ← hx0eq]
  exact H

theorem wc_skc_dvr : ∀ (k A : Type u) [Field k] [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (c : k) (ψ : Polynomial k →+* A),
    @Algebra.WeaklyEtale (Polynomial k) A _ _ ψ.toAlgebra →
    ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A →
    IsDomain A ∧ ψ (Polynomial.X - Polynomial.C c) ≠ 0 ∧
    ∀ a : A, a ≠ 0 → ∃ (u : Aˣ) (n : ℕ), a = u * ψ (Polynomial.X - Polynomial.C c) ^ n :=
by
  intro k A _ _ _ _ c ψ hW hϖm
  classical

  have testC : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      [IsNoetherianRing R] (π : R), IsLocalRing.maximalIdeal R = Ideal.span {π} →
      ∀ x : R, x ≠ 0 → ∃ (w : Rˣ) (n : ℕ), x = w * π ^ n := by
    intro R _ _ _ π hm x hx0
    have hKrull : ⨅ i : ℕ, (IsLocalRing.maximalIdeal R) ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hex : ∃ N : ℕ, x ∉ (IsLocalRing.maximalIdeal R) ^ N := by
      by_contra h
      apply hx0
      have h' : ∀ i : ℕ, x ∈ (IsLocalRing.maximalIdeal R) ^ i := fun i => by
        by_contra hi
        exact h ⟨i, hi⟩
      have hmem : x ∈ ⨅ i : ℕ, (IsLocalRing.maximalIdeal R) ^ i := Submodule.mem_iInf _ |>.mpr h'
      rw [hKrull] at hmem
      exact (Submodule.mem_bot _).mp hmem
    have hN : x ∉ (IsLocalRing.maximalIdeal R) ^ Nat.find hex := Nat.find_spec hex
    have hmin : ∀ j < Nat.find hex, x ∈ (IsLocalRing.maximalIdeal R) ^ j :=
      fun j hj => not_not.mp (Nat.find_min hex hj)
    generalize Nat.find hex = N at hN hmin
    have hN0 : N ≠ 0 := by
      intro h
      apply hN
      rw [h, pow_zero, Ideal.one_eq_top]
      first
      | exact Submodule.mem_top
      | trivial
      | simp
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hN0
    have hxn := hmin n (Nat.lt_succ_self n)
    rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hxn
    obtain ⟨y, hy⟩ := hxn
    have hyu : IsUnit y := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hy'
      apply hN
      rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
      rw [hm, Ideal.mem_span_singleton'] at hy'
      obtain ⟨z, hz⟩ := hy'
      exact ⟨z, by rw [← hy, ← hz, pow_succ]; ring⟩
    exact ⟨hyu.unit, n, by rw [IsUnit.unit_spec, ← hy]⟩

  have testB : ∀ (E : Type u) [CommRing E]
      [Algebra (Polynomial k) E] [Algebra.Etale (Polynomial k) E] (q : Ideal E) [q.IsPrime],
      algebraMap (Polynomial k) E (Polynomial.X - Polynomial.C c) ∈ q →
      IsNoetherianRing (Localization.AtPrime q) ∧
      IsLocalRing.maximalIdeal (Localization.AtPrime q) =
        Ideal.span {algebraMap (Polynomial k) (Localization.AtPrime q)
          (Polynomial.X - Polynomial.C c)} := by
    intro E _ _ _ q hq htE
    haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing (Polynomial k) E
    have hnoeth : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
    refine ⟨hnoeth, ?_⟩
    have hpmax : (Ideal.span {Polynomial.X - Polynomial.C c} : Ideal (Polynomial k)).IsMaximal := by
      rw [← Polynomial.ker_evalRingHom]
      exact RingHom.ker_isMaximal_of_surjective _ (fun x => ⟨Polynomial.C x, by simp⟩)
    haveI : (Ideal.span {Polynomial.X - Polynomial.C c} : Ideal (Polynomial k)).IsPrime :=
      hpmax.isPrime
    haveI hlies : q.LiesOver (Ideal.span {Polynomial.X - Polynomial.C c}) := by
      constructor
      have hle : (Ideal.span {Polynomial.X - Polynomial.C c} : Ideal (Polynomial k)) ≤
          q.under (Polynomial k) := by
        rw [Ideal.span_singleton_le_iff_mem, Ideal.under, Ideal.mem_comap]
        exact htE
      have hne : q.under (Polynomial k) ≠ ⊤ := by
        intro h
        apply hq.ne_top
        rw [Ideal.eq_top_iff_one] at h ⊢
        rw [Ideal.under, Ideal.mem_comap, map_one] at h
        exact h
      exact hpmax.eq_of_le hne hle
    haveI : Algebra.FormallyUnramified E (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    haveI : Algebra.FormallyUnramified (Polynomial k) (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.comp (Polynomial k) E (Localization.AtPrime q)
    letI : Algebra (Localization.AtPrime (Ideal.span {Polynomial.X - Polynomial.C c}))
        (Localization.AtPrime q) :=
      Localization.AtPrime.instAlgebraOfLiesOver (Ideal.span {Polynomial.X - Polynomial.C c}) q
    haveI : IsScalarTower (Polynomial k)
        (Localization.AtPrime (Ideal.span {Polynomial.X - Polynomial.C c}))
        (Localization.AtPrime q) :=
      Localization.AtPrime.instIsScalarTower (Ideal.span {Polynomial.X - Polynomial.C c}) q
    have hmap := (Algebra.isUnramifiedAt_iff_map_eq (Polynomial k)
      (Ideal.span {Polynomial.X - Polynomial.C c}) q).mp ‹_›
    rw [← hmap.2, Ideal.map_span, Set.image_singleton]
  letI : Algebra (Polynomial k) A := ψ.toAlgebra

  have hflat : Module.Flat (Polynomial k) A :=
    Algebra.WeaklyEtale.flat (R := Polynomial k) (S := A)
  have hreg : IsSMulRegular A (Polynomial.X - Polynomial.C c) :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero (Polynomial.X_sub_C_ne_zero c))
  have hreg1 : ∀ a : A, ψ (Polynomial.X - Polynomial.C c) * a = 0 → a = 0 := by
    intro a ha
    have h2 : (Polynomial.X - Polynomial.C c) • a =
        (Polynomial.X - Polynomial.C c) • (0 : A) := by
      rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      exact ha
    exact hreg h2
  have hregn : ∀ n : ℕ, ∀ a : A, ψ (Polynomial.X - Polynomial.C c) ^ n * a = 0 → a = 0 := by
    intro n
    induction n with
    | zero => intro a ha; simpa using ha
    | succ n ih =>
      intro a ha
      apply ih
      apply hreg1
      rw [← mul_assoc, ← pow_succ']
      exact ha
  have hpow_ne : ∀ n : ℕ, ψ (Polynomial.X - Polynomial.C c) ^ n ≠ 0 := fun n h =>
    one_ne_zero (hregn n 1 (by rw [h, zero_mul]))

  have hnf : ∀ a : A, a ≠ 0 →
      ∃ (u : Aˣ) (n : ℕ), a = u * ψ (Polynomial.X - Polynomial.C c) ^ n := by
    intro a₀ ha₀
    obtain ⟨E, _, _, hE, β, e, hβ, he⟩ :=
      wc_lpkt_indetale_factor (Polynomial k) A ψ hW 1 (fun _ => a₀)
    have hβt : β (algebraMap (Polynomial k) E (Polynomial.X - Polynomial.C c)) =
        ψ (Polynomial.X - Polynomial.C c) := by
      have := RingHom.congr_fun hβ (Polynomial.X - Polynomial.C c)
      rwa [RingHom.comp_apply] at this
    obtain ⟨q, hqdef⟩ : ∃ q : Ideal E, q = Ideal.comap β (IsLocalRing.maximalIdeal A) :=
      ⟨_, rfl⟩
    haveI hq : q.IsPrime := by rw [hqdef]; exact Ideal.IsPrime.comap β
    have htE : algebraMap (Polynomial k) E (Polynomial.X - Polynomial.C c) ∈ q := by
      rw [hqdef, Ideal.mem_comap, hβt]
      exact hϖm
    obtain ⟨hnoeth, hm⟩ := testB E q htE
    have hkey : ∀ z : E, z ∉ q → IsUnit (β z) := by
      intro z hz
      rw [hqdef, Ideal.mem_comap] at hz
      exact IsLocalRing.notMem_maximalIdeal.mp hz
    have hg : ∀ y : q.primeCompl, IsUnit (β y) := fun y => hkey (y : E) y.2
    let βL : Localization.AtPrime q →+* A :=
      IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hg
    have hβL : ∀ x, βL (algebraMap E (Localization.AtPrime q) x) = β x :=
      IsLocalization.lift_eq hg
    have hπ : βL (algebraMap (Polynomial k) (Localization.AtPrime q)
        (Polynomial.X - Polynomial.C c)) = ψ (Polynomial.X - Polynomial.C c) := by
      rw [IsScalarTower.algebraMap_apply (Polynomial k) E (Localization.AtPrime q), hβL, hβt]
    have he0 : β (e 0) = a₀ := he 0
    have hx0 : algebraMap E (Localization.AtPrime q) (e 0) ≠ 0 := by
      intro h
      apply ha₀
      rw [← he0, ← hβL, h, map_zero]
    obtain ⟨w, n, hw⟩ := testC (Localization.AtPrime q) _ hm _ hx0
    refine ⟨(w.isUnit.map βL).unit, n, ?_⟩
    rw [IsUnit.unit_spec, ← hπ, ← map_pow, ← map_mul, ← hw, hβL, he0]

  have hdom : IsDomain A := by
    have hnzd : NoZeroDivisors A := ⟨fun {a b} hab => by
      by_contra h
      rcases not_or.mp h with ⟨ha, hb⟩
      obtain ⟨u, n, hu⟩ := hnf a ha
      obtain ⟨v, m, hv⟩ := hnf b hb
      apply hpow_ne (n + m)
      have h3 : ((u * v : Aˣ) : A) * ψ (Polynomial.X - Polynomial.C c) ^ (n + m) = 0 := by
        rw [← hab, hu, hv, Units.val_mul, pow_add]
        ring
      exact (u * v).isUnit.mul_right_eq_zero.mp h3⟩
    exact NoZeroDivisors.to_isDomain A
  exact ⟨hdom, by simpa using hpow_ne 1, hnf⟩

theorem wc_P1_shens_punct_subsingleton (K : Type u) [Field K]
    (s : Spec (.of K) ⟶ (wcP1Over K).left) (hs : s ≫ (wcP1Over K).hom = 𝟙 _)
    (V : (wcP1Over K).left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = s (IsLocalRing.closedPoint K)) :
    ∃ (V₀ : (wcP1Over K).left.ProEt) (j : V₀ ⟶ V), IsOpenImmersion j.left ∧
      Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ ∧ ∀ x y : V₀.left, x = y :=
by
  classical
  obtain ⟨c, ψ, j', _, _, hψ, hcl⟩ := wc_skc_chart_factor K s hs V A e hV
  have hϖ : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    have h1 := (hcl (e.inv (IsLocalRing.closedPoint A))).mp
      (by rw [hV]; exact subset_closure (Set.mem_singleton _))
    have key : (e.hom (e.inv (IsLocalRing.closedPoint A))).asIdeal =
        IsLocalRing.maximalIdeal A :=
      congrArg PrimeSpectrum.asIdeal (Scheme.inv_hom_apply e _)
    rw [key] at h1
    exact h1
  obtain ⟨_, _, hNF⟩ := wc_skc_dvr K A c ψ hψ hϖ

  have hdich : ∀ P : Ideal A, P.IsPrime → P ≠ IsLocalRing.maximalIdeal A → P = ⊥ := by
    intro P hP hne
    by_cases hϖP : ψ (Polynomial.X - Polynomial.C c) ∈ P
    · exfalso
      apply hne
      apply le_antisymm (IsLocalRing.le_maximalIdeal hP.ne_top)
      intro a ha
      by_cases ha0 : a = 0
      · rw [ha0]; exact P.zero_mem
      obtain ⟨u, n, rfl⟩ := hNF a ha0
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        exfalso
        rw [pow_zero, mul_one] at ha
        exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp ha) u.isUnit
      · exact P.mul_mem_left _ (P.pow_mem_of_mem hϖP n hn)
    · rw [Submodule.eq_bot_iff]
      intro a ha
      by_contra ha0
      obtain ⟨u, n, rfl⟩ := hNF a ha0
      apply hϖP
      apply hP.mem_of_pow_mem n
      have hrw : ψ (Polynomial.X - Polynomial.C c) ^ n =
          ((u⁻¹ : Aˣ) : A) * ((u : A) * ψ (Polynomial.X - Polynomial.C c) ^ n) := by
        rw [Units.inv_mul_cancel_left]
      rw [hrw]
      exact P.mul_mem_left _ ha

  have hclosed : IsClosed ({e.inv (IsLocalRing.closedPoint A)} : Set V.left) := by
    have hset : ({e.inv (IsLocalRing.closedPoint A)} : Set V.left) =
        (⇑e.hom) ⁻¹' {IsLocalRing.closedPoint A} := by
      ext x
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact Scheme.inv_hom_apply e _
      · intro h
        exact (Scheme.hom_inv_apply e x).symm.trans (congrArg (fun y => e.inv y) h)
    rw [hset]
    exact (IsLocalRing.isClosed_singleton_closedPoint A).preimage e.hom.continuous
  let O : V.left.Opens := ⟨{e.inv (IsLocalRing.closedPoint A)}ᶜ, hclosed.isOpen_compl⟩
  have hW : WeaklyEtale (O.ι ≫ V.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _
      (etale_le_weaklyEtale _ _ _ inferInstance) V.prop
  let V₀ : (wcP1Over K).left.ProEt := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) hW
  let j : V₀ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
  have hrange : Set.range O.ι = {e.inv (IsLocalRing.closedPoint A)}ᶜ := by
    rw [Scheme.Opens.range_ι]
    rfl
  have hpt : ∀ z : O.toScheme, (e.hom (O.ι z)).asIdeal = ⊥ := by
    intro z
    have hz : O.ι z ≠ e.inv (IsLocalRing.closedPoint A) := by
      have hmem : O.ι z ∈ Set.range O.ι := ⟨z, rfl⟩
      rw [hrange] at hmem
      exact hmem
    apply hdich _ (e.hom (O.ι z)).isPrime
    intro h
    apply hz
    have hcp : e.hom (O.ι z) = IsLocalRing.closedPoint A := PrimeSpectrum.ext h
    exact (Scheme.hom_inv_apply e _).symm.trans (congrArg (fun y => e.inv y) hcp)
  refine ⟨V₀, j, ?_, ?_, ?_⟩
  · show IsOpenImmersion O.ι
    infer_instance
  · exact hrange
  · intro x y
    have h1 : e.hom (O.ι x) = e.hom (O.ι y) := PrimeSpectrum.ext ((hpt x).trans (hpt y).symm)
    have h2 : O.ι x = O.ι y :=
      (Scheme.hom_inv_apply e _).symm.trans
        ((congrArg (fun y => e.inv y) h1).trans (Scheme.hom_inv_apply e _))
    exact O.ι.injective h2

theorem wc_proet_sep_point_descent (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W)
    (V₀ E : S.ProEt) (a : E ⟶ V₀) (c : E ⟶ W)
    (ha : ∀ y : V₀.left, ∃ x : E.left, a.left x = y)
    (L : Type u) [Field L] [IsSepClosed L] (eL : E.left ≅ Spec (.of L))
    (t : G.obj.obj (Opposite.op E))
    (ht : ∀ τ : E ⟶ E, τ ≫ a = a → (G.obj.map τ.op).hom t = t) :
    ∃ y : G.obj.obj (Opposite.op V₀), (G.obj.map a.op).hom y = t :=
by
  classical

  have hEsub : Subsingleton E.left := by
    refine ⟨fun x y => ?_⟩
    have h1 : eL.hom x = eL.hom y := Subsingleton.elim _ _
    have h2 := congrArg (fun p => eL.inv p) h1
    simp only [Scheme.hom_inv_apply] at h2
    exact h2
  haveI hV₀sub : Subsingleton V₀.left := by
    refine ⟨fun y y' => ?_⟩
    obtain ⟨x, rfl⟩ := ha y
    obtain ⟨x', rfl⟩ := ha y'
    rw [Subsingleton.elim x x']
  haveI : QuasiSeparatedSpace V₀.left :=
    QuasiSeparatedSpace.mk (fun _ _ _ _ _ _ => Set.subsingleton_of_subsingleton.isCompact)
  haveI : IsAffine E.left := IsAffine.of_isIso eL.hom

  have hcov : Sieve.generate (Presieve.singleton a) ∈ Scheme.ProEt.topology S V₀ := by
    have h := proet_finite_affine_jointly_surjective_covers S V₀ 1 (fun _ => E) (fun _ => a)
      (fun _ => inferInstance) (fun x => ⟨0, ha x⟩)
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_) h
    rintro Y f ⟨i⟩
    exact Presieve.singleton.mk

  have hsheaf : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) G.obj
        (forget AddCommGrpCat)).mp G.property)

  have hfun : ∀ {X Y Y' : S.ProEt} (f : X ⟶ Y) (g : Y ⟶ Y') (s : G.obj.obj (Opposite.op Y')),
      (G.obj.map f.op).hom ((G.obj.map g.op).hom s) = (G.obj.map (f ≫ g).op).hom s := by
    intro X Y Y' f g s
    rw [op_comp, Functor.map_comp]
    rfl

  have hθinj : ∀ (Z : S.ProEt) (b : Z ⟶ W) (y₁ y₂ : G.obj.obj (Opposite.op Z)),
      (∀ z : Z.left, (show C(↥Z.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y₁).down) z =
        (show C(↥Z.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y₂).down) z) → y₁ = y₂ := by
    intro Z b y₁ y₂ h
    have hcancel1 : ∀ (s : G.obj.obj (Opposite.op Z)),
        (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom s) = s :=
      fun s => congrArg (fun m => (m.hom.app (Opposite.op (Over.mk b))).hom s) θ.hom_inv_id
    have e1 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom y₁ =
        (θ.hom.hom.app (Opposite.op (Over.mk b))).hom y₂ := by
      apply ULift.ext
      apply ContinuousMap.ext
      exact h
    have := congrArg (θ.inv.hom.app (Opposite.op (Over.mk b))).hom e1
    exact (hcancel1 y₁).symm.trans (this.trans (hcancel1 y₂))

  have hnat : ∀ (Z : S.ProEt) (b : Z ⟶ W) (Zz : S.ProEt) (ζ : Zz ⟶ Z)
      (y : G.obj.obj (Opposite.op Z)) (pt : Zz.left),
      (show C(↥Zz.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (ζ ≫ b)))).hom ((G.obj.map ζ.op).hom y)).down) pt =
      (show C(↥Z.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y).down) (ζ.left pt) := by
    intro Z b Zz ζ y pt
    have h : (θ.hom.hom.app (Opposite.op (Over.mk (ζ ≫ b)))).hom
        (((G.over W).obj.map (Over.homMk ζ rfl : Over.mk (ζ ≫ b) ⟶ Over.mk b).op).hom y) =
        ((((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map
          (Over.homMk ζ rfl : Over.mk (ζ ≫ b) ⟶ Over.mk b).op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y)) :=
      congrArg (fun m => m.hom y)
        (θ.hom.hom.naturality (Over.homMk ζ rfl : Over.mk (ζ ≫ b) ⟶ Over.mk b).op)
    have h2 := congrArg (fun y : ULift.{u+1} C(↥Zz.left, Fin r → ℚ_[ℓ]) => y.down pt) h
    refine h2.trans ?_
    rfl

  have hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    let e : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L)
        ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root (p.map (e.symm : IsLocalRing.ResidueField L →+* L))
      (by
        rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
        exact hirr.degree_pos.ne')
      hsep.map
    refine ⟨e x, ?_⟩
    have h1 : Polynomial.eval x (p.map (e.symm : IsLocalRing.ResidueField L →+* L)) = 0 := hx
    rw [Polynomial.eval_map] at h1
    have h2 := congrArg (e : L →+* IsLocalRing.ResidueField L) h1
    rw [map_zero] at h2
    have h3 : (e : L →+* IsLocalRing.ResidueField L)
        (Polynomial.eval₂ (e.symm : IsLocalRing.ResidueField L →+* L) x p) =
        Polynomial.eval (e x) p := by
      rw [Polynomial.hom_eval₂, RingEquiv.comp_symm]
      rfl
    rw [← h3]
    exact h2

  have holiv : ∀ (O : CommRingCat.{u}) [IsLocalRing O] (φ : CommRingCat.of L ⟶ O),
      WeaklyEtale (Spec.map φ) → Function.Bijective φ.hom := by
    intro O _ φ hφ
    have hwe := wc_lpkt_specMap_weaklyEtale_ring L O φ.hom hφ
    letI : Algebra L O := φ.hom.toAlgebra
    exact wc_olivier L O (Field.henselian L) hres inferInstance hwe
  haveI hEet : WeaklyEtale E.hom := E.prop
  have hpk : ∀ (Z : S.ProEt) (p : Z ⟶ E), WeaklyEtale p.left := by
    intro Z p
    haveI : WeaklyEtale Z.hom := Z.prop
    haveI : WeaklyEtale (p.left ≫ E.hom) := by
      rw [MorphismProperty.Over.w p]
      exact Z.prop
    exact WeaklyEtale.of_comp p.left E.hom

  have hcomp : ∀ {Z : S.ProEt} (p₁ p₂ : Z ⟶ E), p₁ ≫ a = p₂ ≫ a →
      (G.obj.map p₁.op).hom t = (G.obj.map p₂.op).hom t := by
    intro Z p₁ p₂ hp

    have twist : ∀ z : Z.left, ∃ (Zz : S.ProEt) (ζ : Zz ⟶ Z) (pt : Zz.left), ζ.left pt = z ∧
        (G.obj.map ζ.op).hom ((G.obj.map p₁.op).hom t) =
          (G.obj.map ζ.op).hom ((G.obj.map p₂.op).hom t) := by
      intro z
      haveI : WeaklyEtale (Z.left.fromSpecStalk z) := wc_lfi_fromSpecStalk_weaklyEtale Z.left z
      haveI : WeaklyEtale Z.hom := Z.prop
      haveI : WeaklyEtale p₁.left := hpk Z p₁
      haveI : WeaklyEtale p₂.left := hpk Z p₂
      obtain ⟨φ₁, hq₁⟩ : ∃ φ : CommRingCat.of L ⟶ Z.left.presheaf.stalk z,
          Spec.map φ = Z.left.fromSpecStalk z ≫ p₁.left ≫ eL.hom := ⟨_, Spec.map_preimage _⟩
      obtain ⟨φ₂, hq₂⟩ : ∃ φ : CommRingCat.of L ⟶ Z.left.presheaf.stalk z,
          Spec.map φ = Z.left.fromSpecStalk z ≫ p₂.left ≫ eL.hom := ⟨_, Spec.map_preimage _⟩
      have hb₁ : Function.Bijective φ₁.hom := holiv _ φ₁ (by rw [hq₁]; infer_instance)
      have hb₂ : Function.Bijective φ₂.hom := holiv _ φ₂ (by rw [hq₂]; infer_instance)
      let σ : L →+* L := (RingEquiv.ofBijective φ₁.hom hb₁).symm.toRingHom.comp φ₂.hom
      have hσ : φ₁.hom.comp σ = φ₂.hom := by
        ext x
        show φ₁.hom ((RingEquiv.ofBijective φ₁.hom hb₁).symm (φ₂.hom x)) = φ₂.hom x
        rw [← RingEquiv.ofBijective_apply φ₁.hom hb₁, RingEquiv.apply_symm_apply]
      have hσ' : CommRingCat.ofHom σ ≫ φ₁ = φ₂ := by
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
        exact hσ
      let τl : E.left ⟶ E.left := eL.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eL.inv
      have K1 : Z.left.fromSpecStalk z ≫ p₁.left ≫ τl = Z.left.fromSpecStalk z ≫ p₂.left := by
        have e1 : Z.left.fromSpecStalk z ≫ p₁.left ≫ τl =
            (Z.left.fromSpecStalk z ≫ p₁.left ≫ eL.hom) ≫
              Spec.map (CommRingCat.ofHom σ) ≫ eL.inv := by
          simp only [τl, Category.assoc]
        rw [e1, ← hq₁, ← Category.assoc, ← Spec.map_comp, hσ', hq₂]
        simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
      have hg₁ : Z.left.fromSpecStalk z ≫ p₁.left = Spec.map φ₁ ≫ eL.inv := by
        rw [hq₁]
        simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
      haveI : IsIso φ₁ := (ConcreteCategory.isIso_iff_bijective φ₁).mpr hb₁
      haveI : Epi (Z.left.fromSpecStalk z ≫ p₁.left) := by
        rw [hg₁]
        infer_instance
      have K2 : τl ≫ a.left = a.left := by
        rw [← cancel_epi (Z.left.fromSpecStalk z ≫ p₁.left)]
        calc (Z.left.fromSpecStalk z ≫ p₁.left) ≫ τl ≫ a.left
            = (Z.left.fromSpecStalk z ≫ p₁.left ≫ τl) ≫ a.left := by
              simp only [Category.assoc]
          _ = (Z.left.fromSpecStalk z ≫ p₂.left) ≫ a.left := by rw [K1]
          _ = Z.left.fromSpecStalk z ≫ (p₂ ≫ a).left := by
              rw [Category.assoc]
              rfl
          _ = Z.left.fromSpecStalk z ≫ (p₁ ≫ a).left := by rw [hp]
          _ = (Z.left.fromSpecStalk z ≫ p₁.left) ≫ a.left := by
              rw [Category.assoc]
              rfl
      have K3 : τl ≫ E.hom = E.hom := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, K2]
      let τ : E ⟶ E := MorphismProperty.Over.homMk τl K3 trivial
      have hτa : τ ≫ a = a := MorphismProperty.Over.Hom.ext (by exact K2)
      let Zz : S.ProEt := MorphismProperty.Over.mk ⊤ (Z.left.fromSpecStalk z ≫ Z.hom) inferInstance
      let ζ : Zz ⟶ Z := MorphismProperty.Over.homMk (Z.left.fromSpecStalk z) rfl trivial
      have hcomp' : ζ ≫ p₂ = ζ ≫ p₁ ≫ τ := MorphismProperty.Over.Hom.ext (by exact K1.symm)
      refine ⟨Zz, ζ, IsLocalRing.closedPoint (Z.left.presheaf.stalk z), ?_, ?_⟩
      · exact Scheme.fromSpecStalk_closedPoint
      · rw [hfun, hfun, hcomp', ← Category.assoc, ← hfun (ζ ≫ p₁) τ, ht τ hτa]
    apply hθinj Z (p₁ ≫ c)
    intro z
    obtain ⟨Zz, ζ, pt, hpt, key⟩ := twist z
    have e1 := hnat Z (p₁ ≫ c) Zz ζ ((G.obj.map p₁.op).hom t) pt
    have e2 := hnat Z (p₁ ≫ c) Zz ζ ((G.obj.map p₂.op).hom t) pt
    rw [hpt] at e1 e2
    rw [key] at e1
    exact e1.symm.trans e2

  obtain ⟨y, hy, -⟩ := (Presieve.isSheafFor_singleton.mp (hsheaf.isSheafFor _ hcov)) t
    (fun p₁ p₂ h => hcomp p₁ p₂ h)
  exact ⟨y, hy⟩

theorem wc_mnt_point_map_injective (F'' : Type u) [Field F''] (m : ℕ)
    (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)) (i : Fin m)
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [IsLocalRing A]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin m), E.hom z ≠ S j (IsLocalRing.closedPoint F''))
    (ϖ : A) (hϖ : IsLocalRing.maximalIdeal A = Ideal.span {ϖ})
    (hdvr : ∀ a : A, a ≠ 0 → ∃ (u : Aˣ) (n : ℕ), a = u * ϖ ^ n) :
    Function.Injective (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom :=
by
  classical
  obtain ⟨f, hf⟩ : ∃ f : Spec (.of L) ⟶ Spec (.of A), f = eE.inv ≫ a₀.left ≫ e.hom := ⟨_, rfl⟩
  rw [← hf]
  obtain ⟨φ, hφ⟩ : ∃ φ : A →+* L, φ = (Spec.preimage f).hom := ⟨_, rfl⟩
  rw [← hφ]

  have hfm : f = Spec.map (CommRingCat.ofHom φ) := by
    rw [hφ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hfφ : ∀ x, f x = PrimeSpectrum.comap φ x := by
    intro x
    rw [hfm]
    rfl

  have hϖ' : φ ϖ ≠ 0 := by
    intro hz
    have hker : RingHom.ker φ = IsLocalRing.maximalIdeal A := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top φ)
      · rw [hϖ, Ideal.span_le, Set.singleton_subset_iff]
        exact (RingHom.mem_ker).mpr hz
    have hpt : f (IsLocalRing.closedPoint L) = IsLocalRing.closedPoint A := by
      refine (hfφ _).trans ?_
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      show Ideal.comap φ (IsLocalRing.maximalIdeal L) = IsLocalRing.maximalIdeal A
      rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot, hker]
    have h1 : e.hom (a₀.left (eE.inv (IsLocalRing.closedPoint L))) =
        IsLocalRing.closedPoint A := by
      have h0 := hpt
      rw [hf] at h0
      first
      | exact h0
      | (simp only [Scheme.Hom.comp_apply] at h0; exact h0)
      | simpa using h0
    have h2 : a₀.left (eE.inv (IsLocalRing.closedPoint L)) =
        e.inv (IsLocalRing.closedPoint A) := by
      have h3 := congrArg (fun p => e.inv p) h1
      simp only at h3
      rw [← h3]
      first
      | exact (Scheme.hom_inv_apply e _).symm
      | (rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl)
      | simp
    have hw : a₀.left ≫ V.hom = E.hom := MorphismProperty.Over.w a₀
    have h3 : E.hom (eE.inv (IsLocalRing.closedPoint L)) = S i (IsLocalRing.closedPoint F'') := by
      have h4 := congrArg (fun g : E.left ⟶ (wcP1Over F'').left =>
        g (eE.inv (IsLocalRing.closedPoint L))) hw
      simp only at h4
      rw [← h4, Scheme.Hom.comp_apply, h2, hV]
    exact hE _ i h3

  rw [injective_iff_map_eq_zero]
  intro a ha
  by_contra ha0
  obtain ⟨u, n, rfl⟩ := hdvr a ha0
  rw [map_mul, map_pow] at ha
  have hu : φ u ≠ 0 := (u.isUnit.map φ).ne_zero
  exact mul_ne_zero hu (pow_ne_zero n hϖ') ha

theorem wc_mnt_point_map_weaklyEtale (P : Scheme.{u}) (V E : P.ProEt) (a₀ : E ⟶ V)
    (A L : Type u) [CommRing A] [CommRing L]
    (e : V.left ≅ Spec (.of A)) (eE : E.left ≅ Spec (.of L)) :
    @Algebra.WeaklyEtale A L _ _ (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom.toAlgebra :=
by
  have hE : WeaklyEtale E.hom := E.prop
  have hV : WeaklyEtale V.hom := V.prop
  have hw : a₀.left ≫ V.hom = E.hom := MorphismProperty.Over.w a₀
  have hcomp : WeaklyEtale (a₀.left ≫ V.hom) := by rw [hw]; exact hE
  have ha : WeaklyEtale a₀.left := WeaklyEtale.of_comp a₀.left V.hom
  have h3 : WeaklyEtale (eE.inv ≫ a₀.left ≫ e.hom) := by
    have h1 : (@WeaklyEtale) (a₀.left ≫ e.hom) :=
      (MorphismProperty.cancel_right_of_respectsIso (@WeaklyEtale) a₀.left e.hom).mpr ha
    exact (MorphismProperty.cancel_left_of_respectsIso (@WeaklyEtale) eE.inv
      (a₀.left ≫ e.hom)).mpr h1
  have h4 : Spec.map (CommRingCat.ofHom (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom) =
      eE.inv ≫ a₀.left ≫ e.hom := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have key : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)
  apply key
  rw [h4]
  exact h3

theorem wc_mnt_weaklyEtale_field_isSeparable : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L],
    Algebra.WeaklyEtale K L → Algebra.IsAlgebraic K L → Algebra.IsSeparable K L :=
by
  open TensorProduct in
  · intro K L _ _ _ hWE hAlg
    classical

    have s1 : ∀ α : L, ∃ a : L ⊗[K] L, (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) * a = 0 ∧
        Algebra.TensorProduct.lmul' K a ≠ 0 := by
      intro α
      letI : Algebra (L ⊗[K] L) L :=
        (Algebra.TensorProduct.lmul' K : L ⊗[K] L →ₐ[K] L).toRingHom.toAlgebra
      have hfl : Module.Flat (L ⊗[K] L) L := hWE.flat_lmul'
      have hsmul : ∀ (c : L ⊗[K] L) (x : L), c • x = Algebra.TensorProduct.lmul' K c * x := by
        intro c x; rfl
      have hμδ : Algebra.TensorProduct.lmul' K (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) = 0 := by
        rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul,
          Algebra.TensorProduct.lmul'_apply_tmul, mul_one, one_mul, sub_self]
      have hsum : ∑ i : Fin 1, (fun _ => (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α)) i •
          (fun _ => (1:L)) i = 0 := by
        rw [Fin.sum_univ_one]
        exact (hsmul _ _).trans (by rw [hμδ, zero_mul])
      obtain ⟨k, A, y, hx, hA⟩ := @Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
        (L ⊗[K] L) L _ _ _ hfl (Fin 1) _ _ _ hsum
      have h1 : (1 : L) = ∑ j, A 0 j • y j := hx 0
      have hne : ∑ j, A 0 j • y j ≠ 0 := by rw [← h1]; exact one_ne_zero
      obtain ⟨j, _, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
      refine ⟨A 0 j, ?_, ?_⟩
      · have h2 := hA j
        rw [Fin.sum_univ_one] at h2
        exact h2
      · intro h0
        apply hj
        rw [hsmul, h0, zero_mul]

    have s2 : ∀ (α : L) (a : L ⊗[K] L), (α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) * a = 0 →
        Algebra.TensorProduct.lmul' K a ≠ 0 →
        ∃ s : L ⊗[K] IntermediateField.adjoin K {α},
          (α ⊗ₜ[K] (1 : IntermediateField.adjoin K {α}) -
            (1 : L) ⊗ₜ[K] IntermediateField.AdjoinSimple.gen K α) * s = 0 ∧
          Algebra.TensorProduct.productMap (AlgHom.id K L)
            (IsScalarTower.toAlgHom K (IntermediateField.adjoin K {α}) L) s ≠ 0 := by
      intro α a ha hμ
      set M := IntermediateField.adjoin K {α}
      set gen := IntermediateField.AdjoinSimple.gen K α
      set μ' := Algebra.TensorProduct.productMap (AlgHom.id K L) (IsScalarTower.toAlgHom K M L)
      let b := Module.Basis.ofVectorSpace M L
      let Φ : _ → L ⊗[K] L →ₗ[K] L ⊗[K] M :=
        fun j => LinearMap.lTensor L ((b.coord j).restrictScalars K)
      have hΦtmul : ∀ j x y, Φ j (x ⊗ₜ y) = x ⊗ₜ (b.coord j y) := fun _ _ _ => rfl
      have hgen : algebraMap M L gen = α := IntermediateField.AdjoinSimple.algebraMap_gen K α
      have hA : ∀ j (a : L ⊗[K] L), Φ j ((α ⊗ₜ[K] (1 : L) - (1 : L) ⊗ₜ[K] α) * a) =
          (α ⊗ₜ[K] (1 : M) - (1 : L) ⊗ₜ[K] gen) * Φ j a := by
        intro j a
        induction a using TensorProduct.induction_on with
        | zero => simp
        | tmul x y =>
          rw [sub_mul, sub_mul, Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.TensorProduct.tmul_mul_tmul, map_sub, hΦtmul, hΦtmul, hΦtmul,
            Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul]
          simp only [one_mul]
          have : α * y = gen • y := by rw [Algebra.smul_def, hgen]
          rw [this, LinearMap.map_smul, smul_eq_mul]
        | add x y hx hy => rw [mul_add, map_add, hx, hy, map_add, mul_add]
      have hC : ∀ a : L ⊗[K] L, ∃ T : Finset _, ∀ T' ⊇ T,
          Algebra.TensorProduct.lmul' K a = ∑ j ∈ T', μ' (Φ j a) * b j := by
        intro a
        induction a using TensorProduct.induction_on with
        | zero => exact ⟨∅, fun T' _ => by simp⟩
        | tmul x y =>
          refine ⟨(b.repr y).support, fun T' hT' => ?_⟩
          rw [Algebra.TensorProduct.lmul'_apply_tmul]
          have hy : y = ∑ j ∈ T', (b.repr y j) • b j := by
            conv_lhs => rw [← b.linearCombination_repr y]
            rw [Finsupp.linearCombination_apply, Finsupp.sum_of_support_subset _ hT']
            intro i _; exact zero_smul _ _
          conv_lhs => rw [hy]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [hΦtmul, Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply,
            IsScalarTower.coe_toAlgHom', Module.Basis.coord_apply, Algebra.smul_def]
          ring
        | add x y hx hy =>
          obtain ⟨T1, h1⟩ := hx
          obtain ⟨T2, h2⟩ := hy
          refine ⟨T1 ∪ T2, fun T' hT' => ?_⟩
          rw [map_add, h1 T' (subset_trans Finset.subset_union_left hT'),
            h2 T' (subset_trans Finset.subset_union_right hT'), ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_add, map_add, add_mul]
      obtain ⟨T, hT⟩ := hC a
      have := hT T le_rfl
      rw [this] at hμ
      obtain ⟨j, _, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hμ
      refine ⟨Φ j a, ?_, ?_⟩
      · rw [← hA, ha, map_zero]
      · intro h0; apply hj; rw [h0, zero_mul]

    have s34 : ∀ (α : L), IsIntegral K α → Polynomial.derivative (minpoly K α) = 0 →
        ∀ (s : L ⊗[K] IntermediateField.adjoin K {α}),
        (α ⊗ₜ[K] (1 : IntermediateField.adjoin K {α}) -
            (1 : L) ⊗ₜ[K] IntermediateField.AdjoinSimple.gen K α) * s = 0 →
        Algebra.TensorProduct.productMap (AlgHom.id K L)
            (IsScalarTower.toAlgHom K (IntermediateField.adjoin K {α}) L) s = 0 := by
      intro α hint hd
      set M := IntermediateField.adjoin K {α}
      set gen := IntermediateField.AdjoinSimple.gen K α
      set μ' := Algebra.TensorProduct.productMap (AlgHom.id K L) (IsScalarTower.toAlgHom K M L)
      set θ : L ⊗[K] M := (1 : L) ⊗ₜ[K] gen with hθ
      intro s hs
      let pb := IntermediateField.adjoin.powerBasis hint
      have hpbgen : pb.gen = gen := IntermediateField.adjoin.powerBasis_gen hint
      let B := Algebra.TensorProduct.basis L pb.basis
      have hB : ∀ i : Fin pb.dim, B i = θ ^ (i : ℕ) := by
        intro i
        rw [Algebra.TensorProduct.basis_apply, PowerBasis.coe_basis, hθ,
          Algebra.TensorProduct.tmul_pow, one_pow, hpbgen]
      let pb' : PowerBasis L (L ⊗[K] M) :=
        { gen := θ, dim := pb.dim, basis := B, basis_eq_pow := hB }
      have hgen' : pb'.gen = θ := rfl
      have hdim : pb.dim = (minpoly K α).natDegree :=
        IntermediateField.adjoin.powerBasis_dim hint
      have hpos : 0 < pb.dim := by rw [hdim]; exact minpoly.natDegree_pos hint
      haveI : Nontrivial (L ⊗[K] M) := nontrivial_of_ne (B ⟨0, hpos⟩) 0 (B.ne_zero _)
      set FL := (minpoly K α).map (algebraMap K L) with hFL
      have hFLmon : FL.Monic := (minpoly.monic hint).map _
      have hFLdeg : FL.natDegree = pb.dim := by
        rw [hdim, hFL, (minpoly.monic hint).natDegree_map]
      have hθF : Polynomial.aeval θ FL = 0 := by
        rw [hFL, Polynomial.aeval_map_algebraMap, hθ]
        have : (1 : L) ⊗ₜ[K] gen = Algebra.TensorProduct.includeRight gen := rfl
        rw [this, Polynomial.aeval_algHom_apply, ← IntermediateField.minpoly_gen K α,
          minpoly.aeval, map_zero]
      have hmin : minpoly L θ = FL := by
        have hdvd : minpoly L θ ∣ FL := minpoly.dvd L θ hθF
        have hint' : IsIntegral L θ := pb'.isIntegral_gen
        refine (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint')
          hFLmon hdvd ?_).symm
        rw [hFLdeg, ← hgen', PowerBasis.natDegree_minpoly]
      have hev : ∀ P : Polynomial L, μ' (Polynomial.aeval θ P) = P.eval α := by
        intro P
        have : (μ'.toRingHom.comp (Polynomial.aeval θ).toRingHom) =
            Polynomial.evalRingHom α := by
          apply Polynomial.ringHom_ext
          · intro x
            simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
              RingHom.coe_coe, Polynomial.aeval_C, Polynomial.coe_evalRingHom,
              Polynomial.eval_C]
            rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
              RingHom.id_apply]
            rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one,
              AlgHom.id_apply]
          · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
              RingHom.coe_coe, Polynomial.aeval_X, Polynomial.coe_evalRingHom,
              Polynomial.eval_X]
            rw [hθ, Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul,
              IsScalarTower.coe_toAlgHom']
            exact IntermediateField.AdjoinSimple.algebraMap_gen K α
        exact congrArg (fun f => f P) this
      obtain ⟨P, hP⟩ := pb'.exists_eq_aeval' s
      rw [hgen'] at hP
      rw [hP] at hs ⊢
      rw [hev]
      have hδ' : α ⊗ₜ[K] (1 : M) - (1 : L) ⊗ₜ[K] gen =
          Polynomial.aeval θ (Polynomial.C α - Polynomial.X) := by
        rw [map_sub, Polynomial.aeval_C, Polynomial.aeval_X,
          Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      rw [hδ', ← map_mul] at hs
      have hdvd : FL ∣ (Polynomial.X - Polynomial.C α) * P := by
        rw [← hmin]
        have := minpoly.dvd L θ hs
        have e : (Polynomial.X - Polynomial.C α) * P =
            -((Polynomial.C α - Polynomial.X) * P) := by ring
        rw [e]
        exact (dvd_neg).mpr this
      have hFα : FL.eval α = 0 := by
        rw [hFL, Polynomial.eval_map_algebraMap, minpoly.aeval]
      have hFd : Polynomial.derivative FL = 0 := by
        rw [hFL, Polynomial.derivative_map, hd, Polynomial.map_zero]
      set G := FL /ₘ (Polynomial.X - Polynomial.C α)
      have hG : (Polynomial.X - Polynomial.C α) * G = FL :=
        Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hFα
      have hGα : G.eval α = 0 := by
        have := congrArg Polynomial.derivative hG
        rw [hFd, Polynomial.derivative_mul, Polynomial.derivative_sub, Polynomial.derivative_X,
          Polynomial.derivative_C, sub_zero, one_mul] at this
        have h2 := congrArg (Polynomial.eval α) this
        simpa using h2
      rw [← hG] at hdvd
      obtain ⟨H, hH⟩ := (mul_dvd_mul_iff_left (Polynomial.X_sub_C_ne_zero α)).mp hdvd
      rw [hH, Polynomial.eval_mul, hGα, zero_mul]

    rw [Algebra.isSeparable_def]
    intro α
    have hint : IsIntegral K α := (Algebra.IsAlgebraic.isAlgebraic α).isIntegral
    show (minpoly K α).Separable
    rw [Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible hint)]
    intro hd
    obtain ⟨a, ha, hμ⟩ := s1 α
    obtain ⟨s, hs, hμs⟩ := s2 α a ha hμ
    exact hμs (s34 α hint hd s hs)

theorem wc_mnt_fraction_field_weaklyEtale_algebraic : ∀ (A L : Type u) [CommRing A] [IsDomain A]
    [Field L] [Algebra A L] [Algebra (FractionRing A) L] [IsScalarTower A (FractionRing A) L],
    Algebra.WeaklyEtale A L →
    Algebra.WeaklyEtale (FractionRing A) L ∧ Algebra.IsAlgebraic (FractionRing A) L :=
by
  intro A L _ _ _ _ _ _ h
  have hK : Algebra.WeaklyEtale (FractionRing A) L := by
    let e : TensorProduct (FractionRing A) L L ≃ₐ[A] TensorProduct A L L :=
      Algebra.TensorProduct.equivOfCompatibleSMul A (FractionRing A) A L L
    have heq : (Algebra.TensorProduct.lmul' (FractionRing A) :
        TensorProduct (FractionRing A) L L →ₐ[FractionRing A] L).toRingHom =
        (Algebra.TensorProduct.lmul' A : TensorProduct A L L →ₐ[A] L).toRingHom.comp
          e.toRingEquiv.toRingHom := by
      apply RingHom.ext
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a b => rfl
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    have hflat : (Algebra.TensorProduct.lmul' (FractionRing A) :
        TensorProduct (FractionRing A) L L →ₐ[FractionRing A] L).toRingHom.Flat := by
      rw [heq]
      exact RingHom.Flat.comp (RingHom.Flat.of_bijective e.bijective) h.flat_lmul'
    exact Algebra.WeaklyEtale.mk (flat_lmul' := hflat)
  refine ⟨hK, ?_⟩
  have halg : ∀ (K : Type u) [Field K] [Algebra K L], Algebra.WeaklyEtale K L →
      Algebra.IsAlgebraic K L := by
    intro K _ _ hWK
    have hδ : (TensorProduct.tmul K (1 : Polynomial K) (Polynomial.X : Polynomial K) -
        TensorProduct.tmul K (Polynomial.X : Polynomial K) (1 : Polynomial K)) ∈
          nonZeroDivisors (TensorProduct K (Polynomial K) (Polynomial K)) := by
      have hm : (Polynomial.X - Polynomial.C Polynomial.X : Polynomial (Polynomial K)) ∈
          nonZeroDivisors _ := (Polynomial.monic_X_sub_C _).mem_nonZeroDivisors
      have himg : polyEquivTensor K (Polynomial K) (Polynomial.X - Polynomial.C Polynomial.X) =
          TensorProduct.tmul K (1 : Polynomial K) (Polynomial.X : Polynomial K) -
            TensorProduct.tmul K (Polynomial.X : Polynomial K) (1 : Polynomial K) := by
        simp [polyEquivTensor_apply]
      rw [← himg, ← MulEquivClass.map_nonZeroDivisors (polyEquivTensor K (Polynomial K))]
      exact Submonoid.mem_map_of_mem _ hm
    constructor
    intro x
    by_contra hx
    have hx' : Transcendental K x := hx
    let φ : Polynomial K →ₐ[K] L := Polynomial.aeval x
    have hφinj : Function.Injective φ := (transcendental_iff_injective).mp hx'
    have hφ : (φ : Polynomial K →+* L).Flat := by
      letI : Algebra (Polynomial K) L := (φ : Polynomial K →+* L).toAlgebra
      have : Module.IsTorsionFree (Polynomial K) L := by
        rw [Module.isTorsionFree_iff_smul_eq_zero]
        intro r m hrm
        rw [Algebra.smul_def] at hrm
        rcases mul_eq_zero.mp hrm with h1 | h1
        · left
          apply hφinj
          rw [map_zero]
          exact h1
        · right
          exact h1
      show Module.Flat (Polynomial K) L
      infer_instance
    have hΨ := RingHom.Flat.tensorProductMap (f := φ) (g := φ) hφ hφ
    have hg := RingHom.Flat.comp hΨ hWK.flat_lmul'
    set g := (Algebra.TensorProduct.lmul' K : TensorProduct K L L →ₐ[K] L).toRingHom.comp
      (Algebra.TensorProduct.map φ φ).toRingHom with hgdef
    have hgδ : g (TensorProduct.tmul K (1 : Polynomial K) (Polynomial.X : Polynomial K) -
        TensorProduct.tmul K (Polynomial.X : Polynomial K) (1 : Polynomial K)) = 0 := by
      rw [map_sub]
      simp [g, φ]
    letI : Algebra (TensorProduct K (Polynomial K) (Polynomial K)) L := g.toAlgebra
    have : Module.Flat (TensorProduct K (Polynomial K) (Polynomial K)) L := hg
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := L) hδ
    apply one_ne_zero (α := L)
    apply hreg
    show (TensorProduct.tmul K (1 : Polynomial K) (Polynomial.X : Polynomial K) -
        TensorProduct.tmul K (Polynomial.X : Polynomial K) (1 : Polynomial K)) • (1 : L) =
      (TensorProduct.tmul K (1 : Polynomial K) (Polynomial.X : Polynomial K) -
        TensorProduct.tmul K (Polynomial.X : Polynomial K) (1 : Polynomial K)) • (0 : L)
    rw [Algebra.smul_def, Algebra.smul_def]
    show g _ * 1 = g _ * 0
    rw [hgδ, zero_mul, zero_mul]
  exact halg (FractionRing A) hK

theorem wc_skc_hensel_roots : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (N : ℕ), IsUnit (N : A) →
    (∀ u : Aˣ, ∃ v : A, v ^ N = u) ∧ Nat.card {ζ : A // ζ ^ N = 1} = N ∧
    ∀ ζ₁ ζ₂ : A, ζ₁ ^ N = 1 → ζ₂ ^ N = 1 → ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal A → ζ₁ = ζ₂ :=
by
  intro A _ _ _ N hN
  classical
  have hN0 : N ≠ 0 := by
    rintro rfl
    simp at hN
  have hNk : ((N : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    rw [← map_natCast (IsLocalRing.residue A)]
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hN
  have rigid : ∀ ζ₁ ζ₂ : A, ζ₁ ^ N = 1 → ζ₂ ^ N = 1 →
      ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal A → ζ₁ = ζ₂ := by
    intro ζ₁ ζ₂ h1 h2 hm
    have hSm : (∑ i ∈ Finset.range N, ζ₁ ^ i * ζ₂ ^ (N - 1 - i)) * (ζ₁ - ζ₂) = 0 := by
      rw [geom_sum₂_mul, h1, h2, sub_self]
    have hr12 : IsLocalRing.residue A ζ₁ = IsLocalRing.residue A ζ₂ := by
      have := (IsLocalRing.residue_eq_zero_iff _).mpr hm
      rw [map_sub, sub_eq_zero] at this
      exact this
    have hy : IsLocalRing.residue A ζ₂ ≠ 0 := by
      intro h0
      have : IsLocalRing.residue A (ζ₂ ^ N) = 1 := by rw [h2, map_one]
      rw [map_pow, h0, zero_pow hN0] at this
      exact zero_ne_one this
    have hrS : IsLocalRing.residue A (∑ i ∈ Finset.range N, ζ₁ ^ i * ζ₂ ^ (N - 1 - i)) =
        (N : IsLocalRing.ResidueField A) * IsLocalRing.residue A ζ₂ ^ (N - 1) := by
      rw [map_sum]
      rw [Finset.sum_congr rfl (g := fun _ => IsLocalRing.residue A ζ₂ ^ (N - 1))]
      · rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      · intro i hi
        rw [Finset.mem_range] at hi
        rw [map_mul, map_pow, map_pow, hr12, ← pow_add]
        congr 1
        omega
    have hSu : IsUnit (∑ i ∈ Finset.range N, ζ₁ ^ i * ζ₂ ^ (N - 1 - i)) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hrS]
      exact mul_ne_zero hNk (pow_ne_zero _ hy)
    have : ζ₁ - ζ₂ = 0 := hSu.mul_right_eq_zero.mp hSm
    exact sub_eq_zero.mp this
  have lift : ∀ c a₀ : A, IsUnit a₀ → a₀ ^ N - c ∈ IsLocalRing.maximalIdeal A →
      ∃ a : A, a ^ N = c ∧ a - a₀ ∈ IsLocalRing.maximalIdeal A := by
    intro c a₀ ha₀ hc
    have hmon : (Polynomial.X ^ N - Polynomial.C c : Polynomial A).Monic :=
      Polynomial.monic_X_pow_sub_C c hN0
    have heval : (Polynomial.X ^ N - Polynomial.C c : Polynomial A).eval a₀ ∈
        IsLocalRing.maximalIdeal A := by
      simpa using hc
    have hder : IsUnit ((Polynomial.derivative
        (Polynomial.X ^ N - Polynomial.C c : Polynomial A)).eval a₀) := by
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X]
      simpa using hN.mul (ha₀.pow (N - 1))
    obtain ⟨a, ha, ham⟩ := HenselianLocalRing.is_henselian
      (Polynomial.X ^ N - Polynomial.C c) hmon a₀ heval hder
    refine ⟨a, ?_, ham⟩
    have h := ha.eq_zero
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at h
    exact sub_eq_zero.mp h
  have cardk : Nat.card {x : IsLocalRing.ResidueField A // x ^ N = 1} = N := by
    haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField A) := ⟨hNk⟩
    haveI : NeZero N := ⟨hN0⟩
    haveI := IsSepClosed.hasEnoughRootsOfUnity (IsLocalRing.ResidueField A) N
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (IsLocalRing.ResidueField A) N
    have hNpos : 0 < N := Nat.pos_of_ne_zero hN0
    rw [Nat.card_congr (Equiv.subtypeEquivRight (fun x =>
      (Polynomial.mem_nthRootsFinset hNpos (1 : IsLocalRing.ResidueField A) (x := x)).symm)),
      Nat.card_eq_finsetCard]
    exact hζ.card_nthRootsFinset
  refine ⟨?_, ?_, rigid⟩
  · intro u
    have hru : IsLocalRing.residue A (u : A) ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr u.isUnit
    haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField A) := ⟨hNk⟩
    obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue A (u : A)) N
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective z
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hN0] at hz
      exact hru hz.symm
    have hua : IsUnit a₀ :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (by rw [ha₀]; exact hz0)
    obtain ⟨v, hv, -⟩ := lift (u : A) a₀ hua (by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, ha₀, hz, sub_self])
    exact ⟨v, hv⟩
  · let Φ : {ζ : A // ζ ^ N = 1} → {x : IsLocalRing.ResidueField A // x ^ N = 1} :=
      fun ζ => ⟨IsLocalRing.residue A ζ.1, by rw [← map_pow, ζ.2, map_one]⟩
    have hinj : Function.Injective Φ := by
      intro ζ₁ ζ₂ h
      have h' : IsLocalRing.residue A ζ₁.1 = IsLocalRing.residue A ζ₂.1 :=
        congrArg Subtype.val h
      apply Subtype.ext
      apply rigid _ _ ζ₁.2 ζ₂.2
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, h', sub_self]
    have hsurj : Function.Surjective Φ := by
      rintro ⟨x, hx⟩
      have hx0 : x ≠ 0 := by
        rintro rfl
        rw [zero_pow hN0] at hx
        exact zero_ne_one hx
      obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective x
      have hua : IsUnit a₀ :=
        (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (by rw [ha₀]; exact hx0)
      obtain ⟨a, ha, ham⟩ := lift 1 a₀ hua (by
        rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, ha₀, hx, map_one, sub_self])
      refine ⟨⟨a, ha⟩, Subtype.ext ?_⟩
      show IsLocalRing.residue A a = x
      have := (IsLocalRing.residue_eq_zero_iff _).mpr ham
      rw [map_sub, sub_eq_zero, ha₀] at this
      exact this
    rw [Nat.card_eq_of_bijective Φ ⟨hinj, hsurj⟩, cardk]

theorem wc_skc_kummer_from_dvr : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    (ϖ : A) (ρ : A ≃+* A) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (L : Type u) [Field L] (r : A →+* L),
    ϖ ∈ IsLocalRing.maximalIdeal A → ϖ ≠ 0 →
    (∀ a : A, a ≠ 0 → ∃ (u : Aˣ) (n : ℕ), a = u * ϖ ^ n) →
    ρ ϖ = ϖ → IsUnit ((ℓ : ℕ) : A) →
    (∀ m : ℕ, ∀ u : Aˣ, ∃ v : A, v ^ (ℓ ^ m) = u) →
    (∀ m : ℕ, Nat.card {ζ : A // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) →
    (∀ m : ℕ, ∀ ζ₁ ζ₂ : A, ζ₁ ^ (ℓ ^ m) = 1 → ζ₂ ^ (ℓ ^ m) = 1 →
      ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal A → ζ₁ = ζ₂) →
    RingHom.ker r = IsLocalRing.maximalIdeal A → (∀ a : A, r (ρ a) ^ q = r a) →
    ∃ ρK : FractionRing A ≃+* FractionRing A,
      (∀ a : A, ρK (algebraMap A (FractionRing A) a) = algebraMap A (FractionRing A) (ρ a)) ∧
      IsLocalization.Away ϖ (FractionRing A) ∧
      ((ℓ : ℕ) : FractionRing A) ≠ 0 ∧ algebraMap A (FractionRing A) ϖ ≠ 0 ∧
      ρK (algebraMap A (FractionRing A) ϖ) = algebraMap A (FractionRing A) ϖ ∧
      (∀ m : ℕ, Nat.card {ζ : FractionRing A // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) ∧
      (∀ m : ℕ, ∀ x : FractionRing A, x ≠ 0 → ∃ (k : ℤ) (y : FractionRing A), y ≠ 0 ∧
        x = algebraMap A (FractionRing A) ϖ ^ k * y ^ (ℓ ^ m)) ∧
      (∀ m : ℕ, ∀ k : ℤ, (∃ y : FractionRing A, algebraMap A (FractionRing A) ϖ ^ k = y ^ (ℓ ^ m)) →
        ((ℓ ^ m : ℕ) : ℤ) ∣ k) ∧
      (∀ m : ℕ, ∀ ζ : FractionRing A, ζ ^ (ℓ ^ m) = 1 → (ρK ζ) ^ q = ζ) :=
by
  intro A _ _ _ ϖ ρ ℓ _ q L _ r hϖm hϖ0 hval hρϖ hℓ hroot hcard hsep hker hfrob
  classical
  have hinj : Function.Injective (algebraMap A (FractionRing A)) :=
    IsFractionRing.injective A (FractionRing A)
  have hϖu : ¬ IsUnit ϖ := (IsLocalRing.mem_maximalIdeal ϖ).mp hϖm
  have hπ0 : algebraMap A (FractionRing A) ϖ ≠ 0 := fun h => hϖ0 (hinj (by rw [h, map_zero]))
  have hunit0 : ∀ u : Aˣ, algebraMap A (FractionRing A) (u : A) ≠ 0 := fun u h =>
    u.ne_zero (hinj (by rw [h, map_zero]))
  have hinvu : ∀ u : Aˣ, algebraMap A (FractionRing A) ((u⁻¹ : Aˣ) : A) =
      (algebraMap A (FractionRing A) (u : A))⁻¹ := fun u =>
    eq_inv_of_mul_eq_one_left (by rw [← map_mul, Units.inv_mul, map_one])

  have hnf : ∀ x : FractionRing A, x ≠ 0 → ∃ (u : Aˣ) (k : ℤ),
      x = algebraMap A (FractionRing A) (u : A) * algebraMap A (FractionRing A) ϖ ^ k := by
    intro x hx
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := A) x
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have ha0 : a ≠ 0 := by
      rintro rfl
      exact hx (by rw [map_zero, zero_div])
    obtain ⟨u, n, rfl⟩ := hval a ha0
    obtain ⟨u', n', rfl⟩ := hval b hb0
    refine ⟨u * u'⁻¹, (n : ℤ) - n', ?_⟩
    rw [zpow_sub₀ hπ0, zpow_natCast, zpow_natCast]
    simp only [Units.val_mul, map_mul, map_pow, hinvu]
    ring

  have huniq : ∀ (w : Aˣ) (j : ℤ),
      algebraMap A (FractionRing A) (w : A) * algebraMap A (FractionRing A) ϖ ^ j = 1 → j = 0 := by
    intro w j h
    rcases Int.eq_nat_or_neg j with ⟨n, rfl | rfl⟩
    · rw [zpow_natCast, ← map_pow, ← map_mul, ← map_one (algebraMap A (FractionRing A))] at h
      have h2 := hinj h
      cases n with
      | zero => simp
      | succ n =>
        exfalso
        apply hϖu
        have h1 : ϖ * ((w : A) * ϖ ^ n) = 1 := by rw [← h2]; ring
        exact ⟨⟨ϖ, (w : A) * ϖ ^ n, h1, by rw [mul_comm]; exact h1⟩, rfl⟩
    · rw [zpow_neg, zpow_natCast, mul_inv_eq_one₀ (pow_ne_zero _ hπ0), ← map_pow] at h
      have h2 := hinj h
      cases n with
      | zero => simp
      | succ n =>
        exfalso
        apply hϖu
        have h3 : IsUnit (ϖ * ϖ ^ n) := by rw [← pow_succ', ← h2]; exact w.isUnit
        obtain ⟨v, hv⟩ := h3
        refine ⟨⟨ϖ, (v⁻¹ : Aˣ) * ϖ ^ n, ?_, ?_⟩, rfl⟩
        · rw [← mul_assoc, mul_comm ϖ, mul_assoc, ← hv, Units.inv_mul]
        · rw [mul_assoc, ← pow_succ, pow_succ', ← hv, Units.inv_mul]

  have hlift : ∀ (N : ℕ), 0 < N → ∀ ζ : FractionRing A, ζ ^ N = 1 →
      ∃ a : A, a ^ N = 1 ∧ algebraMap A (FractionRing A) a = ζ := by
    intro N hN ζ hζ
    have hζ0 : ζ ≠ 0 := by
      rintro rfl
      rw [zero_pow hN.ne'] at hζ
      exact zero_ne_one hζ
    obtain ⟨u, k, rfl⟩ := hnf ζ hζ0
    have h1 : algebraMap A (FractionRing A) ((u ^ N : Aˣ) : A) *
        algebraMap A (FractionRing A) ϖ ^ (k * N) = 1 := by
      rw [← hζ, mul_pow, Units.val_pow_eq_pow_val, map_pow, zpow_mul, zpow_natCast]
    have hk := huniq _ _ h1
    have hk0 : k = 0 := by
      rcases mul_eq_zero.mp hk with h | h
      · exact h
      · exfalso; omega
    subst hk0
    refine ⟨u, ?_, by simp⟩
    apply hinj
    rw [map_pow, map_one]
    simpa using hζ

  have hdvd : ∀ (N : ℕ), 0 < N → ∀ k : ℤ,
      (∃ y : FractionRing A, algebraMap A (FractionRing A) ϖ ^ k = y ^ N) → (N : ℤ) ∣ k := by
    rintro N hN k ⟨y, hy⟩
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hN.ne'] at hy
      exact zpow_ne_zero k hπ0 hy
    obtain ⟨w, i, rfl⟩ := hnf y hy0
    have e : algebraMap A (FractionRing A) ϖ ^ (i * N) =
        (algebraMap A (FractionRing A) ϖ ^ i) ^ N := by
      rw [zpow_mul, zpow_natCast]
    have hpi : (algebraMap A (FractionRing A) ϖ ^ i) ^ N ≠ 0 :=
      pow_ne_zero _ (zpow_ne_zero _ hπ0)
    have hw := hunit0 w
    have h1 : algebraMap A (FractionRing A) (((w ^ N)⁻¹ : Aˣ) : A) *
        algebraMap A (FractionRing A) ϖ ^ (k - i * N) = 1 := by
      rw [zpow_sub₀ hπ0, hy, e, mul_pow, hinvu, Units.val_pow_eq_pow_val, map_pow,
        mul_div_assoc, div_self hpi, mul_one, inv_mul_cancel₀ (pow_ne_zero _ hw)]
    have hk := huniq _ _ h1
    exact ⟨i, by linear_combination hk⟩

  have hAway : IsLocalization.Away ϖ (FractionRing A) := by
    refine ⟨?_, ?_, ?_⟩
    · intro y
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp y.2
      rw [← hn, map_pow]
      exact (pow_ne_zero _ hπ0).isUnit
    · intro z
      by_cases hz : z = 0
      · exact ⟨(0, 1), by simp [hz]⟩
      obtain ⟨u, k, rfl⟩ := hnf z hz
      rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
      · refine ⟨((u : A) * ϖ ^ n, 1), ?_⟩
        simp [map_mul, map_pow]
      · refine ⟨((u : A), ⟨ϖ ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers ϖ) n⟩), ?_⟩
        show algebraMap A (FractionRing A) (u : A) * algebraMap A (FractionRing A) ϖ ^ (-(n : ℤ)) *
          algebraMap A (FractionRing A) (ϖ ^ n) = algebraMap A (FractionRing A) (u : A)
        rw [zpow_neg, zpow_natCast, map_pow, mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hπ0),
          mul_one]
    · intro x y h
      exact ⟨1, by rw [hinj h]⟩

  obtain ⟨ρK, hcompat⟩ : ∃ ρK : FractionRing A ≃+* FractionRing A, ∀ a : A,
      ρK (algebraMap A (FractionRing A) a) = algebraMap A (FractionRing A) (ρ a) :=
    ⟨IsFractionRing.ringEquivOfRingEquiv (K := FractionRing A) (L := FractionRing A) ρ,
      fun a => IsFractionRing.ringEquivOfRingEquiv_algebraMap ρ a⟩
  have hNpos : ∀ m : ℕ, 0 < ℓ ^ m := fun m => pow_pos (Fact.out : ℓ.Prime).pos m
  refine ⟨ρK, hcompat, hAway, ?_, hπ0, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← map_natCast (algebraMap A (FractionRing A))]
    exact (hℓ.map _).ne_zero
  · rw [hcompat, hρϖ]
  · intro m
    refine (Nat.card_congr (Equiv.ofBijective
      (fun ζ : {ζ : A // ζ ^ (ℓ ^ m) = 1} =>
        (⟨algebraMap A (FractionRing A) ζ.1, by rw [← map_pow, ζ.2, map_one]⟩ :
          {ζ : FractionRing A // ζ ^ (ℓ ^ m) = 1})) ⟨?_, ?_⟩).symm).trans (hcard m)
    · intro a b hab
      exact Subtype.ext (hinj (congrArg Subtype.val hab))
    · rintro ⟨ζ, hζ⟩
      obtain ⟨a, ha, rfl⟩ := hlift _ (hNpos m) ζ hζ
      exact ⟨⟨a, ha⟩, rfl⟩
  · intro m x hx
    obtain ⟨u, k, rfl⟩ := hnf x hx
    obtain ⟨v, hv⟩ := hroot m u
    refine ⟨k, algebraMap A (FractionRing A) v, ?_, ?_⟩
    · intro h0
      have hv0 : v = 0 := hinj (by rw [h0, map_zero])
      rw [hv0, zero_pow (hNpos m).ne'] at hv
      exact u.ne_zero hv.symm
    · rw [← map_pow, hv, mul_comm]
  · intro m k h
    exact hdvd _ (hNpos m) k h
  · intro m ζ hζ
    obtain ⟨a, ha, rfl⟩ := hlift _ (hNpos m) ζ hζ
    rw [hcompat, ← map_pow]
    congr 1
    apply hsep m ((ρ a) ^ q) a ?_ ha ?_
    · rw [← pow_mul, mul_comm, pow_mul, ← map_pow, ha, map_one, one_pow]
    · rw [← hker, RingHom.mem_ker, map_sub, map_pow, hfrob, sub_self]

theorem wc_kummer_compatible_roots (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hK1 : ∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) :
    ∃ ζ : ℕ → K, (∀ m, IsPrimitiveRoot (ζ m) (ℓ ^ m)) ∧ ∀ m, ζ (m + 1) ^ ℓ = ζ m :=
by
  classical
  have hℓ : ℓ.Prime := Fact.out
  have hℓ1 : 1 < ℓ := hℓ.one_lt
  have hℓ0 : 0 < ℓ := hℓ.pos

  have s1 : ∀ n : ℕ, ∃ η : K, IsPrimitiveRoot η (ℓ ^ n) := by
    intro n
    cases n with
    | zero => exact ⟨1, by rw [pow_zero]; exact IsPrimitiveRoot.one⟩
    | succ k =>
      have hex : ∃ η : K, η ^ (ℓ ^ (k + 1)) = 1 ∧ ¬ η ^ (ℓ ^ k) = 1 := by
        by_contra hcon
        push_neg at hcon
        have hfin : Finite {ζ : K // ζ ^ (ℓ ^ k) = 1} :=
          Nat.finite_of_card_ne_zero (by rw [hK1 k]; exact pow_ne_zero _ hℓ.ne_zero)
        let f : {ζ : K // ζ ^ (ℓ ^ (k + 1)) = 1} → {ζ : K // ζ ^ (ℓ ^ k) = 1} :=
          fun z => ⟨z.1, hcon z.1 z.2⟩
        have hf : Function.Injective f := by
          intro a b hab
          have h := congrArg Subtype.val hab
          exact Subtype.ext h
        have hle := Nat.card_le_card_of_injective f hf
        rw [hK1, hK1] at hle
        have hlt : ℓ ^ k < ℓ ^ (k + 1) := pow_lt_pow_right₀ hℓ1 (Nat.lt_succ_self k)
        omega
      obtain ⟨η, h1, h2⟩ := hex
      exact ⟨η, IsPrimitiveRoot.iff_orderOf.mpr (orderOf_eq_prime_pow h2 h1)⟩

  have s2 : ∀ (m : ℕ) (ξ : K), IsPrimitiveRoot ξ (ℓ ^ m) →
      ∃ ζ : K, IsPrimitiveRoot ζ (ℓ ^ (m + 1)) ∧ ζ ^ ℓ = ξ := by
    intro m ξ hξ
    obtain ⟨η, hη⟩ := s1 (m + 1)
    cases m with
    | zero =>
      have hξ1 : ξ = 1 := by
        rw [pow_zero] at hξ
        exact IsPrimitiveRoot.one_right_iff.mp hξ
      refine ⟨η, hη, ?_⟩
      have h := hη.pow_eq_one
      rw [zero_add, pow_one] at h
      rw [h, hξ1]
    | succ k =>
      have hθ : IsPrimitiveRoot (η ^ ℓ) (ℓ ^ (k + 1)) :=
        hη.pow (pow_pos hℓ0 _) (pow_succ' ℓ (k + 1))
      haveI : NeZero (ℓ ^ (k + 1)) := ⟨pow_ne_zero _ hℓ.ne_zero⟩
      obtain ⟨i, -, hi⟩ := hθ.eq_pow_of_pow_eq_one hξ.pow_eq_one
      have hζℓ : (η ^ i) ^ ℓ = ξ := by
        rw [← pow_mul, mul_comm, pow_mul, hi]
      refine ⟨η ^ i, ?_, hζℓ⟩
      apply IsPrimitiveRoot.iff_orderOf.mpr
      apply orderOf_eq_prime_pow
      · rw [pow_succ' ℓ k, pow_mul, hζℓ]
        exact hξ.pow_ne_one_of_pos_of_lt (pow_ne_zero k hℓ.ne_zero)
          (pow_lt_pow_right₀ hℓ1 (Nat.lt_succ_self k))
      · rw [pow_succ' ℓ (k + 1), pow_mul, hζℓ]
        exact hξ.pow_eq_one

  choose L hL using s2
  let g : (n : ℕ) → {x : K // IsPrimitiveRoot x (ℓ ^ n)} := fun n =>
    Nat.rec (motive := fun n => {x : K // IsPrimitiveRoot x (ℓ ^ n)})
      ⟨1, by rw [pow_zero]; exact IsPrimitiveRoot.one⟩
      (fun n x => ⟨L n x.1 x.2, (hL n x.1 x.2).1⟩) n
  exact ⟨fun n => (g n).1, fun m => (g m).2, fun m => (hL m (g m).1 (g m).2).2⟩

theorem wc_kummer_level_char (K : Type u) [Field K] (N : ℕ) [NeZero N] (ζ : K)
    (hζ : IsPrimitiveRoot ζ N) (x : SeparableClosure K) (hx : x ≠ 0)
    (hxN : ∃ y : K, x ^ N = algebraMap K (SeparableClosure K) y) :
    ∃ χ : (SeparableClosure K ≃ₐ[K] SeparableClosure K) → ZMod N,
      (∀ g, g x = algebraMap K (SeparableClosure K) ζ ^ (χ g).val * x) ∧
      (∀ g h, χ (g * h) = χ g + χ h) ∧
      ∀ (g : SeparableClosure K ≃ₐ[K] SeparableClosure K) (v : ℕ),
        g x = algebraMap K (SeparableClosure K) ζ ^ v * x → χ g = (v : ZMod N) :=
by
  classical
  obtain ⟨y, hy⟩ := hxN
  have hζ' : IsPrimitiveRoot (algebraMap K (SeparableClosure K) ζ) N :=
    hζ.map_of_injective (algebraMap K (SeparableClosure K)).injective
  have hfin : IsOfFinOrder (algebraMap K (SeparableClosure K) ζ) :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨N, NeZero.pos N, hζ'.pow_eq_one⟩
  have hord : orderOf (algebraMap K (SeparableClosure K) ζ) = N := hζ'.eq_orderOf.symm
  have uniq : ∀ a b : ℕ, algebraMap K (SeparableClosure K) ζ ^ a * x =
      algebraMap K (SeparableClosure K) ζ ^ b * x → (a : ZMod N) = (b : ZMod N) := by
    intro a b hab
    have h1 : algebraMap K (SeparableClosure K) ζ ^ a = algebraMap K (SeparableClosure K) ζ ^ b :=
      mul_right_cancel₀ hx hab
    rw [hfin.pow_eq_pow_iff_modEq, hord] at h1
    exact (ZMod.natCast_eq_natCast_iff ..).mpr h1
  have hex : ∀ g : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      ∃ i : ℕ, g x = algebraMap K (SeparableClosure K) ζ ^ i * x := by
    intro g
    have hg : (g x) ^ N = x ^ N := by
      rw [← map_pow, hy, AlgEquiv.commutes]
    have hxN0 : x ^ N ≠ 0 := pow_ne_zero _ hx
    have hξ : (g x * x⁻¹) ^ N = 1 := by
      rw [mul_pow, hg, inv_pow, mul_inv_cancel₀ hxN0]
    obtain ⟨i, -, hi⟩ := hζ'.eq_pow_of_pow_eq_one hξ
    exact ⟨i, by rw [hi, mul_assoc, inv_mul_cancel₀ hx, mul_one]⟩
  choose e he using hex
  have hval : ∀ n : ℕ, algebraMap K (SeparableClosure K) ζ ^ ((n : ZMod N)).val =
      algebraMap K (SeparableClosure K) ζ ^ n := by
    intro n
    rw [ZMod.val_natCast]
    conv_rhs => rw [← Nat.mod_add_div n N]
    rw [pow_add, pow_mul, hζ'.pow_eq_one, one_pow, mul_one]
  have hC : ∀ (g : SeparableClosure K ≃ₐ[K] SeparableClosure K) (v : ℕ),
      g x = algebraMap K (SeparableClosure K) ζ ^ v * x → ((e g : ℕ) : ZMod N) = (v : ZMod N) :=
    fun g v hv => uniq _ _ ((he g).symm.trans hv)
  refine ⟨fun g => ((e g : ℕ) : ZMod N), ?_, ?_, hC⟩
  · intro g
    show g x = algebraMap K (SeparableClosure K) ζ ^ ((e g : ℕ) : ZMod N).val * x
    rw [hval]
    exact he g
  · intro g h
    show ((e (g * h) : ℕ) : ZMod N) = ((e g : ℕ) : ZMod N) + ((e h : ℕ) : ZMod N)
    have key : (g * h) x = algebraMap K (SeparableClosure K) ζ ^
        (((e g : ℕ) : ZMod N).val + ((e h : ℕ) : ZMod N).val) * x := by
      rw [AlgEquiv.mul_apply, he h, map_mul, map_pow, AlgEquiv.commutes, he g, pow_add,
        hval, hval]
      ring
    rw [hC _ _ key, Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]

theorem wc_kummer_generator_exists (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (ϖ : K)
    (hnot : ¬ ∃ y : K, ϖ = y ^ ℓ)
    (ζ : ℕ → K) (hζ : ∀ m, IsPrimitiveRoot (ζ m) (ℓ ^ m)) (hζc : ∀ m, ζ (m + 1) ^ ℓ = ζ m)
    (α : ℕ → SeparableClosure K) (hα0 : α 0 = algebraMap K (SeparableClosure K) ϖ)
    (hαc : ∀ m, α (m + 1) ^ ℓ = α m)
    (χm : ∀ m : ℕ, (SeparableClosure K ≃ₐ[K] SeparableClosure K) → ZMod (ℓ ^ m))
    (hχ : ∀ m g, g (α m) = algebraMap K (SeparableClosure K) (ζ m) ^ (χm m g).val * α m)
    (hχadd : ∀ m g h, χm m (g * h) = χm m g + χm m h) :
    ∃ γ : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      ∀ m, γ (α m) = algebraMap K (SeparableClosure K) (ζ m) * α m :=
by
  classical
  have hℓ : Nat.Prime ℓ := Fact.out
  have hι : Function.Injective (algebraMap K (SeparableClosure K)) :=
    (algebraMap K (SeparableClosure K)).injective

  have hclosed : ∀ x y : SeparableClosure K,
      IsClosed {g : SeparableClosure K ≃ₐ[K] SeparableClosure K | g x = y} := by
    intro x y
    haveI : FiniteDimensional K (IntermediateField.adjoin K {x}) :=
      IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x)
    have hfix : IsOpen ((IntermediateField.adjoin K {x}).fixingSubgroup :
        Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) :=
      IntermediateField.fixingSubgroup_isOpen _
    have hle : (IntermediateField.adjoin K {x}).fixingSubgroup ≤
        MulAction.stabilizer (SeparableClosure K ≃ₐ[K] SeparableClosure K) x := by
      intro g hg
      rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hg x
        (IntermediateField.mem_adjoin_simple_self K x)
    have hopen := Subgroup.isOpen_mono hle hfix
    have hSc : IsClosed (MulAction.stabilizer
        (SeparableClosure K ≃ₐ[K] SeparableClosure K) x :
          Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) :=
      Subgroup.isClosed_of_isOpen _ hopen
    by_cases hex : ∃ g₀ : SeparableClosure K ≃ₐ[K] SeparableClosure K, g₀ x = y
    · obtain ⟨g₀, hg₀⟩ := hex
      have hset : {g : SeparableClosure K ≃ₐ[K] SeparableClosure K | g x = y} =
          (fun g => g₀⁻¹ * g) ⁻¹' (MulAction.stabilizer
            (SeparableClosure K ≃ₐ[K] SeparableClosure K) x :
              Set (SeparableClosure K ≃ₐ[K] SeparableClosure K)) := by
        ext g
        show g x = y ↔ (g₀⁻¹ * g) ∈ MulAction.stabilizer _ x
        rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def, AlgEquiv.mul_apply,
          AlgEquiv.aut_inv, AlgEquiv.symm_apply_eq, hg₀]
      rw [hset]
      exact hSc.preimage (continuous_const.mul continuous_id)
    · have hset : {g : SeparableClosure K ≃ₐ[K] SeparableClosure K | g x = y} = ∅ := by
        ext g
        simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
        exact fun h => hex ⟨g, h⟩
      rw [hset]
      exact isClosed_empty
  let C : ℕ → Set (SeparableClosure K ≃ₐ[K] SeparableClosure K) :=
    fun m => {g | g (α m) = algebraMap K (SeparableClosure K) (ζ m) * α m}
  have hCcl : ∀ m, IsClosed (C m) := fun m => hclosed (α m) _

  have hdec : ∀ m, C (m + 1) ⊆ C m := by
    intro m g hg
    have hg' : g (α (m + 1)) = algebraMap K (SeparableClosure K) (ζ (m + 1)) * α (m + 1) := hg
    show g (α m) = algebraMap K (SeparableClosure K) (ζ m) * α m
    rw [← hαc m, map_pow, hg', mul_pow, ← map_pow, hζc m]

  have htow : ∀ j : ℕ, α (j + 1) ^ (ℓ ^ j) = α 1 := by
    intro j
    induction j with
    | zero => rw [pow_zero, pow_one]
    | succ j ih => rw [pow_succ' ℓ j, pow_mul, hαc (j + 1), ih]

  have hunit : ∀ k : ℕ, ∃ g : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      ¬ ℓ ∣ (χm (k + 1) g).val := by
    intro k
    by_contra hcon
    push_neg at hcon
    have hfix : ∀ g : SeparableClosure K ≃ₐ[K] SeparableClosure K, g (α 1) = α 1 := by
      intro g
      obtain ⟨t, ht⟩ := hcon g
      rw [← htow k, map_pow, hχ (k + 1) g, ht, mul_pow, ← pow_mul,
        ← map_pow (algebraMap K (SeparableClosure K))]
      have h1 : ζ (k + 1) ^ (ℓ * t * ℓ ^ k) = 1 := by
        rw [show ℓ * t * ℓ ^ k = ℓ ^ (k + 1) * t by ring, pow_mul, (hζ (k + 1)).pow_eq_one,
          one_pow]
      rw [h1, map_one, one_mul]
    obtain ⟨y, hy⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed (α 1)).mpr hfix
    apply hnot
    refine ⟨y, hι ?_⟩
    have h2 : α 1 ^ ℓ = α 0 := hαc 0
    rw [map_pow, hy, h2, hα0]

  have hCne : ∀ m, (C m).Nonempty := by
    intro m
    cases m with
    | zero =>
      have h0 : ζ 0 = 1 := by
        have := hζ 0
        rw [pow_zero] at this
        exact IsPrimitiveRoot.one_right_iff.mp this
      refine ⟨1, ?_⟩
      show (1 : SeparableClosure K ≃ₐ[K] SeparableClosure K) (α 0) =
        algebraMap K (SeparableClosure K) (ζ 0) * α 0
      rw [h0, map_one, one_mul, AlgEquiv.one_apply]
    | succ k =>
      obtain ⟨g₀, hg₀⟩ := hunit k
      haveI : NeZero (ℓ ^ (k + 1)) := ⟨(pow_pos hℓ.pos _).ne'⟩
      haveI : Fact (1 < ℓ ^ (k + 1)) := ⟨one_lt_pow' hℓ.one_lt (by omega)⟩
      have hcop : Nat.Coprime (χm (k + 1) g₀).val (ℓ ^ (k + 1)) := by
        apply Nat.Coprime.pow_right
        exact ((Nat.Prime.coprime_iff_not_dvd hℓ).mpr hg₀).symm
      have hu : IsUnit (χm (k + 1) g₀) := by
        have := (ZMod.isUnit_iff_coprime _ (ℓ ^ (k + 1))).mpr hcop
        rwa [ZMod.natCast_zmod_val] at this
      obtain ⟨v, hv⟩ := hu
      have hχ1 : χm (k + 1) 1 = 0 := by
        have := hχadd (k + 1) 1 1
        rw [mul_one] at this
        linear_combination -this
      have hpow : ∀ n : ℕ, χm (k + 1) (g₀ ^ n) = (n : ZMod (ℓ ^ (k + 1))) * χm (k + 1) g₀ := by
        intro n
        induction n with
        | zero => rw [pow_zero, hχ1, Nat.cast_zero, zero_mul]
        | succ n ih => rw [pow_succ g₀ n, hχadd, ih, Nat.cast_succ, add_mul, one_mul]
      refine ⟨g₀ ^ ((v⁻¹ : (ZMod (ℓ ^ (k + 1)))ˣ) : ZMod (ℓ ^ (k + 1))).val, ?_⟩
      have hval : χm (k + 1) (g₀ ^ ((v⁻¹ : (ZMod (ℓ ^ (k + 1)))ˣ) :
          ZMod (ℓ ^ (k + 1))).val) = 1 := by
        rw [hpow, ZMod.natCast_zmod_val, ← hv, Units.inv_mul]
      show (g₀ ^ ((v⁻¹ : (ZMod (ℓ ^ (k + 1)))ˣ) : ZMod (ℓ ^ (k + 1))).val) (α (k + 1)) =
        algebraMap K (SeparableClosure K) (ζ (k + 1)) * α (k + 1)
      rw [hχ, hval, ZMod.val_one, pow_one]
  obtain ⟨γ, hγ⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed C hdec hCne
    (hCcl 0).isCompact hCcl
  exact ⟨γ, fun m => Set.mem_iInter.mp hγ m⟩

theorem wc_mnt_sepclosed_kummer_aut (A : Type u) [CommRing A] [IsDomain A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓA : IsUnit ((ℓ : ℕ) : A)) (ϖ : A) (hϖm : ϖ ∈ IsLocalRing.maximalIdeal A) (hϖ0 : ϖ ≠ 0)
    (hdvr : ∀ a : A, a ≠ 0 → ∃ (u : Aˣ) (n : ℕ), a = u * ϖ ^ n)
    (L : Type u) [Field L] [IsSepClosed L] [Algebra A L] [Algebra (FractionRing A) L]
    [IsScalarTower A (FractionRing A) L] [Algebra.IsSeparable (FractionRing A) L] :
    ∃ σ : L →+* L, σ.comp (algebraMap A L) = algebraMap A L ∧ wcMntTame ℓ (algebraMap A L) σ ϖ :=
by
  classical
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos

  have hunit : ∀ m : ℕ, IsUnit (((ℓ ^ m : ℕ)) : A) := fun m => by
    rw [Nat.cast_pow]; exact hℓA.pow m
  have H := fun m => wc_skc_hensel_roots A (ℓ ^ m) (hunit m)
  obtain ⟨-, -, -, hℓK, hϖK0, -, hK1, -, hK3, -⟩ :=
    wc_skc_kummer_from_dvr A ϖ (RingEquiv.refl A) ℓ 1 (IsLocalRing.ResidueField A)
      (IsLocalRing.residue A) hϖm hϖ0 hdvr rfl hℓA (fun m => (H m).1) (fun m => (H m).2.1)
      (fun m => (H m).2.2) (IsLocalRing.ker_residue) (fun a => by simp)
  have hnot : ¬ ∃ y : FractionRing A, algebraMap A (FractionRing A) ϖ = y ^ ℓ := by
    rintro ⟨y, hy⟩
    have h := hK3 1 1 ⟨y, by rw [zpow_one, pow_one]; exact hy⟩
    rw [pow_one] at h
    have h2 : ℓ ∣ 1 := by exact_mod_cast h
    exact (Fact.out : ℓ.Prime).one_lt.ne' (Nat.dvd_one.mp h2)

  obtain ⟨ζ, hζ, hζc⟩ := wc_kummer_compatible_roots (FractionRing A) ℓ hK1
  have hinj0 : Function.Injective
      (algebraMap (FractionRing A) (SeparableClosure (FractionRing A))) :=
    (algebraMap (FractionRing A) (SeparableClosure (FractionRing A))).injective
  haveI : NeZero ((ℓ : ℕ) : SeparableClosure (FractionRing A)) := ⟨by
    rw [← map_natCast (algebraMap (FractionRing A) (SeparableClosure (FractionRing A)))]
    exact fun h => hℓK (hinj0 (h.trans (map_zero _).symm))⟩
  have hroot : ∀ x : SeparableClosure (FractionRing A), ∃ z, z ^ ℓ = x :=
    fun x => IsSepClosed.exists_pow_nat_eq x ℓ
  choose r hr using hroot
  obtain ⟨α, hα0, hαc⟩ : ∃ α : ℕ → SeparableClosure (FractionRing A),
      α 0 = algebraMap (FractionRing A) (SeparableClosure (FractionRing A))
        (algebraMap A (FractionRing A) ϖ) ∧ ∀ m, α (m + 1) ^ ℓ = α m :=
    ⟨fun m => r^[m] (algebraMap (FractionRing A) (SeparableClosure (FractionRing A))
        (algebraMap A (FractionRing A) ϖ)), rfl,
      fun m => by simp only [Function.iterate_succ_apply', hr]⟩
  have hpow : ∀ m, α m ^ (ℓ ^ m) = algebraMap (FractionRing A)
      (SeparableClosure (FractionRing A)) (algebraMap A (FractionRing A) ϖ) := by
    intro m
    induction m with
    | zero => rw [pow_zero, pow_one, hα0]
    | succ m ih => rw [pow_succ' ℓ m, pow_mul, hαc, ih]
  have hϖs0 : algebraMap (FractionRing A) (SeparableClosure (FractionRing A))
      (algebraMap A (FractionRing A) ϖ) ≠ 0 :=
    fun h => hϖK0 (hinj0 (h.trans (map_zero _).symm))
  have hαne : ∀ m, α m ≠ 0 := fun m h => hϖs0 (by
    rw [← hpow m, h, zero_pow (pow_pos hℓpos m).ne'])
  have hchar : ∀ m : ℕ, ∃ χ : (SeparableClosure (FractionRing A) ≃ₐ[FractionRing A]
      SeparableClosure (FractionRing A)) → ZMod (ℓ ^ m),
      (∀ g, g (α m) = algebraMap (FractionRing A) (SeparableClosure (FractionRing A)) (ζ m) ^
        (χ g).val * α m) ∧ (∀ g h, χ (g * h) = χ g + χ h) := by
    intro m
    haveI : NeZero (ℓ ^ m) := NeZero.of_pos (pow_pos hℓpos m)
    obtain ⟨χ, h1, h2, -⟩ := wc_kummer_level_char (FractionRing A) (ℓ ^ m) (ζ m) (hζ m) (α m)
      (hαne m) ⟨_, hpow m⟩
    exact ⟨χ, h1, h2⟩
  choose χm hχ hχadd using hchar
  obtain ⟨γ, hγ⟩ := wc_kummer_generator_exists (FractionRing A) ℓ
    (algebraMap A (FractionRing A) ϖ) hnot ζ hζ hζc α hα0 hαc χm hχ hχadd

  have hγall : ∀ (m : ℕ) (w : SeparableClosure (FractionRing A)),
      w ^ (ℓ ^ m) = algebraMap (FractionRing A) (SeparableClosure (FractionRing A))
        (algebraMap A (FractionRing A) ϖ) →
      γ w = algebraMap (FractionRing A) (SeparableClosure (FractionRing A)) (ζ m) * w := by
    intro m w hw
    haveI : NeZero (ℓ ^ m) := NeZero.of_pos (pow_pos hℓpos m)
    have hξ : (w * (α m)⁻¹) ^ (ℓ ^ m) = 1 := by
      rw [mul_pow, inv_pow, hw, hpow m, mul_inv_cancel₀ hϖs0]
    obtain ⟨i, -, hi⟩ := ((hζ m).map_of_injective hinj0).eq_pow_of_pow_eq_one hξ
    have hfix : γ (w * (α m)⁻¹) = w * (α m)⁻¹ := by
      rw [← hi, ← map_pow, AlgEquiv.commutes]
    calc γ w = γ ((w * (α m)⁻¹) * α m) := by rw [inv_mul_cancel_right₀ (hαne m)]
      _ = (w * (α m)⁻¹) * (algebraMap (FractionRing A) (SeparableClosure (FractionRing A))
            (ζ m) * α m) := by rw [map_mul, hfix, hγ m]
      _ = algebraMap (FractionRing A) (SeparableClosure (FractionRing A)) (ζ m) *
            ((w * (α m)⁻¹) * α m) := by ring
      _ = algebraMap (FractionRing A) (SeparableClosure (FractionRing A)) (ζ m) * w := by
            rw [inv_mul_cancel_right₀ (hαne m)]

  haveI : IsSepClosure (FractionRing A) L := isSepClosure_iff.mpr ⟨inferInstance, inferInstance⟩
  let e : L ≃ₐ[FractionRing A] SeparableClosure (FractionRing A) :=
    IsSepClosure.equiv (FractionRing A) L (SeparableClosure (FractionRing A))
  let φ : L ≃ₐ[FractionRing A] L := (e.trans γ).trans e.symm
  refine ⟨φ.toRingEquiv.toRingHom, ?_, ?_⟩
  · ext a
    show φ (algebraMap A L a) = algebraMap A L a
    rw [IsScalarTower.algebraMap_apply A (FractionRing A) L, φ.commutes]
  · unfold wcMntTame
    intro k _ z hz
    show IsPrimitiveRoot (φ z * z⁻¹) (ℓ ^ k)
    rw [IsScalarTower.algebraMap_apply A (FractionRing A) L] at hz
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow (pow_pos hℓpos k).ne'] at hz
      exact hϖK0 ((algebraMap (FractionRing A) L).injective (hz.symm.trans (map_zero _).symm))
    have hez : e z ^ (ℓ ^ k) = algebraMap (FractionRing A) (SeparableClosure (FractionRing A))
        (algebraMap A (FractionRing A) ϖ) := by
      rw [← map_pow, hz, AlgEquiv.commutes]
    have hφz : φ z = algebraMap (FractionRing A) L (ζ k) * z := by
      show e.symm (γ (e z)) = _
      rw [hγall k (e z) hez, map_mul, AlgEquiv.commutes, AlgEquiv.symm_apply_apply]
    rw [hφz, mul_inv_cancel_right₀ hz0]
    exact (hζ k).map_of_injective (algebraMap (FractionRing A) L).injective

theorem wc_mnt_tame_inertia_exists (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∃ ϖ : A, IsLocalRing.maximalIdeal A = Ideal.span {ϖ} ∧
      ∃ τ : E ⟶ E, τ ≫ a₀ = a₀ ∧
        wcMntTame ℓ (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom
          (Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom)).hom ϖ :=
by
  classical

  obtain ⟨c, ψ, j, hj, hfac, hW, hcl⟩ :=
    wc_skc_chart_factor F'' (D.S i) (D.hS i) V A e hV
  have hmem : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    have h1 := (hcl (e.inv (IsLocalRing.closedPoint A))).mp (by rw [hV]; exact subset_closure rfl)
    have h2 : e.hom (e.inv (IsLocalRing.closedPoint A)) = IsLocalRing.closedPoint A := by
      first
      | (have h := Scheme.Hom.comp_apply e.inv e.hom (IsLocalRing.closedPoint A)
         rw [Iso.inv_hom_id] at h
         exact h.symm)
      | (have h := Scheme.Hom.comp_apply e.inv e.hom (IsLocalRing.closedPoint A)
         rw [Iso.inv_hom_id] at h
         exact h.symm.trans (by simp))
      | simp
      | (erw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl)
    rw [h2] at h1
    exact h1
  obtain ⟨hdom, hϖ0, hdvr⟩ := wc_skc_dvr F'' A c ψ hW hmem
  have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have hq : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F''
    have hcop : Nat.Coprime ℓ (Nat.card F'') :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out)).mpr hℓ
    have hg := Nat.gcd_eq_gcd_ab ℓ (Nat.card F'')
    rw [Nat.Coprime.gcd_eq_one hcop] at hg
    have h3 := congrArg (Int.cast : ℤ → F'') hg
    push_cast at h3
    rw [h0, hq] at h3
    simp at h3
  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have h1 : ψ (Polynomial.C ((ℓ : ℕ) : F'')) = ((ℓ : ℕ) : A) := by simp
    rw [← h1]
    exact ((isUnit_iff_ne_zero.mpr hℓF).map Polynomial.C).map ψ
  generalize ψ (Polynomial.X - Polynomial.C c) = ϖ at hmem hϖ0 hdvr
  haveI := hdom
  have hspan : IsLocalRing.maximalIdeal A = Ideal.span {ϖ} := by
    apply le_antisymm
    · intro a ha
      by_cases ha0 : a = 0
      · rw [ha0]; exact Ideal.zero_mem _
      obtain ⟨u, k, rfl⟩ := hdvr a ha0
      cases k with
      | zero =>
        exfalso
        rw [pow_zero, mul_one] at ha
        exact (IsLocalRing.mem_maximalIdeal _).mp ha u.isUnit
      | succ k =>
        rw [Ideal.mem_span_singleton']
        exact ⟨u * ϖ ^ k, by rw [pow_succ]; ring⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]; exact hmem
  refine ⟨ϖ, hspan, ?_⟩

  have hinj := wc_mnt_point_map_injective F'' D.m D.S i V A e hV E a₀ L eE hE ϖ hspan hdvr
  have hWE := wc_mnt_point_map_weaklyEtale (wcP1Over F'').left V E a₀ A L e eE
  letI : Algebra A L := (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom.toAlgebra
  letI : Algebra (FractionRing A) L := (IsFractionRing.lift hinj).toAlgebra
  haveI : IsScalarTower A (FractionRing A) L := IsScalarTower.of_algebraMap_eq
    (fun a => (IsFractionRing.lift_algebraMap (K := FractionRing A) hinj a).symm)

  obtain ⟨hWK, hAlg⟩ := wc_mnt_fraction_field_weaklyEtale_algebraic A L hWE
  haveI := wc_mnt_weaklyEtale_field_isSeparable (FractionRing A) L hWK hAlg

  obtain ⟨σ, hσA, htame⟩ := wc_mnt_sepclosed_kummer_aut A ℓ hℓA ϖ hmem hϖ0 hdvr L

  have hkey : Spec.map (CommRingCat.ofHom (algebraMap A L)) = eE.inv ≫ a₀.left ≫ e.hom := by
    show Spec.map (CommRingCat.ofHom (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom) = _
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hkey2 : eE.inv ≫ a₀.left = Spec.map (CommRingCat.ofHom (algebraMap A L)) ≫ e.inv := by
    rw [hkey]; simp
  let τl : E.left ⟶ E.left := eE.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eE.inv
  have hσ' : Spec.map (CommRingCat.ofHom σ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A L)) =
      Spec.map (CommRingCat.ofHom (algebraMap A L)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hσA]
  have hτl : τl ≫ a₀.left = a₀.left := by
    calc τl ≫ a₀.left = eE.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ (eE.inv ≫ a₀.left) := by
          simp only [τl, Category.assoc]
      _ = eE.hom ≫ (Spec.map (CommRingCat.ofHom σ) ≫
            Spec.map (CommRingCat.ofHom (algebraMap A L))) ≫ e.inv := by
          rw [hkey2]; simp only [Category.assoc]
      _ = eE.hom ≫ eE.inv ≫ a₀.left := by rw [hσ', hkey2]
      _ = a₀.left := by simp
  have hτw : τl ≫ E.hom = E.hom := by
    rw [← MorphismProperty.Over.w a₀, ← Category.assoc, hτl]
  let τ : E ⟶ E := MorphismProperty.Over.homMk τl hτw trivial
  refine ⟨τ, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact hτl
  · have h1 : eE.inv ≫ τ.left ≫ eE.hom = Spec.map (CommRingCat.ofHom σ) := by
      show eE.inv ≫ (eE.hom ≫ Spec.map (CommRingCat.ofHom σ) ≫ eE.inv) ≫ eE.hom = _
      simp
    have hστ : (Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom)).hom = σ := by
      rw [h1, Spec.preimage_map, CommRingCat.hom_ofHom]
    rw [hστ]
    exact htame

theorem wc_ladic_restr_exact_of_torsion {Y T F : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace F] [QuasiSeparatedSpace F]
    (p : T ⟶ Y) (r : F ⟶ T) (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Dr : wcHMPullData r ℓ) (hDr : wcHMPullCanonical Dr) (q : ℕ)
    (hfinY : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) q))
    (hfinT : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt T (ℓ ^ k) (q - 1)))
    (hex : ∀ k : ℕ, 1 ≤ k → ∀ (Dpk : wcZModPullData p (ℓ ^ k)), wcZModPullCanonical Dpk →
      ∀ (Drk : wcZModPullData r (ℓ ^ k)), wcZModPullCanonical Drk →
      ∀ z : wcZModProEtExt T (ℓ ^ k) q, wcZModPull Drk q z = 0 →
        z ∈ Set.range (wcZModPull Dpk q)) :
    ∀ y : wcHM T ℓ q, wcHMPull Dr q y = 0 → y ∈ Set.range (wcHMPull Dp q) :=
by
  classical
  intro y hy
  haveI hEZY : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf Y n)) :=
    fun n => HasExt.standard _
  haveI hEZT : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) :=
    fun n => HasExt.standard _
  haveI hEZF : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf F n)) :=
    fun n => HasExt.standard _
  haveI hERY : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  haveI hERT : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  haveI hERF : HasExt (SheafOfModules.{u+1} (wcRingSheaf F ℓ)) := HasExt.standard _
  have hℓ : Nat.Prime ℓ := Fact.out

  obtain ⟨EY, hEY⟩ := wc_int_rat_data_exists Y ℓ
  obtain ⟨ET, hET⟩ := wc_int_rat_data_exists T ℓ
  obtain ⟨EF, hEF⟩ := wc_int_rat_data_exists F ℓ
  obtain ⟨DΛp, hDΛp⟩ := wc_int_pull_data_exists p ℓ
  obtain ⟨DΛr, hDΛr⟩ := wc_int_pull_data_exists r ℓ
  obtain ⟨hmul, hone, -, hnat⟩ := wc_hmScalar_laws T ℓ q
  have hpow : ∀ (m : ℕ) (x : wcHM T ℓ q),
      wcHMScalar T ℓ q ((ℓ : ℚ_[ℓ]) ^ m) x = (ℓ ^ m : ℕ) • x := by
    intro m x
    rw [hnat, Nat.cast_pow]

  obtain ⟨n₀, w, hw⟩ := (wc_int_rat_rationalization T ℓ ET hET q).1 y

  have hrw : wcIntRho EF q (wcIntPull DΛr q w) = 0 := by
    rw [wc_int_rat_pull_compat ℓ r Dr hDr DΛr hDΛr ET hET EF hEF q w, ← hw, hpow, map_nsmul,
      hy, nsmul_zero]
  obtain ⟨s, hs⟩ := (wc_int_rat_rationalization F ℓ EF hEF q).2 _ hrw
  have hw' : wcIntPull DΛr q ((ℓ ^ s : ℕ) • w) = 0 := by rw [map_nsmul, hs]

  choose Dpk hDpk using fun k => wc_zmod_pull_data_exists p (ℓ ^ k)
  choose Drk hDrk using fun k => wc_zmod_pull_data_exists r (ℓ ^ k)
  obtain ⟨hTrY, htY⟩ := wc_int_red_transfer Y ℓ
  obtain ⟨hTrT, htT⟩ := wc_int_red_transfer T ℓ
  obtain ⟨hTrF, htF⟩ := wc_int_red_transfer F ℓ
  have Cp := wc_int_red_pull_compat ℓ p DΛp Dpk hTrY htY hTrT htT
    (fun k => wc_int_zmod_pull_restrict_iso ℓ p k DΛp hDΛp (Dpk k) (hDpk k)) q
  have Cr := wc_int_red_pull_compat ℓ r DΛr Drk hTrT htT hTrF htF
    (fun k => wc_int_zmod_pull_restrict_iso ℓ r k DΛr hDΛr (Drk k) (hDrk k)) q
  have MY := wc_int_red_milnor Y ℓ hTrY htY q
  have MT := wc_int_red_milnor T ℓ hTrT htT q
  have hrange : ∀ k, 1 ≤ k →
      wcIntRed T ℓ k q ((ℓ ^ s : ℕ) • w) ∈ Set.range (wcZModPull (Dpk k) q) := by
    intro k hk
    apply hex k hk (Dpk k) (hDpk k) (Drk k) (hDrk k)
    rw [← Cr.1 k ((ℓ ^ s : ℕ) • w), hw', map_zero]

  have konig : ∃ α : ∀ k, wcZModProEtExt Y (ℓ ^ k) q,
      (∀ k, 1 ≤ k → wcIntRedTau Y ℓ k q (α (k + 1)) = α k) ∧
      ∀ k, 1 ≤ k → wcZModPull (Dpk k) q (α k) = wcIntRed T ℓ k q ((ℓ ^ s : ℕ) • w) := by
    let X : ℕ → Type _ := fun j => {a : wcZModProEtExt Y (ℓ ^ (j + 1)) q //
      wcZModPull (Dpk (j + 1)) q a = wcIntRed T ℓ (j + 1) q ((ℓ ^ s : ℕ) • w)}
    let f : ∀ j, X (j + 1) → X j := fun j a => ⟨wcIntRedTau Y ℓ (j + 1) q a.1, by
      rw [← Cp.2 (j + 1) q a.1, a.2, MT.1 (j + 1) _ (by omega)]⟩
    let G := Functor.ofOpSequence (X := X) (fun j => TypeCat.ofHom (f j))
    haveI : ∀ j, Finite (G.obj j) := fun j => by
      haveI := hfinY (j.unop + 1) (by omega)
      exact (Subtype.finite : Finite (X j.unop))
    haveI : ∀ j, Nonempty (G.obj j) := fun j => by
      obtain ⟨a, ha⟩ := hrange (j.unop + 1) (by omega)
      exact ⟨(⟨a, ha⟩ : X j.unop)⟩
    obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system G
    have hcompat : ∀ j, (f j (sec (Opposite.op (j + 1)))).1 = (sec (Opposite.op j)).1 := by
      intro j
      have := hsec (homOfLE (Nat.le_succ j)).op
      rw [Functor.ofOpSequence_map_homOfLE_succ] at this
      exact congrArg Subtype.val this
    let α : ∀ k, wcZModProEtExt Y (ℓ ^ k) q := fun k => match k with
      | 0 => 0
      | j + 1 => (sec (Opposite.op j)).1
    refine ⟨α, ?_, ?_⟩
    · intro k hk
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      exact hcompat j
    · intro k hk
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      exact (sec (Opposite.op j)).2
  obtain ⟨α, hα1, hα2⟩ := konig
  obtain ⟨v, hv⟩ := MY.2.1 α hα1
  have hL := wc_tower_lim1_of_ml _
    (wc_tower_ml_of_finite (fun k => wcIntRedTau T ℓ k (q - 1)) hfinT)
  have hd : wcIntPull DΛp q v - (ℓ ^ s : ℕ) • w = 0 := MT.2.2.1 hL _ (fun k hk => by
    rw [map_sub, Cp.1 k v, hv k hk, hα2 k hk, sub_self])
  have hpv : wcIntPull DΛp q v = (ℓ ^ s : ℕ) • w := sub_eq_zero.mp hd

  have hpullsc : ∀ (c : ℚ_[ℓ]) (z : wcHM Y ℓ q),
      wcHMPull Dp q (wcHMScalar Y ℓ q c z) = wcHMScalar T ℓ q c (wcHMPull Dp q z) := by
    intro c z
    have hc := wc_hm_pull_const Dp hDp c
    haveI := Dp.additive
    haveI := Dp.presLim
    haveI := Dp.presColim
    show (Abelian.Ext.mk₀ Dp.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dp.Φ
          (z.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero q))).comp
          (Abelian.Ext.mk₀ Dp.μ.hom) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ Dp.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dp.Φ z).comp
          (Abelian.Ext.mk₀ Dp.μ.hom) (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (wcHMConst T ℓ c)) (add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, ← hc]
    generalize Abelian.Ext.mapExactFunctor Dp.Φ z = w
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero w
        (Abelian.Ext.mk₀ (Dp.Φ.map (wcHMConst Y ℓ c))) (Abelian.Ext.mk₀ Dp.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ Dp.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ Dp.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  have hpull_v : wcHMPull Dp q (wcIntRho EY q v) = (ℓ ^ n₀ * ℓ ^ s : ℕ) • y := by
    rw [← wc_int_rat_pull_compat ℓ p Dp hDp DΛp hDΛp EY hEY ET hET q v, hpv, map_nsmul, ← hw,
      hpow, ← mul_nsmul]
