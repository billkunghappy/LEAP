          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (k q : ℕ), Finite (wcCohG F'' (wcP1Over F'') hP
      (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))) 2) :=
