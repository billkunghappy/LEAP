    a, hA, AlgebraicClosure L, inferInstance, inferInstance, ξ, hξ, D',
    Θa.trans (AddEquiv.ofBijective (Θ _) (hΘbij _ hc1 hq1)),
    Θb.trans (AddEquiv.ofBijective (Θ _) (hΘbij _ hc2 hq2)), fun y => ?_⟩
  exact (hΘnat _ Dk hDk Ep (Θa y)).trans (congrArg (Θ _) (hΘab y))

theorem wc_ext_leray_edge_ker_le_pull_range : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : D) (B : C) (μ : L.obj A ≅ B), letI := HasExt.standard C; letI := HasExt.standard D; (∀ k : ℕ, Function.Bijective (fun x : Abelian.Ext A A k => x.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) → ∀ (I : InjectiveResolution B) (N : ℕ), 1 ≤ N → (∀ q : ℕ, 1 ≤ q → q + 1 ≤ N → ∀ p : ℕ, Subsingleton (Abelian.Ext A (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p)) → ∀ (c : B ⟶ I.cocomplex.X N) (hc : c ≫ I.cocomplex.d N (N + 1) = 0) (hf : adj.homEquiv _ _ (μ.hom ≫ c) ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d N (N + 1) = 0), ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (adj.homEquiv _ _ (μ.hom ≫ c)) (N + 1) (by simp) hf ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ N = 0 → ∃ y : Abelian.Ext A A N, (((Abelian.Ext.mk₀ μ.inv).precomp _ (zero_add N)).comp (((Abelian.Ext.mk₀ μ.hom).postcomp _ (add_zero N)).comp (L.mapExtAddHom A A N))) y = I.extMk c (N + 1) rfl hc :=
by
  intro C D _ _ _ _ L R _ _ _ _ adj A B μ H1 I N hN H2 c hc hf hκ
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  haveI := adj.rightAdjoint_preservesLimits
  obtain ⟨M, rfl⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩

  have urecGen : ∀ (S : ShortComplex C) (hS : S.ShortExact) (n : ℕ) (h₁ : S.X₁ ⟶ I.cocomplex.X n)
      (h₂ : S.X₂ ⟶ I.cocomplex.X n) (h₃ : S.X₃ ⟶ I.cocomplex.X (n + 1))
      (hc₁ : h₁ ≫ I.cocomplex.d n (n + 1) = 0) (hc₃ : h₃ ≫ I.cocomplex.d (n + 1) (n + 1 + 1) = 0),
      S.f ≫ h₂ = h₁ → h₂ ≫ I.cocomplex.d n (n + 1) = S.g ≫ h₃ →
      hS.extClass.comp (I.extMk h₁ (n + 1) rfl hc₁) (add_comm 1 n) = I.extMk h₃ (n + 1 + 1) rfl hc₃ ∨
      hS.extClass.comp (I.extMk h₁ (n + 1) rfl hc₁) (add_comm 1 n) = -I.extMk h₃ (n + 1 + 1) rfl hc₃ := by
    open CochainComplex.HomComplex CochainComplex.mappingCone in
    · intro S hS n h₁ h₂ h₃ hc₁ hc₃ e1 e2

      have ext0 : ∀ {X : C} {K : CochainComplex C ℤ} {m : ℤ}
          (α β : Cochain ((CochainComplex.singleFunctor C 0).obj X) K m),
          α.v 0 m (zero_add m) = β.v 0 m (zero_add m) → α = β := by
        intro X K m α β h
        ext p q hpq
        by_cases hp : p = 0
        · subst hp
          obtain rfl : q = m := by omega
          exact h
        · exact (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 X p hp).eq_of_src _ _

      have uf0 : ∀ (X : C) (L : CochainComplex C ℤ) (n n' : ℤ) (h : n + 1 = n') (k : X ⟶ L.X n)
          (hk : k ≫ L.d n n' = 0),
          (Cocycle.equivHomShift.symm (Cocycle.fromSingleMk k (zero_add n) n' h hk)).f 0 =
            (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 X).hom ≫ k ≫
              (L.shiftFunctorObjXIso n 0 n (zero_add n).symm).inv := by
        intro X L n n' h k hk
        rw [Cocycle.equivHomShift_symm_apply, Cocycle.homOf_f, Cocycle.rightShift_coe,
          Cochain.rightShift_v _ _ _ _ _ _ _ n (zero_add n), Cocycle.fromSingleMk_coe,
          Cochain.fromSingleMk_v, Category.assoc]

      have A1 : ∀ (L : CochainComplex C ℤ) (n n' : ℤ) (h : n + 1 = n') (k₁ : S.X₁ ⟶ L.X n)
