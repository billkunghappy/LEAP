                (ComplexShape.embeddingUpNat_f j)).hom)
        · have hz : ∀ K : CochainComplex C ℕ,
              Limits.IsZero ((K.extend ComplexShape.embeddingUpNat).homology n) := fun K =>
            (HomologicalComplex.extend_exactAt K _ n (fun j => by
              rw [ComplexShape.embeddingUpNat_f]; omega)).isZero_homology
          exact Limits.IsZero.isIso (F.map_isZero (hz K₁)) (F.map_isZero (hz K₂)) _
      have e1 := congrArg F.map (DerivedCategory.homologyFunctorFactors_hom_naturality ψ' n)
      erw [F.map_comp, F.map_comp] at e1
      haveI : IsIso (F.map ((DerivedCategory.homologyFunctor C n).map (DerivedCategory.Q.map ψ')) ≫
          F.map ((DerivedCategory.homologyFunctorFactors C n).hom.app _)) := by
        rw [e1]; exact IsIso.comp_isIso' inferInstance hmid
      exact IsIso.of_isIso_comp_right _
        (F.map ((DerivedCategory.homologyFunctorFactors C n).hom.app _))
    have hc := hiso (p + 1)
    have ha := hiso p
    have hδ := DerivedCategory.HomologySequence.δ_comp T hT p (p + 1) rfl
    have hd : F.map (DerivedCategory.HomologySequence.δ T p (p + 1) rfl) = 0 := by
      rw [← cancel_mono (F.map ((DerivedCategory.homologyFunctor C (p + 1)).map T.mor₁)),
        Limits.zero_comp, ← F.map_comp, hδ, F.map_zero]
    have hex := (DerivedCategory.HomologySequence.exact₃ T hT p (p + 1) rfl).map F
    have hepi := (ShortComplex.exact_iff_epi _ hd).mp hex
    have h12 : T.mor₁ ≫ T.mor₂ = 0 := Pretriangulated.comp_distTriang_mor_zero₁₂ T hT
    have hb : F.map ((DerivedCategory.homologyFunctor C p).map T.mor₂) = 0 := by
      rw [← cancel_epi (F.map ((DerivedCategory.homologyFunctor C p).map T.mor₁)),
        Limits.comp_zero, ← F.map_comp, ← Functor.map_comp, h12, Functor.map_zero, F.map_zero]
    have hZ : Limits.IsZero (F.obj ((DerivedCategory.homologyFunctor C p).obj T.obj₃)) := by
      rw [Limits.IsZero.iff_id_eq_zero]
      have : Epi (F.map ((DerivedCategory.homologyFunctor C p).map T.mor₂)) := hepi
      rw [← cancel_epi (F.map ((DerivedCategory.homologyFunctor C p).map T.mor₂)), hb]
