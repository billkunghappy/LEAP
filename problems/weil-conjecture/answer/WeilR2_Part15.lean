    have hgq : g ≫ q ≫ κ = Limits.pullback.fst (Limits.pullback.snd ff aa) ξ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, hκ1, hq2, hg2]
      · rw [Category.assoc, Category.assoc, hκ2, reassoc_of% hq1, reassoc_of% hg1, hξ, c2]
    obtain ⟨Dκ⟩ := wc_et_zmod_pull_data_exists κ m
    obtain ⟨Dκ'⟩ := wc_et_zmod_pull_data_exists κ' m
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (Limits.pullback uu ff)) m
    obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists g m
    obtain ⟨Dqκ⟩ := wc_et_zmod_pull_data_exists (q ≫ κ) m
    obtain ⟨Dρ⟩ := wc_et_zmod_pull_data_exists
      (Limits.pullback.fst (Limits.pullback.snd ff aa) ξ) m
    have hid : ∀ x, wcEtPull Did j x = x := by
      intro x
      have h1 := wc_et_pull_comp (𝟙 _) (𝟙 _) (𝟙 _) (Category.id_comp _) Did Did Did j x
      have h2 := wc_et_pull_id_injective Did j (x - wcEtPull Did j x)
        (by rw [map_sub, ← h1, sub_self])
