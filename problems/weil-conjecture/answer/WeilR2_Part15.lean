  have hWa : WeaklyEtale ac := wc_shdata_weaklyEtale _ Ac Λ W' φ ac hA
  let VA : (wcP1Over F'').left.ProEt := MorphismProperty.Over.mk ⊤ ac hWa
  obtain ⟨vA⟩ := wc_P1_strict_local_geomPoint_map F'' hP VA Ac (Iso.refl _)
  obtain ⟨v₀⟩ := wc_P1_strict_local_geomPoint_map F'' hP V A e
  obtain ⟨c, -⟩ := wc_pencil_PL_shens_nbhd_rigid F'' hP (D.S i) (D.hS i) VA vA Ac (Iso.refl _)
    hacl V v₀ A e hV
  have hγ1 : c.inv.left ≫ c.hom.left = 𝟙 V.left :=
    (MorphismProperty.Comma.comp_left c.inv c.hom).symm.trans
      ((congrArg (fun (f : V ⟶ V) => f.left) c.inv_hom_id).trans rfl)
  have hγ2 : c.hom.left ≫ c.inv.left = 𝟙 VA.left :=
    (MorphismProperty.Comma.comp_left c.hom c.inv).symm.trans
      ((congrArg (fun (f : VA ⟶ VA) => f.left) c.hom_inv_id).trans rfl)
  have hγ : c.hom.left ≫ V.hom = ac := MorphismProperty.Over.w c.hom
  have hinvA : c.inv.left ≫ ac = V.hom := by
    rw [← hγ, ← Category.assoc, hγ1, Category.id_comp]
  obtain ⟨γ, hγh⟩ : ∃ γ : V.left ≅ Spec (.of Ac), γ.hom = c.inv.left :=
    ⟨⟨c.inv.left, c.hom.left, hγ1, hγ2⟩, rfl⟩
  have hγV : γ.hom ≫ ac = V.hom := by rw [hγh]; exact hinvA
  have hγinvV : γ.inv ≫ V.hom = ac := by rw [← hγV, Iso.inv_hom_id_assoc]

  have hisoG : ∀ {X₁ Pb T₁ T₂ : Scheme.{u}} (ff : X₁ ⟶ Pb) (uu : T₁ ⟶ Pb) (aa : T₂ ⟶ Pb)
      (γ' : T₁ ≅ T₂), γ'.hom ≫ aa = uu →
      ∃ κ : Limits.pullback uu ff ⟶ Limits.pullback ff aa, IsIso κ ∧
        κ ≫ Limits.pullback.fst ff aa = Limits.pullback.snd uu ff ∧
        κ ≫ Limits.pullback.snd ff aa = Limits.pullback.fst uu ff ≫ γ'.hom := by
    intro X₁ Pb T₁ T₂ ff uu aa γ' hγ'
    have hγi : γ'.inv ≫ uu = aa := by rw [← hγ', Iso.inv_hom_id_assoc]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback uu ff ⟶ Limits.pullback ff aa,
        κ ≫ Limits.pullback.fst ff aa = Limits.pullback.snd uu ff ∧
        κ ≫ Limits.pullback.snd ff aa = Limits.pullback.fst uu ff ≫ γ'.hom :=
      ⟨Limits.pullback.lift (Limits.pullback.snd uu ff) (Limits.pullback.fst uu ff ≫ γ'.hom)
        (by rw [Category.assoc, hγ']; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨κ', hκ'1, hκ'2⟩ : ∃ κ' : Limits.pullback ff aa ⟶ Limits.pullback uu ff,
        κ' ≫ Limits.pullback.fst uu ff = Limits.pullback.snd ff aa ≫ γ'.inv ∧
        κ' ≫ Limits.pullback.snd uu ff = Limits.pullback.fst ff aa :=
      ⟨Limits.pullback.lift (Limits.pullback.snd ff aa ≫ γ'.inv) (Limits.pullback.fst ff aa)
        (by rw [Category.assoc, hγi]; exact Limits.pullback.condition.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hκκ' : κ ≫ κ' = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hκ'1, reassoc_of% hκ2, Iso.hom_inv_id, Category.comp_id,
          Category.id_comp]
      · rw [Category.assoc, hκ'2, hκ1, Category.id_comp]
    have hκ'κ : κ' ≫ κ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hκ1, hκ'2, Category.id_comp]
      · rw [Category.assoc, hκ2, reassoc_of% hκ'1, Iso.inv_hom_id, Category.comp_id,
          Category.id_comp]
    exact ⟨κ, ⟨⟨κ', hκκ', hκ'κ⟩⟩, hκ1, hκ2⟩
  obtain ⟨κ, hκiso, hκ1, hκ2⟩ := hisoG D.f V.hom ac γ hγV
  haveI := hκiso
  have hx₀ : Limits.pullback.fst D.f ac (κ x) = D.xs i (IsLocalRing.closedPoint F'') := by
    have h1 := Scheme.Hom.comp_apply κ (Limits.pullback.fst D.f ac) x
    rw [hκ1] at h1
    exact h1.symm.trans hx₂
  obtain ⟨ι, hι⟩ := wc_etale_geom_point_residue_iso κ x (κ x) rfl
  obtain ⟨B₀, _, _, _, Λ₀, _, _, W₀, φ₀, b₀, e₀', h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (κ x)
  have hB₀ : wcHalShData (κ x) B₀ Λ₀ W₀ φ₀ b₀ := ⟨h1, h2, h3, h4, h5, e₀', h6, h7⟩
  obtain ⟨θ, hθ⟩ := wc_shdata_etale_iso κ x (κ x) ι hι B Λ' W'' φ' a' hsh B₀ Λ₀ W₀ φ₀ b₀ hB₀
  have hc : θ.hom ≫ (b₀ ≫ Limits.pullback.snd D.f ac) =
      a' ≫ Limits.pullback.fst V.hom D.f ≫ γ.hom := by
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ Limits.pullback.snd D.f ac) hθ).trans
        ((Category.assoc _ _ _).trans (congrArg (a' ≫ ·) hκ2)))

  obtain ⟨τ, hτdef⟩ : ∃ τ : Spec (.of (AlgebraicClosure L)) ⟶ E.left,
      τ = Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫ eE.inv :=
    ⟨_, rfl⟩
  have hσ : τ ≫ eE.hom = Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) := by
    rw [hτdef, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hξ : (τ ≫ a₀.left ≫ γ.hom) (IsLocalRing.closedPoint (AlgebraicClosure L)) ≠
      IsLocalRing.closedPoint Ac := by
    intro h
    have e1 : ac ((τ ≫ a₀.left ≫ γ.hom) (IsLocalRing.closedPoint (AlgebraicClosure L))) =
        E.hom (τ (IsLocalRing.closedPoint (AlgebraicClosure L))) := by
      calc ac ((τ ≫ a₀.left ≫ γ.hom) (IsLocalRing.closedPoint (AlgebraicClosure L)))
          = (γ.hom ≫ ac) ((τ ≫ a₀.left) (IsLocalRing.closedPoint (AlgebraicClosure L))) :=
            (congrArg ac ((Scheme.Hom.comp_apply τ (a₀.left ≫ γ.hom) _).trans
              ((Scheme.Hom.comp_apply a₀.left γ.hom (τ _)).trans
                (congrArg γ.hom (Scheme.Hom.comp_apply τ a₀.left _)).symm))).trans
              (Scheme.Hom.comp_apply γ.hom ac _).symm
        _ = V.hom ((τ ≫ a₀.left) (IsLocalRing.closedPoint (AlgebraicClosure L))) := by
            rw [hγV]
        _ = (a₀.left ≫ V.hom) (τ (IsLocalRing.closedPoint (AlgebraicClosure L))) :=
            (congrArg V.hom (Scheme.Hom.comp_apply τ a₀.left _)).trans
              (Scheme.Hom.comp_apply a₀.left V.hom _).symm
        _ = E.hom (τ (IsLocalRing.closedPoint (AlgebraicClosure L))) := by
            rw [MorphismProperty.Over.w a₀]
    rw [h, hacl] at e1
    exact hE _ i e1.symm

  have hã1 : (((wcProEtPullback D.f).map a₀).left :
      Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) ≫
        Limits.pullback.fst V.hom D.f = Limits.pullback.fst E.hom D.f ≫ a₀.left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have hã2 : (((wcProEtPullback D.f).map a₀).left :
      Limits.pullback E.hom D.f ⟶ Limits.pullback V.hom D.f) ≫
        Limits.pullback.snd V.hom D.f = Limits.pullback.snd E.hom D.f := by
    first
      | exact Limits.pullback.lift_snd _ _ _
      | exact MorphismProperty.Over.w ((wcProEtPullback D.f).map a₀)
  obtain ⟨g, hsq⟩ := s2 ((wcProEtPullback D.f).obj V).left ((wcProEtPullback D.f).obj E).left
    D.f V.hom E.hom a₀.left (MorphismProperty.Over.w a₀)
    (Limits.pullback.fst V.hom D.f) (Limits.pullback.snd V.hom D.f)
    (IsPullback.of_hasPullback V.hom D.f)
    (Limits.pullback.fst E.hom D.f) (Limits.pullback.snd E.hom D.f)
    (IsPullback.of_hasPullback E.hom D.f)
    ((wcProEtPullback D.f).map a₀).left hã1 hã2 a' γ θ (b₀ ≫ Limits.pullback.snd D.f ac) hc
    τ eE _ hσ

  intro k hk
  have hm : ℓ ^ k ≠ 0 := pow_ne_zero k hℓp.ne_zero
  have hΨ : ∀ j : ℕ, Nonempty (wcEtZModExt (Limits.pullback (b₀ ≫ Limits.pullback.snd D.f ac)
      (τ ≫ a₀.left ≫ γ.hom)) (ℓ ^ k) j ≃+
      wcZModProEtExt (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ k) j) := by
    intro j
    obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists g (ℓ ^ k)
    have hb := wc_r2gs_integral_field_ext_pull_bij L (AlgebraicClosure L)
      (algebraMap L (AlgebraicClosure L)) (fun z => Algebra.IsIntegral.isIntegral z) _ _ _ g _
      hsq (ℓ ^ k) hm Dg j
    obtain ⟨Θ, hΘb, -⟩ := wc_zmod_et_proet_natural_comparison_all (ℓ ^ k) j
    exact ⟨(AddEquiv.ofBijective (wcEtPull Dg j) hb).symm.trans
      (AddEquiv.ofBijective (Θ _) (hΘb _ hcF hqF))⟩

  have hcyc := wc_pencil_odp_shens_milnor_fibre_top_cyclic F' F'' Y n hn hn2 D ℓ hℓp hℓ k i Ac Λ
    W' φ ac hA (κ x) hx₀ B₀ Λ₀ W₀ φ₀ b₀ hB₀ (AlgebraicClosure L) (τ ≫ a₀.left ≫ γ.hom) hξ
  obtain ⟨hcard0, hlow⟩ := wc_pencil_odp_shens_milnor_fibre_low F' F'' Y n hn hn2 D ℓ hℓp hℓ k i
    Ac Λ W' φ ac hA (κ x) hx₀ B₀ Λ₀ W₀ φ₀ b₀ hB₀ (AlgebraicClosure L) (τ ≫ a₀.left ≫ γ.hom) hξ
  have hfinC : Finite (wcEtCoh (Limits.pullback (b₀ ≫ Limits.pullback.snd D.f ac)
      (τ ≫ a₀.left ≫ γ.hom)) (ℓ ^ k) (n - 1 - 1)) := by
    obtain ⟨r, hr⟩ := hn
    rcases (show n - 1 - 1 = 0 ∨ (1 ≤ n - 1 - 1 ∧ n - 1 - 1 + 2 ≤ n) by omega) with h0 | h0
    · rw [h0]
      exact Nat.finite_of_card_ne_zero (by rw [hcard0]; exact hm)
    · haveI := hlow (n - 1 - 1) h0.1 h0.2
      exact Finite.of_subsingleton
  have hfinEt : Finite (wcEtZModExt (Limits.pullback (b₀ ≫ Limits.pullback.snd D.f ac)
      (τ ≫ a₀.left ≫ γ.hom)) (ℓ ^ k) (n - 1 - 1)) := by
    obtain ⟨Ez⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (b₀ ≫ Limits.pullback.snd D.f ac)
      (τ ≫ a₀.left ≫ γ.hom)) (ℓ ^ k) (n - 1 - 1)
    exact Finite.of_equiv _ Ez.symm

  refine ⟨?_, ?_, ?_⟩
  · obtain ⟨Ψ⟩ := hΨ (n - 1)
    haveI := hcyc
    exact isAddCyclic_of_surjective Ψ Ψ.surjective
  · intro z
    obtain ⟨Ψ⟩ := hΨ (n - 1)
    have h := congrArg Ψ (htors _ (ℓ ^ k) (n - 1) (Ψ.symm z))
    rwa [map_nsmul, AddEquiv.apply_symm_apply, map_zero] at h
  · obtain ⟨Ψ⟩ := hΨ (n - 1 - 1)
    exact Finite.of_equiv _ Ψ.toEquiv

theorem wc_mnt_fib_rank_le_one (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ κ : wcHM (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1) →+ ℚ_[ℓ],
      Function.Injective κ ∧
      ∀ (c : ℚ_[ℓ]) (v : wcHM (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1)),
        κ (wcHMScalar (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1) c v) =
          c * κ v :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hdeg : n - 1 = (n - 2) + 1 := by omega

  obtain ⟨hcV, hqV, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V A e
  obtain ⟨hcE, hqE, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D E L eE
  haveI := hcV
  haveI := hqV
  haveI := hcE
  haveI := hqE
  haveI : QuasiCompact a' := (quasiCompact_iff_compactSpace a').mpr inferInstance
  haveI : QuasiSeparated a' := QuasiSeparated.of_quasiSeparatedSpace a'
  haveI : CompactSpace
      ↥(Limits.pullback a' ((wcProEtPullback D.f).map a₀).left : Scheme.{u}) := inferInstance
  haveI : QuasiSeparatedSpace
      ↥(Limits.pullback a' ((wcProEtPullback D.f).map a₀).left : Scheme.{u}) :=
    quasiSeparatedSpace_of_quasiSeparated
      (Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left)

  have hvZ : ∀ m : ℕ, Subsingleton (wcZModProEtExt (Spec (.of B)) m (n - 1)) := by
    intro m
    rw [hdeg]
    obtain ⟨Θ, hΘb, -⟩ := wc_zmod_et_proet_natural_comparison_all.{u} m (n - 2 + 1)
    obtain ⟨E₂⟩ := wc_et_zmodext_coh_equiv (Spec (.of B)) m (n - 2 + 1)
    haveI h1 : Subsingleton (wcEtCoh (Spec (.of B)) m (n - 2 + 1)) := by
      first
      | exact wc_et_strictly_local_ext_vanishing B _ (n - 2)
      | (unfold wcEtCoh; exact wc_et_strictly_local_ext_vanishing B _ (n - 2))
    haveI h2 : Subsingleton (wcEtZModExt (Spec (.of B)) m (n - 2 + 1)) := E₂.subsingleton
    exact (AddEquiv.ofBijective (Θ (Spec (.of B)))
      (hΘb _ inferInstance inferInstance)).symm.toEquiv.subsingleton
  have hvQ : ∀ z : wcHM (Spec (.of B)) ℓ (n - 1), z = 0 := by
    rw [hdeg]
    intro z
    haveI := wc_proet_free_projective_strict_local (Spec (.of B))
      (Scheme.ProEt.mk (𝟙 (Spec (.of B)))) B (Iso.refl _)
    exact wc_hm_vanish_of_int_ext_vanish (Spec (.of B)) ℓ (n - 2)
      (wc_proet_int_ext_vanish_of_zmod (Spec (.of B)) ℓ _
        (fun k j y => Abelian.Ext.eq_zero_of_projective y) (n - 2)) z

  obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists
    (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left) ℓ
  choose Dk hDk using fun k : ℕ =>
    wc_zmod_pull_data_exists (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ k)

  have hT := wc_mnt_fib_torsion_facts F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE x hx₁ hx₂
    B Λ' W'' φ' a' hsh

  have hring : ∀ k : ℕ, ∀ a b : ZMod (ℓ ^ k),
      ∃ e₁ e₂ : ZMod (ℓ ^ k), (IsUnit e₁ ∨ IsUnit e₂) ∧ e₁ * a + e₂ * b = 0 := by
    intro k a b
    by_cases ha : a = 0
    · exact ⟨1, 0, Or.inl isUnit_one, by rw [ha]; ring⟩
    by_cases hb : b = 0
    · exact ⟨0, 1, Or.inr isUnit_one, by rw [hb]; ring⟩
    have hav : a.val ≠ 0 := fun h => ha ((ZMod.val_eq_zero a).mp h)
    have hbv : b.val ≠ 0 := fun h => hb ((ZMod.val_eq_zero b).mp h)
    obtain ⟨α, a₁, ha₁, haeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hav ℓ hℓp.one_lt.ne'
    obtain ⟨β, b₁, hb₁, hbeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hbv ℓ hℓp.one_lt.ne'
    have hunit : ∀ y : ℕ, ¬ ℓ ∣ y → IsUnit (y : ZMod (ℓ ^ k)) := by
      intro y hy
      exact (ZMod.isUnit_iff_coprime y (ℓ ^ k)).mpr
        (((Nat.Prime.coprime_iff_not_dvd hℓp).mpr hy).symm.pow_right k)
    have ha' : a = (ℓ : ZMod (ℓ ^ k)) ^ α * (a₁ : ZMod (ℓ ^ k)) := by
      rw [← ZMod.natCast_zmod_val a, haeq]; push_cast; ring
    have hb' : b = (ℓ : ZMod (ℓ ^ k)) ^ β * (b₁ : ZMod (ℓ ^ k)) := by
      rw [← ZMod.natCast_zmod_val b, hbeq]; push_cast; ring
    rcases le_or_gt α β with hαβ | hαβ
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hαβ
      have hu := hunit a₁ ha₁
      refine ⟨-((ℓ : ZMod (ℓ ^ k)) ^ d * (b₁ : ZMod (ℓ ^ k))) * ↑hu.unit⁻¹, 1,
        Or.inr isUnit_one, ?_⟩
      have hw := hu.val_inv_mul
      rw [ha', hb', pow_add]
      linear_combination (-((ℓ : ZMod (ℓ ^ k)) ^ d * (b₁ : ZMod (ℓ ^ k)) *
        (ℓ : ZMod (ℓ ^ k)) ^ α)) * hw
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hαβ.le
      have hu := hunit b₁ hb₁
      refine ⟨1, -((ℓ : ZMod (ℓ ^ k)) ^ d * (a₁ : ZMod (ℓ ^ k))) * ↑hu.unit⁻¹,
        Or.inl isUnit_one, ?_⟩
      have hw := hu.val_inv_mul
      rw [ha', hb', pow_add]
      linear_combination (-((ℓ : ZMod (ℓ ^ k)) ^ d * (a₁ : ZMod (ℓ ^ k)) *
        (ℓ : ZMod (ℓ ^ k)) ^ β)) * hw

  have hinj : ∀ k : ℕ, 1 ≤ k → Function.Injective (wcZModPull (Dk k) (n - 1)) := by
    intro k _ a b _
    haveI := hvZ (ℓ ^ k)
    exact Subsingleton.elim a b
  have hcyc : ∀ k : ℕ, 1 ≤ k → ∀ z₁ z₂ : wcZModProEtExt
      (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ k) (n - 1),
      ∃ e₁ e₂ : ZMod (ℓ ^ k), (IsUnit e₁ ∨ IsUnit e₂) ∧
        e₁.val • z₁ + e₂.val • z₂ ∈ Set.range (wcZModPull (Dk k) (n - 1)) := by
    intro k hk z₁ z₂
    obtain ⟨hc, ht, -⟩ := hT k hk
    haveI := hc
    obtain ⟨h, hh⟩ := IsAddCyclic.exists_generator (α := wcZModProEtExt
      (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) (ℓ ^ k) (n - 1))
    obtain ⟨c₁, hc₁⟩ := AddSubgroup.mem_zmultiples_iff.mp (hh z₁)
    obtain ⟨c₂, hc₂⟩ := AddSubgroup.mem_zmultiples_iff.mp (hh z₂)
    subst hc₁ hc₂
    obtain ⟨e₁, e₂, hu, he⟩ := hring k (c₁ : ZMod (ℓ ^ k)) (c₂ : ZMod (ℓ ^ k))
    refine ⟨e₁, e₂, hu, 0, ?_⟩
    rw [map_zero]
    haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ hℓp.ne_zero⟩
    have hdiv : ((ℓ ^ k : ℕ) : ℤ) ∣ (e₁.val : ℤ) * c₁ + (e₂.val : ℤ) * c₂ := by
      rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_add, Int.cast_mul, Int.cast_mul,
        Int.cast_natCast, Int.cast_natCast, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      exact he
    obtain ⟨t, htt⟩ := hdiv
    have hlh : ((ℓ ^ k : ℕ) : ℤ) • h = 0 := by rw [natCast_zsmul]; exact ht h
    symm
    calc e₁.val • (c₁ • h) + e₂.val • (c₂ • h)
        = ((e₁.val : ℤ) * c₁ + (e₂.val : ℤ) * c₂) • h := by
          rw [add_smul, mul_smul, mul_smul, natCast_zsmul, natCast_zsmul]
      _ = 0 := by rw [htt, mul_comm, mul_smul, hlh, smul_zero]
  have hpair := wc_ladic_pull_codim_one_of_torsion ℓ
    (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left) Dp hDp Dk hDk (n - 1)
    (fun k hk => (hT k hk).2.2) hinj hcyc

  have hdep : ∀ t₁ t₂ : wcHM (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1),
      ∃ c₁ c₂ : ℚ_[ℓ], (c₁ ≠ 0 ∨ c₂ ≠ 0) ∧
        wcHMScalar (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1) c₁ t₁ +
          wcHMScalar (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1) c₂ t₂ =
            0 := by
    intro t₁ t₂
    obtain ⟨c₁, c₂, hne, w, hw⟩ := hpair t₁ t₂
    refine ⟨c₁, c₂, hne, ?_⟩
    rw [← hw, hvQ w, map_zero]

  obtain ⟨hmul, hone, hadd, -⟩ :=
    wc_hmScalar_laws (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1)
  generalize wcHMScalar (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1) = s
    at hdep hmul hone hadd ⊢
  have hz : ∀ y, s 0 y = 0 := by
    intro y
    have h := hadd 0 0 y
    rw [add_zero] at h
    have h' : s 0 y + s 0 y = s 0 y + 0 := by rw [add_zero]; exact h.symm
    exact add_left_cancel h'
  have hneg : ∀ a y, s (-a) y = - s a y := by
    intro a y
    have h := hadd (-a) a y
    rw [neg_add_cancel, hz] at h
    exact eq_neg_of_add_eq_zero_left h.symm
  have hcan : ∀ a y, a ≠ 0 → s a y = 0 → y = 0 := by
    intro a y ha h
    have h2 := hmul a⁻¹ a y
    rw [h, map_zero, mul_inv_cancel₀ ha, hone] at h2
    exact h2.symm
  by_cases hall : ∀ v : wcHM (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left) ℓ (n - 1),
      v = 0
  · refine ⟨0, fun v w _ => (hall v).trans (hall w).symm, fun c v => ?_⟩
    simp
  · push_neg at hall
    obtain ⟨v₀, hv₀⟩ := hall
    have rep : ∀ v, ∃ lam : ℚ_[ℓ], v = s lam v₀ := by
      intro v
      obtain ⟨c₁, c₂, hne, h⟩ := hdep v₀ v
      have hc₂ : c₂ ≠ 0 := by
        intro hc
        rw [hc, hz, add_zero] at h
        rcases hne with h1 | h1
        · exact hv₀ (hcan c₁ v₀ h1 h)
        · exact h1 hc
      refine ⟨-(c₁ * c₂⁻¹), ?_⟩
      have e1 : s c₂ v = - s c₁ v₀ := eq_neg_of_add_eq_zero_right h
      have e2 := hmul c₂⁻¹ c₂ v
      rw [mul_inv_cancel₀ hc₂, hone, e1, map_neg, hmul] at e2
      rw [hneg]
      exact e2.symm
    have uniq : ∀ a b : ℚ_[ℓ], s a v₀ = s b v₀ → a = b := by
      intro a b h
      by_contra hab
      have h1 := hadd a (-b) v₀
      rw [hneg, h, add_neg_cancel] at h1
      exact hv₀ (hcan (a + -b) v₀ (by intro h0; apply hab; linear_combination h0) h1)
    choose f hf using rep
    have fadd : ∀ v w, f (v + w) = f v + f w := by
      intro v w
      apply uniq
      rw [← hf, hadd, ← hf, ← hf]
    refine ⟨AddMonoidHom.mk' f fadd, ?_, ?_⟩
    · intro v w h
      have h' : f v = f w := h
      calc v = s (f v) v₀ := hf v
        _ = s (f w) v₀ := by rw [h']
        _ = w := (hf w).symm
    · intro c v
      show f (s c v) = c * f v
      apply uniq
      rw [← hf, mul_comm, ← hmul, ← hf]

theorem wc_hm_proper_algclosed_findim (K : Type u) [Field K] [IsAlgClosed K] {S : Scheme.{u}}
    (f : S ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (i : ℕ) :
    ∃ (r : ℕ) (e : wcHM S ℓ i ≃+ (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : wcHM S ℓ i), e (wcHMScalar S ℓ i c x) = c • e x :=
by
  classical

  have hpowK : ∀ e : ℕ, ((ℓ ^ e : ℕ) : K) ≠ 0 := by
    intro e
    rw [Nat.cast_pow]
    exact pow_ne_zero e hℓ

  have hfinZ : ∀ e j : ℕ, Finite (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))
      (wcContSheaf S (ZMod (ℓ ^ e))) j) := by
    intro e j
    obtain ⟨E⟩ := wc_proet_etale_comparison_zmod K S f (ℓ ^ e) j
    haveI := wc_etale_proper_finite K S f (ℓ ^ e) (hpowK e) j
    have h : Finite (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))
        (wcZModSheaf S (ℓ ^ e)) j) := Finite.of_equiv _ E.symm
    exact h
  have hsepi := wc_int_ext_separated_of_finite S (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) ℓ
    hfinZ i

  have hGfin : Finite (Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))
        (Limits.cokernel (wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))) i) := by
    have e0 := wc_int_coker_zmod S ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
    rw [pow_one] at e0
    obtain ⟨e⟩ := e0
    let E₁ : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))
        (Limits.cokernel (wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))) i ≃
        Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcZModSheaf S ℓ) i :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    obtain ⟨E₃⟩ := wc_proet_etale_comparison_zmod K S f ℓ i
    haveI := wc_etale_proper_finite K S f ℓ hℓ i
    exact Finite.of_equiv _ (E₁.trans E₃).symm
  haveI := hGfin

  haveI hcpt : CompactSpace ↥(Scheme.ProEt.mk (𝟙 S)).left :=
    (QuasiCompact.compactSpace_of_compactSpace f : CompactSpace ↥S)
  haveI hqs : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 S)).left :=
    (quasiSeparatedSpace_of_quasiSeparated f : QuasiSeparatedSpace ↥S)
  have hdeni := (proet_qcqs_ladic_rationalization S (Scheme.ProEt.mk (𝟙 S)) ℓ i).1

  have s4 : ∀ (R : Type) [Ring R] (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (s : R → (G ⟶ G)), s 1 = 𝟙 G → (∀ a b, s (a * b) = s b ≫ s a) →
      (∀ a b, s (a + b) = s a + s b) →
      (∀ x : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) G i,
          x.comp (Abelian.Ext.mk₀ (s 1)) (add_zero i) = x) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) G i),
          x.comp (Abelian.Ext.mk₀ (s (a * b))) (add_zero i) =
          (x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)).comp (Abelian.Ext.mk₀ (s a))
            (add_zero i)) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) G i),
          x.comp (Abelian.Ext.mk₀ (s (a + b))) (add_zero i) =
          x.comp (Abelian.Ext.mk₀ (s a)) (add_zero i) +
            x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)) := by
    intro R _ G s h1 hmul hadd
    refine ⟨fun x => ?_, fun a b x => ?_, fun a b x => ?_⟩
    · rw [h1, Abelian.Ext.comp_mk₀_id]
    · rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero i)
        (add_zero 0) (by omega)]
    · rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  obtain ⟨hs1, hsmul, hsadd, hscomm⟩ := wc_int_scalar_ring S ℓ
  obtain ⟨hq1, hqmul, hqadd⟩ := wc_ladic_scalar_ring S ℓ
  let M := Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcIntSheaf S ℓ) i
  letI smulM : SMul ℤ_[ℓ] M :=
    ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ a)) (add_zero i)⟩
  obtain ⟨A1, Amul, Aadd⟩ := s4 ℤ_[ℓ] (wcIntSheaf S ℓ) (wcIntScalar S ℓ) hs1 hsmul hsadd
  letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
    (fun a x y => Abelian.Ext.add_comp x y _ _)
    (fun a b x => Aadd a b x)
    (fun a b x => Amul a b x)
    (fun x => A1 x)
  let V := Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcLadicSheaf S ℓ) i
  letI smulV : SMul ℚ_[ℓ] V :=
    ⟨fun c x => x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero i)⟩
  obtain ⟨B1, Bmul, Badd⟩ := s4 ℚ_[ℓ] (wcLadicSheaf S ℓ) (wcLadicScalar S ℓ) hq1 hqmul hqadd
  letI modV : Module ℚ_[ℓ] V := Module.ofMinimalAxioms
    (fun a x y => Abelian.Ext.add_comp x y _ _)
    (fun a b x => Badd a b x)
    (fun a b x => Bmul a b x)
    (fun x => B1 x)

  haveI hmono : Mono (wcIntScalar S ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono S ℓ
  let g := wcIntScalar S ℓ (ℓ : ℤ_[ℓ])
  let Sq : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    ShortComplex.mk g (Limits.cokernel.π g) (Limits.cokernel.condition g)
  have hS : Sq.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel g) hmono inferInstance
  let β : M →+ Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (Limits.cokernel g) i :=
    (Abelian.Ext.mk₀ (Limits.cokernel.π g)).postcomp
      (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (add_zero i)

  have hT : ∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m' := by
    have hfr : (Set.range β).Finite := Set.toFinite _
    let pre : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (Limits.cokernel g) i → M :=
      fun y => if hy : ∃ m, β m = y then hy.choose else 0
    refine ⟨hfr.toFinset.image pre, fun m => ?_⟩
    refine ⟨pre (β m), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨m, rfl⟩), ?_⟩
    have hpre : β (pre (β m)) = β m := by
      have hy : ∃ m', β m' = β m := ⟨m, rfl⟩
      simp only [pre, dif_pos hy]
      exact hy.choose_spec
    have h0 : (m - pre (β m)).comp (Abelian.Ext.mk₀ Sq.g) (add_zero i) = 0 := by
      change β (m - pre (β m)) = 0
      rw [map_sub, hpre, sub_self]
    obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - pre (β m)) h0
    refine ⟨m', ?_⟩
    change m = pre (β m) + m'.comp (Abelian.Ext.mk₀ Sq.f) (add_zero i)
    rw [hm']
    abel

  have hD : ∀ w : ℕ → M, (∀ e, w e = (ℓ : ℤ_[ℓ]) • w (e + 1)) → w 0 = 0 := by
    intro w hw
    have hpw : ∀ e : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ e) • w e := by
      intro e
      induction e with
      | zero => rw [pow_zero, one_smul]
      | succ e ih => rw [ih, hw e, ← mul_smul, ← pow_succ]
    apply hsepi (w 0)
    intro e
    rw [hpw e]
    change ((w e).comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ e))) (add_zero i)).comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ e)))) (add_zero i) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]
  haveI hMfin : Module.Finite ℤ_[ℓ] M := padic_fg_of_mod_ell_reps ℓ M hT hD

  let φ : M →+ V := (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)).postcomp
    (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (add_zero i)
  have hφ : ∀ (a : ℤ_[ℓ]) (m : M), φ (a • m) = (a : ℚ_[ℓ]) • φ m := by
    intro a m
    change ((m.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ a)) (add_zero i)).comp
        (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i)) =
      (m.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (a : ℚ_[ℓ]))) (add_zero i)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hscomm]
  have hV : Module.Finite ℚ_[ℓ] V := by
    obtain ⟨G₀, hG₀⟩ := Module.finite_def.mp hMfin
    refine Module.finite_def.mpr ⟨G₀.image φ, ?_⟩
    rw [eq_top_iff]
    intro v _
    obtain ⟨n, y, hy⟩ := hdeni v
    have hy' : (ℓ : ℚ_[ℓ]) ^ n • v = φ y := by
      rw [← Nat.cast_pow, Nat.cast_smul_eq_nsmul ℚ_[ℓ]]
      exact hy
    have hspan : ∀ z : M, φ z ∈ Submodule.span ℚ_[ℓ] (↑(G₀.image φ) : Set V) := by
      intro z
      have hzG : z ∈ Submodule.span ℤ_[ℓ] (↑G₀ : Set M) := by rw [hG₀]; trivial
      induction hzG using Submodule.span_induction with
      | mem x hx => exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem φ hx))
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x z _ _ hx hz => rw [map_add]; exact Submodule.add_mem _ hx hz
      | smul a x _ hx => rw [hφ]; exact Submodule.smul_mem _ _ hx
    have hmem : φ y ∈ Submodule.span ℚ_[ℓ] (↑(G₀.image φ) : Set V) := hspan y
    have hl : (ℓ : ℚ_[ℓ]) ^ n ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    rw [← inv_smul_smul₀ hl v, hy']
    exact Submodule.smul_mem _ _ hmem

  haveI := hV
  obtain ⟨Θ, hΘ⟩ := wc_hm_ladic_bridge S ℓ i
  refine ⟨Module.finrank ℚ_[ℓ] V,
    Θ.trans (Module.finBasis ℚ_[ℓ] V).equivFun.toAddEquiv, fun c x => ?_⟩
  show (Module.finBasis ℚ_[ℓ] V).equivFun (Θ (wcHMScalar S ℓ i c x)) =
    c • (Module.finBasis ℚ_[ℓ] V).equivFun (Θ x)
  rw [hΘ]
  exact (Module.finBasis ℚ_[ℓ] V).equivFun.map_smul c (Θ x)

theorem wc_hm_unit_ne_zero (S : Scheme.{u}) [Nonempty S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ u : wcHM S ℓ 0, u ≠ 0 ∧
      ∀ (j : ℕ) (z : wcHM S ℓ j), wcHMCup S ℓ j 0 j (add_zero j) z u = z :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  refine ⟨Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcRingSheaf S ℓ))), fun h0 => ?_,
    fun j z => ?_⟩
  · have hid0 : 𝟙 (SheafOfModules.unit (wcRingSheaf S ℓ)) = 0 :=
      (Abelian.Ext.mk₀_eq_zero_iff _).mp h0
    have hsum : ∀ (f g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf S ℓ)) Y,
        (SheafOfModules.unitHomEquiv _ (f + g)).1 Y =
          (SheafOfModules.unitHomEquiv _ f).1 Y + (SheafOfModules.unitHomEquiv _ g).1 Y := by
      intro f g Y
      simp only [SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    have hid : ∀ Y, (SheafOfModules.unitHomEquiv _
        (𝟙 (SheafOfModules.unit (wcRingSheaf S ℓ)))).1 Y =
        (ContinuousMap.const _ (ULift.up 1) :
          C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro Y
      simp only [SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    have hdbl : 𝟙 (SheafOfModules.unit (wcRingSheaf S ℓ)) =
        𝟙 (SheafOfModules.unit (wcRingSheaf S ℓ)) + 𝟙 (SheafOfModules.unit (wcRingSheaf S ℓ)) := by
      rw [hid0, add_zero]
    let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
    have h := congrArg (fun f => (SheafOfModules.unitHomEquiv _ f).1 (Opposite.op T)) hdbl
    rw [hsum] at h
    have h2 : (ContinuousMap.const _ (ULift.up 1) : C(↥S, ULift.{u+1} ℚ_[ℓ])) =
        ContinuousMap.const _ (ULift.up 1) + ContinuousMap.const _ (ULift.up 1) := by
      have e := hid (Opposite.op T)
      rw [e] at h
      exact h
    have h3 := congrArg (fun f : C(↥S, ULift.{u+1} ℚ_[ℓ]) => (f (Classical.arbitrary S)).down) h2
    change (1 : ℚ_[ℓ]) = 1 + 1 at h3
    exact one_ne_zero (left_eq_add.mp h3)
  · exact Abelian.Ext.comp_mk₀_id z

theorem wc_pencil_point_fibre_props (F' F'' K : Type u) [Field F'] [Field F''] [Algebra F' F'']
    [Field K] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (t : Spec (.of K) ⟶ (wcP1Over F'').left)
    (ht : ∀ i, t (IsLocalRing.closedPoint K) ≠ D.S i (IsLocalRing.closedPoint F'')) :
    GeometricallyIrreducible (Limits.pullback.snd D.f t) ∧
      IsProper (Limits.pullback.snd D.f t) ∧
      SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd D.f t) :=
by
  classical
  have hB := IsPullback.of_hasPullback D.f t

  have hpt : ∀ x : (Limits.pullback D.f t : Scheme), ∃ U : D.Yt.left.Opens,
      (Limits.pullback.fst D.f t) x ∈ U ∧ Smooth (U.ι ≫ D.f) := by
    intro x
    apply D.smooth_off
    intro i hi
    have h1 : D.f ((Limits.pullback.fst D.f t) x) = (D.S i) (IsLocalRing.closedPoint F'') := by
      rw [hi, ← D.hxs i]
      rfl
    have h2 : D.f ((Limits.pullback.fst D.f t) x) = t ((Limits.pullback.snd D.f t) x) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have h3 : (Limits.pullback.snd D.f t) x = IsLocalRing.closedPoint K :=
      Subsingleton.elim _ _
    have h4 := h2.symm.trans h1
    rw [h3] at h4
    exact ht i h4
  choose U hU hUs using hpt

  have hsm : Smooth (Limits.pullback.snd D.f t) := by
    haveI : IsZariskiLocalAtSource @Smooth := HasRingHomProperty.instIsZariskiLocalAtSource
    refine IsZariskiLocalAtSource.of_iSup_eq_top
      (fun x => (Limits.pullback.fst D.f t) ⁻¹ᵁ (U x)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hU x⟩
    · intro x
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst D.f t) (U x)) hB
      exact MorphismProperty.of_isPullback (P := @Smooth) hsq (hUs x)
  refine ⟨?_, ?_, ?_⟩
  ·
    rw [GeometricallyIrreducible.eq_geometrically]
    intro L _ y Z fst snd h
    haveI : Smooth snd := MorphismProperty.of_isPullback (P := @Smooth) h hsm
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian snd
    haveI : ConnectedSpace Z := by
      let yb : Spec (.of (AlgebraicClosure L)) ⟶ Spec (.of L) :=
        Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))
      have hZ' := IsPullback.paste_horiz h hB
      haveI := D.fconn (AlgebraicClosure L) (yb ≫ y ≫ t)
      have hQ := IsPullback.of_hasPullback D.f (yb ≫ y ≫ t)
      have w : Limits.pullback.fst D.f (yb ≫ y ≫ t) ≫ D.f =
          (Limits.pullback.snd D.f (yb ≫ y ≫ t) ≫ yb) ≫ (y ≫ t) := by
        rw [Limits.pullback.condition, Category.assoc]
      let c := hZ'.lift _ _ w
      have hc1 : c ≫ (fst ≫ Limits.pullback.fst D.f t) =
          Limits.pullback.fst D.f (yb ≫ y ≫ t) := hZ'.lift_fst _ _ w
      have hc2 : c ≫ snd = Limits.pullback.snd D.f (yb ≫ y ≫ t) ≫ yb := hZ'.lift_snd _ _ w
      have houter : IsPullback (c ≫ (fst ≫ Limits.pullback.fst D.f t))
          (Limits.pullback.snd D.f (yb ≫ y ≫ t)) D.f (yb ≫ (y ≫ t)) := by
        rw [hc1]; exact hQ
      have hc : IsPullback c (Limits.pullback.snd D.f (yb ≫ y ≫ t)) snd yb :=
        IsPullback.of_right houter hc2 hZ'
      haveI : Surjective c := MorphismProperty.of_isPullback (P := @Surjective) hc.flip inferInstance
      exact Function.Surjective.connectedSpace (Surjective.surj (f := c)) c.continuous
    have hdom : ∀ w : Z, IsDomain (Z.presheaf.stalk w) := by
      intro w
      obtain ⟨U, hU, V, hV, hwV, e, hss⟩ := Smooth.exists_isStandardSmooth snd w
      letI := (Scheme.Hom.appLE snd U V e).hom.toAlgebra
      have hss' : Algebra.IsStandardSmooth Γ(Spec (.of L), U) Γ(Z, V) := hss
      obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hss'.out
      have hrel : RingHom.IsStandardSmoothOfRelativeDimension P.dimension
          (Scheme.Hom.appLE snd U V e).hom := ⟨⟨ι, σ, hσ, hι, P, rfl⟩⟩
      have himg : V.ι ''ᵁ ⊤ = V := Scheme.Opens.ι_image_top V
      have hsmV : SmoothOfRelativeDimension P.dimension (V.ι ≫ snd) := by
        haveI : IsAffine (V : Scheme) := hV
        have e2 : ⊤ ≤ V.ι ⁻¹ᵁ V := (Scheme.Opens.ι_preimage_self V).ge
        have e' : ⊤ ≤ (V.ι ≫ snd) ⁻¹ᵁ U := by
          intro z hz
          exact e (e2 hz)
        refine SmoothOfRelativeDimension.mk (fun x => ⟨U, hU, ⊤, isAffineOpen_top _, trivial,
          e', ?_⟩)
        rw [← Scheme.Hom.appLE_comp_appLE V.ι snd U V ⊤ e e2, CommRingCat.hom_comp,
          Scheme.Opens.ι_appLE]
        have hle : V.ι ''ᵁ ⊤ ≤ V := himg.le
        haveI : IsIso (homOfLE hle) :=
          ⟨⟨homOfLE himg.ge, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
        have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0
            (Z.presheaf.map (homOfLE hle).op).hom :=
          RingHom.IsStandardSmoothOfRelativeDimension.equiv
            (asIso (Z.presheaf.map (homOfLE hle).op)).commRingCatIsoToRingEquiv
        have := h0.comp hrel
        rwa [zero_add] at this
      have hV' := wcpa_smooth_stalk_isDomain L V (V.ι ≫ snd) P.dimension ⟨w, hwV⟩
      exact MulEquiv.isDomain _
        (Scheme.Opens.stalkIso V ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.toMulEquiv
    exact wcpa_irreducible_of_connected_domain_stalks Z hdom
  ·
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    haveI : IsSeparated (wcP1Over F'').hom := by
      dsimp only [wcP1Over, wcProjKStr, Over.mk_hom]
      infer_instance
    haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
    infer_instance
  ·
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (n - 1)) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    have hUd : ∀ x, SmoothOfRelativeDimension (n - 1) ((U x).ι ≫ D.f) := by
      intro x
      haveI := hUs x
      haveI := wc_p1_smooth_reldim_one F''
      haveI : SmoothOfRelativeDimension n (((U x).ι ≫ D.f) ≫ (wcP1Over F'').hom) := by
        rw [Category.assoc, D.hf]
        exact IsZariskiLocalAtSource.comp D.smooth (U x).ι
      exact wc_smooth_reldim_of_comp_reldim ((U x).ι ≫ D.f) (wcP1Over F'').hom n 1
    refine IsZariskiLocalAtSource.of_iSup_eq_top
      (fun x => (Limits.pullback.fst D.f t) ⁻¹ᵁ (U x)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hU x⟩
    · intro x
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst D.f t) (U x)) hB
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq (hUd x)

theorem wc_pencil_sepclosed_fibre_geom_model (F' F'' : Type u) [Field F'] [Field F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (E : (wcP1Over F'').left.ProEt) (L : Type u) [Field L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∃ (fE : ((wcProEtPullback D.f).obj E).left ⟶ Spec (.of L)) (W : Scheme.{u})
      (π : W ⟶ ((wcProEtPullback D.f).obj E).left) (p : W ⟶ Spec (.of (AlgebraicClosure L))),
      IsProper fE ∧
      IsPullback π p fE (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) ∧
      IsProper p ∧ SmoothOfRelativeDimension (n - 1) p ∧ IrreducibleSpace W ∧
      ∀ m : ℕ, (m : F'') ≠ 0 → (m : L) ≠ 0 :=
by
  classical
  obtain ⟨t, ht_def⟩ : ∃ t : Spec (.of L) ⟶ (wcP1Over F'').left, t = eE.inv ≫ E.hom :=
    ⟨_, rfl⟩
  have ht : ∀ i, t (IsLocalRing.closedPoint L) ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro i
    subst ht_def
    exact hE (eE.inv (IsLocalRing.closedPoint L)) i
  obtain ⟨hGI, hPr, hSm⟩ := wc_pencil_point_fibre_props F' F'' L Y n hn2 D t ht
  have hsq : IsPullback (Limits.pullback.snd E.hom D.f)
      (Limits.pullback.fst E.hom D.f ≫ eE.hom) D.f t := by
    refine IsPullback.of_iso (IsPullback.of_hasPullback E.hom D.f).flip (Iso.refl _)
      (Iso.refl _) eE (Iso.refl _) ?_ ?_ ?_ ?_ <;> simp [ht_def]
  obtain ⟨fX, hfX_def⟩ : ∃ fX : Limits.pullback E.hom D.f ⟶ Spec (.of L),
      fX = hsq.isoPullback.hom ≫ Limits.pullback.snd D.f t := ⟨_, rfl⟩
  have hι : IsPullback hsq.isoPullback.hom fX (Limits.pullback.snd D.f t) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [hfX_def, Category.comp_id]⟩
  have hfX : IsProper fX := MorphismProperty.of_isPullback (P := @IsProper) hι hPr
  have hsX : SmoothOfRelativeDimension (n - 1) fX :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hι hSm
  have hgX : GeometricallyIrreducible fX :=
    MorphismProperty.of_isPullback (P := @GeometricallyIrreducible) hι hGI
  have hπ := IsPullback.of_hasPullback fX
    (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))
  have hp : IsProper (Limits.pullback.snd fX
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) :=
    MorphismProperty.of_isPullback (P := @IsProper) hπ hfX
  have hsp : SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd fX
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hπ hsX
  have hirr : IrreducibleSpace ↥(Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) : Scheme.{u}) :=
    hgX.geometrically_irreducibleSpace _ _ _ hπ
  have hchar : ∀ m : ℕ, (m : F'') ≠ 0 → (m : L) ≠ 0 := by
    intro m hm h0
    let ψ : F'' →+* L := (Spec.preimage (t ≫ (wcP1Over F'').hom)).hom
    apply hm
    apply ψ.injective
    rw [map_natCast, map_zero]
    exact h0
  exact ⟨fX, _, _, _, hfX, hπ, hp, hsp, hirr, hchar⟩

theorem wc_hm_pull_bij_of_zmod_pull_bij {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j))
    (hbij : ∀ k j : ℕ, 1 ≤ k → ∀ Dk : wcZModPullData p (ℓ ^ k), wcZModPullCanonical Dk →
      Function.Bijective (wcZModPull Dk j))
    (q : ℕ) : Function.Bijective (wcHMPull D q) :=
by
  classical

  have sc : ∀ (S : Scheme.{u}) (j : ℕ),
      (∀ (N : ℕ) (x : wcHM S ℓ j), wcHMScalar S ℓ j ((ℓ : ℚ_[ℓ]) ^ N) x = (ℓ ^ N : ℕ) • x) ∧
      (∀ (M : ℕ), M ≠ 0 → ∀ x : wcHM S ℓ j, M • x = 0 → x = 0) ∧
      (∀ (M : ℕ), M ≠ 0 → ∀ z : wcHM S ℓ j, ∃ z' : wcHM S ℓ j, M • z' = z) := by
    intro S j
    obtain ⟨hcomp, hone, -, hnat⟩ := wc_hmScalar_laws S ℓ j
    refine ⟨?_, ?_, ?_⟩
    · intro N x
      rw [hnat, Nat.cast_pow]
    · intro M hM x hx
      have hm : (M : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hM
      rw [hnat] at hx
      calc x = wcHMScalar S ℓ j 1 x := (hone x).symm
        _ = wcHMScalar S ℓ j ((M : ℚ_[ℓ]) * (M : ℚ_[ℓ])⁻¹) x := by rw [mul_inv_cancel₀ hm]
        _ = wcHMScalar S ℓ j ((M : ℚ_[ℓ])⁻¹) (wcHMScalar S ℓ j (M : ℚ_[ℓ]) x) :=
            (hcomp _ _ x).symm
        _ = 0 := by rw [hx, map_zero]
    · intro M hM z
      have hm : (M : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hM
      refine ⟨wcHMScalar S ℓ j ((M : ℚ_[ℓ])⁻¹) z, ?_⟩
      rw [hnat, hcomp, inv_mul_cancel₀ hm, hone]
  have hℓ0 : ∀ N : ℕ, ℓ ^ N ≠ 0 := fun N => pow_ne_zero N (Fact.out : ℓ.Prime).ne_zero
  obtain ⟨scY1, scY2, scY3⟩ := sc Y q
  obtain ⟨scT1, scT2, -⟩ := sc T q

  let Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k) := fun k =>
    Classical.choose (wc_zmod_pull_data_exists p (ℓ ^ k))
  have hDk : ∀ k, wcZModPullCanonical (Dk k) := fun k =>
    Classical.choose_spec (wc_zmod_pull_data_exists p (ℓ ^ k))
  obtain ⟨P⟩ := wc_ladic_milnor_package ℓ p D hD Dk hDk q
  letI := P.instMY
  letI := P.instMT

  have hlimY : @wcLim1Zero (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => P.τY k (q - 1)) :=
    @wc_tower_lim1_of_ml (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => P.τY k (q - 1))
      (@wc_tower_ml_of_finite (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
        (fun k => P.τY k (q - 1)) (fun k hk => hfin k (q - 1) hk))
  have hlimT : @wcLim1Zero (fun k => wcZModProEtExt T (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => P.τT k (q - 1)) :=
    @wc_tower_lim1_of_ml (fun k => wcZModProEtExt T (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => P.τT k (q - 1))
      (@wc_tower_ml_of_finite (fun k => wcZModProEtExt T (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
        (fun k => P.τT k (q - 1))
        (fun k hk => @Finite.of_surjective _ _ (hfin k (q - 1) hk)
          (⇑(wcZModPull (Dk k) (q - 1))) (hbij k (q - 1) hk (Dk k) (hDk k)).2))
  have hsepY := P.sepY hlimY
  have hsepT := P.sepT hlimT
  refine ⟨?_, ?_⟩
  ·
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨N, y, hy⟩ := P.denomY x
    rw [scY1] at hy
    have h1 : P.ρT (P.pI y) = 0 := by
      rw [P.ρ_pI, ← hy, map_nsmul, hx, smul_zero]
    obtain ⟨s, hs⟩ := P.torsT _ h1
    have h2 : P.pI ((ℓ ^ s : ℕ) • y) = 0 := by
      rw [map_nsmul]
      exact hs
    have h3 : (ℓ ^ s : ℕ) • y = 0 := by
      apply hsepY
      intro k hk
      apply (hbij k q hk (Dk k) (hDk k)).1
      rw [← P.red_pI, h2, map_zero, map_zero]
    have h4 : (ℓ ^ s : ℕ) • ((ℓ ^ N : ℕ) • x) = 0 := by
      rw [hy, ← map_nsmul P.ρY, h3, map_zero]
    exact scY2 _ (hℓ0 N) x (scY2 _ (hℓ0 s) _ h4)
  ·
    intro z
    obtain ⟨N, w, hw⟩ := P.denomT z
    rw [scT1] at hw
    let α : ∀ k, wcZModProEtExt Y (ℓ ^ k) q := fun k =>
      if hk : 1 ≤ k then Function.surjInv (hbij k q hk (Dk k) (hDk k)).2 (P.redT k w) else 0
    have hα : ∀ k (hk : 1 ≤ k), wcZModPull (Dk k) q (α k) = P.redT k w := by
      intro k hk
      have e : α k = Function.surjInv (hbij k q hk (Dk k) (hDk k)).2 (P.redT k w) := dif_pos hk
      rw [e]
      exact Function.surjInv_eq _ _
    have hcompat : ∀ k, 1 ≤ k → P.τY k q (α (k + 1)) = α k := by
      intro k hk
      apply (hbij k q hk (Dk k) (hDk k)).1
      rw [← P.τ_pull, hα (k + 1) (by omega), P.redT_compat k w hk, hα k hk]
    obtain ⟨y, hyk⟩ := P.liftY α hcompat
    have hpw : P.pI y = w := by
      rw [← sub_eq_zero]
      apply hsepT
      intro k hk
      rw [map_sub, P.red_pI, hyk k hk, hα k hk, sub_self]
    obtain ⟨x', hx'⟩ := scY3 _ (hℓ0 N) (P.ρY y)
    refine ⟨x', ?_⟩
    rw [← sub_eq_zero]
    apply scT2 _ (hℓ0 N)
    rw [nsmul_sub, ← map_nsmul (wcHMPull D q), hx', ← P.ρ_pI, hpw, hw, sub_self]

theorem wc_hm_sepclosed_base_change_pull_bij (k K : Type u) [Field k] [IsSepClosed k]
    [Field K] [IsAlgClosed K] (e : k →+* K) (Y : Scheme.{u}) (f : Y ⟶ Spec (.of k)) [IsProper f]
    (P : Scheme.{u}) (π : P ⟶ Y) (p : P ⟶ Spec (.of K))
    (hπ : IsPullback π p f (Spec.map (CommRingCat.ofHom e)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (D : wcHMPullData π ℓ) (hD : wcHMPullCanonical D) (q : ℕ) :
    Function.Bijective (wcHMPull D q) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  haveI : IsSepClosed K := IsSepClosed.of_isAlgClosed K
  haveI hp : IsProper p := MorphismProperty.of_isPullback (P := @IsProper) hπ inferInstance
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated f
  haveI : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace p
  haveI : QuasiSeparatedSpace P := quasiSeparatedSpace_of_quasiSeparated p
  have hpos : ∀ k' : ℕ, 0 < ℓ ^ k' := fun k' => pow_pos hℓp.pos k'
  have hmk : ∀ k' : ℕ, ((ℓ ^ k' : ℕ) : k) ≠ 0 := by
    intro k'
    rw [Nat.cast_pow]
    exact pow_ne_zero k' hℓ
  have hmK : ∀ k' : ℕ, ((ℓ ^ k' : ℕ) : K) ≠ 0 := by
    intro k'
    rw [← map_natCast e]
    exact (map_ne_zero e).mpr (hmk k')
  have hbij : ∀ k' j : ℕ, 1 ≤ k' → ∀ Dk : wcZModPullData π (ℓ ^ k'), wcZModPullCanonical Dk →
      Function.Bijective (wcZModPull Dk j) := by
    intro k' j _ Dk hDk
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists π (ℓ ^ k')
    have hE : Function.Bijective (wcEtPull E j) :=
      wc_et_sepclosed_field_ext_proper_pull_bij k K e Y f P π p hπ (ℓ ^ k') (hmk k') E j
    exact wc_zmod_proet_pull_bij_of_et_pull_bij π (ℓ ^ k') (hpos k') Dk hDk E j hE
  have hfinP : ∀ k' j : ℕ, 1 ≤ k' → Finite (wcZModProEtExt P (ℓ ^ k') j) := by
    intro k' j _
    obtain ⟨Ψ, -⟩ := wc_zmod_proet_etale_mod_comparison K P p (ℓ ^ k') (hpos k')
    obtain ⟨eq⟩ := wc_et_zmodext_coh_equiv P (ℓ ^ k') j
    haveI : Finite (wcEtCoh P (ℓ ^ k') j) := wc_etale_proper_finite K P p (ℓ ^ k') (hmK k') j
    exact Finite.of_equiv _ ((Ψ j).toEquiv.trans eq).symm
  have hfinY : ∀ k' j : ℕ, 1 ≤ k' → Finite (wcZModProEtExt Y (ℓ ^ k') j) := by
    intro k' j hk'
    obtain ⟨Dk, hDk⟩ := wc_zmod_pull_data_exists π (ℓ ^ k')
    haveI := hfinP k' j hk'
    exact Finite.of_injective (wcZModPull Dk j) (hbij k' j hk' Dk hDk).1
  exact wc_hm_pull_bij_of_zmod_pull_bij ℓ π D hD hfinY hbij q

theorem wc_hm_cup_scalar (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i j k : ℕ) (hk : i + j = k)
    (c : ℚ_[ℓ]) (x : wcHM S ℓ i) (y : wcHM S ℓ j) :
    wcHMCup S ℓ i j k hk (wcHMScalar S ℓ i c x) y = wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) ∧
    wcHMCup S ℓ i j k hk x (wcHMScalar S ℓ j c y) = wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _

  have hcomm : ∀ (X : (S.ProEt)ᵒᵖ) (a b : (wcRingSheaf S ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  have hext : ∀ e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ),
      ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ⟶ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf S ℓ)) = e := by
    intro e
    let R := wcRingSheaf S ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
      fun f => PresheafOfModules.sections_property s f
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y f
        ext x
        show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]
  have hcen : ∀ (n : ℕ)
      (e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      (z : wcHM S ℓ n),
      (Abelian.Ext.mk₀ e).comp z (zero_add n) = z.comp (Abelian.Ext.mk₀ e) (add_zero n) := by
    intro n e z
    obtain ⟨m, hm⟩ := hext e
    subst hm
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm
  constructor
  · show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero i)).comp y hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero, hcen j (wcHMConst S ℓ c) y,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
  · show x.comp (y.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero j)) hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero x y _ hk).symm

theorem wc_hm_middle_pairing_represent (K : Type u) [Field K] [IsAlgClosed K]
    {W : Scheme.{u}} (pW : W ⟶ Spec (.of K)) [IsProper pW] [IrreducibleSpace W]
    (d : ℕ) [SmoothOfRelativeDimension d pW] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (a b : ℕ) (hab : a + b = 2 * d) (ra rb : ℕ)
    (ea : wcHM W ℓ a ≃+ (Fin ra → ℚ_[ℓ]))
    (hea : ∀ (c : ℚ_[ℓ]) (x : wcHM W ℓ a), ea (wcHMScalar W ℓ a c x) = c • ea x)
    (eb : wcHM W ℓ b ≃+ (Fin rb → ℚ_[ℓ]))
    (heb : ∀ (c : ℚ_[ℓ]) (y : wcHM W ℓ b), eb (wcHMScalar W ℓ b c y) = c • eb y)
    (u : wcHM W ℓ 0) (hu : u ≠ 0)
    (hu1 : ∀ z : wcHM W ℓ (2 * d), wcHMCup W ℓ (2 * d) 0 (2 * d) (add_zero _) z u = z) :
    ∃ ω : wcHM W ℓ (2 * d), ω ≠ 0 ∧
      ∀ lam : wcHM W ℓ a →+ ℚ_[ℓ],
        (∀ (c : ℚ_[ℓ]) (x : wcHM W ℓ a), lam (wcHMScalar W ℓ a c x) = c * lam x) →
        ∃ δ : wcHM W ℓ b, ∀ x : wcHM W ℓ a,
          wcHMCup W ℓ a b (2 * d) hab x δ = wcHMScalar W ℓ (2 * d) (lam x) ω :=
by
  obtain ⟨η, hηinj, hηlin⟩ := wc_hm_top_line K pW d ℓ hℓ (2 * d) rfl
  have hne : ∃ z₀ : wcHM W ℓ (2 * d), z₀ ≠ 0 := by
    by_contra h
    push_neg at h
    exact hu (wc_hm_poincare_right K pW d ℓ hℓ (2 * d) 0 (2 * d) (add_zero _) rfl u
      (fun z => (hu1 z).trans (h z)))
  obtain ⟨z₀, hz₀⟩ := hne
  have hz : η z₀ ≠ 0 := fun h => hz₀ (hηinj (h.trans (map_zero η).symm))
  obtain ⟨ω, hω1⟩ : ∃ ω : wcHM W ℓ (2 * d), η ω = 1 :=
    ⟨wcHMScalar W ℓ (2 * d) (η z₀)⁻¹ z₀, by rw [hηlin, inv_mul_cancel₀ hz]⟩
  have hω0 : ω ≠ 0 := by
    intro h
    rw [h, map_zero] at hω1
    exact zero_ne_one hω1
  obtain ⟨B, hBapp⟩ : ∃ B : wcHM W ℓ a →+ wcHM W ℓ b →+ ℚ_[ℓ],
      ∀ x y, B x y = η (wcHMCup W ℓ a b (2 * d) hab x y) :=
    ⟨(wcHMCup W ℓ a b (2 * d) hab).compr₂ η, fun x y => rfl⟩
  have hBl : ∀ (c : ℚ_[ℓ]) (x : wcHM W ℓ a) (y : wcHM W ℓ b),
      B (wcHMScalar W ℓ a c x) y = c * B x y := by
    intro c x y
    rw [hBapp, hBapp, (wc_hm_cup_scalar W ℓ a b (2 * d) hab c x y).1, hηlin]
  have hBr : ∀ (c : ℚ_[ℓ]) (x : wcHM W ℓ a) (y : wcHM W ℓ b),
      B x (wcHMScalar W ℓ b c y) = c * B x y := by
    intro c x y
    rw [hBapp, hBapp, (wc_hm_cup_scalar W ℓ a b (2 * d) hab c x y).2, hηlin]
  have hcup0 : ∀ (x : wcHM W ℓ a) (y : wcHM W ℓ b), B x y = 0 →
      wcHMCup W ℓ a b (2 * d) hab x y = 0 := by
    intro x y h
    rw [hBapp] at h
    exact hηinj (h.trans (map_zero η).symm)
  have hr : ∀ y : wcHM W ℓ b, (∀ x : wcHM W ℓ a, B x y = 0) → y = 0 := fun y h =>
    wc_hm_poincare_right K pW d ℓ hℓ a b (2 * d) hab rfl y (fun x => hcup0 x y (h x))
  have hba : b + a = 2 * d := by omega
  have hl : ∀ x : wcHM W ℓ a, (∀ y : wcHM W ℓ b, B x y = 0) → x = 0 := by
    intro x h
    apply wc_hm_poincare_right K pW d ℓ hℓ b a (2 * d) hba rfl x
    intro z
    rw [wc_hm_graded_comm W ℓ b a (2 * d) hba hab z x, hcup0 x z (h z), smul_zero]
  choose w hw using fun k => wc_pairing_right_dual (wcHMScalar W ℓ a) (wcHMScalar W ℓ b)
    ea eb hea heb B hBl hBr hl hr k
  refine ⟨ω, hω0, fun lam hlam => ?_⟩
  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin ra → ℚ_[ℓ]),
      ea.symm (c • v) = wcHMScalar W ℓ a c (ea.symm v) := by
    intro c v
    apply ea.injective
    rw [hea, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
  have hexp : ∀ x : wcHM W ℓ a,
      lam x = ∑ k, ea x k * lam (ea.symm (Pi.single k 1)) := by
    intro x
    have hv : ea x = ∑ k, (ea x k) • (Pi.single k (1 : ℚ_[ℓ]) : Fin ra → ℚ_[ℓ]) := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    have hx : x = ∑ k, wcHMScalar W ℓ a (ea x k) (ea.symm (Pi.single k 1)) := by
      calc x = ea.symm (ea x) := (ea.symm_apply_apply x).symm
        _ = ea.symm (∑ k, (ea x k) • (Pi.single k (1 : ℚ_[ℓ]) : Fin ra → ℚ_[ℓ])) :=
          congrArg ea.symm hv
        _ = ∑ k, wcHMScalar W ℓ a (ea x k) (ea.symm (Pi.single k 1)) := by
          rw [map_sum]
          exact Finset.sum_congr rfl (fun k _ => hes _ _)
    calc lam x = lam (∑ k, wcHMScalar W ℓ a (ea x k) (ea.symm (Pi.single k 1))) :=
          congrArg lam hx
      _ = ∑ k, ea x k * lam (ea.symm (Pi.single k 1)) := by
          rw [map_sum]
          exact Finset.sum_congr rfl (fun k _ => hlam _ _)
  refine ⟨∑ k, wcHMScalar W ℓ b (lam (ea.symm (Pi.single k 1))) (w k), fun x => hηinj ?_⟩
  have h1 : η (wcHMCup W ℓ a b (2 * d) hab x
      (∑ k, wcHMScalar W ℓ b (lam (ea.symm (Pi.single k 1))) (w k))) = lam x := by
    rw [← hBapp, map_sum, hexp x]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [hBr, hw, mul_comm]
  rw [h1, hηlin, hω1, mul_one]

theorem wc_hm_pull_cup {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) (i j k : ℕ) (hk : i + j = k) (x : wcHM S ℓ i) (y : wcHM S ℓ j) :
    wcHMPull D k (wcHMCup S ℓ i j k hk x y) =
      wcHMCup S' ℓ i j k hk (wcHMPull D i x) (wcHMPull D j y) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  have key : ∀ (x : wcHM S ℓ i) (y : wcHM S ℓ j),
      (Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
            (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i))
          (zero_add i)).comp
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j))
          (zero_add j)) hk := by
    intro x y
    rw [Abelian.Ext.mapExactFunctor_comp]
    rw [Abelian.Ext.comp_assoc _ _ _ (zero_add i) hk (show 0 + i + j = k by omega),
      Abelian.Ext.comp_assoc_of_second_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
  exact key x y

theorem wc_mnt_XE_poincare_middle (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (E : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∃ ω : wcHM ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)), ω ≠ 0 ∧
      ∀ lam : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1) →+ ℚ_[ℓ],
        (∀ (c : ℚ_[ℓ]) (y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1)),
          lam (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c y) = c * lam y) →
        ∃ δ' : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
          ∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
            wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
                y δ' =
              wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)) (lam y) ω :=
by
  classical

  obtain ⟨fE, W, π, p, hfE, hπ, hp, hsm, hirr, hchar⟩ :=
    wc_pencil_sepclosed_fibre_geom_model F' F'' Y n hn2 D E L eE hE
  haveI := hfE
  haveI := hp
  haveI := hsm
  haveI := hirr

  have hℓF : (ℓ : F'') ≠ 0 := by
    intro h0
    haveI := ringChar.charP F''
    have hc : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have h2 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hc Fact.out).mp h1
    letI := Fintype.ofFinite F''
    have h3 : ringChar F'' ∣ Fintype.card F'' :=
      (ringChar.spec F'' _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [Nat.card_eq_fintype_card, ← h2]
    exact h3
  have hℓL : (ℓ : L) ≠ 0 := hchar ℓ hℓF
  have hℓK : (ℓ : AlgebraicClosure L) ≠ 0 := by
    rw [← map_natCast (algebraMap L (AlgebraicClosure L))]
    exact (map_ne_zero _).mpr hℓL

  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists π ℓ
  have hbij : ∀ q, Function.Bijective (wcHMPull Dπ q) := fun q =>
    wc_hm_sepclosed_base_change_pull_bij L (AlgebraicClosure L)
      (algebraMap L (AlgebraicClosure L)) _ fE W π p hπ ℓ hℓL Dπ hDπ q

  have hpullsc : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (Df : wcHMPullData f ℓ),
      wcHMPullCanonical Df → ∀ (q : ℕ) (c : ℚ_[ℓ]) (z : wcHM S ℓ q),
        wcHMPull Df q (wcHMScalar S ℓ q c z) = wcHMScalar S' ℓ q c (wcHMPull Df q z) := by
    intro S S' f Df hDf q c z
    have hc := wc_hm_pull_const Df hDf c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    show (Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ
          (z.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q))).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ z).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, ← hc]
    generalize Abelian.Ext.mapExactFunctor Df.Φ z = w
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero w
        (Abelian.Ext.mk₀ (Df.Φ.map (wcHMConst S ℓ c))) (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ Df.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  haveI : Nonempty W := IrreducibleSpace.toNonempty
  obtain ⟨r, eN, heN⟩ := wc_hm_proper_algclosed_findim (AlgebraicClosure L) p ℓ hℓK (n - 1)
  obtain ⟨u, hu, hu1⟩ := wc_hm_unit_ne_zero W ℓ
  obtain ⟨ωW, hωW, hrepW⟩ := wc_hm_middle_pairing_represent (AlgebraicClosure L) p (n - 1) ℓ hℓK
    (n - 1) (n - 1) (by omega) r r eN heN eN heN u hu (hu1 (2 * (n - 1)))

  obtain ⟨ω, hω⟩ := (hbij (2 * (n - 1))).2 ωW
  refine ⟨ω, ?_, ?_⟩
  · intro h0
    apply hωW
    rw [← hω, h0, map_zero]
  · intro lam hlam
    let ΨN := AddEquiv.ofBijective (wcHMPull Dπ (n - 1)) (hbij (n - 1))
    have hΨN : ∀ x, wcHMPull Dπ (n - 1) (ΨN.symm x) = x := fun x => ΨN.apply_symm_apply x
    have hsymm_sc : ∀ (c : ℚ_[ℓ]) (x : wcHM W ℓ (n - 1)),
        ΨN.symm (wcHMScalar W ℓ (n - 1) c x) =
          wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c (ΨN.symm x) := by
      intro c x
      apply (hbij (n - 1)).1
      rw [hΨN, hpullsc Dπ hDπ, hΨN]
    let lamW : wcHM W ℓ (n - 1) →+ ℚ_[ℓ] := lam.comp ΨN.symm.toAddMonoidHom
    have hlamW : ∀ (c : ℚ_[ℓ]) (x : wcHM W ℓ (n - 1)),
        lamW (wcHMScalar W ℓ (n - 1) c x) = c * lamW x := by
      intro c x
      show lam (ΨN.symm (wcHMScalar W ℓ (n - 1) c x)) = c * lam (ΨN.symm x)
      rw [hsymm_sc, hlam]
    obtain ⟨δW, hδW⟩ := hrepW lamW hlamW
    refine ⟨ΨN.symm δW, fun y => ?_⟩
    apply (hbij (2 * (n - 1))).1
    rw [wc_hm_pull_cup Dπ, hΨN, hpullsc Dπ hDπ, hω]
    refine (hδW (wcHMPull Dπ (n - 1) y)).trans ?_
    have hl : lamW (wcHMPull Dπ (n - 1) y) = lam y := by
      show lam (ΨN.symm (ΨN y)) = lam y
      rw [ΨN.symm_apply_apply]
    rw [hl]

theorem wc_mnt_XE_top_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (E : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∀ ω z : wcHM ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)), ω ≠ 0 →
      ∃ μ : ℚ_[ℓ], z = wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)) μ ω :=
by
  classical
  have hpullsc : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (Df : wcHMPullData f ℓ),
      wcHMPullCanonical Df → ∀ (q : ℕ) (c : ℚ_[ℓ]) (z : wcHM S ℓ q),
        wcHMPull Df q (wcHMScalar S ℓ q c z) = wcHMScalar S' ℓ q c (wcHMPull Df q z) := by
    intro S S' f Df hDf q c z
    have hc := wc_hm_pull_const Df hDf c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    show (Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ
          (z.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q))).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ z).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, ← hc]
    generalize Abelian.Ext.mapExactFunctor Df.Φ z = w
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero w
        (Abelian.Ext.mk₀ (Df.Φ.map (wcHMConst S ℓ c))) (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ Df.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  obtain ⟨fE, W, π, p, hfE, hπ, hp, hsm, hirr, hchar⟩ :=
    wc_pencil_sepclosed_fibre_geom_model F' F'' Y n hn2 D E L eE hE
  haveI := hfE
  haveI := hp
  haveI := hsm
  haveI := hirr

  have hℓF : (ℓ : F'') ≠ 0 := by
    intro h0
    haveI := ringChar.charP F''
    have hc : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have heq : ringChar F'' = ℓ :=
      (Nat.prime_dvd_prime_iff_eq hc (Fact.out : ℓ.Prime)).mp hdvd
    letI := Fintype.ofFinite F''
    have hcard : ringChar F'' ∣ Fintype.card F'' :=
      (ringChar.spec F'' _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [Nat.card_eq_fintype_card, ← heq]
    exact hcard
  have hℓL : (ℓ : L) ≠ 0 := hchar ℓ hℓF
  have hℓK : (ℓ : AlgebraicClosure L) ≠ 0 := by
    rw [← map_natCast (algebraMap L (AlgebraicClosure L)) ℓ]
    exact (map_ne_zero (algebraMap L (AlgebraicClosure L))).mpr hℓL

  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists π ℓ
  have hbij : Function.Bijective (wcHMPull Dπ (2 * (n - 1))) :=
    wc_hm_sepclosed_base_change_pull_bij L (AlgebraicClosure L)
      (algebraMap L (AlgebraicClosure L)) ((wcProEtPullback D.f).obj E).left fE W π p hπ ℓ hℓL
      Dπ hDπ (2 * (n - 1))

  obtain ⟨η, hηinj, hηlin⟩ :=
    wc_hm_top_line (AlgebraicClosure L) p (n - 1) ℓ hℓK (2 * (n - 1)) rfl

  have hη'inj : Function.Injective (fun x => η (wcHMPull Dπ (2 * (n - 1)) x)) :=
    hηinj.comp hbij.1
  have hη'lin : ∀ (c : ℚ_[ℓ]) (x : wcHM ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))),
      η (wcHMPull Dπ (2 * (n - 1))
          (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)) c x)) =
        c * η (wcHMPull Dπ (2 * (n - 1)) x) := by
    intro c x
    rw [hpullsc Dπ hDπ, hηlin]

  intro ω z hω
  have hne : η (wcHMPull Dπ (2 * (n - 1)) ω) ≠ 0 := by
    intro h0
    apply hω
    apply hη'inj
    show η (wcHMPull Dπ (2 * (n - 1)) ω) = η (wcHMPull Dπ (2 * (n - 1)) 0)
    rw [h0, map_zero, map_zero]
  refine ⟨η (wcHMPull Dπ (2 * (n - 1)) z) / η (wcHMPull Dπ (2 * (n - 1)) ω), ?_⟩
  apply hη'inj
  show η (wcHMPull Dπ (2 * (n - 1)) z) = η (wcHMPull Dπ (2 * (n - 1))
    (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))
      (η (wcHMPull Dπ (2 * (n - 1)) z) / η (wcHMPull Dπ (2 * (n - 1)) ω)) ω))
  rw [hη'lin, div_mul_cancel₀ _ hne]

theorem wc_mnt_XE_cup_right_nondeg (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (E : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∀ w : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      (∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
        wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
          y w = 0) → w = 0 :=
by
  classical
  obtain ⟨fE, W, π, p, hfE, hπ, hp, hsm, hirr, hchar⟩ :=
    wc_pencil_sepclosed_fibre_geom_model F' F'' Y n hn2 D E L eE hE
  haveI := hfE
  haveI := hp
  haveI := hsm
  haveI := hirr

  have hℓF : (ℓ : F'') ≠ 0 := by
    intro h0
    haveI := ringChar.charP F''
    have hc : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have heq : ringChar F'' = ℓ :=
      (Nat.prime_dvd_prime_iff_eq hc (Fact.out : ℓ.Prime)).mp hdvd
    letI := Fintype.ofFinite F''
    have hcard : ringChar F'' ∣ Fintype.card F'' :=
      (ringChar.spec F'' _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [← heq, Nat.card_eq_fintype_card]
    exact hcard
  have hℓL : (ℓ : L) ≠ 0 := hchar ℓ hℓF
  have hℓK : (ℓ : AlgebraicClosure L) ≠ 0 := by
    rw [← map_natCast (algebraMap L (AlgebraicClosure L)) ℓ]
    exact (map_ne_zero (algebraMap L (AlgebraicClosure L))).mpr hℓL
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists π ℓ
  have hbij := wc_hm_sepclosed_base_change_pull_bij L (AlgebraicClosure L)
    (algebraMap L (AlgebraicClosure L)) ((wcProEtPullback D.f).obj E).left fE W π p hπ ℓ hℓL
    Dπ hDπ (n - 1)
  have h : (n - 1) + (n - 1) = 2 * (n - 1) := by omega
  intro w hw
  have hclaim : ∀ z : wcHM W ℓ (n - 1),
      wcHMCup W ℓ (n - 1) (n - 1) (2 * (n - 1)) h z (wcHMPull Dπ (n - 1) w) = 0 := by
    intro z
    obtain ⟨y, rfl⟩ := hbij.surjective z
    rw [← wc_hm_pull_cup Dπ (n - 1) (n - 1) (2 * (n - 1)) h y w, hw y, map_zero]
  have hw' : wcHMPull Dπ (n - 1) w = 0 :=
    wc_hm_poincare_right (AlgebraicClosure L) p (n - 1) ℓ hℓK (n - 1) (n - 1) (2 * (n - 1)) h
      rfl _ hclaim
  apply hbij.injective
  rw [hw', map_zero]

theorem wc_fet_connected_clopen_piece : ∀ (Y F : Scheme.{u}) (f : F ⟶ Y), IsFinite f → Etale f → Surjective f → ConnectedSpace Y →
    ∃ (G : Scheme.{u}) (ι : G ⟶ F), IsFinite (ι ≫ f) ∧ Etale (ι ≫ f) ∧ Surjective (ι ≫ f) ∧
      ConnectedSpace G :=
by
  classical
  intro Y F f hfin het hsurj hconn
  have hO : IsOpenMap f := f.isOpenMap
  have hC : IsClosedMap f := f.isClosedMap
  obtain ⟨y₀⟩ := (inferInstance : Nonempty Y)
  have hΦ : (f ⁻¹' {y₀}).Finite := f.finite_preimage_singleton y₀
  have ha : ∀ S : Set F, IsClopen S → S.Nonempty → f '' S = Set.univ := by
    intro S hS hne
    exact IsClopen.eq_univ ⟨hC _ hS.isClosed, hO _ hS.isOpen⟩ (hne.image _)
  have hb : ∀ S : Set F, IsClopen S → S.Nonempty → (S ∩ f ⁻¹' {y₀}).Nonempty := by
    intro S hS hne
    have : y₀ ∈ f '' S := by rw [ha S hS hne]; trivial
    obtain ⟨x, hx, hfx⟩ := this
    exact ⟨x, hx, hfx⟩
  obtain ⟨x₀, -⟩ := hsurj.surj y₀
  have hP : ∃ n, ∃ S : Set F, IsClopen S ∧ S.Nonempty ∧ (S ∩ f ⁻¹' {y₀}).ncard = n :=
    ⟨_, Set.univ, isClopen_univ, ⟨x₀, trivial⟩, rfl⟩
  obtain ⟨S, hS, hne, hcard⟩ := Nat.find_spec hP
  have hmin : ∀ C : Set F, IsClopen C → C.Nonempty → Nat.find hP ≤ (C ∩ f ⁻¹' {y₀}).ncard :=
    fun C hC' hCne => Nat.find_min' hP ⟨C, hC', hCne, rfl⟩
  have hpre : _root_.IsPreconnected S := by
    rw [isPreconnected_iff_subset_of_fully_disjoint_closed hS.isClosed]
    intro u v hu hv hsub hdisj
    by_cases hCu : (S ∩ u).Nonempty
    · by_cases hCv : (S ∩ v).Nonempty
      · exfalso
        have hSu_eq : S ∩ u = S ∩ vᶜ := by
          ext x
          constructor
          · rintro ⟨hxS, hxu⟩
            exact ⟨hxS, fun hxv => Set.disjoint_left.mp hdisj hxu hxv⟩
          · rintro ⟨hxS, hxv⟩
            refine ⟨hxS, ?_⟩
            rcases hsub hxS with h | h
            · exact h
            · exact absurd h hxv
        have hSv_eq : S ∩ v = S ∩ uᶜ := by
          ext x
          constructor
          · rintro ⟨hxS, hxv⟩
            exact ⟨hxS, fun hxu => Set.disjoint_left.mp hdisj hxu hxv⟩
          · rintro ⟨hxS, hxu⟩
            refine ⟨hxS, ?_⟩
            rcases hsub hxS with h | h
            · exact absurd h hxu
            · exact h
        have hclo : IsClopen (S ∩ u) :=
          ⟨hS.isClosed.inter hu, by rw [hSu_eq]; exact hS.isOpen.inter hv.isOpen_compl⟩
        have hclo' : IsClopen (S ∩ v) :=
          ⟨hS.isClosed.inter hv, by rw [hSv_eq]; exact hS.isOpen.inter hu.isOpen_compl⟩
        obtain ⟨x, ⟨hxS, hxv⟩, hxΦ⟩ := hb _ hclo' hCv
        have hlt : (S ∩ u ∩ f ⁻¹' {y₀}).ncard < (S ∩ f ⁻¹' {y₀}).ncard := by
          apply Set.ncard_lt_ncard _ (hΦ.subset Set.inter_subset_right)
          refine ⟨fun y hy => ⟨hy.1.1, hy.2⟩, fun h => ?_⟩
          have := h ⟨hxS, hxΦ⟩
          exact Set.disjoint_left.mp hdisj this.1.2 hxv
        have := hmin _ hclo hCu
        omega
      · left
        intro x hxS
        rcases hsub hxS with h | h
        · exact h
        · exact absurd ⟨x, hxS, h⟩ hCv
    · right
      intro x hxS
      rcases hsub hxS with h | h
      · exact absurd ⟨x, hxS, h⟩ hCu
      · exact h
  let O : F.Opens := ⟨S, hS.isOpen⟩
  have : IsClosedImmersion O.ι :=
    IsClosedImmersion.of_isPreimmersion O.ι (by rw [Scheme.Opens.range_ι]; exact hS.isClosed)
  refine ⟨O.toScheme, O.ι, inferInstance, inferInstance, ⟨fun y => ?_⟩, ?_⟩
  · have hy : y ∈ f '' S := by rw [ha S hS hne]; trivial
    obtain ⟨x, hx, rfl⟩ := hy
    have hxr : x ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]; exact hx
    obtain ⟨p, hp⟩ := hxr
    refine ⟨p, ?_⟩
    rw [Scheme.Hom.comp_apply, hp]
  · exact isConnected_iff_connectedSpace.mp ⟨hne, hpre⟩

theorem wc_fet_connected_tower_build : (∀ (Y F : Scheme.{u}) (f : F ⟶ Y), IsFinite f → Etale f → Surjective f → ConnectedSpace Y →
    ∃ (G : Scheme.{u}) (ι : G ⟶ F), IsFinite (ι ≫ f) ∧ Etale (ι ≫ f) ∧ Surjective (ι ≫ f) ∧
      ConnectedSpace G) →
    ∀ (U : Scheme.{u}), ConnectedSpace U →
    ∀ (E : ℕ → Scheme.{u}) (πE : ∀ j, E j ⟶ U), (∀ j, IsFinite (πE j)) → (∀ j, Etale (πE j)) →
    (∀ j, Surjective (πE j)) →
    ∃ (D : ℕᵒᵖ ⥤ Scheme.{u}) (π : ∀ j, D.obj (Opposite.op j) ⟶ U)
      (s : ∀ j, D.obj (Opposite.op j) ⟶ E j),
      (∀ j, IsFinite (π j)) ∧ (∀ j, Etale (π j)) ∧ (∀ j, Surjective (π j)) ∧
      (∀ j, ConnectedSpace (D.obj (Opposite.op j))) ∧
      (∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ π j = π k) ∧
      (∀ j k (h : j ≤ k), Surjective (D.map (homOfLE h).op)) ∧
      (∀ j, s j ≫ πE j = π j) :=
by
  intro H1 U hconn E πE hfin het hsurj

  let St := Σ' (G : Scheme.{u}) (π : G ⟶ U),
    IsFinite π ∧ Etale π ∧ Surjective π ∧ ConnectedSpace G

  have step : ∀ (n : ℕ) (t : St), ∃ (G' : Scheme.{u}) (e : G' ⟶ t.1) (s : G' ⟶ E (n + 1)),
      IsFinite (e ≫ t.2.1) ∧ Etale (e ≫ t.2.1) ∧ Surjective (e ≫ t.2.1) ∧
      ConnectedSpace G' ∧ Surjective e ∧ s ≫ πE (n + 1) = e ≫ t.2.1 := by
    rintro n ⟨G, π, h1, h2, h3, h4⟩
    haveI := h1; haveI := h2; haveI := h3
    haveI := hfin (n + 1); haveI := het (n + 1); haveI := hsurj (n + 1)
    obtain ⟨G', ι, k1, k2, k3, k4⟩ := H1 G (Limits.pullback π (πE (n + 1)))
      (Limits.pullback.fst π (πE (n + 1))) inferInstance inferInstance inferInstance h4
    haveI := k1; haveI := k2; haveI := k3
    refine ⟨G', ι ≫ Limits.pullback.fst π (πE (n + 1)), ι ≫ Limits.pullback.snd π (πE (n + 1)),
      inferInstance, inferInstance, inferInstance, k4, k3, ?_⟩
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  choose G' e' s' hF hE hS hC hSe hs using step

  obtain ⟨G₀, ι₀, b1, b2, b3, b4⟩ := H1 U (E 0) (πE 0) (hfin 0) (het 0) (hsurj 0) hconn

  let T : ℕ → St := fun n => Nat.rec (motive := fun _ => St)
    (⟨G₀, ι₀ ≫ πE 0, b1, b2, b3, b4⟩ : St)
    (fun m t => (⟨G' m t, e' m t ≫ t.2.1, hF m t, hE m t, hS m t, hC m t⟩ : St)) n
  let X : ℕ → Scheme.{u} := fun n => (T n).1
  let e : ∀ n, X (n + 1) ⟶ X n := fun n => e' n (T n)
  let π : ∀ n, X n ⟶ U := fun n => (T n).2.1
  let s : ∀ n, X n ⟶ E n := fun n =>
    Nat.casesOn (motive := fun n => X n ⟶ E n) n ι₀ (fun m => s' m (T m))
  have p1 : ∀ n, IsFinite (π n) := fun n => (T n).2.2.1
  have p2 : ∀ n, Etale (π n) := fun n => (T n).2.2.2.1
  have p3 : ∀ n, Surjective (π n) := fun n => (T n).2.2.2.2.1
  have p4 : ∀ n, ConnectedSpace (X n) := fun n => (T n).2.2.2.2.2
  have p5 : ∀ n, e n ≫ π n = π (n + 1) := fun n => rfl
  have p6 : ∀ n, Surjective (e n) := fun n => hSe n (T n)
  have p7 : ∀ n, s n ≫ πE n = π n := by
    intro n
    cases n with
    | zero => rfl
    | succ m => exact hs m (T m)

  have gen : ∀ (D : ℕᵒᵖ ⥤ Scheme.{u}) (πD : ∀ n, D.obj (Opposite.op n) ⟶ U),
      (∀ n, D.map (homOfLE (Nat.le_succ n)).op ≫ πD n = πD (n + 1)) →
      (∀ n, Surjective (D.map (homOfLE (Nat.le_succ n)).op)) →
      ∀ j k (h : j ≤ k), D.map (homOfLE h).op ≫ πD j = πD k ∧
        Surjective (D.map (homOfLE h).op) := by
    intro D πD h5 h6 j k h
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
    induction d with
    | zero =>
      have hid : D.map (homOfLE h).op = 𝟙 (D.obj (Opposite.op (j + 0))) :=
        (congrArg D.map (Subsingleton.elim _ _)).trans (D.map_id _)
      rw [hid]
      exact ⟨Category.id_comp _, inferInstance⟩
    | succ d ih =>
      have h' : j ≤ j + d := Nat.le_add_right j d
      have hcomp : D.map (homOfLE h).op =
          D.map (homOfLE (Nat.le_succ (j + d))).op ≫ D.map (homOfLE h').op :=
        (congrArg D.map (Subsingleton.elim _ _)).trans (D.map_comp _ _)
      obtain ⟨ih1, ih2⟩ := ih h'
      rw [hcomp]
      refine ⟨?_, ?_⟩
      · rw [Category.assoc, ih1]
        exact h5 (j + d)
      · haveI := ih2
        haveI := h6 (j + d)
        infer_instance
  have key := gen (Functor.ofOpSequence e) π
    (fun n => (congrArg (· ≫ π n) (Functor.ofOpSequence_map_homOfLE_succ e n)).trans (p5 n))
    (fun n => (Functor.ofOpSequence_map_homOfLE_succ e n) ▸ p6 n)
  exact ⟨Functor.ofOpSequence e, π, s, p1, p2, p3, p4, fun j k h => (key j k h).1,
    fun j k h => (key j k h).2, p7⟩

theorem wc_fet_tower_connected_limit : ∀ (U : Scheme.{u}), ConnectedSpace U → CompactSpace U →
    QuasiSeparatedSpace U →
    ∀ (E : ℕ → Scheme.{u}) (πE : ∀ j, E j ⟶ U), (∀ j, IsFinite (πE j)) → (∀ j, Etale (πE j)) →
    (∀ j, Surjective (πE j)) →
    ∃ (W₀ : Scheme.{u}) (p : W₀ ⟶ U), WeaklyEtale p ∧ QuasiCompact p ∧ Surjective p ∧
      ConnectedSpace W₀ ∧ CompactSpace W₀ ∧ QuasiSeparatedSpace W₀ ∧
      ∀ j, ∃ t : W₀ ⟶ E j, t ≫ πE j = p :=
by
  intro U hconn hcpt hqs E πE hfin het hsurj

  have RWE : ∀ (R T : Type u) [CommRing R] [CommRing T] (σ : R →+* T) (G : ℕ → Type u)
      [∀ k, CommRing (G k)] (Φ : ∀ k, R →+* G k) (ι : ∀ k, G k →+* T),
      (∀ k, (ι k).comp (Φ k) = σ) → (∀ k, (Φ k).Etale) →
      (∀ (n : ℕ) (t : Fin n → T), ∃ (k : ℕ) (x : Fin n → G k), ∀ i, ι k (x i) = t i) →
      (∀ (k n : ℕ) (x : Fin n → G k), (∀ i, ι k (x i) = 0) → ∃ (j : ℕ) (θ : G k →+* G j),
        (ι j).comp θ = ι k ∧ θ.comp (Φ k) = Φ j ∧ ∀ i, θ (x i) = 0) →
      @Algebra.WeaklyEtale R T _ _ σ.toAlgebra := by
    intro R T _ _ σ G _ Φ ι hcomp hetk hlift hvan
    apply wc_indEtale_weaklyEtale
    refine wc_seq_colimit_indEtale R T σ G Φ ι hcomp ?_ hlift hvan
    intro k
    unfold wcIndEtale
    letI : Algebra R (G k) := (Φ k).toAlgebra
    intro P _ _ _ h
    exact ⟨G k, inferInstance, inferInstance, hetk k, h, AlgHom.id R (G k), AlgHom.id_comp h⟩

  obtain ⟨D, π, s, hπfin, hπet, hπsurj, hDconn, hπ, hDsurj, hs⟩ :=
    wc_fet_connected_tower_build wc_fet_connected_clopen_piece U hconn E πE hfin het hsurj
  have hπaff : ∀ j, IsAffineHom (π j) := fun j => by
    haveI := hπfin j
    infer_instance

  obtain ⟨W₀, p, t, ht, hpaff, hcompat, hREP, hZERO⟩ :=
    wc_affine_seq_limit_exists wc_seq_colim_localization_away U D π hπaff hπ

  have hWE : WeaklyEtale p :=
    wc_affine_seq_limit_weaklyEtale RWE wc_lfi_specMap_weaklyEtale U D π hπ W₀ p t ht hcompat
      hpaff hπaff hπet hREP hZERO

  have htsurj : ∀ l, Surjective (t l) :=
    wc_affine_seq_limit_proj_surjective wc_seq_colim_comap_surjective U D π hπ W₀ p t ht hcompat
      hpaff hπaff hDsurj hREP hZERO

  have hW₀conn : ConnectedSpace W₀ :=
    wc_affine_seq_limit_connected U D π hπ W₀ p t ht hcompat hcpt hqs hpaff hπaff hDconn htsurj
      hREP hZERO

  haveI := hpaff
  refine ⟨W₀, p, hWE, inferInstance, ?_, hW₀conn, ?_, ?_, fun j => ⟨t j ≫ s j, ?_⟩⟩
  · rw [← ht 0]
    haveI := htsurj 0
    haveI := hπsurj 0
    infer_instance
  · exact QuasiCompact.compactSpace_of_compactSpace p
  · exact quasiSeparatedSpace_of_quasiSeparated p
  · rw [Category.assoc, hs j, ht j]

theorem wc_contSheaf_ladic_pi_tower_colimit : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a : ℕ), ∃ κ : Functor.ofSequence (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _) ⟶ (Functor.const ℕ).obj (wcContSheaf S (Fin a → ℚ_[ℓ])), Nonempty (Limits.IsColimit (Limits.Cocone.mk _ κ)) :=
by
  intro S ℓ _ a
  classical
  haveI hex : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology S) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero

  obtain ⟨ψ, hψc, hψ⟩ : ∃ ψ : ℕ → ((Fin a → ℤ_[ℓ]) →+ (Fin a → ℚ_[ℓ])),
      (∀ n, Continuous (ψ n)) ∧
      ∀ n v i, ψ n v i = ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * ((v i : ℤ_[ℓ]) : ℚ_[ℓ]) :=
    ⟨fun n => (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)).comp
        (AddMonoidHom.compLeft (PadicInt.Coe.ringHom (p := ℓ)).toAddMonoidHom (Fin a)),
      fun n => (continuous_const_smul (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)).comp
        (continuous_pi (fun i => continuous_subtype_val.comp (continuous_apply i))),
      fun n v i => rfl⟩

  have hns : ∀ (m : ℕ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S (Fin a → ℤ_[ℓ])).obj.obj U : Type (u+1))),
      (m • 𝟙 (wcContSheaf S (Fin a → ℤ_[ℓ]))).hom.app U x = m • x := by
    intro m U x
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ m ih =>
      rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih, succ_nsmul]
      rfl

  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (κ : G ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc G (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T G κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc G (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit G).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit G)⟩

  have affine_sieve : ∀ (V : S.ProEt) (R : Sieve V),
      (∀ (W : S.ProEt) (f : W ⟶ V), IsAffine W.left → R.arrows f) →
      R ∈ Scheme.ProEt.topology S V := by
    intro V R hR
    have hV : WeaklyEtale V.hom := V.prop
    let W : V.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (V.left.affineCover.f i ≫ V.hom) inferInstance
    let g : ∀ i, W i ⟶ V := fun i => MorphismProperty.Over.homMk (V.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S).coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change V.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
        V.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR (W i) (g i) (show IsAffine (V.left.affineCover.X i) by infer_instance)

  obtain ⟨κ, hκ⟩ : ∃ κ : Functor.ofSequence (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ]))
      (fun _ => ℓ • 𝟙 _) ⟶ (Functor.const ℕ).obj (wcContSheaf S (Fin a → ℚ_[ℓ])),
      ∀ n, κ.app n = wcContSheafMap S (ψ n) (hψc n) := by
    refine ⟨NatTrans.ofSequence (fun n => wcContSheafMap S (ψ n) (hψc n)) (fun n => ?_),
      fun n => NatTrans.ofSequence_app _ _ n⟩
    have e : ((ℓ : ℚ_[ℓ]) ^ (n + 1))⁻¹ * (ℓ : ℚ_[ℓ]) = ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ := by
      rw [pow_succ, mul_inv, mul_assoc, inv_mul_cancel₀ hℓ0, mul_one]
    have key : (ℓ • 𝟙 (wcContSheaf S (Fin a → ℤ_[ℓ]))) ≫ wcContSheafMap S (ψ (n + 1)) (hψc (n + 1)) =
        wcContSheafMap S (ψ n) (hψc n) := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply, hns]
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      funext i
      change ψ (n + 1) ((ℓ • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), Fin a → ℤ_[ℓ]))) t) i =
        ψ n ((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), Fin a → ℤ_[ℓ])) t) i
      rw [hψ, hψ, ContinuousMap.coe_nsmul, Pi.smul_apply, Pi.smul_apply, nsmul_eq_mul,
        PadicInt.coe_mul, PadicInt.coe_natCast, ← mul_assoc, e]
    rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map]
    exact key.trans (Category.comp_id _).symm
  refine ⟨κ, ?_⟩

  have hmono : ∀ n, Mono (κ.app n) := by
    intro n
    have hm : Mono (wcContSheafMap S (ψ n) (hψc n)) := by
      haveI : ∀ U, Mono ((wcContSheafMap S (ψ n) (hψc n)).hom.app U) := fun U =>
        (AddCommGrpCat.mono_iff_injective _).mpr (by
          intro x x' hxx
          apply ULift.ext
          apply ContinuousMap.ext
          intro t
          funext i
          have h := congrArg (fun z => (ULift.down z :
            C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
              Fin a → ℚ_[ℓ])) t i) hxx
          have h' : ψ n ((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
                (Opposite.unop U)), Fin a → ℤ_[ℓ])) t) i =
              ψ n ((ULift.down x' : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
                (Opposite.unop U)), Fin a → ℤ_[ℓ])) t) i := h
          rw [hψ, hψ] at h'
          exact PadicInt.ext (mul_left_cancel₀ (inv_ne_zero (pow_ne_zero n hℓ0)) h'))
      haveI : Mono (wcContSheafMap S (ψ n) (hψc n)).hom := NatTrans.mono_of_mono_app _
      exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
    rw [hκ n]
    exact hm

  have hepi : Epi (Limits.colimit.desc (Functor.ofSequence
      (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _))
      (Limits.Cocone.mk _ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
        (Limits.colimit.desc (Functor.ofSequence
          (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _))
          (Limits.Cocone.mk _ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W f hW
      haveI : CompactSpace ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W) :=
        (inferInstance : CompactSpace W.left)
      let g : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W), Fin a → ℚ_[ℓ]) :=
        ((wcContSheaf S (Fin a → ℚ_[ℓ])).obj.map f.op s).down
      obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn g.continuous.continuousOn
      have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
      obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C hℓ1
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := pow_pos (by linarith) n
      have hbd : ∀ x i, ‖(ℓ : ℚ_[ℓ]) ^ n * g x i‖ ≤ 1 := by
        intro x i
        have h1 := hC x (Set.mem_univ x)
        have h2 := norm_le_pi_norm (g x) i
        rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
        linarith
      let f0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj W), Fin a → ℤ_[ℓ]) :=
        ⟨fun x i => ⟨(ℓ : ℚ_[ℓ]) ^ n * g x i, hbd x i⟩,
          continuous_pi (fun i =>
            (continuous_const.mul ((continuous_apply i).comp g.continuous)).subtype_mk _)⟩
      let t0 : (wcContSheaf S (Fin a → ℤ_[ℓ])).obj.obj (Opposite.op W) := ULift.up f0
      refine ⟨(Limits.colimit.ι (Functor.ofSequence
        (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _)) n).hom.app
          (Opposite.op W) t0, ?_⟩
      change (Limits.colimit.ι (Functor.ofSequence
        (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _)) n ≫
          Limits.colimit.desc (Functor.ofSequence
            (X := fun _ : ℕ => wcContSheaf S (Fin a → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _))
            (Limits.Cocone.mk _ κ)).hom.app (Opposite.op W) t0 = _
      rw [Limits.colimit.ι_desc]
      change (κ.app n).hom.app (Opposite.op W) t0 = _
      rw [hκ n]
      apply ULift.ext
      apply ContinuousMap.ext
      intro x
      funext i
      change ψ n (f0 x) i = g x i
      rw [hψ]
      change ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * ((ℓ : ℚ_[ℓ]) ^ n * g x i) = g x i
      rw [inv_mul_cancel_left₀ (pow_ne_zero n hℓ0)]
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls
  exact crit _ _ κ hmono hepi

theorem wc_contSheaf_split_torsion_retract : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (a b : ℕ) (e : Fin b → ℕ), ∃ (i : wcContSheaf S (Fin a → ℤ_[ℓ]) ⟶ wcContSheaf S ((Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))) (p : wcContSheaf S ((Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j))) ⟶ wcContSheaf S (Fin a → ℤ_[ℓ])) (N : ℕ), i ≫ p = 𝟙 _ ∧ (ℓ ^ N) • (𝟙 _ - p ≫ i) = 0 :=
by
  intro S ℓ _ a b e
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ U x
    rfl
  have hns : ∀ {F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G) (n : ℕ)
      (U : (S.ProEt)ᵒᵖ) (x : (F.obj.obj U : Type (u+1))),
      (n • f).hom.app U x = n • f.hom.app U x := by
    intro F G f n U x
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ n ih => rw [succ_nsmul, succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih]
  have hkill : ∀ w : ((j : Fin b) → ZMod (ℓ ^ e j)), (ℓ ^ (∑ j, e j)) • w = 0 := by
    intro w
    funext j
    rw [Pi.smul_apply, Pi.zero_apply, nsmul_eq_mul]
    have h0 : ((ℓ ^ (∑ j, e j) : ℕ) : ZMod (ℓ ^ e j)) = 0 := by
      rw [ZMod.natCast_eq_zero_iff]
      exact pow_dvd_pow ℓ (Finset.single_le_sum (fun j' _ => Nat.zero_le (e j')) (Finset.mem_univ j))
    rw [h0, zero_mul]
  have hi : Continuous (AddMonoidHom.inl (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) := by
    show Continuous (fun x : Fin a → ℤ_[ℓ] => (x, (0 : (j : Fin b) → ZMod (ℓ ^ e j))))
    exact continuous_id.prodMk continuous_const
  have hp : Continuous (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) := by
    show Continuous (Prod.fst : (Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)) → Fin a → ℤ_[ℓ])
    exact continuous_fst
  refine ⟨wcContSheafMap S _ hi, wcContSheafMap S _ hp, ∑ j, e j, ?_, ?_⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key]
    rfl
  · rw [smul_sub, sub_eq_zero]
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [hns, hns, ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
      CategoryTheory.comp_apply, key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change (ℓ ^ (∑ j, e j)) • ((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
        (Opposite.unop U)), (Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))) t) =
      (ℓ ^ (∑ j, e j)) • (((ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
        (Opposite.unop U)), (Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j)))) t).1,
        (0 : (j : Fin b) → ZMod (ℓ ^ e j)))
    apply Prod.ext
    · rfl
    · rw [Prod.smul_snd, Prod.smul_snd, hkill, smul_zero]

theorem seq_colimit_transport_iso : ∀ {𝒜 ℬ : Type*} [Category 𝒜] [Category ℬ] (F : 𝒜 ⥤ ℬ) (Y L : 𝒜) (s : Y ⟶ Y) (κ : Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => s) ⟶ (Functor.const ℕ).obj L), Nonempty (Limits.IsColimit (F.mapCocone (Limits.Cocone.mk L κ))) → ∀ (Y' : ℬ) (θ : F.obj Y ≅ Y') (s' : Y' ⟶ Y'), F.map s ≫ θ.hom = θ.hom ≫ s' → ∃ κ' : Functor.ofSequence (X := fun _ : ℕ => Y') (fun _ => s') ⟶ (Functor.const ℕ).obj (F.obj L), Nonempty (Limits.IsColimit (Limits.Cocone.mk (F.obj L) κ')) :=
by
  intro 𝒜 ℬ _ _ F Y L s κ hc Y' θ s' hs
  obtain ⟨h⟩ := hc
  let βh : Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => s) ⋙ F ⟶
      Functor.ofSequence (X := fun _ : ℕ => Y') (fun _ => s') :=
    NatTrans.ofSequence (fun _ => θ.hom) (fun n => by
      simp only [Functor.comp_map, Functor.ofSequence_map_homOfLE_succ]
      exact hs)
  haveI : ∀ n, CategoryTheory.IsIso (βh.app n) := fun n => by
    have e : βh.app n = θ.hom := NatTrans.ofSequence_app _ _ n
    refine ⟨⟨θ.inv, ?_, ?_⟩⟩
    · rw [e]; exact θ.hom_inv_id
    · rw [e]; exact θ.inv_hom_id
  haveI : IsIso βh := NatIso.isIso_of_isIso_app βh
  refine ⟨(asIso βh).inv ≫ (F.mapCocone (Limits.Cocone.mk L κ)).ι, ⟨?_⟩⟩
  exact (Limits.IsColimit.precomposeInvEquiv (asIso βh) _).symm h

theorem seq_colimit_of_torsion_retract : ∀ {𝒜 : Type*} [Category 𝒜] [Preadditive 𝒜] (m N : ℕ) (Y P : 𝒜) (i : P ⟶ Y) (p : Y ⟶ P), i ≫ p = 𝟙 P → (m ^ N) • (𝟙 Y - p ≫ i) = 0 → ∀ (L : 𝒜) (κ : Functor.ofSequence (X := fun _ : ℕ => P) (fun _ => m • 𝟙 P) ⟶ (Functor.const ℕ).obj L), Nonempty (Limits.IsColimit (Limits.Cocone.mk L κ)) → ∃ κ' : Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y) ⟶ (Functor.const ℕ).obj L, Nonempty (Limits.IsColimit (Limits.Cocone.mk L κ')) :=
by
  intro 𝒜 _ _ m N Y P i p hip hN L κ hP
  obtain ⟨hP⟩ := hP

  let k : ℕ → (P ⟶ L) := fun n => κ.app n
  let leg : ∀ s : Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y)),
      ℕ → (Y ⟶ s.pt) := fun s n => s.ι.app n
  have hκ : ∀ n : ℕ, m • k (n + 1) = k n := by
    intro n
    have h := κ.naturality (homOfLE (Nat.le_succ n))
    rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map] at h
    have h2 : (m • 𝟙 P) ≫ k (n + 1) = k n ≫ 𝟙 L := h
    rw [Category.comp_id, Preadditive.nsmul_comp, Category.id_comp] at h2
    exact h2
  have hσ : ∀ (s : Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y)))
      (n : ℕ), m • leg s (n + 1) = leg s n := by
    intro s n
    have h := s.w (homOfLE (Nat.le_succ n))
    rw [Functor.ofSequence_map_homOfLE_succ] at h
    have h2 : (m • 𝟙 Y) ≫ leg s (n + 1) = leg s n := h
    rw [Preadditive.nsmul_comp, Category.id_comp] at h2
    exact h2
  have hσk : ∀ (s : Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y)))
      (j n : ℕ), leg s n = (m ^ j) • leg s (n + j) := by
    intro s j
    induction j with
    | zero => intro n; simp
    | succ j ih =>
      intro n
      rw [ih n, ← hσ s (n + j), smul_smul, ← pow_succ, Nat.add_assoc]
  have hfac : ∀ (s : Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y)))
      (n : ℕ), p ≫ i ≫ leg s n = leg s n := by
    intro s n
    have h2 : (𝟙 Y - p ≫ i) ≫ leg s n = 0 := by
      rw [hσk s N n, Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, hN, Limits.zero_comp]
    rw [Preadditive.sub_comp, Category.id_comp, sub_eq_zero, Category.assoc] at h2
    exact h2.symm
  let κ' : Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y) ⟶
      (Functor.const ℕ).obj L :=
    NatTrans.ofSequence (fun n => p ≫ k n) (fun n => by
      have c : (m • 𝟙 Y) ≫ p ≫ k (n + 1) = (p ≫ k n) ≫ 𝟙 L := by
        rw [Category.comp_id, Preadditive.nsmul_comp, Category.id_comp,
          ← Preadditive.comp_nsmul, hκ]
      rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map]
      exact c)
  let τ : Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => Y) (fun _ => m • 𝟙 Y)) →
      Limits.Cocone (Functor.ofSequence (X := fun _ : ℕ => P) (fun _ => m • 𝟙 P)) := fun s =>
    Limits.Cocone.mk s.pt (NatTrans.ofSequence (fun n => i ≫ leg s n) (fun n => by
      have c : (m • 𝟙 P) ≫ i ≫ leg s (n + 1) = (i ≫ leg s n) ≫ 𝟙 s.pt := by
        rw [Category.comp_id, Preadditive.nsmul_comp, Category.id_comp,
          ← Preadditive.comp_nsmul, hσ]
      rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map]
      exact c))
  refine ⟨κ', ⟨{ desc := fun s => hP.desc (τ s), fac := ?_, uniq := ?_ }⟩⟩
  · intro s n
    have h1 : k n ≫ hP.desc (τ s) = i ≫ leg s n := hP.fac (τ s) n
    have c : (p ≫ k n) ≫ hP.desc (τ s) = leg s n := by
      rw [Category.assoc, h1, hfac]
    exact c
  · intro s f hf
    apply hP.uniq (τ s) f
    intro n
    have h1 : (p ≫ k n) ≫ f = leg s n := hf n
    have c : k n ≫ f = i ≫ leg s n := by
      rw [← h1, Category.assoc, ← Category.assoc i, hip, Category.id_comp]
    exact c

theorem wc_proet_Rq_rat_const_of_int_const : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [QuasiCompact g]
    [QuasiSeparated g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (V : B.ProEt), CompactSpace V.left → QuasiSeparatedSpace V.left → ∀ (q a b : ℕ) (e : Fin b → ℕ),
    Nonempty ((((wcProEtPush g).rightDerived q).obj (wcContSheaf X ℤ_[ℓ])).over V ≅
