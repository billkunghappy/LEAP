theorem wc_pencil_R2_u0_strict_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom D.u0) :
    ∃ L : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V₀) →+ ℚ_[ℓ],
      Function.Injective L ∧
      ∀ (c : ℚ_[ℓ]) (t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V₀)),
        L (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V₀)).hom t) = c * L t :=
by
  classical
  have hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨hgi, hpr, hsm⟩ := wc_pencil_fibre_props F' F'' Y n hn2 D
  haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hgi
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hpr
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hsm
  obtain ⟨⟨e₁, he₁⟩, -⟩ :=
    wc_top_coh_frobenius F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX
  obtain ⟨Ψ, hΨbij, hΨsc, -⟩ := wc_pencil_strict_nbhd_sections_pbc F' F'' Y n hn2 D ℓ hℓ hX
    (2 * (n - 1)) V₀ φ₀ A e ε hv hε hεφ
  obtain ⟨η, hη, -⟩ := wc_proet_free_sheaf_yoneda (wcP1Over F'').left
  choose g hg hguniq using hη V₀ (wcRq D.f ℓ (2 * (n - 1)))

  have hgadd : ∀ t t', g (t + t') = g t + g t' := by
    intro t t'
    symm
    apply hguniq
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, hg, hg]

  have hgsc : ∀ (c : ℚ_[ℓ]) t,
      g (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V₀)).hom t) =
        g t ≫ wcRqScalar D.f ℓ (2 * (n - 1)) c := by
    intro c t
    symm
    apply hguniq
    show (((g t).hom ≫ (wcRqScalar D.f ℓ (2 * (n - 1)) c).hom).app (Opposite.op V₀)).hom
      (η V₀) = _
    rw [NatTrans.comp_app, AddCommGrpCat.comp_apply, hg]
  let ιf : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V₀) →
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ (2 * (n - 1))) 0 :=
    fun t => Abelian.Ext.mk₀ (g t)
  have hιadd : ∀ t t', ιf (t + t') = ιf t + ιf t' := by
    intro t t'
    show Abelian.Ext.mk₀ (g (t + t')) = Abelian.Ext.mk₀ (g t) + Abelian.Ext.mk₀ (g t')
    rw [hgadd, Abelian.Ext.mk₀_add]
  have hιinj : Function.Injective ιf := by
    intro t t' h
    have h1 : g t = g t' := (Abelian.Ext.mk₀_bijective _ _).injective h
    rw [← hg t, ← hg t', h1]
  have hιsc : ∀ (c : ℚ_[ℓ]) t,
      ιf (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V₀)).hom t) =
        (ιf t).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (2 * (n - 1)) c)) (add_zero 0) := by
    intro c t
    show Abelian.Ext.mk₀ (g _) = _
    rw [hgsc, Abelian.Ext.mk₀_comp_mk₀]
  let L : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V₀) →+ ℚ_[ℓ] :=
    AddMonoidHom.mk' (fun t => (e₁ (Ψ (ιf t))) 0) (fun t t' => by
      simp only [hιadd, map_add, Pi.add_apply])
  have hL : ∀ t, L t = (e₁ (Ψ (ιf t))) 0 := fun t => rfl
  refine ⟨L, ?_, ?_⟩
  · intro t t' h
    rw [hL, hL] at h
    have h2 : e₁ (Ψ (ιf t)) = e₁ (Ψ (ιf t')) := by
      funext i
      rw [Subsingleton.elim i 0]
      exact h
    exact hιinj (hΨbij.injective (e₁.injective h2))
  · intro c t
    rw [hL, hL, hιsc, hΨsc, he₁, Pi.smul_apply, smul_eq_mul]

theorem wc_proet_deck_frame_linear (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (hW : ConnectedSpace W.left) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W) (γ : W ⟶ W) :
    ∃ A : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]),
      ∀ (V : S.ProEt) (a b : V ⟶ W), b = a ≫ γ →
        ∀ (x : G.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z =
          A ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) :=
by
  classical
  let Φ' : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj ⟶
      ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj :=
    Functor.whiskerLeft (Over.map (𝟙 W)).op θ.inv.hom ≫
      Functor.whiskerLeft (Over.map γ).op θ.hom.hom
  let Φ : (wcContSheaf S (Fin k → ℚ_[ℓ])).over W ⟶
      (wcContSheaf S (Fin k → ℚ_[ℓ])).over W := ObjectProperty.homMk Φ'
  obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ W hW k k Φ
  refine ⟨A, ?_⟩
  have key : ∀ (V : S.ProEt) (a : V ⟶ W) (y : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (a ≫ γ)))).hom y).down) z =
      A ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (a ≫ 𝟙 W)))).hom y).down) z) := by
    intro V a y z
    have h2 : (θ.inv.hom.app (Opposite.op (Over.mk (a ≫ 𝟙 W)))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk (a ≫ 𝟙 W)))).hom y) = y :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (a ≫ 𝟙 W)))).hom y) θ.hom_inv_id
    have h1 := congrArg (fun ψ => (show C(↥V.left, Fin k → ℚ_[ℓ]) from
      ((ψ.hom.app (Opposite.op (Over.mk a))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk (a ≫ 𝟙 W)))).hom y)).down) z) hA
    refine (congrArg (fun y' => (show C(↥V.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk (a ≫ γ)))).hom y').down) z) h2).symm.trans
        (h1.trans ?_)
    rfl
  intro V a b hab x z
  subst hab
  have k2 := key V a x z
  rw [Category.comp_id] at k2
  exact k2

theorem wc_punct_geom_qcqs (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    CompactSpace (wcPunctGeom F'' u0 hP).left ∧ QuasiSeparatedSpace (wcPunctGeom F'' u0 hP).left :=
by
  classical

  have hprop0 : IsProper (wcProjKStr F'' 1) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (1+1)) F'' _
    letI : IsScalarTower F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (MvPolynomial (Fin (1+1)) F'') :=
      IsScalarTower.of_algebraMap_eq (R := F'')
        (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (A := MvPolynomial (Fin (1+1)) F'') (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (MvPolynomial (Fin (1+1)) F'') :=
      Algebra.FiniteType.of_restrictScalars_finiteType F'' _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'')) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0 =>
          (x : MvPolynomial (Fin (1+1)) F'')) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (1+1)) F'').IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (1+1)) F'').totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (1+1)) F'').coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0))))
    infer_instance

  haveI hprop : IsProper (wcP1Over F'').hom := hprop0
  haveI : LocallyOfFiniteType (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  haveI : QuasiCompact (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance

  haveI : IsLocallyNoetherian (Limits.pullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
  haveI : CompactSpace (Limits.pullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) : Scheme.{u}) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    AlgebraicGeometry.IsNoetherian.mk
  haveI : TopologicalSpace.NoetherianSpace (Limits.pullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) : Scheme.{u}) :=
    inferInstance

  haveI hN : TopologicalSpace.NoetherianSpace (wcPunctGeom F'' u0 hP).left :=
    (Scheme.Hom.isOpenEmbedding (Limits.pullback.snd (wcPunctOpen F'' u0).ι
      (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))).isInducing.noetherianSpace

  exact ⟨inferInstance, inferInstance⟩

theorem wc_proet_push_rightDerived_vanish_of_qcqs_acyclic : ∀ {X B : Scheme.{u}} (f : X ⟶ B)
    [QuasiCompact f] [QuasiSeparated f] (M : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}),
    (∀ (W : X.ProEt) [CompactSpace W.left] [QuasiSeparatedSpace W.left] (k : ℕ)
      (e : Abelian.Ext (wcFreeSheaf X W) M (k + 1)), e = 0) →
    ∀ k : ℕ, Limits.IsZero (((wcProEtPush f).rightDerived (k + 1)).obj M) :=
by
  intro X B f _ _ M hM k
  have hqcqs : ∀ (Y : Scheme.{u}) [IsAffine Y] (h : Y ⟶ B),
      CompactSpace (Limits.pullback (C := Scheme.{u}) h f) ∧
        QuasiSeparatedSpace (Limits.pullback (C := Scheme.{u}) h f) := by
    intro Y _ h
    exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst (C := Scheme.{u}) h f),
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst (C := Scheme.{u}) h f)⟩
  apply wc_proet_push_rightDerived_zero_of_local f M k
  intro U
  have hA := wc_proet_cover_of_affine_local (fun _ => True)
    (fun V hV => ⟨V, 𝟙 V, hV, inferInstance, inferInstance, trivial⟩) U
  refine GrothendieckTopology.superset_covering _ ?_ hA
  rw [Sieve.generate_le_iff]
  intro W h hW
  apply Sieve.le_generate
  intro e
  haveI : IsAffine W.left := hW.1
  obtain ⟨h1, h2⟩ := hqcqs W.left W.hom
  exact @hM ((wcProEtBaseChange f).obj W) h1 h2 k e

theorem rightDerived_delta_natural : ∀ {C D : Type*} [Category C] [Category D] [Abelian C]
    [Abelian D] [HasInjectiveResolutions C] (R : C ⥤ D) [R.Additive] (q : ℕ),
    ∃ δ : ∀ (S : ShortComplex C), S.ShortExact →
        ((R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁),
      (∀ (S : ShortComplex C) (hS : S.ShortExact),
        ∃ (h1 : (R.rightDerived q).map S.g ≫ δ S hS = 0)
          (h2 : δ S hS ≫ (R.rightDerived (q + 1)).map S.f = 0),
          (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact) ∧
      (∀ (S₁ S₂ : ShortComplex C) (h₁ : S₁.ShortExact) (h₂ : S₂.ShortExact) (φ : S₁ ⟶ S₂),
        δ S₁ h₁ ≫ (R.rightDerived (q + 1)).map φ.τ₁ = (R.rightDerived q).map φ.τ₃ ≫ δ S₂ h₂) :=
by
  intro C D _ _ _ _ _ R _ q

  have s1 : ∀ (S : ShortComplex C), S.ShortExact → ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃), ∃ (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 ∧ σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 ∧ ∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := by
    intro S hS I₁ I₃
    have hmf : Mono S.f := hS.mono_f
    have heg : Epi S.g := hS.epi_g
    obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
    obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
    have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
    have hι₁d : ι₁ ≫ I₁.cocomplex.d 0 1 = 0 := by subst hι₁; exact I₁.ι_f_zero_comp_complex_d
    have ref₃ : ∀ {A : C} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
        ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
      subst hι₃
      intro A x hx
      exact I₃.exact₀.exact_up_to_refinements x hx
    let σ : S.X₂ ⟶ I₁.cocomplex.X 0 := Injective.factorThru ι₁ S.f
    have hσ : S.f ≫ σ = ι₁ := Injective.comp_factorThru _ _
    have hv : S.f ≫ (-(σ ≫ I₁.cocomplex.d 0 1)) = 0 := by
      rw [Preadditive.comp_neg, ← Category.assoc, hσ, hι₁d, neg_zero]
    let u : S.X₃ ⟶ I₁.cocomplex.X 1 := hS.exact.desc _ hv
    have hu : S.g ≫ u = -(σ ≫ I₁.cocomplex.d 0 1) := hS.exact.g_desc _ hv
    let t₀ : I₃.cocomplex.X 0 ⟶ I₁.cocomplex.X 1 := Injective.factorThru u ι₃
    have ht₀ : ι₃ ≫ t₀ = u := Injective.comp_factorThru _ _
    let Q : ∀ n : ℕ, (I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)) → Prop := fun n t =>
      ∀ (A : C) (y : A ⟶ I₃.cocomplex.X n), y ≫ I₃.cocomplex.d n (n + 1) = 0 →
        y ≫ t ≫ I₁.cocomplex.d (n + 1) (n + 2) = 0
    have hud : u ≫ I₁.cocomplex.d 1 2 = 0 := by
      apply (cancel_epi S.g).1
      rw [← Category.assoc, hu, Preadditive.neg_comp, Category.assoc,
        HomologicalComplex.d_comp_d, Limits.comp_zero, neg_zero, Limits.comp_zero]
    have h₀ : Q 0 t₀ := by
      intro A y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref₃ y hy
      have key : π ≫ y ≫ t₀ ≫ I₁.cocomplex.d 1 2 = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc ι₃, ht₀, hud,
          Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    have step : ∀ (n : ℕ) (t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), Q n t →
        ∃ t' : I₃.cocomplex.X (n + 1) ⟶ I₁.cocomplex.X (n + 2),
          I₃.cocomplex.d n (n + 1) ≫ t' = -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) ∧
            Q (n + 1) t' := by
      intro n t ht
      let E := ShortComplex.mk (Limits.kernel.ι (I₃.cocomplex.d n (n + 1)))
        (I₃.cocomplex.d n (n + 1)) (Limits.kernel.condition _)
      have hE : E.Exact := E.exact_of_f_is_kernel (Limits.kernelIsKernel _)
      have hf : E.f ≫ (-(t ≫ I₁.cocomplex.d (n + 1) (n + 2))) = 0 := by
        rw [Preadditive.comp_neg, ht _ _ (Limits.kernel.condition _), neg_zero]
      have hdesc : I₃.cocomplex.d n (n + 1) ≫ hE.descToInjective _ hf =
          -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) := hE.comp_descToInjective _ hf
      refine ⟨hE.descToInjective _ hf, hdesc, ?_⟩
      intro A y hy
      have ref : ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (z : A' ⟶ I₃.cocomplex.X n),
          π ≫ y = z ≫ I₃.cocomplex.d n (n + 1) :=
        (I₃.exact_succ n).exact_up_to_refinements y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref
      have key : π ≫ y ≫ hE.descToInjective _ hf ≫ I₁.cocomplex.d (n + 2) (n + 3) = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc (I₃.cocomplex.d n (n + 1)),
          hdesc, Preadditive.neg_comp, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero, neg_zero, Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    choose F hF using step
    let T : ∀ n, {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t} := fun n =>
      Nat.rec (motive := fun n => {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t})
        ⟨t₀, h₀⟩ (fun n T => ⟨F n T.1 T.2, (hF n T.1 T.2).2⟩) n
    refine ⟨σ, fun n => (T n).1, hσ.trans hι₁, ?_, ?_⟩
    · show σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t₀ = 0
      rw [← hι₃, ht₀, hu, add_neg_cancel]
    · intro n
      show (T n).1 ≫ I₁.cocomplex.d (n + 1) (n + 2) +
        I₃.cocomplex.d n (n + 1) ≫ F n (T n).1 (T n).2 = 0
      rw [(hF n (T n).1 (T n).2).1, add_neg_cancel]

  have L3 : ∀ (A K B : CochainComplex C ℕ) (i : A ⟶ K) (p : K ⟶ B) (r : ∀ n : ℕ, K.X n ⟶ A.X n) (s : ∀ n : ℕ, B.X n ⟶ K.X n), (∀ n : ℕ, i.f n ≫ r n = 𝟙 _ ∧ s n ≫ p.f n = 𝟙 _ ∧ i.f n ≫ p.f n = 0 ∧ s n ≫ r n = 0 ∧ r n ≫ i.f n + p.f n ≫ s n = 𝟙 _) → ∃ hz : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫ (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p = 0, (ShortComplex.mk _ _ hz).ShortExact := by
    intro A K B i p r s hs
    have hip : i ≫ p = 0 := by
      ext n
      rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      exact (hs n).2.2.1
    have hz : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p = 0 := by
      rw [← Functor.map_comp, hip, Functor.map_zero]
    refine ⟨hz, ?_⟩
    apply HomologicalComplex.shortExact_of_degreewise_shortExact
    intro n
    let spl : (ShortComplex.mk (i.f n) (p.f n) (hs n).2.2.1).Splitting :=
      ShortComplex.Splitting.mk (r n) (s n) (hs n).1 (hs n).2.1 (hs n).2.2.2.2
    exact ShortComplex.shortExact_of_iso
      (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp) (by simp))
      (spl.map R).shortExact

  have L6 (A K B A' K' B' : CochainComplex C ℕ) (i : A ⟶ K) (p : K ⟶ B) (r : ∀ n : ℕ, K.X n ⟶ A.X n) (s : ∀ n : ℕ, B.X n ⟶ K.X n) (t : ∀ n : ℕ, B.X n ⟶ A.X (n + 1)) (i' : A' ⟶ K') (p' : K' ⟶ B') (r' : ∀ n : ℕ, K'.X n ⟶ A'.X n) (s' : ∀ n : ℕ, B'.X n ⟶ K'.X n) (t' : ∀ n : ℕ, B'.X n ⟶ A'.X (n + 1)) (a : A ⟶ A') (c : B ⟶ B') (h : ∀ n : ℕ, B.X n ⟶ A'.X n) (hs : ∀ n : ℕ, i.f n ≫ r n = 𝟙 _ ∧ s n ≫ p.f n = 𝟙 _ ∧ i.f n ≫ p.f n = 0 ∧ s n ≫ r n = 0 ∧ r n ≫ i.f n + p.f n ≫ s n = 𝟙 _) (hs' : ∀ n : ℕ, i'.f n ≫ r' n = 𝟙 _ ∧ s' n ≫ p'.f n = 𝟙 _ ∧ i'.f n ≫ p'.f n = 0 ∧ s' n ≫ r' n = 0 ∧ r' n ≫ i'.f n + p'.f n ≫ s' n = 𝟙 _) (hK : ∀ n : ℕ, K.d n (n + 1) = r n ≫ A.d n (n + 1) ≫ i.f (n + 1) + p.f n ≫ t n ≫ i.f (n + 1) + p.f n ≫ B.d n (n + 1) ≫ s (n + 1)) (hK' : ∀ n : ℕ, K'.d n (n + 1) = r' n ≫ A'.d n (n + 1) ≫ i'.f (n + 1) + p'.f n ≫ t' n ≫ i'.f (n + 1) + p'.f n ≫ B'.d n (n + 1) ≫ s' (n + 1)) (hh : ∀ n : ℕ, h n ≫ A'.d n (n + 1) + c.f n ≫ t' n = t n ≫ a.f (n + 1) + B.d n (n + 1) ≫ h (n + 1)) : ∃ b : K ⟶ K', i ≫ b = a ≫ i' ∧ b ≫ p' = p ≫ c := by
    have ir : ∀ n {Z : C} (x : A.X n ⟶ Z), i.f n ≫ r n ≫ x = x := fun n Z x => by
      rw [← Category.assoc, (hs n).1, Category.id_comp]
    have sp : ∀ n {Z : C} (x : B.X n ⟶ Z), s n ≫ p.f n ≫ x = x := fun n Z x => by
      rw [← Category.assoc, (hs n).2.1, Category.id_comp]
    have ip : ∀ n {Z : C} (x : B.X n ⟶ Z), i.f n ≫ p.f n ≫ x = 0 := fun n Z x => by
      rw [← Category.assoc, (hs n).2.2.1, Limits.zero_comp]
    have sr : ∀ n {Z : C} (x : A.X n ⟶ Z), s n ≫ r n ≫ x = 0 := fun n Z x => by
      rw [← Category.assoc, (hs n).2.2.2.1, Limits.zero_comp]
    have ir' : ∀ n {Z : C} (x : A'.X n ⟶ Z), i'.f n ≫ r' n ≫ x = x := fun n Z x => by
      rw [← Category.assoc, (hs' n).1, Category.id_comp]
    have sp' : ∀ n {Z : C} (x : B'.X n ⟶ Z), s' n ≫ p'.f n ≫ x = x := fun n Z x => by
      rw [← Category.assoc, (hs' n).2.1, Category.id_comp]
    have ip' : ∀ n {Z : C} (x : B'.X n ⟶ Z), i'.f n ≫ p'.f n ≫ x = 0 := fun n Z x => by
      rw [← Category.assoc, (hs' n).2.2.1, Limits.zero_comp]
    have sr' : ∀ n {Z : C} (x : A'.X n ⟶ Z), s' n ≫ r' n ≫ x = 0 := fun n Z x => by
      rw [← Category.assoc, (hs' n).2.2.2.1, Limits.zero_comp]
    let bf : ∀ n, K.X n ⟶ K'.X n := fun n =>
      r n ≫ a.f n ≫ i'.f n + p.f n ≫ h n ≫ i'.f n + p.f n ≫ c.f n ≫ s' n
    have hcomm : ∀ n, bf n ≫ K'.d n (n + 1) = K.d n (n + 1) ≫ bf (n + 1) := by
      intro n
      rw [hK n, hK' n]
      simp only [bf, Preadditive.add_comp, Preadditive.comp_add, Category.assoc, ir, sp, ip, sr,
        ir', sp', ip', sr', Limits.comp_zero, add_zero, zero_add]
      have e1 : a.f n ≫ A'.d n (n + 1) ≫ i'.f (n + 1) = A.d n (n + 1) ≫ a.f (n + 1) ≫ i'.f (n + 1) := by
        rw [← Category.assoc, a.comm, Category.assoc]
      have e3 : c.f n ≫ B'.d n (n + 1) ≫ s' (n + 1) = B.d n (n + 1) ≫ c.f (n + 1) ≫ s' (n + 1) := by
        rw [← Category.assoc, c.comm, Category.assoc]
      have e2 : p.f n ≫ h n ≫ A'.d n (n + 1) ≫ i'.f (n + 1) + p.f n ≫ c.f n ≫ t' n ≫ i'.f (n + 1) =
          p.f n ≫ t n ≫ a.f (n + 1) ≫ i'.f (n + 1) + p.f n ≫ B.d n (n + 1) ≫ h (n + 1) ≫ i'.f (n + 1) := by
        have : h n ≫ A'.d n (n + 1) ≫ i'.f (n + 1) + c.f n ≫ t' n ≫ i'.f (n + 1) =
            t n ≫ a.f (n + 1) ≫ i'.f (n + 1) + B.d n (n + 1) ≫ h (n + 1) ≫ i'.f (n + 1) := by
          simp only [← Category.assoc, ← Preadditive.add_comp, hh n]
        rw [← Preadditive.comp_add, this, Preadditive.comp_add]
      rw [e1, e3]
      rw [← sub_eq_zero] at e2 ⊢
      rw [← e2]
      abel
    let b : K ⟶ K' :=
      { f := bf
        comm' := by
          rintro n m rfl
          exact hcomm n }
    refine ⟨b, ?_, ?_⟩
    · ext n
      simp only [HomologicalComplex.comp_f]
      show i.f n ≫ bf n = _
      simp only [bf, Preadditive.comp_add, ir, ip, add_zero]
    · ext n
      simp only [HomologicalComplex.comp_f]
      show bf n ≫ p'.f n = _
      simp only [bf, Preadditive.add_comp, Category.assoc, (hs' n).2.2.1, (hs' n).2.1,
        Category.comp_id, Limits.comp_zero, zero_add]

  have L7 (S₁ S₂ : ShortComplex C) (φ : S₁ ⟶ S₂) (I₁ : InjectiveResolution S₁.X₁) (I₂ : InjectiveResolution S₁.X₂) (I₃ : InjectiveResolution S₁.X₃) (J₁ : InjectiveResolution S₂.X₁) (J₂ : InjectiveResolution S₂.X₂) (J₃ : InjectiveResolution S₂.X₃) (i : I₁.cocomplex ⟶ I₂.cocomplex) (p : I₂.cocomplex ⟶ I₃.cocomplex) (i' : J₁.cocomplex ⟶ J₂.cocomplex) (p' : J₂.cocomplex ⟶ J₃.cocomplex) (a : I₁.cocomplex ⟶ J₁.cocomplex) (b : I₂.cocomplex ⟶ J₂.cocomplex) (c : I₃.cocomplex ⟶ J₃.cocomplex) (ha : I₁.ι ≫ a = (CochainComplex.single₀ C).map φ.τ₁ ≫ J₁.ι) (hc : I₃.ι ≫ c = (CochainComplex.single₀ C).map φ.τ₃ ≫ J₃.ι) (hb1 : i ≫ b = a ≫ i') (hb2 : b ≫ p' = p ≫ c) (hz : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫ (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p = 0) (hS' : (ShortComplex.mk _ _ hz).ShortExact) (hz' : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i' ≫ (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p' = 0) (hS'' : (ShortComplex.mk _ _ hz').ShortExact) (hrel : (ComplexShape.up ℕ).Rel q (q + 1)) : ((I₃.isoRightDerivedObj R q).hom ≫ hS'.δ q (q + 1) hrel ≫ (I₁.isoRightDerivedObj R (q + 1)).inv) ≫ (R.rightDerived (q + 1)).map φ.τ₁ = (R.rightDerived q).map φ.τ₃ ≫ ((J₃.isoRightDerivedObj R q).hom ≫ hS''.δ q (q + 1) hrel ≫ (J₁.isoRightDerivedObj R (q + 1)).inv) := by
    have e1 : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map a ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i' =
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map b := by
      rw [← Functor.map_comp, ← Functor.map_comp, hb1]
    have e2 : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map b ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p' =
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map c := by
      rw [← Functor.map_comp, ← Functor.map_comp, hb2]
    let Ψ : ShortComplex.mk _ _ hz ⟶ ShortComplex.mk _ _ hz' :=
      ShortComplex.homMk ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map a)
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map b)
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).map c) e1 e2
    have N := HomologicalComplex.HomologySequence.δ_naturality Ψ hS' hS'' q (q + 1) hrel
    have N' : hS'.δ q (q + 1) hrel ≫ (R.mapHomologicalComplex (ComplexShape.up ℕ) ⋙
          HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) (q + 1)).map a =
        (R.mapHomologicalComplex (ComplexShape.up ℕ) ⋙
          HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map c ≫
          hS''.δ q (q + 1) hrel := N
    have gen : ∀ {P Q Q' T T' U U' W : D} (x : P ⟶ Q) (d1 : Q ⟶ T) (e : T' ≅ T) (M : T ⟶ U)
        (w : U ⟶ W) (M' : Q ⟶ Q') (f : U' ≅ Q') (d2 : Q' ⟶ U), d1 ≫ M = M' ≫ d2 →
        (x ≫ d1 ≫ e.inv) ≫ (e.hom ≫ M ≫ w) = (x ≫ M' ≫ f.inv) ≫ (f.hom ≫ d2 ≫ w) := by
      intro P Q Q' T T' U U' W x d1 e M w M' f d2 h
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
      rw [reassoc_of% h]
    rw [R.rightDerived_map_eq (q + 1) φ.τ₁ a ha, R.rightDerived_map_eq q φ.τ₃ c hc]
    exact gen _ _ _ _ _ _ _ _ N'

  have L5 (S₁ S₂ : ShortComplex C) (h₁ : S₁.ShortExact) (φ : S₁ ⟶ S₂) (I₁ : InjectiveResolution S₁.X₁) (I₃ : InjectiveResolution S₁.X₃) (J₁ : InjectiveResolution S₂.X₁) (J₃ : InjectiveResolution S₂.X₃) (σ : S₁.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)) (σ' : S₂.X₂ ⟶ J₁.cocomplex.X 0) (t' : ∀ n : ℕ, J₃.cocomplex.X n ⟶ J₁.cocomplex.X (n + 1)) (a : I₁.cocomplex ⟶ J₁.cocomplex) (c : I₃.cocomplex ⟶ J₃.cocomplex) (H1 : S₁.f ≫ σ = I₁.ι.f 0) (H2 : σ ≫ I₁.cocomplex.d 0 1 + S₁.g ≫ I₃.ι.f 0 ≫ t 0 = 0) (H3 : ∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0) (H1' : S₂.f ≫ σ' = J₁.ι.f 0) (H2' : σ' ≫ J₁.cocomplex.d 0 1 + S₂.g ≫ J₃.ι.f 0 ≫ t' 0 = 0) (H3' : ∀ n : ℕ, t' n ≫ J₁.cocomplex.d (n + 1) (n + 2) + J₃.cocomplex.d n (n + 1) ≫ t' (n + 1) = 0) (ha : I₁.ι ≫ a = (CochainComplex.single₀ C).map φ.τ₁ ≫ J₁.ι) (hc : I₃.ι ≫ c = (CochainComplex.single₀ C).map φ.τ₃ ≫ J₃.ι) : ∃ h : ∀ n : ℕ, I₃.cocomplex.X n ⟶ J₁.cocomplex.X n, ∀ n : ℕ, h n ≫ J₁.cocomplex.d n (n + 1) + c.f n ≫ t' n = t n ≫ a.f (n + 1) + I₃.cocomplex.d n (n + 1) ≫ h (n + 1) := by
    have heg : Epi S₁.g := h₁.epi_g
    obtain ⟨ι₁, hι₁⟩ : ∃ x : S₁.X₁ ⟶ I₁.cocomplex.X 0, x = I₁.ι.f 0 := ⟨_, rfl⟩
    obtain ⟨ι₃, hι₃⟩ : ∃ x : S₁.X₃ ⟶ I₃.cocomplex.X 0, x = I₃.ι.f 0 := ⟨_, rfl⟩
    obtain ⟨ι₁', hι₁'⟩ : ∃ x : S₂.X₁ ⟶ J₁.cocomplex.X 0, x = J₁.ι.f 0 := ⟨_, rfl⟩
    obtain ⟨ι₃', hι₃'⟩ : ∃ x : S₂.X₃ ⟶ J₃.cocomplex.X 0, x = J₃.ι.f 0 := ⟨_, rfl⟩
    have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
    have A0 : ι₁ ≫ a.f 0 = φ.τ₁ ≫ ι₁' := by
      have := congrArg (fun ψ => HomologicalComplex.Hom.f ψ 0) ha
      simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
      subst hι₁ hι₁'
      exact this
    have C0 : ι₃ ≫ c.f 0 = φ.τ₃ ≫ ι₃' := by
      have := congrArg (fun ψ => HomologicalComplex.Hom.f ψ 0) hc
      simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
      subst hι₃ hι₃'
      exact this
    have H1x : S₁.f ≫ σ = ι₁ := by subst hι₁; exact H1
    have H1x' : S₂.f ≫ σ' = ι₁' := by subst hι₁'; exact H1'
    have H2x : S₁.g ≫ ι₃ ≫ t 0 = -(σ ≫ I₁.cocomplex.d 0 1) := by
      subst hι₃
      exact (neg_eq_of_add_eq_zero_right H2).symm
    have H2x' : S₂.g ≫ ι₃' ≫ t' 0 = -(σ' ≫ J₁.cocomplex.d 0 1) := by
      subst hι₃'
      exact (neg_eq_of_add_eq_zero_right H2').symm
    obtain ⟨θ, hθdef⟩ : ∃ θ : S₁.X₂ ⟶ J₁.cocomplex.X 0, θ = φ.τ₂ ≫ σ' - σ ≫ a.f 0 := ⟨_, rfl⟩
    have hθ : S₁.f ≫ θ = 0 := by
      have e1 : S₁.f ≫ φ.τ₂ ≫ σ' = φ.τ₁ ≫ ι₁' := by
        rw [← Category.assoc, ← φ.comm₁₂, Category.assoc, H1x']
      have e2 : S₁.f ≫ σ ≫ a.f 0 = φ.τ₁ ≫ ι₁' := by
        rw [← Category.assoc, H1x, A0]
      rw [hθdef, Preadditive.comp_sub, e1, e2, sub_self]
    obtain ⟨θb, hθb⟩ : ∃ θb : S₁.X₃ ⟶ J₁.cocomplex.X 0, S₁.g ≫ θb = θ :=
      ⟨h₁.exact.desc θ hθ, h₁.exact.g_desc θ hθ⟩
    obtain ⟨h₀, hh₀⟩ : ∃ h₀ : I₃.cocomplex.X 0 ⟶ J₁.cocomplex.X 0, ι₃ ≫ h₀ = θb :=
      ⟨Injective.factorThru θb ι₃, Injective.comp_factorThru _ _⟩
    have Ac0 : a.f 0 ≫ J₁.cocomplex.d 0 1 = I₁.cocomplex.d 0 1 ≫ a.f 1 := a.comm 0 1
    have k1 : S₁.g ≫ ι₃ ≫ h₀ ≫ J₁.cocomplex.d 0 1 =
        φ.τ₂ ≫ σ' ≫ J₁.cocomplex.d 0 1 - σ ≫ I₁.cocomplex.d 0 1 ≫ a.f 1 := by
      rw [← Category.assoc ι₃ h₀, hh₀, ← Category.assoc, hθb, hθdef, Preadditive.sub_comp]
      simp only [Category.assoc]
      rw [Ac0]
    have k2 : S₁.g ≫ ι₃ ≫ c.f 0 ≫ t' 0 = -(φ.τ₂ ≫ σ' ≫ J₁.cocomplex.d 0 1) := by
      rw [← Category.assoc ι₃ (c.f 0), C0]
      simp only [Category.assoc]
      rw [← Category.assoc S₁.g φ.τ₃, ← φ.comm₂₃, Category.assoc, H2x', Preadditive.comp_neg]
    have k3 : S₁.g ≫ ι₃ ≫ t 0 ≫ a.f 1 = -(σ ≫ I₁.cocomplex.d 0 1 ≫ a.f 1) := by
      rw [← Category.assoc ι₃ (t 0), ← Category.assoc S₁.g, H2x, Preadditive.neg_comp,
        Category.assoc]
    have hbase : ι₃ ≫ (h₀ ≫ J₁.cocomplex.d 0 1 + c.f 0 ≫ t' 0 - t 0 ≫ a.f 1) = 0 := by
      apply (cancel_epi S₁.g).1
      rw [Limits.comp_zero]
      simp only [Preadditive.comp_add, Preadditive.comp_sub]
      rw [k1, k2, k3]
      abel
    have hbase' : I₃.ι.f 0 ≫ (h₀ ≫ J₁.cocomplex.d 0 1 + c.f 0 ≫ t' 0 - t 0 ≫ a.f 1) = 0 := by
      subst hι₃
      exact hbase
    obtain ⟨h₁', hh₁'⟩ : ∃ y : I₃.cocomplex.X 1 ⟶ J₁.cocomplex.X 1,
        I₃.cocomplex.d 0 1 ≫ y = h₀ ≫ J₁.cocomplex.d 0 1 + c.f 0 ≫ t' 0 - t 0 ≫ a.f 1 :=
      ⟨I₃.exact₀.descToInjective _ hbase', I₃.exact₀.comp_descToInjective _ hbase'⟩
    let Eqn : ∀ n : ℕ, (I₃.cocomplex.X n ⟶ J₁.cocomplex.X n) →
        (I₃.cocomplex.X (n + 1) ⟶ J₁.cocomplex.X (n + 1)) → Prop := fun n x y =>
      I₃.cocomplex.d n (n + 1) ≫ y = x ≫ J₁.cocomplex.d n (n + 1) + c.f n ≫ t' n - t n ≫ a.f (n + 1)
    have step : ∀ (n : ℕ) (x : I₃.cocomplex.X n ⟶ J₁.cocomplex.X n)
        (y : I₃.cocomplex.X (n + 1) ⟶ J₁.cocomplex.X (n + 1)), Eqn n x y →
        ∃ z : I₃.cocomplex.X (n + 2) ⟶ J₁.cocomplex.X (n + 2), Eqn (n + 1) y z := by
      intro n x y hxy
      have E1 : I₃.cocomplex.d n (n + 1) ≫ y =
          x ≫ J₁.cocomplex.d n (n + 1) + c.f n ≫ t' n - t n ≫ a.f (n + 1) := hxy
      have Cc : c.f n ≫ J₃.cocomplex.d n (n + 1) = I₃.cocomplex.d n (n + 1) ≫ c.f (n + 1) :=
        c.comm n (n + 1)
      have Ac : a.f (n + 1) ≫ J₁.cocomplex.d (n + 1) (n + 2) =
          I₁.cocomplex.d (n + 1) (n + 2) ≫ a.f (n + 2) := a.comm (n + 1) (n + 2)
      have H3n : I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = -(t n ≫ I₁.cocomplex.d (n + 1) (n + 2)) :=
        (neg_eq_of_add_eq_zero_right (H3 n)).symm
      have H3c : c.f n ≫ t' n ≫ J₁.cocomplex.d (n + 1) (n + 2) +
          c.f n ≫ J₃.cocomplex.d n (n + 1) ≫ t' (n + 1) = 0 := by
        rw [← Preadditive.comp_add, H3' n, Limits.comp_zero]
      have hclaim : I₃.cocomplex.d n (n + 1) ≫ (y ≫ J₁.cocomplex.d (n + 1) (n + 2) +
          c.f (n + 1) ≫ t' (n + 1) - t (n + 1) ≫ a.f (n + 2)) = 0 := by
        rw [Preadditive.comp_sub, Preadditive.comp_add,
          ← Category.assoc (I₃.cocomplex.d n (n + 1)) y, E1,
          ← Category.assoc (I₃.cocomplex.d n (n + 1)) (c.f (n + 1)), ← Cc,
          ← Category.assoc (I₃.cocomplex.d n (n + 1)) (t (n + 1)), H3n]
        simp only [Preadditive.add_comp, Preadditive.sub_comp, Preadditive.neg_comp,
          Category.assoc, HomologicalComplex.d_comp_d, Limits.comp_zero, zero_add]
        rw [Ac]
        calc _ = c.f n ≫ t' n ≫ J₁.cocomplex.d (n + 1) (n + 2) +
              c.f n ≫ J₃.cocomplex.d n (n + 1) ≫ t' (n + 1) := by abel
          _ = 0 := H3c
      exact ⟨(I₃.exact_succ n).descToInjective _ hclaim,
        (I₃.exact_succ n).comp_descToInjective _ hclaim⟩
    choose G hG using step
    let T : ∀ n : ℕ, {pr : (I₃.cocomplex.X n ⟶ J₁.cocomplex.X n) ×
        (I₃.cocomplex.X (n + 1) ⟶ J₁.cocomplex.X (n + 1)) // Eqn n pr.1 pr.2} := fun n =>
      Nat.rec (motive := fun n => {pr : (I₃.cocomplex.X n ⟶ J₁.cocomplex.X n) ×
        (I₃.cocomplex.X (n + 1) ⟶ J₁.cocomplex.X (n + 1)) // Eqn n pr.1 pr.2})
        ⟨(h₀, h₁'), hh₁'⟩
        (fun n T => ⟨(T.1.2, G n T.1.1 T.1.2 T.2), hG n T.1.1 T.1.2 T.2⟩) n
    refine ⟨fun n => (T n).1.1, fun n => ?_⟩
    have e : I₃.cocomplex.d n (n + 1) ≫ (T n).1.2 =
        (T n).1.1 ≫ J₁.cocomplex.d n (n + 1) + c.f n ≫ t' n - t n ≫ a.f (n + 1) := (T n).2
    show (T n).1.1 ≫ J₁.cocomplex.d n (n + 1) + c.f n ≫ t' n =
      t n ≫ a.f (n + 1) + I₃.cocomplex.d n (n + 1) ≫ (T n).1.2
    rw [e]
    abel

  have L2 : ∀ (S : ShortComplex C), S.ShortExact → ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 → σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 → (∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0) → ∃ (I₂ : InjectiveResolution S.X₂) (i : I₁.cocomplex ⟶ I₂.cocomplex) (p : I₂.cocomplex ⟶ I₃.cocomplex) (r : ∀ n : ℕ, I₂.cocomplex.X n ⟶ I₁.cocomplex.X n) (s : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₂.cocomplex.X n), I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ I₂.ι ∧ I₂.ι ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι ∧ (∀ n : ℕ, i.f n ≫ r n = 𝟙 _ ∧ s n ≫ p.f n = 𝟙 _ ∧ i.f n ≫ p.f n = 0 ∧ s n ≫ r n = 0 ∧ r n ≫ i.f n + p.f n ≫ s n = 𝟙 _) ∧ ∀ n : ℕ, I₂.cocomplex.d n (n + 1) = r n ≫ I₁.cocomplex.d n (n + 1) ≫ i.f (n + 1) + p.f n ≫ t n ≫ i.f (n + 1) + p.f n ≫ I₃.cocomplex.d n (n + 1) ≫ s (n + 1) := by
    intro S hS I₁ I₃ σ t H1 H2 H3
    let X : ℕ → C := fun n => I₁.cocomplex.X n ⊞ I₃.cocomplex.X n
    let d : ∀ n, X n ⟶ X (n + 1) := fun n =>
      Limits.biprod.lift (Limits.biprod.fst ≫ I₁.cocomplex.d n (n + 1) + Limits.biprod.snd ≫ t n)
        (Limits.biprod.snd ≫ I₃.cocomplex.d n (n + 1))
    have sq : ∀ n, d n ≫ d (n + 1) = 0 := by
      intro n
      have h3 : t n ≫ I₁.cocomplex.d (n + 1) (n + 1 + 1) +
          I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := H3 n
      apply Limits.biprod.hom_ext
      · simp only [d, Category.assoc, Limits.biprod.lift_fst, Preadditive.comp_add,
          Preadditive.add_comp, Limits.biprod.lift_fst_assoc, Limits.biprod.lift_snd_assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, zero_add, Limits.zero_comp]
        rw [← Preadditive.comp_add, h3, Limits.comp_zero]
      · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
