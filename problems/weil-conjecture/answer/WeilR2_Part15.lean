    (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)
  obtain ⟨Θa, Θb, hΘab⟩ := bridge D.f V₀.hom a c.hom.left c.inv.left hγ1 hγ2 hγ E.hom a₀.left
    (MorphismProperty.Over.w a₀) τ ξ hξdef.symm (ℓ ^ k) q _ hp1 hp2 Ep D'
    (fun g hg Dg => wc_et_sepclosed_field_ext_proper_pull_bij L (AlgebraicClosure L)
      (algebraMap L (AlgebraicClosure L)) (Limits.pullback E.hom D.f)
      (Limits.pullback.fst E.hom D.f ≫ eE.hom) _ g _
      (by have h := hg.paste_vert hQ4; rwa [Category.comp_id] at h) (ℓ ^ k) hm Dg q)
