theorem wc_lsiaq_reaug_criterion : ∀ {C : Type*} [Category C] [Abelian C] (M : C) (K : CochainComplex C ℕ) (e ε : (CochainComplex.single₀ C).obj M ⟶ K), QuasiIso e → ∃ β : M ⟶ M, (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ ε.f 0 = β ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).inv ≫ e.f 0 ∧ (IsIso β → QuasiIso ε) :=
by
  intro C _ _ M K e ε he
  let S := (CochainComplex.single₀ C).obj M
  have hπS : IsIso (S.homologyπ 0) := by
    apply HomologicalComplex.isIso_homologyπ S 0 0 (CochainComplex.prev_nat_zero)
    exact S.shape 0 0 (by simp)
  have hπK : IsIso (K.homologyπ 0) := by
    apply HomologicalComplex.isIso_homologyπ K 0 0 (CochainComplex.prev_nat_zero)
    exact K.shape 0 0 (by simp)
  have cyc : ∀ f : S ⟶ K, IsIso (HomologicalComplex.homologyMap f 0) →
      IsIso (HomologicalComplex.cyclesMap f 0) := by
    intro f hf
    have h1 := HomologicalComplex.homologyπ_naturality f 0
    have h2 : HomologicalComplex.cyclesMap f 0 =
        S.homologyπ 0 ≫ HomologicalComplex.homologyMap f 0 ≫ inv (K.homologyπ 0) := by
      rw [← Category.assoc, h1]; simp
    rw [h2]; infer_instance
  have hom : ∀ f : S ⟶ K, IsIso (HomologicalComplex.cyclesMap f 0) →
      IsIso (HomologicalComplex.homologyMap f 0) := by
    intro f hf
    have h1 := HomologicalComplex.homologyπ_naturality f 0
    have h2 : HomologicalComplex.homologyMap f 0 =
        inv (S.homologyπ 0) ≫ HomologicalComplex.cyclesMap f 0 ≫ K.homologyπ 0 := by
      rw [← h1]; simp
    rw [h2]; infer_instance
  set c := HomologicalComplex.singleObjCyclesSelfIso (ComplexShape.up ℕ) 0 M with hc
  set ι := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M with hι
  have lift : ∀ f : S ⟶ K, (c.inv ≫ HomologicalComplex.cyclesMap f 0) ≫ K.iCycles 0 =
      ι.inv ≫ f.f 0 := by
    intro f
    rw [Category.assoc, HomologicalComplex.cyclesMap_i, ← Category.assoc,
      HomologicalComplex.singleObjCyclesSelfIso_inv_iCycles]
  have heq : IsIso (HomologicalComplex.homologyMap e 0) :=
    (quasiIsoAt_iff_isIso_homologyMap e 0).mp ((quasiIso_iff e).mp he 0)
  have : IsIso (HomologicalComplex.cyclesMap e 0) := cyc e heq
  have hu : IsIso (c.inv ≫ HomologicalComplex.cyclesMap e 0) := inferInstance
  refine ⟨(c.inv ≫ HomologicalComplex.cyclesMap ε 0) ≫ inv (c.inv ≫ HomologicalComplex.cyclesMap e 0), ?_, ?_⟩
  · rw [← lift e, ← lift ε, Category.assoc (c.inv ≫ HomologicalComplex.cyclesMap ε 0),
      IsIso.inv_hom_id_assoc]
  · intro hβ
    rw [quasiIso_iff]
    intro i
    rw [quasiIsoAt_iff_isIso_homologyMap]
    rcases Nat.eq_zero_or_pos i with h0 | hpos
    · subst h0
      apply hom
      have hv : IsIso (c.inv ≫ HomologicalComplex.cyclesMap ε 0) := by
        have : c.inv ≫ HomologicalComplex.cyclesMap ε 0 =
            ((c.inv ≫ HomologicalComplex.cyclesMap ε 0) ≫
              inv (c.inv ≫ HomologicalComplex.cyclesMap e 0)) ≫
              (c.inv ≫ HomologicalComplex.cyclesMap e 0) := by simp
        rw [this]; infer_instance
      have : HomologicalComplex.cyclesMap ε 0 =
          c.hom ≫ (c.inv ≫ HomologicalComplex.cyclesMap ε 0) := by simp
      rw [this]; infer_instance
    · have hi : i ≠ 0 := by omega
      have hS : Limits.IsZero (S.homology i) :=
        HomologicalComplex.isZero_single_obj_homology (ComplexShape.up ℕ) 0 M i hi
      have hei : IsIso (HomologicalComplex.homologyMap e i) :=
        (quasiIsoAt_iff_isIso_homologyMap e i).mp ((quasiIso_iff e).mp he i)
      have hK : Limits.IsZero (K.homology i) :=
        Limits.IsZero.of_iso hS (asIso (HomologicalComplex.homologyMap e i)).symm
      exact Limits.IsZero.isIso hS hK _

theorem wc_lsiaq_const_endo_isIso : ∀ (Y : Scheme.{u}) (ℓ : ℕ), ℓ.Prime → ∀ (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (β : wcConstZ Y ℓ ⟶ wcConstZ Y ℓ) (ψ : wcConstZ Y ℓ ⟶ M), (∀ N : Y.Etale, Nonempty N.left → (M.obj.map (wcKrToTop Y N).op).hom (((β ≫ ψ).hom.app (Opposite.op (wcEtTop Y))).hom (wcConstSec Y (ULift.{u+1} (ZMod ℓ)) (wcEtTop Y) (ULift.up 1))) ≠ 0) → IsIso β :=
by
  classical
  intro Y ℓ hℓ M β ψ hyp

  have grp : ∀ (S : Type (u+1)) [AddCommGroup S] [Finite S], Nat.card S = ℓ →
      ∀ (b : S →+ S) (g : S), b g ≠ 0 → Function.Bijective b := by
    intro S _ _ hS b g hg
    have hdvd := AddSubgroup.card_addSubgroup_dvd_card b.ker
    rw [hS] at hdvd
    rcases hℓ.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · have hbot : b.ker = ⊥ := AddSubgroup.eq_bot_of_card_eq _ h1
      have hinj : Function.Injective b := (AddMonoidHom.ker_eq_bot_iff b).mp hbot
      exact Finite.injective_iff_bijective.mp hinj
    · exfalso
      have htop : b.ker = ⊤ := (AddSubgroup.card_eq_iff_eq_top _).mp (h1.trans hS.symm)
      apply hg
      have hmem : g ∈ b.ker := by rw [htop]; exact AddSubgroup.mem_top g
      exact (AddMonoidHom.mem_ker).mp hmem
  apply wc_et_isIso_of_geom_stalks_bijective Y β
  intro y
  obtain ⟨hfin, hcard, -⟩ := wc_et_const_zmod_stalk_cyclic Y ℓ hℓ.pos y
  have hcof : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) :=
    wc_et_geomstalk_cofiltered Y y (@fun P E S e _ a b h Ω _ π hπ =>
      @wc_etale_maps_agree_near_geom_point P E S e _ a b h Ω _ π hπ)
  obtain ⟨-, -, gnatΛ⟩ := wc_et_stalk_germ_facts Y y hcof (wcConstZ Y ℓ)
  obtain ⟨-, gextM, gnatM⟩ := wc_et_stalk_germ_facts Y y hcof M
  let A₀ : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
    StructuredArrow.mk (Y := wcEtTop Y) (Over.homMk (wcEtGeomPt Y y) (Category.comp_id _))
  let one : (wcConstZ Y ℓ).obj.obj (Opposite.op A₀.right) :=
    wcConstSec Y (ULift.{u+1} (ZMod ℓ)) (wcEtTop Y) (ULift.up 1)
  let s : M.obj.obj (Opposite.op A₀.right) :=
    ((β ≫ ψ).hom.app (Opposite.op (wcEtTop Y))).hom
      (wcConstSec Y (ULift.{u+1} (ZMod ℓ)) (wcEtTop Y) (ULift.up 1))
  let g₁ := (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
      (Scheme.Etale.forget Y)).op ⋙ (wcConstZ Y ℓ).obj) (Opposite.op A₀)).hom one
  have e1 := gnatΛ (wcConstZ Y ℓ) β A₀ one
  have e2 := gnatM (wcConstZ Y ℓ) ψ A₀ ((β.hom.app (Opposite.op A₀.right)).hom one)
  have hchain : ((wcEtStalk Y y).map ψ).hom (((wcEtStalk Y y).map β).hom g₁) =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ M.obj) (Opposite.op A₀)).hom s :=
    (congrArg (fun x => ((wcEtStalk Y y).map ψ).hom x) e1).trans (e2.trans rfl)
  have hgerm : (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ M.obj) (Opposite.op A₀)).hom s ≠ 0 := by
    intro h0
    have h0' : (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ M.obj) (Opposite.op A₀)).hom s =
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ M.obj) (Opposite.op A₀)).hom
          (0 : M.obj.obj (Opposite.op A₀.right)) := by
      rw [h0, map_zero]
    obtain ⟨A'', f, f', hff⟩ := gextM A₀ A₀ s 0 h0'
    rw [map_zero] at hff
    have hc : f.right = wcKrToTop Y A''.right := by
      apply MorphismProperty.Over.Hom.ext
      unfold wcKrToTop
      exact (Category.comp_id _).symm.trans (MorphismProperty.Over.w f.right)
    rw [hc] at hff
    exact hyp A''.right
      ⟨A''.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))⟩ hff
  have hne : ((wcEtStalk Y y).map β).hom g₁ ≠ 0 := by
    intro h
    apply hgerm
    rw [← hchain, h, map_zero]
  haveI := hfin
  exact grp _ hcard _ g₁ hne

theorem wc_lsiaq_const_zmod_hom_ext : ∀ (Y : Scheme.{u}) (m : ℕ) (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (f₁ f₂ : wcConstZ Y m ⟶ M), (f₁.hom.app (Opposite.op (wcEtTop Y))).hom (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1)) = (f₂.hom.app (Opposite.op (wcEtTop Y))).hom (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1)) → f₁ = f₂ :=
by
  intro Y m M f₁ f₂ hf
  have red : ∀ (g₁ g₂ : (Functor.const (Scheme.Etale Y)ᵒᵖ).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ M.obj),
      (∀ a, (g₁.app (Opposite.op (wcEtTop Y))).hom a = (g₂.app (Opposite.op (wcEtTop Y))).hom a) →
      g₁ = g₂ := by
    intro g₁ g₂ h
    ext U a
    obtain ⟨U⟩ := U
    have bang : U ⟶ wcEtTop Y := MorphismProperty.Over.homMk U.hom (Category.comp_id _) trivial
    have e1 := g₁.naturality bang.op
    have e2 := g₂.naturality bang.op
    have e1' : (g₁.app (Opposite.op U)).hom a =
        (M.obj.map bang.op).hom ((g₁.app (Opposite.op (wcEtTop Y))).hom a) :=
      congrArg (fun φ => φ.hom a) e1
    have e2' : (g₂.app (Opposite.op U)).hom a =
        (M.obj.map bang.op).hom ((g₂.app (Opposite.op (wcEtTop Y))).hom a) :=
      congrArg (fun φ => φ.hom a) e2
    rw [e1', e2', h a]
  apply Sheaf.hom_ext
  apply sheafify_hom_ext _ _ _ M.property
  apply red
  intro a
  obtain ⟨k, hk⟩ := ZMod.intCast_surjective a.down
  have ha : a = k • (ULift.up (1 : ZMod m) : ULift.{u+1} (ZMod m)) := by
    apply ULift.ext
    show a.down = k • (1 : ZMod m)
    rw [zsmul_one, hk]
  rw [ha, map_zsmul, map_zsmul]
  exact congrArg (fun t => k • t) hf

theorem wc_lsiaq_rho3_local : ∀ {W U Zs Xb : Scheme.{u}} (p₁ : W ⟶ U) (p₂ : U ⟶ Zs) (p₃ : Zs ⟶ Xb) (F : Sheaf (Scheme.smallEtaleTopology Xb) AddCommGrpCat.{u+1}) (t : F.obj.obj (Opposite.op (wcEtTop Xb))) (N : W.Etale) (o : N.left), (((wcEtInv p₁).obj ((wcEtInv p₂).obj ((wcEtInv p₃).obj F))).obj.map (wcKrToTop W N).op).hom (wcEtInvRho p₁ ((wcEtInv p₂).obj ((wcEtInv p₃).obj F)) (wcEtTop U) (wcEtTop W) p₁ ((Category.comp_id _).trans (Category.id_comp _).symm) (wcEtInvRho p₂ ((wcEtInv p₃).obj F) (wcEtTop Zs) (wcEtTop U) p₂ ((Category.comp_id _).trans (Category.id_comp _).symm) (wcEtInvRho p₃ F (wcEtTop Xb) (wcEtTop Zs) p₃ ((Category.comp_id _).trans (Category.id_comp _).symm) t))) = 0 → ∃ (V : Xb.Etale) (c : V ⟶ wcEtTop Xb) (v : V.left), V.hom v = p₃ (p₂ (p₁ (N.hom o))) ∧ (F.obj.map c.op).hom t = 0 :=
