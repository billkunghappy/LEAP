        refine (ShortComplex.quasiIso_iff_of_zeros _ ?_ ?_ ?_).2 ⟨hexact, hmono'⟩
        · exact ((CochainComplex.single₀ C).obj S.X₂).shape 0 0 (by simp)
        · rfl
        · exact K.shape 0 0 (by simp)
    let I₂ : InjectiveResolution S.X₂ :=
      { cocomplex := K
        injective := fun n => by
          show Injective (I₁.cocomplex.X n ⊞ I₃.cocomplex.X n)
          infer_instance
        ι := e
        quasiIso := he }
    refine ⟨I₂, i, p, fun n => (Limits.biprod.fst : X n ⟶ _),
      fun n => (Limits.biprod.inr : _ ⟶ X n), hi, hp, hspl, fun n => ?_⟩
    show K.d n (n + 1) = _
    rw [hKd n]
    apply Limits.biprod.hom_ext
    · simp [d, i, p]
    · simp [d, i, p]

  have hrel : (ComplexShape.up ℕ).Rel q (q + 1) := rfl
  have L4 (S : ShortComplex C) (I₁ : InjectiveResolution S.X₁) (I₂ : InjectiveResolution S.X₂) (I₃ : InjectiveResolution S.X₃) (i : I₁.cocomplex ⟶ I₂.cocomplex) (p : I₂.cocomplex ⟶ I₃.cocomplex) (hi : I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ I₂.ι) (hp : I₂.ι ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι) (hz : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫ (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p = 0) (hS' : (ShortComplex.mk _ _ hz).ShortExact) : ∃ (h1 : (R.rightDerived q).map S.g ≫ ((I₃.isoRightDerivedObj R q).hom ≫ hS'.δ q (q + 1) hrel ≫ (I₁.isoRightDerivedObj R (q + 1)).inv) = 0) (h2 : ((I₃.isoRightDerivedObj R q).hom ≫ hS'.δ q (q + 1) hrel ≫ (I₁.isoRightDerivedObj R (q + 1)).inv) ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact := by
    let S' := ShortComplex.mk _ _ hz
    let α₁ : ∀ k, (R.rightDerived k).obj S.X₁ ≅ S'.X₁.homology k :=
      fun k => I₁.isoRightDerivedObj R k
    let α₂ : ∀ k, (R.rightDerived k).obj S.X₂ ≅ S'.X₂.homology k :=
      fun k => I₂.isoRightDerivedObj R k
    let α₃ : ∀ k, (R.rightDerived k).obj S.X₃ ≅ S'.X₃.homology k :=
      fun k => I₃.isoRightDerivedObj R k
    have C1 : ∀ k, (α₁ k).hom ≫ HomologicalComplex.homologyMap S'.f k =
        (R.rightDerived k).map S.f ≫ (α₂ k).hom := by
      intro k
      show (I₁.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₂.isoRightDerivedObj R k).hom
      rw [R.rightDerived_map_eq k S.f i hi, Category.assoc, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
      rfl
    have C2 : ∀ k, (α₂ k).hom ≫ HomologicalComplex.homologyMap S'.g k =
        (R.rightDerived k).map S.g ≫ (α₃ k).hom := by
      intro k
      show (I₂.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₃.isoRightDerivedObj R k).hom
      rw [R.rightDerived_map_eq k S.g p hp, Category.assoc, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
      rfl
    let δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁ :=
      (α₃ q).hom ≫ hS'.δ q (q + 1) hrel ≫ (α₁ (q + 1)).inv
    have Cδ : (α₃ q).hom ≫ hS'.δ q (q + 1) hrel = δ ≫ (α₁ (q + 1)).hom := by
      simp only [δ, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have h1 : (R.rightDerived q).map S.g ≫ δ = 0 := by
      rw [← cancel_mono (α₁ (q + 1)).hom, Category.assoc, ← Cδ,
        ← Category.assoc, ← C2, Category.assoc, hS'.comp_δ, Limits.comp_zero, Limits.zero_comp]
    have h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0 := by
      rw [← cancel_mono (α₂ (q + 1)).hom, Category.assoc, ← C1,
        ← Category.assoc, ← Cδ, Category.assoc, hS'.δ_comp, Limits.comp_zero, Limits.zero_comp]
    refine ⟨h1, h2, ?_, ?_⟩
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₂ q) (α₃ q) (α₁ (q + 1)) (C2 q) Cδ).symm
        (hS'.homology_exact₃ q (q + 1) hrel)
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₃ q) (α₁ (q + 1)) (α₂ (q + 1)) Cδ (C1 (q + 1))).symm
        (hS'.homology_exact₁ q (q + 1) hrel)

  choose σ t H1 H2 H3 using fun (S : ShortComplex C) (hS : S.ShortExact) =>
    s1 S hS (injectiveResolution S.X₁) (injectiveResolution S.X₃)
  choose I₂ i p r s Hi Hp Hspl Hd using fun (S : ShortComplex C) (hS : S.ShortExact) =>
    L2 S hS _ _ (σ S hS) (t S hS) (H1 S hS) (H2 S hS) (H3 S hS)
  choose hz hS' using fun (S : ShortComplex C) (hS : S.ShortExact) =>
    L3 _ _ _ (i S hS) (p S hS) (r S hS) (s S hS) (Hspl S hS)
  refine ⟨fun S hS => ((injectiveResolution S.X₃).isoRightDerivedObj R q).hom ≫
    (hS' S hS).δ q (q + 1) hrel ≫ ((injectiveResolution S.X₁).isoRightDerivedObj R (q + 1)).inv,
    ?_, ?_⟩
  · intro S hS
    exact L4 S _ (I₂ S hS) _ (i S hS) (p S hS) (Hi S hS) (Hp S hS) (hz S hS) (hS' S hS)
  · intro S₁ S₂ h₁ h₂ φ
    have ha := InjectiveResolution.desc_commutes φ.τ₁ (injectiveResolution S₂.X₁)
      (injectiveResolution S₁.X₁)
    have hc := InjectiveResolution.desc_commutes φ.τ₃ (injectiveResolution S₂.X₃)
      (injectiveResolution S₁.X₃)
    obtain ⟨h, hh⟩ := L5 S₁ S₂ h₁ φ _ _ _ _ (σ S₁ h₁) (t S₁ h₁) (σ S₂ h₂) (t S₂ h₂) _ _
      (H1 S₁ h₁) (H2 S₁ h₁) (H3 S₁ h₁) (H1 S₂ h₂) (H2 S₂ h₂) (H3 S₂ h₂) ha hc
    obtain ⟨b, hb1, hb2⟩ := L6 _ _ _ _ _ _ (i S₁ h₁) (p S₁ h₁) (r S₁ h₁) (s S₁ h₁) (t S₁ h₁)
      (i S₂ h₂) (p S₂ h₂) (r S₂ h₂) (s S₂ h₂) (t S₂ h₂) _ _ h (Hspl S₁ h₁) (Hspl S₂ h₂)
      (Hd S₁ h₁) (Hd S₂ h₂) hh
    exact L7 S₁ S₂ φ _ (I₂ S₁ h₁) _ _ (I₂ S₂ h₂) _ (i S₁ h₁) (p S₁ h₁) (i S₂ h₂) (p S₂ h₂) _ b _
      ha hc hb1 hb2 (hz S₁ h₁) (hS' S₁ h₁) (hz S₂ h₂) (hS' S₂ h₂) hrel

theorem rightDerived_preserves_seq_colimit_of_acyclic : ∀ {C D : Type*} [Category C] [Category D]
    [Abelian C] [Abelian D] [HasInjectiveResolutions C] [EnoughInjectives C]
    [Limits.HasColimitsOfShape ℕ C] [HasExactColimitsOfShape ℕ C]
    [Limits.HasColimitsOfShape ℕ D] [HasExactColimitsOfShape ℕ D]
    (R : C ⥤ D) [R.Additive] [Limits.PreservesFiniteLimits R],
    (∀ (G : ℕ ⥤ C) (c : Limits.Cocone G), Limits.IsColimit c →
      Nonempty (Limits.IsColimit (R.mapCocone c))) →
    (∀ (I : ℕ ⥤ C), (∀ n, Injective (I.obj n)) → ∀ (c : Limits.Cocone I), Limits.IsColimit c →
      ∀ k : ℕ, Limits.IsZero ((R.rightDerived (k + 1)).obj c.pt)) →
    (∀ q : ℕ, ∃ δ : ∀ (S : ShortComplex C), S.ShortExact →
        ((R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁),
      (∀ (S : ShortComplex C) (hS : S.ShortExact),
        ∃ (h1 : (R.rightDerived q).map S.g ≫ δ S hS = 0)
          (h2 : δ S hS ≫ (R.rightDerived (q + 1)).map S.f = 0),
          (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact) ∧
      (∀ (S₁ S₂ : ShortComplex C) (h₁ : S₁.ShortExact) (h₂ : S₂.ShortExact) (φ : S₁ ⟶ S₂),
        δ S₁ h₁ ≫ (R.rightDerived (q + 1)).map φ.τ₁ = (R.rightDerived q).map φ.τ₃ ≫ δ S₂ h₂)) →
    ∀ (q : ℕ) (G : ℕ ⥤ C) (c : Limits.Cocone G), Limits.IsColimit c →
      Nonempty (Limits.IsColimit ((R.rightDerived q).mapCocone c)) :=
by
  intro C D _ _ _ _ _ _ _ _ _ _ R _ _ hR0 hacyc hδ q

  have key : ∀ {A B E : ℕ ⥤ D} (u : ∀ n, A.obj n ⟶ B.obj n) (v : ∀ n, B.obj n ⟶ E.obj n),
      (∀ (n m : ℕ) (f : n ⟶ m), B.map f ≫ v m = v n ≫ E.map f) →
      (∀ n, u n ≫ v n = 0) → (∀ n, Epi (v n)) →
      ∀ (cA : Limits.Cocone A), Limits.IsColimit cA →
      ∀ (cB : Limits.Cocone B), Limits.IsColimit cB →
      ∀ (cE : Limits.Cocone E) (u' : cA.pt ⟶ cB.pt) (v' : cB.pt ⟶ cE.pt),
      (∀ n, cA.ι.app n ≫ u' = u n ≫ cB.ι.app n) →
      (∀ n, cB.ι.app n ≫ v' = v n ≫ cE.ι.app n) →
      ∀ (hw : u' ≫ v' = 0), (ShortComplex.mk u' v' hw).Exact → Epi v' →
      Nonempty (Limits.IsColimit cE) := by
    intro A B E u v hvnat huv hvepi cA hA cB hB cE u' v' hu' hv' hw hex hepi
    have : Epi (ShortComplex.mk u' v' hw).g := hepi
    have hc := hex.gIsCokernel
    let sB : Limits.Cocone E → Limits.Cocone B := fun s =>
      { pt := s.pt
        ι := { app := fun n => v n ≫ s.ι.app n
               naturality := fun n m f => by
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
                 rw [← Category.assoc, hvnat n m f, Category.assoc, s.w f] } }
    have hh : ∀ s : Limits.Cocone E, u' ≫ hB.desc (sB s) = 0 := by
      intro s
      apply hA.hom_ext
      intro n
      rw [reassoc_of% (hu' n), hB.fac, Limits.comp_zero]
      show u n ≫ v n ≫ s.ι.app n = 0
      rw [reassoc_of% (huv n), Limits.zero_comp]
    let d : ∀ s : Limits.Cocone E, cE.pt ⟶ s.pt := fun s =>
      (Limits.CokernelCofork.IsColimit.desc' hc (hB.desc (sB s)) (hh s)).1
    have hd : ∀ s, v' ≫ d s = hB.desc (sB s) := fun s =>
      (Limits.CokernelCofork.IsColimit.desc' hc (hB.desc (sB s)) (hh s)).2
    refine ⟨{ desc := d, fac := ?_, uniq := ?_ }⟩
    · intro s n
      show cE.ι.app n ≫ d s = s.ι.app n
      rw [← cancel_epi (v n), ← Category.assoc, ← hv' n, Category.assoc, hd]
      exact hB.fac (sB s) n
    · intro s m hm
      show m = d s
      rw [← cancel_epi v', hd]
      apply hB.uniq (sB s)
      intro n
      rw [reassoc_of% (hv' n), hm]
  induction q with
  | zero =>
    intro G c hc
    obtain ⟨h⟩ := hR0 G c hc
    exact ⟨Limits.IsColimit.mapCoconeEquiv (Functor.rightDerivedZeroIsoSelf R).symm h⟩
  | succ q ih =>
    intro G c hc
    obtain ⟨δ, hex, hnat⟩ := hδ q
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    let S : ShortComplex (ℕ ⥤ C) :=
      ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel α) hα inferInstance
    have hSc : (S.map Limits.colim).ShortExact := hS.map_of_exact Limits.colim
    have hSn : ∀ n, (S.map ((evaluation ℕ C).obj n)).ShortExact := fun n => hS.map_of_exact _
    have hvepi : ∀ n, Epi (δ _ (hSn n)) := by
      intro n
      obtain ⟨-, h2, -, ex2⟩ := hex _ (hSn n)
      have := hI n
      exact ex2.epi_f
        ((Functor.isZero_rightDerived_obj_injective_succ R q (I.obj n)).eq_of_tgt _ _)
    obtain ⟨h1c, h2c, ex1c, ex2c⟩ := hex _ hSc
    have hepic : Epi (δ _ hSc) :=
      ex2c.epi_f ((hacyc I hI (Limits.colimit.cocone I) (Limits.colimit.isColimit I) q).eq_of_tgt
        _ _)
    obtain ⟨hA⟩ := ih I (Limits.colimit.cocone I) (Limits.colimit.isColimit I)
    obtain ⟨hB⟩ := ih (Limits.cokernel α) (Limits.colimit.cocone _) (Limits.colimit.isColimit _)
    have hcan : Nonempty (Limits.IsColimit
        ((R.rightDerived (q + 1)).mapCocone (Limits.colimit.cocone G))) := by
      refine key (A := I ⋙ R.rightDerived q) (B := Limits.cokernel α ⋙ R.rightDerived q)
        (E := G ⋙ R.rightDerived (q + 1))
        (fun n => (R.rightDerived q).map ((Limits.cokernel.π α).app n))
        (fun n => δ _ (hSn n))
        ?_ ?_ hvepi _ hA _ hB _ ((R.rightDerived q).map (Limits.colim.map (Limits.cokernel.π α)))
        (δ _ hSc) ?_ ?_ h1c ex1c hepic
      · intro n m f
        exact (hnat _ _ (hSn n) (hSn m)
          (ShortComplex.homMk (G.map f) (I.map f) ((Limits.cokernel α).map f)
            (α.naturality f) ((Limits.cokernel.π α).naturality f))).symm
      · intro n
        obtain ⟨h1, -⟩ := hex _ (hSn n)
        exact h1
      · intro n
        simp only [Functor.mapCocone_ι_app, Limits.colimit.cocone_ι]
        rw [← Functor.map_comp, ← Functor.map_comp, Limits.colimit.ι_map]
      · intro n
        exact (hnat _ _ (hSn n) hSc
          (ShortComplex.homMk (Limits.colimit.ι G n) (Limits.colimit.ι I n)
            (Limits.colimit.ι (Limits.cokernel α) n)
            (Limits.colimit.ι_map α n) (Limits.colimit.ι_map _ n))).symm
    obtain ⟨h⟩ := hcan
    exact ⟨Limits.IsColimit.ofIsoColimit h
      ((Limits.Cocone.functoriality G (R.rightDerived (q + 1))).mapIso
        (Limits.IsColimit.uniqueUpToIso (Limits.colimit.isColimit G) hc))⟩

theorem wc_pencil_Rq_ladic_lift_qcqs (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (U : (wcP1Over F'').left.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
      (q p : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left U) (wcRq D.f ℓ q) p),
      ∃ (g : ((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ]) ⟶ wcRq D.f ℓ q)
        (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left U)
          (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left ℤ_[ℓ])) p),
        x = y.comp (Abelian.Ext.mk₀ g) (add_zero p) :=
by
  intro U _ _ q p x
  classical

  haveI hexY : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology _) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  haveI hexB : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology _) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))

  have ht : WeaklyEtale (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨L, adj, -, -⟩ := wc_proet_push_free_adjunction F'' (wcP1Over F'') D.Yt
    (Over.homMk D.f D.hf) hP ht
  haveI hRlim : Limits.PreservesLimitsOfSize.{0, 0} (wcProEtPush D.f) :=
    adj.rightAdjoint_preservesLimits
  haveI hRfin : Limits.PreservesFiniteLimits (wcProEtPush D.f) := inferInstance

  haveI : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  obtain ⟨κ, ⟨hκ⟩, -⟩ := wc_ladic_tower_colimit D.Yt.left ℓ

  have hR0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      Nonempty (Limits.IsColimit ((wcProEtPush D.f).mapCocone c)) :=
    fun G c hc => wc_proet_push_preserves_seq_colimit D.f G c hc

  have hacyc : ∀ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}),
      (∀ n, Injective (I.obj n)) → ∀ (c : Limits.Cocone I), Limits.IsColimit c →
      ∀ k : ℕ, Limits.IsZero (((wcProEtPush D.f).rightDerived (k + 1)).obj c.pt) :=
    fun I hI c hc k => wc_proet_push_rightDerived_vanish_of_qcqs_acyclic D.f c.pt
      (fun W _ _ j e => proet_ext_colimit_injectives_vanish D.Yt.left W I hI c hc j e) k

  obtain ⟨hRq⟩ := rightDerived_preserves_seq_colimit_of_acyclic (wcProEtPush D.f) hR0 hacyc
    (fun q' => rightDerived_delta_natural (wcProEtPush D.f) q') q _ _ hκ

  have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : wcFreeSheaf (wcP1Over F'').left U ⟶ c.pt, ∃ (n : ℕ)
        (g' : wcFreeSheaf (wcP1Over F'').left U ⟶ G.obj n), g = g' ≫ c.ι.app n :=
    fun G c hc => (proet_free_hom_seq_colimit _ U G c hc).1
  have H1 : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
        (α : G ⟶ I), Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left U) c.pt (k + 1)),
            x = 0 := by
    intro G
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    exact ⟨I, α, hα, fun c hc k x => proet_ext_colimit_injectives_vanish _ U I hI c hc k x⟩
  obtain ⟨m, y, hxy⟩ := ext_seq_colimit_lift_of_acyclic (wcFreeSheaf (wcP1Over F'').left U)
    H0 H1 p _ _ hRq x

  exact ⟨((wcProEtPush D.f).rightDerived q).map (κ.app m), y, hxy⟩

theorem wc_punct_geom_isAffine (F'' : Type u) [Field F''] (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _) (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) : IsAffine (wcPunctGeom F'' u0 hP).left :=
by
  classical
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F''))

  have scale : ∀ {S : Type u} [CommRing S] (φ : F'' →+* S) (x : Fin (1 + 1) → S) (t : S) (n : ℕ)
      (F : MvPolynomial (Fin (1 + 1)) F''), F.IsHomogeneous n →
      MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
    intro S _ φ x t n F hF
    conv_lhs => rw [F.as_sum]
    conv_rhs => rw [F.as_sum]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : Finsupp.degree d = n := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
    have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
      simp only [mul_pow]
      rw [Finsupp.prod_mul]
      congr 1
      rw [← hdeg, Finsupp.degree_apply]
      unfold Finsupp.prod
      rw [Finset.prod_pow_eq_pow_sum]
    rw [hp]
    ring

  obtain ⟨pt, -⟩ : ∃ pt : Spec (.of F''), True := ⟨IsLocalRing.closedPoint F'', trivial⟩
  obtain ⟨x0, hx0⟩ : ∃ x0, x0 = u0 (IsLocalRing.closedPoint F'') := ⟨_, rfl⟩
  have hpt : u0 pt = x0 := by
    rw [hx0]
    exact congrArg u0 (Subsingleton.elim _ _)
  have hcover : (⨆ a : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X a)) = ⊤ := by
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff
        (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hx0mem : x0 ∈ (⨆ a : Fin (1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X a)) := by
    rw [hcover]; trivial
  obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx0mem
  have hX : (MvPolynomial.X j : MvPolynomial (Fin (1 + 1)) F'') ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X F'' j)
  have hrange : Set.range u0 ⊆ Set.range (Proj.awayι
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X j) hX one_pos) := by
    rintro _ ⟨p, rfl⟩
    have hp : p = pt := Subsingleton.elim _ _
    subst hp
    rw [hpt]
    have hmem : x0 ∈ (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
        (MvPolynomial.X j) hX one_pos).opensRange := by
      rw [Proj.opensRange_awayι]; exact hj
    obtain ⟨z, hz⟩ := Scheme.Hom.mem_opensRange.mp hmem
    exact ⟨z, hz⟩
  obtain ⟨g, hg⟩ : ∃ g, g = IsOpenImmersion.lift (Proj.awayι
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X j) hX one_pos)
      u0 hrange := ⟨_, rfl⟩
  have hgfac : g ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
      (MvPolynomial.X j) hX one_pos = u0 := by
    rw [hg]; exact IsOpenImmersion.lift_fac _ _ _
  obtain ⟨φ, hφ⟩ : ∃ φ, φ = (Spec.preimage g).hom := ⟨_, rfl⟩
  have hgφ : Spec.map (CommRingCat.ofHom φ) = g := by
    rw [hφ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hfac : Spec.map (CommRingCat.ofHom φ) ≫ Proj.awayι
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X j) hX one_pos = u0 := by
    rw [hgφ, hgfac]
  have hconst : ∀ c : F'', φ (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (Submonoid.powers (MvPolynomial.X j))
      (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0) c)) = c := by
    have h0 : (Spec.map (CommRingCat.ofHom φ) ≫ Proj.awayι
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (MvPolynomial.X j) hX one_pos) ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') ≫
          Spec.map (CommRingCat.ofHom (algebraMap F''
            ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)))) = 𝟙 _ := by
      rw [hfac]; exact hu0
    rw [Category.assoc, ← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero,
      ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_id] at h0
    have h1 := Spec.map_injective h0
    intro c
    have h2 := ConcreteCategory.congr_hom h1 c
    simpa using h2

  have hg' : (MvPolynomial.X (j.succAbove 0) : MvPolynomial (Fin (1 + 1)) F'') ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' (1 • 1) :=
    (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X F'' _)
  obtain ⟨t, ht⟩ : ∃ t, t = HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') hX 1
      (MvPolynomial.X (j.succAbove 0)) hg' := ⟨_, rfl⟩
  obtain ⟨a, ha⟩ : ∃ a, a = φ t := ⟨_, rfl⟩
  obtain ⟨h, hh_def⟩ : ∃ h : MvPolynomial (Fin (1 + 1)) F'',
      h = MvPolynomial.X (j.succAbove 0) - MvPolynomial.C a * MvPolynomial.X j := ⟨_, rfl⟩
  have hhom : h.IsHomogeneous 1 := by
    rw [hh_def]
    exact (MvPolynomial.isHomogeneous_X F'' _).sub ((MvPolynomial.isHomogeneous_X F'' j).C_mul a)
  have hh : h ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 hhom
  have hC : (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (Submonoid.powers (MvPolynomial.X j))
      (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0) a)).val =
      Localization.mk (MvPolynomial.C a) 1 := by
    have h1 : ((algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0) a :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)) :
        MvPolynomial (Fin (1 + 1)) F'') = MvPolynomial.C a := by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    rw [← h1]
    rfl
  have he : HomogeneousLocalization.Away.isLocalizationElem hX hh = t -
      HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (Submonoid.powers (MvPolynomial.X j))
        (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0) a) := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.isLocalizationElem.eq_1, HomogeneousLocalization.val_sub, ht,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hC,
      Localization.sub_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, mul_one, pow_one]
    rw [hh_def]
