theorem wc_proet_P1_finite_supp_ext_vanish (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (K : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (hK : ∀ (V : (wcP1Over F'').left.ProEt),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint F'')) →
      ∀ s : K.obj.obj (Opposite.op V), s = 0)
    (j : ℕ) (hj : 1 ≤ j) :
    ∀ x : wcCohG F'' (wcP1Over F'') hP K j, x = 0 :=
by
  classical

  have hvan : ∀ (V : (wcP1Over F'').left.ProEt),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint F'')) →
      ∀ (n : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) K n), x = 0 := by
    intro V hV
    apply wc_proet_ext_free_vanish_of_sections_zero (wcP1Over F'').left V K
    intro W b s
    apply hK W _ s
    intro w i hw
    apply hV (b.left w) i
    rw [← hw, ← MorphismProperty.Over.w b, Scheme.Hom.comp_apply]

  have hT'O : ∀ (O : (wcP1Over F'').left.Opens) (T : (wcP1Over F'').left.ProEt)
      (t' : (wcOpenRestr (wcP1Over F'').left O T).left),
      (wcOpenRestr (wcP1Over F'').left O T).hom t' ∈ (O : Set (wcP1Over F'').left) := by
    intro O T t'
    have key : ∀ p : ↥(Limits.pullback O.ι T.hom),
        (Limits.pullback.snd O.ι T.hom ≫ T.hom) p ∈ (O : Set (wcP1Over F'').left) := by
      intro p
      rw [← Limits.pullback.condition, Scheme.Hom.comp_apply, ← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    exact key t'

  have hnotO : ∀ u0 : Spec (.of F'') ⟶ (wcP1Over F'').left,
      u0 (IsLocalRing.closedPoint F'') ∉ (wcPunctOpen F'' u0 : Set (wcP1Over F'').left) := by
    intro u0 h
    have h' : u0 (IsLocalRing.closedPoint F'') ∈
        (closure {u0 (IsLocalRing.closedPoint F'')})ᶜ := h
    exact h' (subset_closure (Set.mem_singleton _))

  let H : (wcP1Over F'').left.ProEt → Finset (Fin m) := fun T =>
    Finset.univ.filter (fun i => ∃ t : T.left, T.hom t = S i (IsLocalRing.closedPoint F''))
  have hmemH : ∀ (T : (wcP1Over F'').left.ProEt) (i : Fin m),
      i ∈ H T ↔ ∃ t : T.left, T.hom t = S i (IsLocalRing.closedPoint F'') := by
    intro T i
    simp only [H, Finset.mem_filter, Finset.mem_univ, true_and]

  have hcardlt : ∀ (T : (wcP1Over F'').left.ProEt) (i0 : Fin m) (t0 : T.left),
      T.hom t0 = S i0 (IsLocalRing.closedPoint F'') →
      (H (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T)).card < (H T).card := by
    intro T i0 t0 ht0
    have hsub : H (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T) ⊆ H T := by
      intro i hi
      rw [hmemH] at hi ⊢
      obtain ⟨t', ht'⟩ := hi
      refine ⟨(wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T).left t', ?_⟩
      rw [← ht', ← MorphismProperty.Over.w
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T), Scheme.Hom.comp_apply]
    have hi0 : i0 ∈ H T := (hmemH T i0).mpr ⟨t0, ht0⟩
    have hi0' : i0 ∉ H (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T) := by
      intro hi
      rw [hmemH] at hi
      obtain ⟨t', ht'⟩ := hi
      have h1 := hT'O (wcPunctOpen F'' (S i0)) T t'
      rw [ht'] at h1
      exact hnotO (S i0) h1
    exact Finset.card_lt_card ((Finset.ssubset_iff_of_subset hsub).mpr ⟨i0, hi0, hi0'⟩)

  have hoi : ∀ (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      IsOpenImmersion g.left → ∀ O : (wcP1Over F'').left.Opens,
      IsOpenImmersion (wcOpenRestrIncl (wcP1Over F'').left O T ≫ g).left := by
    intro T g hg O
    have e : (wcOpenRestrIncl (wcP1Over F'').left O T ≫ g).left =
        Limits.pullback.snd O.ι T.hom ≫ g.left := rfl
    rw [e]
    haveI := hg
    haveI hsnd : IsOpenImmersion (Limits.pullback.snd O.ι T.hom) := by
      first
        | infer_instance
        | exact MorphismProperty.pullback_snd (P := @IsOpenImmersion) _ _ inferInstance
        | exact IsOpenImmersion.pullback_snd_of_left _ _
    exact @IsOpenImmersion.comp _ _ _ _ _ hsnd hg

  have hstep : ∀ (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      IsOpenImmersion g.left → ∀ (i0 : Fin m) (t0 : T.left),
      T.hom t0 = S i0 (IsLocalRing.closedPoint F'') →
      (∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
        (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T)) K j, y = 0) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left T) K j, y = 0 := by
    intro T g hg i0 t0 ht0 IH'
    have hcok : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T))) K j, y = 0 := by
      intro y
      obtain ⟨κ, hκ, -⟩ := wc_P1bar_open_punct_excision F'' (S i0) (hS i0) hP T g hg ⟨t0, ht0⟩
      haveI := hκ
      have h0 := wc_P1_punct_coker_ext_vanish F'' hP m S hS K hvan i0 j hj
        ((Abelian.Ext.mk₀ (inv κ)).comp y (zero_add j))
      calc y = (Abelian.Ext.mk₀ (𝟙 _)).comp y (zero_add j) := (Abelian.Ext.mk₀_id_comp y).symm
        _ = (Abelian.Ext.mk₀ (κ ≫ inv κ)).comp y (zero_add j) := by rw [IsIso.hom_inv_id]
        _ = (Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mk₀ (inv κ)).comp y (zero_add j))
              (zero_add j) := (Abelian.Ext.mk₀_comp_mk₀_assoc _ _ _).symm
        _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
    have hmonoL : Mono (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T).left := by
      change Mono (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι T.hom)
      exact IsOpenImmersion.mono _
    have hmono := wc_free_sheaf_map_mono (wcP1Over F'').left _ _
      (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T) hmonoL
    have hSE := ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (wcFreeSheafMap
      (wcP1Over F'').left (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T)))
      hmono inferInstance
    intro x
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₂ hSE K x
      (IH' ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T))).comp x (zero_add j)))
    rw [← hx₁, hcok x₁, Abelian.Ext.comp_zero]

  have claim : ∀ N : ℕ, ∀ (T : (wcP1Over F'').left.ProEt)
      (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP), IsOpenImmersion g.left → (H T).card ≤ N →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left T) K j, y = 0 := by
    intro N
    induction N with
    | zero =>
      intro T g _ hcard
      apply hvan T _ j
      intro t i hti
      have hmem : i ∈ H T := (hmemH T i).mpr ⟨t, hti⟩
      have := Finset.card_pos.mpr ⟨i, hmem⟩
      omega
    | succ N ih =>
      intro T g hg hcard
      by_cases hav : ∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint F'')
      · exact hvan T hav j
      push_neg at hav
      obtain ⟨t0, i0, ht0⟩ := hav
      apply hstep T g hg i0 t0 ht0
      apply ih _ (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) T ≫ g)
        (hoi T g hg _)
      have := hcardlt T i0 t0 ht0
      omega

  intro x
  exact claim m (wcGeomPoint F'' (wcP1Over F'') hP) (𝟙 _)
    (by
      show IsOpenImmersion (𝟙 (wcGeomPoint F'' (wcP1Over F'') hP).left)
      infer_instance)
    ((Finset.card_le_univ _).trans (Fintype.card_fin m).le) x

theorem wc_contSheaf_pi_padic_coker_reduce (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k r : ℕ) :
    ∃ e : Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (wcContSheaf S (Fin k → ℤ_[ℓ]))) ≅
        wcContSheaf S (Fin k → ZMod (ℓ ^ r)),
      ∀ (U : S.ProEt) (x : (wcContSheaf S (Fin k → ℤ_[ℓ])).obj.obj (Opposite.op U)) (z : U.left)
        (i : Fin k),
        (show C(↥U.left, Fin k → ZMod (ℓ ^ r)) from
          ((e.hom.hom.app (Opposite.op U)).hom
            (((Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (wcContSheaf S (Fin k → ℤ_[ℓ])))).hom.app
              (Opposite.op U)).hom x)).down) z i =
        PadicInt.toZModPow r ((show C(↥U.left, Fin k → ℤ_[ℓ]) from x.down) z i) :=
by
  classical
  haveI : NeZero (ℓ ^ r) := ⟨pow_ne_zero r (Fact.out : ℓ.Prime).ne_zero⟩
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos

  have hρc : Continuous (PadicInt.toZModPow (p := ℓ) r) := by
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro y hy
    refine ⟨(ℓ : ℝ) ^ (-(r : ℤ)), zpow_pos hℓpos _, ?_⟩
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ r} :=
      (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
    rw [h1, hy]

  let redk : (Fin k → ℤ_[ℓ]) →+ (Fin k → ZMod (ℓ ^ r)) :=
    AddMonoidHom.compLeft (PadicInt.toZModPow (p := ℓ) r).toAddMonoidHom (Fin k)
  have hcont : Continuous redk := continuous_pi (fun i => hρc.comp (continuous_apply i))
  let red : wcContSheaf S (Fin k → ℤ_[ℓ]) ⟶ wcContSheaf S (Fin k → ZMod (ℓ ^ r)) :=
    wcContSheafMap S redk hcont

  have hdiv : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, Fin k → ℤ_[ℓ])),
      (∀ t i, PadicInt.toZModPow r (g t i) = 0) →
      ∃ c : C(T, Fin k → ℤ_[ℓ]), ∀ t i, g t i = (ℓ : ℤ_[ℓ]) ^ r * c t i := by
    intro T _ g hg
    have hl : ((ℓ : ℚ_[ℓ]) ^ r) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    have hb : ∀ t i, ‖((g t i : ℚ_[ℓ])) / (ℓ : ℚ_[ℓ]) ^ r‖ ≤ 1 := by
      intro t i
      have h1 : g t i ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ r} := by
        rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]; exact hg t i
      have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mpr h1
      rw [PadicInt.norm_def] at h2
      rw [norm_div, Padic.norm_p_pow]
      exact (div_le_one (zpow_pos hℓpos _)).mpr h2
    refine ⟨⟨fun t i => (⟨(g t i : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ r, hb t i⟩ : ℤ_[ℓ]),
      continuous_pi (fun i => Continuous.subtype_mk
        ((continuous_subtype_val.comp ((continuous_apply i).comp g.continuous)).div_const _)
        (fun t => hb t i))⟩, ?_⟩
    intro t i
    apply PadicInt.ext
    rw [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
    change (g t i : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ r * ((g t i : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ r)
    field_simp

  have hns : ∀ {Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (m : ℕ)
      (U : S.ProEtᵒᵖ) (x : Z.obj.obj U), (m • 𝟙 Z).hom.app U x = m • x := by
    intro Z m U x
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul, Sheaf.Hom.add_app]
      rw [← ih]
      rfl

  have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
      (g : G ⟶ H),
      (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
      (∀ U, Function.Surjective (g.hom.app U)) →
      (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
      ∃ e : Limits.cokernel f ≅ H, Limits.cokernel.π f ≫ e.hom = g := by
    intro F G H f g h1 h2 h3
    have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
        (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
      intro X Y U y
      rfl
    have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
        (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
        (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
      intro X Y Z p q U y
      rfl
    have w : f ≫ g = 0 := by
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp, hzero, h1]
    haveI : Epi g := by
      haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
      haveI : Epi g.hom := NatTrans.epi_of_epi_app _
      exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
    have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
        f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
      intro A k hk
      have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
        intro U y
        have := congrArg (fun φ => φ.hom.app U y) hk
        simp only at this
        rw [hcomp, hzero] at this
        exact this
      have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
          k.hom.app U x = k.hom.app U x' := by
        intro U x x' hxx
        obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
        have := hk' U y
        rw [hy, map_sub, sub_eq_zero] at this
        exact this
      let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
      have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
      let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
          intro φ ψ
          rw [← map_add]
          apply hd
          rw [map_add, hσ, hσ, hσ]))
      have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
      let l : H ⟶ A := ObjectProperty.homMk
        { app := lU
          naturality := by
            intro U V r
            ext φ
            rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
              ← NatTrans.naturality_apply]
            apply hd
            rw [hσ, NatTrans.naturality_apply, hσ] }
      refine ⟨l, ?_⟩
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp]
      change lU U (g.hom.app U x) = k.hom.app U x
      rw [hlU]
      apply hd
      rw [hσ]
    refine ⟨Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel f)
      (Limits.CokernelCofork.IsColimit.ofπ' g w fac), ?_⟩
    exact Limits.IsColimit.comp_coconePointUniqueUpToIso_hom (Limits.cokernelIsCokernel f)
      (Limits.CokernelCofork.IsColimit.ofπ' g w fac) Limits.WalkingParallelPair.one

  have H1 : ∀ U (x : (wcContSheaf S (Fin k → ℤ_[ℓ])).obj.obj U),
      red.hom.app U (((ℓ ^ r : ℕ) • 𝟙 (wcContSheaf S (Fin k → ℤ_[ℓ]))).hom.app U x) = 0 := by
    intro U x
    rw [hns]
    let f0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
      Fin k → ℤ_[ℓ]) := x.down
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    funext i
    change PadicInt.toZModPow r ((ℓ ^ r : ℕ) • f0 t i) = 0
    rw [nsmul_eq_mul, map_mul, map_natCast, ZMod.natCast_self, zero_mul]
  have H2 : ∀ U, Function.Surjective (red.hom.app U) := by
    intro U φ
    let φ0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
      Fin k → ZMod (ℓ ^ r)) := φ.down
    let ψ0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
        Fin k → ℤ_[ℓ]) :=
      ⟨fun t i => (((φ0 t i).val : ℕ) : ℤ_[ℓ]),
        (continuous_of_discreteTopology
          (f := fun b : Fin k → ZMod (ℓ ^ r) => fun i => (((b i).val : ℕ) : ℤ_[ℓ]))).comp
          φ0.continuous⟩
    refine ⟨ULift.up ψ0, ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    funext i
    change PadicInt.toZModPow r (((φ0 t i).val : ℕ) : ℤ_[ℓ]) = φ0 t i
    rw [map_natCast, ZMod.natCast_zmod_val]
  have H3 : ∀ U (x : (wcContSheaf S (Fin k → ℤ_[ℓ])).obj.obj U), red.hom.app U x = 0 →
      ∃ y, ((ℓ ^ r : ℕ) • 𝟙 (wcContSheaf S (Fin k → ℤ_[ℓ]))).hom.app U y = x := by
    intro U x hx
    let f0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
      Fin k → ℤ_[ℓ]) := x.down
    have hx' : ∀ t i, PadicInt.toZModPow r (f0 t i) = 0 := by
      intro t i
      have := congrArg (fun z => (ULift.down z :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)),
          Fin k → ZMod (ℓ ^ r))) t i) hx
      exact this
    obtain ⟨c, hc⟩ := hdiv _ f0 hx'
    refine ⟨(ULift.up c : (wcContSheaf S (Fin k → ℤ_[ℓ])).obj.obj U), ?_⟩
    refine (hns (Z := wcContSheaf S (Fin k → ℤ_[ℓ])) (ℓ ^ r) U _).trans ?_
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    funext i
    change (ℓ ^ r : ℕ) • c t i = f0 t i
    rw [hc t i, nsmul_eq_mul, Nat.cast_pow]
  obtain ⟨e, he⟩ := crit ((ℓ ^ r : ℕ) • 𝟙 (wcContSheaf S (Fin k → ℤ_[ℓ]))) red H1 H2 H3

  refine ⟨e, ?_⟩
  intro U x z i
  have h := congrArg (fun φ => (show C(↥U.left, Fin k → ZMod (ℓ ^ r)) from
    ((φ.hom.app (Opposite.op U)).hom x).down) z i) he
  exact h

theorem wc_over_coker_nsmul_transport (S : Scheme.{u}) (W : S.ProEt)
    (X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (n : ℕ)
    (ψ : X.over W ≅ Y.over W) (e : Limits.cokernel (n • 𝟙 Y) ≅ Z) :
    ∃ θr : (Limits.cokernel (n • 𝟙 X)).over W ≅ Z.over W,
      ∀ (V : S.ProEt) (b : V ⟶ W) (t : X.obj.obj (Opposite.op V)),
        (θr.hom.hom.app (Opposite.op (Over.mk b))).hom
            (((Limits.cokernel.π (n • 𝟙 X)).hom.app (Opposite.op V)).hom t) =
          (e.hom.hom.app (Opposite.op V)).hom
            (((Limits.cokernel.π (n • 𝟙 Y)).hom.app (Opposite.op V)).hom
              ((ψ.hom.hom.app (Opposite.op (Over.mk b))).hom t)) :=
by
  let R := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W
  haveI := ((Over.forget W).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over W) (Scheme.ProEt.topology S)).isLeftAdjoint
  haveI : R.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : R.Additive := Functor.additive_of_preserves_binary_products _
  let ψ' : R.obj X ≅ R.obj Y := ψ
  have w : R.map (n • 𝟙 X) ≫ ψ'.hom = ψ'.hom ≫ R.map (n • 𝟙 Y) := by
    simp only [Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.nsmul_comp,
      Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
  let θr : R.obj (Limits.cokernel (n • 𝟙 X)) ≅ R.obj Z :=
    Limits.PreservesCokernel.iso R (n • 𝟙 X) ≪≫ Limits.cokernel.mapIso _ _ ψ' ψ' w ≪≫
      (Limits.PreservesCokernel.iso R (n • 𝟙 Y)).symm ≪≫ R.mapIso e
  have key : R.map (Limits.cokernel.π (n • 𝟙 X)) ≫ θr.hom =
      ψ'.hom ≫ R.map (Limits.cokernel.π (n • 𝟙 Y)) ≫ R.map e.hom := by
    simp only [θr, Iso.trans_hom, Iso.symm_hom, Limits.cokernel.mapIso_hom, Functor.mapIso_hom,
      Limits.PreservesCokernel.iso_inv, Limits.PreservesCokernel.π_iso_hom_assoc,
      Limits.cokernel.map, Limits.cokernel.π_desc_assoc, Category.assoc,
      Limits.π_comp_cokernelComparison_assoc]
  refine ⟨θr, fun V b t => ?_⟩
  have := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom t) key
  exact this

theorem wc_frame_deck_of_const (S : Scheme.{u}) (W : S.ProEt)
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (A : Type) [AddCommGroup A]
    [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalAddGroup A]
    (θr : L.over W ≅ (wcContSheaf S A).over W)
    (hpw : ∀ α : (wcContSheaf S A).over W ⟶ (wcContSheaf S A).over W,
      ∃ g' : W.left → (A →+ A), IsLocallyConstant g' ∧
        ∀ (T : Over W) (f : (wcContSheaf S A).obj.obj (Opposite.op T.left)) (t : T.left.left),
          (show C(↥T.left.left, A) from ((α.hom.app (Opposite.op T)).hom f).down) t =
            g' (T.hom.left t) ((show C(↥T.left.left, A) from f.down) t))
    (γ : W ⟶ W) (g : A →+ A)
    (hconst : ∀ a : A, ∃ s : L.obj.obj (Opposite.op W),
      (∀ z : W.left, (show C(↥W.left, A) from
        ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = a) ∧
      ∀ z : W.left, (show C(↥W.left, A) from
        ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z = g a) :
    ∀ (s : L.obj.obj (Opposite.op W)) (z : W.left),
      (show C(↥W.left, A) from ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        g ((show C(↥W.left, A) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) :=
by
  intro s z
  let β : (wcContSheaf S A).over W ⟶ (wcContSheaf S A).over W :=
    ObjectProperty.homMk (θr.inv.hom ≫ (Over.map γ).op.whiskerLeft θr.hom.hom)
  obtain ⟨g', -, hg'⟩ := hpw β
  have hinv : ∀ x : L.obj.obj (Opposite.op W),
      (θr.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) = x := by
    intro x
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) θr.hom_inv_id
    exact h
  have hE3 : ∀ (f : W ⟶ W), 𝟙 W ≫ γ = f → ∀ x : L.obj.obj (Opposite.op W),
      (θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W ≫ γ)))).hom x =
      (θr.hom.hom.app (Opposite.op (Over.mk f))).hom x := by
    intro f hf x
    subst hf
    rfl
  have hE1 : ∀ x : L.obj.obj (Opposite.op W),
      (β.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) =
      (θr.hom.hom.app (Opposite.op (Over.mk γ))).hom x := by
    intro x
    rw [← hE3 γ (Category.id_comp γ) x]
    show (θr.hom.hom.app (Opposite.op ((Over.map γ).obj (Over.mk (𝟙 W))))).hom
      ((θr.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x)) = _
    rw [hinv]
    rfl
  have hE4 : ∀ x : L.obj.obj (Opposite.op W), ∀ z : W.left,
      (show C(↥W.left, A) from ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom x).down) z =
        g' z ((show C(↥W.left, A) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z) := by
    intro x z
    have h := hg' (Over.mk (𝟙 W)) ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) z
    have h' := congrArg (fun y : (wcContSheaf S A).obj.obj (Opposite.op W) =>
      (show C(↥W.left, A) from y.down) z) (hE1 x)
    exact h'.symm.trans h
  have hg : ∀ a : A, g' z a = g a := by
    intro a
    obtain ⟨sa, h1, h2⟩ := hconst a
    exact (congrArg (g' z) (h1 z)).symm.trans ((hE4 sa z).symm.trans (h2 z))
  exact (hE4 s z).trans (hg _)

theorem wc_qclift_level_frame (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (W : (wcP1Over F'').left.ProEt) (hne : Nonempty W.left) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over F'').left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over F'').left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1)
    (r : ℕ) :
    ∃ θr : (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))).over W,
      ∀ (γ : W ⟶ W) (h : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])),
        (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          h ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        (∀ u' : Fin k → ℚ_[ℓ], (∀ i, ‖u' i‖ ≤ 1) → ∀ i, ‖P (h (P.symm u')) i‖ ≤ 1) ∧
        ∃ g : (Fin k → ZMod (ℓ ^ r)) →+ (Fin k → ZMod (ℓ ^ r)),
          (∀ (s : (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))).obj.obj
              (Opposite.op W)) (z : W.left),
            (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
              ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
            g ((show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
              ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) ∧
          ∀ (u' v : Fin k → ℤ_[ℓ]),
            (∀ i, (v i : ℚ_[ℓ]) = P (h (P.symm (fun j => (u' j : ℚ_[ℓ])))) i) →
            g (fun i => PadicInt.toZModPow r (u' i)) = fun i => PadicInt.toZModPow r (v i) :=
by
  haveI hNZ : NeZero (ℓ ^ r) := ⟨pow_ne_zero r (Fact.out : ℓ.Prime).ne_zero⟩

  have invhom : ∀ {X Y : Sheaf ((Scheme.ProEt.topology (wcP1Over F'').left).over W)
      AddCommGrpCat.{u+1}} (e : X ≅ Y) (T : (Over W)ᵒᵖ) (y : Y.obj.obj T),
      (e.hom.hom.app T).hom ((e.inv.hom.app T).hom y) = y := by
    intro X Y e T y
    have h := congrArg (fun φ : Y ⟶ Y => (φ.hom.app T).hom y) e.inv_hom_id
    exact h

  have s7 : ∀ (M : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])),
      (∀ u' : Fin k → ℚ_[ℓ], (∀ i, ‖u' i‖ ≤ 1) → ∀ i, ‖M u' i‖ ≤ 1) →
      ∃ g : (Fin k → ZMod (ℓ ^ r)) →+ (Fin k → ZMod (ℓ ^ r)),
        ∀ (u' v : Fin k → ℤ_[ℓ]), (∀ i, (v i : ℚ_[ℓ]) = M (fun j => (u' j : ℚ_[ℓ])) i) →
          g (fun i => PadicInt.toZModPow r (u' i)) = fun i => PadicInt.toZModPow r (v i) := by
    intro M hM
    let Mz : (Fin k → ℤ_[ℓ]) →+ (Fin k → ℤ_[ℓ]) :=
      AddMonoidHom.mk' (fun u i => (⟨M (fun j => (u j : ℚ_[ℓ])) i,
          hM _ (fun j => PadicInt.norm_le_one (u j)) i⟩ : ℤ_[ℓ])) (by
        intro u w
        funext i
        apply PadicInt.ext
        have e1 : (fun j => (((u + w) j : ℤ_[ℓ]) : ℚ_[ℓ])) =
            (fun j => (u j : ℚ_[ℓ])) + (fun j => (w j : ℚ_[ℓ])) := by
          funext j
          exact PadicInt.coe_add _ _
        have e2 : M (fun j => (((u + w) j : ℤ_[ℓ]) : ℚ_[ℓ])) i =
            M (fun j => (u j : ℚ_[ℓ])) i + M (fun j => (w j : ℚ_[ℓ])) i := by
          rw [e1, map_add, Pi.add_apply]
        exact e2)
    let ρ : (Fin k → ℤ_[ℓ]) →+ (Fin k → ZMod (ℓ ^ r)) :=
      AddMonoidHom.compLeft (PadicInt.toZModPow (p := ℓ) r).toAddMonoidHom (Fin k)
    have kerKey : ∀ u, ρ u = 0 → ρ (Mz u) = 0 := by
      intro u hu
      have hw : ∀ i, ∃ w : ℤ_[ℓ], w * (ℓ : ℤ_[ℓ]) ^ r = u i := by
        intro i
        have h1 : u i ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) r) := by
          rw [RingHom.mem_ker]
          exact congrFun hu i
        rw [PadicInt.ker_toZModPow] at h1
        exact Ideal.mem_span_singleton'.mp h1
      choose w hw using hw
      have hMu : ∀ i, Mz u i = (ℓ : ℤ_[ℓ]) ^ r * Mz w i := by
        intro i
        apply PadicInt.ext
        rw [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
        have e : (fun j => (u j : ℚ_[ℓ])) = ((ℓ : ℚ_[ℓ]) ^ r) • (fun j => (w j : ℚ_[ℓ])) := by
          funext j
          rw [← hw j, PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast, Pi.smul_apply,
            smul_eq_mul, mul_comm]
        have e2 : M (fun j => (u j : ℚ_[ℓ])) i =
            (ℓ : ℚ_[ℓ]) ^ r * M (fun j => (w j : ℚ_[ℓ])) i := by
          rw [e, map_smul, Pi.smul_apply, smul_eq_mul]
        exact e2
      funext i
      show PadicInt.toZModPow r (Mz u i) = 0
      rw [hMu i, map_mul, map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self, zero_mul]
    let lift : (Fin k → ZMod (ℓ ^ r)) → (Fin k → ℤ_[ℓ]) := fun a i => (((a i).val : ℕ) : ℤ_[ℓ])
    have hlift : ∀ a, ρ (lift a) = a := by
      intro a
      funext i
      show PadicInt.toZModPow r (((a i).val : ℕ) : ℤ_[ℓ]) = a i
      rw [map_natCast, ZMod.natCast_zmod_val]
    have keyEq : ∀ u u', ρ u = ρ u' → ρ (Mz u) = ρ (Mz u') := by
      intro u u' huu
      have h0 := kerKey (u - u') (by rw [map_sub, huu, sub_self])
      rw [map_sub, map_sub, sub_eq_zero] at h0
      exact h0
    refine ⟨AddMonoidHom.mk' (fun a => ρ (Mz (lift a))) ?_, ?_⟩
    · intro a b
      show ρ (Mz (lift (a + b))) = ρ (Mz (lift a)) + ρ (Mz (lift b))
      rw [← map_add ρ, ← map_add Mz]
      apply keyEq
      rw [map_add ρ, hlift, hlift, hlift]
    · intro u' v hv
      have hv' : v = Mz u' := by
        funext i
        apply PadicInt.ext
        exact hv i
      show ρ (Mz (lift (ρ u'))) = ρ v
      rw [hv']
      apply keyEq
      rw [hlift]

  obtain ⟨ψ, hψ⟩ := wc_qclift_integral_frame (wcP1Over F'').left ℓ G W k θ P hint J hJ
  obtain ⟨e, he⟩ := wc_contSheaf_pi_padic_coker_reduce (wcP1Over F'').left ℓ k r
  obtain ⟨θr, hθr⟩ := wc_over_coker_nsmul_transport (wcP1Over F'').left W
    (Subobject.underlying.obj J) (wcContSheaf (wcP1Over F'').left (Fin k → ℤ_[ℓ]))
    (wcContSheaf (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))) (ℓ ^ r) ψ e
  have hF : ∀ (V : (wcP1Over F'').left.ProEt) (b : V ⟶ W)
      (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)) (z : V.left) (i : Fin k),
      (show C(↥V.left, Fin k → ZMod (ℓ ^ r)) from
        ((θr.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))).hom.app
            (Opposite.op V)).hom t)).down) z i =
      PadicInt.toZModPow r ((show C(↥V.left, Fin k → ℤ_[ℓ]) from
        ((ψ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z i) := by
    intro V b t z i
    rw [hθr V b t]
    exact he V _ z i
  refine ⟨θr, fun γ h hfr => ?_⟩

  have hI : ∀ u' : Fin k → ℚ_[ℓ], (∀ i, ‖u' i‖ ≤ 1) → ∀ i, ‖P (h (P.symm u')) i‖ ≤ 1 := by
    intro u' hu' i
    obtain ⟨z₀⟩ := hne
    let cX : ((wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op (Over.mk (𝟙 W))) := ULift.up (ContinuousMap.const ↥W.left (P.symm u'))
    let x : G.obj.obj (Opposite.op W) := (θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom cX
    have hx : (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x = cX := invhom θ _ cX
    have h1 := hint W (𝟙 W) γ x z₀ (by
      intro j
      rw [hx]
      show ‖P (P.symm u') j‖ ≤ 1
      rw [LinearEquiv.apply_symm_apply]
      exact hu' j) i
    rw [hfr x z₀, hx] at h1
    exact h1
  let M : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]) :=
    P.toLinearMap ∘ₗ h ∘ₗ P.symm.toLinearMap
  have hMapp : ∀ y, M y = P (h (P.symm y)) := fun y => rfl
  obtain ⟨g, hg⟩ := s7 M (fun u' hu' i => by rw [hMapp]; exact hI u' hu' i)
  have hg' : ∀ (u' v : Fin k → ℤ_[ℓ]),
      (∀ i, (v i : ℚ_[ℓ]) = P (h (P.symm (fun j => (u' j : ℚ_[ℓ])))) i) →
      g (fun i => PadicInt.toZModPow r (u' i)) = fun i => PadicInt.toZModPow r (v i) :=
    fun u' v hv => hg u' v (fun i => by rw [hMapp]; exact hv i)
  refine ⟨hI, g, ?_, hg'⟩

  refine wc_frame_deck_of_const (wcP1Over F'').left W _ (Fin k → ZMod (ℓ ^ r)) θr
    (fun α => wc_contSheaf_over_hom_pointwise (wcP1Over F'').left (Fin k → ZMod (ℓ ^ r))
      (Fin k → ZMod (ℓ ^ r)) W α) γ g ?_
  intro a
  let ã : Fin k → ℤ_[ℓ] := fun i => (((a i).val : ℕ) : ℤ_[ℓ])
  have hã : ∀ i, PadicInt.toZModPow r (ã i) = a i := by
    intro i
    show PadicInt.toZModPow r (((a i).val : ℕ) : ℤ_[ℓ]) = a i
    rw [map_natCast, ZMod.natCast_zmod_val]
  let cA : ((wcContSheaf (wcP1Over F'').left (Fin k → ℤ_[ℓ])).over W).obj.obj
      (Opposite.op (Over.mk (𝟙 W))) := ULift.up (ContinuousMap.const ↥W.left ã)
  let ta : (Subobject.underlying.obj J).obj.obj (Opposite.op W) :=
    (ψ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom cA
  have hψta : (ψ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom ta = cA := invhom ψ _ cA
  refine ⟨((Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))).hom.app
    (Opposite.op W)).hom ta, ?_, ?_⟩
  · intro z
    funext i
    refine (hF W (𝟙 W) ta z i).trans ?_
    rw [hψta]
    exact hã i
  · intro z
    funext i
    have h1 : (show C(↥W.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
          ((J.arrow.hom.app (Opposite.op W)).hom ta)).down) z =
        P.symm (fun j => (ã j : ℚ_[ℓ])) := by
      apply P.injective
      rw [LinearEquiv.apply_symm_apply]
      funext j
      have h2 := hψ W (𝟙 W) ta z j
      rw [hψta] at h2
      exact h2.symm
    let v : Fin k → ℤ_[ℓ] := fun j => (show C(↥W.left, Fin k → ℤ_[ℓ]) from
      ((ψ.hom.hom.app (Opposite.op (Over.mk γ))).hom ta).down) z j
    have hv : ∀ j, (v j : ℚ_[ℓ]) = P (h (P.symm (fun j => (ã j : ℚ_[ℓ])))) j := by
      intro j
      have h2 := hψ W γ ta z j
      rw [hfr, h1] at h2
      exact h2
    have h3 := hg' ã v hv
    have h4 : g a = fun i => PadicInt.toZModPow r (v i) := by
      have ea : a = fun i => PadicInt.toZModPow r (ã i) := funext fun i => (hã i).symm
      rw [ea]
      exact h3
    refine (hF W γ ta z i).trans ?_
    rw [h4]

theorem wc_proet_strict_nbhd_of_fixed_point (S : Scheme.{u}) (U : S.ProEt) (x : U.left)
    (φ : U ⟶ U) (hφx : φ.left x = x) [IsLocallyNoetherian U.left]
    (hsep : IsSepClosed (IsLocalRing.ResidueField (U.left.presheaf.stalk x))) :
    ∃ (Th : S.ProEt) (g : Th ⟶ U) (φh : Th ⟶ Th)
      (B : Type u) (_ : CommRing B) (_ : IsNoetherianRing B) (_ : HenselianLocalRing B)
      (_ : IsSepClosed (IsLocalRing.ResidueField B)) (eB : Th.left ≅ Spec (.of B))
      (VT : S.ProEt) (j : VT ⟶ Th) (φV : VT ⟶ VT),
      φh ≫ g = g ≫ φ ∧
      g.left ⁻¹' {x} = {eB.inv (IsLocalRing.closedPoint B)} ∧
      IsIso (Limits.pullback.snd g.left (U.left.fromSpecResidueField x)) ∧
      IsOpenImmersion j.left ∧
      Set.range j.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ ∧
      φV ≫ j = j ≫ φh ∧
      CompactSpace Th.left :=
by
  classical
  haveI hWEc : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  obtain ⟨H, iH, iHh, iHn, ι, hιloc, hres, hmax, huniv, hwe⟩ :=
    wc_lfi_henselization_weaklyEtale (U.left.presheaf.stalk x)

  have hsurjR : Function.Surjective (IsLocalRing.ResidueField.map ι) := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨b, hb⟩ := hres a
    refine ⟨IsLocalRing.residue _ b, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue, eq_comm, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff]
    exact hb
  have hsepH : IsSepClosed (IsLocalRing.ResidueField H) :=
    wc_henselian_sepClosed_transfer.2 _ _
      (RingEquiv.ofBijective _ ⟨(IsLocalRing.ResidueField.map ι).injective, hsurjR⟩) hsep

  obtain ⟨ι', hι'⟩ : ∃ ι' : U.left.presheaf.stalk x ⟶ CommRingCat.of H, ι'.hom = ι :=
    ⟨CommRingCat.ofHom ι, rfl⟩
  haveI hι'loc : IsLocalHom ι'.hom := by rw [hι']; exact hιloc
  obtain ⟨γ, hγ⟩ : ∃ γ : Spec (CommRingCat.of H) ⟶ U.left,
      γ = Spec.map ι' ≫ U.left.fromSpecStalk x := ⟨_, rfl⟩
  have hSW : WeaklyEtale (Spec.map ι') := by
    letI : Algebra (U.left.presheaf.stalk x) H := ι.toAlgebra
    have hι'eq : ι' = CommRingCat.ofHom ι := CommRingCat.hom_ext hι'
    rw [hι'eq]
    exact wc_lfi_specMap_weaklyEtale _ _ hwe
  have hγwe : WeaklyEtale γ := by
    rw [hγ]
    exact MorphismProperty.comp_mem @WeaklyEtale _ _ hSW
      (wc_lfi_fromSpecStalk_weaklyEtale U.left x)
  have hT : WeaklyEtale (γ ≫ U.hom) :=
    MorphismProperty.comp_mem @WeaklyEtale γ U.hom hγwe U.prop
  let Th : S.ProEt := MorphismProperty.Over.mk ⊤ (γ ≫ U.hom) hT
  let g : Th ⟶ U := MorphismProperty.Over.homMk γ rfl trivial

  obtain ⟨θ, hθloc, hθ1⟩ : ∃ θ : U.left.presheaf.stalk x ⟶ U.left.presheaf.stalk x,
      IsLocalHom θ.hom ∧ Spec.map θ ≫ U.left.fromSpecStalk x =
        U.left.fromSpecStalk x ≫ φ.left := by
    refine ⟨(U.left.presheaf.stalkCongr (Inseparable.of_eq hφx)).inv ≫
      φ.left.stalkMap x, ?_, ?_⟩
    · rw [CommRingCat.hom_comp]; infer_instance
    · have key : ∀ (y z : U.left) (hy : y = z),
          Spec.map (U.left.presheaf.stalkCongr (Inseparable.of_eq hy)).inv ≫
            U.left.fromSpecStalk z = U.left.fromSpecStalk y := by
        intro y z hy; subst hy; simp
      rw [Spec.map_comp, Category.assoc, key _ _ hφx, Scheme.SpecMap_stalkMap_fromSpecStalk]
  haveI := hθloc
  obtain ⟨ρ, ⟨hρloc, hρι⟩, -⟩ := huniv H (ι.comp θ.hom) (RingHom.isLocalHom_comp ι θ.hom)
  have hcomp : ι' ≫ CommRingCat.ofHom ρ = θ ≫ ι' := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, hι']
    exact hρι
  have hI2 : Spec.map (CommRingCat.ofHom ρ) ≫ γ = γ ≫ φ.left := by
    rw [hγ, ← Category.assoc, ← Spec.map_comp, hcomp, Spec.map_comp]
    simp only [Category.assoc]
    rw [hθ1]
  have hw : Spec.map (CommRingCat.ofHom ρ) ≫ γ ≫ U.hom = γ ≫ U.hom := by
    rw [← Category.assoc, hI2, Category.assoc, MorphismProperty.Over.w φ]
  let φh : Th ⟶ Th := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom ρ)) hw trivial
  have hφg : φh ≫ g = g ≫ φ := MorphismProperty.Over.Hom.ext hI2

  have hφwe : WeaklyEtale φ.left := by
    haveI : WeaklyEtale (φ.left ≫ U.hom) := by rw [MorphismProperty.Over.w φ]; exact U.prop
    haveI : WeaklyEtale U.hom := U.prop
    exact WeaklyEtale.of_comp φ.left U.hom
  have h2 : WeaklyEtale (γ ≫ φ.left) := MorphismProperty.comp_mem @WeaklyEtale _ _ hγwe hφwe
  have hρwe : WeaklyEtale (Spec.map (CommRingCat.ofHom ρ)) := by
    haveI : WeaklyEtale (Spec.map (CommRingCat.ofHom ρ) ≫ γ) := by rw [hI2]; exact h2
    haveI := hγwe
    exact WeaklyEtale.of_comp (Spec.map (CommRingCat.ofHom ρ)) γ

  have hρalg : @Algebra.WeaklyEtale H H _ _ ρ.toAlgebra :=
    wc_lpkt_specMap_weaklyEtale_ring H H ρ hρwe
  have hρbij : Function.Bijective ρ :=
    @wc_olivier H H _ _ ρ.toAlgebra _ _ iHh hsepH hρloc hρalg

  have hmax' : Ideal.map ι'.hom (IsLocalRing.maximalIdeal (U.left.presheaf.stalk x))
      = IsLocalRing.maximalIdeal H := by rw [hι']; exact hmax
  have hres' : ∀ a : H, ∃ b, a - ι'.hom b ∈ IsLocalRing.maximalIdeal H := by rw [hι']; exact hres
  have hLF := wc_lfi_local_spec_fibre U.left x H ι' hmax' hres'
  rw [← hγ] at hLF

  let U' : (Spec (CommRingCat.of H)).Opens :=
    ⟨{IsLocalRing.closedPoint H}ᶜ, (IsLocalRing.isClosed_singleton_closedPoint H).isOpen_compl⟩
  have hVT : WeaklyEtale (U'.ι ≫ γ ≫ U.hom) :=
    MorphismProperty.comp_mem @WeaklyEtale _ _ inferInstance hT
  let VT : S.ProEt := MorphismProperty.Over.mk ⊤ (U'.ι ≫ γ ≫ U.hom) hVT
  let j : VT ⟶ Th := MorphismProperty.Over.homMk U'.ι rfl trivial
  have hsub : Set.range (U'.ι ≫ Spec.map (CommRingCat.ofHom ρ)) ⊆ Set.range U'.ι := by
    rintro _ ⟨v, rfl⟩
    rw [Scheme.Opens.range_ι]
    intro hv
    have hv' : PrimeSpectrum.comap ρ v.1 = IsLocalRing.closedPoint H := hv
    have hle : IsLocalRing.maximalIdeal H ≤ (v.1 : PrimeSpectrum H).asIdeal := by
      intro h hh
      obtain ⟨h', rfl⟩ := hρbij.2 h
      have hh' : h' ∈ IsLocalRing.maximalIdeal H := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        exact (IsLocalRing.mem_maximalIdeal _).mp hh (hu.map ρ)
      have h1 : h' ∈ (PrimeSpectrum.comap ρ v.1).asIdeal := by
        rw [hv']; exact hh'
      exact h1
    have heq := (IsLocalRing.maximalIdeal.isMaximal H).eq_of_le
      (v.1 : PrimeSpectrum H).isPrime.ne_top hle
    exact v.2 (PrimeSpectrum.ext heq.symm)
  let L : (U' : Scheme) ⟶ (U' : Scheme) :=
    IsOpenImmersion.lift U'.ι (U'.ι ≫ Spec.map (CommRingCat.ofHom ρ)) hsub
  have hLfac : L ≫ U'.ι = U'.ι ≫ Spec.map (CommRingCat.ofHom ρ) :=
    IsOpenImmersion.lift_fac _ _ hsub
  have hLw : L ≫ U'.ι ≫ γ ≫ U.hom = U'.ι ≫ γ ≫ U.hom := by
    rw [← Category.assoc, hLfac, Category.assoc, hw]
  let φV : VT ⟶ VT := MorphismProperty.Over.homMk L hLw trivial
  have hφV : φV ≫ j = j ≫ φh := MorphismProperty.Over.Hom.ext hLfac
  have hTc : CompactSpace Th.left := by
    show CompactSpace (Spec (CommRingCat.of H))
    infer_instance
  refine ⟨Th, g, φh, H, iH, iHn, iHh, hsepH, Iso.refl _, VT, j, φV, hφg, ?_, ?_, ?_, ?_, hφV,
    hTc⟩
  · exact hLF.1
  · exact hLF.2
  · show IsOpenImmersion U'.ι
    infer_instance
  · show Set.range U'.ι = _
    rw [Scheme.Opens.range_ι]
    rfl

theorem wc_proet_ext1_finite_of_point_removal : ∀ (S : Scheme.{u}) (U V : S.ProEt) (ι : V ⟶ U) (x : U.left), IsOpenImmersion ι.left → Set.range ι.left = {x}ᶜ → IsLocallyNoetherian U.left → QuasiSeparatedSpace U.left → IsSepClosed (IsLocalRing.ResidueField (U.left.presheaf.stalk x)) → ∀ (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), (∀ (T : S.ProEt) (g : T ⟶ U), TopologicalSpace.NoetherianSpace T.left → (∀ t : T.left, g.left t ≠ x ∧ g.left t ⤳ x) → Finite (L.obj.obj (Opposite.op T))) → Finite (Abelian.Ext (wcFreeSheaf S V) L 1) → Finite (Abelian.Ext (wcFreeSheaf S U) L 1) :=
by
  intro S U V ι x hι hr hln hqs hsep L hfin hV
  classical

  have s1 : ∀ (X : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})),
      X.ShortExact → Projective X.X₂ →
      ∀ (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Finite (X.X₁ ⟶ Y) → Finite (Abelian.Ext X.X₃ Y 1) := by
    intro X hX hP Y hY
    haveI := hP
    have hsurj : Function.Surjective
        (fun x₁ : Abelian.Ext X.X₁ Y 0 => hX.extClass.comp x₁ (show 1 + 0 = 1 from rfl)) := by
      intro y
      have h0 : (Abelian.Ext.mk₀ X.g).comp y (zero_add 1) = 0 :=
        Abelian.Ext.eq_zero_of_projective (n := 0) _
      exact Abelian.Ext.contravariant_sequence_exact₃ hX Y y h0 (n₀ := 0) rfl
    haveI : Finite (Abelian.Ext X.X₁ Y 0) := Finite.of_equiv _ Abelian.Ext.homEquiv₀.symm
    exact Finite.of_surjective _ hsurj

  have s2 : ∀ (X : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})),
      X.ShortExact → ∀ (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Finite (Abelian.Ext X.X₁ Y 1) → Finite (Abelian.Ext X.X₃ Y 1) →
      Finite (Abelian.Ext X.X₂ Y 1) := by
    intro X hX Y h1 h3
    let ρ := (Abelian.Ext.mk₀ X.f).precomp Y (zero_add 1)
    let ψ := (Abelian.Ext.mk₀ X.g).precomp Y (zero_add 1)
    have hker : ((AddMonoidHom.ker ρ : AddSubgroup (Abelian.Ext X.X₂ Y 1)) :
        Set (Abelian.Ext X.X₂ Y 1)) ⊆ Set.range ψ := by
      intro z hz
      have hz' : (Abelian.Ext.mk₀ X.f).comp z (zero_add 1) = 0 := hz
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₂ hX Y z hz'
      exact ⟨x₁, hx₁⟩
    haveI : Finite (AddMonoidHom.ker ρ) := ((Set.finite_range ψ).subset hker).to_subtype
    haveI : Finite (Abelian.Ext X.X₂ Y 1 ⧸ AddMonoidHom.ker ρ) :=
      Finite.of_equiv _ (QuotientAddGroup.quotientKerEquivRange ρ).toEquiv.symm
    exact Finite.of_addSubgroup_quotient (AddMonoidHom.ker ρ)

  haveI := hln
  obtain ⟨Th, g, φh, B, _, _, _, _, eB, VT, j, φV, -, hpre, hfib, hj, hrj0, -, hT⟩ :=
    wc_proet_strict_nbhd_of_fixed_point S U x (𝟙 U)
      (by show (𝟙 U.left : U.left ⟶ U.left) x = x; first | rfl | simp) hsep

  have hstar : ∀ t : VT.left, g.left (j.left t) ≠ x := by
    intro t h
    have h1 : j.left t ∈ g.left ⁻¹' {x} := h
    rw [hpre] at h1
    have h2 : j.left t ∈ Set.range j.left := ⟨t, rfl⟩
    rw [hrj0] at h2
    exact h2 h1

  have hrj : Set.range j.left = g.left ⁻¹' {x}ᶜ := by
    first
    | rw [Set.preimage_compl, hpre, hrj0]
    | rw [hpre, hrj0]

  have H' : Set.range ⇑(j.left ≫ g.left) ⊆ Set.range ⇑ι.left := by
    rintro _ ⟨t, rfl⟩
    rw [hr, Scheme.Hom.comp_apply]
    exact hstar t
  haveI := hι
  have hfac : IsOpenImmersion.lift ι.left (j.left ≫ g.left) H' ≫ ι.left = j.left ≫ g.left :=
    IsOpenImmersion.lift_fac _ _ _
  have hw : IsOpenImmersion.lift ι.left (j.left ≫ g.left) H' ≫ V.hom = VT.hom := by
    rw [← MorphismProperty.Over.w ι, ← Category.assoc, hfac, Category.assoc,
      MorphismProperty.Over.w g, MorphismProperty.Over.w j]
  let gV : VT ⟶ V := MorphismProperty.Over.homMk (IsOpenImmersion.lift ι.left (j.left ≫ g.left) H') hw trivial
  have hgV : gV ≫ ι = j ≫ g := by
    apply MorphismProperty.Over.Hom.ext
    exact hfac

  obtain ⟨κ, hκ, -⟩ :=
    wc_lfi_point_excision S U V Th VT ι hι x hr g j hj hrj gV hgV hfib hT hqs hln

  haveI := hj
  have hmonoι := wc_free_sheaf_map_mono S V U ι (IsOpenImmersion.mono ι.left)
  have hmonoj := wc_free_sheaf_map_mono S VT Th j (IsOpenImmersion.mono j.left)
  have hSU : (ShortComplex.mk (wcFreeSheafMap S ι) (Limits.cokernel.π (wcFreeSheafMap S ι))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmonoι inferInstance
  have hST : (ShortComplex.mk (wcFreeSheafMap S j) (Limits.cokernel.π (wcFreeSheafMap S j))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmonoj inferInstance

  have hVTsp : TopologicalSpace.NoetherianSpace VT.left ∧
      ∀ t : VT.left, j.left t ⤳ eB.inv (IsLocalRing.closedPoint B) := by
    haveI : IsOpenImmersion (j.left ≫ eB.hom) := inferInstance
    constructor
    · exact (Scheme.Hom.isOpenEmbedding (j.left ≫ eB.hom)).isInducing.noetherianSpace
    · intro t
      have h1 := (IsLocalRing.specializes_closedPoint (R := B) ((j.left ≫ eB.hom) t)).map
        (Scheme.Hom.continuous eB.inv)
      rwa [Scheme.Hom.comp_apply, Scheme.hom_inv_apply] at h1
  have hLVT : Finite (L.obj.obj (Opposite.op VT)) := by
    refine hfin VT (j ≫ g) hVTsp.1 (fun t => ?_)
    change g.left (j.left t) ≠ x ∧ g.left (j.left t) ⤳ x
    refine ⟨hstar t, ?_⟩
    have hc : g.left (eB.inv (IsLocalRing.closedPoint B)) = x := by
      have : eB.inv (IsLocalRing.closedPoint B) ∈ g.left ⁻¹' {x} := by
        rw [hpre]; exact Set.mem_singleton _
      exact this
    have h2 := (hVTsp.2 t).map g.left.continuous
    rwa [hc] at h2

  obtain ⟨η, hη, -⟩ := wc_proet_free_sheaf_yoneda S
  have hHom : Finite (wcFreeSheaf S VT ⟶ L) := by
    refine Finite.of_injective
      (fun f : wcFreeSheaf S VT ⟶ L => (f.hom.app (Opposite.op VT)).hom (η VT)) ?_
    intro f₁ f₂ h
    exact (hη VT L ((f₁.hom.app (Opposite.op VT)).hom (η VT))).unique rfl h.symm

  have hProj : Projective (wcFreeSheaf S Th) := wc_proet_free_projective_strict_local S Th B eB
  have hcj : Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S j)) L 1) :=
    s1 _ hST hProj L hHom

  haveI := hκ
  have hci : Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) L 1) := by
    have key : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) L 1,
        (Abelian.Ext.mk₀ (inv κ)).comp ((Abelian.Ext.mk₀ κ).comp y (zero_add 1)) (zero_add 1) = y := by
      intro y
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    refine Finite.of_injective (β := Abelian.Ext (Limits.cokernel (wcFreeSheafMap S j)) L 1)
      (fun y => (Abelian.Ext.mk₀ κ).comp y (zero_add 1)) ?_
    intro y1 y2 h
    rw [← key y1, ← key y2]
    exact congrArg (fun y => (Abelian.Ext.mk₀ (inv κ)).comp y (zero_add 1)) h

  exact s2 _ hSU L hV hci

theorem wc_proet_connected_refinement (S : Scheme.{u}) (V T₁ T₂ : S.ProEt)
    (f₁ : T₁ ⟶ V) (f₂ : T₂ ⟶ V) (t₁ : T₁.left) (t₂ : T₂.left)
    (h : f₁.left t₁ = f₂.left t₂) :
    ∃ (X : S.ProEt) (q₁ : X ⟶ T₁) (q₂ : X ⟶ T₂) (x₀ : X.left),
      ConnectedSpace X.left ∧ q₁ ≫ f₁ = q₂ ≫ f₂ ∧ q₁.left x₀ = t₁ ∧ q₂.left x₀ = t₂ :=
by
  classical
  obtain ⟨p, hp₁, hp₂⟩ := Scheme.Pullback.exists_preimage_pullback t₁ t₂ h
  haveI hV : WeaklyEtale V.hom := V.prop
  haveI hT₁ : WeaklyEtale T₁.hom := T₁.prop
  haveI h2c : WeaklyEtale (f₂.left ≫ V.hom) := by
    rw [MorphismProperty.Over.w f₂]; exact T₂.prop
  haveI h2 : WeaklyEtale f₂.left := WeaklyEtale.of_comp f₂.left V.hom
  haveI hι : WeaklyEtale ((Limits.pullback f₁.left f₂.left).fromSpecStalk p) := by
    refine ⟨?_, inferInstance⟩
    obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
      (Limits.pullback f₁.left f₂.left).isBasis_affineOpens.exists_subset_of_mem_open
        (Set.mem_univ p) isOpen_univ
    replace hU : IsAffineOpen U := hU
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
    show Flat (Spec.map ((Limits.pullback f₁.left f₂.left).presheaf.germ U p hx) ≫ hU.fromSpec)
    have : Flat (Spec.map ((Limits.pullback f₁.left f₂.left).presheaf.germ U p hx)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      letI : Algebra Γ(Limits.pullback f₁.left f₂.left, U)
          ((Limits.pullback f₁.left f₂.left).presheaf.stalk p) :=
        ((Limits.pullback f₁.left f₂.left).presheaf.germ U p hx).hom.toAlgebra
      haveI := hU.isLocalization_stalk ⟨p, hx⟩
      exact RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat _ (hU.primeIdealOf ⟨p, hx⟩).asIdeal.primeCompl)
    have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
    exact MorphismProperty.comp_mem @Flat _ _ this hfs
  have hσ : WeaklyEtale ((Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫
      Limits.pullback.fst f₁.left f₂.left ≫ T₁.hom) := inferInstance
  let X : S.ProEt := MorphismProperty.Over.mk ⊤ _ hσ
  let q₁ : X ⟶ T₁ := MorphismProperty.Over.homMk
    ((Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫ Limits.pullback.fst f₁.left f₂.left)
    (by
      show ((Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫
        Limits.pullback.fst f₁.left f₂.left) ≫ T₁.hom =
        (Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫
          Limits.pullback.fst f₁.left f₂.left ≫ T₁.hom
      rw [Category.assoc]) trivial
  let q₂ : X ⟶ T₂ := MorphismProperty.Over.homMk
    ((Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫ Limits.pullback.snd f₁.left f₂.left)
    (by
      show ((Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫
        Limits.pullback.snd f₁.left f₂.left) ≫ T₂.hom =
        (Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫
          Limits.pullback.fst f₁.left f₂.left ≫ T₁.hom
      rw [← MorphismProperty.Over.w f₂, ← MorphismProperty.Over.w f₁, Category.assoc,
        ← Category.assoc (Limits.pullback.snd _ _), ← Limits.pullback.condition,
        Category.assoc])
    trivial
  have hconn : ConnectedSpace (PrimeSpectrum ((Limits.pullback f₁.left f₂.left).presheaf.stalk p)) := by
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨IsLocalRing.closedPoint _⟩, fun s hs => ?_⟩
    by_cases hc : IsLocalRing.closedPoint ((Limits.pullback f₁.left f₂.left).presheaf.stalk p) ∈ s
    · right
      exact Set.eq_univ_of_forall fun x =>
        (IsLocalRing.specializes_closedPoint x).mem_open hs.isOpen hc
    · left
      exact Set.eq_empty_iff_forall_notMem.mpr fun x hx =>
        hc ((IsLocalRing.specializes_closedPoint x).mem_closed hs.isClosed hx)
  refine ⟨X, q₁, q₂, IsLocalRing.closedPoint ((Limits.pullback f₁.left f₂.left).presheaf.stalk p),
    hconn, ?_, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    show ((Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫
        Limits.pullback.fst f₁.left f₂.left) ≫ f₁.left =
      ((Limits.pullback f₁.left f₂.left).fromSpecStalk p ≫
        Limits.pullback.snd f₁.left f₂.left) ≫ f₂.left
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  · show (Limits.pullback.fst f₁.left f₂.left) ((Limits.pullback f₁.left f₂.left).fromSpecStalk p
        (IsLocalRing.closedPoint ((Limits.pullback f₁.left f₂.left).presheaf.stalk p))) = t₁
    rw [Scheme.fromSpecStalk_closedPoint, hp₁]
  · show (Limits.pullback.snd f₁.left f₂.left) ((Limits.pullback f₁.left f₂.left).fromSpecStalk p
        (IsLocalRing.closedPoint ((Limits.pullback f₁.left f₂.left).presheaf.stalk p))) = t₂
    rw [Scheme.fromSpecStalk_closedPoint, hp₂]

theorem wc_qclift_sections_finite_off_points (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)) (L : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (hqc : QuasiCompact w.left) (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S i (IsLocalRing.closedPoint F'')) → ∃ z : W.left, w.left z = p) (A : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A] [IsTopologicalAddGroup A] [Finite A] (θr : L.over W ≅ (wcContSheaf (wcP1Over F'').left A).over W) (V : (wcP1Over F'').left.ProEt) (hV : TopologicalSpace.NoetherianSpace V.left) (havoid : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint F'')) : Finite (L.obj.obj (Opposite.op V)) :=
by
  classical
  haveI : CompactSpace V.left := inferInstance
  haveI : QuasiSeparatedSpace V.left := inferInstance
  haveI hVWE : WeaklyEtale V.hom := V.prop
  haveI hWWE : WeaklyEtale W.hom := W.prop

  let fV : V.left ⟶ (wcP1Over F'').left := V.hom
  let fW : W.left ⟶ (wcP1Over F'').left := W.hom
  haveI hPbqc : QuasiCompact (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
    show QuasiCompact (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    infer_instance
  haveI hWqc : QuasiCompact fW := by
    have e : fW = w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
      (MorphismProperty.Over.w w).symm
    rw [e]
    infer_instance
  haveI hVc : CompactSpace V.left := inferInstance
  let Q : Scheme.{u} := Limits.pullback fV fW
  let πV : Q ⟶ V.left := Limits.pullback.fst fV fW
  let πW : Q ⟶ W.left := Limits.pullback.snd fV fW
  haveI hπVqc : QuasiCompact πV := inferInstanceAs (QuasiCompact (Limits.pullback.fst fV fW))
  haveI : CompactSpace Q := QuasiCompact.compactSpace_of_compactSpace πV
  haveI hSpecSurj : Surjective (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    Surjective.mk (fun _ => ⟨Classical.arbitrary _, Subsingleton.elim _ _⟩)
  have hPbsurj : Function.Surjective (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
    have : Surjective (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
    exact this.surj
  have hQsurj : ∀ v : V.left, ∃ q : Q, πV q = v := by
    intro v
    obtain ⟨p, hp⟩ := hPbsurj (V.hom v)
    obtain ⟨z, hz⟩ := hsurj p (fun i => by rw [hp]; exact havoid v i)
    have hzv : W.hom z = V.hom v := by
      rw [← MorphismProperty.Over.w w, Scheme.Hom.comp_apply, hz, hp]
    obtain ⟨q, hq, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := fV) (g := fW) v z hzv.symm
    exact ⟨q, hq⟩
  have hcovQ : ∀ q : Q, ∃ U : Q.Opens, IsAffineOpen U ∧ q ∈ U := fun q => by
    obtain ⟨U, hU, hqU, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := q) (U := ⊤) (show q ∈ (⊤ : Q.Opens) from trivial)
    exact ⟨U, hU, hqU⟩
  choose Uq hUq hqU using hcovQ
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun q => (Uq q : Set Q))
    (fun q => (Uq q).isOpen.mem_nhds (hqU q))
  let n := t.card
  let U : Fin n → Q.Opens := fun a => Uq (t.equivFin.symm a)
  have hWE : ∀ a, WeaklyEtale (((U a).ι ≫ πV) ≫ fV) := by
    intro a
    haveI : WeaklyEtale fW := hWWE
    haveI : WeaklyEtale fV := hVWE
    haveI : WeaklyEtale πV := inferInstanceAs (WeaklyEtale (Limits.pullback.fst fV fW))
    infer_instance
  have hcond : πV ≫ fV = πW ≫ fW := Limits.pullback.condition
  let Y : Fin n → (wcP1Over F'').left.ProEt := fun a =>
    @Scheme.ProEt.mk _ _ (((U a).ι ≫ πV) ≫ fV) (hWE a)
  let p : ∀ a, Y a ⟶ V := fun a =>
    MorphismProperty.Over.homMk ((U a).ι ≫ πV) rfl trivial
  let b : ∀ a, Y a ⟶ W := fun a =>
    MorphismProperty.Over.homMk ((U a).ι ≫ πW)
      (by
        show ((U a).ι ≫ πW) ≫ fW = ((U a).ι ≫ πV) ≫ fV
        rw [Category.assoc, Category.assoc, hcond]) trivial
  have hYaff : ∀ a, IsAffine (Y a).left := fun a => hUq (t.equivFin.symm a)
  have hjs : ∀ v : V.left, ∃ a, v ∈ Set.range (p a).left := by
    intro v
    obtain ⟨q, hq⟩ := hQsurj v
    have hq' : q ∈ ⋃ x ∈ t, (Uq x : Set Q) := by
      rw [ht]; exact Set.mem_univ q
    simp only [Set.mem_iUnion] at hq'
    obtain ⟨x, hx, hqx⟩ := hq'
    have hqa : q ∈ U (t.equivFin ⟨x, hx⟩) := by
      show q ∈ Uq (t.equivFin.symm (t.equivFin ⟨x, hx⟩))
      rw [Equiv.symm_apply_apply]; exact hqx
    refine ⟨t.equivFin ⟨x, hx⟩, ⟨q, hqa⟩, ?_⟩
    have e1 := Scheme.Hom.comp_apply (U (t.equivFin ⟨x, hx⟩)).ι πV ⟨q, hqa⟩
    rw [Scheme.Opens.ι_apply, hq] at e1
    exact e1
  have hcov := proet_finite_affine_jointly_surjective_covers _ V n Y p hYaff hjs

  have hnat : ∀ (X T : (wcP1Over F'').left.ProEt) (c : X ⟶ T) (β : T ⟶ W)
      (y : L.obj.obj (Opposite.op T)) (x₀ : X.left),
      (show C(↥X.left, A) from ((θr.hom.hom.app (Opposite.op (Over.mk (c ≫ β)))).hom
        ((L.obj.map c.op).hom y)).down) x₀ =
      (show C(↥T.left, A) from ((θr.hom.hom.app (Opposite.op (Over.mk β))).hom y).down)
        (c.left x₀) := by
    intro X T c β y x₀
    let ĉ : (Over.mk (c ≫ β) : Over W) ⟶ Over.mk β := Over.homMk c rfl
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) (θr.hom.hom.naturality ĉ.op)
    exact congrArg (fun z : ULift.{u+1} C(↥X.left, A) => z.down x₀) h

  obtain ⟨gc, -, -, hgc⟩ := wc_proet_constSheaf_trivialization_cocycle _ L A
    (fun P α => wc_contSheaf_over_hom_pointwise _ A A P α) Unit (fun _ => W) (fun _ => θr)
  have hfib : ∀ (T₁ T₂ : (wcP1Over F'').left.ProEt) (f₁ : T₁ ⟶ V) (f₂ : T₂ ⟶ V)
      (b₁ : T₁ ⟶ W) (b₂ : T₂ ⟶ W) (s : L.obj.obj (Opposite.op V)) (t₁ : T₁.left) (t₂ : T₂.left),
      f₁.left t₁ = f₂.left t₂ →
      ((show C(↥T₁.left, A) from ((θr.hom.hom.app (Opposite.op (Over.mk b₁))).hom
          ((L.obj.map f₁.op).hom s)).down) t₁ = 0 ↔
        (show C(↥T₂.left, A) from ((θr.hom.hom.app (Opposite.op (Over.mk b₂))).hom
          ((L.obj.map f₂.op).hom s)).down) t₂ = 0) := by
    intro T₁ T₂ f₁ f₂ b₁ b₂ s t₁ t₂ h
    obtain ⟨X, q₁, q₂, x₀, -, hq, hq₁, hq₂⟩ := wc_proet_connected_refinement _ V T₁ T₂ f₁ f₂ t₁ t₂ h
    subst hq₁ hq₂
    have e1 := hnat X T₁ q₁ b₁ ((L.obj.map f₁.op).hom s) x₀
    have e2 := hnat X T₂ q₂ b₂ ((L.obj.map f₂.op).hom s) x₀
    have hmaps : L.obj.map f₁.op ≫ L.obj.map q₁.op = L.obj.map f₂.op ≫ L.obj.map q₂.op := by
      rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hq]
    have hx : (L.obj.map q₁.op).hom ((L.obj.map f₁.op).hom s) =
        (L.obj.map q₂.op).hom ((L.obj.map f₂.op).hom s) :=
      congrArg (fun φ => AddCommGrpCat.Hom.hom φ s) hmaps
    have hc := hgc () () X (q₁ ≫ b₁) (q₂ ≫ b₂) ((L.obj.map q₁.op).hom ((L.obj.map f₁.op).hom s)) x₀
    beta_reduce at hc
    rw [← e1, ← e2, ← hx, hc]
    exact AddEquiv.map_eq_zero_iff _

  let ev : ∀ a, L.obj.obj (Opposite.op V) → (Y a).left → A := fun a s y =>
    (show C(↥(Y a).left, A) from ((θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom
      ((L.obj.map (p a).op).hom s)).down) y
  have hev_sub : ∀ a s s' y, ev a (s - s') y = ev a s y - ev a s' y := by
    intro a s s' y
    have h1 : (θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom ((L.obj.map (p a).op).hom (s - s')) =
        (θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom ((L.obj.map (p a).op).hom s) -
          (θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom ((L.obj.map (p a).op).hom s') :=
      ((congrArg (θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom
        (map_sub (L.obj.map (p a).op).hom s s')).trans
        (map_sub (θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom _ _))
    exact congrArg (fun z : ULift.{u+1} C(↥(Y a).left, A) => z.down y) h1
  have hcont : ∀ a s, Continuous (ev a s) := by
    intro a s
    exact ContinuousMap.continuous _
  have hfibev : ∀ (s : L.obj.obj (Opposite.op V)) (a a' : Fin n) (y : (Y a).left) (y' : (Y a').left),
      (p a).left y = (p a').left y' → (ev a s y = 0 ↔ ev a' s y' = 0) :=
    fun s a a' y y' h => hfib (Y a) (Y a') (p a) (p a') (b a) (b a') s y y' h
  have hquot := (wc_proet_cover_surj_quotient _ V _ hcov).2
  have hOpenOf : ∀ O : Set V.left, (∀ a, IsOpen ((p a).left ⁻¹' O)) → IsOpen O := by
    intro O hO
    apply hquot O
    intro T f hf
    obtain ⟨Z, h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨a⟩
    exact (hO a).preimage h.left.continuous
  have hfinC := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := V.left)
  haveI : Finite (irreducibleComponents V.left) := hfinC.to_subtype
  have hrep : ∀ C : irreducibleComponents V.left, ∃ a : Fin n, ∃ y : (Y a).left,
      (p a).left y ∈ (C : Set V.left) := by
    intro C
    obtain ⟨v, hv⟩ := C.2.prop.nonempty
    obtain ⟨a, y, hy⟩ := hjs v
    exact ⟨a, y, hy ▸ hv⟩
  choose aC yC hyC using hrep
  let Φ : L.obj.obj (Opposite.op V) → (irreducibleComponents V.left → A) :=
    fun s C => ev (aC C) s (yC C)
  refine Finite.of_injective Φ ?_
  intro s s' hss'
  rw [← sub_eq_zero]
  have hΦ : ∀ C, ev (aC C) (s - s') (yC C) = 0 := fun C => by
    rw [hev_sub]; exact sub_eq_zero.mpr (congrFun hss' C)
  generalize s - s' = g at hΦ ⊢
  let Ω : Set V.left := {v | ∀ a y, (p a).left y = v → ev a g y = 0}
  have hpre : ∀ a, (p a).left ⁻¹' Ω = {y | ev a g y = 0} := by
    intro a; ext y; constructor
    · intro hy; exact hy a y rfl
    · intro hy a' y' hy'; exact (hfibev g a a' y y' hy'.symm).1 hy
  have hopen : ∀ a, IsOpen {y | ev a g y = 0} := fun a =>
    (isOpen_discrete ({0} : Set A)).preimage (hcont a g)
  have hopen' : ∀ a, IsOpen {y | ev a g y = 0}ᶜ := fun a =>
    (isOpen_discrete ({0}ᶜ : Set A)).preimage (hcont a g)
  have hΩo : IsOpen Ω := hOpenOf Ω (fun a => by rw [hpre]; exact hopen a)
  have hΩc : IsOpen Ωᶜ := hOpenOf Ωᶜ (fun a => by rw [Set.preimage_compl, hpre]; exact hopen' a)
  have hΩ : IsClopen Ω := ⟨isOpen_compl_iff.mp hΩc, hΩo⟩
  have hall : ∀ v, v ∈ Ω := by
    intro v
    let C' : irreducibleComponents V.left :=
      ⟨irreducibleComponent v, irreducibleComponent_mem_irreducibleComponents v⟩
    have hvC : (p (aC C')).left (yC C') ∈ Ω := by
      intro a y hy
      exact (hfibev g (aC C') a (yC C') y hy.symm).1 (hΦ C')
    have hsub : irreducibleComponent v ⊆ Ω :=
      isIrreducible_irreducibleComponent.isPreirreducible.isPreconnected.subset_isClopen hΩ
        ⟨_, hyC C', hvC⟩
    exact hsub mem_irreducibleComponent

  have hres0 : ∀ a, (L.obj.map (p a).op).hom g = 0 := by
    intro a
    have h0 : (show ULift.{u+1} C(↥(Y a).left, A) from
        (θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom ((L.obj.map (p a).op).hom g)) =
        (show ULift.{u+1} C(↥(Y a).left, A) from 0) := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro y
      exact hall ((p a).left y) a y rfl
    have h0' : (θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom ((L.obj.map (p a).op).hom g) = 0 :=
      h0
    have hid : ∀ x, (θr.inv.hom.app (Opposite.op (Over.mk (b a)))).hom
        ((θr.hom.hom.app (Opposite.op (Over.mk (b a)))).hom x) = x := by
      intro x
      exact congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op (Over.mk (b a)))) x)
        θr.hom_inv_id
    have h2 := hid ((L.obj.map (p a).op).hom g)
    rw [h0', map_zero] at h2
    exact h2.symm
  apply (wc_proet_sheaf_cech_glue _ L Y p hcov).2 g 0
  intro σ
  have hbase : Limits.WidePullback.base (fun l => p (σ l)) =
      Limits.WidePullback.π (fun l => p (σ l)) 0 ≫ p (σ 0) :=
    (Limits.WidePullback.π_arrow (fun l => p (σ l)) 0).symm
  show (L.obj.map (Limits.WidePullback.base (fun l => p (σ l))).op).hom g =
    (L.obj.map (Limits.WidePullback.base (fun l => p (σ l))).op).hom 0
  rw [map_zero, hbase, op_comp, Functor.map_comp]
  show (L.obj.map (Limits.WidePullback.π (fun l => p (σ l)) 0).op).hom
    ((L.obj.map (p (σ 0)).op).hom g) = 0
  rw [hres0, map_zero]

theorem wc_pmod_geom_point_local_data (K : Type u) [Field K] [Finite K]
    (X : Over (Spec (.of K))) (hpX : IsProper X.hom)
    (s : Spec (.of K) ⟶ X.left) (hs : s ≫ X.hom = 𝟙 _)
    (O : X.left.Opens) (hO : (O : Set X.left) = {s (IsLocalRing.closedPoint K)}ᶜ)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) :
    ∃ xb : (wcGeomPoint K X hX).left,
      Set.range (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)).left = {xb}ᶜ ∧
      (wcGeomPoint K X hX).hom ⁻¹' {s (IsLocalRing.closedPoint K)} = {xb} ∧
      IsLocallyNoetherian (wcGeomPoint K X hX).left ∧
      QuasiSeparatedSpace (wcGeomPoint K X hX).left ∧
      IsSepClosed (IsLocalRing.ResidueField ((wcGeomPoint K X hX).left.presheaf.stalk xb)) ∧
      ∀ (Th : X.left.ProEt) (g : Th ⟶ wcGeomPoint K X hX),
        IsIso (Limits.pullback.snd g.left ((wcGeomPoint K X hX).left.fromSpecResidueField xb)) →
        ∃ ε : Limits.pullback Th.hom s ≅ Spec (.of (AlgebraicClosure K)),
          ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
            Limits.pullback.snd Th.hom s :=
by
  classical
  haveI := hpX

  haveI hlft : LocallyOfFiniteType (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback _ _)
      inferInstance
  haveI hsep : IsSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @IsSeparated) (IsPullback.of_hasPullback _ _)
      inferInstance
  haveI hln : IsLocallyNoetherian (wcGeomPoint K X hX).left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hlft inferInstance
  have hqsep : QuasiSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) (IsPullback.of_hasPullback _ _)
      inferInstance
  have hqs : QuasiSeparatedSpace (wcGeomPoint K X hX).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) inferInstance
      hqsep

  have hsq0 : (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s) ≫ X.hom =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
  obtain ⟨ub, hub1, hub2⟩ : ∃ ub : Spec (.of (AlgebraicClosure K)) ⟶ (wcGeomPoint K X hX).left,
      ub ≫ (wcGeomPoint K X hX).hom =
        Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s ∧
      ub ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) = 𝟙 _ :=
    ⟨Limits.pullback.lift _ (𝟙 _) hsq0, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hsq : IsPullback ub (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
      (wcGeomPoint K X hX).hom s := by
    refine IsPullback.of_right ?_ hub1 (IsPullback.of_hasPullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))).flip
    rw [hub2, hs]
    exact IsPullback.id_horiz _
  obtain ⟨xb, hxb⟩ : ∃ xb : (wcGeomPoint K X hX).left,
      xb = ub (IsLocalRing.closedPoint (AlgebraicClosure K)) := ⟨_, rfl⟩
  haveI hci1 : IsClosedImmersion (ub ≫ Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := by
    rw [hub2]; infer_instance
  haveI : IsClosedImmersion ub := @IsClosedImmersion.of_comp _ _ _ ub (Limits.pullback.snd
    X.hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hci1 hsep
  have hptK : ∀ z : Spec (.of (AlgebraicClosure K)),
      z = IsLocalRing.closedPoint (AlgebraicClosure K) := fun z =>
    @Subsingleton.elim (PrimeSpectrum (AlgebraicClosure K)) _ _ _
  have hptF : ∀ z : Spec (.of K), z = IsLocalRing.closedPoint K := fun z =>
    @Subsingleton.elim (PrimeSpectrum K) _ _ _

  have hxbc : IsClosed ({xb} : Set (wcGeomPoint K X hX).left) := by
    have hr : Set.range ub = {xb} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        exact (congrArg ub (hptK z)).trans hxb.symm
      · intro hy
        exact ⟨_, (hxb.symm.trans hy.symm)⟩
    rw [← hr]
    exact ub.isClosedEmbedding.isClosed_range

  have hfx : (wcGeomPoint K X hX).hom xb = s (IsLocalRing.closedPoint K) := by
    have h1 : (ub ≫ (wcGeomPoint K X hX).hom)
        (IsLocalRing.closedPoint (AlgebraicClosure K)) =
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s)
        (IsLocalRing.closedPoint (AlgebraicClosure K)) := by
      first | rw [hub1] | exact congrArg (fun k => k (IsLocalRing.closedPoint _)) hub1
    have h2 : (ub ≫ (wcGeomPoint K X hX).hom)
        (IsLocalRing.closedPoint (AlgebraicClosure K)) =
        (wcGeomPoint K X hX).hom (ub (IsLocalRing.closedPoint _)) := by
      first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
    have h3 : (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s)
        (IsLocalRing.closedPoint (AlgebraicClosure K)) =
        s (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
          (IsLocalRing.closedPoint (AlgebraicClosure K))) := by
      first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
    have h4 := h2.symm.trans (h1.trans (h3.trans (congrArg s (hptF _))))
    rw [← hxb] at h4
    exact h4
  have hfib2 : (wcGeomPoint K X hX).hom ⁻¹' {s (IsLocalRing.closedPoint K)} = {xb} := by
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hy
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := (wcGeomPoint K X hX).hom) (g := s) y (IsLocalRing.closedPoint K) hy
      have e1 : ub (hsq.isoPullback.inv z) =
          Limits.pullback.fst (wcGeomPoint K X hX).hom s z := by
        rw [← Scheme.Hom.comp_apply hsq.isoPullback.inv ub z, hsq.isoPullback_inv_fst]
      rw [← hz1, ← e1, hptK (hsq.isoPullback.inv z), hxb]
    · rintro rfl
      exact hfx

  have hrange : Set.range (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)).left = {xb}ᶜ := by
    show Set.range (Limits.pullback.snd O.ι (wcGeomPoint K X hX).hom) = _
    rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι, ← hfib2,
      ← Set.preimage_compl, ← hO]
    rfl
  refine ⟨xb, hrange, hfib2, hln, hqs, ?_, ?_⟩
  ·
    haveI : JacobsonSpace (wcGeomPoint K X hX).left :=
      @LocallyOfFiniteType.jacobsonSpace _ _ (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hlft inferInstance
    haveI h2 : LocallyOfFiniteType ((wcGeomPoint K X hX).left.fromSpecResidueField xb) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hxbc
    haveI h3 : LocallyOfFiniteType ((wcGeomPoint K X hX).left.fromSpecResidueField xb ≫
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      MorphismProperty.comp_mem @LocallyOfFiniteType _ _ h2 hlft
    obtain ⟨φ, hφeq⟩ := Spec.map_surjective
      ((wcGeomPoint K X hX).left.fromSpecResidueField xb ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    have h4 : LocallyOfFiniteType (Spec.map φ) := by rw [hφeq]; exact h3
    have hφ : φ.hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h4
    letI : Algebra (AlgebraicClosure K)
        (IsLocalRing.ResidueField ((wcGeomPoint K X hX).left.presheaf.stalk xb)) :=
      φ.hom.toAlgebra
    haveI : Algebra.FiniteType (AlgebraicClosure K)
        (IsLocalRing.ResidueField ((wcGeomPoint K X hX).left.presheaf.stalk xb)) :=
      RingHom.finiteType_algebraMap.mp hφ
    haveI : Module.Finite (AlgebraicClosure K)
        (IsLocalRing.ResidueField ((wcGeomPoint K X hX).left.presheaf.stalk xb)) :=
      finite_of_finite_type_of_isJacobsonRing (AlgebraicClosure K) _
    haveI : Algebra.IsIntegral (AlgebraicClosure K)
        (IsLocalRing.ResidueField ((wcGeomPoint K X hX).left.presheaf.stalk xb)) :=
      Algebra.IsIntegral.of_finite (AlgebraicClosure K) _
    have hb := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := AlgebraicClosure K)
      (K := IsLocalRing.ResidueField ((wcGeomPoint K X hX).left.presheaf.stalk xb))
    haveI : IsAlgClosed
        (IsLocalRing.ResidueField ((wcGeomPoint K X hX).left.presheaf.stalk xb)) :=
      IsAlgClosed.of_ringEquiv (AlgebraicClosure K) _ (RingEquiv.ofBijective _ hb)
    infer_instance
  ·
    intro Th g hfib
    obtain ⟨τ, hτ⟩ : ∃ τ : (wcGeomPoint K X hX).left.residueField xb ⟶
        CommRingCat.of (AlgebraicClosure K),
        Spec.map τ ≫ (wcGeomPoint K X hX).left.fromSpecResidueField xb = ub := by
      rw [hxb]
      exact ⟨_, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ _ ub⟩
    haveI := hfib
    have hfibAux : ∀ t (_ : Spec.map τ ≫
        (wcGeomPoint K X hX).left.fromSpecResidueField xb = t),
        IsIso (Limits.pullback.snd g.left t) := by
      rintro t rfl
      have h2 : Limits.pullback.snd g.left (Spec.map τ ≫
          (wcGeomPoint K X hX).left.fromSpecResidueField xb) =
          (Limits.pullbackLeftPullbackSndIso g.left
            ((wcGeomPoint K X hX).left.fromSpecResidueField xb) (Spec.map τ)).inv ≫
            Limits.pullback.snd (Limits.pullback.snd g.left
              ((wcGeomPoint K X hX).left.fromSpecResidueField xb)) (Spec.map τ) := by
        rw [← Limits.pullbackLeftPullbackSndIso_hom_snd, Iso.inv_hom_id_assoc]
      rw [h2]
      infer_instance
    haveI : IsIso (Limits.pullback.snd g.left ub) := hfibAux ub hτ
    have hpaste := IsPullback.paste_vert (IsPullback.of_hasPullback g.left ub) hsq
    have hw : g.left ≫ (wcGeomPoint K X hX).hom = Th.hom := MorphismProperty.Over.w g
    have key : ∃ ε : Limits.pullback (g.left ≫ (wcGeomPoint K X hX).hom) s ≅
        Spec (.of (AlgebraicClosure K)),
        ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
          Limits.pullback.snd (g.left ≫ (wcGeomPoint K X hX).hom) s := by
      refine ⟨hpaste.isoPullback.symm ≪≫ asIso (Limits.pullback.snd g.left ub), ?_⟩
      show (hpaste.isoPullback.inv ≫ Limits.pullback.snd g.left ub) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
        Limits.pullback.snd (g.left ≫ (wcGeomPoint K X hX).hom) s
      have e := hpaste.isoPullback_hom_snd
      exact (Category.assoc _ _ _).trans ((congrArg (hpaste.isoPullback.inv ≫ ·) e.symm).trans
        (Iso.inv_hom_id_assoc _ _))
    rw [hw] at key
    exact key

theorem wc_P1bar_point_removal_chain (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)) (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _) (hSinj : Function.Injective (fun i => S i (IsLocalRing.closedPoint F''))) : ∃ (U : ℕ → (wcP1Over F'').left.ProEt) (ι : ∀ i, U (i + 1) ⟶ U i) (x : ∀ i, (U i).left) (e0 : U 0 ≅ wcGeomPoint F'' (wcP1Over F'') hP) (u' : U m ⟶ wcGeomPoint F'' (wcP1Over F'') hP), IsOpenImmersion u'.left ∧ Set.range u'.left = {p | ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ S i (IsLocalRing.closedPoint F'')} ∧ (∀ j : Fin m, IsClosed ({S j (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left)) ∧ ∀ (i : ℕ) (hi : i < m), IsOpenImmersion (ι i).left ∧ Set.range (ι i).left = {x i}ᶜ ∧ IsLocallyNoetherian (U i).left ∧ QuasiSeparatedSpace (U i).left ∧ IsSepClosed (IsLocalRing.ResidueField ((U i).left.presheaf.stalk (x i))) ∧ ∀ u : (U i).left, (U i).hom u = S ⟨i, hi⟩ (IsLocalRing.closedPoint F'') ↔ u = x i :=
by
  classical

  have key : ∀ (Pb : (wcP1Over F'').left.ProEt) (s : Fin m → (wcP1Over F'').left),
      Function.Injective s → (∀ j, IsClosed ({s j} : Set (wcP1Over F'').left)) →
      (∀ j, ∃ xb : Pb.left, (∀ p, Pb.hom p = s j ↔ p = xb) ∧ IsLocallyNoetherian Pb.left ∧
        QuasiSeparatedSpace Pb.left) →
      (∃ q : Pb.left, ∀ j, Pb.hom q ≠ s j) →
      (∃ pr : Pb.left ⟶ Spec (CommRingCat.of (AlgebraicClosure F'')), LocallyOfFiniteType pr) →
      ∃ (U : ℕ → (wcP1Over F'').left.ProEt) (ι : ∀ i, U (i + 1) ⟶ U i) (x : ∀ i, (U i).left)
        (e0 : U 0 ≅ Pb) (u' : U m ⟶ Pb), IsOpenImmersion u'.left ∧
        Set.range u'.left = {p | ∀ i : Fin m, Pb.hom p ≠ s i} ∧
        ∀ (i : ℕ) (hi : i < m), IsOpenImmersion (ι i).left ∧ Set.range (ι i).left = {x i}ᶜ ∧
          IsLocallyNoetherian (U i).left ∧ QuasiSeparatedSpace (U i).left ∧
          IsSepClosed (IsLocalRing.ResidueField ((U i).left.presheaf.stalk (x i))) ∧
          ∀ u : (U i).left, (U i).hom u = s ⟨i, hi⟩ ↔ u = x i := by
    intro Pb s hsinj hcl hfib hq0 hLOFT
    obtain ⟨q, hq⟩ := hq0
    obtain ⟨pr, hpr⟩ := hLOFT
    choose xb hF hLN hQS using hfib
    have hopen : ∀ i : ℕ, IsOpen {p : Pb.left | ∀ j : Fin m, j.val < i → Pb.hom p ≠ s j} := by
      intro i
      have e : {p : Pb.left | ∀ j : Fin m, j.val < i → Pb.hom p ≠ s j} =
          ⋂ j : Fin m, Pb.hom ⁻¹' {y | j.val < i → y ≠ s j} := by
        ext p; simp
      rw [e]
      refine isOpen_iInter_of_finite fun j => ?_
      refine IsOpen.preimage (Scheme.Hom.continuous _) ?_
      by_cases hj : j.val < i
      · have e' : {s j}ᶜ = {y | j.val < i → y ≠ s j} := by ext y; simp [hj]
        have h := isOpen_compl_iff.mpr (hcl j)
        rw [e'] at h
        exact h
      · have e' : Set.univ = {y | j.val < i → y ≠ s j} := by ext y; simp [hj]
        have h := (isOpen_univ : IsOpen (Set.univ : Set (wcP1Over F'').left))
        rw [e'] at h
        exact h
    let O : ℕ → Pb.left.Opens := fun i => ⟨_, hopen i⟩
    have hmemO : ∀ (i : ℕ) (p : Pb.left), p ∈ O i ↔ ∀ j : Fin m, j.val < i → Pb.hom p ≠ s j :=
      fun i p => Iff.rfl
    have hle : ∀ i, O (i + 1) ≤ O i := by
      intro i p hp
      rw [hmemO] at hp ⊢
      exact fun j hj => hp j (by omega)
    have hxbO : ∀ (i : ℕ) (hi : i < m), xb ⟨i, hi⟩ ∈ O i := by
      intro i hi
      rw [hmemO]
      intro j hj h
      have h' : s ⟨i, hi⟩ = s j := ((hF ⟨i, hi⟩ (xb ⟨i, hi⟩)).mpr rfl).symm.trans h
      have h2 : i = j.val := congrArg Fin.val (hsinj h')
      omega
    have hqO : ∀ i, q ∈ O i := fun i => (hmemO i q).mpr fun j _ => hq j
    let U : ℕ → (wcP1Over F'').left.ProEt := fun i => wcVRes _ Pb (O i)
    let ι : ∀ i, U (i + 1) ⟶ U i := fun i =>
      MorphismProperty.Over.homMk (Pb.left.homOfLE (hle i))
        (by
          show Pb.left.homOfLE (hle i) ≫ (O i).ι ≫ Pb.hom = (O (i + 1)).ι ≫ Pb.hom
          rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
    let x : ∀ i, (U i).left := fun i =>
      if hi : i < m then (⟨xb ⟨i, hi⟩, hxbO i hi⟩ : O i) else (⟨q, hqO i⟩ : O i)
    haveI hiso : IsIso (O 0).ι := by
      rw [isIso_iff_isOpenImmersion_and_surjective]
      refine ⟨inferInstance, ⟨fun p => ⟨(⟨p, (hmemO 0 p).mpr fun j hj =>
        absurd hj (Nat.not_lt_zero _)⟩ : O 0), Scheme.Opens.ι_apply _ _⟩⟩⟩
    let e0 : U 0 ≅ Pb := MorphismProperty.Over.isoMk (@asIso _ _ _ _ (O 0).ι hiso) (by rfl)
    let u' : U m ⟶ Pb := MorphismProperty.Over.homMk (O m).ι rfl trivial
    refine ⟨U, ι, x, e0, u', ?_, ?_, ?_⟩
    · show IsOpenImmersion (O m).ι
      infer_instance
    · show Set.range (O m).ι = _
      rw [Scheme.Opens.range_ι]
      ext p
      exact Iff.intro (fun h j => ((hmemO m p).mp h) j j.isLt)
        (fun h => (hmemO m p).mpr fun j _ => h j)
    · intro i hi
      have hxi : x i = (⟨xb ⟨i, hi⟩, hxbO i hi⟩ : O i) := dif_pos hi
      have hιx : (O i).ι (x i) = xb ⟨i, hi⟩ := by
        rw [hxi]; exact Scheme.Opens.ι_apply _ _
      have hinj : Function.Injective (O i).ι :=
        (Scheme.Hom.isOpenEmbedding (O i).ι).isEmbedding.injective
      haveI := hLN ⟨i, hi⟩
      haveI := hQS ⟨i, hi⟩
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
      · show IsOpenImmersion (Pb.left.homOfLE (hle i))
        infer_instance
      · show Set.range (Pb.left.homOfLE (hle i)) = {x i}ᶜ
        ext z
        constructor
        · rintro ⟨w, rfl⟩ h
          have h0 : Pb.left.homOfLE (hle i) w = x i := h
          have h1 : (O i).ι (Pb.left.homOfLE (hle i) w) = xb ⟨i, hi⟩ := by rw [h0, hιx]
          rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι] at h1
          have hw : (O (i + 1)).ι w ∈ O (i + 1) := by
            have : (O (i + 1)).ι w ∈ Set.range (O (i + 1)).ι := ⟨w, rfl⟩
            rw [Scheme.Opens.range_ι] at this
            exact this
          exact (hmemO (i + 1) _).mp hw ⟨i, hi⟩ (Nat.lt_succ_self i) ((hF ⟨i, hi⟩ _).mpr h1)
        · intro hz
          have hz' : (O i).ι z ≠ xb ⟨i, hi⟩ := fun h => hz (hinj (h.trans hιx.symm))
          have hzO : (O i).ι z ∈ O i := by
            have : (O i).ι z ∈ Set.range (O i).ι := ⟨z, rfl⟩
            rw [Scheme.Opens.range_ι] at this
            exact this
          have hmem : (O i).ι z ∈ O (i + 1) := by
            rw [hmemO]
            intro j hj
            by_cases hji : j.val < i
            · exact (hmemO i _).mp hzO j hji
            · have hj' : j = ⟨i, hi⟩ := Fin.ext (by show j.val = i; omega)
              subst hj'
              exact fun h => hz' ((hF _ _).mp h)
          refine ⟨(⟨(O i).ι z, hmem⟩ : O (i + 1)), hinj ?_⟩
          exact (Scheme.Opens.ι_apply _ _).trans (Scheme.homOfLE_apply _ _)
      · show IsLocallyNoetherian (O i).toScheme
        exact isLocallyNoetherian_of_isOpenImmersion (O i).ι
      · show QuasiSeparatedSpace (O i).toScheme
        exact (Scheme.Hom.isOpenEmbedding (O i).ι).quasiSeparatedSpace
      · have hcl_x : IsClosed ({x i} : Set (O i).toScheme) := by
          have e : ({x i} : Set (O i).toScheme) = (O i).ι ⁻¹' (Pb.hom ⁻¹' {s ⟨i, hi⟩}) := by
            ext z
            constructor
            · intro h
              have h' : z = x i := h
              exact (hF _ _).mpr (by rw [h', hιx])
            · intro h
              exact hinj (((hF ⟨i, hi⟩ ((O i).ι z)).mp h).trans hιx.symm)
          rw [e]
          exact ((hcl ⟨i, hi⟩).preimage (Scheme.Hom.continuous _)).preimage
            (Scheme.Hom.continuous _)
        haveI hpr' : LocallyOfFiniteType pr := hpr
        haveI hιL : LocallyOfFiniteType (O i).ι := inferInstance
        haveI hcompL : LocallyOfFiniteType ((O i).ι ≫ pr) :=
          MorphismProperty.comp_mem _ _ _ hιL hpr'
        haveI : IsAlgClosed (IsLocalRing.ResidueField ((U i).left.presheaf.stalk (x i))) :=
          @wc_lfi_closed_point_residue_algClosed (AlgebraicClosure F'') _ _ (U i).left
            ((O i).ι ≫ pr) hcompL (x i) hcl_x
        exact IsSepClosed.of_isAlgClosed _
      · intro u
        have hcomp : (U i).hom u = Pb.hom ((O i).ι u) := Scheme.Hom.comp_apply _ _ _
        rw [hcomp]
        exact ⟨fun h => hinj (((hF _ _).mp h).trans hιx.symm),
          fun h => (hF _ _).mpr (by rw [h, hιx])⟩

  haveI hprop : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  have hclosed : ∀ j : Fin m,
      IsClosed ({S j (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) := by
    intro j
    haveI : IsProper (S j ≫ (wcP1Over F'').hom) := by rw [hS j]; infer_instance
    haveI : IsProper (S j) := IsProper.of_comp (S j) (wcP1Over F'').hom
    have h1 : Set.range (S j) = {S j (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        exact Set.mem_singleton_iff.mpr (congrArg _ (Subsingleton.elim _ _))
      · intro hy
        exact ⟨_, hy.symm⟩
    rw [← h1]
    exact (Scheme.Hom.isClosedMap (S j)).isClosed_range
  have hfib : ∀ j : Fin m, ∃ xb : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ p, (wcGeomPoint F'' (wcP1Over F'') hP).hom p = S j (IsLocalRing.closedPoint F'') ↔
        p = xb) ∧
      IsLocallyNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left ∧
      QuasiSeparatedSpace (wcGeomPoint F'' (wcP1Over F'') hP).left := by
    intro j
    obtain ⟨xb, -, h2, h3, h4, -⟩ := wc_pmod_geom_point_local_data F'' (wcP1Over F'') hprop
      (S j) (hS j) ⟨{S j (IsLocalRing.closedPoint F'')}ᶜ, isOpen_compl_iff.mpr (hclosed j)⟩ rfl hP
    refine ⟨xb, fun p => ?_, h3, h4⟩
    have := Set.ext_iff.mp h2 p
    simpa using this
  haveI : IrreducibleSpace (wcP1Over F'').left := wc_proj_space_irreducible F'' 1
  have hnc := wc_top_irreducible_dim_one_ncard (wcP1Over F'').left (wc_proj_space_dim F'' 1)
  obtain ⟨η, hη⟩ := Set.ncard_eq_one.mp hnc
  have hηnc : ¬ IsClosed ({η} : Set (wcP1Over F'').left) := by
    have hm : η ∈ ({η} : Set (wcP1Over F'').left) := rfl
    rw [← hη] at hm
    exact hm
  obtain ⟨p0, hp0, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := (wcP1Over F'').hom)
    (g := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
    η (IsLocalRing.closedPoint (AlgebraicClosure F''))
    (Subsingleton.elim (α := ↥(Spec (CommRingCat.of F''))) _ _)
  have hq : ∃ q : (wcGeomPoint F'' (wcP1Over F'') hP).left, ∀ j : Fin m,
      (wcGeomPoint F'' (wcP1Over F'') hP).hom q ≠ S j (IsLocalRing.closedPoint F'') := by
    refine ⟨p0, fun j h => hηnc ?_⟩
    have h' : η = S j (IsLocalRing.closedPoint F'') := hp0.symm.trans h
    rw [h']; exact hclosed j
  have hLOFT : ∃ pr : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      Spec (CommRingCat.of (AlgebraicClosure F'')), LocallyOfFiniteType pr :=
    ⟨Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))),
      by exact (inferInstance : LocallyOfFiniteType (Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) ⟩
  obtain ⟨U, ι, x, e0, u', h1, h2, h3⟩ :=
    key _ (fun j => S j (IsLocalRing.closedPoint F'')) hSinj hclosed hfib hq hLOFT
  exact ⟨U, ι, x, e0, u', h1, h2, hclosed, h3⟩

theorem wc_qcfin_offS_restrict (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left))
    (hS : ∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p) :
    ∃ (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens),
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          S i (IsLocalRing.closedPoint F'')) ∧
      AlgebraicGeometry.IsNoetherian Ub.toScheme ∧
      ∃ (V : (wcP1Over F'').left.ProEt) (ι : V ⟶ W) (pV : V.left ⟶ Ub.toScheme),
        pV ≫ Ub.ι = ι.left ≫ w.left ∧ ConnectedSpace V.left ∧
        Surjective pV ∧ WeaklyEtale pV ∧ QuasiCompact pV ∧
        ∀ (Z : (wcP1Over F'').left.ProEt) (a : Z ⟶ W),
          (∀ z : Z.left, w.left (a.left z) ∈ Ub) → ∃ a' : Z ⟶ V, a' ≫ ι = a :=
by
  classical
  obtain ⟨Ub, hUb, hUconn, hUcpt, -, -⟩ := wc_P1bar_smooth_locus F'' hP m S hS
  haveI hirr : IrreducibleSpace W.left :=
    wc_proet_P1bar_qc_conn_irreducible F'' hP W w hqc hconn

  have hLN : IsLocallyNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left := by
    haveI : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
    show IsLocallyNoetherian (Limits.pullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    exact LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd _ _)
  have hNoeth : AlgebraicGeometry.IsNoetherian Ub.toScheme := by
    haveI := hLN
    haveI := hUcpt
    exact AlgebraicGeometry.IsNoetherian.mk

  let O : W.left.Opens := w.left ⁻¹ᵁ Ub
  haveI hWe : WeaklyEtale W.hom := W.prop
  have hV : WeaklyEtale (O.ι ≫ W.hom) := inferInstance
  let V : (wcP1Over F'').left.ProEt := MorphismProperty.Over.mk ⊤ (O.ι ≫ W.hom) hV
  let ι : V ⟶ W := MorphismProperty.Over.homMk (A := V) (B := W) O.ι rfl trivial
  have hsq : (w.left ∣_ Ub) ≫ Ub.ι = O.ι ≫ w.left := morphismRestrict_ι w.left Ub
  have hwl : WeaklyEtale w.left := by
    have h1 : WeaklyEtale (w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
      rw [MorphismProperty.Over.w w]; exact W.prop
    exact @WeaklyEtale.of_comp _ _ _ w.left (wcGeomPoint F'' (wcP1Over F'') hP).hom h1
      (wcGeomPoint F'' (wcP1Over F'') hP).prop
  have hpb : IsPullback O.ι (w.left ∣_ Ub) w.left Ub.ι :=
    (isPullback_morphismRestrict w.left Ub).flip
  have hpVw : WeaklyEtale (w.left ∣_ Ub) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hwl
  have hpVq : QuasiCompact (w.left ∣_ Ub) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hpb hqc

  haveI := hUconn
  obtain ⟨u₀⟩ := (ConnectedSpace.toNonempty : Nonempty Ub.toScheme)
  obtain ⟨z₀, hz₀⟩ := hsurj u₀.1 ((hUb u₀.1).mp u₀.2)
  have hz₀O : z₀ ∈ O := by
    show w.left z₀ ∈ Ub
    rw [hz₀]; exact u₀.2
  have hVc : ConnectedSpace V.left := by
    have h1 : IsPreirreducible (O : Set W.left) :=
      (IrreducibleSpace.isIrreducible_univ W.left).2.open_subset O.isOpen (Set.subset_univ _)
    have h2 : IsIrreducible (O : Set W.left) := ⟨⟨z₀, hz₀O⟩, h1⟩
    exact isConnected_iff_connectedSpace.mp h2.isConnected

  have hpVs : Surjective (w.left ∣_ Ub) := by
    refine ⟨fun u => ?_⟩
    obtain ⟨z, hz⟩ := hsurj u.1 ((hUb u.1).mp u.2)
    have hzO : z ∈ O := by
      show w.left z ∈ Ub
      rw [hz]; exact u.2
    refine ⟨⟨z, hzO⟩, ?_⟩
    apply Ub.ι.isOpenEmbedding.injective
    have e1 : Ub.ι ((w.left ∣_ Ub) ⟨z, hzO⟩) = w.left (O.ι ⟨z, hzO⟩) :=
      (Scheme.Hom.comp_apply (w.left ∣_ Ub) Ub.ι ⟨z, hzO⟩).symm.trans
        (by rw [hsq]; exact Scheme.Hom.comp_apply _ _ _)
    rw [e1, Scheme.Opens.ι_apply]
    exact hz.trans (Scheme.Opens.ι_apply Ub u).symm

  have hlift : ∀ (Z : (wcP1Over F'').left.ProEt) (a : Z ⟶ W),
      (∀ z : Z.left, w.left (a.left z) ∈ Ub) → ∃ a' : Z ⟶ V, a' ≫ ι = a := by
    intro Z a ha
    have hr : Set.range a.left ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      exact ha z
    let b : Z.left ⟶ O.toScheme := IsOpenImmersion.lift O.ι a.left hr
    have hb : b ≫ V.hom = Z.hom := by
      show IsOpenImmersion.lift O.ι a.left hr ≫ (O.ι ≫ W.hom) = Z.hom
      rw [← Category.assoc, IsOpenImmersion.lift_fac]
      exact MorphismProperty.Over.w a
    refine ⟨MorphismProperty.Over.homMk (A := Z) (B := V) b hb trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact IsOpenImmersion.lift_fac O.ι a.left hr
  exact ⟨Ub, hUb, hNoeth, V, ι, w.left ∣_ Ub, hsq, hVc, hpVs, hpVw, hpVq, hlift⟩

theorem wc_qcfin_frame_base_cocycle : ∀ (S : Scheme.{u}) (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
