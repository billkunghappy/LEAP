      Spec.map (CommRingCat.ofHom (IsLocalRing.residue Ac)) w = IsLocalRing.closedPoint Ac := by
    intro w
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue Ac))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField Ac)) w _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue Ac)).mp inferInstance)
  have hacl : ac (IsLocalRing.closedPoint Ac) = D.S i (IsLocalRing.closedPoint F'') := by
    have key : ∀ x₀ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField
