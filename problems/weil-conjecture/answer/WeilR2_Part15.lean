    have hnat : ∀ m : ℕ, wcLadicScalar (wcP1Over F'').left ℓ (m : ℚ_[ℓ]) =
        m • 𝟙 (wcLadicSheaf (wcP1Over F'').left ℓ) := by
      intro m
      induction m with
      | zero => rw [Nat.cast_zero, zero_nsmul, hs0]
      | succ m ih => rw [Nat.cast_succ, hadd, ih, hs1, succ_nsmul]
    have hcomp : ∀ m : ℕ, x.comp (Abelian.Ext.mk₀ (m • 𝟙 (wcLadicSheaf (wcP1Over F'').left ℓ)))
