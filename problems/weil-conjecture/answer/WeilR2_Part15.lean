      let Einv : Φ.fiber.Elements ⥤
          StructuredArrow (Over.mk (wcEtGeomPt Z y)) (Scheme.Etale.forget Z) :=
        { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget Z) (Y := x.1) x.2
          map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
