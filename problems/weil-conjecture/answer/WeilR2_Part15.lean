  have hres : ∀ (T T' : S.ProEt) (k₀ : T' ⟶ T) (x : G.obj.obj (Opposite.op T)),
      Cond T x → Cond T' ((G.obj.map k₀.op).hom x) := by
    intro T T' k₀ x hx V h h' z i
    have e : (G.obj.map h.op).hom ((G.obj.map k₀.op).hom x) = (G.obj.map (h ≫ k₀).op).hom x := by
      rw [op_comp, G.obj.map_comp]
      rfl
    show ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
      ((G.obj.map h.op).hom ((G.obj.map k₀.op).hom x))).down) z) i‖ ≤ 1
    rw [e]
    exact hx V (h ≫ k₀) h' z i
  have hloc : ∀ (T : S.ProEt) (x : G.obj.obj (Opposite.op T)) (R : Sieve T),
      R ∈ Scheme.ProEt.topology S T →
      (∀ (Y : S.ProEt) (f : Y ⟶ T), R.arrows f → Cond Y ((G.obj.map f.op).hom x)) →
      Cond T x := by
