      AddCommGrpCat.{u+1}) := HasExt.standard _
    have h := wc_et_cd_proper_torsion (AlgebraicClosure (B.residueField b))
      (Limits.pullback g (wcEtGeomPt B b)) (Limits.pullback.snd g (wcEtGeomPt B b)) d (hfib b) m
      hΩ _ (hMn _) q hq
