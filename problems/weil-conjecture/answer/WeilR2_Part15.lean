    have gen : ∀ {A B C D : AddCommGrpCat.{u+1}} (a : A ⟶ B) (b : B ⟶ D) (c : A ⟶ C)
        (g : C ⟶ D), IsIso a → IsIso b → IsIso c → a ≫ b = c ≫ g → IsIso g := by
      intro A B C D a b c g ha hb hc hw
      have hg : g = inv c ≫ a ≫ b := by rw [hw, IsIso.inv_hom_id_assoc]
      rw [hg]
