  have hU2 : ∀ p, p ≠ m →
      fm (wcQmdlCX A' n π' c' m (some p)) * fl (wcQmdlCX A' n π' c' l (some m)) =
        fl (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) := by
    intro p hp
    show rm (χ m (wcQmdlCX A' n π' c' m (some p))) * rl (χ l (wcQmdlCX A' n π' c' l (some m))) =
      rl (χ l (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)))
    rw [hXm3 p hp, hu, hC3 p.castSucc, mul_right_comm, hC4, one_mul]
    by_cases hpl : p = l
    · have hH : wcQmbtChartHat l p = (1 : MvPolynomial (Option (Fin n)) A') := if_pos hpl
      rw [hH]
      simp only [map_one]
      rw [hpl, hC1, map_one]
    · have hH : wcQmbtChartHat l p = (MvPolynomial.X (some p) : MvPolynomial (Option (Fin n)) A') :=
        if_neg hpl
      rw [hH]
      exact congrArg rl (hXl3 p hpl).symm

  let Λ₀ : Localization.Away (wcQmdlCX A' n π' c' l (some m)) →+*
