  obtain ⟨E₀, hEp, hEs, jE, a, hjE, hjEY, ha, hEG, e, he, hre⟩ :=
    wc_qmbt_csz_Y_quadric_model hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hbl hblf hps'
  haveI := hEp
  haveI := hEs
