  have hs := wc_slice_vanSub_theta_locSurj S V C hC n F ι hm hF θ hθ
  have hi := wc_slice_vanSub_theta_locInj S V C n F ι θ hθ
  obtain ⟨e⟩ := wc_epsInv_iso_of_lan_criterion V.left (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n)
    ((wcLpscG S V).obj F) θ hs hi
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}} (e : B ≅ B'),
