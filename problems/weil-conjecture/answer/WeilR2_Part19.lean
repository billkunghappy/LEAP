theorem injRes_extClass_comp_extMk : ∀ {C : Type*} [Category C] [Abelian C] {A : C} (I : InjectiveResolution A) (S : ShortComplex C) (hS : S.ShortExact) (n : ℕ) (h₁ : S.X₁ ⟶ I.cocomplex.X n) (h₂ : S.X₂ ⟶ I.cocomplex.X n) (h₃ : S.X₃ ⟶ I.cocomplex.X (n + 1)) (hc₁ : h₁ ≫ I.cocomplex.d n (n + 1) = 0) (hc₃ : h₃ ≫ I.cocomplex.d (n + 1) (n + 1 + 1) = 0), S.f ≫ h₂ = h₁ → h₂ ≫ I.cocomplex.d n (n + 1) = S.g ≫ h₃ → letI := HasExt.standard C; hS.extClass.comp (I.extMk h₁ (n + 1) rfl hc₁) (add_comm 1 n) = I.extMk h₃ (n + 1 + 1) rfl hc₃ ∨ hS.extClass.comp (I.extMk h₁ (n + 1) rfl hc₁) (add_comm 1 n) = -I.extMk h₃ (n + 1 + 1) rfl hc₃ :=
by
  open CochainComplex.HomComplex CochainComplex.mappingCone in
  · intro C _ _ A I S hS n h₁ h₂ h₃ hc₁ hc₃ e1 e2

    have ext0 : ∀ {X : C} {K : CochainComplex C ℤ} {m : ℤ}
        (α β : Cochain ((CochainComplex.singleFunctor C 0).obj X) K m),
        α.v 0 m (zero_add m) = β.v 0 m (zero_add m) → α = β := by
      intro X K m α β h
      ext p q hpq
      by_cases hp : p = 0
      · subst hp
        obtain rfl : q = m := by omega
        exact h
      · exact (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 X p hp).eq_of_src _ _

    have uf0 : ∀ (X : C) (L : CochainComplex C ℤ) (n n' : ℤ) (h : n + 1 = n') (k : X ⟶ L.X n)
        (hk : k ≫ L.d n n' = 0),
        (Cocycle.equivHomShift.symm (Cocycle.fromSingleMk k (zero_add n) n' h hk)).f 0 =
          (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 X).hom ≫ k ≫
            (L.shiftFunctorObjXIso n 0 n (zero_add n).symm).inv := by
      intro X L n n' h k hk
      rw [Cocycle.equivHomShift_symm_apply, Cocycle.homOf_f, Cocycle.rightShift_coe,
        Cochain.rightShift_v _ _ _ _ _ _ _ n (zero_add n), Cocycle.fromSingleMk_coe,
        Cochain.fromSingleMk_v, Category.assoc]

    have A1 : ∀ (L : CochainComplex C ℤ) (n n' : ℤ) (h : n + 1 = n') (k₁ : S.X₁ ⟶ L.X n)
        (u₁ : (CochainComplex.singleFunctor C 0).obj S.X₁ ⟶
          (CategoryTheory.shiftFunctor (CochainComplex C ℤ) n).obj L),
        u₁.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 S.X₁).hom ≫ k₁ ≫
            (L.shiftFunctorObjXIso n 0 n (zero_add n).symm).inv →
        (inl (S.map (CochainComplex.singleFunctor C 0)).f).comp (Cochain.ofHom
          ((triangle (S.map (CochainComplex.singleFunctor C 0)).f).mor₃ ≫
            (CategoryTheory.shiftFunctor (CochainComplex C ℤ) (1 : ℤ)).map u₁ ≫
            (CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) n 1 n' h).inv.app L))
            (add_zero _) =
          -Cochain.fromSingleMk (k₁ ≫ (L.shiftFunctorObjXIso n' (-1) n (by omega)).inv)
            (show (0:ℤ) + -1 = -1 by norm_num) := by
      intro L n n' h k₁ u₁ hu₁
      apply ext0
      rw [Cochain.comp_zero_cochain_v, Cochain.ofHom_v, Cochain.neg_v, Cochain.fromSingleMk_v]
      change (inl (S.map (CochainComplex.singleFunctor C 0)).f).v 0 (-1) _ ≫
        ((triangle (S.map (CochainComplex.singleFunctor C 0)).f).mor₃.f (-1) ≫ u₁.f 0 ≫
          ((CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) n 1 n' h).inv.app L).f (-1)) = _
      erw [inl_v_triangle_mor₃_f_assoc]
      rw [CochainComplex.shiftFunctorAdd'_inv_app_f', hu₁]
      simp [CochainComplex.shiftFunctorObjXIso, HomologicalComplex.XIsoOfEq]
      erw [Preadditive.neg_comp, Category.id_comp, neg_inj, Category.assoc, Category.assoc,
        eqToHom_trans]
      rfl

    have B2 : ∀ (L : CochainComplex C ℤ) (n' : ℤ) (k₃ : S.X₃ ⟶ L.X n')
        (u₃ : (CochainComplex.singleFunctor C 0).obj S.X₃ ⟶
          (CategoryTheory.shiftFunctor (CochainComplex C ℤ) n').obj L),
        u₃.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 S.X₃).hom ≫ k₃ ≫
            (L.shiftFunctorObjXIso n' 0 n' (zero_add n').symm).inv →
        Cochain.ofHom (inr (S.map (CochainComplex.singleFunctor C 0)).f ≫
          descShortComplex (S.map (CochainComplex.singleFunctor C 0)) ≫ u₃) =
          Cochain.fromSingleMk (S.g ≫ k₃ ≫ (L.shiftFunctorObjXIso n' 0 n' (zero_add n').symm).inv)
            (show (0:ℤ) + 0 = 0 by norm_num) := by
      intro L n' k₃ u₃ hu₃
      apply ext0
      rw [Cochain.ofHom_v, Cochain.fromSingleMk_v, inr_descShortComplex_assoc]
      rw [HomologicalComplex.comp_f, ShortComplex.map_g, hu₃]
      erw [HomologicalComplex.single_map_f_self]
      simp

    have s1 : ∀ (L : CochainComplex C ℤ) (n n' : ℤ) (h : n + 1 = n')
        (k₁ : S.X₁ ⟶ L.X n) (k₂ : S.X₂ ⟶ L.X n) (k₃ : S.X₃ ⟶ L.X n')
        (u₁ : (CochainComplex.singleFunctor C 0).obj S.X₁ ⟶
          (CategoryTheory.shiftFunctor (CochainComplex C ℤ) n).obj L)
        (u₃ : (CochainComplex.singleFunctor C 0).obj S.X₃ ⟶
          (CategoryTheory.shiftFunctor (CochainComplex C ℤ) n').obj L),
        u₁.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 S.X₁).hom ≫ k₁ ≫
            (L.shiftFunctorObjXIso n 0 n (zero_add n).symm).inv →
        u₃.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 S.X₃).hom ≫ k₃ ≫
            (L.shiftFunctorObjXIso n' 0 n' (zero_add n').symm).inv →
        S.f ≫ k₂ = k₁ → k₂ ≫ L.d n n' = S.g ≫ k₃ →
        Nonempty (Homotopy ((triangle (S.map (CochainComplex.singleFunctor C 0)).f).mor₃ ≫
            (CategoryTheory.shiftFunctor (CochainComplex C ℤ) (1 : ℤ)).map u₁ ≫
            (CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) n 1 n' h).inv.app L)
          (descShortComplex (S.map (CochainComplex.singleFunctor C 0)) ≫ u₃)) ∨
        Nonempty (Homotopy ((triangle (S.map (CochainComplex.singleFunctor C 0)).f).mor₃ ≫
            (CategoryTheory.shiftFunctor (CochainComplex C ℤ) (1 : ℤ)).map u₁ ≫
            (CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) n 1 n' h).inv.app L)
          (-(descShortComplex (S.map (CochainComplex.singleFunctor C 0)) ≫ u₃))) := by
      intro L n n' h k₁ k₂ k₃ u₁ u₃ hu₁ hu₃ f1 f2
      have hA1 := A1 L n n' h k₁ u₁ hu₁
      have hB2 := B2 L n' k₃ u₃ hu₃
      have hA2 : Cochain.ofHom (inr (S.map (CochainComplex.singleFunctor C 0)).f ≫
          (triangle (S.map (CochainComplex.singleFunctor C 0)).f).mor₃ ≫
            (CategoryTheory.shiftFunctor (CochainComplex C ℤ) (1 : ℤ)).map u₁ ≫
            (CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) n 1 n' h).inv.app L) = 0 := by
        have h0 : inr (S.map (CochainComplex.singleFunctor C 0)).f ≫
            (triangle (S.map (CochainComplex.singleFunctor C 0)).f).mor₃ ≫
            (CategoryTheory.shiftFunctor (CochainComplex C ℤ) (1 : ℤ)).map u₁ ≫
            (CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) n 1 n' h).inv.app L = 0 := by
          ext p
          rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f_apply]
          erw [inr_f_triangle_mor₃_f_assoc]
          exact Limits.zero_comp
        rw [h0, Cochain.ofHom_zero]
      have hB1 : (inl (S.map (CochainComplex.singleFunctor C 0)).f).comp (Cochain.ofHom
          (descShortComplex (S.map (CochainComplex.singleFunctor C 0)) ≫ u₃)) (add_zero _) = 0 := by
        ext p q hpq
        rw [Cochain.comp_zero_cochain_v, Cochain.ofHom_v, Cochain.zero_v, HomologicalComplex.comp_f]
        erw [inl_v_descShortComplex_f_assoc]
        exact Limits.zero_comp
      let ι : L.X n ⟶ ((CategoryTheory.shiftFunctor (CochainComplex C ℤ) n').obj L).X (-1) :=
        (L.shiftFunctorObjXIso n' (-1) n (by omega)).inv
      let γ₂ : Cochain (S.map (CochainComplex.singleFunctor C 0)).X₂
          ((CategoryTheory.shiftFunctor (CochainComplex C ℤ) n').obj L) (-1) :=
        -Cochain.fromSingleMk (k₂ ≫ ι) (show (0:ℤ) + -1 = -1 by norm_num)
      have hφγ : (Cochain.ofHom (S.map (CochainComplex.singleFunctor C 0)).f).comp γ₂
          (zero_add _) = -Cochain.fromSingleMk (k₁ ≫ (L.shiftFunctorObjXIso n' (-1) n (by omega)).inv)
            (show (0:ℤ) + -1 = -1 by norm_num) := by
        simp only [γ₂, Cochain.comp_neg, neg_inj]
        rw [← f1, Category.assoc]
        exact (Cochain.fromSingleMk_precomp S.f (k₂ ≫ ι) _).symm
      have hdM : (k₂ ≫ ι) ≫ ((CategoryTheory.shiftFunctor (CochainComplex C ℤ) n').obj L).d (-1) 0 =
          n'.negOnePow • (S.g ≫ k₃ ≫ (L.shiftFunctorObjXIso n' 0 n' (zero_add n').symm).inv) := by
        rw [CochainComplex.shiftFunctor_obj_d', Category.assoc, Linear.comp_units_smul,
          Linear.comp_units_smul]
        congr 1
        simp only [ι, CochainComplex.shiftFunctorObjXIso]
        rw [HomologicalComplex.XIsoOfEq_inv_comp_d,
          ← HomologicalComplex.d_comp_XIsoOfEq_inv L (show 0 + n' = n' by omega) n,
          ← Category.assoc, f2, Category.assoc]
      have hδ : δ (-1) 0 γ₂ = -Cochain.fromSingleMk ((k₂ ≫ ι) ≫
          ((CategoryTheory.shiftFunctor (CochainComplex C ℤ) n').obj L).d (-1) 0)
            (show (0:ℤ) + 0 = 0 by norm_num) := by
        simp only [γ₂, δ_neg]
        rw [Cochain.δ_fromSingleMk _ _ 0 0 (by norm_num)]
      rcases Int.units_eq_one_or n'.negOnePow with hε | hε
      · refine Or.inl ⟨descHomotopy _ _ _ 0 γ₂ (hA1.trans ?_) (hA2.trans ?_)⟩
        · erw [hB1, δ_zero, hφγ]
          abel
        · erw [hB2, hδ, hdM, hε, one_smul, neg_add_cancel]
      · have hB1' : (inl (S.map (CochainComplex.singleFunctor C 0)).f).comp (Cochain.ofHom
            (-(descShortComplex (S.map (CochainComplex.singleFunctor C 0)) ≫ u₃))) (add_zero _) =
              0 := by
          rw [Cochain.ofHom_neg, Cochain.comp_neg, hB1, neg_zero]
        refine Or.inr ⟨descHomotopy _ _ _ 0 γ₂ (hA1.trans ?_) (hA2.trans ?_)⟩
        · erw [hB1', δ_zero, hφγ]
          abel
        · erw [Preadditive.comp_neg, Cochain.ofHom_neg, hB2, hδ, hdM, hε, Units.neg_smul, one_smul,
            Cochain.fromSingleMk_neg, neg_neg, add_neg_cancel]

    letI := HasDerivedCategory.standard C
    letI : HasExt C := HasExt.standard C
    have hnn : (n : ℤ) + 1 = ((n + 1 : ℕ) : ℤ) := by push_cast; rfl
    have hnn' : ((n + 1 : ℕ) : ℤ) + 1 = ((n + 1 + 1 : ℕ) : ℤ) := by push_cast; rfl
    have hz₁ : (h₁ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).inv) ≫
        I.cochainComplex.d (n : ℤ) ((n + 1 : ℕ) : ℤ) = 0 := by
      rw [I.cochainComplex_d _ _ n (n + 1) rfl rfl, Category.assoc, Iso.inv_hom_id_assoc,
        reassoc_of% hc₁, Limits.zero_comp]
    have hz₃ : (h₃ ≫ (I.cochainComplexXIso ((n + 1 : ℕ) : ℤ) (n + 1) rfl).inv) ≫
        I.cochainComplex.d ((n + 1 : ℕ) : ℤ) ((n + 1 + 1 : ℕ) : ℤ) = 0 := by
      rw [I.cochainComplex_d _ _ (n + 1) (n + 1 + 1) rfl rfl, Category.assoc, Iso.inv_hom_id_assoc,
        reassoc_of% hc₃, Limits.zero_comp]
    have f1 : S.f ≫ (h₂ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).inv) =
        h₁ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).inv := by
      rw [← Category.assoc, e1]
    have f2 : (h₂ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).inv) ≫
        I.cochainComplex.d (n : ℤ) ((n + 1 : ℕ) : ℤ) =
        S.g ≫ (h₃ ≫ (I.cochainComplexXIso ((n + 1 : ℕ) : ℤ) (n + 1) rfl).inv) := by
      rw [I.cochainComplex_d _ _ n (n + 1) rfl rfl, Category.assoc, Iso.inv_hom_id_assoc,
        reassoc_of% e2]
    have hu₁ := uf0 S.X₁ I.cochainComplex (n : ℤ) ((n + 1 : ℕ) : ℤ) hnn _ hz₁
    have hu₃ := uf0 S.X₃ I.cochainComplex ((n + 1 : ℕ) : ℤ) ((n + 1 + 1 : ℕ) : ℤ) hnn' _ hz₃
    have hH := s1 I.cochainComplex (n : ℤ) ((n + 1 : ℕ) : ℤ) hnn _ _ _ _ _ hu₁ hu₃ f1 f2
    set z₁ := Cocycle.equivHomShift.symm (Cocycle.fromSingleMk
      (h₁ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).inv) (zero_add (n : ℤ)) ((n + 1 : ℕ) : ℤ) hnn hz₁)
      with hz₁def
    set z₃ := Cocycle.equivHomShift.symm (Cocycle.fromSingleMk
      (h₃ ≫ (I.cochainComplexXIso ((n + 1 : ℕ) : ℤ) (n + 1) rfl).inv)
      (zero_add ((n + 1 : ℕ) : ℤ)) ((n + 1 + 1 : ℕ) : ℤ) hnn' hz₃) with hz₃def

    have hπ : IsIso (DerivedCategory.Q.map
        (descShortComplex (S.map (CochainComplex.singleFunctor C 0)))) :=
      (DerivedCategory.isIso_Q_map_iff_quasiIso C _).2
        (quasiIso_descShortComplex (hS.map_of_exact _))
    have tail : ∀ {X L : CochainComplex C ℤ}
        (u : X ⟶ (CategoryTheory.shiftFunctor (CochainComplex C ℤ) (n : ℤ)).obj L),
        (DerivedCategory.Q.commShiftIso (1 : ℤ)).hom.app X ≫
          (CategoryTheory.shiftFunctor (DerivedCategory C) (1 : ℤ)).map
            (DerivedCategory.Q.map u ≫ (DerivedCategory.Q.commShiftIso (n : ℤ)).hom.app L) ≫
          (CategoryTheory.shiftFunctorAdd' (DerivedCategory C) (n : ℤ) 1 ((n + 1 : ℕ) : ℤ)
            hnn).inv.app (DerivedCategory.Q.obj L) =
        DerivedCategory.Q.map ((CategoryTheory.shiftFunctor (CochainComplex C ℤ) (1 : ℤ)).map u) ≫
          DerivedCategory.Q.map ((CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) (n : ℤ) 1
            ((n + 1 : ℕ) : ℤ) hnn).inv.app L) ≫
          (DerivedCategory.Q.commShiftIso ((n + 1 : ℕ) : ℤ)).hom.app L := by
      intro X L u
      rw [Functor.commShiftIso_add' DerivedCategory.Q hnn, Functor.CommShift.isoAdd'_hom_app]
      have hid : DerivedCategory.Q.map ((CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ)
          (n : ℤ) 1 ((n + 1 : ℕ) : ℤ) hnn).inv.app L) ≫
          DerivedCategory.Q.map ((CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ)
          (n : ℤ) 1 ((n + 1 : ℕ) : ℤ) hnn).hom.app L) = 𝟙 _ := by
        rw [← Functor.map_comp, Iso.inv_hom_id_app]
        exact DerivedCategory.Q.map_id _
      rw [reassoc_of% hid, Functor.map_comp, Category.assoc, ← Functor.commShiftIso_hom_naturality_assoc]
    have key : DerivedCategory.Q.map (descShortComplex (S.map (CochainComplex.singleFunctor C 0))) ≫
        ShiftedHom.comp hS.singleδ (ShiftedHom.map z₁ DerivedCategory.Q) hnn =
        DerivedCategory.Q.map ((triangle (S.map (CochainComplex.singleFunctor C 0)).f).mor₃ ≫
            (CategoryTheory.shiftFunctor (CochainComplex C ℤ) (1 : ℤ)).map z₁ ≫
            (CategoryTheory.shiftFunctorAdd' (CochainComplex C ℤ) (n : ℤ) 1 ((n + 1 : ℕ) : ℤ)
              hnn).inv.app I.cochainComplex) ≫
          (DerivedCategory.Q.commShiftIso ((n + 1 : ℕ) : ℤ)).hom.app I.cochainComplex := by
      dsimp only [ShiftedHom.comp, ShiftedHom.map, ShortComplex.ShortExact.singleδ]
      erw [DerivedCategory.descShortComplex_triangleOfSESδ_assoc]
      erw [tail]
      simp only [Functor.map_comp, Category.assoc]
      rfl
    have hD : ShiftedHom.comp hS.singleδ (ShiftedHom.map z₁ DerivedCategory.Q) hnn =
          ShiftedHom.map z₃ DerivedCategory.Q ∨
        ShiftedHom.comp hS.singleδ (ShiftedHom.map z₁ DerivedCategory.Q) hnn =
          -ShiftedHom.map z₃ DerivedCategory.Q := by
      rcases hH with ⟨⟨H⟩⟩ | ⟨⟨H⟩⟩
      · left
        rw [← cancel_epi (DerivedCategory.Q.map
          (descShortComplex (S.map (CochainComplex.singleFunctor C 0)))), key,
          DerivedCategory.Q_map_eq_of_homotopy C H]
        simp only [ShiftedHom.map]
        erw [Functor.map_comp, Category.assoc]
        rfl
      · right
        rw [← cancel_epi (DerivedCategory.Q.map
          (descShortComplex (S.map (CochainComplex.singleFunctor C 0)))), key,
          DerivedCategory.Q_map_eq_of_homotopy C H]
        simp only [ShiftedHom.map]
        simp only [Preadditive.neg_comp, Preadditive.comp_neg, Functor.map_neg, Functor.map_comp,
          Category.assoc]
        erw [Functor.map_neg, Functor.map_comp, Preadditive.neg_comp, Category.assoc]
        rfl

    rcases hD with hD | hD
    · left
      apply Abelian.Ext.ext
      rw [Abelian.Ext.comp_hom, ShortComplex.ShortExact.extClass_hom,
        InjectiveResolution.extMk_hom, InjectiveResolution.extMk_hom,
        DerivedCategory.singleFunctorIsoCompQ_hom_app, DerivedCategory.singleFunctorIsoCompQ_hom_app,
        ShiftedHom.mk₀_id_comp, ShiftedHom.mk₀_id_comp,
        ← ShiftedHom.comp_assoc _ _ _ hnn (zero_add _) (by omega)]
      erw [hD]
    · right
      apply Abelian.Ext.ext
      rw [Abelian.Ext.neg_hom, Abelian.Ext.comp_hom, ShortComplex.ShortExact.extClass_hom,
        InjectiveResolution.extMk_hom, InjectiveResolution.extMk_hom,
        DerivedCategory.singleFunctorIsoCompQ_hom_app, DerivedCategory.singleFunctorIsoCompQ_hom_app,
        ShiftedHom.mk₀_id_comp, ShiftedHom.mk₀_id_comp,
        ← ShiftedHom.comp_assoc _ _ _ hnn (zero_add _) (by omega)]
      erw [hD, ShiftedHom.neg_comp]

theorem ext_leray_concentrated_extMk_injective : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : C) (I : InjectiveResolution A) (Q : D) (t : ℕ) (c : L.obj Q ⟶ I.cocomplex.X t) (hc : c ≫ I.cocomplex.d t (t + 1) = 0) (hf : adj.homEquiv _ _ c ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d t (t + 1) = 0), IsIso (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (adj.homEquiv _ _ c) (t + 1) (by simp) hf ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ t) → (∀ q : ℕ, q ≠ t → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) → letI := HasExt.standard C; letI := HasExt.standard D; ∀ (P : D) (j M : ℕ) (h : j + t = M) (x : Abelian.Ext P Q j), (Abelian.Ext.mapExactFunctor L x).comp (I.extMk c (t + 1) rfl hc) h = 0 → x = 0 :=
by
  intro C D _ _ _ _ L R _ _ _ _ adj A I Q t c hc hf hiso hvan
  letI := HasExt.standard C
  letI := HasExt.standard D
  intro P j M h x hx
  set J := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hJ

  obtain ⟨f', hf'i, hφ⟩ : ∃ f' : Q ⟶ J.cycles t, f' ≫ J.iCycles t = adj.homEquiv _ _ c ∧
      IsIso (f' ≫ J.homologyπ t) := ⟨_, J.liftCycles_i _ _ _ _, hiso⟩

  haveI : L.PreservesMonomorphisms := inferInstance
  have hinj : ∀ k, Injective (J.X k) := fun k => by
    haveI := I.injective k
    exact Injective.injective_of_adjoint adj (I.cocomplex.X k)

  have hw : ∀ n, J.iCycles n ≫ J.toCycles n (n + 1) = 0 := fun n => by
    rw [← cancel_mono (J.iCycles (n + 1)), Category.assoc, HomologicalComplex.toCycles_i,
      HomologicalComplex.iCycles_d, Limits.zero_comp]
  have hSE : ∀ n, t ≤ n →
      (ShortComplex.mk (J.iCycles n) (J.toCycles n (n + 1)) (hw n)).ShortExact := by
    intro n hn
    have hepi : Epi (J.toCycles n (n + 1)) :=
      Preadditive.epi_of_isZero_cokernel' _ (J.homologyIsCokernel n (n + 1) (by simp))
        (hvan (n + 1) (by omega))
    have hex : (ShortComplex.mk (J.iCycles n) (J.toCycles n (n + 1)) (hw n)).Exact := by
      apply ShortComplex.exact_of_f_is_kernel
      exact Limits.KernelFork.IsLimit.ofι _ _
        (fun {W'} k hk => J.liftCycles k (n + 1) (by simp) (by
          have hk' : k ≫ J.toCycles n (n + 1) = 0 := hk
          rw [← HomologicalComplex.toCycles_i, ← Category.assoc, hk', Limits.zero_comp]))
        (fun {W'} k hk => J.liftCycles_i _ _ _ _)
        (fun {W'} k hk m hm => by
          rw [← cancel_mono (J.iCycles n), J.liftCycles_i]
          exact hm)
    exact { exact := hex, mono_f := inferInstanceAs (Mono (J.iCycles n)), epi_g := hepi }

  have hcyc : ∀ n, (adj.homEquiv (J.cycles n) (I.cocomplex.X n)).symm (J.iCycles n) ≫
      I.cocomplex.d n (n + 1) = 0 := by
    intro n
    rw [← Adjunction.homEquiv_naturality_right_symm]
    have h0 : J.iCycles n ≫ R.map (I.cocomplex.d n (n + 1)) = 0 := J.iCycles_d n (n + 1)
    rw [h0, Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp]
  have hextMk : ∀ {X : C} {n : ℕ} (f g : X ⟶ I.cocomplex.X n) (hfg : f = g) hf' hg',
      I.extMk f (n + 1) rfl hf' = I.extMk g (n + 1) rfl hg' := by
    intro X n f g hfg _ _
    subst hfg
    rfl
  obtain ⟨e, he⟩ : ∃ e : ∀ n, Abelian.Ext (L.obj (J.cycles n)) A n, ∀ n,
      e n = I.extMk ((adj.homEquiv (J.cycles n) (I.cocomplex.X n)).symm (J.iCycles n))
        (n + 1) rfl (hcyc n) := ⟨_, fun _ => rfl⟩

  have hconn : ∀ n (hn : t ≤ n),
      (Abelian.Ext.mapExactFunctor L (hSE n hn).extClass).comp (e n) (add_comm 1 n) = e (n + 1) ∨
      (Abelian.Ext.mapExactFunctor L (hSE n hn).extClass).comp (e n) (add_comm 1 n) =
        -e (n + 1) := by
    intro n hn
    rw [Abelian.Ext.mapExactFunctor_extClass, he n, he (n + 1)]
    refine injRes_extClass_comp_extMk I _ ((hSE n hn).map_of_exact L) n
      ((adj.homEquiv (J.cycles n) (I.cocomplex.X n)).symm (J.iCycles n))
      (adj.counit.app (I.cocomplex.X n))
      ((adj.homEquiv (J.cycles (n + 1)) (I.cocomplex.X (n + 1))).symm (J.iCycles (n + 1)))
      (hcyc n) (hcyc (n + 1)) ?_ ?_
    · exact (Adjunction.homEquiv_counit _ _ _ _).symm
    · show adj.counit.app (I.cocomplex.X n) ≫ I.cocomplex.d n (n + 1) =
        L.map (J.toCycles n (n + 1)) ≫
          (adj.homEquiv (J.cycles (n + 1)) (I.cocomplex.X (n + 1))).symm (J.iCycles (n + 1))
      rw [Adjunction.homEquiv_counit, ← Category.assoc, ← Functor.map_comp,
        HomologicalComplex.toCycles_i]
      exact (adj.counit_naturality _).symm

  have hstep : ∀ n (P' : D) (g : P' ⟶ J.cycles (n + 1)),
      (Abelian.Ext.mk₀ (L.map g)).comp (e (n + 1)) (zero_add _) = 0 →
      ∃ w : P' ⟶ J.X n, w ≫ J.toCycles n (n + 1) = g := by
    intro n P' g H
    rw [he, InjectiveResolution.mk₀_comp_extMk, I.extMk_eq_zero_iff _ _ _ _ n rfl] at H
    obtain ⟨u, hu⟩ := H
    refine ⟨adj.homEquiv _ _ u, ?_⟩
    rw [← cancel_mono (J.iCycles (n + 1)), Category.assoc, HomologicalComplex.toCycles_i]
    have : adj.homEquiv _ _ u ≫ R.map (I.cocomplex.d n (n + 1)) = g ≫ J.iCycles (n + 1) := by
      rw [← Adjunction.homEquiv_naturality_right, hu,
        ← Adjunction.homEquiv_naturality_left_symm, Equiv.apply_symm_apply]
    exact this

  have hlift : ∀ (j' n : ℕ) (hn : t ≤ n) (P' : D) (y : Abelian.Ext P' (J.cycles n) (j' + 1)),
      ∃ y' : Abelian.Ext P' (J.cycles (n + 1)) j', y'.comp (hSE n hn).extClass rfl = y := by
    intro j' n hn P' y
    haveI := hinj n
    exact Abelian.Ext.covariant_sequence_exact₁ P' (hSE n hn) y
      (Abelian.Ext.eq_zero_of_injective _) rfl
  have hred : ∀ (j' n : ℕ) (hn : t ≤ n) (P' : D) (y' : Abelian.Ext P' (J.cycles (n + 1)) j')
      (T : ℕ) (hT : (j' + 1) + n = T),
      (Abelian.Ext.mapExactFunctor L (y'.comp (hSE n hn).extClass rfl)).comp (e n) hT = 0 →
      (Abelian.Ext.mapExactFunctor L y').comp (e (n + 1)) (by omega : j' + (n + 1) = T) = 0 := by
    intro j' n hn P' y' T hT H
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.comp_assoc _ _ _ _ (add_comm 1 n) hT] at H
    rcases hconn n hn with e1 | e1
    · rwa [e1] at H
    · rwa [e1, Abelian.Ext.comp_neg, neg_eq_zero] at H
  have key : ∀ (j' n : ℕ) (hn : t ≤ n) (P' : D) (y : Abelian.Ext P' (J.cycles n) (j' + 1))
      (T : ℕ) (hT : (j' + 1) + n = T),
      (Abelian.Ext.mapExactFunctor L y).comp (e n) hT = 0 → y = 0 := by
    intro j'
    induction j' with
    | zero =>
      intro n hn P' y T hT H
      obtain ⟨y', rfl⟩ := hlift 0 n hn P' y
      have H' := hred 0 n hn P' y' T hT H
      obtain rfl : T = n + 1 := by omega
      obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = y' := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply y'⟩
      rw [Abelian.Ext.mapExactFunctor_mk₀] at H'
      obtain ⟨w, rfl⟩ := hstep n P' g H'
      rw [← Abelian.Ext.mk₀_comp_mk₀_assoc, (hSE n hn).comp_extClass, Abelian.Ext.comp_zero]
    | succ j'' ih =>
      intro n hn P' y T hT H
      obtain ⟨y', rfl⟩ := hlift (j'' + 1) n hn P' y
      have H' := hred (j'' + 1) n hn P' y' T hT H
      have hy0 := ih (n + 1) (by omega) P' y' T (by omega) H'
      rw [hy0, Abelian.Ext.zero_comp]

  have hbase : (Abelian.Ext.mk₀ (L.map f')).comp (e t) (zero_add t) = I.extMk c (t + 1) rfl hc := by
    have h1 : L.map f' ≫ (adj.homEquiv (J.cycles t) (I.cocomplex.X t)).symm (J.iCycles t) = c := by
      rw [← Adjunction.homEquiv_naturality_left_symm, hf'i, Equiv.symm_apply_apply]
    rw [he, InjectiveResolution.mk₀_comp_extMk]
    exact hextMk _ _ h1 _ _
  haveI := hφ
  rcases j with _ | j'
  ·
    have hM : t = M := by omega
    subst hM
    obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
    rw [Abelian.Ext.mapExactFunctor_mk₀] at hx
    replace hx : I.extMk (L.map g ≫ c) (t + 1) rfl (by rw [Category.assoc, hc, Limits.comp_zero]) = 0 :=
      (InjectiveResolution.mk₀_comp_extMk I c (t + 1) rfl hc (L.map g)).symm.trans hx
    suffices hg : g = 0 by rw [hg, Abelian.Ext.mk₀_zero]
    suffices hg0 : g ≫ f' ≫ J.homologyπ t = 0 by
      rw [← cancel_mono (f' ≫ J.homologyπ t), hg0, Limits.zero_comp]
    rcases Nat.eq_zero_or_pos t with ht | ht
    · have h1 : L.map g ≫ c = 0 := by
        have h3 := congrArg I.extEquivCohomologyClass hx
        rw [InjectiveResolution.extEquivCohomologyClass_extMk,
          InjectiveResolution.extEquivCohomologyClass_zero,
          CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
          CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
            (by omega)] at h3
        obtain ⟨g', hg'⟩ := h3
        have hz : g' = 0 :=
          (CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1)).eq_of_tgt _ _
        rw [hz, Limits.zero_comp] at hg'
        rw [← cancel_mono (I.cochainComplexXIso (t : ℤ) t rfl).inv, Limits.zero_comp]
        exact hg'.symm
      have h2 : g ≫ f' = 0 := by
        rw [← cancel_mono (J.iCycles t), Category.assoc, hf'i, Limits.zero_comp,
          ← Adjunction.homEquiv_naturality_left, h1, Adjunction.homEquiv_unit, Functor.map_zero,
          Limits.comp_zero]
      rw [← Category.assoc, h2, Limits.zero_comp]
    · rw [I.extMk_eq_zero_iff _ _ _ _ (t - 1) (by omega)] at hx
      obtain ⟨u, hu⟩ := hx
      have h2 : g ≫ f' = adj.homEquiv _ _ u ≫ J.toCycles (t - 1) t := by
        rw [← cancel_mono (J.iCycles t), Category.assoc, hf'i, Category.assoc,
          HomologicalComplex.toCycles_i]
        have : adj.homEquiv _ _ u ≫ R.map (I.cocomplex.d (t - 1) t) = g ≫ adj.homEquiv _ _ c := by
          rw [← Adjunction.homEquiv_naturality_right, hu, Adjunction.homEquiv_naturality_left]
        exact this.symm
      rw [← Category.assoc, h2, Category.assoc, HomologicalComplex.toCycles_comp_homologyπ,
        Limits.comp_zero]
  ·
    have hy : (Abelian.Ext.mapExactFunctor L (x.comp (Abelian.Ext.mk₀ f') (add_zero _))).comp
        (e t) h = 0 := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_second_deg_zero, hbase]
      exact hx
    have hy0 := key j' t le_rfl P _ M h hy
    have hρ : f' ≫ (J.homologyπ t ≫ inv (f' ≫ J.homologyπ t)) = 𝟙 Q := by
      rw [← Category.assoc, IsIso.hom_inv_id]
