    rw [hu, mul_comm]
    exact hC4
  have hunit : IsUnit (fl (wcQmdlCX A' n π' c' l (some m))) := IsUnit.of_mul_eq_one _ hU1
  have hU3 : fm (wcQmdlCX A' n π' c' m none) * fl (wcQmdlCX A' n π' c' l (some m)) =
      fl (wcQmdlCX A' n π' c' l none) := by
    show rm (χ m (wcQmdlCX A' n π' c' m none)) * rl (χ l (wcQmdlCX A' n π' c' l (some m))) =
      rl (χ l (wcQmdlCX A' n π' c' l none))
