    have he₁ : ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev 2) 2)).val.app
        (Opposite.op ((wcEtBaseChange ι).obj W))).hom e₁ = a • y := by
      rw [he₁def, PresheafOfModules.naturality_apply, he', map_nsmul, hres1]
