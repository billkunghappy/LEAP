          ((((SheafOfModules.toSheaf (wcEtZModRing Y m)).map rV).hom.app (Opposite.op W)).hom s) := by
      rw [Functor.map_add, Sheaf.Hom.add_app, Functor.map_comp, Functor.map_comp]
      rfl
