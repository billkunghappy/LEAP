        ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom a))) =
        (Spec.preimage (cC ≫ f)).hom a := by
    intro C _ cC a
    have e1 : cC.appTop.hom (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom a)) =
        (cC ≫ f).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom a) := by
      rw [Scheme.Hom.comp_appTop]; rfl
    rw [e1]
    generalize cC ≫ f = ψ
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = ψ := ⟨_, Spec.map_preimage ψ⟩
    rw [Spec.preimage_map]
    have := congrArg (fun k => k.hom a) (Scheme.ΓSpecIso_inv_naturality φ)
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply,
