  have S1 : ∀ {X : Scheme.{u}} (V : X.Opens) (C : CommRingCat.{u})
      (χ : C →+* Γ(X, V)) (ψ : V.toScheme ⟶ Spec C)
      (hψ : ∀ f : C, ψ.appTop.hom ((Scheme.ΓSpecIso C).inv.hom f) = V.topIso.inv.hom (χ f))
      (z : V) (f : C),
      f ∈ (ψ z).asIdeal ↔
        (X.presheaf.germ V z.1 z.2).hom (χ f) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z.1) := by
    intro X V C χ ψ hψ z f
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, ← Scheme.mem_basicOpen X (χ f) z.1 z.2]
    have h1 : f ∉ (ψ z).asIdeal ↔ ψ z ∈ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv f) := by
      rw [basicOpen_eq_of_affine]; rfl
    rw [h1]
    have h2 : ψ z ∈ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv f) ↔
        (z : V.toScheme) ∈ ψ ⁻¹ᵁ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv f) := Iff.rfl
    rw [h2, Scheme.preimage_basicOpen]
    change (z : V.toScheme) ∈ V.toScheme.basicOpen (ψ.appTop.hom ((Scheme.ΓSpecIso C).inv.hom f)) ↔ _
    rw [hψ]
    have key := Scheme.Hom.preimage_image_eq V.ι (V.toScheme.basicOpen (V.topIso.inv.hom (χ f)))
    rw [Scheme.Opens.ι_image_basicOpen_topIso_inv] at key
    rw [← key]
