theorem wc_et_point_supp_class_strict_injective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (y₀ : Spec (.of K) ⟶ Y), y₀ ≫ f = 𝟙 _ → ∀ (Dy : wcEtPullData y₀ (ℓ ^ k)) (ω : wcEtSuppExt Dy (2 * N)), ℓ ^ (k - 1) • ω ≠ 0 → ℓ ^ (k - 1) • wcEtSuppClass Dy (2 * N) ω ≠ 0 :=
