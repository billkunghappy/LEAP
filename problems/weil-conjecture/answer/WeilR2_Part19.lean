      (∀ Z : Y.ProEt, Sieve.generate (fun (T : Y.ProEt) (_ : T ⟶ Z) => Q T) ∈
        Scheme.ProEt.topology Y Z) →
      ∀ (x : ∀ W : Y.ProEt, (W ⟶ W₀) → Q W → M.val.obj (Opposite.op W)),
      (∀ (W W' : Y.ProEt) (b₀ : W ⟶ W₀) (b : W' ⟶ W) (hW : Q W) (hW' : Q W'),
        (M.val.map b.op).hom (x W b₀ hW) = x W' (b ≫ b₀) hW') →
      ∃ s : M.val.obj (Opposite.op W₀), ∀ (W : Y.ProEt) (b₀ : W ⟶ W₀) (hW : Q W),
        (M.val.map b₀.op).hom s = x W b₀ hW := by
    intro M Q hQ x hx
    have hF : Presieve.IsSheaf (Scheme.ProEt.topology Y)
        (M.val.presheaf ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((Presheaf.isSheaf_iff_isSheaf_forget _ M.val.presheaf
          (forget AddCommGrpCat.{u+1})).mp M.isSheaf)
    have hS : ∀ Z : Y.ProEt, Presieve.IsSheafFor (M.val.presheaf ⋙ forget AddCommGrpCat.{u+1})
        (fun (T : Y.ProEt) (_ : T ⟶ Z) => Q T) := fun Z => hF.isSheafFor _ (hQ Z)
    let y : Presieve.FamilyOfElements (M.val.presheaf ⋙ forget AddCommGrpCat.{u+1})
        (fun (T : Y.ProEt) (_ : T ⟶ W₀) => Q T) := fun T f hf => x T f hf
    have hy : y.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      apply (hS Z).isSeparatedFor.ext
      intro Z' c hc
      have e1 : ∀ {T : Y.ProEt} (f : T ⟶ W₀) (hT : Q T) (gg : Z ⟶ T),
          (M.val.presheaf ⋙ forget AddCommGrpCat.{u+1}).map c.op
            ((M.val.presheaf ⋙ forget AddCommGrpCat.{u+1}).map gg.op (y f hT)) =
          x Z' ((c ≫ gg) ≫ f) hc := by
        intro T f hT gg
        rw [← FunctorToTypes.map_comp_apply, ← op_comp]
        exact hx T Z' f (c ≫ gg) hT hc
      rw [e1 f₁ h₁ g₁, e1 f₂ h₂ g₂]
      have hcomm : (c ≫ g₁) ≫ f₁ = (c ≫ g₂) ≫ f₂ := by
        rw [Category.assoc, comm, Category.assoc]
      rw [hcomm]
    refine ⟨(hS W₀).amalgamate y hy, fun W b₀ hW => ?_⟩
    exact (hS W₀).valid_glue hy b₀ hW
  obtain ⟨s, hs⟩ := glue (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
    (fun W => wcYrcWCTR W) hcov (fun W b₀ hW => (Ψ W (hproj W hW)).symm (cl W b₀)) (by
      intro W W' b₀ b hW hW'
      apply (Ψ W' (hproj W' hW')).injective
      rw [AddEquiv.apply_symm_apply]
      have hw : (Limits.pullback.fst W'.hom g ≫ b.left) ≫ W.hom =
          Limits.pullback.snd W'.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w b, Limits.pullback.condition]
      obtain ⟨Db, hDb⟩ := wc_hm_pull_data_exists (Limits.pullback.lift _ _ hw) ℓ
      rw [hnat W W' (hproj W hW) (hproj W' hW') b _ (Limits.pullback.lift_fst _ _ hw)
        (Limits.pullback.lift_snd _ _ hw) Db hDb, AddEquiv.apply_symm_apply]
      exact (hcoc W W' b₀ b hW hW' _ (Limits.pullback.lift_fst _ _ hw)
        (Limits.pullback.lift_snd _ _ hw) Db hDb).symm)
  refine ⟨s, fun W b₀ hW hP => ?_⟩
  rw [hs W b₀ hW]
  exact AddEquiv.apply_symm_apply _ _

theorem wc_yrc_wcontr_clopen_partition : ∀ {Y : Scheme.{u}} {N : ℕ} (V : Fin N → Y.Opens) (W : Y.ProEt), wcYrcWCTR W → (∀ v : W.left, ∃ j, W.hom v ∈ V j) → ∃ (n : ℕ) (ε : Fin n → Γ(W.left, ⊤)) (j : Fin n → Fin N), wcYrcAP W.hom V n ε j :=
by
  classical
  intro Y N V W hW hcov

  have hBO : ∀ (X : Scheme.{u}) [IsAffine X] (U : Set X), IsClopen U →
      ∃ e : Γ(X, ⊤), (X.basicOpen e : Set X) = U := by
    intro X _ U hU
    let V : Set (PrimeSpectrum Γ(X, ⊤)) := (X.isoSpec.inv : Spec Γ(X, ⊤) ⟶ X) ⁻¹' U
    have hV : IsClopen V := hU.preimage (X.isoSpec.inv).continuous
    let e₀ := (PrimeSpectrum.isIdempotentElemEquivClopens (R := Γ(X, ⊤))).symm ⟨V, hV⟩
    have hBV : (PrimeSpectrum.basicOpen (e₀ : Γ(X, ⊤)) : Set (PrimeSpectrum Γ(X, ⊤))) = V := by
      rw [← PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens]
      simp [e₀]
    refine ⟨(e₀ : Γ(X, ⊤)), ?_⟩
    rw [← Scheme.toSpecΓ_preimage_basicOpen]
    ext x
    change X.toSpecΓ x ∈ (PrimeSpectrum.basicOpen (e₀ : Γ(X, ⊤)) : Set (PrimeSpectrum Γ(X, ⊤))) ↔ x ∈ U
    rw [hBV]
    change X.isoSpec.inv (X.toSpecΓ x) ∈ U ↔ x ∈ U
    rw [← Scheme.isoSpec_hom, Scheme.hom_inv_apply]

  have hSD : ∀ (X : Scheme.{u}) [IsAffine X] (n : ℕ)
      (W : Fin n → Set X), (∀ k, IsClopen (W k)) →
      (∀ k l, k ≠ l → Disjoint (W k) (W l)) → (⋃ k, W k) = Set.univ →
      ∃ e : Fin n → Γ(X, ⊤), (∀ k, IsIdempotentElem (e k)) ∧
        (∀ k l, k ≠ l → e k * e l = 0) ∧ (∑ k, e k = 1) ∧
        ∀ (k : Fin n) (a : Γ(X, ⊤)), W k ⊆ (X.basicOpen a : Set X) → ∃ γ : Γ(X, ⊤), e k = γ * a := by
    intro X _ n W hW hdisj hcov
    have LA : ∀ (R : Type u) [CommRing R] (s : Fin n → Set (PrimeSpectrum R)),
        (∀ k, IsClopen (s k)) → (∀ k l, k ≠ l → Disjoint (s k) (s l)) → (⋃ k, s k) = Set.univ →
        ∃ e : Fin n → R, (∀ k, IsIdempotentElem (e k)) ∧ (∀ k l, k ≠ l → e k * e l = 0) ∧
          (∑ k, e k = 1) ∧
          ∀ k, s k = ((PrimeSpectrum.basicOpen (e k) : TopologicalSpace.Opens (PrimeSpectrum R)) :
            Set (PrimeSpectrum R)) := by
      intro R _ s hs hd hc
      choose e he hse using fun k => PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen (hs k)
      have horth : ∀ k l, k ≠ l → e k * e l = 0 := by
        intro k l hkl
        apply IsIdempotentElem.eq_zero_of_isNilpotent ((he k).mul (he l))
        rw [← PrimeSpectrum.basicOpen_eq_bot_iff, eq_bot_iff]
        intro q hq
        rw [PrimeSpectrum.mem_basicOpen] at hq
        have h1 : q ∈ s k := by
          rw [hse k]
          exact (PrimeSpectrum.mem_basicOpen _ _).mpr (fun h => hq (q.asIdeal.mul_mem_right _ h))
        have h2 : q ∈ s l := by
          rw [hse l]
          exact (PrimeSpectrum.mem_basicOpen _ _).mpr (fun h => hq (q.asIdeal.mul_mem_left _ h))
        exact (Set.disjoint_left.mp (hd k l hkl) h1 h2).elim
      have hproj : ∀ k, e k * ∑ l, e l = e k := by
        intro k
        rw [Finset.mul_sum, Finset.sum_eq_single k]
        · exact he k
        · intro l _ hlk
          exact horth k l (Ne.symm hlk)
        · intro h
          exact absurd (Finset.mem_univ k) h
      have hσi : IsIdempotentElem (∑ l, e l) := by
        show (∑ l, e l) * (∑ l, e l) = ∑ l, e l
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl (fun k _ => hproj k)
      have hz : 1 - ∑ l, e l = 0 := by
        apply IsIdempotentElem.eq_zero_of_isNilpotent hσi.one_sub
        rw [← PrimeSpectrum.basicOpen_eq_bot_iff, eq_bot_iff]
        intro q hq
        rw [PrimeSpectrum.mem_basicOpen] at hq
        have hq' : q ∈ ⋃ k, s k := by rw [hc]; trivial
        obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hq'
        rw [hse k] at hk
        have hek : e k ∉ q.asIdeal := (PrimeSpectrum.mem_basicOpen _ _).mp hk
        have hprod : e k * (1 - ∑ l, e l) = 0 := by rw [mul_sub, mul_one, hproj k, sub_self]
        have hmem : e k * (1 - ∑ l, e l) ∈ q.asIdeal := by rw [hprod]; exact q.asIdeal.zero_mem
        rcases q.isPrime.mem_or_mem hmem with h | h
        · exact (hek h).elim
        · exact (hq h).elim
      exact ⟨e, he, horth, (sub_eq_zero.mp hz).symm, hse⟩
    have LB : ∀ (e a : Γ(X, ⊤)), IsIdempotentElem e →
        PrimeSpectrum.basicOpen e ≤ PrimeSpectrum.basicOpen a → ∃ γ : Γ(X, ⊤), e = γ * a := by
      intro e a he hle
      obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp ((PrimeSpectrum.basicOpen_le_basicOpen_iff e a).mp hle)
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hN
      refine ⟨c * e, ?_⟩
      calc e = e ^ (N + 1) := (he.pow_succ_eq N).symm
        _ = e ^ N * e := pow_succ e N
        _ = c * a * e := by rw [hc]
        _ = c * e * a := by ring
    let h : X ≃ₜ Spec Γ(X, ⊤) := Scheme.homeoOfIso X.isoSpec
    have hT : ∀ (g : Γ(X, ⊤)) (x : X), x ∈ X.basicOpen g →
        (h x : PrimeSpectrum Γ(X, ⊤)) ∈ PrimeSpectrum.basicOpen g := by
      intro g x hx
      rw [← Scheme.toSpecΓ_preimage_basicOpen X g] at hx
      have : h x = X.toSpecΓ x := by
        simp only [h, Scheme.homeoOfIso_apply, Scheme.isoSpec_hom]
      rw [this]
      exact hx
    let s : Fin n → Set (PrimeSpectrum Γ(X, ⊤)) := fun k => (h.symm ⁻¹' W k : Set _)
    have hs : ∀ k, IsClopen (s k) := fun k => (hW k).preimage h.symm.continuous
    have hsd : ∀ k l, k ≠ l → Disjoint (s k) (s l) := fun k l hkl => (hdisj k l hkl).preimage h.symm
    have hsc : (⋃ k, s k) = Set.univ := by
      show (⋃ k, h.symm ⁻¹' W k) = Set.univ
      rw [← Set.preimage_iUnion, hcov, Set.preimage_univ]
    obtain ⟨e, he, horth, hsum, hbo⟩ := LA Γ(X, ⊤) s hs hsd hsc
    refine ⟨e, he, horth, hsum, ?_⟩
    intro k a hka
    apply LB (e k) a (he k)
    intro q hq
    have h1 : h.symm q ∈ W k := by
      have : q ∈ s k := by rw [hbo k]; exact hq
      exact this
    have h3 := hT a (h.symm q) (hka h1)
    have e : (h (h.symm q) : PrimeSpectrum Γ(X, ⊤)) = q := h.apply_symm_apply q
    rw [e] at h3
    exact h3

  have hNB : ∀ (X : Scheme.{u}) [IsAffine X],
      IsClosed {x : X | IsClosed ({x} : Set X)} →
      (∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y) →
      ∀ (z : X), IsClosed ({z} : Set X) → ∀ (U : Set X), IsOpen U → z ∈ U →
      ∃ V : Set X, IsClopen V ∧ z ∈ V ∧ V ⊆ U := by
    intro X _ hc hu z hz U hU hzU
    have s3 : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → (∀ x : PrimeSpectrum A, ∃! y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) → ∀ U : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, IsClopen U → ∃ e : A, e * e = e ∧ ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, (m ∈ U ↔ e ∉ m.1.asIdeal) := by
      intro A _ ha hb U hU
      have hclosed : ∀ V : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
          IsClosed V → ∀ n : Ideal A, n.IsMaximal →
          PrimeSpectrum.vanishingIdeal (Subtype.val '' V) ≤ n → ∃ m ∈ V, m.1.asIdeal = n := by
        intro V hV n hn hle
        have hVc : IsClosed (Subtype.val '' V) := (IsClosed.isClosedMap_subtype_val ha) V hV
        have hx : (⟨n, hn.isPrime⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
            (PrimeSpectrum.vanishingIdeal (Subtype.val '' V) : Set A) := by
          rw [PrimeSpectrum.mem_zeroLocus]
          exact fun a ha' => hle ha'
        rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hVc.closure_eq] at hx
        obtain ⟨m, hm, hmeq⟩ := hx
        exact ⟨m, hm, by rw [hmeq]⟩
      have hnc : ∀ P : Ideal A, P.IsPrime →
          P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' U) ≠ ⊤ →
          P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) = ⊤ := by
        intro P hP h1
        by_contra h2
        obtain ⟨n1, hn1, hle1⟩ := Ideal.exists_le_maximal _ h1
        obtain ⟨n2, hn2, hle2⟩ := Ideal.exists_le_maximal _ h2
        obtain ⟨m1, hm1U, hm1⟩ := hclosed U hU.isClosed n1 hn1 (le_trans le_sup_right hle1)
        obtain ⟨m2, hm2U, hm2⟩ := hclosed Uᶜ hU.compl.isClosed n2 hn2 (le_trans le_sup_right hle2)
        have sp1 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m1.1 := by
          rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm1]
          exact le_trans le_sup_left hle1
        have sp2 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m2.1 := by
          rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm2]
          exact le_trans le_sup_left hle2
        have heq := (hb ⟨P, hP⟩).unique ⟨m1.2, sp1⟩ ⟨m2.2, sp2⟩
        have hm12 : m1 = m2 := Subtype.ext heq
        exact hm2U (hm12 ▸ hm1U)
      have havoid : ∃ i ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' U),
          ∃ j ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ), (1 - i) * (1 - j) = 0 := by
        set I := PrimeSpectrum.vanishingIdeal (Subtype.val '' U) with hI
        set J := PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) with hJ
        let S : Submonoid A :=
          { carrier := {x | ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j)}
            mul_mem' := by
              rintro a b ⟨i1, hi1, j1, hj1, rfl⟩ ⟨i2, hi2, j2, hj2, rfl⟩
              exact ⟨i1 + i2 - i1 * i2, I.sub_mem (I.add_mem hi1 hi2) (I.mul_mem_right i2 hi1),
                j1 + j2 - j1 * j2, J.sub_mem (J.add_mem hj1 hj2) (J.mul_mem_right j2 hj1), by ring⟩
            one_mem' := by
              show ∃ i ∈ I, ∃ j ∈ J, (1 : A) = (1 - i) * (1 - j)
              exact ⟨0, I.zero_mem, 0, J.zero_mem, by ring⟩ }
        have hS : ∀ x, x ∈ S ↔ ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j) := fun x => Iff.rfl
        by_contra hcon
        have hdisj : Disjoint ((⊥ : Ideal A) : Set A) (S : Set A) := by
          rw [Set.disjoint_left]
          intro x hx hxS
          rw [SetLike.mem_coe, Ideal.mem_bot] at hx
          subst hx
          obtain ⟨i, hi, j, hj, h⟩ := (hS 0).1 hxS
          exact hcon ⟨i, hi, j, hj, h.symm⟩
        obtain ⟨P, hP, -, hPS⟩ := Ideal.exists_le_prime_disjoint ⊥ S hdisj
        have h1 : P ⊔ I ≠ ⊤ := by
          intro htop
          rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at htop
          obtain ⟨p, hp, i, hi, hpi⟩ := htop
          have hmem : 1 - i ∈ S := (hS _).2 ⟨i, hi, 0, J.zero_mem, by ring⟩
          have hpe : 1 - i = p := by rw [← hpi]; ring
          rw [← hpe] at hp
          exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
        have h2 := hnc P hP h1
        rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at h2
        obtain ⟨p, hp, j, hj, hpj⟩ := h2
        have hmem : 1 - j ∈ S := (hS _).2 ⟨0, I.zero_mem, j, hj, by ring⟩
        have hpe : 1 - j = p := by rw [← hpj]; ring
        rw [← hpe] at hp
        exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
      obtain ⟨i, hi, j, hj, hij⟩ := havoid
      have P1 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∈ U →
          (1 - i) ∉ m.1.asIdeal ∧ (1 - j) ∈ m.1.asIdeal := by
        intro m hm
        have him : i ∈ m.1.asIdeal :=
          (PrimeSpectrum.mem_vanishingIdeal _ _).mp hi m.1 (Set.mem_image_of_mem _ hm)
        have hfn : (1 - i) ∉ m.1.asIdeal := by
          intro hfm
          apply m.1.isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have h1 : (1 : A) = (1 - i) + i := by ring
          rw [h1]
          exact m.1.asIdeal.add_mem hfm him
        refine ⟨hfn, ?_⟩
        have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
        exact (m.1.isPrime.mem_or_mem h0).resolve_left hfn
      have P2 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∉ U →
          (1 - j) ∉ m.1.asIdeal ∧ (1 - i) ∈ m.1.asIdeal := by
        intro m hm
        have hjm : j ∈ m.1.asIdeal :=
          (PrimeSpectrum.mem_vanishingIdeal _ _).mp hj m.1
            (Set.mem_image_of_mem _ (show m ∈ Uᶜ from hm))
        have hgn : (1 - j) ∉ m.1.asIdeal := by
          intro hgm
          apply m.1.isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have h1 : (1 : A) = (1 - j) + j := by ring
          rw [h1]
          exact m.1.asIdeal.add_mem hgm hjm
        refine ⟨hgn, ?_⟩
        have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
        exact (m.1.isPrime.mem_or_mem h0).resolve_right hgn
      have hunit : IsUnit ((1 - i) + (1 - j)) := by
        by_contra hnu
        obtain ⟨N, hN, hmem⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
        let m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
          ⟨⟨N, hN.isPrime⟩, (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hN⟩
        have hmN : m.1.asIdeal = N := rfl
        by_cases hm : m ∈ U
        · obtain ⟨hf, hg⟩ := P1 m hm
          rw [hmN] at hf hg
          apply hf
          have e1 : 1 - i = ((1 - i) + (1 - j)) - (1 - j) := by ring
          rw [e1]
          exact N.sub_mem hmem hg
        · obtain ⟨hg, hf⟩ := P2 m hm
          rw [hmN] at hf hg
          apply hg
          have e1 : 1 - j = ((1 - i) + (1 - j)) - (1 - i) := by ring
          rw [e1]
          exact N.sub_mem hmem hf
      obtain ⟨u, hu⟩ := hunit
      have h1 : ((1 - i) + (1 - j)) * (↑u⁻¹ : A) = 1 := by rw [← hu, Units.mul_inv]
      refine ⟨(1 - i) * (↑u⁻¹ : A), ?_, ?_⟩
      · linear_combination (-((↑u⁻¹ : A) * (↑u⁻¹ : A))) * hij + ((1 - i) * (↑u⁻¹ : A)) * h1
      · intro m
        constructor
        · intro hm hem
          apply (P1 m hm).1
          have e1 : 1 - i = ((1 - i) * (↑u⁻¹ : A)) * ((1 - i) + (1 - j)) := by
            linear_combination (-(1 - i)) * h1
          rw [e1]
          exact m.1.asIdeal.mul_mem_right _ hem
        · intro hem
          by_contra hm
          exact hem (m.1.asIdeal.mul_mem_right _ (P2 m hm).2)
    have s1 : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → ∀ a : A, IsClopen {m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} | a ∉ m.1.asIdeal} := by
      intro A _ hcA a
      have hopen : ∀ b : A, IsOpen {m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} | b ∉ m.1.asIdeal} :=
        fun b => (PrimeSpectrum.isOpen_basicOpen (a := b)).preimage continuous_subtype_val
      refine ⟨?_, hopen a⟩
      rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
      intro m' hm'
      have ham' : a ∈ m'.1.asIdeal := not_not.mp hm'
      have hnd : ¬ Disjoint ((PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Ideal A) : Set A)
          ((m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) : Set A) := by
        intro hdisj
        obtain ⟨P, hP, hJP, hPS⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
        have hPZ : (⟨P, hP⟩ : PrimeSpectrum A) ∈ {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} := by
          have hx : (⟨P, hP⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
              (PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Set A) := by
            rw [PrimeSpectrum.mem_zeroLocus]
            exact fun t ht => hJP ht
          rwa [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hcA.closure_eq] at hx
        have hPmax : P.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hPZ
        have hPle : P ≤ m'.1.asIdeal := by
          intro t ht
          by_contra htm
          have htS : t ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
            (le_sup_left : m'.1.asIdeal.primeCompl ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a) htm
          exact Set.disjoint_left.mp hPS ht htS
        have hPeq : P = m'.1.asIdeal := hPmax.eq_of_le m'.1.isPrime.ne_top hPle
        have haS : a ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
          (le_sup_right : Submonoid.powers a ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a)
            (Submonoid.mem_powers a)
        have haP : a ∈ (P : Set A) := by rw [SetLike.mem_coe, hPeq]; exact ham'
        exact Set.disjoint_left.mp hPS haP haS
      rw [Set.not_disjoint_iff] at hnd
      obtain ⟨t, htJ, htS⟩ := hnd
      obtain ⟨s, hs, w, hw, hsw⟩ := Submonoid.mem_sup.mp (SetLike.mem_coe.mp htS)
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hw
      refine ⟨{m | s ∉ m.1.asIdeal}, ?_, hopen s, hs⟩
      intro m hm ham
      have htm : t ∈ m.1.asIdeal :=
        (PrimeSpectrum.mem_vanishingIdeal _ _).mp (SetLike.mem_coe.mp htJ) m.1 m.2
      rw [← hsw] at htm
      rcases m.1.isPrime.mem_or_mem htm with h | h
      · exact hm h
      · exact ham (m.1.isPrime.mem_of_pow_mem k h)
    have s2 : ∀ (A : Type u) [CommRing A], (∀ x : PrimeSpectrum A, ∃ y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) → ∀ (a e : A), e * e = e → (∀ y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) → e ∉ y.asIdeal → a ∉ y.asIdeal) → ∀ x : PrimeSpectrum A, e ∉ x.asIdeal → a ∉ x.asIdeal := by
      intro A _ hex a e he hcl x hx hax
      obtain ⟨y, hy, hxy⟩ := hex x
      have hle : x.asIdeal ≤ y.asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal x y).mpr ((PrimeSpectrum.le_iff_specializes x y).mpr hxy)
      have h0 : e * (1 - e) ∈ x.asIdeal := by
        have h00 : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he, sub_self]
        rw [h00]; exact x.asIdeal.zero_mem
      have h1 : 1 - e ∈ y.asIdeal := hle ((x.isPrime.mem_or_mem h0).resolve_left hx)
      have hey : e ∉ y.asIdeal := by
        intro hey
        apply y.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have h11 : (1 : A) = e + (1 - e) := by ring
        rw [h11]; exact y.asIdeal.add_mem hey h1
      exact hcl y hy hey (hle hax)
    let φ : X ≃ₜ PrimeSpectrum Γ(X, ⊤) := X.isoSpec.hom.homeomorph
    have K : ∀ x : X, IsClosed ({φ x} : Set (PrimeSpectrum Γ(X, ⊤))) ↔ IsClosed ({x} : Set X) := by
      intro x
      rw [show ({φ x} : Set (PrimeSpectrum Γ(X, ⊤))) = φ '' {x} from (Set.image_singleton).symm]
      exact φ.isClosed_image
    have K' : ∀ p : PrimeSpectrum Γ(X, ⊤),
        IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤))) ↔ IsClosed ({φ.symm p} : Set X) := by
      intro p
      rw [← K, φ.apply_symm_apply]
    have hc' : IsClosed {p : PrimeSpectrum Γ(X, ⊤) | IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤)))} := by
      have hset : {p : PrimeSpectrum Γ(X, ⊤) | IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤)))} =
          φ.symm ⁻¹' {x : X | IsClosed ({x} : Set X)} := by
        ext p; exact K' p
      rw [hset]; exact hc.preimage φ.symm.continuous
    have hu' : ∀ p : PrimeSpectrum Γ(X, ⊤), ∃! q : PrimeSpectrum Γ(X, ⊤),
        IsClosed ({q} : Set (PrimeSpectrum Γ(X, ⊤))) ∧ p ⤳ q := by
      intro p
      obtain ⟨y, ⟨hy, hpy⟩, huniq⟩ := hu (φ.symm p)
      refine ⟨φ y, ⟨(K y).mpr hy, ?_⟩, ?_⟩
      · have hsp := hpy.map φ.continuous
        rwa [φ.apply_symm_apply] at hsp
      · rintro q ⟨hq, hpq⟩
        have h1 : φ.symm q = y := huniq _ ⟨(K' q).mp hq, hpq.map φ.symm.continuous⟩
        rw [← h1, φ.apply_symm_apply]
    have hzU' : φ z ∈ φ.symm ⁻¹' U := by
      rw [Set.mem_preimage, φ.symm_apply_apply]; exact hzU
    obtain ⟨_, ⟨a, rfl⟩, hza, haU⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hzU'
        (hU.preimage φ.symm.continuous)
    obtain ⟨e, he, heC⟩ := s3 Γ(X, ⊤) hc' hu' _ (s1 Γ(X, ⊤) hc' a)
    refine ⟨φ ⁻¹' (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum Γ(X, ⊤))), ?_, ?_, ?_⟩
    · exact (PrimeSpectrum.isClopen_basicOpen_of_mul_add e (1 - e)
        (by rw [mul_sub, mul_one, he, sub_self]) (by ring)).preimage φ.continuous
    · show e ∉ (φ z).asIdeal
      exact (heC ⟨φ z, (K z).mpr hz⟩).mp hza
    · intro x hx
      have hxa : a ∉ (φ x).asIdeal :=
        s2 Γ(X, ⊤) (fun p => (hu' p).exists) a e he (fun y hy hey => (heC ⟨y, hy⟩).mpr hey) (φ x) hx
      have hxU := haU hxa
      rwa [Set.mem_preimage, φ.symm_apply_apply] at hxU

  obtain ⟨hAff, hc, hu, -, -⟩ := hW
  haveI : IsAffine W.left := hAff
  let U : Fin N → Set W.left := fun j => W.hom ⁻¹' (V j : Set Y)
  have hUo : ∀ j, IsOpen (U j) := fun j => (V j).isOpen.preimage W.hom.continuous

  have hK : IsCompact {x : W.left | IsClosed ({x} : Set W.left)} := hc.isCompact
  have hloc : ∀ z : {x : W.left | IsClosed ({x} : Set W.left)}, ∃ (jj : Fin N) (C : Set W.left),
      IsClopen C ∧ (z : W.left) ∈ C ∧ C ⊆ U jj := by
    intro z
    obtain ⟨jj, hjj⟩ := hcov z
    obtain ⟨C, hC1, hC2, hC3⟩ := hNB W.left hc hu z z.2 (U jj) (hUo jj) hjj
    exact ⟨jj, C, hC1, hC2, hC3⟩
  choose jz Cz hCz1 hCz2 hCz3 using hloc
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover Cz (fun z => (hCz1 z).isOpen)
    (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hCz2 ⟨x, hx⟩⟩)
  let n : ℕ := t.card
  let C : Fin n → Set W.left := fun a => Cz (t.equivFin.symm a).1
  let j : Fin n → Fin N := fun a => jz (t.equivFin.symm a).1
  have hCc : ∀ a, IsClopen (C a) := fun a => hCz1 _
  have hCsub : ∀ a, C a ⊆ U (j a) := fun a => hCz3 _
  have hCcov : (⋃ a, C a) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro x
    obtain ⟨y, ⟨hy, hxy⟩, -⟩ := hu x
    have hyK := ht (show y ∈ {x : W.left | IsClosed ({x} : Set W.left)} from hy)
    obtain ⟨i, hi, hyi⟩ := Set.mem_iUnion₂.mp hyK
    refine Set.mem_iUnion.mpr ⟨t.equivFin ⟨i, hi⟩, ?_⟩
    show x ∈ Cz (t.equivFin.symm (t.equivFin ⟨i, hi⟩)).1
    rw [Equiv.symm_apply_apply]
    exact hxy.mem_open (hCz1 i).isOpen hyi

  let D : Fin n → Set W.left := fun a => C a \ ⋃ b : Fin n, (if b < a then C b else ∅)
  have hDc : ∀ a, IsClopen (D a) := by
    intro a
    refine (hCc a).diff (isClopen_iUnion_of_finite (fun b => ?_))
    split_ifs
    · exact hCc b
    · exact isClopen_empty
  have hDsub : ∀ a, D a ⊆ C a := fun a => Set.diff_subset
  have hDd : ∀ a b, a ≠ b → Disjoint (D a) (D b) := by
    have key : ∀ a b, a < b → Disjoint (D a) (D b) := by
      intro a b hab
      rw [Set.disjoint_left]
      intro x hxa hxb
      apply hxb.2
      refine Set.mem_iUnion.mpr ⟨a, ?_⟩
      rw [if_pos hab]
      exact hxa.1
    intro a b hab
    rcases lt_or_gt_of_ne hab with h | h
    · exact key a b h
    · exact (key b a h).symm
  have hDu : (⋃ a, D a) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro x
    have hx : x ∈ ⋃ a, C a := by rw [hCcov]; trivial
    obtain ⟨a0, ha0⟩ := Set.mem_iUnion.mp hx
    have hS : (Finset.univ.filter (fun a => x ∈ C a)).Nonempty :=
      ⟨a0, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ha0⟩⟩
    have hamem := Finset.min'_mem _ hS
    have hxa : x ∈ C ((Finset.univ.filter (fun a => x ∈ C a)).min' hS) :=
      (Finset.mem_filter.mp hamem).2
    refine Set.mem_iUnion.mpr ⟨(Finset.univ.filter (fun a => x ∈ C a)).min' hS, hxa, ?_⟩
    intro hx'
    obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hx'
    by_cases hba : b < (Finset.univ.filter (fun a => x ∈ C a)).min' hS
    · rw [if_pos hba] at hb
      have hle : (Finset.univ.filter (fun a => x ∈ C a)).min' hS ≤ b :=
        Finset.min'_le (Finset.univ.filter (fun a : Fin n => x ∈ C a)) b
          (Finset.mem_filter.mpr ⟨Finset.mem_univ b, hb⟩)
      exact absurd hba (not_lt.mpr hle)
    · rw [if_neg hba] at hb
      simp at hb

  obtain ⟨e, he1, he2, he3, he4⟩ := hSD W.left n D hDc hDd hDu
  refine ⟨n, e, j, fun a => (he1 a).eq, he2, he3, ?_⟩
  intro a v hv
  obtain ⟨r, hr⟩ := hBO W.left (D a) (hDc a)
  obtain ⟨γ, hγ⟩ := he4 a r hr.symm.subset
  rw [hγ, Scheme.basicOpen_mul] at hv
  have hvr : v ∈ (W.left.basicOpen r : Set W.left) := (TopologicalSpace.Opens.mem_inf.mp hv).2
  rw [hr] at hvr
  exact hCsub a (hDsub a hvr)

theorem wc_yrc_partition_ratio_unit : ∀ {Wl Y : Scheme.{u}} [IsAffine Wl] (w : Wl ⟶ Y) {N : ℕ} (V : Fin N → Y.Opens) (x : Fin N → Γ(Y, ⊤)), (∀ j j' : Fin N, ∃ v : (Γ(Y, V j ⊓ V j'))ˣ, (Y.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j) = (v : Γ(Y, V j ⊓ V j')) * (Y.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j')) → ∀ (n n' : ℕ) (ε : Fin n → Γ(Wl, ⊤)) (j : Fin n → Fin N) (ε' : Fin n' → Γ(Wl, ⊤)) (j' : Fin n' → Fin N), wcYrcAP w V n ε j → wcYrcAP w V n' ε' j' → ∃ u : (Γ(Wl, ⊤))ˣ, ∑ a, ε a * w.appTop.hom (x (j a)) = (u : Γ(Wl, ⊤)) * ∑ a, ε' a * w.appTop.hom (x (j' a)) :=
by
  intro Wl Y _ w N V x hB2 n n' ε j ε' j' hA hA'
  obtain ⟨A1, A2, A3, A4⟩ := hA
  obtain ⟨A1', A2', A3', A4'⟩ := hA'

  have s3 : ∀ (O : Y.Opens) (D : Wl.Opens) (h : D ≤ w ⁻¹ᵁ O) (y : Γ(Y, ⊤)),
      (Wl.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op).hom (w.appTop.hom y) =
      (w.appLE O D h).hom ((Y.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom y) := by
    intro O D h y
    have hD : D ≤ w ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have e1 : w.appTop ≫ Wl.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op = w.appLE ⊤ D hD := rfl
    have e2 : Y.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op ≫ w.appLE O D h = w.appLE ⊤ D hD := by
      rw [Scheme.Hom.map_appLE]
    have e3 := congrArg (fun φ => φ.hom y) (e1.trans e2.symm)
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using e3

  have key : ∀ (δ : Γ(Wl, ⊤)), δ * δ = δ → ∀ (O : Y.Opens), Wl.basicOpen δ ≤ w ⁻¹ᵁ O →
      ∀ (y y' : Γ(Y, ⊤)) (v : (Γ(Y, O))ˣ),
      (Y.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom y =
        (v : Γ(Y, O)) * (Y.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom y' →
      ∃ F F' : Γ(Wl, ⊤), δ * (F * F' - 1) = 0 ∧
        δ * (w.appTop.hom y - F * w.appTop.hom y') = 0 := by
    intro δ hδ O hDO y y' v hv
    have : IsLocalization.Away δ Γ(Wl, Wl.basicOpen δ) :=
      IsAffineOpen.isLocalization_basicOpen (isAffineOpen_top Wl) δ
    have hρ : ∀ r, algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) r =
        (Wl.presheaf.map (homOfLE (le_top : Wl.basicOpen δ ≤ ⊤)).op).hom r := fun r => rfl
    have hρδ : algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) δ = 1 := by
      have hu := IsLocalization.Away.algebraMap_isUnit (S := Γ(Wl, Wl.basicOpen δ)) δ
      refine (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp ?_
      show _ * _ = _
      rw [← map_mul, hδ]
    have hpow : ∀ k : ℕ, δ ^ (k + 1) = δ := by
      intro k
      induction k with
      | zero => simp
      | succ k ih => rw [pow_succ, ih, hδ]
    have hsurj : ∀ s, ∃ r, algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) r = s := by
      intro s
      obtain ⟨⟨r, m⟩, hm⟩ := IsLocalization.surj (Submonoid.powers δ) s
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
      refine ⟨r, ?_⟩
      have hm1 : algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) (m : Γ(Wl, ⊤)) = 1 := by
        rw [← hk, map_pow, hρδ, one_pow]
      change s * algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) (m : Γ(Wl, ⊤)) =
        algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) r at hm
      rw [hm1, mul_one] at hm
      exact hm.symm
    have hker : ∀ r, algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) r = 0 → δ * r = 0 := by
      intro r hr
      obtain ⟨m, hm⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers δ) Γ(Wl, Wl.basicOpen δ) r).mp hr
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
      rw [← hk] at hm
      calc δ * r = δ ^ (k + 1) * r := by rw [hpow]
        _ = δ * (δ ^ k * r) := by ring
        _ = 0 := by rw [hm, mul_zero]
    have hX : algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) (w.appTop.hom y) =
        (w.appLE O (Wl.basicOpen δ) hDO).hom (v : Γ(Y, O)) *
          algebraMap Γ(Wl, ⊤) Γ(Wl, Wl.basicOpen δ) (w.appTop.hom y') := by
      rw [hρ, hρ, s3 _ _ hDO, s3 _ _ hDO, hv, map_mul]
    obtain ⟨F, hF⟩ := hsurj ((w.appLE O (Wl.basicOpen δ) hDO).hom (v : Γ(Y, O)))
    obtain ⟨F', hF'⟩ := hsurj ((w.appLE O (Wl.basicOpen δ) hDO).hom ((v⁻¹ : (Γ(Y, O))ˣ) : Γ(Y, O)))
    refine ⟨F, F', hker _ ?_, hker _ ?_⟩
    · rw [map_sub, map_mul, hF, hF', ← map_mul, Units.mul_inv, map_one, map_one, sub_self]
    · rw [map_sub, map_mul, hF, ← hX, sub_self]
  have G1 : ∀ a a', ∃ F F' : Γ(Wl, ⊤), ε a * ε' a' * (F * F' - 1) = 0 ∧
      ε a * ε' a' * (w.appTop.hom (x (j a)) - F * w.appTop.hom (x (j' a'))) = 0 := by
    intro a a'
    have hδ : ε a * ε' a' * (ε a * ε' a') = ε a * ε' a' := by
      calc ε a * ε' a' * (ε a * ε' a') = (ε a * ε a) * (ε' a' * ε' a') := by ring
        _ = ε a * ε' a' := by rw [A1, A1']
    have hDO : Wl.basicOpen (ε a * ε' a') ≤ w ⁻¹ᵁ (V (j a) ⊓ V (j' a')) := by
      intro z hz
      rw [Scheme.basicOpen_mul] at hz
      have hz' := TopologicalSpace.Opens.mem_inf.mp hz
      rw [Scheme.Hom.mem_preimage]
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨A4 a z hz'.1, A4' a' z hz'.2⟩
    obtain ⟨v, hv⟩ := hB2 (j a) (j' a')
    exact key _ hδ _ hDO _ _ v hv
  choose F F' hR1 hR2 using G1

  have hsum1 : ∑ a, ∑ a', ε a * ε' a' = 1 := by
    rw [← Finset.sum_mul_sum, A3, A3', mul_one]
  have hloc : ∀ P Q : Γ(Wl, ⊤), (∀ a a', ε a * ε' a' * P = ε a * ε' a' * Q) → P = Q := by
    intro P Q h
    calc P = (∑ a, ∑ a', ε a * ε' a') * P := by rw [hsum1, one_mul]
      _ = ∑ a, ∑ a', ε a * ε' a' * P := by simp only [Finset.sum_mul]
      _ = ∑ a, ∑ a', ε a * ε' a' * Q := by simp only [h]
      _ = (∑ a, ∑ a', ε a * ε' a') * Q := by simp only [Finset.sum_mul]
      _ = Q := by rw [hsum1, one_mul]
  have hE : ∀ a (G : Fin n → Γ(Wl, ⊤)), ε a * ∑ b, ε b * G b = ε a * G a := by
    intro a G
    rw [Finset.mul_sum, Finset.sum_eq_single a]
    · rw [← mul_assoc, A1]
    · intro b _ hb
      rw [← mul_assoc, A2 a b (Ne.symm hb), zero_mul]
    · intro h
      exact absurd (Finset.mem_univ a) h
  have hE' : ∀ a (G : Fin n' → Γ(Wl, ⊤)), ε' a * ∑ b, ε' b * G b = ε' a * G a := by
    intro a G
    rw [Finset.mul_sum, Finset.sum_eq_single a]
    · rw [← mul_assoc, A1']
    · intro b _ hb
      rw [← mul_assoc, A2' a b (Ne.symm hb), zero_mul]
    · intro h
      exact absurd (Finset.mem_univ a) h
  have hδT : ∀ (T : Fin n → Fin n' → Γ(Wl, ⊤)) a a',
      ε a * ε' a' * (∑ b, ε b * ∑ b', ε' b' * T b b') = ε a * ε' a' * T a a' := by
    intro T a a'
    calc ε a * ε' a' * (∑ b, ε b * ∑ b', ε' b' * T b b')
        = ε' a' * (ε a * ∑ b, ε b * ∑ b', ε' b' * T b b') := by ring
      _ = ε' a' * (ε a * ∑ b', ε' b' * T a b') :=
          congrArg (fun t => ε' a' * t) (hE a (fun b => ∑ b', ε' b' * T b b'))
      _ = ε a * (ε' a' * ∑ b', ε' b' * T a b') := by ring
      _ = ε a * (ε' a' * T a a') := congrArg (fun t => ε a * t) (hE' a' (fun b' => T a b'))
      _ = ε a * ε' a' * T a a' := by ring
  obtain ⟨u, hu⟩ : ∃ u : Γ(Wl, ⊤), u = ∑ b, ε b * ∑ b', ε' b' * F b b' := ⟨_, rfl⟩
  obtain ⟨u', hu'⟩ : ∃ u' : Γ(Wl, ⊤), u' = ∑ b, ε b * ∑ b', ε' b' * F' b b' := ⟨_, rfl⟩
  have hδu : ∀ a a', ε a * ε' a' * u = ε a * ε' a' * F a a' := fun a a' => by
    rw [hu]; exact hδT F a a'
  have hδu' : ∀ a a', ε a * ε' a' * u' = ε a * ε' a' * F' a a' := fun a a' => by
    rw [hu']; exact hδT F' a a'
  have huu : u * u' = 1 := by
    apply hloc
    intro a a'
    have e1 := hδu a a'
    have e2 := hδu' a a'
    have e3 := hR1 a a'
    linear_combination u' * e1 + F a a' * e2 + e3
  refine ⟨⟨u, u', huu, by rw [mul_comm]; exact huu⟩, ?_⟩
  show _ = u * _
  apply hloc
  intro a a'
  have eS : ε a * ε' a' * ∑ b, ε b * w.appTop.hom (x (j b)) =
      ε a * ε' a' * w.appTop.hom (x (j a)) := by
    calc ε a * ε' a' * ∑ b, ε b * w.appTop.hom (x (j b))
        = ε' a' * (ε a * ∑ b, ε b * w.appTop.hom (x (j b))) := by ring
      _ = ε' a' * (ε a * w.appTop.hom (x (j a))) :=
          congrArg (fun t => ε' a' * t) (hE a (fun b => w.appTop.hom (x (j b))))
      _ = ε a * ε' a' * w.appTop.hom (x (j a)) := by ring
  have eS' : ε a * ε' a' * ∑ b, ε' b * w.appTop.hom (x (j' b)) =
      ε a * ε' a' * w.appTop.hom (x (j' a')) := by
    calc ε a * ε' a' * ∑ b, ε' b * w.appTop.hom (x (j' b))
        = ε a * (ε' a' * ∑ b, ε' b * w.appTop.hom (x (j' b))) := by ring
      _ = ε a * (ε' a' * w.appTop.hom (x (j' a'))) :=
          congrArg (fun t => ε a * t) (hE' a' (fun b => w.appTop.hom (x (j' b))))
      _ = ε a * ε' a' * w.appTop.hom (x (j' a')) := by ring
  have e1 := hδu a a'
  have e4 := hR2 a a'
  linear_combination eS - u * eS' - w.appTop.hom (x (j' a')) * e1 + e4

theorem wc_yrc_partition_unit_upstairs : ∀ {X Y T Wl : Scheme.{u}} (g : X ⟶ Y) (w : Wl ⟶ Y) (f : T ⟶ Wl) (s : T ⟶ X), f ≫ w = s ≫ g → ∀ {N : ℕ} (V : Fin N → Y.Opens) (x : Fin N → Γ(Y, ⊤)) (ϖ : Γ(Y, ⊤)), IsUnit (g.appTop.hom ϖ) → (∀ j : Fin N, ∃ b : Γ(Y, V j), (Y.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom ϖ = (Y.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (x j) * b) → ∀ (n : ℕ) (ε : Fin n → Γ(Wl, ⊤)) (j : Fin n → Fin N), wcYrcAP w V n ε j → IsUnit (f.appTop.hom (∑ a, ε a * w.appTop.hom (x (j a)))) :=
by
  intro X Y T Wl g w f s hsq N V x ϖ hϖ hB1 n ε j hAP
  obtain ⟨A1, A2, A3, A4⟩ := hAP

  have sel : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (e : Fin n → R),
      (∀ a, e a * e a = e a) → (∀ a b, a ≠ b → e a * e b = 0) → ∑ a, e a = 1 →
      ∃ a₀, IsUnit (e a₀) ∧ ∀ c : Fin n → R, ∑ a, e a * c a = c a₀ := by
    intro R _ _ e h1 h2 h3
    have hex : ∃ a₀, IsUnit (e a₀) := by
      by_contra hne
      push_neg at hne
      have hm : ∑ a, e a ∈ IsLocalRing.maximalIdeal R :=
        Ideal.sum_mem _ (fun a _ => (IsLocalRing.mem_maximalIdeal _).mpr (hne a))
      rw [h3] at hm
      exact (IsLocalRing.mem_maximalIdeal _).mp hm isUnit_one
    obtain ⟨a₀, hu⟩ := hex
    have he1 : e a₀ = 1 := hu.mul_left_cancel (by rw [h1 a₀, mul_one])
    refine ⟨a₀, hu, fun c => ?_⟩
    rw [Finset.sum_eq_single_of_mem a₀ (Finset.mem_univ _)]
    · rw [he1, one_mul]
    · intro b _ hb
      have hb0 := h2 a₀ b (Ne.symm hb)
      rw [he1, one_mul] at hb0
      rw [hb0, zero_mul]
  obtain ⟨h, hh⟩ : ∃ h : T ⟶ Y, h = f ≫ w := ⟨_, rfl⟩
  have hfw : ∀ y : Γ(Y, ⊤), f.appTop.hom (w.appTop.hom y) = h.appTop.hom y := by
    intro y; rw [hh, Scheme.Hom.comp_appTop]; rfl
  have hhϖ : IsUnit (h.appTop.hom ϖ) := by
    have e1 : h.appTop.hom ϖ = s.appTop.hom (g.appTop.hom ϖ) := by
      rw [hh, hsq, Scheme.Hom.comp_appTop]; rfl
    rw [e1]; exact hϖ.map _
  apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace ⊤
  intro t _
  show IsUnit ((T.presheaf.germ ⊤ t trivial).hom _)
  set φ : Γ(T, ⊤) →+* T.presheaf.stalk t := (T.presheaf.germ ⊤ t trivial).hom with hφ
  let e : Fin n → T.presheaf.stalk t := fun a => φ (f.appTop.hom (ε a))
  have he1 : ∀ a, e a * e a = e a := fun a => by
    show φ _ * φ _ = φ _
    rw [← map_mul, ← map_mul, A1]
  have he2 : ∀ a b, a ≠ b → e a * e b = 0 := fun a b hab => by
    show φ _ * φ _ = 0
    rw [← map_mul, ← map_mul, A2 a b hab, map_zero, map_zero]
  have he3 : ∑ a, e a = 1 := by
    show ∑ a, φ (f.appTop.hom (ε a)) = 1
    rw [← map_sum, ← map_sum, A3, map_one, map_one]
  obtain ⟨a₀, hu, hc⟩ := sel e he1 he2 he3
  have hgoal : φ (f.appTop.hom (∑ a, ε a * w.appTop.hom (x (j a)))) =
      φ (h.appTop.hom (x (j a₀))) := by
    rw [map_sum, map_sum]
    simp only [map_mul, hfw]
    exact hc (fun a => φ (h.appTop.hom (x (j a))))
  rw [hgoal]

  have ht1 : t ∈ T.basicOpen (f.appTop.hom (ε a₀)) := (Scheme.mem_basicOpen_top T _ t).mpr hu
  rw [← Scheme.preimage_basicOpen_top] at ht1
  have ht2 : f t ∈ Wl.basicOpen (ε a₀) := ht1
  have ht3 : h t ∈ V (j a₀) := by
    rw [hh, Scheme.Hom.comp_apply]
    exact A4 a₀ (f t) ht2

  obtain ⟨b, hb⟩ := hB1 (j a₀)
  set sm := (h.stalkMap t).hom with hsm
  have key : ∀ y : Γ(Y, ⊤), φ (h.appTop.hom y) =
      sm ((Y.presheaf.germ (V (j a₀)) (h t) ht3).hom
        ((Y.presheaf.map (homOfLE (le_top : V (j a₀) ≤ ⊤)).op).hom y)) := by
    intro y
    rw [TopCat.Presheaf.germ_res_apply]
    exact (Scheme.Hom.germ_stalkMap_apply h ⊤ t trivial y).symm
  have hdiv : φ (h.appTop.hom ϖ) =
      φ (h.appTop.hom (x (j a₀))) * sm ((Y.presheaf.germ (V (j a₀)) (h t) ht3).hom b) := by
    rw [key, key, hb, map_mul, map_mul]
  have hu2 : IsUnit (φ (h.appTop.hom ϖ)) := hhϖ.map φ
  rw [hdiv] at hu2
  exact isUnit_of_mul_isUnit_left hu2

theorem wc_yrc_wcontr_kummer_section {X Y : Scheme.{u}} (g : X ⟶ Y) [IsAffineHom g]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (L : Type u) [Field L] (qX : X ⟶ Spec (.of L))
    (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤)))
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf X ℓ)))
    {N : ℕ} (V : Fin N → Y.Opens) (x : Fin N → Γ(Y, ⊤)) (ϖ : Γ(Y, ⊤))
    (hϖ : IsUnit (g.appTop.hom ϖ))
    (hB1 : ∀ j : Fin N, ∃ b : Γ(Y, V j),
      (Y.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom ϖ =
        (Y.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (x j) * b)
    (hB2 : ∀ j j' : Fin N, ∃ v : (Γ(Y, V j ⊓ V j'))ˣ,
      (Y.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j) =
        (v : Γ(Y, V j ⊓ V j')) * (Y.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j'))
    (κt : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → ∀ k : ℕ, (Γ(T, ⊤))ˣ → wcZModProEtExt T (ℓ ^ k) 1)
    (κΛ : ∀ (T : Scheme.{u}), (T ⟶ Spec (.of L)) → (Γ(T, ⊤))ˣ → wcIntExt T ℓ 1)
    (hK : wcYrcKummerPkg L ℓ κt κΛ) :
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    ∃ m : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).val.obj
        (Opposite.op (Scheme.ProEt.mk (⨆ j, V j).ι)),
      ∀ (Vt : Y.ProEt), wcYrcWCTR Vt → ∀ (h : Vt ⟶ Scheme.ProEt.mk (⨆ j, V j).ι),
      ∃ (n : ℕ) (ε : Fin n → Γ(Vt.left, ⊤)) (j : Fin n → Fin N), wcYrcAP Vt.hom V n ε j ∧
      ∃ e : (Γ(Limits.pullback Vt.hom g, ⊤))ˣ,
        (e : Γ(Limits.pullback Vt.hom g, ⊤)) = (Limits.pullback.fst Vt.hom g).appTop.hom
          (∑ a, ε a * (show Γ(Vt.left, ⊤) from Vt.hom.appTop.hom (x (j a)))) ∧
      ∃ (Θ : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).val.obj
            (Opposite.op Vt) ≃+ wcHM (Limits.pullback Vt.hom g) ℓ 1)
        (E : wcIntRatData (Limits.pullback Vt.hom g) ℓ),
        E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap (Limits.pullback Vt.hom g) ℓ) ∧
        (∀ (r : (wcRingSheaf Y ℓ).obj.obj (Opposite.op Vt))
          (s : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).val.obj
            (Opposite.op Vt)),
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback Vt.hom g) ℓ)) :=
            HasExt.standard _
          Θ (r • s) =
            (Abelian.Ext.mk₀ (wcHMFun (Limits.pullback Vt.hom g) ℓ
              ((show C(↥Vt.left, ULift.{u+1} ℚ_[ℓ]) from r).comp
                (Limits.pullback.fst Vt.hom g).base.hom))).comp (Θ s) (zero_add 1)) ∧
        Θ (((((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1).val.map
            h.op).hom m) =
          wcIntRho E 1 (κΛ (Limits.pullback Vt.hom g) (Limits.pullback.snd Vt.hom g ≫ qX) e) :=
by
  classical
  intro P
  haveI := Dg.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
  obtain ⟨Ψ, hlin, hnat⟩ := wc_proet_push_homology_sections_hm g ℓ Dg hDg I 1
  obtain ⟨P1, P2, P3, P4⟩ := hK
  have hcompT : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (f' : B ⟶ C) (y : Γ(C, ⊤)),
      (f ≫ f').appTop.hom y = f.appTop.hom (f'.appTop.hom y) := by
    intro A B C f f' y
    rw [Scheme.Hom.comp_appTop]
    rfl

  have hcovV : ∀ (W : Y.ProEt) (b₀ : W ⟶ Scheme.ProEt.mk (⨆ j, V j).ι) (v : W.left),
      ∃ j, W.hom v ∈ V j := by
    intro W b₀ v
    have hw := MorphismProperty.Over.w b₀
    have hv : W.hom v = (⨆ j, V j).ι (b₀.left v) := by
      rw [← hw, Scheme.Hom.comp_apply]
      rfl
    have hmem : W.hom v ∈ (⨆ j, V j) := by
      rw [hv]
      have : ((⨆ j, V j).ι (b₀.left v)) ∈ ((⨆ j, V j : Y.Opens) : Set Y) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨_, rfl⟩
      exact this
    exact TopologicalSpace.Opens.mem_iSup.mp hmem

  choose n ε j hA using fun (W : Y.ProEt) (hW : wcYrcWCTR W)
      (b₀ : W ⟶ Scheme.ProEt.mk (⨆ j, V j).ι) =>
    wc_yrc_wcontr_clopen_partition V W hW (hcovV W b₀)
  have hu : ∀ (W : Y.ProEt) (hW : wcYrcWCTR W) (b₀ : W ⟶ Scheme.ProEt.mk (⨆ j, V j).ι),
      IsUnit ((Limits.pullback.fst W.hom g).appTop.hom
        (∑ a, ε W hW b₀ a * (show Γ(W.left, ⊤) from W.hom.appTop.hom (x (j W hW b₀ a))))) :=
    fun W hW b₀ => wc_yrc_partition_unit_upstairs g W.hom (Limits.pullback.fst W.hom g)
      (Limits.pullback.snd W.hom g) Limits.pullback.condition V x ϖ hϖ hB1 _ _ _ (hA W hW b₀)
  choose Erat hErat using fun S : Scheme.{u} => wc_int_rat_data_exists S ℓ

  obtain ⟨cl, hcl⟩ : ∃ cl : ∀ W : Y.ProEt, (W ⟶ Scheme.ProEt.mk (⨆ j, V j).ι) →
      wcHM (Limits.pullback W.hom g) ℓ 1,
      ∀ (W : Y.ProEt) (b₀ : W ⟶ Scheme.ProEt.mk (⨆ j, V j).ι) (hW : wcYrcWCTR W),
        cl W b₀ = wcIntRho (Erat (Limits.pullback W.hom g)) 1
          (κΛ (Limits.pullback W.hom g) (Limits.pullback.snd W.hom g ≫ qX) (hu W hW b₀).unit) :=
    ⟨fun W b₀ => if hW : wcYrcWCTR W then wcIntRho (Erat (Limits.pullback W.hom g)) 1
          (κΛ (Limits.pullback W.hom g) (Limits.pullback.snd W.hom g ≫ qX) (hu W hW b₀).unit)
        else 0, fun W b₀ hW => dif_pos hW⟩

  have hsepG : ∀ (S : Scheme.{u}) (y y' : wcIntExt S ℓ 1),
      (∀ k : ℕ, 1 ≤ k → wcIntRed S ℓ k 1 y = wcIntRed S ℓ k 1 y') → y = y' := by
    intro S y y' hyy
    obtain ⟨hTr, ht⟩ := wc_int_red_transfer S ℓ
    have h0 := (wc_int_red_milnor S ℓ hTr ht 1).2.2.1 (wc_zmod_deg0_lim1_zero S ℓ) (y - y')
      (fun k hk => by rw [map_sub, hyy k hk, sub_self])
    exact sub_eq_zero.mp h0

  have hredG : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (DΛ : wcIntPullData f ℓ),
      wcIntPullCanonical DΛ → ∀ (Dk : ∀ k : ℕ, wcZModPullData f (ℓ ^ k)),
      (∀ k, wcZModPullCanonical (Dk k)) → ∀ (k : ℕ) (y : wcIntExt S ℓ 1),
      wcIntRed S' ℓ k 1 (wcIntPull DΛ 1 y) = wcZModPull (Dk k) 1 (wcIntRed S ℓ k 1 y) := by
    intro S S' f DΛ hDΛ Dk hDk
    obtain ⟨hTr, ht⟩ := wc_int_red_transfer S ℓ
    obtain ⟨hTr', ht'⟩ := wc_int_red_transfer S' ℓ
    exact (wc_int_red_pull_compat ℓ f DΛ Dk hTr ht hTr' ht'
      (fun k => wc_int_zmod_pull_restrict_iso ℓ f k DΛ hDΛ (Dk k) (hDk k)) 1).1

  have hrootG : ∀ (Z : Scheme.{u}) [IsAffine Z], IsClosed {x : Z | IsClosed ({x} : Set Z)} →
      (∀ x : Z, ∃! y : Z, IsClosed ({y} : Set Z) ∧ x ⤳ y) →
      (∀ x : Z, IsClosed ({x} : Set Z) →
        HenselianLocalRing (Z.presheaf.stalk x) ∧ IsSepClosed (Z.residueField x)) →
      IsUnit ((ℓ : ℕ) : Γ(Z, ⊤)) → ∀ (k : ℕ) (u : (Γ(Z, ⊤))ˣ), ∃ c : (Γ(Z, ⊤))ˣ, c ^ (ℓ ^ k) = u := by
    intro Z _ hc hsp hs hℓ k u
    induction k with
    | zero => exact ⟨u, by rw [pow_zero, pow_one]⟩
    | succ k ih =>
      obtain ⟨c, hc'⟩ := ih
      obtain ⟨b', hb'⟩ := wc_qmtm_wlocal_unit_root Z hc hsp hs ℓ hℓ (c : Γ(Z, ⊤)) c.isUnit
      have hbu : IsUnit b' :=
        (isUnit_pow_iff (Nat.Prime.ne_zero (Fact.out : Nat.Prime ℓ))).mp (hb' ▸ c.isUnit)
      have hB : hbu.unit ^ ℓ = c :=
        Units.ext (by rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hb'])
      exact ⟨hbu.unit, by rw [pow_succ', pow_mul, hB, hc']⟩

  have hs7 : ∀ (T T' : Scheme.{u}) (qT : T ⟶ Spec (.of L)) (qT' : T' ⟶ Spec (.of L))
      (p : T' ⟶ T), p ≫ qT = qT' →
      (∀ y y' : wcIntExt T' ℓ 1,
        (∀ k : ℕ, 1 ≤ k → wcIntRed T' ℓ k 1 y = wcIntRed T' ℓ k 1 y') → y = y') →
      ∀ (DΛ : wcIntPullData p ℓ) (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)),
      (∀ k, wcZModPullCanonical (Dk k)) →
      (∀ (k : ℕ) (y : wcIntExt T ℓ 1),
        wcIntRed T' ℓ k 1 (wcIntPull DΛ 1 y) = wcZModPull (Dk k) 1 (wcIntRed T ℓ k 1 y)) →
      ∀ (e : (Γ(T, ⊤))ˣ) (e' U : (Γ(T', ⊤))ˣ), e' = U * Units.map p.appTop.hom.toMonoidHom e →
      (∀ k : ℕ, 1 ≤ k → ∃ c : (Γ(T', ⊤))ˣ, c ^ (ℓ ^ k) = U) →
      κΛ T' qT' e' = wcIntPull DΛ 1 (κΛ T qT e) := by
    intro T T' qT qT' p hpq hsep DΛ Dk hDk hred e e' U he' hU
    subst he'
    apply hsep
    intro k hk
    rw [P4 T' qT' k _ hk, hred k, P4 T qT k e hk, P2 T T' qT qT' p hpq k (Dk k) (hDk k) e, P1,
      (P3 T' qT' k U hk).mpr (hU k hk), zero_add]

  have hcoc : ∀ (W W' : Y.ProEt) (b₀ : W ⟶ Scheme.ProEt.mk (⨆ j, V j).ι) (b : W' ⟶ W),
      wcYrcWCTR W → wcYrcWCTR W' → ∀ (p : Limits.pullback W'.hom g ⟶ Limits.pullback W.hom g),
      p ≫ Limits.pullback.fst W.hom g = Limits.pullback.fst W'.hom g ≫ b.left →
      p ≫ Limits.pullback.snd W.hom g = Limits.pullback.snd W'.hom g →
      ∀ (Db : wcHMPullData p ℓ), wcHMPullCanonical Db →
      cl W' (b ≫ b₀) = wcHMPull Db 1 (cl W b₀) := by
    intro W W' b₀ b hW hW' p hp1 hp2 Db hDb
    rw [hcl W' (b ≫ b₀) hW', hcl W b₀ hW]
    obtain ⟨hA1, hA2, hA3, hA4⟩ := hA W hW b₀
    have hA'' : wcYrcAP W'.hom V (n W hW b₀) (fun a => b.left.appTop.hom (ε W hW b₀ a))
        (j W hW b₀) := by
      refine ⟨fun a => ?_, fun a a' haa => ?_, ?_, fun a v hv => ?_⟩
      · beta_reduce
        rw [← map_mul, hA1 a]
      · beta_reduce
        rw [← map_mul, hA2 a a' haa, map_zero]
      · beta_reduce
        rw [← map_sum, hA3, map_one]
      · beta_reduce at hv
        have hv' : v ∈ b.left ⁻¹ᵁ W.left.basicOpen (ε W hW b₀ a) := by
          first
            | (rw [Scheme.preimage_basicOpen_top]; exact hv)
            | (rw [Scheme.preimage_basicOpen]; exact hv)
        have h1 := hA4 a (b.left v) hv'
        rw [← MorphismProperty.Over.w b, Scheme.Hom.comp_apply]
        exact h1
    have hpullE : b.left.appTop.hom (∑ a, ε W hW b₀ a *
          (show Γ(W.left, ⊤) from W.hom.appTop.hom (x (j W hW b₀ a)))) =
        ∑ a, b.left.appTop.hom (ε W hW b₀ a) *
          (show Γ(W'.left, ⊤) from W'.hom.appTop.hom (x (j W hW b₀ a))) := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [map_mul]
      congr 1
      show b.left.appTop.hom (W.hom.appTop.hom (x (j W hW b₀ a))) =
        W'.hom.appTop.hom (x (j W hW b₀ a))
      rw [← hcompT, MorphismProperty.Over.w b]
    haveI : IsAffine W'.left := hW'.1
    obtain ⟨u, hu'⟩ := @wc_yrc_partition_ratio_unit W'.left Y _ W'.hom N V x hB2 _ _
      (ε W' hW' (b ≫ b₀)) (j W' hW' (b ≫ b₀)) _ _ (hA W' hW' (b ≫ b₀)) hA''
    beta_reduce at hu'
    have hUe : (hu W' hW' (b ≫ b₀)).unit =
        Units.map (Limits.pullback.fst W'.hom g).appTop.hom.toMonoidHom u *
          Units.map p.appTop.hom.toMonoidHom (hu W hW b₀).unit := by
      apply Units.ext
      rw [Units.val_mul, Units.coe_map, Units.coe_map, IsUnit.unit_spec, IsUnit.unit_spec]
      show (Limits.pullback.fst W'.hom g).appTop.hom _ =
        (Limits.pullback.fst W'.hom g).appTop.hom (u : Γ(W'.left, ⊤)) *
          p.appTop.hom ((Limits.pullback.fst W.hom g).appTop.hom _)
      rw [hu', map_mul, ← hpullE, ← hcompT, ← hcompT, hp1]
    have hℓ' : IsUnit ((ℓ : ℕ) : Γ(W'.left, ⊤)) := by
      have := hℓY.map W'.hom.appTop.hom
      rwa [map_natCast] at this
    have hUroot : ∀ k : ℕ, 1 ≤ k → ∃ c : (Γ(Limits.pullback W'.hom g, ⊤))ˣ,
        c ^ (ℓ ^ k) = Units.map (Limits.pullback.fst W'.hom g).appTop.hom.toMonoidHom u := by
      intro k _
      obtain ⟨c₀, hc₀⟩ := hrootG W'.left hW'.2.1 hW'.2.2.1 hW'.2.2.2.2 hℓ' k u
      exact ⟨Units.map (Limits.pullback.fst W'.hom g).appTop.hom.toMonoidHom c₀,
        by rw [← map_pow, hc₀]⟩
    obtain ⟨DΛ, hDΛ⟩ := wc_int_pull_data_exists p ℓ
    choose Dk hDk using fun k : ℕ => wc_zmod_pull_data_exists p (ℓ ^ k)
    have hpq : p ≫ (Limits.pullback.snd W.hom g ≫ qX) = Limits.pullback.snd W'.hom g ≫ qX := by
      rw [← Category.assoc, hp2]
    rw [hs7 _ _ _ _ p hpq (hsepG _) DΛ Dk hDk (hredG p DΛ hDΛ Dk hDk) _ _ _ hUe hUroot]
    exact wc_int_rat_pull_compat ℓ p Db hDb DΛ hDΛ _ (hErat _) _ (hErat _) 1 _

  have hproj : ∀ W : Y.ProEt, wcYrcWCTR W → Projective (wcFreeSheaf Y W) :=
    fun W hW => wc_proet_free_projective_wcontractible Y W hW
  have hcov : ∀ Z : Y.ProEt, Sieve.generate (fun (T : Y.ProEt) (_ : T ⟶ Z) => wcYrcWCTR T) ∈
      Scheme.ProEt.topology Y Z := by
    intro Z
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (wc_proet_wcontr_affine_open_cover (𝟙 Y) Z)
    intro T f hf
    exact hf.2
  obtain ⟨m, hm⟩ := wc_yrc_push_section_of_wcontr_classes g ℓ Dg I 1 Ψ hnat hproj hcov _ cl hcoc

  refine ⟨m, fun Vt hW h => ⟨n Vt hW h, ε Vt hW h, j Vt hW h, hA Vt hW h, (hu Vt hW h).unit,
    (hu Vt hW h).unit_spec, Ψ Vt (hproj Vt hW), Erat _, hErat _, fun r s => hlin Vt _ r s, ?_⟩⟩
  rw [hm Vt h hW (hproj Vt hW), hcl Vt h hW]

theorem wc_fromSpecStalk_partition_eval : ∀ (W : Scheme.{u}) (n : ℕ) (ε : Fin n → Γ(W, ⊤)), (∀ a, ε a * ε a = ε a) → (∀ a b, a ≠ b → ε a * ε b = 0) → ∑ a, ε a = 1 → ∀ w : W, ∃ a₀ : Fin n, w ∈ W.basicOpen (ε a₀) ∧ ∀ F : Fin n → Γ(W, ⊤), (W.fromSpecStalk w).appTop.hom (∑ a, ε a * F a) = (W.fromSpecStalk w).appTop.hom (F a₀) :=
by
  intro W n ε hidem horth hsum w
  classical
  have hex : ∃ a₀, IsUnit ((W.presheaf.germ ⊤ w trivial).hom (ε a₀)) := by
    by_contra hcon
    push_neg at hcon
    have hmem : ∀ a ∈ (Finset.univ : Finset (Fin n)),
        (W.presheaf.germ ⊤ w trivial).hom (ε a) ∈
          IsLocalRing.maximalIdeal (W.presheaf.stalk w) :=
      fun a _ => (IsLocalRing.mem_maximalIdeal _).mpr ((mem_nonunits_iff).mpr (hcon a))
    have h1 := Ideal.sum_mem _ hmem
    rw [← map_sum, hsum, map_one] at h1
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)) isUnit_one
  obtain ⟨a₀, hu⟩ := hex
  have h1 : (W.presheaf.germ ⊤ w trivial).hom (ε a₀) = 1 := by
    have h := congrArg (W.presheaf.germ ⊤ w trivial).hom (hidem a₀)
    rw [map_mul] at h
    have h2 : (W.presheaf.germ ⊤ w trivial).hom (ε a₀) * (W.presheaf.germ ⊤ w trivial).hom (ε a₀)
        = 1 * (W.presheaf.germ ⊤ w trivial).hom (ε a₀) := by rw [h, one_mul]
    exact hu.mul_left_inj.mp h2
  have h0 : ∀ b, b ≠ a₀ → (W.presheaf.germ ⊤ w trivial).hom (ε b) = 0 := by
    intro b hb
    have h := congrArg (W.presheaf.germ ⊤ w trivial).hom (horth b a₀ hb)
    rw [map_mul, map_zero] at h
    exact hu.mul_left_eq_zero.mp h
  have hstalk : ∀ F : Fin n → Γ(W, ⊤), (W.presheaf.germ ⊤ w trivial).hom (∑ a, ε a * F a)
      = (W.presheaf.germ ⊤ w trivial).hom (F a₀) := by
    intro F
    rw [map_sum, Finset.sum_eq_single a₀]
    · rw [map_mul, h1, one_mul]
    · intro b _ hb
      rw [map_mul, h0 b hb, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ a₀) h
  refine ⟨a₀, (Scheme.mem_basicOpen_top W (ε a₀) w).mpr hu, fun F => ?_⟩
  rw [Scheme.fromSpecStalk_appTop]
  simp only [CommRingCat.hom_comp, RingHom.comp_apply]
  rw [hstalk F]

theorem wc_yrc_wcontr_torsion_h1_bij : ∀ {W T : Scheme.{u}} (haff : IsAffine W) (hc : IsClosed {x : W | IsClosed ({x} : Set W)}) (hu : ∀ x : W, ∃! y : W, IsClosed ({y} : Set W) ∧ x ⤳ y) (h : T ⟶ W) (hqc : QuasiCompact h) (hqs : QuasiSeparated h) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ), 1 ≤ k → ∀ (z : wcZModProEtExt T (ℓ ^ k) 1), (∀ w : W, IsClosed ({w} : Set W) → ∀ (Dz : wcZModPullData (Limits.pullback.snd (W.fromSpecStalk w) h) (ℓ ^ k)), wcZModPullCanonical Dz → Nat.card (wcZModProEtExt (Limits.pullback (W.fromSpecStalk w) h) (ℓ ^ k) 1) = ℓ ^ k ∧ IsAddCyclic (wcZModProEtExt (Limits.pullback (W.fromSpecStalk w) h) (ℓ ^ k) 1) ∧ (ℓ ^ (k - 1)) • wcZModPull Dz 1 z ≠ 0) → letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _; Function.Bijective (fun a : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (a.comp h.base.hom))).comp z (zero_add 1)) :=
by
  intro W T haff hc hu h hqc hqs ℓ _ k hk z hstalk
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
  classical
  have hℓ : ℓ.Prime := Fact.out
  haveI hNZ : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ hℓ.ne_zero⟩
  haveI := haff

  have hFunOne : ∀ (S : Scheme.{u}) (m : ℕ), wcZModFun S m 1 = 𝟙 _ := by
    intro S m
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hFunMul : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r * r') = wcZModFun S m r ≫ wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    show _ = ((wcZModFun S m r').val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V)
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hFunAdd : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r + r') = wcZModFun S m r + wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have G0 : ∀ (S : Scheme.{u}) (r r' : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))), r = r' →
      ∀ x : wcZModProEtExt S (ℓ ^ k) 1,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r)).comp x (zero_add 1) =
        (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r')).comp x (zero_add 1) := by
    intro S r r' hr x
    subst hr
    rfl
  have G1 : ∀ (S : Scheme.{u}) (r : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))), r = 1 →
      ∀ x : wcZModProEtExt S (ℓ ^ k) 1,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r)).comp x (zero_add 1) = x := by
    intro S r hr x
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
    subst hr
    rw [hFunOne]
    exact Abelian.Ext.mk₀_id_comp x
  have G2 : ∀ (S : Scheme.{u}) (r r1 r2 : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))), r = r1 * r2 →
      ∀ x : wcZModProEtExt S (ℓ ^ k) 1,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r)).comp x (zero_add 1) =
        (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r1)).comp
          ((Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r2)).comp x (zero_add 1)) (zero_add 1) := by
    intro S r r1 r2 hr x
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
    subst hr
    rw [hFunMul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have G3 : ∀ (S : Scheme.{u}) (r r1 r2 : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))), r = r1 + r2 →
      ∀ x : wcZModProEtExt S (ℓ ^ k) 1,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r)).comp x (zero_add 1) =
        (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r1)).comp x (zero_add 1) +
          (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r2)).comp x (zero_add 1) := by
    intro S r r1 r2 hr x
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
    subst hr
    rw [hFunAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]
  have GZ : ∀ (S : Scheme.{u}) (x : wcZModProEtExt S (ℓ ^ k) 1),
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) 0)).comp x (zero_add 1) = 0 := by
    intro S x
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
    have h00 := G3 S 0 0 0 (add_zero 0).symm x
    generalize (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) 0)).comp x (zero_add 1) = y at h00 ⊢
    calc y = (y + y) - y := by abel
      _ = y - y := by rw [← h00]
      _ = 0 := sub_self y
  have GN : ∀ (S : Scheme.{u}) (x : wcZModProEtExt S (ℓ ^ k) 1) (n : ℕ),
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k)
        (ContinuousMap.const _ (ULift.up ((n : ℕ) : ZMod (ℓ ^ k)))))).comp x (zero_add 1) = n • x := by
    intro S x n
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
    induction n with
    | zero =>
      have hr0 : (ContinuousMap.const _ (ULift.up ((0 : ℕ) : ZMod (ℓ ^ k))) :
          C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))) = 0 := by
        apply ContinuousMap.ext
        intro y
        apply ULift.ext
        show ((0 : ℕ) : ZMod (ℓ ^ k)) = 0
        exact Nat.cast_zero
      rw [G0 S _ 0 hr0 x, GZ S x, zero_nsmul]
    | succ n ih =>
      have hr : (ContinuousMap.const _ (ULift.up (((n + 1 : ℕ) : ℕ) : ZMod (ℓ ^ k))) :
          C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))) =
          ContinuousMap.const _ (ULift.up ((n : ℕ) : ZMod (ℓ ^ k))) + 1 := by
        apply ContinuousMap.ext
        intro y
        apply ULift.ext
        show (((n + 1 : ℕ) : ℕ) : ZMod (ℓ ^ k)) = ((n : ℕ) : ZMod (ℓ ^ k)) + 1
        exact Nat.cast_succ n
      rw [G3 S _ _ 1 hr x, ih, G1 S 1 rfl x, succ_nsmul]
  have GC : ∀ (S : Scheme.{u}) (c : ZMod (ℓ ^ k)) (x : wcZModProEtExt S (ℓ ^ k) 1),
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) (ContinuousMap.const _ (ULift.up c)))).comp x
        (zero_add 1) = c.val • x := by
    intro S c x
    have h1 := GN S x c.val
    rwa [ZMod.natCast_zmod_val] at h1

  obtain ⟨χ, hχdef⟩ : ∃ χ : ∀ V : Set W, IsClopen V → C(↥T, ULift.{u+1} (ZMod (ℓ ^ k))),
      ∀ (V : Set W) (hV : IsClopen V), χ V hV =
        (LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV).toContinuousMap.comp h.base.hom :=
    ⟨_, fun _ _ => rfl⟩
  have hχ : ∀ (V : Set W) (hV : IsClopen V) (x : T),
      χ V hV x = V.indicator 1 (h.base.hom x) := by
    intro V hV x
    rw [hχdef]
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV) (h.base.hom x) = _
    rw [LocallyConstant.coe_charFn]
  obtain ⟨e, he⟩ : ∃ e : ∀ V : Set W, IsClopen V →
      (wcZModProEtExt T (ℓ ^ k) 1 →+ wcZModProEtExt T (ℓ ^ k) 1),
      ∀ (V : Set W) (hV : IsClopen V) η, e V hV η =
        (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (χ V hV))).comp η (zero_add 1) :=
    ⟨fun V hV => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (χ V hV))).precomp _ (zero_add 1),
      fun _ _ _ => rfl⟩
  have he1 : ∀ η, e Set.univ isClopen_univ η = η := by
    intro η
    have hf : χ Set.univ isClopen_univ = 1 :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans (congrFun (Set.indicator_univ _) _)
    exact (he _ _ η).trans (G1 _ _ hf η)
  have hei : ∀ (V V' : Set W) (hV : IsClopen V) (hV' : IsClopen V') η,
      e (V ∩ V') (hV.inter hV') η = e V hV (e V' hV' η) := by
    intro V V' hV hV' η
    have hf : χ (V ∩ V') (hV.inter hV') = χ V hV * χ V' hV' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.inter_indicator_one (M₀ := ULift.{u+1} (ZMod (ℓ ^ k))) (s := V) (t := V')) _).trans
          (congrArg₂ (· * ·) (hχ V hV x) (hχ V' hV' x)).symm)
    exact (he _ _ η).trans ((G2 _ _ _ _ hf η).trans
      ((congrArg (fun y => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (χ V hV))).comp y
          (zero_add 1)) (he V' hV' η).symm).trans (he V hV _).symm))
  have heu : ∀ (V V' : Set W) (hV : IsClopen V) (hV' : IsClopen V'), Disjoint V V' → ∀ η,
      e (V ∪ V') (hV.union hV') η = e V hV η + e V' hV' η := by
    intro V V' hV hV' hdisj η
    have hf : χ (V ∪ V') (hV.union hV') = χ V hV + χ V' hV' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.indicator_union_of_disjoint hdisj (1 : W → ULift.{u+1} (ZMod (ℓ ^ k)))) _).trans
          (congrArg₂ (· + ·) (hχ V hV x) (hχ V' hV' x)).symm)
    exact (he _ _ η).trans ((G3 _ _ _ _ hf η).trans
      (congrArg₂ (· + ·) (he V hV η).symm (he V' hV' η).symm))

  obtain ⟨ι, hι⟩ : ∃ ι : ZMod (ℓ ^ k) →+ wcZModProEtExt T (ℓ ^ k) 1, ∀ c, ι c =
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (ContinuousMap.const _ (ULift.up c)))).comp z
        (zero_add 1) :=
    ⟨AddMonoidHom.mk' (fun c => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
        (ContinuousMap.const _ (ULift.up c)))).comp z (zero_add 1))
      (fun c d => G3 T (ContinuousMap.const _ (ULift.up (c + d)))
        (ContinuousMap.const _ (ULift.up c)) (ContinuousMap.const _ (ULift.up d))
        (ContinuousMap.ext fun _ => rfl) z), fun _ => rfl⟩

  have stalk : ∀ (w : W) (Dz : wcZModPullData (Limits.pullback.snd (W.fromSpecStalk w) h) (ℓ ^ k)),
      wcZModPullCanonical Dz →
      Nat.card (wcZModProEtExt (Limits.pullback (W.fromSpecStalk w) h) (ℓ ^ k) 1) = ℓ ^ k →
      (ℓ ^ (k - 1)) • wcZModPull Dz 1 z ≠ 0 →
      (∀ η, ∃ c : ZMod (ℓ ^ k), wcZModPull Dz 1 η = wcZModPull Dz 1 (ι c)) ∧
      (∀ (c : ZMod (ℓ ^ k)) (V : Set W) (hV : IsClopen V), w ∈ V → e V hV (ι c) = 0 → c = 0) := by
    intro w Dz hDz hcard hne
    set γ := wcZModPull Dz 1 z with hγ
    haveI hfin : Finite (wcZModProEtExt (Limits.pullback (W.fromSpecStalk w) h) (ℓ ^ k) 1) :=
      Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero _ hℓ.ne_zero)
    have hord : addOrderOf γ = ℓ ^ k := by
      have hdvd : addOrderOf γ ∣ ℓ ^ k := (addOrderOf_dvd_natCard γ).trans hcard.dvd
      obtain ⟨i, hi, hi'⟩ := (Nat.dvd_prime_pow hℓ).mp hdvd
      by_cases hik : i ≤ k - 1
      · exact absurd (addOrderOf_dvd_iff_nsmul_eq_zero.mp (by rw [hi']; exact pow_dvd_pow ℓ hik)) hne
      · rw [hi']; congr 1; omega
    have htop : AddSubgroup.zmultiples γ = ⊤ := by
      apply AddSubgroup.eq_top_of_card_eq
      rw [Nat.card_zmultiples, hord, hcard]
    have hsurjγ : ∀ η', ∃ c : ZMod (ℓ ^ k), c.val • γ = η' := by
      intro η'
      have hm : η' ∈ AddSubgroup.zmultiples γ := by rw [htop]; exact AddSubgroup.mem_top η'
      obtain ⟨t, ht⟩ := AddSubgroup.mem_zmultiples_iff.mp hm
      refine ⟨(t : ZMod (ℓ ^ k)), ?_⟩
      have hmod := mod_addOrderOf_zsmul γ t
      rw [hord] at hmod
      rw [← natCast_zsmul, ZMod.val_intCast, hmod, ht]
    have hinjγ : ∀ c : ZMod (ℓ ^ k), c.val • γ = 0 → c = 0 := by
      intro c hc0
      have h1 : addOrderOf γ ∣ c.val := addOrderOf_dvd_of_nsmul_eq_zero hc0
      rw [hord] at h1
      exact (ZMod.val_eq_zero c).mp (Nat.eq_zero_of_dvd_of_lt h1 (ZMod.val_lt c))
    have hpullι : ∀ c, wcZModPull Dz 1 (ι c) = c.val • γ := by
      intro c
      rw [hι]
      exact (wc_zmod_pull_fun Dz hDz _ 1 z).trans
        ((G0 _ _ _ (ContinuousMap.const_comp _ _) _).trans (GC _ c _))
    have hpt : ∀ t : ↥(Limits.pullback (W.fromSpecStalk w) h),
        h ((Limits.pullback.snd (W.fromSpecStalk w) h) t) =
        W.fromSpecStalk w ((Limits.pullback.fst (W.fromSpecStalk w) h) t) := by
      intro t
      have h1 := Scheme.Hom.comp_apply (Limits.pullback.snd (W.fromSpecStalk w) h) h t
      have h2 := Scheme.Hom.comp_apply (Limits.pullback.fst (W.fromSpecStalk w) h)
        (W.fromSpecStalk w) t
      rw [← h1, ← h2, Limits.pullback.condition]
    have hkill : ∀ (V : Set W) (hV : IsClopen V), w ∈ V → ∀ η,
        wcZModPull Dz 1 (e V hV η) = wcZModPull Dz 1 η := by
      intro V hV hwV η
      have hone : (χ V hV).comp (Limits.pullback.snd (W.fromSpecStalk w) h).base.hom = 1 := by
        apply ContinuousMap.ext
        intro t
        have hmem : h ((Limits.pullback.snd (W.fromSpecStalk w) h) t) ∈ V := by
          rw [hpt t]
          have hr : W.fromSpecStalk w ((Limits.pullback.fst (W.fromSpecStalk w) h) t) ∈
              Set.range (W.fromSpecStalk w) := ⟨_, rfl⟩
          rw [Scheme.range_fromSpecStalk] at hr
          exact Specializes.mem_open hr hV.isOpen hwV
        show χ V hV ((Limits.pullback.snd (W.fromSpecStalk w) h).base.hom t) = 1
        exact (hχ V hV _).trans (Set.indicator_of_mem hmem _)
      exact (congrArg (wcZModPull Dz 1) (he V hV η)).trans
        ((wc_zmod_pull_fun Dz hDz (χ V hV) 1 η).trans (G1 _ _ hone _))
    refine ⟨fun η => ?_, fun c V hV hwV h0 => ?_⟩
    · obtain ⟨c, hcη⟩ := hsurjγ (wcZModPull Dz 1 η)
      exact ⟨c, hcη.symm.trans (hpullι c).symm⟩
    · apply hinjγ
      rw [← hpullι, ← hkill V hV hwV, h0, map_zero]

  have hZ : ∀ x : W, ∃ w ∈ {x : W | IsClosed ({x} : Set W)}, x ⤳ w := by
    intro x
    obtain ⟨y, ⟨hy, hxy⟩, _⟩ := hu x
    exact ⟨y, hy, hxy⟩
  have hs : ∀ w ∈ {x : W | IsClosed ({x} : Set W)}, ∀ η : wcZModProEtExt T (ℓ ^ k) 1,
      ∃ (c : ZMod (ℓ ^ k)) (V : Set W) (hV : IsClopen V), w ∈ V ∧ e V hV η = e V hV (ι c) := by
    intro w hw η
    obtain ⟨Dsn, hDsn⟩ :=
      wc_zmod_pull_data_exists (Limits.pullback.snd (W.fromSpecStalk w) h) (ℓ ^ k)
    obtain ⟨hcard, -, hne⟩ := hstalk w hw Dsn hDsn
    obtain ⟨c, hcη⟩ := (stalk w Dsn hDsn hcard hne).1 η
    obtain ⟨d, hd⟩ : ∃ d : wcZModProEtExt T (ℓ ^ k) 1, d = η - ι c := ⟨_, rfl⟩
    have h0 : wcZModPull Dsn 1 d = 0 := by
      rw [hd, map_sub, hcη, sub_self]
    obtain ⟨V, hV, hwV, hV0⟩ := wc_zmod_wlocal_closed_point_continuity haff hc hu h hqc hqs
      (ℓ ^ k) 1 w hw Dsn hDsn d h0
    refine ⟨c, V, hV, hwV, ?_⟩
    have h1 : e V hV d = 0 := (he _ _ _).trans ((G0 _ _ _ (hχdef V hV) _).trans hV0)
    have h2 : e V hV η - e V hV (ι c) = 0 := by rw [← map_sub, ← hd, h1]
    exact sub_eq_zero.mp h2
  have hi : ∀ w ∈ {x : W | IsClosed ({x} : Set W)}, ∀ (c : ZMod (ℓ ^ k)) (V : Set W)
      (hV : IsClopen V), w ∈ V → e V hV (ι c) = 0 → c = 0 := by
    intro w hw c V hV hwV h0
    obtain ⟨Dsn, hDsn⟩ :=
      wc_zmod_pull_data_exists (Limits.pullback.snd (W.fromSpecStalk w) h) (ℓ ^ k)
    obtain ⟨hcard, -, hne⟩ := hstalk w hw Dsn hDsn
    exact (stalk w Dsn hDsn hcard hne).2 c V hV hwV h0
  haveI : CompactSpace ↥W := inferInstance
  obtain ⟨Ξ, hΞ⟩ := wc_lc_clopen_assembly (W₀ := ↥W) (A := ZMod (ℓ ^ k)) e he1 hei heu ι
    {x : W | IsClosed ({x} : Set W)} hZ hs hi

  obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) →+ wcZModProEtExt T (ℓ ^ k) 1,
      ∀ a, Ψ a = (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (a.comp h.base.hom))).comp z (zero_add 1) :=
    ⟨AddMonoidHom.mk' (fun a => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (a.comp h.base.hom))).comp z
        (zero_add 1)) (fun a b => G3 T ((a + b).comp h.base.hom) (a.comp h.base.hom)
          (b.comp h.base.hom) (ContinuousMap.add_comp a b h.base.hom) z), fun _ => rfl⟩
  have hloc : ∀ a : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))), IsLocallyConstant (fun x => (a x).down) :=
    fun a => ((IsLocallyConstant.iff_continuous (⇑a)).2 a.continuous).comp ULift.down
  let conv : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) → LocallyConstant (↥W) (ZMod (ℓ ^ k)) :=
    fun a => ⟨fun x => (a x).down, hloc a⟩
  have hconv : Function.Bijective conv := by
    refine ⟨fun a b hab => ?_, fun b => ⟨(b.map (ULift.up : ZMod (ℓ ^ k) →
      ULift.{u+1} (ZMod (ℓ ^ k)))).toContinuousMap, ?_⟩⟩
    · apply ContinuousMap.ext
      intro x
      have h1 := congrArg (fun f : LocallyConstant (↥W) (ZMod (ℓ ^ k)) => f x) hab
      exact congrArg ULift.up h1
    · apply LocallyConstant.ext
      intro x
      rfl
  have hgenZ : ∀ (V : Set W) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (b : ZMod (ℓ ^ k)) (x : W),
      ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then b else 0)) x =
        if x ∈ V then b else 0 := by
    intro V _ hV b x
    rw [LocallyConstant.map_apply, Function.comp_apply]
    by_cases hx : x ∈ V
    · have h0 : (LocallyConstant.ofIsClopen hV) x = 0 := by
        have h2 : x ∈ (LocallyConstant.ofIsClopen hV) ⁻¹' {0} := by
          rw [LocallyConstant.ofIsClopen_fiber_zero]; exact hx
        exact h2
      rw [h0, if_pos rfl, if_pos hx]
    · have h1 : (LocallyConstant.ofIsClopen hV) x = 1 := by
        have h2 : x ∈ (LocallyConstant.ofIsClopen hV) ⁻¹' {1} := by
          rw [LocallyConstant.ofIsClopen_fiber_one]; exact hx
        exact h2
      rw [h1, if_neg (by decide), if_neg hx]
  have hgenU : ∀ (V : Set W) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V)
      (b : ULift.{u+1} (ZMod (ℓ ^ k))) (x : W),
      ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then b else 0)).toContinuousMap x =
        if x ∈ V then b else 0 := by
    intro V _ hV b x
    show ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then b else 0)) x = _
    rw [LocallyConstant.map_apply, Function.comp_apply]
    by_cases hx : x ∈ V
    · have h0 : (LocallyConstant.ofIsClopen hV) x = 0 := by
        have h2 : x ∈ (LocallyConstant.ofIsClopen hV) ⁻¹' {0} := by
          rw [LocallyConstant.ofIsClopen_fiber_zero]; exact hx
        exact h2
      rw [h0, if_pos rfl, if_pos hx]
    · have h1 : (LocallyConstant.ofIsClopen hV) x = 1 := by
        have h2 : x ∈ (LocallyConstant.ofIsClopen hV) ⁻¹' {1} := by
          rw [LocallyConstant.ofIsClopen_fiber_one]; exact hx
        exact h2
      rw [h1, if_neg (by decide), if_neg hx]
  have hgenΨ : ∀ (V : Set W) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (c : ZMod (ℓ ^ k)),
      Ψ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
        if i = 0 then (ULift.up c : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap =
        e V hV (ι c) := by
    intro V _ hV c
    have hf : ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
        if i = 0 then (ULift.up c : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap.comp
          h.base.hom = χ V hV * ContinuousMap.const _ (ULift.up c) := by
      apply ContinuousMap.ext
      intro x
      rw [ContinuousMap.comp_apply, hgenU, ContinuousMap.mul_apply, hχ, ContinuousMap.const_apply]
      by_cases hx : h.base.hom x ∈ V
      · rw [if_pos hx, Set.indicator_of_mem hx, Pi.one_apply, one_mul]
      · rw [if_neg hx, Set.indicator_of_notMem hx, zero_mul]
    rw [hΨdef, G2 T _ _ _ hf z, he, hι]
  have hΨ : ∀ a, Ψ a = Ξ (conv a) := by
    intro a
    have hVc : ∀ c : ZMod (ℓ ^ k), IsClopen {x : W | (a x).down = c} := fun c =>
      IsLocallyConstant.isClopen_fiber (hloc a) c
    have hdecA : (∑ c : ZMod (ℓ ^ k), ((LocallyConstant.ofIsClopen (hVc c)).map (fun i : Fin 2 =>
        if i = 0 then (ULift.up c : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap) = a := by
      apply ContinuousMap.ext
      intro x
      rw [ContinuousMap.sum_apply]
      rw [Finset.sum_eq_single ((a x).down)]
      · show ((LocallyConstant.ofIsClopen (hVc _)).map _).toContinuousMap x = a x
        rw [hgenU]
        exact if_pos rfl
      · intro c _ hc0
        show ((LocallyConstant.ofIsClopen (hVc _)).map _).toContinuousMap x = 0
        rw [hgenU]
        exact if_neg (fun hx : (a x).down = c => hc0 hx.symm)
      · intro hn
        exact absurd (Finset.mem_univ _) hn
    have hdecL : (∑ c : ZMod (ℓ ^ k), (LocallyConstant.ofIsClopen (hVc c)).map (fun i : Fin 2 =>
        if i = 0 then c else 0)) = conv a := by
      apply LocallyConstant.ext
      intro x
      have hsum := congrFun (map_sum (LocallyConstant.coeFnAddMonoidHom (X := ↥W)
        (Y := ZMod (ℓ ^ k))) (fun c : ZMod (ℓ ^ k) =>
          (LocallyConstant.ofIsClopen (hVc c)).map (fun i : Fin 2 => if i = 0 then c else 0))
          Finset.univ) x
      rw [Finset.sum_apply] at hsum
      refine hsum.trans ?_
      rw [Finset.sum_eq_single ((a x).down)]
      · show ((LocallyConstant.ofIsClopen (hVc (a x).down)).map
          (fun i : Fin 2 => if i = 0 then (a x).down else 0)) x = (a x).down
        rw [hgenZ]
        exact if_pos rfl
      · intro c _ hc0
        show ((LocallyConstant.ofIsClopen (hVc c)).map
          (fun i : Fin 2 => if i = 0 then c else 0)) x = 0
        rw [hgenZ]
        exact if_neg (fun hx : (a x).down = c => hc0 hx.symm)
      · intro hn
        exact absurd (Finset.mem_univ _) hn
    calc Ψ a = Ψ (∑ c : ZMod (ℓ ^ k), ((LocallyConstant.ofIsClopen (hVc c)).map (fun i : Fin 2 =>
          if i = 0 then (ULift.up c : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap) := by
          rw [hdecA]
      _ = ∑ c : ZMod (ℓ ^ k), Ψ ((LocallyConstant.ofIsClopen (hVc c)).map (fun i : Fin 2 =>
          if i = 0 then (ULift.up c : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap :=
          map_sum Ψ _ _
      _ = ∑ c : ZMod (ℓ ^ k), Ξ ((LocallyConstant.ofIsClopen (hVc c)).map (fun i : Fin 2 =>
          if i = 0 then c else 0)) :=
          Finset.sum_congr rfl (fun c _ => by rw [hgenΨ, hΞ])
      _ = Ξ (∑ c : ZMod (ℓ ^ k), (LocallyConstant.ofIsClopen (hVc c)).map (fun i : Fin 2 =>
          if i = 0 then c else 0)) := (map_sum Ξ _ _).symm
      _ = Ξ (conv a) := by rw [hdecL]
  have key : (fun a : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) =>
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (a.comp h.base.hom))).comp z (zero_add 1)) =
      ⇑Ξ ∘ conv := funext fun a => (hΨdef a).symm.trans (hΨ a)
  rw [key]
  exact Ξ.bijective.comp hconv

theorem wc_yrc_ladic_h1_passage_inj : ∀ {W T : Scheme.{u}} [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace W] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (h : T ⟶ W) (y : wcIntExt T ℓ 1) (E : wcIntRatData T ℓ), E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap T ℓ) → (∀ k : ℕ, 1 ≤ k → letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _; Function.Injective (fun a : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (a.comp h.base.hom))).comp (wcIntRed T ℓ k 1 y) (zero_add 1))) → letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _; Function.Injective (fun r : C(↥W, ULift.{u+1} ℚ_[ℓ]) => (Abelian.Ext.mk₀ (wcHMFun T ℓ (r.comp h.base.hom))).comp (wcIntRho E 1 y) (zero_add 1)) :=
by
  intro W T _ _ _ ℓ _ h y E hE hk
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  have hℓpr : Nat.Prime ℓ := Fact.out

  have hHMAdd : ∀ (r r' : C(↥T, ULift.{u+1} ℚ_[ℓ])),
      wcHMFun T ℓ (r + r') = wcHMFun T ℓ r + wcHMFun T ℓ r' := by
    intro r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥T, ULift.{u+1} ℚ_[ℓ]),
        ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ r)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ r')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  have hZAdd : ∀ (m : ℕ) (r r' : C(↥T, ULift.{u+1} (ZMod m))),
      wcZModFun T m (r + r') = wcZModFun T m r + wcZModFun T m r' := by
    intro m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥T, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun T m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun T m r)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun T m r')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  let ΦH : C(↥W, ULift.{u+1} ℚ_[ℓ]) →+ wcHM T ℓ 1 :=
    AddMonoidHom.mk' (fun r => (Abelian.Ext.mk₀ (wcHMFun T ℓ (r.comp h.base.hom))).comp
      (wcIntRho E 1 y) (zero_add 1)) (by
        intro a b
        rw [ContinuousMap.add_comp, hHMAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp])
  show Function.Injective ΦH
  rw [injective_iff_map_eq_zero]
  intro r hr
  change (Abelian.Ext.mk₀ (wcHMFun T ℓ (r.comp h.base.hom))).comp
      (wcIntRho E 1 y) (zero_add 1) = 0 at hr

  have hclear : ∃ (n : ℕ) (r' : C(↥W, ULift.{u+1} ℤ_[ℓ])) (r'' : C(↥W, ULift.{u+1} ℚ_[ℓ])),
      (∀ x, (r'' x).down = ((r' x).down : ℚ_[ℓ])) ∧
      (∀ x, (r'' x).down = (ℓ : ℚ_[ℓ]) ^ n * (r x).down) := by
    have hg : Continuous (fun x => (r x).down) := continuous_uliftDown.comp r.continuous
    obtain ⟨C, hC⟩ := IsCompact.exists_bound_of_continuousOn isCompact_univ hg.continuousOn
    have h1 : (1 : ℝ) < ℓ := by exact_mod_cast hℓpr.one_lt
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C h1
    have hv : ∀ x, ‖(ℓ : ℚ_[ℓ]) ^ n * (r x).down‖ ≤ 1 := by
      intro x
      rw [norm_mul, Padic.norm_p_pow]
      have hx := hC x (Set.mem_univ x)
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := by positivity
      rw [zpow_neg, zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
      linarith
    have hvc : Continuous (fun x => (ℓ : ℚ_[ℓ]) ^ n * (r x).down) := continuous_const.mul hg
    exact ⟨n, ⟨fun x => ULift.up ⟨(ℓ : ℚ_[ℓ]) ^ n * (r x).down, hv x⟩,
      continuous_uliftUp.comp (hvc.subtype_mk _)⟩,
      ⟨fun x => ULift.up ((ℓ : ℚ_[ℓ]) ^ n * (r x).down), continuous_uliftUp.comp hvc⟩,
      fun x => rfl, fun x => rfl⟩
  obtain ⟨n, r', r'', h1, h2⟩ := hclear

  set A := wcIntAct T ℓ 1 (r'.comp h.base.hom) y with hA
  have hρA : wcIntRho E 1 A = 0 := by
    rw [hA, (wc_int_rho_act T ℓ E hE 1).2 (r'.comp h.base.hom) (r''.comp h.base.hom)
      (fun t => h1 _) y]
    rw [wc_hmFun_scalar_smul T ℓ 1 (r.comp h.base.hom) (r''.comp h.base.hom)
      ((ℓ : ℚ_[ℓ]) ^ n) (fun t => h2 _) (wcIntRho E 1 y)]
    rw [hr, map_zero]

  obtain ⟨s, hs⟩ := (wc_int_rat_rationalization T ℓ E hE 1).2 A hρA
  obtain ⟨hTr, ht⟩ := wc_int_red_transfer T ℓ

  have hmod : ∀ w : ↥W, ∀ k : ℕ, 1 ≤ k →
      PadicInt.toZModPow k ((ℓ : ℤ_[ℓ]) ^ s * (r' w).down) = 0 := by
    intro w k hk1
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
    let bk : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) :=
      ((wcIntZModPresheafMap.{u} ℓ k).app (Opposite.op W)).hom r'
    have hbk : ∀ w, (bk w).down = PadicInt.toZModPow k (r' w).down := fun w => rfl
    let ΦkH : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) →+ wcZModProEtExt T (ℓ ^ k) 1 :=
      AddMonoidHom.mk' (fun a => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (a.comp h.base.hom))).comp
        (wcIntRed T ℓ k 1 y) (zero_add 1)) (by
          intro a b
          rw [ContinuousMap.add_comp, hZAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp])
    have hinj : Function.Injective ΦkH := hk k hk1
    have hred : wcIntRed T ℓ k 1 A = ΦkH bk :=
      (wc_int_red_act T ℓ hTr ht 1).2.1 k (r'.comp h.base.hom) (bk.comp h.base.hom)
        (fun t => hbk _) y
    have h3 : ΦkH ((ℓ ^ s : ℕ) • bk) = ΦkH 0 := by
      rw [map_nsmul, ← hred, ← map_nsmul, hs, map_zero, map_zero]
    have h4 := hinj h3
    have h5 := DFunLike.congr_fun h4 w
    have h6 : (ℓ ^ s : ℕ) • (bk w).down = 0 := congrArg ULift.down h5
    rw [map_mul, map_pow, map_natCast, ← hbk w]
    rw [nsmul_eq_mul, Nat.cast_pow] at h6
    exact h6

  have hzero : ∀ w, (r' w).down = 0 := by
    intro w
    have hx : (ℓ : ℤ_[ℓ]) ^ s * (r' w).down = 0 := by
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      rcases Nat.eq_zero_or_pos k with hk0 | hk0
      · subst hk0
        haveI : Subsingleton (ZMod (ℓ ^ 0)) := by
          rw [pow_zero]; exact ZMod.subsingleton_iff.mpr rfl
        exact Subsingleton.elim _ _
      · rw [hmod w k hk0, map_zero]
    have hne : (ℓ : ℤ_[ℓ]) ^ s ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓpr.ne_zero)
    exact (mul_eq_zero.mp hx).resolve_left hne

  apply ContinuousMap.ext
  intro w
  apply ULift.ext
  show (r w).down = 0
  have e1 : (ℓ : ℚ_[ℓ]) ^ n * (r w).down = 0 := by
    rw [← h2 w, h1 w, hzero w, PadicInt.coe_zero]
  have hne : (ℓ : ℚ_[ℓ]) ^ n ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓpr.ne_zero)
  exact (mul_eq_zero.mp e1).resolve_left hne

theorem wc_yrc_ladic_h1_passage_surj : ∀ {W T : Scheme.{u}} [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace W] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (h : T ⟶ W) (y : wcIntExt T ℓ 1) (E : wcIntRatData T ℓ), E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap T ℓ) → (∀ k : ℕ, 1 ≤ k → letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _; Function.Bijective (fun a : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) => (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (a.comp h.base.hom))).comp (wcIntRed T ℓ k 1 y) (zero_add 1))) → letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _; Function.Surjective (fun r : C(↥W, ULift.{u+1} ℚ_[ℓ]) => (Abelian.Ext.mk₀ (wcHMFun T ℓ (r.comp h.base.hom))).comp (wcIntRho E 1 y) (zero_add 1)) :=
by
  intro W T _ _ _ ℓ _ h y E hE hΦ
  classical
  obtain ⟨hTr, ht⟩ := wc_int_red_transfer T ℓ
  have M := wc_int_red_milnor T ℓ hTr ht 1
  have A := wc_int_red_act T ℓ hTr ht 1

  have hInt : ∀ x : wcIntExt T ℓ 1, ∃ a : C(↥W, ULift.{u+1} ℤ_[ℓ]),
      x = wcIntAct T ℓ 1 (a.comp h.base.hom) y := by
    intro x

    obtain ⟨α, hαx⟩ : ∃ α : ∀ k : ℕ, C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))), ∀ k : ℕ, 1 ≤ k →
        letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
        (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) ((α k).comp h.base.hom))).comp
          (wcIntRed T ℓ k 1 y) (zero_add 1) = wcIntRed T ℓ k 1 x := by
      refine ⟨fun k => if hk : 1 ≤ k then Function.surjInv (hΦ k hk).2 (wcIntRed T ℓ k 1 x)
        else ContinuousMap.const _ (ULift.up 0), ?_⟩
      intro k hk
      simp only [dif_pos hk]
      exact Function.surjInv_eq (hΦ k hk).2 (wcIntRed T ℓ k 1 x)

    have hαc : ∀ k : ℕ, 1 ≤ k → ∀ w : ↥W, (α k w).down =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (α (k + 1) w).down := by
      intro k hk
      let β : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) :=
        ⟨fun w => ULift.up (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k))
            (α (k + 1) w).down),
          (continuous_of_discreteTopology (f := fun z : ULift.{u+1} (ZMod (ℓ ^ (k + 1))) =>
            (ULift.up (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) z.down) :
              ULift.{u+1} (ZMod (ℓ ^ k))))).comp (α (k + 1)).continuous⟩
      have key : letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) :=
            HasExt.standard _
          (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (β.comp h.base.hom))).comp
            (wcIntRed T ℓ k 1 y) (zero_add 1) =
          (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) ((α k).comp h.base.hom))).comp
            (wcIntRed T ℓ k 1 y) (zero_add 1) := by
        rw [hαx k hk, ← M.1 k y hk,
          ← A.2.2 k 1 ((α (k + 1)).comp h.base.hom) (β.comp h.base.hom) (fun t => rfl)
            (wcIntRed T ℓ (k + 1) 1 y),
          hαx (k + 1) (by omega), M.1 k x hk]
      have hβ : β = α k := (hΦ k hk).1 key
      intro w
      exact (congrArg (fun f : C(↥W, ULift.{u+1} (ZMod (ℓ ^ k))) => (f w).down) hβ).symm

    have hcomp : ∀ w : ↥W, ∀ m : ℕ,
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) (α (m + 1) w).down =
          (α m w).down := by
      intro w m
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
        exact Subsingleton.elim _ _
      · exact (hαc m hm w).symm
    have hlim : ∀ w : ↥W, ∃ z : ℤ_[ℓ], ∀ m : ℕ, PadicInt.toZModPow m z = (α m w).down :=
      fun w => wc_padicInt_of_compatible ℓ (fun m => (α m w).down) (hcomp w)
    choose a₀ ha₀ using hlim

    have hcont : Continuous a₀ := by
      refine continuous_iff_continuousAt.mpr (fun w₀ => ?_)
      refine Metric.tendsto_nhds.mpr ?_
      intro ε hε
      have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
      obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hε (inv_lt_one_of_one_lt₀ hℓ1)
      have hO : IsOpen ((α (n + 1)) ⁻¹' {α (n + 1) w₀}) :=
        (isOpen_discrete _).preimage (α (n + 1)).continuous
      filter_upwards [hO.mem_nhds (Set.mem_singleton _)] with w hw
      have hw' : α (n + 1) w = α (n + 1) w₀ := hw
      have hker : a₀ w - a₀ w₀ ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) (n + 1)) := by
        rw [RingHom.mem_ker, map_sub, ha₀, ha₀, hw', sub_self]
      rw [PadicInt.ker_toZModPow, ← PadicInt.norm_le_pow_iff_mem_span_pow] at hker
      rw [dist_eq_norm]
      calc ‖a₀ w - a₀ w₀‖ ≤ (ℓ : ℝ) ^ (-((n + 1 : ℕ) : ℤ)) := hker
        _ = ((ℓ : ℝ)⁻¹) ^ (n + 1) := by rw [zpow_neg, zpow_natCast, inv_pow]
        _ ≤ ((ℓ : ℝ)⁻¹) ^ n :=
          pow_le_pow_of_le_one (by positivity) (inv_le_one_of_one_le₀ hℓ1.le) (Nat.le_succ n)
        _ < ε := hn
    let a : C(↥W, ULift.{u+1} ℤ_[ℓ]) := ⟨fun w => ULift.up (a₀ w), continuous_uliftUp.comp hcont⟩

    have hred : ∀ k : ℕ, 1 ≤ k →
        wcIntRed T ℓ k 1 (x - wcIntAct T ℓ 1 (a.comp h.base.hom) y) = 0 := by
      intro k hk
      rw [map_sub, A.2.1 k (a.comp h.base.hom) ((α k).comp h.base.hom)
        (fun t => (ha₀ (h.base.hom t) k).symm) y, hαx k hk, sub_self]
    have hd := M.2.2.1 (wc_zmod_deg0_lim1_zero T ℓ) _ hred
    exact ⟨a, sub_eq_zero.mp hd⟩

  intro v
  obtain ⟨n, x', hx'⟩ := (wc_int_rat_rationalization T ℓ E hE 1).1 v
  obtain ⟨a, rfl⟩ := hInt x'
  set c : ℚ_[ℓ] := (ℓ : ℚ_[ℓ]) ^ n with hc
  have hc0 : c ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
  let aQ : C(↥W, ULift.{u+1} ℚ_[ℓ]) := ⟨fun w => ULift.up ((a w).down : ℚ_[ℓ]),
    continuous_uliftUp.comp (continuous_subtype_val.comp (continuous_uliftDown.comp a.continuous))⟩
  let r : C(↥W, ULift.{u+1} ℚ_[ℓ]) := ⟨fun w => ULift.up (c⁻¹ * (aQ w).down),
    continuous_uliftUp.comp (continuous_const.mul (continuous_uliftDown.comp aQ.continuous))⟩
  refine ⟨r, ?_⟩
  have hRa := (wc_int_rho_act T ℓ E hE 1).2 (a.comp h.base.hom) (aQ.comp h.base.hom)
    (fun t => rfl) y
  have hsm := wc_hmFun_scalar_smul T ℓ 1 (r.comp h.base.hom) (aQ.comp h.base.hom) c
    (fun t => (mul_inv_cancel_left₀ hc0 ((aQ (h.base.hom t)).down)).symm) (wcIntRho E 1 y)
  rw [hRa, hsm] at hx'
  have L := wc_hmScalar_laws T ℓ 1
  have hcan : ∀ u, wcHMScalar T ℓ 1 c⁻¹ (wcHMScalar T ℓ 1 c u) = u := fun u => by
    rw [L.1, mul_inv_cancel₀ hc0, L.2.1]
  have h2 := congrArg (⇑(wcHMScalar T ℓ 1 c⁻¹)) hx'
  rw [hcan, hcan] at h2
  exact h2.symm

theorem wc_yrc_unit_not_lpow_iter : ∀ (L R : Type u) [Field L] [IsSepClosed L] [CommRing R] [Nontrivial R] (φ : L →+* R) (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : L) ≠ 0 → (∀ e : R, e * e = e → e = 0 ∨ e = 1) → ∀ a : Rˣ, (¬ ∃ b : Rˣ, b ^ ℓ = a) → ∀ k : ℕ, 1 ≤ k → ¬ ∃ b : Rˣ, b ^ (ℓ ^ k) = a ^ (ℓ ^ (k - 1)) :=
by
  intro L R _ _ _ _ φ ℓ _ hℓL hidem a hna k hk hex
  obtain ⟨b, hb⟩ := hex
  classical

  have A0 : ∀ x y u v : R, u * x + v * y = 1 → x * y = 0 → x = 0 ∨ y = 0 := by
    intro x y u v h hxy
    rcases hidem (u * x) (by linear_combination (u * x) * h - (u * v) * hxy) with h0 | h1
    · left
      linear_combination (-x) * h + x * h0 + v * hxy
    · right
      linear_combination (-y) * h1 + u * hxy

  have S1 : ∀ (s : Finset L) (c : R), (∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsUnit (φ i - φ j)) →
      ∏ i ∈ s, (c - φ i) = 0 → ∃ i ∈ s, c = φ i := by
    intro s c
    induction s using Finset.induction_on with
    | empty => intro _ h; simp at h
    | insert a t hat ih =>
      intro hu hprod
      rw [Finset.prod_insert hat] at hprod
      have hcop : IsCoprime (c - φ a) (∏ j ∈ t, (c - φ j)) := by
        apply IsCoprime.prod_right
        intro j hj
        have haj : a ≠ j := fun h => hat (by rw [h]; exact hj)
        obtain ⟨w, hw⟩ := (hu a (Finset.mem_insert_self a t) j
          (Finset.mem_insert_of_mem hj) haj).exists_left_inv
        exact ⟨-w, w, by linear_combination hw⟩
      obtain ⟨u, v, huv⟩ := hcop
      rcases A0 _ _ u v huv hprod with h | h
      · exact ⟨a, Finset.mem_insert_self a t, sub_eq_zero.mp h⟩
      · obtain ⟨i, hi, hci⟩ := ih (fun i hi j hj hij => hu i (Finset.mem_insert_of_mem hi) j
          (Finset.mem_insert_of_mem hj) hij) h
        exact ⟨i, Finset.mem_insert_of_mem hi, hci⟩

  set M := ℓ ^ (k - 1) with hMdef
  have hlk : ℓ ^ k = ℓ * M := by
    rw [hMdef, ← pow_succ']
    congr 1
    omega
  have hML : ((M : ℕ) : L) ≠ 0 := by
    rw [hMdef, Nat.cast_pow]
    exact pow_ne_zero _ hℓL
  have hM0 : M ≠ 0 := fun h => hML (by rw [h, Nat.cast_zero])

  set cu : Rˣ := a * (b ^ ℓ)⁻¹ with hcudef
  have hcu : cu ^ M = 1 := by
    rw [hcudef, mul_pow, inv_pow, ← pow_mul, ← hlk, hb, mul_inv_cancel]
  have hcM : (cu : R) ^ M = 1 := by
    rw [← Units.val_pow_eq_pow_val, hcu, Units.val_one]

  set P : Polynomial L := Polynomial.X ^ M - Polynomial.C 1 with hP
  have hsep : P.Separable := Polynomial.separable_X_pow_sub_C 1 hML one_ne_zero
  have hspl : P.Splits := IsSepClosed.splits_of_separable P hsep
  have hmon : P.Monic := Polynomial.monic_X_pow_sub_C 1 hM0
  have hfac := Polynomial.Splits.eq_prod_roots_of_monic hspl hmon
  have hnd := Polynomial.nodup_roots hsep
  have hprod : ∏ ζ ∈ P.roots.toFinset, ((cu : R) - φ ζ) = 0 := by
    rw [Finset.prod_eq_multiset_prod, Multiset.toFinset_val, hnd.dedup]
    have h1 := congrArg (Polynomial.eval₂ φ (cu : R)) hfac
    rw [Polynomial.eval₂_multiset_prod, Multiset.map_map] at h1
    have h2 : (Function.comp (Polynomial.eval₂ φ (cu : R)) (fun x => Polynomial.X - Polynomial.C x))
        = fun ζ => (cu : R) - φ ζ := by
      funext ζ
      simp only [Function.comp, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
    rw [h2] at h1
    rw [← h1, hP]
    simp [hcM]
  have hpair : ∀ i ∈ P.roots.toFinset, ∀ j ∈ P.roots.toFinset, i ≠ j → IsUnit (φ i - φ j) := by
    intro i _ j _ hij
    rw [← map_sub]
    exact (sub_ne_zero.mpr hij).isUnit.map φ
  obtain ⟨ζ₀, hζs, hcζ⟩ := S1 _ (cu : R) hpair hprod
  have hζM : ζ₀ ^ M = 1 := by
    have hr := (Polynomial.mem_roots hmon.ne_zero).mp (Multiset.mem_toFinset.mp hζs)
    rw [Polynomial.IsRoot, hP] at hr
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at hr
    exact sub_eq_zero.mp hr
  have hζ0 : ζ₀ ≠ 0 := by
    rintro rfl
    rw [zero_pow hM0] at hζM
    exact zero_ne_one hζM
  have : NeZero ((ℓ : ℕ) : L) := ⟨hℓL⟩
  obtain ⟨η, hη⟩ := IsSepClosed.exists_pow_nat_eq ζ₀ ℓ
  have hη0 : η ≠ 0 := by
    rintro rfl
    rw [zero_pow (Fact.out : ℓ.Prime).ne_zero] at hη
    exact hζ0 hη.symm
  apply hna
  refine ⟨Units.map φ.toMonoidHom (Units.mk0 η hη0) * b, ?_⟩
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, Units.val_mul, mul_pow]
  have hu : ((Units.map φ.toMonoidHom (Units.mk0 η hη0) : Rˣ) : R) = φ η := rfl
  rw [hu, ← map_pow, hη, ← hcζ, ← Units.val_pow_eq_pow_val, ← Units.val_mul, hcudef,
    inv_mul_cancel_right]

theorem wc_zmod_h0_card_connected : ∀ (T : Scheme.{u}) (n : ℕ), 2 ≤ n → Nat.card (wcZModProEtExt T n 0) = n → Nontrivial Γ(T, ⊤) ∧ ∀ e : Γ(T, ⊤), e * e = e → e = 0 ∨ e = 1 :=
by
  intro T n hn hcard
  classical
  let O := SheafOfModules.unit (wcZModRingSheaf T n)
  let V0 : T.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 T) (inferInstance : WeaklyEtale (𝟙 T))
  have e1 : wcZModProEtExt T n 0 ≃ (O ⟶ O) :=
    @Abelian.Ext.homEquiv₀ _ _ _ (HasExt.standard _) O O
  have e2 : (O ⟶ O) ≃ O.sections := SheafOfModules.unitHomEquiv O
  have e3 : O.sections ≃ C(↥T, ULift.{u+1} (ZMod n)) :=
    { toFun := fun s => (s.val (Opposite.op V0) : C(↥T, ULift.{u+1} (ZMod n)))
      invFun := fun r => PresheafOfModules.sectionsMk (M := O.val)
        (fun V => (r.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod n))))
        (fun V V' g => ContinuousMap.ext (fun x =>
          congrArg (fun k => r (k.base x)) (MorphismProperty.Over.w g.unop)))
      left_inv := fun s => by
        apply PresheafOfModules.sections_ext
        intro V
        let π : Opposite.unop V ⟶ V0 :=
          MorphismProperty.Over.homMk (Opposite.unop V).hom (Category.comp_id _) trivial
        refine Eq.trans ?_ (s.2 π.op)
        exact ContinuousMap.ext fun x => rfl
      right_inv := fun r => ContinuousMap.ext fun x => by first | rfl | simp }
  have hC : Nat.card C(↥T, ULift.{u+1} (ZMod n)) = n :=
    (Nat.card_congr (e1.trans (e2.trans e3))).symm.trans hcard
  haveI hfin : Finite C(↥T, ULift.{u+1} (ZMod n)) := Nat.finite_of_card_ne_zero (by omega)
  obtain ⟨t⟩ : Nonempty ↥T := by
    rcases isEmpty_or_nonempty ↥T with h | h
    · exfalso
      haveI : Unique C(↥T, ULift.{u+1} (ZMod n)) :=
        ⟨⟨ContinuousMap.const _ (ULift.up 0)⟩, fun f => ContinuousMap.ext fun x => isEmptyElim x⟩
      rw [Nat.card_unique] at hC
      omega
    · exact h
  refine ⟨@Scheme.component_nontrivial T ⊤ ⟨⟨t, by simp⟩⟩, ?_⟩
  intro e he
  by_contra hne
  push_neg at hne
  have hg : ∀ x : ↥T, (T.presheaf.germ ⊤ x trivial).hom e = 0 ∨
      (T.presheaf.germ ⊤ x trivial).hom e = 1 := by
    intro x
    have hgg : (T.presheaf.germ ⊤ x trivial).hom e * (T.presheaf.germ ⊤ x trivial).hom e =
        (T.presheaf.germ ⊤ x trivial).hom e := by rw [← map_mul, he]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self ((T.presheaf.germ ⊤ x trivial).hom e)
      with hu | hu
    · right
      have h1 : (T.presheaf.germ ⊤ x trivial).hom e * (1 - (T.presheaf.germ ⊤ x trivial).hom e) =
          (T.presheaf.germ ⊤ x trivial).hom e * 0 := by
        rw [mul_sub, mul_one, hgg, sub_self, mul_zero]
      exact (sub_eq_zero.mp (hu.mul_left_cancel h1)).symm
    · left
      have h1 : (1 - (T.presheaf.germ ⊤ x trivial).hom e) * (T.presheaf.germ ⊤ x trivial).hom e =
          (1 - (T.presheaf.germ ⊤ x trivial).hom e) * 0 := by
        rw [sub_mul, one_mul, hgg, sub_self, mul_zero]
      exact hu.mul_left_cancel h1
  have hmem1 : ∀ x : ↥T, x ∈ T.basicOpen e ↔ (T.presheaf.germ ⊤ x trivial).hom e = 1 := by
    intro x
    rw [Scheme.mem_basicOpen_top]
    rcases hg x with h | h
    · rw [h]; simp
    · rw [h]; simp
  have hmem2 : ∀ x : ↥T, x ∈ T.basicOpen (1 - e) ↔ (T.presheaf.germ ⊤ x trivial).hom e = 0 := by
    intro x
    rw [Scheme.mem_basicOpen_top, map_sub, map_one]
    rcases hg x with h | h
    · rw [h]; simp
    · rw [h]; simp
  have hUc : ((T.basicOpen e : T.Opens) : Set ↥T)ᶜ = ((T.basicOpen (1 - e) : T.Opens) : Set ↥T) := by
    ext x
    rw [Set.mem_compl_iff, SetLike.mem_coe, SetLike.mem_coe, hmem1, hmem2]
    rcases hg x with h | h
    · rw [h]; simp
    · rw [h]; simp
  have hclo : IsClopen ((T.basicOpen e : T.Opens) : Set ↥T) :=
    ⟨by rw [← isOpen_compl_iff, hUc]; exact (T.basicOpen (1 - e)).isOpen, (T.basicOpen e).isOpen⟩
  obtain ⟨a, ha⟩ : ∃ a : ↥T, (T.presheaf.germ ⊤ a trivial).hom e = 1 := by
    by_contra hcon
    push_neg at hcon
    have h0 : ∀ x : ↥T, (T.presheaf.germ ⊤ x trivial).hom e = (T.presheaf.germ ⊤ x trivial).hom 0 := by
      intro x
      rw [map_zero]
      exact (hg x).resolve_right (hcon x)
    exact hne.1 (TopCat.Presheaf.section_ext T.sheaf ⊤ e 0 (fun x _ => h0 x))
  obtain ⟨b, hb⟩ : ∃ b : ↥T, (T.presheaf.germ ⊤ b trivial).hom e = 0 := by
    by_contra hcon
    push_neg at hcon
    have h0 : ∀ x : ↥T, (T.presheaf.germ ⊤ x trivial).hom e = (T.presheaf.germ ⊤ x trivial).hom 1 := by
      intro x
      rw [map_one]
      exact (hg x).resolve_left (hcon x)
    exact hne.2 (TopCat.Presheaf.section_ext T.sheaf ⊤ e 1 (fun x _ => h0 x))
  have ha' : a ∈ ((T.basicOpen e : T.Opens) : Set ↥T) := by
    rw [SetLike.mem_coe, hmem1]; exact ha
  have hb' : b ∉ ((T.basicOpen e : T.Opens) : Set ↥T) := by
    rw [SetLike.mem_coe, hmem1, hb]; exact zero_ne_one
  let f : ZMod n × ZMod n → C(↥T, ULift.{u+1} (ZMod n)) := fun pq =>
    ⟨fun x => if x ∈ ((T.basicOpen e : T.Opens) : Set ↥T) then ULift.up pq.1 else ULift.up pq.2,
      Continuous.if (by simp [Set.setOf_mem_eq, hclo.frontier_eq]) continuous_const continuous_const⟩
  have hf : Function.Injective f := by
    rintro ⟨p, q⟩ ⟨p', q'⟩ h
    have h1 : (if a ∈ ((T.basicOpen e : T.Opens) : Set ↥T) then ULift.up p else ULift.up q :
        ULift.{u+1} (ZMod n)) =
        if a ∈ ((T.basicOpen e : T.Opens) : Set ↥T) then ULift.up p' else ULift.up q' :=
      congrArg (fun g : C(↥T, ULift.{u+1} (ZMod n)) => g a) h
    have h2 : (if b ∈ ((T.basicOpen e : T.Opens) : Set ↥T) then ULift.up p else ULift.up q :
        ULift.{u+1} (ZMod n)) =
        if b ∈ ((T.basicOpen e : T.Opens) : Set ↥T) then ULift.up p' else ULift.up q' :=
      congrArg (fun g : C(↥T, ULift.{u+1} (ZMod n)) => g b) h
    rw [if_pos ha', if_pos ha'] at h1
    rw [if_neg hb', if_neg hb'] at h2
    rw [ULift.up_inj.mp h1, ULift.up_inj.mp h2]
  have hle := Nat.card_le_card_of_injective f hf
  rw [Nat.card_prod, Nat.card_zmod, hC] at hle
  nlinarith

theorem wc_yrc_wcontr_kummer_bij {X Y Z : Scheme.{u}} (g : X ⟶ Y) [IsAffineHom g]
    (i : Z ⟶ Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (L : Type u) [Field L] [IsSepClosed L] (hℓL : ((ℓ : ℕ) : L) ≠ 0) (qX : X ⟶ Spec (.of L))
    {N : ℕ} (V : Fin N → Y.Opens) (x : Fin N → Γ(Y, ⊤))
    (hcnt : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (cC : Spec (.of C) ⟶ Y), WeaklyEtale cC →
      cC (IsLocalRing.closedPoint C) ∈ Set.range i →
      ∀ (TC : Scheme.{u}) (t₁ : TC ⟶ Spec (.of C)) (t₂ : TC ⟶ X), IsPullback t₂ t₁ g cC →
      (∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt TC (ℓ ^ k) j)) ∧
      (∀ k : ℕ, 1 ≤ k → Nat.card (wcZModProEtExt TC (ℓ ^ k) 0) = ℓ ^ k ∧
        Nat.card (wcZModProEtExt TC (ℓ ^ k) 1) = ℓ ^ k ∧
        IsAddCyclic (wcZModProEtExt TC (ℓ ^ k) 1)) ∧
