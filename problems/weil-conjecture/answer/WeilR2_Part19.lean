  have hpp : ∀ (ℓ k : ℕ), Nat.Prime ℓ → 0 < k → ((ℓ ^ k : ℕ) : K) ≠ 0 →
      ∀ (D' : wcEtPullData ι (ℓ ^ k)),
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ k))) := HasExt.standard _
      ∃ θ : wcEtSuppExt D' 2, ∀ b : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k)))
        (wcEtSuppObj D') (2 * (N - 1)), b.comp θ h = 0 → b = 0 := by
    intro ℓ k hℓp hk hK D'
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ k))) := HasExt.standard _
    haveI : Fact (Nat.Prime ℓ) := ⟨hℓp⟩
    have hℓ : (ℓ : K) ≠ 0 := by
      intro h0
      apply hK
      rw [Nat.cast_pow, h0, zero_pow (by omega)]
    have hk1 : 1 ≤ k := hk
    haveI : CompactSpace ↥Y := QuasiCompact.compactSpace_of_compactSpace f
    haveI : IsProper (ι ≫ f) := inferInstance
    obtain ⟨T, hGL, hNat, hPt⟩ := wc_et_kummer_local_thom_pow K ℓ hℓ k hk1
    have hsp : ∀ (X Z' : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ)
        [SmoothOfRelativeDimension n fX] (i : Z' ⟶ X) [IsClosedImmersion i]
        [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D₁ : wcEtPullData i (ℓ ^ k))
        (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D₁ q, θ = 0 := by
      intro X Z' fX n c _ i _ _ hc
      exact wc_et_supp_semipurity_pow K X Z' fX n c i hc ℓ hℓ k hk1
    obtain ⟨θ, hθ⟩ := wc_et_thom_class_glue_pow K (ℓ ^ k) hsp T hGL hNat Y Z f N 1 ι hN D'
    obtain ⟨z₀, hz₀⟩ := wc_alg_closed_lft_section K Z (ι ≫ f) IrreducibleSpace.toNonempty
    obtain ⟨Dz⟩ := wc_et_zmod_pull_data_exists z₀ (ℓ ^ k)
    obtain ⟨Dy⟩ := wc_et_zmod_pull_data_exists (z₀ ≫ ι) (ℓ ^ k)
    obtain ⟨ω, hω⟩ := wc_et_point_supp_ext_strict_exists K Z (ι ≫ f) (N - 1) ℓ hℓ k hk1 z₀ hz₀ Dz
    have h' : 2 * (N - 1) + 2 * 1 = 2 * N := by omega
    obtain ⟨b₀, ω'', hstrict, hb₀⟩ := wc_et_smooth_divisor_point_gysin_strict K Y f N hN Z ι ℓ hℓ
      k hk1 T hGL hNat hPt D' θ hθ z₀ hz₀ Dz Dy ω hω h'
    have hs := wc_et_point_supp_class_strict_injective K Y f N ℓ hℓ k hk1 (z₀ ≫ ι)
      (by rw [Category.assoc]; exact hz₀) Dy ω'' hstrict
    rw [← hb₀] at hs
    obtain ⟨hcyc, htors⟩ := wc_et_supp_top_ext_cyclic_pow K Y f Z ι (N - 1) ℓ hℓ k D'
    let φ : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))) (wcEtSuppObj D')
        (2 * (N - 1)) →+ Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k)))
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))) (2 * N) :=
      AddMonoidHom.mk' (fun b => b.comp θ h') (fun a b => by rw [Abelian.Ext.add_comp])
    haveI := hcyc
    obtain ⟨g, hg⟩ := IsAddCyclic.exists_generator (α := Abelian.Ext
      (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))) (wcEtSuppObj D') (2 * (N - 1)))
    obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp (hg b₀)
    have ht1 : ℓ ^ (k - 1) • φ g ≠ 0 := by
      intro h0
      apply hs
      have e1 : b₀.comp θ h' = φ b₀ := rfl
      rw [e1, ← hc, map_zsmul φ c g, ← natCast_zsmul, smul_smul,
        mul_comm ((ℓ ^ (k - 1) : ℕ) : ℤ) c, ← smul_smul, natCast_zsmul, h0, smul_zero]
    have ht2 : ℓ ^ k • φ g = 0 := by
      have e := map_nsmul φ (ℓ ^ k) g
      rw [htors, map_zero] at e
      exact e.symm
    obtain ⟨i, hik, hi⟩ := (Nat.dvd_prime_pow hℓp).mp (addOrderOf_dvd_of_nsmul_eq_zero ht2)
    have hik' : i = k := by
      by_contra hne
      apply ht1
      apply addOrderOf_dvd_iff_nsmul_eq_zero.mp
      rw [hi]
      exact Nat.pow_dvd_pow ℓ (by omega)
    rw [hik'] at hi
    refine ⟨θ, fun b hb => ?_⟩
    have hb' : φ b = 0 := hb
    obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (hg b)
    have hjt : j • φ g = 0 := by rw [← map_zsmul φ j g, hj]; exact hb'
    have hdvd := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hjt
    rw [hi] at hdvd
    obtain ⟨j', hj'⟩ := hdvd
    rw [← hj, hj', mul_comm ((ℓ ^ k : ℕ) : ℤ) j', ← smul_smul, natCast_zsmul, htors, smul_zero]

  have key : ∀ n : ℕ, (n : K) ≠ 0 → ∀ (D' : wcEtPullData ι n),
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
      ∃ θ : wcEtSuppExt D' 2, ∀ b : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y n))
        (wcEtSuppObj D') (2 * (N - 1)), b.comp θ h = 0 → b = 0 := by
    intro n
    induction n using Nat.recOnPosPrimePosCoprime with
    | prime_pow p a hpr ha => exact hpp p a hpr ha
    | zero => intro h0; exact (h0 Nat.cast_zero).elim
    | one =>
      intro _ D'
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y 1)) := HasExt.standard _
      have e := (wc_et_zmod_unit_pow_exact Y 1 1 one_pos).1
      rw [pow_one, one_nsmul] at e
      refine ⟨0, fun b _ => ?_⟩
      calc b = (Abelian.Ext.mk₀ (𝟙 _)).comp b (zero_add _) := (Abelian.Ext.mk₀_id_comp b).symm
        _ = 0 := by rw [e, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    | coprime a b ha hb hab iha ihb =>
      intro hab0 D'
      rw [Nat.cast_mul] at hab0
      have ha0 : (a : K) ≠ 0 := left_ne_zero_of_mul hab0
      have hb0 : (b : K) ≠ 0 := right_ne_zero_of_mul hab0
      exact wc_et_top_gysin_irred_coprime_mul ι (2 * (N - 1)) (2 * N) h a b (by omega) (by omega)
        hab (iha ha0) (ihb hb0) D'
  exact key m hm D

theorem wc_et_smooth_divisor_supp_pairing_top : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f], 1 ≤ N → ∀ (Z : Scheme.{u}) (ι : Z ⟶ Y) [IsClosedImmersion ι] [SmoothOfRelativeDimension (N - 1) (ι ≫ f)] (m : ℕ), (m : K) ≠ 0 → ∀ (D : wcEtPullData ι m) (h : 2 * (N - 1) + 2 = 2 * N), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _; ∀ b : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) (wcEtSuppObj D) (2 * (N - 1)), (∀ θ : wcEtSuppExt D 2, b.comp θ h = 0) → b = 0 :=
by
  intro K _ _ Y f _ N _ hN Z₀ ι₀ _ _ m hm D₀ h
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  have key : ∀ (k : ℕ) (Z : Scheme.{u}) (ι : Z ⟶ Y) [IsClosedImmersion ι]
      [SmoothOfRelativeDimension (N - 1) (ι ≫ f)] (D : wcEtPullData ι m),
      (irreducibleComponents Z).ncard = k →
      ∀ b : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) (wcEtSuppObj D) (2 * (N - 1)),
        (∀ θ : wcEtSuppExt D 2, b.comp θ h = 0) → b = 0 := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
    intro Z ι _ _ D hk b hb
    rcases isEmpty_or_nonempty Z with hZe | hZne
    ·
      have hU : Limits.IsZero (SheafOfModules.unit (wcEtZModRing Z m)) :=
        wc_et_zmod_modules_zero_of_isEmpty Z m hZe _
      have h0 : (𝟙 (wcEtSuppObj D)) = 0 :=
        (D.adj.homEquiv (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing Z m))).symm.injective
          (hU.eq_of_tgt _ _)
      calc b = b.comp (Abelian.Ext.mk₀ (𝟙 (wcEtSuppObj D))) (add_zero _) :=
            (Abelian.Ext.comp_mk₀_id b).symm
        _ = 0 := by
          rw [h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    by_cases hirr : IrreducibleSpace Z
    ·
      haveI := hirr
      obtain ⟨θ, hθ⟩ := wc_et_smooth_divisor_top_gysin_injective_irred K Y f N hN Z ι m hm D h
      exact hθ b (hb θ)
    ·
      haveI : IsProper (ι ≫ f) := inferInstance
      obtain ⟨U, V, hdisj, hcov, _, hUs, _, hVs, hUlt, hVlt⟩ :=
        wc_proper_smooth_clopen_split K Z (ι ≫ f) (N - 1) hZne hirr
      have hmemU : ∀ x : Z, x ∈ U ↔ x ∉ V := by
        intro x
        constructor
        · intro hxU hxV
          have h1 : x ∈ U ⊓ V := TopologicalSpace.Opens.mem_inf.mpr ⟨hxU, hxV⟩
          rw [hdisj.eq_bot] at h1
          simp at h1
        · intro hxV
          have h1 : x ∈ U ⊔ V := by rw [hcov]; trivial
          exact (TopologicalSpace.Opens.mem_sup.mp h1).resolve_right hxV
      have hUc : IsClosed (U : Set Z) := by
        have e : (U : Set Z) = (V : Set Z)ᶜ := Set.ext fun x => hmemU x
        rw [e]
        exact V.isOpen.isClosed_compl
      have hVc : IsClosed (V : Set Z) := by
        have e : (V : Set Z) = (U : Set Z)ᶜ := Set.ext fun x => by
          change x ∈ V ↔ x ∉ U
          rw [hmemU x, not_not]
        rw [e]
        exact U.isOpen.isClosed_compl
      haveI hUι : IsClosedImmersion U.ι := by
        apply IsClosedImmersion.of_isPreimmersion
        rw [Scheme.Opens.range_ι]
        exact hUc
      haveI hVι : IsClosedImmersion V.ι := by
        apply IsClosedImmersion.of_isPreimmersion
        rw [Scheme.Opens.range_ι]
        exact hVc
      haveI : IsClosedImmersion (U.ι ≫ ι) := inferInstance
      haveI : IsClosedImmersion (V.ι ≫ ι) := inferInstance
      haveI : SmoothOfRelativeDimension (N - 1) ((U.ι ≫ ι) ≫ f) := by
        rw [Category.assoc]; exact hUs
      haveI : SmoothOfRelativeDimension (N - 1) ((V.ι ≫ ι) ≫ f) := by
        rw [Category.assoc]; exact hVs
      obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists (U.ι ≫ ι) m
      obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists (V.ι ≫ ι) m
      obtain ⟨rU, sU, rV, sV, hsum⟩ := wc_et_supp_obj_clopen_split ι U V hdisj hcov m D DU DV
      have hbU : ∀ θU : wcEtSuppExt DU 2,
          (b.comp (Abelian.Ext.mk₀ rU) (add_zero _)).comp θU h = 0 := by
        intro θU
        rw [Abelian.Ext.comp_assoc b (Abelian.Ext.mk₀ rU) θU (add_zero _) (zero_add 2)
          (show 2 * (N - 1) + 0 + 2 = 2 * N by omega)]
        exact hb _
      have hbV : ∀ θV : wcEtSuppExt DV 2,
          (b.comp (Abelian.Ext.mk₀ rV) (add_zero _)).comp θV h = 0 := by
        intro θV
        rw [Abelian.Ext.comp_assoc b (Abelian.Ext.mk₀ rV) θV (add_zero _) (zero_add 2)
          (show 2 * (N - 1) + 0 + 2 = 2 * N by omega)]
        exact hb _
      have hbU0 : b.comp (Abelian.Ext.mk₀ rU) (add_zero _) = 0 :=
        ih _ (lt_of_lt_of_eq hUlt hk) (U : Scheme.{u}) (U.ι ≫ ι) DU rfl _ hbU
      have hbV0 : b.comp (Abelian.Ext.mk₀ rV) (add_zero _) = 0 :=
        ih _ (lt_of_lt_of_eq hVlt hk) (V : Scheme.{u}) (V.ι ≫ ι) DV rfl _ hbV
      calc b = b.comp (Abelian.Ext.mk₀ (𝟙 (wcEtSuppObj D))) (add_zero _) :=
            (Abelian.Ext.comp_mk₀_id b).symm
        _ = b.comp (Abelian.Ext.mk₀ (rU ≫ sU + rV ≫ sV)) (add_zero _) := by rw [hsum]
        _ = (b.comp (Abelian.Ext.mk₀ rU) (add_zero _)).comp (Abelian.Ext.mk₀ sU) (add_zero _) +
            (b.comp (Abelian.Ext.mk₀ rV) (add_zero _)).comp (Abelian.Ext.mk₀ sV)
              (add_zero _) := by
          rw [Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ← Abelian.Ext.mk₀_comp_mk₀,
            ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
            ← Abelian.Ext.comp_assoc_of_third_deg_zero]
        _ = 0 := by
          rw [hbU0, hbV0, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp, add_zero]
  exact key _ Z₀ ι₀ D₀ rfl

