    unfold wcCnSigma
    simp only [RingHom.comp_apply]
    exact resres1 _ _ _ _ _ _ _
  have hA : ∀ a : A', fl (algebraMap A' (wcQmbtChart A' n π' c' l) a) =
      fm (algebraMap A' (wcQmbtChart A' n π' c' m) a) := by
    intro a
