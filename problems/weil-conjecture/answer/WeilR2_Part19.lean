      hcov hcomm hpre hchart
    exact ⟨Proj.map f hf, H, fun s => by rw [Proj.map_preimage_basicOpen, hfmap]⟩
  have hs2 : ∀ (K : Type u) [Field K] (N : ℕ) (L M : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K), (∀ i, (L i).IsHomogeneous 1) → (∀ i, (M i).IsHomogeneous 1) → (∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i) → (∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i) → ∃ g : wcProjK K N ⟶ wcProjK K N, IsIso g ∧ ∀ s : MvPolynomial (Fin (N + 1)) K, g ⁻¹ᵁ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s) = Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.aeval L s) := by
    intro K _ N L M hL hM hLM hML
    classical
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hcc : ∀ (P : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K), (∀ i, (P i).IsHomogeneous 1) →
        ∀ p : MvPolynomial (Fin (N + 1)) K,
          MvPolynomial.constantCoeff (MvPolynomial.aeval P p) = MvPolynomial.constantCoeff p := by
      intro P hP p
      induction p using MvPolynomial.induction_on with
      | C r => rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
      | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
      | mul_X p i hp =>
        have h0 : MvPolynomial.constantCoeff (P i) = 0 := by
          rw [MvPolynomial.constantCoeff_eq]
          exact (hP i).coeff_eq_zero (by simp)
        rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, h0]
    have hirr : ∀ a : MvPolynomial (Fin (N + 1)) K,
        a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ↔
          MvPolynomial.constantCoeff a = 0 := by
      intro a
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      change ((MvPolynomial.decomposition.decompose' a 0 : MvPolynomial (Fin (N + 1)) K)) = 0 ↔ _
      rw [MvPolynomial.decomposition.decompose'_apply, MvPolynomial.homogeneousComponent_zero,
        MvPolynomial.C_eq_zero, MvPolynomial.constantCoeff_eq]
    let Φ : ∀ P : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K, (∀ i, (P i).IsHomogeneous 1) →
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      fun P hP => GradedRingHom.mk (MvPolynomial.aeval P).toRingHom (fun {n} {x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        simpa using hx.aeval P hP)
    have hΦ : ∀ P hP (x : MvPolynomial (Fin (N + 1)) K), Φ P hP x = MvPolynomial.aeval P x :=
      fun _ _ _ => rfl
    have hinv : ∀ P P' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K,
        (∀ i, MvPolynomial.aeval P (P' i) = MvPolynomial.X i) →
        ∀ x, MvPolynomial.aeval P (MvPolynomial.aeval P' x) = x := by
      intro P P' h x
      have e : (MvPolynomial.aeval P).comp (MvPolynomial.aeval P') =
          AlgHom.id K (MvPolynomial (Fin (N + 1)) K) :=
        MvPolynomial.algHom_ext (fun i => by
          rw [AlgHom.comp_apply, MvPolynomial.aeval_X, h i, AlgHom.id_apply])
      exact AlgHom.congr_fun e x
    have hcond : ∀ (P P' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)
        (hP : ∀ i, (P i).IsHomogeneous 1),
        (∀ i, (P' i).IsHomogeneous 1) →
        (∀ i, MvPolynomial.aeval P (P' i) = MvPolynomial.X i) →
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≤
          HomogeneousIdeal.map (Φ P hP)
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) := by
      intro P P' hP hP' h a ha
      have hb : MvPolynomial.aeval P' a ∈
          HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
        (hirr _).mpr (by rw [hcc P' hP', (hirr a).mp ha])
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map]
      have hm := Ideal.mem_map_of_mem (Φ P hP) (HomogeneousIdeal.mem_iff.mpr hb)
      rwa [hΦ P hP, hinv P P' h] at hm
    have hcomp : ∀ (P P' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)
        (hP : ∀ i, (P i).IsHomogeneous 1) (hP' : ∀ i, (P' i).IsHomogeneous 1),
        (∀ i, MvPolynomial.aeval P (P' i) = MvPolynomial.X i) →
        (Φ P hP).comp (Φ P' hP') = GradedRingHom.id _ := by
      intro P P' hP hP' h
      apply GradedRingHom.ext
      intro x
      rw [GradedRingHom.comp_apply, GradedRingHom.id_apply, hΦ P' hP', hΦ P hP, hinv P P' h]
    have key : ∀ (f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hf,
        f = GradedRingHom.id _ → Proj.map f hf = 𝟙 _ := by
      rintro f hf rfl
      exact Proj.map_id
    have hL' := hcond L M hL hM hLM
    have hM' := hcond M L hM hL hML
    refine ⟨Proj.map (Φ L hL) hL', ⟨Proj.map (Φ M hM) hM', ?_, ?_⟩, ?_⟩
    · rw [← Proj.map_comp]
      exact key _ _ (hcomp L M hL hM hLM)
    · rw [← Proj.map_comp]
      exact key _ _ (hcomp M L hM hL hML)
    · intro s
      rw [Proj.map_preimage_basicOpen, hΦ L hL]
  have hs3 : ∀ (Ω : Type u) [Field Ω] (e : ℕ) (A P : Matrix (Fin (2 * e + 2)) (Fin (2 * e + 2)) Ω), IsUnit P.det → wcLdpQuad Ω (2 * e + 1) (fun p q => (P.transpose * A * P) p q) = wcLdpQuad Ω (2 * e + 1) (fun p q : Fin (2 * e + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) → ∃ L M : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (2 * e + 2 + 1)) Ω, (∀ i, (L i).IsHomogeneous 1) ∧ (∀ i, (M i).IsHomogeneous 1) ∧ (∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i) ∧ (∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i) ∧ MvPolynomial.aeval L (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = (wcLdpQuad Ω (2 * e + 2) (wcXspExtCoeff (fun i j => A i j)) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) := by
    intro Ω _ e A P hP hnf
    classical

    have hQ : ∀ (N : ℕ) (b : Fin (N + 1) → Fin (N + 1) → Ω),
        (wcLdpQuad Ω N b : MvPolynomial (Fin (N + 1)) Ω) =
          dotProduct (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)
            (Matrix.mulVec ((Matrix.of b).map MvPolynomial.C)
              (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)) := by
      intro N b
      show (∑ p, ∑ q, MvPolynomial.C (b p q) * (MvPolynomial.X p * MvPolynomial.X q)) = _
      simp only [dotProduct, Matrix.mulVec, Finset.mul_sum, Matrix.map_apply, Matrix.of_apply]
      refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
      ring

    have hlin : ∀ (N : ℕ) (S : Matrix (Fin (N + 1)) (Fin (N + 1)) Ω)
        (v : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω) (i : Fin (N + 1)),
        MvPolynomial.aeval v (Matrix.mulVec (S.map MvPolynomial.C)
          (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω) i) =
          Matrix.mulVec (S.map MvPolynomial.C) v i := by
      intro N S v i
      simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, Matrix.map_apply,
        MvPolynomial.aeval_C, MvPolynomial.aeval_X, MvPolynomial.algebraMap_eq]

    have hsub : ∀ (N : ℕ) (T B : Matrix (Fin (N + 1)) (Fin (N + 1)) Ω),
        MvPolynomial.aeval (Matrix.mulVec (T.map MvPolynomial.C)
            (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω))
          (dotProduct (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)
            (Matrix.mulVec (B.map MvPolynomial.C)
              (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω))) =
        dotProduct (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)
          (Matrix.mulVec ((T.transpose * B * T).map MvPolynomial.C)
            (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)) := by
      intro N T B
      have h1 : ∀ v : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω,
          MvPolynomial.aeval v (dotProduct
            (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)
            (Matrix.mulVec (B.map MvPolynomial.C)
              (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω))) =
            dotProduct v (Matrix.mulVec (B.map MvPolynomial.C) v) := by
        intro v
        simp only [dotProduct, Matrix.mulVec, map_sum, map_mul, MvPolynomial.aeval_X,
          Matrix.map_apply, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
      rw [h1]
      have h2 : (T.transpose * B * T).map (MvPolynomial.C : Ω →+* MvPolynomial (Fin (N + 1)) Ω) =
          (T.map (MvPolynomial.C : Ω →+* MvPolynomial (Fin (N + 1)) Ω)).transpose *
            B.map (MvPolynomial.C : Ω →+* MvPolynomial (Fin (N + 1)) Ω) *
            T.map (MvPolynomial.C : Ω →+* MvPolynomial (Fin (N + 1)) Ω) := by
        rw [Matrix.map_mul, Matrix.map_mul, Matrix.transpose_map]
      rw [h2, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        Matrix.dotProduct_mulVec (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω),
        Matrix.vecMul_transpose]

    obtain ⟨E, hEcc, hEcl, hElc, hEll⟩ : ∃ E : Matrix (Fin (2 * e + 2)) (Fin (2 * e + 2)) Ω → Ω →
        Matrix (Fin (2 * e + 2 + 1)) (Fin (2 * e + 2 + 1)) Ω,
        (∀ c d (i j : Fin (2 * e + 2)), E c d i.castSucc j.castSucc = c i j) ∧
        (∀ c d (i : Fin (2 * e + 2)), E c d i.castSucc (Fin.last _) = 0) ∧
        (∀ c d (j : Fin (2 * e + 2)), E c d (Fin.last _) j.castSucc = 0) ∧
        (∀ c d, E c d (Fin.last _) (Fin.last _) = d) :=
      ⟨fun c d => Matrix.of fun p q =>
          Fin.lastCases (motive := fun _ => Ω)
            (Fin.lastCases (motive := fun _ => Ω) d (fun _ => 0) q)
            (fun i => Fin.lastCases (motive := fun _ => Ω) 0 (fun j => c i j) q) p,
        fun c d i j => by simp, fun c d i => by simp, fun c d j => by simp, fun c d => by simp⟩
    have hEmul : ∀ c d c' d', E c d * E c' d' = E (c * c') (d * d') := by
      intro c d c' d'
      ext p q
      rw [Matrix.mul_apply, Fin.sum_univ_castSucc]
      induction p using Fin.lastCases with
      | last =>
        induction q using Fin.lastCases with
        | last => simp [hEcc, hEcl, hElc, hEll]
        | cast j => simp [hEcc, hEcl, hElc, hEll]
      | cast i =>
        induction q using Fin.lastCases with
        | last => simp [hEcc, hEcl, hElc, hEll]
        | cast j => simp [hEcc, hEcl, hElc, hEll, Matrix.mul_apply]
    have hEtr : ∀ c d, (E c d).transpose = E c.transpose d := by
      intro c d
      ext p q
      induction p using Fin.lastCases with
      | last =>
        induction q using Fin.lastCases with
        | last => simp [hEcc, hEcl, hElc, hEll]
        | cast j => simp [hEcc, hEcl, hElc, hEll]
      | cast i =>
        induction q using Fin.lastCases with
        | last => simp [hEcc, hEcl, hElc, hEll]
        | cast j => simp [hEcc, hEcl, hElc, hEll]
    have hE1 : E 1 1 = 1 := by
      ext p q
      induction p using Fin.lastCases with
      | last =>
        induction q using Fin.lastCases with
        | last => simp [hEcc, hEcl, hElc, hEll]
        | cast j => simp [hEcc, hEcl, hElc, hEll, Matrix.one_apply, (Fin.castSucc_lt_last j).ne']
      | cast i =>
        induction q using Fin.lastCases with
        | last => simp [hEcc, hEcl, hElc, hEll, Matrix.one_apply, (Fin.castSucc_lt_last i).ne]
        | cast j => simp [hEcc, hEcl, hElc, hEll, Matrix.one_apply]
    have hext : ∀ (c : Matrix (Fin (2 * e + 2)) (Fin (2 * e + 2)) Ω) p q,
        wcXspExtCoeff (fun i j => c i j) p q = E c (-1) p q := by
      intro c p q
      induction p using Fin.lastCases with
      | last =>
        induction q using Fin.lastCases with
        | last => simp [wcXspExtCoeff, hEll]
        | cast j => simp [wcXspExtCoeff, hElc, j.isLt.ne]
      | cast i =>
        induction q using Fin.lastCases with
        | last => simp [wcXspExtCoeff, hEcl, i.isLt.ne]
        | cast j => simp [wcXspExtCoeff, hEcc]
    obtain ⟨Hm, hHm⟩ : ∃ Hm : Matrix (Fin (2 * e + 2)) (Fin (2 * e + 2)) Ω,
        Hm = Matrix.of fun i j : Fin (2 * e + 2) =>
          if i.val % 2 = 0 ∧ j.val = i.val + 1 then (1 : Ω) else 0 := ⟨_, rfl⟩
    have hsplit : ∀ p q, wcXspSplitCoeff Ω e p q = E Hm (-1) p q := by
      intro p q
      induction p using Fin.lastCases with
      | last =>
        induction q using Fin.lastCases with
        | last =>
          rw [hEll, wcXspSplitCoeff, if_neg (by simp), if_pos (by simp)]
        | cast j =>
          have := j.isLt
          rw [hElc, wcXspSplitCoeff, if_neg (by simp), if_neg (by simp <;> omega)]
      | cast i =>
        induction q using Fin.lastCases with
        | last =>
          have := i.isLt
          rw [hEcl, wcXspSplitCoeff, if_neg (by simp <;> omega), if_neg (by simp <;> omega)]
        | cast j =>
          have hi := i.isLt
          have hj := j.isLt
          rw [hEcc, hHm, Matrix.of_apply, wcXspSplitCoeff]
          simp only [Fin.coe_castSucc]
          by_cases h : i.val % 2 = 0 ∧ j.val = i.val + 1
          · rw [if_pos ⟨h.1, h.2, hi⟩, if_pos h]
          · rw [if_neg (fun h' => h ⟨h'.1, h'.2.1⟩), if_neg (by omega), if_neg h]

    have hQE : ∀ c : Matrix (Fin (2 * e + 2)) (Fin (2 * e + 2)) Ω,
        (wcLdpQuad Ω (2 * e + 2) (fun p q => E c (-1) p q) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
          MvPolynomial.rename (Fin.castSucc : Fin (2 * e + 2) → Fin (2 * e + 2 + 1))
            (wcLdpQuad Ω (2 * e + 1) (fun p q => c p q) : MvPolynomial (Fin (2 * e + 1 + 1)) Ω) +
          MvPolynomial.C (-1) * (MvPolynomial.X (Fin.last _) * MvPolynomial.X (Fin.last _)) := by
      intro c
      show (∑ p, ∑ q, MvPolynomial.C (E c (-1) p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
        MvPolynomial.rename (Fin.castSucc : Fin (2 * e + 2) → Fin (2 * e + 2 + 1))
          (∑ p : Fin (2 * e + 2), ∑ q : Fin (2 * e + 2),
            MvPolynomial.C (c p q) * (MvPolynomial.X p * MvPolynomial.X q)) + _
      simp only [Fin.sum_univ_castSucc (n := 2 * e + 2), hEcc, hEcl, hElc, hEll, map_zero,
        zero_mul, add_zero, Finset.sum_const_zero, zero_add, map_sum, map_mul,
        MvPolynomial.rename_C, MvPolynomial.rename_X]
    have hnf' : (wcLdpQuad Ω (2 * e + 2) (fun p q => E (P.transpose * A * P) (-1) p q) :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
        (wcLdpQuad Ω (2 * e + 2) (fun p q => E Hm (-1) p q) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) := by
      rw [hQE, hQE, hHm]
      congr 2
      exact congrArg Subtype.val hnf

    refine ⟨Matrix.mulVec ((E P⁻¹ 1).map MvPolynomial.C) MvPolynomial.X,
      Matrix.mulVec ((E P 1).map MvPolynomial.C) MvPolynomial.X, ?_, ?_, ?_, ?_, ?_⟩
    · intro i
      simp only [Matrix.mulVec, dotProduct, Matrix.map_apply]
      exact MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ =>
        (MvPolynomial.isHomogeneous_X Ω j).C_mul _
    · intro i
      simp only [Matrix.mulVec, dotProduct, Matrix.map_apply]
      exact MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ =>
        (MvPolynomial.isHomogeneous_X Ω j).C_mul _
    · intro i
      rw [hlin, Matrix.mulVec_mulVec, ← Matrix.map_mul, hEmul, Matrix.mul_nonsing_inv _ hP, mul_one,
        hE1, Matrix.map_one _ (map_zero _) (map_one _), Matrix.one_mulVec]
    · intro i
      rw [hlin, Matrix.mulVec_mulVec, ← Matrix.map_mul, hEmul, Matrix.nonsing_inv_mul _ hP, mul_one,
        hE1, Matrix.map_one _ (map_zero _) (map_one _), Matrix.one_mulVec]
    · have hinv : ∀ x, MvPolynomial.aeval (Matrix.mulVec ((E P⁻¹ 1).map MvPolynomial.C)
            MvPolynomial.X)
          (MvPolynomial.aeval (Matrix.mulVec ((E P 1).map MvPolynomial.C) MvPolynomial.X) x) = x := by
        intro x
        have e1 : (MvPolynomial.aeval (Matrix.mulVec ((E P⁻¹ 1).map MvPolynomial.C)
              MvPolynomial.X)).comp
            (MvPolynomial.aeval (Matrix.mulVec ((E P 1).map MvPolynomial.C) MvPolynomial.X)) =
            AlgHom.id Ω (MvPolynomial (Fin (2 * e + 2 + 1)) Ω) :=
          MvPolynomial.algHom_ext (fun i => by
            rw [AlgHom.comp_apply, MvPolynomial.aeval_X, hlin, Matrix.mulVec_mulVec,
              ← Matrix.map_mul, hEmul, Matrix.mul_nonsing_inv _ hP, mul_one,
              hE1, Matrix.map_one _ (map_zero _) (map_one _), Matrix.one_mulVec, AlgHom.id_apply])
        exact AlgHom.congr_fun e1 x
      have hM : MvPolynomial.aeval (Matrix.mulVec ((E P 1).map MvPolynomial.C) MvPolynomial.X)
          (wcLdpQuad Ω (2 * e + 2) (fun p q => E A (-1) p q) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
          (wcLdpQuad Ω (2 * e + 2) (fun p q => E (P.transpose * A * P) (-1) p q) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω) := by
        rw [hQ, hQ, hsub]
        congr 3
        show (E P 1).transpose * E A (-1) * E P 1 = E (P.transpose * A * P) (-1)
        rw [hEtr, hEmul, hEmul, one_mul, mul_one]
      have hG : (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
          (wcLdpQuad Ω (2 * e + 2) (fun p q => E Hm (-1) p q) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω) := by
        congr 2
        funext p q
        exact hsplit p q
      have hA : (wcLdpQuad Ω (2 * e + 2) (wcXspExtCoeff (fun i j => A i j)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) =
          (wcLdpQuad Ω (2 * e + 2) (fun p q => E A (-1) p q) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω) := by
        congr 2
        funext p q
        exact hext A p q
      rw [hG, ← hnf', ← hM, hinv, hA]
  intro k _ n hn hn4 a0 hdet F R₀ pF r₀ j₀ hr₀ hr₀s hj₀ hj₀c hj₀r FK q₁ q₂ hFK
  obtain ⟨m, hm⟩ := hn
  obtain ⟨e, rfl⟩ : ∃ e, n = 2 * e + 2 := ⟨m - 1, by omega⟩
  refine ⟨e, rfl, ?_⟩
  haveI := hr₀
  haveI := hj₀

  have hsurj₀ : Surjective r₀ := by
    constructor
    intro y
    have hy : y ∈ Set.range r₀ := by rw [hr₀s]; trivial
    exact hy
  have w₀ : (Limits.pullback.fst (r₀ ≫ pF)
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ≫ r₀) ≫ pF =
      Limits.pullback.snd (r₀ ≫ pF)
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨r₁, hr₁q₁, hr₁q₂⟩ : ∃ r₁ : Limits.pullback (r₀ ≫ pF)
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ⟶ FK,
      r₁ ≫ q₁ = Limits.pullback.fst (r₀ ≫ pF)
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ≫ r₀ ∧
      r₁ ≫ q₂ = Limits.pullback.snd (r₀ ≫ pF)
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) :=
    ⟨hFK.lift _ _ w₀, hFK.lift_fst _ _ _, hFK.lift_snd _ _ _⟩
  have hP₁ : IsPullback r₁ (Limits.pullback.fst (r₀ ≫ pF)
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) q₁ r₀ := by
    refine IsPullback.of_right ?_ hr₁q₁ hFK.flip
    rw [hr₁q₂]
    exact (IsPullback.of_hasPullback (r₀ ≫ pF) _).flip
  haveI hr₁ci : IsClosedImmersion r₁ :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP₁.flip hr₀
  have hsurj₁ : Surjective r₁ :=
    MorphismProperty.of_isPullback (P := @Surjective) hP₁.flip hsurj₀

  obtain ⟨g₀, H, hpre₀⟩ := hs1 k (AlgebraicClosure k) (2 * e + 2)
  have wj : (Limits.pullback.fst (r₀ ≫ pF)
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ≫ j₀) ≫
      wcProjKStr k (2 * e + 2) =
      Limits.pullback.snd (r₀ ≫ pF)
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) := by
    rw [Category.assoc, hj₀c]; exact Limits.pullback.condition
  obtain ⟨jbc, hjg, hjs⟩ : ∃ jbc : Limits.pullback (r₀ ≫ pF)
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ⟶
        wcProjK (AlgebraicClosure k) (2 * e + 2),
      jbc ≫ g₀ = Limits.pullback.fst (r₀ ≫ pF)
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) ≫ j₀ ∧
      jbc ≫ wcProjKStr (AlgebraicClosure k) (2 * e + 2) = Limits.pullback.snd (r₀ ≫ pF)
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) :=
    ⟨H.lift _ _ wj, H.lift_fst _ _ _, H.lift_snd _ _ _⟩
  have hPj : IsPullback jbc (Limits.pullback.fst (r₀ ≫ pF)
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) g₀ j₀ := by
    refine IsPullback.of_right ?_ hjg H.flip
    rw [hjs, hj₀c]
    exact (IsPullback.of_hasPullback (r₀ ≫ pF) _).flip
  haveI hjbcci : IsClosedImmersion jbc :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hPj.flip hj₀
  have hrange : ∀ x, x ∈ Set.range jbc ↔ g₀ x ∈ Set.range j₀ := by
    intro x
    have h1 : x ∈ Set.range (Limits.pullback.snd j₀ g₀) ↔ g₀ x ∈ Set.range j₀ := by
      rw [Scheme.Pullback.range_snd]; exact Iff.rfl
    rw [← h1]
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨hPj.flip.isoPullback.hom y, ?_⟩
      rw [← Scheme.Hom.comp_apply, hPj.flip.isoPullback_hom_snd]
    · rintro ⟨y, rfl⟩
      refine ⟨hPj.flip.isoPullback.inv y, ?_⟩
      rw [← Scheme.Hom.comp_apply, hPj.flip.isoPullback_inv_snd]
  obtain ⟨QA, hQA⟩ : ∃ Q : MvPolynomial (Fin (2 * e + 2 + 1)) (AlgebraicClosure k),
      Q = (wcLdpQuad (AlgebraicClosure k) (2 * e + 2)
        (wcXspExtCoeff (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j))) :
          MvPolynomial (Fin (2 * e + 2 + 1)) (AlgebraicClosure k)) := ⟨_, rfl⟩
  have hc : ∀ p q : Fin (2 * e + 2 + 1), algebraMap k (AlgebraicClosure k) (wcXspExtCoeff a0 p q) =
      wcXspExtCoeff (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j)) p q := by
    intro p q
    unfold wcXspExtCoeff
    split_ifs <;> simp
  have hmapQ : MvPolynomial.map (algebraMap k (AlgebraicClosure k))
      (wcLdpQuad k (2 * e + 2) (wcXspExtCoeff a0) : MvPolynomial (Fin (2 * e + 2 + 1)) k) = QA := by
    rw [hQA]
    show MvPolynomial.map (algebraMap k (AlgebraicClosure k))
        (∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
          MvPolynomial.C (wcXspExtCoeff a0 p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
      ∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
        MvPolynomial.C (wcXspExtCoeff (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j)) p q) *
          (MvPolynomial.X p * MvPolynomial.X q)
    rw [map_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [map_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, MvPolynomial.map_X, hc]
  have hstar : ∀ x, x ∈ Set.range jbc ↔
      x ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1))
        (AlgebraicClosure k)) QA := by
    intro x
    rw [hrange, hj₀r, ← hmapQ, ← hpre₀, Scheme.Hom.mem_preimage]
    exact Iff.rfl

  have hdetK : (Matrix.of (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j)) +
      (Matrix.of (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j))).transpose).det ≠ 0 := by
    have h1 : (Matrix.of (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j)) +
        (Matrix.of (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j))).transpose) =
        (algebraMap k (AlgebraicClosure k)).mapMatrix (Matrix.of a0 + (Matrix.of a0).transpose) := by
      ext i j
      simp [RingHom.mapMatrix_apply]
    rw [h1, ← RingHom.map_det]
    exact (map_ne_zero _).mpr hdet
  obtain ⟨P, hPu, hPnf⟩ := wc_quadric_split_normal_form_alg_closed (AlgebraicClosure k) (2 * e)
    ⟨e, by ring⟩ (Matrix.of (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j))) hdetK
  obtain ⟨L, M, hL, hM, hLM, hML, hLG⟩ := hs3 (AlgebraicClosure k) e
    (Matrix.of (fun i j => algebraMap k (AlgebraicClosure k) (a0 i j))) P hPu hPnf
  have hLG' : MvPolynomial.aeval L (wcLdpQuad (AlgebraicClosure k) (2 * e + 2)
      (wcXspSplitCoeff (AlgebraicClosure k) e) : MvPolynomial (Fin (2 * e + 2 + 1))
        (AlgebraicClosure k)) = QA := by
    rw [hQA]; exact hLG
  obtain ⟨g, hgiso, hgpre⟩ := hs2 (AlgebraicClosure k) (2 * e + 2) L M
    hL hM hLM hML
  haveI := hgiso
  have hss : ∀ y, g y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1))
        (AlgebraicClosure k)) (wcLdpQuad (AlgebraicClosure k) (2 * e + 2)
          (wcXspSplitCoeff (AlgebraicClosure k) e) : MvPolynomial (Fin (2 * e + 2 + 1))
            (AlgebraicClosure k)) ↔
      y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1))
        (AlgebraicClosure k)) QA := by
    intro y
    rw [← hLG', ← hgpre, Scheme.Hom.mem_preimage]

  obtain ⟨R, r', hr'ci, hr'r, hR⟩ := wc_reduced_subscheme_exists (Limits.pullback (r₀ ≫ pF)
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))
  haveI := hr'ci
  refine ⟨R, hR, r' ≫ r₁, r' ≫ jbc ≫ g, inferInstance, ?_, inferInstance, ?_⟩
  · apply Set.eq_univ_of_forall
    intro y
    obtain ⟨z, hz⟩ := hsurj₁.surj y
    obtain ⟨x, hx⟩ : z ∈ Set.range r' := by rw [hr'r]; trivial
    exact ⟨x, by rw [Scheme.Hom.comp_apply, hx]; exact hz⟩
  · ext p
    constructor
    · rintro ⟨x, rfl⟩
      show (r' ≫ jbc ≫ g) x ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule
        (Fin (2 * e + 2 + 1)) (AlgebraicClosure k)) (wcLdpQuad (AlgebraicClosure k) (2 * e + 2)
          (wcXspSplitCoeff (AlgebraicClosure k) e) : MvPolynomial (Fin (2 * e + 2 + 1))
            (AlgebraicClosure k))
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      have h1 := (hstar (jbc (r' x))).mp ⟨r' x, rfl⟩
      intro h
      exact h1 ((hss _).mp h)
    · intro hp
      have hp' : p ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule
          (Fin (2 * e + 2 + 1)) (AlgebraicClosure k)) (wcLdpQuad (AlgebraicClosure k) (2 * e + 2)
            (wcXspSplitCoeff (AlgebraicClosure k) e) : MvPolynomial (Fin (2 * e + 2 + 1))
              (AlgebraicClosure k)) := hp
      have hgq : g ((inv g) p) = p := by
        have : (inv g ≫ g) p = p := by rw [IsIso.inv_hom_id] <;> rfl
        exact this
      have h2 : (inv g) p ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule
          (Fin (2 * e + 2 + 1)) (AlgebraicClosure k)) QA := by
        intro h
        apply hp'
        rw [← hgq]
        exact (hss _).mpr h
      obtain ⟨z, hz⟩ := (hstar _).mpr h2
      obtain ⟨x, hx⟩ : z ∈ Set.range r' := by rw [hr'r]; trivial
      exact ⟨x, by rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hx, hz, hgq]⟩

theorem wc_qxs_odd_chart_affine_iso : ∀ (Ω : Type u) [Field Ω] (e : ℕ) (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] (jY : Y ⟶ wcProjK Ω (2 * e + 2)), IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) → ∀ c : Fin (2 * e + 2 + 1), c.val ≤ 2 * e + 1 → ∃ φ : ((jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) c : Y.Opens) : Scheme.{u}) ≅ Spec (.of (MvPolynomial (Fin (2 * e + 1)) Ω)), φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap Ω (MvPolynomial (Fin (2 * e + 1)) Ω))) = (jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) c).ι ≫ jY ≫ wcProjKStr Ω (2 * e + 2) :=
by
  intro Ω _ e Y _ jY hjY hY c hc
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  haveI := hjY

  have s2 : ∀ (m : ℕ) (a : Fin (m + 1)) (g₀ : MvPolynomial (Fin m) Ω),
      Function.Surjective (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X)) ∧
      RingHom.ker (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X)) =
        Ideal.span {MvPolynomial.X a + MvPolynomial.rename a.succAbove g₀} := by
    intro m a g₀
    have hC : ∀ c : Ω, (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X))
        (MvPolynomial.C c) = MvPolynomial.C c := fun c => by rw [MvPolynomial.eval₂Hom_C]
    have hXa : (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X))
        (MvPolynomial.X a) = -g₀ := by
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
    have hXs : ∀ i : Fin m, (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X))
        (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i := fun i => by
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
    generalize (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X)) = φ
      at hC hXa hXs ⊢
    have hφι : ∀ p, φ (MvPolynomial.rename a.succAbove p) = p := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r => rw [MvPolynomial.rename_C, hC]
      | add p q hp hq => rw [map_add, map_add, hp, hq]
      | mul_X p n hp => rw [map_mul, map_mul, hp, MvPolynomial.rename_X, hXs]
    refine ⟨fun p => ⟨_, hφι p⟩, ?_⟩
    have hdiff : ∀ F, F - MvPolynomial.rename a.succAbove (φ F) ∈
        Ideal.span {MvPolynomial.X a + MvPolynomial.rename a.succAbove g₀} := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C r => rw [hC, MvPolynomial.rename_C, sub_self]; exact zero_mem _
      | add p q hp hq => rw [map_add, map_add, add_sub_add_comm]; exact add_mem hp hq
      | mul_X p n hp =>
        rw [map_mul, map_mul]
        have e' : p * MvPolynomial.X n - MvPolynomial.rename a.succAbove (φ p) *
            MvPolynomial.rename a.succAbove (φ (MvPolynomial.X n)) =
            (p - MvPolynomial.rename a.succAbove (φ p)) * MvPolynomial.X n +
            MvPolynomial.rename a.succAbove (φ p) *
              (MvPolynomial.X n - MvPolynomial.rename a.succAbove (φ (MvPolynomial.X n))) := by
          ring
        rw [e']
        refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
        rcases Fin.eq_self_or_eq_succAbove a n with h | ⟨j, h⟩
        · subst h
          rw [hXa, map_neg, sub_neg_eq_add]
          exact Ideal.mem_span_singleton_self _
        · subst h
          rw [hXs, MvPolynomial.rename_X, sub_self]
          exact zero_mem _
    apply le_antisymm
    · intro F hF
      rw [RingHom.mem_ker] at hF
      have h := hdiff F
      rwa [hF, map_zero, sub_zero] at h
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_add, hXa,
        hφι, neg_add_cancel]

  have s5 : ∀ (W Z U : Scheme.{u}) [AlgebraicGeometry.IsReduced W]
      [AlgebraicGeometry.IsReduced Z] (g : W ⟶ U) (z : Z ⟶ U) [IsClosedImmersion g]
      [IsClosedImmersion z], Set.range g = Set.range z → ∃ φ : W ≅ Z, φ.hom ≫ z = g := by
    intro W Z U _ _ g z _ _ h
    have H : z.ker ≤ g.ker := by
      show z.ker ≤ Scheme.IdealSheafData.ofIdeals
        (fun V : U.affineOpens => RingHom.ker (g.app V).hom)
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro V s hs
      have hz : (z.app V).hom s = 0 :=
        Scheme.IdealSheafData.ideal_ofIdeals_le
          (I := fun V : U.affineOpens => RingHom.ker (z.app V).hom) V hs
      have hX : z ⁻¹ᵁ U.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen]
        erw [hz]
        exact Scheme.basicOpen_zero _ _
      have hW : W.basicOpen ((g.app V).hom s) = ⊥ := by
        rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
        intro w hw
        obtain ⟨x, hx⟩ : g w ∈ Set.range z := h ▸ ⟨w, rfl⟩
        have hx' : x ∈ z ⁻¹ᵁ U.basicOpen s := by
          show z x ∈ U.basicOpen s
          rw [hx]; exact hw
        rw [hX] at hx'
        exact hx'.elim
      exact eq_zero_of_basicOpen_eq_bot _ hW
    have hg' : IsClosedImmersion.lift z g H ≫ z = g := IsClosedImmersion.lift_fac z g H
    have : IsClosedImmersion (IsClosedImmersion.lift z g H ≫ z) := by rw [hg']; infer_instance
    have : IsClosedImmersion (IsClosedImmersion.lift z g H) :=
      IsClosedImmersion.of_comp (IsClosedImmersion.lift z g H) z
    have : Surjective (IsClosedImmersion.lift z g H) := by
      constructor
      intro w'
      obtain ⟨w, hw⟩ : z w' ∈ Set.range g := h ▸ ⟨w', rfl⟩
      refine ⟨w, z.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, hg', hw]
    have := isIso_of_isClosedImmersion_of_surjective (IsClosedImmersion.lift z g H)
    exact ⟨asIso (IsClosedImmersion.lift z g H), hg'⟩

  have s1 : ∀ (a : Fin (2 * e + 2 + 1)), ∃ E : MvPolynomial (Fin (2 * e + 2)) Ω ≃+*
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
        (MvPolynomial.X a),
      (∀ (n : ℕ) (F : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω (n • 1)),
        E (MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (2 * e + 2)) Ω) a 1 MvPolynomial.X) F) =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a))
          n F hF) ∧
      (∀ r : Ω, E (MvPolynomial.C r) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) r)) := by
    intro a
    have scale : ∀ {S : Type u} [CommRing S] (φ : Ω →+* S) (x : Fin (2 * e + 2 + 1) → S) (t : S)
        (n : ℕ) (F : MvPolynomial (Fin (2 * e + 2 + 1)) Ω), F.IsHomogeneous n →
        MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
      intro S _ φ x t n F hF
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : Finsupp.degree d = n := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hp : (d.prod fun i k => (t * x i) ^ k) = t ^ n * d.prod fun i k => x i ^ k := by
        simp only [mul_pow]
        rw [Finsupp.prod_mul]
        congr 1
        rw [← hdeg, Finsupp.degree_apply]
        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hX : (MvPolynomial.X a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X Ω a)
    have hg : ∀ i : Fin (2 * e + 2), (MvPolynomial.X (a.succAbove i) :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω (1 • 1) := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X Ω _)
    obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin (2 * e + 2)) Ω →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (MvPolynomial.X a),
        (∀ c : Ω, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) c)) ∧
        (∀ i : Fin (2 * e + 2), ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hX 1
          (MvPolynomial.X (a.succAbove i)) (hg i)) :=
      ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)))
        (fun i => HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
        fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
        fun i => by rw [MvPolynomial.eval₂Hom_X']⟩
    obtain ⟨ρt, hρC, hρa, hρs, hρdef⟩ : ∃ ρt : MvPolynomial (Fin (2 * e + 2 + 1)) Ω →+*
        MvPolynomial (Fin (2 * e + 2)) Ω,
        (∀ c : Ω, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
        (∀ i : Fin (2 * e + 2), ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) ∧
        ρt = MvPolynomial.eval₂Hom MvPolynomial.C
