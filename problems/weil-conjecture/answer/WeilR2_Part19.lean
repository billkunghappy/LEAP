theorem wc_et_basechange_open_piece : ∀ {Y Z : Scheme.{u}} (ι : Z ⟶ Y) (U : Z.Opens), ∃ j : ∀ W : Y.Etale, ((wcEtBaseChange (U.ι ≫ ι)).obj W).left ⟶ ((wcEtBaseChange ι).obj W).left, (∀ W, IsOpenImmersion (j W)) ∧ (∀ (W : Y.Etale) (x : ((wcEtBaseChange ι).obj W).left), x ∈ Set.range ⇑(j W) ↔ ((wcEtBaseChange ι).obj W).hom x ∈ U) ∧ ∀ (W W' : Y.Etale) (h : W' ⟶ W), j W' ≫ ((wcEtBaseChange ι).map h).left = ((wcEtBaseChange (U.ι ≫ ι)).map h).left ≫ j W :=
