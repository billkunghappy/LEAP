            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))) ∉
          Ideal.span {(Spec.preimage (cC ≫ f)).hom π'} ∧
      ∃ b : C, (Spec.preimage (cC ≫ f)).hom π' =
        (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))) * b :=
by
  classical

  have s1 : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (S : Set X), IsOpen S →
      ∀ w ∈ closure S, ∃ w' ∈ S, w' ⤳ w := by
    intro X _ S hS w hw
    obtain ⟨W, hWa, hwW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show w ∈ (⊤ : X.Opens) from trivial)
    haveI : IsNoetherianRing Γ(X, W) := IsLocallyNoetherian.component_noetherian ⟨W, hWa⟩
    haveI : TopologicalSpace.NoetherianSpace W := noetherianSpace_of_isAffineOpen W hWa
    obtain ⟨𝒮, h𝒮f, -, h𝒮i, h𝒮u⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible
        (isClosed_univ : IsClosed (Set.univ : Set W))
    set 𝒮' : Set (Set W) := {t | t ∈ 𝒮 ∧ ((Subtype.val '' t) ∩ S).Nonempty} with h𝒮'
    have h𝒮'f : 𝒮'.Finite := h𝒮f.subset (fun t ht => ht.1)
    set F : Set X := ⋃ t ∈ 𝒮', closure (Subtype.val '' t) with hF
    have hFc : IsClosed F := h𝒮'f.isClosed_biUnion (fun t _ => isClosed_closure)
    have hwF : w ∈ F := by
      by_contra hwF
      have hO : IsOpen ((W : Set X) ∩ Fᶜ) := W.isOpen.inter hFc.isOpen_compl
      obtain ⟨p, ⟨hpW, hpF⟩, hpS⟩ := mem_closure_iff.mp hw _ hO ⟨hwW, hwF⟩
      have hpu : (⟨p, hpW⟩ : W) ∈ ⋃₀ 𝒮 := h𝒮u ▸ Set.mem_univ _
      obtain ⟨t, ht, hpt⟩ := hpu
      apply hpF
      have hpt' : p ∈ Subtype.val '' t := ⟨_, hpt, rfl⟩
      exact Set.mem_biUnion (x := t) ⟨ht, ⟨p, hpt', hpS⟩⟩ (subset_closure hpt')
    obtain ⟨t, ⟨ht, hne⟩, hwt⟩ := Set.mem_iUnion₂.mp hwF
    have hirr : IsIrreducible (Subtype.val '' t) :=
      (h𝒮i t ht).image _ continuous_subtype_val.continuousOn
    have hη := hirr.isGenericPoint_genericPoint_closure
    refine ⟨hirr.genericPoint, ?_, hη.specializes hwt⟩
    obtain ⟨q, hq⟩ := hne
    exact (hη.mem_open_set_iff hS).mpr ⟨q, subset_closure hq.1, hq.2⟩

  have s2 : ∀ (C : Type u) [CommRing C] (cC : Spec (.of C) ⟶ Xm) (s : Γ(Xm, ⊤))
      (c : Spec (.of C)), cC c ∈ Xm.basicOpen s ↔
        (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom s) ∉
          PrimeSpectrum.asIdeal c := by
    intro C _ cC s c
    obtain ⟨t, ht⟩ : ∃ t, (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom s) = t :=
      ⟨_, rfl⟩
    have h2 : cC.appTop.hom s = (Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom t := by
      rw [← ht]; simp
    rw [ht, ← Scheme.Hom.mem_preimage, Scheme.preimage_basicOpen]
    change c ∈ (Spec (.of C)).basicOpen (cC.appTop.hom s) ↔ _
    rw [h2, basicOpen_eq_of_affine]
    exact PrimeSpectrum.mem_basicOpen _ _

  have s3 : ∀ (R : Type u) [CommRing R] (g : Xm ⟶ Spec (.of R)) (r : R) (y : Xm),
      y ∈ Xm.basicOpen (g.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) ↔
        r ∉ PrimeSpectrum.asIdeal (g y) := by
    intro R _ g r y
    have h := Scheme.preimage_basicOpen g ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)
    change g ⁻¹ᵁ _ = Xm.basicOpen (g.appTop.hom _) at h
    rw [← h, Scheme.Hom.mem_preimage, basicOpen_eq_of_affine]
    exact PrimeSpectrum.mem_basicOpen _ _

  have s4 : ∀ (V : Xm.Opens) (s t : Γ(Xm, ⊤)),
      (∃ b : Γ(Xm, V), (Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom s =
        (Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom t * b) →
      ∀ y : Xm, y ∈ V → y ∈ Xm.basicOpen s → y ∈ Xm.basicOpen t := by
    intro V s t h y hyV hys
    obtain ⟨b, hb⟩ := h
    have h1 : y ∈ Xm.basicOpen ((Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom s) := by
      rw [Scheme.basicOpen_res]; exact ⟨hyV, hys⟩
    rw [hb, Scheme.basicOpen_mul, Scheme.basicOpen_res] at h1
    exact h1.1.2

  have s5 : ∀ (C : Type u) [CommRing C] [IsLocalRing C] (cC : Spec (.of C) ⟶ Xm)
      (V : Xm.Opens), cC (IsLocalRing.closedPoint C) ∈ V → ∀ (s t : Γ(Xm, ⊤)) (b : Γ(Xm, V)),
      (Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom s =
        (Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom t * b →
      ∃ b' : C, (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom s) =
        (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom t) * b' := by
    intro C _ _ cC V hz s t b h
    have hle : (⊤ : (Spec (.of C)).Opens) ≤ cC ⁻¹ᵁ V := by
      intro c _
      exact ((IsLocalRing.specializes_closedPoint c).map cC.continuous).mem_open V.isOpen hz
    have hle' : cC ⁻¹ᵁ ⊤ ≤ cC ⁻¹ᵁ V := by rw [Scheme.Hom.preimage_top]; exact hle
    have key : ∀ u : Γ(Xm, ⊤), (cC.appLE V (cC ⁻¹ᵁ ⊤) hle').hom
        ((Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom u) = cC.appTop.hom u := by
      intro u
      rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE, Scheme.Hom.appLE_eq_app]
      rfl
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom
      ((cC.appLE V (cC ⁻¹ᵁ ⊤) hle').hom b), ?_⟩
    rw [← key s, ← key t, h, map_mul]
    exact map_mul (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom _ _

  have s6 : ∀ (C : Type u) [CommRing C] (cC : Spec (.of C) ⟶ Xm) (a : A'),
