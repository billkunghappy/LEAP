    have hX : ∀ i : Fin (e + 1 + 1),
        (MvPolynomial.X i : MvPolynomial (Fin (e + 1 + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 1 :=
      fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K i)
    let L : wcProjK K e ⟶ wcProjK K (e + 1) := Proj.map φ hf
    have hLci : IsClosedImmersion L := s4 φ hf (fun i : Fin (e + 1 + 1) => MvPolynomial.X i)
      (fun _ => 1) hX (fun _ => Nat.one_pos) hcov (fun i => s3 φ hdeg _ 1 (hX i))
    have hpre : ∀ a : MvPolynomial (Fin (e + 1 + 1)) K,
        L ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) a =
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) (φ a) :=
      fun a => Proj.map_preimage_basicOpen φ hf a
    let f₀ : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0) →+*
        ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K 0) :=
      { toFun := fun a => ⟨φ a, φ.map_mem a.2⟩
        map_one' := Subtype.ext (by
          show φ ((1 : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one])
        map_mul' := fun a b => Subtype.ext (by
          show φ ((a * b : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [SetLike.GradeZero.coe_mul, SetLike.GradeZero.coe_mul, map_mul])
        map_zero' := Subtype.ext (by
          show φ ((0 : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [ZeroMemClass.coe_zero, ZeroMemClass.coe_zero, map_zero])
        map_add' := fun a b => Subtype.ext (by
          show φ ((a + b : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [AddMemClass.coe_add, AddMemClass.coe_add, map_add]) }
    have hLstr : L ≫ wcProjKStr K (e + 1) = wcProjKStr K e := by
      have hb := wc_bc_proj_map_toSpecZero φ hf f₀ (fun a => rfl)
      have hcomp : f₀.comp (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) =
          algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K 0) := by
        apply RingHom.ext
        intro r
        apply Subtype.ext
        show φ ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0) r :
          MvPolynomial (Fin (e + 1 + 1)) K)) = _
        rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ]
        exact (MvPolynomial.aeval g).commutes r
      show L ≫ (Proj.toSpecZero _ ≫ Spec.map _) = Proj.toSpecZero _ ≫ Spec.map _
      rw [← Category.assoc, hb, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
    have hret : ∀ a : MvPolynomial (Fin (e + 1 + 1)) K,
