    haveI := hne E₀.left (j + 1)
    have h1 : Nat.card (wcEtCoh E₀.left ℓ (j + 1)) = 1 :=
      Nat.card_eq_one_iff_unique.mpr ⟨hE, inferInstance⟩
    exact (Nat.card_eq_one_iff_unique.mp ((hcard (j + 1)).symm.trans h1)).1

  refine wc_hm_vanish_of_int_ext_vanish Y ℓ j ?_ z
  apply wc_proet_int_ext_vanish_of_zmod_deg Y ℓ (Scheme.ProEt.mk (𝟙 Y)) j
  intro k'
