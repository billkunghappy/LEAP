      (AlgebraicClosure (IsLocalRing.ResidueField B₀)))]
    exact (map_ne_zero _).mpr hℓk
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero

  have hF : IsPullback (Limits.pullback.fst f₀ (wcQmSp B₀)) (Limits.pullback.snd f₀ (wcQmSp B₀))
