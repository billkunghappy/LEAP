    · rintro ⟨i, hi, hn⟩
      exact ⟨i, hi, by rw [← hψt]; exact (hmem y _).mp hn⟩

theorem wc_hq_removed_plane : ∀ (Ω : Type u) [Field Ω] (d : ℕ), Even d → 2 ≤ d → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (jY : Y ⟶ wcProjK Ω (d + 1)), IsClosedImmersion jY → jY ≫ wcProjKStr Ω (d + 1) = fY → Set.range jY = {p | p ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) : MvPolynomial (Fin (d + 1 + 1)) Ω)} → ∃ (Z : Scheme.{u}) (i : Z ⟶ Y), IsClosedImmersion i ∧ SmoothOfRelativeDimension (d - (d / 2 + 1)) (i ≫ fY) ∧ Set.range i = ((⨆ (k : ℕ) (_ : k ≤ d / 2 + 1), jY ⁻¹ᵁ wcSgD Ω (d + 1) ⟨if k ≤ d / 2 then 2 * k + 1 else d, by split_ifs <;> omega⟩ : Y.Opens) : Set Y)ᶜ :=
by
  classical
  intro Ω _ d hd hd2 Y fY jY hjY hjYfY hY
  haveI := hjY
  obtain ⟨r, hr⟩ := hd
  obtain ⟨e, he⟩ : ∃ e, d - (d / 2 + 1) = e := ⟨_, rfl⟩
  rw [he]
  have hde : e + 1 = r := by omega
  obtain ⟨Hp, hHpdef⟩ : ∃ Hp : MvPolynomial (Fin (d + 1 + 1)) Ω, Hp = (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) : MvPolynomial (Fin (d + 1 + 1)) Ω) := ⟨_, rfl⟩
  rw [← hHpdef] at hY

  have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
      (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
      IsClosedImmersion (Proj.map f hf) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
      (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
    intro i
    have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
    let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
    let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
    let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
    have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
    have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
      simp only [iV, iU, Proj.opensRange_awayι]
      exact Proj.map_preimage_basicOpen f hf (s i)
    have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
    have hg : IsClosedImmersion g :=
      IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
    have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
          (by
            dsimp only [Arrow.mk_hom, Iso.refl_hom]
            rw [Category.comp_id]
            exact IsPullback.isoPullback_hom_snd _))).mp hg
    have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictOpensRange _ iV)).mpr h1
    exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
      (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2
  have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
      ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
    obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
    obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
    exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩
  have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) Ω),
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) Ω) ↔
        p.coeff 0 = 0 := by
    intro n p
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    erw [MvPolynomial.decomposition.decompose'_apply]
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
  letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
    MvPolynomial.gradedAlgebra

  let g : Fin (d + 1 + 1) → MvPolynomial (Fin (e + 1)) Ω := fun t =>
    if h : t.val % 2 = 0 ∧ t.val / 2 < e + 1 then MvPolynomial.X ⟨t.val / 2, h.2⟩ else 0
  let c : Fin (e + 1) → Fin (d + 1 + 1) := fun j => ⟨2 * j.val, by have := j.isLt; omega⟩
  have hg : ∀ t, (g t).IsHomogeneous 1 := by
    intro t
    dsimp only [g]
    split_ifs
    · exact MvPolynomial.isHomogeneous_X Ω _
    · exact MvPolynomial.isHomogeneous_zero _ _ 1
  have hgc : ∀ j, g (c j) = MvPolynomial.X j := by
    intro j
    have h : (c j).val % 2 = 0 ∧ (c j).val / 2 < e + 1 := by
      show 2 * j.val % 2 = 0 ∧ 2 * j.val / 2 < e + 1
      have := j.isLt; omega
    dsimp only [g]
    rw [dif_pos h]
    congr 1
    exact Fin.ext (by show 2 * j.val / 2 = j.val; omega)
  have hX0 : ∀ t, g t = 0 ↔ ¬ (t.val % 2 = 0 ∧ t.val / 2 < e + 1) := by
    intro t
    by_cases h : t.val % 2 = 0 ∧ t.val / 2 < e + 1
    · have h' : g t = MvPolynomial.X ⟨t.val / 2, h.2⟩ := by dsimp only [g]; rw [dif_pos h]
      rw [h']
      exact iff_of_false (MvPolynomial.X_ne_zero _) (not_not.mpr h)
    · have h' : g t = 0 := by dsimp only [g]; rw [dif_neg h]
      exact iff_of_true h' h
  have hsurjc : ∀ t, g t ≠ 0 → ∃ j, c j = t := by
    intro t ht
    have h : t.val % 2 = 0 ∧ t.val / 2 < e + 1 := by
      by_contra h
      exact ht ((hX0 t).mpr h)
    exact ⟨⟨t.val / 2, h.2⟩, Fin.ext (by show 2 * (t.val / 2) = t.val; omega)⟩
  have hT : ∀ t : Fin (d + 1 + 1), g t = 0 ↔ ∃ k : ℕ, k ≤ d / 2 + 1 ∧
      t = ⟨if k ≤ d / 2 then 2 * k + 1 else d, by split_ifs <;> omega⟩ := by
    intro t
    rw [hX0]
    have ht := t.isLt
    constructor
    · intro h
      by_cases hodd : t.val % 2 = 0
      · refine ⟨d / 2 + 1, le_rfl, Fin.ext ?_⟩
        show t.val = if d / 2 + 1 ≤ d / 2 then 2 * (d / 2 + 1) + 1 else d
        rw [if_neg (by omega)]
        omega
      · refine ⟨t.val / 2, by omega, Fin.ext ?_⟩
        show t.val = if t.val / 2 ≤ d / 2 then 2 * (t.val / 2) + 1 else d
        rw [if_pos (by omega)]
        omega
    · rintro ⟨k, hk, rfl⟩
      show ¬ ((if k ≤ d / 2 then 2 * k + 1 else d) % 2 = 0 ∧
        (if k ≤ d / 2 then 2 * k + 1 else d) / 2 < e + 1)
      split_ifs <;> omega

  let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
    ⟨(MvPolynomial.aeval g).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      have := hx.aeval g hg
      rw [one_mul] at this
      exact this⟩
  let ψ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) :=
    ⟨(MvPolynomial.rename c).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      exact hx.rename_isHomogeneous⟩
  have hφ : ∀ a, φ a = MvPolynomial.aeval g a := fun a => rfl
  have hψ : ∀ b, ψ b = MvPolynomial.rename c b := fun b => rfl
  have hφψ : ∀ b, φ (ψ b) = b := by
    intro b
    rw [hφ, hψ, MvPolynomial.aeval_rename]
    have hgc' : g ∘ c = MvPolynomial.X := funext hgc
    rw [hgc', MvPolynomial.aeval_X_left_apply]
  have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) ≤
      HomogeneousIdeal.map φ
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)) := by
    intro b hb
    have hb0 : b.coeff 0 = 0 := (s1 (e + 1) b).mp hb
    have hψb : ψ b ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) := by
      apply (s1 (d + 1 + 1) (ψ b)).mpr
      rw [hψ]
      rw [← MvPolynomial.constantCoeff_eq] at hb0 ⊢
      exact (MvPolynomial.constantCoeff_rename c b).trans hb0
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map, ← hφψ b]
    exact Ideal.mem_map_of_mem φ (HomogeneousIdeal.mem_iff.mpr hψb)
  have hdeg : ∀ (n : ℕ) (b : MvPolynomial (Fin (e + 1)) Ω),
      b ∈ MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω n →
      ∃ a ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω n, φ a = b :=
    fun n b hb => ⟨ψ b, ψ.map_mem hb, hφψ b⟩
  have hcov : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (d + 1 + 1) → MvPolynomial (Fin (d + 1 + 1)) Ω)) := by
    intro x hx
    have hx0 : x.coeff 0 = 0 := (s1 (d + 1 + 1) x).mp (HomogeneousIdeal.mem_iff.mp hx)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  have hX : ∀ i : Fin (d + 1 + 1),
      (MvPolynomial.X i : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X Ω i)

  let L : wcProjK Ω e ⟶ wcProjK Ω (d + 1) := Proj.map φ hf
  have hLci : IsClosedImmersion L := s4 φ hf (fun i : Fin (d + 1 + 1) => MvPolynomial.X i)
    (fun _ => 1) hX (fun _ => Nat.one_pos) hcov (fun i => s3 φ hdeg _ 1 (hX i))
  haveI := hLci
  have hpre : ∀ a : MvPolynomial (Fin (d + 1 + 1)) Ω,
      L ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) a =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) (φ a) :=
    fun a => Proj.map_preimage_basicOpen φ hf a

  let f₀ : ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0) →+*
      ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω 0) :=
    { toFun := fun a => ⟨φ a, φ.map_mem a.2⟩
      map_one' := Subtype.ext (by
        show φ ((1 : ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0)) :
          MvPolynomial (Fin (d + 1 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one])
      map_mul' := fun a b => Subtype.ext (by
        show φ ((a * b : ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0)) :
          MvPolynomial (Fin (d + 1 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_mul, SetLike.GradeZero.coe_mul, map_mul])
      map_zero' := Subtype.ext (by
        show φ ((0 : ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0)) :
          MvPolynomial (Fin (d + 1 + 1)) Ω) = _
        rw [ZeroMemClass.coe_zero, ZeroMemClass.coe_zero, map_zero])
      map_add' := fun a b => Subtype.ext (by
        show φ ((a + b : ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0)) :
          MvPolynomial (Fin (d + 1 + 1)) Ω) = _
        rw [AddMemClass.coe_add, AddMemClass.coe_add, map_add]) }
  have hLstr : L ≫ wcProjKStr Ω (d + 1) = wcProjKStr Ω e := by
    have hb := wc_bc_proj_map_toSpecZero φ hf f₀ (fun a => rfl)
    have hcomp : f₀.comp (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0)) =
        algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω 0) := by
      apply RingHom.ext
      intro r
      apply Subtype.ext
      show φ ((algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0) r :
        MvPolynomial (Fin (d + 1 + 1)) Ω)) = _
      rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ]
      exact (MvPolynomial.aeval g).commutes r
    show L ≫ (Proj.toSpecZero _ ≫ Spec.map _) = Proj.toSpecZero _ ≫ Spec.map _
    rw [← Category.assoc, hb, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]

  have hret : ∀ a : MvPolynomial (Fin (d + 1 + 1)) Ω,
      a - ψ (φ a) ∈ Ideal.span (MvPolynomial.X '' {t : Fin (d + 1 + 1) | g t = 0}) := by
    intro a
    have key : (Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (d + 1 + 1) | g t = 0}))).comp
        ((MvPolynomial.rename c).comp (MvPolynomial.aeval g)) =
        Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (d + 1 + 1) | g t = 0})) := by
      apply MvPolynomial.algHom_ext
      intro t
      rw [AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.aeval_X]
      by_cases ht : g t = 0
      · rw [ht, map_zero, map_zero, Ideal.Quotient.mkₐ_eq_mk, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨t, ht, rfl⟩
      · obtain ⟨j, rfl⟩ := hsurjc t ht
        rw [hgc, MvPolynomial.rename_X]
    have h2 := congrArg (fun F => F a) key
    simp only [AlgHom.comp_apply] at h2
    rw [Ideal.Quotient.mkₐ_eq_mk] at h2
    rw [hφ, hψ]
    exact Ideal.Quotient.eq.mp h2.symm

  have hrange : ∀ p : wcProjK Ω (d + 1), p ∈ Set.range L ↔
      ∀ t, g t = 0 → (MvPolynomial.X t : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈ p.asHomogeneousIdeal := by
    intro p
    constructor
    · rintro ⟨z, rfl⟩ t ht
      by_contra hn
      have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          (MvPolynomial.X t) := (Proj.mem_basicOpen _ _ _).mpr hn
      have h2 := (Scheme.Hom.mem_preimage L).mpr h1
      rw [hpre, hφ, MvPolynomial.aeval_X, ht, Proj.basicOpen_zero] at h2
      exact TopologicalSpace.Opens.mem_bot.mp h2
    · intro H
      haveI hpr : p.asHomogeneousIdeal.toIdeal.IsPrime := p.isPrime
      have hK : Ideal.span (MvPolynomial.X '' {t : Fin (d + 1 + 1) | g t = 0}) ≤
          p.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨t, ht, rfl⟩
        exact H t ht
      obtain ⟨i, hi⟩ : ∃ i : Fin (d + 1 + 1),
          (MvPolynomial.X i : MvPolynomial (Fin (d + 1 + 1)) Ω) ∉ p.asHomogeneousIdeal.toIdeal := by
        by_contra hno
        push_neg at hno
        apply ProjectiveSpectrum.not_irrelevant_le p
        intro x hx
        have h3 := hcov (HomogeneousIdeal.mem_iff.mpr hx)
        have hle : Ideal.span (Set.range (MvPolynomial.X : Fin (d + 1 + 1) →
            MvPolynomial (Fin (d + 1 + 1)) Ω)) ≤ p.asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          exact hno j
        exact HomogeneousIdeal.mem_iff.mp (hle h3)
      have hgi : g i ≠ 0 := fun h0 => hi (hK (Ideal.subset_span ⟨i, h0, rfl⟩))
      obtain ⟨j, rfl⟩ := hsurjc i hgi
      let q := HomogeneousIdeal.comap ψ p.asHomogeneousIdeal
      have hq : q.toIdeal = Ideal.comap ψ p.asHomogeneousIdeal.toIdeal :=
        HomogeneousIdeal.toIdeal_comap ψ
      haveI hqp : q.toIdeal.IsPrime := by rw [hq]; exact Ideal.comap_isPrime ψ _
      have hqrel : ¬ HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) ≤ q := by
        intro hle
        have hXj : (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) Ω) ∈ HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
          (s1 (e + 1) _).mpr (MvPolynomial.coeff_zero_X j)
        have h1 : (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) Ω) ∈ q.toIdeal :=
          HomogeneousIdeal.mem_iff.mpr (hle hXj)
        rw [hq, Ideal.mem_comap, hψ, MvPolynomial.rename_X] at h1
        exact hi h1
      let z : (wcProjK Ω e : Scheme.{u}) :=
        (⟨q, hqp, hqrel⟩ : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω))
      refine ⟨z, ?_⟩
      apply ProjectiveSpectrum.ext
      apply HomogeneousIdeal.ext
      ext a
      have e1 : a ∈ (L z).asHomogeneousIdeal ↔ φ a ∈ z.asHomogeneousIdeal := by
        have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) a ↔
            z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) (φ a) := by
          rw [← hpre a]
          exact (Scheme.Hom.mem_preimage L).symm
        rw [Proj.mem_basicOpen, Proj.mem_basicOpen] at h1
        exact not_iff_not.mp h1
      rw [HomogeneousIdeal.mem_iff, e1]
      show φ a ∈ q ↔ _
      rw [← HomogeneousIdeal.mem_iff, hq, Ideal.mem_comap]
      have hd := hK (hret a)
      constructor
      · intro h
        have h4 := Ideal.add_mem _ hd h
        rwa [sub_add_cancel] at h4
      · intro h
        have h4 := Ideal.sub_mem _ h hd
        rwa [sub_sub_cancel] at h4

  have hHp : MvPolynomial.aeval g Hp = 0 := by
    rw [hHpdef]
    show MvPolynomial.aeval g (∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
      MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) *
        (MvPolynomial.X p * MvPolynomial.X q)) = 0
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro p _
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro q _
    rw [map_mul, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
    by_cases hpq : p.val % 2 = 0 ∧ q.val = p.val + 1
    · have h0 : g q = 0 := (hX0 q).mpr (by omega)
      rw [h0, mul_zero, mul_zero]
    · rw [if_neg hpq, map_zero, zero_mul]
  have hsub : Set.range L ⊆ Set.range jY := by
    rintro _ ⟨z, rfl⟩
    rw [hY]
    show L z ∉ _
    intro h
    have h2 := (Scheme.Hom.mem_preimage L).mpr h
    rw [hpre, hφ, hHp, Proj.basicOpen_zero] at h2
    exact TopologicalSpace.Opens.mem_bot.mp h2

  haveI hsm : SmoothOfRelativeDimension e (wcProjKStr Ω e) := wc_proj_space_smooth Ω e
  haveI : ∀ x : wcProjK Ω e, _root_.IsReduced ((wcProjK Ω e).presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain Ω (wcProjK Ω e) (wcProjKStr Ω e) e x
    infer_instance
  haveI : IsReduced (wcProjK Ω e) := isReduced_of_isReduced_stalk _

  obtain ⟨i, hi⟩ := wc_ap_reduced_factor_closed_immersion _ _ _ L jY hsub
  have hici : IsClosedImmersion i := by
    haveI : IsClosedImmersion (i ≫ jY) := by rw [hi]; exact hLci
    exact IsClosedImmersion.of_comp i jY
  refine ⟨wcProjK Ω e, i, hici, ?_, ?_⟩
  · rw [← hjYfY, ← Category.assoc, hi, hLstr]
    exact hsm
  · ext x
    have hinj : Function.Injective jY := jY.isClosedEmbedding.isEmbedding.injective
    have e1 : x ∈ Set.range i ↔ jY x ∈ Set.range L := by
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨y, by rw [← hi, Scheme.Hom.comp_apply]⟩
      · rintro ⟨y, hy⟩
        refine ⟨y, hinj ?_⟩
        rw [← Scheme.Hom.comp_apply, hi, hy]
    rw [e1, hrange, Set.mem_compl_iff, SetLike.mem_coe]
    constructor
    · intro H hmem
      obtain ⟨k, hmem⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
      obtain ⟨hk, hmem⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
      have h1 := (Proj.mem_basicOpen _ _ _).mp ((Scheme.Hom.mem_preimage jY).mp hmem)
      exact h1 (H _ ((hT _).mpr ⟨k, hk, rfl⟩))
    · intro H t ht
      obtain ⟨k, hk, rfl⟩ := (hT t).mp ht
      by_contra hn
      apply H
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨k, TopologicalSpace.Opens.mem_iSup.mpr ⟨hk, ?_⟩⟩
      exact (Scheme.Hom.mem_preimage jY).mpr ((Proj.mem_basicOpen _ _ _).mpr hn)

theorem wc_et_hyperbolic_quadric_odd_vanish : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : Ω) ≠ 0 → ∀ (d : ℕ), Even d → 2 ≤ d → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [IsProper fY] [SmoothOfRelativeDimension d fY] (jY : Y ⟶ wcProjK Ω (d + 1)), IsClosedImmersion jY → jY ≫ wcProjKStr Ω (d + 1) = fY → (∀ (x : Y) (c : Fin (d + 1 + 1)) (hx : x ∈ jY ⁻¹ᵁ wcSgD Ω (d + 1) c), wcLdpGerm Ω (d + 1) jY (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)) c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) → Subsingleton (wcEtCoh Y ℓ (d + 1)) :=
by
  classical
  intro Ω _ _ ℓ _ hℓ d hd hd2 Y fY _ _ jY hjY hjYfY hEG
  have hℓp : ℓ.Prime := Fact.out
  obtain ⟨t, ht⟩ := hd

  by_cases hYe : IsEmpty Y
  · have hdim : topologicalKrullDim Y ≤ ((0 : ℕ) : WithBot ℕ∞) := by
      have h0 : topologicalKrullDim Y = ⊥ := by
        unfold topologicalKrullDim
        rw [Order.krullDim_eq_bot_iff]
        constructor
        intro s
        obtain ⟨x, -⟩ := s.isIrreducible.nonempty
        exact hYe.false x
      rw [h0]; exact bot_le
    exact wc_et_zero_dim_vanishing Ω Y fY hdim ℓ hℓp.ne_zero (d + 1) (Nat.succ_pos d)
  rw [not_isEmpty_iff] at hYe

  haveI hstalkred : ∀ x : Y, _root_.IsReduced (Y.presheaf.stalk x) := by
    intro x
    haveI := wcpa_smooth_stalk_isDomain Ω Y fY d x
    infer_instance
  haveI hYred : AlgebraicGeometry.IsReduced Y := isReduced_of_isReduced_stalk Y

  have hdet : (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
      (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose).det ≠ 0 := by
    let f : Fin (d + 1 + 1) → Fin (d + 1 + 1) := fun p =>
      ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, by split_ifs <;> omega⟩
    have hf : Function.Involutive f := by
      intro p
      apply Fin.ext
      simp only [f]
      split_ifs <;> omega
    have hS : Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) +
        (Matrix.of (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).transpose =
        Equiv.Perm.permMatrix Ω (Function.Involutive.toPerm f hf) := by
      ext p q
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.transpose_apply, Equiv.Perm.permMatrix,
        PEquiv.toMatrix_apply, Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq,
        Function.Involutive.coe_toPerm, f, Fin.ext_iff]
      split_ifs <;> first | omega | norm_num
    rw [hS, Matrix.det_permutation]
    rcases Int.units_eq_one_or (Equiv.Perm.sign (Function.Involutive.toPerm f hf)) with h | h <;>
      simp [h]

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hcover : ∀ q : wcProjK Ω (d + 1), ∃ c : Fin (d + 1 + 1), q ∈ wcSgD Ω (d + 1) c := by
    intro q
    by_contra hno
    push_neg at hno
    have hall : ∀ i : Fin (d + 1 + 1), MvPolynomial.X i ∈ q.asHomogeneousIdeal.toIdeal := by
      intro i
      have h8 := hno i
      rw [Proj.mem_basicOpen, not_not] at h8
      exact h8
    apply ProjectiveSpectrum.not_irrelevant_le q
    intro x hx
    have hx0 : x.coeff 0 = 0 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hx
      have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) x 0 :
          MvPolynomial (Fin (d + 1 + 1)) Ω)) = MvPolynomial.homogeneousComponent 0 x :=
        MvPolynomial.decomposition.decompose'_apply x 0
      rw [h6, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hx
      exact hx
    have hspan : x ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1 + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      rw [MvPolynomial.mem_support_iff] at hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact hm hx0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1 + 1)))) ≤
        q.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le, Set.image_subset_iff]
      intro i _
      exact hall i
    exact hle hspan
  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 2) (hg' : g ∈ 𝒜 (2 • 1)),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg hg'
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg' := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg (by norm_num : 0 < 2)
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd' : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')).symm
    rw [hd', ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have hkey : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 2) (c : Fin (d + 1 + 1)),
      (wcProjK Ω (d + 1)).basicOpen (wcLdpSec Ω (d + 1) G c) = wcSgD Ω (d + 1) c ⊓
        @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          MvPolynomial.gradedAlgebra (G : MvPolynomial (Fin (d + 1 + 1)) Ω) := by
    intro G c
    exact (L1 _ (MvPolynomial.X c) (G : MvPolynomial (Fin (d + 1 + 1)) Ω) (hX c) G.2 G.2).symm
  have hgerm : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 2)
      (c : Fin (d + 1 + 1)) (q : wcProjK Ω (d + 1)) (hq : q ∈ wcSgD Ω (d + 1) c),
      ((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) q hq).hom
          (wcLdpSec Ω (d + 1) G c) ∈
        IsLocalRing.maximalIdeal ((wcProjK Ω (d + 1)).presheaf.stalk q) ↔
        q ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          MvPolynomial.gradedAlgebra (G : MvPolynomial (Fin (d + 1 + 1)) Ω) := by
    intro G c q hq
    have e1 := Scheme.mem_basicOpen (wcProjK Ω (d + 1)) (wcLdpSec Ω (d + 1) G c) q hq
    rw [hkey G c, TopologicalSpace.Opens.mem_inf] at e1
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro h h'
      exact h (e1.mp ⟨hq, h'⟩)
    · intro h h'
      exact h (e1.mpr h').2
  have hpull : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 2)
      (x : Y) (c : Fin (d + 1 + 1)) (hx : x ∈ jY ⁻¹ᵁ wcSgD Ω (d + 1) c),
      wcLdpGerm Ω (d + 1) jY G c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) →
      ((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) (jY x) hx).hom
          (wcLdpSec Ω (d + 1) G c) ∈
        IsLocalRing.maximalIdeal ((wcProjK Ω (d + 1)).presheaf.stalk (jY x)) := by
    intro G x c hx h
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h ⊢
    intro hu
    apply h
    have e := Scheme.Hom.germ_stalkMap_apply jY (wcSgD Ω (d + 1) c) x hx (wcLdpSec Ω (d + 1) G c)
    have hu' : IsUnit ((jY.stalkMap x).hom
        (((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) (jY x) hx).hom
          (wcLdpSec Ω (d + 1) G c))) := (isUnit_map_iff (jY.stalkMap x).hom _).mpr hu
    have e' : (jY.stalkMap x).hom
        (((wcProjK Ω (d + 1)).presheaf.germ (wcSgD Ω (d + 1) c) (jY x) hx).hom
          (wcLdpSec Ω (d + 1) G c)) = wcLdpGerm Ω (d + 1) jY G c x hx := e
    rw [e'] at hu'
    exact hu'

  have hY : Set.range jY = {p | p ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) : MvPolynomial (Fin (d + 1 + 1)) Ω)} := by
    ext p
    constructor
    · rintro ⟨x, rfl⟩
      obtain ⟨c, hc⟩ := hcover (jY x)
      exact (hgerm _ c (jY x) hc).mp (hpull _ x c hc (hEG x c hc))
    · intro hp
      haveI : IsProper (Over.mk fY).hom := ‹IsProper fY›
      haveI : SmoothOfRelativeDimension d (Over.mk fY).hom := ‹SmoothOfRelativeDimension d fY›
      haveI : Nonempty (Over.mk fY).left := hYe
      exact wc_quadric_section_full Ω d (by omega) (Over.mk fY) jY hjY hjYfY _ hdet
        (fun x c hx => hEG x c hx) p (fun c hc => (hgerm _ c p hc).mpr hp)

  let W : ℕ → Y.Opens := fun k => jY ⁻¹ᵁ wcSgD Ω (d + 1)
    ⟨if k ≤ d / 2 then 2 * k + 1 else d, by split_ifs <;> omega⟩
  have hW1 : ∀ k, k ≤ d / 2 + 1 → ∀ q, 1 ≤ q →
      Subsingleton (wcEtCoh (W k : Scheme.{u}) ℓ q) := by
    intro k hk q hq
    obtain ⟨e⟩ := wc_hq_chart_affine_iso Ω d ⟨t, ht⟩ hd2 Y jY hjY hY k hk
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e.inv ℓ q
    haveI := wc_et_affine_space_coh_vanishing Ω ℓ hℓp hℓ d q hq
    exact E.subsingleton
  have hW2 : ∀ k, 1 ≤ k → k ≤ d / 2 + 1 → ∀ q, d ≤ q →
      Subsingleton (wcEtCoh ((W k ⊓ ⨆ (i : ℕ) (_ : i < k), W i : Y.Opens) : Scheme.{u}) ℓ q) := by
    intro k hk1 hk q hq
    obtain ⟨E, hE, ⟨e⟩⟩ := wc_hq_chart_overlap_iso Ω d ⟨t, ht⟩ hd2 Y jY hjY hY k hk1 hk
    obtain ⟨Eq⟩ := wc_et_coh_iso_invariance e.inv ℓ q
    haveI := wc_et_affine_partial_punct_vanishing Ω ℓ hℓp hℓ d (min k (d / 2)) (by omega) E hE q
      (by omega)
    exact Eq.subsingleton

  have hMV : ∀ n, n ≤ d / 2 + 1 → ∀ q, d + 1 ≤ q →
      Subsingleton (wcEtCoh ((⨆ (k : ℕ) (_ : k ≤ n), W k : Y.Opens) : Scheme.{u}) ℓ q) := by
    intro n
    induction n with
    | zero =>
      intro _ q hq
      have h0 : (⨆ (k : ℕ) (_ : k ≤ 0), W k) = W 0 := by
        apply le_antisymm
        · exact iSup₂_le (fun k hk => by rw [Nat.le_zero.mp hk])
        · exact le_iSup₂_of_le 0 le_rfl le_rfl
      rw [h0]
      exact hW1 0 (by omega) q (by omega)
    | succ n ih =>
      intro hn q hq
      obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
      have hsup : (⨆ (k : ℕ) (_ : k ≤ n), W k) ⊔ W (n + 1) = ⨆ (k : ℕ) (_ : k ≤ n + 1), W k := by
        apply le_antisymm
        · apply sup_le
          · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
          · exact le_iSup₂_of_le (n + 1) le_rfl le_rfl
        · apply iSup₂_le
          intro k hk
          rcases Nat.lt_or_ge k (n + 1) with h | h
          · exact le_sup_of_le_left (le_iSup₂_of_le k (by omega) le_rfl)
          · have hk' : k = n + 1 := by omega
            subst hk'; exact le_sup_right
      have hinf : (⨆ (k : ℕ) (_ : k ≤ n), W k) ⊓ W (n + 1) =
          W (n + 1) ⊓ ⨆ (i : ℕ) (_ : i < n + 1), W i := by
        rw [inf_comm]
        congr 1
        apply le_antisymm
        · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
        · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
      haveI h1 : Subsingleton (wcEtCoh (((⨆ (k : ℕ) (_ : k ≤ n), W k) ⊓ W (n + 1) : Y.Opens) :
          Scheme.{u}) ℓ q') := by
        rw [hinf]
        exact hW2 (n + 1) (by omega) hn q' (by omega)
      haveI h2 := ih (by omega) (q' + 1) hq
      haveI h3 := hW1 (n + 1) hn (q' + 1) (by omega)
      obtain ⟨hfin, hcard⟩ := wc_et_zariski_mv_card_le Y _ _ _ hsup ℓ q'
        Finite.of_subsingleton Finite.of_subsingleton Finite.of_subsingleton
      haveI := hfin
      have c1 := Finite.card_le_one_iff_subsingleton.mpr h1
      have c2 := Finite.card_le_one_iff_subsingleton.mpr h2
      have c3 := Finite.card_le_one_iff_subsingleton.mpr h3
      have hle : Nat.card (wcEtCoh ((⨆ (k : ℕ) (_ : k ≤ n + 1), W k : Y.Opens) : Scheme.{u}) ℓ
          (q' + 1)) ≤ 1 :=
        calc _ ≤ _ := hcard
          _ ≤ 1 * (1 * 1) := Nat.mul_le_mul c1 (Nat.mul_le_mul c2 c3)
          _ = 1 := rfl
      exact Finite.card_le_one_iff_subsingleton.mp hle

  obtain ⟨Z, i, hi, hism, hirange⟩ := wc_hq_removed_plane Ω d ⟨t, ht⟩ hd2 Y fY jY hjY hjYfY hY
  haveI := hi
  haveI := hism
  have hO : ((⨆ (k : ℕ) (_ : k ≤ d / 2 + 1), W k : Y.Opens) : Set Y) = (Set.range i)ᶜ := by
    rw [hirange, compl_compl]

  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i ℓ
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists (⨆ (k : ℕ) (_ : k ≤ d / 2 + 1), W k : Y.Opens).ι ℓ
  have hles := wc_et_supp_open_les i _ hO ℓ D Dj
  obtain ⟨eY⟩ := wc_et_zmodext_coh_equiv Y ℓ (d + 1)
  obtain ⟨eO⟩ := wc_et_zmodext_coh_equiv
    ((⨆ (k : ℕ) (_ : k ≤ d / 2 + 1), W k : Y.Opens) : Scheme.{u}) ℓ (d + 1)
  haveI := hMV (d / 2 + 1) le_rfl (d + 1) le_rfl
  haveI hOs : Subsingleton (wcEtZModExt
    ((⨆ (k : ℕ) (_ : k ≤ d / 2 + 1), W k : Y.Opens) : Scheme.{u}) ℓ (d + 1)) := eO.subsingleton
  haveI : Subsingleton (wcEtZModExt Y ℓ (d + 1)) := by
    constructor
    intro y₁ y₂
    obtain ⟨x₁, hx₁⟩ := (hles.1 (d + 1) y₁).mp (Subsingleton.elim _ _)
    obtain ⟨x₂, hx₂⟩ := (hles.1 (d + 1) y₂).mp (Subsingleton.elim _ _)
    have h12 : x₁ = x₂ :=
      (wc_et_supp_semipurity Ω Y Z fY d (d / 2 + 1) i (by omega) ℓ hℓ D (d + 1) (by omega) x₁).trans
        (wc_et_supp_semipurity Ω Y Z fY d (d / 2 + 1) i (by omega) ℓ hℓ D (d + 1) (by omega) x₂).symm
    subst h12
    exact hx₁.symm.trans hx₂
  exact eY.symm.subsingleton

theorem wc_et_zmod_trace_perfect_irred_primepow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (e : ℕ), 1 ≤ e → ∃ tr : wcEtZModExt Y (ℓ ^ e) (2 * N) →+ AddCircle (1 : ℚ), (∀ (p q : ℕ) (h : p + q = 2 * N) (α : wcEtZModExt Y (ℓ ^ e) p), (∀ w : wcEtZModExt Y (ℓ ^ e) q, tr (wcEtZModCup Y (ℓ ^ e) p q (2 * N) h α w) = 0) → α = 0) ∧ (∀ (p q : ℕ) (h : p + q = 2 * N) (φ : wcEtZModExt Y (ℓ ^ e) q →+ AddCircle (1 : ℚ)), ∃ α : wcEtZModExt Y (ℓ ^ e) p, ∀ w : wcEtZModExt Y (ℓ ^ e) q, tr (wcEtZModCup Y (ℓ ^ e) p q (2 * N) h α w) = φ w) :=
