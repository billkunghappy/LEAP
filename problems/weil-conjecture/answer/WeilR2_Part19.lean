    intro C _ ψ c
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = ψ := ⟨_, Spec.map_preimage ψ⟩
    rw [Spec.preimage_map]
    rfl

  obtain ⟨hO, hU⟩ := wc_qmbt_hl_b0_origin_fibre hπ hx₀ hsh
  haveI := wc_qmbt_hl_xs_noeth hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf hps'

  intro C _ _ _ cC hcC hz j hzj
  haveI : WeaklyEtale cC := hcC
  generalize hG : bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ = G at hB0 hB1 ⊢
  generalize hβ : ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA)) = β at hYset
  have hgpt : ∀ p : Xs', G (ι' p) = a₀ (β p) := by
    intro p
    rw [← hG, ← hβ]
    simp only [Scheme.Hom.comp_apply]
  obtain ⟨y, hy⟩ := hz
  have hw : iY y ∈ Set.range iY := ⟨y, rfl⟩
  rw [hYset] at hw
  obtain ⟨hwcl, hwZ⟩ := hw
  have hwZ' : β (iY y) = IsLocalRing.closedPoint B₀ := hwZ
  have hιw : ι' (iY y) = cC (IsLocalRing.closedPoint C) := by
    rw [← hy, Scheme.Hom.comp_apply]

  have hnotz : cC (IsLocalRing.closedPoint C) ∉ Xm.basicOpen (G.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))) := by
    rw [s3, ← hιw, hgpt, hwZ']
    exact not_not.mpr (hO j)
  have hi : (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom (G.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))) ∈
      IsLocalRing.maximalIdeal C := by
    have h1 := (s2 C cC _ (IsLocalRing.closedPoint C)).not.mp hnotz
    exact not_not.mp h1

  obtain ⟨b, hb⟩ := hB1 j
  obtain ⟨b', hb'⟩ := s5 C cC (V j) hzj _ _ b hb
  rw [s6 C cC π'] at hb'

  have hSopen : IsOpen ((fun x : Xs' => β x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ :=
    ((IsLocalRing.isClosed_singleton_closedPoint B₀).preimage β.continuous).isOpen_compl
  obtain ⟨w', hw'S, hw'sp⟩ := s1 Xs' _ hSopen (iY y) hwcl
  have hsp : ι' w' ⤳ cC (IsLocalRing.closedPoint C) := hιw ▸ hw'sp.map ι'.continuous
  obtain ⟨c', -, hc'⟩ := Flat.generalizingMap cC hsp
  have hfw : f (ι' w') = IsLocalRing.closedPoint A' := by
    rw [← Scheme.Hom.comp_apply, hps'.toCommSq.w, Scheme.Hom.comp_apply]
    exact IsLocalRing.PrimeSpectrum.comap_residue A' (s' w')
  have hπc' : (Spec.preimage (cC ≫ f)).hom π' ∈ c'.asIdeal := by
    have e := pt C (cC ≫ f) c'
    rw [Scheme.Hom.comp_apply, hc', hfw] at e
    have hm : π' ∈ (IsLocalRing.closedPoint A').asIdeal := by
      show π' ∈ IsLocalRing.maximalIdeal A'
      rw [hπ']; exact Ideal.mem_span_singleton_self π'
    rw [e] at hm
    exact hm
  have hxc' : (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom (G.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))) ∉ c'.asIdeal := by
    intro hx
    have h1 : ι' w' ∉ Xm.basicOpen (G.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))) := by
      rw [← hc']; exact fun h => (s2 C cC _ c').mp h hx
    have hw'V : ι' w' ∈ V j := hsp.mem_open (V j).isOpen hzj
    have h2 : ∀ i, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X i) ∈
        PrimeSpectrum.asIdeal (a₀ (β w')) := by
