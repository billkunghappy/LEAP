        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Y : Scheme.{u}} (iY : Y ⟶ Xs') [IsClosedImmersion iY]
    (hYset : Set.range iY =
      closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})
    (Dk : wcHMPullData (iY ≫ ι') ℓ) (hDk : wcHMPullCanonical Dk) :
    haveI := Dp'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    Nonempty (Dk.Φ.obj
      (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology 1) ≅
        SheafOfModules.unit (wcRingSheaf Y ℓ)) :=
by
  intro P'
  haveI := Dp'.additive
  haveI hQm : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip hQm
  haveI : IsAffineHom p' :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb'.flip inferInstance

  have hℓY : IsUnit ((ℓ : ℕ) : Γ(Xm, ⊤)) := by
    have := (hℓ'.map (Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom).map f.appTop.hom
    simpa only [map_natCast] using this
  have hℓL : ((ℓ : ℕ) : L') ≠ 0 := by
    have := (hℓ'.map φ').ne_zero
    simpa only [map_natCast] using this

  have hπ'0 : π' ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field' (R := A')
    rw [hπ', h0, Ideal.span_singleton_eq_bot.mpr rfl]
  have hϖ : IsUnit (p'.appTop.hom (f.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))) := by
    have e1 := congrArg (fun h : XE' ⟶ Spec (.of A') =>
      h.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π')) hpb'.w
    have e2 := congrArg (fun h => h.hom π')
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ'))
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e1 e2
    rw [e1, ← e2]
    have hu : IsUnit (φ' π') := Ne.isUnit (fun h => hπ'0 (hφ' (h.trans (map_zero φ').symm)))
    exact (hu.map _).map _
  obtain ⟨V, hB0, hB1, hB2, hB3⟩ := wc_qmbt_yrc_E_cover hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen
    hbl hblf hps' iY hYset
  have hcnt := wc_qmbt_yrc_tube_counts hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hφ' halg'
    hbl hblf hcov hpb' hps' iY hYset
  have hnot := wc_qmbt_yrc_not_lth_power hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hφ' halg'
    hbl hblf hcov hpb' hps' iY hYset V hB0 hB1
  obtain ⟨V', hV', m, hm⟩ := wc_qmbt_yrc_kummer_sections_line p' (iY ≫ ι') ℓ L' hℓL q' hℓY
    Dp' hDp' I' V
    (fun j => (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))
    (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
    hϖ hB1 hB2 hB3 hcnt hnot
  exact wc_qmbt_yrc_open_transport (iY ≫ ι') ℓ Dk hDk _ V' hV' m hm

theorem wc_qmbt_hl_R1_supp {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Y : Scheme.{u}} (iY : Y ⟶ Xs') [IsClosedImmersion iY]
    (hYset : Set.range iY =
      closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY) :
    haveI := Dp'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    Nonempty (Di'.Φ.obj
      (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology 1) ≅
        wcSuppObj EY) :=
by
  intro P'
  haveI := Dp'.additive

  haveI : IsLocallyNoetherian Xs' :=
    wc_qmbt_hl_xs_noeth hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf hps'

  let O : Xs'.Opens :=
    ⟨(Set.range iY)ᶜ, (IsClosedImmersion.isClosedEmbedding iY).isClosed_range.isOpen_compl⟩
  have hO' : (O : Set Xs') = (Set.range iY)ᶜ := rfl
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists O.ι ℓ

  have hK0 := wc_qmbt_hl_off_Y_vanish hℓ' hπ' hcov hφ' halg' hpb' hps' Dp' hDp' Di' hDi' I' O
    (fun w hw => wc_qmbt_hl_adapted_charts hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf
      hps' iY hYset w hw) Dj hDj 1 le_rfl

  obtain ⟨M, ⟨σ⟩⟩ :=
    wc_proet_closed_push_essImage_of_open_pull_isZero iY ℓ O hO' EY hEY Dj hDj _ hK0

  obtain ⟨hF, hFa⟩ := wc_proet_closed_push_modules_full_faithful iY ℓ EY hEY
  haveI := hF
  haveI := hFa
  haveI : IsIso EY.adj.counit := Adjunction.counit_isIso_of_R_fully_faithful EY.adj
  let ε := asIso (EY.adj.counit.app M)

  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (iY ≫ ι') ℓ
  obtain ⟨c⟩ := wc_hm_pull_data_comp_Phi_iso ι' iY (iY ≫ ι') rfl Di' hDi' EY hEY Dk hDk
  obtain ⟨τ⟩ := wc_qmbt_hl_Y_restr_const hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hφ' halg'
    hbl hblf hcov hpb' hps' Dp' hDp' Di' hDi' I' iY hYset Dk hDk
  exact ⟨σ.symm ≪≫
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iY) _ _ EY.cont EY.φ).mapIso
      (ε.symm ≪≫ EY.Φ.mapIso σ ≪≫ (c.app _).symm ≪≫ τ)⟩

theorem wc_qmbt_hlsc_fibre_transfer {W X Y S : Scheme.{u}} {p : W ⟶ X} {q : W ⟶ Y} {f : X ⟶ S}
    {g : Y ⟶ S} (h : IsPullback p q f g) (s : S)
    (hs : IsIso (Limits.pullback.snd g (S.fromSpecResidueField s)))
    (hX : IsPreirreducible (f ⁻¹' {s})) :
    IsPreirreducible ((fun w : W => g (q w)) ⁻¹' {s}) :=
by
  classical

  have hU : IsPreirreducible
      (Set.univ : Set ↥(Limits.pullback f (S.fromSpecResidueField s) : Scheme.{u})) := by
    haveI : PreirreducibleSpace ↥(f ⁻¹' {s}) := isPreirreducible_iff_preirreducibleSpace.mp hX
    have h1 := (PreirreducibleSpace.isPreirreducible_univ (X := ↥(f ⁻¹' {s}))).image
      (Scheme.Hom.fiberHomeo f s).symm (Scheme.Hom.fiberHomeo f s).symm.continuous.continuousOn
    rw [Set.image_univ_of_surjective (Scheme.Hom.fiberHomeo f s).symm.surjective] at h1
    exact h1
  have E1 : (Limits.pullback.snd f (S.fromSpecResidueField s) ≫
      inv (Limits.pullback.snd g (S.fromSpecResidueField s)) ≫
      Limits.pullback.fst g (S.fromSpecResidueField s)) ≫ g =
      Limits.pullback.snd f (S.fromSpecResidueField s) ≫ S.fromSpecResidueField s := by
    rw [Category.assoc, Category.assoc, Limits.pullback.condition, IsIso.inv_hom_id_assoc]
  have hcompat : Limits.pullback.fst f (S.fromSpecResidueField s) ≫ f =
      (Limits.pullback.snd f (S.fromSpecResidueField s) ≫
      inv (Limits.pullback.snd g (S.fromSpecResidueField s)) ≫
      Limits.pullback.fst g (S.fromSpecResidueField s)) ≫ g := by
    rw [E1, Limits.pullback.condition]
  obtain ⟨l, hlp, hlq⟩ : ∃ l : Limits.pullback f (S.fromSpecResidueField s) ⟶ W,
      l ≫ p = Limits.pullback.fst f (S.fromSpecResidueField s) ∧
      l ≫ q = Limits.pullback.snd f (S.fromSpecResidueField s) ≫
        inv (Limits.pullback.snd g (S.fromSpecResidueField s)) ≫
        Limits.pullback.fst g (S.fromSpecResidueField s) :=
    ⟨h.lift _ _ hcompat, h.lift_fst _ _ _, h.lift_snd _ _ _⟩
  have hΦc : (Limits.pullback.fst (q ≫ g) (S.fromSpecResidueField s) ≫ p) ≫ f =
      Limits.pullback.snd (q ≫ g) (S.fromSpecResidueField s) ≫ S.fromSpecResidueField s := by
    rw [Category.assoc, h.w, Limits.pullback.condition]
  obtain ⟨Φ, hΦ1, hΦ2⟩ : ∃ Φ : Limits.pullback (q ≫ g) (S.fromSpecResidueField s) ⟶
      Limits.pullback f (S.fromSpecResidueField s),
      Φ ≫ Limits.pullback.fst f (S.fromSpecResidueField s) =
        Limits.pullback.fst (q ≫ g) (S.fromSpecResidueField s) ≫ p ∧
      Φ ≫ Limits.pullback.snd f (S.fromSpecResidueField s) =
        Limits.pullback.snd (q ≫ g) (S.fromSpecResidueField s) :=
    ⟨Limits.pullback.lift _ _ hΦc, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hac : (Limits.pullback.fst (q ≫ g) (S.fromSpecResidueField s) ≫ q) ≫ g =
      Limits.pullback.snd (q ≫ g) (S.fromSpecResidueField s) ≫ S.fromSpecResidueField s := by
    rw [Category.assoc, Limits.pullback.condition]
  obtain ⟨a, ha1, ha2⟩ : ∃ a : Limits.pullback (q ≫ g) (S.fromSpecResidueField s) ⟶
      Limits.pullback g (S.fromSpecResidueField s),
      a ≫ Limits.pullback.fst g (S.fromSpecResidueField s) =
        Limits.pullback.fst (q ≫ g) (S.fromSpecResidueField s) ≫ q ∧
      a ≫ Limits.pullback.snd g (S.fromSpecResidueField s) =
        Limits.pullback.snd (q ≫ g) (S.fromSpecResidueField s) :=
    ⟨Limits.pullback.lift _ _ hac, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have ha : a = Limits.pullback.snd (q ≫ g) (S.fromSpecResidueField s) ≫
      inv (Limits.pullback.snd g (S.fromSpecResidueField s)) := by
    rw [IsIso.eq_comp_inv]; exact ha2
  have E2 : Φ ≫ l = Limits.pullback.fst (q ≫ g) (S.fromSpecResidueField s) := by
    apply h.hom_ext
    · rw [Category.assoc, hlp, hΦ1]
    · rw [Category.assoc, hlq, ← Category.assoc Φ, hΦ2, ← Category.assoc, ← ha, ha1]
  have hrange : Set.range l = (fun w : W => g (q w)) ⁻¹' {s} := by
    apply Set.Subset.antisymm
    · rintro _ ⟨z, rfl⟩
      show g (q (l z)) = s
      have e : g (q (l z)) = (l ≫ q ≫ g) z := by
        simp only [Scheme.Hom.comp_apply]
      rw [e, ← Category.assoc, hlq, E1, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    · intro w hw
      have hw' : w ∈ Set.range (Limits.pullback.fst (q ≫ g) (S.fromSpecResidueField s)) := by
        rw [Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
        show (q ≫ g) w = s
        rw [Scheme.Hom.comp_apply]
        exact hw
      obtain ⟨z, rfl⟩ := hw'
      exact ⟨Φ z, by rw [← Scheme.Hom.comp_apply, E2]⟩
  rw [← hrange, ← Set.image_univ]
  exact hU.image l l.continuous.continuousOn

theorem wc_qmbt_hlsc_x0_fibre {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀) :
    a₀ (IsLocalRing.closedPoint B₀) = x₀ ∧
      (∀ b : Spec (.of B₀), a₀ b = x₀ → b = IsLocalRing.closedPoint B₀) ∧
      IsIso (Limits.pullback.snd a₀
        ((Spec (.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀)) :=
by
  classical

  have hmax : (Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))).IsMaximal :=
    wc_qmbt_bm_origin_maximal hπ n c
  have hle : Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤
      PrimeSpectrum.asIdeal x₀ := by
    rw [Ideal.span_le]
    rintro _ ⟨p, rfl⟩
    exact hx₀ p
  have hx₀eq : Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      PrimeSpectrum.asIdeal x₀ :=
    hmax.eq_of_le (PrimeSpectrum.isPrime x₀).ne_top hle
  haveI hx₀max : (PrimeSpectrum.asIdeal x₀).IsMaximal := hx₀eq ▸ hmax

  have hπm : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]
    exact Ideal.mem_span_singleton_self π
  let ev₀ : MvPolynomial (Fin n) A →+* IsLocalRing.ResidueField A :=
    (IsLocalRing.residue A).comp MvPolynomial.constantCoeff
  have hgen : ev₀ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C π) = 0 := by
    simp [ev₀, hπm]
  have hev₀ : ∀ a ∈ wcQuadModelIdeal A n π c, ev₀ a = 0 := by
    intro a ha
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hgen, mul_zero]
  let ev₁ : wcQuadModelRing A n π c →+* IsLocalRing.ResidueField A :=
    Ideal.Quotient.lift (wcQuadModelIdeal A n π c) ev₀ hev₀
  have hev₁ : ∀ a ∈ Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)), ev₁ a = 0 := by
    intro a ha
    have hk : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤ RingHom.ker ev₁ := by
      rw [Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      simp [ev₁, ev₀]
    exact hk ha
  let ev₂ := Ideal.Quotient.lift (Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ev₁ hev₁
  have hsurj : Function.Surjective ev₂ := by
    intro t
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective t
    refine ⟨Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.C a)), ?_⟩
    simp [ev₂, ev₁, ev₀]
  letI : Field (wcQuadModelRing A n π c ⧸ Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) :=
    Ideal.Quotient.field _
  have hinj : Function.Injective ev₂ := RingHom.injective ev₂
  let e₃ := RingEquiv.ofBijective ev₂ ⟨hinj, hsurj⟩

  let e₁ : (Spec (.of (wcQuadModelRing A n π c))).residueField x₀ ≃+*
      wcQuadModelRing A n π c ⧸ PrimeSpectrum.asIdeal x₀ :=
    (IsLocalRing.ResidueField.mapEquiv
      (Spec.stalkIso (.of (wcQuadModelRing A n π c)) x₀).commRingCatIsoToRingEquiv).trans
      (RingEquiv.ofBijective _
        (Ideal.bijective_algebraMap_quotient_residueField (PrimeSpectrum.asIdeal x₀))).symm
  let e₂ : wcQuadModelRing A n π c ⧸ PrimeSpectrum.asIdeal x₀ ≃+*
      wcQuadModelRing A n π c ⧸ Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) :=
    Ideal.quotEquivOfEq hx₀eq.symm
  haveI hκ : IsSepClosed ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀) :=
    wc_henselian_sepClosed_transfer.2 (IsLocalRing.ResidueField A) _
      (e₁.trans (e₂.trans e₃)).symm inferInstance

  obtain ⟨c₀, g, hpb, hbij, hcg⟩ := wc_ppu_closed_fibre_square x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI : IsIso c₀ := hpb.isIso_snd_of_isIso
  haveI : IsIso (CommRingCat.ofHom g) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hiso : IsIso (Limits.pullback.snd a₀
      ((Spec (.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀)) := by
    rw [← hcg]
    infer_instance

  have hsh' := hsh
  unfold wcHalShData at hsh'
  obtain ⟨-, -, -, -, -, eκ, -, heκ⟩ := hsh'
  obtain ⟨s0⟩ : Nonempty (PrimeSpectrum (AlgebraicClosure
      ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀))) := inferInstance
  let s : ↥(Spec (CommRingCat.of (AlgebraicClosure
      ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀)))) := s0
  have hb : a₀ (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))
      (Spec.map (CommRingCat.ofHom eκ) s)) = x₀ := by
    have h1 := congrArg (fun f => f s) heκ
    simp only [Scheme.Hom.comp_apply, wcEtGeomPt] at h1
    exact h1.trans (Scheme.fromSpecResidueField_apply x₀ _)
  have ht : ∀ t0 : PrimeSpectrum (IsLocalRing.ResidueField B₀),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))
        (t0 : ↥(Spec (CommRingCat.of (IsLocalRing.ResidueField B₀)))) =
        IsLocalRing.closedPoint B₀ := by
    intro t0
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue B₀) (PrimeSpectrum.asIdeal t0) =
      IsLocalRing.maximalIdeal B₀
    have hbot : PrimeSpectrum.asIdeal t0 = ⊥ :=
      (Ideal.eq_bot_or_top _).resolve_right (PrimeSpectrum.isPrime t0).ne_top
    rw [hbot, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
  have hcp : a₀ (IsLocalRing.closedPoint B₀) = x₀ :=
    (congrArg (fun z => a₀ z) (ht _)).symm.trans hb

  obtain ⟨t0⟩ : Nonempty (PrimeSpectrum
      ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀)) := inferInstance
  let t : ↥(Spec ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀)) := t0
  have hjt : (Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀ t = x₀ :=
    Scheme.fromSpecResidueField_apply x₀ t
  refine ⟨hcp, fun b hb' => ?_, hiso⟩
  obtain ⟨zb, hzb1, hzb2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a₀)
    (g := (Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀) b t
    (hb'.trans hjt.symm)
  obtain ⟨zc, hzc1, hzc2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a₀)
    (g := (Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀)
    (IsLocalRing.closedPoint B₀) t (hcp.trans hjt.symm)
  have h1 := Scheme.hom_inv_apply (asIso (Limits.pullback.snd a₀
      ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀))) zb
  have h2 := Scheme.hom_inv_apply (asIso (Limits.pullback.snd a₀
      ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀))) zc
  have hz : zb = zc := by
    rw [← h1, ← h2]
    show (asIso (Limits.pullback.snd a₀
        ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀))).inv
        ((Limits.pullback.snd a₀
          ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀)) zb) =
      (asIso (Limits.pullback.snd a₀
        ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀))).inv
        ((Limits.pullback.snd a₀
          ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀)) zc)
    rw [hzb2, hzc2]
  rw [hz] at hzb1
  exact hzb1.symm.trans hzc1

theorem wc_qmbt_hlsc_model_square {A : Type u} [CommRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ'2 : π' ^ 2 = ιA π)
    {Xm : Scheme.{u}}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl) :
    ∃ (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
      (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
      (ψ : Xm ⟶ X₁),
      (∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p)) ∧
      θ.comp (algebraMap A (wcQuadModelRing A n π c)) =
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))).comp ιA ∧
      wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (wcQmbtGen A' n π' (c.map ιA) k)))) r₁ ∧
      IsPullback ψ (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) a₀ :=
by
  classical

  obtain ⟨θ, hθX, hθA, sq₁⟩ := wc_qmbt_bm_quad_pullback ιA n π c π' hπ'2
  obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      gP ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
    ⟨sq₁.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
  have sqL : IsPullback (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) gP a₀ (Spec.map (CommRingCat.ofHom θ)) := by
    refine IsPullback.of_bot ?_ hgP1.symm sq₁
    rw [hgP2]
    exact IsPullback.of_hasPullback _ _
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hgPw : WeaklyEtale gP := MorphismProperty.of_isPullback (P := @WeaklyEtale) sqL ha₀

  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) :=
    inferInstance
  obtain ⟨X₁, r₁, hb₁, -⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k))))

  haveI hgPflat : Flat gP := hgPw.flat
  haveI hPaff : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    dsimp only [wcQuadModelStr]
    infer_instance
  have hbl₀ := wc_qmbt_bm_flat_base_change
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ gP hb₁
  have hblP : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))))))
      (Limits.pullback.snd r₁ gP) := by
    convert hbl₀ using 4
    funext i
    cases i with
    | none =>
      show (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π') =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π'))
      rw [← hgP2, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
      congr 1
      have := congrArg (fun φ => φ.hom π') (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    | some j =>
      show ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))) =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X j)))
      rw [← hgP1, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, ← hθX j]
      congr 1
      have := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X j))) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm

  obtain ⟨φ, hφ⟩ := (hblP.2 Xm bl hbl.1).exists
  obtain ⟨χ, hχ⟩ := (hbl.2 _ (Limits.pullback.snd r₁ gP) hblP.1).exists
  have h1 : φ ≫ χ = 𝟙 Xm := by
    apply (hbl.2 Xm bl hbl.1).unique
    · show (φ ≫ χ) ≫ bl = bl
      rw [Category.assoc, hχ, hφ]
    · show 𝟙 Xm ≫ bl = bl
      exact Category.id_comp _
  have h2 : χ ≫ φ = 𝟙 _ := by
    apply (hblP.2 _ (Limits.pullback.snd r₁ gP) hblP.1).unique
    · show (χ ≫ φ) ≫ Limits.pullback.snd r₁ gP = Limits.pullback.snd r₁ gP
      rw [Category.assoc, hφ, hχ]
    · show 𝟙 _ ≫ Limits.pullback.snd r₁ gP = Limits.pullback.snd r₁ gP
      exact Category.id_comp _
  haveI : IsIso φ := ⟨⟨χ, h1, h2⟩⟩

  have sqT : IsPullback (φ ≫ Limits.pullback.fst r₁ gP) bl r₁ gP :=
    IsPullback.of_iso_pullback
      ⟨by rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hφ]⟩
      (asIso φ) rfl hφ
  exact ⟨θ, X₁, r₁, φ ≫ Limits.pullback.fst r₁ gP, hθX, hθA, hb₁,
    IsPullback.paste_vert sqT sqL.flip⟩

theorem wc_qmbt_hlsc_theta_fibre {A : Type u} [CommRing A] [IsLocalRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {A' : Type u} [CommRing A'] [IsLocalRing A'] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (hπ'2 : π' ^ 2 = ιA π)
    (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
    (hθX : ∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p))
    (hθA : θ.comp (algebraMap A (wcQuadModelRing A n π c)) =
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))).comp ιA) :
    ∃ o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      (∀ k, wcQmbtGen A' n π' (c.map ιA) k ∈ o.asIdeal) ∧
      ∀ q, (Spec.map (CommRingCat.ofHom θ)) q = x₀ ↔ q = o :=
by
  classical

  have hm₀ : (Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))).IsMaximal := by
    set I := wcQuadModelIdeal A n π c with hI
    set Q : MvPolynomial (Fin n) A :=
      ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q with hQ
    have hIdef : I = Ideal.span {Q - MvPolynomial.C π} := rfl
    have hπm : π ∈ IsLocalRing.maximalIdeal A := by
      rw [hπ]; exact Ideal.mem_span_singleton_self π
    have hres : IsLocalRing.residue A π = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff]; exact hπm
    let ε : MvPolynomial (Fin n) A →+* IsLocalRing.ResidueField A :=
      (IsLocalRing.residue A).comp MvPolynomial.constantCoeff
    have hccQ : MvPolynomial.constantCoeff Q = 0 := by
      rw [hQ]; simp
    have hεI : ∀ a ∈ I, ε a = 0 := by
      intro a ha
      rw [hIdef, Ideal.mem_span_singleton'] at ha
      obtain ⟨b, rfl⟩ := ha
      rw [map_mul]
      show ε b * IsLocalRing.residue A (MvPolynomial.constantCoeff (Q - MvPolynomial.C π)) = 0
      rw [map_sub, hccQ, MvPolynomial.constantCoeff_C, zero_sub, map_neg, hres, neg_zero,
        mul_zero]
    let εb : MvPolynomial (Fin n) A ⧸ I →+* IsLocalRing.ResidueField A :=
      Ideal.Quotient.lift I ε hεI
    have hεb : ∀ f, εb (Ideal.Quotient.mk I f) =
        IsLocalRing.residue A (MvPolynomial.constantCoeff f) :=
      fun f => Ideal.Quotient.lift_mk _ _ _
    have hsurj : Function.Surjective εb := by
      intro y
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
      exact ⟨Ideal.Quotient.mk I (MvPolynomial.C a), by rw [hεb, MvPolynomial.constantCoeff_C]⟩
    have hmax : (RingHom.ker εb).IsMaximal := RingHom.ker_isMaximal_of_surjective εb hsurj
    set J := Ideal.span (Set.range fun p : Fin n => Ideal.Quotient.mk I (MvPolynomial.X p))
      with hJ
    have hXJ : ∀ p, Ideal.Quotient.mk I (MvPolynomial.X p) ∈ J :=
      fun p => Ideal.subset_span ⟨p, rfl⟩
    have h1 : J ≤ RingHom.ker εb := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      show εb (Ideal.Quotient.mk I (MvPolynomial.X p)) = 0
      rw [hεb, MvPolynomial.constantCoeff_X, map_zero]
    have hdec : ∀ f : MvPolynomial (Fin n) A,
        Ideal.Quotient.mk I f -
          Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
      intro f
      induction f using MvPolynomial.induction_on
      next a =>
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact J.zero_mem
      next p q hp hq =>
        have := J.add_mem hp hq
        simp only [map_add]
        convert this using 1
        ring
      next p i _ =>
        simp only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, MvPolynomial.C_0, map_zero,
          sub_zero]
        exact J.mul_mem_left _ (hXJ i)
    have hπJ : Ideal.Quotient.mk I (MvPolynomial.C π) ∈ J := by
      have e : Ideal.Quotient.mk I (MvPolynomial.C π) = Ideal.Quotient.mk I Q := by
        rw [Ideal.Quotient.eq]
        have hmem : Q - MvPolynomial.C π ∈ I := by
          rw [hIdef]; exact Ideal.mem_span_singleton_self _
        rw [← neg_sub]
        exact neg_mem hmem
      have := hdec Q
      rw [hccQ, MvPolynomial.C_0, map_zero, sub_zero] at this
      rw [e]; exact this
    have h2 : RingHom.ker εb ≤ J := by
      intro r hr
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [RingHom.mem_ker, hεb, IsLocalRing.residue_eq_zero_iff, hπ,
        Ideal.mem_span_singleton'] at hr
      obtain ⟨a, ha⟩ := hr
      have hC : Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
        rw [← ha, MvPolynomial.C_mul, map_mul]
        exact J.mul_mem_left _ hπJ
      have := J.add_mem (hdec f) hC
      rwa [sub_add_cancel] at this
    rw [le_antisymm h1 h2]
    exact hmax

  set I' := wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA) with hI'
  set Q' : MvPolynomial (Fin n) A' :=
    ∑ p, ∑ q, MvPolynomial.C ((c.map ιA) p q) * MvPolynomial.X p * MvPolynomial.X q with hQ'
  have hI'def : I' = Ideal.span {Q' - MvPolynomial.C (π' ^ 2)} := rfl
  have hπ'm : π' ∈ IsLocalRing.maximalIdeal A' := by
    rw [hπ']; exact Ideal.mem_span_singleton_self π'
  have hres : IsLocalRing.residue A' π' = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff]; exact hπ'm

  let ε : MvPolynomial (Fin n) A' →+* IsLocalRing.ResidueField A' :=
    (IsLocalRing.residue A').comp MvPolynomial.constantCoeff
  have hccQ : MvPolynomial.constantCoeff Q' = 0 := by
    rw [hQ']; simp
  have hεI : ∀ a ∈ I', ε a = 0 := by
    intro a ha
    rw [hI'def, Ideal.mem_span_singleton'] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [map_mul]
    show ε b * IsLocalRing.residue A'
      (MvPolynomial.constantCoeff (Q' - MvPolynomial.C (π' ^ 2))) = 0
    rw [map_sub, hccQ, MvPolynomial.constantCoeff_C, zero_sub, map_neg, map_pow, hres,
      zero_pow two_ne_zero, neg_zero, mul_zero]
  let εb : MvPolynomial (Fin n) A' ⧸ I' →+* IsLocalRing.ResidueField A' :=
    Ideal.Quotient.lift I' ε hεI
  have hεb : ∀ f, εb (Ideal.Quotient.mk I' f) =
      IsLocalRing.residue A' (MvPolynomial.constantCoeff f) :=
    fun f => Ideal.Quotient.lift_mk _ _ _
  have hsurj : Function.Surjective εb := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨Ideal.Quotient.mk I' (MvPolynomial.C a), by rw [hεb, MvPolynomial.constantCoeff_C]⟩
  have hmax : (RingHom.ker εb).IsMaximal := RingHom.ker_isMaximal_of_surjective εb hsurj
  set J := Ideal.span (Set.range (wcQmbtGen A' n π' (c.map ιA))) with hJ
  have hgenJ : ∀ k, wcQmbtGen A' n π' (c.map ιA) k ∈ J := fun k => Ideal.subset_span ⟨k, rfl⟩
  have hXJ : ∀ p, Ideal.Quotient.mk I' (MvPolynomial.X p) ∈ J := fun p => hgenJ (some p)
  have hπJ : Ideal.Quotient.mk I' (MvPolynomial.C π') ∈ J := hgenJ none
  have h1 : J ≤ RingHom.ker εb := by
    rw [hJ, Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    cases k with
    | none =>
      show εb (Ideal.Quotient.mk I' (MvPolynomial.C π')) = 0
      rw [hεb, MvPolynomial.constantCoeff_C, hres]
    | some p =>
      show εb (Ideal.Quotient.mk I' (MvPolynomial.X p)) = 0
      rw [hεb, MvPolynomial.constantCoeff_X, map_zero]
  have hdec : ∀ f : MvPolynomial (Fin n) A',
      Ideal.Quotient.mk I' f -
        Ideal.Quotient.mk I' (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
    intro f
    induction f using MvPolynomial.induction_on
    next a =>
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact J.zero_mem
    next p q hp hq =>
      have := J.add_mem hp hq
      simp only [map_add]
      convert this using 1
      ring
    next p i _ =>
      simp only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, MvPolynomial.C_0, map_zero,
        sub_zero]
      exact J.mul_mem_left _ (hXJ i)
  have h2 : RingHom.ker εb ≤ J := by
    intro r hr
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [RingHom.mem_ker, hεb, IsLocalRing.residue_eq_zero_iff, hπ',
      Ideal.mem_span_singleton'] at hr
    obtain ⟨a, ha⟩ := hr
    have hC : Ideal.Quotient.mk I' (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
      rw [← ha, MvPolynomial.C_mul, map_mul]
      exact J.mul_mem_left _ hπJ
    have := J.add_mem (hdec f) hC
    rwa [sub_add_cancel] at this
  have hJmax : J.IsMaximal := by
    rw [le_antisymm h1 h2]
    exact hmax

  set m₀ := Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) with hm₀def
  have hm₀x : m₀ = x₀.asIdeal := by
    refine hm₀.eq_of_le (PrimeSpectrum.isPrime x₀).ne_top ?_
    rw [hm₀def, Ideal.span_le]
    rintro _ ⟨p, rfl⟩
    exact hx₀ p

  have hπmem : algebraMap A (wcQuadModelRing A n π c) π ∈ x₀.asIdeal := by
    have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
        algebraMap A (wcQuadModelRing A n π c) π := by
      change _ = Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π)
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
    rw [← hrel, map_sum]
    refine Ideal.sum_mem _ fun p _ => ?_
    rw [map_sum]
    refine Ideal.sum_mem _ fun q _ => ?_
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (hx₀ q)

  let o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) := ⟨J, hJmax.isPrime⟩
  refine ⟨o, hgenJ, fun q => ?_⟩

  have hbase : ∀ q : Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      ((Spec.map (CommRingCat.ofHom θ)) q).asIdeal = Ideal.comap θ q.asIdeal := fun q => rfl
  constructor
  ·
    intro hq
    have hc : Ideal.comap θ q.asIdeal = x₀.asIdeal := by
      rw [← hbase, hq]
    have hgq : ∀ k, wcQmbtGen A' n π' (c.map ιA) k ∈ q.asIdeal := by
      intro k
      cases k with
      | none =>
        have h3 : θ (algebraMap A (wcQuadModelRing A n π c) π) ∈ q.asIdeal := by
          rw [← Ideal.mem_comap, hc]; exact hπmem
        have h4 : θ (algebraMap A (wcQuadModelRing A n π c) π) =
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π') ^ 2 := by
          rw [← map_pow]
          exact (RingHom.congr_fun hθA π).trans
            (congrArg (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) hπ'2.symm)
        rw [h4] at h3
        exact (PrimeSpectrum.isPrime q).mem_of_pow_mem 2 h3
      | some p =>
        show Ideal.Quotient.mk I' (MvPolynomial.X p) ∈ q.asIdeal
        rw [← hθX p, ← Ideal.mem_comap, hc]
        exact hx₀ p
    have hJq : J ≤ q.asIdeal := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      exact hgq k
    have := hJmax.eq_of_le (PrimeSpectrum.isPrime q).ne_top hJq
    exact PrimeSpectrum.ext this.symm
  ·
    rintro rfl
    apply PrimeSpectrum.ext
    rw [hbase]
    have hle : m₀ ≤ Ideal.comap θ J := by
      rw [hm₀def, Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      show θ _ ∈ J
      rw [hθX p]
      exact hXJ p
    have := hm₀.eq_of_le (Ideal.comap_ne_top θ hJmax.ne_top) hle
    rw [← hm₀x, this]

theorem wc_qmbt_hlsc_quad_irred {k : Type u} {σ : Type*} [Field k] [Fintype σ] [DecidableEq σ] {n : ℕ} (hn : 3 ≤ n) (c : Matrix (Fin n) (Fin n) k) (hc : IsUnit (c + c.transpose).det) (v : Fin n → Option σ) (hv : Function.Injective v) (R : MvPolynomial σ k) (hR : R.totalDegree ≤ 2) (hRc : ∀ p q, R.coeff ((Option.elim (v p) 0 fun x => Finsupp.single x 1) + (Option.elim (v q) 0 fun x => Finsupp.single x 1)) = 0) : Irreducible (∑ p, ∑ q, MvPolynomial.C (c p q) * Option.elim (v p) 1 MvPolynomial.X * Option.elim (v q) 1 MvPolynomial.X + R) :=
by
  classical
  obtain ⟨E, hE⟩ : ∃ E : Option σ → (σ →₀ ℕ), ∀ u, E u = Option.elim u 0 fun x => Finsupp.single x 1 :=
    ⟨_, fun u => rfl⟩
  obtain ⟨Y, hY⟩ : ∃ Y : Option σ → MvPolynomial σ k, ∀ u, Y u = Option.elim u 1 MvPolynomial.X :=
    ⟨_, fun u => rfl⟩
  simp only [← hE] at hRc
  simp only [← hY]
  obtain ⟨Q, hQ⟩ : ∃ Q : MvPolynomial σ k,
      Q = ∑ p, ∑ q, MvPolynomial.C (c p q) * Y (v p) * Y (v q) + R := ⟨_, rfl⟩
  rw [← hQ]

  have hEn : E none = 0 := by rw [hE]; rfl
  have hEs : ∀ x, E (some x) = Finsupp.single x 1 := fun x => by rw [hE]; rfl
  have hYm : ∀ u, Y u = MvPolynomial.monomial (E u) 1 := by
    intro u
    cases u with
    | none =>
      rw [hY, hEn]
      show (1 : MvPolynomial σ k) = _
      rw [← MvPolynomial.C_apply, map_one]
    | some x => rw [hY, hEs]; rfl
  have hterm : ∀ (a : k) (u w : Option σ),
      MvPolynomial.C a * Y u * Y w = MvPolynomial.monomial (E u + E w) a := by
    intro a u w
    rw [hYm, hYm, MvPolynomial.C_mul_monomial, MvPolynomial.monomial_mul]
    simp only [mul_one]

  have hpair : ∀ u w u' w' : Option σ, E u + E w = E u' + E w' →
      (u = u' ∧ w = w') ∨ (u = w' ∧ w = u') := by
    intro u w u' w' h
    have hd := congrArg Finsupp.degree h
    cases u <;> cases w <;> cases u' <;> cases w' <;>
      simp only [hEn, hEs, map_add, map_zero, Finsupp.degree_single, add_zero, zero_add,
        Option.some.injEq, reduceCtorEq, true_and, and_true, false_and, and_false, or_false,
        false_or, true_or, or_true, and_self] at hd h ⊢
    all_goals first
      | omega
      | exact (Finsupp.single_left_inj one_ne_zero).mp h
      | exact ((Finsupp.single_left_inj one_ne_zero).mp h).symm
      | (rcases (Finsupp.single_add_single_eq_single_add_single one_ne_zero one_ne_zero).mp h with
            h1 | ⟨_, h2⟩ | ⟨h3, _⟩
         · exact Or.inl h1
         · exact Or.inr h2
         · exact absurd h3 (by norm_num))
  have hEinj : ∀ u w, E u = E w → u = w := by
    intro u w h
    rcases hpair u none w none (by rw [h]) with ⟨h1, _⟩ | ⟨h1, h2⟩
    · exact h1
    · rw [h1, h2]

  have hlin : ∀ P : MvPolynomial σ k, P.totalDegree ≤ 1 →
      P = ∑ u : Option σ, MvPolynomial.monomial (E u) (P.coeff (E u)) := by
    intro P hP
    ext m
    rw [MvPolynomial.coeff_sum]
    simp only [MvPolynomial.coeff_monomial]
    by_cases hm : ∃ u, E u = m
    · obtain ⟨u0, rfl⟩ := hm
      rw [Finset.sum_eq_single u0]
      · rw [if_pos rfl]
      · intro b _ hb
        rw [if_neg]
        intro h; exact hb (hEinj _ _ h)
      · intro h; exact absurd (Finset.mem_univ u0) h
    · rw [Finset.sum_eq_zero (fun u _ => if_neg (fun h => hm ⟨u, h⟩))]
      by_contra hne
      have hTMinj : Function.Injective (Finsupp.toMultiset (α := σ)) := fun a b h => by
        simpa using congrArg Multiset.toFinsupp h
      have hmem : m ∈ P.support := MvPolynomial.mem_support_iff.mpr hne
      have h1 := MvPolynomial.le_totalDegree hmem
      have h2 : Multiset.card (Finsupp.toMultiset m) ≤ 1 := by
        rw [Finsupp.card_toMultiset]; exact le_trans h1 hP
      rcases Nat.le_one_iff_eq_zero_or_eq_one.mp h2 with h0 | h0
      · rw [Multiset.card_eq_zero] at h0
        apply hm ⟨none, ?_⟩
        rw [hEn]
        apply hTMinj
        rw [h0, map_zero]
      · obtain ⟨x, hx⟩ := Multiset.card_eq_one.mp h0
        apply hm ⟨some x, ?_⟩
        rw [hEs]
        apply hTMinj
        rw [hx, Finsupp.toMultiset_single, one_smul]

  have hDO : ∀ (g : Option σ → Option σ → k) (i j : Option σ),
      (∑ a, ∑ b, if a = i ∧ b = j then g a b else 0) = g i j := by
    intro g i j
    rw [Finset.sum_eq_single i (fun a _ ha => Finset.sum_eq_zero (fun b _ => if_neg (fun h => ha h.1)))
      (fun h => absurd (Finset.mem_univ i) h)]
    rw [Finset.sum_eq_single j (fun b _ hb => if_neg (fun h => hb h.2))
      (fun h => absurd (Finset.mem_univ j) h)]
    exact if_pos ⟨rfl, rfl⟩
  have hSO : ∀ (g : Option σ → Option σ → k) (i j : Option σ),
      (∑ a, ∑ b, if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then g a b else 0) =
        if i = j then g i i else g i j + g j i := by
    intro g i j
    by_cases hij : i = j
    · subst hij
      rw [if_pos rfl]
      simp only [or_self]
      exact hDO g _ _
    · rw [if_neg hij]
      have hsplit : ∀ a b, (if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then g a b else 0) =
          (if a = i ∧ b = j then g a b else 0) + (if a = j ∧ b = i then g a b else 0) := by
        intro a b
        by_cases h1 : a = i ∧ b = j
        · have h2 : ¬ (a = j ∧ b = i) := fun h2 => hij (h1.1.symm.trans h2.1)
          rw [if_pos (Or.inl h1), if_pos h1, if_neg h2, add_zero]
        · by_cases h2 : a = j ∧ b = i
          · rw [if_pos (Or.inr h2), if_neg h1, if_pos h2, zero_add]
          · rw [if_neg (not_or.mpr ⟨h1, h2⟩), if_neg h1, if_neg h2, add_zero]
      simp only [hsplit, Finset.sum_add_distrib]
      rw [hDO g i j, hDO g j i]
  have hDF : ∀ (g : Fin n → Fin n → k) (i j : Fin n),
      (∑ a, ∑ b, if a = i ∧ b = j then g a b else 0) = g i j := by
    intro g i j
    rw [Finset.sum_eq_single i (fun a _ ha => Finset.sum_eq_zero (fun b _ => if_neg (fun h => ha h.1)))
      (fun h => absurd (Finset.mem_univ i) h)]
    rw [Finset.sum_eq_single j (fun b _ hb => if_neg (fun h => hb h.2))
      (fun h => absurd (Finset.mem_univ j) h)]
    exact if_pos ⟨rfl, rfl⟩
  have hSF : ∀ (g : Fin n → Fin n → k) (i j : Fin n),
      (∑ a, ∑ b, if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then g a b else 0) =
        if i = j then g i i else g i j + g j i := by
    intro g i j
    by_cases hij : i = j
    · subst hij
      rw [if_pos rfl]
      simp only [or_self]
      exact hDF g _ _
    · rw [if_neg hij]
      have hsplit : ∀ a b, (if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then g a b else 0) =
          (if a = i ∧ b = j then g a b else 0) + (if a = j ∧ b = i then g a b else 0) := by
        intro a b
        by_cases h1 : a = i ∧ b = j
        · have h2 : ¬ (a = j ∧ b = i) := fun h2 => hij (h1.1.symm.trans h2.1)
          rw [if_pos (Or.inl h1), if_pos h1, if_neg h2, add_zero]
        · by_cases h2 : a = j ∧ b = i
          · rw [if_pos (Or.inr h2), if_neg h1, if_pos h2, zero_add]
          · rw [if_neg (not_or.mpr ⟨h1, h2⟩), if_neg h1, if_neg h2, add_zero]
      simp only [hsplit, Finset.sum_add_distrib]
      rw [hDF g i j, hDF g j i]
  have hiffO : ∀ u w u0 w0 : Option σ, E u + E w = E u0 + E w0 ↔
      (u = u0 ∧ w = w0) ∨ (u = w0 ∧ w = u0) := by
    intro u w u0 w0
    constructor
    · exact hpair _ _ _ _
    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
      · rfl
      · exact add_comm _ _
  have hiffF : ∀ p q i j : Fin n, E (v p) + E (v q) = E (v i) + E (v j) ↔
      (p = i ∧ q = j) ∨ (p = j ∧ q = i) := by
    intro p q i j
    constructor
    · intro h
      rcases hpair _ _ _ _ h with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact Or.inl ⟨hv h1, hv h2⟩
      · exact Or.inr ⟨hv h1, hv h2⟩
    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
      · rfl
      · exact add_comm _ _

  have hQcoef : ∀ i j : Fin n, Q.coeff (E (v i) + E (v j)) =
      if i = j then c i i else c i j + c j i := by
    intro i j
    rw [hQ, MvPolynomial.coeff_add, hRc i j, add_zero]
    simp only [hterm, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, hiffF]
    exact hSF c i j
  have hprod : ∀ A B : MvPolynomial σ k, A.totalDegree ≤ 1 → B.totalDegree ≤ 1 →
      ∀ u0 w0 : Option σ, (A * B).coeff (E u0 + E w0) =
        if u0 = w0 then A.coeff (E u0) * B.coeff (E u0)
        else A.coeff (E u0) * B.coeff (E w0) + A.coeff (E w0) * B.coeff (E u0) := by
    intro A B hA hB u0 w0
    conv_lhs => rw [hlin A hA, hlin B hB, Finset.sum_mul_sum]
    simp only [MvPolynomial.monomial_mul, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial,
      hiffO]
    exact hSO (fun u w => A.coeff (E u) * B.coeff (E w)) u0 w0

  have hdet2 : ∀ α β : Fin n → k, (Matrix.of fun i j : Fin n => α i * β j + α j * β i).det = 0 := by
    intro α β
    let z0 : Fin n := ⟨0, by omega⟩
    let z1 : Fin n := ⟨1, by omega⟩
    let z2 : Fin n := ⟨2, by omega⟩
    have h01 : z0 ≠ z1 := by simp [z0, z1, Fin.ext_iff]
    have h20 : z2 ≠ z0 := by simp [z0, z2, Fin.ext_iff]
    have h21 : z2 ≠ z1 := by simp [z1, z2, Fin.ext_iff]
    let M : Matrix (Fin n) (Fin n) k :=
      Matrix.of fun i l => if l = z0 then α i else if l = z1 then β i else 0
    let N : Matrix (Fin n) (Fin n) k :=
      Matrix.of fun l j => if l = z0 then β j else if l = z1 then α j else 0
    have hMN : (Matrix.of fun i j : Fin n => α i * β j + α j * β i) = M * N := by
      ext i j
      rw [Matrix.mul_apply, Finset.sum_eq_add_of_mem z0 z1 (Finset.mem_univ _) (Finset.mem_univ _) h01]
      · simp [M, N, h01, h01.symm] <;> ring
      · intro l _ hl
        simp only [M, N, Matrix.of_apply, if_neg hl.1, if_neg hl.2, zero_mul]
    have hM : M.det = 0 := Matrix.det_eq_zero_of_column_eq_zero z2 (fun i => by
      simp only [M, Matrix.of_apply, if_neg h20, if_neg h21])
    rw [hMN, Matrix.det_mul, hM, zero_mul]

  have hno : ∀ A B : MvPolynomial σ k, A.totalDegree ≤ 1 → B.totalDegree ≤ 1 → Q ≠ A * B := by
    intro A B hA hB hQAB
    have hmat : c + c.transpose = Matrix.of fun i j : Fin n =>
        A.coeff (E (v i)) * B.coeff (E (v j)) + A.coeff (E (v j)) * B.coeff (E (v i)) := by
      ext i j
      have h1 := hQcoef i j
      rw [hQAB, hprod A B hA hB (v i) (v j)] at h1
      simp only [Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply]
      by_cases hij : i = j
      · subst hij
        rw [if_pos rfl, if_pos rfl] at h1
        rw [← h1]
      · rw [if_neg (fun h => hij (hv h)), if_neg hij] at h1
        exact h1.symm
    apply not_isUnit_zero (M₀ := k)
    rw [← hdet2 (fun i => A.coeff (E (v i))) (fun i => B.coeff (E (v i))), ← hmat]
    exact hc

  have hY1 : ∀ u, (Y u).totalDegree ≤ 1 := by
    intro u
    rw [hYm]
    refine (MvPolynomial.totalDegree_monomial_le _ _).trans ?_
    cases u with
    | none => rw [hEn]; simp
    | some x => rw [hEs]; simp
  have hQdeg : Q.totalDegree ≤ 2 := by
    rw [hQ]
    refine (MvPolynomial.totalDegree_add _ _).trans (max_le ?_ hR)
    refine (MvPolynomial.totalDegree_finsetSum _ _).trans (Finset.sup_le fun p _ => ?_)
    refine (MvPolynomial.totalDegree_finsetSum _ _).trans (Finset.sup_le fun q _ => ?_)
    have e1 := MvPolynomial.totalDegree_mul (MvPolynomial.C (c p q) * Y (v p)) (Y (v q))
    have e2 := MvPolynomial.totalDegree_mul (MvPolynomial.C (c p q)) (Y (v p))
    rw [MvPolynomial.totalDegree_C] at e2
    have e3 := hY1 (v p)
    have e4 := hY1 (v q)
    omega

  have hQ0 : Q ≠ 0 := fun h => hno 0 0 (by simp) (by simp) (by rw [h, mul_zero])
  have hunitC : ∀ P : MvPolynomial σ k, P.totalDegree = 0 → P ≠ 0 → IsUnit P := by
    intro P h0 hne
    rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h0
    have hc0 : P.coeff 0 ≠ 0 := by
      intro hc0; apply hne; rw [h0, hc0, map_zero]
    rw [h0]
    exact (isUnit_iff_ne_zero.mpr hc0).map MvPolynomial.C
  refine irreducible_iff.mpr ⟨?_, ?_⟩
  · intro hu
    obtain ⟨r, _, hr⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
    exact hno (MvPolynomial.C r) 1 (by simp) (by simp) (by rw [hr, mul_one])
  · intro A B hAB
    have hA0 : A ≠ 0 := by rintro rfl; exact hQ0 (by rw [hAB, zero_mul])
    have hB0 : B ≠ 0 := by rintro rfl; exact hQ0 (by rw [hAB, mul_zero])
    have hdeg := MvPolynomial.totalDegree_mul_of_isDomain hA0 hB0
    rw [← hAB] at hdeg
    by_cases hA : A.totalDegree = 0
    · exact Or.inl (hunitC A hA hA0)
    by_cases hB : B.totalDegree = 0
    · exact Or.inr (hunitC B hB hB0)
    exact absurd hAB (hno A B (by omega) (by omega))

theorem wc_qmbt_hlsc_chart_none_prime {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ} (hn : 3 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det) : (Ideal.span {Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π')}).IsPrime :=
by
  classical
  set F : MvPolynomial (Fin n) A' :=
    ∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1 with hFdef
  show (Ideal.span {Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.C π')}).IsPrime
  have hρs : Function.Surjective
      (MvPolynomial.map (σ := Fin n) (IsLocalRing.residue A')) :=
    MvPolynomial.map_surjective _ IsLocalRing.residue_surjective

  have hirr : Irreducible (MvPolynomial.map (IsLocalRing.residue A') F) := by
    have hcM : c'.map (IsLocalRing.residue A') + (c'.map (IsLocalRing.residue A')).transpose =
        (IsLocalRing.residue A').mapMatrix (c' + c'.transpose) := by
      ext i j
      simp [Matrix.map_apply]
    have hc : IsUnit (c'.map (IsLocalRing.residue A') +
        (c'.map (IsLocalRing.residue A')).transpose).det := by
      rw [hcM, ← RingHom.map_det]
      exact hc'.map _
    have hR : (-1 : MvPolynomial (Fin n) (IsLocalRing.ResidueField A')).totalDegree ≤ 2 := by
      rw [MvPolynomial.totalDegree_neg, MvPolynomial.totalDegree_one]
      norm_num
    have hRc : ∀ p q : Fin n, (-1 : MvPolynomial (Fin n) (IsLocalRing.ResidueField A')).coeff
        ((Option.elim (some p) 0 fun x => Finsupp.single x 1) +
          (Option.elim (some q) 0 fun x => Finsupp.single x 1)) = 0 := by
      intro p q
      rw [MvPolynomial.coeff_neg, MvPolynomial.coeff_one, if_neg, neg_zero]
      intro h
      have h2 : (0 : Fin n →₀ ℕ) p =
          ((Finsupp.single p 1 + Finsupp.single q 1 : Fin n →₀ ℕ)) p :=
        congrArg (fun m : Fin n →₀ ℕ => m p) h
      rw [Finsupp.add_apply, Finsupp.single_eq_same, Finsupp.coe_zero, Pi.zero_apply] at h2
      omega
    have h := wc_qmbt_hlsc_quad_irred (k := IsLocalRing.ResidueField A') (σ := Fin n) hn
      (c'.map (IsLocalRing.residue A')) hc some (Option.some_injective _) (-1) hR hRc
    convert h using 1
    rw [hFdef]
    simp only [map_sub, map_add, map_neg, map_sum, map_mul, MvPolynomial.map_C,
      MvPolynomial.map_X, map_one, Matrix.map_apply, Option.elim, sub_eq_add_neg]

  haveI hprime : (Ideal.span {MvPolynomial.map (IsLocalRing.residue A') F}).IsPrime :=
    (Ideal.span_singleton_prime hirr.ne_zero).mpr hirr.prime

  have hmap : Ideal.map (MvPolynomial.map (IsLocalRing.residue A')) (Ideal.span {F}) =
      Ideal.span {MvPolynomial.map (IsLocalRing.residue A') F} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hkerρ : RingHom.ker (MvPolynomial.map (σ := Fin n) (IsLocalRing.residue A')) =
      Ideal.span {MvPolynomial.C π'} := by
    rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hπ', Ideal.map_span, Set.image_singleton]
  have hKp : (Ideal.comap (MvPolynomial.map (IsLocalRing.residue A'))
      (Ideal.span {MvPolynomial.map (IsLocalRing.residue A') F})).IsPrime :=
    Ideal.IsPrime.comap _
  have hKeq : Ideal.comap (MvPolynomial.map (IsLocalRing.residue A'))
      (Ideal.span {MvPolynomial.map (IsLocalRing.residue A') F}) =
      Ideal.span {F} ⊔ Ideal.span {MvPolynomial.C π'} := by
    rw [← hmap, Ideal.comap_map_of_surjective' _ hρs, hkerρ]
  rw [hKeq] at hKp
  have hle : RingHom.ker (Ideal.Quotient.mk (Ideal.span {F})) ≤
      Ideal.span {F} ⊔ Ideal.span {MvPolynomial.C π'} := by
    rw [Ideal.mk_ker]
    exact le_sup_left
  have hP := Ideal.map_isPrime_of_surjective (f := Ideal.Quotient.mk (Ideal.span {F}))
    Ideal.Quotient.mk_surjective hle
  rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span,
    Set.image_singleton] at hP
  exact hP

theorem wc_qmbt_hlsc_chart_some_prime {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ} (hn : 3 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det) (j : Fin n) : (Ideal.span {Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j))}).IsPrime ∧ Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∉ Ideal.span {Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j))} :=
by
  classical

  set G : MvPolynomial (Option (Fin n)) A' := ∑ p, ∑ q, MvPolynomial.C (c' p q) *
    wcQmbtChartHat j p * wcQmbtChartHat j q - MvPolynomial.X none ^ 2 with hGdef
  set I : Ideal (MvPolynomial (Option (Fin n)) A') := wcQmbtChartIdeal A' n π' c' j with hIdef
  have hIeq : I = Ideal.span {MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π', G} :=
    rfl
  set Gb : MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') :=
    ∑ p, ∑ q, MvPolynomial.C (IsLocalRing.residue A' (c' p q)) *
      wcQmbtChartHat (A' := IsLocalRing.ResidueField A') j p *
      wcQmbtChartHat (A' := IsLocalRing.ResidueField A') j q - MvPolynomial.X none ^ 2 with hGbdef

  have hρhat : ∀ p, MvPolynomial.map (IsLocalRing.residue A') (wcQmbtChartHat (A' := A') j p) =
      wcQmbtChartHat (A' := IsLocalRing.ResidueField A') j p := by
    intro p
    by_cases h : p = j
    · simp [wcQmbtChartHat, h]
    · simp [wcQmbtChartHat, h]
  have hρG : MvPolynomial.map (IsLocalRing.residue A') G = Gb := by
    rw [hGdef, hGbdef]
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, map_pow, MvPolynomial.map_X, hρhat]

  have hirr : Irreducible Gb := by
    have hcM : c'.map (IsLocalRing.residue A') + (c'.map (IsLocalRing.residue A')).transpose =
        (IsLocalRing.residue A').mapMatrix (c' + c'.transpose) := by
      ext a b
      simp [Matrix.map_apply]
    have hc : IsUnit (c'.map (IsLocalRing.residue A') +
        (c'.map (IsLocalRing.residue A')).transpose).det := by
      rw [hcM, ← RingHom.map_det]
      exact hc'.map _
    let v : Fin n → Option (Option (Fin n)) := fun p => if p = j then none else some (some p)
    have hv : Function.Injective v := by
      intro p q h
      by_cases hp : p = j <;> by_cases hq : q = j
      · rw [hp, hq]
      · simp [v, hp, hq] at h
      · simp [v, hp, hq] at h
      · simpa [v, hp, hq] using h
    have hR : (-(MvPolynomial.X none ^ 2) :
        MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A')).totalDegree ≤ 2 := by
      rw [MvPolynomial.totalDegree_neg, MvPolynomial.totalDegree_X_pow]
    have hμ : ∀ p, (Option.elim (v p) 0 fun x => Finsupp.single x 1 : Option (Fin n) →₀ ℕ) none
        = 0 := by
      intro p
      by_cases hp : p = j
      · simp [v, hp]
      · simp [v, hp, Finsupp.single_apply]
    have hRc : ∀ p q, (-(MvPolynomial.X none ^ 2) :
        MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A')).coeff
        ((Option.elim (v p) 0 fun x => Finsupp.single x 1) +
          (Option.elim (v q) 0 fun x => Finsupp.single x 1)) = 0 := by
      intro p q
      rw [MvPolynomial.coeff_neg, MvPolynomial.coeff_X_pow, if_neg, neg_zero]
      intro h
      have h2 := congrArg (fun m : Option (Fin n) →₀ ℕ => m none) h
      simp only [Finsupp.add_apply, hμ, Finsupp.single_eq_same] at h2
      omega
    have helim : ∀ p, (Option.elim (v p) 1 MvPolynomial.X :
        MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A')) =
        wcQmbtChartHat (A' := IsLocalRing.ResidueField A') j p := by
      intro p
      by_cases hp : p = j
      · simp [v, hp, wcQmbtChartHat]
      · simp [v, hp, wcQmbtChartHat]
    have h := wc_qmbt_hlsc_quad_irred (k := IsLocalRing.ResidueField A') (σ := Option (Fin n)) hn
      (c'.map (IsLocalRing.residue A')) hc v hv (-(MvPolynomial.X none ^ 2)) hR hRc
    simp only [helim, Matrix.map_apply] at h
    rw [hGbdef, sub_eq_add_neg]
    exact h

  haveI hGprime : (Ideal.span {Gb}).IsPrime :=
    (Ideal.span_singleton_prime hirr.ne_zero).mpr hirr.prime

  obtain ⟨g, hg⟩ : ∃ g : Option (Fin n) → MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A'),
      g = fun w => if w = some j then 0 else MvPolynomial.X w := ⟨_, rfl⟩
  have hgj : g (some j) = 0 := by rw [hg]; simp
  have hgo : ∀ w, w ≠ some j → g w = MvPolynomial.X w := by
    intro w hw; rw [hg]; simp [hw]
  have hτhat : ∀ p, MvPolynomial.aeval g (wcQmbtChartHat (A' := IsLocalRing.ResidueField A') j p) =
      wcQmbtChartHat (A' := IsLocalRing.ResidueField A') j p := by
    intro p
    by_cases h : p = j
    · simp [wcQmbtChartHat, h]
    · have h' : (some p : Option (Fin n)) ≠ some j := fun e => h (Option.some_injective _ e)
      simp only [wcQmbtChartHat, h, if_false, MvPolynomial.aeval_X, hgo _ h']
  have hτG : MvPolynomial.aeval g Gb = Gb := by
    rw [hGbdef]
    simp only [map_sub, map_sum, map_mul, map_pow, MvPolynomial.aeval_C, MvPolynomial.aeval_X, hτhat,
      MvPolynomial.algebraMap_eq, hgo none (by simp)]
  have hR1 : ∀ y : MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A'),
      y - MvPolynomial.aeval g y ∈ Ideal.span {MvPolynomial.X (some j)} := by
    intro y
    induction y using MvPolynomial.induction_on
    · rename_i a
      rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, sub_self]
      exact zero_mem _
    · rename_i p q hp hq
      rw [map_add, add_sub_add_comm]
      exact Ideal.add_mem _ hp hq
    · rename_i p w hp
      rw [map_mul, MvPolynomial.aeval_X]
      have e : p * MvPolynomial.X w - MvPolynomial.aeval g p * g w =
          (p - MvPolynomial.aeval g p) * MvPolynomial.X w +
            MvPolynomial.aeval g p * (MvPolynomial.X w - g w) := by ring
      rw [e]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
      by_cases hw : w = some j
      · rw [hw, hgj, sub_zero]
        exact Ideal.mem_span_singleton_self _
      · rw [hgo w hw, sub_self]
        exact zero_mem _
  have hPeq : Ideal.span {Gb, MvPolynomial.X (some j)} =
      Ideal.comap (MvPolynomial.aeval g) (Ideal.span {Gb}) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      intro y hy
      rcases hy with rfl | rfl
      · show MvPolynomial.aeval g Gb ∈ Ideal.span {Gb}
        rw [hτG]
        exact Ideal.mem_span_singleton_self _
      · show MvPolynomial.aeval g (MvPolynomial.X (some j)) ∈ Ideal.span {Gb}
        rw [MvPolynomial.aeval_X, hgj]
        exact zero_mem _
    · intro y hy
      rw [Ideal.mem_comap] at hy
      have e : y = (y - MvPolynomial.aeval g y) + MvPolynomial.aeval g y := by ring
      rw [e]
      refine Ideal.add_mem _ ?_ ?_
      · exact Ideal.span_mono (by simp) (hR1 y)
      · exact Ideal.span_mono (by simp) hy
  haveI hPprime : (Ideal.span {Gb, MvPolynomial.X (some j)}).IsPrime := by
    rw [hPeq]
    exact Ideal.IsPrime.comap _

  have hρs : Function.Surjective
      (MvPolynomial.map (σ := Option (Fin n)) (IsLocalRing.residue A')) :=
    MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
  have hkerρ : RingHom.ker (MvPolynomial.map (σ := Option (Fin n)) (IsLocalRing.residue A')) =
      Ideal.span {MvPolynomial.C π'} := by
    rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hπ', Ideal.map_span, Set.image_singleton]
  have hmapP : Ideal.map (MvPolynomial.map (IsLocalRing.residue A'))
      (Ideal.span {G, MvPolynomial.X (some j)}) = Ideal.span {Gb, MvPolynomial.X (some j)} := by
    rw [Ideal.map_span, Set.image_pair, hρG, MvPolynomial.map_X]
  have hJ : I ⊔ Ideal.span {MvPolynomial.X (some j)} =
      Ideal.comap (MvPolynomial.map (IsLocalRing.residue A'))
        (Ideal.span {Gb, MvPolynomial.X (some j)}) := by
    rw [← hmapP, Ideal.comap_map_of_surjective' _ hρs, hkerρ, hIeq]
    apply le_antisymm
    · apply sup_le
      · rw [Ideal.span_le]
        intro y hy
        rcases hy with rfl | rfl
        · exact Ideal.sub_mem _
            (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))))
            (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
        · exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
    · apply sup_le
      · rw [Ideal.span_le]
        intro y hy
        rcases hy with rfl | rfl
        · exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
        · exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        have e : (MvPolynomial.C π' : MvPolynomial (Option (Fin n)) A') =
            MvPolynomial.X (some j) * MvPolynomial.X none -
              (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π') := by ring
        rw [e]
        exact Ideal.sub_mem _
          (Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)))
          (Ideal.mem_sup_left (Ideal.subset_span (by simp)))

  have hsnot : (MvPolynomial.X none : MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A')) ∉
      Ideal.span {Gb, MvPolynomial.X (some j)} := by
    intro hmem
    rw [Ideal.mem_span_pair] at hmem
    obtain ⟨a, b, hab⟩ := hmem
    obtain ⟨ε, hε⟩ : ∃ ε : MvPolynomial (Option (Fin n)) (IsLocalRing.ResidueField A') →ₐ[IsLocalRing.ResidueField A']
        Polynomial (IsLocalRing.ResidueField A'),
        ε = MvPolynomial.aeval (fun w => Option.elim w Polynomial.X (fun _ => 0)) := ⟨_, rfl⟩
    have hεC : ∀ r, ε (MvPolynomial.C r) = Polynomial.C r := by
      intro r; rw [hε, MvPolynomial.aeval_C, Polynomial.algebraMap_eq]
    have hεn : ε (MvPolynomial.X none) = Polynomial.X := by
      rw [hε, MvPolynomial.aeval_X]; rfl
    have hεs : ∀ p, ε (MvPolynomial.X (some p)) = 0 := by
      intro p; rw [hε, MvPolynomial.aeval_X]; rfl
    have hεhat : ∀ p, ε (wcQmbtChartHat (A' := IsLocalRing.ResidueField A') j p) =
        if p = j then 1 else 0 := by
      intro p
      by_cases h : p = j
      · simp only [wcQmbtChartHat, h, if_true, map_one]
      · simp only [wcQmbtChartHat, h, if_false, hεs]
    have hεG : ε Gb = Polynomial.C (IsLocalRing.residue A' (c' j j)) - Polynomial.X ^ 2 := by
      rw [hGbdef]
      simp only [map_sub, map_sum, map_mul, map_pow, hεC, hεn, hεhat]
      simp
    have h := congrArg ε hab
    rw [map_add, map_mul, map_mul, hεG, hεs, mul_zero, add_zero, hεn] at h
    have hq2 : (Polynomial.C (IsLocalRing.residue A' (c' j j)) - Polynomial.X ^ 2 :
        Polynomial (IsLocalRing.ResidueField A')).natDegree = 2 := by
      rw [Polynomial.natDegree_sub_eq_right_of_natDegree_lt] <;> simp
    have hq0 : (Polynomial.C (IsLocalRing.residue A' (c' j j)) - Polynomial.X ^ 2 :
        Polynomial (IsLocalRing.ResidueField A')) ≠ 0 := by
      intro h0
      rw [h0, Polynomial.natDegree_zero] at hq2
      omega
    have ha0 : ε a ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at h
      exact Polynomial.X_ne_zero h.symm
    have hd := congrArg Polynomial.natDegree h
    rw [Polynomial.natDegree_mul ha0 hq0, hq2, Polynomial.natDegree_X] at hd
    omega

  haveI hJprime : (I ⊔ Ideal.span {MvPolynomial.X (some j)}).IsPrime := by
    rw [hJ]
    exact Ideal.IsPrime.comap _
  have hle : RingHom.ker (Ideal.Quotient.mk I) ≤ I ⊔ Ideal.span {MvPolynomial.X (some j)} := by
    rw [Ideal.mk_ker]
    exact le_sup_left
  have hmapJ : Ideal.map (Ideal.Quotient.mk I) (I ⊔ Ideal.span {MvPolynomial.X (some j)}) =
      Ideal.span {Ideal.Quotient.mk I (MvPolynomial.X (some j))} := by
    rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, Set.image_singleton]
  have hprime := Ideal.map_isPrime_of_surjective (f := Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective hle
  rw [hmapJ] at hprime
  refine ⟨hprime, ?_⟩
  intro hs
  rw [← hmapJ] at hs
  have hs' : (MvPolynomial.X none : MvPolynomial (Option (Fin n)) A') ∈
      Ideal.comap (Ideal.Quotient.mk I)
        (Ideal.map (Ideal.Quotient.mk I) (I ⊔ Ideal.span {MvPolynomial.X (some j)})) := hs
  rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
    sup_eq_left.mpr le_sup_left, hJ, Ideal.mem_comap, MvPolynomial.map_X] at hs'
  exact hsnot hs'

theorem wc_qmbt_hlsc_chart_overlap {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ} {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))) (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k => (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom (wcQmbtGen A' n π' c' k)))) r₁) (j : Fin n) (φj : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j) (hφjX : ∀ p, φj (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j) * wcQmbtChartHat j p)) (hφjA : φj.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) = algebraMap A' (wcQmbtChart A' n π' c' j)) (hφjnzd : φj (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors (wcQmbtChart A' n π' c' j)) (hφjgen : Ideal.map φj (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) = Ideal.span {φj (wcQmbtGen A' n π' c' (some j))}) (φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c') (hφ0up : ∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ B), ρ.hom (wcQmbtGen A' n π' c' none) ∈ nonZeroDivisors B → Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) = Ideal.span {ρ.hom (wcQmbtGen A' n π' c' none)} → ∃! ψ : CommRingCat.of (wcQmbtChartNone A' n c') ⟶ B, CommRingCat.ofHom φ0 ≫ ψ = ρ) (ej : Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁) (hej : ej ≫ r₁ = Spec.map (CommRingCat.ofHom φj)) (e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁) (he0 : e0 ≫ r₁ = Spec.map (CommRingCat.ofHom φ0)) (y : Spec (.of (wcQmbtChart A' n π' c' j))) (hy : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∉ y.asIdeal) : ∃ y0 : Spec (.of (wcQmbtChartNone A' n c')), e0 y0 = ej y :=
by
  classical
  let s : wcQmbtChart A' n π' c' j :=
    Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none)
  let x : wcQmbtChart A' n π' c' j :=
    Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j))

  have h1a : φj (wcQmbtGen A' n π' c' (some j)) = x := by
    show φj (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j)) = _
    rw [hφjX j]
    simp [wcQmbtChartHat, x]
  have h1b : φj (wcQmbtGen A' n π' c' none) = x * s := by
    show φj (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') = _
    rw [← RingHom.comp_apply, hφjA]
    show Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.C π') = _
    rw [show x * s = Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
      (MvPolynomial.X (some j) * MvPolynomial.X none) from (map_mul _ _ _).symm]
    symm
    rw [Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_insert _ _)

  let D := Localization.Away s
  let α : wcQmbtChart A' n π' c' j →+* D := algebraMap _ D
  let ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ CommRingCat.of D :=
    CommRingCat.ofHom (α.comp φj)
  have hαs : IsUnit (α s) := IsLocalization.Away.algebraMap_isUnit s
  have hx : x ∈ nonZeroDivisors (wcQmbtChart A' n π' c' j) := by
    rw [← h1a]; exact hφjnzd
  have hαx : α x ∈ nonZeroDivisors D :=
    IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers s) D hx
  have hρb : ρ.hom (wcQmbtGen A' n π' c' none) = α x * α s := by
    show α (φj (wcQmbtGen A' n π' c' none)) = _
    rw [h1b, map_mul]
  have hnzd : ρ.hom (wcQmbtGen A' n π' c' none) ∈ nonZeroDivisors D := by
    rw [hρb]
    exact mul_mem_nonZeroDivisors.mpr ⟨hαx, hαs.mem_nonZeroDivisors⟩

  have hgen : Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
      Ideal.span {ρ.hom (wcQmbtGen A' n π' c' none)} := by
    rw [hρb, Ideal.span_singleton_mul_right_unit hαs]
    show Ideal.map (α.comp φj) _ = _
    rw [← Ideal.map_map, hφjgen, Ideal.map_span, Set.image_singleton, h1a]

  obtain ⟨ψ, hψ, -⟩ := hφ0up (CommRingCat.of D) ρ hnzd hgen

  have hInv : wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (wcQmbtGen A' n π' c' k)))) (Spec.map ρ) := by
    have e : (⊤ : (Spec (CommRingCat.of D)).Opens) ≤ Spec.map ρ ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have hcomp : (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv ≫
        (Spec.map ρ).appLE ⊤ ⊤ e = ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of D)).inv := by
      rw [Scheme.ΓSpecIso_inv_naturality]
      congr 1
    have hval : ∀ z, ((Spec.map ρ).appLE ⊤ ⊤ e).hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom z) =
        (Scheme.ΓSpecIso (CommRingCat.of D)).inv.hom (ρ.hom z) := by
      intro z
      show ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv ≫
        (Spec.map ρ).appLE ⊤ ⊤ e).hom z = (ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of D)).inv).hom z
      rw [hcomp]
    have hIU : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))).ideal ⟨⊤, isAffineOpen_top _⟩ =
        Ideal.span (Set.range fun k =>
          (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
            (wcQmbtGen A' n π' c' k)) := by
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]
      have key : ∀ (h : (⊤ : (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).Opens) ≤ ⊤)
          (J : Ideal Γ(Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c')), ⊤)),
          Ideal.map ((Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).presheaf.map
            (homOfLE h).op).hom J = J := by
        intro h J
        rw [show (homOfLE h).op = 𝟙 _ from rfl, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
          Ideal.map_id]
      exact key _ _
    have hmapb : Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span (Set.range fun k =>
          (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
            (wcQmbtGen A' n π' c' k)) := by
      rw [Ideal.map_span, ← Set.range_comp]
      try rfl
    have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
        ε.hom.hom y ∈ nonZeroDivisors C := by
      intro B C ε y hy
      rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
      exact ⟨y, hy, rfl⟩
    intro t
    refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, e,
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (wcQmbtGen A' n π' c' none), trivial, ?_, ?_, ?_⟩
    · rw [hIU]
      exact Ideal.subset_span ⟨none, rfl⟩
    · rw [hval]
      exact hisoNZD (Scheme.ΓSpecIso (CommRingCat.of D)).symm _ hnzd
    · rw [hIU, hval, ← hmapb, Ideal.map_map, ← CommRingCat.hom_comp, hcomp, CommRingCat.hom_comp,
        ← Ideal.map_map, hgen, Ideal.map_span, Set.image_singleton]

  obtain ⟨-, hrU⟩ := hr
  have hL1 : (Spec.map (CommRingCat.ofHom α) ≫ ej) ≫ r₁ = Spec.map ρ := by
    rw [Category.assoc, hej, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hL2 : (Spec.map ψ ≫ e0) ≫ r₁ = Spec.map ρ := by
    rw [Category.assoc, he0, ← Spec.map_comp, hψ]
  have hEq : Spec.map (CommRingCat.ofHom α) ≫ ej = Spec.map ψ ≫ e0 :=
    (hrU _ (Spec.map ρ) hInv).unique hL1 hL2

  have hmem : (show PrimeSpectrum (wcQmbtChart A' n π' c' j) from y) ∈
      PrimeSpectrum.basicOpen s := (PrimeSpectrum.mem_basicOpen _ _).mpr hy
  rw [← SetLike.mem_coe, ← PrimeSpectrum.localization_away_comap_range D s] at hmem
  obtain ⟨q, hq⟩ := hmem
  refine ⟨Spec.map ψ q, ?_⟩
  have hℓq : Spec.map (CommRingCat.ofHom α) q = y := hq
  have hc := congrArg (fun f : Spec (CommRingCat.of D) ⟶ X₁ => f q) hEq
  simp only [Scheme.Hom.comp_apply] at hc
  rw [← hℓq]
  exact hc.symm

theorem wc_qmbt_hlsc_exc_irred {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 3 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det)
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c')))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (wcQmbtGen A' n π' c' k)))) r₁)
    (o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c')))
    (ho : ∀ k, wcQmbtGen A' n π' c' k ∈ o.asIdeal) :
    IsPreirreducible (r₁ ⁻¹' {o}) :=
by
  classical

  have hJmax : (Ideal.span (Set.range (wcQmbtGen A' n π' c'))).IsMaximal := by
    set I' := wcQuadModelIdeal A' n (π' ^ 2) c' with hI'
    set Q' : MvPolynomial (Fin n) A' :=
      ∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q with hQ'
    have hI'def : I' = Ideal.span {Q' - MvPolynomial.C (π' ^ 2)} := rfl
    have hπ'm : π' ∈ IsLocalRing.maximalIdeal A' := by
      rw [hπ']; exact Ideal.mem_span_singleton_self π'
    have hres : IsLocalRing.residue A' π' = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff]; exact hπ'm
    let ε : MvPolynomial (Fin n) A' →+* IsLocalRing.ResidueField A' :=
      (IsLocalRing.residue A').comp MvPolynomial.constantCoeff
    have hccQ : MvPolynomial.constantCoeff Q' = 0 := by
      rw [hQ']; simp
    have hεI : ∀ a ∈ I', ε a = 0 := by
      intro a ha
      rw [hI'def, Ideal.mem_span_singleton'] at ha
      obtain ⟨b, rfl⟩ := ha
      rw [map_mul]
      show ε b * IsLocalRing.residue A'
        (MvPolynomial.constantCoeff (Q' - MvPolynomial.C (π' ^ 2))) = 0
      rw [map_sub, hccQ, MvPolynomial.constantCoeff_C, zero_sub, map_neg, map_pow, hres,
        zero_pow two_ne_zero, neg_zero, mul_zero]
    let εb : MvPolynomial (Fin n) A' ⧸ I' →+* IsLocalRing.ResidueField A' :=
      Ideal.Quotient.lift I' ε hεI
    have hεb : ∀ f, εb (Ideal.Quotient.mk I' f) =
        IsLocalRing.residue A' (MvPolynomial.constantCoeff f) :=
      fun f => Ideal.Quotient.lift_mk _ _ _
    have hsurj : Function.Surjective εb := by
      intro y
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
      exact ⟨Ideal.Quotient.mk I' (MvPolynomial.C a), by rw [hεb, MvPolynomial.constantCoeff_C]⟩
    have hmax : (RingHom.ker εb).IsMaximal := RingHom.ker_isMaximal_of_surjective εb hsurj
    set J := Ideal.span (Set.range (wcQmbtGen A' n π' c')) with hJ
    have hgenJ : ∀ k, wcQmbtGen A' n π' c' k ∈ J := fun k => Ideal.subset_span ⟨k, rfl⟩
    have hXJ : ∀ p, Ideal.Quotient.mk I' (MvPolynomial.X p) ∈ J := fun p => hgenJ (some p)
    have hπJ : Ideal.Quotient.mk I' (MvPolynomial.C π') ∈ J := hgenJ none
    have h1 : J ≤ RingHom.ker εb := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      cases k with
      | none =>
        show εb (Ideal.Quotient.mk I' (MvPolynomial.C π')) = 0
        rw [hεb, MvPolynomial.constantCoeff_C, hres]
      | some p =>
        show εb (Ideal.Quotient.mk I' (MvPolynomial.X p)) = 0
        rw [hεb, MvPolynomial.constantCoeff_X, map_zero]
    have hdec : ∀ f : MvPolynomial (Fin n) A',
        Ideal.Quotient.mk I' f -
          Ideal.Quotient.mk I' (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
      intro f
      induction f using MvPolynomial.induction_on
      next a =>
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact J.zero_mem
      next p q hp hq =>
        have := J.add_mem hp hq
        simp only [map_add]
        convert this using 1
        ring
      next p i _ =>
        simp only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, MvPolynomial.C_0, map_zero,
          sub_zero]
        exact J.mul_mem_left _ (hXJ i)
    have h2 : RingHom.ker εb ≤ J := by
      intro r hr
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [RingHom.mem_ker, hεb, IsLocalRing.residue_eq_zero_iff, hπ',
        Ideal.mem_span_singleton'] at hr
      obtain ⟨a, ha⟩ := hr
      have hC : Ideal.Quotient.mk I' (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
        rw [← ha, MvPolynomial.C_mul, map_mul]
        exact J.mul_mem_left _ hπJ
      have := J.add_mem (hdec f) hC
      rwa [sub_add_cancel] at this
    rw [le_antisymm h1 h2]
    exact hmax

  have hJo : Ideal.span (Set.range (wcQmbtGen A' n π' c')) = o.asIdeal := by
    refine hJmax.eq_of_le (PrimeSpectrum.isPrime o).ne_top ?_
    rw [Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    exact ho k

  choose φs hφs using fun j => wc_qmbt_bm_chart_algebra hπ' c' j
  obtain ⟨φ0, hφ0⟩ := wc_qmbt_bm_chart_algebra_none hπ' c'
  let Φ : ∀ k, CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶
      wcQmbtCharts A' n π' c' k := fun k =>
    Option.rec (motive := fun k => CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶
      wcQmbtCharts A' n π' c' k) (CommRingCat.ofHom φ0)
      (fun j => CommRingCat.ofHom (φs j)) k
  have hgenk : ∀ k, Ideal.map (Φ k).hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
      Ideal.span {(Φ k).hom (wcQmbtGen A' n π' c' k)} := fun k => by
    cases k with
    | none => exact hφ0.2.2.2.1
    | some j => exact (hφs j).2.2.2.1
  obtain ⟨e, he_open, he_comp, he_cover⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))
    (wcQmbtGen A' n π' c') r₁ hr (wcQmbtCharts A' n π' c') Φ
    (fun k => by cases k with
      | none => exact hφ0.2.2.1
      | some j => exact (hφs j).2.2.1)
    hgenk
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.2
      | some j => exact (hφs j).2.2.2.2)

  have hcrit : ∀ k (y : Spec (wcQmbtCharts A' n π' c' k)),
      r₁ (e k y) = o ↔ (Φ k).hom (wcQmbtGen A' n π' c' k) ∈ y.asIdeal := by
    intro k y
    have h1 : r₁ (e k y) = Spec.map (Φ k) y := by
      rw [← he_comp k, Scheme.Hom.comp_apply]
    have h2 : (Spec.map (Φ k) y).asIdeal = Ideal.comap (Φ k).hom y.asIdeal := rfl
    rw [h1]
    constructor
    · intro h
      have hm : wcQmbtGen A' n π' c' k ∈ (Spec.map (Φ k) y).asIdeal := by
        rw [h]; exact ho k
      rw [h2] at hm
      exact hm
    · intro h
      apply PrimeSpectrum.ext
      rw [h2, ← hJo]
      have hle : Ideal.span (Set.range (wcQmbtGen A' n π' c')) ≤
          Ideal.comap (Φ k).hom y.asIdeal := by
        rw [← Ideal.map_le_iff_le_comap, hgenk k, Ideal.span_le, Set.singleton_subset_iff]
        exact h
      exact (hJmax.eq_of_le (Ideal.comap_ne_top _ (PrimeSpectrum.isPrime y).ne_top) hle).symm

  have hb0 : (Φ none).hom (wcQmbtGen A' n π' c' none) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π') := by
    show φ0 (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') = _
    rw [← RingHom.comp_apply, hφ0.2.1]
    rfl
  have hbj : ∀ j, (Φ (some j)).hom (wcQmbtGen A' n π' c' (some j)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) := by
    intro j
    show φs j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j)) = _
    rw [(hφs j).1 j]
    simp [wcQmbtChartHat]
  have hP0 := wc_qmbt_hlsc_chart_none_prime hπ' hn hc'
  have hPj := fun j => wc_qmbt_hlsc_chart_some_prime hπ' hn hc' j
  let P0 : Spec (wcQmbtCharts A' n π' c' none) :=
    (⟨_, hP0⟩ : PrimeSpectrum (wcQmbtChartNone A' n c'))
  let Pj : ∀ j, Spec (wcQmbtCharts A' n π' c' (some j)) := fun j =>
    (⟨_, (hPj j).1⟩ : PrimeSpectrum (wcQmbtChart A' n π' c' j))
  have hη0 : r₁ (e none P0) = o := by
    rw [hcrit, hb0]
    exact Ideal.mem_span_singleton_self _
  have hηj : ∀ j, r₁ (e (some j) (Pj j)) = o := by
    intro j
    rw [hcrit, hbj]
    exact Ideal.mem_span_singleton_self _

  have hspec0 : ∀ y0 : Spec (wcQmbtCharts A' n π' c' none), r₁ (e none y0) = o →
      e none P0 ⤳ e none y0 := by
    intro y0 hy0
    have hy := (hcrit none y0).mp hy0
    rw [hb0] at hy
    have hle : P0.asIdeal ≤ y0.asIdeal :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy)
    exact ((PrimeSpectrum.le_iff_specializes P0 y0).mp hle).map (e none).continuous
  have hspec : ∀ z ∈ r₁ ⁻¹' {o}, e none P0 ⤳ z := by
    intro z hz
    obtain ⟨k, y, rfl⟩ := he_cover z
    have hz' : r₁ (e k y) = o := hz
    cases k with
    | none => exact hspec0 y hz'
    | some j =>
      have hy := (hcrit (some j) y).mp hz'
      rw [hbj] at hy
      have hle : (Pj j).asIdeal ≤ y.asIdeal :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy)
      have hsp : e (some j) (Pj j) ⤳ e (some j) y :=
        ((PrimeSpectrum.le_iff_specializes (Pj j) y).mp hle).map (e (some j)).continuous
      obtain ⟨y0, hy0⟩ := wc_qmbt_hlsc_chart_overlap r₁ hr j (φs j) (hφs j).1 (hφs j).2.1
        (hφs j).2.2.1 (hφs j).2.2.2.1 φ0 hφ0.2.2.2.2 (e (some j)) (he_comp (some j))
        (e none) (he_comp none) (Pj j) (hPj j).2
      have hy0o : r₁ (e none y0) = o := (congrArg r₁ hy0).trans (hηj j)
      have h3 := hspec0 y0 hy0o
      exact (h3.trans (specializes_of_eq hy0)).trans hsp

  intro U V hU hV hUne hVne
  obtain ⟨u, huE, huU⟩ := hUne
  obtain ⟨v, hvE, hvV⟩ := hVne
  exact ⟨e none P0, hη0, (hspec u huE).mem_open hU huU, (hspec v hvE).mem_open hV hvV⟩

theorem wc_qmbt_sfh_cf_exc_nonempty {A : Type u} [CommRing A] [IsLocalRing A] {π : A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) {n : ℕ} (hn : 2 ≤ n)
    {c : Matrix (Fin n) (Fin n) A} {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det)
    (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
    (hθX : ∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p))
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k)))) r₁) :
    ∃ x₁ : X₁, Spec.map (CommRingCat.ofHom θ) (r₁ x₁) = x₀ :=
by
  classical
  choose φs hφs using fun j => wc_qmbt_bm_chart_algebra hπ' (c.map ιA) j
  obtain ⟨φ0, hφ0⟩ := wc_qmbt_bm_chart_algebra_none hπ' (c.map ιA)
  let Φ : ∀ k, CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k := fun k =>
    Option.rec (motive := fun k => CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k) (CommRingCat.ofHom φ0)
      (fun j => CommRingCat.ofHom (φs j)) k
  obtain ⟨e, -, he_comp, -⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ hr (wcQmbtCharts A' n π' (c.map ιA)) Φ
    (fun k => by cases k with
      | none => exact hφ0.2.2.1
      | some j => exact (hφs j).2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.1
      | some j => exact (hφs j).2.2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.2
      | some j => exact (hφs j).2.2.2.2)
  obtain ⟨j₀, y₀0, -, hx₀'⟩ := wc_qmbt_bm_origin_point hπ' hn hc'
  let y₀ : ↥(Spec (wcQmbtCharts A' n π' (c.map ιA) (some j₀))) := y₀0
  have hθz : Spec.map (CommRingCat.ofHom θ) (Spec.map (CommRingCat.ofHom (φs j₀)) y₀) = x₀ := by
    have hmax := wc_qmbt_bm_origin_maximal hπ n c
    apply PrimeSpectrum.ext
    have hA : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤
        PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ)
          (Spec.map (CommRingCat.ofHom (φs j₀)) y₀)) := by
      rw [Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      show φs j₀ (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ∈
        PrimeSpectrum.asIdeal y₀0
      rw [hθX p, (hφs j₀).1 p, map_mul]
      exact Ideal.mul_mem_right _ _ hx₀'
    have hB : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤
        PrimeSpectrum.asIdeal x₀ := by
      rw [Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      exact hx₀ p
    rw [← hmax.eq_of_le (Ideal.IsPrime.ne_top (PrimeSpectrum.isPrime _)) hA,
      hmax.eq_of_le (Ideal.IsPrime.ne_top (PrimeSpectrum.isPrime _)) hB]
  have hr' : r₁ (e (some j₀) y₀) = Spec.map (CommRingCat.ofHom (φs j₀)) y₀ := by
    rw [← Scheme.Hom.comp_apply, he_comp (some j₀)]
    rfl
  exact ⟨e (some j₀) y₀, by rw [hr']; exact hθz⟩

theorem wc_qmbt_sfh_closed_fibre_connected {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    ConnectedSpace ↥(Limits.pullback (C := Scheme.{u}) (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) :=
by
  classical

  obtain ⟨θ, X₁, r₁, ψ, hθX, hθA, hr₁, hsq⟩ := wc_qmbt_hlsc_model_square hsh hπ'2 hbl
  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have h1 : c.map ιA + (c.map ιA).transpose = (c + c.transpose).map ιA := by
      ext i j
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hc.map ιA

  obtain ⟨o, ho, hoθ⟩ := wc_qmbt_hlsc_theta_fibre hπ hx₀ hπ' hπ'2 θ hθX hθA

  have hE₁ := wc_qmbt_hlsc_exc_irred hπ' (by omega) hc' r₁ hr₁ o ho
  have h₁ : IsPreirreducible ((r₁ ≫ Spec.map (CommRingCat.ofHom θ)) ⁻¹' {x₀}) := by
    have e : (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) ⁻¹' {x₀} = r₁ ⁻¹' {o} := by
      ext z
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
      exact hoθ (r₁ z)
    rw [e]
    exact hE₁

  obtain ⟨hcp, huniq, hiso⟩ := wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh

  have h₂ := wc_qmbt_hlsc_fibre_transfer hsq x₀ hiso h₁
  have hEm : (fun w : Xm => a₀ ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) w)) ⁻¹' {x₀} =
      (fun w : Xm => (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹' {IsLocalRing.closedPoint B₀} := by
    ext w
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨huniq _, fun h => by rw [h]; exact hcp⟩
  have h₂' : IsPreirreducible ((fun w : Xm => (bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹'
      {IsLocalRing.closedPoint B₀}) := by
    rw [← hEm]
    exact h₂

  have hstr : (wcQuadModelStr A n π c) x₀ = IsLocalRing.closedPoint A := by
    have hπmem : π ∈ Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
        (PrimeSpectrum.asIdeal x₀) := by
      rw [Ideal.mem_comap]
      have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
          algebraMap A (wcQuadModelRing A n π c) π := by
        change _ = Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π)
        exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [← hrel, map_sum]
      refine Ideal.sum_mem _ fun p _ => ?_
      rw [map_sum]
      refine Ideal.sum_mem _ fun q _ => ?_
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hx₀ q)
    have hcomap : Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
        (PrimeSpectrum.asIdeal x₀) = IsLocalRing.maximalIdeal A := by
      refine ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le
        (Ideal.comap_ne_top _ (PrimeSpectrum.isPrime x₀).ne_top) ?_).symm
      rw [hπ, Ideal.span_singleton_le_iff_mem]
      exact hπmem
    apply PrimeSpectrum.ext
    exact hcomap

  have hrange : (fun w : Xm => (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹' {IsLocalRing.closedPoint B₀} ⊆
      Set.range ι' := by
    intro z hz
    have hz2 : Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) (bl z) = IsLocalRing.closedPoint B₀ := by
      have h0 := hz
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply] at h0
      exact h0
    have e1 : (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ≫ wcQuadModelStr A n π c) (bl z) =
        (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ≫ Spec.map (CommRingCat.ofHom ιA)) (bl z) := by
      rw [Limits.pullback.condition]
    simp only [Scheme.Hom.comp_apply] at e1
    rw [hz2, hcp, hstr] at e1
    have hπ'y : π' ∈ PrimeSpectrum.asIdeal (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) (bl z)) := by
      have h1 : π ∈ Ideal.comap ιA (PrimeSpectrum.asIdeal
          (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) (bl z))) := by
        have h3 := congrArg PrimeSpectrum.asIdeal e1
        change IsLocalRing.maximalIdeal A = Ideal.comap ιA (PrimeSpectrum.asIdeal
          (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) (bl z))) at h3
        rw [← h3, hπ]
        exact Ideal.mem_span_singleton_self π
      rw [Ideal.mem_comap, ← hπ'2] at h1
      exact (PrimeSpectrum.isPrime _).mem_of_pow_mem 2 h1
    have hfz : f z = IsLocalRing.closedPoint A' := by
      rw [← hblf, Scheme.Hom.comp_apply]
      apply PrimeSpectrum.ext
      change PrimeSpectrum.asIdeal (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) (bl z)) = IsLocalRing.maximalIdeal A'
      refine ((IsLocalRing.maximalIdeal.isMaximal A').eq_of_le
        (PrimeSpectrum.isPrime _).ne_top ?_).symm
      rw [hπ', Ideal.span_singleton_le_iff_mem]
      exact hπ'y
    obtain ⟨t0⟩ : Nonempty (PrimeSpectrum (IsLocalRing.ResidueField A')) := inferInstance
    let t : ↥(Spec (CommRingCat.of (IsLocalRing.ResidueField A'))) := t0
    have ht : wcQmSp A' t = IsLocalRing.closedPoint A' := by
      apply PrimeSpectrum.ext
      change Ideal.comap (IsLocalRing.residue A') (PrimeSpectrum.asIdeal t0) =
        IsLocalRing.maximalIdeal A'
      have hbot : PrimeSpectrum.asIdeal t0 = ⊥ :=
        (Ideal.eq_bot_or_top _).resolve_right (PrimeSpectrum.isPrime t0).ne_top
      rw [hbot, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    obtain ⟨z', hz'1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f)
      (g := wcQmSp A') z t (hfz.trans ht.symm)
    refine ⟨hps'.isoPullback.inv z', ?_⟩
    rw [← Scheme.Hom.comp_apply, hps'.isoPullback_inv_fst]
    exact hz'1

  haveI : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip inferInstance
  have hind : Topology.IsInducing ι' :=
    (IsClosedImmersion.isClosedEmbedding ι').toIsEmbedding.toIsInducing
  have hpre : ∀ S : Set Xm, S ⊆ Set.range ι' → IsPreirreducible S →
      IsPreirreducible (ι' ⁻¹' S) := by
    intro S hSr hS U V hU hV hSU hSV
    obtain ⟨u, huS, huU⟩ := hSU
    obtain ⟨v, hvS, hvV⟩ := hSV
    obtain ⟨U', hU', rfl⟩ := hind.isOpen_iff.mp hU
    obtain ⟨V', hV', rfl⟩ := hind.isOpen_iff.mp hV
    obtain ⟨y, hyS, hyU, hyV⟩ := hS U' V' hU' hV' ⟨ι' u, huS, huU⟩ ⟨ι' v, hvS, hvV⟩
    obtain ⟨x, rfl⟩ := hSr hyS
    exact ⟨x, hyS, hyU, hyV⟩
  have hZ2 : IsPreirreducible ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹'
      {IsLocalRing.closedPoint B₀}) := by
    have heq : (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹'
        {IsLocalRing.closedPoint B₀} =
        ι' ⁻¹' ((fun w : Xm => (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹' {IsLocalRing.closedPoint B₀}) := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
    rw [heq]
    exact hpre _ hrange h₂'

  have hρpt : ∀ t : ↥(Spec (CommRingCat.of (IsLocalRing.ResidueField B₀))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) t = IsLocalRing.closedPoint B₀ := by
    intro t
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue B₀) (PrimeSpectrum.asIdeal t) =
      IsLocalRing.maximalIdeal B₀
    have hbot : PrimeSpectrum.asIdeal t = ⊥ :=
      (Ideal.eq_bot_or_top _).resolve_right (PrimeSpectrum.isPrime t).ne_top
    rw [hbot, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
  obtain ⟨tB0⟩ : Nonempty (PrimeSpectrum (IsLocalRing.ResidueField B₀)) := inferInstance
  let tB : ↥(Spec (CommRingCat.of (IsLocalRing.ResidueField B₀))) := tB0
  haveI hρci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hpfci : IsClosedImmersion (Limits.pullback.fst (C := Scheme.{u})
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback _ _).flip hρci
  have hpfind : Topology.IsInducing (Limits.pullback.fst (C := Scheme.{u})
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) :=
    (IsClosedImmersion.isClosedEmbedding _).toIsEmbedding.toIsInducing
  have hrng : Set.range (Limits.pullback.fst (C := Scheme.{u})
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) =
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹'
        {IsLocalRing.closedPoint B₀} := by
    rw [Scheme.Pullback.range_fst]
    ext x
    simp only [Set.mem_preimage, Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨t, ht⟩
      exact ht.symm.trans (hρpt t)
    · intro hx
      exact ⟨tB, (hρpt tB).trans hx.symm⟩

  have hpc : PreconnectedSpace ↥(Limits.pullback (C := Scheme.{u}) (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) := by
    constructor
    have h1 : _root_.IsPreconnected ((Limits.pullback.fst (C := Scheme.{u})
        (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)))
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) '' Set.univ) := by
      rw [Set.image_univ, hrng]
      exact hZ2.isPreconnected
    exact hpfind.isPreconnected_image.mp h1

  obtain ⟨x₁, hx₁⟩ := wc_qmbt_sfh_cf_exc_nonempty hπ (by omega) hx₀ hπ' hc' θ hθX r₁ hr₁
  have e1 : (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) x₁ = a₀ (IsLocalRing.closedPoint B₀) := by
    rw [Scheme.Hom.comp_apply, hx₁, hcp]
  obtain ⟨w, -, hw2⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := r₁ ≫ Spec.map (CommRingCat.ofHom θ)) (g := a₀) x₁ _ e1
  have hz : (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (hsq.isoPullback.inv w) =
      IsLocalRing.closedPoint B₀ := by
    rw [← Scheme.Hom.comp_apply, hsq.isoPullback_inv_snd]
    exact hw2
  have hzmem : hsq.isoPullback.inv w ∈ (fun w : Xm => (bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹'
      {IsLocalRing.closedPoint B₀} := hz
  obtain ⟨x', hx'⟩ := hrange hzmem
  have hβx : (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) x' =
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) tB := by
    rw [Scheme.Hom.comp_apply, hx', hz, hρpt]
  obtain ⟨pt, -, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (g := Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) x' tB hβx
  exact { toPreconnectedSpace := hpc, toNonempty := ⟨pt⟩ }

theorem wc_qmbt_sfp_model_square_P {A : Type u} [CommRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ'2 : π' ^ 2 = ιA π)
    {Xm : Scheme.{u}}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl) :
    ∃ (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
      (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
      (gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
      (ψ : Xm ⟶ X₁),
      (∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p)) ∧
      θ.comp (algebraMap A (wcQuadModelRing A n π c)) =
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))).comp ιA ∧
      IsPullback (Spec.map (CommRingCat.ofHom θ))
        (Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
        (wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ∧
      wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (wcQmbtGen A' n π' (c.map ιA) k)))) r₁ ∧
      gP ≫ Spec.map (CommRingCat.ofHom θ) =
        Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) ∧
      IsPullback ψ bl r₁ gP :=
by
  classical

  obtain ⟨θ, hθX, hθA, sq₁⟩ := wc_qmbt_bm_quad_pullback ιA n π c π' hπ'2
  obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      gP ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
    ⟨sq₁.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
  have sqL : IsPullback (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) gP a₀ (Spec.map (CommRingCat.ofHom θ)) := by
    refine IsPullback.of_bot ?_ hgP1.symm sq₁
    rw [hgP2]
    exact IsPullback.of_hasPullback _ _
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hgPw : WeaklyEtale gP := MorphismProperty.of_isPullback (P := @WeaklyEtale) sqL ha₀

  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) :=
    inferInstance
  obtain ⟨X₁, r₁, hb₁, -⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k))))

  haveI hgPflat : Flat gP := hgPw.flat
  haveI hPaff : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    dsimp only [wcQuadModelStr]
    infer_instance
  have hbl₀ := wc_qmbt_bm_flat_base_change
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ gP hb₁
  have hblP : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))))))
      (Limits.pullback.snd r₁ gP) := by
    convert hbl₀ using 4
    funext i
    cases i with
    | none =>
      show (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π') =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π'))
      rw [← hgP2, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
      congr 1
      have := congrArg (fun φ => φ.hom π') (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    | some j =>
      show ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))) =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X j)))
      rw [← hgP1, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, ← hθX j]
      congr 1
      have := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X j))) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm

  obtain ⟨φ, hφ⟩ := (hblP.2 Xm bl hbl.1).exists
  obtain ⟨χ, hχ⟩ := (hbl.2 _ (Limits.pullback.snd r₁ gP) hblP.1).exists
  have h1 : φ ≫ χ = 𝟙 Xm := by
    apply (hbl.2 Xm bl hbl.1).unique
    · show (φ ≫ χ) ≫ bl = bl
      rw [Category.assoc, hχ, hφ]
    · show 𝟙 Xm ≫ bl = bl
      exact Category.id_comp _
  have h2 : χ ≫ φ = 𝟙 _ := by
    apply (hblP.2 _ (Limits.pullback.snd r₁ gP) hblP.1).unique
    · show (χ ≫ φ) ≫ Limits.pullback.snd r₁ gP = Limits.pullback.snd r₁ gP
      rw [Category.assoc, hφ, hχ]
    · show 𝟙 _ ≫ Limits.pullback.snd r₁ gP = Limits.pullback.snd r₁ gP
      exact Category.id_comp _
  haveI : IsIso φ := ⟨⟨χ, h1, h2⟩⟩

  have sqT : IsPullback (φ ≫ Limits.pullback.fst r₁ gP) bl r₁ gP :=
    IsPullback.of_iso_pullback
      ⟨by rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hφ]⟩
      (asIso φ) rfl hφ
  exact ⟨θ, X₁, r₁, gP, φ ≫ Limits.pullback.fst r₁ gP, hθX, hθA, sq₁, hb₁, hgP1, hgP2, sqT⟩

theorem wc_qmbt_sfp_fibre_paste {P B A' A₀ K' W W₀ Xm Xs' : Scheme.{u}}
    {p : P ⟶ B} {q : P ⟶ A'} {u : B ⟶ A₀} {v : A' ⟶ A₀} (hP : IsPullback p q u v)
    (bl : Xm ⟶ P) (sp : K' ⟶ A') [Mono (sp ≫ v)]
    {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ K'} (hps : IsPullback ι' s' (bl ≫ q) sp)
    (ρ₀ : W₀ ⟶ B) (ιΩ : W ⟶ W₀) (lam : W ⟶ K') (ν : W ⟶ P)
    (hν1 : ν ≫ p = ιΩ ≫ ρ₀) (hν2 : ν ≫ q = lam ≫ sp) :
    IsPullback (Limits.pullback.fst (Limits.pullback.snd (ι' ≫ bl ≫ p) ρ₀) ιΩ ≫
        Limits.pullback.fst (ι' ≫ bl ≫ p) ρ₀ ≫ ι')
      (Limits.pullback.snd (Limits.pullback.snd (ι' ≫ bl ≫ p) ρ₀) ιΩ) bl ν :=
by
  have gen : ∀ {Q₁ Q : Scheme.{u}} (f₁ : Q₁ ⟶ Xs') (t₁ : Q₁ ⟶ W₀)
      (h1 : IsPullback f₁ t₁ (ι' ≫ bl ≫ p) ρ₀) (a : Q ⟶ Q₁) (b : Q ⟶ W)
      (h2 : IsPullback a b t₁ ιΩ), IsPullback (a ≫ f₁ ≫ ι') b bl ν := by
    intro Q₁ Q f₁ t₁ h1 a b h2
    have E1 : f₁ ≫ ι' ≫ bl ≫ p = t₁ ≫ ρ₀ := h1.w
    have E2 : a ≫ t₁ = b ≫ ιΩ := h2.w
    have E3 : p ≫ u = q ≫ v := hP.w
    have E4 : ι' ≫ bl ≫ q = s' ≫ sp := hps.w
    have E5 : a ≫ f₁ ≫ ι' ≫ bl ≫ p = b ≫ ν ≫ p := by
      calc a ≫ f₁ ≫ ι' ≫ bl ≫ p = a ≫ t₁ ≫ ρ₀ := by rw [E1]
        _ = (a ≫ t₁) ≫ ρ₀ := (Category.assoc _ _ _).symm
        _ = (b ≫ ιΩ) ≫ ρ₀ := by rw [E2]
        _ = b ≫ ιΩ ≫ ρ₀ := Category.assoc _ _ _
        _ = b ≫ ν ≫ p := by rw [hν1]
    have K : a ≫ f₁ ≫ s' = b ≫ lam := by
      rw [← cancel_mono (sp ≫ v)]
      calc (a ≫ f₁ ≫ s') ≫ sp ≫ v = a ≫ f₁ ≫ (s' ≫ sp) ≫ v := by simp only [Category.assoc]
        _ = a ≫ f₁ ≫ (ι' ≫ bl ≫ q) ≫ v := by rw [E4]
        _ = a ≫ f₁ ≫ ι' ≫ bl ≫ (q ≫ v) := by simp only [Category.assoc]
        _ = a ≫ f₁ ≫ ι' ≫ bl ≫ (p ≫ u) := by rw [E3]
        _ = (a ≫ f₁ ≫ ι' ≫ bl ≫ p) ≫ u := by simp only [Category.assoc]
        _ = (b ≫ ν ≫ p) ≫ u := by rw [E5]
        _ = b ≫ ν ≫ (p ≫ u) := by simp only [Category.assoc]
        _ = b ≫ ν ≫ (q ≫ v) := by rw [E3]
        _ = b ≫ (ν ≫ q) ≫ v := by simp only [Category.assoc]
        _ = b ≫ (lam ≫ sp) ≫ v := by rw [hν2]
        _ = (b ≫ lam) ≫ sp ≫ v := by simp only [Category.assoc]
    have hcomm : CommSq (a ≫ f₁ ≫ ι') b bl ν := ⟨by
      apply hP.hom_ext
      · simp only [Category.assoc]; exact E5
      · calc (a ≫ f₁ ≫ ι') ≫ bl ≫ q = a ≫ f₁ ≫ (ι' ≫ bl ≫ q) := by simp only [Category.assoc]
          _ = a ≫ f₁ ≫ (s' ≫ sp) := by rw [E4]
          _ = (a ≫ f₁ ≫ s') ≫ sp := by simp only [Category.assoc]
          _ = (b ≫ lam) ≫ sp := by rw [K]
          _ = b ≫ (lam ≫ sp) := Category.assoc _ _ _
          _ = b ≫ (ν ≫ q) := by rw [hν2]
          _ = (b ≫ ν) ≫ q := (Category.assoc _ _ _).symm⟩
    have hzw : ∀ s : Limits.PullbackCone bl ν, s.fst ≫ bl ≫ q = (s.snd ≫ lam) ≫ sp := by
      intro s
      calc s.fst ≫ bl ≫ q = (s.fst ≫ bl) ≫ q := (Category.assoc _ _ _).symm
        _ = (s.snd ≫ ν) ≫ q := by rw [s.condition]
        _ = s.snd ≫ (ν ≫ q) := Category.assoc _ _ _
        _ = s.snd ≫ (lam ≫ sp) := by rw [hν2]
        _ = (s.snd ≫ lam) ≫ sp := (Category.assoc _ _ _).symm
    let z : ∀ s : Limits.PullbackCone bl ν, s.pt ⟶ Xs' := fun s =>
      hps.lift s.fst (s.snd ≫ lam) (hzw s)
    have hz1 : ∀ s, z s ≫ ι' = s.fst := fun s => hps.lift_fst _ _ _
    have hz2 : ∀ s, z s ≫ s' = s.snd ≫ lam := fun s => hps.lift_snd _ _ _
    have hyw : ∀ s : Limits.PullbackCone bl ν, z s ≫ ι' ≫ bl ≫ p = (s.snd ≫ ιΩ) ≫ ρ₀ := by
      intro s
      calc z s ≫ ι' ≫ bl ≫ p = (z s ≫ ι') ≫ bl ≫ p := (Category.assoc _ _ _).symm
        _ = s.fst ≫ bl ≫ p := by rw [hz1]
        _ = (s.fst ≫ bl) ≫ p := (Category.assoc _ _ _).symm
        _ = (s.snd ≫ ν) ≫ p := by rw [s.condition]
        _ = s.snd ≫ (ν ≫ p) := Category.assoc _ _ _
        _ = s.snd ≫ (ιΩ ≫ ρ₀) := by rw [hν1]
        _ = (s.snd ≫ ιΩ) ≫ ρ₀ := (Category.assoc _ _ _).symm
    let y₁ : ∀ s : Limits.PullbackCone bl ν, s.pt ⟶ Q₁ := fun s =>
      h1.lift (z s) (s.snd ≫ ιΩ) (hyw s)
    have hy1 : ∀ s, y₁ s ≫ f₁ = z s := fun s => h1.lift_fst _ _ _
    have hy2 : ∀ s, y₁ s ≫ t₁ = s.snd ≫ ιΩ := fun s => h1.lift_snd _ _ _
    let lift : ∀ s : Limits.PullbackCone bl ν, s.pt ⟶ Q := fun s =>
      h2.lift (y₁ s) s.snd (hy2 s)
    have hl1 : ∀ s, lift s ≫ a = y₁ s := fun s => h2.lift_fst _ _ _
    have hl2 : ∀ s, lift s ≫ b = s.snd := fun s => h2.lift_snd _ _ _
    have fac1 : ∀ s : Limits.PullbackCone bl ν, lift s ≫ a ≫ f₁ ≫ ι' = s.fst := by
      intro s
      calc lift s ≫ a ≫ f₁ ≫ ι' = ((lift s ≫ a) ≫ f₁) ≫ ι' := by simp only [Category.assoc]
        _ = s.fst := by rw [hl1, hy1, hz1]
    have U : ∀ {T : Scheme.{u}} (m m' : T ⟶ Q), m ≫ a ≫ f₁ ≫ ι' = m' ≫ a ≫ f₁ ≫ ι' →
        m ≫ b = m' ≫ b → m = m' := by
      intro T m m' h₁ h₂
      apply h2.hom_ext
      · apply h1.hom_ext
        · apply hps.hom_ext
          · simpa only [Category.assoc] using h₁
          · calc ((m ≫ a) ≫ f₁) ≫ s' = m ≫ (a ≫ f₁ ≫ s') := by simp only [Category.assoc]
              _ = m ≫ (b ≫ lam) := by rw [K]
              _ = (m ≫ b) ≫ lam := (Category.assoc _ _ _).symm
              _ = (m' ≫ b) ≫ lam := by rw [h₂]
              _ = m' ≫ (b ≫ lam) := Category.assoc _ _ _
              _ = m' ≫ (a ≫ f₁ ≫ s') := by rw [K]
              _ = ((m' ≫ a) ≫ f₁) ≫ s' := by simp only [Category.assoc]
        · calc (m ≫ a) ≫ t₁ = m ≫ (a ≫ t₁) := Category.assoc _ _ _
            _ = m ≫ (b ≫ ιΩ) := by rw [E2]
            _ = (m ≫ b) ≫ ιΩ := (Category.assoc _ _ _).symm
            _ = (m' ≫ b) ≫ ιΩ := by rw [h₂]
            _ = m' ≫ (b ≫ ιΩ) := Category.assoc _ _ _
            _ = m' ≫ (a ≫ t₁) := by rw [E2]
            _ = (m' ≫ a) ≫ t₁ := (Category.assoc _ _ _).symm
      · exact h₂
    exact ⟨hcomm, ⟨Limits.PullbackCone.IsLimit.mk hcomm.w lift fac1 hl2
      (fun s m hm1 hm2 => U m (lift s) (hm1.trans (fac1 s).symm) (hm2.trans (hl2 s).symm))⟩⟩
  exact gen _ _ (IsPullback.of_hasPullback _ _) _ _ (IsPullback.of_hasPullback _ _)

theorem wc_qmbt_sfp_origin_char {A : Type u} [CommRing A] [IsLocalRing A] {π : A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) {n : ℕ} {c : Matrix (Fin n) (Fin n) A}
    {A' : Type u} [CommRing A'] [IsLocalRing A'] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (hπ'2 : π' ^ 2 = ιA π)
    (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {K : Type u} [Field K] (ω₀ : wcQuadModelRing A n π c →+* K)
    (hω₀ : ∀ p, ω₀ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0) :
    ∃ (lam : IsLocalRing.ResidueField A' →+* K)
      (ω : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* K),
      (∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p)) = 0) ∧
      ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
        lam.comp (IsLocalRing.residue A') ∧
      (lam.comp (IsLocalRing.residue A')).comp ιA = ω₀.comp (algebraMap A (wcQuadModelRing A n π c)) ∧
      ∀ θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA),
        (∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
          Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p)) →
        θ.comp (algebraMap A (wcQuadModelRing A n π c)) =
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))).comp ιA →
        ω.comp θ = ω₀ :=
by
  classical

  let μ₀ : A →+* K := ω₀.comp (algebraMap A (wcQuadModelRing A n π c))
  have hμπ : μ₀ π = 0 := by
    have hmem : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π : MvPolynomial (Fin n) A) ∈ wcQuadModelIdeal A n π c :=
      Ideal.mem_span_singleton_self _
    have h0 : ω₀ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π)) = 0 := by
      rw [(Ideal.Quotient.eq_zero_iff_mem).mpr hmem, map_zero]
    simp only [map_sub, map_sum, map_mul, hω₀, mul_zero, Finset.sum_const_zero,
      zero_sub, neg_eq_zero] at h0
    exact h0
  have hmA : ∀ a ∈ IsLocalRing.maximalIdeal A, μ₀ a = 0 := by
    intro a ha
    rw [hπ, Ideal.mem_span_singleton'] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [map_mul, hμπ, mul_zero]

  haveI : IsLocalHom μ₀ := ⟨fun a ha => by
    by_contra h
    have hm : a ∈ IsLocalRing.maximalIdeal A :=
      (IsLocalRing.mem_maximalIdeal a).mpr (mem_nonunits_iff.mpr h)
    rw [hmA a hm] at ha
    exact not_isUnit_zero ha⟩

  have hπ'm : π' ∈ IsLocalRing.maximalIdeal A' := by
    rw [hπ']; exact Ideal.mem_span_singleton_self _
  haveI : IsLocalHom ιA := ⟨fun a ha => by
    by_contra h
    have hm : a ∈ IsLocalRing.maximalIdeal A :=
      (IsLocalRing.mem_maximalIdeal a).mpr (mem_nonunits_iff.mpr h)
    rw [hπ, Ideal.mem_span_singleton'] at hm
    obtain ⟨b, rfl⟩ := hm
    have h2 : ιA (b * π) ∈ IsLocalRing.maximalIdeal A' := by
      rw [map_mul, ← hπ'2, pow_two, ← mul_assoc]
      exact Ideal.mul_mem_left _ _ hπ'm
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h2)) ha⟩

  let μ : IsLocalRing.ResidueField A →+* K := IsLocalRing.ResidueField.lift μ₀
  let φ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A' :=
    IsLocalRing.ResidueField.map ιA
  have hφres : ∀ a : A, φ (IsLocalRing.residue A a) = IsLocalRing.residue A' (ιA a) :=
    fun a => IsLocalRing.ResidueField.map_residue ιA a
  have hbij : Function.Bijective φ := by
    refine ⟨RingHom.injective φ, fun z => ?_⟩
    obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective z
    obtain ⟨x, y, rfl⟩ := hgen a'
    refine ⟨IsLocalRing.residue A x, ?_⟩
    rw [hφres, map_add,
      (IsLocalRing.residue_eq_zero_iff _).mpr (Ideal.mul_mem_left _ _ hπ'm), add_zero]
  let eR := RingEquiv.ofBijective φ hbij

  let lam : IsLocalRing.ResidueField A' →+* K := μ.comp eR.symm.toRingHom
  have hconj3 : (lam.comp (IsLocalRing.residue A')).comp ιA =
      ω₀.comp (algebraMap A (wcQuadModelRing A n π c)) := by
    ext a
    have e1 : IsLocalRing.residue A' (ιA a) = eR (IsLocalRing.residue A a) := by
      rw [RingEquiv.ofBijective_apply, hφres]
    show μ (eR.symm (IsLocalRing.residue A' (ιA a))) = μ₀ a
    rw [e1, RingEquiv.symm_apply_apply]
    exact IsLocalRing.ResidueField.lift_residue_apply μ₀ a

  let ν : A' →+* K := lam.comp (IsLocalRing.residue A')
  have hνπ : ν π' = 0 := by
    show lam (IsLocalRing.residue A' π') = 0
    rw [(IsLocalRing.residue_eq_zero_iff _).mpr hπ'm, map_zero]
  let f : MvPolynomial (Fin n) A' →+* K := MvPolynomial.eval₂Hom ν (fun _ => 0)
  have hle : wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA) ≤ RingHom.ker f := by
    rw [wcQuadModelIdeal, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
      RingHom.mem_ker]
    simp [f, hνπ]
  have hI'f : ∀ a ∈ wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA), f a = 0 :=
    fun a ha => hle ha
  let ω : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* K := Ideal.Quotient.lift _ f hI'f
  have hconj1 : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA))
      (MvPolynomial.X p)) = 0 := by
    intro p
    show f (MvPolynomial.X p) = 0
    simp [f]
  have hconj2 : ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
      lam.comp (IsLocalRing.residue A') := by
    ext a
    show f (MvPolynomial.C a) = ν a
    simp [f]
  refine ⟨lam, ω, hconj1, hconj2, hconj3, ?_⟩

  intro θ hθX hθA
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro a
    have e1 := RingHom.congr_fun hθA a
    have e2 := RingHom.congr_fun hconj2 (ιA a)
    have e3 := RingHom.congr_fun hconj3 a
    simp only [RingHom.comp_apply] at e1 e2 e3
    show ω (θ (algebraMap A (wcQuadModelRing A n π c) a)) =
      ω₀ (algebraMap A (wcQuadModelRing A n π c) a)
    rw [e1, e2, e3]
  · intro p
    simp only [RingHom.comp_apply]
    rw [hθX p, hconj1 p, hω₀ p]

theorem wc_qmbt_bof_atlas {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} {c₁ : Matrix (Fin n) (Fin n) A'}
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c₁)))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv.hom
        (wcQmbtGen A' n π' c₁ k)))) r₁) :
    ∃ (φN : wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChartNone A' n c₁)
      (φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChart A' n π' c₁ j)
      (eN : Spec (.of (wcQmbtChartNone A' n c₁)) ⟶ X₁)
      (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c₁ j)) ⟶ X₁),
      (∀ p, φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.C π' * MvPolynomial.X p)) ∧
      φN.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChartNone A' n c₁) ∧
      Ideal.map φN (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
        Ideal.span {φN (wcQmbtGen A' n π' c₁ none)} ∧
      (∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁) ⟶ B),
        ρ.hom (wcQmbtGen A' n π' c₁ none) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
          Ideal.span {ρ.hom (wcQmbtGen A' n π' c₁ none)} →
        ∃! ψ : CommRingCat.of (wcQmbtChartNone A' n c₁) ⟶ B, CommRingCat.ofHom φN ≫ ψ = ρ) ∧
      (∀ j p, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
          (MvPolynomial.X (some j) * wcQmbtChartHat j p)) ∧
      (∀ j, (φ j).comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChart A' n π' c₁ j)) ∧
      (∀ j, φ j (wcQmbtGen A' n π' c₁ (some j)) ∈ nonZeroDivisors (wcQmbtChart A' n π' c₁ j)) ∧
      (∀ j, Ideal.map (φ j) (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
        Ideal.span {φ j (wcQmbtGen A' n π' c₁ (some j))}) ∧
      IsOpenImmersion eN ∧ (∀ j, IsOpenImmersion (e j)) ∧
      eN ≫ r₁ = Spec.map (CommRingCat.ofHom φN) ∧
      (∀ j, e j ≫ r₁ = Spec.map (CommRingCat.ofHom (φ j))) ∧
      ∀ x : X₁, x ∈ Set.range eN ∨ ∃ j y, e j y = x :=
by
  classical
  obtain ⟨φN, hNX, hNA, hNnzd, hNgen, hNup⟩ := wc_qmbt_bm_chart_algebra_none hπ' c₁
  choose φ hφX hφA hnzd hgen hup using fun j : Fin n => wc_qmbt_bm_chart_algebra hπ' c₁ j
  let φ' : ∀ k : Option (Fin n),
      CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁) ⟶ wcQmbtCharts A' n π' c₁ k :=
    fun k => match k with
      | none => CommRingCat.ofHom φN
      | some j => CommRingCat.ofHom (φ j)
  have hnzd' : ∀ k, (φ' k).hom (wcQmbtGen A' n π' c₁ k) ∈
      nonZeroDivisors (wcQmbtCharts A' n π' c₁ k) := by
    rintro (_ | j)
    · exact hNnzd
    · exact hnzd j
  have hgen' : ∀ k, Ideal.map (φ' k).hom (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
      Ideal.span {(φ' k).hom (wcQmbtGen A' n π' c₁ k)} := by
    rintro (_ | j)
    · exact hNgen
    · exact hgen j
  have hup' : ∀ k (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁) ⟶ B),
      ρ.hom (wcQmbtGen A' n π' c₁ k) ∈ nonZeroDivisors B →
      Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
        Ideal.span {ρ.hom (wcQmbtGen A' n π' c₁ k)} →
      ∃! ψ : wcQmbtCharts A' n π' c₁ k ⟶ B, φ' k ≫ ψ = ρ := by
    rintro (_ | j) B ρ h1 h2
    · exact hNup B ρ h1 h2
    · exact hup j B ρ h1 h2
  obtain ⟨e', heo, he, hcov⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁)) (wcQmbtGen A' n π' c₁) r₁ hr
    (wcQmbtCharts A' n π' c₁) φ' hnzd' hgen' hup'
  refine ⟨φN, φ, e' none, fun j => e' (some j), hNX, hNA, hNgen, hNup, hφX, hφA, hnzd, hgen,
    heo none, fun j => heo (some j), he none, fun j => he (some j), ?_⟩
  intro x
  obtain ⟨k, y, hy⟩ := hcov x
  cases k with
  | none => exact Or.inl ⟨y, hy⟩
  | some j => exact Or.inr ⟨j, y, hy⟩

theorem wc_qmbt_bof_chart_compl {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c₁ : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c₁)))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv.hom
        (wcQmbtGen A' n π' c₁ k)))) r₁)
    (φN : wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChartNone A' n c₁)
    (φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChart A' n π' c₁ j)
    (eN : Spec (.of (wcQmbtChartNone A' n c₁)) ⟶ X₁)
    (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c₁ j)) ⟶ X₁)
    [IsOpenImmersion eN] [∀ j, IsOpenImmersion (e j)]
    (hNgen : Ideal.map φN (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
        Ideal.span {φN (wcQmbtGen A' n π' c₁ none)})
    (hNup : ∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁) ⟶ B),
        ρ.hom (wcQmbtGen A' n π' c₁ none) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
          Ideal.span {ρ.hom (wcQmbtGen A' n π' c₁ none)} →
        ∃! ψ : CommRingCat.of (wcQmbtChartNone A' n c₁) ⟶ B, CommRingCat.ofHom φN ≫ ψ = ρ)
    (hφX : ∀ j p, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
          (MvPolynomial.X (some j) * wcQmbtChartHat j p))
    (hφA : ∀ j, (φ j).comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChart A' n π' c₁ j))
    (hnzd : ∀ j, φ j (wcQmbtGen A' n π' c₁ (some j)) ∈ nonZeroDivisors (wcQmbtChart A' n π' c₁ j))
    (hgen : ∀ j, Ideal.map (φ j) (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
        Ideal.span {φ j (wcQmbtGen A' n π' c₁ (some j))})
    (hN : eN ≫ r₁ = Spec.map (CommRingCat.ofHom φN))
    (he : ∀ j, e j ≫ r₁ = Spec.map (CommRingCat.ofHom (φ j))) :
    ∀ (j : Fin n) (q : Spec (.of (wcQmbtChart A' n π' c₁ j))),
      e j q ∈ Set.range eN ↔
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none) ∉ q.asIdeal :=
by
  classical

  have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
      ε.hom.hom y ∈ nonZeroDivisors C := by
    intro B C ε y hy
    rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
    exact ⟨y, hy, rfl⟩
  have hinv : ∀ (R : Type u) [CommRing R] {ι : Type} (gen : ι → R) (i₀ : ι) (B : Type u)
      [CommRing B] (ρ : R →+* B), ρ (gen i₀) ∈ nonZeroDivisors B →
      Ideal.map ρ (Ideal.span (Set.range gen)) = Ideal.span {ρ (gen i₀)} →
      wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (gen k)))) (Spec.map (CommRingCat.ofHom ρ)) := by
    intro R _ ι gen i₀ B _ ρ hρn hρg
    have he0 : (⊤ : (Spec (CommRingCat.of B)).Opens) ≤
        (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have hL : (Spec.map (CommRingCat.ofHom ρ)).appLE ⊤ ⊤ he0 =
        (Spec.map (CommRingCat.ofHom ρ)).appTop := Scheme.Hom.appLE_eq_app _
    have hcomp : ∀ y : R, (Spec.map (CommRingCat.ofHom ρ)).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom y) =
        (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (ρ y) := by
      intro y
      have := congrArg (fun φ => CommRingCat.Hom.hom φ y)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ρ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    have hIU : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (gen k)))).ideal ⟨⊤, isAffineOpen_top _⟩ =
        Ideal.span (Set.range fun k => (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (gen k)) := by
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]
      have key : ∀ (h : (⊤ : (Spec (CommRingCat.of R)).Opens) ≤ ⊤)
          (J : Ideal Γ(Spec (CommRingCat.of R), ⊤)),
          Ideal.map ((Spec (CommRingCat.of R)).presheaf.map (homOfLE h).op).hom J = J := by
        intro h J
        rw [show (homOfLE h).op = 𝟙 _ from rfl, CategoryTheory.Functor.map_id,
          CommRingCat.hom_id, Ideal.map_id]
      exact key _ _
    have hset : (Spec.map (CommRingCat.ofHom ρ)).appTop.hom '' Set.range (fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (gen k)) =
        (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom '' (ρ '' Set.range gen) := by
      ext z
      constructor
      · rintro ⟨_, ⟨k, rfl⟩, rfl⟩
        exact ⟨ρ (gen k), ⟨gen k, ⟨k, rfl⟩, rfl⟩, (hcomp (gen k)).symm⟩
      · rintro ⟨_, ⟨_, ⟨k, rfl⟩, rfl⟩, rfl⟩
        exact ⟨_, ⟨k, rfl⟩, hcomp (gen k)⟩
    intro t
    refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, he0,
      (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (gen i₀), trivial, ?_, ?_, ?_⟩
    · rw [hIU]; exact Ideal.subset_span ⟨i₀, rfl⟩
    · show ((Spec.map (CommRingCat.ofHom ρ)).appLE ⊤ ⊤ he0).hom _ ∈ _
      rw [hL, hcomp]
      exact hisoNZD (Scheme.ΓSpecIso (CommRingCat.of B)).symm _ hρn
    · show Ideal.map ((Spec.map (CommRingCat.ofHom ρ)).appLE ⊤ ⊤ he0).hom _ =
        Ideal.span {((Spec.map (CommRingCat.ofHom ρ)).appLE ⊤ ⊤ he0).hom _}
      rw [hIU, hL, hcomp, Ideal.map_span, hset, ← Ideal.map_span, ← Ideal.map_span, hρg,
        Ideal.map_span, Set.image_singleton]
  intro j q

  have hX1 : φ j (wcQmbtGen A' n π' c₁ (some j)) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) := by
    show φ j (Ideal.Quotient.mk _ (MvPolynomial.X j)) = _
    rw [hφX j j]
    simp [wcQmbtChartHat]
  have hX0 : φ j (wcQmbtGen A' n π' c₁ none) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none) := by
    show φ j (algebraMap A' _ π') = _
    rw [← RingHom.comp_apply, hφA j, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq,
      ← map_mul, Ideal.Quotient.eq]
    have hm : MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π' ∈
        wcQmbtChartIdeal A' n π' c₁ j := Ideal.subset_span (Set.mem_insert _ _)
    have := neg_mem hm
    rw [neg_sub] at this
    exact this
  have hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) ∈
      nonZeroDivisors (wcQmbtChart A' n π' c₁ j) := by
    rw [← hX1]; exact hnzd j
  have hgen' : Ideal.map (φ j) (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
      Ideal.span {Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j))} := by
    rw [← hX1]; exact hgen j
  set x := Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) with hxdef
  set s := Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none) with hsdef
  obtain ⟨-, hrU⟩ := hr
  constructor
  ·
    rintro ⟨q', hq'⟩
    haveI : q.asIdeal.IsPrime := q.isPrime
    let y : Spec (CommRingCat.of (Localization.AtPrime q.asIdeal)) :=
      IsLocalRing.closedPoint (Localization.AtPrime q.asIdeal)
    have hloc_pt : (Spec.map (CommRingCat.ofHom (algebraMap (wcQmbtChart A' n π' c₁ j)
        (Localization.AtPrime q.asIdeal)))) y = q := by
      refine (Spec.map_apply _ y).trans ?_
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      exact IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime q.asIdeal) q.asIdeal
    let g : Spec (CommRingCat.of (Localization.AtPrime q.asIdeal)) ⟶ X₁ :=
      Spec.map (CommRingCat.ofHom (algebraMap (wcQmbtChart A' n π' c₁ j)
        (Localization.AtPrime q.asIdeal))) ≫ e j
    have hH : Set.range g ⊆ Set.range eN := by
      rintro _ ⟨z, rfl⟩
      have hsp : z ⤳ y :=
        IsLocalRing.specializes_closedPoint (R := Localization.AtPrime q.asIdeal) z
      apply (hsp.map g.continuous).mem_open (IsOpenImmersion.isOpen_range eN)
      refine ⟨q', ?_⟩
      rw [hq']
      show e j q = (Spec.map _ ≫ e j) y
      rw [Scheme.Hom.comp_apply, hloc_pt]
    let ℓ := IsOpenImmersion.lift eN g hH
    have hℓ : ℓ ≫ eN = g := IsOpenImmersion.lift_fac eN g hH
    let ψ := Spec.preimage ℓ
    have hψ1 : Spec.map ψ = ℓ := Spec.map_preimage ℓ
    have hψ2 : CommRingCat.ofHom φN ≫ ψ = CommRingCat.ofHom (φ j) ≫
        CommRingCat.ofHom (algebraMap _ (Localization.AtPrime q.asIdeal)) := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, hψ1, ← hN, ← he j]
      have h1 : ℓ ≫ eN ≫ r₁ = g ≫ r₁ := by rw [← Category.assoc, hℓ]
      rw [h1]
      exact Category.assoc _ _ _
    have hψ' : ψ.hom.comp φN =
        (algebraMap (wcQmbtChart A' n π' c₁ j) (Localization.AtPrime q.asIdeal)).comp (φ j) := by
      have := congrArg CommRingCat.Hom.hom hψ2
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this
    have hmem : φN (wcQmbtGen A' n π' c₁ (some j)) ∈
        Ideal.span {φN (wcQmbtGen A' n π' c₁ none)} := by
      rw [← hNgen]; exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨some j, rfl⟩)
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hmem
    have h2 := congrArg ψ.hom ht
    rw [map_mul] at h2
    have e1 : ∀ y, ψ.hom (φN y) =
        algebraMap _ (Localization.AtPrime q.asIdeal) (φ j y) := fun y => by
      rw [← RingHom.comp_apply, hψ', RingHom.comp_apply]
    rw [e1, e1, hX0, hX1, map_mul] at h2
    have hlocx : algebraMap _ (Localization.AtPrime q.asIdeal) x ∈ nonZeroDivisors _ :=
      IsLocalization.map_nonZeroDivisors_le q.asIdeal.primeCompl _ ⟨x, hx, rfl⟩
    have hcancel : ∀ (L : Type u) [CommRing L] (a b c : L), b * (a * c) = a →
        a ∈ nonZeroDivisors L → IsUnit c := by
      intro L _ a b c hb ha
      have h3 : a * (b * c - 1) = 0 := by linear_combination hb
      have h4 := (mem_nonZeroDivisors_iff.mp ha).1 _ h3
      exact IsUnit.of_mul_eq_one b (by linear_combination h4)
    have hu : IsUnit (algebraMap _ (Localization.AtPrime q.asIdeal) s) :=
      hcancel (Localization.AtPrime q.asIdeal) _ _ _ h2 hlocx
    exact Ideal.mem_primeCompl_iff.mp
      ((IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q.asIdeal) q.asIdeal s).mp hu)
  ·
    intro hs
    obtain ⟨ρ, hρdef⟩ : ∃ ρ : wcQuadModelRing A' n (π' ^ 2) c₁ →+* Localization.Away s,
        ρ = (algebraMap (wcQmbtChart A' n π' c₁ j) (Localization.Away s)).comp (φ j) := ⟨_, rfl⟩
    have hlocu : IsUnit (algebraMap (wcQmbtChart A' n π' c₁ j) (Localization.Away s) s) :=
      IsLocalization.Away.algebraMap_isUnit s
    have hlocx : algebraMap (wcQmbtChart A' n π' c₁ j) (Localization.Away s) x ∈
        nonZeroDivisors (Localization.Away s) :=
      IsLocalization.map_nonZeroDivisors_le (Submonoid.powers s) _ ⟨x, hx, rfl⟩
    have hρ0 : ρ (wcQmbtGen A' n π' c₁ none) =
        algebraMap _ (Localization.Away s) x * algebraMap _ (Localization.Away s) s := by
      rw [hρdef, RingHom.comp_apply, hX0, map_mul]
    have hρn : ρ (wcQmbtGen A' n π' c₁ none) ∈ nonZeroDivisors (Localization.Away s) := by
      rw [hρ0]; exact mul_mem_nonZeroDivisors.mpr ⟨hlocx, hlocu.mem_nonZeroDivisors⟩
    have hρg : Ideal.map ρ (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
        Ideal.span {ρ (wcQmbtGen A' n π' c₁ none)} := by
      rw [hρ0, Ideal.span_singleton_mul_right_unit hlocu, hρdef, ← Ideal.map_map, hgen',
        Ideal.map_span, Set.image_singleton]
    obtain ⟨ψ, hψ, -⟩ := hNup (CommRingCat.of (Localization.Away s)) (CommRingCat.ofHom ρ) hρn hρg
    have hm1 : (Spec.map (CommRingCat.ofHom (algebraMap _ (Localization.Away s))) ≫ e j) ≫ r₁ =
        Spec.map (CommRingCat.ofHom ρ) := by
      rw [Category.assoc, he j, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hρdef]
    have hm2 : (Spec.map ψ ≫ eN) ≫ r₁ = Spec.map (CommRingCat.ofHom ρ) := by
      rw [Category.assoc, hN, ← Spec.map_comp, hψ]
    have hinvρ := hinv (wcQuadModelRing A' n (π' ^ 2) c₁)
      (wcQmbtGen A' n π' c₁) none (Localization.Away s) ρ hρn hρg
    have hm := (hrU _ (Spec.map (CommRingCat.ofHom ρ)) hinvρ).unique hm1 hm2
    have hqmem : q ∈ Set.range (PrimeSpectrum.comap
        (algebraMap (wcQmbtChart A' n π' c₁ j) (Localization.Away s))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s]
      exact (PrimeSpectrum.mem_basicOpen s q).mpr hs
    obtain ⟨q₀, hq₀⟩ := hqmem
    obtain ⟨q₁, h1⟩ : ∃ q₁ : Spec (CommRingCat.of (Localization.Away s)),
        (Spec.map (CommRingCat.ofHom (algebraMap (wcQmbtChart A' n π' c₁ j)
          (Localization.Away s)))) q₁ = q := ⟨q₀, (Spec.map_apply _ _).trans hq₀⟩
    refine ⟨Spec.map ψ q₁, ?_⟩
    have h2 : (Spec.map (CommRingCat.ofHom (algebraMap (wcQmbtChart A' n π' c₁ j)
        (Localization.Away s))) ≫ e j) q₁ = (Spec.map ψ ≫ eN) q₁ := by rw [hm]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, h1] at h2
    exact h2.symm

theorem wc_qmbt_bof_divisor {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c₁ : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c₁)))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv.hom
        (wcQmbtGen A' n π' c₁ k)))) r₁)
    (φN : wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChartNone A' n c₁)
    (φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChart A' n π' c₁ j)
    (eN : Spec (.of (wcQmbtChartNone A' n c₁)) ⟶ X₁)
    (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c₁ j)) ⟶ X₁)
    [IsOpenImmersion eN] [∀ j, IsOpenImmersion (e j)]
    (hNX : ∀ p, φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.C π' * MvPolynomial.X p))
    (hNA : φN.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChartNone A' n c₁))
    (hφX : ∀ j p, φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
          (MvPolynomial.X (some j) * wcQmbtChartHat j p))
    (hφA : ∀ j, (φ j).comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChart A' n π' c₁ j))
    (hnzd : ∀ j, φ j (wcQmbtGen A' n π' c₁ (some j)) ∈ nonZeroDivisors (wcQmbtChart A' n π' c₁ j))
    (hgen : ∀ j, Ideal.map (φ j) (Ideal.span (Set.range (wcQmbtGen A' n π' c₁))) =
        Ideal.span {φ j (wcQmbtGen A' n π' c₁ (some j))})
    (hN : eN ≫ r₁ = Spec.map (CommRingCat.ofHom φN))
    (he : ∀ j, e j ≫ r₁ = Spec.map (CommRingCat.ofHom (φ j)))
    (hcov : ∀ x : X₁, x ∈ Set.range eN ∨ ∃ j y, e j y = x)
    (hcompl : ∀ (j : Fin n) (q : Spec (.of (wcQmbtChart A' n π' c₁ j))),
      e j q ∈ Set.range eN ↔
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none) ∉ q.asIdeal) :
    ∃ (Z₁ : Scheme.{u}) (z : Z₁ ⟶ X₁), IsClosedImmersion z ∧ Set.range z = (Set.range eN)ᶜ ∧
      ∀ j, ∃ h : Γ(X₁, (e j).opensRange),
        Function.Surjective (z.app (e j).opensRange).hom ∧
        RingHom.ker (z.app (e j).opensRange).hom = Ideal.span {h} ∧
        ((e j).appLE (e j).opensRange ⊤ (by simp)).hom h =
          (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c₁ j))).inv.hom
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none)) :=
by
  classical
  have NZR : ∀ (T : Scheme.{u}) (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W →
      ∀ b : Γ(T, W), b ∈ nonZeroDivisors Γ(T, W) →
        T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro T W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (T.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
      haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
      exact hnz
    show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst
  have LDPI : ∀ (P : Scheme.{u}) (I : Type) [Finite I] (W : I → P.Opens)
      (hW : ∀ i, IsAffineOpen (W i)) (hcov : (⨆ i, W i) = ⊤) (h : ∀ i, Γ(P, W i))
      (hu : ∀ i j, ∃ u : Γ(P, W i ⊓ W j), IsUnit u ∧
        P.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op (h j) =
          u * P.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op (h i)),
      ∃ (Z : Scheme.{u}) (g : Z ⟶ P), IsClosedImmersion g ∧
        (∀ (i : I) (O : P.Opens), IsAffineOpen O → ∀ (hOW : O ≤ W i),
          Function.Surjective (g.app O).hom ∧
          RingHom.ker (g.app O).hom = Ideal.span {P.presheaf.map (homOfLE hOW).op (h i)}) ∧
        (∀ p : P, p ∈ Set.range g ↔ ∀ (i : I) (hp : p ∈ W i),
          (P.presheaf.germ (W i) p hp).hom (h i) ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk p)) ∧
        (∀ (z : Z) (i : I) (hz : g z ∈ W i), Function.Surjective (g.stalkMap z).hom ∧
          RingHom.ker (g.stalkMap z).hom =
            Ideal.span {(P.presheaf.germ (W i) (g z) hz).hom (h i)}) := by
    intro P I _ W hW hcov h hu

    have A1 : ∀ (O : P.Opens) (hO : IsAffineOpen O) (h' s : Γ(P, O)),
        (∀ (x : P) (hx : x ∈ O), (P.presheaf.germ O x hx).hom s ∈
          Ideal.span {(P.presheaf.germ O x hx).hom h'}) → s ∈ Ideal.span {h'} := by
      intro O hO h' s H
      obtain ⟨C, hC⟩ : ∃ C : Ideal Γ(P, O), ∀ r, r ∈ C ↔ r * s ∈ Ideal.span {h'} :=
        ⟨{ carrier := {r | r * s ∈ Ideal.span {h'}}
           add_mem' := fun {a b} ha hb => by
             simp only [Set.mem_setOf_eq] at *
             rw [add_mul]; exact Ideal.add_mem _ ha hb
           zero_mem' := by simp
           smul_mem' := fun c r hr => by
             simp only [Set.mem_setOf_eq, smul_eq_mul] at *
             rw [mul_assoc]; exact Ideal.mul_mem_left _ _ hr }, fun r => Iff.rfl⟩
      by_contra hs
      have hCt : C ≠ ⊤ := by
        intro e
        apply hs
        have := (hC 1).1 (e ▸ Submodule.mem_top)
        simpa using this
      obtain ⟨M, hM, hCM⟩ := Ideal.exists_le_maximal C hCt
      let y : Spec Γ(P, O) := ⟨M, hM.isPrime⟩
      have hx : hO.fromSpec y ∈ O := by
        have : hO.fromSpec y ∈ (O : Set P) := hO.range_fromSpec ▸ ⟨y, rfl⟩
        exact this
      letI : Algebra Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) :=
        (P.presheaf.germ O (hO.fromSpec y) hx).hom.toAlgebra
      haveI : IsLocalization.AtPrime (P.presheaf.stalk (hO.fromSpec y)) y.asIdeal :=
        hO.isLocalization_stalk' y hx
      have hal : algebraMap Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) =
          (P.presheaf.germ O (hO.fromSpec y) hx).hom := rfl
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (H _ hx)
      obtain ⟨⟨z1, z2⟩, hz⟩ := IsLocalization.surj y.asIdeal.primeCompl a
      simp only at hz
      have e1 : algebraMap Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) (z2 * s) =
          algebraMap Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) (z1 * h') := by
        rw [map_mul, map_mul, ← hz, hal, ← ha]; ring
      obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := y.asIdeal.primeCompl) e1
      have hmem : ((c : Γ(P, O)) * (z2 : Γ(P, O))) ∈ C := by
        rw [hC, mul_assoc, hc]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl))
      have := hCM hmem
      rcases hM.isPrime.mem_or_mem this with h1 | h1
      · exact c.2 h1
      · exact z2.2 h1

    have hIDX : ∀ (x : P) (i j : I) (hi : x ∈ W i) (hj : x ∈ W j),
        (P.presheaf.germ (W i) x hi).hom (h i) ∈
          Ideal.span {(P.presheaf.germ (W j) x hj).hom (h j)} := by
      intro x i j hi hj
      obtain ⟨u, -, hu'⟩ := hu j i
      have hx : x ∈ W j ⊓ W i := ⟨hj, hi⟩
      have e := congrArg (P.presheaf.germ (W j ⊓ W i) x hx).hom hu'
      rw [TopCat.Presheaf.germ_res_apply, map_mul, TopCat.Presheaf.germ_res_apply] at e
      rw [e]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

    obtain ⟨J, hJ⟩ : ∃ J : ∀ U : P.Opens, Ideal Γ(P, U), ∀ U s, s ∈ J U ↔
        ∀ (x : P) (hx : x ∈ U) (i : I) (hi : x ∈ W i),
          (P.presheaf.germ U x hx).hom s ∈ Ideal.span {(P.presheaf.germ (W i) x hi).hom (h i)} :=
      ⟨fun U =>
        { carrier := {s | ∀ (x : P) (hx : x ∈ U) (i : I) (hi : x ∈ W i),
            (P.presheaf.germ U x hx).hom s ∈ Ideal.span {(P.presheaf.germ (W i) x hi).hom (h i)}}
          add_mem' := fun {a b} ha hb x hx i hi => by
            rw [map_add]; exact Ideal.add_mem _ (ha x hx i hi) (hb x hx i hi)
          zero_mem' := fun x hx i hi => by
            rw [map_zero]; exact Ideal.zero_mem _
          smul_mem' := fun c s hs x hx i hi => by
            rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ (hs x hx i hi) },
        fun U s => Iff.rfl⟩
    have hres : ∀ (U V : P.Opens) (hVU : V ≤ U) (s : Γ(P, U)), s ∈ J U →
        (P.presheaf.map (homOfLE hVU).op).hom s ∈ J V := by
      intro U V hVU s hs
      rw [hJ] at hs ⊢
      intro x hx i hi
      rw [TopCat.Presheaf.germ_res_apply]
      exact hs x (hVU hx) i hi

    have hA : ∀ (i : I) (O : P.Opens) (hO : IsAffineOpen O) (hOW : O ≤ W i) (s : Γ(P, O)),
        s ∈ J O ↔ s ∈ Ideal.span {(P.presheaf.map (homOfLE hOW).op).hom (h i)} := by
      intro i O hO hOW s
      constructor
      · intro hs
        apply A1 O hO
        intro x hx
        rw [TopCat.Presheaf.germ_res_apply]
        exact (hJ O s).1 hs x hx i (hOW hx)
      · intro hs
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hs
        rw [hJ]
        intro x hx j hj
        rw [map_mul, TopCat.Presheaf.germ_res_apply]
        exact Ideal.mul_mem_left _ _ (hIDX x i j (hOW hx) hj)

    have hrr : ∀ (U V W' : P.Opens) (h1 : V ≤ U) (h2 : W' ≤ V) (h3 : W' ≤ U) (s : Γ(P, U)),
        (P.presheaf.map (homOfLE h2).op).hom ((P.presheaf.map (homOfLE h1).op).hom s) =
          (P.presheaf.map (homOfLE h3).op).hom s := by
      intro U V W' h1 h2 h3 s
      have e : (homOfLE h3).op = (homOfLE h1).op ≫ (homOfLE h2).op := rfl
      rw [e, P.presheaf.map_comp]
      rfl

    have hB : ∀ (U : P.Opens) (hU : IsAffineOpen U) (f : Γ(P, U)) (hle : P.basicOpen f ≤ U),
        Ideal.map (P.presheaf.map (homOfLE hle).op).hom (J U) = J (P.basicOpen f) := by
      intro U hU f hle
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro s hs
        exact hres U _ hle s hs
      · intro t ht
        haveI := hU.isLocalization_basicOpen f
        obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj f t
        have hna' : t * ((P.presheaf.map (homOfLE hle).op).hom f) ^ n =
            (P.presheaf.map (homOfLE hle).op).hom a := hna
        have hfu : IsUnit ((P.presheaf.map (homOfLE hle).op).hom f) :=
          IsLocalization.Away.algebraMap_isUnit f
        have haV : (P.presheaf.map (homOfLE hle).op).hom a ∈ J (P.basicOpen f) := by
          rw [← hna']; exact Ideal.mul_mem_right _ _ ht
        obtain ⟨Om, hOm⟩ : ∃ Om : ℕ → Set P, ∀ M y, y ∈ Om M ↔ ∃ (G : P.Opens) (hG : G ≤ U),
            y ∈ G ∧ (P.presheaf.map (homOfLE hG).op).hom (f ^ M * a) ∈ J G :=
          ⟨fun M => {y | ∃ (G : P.Opens) (hG : G ≤ U),
            y ∈ G ∧ (P.presheaf.map (homOfLE hG).op).hom (f ^ M * a) ∈ J G}, fun M y => Iff.rfl⟩
        have hOpen : ∀ M, IsOpen (Om M) := by
          intro M
          rw [isOpen_iff_forall_mem_open]
          intro y hy
          obtain ⟨G, hG, hyG, hGJ⟩ := (hOm M y).1 hy
          exact ⟨G, fun y' hy' => (hOm M y').2 ⟨G, hG, hy', hGJ⟩, G.2, hyG⟩
        have hMono : Monotone Om := by
          intro M M' hMM' y hy
          obtain ⟨G, hG, hyG, hGJ⟩ := (hOm M y).1 hy
          refine (hOm M' y).2 ⟨G, hG, hyG, ?_⟩
          have e : f ^ M' * a = f ^ (M' - M) * (f ^ M * a) := by
            rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hMM']
          rw [e, map_mul]
          exact Ideal.mul_mem_left _ _ hGJ
        have hCover : (U : Set P) ⊆ ⋃ M, Om M := by
          intro y hyU
          have hytop : y ∈ (⨆ i, W i) := by rw [hcov]; trivial
          obtain ⟨i, hyi⟩ := TopologicalSpace.Opens.mem_iSup.mp hytop
          obtain ⟨c, hcle, hyc⟩ := hU.exists_basicOpen_le (V := U ⊓ W i) ⟨y, hyU, hyi⟩ hyU
          obtain ⟨D, hDdef⟩ : ∃ D, D = P.basicOpen c := ⟨_, rfl⟩
          have hDaff : IsAffineOpen D := hDdef ▸ hU.basicOpen c
          have hDU : D ≤ U := hDdef ▸ (hcle.trans inf_le_left)
          have hDW : D ≤ W i := hDdef ▸ (hcle.trans inf_le_right)
          have hyD : y ∈ D := hDdef ▸ hyc
          obtain ⟨fk, hfk⟩ : ∃ fk, fk = (P.presheaf.map (homOfLE hDU).op).hom f := ⟨_, rfl⟩
          have hD'eq : P.basicOpen fk = D ⊓ P.basicOpen f := by
            rw [hfk]; exact Scheme.basicOpen_res P f (homOfLE hDU).op
          have hD'D : P.basicOpen fk ≤ D := P.basicOpen_le fk
          have hD'V : P.basicOpen fk ≤ P.basicOpen f := hD'eq ▸ inf_le_right
          have hD'U : P.basicOpen fk ≤ U := hD'D.trans hDU
          have hD'W : P.basicOpen fk ≤ W i := hD'D.trans hDW
          have hD'aff : IsAffineOpen (P.basicOpen fk) := hDaff.basicOpen fk
          have haD' : (P.presheaf.map (homOfLE hD'U).op).hom a ∈ J (P.basicOpen fk) := by
            rw [hJ]
            intro x hx j hj
            have := (hJ _ _).1 haV x (hD'V hx) j hj
            rw [TopCat.Presheaf.germ_res_apply] at this ⊢
            exact this
          obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ((hA i _ hD'aff hD'W _).1 haD')
          haveI := hDaff.isLocalization_basicOpen fk
          obtain ⟨n', b0, hb0⟩ := IsLocalization.Away.surj fk b
          have hb0' : b * ((P.presheaf.map (homOfLE hD'D).op).hom fk) ^ n' =
              (P.presheaf.map (homOfLE hD'D).op).hom b0 := hb0
          have e1 : algebraMap Γ(P, D) Γ(P, P.basicOpen fk)
                (fk ^ n' * (P.presheaf.map (homOfLE hDU).op).hom a) =
              algebraMap Γ(P, D) Γ(P, P.basicOpen fk)
                (b0 * (P.presheaf.map (homOfLE hDW).op).hom (h i)) := by
            show (P.presheaf.map (homOfLE hD'D).op).hom
                (fk ^ n' * (P.presheaf.map (homOfLE hDU).op).hom a) =
              (P.presheaf.map (homOfLE hD'D).op).hom
                (b0 * (P.presheaf.map (homOfLE hDW).op).hom (h i))
            rw [map_mul, map_mul, map_pow, hrr _ _ _ hDU hD'D hD'U, hrr _ _ _ hDW hD'D hD'W,
              ← hb0', ← hb]
            ring
          obtain ⟨⟨cc, m', rfl⟩, hc⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers fk) e1
          simp only at hc
          rw [Set.mem_iUnion]
          refine ⟨m' + n', (hOm _ y).2 ⟨D, hDU, hyD, ?_⟩⟩
          rw [hA i D hDaff hDW]
          have e2 : (P.presheaf.map (homOfLE hDU).op).hom (f ^ (m' + n') * a) =
              fk ^ m' * b0 * (P.presheaf.map (homOfLE hDW).op).hom (h i) := by
            rw [map_mul, map_pow, ← hfk, pow_add, mul_assoc, hc, mul_assoc]
          rw [e2]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        obtain ⟨M, hM⟩ := hU.isCompact.elim_directed_cover Om hOpen hCover hMono.directed_le
        have hfa : f ^ M * a ∈ J U := by
          rw [hJ]
          intro x hx j hj
          obtain ⟨G, hGU, hxG, hG⟩ := (hOm M x).1 (hM hx)
          have := (hJ G _).1 hG x hxG j hj
          rw [TopCat.Presheaf.germ_res_apply] at this
          exact this
        have hmem : t * ((P.presheaf.map (homOfLE hle).op).hom f) ^ (n + M) ∈
            Ideal.map (P.presheaf.map (homOfLE hle).op).hom (J U) := by
          have e3 : t * ((P.presheaf.map (homOfLE hle).op).hom f) ^ (n + M) =
              (P.presheaf.map (homOfLE hle).op).hom (f ^ M * a) := by
            rw [map_mul, map_pow, ← hna', pow_add]; ring
          rw [e3]
          exact Ideal.mem_map_of_mem _ hfa
        exact (Ideal.mul_unit_mem_iff_mem _ (hfu.pow _)).mp hmem

    obtain ⟨𝓘, h𝓘⟩ : ∃ 𝓘 : P.IdealSheafData, ∀ U, 𝓘.ideal U = J U.1 :=
      ⟨⟨fun U => J U.1, fun U f => hB U.1 U.2 f (P.basicOpen_le f),
        ⋂ U : P.affineOpens, P.zeroLocus (J U.1 : Set Γ(P, U.1)), rfl⟩, fun U => rfl⟩

    have hii : ∀ (i : I) (O : P.Opens), IsAffineOpen O → ∀ (hOW : O ≤ W i),
        Function.Surjective (𝓘.subschemeι.app O).hom ∧
        RingHom.ker (𝓘.subschemeι.app O).hom =
          Ideal.span {P.presheaf.map (homOfLE hOW).op (h i)} := by
      intro i O hO hOW
      refine ⟨𝓘.subschemeι_app_surjective ⟨O, hO⟩, ?_⟩
      rw [𝓘.ker_subschemeι_app ⟨O, hO⟩, h𝓘]
      ext s
      exact hA i O hO hOW s

    have S2 : ∀ (Z : Scheme.{u}) (g : Z ⟶ P) [IsClosedImmersion g] (W : P.Opens)
        (hW : IsAffineOpen W) (h : Γ(P, W))
        (hsurj : ∀ (O : P.Opens), IsAffineOpen O → O ≤ W → Function.Surjective (g.app O).hom)
        (hker : ∀ (O : P.Opens), IsAffineOpen O → ∀ (hOW : O ≤ W),
          RingHom.ker (g.app O).hom = Ideal.span {P.presheaf.map (homOfLE hOW).op h})
        (z : Z) (hz : g z ∈ W),
        RingHom.ker (g.stalkMap z).hom = Ideal.span {(P.presheaf.germ W (g z) hz).hom h} := by
      intro Z g _ W hW h hsurj hker z hz
      apply le_antisymm
      · intro α hα
        rw [RingHom.mem_ker] at hα
        obtain ⟨V, hpV, s, hs⟩ := TopCat.Presheaf.germ_exist P.presheaf α
        obtain ⟨f, hfle, hpf⟩ := hW.exists_basicOpen_le (V := V ⊓ W) ⟨g z, hpV, hz⟩ hz
        obtain ⟨O, hOdef⟩ : ∃ O, O = P.basicOpen f := ⟨_, rfl⟩
        have hOaff : IsAffineOpen O := hOdef ▸ hW.basicOpen f
        have hOV : O ≤ V := hOdef ▸ (hfle.trans inf_le_left)
        have hOW : O ≤ W := hOdef ▸ (hfle.trans inf_le_right)
        have hpO : g z ∈ O := hOdef ▸ hpf
        obtain ⟨s', hs'⟩ : ∃ s', s' = P.presheaf.map (homOfLE hOV).op s := ⟨_, rfl⟩
        have hα' : α = (P.presheaf.germ O (g z) hpO).hom s' := by
          rw [hs', TopCat.Presheaf.germ_res_apply, hs]
        have h0 : (Z.presheaf.germ (g ⁻¹ᵁ O) z hpO).hom ((g.app O).hom s') = 0 := by
          rw [← Scheme.Hom.germ_stalkMap_apply, ← hα', hα]
        have hO' : IsAffineOpen (g ⁻¹ᵁ O) := hOaff.preimage g
        have hzO : z ∈ g ⁻¹ᵁ O := hpO
        letI : Algebra Γ(Z, g ⁻¹ᵁ O) (Z.presheaf.stalk z) :=
          (Z.presheaf.germ (g ⁻¹ᵁ O) z hzO).hom.toAlgebra
        haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hO'.primeIdealOf ⟨z, hzO⟩).asIdeal :=
          hO'.isLocalization_stalk ⟨z, hzO⟩
        have hal : algebraMap Γ(Z, g ⁻¹ᵁ O) (Z.presheaf.stalk z) =
            (Z.presheaf.germ (g ⁻¹ᵁ O) z hpO).hom := rfl
        rw [← hal] at h0
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff
          (hO'.primeIdealOf ⟨z, hpO⟩).asIdeal.primeCompl (Z.presheaf.stalk z) _).mp h0
        have hmu : IsUnit ((Z.presheaf.germ (g ⁻¹ᵁ O) z hpO).hom (m : Γ(Z, g ⁻¹ᵁ O))) := by
          rw [← hal]; exact IsLocalization.map_units (Z.presheaf.stalk z) m
        obtain ⟨m0, hm0⟩ := hsurj O hOaff hOW (m : Γ(Z, g ⁻¹ᵁ O))
        have hker0 : m0 * s' ∈ RingHom.ker (g.app O).hom := by
          rw [RingHom.mem_ker, map_mul, hm0, hm]
        rw [hker O hOaff hOW] at hker0
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hker0
        have hu0 : IsUnit ((P.presheaf.germ O (g z) hpO).hom m0) := by
          apply isUnit_of_map_unit (g.stalkMap z).hom
          rw [Scheme.Hom.germ_stalkMap_apply, hm0]; exact hmu
        have e2 : (P.presheaf.germ O (g z) hpO).hom m0 * α =
            (P.presheaf.germ O (g z) hpO).hom c * (P.presheaf.germ W (g z) hz).hom h := by
          rw [hα', ← map_mul, ← hc, map_mul, TopCat.Presheaf.germ_res_apply]
        have : (P.presheaf.germ O (g z) hpO).hom m0 * α ∈
            Ideal.span {(P.presheaf.germ W (g z) hz).hom h} := by
          rw [e2]; exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        exact (Ideal.unit_mul_mem_iff_mem _ hu0).mp this
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
          Scheme.Hom.germ_stalkMap_apply]
        have : h ∈ RingHom.ker (g.app W).hom := by
          rw [hker W hW le_rfl]
          apply Ideal.subset_span
          simp
        rw [RingHom.mem_ker] at this
        rw [this, map_zero]
    refine ⟨𝓘.subscheme, 𝓘.subschemeι, inferInstance, hii, ?_, ?_⟩
    ·
      intro p
      rw [𝓘.range_subschemeι]
      have hJW : ∀ i, J (W i) = Ideal.span {h i} := by
        intro i
        ext s
        rw [hA i (W i) (hW i) le_rfl s]
        have e : (P.presheaf.map (homOfLE (le_refl (W i))).op).hom (h i) = h i := by
          have e0 : (homOfLE (le_refl (W i))).op = 𝟙 (Opposite.op (W i)) := rfl
          rw [e0, P.presheaf.map_id]; rfl
        rw [e]
      have key : ∀ i (hp : p ∈ W i), p ∈ 𝓘.support ↔
          (P.presheaf.germ (W i) p hp).hom (h i) ∈
            IsLocalRing.maximalIdeal (P.presheaf.stalk p) := by
        intro i hp
        rw [𝓘.mem_support_iff_of_mem (U := ⟨W i, hW i⟩) hp, h𝓘]
        show p ∈ P.zeroLocus (J (W i) : Set Γ(P, W i)) ↔ _
        rw [hJW, Scheme.zeroLocus_span, Scheme.mem_zeroLocus_iff]
        simp only [Set.mem_singleton_iff, forall_eq]
        rw [Scheme.mem_basicOpen _ _ _ hp, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      constructor
      · intro hp' i hp
        exact (key i hp).1 hp'
      · intro H
        have hptop : p ∈ (⨆ i, W i) := by rw [hcov]; trivial
        obtain ⟨i, hp⟩ := TopologicalSpace.Opens.mem_iSup.mp hptop
        exact (key i hp).2 (H i hp)
    ·
      intro z i hz
      refine ⟨𝓘.subschemeι.stalkMap_surjective z, ?_⟩
      exact S2 𝓘.subscheme 𝓘.subschemeι (W i) (hW i) (h i)
        (fun O hO hOW => (hii i O hO hOW).1) (fun O hO hOW => (hii i O hO hOW).2) z hz

  have hiso : ∀ j, IsIso ((e j).appLE (e j).opensRange ⊤ (by simp)) := by
    intro j
    have h0 : IsIso ((e j).appLE ((e j) ''ᵁ ⊤) ⊤ ((e j).preimage_image_eq ⊤).ge) := by
      rw [← Scheme.Hom.appIso_hom']; infer_instance
    exact (Scheme.Hom.appLE_congr (e j) _ (e j).image_top_eq_opensRange rfl
      (fun f => IsIso f)).mp h0
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ j, Γ(X₁, (e j).opensRange) ≃+* wcQmbtChart A' n π' c₁ j,
      ∀ j x, Θ j x = (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c₁ j))).hom.hom
        (((e j).appLE (e j).opensRange ⊤ (by simp)).hom x) :=
    ⟨fun j => haveI := hiso j
      RingEquiv.ofBijective (((e j).appLE (e j).opensRange ⊤ (by simp)) ≫
        (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c₁ j))).hom).hom
        (ConcreteCategory.bijective_of_isIso _), fun j x => rfl⟩

  obtain ⟨hs, hhs⟩ : ∃ hs : ∀ j, Γ(X₁, (e j).opensRange), ∀ j, Θ j (hs j) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none) :=
    ⟨fun j => (Θ j).symm _, fun j => RingEquiv.apply_symm_apply _ _⟩

  obtain ⟨Gh, hGh⟩ : ∃ Gh : wcQuadModelRing A' n (π' ^ 2) c₁ → Γ(X₁, ⊤), ∀ a, Gh a =
      r₁.appTop.hom ((Scheme.ΓSpecIso (.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv.hom a) :=
    ⟨_, fun _ => rfl⟩

  have hF1 : ∀ j, ((e j).appLE (e j).opensRange ⊤ (by simp)).hom (hs j) =
      (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c₁ j))).inv.hom
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none)) := by
    intro j
    have h1 := hhs j
    rw [hΘ] at h1
    rw [← h1]
    exact (congrArg (fun f => f.hom (((e j).appLE (e j).opensRange ⊤ (by simp)).hom (hs j)))
      (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c₁ j))).hom_inv_id).symm

  have hF2 : ∀ j (x : Γ(X₁, (e j).opensRange)) (q : Spec (.of (wcQmbtChart A' n π' c₁ j))),
      e j q ∈ X₁.basicOpen x ↔ Θ j x ∉ q.asIdeal := by
    intro j x q
    rw [hΘ]
    have k1 : (e j) ⁻¹ᵁ X₁.basicOpen x = (Spec (.of (wcQmbtChart A' n π' c₁ j))).basicOpen
        (((e j).appLE (e j).opensRange ⊤ (by simp)).hom x) := by
      rw [Scheme.basicOpen_appLE, top_inf_eq]
    rw [← Scheme.Hom.mem_preimage, k1, basicOpen_eq_of_affine']
    rfl

  have hF3 : ∀ j (a : wcQuadModelRing A' n (π' ^ 2) c₁),
      Θ j ((X₁.presheaf.map (homOfLE (le_top : (e j).opensRange ≤ ⊤)).op).hom (Gh a)) =
        φ j a := by
    intro j a
    rw [hGh, hΘ]
    have k1 : X₁.presheaf.map (homOfLE (le_top : (e j).opensRange ≤ ⊤)).op ≫
        (e j).appLE (e j).opensRange ⊤ (by simp) = (e j).appTop := by
      rw [Scheme.Hom.map_appLE]
      exact (Scheme.Hom.app_eq_appLE _).symm
    have k2 : (Scheme.ΓSpecIso (.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv ≫ r₁.appTop ≫
        (e j).appTop ≫ (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c₁ j))).hom =
        CommRingCat.ofHom (φ j) := by
      rw [← Category.assoc r₁.appTop, ← Scheme.Hom.comp_appTop, he j,
        Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
    rw [← k1] at k2
    exact congrArg (fun f => f.hom a) k2

  have hF4 : ∀ {U V : X₁.Opens} (f : Γ(X₁, U)) (hVU : V ≤ U), V ≤ X₁.basicOpen f →
      IsUnit ((X₁.presheaf.map (homOfLE hVU).op).hom f) := by
    intro U V f hVU hV
    have hu := RingedSpace.isUnit_res_basicOpen X₁.toRingedSpace f
    have : X₁.presheaf.map (homOfLE hVU).op =
        X₁.presheaf.map (homOfLE (X₁.basicOpen_le f)).op ≫ X₁.presheaf.map (homOfLE hV).op := by
      rw [← Functor.map_comp]; rfl
    rw [this, CommRingCat.comp_apply]
    exact hu.map _

  have hrr : ∀ (U V W' : X₁.Opens) (h1 : V ≤ U) (h2 : W' ≤ V) (h3 : W' ≤ U) (s : Γ(X₁, U)),
      (X₁.presheaf.map (homOfLE h2).op).hom ((X₁.presheaf.map (homOfLE h1).op).hom s) =
        (X₁.presheaf.map (homOfLE h3).op).hom s := by
    intro U V W' h1 h2 h3 s
    have e' : (homOfLE h3).op = (homOfLE h1).op ≫ (homOfLE h2).op := rfl
    rw [e', X₁.presheaf.map_comp]
    rfl

  have hK : ∀ j (x : X₁), x ∈ (e j).opensRange → x ∈ Set.range eN →
      x ∈ X₁.basicOpen (hs j) := by
    intro j x hxj hxN
    obtain ⟨q, rfl⟩ := Scheme.Hom.mem_opensRange.mp hxj
    rw [hF2, hhs]
    exact (hcompl j q).mp hxN

  have hR1 : ∀ j, φ j (wcQmbtGen A' n π' c₁ none) = φ j (wcQmbtGen A' n π' c₁ (some j)) *
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none) := by
    intro j
    have e1 : φ j (wcQmbtGen A' n π' c₁ none) = algebraMap A' (wcQmbtChart A' n π' c₁ j) π' := by
      show φ j (algebraMap A' _ π') = _
      rw [← RingHom.comp_apply, hφA]
    have e2 : φ j (wcQmbtGen A' n π' c₁ (some j)) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)) := by
      show φ j (Ideal.Quotient.mk _ (MvPolynomial.X j)) = _
      rw [hφX]; simp [wcQmbtChartHat]
    rw [e1, e2, ← map_mul, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, eq_comm,
      Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_insert _ _)
  have hR2 : ∀ j p, φ j (wcQmbtGen A' n π' c₁ (some p)) = φ j (wcQmbtGen A' n π' c₁ (some j)) *
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (wcQmbtChartHat j p) := by
    intro j p
    show φ j (Ideal.Quotient.mk _ (MvPolynomial.X p)) =
      φ j (Ideal.Quotient.mk _ (MvPolynomial.X j)) * _
    rw [hφX, hφX, ← map_mul]
    congr 1
    simp [wcQmbtChartHat]

  have S1 : ∀ j, (X₁.presheaf.map (homOfLE (le_top : (e j).opensRange ≤ ⊤)).op).hom
      (Gh (wcQmbtGen A' n π' c₁ none)) =
      (X₁.presheaf.map (homOfLE (le_top : (e j).opensRange ≤ ⊤)).op).hom
        (Gh (wcQmbtGen A' n π' c₁ (some j))) * hs j := by
    intro j
    apply (Θ j).injective
    rw [map_mul, hF3, hF3, hhs]
    exact hR1 j
  have S2 : ∀ j p, (X₁.presheaf.map (homOfLE (le_top : (e j).opensRange ≤ ⊤)).op).hom
      (Gh (wcQmbtGen A' n π' c₁ (some p))) =
      (X₁.presheaf.map (homOfLE (le_top : (e j).opensRange ≤ ⊤)).op).hom
        (Gh (wcQmbtGen A' n π' c₁ (some j))) *
        (Θ j).symm (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (wcQmbtChartHat j p)) := by
    intro j p
    apply (Θ j).injective
    rw [map_mul, hF3, hF3, RingEquiv.apply_symm_apply]
    exact hR2 j p
  have S3 : ∀ j, (X₁.presheaf.map (homOfLE (le_top : (e j).opensRange ≤ ⊤)).op).hom
      (Gh (wcQmbtGen A' n π' c₁ (some j))) ∈ nonZeroDivisors Γ(X₁, (e j).opensRange) := by
    intro j
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply (Θ j).injective
    rw [map_zero]
    apply (mem_nonZeroDivisors_iff_right.mp (hnzd j))
    rw [← hF3, ← map_mul, hx, map_zero]

  have alg : ∀ {R : Type u} [CommRing R] (G A B Hi Hk t t' : R), A ∈ nonZeroDivisors R →
      G = A * Hi → G = B * Hk → B = A * t' → A = B * t → IsUnit t ∧ Hk = t * Hi := by
    intro R _ G A B Hi Hk t t' hA E1 E2 E3 E4
    have h1 : (1 - t' * t) * A = 0 := by linear_combination E4 + t * E3
    have h2 : (Hi - t' * Hk) * A = 0 := by linear_combination -E1 + E2 + Hk * E3
    have h1' := (mem_nonZeroDivisors_iff_right.mp hA) _ h1
    have h2' := (mem_nonZeroDivisors_iff_right.mp hA) _ h2
    exact ⟨isUnit_iff_exists_inv.mpr ⟨t', by linear_combination -h1'⟩,
      by linear_combination (-t) * h2' + Hk * h1'⟩

  let W : Option (Fin n) → X₁.Opens := fun k => Option.elim k eN.opensRange (fun j => (e j).opensRange)
  let hh : ∀ k, Γ(X₁, W k) := fun k =>
    Option.rec (motive := fun k => Γ(X₁, W k)) (1 : Γ(X₁, eN.opensRange)) (fun j => hs j) k
  have hW : ∀ k, IsAffineOpen (W k) := by
    rintro (_ | j)
    · exact isAffineOpen_opensRange eN
    · exact isAffineOpen_opensRange (e j)
  have hcovW : (⨆ k, W k) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    rcases hcov x with hx | ⟨j, y, hy⟩
    · exact ⟨none, show x ∈ eN.opensRange from Scheme.Hom.mem_opensRange.mpr hx⟩
    · exact ⟨some j, show x ∈ (e j).opensRange from Scheme.Hom.mem_opensRange.mpr ⟨y, hy⟩⟩
  have hu : ∀ i k, ∃ u : Γ(X₁, W i ⊓ W k), IsUnit u ∧
      X₁.presheaf.map (homOfLE (inf_le_right : W i ⊓ W k ≤ W k)).op (hh k) =
        u * X₁.presheaf.map (homOfLE (inf_le_left : W i ⊓ W k ≤ W i)).op (hh i) := by
    rintro (_ | i) (_ | k)
    · have e2 : (X₁.presheaf.map (homOfLE (inf_le_right :
            eN.opensRange ⊓ eN.opensRange ≤ eN.opensRange)).op).hom (1 : Γ(X₁, eN.opensRange)) =
          1 * (X₁.presheaf.map (homOfLE (inf_le_left :
            eN.opensRange ⊓ eN.opensRange ≤ eN.opensRange)).op).hom (1 : Γ(X₁, eN.opensRange)) := by
        simp only [map_one, one_mul]
      exact ⟨1, isUnit_one, e2⟩
    · have hv : IsUnit ((X₁.presheaf.map (homOfLE (inf_le_right :
          eN.opensRange ⊓ (e k).opensRange ≤ (e k).opensRange)).op).hom (hs k)) :=
        hF4 (hs k) _ (fun x hx => hK k x hx.2 (Scheme.Hom.mem_opensRange.mp hx.1))
      have e2 : (X₁.presheaf.map (homOfLE (inf_le_right :
            eN.opensRange ⊓ (e k).opensRange ≤ (e k).opensRange)).op).hom (hs k) =
          (X₁.presheaf.map (homOfLE (inf_le_right :
            eN.opensRange ⊓ (e k).opensRange ≤ (e k).opensRange)).op).hom (hs k) *
          (X₁.presheaf.map (homOfLE (inf_le_left :
            eN.opensRange ⊓ (e k).opensRange ≤ eN.opensRange)).op).hom
              (1 : Γ(X₁, eN.opensRange)) := by
        rw [map_one, mul_one]
      exact ⟨_, hv, e2⟩
    · have hv : IsUnit ((X₁.presheaf.map (homOfLE (inf_le_left :
          (e i).opensRange ⊓ eN.opensRange ≤ (e i).opensRange)).op).hom (hs i)) :=
        hF4 (hs i) _ (fun x hx => hK i x hx.1 (Scheme.Hom.mem_opensRange.mp hx.2))
      have e2 : (X₁.presheaf.map (homOfLE (inf_le_right :
            (e i).opensRange ⊓ eN.opensRange ≤ eN.opensRange)).op).hom
              (1 : Γ(X₁, eN.opensRange)) =
          ↑hv.unit⁻¹ * (X₁.presheaf.map (homOfLE (inf_le_left :
            (e i).opensRange ⊓ eN.opensRange ≤ (e i).opensRange)).op).hom (hs i) := by
        rw [map_one, IsUnit.val_inv_mul]
      exact ⟨_, Units.isUnit _, e2⟩
    · have hI : ∀ s : Γ(X₁, ⊤), (X₁.presheaf.map (homOfLE (inf_le_left :
            (e i).opensRange ⊓ (e k).opensRange ≤ (e i).opensRange)).op).hom
            ((X₁.presheaf.map (homOfLE (le_top : (e i).opensRange ≤ ⊤)).op).hom s) =
          (X₁.presheaf.map (homOfLE (le_top :
            (e i).opensRange ⊓ (e k).opensRange ≤ ⊤)).op).hom s :=
        fun s => hrr _ _ _ _ _ _ s
      have hJ : ∀ s : Γ(X₁, ⊤), (X₁.presheaf.map (homOfLE (inf_le_right :
            (e i).opensRange ⊓ (e k).opensRange ≤ (e k).opensRange)).op).hom
            ((X₁.presheaf.map (homOfLE (le_top : (e k).opensRange ≤ ⊤)).op).hom s) =
          (X₁.presheaf.map (homOfLE (le_top :
            (e i).opensRange ⊓ (e k).opensRange ≤ ⊤)).op).hom s :=
        fun s => hrr _ _ _ _ _ _ s
      have E1 := congrArg (X₁.presheaf.map (homOfLE (inf_le_left :
        (e i).opensRange ⊓ (e k).opensRange ≤ (e i).opensRange)).op).hom (S1 i)
      have E3 := congrArg (X₁.presheaf.map (homOfLE (inf_le_left :
        (e i).opensRange ⊓ (e k).opensRange ≤ (e i).opensRange)).op).hom (S2 i k)
      have E2 := congrArg (X₁.presheaf.map (homOfLE (inf_le_right :
        (e i).opensRange ⊓ (e k).opensRange ≤ (e k).opensRange)).op).hom (S1 k)
      have E4 := congrArg (X₁.presheaf.map (homOfLE (inf_le_right :
        (e i).opensRange ⊓ (e k).opensRange ≤ (e k).opensRange)).op).hom (S2 k i)
      rw [map_mul, hI, hI] at E1 E3
      rw [map_mul, hJ, hJ] at E2 E4
      have hA : (X₁.presheaf.map (homOfLE (le_top :
            (e i).opensRange ⊓ (e k).opensRange ≤ ⊤)).op).hom
            (Gh (wcQmbtGen A' n π' c₁ (some i))) ∈
          nonZeroDivisors Γ(X₁, (e i).opensRange ⊓ (e k).opensRange) := by
        have h0 := NZR X₁ (e i).opensRange ((e i).opensRange ⊓ (e k).opensRange)
          (inf_le_left : (e i).opensRange ⊓ (e k).opensRange ≤ (e i).opensRange)
          (isAffineOpen_opensRange (e i)) _ (S3 i)
        rw [← hI]
        exact h0
      have key := alg _ _ _ _ _ _ _ hA E1 E2 E3 E4
      exact ⟨_, key.1, key.2⟩
  obtain ⟨Z, g, hg, hker, hrange, -⟩ := LDPI X₁ (Option (Fin n)) W hW hcovW hh hu
  have hrangeZ : Set.range g = (Set.range eN)ᶜ := by
    ext p
    rw [hrange p, Set.mem_compl_iff]
    constructor
    · intro H hpN
      have hp0 : p ∈ W none := show p ∈ eN.opensRange from Scheme.Hom.mem_opensRange.mpr hpN
      have h0 := H none hp0
      have h1 : (X₁.presheaf.germ (W none) p hp0).hom (hh none) = 1 := map_one _
      rw [h1, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h0
      exact h0 isUnit_one
    · intro hpN k hk
      rcases k with _ | j
      · exact absurd (Scheme.Hom.mem_opensRange.mp (show p ∈ eN.opensRange from hk)) hpN
      · obtain ⟨q, rfl⟩ := Scheme.Hom.mem_opensRange.mp (show p ∈ (e j).opensRange from hk)
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hunit
        apply hpN
        have hb : e j q ∈ X₁.basicOpen (hs j) :=
          (Scheme.mem_basicOpen X₁ (hs j) (e j q) hk).mpr hunit
        rw [hF2, hhs] at hb
        exact (hcompl j q).mpr hb
  refine ⟨Z, g, hg, hrangeZ, fun j => ⟨hs j, ?_, ?_, hF1 j⟩⟩
  · exact (hker (some j) (e j).opensRange (isAffineOpen_opensRange _)
      (le_refl (e j).opensRange)).1
  · have e0 : X₁.presheaf.map (homOfLE (le_refl (e j).opensRange)).op = 𝟙 _ := by
      rw [show (homOfLE (le_refl (e j).opensRange)).op = 𝟙 _ from rfl, X₁.presheaf.map_id]
    have e1 : (X₁.presheaf.map (homOfLE (le_refl (e j).opensRange)).op).hom (hs j) = hs j := by
      rw [e0]; rfl
    exact (hker (some j) (e j).opensRange (isAffineOpen_opensRange _)
      (le_refl (e j).opensRange)).2.trans (congrArg (fun x => Ideal.span {x}) e1)

theorem wc_qmbt_bof_closed_chart {P Z : Scheme.{u}} (z : Z ⟶ P) [IsClosedImmersion z]
    {C : Type u} [CommRing C] (e : Spec (.of C) ⟶ P) [IsOpenImmersion e] (s : C)
    (h : Γ(P, e.opensRange))
    (hsurj : Function.Surjective (z.app e.opensRange).hom)
    (hker : RingHom.ker (z.app e.opensRange).hom = Ideal.span {h})
    (hs : (e.appLE e.opensRange ⊤ (by simp)).hom h = (Scheme.ΓSpecIso (.of C)).inv.hom s) :
    ∃ g : Spec (.of (C ⧸ Ideal.span {s})) ⟶ Z,
      IsPullback g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s})))) z e :=
by
  classical
  have bij : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] (U : Y.Opens)
      (_hU : (U : Set Y) = Set.range f) (hle : ⊤ ≤ f ⁻¹ᵁ U),
      Function.Bijective (f.appLE U ⊤ hle).hom := by
    intro X Y f _ U hU hle
    obtain rfl : U = f ''ᵁ ⊤ := by
      apply TopologicalSpace.Opens.ext
      rw [hU, Scheme.Hom.image_top_eq_opensRange, Scheme.Hom.coe_opensRange]
    have : f.appLE (f ''ᵁ ⊤) ⊤ hle = (f.appIso ⊤).hom := (Scheme.Hom.appIso_hom' f ⊤).symm
    rw [this]
    exact ConcreteCategory.bijective_of_isIso _
  have hcond : Limits.pullback.fst z e ≫ z = Limits.pullback.snd z e ≫ e :=
    Limits.pullback.condition
  have h2 : ⊤ ≤ e ⁻¹ᵁ e.opensRange := (Scheme.Hom.preimage_opensRange e).ge
  have h1 : ⊤ ≤ (Limits.pullback.fst z e) ⁻¹ᵁ (z ⁻¹ᵁ e.opensRange) := by
    intro x _
    show z (Limits.pullback.fst z e x) ∈ (e.opensRange : Set P)
    have : z (Limits.pullback.fst z e x) = e (Limits.pullback.snd z e x) := by
      rw [← Scheme.Hom.comp_apply, hcond, Scheme.Hom.comp_apply]
    rw [this, Scheme.Hom.coe_opensRange]
    exact ⟨_, rfl⟩
  have hrange : ((z ⁻¹ᵁ e.opensRange : Z.Opens) : Set Z) =
      Set.range (Limits.pullback.fst z e) := by
    rw [Scheme.Pullback.range_fst, Scheme.Hom.coe_preimage, Scheme.Hom.coe_opensRange]
  have hγ := bij e e.opensRange (Scheme.Hom.coe_opensRange e) h2
  have hβ := bij (Limits.pullback.fst z e) (z ⁻¹ᵁ e.opensRange) hrange h1
  have hι : Function.Bijective (Scheme.ΓSpecIso (.of C)).inv.hom :=
    ConcreteCategory.bijective_of_isIso _
  have hsq : z.app e.opensRange ≫ (Limits.pullback.fst z e).appLE (z ⁻¹ᵁ e.opensRange) ⊤ h1 =
      e.appLE e.opensRange ⊤ h2 ≫ (Limits.pullback.snd z e).appTop := by
    have h1' : ⊤ ≤ (Limits.pullback.fst z e ≫ z) ⁻¹ᵁ e.opensRange := h1
    have h3 : ⊤ ≤ (Limits.pullback.snd z e ≫ e) ⁻¹ᵁ e.opensRange := by
      rw [← hcond]; exact h1'
    have e1 : z.app e.opensRange ≫ (Limits.pullback.fst z e).appLE (z ⁻¹ᵁ e.opensRange) ⊤ h1 =
        (Limits.pullback.fst z e ≫ z).appLE e.opensRange ⊤ h1' :=
      (Scheme.Hom.comp_appLE _ _ _ _ h1').symm
    have e2 : (Limits.pullback.fst z e ≫ z).appLE e.opensRange ⊤ h1' =
        (Limits.pullback.snd z e ≫ e).appLE e.opensRange ⊤ h3 := by
      have key : ∀ (f g : Limits.pullback z e ⟶ P) (_ : f = g) (hf : ⊤ ≤ f ⁻¹ᵁ e.opensRange)
          (hg : ⊤ ≤ g ⁻¹ᵁ e.opensRange),
          f.appLE e.opensRange ⊤ hf = g.appLE e.opensRange ⊤ hg := by
        rintro f _ rfl _ _; rfl
      exact key _ _ hcond _ _
    have e3 : (Limits.pullback.snd z e ≫ e).appLE e.opensRange ⊤ h3 =
        e.appLE e.opensRange ⊤ h2 ≫ (Limits.pullback.snd z e).appLE ⊤ ⊤ le_top :=
      (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).symm
    have e4 : (Limits.pullback.snd z e).appLE ⊤ ⊤ le_top = (Limits.pullback.snd z e).appTop :=
      (Scheme.Hom.app_eq_appLE _).symm
    rw [e1, e2, e3, e4]
  set α := (z.app e.opensRange).hom with hαdef
  set β := ((Limits.pullback.fst z e).appLE (z ⁻¹ᵁ e.opensRange) ⊤ h1).hom with hβdef
  set γ := (e.appLE e.opensRange ⊤ h2).hom with hγdef
  set δ := (Limits.pullback.snd z e).appTop.hom with hδdef
  set ι := (Scheme.ΓSpecIso (.of C)).inv.hom with hιdef
  have hs' : γ h = ι s := hs
  have hsq' : ∀ r, β (α r) = δ (γ r) := by
    intro r
    have := congrArg (fun f => f.hom r) hsq
    simpa only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] using this
  set φ := δ.comp ι with hφdef
  have hφsurj : Function.Surjective φ := by
    intro u
    obtain ⟨y, rfl⟩ := hβ.2 u
    obtain ⟨r, rfl⟩ := hsurj y
    obtain ⟨c, hc⟩ := hι.2 (γ r)
    exact ⟨c, by rw [hφdef, RingHom.comp_apply, hc, hsq']⟩
  have hαh : α h = 0 := by
    have hh : h ∈ RingHom.ker α := by rw [hker]; exact Ideal.mem_span_singleton_self h
    exact hh
  have hφker : RingHom.ker φ = Ideal.span {s} := by
    ext x
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      rw [hφdef, RingHom.comp_apply] at hx
      obtain ⟨r, hr⟩ := hγ.2 (ι x)
      have hr0 : α r = 0 := hβ.1 (by rw [hsq', hr, hx, map_zero])
      have hr' : r ∈ RingHom.ker α := hr0
      rw [hker, Ideal.mem_span_singleton'] at hr'
      obtain ⟨a, rfl⟩ := hr'
      obtain ⟨b, hb⟩ := hι.2 (γ a)
      refine ⟨b, hι.1 ?_⟩
      rw [map_mul, hb, ← hs', ← map_mul, hr]
    · rintro ⟨b, rfl⟩
      rw [hφdef, RingHom.comp_apply, map_mul, map_mul, ← hs', ← hsq', hαh, map_zero, mul_zero]
  let ψ : (C ⧸ Ideal.span {s}) ≃+* Γ(Limits.pullback z e, ⊤) :=
    (Ideal.quotEquivOfEq hφker.symm).trans (RingHom.quotientKerEquivOfSurjective hφsurj)
  have hψ : ∀ x, ψ.symm (φ x) = Ideal.Quotient.mk (Ideal.span {s}) x := by
    intro x
    rw [RingEquiv.symm_apply_eq]
    simp [ψ, Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
  let Θ : Spec (.of (C ⧸ Ideal.span {s})) ≅ Limits.pullback z e :=
    asIso (Spec.map ψ.symm.toCommRingCatIso.hom) ≪≫ (Limits.pullback z e).isoSpec.symm
  have hΘ : Θ.hom ≫ Limits.pullback.snd z e =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {s}))) := by
    simp only [Θ, Iso.trans_hom, asIso_hom, Iso.symm_hom, Category.assoc]
    rw [← Scheme.isoSpec_inv_naturality, Scheme.isoSpec_Spec_inv, ← Spec.map_comp,
      ← Spec.map_comp]
    congr 1
    ext x
    exact hψ x
  refine ⟨Θ.hom ≫ Limits.pullback.fst z e, IsPullback.of_iso_pullback ⟨?_⟩ Θ rfl hΘ⟩
  rw [Category.assoc, hcond, ← Category.assoc, hΘ]

theorem wc_qmbt_bof_pushout_none {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c₁ : Matrix (Fin n) (Fin n) A'} {K : Type u} [CommRing K]
    (ω : wcQuadModelRing A' n (π' ^ 2) c₁ →+* K)
    (hωX : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) = 0)
    (hωπ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π') = 0)
    (lam : A' →+* K) (hlam : ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) = lam)
    (φN : wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChartNone A' n c₁)
    (hX : ∀ p, φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.C π' * MvPolynomial.X p))
    (hA : φN.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChartNone A' n c₁)) :
    ∃ qN : wcQmbtChartNone A' n c₁ →+* wcQuadModelRing K n 1 (c₁.map lam),
      IsPushout (CommRingCat.ofHom φN) (CommRingCat.ofHom ω) (CommRingCat.ofHom qN)
        (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam)))) :=
by
  classical

  have hlamC : ∀ a : A', lam a =
      ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.C a)) := by
    intro a
    rw [← hlam]
    rfl
  have hlamπ : lam π' = 0 := by
    rw [← hlam]
    exact hωπ
  have hAC : ∀ a : A',
      φN (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.C a)) =
        Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.C a) := by
    intro a
    exact RingHom.congr_fun hA a

  have hG : (MvPolynomial.map lam) (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * MvPolynomial.X p *
      MvPolynomial.X q - 1 : MvPolynomial (Fin n) A') =
      ∑ p, ∑ q, MvPolynomial.C ((c₁.map lam) p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 1 := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, map_one,
      Matrix.map_apply]
  have hqN0 : ∀ a ∈ wcQmbtChartNoneIdeal A' n c₁,
      ((Ideal.Quotient.mk (wcQuadModelIdeal K n 1 (c₁.map lam))).comp
        (MvPolynomial.map lam)) a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have h0 : ((Ideal.Quotient.mk (wcQuadModelIdeal K n 1 (c₁.map lam))).comp
        (MvPolynomial.map lam)) (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * MvPolynomial.X p *
          MvPolynomial.X q - 1 : MvPolynomial (Fin n) A') = 0 := by
      rw [RingHom.comp_apply, hG]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    rw [h0, mul_zero]
  obtain ⟨qN, hqC, hqX⟩ : ∃ qN : wcQmbtChartNone A' n c₁ →+* wcQuadModelRing K n 1 (c₁.map lam),
      (∀ a, qN (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.C a)) =
        Ideal.Quotient.mk (wcQuadModelIdeal K n 1 (c₁.map lam)) (MvPolynomial.C (lam a))) ∧
      (∀ p, qN (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal K n 1 (c₁.map lam)) (MvPolynomial.X p)) := by
    refine ⟨Ideal.Quotient.lift _ _ hqN0, fun a => ?_, fun p => ?_⟩
    · rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
    · rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X]
  refine ⟨qN, ?_⟩

  have hcomm : qN.comp φN = (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam))).comp ω := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      rw [hAC a, hqC a, ← hlamC a]
      rfl
    · intro p
      simp only [RingHom.comp_apply]
      rw [hX p, hωX p, map_zero, map_mul, map_mul, hqC, hqX, hlamπ, MvPolynomial.C_0, map_zero,
        zero_mul]
  have hsq : CommRingCat.ofHom φN ≫ CommRingCat.ofHom qN =
      CommRingCat.ofHom ω ≫ CommRingCat.ofHom
        (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam))) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm]

  have hcond : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom φN) (CommRingCat.ofHom ω),
      s.inl.hom.comp φN = s.inr.hom.comp ω := by
    intro s
    have := congrArg CommRingCat.Hom.hom s.condition
    simpa using this
  have hβ : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom φN) (CommRingCat.ofHom ω), ∀ a : A',
      s.inr.hom (lam a) =
        s.inl.hom (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.C a)) := by
    intro s a
    rw [hlamC a, ← RingHom.comp_apply, ← hcond s, RingHom.comp_apply, hAC a]
  have hdesc : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom φN) (CommRingCat.ofHom ω),
      ∃ d : wcQuadModelRing K n 1 (c₁.map lam) →+* s.pt,
        (∀ k, d (Ideal.Quotient.mk (wcQuadModelIdeal K n 1 (c₁.map lam)) (MvPolynomial.C k)) =
          s.inr.hom k) ∧
        (∀ p, d (Ideal.Quotient.mk (wcQuadModelIdeal K n 1 (c₁.map lam)) (MvPolynomial.X p)) =
          s.inl.hom (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.X p))) := by
    intro s
    set E := MvPolynomial.eval₂Hom s.inr.hom
      (fun p => s.inl.hom (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁) (MvPolynomial.X p)))
      with hEdef
    have hE : ∀ a ∈ wcQuadModelIdeal K n 1 (c₁.map lam), E a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul]
      have h1 : s.inl.hom (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c₁)
          (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * MvPolynomial.X p * MvPolynomial.X q - 1)) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
      have h2 : E (∑ p, ∑ q, MvPolynomial.C ((c₁.map lam) p q) * MvPolynomial.X p *
          MvPolynomial.X q - MvPolynomial.C 1) = 0 := by
        rw [← h1]
        simp only [hEdef, map_sub, map_sum, map_mul, map_one, MvPolynomial.coe_eval₂Hom,
          MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, Matrix.map_apply, hβ s]
      rw [h2, mul_zero]
    refine ⟨Ideal.Quotient.lift _ E hE, fun k => ?_, fun p => ?_⟩
    · rw [Ideal.Quotient.lift_mk, hEdef, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]
    · rw [Ideal.Quotient.lift_mk, hEdef, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X]
  choose desc hdC hdX using hdesc

  refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ _ hsq) ?_
  refine Limits.PushoutCocone.IsColimit.mk hsq (fun s => CommRingCat.ofHom (desc s)) ?_ ?_ ?_
  · intro s
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      rw [hqC a, hdC s, hβ s]
    · intro p
      simp only [RingHom.comp_apply]
      rw [hqX p, hdX s]
  · intro s
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
    ext k
    rw [RingHom.comp_apply, ← hdC s k]
    rfl
  · intro s m hm1 hm2
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_ofHom]
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro k
      simp only [RingHom.comp_apply]
      rw [hdC s, ← hm2]
      rfl
    · intro p
      simp only [RingHom.comp_apply]
      rw [hdX s, ← hm1, ← hqX p]
      rfl

theorem wc_qmbt_bof_pushout_chart {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c₁ : Matrix (Fin n) (Fin n) A'} {K : Type u} [CommRing K]
    (ω : wcQuadModelRing A' n (π' ^ 2) c₁ →+* K)
    (hωX : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) = 0)
    (hωπ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π') = 0)
    (lam : A' →+* K) (hlam : ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) = lam)
    (j : Fin n) (φj : wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChart A' n π' c₁ j)
    (hX : ∀ p, φj (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
          (MvPolynomial.X (some j) * wcQmbtChartHat j p))
    (hA : φj.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChart A' n π' c₁ j)) :
    ∃ qj : wcQmbtChart A' n π' c₁ j →+* (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j))),
      IsPushout (CommRingCat.ofHom φj) (CommRingCat.ofHom ω) (CommRingCat.ofHom qj)
        (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
          Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j))))) :=
by
  classical

  have hlam' : ∀ a, ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a) = lam a :=
    fun a => RingHom.congr_fun hlam a
  have hA' : ∀ a, φj (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a) =
      algebraMap A' (wcQmbtChart A' n π' c₁ j) a :=
    fun a => RingHom.congr_fun hA a
  have hP1 : lam π' = 0 := by rw [← hlam' π']; exact hωπ
  set J : Ideal (MvPolynomial (Option (Fin n)) K) :=
    Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j)) with hJdef
  have hJ0 : (MvPolynomial.X (some j) : MvPolynomial (Option (Fin n)) K) ∈ J :=
    Ideal.subset_span ⟨0, rfl⟩

  have hP2 : ∀ p, MvPolynomial.map lam (wcQmbtChartHat (A' := A') j p) =
      wcQmbtChartHat (A' := K) j p := by
    intro p
    unfold wcQmbtChartHat
    split_ifs <;> simp

  have hMAP1 : MvPolynomial.map lam
      (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π' :
        MvPolynomial (Option (Fin n)) A') = MvPolynomial.X (some j) * MvPolynomial.X none := by
    simp [hP1]
  have hMAP2 : MvPolynomial.map lam
      (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) =
      wcQmbtBofQhat K n (c₁.map lam) j - MvPolynomial.X none ^ 2 := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, map_pow, MvPolynomial.map_X, hP2]
    rfl
  have hg2 : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
      (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))

  have hIj : ∀ a ∈ wcQmbtChartIdeal A' n π' c₁ j,
      ((Ideal.Quotient.mk J).comp (MvPolynomial.map lam)) a = 0 := by
    intro a ha
    have hle : wcQmbtChartIdeal A' n π' c₁ j ≤
        RingHom.ker ((Ideal.Quotient.mk J).comp (MvPolynomial.map lam)) := by
      apply Ideal.span_le.mpr
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply]
      rcases hx with rfl | rfl
      · rw [hMAP1, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mul_mem_right _ _ hJ0
      · rw [hMAP2, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨1, rfl⟩
    exact hle ha
  obtain ⟨qj, hqj⟩ : ∃ qj : wcQmbtChart A' n π' c₁ j →+* (MvPolynomial (Option (Fin n)) K ⧸ J),
      ∀ a, qj (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) a) =
        Ideal.Quotient.mk J (MvPolynomial.map lam a) :=
    ⟨Ideal.Quotient.lift _ _ hIj, fun a => Ideal.Quotient.lift_mk _ _ _⟩
  refine ⟨qj, ?_⟩
  have hP5D : ∀ k : K, algebraMap K (MvPolynomial (Option (Fin n)) K ⧸ J) k =
      Ideal.Quotient.mk J (MvPolynomial.C k) := fun k => rfl

  have heq : CommRingCat.ofHom φj ≫ CommRingCat.ofHom qj =
      CommRingCat.ofHom ω ≫ CommRingCat.ofHom
        (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸ J)) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      show qj (φj (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a)) =
        algebraMap K (MvPolynomial (Option (Fin n)) K ⧸ J)
          (ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a))
      rw [hA', hlam', hP5D]
      show qj (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.C a)) = _
      rw [hqj, MvPolynomial.map_C]
    · intro p
      simp only [RingHom.comp_apply]
      show qj (φj (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p))) =
        algebraMap K (MvPolynomial (Option (Fin n)) K ⧸ J)
          (ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)))
      rw [hX p, hqj, hωX p, map_zero, map_mul, MvPolynomial.map_X, map_mul,
        Ideal.Quotient.eq_zero_iff_mem.mpr hJ0, zero_mul]

  have hc : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom φj) (CommRingCat.ofHom ω)) r,
      s.inl.hom (φj r) = s.inr.hom (ω r) := by
    intro s r
    have h := congrArg (fun f => CommRingCat.Hom.hom f r) s.condition
    simpa using h

  have key : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom φj) (CommRingCat.ofHom ω),
      ∃ d : (MvPolynomial (Option (Fin n)) K ⧸ J) →+* s.pt,
        (∀ v, d (Ideal.Quotient.mk J (MvPolynomial.X v)) =
          s.inl.hom (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X v))) ∧
        (∀ k, d (Ideal.Quotient.mk J (MvPolynomial.C k)) = s.inr.hom k) := by
    intro s
    let g : Option (Fin n) → s.pt := fun v =>
      s.inl.hom (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X v))
    have hKEY : (MvPolynomial.eval₂Hom s.inr.hom g).comp (MvPolynomial.map lam) =
        s.inl.hom.comp (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        rw [← hlam' a, ← hc s, hA']
        rfl
      · intro v
        simp only [RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        rfl
    have hE : ∀ a ∈ J, MvPolynomial.eval₂Hom s.inr.hom g a = 0 := by
      intro a ha
      have hle : J ≤ RingHom.ker (MvPolynomial.eval₂Hom s.inr.hom g) := by
        apply Ideal.span_le.mpr
        rintro x ⟨i, rfl⟩
        simp only [SetLike.mem_coe, RingHom.mem_ker]
        fin_cases i
        · show MvPolynomial.eval₂Hom s.inr.hom g (MvPolynomial.X (some j)) = 0
          rw [MvPolynomial.eval₂Hom_X']
          show s.inl.hom (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
            (MvPolynomial.X (some j))) = 0
          have hXj : (MvPolynomial.X (some j) : MvPolynomial (Option (Fin n)) A') =
              MvPolynomial.X (some j) * wcQmbtChartHat (A' := A') j j := by
            simp [wcQmbtChartHat]
          rw [hXj, ← hX j, hc s, hωX j, map_zero]
        · show MvPolynomial.eval₂Hom s.inr.hom g
            (wcQmbtBofQhat K n (c₁.map lam) j - MvPolynomial.X none ^ 2) = 0
          rw [← hMAP2]
          have h1 := RingHom.congr_fun hKEY
            (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * wcQmbtChartHat (A' := A') j p *
              wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2)
          simp only [RingHom.comp_apply] at h1
          rw [h1, hg2, map_zero]
      exact hle ha
    refine ⟨Ideal.Quotient.lift J _ hE, fun v => ?_, fun k => ?_⟩
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
  choose d hdX hdC using key

  refine IsPushout.of_isColimit
    (Limits.PushoutCocone.IsColimit.mk heq (fun s => CommRingCat.ofHom (d s)) ?_ ?_ ?_)
  · intro s
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      rw [hqj, MvPolynomial.map_C, hdC, ← hlam' a, ← hc s, hA']
      rfl
    · intro v
      simp only [RingHom.comp_apply]
      rw [hqj, MvPolynomial.map_X, hdX]
  · intro s
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    ext k
    simp only [RingHom.comp_apply]
    rw [hP5D, hdC]
  · intro s m hl hr
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_ofHom]
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro k
      simp only [RingHom.comp_apply]
      rw [hdC, ← hP5D, ← hr]
      simp
    · intro v
      simp only [RingHom.comp_apply]
      rw [hdX, ← hl]
      simp [hqj]

theorem wc_qmbt_bof_pushout_divisor {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c₁ : Matrix (Fin n) (Fin n) A'} {K : Type u} [CommRing K]
    (ω : wcQuadModelRing A' n (π' ^ 2) c₁ →+* K)
    (hωX : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) = 0)
    (hωπ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π') = 0)
    (lam : A' →+* K) (hlam : ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) = lam)
    (j : Fin n) (φj : wcQuadModelRing A' n (π' ^ 2) c₁ →+* wcQmbtChart A' n π' c₁ j)
    (hX : ∀ p, φj (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
          (MvPolynomial.X (some j) * wcQmbtChartHat j p))
    (hA : φj.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) =
        algebraMap A' (wcQmbtChart A' n π' c₁ j)) :
    ∃ qd : (wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j) →+*
        (MvPolynomial (Option (Fin n)) K ⧸
          Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j))),
      IsPushout (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)).comp φj))
        (CommRingCat.ofHom ω)
        (CommRingCat.ofHom (R := wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j) qd)
        (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
          Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j))))) :=
by
  classical

  have hlam' : ∀ a, ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a) = lam a :=
    fun a => RingHom.congr_fun hlam a
  have hA' : ∀ a, φj (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a) =
      algebraMap A' (wcQmbtChart A' n π' c₁ j) a :=
    fun a => RingHom.congr_fun hA a
  have hP1 : lam π' = 0 := by rw [← hlam' π']; exact hωπ
  set J : Ideal (MvPolynomial (Option (Fin n)) K) :=
    Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j)) with hJdef

  have hJ0 : (MvPolynomial.X (some j) : MvPolynomial (Option (Fin n)) K) ∈ J :=
    Ideal.subset_span ⟨0, rfl⟩
  have hJ1 : (MvPolynomial.X none : MvPolynomial (Option (Fin n)) K) ∈ J :=
    Ideal.subset_span ⟨1, rfl⟩
  have hJ2 : wcQmbtBofQhat K n (c₁.map lam) j ∈ J :=
    Ideal.subset_span ⟨2, rfl⟩

  have hP2 : ∀ p, MvPolynomial.map lam (wcQmbtChartHat (A' := A') j p) =
      wcQmbtChartHat (A' := K) j p := by
    intro p
    unfold wcQmbtChartHat
    split_ifs <;> simp

  have hMAP1 : MvPolynomial.map lam
      (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π' :
        MvPolynomial (Option (Fin n)) A') = MvPolynomial.X (some j) * MvPolynomial.X none := by
    simp [hP1]
  have hMAP2 : MvPolynomial.map lam
      (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) =
      wcQmbtBofQhat K n (c₁.map lam) j - MvPolynomial.X none ^ 2 := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, map_pow, MvPolynomial.map_X, hP2]
    rfl
  have hg2 : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)
      (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))

  have hS0 : Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
      (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)

  have hIj : ∀ a ∈ wcQmbtChartIdeal A' n π' c₁ j,
      ((Ideal.Quotient.mk J).comp (MvPolynomial.map lam)) a = 0 := by
    intro a ha
    have hle : wcQmbtChartIdeal A' n π' c₁ j ≤
        RingHom.ker ((Ideal.Quotient.mk J).comp (MvPolynomial.map lam)) := by
      apply Ideal.span_le.mpr
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply]
      rcases hx with rfl | rfl
      · rw [hMAP1, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mul_mem_right _ _ hJ0
      · rw [hMAP2, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.sub_mem J hJ2 (Ideal.pow_mem_of_mem J hJ1 2 two_pos)
    exact hle ha
  obtain ⟨q0, hq0⟩ : ∃ q0 : wcQmbtChart A' n π' c₁ j →+* (MvPolynomial (Option (Fin n)) K ⧸ J),
      ∀ a, q0 (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) a) =
        Ideal.Quotient.mk J (MvPolynomial.map lam a) :=
    ⟨Ideal.Quotient.lift _ _ hIj, fun a => Ideal.Quotient.lift_mk _ _ _⟩
  have hSq : ∀ b ∈ wcQmbtBofSIdeal A' n π' c₁ j, q0 b = 0 := by
    intro b hb
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hb
    rw [map_mul, hq0, MvPolynomial.map_X, Ideal.Quotient.eq_zero_iff_mem.mpr hJ1, mul_zero]
  obtain ⟨qd, hqd⟩ : ∃ qd : (wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j) →+*
      (MvPolynomial (Option (Fin n)) K ⧸ J),
      ∀ a, qd (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) a)) =
        Ideal.Quotient.mk J (MvPolynomial.map lam a) :=
    ⟨Ideal.Quotient.lift _ q0 hSq, fun a => by rw [Ideal.Quotient.lift_mk, hq0]⟩
  refine ⟨qd, ?_⟩
  have hP5D : ∀ k : K, algebraMap K (MvPolynomial (Option (Fin n)) K ⧸ J) k =
      Ideal.Quotient.mk J (MvPolynomial.C k) := fun k => rfl

  have heq : CommRingCat.ofHom ((Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)).comp φj) ≫
      CommRingCat.ofHom (R := wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j) qd =
      CommRingCat.ofHom ω ≫ CommRingCat.ofHom
        (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸ J)) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      show qd (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
          (φj (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a))) =
        algebraMap K (MvPolynomial (Option (Fin n)) K ⧸ J)
          (ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) a))
      rw [hA', hlam', hP5D]
      show qd (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.C a))) = _
      rw [hqd, MvPolynomial.map_C]
    · intro p
      simp only [RingHom.comp_apply]
      rw [hX p, hqd, hωX p, map_zero, map_mul, MvPolynomial.map_X, map_mul,
        Ideal.Quotient.eq_zero_iff_mem.mpr hJ0, zero_mul]

  have hc : ∀ (s : Limits.PushoutCocone
      (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)).comp φj))
      (CommRingCat.ofHom ω)) r,
      s.inl.hom (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j) (φj r)) = s.inr.hom (ω r) := by
    intro s r
    have h := congrArg (fun f => CommRingCat.Hom.hom f r) s.condition
    simpa using h

  have key : ∀ s : Limits.PushoutCocone
      (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)).comp φj))
      (CommRingCat.ofHom ω),
      ∃ d : (MvPolynomial (Option (Fin n)) K ⧸ J) →+* s.pt,
        (∀ v, d (Ideal.Quotient.mk J (MvPolynomial.X v)) =
          s.inl.hom (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X v)))) ∧
        (∀ k, d (Ideal.Quotient.mk J (MvPolynomial.C k)) = s.inr.hom k) := by
    intro s
    let g : Option (Fin n) → s.pt := fun v =>
      s.inl.hom (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X v)))
    have hKEY : (MvPolynomial.eval₂Hom s.inr.hom g).comp (MvPolynomial.map lam) =
        (s.inl.hom.comp (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j))).comp
          (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j)) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        rw [← hlam' a, ← hc s, hA']
        rfl
      · intro v
        simp only [RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        rfl
    have hgnone : g none = 0 := by
      show s.inl.hom (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X none))) = 0
      rw [hS0, map_zero]
    have hE : ∀ a ∈ J, MvPolynomial.eval₂Hom s.inr.hom g a = 0 := by
      intro a ha
      have hle : J ≤ RingHom.ker (MvPolynomial.eval₂Hom s.inr.hom g) := by
        apply Ideal.span_le.mpr
        rintro x ⟨i, rfl⟩
        simp only [SetLike.mem_coe, RingHom.mem_ker]
        fin_cases i
        · show MvPolynomial.eval₂Hom s.inr.hom g (MvPolynomial.X (some j)) = 0
          rw [MvPolynomial.eval₂Hom_X']
          show s.inl.hom (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c₁ j) (MvPolynomial.X (some j)))) = 0
          have hXj : (MvPolynomial.X (some j) : MvPolynomial (Option (Fin n)) A') =
              MvPolynomial.X (some j) * wcQmbtChartHat (A' := A') j j := by
            simp [wcQmbtChartHat]
          rw [hXj, ← hX j, hc s, hωX j, map_zero]
        · show MvPolynomial.eval₂Hom s.inr.hom g (MvPolynomial.X none) = 0
          rw [MvPolynomial.eval₂Hom_X']
          exact hgnone
        · show MvPolynomial.eval₂Hom s.inr.hom g (wcQmbtBofQhat K n (c₁.map lam) j) = 0
          have hQ : wcQmbtBofQhat K n (c₁.map lam) j =
              MvPolynomial.map lam
                (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * wcQmbtChartHat (A' := A') j p *
                  wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) +
                MvPolynomial.X none ^ 2 := by
            rw [hMAP2]; ring
          have h1 := RingHom.congr_fun hKEY
            (∑ p, ∑ q, MvPolynomial.C (c₁ p q) * wcQmbtChartHat (A' := A') j p *
              wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2)
          simp only [RingHom.comp_apply] at h1
          rw [hQ, map_add, h1, hg2, map_zero, map_zero, map_pow, MvPolynomial.eval₂Hom_X',
            hgnone, zero_add, zero_pow two_ne_zero]
      exact hle ha
    refine ⟨Ideal.Quotient.lift J _ hE, fun v => ?_, fun k => ?_⟩
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
  choose d hdX hdC using key

  refine IsPushout.of_isColimit
    (Limits.PushoutCocone.IsColimit.mk heq (fun s => CommRingCat.ofHom (d s)) ?_ ?_ ?_)
  · intro s
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    apply Ideal.Quotient.ringHom_ext
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      rw [hqd, MvPolynomial.map_C, hdC, ← hlam' a, ← hc s, hA']
      rfl
    · intro v
      simp only [RingHom.comp_apply]
      rw [hqd, MvPolynomial.map_X, hdX]
  · intro s
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    ext k
    simp only [RingHom.comp_apply]
    rw [hP5D, hdC]
  · intro s m hl hr
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_ofHom]
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro k
      simp only [RingHom.comp_apply]
      rw [hdC, ← hP5D, ← hr]
      simp
    · intro v
      simp only [RingHom.comp_apply]
      rw [hdX, ← hl]
      simp [hqd]

theorem wc_qmbt_bof_jacobian_cover_smooth (K : Type u) [CommRing K] {σ : Type} [Fintype σ]
    [DecidableEq σ] {r : ℕ} (F : Fin r → MvPolynomial σ K) (I : Ideal (MvPolynomial σ K))
    (hI : I = Ideal.span (Set.range F)) {ι : Type} [Finite ι] (v : ι → Fin r → σ)
    (hv : ∀ i, Function.Injective (v i))
    (hspan : Ideal.span (Set.range fun i => Ideal.Quotient.mk I
        (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det) = ⊤) :
    SmoothOfRelativeDimension (Fintype.card σ - r)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial σ K ⧸ I)))) :=
by
  classical
  subst hI

  have hs1 : ∀ (R : Type u) [CommRing R] [Algebra K R] {ι : Type} (f : ι → R),
      Ideal.span (Set.range f) = ⊤ → ∀ (N : ℕ),
      (∀ i, Algebra.IsStandardSmoothOfRelativeDimension N K (Localization.Away (f i))) →
      SmoothOfRelativeDimension N (Spec.map (CommRingCat.ofHom (algebraMap K R))) := by
    intro R _ _ ι f hf N hsm
    have hU : iSup (fun i => (PrimeSpectrum.basicOpen (f i) : (Spec (.of R)).Opens)) = ⊤ :=
      PrimeSpectrum.iSup_basicOpen_eq_top_iff.mpr hf
    refine @IsZariskiLocalAtSource.of_iSup_eq_top (@SmoothOfRelativeDimension N)
      HasRingHomProperty.instIsZariskiLocalAtSource _ _ _ ι _ hU ?_
    intro i
    have hfac : (basicOpenIsoSpecAway (R := CommRingCat.of R) (f i)).inv ≫
        Scheme.Opens.ι (X := Spec (.of R)) (PrimeSpectrum.basicOpen (f i)) =
        Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (f i)))) := by
      simp [basicOpenIsoSpecAway]
    have hfac2 := (Iso.inv_comp_eq _).mp hfac
    have hcomp : Scheme.Opens.ι (X := Spec (.of R)) (PrimeSpectrum.basicOpen (f i)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K R)) =
        (basicOpenIsoSpecAway (R := CommRingCat.of R) (f i)).hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap K (Localization.Away (f i)))) := by
      rw [IsScalarTower.algebraMap_eq K R (Localization.Away (f i)), CommRingCat.ofHom_comp,
        Spec.map_comp, ← Category.assoc, ← hfac2]
    show SmoothOfRelativeDimension N
      (Scheme.Opens.ι (X := Spec (.of R)) (PrimeSpectrum.basicOpen (f i)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K R)))
    rw [hcomp]
    haveI : SmoothOfRelativeDimension N
        (Spec.map (CommRingCat.ofHom (algebraMap K (Localization.Away (f i))))) :=
      (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension N)).mpr
        (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _
          ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap N).mpr (hsm i)))
    rw [show N = 0 + N by omega]
    infer_instance

  have hsm : ∀ i, Algebra.IsStandardSmoothOfRelativeDimension (Fintype.card σ - r) K
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det)) := by
    intro i
    let P : Algebra.PreSubmersivePresentation K (MvPolynomial σ K ⧸ Ideal.span (Set.range F))
        σ (Fin r) :=
      Algebra.PreSubmersivePresentation.mk (Algebra.Presentation.naive (v := F)) (v i) (hv i)
    have hval : ∀ x : MvPolynomial σ K,
        algebraMap P.Ring (MvPolynomial σ K ⧸ Ideal.span (Set.range F)) x =
          Ideal.Quotient.mk (Ideal.span (Set.range F)) x := by
      intro x
      rw [Algebra.Generators.algebraMap_apply]
      have hh : MvPolynomial.aeval P.val = Ideal.Quotient.mkₐ K (Ideal.span (Set.range F)) := by
        apply MvPolynomial.algHom_ext
        intro j
        rw [MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
        rfl
      exact congrArg (fun f => f x) hh
    have hPj : P.jacobian = Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      have hmat : P.jacobiMatrix =
          Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b) := by
        ext a b
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        rfl
      rw [hmat]
      exact hval _
    let Q := Algebra.PreSubmersivePresentation.localizationAway
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det))
      (Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det)
    let C := Q.comp P
    have hC : C.jacobian = algebraMap _ (Localization.Away (Ideal.Quotient.mk
        (Ideal.span (Set.range F))
        (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det)) P.jacobian *
        algebraMap _ (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range F))
          (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det))
          (Ideal.Quotient.mk (Ideal.span (Set.range F))
            (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det) := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.smul_def, Algebra.PreSubmersivePresentation.localizationAway_jacobian]
    have hunit : IsUnit C.jacobian := by
      rw [hC, hPj]
      exact (IsLocalization.Away.algebraMap_isUnit _).mul
        (IsLocalization.Away.algebraMap_isUnit _)
    have hdim : C.dimension = Fintype.card σ - r := by
      rw [Algebra.Presentation.dimension.eq_1]
      simp only [Nat.card_sum, Nat.card_unique, Nat.card_eq_fintype_card, Fintype.card_unit,
        Fintype.card_fin, Fintype.card_sum]
      omega
    exact (Algebra.SubmersivePresentation.mk C hunit).isStandardSmoothOfRelativeDimension hdim
  exact hs1 _ (fun i => Ideal.Quotient.mk (Ideal.span (Set.range F))
      (Matrix.of fun a b : Fin r => MvPolynomial.pderiv (v i a) (F b)).det) hspan _ hsm

theorem wc_qmbt_bof_minors_none {K : Type u} [Field K] {n : ℕ} (c : Matrix (Fin n) (Fin n) K)
    (hc : IsUnit (c + c.transpose).det) :
    Ideal.span (Set.range fun r : Fin n => Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c)
      (Matrix.of fun a b : Fin 1 => MvPolynomial.pderiv ((fun _ : Fin 1 => r) a)
        (wcQmbtBofRelNone K n c b)).det) = ⊤ :=
by
  classical

  have hterm : ∀ (r p q : Fin n), MvPolynomial.pderiv r
      (MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) K) =
      (if q = r then MvPolynomial.C (c p q) * MvPolynomial.X p else 0) +
      (if p = r then MvPolynomial.C (c p q) * MvPolynomial.X q else 0) := by
    intro r p q
    rw [Derivation.leibniz, Derivation.leibniz, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X,
      MvPolynomial.pderiv_X, Pi.single_apply, Pi.single_apply]
    simp only [smul_eq_mul]
    split_ifs <;> ring
  have hder : ∀ r : Fin n, MvPolynomial.pderiv r
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 1 : MvPolynomial (Fin n) K) =
      ∑ s, MvPolynomial.C ((c + c.transpose) r s) * MvPolynomial.X s := by
    intro r
    rw [map_sub, MvPolynomial.pderiv_C, sub_zero, map_sum]
    have eA : ∀ p : Fin n, (∑ q, (if q = r then
        (MvPolynomial.C (c p q) * MvPolynomial.X p : MvPolynomial (Fin n) K) else 0)) =
        MvPolynomial.C (c p r) * MvPolynomial.X p := by
      intro p
      rw [Finset.sum_ite_eq']
      simp
    have eB : (∑ p : Fin n, ∑ q, (if p = r then
        (MvPolynomial.C (c p q) * MvPolynomial.X q : MvPolynomial (Fin n) K) else 0)) =
        ∑ q, MvPolynomial.C (c r q) * MvPolynomial.X q := by
      rw [Finset.sum_eq_single r]
      · simp
      · intro p _ hp
        simp [hp]
      · intro h; exact absurd (Finset.mem_univ r) h
    calc (∑ p, MvPolynomial.pderiv r (∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
          MvPolynomial.X q : MvPolynomial (Fin n) K))
        = ∑ p : Fin n, ((∑ q, (if q = r then
            (MvPolynomial.C (c p q) * MvPolynomial.X p : MvPolynomial (Fin n) K) else 0)) +
          ∑ q, (if p = r then
            (MvPolynomial.C (c p q) * MvPolynomial.X q : MvPolynomial (Fin n) K) else 0)) := by
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [map_sum, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl fun q _ => hterm r p q
      _ = ∑ s, MvPolynomial.C ((c + c.transpose) r s) * MvPolynomial.X s := by
          rw [Finset.sum_add_distrib, eB]
          simp only [eA]
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [Matrix.add_apply, Matrix.transpose_apply, map_add]
          ring

  have hN : (c + c.transpose)⁻¹ * (c + c.transpose) = 1 := Matrix.nonsing_inv_mul _ hc
  have hX : ∀ q : Fin n, (MvPolynomial.X q : MvPolynomial (Fin n) K) =
      ∑ r, MvPolynomial.C ((c + c.transpose)⁻¹ q r) *
        ∑ s, MvPolynomial.C ((c + c.transpose) r s) * MvPolynomial.X s := by
    intro q
    have h1 : ∀ s, (∑ r, (c + c.transpose)⁻¹ q r * (c + c.transpose) r s) =
        (1 : Matrix (Fin n) (Fin n) K) q s := by
      intro s; rw [← hN, Matrix.mul_apply]
    calc (MvPolynomial.X q : MvPolynomial (Fin n) K)
        = ∑ s, MvPolynomial.C ((1 : Matrix (Fin n) (Fin n) K) q s) * MvPolynomial.X s := by
          rw [Finset.sum_eq_single q]
          · rw [Matrix.one_apply_eq, MvPolynomial.C_1, one_mul]
          · intro s _ hs
            rw [Matrix.one_apply_ne' hs, MvPolynomial.C_0, zero_mul]
          · intro h; exact absurd (Finset.mem_univ q) h
      _ = ∑ s, ∑ r, MvPolynomial.C ((c + c.transpose)⁻¹ q r) *
            (MvPolynomial.C ((c + c.transpose) r s) * MvPolynomial.X s) := by
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [← h1 s, map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [map_mul, mul_assoc]
      _ = _ := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [Finset.mul_sum]

  have hdet : ∀ r : Fin n, (Matrix.of fun a b : Fin 1 => MvPolynomial.pderiv ((fun _ : Fin 1 => r) a)
      (wcQmbtBofRelNone K n c b)).det =
      ∑ s, MvPolynomial.C ((c + c.transpose) r s) * MvPolynomial.X s := by
    intro r
    rw [Matrix.det_fin_one, Matrix.of_apply]
    exact hder r

  have hX' : ∀ q : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c) (MvPolynomial.X q) ∈
      Ideal.span (Set.range fun r : Fin n => Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c)
        (∑ s, MvPolynomial.C ((c + c.transpose) r s) * MvPolynomial.X s)) := by
    intro q
    rw [hX q, map_sum]
    refine Ideal.sum_mem _ fun r _ => ?_
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨r, rfl⟩)
  have hQ : Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) ∈
      Ideal.span (Set.range fun r : Fin n => Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c)
        (∑ s, MvPolynomial.C ((c + c.transpose) r s) * MvPolynomial.X s)) := by
    rw [map_sum]
    refine Ideal.sum_mem _ fun p _ => ?_
    rw [map_sum]
    refine Ideal.sum_mem _ fun q _ => ?_
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (hX' q)
  have hF : Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  have h1 : (1 : MvPolynomial (Fin n) K ⧸ wcQuadModelIdeal K n 1 c) =
      Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c)
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) -
      Ideal.Quotient.mk (wcQuadModelIdeal K n 1 c)
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C 1) := by
    rw [← map_sub, sub_sub_cancel, MvPolynomial.C_1, map_one]
  rw [Ideal.eq_top_iff_one]
  refine Ideal.span_mono ?_ (show (1 : MvPolynomial (Fin n) K ⧸ wcQuadModelIdeal K n 1 c) ∈ _ from
    by rw [h1, hF, sub_zero]; exact hQ)
  rintro _ ⟨r, rfl⟩
  exact ⟨r, congrArg _ (hdet r)⟩

theorem wc_qmbt_bof_minors_chart {K : Type u} [Field K] {n : ℕ} (c : Matrix (Fin n) (Fin n) K)
    (hc : IsUnit (c + c.transpose).det) (j : Fin n) :
    Ideal.span (Set.range fun v : {v : Option (Fin n) // v ≠ some j} =>
      Ideal.Quotient.mk (Ideal.span (Set.range (wcQmbtBofRelChart K n c j)))
        (Matrix.of fun a b : Fin 2 => MvPolynomial.pderiv (![some j, v.1] a)
          (wcQmbtBofRelChart K n c j b)).det) = ⊤ :=
by
  set I := Ideal.span (Set.range (wcQmbtBofRelChart K n c j)) with hI
  set J := Ideal.span (Set.range fun v : {v : Option (Fin n) // v ≠ some j} =>
      Ideal.Quotient.mk I
        (Matrix.of fun a b : Fin 2 => MvPolynomial.pderiv (![some j, v.1] a)
          (wcQmbtBofRelChart K n c j b)).det) with hJ

  have hdet : ∀ v : Option (Fin n), v ≠ some j →
      (Matrix.of fun a b : Fin 2 => MvPolynomial.pderiv (![some j, v] a)
          (wcQmbtBofRelChart K n c j b)).det =
        MvPolynomial.pderiv v (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) := by
    intro v hv
    rw [Matrix.det_fin_two]
    change MvPolynomial.pderiv (some j) (MvPolynomial.X (some j)) *
        MvPolynomial.pderiv v (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) -
      MvPolynomial.pderiv (some j) (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) *
        MvPolynomial.pderiv v (MvPolynomial.X (some j)) = _
    rw [MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_X_of_ne hv.symm]
    ring

  have hhat_j : wcQmbtChartHat (A' := K) j j = 1 := by simp [wcQmbtChartHat]
  have dhat_none : ∀ q, MvPolynomial.pderiv none (wcQmbtChartHat (A' := K) j q) = 0 := by
    intro q
    unfold wcQmbtChartHat
    split_ifs
    · simp
    · exact MvPolynomial.pderiv_X_of_ne (by simp)
  have dhat_some : ∀ r, r ≠ j → ∀ q, MvPolynomial.pderiv (some r) (wcQmbtChartHat (A' := K) j q) =
      if q = r then 1 else 0 := by
    intro r hr q
    unfold wcQmbtChartHat
    by_cases hqj : q = j
    · subst hqj
      simp [hr.symm]
    · rw [if_neg hqj]
      by_cases hqr : q = r
      · subst hqr
        simp
      · rw [if_neg hqr]
        exact MvPolynomial.pderiv_X_of_ne (by simpa using hqr)
  have dterm : ∀ (w : Option (Fin n)) (a : K) (x y : MvPolynomial (Option (Fin n)) K),
      MvPolynomial.pderiv w (MvPolynomial.C a * x * y) =
        MvPolynomial.C a * x * MvPolynomial.pderiv w y +
          MvPolynomial.C a * y * MvPolynomial.pderiv w x := by
    intro w a x y
    rw [Derivation.leibniz, Derivation.leibniz, MvPolynomial.pderiv_C]
    simp only [smul_eq_mul]
    ring
  have hQdef : wcQmbtBofQhat K n c j = ∑ p, ∑ q, MvPolynomial.C (c p q) *
      wcQmbtChartHat (A' := K) j p * wcQmbtChartHat (A' := K) j q := rfl
  have dQ_none : MvPolynomial.pderiv none (wcQmbtBofQhat K n c j) = 0 := by
    rw [hQdef]
    simp only [map_sum, dterm, dhat_none, mul_zero, add_zero, Finset.sum_const_zero]
  have dQ_some : ∀ r, r ≠ j → MvPolynomial.pderiv (some r) (wcQmbtBofQhat K n c j) =
      ∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q := by
    intro r hr
    have hterm : ∀ p q, MvPolynomial.pderiv (some r)
        (MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p * wcQmbtChartHat (A' := K) j q) =
        (if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0) +
          (if p = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q else 0) := by
      intro p q
      rw [dterm, dhat_some r hr, dhat_some r hr]
      split_ifs <;> ring
    calc MvPolynomial.pderiv (some r) (wcQmbtBofQhat K n c j)
        = ∑ p, ∑ q, ((if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0) +
          (if p = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q else 0)) := by
          rw [hQdef, map_sum]
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [map_sum]
          exact Finset.sum_congr rfl fun q _ => hterm p q
      _ = ∑ p, MvPolynomial.C (c p r) * wcQmbtChartHat (A' := K) j p +
          ∑ q, MvPolynomial.C (c r q) * wcQmbtChartHat (A' := K) j q := by
          have e2 : ∑ p, ∑ q, (if p = r then MvPolynomial.C (c p q) *
              wcQmbtChartHat (A' := K) j q else 0) =
              ∑ q, MvPolynomial.C (c r q) * wcQmbtChartHat (A' := K) j q := by
            rw [Finset.sum_comm]
            simp only [Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.mem_univ, if_true]
          have e1 : ∑ p, ∑ q, (if q = r then MvPolynomial.C (c p q) *
              wcQmbtChartHat (A' := K) j p else 0) =
              ∑ p, MvPolynomial.C (c p r) * wcQmbtChartHat (A' := K) j p := by
            simp only [Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.mem_univ, if_true]
          rw [← e1, ← e2, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl fun p _ => Finset.sum_add_distrib
      _ = _ := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun q _ => ?_)
          rw [Matrix.add_apply, Matrix.transpose_apply, map_add]
          ring
  have hsq : ∀ w, MvPolynomial.pderiv w (MvPolynomial.X none ^ 2 : MvPolynomial (Option (Fin n)) K) =
      2 * MvPolynomial.X none * MvPolynomial.pderiv w (MvPolynomial.X none) := by
    intro w
    rw [sq, Derivation.leibniz]
    simp only [smul_eq_mul]
    ring
  have hD_none : MvPolynomial.pderiv none (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) =
      -(2 * MvPolynomial.X none) := by
    rw [map_sub, dQ_none, hsq, MvPolynomial.pderiv_X_self]
    ring
  have hD_some : ∀ r, r ≠ j →
      MvPolynomial.pderiv (some r) (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) =
        ∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q := by
    intro r hr
    rw [map_sub, dQ_some r hr, hsq, MvPolynomial.pderiv_X_of_ne (by simp), mul_zero, sub_zero]

  have euler : ∑ r, wcQmbtChartHat (A' := K) j r *
      ∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q =
        2 * wcQmbtBofQhat K n c j := by
    have h1 : ∀ r, wcQmbtChartHat (A' := K) j r *
        ∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q =
        ∑ q, MvPolynomial.C (c r q) * wcQmbtChartHat (A' := K) j r * wcQmbtChartHat (A' := K) j q +
        ∑ q, MvPolynomial.C (c q r) * wcQmbtChartHat (A' := K) j q *
          wcQmbtChartHat (A' := K) j r := by
      intro r
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [Matrix.add_apply, Matrix.transpose_apply, map_add]
      ring
    rw [Finset.sum_congr rfl fun r _ => h1 r, Finset.sum_add_distrib,
      Finset.sum_comm (f := fun r q => MvPolynomial.C (c q r) * wcQmbtChartHat (A' := K) j q *
          wcQmbtChartHat (A' := K) j r), two_mul, hQdef]

  have hinvc : ∑ r, MvPolynomial.C ((c + c.transpose)⁻¹ j r) *
      ∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q = 1 := by
    have hinv := Matrix.nonsing_inv_mul (c + c.transpose) hc
    have h2 : ∀ q, ∑ r, MvPolynomial.C ((c + c.transpose)⁻¹ j r) *
        (MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q) =
        MvPolynomial.C (((c + c.transpose)⁻¹ * (c + c.transpose)) j q) *
          wcQmbtChartHat (A' := K) j q := by
      intro q
      rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_mul]
      ring
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm, Finset.sum_congr rfl fun q _ => h2 q, hinv,
      Finset.sum_eq_single j]
    · rw [Matrix.one_apply_eq, map_one, one_mul, hhat_j]
    · intro q _ hq
      rw [Matrix.one_apply_ne (Ne.symm hq), map_zero, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ j) h

  have hF1 : Ideal.Quotient.mk I (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨1, rfl⟩)
  have hmem : ∀ v (hv : v ≠ some j), Ideal.Quotient.mk I
      (MvPolynomial.pderiv v (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2)) ∈ J := by
    intro v hv
    rw [← hdet v hv]
    exact Ideal.subset_span ⟨⟨v, hv⟩, rfl⟩

  have hL : ∀ r, r ≠ j → Ideal.Quotient.mk I
      (∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q) ∈ J := by
    intro r hr
    rw [← hD_some r hr]
    exact hmem (some r) (fun h => hr (Option.some_injective _ h))

  have h2Q : Ideal.Quotient.mk I (2 * wcQmbtBofQhat K n c j) ∈ J := by
    have e : (2 : MvPolynomial (Option (Fin n)) K) * wcQmbtBofQhat K n c j =
        2 * (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) -
          MvPolynomial.X none *
            MvPolynomial.pderiv none (wcQmbtBofQhat K n c j - MvPolynomial.X none ^ 2) := by
      rw [hD_none]
      ring
    rw [e, map_sub, map_mul, map_mul, hF1, mul_zero, zero_sub]
    exact J.neg_mem (J.mul_mem_left _ (hmem none (by simp)))

  have hLj : Ideal.Quotient.mk I
      (∑ q, MvPolynomial.C ((c + c.transpose) j q) * wcQmbtChartHat (A' := K) j q) ∈ J := by
    have e := euler
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j), hhat_j, one_mul] at e
    rw [eq_sub_of_add_eq e, map_sub, map_sum]
    refine J.sub_mem h2Q (J.sum_mem fun r hr => ?_)
    rw [map_mul]
    exact J.mul_mem_left _ (hL r (Finset.ne_of_mem_erase hr))

  have hall : ∀ r, Ideal.Quotient.mk I
      (∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q) ∈ J := by
    intro r
    by_cases hr : r = j
    · rw [hr]; exact hLj
    · exact hL r hr
  rw [Ideal.eq_top_iff_one, ← map_one (Ideal.Quotient.mk I), ← hinvc, map_sum]
  exact J.sum_mem fun r _ => by rw [map_mul]; exact J.mul_mem_left _ (hall r)

theorem wc_qmbt_bof_minors_divisor {K : Type u} [Field K] {n : ℕ} (c : Matrix (Fin n) (Fin n) K)
    (hc : IsUnit (c + c.transpose).det) (j : Fin n) :
    Ideal.span (Set.range fun p : {p : Fin n // p ≠ j} =>
      Ideal.Quotient.mk (Ideal.span (Set.range (wcQmbtBofRelDiv K n c j)))
        (Matrix.of fun a b : Fin 3 => MvPolynomial.pderiv (![some j, none, some p.1] a)
          (wcQmbtBofRelDiv K n c j b)).det) = ⊤ :=
by
  classical
  set I := Ideal.span (Set.range (wcQmbtBofRelDiv K n c j)) with hI
  set J := Ideal.span (Set.range fun p : {p : Fin n // p ≠ j} =>
      Ideal.Quotient.mk I
        (Matrix.of fun a b : Fin 3 => MvPolynomial.pderiv (![some j, none, some p.1] a)
          (wcQmbtBofRelDiv K n c j b)).det) with hJ

  have s1 : ∀ p : Fin n, p ≠ j →
      (Matrix.of fun a b : Fin 3 => MvPolynomial.pderiv (![some j, none, some p] a)
        (wcQmbtBofRelDiv K n c j b)).det =
      MvPolynomial.pderiv (some p) (wcQmbtBofQhat K n c j) := by
    intro p hp
    have hsp : (some j : Option (Fin n)) ≠ some p := fun h => hp (Option.some_injective _ h).symm
    have hnj : (none : Option (Fin n)) ≠ some j := (Option.some_ne_none j).symm
    have hnp : (none : Option (Fin n)) ≠ some p := (Option.some_ne_none p).symm
    have a00 : MvPolynomial.pderiv (some j) (MvPolynomial.X (R := K) (some j)) = 1 :=
      MvPolynomial.pderiv_X_self _
    have a11 : MvPolynomial.pderiv none (MvPolynomial.X (R := K) (none : Option (Fin n))) = 1 :=
      MvPolynomial.pderiv_X_self _
    have a01 : MvPolynomial.pderiv (some j) (MvPolynomial.X (R := K) (none : Option (Fin n))) = 0 :=
      MvPolynomial.pderiv_X_of_ne hnj
    have a10 : MvPolynomial.pderiv none (MvPolynomial.X (R := K) (some j)) = 0 :=
      MvPolynomial.pderiv_X_of_ne (Option.some_ne_none j)
    have a20 : MvPolynomial.pderiv (some p) (MvPolynomial.X (R := K) (some j)) = 0 :=
      MvPolynomial.pderiv_X_of_ne hsp
    have a21 : MvPolynomial.pderiv (some p) (MvPolynomial.X (R := K) (none : Option (Fin n))) = 0 :=
      MvPolynomial.pderiv_X_of_ne hnp
    rw [Matrix.det_fin_three]
    simp only [Matrix.of_apply, wcQmbtBofRelDiv, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    rw [a00, a11, a01, a10, a20, a21]
    ring

  have hd : ∀ r : Fin n, r ≠ j → ∀ q : Fin n,
      MvPolynomial.pderiv (some r) (wcQmbtChartHat (A' := K) j q) = if q = r then 1 else 0 := by
    intro r hr q
    by_cases hqj : q = j
    · subst hqj
      rw [if_neg (Ne.symm hr)]
      simp only [wcQmbtChartHat, if_pos rfl]
      exact (MvPolynomial.pderiv (some r)).map_one_eq_zero
    · simp only [wcQmbtChartHat, if_neg hqj]
      by_cases hqr : q = r
      · subst hqr
        rw [if_pos rfl]
        exact MvPolynomial.pderiv_X_self _
      · rw [if_neg hqr]
        exact MvPolynomial.pderiv_X_of_ne (fun h => hqr (Option.some_injective _ h))

  have s2 : ∀ r : Fin n, r ≠ j → MvPolynomial.pderiv (some r) (wcQmbtBofQhat K n c j) =
      ∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q := by
    intro r hr
    have hterm : ∀ p q : Fin n, MvPolynomial.pderiv (some r)
        (MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p * wcQmbtChartHat (A' := K) j q) =
        (if p = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q else 0) +
        (if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0) := by
      intro p q
      rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, hd r hr p,
        hd r hr q]
      split_ifs <;> ring
    have hA : ∀ p : Fin n, ∑ q : Fin n,
        (if p = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q else 0) =
        if p = r then ∑ q : Fin n, MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j q
        else 0 := by
      intro p
      split_ifs <;> simp
    have hB : ∀ p : Fin n, ∑ q : Fin n,
        (if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0) =
        MvPolynomial.C (c p r) * wcQmbtChartHat (A' := K) j p := by
      intro p
      rw [Finset.sum_ite_eq']
      simp
    have hsum : MvPolynomial.pderiv (some r) (wcQmbtBofQhat K n c j) =
        ∑ p : Fin n, ∑ q : Fin n, ((if p = r then MvPolynomial.C (c p q) *
          wcQmbtChartHat (A' := K) j q else 0) +
        (if q = r then MvPolynomial.C (c p q) * wcQmbtChartHat (A' := K) j p else 0)) := by
      simp only [wcQmbtBofQhat, map_sum, hterm]
    rw [hsum]
    simp only [Finset.sum_add_distrib, hA, hB]
    rw [Finset.sum_ite_eq']
    simp only [Finset.mem_univ, ite_true]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    simp only [Matrix.add_apply, Matrix.transpose_apply, map_add]
    ring

  have s3 : ∀ w : Fin n → MvPolynomial (Option (Fin n)) K,
      ∑ r, w r * ∑ q, MvPolynomial.C ((c + c.transpose) r q) * w q =
        2 * ∑ p, ∑ q, MvPolynomial.C (c p q) * w p * w q := by
    intro w
    have e1 : ∀ r, w r * ∑ q, MvPolynomial.C ((c + c.transpose) r q) * w q =
        ∑ q, MvPolynomial.C (c r q) * w r * w q + ∑ q, MvPolynomial.C (c q r) * w q * w r := by
      intro r
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun q _ => ?_
      simp only [Matrix.add_apply, Matrix.transpose_apply, map_add]
      ring
    rw [Finset.sum_congr rfl fun r _ => e1 r, Finset.sum_add_distrib,
      Finset.sum_comm (f := fun r q => MvPolynomial.C (c q r) * w q * w r)]
    ring

  have s4 : ∀ (M : Matrix (Fin n) (Fin n) K), IsUnit M.det →
      ∀ (w : Fin n → MvPolynomial (Option (Fin n)) K) (q : Fin n),
      ∑ r, MvPolynomial.C (M⁻¹ q r) * ∑ s, MvPolynomial.C (M r s) * w s = w q := by
    intro M hM w q
    have hinv := Matrix.nonsing_inv_mul M hM
    calc ∑ r, MvPolynomial.C (M⁻¹ q r) * ∑ s, MvPolynomial.C (M r s) * w s
        = ∑ s, MvPolynomial.C ((M⁻¹ * M) q s) * w s := by
          simp only [Finset.mul_sum, Matrix.mul_apply, map_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun s _ => Finset.sum_congr rfl fun r _ => ?_
          rw [map_mul]; ring
      _ = w q := by
          rw [hinv]
          simp [Matrix.one_apply, apply_ite MvPolynomial.C]

  have hQ : Ideal.Quotient.mk I (wcQmbtBofQhat K n c j) = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨2, rfl⟩
  have hhj : wcQmbtChartHat (A' := K) j j = 1 := if_pos rfl
  have hLr : ∀ r : Fin n, r ≠ j → Ideal.Quotient.mk I
      (∑ q, MvPolynomial.C ((c + c.transpose) r q) * wcQmbtChartHat (A' := K) j q) ∈ J := by
    intro r hr
    rw [← s2 r hr, ← s1 r hr]
    exact Ideal.subset_span ⟨⟨r, hr⟩, rfl⟩
  have hLj : Ideal.Quotient.mk I
      (∑ q, MvPolynomial.C ((c + c.transpose) j q) * wcQmbtChartHat (A' := K) j q) ∈ J := by
    have e := s3 (wcQmbtChartHat (A' := K) j)
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j), hhj, one_mul] at e
    have e2 := eq_sub_of_add_eq e
    rw [e2, map_sub, map_mul]
    have hQ' : Ideal.Quotient.mk I (∑ p, ∑ q, MvPolynomial.C (c p q) *
        wcQmbtChartHat (A' := K) j p * wcQmbtChartHat (A' := K) j q) = 0 := hQ
    rw [hQ', mul_zero, zero_sub]
    refine J.neg_mem ?_
    rw [map_sum]
    refine J.sum_mem fun r hr => ?_
    rw [map_mul]
    exact J.mul_mem_left _ (hLr r (Finset.ne_of_mem_erase hr))
  rw [Ideal.eq_top_iff_one]
  have e := s4 (c + c.transpose) hc (wcQmbtChartHat (A' := K) j) j
  rw [hhj] at e
  rw [← map_one (Ideal.Quotient.mk I), ← e, map_sum]
  refine J.sum_mem fun r _ => ?_
  rw [map_mul]
  refine J.mul_mem_left _ ?_
  by_cases hr : r = j
  · subst hr; exact hLj
  · exact hLr r hr

theorem wc_qmbt_bof_chartwise_smooth {X₁ S T : Scheme.{u}} (r₁ : X₁ ⟶ S) (w : T ⟶ S) (m : ℕ)
    (hloc : ∀ x : X₁, ∃ (U V : Scheme.{u}) (e : U ⟶ X₁) (_ : IsOpenImmersion e)
      (a : V ⟶ U) (b : V ⟶ T),
      x ∈ Set.range e ∧ IsPullback a b (e ≫ r₁) w ∧ SmoothOfRelativeDimension m b) :
    SmoothOfRelativeDimension m (Limits.pullback.snd r₁ w) :=
by
  choose U V e he a b hx hsq hsm using hloc
  have hw : ∀ x, (a x ≫ e x) ≫ r₁ = b x ≫ w := fun x => by
    rw [Category.assoc]; exact (hsq x).w
  let ι : ∀ x, V x ⟶ Limits.pullback r₁ w := fun x => Limits.pullback.lift (a x ≫ e x) (b x) (hw x)
  have hιs : ∀ x, ι x ≫ Limits.pullback.snd r₁ w = b x := fun x => Limits.pullback.lift_snd _ _ _
  have hιf : ∀ x, ι x ≫ Limits.pullback.fst r₁ w = a x ≫ e x := fun x =>
    Limits.pullback.lift_fst _ _ _
  have hb : ∀ x, IsPullback (a x) (ι x) (e x) (Limits.pullback.fst r₁ w) := by
    intro x
    refine IsPullback.of_bot ?_ (hιf x).symm (IsPullback.of_hasPullback r₁ w)
    rw [hιs x]
    exact hsq x
  have hιo : ∀ x, IsOpenImmersion (ι x) := fun x =>
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) (hb x) (he x)
  have hcov : ∀ p : ↥(Limits.pullback r₁ w), ∃ (x : X₁) (y : V x), ι x y = p := by
    intro p
    let x := Limits.pullback.fst r₁ w p
    obtain ⟨u, hu⟩ := hx x
    obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback (f := e x)
      (g := Limits.pullback.fst r₁ w) u p hu
    let φ := IsPullback.isoIsPullback _ _ (IsPullback.of_hasPullback (e x)
      (Limits.pullback.fst r₁ w)) (hb x)
    refine ⟨x, φ.hom z, ?_⟩
    rw [← Scheme.Hom.comp_apply, IsPullback.isoIsPullback_hom_snd, hz]
  let 𝒰 : (Limits.pullback r₁ w).OpenCover :=
    Scheme.Cover.mkOfCovers X₁ V ι hcov hιo
  have : IsZariskiLocalAtSource (@SmoothOfRelativeDimension m) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  refine IsZariskiLocalAtSource.of_openCover (P := @SmoothOfRelativeDimension m) 𝒰 ?_
  intro i
  show SmoothOfRelativeDimension m (ι i ≫ Limits.pullback.snd r₁ w)
  rw [hιs i]
  exact hsm i

theorem wc_qmbt_sfp_blowup_origin_fibre {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c₁ : Matrix (Fin n) (Fin n) A'} (hc₁ : IsUnit (c₁ + c₁.transpose).det)
    {X₁ : Scheme.{u}} (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c₁)))
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c₁))).inv.hom
        (wcQmbtGen A' n π' c₁ k)))) r₁)
    {K : Type u} [Field K] (ω : wcQuadModelRing A' n (π' ^ 2) c₁ →+* K)
    (hωX : ∀ p, ω (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c₁) (MvPolynomial.X p)) = 0)
    (hωπ : ω (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁) π') = 0) :
    SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
    ∃ (Y : Scheme.{u}) (i : Y ⟶ Limits.pullback r₁ (Spec.map (CommRingCat.ofHom ω))),
      IsClosedImmersion i ∧
      SmoothOfRelativeDimension (n - 2) (i ≫ Limits.pullback.snd r₁ (Spec.map (CommRingCat.ofHom ω))) ∧
      ∃ O : (Limits.pullback r₁ (Spec.map (CommRingCat.ofHom ω))).Opens,
        (O : Set ↥(Limits.pullback r₁ (Spec.map (CommRingCat.ofHom ω)))) = (Set.range i)ᶜ ∧
        ∃ c' : Matrix (Fin n) (Fin n) K, IsUnit (c' + c'.transpose).det ∧
          Nonempty (O.toScheme ≅ Spec (.of (wcQuadModelRing K n 1 c'))) :=
by
  classical
  obtain ⟨φN, φ, eN, e, hNX, hNA, hNgen, hNup, hφX, hφA, hnzd, hgen, hNo, heo, hN, he, hcov⟩ :=
    wc_qmbt_bof_atlas hπ' r₁ hr
  haveI := hNo
  haveI : ∀ j, IsOpenImmersion (e j) := heo
  have hcompl := wc_qmbt_bof_chart_compl r₁ hr φN φ eN e hNgen hNup hφX hφA hnzd hgen hN he
  obtain ⟨Z₁, z, hz, hrange, hloc⟩ :=
    wc_qmbt_bof_divisor r₁ hr φN φ eN e hNX hNA hφX hφA hnzd hgen hN he hcov hcompl
  haveI := hz
  choose hj hsurj hker hs using hloc
  have sq : ∀ j, ∃ g : Spec (.of (wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j)) ⟶ Z₁,
      IsPullback g (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)))) z (e j) :=
    fun j => wc_qmbt_bof_closed_chart z (e j) _ (hj j) (hsurj j) (hker j) (hs j)
  choose g hg using sq
  obtain ⟨lam, hlam⟩ : ∃ lam : A' →+* K,
      ω.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c₁)) = lam := ⟨_, rfl⟩
  have hdet : IsUnit ((c₁.map lam) + (c₁.map lam).transpose).det := by
    have h1 : (c₁.map lam) + (c₁.map lam).transpose = (c₁ + c₁.transpose).map lam := by
      ext i j; simp
    have h2 := RingHom.map_det lam (c₁ + c₁.transpose)
    rw [RingHom.mapMatrix_apply] at h2
    rw [h1, ← h2]
    exact hc₁.map lam
  obtain ⟨qN, hqN⟩ := wc_qmbt_bof_pushout_none ω hωX hωπ lam hlam φN hNX hNA
  choose qj hqj using fun j =>
    wc_qmbt_bof_pushout_chart ω hωX hωπ lam hlam j (φ j) (hφX j) (hφA j)
  choose qd hqd using fun j =>
    wc_qmbt_bof_pushout_divisor ω hωX hωπ lam hlam j (φ j) (hφX j) (hφA j)
  have pN : IsPullback (Spec.map (CommRingCat.ofHom qN))
      (Spec.map (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam)))))
      (eN ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
    rw [hN]; exact isPullback_SpecMap_of_isPushout _ _ _ _ hqN
  have pC : ∀ j, IsPullback (Spec.map (CommRingCat.ofHom (qj j)))
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j))))))
      (e j ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
    intro j; rw [he j]; exact isPullback_SpecMap_of_isPushout _ _ _ _ (hqj j)

  have hsmN : SmoothOfRelativeDimension (n - 1)
      (Spec.map (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n 1 (c₁.map lam))))) := by
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelNone K n (c₁.map lam))
      (wcQuadModelIdeal K n 1 (c₁.map lam)) (by unfold wcQmbtBofRelNone; rw [Set.range_const])
      (fun r : Fin n => fun _ : Fin 1 => r) (fun _ a b _ => Subsingleton.elim a b)
      (wc_qmbt_bof_minors_none (c₁.map lam) hdet)
    rw [Fintype.card_fin] at h
    exact h
  have hsmC : ∀ j, SmoothOfRelativeDimension (n - 1)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelChart K n (c₁.map lam) j)))))) := by
    intro j
    have hinj : ∀ w : {v : Option (Fin n) // v ≠ some j},
        Function.Injective (![some j, w.1] : Fin 2 → Option (Fin n)) := by
      rintro ⟨w, hw⟩ a b hab
      fin_cases a <;> fin_cases b <;> (try simp at hab ⊢) <;>
        first | exact absurd hab.symm hw | exact absurd hab hw | exact hab.elim | rfl
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelChart K n (c₁.map lam) j)
      _ rfl (fun w : {v : Option (Fin n) // v ≠ some j} => ![some j, w.1]) hinj
      (wc_qmbt_bof_minors_chart (c₁.map lam) hdet j)
    rw [Fintype.card_option, Fintype.card_fin, show n + 1 - 2 = n - 1 by omega] at h
    exact h
  have hsmD : ∀ j, SmoothOfRelativeDimension (n - 2)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
        Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j)))))) := by
    intro j
    have hinj : ∀ w : {p : Fin n // p ≠ j},
        Function.Injective (![some j, none, some w.1] : Fin 3 → Option (Fin n)) := by
      rintro ⟨w, hw⟩ a b hab
      fin_cases a <;> fin_cases b <;> (try simp at hab ⊢) <;>
        first | exact absurd hab.symm hw | exact absurd hab hw | exact hab.elim | rfl
    have h := wc_qmbt_bof_jacobian_cover_smooth K (wcQmbtBofRelDiv K n (c₁.map lam) j)
      _ rfl (fun w : {p : Fin n // p ≠ j} => ![some j, none, some w.1]) hinj
      (wc_qmbt_bof_minors_divisor (c₁.map lam) hdet j)
    rw [Fintype.card_option, Fintype.card_fin, show n + 1 - 3 = n - 2 by omega] at h
    exact h
  refine ⟨?_, Limits.pullback z (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))),
    Limits.pullback.snd z (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω))), ?_, ?_,
    (Limits.pullback.snd eN (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω)))).opensRange,
    ?_, c₁.map lam, hdet, ?_⟩
  ·
    apply wc_qmbt_bof_chartwise_smooth r₁ _ (n - 1)
    intro x
    rcases hcov x with ⟨y, rfl⟩ | ⟨j, y, rfl⟩
    · exact ⟨_, _, eN, hNo, _, _, ⟨y, rfl⟩, pN, hsmN⟩
    · exact ⟨_, _, e j, heo j, _, _, ⟨y, rfl⟩, pC j, hsmC j⟩
  · first
      | infer_instance
      | exact MorphismProperty.pullback_snd _ _ hz
  ·
    have hY : SmoothOfRelativeDimension (n - 2)
        (Limits.pullback.snd (z ≫ r₁) (Spec.map (CommRingCat.ofHom ω))) := by
      apply wc_qmbt_bof_chartwise_smooth (z ≫ r₁) _ (n - 2)
      intro ζ
      have hζ : z ζ ∉ Set.range eN := by
        rw [← Set.mem_compl_iff, ← hrange]; exact ⟨ζ, rfl⟩
      rcases hcov (z ζ) with h | ⟨j, y, hy⟩
      · exact absurd h hζ
      obtain ⟨p, hp1, -⟩ := Scheme.exists_preimage_of_isPullback (hg j) ζ y hy.symm
      haveI : IsOpenImmersion (g j) :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) (hg j).flip (heo j)
      have hcomp : g j ≫ z ≫ r₁ = Spec.map (CommRingCat.ofHom
          ((Ideal.Quotient.mk (wcQmbtBofSIdeal A' n π' c₁ j)).comp (φ j))) := by
        rw [← Category.assoc, (hg j).w, Category.assoc, he j, ← Spec.map_comp,
          CommRingCat.ofHom_comp]
      have hpb : IsPullback (Spec.map (CommRingCat.ofHom
          (R := wcQmbtChart A' n π' c₁ j ⧸ wcQmbtBofSIdeal A' n π' c₁ j) (qd j)))
          (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Option (Fin n)) K ⧸
            Ideal.span (Set.range (wcQmbtBofRelDiv K n (c₁.map lam) j))))))
          (g j ≫ z ≫ r₁) (Spec.map (CommRingCat.ofHom ω)) := by
        rw [hcomp]
        exact isPullback_SpecMap_of_isPushout _ _ _ _ (hqd j)
      exact ⟨_, _, g j, inferInstance, _, _, ⟨p, hp1⟩, hpb, hsmD j⟩
    haveI := hY
    have h2 := smoothOfRelativeDimension_comp 0 (n - 2)
      (Limits.pullbackRightPullbackFstIso r₁ (Spec.map (CommRingCat.ofHom ω)) z).hom
      (Limits.pullback.snd (z ≫ r₁) (Spec.map (CommRingCat.ofHom ω)))
    rw [zero_add, Limits.pullbackRightPullbackFstIso_hom_snd] at h2
    exact h2
  ·
    rw [Scheme.Hom.coe_opensRange, Scheme.Pullback.range_snd, Scheme.Pullback.range_snd, hrange,
      Set.preimage_compl, compl_compl]
  ·
    have hpaste := (IsPullback.of_hasPullback eN
      (Limits.pullback.fst r₁ (Spec.map (CommRingCat.ofHom ω)))).paste_vert
      (IsPullback.of_hasPullback r₁ (Spec.map (CommRingCat.ofHom ω)))
    exact ⟨(Scheme.Hom.isoOpensRange _).symm ≪≫ IsPullback.isoIsPullback _ _ hpaste pN⟩

theorem wc_qmbt_sfh_fibre_smooth_pair {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd (Limits.pullback.snd
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ∧
    ∃ (Y : Scheme.{u}) (i : Y ⟶ Limits.pullback (Limits.pullback.snd
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))),
      IsClosedImmersion i ∧
      SmoothOfRelativeDimension (n - 2) (i ≫ Limits.pullback.snd (Limits.pullback.snd
        (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ∧
      ∃ O : (Limits.pullback (Limits.pullback.snd
        (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))).Opens,
        (O : Set ↥(Limits.pullback (Limits.pullback.snd
          (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
          (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
            (AlgebraicClosure (IsLocalRing.ResidueField B₀))))))) = (Set.range i)ᶜ ∧
        ∃ c' : Matrix (Fin n) (Fin n) (AlgebraicClosure (IsLocalRing.ResidueField B₀)),
          IsUnit (c' + c'.transpose).det ∧
          Nonempty (O.toScheme ≅ Spec (.of (wcQuadModelRing
            (AlgebraicClosure (IsLocalRing.ResidueField B₀)) n 1 c'))) :=
by
  classical
  have hπm : π' ∈ IsLocalRing.maximalIdeal A' := by
    rw [hπ']; exact Ideal.mem_span_singleton_self π'
  have hP := IsPullback.of_hasPullback (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA))
  obtain ⟨θ, X₁, r₁, gP, ψ, hθX, hθA, sq₁, hr, hgP1, hgP2, sqT⟩ :=
    wc_qmbt_sfp_model_square_P hsh hπ'2 hbl
  have hmax := (wc_qmbt_ecc_shens_maximal hπ hx₀ hsh).2.1
  let ω₀ : wcQuadModelRing A n π c →+* AlgebraicClosure (IsLocalRing.ResidueField B₀) :=
    (algebraMap (IsLocalRing.ResidueField B₀) (AlgebraicClosure (IsLocalRing.ResidueField B₀))).comp
      ((IsLocalRing.residue B₀).comp (Spec.preimage a₀).hom)
  have hω₀ : ∀ p, ω₀ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0 := by
    intro p
    have hm : (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B₀ := by
      rw [hmax]; exact Ideal.subset_span ⟨p, rfl⟩
    simp only [ω₀, RingHom.comp_apply, (IsLocalRing.residue_eq_zero_iff _).mpr hm, map_zero]
  obtain ⟨lam, ω, hωX, hωA, hlamι, hωθ'⟩ :=
    wc_qmbt_sfp_origin_char hπ hπ' hπ'2 hgen ω₀ hω₀
  have hωθ := hωθ' θ hθX hθA

  have key : CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c)) ≫ Spec.preimage a₀ ≫
      CommRingCat.ofHom (IsLocalRing.residue B₀) ≫
      CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀))) =
      CommRingCat.ofHom ιA ≫ CommRingCat.ofHom (IsLocalRing.residue A') ≫
        CommRingCat.ofHom lam := by
    ext a
    have h1 := RingHom.congr_fun hlamι a
    simp only [RingHom.comp_apply, ω₀] at h1
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
    exact h1.symm
  have E0 : (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) ≫ a₀ ≫ wcQuadModelStr A n π c =
      (Spec.map (CommRingCat.ofHom lam) ≫ wcQmSp A') ≫ Spec.map (CommRingCat.ofHom ιA) := by
    rw [← Spec.map_preimage a₀]
    simp only [wcQuadModelStr, wcQmSp, Category.assoc, ← Spec.map_comp]
    rw [key]
  let ν := hP.lift _ _ E0
  have hν1 : ν ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) =
      Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) := hP.lift_fst _ _ _
  have hν2 : ν ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) =
      Spec.map (CommRingCat.ofHom lam) ≫ wcQmSp A' := hP.lift_snd _ _ _

  haveI hmono : Mono (wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA)) := by
    have hsurj : Function.Surjective ((IsLocalRing.residue A').comp ιA) := by
      intro z
      obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨x, y, rfl⟩ := hgen a'
      refine ⟨x, ?_⟩
      have h0 : IsLocalRing.residue A' (ιA y * π') = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr (Ideal.mul_mem_left _ _ hπm)
      simp only [RingHom.comp_apply, map_add, h0, add_zero]
    have heq : wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA) =
        Spec.map (CommRingCat.ofHom ((IsLocalRing.residue A').comp ιA)) := by
      simp only [wcQmSp, ← Spec.map_comp]; rfl
    rw [heq]
    haveI := IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom ((IsLocalRing.residue A').comp ιA)) hsurj
    infer_instance
  have hps'' : IsPullback ι' s' (bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (wcQmSp A') := by
    rw [hblf]; exact hps'
  have sqF := wc_qmbt_sfp_fibre_paste hP bl (wcQmSp A') hps''
    (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))
    (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))
    (Spec.map (CommRingCat.ofHom lam)) ν hν1 hν2
  have sqG₀ := sqF.paste_horiz sqT
  have hνg : ν ≫ gP = Spec.map (CommRingCat.ofHom ω) := by
    apply sq₁.hom_ext
    · rw [Category.assoc, hgP1, ← Category.assoc, hν1, ← Spec.map_preimage a₀]
      simp only [Category.assoc, ← Spec.map_comp]
