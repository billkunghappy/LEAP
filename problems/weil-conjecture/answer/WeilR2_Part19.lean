        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf V.left (Scheme.ProEt.mk (𝟙 V.left))) e.symm
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep V.left
