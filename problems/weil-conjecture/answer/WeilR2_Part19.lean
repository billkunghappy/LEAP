      have hΨC : algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c))
            (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))
            (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X c)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) a)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.C a) := by
        rw [HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
        have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) a :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
            MvPolynomial.C a := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← h1]
        rfl
      rw [RingHom.comp_apply, hΨC, IsLocalization.Away.lift_eq, hρt, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPolynomial.aeval_C]

  have L3 : ∀ (K : Type u) [Field K] (N : ℕ) (c : Fin (N + 1)), letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)); HomogeneousLocalization.Away.isLocalizationElem ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) = 1 ∧ ∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K) (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)), HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) n F hF = MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X c))).comp (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) (fun j => HomogeneousLocalization.Away.isLocalizationElem ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K j))) F := by
    intro K _ N c
    letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
    have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
        (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
