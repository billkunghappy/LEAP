                rw [if_neg (by omega), if_neg (fun h => hq (Fin.ext (h.2.trans h.1.symm)))]
              rw [hcoef, map_zero, zero_mul]
            · intro h; exact absurd (Finset.mem_univ _) h
          · rw [if_neg hp2]
            refine Finset.sum_eq_zero fun q _ => ?_
            have hcoef : wcXspSplitCoeff Ω e p q = 0 := by
              unfold wcXspSplitCoeff
              rw [if_neg (by omega), if_neg (by omega)]
            rw [hcoef, map_zero, zero_mul]
      have Q4 : ∀ (h : ℕ → B) (M : ℕ), ∑ n ∈ Finset.range (2 * M), h n =
          ∑ i ∈ Finset.range M, (h (2 * i) + h (2 * i + 1)) := by
        intro h M
        induction M with
        | zero => simp
        | succ M ih =>
          rw [show 2 * (M + 1) = 2 * M + 1 + 1 by ring, Finset.sum_range_succ, Finset.sum_range_succ,
            ih, Finset.sum_range_succ]
          ring
      have Q5 : ∑ p : Fin (2 * e + 2 + 1), f p.val =
          ∑ i ∈ Finset.range (e + 1), T (2 * i) * T (2 * i + 1) - T (2 * e + 2) * T (2 * e + 2) := by
        rw [Fin.sum_univ_eq_sum_range f (2 * e + 2 + 1), Finset.sum_range_succ]
        have h2 : ∑ n ∈ Finset.range (2 * e + 2), f n = ∑ n ∈ Finset.range (2 * (e + 1)), f n := by
          rw [show 2 * e + 2 = 2 * (e + 1) by ring]
        rw [h2, Q4, hf (2 * e + 2), if_neg (by omega), if_pos rfl, ← sub_eq_add_neg]
        congr 1
        refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' := Finset.mem_range.mp hi
        rw [hf, hf, if_pos (show 2 * i % 2 = 0 ∧ 2 * i < 2 * e + 2 by omega),
          if_neg (show ¬ ((2 * i + 1) % 2 = 0 ∧ 2 * i + 1 < 2 * e + 2) by omega),
          if_neg (show ¬ (2 * i + 1 = 2 * e + 2) by omega), add_zero]
      have Q6 : ∑ i ∈ Finset.range (e + 1), T (2 * i) * T (2 * i + 1) =
          ∑ i ∈ Finset.range k, T (2 * i) * T (2 * i + 1) + T (2 * k) * T (2 * k + 1) +
          ∑ a ∈ Finset.range (e - k), T (2 * k + 2 * a + 2) * T (2 * k + 2 * a + 3) := by
        rw [show e + 1 = (k + 1) + (e - k) by omega, Finset.sum_range_add, Finset.sum_range_succ]
        congr 1
        refine Finset.sum_congr rfl (fun a _ => ?_)
        have e1 : 2 * (k + 1 + a) + 1 = 2 * k + 2 * a + 3 := by ring
        have e2 : 2 * (k + 1 + a) = 2 * k + 2 * a + 2 := by ring
        rw [e1, e2]
      have hev : ∀ n (hn : n < 2 * e + 1), MvPolynomial.eval₂ φ (fun b => t (s b)) (xv n) =
          T (if n < k then 2 * n + 1 else if n < 2 * k then 2 * (n - k) else n + 2) := by
        intro n hn
        rw [hxv, dif_pos hn, MvPolynomial.eval₂_X, hTt]
        exact congrArg T (hs _)
      have hA : ∀ i, i < k → MvPolynomial.eval₂ φ (fun b => t (s b)) (xv (k + i)) = T (2 * i) := by
        intro i hi
        rw [hev _ (by omega), if_neg (by omega), if_pos (by omega), show k + i - k = i by omega]
      have hB : ∀ i, i < k → MvPolynomial.eval₂ φ (fun b => t (s b)) (xv i) = T (2 * i + 1) := by
        intro i hi
        rw [hev _ (by omega), if_pos hi]
      have hC : ∀ m, 2 * k ≤ m → m < 2 * e + 1 →
          MvPolynomial.eval₂ φ (fun b => t (s b)) (xv m) = T (m + 2) := by
        intro m hm1 hm2
        rw [hev _ hm2, if_neg (by omega), if_neg (by omega)]
      have hτu : τ ⟨2 * k, hu⟩ = -g := by
        rw [hτ, if_neg (show ¬ (2 * k = 2 * k + 1) by omega), if_pos (show 2 * k = 2 * k from rfl)]
      have hS1 : ∑ x ∈ Finset.range k, MvPolynomial.eval₂ φ (fun b => t (s b)) (xv (k + x) * xv x) =
          ∑ i ∈ Finset.range k, T (2 * i) * T (2 * i + 1) :=
        Finset.sum_congr rfl (fun i hi => by
          rw [MvPolynomial.eval₂_mul, hA i (Finset.mem_range.mp hi), hB i (Finset.mem_range.mp hi)])
      have hS2 : ∑ x ∈ Finset.range (e - k), MvPolynomial.eval₂ φ (fun b => t (s b))
            (xv (2 * k + 2 * x) * xv (2 * k + 2 * x + 1)) =
          ∑ a ∈ Finset.range (e - k), T (2 * k + 2 * a + 2) * T (2 * k + 2 * a + 3) :=
        Finset.sum_congr rfl (fun a ha => by
          have ha' := Finset.mem_range.mp ha
          rw [MvPolynomial.eval₂_mul, hC _ (by omega) (by omega), hC _ (by omega) (by omega)])
      have hR : MvPolynomial.eval₂ φ (fun b => t (s b)) (τ ⟨2 * k, hu⟩) =
          -(∑ i ∈ Finset.range k, T (2 * i) * T (2 * i + 1) +
            ∑ a ∈ Finset.range (e - k), T (2 * k + 2 * a + 2) * T (2 * k + 2 * a + 3) -
            T (2 * e + 2) * T (2 * e + 2)) := by
        rw [hτu, MvPolynomial.eval₂_neg, hg, MvPolynomial.eval₂_sub, MvPolynomial.eval₂_add,
          MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, hS1, hS2, MvPolynomial.eval₂_mul,
          hC (2 * e) (by omega) (by omega)]
      have htc' : T (2 * k + 1) = 1 := by
        rw [← htc, hTt]
        congr 1
        exact (if_pos hk).symm
      have hTu : t ⟨2 * k, hu⟩ = T (2 * k) := hTt _
      rw [Q1, Q5, Q6, hR, htc', hTu]
      ring
    ·
      intro I
      have key : ∀ i (hi : i < k), τ ⟨if i ≤ e then 2 * i + 1 else 2 * e + 1, by split_ifs <;> omega⟩ =
          MvPolynomial.X ⟨i, by omega⟩ := by
        intro i hi
        have hv : ((⟨if i ≤ e then 2 * i + 1 else 2 * e + 1, by split_ifs <;> omega⟩ :
            Fin (2 * e + 2 + 1)) : ℕ) = 2 * i + 1 := if_pos (by omega)
        rw [hτ, hv, if_neg (show ¬ (2 * i + 1 = 2 * k + 1) by omega),
          if_neg (show ¬ (2 * i + 1 = 2 * k) by omega), hσ, if_pos (show 2 * i + 1 < 2 * k by omega),
          if_pos (show (2 * i + 1) % 2 = 1 by omega), show (2 * i + 1) / 2 = i by omega, hxv,
          dif_pos (show i < 2 * e + 1 by omega)]
      constructor
      · rintro ⟨i, hi, hnot⟩
        rw [key i hi] at hnot
        exact ⟨⟨i, by omega⟩, hi, hnot⟩
      · rintro ⟨j, hj, hX⟩
        refine ⟨j.val, hj, ?_⟩
        rw [key j.val hj]
        exact hX

  letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω))
  haveI : IsClosedImmersion jY := hjY
  obtain ⟨τ, u, s, hτc, hτs, hcov, hquad, hopen⟩ := L5
  set c : Fin (2 * e + 2 + 1) := ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩ with hc
  obtain ⟨ψ, hψmk, hψC⟩ := L2 Ω (2 * e + 2) c
    (MvPolynomial (Fin (2 * e + 1)) Ω) τ hτc
  obtain ⟨htc, hmk⟩ := L3 Ω (2 * e + 2) c
  have hψt : ∀ j : Fin (2 * e + 2 + 1), ψ (HomogeneousLocalization.Away.isLocalizationElem
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω
        c))
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω j))) = τ j := by
    intro j
    show ψ (HomogeneousLocalization.Away.mk _ _ _ _ _) = _
    rw [hψmk, pow_one, MvPolynomial.aeval_X]
  have hgen : ∀ z : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      (MvPolynomial.X c),
      ∃ F : MvPolynomial (Fin (2 * e + 2 + 1)) Ω, MvPolynomial.eval₂
        ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X c))).comp
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)))
        (fun j => HomogeneousLocalization.Away.isLocalizationElem
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω
            c))
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω j))) F = z := by
    intro z
    obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω
        c)) z
    exact ⟨F, (hmk n F hF).symm⟩
  have hψι : ∀ a : Ω, ψ (((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X c))).comp
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0))) a) = MvPolynomial.C a := by
    intro a
    rw [RingHom.comp_apply, hψC, MvPolynomial.algebraMap_eq]
  obtain ⟨hsurj, hker⟩ := L4 Ω _ _ (2 * e + 2 + 1) (2 * e + 1) _ _ u τ s ψ hgen htc hψι hψt hτs hcov
  have heG : HomogeneousLocalization.Away.isLocalizationElem
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω
        c))
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 =
      HomogeneousLocalization.Away.isLocalizationElem
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω
          c))
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω u)) -
      MvPolynomial.eval₂
        ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X c))).comp
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)))
        (fun b => HomogeneousLocalization.Away.isLocalizationElem
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω
            c))
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω (s b)))) (τ u) := by
    refine (hmk _ _ _).trans ?_
    rw [pow_one]
    exact hquad _ _ _ htc
  have hker' := hker.trans (congrArg (fun z => Ideal.span {z}) heG.symm)
  obtain ⟨hrange, hmem⟩ := L6 Ω (2 * e + 2) c
    (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e))
    (MvPolynomial (Fin (2 * e + 1)) Ω) ψ hsurj hker'
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom ψ)) :=
    IsClosedImmersion.spec_of_surjective _ (fun x => hsurj x)
  have hrangeA : Set.range (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      (MvPolynomial.X c)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω
        c)) Nat.one_pos) =
      (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
        (MvPolynomial.X c) : Set _) := by
    rw [← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι]
  have hEopen : IsOpen ({x | ∃ j : Fin (2 * e + 1), j.val < k ∧
      (MvPolynomial.X j : MvPolynomial (Fin (2 * e + 1)) Ω) ∉ x.asIdeal} : Set (Spec (.of (MvPolynomial (Fin (2 * e + 1)) Ω)))) := by
    have e : ({x | ∃ j : Fin (2 * e + 1), j.val < k ∧
        (MvPolynomial.X j : MvPolynomial (Fin (2 * e + 1)) Ω) ∉ x.asIdeal} : Set (Spec (.of (MvPolynomial (Fin (2 * e + 1)) Ω)))) =
        ⋃ (j : Fin (2 * e + 1)) (_ : j.val < k),
          ((PrimeSpectrum.basicOpen (MvPolynomial.X j : MvPolynomial (Fin (2 * e + 1)) Ω) :
            TopologicalSpace.Opens (PrimeSpectrum (MvPolynomial (Fin (2 * e + 1)) Ω))) :
            Set (PrimeSpectrum (MvPolynomial (Fin (2 * e + 1)) Ω))) := by
      ext x
      constructor
      · rintro ⟨j, hj, hx⟩
        exact Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨hj, hx⟩⟩
      · intro hx
        obtain ⟨j, hx⟩ := Set.mem_iUnion.mp hx
        obtain ⟨hj, hx⟩ := Set.mem_iUnion.mp hx
        exact ⟨j, hj, hx⟩
