      have h1 := map_natCast (αB.app V).hom d
      have h2 : (αB.app V).hom ((d : ℕ) : ULift.{u+1} (ZMod d)) = 0 := by
        rw [h0]; exact map_zero _
      exact h1.symm.trans h2
    obtain ⟨q, w, ⟨hcolim⟩, -⟩ := sheafOfModules_restrictScalars_unit_cokernel
      (Scheme.smallEtaleTopology Z) (wcEtZModRing Z (a * b)) (wcEtZModRing Z d) φ d
      hsurj hker hR1
    have hG := Limits.CokernelCofork.mapIsColimit (Limits.CokernelCofork.ofπ q w) hcolim
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange ι) _ _ D.cont D.φ)
    have hmap : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange ι) _ _ D.cont D.φ).map
        (d • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (a * b)))) =
        d • 𝟙 (wcEtSuppObj D) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rfl
    exact ⟨e₁ ≪≫ hG.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _) ≪≫
      Limits.cokernelIsoOfEq hmap⟩

  have s3 : ∀ (A : SheafOfModules.{u+1} (wcEtZModRing Y (a * b))), (a * b) • 𝟙 A = 0 →
      ∀ {Ca Cb : SheafOfModules.{u+1} (wcEtZModRing Y (a * b))} (qa : A ⟶ Ca) (qb : A ⟶ Cb)
        (wa : (a • 𝟙 A) ≫ qa = 0) (wb : (b • 𝟙 A) ≫ qb = 0),
        Limits.IsColimit (Limits.CokernelCofork.ofπ qa wa) →
        Limits.IsColimit (Limits.CokernelCofork.ofπ qb wb) →
        ∃ (sa : Ca ⟶ A) (sb : Cb ⟶ A), qa ≫ sa + qb ≫ sb = 𝟙 A ∧ sa ≫ qa = 𝟙 Ca ∧
          sa ≫ qb = 0 ∧ sb ≫ qb = 𝟙 Cb ∧ sb ≫ qa = 0 := by
    intro A hA Ca Cb qa qb wa wb hca hcb
    obtain ⟨u', v, huv⟩ := Nat.Coprime.isCoprime hab
    have haq : a • qa = 0 := by
      have h' := wa
      rwa [Preadditive.nsmul_comp, Category.id_comp] at h'
    have hbq : b • qb = 0 := by
      have h' := wb
      rwa [Preadditive.nsmul_comp, Category.id_comp] at h'
    have hbqa : ∀ (z : ℤ), (z * (a : ℤ)) • qa = 0 := by
      intro z
      rw [mul_smul, natCast_zsmul, haq, smul_zero]
    have hbqb : ∀ (z : ℤ), (z * (b : ℤ)) • qb = 0 := by
      intro z
      rw [mul_smul, natCast_zsmul, hbq, smul_zero]
    have hzab : ∀ (z : ℤ), (z * ((a * b : ℕ) : ℤ)) • 𝟙 A = 0 := by
      intro z
      rw [mul_smul, natCast_zsmul, hA, smul_zero]
    have ea : (a • 𝟙 A) ≫ ((v * (b : ℤ)) • 𝟙 A) = 0 := by
      rw [Preadditive.comp_zsmul, Category.comp_id, ← natCast_zsmul, smul_smul]
      have e1 : v * (b : ℤ) * (a : ℤ) = v * ((a * b : ℕ) : ℤ) := by push_cast; ring
      rw [e1, hzab]
    have eb : (b • 𝟙 A) ≫ ((u' * (a : ℤ)) • 𝟙 A) = 0 := by
      rw [Preadditive.comp_zsmul, Category.comp_id, ← natCast_zsmul, smul_smul]
      have e1 : u' * (a : ℤ) * (b : ℤ) = u' * ((a * b : ℕ) : ℤ) := by push_cast; ring
      rw [e1, hzab]
    obtain ⟨sa, hsa'⟩ : { l : Ca ⟶ A // qa ≫ l = (v * (b : ℤ)) • 𝟙 A } :=
      Limits.CokernelCofork.IsColimit.desc' hca ((v * (b : ℤ)) • 𝟙 A) ea
    obtain ⟨sb, hsb'⟩ : { l : Cb ⟶ A // qb ≫ l = (u' * (a : ℤ)) • 𝟙 A } :=
      Limits.CokernelCofork.IsColimit.desc' hcb ((u' * (a : ℤ)) • 𝟙 A) eb
    refine ⟨sa, sb, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hsa', hsb', ← add_smul]
      have e1 : v * (b : ℤ) + u' * (a : ℤ) = 1 := by linarith
      rw [e1, one_smul]
    · apply Limits.Cofork.IsColimit.hom_ext hca
      show qa ≫ sa ≫ qa = qa ≫ 𝟙 _
      rw [← Category.assoc, hsa', Preadditive.zsmul_comp, Category.id_comp, Category.comp_id]
      have e1 : v * (b : ℤ) = 1 - u' * (a : ℤ) := by linarith
      rw [e1, sub_smul, one_smul, hbqa, sub_zero]
    · apply Limits.Cofork.IsColimit.hom_ext hca
      show qa ≫ sa ≫ qb = qa ≫ 0
      rw [← Category.assoc, hsa', Preadditive.zsmul_comp, Category.id_comp, Limits.comp_zero, hbqb]
    · apply Limits.Cofork.IsColimit.hom_ext hcb
      show qb ≫ sb ≫ qb = qb ≫ 𝟙 _
      rw [← Category.assoc, hsb', Preadditive.zsmul_comp, Category.id_comp, Category.comp_id]
      have e1 : u' * (a : ℤ) = 1 - v * (b : ℤ) := by linarith
      rw [e1, sub_smul, one_smul, hbqb, sub_zero]
    · apply Limits.Cofork.IsColimit.hom_ext hcb
      show qb ≫ sb ≫ qa = qb ≫ 0
      rw [← Category.assoc, hsb', Preadditive.zsmul_comp, Category.id_comp, Limits.comp_zero, hbqa]

  have hU0 : (a * b) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (a * b))) = 0 := by
    have h' := (wc_et_zmod_unit_pow_exact Y (a * b) 1 hMpos).1
    first
      | (rw [pow_one] at h'; exact h')
      | simpa using h'
  have hS0 : (a * b) • 𝟙 (wcEtSuppObj D) = 0 := by
    have hUZ0 : (a * b) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (a * b))) = 0 := by
      have h' := (wc_et_zmod_unit_pow_exact Z (a * b) 1 hMpos).1
      first
        | (rw [pow_one] at h'; exact h')
        | simpa using h'
    have e : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange ι) _ _ D.cont D.φ).map
        ((a * b) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (a * b)))) =
        (a * b) • 𝟙 (wcEtSuppObj D) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rfl
    rw [← e, hUZ0]
    exact Functor.map_zero _ _ _

  have hcc : ∀ {X₁ X₂ X₃ X₄ : SheafOfModules.{u+1} (wcEtZModRing Y (a * b))} {n : ℕ}
      (t : Abelian.Ext X₁ X₂ n) (f : X₂ ⟶ X₃) (g : X₃ ⟶ X₄),
      (t.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        t.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro X₁ X₂ X₃ X₄ n t f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  obtain ⟨φa, iLa, iCa, qa, wa, ⟨hca⟩, hTa⟩ := s5 a ha (dvd_mul_right a b)
  obtain ⟨φb, iLb, iCb, qb, wb, ⟨hcb⟩, hTb⟩ := s5 b hb (dvd_mul_left b a)
  haveI := iLa
  haveI := iCa
  haveI := iLb
  haveI := iCb
  obtain ⟨Da⟩ := wc_et_zmod_pull_data_exists ι a
  obtain ⟨Db⟩ := wc_et_zmod_pull_data_exists ι b
  obtain ⟨ea⟩ := s2 a ha (dvd_mul_right a b) Da φa
  obtain ⟨eb⟩ := s2 b hb (dvd_mul_left b a) Db φb
  obtain ⟨θa, hθa⟩ := Ha Da
  obtain ⟨θb, hθb⟩ := Hb Db
  obtain ⟨sa, sb, -, I2, I3, I4, I5⟩ := s3 _ hU0 qa qb wa wb hca hcb
  obtain ⟨σa, σb, J1, -, -, -, -⟩ := s3 (wcEtSuppObj D) hS0
    (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D))) (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)))
    (Limits.cokernel.condition _) (Limits.cokernel.condition _)
    (Limits.cokernelIsCokernel _) (Limits.cokernelIsCokernel _)
  refine ⟨(Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)) ≫ ea.inv)).comp
      ((Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φa) θa).comp
        (Abelian.Ext.mk₀ sa) (add_zero 2)) (zero_add 2) +
    (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)) ≫ eb.inv)).comp
      ((Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φb) θb).comp
        (Abelian.Ext.mk₀ sb) (add_zero 2)) (zero_add 2), fun x hx => ?_⟩

  obtain ⟨ya, hya⟩ := (hTa (wcEtSuppObj Da) p).2
    (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)) ≫ ea.inv)) (add_zero p))
  obtain ⟨yb, hyb⟩ := (hTb (wcEtSuppObj Db) p).2
    (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)) ≫ eb.inv)) (add_zero p))
  have hya' : (Abelian.Ext.mk₀ qa).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φa) ya) (zero_add p) =
      x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)) ≫ ea.inv)) (add_zero p) :=
    hya
  have hyb' : (Abelian.Ext.mk₀ qb).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φb) yb) (zero_add p) =
      x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)) ≫ eb.inv)) (add_zero p) :=
    hyb

  have Ea : x.comp ((Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)) ≫ ea.inv)).comp
      ((Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φa) θa).comp
        (Abelian.Ext.mk₀ sa) (add_zero 2)) (zero_add 2)) h =
      ((Abelian.Ext.mk₀ qa).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φa) (ya.comp θa h))
        (zero_add s)).comp (Abelian.Ext.mk₀ sa) (add_zero s) := by
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← hya', Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ qa) _ _ (zero_add p) h
        (show 0 + p + 2 = s by omega), Abelian.Ext.mapExactFunctor_comp]
  have Eb : x.comp ((Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)) ≫ eb.inv)).comp
      ((Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φb) θb).comp
        (Abelian.Ext.mk₀ sb) (add_zero 2)) (zero_add 2)) h =
      ((Abelian.Ext.mk₀ qb).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φb) (yb.comp θb h))
        (zero_add s)).comp (Abelian.Ext.mk₀ sb) (add_zero s) := by
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← hyb', Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ qb) _ _ (zero_add p) h
        (show 0 + p + 2 = s by omega), Abelian.Ext.mapExactFunctor_comp]
  rw [Abelian.Ext.comp_add, Ea, Eb] at hx

  have ta0 : (Abelian.Ext.mk₀ qa).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φa) (ya.comp θa h))
      (zero_add s) = 0 := by
    have e := congrArg (fun t => t.comp (Abelian.Ext.mk₀ qa) (add_zero s)) hx
    try simp only at e
    rw [Abelian.Ext.add_comp, hcc, hcc, I2, I5, Abelian.Ext.comp_mk₀_id, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero, add_zero, Abelian.Ext.zero_comp] at e
    exact e
  have tb0 : (Abelian.Ext.mk₀ qb).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φb) (yb.comp θb h))
      (zero_add s) = 0 := by
    have e := congrArg (fun t => t.comp (Abelian.Ext.mk₀ qb) (add_zero s)) hx
    try simp only at e
    rw [Abelian.Ext.add_comp, hcc, hcc, I3, I4, Abelian.Ext.comp_mk₀_id, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero, zero_add, Abelian.Ext.zero_comp] at e
    exact e
  have hza : ya.comp θa h = 0 := by
    apply (hTa (SheafOfModules.unit (wcEtZModRing Y a)) s).1
    show _ = (Abelian.Ext.mk₀ qa).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φa) 0) (zero_add s)
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
    exact ta0
  have hzb : yb.comp θb h = 0 := by
    apply (hTb (SheafOfModules.unit (wcEtZModRing Y b)) s).1
    show _ = (Abelian.Ext.mk₀ qb).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φb) 0) (zero_add s)
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
    exact tb0
  have xa : x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)))) (add_zero p) = 0 := by
    have e1 : x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)) ≫ ea.inv))
        (add_zero p) = 0 := by
      rw [← hya', hθa ya hza, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
    have e2 : x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)))) (add_zero p) =
        (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D)) ≫ ea.inv))
          (add_zero p)).comp (Abelian.Ext.mk₀ ea.hom) (add_zero p) := by
      rw [hcc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [e2, e1, Abelian.Ext.zero_comp]
  have xb : x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)))) (add_zero p) = 0 := by
    have e1 : x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)) ≫ eb.inv))
        (add_zero p) = 0 := by
      rw [← hyb', hθb yb hzb, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
    have e2 : x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)))) (add_zero p) =
        (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D)) ≫ eb.inv))
          (add_zero p)).comp (Abelian.Ext.mk₀ eb.hom) (add_zero p) := by
      rw [hcc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [e2, e1, Abelian.Ext.zero_comp]

  have hdec : x = (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (a • 𝟙 (wcEtSuppObj D))))
      (add_zero p)).comp (Abelian.Ext.mk₀ σa) (add_zero p) +
      (x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (b • 𝟙 (wcEtSuppObj D))))
      (add_zero p)).comp (Abelian.Ext.mk₀ σb) (add_zero p) := by
    rw [hcc, hcc, ← Abelian.Ext.comp_add, ← Abelian.Ext.mk₀_add, J1, Abelian.Ext.comp_mk₀_id]
  rw [hdec, xa, xb, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp, add_zero]

theorem wc_et_supp_top_ext_cyclic_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (Z : Scheme.{u}) (ι : Z ⟶ Y) [IsClosedImmersion ι] (d : ℕ) [SmoothOfRelativeDimension d (ι ≫ f)] [IrreducibleSpace Z] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ) (D : wcEtPullData ι (ℓ ^ k)), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ k))) := HasExt.standard _; IsAddCyclic (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))) (wcEtSuppObj D) (2 * d)) ∧ ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))) (wcEtSuppObj D) (2 * d), ℓ ^ k • x = 0 :=
by
  intro K _ _ Y f _ Z ι _ d _ _ ℓ _ hℓ k D
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ k))) := HasExt.standard _
  haveI : IsProper (ι ≫ f) := inferInstance
  obtain ⟨T, M, hT, -⟩ := wc_et_supp_unit_ext_transfer ι (ℓ ^ k) D
  haveI hcyc : IsAddCyclic (wcEtZModExt Z (ℓ ^ k) (2 * d)) :=
    wc_et_zmodext_top_cyclic K Z (ι ≫ f) d ℓ hℓ k
  refine ⟨isAddCyclic_of_surjective (T (2 * d)) (hT (2 * d)).2, ?_⟩
  intro x
  have hE : (ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))) = 0 :=
    (wc_et_zmod_unit_pow_exact Y ℓ k (Fact.out : ℓ.Prime).pos).1
  have hn : ∀ n : ℕ, n • x = (Abelian.Ext.mk₀
      (n • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))))).comp x (zero_add _) := by
    intro n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, ← ih,
        Abelian.Ext.mk₀_id_comp]
  rw [hn, hE, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]

theorem wc_et_point_supp_ext_strict_exists : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Z : Scheme.{u}) (g : Z ⟶ Spec (.of K)) [IsProper g] (d : ℕ) [SmoothOfRelativeDimension d g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (z₀ : Spec (.of K) ⟶ Z), z₀ ≫ g = 𝟙 _ → ∀ (Dz : wcEtPullData z₀ (ℓ ^ k)), ∃ ω : wcEtSuppExt Dz (2 * d), ℓ ^ (k - 1) • ω ≠ 0 :=
by
  classical
  intro K _ _ Z g _ d _ ℓ _ hℓ k hk z₀ hz₀ Dz

  haveI : IsClosedImmersion (z₀ ≫ g) := by rw [hz₀]; infer_instance
  haveI : IsClosedImmersion z₀ := IsClosedImmersion.of_comp z₀ g
  haveI : CompactSpace ↥Z := QuasiCompact.compactSpace_of_compactSpace g
  haveI hsmz : SmoothOfRelativeDimension (d - d) (z₀ ≫ g) := by
    rw [Nat.sub_self, hz₀]; infer_instance

  obtain ⟨T, hGL, hNat, hstrict⟩ := wc_et_kummer_local_thom_pow K ℓ hℓ k hk
  have hsp : ∀ (X Z' : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ)
      [SmoothOfRelativeDimension n fX] (i : Z' ⟶ X) [IsClosedImmersion i]
      [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D₁ : wcEtPullData i (ℓ ^ k))
      (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D₁ q, θ = 0 := by
    intro X Z' fX n c _ i _ _ hc
    exact wc_et_supp_semipurity_pow K X Z' fX n c i hc ℓ hℓ k hk
  obtain ⟨θ, hθ⟩ := wc_et_thom_class_glue_pow K (ℓ ^ k) hsp T hGL hNat Z (Spec (.of K)) g d d
    z₀ le_rfl Dz

  let pt : Spec (.of K) := Classical.arbitrary _
  obtain ⟨W, hzW, -, hloc⟩ := wc_smooth_pair_local_equations K Z (Spec (.of K)) g d d z₀ le_rfl pt
  have H : Set.range z₀ ⊆ Set.range W.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨q, rfl⟩
    rw [Subsingleton.elim q pt]
    exact hzW
  have hpb : IsPullback (𝟙 _) (IsOpenImmersion.lift W.ι z₀ H) z₀ W.ι :=
    (IsOpenImmersion.isPullback_lift_id z₀ W.ι H).flip
  obtain ⟨h, hcut⟩ := hloc (Spec (.of K)) (IsOpenImmersion.lift W.ι z₀ H) (𝟙 _) hpb

  let DW : wcEtPullData (IsOpenImmersion.lift W.ι z₀ H) (ℓ ^ k) :=
    (wc_et_zmod_pull_data_exists (IsOpenImmersion.lift W.ι z₀ H) (ℓ ^ k)).some
  let EW : wcEtPullData W.ι (ℓ ^ k) := (wc_et_zmod_pull_data_exists W.ι (ℓ ^ k)).some
  obtain ⟨γ, hγ, -⟩ :=
    wc_et_closed_supp_base_change z₀ W.ι (IsOpenImmersion.lift W.ι z₀ H) (𝟙 _) hpb Dz EW DW
  have h1 := hθ W (Spec (.of K)) (IsOpenImmersion.lift W.ι z₀ H) (𝟙 _) hpb DW EW γ hγ h hcut

  have hsm : SmoothOfRelativeDimension d (W.ι ≫ g) := by
    have := smoothOfRelativeDimension_comp 0 d W.ι g
