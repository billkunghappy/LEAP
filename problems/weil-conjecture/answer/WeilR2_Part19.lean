    fun x => IsLocalization.Away.lift_eq _ hunit x
  have hw : fl (wcQmdlCX A' n π' c' l (some m)) *
      Λ₀ (IsLocalization.Away.invSelf (S := Localization.Away (wcQmdlCX A' n π' c' l (some m)))
        (wcQmdlCX A' n π' c' l (some m))) = 1 := by
    have h := congrArg Λ₀ (IsLocalization.Away.mul_invSelf
