    have H := s6 (Proj.map f hf)
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
      (Spec.map (CommRingCat.ofHom (algebraMap F F')))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
        (hX a) Nat.one_pos)
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
        (f.map_mem (hX a)) Nat.one_pos)
      (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
      hcov hcomm hpre hchart
    subst hfdef
    exact H

  have PRE : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B] (a : Fin (N + 1)),
      wcLdpProjMap A B N ⁻¹ᵁ wcSgD A N a = wcSgD B N a := by
    intro A B _ _ _ a
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
    obtain ⟨hf, ehf⟩ : ∃ h, wcLdpProjMap A B N = Proj.map (wcLdpGrHom A B N) h := ⟨_, rfl⟩
    have h1 : Proj.map (wcLdpGrHom A B N) hf ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (MvPolynomial.X a) =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)
          (wcLdpGrHom A B N (MvPolynomial.X a)) :=
      Proj.map_preimage_basicOpen _ _ _
    have h2 : wcLdpGrHom A B N (MvPolynomial.X a) = MvPolynomial.X a :=
      MvPolynomial.map_X (algebraMap A B) a
    rw [h2] at h1
    rw [ehf]
    exact h1

  have SEC : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B]
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A 2) (a : Fin (N + 1))
      (h : wcSgD B N a ≤ wcLdpProjMap A B N ⁻¹ᵁ wcSgD A N a),
      ((wcLdpProjMap A B N).appLE (wcSgD A N a) (wcSgD B N a) h).hom (wcLdpSec A N G a) =
        wcLdpSec B N (wcLdpMapQ A B N G) a := by
    intro A B _ _ _ G a h
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
    obtain ⟨hf, -⟩ : ∃ h, wcLdpProjMap A B N = Proj.map (wcLdpGrHom A B N) h := ⟨_, rfl⟩
    have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A a)
    have STAR : ∀ (s' : MvPolynomial (Fin (N + 1)) B)
        (hs : wcLdpGrHom A B N (MvPolynomial.X a) = s')
        (hs1 : s' ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B 1)
        (h' : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) s' ≤
          Proj.map (wcLdpGrHom A B N) hf ⁻¹ᵁ
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (MvPolynomial.X a)),
        ((Proj.map (wcLdpGrHom A B N) hf).appLE
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (MvPolynomial.X a))
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) s') h').hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)
            (MvPolynomial.X a)).hom
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) hX 2
              (G : MvPolynomial (Fin (N + 1)) A) G.2)) =
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) s').hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) hs1 2
            (wcLdpGrHom A B N (G : MvPolynomial (Fin (N + 1)) A))
            ((wcLdpGrHom A B N).map_mem G.2)) := by
      intro s' hs hs1 h'
      subst hs
      have e2 := congrArg (fun φ => CommRingCat.Hom.hom φ
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) hX 2
              (G : MvPolynomial (Fin (N + 1)) A) G.2))
        (Proj.awayToSection_comp_appLE (wcLdpGrHom A B N) hf hX)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
        HomogeneousLocalization.Away.map_mk] at e2
      exact e2
    exact STAR (MvPolynomial.X a) (MvPolynomial.map_X (algebraMap A B) a)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X B a)) h

  have GERM : ∀ {X X' P P' : Scheme.{u}} (ρ : X ⟶ X') (jK : X ⟶ P) (jE : X' ⟶ P')
      (β : P ⟶ P') (hcomm : jK ≫ β = ρ ≫ jE) (D : P.Opens) (D' : P'.Opens) (h : D ≤ β ⁻¹ᵁ D')
      (s : Γ(P', D')) (w : X) (hw : w ∈ jK ⁻¹ᵁ D) (hρw : ρ w ∈ jE ⁻¹ᵁ D'),
      (ρ.stalkMap w).hom ((X'.presheaf.germ (jE ⁻¹ᵁ D') (ρ w) hρw).hom ((jE.app D').hom s)) =
        (X.presheaf.germ (jK ⁻¹ᵁ D) w hw).hom ((jK.app D).hom ((β.appLE D' D h).hom s)) := by
    intro X X' P P' ρ jK jE β hcomm D D' h s w hw hρw
    have T : ∀ (g₁ g₂ : X ⟶ P') (e : g₁ = g₂) (hx₁ : w ∈ g₁ ⁻¹ᵁ D') (hx₂ : w ∈ g₂ ⁻¹ᵁ D'),
        g₁.app D' ≫ X.presheaf.germ (g₁ ⁻¹ᵁ D') w hx₁ =
          g₂.app D' ≫ X.presheaf.germ (g₂ ⁻¹ᵁ D') w hx₂ := by
      intro g₁ g₂ e hx₁ hx₂
      subst e
      rfl
    have hx1 : w ∈ (ρ ≫ jE) ⁻¹ᵁ D' := hρw
    have hx2 : w ∈ (jK ≫ β) ⁻¹ᵁ D' := h hw
    have e1 : jE.app D' ≫ X'.presheaf.germ (jE ⁻¹ᵁ D') (ρ w) hρw ≫ ρ.stalkMap w =
        (ρ ≫ jE).app D' ≫ X.presheaf.germ ((ρ ≫ jE) ⁻¹ᵁ D') w hx1 := by
      rw [Scheme.Hom.germ_stalkMap ρ (jE ⁻¹ᵁ D') w hρw, Scheme.Hom.comp_app]
      all_goals exact (Category.assoc _ _ _).symm
    have hw' : jK w ∈ D := hw
    have r1 : P.presheaf.map (homOfLE h).op ≫ P.presheaf.germ D (jK w) hw' =
        P.presheaf.germ (β ⁻¹ᵁ D') (jK w) (h hw') := TopCat.Presheaf.germ_res _ _ _ _
    have r2 := Scheme.Hom.germ_stalkMap jK D w hw'
    have r3 := Scheme.Hom.germ_stalkMap jK (β ⁻¹ᵁ D') w (h hw')
    have e2 : β.appLE D' D h ≫ jK.app D ≫ X.presheaf.germ (jK ⁻¹ᵁ D) w hw =
        (jK ≫ β).app D' ≫ X.presheaf.germ ((jK ≫ β) ⁻¹ᵁ D') w hx2 := by
      rw [Scheme.Hom.appLE.eq_1, Category.assoc, ← r2, reassoc_of% r1, r3, Scheme.Hom.comp_app]
      all_goals exact (Category.assoc _ _ _).symm
    have key : jE.app D' ≫ X'.presheaf.germ (jE ⁻¹ᵁ D') (ρ w) hρw ≫ ρ.stalkMap w =
        β.appLE D' D h ≫ jK.app D ≫ X.presheaf.germ (jK ⁻¹ᵁ D) w hw := by
      rw [e1, e2]
      exact T _ _ hcomm.symm hx1 hx2
    exact congrArg (fun φ => CommRingCat.Hom.hom φ s) key

  have POLY : wcLdpMapQ K Ω N (wcLdpQuad K N a) =
      wcLdpQuad Ω N (fun p q => algebraMap K Ω (a p q)) := by
    apply Subtype.ext
    show MvPolynomial.map (algebraMap K Ω) (∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
      ∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C (algebraMap K Ω (a p q)) * (MvPolynomial.X p * MvPolynomial.X q)
    simp only [map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]

  have PBL := PB K Ω
  have wL : (Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) ≫ jE) ≫
      wcProjKStr K N =
      Limits.pullback.snd E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K Ω)) := by
    rw [Category.assoc, hjEY, Limits.pullback.condition]
  have hO : IsPullback (PBL.lift _ _ wL ≫ wcProjKStr Ω N)
      (Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))
      (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) (jE ≫ wcProjKStr K N) := by
    rw [PBL.lift_snd, hjEY]
    exact (IsPullback.of_hasPullback _ _).flip
  have Lsq := IsPullback.of_right hO (PBL.lift_fst _ _ wL) PBL.flip
  have hcl : IsClosedImmersion (PBL.lift _ _ wL) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) Lsq.flip hjE
  have SQ : PBL.lift _ _ wL ≫ wcLdpProjMap K Ω N =
      Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) ≫ jE :=
    PBL.lift_fst _ _ wL
  refine ⟨PBL.lift _ _ wL, hcl, PBL.lift_snd _ _ wL, ?_⟩

  intro w c hw
  have hle : wcSgD Ω N c ≤ wcLdpProjMap K Ω N ⁻¹ᵁ wcSgD K N c := (PRE K Ω c).symm.le
  have hρw : Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) w ∈
      jE ⁻¹ᵁ wcSgD K N c := by
    have e : wcLdpProjMap K Ω N (PBL.lift _ _ wL w) =
        jE (Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) w) := by
      change (PBL.lift _ _ wL ≫ wcLdpProjMap K Ω N) w =
        (Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) ≫ jE) w
      rw [SQ]
    have h1 : PBL.lift _ _ wL w ∈ wcLdpProjMap K Ω N ⁻¹ᵁ wcSgD K N c := hle hw
    rw [Scheme.Hom.mem_preimage, e] at h1
    exact h1
  have H0 := hEG _ c hρw
  have H := GERM (Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))
    (PBL.lift _ _ wL) jE (wcLdpProjMap K Ω N) SQ (wcSgD Ω N c) (wcSgD K N c) hle
    (wcLdpSec K N (wcLdpQuad K N a) c) w hw hρw
  rw [SEC K Ω (wcLdpQuad K N a) c hle, POLY] at H
  unfold wcLdpGerm at H0 ⊢
  rw [← H]
  exact map_nonunit _ _ H0

theorem wc_quadric_germ_linear_change : ∀ (Ω : Type u) [Field Ω] (N : ℕ) (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (jY : Y ⟶ wcProjK Ω N), IsClosedImmersion jY → jY ≫ wcProjKStr Ω N = fY → ∀ (A : Matrix (Fin (N + 1)) (Fin (N + 1)) Ω), (∀ (x : Y) (c : Fin (N + 1)) (hx : x ∈ jY ⁻¹ᵁ wcSgD Ω N c), wcLdpGerm Ω N jY (wcLdpQuad Ω N (fun p q => A p q)) c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) → ∀ (P : Matrix (Fin (N + 1)) (Fin (N + 1)) Ω), IsUnit P.det → ∃ jY' : Y ⟶ wcProjK Ω N, IsClosedImmersion jY' ∧ jY' ≫ wcProjKStr Ω N = fY ∧ ∀ (x : Y) (c : Fin (N + 1)) (hx : x ∈ jY' ⁻¹ᵁ wcSgD Ω N c), wcLdpGerm Ω N jY' (wcLdpQuad Ω N (fun p q => (P.transpose * A * P) p q)) c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) :=
by
  intro Ω _ N Y fY jY hjY hjYY A hA P hP
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
    MvPolynomial.gradedAlgebra

  have linsub : ∀ (R S : Matrix (Fin (N + 1)) (Fin (N + 1)) Ω)
      (V : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω),
      (∀ i, V i = ∑ j, MvPolynomial.C (S i j) * MvPolynomial.X j) → R * S = 1 → ∀ k,
      ∑ j, MvPolynomial.C (R k j) * V j = MvPolynomial.X k := by
    intro R S V hV hRS k
    simp only [hV, Finset.mul_sum]
    rw [Finset.sum_comm]
    have e : ∀ l, ∑ j, MvPolynomial.C (R k j) * (MvPolynomial.C (S j l) * MvPolynomial.X l) =
        MvPolynomial.C ((R * S) k l) * (MvPolynomial.X l : MvPolynomial (Fin (N + 1)) Ω) := by
      intro l
      rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
      exact Finset.sum_congr rfl fun j _ => by rw [map_mul, mul_assoc]
    simp only [e, hRS, Matrix.one_apply]
    simp [apply_ite MvPolynomial.C]
  have linhom : ∀ (S : Matrix (Fin (N + 1)) (Fin (N + 1)) Ω) (i : Fin (N + 1)),
      (∑ j, MvPolynomial.C (S i j) * MvPolynomial.X j :
        MvPolynomial (Fin (N + 1)) Ω).IsHomogeneous 1 := fun S i =>
    MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ => (MvPolynomial.isHomogeneous_X Ω j).C_mul _
  obtain ⟨M, hM⟩ : ∃ M : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω,
      ∀ i, M i = ∑ j, MvPolynomial.C (P⁻¹ i j) * MvPolynomial.X j := ⟨_, fun _ => rfl⟩
  obtain ⟨L, hL⟩ : ∃ L : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω,
      ∀ i, L i = ∑ j, MvPolynomial.C (P i j) * MvPolynomial.X j := ⟨_, fun _ => rfl⟩
  have hMh : ∀ i, (M i).IsHomogeneous 1 := fun i => by rw [hM]; exact linhom _ i
  have hLh : ∀ i, (L i).IsHomogeneous 1 := fun i => by rw [hL]; exact linhom _ i
  have hPM : ∀ r, ∑ j, MvPolynomial.C (P r j) * M j = MvPolynomial.X r :=
    linsub P P⁻¹ M hM (Matrix.mul_nonsing_inv P hP)
  have hML : ∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i := by
    intro i
    rw [hL]
    simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
      MvPolynomial.algebraMap_eq]
    exact hPM i
  have hLM : ∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i := by
    intro i
    rw [hM]
    simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
      MvPolynomial.algebraMap_eq]
    exact linsub P⁻¹ P L hL (Matrix.nonsing_inv_mul P hP) i

  have hcc : ∀ (V : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω), (∀ i, (V i).IsHomogeneous 1) →
      ∀ p : MvPolynomial (Fin (N + 1)) Ω,
        MvPolynomial.constantCoeff (MvPolynomial.aeval V p) = MvPolynomial.constantCoeff p := by
    intro V hV p
    induction p using MvPolynomial.induction_on with
    | C r => rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
    | mul_X p i hp =>
      have h0 : MvPolynomial.constantCoeff (V i) = 0 := by
        rw [MvPolynomial.constantCoeff_eq]
        exact (hV i).coeff_eq_zero (by simp)
      rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, h0]
  have hirr : ∀ a : MvPolynomial (Fin (N + 1)) Ω,
      a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) ↔
        MvPolynomial.constantCoeff a = 0 := by
    intro a
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    change ((MvPolynomial.decomposition.decompose' a 0 : MvPolynomial (Fin (N + 1)) Ω)) = 0 ↔ _
    rw [MvPolynomial.decomposition.decompose'_apply, MvPolynomial.homogeneousComponent_zero,
      MvPolynomial.C_eq_zero, MvPolynomial.constantCoeff_eq]
  let Φ : ∀ V : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω, (∀ i, (V i).IsHomogeneous 1) →
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
    fun V hV => GradedRingHom.mk (MvPolynomial.aeval V).toRingHom (fun {n} {x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      simpa using hx.aeval V hV)
  have hΦ : ∀ V hV (x : MvPolynomial (Fin (N + 1)) Ω), Φ V hV x = MvPolynomial.aeval V x :=
    fun _ _ _ => rfl
  have hinv : ∀ V V' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω,
      (∀ i, MvPolynomial.aeval V (V' i) = MvPolynomial.X i) →
      ∀ x, MvPolynomial.aeval V (MvPolynomial.aeval V' x) = x := by
    intro V V' h x
    have e : (MvPolynomial.aeval V).comp (MvPolynomial.aeval V') =
        AlgHom.id Ω (MvPolynomial (Fin (N + 1)) Ω) :=
      MvPolynomial.algHom_ext (fun i => by
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X, h i, AlgHom.id_apply])
    exact AlgHom.congr_fun e x
  have hcond : ∀ (V V' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)
      (hV : ∀ i, (V i).IsHomogeneous 1),
      (∀ i, (V' i).IsHomogeneous 1) →
      (∀ i, MvPolynomial.aeval V (V' i) = MvPolynomial.X i) →
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) ≤
        HomogeneousIdeal.map (Φ V hV)
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)) := by
    intro V V' hV hV' h a ha
    have hb : MvPolynomial.aeval V' a ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
      (hirr _).mpr (by rw [hcc V' hV', (hirr a).mp ha])
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map]
    have hm := Ideal.mem_map_of_mem (Φ V hV) (HomogeneousIdeal.mem_iff.mpr hb)
    rwa [hΦ V hV, hinv V V' h] at hm
  have hcomp : ∀ (V V' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)
      (hV : ∀ i, (V i).IsHomogeneous 1) (hV' : ∀ i, (V' i).IsHomogeneous 1),
      (∀ i, MvPolynomial.aeval V (V' i) = MvPolynomial.X i) →
      (Φ V hV).comp (Φ V' hV') = GradedRingHom.id _ := by
    intro V V' hV hV' h
    apply GradedRingHom.ext
    intro x
    rw [GradedRingHom.comp_apply, GradedRingHom.id_apply, hΦ V' hV', hΦ V hV, hinv V V' h]
  have keyid : ∀ (f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hf,
      f = GradedRingHom.id _ → Proj.map f hf = 𝟙 _ := by
    rintro f hf rfl
    exact Proj.map_id
  have hφ := hcond M L hMh hLh hML
  have hψ := hcond L M hLh hMh hLM
  have hgI : IsIso (Proj.map (Φ M hMh) hφ) := by
    refine ⟨⟨Proj.map (Φ L hLh) hψ, ?_, ?_⟩⟩
    · rw [← Proj.map_comp]
      exact keyid _ _ (hcomp M L hMh hLh hML)
    · rw [← Proj.map_comp]
      exact keyid _ _ (hcomp L M hLh hMh hLM)

  have TSZ : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      (f₀ : ↥(𝒜 0) →+* ↥(ℬ 0)), (∀ a : ↥(𝒜 0), ((f₀ a : ↥(ℬ 0)) : B) = f (a : A)) →
      Proj.map f hf ≫ Proj.toSpecZero 𝒜 = Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom f₀) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf f₀ hf₀
    have s1 : ∀ s : A, (HomogeneousLocalization.Away.map f s).comp
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers s)) =
        (HomogeneousLocalization.fromZeroRingHom ℬ (Submonoid.powers (f s))).comp f₀ := by
      intro s
      refine RingHom.ext (fun a => ?_)
      apply HomogeneousLocalization.val_injective
      simp only [RingHom.comp_apply]
      show (HomogeneousLocalization.Away.map f s (HomogeneousLocalization.mk ⟨0, a, 1, _⟩)).val =
        (HomogeneousLocalization.mk ⟨0, f₀ a, 1, _⟩ :
          HomogeneousLocalization ℬ (Submonoid.powers (f s))).val
      rw [HomogeneousLocalization.Away.map, HomogeneousLocalization.map_mk,
        HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
      simp only [SetLike.GradeZero.coe_one, map_one, hf₀]
    have s2 : ∀ x : Proj ℬ, ∃ i, ∃ s ∈ 𝒜 i, 0 < i ∧ x ∈ Proj.basicOpen ℬ (f s) := by
      intro x
      by_contra hcon
      push_neg at hcon
      apply ProjectiveSpectrum.not_irrelevant_le (x : ProjectiveSpectrum ℬ)
      intro b hb
      have hb' := hf hb
      have hle : (HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜)).toIdeal ≤
          (x : ProjectiveSpectrum ℬ).asHomogeneousIdeal.toIdeal := by
        rw [HomogeneousIdeal.toIdeal_map, HomogeneousIdeal.irrelevant_eq_span, Ideal.map_span,
          Ideal.span_le]
        rintro _ ⟨y, hy, rfl⟩
        simp only [Set.mem_iUnion] at hy
        obtain ⟨i, hi, hyi⟩ := hy
        have h1 := hcon i y hyi hi
        rw [Proj.mem_basicOpen] at h1
        push_neg at h1
        exact h1
      exact hle hb'
    let 𝒰 : (Proj ℬ).OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion)
        {p : ℕ × A // p.2 ∈ 𝒜 p.1 ∧ 0 < p.1}
        (fun j => Spec (.of (HomogeneousLocalization.Away ℬ (f j.1.2))))
        (fun j => Proj.awayι ℬ (f j.1.2) (f.map_mem j.2.1) j.2.2) (fun x => by
          obtain ⟨i, s, hs, hi, hx⟩ := s2 x
          rw [← Proj.opensRange_awayι ℬ (f s) (f.map_mem hs) hi] at hx
          obtain ⟨y, hy⟩ := hx
          exact ⟨⟨(i, s), hs, hi⟩, y, hy⟩)
    refine Scheme.Cover.hom_ext 𝒰 _ _ (fun j => ?_)
    obtain ⟨⟨i, s⟩, hs, hi⟩ := j
    have hs' : s ∈ 𝒜 i := hs
    have hi' : 0 < i := hi
    show Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _ = Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _
    rw [Proj.awayι_comp_map_assoc f hf hi' s hs', Proj.awayι_toSpecZero,
      Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp, s1]
  have hside : ∀ a : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0),
      (((RingHom.id _ a : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0))) :
        MvPolynomial (Fin (N + 1)) Ω) = Φ M hMh (a : MvPolynomial (Fin (N + 1)) Ω) := by
    intro a
    show (a : MvPolynomial (Fin (N + 1)) Ω) = MvPolynomial.aeval M (a : MvPolynomial (Fin (N + 1)) Ω)
    have e1 : (a : MvPolynomial (Fin (N + 1)) Ω) =
        MvPolynomial.homogeneousComponent 0 (a : MvPolynomial (Fin (N + 1)) Ω) := by
      rw [MvPolynomial.homogeneousComponent_of_mem a.2, if_pos rfl]
    rw [e1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq]
  have hTS := TSZ (Φ M hMh) hφ (RingHom.id _) hside
  rw [CommRingCat.ofHom_id, Spec.map_id, Category.comp_id] at hTS
  obtain ⟨g, hgdef⟩ : ∃ g : wcProjK Ω N ⟶ wcProjK Ω N, g = Proj.map (Φ M hMh) hφ := ⟨_, rfl⟩
  have hstr : g ≫ wcProjKStr Ω N = wcProjKStr Ω N := by
    rw [hgdef]
    change Proj.map (Φ M hMh) hφ ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0)))) =
      Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0)))
    rw [← Category.assoc, hTS]
  have hX : ∀ c : Fin (N + 1), (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) Ω) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 := fun c =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω c)
  have hMc : ∀ c : Fin (N + 1), M c ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 :=
    fun c => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (hMh c)

  have SECG : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 2) (c : Fin (N + 1))
      (p : wcProjK Ω N) (hp : p ∈ g ⁻¹ᵁ wcSgD Ω N c)
      (hp' : p ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (M c))
      (F : MvPolynomial (Fin (N + 1)) Ω)
      (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (2 • 1))
      (hFG : Φ M hMh (G : MvPolynomial (Fin (N + 1)) Ω) = F),
      ((wcProjK Ω N).presheaf.germ _ p hp).hom ((g.app (wcSgD Ω N c)).hom (wcLdpSec Ω N G c)) =
      ((wcProjK Ω N).presheaf.germ _ p hp').hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (M c)).hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            (hMc c) 2 F hF)) := by
    intro G c p hp hp' F hF hFG
    subst hgdef
    subst hFG
    have hs : Φ M hMh (MvPolynomial.X c) = M c := MvPolynomial.aeval_X M c
    have STAR : ∀ (s' : MvPolynomial (Fin (N + 1)) Ω) (hs : Φ M hMh (MvPolynomial.X c) = s')
        (hs1 : s' ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1)
        (hp' : p ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) s'),
        ((wcProjK Ω N).presheaf.germ _ p hp).hom
          (((Proj.map (Φ M hMh) hφ).app (wcSgD Ω N c)).hom (wcLdpSec Ω N G c)) =
        ((wcProjK Ω N).presheaf.germ _ p hp').hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) s').hom
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
              hs1 2 (Φ M hMh (G : MvPolynomial (Fin (N + 1)) Ω)) ((Φ M hMh).map_mem G.2))) := by
      intro s' hs hs1 hp'
      subst hs
      have e2 := congrArg (fun φ => CommRingCat.Hom.hom φ
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (hX c) 2 (G : MvPolynomial (Fin (N + 1)) Ω) G.2))
        (Proj.awayToSection_comp_appLE (Φ M hMh) hφ (hX c))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
        HomogeneousLocalization.Away.map_mk] at e2
      rw [Scheme.Hom.app_eq_appLE, ← e2]
      rfl
    exact STAR (M c) hs (hMc c) hp'

  have CHART : ∀ (f h F : MvPolynomial (Fin (N + 1)) Ω)
      (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1)
      (hh : h ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1)
      (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (2 • 1)) (p : wcProjK Ω N)
      (hpf : p ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) f)
      (hph : p ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) h),
      ∃ w : (wcProjK Ω N).presheaf.stalk p,
        ((wcProjK Ω N).presheaf.germ _ p hpf).hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) f).hom
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
              hf 2 F hF)) =
        w * ((wcProjK Ω N).presheaf.germ _ p hph).hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) h).hom
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
              hh 2 F hF)) := by
    intro f h F hf hh hF p hpf hph
    have hle1 : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (f * h) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) f := by
      rw [Proj.basicOpen_mul]; exact inf_le_left
    have hle2 : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (f * h) ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) h := by
      rw [Proj.basicOpen_mul]; exact inf_le_right
    have hpx : p ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (f * h) := by
      rw [Proj.basicOpen_mul]; exact ⟨hpf, hph⟩
    have hxdeg : f * h ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (1 + 1) :=
      SetLike.mul_mem_graded hf hh
    have hu : h * h ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (1 • (1 + 1)) :=
      SetLike.mul_mem_graded hh hh
    have e1 := congrArg (fun φ => CommRingCat.Hom.hom φ
      (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hf 2 F hF))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hh
        (rfl : f * h = f * h))
    have e2 := congrArg (fun φ => CommRingCat.Hom.hom φ
      (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hh 2 F hF))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hf
        (mul_comm f h))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e1 e2
    have g1 := TopCat.Presheaf.germ_res_apply (wcProjK Ω N).presheaf (homOfLE hle1) p hpx
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) f).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hf 2 F hF))
    have g2 := TopCat.Presheaf.germ_res_apply (wcProjK Ω N).presheaf (homOfLE hle2) p hpx
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) h).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hh 2 F hF))
    rw [← e1] at g1
    rw [← e2] at g2
    have key : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        hh (rfl : f * h = f * h)
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hf 2 F hF) =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hxdeg 1 (h * h) hu ^ 2 *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hf (mul_comm f h)
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hh 2 F hF) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_pow,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, Localization.mk_pow, Localization.mk_mul,
        Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul, SubmonoidClass.coe_pow]
      ring
    refine ⟨((wcProjK Ω N).presheaf.germ _ p hpx).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (f * h)).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hxdeg 1 (h * h) hu)) ^ 2, ?_⟩
    rw [← g1, ← g2, key, map_mul, map_mul, map_pow, map_pow]

  have hspan : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω)) := by
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff
        (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have COVER : ∀ p : wcProjK Ω N, ∃ c, p ∈ wcSgD Ω N c := by
    intro p
    have hp : p ∈ (⨆ c : Fin (N + 1),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X c)) := by
      rw [Proj.iSup_basicOpen_eq_top _ _ hspan]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hp

  have QF : ∀ (K : Matrix (Fin (N + 1)) (Fin (N + 1)) Ω)
      (v : Fin (N + 1) → MvPolynomial (Fin (N + 1)) Ω),
      ∑ p, ∑ q, MvPolynomial.C (K p q) * (v p * v q) =
        dotProduct v (Matrix.mulVec (K.map MvPolynomial.C) v) := by
    intro K v
    simp only [dotProduct, Matrix.mulVec, Matrix.map_apply, Finset.mul_sum]
    exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => by ring
  have hPM' : Matrix.mulVec (P.map MvPolynomial.C) M = MvPolynomial.X := by
    funext r
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply]
    exact hPM r
  have hPMv : Matrix.vecMul M (P.transpose.map MvPolynomial.C) = MvPolynomial.X := by
    funext r
    simp only [Matrix.vecMul, dotProduct, Matrix.map_apply, Matrix.transpose_apply]
    rw [← hPM r]
    exact Finset.sum_congr rfl fun j _ => mul_comm _ _
  have POLY : Φ M hMh ((wcLdpQuad Ω N (fun p q => (P.transpose * A * P) p q) :
      MvPolynomial (Fin (N + 1)) Ω)) =
      (wcLdpQuad Ω N (fun p q => A p q) : MvPolynomial (Fin (N + 1)) Ω) := by
    show MvPolynomial.aeval M (∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C ((P.transpose * A * P) p q) * (MvPolynomial.X p * MvPolynomial.X q)) =
      ∑ p : Fin (N + 1), ∑ q : Fin (N + 1),
        MvPolynomial.C (A p q) * (MvPolynomial.X p * MvPolynomial.X q)
    simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
      MvPolynomial.algebraMap_eq]
    rw [QF (P.transpose * A * P) M, QF A MvPolynomial.X, Matrix.map_mul, Matrix.map_mul,
      ← Matrix.mulVec_mulVec, hPM', ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, hPMv]

  refine ⟨jY ≫ g, ?_, ?_, ?_⟩
  · haveI := hjY
    haveI : IsIso g := by rw [hgdef]; exact hgI
    exact IsClosedImmersion.comp jY g
  · rw [Category.assoc, hstr, hjYY]
  · intro x c hx
    have hp : jY x ∈ g ⁻¹ᵁ wcSgD Ω N c := hx
    have hpre : g ⁻¹ᵁ wcSgD Ω N c =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (Φ M hMh (MvPolynomial.X c)) := by
      rw [hgdef]; exact Proj.map_preimage_basicOpen _ _ _
    have hpM : jY x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (M c) := by
      have h1 := hp
      have e : Φ M hMh (MvPolynomial.X c) = M c := MvPolynomial.aeval_X M c
      rw [hpre, e] at h1
      exact h1
    obtain ⟨c', hc'⟩ := COVER (jY x)
    obtain ⟨w, hw⟩ := CHART (M c) (MvPolynomial.X c')
      ((wcLdpQuad Ω N (fun p q => A p q)) : MvPolynomial (Fin (N + 1)) Ω) (hMc c) (hX c')
      (wcLdpQuad Ω N (fun p q => A p q)).2 (jY x) hpM hc'
    have key : (Y.presheaf.germ ((jY ≫ g) ⁻¹ᵁ wcSgD Ω N c) x hx).hom
        (((jY ≫ g).app (wcSgD Ω N c)).hom
          (wcLdpSec Ω N (wcLdpQuad Ω N (fun p q => (P.transpose * A * P) p q)) c)) =
        (jY.stalkMap x).hom (((wcProjK Ω N).presheaf.germ _ (jY x) hp).hom
          ((g.app (wcSgD Ω N c)).hom
            (wcLdpSec Ω N (wcLdpQuad Ω N (fun p q => (P.transpose * A * P) p q)) c))) := by
      rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.comp_app]
      rfl
    unfold wcLdpGerm
    rw [key, SECG _ c (jY x) hp hpM _ (wcLdpQuad Ω N (fun p q => A p q)).2 POLY, hw, map_mul]
    apply Ideal.mul_mem_left
    have hx' : x ∈ jY ⁻¹ᵁ wcSgD Ω N c' := hc'
    have h2 := hA x c' hx'
    unfold wcLdpGerm at h2
    convert h2 using 1
    exact Scheme.Hom.germ_stalkMap_apply jY (wcSgD Ω N c') x hc'
      (wcLdpSec Ω N (wcLdpQuad Ω N (fun p q => A p q)) c')

theorem wc_qmbt_qm_model_square_ext {A : Type u} [CommRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ'2 : π' ^ 2 = ιA π)
    {Xm : Scheme.{u}}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl) :
    ∃ (θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA))
      (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
      (ψ : Xm ⟶ X₁),
      (∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p)) ∧
      θ.comp (algebraMap A (wcQuadModelRing A n π c)) =
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))).comp ιA ∧
      wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (wcQmbtGen A' n π' (c.map ιA) k)))) r₁ ∧
      IsPullback ψ (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) a₀ ∧
      ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ∧
      TopologicalSpace.NoetherianSpace ↥(Limits.pullback (C := Scheme.{u}) (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A')) :=
by
  classical

  obtain ⟨θ, hθX, hθA, sq₁⟩ := wc_qmbt_bm_quad_pullback ιA n π c π' hπ'2
  obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      gP ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
    ⟨sq₁.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
  have sqL : IsPullback (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) gP a₀ (Spec.map (CommRingCat.ofHom θ)) := by
    refine IsPullback.of_bot ?_ hgP1.symm sq₁
    rw [hgP2]
    exact IsPullback.of_hasPullback _ _
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hgPw : WeaklyEtale gP := MorphismProperty.of_isPullback (P := @WeaklyEtale) sqL ha₀

  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) :=
    inferInstance
  obtain ⟨X₁, r₁, hb₁, hX₁⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k))))

  haveI hgPflat : Flat gP := hgPw.flat
  haveI hPaff : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    dsimp only [wcQuadModelStr]
    infer_instance
  have hbl₀ := wc_qmbt_bm_flat_base_change
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ gP hb₁
  have hblP : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))))))
      (Limits.pullback.snd r₁ gP) := by
    convert hbl₀ using 4
    funext i
    cases i with
    | none =>
      show (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π') =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π'))
      rw [← hgP2, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
      congr 1
      have := congrArg (fun φ => φ.hom π') (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    | some j =>
      show ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))) =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X j)))
      rw [← hgP1, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, ← hθX j]
      congr 1
      have := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X j))) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm

  obtain ⟨φ, hφ⟩ := (hblP.2 Xm bl hbl.1).exists
  obtain ⟨χ, hχ⟩ := (hbl.2 _ (Limits.pullback.snd r₁ gP) hblP.1).exists
  have h1 : φ ≫ χ = 𝟙 Xm := by
    apply (hbl.2 Xm bl hbl.1).unique
    · show (φ ≫ χ) ≫ bl = bl
      rw [Category.assoc, hχ, hφ]
    · show 𝟙 Xm ≫ bl = bl
      exact Category.id_comp _
  have h2 : χ ≫ φ = 𝟙 _ := by
    apply (hblP.2 _ (Limits.pullback.snd r₁ gP) hblP.1).unique
    · show (χ ≫ φ) ≫ Limits.pullback.snd r₁ gP = Limits.pullback.snd r₁ gP
      rw [Category.assoc, hφ, hχ]
    · show 𝟙 _ ≫ Limits.pullback.snd r₁ gP = Limits.pullback.snd r₁ gP
      exact Category.id_comp _
  haveI : IsIso φ := ⟨⟨χ, h1, h2⟩⟩

  have sqT : IsPullback (φ ≫ Limits.pullback.fst r₁ gP) bl r₁ gP :=
    IsPullback.of_iso_pullback
      ⟨by rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hφ]⟩
      (asIso φ) rfl hφ

  have h5 : (φ ≫ Limits.pullback.fst r₁ gP) ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
      bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) := by
    rw [← hgP2, ← hφ]
    simp only [Category.assoc]
    rw [Limits.pullback.condition_assoc]

  haveI hX₁' := hX₁
  haveI hsp : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hfst : IsClosedImmersion (Limits.pullback.fst (C := Scheme.{u})
      (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A')) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback _ _).flip hsp
  have h6 : TopologicalSpace.NoetherianSpace ↥(Limits.pullback (C := Scheme.{u})
      (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A')) :=
    Topology.IsInducing.noetherianSpace
      (IsClosedImmersion.isClosedEmbedding (Limits.pullback.fst (C := Scheme.{u})
        (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A'))).isInducing
  exact ⟨θ, X₁, r₁, φ ≫ Limits.pullback.fst r₁ gP, hθX, hθA, hb₁,
    IsPullback.paste_vert sqT sqL.flip, h5, h6⟩

theorem wc_qmdl_gen_ideal_maximal {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (n : ℕ)
    (c' : Matrix (Fin n) (Fin n) A') :
    ∃ ρ₀ : wcQuadModelRing A' n (π' ^ 2) c' →+* IsLocalRing.ResidueField A',
      (∀ p, ρ₀ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0) ∧
      ρ₀.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) = IsLocalRing.residue A' ∧
      (Ideal.span (Set.range (wcQmbtGen A' n π' c'))).IsMaximal :=
by
  classical
  set I := wcQuadModelIdeal A' n (π' ^ 2) c' with hI
  set Q : MvPolynomial (Fin n) A' :=
    ∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q with hQ
  have hIdef : I = Ideal.span {Q - MvPolynomial.C (π' ^ 2)} := rfl
  have hπm : π' ∈ IsLocalRing.maximalIdeal A' := by
    rw [hπ']; exact Ideal.mem_span_singleton_self π'
  have hres : IsLocalRing.residue A' π' = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff]; exact hπm
  let ε : MvPolynomial (Fin n) A' →+* IsLocalRing.ResidueField A' :=
    (IsLocalRing.residue A').comp MvPolynomial.constantCoeff
  have hccQ : MvPolynomial.constantCoeff Q = 0 := by
    rw [hQ]; simp
  have hεI : ∀ a ∈ I, ε a = 0 := by
    intro a ha
    rw [hIdef, Ideal.mem_span_singleton'] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [map_mul]
    show ε b * IsLocalRing.residue A'
      (MvPolynomial.constantCoeff (Q - MvPolynomial.C (π' ^ 2))) = 0
    rw [map_sub, hccQ, MvPolynomial.constantCoeff_C, zero_sub, map_neg, map_pow, hres,
      zero_pow two_ne_zero, neg_zero, mul_zero]
  let ρ₀ : MvPolynomial (Fin n) A' ⧸ I →+* IsLocalRing.ResidueField A' :=
    Ideal.Quotient.lift I ε hεI
  have hρ : ∀ f, ρ₀ (Ideal.Quotient.mk I f) =
      IsLocalRing.residue A' (MvPolynomial.constantCoeff f) :=
    fun f => Ideal.Quotient.lift_mk _ _ _
  have halg : ∀ a : A', algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a =
      Ideal.Quotient.mk I (MvPolynomial.C a) := fun a => rfl
  have h3 : ∀ p, ρ₀ (Ideal.Quotient.mk I (MvPolynomial.X p)) = 0 := by
    intro p
    rw [hρ, MvPolynomial.constantCoeff_X, map_zero]
  have h4 : ρ₀.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      IsLocalRing.residue A' := by
    ext a
    rw [RingHom.comp_apply, halg, hρ, MvPolynomial.constantCoeff_C]
  have hsurj : Function.Surjective ρ₀ := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨Ideal.Quotient.mk I (MvPolynomial.C a), by rw [hρ, MvPolynomial.constantCoeff_C]⟩
  have hmax : (RingHom.ker ρ₀).IsMaximal := RingHom.ker_isMaximal_of_surjective ρ₀ hsurj
  refine ⟨ρ₀, h3, h4, ?_⟩
  set J := Ideal.span (Set.range (wcQmbtGen A' n π' c')) with hJ
  have hXJ : ∀ p, Ideal.Quotient.mk I (MvPolynomial.X p) ∈ J :=
    fun p => Ideal.subset_span ⟨some p, rfl⟩
  have hπJ : Ideal.Quotient.mk I (MvPolynomial.C π') ∈ J :=
    Ideal.subset_span ⟨none, rfl⟩
  have h1 : J ≤ RingHom.ker ρ₀ := by
    rw [hJ, Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    cases k with
    | none =>
      show ρ₀ (Ideal.Quotient.mk I (MvPolynomial.C π')) = 0
      rw [hρ, MvPolynomial.constantCoeff_C, hres]
    | some p =>
      show ρ₀ (Ideal.Quotient.mk I (MvPolynomial.X p)) = 0
      exact h3 p
  have hdec : ∀ f : MvPolynomial (Fin n) A',
      Ideal.Quotient.mk I f -
        Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
    intro f
    induction f using MvPolynomial.induction_on
    next a =>
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact J.zero_mem
    next p q hp hq =>
      have := J.add_mem hp hq
      simp only [map_add]
      convert this using 1
      ring
    next p i _ =>
      simp only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, MvPolynomial.C_0, map_zero,
        sub_zero]
      exact J.mul_mem_left _ (hXJ i)
  have h2 : RingHom.ker ρ₀ ≤ J := by
    intro r hr
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [RingHom.mem_ker, hρ, IsLocalRing.residue_eq_zero_iff, hπ',
      Ideal.mem_span_singleton'] at hr
    obtain ⟨a, ha⟩ := hr
    have hC : Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
      rw [← ha, MvPolynomial.C_mul, map_mul]
      exact J.mul_mem_left _ hπJ
    have := J.add_mem (hdec f) hC
    rwa [sub_add_cancel] at this
  rw [le_antisymm h1 h2]
  exact hmax

theorem wc_qmdl_charts_exist {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (c' : Matrix (Fin n) (Fin n) A') {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁) :
    ∃ (φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j)
      (φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c')
      (e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁)
      (e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁),
      wcQmdlChartPkg π' c' r₁ φ φ0 e e0 :=
by
  classical
  choose φ hφX hφA hφnzd hφgen hφup using fun j : Fin n => wc_qmbt_bm_chart_algebra hπ' c' j
  obtain ⟨φ0, h0X, h0A, h0nzd, h0gen, h0up⟩ := wc_qmbt_bm_chart_algebra_none hπ' c'
  let Φ : ∀ k : Option (Fin n), CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶
      wcQmbtCharts A' n π' c' k := fun k =>
    match k with
    | none => CommRingCat.ofHom φ0
    | some j => CommRingCat.ofHom (φ j)
  obtain ⟨e', he'open, he'r, he'cov⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c')) (wcQmbtGen A' n π' c') r₁ hr
    (wcQmbtCharts A' n π' c') Φ
    (by
      rintro (_ | j)
      · exact h0nzd
      · exact hφnzd j)
    (by
      rintro (_ | j)
      · exact h0gen
      · exact hφgen j)
    (by
      rintro (_ | j) B ρ h1 h2
      · exact h0up B ρ h1 h2
      · exact hφup j B ρ h1 h2)
  refine ⟨φ, φ0, fun j => e' (some j), e' none, hφX, hφA, hφnzd, hφgen, h0X, h0A,
    fun j => he'open (some j), he'open none, fun j => he'r (some j), he'r none, ?_⟩
  intro x
  obtain ⟨k, y, hy⟩ := he'cov x
  cases k with
  | none => exact Or.inl ⟨y, hy⟩
  | some j => exact Or.inr ⟨j, y, hy⟩

theorem wc_qmdl_chart_maps {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ} (hn : 4 ≤ n)
    (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K)
    (E : Over (Spec (.of K))) [SmoothOfRelativeDimension (n - 2) E.hom]
    (jE : E.left ⟶ wcProjK K (n - 2 + 1)) (hjEY : jE ≫ wcProjKStr K (n - 2 + 1) = E.hom)
    (hEG : ∀ (x : E.left) (c'' : Fin (n - 2 + 1 + 1))
        (hx : x ∈ jE ⁻¹ᵁ wcSgD K (n - 2 + 1) c''),
      wcLdpGerm K (n - 2 + 1) jE (wcLdpQuad K (n - 2 + 1) (wcQmdlA hn c' σ)) c'' x hx ∈
        IsLocalRing.maximalIdeal (E.left.presheaf.stalk x))
    (j : Fin n) :
    ∃ (χ : wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j))
      (ψ : (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j))),
      wcQmdlChiPkg π' hn c' σ E jE j χ ψ ∧
      ∀ z : wcQmdlV K hn jE j, wcQmdlCX A' n π' c' j none ∈ (ψ z).asIdeal ∧
        wcQmdlCX A' n π' c' j (some j) ∈ (ψ z).asIdeal ∧
        algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ (ψ z).asIdeal :=
by
  classical
  have hnm : n = n - 2 + 1 + 1 := by omega

  haveI : ∀ x : E.left, IsDomain (E.left.presheaf.stalk x) := fun x =>
    wcpa_smooth_stalk_isDomain K E.left E.hom (n - 2) x
  haveI : AlgebraicGeometry.IsReduced E.left := isReduced_of_isReduced_stalk _

  let κ : K →+* Γ(E.left, wcQmdlV K hn jE j) := wcCnSigma E.hom (wcQmdlV K hn jE j)
  let t : Fin (n - 2 + 1 + 1) → Γ(E.left, wcQmdlV K hn jE j) := fun L =>
    (jE.app (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))).hom (wcSgE K (n - 2 + 1) (wcQmdlIdx hn j) L)
  let v : Fin n → Γ(E.left, wcQmdlV K hn jE j) := fun p => t (wcQmdlIdx hn p)

  have hgermκ : ∀ (x : E.left) (hx : x ∈ wcQmdlV K hn jE j) (c : K),
      (E.left.presheaf.germ (wcQmdlV K hn jE j) x hx).hom (κ c) = wcLdpConst K E.hom x c := by
    intro x hx c
    exact TopCat.Presheaf.germ_res_apply E.left.presheaf (homOfLE le_top) x hx _

  have hvj : v j = 1 := by
    show (jE.app (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))).hom
      (wcSgE K (n - 2 + 1) (wcQmdlIdx hn j) (wcQmdlIdx hn j)) = 1
    rw [(wc_ldp_lnf_sec_quad K (n - 2 + 1) (wcQmdlIdx hn j) (wcQmdlA hn c' σ)).1, map_one]

  have he : (∑ p, ∑ q, κ (wcQmdlA hn c' σ p q) * t p * t q) = 0 := by
    apply eq_zero_of_basicOpen_eq_bot
    rw [eq_bot_iff]
    intro x hx
    exfalso
    have hxU : x ∈ wcQmdlV K hn jE j := E.left.basicOpen_le _ hx
    rw [Scheme.mem_basicOpen _ _ _ hxU] at hx
    have hg := hEG x (wcQmdlIdx hn j) hxU
    have hc := (wc_ldp_lnf_chart_germ K (n - 2 + 1) E jE hjEY
      (fun a p hp c => wc_ldp_il_proj_const K (n - 2 + 1) a p hp c)
      (fun a w => wc_ldp_lnf_sec_quad K (n - 2 + 1) a w) (wcQmdlIdx hn j) x hxU).2.2.1
      (wcQmdlA hn c' σ)
    rw [hc] at hg
    apply (IsLocalRing.mem_maximalIdeal _).mp hg
    convert hx using 1
    simp only [map_sum, map_mul, hgermκ]
    rfl

  have hquad : ∑ p : Fin n, ∑ q : Fin n,
      κ (σ (IsLocalRing.residue A' (c' p q))) * v p * v q = 0 := by
    rw [← he]
    refine Fintype.sum_equiv (finCongr hnm) _ _ (fun p => ?_)
    refine Fintype.sum_equiv (finCongr hnm) _ _ (fun q => ?_)
    rfl

  have hres : IsLocalRing.residue A' π' = 0 :=
    (IsLocalRing.residue_eq_zero_iff π').mpr (by rw [hπ']; exact Ideal.mem_span_singleton_self π')

  let f₀ : A' →+* Γ(E.left, wcQmdlV K hn jE j) :=
    (κ.comp σ.toRingHom).comp (IsLocalRing.residue A')
  let w : Option (Fin n) → Γ(E.left, wcQmdlV K hn jE j) := fun i =>
    Option.elim i 0 (fun p => if p = j then 0 else v p)
  let F : MvPolynomial (Option (Fin n)) A' →+* Γ(E.left, wcQmdlV K hn jE j) :=
    MvPolynomial.eval₂Hom f₀ w
  have hw0 : w none = 0 := rfl
  have hwj : w (some j) = 0 := if_pos rfl
  have hwp : ∀ p, p ≠ j → w (some p) = v p := fun p hp => if_neg hp
  have hHat : ∀ p, F (wcQmbtChartHat j p) = v p := by
    intro p
    by_cases hp : p = j
    · simp only [wcQmbtChartHat, if_pos hp, map_one]
      rw [hp, hvj]
    · simp only [wcQmbtChartHat, if_neg hp, F, MvPolynomial.eval₂Hom_X']
      exact hwp p hp
  have hF : ∀ a ∈ wcQmbtChartIdeal A' n π' c' j, F a = 0 := by
    intro a ha
    have hle : wcQmbtChartIdeal A' n π' c' j ≤ RingHom.ker F := by
      apply Ideal.span_le.mpr
      intro g hg
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
      rcases hg with rfl | rfl
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul]
        simp only [F, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hw0, hwj, mul_zero]
        simp only [f₀, RingHom.comp_apply, hres, map_zero, sub_zero]
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_pow, map_sum]
        simp only [map_sum, map_mul, hHat]
        simp only [F, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hw0]
        simp only [f₀, RingHom.comp_apply]
        rw [pow_two, mul_zero, sub_zero]
        exact hquad
    exact hle ha
  let χ : wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j) :=
    Ideal.Quotient.lift (wcQmbtChartIdeal A' n π' c' j) F hF
  have hχX : ∀ i, χ (wcQmdlCX A' n π' c' j i) = w i := by
    intro i
    show Ideal.Quotient.lift _ F hF (Ideal.Quotient.mk _ (MvPolynomial.X i)) = w i
    rw [Ideal.Quotient.lift_mk]
    exact MvPolynomial.eval₂Hom_X' f₀ w i
  have hχA : ∀ x : A', χ (algebraMap A' (wcQmbtChart A' n π' c' j) x) =
      κ (σ (IsLocalRing.residue A' x)) := by
    intro x
    rw [← Ideal.Quotient.mk_algebraMap]
    show Ideal.Quotient.lift _ F hF (Ideal.Quotient.mk _ _) = _
    rw [Ideal.Quotient.lift_mk, MvPolynomial.algebraMap_eq]
    exact MvPolynomial.eval₂Hom_C f₀ w x
  have hχnone : χ (wcQmdlCX A' n π' c' j none) = 0 := (hχX none).trans hw0
  have hχj : χ (wcQmdlCX A' n π' c' j (some j)) = 0 := (hχX (some j)).trans hwj
  have hχπ : χ (algebraMap A' (wcQmbtChart A' n π' c' j) π') = 0 := by
    rw [hχA, hres, map_zero, map_zero]

  let φ : wcQmbtChart A' n π' c' j →+* Γ((wcQmdlV K hn jE j).toScheme, ⊤) :=
    (wcQmdlV K hn jE j).topIso.inv.hom.comp χ
  let φc : CommRingCat.of (wcQmbtChart A' n π' c' j) ⟶ Γ((wcQmdlV K hn jE j).toScheme, ⊤) :=
    CommRingCat.ofHom φ
  let ψ : (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)) :=
    (wcQmdlV K hn jE j).toScheme.toSpecΓ ≫ Spec.map φc
  have key : (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv ≫ ψ.appTop = φc := by
    simp only [ψ, Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality]
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have happ : ∀ f : wcQmbtChart A' n π' c' j,
      ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv.hom f) =
        (wcQmdlV K hn jE j).topIso.inv.hom (χ f) := by
    intro f
    have h := congrArg (fun g => g.hom f) key
    exact h
  have hmem : ∀ (z : (wcQmdlV K hn jE j).toScheme) (g : wcQmbtChart A' n π' c' j),
      χ g = 0 → g ∈ (ψ z).asIdeal := by
    intro z g hg
    by_contra hne
    have h1 : ψ z ∈ (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j))).basicOpen
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv.hom g) := by
      rw [basicOpen_eq_of_affine]
      exact (PrimeSpectrum.mem_basicOpen _ _).mpr hne
    have h2 : z ∈ ψ ⁻¹ᵁ (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j))).basicOpen
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv.hom g) :=
      (Scheme.Hom.mem_preimage ψ).mpr h1
    rw [Scheme.preimage_basicOpen_top] at h2
    have h3 : ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv.hom g)
        = 0 := by rw [happ g, hg, map_zero]
    erw [h3, Scheme.basicOpen_zero] at h2
    exact h2
  refine ⟨χ, ψ, ⟨hχnone, hχj, fun p hp => (hχX (some p)).trans (hwp p hp), hχA, happ⟩,
    fun z => ⟨hmem z _ hχnone, hmem z _ hχj, hmem z _ hχπ⟩⟩

theorem wc_qmdl_chart_transition {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁)
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0) (l m : Fin n) (hlm : l ≠ m) :
    ∃ τ : wcQmbtChart A' n π' c' m →+* Localization.Away (wcQmdlCX A' n π' c' l (some m)),
      τ (wcQmdlCX A' n π' c' m none) =
          algebraMap (wcQmbtChart A' n π' c' l) (Localization.Away (wcQmdlCX A' n π' c' l (some m)))
            (wcQmdlCX A' n π' c' l none) *
            IsLocalization.Away.invSelf (S := Localization.Away (wcQmdlCX A' n π' c' l (some m)))
              (wcQmdlCX A' n π' c' l (some m)) ∧
      τ (wcQmdlCX A' n π' c' m (some m)) =
          algebraMap (wcQmbtChart A' n π' c' l) (Localization.Away (wcQmdlCX A' n π' c' l (some m)))
            (wcQmdlCX A' n π' c' l (some l) * wcQmdlCX A' n π' c' l (some m)) ∧
      (∀ p, p ≠ m → τ (wcQmdlCX A' n π' c' m (some p)) =
          algebraMap (wcQmbtChart A' n π' c' l) (Localization.Away (wcQmdlCX A' n π' c' l (some m)))
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) *
            IsLocalization.Away.invSelf (S := Localization.Away (wcQmdlCX A' n π' c' l (some m)))
              (wcQmdlCX A' n π' c' l (some m))) ∧
      τ.comp (algebraMap A' (wcQmbtChart A' n π' c' m)) =
        (algebraMap (wcQmbtChart A' n π' c' l)
          (Localization.Away (wcQmdlCX A' n π' c' l (some m)))).comp
          (algebraMap A' (wcQmbtChart A' n π' c' l)) ∧
      Spec.map (CommRingCat.ofHom (algebraMap (wcQmbtChart A' n π' c' l)
          (Localization.Away (wcQmdlCX A' n π' c' l (some m))))) ≫ e l =
        Spec.map (CommRingCat.ofHom τ) ≫ e m :=
by
  classical
  obtain ⟨hP1, hP2, hP3, hP4, -, -, -, -, hP9, -, -⟩ := hpkg

  have key : ∀ (L : Type u) [CommRing L] (α : wcQmbtChart A' n π' c' l →+* L) (inv : L),
      α (wcQmdlCX A' n π' c' l (some m)) * inv = 1 →
      ∃ τ : wcQmbtChart A' n π' c' m →+* L,
        τ (wcQmdlCX A' n π' c' m none) = α (wcQmdlCX A' n π' c' l none) * inv ∧
        τ (wcQmdlCX A' n π' c' m (some m)) =
          α (wcQmdlCX A' n π' c' l (some l) * wcQmdlCX A' n π' c' l (some m)) ∧
        (∀ p, p ≠ m → τ (wcQmdlCX A' n π' c' m (some p)) =
          α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) * inv) ∧
        τ.comp (algebraMap A' (wcQmbtChart A' n π' c' m)) =
          α.comp (algebraMap A' (wcQmbtChart A' n π' c' l)) ∧
        τ.comp (φ m) = α.comp (φ l) := by
    intro L _ α inv hαinv
    obtain ⟨v, hvn, hvm, hvp⟩ : ∃ v : Option (Fin n) → L,
        v none = α (wcQmdlCX A' n π' c' l none) * inv ∧
        v (some m) = α (wcQmdlCX A' n π' c' l (some l) * wcQmdlCX A' n π' c' l (some m)) ∧
        ∀ p, p ≠ m → v (some p) =
          α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) * inv :=
      ⟨fun i => Option.elim i (α (wcQmdlCX A' n π' c' l none) * inv) (fun p =>
          if p = m then α (wcQmdlCX A' n π' c' l (some l) * wcQmdlCX A' n π' c' l (some m))
          else α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) * inv),
        rfl, if_pos rfl, fun p hp => if_neg hp⟩
    obtain ⟨τ₀, hτX, hτC⟩ : ∃ τ₀ : MvPolynomial (Option (Fin n)) A' →+* L,
        (∀ i, τ₀ (MvPolynomial.X i) = v i) ∧
        ∀ a, τ₀ (MvPolynomial.C a) =
          α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (MvPolynomial.C a)) :=
      ⟨MvPolynomial.eval₂Hom (α.comp (algebraMap A' (wcQmbtChart A' n π' c' l))) v,
        fun i => MvPolynomial.eval₂Hom_X' _ _ _, fun a => MvPolynomial.eval₂Hom_C _ _ _⟩
    have hHm : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l m) =
        wcQmdlCX A' n π' c' l (some m) := by
      show Ideal.Quotient.mk _ (if m = l then 1 else MvPolynomial.X (some m)) = _
      rw [if_neg (Ne.symm hlm)]
    have hKO : ∀ p, τ₀ (wcQmbtChartHat m p) =
        α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) * inv := by
      intro p
      by_cases hp : p = m
      · rw [hp, hHm, hαinv]
        show τ₀ (if m = m then 1 else MvPolynomial.X (some m)) = 1
        rw [if_pos rfl, map_one]
      · show τ₀ (if p = m then 1 else MvPolynomial.X (some p)) = _
        rw [if_neg hp, hτX, hvp p hp]
    have hg1l : (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l))
        (MvPolynomial.X (some l) * MvPolynomial.X none - MvPolynomial.C π') = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
    have hg2l : (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l))
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat l p * wcQmbtChartHat l q -
          MvPolynomial.X none ^ 2) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    have hrel1 : τ₀ (MvPolynomial.X (some m) * MvPolynomial.X none - MvPolynomial.C π') = 0 := by
      rw [map_sub, map_mul, hτX, hτX, hτC, hvm, hvn]
      have h1 := congrArg α hg1l
      simp only [map_zero, map_sub, map_mul] at h1
      rw [map_mul]
      linear_combination h1 + (α (wcQmdlCX A' n π' c' l (some l)) *
        α (wcQmdlCX A' n π' c' l none)) * hαinv
    have hrel2 : τ₀ (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat m p *
        wcQmbtChartHat m q - MvPolynomial.X none ^ 2) = 0 := by
      have h2 : ∑ p, ∑ q, α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l)
            (MvPolynomial.C (c' p q))) *
            α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) *
            α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l q)) -
          α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (MvPolynomial.X none)) ^ 2 = 0 := by
        have := congrArg α hg2l
        simpa only [map_zero, map_sub, map_sum, map_mul, map_pow] using this
      have e1 : τ₀ (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat m p *
          wcQmbtChartHat m q - MvPolynomial.X none ^ 2) =
          ∑ p, ∑ q, α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l)
            (MvPolynomial.C (c' p q))) *
            (α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) * inv) *
            (α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l q)) * inv) -
          (α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (MvPolynomial.X none)) * inv) ^ 2 := by
        simp only [map_sub, map_sum, map_mul, map_pow, hτC, hKO, hτX, hvn]
      have hs : ∑ p, ∑ q, α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l)
            (MvPolynomial.C (c' p q))) *
            (α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) * inv) *
            (α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l q)) * inv) =
          inv ^ 2 * ∑ p, ∑ q, α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l)
            (MvPolynomial.C (c' p q))) *
            α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) *
            α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l q)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun q _ => ?_
        ring
      rw [e1, hs]
      linear_combination inv ^ 2 * h2
    have hker : ∀ a ∈ wcQmbtChartIdeal A' n π' c' m, τ₀ a = 0 := by
      intro a ha
      have hle : wcQmbtChartIdeal A' n π' c' m ≤ RingHom.ker τ₀ := by
        refine Ideal.span_le.mpr ?_
        intro x hx
        rcases hx with rfl | rfl
        · exact hrel1
        · exact hrel2
      exact hle ha
    refine ⟨Ideal.Quotient.lift _ τ₀ hker, ?_, ?_, ?_, ?_, ?_⟩
    · show Ideal.Quotient.lift _ τ₀ hker (Ideal.Quotient.mk _ (MvPolynomial.X none)) = _
      rw [Ideal.Quotient.lift_mk, hτX, hvn]
    · show Ideal.Quotient.lift _ τ₀ hker (Ideal.Quotient.mk _ (MvPolynomial.X (some m))) = _
      rw [Ideal.Quotient.lift_mk, hτX, hvm]
    · intro p hp
      show Ideal.Quotient.lift _ τ₀ hker (Ideal.Quotient.mk _ (MvPolynomial.X (some p))) = _
      rw [Ideal.Quotient.lift_mk, hτX, hvp p hp]
    · refine RingHom.ext fun a => ?_
      show Ideal.Quotient.lift _ τ₀ hker (Ideal.Quotient.mk _ (MvPolynomial.C a)) =
        α (Ideal.Quotient.mk _ (MvPolynomial.C a))
      rw [Ideal.Quotient.lift_mk, hτC]
    · apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        have hm : φ m (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a) =
            algebraMap A' (wcQmbtChart A' n π' c' m) a := RingHom.congr_fun (hP2 m) a
        have hl : φ l (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a) =
            algebraMap A' (wcQmbtChart A' n π' c' l) a := RingHom.congr_fun (hP2 l) a
        show Ideal.Quotient.lift _ τ₀ hker
            (φ m (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a)) =
          α (φ l (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a))
        rw [hm, hl]
        show Ideal.Quotient.lift _ τ₀ hker (Ideal.Quotient.mk _ (MvPolynomial.C a)) =
          α (Ideal.Quotient.mk _ (MvPolynomial.C a))
        rw [Ideal.Quotient.lift_mk, hτC]
      · intro i
        show Ideal.Quotient.lift _ τ₀ hker
            (φ m (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X i))) =
          α (φ l (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X i)))
        rw [hP1 m i, hP1 l i, Ideal.Quotient.lift_mk]
        simp only [map_mul, hτX, hvm, hKO]
        linear_combination (α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l)
          (MvPolynomial.X (some l))) *
          α (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l i))) * hαinv
  obtain ⟨τ, hτ1, hτ2, hτ3, hτA, hcomp⟩ :=
    key (Localization.Away (wcQmdlCX A' n π' c' l (some m))) (algebraMap _ _)
      (IsLocalization.Away.invSelf (S := Localization.Away (wcQmdlCX A' n π' c' l (some m)))
        (wcQmdlCX A' n π' c' l (some m)))
      (IsLocalization.Away.mul_invSelf _)
  refine ⟨τ, hτ1, hτ2, hτ3, hτA, ?_⟩

  let α : wcQmbtChart A' n π' c' l →+* Localization.Away (wcQmdlCX A' n π' c' l (some m)) :=
    algebraMap _ _
  let ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶
      CommRingCat.of (Localization.Away (wcQmdlCX A' n π' c' l (some m))) :=
    CommRingCat.ofHom (α.comp (φ l))
  have h1a : φ l (wcQmbtGen A' n π' c' (some l)) = wcQmdlCX A' n π' c' l (some l) := by
    show φ l (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X l)) = _
    rw [hP1 l l]
    simp [wcQmbtChartHat, wcQmdlCX]
  have hx : wcQmdlCX A' n π' c' l (some l) ∈ nonZeroDivisors (wcQmbtChart A' n π' c' l) := by
    rw [← h1a]; exact hP3 l
  have hαx : α (wcQmdlCX A' n π' c' l (some l)) ∈
      nonZeroDivisors (Localization.Away (wcQmdlCX A' n π' c' l (some m))) := by
    have h := IsLocalization.nonZeroDivisors_le_comap
      (Submonoid.powers (wcQmdlCX A' n π' c' l (some m)))
      (Localization.Away (wcQmdlCX A' n π' c' l (some m))) hx
    exact Submonoid.mem_comap.mp h
  have hnzd : ρ.hom (wcQmbtGen A' n π' c' (some l)) ∈
      nonZeroDivisors (Localization.Away (wcQmdlCX A' n π' c' l (some m))) := by
    show α (φ l (wcQmbtGen A' n π' c' (some l))) ∈ _
    rw [h1a]; exact hαx
  have hgen : Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
      Ideal.span {ρ.hom (wcQmbtGen A' n π' c' (some l))} := by
    show Ideal.map (α.comp (φ l)) _ = Ideal.span {α (φ l (wcQmbtGen A' n π' c' (some l)))}
    rw [← Ideal.map_map, hP4 l, Ideal.map_span, Set.image_singleton]
  have hInv : wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (wcQmbtGen A' n π' c' k)))) (Spec.map ρ) := by
    have e : (⊤ : (Spec (CommRingCat.of
        (Localization.Away (wcQmdlCX A' n π' c' l (some m))))).Opens) ≤ Spec.map ρ ⁻¹ᵁ ⊤ :=
      fun _ _ => trivial
    have hcompΓ : (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv ≫
        (Spec.map ρ).appLE ⊤ ⊤ e = ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of
          (Localization.Away (wcQmdlCX A' n π' c' l (some m))))).inv := by
      rw [Scheme.ΓSpecIso_inv_naturality]
      congr 1
    have hval : ∀ z, ((Spec.map ρ).appLE ⊤ ⊤ e).hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom z) =
        (Scheme.ΓSpecIso (CommRingCat.of
          (Localization.Away (wcQmdlCX A' n π' c' l (some m))))).inv.hom (ρ.hom z) := by
      intro z
      show ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv ≫
        (Spec.map ρ).appLE ⊤ ⊤ e).hom z = (ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of
          (Localization.Away (wcQmdlCX A' n π' c' l (some m))))).inv).hom z
      rw [hcompΓ]
    have hIU : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))).ideal ⟨⊤, isAffineOpen_top _⟩ =
        Ideal.span (Set.range fun k =>
          (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
            (wcQmbtGen A' n π' c' k)) := by
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]
      have key2 : ∀ (h : (⊤ : (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).Opens) ≤ ⊤)
          (J : Ideal Γ(Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c')), ⊤)),
          Ideal.map ((Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).presheaf.map
            (homOfLE h).op).hom J = J := by
        intro h J
        rw [show (homOfLE h).op = 𝟙 _ from rfl, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
          Ideal.map_id]
      exact key2 _ _
    have hmapb : Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span (Set.range fun k =>
          (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
            (wcQmbtGen A' n π' c' k)) := by
      rw [Ideal.map_span, ← Set.range_comp]
      try rfl
    have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
        ε.hom.hom y ∈ nonZeroDivisors C := by
      intro B C ε y hy
      rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
      exact ⟨y, hy, rfl⟩
    intro t
    refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, e,
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (wcQmbtGen A' n π' c' (some l)), trivial, ?_, ?_, ?_⟩
    · rw [hIU]
      exact Ideal.subset_span ⟨some l, rfl⟩
    · rw [hval]
      exact hisoNZD (Scheme.ΓSpecIso (CommRingCat.of
        (Localization.Away (wcQmdlCX A' n π' c' l (some m))))).symm _ hnzd
    · rw [hIU, hval, ← hmapb, Ideal.map_map, ← CommRingCat.hom_comp, hcompΓ, CommRingCat.hom_comp,
        ← Ideal.map_map, hgen, Ideal.map_span, Set.image_singleton]

  obtain ⟨-, hrU⟩ := hr
  have hL1 : (Spec.map (CommRingCat.ofHom α) ≫ e l) ≫ r₁ = Spec.map ρ := by
    rw [Category.assoc, hP9 l, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hL2 : (Spec.map (CommRingCat.ofHom τ) ≫ e m) ≫ r₁ = Spec.map ρ := by
    rw [Category.assoc, hP9 m, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
  exact (hrU _ (Spec.map ρ) hInv).unique hL1 hL2

theorem wc_qmdl_overlap_theta {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'} {n : ℕ}
    (hn : 4 ≤ n) (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Over (Spec (.of K)))
    (jE : E.left ⟶ wcProjK K (n - 2 + 1))
    (χ : ∀ j, wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j))
    (ψ : ∀ j, (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
