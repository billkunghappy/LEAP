    refine ⟨fun p => ⟨σ p, hψσ' p⟩, ?_⟩
    have hw : t u - MvPolynomial.eval₂ ι (fun b => t (s b)) (τ u) = t u - σ (τ u) := rfl
    rw [hw]
    have key : ∀ z : A, z - σ (ψ z) ∈ Ideal.span {t u - σ (τ u)} := by
      intro z
      obtain ⟨F, rfl⟩ := hgen z
      induction F using MvPolynomial.induction_on with
      | C a =>
        rw [MvPolynomial.eval₂_C, hψι, hσ, MvPolynomial.eval₂Hom_C, sub_self]
        exact zero_mem _
      | add p q hp hq =>
        rw [MvPolynomial.eval₂_add, map_add, map_add]
        have : MvPolynomial.eval₂ ι t p + MvPolynomial.eval₂ ι t q -
            (σ (ψ (MvPolynomial.eval₂ ι t p)) + σ (ψ (MvPolynomial.eval₂ ι t q))) =
            (MvPolynomial.eval₂ ι t p - σ (ψ (MvPolynomial.eval₂ ι t p))) +
            (MvPolynomial.eval₂ ι t q - σ (ψ (MvPolynomial.eval₂ ι t q))) := by ring
        rw [this]
        exact Ideal.add_mem _ hp hq
      | mul_X p j hp =>
        rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
        have hj : t j - σ (ψ (t j)) ∈ Ideal.span {t u - σ (τ u)} := by
          by_cases hjc : j = c
          · rw [hjc, htc, map_one, map_one, sub_self]
            exact zero_mem _
          by_cases hju : j = u
          · rw [hju, hψt]
            exact Ideal.subset_span rfl
          obtain ⟨b, rfl⟩ := hcov j hjc hju
          rw [hψt, hτs, hσ, MvPolynomial.eval₂Hom_X', sub_self]
          exact zero_mem _
        have : MvPolynomial.eval₂ ι t p * t j - σ (ψ (MvPolynomial.eval₂ ι t p * t j)) =
            (MvPolynomial.eval₂ ι t p - σ (ψ (MvPolynomial.eval₂ ι t p))) * t j +
            σ (ψ (MvPolynomial.eval₂ ι t p)) * (t j - σ (ψ (t j))) := by
          rw [map_mul, map_mul]; ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ hj)
    apply le_antisymm
    · intro z hz
      have := key z
      rwa [RingHom.mem_ker.mp hz, map_zero, sub_zero] at this
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        map_sub, hψσ', hψt, sub_self]

  have L2 : ∀ (K : Type u) [Field K] (N : ℕ) (c : Fin (N + 1)) (R : Type u) [CommRing R] [Algebra K R] (τ : Fin (N + 1) → R) (hτ : τ c = 1), letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)); ∃ ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c) →+* R, (∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K) (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)), ψ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) n F hF) = MvPolynomial.aeval τ F) ∧ ∀ a : K, ψ (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X c)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) a)) = algebraMap K R a := by
    intro K _ N c R _ _ τ hτ
    letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
    set ρt : MvPolynomial (Fin (N + 1)) K →+* R := (MvPolynomial.aeval τ).toRingHom with hρt
    have hρc : ρt (MvPolynomial.X c) = 1 := by
      rw [hρt, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X, hτ]
    have hu : IsUnit (ρt (MvPolynomial.X c)) := by rw [hρc]; exact isUnit_one
    refine ⟨(IsLocalization.Away.lift (MvPolynomial.X c) hu :
        Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K) →+* R).comp
