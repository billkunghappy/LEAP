    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      have e1 : (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' m)) (MvPolynomial.C a) =
          algebraMap A' (wcQmbtChart A' n π' c' m) a := rfl
      simp only [RingHom.comp_apply, e1]
      rw [← RingHom.comp_apply τ, hτA, RingHom.comp_apply, hΛα]
      exact hA a
    · intro i
      simp only [RingHom.comp_apply]
      rcases i with _ | p
      · show Λ₀ (τ (wcQmdlCX A' n π' c' m none)) = fm (wcQmdlCX A' n π' c' m none)
        rw [hτ1, map_mul, hΛα, ← hU3, mul_assoc, hw, mul_one]
      · by_cases hp : p = m
        · rw [hp]
          show Λ₀ (τ (wcQmdlCX A' n π' c' m (some m))) = fm (wcQmdlCX A' n π' c' m (some m))
          rw [hτ2, hΛα, map_mul]
          show rl (χ l (wcQmdlCX A' n π' c' l (some l))) *
              rl (χ l (wcQmdlCX A' n π' c' l (some m))) =
            rm (χ m (wcQmdlCX A' n π' c' m (some m)))
          rw [hXl2, hXm2]
          simp only [map_zero, zero_mul]
        · show Λ₀ (τ (wcQmdlCX A' n π' c' m (some p))) = fm (wcQmdlCX A' n π' c' m (some p))
          rw [hτ3 p hp, map_mul, hΛα, ← hU2 p hp, mul_assoc, hw, mul_one]

  have factor : ∀ (U V : E.Opens) (e : U ≤ V) {B : Type u} [CommRing B] (χ' : B →+* Γ(E, V))
      (ψ' : V.toScheme ⟶ Spec (.of B))
      (hψ' : ∀ f : B, ψ'.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom f) =
        V.topIso.inv.hom (χ' f))
      (β : B →+* Localization.Away (wcQmdlCX A' n π' c' l (some m)))
      (φ : CommRingCat.of (Localization.Away (wcQmdlCX A' n π' c' l (some m))) ⟶
        Γ(U.toScheme, ⊤))
      (hφ : ∀ b, φ.hom (β b) = U.topIso.inv.hom ((E.presheaf.map (homOfLE e).op).hom (χ' b))),
      (U.toScheme.toSpecΓ ≫ Spec.map φ) ≫ Spec.map (CommRingCat.ofHom β) =
        E.homOfLE e ≫ ψ' := by
    intro U V e B _ χ' ψ' hψ' β φ hφ
    apply ext_of_isAffine
    rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of B)).inv]
    simp only [Scheme.Hom.comp_appTop, Category.assoc]
    rw [← reassoc_of% (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom β)),
      ← reassoc_of% (Scheme.ΓSpecIso_inv_naturality φ), Scheme.toSpecΓ_appTop, Iso.inv_hom_id,
      Category.comp_id]
    refine CommRingCat.hom_ext (RingHom.ext fun b => ?_)
    change φ.hom (β b) = ((E.homOfLE e).appTop).hom
      (ψ'.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom b))
    rw [hφ b, hψ' b, Scheme.homOfLE_appTop, Scheme.Opens.topIso_inv, Scheme.Opens.topIso_inv]
    exact resres2 _ _ _ _ _ _ _ _ _

  let φ : CommRingCat.of (Localization.Away (wcQmdlCX A' n π' c' l (some m))) ⟶
      Γ((wcQxeV K jE l ⊓ wcQxeV K jE m).toScheme, ⊤) :=
    CommRingCat.ofHom ((wcQxeV K jE l ⊓ wcQxeV K jE m).topIso.inv.hom.comp Λ₀)
  refine ⟨(wcQxeV K jE l ⊓ wcQxeV K jE m).toScheme.toSpecΓ ≫ Spec.map φ, ?_, ?_⟩
  · refine factor _ _ inf_le_left (χ l) (ψ l) (hχ l).2.2.2.2 _ φ (fun b => ?_)
    show (wcQxeV K jE l ⊓ wcQxeV K jE m).topIso.inv.hom (Λ₀ (algebraMap _ _ b)) = _
    rw [hΛα]
    rfl
  · refine factor _ _ inf_le_right (χ m) (ψ m) (hχ m).2.2.2.2 τ φ (fun b => ?_)
    show (wcQxeV K jE l ⊓ wcQxeV K jE m).topIso.inv.hom (Λ₀ (τ b)) = _
    rw [← RingHom.comp_apply Λ₀ τ, hτfm]
    rfl

theorem wc_qxe_glue_map {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A']
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁)
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0)
    (K : Type u) [Field K] (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Scheme.{u})
    (jE : E ⟶ wcProjK K n)
    (hjE : Set.range jE ⊆ wcXspVplus K n
      (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))))
    (χ : ∀ j, wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j))
    (ψ : ∀ j, (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : ∀ j, wcQxeChiPkg π' c' σ jE j (χ j) (ψ j))
    (ρ : wcQuadModelRing A' n (π' ^ 2) c' →+* K)
    (hρX : ∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0)
    (hρA : ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      σ.toRingHom.comp (IsLocalRing.residue A')) :
    ∃ g : E ⟶ X₁, (∀ z : E, ∃ j, z ∈ wcQxeV K jE j) ∧
      (∀ j, (wcQxeV K jE j).ι ≫ g = ψ j ≫ e j) ∧
      (∀ j (z : E) (hz : z ∈ wcQxeV K jE j),
        g z = e j (ψ j (⟨z, hz⟩ : wcQxeV K jE j))) ∧
      g ≫ r₁ = (jE ≫ wcProjKStr K n) ≫ Spec.map (CommRingCat.ofHom ρ) :=
by
  classical
  have hφX := hpkg.1
  have hφA := hpkg.2.1
  have hφe := hpkg.2.2.2.2.2.2.2.2.1

  have hcov : ∀ z : E, ∃ j, z ∈ wcQxeV K jE j := by
    intro z
    by_contra hcon
    push_neg at hcon
    set a := wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q))) with ha_def
    have hv : jE z ∈ wcXspVplus K n a := hjE ⟨z, rfl⟩
    set P : Ideal (MvPolynomial (Fin (n + 1)) K) := (jE z).asHomogeneousIdeal.toIdeal with hP
    have hPprime : P.IsPrime := ProjectiveSpectrum.isPrime _
    have hX : ∀ j : Fin n, (MvPolynomial.X j.castSucc : MvPolynomial (Fin (n + 1)) K) ∈ P := by
      intro j
      have h1 : ¬ (jE z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (MvPolynomial.X j.castSucc)) := hcon j
      rw [Proj.mem_basicOpen, not_not] at h1
      exact h1
    have hF : (∑ p : Fin (n + 1), ∑ q : Fin (n + 1), MvPolynomial.C (a p q) *
        (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (n + 1)) K) ∈ P := by
      have h1 : ¬ (jE z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          ((wcLdpQuad K n a : MvPolynomial (Fin (n + 1)) K))) := hv
      rw [Proj.mem_basicOpen, not_not] at h1
      exact h1
    have hA : (∑ i : Fin n, ∑ q : Fin (n + 1), MvPolynomial.C (a i.castSucc q) *
        (MvPolynomial.X i.castSucc * MvPolynomial.X q) : MvPolynomial (Fin (n + 1)) K) ∈ P :=
      Ideal.sum_mem _ fun i _ => Ideal.sum_mem _ fun q _ =>
        Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ (hX i))
    have hB : (∑ i : Fin n, MvPolynomial.C (a (Fin.last n) i.castSucc) *
        (MvPolynomial.X (Fin.last n) * MvPolynomial.X i.castSucc) :
          MvPolynomial (Fin (n + 1)) K) ∈ P :=
      Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hX i))
    have hsplit : (∑ p : Fin (n + 1), ∑ q : Fin (n + 1), MvPolynomial.C (a p q) *
        (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin (n + 1)) K) =
        (∑ i : Fin n, ∑ q : Fin (n + 1), MvPolynomial.C (a i.castSucc q) *
          (MvPolynomial.X i.castSucc * MvPolynomial.X q)) +
        ((∑ i : Fin n, MvPolynomial.C (a (Fin.last n) i.castSucc) *
          (MvPolynomial.X (Fin.last n) * MvPolynomial.X i.castSucc)) +
          MvPolynomial.C (a (Fin.last n) (Fin.last n)) *
            (MvPolynomial.X (Fin.last n) * MvPolynomial.X (Fin.last n))) := by
      rw [Fin.sum_univ_castSucc, Fin.sum_univ_castSucc (fun q => MvPolynomial.C (a (Fin.last n) q) *
        (MvPolynomial.X (Fin.last n) * MvPolynomial.X q))]
    have haSS : a (Fin.last n) (Fin.last n) = -1 := by
      simp [ha_def, wcXspExtCoeff]
    have hSS : (MvPolynomial.C (a (Fin.last n) (Fin.last n)) *
        (MvPolynomial.X (Fin.last n) * MvPolynomial.X (Fin.last n)) :
          MvPolynomial (Fin (n + 1)) K) ∈ P := by
      have h1 := P.sub_mem (P.sub_mem hF hA) hB
      rw [hsplit] at h1
      have h2 : (∑ i : Fin n, ∑ q : Fin (n + 1), MvPolynomial.C (a i.castSucc q) *
          (MvPolynomial.X i.castSucc * MvPolynomial.X q)) +
          ((∑ i : Fin n, MvPolynomial.C (a (Fin.last n) i.castSucc) *
            (MvPolynomial.X (Fin.last n) * MvPolynomial.X i.castSucc)) +
            MvPolynomial.C (a (Fin.last n) (Fin.last n)) *
              (MvPolynomial.X (Fin.last n) * MvPolynomial.X (Fin.last n))) -
          (∑ i : Fin n, ∑ q : Fin (n + 1), MvPolynomial.C (a i.castSucc q) *
            (MvPolynomial.X i.castSucc * MvPolynomial.X q)) -
          (∑ i : Fin n, MvPolynomial.C (a (Fin.last n) i.castSucc) *
            (MvPolynomial.X (Fin.last n) * MvPolynomial.X i.castSucc)) =
          (MvPolynomial.C (a (Fin.last n) (Fin.last n)) *
            (MvPolynomial.X (Fin.last n) * MvPolynomial.X (Fin.last n)) :
              MvPolynomial (Fin (n + 1)) K) := by ring
      rw [h2] at h1
      exact h1
    rw [haSS, map_neg, map_one, neg_one_mul, neg_mem_iff] at hSS
    have hS : (MvPolynomial.X (Fin.last n) : MvPolynomial (Fin (n + 1)) K) ∈ P :=
      (hPprime.mem_or_mem hSS).elim id id
    have hall : ∀ J : Fin (n + 1), (MvPolynomial.X J : MvPolynomial (Fin (n + 1)) K) ∈ P := by
      intro J
      refine Fin.lastCases ?_ (fun i => ?_) J
      · exact hS
      · exact hX i
    have h0 := wc_pp_basicOpen_cover K n
    have h1 : jE z ∈ (⊤ : (wcProjK K n).Opens) := trivial
    rw [← h0] at h1
    obtain ⟨J, hJ⟩ := TopologicalSpace.Opens.mem_iSup.mp h1
    rw [Proj.mem_basicOpen] at hJ
    exact hJ (hall J)
  have hsuple : (⊤ : E.Opens) ≤ ⨆ j, wcQxeV K jE j := by
    intro z _
    obtain ⟨j, hj⟩ := hcov z
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨j, hj⟩
  have hsup : (⨆ j, wcQxeV K jE j) = ⊤ := top_le_iff.mp hsuple

  have hover : ∀ l m, E.homOfLE (inf_le_left : wcQxeV K jE l ⊓ wcQxeV K jE m ≤
        wcQxeV K jE l) ≫ (ψ l ≫ e l) =
      E.homOfLE (inf_le_right : wcQxeV K jE l ⊓ wcQxeV K jE m ≤
        wcQxeV K jE m) ≫ (ψ m ≫ e m) := by
    intro l m
    by_cases hlm : l = m
    · subst hlm; rfl
    · obtain ⟨τ, hτ1, hτ2, hτ3, hτA, hτS⟩ := wc_qmdl_chart_transition hr hpkg l m hlm
      obtain ⟨θ, hθ1, hθ2⟩ :=
        wc_qxe_overlap_theta c' K σ E jE χ ψ hχ l m hlm τ hτ1 hτ2 hτ3 hτA
      rw [← Category.assoc, ← hθ1, Category.assoc, hτS, ← Category.assoc, hθ2, Category.assoc]

  obtain ⟨_, hglue⟩ := wc_csd_glue_opens E X₁ n (fun j => wcQxeV K jE j)
  obtain ⟨Φ, hΦ⟩ := hglue (fun j => ψ j ≫ e j) hover
  obtain ⟨g, hg⟩ : ∃ g : E ⟶ X₁, g = E.topIso.inv ≫ (E.isoOfEq hsup).inv ≫ Φ :=
    ⟨_, rfl⟩
  have hι : ∀ j, (wcQxeV K jE j).ι ≫ E.topIso.inv ≫ (E.isoOfEq hsup).inv =
      E.homOfLE (le_iSup (fun j => wcQxeV K jE j) j) := by
    intro j
    rw [← cancel_mono (⨆ j, wcQxeV K jE j).ι]
    simp only [Category.assoc, Scheme.isoOfEq_inv_ι, Scheme.homOfLE_ι]
    rw [← Scheme.topIso_hom E, Iso.inv_hom_id, Category.comp_id]
  have h2 : ∀ j, (wcQxeV K jE j).ι ≫ g = ψ j ≫ e j := by
    intro j
    rw [hg]
    calc (wcQxeV K jE j).ι ≫ E.topIso.inv ≫ (E.isoOfEq hsup).inv ≫ Φ
        = ((wcQxeV K jE j).ι ≫ E.topIso.inv ≫ (E.isoOfEq hsup).inv) ≫ Φ := by
          simp only [Category.assoc]
      _ = ψ j ≫ e j := by rw [hι j]; exact hΦ j
  have h3 : ∀ j (z : E) (hz : z ∈ wcQxeV K jE j),
      g z = e j (ψ j (⟨z, hz⟩ : wcQxeV K jE j)) := by
    intro j z hz
    have hc := congrArg (fun f => f (⟨z, hz⟩ : wcQxeV K jE j)) (h2 j)
    simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at hc
    exact hc

  have hsqc : ∀ j, ψ j ≫ Spec.map (CommRingCat.ofHom (φ j)) =
      (wcQxeV K jE j).ι ≫ (jE ≫ wcProjKStr K n) ≫ Spec.map (CommRingCat.ofHom ρ) := by
    intro j
    obtain ⟨_, hX2, _, hX4, hX5⟩ := hχ j
    have hψC : (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv ≫ (ψ j).appTop =
        CommRingCat.ofHom (χ j) ≫ (wcQxeV K jE j).topIso.inv := by
      refine CommRingCat.hom_ext (RingHom.ext fun f => ?_)
      exact hX5 f
    have hιtop : (wcQxeV K jE j).ι.appTop =
        E.presheaf.map (homOfLE (le_top : wcQxeV K jE j ≤ ⊤)).op ≫
          (wcQxeV K jE j).topIso.inv := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      first
        | (refine Eq.trans ?_ (E.presheaf.map_comp _ _); rfl)
        | exact E.presheaf.map_comp _ _
        | (erw [← Functor.map_comp]; rfl)
    have hring : (χ j).comp (φ j) =
        (wcCnSigma (jE ≫ wcProjKStr K n) (wcQxeV K jE j)).comp ρ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        have e1 : (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c')) (MvPolynomial.C a) =
            algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a := rfl
        simp only [RingHom.comp_apply, e1]
        rw [← RingHom.comp_apply (φ j), hφA j, hX4 a, ← RingHom.comp_apply ρ, hρA]
        rfl
      · intro p
        have hX2' : χ j (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (MvPolynomial.X (some j))) = 0 := hX2
        simp only [RingHom.comp_apply]
        rw [hφX j p, hρX p, map_zero, map_mul, map_mul, hX2', zero_mul]
    generalize (jE ≫ wcProjKStr K n) = str at hring ⊢
    apply ext_of_isAffine
    rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv]
    simp only [Scheme.Hom.comp_appTop, Category.assoc]
    rw [← reassoc_of% (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (φ j))),
      ← reassoc_of% (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ρ)), hψC, hιtop]
    refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
    have hx := RingHom.congr_fun hring x
    simp only [RingHom.comp_apply] at hx
    show ((wcQxeV K jE j).topIso.inv).hom (χ j (φ j x)) =
      ((wcQxeV K jE j).topIso.inv).hom (wcCnSigma str (wcQxeV K jE j) (ρ x))
    rw [hx]

  have hsq : g ≫ r₁ = (jE ≫ wcProjKStr K n) ≫ Spec.map (CommRingCat.ofHom ρ) := by
    have huniq' := (wc_csd_glue_opens E
      (Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))) n (fun j => wcQxeV K jE j)).1
    have key := huniq' ⊤ (fun _ => le_top) hsuple (E.topIso.hom ≫ g ≫ r₁)
      (E.topIso.hom ≫ (jE ≫ wcProjKStr K n) ≫ Spec.map (CommRingCat.ofHom ρ)) (by
        intro l
        have hl : E.homOfLE (le_top : wcQxeV K jE l ≤ ⊤) ≫ E.topIso.hom =
            (wcQxeV K jE l).ι := by
          rw [Scheme.topIso_hom, Scheme.homOfLE_ι]
        have hL : E.homOfLE (le_top : wcQxeV K jE l ≤ ⊤) ≫ E.topIso.hom ≫ g ≫ r₁ =
            ψ l ≫ Spec.map (CommRingCat.ofHom (φ l)) := by
          rw [← Category.assoc, hl, ← Category.assoc, h2 l, Category.assoc, hφe l]
        have hR : E.homOfLE (le_top : wcQxeV K jE l ≤ ⊤) ≫ E.topIso.hom ≫
            (jE ≫ wcProjKStr K n) ≫ Spec.map (CommRingCat.ofHom ρ) =
            (wcQxeV K jE l).ι ≫ (jE ≫ wcProjKStr K n) ≫ Spec.map (CommRingCat.ofHom ρ) := by
          rw [← Category.assoc, hl]
        exact hL.trans ((hsqc l).trans hR.symm))
    exact (cancel_epi E.topIso.hom).mp key
  exact ⟨g, hcov, h2, h3, hsq⟩

theorem wc_qxe_fibre_in_charts {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁)
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0)
    {o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hoeq : o.asIdeal = Ideal.span (Set.range (wcQmbtGen A' n π' c'))) :
    ∀ x : X₁, r₁ x = o → ∃ (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' c' j))),
      e j y = x ∧ wcQmdlCX A' n π' c' j (some j) ∈ y.asIdeal ∧
      algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y.asIdeal :=
by
  classical
  obtain ⟨hX, hA, -, -, h0X, h0A, -, -, he, he0, hcov⟩ := hpkg

  have hext : ∀ {S : Type u} [CommRing S] (f g : wcQuadModelRing A' n (π' ^ 2) c' →+* S),
      (∀ p, f (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
        g (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p))) →
      f.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        g.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) → f = g := by
    intro S _ f g h1 h2
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      exact congrArg (fun k => k r) h2
    · intro p
      exact h1 p

  have hup : ∀ j : Fin n, ∀ (B : CommRingCat.{u})
      (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ B),
      ρ.hom (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors B →
      Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span {ρ.hom (wcQmbtGen A' n π' c' (some j))} →
      ∃! ψ : CommRingCat.of (wcQmbtChart A' n π' c' j) ⟶ B, CommRingCat.ofHom (φ j) ≫ ψ = ρ := by
    intro j
    obtain ⟨φ', hφ'X, hφ'A, -, -, hφ'up⟩ := wc_qmbt_bm_chart_algebra hπ' c' j
    have heq : φ' = φ j := hext _ _ (fun p => by rw [hφ'X p, hX j p]) (by rw [hφ'A, hA j])
    rw [← heq]
    exact hφ'up
  obtain ⟨φ0', h0'X, h0'A, h0'nzd, h0'gen, -⟩ := wc_qmbt_bm_chart_algebra_none hπ' c'
  have heq0 : φ0' = φ0 := hext _ _ (fun p => by rw [h0'X p, h0X p]) (by rw [h0'A, h0A])
  rw [heq0] at h0'nzd h0'gen

  have s4 : ∀ (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' c' j))), r₁ (e j y) = o →
      wcQmdlCX A' n π' c' j (some j) ∈ y.asIdeal ∧
      algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y.asIdeal := by
    intro j y hy
    have h1 : r₁ (e j y) = Spec.map (CommRingCat.ofHom (φ j)) y := by
      rw [← Scheme.Hom.comp_apply, he j]
    have h2 : Ideal.comap (φ j) y.asIdeal = Ideal.span (Set.range (wcQmbtGen A' n π' c')) := by
      rw [← hoeq, ← hy, h1]
      rfl
    constructor
    · have hm : wcQmbtGen A' n π' c' (some j) ∈ Ideal.comap (φ j) y.asIdeal := by
        rw [h2]; exact Ideal.subset_span ⟨some j, rfl⟩
      rw [Ideal.mem_comap] at hm
      have hv : φ j (wcQmbtGen A' n π' c' (some j)) = wcQmdlCX A' n π' c' j (some j) := by
        show φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j)) = _
        rw [hX j j]
        simp [wcQmbtChartHat, wcQmdlCX]
      rwa [hv] at hm
    · have hm : wcQmbtGen A' n π' c' none ∈ Ideal.comap (φ j) y.asIdeal := by
        rw [h2]; exact Ideal.subset_span ⟨none, rfl⟩
      rw [Ideal.mem_comap] at hm
      have hv : φ j (wcQmbtGen A' n π' c' none) = algebraMap A' (wcQmbtChart A' n π' c' j) π' := by
        show φ j (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') = _
        rw [← RingHom.comp_apply, hA j]
      rwa [hv] at hm

  have s2 : ∀ y0 : Spec (.of (wcQmbtChartNone A' n c')), ∃ j : Fin n,
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X j) ∉ y0.asIdeal := by
    intro y0
    by_contra hcon
    push_neg at hcon
    have hQ : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q) ∈
          y0.asIdeal := by
      rw [map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hcon q)
    have h1 : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q) = 1 := by
      have h0 : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
          (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      rwa [map_sub, map_one, sub_eq_zero] at h0
    rw [h1] at hQ
    exact y0.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hQ)

  intro x hx
  rcases hcov x with ⟨y0, rfl⟩ | ⟨j, y, rfl⟩
  · obtain ⟨j, hy0⟩ := s2 y0

    let t : wcQmbtChartNone A' n c' :=
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X j)
    let P : wcQmbtChartNone A' n c' := algebraMap A' (wcQmbtChartNone A' n c') π'
    have h1a : φ0 (wcQmbtGen A' n π' c' none) = P := by
      show φ0 (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') = _
      rw [← RingHom.comp_apply, h0A]
    have h1b : φ0 (wcQmbtGen A' n π' c' (some j)) = P * t := by
      show φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j)) = _
      rw [h0X j, map_mul]
      rfl
    let D := Localization.Away t
    let α : wcQmbtChartNone A' n c' →+* D := algebraMap _ D
    let ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ CommRingCat.of D :=
      CommRingCat.ofHom (α.comp φ0)
    have hαt : IsUnit (α t) := IsLocalization.Away.algebraMap_isUnit t
    have hP : P ∈ nonZeroDivisors (wcQmbtChartNone A' n c') := by
      rw [← h1a]; exact h0'nzd
    have hαP : α P ∈ nonZeroDivisors D :=
      IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers t) D hP
    have hρb : ρ.hom (wcQmbtGen A' n π' c' (some j)) = α P * α t := by
      show α (φ0 (wcQmbtGen A' n π' c' (some j))) = _
      rw [h1b, map_mul]
    have hnzd : ρ.hom (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors D := by
      rw [hρb]
      exact mul_mem_nonZeroDivisors.mpr ⟨hαP, hαt.mem_nonZeroDivisors⟩
    have hgen : Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span {ρ.hom (wcQmbtGen A' n π' c' (some j))} := by
      rw [hρb, Ideal.span_singleton_mul_right_unit hαt]
      show Ideal.map (α.comp φ0) _ = _
      rw [← Ideal.map_map, h0'gen, Ideal.map_span, Set.image_singleton, h1a]
    obtain ⟨ψ, hψ, -⟩ := hup j (CommRingCat.of D) ρ hnzd hgen
    have hInv : wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) (Spec.map ρ) := by
      have e' : (⊤ : (Spec (CommRingCat.of D)).Opens) ≤ Spec.map ρ ⁻¹ᵁ ⊤ := fun _ _ => trivial
      have hcomp : (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv ≫
          (Spec.map ρ).appLE ⊤ ⊤ e' = ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of D)).inv := by
        rw [Scheme.ΓSpecIso_inv_naturality]
        congr 1
      have hval : ∀ z, ((Spec.map ρ).appLE ⊤ ⊤ e').hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom z) =
          (Scheme.ΓSpecIso (CommRingCat.of D)).inv.hom (ρ.hom z) := by
        intro z
        show ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv ≫
          (Spec.map ρ).appLE ⊤ ⊤ e').hom z = (ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of D)).inv).hom z
        rw [hcomp]
      have hIU : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
          (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
            (wcQmbtGen A' n π' c' k)))).ideal ⟨⊤, isAffineOpen_top _⟩ =
          Ideal.span (Set.range fun k =>
            (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
              (wcQmbtGen A' n π' c' k)) := by
        rw [Scheme.IdealSheafData.ofIdealTop_ideal]
        have key : ∀ (h : (⊤ : (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).Opens) ≤ ⊤)
            (J : Ideal Γ(Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c')), ⊤)),
            Ideal.map ((Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).presheaf.map
              (homOfLE h).op).hom J = J := by
          intro h J
          rw [show (homOfLE h).op = 𝟙 _ from rfl, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
            Ideal.map_id]
        exact key _ _
      have hmapb : Ideal.map
          (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
          Ideal.span (Set.range fun k =>
            (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
              (wcQmbtGen A' n π' c' k)) := by
        rw [Ideal.map_span, ← Set.range_comp]
        try rfl
      have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
          ε.hom.hom y ∈ nonZeroDivisors C := by
        intro B C ε y hy
        rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
        exact ⟨y, hy, rfl⟩
      intro t'
      refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, e',
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' (some j)), trivial, ?_, ?_, ?_⟩
      · rw [hIU]
        exact Ideal.subset_span ⟨some j, rfl⟩
      · rw [hval]
        exact hisoNZD (Scheme.ΓSpecIso (CommRingCat.of D)).symm _ hnzd
      · rw [hIU, hval, ← hmapb, Ideal.map_map, ← CommRingCat.hom_comp, hcomp, CommRingCat.hom_comp,
          ← Ideal.map_map, hgen, Ideal.map_span, Set.image_singleton]
    obtain ⟨-, hrU⟩ := hr
    have hL1 : (Spec.map (CommRingCat.ofHom α) ≫ e0) ≫ r₁ = Spec.map ρ := by
      rw [Category.assoc, he0, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hL2 : (Spec.map ψ ≫ e j) ≫ r₁ = Spec.map ρ := by
      rw [Category.assoc, he j, ← Spec.map_comp, hψ]
    have hEq : Spec.map (CommRingCat.ofHom α) ≫ e0 = Spec.map ψ ≫ e j :=
      (hrU _ (Spec.map ρ) hInv).unique hL1 hL2
    have hmem : (show PrimeSpectrum (wcQmbtChartNone A' n c') from y0) ∈
        PrimeSpectrum.basicOpen t := (PrimeSpectrum.mem_basicOpen _ _).mpr hy0
    rw [← SetLike.mem_coe, ← PrimeSpectrum.localization_away_comap_range D t] at hmem
    obtain ⟨q, hq⟩ := hmem
    have hℓq : Spec.map (CommRingCat.ofHom α) q = y0 := hq
    have hc := congrArg (fun f : Spec (CommRingCat.of D) ⟶ X₁ => f q) hEq
    simp only [Scheme.Hom.comp_apply] at hc
    have hy : e j (Spec.map ψ q) = e0 y0 := by
      rw [← hℓq]
      exact hc.symm
    exact ⟨j, Spec.map ψ q, hy, s4 j _ (by rw [hy]; exact hx)⟩
  · exact ⟨j, y, rfl, s4 j y hx⟩

theorem wc_qxe_glue_closed_imm {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁)
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0)
    (K : Type u) [Field K] (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Scheme.{u})
    (jE : E ⟶ wcProjK K n) (hjEci : IsClosedImmersion jE)
    (hjE : Set.range jE ⊆ wcXspVplus K n
      (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))))
    (χ : ∀ j, wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j))
    (ψ : ∀ j, (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : ∀ j, wcQxeChiPkg π' c' σ jE j (χ j) (ψ j))
    (g : E ⟶ X₁) (hcov : ∀ z : E, ∃ j, z ∈ wcQxeV K jE j)
    (hg : ∀ j, (wcQxeV K jE j).ι ≫ g = ψ j ≫ e j)
    (ρ : wcQuadModelRing A' n (π' ^ 2) c' →+* K)
    (hρX : ∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0)
    (hρA : ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      σ.toRingHom.comp (IsLocalRing.residue A'))
    (hgsq : g ≫ r₁ = (jE ≫ wcProjKStr K n) ≫ Spec.map (CommRingCat.ofHom ρ))
    {o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hoeq : o.asIdeal = Ideal.span (Set.range (wcQmbtGen A' n π' c')))
    (hmax : (Ideal.span (Set.range (wcQmbtGen A' n π' c'))).IsMaximal) :
    IsClosedImmersion g ∧ Set.range g ⊆ r₁ ⁻¹' {o} :=
by
  classical
  have FIC := wc_qxe_fibre_in_charts hπ' hr hpkg hoeq
  unfold wcQmdlChartPkg at hpkg
  unfold wcQxeChiPkg at hχ
  obtain ⟨P1, P2, P3, -, -, -, P7, -, P9, -, -⟩ := hpkg
  haveI : IsClosedImmersion jE := hjEci
  haveI : ∀ j, IsOpenImmersion (e j) := P7

  have hker : RingHom.ker ρ = Ideal.span (Set.range (wcQmbtGen A' n π' c')) := by
    have hle : Ideal.span (Set.range (wcQmbtGen A' n π' c')) ≤ RingHom.ker ρ := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      cases k with
      | none =>
        show ρ (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') = 0
        rw [← RingHom.comp_apply, hρA]
        have hm : π' ∈ IsLocalRing.maximalIdeal A' := by
          rw [hπ']; exact Ideal.mem_span_singleton_self π'
        have h0 : IsLocalRing.residue A' π' = 0 := (IsLocalRing.residue_eq_zero_iff π').mpr hm
        show σ (IsLocalRing.residue A' π') = 0
        rw [h0, map_zero]
      | some p => exact hρX p
    exact (hmax.eq_of_le (RingHom.ker_ne_top ρ) hle).symm
  have hsub : Set.range g ⊆ r₁ ⁻¹' {o} := by
    rintro _ ⟨z, rfl⟩
    show r₁ (g z) = o
    have h1 : r₁ (g z) = Spec.map (CommRingCat.ofHom ρ) ((jE ≫ wcProjKStr K n) z) := by
      rw [← Scheme.Hom.comp_apply, hgsq, Scheme.Hom.comp_apply]
    rw [h1]
    apply PrimeSpectrum.ext
    show Ideal.comap ρ ((jE ≫ wcProjKStr K n) z).asIdeal = o.asIdeal
    have hb : ((jE ≫ wcProjKStr K n) z).asIdeal = ⊥ :=
      @Ideal.eq_bot_of_prime K _ _ ((jE ≫ wcProjKStr K n) z).isPrime
    rw [hb, ← RingHom.ker_eq_comap_bot, hker, hoeq]
  refine ⟨?_, hsub⟩

  have S1 : ∀ {X : Scheme.{u}} (V : X.Opens) (C : CommRingCat.{u})
      (χ : C →+* Γ(X, V)) (ψ : V.toScheme ⟶ Spec C)
      (hψ : ∀ f : C, ψ.appTop.hom ((Scheme.ΓSpecIso C).inv.hom f) = V.topIso.inv.hom (χ f))
      (z : V) (f : C),
      f ∈ (ψ z).asIdeal ↔
        (X.presheaf.germ V z.1 z.2).hom (χ f) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z.1) := by
    intro X V C χ ψ hψ z f
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, ← Scheme.mem_basicOpen X (χ f) z.1 z.2]
    have h1 : f ∉ (ψ z).asIdeal ↔ ψ z ∈ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv f) := by
      rw [basicOpen_eq_of_affine]; rfl
    rw [h1]
    have h2 : ψ z ∈ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv f) ↔
        (z : V.toScheme) ∈ ψ ⁻¹ᵁ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv f) := Iff.rfl
    rw [h2, Scheme.preimage_basicOpen]
    change (z : V.toScheme) ∈ V.toScheme.basicOpen (ψ.appTop.hom ((Scheme.ΓSpecIso C).inv.hom f)) ↔ _
    rw [hψ]
    have key := Scheme.Hom.preimage_image_eq V.ι (V.toScheme.basicOpen (V.topIso.inv.hom (χ f)))
    rw [Scheme.Opens.ι_image_basicOpen_topIso_inv] at key
    rw [← key]
    exact Iff.rfl

  have S2 : ∀ {R C C' : Type u} [CommRing R] [CommRing C] [CommRing C']
      (r : X₁ ⟶ Spec (.of R)) (ε1 : Spec (.of C) ⟶ X₁) (ε2 : Spec (.of C') ⟶ X₁)
      [IsOpenImmersion ε2]
      (θ1 : R →+* C) (θ2 : R →+* C') (he : ε1 ≫ r = Spec.map (CommRingCat.ofHom θ1))
      (he' : ε2 ≫ r = Spec.map (CommRingCat.ofHom θ2))
      (b b' : R) (v : C) (v' : C') (hv : θ1 b' = θ1 b * v) (hv' : θ2 b = θ2 b' * v')
      (hnzd : θ1 b ∈ nonZeroDivisors C) (y : Spec (.of C)) (y' : Spec (.of C'))
      (hyy : ε1 y = ε2 y'), v ∉ y.asIdeal := by
    intro R C C' _ _ _ r ε1 ε2 _ θ1 θ2 he he' b b' v v' hv hv' hnzd y y' hyy
    have T : ∀ {D : Type u} [CommRing D] (ε : Spec (.of D) ⟶ X₁) (θ : R →+* D)
        (hε : ε ≫ r = Spec.map (CommRingCat.ofHom θ)) (w : Spec (.of D)) (t : R),
        (ε.stalkMap w).hom ((X₁.presheaf.germ ⊤ (ε w) (show ε w ∈ (⊤ : X₁.Opens) from trivial)).hom
          (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t))) =
        ((Spec (.of D)).presheaf.germ ⊤ w (show w ∈ (⊤ : (Spec (.of D)).Opens) from trivial)).hom
          ((Scheme.ΓSpecIso (.of D)).inv.hom (θ t)) := by
      intro D _ ε θ hε w t
      have hA : ε.appTop.hom (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t)) =
          (Scheme.ΓSpecIso (.of D)).inv.hom (θ t) := by
        have h1 : ε.appTop.hom (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t)) =
            (ε ≫ r).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t) := by
          rw [Scheme.Hom.comp_appTop]; rfl
        rw [h1, hε]
        have h2 := congrArg (fun F => F.hom t)
          (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
        exact h2.symm
      rw [Scheme.Hom.germ_stalkMap_apply]
      exact congrArg (fun s => ((Spec (.of D)).presheaf.germ ⊤ w trivial).hom s) hA
    have Q : ∃ w' : X₁.presheaf.stalk (ε2 y'),
        (X₁.presheaf.germ ⊤ (ε2 y') trivial).hom (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom b)) =
        (X₁.presheaf.germ ⊤ (ε2 y') trivial).hom
          (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom b')) * w' := by
      obtain ⟨w', hw'⟩ := (ConcreteCategory.bijective_of_isIso (ε2.stalkMap y')).2
        (((Spec (.of C')).presheaf.germ ⊤ y' trivial).hom ((Scheme.ΓSpecIso (.of C')).inv.hom v'))
      refine ⟨w', ?_⟩
      apply (ConcreteCategory.bijective_of_isIso (ε2.stalkMap y')).1
      change (ε2.stalkMap y').hom _ = (ε2.stalkMap y').hom _
      rw [map_mul, T ε2 θ2 he' y' b, T ε2 θ2 he' y' b']
      erw [hw']
      rw [← map_mul, ← map_mul, hv']
    rw [← hyy] at Q
    obtain ⟨w', hw'⟩ := Q
    have hw2 := congrArg (ε1.stalkMap y).hom hw'
    rw [map_mul, T ε1 θ1 he y b, T ε1 θ1 he y b', hv, map_mul, map_mul] at hw2
    set γ := ((Spec (.of C)).presheaf.germ ⊤ y trivial).hom
      ((Scheme.ΓSpecIso (.of C)).inv.hom (θ1 b))
    set ν := ((Spec (.of C)).presheaf.germ ⊤ y trivial).hom ((Scheme.ΓSpecIso (.of C)).inv.hom v)
    have hnz : γ ∈ nonZeroDivisors ((Spec (.of C)).presheaf.stalk y) := by
      have hU : IsAffineOpen (⊤ : (Spec (.of C)).Opens) := isAffineOpen_top _
      have hnz0 : (Scheme.ΓSpecIso (.of C)).inv.hom (θ1 b) ∈
          nonZeroDivisors Γ(Spec (.of C), ⊤) := by
        rw [mem_nonZeroDivisors_iff]
        have hinj : Function.Injective (Scheme.ΓSpecIso (.of C)).hom.hom :=
          (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of C)).hom).1
        have hhi : ∀ s, (Scheme.ΓSpecIso (.of C)).hom.hom
            ((Scheme.ΓSpecIso (.of C)).inv.hom s) = s :=
          fun s => Iso.inv_hom_id_apply (Scheme.ΓSpecIso (.of C)) s
        have hb := mem_nonZeroDivisors_iff.mp hnzd
        refine ⟨fun x hx => ?_, fun x hx => ?_⟩
        · apply hinj
          have := congrArg (Scheme.ΓSpecIso (.of C)).hom.hom hx
          rw [map_mul, hhi, map_zero] at this
          rw [map_zero]; exact hb.1 _ this
        · apply hinj
          have := congrArg (Scheme.ΓSpecIso (.of C)).hom.hom hx
          rw [map_mul, hhi, map_zero] at this
          rw [map_zero]; exact hb.2 _ this
      let x : (⊤ : (Spec (.of C)).Opens) := ⟨y, trivial⟩
      letI : Algebra Γ(Spec (.of C), ⊤) ((Spec (.of C)).presheaf.stalk (x : Spec (.of C))) :=
        ((Spec (.of C)).presheaf.germ ⊤ (x : Spec (.of C)) trivial).hom.toAlgebra
      haveI := hU.isLocalization_stalk x
      have hmap := IsLocalization.map_nonZeroDivisors_le
        (hU.primeIdealOf x).asIdeal.primeCompl ((Spec (.of C)).presheaf.stalk (x : Spec (.of C)))
        ⟨_, hnz0, rfl⟩
      exact hmap
    have hc := (mem_nonZeroDivisors_iff.mp hnz).1 (ν * (ε1.stalkMap y).hom w' - 1)
      (by linear_combination -hw2)
    have hu : IsUnit ν := isUnit_iff_exists_inv.mpr ⟨_, sub_eq_zero.mp hc⟩
    have hy : y ∈ (Spec (.of C)).basicOpen ((Scheme.ΓSpecIso (.of C)).inv.hom v) :=
      (Scheme.mem_basicOpen (Spec (.of C)) (U := ⊤) _ y trivial).mpr hu
    rw [basicOpen_eq_of_affine] at hy
    exact hy

  have hHat1 : ∀ i : Fin n, wcQmbtChartHat (A' := A') i i = 1 := fun i => if_pos rfl
  have hHat2 : ∀ i j : Fin n, j ≠ i →
      wcQmbtChartHat (A' := A') i j = MvPolynomial.X (some j) := fun i j h => if_neg h
  have R1 : ∀ i j : Fin n, j ≠ i → φ i (wcQmbtGen A' n π' c' (some j)) =
      φ i (wcQmbtGen A' n π' c' (some i)) * wcQmdlCX A' n π' c' i (some j) := by
    intro i j hji
    show φ i (Ideal.Quotient.mk _ (MvPolynomial.X j)) =
      φ i (Ideal.Quotient.mk _ (MvPolynomial.X i)) * _
    rw [P1 i j, P1 i i, hHat1 i, hHat2 i j hji, mul_one, ← map_mul]

  have hgpt : ∀ (j : Fin n) (z : E) (hz : z ∈ wcQxeV K jE j),
      g z = e j (ψ j (⟨z, hz⟩ : wcQxeV K jE j)) := by
    intro j z hz
    have h1 := congrArg (fun f => f (⟨z, hz⟩ : (wcQxeV K jE j).toScheme)) (hg j)
    simp only [Scheme.Hom.comp_apply] at h1
    exact h1

  have hB : ∀ (j : Fin n) (z : E) (y' : Spec (.of (wcQmbtChart A' n π' c' j))),
      g z = e j y' → z ∈ wcQxeV K jE j := by
    intro j z y' hzy
    obtain ⟨i, hi⟩ := hcov z
    by_cases hij : i = j
    · subst hij; exact hi
    have hU := S2 r₁ (e i) (e j) (φ i) (φ j) (P9 i) (P9 j) (wcQmbtGen A' n π' c' (some i))
      (wcQmbtGen A' n π' c' (some j)) (wcQmdlCX A' n π' c' i (some j))
      (wcQmdlCX A' n π' c' j (some i)) (R1 i j (Ne.symm hij)) (R1 j i hij) (P3 i)
      (ψ i (⟨z, hi⟩ : wcQxeV K jE i)) y' ((hgpt i z hi).symm.trans hzy)
    have h1 : IsUnit ((E.presheaf.germ (wcQxeV K jE i) z hi).hom
        (χ i (wcQmdlCX A' n π' c' i (some j)))) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hm
      exact hU ((S1 _ _ (χ i) (ψ i) (hχ i).2.2.2.2 ⟨z, hi⟩ _).mpr hm)
    rw [(hχ i).2.2.1 j (Ne.symm hij), ← Scheme.mem_basicOpen E _ z hi,
      ← Scheme.preimage_basicOpen, (wc_ldpi_oai_sgE_facts K n i.castSucc j.castSucc).2] at h1
    have h3 : jE z ∈ wcSgD K n i.castSucc ⊓ wcSgD K n j.castSucc := h1
    have h4 : jE z ∈ wcSgD K n j.castSucc :=
      SetLike.le_def.mp (inf_le_right (a := wcSgD K n i.castSucc) (b := wcSgD K n j.castSucc)) h3
    exact h4

  have PSI : ∀ j, IsClosedImmersion (ψ j) := by
    intro j
    have hD : IsAffineOpen (wcSgD K n j.castSucc) :=
      @Proj.isAffineOpen_basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X j.castSucc) 1
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K _)) one_pos
    haveI : IsAffine (wcQxeV K jE j).toScheme := hD.preimage jE
    have hsurjχ : Function.Surjective (χ j) := by
      letI := (wcCnSigma (jE ≫ wcProjKStr K n) (wcQxeV K jE j)).toAlgebra
      have hgen : Algebra.adjoin K (Set.range fun p =>
          (jE.app (wcSgD K n j.castSucc)).hom (wcSgE K n j.castSucc p)) = ⊤ :=
        wc_ldp_dtc_chart_generated K n (Over.mk (jE ≫ wcProjKStr K n)) jE hjEci rfl j.castSucc
      intro y
      have hy : y ∈ Algebra.adjoin K (Set.range fun p =>
          (jE.app (wcSgD K n j.castSucc)).hom (wcSgE K n j.castSucc p)) := by
        rw [hgen]; exact Algebra.mem_top
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        obtain ⟨p, rfl⟩ := hx
        rcases Fin.eq_castSucc_or_eq_last p with ⟨q, rfl⟩ | rfl
        · by_cases hqj : q = j
          · refine ⟨1, ?_⟩
            rw [map_one]
            beta_reduce
            rw [hqj, (wc_ldpi_oai_sgE_facts K n j.castSucc j.castSucc).1, map_one]
          · exact ⟨wcQmdlCX A' n π' c' j (some q), (hχ j).2.2.1 q hqj⟩
        · exact ⟨wcQmdlCX A' n π' c' j none, (hχ j).1⟩
      | algebraMap c =>
        obtain ⟨x, hx⟩ := IsLocalRing.residue_surjective (σ.symm c)
        refine ⟨algebraMap A' _ x, ?_⟩
        rw [(hχ j).2.2.2.1 x, hx, RingEquiv.apply_symm_apply]
        rfl
      | add x y _ _ hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a + b, map_add _ _ _⟩
      | mul x y _ _ hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a * b, map_mul _ _ _⟩
    apply IsClosedImmersion.of_surjective_of_isAffine
    intro t
    obtain ⟨f, hf⟩ := hsurjχ ((wcQxeV K jE j).topIso.hom t)
    refine ⟨(Scheme.ΓSpecIso _).inv.hom f, ?_⟩
    have h1 := (hχ j).2.2.2.2 f
    rw [hf] at h1
    exact h1.trans (Iso.hom_inv_id_apply (wcQxeV K jE j).topIso t)

  have hcl : IsClosed ({o} : Set (Spec (.of (wcQuadModelRing A' n (π' ^ 2) c')))) :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal o).mpr (by rw [hoeq]; exact hmax)
  let U' : X₁.Opens := ⟨(r₁ ⁻¹' {o})ᶜ, (hcl.preimage r₁.continuous).isOpen_compl⟩
  let U : Option (Fin n) → X₁.Opens := fun k => Option.elim k U' (fun j => (e j).opensRange)
  have hU : iSup U = ⊤ := by
    rw [eq_top_iff]
    rintro x -
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hx : r₁ x = o
    · obtain ⟨j, y, hy, -⟩ := FIC x hx
      refine ⟨some j, ?_⟩
      show x ∈ (e j).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨y, hy⟩
    · refine ⟨none, ?_⟩
      show x ∈ U'
      exact hx
  refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @IsClosedImmersion) U hU).mpr ?_
  intro k
  cases k with
  | none =>
    show IsClosedImmersion (g ∣_ U')
    haveI : IsEmpty (g ⁻¹ᵁ U').toScheme := by
      constructor
      rintro ⟨z, hz⟩
      have hz' : r₁ (g z) ≠ o := hz
      exact hz' (hsub ⟨z, rfl⟩)
    exact IsClosedImmersion.instOfIsEmptyCarrierCarrierCommRingCat _
  | some j =>
    show IsClosedImmersion (g ∣_ (e j).opensRange)
    have hVg : wcQxeV K jE j = g ⁻¹ᵁ (e j).opensRange := by
      ext z
      constructor
      · intro hz
        show g z ∈ (e j).opensRange
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        exact ⟨_, (hgpt j z hz).symm⟩
      · intro hz
        have hz' : g z ∈ (e j).opensRange := hz
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hz'
        obtain ⟨y, hy⟩ := hz'
        exact hB j z y hy.symm
    have key : g ∣_ (e j).opensRange =
        (E.isoOfEq hVg).inv ≫ ψ j ≫ (e j).isoOpensRange.hom := by
      rw [← cancel_mono ((e j).opensRange.ι), morphismRestrict_ι]
      simp only [Category.assoc]
      rw [Scheme.Hom.isoOpensRange_hom_ι, ← hg j, ← Scheme.isoOfEq_hom_ι E hVg]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [key]
    haveI := PSI j
    infer_instance

theorem wc_qxe_cfs_lift {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'} {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) {E : Scheme.{u}} (jE : E ⟶ wcProjK K n)
    (j : Fin n) (χ : wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j))
    (ψ : (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : wcQxeChiPkg π' c' σ jE j χ ψ) (I : Ideal (wcQmbtChart A' n π' c' j))
    (hX : wcQmdlCX A' n π' c' j (some j) ∈ I)
    (κ : K →+* wcQmbtChart A' n π' c' j ⧸ I)
    (hκ : ∀ x : A', κ (σ (IsLocalRing.residue A' x)) =
      Ideal.Quotient.mk I (algebraMap A' (wcQmbtChart A' n π' c' j) x))
    (φ : Spec (.of (wcQmbtChart A' n π' c' j ⧸ I)) ⟶ wcProjK K n)
    (hφ : φ ≫ wcProjKStr K n = Spec.map (CommRingCat.ofHom κ))
    (htop : ⊤ ≤ φ ⁻¹ᵁ wcSgD K n j.castSucc)
    (hrelp : ∀ p : Fin n,
      (φ.appLE (wcSgD K n j.castSucc) ⊤ htop).hom (wcSgE K n j.castSucc p.castSucc) =
        (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ I))).inv.hom
          (Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (wcQmbtChartHat j p))))
    (hrelS : (φ.appLE (wcSgD K n j.castSucc) ⊤ htop).hom
        (wcSgE K n j.castSucc (Fin.last n)) =
      (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ I))).inv.hom
        (Ideal.Quotient.mk I (wcQmdlCX A' n π' c' j none))) :
    ∀ f : wcQmbtChart A' n π' c' j,
      ∃ a : Γ(wcProjK K n, wcSgD K n j.castSucc),
        χ f = (jE.app (wcSgD K n j.castSucc)).hom a ∧
        Ideal.Quotient.mk I f = (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ I))).hom
          ((φ.appLE (wcSgD K n j.castSucc) ⊤ htop).hom a) :=
by
  classical
  obtain ⟨hC1, hC2, hC3, hC4, -⟩ := hχ
  have s1 : ∀ {X Y : Scheme.{u}} {R : CommRingCat.{u}} (g : X ⟶ Y)
      (sY : Y ⟶ Spec R) (sX : X ⟶ Spec R) (_hs : g ≫ sY = sX) (U : Y.Opens) (V : X.Opens)
      (e : V ≤ g ⁻¹ᵁ U) (r : Γ(Spec R, ⊤)),
      (g.appLE U V e).hom ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (sY.appTop.hom r)) =
        (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (sX.appTop.hom r) := by
    intro X Y R g sY sX hs U V e r
    subst hs
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE, Scheme.Hom.comp_appTop,
      CommRingCat.comp_apply, Scheme.Hom.appLE, CommRingCat.comp_apply]
    rfl
  let C := wcQmbtChart A' n π' c' j
  let U := wcSgD K n j.castSucc
  let jA : Γ(wcProjK K n, U) →+* Γ(E, wcQxeV K jE j) := (jE.app U).hom
  let α : Γ(wcProjK K n, U) →+* C ⧸ I :=
    (Scheme.ΓSpecIso (.of (C ⧸ I))).hom.hom.comp (φ.appLE U ⊤ htop).hom
  let G : Subring C :=
    { carrier := {f | ∃ a, jA a = χ f ∧ α a = Ideal.Quotient.mk I f}
      mul_mem' := by
        rintro f g ⟨a, ha1, ha2⟩ ⟨b, hb1, hb2⟩
        exact ⟨a * b, by rw [map_mul, map_mul, ha1, hb1], by rw [map_mul, map_mul, ha2, hb2]⟩
      one_mem' := ⟨1, by rw [map_one, map_one], by rw [map_one, map_one]⟩
      add_mem' := by
        rintro f g ⟨a, ha1, ha2⟩ ⟨b, hb1, hb2⟩
        exact ⟨a + b, by rw [map_add, map_add, ha1, hb1], by rw [map_add, map_add, ha2, hb2]⟩
      zero_mem' := ⟨0, by rw [map_zero, map_zero], by rw [map_zero, map_zero]⟩
      neg_mem' := by
        rintro f ⟨a, ha1, ha2⟩
        exact ⟨-a, by rw [map_neg, map_neg, ha1], by rw [map_neg, map_neg, ha2]⟩ }
  have hmem : ∀ f : C, f ∈ G ↔ ∃ a, jA a = χ f ∧ α a = Ideal.Quotient.mk I f := by
    intro f
    rfl
  have hgen : ∀ i, wcQmdlCX A' n π' c' j i ∈ G := by
    intro i
    rw [hmem]
    rcases i with _ | p
    · refine ⟨wcSgE K n j.castSucc (Fin.last n), hC1.symm, ?_⟩
      show (Scheme.ΓSpecIso _).hom.hom ((φ.appLE U ⊤ htop).hom _) = _
      rw [hrelS, CommRingCat.hom_inv_apply]
    · by_cases hp : p = j
      · rw [hp]
        refine ⟨0, ?_, ?_⟩
        · rw [map_zero, hC2]
        · rw [map_zero]; exact ((Ideal.Quotient.eq_zero_iff_mem).mpr hX).symm
      · refine ⟨wcSgE K n j.castSucc p.castSucc, (hC3 p hp).symm, ?_⟩
        show (Scheme.ΓSpecIso _).hom.hom ((φ.appLE U ⊤ htop).hom _) = _
        rw [hrelp, CommRingCat.hom_inv_apply]
        congr 2
        simp [wcQmbtChartHat, hp]
  have hall : ∀ f : C, f ∈ G := by
    intro f
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective f
    induction P using MvPolynomial.induction_on with
    | C x =>
      rw [hmem]
      have hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.C x) =
          algebraMap A' C x := rfl
      rw [hx]
      refine ⟨((wcProjK K n).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        ((wcProjKStr K n).appTop.hom
          ((Scheme.ΓSpecIso (.of K)).inv.hom (σ (IsLocalRing.residue A' x)))), ?_, ?_⟩
      · rw [hC4]
        show (jE.app U).hom _ = _
        rw [Scheme.Hom.app_eq_appLE, s1 jE _ (jE ≫ wcProjKStr K n) rfl]
        rfl
      · show (Scheme.ΓSpecIso _).hom.hom ((φ.appLE U ⊤ htop).hom _) = _
        rw [s1 φ _ _ hφ, ← hκ x]
        rw [show homOfLE (le_top : (⊤ : (Spec (CommRingCat.of (C ⧸ I))).Opens) ≤ ⊤) = 𝟙 _ from
          Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id, CommRingCat.id_apply,
          ← CommRingCat.comp_apply, Scheme.ΓSpecIso_naturality, CommRingCat.comp_apply,
          CommRingCat.hom_inv_apply]
        rfl
    | add p q hp hq =>
      rw [map_add]
      exact G.add_mem hp hq
    | mul_X p i hp =>
      rw [map_mul]
      exact G.mul_mem hp (hgen i)
  intro f
  obtain ⟨a, h1, h2⟩ := (hmem f).1 (hall f)
  exact ⟨a, h1.symm, h2.symm⟩

theorem wc_qxe_chart_fibre_surj {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Scheme.{u}) (jE : E ⟶ wcProjK K n)
    (hjEci : IsClosedImmersion jE)
    (hjE : Set.range jE = wcXspVplus K n
      (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))))
    (j : Fin n) (χ : wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j))
    (ψ : (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : wcQxeChiPkg π' c' σ jE j χ ψ) :
    ∀ y : Spec (.of (wcQmbtChart A' n π' c' j)),
      wcQmdlCX A' n π' c' j (some j) ∈ y.asIdeal →
      algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y.asIdeal →
      ∃ z : wcQxeV K jE j, ψ z = y :=
by
  classical
  intro y hyX hyπ

  have L2 : ∀ {σ' : Type u} {B : Type u} [CommRing B] [SetLike σ' B] [AddSubgroupClass σ' B]
      (𝒜 : ℕ → σ') [GradedRing 𝒜] (f g : B) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 2),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) := by
    intro σ' B _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg (by norm_num : 0 < 2)
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

  obtain ⟨aa, haa⟩ : ∃ aa : Fin (n + 1) → Fin (n + 1) → K,
      aa = wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q))) := ⟨_, rfl⟩
  have hsec : (wcProjK K n).basicOpen (wcLdpSec K n (wcLdpQuad K n aa) j.castSucc) =
      wcSgD K n j.castSucc ⊓
        @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          MvPolynomial.gradedAlgebra ((wcLdpQuad K n aa : MvPolynomial (Fin (n + 1)) K)) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : (MvPolynomial.X j.castSucc : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ _)
    exact (L2 (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) _ _ hX
      (wcLdpQuad K n aa).2).symm
  have h1 : ∀ p q : Fin n, aa p.castSucc q.castSucc = σ (IsLocalRing.residue A' (c' p q)) := by
    intro p q
    rw [haa]
    unfold wcXspExtCoeff
    rw [dif_pos (show ((p.castSucc : ℕ) < n ∧ (q.castSucc : ℕ) < n) from ⟨p.isLt, q.isLt⟩)]
    rfl
  have h2 : ∀ p : Fin n, aa p.castSucc (Fin.last n) = 0 := by
    intro p
    rw [haa]
    unfold wcXspExtCoeff
    have := p.isLt
    rw [dif_neg (fun h => by simp at h), if_neg (fun h => by simp at h <;> omega)]
  have h3 : ∀ q : Fin n, aa (Fin.last n) q.castSucc = 0 := by
    intro q
    rw [haa]
    unfold wcXspExtCoeff
    have := q.isLt
    rw [dif_neg (fun h => by simp at h), if_neg (fun h => by simp at h <;> omega)]
  have h4 : aa (Fin.last n) (Fin.last n) = -1 := by
    rw [haa]
    unfold wcXspExtCoeff
    rw [dif_neg (fun h => by simp at h), if_pos ⟨Fin.val_last n, Fin.val_last n⟩]

  obtain ⟨J, hJ⟩ : ∃ J : Ideal (wcQmbtChart A' n π' c' j), J = Ideal.span
      {wcQmdlCX A' n π' c' j (some j), algebraMap A' (wcQmbtChart A' n π' c' j) π'} := ⟨_, rfl⟩
  have hXJ : wcQmdlCX A' n π' c' j (some j) ∈ J := by
    rw [hJ]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hπJ : algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ J := by
    rw [hJ]; exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hJy : J ≤ y.asIdeal := by
    rw [hJ, Ideal.span_le]
    intro x hx
    rcases hx with rfl | rfl
    · exact hyX
    · exact hyπ

  have hker : ∀ a ∈ IsLocalRing.maximalIdeal A',
      ((Ideal.Quotient.mk J).comp (algebraMap A' (wcQmbtChart A' n π' c' j))) a = 0 := by
    intro a ha
    rw [hπ', Ideal.mem_span_singleton] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
    exact J.mul_mem_right _ hπJ
  let κ₀ : IsLocalRing.ResidueField A' →+* (wcQmbtChart A' n π' c' j ⧸ J) :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal A')
      ((Ideal.Quotient.mk J).comp (algebraMap A' (wcQmbtChart A' n π' c' j))) hker
  obtain ⟨κ, hκ⟩ : ∃ κ : K →+* (wcQmbtChart A' n π' c' j ⧸ J), ∀ x : A',
      κ (σ (IsLocalRing.residue A' x)) =
        Ideal.Quotient.mk J (algebraMap A' (wcQmbtChart A' n π' c' j) x) := by
    refine ⟨κ₀.comp σ.symm.toRingHom, fun x => ?_⟩
    change κ₀ (σ.symm (σ (IsLocalRing.residue A' x))) = _
    rw [RingEquiv.symm_apply_apply]
    exact Ideal.Quotient.lift_mk _ _ _

  obtain ⟨τ, hτp, hτS⟩ : ∃ τ : Fin (n + 1) → wcQmbtChart A' n π' c' j ⧸ J,
      (∀ p : Fin n, τ p.castSucc = Ideal.Quotient.mk J
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (wcQmbtChartHat j p))) ∧
      τ (Fin.last n) = Ideal.Quotient.mk J (wcQmdlCX A' n π' c' j none) :=
    ⟨Fin.lastCases (motive := fun _ => wcQmbtChart A' n π' c' j ⧸ J)
      (Ideal.Quotient.mk J (wcQmdlCX A' n π' c' j none))
      (fun p => Ideal.Quotient.mk J
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (wcQmbtChartHat j p))),
      fun p => Fin.lastCases_castSucc _, Fin.lastCases_last⟩

  have hC : ∀ x : A', Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.C x) =
      algebraMap A' (wcQmbtChart A' n π' c' j) x := by
    intro x
    rw [← MvPolynomial.algebraMap_eq]
    exact Ideal.Quotient.mk_algebraMap _ _ _
  have hg2 : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
      (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q -
        MvPolynomial.X none ^ 2) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have gen : ∀ {R : Type u} [CommRing R] (f : K →+* R) (τ' : Fin (n + 1) → R),
      (∑ P, ∑ Q, f (aa P Q) * τ' P * τ' Q) =
        (∑ p : Fin n, ∑ q : Fin n, f (σ (IsLocalRing.residue A' (c' p q))) *
          τ' p.castSucc * τ' q.castSucc) - τ' (Fin.last n) ^ 2 := by
    intro R _ f τ'
    simp only [Fin.sum_univ_castSucc, h1, h2, h3, h4, map_zero, map_neg, map_one, zero_mul,
      mul_zero, add_zero, Finset.sum_const_zero, zero_add]
    ring
  have hsplit : (∑ P, ∑ Q, κ (aa P Q) * τ P * τ Q) =
      (∑ p : Fin n, ∑ q : Fin n, κ (σ (IsLocalRing.residue A' (c' p q))) *
        τ p.castSucc * τ q.castSucc) - τ (Fin.last n) ^ 2 := gen κ τ
  have hquad : (∑ P, ∑ Q, κ (aa P Q) * τ P * τ Q) = 0 := by
    have e := congrArg (Ideal.Quotient.mk J) hg2
    simp only [map_sub, map_sum, map_mul, map_pow, map_zero, hC] at e
    rw [hsplit]
    simp only [hτp, hτS, hκ]
    exact e
  obtain ⟨t, ht_def⟩ : ∃ t : Fin (n + 1) →
      Γ(Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)), ⊤), ∀ L, t L =
        (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom (τ L) :=
    ⟨_, fun _ => rfl⟩
  have ht1 : t j.castSucc = 1 := by
    rw [ht_def, hτp]
    simp [wcQmbtChartHat]
  have ht : Ideal.span (Set.range t) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨j.castSucc, ht1⟩) isUnit_one

  obtain ⟨φ, hφ, hbo, hrel₀⟩ := wc_ldpi_oai_proj_lift K n
    (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))) (Spec.map (CommRingCat.ofHom κ)) t ht
  have htop : ⊤ ≤ φ ⁻¹ᵁ wcSgD K n j.castSucc := by
    have h1' : (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).basicOpen
        (t j.castSucc) = ⊤ := by
      rw [ht1]; exact Scheme.basicOpen_of_isUnit _ isUnit_one
    rw [hbo, h1'] <;> exact le_rfl
  have hid : ∀ s : Γ(Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)), ⊤),
      (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).presheaf.map
        (homOfLE (le_top : (⊤ : (Spec (CommRingCat.of
          (wcQmbtChart A' n π' c' j ⧸ J))).Opens) ≤ ⊤)).op s = s := by
    intro s
    rw [show homOfLE (le_top : (⊤ : (Spec (CommRingCat.of
        (wcQmbtChart A' n π' c' j ⧸ J))).Opens) ≤ ⊤) = 𝟙 _ from Subsingleton.elim _ _,
      op_id, CategoryTheory.Functor.map_id]
    rfl
  have hrel : ∀ L : Fin (n + 1),
      (φ.appLE (wcSgD K n j.castSucc) ⊤ htop).hom (wcSgE K n j.castSucc L) = t L := by
    intro L
    have h := hrel₀ j.castSucc L ⊤ htop
    rw [ht1, hid, hid, mul_one] at h
    exact h
  have hrelp : ∀ p : Fin n,
      (φ.appLE (wcSgD K n j.castSucc) ⊤ htop).hom (wcSgE K n j.castSucc p.castSucc) =
        (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom
          (Ideal.Quotient.mk J (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (wcQmbtChartHat j p))) := by
    intro p
    rw [hrel, ht_def, hτp]
  have hrelS : (φ.appLE (wcSgD K n j.castSucc) ⊤ htop).hom
        (wcSgE K n j.castSucc (Fin.last n)) =
      (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom
        (Ideal.Quotient.mk J (wcQmdlCX A' n π' c' j none)) := by
    rw [hrel, ht_def, hτS]

  have hkerq : RingHom.ker (Ideal.Quotient.mk J) ≤ y.asIdeal := by
    rw [Ideal.mk_ker]; exact hJy
  haveI : y.asIdeal.IsPrime := y.isPrime
  let ybar : Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)) :=
    (⟨Ideal.map (Ideal.Quotient.mk J) y.asIdeal,
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hkerq⟩ :
        PrimeSpectrum (wcQmbtChart A' n π' c' j ⧸ J))
  have hstar : ∀ f, Ideal.Quotient.mk J f ∈ Ideal.map (Ideal.Quotient.mk J) y.asIdeal ↔
      f ∈ y.asIdeal := by
    intro f
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective,
      sup_eq_left.mpr hkerq]

  have hnat : ∀ k : K, (Spec.map (CommRingCat.ofHom κ)).appTop.hom
      ((Scheme.ΓSpecIso (.of K)).inv.hom k) =
      (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom (κ k) := by
    intro k
    have h := Scheme.ΓSpecIso_inv_naturality (R := CommRingCat.of K)
      (S := CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)) (CommRingCat.ofHom κ)
    have h2 := congrArg (fun g => g.hom k) h
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    exact h2.symm
  have hq : ∑ p, ∑ q, (Spec.map (CommRingCat.ofHom κ)).appTop.hom
      ((Scheme.ΓSpecIso (.of K)).inv.hom (aa p q)) * t p * t q = 0 := by
    have e := congrArg
      (fun x => (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom x)
      hquad
    simp only [map_zero, map_sum] at e
    rw [← e]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul, hnat, ht_def, ht_def]
  have hon := wc_qmdl_cfs_on_quadric K n
    (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))) (Spec.map (CommRingCat.ofHom κ)) t
    aa hq φ hφ hbo hrel₀

  have hD : φ ybar ∈ wcSgD K n j.castSucc := by
    have h1' : ybar ∈ φ ⁻¹ᵁ wcSgD K n j.castSucc := htop trivial
    rw [Scheme.Hom.mem_preimage] at h1'
    exact h1'
  have hV : φ ybar ∈ wcXspVplus K n aa := by
    rw [wcXspVplus, Set.mem_setOf_eq]
    intro hF
    have hmem : φ ybar ∈ (wcProjK K n).basicOpen
        (wcLdpSec K n (wcLdpQuad K n aa) j.castSucc) := by
      rw [hsec]
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hD, hF⟩
    have hunit := (Scheme.mem_basicOpen _ _ _ hD).mp hmem
    exact IsLocalRing.notMem_maximalIdeal.mpr hunit (hon ybar j.castSucc hD)

  have hr : φ ybar ∈ Set.range jE := by
    rw [hjE, ← haa]; exact hV
  obtain ⟨z₀, hz⟩ := hr
  have hz₀ : z₀ ∈ jE ⁻¹ᵁ wcSgD K n j.castSucc := by
    rw [Scheme.Hom.mem_preimage, hz]; exact hD

  refine ⟨⟨z₀, hz₀⟩, ?_⟩
  apply PrimeSpectrum.ext
  ext f
  obtain ⟨a, ha1, ha2⟩ := wc_qxe_cfs_lift c' K σ jE j χ ψ hχ J hXJ κ hκ φ hφ htop
    hrelp hrelS f
  refine (wc_qmdl_spec_point_mem (wcQxeV K jE j)
    (CommRingCat.of (wcQmbtChart A' n π' c' j)) χ ψ hχ.2.2.2.2 ⟨z₀, hz₀⟩ f).trans ?_
  change (E.presheaf.germ (jE ⁻¹ᵁ wcSgD K n j.castSucc) z₀ hz₀).hom (χ f) ∈
      IsLocalRing.maximalIdeal (E.presheaf.stalk z₀) ↔ f ∈ y.asIdeal
  rw [ha1]
  refine (wc_qmdl_cfs_common_point_mem (wcSgD K n j.castSucc) jE φ htop z₀ ybar
    hz hz₀ a).trans ?_
  rw [← ha2]
  exact hstar f

theorem wc_qxs_model_exc_quadric {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det)
    {X₁ : Scheme.{u}} {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
        (wcQmbtGen A' n π' c' k)))) r₁)
    {o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (ho : ∀ k, wcQmbtGen A' n π' c' k ∈ o.asIdeal)
    (K : Type u) [Field K] (σ : IsLocalRing.ResidueField A' ≃+* K) :
    ∃ (R₁ : Scheme.{u}) (_ : AlgebraicGeometry.IsReduced R₁) (str : R₁ ⟶ Spec (.of K))
      (e₁ : R₁ ⟶ X₁) (ρ : wcQuadModelRing A' n (π' ^ 2) c' →+* K) (j₁ : R₁ ⟶ wcProjK K n),
      (∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0) ∧
      ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        σ.toRingHom.comp (IsLocalRing.residue A') ∧
      IsClosedImmersion e₁ ∧ Set.range e₁ = r₁ ⁻¹' {o} ∧
      e₁ ≫ r₁ = str ≫ Spec.map (CommRingCat.ofHom ρ) ∧
      IsClosedImmersion j₁ ∧ j₁ ≫ wcProjKStr K n = str ∧
      Set.range j₁ = wcXspVplus K n
        (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))) :=
by
  classical

  obtain ⟨E, jE, hEred, hjEci, hjErange⟩ : ∃ (E : Scheme.{u}) (jE : E ⟶ wcProjK K n),
      AlgebraicGeometry.IsReduced E ∧ IsClosedImmersion jE ∧
      Set.range jE = wcXspVplus K n
        (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))) := by
    have hZ : IsClosed (wcXspVplus K n
        (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q))))) := by
      have hO := (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        MvPolynomial.gradedAlgebra ((wcLdpQuad K n (wcXspExtCoeff
          (fun p q => σ (IsLocalRing.residue A' (c' p q)))) : MvPolynomial (Fin (n + 1)) K))).isOpen
      exact hO.isClosed_compl
    let Z : TopologicalSpace.Closeds (wcProjK K n) := ⟨_, hZ⟩
    let J : (wcProjK K n).IdealSheafData := (Scheme.IdealSheafData.vanishingIdeal Z).radical
    have h2 : Set.range J.subschemeι = wcXspVplus K n
        (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))) := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
        Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have hring : ∀ U : (wcProjK K n).affineOpens,
        _root_.IsReduced (Γ(wcProjK K n, U) ⧸ J.ideal U) := fun U =>
      (Ideal.isRadical_iff_quotient_reduced _).mp
        (by
          show ((Scheme.IdealSheafData.vanishingIdeal Z).radical.ideal U).IsRadical
          rw [Scheme.IdealSheafData.radical_ideal]
          exact Ideal.radical_isRadical _)
    have hpieces : ∀ i, AlgebraicGeometry.IsReduced (J.subschemeCover.openCover.X i) :=
      fun (U : (wcProjK K n).affineOpens) => by
        haveI := hring U
        exact (inferInstance : AlgebraicGeometry.IsReduced
          (Spec (CommRingCat.of (Γ(wcProjK K n, (U : (wcProjK K n).Opens)) ⧸ J.ideal U))))
    have h3 : AlgebraicGeometry.IsReduced J.subscheme :=
      IsReduced.of_openCover _ J.subschemeCover.openCover
    exact ⟨J.subscheme, J.subschemeι, h3, inferInstance, h2⟩
  haveI := hEred
  have hjEsub : Set.range jE ⊆ wcXspVplus K n
      (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))) := hjErange.le

  obtain ⟨ρ₀, hρ₀X, hρ₀A, hmax⟩ := wc_qmdl_gen_ideal_maximal hπ' n c'
  obtain ⟨ρ, hρX, hρA⟩ : ∃ ρ : wcQuadModelRing A' n (π' ^ 2) c' →+* K,
      (∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0) ∧
      ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        σ.toRingHom.comp (IsLocalRing.residue A') :=
    ⟨σ.toRingHom.comp ρ₀, fun p => by rw [RingHom.comp_apply, hρ₀X p, map_zero],
      by rw [RingHom.comp_assoc, hρ₀A]⟩
  have hoeq : o.asIdeal = Ideal.span (Set.range (wcQmbtGen A' n π' c')) := by
    have hle : Ideal.span (Set.range (wcQmbtGen A' n π' c')) ≤ o.asIdeal :=
      Ideal.span_le.mpr (by rintro _ ⟨k, rfl⟩; exact ho k)
    exact (hmax.eq_of_le o.isPrime.ne_top hle).symm

  obtain ⟨φ, φ0, e, e0, hpkg⟩ := wc_qmdl_charts_exist hπ' c' hr

  choose χ ψ hχ using fun j => wc_qxe_chart_ring_hom hπ' c' K σ E jE hjEsub j

  obtain ⟨g, hcov, hgι, hgpt, hgsq⟩ :=
    wc_qxe_glue_map hπ' hr hpkg K σ E jE hjEsub χ ψ hχ ρ hρX hρA

  obtain ⟨hgci, hgsub⟩ := wc_qxe_glue_closed_imm hπ' hr hpkg K σ E jE hjEci hjEsub χ ψ hχ g
    hcov hgι ρ hρX hρA hgsq hoeq hmax

  refine ⟨E, hEred, jE ≫ wcProjKStr K n, g, ρ, jE, hρX, hρA, hgci, ?_, hgsq, hjEci, rfl,
    hjErange⟩
  apply Set.Subset.antisymm hgsub
  intro x hx
  obtain ⟨j, y, hy, hX, hπy⟩ := wc_qxe_fibre_in_charts hπ' hr hpkg hoeq x hx
  obtain ⟨z, hz⟩ := wc_qxe_chart_fibre_surj hπ' c' K σ E jE hjEci hjErange j (χ j) (ψ j) (hχ j)
    y hX hπy
  refine ⟨z.1, ?_⟩
  rw [hgpt j z.1 z.2, ← hy, ← hz]

theorem wc_qxs_exc_fibre_quadric {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {F : Scheme.{u}} {iF : F ⟶ Xs'} {pF : F ⟶ Spec (.of (IsLocalRing.ResidueField B₀))}
    (hF : IsPullback iF pF (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (wcQmSp B₀)) :
    ∃ (a0 : Fin n → Fin n → IsLocalRing.ResidueField B₀) (R₀ : Scheme.{u})
      (_ : AlgebraicGeometry.IsReduced R₀) (r₀ : R₀ ⟶ F)
      (j₀ : R₀ ⟶ wcProjK (IsLocalRing.ResidueField B₀) n),
      (Matrix.of a0 + (Matrix.of a0).transpose).det ≠ 0 ∧ IsClosedImmersion r₀ ∧
      Set.range r₀ = Set.univ ∧ IsClosedImmersion j₀ ∧
      j₀ ≫ wcProjKStr (IsLocalRing.ResidueField B₀) n = r₀ ≫ pF ∧
      Set.range j₀ = wcXspVplus (IsLocalRing.ResidueField B₀) n (wcXspExtCoeff a0) :=
by
  classical

  obtain ⟨θ, X₁, r₁, ψ, hθX, hθA, hr₁, hsq, hψf, -⟩ := wc_qmbt_qm_model_square_ext hsh hπ'2 hbl

  obtain ⟨o, ho, hoiff⟩ := wc_qmbt_hlsc_theta_fibre hπ hx₀ hπ' hπ'2 θ hθX hθA
  obtain ⟨σ, hσ⟩ := wc_qmbt_qm_residue_equiv hπ hx₀ hsh hπ' hπ'2 hgen
  have hx0 := wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh

  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have h1 : c.map ιA + (c.map ιA).transpose = (c + c.transpose).map ιA := by
      ext i j; simp
    have h2 : ((c + c.transpose).map ιA).det = ιA (c + c.transpose).det :=
      (RingHom.map_det ιA _).symm
    rw [h1, h2]; exact hc.map ιA
  obtain ⟨R₁, hR₁, str, e₁, ρ, j₁, hρX, hρA, he₁, hrange₁, he₁r, hj₁, hj₁s, hj₁r⟩ :=
    wc_qxs_model_exc_quadric hπ' (by omega : 2 ≤ n) hc' hr₁ ho (IsLocalRing.ResidueField B₀) σ

  have hring : ρ.comp θ = (IsLocalRing.residue B₀).comp (Spec.preimage a₀).hom := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro x
      have e1 : (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.C x) =
          algebraMap A (wcQuadModelRing A n π c) x := rfl
      simp only [RingHom.comp_apply]
      rw [e1]
      have e2 := congrArg (fun g => g x) hθA
      have e3 := congrArg (fun g => g (ιA x)) hρA
      simp only [RingHom.comp_apply] at e2 e3
      rw [e2, e3, ← hσ x]
      rfl
    · intro p
      simp only [RingHom.comp_apply]
      rw [hθX p, hρX p]
      symm
      rw [IsLocalRing.residue_eq_zero_iff]
      have h1 := (wc_qmbt_hl_b0_origin_fibre hπ hx₀ hsh).1 p
