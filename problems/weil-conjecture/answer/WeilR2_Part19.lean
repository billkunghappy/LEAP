      exact h1
  have hspec : Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom θ) =
      wcQmSp B₀ ≫ a₀ := by
    conv_rhs => rw [← Spec.map_preimage a₀]
    show _ = Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) ≫ Spec.map (Spec.preimage a₀)
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact hring

  have hw1 : e₁ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom θ) = (str ≫ wcQmSp B₀) ≫ a₀ := by
    rw [← Category.assoc e₁ r₁, he₁r]
    simp only [Category.assoc, hspec]
  obtain ⟨e, he_ψ, he_β⟩ : ∃ e : R₁ ⟶ Xm, e ≫ ψ = e₁ ∧
      e ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) = str ≫ wcQmSp B₀ :=
    ⟨hsq.lift _ _ hw1, hsq.lift_fst _ _ _, hsq.lift_snd _ _ _⟩

  have hw2 : e ≫ f = (str ≫ Spec.map (CommRingCat.ofHom σ.toRingHom)) ≫ wcQmSp A' := by
    rw [← hblf, ← hψf, ← Category.assoc e ψ, he_ψ, ← Category.assoc e₁ r₁, he₁r]
    simp only [Category.assoc]
    congr 1
    show Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
      Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue A'))
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact hρA
  obtain ⟨e', he'ι, -⟩ : ∃ e' : R₁ ⟶ Xs', e' ≫ ι' = e ∧
      e' ≫ s' = str ≫ Spec.map (CommRingCat.ofHom σ.toRingHom) :=
    ⟨hps'.lift e _ hw2, hps'.lift_fst _ _ _, hps'.lift_snd _ _ _⟩

  have hu : e' ≫ ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = str ≫ wcQmSp B₀ := by
    rw [← Category.assoc e' ι', he'ι]; exact he_β
  obtain ⟨r₀, hr₀iF, hr₀pF⟩ : ∃ r₀ : R₁ ⟶ F, r₀ ≫ iF = e' ∧ r₀ ≫ pF = str :=
    ⟨hF.lift e' str hu, hF.lift_fst _ _ _, hF.lift_snd _ _ _⟩
  haveI hiF : IsClosedImmersion iF :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hF.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue B₀))
        IsLocalRing.residue_surjective)
  haveI hι' : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A'))
        IsLocalRing.residue_surjective)
  haveI hψsep : IsSeparated ψ :=
    MorphismProperty.of_isPullback (P := @IsSeparated) hsq.flip inferInstance
  have hcomp : r₀ ≫ iF ≫ ι' ≫ ψ = e₁ := by
    rw [← Category.assoc r₀ iF, hr₀iF, ← Category.assoc e' ι', he'ι, he_ψ]
  haveI : IsClosedImmersion (r₀ ≫ iF ≫ ι' ≫ ψ) := by rw [hcomp]; exact he₁
  have hr₀ : IsClosedImmersion r₀ := IsClosedImmersion.of_comp r₀ (iF ≫ ι' ≫ ψ)
  have hcp : ∀ z : Spec (.of (IsLocalRing.ResidueField B₀)),
      wcQmSp B₀ z = IsLocalRing.closedPoint B₀ := by
    intro z
    apply PrimeSpectrum.ext
    show Ideal.comap (IsLocalRing.residue B₀) z.asIdeal = IsLocalRing.maximalIdeal B₀
    have hz : z.asIdeal = ⊥ := by
      haveI := z.isPrime
      exact Ideal.eq_bot_of_prime z.asIdeal
    ext x
    rw [hz, Ideal.mem_comap, Ideal.mem_bot, IsLocalRing.residue_eq_zero_iff]
  have hFw : ∀ z : F, Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) (bl (ι' (iF z))) = IsLocalRing.closedPoint B₀ := by
    intro z
    have h1 : (iF ≫ ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) z = (pF ≫ wcQmSp B₀) z := by rw [hF.w]
    simp only [Scheme.Hom.comp_apply] at h1
    rw [h1]; exact hcp _
  have hinj := wc_qm_pullback_fibre_injective hsq hx0.1 hx0.2.2

  refine ⟨fun p q => σ (IsLocalRing.residue A' (ιA (c p q))), R₁, hR₁, r₀, j₁, ?_, hr₀, ?_,
    hj₁, ?_, ?_⟩
  · have hm : Matrix.of (fun p q => σ (IsLocalRing.residue A' (ιA (c p q)))) +
