      ext i j; simp
    have h2 : ((c + c.transpose).map (σ.toRingHom.comp ((IsLocalRing.residue A').comp ιA))).det =
        (σ.toRingHom.comp ((IsLocalRing.residue A').comp ιA)) (c + c.transpose).det :=
      (RingHom.map_det _ _).symm
    rw [hm, h2]
    exact (hc.map _).ne_zero
  · apply Set.eq_univ_of_forall
    intro y
    have hψy : r₁ (ψ (ι' (iF y))) = o := by
      rw [← hoiff]
      have h2 : (ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom θ)) (ι' (iF y)) =
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀) (ι' (iF y)) := by rw [hsq.w]
