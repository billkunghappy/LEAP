      rw [← heH, ← map_mul, ha, RingEquiv.apply_symm_apply]
    · rintro ⟨b, hb⟩
      refine ⟨E.symm b, ?_⟩
      rw [← hb, map_mul, ← heH, RingEquiv.symm_apply_apply]
  have hπC : ∀ a : Ω, π (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      (Submonoid.powers (MvPolynomial.X c))
      (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) a)) =
      algebraMap Ω (MvPolynomial (Fin (2 * e + 1)) Ω) a := by
    intro a
    rw [hπ, ← hEC a, RingEquiv.symm_apply_apply, MvPolynomial.eval₂Hom_C,
      MvPolynomial.algebraMap_eq]

  obtain ⟨iso, hiso⟩ : ∃ iso, iso = Proj.basicOpenIsoSpec
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X c) hXc
      Nat.one_pos := ⟨_, rfl⟩
  have hstar : ∀ x : Spec (.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X c))),
      ((wcSgD Ω (2 * e + 2) c).ι (iso.inv x) ∈ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) ↔
      HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc 2
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 ∉ x.asIdeal := by
    intro x
    have e1 : (wcSgD Ω (2 * e + 2) c).ι (iso.inv x) = Proj.awayι
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X c) hXc
        Nat.one_pos x := by
      rw [← Scheme.Hom.comp_apply, hiso, Proj.basicOpenIsoSpec_inv_ι]
    have hpre := Proj.awayι_preimage_basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc Nat.one_pos
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 (by norm_num : 0 < 2)
    have ha : HomogeneousLocalization.Away.isLocalizationElem hXc
        (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc 2
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2 := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    rw [e1, ← Scheme.Hom.mem_preimage, hpre, ha]
    exact Iff.rfl
  obtain ⟨mz, hmz⟩ : ∃ mz : Spec (.of (MvPolynomial (Fin (2 * e + 1)) Ω)) ⟶
      (wcSgD Ω (2 * e + 2) c : Scheme.{u}), mz = Spec.map (CommRingCat.ofHom π) ≫ iso.inv :=
    ⟨_, rfl⟩
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom π)) :=
    IsClosedImmersion.spec_of_surjective _ hπs
  have : IsClosedImmersion mz := by rw [hmz]; infer_instance
  have hrm : Set.range mz = {x | (wcSgD Ω (2 * e + 2) c).ι x ∉ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)} := by
    ext y
    constructor
    · rintro ⟨z, rfl⟩
      rw [Set.mem_setOf_eq, hmz, Scheme.Hom.comp_apply, hstar, not_not, Spec.map_apply]
      refine (Ideal.mem_comap (f := π) (K := z.asIdeal)).mpr ?_
      have h0 : π (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) hXc 2
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e)).2) = 0 := by
        rw [← RingHom.mem_ker, hπk]
        exact Ideal.mem_span_singleton_self _
      rw [h0]
      exact zero_mem _
    · intro hy
      have hy' : (wcSgD Ω (2 * e + 2) c).ι (iso.inv (iso.hom y)) ∉ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
          (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω) := by
        rw [Scheme.hom_inv_apply]
        exact hy
      rw [hstar, not_not] at hy'
      have hm : (show PrimeSpectrum (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) (MvPolynomial.X c)) from
          iso.hom y) ∈ PrimeSpectrum.zeroLocus (RingHom.ker π : Set _) := by
        rw [PrimeSpectrum.mem_zeroLocus, hπk]
        exact fun w hw => (Ideal.span_singleton_le_iff_mem _).mpr hy' hw
      rw [← range_comap_of_surjective _ π hπs] at hm
      obtain ⟨z, hz⟩ := hm
      let z' : Spec (.of (MvPolynomial (Fin (2 * e + 1)) Ω)) := z
      have e2 : (Spec.map (CommRingCat.ofHom π)) z' = iso.hom y := by
        rw [Spec.map_apply]
        exact hz
      refine ⟨z', ?_⟩
      rw [hmz, Scheme.Hom.comp_apply, e2, Scheme.hom_inv_apply]

  have hrf : Set.range (jY ∣_ wcSgD Ω (2 * e + 2) c) = {x | (wcSgD Ω (2 * e + 2) c).ι x ∉
      @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) MvPolynomial.gradedAlgebra
      (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)} := by
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      show (wcSgD Ω (2 * e + 2) c).ι ((jY ∣_ wcSgD Ω (2 * e + 2) c) w) ∉ _
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
      have hmem : jY ((jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) c).ι w) ∈ Set.range jY := ⟨_, rfl⟩
      rw [hY] at hmem
      exact hmem
    · intro hx
      have hmem : (wcSgD Ω (2 * e + 2) c).ι x ∈ Set.range jY := by rw [hY]; exact hx
      obtain ⟨w, hw⟩ := hmem
      have hwU : w ∈ jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) c := by
        show jY w ∈ wcSgD Ω (2 * e + 2) c
        rw [hw]
        exact x.2
      refine ⟨⟨w, hwU⟩, ?_⟩
      apply (wcSgD Ω (2 * e + 2) c).ι.isOpenEmbedding.injective
      have e3 := Scheme.Hom.comp_apply (jY ∣_ wcSgD Ω (2 * e + 2) c) (wcSgD Ω (2 * e + 2) c).ι
        ⟨w, hwU⟩
      rw [morphismRestrict_ι] at e3
      exact e3.symm.trans hw
  obtain ⟨φ, hφ⟩ := s5 _ _ _ (jY ∣_ wcSgD Ω (2 * e + 2) c) mz (hrf.trans hrm.symm)

  have hs6 : mz ≫ (wcSgD Ω (2 * e + 2) c).ι ≫ wcProjKStr Ω (2 * e + 2) =
      Spec.map (CommRingCat.ofHom (algebraMap Ω (MvPolynomial (Fin (2 * e + 1)) Ω))) := by
    rw [hmz, Category.assoc, hiso, Proj.basicOpenIsoSpec_inv_ι_assoc]
    simp only [wcProjKStr]
    rw [Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp]
    have hring : (π.comp ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
        (Submonoid.powers (MvPolynomial.X c))).comp
        (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)))) =
        algebraMap Ω (MvPolynomial (Fin (2 * e + 1)) Ω) := RingHom.ext hπC
    rw [hring]
  refine ⟨φ, ?_⟩
  rw [← hs6, ← Category.assoc, hφ, morphismRestrict_ι_assoc]

theorem wc_qxs_odd_chart_overlap_iso : ∀ (Ω : Type u) [Field Ω] (e : ℕ) (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] (jY : Y ⟶ wcProjK Ω (2 * e + 2)), IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) → ∀ k : ℕ, 1 ≤ k → k ≤ e → ∃ E : (Spec (.of (MvPolynomial (Fin (2 * e + 1)) Ω))).Opens, (E : Set (Spec (.of (MvPolynomial (Fin (2 * e + 1)) Ω)))) = {x | ∃ j : Fin (2 * e + 1), j.val < k ∧ (MvPolynomial.X j : MvPolynomial (Fin (2 * e + 1)) Ω) ∉ x.asIdeal} ∧ Nonempty ((((jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩) ⊓ ⨆ (i : ℕ) (_ : i < k), jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) ⟨if i ≤ e then 2 * i + 1 else 2 * e + 1, by split_ifs <;> omega⟩ : Y.Opens) : Scheme.{u}) ≅ (E : Scheme.{u})) :=
by
  intro Ω _ e Y _ jY hjY hY k hk1 hk
  have L1 : ∀ (Y P S M : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] [AlgebraicGeometry.IsReduced M] (jY : Y ⟶ P) [IsClosedImmersion jY] (a : S ⟶ P) [IsOpenImmersion a] (μ : M ⟶ S) [IsClosedImmersion μ] (hr : Set.range (μ ≫ a) = Set.range a ∩ Set.range jY) (U : Set P) (O : Y.Opens) (E : M.Opens) (hO : ∀ x : Y, x ∈ O ↔ jY x ∈ Set.range a ∧ jY x ∈ U) (hE : ∀ y : M, y ∈ E ↔ (μ ≫ a) y ∈ U), Nonempty ((O : Scheme.{u}) ≅ (E : Scheme.{u})) := by
    intro Y P S M _ _ jY _ a _ μ _ hr U O E hO hE
    have e1 : ∀ (W X Y : Scheme.{u}) (g : W ⟶ Y) (z : X ⟶ Y) [IsClosedImmersion z] [IsReduced W], Set.range g ⊆ Set.range z → ∃ g' : W ⟶ X, g' ≫ z = g := by
      intro W X Y g z _ _ hrange
      have H : z.ker ≤ g.ker := by
        show z.ker ≤ Scheme.IdealSheafData.ofIdeals (fun U : Y.affineOpens => RingHom.ker (g.app U).hom)
        rw [Scheme.IdealSheafData.le_ofIdeals_iff]
        intro U s hs
        have hz : (z.app U).hom s = 0 :=
          Scheme.IdealSheafData.ideal_ofIdeals_le
            (I := fun U : Y.affineOpens => RingHom.ker (z.app U).hom) U hs
        have hX : z ⁻¹ᵁ Y.basicOpen s = ⊥ := by
          rw [Scheme.Hom.preimage_basicOpen]
          erw [hz]
          exact Scheme.basicOpen_zero _ _
        have hW : W.basicOpen ((g.app U).hom s) = ⊥ := by
          rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
          intro w hw
          obtain ⟨x, hx⟩ := hrange ⟨w, rfl⟩
          have hx' : x ∈ z ⁻¹ᵁ Y.basicOpen s := by
            show z x ∈ Y.basicOpen s
            rw [hx]; exact hw
          rw [hX] at hx'
          exact hx'.elim
        exact eq_zero_of_basicOpen_eq_bot _ hW
      exact ⟨IsClosedImmersion.lift z g H, IsClosedImmersion.lift_fac z g H⟩
    have hOmem : ∀ x : (O : Scheme.{u}), O.ι x ∈ O := fun x => by
      have : O.ι x ∈ Set.range O.ι := ⟨x, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have hEmem : ∀ y : (E : Scheme.{u}), E.ι y ∈ E := fun y => by
      have : E.ι y ∈ Set.range E.ι := ⟨y, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have h1 : Set.range (O.ι ≫ jY) ⊆ Set.range a := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact ((hO (O.ι x)).mp (hOmem x)).1
    let h := IsOpenImmersion.lift a (O.ι ≫ jY) h1
    have hh : h ≫ a = O.ι ≫ jY := IsOpenImmersion.lift_fac _ _ _
    have h2 : Set.range h ⊆ Set.range μ := by
      rintro _ ⟨x, rfl⟩
      have hx : a (h x) ∈ Set.range (μ ≫ a) := by
        rw [hr]
        refine ⟨⟨h x, rfl⟩, ⟨O.ι x, ?_⟩⟩
        rw [← Scheme.Hom.comp_apply, ← hh, Scheme.Hom.comp_apply]
      obtain ⟨m', hm'⟩ := hx
      exact ⟨m', a.isOpenEmbedding.injective (by rw [← Scheme.Hom.comp_apply]; exact hm')⟩
    obtain ⟨g, hg⟩ := e1 _ _ _ h μ h2
    have h3 : Set.range g ⊆ Set.range E.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      rw [SetLike.mem_coe, hE]
      have e : (μ ≫ a) (g x) = jY (O.ι x) := by
        rw [← Scheme.Hom.comp_apply, ← Category.assoc, hg, hh, Scheme.Hom.comp_apply]
      rw [e]
      exact ((hO (O.ι x)).mp (hOmem x)).2
    let g' := IsOpenImmersion.lift E.ι g h3
    have hg' : g' ≫ E.ι = g := IsOpenImmersion.lift_fac _ _ _
    have h4 : Set.range (E.ι ≫ μ ≫ a) ⊆ Set.range jY := by
      rintro _ ⟨y, rfl⟩
      have : (E.ι ≫ μ ≫ a) y ∈ Set.range (μ ≫ a) := ⟨E.ι y, rfl⟩
      rw [hr] at this
      exact this.2
    obtain ⟨f, hf⟩ := e1 _ _ _ (E.ι ≫ μ ≫ a) jY h4
    have h5 : Set.range f ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      rw [SetLike.mem_coe, hO]
      have e : jY (f y) = (μ ≫ a) (E.ι y) := by
        rw [← Scheme.Hom.comp_apply, hf, Scheme.Hom.comp_apply]
      rw [e]
      refine ⟨?_, (hE (E.ι y)).mp (hEmem y)⟩
      have : (μ ≫ a) (E.ι y) ∈ Set.range (μ ≫ a) := ⟨E.ι y, rfl⟩
      rw [hr] at this
      exact this.1
    let f' := IsOpenImmersion.lift O.ι f h5
    have hf' : f' ≫ O.ι = f := IsOpenImmersion.lift_fac _ _ _
    refine ⟨⟨g', f', ?_, ?_⟩⟩
    · rw [← cancel_mono (O.ι ≫ jY)]
      rw [Category.id_comp, Category.assoc, ← Category.assoc f', hf', hf, ← Category.assoc,
        ← Category.assoc, hg', Category.assoc, ← Category.assoc g, hg, hh]
    · rw [← cancel_mono (E.ι ≫ μ ≫ a)]
      rw [Category.id_comp, Category.assoc, ← Category.assoc g', hg', ← Category.assoc g, hg,
        ← Category.assoc, Category.assoc, hh, ← Category.assoc, hf', hf]

  have L4 : ∀ (K A : Type u) [CommRing K] [CommRing A] (ι : K →+* A) (N n' : ℕ) (t : Fin N → A) (c u : Fin N) (τ : Fin N → MvPolynomial (Fin n') K) (s : Fin n' → Fin N) (ψ : A →+* MvPolynomial (Fin n') K) (hgen : ∀ z : A, ∃ F : MvPolynomial (Fin N) K, MvPolynomial.eval₂ ι t F = z) (htc : t c = 1) (hψι : ∀ a : K, ψ (ι a) = MvPolynomial.C a) (hψt : ∀ j : Fin N, ψ (t j) = τ j) (hτs : ∀ b : Fin n', τ (s b) = MvPolynomial.X b) (hcov : ∀ j : Fin N, j ≠ c → j ≠ u → ∃ b : Fin n', s b = j), Function.Surjective ψ ∧ RingHom.ker ψ = Ideal.span {t u - MvPolynomial.eval₂ ι (fun b => t (s b)) (τ u)} := by
    intro K A _ _ ι N n' t c u τ s ψ hgen htc hψι hψt hτs hcov
    set σ : MvPolynomial (Fin n') K →+* A := MvPolynomial.eval₂Hom ι (fun b => t (s b)) with hσ
    have hψσ : ψ.comp σ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, hσ, MvPolynomial.eval₂Hom_C, hψι, RingHom.id_apply]
      · intro b
        rw [RingHom.comp_apply, hσ, MvPolynomial.eval₂Hom_X', hψt, hτs, RingHom.id_apply]
    have hψσ' : ∀ p, ψ (σ p) = p := fun p => RingHom.congr_fun hψσ p
    refine ⟨fun p => ⟨σ p, hψσ' p⟩, ?_⟩
    have hw : t u - MvPolynomial.eval₂ ι (fun b => t (s b)) (τ u) = t u - σ (τ u) := rfl
    rw [hw]
    have key : ∀ z : A, z - σ (ψ z) ∈ Ideal.span {t u - σ (τ u)} := by
      intro z
      obtain ⟨F, rfl⟩ := hgen z
      induction F using MvPolynomial.induction_on with
      | C a =>
        rw [MvPolynomial.eval₂_C, hψι, hσ, MvPolynomial.eval₂Hom_C, sub_self]
        exact zero_mem _
      | add p q hp hq =>
        rw [MvPolynomial.eval₂_add, map_add, map_add]
        have : MvPolynomial.eval₂ ι t p + MvPolynomial.eval₂ ι t q -
            (σ (ψ (MvPolynomial.eval₂ ι t p)) + σ (ψ (MvPolynomial.eval₂ ι t q))) =
            (MvPolynomial.eval₂ ι t p - σ (ψ (MvPolynomial.eval₂ ι t p))) +
            (MvPolynomial.eval₂ ι t q - σ (ψ (MvPolynomial.eval₂ ι t q))) := by ring
        rw [this]
        exact Ideal.add_mem _ hp hq
      | mul_X p j hp =>
        rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
        have hj : t j - σ (ψ (t j)) ∈ Ideal.span {t u - σ (τ u)} := by
          by_cases hjc : j = c
          · rw [hjc, htc, map_one, map_one, sub_self]
            exact zero_mem _
          by_cases hju : j = u
          · rw [hju, hψt]
            exact Ideal.subset_span rfl
          obtain ⟨b, rfl⟩ := hcov j hjc hju
          rw [hψt, hτs, hσ, MvPolynomial.eval₂Hom_X', sub_self]
          exact zero_mem _
        have : MvPolynomial.eval₂ ι t p * t j - σ (ψ (MvPolynomial.eval₂ ι t p * t j)) =
            (MvPolynomial.eval₂ ι t p - σ (ψ (MvPolynomial.eval₂ ι t p))) * t j +
            σ (ψ (MvPolynomial.eval₂ ι t p)) * (t j - σ (ψ (t j))) := by
          rw [map_mul, map_mul]; ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ hj)
    apply le_antisymm
    · intro z hz
      have := key z
      rwa [RingHom.mem_ker.mp hz, map_zero, sub_zero] at this
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        map_sub, hψσ', hψt, sub_self]

  have L2 : ∀ (K : Type u) [Field K] (N : ℕ) (c : Fin (N + 1)) (R : Type u) [CommRing R] [Algebra K R] (τ : Fin (N + 1) → R) (hτ : τ c = 1), letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)); ∃ ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c) →+* R, (∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K) (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)), ψ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) n F hF) = MvPolynomial.aeval τ F) ∧ ∀ a : K, ψ (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X c)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) a)) = algebraMap K R a := by
    intro K _ N c R _ _ τ hτ
    letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
    set ρt : MvPolynomial (Fin (N + 1)) K →+* R := (MvPolynomial.aeval τ).toRingHom with hρt
    have hρc : ρt (MvPolynomial.X c) = 1 := by
      rw [hρt, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X, hτ]
    have hu : IsUnit (ρt (MvPolynomial.X c)) := by rw [hρc]; exact isUnit_one
    refine ⟨(IsLocalization.Away.lift (MvPolynomial.X c) hu :
        Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K) →+* R).comp
        (algebraMap _ _), ?_, ?_⟩
    · intro n F hF
      rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      have hs := IsLocalization.mk'_spec
        (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) F
        (⟨MvPolynomial.X c ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
          Submonoid.powers (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))
      rw [← Localization.mk_eq_mk'_apply] at hs
      have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X c) hu :
