      rw [← RingHom.mem_ker, hker]
      exact Ideal.subset_span rfl
    have hback : ∀ q : Spec (.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c))), HomogeneousLocalization.Away.isLocalizationElem hc G.2 ∈ q.asIdeal → ∃ y : Spec (.of R), Spec.map (CommRingCat.ofHom ψ) y = q := by
      intro q hq
      have hz : (q : PrimeSpectrum (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c))) ∈ PrimeSpectrum.zeroLocus ((RingHom.ker ψ : Ideal (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c))) : Set (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c))) := by
