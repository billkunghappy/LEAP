    intro g
    have hlin := map_nsmul (Abelian.Ext.bilinearComp (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ e)))
      (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ e))) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ e)))
      (2 * N) 0 (2 * N) (add_zero _) g) (ℓ ^ e)
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ e)))))
