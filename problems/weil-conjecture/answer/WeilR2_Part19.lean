theorem wc_qxs_odd_removed_plane : ∀ (Ω : Type u) [Field Ω] (e : ℕ) (Y : Scheme.{u}) (jY : Y ⟶ wcProjK Ω (2 * e + 2)), IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) → ∃ (Z : Scheme.{u}) (i : Z ⟶ Y), IsClosedImmersion i ∧ SmoothOfRelativeDimension e (i ≫ jY ≫ wcProjKStr Ω (2 * e + 2)) ∧ Set.range i = ((⨆ (k : ℕ) (_ : k ≤ e), jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩ : Y.Opens) : Set Y)ᶜ :=
by
  classical
  intro Ω _ e Y jY hjY hY
  haveI := hjY

  have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
      (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
      IsClosedImmersion (Proj.map f hf) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
      (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
    intro i
    have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
    let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
    let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
    let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
    have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
    have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
      simp only [iV, iU, Proj.opensRange_awayι]
      exact Proj.map_preimage_basicOpen f hf (s i)
    have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
    have hg : IsClosedImmersion g :=
      IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
    have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
          (by
            dsimp only [Arrow.mk_hom, Iso.refl_hom]
            rw [Category.comp_id]
            exact IsPullback.isoPullback_hom_snd _))).mp hg
    have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictOpensRange _ iV)).mpr h1
    exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
      (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2
  have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
      ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
    obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
    obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
    exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩
  have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) Ω),
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) Ω) ↔
        p.coeff 0 = 0 := by
    intro n p
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    erw [MvPolynomial.decomposition.decompose'_apply]
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
  letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
    MvPolynomial.gradedAlgebra

  let g : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (e + 1)) Ω := fun t =>
    if h : t.val % 2 = 0 ∧ t.val / 2 < e + 1 then MvPolynomial.X ⟨t.val / 2, h.2⟩ else 0
  let c : Fin (e + 1) → Fin (2 * e + 2 + 1) := fun j => ⟨2 * j.val, by have := j.isLt; omega⟩
  have hg : ∀ t, (g t).IsHomogeneous 1 := by
    intro t
    dsimp only [g]
    split_ifs
    · exact MvPolynomial.isHomogeneous_X Ω _
    · exact MvPolynomial.isHomogeneous_zero _ _ 1
  have hgc : ∀ j, g (c j) = MvPolynomial.X j := by
    intro j
    have h : (c j).val % 2 = 0 ∧ (c j).val / 2 < e + 1 := by
      show 2 * j.val % 2 = 0 ∧ 2 * j.val / 2 < e + 1
      have := j.isLt; omega
    dsimp only [g]
    rw [dif_pos h]
    congr 1
    exact Fin.ext (by show 2 * j.val / 2 = j.val; omega)
  have hX0 : ∀ t, g t = 0 ↔ ¬ (t.val % 2 = 0 ∧ t.val / 2 < e + 1) := by
    intro t
    by_cases h : t.val % 2 = 0 ∧ t.val / 2 < e + 1
    · have h' : g t = MvPolynomial.X ⟨t.val / 2, h.2⟩ := by dsimp only [g]; rw [dif_pos h]
      rw [h']
      exact iff_of_false (MvPolynomial.X_ne_zero _) (not_not.mpr h)
    · have h' : g t = 0 := by dsimp only [g]; rw [dif_neg h]
      exact iff_of_true h' h
  have hsurjc : ∀ t, g t ≠ 0 → ∃ j, c j = t := by
    intro t ht
    have h : t.val % 2 = 0 ∧ t.val / 2 < e + 1 := by
      by_contra h
      exact ht ((hX0 t).mpr h)
    exact ⟨⟨t.val / 2, h.2⟩, Fin.ext (by show 2 * (t.val / 2) = t.val; omega)⟩
  have hT : ∀ t : Fin (2 * e + 2 + 1), g t = 0 ↔ (t.val % 2 = 1 ∨ t.val = 2 * e + 2) := by
    intro t
    rw [hX0]
    have := t.isLt
    omega

  let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
    ⟨(MvPolynomial.aeval g).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      have := hx.aeval g hg
      rw [one_mul] at this
      exact this⟩
  let ψ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    ⟨(MvPolynomial.rename c).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      exact hx.rename_isHomogeneous⟩
  have hφ : ∀ a, φ a = MvPolynomial.aeval g a := fun a => rfl
  have hψ : ∀ b, ψ b = MvPolynomial.rename c b := fun b => rfl
  have hφψ : ∀ b, φ (ψ b) = b := by
    intro b
    rw [hφ, hψ, MvPolynomial.aeval_rename]
    have hgc' : g ∘ c = MvPolynomial.X := funext hgc
    rw [hgc', MvPolynomial.aeval_X_left_apply]
  have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) ≤
      HomogeneousIdeal.map φ
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)) := by
    intro b hb
    have hb0 : b.coeff 0 = 0 := (s1 (e + 1) b).mp hb
    have hψb : ψ b ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) := by
      apply (s1 (2 * e + 2 + 1) (ψ b)).mpr
      rw [hψ]
      rw [← MvPolynomial.constantCoeff_eq] at hb0 ⊢
      exact (MvPolynomial.constantCoeff_rename c b).trans hb0
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map, ← hφψ b]
    exact Ideal.mem_map_of_mem φ (HomogeneousIdeal.mem_iff.mpr hψb)
  have hdeg : ∀ (n : ℕ) (b : MvPolynomial (Fin (e + 1)) Ω),
      b ∈ MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω n →
      ∃ a ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω n, φ a = b :=
    fun n b hb => ⟨ψ b, ψ.map_mem hb, hφψ b⟩
  have hcov : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) := by
    intro x hx
    have hx0 : x.coeff 0 = 0 := (s1 (2 * e + 2 + 1) x).mp (HomogeneousIdeal.mem_iff.mp hx)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  have hX : ∀ i : Fin (2 * e + 2 + 1),
      (MvPolynomial.X i : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X Ω i)

  let L : wcProjK Ω e ⟶ wcProjK Ω (2 * e + 2) := Proj.map φ hf
  have hLci : IsClosedImmersion L := s4 φ hf (fun i : Fin (2 * e + 2 + 1) => MvPolynomial.X i)
    (fun _ => 1) hX (fun _ => Nat.one_pos) hcov (fun i => s3 φ hdeg _ 1 (hX i))
  haveI := hLci
  have hpre : ∀ a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      L ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) a =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) (φ a) :=
    fun a => Proj.map_preimage_basicOpen φ hf a

  let f₀ : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) →+*
      ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω 0) :=
    { toFun := fun a => ⟨φ a, φ.map_mem a.2⟩
      map_one' := Subtype.ext (by
        show φ ((1 : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one])
      map_mul' := fun a b => Subtype.ext (by
        show φ ((a * b : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_mul, SetLike.GradeZero.coe_mul, map_mul])
      map_zero' := Subtype.ext (by
        show φ ((0 : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [ZeroMemClass.coe_zero, ZeroMemClass.coe_zero, map_zero])
      map_add' := fun a b => Subtype.ext (by
        show φ ((a + b : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [AddMemClass.coe_add, AddMemClass.coe_add, map_add]) }
  have hLstr : L ≫ wcProjKStr Ω (2 * e + 2) = wcProjKStr Ω e := by
    have hb := wc_bc_proj_map_toSpecZero φ hf f₀ (fun a => rfl)
    have hcomp : f₀.comp (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) =
        algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω 0) := by
      apply RingHom.ext
      intro r
      apply Subtype.ext
      show φ ((algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) r :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) = _
      rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ]
      exact (MvPolynomial.aeval g).commutes r
    show L ≫ (Proj.toSpecZero _ ≫ Spec.map _) = Proj.toSpecZero _ ≫ Spec.map _
    rw [← Category.assoc, hb, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]

  have hret : ∀ a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      a - ψ (φ a) ∈ Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}) := by
    intro a
    have key : (Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}))).comp
        ((MvPolynomial.rename c).comp (MvPolynomial.aeval g)) =
        Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0})) := by
      apply MvPolynomial.algHom_ext
      intro t
      rw [AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.aeval_X]
      by_cases ht : g t = 0
      · rw [ht, map_zero, map_zero, Ideal.Quotient.mkₐ_eq_mk, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨t, ht, rfl⟩
      · obtain ⟨j, rfl⟩ := hsurjc t ht
        rw [hgc, MvPolynomial.rename_X]
    have h2 := congrArg (fun F => F a) key
    simp only [AlgHom.comp_apply] at h2
    rw [Ideal.Quotient.mkₐ_eq_mk] at h2
    rw [hφ, hψ]
    exact Ideal.Quotient.eq.mp h2.symm

  have hrange : ∀ p : wcProjK Ω (2 * e + 2), p ∈ Set.range L ↔
      ∀ t, g t = 0 → (MvPolynomial.X t : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈ p.asHomogeneousIdeal := by
    intro p
    constructor
    · rintro ⟨z, rfl⟩ t ht
      by_contra hn
      have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          (MvPolynomial.X t) := (Proj.mem_basicOpen _ _ _).mpr hn
      have h2 := (Scheme.Hom.mem_preimage L).mpr h1
      rw [hpre, hφ, MvPolynomial.aeval_X, ht, Proj.basicOpen_zero] at h2
      exact TopologicalSpace.Opens.mem_bot.mp h2
    · intro H
      haveI hpr : p.asHomogeneousIdeal.toIdeal.IsPrime := p.isPrime
      have hK : Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}) ≤
          p.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨t, ht, rfl⟩
        exact H t ht
      obtain ⟨i, hi⟩ : ∃ i : Fin (2 * e + 2 + 1),
          (MvPolynomial.X i : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∉ p.asHomogeneousIdeal.toIdeal := by
        by_contra hno
        push_neg at hno
        apply ProjectiveSpectrum.not_irrelevant_le p
        intro x hx
        have h3 := hcov (HomogeneousIdeal.mem_iff.mpr hx)
        have hle : Ideal.span (Set.range (MvPolynomial.X : Fin (2 * e + 2 + 1) →
            MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) ≤ p.asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          exact hno j
        exact HomogeneousIdeal.mem_iff.mp (hle h3)
      have hgi : g i ≠ 0 := fun h0 => hi (hK (Ideal.subset_span ⟨i, h0, rfl⟩))
      obtain ⟨j, rfl⟩ := hsurjc i hgi
      let q := HomogeneousIdeal.comap ψ p.asHomogeneousIdeal
      have hq : q.toIdeal = Ideal.comap ψ p.asHomogeneousIdeal.toIdeal :=
        HomogeneousIdeal.toIdeal_comap ψ
      haveI hqp : q.toIdeal.IsPrime := by rw [hq]; exact Ideal.comap_isPrime ψ _
      have hqrel : ¬ HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) ≤ q := by
        intro hle
        have hXj : (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) Ω) ∈ HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
          (s1 (e + 1) _).mpr (MvPolynomial.coeff_zero_X j)
        have h1 : (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) Ω) ∈ q.toIdeal :=
          HomogeneousIdeal.mem_iff.mpr (hle hXj)
        rw [hq, Ideal.mem_comap, hψ, MvPolynomial.rename_X] at h1
        exact hi h1
      let z : (wcProjK Ω e : Scheme.{u}) :=
        (⟨q, hqp, hqrel⟩ : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω))
      refine ⟨z, ?_⟩
      apply ProjectiveSpectrum.ext
      apply HomogeneousIdeal.ext
      ext a
      have e1 : a ∈ (L z).asHomogeneousIdeal ↔ φ a ∈ z.asHomogeneousIdeal := by
        have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) a ↔
            z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) (φ a) := by
          rw [← hpre a]
          exact (Scheme.Hom.mem_preimage L).symm
        rw [Proj.mem_basicOpen, Proj.mem_basicOpen] at h1
        exact not_iff_not.mp h1
      rw [HomogeneousIdeal.mem_iff, e1]
      show φ a ∈ q ↔ _
      rw [← HomogeneousIdeal.mem_iff, hq, Ideal.mem_comap]
      have hd := hK (hret a)
      constructor
      · intro h
        have h4 := Ideal.add_mem _ hd h
        rwa [sub_add_cancel] at h4
      · intro h
        have h4 := Ideal.sub_mem _ h hd
        rwa [sub_sub_cancel] at h4

  obtain ⟨G, hGdef⟩ : ∃ G : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      G = (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) :=
    ⟨_, rfl⟩
  have hHp : MvPolynomial.aeval g G = 0 := by
    rw [hGdef]
    show MvPolynomial.aeval g (∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
      MvPolynomial.C (wcXspSplitCoeff Ω e p q) * (MvPolynomial.X p * MvPolynomial.X q)) = 0
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro p _
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro q _
    rw [map_mul, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
    unfold wcXspSplitCoeff
    by_cases h1 : p.val % 2 = 0 ∧ q.val = p.val + 1 ∧ p.val < 2 * e + 2
    · have h0 : g q = 0 := (hX0 q).mpr (by omega)
      rw [h0, mul_zero, mul_zero]
    · by_cases h2 : p.val = 2 * e + 2 ∧ q.val = 2 * e + 2
      · have h0 : g p = 0 := (hX0 p).mpr (by omega)
        rw [h0, zero_mul, mul_zero]
      · rw [if_neg h1, if_neg h2, map_zero, zero_mul]
  have hsub : Set.range L ⊆ Set.range jY := by
    rintro _ ⟨z, rfl⟩
    rw [hY]
    simp only [wcXspVplus, Set.mem_setOf_eq, Proj.mem_basicOpen, not_not]
    rw [← hGdef]
    by_contra hn
    have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) G :=
      (Proj.mem_basicOpen _ _ _).mpr hn
    have h2 := (Scheme.Hom.mem_preimage L).mpr h1
    rw [hpre, hφ, hHp, Proj.basicOpen_zero] at h2
    exact TopologicalSpace.Opens.mem_bot.mp h2

  haveI hsm : SmoothOfRelativeDimension e (wcProjKStr Ω e) := wc_proj_space_smooth Ω e
  haveI : ∀ x : wcProjK Ω e, _root_.IsReduced ((wcProjK Ω e).presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain Ω (wcProjK Ω e) (wcProjKStr Ω e) e x
    infer_instance
  haveI : IsReduced (wcProjK Ω e) := isReduced_of_isReduced_stalk _

  obtain ⟨i, hi⟩ := wc_ap_reduced_factor_closed_immersion _ _ _ L jY hsub
  have hici : IsClosedImmersion i := by
    haveI : IsClosedImmersion (i ≫ jY) := by rw [hi]; exact hLci
    exact IsClosedImmersion.of_comp i jY
  refine ⟨wcProjK Ω e, i, hici, ?_, ?_⟩
  · rw [← Category.assoc, hi, hLstr]
    exact hsm
  · ext x
    have hinj : Function.Injective jY := jY.isClosedEmbedding.isEmbedding.injective
    have e1 : x ∈ Set.range i ↔ jY x ∈ Set.range L := by
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨y, by rw [← hi, Scheme.Hom.comp_apply]⟩
      · rintro ⟨y, hy⟩
        refine ⟨y, hinj ?_⟩
        rw [← Scheme.Hom.comp_apply, hi, hy]
    rw [e1, hrange, Set.mem_compl_iff, SetLike.mem_coe]
    constructor
    · intro H hmem
      obtain ⟨k, hmem⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
      obtain ⟨hk, hmem⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
      have h1 := (Proj.mem_basicOpen _ _ _).mp ((Scheme.Hom.mem_preimage jY).mp hmem)
      have hodd : (if k ≤ e then 2 * k + 1 else 2 * e + 1) % 2 = 1 := by
        split_ifs <;> omega
      exact h1 (H _ ((hT _).mpr (Or.inl hodd)))
    · intro H t ht
      have hoddP : ∀ s : Fin (2 * e + 2 + 1), s.val % 2 = 1 →
          (MvPolynomial.X s : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
            (jY x).asHomogeneousIdeal := by
        intro s hs
        have hsl := s.isLt
        have hk : s.val / 2 ≤ e := by omega
        have hs' : s = ⟨if s.val / 2 ≤ e then 2 * (s.val / 2) + 1 else 2 * e + 1,
            by split_ifs <;> omega⟩ := by
          apply Fin.ext
          show s.val = if s.val / 2 ≤ e then 2 * (s.val / 2) + 1 else 2 * e + 1
          rw [if_pos hk]
          omega
        by_contra hn
        apply H
        rw [hs'] at hn
        refine TopologicalSpace.Opens.mem_iSup.mpr ⟨s.val / 2,
          TopologicalSpace.Opens.mem_iSup.mpr ⟨hk, ?_⟩⟩
        exact (Scheme.Hom.mem_preimage jY).mpr ((Proj.mem_basicOpen _ _ _).mpr hn)
      rcases (hT t).mp ht with hto | htl
      · exact hoddP t hto
      · have htlast : t = Fin.last (2 * e + 2) := Fin.ext (by rw [htl, Fin.val_last])
        rw [htlast]
        set P := (jY x).asHomogeneousIdeal with hPdef
        haveI hpr : P.toIdeal.IsPrime := (jY x).isPrime
        have hG : G ∈ P.toIdeal := by
          have h : jY x ∈ Set.range jY := ⟨x, rfl⟩
          rw [hY] at h
          simp only [wcXspVplus, Set.mem_setOf_eq, Proj.mem_basicOpen, not_not] at h
          rw [hGdef]
          exact h
        have hsumite : ∀ cc : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
            ∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
              (if p.val = 2 * e + 2 then (if q.val = 2 * e + 2 then cc else 0) else 0) = cc := by
          intro cc
          have h1 : ∀ p : Fin (2 * e + 2 + 1), p ≠ Fin.last (2 * e + 2) → p.val ≠ 2 * e + 2 := by
            intro p hp h
            exact hp (Fin.ext (by rw [h, Fin.val_last]))
          rw [Fintype.sum_eq_single (Fin.last (2 * e + 2))]
          · simp only [Fin.val_last, if_true]
            rw [Fintype.sum_eq_single (Fin.last (2 * e + 2))]
            · simp only [Fin.val_last, if_true]
            · intro q hq
              rw [if_neg (h1 q hq)]
          · intro p hp
            simp only [if_neg (h1 p hp), Finset.sum_const_zero]
        have hterm : ∀ a b : Fin (2 * e + 2 + 1),
            MvPolynomial.C (wcXspSplitCoeff Ω e a b) * (MvPolynomial.X a * MvPolynomial.X b) -
              (if a.val = 2 * e + 2 then (if b.val = 2 * e + 2 then
                -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) else 0)
                else 0) ∈ P.toIdeal := by
          intro a b
          unfold wcXspSplitCoeff
          by_cases h1 : a.val % 2 = 0 ∧ b.val = a.val + 1 ∧ a.val < 2 * e + 2
          · rw [if_pos h1, if_neg (by omega), sub_zero]
            exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hoddP b (by omega)))
          · rw [if_neg h1]
            by_cases h2 : a.val = 2 * e + 2 ∧ b.val = 2 * e + 2
            · have ha : a = Fin.last (2 * e + 2) := Fin.ext (by rw [h2.1, Fin.val_last])
              have hb : b = Fin.last (2 * e + 2) := Fin.ext (by rw [h2.2, Fin.val_last])
              rw [if_pos h2, if_pos h2.1, if_pos h2.2, ha, hb]
              have h0 : MvPolynomial.C (-1 : Ω) * (MvPolynomial.X (Fin.last (2 * e + 2)) *
                  MvPolynomial.X (Fin.last (2 * e + 2))) -
                  -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) :
                    MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = 0 := by
                rw [map_neg, map_one]; ring
              rw [h0]
              exact zero_mem _
            · rw [if_neg h2, map_zero, zero_mul, zero_sub]
              by_cases h3 : a.val = 2 * e + 2
              · rw [if_pos h3, if_neg (by omega), neg_zero]
                exact zero_mem _
              · rw [if_neg h3, neg_zero]
                exact zero_mem _
        have hsum : G -
            -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) ∈
              P.toIdeal := by
          have hmem := Ideal.sum_mem P.toIdeal
            (t := Finset.univ) (fun a _ => Ideal.sum_mem P.toIdeal
              (t := Finset.univ) (fun b _ => hterm a b))
          simp only [Finset.sum_sub_distrib] at hmem
          rw [hsumite] at hmem
          rw [hGdef]
          exact hmem
        have hsq : MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) ∈
            P.toIdeal := by
          have h := Ideal.sub_mem _ hsum hG
          have e2 : G -
              -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) - G =
              MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) := by ring
          rw [e2] at h
          exact h
        rcases hpr.mem_or_mem hsq with h | h <;> exact h

theorem wc_qxs_split_odd_quadric_vanish : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ),
    ℓ.Prime → (ℓ : Ω) ≠ 0 →
    ∀ (e : ℕ) (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y]
      (jY : Y ⟶ wcProjK Ω (2 * e + 2)),
    IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) →
    Subsingleton (wcEtCoh Y ℓ (2 * e + 1)) :=
by
  classical
  intro Ω _ _ ℓ hℓp hℓ e Y _ jY hjY hY
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓp⟩
  haveI := hjY
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra

  have hsumite : ∀ c : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      ∑ p : Fin (2 * e + 2 + 1), ∑ q : Fin (2 * e + 2 + 1),
        (if p.val = 2 * e + 2 then (if q.val = 2 * e + 2 then c else 0) else 0) = c := by
    intro c
    have h1 : ∀ p : Fin (2 * e + 2 + 1), p ≠ Fin.last (2 * e + 2) → p.val ≠ 2 * e + 2 := by
      intro p hp h
      exact hp (Fin.ext (by rw [h, Fin.val_last]))
    rw [Fintype.sum_eq_single (Fin.last (2 * e + 2))]
    · simp only [Fin.val_last, if_true]
      rw [Fintype.sum_eq_single (Fin.last (2 * e + 2))]
      · simp only [Fin.val_last, if_true]
      · intro q hq
        rw [if_neg (h1 q hq)]
    · intro p hp
      simp only [if_neg (h1 p hp), Finset.sum_const_zero]
  have hcover : ∀ p : wcProjK Ω (2 * e + 2),
      p ∈ wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) →
      ∃ c : Fin (2 * e + 2 + 1), c.val ≤ 2 * e + 1 ∧ p ∈ wcSgD Ω (2 * e + 2) c := by
    intro p hp
    by_contra hno
    push_neg at hno
    have hodd : ∀ i : Fin (2 * e + 2 + 1), i.val ≤ 2 * e + 1 →
        MvPolynomial.X i ∈ p.asHomogeneousIdeal.toIdeal := by
      intro i hi
      have h8 := hno i hi
      rw [Proj.mem_basicOpen, not_not] at h8
      exact h8
    have hG : ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) ∈ p.asHomogeneousIdeal.toIdeal := by
      have h := hp
      simp only [wcXspVplus, Set.mem_setOf_eq, Proj.mem_basicOpen, not_not] at h
      exact h
    have hterm : ∀ a b : Fin (2 * e + 2 + 1),
        MvPolynomial.C (wcXspSplitCoeff Ω e a b) * (MvPolynomial.X a * MvPolynomial.X b) -
          (if a.val = 2 * e + 2 then (if b.val = 2 * e + 2 then
            -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) else 0)
            else 0) ∈ p.asHomogeneousIdeal.toIdeal := by
      intro a b
      unfold wcXspSplitCoeff
      by_cases h1 : a.val % 2 = 0 ∧ b.val = a.val + 1 ∧ a.val < 2 * e + 2
      · rw [if_pos h1, if_neg (by omega), sub_zero]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hodd b (by omega)))
      · rw [if_neg h1]
        by_cases h2 : a.val = 2 * e + 2 ∧ b.val = 2 * e + 2
        · have ha : a = Fin.last (2 * e + 2) := Fin.ext (by rw [h2.1, Fin.val_last])
          have hb : b = Fin.last (2 * e + 2) := Fin.ext (by rw [h2.2, Fin.val_last])
          rw [if_pos h2, if_pos h2.1, if_pos h2.2, ha, hb]
          have h0 : MvPolynomial.C (-1 : Ω) * (MvPolynomial.X (Fin.last (2 * e + 2)) *
              MvPolynomial.X (Fin.last (2 * e + 2))) -
              -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) :
                MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = 0 := by
            rw [map_neg, map_one]; ring
          rw [h0]
          exact zero_mem _
        · rw [if_neg h2, map_zero, zero_mul, zero_sub]
          by_cases h3 : a.val = 2 * e + 2
          · rw [if_pos h3, if_neg (by omega), neg_zero]
            exact zero_mem _
          · rw [if_neg h3, neg_zero]
            exact zero_mem _
    have hsum : ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) -
        -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) ∈
          p.asHomogeneousIdeal.toIdeal := by
      have hmem := Ideal.sum_mem p.asHomogeneousIdeal.toIdeal
        (t := Finset.univ) (fun a _ => Ideal.sum_mem p.asHomogeneousIdeal.toIdeal
          (t := Finset.univ) (fun b _ => hterm a b))
      simp only [Finset.sum_sub_distrib] at hmem
      rw [hsumite] at hmem
      exact hmem
    have hsq : MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) ∈
        p.asHomogeneousIdeal.toIdeal := by
      have h := Ideal.sub_mem _ hsum hG
      have e1 : ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) -
          -(MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2))) -
          ((wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) =
          MvPolynomial.X (Fin.last (2 * e + 2)) * MvPolynomial.X (Fin.last (2 * e + 2)) := by ring
      rw [e1] at h
      exact h
    have hlast : MvPolynomial.X (Fin.last (2 * e + 2)) ∈ p.asHomogeneousIdeal.toIdeal := by
      rcases p.isPrime.mem_or_mem hsq with h | h <;> exact h
    have hall : ∀ i : Fin (2 * e + 2 + 1), MvPolynomial.X i ∈ p.asHomogeneousIdeal.toIdeal := by
      intro i
      by_cases hi : i.val ≤ 2 * e + 1
      · exact hodd i hi
      · have : i = Fin.last (2 * e + 2) := Fin.ext (by rw [Fin.val_last]; omega)
        rw [this]; exact hlast
    apply ProjectiveSpectrum.not_irrelevant_le p
    intro x hx
    have hx0 : x.coeff 0 = 0 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hx
      have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
          x 0 : MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) = MvPolynomial.homogeneousComponent 0 x :=
        MvPolynomial.decomposition.decompose'_apply x 0
      rw [h6, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hx
      exact hx
    have hspan : x ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (2 * e + 2 + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      rw [MvPolynomial.mem_support_iff] at hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact hm hx0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (2 * e + 2 + 1)))) ≤
        p.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le, Set.image_subset_iff]
      intro i _
      exact hall i
    exact hle hspan

  haveI hsm : SmoothOfRelativeDimension (2 * e + 1) (jY ≫ wcProjKStr Ω (2 * e + 2)) := by
    apply wc_ldp_il_smooth_local
    intro z
    obtain ⟨c, hc, hz⟩ := hcover (jY z) (by rw [← hY]; exact ⟨z, rfl⟩)
    refine ⟨jY ⁻¹ᵁ wcSgD Ω (2 * e + 2) c, hz, ?_⟩
    obtain ⟨φ, hφ⟩ := wc_qxs_odd_chart_affine_iso Ω e Y jY hjY hY c hc
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (2 * e + 1)) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    have h := IsZariskiLocalAtSource.comp (wc_mvpoly_spec_smoothOfRelDim Ω (2 * e + 1)) φ.hom
    rw [hφ] at h
    exact h

  let W : ℕ → Y.Opens := fun k => jY ⁻¹ᵁ wcSgD Ω (2 * e + 2)
    ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩
  have hW1 : ∀ k, k ≤ e → ∀ q, 1 ≤ q →
      Subsingleton (wcEtCoh (W k : Scheme.{u}) ℓ q) := by
    intro k _ q hq
    obtain ⟨φ, -⟩ := wc_qxs_odd_chart_affine_iso Ω e Y jY hjY hY
      ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩
      (by show (if k ≤ e then 2 * k + 1 else 2 * e + 1) ≤ 2 * e + 1; split_ifs <;> omega)
    obtain ⟨E⟩ := wc_et_coh_iso_invariance φ.inv ℓ q
    haveI := wc_et_affine_space_coh_vanishing Ω ℓ hℓp hℓ (2 * e + 1) q hq
    exact E.subsingleton
  have hW2 : ∀ k, 1 ≤ k → k ≤ e → ∀ q, 2 * e ≤ q →
      Subsingleton (wcEtCoh ((W k ⊓ ⨆ (i : ℕ) (_ : i < k), W i : Y.Opens) : Scheme.{u}) ℓ q) := by
    intro k hk1 hk q hq
    obtain ⟨E, hE, ⟨φ⟩⟩ := wc_qxs_odd_chart_overlap_iso Ω e Y jY hjY hY k hk1 hk
    obtain ⟨Eq⟩ := wc_et_coh_iso_invariance φ.inv ℓ q
    haveI := wc_et_affine_partial_punct_vanishing Ω ℓ hℓp hℓ (2 * e + 1) k (by omega) E hE q
      (by omega)
    exact Eq.subsingleton

  have hMV : ∀ n, n ≤ e → ∀ q, 2 * e + 1 ≤ q →
      Subsingleton (wcEtCoh ((⨆ (k : ℕ) (_ : k ≤ n), W k : Y.Opens) : Scheme.{u}) ℓ q) := by
    intro n
    induction n with
    | zero =>
      intro _ q hq
      have h0 : (⨆ (k : ℕ) (_ : k ≤ 0), W k) = W 0 := by
        apply le_antisymm
        · exact iSup₂_le (fun k hk => by rw [Nat.le_zero.mp hk])
        · exact le_iSup₂_of_le 0 le_rfl le_rfl
      rw [h0]
      exact hW1 0 (by omega) q (by omega)
    | succ n ih =>
      intro hn q hq
      obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
      have hsup : (⨆ (k : ℕ) (_ : k ≤ n), W k) ⊔ W (n + 1) = ⨆ (k : ℕ) (_ : k ≤ n + 1), W k := by
        apply le_antisymm
        · apply sup_le
          · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
          · exact le_iSup₂_of_le (n + 1) le_rfl le_rfl
        · apply iSup₂_le
          intro k hk
          rcases Nat.lt_or_ge k (n + 1) with h | h
          · exact le_sup_of_le_left (le_iSup₂_of_le k (by omega) le_rfl)
          · have hk' : k = n + 1 := by omega
            subst hk'; exact le_sup_right
      have hinf : (⨆ (k : ℕ) (_ : k ≤ n), W k) ⊓ W (n + 1) =
          W (n + 1) ⊓ ⨆ (i : ℕ) (_ : i < n + 1), W i := by
        rw [inf_comm]
        congr 1
        apply le_antisymm
        · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
        · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
      haveI h1 : Subsingleton (wcEtCoh (((⨆ (k : ℕ) (_ : k ≤ n), W k) ⊓ W (n + 1) : Y.Opens) :
          Scheme.{u}) ℓ q') := by
        rw [hinf]
        exact hW2 (n + 1) (by omega) hn q' (by omega)
      haveI h2 := ih (by omega) (q' + 1) hq
      haveI h3 := hW1 (n + 1) hn (q' + 1) (by omega)
      obtain ⟨hfin, hcard⟩ := wc_et_zariski_mv_card_le Y _ _ _ hsup ℓ q'
        Finite.of_subsingleton Finite.of_subsingleton Finite.of_subsingleton
      haveI := hfin
      have c1 := Finite.card_le_one_iff_subsingleton.mpr h1
      have c2 := Finite.card_le_one_iff_subsingleton.mpr h2
      have c3 := Finite.card_le_one_iff_subsingleton.mpr h3
      have hle : Nat.card (wcEtCoh ((⨆ (k : ℕ) (_ : k ≤ n + 1), W k : Y.Opens) : Scheme.{u}) ℓ
          (q' + 1)) ≤ 1 :=
        calc _ ≤ _ := hcard
          _ ≤ 1 * (1 * 1) := Nat.mul_le_mul c1 (Nat.mul_le_mul c2 c3)
          _ = 1 := rfl
      exact Finite.card_le_one_iff_subsingleton.mp hle

  obtain ⟨Z, i, hi, hism, hirange⟩ := wc_qxs_odd_removed_plane Ω e Y jY hjY hY
  haveI := hi
  haveI : SmoothOfRelativeDimension (2 * e + 1 - (e + 1)) (i ≫ jY ≫ wcProjKStr Ω (2 * e + 2)) := by
    have h : 2 * e + 1 - (e + 1) = e := by omega
    rw [h]; exact hism
  have hO : ((⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens) : Set Y) = (Set.range i)ᶜ := by
    rw [hirange, compl_compl]

  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i ℓ
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists (⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens).ι ℓ
  have hles := wc_et_supp_open_les i _ hO ℓ D Dj
  obtain ⟨eY⟩ := wc_et_zmodext_coh_equiv Y ℓ (2 * e + 1)
  obtain ⟨eO⟩ := wc_et_zmodext_coh_equiv
    ((⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens) : Scheme.{u}) ℓ (2 * e + 1)
  haveI := hMV e le_rfl (2 * e + 1) le_rfl
  haveI hOs : Subsingleton (wcEtZModExt
    ((⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens) : Scheme.{u}) ℓ (2 * e + 1)) := eO.subsingleton
  haveI : Subsingleton (wcEtZModExt Y ℓ (2 * e + 1)) := by
    constructor
    intro y₁ y₂
    obtain ⟨x₁, hx₁⟩ := (hles.1 (2 * e + 1) y₁).mp (Subsingleton.elim _ _)
    obtain ⟨x₂, hx₂⟩ := (hles.1 (2 * e + 1) y₂).mp (Subsingleton.elim _ _)
    have h12 : x₁ = x₂ :=
      (wc_et_supp_semipurity Ω Y Z (jY ≫ wcProjKStr Ω (2 * e + 2)) (2 * e + 1) (e + 1) i
        (by omega) ℓ hℓ D (2 * e + 1) (by omega) x₁).trans
        (wc_et_supp_semipurity Ω Y Z (jY ≫ wcProjKStr Ω (2 * e + 2)) (2 * e + 1) (e + 1) i
          (by omega) ℓ hℓ D (2 * e + 1) (by omega) x₂).symm
    subst h12
    exact hx₁.symm.trans hx₂
  exact eY.symm.subsingleton

theorem wc_qmbt_pn_xsp_HN_vanish {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∀ v : DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) ((n : ℤ) - 1)).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))) ⟶
        DerivedCategory.Q.obj ((HomologicalComplex.single
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) 0).obj
            (SheafOfModules.unit (wcRingSheaf Xs' ℓ))), v = 0 :=
by
  intro v
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))

  have key : ∀ (a : ℤ) (N : ℕ), a = (N : ℤ) →
      (∀ x : wcHM Xs' ℓ N, x = 0) →
      ∀ w : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) a).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ)) ⟶
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ)), w = 0 := by
    intro a N ha hx w
    subst ha
    let σ := ((DerivedCategory.singleFunctors (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso
      (N : ℤ) 0 (N : ℤ) (by simp)).app (SheafOfModules.unit (wcRingSheaf Xs' ℓ))
    let s : ShiftedHom
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ)))
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))) (N : ℤ) :=
      σ.inv ≫ (shiftFunctor _ (N : ℤ)).map w
    have hs0 : s = 0 := by
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) := HasExt.standard _
      have h0 : Abelian.Ext.homAddEquiv.symm s = 0 := hx (Abelian.Ext.homAddEquiv.symm s)
      have h1 : s = Abelian.Ext.homAddEquiv (Abelian.Ext.homAddEquiv.symm s) :=
        (AddEquiv.apply_symm_apply _ s).symm
      rw [h1, h0, map_zero]
    have h2 : (shiftFunctor _ (N : ℤ)).map w = 0 := by
      rw [← cancel_epi σ.inv, Limits.comp_zero]
      exact hs0
    exact (shiftFunctor _ (N : ℤ)).map_injective (h2.trans (Functor.map_zero _ _ _).symm)

  obtain ⟨f₀, hf₀def⟩ : ∃ g : Xs' ⟶ Spec (.of B₀), g = ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) := ⟨_, rfl⟩
  haveI hι' : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A'))
        IsLocalRing.residue_surjective)
  haveI : IsProper (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
