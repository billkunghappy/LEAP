theorem wc_et_smooth_divisor_top_gysin_injective_irred : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f], 1 ≤ N → ∀ (Z : Scheme.{u}) (ι : Z ⟶ Y) [IsClosedImmersion ι] [SmoothOfRelativeDimension (N - 1) (ι ≫ f)] [IrreducibleSpace Z] (m : ℕ), (m : K) ≠ 0 → ∀ (D : wcEtPullData ι m) (h : 2 * (N - 1) + 2 = 2 * N), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _; ∃ θ : wcEtSuppExt D 2, ∀ b : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) (wcEtSuppObj D) (2 * (N - 1)), b.comp θ h = 0 → b = 0 :=
