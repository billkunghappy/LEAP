    · intro n F hF
      rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      have hs := IsLocalization.mk'_spec
        (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) F
        (⟨MvPolynomial.X c ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
          Submonoid.powers (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))
      rw [← Localization.mk_eq_mk'_apply] at hs
      have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X c) hu :
        Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K) →+* R) hs
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
      simp only [map_pow, hρc, one_pow, mul_one] at hs2
      exact hs2
