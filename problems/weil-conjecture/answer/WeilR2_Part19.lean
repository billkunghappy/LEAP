    (hconn : IsPreconnected (Set.range i)ᶜ) :
    ∀ φ : Limits.kernel (wcSuppUnitMap E) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ),
      ∃ c : ℚ_[ℓ], φ = Limits.kernel.ι (wcSuppUnitMap E) ≫ wcHMConst S ℓ c :=
by
  classical

  have hsec : ∀ {A B : Scheme.{u}} {i : A ⟶ B} (D : wcHMPullData i ℓ),
      ∃ u : C(↥A, ULift.{u+1} ℚ_[ℓ]), IsUnit u ∧ ∀ W : B.ProEt,
        ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap D)).1 (Opposite.op W) :
            C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
    intro A B i D
    haveI := D.cont
    let T : B.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 B) (inferInstance : WeaklyEtale (𝟙 B))
    let σ := SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D)
    let v : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) := σ.1 (Opposite.op T)
    let u : C(↥A, ULift.{u+1} ℚ_[ℓ]) := v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom
    have hfac : ∀ W : B.ProEt,
        (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
      intro W
      let τ : W ⟶ T := MorphismProperty.Over.homMk (B := T) W.hom (Category.comp_id _) trivial
      have h1 : (v.comp ((wcProEtBC i).map τ).left.base.hom :
          C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) :=
        PresheafOfModules.sections_property σ τ.op
      have hw : ((wcProEtBC i).map τ).left ≫ Limits.pullback.snd (𝟙 B) i =
          Limits.pullback.snd W.hom i :=
        MorphismProperty.Over.w ((wcProEtBC i).map τ)
      have key : ((wcProEtBC i).map τ).left =
          Limits.pullback.snd W.hom i ≫ inv (Limits.pullback.snd (𝟙 B) i) :=
        (IsIso.eq_comp_inv (Limits.pullback.snd (𝟙 B) i)).mpr hw
      refine h1.symm.trans ?_
      apply ContinuousMap.ext
      intro p
      exact congrArg (fun f : Limits.pullback W.hom i ⟶ Limits.pullback (𝟙 B) i =>
        v (f.base p)) key
    let ones : (wcSuppObj D).val.sections :=
      PresheafOfModules.sectionsMk (M := (wcSuppObj D).val)
        (fun W => (1 : C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ])))
        (fun _ _ _ => rfl)
    let ρ₁ : SheafOfModules.unit (wcRingSheaf B ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcRingSheaf A ℓ)) :=
      (SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones
    let c : SheafOfModules.unit (wcRingSheaf A ℓ) ⟶ SheafOfModules.unit (wcRingSheaf A ℓ) :=
      D.μ.inv ≫ (D.adj.homEquiv _ _).symm ρ₁
    have h2 : wcSuppUnitMap D = D.adj.homEquiv _ _ D.μ.hom :=
      (D.adj.homEquiv_unit _ _ _).symm
    have hc : wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c = ρ₁ := by
      rw [h2]
      refine (D.adj.homEquiv_naturality_right D.μ.hom c).symm.trans ?_
      have e3 : D.μ.hom ≫ c = (D.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
      rw [e3, Equiv.apply_symm_apply]
    let W : A.ProEt := (wcProEtBC i).obj T
    let h : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) :=
      (c.val.app (Opposite.op W)).hom (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
    have eR : (SheafOfModules.unitHomEquiv (wcSuppObj D) ρ₁).1 (Opposite.op T) =
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ])) := by
      show (SheafOfModules.unitHomEquiv (wcSuppObj D)
        ((SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones)).1 (Opposite.op T) = _
      rw [Equiv.apply_symm_apply]
      rfl
    have eL : (SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c)).1
          (Opposite.op T) = (c.val.app (Opposite.op W)).hom v := rfl
    have eLin : (c.val.app (Opposite.op W)).hom v = v * h := by
      have hs := (c.val.app (Opposite.op W)).hom.map_smul
        (v : (wcRingSheaf A ℓ).obj.obj (Opposite.op W))
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
      exact (congrArg (fun x => (c.val.app (Opposite.op W)).hom x) (mul_one v).symm).trans hs
    have hvh : v * h = 1 :=
      eLin.symm.trans (eL.symm.trans ((congrArg
        (fun f => (SheafOfModules.unitHomEquiv (wcSuppObj D) f).1 (Opposite.op T)) hc).trans eR))
    refine ⟨u, ?_, hfac⟩
    refine isUnit_iff_exists_inv.mpr
      ⟨h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom, ?_⟩
    show v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom *
      h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom = 1
    rw [← ContinuousMap.mul_comp, hvh, ContinuousMap.one_comp]
  obtain ⟨uu, huu, hsecV⟩ := hsec E
  obtain ⟨uinv, huinv⟩ := huu.exists_right_inv

  have hΦ : ∀ (V : S.ProEt) (w : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        ((wcSuppUnitMap E).val.app (Opposite.op V)).hom w) =
        w.comp (Limits.pullback.fst V.hom i).base.hom *
          uu.comp (Limits.pullback.snd V.hom i).base.hom := by
    intro V w
    have hΦ1 : (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        ((wcSuppUnitMap E).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) =
        uu.comp (Limits.pullback.snd V.hom i).base.hom :=
      (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans (hsecV V)
    have hs := ((wcSuppUnitMap E).val.app (Opposite.op V)).hom.map_smul
      (w : (wcRingSheaf S ℓ).obj.obj (Opposite.op V)) (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 := (congrArg ((wcSuppUnitMap E).val.app (Opposite.op V)).hom (mul_one w).symm).trans hs
    refine e1.trans ?_
    show (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        (E.φ.hom.app (Opposite.op V)).hom w) *
      (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        ((wcSuppUnitMap E).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) = _
    rw [hE V w, hΦ1]

  have hT : ∀ (V : S.ProEt) (s : (SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V)),
      ((wcSuppUnitMap E).val.app (Opposite.op V)).hom s = 0 ↔
        ∀ x : ↥V.left, V.hom x ∈ Set.range i →
          (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) x = 0 := by
    intro V s
    have key := hΦ V s
    constructor
    · intro h x hx
      have hx' : x ∈ Set.range (Limits.pullback.fst V.hom i) := by
        rw [Scheme.Pullback.range_fst]; exact hx
      obtain ⟨p, rfl⟩ := hx'
      have h1 : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) (Limits.pullback.fst V.hom i p) *
          uu (Limits.pullback.snd V.hom i p) = 0 :=
        congrArg (fun F : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) => F p)
          (key.symm.trans h)
      have h2 := congrArg (fun G : C(↥Z, ULift.{u+1} ℚ_[ℓ]) => G (Limits.pullback.snd V.hom i p))
        huinv
      simp only [ContinuousMap.mul_apply, ContinuousMap.one_apply] at h2
      calc (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) (Limits.pullback.fst V.hom i p)
          = (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) (Limits.pullback.fst V.hom i p) *
              (uu (Limits.pullback.snd V.hom i p) * uinv (Limits.pullback.snd V.hom i p)) := by
            rw [h2, mul_one]
        _ = 0 := by rw [← mul_assoc, h1, zero_mul]
    · intro H
      refine key.trans ?_
      apply ContinuousMap.ext
      intro p
      have hp : V.hom (Limits.pullback.fst V.hom i p) ∈ Set.range i := by
        refine ⟨Limits.pullback.snd V.hom i p, ?_⟩
        symm
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      show (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) (Limits.pullback.fst V.hom i p) *
          uu (Limits.pullback.snd V.hom i p) = 0
      rw [H _ hp, zero_mul]

  have himg : ∀ (V : S.ProEt) (s : (SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι (wcSuppUnitMap E)).val.app (Opposite.op V)).hom k = s) ↔
        ((wcSuppUnitMap E).val.app (Opposite.op V)).hom s = 0 := by
    intro V s
    let G : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤
        ModuleCat.{u+1} ((wcRingSheaf S ℓ).obj.obj (Opposite.op V)) :=
      SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ (Opposite.op V)
    constructor
    · rintro ⟨k, rfl⟩
      have e2 : G.map (Limits.kernel.ι (wcSuppUnitMap E)) ≫ G.map (wcSuppUnitMap E) = 0 := by
        rw [← G.map_comp, Limits.kernel.condition, G.map_zero]
      have e3 := congrArg (fun h => h.hom k) e2
      simp only [ModuleCat.hom_comp, ModuleCat.hom_zero] at e3
      exact e3
    · intro hs
      let k' : ModuleCat.of ((wcRingSheaf S ℓ).obj.obj (Opposite.op V))
          ((wcRingSheaf S ℓ).obj.obj (Opposite.op V)) ⟶
            G.obj (SheafOfModules.unit (wcRingSheaf S ℓ)) :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton _ _ s)
      have hk1 : k'.hom 1 = s := one_smul _ s
      have hk' : k' ≫ G.map (wcSuppUnitMap E) = 0 := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext_ring
        show (G.map (wcSuppUnitMap E)).hom (k'.hom 1) = 0
        rw [hk1]
        exact hs
      let hl := Limits.KernelFork.IsLimit.lift'
        (Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcSuppUnitMap E)) G) k' hk'
      refine ⟨hl.1.hom 1, ?_⟩
      have h3 := congrArg (fun h => h.hom (1 : (wcRingSheaf S ℓ).obj.obj (Opposite.op V))) hl.2
      exact h3.trans hk1
  have hvan : ∀ (V : S.ProEt) (s : (SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι (wcSuppUnitMap E)).val.app (Opposite.op V)).hom k = s) ↔
        ∀ x : ↥V.left, V.hom x ∈ Set.range i →
          (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) x = 0 :=
    fun V s => (himg V s).trans (hT V s)
  have hinj : ∀ V : S.ProEt,
      Function.Injective ((Limits.kernel.ι (wcSuppUnitMap E)).val.app (Opposite.op V)).hom := by
    intro V
    let G : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤
        ModuleCat.{u+1} ((wcRingSheaf S ℓ).obj.obj (Opposite.op V)) :=
      SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ (Opposite.op V)
    have : Mono (G.map (Limits.kernel.ι (wcSuppUnitMap E))) := Functor.map_mono G _
    exact (ModuleCat.mono_iff_injective _).mp this

  have hconst : ∀ (c : ℚ_[ℓ]) (V : S.ProEt) (x : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
        ((wcHMConst S ℓ c).val.app (Opposite.op V)).hom x) =
        x * ContinuousMap.const ↥V.left (ULift.up c) := by
    intro c V x
    have h1 : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
        ((wcHMConst S ℓ c).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) =
        ContinuousMap.const ↥V.left (ULift.up c) := by
      have e : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from (SheafOfModules.unitHomEquiv _
          (wcHMConst S ℓ c)).1 (Opposite.op V)) = ContinuousMap.const ↥V.left (ULift.up c) := by
        unfold wcHMConst
        rw [Equiv.apply_symm_apply]
        rfl
      exact (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans e
    have hs := ((wcHMConst S ℓ c).val.app (Opposite.op V)).hom.map_smul
      (x : (wcRingSheaf S ℓ).obj.obj (Opposite.op V)) (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 := (congrArg ((wcHMConst S ℓ c).val.app (Opposite.op V)).hom (mul_one x).symm).trans hs
    refine e1.trans ?_
    show x * (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
        ((wcHMConst S ℓ c).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) = _
    rw [h1]

  have nat : ∀ (ψ : Limits.kernel (wcSuppUnitMap E) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      {W V : S.ProEt} (h : W ⟶ V) (k : (Limits.kernel (wcSuppUnitMap E)).val.obj (Opposite.op V)),
      (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
        (ψ.val.app (Opposite.op W)).hom (((Limits.kernel (wcSuppUnitMap E)).val.map h.op).hom k)) =
      (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from (ψ.val.app (Opposite.op V)).hom k).comp
        h.left.base.hom :=
    by
      intro ψ W V h k
      exact PresheafOfModules.naturality_apply ψ.val (Quiver.Hom.op h) k

  let O : S.Opens := ⟨(Set.range i)ᶜ, (Scheme.Hom.isClosedEmbedding i).isClosed_range.isOpen_compl⟩
  let V₀ : S.ProEt := Scheme.ProEt.mk O.ι
  obtain ⟨k₁, hk₁⟩ := (hvan V₀ (1 : C(↥O.toScheme, ULift.{u+1} ℚ_[ℓ]))).mpr (by
    intro x hx
    exfalso
    have hxO : O.ι x ∈ Set.range O.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hxO
    exact absurd hx hxO)
  haveI hpre : PreconnectedSpace ↥O.toScheme := by
    refine ⟨?_⟩
    have h1 : _root_.IsPreconnected ((⇑O.ι) '' (Set.univ : Set ↥O.toScheme)) := by
      rw [Set.image_univ, Scheme.Opens.range_ι]; exact hconn
    exact (O.ι.isOpenEmbedding.isInducing.isPreconnected_image).mp h1
  intro φ
  let f₁ : C(↥O.toScheme, ULift.{u+1} ℚ_[ℓ]) := (φ.val.app (Opposite.op V₀)).hom k₁
  let g : ↥O.toScheme → ℚ_[ℓ] := fun x => (f₁ x).down
  have hg : Continuous g := continuous_uliftDown.comp f₁.continuous
  have hsub : (Set.range g).Subsingleton := (isPreconnected_range hg).subsingleton
  let c : ℚ_[ℓ] := if h : Nonempty ↥O.toScheme then g (Classical.choice h) else 0
  have hc : ∀ y : ↥O.toScheme, g y = c := by
    intro y
    have hne : Nonempty ↥O.toScheme := ⟨y⟩
    simp only [c, dif_pos hne]
    exact hsub ⟨y, rfl⟩ ⟨_, rfl⟩
  have hf₁ : f₁ = ContinuousMap.const ↥O.toScheme (ULift.up c) := by
    apply ContinuousMap.ext
    intro y
    apply ULift.ext
    exact hc y
  refine ⟨c, ?_⟩
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X
  obtain ⟨V⟩ := X
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro k
  let t : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) :=
    ((Limits.kernel.ι (wcSuppUnitMap E)).val.app (Opposite.op V)).hom k
  let Fφ : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := (φ.val.app (Opposite.op V)).hom k
  have hR : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
      ((Limits.kernel.ι (wcSuppUnitMap E) ≫ wcHMConst S ℓ c).val.app (Opposite.op V)).hom k) =
      t * ContinuousMap.const ↥V.left (ULift.up c) := hconst c V t
  refine Eq.trans ?_ hR.symm
  show Fφ = t * ContinuousMap.const ↥V.left (ULift.up c)

  have claim1 : ∀ y ∈ ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set ↥V.left),
      Fφ y = (t * ContinuousMap.const ↥V.left (ULift.up c)) y := by
    intro y hy
    let Aop : V.left.Opens := V.hom ⁻¹ᵁ O
    let W : S.ProEt := Scheme.ProEt.mk (Aop.ι ≫ V.hom)
    let a : W ⟶ V := MorphismProperty.Over.homMk Aop.ι rfl trivial
    let b : W ⟶ V₀ := MorphismProperty.Over.homMk (V.hom ∣_ O) (morphismRestrict_ι V.hom O) trivial
    let kW : (Limits.kernel (wcSuppUnitMap E)).val.obj (Opposite.op W) :=
      ((Limits.kernel (wcSuppUnitMap E)).val.map a.op).hom k
    let k₁W : (Limits.kernel (wcSuppUnitMap E)).val.obj (Opposite.op W) :=
      ((Limits.kernel (wcSuppUnitMap E)).val.map b.op).hom k₁
    let r : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := t.comp a.left.base.hom
    let r' : (wcRingSheaf S ℓ).obj.obj (Opposite.op W) := r
    have e1 : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
        ((Limits.kernel.ι (wcSuppUnitMap E)).val.app (Opposite.op W)).hom kW) = r :=
      nat (Limits.kernel.ι (wcSuppUnitMap E)) a k
    have e2 : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
        ((Limits.kernel.ι (wcSuppUnitMap E)).val.app (Opposite.op W)).hom k₁W) = 1 :=
      (nat (Limits.kernel.ι (wcSuppUnitMap E)) b k₁).trans
        ((congrArg (fun F : C(↥O.toScheme, ULift.{u+1} ℚ_[ℓ]) => F.comp b.left.base.hom)
          hk₁).trans (ContinuousMap.one_comp _))
    have e3 : r' • k₁W = kW := by
      apply hinj W
      have h1 := ((Limits.kernel.ι (wcSuppUnitMap E)).val.app (Opposite.op W)).hom.map_smul r' k₁W
      exact h1.trans ((congrArg (fun F : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) => r * F) e2).trans
        ((mul_one r).trans e1.symm))
    have e4 : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from (φ.val.app (Opposite.op W)).hom kW) =
        Fφ.comp a.left.base.hom := nat φ a k
    have e5 : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from (φ.val.app (Opposite.op W)).hom k₁W) =
        (ContinuousMap.const ↥O.toScheme (ULift.up c)).comp b.left.base.hom :=
      (nat φ b k₁).trans (congrArg (fun F : C(↥O.toScheme, ULift.{u+1} ℚ_[ℓ]) =>
        F.comp b.left.base.hom) hf₁)
    have e6 : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from (φ.val.app (Opposite.op W)).hom kW) =
        r * (ContinuousMap.const ↥O.toScheme (ULift.up c)).comp b.left.base.hom := by
      refine (congrArg (φ.val.app (Opposite.op W)).hom e3).symm.trans ?_
      refine ((φ.val.app (Opposite.op W)).hom.map_smul r' k₁W).trans ?_
      exact congrArg (fun F : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) => r * F) e5
    have e7 : Fφ.comp a.left.base.hom =
        r * (ContinuousMap.const ↥O.toScheme (ULift.up c)).comp b.left.base.hom :=
      e4.symm.trans e6
    have hyA : y ∈ Set.range Aop.ι := by
      rw [Scheme.Opens.range_ι]; exact hy
    obtain ⟨y', rfl⟩ := hyA
    exact congrArg (fun F : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) => F y') e7

  have claim2 : ∀ x ∉ closure ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set ↥V.left),
      Fφ x = (t * ContinuousMap.const ↥V.left (ULift.up c)) x := by
    intro x hx
    let N : V.left.Opens :=
      ⟨(closure ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set ↥V.left))ᶜ, isClosed_closure.isOpen_compl⟩
    let WN : S.ProEt := Scheme.ProEt.mk (N.ι ≫ V.hom)
    let aN : WN ⟶ V := MorphismProperty.Over.homMk N.ι rfl trivial
    have htz : ∀ z : ↥N.toScheme, t (N.ι z) = 0 := by
      intro z
      have hzN : N.ι z ∈ Set.range N.ι := ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι] at hzN
      have hzA : N.ι z ∉ ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set ↥V.left) :=
        fun h => hzN (subset_closure h)
      have hzi : V.hom (N.ι z) ∈ Set.range i := by
        by_contra hci
        apply hzA
        rw [Scheme.Hom.coe_preimage]
        exact hci
      exact (hvan V t).mp ⟨k, rfl⟩ _ hzi
    let kN : (Limits.kernel (wcSuppUnitMap E)).val.obj (Opposite.op WN) :=
      ((Limits.kernel (wcSuppUnitMap E)).val.map aN.op).hom k
    have hkN : kN = 0 := by
      apply hinj WN
      refine (nat (Limits.kernel.ι (wcSuppUnitMap E)) aN k).trans ?_
      refine Eq.trans ?_ (map_zero ((Limits.kernel.ι (wcSuppUnitMap E)).val.app
        (Opposite.op WN)).hom).symm
      show t.comp aN.left.base.hom = (0 : C(↥WN.left, ULift.{u+1} ℚ_[ℓ]))
      apply ContinuousMap.ext
      intro z
      exact htz z
    have hFN : Fφ.comp aN.left.base.hom = 0 := by
      refine (nat φ aN k).symm.trans ?_
      show (φ.val.app (Opposite.op WN)).hom kN = 0
      rw [hkN, map_zero]
    have hxN : x ∈ Set.range N.ι := by
      rw [Scheme.Opens.range_ι]; exact hx
    obtain ⟨z, rfl⟩ := hxN
    have h1 := congrArg (fun F : C(↥WN.left, ULift.{u+1} ℚ_[ℓ]) => F z) hFN
    have h2 := htz z
    show Fφ (N.ι z) = t (N.ι z) * ULift.up c
    rw [h2, zero_mul]
    exact h1
  have hclosed : IsClosed {x | Fφ x = (t * ContinuousMap.const ↥V.left (ULift.up c)) x} :=
    isClosed_eq Fφ.continuous (t * ContinuousMap.const ↥V.left (ULift.up c)).continuous
  apply ContinuousMap.ext
  intro x
  by_cases hx : x ∈ closure ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set ↥V.left)
  · exact closure_minimal claim1 hclosed hx
  · exact claim2 x hx

theorem wc_qmbt_hl_supp_ext1_vanish {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (E : wcHMPullData i ℓ) (hE : wcHMPullCanonical E)
    (hres : ∀ φ : Limits.kernel (wcSuppUnitMap E) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ),
      ∃ c : ℚ_[ℓ], φ = Limits.kernel.ι (wcSuppUnitMap E) ≫ wcHMConst S ℓ c)
    (hH1 : letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf S ℓ));
      ∀ x : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) 0).obj
          (SheafOfModules.unit (wcRingSheaf S ℓ)) ⟶
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) 0).obj
          (SheafOfModules.unit (wcRingSheaf S ℓ)))⟦(1 : ℤ)⟧, x = 0) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    ∀ g : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) 0).obj
        (wcSuppObj E) ⟶
      ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) 0).obj
        (SheafOfModules.unit (wcRingSheaf S ℓ)))⟦(1 : ℤ)⟧, g = 0 :=
by
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf S ℓ))
  intro g
  haveI hepi : Epi (wcSuppUnitMap E) := wc_supp_unit_epi_of_closed i ℓ E hE
  let Sk := ShortComplex.mk (Limits.kernel.ι (wcSuppUnitMap E)) (wcSuppUnitMap E)
    (Limits.kernel.condition _)
  have hex : Sk.Exact := ShortComplex.exact_of_f_is_kernel Sk (Limits.kernelIsKernel _)
  have hSk : Sk.ShortExact := ShortComplex.ShortExact.mk' hex inferInstance hepi
  have hT := hSk.singleTriangle_distinguished
  obtain ⟨h, hh⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hT g (hH1 _)
  obtain ⟨k, hk⟩ := (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf S ℓ)))
    (1 : ℤ)).map_surjective h
  obtain ⟨φ, hφ⟩ := (DerivedCategory.singleFunctor
    (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) 0).map_surjective k
  obtain ⟨c, hc⟩ := hres φ
  have h0 := Pretriangulated.comp_distTriang_mor_zero₃₁ _ hT
  rw [hh, ← hk, ← hφ, hc, Functor.map_comp, Functor.map_comp, ← Category.assoc]
  erw [h0, Limits.zero_comp]

theorem wc_qm_koszul_regular_any_order {A : Type u} [CommRing A] [IsDomain A] (n : ℕ) (π : A)
    (hπ0 : π ≠ 0) (c : Matrix (Fin n) (Fin n) A) :
    ∀ (U : Set (Fin n)) (j : Fin n), j ∉ U → ∀ s : wcQuadModelRing A n π c,
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j) * s ∈
        Ideal.span ((fun p => Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) '' U) →
      s ∈ Ideal.span ((fun p => Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) '' U) :=
by
  classical
  intro U j hj s hs
  set F : MvPolynomial (Fin n) A := ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
    MvPolynomial.X q - MvPolynomial.C π with hF
  set J : Ideal (MvPolynomial (Fin n) A) := Ideal.span (MvPolynomial.X '' U) with hJ
  have hIU : Ideal.span ((fun p => Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
      (MvPolynomial.X p)) '' U) = J.map (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) := by
    rw [hJ, Ideal.map_span, Set.image_image]
  rw [hIU] at hs ⊢
  let σ : MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin n) A :=
    MvPolynomial.aeval (fun i : Fin n =>
      if i ∈ U then (0 : MvPolynomial (Fin n) A) else MvPolynomial.X i)
  have s1 : ∀ p, p - σ p ∈ J := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp [σ]
    | add p q hp hq => rw [map_add, add_sub_add_comm]; exact J.add_mem hp hq
    | mul_X p i hp =>
      by_cases hi : i ∈ U
      · have h0 : σ (p * MvPolynomial.X i) = 0 := by simp [σ, hi]
        rw [h0, sub_zero]
        exact J.mul_mem_left _ (Ideal.subset_span ⟨i, hi, rfl⟩)
      · have h0 : σ (p * MvPolynomial.X i) = σ p * MvPolynomial.X i := by simp [σ, hi]
        rw [h0, ← sub_mul]
        exact J.mul_mem_right _ hp
  have s2 : ∀ z ∈ J, σ z = 0 := by
    intro z hz
    have hle : J ≤ RingHom.ker (σ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) A) := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨u, hu, rfl⟩
      simp [σ, hu]
    exact hle hz
  have s2' : σ (MvPolynomial.X j) = MvPolynomial.X j := by simp [σ, hj]
  have s3 : ∀ p, MvPolynomial.constantCoeff (σ p) = MvPolynomial.constantCoeff p := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp [σ]
    | add p q hp hq => simp only [map_add, hp, hq]
    | mul_X p i hp =>
      by_cases hi : i ∈ U <;> simp [σ, hi]
  have hFc : MvPolynomial.constantCoeff F = -π := by
    simp [hF]
  have hσF : MvPolynomial.constantCoeff (σ F) ≠ 0 := by
    rw [s3, hFc]; exact neg_ne_zero.mpr hπ0
  have hprime : Prime (MvPolynomial.X j : MvPolynomial (Fin n) A) := MvPolynomial.X_prime
  have hndvd : ¬ (MvPolynomial.X j ∣ σ F) := by
    rintro ⟨w, hw⟩
    apply hσF
    rw [hw, map_mul, MvPolynomial.constantCoeff_X, zero_mul]
  obtain ⟨st, rfl⟩ := Ideal.Quotient.mk_surjective s
  have h1 : MvPolynomial.X j * st ∈ J ⊔ Ideal.span {F} := by
    have h0 : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j * st) ∈
        J.map (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) := by
      rw [map_mul]; exact hs
    have h2 := Ideal.mem_comap.mpr h0
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective] at h2
    rwa [← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at h2
  obtain ⟨z, hz, y, hy, hzy⟩ := Submodule.mem_sup.mp h1
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hy
  have h3 : σ b * σ F = MvPolynomial.X j * σ st := by
    have h0 := congrArg σ hzy
    rw [map_add, map_mul, map_mul, s2 z hz, zero_add, s2'] at h0
    exact h0
  obtain ⟨w, hw⟩ : MvPolynomial.X j ∣ σ b := by
    rcases hprime.dvd_or_dvd ⟨σ st, h3⟩ with h | h
    · exact h
    · exact absurd h hndvd
  have h4 : σ st = w * σ F := by
    have hX : (MvPolynomial.X j : MvPolynomial (Fin n) A) ≠ 0 := hprime.ne_zero
    apply mul_left_cancel₀ hX
    rw [← h3, hw]; ring
  have h5 : st = (st - σ st) + w * (σ F - F) + w * F := by rw [h4]; ring
  rw [h5, map_add, map_add]
  refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mem_map_of_mem _ (s1 st))
    (Ideal.mem_map_of_mem _ ?_)) ?_
  · have h6 : σ F - F = -(F - σ F) := by ring
    rw [h6]; exact J.mul_mem_left _ (J.neg_mem (s1 F))
  · have h7 : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (w * F) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    rw [h7]; exact Ideal.zero_mem _

theorem wc_flat_koszul_regular_transfer (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    [Module.Flat R B] (d : ℕ) (y : Fin d → R)
    (hy : ∀ (U : Set (Fin d)) (j : Fin d), j ∉ U → ∀ s : R,
      y j * s ∈ Ideal.span (y '' U) → s ∈ Ideal.span (y '' U)) :
    ∀ (U : Set (Fin d)) (j : Fin d), j ∉ U → ∀ s : B,
      algebraMap R B (y j) * s ∈ Ideal.span ((fun i => algebraMap R B (y i)) '' U) →
      s ∈ Ideal.span ((fun i => algebraMap R B (y i)) '' U) :=
by
  intro U j hj s hs
  classical
  have hs' : algebraMap R B (y j) * s ∈
      Submodule.span B ((fun i => algebraMap R B (y i)) '' U) := hs
  obtain ⟨t, ht, c, hc⟩ := (Submodule.mem_span_image_iff_exists_fun B).mp hs'
  have hc' : ∑ i : t, algebraMap R B (y i) * c i = algebraMap R B (y j) * s := by
    rw [← hc]
    exact Finset.sum_congr rfl (fun i _ => by rw [smul_eq_mul, mul_comm])
  let f : Option t → R := fun k => Option.elim k (y j) (fun i => -(y i))
  let x : Option t → B := fun k => Option.elim k s (fun i => c i)
  have hrel : ∑ k, f k • x k = 0 := by
    rw [Fintype.sum_option]
    simp only [f, x, Option.elim, Algebra.smul_def, map_neg, neg_mul, Finset.sum_neg_distrib]
    rw [hc']
    ring
  have htriv : Module.IsTrivialRelation f x :=
    Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := R) (M := B) (f := f) (x := x) hrel
  obtain ⟨k, a, z, hx, ha⟩ := htriv
  have hmem : ∀ l, a none l ∈ Ideal.span (y '' U) := by
    intro l
    apply hy U j hj
    have h := ha l
    rw [Fintype.sum_option] at h
    simp only [f, Option.elim, neg_mul, Finset.sum_neg_distrib] at h
    have h2 : y j * a none l = ∑ i : t, y i * a (some i) l := by linear_combination h
    rw [h2]
    exact Ideal.sum_mem _ (fun i _ =>
      Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, ht i.2, rfl⟩))
  have hxs : s = ∑ l, a none l • z l := hx none
  rw [hxs]
  refine Ideal.sum_mem _ (fun l _ => ?_)
  rw [Algebra.smul_def]
  refine Ideal.mul_mem_right _ _ ?_
  have hm := Ideal.mem_map_of_mem (algebraMap R B) (hmem l)
  rwa [Ideal.map_span, Set.image_image] at hm

theorem wc_qmbt_ecc_odp_prime_of_koszul {B : Type u} [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] {n : ℕ} (hn : 3 ≤ n) (t : Fin n → B)
    (ht : IsLocalRing.maximalIdeal B = Ideal.span (Set.range t))
    (hKR : ∀ (U : Set (Fin n)) (j : Fin n), j ∉ U → ∀ s : B,
      t j * s ∈ Ideal.span (t '' U) → s ∈ Ideal.span (t '' U))
    (h : B) (M : Matrix (Fin n) (Fin n) B)
    (hcub : h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal B ^ 3)
    (hdet : IsUnit (M + M.transpose).det) :
    (Ideal.span {h}).IsPrime :=
by
  obtain ⟨d, rfl⟩ : ∃ d, n = d + 1 + 1 := ⟨n - 2, by omega⟩
  have hd : 1 ≤ d := by omega
  have hQR : ∀ (e : ℕ) (F : MvPolynomial (Fin (d + 1 + 1)) B), F.IsHomogeneous e →
      MvPolynomial.eval t F ∈ IsLocalRing.maximalIdeal B ^ (e + 1) →
      ∀ α, F.coeff α ∈ IsLocalRing.maximalIdeal B := by
    intro e F hF hev α
    rw [ht] at hev ⊢
    exact wc_pfe_quasi_regular wc_pfe_hom_poly_repr B (d + 1 + 1) t hKR e F hF hev α
  have hHC : ∀ (φ g : MvPolynomial (Fin (d + 1 + 1)) (IsLocalRing.ResidueField B)) (m : ℕ),
      φ.IsHomogeneous m →
      (∀ j : ℕ, MvPolynomial.homogeneousComponent (m + j) (φ * g) =
          φ * MvPolynomial.homogeneousComponent j g) ∧
      (∀ i : ℕ, i < m → MvPolynomial.homogeneousComponent i (φ * g) = 0) :=
    fun φ g m hφ => wc_mvpoly_homogeneousComponent_mul_homog φ g m hφ
  have hdom : IsDomain (B ⧸ Ideal.span {h}) :=
    wc_odp_hypersurface_quotient_isDomain B d hd t h M ht hcub hdet hQR hHC
  exact (Ideal.Quotient.isDomain_iff_prime (Ideal.span {h})).mp hdom

theorem wc_qmbt_ecc_support_avoid {A : Type u} [CommRing A] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A} {B₀ : Type u} [CommRing B₀] [IsLocalRing B₀]
    (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c)))
    {A' : Type u} [CommRing A'] (ιA : A →+* A') (π' : A')
    (hmax : ∀ q : PrimeSpectrum B₀, (∀ p : Fin n, (Spec.preimage a₀).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈ q.asIdeal) →
      q = IsLocalRing.closedPoint B₀)
    (x : ↥(Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))))
    (hx : Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) x ≠
      IsLocalRing.closedPoint B₀) :
    x ∉ ((Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))).support :
        Set _) :=
by
  intro hmem
  rw [Scheme.IdealSheafData.coe_support_ofIdealTop, Scheme.mem_zeroLocus_iff] at hmem
  have hcomap : ∀ (φ : CommRingCat.of (wcQuadModelRing A n π c) ⟶ CommRingCat.of B₀)
      (q : Spec (.of B₀)), (Spec.map φ q).asIdeal = Ideal.comap φ.hom q.asIdeal :=
    fun φ q => rfl
  have ha : ∀ q : Spec (.of B₀),
      (a₀ q).asIdeal = Ideal.comap (Spec.preimage a₀).hom q.asIdeal := by
    intro q
    have h := hcomap (Spec.preimage a₀) q
    rwa [Spec.map_preimage] at h
  apply hx
  apply hmax
  intro p
  have h3 : x ∉ (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))).basicOpen
      (((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)))) :=
    hmem _ (Ideal.subset_span ⟨some p, rfl⟩)
  have h4 : x ∉ ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀) ⁻¹ᵁ
      (Spec (.of (wcQuadModelRing A n π c))).basicOpen
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) := by
    rw [Scheme.preimage_basicOpen_top]; exact h3
  rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at h4
  rw [basicOpen_eq_of_affine] at h4
  have h5 : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      (a₀ ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x)).asIdeal := by
    by_contra hc
    exact h4 ((PrimeSpectrum.mem_basicOpen _ _).mpr hc)
  rw [ha] at h5
  exact h5

theorem wc_qmbt_ecc_inducing {Y S S' T X X' : Scheme.{u}} (g : Y ⟶ S) (e : S' ⟶ S) (t : T ⟶ S')
    (ht : IsClosedImmersion t) (hte : IsClosedImmersion (t ≫ e))
    (bl : X ⟶ Limits.pullback g e) {ι' : X' ⟶ X} {s' : X' ⟶ T}
    (hps : IsPullback ι' s' (bl ≫ Limits.pullback.snd g e) t)
    (W : (Limits.pullback g e).Opens) (hW : IsIso (bl ∣_ W))
    (U : Set X') (hU : ∀ x ∈ U, bl (ι' x) ∈ W) :
    Topology.IsInducing (fun x : U => (ι' ≫ bl ≫ Limits.pullback.fst g e) x.1) :=
by

  have hpaste := IsPullback.paste_horiz
    (IsPullback.of_hasPullback (Limits.pullback.snd g e) t) (IsPullback.of_hasPullback g e)
  have hjf : IsClosedImmersion (Limits.pullback.fst (Limits.pullback.snd g e) t ≫
      Limits.pullback.fst g e) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpaste.flip hte
  have hjfi : Topology.IsInducing ⇑(Limits.pullback.fst (Limits.pullback.snd g e) t ≫
      Limits.pullback.fst g e) := by
    haveI := hjf
    exact (Scheme.Hom.isClosedEmbedding _).isInducing

  have hj : IsClosedImmersion (Limits.pullback.fst (Limits.pullback.snd g e) t) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback (Limits.pullback.snd g e) t).flip ht
  have hji : Topology.IsInducing ⇑(Limits.pullback.fst (Limits.pullback.snd g e) t) := by
    haveI := hj
    exact (Scheme.Hom.isClosedEmbedding _).isInducing

  have hι : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip ht
  have hιi : Topology.IsInducing ⇑ι' := by
    haveI := hι
    exact (Scheme.Hom.isClosedEmbedding _).isInducing

  have w : (ι' ≫ bl) ≫ Limits.pullback.snd g e = s' ≫ t := by
    rw [Category.assoc]; exact hps.toCommSq.w
  set κ := Limits.pullback.lift (ι' ≫ bl) s' w with hκdef
  have hκ : κ ≫ Limits.pullback.fst (Limits.pullback.snd g e) t = ι' ≫ bl :=
    Limits.pullback.lift_fst _ _ _

  have hψ : Topology.IsOpenEmbedding ⇑((bl ⁻¹ᵁ W).ι ≫ bl) := by
    haveI := hW
    rw [← morphismRestrict_ι]
    exact Scheme.Hom.isOpenEmbedding _

  let h₁ : U → (bl ⁻¹ᵁ W).toScheme := fun x => ⟨ι' x.1, (Scheme.Hom.mem_preimage bl).mpr (hU x.1 x.2)⟩
  have hh₁ : Topology.IsInducing h₁ := by
    have e1 : ⇑(bl ⁻¹ᵁ W).ι ∘ h₁ = ⇑ι' ∘ Subtype.val := by
      funext x; rfl
    rw [← (Topology.IsInducing.of_comp_iff (Scheme.Hom.isOpenEmbedding (bl ⁻¹ᵁ W).ι).isInducing), e1]
    exact hιi.comp Topology.IsInducing.subtypeVal

  have hκi : Topology.IsInducing (⇑κ ∘ (Subtype.val : U → X')) := by
    have e2 : ⇑(Limits.pullback.fst (Limits.pullback.snd g e) t) ∘ (⇑κ ∘ (Subtype.val : U → X')) =
        ⇑((bl ⁻¹ᵁ W).ι ≫ bl) ∘ h₁ := by
      funext x
      simp only [Function.comp_apply]
      rw [← Scheme.Hom.comp_apply, hκ, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      rfl
    rw [← Topology.IsInducing.of_comp_iff hji, e2]
    exact hψ.isInducing.comp hh₁

  have e3 : (fun x : U => (ι' ≫ bl ≫ Limits.pullback.fst g e) x.1) =
      ⇑(Limits.pullback.fst (Limits.pullback.snd g e) t ≫ Limits.pullback.fst g e) ∘
        (⇑κ ∘ (Subtype.val : U → X')) := by
    funext x
    simp only [Function.comp_apply]
    rw [← Scheme.Hom.comp_apply, ← Category.assoc κ, hκ, Category.assoc]
  rw [e3]
  exact hjfi.comp hκi

theorem wc_qmbt_ecc_lift_point {Y S S' T X X' : Scheme.{u}} (g : Y ⟶ S) (e : S' ⟶ S) (t : T ⟶ S')
    (bl : X ⟶ Limits.pullback g e) {ι' : X' ⟶ X} {s' : X' ⟶ T}
    (hps : IsPullback ι' s' (bl ≫ Limits.pullback.snd g e) t)
    (W : (Limits.pullback g e).Opens) (hW : IsIso (bl ∣_ W))
    (y : Y) (τ : T) (hy : g y = e (t τ))
    (hyW : ∀ p, Limits.pullback.fst g e p = y → p ∈ W) :
    ∃ x : X', (ι' ≫ bl ≫ Limits.pullback.fst g e) x = y :=
by
  obtain ⟨p, hp1, hp2⟩ := Scheme.Pullback.exists_preimage_pullback (f := g) (g := e) y (t τ) hy
  have hpW : p ∈ W := hyW p hp1
  haveI := hW
  obtain ⟨z, hz⟩ := (bl ∣_ W).surjective ⟨p, hpW⟩
  have hx0 : bl z.1 = p := by
    have := congrArg Subtype.val hz
    rw [morphismRestrict_base_coe] at this
    exact this
  have hcompat : (bl ≫ Limits.pullback.snd g e) z.1 = t τ := by
    rw [Scheme.Hom.comp_apply, hx0, hp2]
  obtain ⟨q, hq1, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := bl ≫ Limits.pullback.snd g e) (g := t) z.1 τ hcompat
  refine ⟨hps.isoPullback.inv q, ?_⟩
  have hι : ι' (hps.isoPullback.inv q) = z.1 := by
    rw [← Scheme.Hom.comp_apply, hps.isoPullback_inv_fst, hq1]
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hι, hx0, hp1]

theorem wc_qmbt_ecc_special_point_facts {A : Type u} [CommRing A] [IsLocalRing A] {n : ℕ}
    {π : A} {c : Matrix (Fin n) (Fin n) A} (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {B₀ : Type u} [CommRing B₀] (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c)))
    {A' : Type u} [CommRing A'] [IsLocalRing A'] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (hπ'2 : π' ^ 2 = ιA π)
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    (∀ x : Xs', (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) ∈
      ((ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x).asIdeal) ∧
    (∀ q : PrimeSpectrum B₀,
      (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) ∈ q.asIdeal →
      (a₀ ≫ wcQuadModelStr A n π c) q =
        Spec.map (CommRingCat.ofHom ιA) (wcQmSp A' (IsLocalRing.closedPoint (IsLocalRing.ResidueField A')))) :=
by
  classical

  have s1 : ∀ q : Spec (.of B₀), (π ∈ ((a₀ ≫ wcQuadModelStr A n π c) q).asIdeal ↔
      (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) ∈ q.asIdeal) := by
    intro q
    have hq : a₀ q = Spec.map (Spec.preimage a₀) q := by
      rw [Spec.map_preimage a₀]
    rw [Scheme.Hom.comp_apply, hq]
    exact Iff.rfl

  have hres : IsLocalRing.residue A' π' = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ']
    exact Ideal.mem_span_singleton_self π'
  have s2 : ∀ ω : Spec (.of (IsLocalRing.ResidueField A')),
      π ∈ (Spec.map (CommRingCat.ofHom ιA) (wcQmSp A' ω)).asIdeal := by
    intro ω
    show IsLocalRing.residue A' (ιA π) ∈ ω.asIdeal
    rw [← hπ'2, map_pow, hres, zero_pow two_ne_zero]
    exact ω.asIdeal.zero_mem

  have s3 : ∀ P : PrimeSpectrum A, π ∈ P.asIdeal → P.asIdeal = IsLocalRing.maximalIdeal A := by
    intro P hP
    have hle : IsLocalRing.maximalIdeal A ≤ P.asIdeal := by
      rw [hπ, Ideal.span_singleton_le_iff_mem]
      exact hP
    exact ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le P.isPrime.ne_top hle).symm

  have s4 : ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) ≫ (a₀ ≫ wcQuadModelStr A n π c) =
      s' ≫ wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA) := by
    rw [Limits.pullback.condition, ← Category.assoc bl, hblf, ← Category.assoc, hps'.w,
      Category.assoc]
  refine ⟨fun x => ?_, fun q hq => ?_⟩
  · apply (s1 _).mp
    have hx := congrArg (fun φ : Xs' ⟶ Spec (.of A) => φ x) s4
    simp only [Scheme.Hom.comp_apply] at hx ⊢
    rw [hx]
    exact s2 _
  · apply PrimeSpectrum.ext
    exact (s3 _ ((s1 q).mpr hq)).trans (s3 _ (s2 _)).symm

theorem wc_qmbt_hl_exc_compl_conn {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    IsPreconnected ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ :=
by
  classical

  have hπ0 : π ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h0]
    exact Ideal.span_singleton_eq_bot.mpr rfl
  have h3 : 3 ≤ n := by omega
  have hQmCI : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hteCI : IsClosedImmersion (wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA)) := by
    have e1 : wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA) =
        Spec.map (CommRingCat.ofHom ((IsLocalRing.residue A').comp ιA)) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp]
    rw [e1]
    apply IsClosedImmersion.spec_of_surjective
    intro z
    obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective z
    obtain ⟨x, y, rfl⟩ := hgen a'
    refine ⟨x, ?_⟩
    have hres : IsLocalRing.residue A' π' = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff, hπ']
      exact Ideal.mem_span_singleton_self π'
    show IsLocalRing.residue A' (ιA x) = IsLocalRing.residue A' (ιA x + ιA y * π')
    rw [map_add, map_mul, hres, mul_zero, add_zero]

  obtain ⟨hNoeth, hm, hWE⟩ := wc_qmbt_ecc_shens_maximal hπ hx₀ hsh
  haveI : IsNoetherianRing B₀ := hNoeth
  letI : Algebra (wcQuadModelRing A n π c) B₀ := (Spec.preimage a₀).hom.toAlgebra
  haveI : Algebra.WeaklyEtale (wcQuadModelRing A n π c) B₀ := hWE
  haveI : Module.Flat (wcQuadModelRing A n π c) B₀ := Algebra.WeaklyEtale.flat

  have hmax : ∀ q : PrimeSpectrum B₀, (∀ p : Fin n, (Spec.preimage a₀).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈ q.asIdeal) →
      q = IsLocalRing.closedPoint B₀ := by
    intro q hq
    have hle : IsLocalRing.maximalIdeal B₀ ≤ q.asIdeal := by
      rw [hm, Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      exact hq p
    apply PrimeSpectrum.ext
    exact ((IsLocalRing.maximalIdeal.isMaximal B₀).eq_of_le q.isPrime.ne_top hle).symm

  have hKR := wc_flat_koszul_regular_transfer (wcQuadModelRing A n π c) B₀ n
    (fun p => Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))
    (wc_qm_koszul_regular_any_order n π hπ0 c)

  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hcub0 : (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) -
      ∑ a, ∑ b, (c.map ((Spec.preimage a₀).hom.comp
          (algebraMap A (wcQuadModelRing A n π c)))) a b *
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a)) *
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X b))
      = 0 := by
    have key : (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π) -
        ∑ a, ∑ b, (c.map ((Spec.preimage a₀).hom.comp
            (algebraMap A (wcQuadModelRing A n π c)))) a b *
          (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X a)) *
          (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X b))
        = -(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C π)) := by
      simp only [map_sub, map_sum, map_mul, Matrix.map_apply, RingHom.comp_apply, neg_sub]
      try rfl
    rw [key, hrel, map_zero, neg_zero]
  have hdet : IsUnit ((c.map ((Spec.preimage a₀).hom.comp
        (algebraMap A (wcQuadModelRing A n π c)))) +
      (c.map ((Spec.preimage a₀).hom.comp
        (algebraMap A (wcQuadModelRing A n π c)))).transpose).det := by
    have e : (c.map ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A n π c)))) +
        (c.map ((Spec.preimage a₀).hom.comp
          (algebraMap A (wcQuadModelRing A n π c)))).transpose =
        ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A n π c))).mapMatrix
          (c + c.transpose) := by
      ext i j
      simp [RingHom.mapMatrix_apply, Matrix.add_apply, Matrix.transpose_apply]
    rw [e, ← RingHom.map_det]
    exact hc.map _
  have hprime := wc_qmbt_ecc_odp_prime_of_koszul (B := B₀) h3
    (fun p => (Spec.preimage a₀).hom
      (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)))
    hm hKR ((Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π))
    (c.map ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A n π c))))
    (by rw [hcub0]; exact zero_mem _) hdet

  have hWex : ∀ I : (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))).IdealSheafData,
      wcCsdIsBlowup I bl →
      (∀ p : ↥(Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))),
        Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) p ≠
          IsLocalRing.closedPoint B₀ → p ∉ (I.support : Set _)) →
      ∃ W : (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).Opens, IsIso (bl ∣_ W) ∧
        ∀ p : ↥(Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))),
          Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) p ≠
            IsLocalRing.closedPoint B₀ → p ∈ W := by
    intro I hI hav
    let W0 : (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))).Opens :=
      ⟨(I.support : Set _)ᶜ, I.support.isClosed.isOpen_compl⟩
    have hW0 : ∀ p, p ∈ W0 → p ∉ I.support := fun p h => h
    have hW0' : ∀ p, p ∉ I.support → p ∈ W0 := fun p h => h
    refine ⟨W0, wc_csd_blowup_iso_off_center _ _ I bl W0 hI
      (Set.eq_empty_iff_forall_notMem.mpr (fun p hp => hW0 p hp.2 hp.1)),
      fun p hp => hW0' p (hav p hp)⟩
  obtain ⟨W, hW, hAvoid⟩ := hWex _ hbl (fun p hp => wc_qmbt_ecc_support_avoid a₀ ιA π' hmax p hp)

  obtain ⟨hL3a, hL3b⟩ := wc_qmbt_ecc_special_point_facts hπ a₀ hπ' hπ'2 hblf hps'
  have hps : IsPullback ι' s' (bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (wcQmSp A') := by
    rw [hblf]; exact hps'
  set β := (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) with hβ
  rcases Set.eq_empty_or_nonempty (β ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ with hE | ⟨x₁, hx₁⟩
  · rw [hE]; exact isPreconnected_empty
  have hx₁' : ¬ (β x₁ = IsLocalRing.closedPoint B₀) := hx₁
  let η : PrimeSpectrum B₀ :=
    ⟨Ideal.span {(Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) π)}, hprime⟩
  have hηle : ∀ x : Xs', η ≤ β x := fun x =>
    (PrimeSpectrum.asIdeal_le_asIdeal _ _).mp ((Ideal.span_singleton_le_iff_mem _).mpr (hL3a x))
  have hηne : η ≠ IsLocalRing.closedPoint B₀ := by
    intro hη
    apply hx₁'
    have h1 : IsLocalRing.maximalIdeal B₀ ≤ PrimeSpectrum.asIdeal (β x₁) := by
      have := hηle x₁
      rw [hη] at this
      exact (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr this
    apply PrimeSpectrum.ext
    exact ((IsLocalRing.maximalIdeal.isMaximal B₀).eq_of_le
      (PrimeSpectrum.isPrime (β x₁)).ne_top h1).symm
  obtain ⟨ξ, hξ⟩ := wc_qmbt_ecc_lift_point (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA)) (wcQmSp A') bl hps W hW η
    (IsLocalRing.closedPoint (IsLocalRing.ResidueField A'))
    (hL3b η (Ideal.mem_span_singleton_self _))
    (fun p hp => hAvoid p (by rw [hp]; exact hηne))
  have hsub1 : ({η} : Set (Spec (.of B₀))) ⊆ β '' (β ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ := by
    rintro _ rfl
    refine ⟨ξ, fun h => hηne ?_, hξ⟩
    rw [← hξ]
    exact h
  have hsub2 : β '' (β ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ⊆
      closure ({η} : Set (Spec (.of B₀))) := by
    rintro _ ⟨x, -, rfl⟩
    exact (PrimeSpectrum.le_iff_mem_closure η (β x)).mp (hηle x)
  have himg : _root_.IsPreconnected (β '' (β ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ) :=
    isPreconnected_singleton.subset_closure hsub1 hsub2
  have hind := wc_qmbt_ecc_inducing (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA)) (wcQmSp A') hQmCI hteCI bl hps W hW
    (β ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ (fun x hx => hAvoid _ hx)
  have h2 : _root_.IsPreconnected (Set.univ : Set ↥((β ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ)) := by
    apply hind.isPreconnected_image.mp
    rw [Set.image_univ]
    rw [Set.image_eq_range] at himg
    exact himg
  exact isPreconnected_iff_preconnectedSpace.mpr ⟨h2⟩

theorem wc_qmbt_hl_strict_compl_conn {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    IsPreconnected (closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹'
        {IsLocalRing.closedPoint B₀})ᶜ)ᶜ :=
by
  classical

  obtain ⟨θ, X₁, r₁, ψ, hθX, hθA, hr₁, hsq⟩ := wc_qmbt_hlsc_model_square hsh hπ'2 hbl

  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have h1 : c.map ιA + (c.map ιA).transpose = (c + c.transpose).map ιA := by
      ext i j
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hc.map ιA

  obtain ⟨o, ho, hoθ⟩ := wc_qmbt_hlsc_theta_fibre hπ hx₀ hπ' hπ'2 θ hθX hθA

  have hE₁ := wc_qmbt_hlsc_exc_irred hπ' (by omega) hc' r₁ hr₁ o ho
  have h₁ : IsPreirreducible ((r₁ ≫ Spec.map (CommRingCat.ofHom θ)) ⁻¹' {x₀}) := by
    have e : (r₁ ≫ Spec.map (CommRingCat.ofHom θ)) ⁻¹' {x₀} = r₁ ⁻¹' {o} := by
      ext z
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
      exact hoθ (r₁ z)
    rw [e]
    exact hE₁

  obtain ⟨hcp, huniq, hiso⟩ := wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh

  have h₂ := wc_qmbt_hlsc_fibre_transfer hsq x₀ hiso h₁
  have hEm : (fun w : Xm => a₀ ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) w)) ⁻¹' {x₀} =
      (fun w : Xm => (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹' {IsLocalRing.closedPoint B₀} := by
    ext w
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨huniq _, fun h => by rw [h]; exact hcp⟩
  have h₂' : IsPreirreducible ((fun w : Xm => (bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹'
      {IsLocalRing.closedPoint B₀}) := by
    rw [← hEm]
    exact h₂

  have hstr : (wcQuadModelStr A n π c) x₀ = IsLocalRing.closedPoint A := by
    have hπmem : π ∈ Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
        (PrimeSpectrum.asIdeal x₀) := by
      rw [Ideal.mem_comap]
      have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
          algebraMap A (wcQuadModelRing A n π c) π := by
        change _ = Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π)
        exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [← hrel, map_sum]
      refine Ideal.sum_mem _ fun p _ => ?_
      rw [map_sum]
      refine Ideal.sum_mem _ fun q _ => ?_
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hx₀ q)
    have hcomap : Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
        (PrimeSpectrum.asIdeal x₀) = IsLocalRing.maximalIdeal A := by
      refine ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le
        (Ideal.comap_ne_top _ (PrimeSpectrum.isPrime x₀).ne_top) ?_).symm
      rw [hπ, Ideal.span_singleton_le_iff_mem]
      exact hπmem
    apply PrimeSpectrum.ext
    exact hcomap
  have hrange : (fun w : Xm => (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹' {IsLocalRing.closedPoint B₀} ⊆
      Set.range ι' := by
    intro z hz
    have hz2 : Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) (bl z) = IsLocalRing.closedPoint B₀ := by
      have h0 := hz
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply] at h0
      exact h0
    have e1 : (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ≫ wcQuadModelStr A n π c) (bl z) =
        (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ≫ Spec.map (CommRingCat.ofHom ιA)) (bl z) := by
      rw [Limits.pullback.condition]
    simp only [Scheme.Hom.comp_apply] at e1
    rw [hz2, hcp, hstr] at e1
    have hπ'y : π' ∈ PrimeSpectrum.asIdeal (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) (bl z)) := by
      have h1 : π ∈ Ideal.comap ιA (PrimeSpectrum.asIdeal
          (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) (bl z))) := by
        have h3 := congrArg PrimeSpectrum.asIdeal e1
        change IsLocalRing.maximalIdeal A = Ideal.comap ιA (PrimeSpectrum.asIdeal
          (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) (bl z))) at h3
        rw [← h3, hπ]
        exact Ideal.mem_span_singleton_self π
      rw [Ideal.mem_comap, ← hπ'2] at h1
      exact (PrimeSpectrum.isPrime _).mem_of_pow_mem 2 h1
    have hfz : f z = IsLocalRing.closedPoint A' := by
      rw [← hblf, Scheme.Hom.comp_apply]
      apply PrimeSpectrum.ext
      change PrimeSpectrum.asIdeal (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) (bl z)) = IsLocalRing.maximalIdeal A'
      refine ((IsLocalRing.maximalIdeal.isMaximal A').eq_of_le
        (PrimeSpectrum.isPrime _).ne_top ?_).symm
      rw [hπ', Ideal.span_singleton_le_iff_mem]
      exact hπ'y
    obtain ⟨t0⟩ : Nonempty (PrimeSpectrum (IsLocalRing.ResidueField A')) := inferInstance
    let t : ↥(Spec (CommRingCat.of (IsLocalRing.ResidueField A'))) := t0
    have ht : wcQmSp A' t = IsLocalRing.closedPoint A' := by
      apply PrimeSpectrum.ext
      change Ideal.comap (IsLocalRing.residue A') (PrimeSpectrum.asIdeal t0) =
        IsLocalRing.maximalIdeal A'
      have hbot : PrimeSpectrum.asIdeal t0 = ⊥ :=
        (Ideal.eq_bot_or_top _).resolve_right (PrimeSpectrum.isPrime t0).ne_top
      rw [hbot, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    obtain ⟨z', hz'1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f)
      (g := wcQmSp A') z t (hfz.trans ht.symm)
    refine ⟨hps'.isoPullback.inv z', ?_⟩
    rw [← Scheme.Hom.comp_apply, hps'.isoPullback_inv_fst]
    exact hz'1

  haveI : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip inferInstance
  have hind : Topology.IsInducing ι' :=
    (IsClosedImmersion.isClosedEmbedding ι').toIsEmbedding.toIsInducing
  have hpre : ∀ S : Set Xm, S ⊆ Set.range ι' → IsPreirreducible S →
      IsPreirreducible (ι' ⁻¹' S) := by
    intro S hSr hS U V hU hV hSU hSV
    obtain ⟨u, huS, huU⟩ := hSU
    obtain ⟨v, hvS, hvV⟩ := hSV
    obtain ⟨U', hU', rfl⟩ := hind.isOpen_iff.mp hU
    obtain ⟨V', hV', rfl⟩ := hind.isOpen_iff.mp hV
    obtain ⟨y, hyS, hyU, hyV⟩ := hS U' V' hU' hV' ⟨ι' u, huS, huU⟩ ⟨ι' v, hvS, hvV⟩
    obtain ⟨x, rfl⟩ := hSr hyS
    exact ⟨x, hyS, hyU, hyV⟩
  have hZ2 : IsPreirreducible ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹'
      {IsLocalRing.closedPoint B₀}) := by
    have heq : (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst
        (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹'
        {IsLocalRing.closedPoint B₀} =
        ι' ⁻¹' ((fun w : Xm => (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) w) ⁻¹' {IsLocalRing.closedPoint B₀}) := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
    rw [heq]
    exact hpre _ hrange h₂'

  refine (hZ2.open_subset isClosed_closure.isOpen_compl ?_).isPreconnected
  intro x hx
  by_contra h
  exact hx (subset_closure h)

theorem wc_qmbt_detect_hom_line {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    haveI := Dp'.additive
    haveI := Di'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    let eK' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xm ℓ))
          (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P' (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
        (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι'
    let eΨ' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          (ComplexShape.up ℤ) 0).map Di'.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di'.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf Xm ℓ)) ≫
        (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∃ ν₀ : DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ') ⟶
        DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))),
      ∀ g : DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ') ⟶
        DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))),
      ∃ c₁ : ℚ_[ℓ], g = ν₀ ≫ DerivedCategory.Q.map
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (wcHMConst Xs' ℓ c₁)) :=
by
  intro P' K' eK' eΨ'
  haveI := Dp'.additive
  haveI := Di'.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
  haveI := Di'.presLim
  haveI := Di'.presColim
  haveI : Limits.PreservesFiniteLimits P' := by
    haveI := Dp'.adj.rightAdjoint_preservesLimits
    infer_instance
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
  have homology_transfer : ∀ {𝒜 𝒜' ℬ : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} 𝒜']
      [Category.{u+1} ℬ] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ]
      (P : 𝒜' ⥤ 𝒜) [P.Additive] [Limits.PreservesFiniteLimits P]
      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G]
      {O : 𝒜} {O' : 𝒜'} {Os : ℬ} (u : O ⟶ P.obj O') (μ : G.obj O ≅ Os)
      (I : InjectiveResolution O'),
      let eK := (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app O' ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
      let eΨ := (HomologicalComplex.single ℬ (ComplexShape.up ℤ) 0).map μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex G (ComplexShape.up ℤ) 0).inv.app O ≫
        (G.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
      let Ψ := (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
      (∀ q : ℕ, Nonempty (Ψ.homology (q : ℤ) ≅
          G.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) ∧
      (∀ q : ℤ, q < 0 → Limits.IsZero (Ψ.homology q)) ∧
      (IsIso (G.map u) → IsIso (HomologicalComplex.homologyMap eΨ 0)) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ _ G _ _ _ O O' Os u μ I eK eΨ Ψ
    have hneg : ∀ q : ℤ, q < 0 → Limits.IsZero (Ψ.X q) := by
      intro q hq
      exact G.map_isZero
        (P.map_isZero (CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 q hq))
    refine ⟨?_, ?_, ?_⟩
    · intro q
      let Kn := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
      let L := (G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Kn
      let φ : ∀ a : Option ℕ, G.obj (P.obj (HomologicalComplex.extend.X I.cocomplex a)) ≅
          HomologicalComplex.extend.X L a := fun a =>
        match a with
        | some k => Iso.refl _
        | none => Limits.IsZero.iso (G.map_isZero (P.map_isZero (Limits.isZero_zero _)))
            (Limits.isZero_zero _)
      have hφ : ∀ a b : Option ℕ,
          (φ a).hom ≫ HomologicalComplex.extend.d L a b =
            G.map (P.map (HomologicalComplex.extend.d I.cocomplex a b)) ≫ (φ b).hom := by
        intro a b
        cases a with
        | none => exact (G.map_isZero (P.map_isZero (Limits.isZero_zero _))).eq_of_src _ _
        | some i =>
          cases b with
          | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
          | some j => exact (Category.id_comp _).trans (Category.comp_id _).symm
      let isoΨ : Ψ ≅ L.extend ComplexShape.embeddingUpNat :=
        HomologicalComplex.Hom.isoOfComponents
          (fun i => φ (ComplexShape.embeddingUpNat.r i))
          (fun i j _ => hφ _ _)
      exact ⟨HomologicalComplex.homologyMapIso isoΨ (q : ℤ) ≪≫
        L.extendHomologyIso ComplexShape.embeddingUpNat (j := q) rfl ≪≫
        (Kn.sc q).mapHomologyIso G⟩
    · intro q hq
      exact (Ψ.sc q).isZero_homology_of_isZero_X₂ (hneg q hq)
    · intro hu
      let S := (HomologicalComplex.single ℬ (ComplexShape.up ℤ) 0).obj Os
      have hnext : (ComplexShape.up ℤ).next 0 = 1 := by simp
      have hprev : (ComplexShape.up ℤ).prev 0 = -1 := by simp
      let F := P ⋙ G
      have hk := I.exact₀.fIsKernel
      have hkF := Limits.KernelFork.mapIsLimit _ hk F
      let cXI0 := I.cochainComplexXIso 0 0 rfl
      let cXI1 := I.cochainComplexXIso 1 1 rfl
      have hd : Ψ.d 0 1 = F.map (cXI0.hom ≫ I.cocomplex.d 0 1 ≫ cXI1.inv) := by
        show G.map (P.map (I.cochainComplex.d 0 1)) = _
        rw [I.cochainComplex_d 0 1 0 1 rfl rfl]
        rfl
      have hlim := Limits.KernelFork.isLimitOfIsLimitOfIff hkF (Ψ.d 0 1) (F.mapIso cXI0.symm)
        (by
          intro W f
          rw [hd, F.map_comp, F.map_comp]
          simp only [Functor.mapIso_hom, Iso.symm_hom]
          rw [← F.map_comp_assoc, cXI0.inv_hom_id, F.map_id, Category.id_comp]
          constructor
          · intro h; simp [reassoc_of% h]
          · intro h
            rw [← cancel_mono (F.map cXI1.inv), Category.assoc, h, Limits.zero_comp])
      let κ : G.obj (P.obj O') ⟶ Ψ.X 0 := G.map (P.map (I.ι.f 0 ≫ cXI0.inv))
      have hf : eΨ.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Os).hom ≫
          μ.inv ≫ G.map u ≫ κ := by
        simp [eΨ, eK, κ, HomologicalComplex.single_map_f_self,
          HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
          InjectiveResolution.ι'_f_zero]
        rfl
      let c := (Ψ.cyclesIsKernel 0 1 hnext).conePointUniqueUpToIso hlim
      let ci : G.obj (P.obj O') ⟶ Ψ.cycles 0 := c.inv
      haveI : IsIso ci := (inferInstance : IsIso c.inv)
      have hc : ci ≫ Ψ.iCycles 0 = κ := by
        have h1 := Limits.IsLimit.conePointUniqueUpToIso_inv_comp
          (Ψ.cyclesIsKernel 0 1 hnext) hlim Limits.WalkingParallelPair.zero
        refine h1.trans ?_
        change F.map (I.ι.f 0) ≫ F.map cXI0.inv = _
        exact ((congrArg G.map (P.map_comp _ _)).trans (G.map_comp _ _)).symm
      have hcyc : HomologicalComplex.cyclesMap eΨ 0 = S.iCycles 0 ≫
          ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Os).hom ≫ μ.inv ≫
            G.map u ≫ ci) := by
        rw [← cancel_mono (Ψ.iCycles 0), HomologicalComplex.cyclesMap_i, hf]
        simp only [Category.assoc, hc]
        rfl
      have hS1 : S.d 0 1 = 0 :=
        (HomologicalComplex.isZero_single_obj_X _ _ _ 1 (by decide)).eq_of_tgt _ _
      have hSm : S.d (-1) 0 = 0 :=
        (HomologicalComplex.isZero_single_obj_X _ _ _ (-1) (by decide)).eq_of_src _ _
      haveI : IsIso (S.iCycles 0) := HomologicalComplex.isIso_iCycles S 0 1 hnext hS1
      haveI : IsIso (S.homologyπ 0) := HomologicalComplex.isIso_homologyπ S (-1) 0 hprev hSm
      haveI : IsIso (Ψ.homologyπ 0) := HomologicalComplex.isIso_homologyπ Ψ (-1) 0 hprev
        ((hneg (-1) (by norm_num)).eq_of_src _ _)
      haveI : IsIso (G.map u) := hu
      haveI : IsIso (HomologicalComplex.cyclesMap eΨ 0) := by
        rw [hcyc]
        infer_instance
      have h2 : IsIso (S.homologyπ 0 ≫ HomologicalComplex.homologyMap eΨ 0) := by
        rw [HomologicalComplex.homologyπ_naturality]; infer_instance
      exact IsIso.of_isIso_comp_left (S.homologyπ 0) _

  have hcov := wc_qmbt_hl_cov hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf

  let Z₂ : Set Xs' := (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀}
  have hZ₂ : IsClosed Z₂ :=
    IsClosed.preimage (Scheme.Hom.continuous _) (IsLocalRing.isClosed_singleton_closedPoint B₀)
  let Z₁ : Set Xs' := closure Z₂ᶜ
  have hZ₁ : IsClosed Z₁ := isClosed_closure
  let ZY : Set Xs' := Z₁ ∩ Z₂
  have hZY : IsClosed ZY := hZ₁.inter hZ₂
  let I₁ := Scheme.IdealSheafData.vanishingIdeal (⟨Z₁, hZ₁⟩ : TopologicalSpace.Closeds Xs')
  let I₂ := Scheme.IdealSheafData.vanishingIdeal (⟨Z₂, hZ₂⟩ : TopologicalSpace.Closeds Xs')
  let IY := Scheme.IdealSheafData.vanishingIdeal (⟨ZY, hZY⟩ : TopologicalSpace.Closeds Xs')
  have hr₁ : Set.range I₁.subschemeι = Z₁ :=
    (Scheme.IdealSheafData.range_subschemeι _).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal _)
  have hr₂ : Set.range I₂.subschemeι = Z₂ :=
    (Scheme.IdealSheafData.range_subschemeι _).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal _)
  have hrY : Set.range IY.subschemeι = ZY :=
    (Scheme.IdealSheafData.range_subschemeι _).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal _)
  obtain ⟨E₁, hE₁⟩ := wc_hm_pull_data_exists I₁.subschemeι ℓ
  obtain ⟨E₂, hE₂⟩ := wc_hm_pull_data_exists I₂.subschemeι ℓ
  obtain ⟨EY, hEY⟩ := wc_hm_pull_data_exists IY.subschemeι ℓ
  have hcover : Set.range I₁.subschemeι ∪ Set.range I₂.subschemeι = Set.univ := by
    rw [hr₁, hr₂]
    apply Set.eq_univ_of_forall
    intro x
    by_cases hx : x ∈ Z₂
    · exact Or.inr hx
    · exact Or.inl (subset_closure hx)
  have hinter : Set.range IY.subschemeι =
      Set.range I₁.subschemeι ∩ Set.range I₂.subschemeι := by
    rw [hr₁, hr₂, hrY]

  obtain ⟨ρ₁, ρ₂, hz, hS⟩ := wc_qmbt_hl_mv_closed_cover I₁.subschemeι I₂.subschemeι
    IY.subschemeι ℓ hcover hinter E₁ hE₁ E₂ hE₂ EY hEY

  obtain ⟨hpc, hH1⟩ := wc_qmbt_hl_special_fibre_h1 hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen
    hbl hblf hcov hps'
  haveI := hpc
  have hconn₁ : IsPreconnected (Set.range I₁.subschemeι)ᶜ := by
    rw [hr₁]
    exact wc_qmbt_hl_strict_compl_conn hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf
      hcov hps'
  have hconn₂ : IsPreconnected (Set.range I₂.subschemeι)ᶜ := by
    rw [hr₂]
    exact wc_qmbt_hl_exc_compl_conn hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf
      hcov hps'
  have van₁ := wc_qmbt_hl_supp_ext1_vanish I₁.subschemeι ℓ E₁ hE₁
    (wc_qmbt_hl_ker_hom_const I₁.subschemeι ℓ E₁ hE₁ hconn₁) hH1
  have van₂ := wc_qmbt_hl_supp_ext1_vanish I₂.subschemeι ℓ E₂ hE₂
    (wc_qmbt_hl_ker_hom_const I₂.subschemeι ℓ E₂ hE₂ hconn₂) hH1

  have hGE := wc_qmbt_ss_cone_ge_one hℓ' hπ' hcov hφ' halg' hpb' hps' Dp' hDp' Di' hDi' I'
  obtain ⟨ha, -, -⟩ := homology_transfer P' Di'.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ)
    Di'.μ I'
  have hΨ : ∀ q : ℤ, 2 ≤ q → Limits.IsZero
      (((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K').homology q) := by
    intro q hq
    obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le (by omega : (0 : ℤ) ≤ q)
    obtain ⟨iso⟩ := ha m
    exact Limits.IsZero.of_iso (wc_qmbt_ss_restr_higher_vanish hℓ' hπ' hcov hφ' halg' hpb' hps'
      Dp' hDp' Di' hDi' I' m (by omega)) iso
  have hR1 : Nonempty (Di'.Φ.obj
      (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology 1) ≅
        wcSuppObj EY) :=
    wc_qmbt_hl_R1_supp hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hcov
      hpb' hps' Dp' hDp' Di' hDi' I' IY.subschemeι hrY EY hEY
  have h1 : Nonempty (((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K').homology 1 ≅
      wcSuppObj EY) := by
    obtain ⟨i1⟩ := ha 1
    obtain ⟨i2⟩ := hR1
    exact ⟨i1 ≪≫ i2⟩
  obtain ⟨θ⟩ := wc_qmbt_hl_cone_single _ (wcSuppObj EY) _ eΨ' hGE hΨ h1

  have hT := hS.singleTriangle_distinguished
  let ε := (DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).app
    (SheafOfModules.unit (wcRingSheaf Xs' ℓ))
  refine ⟨(shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).preimage
      (θ.hom ≫ hS.singleTriangle.mor₃ ≫
        (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map
          ε.hom), fun g => ?_⟩
  let G : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
      (wcSuppObj EY) ⟶
      ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).obj
        (SheafOfModules.unit (wcRingSheaf Xs' ℓ)))⟦(1 : ℤ)⟧ :=
    θ.inv ≫ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map g ≫
      (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map ε.inv
  have hG0 : hS.singleTriangle.mor₂ ≫ G = 0 := by
    show (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map
      (Limits.biprod.desc ρ₁ (-ρ₂)) ≫ G = 0
    have e1 := van₁ ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map
      ρ₁ ≫ G)
    have e2 := van₂ ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map
      (-ρ₂) ≫ G)
    rw [Limits.biprod.desc_eq, Functor.map_add, Preadditive.add_comp, Functor.map_comp,
      Functor.map_comp, Category.assoc, Category.assoc, e1, e2, Limits.comp_zero,
      Limits.comp_zero, add_zero]
  obtain ⟨h, hh⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hT G hG0
  obtain ⟨k, hk⟩ : ∃ k, (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
      (1 : ℤ)).map k = h := ⟨_, Functor.map_preimage _ _⟩
  obtain ⟨e, he⟩ : ∃ e, (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
      0).map e = k := ⟨_, Functor.map_preimage _ _⟩
  obtain ⟨c₁, hc₁⟩ := wc_hm_unit_end_const Xs' ℓ e
  refine ⟨c₁, ?_⟩
  have key : (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map g =
      θ.hom ≫ G ≫
        (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map
          ε.hom := by
    simp only [G, Category.assoc, Iso.hom_inv_id_assoc, Iso.map_inv_hom_id, Category.comp_id]
  have hnat : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).map
        (wcHMConst Xs' ℓ c₁) ≫ ε.hom =
      ε.hom ≫ DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
        (wcHMConst Xs' ℓ c₁)) :=
    (DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).hom.naturality
      (wcHMConst Xs' ℓ c₁)
  apply (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map_injective
  rw [Functor.map_comp, Functor.map_preimage, key, hh, ← hk, ← he, hc₁]
  simp only [Category.assoc, ← Functor.map_comp, hnat]

theorem wc_rdfp_cone_triangle_dist {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C]
    {D : Type*} [Category D] [Abelian D] [HasDerivedCategory D]
    (P : C ⥤ D) [P.Additive] [EnoughInjectives C]
    {X Y : CochainComplex C ℤ} (φ : X ⟶ Y)
    (hX : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj X))
    (hY : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj Y))
    (hM : DerivedCategory.TStructure.t.plus
      (DerivedCategory.Q.obj (CochainComplex.mappingCone φ))) :
    ∃ c : (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
        (⟨_, hM⟩ : DerivedCategory.Plus C) ⟶
      ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
        (⟨_, hX⟩ : DerivedCategory.Plus C))⟦(1 : ℤ)⟧,
      Pretriangulated.Triangle.mk
        ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
          (ObjectProperty.homMk (X := (⟨_, hX⟩ : DerivedCategory.Plus C))
            (Y := (⟨_, hY⟩ : DerivedCategory.Plus C)) (DerivedCategory.Q.map φ)))
        ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
          (ObjectProperty.homMk (X := (⟨_, hY⟩ : DerivedCategory.Plus C))
            (Y := (⟨_, hM⟩ : DerivedCategory.Plus C))
            (DerivedCategory.Q.map (CochainComplex.mappingCone.inr φ)))) c ∈
        Pretriangulated.distinguishedTriangles :=
by
  have hplus : ∃ c₀ : (⟨_, hM⟩ : DerivedCategory.Plus C) ⟶
      (⟨_, hX⟩ : DerivedCategory.Plus C)⟦(1 : ℤ)⟧,
      Pretriangulated.Triangle.mk
        (ObjectProperty.homMk (X := (⟨_, hX⟩ : DerivedCategory.Plus C))
          (Y := (⟨_, hY⟩ : DerivedCategory.Plus C)) (DerivedCategory.Q.map φ))
        (ObjectProperty.homMk (X := (⟨_, hY⟩ : DerivedCategory.Plus C))
          (Y := (⟨_, hM⟩ : DerivedCategory.Plus C))
          (DerivedCategory.Q.map (CochainComplex.mappingCone.inr φ))) c₀ ∈
        Pretriangulated.distinguishedTriangles := by
    let ι : DerivedCategory.Plus C ⥤ DerivedCategory C := DerivedCategory.Plus.ι
    let h : DerivedCategory.Q.obj (CochainComplex.mappingCone φ) ⟶
        (DerivedCategory.Q.obj X)⟦(1 : ℤ)⟧ :=
      DerivedCategory.Q.map (CochainComplex.mappingCone.triangle φ).mor₃ ≫
        (DerivedCategory.Q.commShiftIso (1 : ℤ)).hom.app X
    let e := (ι.commShiftIso (1 : ℤ)).app (⟨_, hX⟩ : DerivedCategory.Plus C)
    refine ⟨ι.preimage (h ≫ e.inv), ?_⟩
    rw [← Functor.map_distinguished_iff ι]
    refine Pretriangulated.isomorphic_distinguished _
      (DerivedCategory.mappingCone_triangle_distinguished φ) _ ?_
    refine Pretriangulated.Triangle.isoMk _ _ (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_
    · simp [ι]
      exact (Category.comp_id _).trans (Category.id_comp _).symm
    · simp [ι]
      exact (Category.comp_id _).trans (Category.id_comp _).symm
    · simp only [Functor.mapTriangle_obj, Pretriangulated.Triangle.mk_mor₃,
        Pretriangulated.Triangle.mk_obj₁, Functor.map_preimage]
      change ((h ≫ e.inv) ≫ e.hom) ≫ (shiftFunctor (DerivedCategory C) (1 : ℤ)).map (𝟙 _) =
        𝟙 _ ≫ h
      rw [CategoryTheory.Functor.map_id]
      erw [Category.comp_id, Category.assoc, Iso.inv_hom_id, Category.comp_id, Category.id_comp]
  obtain ⟨c₀, hT⟩ := hplus
  exact ⟨_, Functor.map_distinguished (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι) _ hT⟩

theorem wc_qmbt_csz_cone_single {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    haveI := Dp'.additive
    haveI := Di'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    let eK' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xm ℓ))
          (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P' (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
        (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι'
    let eΨ' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          (ComplexShape.up ℤ) 0).map Di'.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di'.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf Xm ℓ)) ≫
        (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∃ (Y : Scheme.{u}) (iY : Y ⟶ Xs') (_ : IsClosedImmersion iY) (_ : AlgebraicGeometry.IsReduced Y)
      (EY : wcHMPullData iY ℓ), wcHMPullCanonical EY ∧
      Set.range iY = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
        (fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀} ∧
      Nonempty (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ') ≅
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
          (wcSuppObj EY)) :=
by
  intro P' K' eK' eΨ'
  haveI := Dp'.additive
  haveI := Di'.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
  haveI := Di'.presLim
  haveI := Di'.presColim
  haveI : Limits.PreservesFiniteLimits P' := by
    haveI := Dp'.adj.rightAdjoint_preservesLimits
    infer_instance
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))

  have homology_transfer : ∀ {𝒜 𝒜' ℬ : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} 𝒜']
      [Category.{u+1} ℬ] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ]
      (P : 𝒜' ⥤ 𝒜) [P.Additive] [Limits.PreservesFiniteLimits P]
      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G]
      {O' : 𝒜'} (I : InjectiveResolution O') (q : ℕ),
      Nonempty (((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)).homology (q : ℤ) ≅
          G.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ _ G _ _ _ O' I q
    let Kn := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    let L := (G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Kn
    let φ : ∀ a : Option ℕ, G.obj (P.obj (HomologicalComplex.extend.X I.cocomplex a)) ≅
        HomologicalComplex.extend.X L a := fun a =>
      match a with
      | some k => Iso.refl _
      | none => Limits.IsZero.iso (G.map_isZero (P.map_isZero (Limits.isZero_zero _)))
          (Limits.isZero_zero _)
    have hφ : ∀ a b : Option ℕ,
        (φ a).hom ≫ HomologicalComplex.extend.d L a b =
          G.map (P.map (HomologicalComplex.extend.d I.cocomplex a b)) ≫ (φ b).hom := by
      intro a b
      cases a with
      | none => exact (G.map_isZero (P.map_isZero (Limits.isZero_zero _))).eq_of_src _ _
      | some i =>
        cases b with
        | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
        | some j => exact (Category.id_comp _).trans (Category.comp_id _).symm
    let isoΨ : (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex) ≅
        L.extend ComplexShape.embeddingUpNat :=
      HomologicalComplex.Hom.isoOfComponents
        (fun i => φ (ComplexShape.embeddingUpNat.r i))
        (fun i j _ => hφ _ _)
    exact ⟨HomologicalComplex.homologyMapIso isoΨ (q : ℤ) ≪≫
      L.extendHomologyIso ComplexShape.embeddingUpNat (j := q) rfl ≪≫
      (Kn.sc q).mapHomologyIso G⟩
  have ha := homology_transfer P' Di'.Φ I'

  obtain ⟨Sset, hSdef⟩ : ∃ Sset : Set Xs', Sset =
      closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
        (fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀} := ⟨_, rfl⟩
  have hS : IsClosed Sset := by
    rw [hSdef]
    exact IsClosed.inter isClosed_closure
      (IsClosed.preimage (Scheme.Hom.continuous _) (IsLocalRing.isClosed_singleton_closedPoint B₀))
  obtain ⟨𝓘, h𝓘⟩ : ∃ 𝓘 : Xs'.IdealSheafData, Set.range 𝓘.subschemeι = Sset :=
    ⟨Scheme.IdealSheafData.vanishingIdeal ⟨Sset, hS⟩, by
      rw [Scheme.IdealSheafData.range_subschemeι,
        Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl⟩
  obtain ⟨R, r, hr, hrs, hRred⟩ := wc_reduced_subscheme_exists 𝓘.subscheme
  haveI := hr
  haveI hci : IsClosedImmersion (r ≫ 𝓘.subschemeι) := IsClosedImmersion.comp r 𝓘.subschemeι
  have hYset : Set.range (r ≫ 𝓘.subschemeι) = Sset := by
    rw [← h𝓘]
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨r x, (Scheme.Hom.comp_apply r 𝓘.subschemeι x).symm⟩
    · rintro ⟨z, rfl⟩
      have hz : z ∈ Set.range r := by rw [hrs]; exact Set.mem_univ z
      obtain ⟨x, rfl⟩ := hz
      exact ⟨x, Scheme.Hom.comp_apply r 𝓘.subschemeι x⟩
  have hYset' := hYset.trans hSdef
  obtain ⟨EY, hEY⟩ := wc_hm_pull_data_exists (r ≫ 𝓘.subschemeι) ℓ

  have hcov := wc_qmbt_hl_cov hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf
  have hGE := wc_qmbt_ss_cone_ge_one hℓ' hπ' hcov hφ' halg' hpb' hps' Dp' hDp' Di' hDi' I'
  have hΨ : ∀ q : ℤ, 2 ≤ q → Limits.IsZero
      (((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K').homology q) := by
    intro q hq
    obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le (by omega : (0 : ℤ) ≤ q)
    obtain ⟨iso⟩ := ha m
    exact Limits.IsZero.of_iso (wc_qmbt_ss_restr_higher_vanish hℓ' hπ' hcov hφ' halg' hpb' hps'
      Dp' hDp' Di' hDi' I' m (by omega)) iso
  obtain ⟨i2⟩ := wc_qmbt_hl_R1_supp hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf
    hcov hpb' hps' Dp' hDp' Di' hDi' I' (r ≫ 𝓘.subschemeι) hYset' EY hEY
  obtain ⟨i1⟩ := ha 1
  have h1 : Nonempty (((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K').homology 1 ≅
      wcSuppObj EY) := ⟨i1 ≪≫ i2⟩
  obtain ⟨θ₁⟩ := wc_qmbt_hl_cone_single _ (wcSuppObj EY) _ eΨ' hGE hΨ h1

  let σ := ((DerivedCategory.singleFunctors (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso
    1 0 1 (by norm_num)).app (wcSuppObj EY)
  refine ⟨R, r ≫ 𝓘.subschemeι, hci, hRred, EY, hEY, hYset', ⟨?_⟩⟩
  exact (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).preimageIso
    (X := DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ'))
    (Y := (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 1).obj
      (wcSuppObj EY)) (θ₁ ≪≫ σ.symm)

theorem wc_quadric_germ_base_change : ∀ (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω] (N : ℕ) (E₀ : Over (Spec (.of K))) (jE : E₀.left ⟶ wcProjK K N), IsClosedImmersion jE → jE ≫ wcProjKStr K N = E₀.hom → ∀ (a : Fin (N + 1) → Fin (N + 1) → K), (∀ (x : E₀.left) (c : Fin (N + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K N c), wcLdpGerm K N jE (wcLdpQuad K N a) c x hx ∈ IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x)) → ∃ jΩ : Limits.pullback E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) ⟶ wcProjK Ω N, IsClosedImmersion jΩ ∧ jΩ ≫ wcProjKStr Ω N = Limits.pullback.snd E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) ∧ ∀ (w : ↥(Limits.pullback E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))) (c : Fin (N + 1)) (hw : w ∈ jΩ ⁻¹ᵁ wcSgD Ω N c), wcLdpGerm Ω N jΩ (wcLdpQuad Ω N (fun p q => algebraMap K Ω (a p q))) c w hw ∈ IsLocalRing.maximalIdeal ((Limits.pullback E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))).presheaf.stalk w) :=
by
  classical
  intro K Ω _ _ _ N E₀ jE hjE hjEY a hEG

  have PB : ∀ (F F' : Type u) [Field F] [Field F'] [Algebra F F'],
      IsPullback (wcLdpProjMap F F' N) (wcProjKStr F' N) (wcProjKStr F N)
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
        (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
        [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
        (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
        (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
        (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
      intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
      have hc : ∀ x : X, ∃ i y, j i y = x := by
        intro x
        have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
        exact ⟨i, y, hy⟩
      refine Scheme.isPullback_of_openCover φ p' p g
        (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
      intro i
      have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
        (hcomm i) (hpre i)).flip
      refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
        rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
      · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
        rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
      · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
        rw [Category.comp_id, Category.id_comp]
      · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
        rw [Category.comp_id, Category.id_comp]
    intro F F' _ _ _

    have s2 : ∀ (K : Type u) [Field K] (a : Fin (N + 1)),
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K), s = MvPolynomial.X a →
        ∃ e : MvPolynomial (Fin N) K ≃+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s,
        (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
        ∀ j : Fin N, (e (MvPolynomial.X j)).val =
          Localization.mk (MvPolynomial.X (a.succAbove j)) ⟨s, Submonoid.mem_powers s⟩ := by
      intro K _ a
      letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s hs
      subst hs

      have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
          (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
        intro S _ φ x t n F hF
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d hd => ?_)
        have hdeg : Finsupp.degree d = n := by
          by_contra h
          exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
        rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
        have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
          simp only [mul_pow]
          rw [Finsupp.prod_mul]
          congr 1
          rw [← hdeg, Finsupp.degree_apply]
          unfold Finsupp.prod
          rw [Finset.prod_pow_eq_pow_sum]
        rw [hp]
        ring
      have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
      have hg : ∀ i : Fin N, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := fun i =>
        (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)

      obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin N) K →+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X a),
          (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
          (∀ i : Fin N, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX 1
            (MvPolynomial.X (a.succAbove i)) (hg i)) :=
        ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
          (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
          fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
          fun i => by rw [MvPolynomial.eval₂Hom_X']⟩

      obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin N) K,
          (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
          (∀ i : Fin N, ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) :=
        ⟨MvPolynomial.eval₂Hom MvPolynomial.C
            (Fin.insertNth (α := fun _ => MvPolynomial (Fin N) K) a 1 MvPolynomial.X),
          fun c => by rw [MvPolynomial.eval₂Hom_C],
          by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
          fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
      have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
      have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.X a) = 1 := by
        rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))

      obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) →+*
          MvPolynomial (Fin N) K,
          (∀ z y, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) z =
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) y → ρ z = ρt y) ∧
          (∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K)
            (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)),
            ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              hX n F hF) = ρt F) := by
        refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K).comp (algebraMap _ _), ?_, ?_⟩
        · intro z y hzy
          rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
        · intro n F hF
          rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk]
          have hs := IsLocalization.mk'_spec
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F
            (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
              Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
          rw [← Localization.mk_eq_mk'_apply] at hs
          have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K) hs
          rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
          simp only [map_pow, hρa, one_pow, mul_one] at hs2
          exact hs2
      have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.C c)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.C c) := by
        intro c
        rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
        have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
            MvPolynomial.C c := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← h1]
        rfl
      have hΨX : ∀ i : Fin N, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.X i)) =
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (MvPolynomial.X (a.succAbove i)) := by
        intro i
        rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
          ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        congr 1
        ext
        simp
      have hcomp : ((algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp ψ).comp ρt =
          MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
            RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
          rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
          · subst h
            rw [hρa, map_one, map_one, hu1]
          · subst h
            rw [hρs, hΨX]
      have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X']
      have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (ψ (ρt F)) *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X a ^ n) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by
        intro n F hF
        have h1 := RingHom.congr_fun hcomp F
        rw [RingHom.comp_apply, RingHom.comp_apply] at h1
        rw [h1, MvPolynomial.coe_eval₂Hom]
        have hs := scale ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j))
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
        rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
        calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) ^ n *
