        intro z
        have h1 := congrArg (fun y : ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj
            (SheafOfModules.unit (wcRingSheaf S ℓ))).obj.obj U =>
          ((show C(↥U.unop.left, ULift.{u+1} ℚ_[ℓ]) from y) z).down) hf
        change c * (((show C(↥U.unop.left, ULift.{u+1} ℤ_[ℓ]) from f₁) z).down : ℚ_[ℓ]) =
          c * (((show C(↥U.unop.left, ULift.{u+1} ℤ_[ℓ]) from f₂) z).down : ℚ_[ℓ]) at h1
        exact ULift.ext _ _ (PadicInt.ext (mul_left_cancel₀ hc h1)))
    haveI : Mono (ψ c).hom := NatTrans.mono_of_mono_app _
    exact Sheaf.Hom.mono_of_presheaf_mono _ _ _

  have hvZ : ∀ (U : (S.ProEt)ᵒᵖ) (a : FZ.obj.obj U) (z : ↥U.unop.left), U.unop.hom z ∈ C →
      (show C(↥U.unop.left, ULift.{u+1} ℤ_[ℓ]) from (ιZ.hom.app U).hom a) z = 0 :=
    fun U a z hz => (hZ U.unop ((ιZ.hom.app U).hom a)).mp ⟨a, rfl⟩ z hz

  obtain ⟨t, ht⟩ := hlift ιZ hZm (ιZ ≫ σ) (fun U a => (hZ U.unop _).mpr (fun z hz => by
      have h0 := hvZ U a z hz
      apply ULift.ext
      apply PadicInt.ext
      change (((ℓ : ℤ_[ℓ]) * ((show C(↥U.unop.left, ULift.{u+1} ℤ_[ℓ]) from
        (ιZ.hom.app U).hom a) z).down : ℤ_[ℓ]) : ℚ_[ℓ]) = ((0 : ℤ_[ℓ]) : ℚ_[ℓ])
      rw [h0]
      simp))

  have hκex : ∀ n : ℕ, ∃ κn : FZ ⟶ FQ, κn ≫ ιQ = ιZ ≫ ψ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) := fun n =>
    hlift ιQ hQm _ (fun U a => (hQ U.unop _).mpr (fun z hz => by
      have h0 := hvZ U a z hz
      apply ULift.ext
      change ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (((show C(↥U.unop.left, ULift.{u+1} ℤ_[ℓ]) from
        (ιZ.hom.app U).hom a) z).down : ℚ_[ℓ]) = 0
      rw [h0]
      simp))
  choose κ₀ hκ₀ using hκex

  have hnat : ∀ n : ℕ, t ≫ κ₀ (n + 1) = κ₀ n := by
    intro n
    apply (cancel_mono ιQ).1
    rw [Category.assoc, hκ₀, ← Category.assoc, ht, Category.assoc, hκ₀]
    have e : ((ℓ : ℚ_[ℓ]) ^ (n + 1))⁻¹ * (ℓ : ℚ_[ℓ]) = ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ := by
      rw [pow_succ, mul_inv, mul_assoc, inv_mul_cancel₀ hℓ0, mul_one]
    have key : σ ≫ ψ (((ℓ : ℚ_[ℓ]) ^ (n + 1))⁻¹) = ψ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro f
      apply extQ U
      intro z
      apply ULift.ext
      change ((ℓ : ℚ_[ℓ]) ^ (n + 1))⁻¹ * ((((ℓ : ℤ_[ℓ]) *
          ((show C(↥U.unop.left, ULift.{u+1} ℤ_[ℓ]) from f) z).down : ℤ_[ℓ])) : ℚ_[ℓ]) =
        ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (((show C(↥U.unop.left, ULift.{u+1} ℤ_[ℓ]) from f) z).down : ℚ_[ℓ])
      rw [PadicInt.coe_mul, PadicInt.coe_natCast, ← mul_assoc, e]
    rw [key]

  obtain ⟨κ, hκapp⟩ : ∃ κ : Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t) ⟶
      (Functor.const ℕ).obj FQ, ∀ n : ℕ, κ.app n = κ₀ n :=
    ⟨NatTrans.ofSequence κ₀ (fun n => by
      rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map]
      exact (hnat n).trans (Category.comp_id _).symm), fun n => NatTrans.ofSequence_app _ _ n⟩

  have hmono : ∀ n, Mono (κ.app n) := by
    intro n
    rw [hκapp n]
    have hψn := hψmono (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) (inv_ne_zero (pow_ne_zero n hℓ0))
    have hc : Mono (κ₀ n ≫ ιQ) := by
      rw [hκ₀ n]
      exact @mono_comp _ _ _ _ _ ιZ hZm _ hψn
    exact @mono_of_mono _ _ _ _ _ (κ₀ n) ιQ hc

  have hsurj : ∀ (V W : S.ProEt) (f : W ⟶ V) (s : FQ.obj.obj (Opposite.op V)), IsAffine W.left →
      ∃ (n : ℕ) (k : FZ.obj.obj (Opposite.op W)),
        ((κ₀ n).hom.app (Opposite.op W)).hom k = (FQ.obj.map f.op).hom s := by
    intro V W f s hW
    haveI := hW
    haveI : CompactSpace ↥W.left := inferInstance
    let g0 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
      (ιQ.hom.app (Opposite.op W)).hom ((FQ.obj.map f.op).hom s))
    let gd : C(↥W.left, ℚ_[ℓ]) := ⟨fun z => (g0 z).down, continuous_uliftDown.comp g0.continuous⟩
    obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn gd.continuous.continuousOn
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt B hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := pow_pos (by linarith) n
    have hbd : ∀ z, ‖(ℓ : ℚ_[ℓ]) ^ n * gd z‖ ≤ 1 := by
      intro z
      have h1 := hB z (Set.mem_univ z)
      rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
      linarith
    let h0 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun z => ULift.up ⟨(ℓ : ℚ_[ℓ]) ^ n * gd z, hbd z⟩,
        continuous_uliftUp.comp ((continuous_const.mul gd.continuous).subtype_mk _)⟩
    obtain ⟨k, hk⟩ := (hZ W h0).mpr (fun z hz => by
      have hg : g0 z = 0 := (hQ W _).mp ⟨_, rfl⟩ z hz
      apply ULift.ext
      apply PadicInt.ext
      change (ℓ : ℚ_[ℓ]) ^ n * (g0 z).down = ((0 : ℤ_[ℓ]) : ℚ_[ℓ])
      rw [hg]
      simp)
    refine ⟨n, k, ?_⟩
    apply hinj ιQ hQm (Opposite.op W)
    have e1 : (ιQ.hom.app (Opposite.op W)).hom (((κ₀ n).hom.app (Opposite.op W)).hom k) =
        ((κ₀ n ≫ ιQ).hom.app (Opposite.op W)).hom k := rfl
    rw [e1, hκ₀ n]
    change ((ψ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)).hom.app (Opposite.op W)).hom
      ((ιZ.hom.app (Opposite.op W)).hom k) = _
    rw [hk]
    apply extQ
    intro z
    apply ULift.ext
    exact inv_mul_cancel_left₀ (pow_ne_zero n hℓ0) (gd z)

  have affine_sieve : ∀ (V : S.ProEt) (R : Sieve V),
      (∀ (W : S.ProEt) (f : W ⟶ V), IsAffine W.left → R.arrows f) →
      R ∈ Scheme.ProEt.topology S V := by
    intro V R hR
    have hV : WeaklyEtale V.hom := V.prop
    let W : V.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (V.left.affineCover.f i ≫ V.hom) inferInstance
    let g : ∀ i, W i ⟶ V := fun i => MorphismProperty.Over.homMk (V.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S).coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change V.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
        V.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR (W i) (g i) (show IsAffine (V.left.affineCover.X i) by infer_instance)

  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (κ : G ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc G (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T G κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc G (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit G).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit G)⟩

  have hepi : Epi (Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t))
      (Limits.Cocone.mk FQ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
        (Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t))
          (Limits.Cocone.mk FQ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W f hW
      obtain ⟨n, k, hk⟩ := hsurj V W f s hW
      refine ⟨(Limits.colimit.ι (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t)) n).hom.app
        (Opposite.op W) k, ?_⟩
      change (Limits.colimit.ι (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t)) n ≫
        Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t))
          (Limits.Cocone.mk FQ κ)).hom.app (Opposite.op W) k = _
      rw [Limits.colimit.ι_desc]
      change (κ.app n).hom.app (Opposite.op W) k = _
      rw [hκapp n]
      exact hk
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls
  have hcol : Limits.IsColimit (Limits.Cocone.mk FQ κ) := (crit FQ _ κ hmono hepi).some

  have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : wcFreeSheaf S V ⟶ c.pt, ∃ (n : ℕ) (g' : wcFreeSheaf S V ⟶ G.obj n),
        g = g' ≫ c.ι.app n :=
    fun G c hc => (proet_free_hom_seq_colimit S V G c hc).1
  have H1 : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (α : G ⟶ I),
        Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S V) c.pt (k + 1)), x = 0 := by
    intro G
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    exact ⟨I, α, hα, fun c hc k x => proet_ext_colimit_injectives_vanish S V I hI c hc k x⟩
  obtain ⟨n, y, hy⟩ := ext_seq_colimit_lift_of_acyclic
    (wcFreeSheaf S V) H0 H1 j _ (Limits.Cocone.mk FQ κ) hcol x
  have hy0 : y = 0 := h y
  rw [hy, hy0, Abelian.Ext.zero_comp]

theorem wc_hm_unit_supp_ker_ext_vanish_of_et_deg {S Z : Scheme.{u}} (i : Z ⟶ S)
    [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] [CompactSpace S] [QuasiSeparatedSpace S]
    (hsep : IsSeparated (Limits.terminal.from S))
    (E : wcHMPullData i ℓ) (hE : wcHMPullCanonical E) (j : ℕ)
    (het : ∀ k : ℕ,
      Subsingleton (wcEtExt S (wcEtExtZero S (Set.range i)ᶜ (ℓ ^ (k + 1))) (j + 1))) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∀ x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf S ℓ))
      (Limits.kernel (wcSuppUnitMap E)) (j + 1), x = 0 :=
by
  classical
  intro x

  obtain ⟨ιQ, hQm, hQ⟩ := wc_hm_kernel_toSheaf_vanSub i ℓ E hE
  obtain ⟨⟨FZ, ιZ, hZm, hZ⟩, hTor⟩ := wc_proet_vanishing_subsheaf_exists i ℓ
  choose FK ιK hKm hK using fun k' : ℕ => hTor (ℓ ^ (k' + 1))
  haveI hcptT : CompactSpace ↥(Scheme.ProEt.mk (𝟙 S)).left := ‹CompactSpace S›
  haveI hqsT : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 S)).left := ‹QuasiSeparatedSpace S›
  haveI hsepT' : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 S)).left) := hsep
  have hC : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range

  have hT : ∀ (k' : ℕ) (z : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (FK k') (j + 1)),
      z = 0 := by
    intro k' z
    obtain ⟨eqv⟩ := wc_proet_vanSub_zmod_ext_equiv_et S
      (Scheme.ProEt.mk (𝟙 S)) (Set.range i) hC (ℓ ^ (k' + 1)) (FK k') (ιK k')
      (hKm k') (hK k') (j + 1)
    have hsub := het k'
    exact eqv.injective (@Subsingleton.elim _ hsub _ _)

  haveI := wc_proet_products_exact S
  obtain ⟨r, c, hr, hc, hcs⟩ := wc_vanish_tower_reduction_maps S (Set.range i) ℓ FZ ιZ hZm hZ
    FK ιK hKm hK
  obtain ⟨hzero, hS⟩ := wc_vanish_tower_shortExact S (Set.range i) ℓ FZ ιZ hZm hZ FK ιK hKm hK
    r c hr hc hcs
  have hTn : ∀ n, Limits.Pi.lift (fun n => Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n) ≫
      Limits.Pi.π FK n = Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n :=
    fun n => Limits.Pi.lift_comp_π _ n
  have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))
    (∏ᶜ FK) FK (Limits.Pi.π FK) (Limits.productIsProduct FK) N

  have N1 : ∀ (P Z' Y' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (B : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (pr : ∀ n, Y' ⟶ B n)
      (c : ∀ n, B (n + 1) ⟶ B n) (T : Y' ⟶ Y') (hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n)
      (f : Z' ⟶ Y') (hzero : f ≫ T = 0) (hS : (ShortComplex.mk f T hzero).ShortExact)
      (hinj : ∀ (N : ℕ) (x : Abelian.Ext P Y' N),
        (∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = 0) → x = 0)
      (hsurj : ∀ (N : ℕ) (y : ∀ n, Abelian.Ext P (B n) N), ∃ x : Abelian.Ext P Y' N,
        ∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = y n)
      (hB : ∀ (n : ℕ) (x : Abelian.Ext P (B n) (j + 1)), x = 0)
      (hc : ∀ (n : ℕ) (y : Abelian.Ext P (B n) j), ∃ z : Abelian.Ext P (B (n + 1)) j,
        z.comp (Abelian.Ext.mk₀ (c n)) (add_zero j) = y),
      ∀ x : Abelian.Ext P Z' (j + 1), x = 0 := by
    intro P Z' Y' B pr c T hT f hzero hS hinj hsurj hB hc
    have s4 : ∀ y : Abelian.Ext P Y' j, ∃ w : Abelian.Ext P Y' j,
        w.comp (Abelian.Ext.mk₀ T) (add_zero j) = y := by
      intro y
      choose g hg using hc
      let x : ∀ n, Abelian.Ext P (B n) j := fun n =>
        Nat.rec (motive := fun n => Abelian.Ext P (B n) j) 0
          (fun n xn => g n (xn - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j))) n
      have hx : ∀ n, (x (n + 1)).comp (Abelian.Ext.mk₀ (c n)) (add_zero j) =
          x n - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) := fun n => hg n _
      obtain ⟨w, hw⟩ := hsurj j x
      refine ⟨w, ?_⟩
      rw [← sub_eq_zero]
      apply hinj j
      intro n
      have key : ∀ (a b : Abelian.Ext P Y' j) (g : Y' ⟶ B n),
          (a - b).comp (Abelian.Ext.mk₀ g) (add_zero j) =
            a.comp (Abelian.Ext.mk₀ g) (add_zero j) - b.comp (Abelian.Ext.mk₀ g) (add_zero j) := by
        intro a b g
        rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
      have h1 : (w.comp (Abelian.Ext.mk₀ T) (add_zero j)).comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) =
          w.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) -
            (w.comp (Abelian.Ext.mk₀ (pr (n + 1))) (add_zero j)).comp (Abelian.Ext.mk₀ (c n))
              (add_zero j) := by
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hT n,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, Abelian.Ext.comp_add,
          Abelian.Ext.comp_neg, ← sub_eq_add_neg]
      rw [key, h1, hw, hw, hx]
      abel
    intro z
    have h0 : z.comp (Abelian.Ext.mk₀ f) (add_zero (j + 1)) = 0 := hinj _ _ (fun n => hB n _)
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS z h0 (rfl : j + 1 = j + 1)
    rw [← hx₃]
    obtain ⟨w, hw⟩ := s4 x₃
    rw [← hw, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h2 := hS.comp_extClass
    erw [h2, Abelian.Ext.comp_zero]

  have N3 : ∀ k : ℕ, ∃ φ : ZMod (ℓ ^ (0 + 1)) →+ ZMod (ℓ ^ (k + 1 + 1)),
      Function.Injective φ ∧
        ∀ b : ZMod (ℓ ^ (k + 1 + 1)), wcTowerCast ℓ (k + 1) b = 0 ↔ ∃ a, φ a = b := by
    intro k
    have hℓ1 : 1 < ℓ := (Fact.out : Nat.Prime ℓ).one_lt
    have hℓ0 : ℓ ≠ 0 := by omega
    have hqpos : 0 < ℓ ^ (k + 1) := pow_pos (by omega) _
    haveI : NeZero (ℓ ^ (0 + 1)) := ⟨pow_ne_zero _ hℓ0⟩
    haveI : NeZero (ℓ ^ (k + 1 + 1)) := ⟨pow_ne_zero _ hℓ0⟩
    have hφc : (zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1))) ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))))
        ((ℓ ^ (0 + 1) : ℕ) : ℤ) = 0 := by
      rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, ← Nat.cast_mul,
        ZMod.natCast_eq_zero_iff]
      exact ⟨1, by ring⟩
    obtain ⟨φ, hφdef⟩ : ∃ φ : ZMod (ℓ ^ (0 + 1)) →+ ZMod (ℓ ^ (k + 1 + 1)),
        φ = ZMod.lift (ℓ ^ (0 + 1)) ⟨zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1)))
          ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))), hφc⟩ := ⟨_, rfl⟩
    have hF : ∀ m : ℕ, φ (m : ZMod (ℓ ^ (0 + 1))) =
        ((m * ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))) := by
      intro m
      rw [show ((m : ℕ) : ZMod (ℓ ^ (0 + 1))) = ((m : ℤ) : ZMod (ℓ ^ (0 + 1))) from
        (Int.cast_natCast m).symm, hφdef, ZMod.lift_coe]
      show (zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1))) ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))))
        ((m : ℕ) : ℤ) = _
