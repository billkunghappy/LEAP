theorem wc_ykp_compatible_roots (L : Type u) [Field L] [IsSepClosed L] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓL : ((ℓ : ℕ) : L) ≠ 0) :
    ∃ ζ : ℕ → L, (∀ m, IsPrimitiveRoot (ζ m) (ℓ ^ m)) ∧ ∀ m, ζ (m + 1) ^ ℓ = ζ m :=
by
  classical
  haveI : NeZero ((ℓ : ℕ) : L) := ⟨hℓL⟩
  have hp : ℓ.Prime := Fact.out
  haveI := IsSepClosed.hasEnoughRootsOfUnity_pow L ℓ 1
  obtain ⟨ξ, hξ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L (ℓ ^ 1)
  rw [pow_one] at hξ
  have hroot : ∀ x : L, ∃ z : L, z ^ ℓ = x := fun x => IsSepClosed.exists_pow_nat_eq x ℓ
  choose r hr using hroot
  let ζ : ℕ → L := fun m => Nat.casesOn m 1 (fun k => r^[k] ξ)
  have hζ0 : ζ 0 = 1 := rfl
  have hζ1 : ζ 1 = ξ := rfl
  have hζs : ∀ k, ζ (k + 1 + 1) = r (ζ (k + 1)) := fun k => Function.iterate_succ_apply' r k ξ
  have hcompat : ∀ m, ζ (m + 1) ^ ℓ = ζ m := by
    intro m
    cases m with
    | zero => show ξ ^ ℓ = 1; exact hξ.pow_eq_one
    | succ k => rw [hζs, hr]
  have hprim : ∀ k, IsPrimitiveRoot (ζ (k + 1)) (ℓ ^ (k + 1)) := by
    intro k
    induction k with
    | zero => show IsPrimitiveRoot ξ (ℓ ^ (0 + 1)); rw [zero_add, pow_one]; exact hξ
    | succ k ih =>
      have hz : ζ (k + 1 + 1) ^ ℓ = ζ (k + 1) := hcompat (k + 1)
      apply IsPrimitiveRoot.iff_orderOf.mpr
      apply orderOf_eq_prime_pow
      · rw [pow_succ' ℓ k, pow_mul, hz]
        exact ih.pow_ne_one_of_pos_of_lt (pow_ne_zero _ hp.ne_zero)
          (Nat.pow_lt_pow_right hp.one_lt (Nat.lt_succ_self k))
      · rw [pow_succ' ℓ (k + 1), pow_mul, hz]
        exact ih.pow_eq_one
  refine ⟨ζ, fun m => ?_, hcompat⟩
  cases m with
  | zero => show IsPrimitiveRoot (1 : L) (ℓ ^ 0); rw [pow_zero]; exact IsPrimitiveRoot.one
  | succ k => exact hprim k

theorem wc_ykp_dlog_iso (L : Type u) [Field L] (S : Scheme.{u}) (qS : S ⟶ Spec (.of L)) (m : ℕ)
    (hm : 0 < m) (hmL : ((m : ℕ) : L) ≠ 0) (ζ : L) (hζ : IsPrimitiveRoot ζ m)
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S m)) :
    ∃ e : wcYkpMu S m hμ ≅ wcContSheaf S (ZMod m), wcYkpDlog L S qS m ζ hμ e :=
by
  classical
  have hdlog : ∀ (Z : Scheme.{u}) (m : ℕ) [NeZero m] (ω : Γ(Z, ⊤)),
      (∀ z : Z, IsPrimitiveRoot ((Z.evaluation ⊤ z trivial).hom ω) m) →
      ∃ L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m),
        ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
          L v z = (j : ZMod m) ↔
            (Z.evaluation ⊤ z trivial).hom
                (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
              ((Z.evaluation ⊤ z trivial).hom ω) ^ j := by
      classical
      intro Z m _ ω hprim

      have hfield : ∀ (K : Type u) [Field K] (ζ x : K), IsPrimitiveRoot ζ m → x ^ m = 1 →
          ∃ a : ZMod m, ∀ j : ℕ, a = (j : ZMod m) ↔ x = ζ ^ j := by
        intro K _ ζ x hζ hx
        obtain ⟨i, hi, hix⟩ := hζ.eq_pow_of_pow_eq_one hx
        refine ⟨(i : ZMod m), fun j => ?_⟩
        have hjm : j % m < m := Nat.mod_lt j (NeZero.pos m)
        have hpm : ζ ^ j = ζ ^ (j % m) := by
          have h := pow_mod_orderOf ζ j
          rw [← hζ.eq_orderOf] at h
          exact h.symm
        rw [ZMod.natCast_eq_natCast_iff' i j m, Nat.mod_eq_of_lt hi, ← hix, hpm]
        constructor
        · intro h; rw [h]
        · intro h; exact hζ.pow_inj hi hjm h

      have hx1 : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z),
          ((Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤))) ^ m = 1 := by
        intro v z
        have h0 : (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) ^ m = 1 := by
          have h := (Additive.toMul v).2
          rw [mem_rootsOfUnity] at h
          rw [← Units.val_pow_eq_pow_val, h, Units.val_one]
        rw [← map_pow, h0, map_one]

      have hopen : ∀ (x : Γ(Z, ⊤)) (k : ℕ), (∀ z : Z, ((Z.evaluation ⊤ z trivial).hom x) ^ m = 1) →
          k < m → IsOpen {z : Z | (Z.evaluation ⊤ z trivial).hom x =
            ((Z.evaluation ⊤ z trivial).hom ω) ^ k} := by
        intro x k hx hk
        have heq : {z : Z | (Z.evaluation ⊤ z trivial).hom x =
            ((Z.evaluation ⊤ z trivial).hom ω) ^ k} =
            ⋂ j ∈ (Finset.range m).erase k, ((Z.basicOpen (x - ω ^ j) : Z.Opens) : Set Z) := by
          ext z
          have hmem : ∀ j : ℕ, z ∈ ((Z.basicOpen (x - ω ^ j) : Z.Opens) : Set Z) ↔
              (Z.evaluation ⊤ z trivial).hom x ≠ ((Z.evaluation ⊤ z trivial).hom ω) ^ j := by
            intro j
            have h := Scheme.evaluation_ne_zero_iff_mem_basicOpen Z (U := ⊤) z trivial (x - ω ^ j)
            rw [SetLike.mem_coe, ← h, map_sub, map_pow, sub_ne_zero]
          simp only [Set.mem_setOf_eq, Set.mem_iInter, Finset.mem_erase, Finset.mem_range, hmem]
          constructor
          · rintro h j ⟨hjk, hj⟩ h'
            exact hjk ((hprim z).pow_inj hj hk (h'.symm.trans h))
          · intro h
            obtain ⟨i, hi, hix⟩ := (hprim z).eq_pow_of_pow_eq_one (hx z)
            by_cases hik : i = k
            · rw [← hix, hik]
            · exact absurd hix.symm (h i ⟨hik, hi⟩)
        rw [heq]
        exact isOpen_biInter_finset (fun j _ => (Z.basicOpen (x - ω ^ j)).isOpen)

      have hspec : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z), ∃ a : ZMod m, ∀ j : ℕ,
          a = (j : ZMod m) ↔
            (Z.evaluation ⊤ z trivial).hom
                (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
              ((Z.evaluation ⊤ z trivial).hom ω) ^ j :=
        fun v z => hfield _ _ _ (hprim z) (hx1 v z)
      choose f hf using hspec
      have hval : ∀ v z, (Z.evaluation ⊤ z trivial).hom
          (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
            ((Z.evaluation ⊤ z trivial).hom ω) ^ (f v z).val := by
        intro v z
        exact (hf v z (f v z).val).1 (ZMod.natCast_zmod_val _).symm
      have hcont : ∀ v, Continuous (f v) := by
        intro v
        rw [continuous_discrete_rng]
        intro a
        have hpre : f v ⁻¹' {a} = {z : Z | (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
              ((Z.evaluation ⊤ z trivial).hom ω) ^ a.val} := by
          ext z
          simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq]
          rw [← hf v z a.val, ZMod.natCast_zmod_val]
        rw [hpre]
        exact hopen _ a.val (hx1 v) (ZMod.val_lt a)
      let F : Additive (rootsOfUnity m Γ(Z, ⊤)) → C(Z, ZMod m) := fun v => ⟨f v, hcont v⟩

      refine ⟨AddMonoidHom.mk' F ?_, ?_⟩
      · intro v w
        ext z
        show f (v + w) z = f v z + f w z
        have hmul : (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul (v + w) : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
            (Z.evaluation ⊤ z trivial).hom
              (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) *
            (Z.evaluation ⊤ z trivial).hom
              (((Additive.toMul w : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) := by
          rw [toMul_add, Subgroup.coe_mul, Units.val_mul, map_mul]
        have h := (hf (v + w) z ((f v z).val + (f w z).val)).2
          (by rw [hmul, hval v z, hval w z, pow_add])
        rw [h, Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      · intro v z j
        exact hf v z j
  have hinj : ∀ (Z : Scheme.{u}) (m : ℕ) [NeZero m] (ω : Γ(Z, ⊤))
      (L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m))
      (hmU : IsUnit ((m : ℕ) : Γ(Z, ⊤)))
      (hL : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
            L v z = (j : ZMod m) ↔
              (Z.evaluation ⊤ z trivial).hom
                  (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
                ((Z.evaluation ⊤ z trivial).hom ω) ^ j),
      Function.Injective L := by
    intro Z m _ ω L hmU hL
    rw [injective_iff_map_eq_zero]
    intro v hv
    have h1 : ∀ z : Z, (Z.evaluation ⊤ z trivial).hom
        (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) = 1 := by
      intro z
      have := (hL v z 0).1 (by rw [hv]; simp)
      rw [this, pow_zero]
    generalize hx : (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) = x at h1
    have hxm : x ^ m = 1 := by
      have h := (Additive.toMul v).2
      rw [mem_rootsOfUnity] at h
      rw [← hx, ← Units.val_pow_eq_pow_val, h, Units.val_one]
    have hgx : (∑ i ∈ Finset.range m, x ^ i) * (x - 1) = 0 := by
      rw [geom_sum_mul, hxm, sub_self]
    have hgU : IsUnit (∑ i ∈ Finset.range m, x ^ i) := by
      apply RingedSpace.isUnit_of_isUnit_germ Z.toRingedSpace ⊤
      intro z _
      refine (Z.mem_basicOpen_top _ z).mp ((Z.evaluation_ne_zero_iff_mem_basicOpen (U := ⊤) z trivial _).mp ?_)
      rw [map_sum]
      simp only [map_pow, h1, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
      have hu : IsUnit ((Z.evaluation ⊤ z trivial).hom ((m : ℕ) : Γ(Z, ⊤))) := hmU.map _
      rw [map_natCast] at hu
      exact hu.ne_zero
    have hx1 : x = 1 := sub_eq_zero.mp ((hgU.mul_right_eq_zero).mp hgx)
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Units.ext
    rw [hx, hx1]
    rfl
  have hsurj : ∀ (Z : Scheme.{u}) (m : ℕ) [NeZero m] (ω : Γ(Z, ⊤))
      (L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m))
      (hωm : ω ^ m = 1)
      (hL : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
            L v z = (j : ZMod m) ↔
              (Z.evaluation ⊤ z trivial).hom
                  (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
                ((Z.evaluation ⊤ z trivial).hom ω) ^ j),
      Function.Surjective L := by
    intro Z m _ ω L hωm hL
    intro h
    let U : ZMod m → Z.Opens := fun c =>
      ⟨h ⁻¹' {c}, h.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
    have hU : (⊤ : Z.Opens) ≤ iSup U := by
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨h z, rfl⟩
    let sf : ∀ c : ZMod m, Γ(Z, U c) := fun c =>
      (Z.presheaf.map (homOfLE (le_top : U c ≤ ⊤)).op).hom (ω ^ c.val)
    have hcompat : TopCat.Presheaf.IsCompatible Z.sheaf.obj U sf := by
      intro c d
      apply TopCat.Presheaf.section_ext Z.sheaf (U c ⊓ U d)
      intro x hx
      have hc : h x = c := hx.1
      have hd : h x = d := hx.2
      have hcd : c = d := hc.symm.trans hd
      subst hcd
      rfl
    obtain ⟨s, hs', -⟩ : ∃! s : Γ(Z, ⊤),
        ∀ c, (Z.presheaf.map (homOfLE (le_top : U c ≤ ⊤)).op).hom s = sf c :=
      TopCat.Sheaf.existsUnique_gluing' Z.sheaf U ⊤ (fun c => homOfLE le_top) hU sf hcompat
    have hgerm : ∀ (x : Z) (hx : x ∈ (⊤ : Z.Opens)), (Z.presheaf.germ ⊤ x hx).hom s =
        (Z.presheaf.germ ⊤ x hx).hom (ω ^ (h x).val) := by
      intro x hx0
      have hxU : x ∈ U (h x) := rfl
      rw [← TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE (le_top : U (h x) ≤ ⊤)) x hxU s,
        hs' (h x)]
      exact TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE (le_top : U (h x) ≤ ⊤)) x hxU _
    have hsm : s ^ m = 1 := by
      apply TopCat.Presheaf.section_ext Z.sheaf ⊤
      intro x hx
      have e : (Z.presheaf.germ ⊤ x hx).hom (s ^ m) = (Z.presheaf.germ ⊤ x hx).hom 1 := by
        rw [map_pow, hgerm x hx, ← map_pow, ← pow_mul, mul_comm, pow_mul, hωm, one_pow]
      exact e
    refine ⟨Additive.ofMul (rootsOfUnity.mkOfPowEq s hsm), ?_⟩
    ext z
    rw [← ZMod.natCast_zmod_val (h z)]
    apply (hL _ z _).2
    have hval : (((Additive.toMul (Additive.ofMul (rootsOfUnity.mkOfPowEq s hsm)) :
        rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) = s :=
      rootsOfUnity.val_mkOfPowEq_coe s hsm
    rw [hval, ← map_pow]
    exact congrArg (Z.residue z).hom (hgerm z trivial)
  have hnat : ∀ (Z Z' : Scheme.{u}) (f : Z' ⟶ Z) (m : ℕ) [NeZero m]
      (ω : Γ(Z, ⊤)) (ω' : Γ(Z', ⊤))
      (L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m))
      (L' : Additive (rootsOfUnity m Γ(Z', ⊤)) →+ C(Z', ZMod m))
      (hω : f.appTop.hom ω = ω')
      (hL : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
            L v z = (j : ZMod m) ↔
              (Z.evaluation ⊤ z trivial).hom
                  (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
                ((Z.evaluation ⊤ z trivial).hom ω) ^ j)
      (hL' : ∀ (v : Additive (rootsOfUnity m Γ(Z', ⊤))) (z : Z') (j : ℕ),
            L' v z = (j : ZMod m) ↔
              (Z'.evaluation ⊤ z trivial).hom
                  (((Additive.toMul v : rootsOfUnity m Γ(Z', ⊤)) : Γ(Z', ⊤)ˣ) : Γ(Z', ⊤)) =
                ((Z'.evaluation ⊤ z trivial).hom ω') ^ j),
      ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z' : Z'),
        L' (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) v) z' = L v (f z') := by
    intro Z Z' f m _ ω ω' L L' hω hL hL'
    intro v z'
    have h1 := (hL v (f z') (L v (f z')).val).1 (ZMod.natCast_zmod_val _).symm
    have h2 := congrArg (f.residueFieldMap z').hom h1
    rw [map_pow] at h2
    have e1 := Scheme.evaluation_naturality_apply f (V := ⊤) z' trivial
      (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤))
    have e2 := Scheme.evaluation_naturality_apply f (V := ⊤) z' trivial ω
    rw [← ZMod.natCast_zmod_val (L v (f z'))]
    apply (hL' _ z' _).2
    subst hω
    exact e1.symm.trans (h2.trans (congrArg (· ^ (L v (f z')).val) e2))
  haveI : NeZero m := ⟨hm.ne'⟩
  let ψ : ∀ W : S.ProEt, L →+* Γ(W.left, ⊤) := fun W =>
    (W.hom ≫ qS).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom
  have hP1 : ∀ (W : S.ProEt) (z : W.left),
      IsPrimitiveRoot ((W.left.evaluation ⊤ z trivial).hom (ψ W ζ)) m := by
    intro W z
    exact hζ.map_of_injective (f := (W.left.evaluation ⊤ z trivial).hom.comp (ψ W))
      (RingHom.injective _)
  have hP2 : ∀ W : S.ProEt, IsUnit ((m : ℕ) : Γ(W.left, ⊤)) := by
    intro W
    have h := (Ne.isUnit hmL).map (ψ W)
    rwa [map_natCast] at h
  have hP3 : ∀ W : S.ProEt, ψ W ζ ^ m = 1 := by
    intro W
    rw [← map_pow, hζ.pow_eq_one, map_one]
  have hP4 : ∀ {W W' : S.ProEt} (g : W' ⟶ W), g.left.appTop.hom (ψ W ζ) = ψ W' ζ := by
    intro W W' g
    show g.left.appTop.hom ((W.hom ≫ qS).appTop.hom _) = (W'.hom ≫ qS).appTop.hom _
    rw [← MorphismProperty.Over.w g, Category.assoc, Scheme.Hom.comp_appTop]
    rfl
  choose Lf hLf using fun W : S.ProEt => hdlog W.left m (ψ W ζ) (hP1 W)
  let E : ∀ W : S.ProEt, Additive (rootsOfUnity m Γ(W.left, ⊤)) ≃+ C(W.left, ZMod m) := fun W =>
    AddEquiv.ofBijective (Lf W)
      ⟨hinj W.left m _ (Lf W) (hP2 W) (hLf W), hsurj W.left m _ (Lf W) (hP3 W) (hLf W)⟩
  let app : ∀ X : (S.ProEt)ᵒᵖ, (wcYkpMupre S m).obj X ≅ (wcContSheaf S (ZMod m)).obj.obj X :=
    fun X => AddEquiv.toAddCommGrpIso (AddEquiv.ulift.trans ((E X.unop).trans AddEquiv.ulift.symm))
  let eP : wcYkpMupre S m ≅ (wcContSheaf S (ZMod m)).obj := NatIso.ofComponents app (by
    intro X Y g
    apply AddCommGrpCat.ext
    intro a
    apply ULift.ext
    apply ContinuousMap.ext
    intro z'
    exact hnat X.unop.left Y.unop.left g.unop.left m _ _ (Lf X.unop) (Lf Y.unop) (hP4 g.unop)
      (hLf X.unop) (hLf Y.unop) a.down z')
  refine ⟨ObjectProperty.isoMk _ eP, ?_⟩
  intro W v z j
  exact hLf W (Additive.ofMul v) z j

theorem wc_ykp_kummer_ses_explicit (L : Type u) [Field L] (S : Scheme.{u}) (qS : S ⟶ Spec (.of L))
    (m : ℕ) (hm : 0 < m) (hmL : ((m : ℕ) : L) ≠ 0)
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpGpre S))
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S m)) :
    ∃ w : wcYkpIota S m hG hμ ≫ (m • 𝟙 (wcYkpG S hG)) = 0,
      (ShortComplex.mk (wcYkpIota S m hG hμ) (m • 𝟙 (wcYkpG S hG)) w).ShortExact :=
by
  have hunit : ∀ U : S.ProEt, IsUnit ((m : ℕ) : Γ(U.left, ⊤)) := by
    intro U
    have := ((Ne.isUnit hmL).map (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom).map
      (U.hom ≫ qS).appTop.hom
    simpa only [map_natCast] using this
  have hloc : ∀ (U : S.ProEt) (y : (Γ(U.left, ⊤))ˣ), ∃ (V : S.ProEt) (g : V ⟶ U)
      (x : (Γ(V.left, ⊤))ˣ), Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology S U ∧
      (x : Γ(V.left, ⊤)) ^ m = g.left.appTop.hom (y : Γ(U.left, ⊤)) :=
    fun U y => wc_d1_local_root_cover S m hm (wc_d1_kummer_algebra m hm) U (hunit U) y
  let ι : wcYkpMu S m hμ ⟶ wcYkpG S hG := wcYkpIota S m hG hμ
  have hι : ∀ (W : (S.ProEt)ᵒᵖ) (ζ : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      wcRootsFun m ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).obj W),
      ι.hom.app W ζ = ULift.up (Additive.ofMul
        ((Additive.toMul ζ.down : rootsOfUnity m Γ(W.unop.left, ⊤)) : (Γ(W.unop.left, ⊤))ˣ)) :=
    fun _ _ => rfl
  have hg : ∀ (W : (S.ProEt)ᵒᵖ) (z : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).obj W),
      (m • 𝟙 (wcYkpG S hG)).hom.app W z = m • z := by
    intro W z
    have hnsapp : ∀ {P Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : P ⟶ Q) (k : ℕ)
        (W : (S.ProEt)ᵒᵖ) (x : P.obj.obj W), (k • φ).hom.app W x = k • φ.hom.app W x := by
      intro P Q φ k W x
      have e3 : (k • φ).hom = k • φ.hom :=
        (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_nsmul
      rw [e3, NatTrans.app_nsmul]
      rfl
    exact hnsapp (𝟙 (wcYkpG S hG)) m W z
  have wι : ι ≫ (m • 𝟙 (wcYkpG S hG)) = 0 := by
    apply Sheaf.hom_ext
    ext W ζ
    change (m • 𝟙 (wcYkpG S hG)).hom.app W (ι.hom.app W ζ) = 0
    rw [hg, hι]
    apply ULift.ext
    apply Additive.toMul.injective
    change ((Additive.toMul ζ.down : rootsOfUnity m Γ(W.unop.left, ⊤)) : (Γ(W.unop.left, ⊤))ˣ) ^ m = 1
    exact (Additive.toMul ζ.down).2
  have H1 : ∀ (U : S.ProEt) (a : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      wcRootsFun m ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).obj (Opposite.op U)),
      ι.hom.app (Opposite.op U) a = 0 → a = 0 := by
    intro U a ha
    have h1 : ((Additive.toMul a.down : rootsOfUnity m Γ(U.left, ⊤)) : (Γ(U.left, ⊤))ˣ) = 1 :=
      congrArg (fun z : ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) => Additive.toMul z.down) ha
    apply ULift.ext
    apply Additive.toMul.injective
    exact Subtype.ext h1
  have H2 : ∀ (U : S.ProEt) (b : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).obj (Opposite.op U)),
      (m • 𝟙 (wcYkpG S hG)).hom.app
        (Opposite.op U) b = 0 → ∃ a, ι.hom.app (Opposite.op U) a = b := by
    intro U b hb
    rw [hg] at hb
    have hu : (Additive.toMul b.down : (Γ(U.left, ⊤))ˣ) ^ m = 1 :=
      congrArg (fun z : ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) => Additive.toMul z.down) hb
    exact Exists.intro (ULift.up (Additive.ofMul (⟨Additive.toMul b.down, hu⟩ :
      rootsOfUnity m Γ(U.left, ⊤)))) rfl
  have H3 : ∀ (U : S.ProEt) (q : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).obj (Opposite.op U)),
      Presheaf.imageSieve
        (m • 𝟙 (wcYkpG S hG)).hom q ∈
        Scheme.ProEt.topology S U := by
    intro U q
    obtain ⟨V, g, x, hcov, hx⟩ := hloc U (Additive.toMul q.down)
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff, Presieve.singleton_le_iff]
    have hxu : x ^ m = Units.map g.left.appTop.hom.toMonoidHom (Additive.toMul q.down) := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.coe_map]
      exact hx
    refine Exists.intro (ULift.up (Additive.ofMul x)) ((hg _ _).trans ?_)
    change ULift.up (Additive.ofMul (x ^ m)) =
      ULift.up (Additive.ofMul (Units.map g.left.appTop.hom.toMonoidHom (Additive.toMul q.down)))
    rw [hxu]
  have hmono : Mono ι := by
    haveI : Sheaf.IsLocallyInjective ι := (Sheaf.isLocallyInjective_iff_injective ι).mpr
      (fun X => (injective_iff_map_eq_zero _).mpr (fun a ha => H1 X.unop a ha))
    exact Sheaf.mono_of_isLocallyInjective ι
  have hepi : Epi (m • 𝟙 (wcYkpG S hG)) := by
    haveI : Sheaf.IsLocallySurjective (m • 𝟙 (wcYkpG S hG)) :=
      Presheaf.IsLocallySurjective.mk (fun {U} q => H3 U q)
    exact Sheaf.epi_of_isLocallySurjective _
  have hk0 : ∀ X : (S.ProEt)ᵒᵖ, Function.Injective ((Limits.kernel.ι
      (m • 𝟙 (wcYkpG S hG))).hom.app X) :=
    fun X => by
      have h1 : Mono ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
          (Limits.kernel.ι (m • 𝟙 (wcYkpG S hG)))) :=
        Functor.map_mono _ _
      exact (AddCommGrpCat.mono_iff_injective _).mp ((NatTrans.mono_iff_mono_app _).mp h1 X)
  have hk : Epi (Limits.kernel.lift (m • 𝟙 (wcYkpG S hG)) ι wι) := by
    haveI : Sheaf.IsLocallySurjective (Limits.kernel.lift (m • 𝟙 (wcYkpG S hG)) ι wι) :=
      Presheaf.isLocallySurjective_of_surjective (Scheme.ProEt.topology S) _ (fun X s => by
        have hb : (m • 𝟙 (wcYkpG S hG)).hom.app X
            ((Limits.kernel.ι (m • 𝟙 (wcYkpG S hG))).hom.app X s) = 0 := by
          have h := congrArg (fun φ => (φ.hom.app X) s)
            (Limits.kernel.condition (m • 𝟙 (wcYkpG S hG)))
          exact h
        obtain ⟨a, ha⟩ := H2 X.unop _ hb
        refine ⟨a, hk0 X ?_⟩
        have h := congrArg (fun φ => (φ.hom.app X) a)
          (Limits.kernel.lift_ι (m • 𝟙 (wcYkpG S hG)) ι wι)
        exact h.trans ha)
    exact Sheaf.epi_of_isLocallySurjective _
  exact ⟨wι, ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_epi_kernel_lift _).mpr hk)
    hmono hepi⟩

theorem wc_ykp_free_eval_equiv (S : Scheme.{u}) (W : S.ProEt)
    (Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :
    ∃ E : (wcFreeSheaf S W ⟶ Q) ≃+ Q.obj.obj (Opposite.op W),
      ∀ g, E g = (g.hom.app (Opposite.op W)).hom (wcFreeGen S W) :=
by
  classical

  let P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let γ : FreeAbelianGroup (ULift.{u+1} (W ⟶ W)) := FreeAbelianGroup.of (ULift.up (𝟙 W))

  have hext : ∀ {α B : Type (u+1)} [AddCommGroup B] (φ ψ : FreeAbelianGroup α →+ B),
      (∀ a, φ (FreeAbelianGroup.of a) = ψ (FreeAbelianGroup.of a)) → φ = ψ := by
    intro α B _ φ ψ h
    apply AddMonoidHom.ext
    intro z
    induction z using FreeAbelianGroup.induction_on with
    | zero => rw [map_zero, map_zero]
    | of a => exact h a
    | neg a ih => rw [map_neg, map_neg, ih]
    | add a b iha ihb => rw [map_add, map_add, iha, ihb]

  have hmap : ∀ (V V' : (S.ProEt)ᵒᵖ) (h : V ⟶ V') (a : ULift.{u+1} (V.unop ⟶ W)),
      (P.map h).hom (FreeAbelianGroup.of a) =
        (FreeAbelianGroup.of (ULift.up (h.unop ≫ a.down) : ULift.{u+1} (V'.unop ⟶ W)) :
          FreeAbelianGroup (ULift.{u+1} (V'.unop ⟶ W))) := by
    intro V V' h a
    exact FreeAbelianGroup.map_of_apply
      (f := fun g : ULift.{u+1} (V.unop ⟶ W) =>
        (ULift.up (h.unop ≫ g.down) : ULift.{u+1} (V'.unop ⟶ W))) a

  have hK : ∀ (η : P ⟶ Q.obj) (V : (S.ProEt)ᵒᵖ) (f : V.unop ⟶ W),
      (η.app V).hom (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W))) =
        (Q.obj.map f.op).hom ((η.app (Opposite.op W)).hom γ) := by
    intro η V f
    have e1 : (P.map f.op).hom γ =
        (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W)) :
          FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ W))) := by
      refine (hmap (Opposite.op W) V f.op (ULift.up (𝟙 W))).trans ?_
      exact congrArg (fun g : V.unop ⟶ W =>
        (FreeAbelianGroup.of (ULift.up g : ULift.{u+1} (V.unop ⟶ W)) :
          FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ W)))) (Category.comp_id f)
    have e2 := congrArg (fun φ => φ.hom γ) (η.naturality f.op)
    calc (η.app V).hom (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ W)))
        = (η.app V).hom ((P.map f.op).hom γ) := congrArg (η.app V).hom e1.symm
      _ = (P.map f.op ≫ η.app V).hom γ := rfl
      _ = (η.app (Opposite.op W) ≫ Q.obj.map f.op).hom γ := e2
      _ = (Q.obj.map f.op).hom ((η.app (Opposite.op W)).hom γ) := rfl

  have hev : Function.Bijective (fun η : P ⟶ Q.obj => (η.app (Opposite.op W)).hom γ) := by
    constructor
    · intro η η' h
      simp only at h
      apply NatTrans.ext
      funext V
      apply AddCommGrpCat.hom_ext
      refine hext (α := ULift.{u+1} (V.unop ⟶ W)) _ _ (fun a => ?_)
      exact (hK η V a.down).trans
        ((congrArg (Q.obj.map a.down.op).hom h).trans (hK η' V a.down).symm)
    · intro x
      let F : ∀ V : (S.ProEt)ᵒᵖ, ULift.{u+1} (V.unop ⟶ W) → Q.obj.obj V :=
        fun V f => (Q.obj.map f.down.op).hom x
      refine ⟨{ app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V))
                naturality := ?_ }, ?_⟩
      · intro V V' h
        apply AddCommGrpCat.hom_ext
        refine hext (α := ULift.{u+1} (V.unop ⟶ W)) _ _ (fun a => ?_)
        calc (P.map h ≫ AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V'))).hom
              (FreeAbelianGroup.of a)
            = FreeAbelianGroup.lift (F V') ((P.map h).hom (FreeAbelianGroup.of a)) := rfl
          _ = FreeAbelianGroup.lift (F V')
                (FreeAbelianGroup.of (ULift.up (h.unop ≫ a.down) : ULift.{u+1} (V'.unop ⟶ W))) :=
              congrArg (FreeAbelianGroup.lift (F V')) (hmap V V' h a)
          _ = (Q.obj.map (h.unop ≫ a.down).op).hom x := FreeAbelianGroup.lift_apply_of _ _
          _ = (Q.obj.map h).hom ((Q.obj.map a.down.op).hom x) := by
              rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp]
              rfl
          _ = (Q.obj.map h).hom (FreeAbelianGroup.lift (F V) (FreeAbelianGroup.of a)) :=
              congrArg (Q.obj.map h).hom (FreeAbelianGroup.lift_apply_of (F V) a).symm
          _ = (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (F V)) ≫ Q.obj.map h).hom
                (FreeAbelianGroup.of a) := rfl
      · show FreeAbelianGroup.lift (F (Opposite.op W)) γ = x
        refine (FreeAbelianGroup.lift_apply_of (F (Opposite.op W)) (ULift.up (𝟙 W))).trans ?_
        show (Q.obj.map (𝟙 W).op).hom x = x
        rw [op_id, CategoryTheory.Functor.map_id]
        rfl

  let adj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
  have hfac : ∀ g : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj P ⟶ Q,
      (g.hom.app (Opposite.op W)).hom
          (((toSheafify (Scheme.ProEt.topology S) P).app (Opposite.op W)).hom γ) =
        (((adj.homEquiv P Q) g).app (Opposite.op W)).hom γ := by
    intro g
    rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
    rfl
  let Φ : (wcFreeSheaf S W ⟶ Q) →+ Q.obj.obj (Opposite.op W) :=
    AddMonoidHom.mk' (fun g => (g.hom.app (Opposite.op W)).hom (wcFreeGen S W))
      (fun g₁ g₂ => by
        simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply])
  have hbij : Function.Bijective Φ := by
    have e : (Φ : (wcFreeSheaf S W ⟶ Q) → Q.obj.obj (Opposite.op W)) =
        (fun η : P ⟶ Q.obj => (η.app (Opposite.op W)).hom γ) ∘ (adj.homEquiv P Q) := by
      funext g
      exact hfac g
    rw [e]
    exact hev.comp (adj.homEquiv P Q).bijective
  exact ⟨AddEquiv.ofBijective Φ hbij, fun g => rfl⟩

theorem wc_ykp_kummer_zero_iff (S : Scheme.{u}) (m : ℕ)
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpGpre S))
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S m))
    (w : wcYkpIota S m hG hμ ≫ (m • 𝟙 (wcYkpG S hG)) = 0)
    (hS : (ShortComplex.mk (wcYkpIota S m hG hμ) (m • 𝟙 (wcYkpG S hG)) w).ShortExact)
    (a : (Γ(S, ⊤))ˣ) (ahat : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶ wcYkpG S hG)
    (ha : (ahat.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 S)))).hom
      (wcFreeGen S (Scheme.ProEt.mk (𝟙 S))) = ULift.up (Additive.ofMul a)) :
    (Abelian.Ext.mk₀ ahat).comp hS.extClass (zero_add 1) = 0 ↔ ∃ b : (Γ(S, ⊤))ˣ, b ^ m = a :=
by
  obtain ⟨E, hE⟩ := wc_ykp_free_eval_equiv S (Scheme.ProEt.mk (𝟙 S)) (wcYkpG S hG)
  have hEa : E ahat = ULift.up (Additive.ofMul a) := (hE ahat).trans ha
  have s2 : ∀ (φ : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶ wcYkpG S hG) (b : (Γ(S, ⊤))ˣ),
      E φ = ULift.up (Additive.ofMul b) → E (m • φ) = ULift.up (Additive.ofMul (b ^ m)) := by
    intro φ b hφ
    rw [map_nsmul, hφ]
    rfl
  have s3 : ∀ β : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶ wcYkpG S hG,
      β ≫ (m • 𝟙 (wcYkpG S hG)) = m • β := by
    intro β
    rw [Preadditive.comp_nsmul, Category.comp_id]
  constructor
  · intro H
    obtain ⟨x₂, hx₂⟩ :=
      Abelian.Ext.covariant_sequence_exact₃ _ hS (Abelian.Ext.mk₀ ahat) (zero_add 1) H
    have hβ : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₂) = x₂ :=
      Abelian.Ext.mk₀_homEquiv₀_apply x₂
    rw [← hβ, Abelian.Ext.mk₀_comp_mk₀] at hx₂
    have h1 : Abelian.Ext.homEquiv₀ x₂ ≫ (m • 𝟙 (wcYkpG S hG)) = ahat :=
      (Abelian.Ext.mk₀_bijective _ _).1 hx₂
    rw [s3] at h1
    refine ⟨Additive.toMul (E (Abelian.Ext.homEquiv₀ x₂)).down, ?_⟩
    have h2 := s2 (Abelian.Ext.homEquiv₀ x₂) (Additive.toMul (E (Abelian.Ext.homEquiv₀ x₂)).down) rfl
    rw [h1, hEa] at h2
    exact (Additive.ofMul.injective (congrArg ULift.down h2)).symm
  · rintro ⟨b, rfl⟩
    have h1 : E (m • E.symm (ULift.up (Additive.ofMul b))) = E ahat := by
      exact (s2 _ b (E.apply_symm_apply _)).trans hEa.symm
    have h2 : E.symm (ULift.up (Additive.ofMul b)) ≫ (m • 𝟙 (wcYkpG S hG)) = ahat := by
      rw [s3]
      exact E.injective h1
    rw [← h2, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
    rw [show (Abelian.Ext.mk₀ (m • 𝟙 (wcYkpG S hG))).comp hS.extClass (zero_add 1) = 0 from
      hS.comp_extClass, Abelian.Ext.comp_zero]

theorem wc_ykp_tau_ct (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k j : ℕ)
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ k)))]
    [Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1))))]
    (ε₀ : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ k))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ k))))
    (hε₀ : wcZmEpsNorm S (ℓ ^ k) ε₀)
    (κ₀ : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ k))).obj
      (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ k))) ≅ wcContSheaf S (ZMod (ℓ ^ k)))
    (hκ₀ : wcZmKappaNorm S (ℓ ^ k) κ₀)
    (ε₁ : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1)))))
    (hε₁ : wcZmEpsNorm S (ℓ ^ (k + 1)) ε₁)
    (κ₁ : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
      (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1)))) ≅
        wcContSheaf S (ZMod (ℓ ^ (k + 1))))
    (hκ₁ : wcZmKappaNorm S (ℓ ^ (k + 1)) κ₁)
    (x : wcZModProEtExt S (ℓ ^ (k + 1)) j) :
    wcZmCt S (ℓ ^ k) j ε₀ κ₀ (wcIntRedTau S ℓ k j x) =
      (wcZmCt S (ℓ ^ (k + 1)) j ε₁ κ₁ x).comp
        (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ k) continuous_of_discreteTopology))
        (add_zero j) :=
by
  classical
  haveI hXm : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) :=
    fun n => HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  haveI hNZ : NeZero (ℓ ^ (k + 1)) := ⟨pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero⟩
  obtain ⟨hTr, ht⟩ := wc_int_red_transfer S ℓ

  have hGlim : ∀ (R₀ : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}) (K : Type) [SmallCategory K]
      [FinCategory K], Limits.PreservesLimitsOfShape K (SheafOfModules.toSheaf.{u+1} R₀) := by
    intro R₀ K _ _
    haveI : Limits.PreservesLimitsOfShape K
        (SheafOfModules.forget.{u+1} R₀ ⋙ PresheafOfModules.toPresheaf.{u+1} R₀.obj) := inferInstance
    haveI : Limits.PreservesLimitsOfShape K
        (SheafOfModules.toSheaf.{u+1} R₀ ⋙
          sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      Limits.preservesLimitsOfShape_of_natIso
        (Iso.refl _ : SheafOfModules.forget.{u+1} R₀ ⋙ PresheafOfModules.toPresheaf.{u+1} R₀.obj ≅ _)
    exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
  have hexact' : ∀ (R R' : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}) (φ : R ⟶ R'),
      (SheafOfModules.restrictScalars.{u+1} φ).Additive ∧
        Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ) ∧
        Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ) := by
    intro R R' φ
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) :=
      sheafOfModules_toSheaf_preservesFiniteColimits _ R
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R') :=
      sheafOfModules_toSheaf_preservesFiniteColimits _ R'
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsMonomorphisms :=
      Functor.reflectsMonomorphisms_of_faithful _
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsIsomorphisms :=
      reflectsIsomorphisms_of_reflectsMonomorphisms_of_reflectsEpimorphisms _
    let θ : SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R ≅
        SheafOfModules.toSheaf.{u+1} R' := Iso.refl _
    refine ⟨inferInstance, ⟨fun K _ _ => ?_⟩, ⟨fun K _ _ => ?_⟩⟩
    · haveI := hGlim R K
      haveI := hGlim R' K
      haveI : Limits.ReflectsLimitsOfShape K (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.reflectsLimitsOfShape_of_reflectsIsomorphisms
      haveI : Limits.PreservesLimitsOfShape K
          (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesLimitsOfShape_of_natIso θ.symm
      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _ (SheafOfModules.toSheaf.{u+1} R)
    · haveI : Limits.ReflectsColimitsOfShape K (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
      haveI : Limits.PreservesColimitsOfShape K
          (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimitsOfShape_of_natIso θ.symm
      exact Limits.preservesColimitsOfShape_of_reflects_of_preserves _ (SheafOfModules.toSheaf.{u+1} R)
  have hexact : ∀ m : ℕ, wcIntResExact S ℓ m := fun m => hexact' _ _ (wcIntZModRingSheafMap S ℓ m)

  have hu1 : ∀ (m : ℕ) (V : (S.ProEt)ᵒᵖ),
      ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)).val.app V).hom
        (1 : (wcIntRingSheaf S ℓ).obj.obj V) = (1 : (wcZModRingSheaf S (ℓ ^ m)).obj.obj V) := by
    intro m V
    have h := SheafOfModules.unitHomEquiv_apply_coe _
      (wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)) V
    refine h.symm.trans ?_
    unfold wcUnitRestrict
    rw [Equiv.apply_symm_apply]
    rfl

  obtain ⟨E, hE⟩ := wc_ykp_free_eval_equiv S (Scheme.ProEt.mk (𝟙 S))
    ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)))
  obtain ⟨εΛ, hεΛ⟩ : ∃ εΛ : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)),
      (εΛ.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 S)))).hom (wcFreeGen S (Scheme.ProEt.mk (𝟙 S))) =
        (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk (𝟙 S)))) :=
    ⟨E.symm (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk (𝟙 S)))),
      (hE _).symm.trans (E.apply_symm_apply _)⟩

  have key : ∀ (m : ℕ) (εm : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ m))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ m)))), wcZmEpsNorm S (ℓ ^ m) εm →
      εΛ ≫ (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).map
        (wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)) = εm := by
    intro m εm hεm
    obtain ⟨E', hE'⟩ := wc_ykp_free_eval_equiv S (Scheme.ProEt.mk (𝟙 S))
      ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ m))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ m))))
    apply E'.injective
    refine (hE' _).trans (Eq.trans ?_ (hE' εm).symm)
    refine Eq.trans ?_ (show _ = _ from hεm).symm
    change ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)).val.app
      (Opposite.op (Scheme.ProEt.mk (𝟙 S)))).hom
        ((εΛ.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 S)))).hom
          (wcFreeGen S (Scheme.ProEt.mk (𝟙 S)))) = _
    rw [hεΛ]
    exact hu1 m _

  have hTrm : ∀ (m : ℕ) (y : wcZModProEtExt S (ℓ ^ m) j),
      haveI := (hexact m).1; haveI := (hexact m).2.1; haveI := (hexact m).2.2
      wcIntRedTr S ℓ m j y = (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ m))).comp
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ m)) y) (zero_add j) := by
    intro m y
    rw [wcIntRedTr, dif_pos (hexact m), AddMonoidHom.mk'_apply]

  have hΨ : ∀ (m : ℕ)
      [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ m)))]
      (εm : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶
        (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ m))).obj
          (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ m))))
      (κm : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ m))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ m))) ≅ wcContSheaf S (ZMod (ℓ ^ m))),
      wcZmEpsNorm S (ℓ ^ m) εm → ∀ y : wcZModProEtExt S (ℓ ^ m) j,
      wcZmCt S (ℓ ^ m) j εm κm y =
        ((Abelian.Ext.mk₀ εΛ).comp
          (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ))
            (wcIntRedTr S ℓ m j y)) (zero_add j)).comp (Abelian.Ext.mk₀ κm.hom) (add_zero j) := by
    intro m _ εm κm hεm y
    haveI := (hexact m).1
    haveI := (hexact m).2.1
    haveI := (hexact m).2.2
    rw [hTrm m y, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, key m εm hεm]
    rfl

  have hT : wcIntRedTr S ℓ k j (wcIntRedTau S ℓ k j x) =
      (wcIntRedTr S ℓ (k + 1) j x).comp (Abelian.Ext.mk₀ (Classical.choose (ht k))) (add_zero j) := by
    rw [wcIntRedTau, dif_pos ⟨hTr k j, ht k⟩]
    exact AddEquiv.ofBijective_apply_symm_apply _ (hTr k j)

  have hsq : ∀ (t : wcIntResUnit S ℓ (k + 1) ⟶ wcIntResUnit S ℓ k),
      wcUnitRestrict (wcIntZModRingSheafMap S ℓ (k + 1)) ≫ t =
        wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) →
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).map t ≫ κ₀.hom =
        κ₁.hom ≫ wcContSheafMap S (wcTowerCast ℓ k) continuous_of_discreteTopology := by
    intro t htt
    have ht1 : ∀ V : (S.ProEt)ᵒᵖ, (t.val.app V).hom
        (show (wcIntResUnit S ℓ (k + 1)).val.obj V from
          (1 : (wcZModRingSheaf S (ℓ ^ (k + 1))).obj.obj V)) =
        (show (wcIntResUnit S ℓ k).val.obj V from (1 : (wcZModRingSheaf S (ℓ ^ k)).obj.obj V)) := by
      intro V
      calc (t.val.app V).hom (show (wcIntResUnit S ℓ (k + 1)).val.obj V from
            (1 : (wcZModRingSheaf S (ℓ ^ (k + 1))).obj.obj V))
          = (t.val.app V).hom (((wcUnitRestrict (wcIntZModRingSheafMap S ℓ (k + 1))).val.app V).hom
              (1 : (wcIntRingSheaf S ℓ).obj.obj V)) := by rw [hu1]
        _ = ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app V).hom
              (1 : (wcIntRingSheaf S ℓ).obj.obj V) :=
            congrArg (fun g => (g.val.app V).hom (1 : (wcIntRingSheaf S ℓ).obj.obj V)) htt
        _ = (show (wcIntResUnit S ℓ k).val.obj V from
              (1 : (wcZModRingSheaf S (ℓ ^ k)).obj.obj V)) := hu1 k V
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro f
    let f' : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) := f
    let r : (wcIntRingSheaf S ℓ).obj.obj V :=
      (⟨fun z => ULift.up (((f' z).down.val : ℕ) : ℤ_[ℓ]),
        (continuous_of_discreteTopology (f := fun b : ULift.{u+1} (ZMod (ℓ ^ (k + 1))) =>
          (ULift.up (((b.down).val : ℕ) : ℤ_[ℓ]) : ULift.{u+1} ℤ_[ℓ]))).comp f'.continuous⟩ :
        C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]))
    have hrf : (r • (show (wcIntResUnit S ℓ (k + 1)).val.obj V from
          (1 : (wcZModRingSheaf S (ℓ ^ (k + 1))).obj.obj V)) :
        (wcIntResUnit S ℓ (k + 1)).val.obj V) = f := by
      change (_ : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ (k + 1))))) = f'
      apply ContinuousMap.ext
      intro z
      apply ULift.ext
      change PadicInt.toZModPow (k + 1) (((f' z).down.val : ℕ) : ℤ_[ℓ]) * 1 = (f' z).down
      rw [mul_one, map_natCast, ZMod.natCast_zmod_val]
    have htf : (t.val.app V).hom f = r • (show (wcIntResUnit S ℓ k).val.obj V from
        (1 : (wcZModRingSheaf S (ℓ ^ k)).obj.obj V)) := by
      rw [← hrf, LinearMap.map_smul, ht1]
    change (κ₀.hom.hom.app V).hom ((t.val.app V).hom f) =
      ((wcContSheafMap S (wcTowerCast ℓ k) continuous_of_discreteTopology).hom.app V).hom
        ((κ₁.hom.hom.app V).hom f)
    rw [htf]
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    have hl := hκ₀ V.unop (r • (show (wcIntResUnit S ℓ k).val.obj V from
        (1 : (wcZModRingSheaf S (ℓ ^ k)).obj.obj V))) z
    have hr := hκ₁ V.unop f z
    refine hl.trans (Eq.trans ?_ (congrArg (wcTowerCast ℓ k) hr).symm)
    change PadicInt.toZModPow k (((f' z).down.val : ℕ) : ℤ_[ℓ]) * 1 = wcTowerCast ℓ k (f' z).down
    rw [mul_one, map_natCast, wcTowerCast]
    change _ = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (f' z).down
    rw [ZMod.castHom_apply, ZMod.cast_eq_val]
  have ht' := Classical.choose_spec (ht k)
  have assoc4 : ∀ {A B C' D' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (z : Abelian.Ext A B j) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero j)).comp (Abelian.Ext.mk₀ g) (add_zero j) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero j) := by
    intro A B C' D' z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  rw [hΨ k ε₀ κ₀ hε₀, hΨ (k + 1) ε₁ κ₁ hε₁, hT, Abelian.Ext.mapExactFunctor_comp,
    Abelian.Ext.mapExactFunctor_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
  refine (assoc4 _ _ _).trans (Eq.trans ?_ (assoc4 _ _ _).symm)
  exact congrArg (fun g => Abelian.Ext.comp _ (Abelian.Ext.mk₀ g) (add_zero j)) (hsq _ ht')

theorem wc_ykp_kummer_level_compat (L : Type u) [Field L] (S : Scheme.{u})
    (qS : S ⟶ Spec (.of L)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓL : ((ℓ : ℕ) : L) ≠ 0) (k : ℕ)
    (ζ₁ : L) (hζ₁ : IsPrimitiveRoot ζ₁ (ℓ ^ (k + 1)))
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpGpre S))
    (hμ₁ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S (ℓ ^ (k + 1))))
    (hμ₀ : Presheaf.IsSheaf (Scheme.ProEt.topology S) (wcYkpMupre S (ℓ ^ k)))
    (w₁ : wcYkpIota S (ℓ ^ (k + 1)) hG hμ₁ ≫ ((ℓ ^ (k + 1)) • 𝟙 (wcYkpG S hG)) = 0)
    (hS₁ : (ShortComplex.mk (wcYkpIota S (ℓ ^ (k + 1)) hG hμ₁)
      ((ℓ ^ (k + 1)) • 𝟙 (wcYkpG S hG)) w₁).ShortExact)
    (w₀ : wcYkpIota S (ℓ ^ k) hG hμ₀ ≫ ((ℓ ^ k) • 𝟙 (wcYkpG S hG)) = 0)
    (hS₀ : (ShortComplex.mk (wcYkpIota S (ℓ ^ k) hG hμ₀) ((ℓ ^ k) • 𝟙 (wcYkpG S hG)) w₀).ShortExact)
    (e₁ : wcYkpMu S (ℓ ^ (k + 1)) hμ₁ ≅ wcContSheaf S (ZMod (ℓ ^ (k + 1))))
    (he₁ : wcYkpDlog L S qS (ℓ ^ (k + 1)) ζ₁ hμ₁ e₁)
    (e₀ : wcYkpMu S (ℓ ^ k) hμ₀ ≅ wcContSheaf S (ZMod (ℓ ^ k)))
    (he₀ : wcYkpDlog L S qS (ℓ ^ k) (ζ₁ ^ ℓ) hμ₀ e₀) :
    hS₁.extClass.comp (Abelian.Ext.mk₀ (e₁.hom ≫
        wcContSheafMap S (wcTowerCast ℓ k) continuous_of_discreteTopology)) (add_zero 1) =
      hS₀.extClass.comp (Abelian.Ext.mk₀ e₀.hom) (add_zero 1) :=
by
  have hnsapp : ∀ (n : ℕ) {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (W : (S.ProEt)ᵒᵖ) (x : A.obj.obj W), ((n • f).hom.app W).hom x = n • (f.hom.app W).hom x := by
    intro n A B f W x
    have h1 : (n • f).hom = n • f.hom := (sheafToPresheaf _ _).map_nsmul
    rw [h1, NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply]
  have hτ : wcYkpPow S ℓ k hμ₁ hμ₀ ≫ wcYkpIota S (ℓ ^ k) hG hμ₀ =
      wcYkpIota S (ℓ ^ (k + 1)) hG hμ₁ ≫ (ℓ • 𝟙 (wcYkpG S hG)) := by
    apply Sheaf.hom_ext
    ext W x
    show _ = ((ℓ • 𝟙 (wcYkpG S hG)).hom.app W).hom
      ((((wcYkpIota S (ℓ ^ (k + 1)) hG hμ₁)).hom.app W).hom x)
    rw [hnsapp]
    rfl
  have h23 : (ℓ • 𝟙 (wcYkpG S hG)) ≫ ((ℓ ^ k) • 𝟙 (wcYkpG S hG)) =
      ((ℓ ^ (k + 1)) • 𝟙 (wcYkpG S hG)) ≫ 𝟙 (wcYkpG S hG) := by
    rw [Preadditive.nsmul_comp, Category.id_comp, smul_smul, ← pow_succ', Category.comp_id]
  have hN : hS₁.extClass.comp (Abelian.Ext.mk₀ (wcYkpPow S ℓ k hμ₁ hμ₀)) (add_zero 1) =
      (Abelian.Ext.mk₀ (𝟙 (wcYkpG S hG))).comp hS₀.extClass (zero_add 1) :=
    hS₁.extClass_naturality hS₀
      { τ₁ := wcYkpPow S ℓ k hμ₁ hμ₀, τ₂ := ℓ • 𝟙 (wcYkpG S hG), τ₃ := 𝟙 (wcYkpG S hG),
        comm₁₂ := hτ, comm₂₃ := h23 }
  haveI : NeZero (ℓ ^ (k + 1)) := ⟨pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero⟩
  have hτe : wcYkpPow S ℓ k hμ₁ hμ₀ ≫ e₀.hom =
      e₁.hom ≫ wcContSheafMap S (wcTowerCast ℓ k) continuous_of_discreteTopology := by
    apply Sheaf.hom_ext
    ext W x
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    let v : rootsOfUnity (ℓ ^ (k + 1)) Γ(W.unop.left, ⊤) := Additive.toMul x.down
    let a : ZMod (ℓ ^ (k + 1)) := (show C(↥W.unop.left, ZMod (ℓ ^ (k + 1))) from
        ((e₁.hom.hom.app (Opposite.op W.unop)).hom (ULift.up (Additive.ofMul v))).down) z
    let w : rootsOfUnity (ℓ ^ k) Γ(W.unop.left, ⊤) :=
      Additive.toMul ((((wcYkpPow S ℓ k hμ₁ hμ₀).hom.app W).hom x).down)
    have h1 : (show C(↥W.unop.left, ZMod (ℓ ^ (k + 1))) from
        ((e₁.hom.hom.app (Opposite.op W.unop)).hom (ULift.up (Additive.ofMul v))).down) z =
          ((a.val : ℕ) : ZMod (ℓ ^ (k + 1))) :=
      (ZMod.natCast_zmod_val a).symm
    have hv := (he₁ W.unop v z a.val).mp h1
    have hw : (W.unop.left.evaluation ⊤ z trivial).hom ((w : (Γ(W.unop.left, ⊤))ˣ) : Γ(W.unop.left, ⊤)) =
        ((W.unop.left.evaluation ⊤ z trivial).hom
          ((W.unop.hom ≫ qS).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom (ζ₁ ^ ℓ)))) ^
            a.val := by
      show (W.unop.left.evaluation ⊤ z trivial).hom
        ((((v : (Γ(W.unop.left, ⊤))ˣ)) ^ ℓ : (Γ(W.unop.left, ⊤))ˣ) : Γ(W.unop.left, ⊤)) = _
      rw [Units.val_pow_eq_pow_val, map_pow, hv, map_pow, map_pow, map_pow, ← pow_mul, ← pow_mul,
        mul_comm]
    have hL := (he₀ W.unop w z a.val).mpr hw
    have hR' : wcTowerCast ℓ k ((a.val : ℕ) : ZMod (ℓ ^ (k + 1))) = ((a.val : ℕ) : ZMod (ℓ ^ k)) := by
      show (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k))) _ = _
      exact map_natCast _ _
    calc _ = ((a.val : ℕ) : ZMod (ℓ ^ k)) := hL
      _ = wcTowerCast ℓ k ((a.val : ℕ) : ZMod (ℓ ^ (k + 1))) := hR'.symm
      _ = wcTowerCast ℓ k a := by rw [ZMod.natCast_zmod_val]
      _ = _ := rfl
  rw [← hτe, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hN,
    Abelian.Ext.mk₀_id_comp]

theorem wc_ykp_kummer_class_base_change (L : Type u) [Field L] {T T' : Scheme.{u}} (f : T' ⟶ T)
    (qT : T ⟶ Spec (.of L)) (qT' : T' ⟶ Spec (.of L)) (hf : f ≫ qT = qT')
    (m : ℕ) (hm : 0 < m) (hmL : ((m : ℕ) : L) ≠ 0) (ζ : L) (hζ : IsPrimitiveRoot ζ m)
    (D : wcZModPullData f m) (hD : wcZModPullCanonical D)
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T m))]
    [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T' m))]
    (ε : wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T m)).obj
        (SheafOfModules.unit (wcZModRingSheaf T m)))
    (hε : wcZmEpsNorm T m ε)
    (κ : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T m)).obj
      (SheafOfModules.unit (wcZModRingSheaf T m)) ≅ wcContSheaf T (ZMod m))
    (hκ : wcZmKappaNorm T m κ)
    (ε' : wcFreeSheaf T' (Scheme.ProEt.mk (𝟙 T')) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T' m)).obj
        (SheafOfModules.unit (wcZModRingSheaf T' m)))
    (hε' : wcZmEpsNorm T' m ε')
    (κ' : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf T' m)).obj
      (SheafOfModules.unit (wcZModRingSheaf T' m)) ≅ wcContSheaf T' (ZMod m))
    (hκ' : wcZmKappaNorm T' m κ')
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology T) (wcYkpGpre T))
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology T) (wcYkpMupre T m))
    (hG' : Presheaf.IsSheaf (Scheme.ProEt.topology T') (wcYkpGpre T'))
    (hμ' : Presheaf.IsSheaf (Scheme.ProEt.topology T') (wcYkpMupre T' m))
    (w : wcYkpIota T m hG hμ ≫ (m • 𝟙 (wcYkpG T hG)) = 0)
    (hS : (ShortComplex.mk (wcYkpIota T m hG hμ) (m • 𝟙 (wcYkpG T hG)) w).ShortExact)
    (w' : wcYkpIota T' m hG' hμ' ≫ (m • 𝟙 (wcYkpG T' hG')) = 0)
    (hS' : (ShortComplex.mk (wcYkpIota T' m hG' hμ') (m • 𝟙 (wcYkpG T' hG')) w').ShortExact)
    (e : wcYkpMu T m hμ ≅ wcContSheaf T (ZMod m)) (he : wcYkpDlog L T qT m ζ hμ e)
    (e' : wcYkpMu T' m hμ' ≅ wcContSheaf T' (ZMod m)) (he' : wcYkpDlog L T' qT' m ζ hμ' e')
    (a : (Γ(T, ⊤))ˣ)
    (ahat : wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)) ⟶ wcYkpG T hG)
    (ha : (ahat.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 T)))).hom
      (wcFreeGen T (Scheme.ProEt.mk (𝟙 T))) = ULift.up (Additive.ofMul a))
    (ahat' : wcFreeSheaf T' (Scheme.ProEt.mk (𝟙 T')) ⟶ wcYkpG T' hG')
    (ha' : (ahat'.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 T')))).hom
      (wcFreeGen T' (Scheme.ProEt.mk (𝟙 T'))) =
        ULift.up (Additive.ofMul (Units.map f.appTop.hom.toMonoidHom a)))
    (y : wcZModProEtExt T m 1)
    (hy : wcZmCt T m 1 ε κ y = (Abelian.Ext.mk₀ ahat).comp
      (hS.extClass.comp (Abelian.Ext.mk₀ e.hom) (add_zero 1)) (zero_add 1)) :
    wcZmCt T' m 1 ε' κ' (wcZModPull D 1 y) = (Abelian.Ext.mk₀ ahat').comp
      (hS'.extClass.comp (Abelian.Ext.mk₀ e'.hom) (add_zero 1)) (zero_add 1) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T' m)) := HasExt.standard _

  have s2 : ∀ {A B C' D' : Sheaf (Scheme.ProEt.topology T') AddCommGrpCat.{u+1}} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have s3 : ∀ {A B C' D' : Sheaf (Scheme.ProEt.topology T') AddCommGrpCat.{u+1}} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have s4 : ∀ {A B C' D' : Sheaf (Scheme.ProEt.topology T') AddCommGrpCat.{u+1}} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  haveI hcs : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology T) (Scheme.ProEt.topology T') :=
    D.cont
  haveI hflat : RepresentablyFlat (wcProEtBC f) := (wc_proet_pullback_continuous_flat f).2
  haveI : Limits.PreservesColimitsOfSize.{0, 0}
      ((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology T) (Scheme.ProEt.topology T')) :=
    ((wcProEtBC f).sheafAdjunctionContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology T)
      (Scheme.ProEt.topology T')).leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits
      ((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology T) (Scheme.ProEt.topology T')) :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits _
  haveI : ((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology T) (Scheme.ProEt.topology T')).Additive :=
    (by
      haveI : Limits.PreservesLimitsOfSize.{0, 0}
          ((wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
            (Scheme.ProEt.topology T) (Scheme.ProEt.topology T')) :=
        ((wcProEtBC f).sheafAdjunctionContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology T)
          (Scheme.ProEt.topology T')).rightAdjoint_preservesLimits
      haveI : ((wcProEtBC f).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology T)
            (Scheme.ProEt.topology T')).PreservesZeroMorphisms :=
        Functor.preservesZeroMorphisms_of_isRightAdjoint _
      haveI : ((wcProEtBC f).sheafPushforwardContinuous
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology T)
            (Scheme.ProEt.topology T')).Additive :=
        Functor.additive_of_preserves_binary_products _
      exact ((wcProEtBC f).sheafAdjunctionContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology T)
          (Scheme.ProEt.topology T')).left_adjoint_additive)
  haveI : Limits.PreservesFiniteLimits
      ((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology T) (Scheme.ProEt.topology T')) :=
    wc_sheafPullback_preservesFiniteLimits_of_flat _ _ (wcProEtBC f)

  have hev : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (W : C) (Q : Sheaf J' AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
