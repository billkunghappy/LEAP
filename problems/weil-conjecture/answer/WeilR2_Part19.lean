theorem wc_et_closed_rightAdj_cycle_class_gen : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (ℓ : ℕ) (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive] (adj : @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (q : ℕ) (DW : ∀ W : Y.Etale, wcEtPullData (Limits.pullback.fst W.hom i) ℓ), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; ∃ cl : ∀ W : Y.Etale, (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) → wcEtSuppExt (DW W) q, (∀ (W : Y.Etale) (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))) (k : ℕ), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → cl W (k • x) = k • cl W x) ∧ (∀ (W : Y.Etale) (x y : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 → cl W x = cl W y → ∃ e : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom e = x - y) ∧ (∀ (W W₂ : Y.Etale) (h : W₂ ⟶ W) (Eh : wcEtPullData h.left ℓ) (γ : wcEtSuppObj (DW W₂) ⟶ Eh.Φ.obj (wcEtSuppObj (DW W))), wcEtSuppUnitMap (DW W₂) ≫ γ = Eh.μ.inv ≫ Eh.Φ.map (wcEtSuppUnitMap (DW W)) → ∀ x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → wcEtSuppRestr (DW W) Eh (DW W₂) γ q (cl W x) = cl W₂ (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x)) ∧ (∀ (W : Y.Etale) (EW : wcEtPullData W.hom ℓ) (γ : wcEtSuppObj (DW W) ⟶ EW.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap (DW W) ≫ γ = EW.μ.inv ≫ EW.Φ.map (wcEtSuppUnitMap D) → ∀ (c : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj (SheafOfModules.unit (wcEtZModRing Z ℓ)) ⟶ I.cocomplex.X q) (hc : c ≫ I.cocomplex.d q (q + 1) = 0), cl W (((adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X q) c).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W)))) = wcEtSuppRestr D EW (DW W) γ q (I.extMk c (q + 1) rfl hc)) :=
by
  intro Y Z i _ ℓ D R _ adj I q DW
  classical
  letI hExt : ∀ (S : Scheme.{u}), HasExt (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) :=
    fun S => HasExt.standard _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Y) (wcEtZModRing Y ℓ)
  obtain ⟨EW⟩ : Nonempty (∀ W : Y.Etale, wcEtPullData W.hom ℓ) :=
    ⟨fun W => (wc_et_zmod_pull_data_exists W.hom ℓ).some⟩
  haveI hEa : ∀ W : Y.Etale, (EW W).Φ.Additive := fun W => (EW W).additive
  haveI hEl : ∀ W : Y.Etale, Limits.PreservesFiniteLimits (EW W).Φ := fun W => (EW W).presLim
  haveI hEc : ∀ W : Y.Etale, Limits.PreservesFiniteColimits (EW W).Φ := fun W => (EW W).presColim
  obtain ⟨A, a, ε, Hnat, Hadd, Hbij, H4, H3⟩ :=
    wc_et_closed_rightAdj_supp_hom_dict_gen i ℓ D R adj DW EW

  let aH : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      (A W ⟶ M) →+ (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) :=
    fun W M => AddMonoidHom.mk' (a W M) (Hadd W M)
  have ha0 : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), a W M 0 = 0 := by
    intro W M
    have h := map_zero (aH W M)
    simpa [aH] using h
  have hsub : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (x y : (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W))),
      (a W M).symm (x - y) = (a W M).symm x - (a W M).symm y := by
    intro W M x y
