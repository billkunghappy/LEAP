    rw [← hf₀def]; exact IsPullback.of_hasPullback _ _
  obtain ⟨a0, R₀, hR₀, r₀, j₀, hdet, hr₀, hr₀s, hj₀, hj₀c, hj₀r⟩ :=
    wc_qxs_exc_fibre_quadric hn hn4 hπ hc hx₀ hsh hπ' hπ'2 hgen hbl hblf hps' hF
  obtain ⟨e, hne, R, hR, r, jR, hr, hrs, hjR, hjRr⟩ :=
    wc_qxs_quadric_base_change_split (IsLocalRing.ResidueField B₀) n hn hn4 a0 hdet
      (Limits.pullback f₀ (wcQmSp B₀)) R₀ (Limits.pullback.snd f₀ (wcQmSp B₀)) r₀ j₀
      hr₀ hr₀s hj₀ hj₀c hj₀r _
      (Limits.pullback.fst (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀))))))
      (Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
