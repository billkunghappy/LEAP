    wc_proet_free_zmod_ext_vanish_of_et_qcsep Xs' (Scheme.ProEt.mk (𝟙 Xs')) (ℓ ^ (k + 1))
      (2 * e + 1) (hpow k)
  have hInt := wc_proet_int_ext_vanish_of_zmod_deg Xs' ℓ (Scheme.ProEt.mk (𝟙 Xs')) (2 * e) hZ
  have hHM : ∀ x : wcHM Xs' ℓ (2 * e + 1), x = 0 :=
    wc_hm_vanish_of_int_ext_vanish Xs' ℓ (2 * e) hInt

  have ha : (n : ℤ) - 1 = ((2 * e + 1 : ℕ) : ℤ) := by rw [hne]; push_cast; ring
  have hw := key ((n : ℤ) - 1) (2 * e + 1) ha hHM
    (((DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        ((n : ℤ) - 1)).app (SheafOfModules.unit (wcRingSheaf Xs' ℓ))).hom ≫ v ≫
      ((DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
