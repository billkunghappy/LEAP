        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hu1 : (Localization.mk 1 ⟨MvPolynomial.X c, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) *
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.X c) = 1 := by
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      exact Localization.mk_self (⟨MvPolynomial.X c, Submonoid.mem_powers _⟩ :
        Submonoid.powers (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))
    have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X j)) =
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X']
    have hι : (algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c))
            (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))).comp
          ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X c))).comp (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) =
        (algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C := by
      apply RingHom.ext
      intro a
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
        HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
      have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) a :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
          MvPolynomial.C a := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    have ht : (⇑(algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c))
            (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))) ∘
          (fun j => HomogeneousLocalization.Away.isLocalizationElem ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K j)))) =
        fun j => (Localization.mk 1 ⟨MvPolynomial.X c, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) *
