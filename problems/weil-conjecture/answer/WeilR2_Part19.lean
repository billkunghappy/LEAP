theorem wc_et_zmod_crt_split : ∀ (Y : Scheme.{u}) (a b : ℕ), 0 < a → 0 < b → Nat.Coprime a b → ∃ (ρa : ∀ p, wcEtZModExt Y (a * b) p →+ wcEtZModExt Y a p) (ρb : ∀ p, wcEtZModExt Y (a * b) p →+ wcEtZModExt Y b p), (∀ p, Function.Bijective (fun x : wcEtZModExt Y (a * b) p => (ρa p x, ρb p x))) ∧ (∀ (p q k : ℕ) (h : p + q = k) (x : wcEtZModExt Y (a * b) p) (y : wcEtZModExt Y (a * b) q), ρa k (wcEtZModCup Y (a * b) p q k h x y) = wcEtZModCup Y a p q k h (ρa p x) (ρa q y)) ∧ (∀ (p q k : ℕ) (h : p + q = k) (x : wcEtZModExt Y (a * b) p) (y : wcEtZModExt Y (a * b) q), ρb k (wcEtZModCup Y (a * b) p q k h x y) = wcEtZModCup Y b p q k h (ρb p x) (ρb q y)) :=
