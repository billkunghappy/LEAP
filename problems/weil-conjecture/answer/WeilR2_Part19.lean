          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P' (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
        (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι'
  let eΨ' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          (ComplexShape.up ℤ) 0).map Di'.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di'.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf Xm ℓ)) ≫
        (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK'

  have hK : CochainComplex.IsStrictlyGE K' 0 := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    exact P'.map_isZero ((CochainComplex.isStrictlyGE_iff I'.cochainComplex 0).mp
      inferInstance i hi)
  have hΨs : CochainComplex.IsStrictlyGE
      ((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K') 0 := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    exact Di'.Φ.map_isZero ((CochainComplex.isStrictlyGE_iff K' 0).mp hK i hi)
  have hΛs : CochainComplex.IsStrictlyGE ((HomologicalComplex.single
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) 0).obj
        (SheafOfModules.unit (wcRingSheaf Xs' ℓ))) 0 := inferInstance
  have hCs : CochainComplex.IsStrictlyGE (CochainComplex.mappingCone eΨ') (-1) := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    rw [CochainComplex.mappingCone.isZero_X_iff]
    exact ⟨(CochainComplex.isStrictlyGE_iff _ 0).mp hΛs (i + 1) (by omega),
      (CochainComplex.isStrictlyGE_iff _ 0).mp hΨs i (by omega)⟩
  haveI := hΨs
  have hP' : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj
      ((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K')) := ⟨0, inferInstance⟩
  have hC : DerivedCategory.TStructure.t.plus
      (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ')) := ⟨-1, inferInstance⟩

  have hZc : IsClosed (ι ⁻¹' {IsLocalRing.closedPoint B₀}) :=
    (IsLocalRing.isClosed_singleton_closedPoint B₀).preimage ι.continuous
  obtain ⟨Zx₀, ix, hix, hrange⟩ : ∃ (Z : Scheme.{u}) (ix : Z ⟶ Xs), IsClosedImmersion ix ∧
      Set.range ix = ι ⁻¹' {IsLocalRing.closedPoint B₀} :=
    ⟨_, (Scheme.IdealSheafData.vanishingIdeal
      (⟨_, hZc⟩ : TopologicalSpace.Closeds Xs)).subschemeι, inferInstance,
