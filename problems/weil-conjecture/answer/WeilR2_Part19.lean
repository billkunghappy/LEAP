theorem wc_et_closed_push_rightAdj_high_vanishing_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [IsSeparated fX] [QuasiCompact fX] (n e : ℕ) [SmoothOfRelativeDimension n fX] (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension e (i ≫ fX)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (D : wcEtPullData i (ℓ ^ k)) (R : SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ k)) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z (ℓ ^ k))) [R.Additive], (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) → ∀ (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k)))) (m : ℕ), 2 * n < m + 2 * e → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology m) :=
