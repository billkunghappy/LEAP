    have hgen : ∀ (g : A W ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev q))
        (hf : (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) ≫ I.cocomplex.d q (q + 1) = 0),
        I.extMk (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) (q + 1) rfl hf = 0 := by
      intro g hf
      rcases Nat.eq_zero_or_pos q with hq | hq
      · subst hq
        have hd : I.cocomplex.d ((ComplexShape.up ℕ).prev 0) 0 = 0 :=
          I.cocomplex.shape _ _ (by rw [ComplexShape.up_Rel]; omega)
        rw [hextcongr _ 0 hf Limits.zero_comp (by rw [hd, Limits.comp_zero]),
          InjectiveResolution.extMk_zero]
      · obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 := ⟨q - 1, by omega⟩
        refine (I.extMk_eq_zero_iff _ (p + 1 + 1) rfl hf p rfl).mpr
          ⟨g ≫ (I.cocomplex.XIsoOfEq (CochainComplex.prev_nat_succ p)).hom, ?_⟩
        rw [Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d]
    obtain ⟨g, rfl⟩ := (a W (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).surjective e
    have hf : (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Category.assoc, HomologicalComplex.d_comp_d, Limits.comp_zero]
    have hx' : ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom
          (a W (I.cocomplex.X ((ComplexShape.up ℕ).prev q)) g) =
        a W (I.cocomplex.X q) (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) :=
      (Hnat W _ _ g _).symm
    have hxc : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom
        (a W (I.cocomplex.X q) (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)) = 0 := by
      rw [← Hnat, hf, ha0]
    rw [hx', hcl W _ hxc, hextcongr _ _ (hcyc W _ hxc) hf ((a W _).symm_apply_apply _),
      hgen g hf, hΘzero]

theorem wc_et_thom_class_restrict_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ), (∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0) → ∀ (T : wcEtLocThom K N), wcEtThomGL T → wcEtThomNat T → ∀ {X Z X' Z' : Scheme.{u}} (fX : X ⟶ Spec (.of K)) (fX' : X' ⟶ Spec (.of K)) (f : X' ⟶ X), f ≫ fX = fX' → ∀ (n n' c : ℕ) [SmoothOfRelativeDimension n fX] [SmoothOfRelativeDimension n' fX'] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)] (i' : Z' ⟶ X') [SmoothOfRelativeDimension (n' - c) (i' ≫ fX')], c ≤ n → c ≤ n' → ∀ (g : Z' ⟶ Z), IsPullback g i' i f → ∀ (D : wcEtPullData i N) (Df : wcEtPullData f N) (D' : wcEtPullData i' N) (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) → ∀ θ : wcEtSuppExt D (2 * c), wcEtIsThom T fX D c θ → wcEtIsThom T fX' D' c (wcEtSuppRestr D Df D' γ (2 * c) θ) :=
by
  classical
  intro K _ _ N hsp T hTa hTb X Z X' Z' fX fX' f hf n n' c _ _ i _ _ i' _ hcn hcn' g hsq D Df D'
    γ hγ θ hθ
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance

  have hsm0 : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) [IsOpenImmersion ψ] (φ : B ⟶ C) (k : ℕ)
      [SmoothOfRelativeDimension k φ], SmoothOfRelativeDimension k (ψ ≫ φ) := by
    intro A B C ψ _ φ k _
    have := smoothOfRelativeDimension_comp 0 k ψ φ
    rwa [Nat.zero_add] at this

  have hlift : ∀ {P Q ZW₀ Z₀ W₀ X₀ : Scheme.{u}} {gW₀ : ZW₀ ⟶ Z₀} {iW₀ : ZW₀ ⟶ W₀}
      {i₀ : Z₀ ⟶ X₀} {ι₀ : W₀ ⟶ X₀}, IsPullback gW₀ iW₀ i₀ ι₀ → ∀ {a : P ⟶ Z₀} {b : P ⟶ Q}
      {k : Q ⟶ X₀}, IsPullback a b i₀ k → ∀ (φ : Q ⟶ W₀), φ ≫ ι₀ = k →
      ∃ a' : P ⟶ ZW₀, IsPullback a' b iW₀ φ := by
    intro P Q ZW₀ Z₀ W₀ X₀ gW₀ iW₀ i₀ ι₀ hR a b k hO φ hφ
    refine ⟨hR.lift a (b ≫ φ) (by rw [hO.w, Category.assoc, hφ]), ?_⟩
    refine IsPullback.of_right ?_ (hR.lift_snd _ _ _) hR
    rw [hR.lift_fst, hφ]
    exact hO

  have G2 : ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX]
      [CompactSpace ↥X] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)],
      c ≤ n → ∀ (D : wcEtPullData i N) (θ : wcEtSuppExt D (2 * c)), (∀ z : Z, ∃ (V : Scheme.{u})
      (j : V ⟶ X), IsOpenImmersion j ∧ i z ∈ Set.range j ∧ ∀ (ZV : Scheme.{u}) (iV : ZV ⟶ V)
      (gV : ZV ⟶ Z), IsPullback gV iV i j → ∀ (DV : wcEtPullData iV N) (Ej : wcEtPullData j N)
      (γ : wcEtSuppObj DV ⟶ Ej.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DV ≫ γ =
      Ej.μ.inv ≫ Ej.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ej DV γ (2 * c) θ = 0) → θ = 0 := by
    intro X Z fX n c _ _ i _ _ hcn D θ hloc
    have hdeg : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
        IsPullback gV iV i j → ∀ (DV : wcEtPullData iV N) (q' : ℕ), q' + 1 = 2 * c →
        ∀ t : wcEtSuppExt DV q', t = 0 := by
      intro V ZV j _ iV gV hV DV q' hq' t
      haveI : IsClosedImmersion iV :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
      haveI : IsOpenImmersion gV :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) hV.flip inferInstance
      haveI : SmoothOfRelativeDimension n (j ≫ fX) := hsm0 j fX n
      haveI : SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
        have e : gV ≫ i ≫ fX = iV ≫ j ≫ fX := by rw [reassoc_of% hV.w]
        rw [← e]
        exact hsm0 gV (i ≫ fX) (n - c)
      exact hsp V ZV (j ≫ fX) n c iV hcn DV q' (by omega) t
    have hvanO : ∀ x : X, ∃ O : X.Opens, x ∈ O ∧ ∀ (ZU : Scheme.{u}) (iU : ZU ⟶ (O : Scheme.{u}))
        (gU : ZU ⟶ Z), IsPullback gU iU i O.ι → ∀ (DU : wcEtPullData iU N) (EU : wcEtPullData O.ι N)
        (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)),
        wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) →
        wcEtSuppRestr D EU DU γ (2 * c) θ = 0 := by
      intro x
      by_cases hx : x ∈ Set.range i
      · obtain ⟨z, rfl⟩ := hx
        obtain ⟨V, j, hj, hz, H⟩ := hloc z
        haveI := hj
        refine ⟨j.opensRange, ?_, ?_⟩
        · rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
          exact hz
        · intro ZU iU gU hO DU EU γ hγ
          have hrange : Set.range j.opensRange.ι ⊆ Set.range j := by
            intro y hy
            rwa [Scheme.Opens.range_ι, Scheme.Hom.coe_opensRange] at hy
          obtain ⟨e, he⟩ : ∃ e : (j.opensRange : Scheme.{u}) ⟶ V, e ≫ j = j.opensRange.ι :=
            ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
          have hV := IsPullback.of_hasPullback i j
          haveI : IsClosedImmersion (Limits.pullback.snd i j) :=
            MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
          obtain ⟨g₂, h₂⟩ := hlift hV hO e he
          obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i j) N
          obtain ⟨Ej⟩ := wc_et_zmod_pull_data_exists j N
          obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists e N
          obtain ⟨γj, hγj, -⟩ := wc_et_closed_supp_base_change i j _ _ hV D Ej DV
          obtain ⟨γe, hγe, hepi⟩ := wc_et_closed_supp_base_change _ e iU g₂ h₂ DV Ee DU
          rw [wc_et_supp_restr_comp j e j.opensRange.ι he D DV DU Ej Ee EU γj γe γ hγj hγe hγ hepi
            (2 * c) θ, H _ _ _ hV DV Ej γj hγj, map_zero]
      · refine ⟨⟨(Set.range i)ᶜ, isOpen_compl_iff.mpr i.isClosedEmbedding.isClosed_range⟩, hx, ?_⟩
        intro ZU iU gU hO DU EU γ hγ
        haveI : IsEmpty ZU := Scheme.isEmpty_of_commSq hO.toCommSq (by
          rw [Scheme.Opens.range_ι]
          exact disjoint_compl_right)
        haveI := wc_et_supp_ext_empty iU N DU inferInstance (2 * c)
        exact Subsingleton.elim _ _
    choose O hxO hO using hvanO
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (O x : Set X))
      (fun x => (O x).isOpen.mem_nhds (hxO x))
    refine wc_et_supp_opens_cover_injective i D (2 * c) hdeg t.card
      (fun k => O (t.equivFin.symm k).1) ?_ θ ?_
    · intro y
      have hy : y ∈ ⋃ x ∈ t, (O x : Set X) := by
        rw [ht]
        trivial
      obtain ⟨x, hxt, hyx⟩ := Set.mem_iUnion₂.mp hy
      refine ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
      show y ∈ O (t.equivFin.symm (t.equivFin ⟨x, hxt⟩)).1
      rw [Equiv.symm_apply_apply]
      exact hyx
    · intro k
      exact hO _

  intro W' ZW' iW' gW' hsq' DW' EW' γW' hadm' h' hcut'
  haveI hW'aff : IsAffine (W' : Scheme.{u}) := hcut'.1
  haveI : IsClosedImmersion iW' := hcut'.2.1
  haveI : IsOpenImmersion gW' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq'.flip inferInstance
  haveI S1 : SmoothOfRelativeDimension n' (W'.ι ≫ fX') := hsm0 W'.ι fX' n'
  haveI S2 : SmoothOfRelativeDimension (n' - c) (iW' ≫ W'.ι ≫ fX') := by
    have e : gW' ≫ i' ≫ fX' = iW' ≫ W'.ι ≫ fX' := by rw [reassoc_of% hsq'.w]
    rw [← e]
    exact hsm0 gW' (i' ≫ fX') (n' - c)
  have hsmV : ∀ {V ZV : Scheme.{u}} (ψ : V ⟶ (W' : Scheme.{u})) [IsOpenImmersion ψ]
      (a : ZV ⟶ ZW') (b : ZV ⟶ V), IsPullback a b iW' ψ →
      SmoothOfRelativeDimension (n' - c) (b ≫ ψ ≫ W'.ι ≫ fX') := by
    intro V ZV ψ _ a b hab
    haveI : IsOpenImmersion a :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hab.flip inferInstance
    have e : a ≫ iW' ≫ W'.ι ≫ fX' = b ≫ ψ ≫ W'.ι ≫ fX' := by rw [reassoc_of% hab.w]
    rw [← e]
    exact hsm0 a (iW' ≫ W'.ι ≫ fX') (n' - c)
  have gcW' : wcEtGoodChart K (W'.ι ≫ fX') iW' c h' := ⟨n', hcn', S1, S2, hcut'⟩

  rw [← sub_eq_zero]
  refine G2 _ _ (W'.ι ≫ fX') n' c iW' hcn' DW' _ ?_
  intro z''

  have hz : i (g (gW' z'')) = f (W'.ι (iW' z'')) := by
    have h1 : (gW' ≫ g ≫ i) z'' = (iW' ≫ W'.ι ≫ f) z'' := by
      rw [hsq.w, reassoc_of% hsq'.w]
    exact h1
  obtain ⟨W, hzW, -, hchart⟩ :=
    wc_smooth_pair_local_equations K X Z fX n c i hcn (g (gW' z''))
  obtain ⟨ZW, iW, gW, hsqW⟩ : ∃ (ZW : Scheme.{u}) (iW : ZW ⟶ (W : Scheme.{u})) (gW : ZW ⟶ Z),
      IsPullback gW iW i W.ι :=
    ⟨_, _, _, IsPullback.of_hasPullback i W.ι⟩
  obtain ⟨h, hcutW⟩ := hchart ZW iW gW hsqW
  haveI : IsClosedImmersion iW := hcutW.2.1
  haveI : IsOpenImmersion gW :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsqW.flip inferInstance
  haveI SW1 : SmoothOfRelativeDimension n (W.ι ≫ fX) := hsm0 W.ι fX n
  haveI SW2 : SmoothOfRelativeDimension (n - c) (iW ≫ W.ι ≫ fX) := by
    have e : gW ≫ i ≫ fX = iW ≫ W.ι ≫ fX := by rw [reassoc_of% hsqW.w]
    rw [← e]
    exact hsm0 gW (i ≫ fX) (n - c)
  have gcW : wcEtGoodChart K (W.ι ≫ fX) iW c h := ⟨n, hcn, SW1, SW2, hcutW⟩
  obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists iW N
  obtain ⟨EW⟩ := wc_et_zmod_pull_data_exists W.ι N
  obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i W.ι iW gW hsqW D EW DW
  have hθW := hθ W ZW iW gW hsqW DW EW γW hγW h hcutW

  have hxO : iW' z'' ∈ (W'.ι ≫ f) ⁻¹ᵁ W := by
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, ← hz]
    exact hzW
  obtain ⟨t, hUO, hxU⟩ := (isAffineOpen_top (W' : Scheme.{u})).exists_basicOpen_le
    (V := (W'.ι ≫ f) ⁻¹ᵁ W) ⟨iW' z'', hxO⟩ trivial
  haveI hUaff : IsAffine ((W' : Scheme.{u}).basicOpen t) := (isAffineOpen_top _).basicOpen t
  have hrange : Set.range (((W' : Scheme.{u}).basicOpen t).ι ≫ W'.ι ≫ f) ⊆ Set.range W.ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι]
    have hy := hUO y.2
    rw [Scheme.Hom.mem_preimage] at hy
    exact hy
  obtain ⟨U, j₀, hj₀, hUaff', hxj₀, φ₀, hφ₀⟩ : ∃ (U : Scheme.{u}) (j₀ : U ⟶ (W' : Scheme.{u})),
      IsOpenImmersion j₀ ∧ IsAffine U ∧ iW' z'' ∈ Set.range j₀ ∧
      ∃ φ₀ : U ⟶ (W : Scheme.{u}), φ₀ ≫ W.ι = j₀ ≫ W'.ι ≫ f :=
    ⟨_, ((W' : Scheme.{u}).basicOpen t).ι, inferInstance, hUaff,
      ⟨⟨iW' z'', hxU⟩, Scheme.Opens.ι_apply _ _⟩, IsOpenImmersion.lift W.ι _ hrange,
      IsOpenImmersion.lift_fac _ _ _⟩
  haveI := hj₀
  haveI := hUaff'
  obtain ⟨pu, hpu⟩ := hxj₀
  obtain ⟨zU0, -, hzU0⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := iW') (g := j₀) z'' pu hpu.symm
  obtain ⟨ZU, gU, iU, hU, zU, hzU⟩ : ∃ (ZU : Scheme.{u}) (gU : ZU ⟶ ZW') (iU : ZU ⟶ U),
      IsPullback gU iU iW' j₀ ∧ ∃ zU : ZU, iU zU = pu :=
    ⟨_, _, _, IsPullback.of_hasPullback iW' j₀, zU0, hzU0⟩
  have P3 := (hU.paste_horiz hsq').paste_horiz hsq
  obtain ⟨gU', hUW⟩ := hlift hsqW P3 φ₀ (by rw [hφ₀, Category.assoc])
  have hcutUa : wcEtCutOut iU (fun k => j₀.appTop.hom (h' k)) :=
    wc_et_cutout_base_change iW' h' j₀ iU gU hcut' hUaff' hU
  have hcutUb : wcEtCutOut iU (fun k => φ₀.appTop.hom (h k)) :=
    wc_et_cutout_base_change iW h φ₀ iU gU' hcutW hUaff' hUW
  have gcUb : wcEtGoodChart K (j₀ ≫ W'.ι ≫ fX') iU c (fun k => φ₀.appTop.hom (h k)) :=
    ⟨n', hcn', hsm0 j₀ (W'.ι ≫ fX') n', hsmV j₀ gU iU hU, hcutUb⟩

  obtain ⟨V, jV, hjV, hVaff, hmemV, B, hB, hrel⟩ :=
    wc_smooth_pair_tuples_locally_GL K (j₀ ≫ W'.ι ≫ fX') iU c _ _ gcUb hcutUa zU
  haveI := hjV
  haveI := hVaff
  refine ⟨V, jV ≫ j₀, inferInstance, ?_, ?_⟩
  · obtain ⟨v, hv⟩ := hmemV
    exact ⟨v, by rw [Scheme.Hom.comp_apply, hv, hzU, hpu]⟩

  intro ZV iV gV hV DV Ej γj hadmj
  rw [map_sub, sub_eq_zero]
  have Q2 := hV.paste_horiz hsq'
  have Q3 := Q2.paste_horiz hsq
  have hφ : (jV ≫ φ₀) ≫ W.ι = ((jV ≫ j₀) ≫ W'.ι) ≫ f := by
    simp only [Category.assoc]
    rw [hφ₀]
  obtain ⟨gQ4, Q4⟩ := hlift hsqW Q3 (jV ≫ φ₀) hφ
  obtain ⟨Ea⟩ := wc_et_zmod_pull_data_exists ((jV ≫ j₀) ≫ W'.ι) N
  obtain ⟨Eb⟩ := wc_et_zmod_pull_data_exists (((jV ≫ j₀) ≫ W'.ι) ≫ f) N
  obtain ⟨Eφ⟩ := wc_et_zmod_pull_data_exists (jV ≫ φ₀) N
  obtain ⟨γa, hγa, hepi⟩ := wc_et_closed_supp_base_change i' _ iV _ Q2 D' Ea DV
  obtain ⟨γb, hγb, -⟩ := wc_et_closed_supp_base_change i _ iV _ Q3 D Eb DV
  obtain ⟨γφ, hγφ, -⟩ := wc_et_closed_supp_base_change iW _ iV _ Q4 DW Eφ DV
  have hcutV1 : wcEtCutOut iV (fun k => (jV ≫ j₀).appTop.hom (h' k)) :=
    wc_et_cutout_base_change iW' h' (jV ≫ j₀) iV gV hcut' hVaff hV
  have hcutV2 : wcEtCutOut iV (fun k => (jV ≫ φ₀).appTop.hom (h k)) :=
    wc_et_cutout_base_change iW h (jV ≫ φ₀) iV gQ4 hcutW hVaff Q4
  have hja : (fun k => (jV ≫ j₀).appTop.hom (h' k)) =
      fun k => jV.appTop.hom (j₀.appTop.hom (h' k)) := by
    funext k
    rw [Scheme.Hom.comp_appTop]
    rfl
  have hjb : (fun k => (jV ≫ φ₀).appTop.hom (h k)) =
      fun k => jV.appTop.hom (φ₀.appTop.hom (h k)) := by
    funext k
    rw [Scheme.Hom.comp_appTop]
    rfl
  have SV1 : SmoothOfRelativeDimension n' ((jV ≫ j₀) ≫ W'.ι ≫ fX') :=
    hsm0 (jV ≫ j₀) (W'.ι ≫ fX') n'
  have SV2 : SmoothOfRelativeDimension (n' - c) (iV ≫ (jV ≫ j₀) ≫ W'.ι ≫ fX') :=
    hsmV (jV ≫ j₀) gV iV hV
  have gcV1 : wcEtGoodChart K ((jV ≫ j₀) ≫ W'.ι ≫ fX') iV c
      (fun k => (jV ≫ j₀).appTop.hom (h' k)) := ⟨n', hcn', SV1, SV2, hcutV1⟩
  have gcV2 : wcEtGoodChart K ((jV ≫ j₀) ≫ W'.ι ≫ fX') iV c
      (fun k => (jV ≫ φ₀).appTop.hom (h k)) := ⟨n', hcn', SV1, SV2, hcutV2⟩
  have hφf : (jV ≫ φ₀) ≫ W.ι ≫ fX = (jV ≫ j₀) ≫ W'.ι ≫ fX' := by
    rw [← hf]
    simp only [Category.assoc]
    rw [reassoc_of% hφ₀]
  have L6a := wc_et_supp_restr_comp W'.ι (jV ≫ j₀) ((jV ≫ j₀) ≫ W'.ι) rfl D' DW' DV EW' Ej Ea
    γW' γj γa hadm' hadmj hγa hepi (2 * c) (wcEtSuppRestr D Df D' γ (2 * c) θ)
  have L6b := wc_et_supp_restr_comp f ((jV ≫ j₀) ≫ W'.ι) (((jV ≫ j₀) ≫ W'.ι) ≫ f) rfl D D' DV
    Df Ea Eb γ γa γb hγ hγa hγb hepi (2 * c) θ
  have L6c := wc_et_supp_restr_comp W.ι (jV ≫ φ₀) (((jV ≫ j₀) ≫ W'.ι) ≫ f) hφ D DW DV EW Eφ Eb
    γW γφ γb hγW hγφ hγb hepi (2 * c) θ
  have NA := hTb (W'.ι ≫ fX') ((jV ≫ j₀) ≫ W'.ι ≫ fX') (jV ≫ j₀) rfl iW' iV gV hV DW' Ej DV γj
    hadmj c h' gcW' gcV1
  have NB := hTb (W.ι ≫ fX) ((jV ≫ j₀) ≫ W'.ι ≫ fX') (jV ≫ φ₀) hφf iW iV gQ4 Q4 DW Eφ DV γφ
    hγφ c h gcW gcV2
  have key : (fun k => (jV ≫ j₀).appTop.hom (h' k)) =
      B.mulVec (fun k => (jV ≫ φ₀).appTop.hom (h k)) :=
    hja.trans (hrel.trans (congrArg B.mulVec hjb.symm))
  rw [← L6a, ← L6b, L6c, hθW, NB, NA]
  exact (hTa _ iV DV c _ B hB gcV2).symm.trans
    (congrArg (T ((jV ≫ j₀) ≫ W'.ι ≫ fX') iV DV c) key.symm)

theorem wc_et_thom_class_point_strict_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N m : ℕ) (T : wcEtLocThom K N), (∀ {W Z' : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z' ⟶ W) (D' : wcEtPullData i N) (c : ℕ) (hc : Fin c → Γ(W, ⊤)), SmoothOfRelativeDimension c fW → SmoothOfRelativeDimension 0 (i ≫ fW) → wcEtCutOut i hc → Nonempty Z' → m • T fW i D' c hc ≠ 0) → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n fX] [IsSeparated fX] (x : Spec (.of K) ⟶ X), x ≫ fX = 𝟙 _ → ∀ (D : wcEtPullData x N) (θ : wcEtSuppExt D (2 * n)), wcEtIsThom T fX D n θ → m • θ ≠ 0 :=
by
  classical
  intro K _ _ N m T hPt X fX n _ _ x hx D θ hθ hθ0
  haveI : IsClosedImmersion (x ≫ fX) := by rw [hx]; infer_instance
  haveI : IsClosedImmersion x := IsClosedImmersion.of_comp x fX
  obtain ⟨V, hVa, hV, e, hstd, hbij⟩ : ∃ (V : X.Opens) (_ : IsAffineOpen V) (hV : ⊤ ≤ x ⁻¹ᵁ V)
      (e : V ≤ fX ⁻¹ᵁ ⊤), RingHom.IsStandardSmoothOfRelativeDimension n (fX.appLE ⊤ V e).hom ∧
        Function.Bijective ((x.appLE V ⊤ hV).hom.comp (fX.appLE ⊤ V e).hom) := by
    let pt : Spec (.of K) := Classical.arbitrary _
    obtain ⟨U, _, V, hVa, hxV, e₀, hstd₀⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := fX) (x pt)
    have hU : U = ⊤ := by
      apply eq_top_iff.mpr
      intro q _
      rw [Subsingleton.elim q (fX (x pt))]
      exact e₀ hxV
    subst hU
    have hV : ⊤ ≤ x ⁻¹ᵁ V := by
      intro q _
      rw [Subsingleton.elim q pt]
      exact hxV
    refine ⟨V, hVa, hV, e₀, hstd₀, ?_⟩
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
    have key : ∀ (k : Spec (.of K) ⟶ Spec (.of K)), k = 𝟙 _ → ∀ (e' : (⊤ : (Spec (.of K)).Opens) ≤ k ⁻¹ᵁ ⊤),
        Function.Bijective (k.appLE ⊤ ⊤ e').hom := by
      rintro k rfl e'
      have h1 : (𝟙 (Spec (.of K)) : Spec (.of K) ⟶ Spec (.of K)).appLE ⊤ ⊤ e' = 𝟙 _ := by
        rw [Scheme.Hom.appLE, Scheme.Hom.id_app]
        erw [Category.id_comp]
        exact (Spec (.of K)).presheaf.map_id _
      rw [h1, CommRingCat.hom_id]
      exact Function.bijective_id
    exact key _ hx _
  obtain ⟨h, hh0, hfg, hle⟩ := wc_std_smooth_section_cotangent_gen _ _ _ (fX.appLE ⊤ V e).hom n hstd
    (x.appLE V ⊤ hV).hom hbij
  obtain ⟨g, hg1, hg⟩ : ∃ g : Γ(X, V), g - 1 ∈ RingHom.ker (x.appLE V ⊤ hV).hom ∧
      ∀ a ∈ RingHom.ker (x.appLE V ⊤ hV).hom, g * a ∈ Ideal.span (Set.range h) := by
    set I := RingHom.ker (x.appLE V ⊤ hV).hom with hI
    set J := Ideal.span (Set.range h) with hJ
    set N₀ : Submodule Γ(X, V) (Γ(X, V) ⧸ J) := Submodule.map (Submodule.mkQ J) I with hN₀
    have hNfg : N₀.FG := Submodule.FG.map (Submodule.mkQ J) hfg
    have hle' : N₀ ≤ I • N₀ := by
      have h1 : N₀ ≤ Submodule.map (Submodule.mkQ J) (J ⊔ I • I) := by
        apply Submodule.map_mono
        rw [Ideal.smul_eq_mul, ← pow_two]
        exact hle
      rw [Submodule.map_sup, Submodule.mkQ_map_self, bot_sup_eq, Submodule.map_smul''] at h1
      exact h1
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I N₀ hNfg hle'
    refine ⟨r, hr1, fun a ha => ?_⟩
    have h2 := hr (Submodule.mkQ J a) (Submodule.mem_map_of_mem ha)
    rw [← LinearMap.map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      smul_eq_mul] at h2
    exact h2
  have hunit : IsUnit ((x.appLE V ⊤ hV).hom g) := by
    have h1 := RingHom.mem_ker.mp hg1
    rw [map_sub, map_one, sub_eq_zero] at h1
    rw [h1]
    exact isUnit_one
  have hgker : ∀ a : Γ(X, V), (x.appLE V ⊤ hV).hom a = 0 → g * a ∈ Ideal.span (Set.range h) :=
    fun a ha => hg a (RingHom.mem_ker.mpr ha)
  obtain ⟨W, H, h', hWa, hcl, hker⟩ :=
    wc_scheme_point_localize_cutout x V hVa hV n g h hunit hh0 hgker
  have hpb : IsPullback (𝟙 _) (IsOpenImmersion.lift W.ι x H) x W.ι :=
    (IsOpenImmersion.isPullback_lift_id x W.ι H).flip
  let DW : wcEtPullData (IsOpenImmersion.lift W.ι x H) N :=
    (wc_et_zmod_pull_data_exists (IsOpenImmersion.lift W.ι x H) N).some
  let EW : wcEtPullData W.ι N := (wc_et_zmod_pull_data_exists W.ι N).some
  obtain ⟨γ, hγ, -⟩ :=
    wc_et_closed_supp_base_change x W.ι (IsOpenImmersion.lift W.ι x H) (𝟙 _) hpb D EW DW
  have hcut : wcEtCutOut (IsOpenImmersion.lift W.ι x H) h' := ⟨hWa, hcl, hker⟩
  have h1 := hθ W (Spec (.of K)) (IsOpenImmersion.lift W.ι x H) (𝟙 _) hpb DW EW γ hγ h' hcut
  have hm : m • T (W.ι ≫ fX) (IsOpenImmersion.lift W.ι x H) DW n h' = 0 := by
    have h1' : T (W.ι ≫ fX) (IsOpenImmersion.lift W.ι x H) DW n h' =
        wcEtSuppRestr D EW DW γ (2 * n) θ := h1.symm
    rw [h1', ← map_nsmul, hθ0, map_zero]
  have hsm : SmoothOfRelativeDimension n (W.ι ≫ fX) := by
    have := smoothOfRelativeDimension_comp 0 n W.ι fX
    rwa [Nat.zero_add] at this
  have hsm0 : SmoothOfRelativeDimension 0 (IsOpenImmersion.lift W.ι x H ≫ W.ι ≫ fX) := by
    rw [← Category.assoc, IsOpenImmersion.lift_fac, hx]
    infer_instance
  exact hPt (W.ι ≫ fX) (IsOpenImmersion.lift W.ι x H) DW n h' hsm hsm0 hcut inferInstance hm

theorem wc_et_smooth_pair_supp_local_thom_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (T : wcEtLocThom K (ℓ ^ k)), wcEtThomGL T → wcEtThomNat T → (∀ {W Z' : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z' ⟶ W) (D' : wcEtPullData i (ℓ ^ k)) (c : ℕ) (hc : Fin c → Γ(W, ⊤)), SmoothOfRelativeDimension c fW → SmoothOfRelativeDimension 0 (i ≫ fW) → wcEtCutOut i hc → Nonempty Z' → ℓ ^ (k - 1) • T fW i D' c hc ≠ 0) → ∀ (W ZW : Scheme.{u}) (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW] (iW : ZW ⟶ W) [IsClosedImmersion iW] [SmoothOfRelativeDimension (n - c) (iW ≫ fW)], c ≤ n → ∀ (D : wcEtPullData iW (ℓ ^ k)) (θ α : wcEtSuppExt D (2 * c)), wcEtIsThom T fW D c θ → ∀ z : ZW, ∃ (W' : Scheme.{u}) (f : W' ⟶ W), Etale f ∧ iW z ∈ Set.range f ∧ ∃ k' : ℕ, ∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW), IsPullback g iW' iW f → ∀ (D' : wcEtPullData iW' (ℓ ^ k)) (Ef : wcEtPullData f (ℓ ^ k)) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ef D' γ (2 * c) α = k' • wcEtSuppRestr D Ef D' γ (2 * c) θ :=
by
  classical
  intro K _ _ ℓ _ hℓ k hk T hGL hNat hPt W ZW fW n c _ iW _ _ hcn D θ α hθ z
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hsp : ∀ (X Z' : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c' : ℕ) [SmoothOfRelativeDimension n fX]
      (i : Z' ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c') (i ≫ fX)], c' ≤ n →
      ∀ (D₁ : wcEtPullData i (ℓ ^ k)) (q : ℕ), q < 2 * c' → ∀ θ₁ : wcEtSuppExt D₁ q, θ₁ = 0 := by
    intro X Z' fX n c' _ i _ _ hc'
    exact wc_et_supp_semipurity_pow K X Z' fX n c' i hc' ℓ hℓ k hk

  have hpts : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      IsPullback fst snd f g → ∀ (a : A) (b : B), f a = g b → ∃ t : P, fst t = a ∧ snd t = b := by
    intro P A B S fst snd f g h a b hab
    obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
    refine ⟨h.isoPullback.inv t, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2

  have hsm0 : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) [Etale ψ] (φ : B ⟶ C) (k : ℕ)
      [SmoothOfRelativeDimension k φ], SmoothOfRelativeDimension k (ψ ≫ φ) := by
    intro A B C ψ _ φ k _
    have := smoothOfRelativeDimension_comp 0 k ψ φ
    rwa [Nat.zero_add] at this

  have hzs : ∀ (S : Scheme.{u}),
      IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤))) := by
    intro S
    have h1 : AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S) = 𝟙 S := AffineSpace.homOfVector_over _ _
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)
  have e1 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)),
      ConcreteCategory.hom (f ≫ g).appTop x =
        ConcreteCategory.hom f.appTop (ConcreteCategory.hom g.appTop x) := by
    intro X Y Z f g x
    rw [Scheme.Hom.comp_appTop]
    rfl

  have hzsq : ∀ {S S' : Scheme.{u}} (φ : S ⟶ S'),
      IsPullback φ (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)))
        (AffineSpace.homOfVector (𝟙 S') (0 : ULift.{u} (Fin c) → Γ(S', ⊤)))
        (AffineSpace.map (ULift.{u} (Fin c)) φ) := by
    intro S S' φ
    have hcomm : φ ≫ AffineSpace.homOfVector (𝟙 S')
          (0 : ULift.{u} (Fin c) → Γ(S', ⊤)) =
        AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
          AffineSpace.map (ULift.{u} (Fin c)) φ := by
      apply AffineSpace.hom_ext
      · rw [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id, Category.assoc,
          AffineSpace.map_over, ← Category.assoc, AffineSpace.homOfVector_over, Category.id_comp]
      · intro i
        simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
          Pi.zero_apply, map_zero]
    have hcoord : ∀ (s : Limits.PullbackCone (AffineSpace.homOfVector (𝟙 S')
          (0 : ULift.{u} (Fin c) → Γ(S', ⊤))) (AffineSpace.map (ULift.{u} (Fin c)) φ)),
        (s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) ≫
          AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) = s.snd := by
      intro s
      apply AffineSpace.hom_ext
      · rw [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
      · intro i
        have h1 := congrArg (fun ψ => ConcreteCategory.hom (Scheme.Hom.appTop ψ)
          (AffineSpace.coord S' i)) s.condition
        simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
          Pi.zero_apply, map_zero] at h1 ⊢
        first
          | exact h1
          | exact h1.symm
    refine IsPullback.mk ⟨hcomm⟩
      ⟨Limits.PullbackCone.IsLimit.mk hcomm
        (fun s => s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) ?_ ?_ ?_⟩
    · intro s
      show (s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) ≫ φ = s.fst
      rw [Category.assoc, ← AffineSpace.map_over, ← Category.assoc, ← s.condition,
        Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
    · intro s
      exact hcoord s
    · intro s m _ hm2
      show m = s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)
      rw [← hm2, Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]

  have hprS : ∀ (S : Scheme.{u}) (qS : S ⟶ Spec (.of K)),
      SmoothOfRelativeDimension c (AffineSpace (ULift.{u} (Fin c)) S ↘ S) := by
    intro S qS
    obtain ⟨q, hP, -⟩ := wc_affine_space_ulift_mvpoly_zero_pullback K S qS c
    haveI : SmoothOfRelativeDimension c
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
      wc_mvpoly_spec_smooth_reldim K c
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange c
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension c) hP.flip inferInstance


  have hstrict : ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m qB]
      (b : Spec (.of K) ⟶ B), b ≫ qB = 𝟙 _ →
      ∀ (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) (ℓ ^ k))
        (θ : wcEtSuppExt DB (2 * c)),
        wcEtIsThom T ((AffineSpace (ULift.{u} (Fin c)) B ↘ B) ≫ qB) DB c θ → ℓ ^ (k - 1) • θ ≠ 0 := by
    intro B qB m _ b hb DB θ hθ hθ0
    haveI := hzs B
    haveI := hzs (Spec (.of K))
    have FS := hzsq b
    haveI hprB := hprS B qB
    haveI hprK := hprS (Spec (.of K)) (𝟙 _)
    haveI hfX : SmoothOfRelativeDimension (c + m)
        ((AffineSpace (ULift.{u} (Fin c)) B ↘ B) ≫ qB) := inferInstance
    haveI hz0B : SmoothOfRelativeDimension ((c + m) - c)
        (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫
          (AffineSpace (ULift.{u} (Fin c)) B ↘ B) ≫ qB) := by
      rw [Nat.add_sub_cancel_left, ← Category.assoc, AffineSpace.homOfVector_over, Category.id_comp]
      infer_instance
    haveI hz0K : SmoothOfRelativeDimension (c - c)
        (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)) ≫
          (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K))) := by
      rw [Nat.sub_self, AffineSpace.homOfVector_over]
      infer_instance
    have hσ : AffineSpace.map (ULift.{u} (Fin c)) b ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B) ≫ qB =
        (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) := by
      rw [← Category.assoc, AffineSpace.map_over, Category.assoc, hb, Category.comp_id]
    obtain ⟨Dσ⟩ := wc_et_zmod_pull_data_exists (AffineSpace.map (ULift.{u} (Fin c)) b) (ℓ ^ k)
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (ℓ ^ k)
    obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change _ _ _ b FS DB Dσ D'
    have hθb := wc_et_thom_class_restrict_gen K (ℓ ^ k) hsp T hGL hNat
      ((AffineSpace (ULift.{u} (Fin c)) B ↘ B) ≫ qB)
      (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K))
      (AffineSpace.map (ULift.{u} (Fin c)) b) hσ (c + m) c c
      (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)))
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
      (by omega) le_rfl b FS DB Dσ D' γ hγ θ hθ
    have hne := wc_et_thom_class_point_strict_gen K (ℓ ^ k) (ℓ ^ (k - 1)) T hPt
      (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)))
      (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) c
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
      (AffineSpace.homOfVector_over _ _) D' _ hθb
    apply hne
    rw [← map_nsmul (wcEtSuppRestr DB Dσ D' γ (2 * c)) (ℓ ^ (k - 1)) θ, hθ0, map_zero]


  have hgen : ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) [IsAffine B] [IrreducibleSpace B]
      [Smooth qB] (b : Spec (.of K) ⟶ B), b ≫ qB = 𝟙 _ →
      ∀ (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) (ℓ ^ k))
        (ω β : wcEtSuppExt DB (2 * c)), ℓ ^ (k - 1) • ω ≠ 0 → ∃ k₁ : ℕ, β = k₁ • ω := by
    intro B qB _ _ _ b hb DB ω β hω
    haveI := hzs B
    letI : HasExt (SheafOfModules.{u+1}
        (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) := HasExt.standard _
    have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit
          (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))) =
        m • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit
          (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))) :
          Abelian.Ext
            (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))
            (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) 0) := by
      intro m
      induction m with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
    have hzero : (ℓ ^ k) • 𝟙 (SheafOfModules.unit
        (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) = 0 :=
      (wc_et_zmod_unit_pow_exact (AffineSpace (ULift.{u} (Fin c)) B) ℓ k hℓpos).1
    have htor : ∀ e : wcEtSuppExt DB (2 * c), (ℓ ^ k) • e = 0 := by
      intro e
      letI : HasExt (SheafOfModules.{u+1}
          (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) := HasExt.standard _
      have hlin := map_nsmul (Abelian.Ext.bilinearComp (wcEtSuppObj DB)
        (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))
        (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))
        (2 * c) 0 (2 * c) (add_zero _) e) (ℓ ^ k)
        (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit
          (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))))
      simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
      rw [Abelian.Ext.comp_mk₀_id] at hlin
      rw [← hlin, ← hmk, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    obtain ⟨hfin, hle⟩ := wc_et_supp_ext_card_pow_of_prime
      (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) ℓ k hk (2 * c) ℓ
      (fun D₁ => wc_et_affine_bundle_zero_supp_card_le K ℓ hℓ B qB b hb c D₁) DB
    haveI := hfin
    have hord : addOrderOf ω = ℓ ^ k := by
      obtain ⟨j, hjk, hj⟩ := (Nat.dvd_prime_pow (Fact.out : Nat.Prime ℓ)).mp
        (addOrderOf_dvd_of_nsmul_eq_zero (htor ω))
      have hjk' : j = k := by
        by_contra hne
        apply hω
        apply addOrderOf_dvd_iff_nsmul_eq_zero.mp
        rw [hj]
        exact Nat.pow_dvd_pow ℓ (by omega)
