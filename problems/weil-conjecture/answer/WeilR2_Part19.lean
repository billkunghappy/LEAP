    ⟨(Spec.preimage a₀).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  obtain ⟨φ, hφdef⟩ : ∃ φ : A →+* B₀, φ = α.comp (algebraMap A (wcQuadModelRing A n π c)) :=
    ⟨_, rfl⟩
  have hφ : Spec.map (CommRingCat.ofHom φ) = a₀ ≫ wcQuadModelStr A n π c := by
    rw [hφdef, CommRingCat.ofHom_comp, Spec.map_comp, ha₀]

  have hres : ∀ q : Spec (CommRingCat.of (IsLocalRing.ResidueField B₀)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) q = IsLocalRing.closedPoint B₀ :=
    fun q => IsLocalRing.PrimeSpectrum.comap_residue B₀ q
  have hpt : a₀ (IsLocalRing.closedPoint B₀) = x₀ := by
    obtain ⟨e, -, he⟩ := hsh.2.2.2.2.2
    let pt : ↥(Spec (CommRingCat.of (AlgebraicClosure
        ↑((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀)))) :=
      IsLocalRing.closedPoint _
    have h : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B₀)) ≫ a₀) pt =
        wcEtGeomPt (Spec (CommRingCat.of (wcQuadModelRing A n π c))) x₀ pt := by
      rw [he]
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h
    rw [hres] at h
    exact h.trans (Scheme.fromSpecResidueField_apply x₀ _)
  have hx₀' : x₀ = Spec.map (CommRingCat.ofHom α) (IsLocalRing.closedPoint B₀) := by
    rw [ha₀, hpt]
  have hX : ∀ p, α (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B₀ := by
    intro p
    have h := hx₀ p
    rw [hx₀'] at h
    exact h

  have hπm : φ π ∈ IsLocalRing.maximalIdeal B₀ := by
    have h1 : algebraMap A (wcQuadModelRing A n π c) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) := by
      show algebraMap A (MvPolynomial (Fin n) A ⧸ wcQuadModelIdeal A n π c) π = _
      rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.eq]
      have e1 : MvPolynomial.C π - ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
            MvPolynomial.X q =
          -(∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C π) := by ring
      rw [e1]
      exact neg_mem (Ideal.mem_span_singleton_self _)
    rw [hφdef, RingHom.comp_apply, h1]
    simp only [map_sum, map_mul]
    exact Ideal.sum_mem _ fun p _ => Ideal.sum_mem _ fun q _ => Ideal.mul_mem_left _ _ (hX q)
  have hJ : Ideal.map φ (IsLocalRing.maximalIdeal A) ≠ ⊤ := by
    intro htop
    have hle : Ideal.map φ (IsLocalRing.maximalIdeal A) ≤ IsLocalRing.maximalIdeal B₀ := by
      rw [Ideal.map_le_iff_le_comap, hπ, Ideal.span_singleton_le_iff_mem]
      exact hπm
    rw [htop] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal B₀).ne_top (top_le_iff.mp hle)

  rw [← hφ] at hps
  have eX : Xs ≅ Spec (CommRingCat.of (B₀ ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A))) := by
    letI : Algebra A B₀ := φ.toAlgebra
    have h2 := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct A B₀ (IsLocalRing.ResidueField A))
    try rw [RingHom.algebraMap_toAlgebra] at h2
    try rw [IsLocalRing.ResidueField.algebraMap_eq] at h2
    exact hps.isoIsPullback _ _ h2 ≪≫ Scheme.Spec.mapIso
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B₀
        (IsLocalRing.maximalIdeal A)).toRingEquiv.toCommRingCatIso.op)
  obtain ⟨hh, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B₀ _ hJ
  have hproj : Projective (SheafOfModules.unit (wcRingSheaf Xs ℓ)) :=
    @hprojGen Xs (B₀ ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)) _ hh hsep eX

  let ε : (DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcRingSheaf Xs ℓ))))⟦(1 : ℤ)⟧ ≅
      DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) (ComplexShape.up ℤ) (-1)).obj
          (SheafOfModules.unit (wcRingSheaf Xs ℓ))) :=
    ((DerivedCategory.Q.commShiftIso (1 : ℤ)).app _).symm ≪≫
      DerivedCategory.Q.mapIso (((CochainComplex.singleFunctors
        (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))).shiftIso 1 (-1) 0 (by norm_num)).app _)
  have h0 : v ≫ ε.hom = 0 :=
    DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective
      (P := SheafOfModules.unit (wcRingSheaf Xs ℓ)) (i := (n : ℤ) - 1)
      (L := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
        (ComplexShape.up ℤ) (-1)).obj (SheafOfModules.unit (wcRingSheaf Xs ℓ)))
      _ (-1) (by omega)
  rw [← cancel_mono ε.hom, h0, Limits.zero_comp]

theorem wc_qxe_chart_ring_hom {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Scheme.{u}) [AlgebraicGeometry.IsReduced E]
    (jE : E ⟶ wcProjK K n)
    (hjE : Set.range jE ⊆ wcXspVplus K n
      (wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))))
    (j : Fin n) :
    ∃ (χ : wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j))
      (ψ : (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j))),
      wcQxeChiPkg π' c' σ jE j χ ψ :=
by
  classical

  have L2 : ∀ {σ' : Type u} {B : Type u} [CommRing B] [SetLike σ' B] [AddSubgroupClass σ' B]
      (𝒜 : ℕ → σ') [GradedRing 𝒜] (f g : B) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 2),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) := by
    intro σ' B _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg (by norm_num : 0 < 2)
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

  let a : Fin (n + 1) → Fin (n + 1) → K :=
    wcXspExtCoeff (fun p q => σ (IsLocalRing.residue A' (c' p q)))
  have hsecopen : (wcProjK K n).basicOpen (wcLdpSec K n (wcLdpQuad K n a) j.castSucc) ≤
      @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        MvPolynomial.gradedAlgebra ((wcLdpQuad K n a : MvPolynomial (Fin (n + 1)) K)) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : (MvPolynomial.X j.castSucc : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ _)
    have h := L2 (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) _ _ hX (wcLdpQuad K n a).2
    intro y hy
    have hy' : y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X j.castSucc) ⊓ Proj.basicOpen (MvPolynomial.homogeneousSubmodule
          (Fin (n + 1)) K) (wcLdpQuad K n a : MvPolynomial (Fin (n + 1)) K) := by
      rw [h]; exact hy
    exact hy'.2
  let κ : K →+* Γ(E, wcQxeV K jE j) := wcCnSigma (jE ≫ wcProjKStr K n) (wcQxeV K jE j)
  let t : Fin (n + 1) → Γ(E, wcQxeV K jE j) := fun L =>
    (jE.app (wcSgD K n j.castSucc)).hom (wcSgE K n j.castSucc L)
  have hgermκ : ∀ (x : E) (hx : x ∈ wcQxeV K jE j) (c : K),
      (E.presheaf.germ (wcQxeV K jE j) x hx).hom (κ c) =
        wcLdpConst K (jE ≫ wcProjKStr K n) x c := by
    intro x hx c
    exact TopCat.Presheaf.germ_res_apply E.presheaf (homOfLE le_top) x hx _
  have htj : t j.castSucc = 1 := by
    show (jE.app (wcSgD K n j.castSucc)).hom (wcSgE K n j.castSucc j.castSucc) = 1
    rw [(wc_ldp_lnf_sec_quad K n j.castSucc a).1, map_one]

  have he : (∑ P, ∑ Q, κ (a P Q) * t P * t Q) = 0 := by
    apply eq_zero_of_basicOpen_eq_bot
    rw [eq_bot_iff]
    intro x hx
    exfalso
    have hxU : x ∈ wcQxeV K jE j := E.basicOpen_le _ hx
    rw [Scheme.mem_basicOpen _ _ _ hxU] at hx
    have hc := (wc_ldp_lnf_chart_germ K n (Over.mk (jE ≫ wcProjKStr K n)) jE rfl
      (fun a p hp c => wc_ldp_il_proj_const K n a p hp c)
      (fun a w => wc_ldp_lnf_sec_quad K n a w) j.castSucc x hxU).2.2.1 a
    have hunit : IsUnit (wcLdpGerm K n jE (wcLdpQuad K n a) j.castSucc x hxU) := by
      rw [hc]
      convert hx using 1
      simp only [map_sum, map_mul, hgermκ]
      rfl
    have hx2 : x ∈ E.basicOpen ((jE.app (wcSgD K n j.castSucc)).hom
        (wcLdpSec K n (wcLdpQuad K n a) j.castSucc)) := by
      rw [Scheme.mem_basicOpen _ _ _ hxU]
      exact hunit
    rw [← Scheme.Hom.preimage_basicOpen] at hx2
    have hmem := hsecopen ((Scheme.Hom.mem_preimage jE).mp hx2)
    exact hjE ⟨x, rfl⟩ hmem

  have h1 : ∀ p q : Fin n, a p.castSucc q.castSucc = σ (IsLocalRing.residue A' (c' p q)) := by
    intro p q
    show wcXspExtCoeff _ p.castSucc q.castSucc = _
    unfold wcXspExtCoeff
    rw [dif_pos (show ((p.castSucc : ℕ) < n ∧ (q.castSucc : ℕ) < n) from ⟨p.isLt, q.isLt⟩)]
    rfl
  have h2 : ∀ p : Fin n, a p.castSucc (Fin.last n) = 0 := by
    intro p
    show wcXspExtCoeff _ p.castSucc (Fin.last n) = _
    unfold wcXspExtCoeff
    have := p.isLt
    rw [dif_neg (fun h => by simp at h), if_neg (fun h => by simp at h <;> omega)]
  have h3 : ∀ q : Fin n, a (Fin.last n) q.castSucc = 0 := by
    intro q
    show wcXspExtCoeff _ (Fin.last n) q.castSucc = _
    unfold wcXspExtCoeff
    have := q.isLt
    rw [dif_neg (fun h => by simp at h), if_neg (fun h => by simp at h <;> omega)]
  have h4 : a (Fin.last n) (Fin.last n) = -1 := by
    show wcXspExtCoeff _ (Fin.last n) (Fin.last n) = _
    unfold wcXspExtCoeff
    rw [dif_neg (fun h => by simp at h), if_pos ⟨Fin.val_last n, Fin.val_last n⟩]
  have hsplit : (∑ P, ∑ Q, κ (a P Q) * t P * t Q) =
      (∑ p : Fin n, ∑ q : Fin n, κ (σ (IsLocalRing.residue A' (c' p q))) *
        t p.castSucc * t q.castSucc) - t (Fin.last n) ^ 2 := by
    simp only [Fin.sum_univ_castSucc, h1, h2, h3, h4, map_zero, map_neg, map_one, zero_mul,
      mul_zero, add_zero, Finset.sum_const_zero, zero_add]
    ring
  have hquad : (∑ p : Fin n, ∑ q : Fin n, κ (σ (IsLocalRing.residue A' (c' p q))) *
      t p.castSucc * t q.castSucc) = t (Fin.last n) ^ 2 := by
    have h := he
    rw [hsplit] at h
    exact sub_eq_zero.mp h

  have hres : IsLocalRing.residue A' π' = 0 :=
    (IsLocalRing.residue_eq_zero_iff π').mpr (by rw [hπ']; exact Ideal.mem_span_singleton_self π')

  let f₀ : A' →+* Γ(E, wcQxeV K jE j) := (κ.comp σ.toRingHom).comp (IsLocalRing.residue A')
  let w : Option (Fin n) → Γ(E, wcQxeV K jE j) := fun i =>
    Option.elim i (t (Fin.last n)) (fun p => if p = j then 0 else t p.castSucc)
  let F : MvPolynomial (Option (Fin n)) A' →+* Γ(E, wcQxeV K jE j) :=
    MvPolynomial.eval₂Hom f₀ w
  have hw0 : w none = t (Fin.last n) := rfl
  have hwj : w (some j) = 0 := if_pos rfl
  have hwp : ∀ p, p ≠ j → w (some p) = t p.castSucc := fun p hp => if_neg hp
  have hHat : ∀ p, F (wcQmbtChartHat j p) = t p.castSucc := by
    intro p
    by_cases hp : p = j
    · simp only [wcQmbtChartHat, if_pos hp, map_one]
      rw [hp, htj]
    · simp only [wcQmbtChartHat, if_neg hp, F, MvPolynomial.eval₂Hom_X']
      exact hwp p hp
  have hF : ∀ g ∈ wcQmbtChartIdeal A' n π' c' j, F g = 0 := by
    intro g hg
    have hle : wcQmbtChartIdeal A' n π' c' j ≤ RingHom.ker F := by
      apply Ideal.span_le.mpr
      intro r hr
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr
      rcases hr with rfl | rfl
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul]
        simp only [F, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hwj, zero_mul]
        simp only [f₀, RingHom.comp_apply, hres, map_zero, sub_zero]
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_pow, map_sum]
        simp only [map_sum, map_mul, hHat]
        simp only [F, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hw0]
        simp only [f₀, RingHom.comp_apply]
        rw [sub_eq_zero]
        exact hquad
    exact hle hg
  let χ : wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j) :=
    Ideal.Quotient.lift (wcQmbtChartIdeal A' n π' c' j) F hF
  have hχX : ∀ i, χ (wcQmdlCX A' n π' c' j i) = w i := by
    intro i
    show Ideal.Quotient.lift _ F hF (Ideal.Quotient.mk _ (MvPolynomial.X i)) = w i
    rw [Ideal.Quotient.lift_mk]
    exact MvPolynomial.eval₂Hom_X' f₀ w i
  have hχA : ∀ x : A', χ (algebraMap A' (wcQmbtChart A' n π' c' j) x) =
      κ (σ (IsLocalRing.residue A' x)) := by
    intro x
    rw [← Ideal.Quotient.mk_algebraMap]
    show Ideal.Quotient.lift _ F hF (Ideal.Quotient.mk _ _) = _
    rw [Ideal.Quotient.lift_mk, MvPolynomial.algebraMap_eq]
    exact MvPolynomial.eval₂Hom_C f₀ w x

  let φ : wcQmbtChart A' n π' c' j →+* Γ((wcQxeV K jE j).toScheme, ⊤) :=
    (wcQxeV K jE j).topIso.inv.hom.comp χ
  let φc : CommRingCat.of (wcQmbtChart A' n π' c' j) ⟶ Γ((wcQxeV K jE j).toScheme, ⊤) :=
    CommRingCat.ofHom φ
  let ψ : (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)) :=
    (wcQxeV K jE j).toScheme.toSpecΓ ≫ Spec.map φc
  have key : (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv ≫ ψ.appTop = φc := by
    simp only [ψ, Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality]
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have happ : ∀ f : wcQmbtChart A' n π' c' j,
      ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv.hom f) =
        (wcQxeV K jE j).topIso.inv.hom (χ f) := by
    intro f
    have h := congrArg (fun g => g.hom f) key
    exact h
  exact ⟨χ, ψ, (hχX none).trans hw0, (hχX (some j)).trans hwj,
    fun p hp => (hχX (some p)).trans (hwp p hp), hχA, happ⟩

theorem wc_qxe_overlap_theta {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'} {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Scheme.{u}) (jE : E ⟶ wcProjK K n)
    (χ : ∀ j, wcQmbtChart A' n π' c' j →+* Γ(E, wcQxeV K jE j))
    (ψ : ∀ j, (wcQxeV K jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : ∀ j, wcQxeChiPkg π' c' σ jE j (χ j) (ψ j)) (l m : Fin n) (hlm : l ≠ m)
    (τ : wcQmbtChart A' n π' c' m →+* Localization.Away (wcQmdlCX A' n π' c' l (some m)))
    (hτ1 : τ (wcQmdlCX A' n π' c' m none) =
          algebraMap (wcQmbtChart A' n π' c' l) (Localization.Away (wcQmdlCX A' n π' c' l (some m)))
            (wcQmdlCX A' n π' c' l none) *
            IsLocalization.Away.invSelf (S := Localization.Away (wcQmdlCX A' n π' c' l (some m)))
              (wcQmdlCX A' n π' c' l (some m)))
    (hτ2 : τ (wcQmdlCX A' n π' c' m (some m)) =
          algebraMap (wcQmbtChart A' n π' c' l) (Localization.Away (wcQmdlCX A' n π' c' l (some m)))
            (wcQmdlCX A' n π' c' l (some l) * wcQmdlCX A' n π' c' l (some m)))
    (hτ3 : ∀ p, p ≠ m → τ (wcQmdlCX A' n π' c' m (some p)) =
          algebraMap (wcQmbtChart A' n π' c' l) (Localization.Away (wcQmdlCX A' n π' c' l (some m)))
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' l) (wcQmbtChartHat l p)) *
            IsLocalization.Away.invSelf (S := Localization.Away (wcQmdlCX A' n π' c' l (some m)))
              (wcQmdlCX A' n π' c' l (some m)))
    (hτA : τ.comp (algebraMap A' (wcQmbtChart A' n π' c' m)) =
        (algebraMap (wcQmbtChart A' n π' c' l)
          (Localization.Away (wcQmdlCX A' n π' c' l (some m)))).comp
          (algebraMap A' (wcQmbtChart A' n π' c' l))) :
    ∃ θ : (wcQxeV K jE l ⊓ wcQxeV K jE m).toScheme ⟶
        Spec (.of (Localization.Away (wcQmdlCX A' n π' c' l (some m)))),
      θ ≫ Spec.map (CommRingCat.ofHom (algebraMap (wcQmbtChart A' n π' c' l)
          (Localization.Away (wcQmdlCX A' n π' c' l (some m))))) =
        E.homOfLE (inf_le_left : wcQxeV K jE l ⊓ wcQxeV K jE m ≤ wcQxeV K jE l) ≫ ψ l ∧
      θ ≫ Spec.map (CommRingCat.ofHom τ) =
        E.homOfLE (inf_le_right : wcQxeV K jE l ⊓ wcQxeV K jE m ≤ wcQxeV K jE m) ≫ ψ m :=
by


  have CT : ∀ (T : Scheme.{u}) (g : T ⟶ wcProjK K n) (c c' : Fin (n + 1)),
      (g.app (wcSgD K n c)).hom (wcSgE K n c c) = 1 ∧
      (∀ (J L : Fin (n + 1)) (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K n J)
          (hOW : O ≤ g ⁻¹ᵁ wcSgD K n c),
        g.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
            T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n c)).hom (wcSgE K n c J)) =
          T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n c)).hom (wcSgE K n c L))) ∧
      (∀ L : Fin (n + 1),
        T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
            g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' L)) =
          T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
            g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' c)) *
          T.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
            g ⁻¹ᵁ wcSgD K n c)).op ((g.app (wcSgD K n c)).hom (wcSgE K n c L))) ∧
      T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
          g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' c)) *
        T.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
          g ⁻¹ᵁ wcSgD K n c)).op ((g.app (wcSgD K n c)).hom (wcSgE K n c c')) = 1 := by
    intro T g c c'
    have L2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
        (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1),
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
      intro σ A _ _ _ 𝒜 _ f g h hf hg hh
      have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
          (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
              (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
            (Proj 𝒜).presheaf.map (homOfLE h₁).op
              (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
            (Proj 𝒜).presheaf.map (homOfLE h₂).op
              (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
        rintro W rfl h₁ h₂
        have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
            Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
          intro a
          have := ConcreteCategory.congr_hom
            (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
          exact this.symm
        have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
            Proj.awayToSection 𝒜 (f * g)
              (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
          intro b
          have := ConcreteCategory.congr_hom
            (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
          exact this.symm
        rw [e1, e1, e2, ← map_mul]
        congr 1
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
          HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
        ring
      exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have C0 : ∀ J L j : Fin (n + 1),
        (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤
            wcSgD K n J)).op (wcSgE K n J j) =
          (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤
            wcSgD K n J)).op (wcSgE K n J L) *
          (wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n J ⊓ wcSgD K n L ≤
            wcSgD K n L)).op (wcSgE K n L j) := by
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
        MvPolynomial.gradedAlgebra
      intro J L j
      exact L2 _ (MvPolynomial.X J) (MvPolynomial.X L) (MvPolynomial.X j) (hX J) (hX L) (hX j)
    have E1 : ∀ J : Fin (n + 1), wcSgE K n J J = 1 := by
      intro J
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
        MvPolynomial.gradedAlgebra
      have h1 : HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1
          (MvPolynomial.X J) (hX J) = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        exact ⟨1, by simp⟩
      show Proj.awayToSection _ _ _ = 1
      rw [h1, map_one]
    have T0 : ∀ (A A' : (wcProjK K n).Opens) (k : A' ≤ A) (s : Γ(wcProjK K n, A))
        (O : T.Opens) (h' : O ≤ g ⁻¹ᵁ A') (h : O ≤ g ⁻¹ᵁ A),
        g.appLE A' O h' ((wcProjK K n).presheaf.map (homOfLE k).op s) = g.appLE A O h s := by
      intro A A' k s O h' h
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    have II : ∀ (a J L : Fin (n + 1)) (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K n J)
        (hOW : O ≤ g ⁻¹ᵁ wcSgD K n a),
        g.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
            T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a J)) =
          T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a L)) := by
      intro a J L O hO hOW
      have hW : O ≤ g ⁻¹ᵁ (wcSgD K n a ⊓ wcSgD K n J) := by
        rw [Scheme.Hom.preimage_inf]
        exact le_inf hOW hO
      have e1 : T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a J)) =
          g.appLE (wcSgD K n a ⊓ wcSgD K n J) O hW
            ((wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n a ⊓ wcSgD K n J ≤
              wcSgD K n a)).op (wcSgE K n a J)) :=
        (T0 _ _ inf_le_left _ O hW hOW).symm
      have e2 : T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a L)) =
          g.appLE (wcSgD K n a ⊓ wcSgD K n J) O hW
            ((wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n a ⊓ wcSgD K n J ≤
              wcSgD K n a)).op (wcSgE K n a L)) :=
        (T0 _ _ inf_le_left _ O hW hOW).symm
      have e3 : g.appLE (wcSgD K n J) O hO (wcSgE K n J L) =
          g.appLE (wcSgD K n a ⊓ wcSgD K n J) O hW
            ((wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n a ⊓ wcSgD K n J ≤
              wcSgD K n J)).op (wcSgE K n J L)) :=
        (T0 _ _ inf_le_right _ O hW hO).symm
      rw [e1, e2, e3, C0 a J L, map_mul, mul_comm]
    refine ⟨?_, II c, ?_, ?_⟩
    · rw [E1 c, map_one]
    · intro L
      have h := II c' c L (g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c') inf_le_left inf_le_right
      exact h.symm.trans (mul_comm _ _)
    · have h := II c' c c' (g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c') inf_le_left inf_le_right
      have h1 : T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
          g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' c')) = 1 := by
        rw [E1 c', map_one, map_one]
      exact (mul_comm _ _).trans (h.trans h1)
  obtain ⟨C1, -, C3, C4⟩ := CT E jE l.castSucc m.castSucc

  let rl : Γ(E, wcQxeV K jE l) →+* Γ(E, wcQxeV K jE l ⊓ wcQxeV K jE m) :=
    (E.presheaf.map (homOfLE (inf_le_left : wcQxeV K jE l ⊓ wcQxeV K jE m ≤
      wcQxeV K jE l)).op).hom
  let rm : Γ(E, wcQxeV K jE m) →+* Γ(E, wcQxeV K jE l ⊓ wcQxeV K jE m) :=
