      Nat.one_pos) (Spec.map (CommRingCat.ofHom ψ)) ?_
    ((⨆ (i : ℕ) (_ : i < k), wcSgD Ω (2 * e + 2) ⟨if i ≤ e then 2 * i + 1 else 2 * e + 1, by split_ifs <;> omega⟩ :
      (wcProjK Ω (2 * e + 2)).Opens) : Set (wcProjK Ω (2 * e + 2))) _ _ ?_ ?_⟩
  · rw [hrange, hY, hrangeA]
    ext p
