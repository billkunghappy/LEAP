        · apply hinj
          have := congrArg (Scheme.ΓSpecIso (.of C)).hom.hom hx
          rw [map_mul, hhi, map_zero] at this
          rw [map_zero]; exact hb.1 _ this
        · apply hinj
          have := congrArg (Scheme.ΓSpecIso (.of C)).hom.hom hx
          rw [map_mul, hhi, map_zero] at this
          rw [map_zero]; exact hb.2 _ this
      let x : (⊤ : (Spec (.of C)).Opens) := ⟨y, trivial⟩
      letI : Algebra Γ(Spec (.of C), ⊤) ((Spec (.of C)).presheaf.stalk (x : Spec (.of C))) :=
        ((Spec (.of C)).presheaf.germ ⊤ (x : Spec (.of C)) trivial).hom.toAlgebra
      haveI := hU.isLocalization_stalk x
      have hmap := IsLocalization.map_nonZeroDivisors_le
        (hU.primeIdealOf x).asIdeal.primeCompl ((Spec (.of C)).presheaf.stalk (x : Spec (.of C)))
