          ((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj W) :=
      (Functor.mapHomologicalComplexCompIso κ.symm (ComplexShape.up ℤ)).app _ ≪≫
        (K.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso
          ((Functor.mapHomologicalComplexCompIso ρ (ComplexShape.up ℤ)).app W)
    let i₂ := HomologicalComplex.homologyMapIso β j
    let i₃ : ((K.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj W)).homology j ≅
        K.obj (((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj W).homology j) :=
      (((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj W).sc j).mapHomologyIso K
    exact ⟨i₁ ≪≫ i₂ ≪≫ i₃⟩
  refine ⟨fun j hj => ?_, fun q => ?_⟩
  · obtain ⟨φ⟩ := chain I.cochainComplex θ j
    have h0 : Limits.IsZero
        (((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).homology j) :=
      (((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).sc j).isZero_homology_of_isZero_X₂
        (R.map_isZero (HomologicalComplex.isZero_extend_X I.cocomplex ComplexShape.embeddingUpNat j
          (fun i => by rw [ComplexShape.embeddingUpNat_f]; omega)))
    exact (K.map_isZero h0).of_iso φ
  · obtain ⟨φ⟩ := chain I.cochainComplex θ (q : ℤ)
    let L := I.cocomplex
    let aux : ∀ o : Option ℕ, R.obj (HomologicalComplex.extend.X L o) ≅
        HomologicalComplex.extend.X ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj L) o :=
      fun o => match o with
        | some _ => Iso.refl _
        | none => Limits.IsZero.iso (R.map_isZero (Limits.isZero_zero _)) (Limits.isZero_zero _)
    have α : (R.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ≅
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat := by
      refine HomologicalComplex.Hom.isoOfComponents
        (fun i' => aux (ComplexShape.embeddingUpNat.r i')) ?_
      intro i' j' _
      show (aux _).hom ≫ HomologicalComplex.extend.d _ _ _ =
        R.map (HomologicalComplex.extend.d L _ _) ≫ (aux _).hom
      generalize ComplexShape.embeddingUpNat.r i' = o1
      generalize ComplexShape.embeddingUpNat.r j' = o2
      cases o1 with
      | none => exact (R.map_isZero (Limits.isZero_zero _)).eq_of_src _ _
      | some a =>
        cases o2 with
        | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
        | some b =>
          show 𝟙 _ ≫ R.map (L.d a b) = R.map (L.d a b) ≫ 𝟙 _
          rw [Category.id_comp, Category.comp_id]
    exact ⟨φ ≪≫ K.mapIso (HomologicalComplex.homologyMapIso α (q : ℤ) ≪≫
      HomologicalComplex.extendHomologyIso _ ComplexShape.embeddingUpNat
        (ComplexShape.embeddingUpNat_f q))⟩

theorem wc_qmbt_msk_closed_pull_isZero_of_top_sections {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (hM : ∀ (Vt : X.ProEt),
      (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
            HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i) →
      ∀ s : M.val.obj (Opposite.op Vt), s = 0) :
    Limits.IsZero (Di.Φ.obj M) :=
by
  classical
  haveI := Di.cont
  let α := (SheafOfModules.toSheaf _).map (0 : Di.Φ.obj M ⟶ Di.Φ.obj M)
  haveI hα : IsIso α := by
    apply wc_proet_isIso_of_sections_bijective
    intro U
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (wc_pmn_vp_thick_cover i ℓ Di hDi U)
    intro T f hf
    obtain ⟨Vt, κ, hW, hcl, hunit⟩ := hf
    haveI hsM : Subsingleton (M.val.obj (Opposite.op Vt)) :=
      ⟨fun a b => (hM Vt hW hcl a).trans (hM Vt hW hcl b).symm⟩
    haveI hsM' : Subsingleton (((𝟭 (SheafOfModules.{u+1} (wcRingSheaf X ℓ))).obj M).val.obj
        (Opposite.op Vt)) := hsM
    have hsP : Subsingleton (((SheafOfModules.pushforward Di.φ).obj (Di.Φ.obj M)).val.obj
        (Opposite.op Vt)) := (hunit M).2.subsingleton
    haveI hsB : Subsingleton (((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.obj
        (Opposite.op ((wcProEtBC i).obj Vt))) := hsP
    have iB := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.map κ.hom.op)
    haveI hsT : Subsingleton (((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.obj
        (Opposite.op T)) := iB.1.subsingleton
    exact ⟨fun a b _ => Subsingleton.elim a b, fun b => ⟨b, Subsingleton.elim _ _⟩⟩
  haveI : IsIso (0 : Di.Φ.obj M ⟶ Di.Φ.obj M) :=
    isIso_of_reflects_iso _ (SheafOfModules.toSheaf _)
  rw [Limits.IsZero.iff_id_eq_zero]
  calc 𝟙 (Di.Φ.obj M) = (0 : Di.Φ.obj M ⟶ Di.Φ.obj M) ≫ inv (0 : Di.Φ.obj M ⟶ Di.Φ.obj M) :=
        (IsIso.hom_inv_id _).symm
    _ = 0 := Limits.zero_comp

theorem wc_qmbt_msk_wcontr_sections_vanish {X : Scheme.{u}} [IsAffine X] (B : Type u) [CommRing B]
    [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (g : X ⟶ Spec (.of B))
    {Z : Scheme.{u}} (i : Z ⟶ Spec (.of B)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf X ℓ))) (q : ℕ)
    (hvan : ∀ y : wcHM X ℓ q, y = 0)
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt X (ℓ ^ k) j))
    (hbij : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (c : Spec (.of C) ⟶ Spec (.of B)), WeaklyEtale c →
      c (IsLocalRing.closedPoint C) ∈ Set.range i →
      ∀ {Pq : Scheme.{u}} (q' : Pq ⟶ X) (t : Pq ⟶ Spec (.of C)), IsPullback q' t g c →
      ∀ k : ℕ, 1 ≤ k → ∀ (D : wcZModPullData q' (ℓ ^ k)), wcZModPullCanonical D →
      ∀ j : ℕ, Function.Bijective (wcZModPull D j)) :
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    ∀ (Vt : (Spec (.of B)).ProEt),
      (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
            HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i) →
      ∀ s : (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).val.obj
        (Opposite.op Vt), s = 0 :=
by
  intro P
  haveI := Dg.additive
  obtain ⟨Ψ, -, -⟩ := wc_proet_push_homology_sections_hm g ℓ Dg hDg I q
  intro Vt hW hrange s
  haveI : IsAffine Vt.left := hW.1
  have hVt : Projective (wcFreeSheaf (Spec (.of B)) Vt) :=
    wc_proet_free_projective_wcontractible (Spec (.of B)) Vt hW
  obtain ⟨Dc, hDc⟩ := wc_hm_pull_data_exists (((wcProEtBC g).obj Vt).hom ≫ 𝟙 X) ℓ

  have hb : ∀ k : ℕ, 1 ≤ k → ∀ (z : Vt.left), IsClosed ({z} : Set Vt.left) →
      ∀ {Pq : Scheme.{u}} (q' : Pq ⟶ X) (t : Pq ⟶ Spec (Vt.left.presheaf.stalk z)),
      IsPullback q' t g (Vt.left.fromSpecStalk z ≫ Vt.hom ≫ 𝟙 (Spec (.of B))) →
      ∀ (D : wcZModPullData q' (ℓ ^ k)), wcZModPullCanonical D →
      ∀ j : ℕ, Function.Bijective (wcZModPull D j) := by
    intro k hk z hz Pq q' t hP D hD j
    have hf : WeaklyEtale (Vt.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale Vt.left z
    have hc : WeaklyEtale (Vt.left.fromSpecStalk z ≫ Vt.hom ≫ 𝟙 (Spec (.of B))) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hf
        (@MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ Vt.prop
          (@MorphismProperty.id_mem _ _ @WeaklyEtale
            MorphismProperty.IsMultiplicative.toContainsIdentities _))
    refine @hbij (Vt.left.presheaf.stalk z) _ (hW.2.2.2.2 z hz).1 (hW.2.2.2.2 z hz).2
      (Vt.left.fromSpecStalk z ≫ Vt.hom ≫ 𝟙 (Spec (.of B))) hc ?_ Pq q' t hP k hk D hD j
    show Vt.hom (Vt.left.fromSpecStalk z (IsLocalRing.closedPoint (Vt.left.presheaf.stalk z))) ∈ _
    rw [Scheme.fromSpecStalk_closedPoint]
    exact hrange z hz
  haveI : IsAffine (Limits.pullback Vt.hom g) :=
    @Scheme.Pullback.isAffine_of_isAffine_isAffine_isAffine Vt.left X (Spec (.of B)) Vt.hom g
      hW.1 _ inferInstance
  choose Dk hDk using fun k : ℕ =>
    wc_zmod_pull_data_exists (((wcProEtBC g).obj Vt).hom ≫ 𝟙 X) (ℓ ^ k)
  have htor := fun (k j : ℕ) (hk : 1 ≤ k) =>
    wc_wcontr_torsion_kunneth_of_base_bij g g (𝟙 X) (𝟙 (Spec (.of B))) IsPullback.of_id_fst
      inferInstance inferInstance (ℓ ^ k) Vt hW (hb k hk) j (Dk k) (hDk k)
  have he : Function.Bijective (fun c : Fin 0 → ℚ_[ℓ] =>
      ∑ a, wcHMScalar X ℓ q (c a) ((Fin.elim0 : Fin 0 → wcHM X ℓ q) a)) := by
    refine ⟨fun c₁ c₂ _ => funext fun a => a.elim0, fun y => ⟨Fin.elim0, ?_⟩⟩
    exact (Fin.sum_univ_zero _).trans (hvan y).symm
  have hK := wc_hm_ladic_kunneth_passage (Y := X) (T := Limits.pullback Vt.hom g) (W₀ := Vt.left) ℓ
    (Limits.pullback.fst Vt.hom g) (((wcProEtBC g).obj Vt).hom ≫ 𝟙 X) Dc hDc Dk hDk hfin htor q 0
    (Fin.elim0 : Fin 0 → wcHM X ℓ q) he
  obtain ⟨c, hc⟩ := hK.2 (Ψ Vt hVt s)
  have h0 : Ψ Vt hVt s = 0 := hc.symm.trans (Fin.sum_univ_zero _)
  exact (Ψ Vt hVt).injective (h0.trans (map_zero _).symm)

theorem wc_qmbt_msk_top_card_devissage : ∀ (Z : Scheme.{u}) (ℓ : ℕ), ℓ.Prime → ∀ (N : ℕ), 2 ≤ N →
    Nat.card (wcEtCoh Z ℓ N) = ℓ → Subsingleton (wcEtCoh Z ℓ (N + 1)) →
    (∀ j : ℕ, 1 ≤ j → Subsingleton (wcEtCoh Z (ℓ ^ j) (N - 1))) →
    ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Z (ℓ ^ k) N) = ℓ ^ k :=
by
  intro Z ℓ hℓ N hN h1 h2 hlow k hk
  classical
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  have hN1 : N - 1 + 1 = N := by omega
  have hcard : ∀ {A B D : Type _} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
      (α : A →+ B) (β : B →+ D), Function.Injective α → (∀ b, β b = 0 ↔ ∃ a, α a = b) →
      Nat.card B = Nat.card A * Nat.card β.range := by
    intro A B D _ _ _ α β hα hex
    have hker : β.ker = α.range := by
      ext b
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
      exact hex b
    have e1 : Nat.card (B ⧸ β.ker) = Nat.card β.range :=
      Nat.card_congr (QuotientAddGroup.quotientKerEquivRange β).toEquiv
    have e2 : Nat.card β.ker = Nat.card A := by
      rw [hker]
      exact (Nat.card_congr (AddMonoidHom.ofInjective hα).toEquiv).symm
    rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup β.ker, e1, e2, mul_comm]
  have habsN : ∀ (P : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})),
      S.ShortExact → Subsingleton (Abelian.Ext P S.X₁ (N + 1)) →
      (∀ z : Abelian.Ext P S.X₁ N, z.comp (Abelian.Ext.mk₀ S.f) (add_zero N) = 0 → z = 0) →
      Nat.card (Abelian.Ext P S.X₂ N) =
        Nat.card (Abelian.Ext P S.X₁ N) * Nat.card (Abelian.Ext P S.X₃ N) := by
    intro P S hS hsub hinj
    let α : Abelian.Ext P S.X₁ N →+ Abelian.Ext P S.X₂ N :=
      (Abelian.Ext.mk₀ S.f).postcomp P (add_zero N)
    let β : Abelian.Ext P S.X₂ N →+ Abelian.Ext P S.X₃ N :=
      (Abelian.Ext.mk₀ S.g).postcomp P (add_zero N)
    have hα : ∀ (x : Abelian.Ext P S.X₁ N),
        α x = x.comp (Abelian.Ext.mk₀ S.f) (add_zero N) := by
      intro x
      simp only [α, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply]
    have hβ : ∀ (x : Abelian.Ext P S.X₂ N),
        β x = x.comp (Abelian.Ext.mk₀ S.g) (add_zero N) := by
      intro x
      simp only [β, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply]
    have hex : ∀ b, β b = 0 ↔ ∃ a, α a = b := by
      intro b
      rw [hβ]
      constructor
      · intro hb
        obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS b hb
        exact ⟨a, by rw [hα]; exact ha⟩
      · rintro ⟨a, rfl⟩
        rw [hα, Abelian.Ext.comp_assoc a (Abelian.Ext.mk₀ S.f) (Abelian.Ext.mk₀ S.g) (add_zero N)
          (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, S.zero, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
    have hinjN : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      rw [hα] at hz
      exact hinj z hz
    have hsurjN : Function.Surjective β := by
      intro x₃
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x₃ (rfl : N + 1 = N + 1)
        (Subsingleton.elim _ _)
      exact ⟨x₂, by rw [hβ]; exact hx₂⟩
    rw [hcard α β hinjN hex, AddMonoidHom.range_eq_top.mpr hsurjN, AddSubgroup.card_top]
  have hses : ∀ (p k : ℕ), p ≠ 0 →
      ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
        (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
        (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
    intro p k hp
    have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
        ZMod.natCast_self]
    let α : ZMod k →+ ZMod (p * k) :=
      ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
      intro z
      show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
      rw [ZMod.lift_coe]
      change z • (p : ZMod (p * k)) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
    have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
      map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
      push_cast at hx
      rw [mul_comm z] at hx
      exact (mul_dvd_mul_iff_left hp').mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (p * k)), hβ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ]
      push_cast
      rw [ZMod.natCast_self, mul_zero]
    have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod k), ?_⟩
      rw [hα]
      congr 1
      ring
    let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hw : f ≫ g = 0 := by
      ext x
      exact hβα x.down
    refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩
  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Z)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
  induction k, hk using Nat.le_induction with
  | base => rw [pow_one]; exact h1
  | succ j hj ih =>
    have hp : ℓ ^ j ≠ 0 := pow_ne_zero j hℓ0
    obtain ⟨f, g, hw, hS₀⟩ := hses (ℓ ^ j) ℓ hp
    have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    have key := habsN ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS h2 (fun z hz => by
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS z hz hN1
      obtain ⟨hs⟩ := hlow j hj
      have h0 : x₃ = 0 := (hs x₃ (x₃ - x₃)).trans (sub_self x₃)
      rw [← hx₃, h0, Abelian.Ext.zero_comp])
    change Nat.card (wcEtCoh Z (ℓ ^ j * ℓ) N) =
      Nat.card (wcEtCoh Z ℓ N) * Nat.card (wcEtCoh Z (ℓ ^ j) N) at key
    rw [pow_succ, key, h1, ih, mul_comm]

theorem wc_qmbt_msk_base_alg {A A' : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'} {π : A} {π' : A'}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (hπ'2 : π' ^ 2 = ιA π)
    (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') :
    Function.Injective ιA ∧ (letI := (φ'.comp ιA).toAlgebra; Algebra.IsAlgebraic A L') :=
by
  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hπ'0 : π' ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A'
    rw [hπ', h, Ideal.span_singleton_eq_bot.mpr rfl]
  have hinj : Function.Injective ιA := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hne hirr
    rw [hu, map_mul, map_pow, ← hπ'2] at ha
    have hunit : IsUnit (ιA (u : A)) := (Units.isUnit u).map ιA
    have h2 : (π' ^ 2) ^ m = 0 := (hunit.mul_right_eq_zero).mp ha
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      simp at h2
    · have h3 := (pow_eq_zero_iff hm.ne').mp h2
      exact hπ'0 ((pow_eq_zero_iff two_ne_zero).mp h3)
  refine ⟨hinj, ?_⟩
  letI : Algebra A A' := ιA.toAlgebra
  letI : Algebra A' L' := φ'.toAlgebra
  letI : Algebra A L' := (φ'.comp ιA).toAlgebra
  haveI : IsScalarTower A A' L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hπint : IsIntegral A π' := by
    have h : IsIntegral A (π' ^ 2) := by
      rw [hπ'2]
      exact isIntegral_algebraMap
    exact IsIntegral.of_pow (by norm_num) h
  haveI : Algebra.IsIntegral A A' := ⟨fun a' => by
    obtain ⟨x, y, rfl⟩ := hgen a'
    exact IsIntegral.add isIntegral_algebraMap (IsIntegral.mul isIntegral_algebraMap hπint)⟩
  haveI : Algebra.IsAlgebraic A' L' := halg'
  exact Algebra.IsIntegral.trans_isAlgebraic A A' L'

theorem wc_qmbt_msk_ladic_of_et_counts (Y : Scheme.{u}) [IsAffine Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (n : ℕ) (hn4 : 4 ≤ n)
    (h0 : ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Y (ℓ ^ k) 0) = ℓ ^ k)
    (hsub : ∀ k q : ℕ, 1 ≤ k → (1 ≤ q ∧ q + 2 ≤ n ∨ n ≤ q) → Subsingleton (wcEtCoh Y (ℓ ^ k) q))
    (htop : ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Y (ℓ ^ k) (n - 1)) = ℓ ^ k) :
    (∀ q : ℕ, 1 ≤ q → q ≠ n - 1 → ∀ y : wcHM Y ℓ q, y = 0) ∧
    (∃ y : wcHM Y ℓ (n - 1), Function.Bijective (fun c : ℚ_[ℓ] => wcHMScalar Y ℓ (n - 1) c y)) ∧
    (∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j)) :=
by
  have hpos : ∀ k : ℕ, ℓ ^ k ≠ 0 := fun k => (pow_pos (Fact.out : ℓ.Prime).pos k).ne'
  have hfinEt : ∀ k j : ℕ, 1 ≤ k → Finite (wcEtCoh Y (ℓ ^ k) j) := by
    intro k j hk
    by_cases hj0 : j = 0
    · subst hj0
      exact Nat.finite_of_card_ne_zero (by rw [h0 k hk]; exact hpos k)
    · by_cases hjn : j = n - 1
      · subst hjn
        exact Nat.finite_of_card_ne_zero (by rw [htop k hk]; exact hpos k)
      · haveI := hsub k j hk (by omega)
        exact Finite.of_subsingleton
  have hsubTop : Subsingleton (wcEtCoh Y ℓ (n - 1 + 1)) := by
    have := hsub 1 (n - 1 + 1) le_rfl (Or.inr (by omega))
    rwa [pow_one] at this
  obtain ⟨y, hy, hfin⟩ := wc_hm_line_of_et_counts_affine Y ℓ (n - 1) hfinEt htop hsubTop
  refine ⟨?_, ⟨y, hy⟩, hfin⟩
  intro q hq hqn x
  obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
  have ha : ∀ k : ℕ, Subsingleton (wcEtCoh Y (ℓ ^ (k + 1)) (j + 1)) :=
    fun k => hsub (k + 1) (j + 1) (by omega) (by omega)
  have hb : ∀ k : ℕ, ∀ z : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcZModSheaf Y (ℓ ^ (k + 1))) (j + 1), z = 0 :=
    fun k => wc_proet_zmod_ext_vanish_of_et Y (ℓ ^ (k + 1)) j (ha k)
  have hc := wc_proet_int_ext_vanish_of_zmod_deg Y ℓ (Scheme.ProEt.mk (𝟙 Y)) j hb
  exact wc_hm_vanish_of_int_ext_vanish Y ℓ j hc x

theorem wc_quadric_model_milnor_package : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsDiscreteValuationRing A] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : A) → ∀ (k n : ℕ), Even n → 2 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det → ∀ (x₀ : Spec (.of (wcQuadModelRing A n π c))), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) → wcQuadModelStr A n π c x₀ = IsLocalRing.closedPoint A → ∀ (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀)) (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))), wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)), ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A → Nat.card (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) (ℓ ^ k) 0) = ℓ ^ k ∧ (∀ q : ℕ, 1 ≤ q → q + 2 ≤ n → Subsingleton (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) (ℓ ^ k) q)) ∧ IsAddCyclic (wcEtZModExt (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) (ℓ ^ k) (n - 1)) :=
by
  intro A _ _ _ _ _ ℓ hℓ hunitℓ k n hn hn2 π c hπ hc x₀ hX hx₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hB₀ Ω _ _ ξ hξ
  classical
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓ⟩
  have hℓZ : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ.ne_zero



  have hℓΩ : ((ℓ : ℕ) : Ω) ≠ 0 := by
    have h1 := hunitℓ.map (Spec.preimage ξ).hom
    rw [map_natCast] at h1
    exact h1.ne_zero
  have hπ0 : (Spec.preimage ξ).hom π ≠ 0 := by
    have hker : ∀ y : A, y ∈ (ξ (IsLocalRing.closedPoint Ω)).asIdeal ↔
        (Spec.preimage ξ).hom y = 0 := by
      intro y
      conv_lhs => rw [← Spec.map_preimage ξ]
      show y ∈ Ideal.comap (Spec.preimage ξ).hom (IsLocalRing.maximalIdeal Ω) ↔ _
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_ne_zero,
        not_not]
    intro h0
    apply hξ
    have hle : IsLocalRing.maximalIdeal A ≤ (ξ (IsLocalRing.closedPoint Ω)).asIdeal := by
      rw [hπ, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, hker]
      exact h0
    have hge : (ξ (IsLocalRing.closedPoint Ω)).asIdeal ≤ IsLocalRing.maximalIdeal A :=
      IsLocalRing.le_maximalIdeal (ξ (IsLocalRing.closedPoint Ω)).isPrime.ne_top
    exact PrimeSpectrum.ext (le_antisymm hge hle)



  obtain ⟨hconn, hvan⟩ := wc_quadric_model_shens_milnor_fibre_low A ℓ hℓ hunitℓ n hn hn2 π c hπ hc
    x₀ hX hx₀ B₀ Λ₀ W₀ φ₀ a₀ hB₀ Ω ξ hξ
  haveI := hconn
  have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero _ hℓ.ne_zero
  have C1 : Nat.card (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) (ℓ ^ k) 0) =
      ℓ ^ k := wc_et_coh_zero_connected_card _ (ℓ ^ k) hm0



  have hdev : ∀ (T : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh T ℓ q) →
      ∀ k : ℕ, Subsingleton (wcEtCoh T (ℓ ^ k) q) := by
    intro T q hq
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})),
        S.ShortExact → Subsingleton (Abelian.Ext X S.X₁ q) →
        Subsingleton (Abelian.Ext X S.X₃ q) → Subsingleton (Abelian.Ext X S.X₂ q) := by
      intro X S hS h1 h3
      let ψ' : Abelian.Ext X S.X₂ q →+ Abelian.Ext X S.X₃ q :=
        (Abelian.Ext.mk₀ S.g).postcomp X (add_zero q)
      let φ'' : Abelian.Ext X S.X₁ q →+ Abelian.Ext X S.X₂ q :=
        (Abelian.Ext.mk₀ S.f).postcomp X (add_zero q)
      have hex : ∀ b, ψ' b = 0 → ∃ a, φ'' a = b := fun b hb =>
        Abelian.Ext.covariant_sequence_exact₂ X hS b hb
      have hz : ∀ b : Abelian.Ext X S.X₂ q, b = 0 := by
        intro b
        obtain ⟨a, ha⟩ := hex b (Subsingleton.elim _ _)
        rw [← ha, Subsingleton.elim a 0, map_zero]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    have hzero : ∀ (X Z : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}),
        Limits.IsZero Z → Subsingleton (Abelian.Ext X Z q) := by
      intro X Z hZ
      have hx : ∀ x : Abelian.Ext X Z q, x = 0 := by
        intro x
        have := Abelian.Ext.comp_mk₀_id x
        rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
        exact this.symm
      exact ⟨fun x y => by rw [hx x, hx y]⟩
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶
            AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶
            AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩)
          (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p :=
        (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶
          AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶
          AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale T)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
    intro k
    induction k with
    | zero =>
      rw [pow_zero]
      have hz : Limits.IsZero ((constantSheaf (Scheme.smallEtaleTopology T)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod 1)))) :=
        Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)
      exact hzero _ _ hz
    | succ k IH =>
      rw [pow_succ']
      obtain ⟨f, g, hw, hS₀⟩ := hses ℓ (ℓ ^ k) hℓ.ne_zero
      have hS := hS₀.map_of_exact
        (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
      exact hmid _ _ hS IH hq
  have C2 : ∀ q : ℕ, 1 ≤ q → q + 2 ≤ n →
      Subsingleton (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ) (ℓ ^ k) q) :=
    fun q hq1 hq2 => hdev _ q (hvan q hq1 hq2) k
  refine ⟨C1, C2, ?_⟩



  have L1 : ∀ (Z : Scheme.{u}) (m : ℕ), 1 ≤ m →
      ∀ (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}),
      (G ≅ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) →
      Nonempty (Limits.kernel (ℓ • 𝟙 G) ≅
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) := by
    intro Z m hm G e
    obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
    have hℓjZ : (ℓ : ℤ) ^ j ≠ 0 := pow_ne_zero _ hℓZ
    have hk0 : (zmultiplesHom (ZMod (ℓ ^ (j + 1))) ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))))
        (ℓ : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, ← pow_succ',
        ZMod.natCast_self]
    let α : ZMod ℓ →+ ZMod (ℓ ^ (j + 1)) :=
      ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (j + 1))) ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod ℓ) = ((z * ((ℓ ^ j : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (j + 1))) := by
      intro z
      show (ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (j + 1)))
        ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))), hk0⟩) (z : ZMod ℓ) = _
      rw [ZMod.lift_coe]
      change z • ((ℓ ^ j : ℕ) : ZMod (ℓ ^ (j + 1))) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast at hy
      rw [pow_succ, mul_comm z] at hy
      exact (mul_dvd_mul_iff_left hℓjZ).mp hy
    let α' : ULift.{u+1} (ZMod ℓ) →+ ULift.{u+1} (ZMod (ℓ ^ (j + 1))) :=
      (AddEquiv.ulift.symm : ZMod (ℓ ^ (j + 1)) ≃+ ULift.{u+1} (ZMod (ℓ ^ (j + 1)))).toAddMonoidHom.comp
        (α.comp (AddEquiv.ulift : ULift.{u+1} (ZMod ℓ) ≃+ ZMod ℓ).toAddMonoidHom)
    have hα' : ∀ y, (α' y).down = α y.down := fun y => rfl
    have hα'inj : Function.Injective α' := fun y₁ y₂ h =>
      ULift.ext _ _ (hαinj ((hα' y₁).symm.trans ((congrArg ULift.down h).trans (hα' y₂))))
    have hS : α'.range = (AddCommGrpCat.Hom.hom
        (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1))))))).ker := by
      ext y
      rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
      constructor
      · rintro ⟨y₀, rfl⟩
        apply ULift.ext
        show ℓ • α y₀.down = 0
        obtain ⟨z, hz⟩ := ZMod.intCast_surjective y₀.down
        rw [← hz, hα, nsmul_eq_mul]
        have h1 : ((ℓ : ℕ) : ZMod (ℓ ^ (j + 1))) * ((z * ((ℓ ^ j : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (j + 1)))
            = ((z * ((ℓ ^ (j + 1) : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (j + 1))) := by
          push_cast; ring
        rw [h1, ZMod.intCast_zmod_eq_zero_iff_dvd]
        exact ⟨z, by ring⟩
      · intro hy
        have hy' : ℓ • y.down = 0 := congrArg ULift.down hy
        obtain ⟨t, ht⟩ := ZMod.intCast_surjective y.down
        rw [← ht, nsmul_eq_mul] at hy'
        have h1 : ((ℓ : ℕ) : ZMod (ℓ ^ (j + 1))) * (t : ZMod (ℓ ^ (j + 1)))
            = (((ℓ : ℤ) * t : ℤ) : ZMod (ℓ ^ (j + 1))) := by
          push_cast; ring
        rw [h1, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy'
        push_cast at hy'
        rw [pow_succ'] at hy'
        obtain ⟨s, hs⟩ := (mul_dvd_mul_iff_left hℓZ).mp hy'
        refine ⟨⟨(s : ZMod ℓ)⟩, ULift.ext _ _ ?_⟩
        rw [hα']
        show α (s : ZMod ℓ) = y.down
        rw [hα, ← ht, hs]
        congr 1
        push_cast
        ring
    let E : ULift.{u+1} (ZMod ℓ) ≃+ ↥(AddCommGrpCat.Hom.hom
        (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1))))))).ker :=
      (AddMonoidHom.ofInjective hα'inj).trans (AddEquiv.addSubgroupCongr hS)
    let iso4 : Limits.kernel (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ (j + 1)))))) ≅
