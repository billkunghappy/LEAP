        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
        · intro i
          rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
