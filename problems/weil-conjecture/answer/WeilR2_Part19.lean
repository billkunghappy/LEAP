theorem wc_et_mod_homology_mono_of_local_dvd_pow : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ), 1 ≤ k → ∀ (Kc : CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S (ℓ ^ k))) ℕ) (n : ℕ) (κ : SheafOfModules.unit (wcEtZModRing S (ℓ ^ k)) ⟶ Kc.X n) (hκ : κ ≫ Kc.d n (n + 1) = 0), (∀ (T : S.Etale) (a : ℕ) (e : (Kc.X ((ComplexShape.up ℕ).prev n)).val.obj (Opposite.op T)), ((Kc.d ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e = a • (κ.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S (ℓ ^ k)).obj.obj (Opposite.op T)) → Nonempty T.left → ℓ ^ k ∣ a) → Mono (Kc.liftCycles κ (n + 1) (by simp) hκ ≫ Kc.homologyπ n) :=
by
  intro S ℓ _ k hk Kc n κ hκ hloc
  classical
  have hp : Nat.Prime ℓ := Fact.out
  haveI : NeZero (ℓ ^ k) := NeZero.of_pos (pow_pos hp.pos k)

  let ev : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S (ℓ ^ k))) (W : S.Etale),
      (SheafOfModules.unit (wcEtZModRing S (ℓ ^ k)) ⟶ M) →+ M.val.obj (Opposite.op W) :=
    fun M W => AddMonoidHom.mk' (fun f => (f.val.app (Opposite.op W)).hom
        (1 : (wcEtZModRing S (ℓ ^ k)).obj.obj (Opposite.op W))) (fun f g => by
      first
      | rfl
      | simp only [SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply])
  have hev : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S (ℓ ^ k))) (W : S.Etale)
      (f : SheafOfModules.unit (wcEtZModRing S (ℓ ^ k)) ⟶ M),
      ev M W f = (f.val.app (Opposite.op W)).hom
        (1 : (wcEtZModRing S (ℓ ^ k)).obj.obj (Opposite.op W)) := fun _ _ _ => rfl
  have hu1 : ∀ (W : S.Etale) (m : ℕ),
      ((m • 𝟙 (SheafOfModules.unit (wcEtZModRing S (ℓ ^ k)))).val.app (Opposite.op W)).hom
        (1 : (wcEtZModRing S (ℓ ^ k)).obj.obj (Opposite.op W)) =
      m • (1 : (wcEtZModRing S (ℓ ^ k)).obj.obj (Opposite.op W)) := by
    intro W m
    rw [← hev, map_nsmul, hev]
    rfl
  have hchar : ∀ W : S.Etale,
      (ℓ ^ k) • (1 : (wcEtZModRing S (ℓ ^ k)).obj.obj (Opposite.op W)) = 0 := by
    intro W
    have h := (wc_et_zmod_unit_pow_exact S ℓ k hp.pos).1
    rw [← hu1 W (ℓ ^ k), h]
    rfl
  have hcharC : ∀ W : S.Etale,
      ((ℓ ^ k : ℕ) : (wcEtZModRing S (ℓ ^ k)).obj.obj (Opposite.op W)) = 0 := by
    intro W
    rw [← nsmul_one]
    exact hchar W
  obtain ⟨φ, hφ⟩ : ∃ φ : SheafOfModules.unit (wcEtZModRing S (ℓ ^ k)) ⟶ Kc.homology n,
      φ = Kc.liftCycles κ (n + 1) (by simp) hκ ≫ Kc.homologyπ n := ⟨_, rfl⟩
  rw [← hφ]

