        fun h => h1 (s4 (V j) _ _ (hB0 j i) _ hw'V h)
      rw [s3] at h3
      rw [← hgpt]
      exact not_not.mp h3
    exact hw'S (hU _ h2)
  refine ⟨hi, ?_, ⟨b', hb'⟩⟩
  intro hspan
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hspan
  exact hxc' (ha ▸ Ideal.mul_mem_left _ a hπc')

theorem wc_qmbt_nlp_tube_map {A' : Type u} [CommRing A'] {L' : Type u} [CommRing L']
    {φ' : A' →+* L'} {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    (C : Type u) [CommRing C] (cC : Spec (.of C) ⟶ Xm)
    (TC : Scheme.{u}) (t₁ : TC ⟶ Spec (.of C)) (t₂ : TC ⟶ XE') (hT : IsPullback t₂ t₁ p' cC) :
    letI := (Spec.preimage (cC ≫ f)).hom.toAlgebra; letI := φ'.toAlgebra;
    ∃ Θ : Γ(TC, ⊤) →+* TensorProduct A' C L', ∀ s : Γ(Xm, ⊤),
      Θ ((t₂ ≫ p').appTop.hom s) =
        ((Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom s)) ⊗ₜ 1 :=
by
  letI := (Spec.preimage (cC ≫ f)).hom.toAlgebra
  letI := φ'.toAlgebra
  let gL : CommRingCat.of C ⟶ CommRingCat.of (TensorProduct A' C L') :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom)
  let gR : CommRingCat.of L' ⟶ CommRingCat.of (TensorProduct A' C L') :=
    CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : L' →ₐ[A'] TensorProduct A' C L').toRingHom
  have s1 : Spec.preimage (cC ≫ f) ≫ gL = CommRingCat.ofHom φ' ≫ gR := by
    ext a
    simp only [gL, gR, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
      Algebra.TensorProduct.includeLeftRingHom_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Algebra.TensorProduct.includeRight_apply]
    exact Algebra.TensorProduct.tmul_one_eq_one_tmul a
  have s2 : (Spec.map gL ≫ cC) ≫ f = Spec.map gR ≫ Spec.map (CommRingCat.ofHom φ') := by
    have e1 : Spec.map (Spec.preimage (cC ≫ f) ≫ gL) = Spec.map gL ≫ cC ≫ f := by
      rw [Spec.map_comp, Spec.map_preimage]
    rw [Category.assoc, ← e1, s1, Spec.map_comp]
  let u := hpb'.lift (Spec.map gL ≫ cC) (Spec.map gR) s2
  have hu : u ≫ p' = Spec.map gL ≫ cC := hpb'.lift_fst _ _ _
  let σ := hT.lift u (Spec.map gL) hu
  have hσ : σ ≫ t₂ = u := hT.lift_fst _ _ _
  refine ⟨(Scheme.ΓSpecIso (CommRingCat.of (TensorProduct A' C L'))).hom.hom.comp σ.appTop.hom,
    fun s => ?_⟩
  have hcomp : σ ≫ t₂ ≫ p' = Spec.map gL ≫ cC := by
    rw [← Category.assoc, hσ, hu]
  have key : (t₂ ≫ p').appTop ≫ σ.appTop ≫
      (Scheme.ΓSpecIso (CommRingCat.of (TensorProduct A' C L'))).hom
      = cC.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of C)).hom ≫ gL := by
    rw [← Category.assoc, ← Scheme.Hom.comp_appTop, hcomp, Scheme.Hom.comp_appTop,
      Category.assoc, Scheme.ΓSpecIso_naturality]
  have h2 := congrArg (fun φ => φ.hom s) key
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, gL, CommRingCat.hom_ofHom,
    Algebra.TensorProduct.includeLeftRingHom_apply] at h2
  simpa only [RingHom.comp_apply] using h2

theorem wc_qmbt_yrc_not_lth_power {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
