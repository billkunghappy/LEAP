  have S2 : ∀ {R C C' : Type u} [CommRing R] [CommRing C] [CommRing C']
      (r : X₁ ⟶ Spec (.of R)) (ε1 : Spec (.of C) ⟶ X₁) (ε2 : Spec (.of C') ⟶ X₁)
      [IsOpenImmersion ε2]
      (θ1 : R →+* C) (θ2 : R →+* C') (he : ε1 ≫ r = Spec.map (CommRingCat.ofHom θ1))
      (he' : ε2 ≫ r = Spec.map (CommRingCat.ofHom θ2))
      (b b' : R) (v : C) (v' : C') (hv : θ1 b' = θ1 b * v) (hv' : θ2 b = θ2 b' * v')
      (hnzd : θ1 b ∈ nonZeroDivisors C) (y : Spec (.of C)) (y' : Spec (.of C'))
      (hyy : ε1 y = ε2 y'), v ∉ y.asIdeal := by
    intro R C C' _ _ _ r ε1 ε2 _ θ1 θ2 he he' b b' v v' hv hv' hnzd y y' hyy
    have T : ∀ {D : Type u} [CommRing D] (ε : Spec (.of D) ⟶ X₁) (θ : R →+* D)
        (hε : ε ≫ r = Spec.map (CommRingCat.ofHom θ)) (w : Spec (.of D)) (t : R),
        (ε.stalkMap w).hom ((X₁.presheaf.germ ⊤ (ε w) (show ε w ∈ (⊤ : X₁.Opens) from trivial)).hom
          (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t))) =
        ((Spec (.of D)).presheaf.germ ⊤ w (show w ∈ (⊤ : (Spec (.of D)).Opens) from trivial)).hom
          ((Scheme.ΓSpecIso (.of D)).inv.hom (θ t)) := by
      intro D _ ε θ hε w t
      have hA : ε.appTop.hom (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t)) =
          (Scheme.ΓSpecIso (.of D)).inv.hom (θ t) := by
        have h1 : ε.appTop.hom (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t)) =
            (ε ≫ r).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom t) := by
          rw [Scheme.Hom.comp_appTop]; rfl
        rw [h1, hε]
        have h2 := congrArg (fun F => F.hom t)
          (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
        exact h2.symm
      rw [Scheme.Hom.germ_stalkMap_apply]
      exact congrArg (fun s => ((Spec (.of D)).presheaf.germ ⊤ w trivial).hom s) hA
    have Q : ∃ w' : X₁.presheaf.stalk (ε2 y'),
        (X₁.presheaf.germ ⊤ (ε2 y') trivial).hom (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom b)) =
        (X₁.presheaf.germ ⊤ (ε2 y') trivial).hom
          (r.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom b')) * w' := by
      obtain ⟨w', hw'⟩ := (ConcreteCategory.bijective_of_isIso (ε2.stalkMap y')).2
        (((Spec (.of C')).presheaf.germ ⊤ y' trivial).hom ((Scheme.ΓSpecIso (.of C')).inv.hom v'))
      refine ⟨w', ?_⟩
      apply (ConcreteCategory.bijective_of_isIso (ε2.stalkMap y')).1
      change (ε2.stalkMap y').hom _ = (ε2.stalkMap y').hom _
      rw [map_mul, T ε2 θ2 he' y' b, T ε2 θ2 he' y' b']
      erw [hw']
      rw [← map_mul, ← map_mul, hv']
    rw [← hyy] at Q
    obtain ⟨w', hw'⟩ := Q
    have hw2 := congrArg (ε1.stalkMap y).hom hw'
    rw [map_mul, T ε1 θ1 he y b, T ε1 θ1 he y b', hv, map_mul, map_mul] at hw2
    set γ := ((Spec (.of C)).presheaf.germ ⊤ y trivial).hom
      ((Scheme.ΓSpecIso (.of C)).inv.hom (θ1 b))
    set ν := ((Spec (.of C)).presheaf.germ ⊤ y trivial).hom ((Scheme.ΓSpecIso (.of C)).inv.hom v)
