         refine Eq.trans ?_ (E.left.presheaf.map_comp _ _); rfl)

  obtain ⟨Λ', hΛ'⟩ : ∃ Λ' : CommRingCat.of (Localization.Away (wcQmdlCX A' n π' c' l (some m))) ⟶
      Γ((wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m).toScheme, ⊤),
      ∀ x, Λ'.hom x = (wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m).topIso.inv.hom (Λ₀ x) :=
    ⟨CommRingCat.ofHom ((wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m).topIso.inv.hom.comp Λ₀),
      fun _ => rfl⟩
  have factor : ∀ (V : E.left.Opens) (e : wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m ≤ V)
      {B : Type u} [CommRing B] (χB : B →+* Γ(E.left, V)) (ψB : V.toScheme ⟶ Spec (.of B)),
      (∀ f : B, ψB.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom f) =
        V.topIso.inv.hom (χB f)) →
      ∀ β : B →+* Localization.Away (wcQmdlCX A' n π' c' l (some m)),
      (∀ b, Λ₀ (β b) = (E.left.presheaf.map (homOfLE e).op).hom (χB b)) →
      ((wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m).toScheme.toSpecΓ ≫ Spec.map Λ') ≫
        Spec.map (CommRingCat.ofHom β) = E.left.homOfLE e ≫ ψB := by
    intro V e B _ χB ψB hψ β hβ
    have hψC : (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ ψB.appTop =
        CommRingCat.ofHom χB ≫ V.topIso.inv :=
      CommRingCat.hom_ext (RingHom.ext fun f => hψ f)
    apply ext_of_isAffine
    rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of B)).inv]
    simp only [Scheme.Hom.comp_appTop, Category.assoc]
    rw [← reassoc_of% (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom β)),
      ← reassoc_of% (Scheme.ΓSpecIso_inv_naturality Λ'),
      Scheme.toSpecΓ_appTop, reassoc_of% hψC, topres]
    simp only [Iso.inv_hom_id, Category.comp_id]
    refine CommRingCat.hom_ext (RingHom.ext fun b => ?_)
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
    rw [hΛ', hβ b]
  refine ⟨(wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m).toScheme.toSpecΓ ≫ Spec.map Λ', ?_, ?_⟩
  · exact factor _ inf_le_left (χ l) (ψ l) hX5l _ (fun b => by rw [hΛ1 b, hrl])
  · exact factor _ inf_le_right (χ m) (ψ m) hX5m _ (fun b => by rw [hΛ2 b, hrm])

theorem wc_qmdl_glue_map {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A']
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ} (hn : 4 ≤ n)
    {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁)
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0)
    (K : Type u) [Field K] (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Over (Spec (.of K)))
    (jE : E.left ⟶ wcProjK K (n - 2 + 1)) (hjEY : jE ≫ wcProjKStr K (n - 2 + 1) = E.hom)
    (χ : ∀ j, wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j))
    (ψ : ∀ j, (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : ∀ j, wcQmdlChiPkg π' hn c' σ E jE j (χ j) (ψ j))
    (ρ : wcQuadModelRing A' n (π' ^ 2) c' →+* K)
    (hρX : ∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0)
    (hρA : ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      σ.toRingHom.comp (IsLocalRing.residue A')) :
    ∃ g : E.left ⟶ X₁, (∀ z : E.left, ∃ j, z ∈ wcQmdlV K hn jE j) ∧
      (∀ j, (wcQmdlV K hn jE j).ι ≫ g = ψ j ≫ e j) ∧
      (∀ j (z : E.left) (hz : z ∈ wcQmdlV K hn jE j),
        g z = e j (ψ j (⟨z, hz⟩ : wcQmdlV K hn jE j))) ∧
      g ≫ r₁ = E.hom ≫ Spec.map (CommRingCat.ofHom ρ) :=
by
  classical
  have hφX := hpkg.1
  have hφA := hpkg.2.1
  have hφe := hpkg.2.2.2.2.2.2.2.2.1

  have hcov : ∀ z : E.left, ∃ j, z ∈ wcQmdlV K hn jE j := by
    intro z
    have h0 := wc_pp_basicOpen_cover K (n - 2 + 1)
    have h1 : jE z ∈ (⊤ : (wcProjK K (n - 2 + 1)).Opens) := trivial
    rw [← h0] at h1
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp h1
    refine ⟨Fin.cast (by omega) a, ?_⟩
    have hidx : wcQmdlIdx hn (Fin.cast (by omega) a) = a := by
      ext; simp [wcQmdlIdx]
    show jE z ∈ wcSgD K (n - 2 + 1) (wcQmdlIdx hn (Fin.cast (by omega) a))
    rw [hidx]
    exact ha
  have hsuple : (⊤ : E.left.Opens) ≤ ⨆ j, wcQmdlV K hn jE j := by
    intro z _
    obtain ⟨j, hj⟩ := hcov z
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨j, hj⟩
  have hsup : (⨆ j, wcQmdlV K hn jE j) = ⊤ := top_le_iff.mp hsuple

  have hover : ∀ l m, E.left.homOfLE (inf_le_left : wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m ≤
        wcQmdlV K hn jE l) ≫ (ψ l ≫ e l) =
      E.left.homOfLE (inf_le_right : wcQmdlV K hn jE l ⊓ wcQmdlV K hn jE m ≤
        wcQmdlV K hn jE m) ≫ (ψ m ≫ e m) := by
    intro l m
    by_cases hlm : l = m
    · subst hlm; rfl
    · obtain ⟨τ, hτ1, hτ2, hτ3, hτA, hτS⟩ := wc_qmdl_chart_transition hr hpkg l m hlm
      obtain ⟨θ, hθ1, hθ2⟩ :=
        wc_qmdl_overlap_theta hn c' K σ E jE χ ψ hχ l m hlm τ hτ1 hτ2 hτ3 hτA
      rw [← Category.assoc, ← hθ1, Category.assoc, hτS, ← Category.assoc, hθ2, Category.assoc]

  obtain ⟨huniq, hglue⟩ := wc_csd_glue_opens E.left X₁ n (fun j => wcQmdlV K hn jE j)
  obtain ⟨Φ, hΦ⟩ := hglue (fun j => ψ j ≫ e j) hover
  obtain ⟨g, hg⟩ : ∃ g : E.left ⟶ X₁, g = E.left.topIso.inv ≫ (E.left.isoOfEq hsup).inv ≫ Φ :=
    ⟨_, rfl⟩
  have hι : ∀ j, (wcQmdlV K hn jE j).ι ≫ E.left.topIso.inv ≫ (E.left.isoOfEq hsup).inv =
      E.left.homOfLE (le_iSup (fun j => wcQmdlV K hn jE j) j) := by
    intro j
    rw [← cancel_mono (⨆ j, wcQmdlV K hn jE j).ι]
    simp only [Category.assoc, Scheme.isoOfEq_inv_ι, Scheme.homOfLE_ι]
    rw [← Scheme.topIso_hom E.left, Iso.inv_hom_id, Category.comp_id]
  have h2 : ∀ j, (wcQmdlV K hn jE j).ι ≫ g = ψ j ≫ e j := by
    intro j
    rw [hg]
    calc (wcQmdlV K hn jE j).ι ≫ E.left.topIso.inv ≫ (E.left.isoOfEq hsup).inv ≫ Φ
        = ((wcQmdlV K hn jE j).ι ≫ E.left.topIso.inv ≫ (E.left.isoOfEq hsup).inv) ≫ Φ := by
          simp only [Category.assoc]
      _ = ψ j ≫ e j := by rw [hι j]; exact hΦ j
  have h3 : ∀ j (z : E.left) (hz : z ∈ wcQmdlV K hn jE j),
      g z = e j (ψ j (⟨z, hz⟩ : wcQmdlV K hn jE j)) := by
    intro j z hz
    have hc := congrArg (fun f => f (⟨z, hz⟩ : wcQmdlV K hn jE j)) (h2 j)
    simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at hc
    exact hc

  have hsqc : ∀ j, ψ j ≫ Spec.map (CommRingCat.ofHom (φ j)) =
      (wcQmdlV K hn jE j).ι ≫ E.hom ≫ Spec.map (CommRingCat.ofHom ρ) := by
    intro j
    obtain ⟨hX1, hX2, hX3, hX4, hX5⟩ := hχ j
    have hψC : (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j))).inv ≫ (ψ j).appTop =
        CommRingCat.ofHom (χ j) ≫ (wcQmdlV K hn jE j).topIso.inv := by
      refine CommRingCat.hom_ext (RingHom.ext fun f => ?_)
      exact hX5 f
    have hιtop : (wcQmdlV K hn jE j).ι.appTop =
        E.left.presheaf.map (homOfLE (le_top : wcQmdlV K hn jE j ≤ ⊤)).op ≫
          (wcQmdlV K hn jE j).topIso.inv := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      first
        | (refine Eq.trans ?_ (E.left.presheaf.map_comp _ _); rfl)
        | exact E.left.presheaf.map_comp _ _
        | (erw [← Functor.map_comp]; rfl)
    have hring : (χ j).comp (φ j) = (wcCnSigma E.hom (wcQmdlV K hn jE j)).comp ρ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        have e1 : (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c')) (MvPolynomial.C a) =
            algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a := rfl
        simp only [RingHom.comp_apply, e1]
        rw [← RingHom.comp_apply (φ j), hφA j, hX4 a, ← RingHom.comp_apply ρ, hρA]
        rfl
      · intro p
        have hX2' : χ j (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (MvPolynomial.X (some j))) = 0 := hX2
        simp only [RingHom.comp_apply]
        rw [hφX j p, hρX p, map_zero, map_mul, map_mul, hX2', zero_mul]
    apply ext_of_isAffine
    rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv]
    simp only [Scheme.Hom.comp_appTop, Category.assoc]
    rw [← reassoc_of% (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (φ j))),
      ← reassoc_of% (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ρ)), hψC, hιtop]
    refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
    have hx := RingHom.congr_fun hring x
    simp only [RingHom.comp_apply] at hx
    show ((wcQmdlV K hn jE j).topIso.inv).hom (χ j (φ j x)) =
      ((wcQmdlV K hn jE j).topIso.inv).hom (wcCnSigma E.hom (wcQmdlV K hn jE j) (ρ x))
    rw [hx]

  have hsq : g ≫ r₁ = E.hom ≫ Spec.map (CommRingCat.ofHom ρ) := by
    have huniq' := (wc_csd_glue_opens E.left
      (Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))) n (fun j => wcQmdlV K hn jE j)).1
    have key := huniq' ⊤ (fun _ => le_top) hsuple (E.left.topIso.hom ≫ g ≫ r₁)
      (E.left.topIso.hom ≫ E.hom ≫ Spec.map (CommRingCat.ofHom ρ)) (by
        intro l
        have hl : E.left.homOfLE (le_top : wcQmdlV K hn jE l ≤ ⊤) ≫ E.left.topIso.hom =
            (wcQmdlV K hn jE l).ι := by
          rw [Scheme.topIso_hom, Scheme.homOfLE_ι]
        have hL : E.left.homOfLE (le_top : wcQmdlV K hn jE l ≤ ⊤) ≫ E.left.topIso.hom ≫ g ≫ r₁ =
            ψ l ≫ Spec.map (CommRingCat.ofHom (φ l)) := by
          rw [← Category.assoc, hl, ← Category.assoc, h2 l, Category.assoc, hφe l]
        have hR : E.left.homOfLE (le_top : wcQmdlV K hn jE l ≤ ⊤) ≫ E.left.topIso.hom ≫ E.hom ≫
            Spec.map (CommRingCat.ofHom ρ) =
            (wcQmdlV K hn jE l).ι ≫ E.hom ≫ Spec.map (CommRingCat.ofHom ρ) := by
          rw [← Category.assoc, hl]
        exact hL.trans ((hsqc l).trans hR.symm))
    exact (cancel_epi E.left.topIso.hom).mp key
  exact ⟨g, hcov, h2, h3, hsq⟩

theorem wc_qmdl_glue_closed_imm {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'} {n : ℕ}
    (hn : 4 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0)
    (K : Type u) [Field K] (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Over (Spec (.of K)))
    (jE : E.left ⟶ wcProjK K (n - 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (n - 2 + 1) = E.hom)
    (χ : ∀ j, wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j))
    (ψ : ∀ j, (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : ∀ j, wcQmdlChiPkg π' hn c' σ E jE j (χ j) (ψ j))
    (g : E.left ⟶ X₁) (hcov : ∀ z : E.left, ∃ j, z ∈ wcQmdlV K hn jE j)
    (hg : ∀ j, (wcQmdlV K hn jE j).ι ≫ g = ψ j ≫ e j) :
    IsClosedImmersion g :=
by
  classical
  unfold wcQmdlChartPkg at hpkg
  unfold wcQmdlChiPkg at hχ
  obtain ⟨P1, P2, P3, -, P5, P6, P7, P8, P9, P10, P11⟩ := hpkg
  haveI : IsClosedImmersion jE := hjE
  haveI : IsOpenImmersion e0 := P8
  haveI : ∀ j, IsOpenImmersion (e j) := P7

  have SGE : ∀ (m : ℕ) (J L : Fin (m + 1)), wcSgE K m J J = 1 ∧
      (wcProjK K m).basicOpen (wcSgE K m J L) = wcSgD K m J ⊓ wcSgD K m L := by
    intro n J L
    have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      intro σ A _ _ _ 𝒜 _ f g hf hg
      have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
          HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
        apply HomogeneousLocalization.val_injective
        simp [HomogeneousLocalization.Away.val_mk]
      have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
        have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
        rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
        rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
      have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
          (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
        have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
        have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
            (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
            (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
          congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
        rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
        congr 2
        rw [Proj.basicOpenIsoSpec_hom]
        change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
        rw [Proj.basicOpenToSpec_app_top]
        exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
          (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
          (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
      rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    refine ⟨?_, ?_⟩
    · have h1 : HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1
          (MvPolynomial.X J) (hX J) = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        exact ⟨1, by simp⟩
      show Proj.awayToSection _ _ _ = 1
      rw [h1, map_one]
    · exact (L1 _ (MvPolynomial.X J) (MvPolynomial.X L) (hX J) (hX L)).symm

  have DTC : ∀ (N : ℕ) (X : Over (Spec (.of K))) (ι : X.left ⟶ wcProjK K N)
      (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom) (a : Fin (N + 1)),
      letI := (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
      Algebra.adjoin K (Set.range fun p => (ι.app (wcSgD K N a)).hom (wcSgE K N a p)) = ⊤ := by
    intro N X ι hι hιX a
    classical
    haveI : IsClosedImmersion ι := hι
    letI := (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N a)).toAlgebra
    have PG : ∀ (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
        x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
          (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
      intro n J x
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
      have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
      have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
          (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
          MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
