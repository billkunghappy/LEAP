        (x.comp (Abelian.Ext.mk₀ qb) (add_zero n)).comp (Abelian.Ext.mk₀ sb) (add_zero n) := by
    intro n x
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_add,
      ← Abelian.Ext.mk₀_add, I1, Abelian.Ext.comp_mk₀_id]
  have hcrt : ∀ n : ℕ, Function.Bijective (fun x : wcEtZModExt Y (a * b) n =>
      (x.comp (Abelian.Ext.mk₀ qa) (add_zero n), x.comp (Abelian.Ext.mk₀ qb) (add_zero n))) := by
    intro n
    constructor
    · intro x y hxy
      simp only [Prod.mk.injEq] at hxy
      rw [hdecomp n x, hdecomp n y, hxy.1, hxy.2]
    · rintro ⟨y, z⟩
      refine ⟨y.comp (Abelian.Ext.mk₀ sa) (add_zero n) + z.comp (Abelian.Ext.mk₀ sb) (add_zero n),
        Prod.ext ?_ ?_⟩
      · show (y.comp (Abelian.Ext.mk₀ sa) (add_zero n) + z.comp (Abelian.Ext.mk₀ sb) (add_zero n)).comp
          (Abelian.Ext.mk₀ qa) (add_zero n) = y
        rw [Abelian.Ext.add_comp, Abelian.Ext.comp_assoc_of_third_deg_zero,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.mk₀_comp_mk₀, I2, I5, Abelian.Ext.comp_mk₀_id, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero, add_zero]
      · show (y.comp (Abelian.Ext.mk₀ sa) (add_zero n) + z.comp (Abelian.Ext.mk₀ sb) (add_zero n)).comp
          (Abelian.Ext.mk₀ qb) (add_zero n) = z
        rw [Abelian.Ext.add_comp, Abelian.Ext.comp_assoc_of_third_deg_zero,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.mk₀_comp_mk₀, I3, I4, Abelian.Ext.comp_mk₀_id, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero, zero_add]

  let Ta : ∀ p, wcEtZModExt Y a p →+
      Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (a * b)))
        (Ga.obj (SheafOfModules.unit (wcEtZModRing Y a))) p := fun p =>
    AddMonoidHom.mk' (fun z => (Abelian.Ext.mk₀ qa).comp (Abelian.Ext.mapExactFunctor Ga z) (zero_add p))
      (fun z z' => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  let Tb : ∀ p, wcEtZModExt Y b p →+
      Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (a * b)))
        (Gb.obj (SheafOfModules.unit (wcEtZModRing Y b))) p := fun p =>
    AddMonoidHom.mk' (fun z => (Abelian.Ext.mk₀ qb).comp (Abelian.Ext.mapExactFunctor Gb z) (zero_add p))
      (fun z z' => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  have hTadef : ∀ p z, Ta p z =
      (Abelian.Ext.mk₀ qa).comp (Abelian.Ext.mapExactFunctor Ga z) (zero_add p) := fun _ _ => rfl
  have hTbdef : ∀ p z, Tb p z =
      (Abelian.Ext.mk₀ qb).comp (Abelian.Ext.mapExactFunctor Gb z) (zero_add p) := fun _ _ => rfl
  have hTa' : ∀ p, Function.Bijective (Ta p) := hTa
  have hTb' : ∀ p, Function.Bijective (Tb p) := hTb
  let Pa : ∀ p, wcEtZModExt Y (a * b) p →+
      Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (a * b)))
        (Ga.obj (SheafOfModules.unit (wcEtZModRing Y a))) p := fun p =>
    AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ qa) (add_zero p))
      (fun x x' => Abelian.Ext.add_comp x x' _ _)
  let Pb : ∀ p, wcEtZModExt Y (a * b) p →+
      Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (a * b)))
        (Gb.obj (SheafOfModules.unit (wcEtZModRing Y b))) p := fun p =>
    AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ qb) (add_zero p))
      (fun x x' => Abelian.Ext.add_comp x x' _ _)
  let ρa : ∀ p, wcEtZModExt Y (a * b) p →+ wcEtZModExt Y a p := fun p =>
    (AddEquiv.ofBijective (Ta p) (hTa' p)).symm.toAddMonoidHom.comp (Pa p)
  let ρb : ∀ p, wcEtZModExt Y (a * b) p →+ wcEtZModExt Y b p := fun p =>
    (AddEquiv.ofBijective (Tb p) (hTb' p)).symm.toAddMonoidHom.comp (Pb p)
  have Ka : ∀ p (x : wcEtZModExt Y (a * b) p),
      Ta p (ρa p x) = x.comp (Abelian.Ext.mk₀ qa) (add_zero p) :=
    fun p x => AddEquiv.ofBijective_apply_symm_apply (Ta p) (hTa' p)
  have Kb : ∀ p (x : wcEtZModExt Y (a * b) p),
      Tb p (ρb p x) = x.comp (Abelian.Ext.mk₀ qb) (add_zero p) :=
    fun p x => AddEquiv.ofBijective_apply_symm_apply (Tb p) (hTb' p)
  have hcupM : ∀ (p q k : ℕ) (h : p + q = k) (x : wcEtZModExt Y (a * b) p)
      (y : wcEtZModExt Y (a * b) q), wcEtZModCup Y (a * b) p q k h x y = x.comp y h := by
    intros; rfl
  have hcupA : ∀ (p q k : ℕ) (h : p + q = k) (x : wcEtZModExt Y a p)
      (y : wcEtZModExt Y a q), wcEtZModCup Y a p q k h x y = x.comp y h := by
    intros; rfl
  have hcupB : ∀ (p q k : ℕ) (h : p + q = k) (x : wcEtZModExt Y b p)
      (y : wcEtZModExt Y b q), wcEtZModCup Y b p q k h x y = x.comp y h := by
    intros; rfl
  refine ⟨ρa, ρb, ?_, ?_, ?_⟩
  · intro p
    exact (Function.Bijective.prodMap (AddEquiv.ofBijective (Ta p) (hTa' p)).symm.bijective
      (AddEquiv.ofBijective (Tb p) (hTb' p)).symm.bijective).comp (hcrt p)
  · intro p q k h x y
    rw [hcupM, hcupA]
    apply (hTa' k).1
    rw [Ka, hTadef, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mapExactFunctor_comp,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ qa) _ _ (zero_add p) h
        (show 0 + p + q = k by omega), ← hTadef, Ka,
      Abelian.Ext.comp_assoc_of_second_deg_zero, ← hTadef, Ka]
  · intro p q k h x y
    rw [hcupM, hcupB]
    apply (hTb' k).1
    rw [Kb, hTbdef, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mapExactFunctor_comp,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ qb) _ _ (zero_add p) h
        (show 0 + p + q = k by omega), ← hTbdef, Kb,
      Abelian.Ext.comp_assoc_of_second_deg_zero, ← hTbdef, Kb]

theorem wc_et_zmod_poincare_trace_perfect : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (N : ℕ) [SmoothOfRelativeDimension N f] (m : ℕ), (m : K) ≠ 0 → ∃ tr : wcEtZModExt Y m (2 * N) →+ AddCircle (1 : ℚ), (∀ (p q : ℕ) (h : p + q = 2 * N) (α : wcEtZModExt Y m p), (∀ w : wcEtZModExt Y m q, tr (wcEtZModCup Y m p q (2 * N) h α w) = 0) → α = 0) ∧ (∀ (p q : ℕ) (h : p + q = 2 * N) (φ : wcEtZModExt Y m q →+ AddCircle (1 : ℚ)), ∃ α : wcEtZModExt Y m p, ∀ w : wcEtZModExt Y m q, tr (wcEtZModCup Y m p q (2 * N) h α w) = φ w) :=
by
  classical
  intro K _ _ Y₀ f₀ _ N _ m hm
  have hm0 : 0 < m := Nat.pos_of_ne_zero (fun h0 => hm (by rw [h0, Nat.cast_zero]))

  have s1 : ∀ (Y : Scheme.{u}) (n : ℕ), (∀ p, Subsingleton (wcEtZModExt Y n p)) →
      wcEtTracePerfect Y n N := by
    intro Y n hs
    refine ⟨0, ?_, ?_⟩
    · intro p q h α _
      exact @Subsingleton.elim _ (hs p) α 0
    · intro p q h φ
      refine ⟨0, fun w => ?_⟩
      rw [AddMonoidHom.zero_apply, @Subsingleton.elim _ (hs q) w 0, map_zero]

  have s2 : ∀ (Y : Scheme.{u}) (n : ℕ), 𝟙 (SheafOfModules.unit (wcEtZModRing Y n)) = 0 →
      ∀ p, Subsingleton (wcEtZModExt Y n p) := by
    intro Y n h0 p
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
    have hx : ∀ z : wcEtZModExt Y n p, z = 0 := by
      intro z
      have e := Abelian.Ext.comp_mk₀_id z
      rw [h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at e
      exact e.symm
    exact ⟨fun x y => (hx x).trans (hx y).symm⟩

  have s4 : ∀ (Y Y₁ Y₂ : Scheme.{u}) (n n₁ n₂ : ℕ)
      (ρ₁ : ∀ p, wcEtZModExt Y n p →+ wcEtZModExt Y₁ n₁ p)
      (ρ₂ : ∀ p, wcEtZModExt Y n p →+ wcEtZModExt Y₂ n₂ p),
      (∀ p, Function.Bijective (fun x : wcEtZModExt Y n p => (ρ₁ p x, ρ₂ p x))) →
      (∀ (p q : ℕ) (h : p + q = 2 * N) (x : wcEtZModExt Y n p) (y : wcEtZModExt Y n q),
        ρ₁ (2 * N) (wcEtZModCup Y n p q (2 * N) h x y) =
          wcEtZModCup Y₁ n₁ p q (2 * N) h (ρ₁ p x) (ρ₁ q y)) →
      (∀ (p q : ℕ) (h : p + q = 2 * N) (x : wcEtZModExt Y n p) (y : wcEtZModExt Y n q),
        ρ₂ (2 * N) (wcEtZModCup Y n p q (2 * N) h x y) =
          wcEtZModCup Y₂ n₂ p q (2 * N) h (ρ₂ p x) (ρ₂ q y)) →
      wcEtTracePerfect Y₁ n₁ N → wcEtTracePerfect Y₂ n₂ N → wcEtTracePerfect Y n N := by
    intro Y Y₁ Y₂ n n₁ n₂ ρ₁ ρ₂ hbij hm₁ hm₂ hT₁ hT₂
    obtain ⟨t₁, C1₁, C2₁⟩ := hT₁
    obtain ⟨t₂, C1₂, C2₂⟩ := hT₂
    let e : ∀ p, wcEtZModExt Y n p ≃+ (wcEtZModExt Y₁ n₁ p × wcEtZModExt Y₂ n₂ p) :=
      fun p => AddEquiv.ofBijective ((ρ₁ p).prod (ρ₂ p)) (hbij p)
    have he : ∀ p x, e p x = (ρ₁ p x, ρ₂ p x) := fun p x => rfl
    have hρ₁ : ∀ p a b, ρ₁ p ((e p).symm (a, b)) = a := by
      intro p a b
      have h1 := (e p).apply_symm_apply (a, b)
      rw [he] at h1
      exact congrArg Prod.fst h1
    have hρ₂ : ∀ p a b, ρ₂ p ((e p).symm (a, b)) = b := by
      intro p a b
      have h1 := (e p).apply_symm_apply (a, b)
      rw [he] at h1
      exact congrArg Prod.snd h1
    have hsplit : ∀ p w, w = (e p).symm (ρ₁ p w, 0) + (e p).symm (0, ρ₂ p w) := by
      intro p w
      apply (e p).injective
      rw [map_add, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, he]
      simp
    refine ⟨t₁.comp (ρ₁ (2 * N)) + t₂.comp (ρ₂ (2 * N)), ?_, ?_⟩
    · intro p q h α hα
      have key : ∀ w, t₁ (wcEtZModCup Y₁ n₁ p q (2 * N) h (ρ₁ p α) (ρ₁ q w)) +
          t₂ (wcEtZModCup Y₂ n₂ p q (2 * N) h (ρ₂ p α) (ρ₂ q w)) = 0 := by
        intro w
        have h1 := hα w
        rwa [AddMonoidHom.add_apply, AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, hm₁,
          hm₂] at h1
      have a1 : ρ₁ p α = 0 := C1₁ p q h _ (fun w₁ => by
        have h1 := key ((e q).symm (w₁, 0))
        simpa only [hρ₁, hρ₂, map_zero, add_zero] using h1)
      have a2 : ρ₂ p α = 0 := C1₂ p q h _ (fun w₂ => by
        have h1 := key ((e q).symm (0, w₂))
        simpa only [hρ₁, hρ₂, map_zero, zero_add] using h1)
      apply (e p).injective
      rw [map_zero, he, a1, a2]
      rfl
    · intro p q h φ
      obtain ⟨α₁, hα₁⟩ := C2₁ p q h
        (φ.comp ((e q).symm.toAddMonoidHom.comp (AddMonoidHom.inl _ _)))
      obtain ⟨α₂, hα₂⟩ := C2₂ p q h
        (φ.comp ((e q).symm.toAddMonoidHom.comp (AddMonoidHom.inr _ _)))
      refine ⟨(e p).symm (α₁, α₂), fun w => ?_⟩
      rw [AddMonoidHom.add_apply, AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, hm₁, hm₂,
        hρ₁, hρ₂, hα₁, hα₂]
      conv_rhs => rw [hsplit q w]
      rw [map_add]
      rfl

  have pull_cup : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n)
      (p q k : ℕ) (h : p + q = k) (x : wcEtZModExt S n p) (y : wcEtZModExt S n q),
      wcEtPull D k (wcEtZModCup S n p q k h x y) =
        wcEtZModCup S' n p q k h (wcEtPull D p x) (wcEtPull D q y) := by
    intro S S' g n D p q k h x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y h)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero p)) (zero_add p)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    rw [Abelian.Ext.mapExactFunctor_comp D.Φ x y h,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv) _ _ (zero_add p) h (by omega),
      Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ D.μ.hom) _ (add_zero p) (zero_add q) (by omega),
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv) _
        (zero_add 0) (zero_add q) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
      Abelian.Ext.comp_assoc_of_third_deg_zero]

  have stage1 : ∀ (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f]
      [SmoothOfRelativeDimension N f] [IrreducibleSpace Y] (n : ℕ), (n : K) ≠ 0 →
      wcEtTracePerfect Y n N := by
    intro Y f _ _ _ n
    induction n using Nat.recOnPosPrimePosCoprime with
    | prime_pow p k hp hk =>
      intro hpk
      haveI : Fact (Nat.Prime p) := ⟨hp⟩
      have hpK : (p : K) ≠ 0 := by
        intro h0
        apply hpk
        rw [Nat.cast_pow, h0, zero_pow hk.ne']
      exact wc_et_zmod_trace_perfect_irred_primepow K Y f N p hpK k hk
    | zero =>
      intro h
      exact (h Nat.cast_zero).elim
    | one =>
      intro _
      apply s1
      apply s2
      have h := (wc_et_zmod_unit_pow_exact Y 1 1 Nat.one_pos).1
      first
        | (rw [pow_one] at h; rwa [one_nsmul] at h)
        | simpa using h
        | (simp only [pow_one, one_smul] at h; exact h)
    | coprime a b ha hb hab iha ihb =>
      intro hab0
      rw [Nat.cast_mul] at hab0
      have haK : (a : K) ≠ 0 := left_ne_zero_of_mul hab0
      have hbK : (b : K) ≠ 0 := right_ne_zero_of_mul hab0
      obtain ⟨ρa, ρb, hbij, hma, hmb⟩ := wc_et_zmod_crt_split Y a b (by omega) (by omega) hab
      exact s4 Y Y Y (a * b) a b ρa ρb hbij (fun p q h x y => hma p q (2 * N) h x y)
        (fun p q h x y => hmb p q (2 * N) h x y) (iha haK) (ihb hbK)

  have stage2 : ∀ (k : ℕ) (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f]
      [SmoothOfRelativeDimension N f], (irreducibleComponents Y).ncard = k →
      wcEtTracePerfect Y m N := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
    intro Y f _ _ hk
    rcases isEmpty_or_nonempty Y with hY | hY
    · apply s1
      apply s2
      exact (wc_et_zmod_modules_zero_of_isEmpty Y m hY _).eq_of_src _ _
    · by_cases hirr : IrreducibleSpace Y
      · haveI := hirr
        exact stage1 Y f m hm
      · obtain ⟨U, V, hUV, hUVtop, hUp, hUs, hVp, hVs, hUc, hVc⟩ :=
          wc_proper_smooth_clopen_split K Y f N hY hirr
        haveI := hUp
        haveI := hUs
        haveI := hVp
        haveI := hVs
        have hTU : wcEtTracePerfect (U : Scheme.{u}) m N :=
          ih _ (lt_of_lt_of_eq hUc hk) (U : Scheme.{u}) (U.ι ≫ f) rfl
        have hTV : wcEtTracePerfect (V : Scheme.{u}) m N :=
          ih _ (lt_of_lt_of_eq hVc hk) (V : Scheme.{u}) (V.ι ≫ f) rfl
        obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists U.ι m
        obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists V.ι m
        exact s4 Y (U : Scheme.{u}) (V : Scheme.{u}) m m m (fun p => wcEtPull DU p)
          (fun p => wcEtPull DV p)
          (fun p => wc_et_zmodext_clopen_split Y U V hUV hUVtop m hm0 DU DV p)
          (fun p q h x y => pull_cup DU p q (2 * N) h x y)
          (fun p q h x y => pull_cup DV p q (2 * N) h x y) hTU hTV
  exact stage2 _ Y₀ f₀ rfl

theorem wc_et_proj_space_odd_vanish : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (e j : ℕ), Odd j → Subsingleton (wcEtCoh (wcProjK K e) ℓ j) :=
by
  classical
  intro K _ _ ℓ _ hℓ
  have hℓp : ℓ.Prime := Fact.out

  have hyp : ∀ e : ℕ, ∃ ι : wcProjK K e ⟶ wcProjK K (e + 1), IsClosedImmersion ι ∧
      ι ≫ wcProjKStr K (e + 1) = wcProjKStr K e ∧
      Set.range ι = ((wcSgD K (e + 1) (Fin.last (e + 1)) : (wcProjK K (e + 1)).Opens) :
        Set (wcProjK K (e + 1)))ᶜ := by
    intro e
    have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
        [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
        (f : 𝒜 →+*ᵍ ℬ)
        (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
        {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
        (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
        IsClosedImmersion (Proj.map f hf) := by
      intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
      refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
        (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
      intro i
      have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
      let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
      let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
      let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
      have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
      have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
        simp only [iV, iU, Proj.opensRange_awayι]
        exact Proj.map_preimage_basicOpen f hf (s i)
      have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
      have hg : IsClosedImmersion g :=
        IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
      have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
        (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
          (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
            (by
              dsimp only [Arrow.mk_hom, Iso.refl_hom]
              rw [Category.comp_id]
              exact IsPullback.isoPullback_hom_snd _))).mp hg
      have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
        (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
          (morphismRestrictOpensRange _ iV)).mpr h1
      exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2
    have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
        [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
        (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
        ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
      intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
      obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
      obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
      exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩
    have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) K),
        letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) K) := MvPolynomial.gradedAlgebra
        p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) K) ↔
          p.coeff 0 = 0 := by
      intro n p
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) K) := MvPolynomial.gradedAlgebra
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      erw [MvPolynomial.decomposition.decompose'_apply]
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
    letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) :=
      MvPolynomial.gradedAlgebra
    let g : Fin (e + 1 + 1) → MvPolynomial (Fin (e + 1)) K := fun t =>
      if h : t.val < e + 1 then MvPolynomial.X ⟨t.val, h⟩ else 0
    let c : Fin (e + 1) → Fin (e + 1 + 1) := fun j => ⟨j.val, by have := j.isLt; omega⟩
    have hg : ∀ t, (g t).IsHomogeneous 1 := by
      intro t
      dsimp only [g]
      split_ifs
      · exact MvPolynomial.isHomogeneous_X K _
      · exact MvPolynomial.isHomogeneous_zero _ _ 1
    have hgc : ∀ j, g (c j) = MvPolynomial.X j := by
      intro j
      have h : (c j).val < e + 1 := j.isLt
      dsimp only [g]
      rw [dif_pos h]
    have hX0 : ∀ t, g t = 0 ↔ ¬ (t.val < e + 1) := by
      intro t
      by_cases h : t.val < e + 1
      · have h' : g t = MvPolynomial.X ⟨t.val, h⟩ := by dsimp only [g]; rw [dif_pos h]
        rw [h']
        exact iff_of_false (MvPolynomial.X_ne_zero _) (not_not.mpr h)
      · have h' : g t = 0 := by dsimp only [g]; rw [dif_neg h]
        exact iff_of_true h' h
    have hsurjc : ∀ t, g t ≠ 0 → ∃ j, c j = t := by
      intro t ht
      have h : t.val < e + 1 := by
        by_contra h
        exact ht ((hX0 t).mpr h)
      exact ⟨⟨t.val, h⟩, Fin.ext rfl⟩
    have hT : ∀ t : Fin (e + 1 + 1), g t = 0 ↔ t = Fin.last (e + 1) := by
      intro t
      rw [hX0]
      have ht := t.isLt
      constructor
      · intro h
        apply Fin.ext
        rw [Fin.val_last]
        omega
      · rintro rfl
        rw [Fin.val_last]
        omega
    let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K)
        (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) :=
      ⟨(MvPolynomial.aeval g).toRingHom, fun {n x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        have := hx.aeval g hg
        rw [one_mul] at this
        exact this⟩
    let ψ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K)
        (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) :=
      ⟨(MvPolynomial.rename c).toRingHom, fun {n x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        exact hx.rename_isHomogeneous⟩
    have hφ : ∀ a, φ a = MvPolynomial.aeval g a := fun a => rfl
    have hψ : ∀ b, ψ b = MvPolynomial.rename c b := fun b => rfl
    have hφψ : ∀ b, φ (ψ b) = b := by
      intro b
      rw [hφ, hψ, MvPolynomial.aeval_rename]
      have hgc' : g ∘ c = MvPolynomial.X := funext hgc
      rw [hgc', MvPolynomial.aeval_X_left_apply]
    have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) ≤
        HomogeneousIdeal.map φ
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K)) := by
      intro b hb
      have hb0 : b.coeff 0 = 0 := (s1 (e + 1) b).mp hb
      have hψb : ψ b ∈
          HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) := by
        apply (s1 (e + 1 + 1) (ψ b)).mpr
        rw [hψ]
        rw [← MvPolynomial.constantCoeff_eq] at hb0 ⊢
        exact (MvPolynomial.constantCoeff_rename c b).trans hb0
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map, ← hφψ b]
