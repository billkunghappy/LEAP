  · intro x
    rw [hrangeA]
    simp only [TopologicalSpace.Opens.mem_inf, TopologicalSpace.Opens.mem_iSup, Scheme.Hom.mem_preimage,
      SetLike.mem_coe]
  · intro y
    refine (hopen y.asIdeal).symm.trans ?_
    simp only [SetLike.mem_coe, TopologicalSpace.Opens.mem_iSup]
    constructor
    · rintro ⟨i, hi, hn⟩
