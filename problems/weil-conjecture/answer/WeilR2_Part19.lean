  have hXl0 : χ l (wcQmdlCX A' n π' c' l none) = sl (Fin.last n) := (hχ l).1
  have hXm0 : χ m (wcQmdlCX A' n π' c' m none) = sm (Fin.last n) := (hχ m).1
  have hXl2 : χ l (wcQmdlCX A' n π' c' l (some l)) = 0 := (hχ l).2.1
  have hXm2 : χ m (wcQmdlCX A' n π' c' m (some m)) = 0 := (hχ m).2.1
  have hXl3 : ∀ p, p ≠ l → χ l (wcQmdlCX A' n π' c' l (some p)) = sl p.castSucc :=
