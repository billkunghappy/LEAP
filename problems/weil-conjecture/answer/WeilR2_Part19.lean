      (wcEtSuppObj D)).obj.obj (Opposite.op W)),
      (((SheafOfModules.toSheaf (wcEtZModRing Y m)).map (rU ≫ sU + rV ≫ sV)).hom.app
        (Opposite.op W)).hom s = s := by
