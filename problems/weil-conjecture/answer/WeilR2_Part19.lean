    (Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) r hrs (𝟙 _) ℓ (2 * e + 1)
  obtain ⟨I1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
    (r ≫ Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) (𝟙 _)) ℓ (2 * e + 1)
  obtain ⟨I2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
    (Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) (𝟙 _)) ℓ (2 * e + 1)
  have hcardFK : Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd f₀ (wcQmSp B₀))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
