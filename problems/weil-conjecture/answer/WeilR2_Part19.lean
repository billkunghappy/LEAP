      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) 0).app
        (SheafOfModules.unit (wcRingSheaf Xs' ℓ))).inv).mp ?_
  rw [Limits.zero_comp]
  refine (cancel_epi ((DerivedCategory.singleFunctorIsoCompQ
      (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) ((n : ℤ) - 1)).app
        (SheafOfModules.unit (wcRingSheaf Xs' ℓ))).hom).mp ?_
  rw [Limits.comp_zero]
  exact hw

theorem wc_dcat_ge0_two_degree_triangle {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞]
    [HasDerivedCategory 𝒞]
    (N : ℤ) (hN : 1 ≤ N) (O S₀ : 𝒞) (X : DerivedCategory 𝒞) (hX : X.IsGE 0)
    (h0 : Nonempty ((DerivedCategory.homologyFunctor 𝒞 0).obj X ≅ O))
    (hq : ∀ q : ℤ, 1 ≤ q → q ≠ N → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj X))
    (hS : Nonempty ((DerivedCategory.homologyFunctor 𝒞 N).obj X ≅ S₀)) :
    ∃ (E : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O) ⟶ X)
      (S : DerivedCategory 𝒞) (can : X ⟶ S)
      (δ : S ⟶ (DerivedCategory.Q.obj
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O))⟦(1 : ℤ)⟧)
      (_ : S ≅ DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) N).obj S₀)),
      Pretriangulated.Triangle.mk E can δ ∈ Pretriangulated.distinguishedTriangles :=
by

  have conc : ∀ (n : ℤ) (M : 𝒞) (K : DerivedCategory 𝒞),
      (∀ i : ℤ, i ≠ n → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 i).obj K)) →
      Nonempty ((DerivedCategory.homologyFunctor 𝒞 n).obj K ≅ M) →
      Nonempty (K ≅ DerivedCategory.Q.obj
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) n).obj M)) := by
    intro n M K hz hM
    have : K.IsGE n := (DerivedCategory.isGE_iff K n).mpr (fun i hi => hz i (by omega))
    have : K.IsLE n := (DerivedCategory.isLE_iff K n).mpr (fun i hi => hz i (by omega))
    obtain ⟨Z, ⟨e₁⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE K n
    obtain ⟨eM⟩ := hM
    let e₂ : Z ≅ M := ((DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒞 n).app Z).symm ≪≫
      (DerivedCategory.homologyFunctor 𝒞 n).mapIso e₁.symm ≪≫ eM
    exact ⟨e₁ ≪≫ (DerivedCategory.singleFunctor 𝒞 n).mapIso e₂ ≪≫
      (DerivedCategory.singleFunctorIsoCompQ 𝒞 n).app M⟩

  have iso1 : ∀ (T : Pretriangulated.Triangle (DerivedCategory 𝒞))
      (_ : T ∈ Pretriangulated.distinguishedTriangles) (n₀ n₁ : ℤ) (_ : n₀ + 1 = n₁),
      Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 n₀).obj T.obj₃) →
      Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 n₁).obj T.obj₃) →
      IsIso ((DerivedCategory.homologyFunctor 𝒞 n₁).map T.mor₁) := by
    intro T hT n₀ n₁ h h3₀ h3₁
    have : Mono ((DerivedCategory.homologyFunctor 𝒞 n₁).map T.mor₁) :=
      (DerivedCategory.HomologySequence.exact₁ T hT n₀ n₁ h).mono_g (h3₀.eq_of_src _ _)
    have : Epi ((DerivedCategory.homologyFunctor 𝒞 n₁).map T.mor₁) :=
      (DerivedCategory.HomologySequence.exact₂ T hT n₁).epi_f (h3₁.eq_of_tgt _ _)
    exact isIso_of_mono_of_epi _

  have iso2 : ∀ (T : Pretriangulated.Triangle (DerivedCategory 𝒞))
      (_ : T ∈ Pretriangulated.distinguishedTriangles) (n₀ n₁ : ℤ) (_ : n₀ + 1 = n₁),
      Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 n₀).obj T.obj₁) →
      Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 n₁).obj T.obj₁) →
      IsIso ((DerivedCategory.homologyFunctor 𝒞 n₀).map T.mor₂) := by
    intro T hT n₀ n₁ h h1₀ h1₁
    have : Mono ((DerivedCategory.homologyFunctor 𝒞 n₀).map T.mor₂) :=
      (DerivedCategory.HomologySequence.exact₂ T hT n₀).mono_g (h1₀.eq_of_src _ _)
    have : Epi ((DerivedCategory.homologyFunctor 𝒞 n₀).map T.mor₂) :=
      (DerivedCategory.HomologySequence.exact₃ T hT n₀ n₁ h).epi_f (h1₁.eq_of_tgt _ _)
    exact isIso_of_mono_of_epi _

  obtain ⟨X₁, Y, hX₁, hY, f, g, h, hT⟩ :=
    (DerivedCategory.TStructure.t : Triangulated.TStructure (DerivedCategory 𝒞)).exists_triangle
      X 0 1 (by norm_num)
  have : X₁.IsLE 0 := ⟨hX₁⟩
  have : Y.IsGE 1 := ⟨hY⟩
  have V1 := (DerivedCategory.isLE_iff X₁ 0).mp inferInstance
  have V2 := (DerivedCategory.isGE_iff Y 1).mp inferInstance
  have V3 := (DerivedCategory.isGE_iff X 0).mp hX
  have hz1 : ∀ i : ℤ, i ≤ 0 → IsIso ((DerivedCategory.homologyFunctor 𝒞 i).map f) :=
    fun i hi => iso1 _ hT (i - 1) i (by omega) (V2 _ (by omega)) (V2 _ (by omega))
  have hz2 : ∀ i : ℤ, 1 ≤ i → IsIso ((DerivedCategory.homologyFunctor 𝒞 i).map g) :=
    fun i hi => iso2 _ hT i (i + 1) rfl (V1 _ (by omega)) (V1 _ (by omega))

  obtain ⟨e₀⟩ := conc 0 O X₁ (fun i hi => by
      rcases lt_or_gt_of_ne hi with hi | hi
      · have := hz1 i hi.le
        exact (V3 i hi).of_iso (asIso ((DerivedCategory.homologyFunctor 𝒞 i).map f))
      · exact V1 i hi)
    (by
      obtain ⟨e⟩ := h0
      have := hz1 0 le_rfl
      exact ⟨asIso ((DerivedCategory.homologyFunctor 𝒞 0).map f) ≪≫ e⟩)

  obtain ⟨σ⟩ := conc N S₀ Y (fun i hi => by
      rcases lt_or_ge i 1 with h1 | h1
      · exact V2 i h1
      · have := hz2 i h1
        exact (hq i h1 hi).of_iso (asIso ((DerivedCategory.homologyFunctor 𝒞 i).map g)).symm)
    (by
      obtain ⟨e⟩ := hS
      have := hz2 N hN
      exact ⟨(asIso ((DerivedCategory.homologyFunctor 𝒞 N).map g)).symm ≪≫ e⟩)

  refine ⟨e₀.inv ≫ f, Y, g, h ≫ (shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).map e₀.hom, σ, ?_⟩
  refine Pretriangulated.isomorphic_distinguished _ hT _ ?_
  refine Pretriangulated.Triangle.isoMk _ _ e₀.symm (Iso.refl _) (Iso.refl _) ?_ ?_ ?_
  · simp
  · simp
  · simp [← Functor.map_comp]

theorem wc_rdfp_plus_H0_iso {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasDerivedCategory 𝒜]
    {𝒜' : Type*} [Category 𝒜'] [Abelian 𝒜'] [HasDerivedCategory 𝒜'] [EnoughInjectives 𝒜']
    (P : 𝒜' ⥤ 𝒜) [P.Additive] [Limits.PreservesFiniteLimits P] (X : CochainComplex 𝒜' ℤ)
    (hX : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj X))
    (hGE : (DerivedCategory.Q.obj X).IsGE 0) :
    Nonempty ((DerivedCategory.homologyFunctor 𝒜 0).obj
        ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hX⟩ : DerivedCategory.Plus 𝒜')) ≅
      P.obj ((DerivedCategory.homologyFunctor 𝒜' 0).obj (DerivedCategory.Q.obj X))) :=
by
  have : DerivedCategory.Plus.IsGE (⟨_, hX⟩ : DerivedCategory.Plus 𝒜') 0 :=
    (DerivedCategory.Plus.isGE_ι_obj_iff _ 0).mp hGE
  obtain ⟨L, hL, ⟨e⟩⟩ :=
    DerivedCategory.Plus.exists_injective_nonempty_iso (⟨_, hX⟩ : DerivedCategory.Plus 𝒜') 0
  set K := (InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L with hK
  have hJ : K.obj.IsStrictlyGE 0 :=
    (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff L.obj (InjectiveObject.ι 𝒜') 0).mpr hL

  have eQ : DerivedCategory.Q.obj K.obj ≅ DerivedCategory.Q.obj X :=
    ((DerivedCategory.Plus.QCompιIso 𝒜').app K).symm ≪≫ DerivedCategory.Plus.ι.mapIso e

  have E : DerivedCategory.Q.obj ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj K.obj) ≅
      (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hX⟩ : DerivedCategory.Plus 𝒜') :=
    ((DerivedCategory.Plus.QCompιIso 𝒜).app (P.mapCochainComplexPlus.obj K)).symm ≪≫
      DerivedCategory.Plus.ι.mapIso (asIso (P.rightDerivedFunctorPlusUnit.app K)) ≪≫
        DerivedCategory.Plus.ι.mapIso (P.rightDerivedFunctorPlus.mapIso e)

  set S := K.obj.sc 0 with hS
  have hf : S.f = 0 := by
    apply Limits.IsZero.eq_of_src
    exact CochainComplex.isZero_of_isStrictlyGE K.obj 0 _ (by simp)
  have : P.PreservesLeftHomologyOf S := Functor.preservesLeftHomology_of_zero_f P S hf
  have eH : ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj K.obj).homology 0 ≅
      P.obj (K.obj.homology 0) :=
    ShortComplex.mapHomologyIso S P
  exact ⟨(DerivedCategory.homologyFunctor 𝒜 0).mapIso E.symm ≪≫
    (DerivedCategory.homologyFunctorFactors 𝒜 0).app _ ≪≫ eH ≪≫
    P.mapIso ((DerivedCategory.homologyFunctorFactors 𝒜' 0).app K.obj).symm ≪≫
    P.mapIso ((DerivedCategory.homologyFunctor 𝒜' 0).mapIso eQ)⟩

theorem wc_dcat_map_homology_iso {𝒜 ℬ : Type*} [Category 𝒜] [Category ℬ] [Abelian 𝒜]
    [Abelian ℬ] [HasDerivedCategory 𝒜] [HasDerivedCategory ℬ] (G : 𝒜 ⥤ ℬ) [G.Additive]
    [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
    (X : DerivedCategory 𝒜) (q : ℤ) :
    Nonempty ((DerivedCategory.homologyFunctor ℬ q).obj (G.mapDerivedCategory.obj X) ≅
      G.obj ((DerivedCategory.homologyFunctor 𝒜 q).obj X)) :=
by
  haveI : G.PreservesHomology := G.preservesHomologyOfExact
  let K : CochainComplex 𝒜 ℤ := DerivedCategory.Q.objPreimage X
  let e : DerivedCategory.Q.obj K ≅ X := DerivedCategory.Q.objObjPreimageIso X
  let i4 : ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology q ≅
      G.obj (K.homology q) := (K.sc q).mapHomologyIso G
  exact ⟨(DerivedCategory.homologyFunctor ℬ q).mapIso (G.mapDerivedCategory.mapIso e.symm) ≪≫
    (DerivedCategory.homologyFunctor ℬ q).mapIso (G.mapDerivedCategoryFactors.app K) ≪≫
    (DerivedCategory.homologyFunctorFactors ℬ q).app _ ≪≫ i4 ≪≫
    G.mapIso ((DerivedCategory.homologyFunctorFactors 𝒜 q).app K).symm ≪≫
    G.mapIso ((DerivedCategory.homologyFunctor 𝒜 q).mapIso e)⟩

theorem wc_supp_unit_ne_zero_of_nonempty {Y Z : Scheme.{u}} (i : Z ⟶ Y) [Nonempty Z] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] (D : wcHMPullData i ℓ) : wcSuppUnitMap D ≠ 0 :=
by
  intro h
  haveI := D.additive
  have h1 : (D.adj.homEquiv _ _) D.μ.hom = 0 := by
    rw [Adjunction.homEquiv_unit]; exact h
  have h2 : D.μ.hom = 0 := by
    have e := (D.adj.homEquiv _ _).symm_apply_apply D.μ.hom
    rw [h1, Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp] at e
    exact e.symm
  have h3 : 𝟙 (SheafOfModules.unit (wcRingSheaf Z ℓ)) = 0 := by
    rw [← D.μ.inv_hom_id, h2, Limits.comp_zero]
  let V : Z.ProEt := Scheme.ProEt.mk (𝟙 Z)
  let x : (SheafOfModules.unit (wcRingSheaf Z ℓ)).val.obj (Opposite.op V) :=
    (1 : C(↥Z, ULift.{u+1} ℚ_[ℓ]))
  have h4 := congrArg (fun g : SheafOfModules.unit (wcRingSheaf Z ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf Z ℓ) => (g.val.app (Opposite.op V)).hom x) h3
  simp only [SheafOfModules.id_val, PresheafOfModules.id_app, ModuleCat.id_apply] at h4
  have h5 : (x : C(↥Z, ULift.{u+1} ℚ_[ℓ])) = 0 := h4
  obtain ⟨z⟩ := (inferInstance : Nonempty Z)
  have h6 := ContinuousMap.congr_fun h5 z
  simp only [x, ContinuousMap.one_apply, ContinuousMap.zero_apply] at h6
  exact one_ne_zero (ULift.up_injective h6 : (1 : ℚ_[ℓ]) = 0)

theorem wc_supp_obj_iso_of_range_eq {Y Z₁ Z₂ : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i₁ : Z₁ ⟶ Y) [IsClosedImmersion i₁] (i₂ : Z₂ ⟶ Y) [IsClosedImmersion i₂]
    (h : Set.range i₁ = Set.range i₂) (D₁ : wcHMPullData i₁ ℓ) (hD₁ : wcHMPullCanonical D₁)
    (D₂ : wcHMPullData i₂ ℓ) (hD₂ : wcHMPullCanonical D₂) :
    Nonempty (wcSuppObj D₁ ≅ wcSuppObj D₂) :=
by
  classical
  haveI : Epi (wcSuppUnitMap D₁) := wc_supp_unit_epi_of_closed i₁ ℓ D₁ hD₁
  haveI : Epi (wcSuppUnitMap D₂) := wc_supp_unit_epi_of_closed i₂ ℓ D₂ hD₂
  have vanish : ∀ {Z : Scheme.{u}} (i : Z ⟶ Y) (D : wcHMPullData i ℓ), wcHMPullCanonical D →
      ∀ (V : Y.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap D).val.app (Opposite.op V)).hom t = 0 →
      ∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0 := by
    intro Z i D hD V t h0 y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst V.hom i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
    have htw := wc_supp_hom_twist_formula D hD (wcSuppUnitMap D) V t
    rw [h0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
    have h2 := congrArg (fun φ : C(↥Z, ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.snd V.hom i).base.hom z)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply] at h1 h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        t ((Limits.pullback.fst V.hom i).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap D)) ((Limits.pullback.snd V.hom i).base.hom z) := h1
    show t ((Limits.pullback.fst V.hom i).base.hom z) = 0
    linear_combination (-(c' ((Limits.pullback.snd V.hom i).base.hom z))) * h1' -
      (t ((Limits.pullback.fst V.hom i).base.hom z)) * h2
  have kill : ∀ {Z : Scheme.{u}} (i : Z ⟶ Y) (D : wcHMPullData i ℓ), wcHMPullCanonical D →
      ∀ (V : Y.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0) →
      ((wcSuppUnitMap D).val.app (Opposite.op V)).hom t = 0 := by
    intro Z i D hD V t ht
    have htw := wc_supp_hom_twist_formula D hD (wcSuppUnitMap D) V t
    have hz0 : (t.comp (Limits.pullback.fst V.hom i).base.hom *
        (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom i).base.hom :
          C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) = 0 := by
      refine ContinuousMap.ext (fun z => ?_)
      have hz : V.hom ((Limits.pullback.fst V.hom i).base.hom z) ∈ Set.range i := by
        have : (Limits.pullback.fst V.hom i) z ∈ Set.range (Limits.pullback.fst V.hom i) :=
          ⟨z, rfl⟩
        rw [Scheme.Pullback.range_fst] at this
        exact this
      have h0 := ht _ hz
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, ContinuousMap.zero_apply]
      rw [h0, zero_mul]
    exact htw.trans hz0
  have k : ∀ {Za Zb : Scheme.{u}} (ia : Za ⟶ Y) (ib : Zb ⟶ Y) (Da : wcHMPullData ia ℓ)
      (Db : wcHMPullData ib ℓ), wcHMPullCanonical Da → wcHMPullCanonical Db →
      Set.range ia = Set.range ib →
      Limits.kernel.ι (wcSuppUnitMap Da) ≫ wcSuppUnitMap Db = 0 := by
    intro Za Zb ia ib Da Db hDa hDb hab
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction X using Opposite.rec with
    | op V =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom x)
      (Limits.kernel.condition (wcSuppUnitMap Da))
    change ((wcSuppUnitMap Da).val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Da)).val.app (Opposite.op V)).hom x) = 0 at hk
    change ((wcSuppUnitMap Db).val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Da)).val.app (Opposite.op V)).hom x) = 0
    apply kill ib Db hDb V
    intro y hy
    exact vanish ia Da hDa V _ hk y (hab ▸ hy)
  have k12 := k i₁ i₂ D₁ D₂ hD₁ hD₂ h
  have k21 := k i₂ i₁ D₂ D₁ hD₂ hD₁ h.symm
  refine ⟨{ hom := Abelian.epiDesc _ _ k12
            inv := Abelian.epiDesc _ _ k21
            hom_inv_id := ?_
            inv_hom_id := ?_ }⟩
  · apply (cancel_epi (wcSuppUnitMap D₁)).mp
    rw [← Category.assoc, Abelian.comp_epiDesc, Abelian.comp_epiDesc, Category.comp_id]
  · apply (cancel_epi (wcSuppUnitMap D₂)).mp
    rw [← Category.assoc, Abelian.comp_epiDesc, Abelian.comp_epiDesc, Category.comp_id]

theorem wc_proet_closed_supp_reconstruct {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    [IsLocallyNoetherian X] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : X.Opens)
    (hV : (V : Set X) = (Set.range i)ᶜ) (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (K : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (hK : Limits.IsZero (Dj.Φ.obj K)) :
    Nonempty ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
      (D.Φ.obj K) ≅ K) :=
by
  obtain ⟨M, ⟨ρ⟩⟩ := wc_proet_closed_push_essImage_of_open_pull_isZero i ℓ V hV D hD Dj hDj K hK
  obtain ⟨hFull, hFaith⟩ := wc_proet_closed_push_modules_full_faithful i ℓ D hD
  haveI := D.adj.counit_isIso_of_R_fully_faithful
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ
  exact ⟨P.mapIso (D.Φ.mapIso ρ.symm) ≪≫ P.mapIso (asIso (D.adj.counit.app M)) ≪≫ ρ⟩

theorem wc_qmbt_pnst_closed_pt {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A)) :
    ∃ z : Xs, ι ⁻¹' {IsLocalRing.closedPoint B₀} = {z} ∧ IsSepClosed (Xs.residueField z) :=
by
  classical
  obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
  set cp : ↥(Spec (.of B₀)) := IsLocalRing.closedPoint B₀ with hcp

  have ha : a₀ cp = x₀ := by
    have key : ∀ pt, (Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) ≫ a₀) pt =
        (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀) pt := fun pt => by rw [he]
    obtain ⟨pt⟩ : Nonempty ↥(Spec (.of (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀)))) :=
      ⟨IsLocalRing.closedPoint _⟩
    have h2 : (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀) pt = x₀ :=
      (Scheme.Hom.comp_apply _ _ pt).trans (Scheme.fromSpecResidueField_apply x₀ _)
    have h3 : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))
        ((Spec.map (CommRingCat.ofHom e)) pt) = cp :=
      (Spec.map_apply _ _).trans (IsLocalRing.PrimeSpectrum.comap_residue B₀ _)
    have h4 : (Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) ≫ a₀) pt = a₀ cp :=
      (Scheme.Hom.comp_apply _ _ pt).trans ((Scheme.Hom.comp_apply _ _ _).trans (congrArg a₀ h3))
    exact h4.symm.trans ((key pt).trans h2)

  have hstr : (wcQuadModelStr A n π c) x₀ = IsLocalRing.closedPoint A := by
    refine (Spec.map_apply _ x₀).trans (PrimeSpectrum.ext ?_)
    show Ideal.comap (algebraMap A (wcQuadModelRing A n π c)) (PrimeSpectrum.asIdeal x₀) =
      IsLocalRing.maximalIdeal A
    apply le_antisymm
    · haveI : (PrimeSpectrum.asIdeal x₀).IsPrime := PrimeSpectrum.isPrime x₀
      exact IsLocalRing.le_maximalIdeal
        (Ideal.IsPrime.comap (algebraMap A (wcQuadModelRing A n π c))).ne_top
    · rw [hπ, Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      have hQ : algebraMap A (wcQuadModelRing A n π c) π =
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) := by
        rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
        symm
        rw [Ideal.Quotient.eq]
        exact Ideal.subset_span rfl
      rw [hQ, map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hx₀ q)

  have hsp : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ (by exact IsLocalRing.residue_surjective)
  haveI hι : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip hsp

  have hA : ∀ y : ↥(Spec (.of (IsLocalRing.ResidueField A))),
      (wcQmSp A) y = IsLocalRing.closedPoint A := fun y =>
    (Spec.map_apply _ y).trans (IsLocalRing.PrimeSpectrum.comap_residue A y)
  obtain ⟨y₀⟩ : Nonempty ↥(Spec (.of (IsLocalRing.ResidueField A))) :=
    ⟨IsLocalRing.closedPoint _⟩
  have hxy : (a₀ ≫ wcQuadModelStr A n π c) cp = (wcQmSp A) y₀ :=
    (Scheme.Hom.comp_apply a₀ (wcQuadModelStr A n π c) cp).trans
      ((congrArg (wcQuadModelStr A n π c) ha).trans (hstr.trans (hA y₀).symm))
  obtain ⟨z, hz, -⟩ := Scheme.exists_preimage_of_isPullback hps _ _ hxy
  refine ⟨z, ?_, ?_⟩

  · ext w
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hw
      exact (IsClosedImmersion.isClosedEmbedding ι).isEmbedding.injective (hw.trans hz.symm)
    · rintro rfl
      exact hz

  ·
    have hd : Function.Surjective (ι.residueFieldMap z).hom := by
      have h1 : Function.Surjective
          ((ι.residueFieldMap z).hom ∘ ((Spec (.of B₀)).residue (ι z)).hom) := by
        rw [← RingHom.coe_comp, ← CommRingCat.hom_comp, Scheme.residue_residueFieldMap,
          CommRingCat.hom_comp, RingHom.coe_comp]
        exact (Scheme.residue_surjective Xs z).comp (ι.stalkMap_surjective z)
      exact h1.of_comp
    have ha' : Function.Surjective (stalkClosedPointIso (.of B₀)).inv.hom :=
      (ConcreteCategory.bijective_of_isIso (stalkClosedPointIso (.of B₀)).inv).2
    have hc' : Function.Surjective (Scheme.residueFieldCongr hz).inv.hom :=
      (ConcreteCategory.bijective_of_isIso (Scheme.residueFieldCongr hz).inv).2
    have hb' : Function.Surjective ((Spec (.of B₀)).residue cp).hom :=
      Scheme.residue_surjective _ _
    let ψ : B₀ →+* Xs.residueField z :=
      ((stalkClosedPointIso (.of B₀)).inv ≫ (Spec (.of B₀)).residue cp ≫
        (Scheme.residueFieldCongr hz).inv ≫ ι.residueFieldMap z).hom
    have hψ : Function.Surjective ψ := by
      simp only [ψ, CommRingCat.hom_comp, RingHom.coe_comp]
      exact hd.comp (hc'.comp (hb'.comp ha'))
    have hker := IsLocalRing.ker_eq_maximalIdeal ψ hψ
    let g : IsLocalRing.ResidueField B₀ →+* Xs.residueField z :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal B₀) ψ
        (fun a ha => by rw [← RingHom.mem_ker, hker]; exact ha)
    have hg : Function.Surjective g := Ideal.Quotient.lift_surjective_of_surjective _ _ hψ

    let eg : IsLocalRing.ResidueField B₀ ≃+* Xs.residueField z :=
      RingEquiv.ofBijective g ⟨g.injective, hg⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    let q := p.map eg.symm.toRingHom
    have hqsep : q.Separable := hsep.map
    have hqdeg : q.degree ≠ 0 := by
      rw [Polynomial.degree_map]
      exact (Polynomial.natDegree_pos_iff_degree_pos.mp hirr.natDegree_pos).ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root q hqdeg hqsep
    refine ⟨eg x, ?_⟩
    have hpq : q.map eg.toRingHom = p := by
      rw [Polynomial.map_map, RingEquiv.toRingHom_comp_symm_toRingHom, Polynomial.map_id]
    have h2 : Polynomial.eval (eg.toRingHom x) (q.map eg.toRingHom) = 0 := by
      rw [Polynomial.eval_map_apply, Polynomial.IsRoot.eq_zero hx, map_zero]
    rw [hpq] at h2
    exact h2

theorem wc_qmbt_pnst_xs_locNoeth {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A)) :
    IsLocallyNoetherian Xs :=
by
  classical
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hB₀ : IsNoetherianRing B₀ := by
    let ψ : wcQuadModelRing A n π c →+* B₀ := (Spec.preimage a₀).hom
    let P : Ideal (wcQuadModelRing A n π c) := Ideal.comap ψ (IsLocalRing.maximalIdeal B₀)
    haveI hPp : P.IsPrime := Ideal.comap_isPrime _ _
    haveI : IsNoetherianRing (wcQuadModelRing A n π c) := by
      unfold wcQuadModelRing
      infer_instance
    have hg : ∀ y : P.primeCompl, IsUnit (ψ y) := by
      intro y
      have hy : y.1 ∉ P := y.2
      by_contra h
      exact hy (Ideal.mem_comap.mpr ((IsLocalRing.mem_maximalIdeal _).mpr h))
    let θ : Localization.AtPrime P →+* B₀ :=
      IsLocalization.lift (M := P.primeCompl) (S := Localization.AtPrime P) hg
    have hθ : θ.comp (algebraMap _ (Localization.AtPrime P)) = ψ := IsLocalization.lift_comp hg
    have hloc : IsLocalHom θ := by
      refine ⟨fun x hx => ?_⟩
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl x
      have e : ψ a = ψ s * θ (IsLocalization.mk' (Localization.AtPrime P) a s) :=
        (IsLocalization.lift_mk'_spec (M := P.primeCompl) (S := Localization.AtPrime P)
          (g := ψ) hg a _ s).mp rfl
      have hua : IsUnit (ψ a) := e ▸ (hg s).mul hx
      have haP : a ∈ P.primeCompl := by
        intro ha
        exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mem_comap.mp ha) hua
      exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime P) P a s).mpr haP
    have e : Spec.map (CommRingCat.ofHom ψ) = a₀ := by
      simp only [ψ, CommRingCat.ofHom_hom, Spec.map_preimage]
    have hRB := wc_lpkt_specMap_weaklyEtale_ring _ B₀ ψ (e ▸ ha₀)
    have hRC : Algebra.WeaklyEtale _ (Localization.AtPrime P) :=
      wc_localization_weaklyEtale _ (Localization.AtPrime P) P.primeCompl
    letI : Algebra (wcQuadModelRing A n π c) B₀ := ψ.toAlgebra
    letI : Algebra (Localization.AtPrime P) B₀ := θ.toAlgebra
    have hT : @IsScalarTower (wcQuadModelRing A n π c)
        (Localization.AtPrime P) B₀ Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
      IsScalarTower.of_algebraMap_eq' hθ.symm
    have hCB : @Algebra.WeaklyEtale (Localization.AtPrime P) B₀ _ _ θ.toAlgebra :=
      @wc_weaklyEtale_cancel _ (Localization.AtPrime P) B₀ _ _ _ _ _ _ hT hRC hRB
    exact (wc_tla_shens_noeth_unram (Localization.AtPrime P) B₀ θ hloc hCB).1
  haveI hQm : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip hQm
  exact LocallyOfFiniteType.isLocallyNoetherian ι

theorem wc_pullback_point_unique_of_residue_bij : ∀ {X S T : Scheme.{u}} (f : X ⟶ S) (g : T ⟶ S) (x : X) (t : T), f x = g t → Function.Bijective (f.residueFieldMap x).hom → ∀ z₁ z₂ : ↥(Limits.pullback f g), Limits.pullback.fst f g z₁ = x → Limits.pullback.fst f g z₂ = x → Limits.pullback.snd f g z₁ = t → Limits.pullback.snd f g z₂ = t → z₁ = z₂ :=
by
  intro X S T f g x t _ hbij z₁ z₂ h₁ h₂ h₃ h₄
  have key : ∀ P : Scheme.Pullback.Triplet f g, Function.Bijective (f.residueFieldMap P.x).hom →
      Subsingleton ↥(Spec P.tensor) := by
    intro P hb
    have : IsIso (f.residueFieldMap P.x) := (ConcreteCategory.isIso_iff_bijective _).mpr hb
    have : IsIso P.tensorInr := by
      rw [Scheme.Pullback.Triplet.tensorInr]
      exact Limits.pushout_inr_iso_of_left_iso _ _
    have hinj : Function.Injective (Spec.map P.tensorInr).base :=
      (Spec.map P.tensorInr).homeomorph.injective
    exact hinj.subsingleton
  have e : Scheme.Pullback.Triplet.ofPoint z₁ = Scheme.Pullback.Triplet.ofPoint z₂ :=
    Scheme.Pullback.Triplet.ext
      (by rw [Scheme.Pullback.Triplet.ofPoint_x, Scheme.Pullback.Triplet.ofPoint_x, h₁, h₂])
      (by rw [Scheme.Pullback.Triplet.ofPoint_y, Scheme.Pullback.Triplet.ofPoint_y, h₃, h₄])
  have hx2 : (Scheme.Pullback.Triplet.ofPoint z₂).x = x :=
    (Scheme.Pullback.Triplet.ofPoint_x z₂).trans h₂
  have hb2 : Function.Bijective (f.residueFieldMap (Scheme.Pullback.Triplet.ofPoint z₂).x).hom := by
    rw [hx2]; exact hbij
  have hss := key _ hb2
  apply Scheme.Pullback.carrierEquiv.injective
  rw [Scheme.Pullback.carrierEquiv_eq_iff]
  exact ⟨e, @Subsingleton.elim _ hss _ _⟩

theorem wc_pullback_fibre_preconn_of_sepClosed_alg {X X' T : Scheme.{u}} (g : X' ⟶ X)
    (h : T ⟶ X) (t : T) (hsep : IsSepClosed (X.residueField (h t)))
    (halg : letI := (h.residueFieldMap t).hom.toAlgebra
      Algebra.IsAlgebraic (X.residueField (h t)) (T.residueField t))
    (hconn : _root_.IsPreconnected (g ⁻¹' {h t})) :
    _root_.IsPreconnected ((Limits.pullback.fst h g) ⁻¹' {t}) :=
by
  classical
  letI : Algebra (X.residueField (h t)) (T.residueField t) := (h.residueFieldMap t).hom.toAlgebra
  haveI : IsSepClosed (X.residueField (h t)) := hsep
  haveI : Algebra.IsAlgebraic (X.residueField (h t)) (T.residueField t) := halg
  haveI : IsPurelyInseparable (X.residueField (h t)) (T.residueField t) := inferInstance

  have hUI : UniversallyInjective (Spec.map (h.residueFieldMap t)) := by
    rw [UniversallyInjective.iff_diagonal]
    have e : Limits.pullback (Spec.map (h.residueFieldMap t)) (Spec.map (h.residueFieldMap t)) ≅
        Spec (.of (TensorProduct (X.residueField (h t)) (T.residueField t) (T.residueField t))) :=
      pullbackSpecIso (X.residueField (h t)) (T.residueField t) (T.residueField t)
    haveI : Subsingleton (PrimeSpectrum (T.residueField t)) := inferInstance
    haveI h1 : Subsingleton (PrimeSpectrum
        (TensorProduct (X.residueField (h t)) (T.residueField t) (T.residueField t))) :=
      (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable (X.residueField (h t))
        (T.residueField t) (T.residueField t)).injective.subsingleton
    haveI h2 : Subsingleton (Spec (.of (TensorProduct (X.residueField (h t)) (T.residueField t)
        (T.residueField t)))) := h1
    haveI h3 : Subsingleton ↥(Limits.pullback (Spec.map (h.residueFieldMap t))
        (Spec.map (h.residueFieldMap t)) : Scheme.{u}) :=
      (Scheme.homeoOfIso e).injective.subsingleton
    exact ⟨fun p => ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩

  haveI : IsIntegralHom (Spec.map (h.residueFieldMap t)) := by
    rw [IsIntegralHom.SpecMap_iff]
    exact algebraMap_isIntegral_iff.mpr Algebra.IsAlgebraic.isIntegral
  haveI hS : Surjective (Spec.map (h.residueFieldMap t)) := by
    haveI : Subsingleton (Spec (X.residueField (h t))) :=
      inferInstanceAs (Subsingleton (PrimeSpectrum (X.residueField (h t))))
    exact ⟨fun p => ⟨Nonempty.some inferInstance, Subsingleton.elim _ _⟩⟩

  have hκ : Spec.map (h.residueFieldMap t) ≫ X.fromSpecResidueField (h t) =
      T.fromSpecResidueField t ≫ h :=
    Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField h t
  set c := Limits.pullback.fst (Limits.pullback.fst h g) (T.fromSpecResidueField t) with hc
  set d := Limits.pullback.snd (Limits.pullback.fst h g) (T.fromSpecResidueField t) with hd
  have outer : IsPullback (c ≫ Limits.pullback.snd h g) d g (T.fromSpecResidueField t ≫ h) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback _ _) (IsPullback.of_hasPullback h g).flip
  rw [← hκ] at outer
  have w : (c ≫ Limits.pullback.snd h g) ≫ g =
      (d ≫ Spec.map (h.residueFieldMap t)) ≫ X.fromSpecResidueField (h t) := by
    rw [outer.w, Category.assoc]
  set q := Limits.pullback.lift _ _ w with hq
  have hq1 : q ≫ Limits.pullback.fst g (X.fromSpecResidueField (h t)) =
      c ≫ Limits.pullback.snd h g := Limits.pullback.lift_fst _ _ _
  have hq2 : q ≫ Limits.pullback.snd g (X.fromSpecResidueField (h t)) =
      d ≫ Spec.map (h.residueFieldMap t) := Limits.pullback.lift_snd _ _ _
  rw [← hq1] at outer
  have hpb : IsPullback q d (Limits.pullback.snd g (X.fromSpecResidueField (h t)))
      (Spec.map (h.residueFieldMap t)) :=
    IsPullback.of_right outer hq2 (IsPullback.of_hasPullback _ _)
  haveI : UniversallyInjective q :=
    MorphismProperty.of_isPullback (P := @UniversallyInjective) hpb.flip hUI
  haveI : UniversallyClosed q :=
    MorphismProperty.of_isPullback (P := @UniversallyClosed) hpb.flip inferInstance
  haveI : Surjective q :=
    MorphismProperty.of_isPullback (P := @Surjective) hpb.flip hS

  have hhom : IsHomeomorph q :=
    isHomeomorph_iff_continuous_isClosedMap_bijective.mpr
      ⟨q.continuous, q.isClosedMap, q.injective, q.surjective⟩
  let ψ := (hhom.homeomorph q).trans (Scheme.Hom.fiberHomeo g (h t))
  haveI : PreconnectedSpace ↥(g ⁻¹' {h t}) := isPreconnected_iff_preconnectedSpace.mp hconn
  have hrange : (Limits.pullback.fst h g) ⁻¹' {t} = Set.range (⇑c ∘ ⇑ψ.symm) := by
    rw [Set.range_comp, ψ.symm.surjective.range_eq, Set.image_univ, hc,
      Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
  rw [hrange]
  exact isPreconnected_range (c.continuous.comp ψ.symm.continuous)

theorem wc_weaklyEtale_residueField_isAlgebraic {T X : Scheme.{u}} (h : T ⟶ X) [WeaklyEtale h]
    (t : T) :
    letI := (h.residueFieldMap t).hom.toAlgebra
    Algebra.IsAlgebraic (X.residueField (h t)) (T.residueField t) :=
by
  classical

  have isoFlat : ∀ {A B : Scheme.{u}} (f : A ⟶ B), IsIso f → Flat f :=
    fun f _ => inferInstance
  have bcFlat : ∀ {A B C : Scheme.{u}} (f : A ⟶ C) (g : B ⟶ C), Flat f →
      Flat (Limits.pullback.snd f g) := fun _ _ _ => inferInstance
  have compFlat : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C), Flat f → Flat g →
      Flat (f ≫ g) := fun f g hf hg => @Flat.comp _ _ _ f g hf hg
  have cancelIso : ∀ {A B C : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ C), IsIso b → Flat (a ≫ b) →
      Flat a := by
    intro A B C a b hb hab
    have e3 : a = (a ≫ b) ≫ inv b := by simp
    rw [e3]
    exact compFlat _ _ hab (isoFlat _ inferInstance)
  have hΔh : Flat (Limits.pullback.diagonal h) := inferInstance
  have hd : Flat (Limits.pullback.diagonal (Spec.map (h.residueFieldMap t))) := by
    have hc := Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField h t
    have h1 : Flat (Limits.pullback.diagonal (T.fromSpecResidueField t ≫ h)) := by
      rw [Limits.pullback.diagonal_comp]
      refine compFlat _ _ (isoFlat _ inferInstance) (compFlat _ _ (isoFlat _ inferInstance) ?_)
      exact bcFlat _ _ hΔh
    rw [← hc, Limits.pullback.diagonal_comp] at h1
    refine cancelIso _ _ ?_ h1
    refine @IsIso.comp_isIso _ _ _ _ _ _ _ inferInstance ?_
    have hdx : IsIso (Limits.pullback.diagonal (X.fromSpecResidueField (h t))) := inferInstance
    exact Limits.pullback_snd_iso_of_left_iso _ _

  letI := (h.residueFieldMap t).hom.toAlgebra
  have hm : (Algebra.TensorProduct.lmul' (X.residueField (h t)) :
      TensorProduct (X.residueField (h t)) (T.residueField t) (T.residueField t) →ₐ[X.residueField (h t)]
        (T.residueField t)).toRingHom.Flat := by
    have hf' : Flat (Limits.pullback.diagonal
        (Spec.map (CommRingCat.ofHom (algebraMap (X.residueField (h t)) (T.residueField t))))) := hd
    rw [diagonal_SpecMap] at hf'
    have h2 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (X.residueField (h t)) :
          TensorProduct (X.residueField (h t)) (T.residueField t) (T.residueField t)
            →ₐ[X.residueField (h t)] (T.residueField t)).toRingHom)) := by
      have e2 : Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (X.residueField (h t)) :
            TensorProduct (X.residueField (h t)) (T.residueField t) (T.residueField t)
              →ₐ[X.residueField (h t)] (T.residueField t)).toRingHom) =
          (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' (X.residueField (h t)) :
              TensorProduct (X.residueField (h t)) (T.residueField t) (T.residueField t)
                →ₐ[X.residueField (h t)] (T.residueField t)).toRingHom) ≫
            (pullbackSpecIso (X.residueField (h t)) (T.residueField t) (T.residueField t)).inv) ≫
            (pullbackSpecIso (X.residueField (h t)) (T.residueField t) (T.residueField t)).hom := by
        simp
      rw [e2]
      exact compFlat _ _ hf' (isoFlat _ inferInstance)
    exact (HasRingHomProperty.Spec_iff (P := @Flat)).mp h2

  rw [Algebra.isAlgebraic_def]
  intro s
  by_contra hs

  have hsf : (Polynomial.aeval s : Polynomial (X.residueField (h t)) →ₐ[X.residueField (h t)]
      (T.residueField t)).toRingHom.Flat := by
    letI := (Polynomial.aeval s : Polynomial (X.residueField (h t)) →ₐ[X.residueField (h t)]
      (T.residueField t)).toRingHom.toAlgebra
    show Module.Flat (Polynomial (X.residueField (h t))) (T.residueField t)
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
    intro y hy
    rw [Submodule.mem_torsion_iff] at hy
    obtain ⟨a, ha⟩ := hy
    change (a : Polynomial (X.residueField (h t))) • y = 0 at ha
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra] at ha
    have ha0 : (a : Polynomial (X.residueField (h t))) ≠ 0 := nonZeroDivisors.coe_ne_zero a
    have hne : (Polynomial.aeval s : Polynomial (X.residueField (h t)) →ₐ[X.residueField (h t)]
        (T.residueField t)).toRingHom (a : Polynomial (X.residueField (h t))) ≠ 0 := by
      intro h0
      apply ha0
      apply transcendental_iff_injective.mp hs
      rw [map_zero]
      exact h0
    exact (Submodule.mem_bot _).mpr ((mul_eq_zero.mp ha).resolve_left hne)

  have hψ : (Algebra.TensorProduct.map (AlgHom.id (X.residueField (h t)) (T.residueField t))
      (Polynomial.aeval s : Polynomial (X.residueField (h t)) →ₐ[X.residueField (h t)]
        (T.residueField t))).toRingHom.Flat :=
    RingHom.Flat.tensorProductMap (RingHom.Flat.id _) hsf
  set ρ : TensorProduct (X.residueField (h t)) (T.residueField t)
      (Polynomial (X.residueField (h t))) →+* (T.residueField t) :=
    (Algebra.TensorProduct.lmul' (X.residueField (h t)) :
      TensorProduct (X.residueField (h t)) (T.residueField t) (T.residueField t)
        →ₐ[X.residueField (h t)] (T.residueField t)).toRingHom.comp
      (Algebra.TensorProduct.map (AlgHom.id (X.residueField (h t)) (T.residueField t))
        (Polynomial.aeval s : Polynomial (X.residueField (h t)) →ₐ[X.residueField (h t)]
          (T.residueField t))).toRingHom with hρ
  have hρf : ρ.Flat := RingHom.Flat.comp hψ hm
  have hND : NoZeroDivisors (TensorProduct (X.residueField (h t)) (T.residueField t)
      (Polynomial (X.residueField (h t)))) :=
    (polyEquivTensor (X.residueField (h t)) (T.residueField t)).symm.injective.noZeroDivisors _
      (map_zero _) (map_mul _)
  set e : TensorProduct (X.residueField (h t)) (T.residueField t)
      (Polynomial (X.residueField (h t))) :=
    polyEquivTensor (X.residueField (h t)) (T.residueField t)
      (Polynomial.X - Polynomial.C s) with he
  have he0 : e ≠ 0 := by
    intro h0
    apply Polynomial.X_sub_C_ne_zero s
    apply (polyEquivTensor (X.residueField (h t)) (T.residueField t)).injective
    rw [map_zero]
    exact h0
  have heND : e ∈ nonZeroDivisors _ := mem_nonZeroDivisors_of_ne_zero he0
  have hρe : ρ e = 0 := by
    rw [hρ, he, polyEquivTensor_apply]
    simp [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C,
      Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.map_tmul,
      Algebra.TensorProduct.lmul'_apply_tmul]
  letI := ρ.toAlgebra
  have hflat : Module.Flat (TensorProduct (X.residueField (h t)) (T.residueField t)
      (Polynomial (X.residueField (h t)))) (T.residueField t) := hρf
  have hreg : IsSMulRegular (T.residueField t) e :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors heND
  have h10 : (1 : T.residueField t) = 0 := hreg (by
    show e • (1 : T.residueField t) = e • (0 : T.residueField t)
    rw [Algebra.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra, hρe]
    simp)
  exact one_ne_zero h10

theorem wc_qmbt_pnst_beta_iso_off_pt {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (O : Xs.Opens) (hO : (O : Set Xs) = (ι ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ) :
    IsIso (βs ∣_ O) :=
by
  have hc4 : ∀ {A A' : Type u} [CommRing A] [IsLocalRing A] [CommRing A']
        [IsLocalRing A'] (ιA : A →+* A')
        (σ : IsLocalRing.ResidueField A ≃+* IsLocalRing.ResidueField A')
        (hσ : ∀ x : A, σ (IsLocalRing.residue A x) = IsLocalRing.residue A' (ιA x))
        {B Xm Xs Xs' : Scheme.{u}} (m : B ⟶ Spec (.of A))
        (bl : Xm ⟶ Limits.pullback m (Spec.map (CommRingCat.ofHom ιA)))
        {ι : Xs ⟶ B} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
        (hps : IsPullback ι s m (wcQmSp A))
        {f : Xm ⟶ Spec (.of A')}
        (hblf : bl ≫ Limits.pullback.snd m (Spec.map (CommRingCat.ofHom ιA)) = f)
        {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
        (hps' : IsPullback ι' s' f (wcQmSp A'))
        {βs : Xs' ⟶ Xs}
        (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)))
        (U₀ : B.Opens)
        (hW : IsIso (bl ∣_ (Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) ⁻¹ᵁ U₀)))
        (O : Xs.Opens) (hO : (O : Set Xs) = ι ⁻¹' (U₀ : Set B)),
    IsIso (βs ∣_ O) := by
    intro A A' _ _ _ _ ιA σ hσ B Xm Xs Xs' m bl ι s hps f hblf ι' s' hps' βs hβ U₀ hW O hO
    subst hblf
    haveI : IsClosedImmersion (wcQmSp A) :=
      IsClosedImmersion.spec_of_surjective _ (by exact IsLocalRing.residue_surjective)
    haveI : IsClosedImmersion (wcQmSp A') :=
      IsClosedImmersion.spec_of_surjective _ (by exact IsLocalRing.residue_surjective)
    haveI : IsClosedImmersion ι :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip inferInstance
    haveI : IsClosedImmersion ι' :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip inferInstance
    have R1 : CommRingCat.ofHom (IsLocalRing.residue A) ≫
        CommRingCat.ofHom (σ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A') =
        CommRingCat.ofHom ιA ≫ CommRingCat.ofHom (IsLocalRing.residue A') := by
      ext x
      first
        | exact hσ x
        | (simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
            RingEquiv.coe_toRingHom]; exact hσ x)
        | simp [hσ]
    have R2 : CommRingCat.ofHom (σ.symm : IsLocalRing.ResidueField A' →+* IsLocalRing.ResidueField A) ≫
        CommRingCat.ofHom (σ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A') = 𝟙 _ := by
      ext x
      first
        | exact σ.apply_symm_apply x
        | simp
    have R3 : CommRingCat.ofHom (σ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A') ≫
        CommRingCat.ofHom (σ.symm : IsLocalRing.ResidueField A' →+* IsLocalRing.ResidueField A) = 𝟙 _ := by
      ext x
      first
        | exact σ.symm_apply_apply x
        | simp
    obtain ⟨ρ, hρdef⟩ : ∃ ρ : Spec (.of (IsLocalRing.ResidueField A')) ⟶
        Spec (.of (IsLocalRing.ResidueField A)), ρ = Spec.map (CommRingCat.ofHom
          (σ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A')) := ⟨_, rfl⟩
    obtain ⟨τ, hτdef⟩ : ∃ τ : Spec (.of (IsLocalRing.ResidueField A)) ⟶
        Spec (.of (IsLocalRing.ResidueField A')), τ = Spec.map (CommRingCat.ofHom
          (σ.symm : IsLocalRing.ResidueField A' →+* IsLocalRing.ResidueField A)) := ⟨_, rfl⟩
    have hρ : ρ ≫ wcQmSp A = wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA) := by
      rw [hρdef]
      show Spec.map _ ≫ Spec.map _ = Spec.map _ ≫ Spec.map _
      rw [← Spec.map_comp, ← Spec.map_comp, R1]
    have hρτ : ρ ≫ τ = 𝟙 _ := by
      rw [hρdef, hτdef, ← Spec.map_comp, R2, Spec.map_id]
    have hτρ : τ ≫ ρ = 𝟙 _ := by
      rw [hρdef, hτdef, ← Spec.map_comp, R3, Spec.map_id]
    have hτ : τ ≫ wcQmSp A' ≫ Spec.map (CommRingCat.ofHom ιA) = wcQmSp A := by
      rw [← hρ, ← Category.assoc, hτρ, Category.id_comp]
    have hsβ : βs ≫ s = s' ≫ ρ := by
      rw [← cancel_mono (wcQmSp A)]
      calc (βs ≫ s) ≫ wcQmSp A = βs ≫ ι ≫ m := by rw [Category.assoc, hps.w]
        _ = ι' ≫ bl ≫ Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) ≫ m := by
            rw [← Category.assoc βs, hβ]; simp only [Category.assoc]
        _ = ι' ≫ bl ≫ Limits.pullback.snd m (Spec.map (CommRingCat.ofHom ιA)) ≫
              Spec.map (CommRingCat.ofHom ιA) := by rw [Limits.pullback.condition]
        _ = (s' ≫ ρ) ≫ wcQmSp A := by
            rw [Category.assoc, hρ, ← Category.assoc s', ← hps'.w]; simp only [Category.assoc]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Xs ⟶ Limits.pullback m (Spec.map (CommRingCat.ofHom ιA)),
        κ ≫ Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) = ι ∧
        κ ≫ Limits.pullback.snd m (Spec.map (CommRingCat.ofHom ιA)) = s ≫ τ ≫ wcQmSp A' :=
      ⟨Limits.pullback.lift ι (s ≫ τ ≫ wcQmSp A') (by
        rw [hps.w]; simp only [Category.assoc, hτ]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hsq : βs ≫ κ = ι' ≫ bl := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hκ1, hβ, Category.assoc]
      · rw [Category.assoc, hκ2, ← Category.assoc βs s, hsβ]
        simp only [Category.assoc]
        rw [← Category.assoc ρ τ, hρτ, Category.id_comp, ← hps'.w]
    have hPB : IsPullback βs ι' κ bl := by
      refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk hsq
        (fun c => hps'.lift c.snd (c.fst ≫ s ≫ τ) (by
          rw [← Category.assoc, ← c.condition, Category.assoc, hκ2]
          simp only [Category.assoc])) ?_ ?_ ?_)
      · intro c
        rw [← cancel_mono ι]
        simp only [Category.assoc]
        rw [hβ, ← Category.assoc, IsPullback.lift_fst, ← Category.assoc, ← c.condition,
          Category.assoc, hκ1]
      · intro c
        exact IsPullback.lift_fst _ _ _ _
      · intro c m' h1 h2
        rw [← cancel_mono ι', h2, IsPullback.lift_fst]
    have hWiso := wc_isIso_restrict_pullback_fst κ bl
      (Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) ⁻¹ᵁ U₀) hW
    have hOeq : κ ⁻¹ᵁ (Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) ⁻¹ᵁ U₀) = O := by
      have hpt : ∀ x : Xs, Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) (κ x) = ι x := by
        intro x
        have e1 : (κ ≫ Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA))) x = ι x := by
          rw [hκ1]
        simpa only [Scheme.Hom.comp_apply] using e1
      apply le_antisymm
      · intro x hx
        have h1 : Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) (κ x) ∈ U₀ := hx
        rw [hpt] at h1
        show x ∈ (O : Set Xs)
        rw [hO]
        exact h1
      · intro x hx
        have h1 : x ∈ (O : Set Xs) := hx
        rw [hO] at h1
        show Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) (κ x) ∈ U₀
        rw [hpt]
        exact h1
    subst hOeq
    rw [← hPB.isoPullback_hom_fst, morphismRestrict_comp]
    have i1 : IsIso (hPB.isoPullback.hom ∣_ (Limits.pullback.fst κ bl ⁻¹ᵁ κ ⁻¹ᵁ
        Limits.pullback.fst m (Spec.map (CommRingCat.ofHom ιA)) ⁻¹ᵁ U₀)) := inferInstance
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ i1 hWiso
  have hc6 : ∀ {A : Type u} [CommRing A] [IsDomain A]
        [IsDiscreteValuationRing A] {π : A} {n : ℕ} {c : Matrix (Fin n) (Fin n) A}
        (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
        {x₀ : Spec (.of (wcQuadModelRing A n π c))}
        (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
          PrimeSpectrum.asIdeal x₀)
        {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
        {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
        {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
          (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
        {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
        {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
        (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
        {A' : Type u} [CommRing A'] {ιA : A →+* A'} {π' : A'} {Xm : Scheme.{u}}
        {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
        (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
          (fun i : Option (Fin n) => Option.elim i
            ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
              (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
            (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
              (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
                (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
        (U₀ : (Spec (.of B₀)).Opens)
        (hU₀ : (U₀ : Set (Spec (.of B₀))) = {IsLocalRing.closedPoint B₀}ᶜ),
    IsIso (bl ∣_ (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ⁻¹ᵁ U₀)) := by
    intro A _ _ _ π n c hπ x₀ hx₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh A' _ ιA π' Xm bl hbl U₀ hU₀
    have hb0 := (wc_qmbt_hl_b0_origin_fibre hπ hx₀ hsh).2
    have hmax : ∀ q : PrimeSpectrum B₀, (∀ p : Fin n, (Spec.preimage a₀).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈ q.asIdeal) →
        q = IsLocalRing.closedPoint B₀ := by
      intro q hq
      apply hb0 q
      intro p
      have e := Spec.map_apply (Spec.preimage a₀) q
      rw [Spec.map_preimage] at e
      first
        | (rw [e, PrimeSpectrum.comap_asIdeal]; exact hq p)
        | (erw [e, PrimeSpectrum.comap_asIdeal]; exact hq p)
    apply wc_csd_blowup_iso_off_center _ _ _ bl _ hbl
    apply Set.subset_empty_iff.mp
    intro x hx
    refine wc_qmbt_ecc_support_avoid a₀ ιA π' hmax x ?_ hx.1
    have h2 : Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) x ∈
        (U₀ : Set (Spec (.of B₀))) := hx.2
    rw [hU₀] at h2
    exact h2

  obtain ⟨σ, hσ⟩ : ∃ σ : IsLocalRing.ResidueField A ≃+* IsLocalRing.ResidueField A',
      ∀ x : A, σ (IsLocalRing.residue A x) = IsLocalRing.residue A' (ιA x) := by
    have hπ'm : π' ∈ IsLocalRing.maximalIdeal A' := by
      rw [hπ']; exact Ideal.mem_span_singleton_self π'
    have hloc : IsLocalHom ιA := by
      constructor
      intro a ha
      by_contra hna
      have h1 : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
      rw [hπ, Ideal.mem_span_singleton'] at h1
      obtain ⟨b, rfl⟩ := h1
      have h2 : ιA (b * π) ∈ IsLocalRing.maximalIdeal A' := by
        rw [map_mul, ← hπ'2]
        exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hπ'm 2 (by norm_num))
      exact (IsLocalRing.mem_maximalIdeal _).mp h2 ha
    refine ⟨RingEquiv.ofBijective (IsLocalRing.ResidueField.map ιA) ⟨?_, ?_⟩, ?_⟩
    · exact (IsLocalRing.ResidueField.map ιA).injective
    · intro y
      obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨x, z, rfl⟩ := hgen a'
      refine ⟨IsLocalRing.residue A x, ?_⟩
      have h0 : IsLocalRing.residue A' π' = 0 := (IsLocalRing.residue_eq_zero_iff π').mpr hπ'm
      rw [IsLocalRing.ResidueField.map_residue, map_add, map_mul, h0, mul_zero, add_zero]
    · intro x
      exact IsLocalRing.ResidueField.map_residue ιA x
  obtain ⟨U₀, hU₀⟩ : ∃ U₀ : (Spec (.of B₀)).Opens,
      (U₀ : Set (Spec (.of B₀))) = {IsLocalRing.closedPoint B₀}ᶜ :=
    ⟨⟨_, (IsLocalRing.isClosed_singleton_closedPoint B₀).isOpen_compl⟩, rfl⟩
  have hW := hc6 hπ hx₀ hsh hbl U₀ hU₀
  have hO₀ : (O : Set Xs) = ι ⁻¹' (U₀ : Set (Spec (.of B₀))) := by
    rw [hO, hU₀, Set.preimage_compl]
  exact hc4 ιA σ hσ _ bl hps hblf hps' hβ U₀ hW O hO₀

theorem wc_qmbt_pnst_beta_unit_iso {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ) :
    IsIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC βs) _ _ Dβ.cont Dβ.φ) :=
by
  classical

  obtain ⟨z, hz, hsep⟩ := wc_qmbt_pnst_closed_pt hℓ hn hn4 hπ hc hx₀ hsh hps
  have hzι : ∀ y : Xs, ι y = IsLocalRing.closedPoint B₀ ↔ y = z := by
    intro y
    exact Set.ext_iff.mp hz y

  have hzcl : IsClosed ({z} : Set Xs) := by
    rw [← hz]
    exact (IsLocalRing.isClosed_singleton_closedPoint B₀).preimage ι.continuous
  let O : Xs.Opens := ⟨{z}ᶜ, hzcl.isOpen_compl⟩
  have hO : (O : Set Xs) = (ι ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ := by
    show ({z}ᶜ : Set Xs) = _
    rw [hz]
  haveI hβO : IsIso (βs ∣_ O) :=
    wc_qmbt_pnst_beta_iso_off_pt hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hbl hblf hps' hβ
      O hO

  have hOs : ∀ y : Xs, y ∈ (O : Set Xs) → ∃ x' : Xs', βs x' = y := by
    intro y hy
    obtain ⟨w, hw⟩ := (βs ∣_ O).surjective (⟨y, hy⟩ : O)
    exact ⟨w.1, (morphismRestrict_base_coe βs O w).symm.trans (congrArg Subtype.val hw)⟩
  have hOi : ∀ x₁ x₂ : Xs', βs x₁ = βs x₂ → βs x₁ ∈ (O : Set Xs) → x₁ = x₂ := by
    intro x₁ x₂ h12 h1
    have h2 : βs x₂ ∈ (O : Set Xs) := by rw [← h12]; exact h1
    let w₁ : ↥(βs ⁻¹ᵁ O) := ⟨x₁, h1⟩
    let w₂ : ↥(βs ⁻¹ᵁ O) := ⟨x₂, h2⟩
    have hw : (βs ∣_ O) w₁ = (βs ∣_ O) w₂ :=
      Subtype.ext ((morphismRestrict_base_coe βs O w₁).trans
        (h12.trans (morphismRestrict_base_coe βs O w₂).symm))
    have hw' : w₁ = w₂ := (βs ∣_ O).homeomorph.injective hw
    exact congrArg Subtype.val hw'
  have hOr : ∀ x' : Xs', βs x' ∈ (O : Set Xs) →
      Function.Bijective (βs.residueFieldMap x').hom := by
    intro x' hx'
    let w : (βs ⁻¹ᵁ O).toScheme := (⟨x', hx'⟩ : βs ⁻¹ᵁ O)
    haveI i1 : IsIso (Scheme.Hom.residueFieldMap (βs ∣_ O) w) := inferInstance
    haveI i2 : IsIso (Scheme.Hom.residueFieldMap O.ι ((βs ∣_ O) w)) := inferInstance
    have e1 : IsIso (Scheme.Hom.residueFieldMap ((βs ∣_ O) ≫ O.ι) w) := by
      rw [Scheme.residueFieldMap_comp]
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ (by exact i2) (by exact i1)
    have e2 : IsIso (Scheme.Hom.residueFieldMap ((βs ⁻¹ᵁ O).ι ≫ βs) w) := by
      rw [← morphismRestrict_ι]; exact e1
    rw [Scheme.residueFieldMap_comp] at e2
    haveI := e2
    haveI i3 : IsIso (Scheme.Hom.residueFieldMap (βs ⁻¹ᵁ O).ι w) := inferInstance
    haveI : IsIso (Scheme.Hom.residueFieldMap βs ((βs ⁻¹ᵁ O).ι w)) :=
      @IsIso.of_isIso_comp_right _ _ _ _ _ (Scheme.Hom.residueFieldMap βs ((βs ⁻¹ᵁ O).ι w))
        (Scheme.Hom.residueFieldMap (βs ⁻¹ᵁ O).ι w) i3 e2
    have hgen' : ∀ p : Xs', Function.Bijective (βs.residueFieldMap p).hom → p = x' →
        Function.Bijective (βs.residueFieldMap x').hom := by
      rintro p hp rfl; exact hp
    exact hgen' _ (ConcreteCategory.bijective_of_isIso _) (Scheme.Opens.ι_apply _ w)

  have hcov := wc_qmbt_hl_cov hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl hblf
  have hF := wc_qmbt_sfh_closed_fibre_connected hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen hbl
    hblf hcov hps'
  have hrange : Set.range (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) =
      ({IsLocalRing.closedPoint B₀} : Set ↥(Spec (.of B₀))) := by
    ext x
    constructor
    · rintro ⟨p, rfl⟩
      exact ((Spec.map_apply _ p).trans (IsLocalRing.PrimeSpectrum.comap_residue B₀ p))
    · intro hx
      have hx' : x = IsLocalRing.closedPoint B₀ := hx
      subst hx'
      obtain ⟨p⟩ : Nonempty ↥(Spec (.of (IsLocalRing.ResidueField B₀))) :=
        ⟨IsLocalRing.closedPoint _⟩
      exact ⟨p, (Spec.map_apply _ p).trans (IsLocalRing.PrimeSpectrum.comap_residue B₀ p)⟩
  have hZ : βs ⁻¹' {z} = Set.range (Limits.pullback.fst (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))) := by
    rw [Scheme.Pullback.range_fst, hrange]
    ext x'
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    rw [← hzι, ← Scheme.Hom.comp_apply, hβ]
    exact Iff.rfl
  have hZc : _root_.IsConnected (βs ⁻¹' {z}) := by
    rw [hZ]
    haveI := hF
    exact isConnected_range (Limits.pullback.fst (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))).base.hom.continuous

  haveI : Surjective βs := ⟨fun x => by
    by_cases hx : x = z
    · obtain ⟨x', hx'⟩ := hZc.nonempty
      exact ⟨x', (hx' : βs x' = z).trans hx.symm⟩
    · exact hOs x hx⟩

  have hsp' : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ (by exact IsLocalRing.residue_surjective)
  haveI : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip hsp'
  have hsp : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ (by exact IsLocalRing.residue_surjective)
  haveI : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip hsp
  haveI := wc_qmbt_nt_beta_proper hgen hbl
  haveI : UniversallyClosed (βs ≫ ι) := by rw [hβ]; infer_instance
  haveI : UniversallyClosed βs := UniversallyClosed.of_comp_of_isSeparated βs ι

  have htd : ∀ S : Set (ULift.{u+1} ℚ_[ℓ]), _root_.IsPreconnected S → S.Subsingleton := by
    intro S hS a ha b hb
    have h2 := (hS.image ULift.down continuous_uliftDown.continuousOn).subsingleton
    exact ULift.down_injective (h2 ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩)

  have hpre : ∀ V : Xs.ProEt, Function.Bijective
      (fun a : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) =>
        a.comp (Limits.pullback.fst V.hom βs).base.hom) := by
    intro V
    have hcl : IsClosedMap (Limits.pullback.fst V.hom βs) :=
      (Limits.pullback.fst V.hom βs).isClosedMap
    have hsu : Function.Surjective (Limits.pullback.fst V.hom βs) :=
      (Limits.pullback.fst V.hom βs).surjective
    have hfib : ∀ t : V.left,
        _root_.IsPreconnected ((Limits.pullback.fst V.hom βs) ⁻¹' {t}) := by
      intro t
      by_cases ht : V.hom t = z
      · have hc' : _root_.IsPreconnected (βs ⁻¹' {V.hom t}) := by
          rw [ht]; exact hZc.isPreconnected
        have hs' : IsSepClosed (Xs.residueField (V.hom t)) := by
          rw [ht]; exact hsep
        exact wc_pullback_fibre_preconn_of_sepClosed_alg βs V.hom t hs'
          (wc_weaklyEtale_residueField_isAlgebraic V.hom t) hc'
      · apply Set.Subsingleton.isPreconnected
        intro w₁ hw₁ w₂ hw₂
        have hw₁' : Limits.pullback.fst V.hom βs w₁ = t := hw₁
        have hw₂' : Limits.pullback.fst V.hom βs w₂ = t := hw₂
        have hO₁ : V.hom t ∈ (O : Set Xs) := ht
        have hc₁ : βs (Limits.pullback.snd V.hom βs w₁) = V.hom t := by
          rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply, hw₁']
        have hc₂ : βs (Limits.pullback.snd V.hom βs w₂) = V.hom t := by
          rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply, hw₂']
        have hx : Limits.pullback.snd V.hom βs w₁ = Limits.pullback.snd V.hom βs w₂ :=
          hOi _ _ (hc₁.trans hc₂.symm) (by rw [hc₁]; exact hO₁)
        have hσ₁ : ∀ w, Limits.pullback.fst βs V.hom ((Limits.pullbackSymmetry V.hom βs).hom w) =
            Limits.pullback.snd V.hom βs w := by
          intro w; rw [← Scheme.Hom.comp_apply, Limits.pullbackSymmetry_hom_comp_fst]
        have hσ₂ : ∀ w, Limits.pullback.snd βs V.hom ((Limits.pullbackSymmetry V.hom βs).hom w) =
            Limits.pullback.fst V.hom βs w := by
          intro w; rw [← Scheme.Hom.comp_apply, Limits.pullbackSymmetry_hom_comp_snd]
        have hbr : Function.Bijective
            (βs.residueFieldMap (Limits.pullback.snd V.hom βs w₁)).hom :=
          hOr _ (by rw [hc₁]; exact hO₁)
        have key := wc_pullback_point_unique_of_residue_bij βs V.hom
          (Limits.pullback.snd V.hom βs w₁) t hc₁ hbr
          ((Limits.pullbackSymmetry V.hom βs).hom w₁) ((Limits.pullbackSymmetry V.hom βs).hom w₂)
