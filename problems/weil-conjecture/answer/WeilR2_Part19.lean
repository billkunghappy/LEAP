        show φ a ∈ q ↔ _
        rw [← HomogeneousIdeal.mem_iff, hq, Ideal.mem_comap]
        have hd := hK (hret a)
        constructor
        · intro h
          have h4 := Ideal.add_mem _ hd h
          rwa [sub_add_cancel] at h4
        · intro h
          have h4 := Ideal.sub_mem _ h hd
          rwa [sub_sub_cancel] at h4
    refine ⟨L, hLci, hLstr, ?_⟩
    ext p
    rw [hrange, Set.mem_compl_iff, SetLike.mem_coe]
    constructor
    · intro H hmem
      have h1 := (Proj.mem_basicOpen _ _ _).mp hmem
      exact h1 (H _ ((hT _).mpr rfl))
    · intro H t ht
      rw [(hT t).mp ht]
      by_contra hn
      exact H ((Proj.mem_basicOpen _ _ _).mpr hn)

  intro e
  induction e with
  | zero =>
    intro j hj
    haveI : IsProper (wcProjKStr K 0) := wc_proj_space_isProper K 0
    exact wc_et_zero_dim_vanishing K (wcProjK K 0) (wcProjKStr K 0) (wc_proj_space_dim K 0).le
      ℓ hℓp.ne_zero j hj.pos
  | succ e ih =>
    intro j hj
    obtain ⟨ι, hιci, hιstr, hιrange⟩ := hyp e
    haveI := hιci
    have hO : ((wcSgD K (e + 1) (Fin.last (e + 1)) : (wcProjK K (e + 1)).Opens) :
        Set (wcProjK K (e + 1))) = (Set.range ι)ᶜ := by
      rw [hιrange, compl_compl]
    obtain ⟨D⟩ := wc_et_zmod_pull_data_exists ι ℓ
    obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists
      (wcSgD K (e + 1) (Fin.last (e + 1)) : (wcProjK K (e + 1)).Opens).ι ℓ
    have hles := wc_et_supp_open_les ι _ hO ℓ D Dj
    haveI : IsProper (wcProjKStr K (e + 1)) := wc_proj_space_isProper K (e + 1)
    haveI : CompactSpace (wcProjK K (e + 1)) :=
      QuasiCompact.compactSpace_of_compactSpace (wcProjKStr K (e + 1))
    haveI : SmoothOfRelativeDimension (e + 1) (wcProjKStr K (e + 1)) := wc_proj_space_smooth K (e + 1)
    haveI hsm : SmoothOfRelativeDimension e (ι ≫ wcProjKStr K (e + 1)) := by
      rw [hιstr]; exact wc_proj_space_smooth K e
    have hU : ∀ k, 1 ≤ k → Subsingleton (wcEtZModExt
        ((wcSgD K (e + 1) (Fin.last (e + 1)) : (wcProjK K (e + 1)).Opens) : Scheme.{u}) ℓ k) := by
      intro k hk
      obtain ⟨φU⟩ := (wc_proj_chart_partial_punct_iso K (e + 1) (Fin.last (e + 1))).1
      obtain ⟨E⟩ := wc_et_coh_iso_invariance φU.inv ℓ k
      haveI := wc_et_affine_space_coh_vanishing K ℓ hℓp hℓ (e + 1) k hk
      haveI : Subsingleton (wcEtCoh
          ((wcSgD K (e + 1) (Fin.last (e + 1)) : (wcProjK K (e + 1)).Opens) : Scheme.{u}) ℓ k) :=
        E.subsingleton
      obtain ⟨eU⟩ := wc_et_zmodext_coh_equiv
        ((wcSgD K (e + 1) (Fin.last (e + 1)) : (wcProjK K (e + 1)).Opens) : Scheme.{u}) ℓ k
      exact eU.subsingleton
    haveI hS : Subsingleton (wcEtSuppExt D j) := by
      obtain ⟨s, rfl⟩ := hj
      cases s with
      | zero =>
        haveI : SmoothOfRelativeDimension (e + 1 - 1) (ι ≫ wcProjKStr K (e + 1)) := by
          rw [Nat.add_sub_cancel]; exact hsm
        have h0 := wc_et_supp_semipurity K (wcProjK K (e + 1)) (wcProjK K e) (wcProjKStr K (e + 1))
          (e + 1) 1 ι (by omega) ℓ hℓ D (2 * 0 + 1) (by norm_num)
        exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
      | succ s =>
        have hj' : Odd (2 * s + 1) := ⟨s, rfl⟩
        haveI := ih (2 * s + 1) hj'
        obtain ⟨eZ⟩ := wc_et_zmodext_coh_equiv (wcProjK K e) ℓ (2 * s + 1)
        haveI : Subsingleton (wcEtZModExt (wcProjK K e) ℓ (2 * s + 1)) := eZ.subsingleton
        obtain ⟨Pu⟩ := wc_et_smooth_pair_purity_ext_equiv K (wcProjKStr K (e + 1)) (e + 1) e 1 rfl
          ι ℓ hℓ (wc_proj_space_irreducible K e).toNonempty D (2 * s + 1)
        have hidx : 2 * s + 1 + 2 * 1 = 2 * (s + 1) + 1 := by omega
        rw [hidx] at Pu
        exact Pu.symm.subsingleton
    haveI := hU j hj.pos
    haveI : Subsingleton (wcEtZModExt (wcProjK K (e + 1)) ℓ j) := by
      constructor
      intro y₁ y₂
      obtain ⟨x₁, hx₁⟩ := (hles.1 j y₁).mp (Subsingleton.elim _ _)
      obtain ⟨x₂, hx₂⟩ := (hles.1 j y₂).mp (Subsingleton.elim _ _)
      have h12 : x₁ = x₂ := Subsingleton.elim _ _
      subst h12
      exact hx₁.symm.trans hx₂
    obtain ⟨eP⟩ := wc_et_zmodext_coh_equiv (wcProjK K (e + 1)) ℓ j
    exact eP.symm.subsingleton

theorem wc_et_split_quadric_all_odd_vanish : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : Ω) ≠ 0 → ∀ (d : ℕ), Even d → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [IsProper fY] [SmoothOfRelativeDimension d fY] (jY : Y ⟶ wcProjK Ω (d + 1)), IsClosedImmersion jY → jY ≫ wcProjKStr Ω (d + 1) = fY → (∀ (x : Y) (c : Fin (d + 1 + 1)) (hx : x ∈ jY ⁻¹ᵁ wcSgD Ω (d + 1) c), wcLdpGerm Ω (d + 1) jY (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)) c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) → ∀ q : ℕ, Odd q → Subsingleton (wcEtCoh Y ℓ q) :=
by
  classical
  intro Ω _ _ ℓ _ hℓ d hd Y fY _ _ jY hjY hjYfY hEG
  have hℓp : ℓ.Prime := Fact.out
  obtain ⟨t, ht⟩ := hd

  by_cases hYe : IsEmpty Y
  · intro q hq
    have hdim : topologicalKrullDim Y ≤ ((0 : ℕ) : WithBot ℕ∞) := by
      have h0 : topologicalKrullDim Y = ⊥ := by
        unfold topologicalKrullDim
        rw [Order.krullDim_eq_bot_iff]
        constructor
        intro s
        obtain ⟨x, -⟩ := s.isIrreducible.nonempty
        exact hYe.false x
      rw [h0]; exact bot_le
    exact wc_et_zero_dim_vanishing Ω Y fY hdim ℓ hℓp.ne_zero q hq.pos
  rw [not_isEmpty_iff] at hYe
  by_cases hd0 : d = 0
  · intro q hq
