  · rw [Category.assoc, hc₀', Iso.inv_hom_id_assoc]
  · have hVaff : IsAffine Vt.left := hVt.1
    have hAH : IsAffineHom p' :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) hpb'.flip
        (isAffineHom_of_isAffine (Spec.map (CommRingCat.ofHom φ')))
    have hYaff : IsAffine ((wcProEtBC p').obj Vt).left :=
      @AlgebraicGeometry.instIsAffinePullbackSchemeOfIsAffineHom_1 _ _ _ Vt.hom p' hAH hVaff
    have hsq := (IsPullback.paste_horiz
      (IsPullback.of_hasPullback Vt.hom p').flip hpb'.flip).flip
    let eP := hsq.isoPullback

    have hcl'' : ∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
        ∃ w : Xs', w ∈ O ∧ Vt.hom x = ι' w := by
      intro x hx
      obtain ⟨pt, hpt⟩ := hclos x hx
      have h1 : (Limits.pullback.fst Vt.hom k ≫ Vt.hom) pt =
          (Limits.pullback.snd Vt.hom k ≫ k) pt := by rw [Limits.pullback.condition]
      refine ⟨O.ι (Limits.pullback.snd Vt.hom k pt), ?_, ?_⟩
      · have hmem : O.ι (Limits.pullback.snd Vt.hom k pt) ∈ Set.range O.ι := ⟨_, rfl⟩
        rw [Scheme.Opens.range_ι] at hmem
        exact hmem
      · rw [← hpt]
        exact h1

    have hst : ∀ z : Vt.left, IsClosed ({z} : Set Vt.left) →
        Subsingleton (wcEtCoh (Limits.pullback (Vt.left.fromSpecStalk z)
          (Limits.pullback.fst (Vt.hom ≫ f) (Spec.map (CommRingCat.ofHom φ')))) ℓ (j + 1)) := by
      intro z hz
      haveI : HenselianLocalRing (Vt.left.presheaf.stalk z) := (hVt.2.2.2.2 z hz).1
      haveI : IsLocalRing (Vt.left.presheaf.stalk z) := inferInstance
      haveI : IsSepClosed (IsLocalRing.ResidueField (Vt.left.presheaf.stalk z)) :=
        (hVt.2.2.2.2 z hz).2
      have hcz : (Vt.left.fromSpecStalk z ≫ Vt.hom)
          (IsLocalRing.closedPoint (Vt.left.presheaf.stalk z)) = Vt.hom z :=
        (Scheme.Hom.comp_apply _ _ _).trans
          (congrArg (fun p => Vt.hom p) (Scheme.fromSpecStalk_closedPoint (X := Vt.left) (x := z)))
      haveI := wc_fromSpecStalk_weaklyEtale Vt.left z
      haveI : WeaklyEtale Vt.hom := Vt.prop
      have hc : WeaklyEtale (Vt.left.fromSpecStalk z ≫ Vt.hom) := inferInstance
      obtain ⟨w, hwO, hxw⟩ := hcl'' z hz
      have h4m := @hloc (Vt.left.presheaf.stalk z) _ (hVt.2.2.2.2 z hz).1 (hVt.2.2.2.2 z hz).2
        (Vt.left.fromSpecStalk z ≫ Vt.hom) hc
        ((congrArg (fun p => f p) (hcz.trans hxw)).trans (hsp w)) w hwO (hcz.trans hxw)
        (j + 1) (by omega)
      obtain ⟨e4⟩ := wc_et_coh_iso_invariance
        ((Limits.pullbackRightPullbackFstIso (Vt.hom ≫ f) (Spec.map (CommRingCat.ofHom φ'))
          (Vt.left.fromSpecStalk z)) ≪≫
          Limits.pullback.congrHom (Category.assoc _ _ _).symm rfl).hom ℓ (j + 1)
      exact @Equiv.subsingleton _ _ e4.symm h4m
    have hT₀ := hdet f (Spec.map (CommRingCat.ofHom φ')) Vt hVt j hst
    have hYet : Subsingleton (wcEtCoh ((wcProEtBC p').obj Vt).left ℓ (j + 1)) := by
      obtain ⟨E⟩ := wc_et_coh_iso_invariance eP.hom ℓ (j + 1)
      first
        | exact @Equiv.subsingleton _ _ E.symm hT₀
        | (refine @Equiv.subsingleton _ _ E.symm ?_
           convert hT₀ using 3 <;> simp [Category.assoc])
    haveI := hYaff
    have h4 : ∀ n : ℕ, Subsingleton (wcEtCoh ((wcProEtBC p').obj Vt).left (ℓ ^ (n + 1)) (j + 1)) :=
      fun n => wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out (j + 1) hYet n
    have h3 := fun n : ℕ =>
      wc_proet_zmod_ext_vanish_of_et ((wcProEtBC p').obj Vt).left (ℓ ^ (n + 1)) j (h4 n)
    have h2 := wc_proet_int_ext_vanish_of_zmod_deg ((wcProEtBC p').obj Vt).left ℓ
      (Scheme.ProEt.mk (𝟙 _)) j h3
    have hv := wc_hm_vanish_of_int_ext_vanish ((wcProEtBC p').obj Vt).left ℓ j h2
    exact wc_proet_push_homology_section_local_death p' ℓ Dp' I' (j + 1) Vt
      (wc_proet_free_projective_wcontractible _ Vt hVt) hv _

theorem wc_qmbt_yrc_open_transport {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (M : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (V : X.Opens) (hV : Set.range i ⊆ (V : Set X))
    (m : M.val.obj (Opposite.op (Scheme.ProEt.mk V.ι)))
    (hm : ∀ (Vt : X.ProEt),
      (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
            HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i) →
      ∀ (h : Vt ⟶ Scheme.ProEt.mk V.ι),
      Function.Bijective (fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) =>
        r • (M.val.map h.op).hom m)) :
    Nonempty (Di.Φ.obj M ≅ SheafOfModules.unit (wcRingSheaf Z ℓ)) :=
by
  classical
  haveI := Di.cont
  let B : Z.ProEt := (wcProEtBC i).obj (Scheme.ProEt.mk V.ι)

  have huniq : ∀ {U : Z.ProEt} (f f' : U ⟶ B), f = f' := by
    intro U f f'
    apply MorphismProperty.Over.Hom.ext
    have e1 : f.left ≫ Limits.pullback.snd V.ι i = U.hom := MorphismProperty.Over.w f
    have e2 : f'.left ≫ Limits.pullback.snd V.ι i = U.hom := MorphismProperty.Over.w f'
    exact (cancel_mono (Limits.pullback.snd V.ι i)).mp (e1.trans e2.symm)

  let j : Z ⟶ V.toScheme := IsOpenImmersion.lift V.ι i (by
    first
      | (rw [Scheme.Opens.range_ι]; exact hV)
      | simpa using hV)
  have hj : j ≫ V.ι = i := IsOpenImmersion.lift_fac _ _ _
  let σ : Z ⟶ Limits.pullback V.ι i :=
    Limits.pullback.lift j (𝟙 Z) (by rw [hj, Category.id_comp])
  have hσ : σ ≫ Limits.pullback.snd V.ι i = 𝟙 Z := Limits.pullback.lift_snd _ _ _
  let c : ∀ U : Z.ProEt, U ⟶ B := fun U =>
    MorphismProperty.Over.homMk (A := U) (B := B) (U.hom ≫ σ)
      (by
        show (U.hom ≫ σ) ≫ Limits.pullback.snd V.ι i = U.hom
        rw [Category.assoc, hσ]; exact Category.comp_id _) trivial

  let n : (Di.Φ.obj M).val.obj (Opposite.op B) :=
    ((Di.adj.unit.app M).val.app (Opposite.op (Scheme.ProEt.mk V.ι))).hom m

  let s : ∀ W : Z.ProEtᵒᵖ, (Di.Φ.obj M).val.obj W := fun W =>
    ((Di.Φ.obj M).val.map (c W.unop).op).hom n
  have hs : ∀ ⦃W W' : Z.ProEtᵒᵖ⦄ (f : W ⟶ W'), ((Di.Φ.obj M).val.map f).hom (s W) = s W' := by
    intro W W' f
    have heq : (c W.unop).op ≫ f = (c W'.unop).op := by
      apply Quiver.Hom.unop_inj
      exact huniq _ _
    show ((Di.Φ.obj M).val.map f).hom (((Di.Φ.obj M).val.map (c W.unop).op).hom n) =
      ((Di.Φ.obj M).val.map (c W'.unop).op).hom n
    rw [← PresheafOfModules.map_comp_apply]
    exact congrArg (fun φ : Opposite.op B ⟶ W' =>
      (((Di.Φ.obj M).val.map φ).hom n : (Di.Φ.obj M).val.obj W')) heq
  let g : SheafOfModules.unit (wcRingSheaf Z ℓ) ⟶ Di.Φ.obj M :=
    (SheafOfModules.unitHomEquiv (Di.Φ.obj M)).symm (PresheafOfModules.sectionsMk s hs)
  have hg : ∀ (U : Z.ProEt) (r : (wcRingSheaf Z ℓ).obj.obj (Opposite.op U)),
      (g.val.app (Opposite.op U)).hom r = r • ((Di.Φ.obj M).val.map (c U).op).hom n := by
    intro U r
    have h1 := SheafOfModules.unitHomEquiv_apply_coe (Di.Φ.obj M)
      ((SheafOfModules.unitHomEquiv (Di.Φ.obj M)).symm (PresheafOfModules.sectionsMk s hs))
      (Opposite.op U)
    rw [Equiv.apply_symm_apply, PresheafOfModules.sectionsMk_coe] at h1
    have e1 : (g.val.app (Opposite.op U)).hom r =
        (g.val.app (Opposite.op U)).hom (r * (1 : (wcRingSheaf Z ℓ).obj.obj (Opposite.op U))) :=
      congrArg (fun x : (wcRingSheaf Z ℓ).obj.obj (Opposite.op U) =>
        (g.val.app (Opposite.op U)).hom x) (mul_one r).symm
    have e2 : (g.val.app (Opposite.op U)).hom (r * (1 : (wcRingSheaf Z ℓ).obj.obj (Opposite.op U))) =
        r • (g.val.app (Opposite.op U)).hom (1 : (wcRingSheaf Z ℓ).obj.obj (Opposite.op U)) :=
      LinearMap.map_smul (g.val.app (Opposite.op U)).hom r _
    have e3 : (g.val.app (Opposite.op U)).hom (1 : (wcRingSheaf Z ℓ).obj.obj (Opposite.op U)) =
        s (Opposite.op U) := h1.symm
    exact e1.trans (e2.trans (congrArg (fun y => r • y) e3))

  have hgb : ∀ (Vt : X.ProEt),
      (IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
          (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
            HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range i) →
      (∀ M' : SheafOfModules.{u+1} (wcRingSheaf X ℓ),
          Function.Bijective ((Di.adj.unit.app M').val.app (Opposite.op Vt)).hom) →
      Function.Bijective ((g.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom) := by
    intro Vt hW hcl hunit

    have hVx : ∀ x : Vt.left, Vt.hom x ∈ (V : Set X) := by
      intro x
      obtain ⟨y, ⟨hy, hxy⟩, -⟩ := hW.2.2.1 x
      exact (hxy.map (Scheme.Hom.continuous Vt.hom)).mem_open V.isOpen (hV (hcl y hy))
    let l : Vt.left ⟶ V.toScheme := IsOpenImmersion.lift V.ι Vt.hom (by
      first
        | (rw [Scheme.Opens.range_ι]; rintro _ ⟨x, rfl⟩; exact hVx x)
        | (rintro _ ⟨x, rfl⟩; simpa using hVx x))
    have hl : l ≫ V.ι = Vt.hom := IsOpenImmersion.lift_fac _ _ _
    let hh : Vt ⟶ Scheme.ProEt.mk V.ι :=
      MorphismProperty.Over.homMk (A := Vt) (B := Scheme.ProEt.mk V.ι) l hl trivial
    let x := (M.val.map hh.op).hom m
    have hx : Function.Bijective (fun r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) => r • x) :=
      hm Vt hW hcl hh
    let η' : M.val.obj (Opposite.op Vt) →
        (Di.Φ.obj M).val.obj (Opposite.op ((wcProEtBC i).obj Vt)) :=
      fun y => ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom y
    have hηb : Function.Bijective η' := hunit M
    have hc : c ((wcProEtBC i).obj Vt) = (wcProEtBC i).map hh := huniq _ _
    have hnat : η' x = ((Di.Φ.obj M).val.map (c ((wcProEtBC i).obj Vt)).op).hom n := by
      rw [hc]
      exact PresheafOfModules.naturality_apply (Di.adj.unit.app M).val hh.op m
    let φ' : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) →
        (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) :=
      fun r => (Di.φ.hom.app (Opposite.op Vt)).hom r
    have hF1 : ∀ r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt), η' (r • x) = φ' r • η' x :=
      fun r => LinearMap.map_smul ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom r x

    let u1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt) →
        (Di.Φ.obj (SheafOfModules.unit (wcRingSheaf X ℓ))).val.obj
          (Opposite.op ((wcProEtBC i).obj Vt)) :=
      fun r => ((Di.adj.unit.app (SheafOfModules.unit (wcRingSheaf X ℓ))).val.app
        (Opposite.op Vt)).hom r
    let u2 : (Di.Φ.obj (SheafOfModules.unit (wcRingSheaf X ℓ))).val.obj
          (Opposite.op ((wcProEtBC i).obj Vt)) →
        (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) :=
      fun z => (Di.μ.hom.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom z
    let e : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) := u2 (u1 1)
    have hε : ∀ r : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt), u2 (u1 r) = φ' r * e := by
      intro r
      have e1 : u1 r = u1 (r * (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt))) :=
        congrArg u1 (mul_one r).symm
      have e2 : u1 (r * (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt))) =
          φ' r • u1 (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt)) :=
        LinearMap.map_smul ((Di.adj.unit.app (SheafOfModules.unit (wcRingSheaf X ℓ))).val.app
          (Opposite.op Vt)).hom r _
      have e3 : u2 (φ' r • u1 (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt))) =
          φ' r • u2 (u1 (1 : (wcRingSheaf X ℓ).obj.obj (Opposite.op Vt))) :=
        LinearMap.map_smul (Di.μ.hom.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom (φ' r) _
      exact ((congrArg u2 (e1.trans e2)).trans e3).trans (smul_eq_mul _ _)
    have l2 : ∀ t : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)),
        u2 ((Di.μ.inv.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom t) = t := by
      intro t
      have h0 := congrArg (fun k => (k.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom t)
        Di.μ.inv_hom_id
      first
        | exact h0
        | (show (Di.μ.hom.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
              ((Di.μ.inv.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom t) = t
           simpa using h0)
    have hes : ∀ t : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)),
        ∃ r, φ' r * e = t := by
      intro t
      obtain ⟨r, hr⟩ := (hunit (SheafOfModules.unit (wcRingSheaf X ℓ))).2
        ((Di.μ.inv.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom t)
      refine ⟨r, ?_⟩
      rw [← hε r]
      exact (congrArg u2 hr).trans (l2 t)
    have hcomm : ∀ a b : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)),
        a * b = b * a := by
      intro a b
      first
        | exact @mul_comm C(↥((wcProEtBC i).obj Vt).left, ULift.{u+1} ℚ_[ℓ]) _ a b
        | (apply ContinuousMap.ext; intro p; exact mul_comm _ _)
    have hφs : ∀ t : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)),
        ∃ r, φ' r = t := by
      obtain ⟨r0, hr0⟩ := hes 1
      have heu : e * φ' r0 = 1 := by rw [hcomm]; exact hr0
      intro t
      obtain ⟨r, hr⟩ := hes (t * e)
      refine ⟨r, ?_⟩
      calc φ' r = φ' r * (e * φ' r0) := by rw [heu, mul_one]
        _ = (φ' r * e) * φ' r0 := by rw [mul_assoc]
        _ = (t * e) * φ' r0 := by rw [hr]
        _ = t := by rw [mul_assoc, heu, mul_one]
    have hψ : Function.Bijective
        (fun s : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) => s • η' x) := by
      constructor
      · intro s1 s2 hss
        obtain ⟨r, rfl⟩ := hφs s1
        obtain ⟨r', rfl⟩ := hφs s2
        have h1 : r • x = r' • x := hηb.1 (by rw [hF1, hF1]; exact hss)
        rw [hx.1 h1]
      · intro y
        obtain ⟨z, rfl⟩ := hηb.2 y
        obtain ⟨r, rfl⟩ := hx.2 z
        exact ⟨φ' r, (hF1 r).symm⟩
    have hfun : (fun r : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) =>
        (g.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom r) =
        (fun s : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) => s • η' x) :=
      funext (fun r => (hg _ r).trans (by
        first
          | exact congrArg (fun y => r • y) hnat.symm
          | (rw [hnat]; rfl)))
    have h : Function.Bijective
        (fun r : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj Vt)) =>
          (g.val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom r) := by
      rw [hfun]; exact hψ
    exact h

  let α := (SheafOfModules.toSheaf _).map g
  haveI hα : IsIso α := by
    apply wc_proet_isIso_of_sections_bijective
    intro U
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (wc_pmn_vp_thick_cover i ℓ Di hDi U)
    intro T f hf
    obtain ⟨Vt, κ, hW, hcl, hunit⟩ := hf
    have hb := hgb Vt hW hcl hunit
    have hn := α.hom.naturality κ.hom.op
    have iA := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf _).obj (SheafOfModules.unit (wcRingSheaf Z ℓ))).obj.map κ.hom.op)
    have iB := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.map κ.hom.op)
    have h4 : Function.Bijective (⇑(ConcreteCategory.hom
        (((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.map κ.hom.op)) ∘
        ⇑(ConcreteCategory.hom (α.hom.app (Opposite.op T)))) := by
      show Function.Bijective ⇑(ConcreteCategory.hom (α.hom.app (Opposite.op T) ≫
        ((SheafOfModules.toSheaf _).obj (Di.Φ.obj M)).obj.map κ.hom.op))
      rw [← hn]
      exact hb.comp iA
    exact (Function.Bijective.of_comp_iff' iB _).mp h4
  haveI : IsIso g := isIso_of_reflects_iso _ (SheafOfModules.toSheaf _)
  exact ⟨(asIso g).symm⟩

theorem wc_qmbt_ecc_shens_maximal {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀) :
    IsNoetherianRing B₀ ∧
    IsLocalRing.maximalIdeal B₀ = Ideal.span (Set.range fun p : Fin n =>
      (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ∧
    @Algebra.WeaklyEtale (wcQuadModelRing A n π c) B₀ _ _ (Spec.preimage a₀).hom.toAlgebra :=
by
  classical

  have N2 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (m₀ : Ideal R) [m₀.IsMaximal]
      (β : R →+* B₀), @Algebra.WeaklyEtale R B₀ _ _ β.toAlgebra →
      Ideal.comap β (IsLocalRing.maximalIdeal B₀) = m₀ →
      IsNoetherianRing B₀ ∧ Ideal.map β m₀ = IsLocalRing.maximalIdeal B₀ := by
    intro R _ _ m₀ _ β hWE hcomap
    haveI : m₀.IsPrime := Ideal.IsMaximal.isPrime ‹_›
    haveI : IsNoetherianRing (Localization.AtPrime m₀) :=
      IsLocalization.isNoetherianRing m₀.primeCompl (Localization.AtPrime m₀) ‹_›
    have hunit : ∀ y : m₀.primeCompl, IsUnit (β y) := by
      intro y
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hy
      have h' : (y : R) ∈ Ideal.comap β (IsLocalRing.maximalIdeal B₀) := hy
      rw [hcomap] at h'
      exact y.2 h'
    have hθ : (IsLocalization.lift (M := m₀.primeCompl) (S := Localization.AtPrime m₀) hunit).comp
        (algebraMap R (Localization.AtPrime m₀)) = β := IsLocalization.lift_comp hunit
    have hloc : IsLocalHom
        (IsLocalization.lift (M := m₀.primeCompl) (S := Localization.AtPrime m₀) hunit) := by
      refine ⟨fun z hz => ?_⟩
      obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective m₀.primeCompl z
      rw [IsLocalization.lift_mk'] at hz
      have hr : IsUnit (β r) := isUnit_of_mul_isUnit_left hz
      rw [IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime m₀) m₀ r s]
      show r ∉ m₀
      intro hrm
      apply IsLocalRing.notMem_maximalIdeal.mpr hr
      have h' : r ∈ Ideal.comap β (IsLocalRing.maximalIdeal B₀) := by rw [hcomap]; exact hrm
      exact h'
    letI : Algebra R B₀ := β.toAlgebra
    letI : Algebra (Localization.AtPrime m₀) B₀ :=
      (IsLocalization.lift (M := m₀.primeCompl) (S := Localization.AtPrime m₀) hunit).toAlgebra
    haveI : IsScalarTower R (Localization.AtPrime m₀) B₀ := IsScalarTower.of_algebraMap_eq' hθ.symm
    have hWE' : Algebra.WeaklyEtale (Localization.AtPrime m₀) B₀ :=
      wc_weaklyEtale_cancel R (Localization.AtPrime m₀) B₀
        (wc_localization_weaklyEtale R (Localization.AtPrime m₀) m₀.primeCompl) hWE
    obtain ⟨hN, hmap⟩ := wc_tla_shens_noeth_unram (Localization.AtPrime m₀) B₀ _ hloc hWE'
    refine ⟨hN, ?_⟩
    rw [← hmap, ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, hθ]

  have ha : Spec.map (CommRingCat.ofHom (Spec.preimage a₀).hom) = a₀ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hWEs : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage a₀).hom)) := by
    rw [ha]; exact wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  have hWE : @Algebra.WeaklyEtale (wcQuadModelRing A n π c) B₀ _ _
      (Spec.preimage a₀).hom.toAlgebra :=
    wc_lpkt_specMap_weaklyEtale_ring _ B₀ (Spec.preimage a₀).hom hWEs

  have hz : ∀ ζ : Spec (.of (IsLocalRing.ResidueField B₀)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) ζ = IsLocalRing.closedPoint B₀ := by
    intro ζ
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue B₀)
      (PrimeSpectrum.asIdeal (show PrimeSpectrum (IsLocalRing.ResidueField B₀) from ζ)) =
      IsLocalRing.maximalIdeal B₀
    rw [Ideal.eq_bot_of_prime (PrimeSpectrum.asIdeal (show PrimeSpectrum (IsLocalRing.ResidueField B₀) from ζ))]
    exact IsLocalRing.ker_residue
  have hcp : a₀ (IsLocalRing.closedPoint B₀) = x₀ := by
    obtain ⟨-, -, -, -, -, e, -, heq⟩ := hsh
    have key : ∀ ω, (Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) ≫ a₀) ω =
        (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀) ω := fun ω => by rw [heq]
    have h1 : a₀ (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))
        (Spec.map (CommRingCat.ofHom e) (IsLocalRing.closedPoint (AlgebraicClosure
          ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀))))) =
        (Spec (.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀
          (Spec.map (CommRingCat.ofHom (algebraMap
            ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀) (AlgebraicClosure
              ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀))))
            (IsLocalRing.closedPoint (AlgebraicClosure
              ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀)))) :=
      key (IsLocalRing.closedPoint (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀)))
    rw [hz, Scheme.fromSpecResidueField_apply] at h1
    exact h1
  have hcomap : Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B₀) =
      PrimeSpectrum.asIdeal x₀ := by
    have h2 : (Spec.map (CommRingCat.ofHom (Spec.preimage a₀).hom))
        (IsLocalRing.closedPoint B₀) = x₀ := by rw [ha]; exact hcp
    rw [← h2]
    rfl
  haveI hmax := wc_qmbt_bm_origin_maximal hπ n c
  have hle : Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤ PrimeSpectrum.asIdeal x₀ := by
    rw [Ideal.span_le]
    rintro _ ⟨p, rfl⟩
    exact hx₀ p
  have hm0 := hmax.eq_of_le (PrimeSpectrum.isPrime x₀).ne_top hle
  haveI : IsNoetherianRing (wcQuadModelRing A n π c) := Ideal.Quotient.isNoetherianRing _
  obtain ⟨hN, hmap⟩ := N2 (wcQuadModelRing A n π c) _ (Spec.preimage a₀).hom hWE
    (hcomap.trans hm0.symm)
  refine ⟨hN, ?_, hWE⟩
  rw [← hmap, Ideal.map_span, ← Set.range_comp]
  rfl

theorem wc_qmbt_yrc_E_cover {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {Y : Scheme.{u}} (iY : Y ⟶ Xs') [IsClosedImmersion iY]
    (hYset : Set.range iY =
      closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀}) :
    ∃ V : Fin n → Xm.Opens,
      (∀ j i : Fin n, ∃ b : Γ(Xm, V j),
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X i)))) =
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))) * b) ∧
      (∀ j : Fin n, ∃ b : Γ(Xm, V j),
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π')) =
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))) * b) ∧
      (∀ j j' : Fin n, ∃ v : (Γ(Xm, V j ⊓ V j'))ˣ,
        (Xm.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))) =
        (v : Γ(Xm, V j ⊓ V j')) *
        (Xm.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j'))))) ∧
      Set.range (iY ≫ ι') ⊆ ⋃ j, (V j : Set Xm) :=
by
  classical

  obtain ⟨x, hxdef⟩ : ∃ x : Fin n → Γ(Xm, ⊤), x = fun i =>
      (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X i))) := ⟨_, rfl⟩
  obtain ⟨ϖ, hϖdef⟩ : ∃ ϖ : Γ(Xm, ⊤), ϖ =
      f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π') := ⟨_, rfl⟩
  have hxi : ∀ p, x p =
      (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) := by
    intro p; subst hxdef; rfl

  have hcomp : ∀ {A₁ B₁ C₁ : Xm.Opens} (i : Opposite.op A₁ ⟶ Opposite.op B₁)
      (j : Opposite.op B₁ ⟶ Opposite.op C₁) (z : Γ(Xm, A₁)),
      (Xm.presheaf.map j).hom ((Xm.presheaf.map i).hom z) = (Xm.presheaf.map (i ≫ j)).hom z := by
    intro A₁ B₁ C₁ i j z
    rw [Functor.map_comp]
    rfl
  have hrr : ∀ {W W' : Xm.Opens} (h : W ≤ W') (s : Γ(Xm, ⊤)),
      (Xm.presheaf.map (homOfLE h).op).hom
        ((Xm.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom s) =
        (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom s := by
    intro W W' h s
    rw [hcomp]
    rfl

  have s3 : ∀ {κ : Type} (d : Γ(Xm, ⊤)) (G : κ → Γ(Xm, ⊤)), ∃ V : Xm.Opens,
      (∀ k : κ, ∃ b : Γ(Xm, V), (Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (G k) =
        (Xm.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom d * b) ∧
      (∀ (W : Xm.Opens) (hW : W ≤ V) (s : Γ(Xm, W)),
        (Xm.presheaf.map (homOfLE (hW.trans le_top)).op).hom d * s = 0 → s = 0) ∧
      (∀ W : Xm.Opens, IsAffineOpen W →
        (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom d ∈ nonZeroDivisors Γ(Xm, W) →
        (∀ k : κ, ∃ b : Γ(Xm, W), (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (G k) =
          (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom d * b) → W ≤ V) := by
    intro κ d G
    let NZ : Xm.Opens → Prop := fun W => ∀ (W' : Xm.Opens) (_ : W' ≤ W) (s : Γ(Xm, W')),
      (Xm.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom d * s = 0 → s = 0
    let Good : Xm.Opens → Prop := fun W => (∀ k : κ, ∃ b : Γ(Xm, W),
      (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (G k) =
        (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom d * b) ∧ NZ W
    let S := {W : Xm.Opens // Good W}
    have hNZV : NZ (⨆ σ : S, σ.1) := by
      intro W' hW' s hs
      apply TopCat.Presheaf.section_ext Xm.sheaf W' s 0
      intro w hw
      obtain ⟨σ, hσ⟩ := TopologicalSpace.Opens.mem_iSup.mp (hW' hw)
      have hres : (Xm.presheaf.map (homOfLE (inf_le_left : W' ⊓ σ.1 ≤ W')).op).hom s = 0 := by
        apply σ.2.2 (W' ⊓ σ.1) inf_le_right
        have e := congrArg (Xm.presheaf.map (homOfLE (inf_le_left : W' ⊓ σ.1 ≤ W')).op).hom hs
        rw [map_mul, map_zero, hrr] at e
        exact e
      have hg := TopCat.Presheaf.germ_res_apply Xm.presheaf
        (homOfLE (inf_le_left : W' ⊓ σ.1 ≤ W')) w ⟨hw, hσ⟩ s
      show (Xm.presheaf.germ W' w hw).hom s = (Xm.presheaf.germ W' w hw).hom 0
      rw [map_zero]
      erw [← hg]
      rw [hres, map_zero]
    refine ⟨⨆ σ : S, σ.1, ?_, fun W hW s hs => hNZV W hW s hs, ?_⟩
    · intro k
      choose bσ hbσ using fun σ : S => σ.2.1 k
      have hcompat : TopCat.Presheaf.IsCompatible Xm.sheaf.obj (fun σ : S => σ.1) bσ := by
        intro σ τ
        have h0 : (Xm.presheaf.map (homOfLE (le_top : σ.1 ⊓ τ.1 ≤ ⊤)).op).hom d *
            ((Xm.presheaf.map (homOfLE (inf_le_left : σ.1 ⊓ τ.1 ≤ σ.1)).op).hom (bσ σ) -
             (Xm.presheaf.map (homOfLE (inf_le_right : σ.1 ⊓ τ.1 ≤ τ.1)).op).hom (bσ τ)) = 0 := by
          have e1 := congrArg (Xm.presheaf.map (homOfLE (inf_le_left : σ.1 ⊓ τ.1 ≤ σ.1)).op).hom
            (hbσ σ)
          have e2 := congrArg (Xm.presheaf.map (homOfLE (inf_le_right : σ.1 ⊓ τ.1 ≤ τ.1)).op).hom
            (hbσ τ)
          rw [map_mul, hrr, hrr] at e1 e2
          rw [mul_sub, ← e1, ← e2, sub_self]
        have := σ.2.2 (σ.1 ⊓ τ.1) inf_le_left _ h0
        exact sub_eq_zero.mp this
      obtain ⟨b, hb⟩ : ∃ b : Γ(Xm, ⨆ σ : S, σ.1), ∀ σ : S,
          (Xm.presheaf.map (homOfLE (le_iSup (fun σ : S => σ.1) σ)).op).hom b = bσ σ := by
        obtain ⟨b, hb, -⟩ := TopCat.Sheaf.existsUnique_gluing' Xm.sheaf (fun σ : S => σ.1)
          (⨆ σ : S, σ.1) (fun σ => homOfLE (le_iSup (fun σ : S => σ.1) σ)) le_rfl bσ hcompat
        exact ⟨b, hb⟩
      refine ⟨b, ?_⟩
      apply TopCat.Sheaf.eq_of_locally_eq' Xm.sheaf (fun σ : S => σ.1) (⨆ σ : S, σ.1)
        (fun σ => homOfLE (le_iSup (fun σ : S => σ.1) σ)) le_rfl
      intro σ
      change (Xm.presheaf.map (homOfLE (le_iSup (fun σ : S => σ.1) σ)).op).hom
          ((Xm.presheaf.map (homOfLE (le_top : (⨆ σ : S, σ.1) ≤ ⊤)).op).hom (G k)) =
        (Xm.presheaf.map (homOfLE (le_iSup (fun σ : S => σ.1) σ)).op).hom
          ((Xm.presheaf.map (homOfLE (le_top : (⨆ σ : S, σ.1) ≤ ⊤)).op).hom d * b)
      rw [map_mul, hrr, hrr, hbσ σ, hb σ]
    · intro W hW hd hdiv
      have hNZW : NZ W := by
        intro W' hW' s hs
        apply TopCat.Presheaf.section_ext Xm.sheaf W' s 0
        intro w hw
        obtain ⟨f₀, hfW', hwf⟩ := hW.exists_basicOpen_le (V := W') ⟨w, hw⟩ (hW' hw)
        have h1 : (Xm.presheaf.map (homOfLE (Xm.basicOpen_le f₀)).op).hom
            ((Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom d) ∈
              nonZeroDivisors Γ(Xm, Xm.basicOpen f₀) :=
          @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers f₀) _ _ _
            (hW.isLocalization_basicOpen f₀) _ (Submonoid.mem_map_of_mem _ hd)
        rw [hrr] at h1
        have hres : (Xm.presheaf.map (homOfLE hfW').op).hom s = 0 := by
          have e := congrArg (Xm.presheaf.map (homOfLE hfW').op).hom hs
          rw [map_mul, map_zero, hrr] at e
          exact (mul_left_mem_nonZeroDivisors_eq_zero_iff h1).mp e
        have hg := TopCat.Presheaf.germ_res_apply Xm.presheaf (homOfLE hfW') w hwf s
        show (Xm.presheaf.germ W' w hw).hom s = (Xm.presheaf.germ W' w hw).hom 0
        rw [map_zero]
        erw [← hg]
        rw [hres, map_zero]
      exact le_iSup (fun σ : S => σ.1) ⟨W, hdiv, hNZW⟩

  have s4 : ∀ (W : Xm.Opens), (∀ p : Fin n, ∃ b : Γ(Xm, W),
      (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (x p) =
        (Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom ϖ * b) →
      ∀ w : Xs', ι' w ∈ W → (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) w = IsLocalRing.closedPoint B₀ := by
    intro W hW w hw
    have hmax := (wc_qmbt_ecc_shens_maximal hπ hx₀ hsh).2.1
    have hC : ∀ {T : Scheme.{u}} {S : CommRingCat.{u}} (h : T ⟶ Spec S) (r : S) (t : T),
        t ∈ T.basicOpen (h.appTop.hom ((Scheme.ΓSpecIso S).inv.hom r)) ↔
          r ∉ PrimeSpectrum.asIdeal (h t) := by
      intro T S h r t
      rw [← Scheme.preimage_basicOpen_top]
      show h t ∈ (Spec S).basicOpen _ ↔ _
      rw [basicOpen_eq_of_affine]
      exact PrimeSpectrum.mem_basicOpen _ _
    have hfx : f (ι' w) = Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) (s' w) :=
      congrArg (fun g : Xs' ⟶ Spec (.of A') => g w) hps'.w
    have hϖ0 : π' ∈ PrimeSpectrum.asIdeal (f (ι' w)) := by
      rw [hfx]
      show IsLocalRing.residue A' π' ∈ PrimeSpectrum.asIdeal (s' w)
      rw [(IsLocalRing.residue_eq_zero_iff π').mpr (hπ' ▸ Ideal.mem_span_singleton_self π')]
      exact zero_mem _
    have hxp : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) (ι' w)) := by
      intro p
      by_contra hcon
      rw [← hC, ← hxi p] at hcon
      obtain ⟨b, hb⟩ := hW p
      have h1 : ι' w ∈ Xm.basicOpen ((Xm.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
          (x p)) := by
        rw [Scheme.basicOpen_res]; exact ⟨hw, hcon⟩
      rw [hb, Scheme.basicOpen_mul, Scheme.basicOpen_res, hϖdef] at h1
      exact (hC f π' (ι' w)).mp h1.1.2 hϖ0
    have key : ∀ q, PrimeSpectrum.asIdeal (a₀ q) =
        Ideal.comap (Spec.preimage a₀).hom (PrimeSpectrum.asIdeal q) := by
      intro q
      nth_rewrite 1 [← Spec.map_preimage a₀]
      rfl
    have hle : IsLocalRing.maximalIdeal B₀ ≤ PrimeSpectrum.asIdeal ((ι' ≫ bl ≫
        Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) w) := by
      rw [hmax, Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      have := hxp p
      have e : (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀) (ι' w) =
          a₀ ((ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))) w) := rfl
      rw [e, key] at this
      exact this
    apply PrimeSpectrum.ext
    exact le_antisymm (IsLocalRing.le_maximalIdeal ((ι' ≫ bl ≫
      Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) w).2.ne_top) hle

  choose V C1 C2 C3 using fun j : Fin n => s3 (x j) (fun o : Option (Fin n) => Option.elim o ϖ x)
  have hgoal : ∃ V : Fin n → Xm.Opens,
      (∀ j i : Fin n, ∃ b : Γ(Xm, V j),
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (x i) =
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (x j) * b) ∧
      (∀ j : Fin n, ∃ b : Γ(Xm, V j),
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom ϖ =
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (x j) * b) ∧
      (∀ j j' : Fin n, ∃ v : (Γ(Xm, V j ⊓ V j'))ˣ,
        (Xm.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j) =
        (v : Γ(Xm, V j ⊓ V j')) *
        (Xm.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j')) ∧
      Set.range (iY ≫ ι') ⊆ ⋃ j, (V j : Set Xm) := by
    refine ⟨V, fun j i => C1 j (some i), fun j => C1 j none, ?_, ?_⟩
    ·
      intro j j'
      obtain ⟨b₁, hb₁⟩ := C1 j (some j')
      obtain ⟨b₂, hb₂⟩ := C1 j' (some j)
      have hb₁' : (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (x j') =
          (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom (x j) * b₁ := hb₁
      have hb₂' : (Xm.presheaf.map (homOfLE (le_top : V j' ≤ ⊤)).op).hom (x j) =
          (Xm.presheaf.map (homOfLE (le_top : V j' ≤ ⊤)).op).hom (x j') * b₂ := hb₂
      have e1 := congrArg (Xm.presheaf.map (homOfLE (inf_le_left : V j ⊓ V j' ≤ V j)).op).hom hb₁'
      have e2 := congrArg (Xm.presheaf.map (homOfLE (inf_le_right : V j ⊓ V j' ≤ V j')).op).hom
        hb₂'
      rw [map_mul, hrr, hrr] at e1 e2
      have hO : (Xm.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j) *
          (1 - (Xm.presheaf.map (homOfLE (inf_le_left : V j ⊓ V j' ≤ V j)).op).hom b₁ *
            (Xm.presheaf.map (homOfLE (inf_le_right : V j ⊓ V j' ≤ V j')).op).hom b₂) = 0 := by
        rw [mul_sub, mul_one, ← mul_assoc, ← e1, ← e2, sub_self]
      have h1 := C2 j (V j ⊓ V j') inf_le_left _ hO
      have h12 : (Xm.presheaf.map (homOfLE (inf_le_left : V j ⊓ V j' ≤ V j)).op).hom b₁ *
          (Xm.presheaf.map (homOfLE (inf_le_right : V j ⊓ V j' ≤ V j')).op).hom b₂ = 1 :=
        (sub_eq_zero.mp h1).symm
      refine ⟨⟨(Xm.presheaf.map (homOfLE (inf_le_right : V j ⊓ V j' ≤ V j')).op).hom b₂,
        (Xm.presheaf.map (homOfLE (inf_le_left : V j ⊓ V j' ≤ V j)).op).hom b₁,
        by rw [mul_comm]; exact h12, h12⟩, ?_⟩
      show (Xm.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j) =
        (Xm.presheaf.map (homOfLE (inf_le_right : V j ⊓ V j' ≤ V j')).op).hom b₂ *
        (Xm.presheaf.map (homOfLE (le_top : V j ⊓ V j' ≤ ⊤)).op).hom (x j')
      rw [e2, mul_comm]
    ·
      rintro _ ⟨y, rfl⟩
      obtain ⟨g, hgdef⟩ : ∃ g : Option (Fin n) → Γ(Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA)), ⊤), g = (fun i : Option (Fin n) => Option.elim i
            ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
              (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
            (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
              (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
                (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))))) := ⟨_, rfl⟩
      have hbl' : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))) bl := by
        subst hgdef; exact hbl
      have hGnone : bl.appTop.hom (g none) = ϖ := by
        rw [hgdef, hϖdef, ← hblf]
        first
        | rfl
        | (simp only [Option.elim, Scheme.Hom.comp_appTop]; rfl)
      have hGsome : ∀ i, bl.appTop.hom (g (some i)) = x i := by
        intro i
        rw [hgdef, hxi i]
        first
        | rfl
        | (simp only [Option.elim, Scheme.Hom.comp_appTop]; rfl)
      have hI : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))).ideal
          ⟨⊤, isAffineOpen_top _⟩ = Ideal.span (Set.range g) := by
        rw [Scheme.IdealSheafData.ofIdealTop_ideal]
        have e : ∀ a, ((Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))).presheaf.map
              (𝟙 (Opposite.op (⊤ : (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
                (Spec.map (CommRingCat.ofHom ιA))).Opens)))).hom a = a := by
          intro a; rw [CategoryTheory.Functor.map_id]; rfl
        exact (congrArg (fun φ => Ideal.map φ (Ideal.span (Set.range g))) (RingHom.ext e)).trans
          (Ideal.map_id _)
      have hspan : Ideal.span (Set.range (fun t : Fin (n + 1) => g (finSuccEquiv n t))) =
          (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))).ideal
            ⟨⊤, isAffineOpen_top _⟩ := by
        rw [hI]
        congr 1
        exact EquivLike.range_comp g (finSuccEquiv n)
      obtain ⟨t, V', e, hzV', hN, hS⟩ := wc_csd_invpull_generator_chart _ Xm _ bl hbl'.1
        ⟨⊤, isAffineOpen_top _⟩ (n + 1) (fun t => g (finSuccEquiv n t)) hspan ((iY ≫ ι') y) trivial
      beta_reduce at hN hS
      rw [hI] at hS
      have hmemc : ∀ k, ∃ cc : Γ(Xm, V'.1),
          cc * (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom
            (bl.appTop.hom (g (finSuccEquiv n t))) =
          (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom (bl.appTop.hom (g k)) := by
        intro k
        have hm := Ideal.mem_map_of_mem (bl.appLE _ _ e).hom
          (Ideal.subset_span ⟨k, rfl⟩ : g k ∈ Ideal.span (Set.range g))
        rw [hS] at hm
        obtain ⟨cc, hcc⟩ := Ideal.mem_span_singleton'.mp hm
        exact ⟨cc, hcc⟩
      rcases hτ : finSuccEquiv n t with _ | j
      ·
        exfalso
        have hdiv : ∀ p : Fin n, ∃ b : Γ(Xm, V'.1),
            (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom (x p) =
              (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom ϖ * b := by
          intro p
          obtain ⟨cc, hcc⟩ := hmemc (some p)
          rw [hτ, hGnone, hGsome] at hcc
          exact ⟨cc, by rw [← hcc, mul_comm]⟩
        have hsp := s4 V'.1 hdiv
        have hyY : iY y ∈ Set.range iY := ⟨y, rfl⟩
        rw [hYset] at hyY
        have hopen : IsOpen (ι' ⁻¹' (V'.1 : Set Xm)) := by
          first
          | exact V'.1.2.preimage ι'.continuous
          | exact V'.1.2.preimage ι'.base.hom.continuous
        obtain ⟨w, hwV, hwZ⟩ := (mem_closure_iff.mp hyY.1) _ hopen hzV'
        exact hwZ (hsp w hwV)
      ·
        refine Set.mem_iUnion.mpr ⟨j, ?_⟩
        have hnzd : (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom (x j) ∈
            nonZeroDivisors Γ(Xm, V'.1) := by
          rw [hτ] at hN
          rw [← hGsome j]
          exact hN
        have hdivs : ∀ k : Option (Fin n), ∃ b : Γ(Xm, V'.1),
            (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom (Option.elim k ϖ x) =
              (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom (x j) * b := by
          intro k
          cases k with
          | none =>
            obtain ⟨cc, hcc⟩ := hmemc none
            rw [hτ, hGsome, hGnone] at hcc
            refine ⟨cc, ?_⟩
            show (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom ϖ = _
            rw [← hcc, mul_comm]
          | some i =>
            obtain ⟨cc, hcc⟩ := hmemc (some i)
            rw [hτ, hGsome, hGsome] at hcc
            refine ⟨cc, ?_⟩
            show (Xm.presheaf.map (homOfLE (le_top : V'.1 ≤ ⊤)).op).hom (x i) = _
            rw [← hcc, mul_comm]
        exact C3 j V'.1 V'.2 hnzd hdivs hzV'
  subst hxdef hϖdef
  exact hgoal

theorem wc_qmbt_yrc_model_dichotomy {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π') :
    ∃ (Xm₀ : Scheme.{u}) (f₀ : Xm₀ ⟶ Spec (.of A'))
      (bl₀ : Xm₀ ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))),
      wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        (fun i : Option (Fin n) => Option.elim i
          ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
          (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl₀ ∧
      bl₀ ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) = f₀ ∧
      ∀ x : Xm₀, ∃ (U : Xm₀.Opens) (r : ℕ)
        (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
        (y : U.toScheme),
        U.ι y = x ∧ WeaklyEtale g ∧
        g ≫ wcQuadModelStr A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
          U.ι ≫ f₀ ∧
        ((Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) ∧
          Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y)) ∨
        (∃ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∉
          PrimeSpectrum.asIdeal (a₀ ((bl₀ ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA))) x))) ∨
        (∃ N : Xm₀.Opens, x ∈ N ∧ ∀ x' : Xm₀, x' ∈ N → f₀ x' = IsLocalRing.closedPoint A' →
          ∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (a₀ ((bl₀ ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
              (Spec.map (CommRingCat.ofHom ιA))) x')))) :=
by
  classical
  have hn2 : 2 ≤ n := by omega

  obtain ⟨θ, hθX, hθA, sq₁⟩ := wc_qmbt_bm_quad_pullback ιA n π c π' hπ'2
  obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      gP ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
    ⟨sq₁.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
  have sqL : IsPullback (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) gP a₀ (Spec.map (CommRingCat.ofHom θ)) := by
    refine IsPullback.of_bot ?_ hgP1.symm sq₁
    rw [hgP2]
    exact IsPullback.of_hasPullback _ _
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hgPw : WeaklyEtale gP := MorphismProperty.of_isPullback (P := @WeaklyEtale) sqL ha₀

  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) :=
    inferInstance
  obtain ⟨X₁, r₁, hb₁, hX₁⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k))))
  haveI := hX₁
  haveI hfst : WeaklyEtale (Limits.pullback.fst r₁ gP) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback r₁ gP).flip hgPw

  haveI hgPflat : Flat gP := hgPw.flat
  haveI hPaff : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    dsimp only [wcQuadModelStr]
    infer_instance
  have hbl := wc_qmbt_bm_flat_base_change
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ gP hb₁

  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have h1 : c.map ιA + (c.map ιA).transpose = (c + c.transpose).map ιA := by
      ext i j
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hc.map ιA
  choose φs hφs using fun j => wc_qmbt_bm_chart_algebra hπ' (c.map ιA) j
  obtain ⟨φ0, hφ0⟩ := wc_qmbt_bm_chart_algebra_none hπ' (c.map ιA)
  let Φ : ∀ k, CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k := fun k =>
    Option.rec (motive := fun k => CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k) (CommRingCat.ofHom φ0)
      (fun j => CommRingCat.ofHom (φs j)) k
  obtain ⟨e, he_open, he_comp, he_cover⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ hb₁ (wcQmbtCharts A' n π' (c.map ιA)) Φ
    (fun k => by cases k with
      | none => exact hφ0.2.2.1
      | some j => exact (hφs j).2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.1
      | some j => exact (hφs j).2.2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.2
      | some j => exact (hφs j).2.2.2.2)

  have key : ∀ (C : Type u) [CommRing C] [Algebra A' C] (e₀ : Spec (CommRingCat.of C) ⟶ X₁)
      [IsOpenImmersion e₀] (φ : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* C),
      e₀ ≫ r₁ = Spec.map (CommRingCat.ofHom φ) →
      φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) = algebraMap A' C →
      ∀ (y : Spec (CommRingCat.of C)) (h : C)
        (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
      h ∉ PrimeSpectrum.asIdeal y →
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away h) →
      ψ.Etale →
      ∃ (W : X₁.Opens) (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
        e₀ y ∈ W ∧ WeaklyEtale gW ∧
        gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
          W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) ∧
        ∀ w : W, (w : X₁) = e₀ y → ∃ q : PrimeSpectrum (Localization.Away h),
          q.asIdeal.comap (algebraMap C (Localization.Away h)) = PrimeSpectrum.asIdeal y ∧
          gW w = Spec.map (CommRingCat.ofHom ψ) q := by
    intro C _ _ e₀ _ φ he hφ y h ψ hy hψ hψe
    let lh : Spec (CommRingCat.of (Localization.Away h)) ⟶ Spec (CommRingCat.of C) :=
      Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away h)))
    obtain ⟨q0, hq⟩ : y ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away h))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away h) h]
      exact (PrimeSpectrum.mem_basicOpen h y).mpr hy
    let q : Spec (CommRingCat.of (Localization.Away h)) := q0
    have hlq : lh q = y := hq
    have hWι : (lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀) = (lh ≫ e₀).opensRange.ι := by
      rw [Iso.inv_comp_eq, Scheme.Hom.isoOpensRange_hom_ι]
    haveI : Etale (Spec.map (CommRingCat.ofHom ψ)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hψe
    refine ⟨(lh ≫ e₀).opensRange, (lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom ψ),
      ?_, inferInstance, ?_, ?_⟩
    · exact Scheme.Hom.mem_opensRange.mpr
        ⟨q, (Scheme.Hom.comp_apply lh e₀ q).trans (congrArg e₀ hlq)⟩
    · have halg : algebraMap A' (Localization.Away h) =
          (algebraMap C (Localization.Away h)).comp
            (φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
        rw [hφ]
        exact IsScalarTower.algebraMap_eq _ _ _
      calc ((lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
            Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π')))
          = (lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom
              (ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')))) := by
            rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = (lh ≫ e₀).isoOpensRange.inv ≫ lh ≫ Spec.map (CommRingCat.ofHom φ) ≫
              Spec.map (CommRingCat.ofHom
                (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
            rw [hψ, halg]
            simp only [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, lh]
        _ = ((lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀)) ≫ r₁ ≫
              Spec.map (CommRingCat.ofHom
                (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
            rw [← he]
            simp only [Category.assoc]
        _ = _ := by rw [hWι]
    · intro w hw
      refine ⟨q, congrArg PrimeSpectrum.asIdeal hq, ?_⟩
      have h1 : (lh ≫ e₀) ((lh ≫ e₀).isoOpensRange.inv w) = (lh ≫ e₀) q := by
        rw [show (lh ≫ e₀) ((lh ≫ e₀).isoOpensRange.inv w) =
            ((lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀)) w from (Scheme.Hom.comp_apply _ _ _).symm,
          hWι, Scheme.Opens.ι_apply, hw, Scheme.Hom.comp_apply, hlq]
      have h2 := (lh ≫ e₀).isOpenEmbedding.injective h1
      exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ)) h2)

  have nbhd : ∀ (C : Type u) [CommRing C] (e₀ : Spec (CommRingCat.of C) ⟶ X₁)
      [IsOpenImmersion e₀] (s : C) (y : Spec (CommRingCat.of C)), s ∉ PrimeSpectrum.asIdeal y →
      ∃ N : X₁.Opens, e₀ y ∈ N ∧ ∀ x : X₁, x ∈ N →
        ∃ 𝔭' : Spec (CommRingCat.of C), e₀ 𝔭' = x ∧ s ∉ PrimeSpectrum.asIdeal 𝔭' := by
    intro C _ e₀ _ s y hy
    let lh : Spec (CommRingCat.of (Localization.Away s)) ⟶ Spec (CommRingCat.of C) :=
      Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away s)))
    obtain ⟨q0, hq⟩ : y ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away s))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s]
      exact (PrimeSpectrum.mem_basicOpen s y).mpr hy
    let q : Spec (CommRingCat.of (Localization.Away s)) := q0
    have hlq : lh q = y := hq
    refine ⟨(lh ≫ e₀).opensRange, Scheme.Hom.mem_opensRange.mpr
        ⟨q, (Scheme.Hom.comp_apply lh e₀ q).trans (congrArg e₀ hlq)⟩, ?_⟩
    intro x hx
    obtain ⟨q', hq'⟩ := Scheme.Hom.mem_opensRange.mp hx
    refine ⟨lh q', (Scheme.Hom.comp_apply lh e₀ q').symm.trans hq', ?_⟩
    have hmem : lh q' ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away s))) :=
      ⟨q', rfl⟩
    rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s] at hmem
    exact (PrimeSpectrum.mem_basicOpen s _).mp hmem

  have CP : ∀ (C : Type u) [CommRing C] [Algebra A' C]
      (φ : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* C),
      φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) = algebraMap A' C →
      ∀ 𝔭' : Spec (CommRingCat.of C),
      Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
        (Spec.map (CommRingCat.ofHom φ) 𝔭') = IsLocalRing.closedPoint A' →
      algebraMap A' C π' ∈ PrimeSpectrum.asIdeal 𝔭' := by
    intro C _ _ φ hφ 𝔭' hcl
    have h1 := congrArg PrimeSpectrum.asIdeal hcl
    change Ideal.comap (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
        (Ideal.comap φ (PrimeSpectrum.asIdeal 𝔭')) = IsLocalRing.maximalIdeal A' at h1
    rw [Ideal.comap_comap, hφ] at h1
    have hm : π' ∈ IsLocalRing.maximalIdeal A' := by
      rw [hπ']
      exact Ideal.mem_span_singleton_self π'
    rw [← h1] at hm
    exact Ideal.mem_comap.mp hm

  have s_off : ∀ (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' (c.map ιA) j)),
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) ∉
        𝔭.asIdeal →
      algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π' ∈ 𝔭.asIdeal →
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X (some j)) ∈
        𝔭.asIdeal := by
    intro j 𝔭 hs hπ𝔭
    have hrel : MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π' ∈
        wcQmbtChartIdeal A' n π' (c.map ιA) j :=
      Ideal.subset_span (Set.mem_insert _ _)
    have h0 := (Ideal.Quotient.eq_zero_iff_mem).mpr hrel
    rw [map_sub, map_mul, sub_eq_zero] at h0
    have hC : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.C π') =
        algebraMap A' (wcQmbtChart A' n π' (c.map ιA) j) π' := by
      rw [← MvPolynomial.algebraMap_eq]
      exact Ideal.Quotient.mk_algebraMap A' (wcQmbtChartIdeal A' n π' (c.map ιA) j) π'
    rw [hC] at h0
    have hprod : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
        (MvPolynomial.X (some j)) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j) (MvPolynomial.X none) ∈
        𝔭.asIdeal := by
      rw [h0]
      exact hπ𝔭
    rcases 𝔭.isPrime.mem_or_mem hprod with h | h
    · exact h
    · exact absurd h hs

  have local_chart : ∀ x₁ : X₁, ∃ (W : X₁.Opens)
      (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
      x₁ ∈ W ∧ WeaklyEtale gW ∧
      gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) ∧
      ((∀ w : W, (w : X₁) = x₁ →
        Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2))) ∈ PrimeSpectrum.asIdeal (gW w) ∧
        Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2))) ∈ PrimeSpectrum.asIdeal (gW w)) ∨
       (∃ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∉
          PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ) (r₁ x₁))) ∨
       (∃ N₁ : X₁.Opens, x₁ ∈ N₁ ∧ ∀ x₁' : X₁, x₁' ∈ N₁ →
          Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
            (r₁ x₁') = IsLocalRing.closedPoint A' →
          ∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ) (r₁ x₁')))) := by
    intro x₁
    obtain ⟨k, y, hy⟩ := he_cover x₁
    subst hy
    cases k with
    | none =>
      haveI := he_open none
      obtain ⟨h, ψ, hh, hψ, hψe⟩ := wc_qmbt_bm_chart_coords_none hπ' hn2 hc' y
      obtain ⟨W, gW, h1, h2, h3, -⟩ :=
        @key (wcQmbtChartNone A' n (c.map ιA)) _ _ (e none) (he_open none) φ0 (he_comp none)
          hφ0.2.1 y h ψ hh hψ hψe
      refine ⟨W, gW, h1, h2, h3, Or.inr (Or.inr ⟨(e none).opensRange,
        Scheme.Hom.mem_opensRange.mpr ⟨y, rfl⟩, ?_⟩)⟩
      intro x₁' hx₁' hcl p
      obtain ⟨𝔭', rfl⟩ := Scheme.Hom.mem_opensRange.mp hx₁'
      have hr' : r₁ (e none 𝔭') = Spec.map (CommRingCat.ofHom φ0) 𝔭' := by
        rw [← Scheme.Hom.comp_apply, he_comp none]
        rfl
      rw [hr'] at hcl ⊢
      have hπ𝔭 := CP (wcQmbtChartNone A' n (c.map ιA)) φ0 hφ0.2.1 𝔭' hcl
      show φ0 (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ∈
        PrimeSpectrum.asIdeal 𝔭'
      have hC : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n (c.map ιA)) (MvPolynomial.C π') =
          algebraMap A' (wcQmbtChartNone A' n (c.map ιA)) π' := by
        rw [← MvPolynomial.algebraMap_eq]
        exact Ideal.Quotient.mk_algebraMap A' (wcQmbtChartNoneIdeal A' n (c.map ιA)) π'
      rw [hθX p, hφ0.1 p, map_mul, hC, mul_comm]
      exact Ideal.mul_mem_left _ _ hπ𝔭
    | some j =>
      haveI := he_open (some j)
      obtain ⟨h, ψ, hh, hψ, hψe, hdp⟩ := wc_qmbt_bm_chart_coords hπ' hn2 hc' j y
      obtain ⟨W, gW, h1, h2, h3, hq⟩ :=
        @key (wcQmbtChart A' n π' (c.map ιA) j) _ _ (e (some j)) (he_open (some j)) (φs j)
          (he_comp (some j)) (hφs j).2.1 y h ψ hh hψ hψe
      refine ⟨W, gW, h1, h2, h3, ?_⟩
      by_cases hs : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
          (MvPolynomial.X none) ∈ PrimeSpectrum.asIdeal y
      · by_cases hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' (c.map ιA) j)
            (MvPolynomial.X (some j)) ∈ PrimeSpectrum.asIdeal y
        · refine Or.inl (fun w hw => ?_)
          obtain ⟨q, hq1, hq2⟩ := hq w hw
          rw [hq2]
          exact ⟨(hdp hs hx q hq1).1, (hdp hs hx q hq1).2⟩
        · refine Or.inr (Or.inl ⟨j, ?_⟩)
          have hr : r₁ (e (some j) y) = Spec.map (CommRingCat.ofHom (φs j)) y := by
            rw [← Scheme.Hom.comp_apply, he_comp (some j)]
            rfl
          rw [hr]
          show φs j (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))) ∉
            PrimeSpectrum.asIdeal y
          rw [hθX j, (hφs j).1 j, show wcQmbtChartHat (A' := A') j j = 1 from if_pos rfl,
            mul_one]
          exact hx
      · obtain ⟨N₁, hxN₁, hN₁⟩ := @nbhd (wcQmbtChart A' n π' (c.map ιA) j) _ (e (some j))
          (he_open (some j)) _ y hs
        refine Or.inr (Or.inr ⟨N₁, hxN₁, ?_⟩)
        intro x₁' hx₁' hcl p
        obtain ⟨𝔭', h𝔭', hs'⟩ := hN₁ x₁' hx₁'
        let y' : ↥(Spec (wcQmbtCharts A' n π' (c.map ιA) (some j))) := 𝔭'
        have he' : e (some j) y' = x₁' := h𝔭'
        have hr' : r₁ x₁' = Spec.map (CommRingCat.ofHom (φs j)) y' := by
          rw [← he', ← Scheme.Hom.comp_apply, he_comp (some j)]
          rfl
        rw [hr'] at hcl ⊢
        have hπ𝔭 := CP (wcQmbtChart A' n π' (c.map ιA) j) (φs j) (hφs j).2.1 𝔭' hcl
        have hx' := s_off j 𝔭' hs' hπ𝔭
        show φs j (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ∈
          PrimeSpectrum.asIdeal 𝔭'
        rw [hθX p, (hφs j).1 p, map_mul, mul_comm]
        exact Ideal.mul_mem_left _ _ hx'

  have transfer : ∀ (W : X₁.Opens)
      (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
      WeaklyEtale gW →
      gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) →
      WeaklyEtale ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) ∧
      ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) ≫
          Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        (Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι ≫ (Limits.pullback.snd r₁ gP ≫
          Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) := by
    intro W gW hgW hcomm
    refine ⟨inferInstance, ?_⟩
    rw [Category.assoc, hcomm, morphismRestrict_ι_assoc, Limits.pullback.condition_assoc, hgP2]
  have hpt : ∀ (W : X₁.Opens) (xU : ↥(Limits.pullback.fst r₁ gP ⁻¹ᵁ W).toScheme),
      W.ι ((Limits.pullback.fst r₁ gP ∣_ W) xU) =
        Limits.pullback.fst r₁ gP ((Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι xU) := by
    intro W xU
    have e1 := congrArg (fun φ => φ xU) (morphismRestrict_ι (Limits.pullback.fst r₁ gP) W)
    exact (Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))

  have I1 : ∀ x : ↥(Limits.pullback r₁ gP : Scheme.{u}),
      a₀ ((Limits.pullback.snd r₁ gP ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) =
      Spec.map (CommRingCat.ofHom θ) (r₁ (Limits.pullback.fst r₁ gP x)) := by
    intro x
    have h : Limits.pullback.snd r₁ gP ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ =
        Limits.pullback.fst r₁ gP ≫ r₁ ≫ Spec.map (CommRingCat.ofHom θ) := by
      rw [← hgP1, ← Limits.pullback.condition_assoc]
    have := congrArg (fun φ => φ x) h
    simpa only [Scheme.Hom.comp_apply] using this
  have I2 : ∀ x : ↥(Limits.pullback r₁ gP : Scheme.{u}),
      (Limits.pullback.snd r₁ gP ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x =
      Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
        (r₁ (Limits.pullback.fst r₁ gP x)) := by
    intro x
    have h : Limits.pullback.snd r₁ gP ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) =
        Limits.pullback.fst r₁ gP ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
      rw [← hgP2, ← Limits.pullback.condition_assoc]
    have := congrArg (fun φ => φ x) h
    simpa only [Scheme.Hom.comp_apply] using this
  refine ⟨Limits.pullback r₁ gP, Limits.pullback.snd r₁ gP ≫
      Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)),
    Limits.pullback.snd r₁ gP, ?_, rfl, ?_⟩
  ·
    convert hbl using 4
    funext i
    cases i with
    | none =>
      show (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π') =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π'))
      rw [← hgP2, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
      congr 1
      have := congrArg (fun φ => φ.hom π') (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    | some j =>
      show ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))) =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X j)))
      rw [← hgP1, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, ← hθX j]
      congr 1
      have := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X j))) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
  ·
    intro x
    obtain ⟨W, gW, hxW, hgW, hcomm, hT⟩ := local_chart (Limits.pullback.fst r₁ gP x)
    obtain ⟨t1, t2⟩ := transfer W gW hgW hcomm
    have hxW' : x ∈ Limits.pullback.fst r₁ gP ⁻¹ᵁ W := hxW
    let xU : ↥(Limits.pullback.fst r₁ gP ⁻¹ᵁ W).toScheme := ⟨x, hxW'⟩
    have hxU : (Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι xU = x := Scheme.Opens.ι_apply _ _
    refine ⟨Limits.pullback.fst r₁ gP ⁻¹ᵁ W, n - 2, (Limits.pullback.fst r₁ gP ∣_ W) ≫ gW,
      xU, hxU, t1, t2, ?_⟩
    have hgy : ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) xU =
        gW ((Limits.pullback.fst r₁ gP ∣_ W) xU) := Scheme.Hom.comp_apply _ _ _
    rcases hT with hT1 | ⟨p, hp⟩ | ⟨N₁, hxN₁, hN₁⟩
    · left
      rw [hgy]
      exact hT1 _ ((Scheme.Opens.ι_apply W _).symm.trans ((hpt W xU).trans
        (congrArg (Limits.pullback.fst r₁ gP) hxU)))
    · right
      left
      refine ⟨p, ?_⟩
      rw [I1 x]
      exact hp
    · right
      right
      have hxN : x ∈ Limits.pullback.fst r₁ gP ⁻¹ᵁ N₁ := hxN₁
      refine ⟨Limits.pullback.fst r₁ gP ⁻¹ᵁ N₁, hxN, ?_⟩
      intro x' hx' hcl q
      rw [I2 x'] at hcl
      rw [I1 x']
      exact hN₁ (Limits.pullback.fst r₁ gP x') hx' hcl q

theorem wc_qmbt_yrc_double_charts {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {Y : Scheme.{u}} (iY : Y ⟶ Xs') [IsClosedImmersion iY]
    (hYset : Set.range iY =
      closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})
    (w : Xs') (hw : w ∈ Set.range iY) :
    ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
      (y : U.toScheme),
      U.ι y = ι' w ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) :=
by
  classical
  obtain ⟨Xm₀, f₀, bl₀, hbl₀, hblf₀, hcov₀⟩ :=
    wc_qmbt_yrc_model_dichotomy hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen
  obtain ⟨hcp, huniq⟩ := wc_qmbt_hl_b0_origin_fibre hπ hx₀ hsh

  obtain ⟨φ, hφ, -⟩ := hbl₀.2 Xm bl hbl.1
  obtain ⟨ψ, hψ, -⟩ := hbl.2 Xm₀ bl₀ hbl₀.1
  have h1 : φ ≫ ψ = 𝟙 Xm := by
    apply (hbl.2 Xm bl hbl.1).unique
    · simp only [Category.assoc, hψ, hφ]
    · simp only [Category.id_comp]
  have h2 : ψ ≫ φ = 𝟙 Xm₀ := by
    apply (hbl₀.2 Xm₀ bl₀ hbl₀.1).unique
    · simp only [Category.assoc, hφ, hψ]
    · simp only [Category.id_comp]
  haveI : IsIso φ := ⟨⟨ψ, h1, h2⟩⟩
  have hf : φ ≫ f₀ = f := by
    rw [← hblf₀, ← Category.assoc, hφ, hblf]
  have hβ : ∀ v : Xs', (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) v =
      (bl₀ ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) (φ (ι' v)) := by
    intro v
    rw [← hφ]
    simp only [Scheme.Hom.comp_apply]

  rw [hYset] at hw
  obtain ⟨hwcl, hwZ⟩ := hw
  have hwZ' : (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) w = IsLocalRing.closedPoint B₀ := hwZ

  have hsp : ∀ v : Xs', f (ι' v) = IsLocalRing.closedPoint A' := by
    intro v
    have e1 : f (ι' v) = wcQmSp A' (s' v) := by
      rw [← Scheme.Hom.comp_apply, hps'.w, Scheme.Hom.comp_apply]
    rw [e1]
    apply PrimeSpectrum.ext
    show Ideal.comap (IsLocalRing.residue A') (PrimeSpectrum.asIdeal (s' v)) =
      IsLocalRing.maximalIdeal A'
    haveI hpr : (PrimeSpectrum.asIdeal (s' v)).IsPrime :=
      PrimeSpectrum.isPrime (R := IsLocalRing.ResidueField A') (s' v)
    rw [Ideal.eq_bot_of_prime (PrimeSpectrum.asIdeal (s' v))]
    exact IsLocalRing.ker_residue

  obtain ⟨U₀, r, g₀, y₀, hy₀, hg₀, heq, hD⟩ := hcov₀ (φ (ι' w))
  rcases hD with ⟨hd0, hd1⟩ | ⟨p, hp⟩ | ⟨N, hxN, hN⟩
  ·
    haveI := hg₀
    have hxU₀ : φ (ι' w) ∈ U₀ := by
      have e : U₀.ι y₀ = y₀.1 := Scheme.Opens.ι_apply _ _
      rw [← hy₀, e]
      exact y₀.2
    have hmem : ι' w ∈ φ ⁻¹ᵁ U₀ := (Scheme.Hom.mem_preimage φ).mpr hxU₀
    let yU : (φ ⁻¹ᵁ U₀).toScheme := ⟨ι' w, hmem⟩
    have hyU : (φ ⁻¹ᵁ U₀).ι yU = ι' w := Scheme.Opens.ι_apply _ _
    have hres : (φ ∣_ U₀) yU = y₀ := by
      have e1 := congrArg (fun k => k yU) (morphismRestrict_ι φ U₀)
      have e2 : U₀.ι ((φ ∣_ U₀) yU) = U₀.ι y₀ :=
        ((Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))).trans
          ((congrArg φ hyU).trans hy₀.symm)
      exact U₀.ι.isOpenEmbedding.injective e2
    have hgy : ((φ ∣_ U₀) ≫ g₀) yU = g₀ y₀ :=
      (Scheme.Hom.comp_apply _ _ _).trans (congrArg g₀ hres)
    refine ⟨φ ⁻¹ᵁ U₀, r, (φ ∣_ U₀) ≫ g₀, yU, hyU, inferInstance, ?_, ?_, ?_⟩
    · rw [Category.assoc, heq, ← Category.assoc, morphismRestrict_ι, Category.assoc, hf]
    · rw [hgy]; exact hd0
    · rw [hgy]; exact hd1
  ·
    exfalso
    apply hp
    rw [← hβ w, hwZ']
    exact hcp p
  ·
    exfalso
    let O : Xs'.Opens := ι' ⁻¹ᵁ (φ ⁻¹ᵁ N)
    have hwO : w ∈ O :=
      (Scheme.Hom.mem_preimage ι').mpr ((Scheme.Hom.mem_preimage φ).mpr hxN)
    obtain ⟨w', hw'O, hw'Z⟩ := mem_closure_iff.mp hwcl (O : Set Xs') O.isOpen hwO
    have hφN : φ (ι' w') ∈ N :=
      (Scheme.Hom.mem_preimage φ).mp ((Scheme.Hom.mem_preimage ι').mp hw'O)
    have hf₀ : f₀ (φ (ι' w')) = IsLocalRing.closedPoint A' := by
      rw [← Scheme.Hom.comp_apply, hf]
      exact hsp w'
    have hall := hN _ hφN hf₀
    have hb : ∀ q, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X q) ∈
        PrimeSpectrum.asIdeal (a₀ ((ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) w')) := by
      intro q
      rw [hβ w']
      exact hall q
    exact hw'Z (huniq _ hb)

theorem wc_qmbt_yrc_double_tube_et_counts {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (hℓ' : IsUnit ((ℓ : ℕ) : A')) {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)]
    (cC : Spec (.of C) ⟶ Xm) (hcC : WeaklyEtale cC)
    (U : Xm.Opens) (r : ℕ)
    (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
    (y : U.toScheme) (hy : U.ι y = cC (IsLocalRing.closedPoint C)) (hg : WeaklyEtale g)
    (hgf : g ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
      U.ι ≫ f)
    (h0 : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y))
    (h1 : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y))
    (TC : Scheme.{u}) (t₁ : TC ⟶ Spec (.of C)) (t₂ : TC ⟶ XE') (hTC : IsPullback t₂ t₁ p' cC) :
    IsAffine TC ∧ (∀ k j : ℕ, 1 ≤ k → Finite (wcEtCoh TC (ℓ ^ k) j)) ∧
      (∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh TC (ℓ ^ k) 0) = ℓ ^ k ∧
        Nat.card (wcEtCoh TC (ℓ ^ k) 1) = ℓ ^ k) ∧
      Subsingleton (wcEtCoh TC ℓ 2) :=
by
  classical

  have hxU : cC (IsLocalRing.closedPoint C) ∈ U := by
    have hmem : cC (IsLocalRing.closedPoint C) ∈ Set.range U.ι := ⟨y, hy⟩
    rwa [Scheme.Opens.range_ι] at hmem
  have hrange : Set.range cC ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨t, rfl⟩
    exact ((IsLocalRing.specializes_closedPoint t).map cC.continuous).mem_open U.isOpen hxU
  obtain ⟨c'', hfac⟩ : ∃ c'' : Spec (.of C) ⟶ U.toScheme, c'' ≫ U.ι = cC :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
  have hWc'' : WeaklyEtale c'' :=
    MorphismProperty.of_postcomp (W := (@WeaklyEtale : MorphismProperty Scheme.{u}))
      (W' := (@WeaklyEtale : MorphismProperty Scheme.{u})) c'' U.ι
      (show WeaklyEtale U.ι from inferInstance) (by rw [hfac]; exact hcC)
  obtain ⟨cq, hcdef⟩ : ∃ cq : Spec (.of C) ⟶
      Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))),
      c'' ≫ g = cq := ⟨_, rfl⟩
  have hWc : WeaklyEtale cq := by
    rw [← hcdef]
    haveI := hWc''
    haveI := hg
    infer_instance
  have hcf : cC ≫ f = cq ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) := by
    rw [← hcdef, ← hfac]
    simp only [Category.assoc, hgf]
  have hc''y : c'' (IsLocalRing.closedPoint C) = y := by
    apply U.ι.isOpenEmbedding.injective
    have h3 := Scheme.Hom.comp_apply c'' U.ι (IsLocalRing.closedPoint C)
    rw [hfac] at h3
    exact h3.symm.trans hy.symm
  have hcy : cq (IsLocalRing.closedPoint C) = g y := by
    have h4 := Scheme.Hom.comp_apply c'' g (IsLocalRing.closedPoint C)
    rw [hcdef] at h4
    exact h4.trans (congrArg g hc''y)
  have hx0 : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (cq (IsLocalRing.closedPoint C)) := by
    rw [hcy]; exact h0
  have hx1 : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (cq (IsLocalRing.closedPoint C)) := by
    rw [hcy]; exact h1

  have hpb : IsPullback t₁ (t₂ ≫ q') (cq ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) := by
    have hP0 := (IsPullback.paste_horiz hTC hpb'.flip).flip
    rw [hcf] at hP0
    exact hP0

  have K1 : ∀ (m : ℕ) (h1 : 1 < m),
      (∑ p : Fin m, ∑ q : Fin m, MvPolynomial.C ((Matrix.of fun i j : Fin m =>
        if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin m) A') = MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, h1⟩ := by
    intro m h1
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin m)]
    · rw [Finset.sum_eq_single (⟨1, h1⟩ : Fin m)]
      · simp
      · intro q _ hq
        have : q.val ≠ 1 := fun h => hq (Fin.ext h)
        simp [this]
      · intro h; exact absurd (Finset.mem_univ _) h
    · intro p _ hp
      have : p.val ≠ 0 := fun h => hp (Fin.ext h)
      apply Finset.sum_eq_zero
      intro q _
      simp [this]
    · intro h; exact absurd (Finset.mem_univ _) h
  have relH : ∀ (m : ℕ) (h1 : 1 < m),
      Ideal.Quotient.mk (wcQuadModelIdeal A' m π' (Matrix.of fun i j : Fin m =>
        if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (MvPolynomial.X ⟨0, by omega⟩) *
      Ideal.Quotient.mk (wcQuadModelIdeal A' m π' (Matrix.of fun i j : Fin m =>
        if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (MvPolynomial.X ⟨1, h1⟩) =
      algebraMap A' (wcQuadModelRing A' m π' (Matrix.of fun i j : Fin m =>
        if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) π' := by
    intro m h1
    have hmem : (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, h1⟩ - MvPolynomial.C π' :
        MvPolynomial (Fin m) A') ∈ wcQuadModelIdeal A' m π' (Matrix.of fun i j : Fin m =>
          if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) := by
      rw [← K1 m h1]
      exact Ideal.subset_span (Set.mem_singleton _)
    have := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rw [map_sub, map_mul, sub_eq_zero] at this
    rw [this, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hy₀ : wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
      (cq (IsLocalRing.closedPoint C)) = IsLocalRing.closedPoint A' := by
    have hrel := relH (r + 2) (by omega)
    have hπy : algebraMap A' (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) π' ∈
        PrimeSpectrum.asIdeal (cq (IsLocalRing.closedPoint C)) := by
      rw [← hrel]
      exact Ideal.mul_mem_right _ _ hx0
    have hmem : π' ∈ (wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
        (cq (IsLocalRing.closedPoint C))).asIdeal := by
      show π' ∈ (Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
        (cq (IsLocalRing.closedPoint C))).asIdeal
      rw [Spec.map_apply]
      first
        | exact hπy
        | exact (Ideal.mem_comap).mpr hπy
        | (erw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]; exact hπy)
    apply PrimeSpectrum.ext
    apply le_antisymm
    · show _ ≤ IsLocalRing.maximalIdeal A'
      exact IsLocalRing.le_maximalIdeal (wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
        (cq (IsLocalRing.closedPoint C))).isPrime.ne_top
    · show IsLocalRing.maximalIdeal A' ≤ _
      rw [hπ', Ideal.span_le, Set.singleton_subset_iff]
      exact hmem

  obtain ⟨B'', _, _, _, Λ'', _, _, W'', φ'', a'', e'', hI'', haff'', hcomp'', hφa'', hlim'', hint'',
    heq''⟩ := wc_et_geom_strict_henselization (cq (IsLocalRing.closedPoint C))
  have hsh'' : wcHalShData (cq (IsLocalRing.closedPoint C)) B'' Λ'' W'' φ'' a'' :=
    ⟨hI'', haff'', hcomp'', hφa'', hlim'', e'', hint'', heq''⟩

  obtain ⟨ψ, hψdef⟩ : ∃ ψ : A' →+* AlgebraicClosure L',
      ψ = (algebraMap L' (AlgebraicClosure L')).comp φ' := ⟨_, rfl⟩
  have hψ : Function.Injective ψ := by
    rw [hψdef]
    exact (algebraMap L' (AlgebraicClosure L')).injective.comp hφ'
  obtain ⟨hfinM, hcardM, hsubM⟩ := wc_qmssl_double_milnor_et_counts A' ℓ hℓ' π' hπ' r
    (cq (IsLocalRing.closedPoint C)) hy₀ hx0 hx1 B'' Λ'' W'' φ'' a'' hsh'' (AlgebraicClosure L')
    ψ hψ
  haveI hconn := wc_qmssl_mfc_double A' ℓ hℓ' π' hπ' r
    (cq (IsLocalRing.closedPoint C)) hy₀ hx0 hx1 B'' Λ'' W'' φ'' a'' hsh'' (AlgebraicClosure L')
    ψ hψ
  have h0M : ∀ k : ℕ, Nat.card (wcEtCoh (Limits.pullback
      (a'' ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom ψ))) (ℓ ^ k) 0) = ℓ ^ k := fun k =>
    wc_et_coh_zero_connected_card _ (ℓ ^ k) (pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero)

  have hresG : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (x : Spec (.of (IsLocalRing.ResidueField R))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) x = IsLocalRing.closedPoint R := by
    intro R _ _ x
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue R))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField R)) x _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue R)).mp inferInstance)
  obtain ⟨ε, -, hε⟩ := wc_pltr_wet_residue_geom_point (cq (IsLocalRing.closedPoint C)) C cq hWc rfl
  have hq1 : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue C)))
      (IsLocalRing.closedPoint (AlgebraicClosure ((Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))).residueField
        (cq (IsLocalRing.closedPoint C))))) =
      IsLocalRing.closedPoint C :=
    (Scheme.Hom.comp_apply _ _ _).trans (hresG C _)
  have hq2 : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))) ≫ cq =
      wcEtGeomPt (Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
        (cq (IsLocalRing.closedPoint C)) :=
    (Category.assoc _ _ _).trans hε
  obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point (cq (IsLocalRing.closedPoint C)) B'' Λ'' W'' φ''
    a'' hsh'' C cq _ hq1 hq2
  haveI hδiso : IsIso δ := wc_pltr_shens_lift_iso (cq (IsLocalRing.closedPoint C)) B'' Λ'' W'' φ''
    a'' hsh'' C cq hWc rfl δ hδ

  have hσξ : Spec.map (CommRingCat.ofHom (algebraMap L' (AlgebraicClosure L'))) ≫
      Spec.map (CommRingCat.ofHom φ') = Spec.map (CommRingCat.ofHom ψ) := by
    rw [hψdef, CommRingCat.ofHom_comp, Spec.map_comp]
  have hP := IsPullback.paste_horiz
    (IsPullback.of_hasPullback (t₂ ≫ q')
      (Spec.map (CommRingCat.ofHom (algebraMap L' (AlgebraicClosure L')))))
    hpb
  rw [hσξ] at hP
  have e₃ : (cq ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) ≫ 𝟙 _ =
      δ ≫ (a'' ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) := by
    rw [Category.comp_id, ← Category.assoc, hδ]
  have e₄ : Spec.map (CommRingCat.ofHom ψ) ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom ψ) := by
    rw [Category.comp_id, Category.id_comp]
  haveI := Limits.pullback.map_isIso (cq ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    (Spec.map (CommRingCat.ofHom ψ))
    (a'' ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    (Spec.map (CommRingCat.ofHom ψ)) δ (𝟙 _) (𝟙 _) e₃ e₄
  let J := hP.isoPullback ≪≫ asIso (Limits.pullback.map (cq ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    (Spec.map (CommRingCat.ofHom ψ))
    (a'' ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    (Spec.map (CommRingCat.ofHom ψ)) δ (𝟙 _) (𝟙 _) e₃ e₄)
  have E : ∀ m k : ℕ, Nonempty (wcEtCoh TC m k ≃ wcEtCoh (Limits.pullback
      (a'' ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom ψ))) m k) := by
    intro m k
    obtain ⟨e2⟩ := wc_et_coh_purely_inseparable_invariance L' (AlgebraicClosure L')
      (algebraMap_isIntegral_iff.mpr inferInstance) TC (t₂ ≫ q') m k
    obtain ⟨eJ⟩ := wc_et_coh_iso_invariance J.hom m k
    exact ⟨e2.symm.trans eJ.symm⟩

  have hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcEtCoh TC (ℓ ^ k) j) := by
    intro k j hk
    haveI := hfinM k j hk
    exact Finite.of_equiv _ (E (ℓ ^ k) j).some.symm
  have hcard : ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh TC (ℓ ^ k) 0) = ℓ ^ k ∧
      Nat.card (wcEtCoh TC (ℓ ^ k) 1) = ℓ ^ k := fun k hk =>
    ⟨(Nat.card_congr (E (ℓ ^ k) 0).some).trans (h0M k),
      (Nat.card_congr (E (ℓ ^ k) 1).some).trans (hcardM k hk)⟩
  have htop : Subsingleton (wcEtCoh TC ℓ (1 + 1)) := by
    haveI := hsubM
    exact (E ℓ (1 + 1)).some.subsingleton
  haveI : IsAffine TC := IsAffine.of_isIso hpb.isoPullback.hom
  exact ⟨inferInstance, hfin, hcard, htop⟩

theorem wc_qmbt_yrc_proet_counts_of_et (Y : Scheme.{u}) [IsAffine Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcEtCoh Y (ℓ ^ k) j))
    (hcard : ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Y (ℓ ^ k) 0) = ℓ ^ k ∧
      Nat.card (wcEtCoh Y (ℓ ^ k) 1) = ℓ ^ k)
    (hsub : Subsingleton (wcEtCoh Y ℓ 2)) :
    (∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j)) ∧
      (∀ k : ℕ, 1 ≤ k → Nat.card (wcZModProEtExt Y (ℓ ^ k) 0) = ℓ ^ k ∧
        Nat.card (wcZModProEtExt Y (ℓ ^ k) 1) = ℓ ^ k ∧
        IsAddCyclic (wcZModProEtExt Y (ℓ ^ k) 1)) ∧
      Subsingleton (wcZModProEtExt Y ℓ 2) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hℓp.pos
  haveI hcY : CompactSpace Y := inferInstance
  haveI hqY : QuasiSeparatedSpace Y := inferInstance
  have EP : ∀ m j : ℕ, Nonempty (wcZModProEtExt Y m j ≃ wcEtCoh Y m j) := by
    intro m j
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all.{u} m j
    obtain ⟨Ez⟩ := wc_et_zmodext_coh_equiv Y m j
    exact ⟨(Equiv.ofBijective (Θ Y) (hΘ Y hcY hqY)).symm.trans Ez⟩
  have hPEfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j) := by
    intro k j hk
    haveI := hfin k j hk
    exact Finite.of_equiv _ (EP (ℓ ^ k) j).some.symm
  have hPE0 : ∀ k : ℕ, 1 ≤ k → Nat.card (wcZModProEtExt Y (ℓ ^ k) 0) = ℓ ^ k := fun k hk =>
    (Nat.card_congr (EP (ℓ ^ k) 0).some).trans (hcard k hk).1
  have hPE1 : ∀ k : ℕ, 1 ≤ k → Nat.card (wcZModProEtExt Y (ℓ ^ k) 1) = ℓ ^ k := fun k hk =>
    (Nat.card_congr (EP (ℓ ^ k) 1).some).trans (hcard k hk).2
  have hPE2 : Subsingleton (wcZModProEtExt Y ℓ 2) := @Equiv.subsingleton _ _ (EP ℓ 2).some hsub
  let U : Y.ProEt := Scheme.ProEt.mk (𝟙 Y)
  have Em : ∀ m : ℕ, 0 < m → ∀ j : ℕ,
      Nonempty (wcZModProEtExt Y m j ≃+ Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y m) j) := by
    intro m hm j
    obtain ⟨Φ, hΦb, -, -⟩ := wc_proet_free_zmod_ext_mod_model.{u} m j hm
    exact ⟨AddEquiv.ofBijective (Φ Y U) (hΦb Y U)⟩
  obtain ⟨E1⟩ := Em ℓ hℓpos 1
  obtain ⟨E2⟩ := Em ℓ hℓpos (1 + 1)
  have hf1 : Finite (wcZModProEtExt Y ℓ 1) := by
    have hf := hPEfin 1 1 le_rfl
    rwa [pow_one] at hf
  have hc1 : Nat.card (wcZModProEtExt Y ℓ 1) = ℓ := by
    have hc := hPE1 1 le_rfl
    rwa [pow_one] at hc
  have h1 : Finite (Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y ℓ) 1) :=
    Finite.of_equiv _ E1.toEquiv
  have h2 : Nat.card (Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y ℓ) 1) ≤ ℓ := by
    rw [← Nat.card_congr E1.toEquiv]
    exact hc1.le
  have h3 : ∀ z : Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y ℓ) (1 + 1), z = 0 := by
    haveI : Subsingleton (wcZModProEtExt Y ℓ (1 + 1)) := hPE2
    intro z
    rw [← E2.apply_symm_apply z, Subsingleton.elim (E2.symm z) 0, map_zero]
  have h4 : ∀ n : ℕ, 1 ≤ n → Finite (Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ n)) 1) →
      ℓ ^ n ≤ Nat.card (Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ n)) 1) := by
    intro n hn _
    obtain ⟨En⟩ := Em (ℓ ^ n) (pow_pos hℓpos n) 1
    rw [← Nat.card_congr En.toEquiv]
    exact le_of_eq (hPE1 n hn).symm
  obtain ⟨hcnt, -, -⟩ := wc_local_tower_counts Y ℓ (wcFreeSheaf Y U) 1 h1 h2 h3 h4
  have hkill : ∀ (n : ℕ) (t : Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ n)) 1),
      ℓ ^ n • t = 0 := by
    intro n t
    have hc' : Nat.card (Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ n)) 1) = ℓ ^ n :=
      (hcnt n).2
    have h := card_nsmul_eq_zero' (G := Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ n)) 1)
      (x := t)
    rw [hc'] at h
    exact h
  have hcyc := wc_zmod_local_nakayama_cyclic Y ℓ (wcFreeSheaf Y U) 1 h1 h2 h3 hkill
  have cyc : ∀ k : ℕ, 1 ≤ k → IsAddCyclic (wcZModProEtExt Y (ℓ ^ k) 1) := by
    intro k _
    obtain ⟨E⟩ := Em (ℓ ^ k) (pow_pos hℓpos k) 1
    obtain ⟨y₀, hy₀⟩ := hcyc k
    refine IsAddCyclic.mk ⟨E.symm y₀, fun x => ?_⟩
    obtain ⟨z, hz⟩ := hy₀ (E x)
    refine ⟨z, ?_⟩
    show z • E.symm y₀ = x
    rw [← map_zsmul, ← hz, AddEquiv.symm_apply_apply]
  exact ⟨hPEfin, fun k hk => ⟨hPE0 k hk, hPE1 k hk, cyc k hk⟩, hPE2⟩

theorem wc_qmbt_yrc_tube_counts {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {Y : Scheme.{u}} (iY : Y ⟶ Xs') [IsClosedImmersion iY]
    (hYset : Set.range iY =
      closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀}) :
    ∀ (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (cC : Spec (.of C) ⟶ Xm), WeaklyEtale cC →
      cC (IsLocalRing.closedPoint C) ∈ Set.range (iY ≫ ι') →
      ∀ (TC : Scheme.{u}) (t₁ : TC ⟶ Spec (.of C)) (t₂ : TC ⟶ XE'), IsPullback t₂ t₁ p' cC →
      (∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt TC (ℓ ^ k) j)) ∧
      (∀ k : ℕ, 1 ≤ k → Nat.card (wcZModProEtExt TC (ℓ ^ k) 0) = ℓ ^ k ∧
        Nat.card (wcZModProEtExt TC (ℓ ^ k) 1) = ℓ ^ k ∧
        IsAddCyclic (wcZModProEtExt TC (ℓ ^ k) 1)) ∧
      Subsingleton (wcZModProEtExt TC ℓ 2) :=
by
  intro C _ _ _ cC hcC hcY TC t₁ t₂ hTC
  obtain ⟨y₀, hy₀⟩ := hcY
  obtain ⟨U, r, g, y, hUy, hg, hgf, h0, h1⟩ := wc_qmbt_yrc_double_charts hℓ hn hn4 hπ hc hx₀
    hsh hℓ' hπ' hπ'2 hgen hbl hblf hps' iY hYset (iY y₀) ⟨y₀, rfl⟩
  have hy : U.ι y = cC (IsLocalRing.closedPoint C) := by
    rw [hUy, ← hy₀, Scheme.Hom.comp_apply]
  obtain ⟨haff, hfin, hcard, hsub⟩ := wc_qmbt_yrc_double_tube_et_counts hℓ' hπ' hφ' hpb' C cC
    hcC U r g y hy hg hgf h0 h1 TC t₁ t₂ hTC
  haveI := haff
  exact wc_qmbt_yrc_proet_counts_of_et TC ℓ hfin hcard hsub

theorem wc_qmbt_nlp_kummer_reduce : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] (F L' : Type u)
    [Field F] [Field L'] [Algebra A' F] [Algebra A' L'] [FaithfulSMul A' F] [FaithfulSMul A' L']
    [Algebra.IsAlgebraic A' L'] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : F) ≠ 0 →
    ∀ (x : F), x ≠ 0 → ∀ (b : TensorProduct A' F L'), b ^ ℓ = x ⊗ₜ 1 →
    letI := FractionRing.liftAlgebra A' F;
    ∃ (L₁ : Type u) (_ : Field L₁) (_ : Algebra (FractionRing A') L₁),
      FiniteDimensional (FractionRing A') L₁ ∧ IsGalois (FractionRing A') L₁ ∧
      ∃ b₁ : TensorProduct (FractionRing A') F L₁, b₁ ^ ℓ = x ⊗ₜ 1 :=
by
  intro A' _ _ F L' _ _ _ _ _ _ _ ℓ hℓ hℓF x hx b hb
  classical
  letI := FractionRing.liftAlgebra A' F
  letI := FractionRing.liftAlgebra A' L'

  have Hinj : ∀ (E L : Type u) [Field E] [Field L] [Algebra (FractionRing A') E]
      [Algebra (FractionRing A') L] (g : E →ₐ[FractionRing A'] L),
      Function.Injective (Algebra.TensorProduct.map (AlgHom.id (FractionRing A') F) g) := by
    intro E L _ _ _ _ g
    have e : (Algebra.TensorProduct.map (AlgHom.id (FractionRing A') F) g).toLinearMap =
        LinearMap.lTensor F g.toLinearMap := by
      apply TensorProduct.ext'
      intro a c
      simp
    have h2 := Module.Flat.lTensor_preserves_injective_linearMap (M := F) g.toLinearMap
      g.injective
    rw [← e] at h2
    exact h2

  obtain ⟨b', hb'⟩ : ∃ b' : TensorProduct (FractionRing A') F L', b' ^ ℓ = x ⊗ₜ 1 := by
    refine ⟨Algebra.TensorProduct.mapOfCompatibleSMul (FractionRing A') A' A' F L' b, ?_⟩
    rw [← map_pow, hb, Algebra.TensorProduct.mapOfCompatibleSMul_tmul]
  haveI : Algebra.IsAlgebraic (FractionRing A') L' :=
    Algebra.IsAlgebraic.extendScalars (R := A') (IsFractionRing.injective A' (FractionRing A'))

  obtain ⟨E₀, hE₀, b₀, hb₀⟩ : ∃ E : IntermediateField (FractionRing A') L',
      FiniteDimensional (FractionRing A') E ∧
      ∃ b₀ : TensorProduct (FractionRing A') F E, b₀ ^ ℓ = x ⊗ₜ 1 := by
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset b'
    refine ⟨IntermediateField.adjoin (FractionRing A') ((S.image Prod.snd : Finset L') : Set L'),
      ?_, ?_⟩
    · exact IntermediateField.finiteDimensional_adjoin
        (fun y _ => (Algebra.IsAlgebraic.isAlgebraic y).isIntegral)
    · set E := IntermediateField.adjoin (FractionRing A') ((S.image Prod.snd : Finset L') : Set L')
        with hE
      have hmem : ∀ i ∈ S, i.2 ∈ E := fun i hi =>
        IntermediateField.subset_adjoin (FractionRing A') _
          (by rw [Finset.coe_image]; exact ⟨i, hi, rfl⟩)
      let b₀ : TensorProduct (FractionRing A') F E :=
        ∑ i ∈ S.attach, i.1.1 ⊗ₜ ⟨i.1.2, hmem i.1 i.2⟩
      have hι : Algebra.TensorProduct.map (AlgHom.id (FractionRing A') F) E.val b₀ = b' := by
        simp only [b₀, map_sum, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
          IntermediateField.val_mk]
        rw [hS]
        exact Finset.sum_attach S (fun i => i.1 ⊗ₜ[FractionRing A'] i.2)
      refine ⟨b₀, Hinj E L' E.val ?_⟩
      rw [map_pow, hι, hb', Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]

  haveI : Algebra.IsAlgebraic (FractionRing A') E₀ := Algebra.IsAlgebraic.of_finite _ _
  haveI : IsPurelyInseparable (separableClosure (FractionRing A') E₀) E₀ :=
    separableClosure.isPurelyInseparable (FractionRing A') E₀
  obtain ⟨q, hqK⟩ : ∃ q, ExpChar (FractionRing A') q := ⟨_, ringExpChar.expChar _⟩
  haveI := hqK
  haveI : Nontrivial (TensorProduct (FractionRing A') F E₀) :=
    (Algebra.TensorProduct.includeLeft_injective (S := FractionRing A') (A := F) (B := E₀)
      (algebraMap (FractionRing A') E₀).injective).nontrivial
  haveI : ExpChar (TensorProduct (FractionRing A') F E₀) q :=
    expChar_of_injective_algebraMap (algebraMap (FractionRing A') _).injective q
  have Hfrob : ∀ z : TensorProduct (FractionRing A') F E₀, ∃ n : ℕ,
      z ^ (q ^ n) ∈ (Algebra.TensorProduct.map (AlgHom.id (FractionRing A') F)
        (separableClosure (FractionRing A') E₀).val).range := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul f μ =>
      obtain ⟨n, ν, hν⟩ := IsPurelyInseparable.pow_mem (separableClosure (FractionRing A') E₀) q μ
      refine ⟨n, ⟨(f ^ q ^ n) ⊗ₜ ν, ?_⟩⟩
      rw [Algebra.TensorProduct.tmul_pow]
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.map_tmul,
        AlgHom.id_apply]
      rw [← hν]
      rfl
    | add z w hz hw =>
      obtain ⟨n, hn⟩ := hz
      obtain ⟨m, hm⟩ := hw
      refine ⟨n + m, ?_⟩
      have key : (z + w) ^ q ^ (n + m) = z ^ q ^ (n + m) + w ^ q ^ (n + m) :=
        add_pow_expChar_pow z w q (n + m)
      rw [key]
      have h1 : z ^ q ^ (n + m) = (z ^ q ^ n) ^ q ^ m := by rw [← pow_mul, ← pow_add]
      have h2 : w ^ q ^ (n + m) = (w ^ q ^ m) ^ q ^ n := by rw [← pow_mul, ← pow_add, add_comm m]
      rw [h1, h2]
      exact Subalgebra.add_mem _ (Subalgebra.pow_mem _ hn _) (Subalgebra.pow_mem _ hm _)
  obtain ⟨n, c, hc⟩ := Hfrob b₀
  simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hc
  have hcl : c ^ ℓ = (x ⊗ₜ 1) ^ (q ^ n) := by
    apply Hinj _ E₀ (separableClosure (FractionRing A') E₀).val
    rw [map_pow, map_pow, hc, ← pow_mul, mul_comm, pow_mul, hb₀, Algebra.TensorProduct.map_tmul,
      map_one, AlgHom.id_apply]
  have hco : Nat.Coprime ℓ (q ^ n) := by
    apply Nat.Coprime.pow_right
    rcases hqK with _ | ⟨hqp⟩
    · exact Nat.coprime_one_right ℓ
    · haveI : CharP F q := charP_of_injective_algebraMap (algebraMap (FractionRing A') F).injective q
      rw [Nat.coprime_primes hℓ.out hqp]
      rintro rfl
      exact hℓF (CharP.cast_eq_zero F ℓ)

  have Hroot : ∀ (M : Type u) [CommMonoid M] (u c : M), IsUnit u → ∀ (ℓ N : ℕ),
      Nat.Coprime ℓ N → c ^ ℓ = u ^ N → ∃ d : M, d ^ ℓ = u := by
    intro M _ u c hu ℓ N hco h
    rcases Nat.eq_zero_or_pos ℓ with rfl | hℓ
    · have hN : N = 1 := Nat.coprime_zero_left _ |>.mp hco
      subst hN
      exact ⟨1, by simpa using h⟩
    · have hc : IsUnit c := by
        have : IsUnit (c ^ ℓ) := h ▸ hu.pow N
        exact (isUnit_pow_iff hℓ.ne').mp this
      obtain ⟨U, rfl⟩ := hu
      obtain ⟨C, rfl⟩ := hc
      have hCU : C ^ (ℓ : ℤ) = U ^ (N : ℤ) := by
        rw [zpow_natCast, zpow_natCast]
        exact Units.ext (by simpa using h)
      have hbz : (1 : ℤ) = ℓ * ℓ.gcdA N + N * ℓ.gcdB N := by
        have := Nat.gcd_eq_gcd_ab ℓ N
        rw [hco.gcd_eq_one] at this
        exact_mod_cast this
      refine ⟨((U ^ (ℓ.gcdA N) * C ^ (ℓ.gcdB N) : Mˣ) : M), ?_⟩
      rw [← Units.val_pow_eq_pow_val]
      congr 1
      calc (U ^ ℓ.gcdA N * C ^ ℓ.gcdB N) ^ ℓ
          = (U ^ ℓ.gcdA N * C ^ ℓ.gcdB N) ^ (ℓ : ℤ) := (zpow_natCast _ _).symm
        _ = U ^ (ℓ.gcdA N * ℓ) * (C ^ (ℓ : ℤ)) ^ ℓ.gcdB N := by
          rw [mul_zpow, ← zpow_mul, ← zpow_mul, ← zpow_mul, mul_comm (ℓ.gcdB N)]
        _ = U ^ (ℓ.gcdA N * ℓ) * U ^ ((N : ℤ) * ℓ.gcdB N) := by rw [hCU, ← zpow_mul]
        _ = U ^ ((ℓ : ℤ) * ℓ.gcdA N + N * ℓ.gcdB N) := by
          rw [← zpow_add]; congr 1; ring
        _ = U := by rw [← hbz, zpow_one]
  have hu : IsUnit (x ⊗ₜ[FractionRing A'] (1 : separableClosure (FractionRing A') E₀)) := by
    have := (Ne.isUnit hx).map (Algebra.TensorProduct.includeLeftRingHom :
      F →+* TensorProduct (FractionRing A') F (separableClosure (FractionRing A') E₀))
    simpa [Algebra.TensorProduct.includeLeftRingHom_apply] using this
  obtain ⟨d, hd⟩ := Hroot _ _ c hu ℓ (q ^ n) hco hcl

  let σ : (separableClosure (FractionRing A') E₀) →ₐ[FractionRing A'] SeparableClosure (FractionRing A') := IsSepClosed.lift
  refine ⟨IntermediateField.normalClosure (FractionRing A') (separableClosure (FractionRing A') E₀) (SeparableClosure (FractionRing A')),
    inferInstance, inferInstance,
    normalClosure.is_finiteDimensional _ _ _, IsGalois.normalClosure _ _ _, ?_⟩
  let σ' : (separableClosure (FractionRing A') E₀) →ₐ[FractionRing A']
      IntermediateField.normalClosure (FractionRing A') (separableClosure (FractionRing A') E₀) (SeparableClosure (FractionRing A')) :=
    σ.codRestrict (IntermediateField.normalClosure (FractionRing A') (separableClosure (FractionRing A') E₀)
      (SeparableClosure (FractionRing A'))).toSubalgebra
      (fun y => AlgHom.fieldRange_le_normalClosure σ ⟨y, rfl⟩)
  refine ⟨Algebra.TensorProduct.map (AlgHom.id (FractionRing A') F) σ' d, ?_⟩
  rw [← map_pow, hd, Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]

theorem wc_qmbt_nlp_kummer_galois : ∀ (K F L₁ : Type u) [Field K] [Field F] [Field L₁] [Algebra K F]
    [Algebra K L₁] [FiniteDimensional K L₁] [IsGalois K L₁] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (ζ : K),
    IsPrimitiveRoot ζ ℓ → ∀ (x : F), x ≠ 0 → ∀ (b : TensorProduct K F L₁), b ^ ℓ = x ⊗ₜ 1 →
    ∃ m f : F, m ≠ 0 ∧ f ≠ 0 ∧ IsIntegral K m ∧ IsSeparable K m ∧ x = m * f ^ ℓ :=
by
  intro K F L₁ _ _ _ _ _ _ _ ℓ _ ζ hζ x hx b hb
  classical
  have main : ∀ (E : Type u) [Field E] [Algebra F E] [Algebra K E] [IsScalarTower K F E]
      (ι : L₁ →ₐ[K] E) (β : E), FiniteDimensional F E → Submodule.span F (Set.range ι) = ⊤ →
      β ^ ℓ = algebraMap F E x →
      ∃ m f : F, m ≠ 0 ∧ f ≠ 0 ∧ IsIntegral K m ∧ IsSeparable K m ∧ x = m * f ^ ℓ := by
    intro E _ _ _ _ ι β hfin hspan hβ
    haveI : FiniteDimensional F E := hfin

    have hgal : IsGalois F E := by
      obtain ⟨p, hpsep, hpspl⟩ := IsGalois.is_separable_splitting_field K L₁
      haveI := hpspl
      set q := p.map (algebraMap K F) with hq
      have hqsep : q.Separable := hpsep.map
      have hq0 : q ≠ 0 := hqsep.ne_zero
      have hsplit : (q.map (algebraMap F E)).Splits := by
        have : q.map (algebraMap F E) = (p.map (algebraMap K L₁)).map (ι : L₁ →+* E) := by
          rw [hq, Polynomial.map_map, Polynomial.map_map, ← IsScalarTower.algebraMap_eq,
            AlgHom.comp_algebraMap]
        rw [this]
        exact (Polynomial.IsSplittingField.splits L₁ p).map _
      have hadj : Algebra.adjoin F (q.rootSet E) = ⊤ := by
        have hsub : Set.range ι ⊆ (Algebra.adjoin F (q.rootSet E) : Set E) := by
          rintro _ ⟨l, rfl⟩
          have h1 : l ∈ Algebra.adjoin K (p.rootSet L₁) := by
            rw [Polynomial.IsSplittingField.adjoin_rootSet L₁ p]; trivial
          have h2 : ι l ∈ Algebra.adjoin K (ι '' p.rootSet L₁) := by
            rw [← AlgHom.map_adjoin]; exact Subalgebra.mem_map.mpr ⟨l, h1, rfl⟩
          have h3 : Algebra.adjoin K (ι '' p.rootSet L₁) ≤
              (Algebra.adjoin F (q.rootSet E)).restrictScalars K := by
            apply Algebra.adjoin_le
            rintro _ ⟨r, hr, rfl⟩
            rw [Polynomial.mem_rootSet] at hr
            have hroot : ι r ∈ q.rootSet E := by
              rw [Polynomial.mem_rootSet]
              refine ⟨hq0, ?_⟩
              rw [hq, Polynomial.aeval_map_algebraMap, Polynomial.aeval_algHom_apply, hr.2,
                map_zero]
            change ι r ∈ Algebra.adjoin F (q.rootSet E)
            exact Algebra.subset_adjoin hroot
          exact h3 h2
        have : Submodule.span F (Set.range ι) ≤
            Subalgebra.toSubmodule (Algebra.adjoin F (q.rootSet E)) :=
          Submodule.span_le.mpr hsub
        rw [hspan] at this
        exact Algebra.toSubmodule_eq_top.mp (eq_top_iff.mpr this)
      haveI : Polynomial.IsSplittingField F E q := Polynomial.IsSplittingField.mk hsplit hadj
      exact IsGalois.of_separable_splitting_field hqsep
    haveI := hgal

    have hnorm : ∀ (τ : E ≃ₐ[F] E) (c : L₁), τ (ι c) ∈ Set.range ι := by
      intro τ c
      have hint := Normal.isIntegral (inferInstance : Normal K L₁) c
      have hg0 : minpoly K c ≠ 0 := minpoly.ne_zero hint
      have hspl := Normal.splits (inferInstance : Normal K L₁) c
      have hroot : (((minpoly K c).map (algebraMap K L₁)).map (ι : L₁ →+* E)).IsRoot (τ (ι c)) := by
        rw [Polynomial.map_map, AlgHom.comp_algebraMap, Polynomial.IsRoot,
          Polynomial.eval_map_algebraMap]
        have : τ (ι c) = ((τ : E →ₐ[F] E).restrictScalars K) (ι c) := rfl
        rw [this, Polynomial.aeval_algHom_apply, Polynomial.aeval_algHom_apply, minpoly.aeval,
          map_zero, map_zero]
      obtain ⟨y, hy⟩ := hspl.mem_range_of_isRoot (Polynomial.map_ne_zero hg0) hroot
      exact ⟨y, hy⟩

    haveI : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩
    have hxE : algebraMap F E x ≠ 0 := (map_ne_zero _).mpr hx
    have hβ0 : β ≠ 0 := by
      rintro rfl
      rw [zero_pow (NeZero.ne ℓ)] at hβ
      exact hxE hβ.symm
    have hζE : IsPrimitiveRoot (algebraMap K E ζ) ℓ :=
      hζ.map_of_injective (algebraMap K E).injective
    have hζι : algebraMap K E ζ ∈ ι.range := ι.mem_range.mpr ⟨algebraMap K L₁ ζ, ι.commutes ζ⟩
    have hratio : ∀ τ : E ≃ₐ[F] E, β * (τ β)⁻¹ ∈ ι.range := by
      intro τ
      have h1 : (τ β) ^ ℓ = β ^ ℓ := by rw [← map_pow, hβ, AlgEquiv.commutes]
      have h2 : (β * (τ β)⁻¹) ^ ℓ = 1 := by
        rw [mul_pow, inv_pow, h1, mul_inv_cancel₀ (pow_ne_zero _ hβ0)]
      obtain ⟨i, -, hi⟩ := hζE.eq_pow_of_pow_eq_one h2
      rw [← hi]
      exact Subalgebra.pow_mem _ hζι i
    let φ : E →ₗ[F] F := (Algebra.trace F E).comp (LinearMap.mulRight F β⁻¹)
    have hφapp : ∀ y, φ y = Algebra.trace F E (y * β⁻¹) := fun y => by
      simp only [φ, LinearMap.comp_apply, LinearMap.mulRight_apply]
    have hφ : φ ≠ 0 := by
      intro h
      apply Algebra.trace_ne_zero F E
      ext y
      have := LinearMap.congr_fun h (y * β)
      rw [hφapp, mul_assoc, mul_inv_cancel₀ hβ0, mul_one] at this
      simpa using this
    obtain ⟨c, hc⟩ : ∃ c : L₁, φ (ι c) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hφ (LinearMap.ext_on_range hspan (fun c => by simpa using hcon c))
    set t := φ (ι c) with ht
    have hsum : β * algebraMap F E t = ∑ τ : E ≃ₐ[F] E, τ (ι c) * (β * (τ β)⁻¹) := by
      have h1 : algebraMap F E t = ∑ τ : E ≃ₐ[F] E, τ (ι c * β⁻¹) := by
        rw [ht, hφapp]
        exact trace_eq_sum_automorphisms _
      rw [h1, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun τ _ => ?_)
      rw [map_mul, map_inv₀]
      ring
    have hmem : β * algebraMap F E t ∈ ι.range := by
      rw [hsum]
      refine Subalgebra.sum_mem _ (fun τ _ => Subalgebra.mul_mem _ ?_ (hratio τ))
      obtain ⟨y, hy⟩ := hnorm τ c
      exact ι.mem_range.mpr ⟨y, hy⟩
    obtain ⟨μ, hμ⟩ := ι.mem_range.mp hmem
    have ht0 : t ≠ 0 := hc
    have hkey : algebraMap F E (x * t ^ ℓ) = ι (μ ^ ℓ) := by
      rw [map_mul, map_pow, ← hβ, ← mul_pow, map_pow, hμ]
    have hsepE : IsSeparable K (algebraMap F E (x * t ^ ℓ)) := by
      rw [hkey]
      exact IsSeparable.map ι (RingHom.injective ι.toRingHom) (Algebra.IsSeparable.isSeparable K _)
    have hsep : IsSeparable K (x * t ^ ℓ) :=
      (isSeparable_map_iff (IsScalarTower.toAlgHom K F E) (algebraMap F E).injective).mp hsepE
    refine ⟨x * t ^ ℓ, t⁻¹, mul_ne_zero hx (pow_ne_zero _ ht0), inv_ne_zero ht0,
      hsep.isIntegral, hsep, ?_⟩
    rw [inv_pow, mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ ht0), mul_one]

  haveI : Nontrivial (TensorProduct K F L₁) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain K F L₁
      (algebraMap K F).injective (algebraMap K L₁).injective
  obtain ⟨I, hI⟩ := Ideal.exists_maximal (TensorProduct K F L₁)
  letI : Field (TensorProduct K F L₁ ⧸ I) := Ideal.Quotient.field I
  refine main (TensorProduct K F L₁ ⧸ I)
    ((Ideal.Quotient.mkₐ K I).comp Algebra.TensorProduct.includeRight)
    (Ideal.Quotient.mk I b) ?_ ?_ ?_
  · exact Module.Finite.of_surjective (Ideal.Quotient.mkₐ F I).toLinearMap
      Ideal.Quotient.mk_surjective
  · rw [eq_top_iff]
    rintro e -
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective e
    induction r using TensorProduct.induction_on with
    | zero => simp
    | tmul f l =>
      have : Ideal.Quotient.mk I (TensorProduct.tmul K f l) =
          f • ((Ideal.Quotient.mkₐ K I).comp Algebra.TensorProduct.includeRight l) := by
        rw [Algebra.smul_def, AlgHom.comp_apply, Algebra.TensorProduct.includeRight_apply,
          Ideal.Quotient.mkₐ_eq_mk, ← Ideal.Quotient.mk_algebraMap, ← map_mul,
          Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul, Algebra.algebraMap_self, RingHom.id_apply]
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
    | add r s hr hs =>
      rw [map_add]
      exact Submodule.add_mem _ hr hs
  · rw [← map_pow, hb, ← Ideal.Quotient.mk_algebraMap, Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]

theorem wc_qmbt_nlp_val_unique : ∀ (A' : Type u) [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] (π' : A'),
    IsLocalRing.maximalIdeal A' = Ideal.span {π'} →
    ∀ (F : Type u) [Field F] [Algebra A' F] [Algebra (FractionRing A') F]
      [IsScalarTower A' (FractionRing A') F] (w₀ w₁ : AddValuation F (WithTop ℤ)),
    (∀ a : A', 0 ≤ w₀ (algebraMap A' F a)) → (∀ a : A', 0 ≤ w₁ (algebraMap A' F a)) →
    w₀ (algebraMap A' F π') = 1 → w₁ (algebraMap A' F π') = 1 →
    ∀ m : F, m ≠ 0 → IsIntegral (FractionRing A') m → IsSeparable (FractionRing A') m →
    w₀ m = w₁ m :=
by
  intro A' _ _ _ _ π' hπ' F _ _ _ _ w₀ w₁ h0 h1 hp0 hp1 m _ hmi hms
  classical

  have nonneg : ∀ (w : AddValuation F (WithTop ℤ)), (∀ a : A', 0 ≤ w (algebraMap A' F a)) →
      ∀ x : F, IsIntegral A' x → 0 ≤ w x := by
    intro w hw x hx
    by_contra hneg
    push_neg at hneg
    obtain ⟨p, hpm, hpx⟩ := hx
    have hx0 : x ≠ 0 := by
      intro h
      rw [h, AddValuation.map_zero] at hneg
      exact absurd hneg (not_lt.mpr le_top)
    obtain ⟨k, hk⟩ := WithTop.ne_top_iff_exists.mp ((AddValuation.ne_top_iff w).mpr hx0)
    have hk0 : k < 0 := by
      rw [← hk] at hneg
      exact_mod_cast hneg
    have hsum : x ^ p.natDegree =
        -∑ i ∈ Finset.range p.natDegree, algebraMap A' F (p.coeff i) * x ^ i := by
      have h := Polynomial.aeval_eq_sum_range (p := p) x
      rw [← Polynomial.aeval_def] at hpx
      rw [hpx, Finset.sum_range_succ, hpm.coeff_natDegree, one_smul] at h
      simp only [Algebra.smul_def] at h
      linear_combination -h
    have hlt : (((p.natDegree : ℤ) * k : ℤ) : WithTop ℤ) <
        w (∑ i ∈ Finset.range p.natDegree, algebraMap A' F (p.coeff i) * x ^ i) := by
      apply AddValuation.map_lt_sum
      · exact WithTop.coe_ne_top
      · intro i hi
        rw [AddValuation.map_mul, AddValuation.map_pow, ← hk]
        have hi' : i < p.natDegree := Finset.mem_range.mp hi
        have h2 : (((p.natDegree : ℤ) * k : ℤ) : WithTop ℤ) < (i • (k : WithTop ℤ)) := by
          rw [← WithTop.coe_nsmul, WithTop.coe_lt_coe, nsmul_eq_mul]
          have : (i : ℤ) < p.natDegree := by exact_mod_cast hi'
          nlinarith
        calc _ < i • (k : WithTop ℤ) := h2
          _ ≤ _ := le_add_of_nonneg_left (hw _)
    rw [← AddValuation.map_neg, ← hsum, AddValuation.map_pow, ← hk, ← WithTop.coe_nsmul,
      nsmul_eq_mul] at hlt
    exact lt_irrefl _ hlt


  have hensel_local : ∀ (A D : Type u) [CommRing A] [CommRing D] [IsDomain D] [Algebra A D]
      [IsLocalRing A], HenselianLocalRing A → Algebra.IsIntegral A D →
      IsLocalRing D ∧ IsLocalHom (algebraMap A D) := by
    intro A D _ _ _ _ _ hHen hInt
    have hloc : IsLocalHom (algebraMap A D) := by
      refine ⟨fun a ha => ?_⟩
      by_contra hna
      have hker : RingHom.ker (algebraMap A D) ≤ IsLocalRing.maximalIdeal A :=
        IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top _)
      obtain ⟨Q, hQ, hQu⟩ :=
        Ideal.exists_ideal_over_maximal_of_isIntegral (S := D) (IsLocalRing.maximalIdeal A) hker
      have hmem : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
      rw [← hQu] at hmem
      have hQa : algebraMap A D a ∈ Q := hmem
      exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hQa ha)
    have hofId : ((Algebra.ofId A (IsLocalRing.ResidueField A) : A →ₐ[A] IsLocalRing.ResidueField A) :
        A →+* IsLocalRing.ResidueField A) = IsLocalRing.residue A := by
      ext x
      show Algebra.ofId A (IsLocalRing.ResidueField A) x = IsLocalRing.residue A x
      rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    have s2 : ∀ (S : Type u) [CommRing S] [Algebra A S], Algebra.IsStandardEtale A S →
        ∀ φ : S →ₐ[A] IsLocalRing.ResidueField A,
          ∃ τ : S →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A (IsLocalRing.ResidueField A)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A (IsLocalRing.ResidueField A)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    have s3 : ∀ (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E →
        ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A,
          ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
      intro E _ _ hE φ
      have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A)).IsPrime := RingHom.ker_isPrime _
      obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A)
        (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A))
      have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
      have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
        rintro ⟨y, k, rfl⟩
        simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
      let φ' : Localization.Away s →ₐ[A] IsLocalRing.ResidueField A :=
        IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
      obtain ⟨τ', hτ'⟩ := s2 _ hst φ'
      refine ⟨τ'.comp (IsScalarTower.toAlgHom A E (Localization.Away s)), ?_⟩
      ext e
      have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
      simp only [AlgHom.comp_apply] at h1 ⊢
      rw [IsScalarTower.toAlgHom_apply, h1]
      simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    have s4 : ∀ (f : Polynomial A) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A)), f.Monic →
        g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A) = g₀ * h₀ →
        ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ f = g * h ∧
          g.map (IsLocalRing.residue A) = g₀ ∧ h.map (IsLocalRing.residue A) = h₀ := by
      intro f g₀ h₀ hf hg hh hc hfac
      have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
        rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
      let p : Polynomial.MonicDegreeEq A f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
      let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) g₀.natDegree :=
        Polynomial.MonicDegreeEq.mk g₀ hg rfl
      let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) h₀.natDegree :=
        Polynomial.MonicDegreeEq.mk h₀ hh rfl
      have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A)) * (H₀ : Polynomial _) =
          Polynomial.map (algebraMap A (IsLocalRing.ResidueField A)) (p : Polynomial A) ∧
          IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A)) (H₀ : Polynomial _) := by
        refine ⟨?_, hc⟩
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact hfac.symm
      obtain ⟨τ, hτ⟩ := s3 _ inferInstance
        ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
      have nat : ∀ (ψ : A →ₐ[A] IsLocalRing.ResidueField A),
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
            _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1 :
            Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) ∧
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
            _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2 :
            Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) := by
        intro ψ
        constructor
        · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
              (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                  IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
            (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
              ((τ.comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
                Polynomial.MonicDegreeEq A _) : Polynomial A).map
                  (ψ : A →+* IsLocalRing.ResidueField A)
          rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
          rfl
        · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
              (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                  IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
            (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
              ((τ.comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
                Polynomial.MonicDegreeEq A _) : Polynomial A).map
                  (ψ : A →+* IsLocalRing.ResidueField A)
          rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
          rfl
      obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A (IsLocalRing.ResidueField A))
      have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p ((Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
        rw [hτ]
        exact Equiv.apply_symm_apply _ _
      rw [hφ, hofId] at nat1 nat2
      refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1.monic,
        (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2.monic, ?_,
        nat1.symm, nat2.symm⟩
      rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).2.1,
        Algebra.algebraMap_self, Polynomial.map_id]
      rfl
    have s5 : ∀ (q : Polynomial (IsLocalRing.ResidueField A)), q.Monic →
        ∃ (a : ℕ) (r : Polynomial (IsLocalRing.ResidueField A)), r.Monic ∧
          q = Polynomial.X ^ a * r ∧ r.coeff 0 ≠ 0 ∧
          IsCoprime ((Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ^ a) r := by
      intro q hq
      obtain ⟨r, hr, hnd⟩ :=
        Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd q hq.ne_zero 0
      rw [map_zero, sub_zero] at hr hnd
      refine ⟨_, r, ?_, hr, ?_, ?_⟩
      · exact (Polynomial.monic_X_pow _).of_mul_monic_left (hr ▸ hq)
      · intro h
        exact hnd (Polynomial.X_dvd_iff.mpr h)
      · exact IsCoprime.pow_left ((Irreducible.coprime_iff_not_dvd Polynomial.irreducible_X).mpr hnd)
    refine ⟨?_, hloc⟩
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro d
    obtain ⟨F, hF, hFd⟩ := hInt.isIntegral d
    obtain ⟨a, r, hr, hsplit, hr0, hcop⟩ := s5 (F.map (IsLocalRing.residue A)) (hF.map _)
    obtain ⟨g, h, -, -, hFgh, hgr, hhr⟩ :=
      s4 F (Polynomial.X ^ a) r hF (Polynomial.monic_X_pow a) hr hcop hsplit
    have hg1 : IsUnit (g.eval 1) := by
      apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      rw [← Polynomial.eval_one_map, hgr, Polynomial.eval_pow, Polynomial.eval_X, one_pow]
      exact one_ne_zero
    have hh0 : IsUnit (h.eval 0) := by
      apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      rw [← Polynomial.eval_zero_map, hhr, ← Polynomial.coeff_zero_eq_eval_zero]
      exact hr0
    have hprod : Polynomial.aeval d g * Polynomial.aeval d h = 0 := by
      rw [← map_mul, ← hFgh, Polynomial.aeval_def]
      exact hFd
    rcases mul_eq_zero.mp hprod with hgd | hhd
    · right
      have hdvd := Polynomial.sub_dvd_eval_sub 1 d (g.map (algebraMap A D))
      rw [Polynomial.eval_one_map, Polynomial.eval_map, ← Polynomial.aeval_def, hgd,
        sub_zero] at hdvd
      exact isUnit_of_dvd_unit hdvd (hg1.map _)
    · left
      have hdvd := Polynomial.sub_dvd_eval_sub 0 d (h.map (algebraMap A D))
      rw [Polynomial.eval_zero_map, Polynomial.eval_map, ← Polynomial.aeval_def, hhd,
        sub_zero, zero_sub] at hdvd
      have hu := (isUnit_of_dvd_unit hdvd (hh0.map _)).neg
      rwa [neg_neg] at hu

  let K := FractionRing A'
  let K₀ : IntermediateField K F := IntermediateField.adjoin K {m}
  haveI : FiniteDimensional K K₀ := IntermediateField.adjoin.finiteDimensional hmi
  haveI : Algebra.IsSeparable K K₀ :=
    (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K F).mpr hms
  let O := integralClosure A' K₀
  haveI : IsDedekindDomain O := integralClosure.isDedekindDomain A' K K₀
  haveI : IsFractionRing O K₀ := IsIntegralClosure.isFractionRing_of_finite_extension A' K K₀ O
  let ι : O →+* F := (algebraMap K₀ F).comp (algebraMap O K₀)
  have hι : Function.Injective ι :=
    (algebraMap K₀ F).injective.comp (IsFractionRing.injective O K₀)
  have hιA : ∀ a : A', ι (algebraMap A' O a) = algebraMap A' F a := fun a => rfl

  obtain ⟨hOloc, hOlh⟩ := hensel_local A' O inferInstance inferInstance
  haveI := hOloc
  haveI := hOlh
  haveI : IsPrincipalIdealRing O := IsDedekindDomain.isPrincipalIdealRing O
  have hq0 : algebraMap A' O π' ≠ 0 := by
    intro h
    have := hp0
    rw [← hιA, h, map_zero, AddValuation.map_zero] at this
    exact WithTop.top_ne_coe this
  have hqm : algebraMap A' O π' ∈ IsLocalRing.maximalIdeal O := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hu' : IsUnit π' := isUnit_of_map_unit (algebraMap A' O) π' hu
    have hmem : π' ∈ IsLocalRing.maximalIdeal A' := by
      rw [hπ']
      exact Ideal.mem_span_singleton_self π'
    exact (IsLocalRing.mem_maximalIdeal π').mp hmem hu'
  haveI : IsDiscreteValuationRing O := IsDiscreteValuationRing.mk (by
    intro hbot
    rw [hbot, Ideal.mem_bot] at hqm
    exact hq0 hqm)

  let φ : K₀ →ₐ[A'] F := (K₀.val).restrictScalars A'
  have hOint : ∀ o : O, IsIntegral A' (ι o) := fun o => by
    have h := IsIntegral.map φ (o.2 : IsIntegral A' (o : K₀))
    exact h
  have hn0 : ∀ o : O, 0 ≤ w₀ (ι o) := fun o => nonneg w₀ h0 _ (hOint o)
  have hn1 : ∀ o : O, 0 ≤ w₁ (ι o) := fun o => nonneg w₁ h1 _ (hOint o)

  have hunit : ∀ (w : AddValuation F (WithTop ℤ)), (∀ o : O, 0 ≤ w (ι o)) →
      ∀ u : Oˣ, w (ι u) = 0 := by
    intro w hw u
    have h := congrArg w (show ι (u : O) * ι (↑u⁻¹ : O) = 1 by
      rw [← map_mul, Units.mul_inv, map_one])
    rw [AddValuation.map_mul, AddValuation.map_one] at h
    exact le_antisymm (h ▸ le_add_of_nonneg_right (hw _)) (hw _)
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hform : ∀ (w : AddValuation F (WithTop ℤ)), (∀ o : O, 0 ≤ w (ι o)) →
      ∀ (k : ℕ) (u : Oˣ), w (ι (u * ϖ ^ k)) = k • w (ι ϖ) := by
    intro w hw k u
    rw [map_mul, map_pow, AddValuation.map_mul, AddValuation.map_pow, hunit w hw u, zero_add]
  have hϖ0 : ι ϖ ≠ 0 := fun h => hϖ.ne_zero (hι (h.trans (map_zero ι).symm))
  obtain ⟨t₀, ht₀⟩ := WithTop.ne_top_iff_exists.mp ((AddValuation.ne_top_iff w₀).mpr hϖ0)
  obtain ⟨t₁, ht₁⟩ := WithTop.ne_top_iff_exists.mp ((AddValuation.ne_top_iff w₁).mpr hϖ0)
  obtain ⟨e, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hq0 hϖ
  have he0 : ((e • t₀ : ℤ) : WithTop ℤ) = 1 := by
    rw [WithTop.coe_nsmul, ht₀, ← hform w₀ hn0, ← hu, hιA, hp0]
  have he1 : ((e • t₁ : ℤ) : WithTop ℤ) = 1 := by
    rw [WithTop.coe_nsmul, ht₁, ← hform w₁ hn1, ← hu, hιA, hp1]
  have he0' : (e : ℤ) * t₀ = 1 := by
    rw [← nsmul_eq_mul]
    exact_mod_cast he0
  have he1' : (e : ℤ) * t₁ = 1 := by
    rw [← nsmul_eq_mul]
    exact_mod_cast he1
  have ht : t₀ = t₁ := by
    have hne : (e : ℤ) ≠ 0 := by
      intro h
      rw [h, zero_mul] at he0'
      exact zero_ne_one he0'
    exact mul_left_cancel₀ hne (he0'.trans he1'.symm)
  have hagree : ∀ o : O, w₀ (ι o) = w₁ (ι o) := by
    intro o
    by_cases ho : o = 0
    · rw [ho, map_zero, AddValuation.map_zero, AddValuation.map_zero]
    · obtain ⟨k, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ho hϖ
      rw [hv, hform w₀ hn0, hform w₁ hn1, ← ht₀, ← ht₁, ht]

  obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective O
    (⟨m, IntermediateField.mem_adjoin_simple_self K m⟩ : K₀)
  have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
  have hιy : ι y ≠ 0 := fun h => hy0 (hι (h.trans (map_zero ι).symm))
  have hmxy : ι x / ι y = m := by
    have := congrArg (fun z : K₀ => (z : F)) hxy
    simp only [IntermediateField.coe_div] at this
    exact this
  have hmul : m * ι y = ι x := by
    rw [← hmxy]
    exact div_mul_cancel₀ _ hιy
  have e0 : w₀ m + w₀ (ι y) = w₀ (ι x) := by rw [← AddValuation.map_mul, hmul]
  have e1 : w₁ m + w₁ (ι y) = w₁ (ι x) := by rw [← AddValuation.map_mul, hmul]
  have hyt : w₁ (ι y) ≠ ⊤ := (AddValuation.ne_top_iff w₁).mpr hιy
  apply WithTop.add_right_cancel hyt
  rw [e1, ← hagree y, e0, hagree x]

theorem wc_qmbt_nlp_two_branch : ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
    (p₀ p₁ x : C), p₀ ∈ IsLocalRing.maximalIdeal C → p₁ ∈ IsLocalRing.maximalIdeal C →
    p₀ ∈ nonZeroDivisors C → p₁ ∈ nonZeroDivisors C → IsDomain (C ⧸ Ideal.span {p₀}) →
    IsDomain (C ⧸ Ideal.span {p₁}) → p₀ ∉ Ideal.span {p₁} → p₁ ∉ Ideal.span {p₀} →
    x ∈ IsLocalRing.maximalIdeal C → x ∉ Ideal.span {p₀ * p₁} → (∃ b : C, p₀ * p₁ = x * b) →
    IsDomain C ∧ ∃ w₀ w₁ : AddValuation (FractionRing C) (WithTop ℤ),
      (∀ c : C, 0 ≤ w₀ (algebraMap C (FractionRing C) c)) ∧
      (∀ c : C, 0 ≤ w₁ (algebraMap C (FractionRing C) c)) ∧
      w₀ (algebraMap C (FractionRing C) (p₀ * p₁)) = 1 ∧
      w₁ (algebraMap C (FractionRing C) (p₀ * p₁)) = 1 ∧
      ((w₀ (algebraMap C (FractionRing C) x) = 1 ∧ w₁ (algebraMap C (FractionRing C) x) = 0) ∨
        (w₀ (algebraMap C (FractionRing C) x) = 0 ∧ w₁ (algebraMap C (FractionRing C) x) = 1)) :=
by
  intro C _ _ _ p₀ p₁ x h0 h1 hn₀ hn₁ hd₀ hd₁ hnm₁ hnm₀ hxm hx hbex
  obtain ⟨b, hb⟩ := hbex

  have hdom : IsDomain C := by
    have hprime : (Ideal.span {p₀}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hd₀
    have hkrull := Ideal.iInf_pow_eq_bot_of_isLocalRing (Ideal.span {p₀}) hprime.ne_top
    have hfac : ∀ c : C, c ≠ 0 → ∃ n : ℕ, ∃ c' : C, c = p₀ ^ n * c' ∧ ¬ p₀ ∣ c' := by
      intro c hc
      have hex : ∃ i, ¬ p₀ ^ i ∣ c := by
        by_contra hall
        push_neg at hall
        apply hc
        have hmem : c ∈ ⨅ i, Ideal.span {p₀} ^ i := by
          rw [Ideal.mem_iInf]
          intro i
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          exact hall i
        rw [hkrull] at hmem
        exact Ideal.mem_bot.mp hmem
      have hfin : FiniteMultiplicity p₀ c := by
        obtain ⟨i, hi⟩ := hex
        exact ⟨i, fun h => hi (dvd_trans (pow_dvd_pow _ (Nat.le_succ i)) h)⟩
      obtain ⟨c', hc'⟩ := pow_multiplicity_dvd p₀ c
      refine ⟨multiplicity p₀ c, c', hc', ?_⟩
      rintro ⟨d, hd⟩
      apply hfin.not_pow_dvd_of_multiplicity_lt (Nat.lt_succ_self _)
      exact ⟨d, by rw [pow_succ, mul_assoc, ← hd]; exact hc'⟩
    haveI : NoZeroDivisors C := by
      constructor
      intro c d hcd
      by_contra hne'
      push_neg at hne'
      obtain ⟨hc, hd⟩ := hne'
      obtain ⟨n, c', hcc, hc'⟩ := hfac c hc
      obtain ⟨m, d', hdd, hd'⟩ := hfac d hd
      have h1 : p₀ ^ (n + m) * (c' * d') = 0 := by
        rw [← hcd, hcc, hdd]; ring
      rw [mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hn₀ _)] at h1
      have hmem : c' * d' ∈ Ideal.span {p₀} := by rw [h1]; exact Ideal.zero_mem _
      rcases hprime.mem_or_mem hmem with h | h
      · exact hc' (Ideal.mem_span_singleton.mp h)
      · exact hd' (Ideal.mem_span_singleton.mp h)
    exact NoZeroDivisors.to_isDomain C
  haveI := hdom

  have hval : ∀ p : C, p ∈ nonZeroDivisors C → IsDomain (C ⧸ Ideal.span {p}) →
      ∃ w : AddValuation (FractionRing C) (WithTop ℤ),
        (∀ c : C, 0 ≤ w (algebraMap C (FractionRing C) c)) ∧
        w (algebraMap C (FractionRing C) p) = 1 ∧
        ∀ c : C, (p ∣ c ↔ 1 ≤ w (algebraMap C (FractionRing C) c)) := by
    intro p hp hdp
    have hp0 : p ≠ 0 := nonZeroDivisors.ne_zero hp
    have hpr : Prime p :=
      (Ideal.span_singleton_prime hp0).mp ((Ideal.Quotient.isDomain_iff_prime _).mp hdp)
    have hnu : ¬ IsUnit p := hpr.not_isUnit
    haveI : WfDvdMonoid C := IsNoetherianRing.wfDvdMonoid
    have hfin : ∀ c : C, c ≠ 0 → FiniteMultiplicity p c :=
      fun c hc => FiniteMultiplicity.of_not_isUnit hnu hc
    classical
    let f : C → WithTop ℤ := fun c => if c = 0 then ⊤ else (((multiplicity p c : ℕ) : ℤ) : WithTop ℤ)
    have hf0 : f 0 = ⊤ := by simp [f]
    have hf1 : f 1 = 0 := by
      simp only [f, one_ne_zero, if_false]
      rw [(multiplicity_eq_zero (hfin 1 one_ne_zero)).mpr (fun h => hnu (isUnit_of_dvd_one h))]
      rfl
    have hfmul : ∀ a c : C, f (a * c) = f a + f c := by
      intro a c
      by_cases ha : a = 0
      · simp [f, ha]
      by_cases hc : c = 0
      · simp [f, hc]
      have hac : a * c ≠ 0 := mul_ne_zero ha hc
      simp only [f, ha, hc, hac, if_false]
      rw [multiplicity_mul hpr (hfin _ hac)]
      push_cast
      rfl
    have hfadd : ∀ a c : C, min (f a) (f c) ≤ f (a + c) := by
      intro a c
      by_cases hac : a + c = 0
      · simp [f, hac]
      by_cases ha : a = 0
      · simp [f, ha]
      by_cases hc : c = 0
      · simp [f, hc]
      simp only [f, ha, hc, hac, if_false]
      have key : min (multiplicity p a) (multiplicity p c) ≤ multiplicity p (a + c) := by
        apply (hfin _ hac).le_multiplicity_of_pow_dvd
        exact dvd_add (dvd_trans (pow_dvd_pow _ (min_le_left _ _)) (pow_multiplicity_dvd p a))
          (dvd_trans (pow_dvd_pow _ (min_le_right _ _)) (pow_multiplicity_dvd p c))
      rcases le_total (multiplicity p a) (multiplicity p c) with h | h
      · rw [min_eq_left h] at key
        refine min_le_of_left_le ?_
        exact_mod_cast key
      · rw [min_eq_right h] at key
        refine min_le_of_right_le ?_
        exact_mod_cast key
    let v : AddValuation C (WithTop ℤ) := AddValuation.of f hf0 hf1 hfadd hfmul
    have hv : ∀ c, v c = f c := fun c => AddValuation.of_apply _
    have hsupp : ∀ c, c ∈ (AddValuation.toValuation v).supp ↔ c = 0 := by
      intro c
      change c ∈ v.supp ↔ c = 0
      rw [AddValuation.mem_supp_iff, hv]
      constructor
      · intro h
        by_contra hc
        simp [f, hc] at h
      · intro h
        rw [h, hf0]
    haveI : (AddValuation.toValuation v).supp.IsPrime := by
      have e : (AddValuation.toValuation v).supp = ⊥ := by
        ext c
        rw [hsupp, Ideal.mem_bot]
      rw [e]
      exact Ideal.isPrime_bot
    have hS : nonZeroDivisors C ≤ (AddValuation.toValuation v).supp.primeCompl := by
      intro s hs
      rw [Ideal.mem_primeCompl_iff, hsupp]
      exact nonZeroDivisors.ne_zero hs
    let w : AddValuation (FractionRing C) (WithTop ℤ) :=
      AddValuation.ofValuation ((AddValuation.toValuation v).extendToLocalization hS (FractionRing C))
    have hw : ∀ c : C, w (algebraMap C (FractionRing C) c) = f c := by
      intro c
      rw [← hv]
      show (AddValuation.toValuation v).extendToLocalization hS (FractionRing C)
        (algebraMap C (FractionRing C) c) = AddValuation.toValuation v c
      exact Valuation.extendToLocalization_apply_map_apply _ _ _ _
    refine ⟨w, ?_, ?_, ?_⟩
    · intro c
      rw [hw]
      simp only [f]
      split_ifs
      · exact le_top
      · exact_mod_cast Int.natCast_nonneg _
    · rw [hw]
      simp only [f, hp0, if_false]
      have e := multiplicity_pow_self_of_prime hpr 1
      rw [pow_one] at e
      rw [e]
      rfl
    · intro c
      rw [hw]
      by_cases hc : c = 0
      · simp [f, hc]
      simp only [f, hc, if_false]
      have e : (1 : WithTop ℤ) ≤ (((multiplicity p c : ℕ) : ℤ) : WithTop ℤ) ↔
          1 ≤ multiplicity p c := by
        constructor <;> intro h <;> exact_mod_cast h
      rw [e, Nat.one_le_iff_ne_zero, Ne, multiplicity_eq_zero (hfin c hc), not_not]

  have T1 : ∀ t : WithTop ℤ, 0 ≤ t → ¬ (1 ≤ t) → t = 0 := by
    intro t ht0 ht1
    induction t using WithTop.recTopCoe with
    | top => exact absurd le_top ht1
    | coe k =>
      have e0 : (0 : ℤ) ≤ k := by exact_mod_cast ht0
      have e1 : ¬ (1 : ℤ) ≤ k := fun h => ht1 (by exact_mod_cast h)
      have e2 : k = 0 := by omega
      rw [e2]
      rfl
  have T2 : ∀ s t : WithTop ℤ, 0 ≤ s → 0 ≤ t → s + t = 1 →
      (s = 0 ∧ t = 1) ∨ (s = 1 ∧ t = 0) := by
    intro s t hs ht hst
    induction s using WithTop.recTopCoe with
    | top => simp at hst
    | coe i =>
      induction t using WithTop.recTopCoe with
      | top => simp at hst
      | coe j =>
        have hi : (0 : ℤ) ≤ i := by exact_mod_cast hs
        have hj : (0 : ℤ) ≤ j := by exact_mod_cast ht
        have hij : i + j = 1 := by exact_mod_cast hst
        rcases (by omega : (i = 0 ∧ j = 1) ∨ (i = 1 ∧ j = 0)) with ⟨e1, e2⟩ | ⟨e1, e2⟩
        · left; rw [e1, e2]; exact ⟨rfl, rfl⟩
        · right; rw [e1, e2]; exact ⟨rfl, rfl⟩

  obtain ⟨w₀, P0, Q0, R0⟩ := hval p₀ hn₀ hd₀
  obtain ⟨w₁, P1, Q1, R1⟩ := hval p₁ hn₁ hd₁
  have c01 : w₀ (algebraMap C (FractionRing C) p₁) = 0 :=
    T1 _ (P0 p₁) (fun h => hnm₀ (Ideal.mem_span_singleton.mpr ((R0 p₁).mpr h)))
  have c10 : w₁ (algebraMap C (FractionRing C) p₀) = 0 :=
    T1 _ (P1 p₀) (fun h => hnm₁ (Ideal.mem_span_singleton.mpr ((R1 p₀).mpr h)))
  have E0 : w₀ (algebraMap C (FractionRing C) (p₀ * p₁)) = 1 := by
    rw [map_mul, AddValuation.map_mul, Q0, c01, add_zero]
  have E1 : w₁ (algebraMap C (FractionRing C) (p₀ * p₁)) = 1 := by
    rw [map_mul, AddValuation.map_mul, Q1, c10, zero_add]
  have S0 : w₀ (algebraMap C (FractionRing C) x) + w₀ (algebraMap C (FractionRing C) b) = 1 := by
    rw [← AddValuation.map_mul, ← map_mul, ← hb, E0]
  have S1 : w₁ (algebraMap C (FractionRing C) x) + w₁ (algebraMap C (FractionRing C) b) = 1 := by
    rw [← AddValuation.map_mul, ← map_mul, ← hb, E1]
  have both : ∀ y : C, 1 ≤ w₀ (algebraMap C (FractionRing C) y) →
      1 ≤ w₁ (algebraMap C (FractionRing C) y) → ∃ z, y = p₀ * p₁ * z := by
    intro y hy0 hy1
    obtain ⟨y', hy'⟩ := (R0 y).mpr hy0
    rw [hy', map_mul, AddValuation.map_mul, c10, zero_add] at hy1
    obtain ⟨z, hz⟩ := (R1 y').mpr hy1
    exact ⟨z, by rw [hy', hz]; ring⟩
  refine ⟨hdom, w₀, w₁, P0, P1, E0, E1, ?_⟩
  rcases T2 _ _ (P0 x) (P0 b) S0 with ⟨hx0, hb0⟩ | ⟨hx0, hb0⟩ <;>
    rcases T2 _ _ (P1 x) (P1 b) S1 with ⟨hx1, hb1⟩ | ⟨hx1, hb1⟩
  · exfalso
    obtain ⟨z, hz⟩ := both b hb0.ge hb1.ge
    have h2 : p₀ * p₁ * (1 - x * z) = 0 := by
      have e : p₀ * p₁ = x * (p₀ * p₁ * z) := by rw [← hz]; exact hb
      linear_combination e
    rw [mul_left_mem_nonZeroDivisors_eq_zero_iff (mul_mem hn₀ hn₁), sub_eq_zero] at h2
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal x).mp hxm) (isUnit_of_dvd_one ⟨z, h2⟩)
  · right; exact ⟨hx0, hx1⟩
  · left; exact ⟨hx0, hx1⟩
  · exfalso
    obtain ⟨z, hz⟩ := both x hx0.ge hx1.ge
    exact hx (Ideal.mem_span_singleton'.mpr ⟨z, by rw [hz]; ring⟩)

theorem wc_qmbt_nlp_chart_noeth_nzd {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (r : ℕ)
    (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)]
    (ψ : wcQmbtSSRing A' r π' →+* C)
    (hψ : @Algebra.WeaklyEtale (wcQmbtSSRing A' r π') C _ _ ψ.toAlgebra) :
    IsNoetherianRing C ∧ ∀ a : Fin (r + 2), a.val < 2 →
      ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a)) ∈ nonZeroDivisors C :=
by
  classical

  have hπ0 : π' ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field' (R := A')
    rw [hπ', h, Set.singleton_zero, Ideal.span_zero]
  refine ⟨?_, ?_⟩
  ·
    have N2 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (β : R →+* C),
        @Algebra.WeaklyEtale R C _ _ β.toAlgebra → IsNoetherianRing C := by
      intro R _ _ β hWE
      haveI : (Ideal.comap β (IsLocalRing.maximalIdeal C)).IsPrime := Ideal.IsPrime.comap β
      haveI : IsNoetherianRing (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) :=
        IsLocalization.isNoetherianRing (Ideal.comap β (IsLocalRing.maximalIdeal C)).primeCompl
          (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) ‹_›
      have hunit : ∀ y : (Ideal.comap β (IsLocalRing.maximalIdeal C)).primeCompl,
          IsUnit (β y) := by
        intro y
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hy
        exact y.2 hy
      have hθ : (IsLocalization.lift (M := (Ideal.comap β (IsLocalRing.maximalIdeal C)).primeCompl)
          (S := Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) hunit).comp
          (algebraMap R (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C)))) = β :=
        IsLocalization.lift_comp hunit
      have hloc : IsLocalHom
          (IsLocalization.lift (M := (Ideal.comap β (IsLocalRing.maximalIdeal C)).primeCompl)
            (S := Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) hunit) := by
        refine ⟨fun z hz => ?_⟩
        obtain ⟨⟨x, s⟩, rfl⟩ :=
          IsLocalization.mk'_surjective (Ideal.comap β (IsLocalRing.maximalIdeal C)).primeCompl z
        rw [IsLocalization.lift_mk'] at hz
        have hr : IsUnit (β x) := isUnit_of_mul_isUnit_left hz
        rw [IsLocalization.AtPrime.isUnit_mk'_iff
          (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C)))
          (Ideal.comap β (IsLocalRing.maximalIdeal C)) x s]
        show x ∉ Ideal.comap β (IsLocalRing.maximalIdeal C)
        intro hxq
        exact IsLocalRing.notMem_maximalIdeal.mpr hr hxq
      letI : Algebra R C := β.toAlgebra
      letI : Algebra (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) C :=
        (IsLocalization.lift (M := (Ideal.comap β (IsLocalRing.maximalIdeal C)).primeCompl)
          (S := Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) hunit).toAlgebra
      haveI : IsScalarTower R
          (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) C :=
        IsScalarTower.of_algebraMap_eq' hθ.symm
      have hWE' : Algebra.WeaklyEtale
          (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) C :=
        wc_weaklyEtale_cancel R
          (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) C
          (wc_localization_weaklyEtale R
            (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C)))
            (Ideal.comap β (IsLocalRing.maximalIdeal C)).primeCompl) hWE
      exact (wc_tla_shens_noeth_unram
        (Localization.AtPrime (Ideal.comap β (IsLocalRing.maximalIdeal C))) C _ hloc hWE').1
    haveI : IsNoetherianRing (wcQmbtSSRing A' r π') :=
      inferInstanceAs (IsNoetherianRing (MvPolynomial (Fin (r + 2)) A' ⧸ _))
    exact N2 (wcQmbtSSRing A' r π') ψ hψ
  ·
    intro a ha

    have h2 : (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) =>
          if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q
        : MvPolynomial (Fin (r + 2)) A') =
        MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ := by
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · simp
        · intro q _ hq
          have hn' : ¬ ((⟨0, by omega⟩ : Fin (r + 2)).val = 0 ∧ q.val = 1) :=
            fun h => hq (Fin.ext h.2)
          rw [Matrix.of_apply, if_neg hn', map_zero, zero_mul, zero_mul]
        · simp
      · intro p _ hp
        apply Finset.sum_eq_zero
        intro q _
        have hn' : ¬ (p.val = 0 ∧ q.val = 1) := fun h => hp (Fin.ext h.1)
        rw [Matrix.of_apply, if_neg hn', map_zero, zero_mul, zero_mul]
      · simp
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (r + 2)) A') ∣
        MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ := by
      rcases (show a = ⟨0, by omega⟩ ∨ a = ⟨1, by omega⟩ by
        rcases a with ⟨v, hv⟩
        simp only [Fin.mk.injEq]
        simp only at ha
        omega) with h | h
      · rw [h]; exact dvd_mul_right _ _
      · rw [h]; exact dvd_mul_left _ _
    have hnd : ¬ ((MvPolynomial.X a : MvPolynomial (Fin (r + 2)) A') ∣
        (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ - MvPolynomial.C π')) := by
      intro hd
      have h3 : (MvPolynomial.X a : MvPolynomial (Fin (r + 2)) A') ∣ MvPolynomial.C π' := by
        have := dvd_sub hXa hd
        rwa [sub_sub_cancel] at this
      rw [MvPolynomial.C_apply, MvPolynomial.X_dvd_monomial] at h3
      rcases h3 with h3 | h3
      · exact hπ0 h3
      · exact h3 (by simp)
    have hprime : Prime (MvPolynomial.X a : MvPolynomial (Fin (r + 2)) A') := MvPolynomial.X_prime
    have hM : (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a) : wcQmbtSSRing A' r π') ∈ nonZeroDivisors (wcQmbtSSRing A' r π') := by
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hx
      rw [Ideal.Quotient.eq_zero_iff_mem]
      have hx' := Ideal.mem_span_singleton.mp hx
      rw [h2] at hx'
      obtain ⟨h, hh⟩ := hx'
      have h5 : (MvPolynomial.X a : MvPolynomial (Fin (r + 2)) A') ∣
          (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ - MvPolynomial.C π') * h := by
        rw [← hh]; exact dvd_mul_left _ _
      rcases hprime.dvd_or_dvd h5 with h4 | ⟨h', rfl⟩
      · exact absurd h4 hnd
      · have hg : g = (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ -
            MvPolynomial.C π') * h' := by
          apply mul_right_cancel₀ hprime.ne_zero
          rw [hh]; ring
        apply Ideal.mem_span_singleton.mpr
        rw [h2, hg]
        exact dvd_mul_right _ _
    letI : Algebra (wcQmbtSSRing A' r π') C := ψ.toAlgebra
    haveI : Module.Flat (wcQmbtSSRing A' r π') C := hψ.flat
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := C) hM
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have hs : (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a) : wcQmbtSSRing A' r π') • x =
        (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a) : wcQmbtSSRing A' r π') • (0 : C) := by
      rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_comm]
      exact hx
    exact hreg hs

theorem wc_qmbt_nlp_chart_branch_domain {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (r : ℕ)
    (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)]
    (ψ : wcQmbtSSRing A' r π' →+* C)
    (hψ : @Algebra.WeaklyEtale (wcQmbtSSRing A' r π') C _ _ ψ.toAlgebra)
    (a a' : Fin (r + 2)) (ha : a.val < 2) (ha' : a'.val < 2) (hne : a ≠ a')
    (hm : ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a)) ∈ IsLocalRing.maximalIdeal C) :
    IsDomain (C ⧸ Ideal.span {ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a))}) ∧
    ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a')) ∉ Ideal.span {ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a))} :=
by
  have s2 : ∀ (M C : Type u) [CommRing M] [CommRing C] (ψ : M →+* C),
    @Algebra.WeaklyEtale M C _ _ ψ.toAlgebra → ∀ (I : Ideal M),
    WeaklyEtale (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map ψ) ψ Ideal.le_comap_map))) := by
    intro M C _ _ ψ hψ I
    letI : Algebra M C := ψ.toAlgebra
    haveI : Algebra.WeaklyEtale M C := hψ
    have hW := wc_lfi_specMap_weaklyEtale (M ⧸ I) (TensorProduct M (M ⧸ I) C) inferInstance
    let θ : TensorProduct M (M ⧸ I) C ≃+* C ⧸ I.map ψ :=
      (Algebra.TensorProduct.comm M (M ⧸ I) C).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot C I).symm.toRingEquiv
    have hcomp : (θ : TensorProduct M (M ⧸ I) C →+* C ⧸ I.map ψ).comp
        (algebraMap (M ⧸ I) (TensorProduct M (M ⧸ I) C)) =
        Ideal.quotientMap (I.map ψ) ψ Ideal.le_comap_map := by
      apply Ideal.Quotient.ringHom_ext
      ext m
      simp only [RingHom.comp_apply, Algebra.TensorProduct.algebraMap_apply, Ideal.quotientMap_mk]
      show (Algebra.TensorProduct.quotIdealMapEquivTensorQuot C I).symm
        ((Algebra.TensorProduct.comm M (M ⧸ I) C) (algebraMap M (M ⧸ I) m ⊗ₜ[M] (1 : C))) = _
      rw [Algebra.TensorProduct.comm_tmul, Ideal.Quotient.algebraMap_eq,
        Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul, Ideal.Quotient.mk_eq_mk,
        Algebra.smul_def, mul_one]
      rfl
    rw [← hcomp, CommRingCat.ofHom_comp, Spec.map_comp]
    exact MorphismProperty.RespectsIso.precomp @WeaklyEtale (Spec.map θ.toCommRingCatIso.hom) _ hW
  have s1 : ∃ e : (wcQmbtSSRing A' r π' ⧸ Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a)}) ≃+* MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A'),
      e (Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a)}) (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a'))) = MvPolynomial.X 0 := by
    classical

    have h2 : (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) =>
          if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q
        : MvPolynomial (Fin (r + 2)) A') =
        MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ := by
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · simp
        · intro q _ hq
          have hn' : ¬ ((⟨0, by omega⟩ : Fin (r + 2)).val = 0 ∧ q.val = 1) :=
            fun h => hq (Fin.ext h.2)
          rw [Matrix.of_apply, if_neg hn', map_zero, zero_mul, zero_mul]
        · simp
      · intro p _ hp
        apply Finset.sum_eq_zero
        intro q _
        have hn' : ¬ (p.val = 0 ∧ q.val = 1) := fun h => hp (Fin.ext h.1)
        rw [Matrix.of_apply, if_neg hn', map_zero, zero_mul, zero_mul]
      · simp
    have hQ : wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        Ideal.span {MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ -
          MvPolynomial.C π'} := by
      show Ideal.span {_ - _} = _
      rw [h2]
    have hne' : a.val ≠ a'.val := fun h => hne (Fin.ext h)
    have ha01 : a = ⟨0, by omega⟩ ∨ a = ⟨1, by omega⟩ := by
      by_cases h : a.val = 0
      · left; exact Fin.ext h
      · right; exact Fin.ext (by simp; omega)
    have hsa : a.succAbove 0 = a' := by
      unfold Fin.succAbove
      split_ifs with h <;> simp only [Fin.ext_iff, Fin.lt_iff_val_lt_val, Fin.coe_castSucc,
        Fin.val_succ, Fin.val_zero] at h ⊢ <;> omega
    have hres : IsLocalRing.residue A' π' = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr (hπ' ▸ Ideal.mem_span_singleton_self π')

    let v : Fin (r + 2) → MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A') :=
      Fin.insertNth (α := fun _ => MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A')) a 0
        (fun j => MvPolynomial.X j)
    have hva : v a = 0 := Fin.insertNth_apply_same _ _ _
    have hvs : ∀ j, v (a.succAbove j) = MvPolynomial.X j := fun j => Fin.insertNth_apply_succAbove _ _ _ _
    have hv01 : v ⟨0, by omega⟩ * v ⟨1, by omega⟩ = 0 := by
      rcases ha01 with h | h
      · rw [← h, hva, zero_mul]
      · rw [← h, hva, mul_zero]
    let Φ₀ : MvPolynomial (Fin (r + 2)) A' →+* MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A') :=
      MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (IsLocalRing.residue A')) v
    have hΦ₀X : ∀ i, Φ₀ (MvPolynomial.X i) = v i := fun i => MvPolynomial.eval₂Hom_X' _ _ _
    have hΦ₀C : ∀ x, Φ₀ (MvPolynomial.C x) = MvPolynomial.C (IsLocalRing.residue A' x) :=
      fun x => MvPolynomial.eval₂Hom_C _ _ _
    have hΦ₀Q : ∀ p ∈ wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0),
        Φ₀ p = 0 := by
      intro p hp
      rw [hQ, Ideal.mem_span_singleton'] at hp
      obtain ⟨y, rfl⟩ := hp
      rw [map_mul, map_sub, map_mul, hΦ₀X, hΦ₀X, hΦ₀C, hv01, hres, map_zero, sub_zero, mul_zero]
    let Φ₁ := Ideal.Quotient.lift _ Φ₀ hΦ₀Q
    have hΦ₁I : ∀ p ∈ Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X a)}, Φ₁ p = 0 := by
      intro p hp
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, Ideal.Quotient.lift_mk, hΦ₀X, hva, mul_zero]
    let Φ := Ideal.Quotient.lift _ Φ₁ hΦ₁I
    have hΦ : ∀ p, Φ (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ p)) = Φ₀ p := fun p => rfl

    let mkQ := Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    let mkI := Ideal.Quotient.mk (Ideal.span {mkQ (MvPolynomial.X a)})
    have hmkIa : mkI (mkQ (MvPolynomial.X a)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    let β : A' →+* _ := mkI.comp (mkQ.comp MvPolynomial.C)
    have hβπ : mkQ (MvPolynomial.C π') ∈ Ideal.span {mkQ (MvPolynomial.X a)} := by
      have e1 : mkQ (MvPolynomial.C π') = mkQ (MvPolynomial.X ⟨0, by omega⟩) *
          mkQ (MvPolynomial.X ⟨1, by omega⟩) := by
        rw [← map_mul, eq_comm, Ideal.Quotient.eq, hQ]
        exact Ideal.mem_span_singleton_self _
      rw [e1]
      rcases ha01 with h | h
      · rw [← h]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      · rw [← h]; exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hβ : ∀ x ∈ IsLocalRing.maximalIdeal A', β x = 0 := by
      intro x hx
      rw [hπ', Ideal.mem_span_singleton'] at hx
      obtain ⟨y, rfl⟩ := hx
      show mkI (mkQ (MvPolynomial.C (y * π'))) = 0
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      rw [map_mul, map_mul]
      exact Ideal.mul_mem_left _ _ hβπ
    let κ : IsLocalRing.ResidueField A' →+* _ := Ideal.Quotient.lift _ β hβ
    have hκ : ∀ x, κ (IsLocalRing.residue A' x) = β x := fun x => rfl
    let Ψ := MvPolynomial.eval₂Hom κ (fun j => mkI (mkQ (MvPolynomial.X (a.succAbove j))))
    have hΨX : ∀ j, Ψ (MvPolynomial.X j) = mkI (mkQ (MvPolynomial.X (a.succAbove j))) :=
      fun j => MvPolynomial.eval₂Hom_X' _ _ _
    have hΨC : ∀ c, Ψ (MvPolynomial.C c) = κ c := fun c => MvPolynomial.eval₂Hom_C _ _ _
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective c
        rw [RingHom.comp_apply, hΨC, hκ, RingHom.id_apply]
        show Φ (mkI (mkQ (MvPolynomial.C x))) = _
        rw [hΦ, hΦ₀C]
      · intro j
        rw [RingHom.comp_apply, hΨX, RingHom.id_apply, hΦ, hΦ₀X, hvs]
    have h2' : Ψ.comp Φ = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΦ, hΦ₀C, hΨC, hκ]
        rfl
      · intro i
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΦ, hΦ₀X]
        by_cases hi : i = a
        · subst hi
          rw [hva, map_zero]
          exact hmkIa.symm
        · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq hi
          rw [hvs, hΨX]
    refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2', ?_⟩
    show Φ (mkI (mkQ (MvPolynomial.X a'))) = _
    rw [hΦ, hΦ₀X, ← hsa, hvs]
  classical
  obtain ⟨e, he⟩ := s1
  have hW := s2 _ C ψ hψ (Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a)})
  generalize hI : Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a)} = I at e he hW
  have hJ : I.map ψ = Ideal.span {ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a))} := by
    rw [← hI, Ideal.map_span, Set.image_singleton]
  rw [← hJ]
  have hJt : I.map ψ ≠ ⊤ := by
    rw [hJ]
    intro h
    apply (IsLocalRing.maximalIdeal.isMaximal C).ne_top
    rw [eq_top_iff, ← h, Ideal.span_singleton_le_iff_mem]
    exact hm
  haveI : Nontrivial (C ⧸ I.map ψ) := Ideal.Quotient.nontrivial_iff.mpr hJt
  obtain ⟨hH, hS⟩ := wc_quot_strictly_henselian_of_ne_top C (I.map ψ) hJt
  letI := hH
  haveI := hS
  let ψb := Ideal.quotientMap (I.map ψ) ψ Ideal.le_comap_map
  have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (ψb.comp e.symm.toRingHom))) := by
    let eI : CommRingCat.of (MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A')) ≅
        CommRingCat.of (wcQmbtSSRing A' r π' ⧸ I) :=
      @RingEquiv.toCommRingCatIso (MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A'))
        (wcQmbtSSRing A' r π' ⧸ I) _ _ e.symm
    have key : Spec.map (CommRingCat.ofHom (ψb.comp e.symm.toRingHom)) =
        Spec.map (CommRingCat.ofHom ψb) ≫ Spec.map eI.hom := by
      rw [← Spec.map_comp]; rfl
    rw [key]
    exact MorphismProperty.RespectsIso.postcomp @WeaklyEtale (Spec.map eI.hom) _ hW
  haveI := wc_mvpoly_spec_smoothOfRelDim (IsLocalRing.ResidueField A') (r + 1)
  have hdom : IsDomain (C ⧸ I.map ψ) :=
    wc_strictHensel_weaklyEtale_smooth_isDomain (IsLocalRing.ResidueField A')
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A')
        (MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A'))))) (r + 1)
      (CommRingCat.of (C ⧸ I.map ψ)) _ hW'
  refine ⟨hdom, ?_⟩
  haveI : IsDomain (wcQmbtSSRing A' r π' ⧸ I) := MulEquiv.isDomain _ e.toMulEquiv
  have hx0 : Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a')) ≠ 0 := by
    intro h
    have h' := congrArg e h
    rw [he, map_zero] at h'
    exact MvPolynomial.X_ne_zero _ h'
  have key : ∀ (N D : Type u) [CommRing N] [IsDomain N] [CommRing D] [Nontrivial D]
      (f : N →+* D), WeaklyEtale (Spec.map (CommRingCat.ofHom f)) → ∀ x : N, x ≠ 0 → f x ≠ 0 := by
    intro N D _ _ _ _ f hf x hx hfx
    have hWE := wc_lpkt_specMap_weaklyEtale_ring N D f hf
    letI : Algebra N D := f.toAlgebra
    haveI : Algebra.WeaklyEtale N D := hWE
    haveI : Module.Flat N D := Algebra.WeaklyEtale.flat
    have hreg : IsSMulRegular N x := IsSMulRegular.of_ne_zero hx
    have hreg' : IsSMulRegular D (algebraMap N D x) := hreg.of_flat
    have h0 : algebraMap N D x = 0 := hfx
    rw [h0] at hreg'
    exact IsSMulRegular.not_zero hreg'
  intro hmem
  refine key (wcQmbtSSRing A' r π' ⧸ I) (C ⧸ I.map ψ) ψb hW
    (Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X a'))) (fun h => hx0 h) ?_
  show Ideal.quotientMap (I.map ψ) ψ Ideal.le_comap_map _ = 0
  rw [Ideal.quotientMap_mk]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem

theorem wc_qmbt_nlp_chart_at_point {A' : Type u} [CommRing A'] {π' : A'}
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    (C : Type u) [CommRing C] [IsLocalRing C] (cC : Spec (.of C) ⟶ Xm) (hcC : WeaklyEtale cC) :
    ∃ (r : ℕ) (ψ : wcQmbtSSRing A' r π' →+* C),
      @Algebra.WeaklyEtale (wcQmbtSSRing A' r π') C _ _ ψ.toAlgebra ∧
      ψ.comp (algebraMap A' (wcQmbtSSRing A' r π')) = (Spec.preimage (cC ≫ f)).hom :=
by
  obtain ⟨U, r, g, hzU, hg, hgf⟩ := hcov (cC (IsLocalRing.closedPoint C))
  haveI := hg
  haveI := hcC
  have H : Set.range cC ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    exact ((IsLocalRing.specializes_closedPoint x).map cC.continuous).mem_open U.isOpen hzU
  set cU := IsOpenImmersion.lift U.ι cC H with hcU
  have hfac : cU ≫ U.ι = cC := IsOpenImmersion.lift_fac U.ι cC H
  haveI hcUe : WeaklyEtale cU :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsOpenImmersion.isPullback_lift_id cC U.ι H).flip hcC
  set h := cU ≫ g with hh
  haveI hhe : WeaklyEtale h := inferInstance
  refine ⟨r, (Spec.preimage h).hom, ?_, ?_⟩
  · have hring : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
        WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) →
          @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
      intro R S _ _ ψ hW
      letI : Algebra R S := ψ.toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
      have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
        ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
      have h2 := hW'.flat_diagonal
      rw [diagonal_SpecMap] at h2
      have h3 : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
        have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
              (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [e]
        exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
      exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)
    apply hring
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    exact hhe
  · have key : CommRingCat.ofHom ((Spec.preimage h).hom.comp
        (algebraMap A' (wcQmbtSSRing A' r π'))) = Spec.preimage (cC ≫ f) := by
      apply Spec.map_injective
      rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_preimage,
        Spec.map_preimage]
      have e : Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' r π'))) =
          wcQuadModelStr A' (r + 2) π'
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) :=
        rfl
      rw [e, hh, Category.assoc, hgf, ← Category.assoc, hfac]
    have := congrArg CommRingCat.Hom.hom key
    rw [CommRingCat.hom_ofHom] at this
    exact this

theorem wc_qmbt_nlp_x_conditions {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {Y : Scheme.{u}} (iY : Y ⟶ Xs') [IsClosedImmersion iY]
    (hYset : Set.range iY =
      closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})
    (V : Fin n → Xm.Opens)
    (hB0 : ∀ j i : Fin n, ∃ b : Γ(Xm, V j),
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X i)))) =
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))) * b)
    (hB1 : ∀ j : Fin n, ∃ b : Γ(Xm, V j),
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π')) =
        (Xm.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op).hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))) * b) :
    ∀ (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (cC : Spec (.of C) ⟶ Xm), WeaklyEtale cC →
      cC (IsLocalRing.closedPoint C) ∈ Set.range (iY ≫ ι') →
      ∀ (j : Fin n), cC (IsLocalRing.closedPoint C) ∈ V j →
      (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom (cC.appTop.hom
          ((bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
