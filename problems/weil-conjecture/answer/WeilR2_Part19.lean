    _ (Limits.pullback.snd (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))))
