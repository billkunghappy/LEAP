theorem wc_et_closed_rightAdj_cycle_class_bdry_gen : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (ℓ : ℕ) (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive] (adj : @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (q : ℕ) (DW : ∀ W : Y.Etale, wcEtPullData (Limits.pullback.fst W.hom i) ℓ), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; ∃ cl : ∀ W : Y.Etale, (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) → wcEtSuppExt (DW W) q, (∀ (W : Y.Etale) (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))) (k : ℕ), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → cl W (k • x) = k • cl W x) ∧ (∀ (W : Y.Etale) (x y : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 → cl W x = cl W y → ∃ e : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom e = x - y) ∧ (∀ (W W₂ : Y.Etale) (h : W₂ ⟶ W) (Eh : wcEtPullData h.left ℓ) (γ : wcEtSuppObj (DW W₂) ⟶ Eh.Φ.obj (wcEtSuppObj (DW W))), wcEtSuppUnitMap (DW W₂) ≫ γ = Eh.μ.inv ≫ Eh.Φ.map (wcEtSuppUnitMap (DW W)) → ∀ x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → wcEtSuppRestr (DW W) Eh (DW W₂) γ q (cl W x) = cl W₂ (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x)) ∧ (∀ (W : Y.Etale) (EW : wcEtPullData W.hom ℓ) (γ