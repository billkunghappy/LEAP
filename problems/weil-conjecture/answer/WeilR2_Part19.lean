  have L5 : ∃ (τ : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (2 * e + 1)) Ω) (u : Fin (2 * e + 2 + 1)) (s : Fin (2 * e + 1) → Fin (2 * e + 2 + 1)), τ ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩ = 1 ∧ (∀ b : Fin (2 * e + 1), τ (s b) = MvPolynomial.X b) ∧ (∀ j : Fin (2 * e + 2 + 1), j ≠ ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩ → j ≠ u → ∃ b : Fin (2 * e + 1), s b = j) ∧ (∀ (B : Type u) [CommRing B] (φ : Ω →+* B) (t : Fin (2 * e + 2 + 1) → B), t ⟨if k ≤ e then 2 * k + 1 else 2 * e + 1, by split_ifs <;> omega⟩ = 1 → MvPolynomial.eval₂ φ t (wcLdpQuad Ω (2 * e + 2) (wcXspSplitCoeff Ω e) : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = t u - MvPolynomial.eval₂ φ (fun b => t (s b)) (τ u)) ∧ ∀ I : Ideal (MvPolynomial (Fin (2 * e + 1)) Ω), (∃ i : ℕ, i < k ∧ τ ⟨if i ≤ e then 2 * i + 1 else 2 * e + 1, by split_ifs <;> omega⟩ ∉ I) ↔ ∃ j : Fin (2 * e + 1), j.val < k ∧ (MvPolynomial.X j : MvPolynomial (Fin (2 * e + 1)) Ω) ∉ I := by
