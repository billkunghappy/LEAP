    rw [Nat.card_congr I2, ← hred, ← Nat.card_congr I1, hcardR]
  have hsubFK := (Nat.card_eq_one_iff_unique.mp hcardFK).1

  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst
    (Limits.pullback.snd f₀ (wcQmSp B₀))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ℓ
  have hbij := wc_et_sepclosed_field_ext_proper_pull_bij (IsLocalRing.ResidueField B₀)
    (AlgebraicClosure (IsLocalRing.ResidueField B₀))
    (algebraMap (IsLocalRing.ResidueField B₀) (AlgebraicClosure (IsLocalRing.ResidueField B₀)))
    (Limits.pullback f₀ (wcQmSp B₀)) (Limits.pullback.snd f₀ (wcQmSp B₀)) _ _ _
    (IsPullback.of_hasPullback _ _) ℓ hℓk D (2 * e + 1)
  obtain ⟨Z1⟩ := wc_et_zmodext_coh_equiv (Limits.pullback f₀ (wcQmSp B₀)) ℓ (2 * e + 1)
  obtain ⟨Z2⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (Limits.pullback.snd f₀ (wcQmSp B₀))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ℓ (2 * e + 1)
  have hsubF : Subsingleton (wcEtCoh (Limits.pullback f₀ (wcQmSp B₀)) ℓ (2 * e + 1)) :=
