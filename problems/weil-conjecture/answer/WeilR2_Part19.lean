  haveI : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 Y)).left) := hsepY
  exact wc_proet_free_zmod_ext_vanish_of_et_qcsep Y (Scheme.ProEt.mk (𝟙 Y)) _ _
    (wc_et_coh_zmod_prime_pow_of_prime Y ℓ Fact.out (j + 1) hYs k')

theorem wc_qmbt_csz_pp_closed_point {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    {ℓ : ℕ} (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A)) :
    ∃ x : Spec (.of (IsLocalRing.ResidueField B₀)) ⟶ Xs, IsClosedImmersion x ∧
      x ≫ ι = wcQmSp B₀ ∧
      ι (x (IsLocalRing.closedPoint (IsLocalRing.ResidueField B₀))) = IsLocalRing.closedPoint B₀ ∧
      (∀ z : Xs, ι z = IsLocalRing.closedPoint B₀ →
        z = x (IsLocalRing.closedPoint (IsLocalRing.ResidueField B₀))) ∧
      ((ℓ : ℕ) : IsLocalRing.ResidueField B₀) ≠ 0 :=
by
  classical

  have hres : ∀ (T : Type u) [CommRing T] [IsLocalRing T]
      (q : Spec (.of (IsLocalRing.ResidueField T))),
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue T))) q = IsLocalRing.closedPoint T := by
    intro T _ _ q
    have hq : q = IsLocalRing.closedPoint (IsLocalRing.ResidueField T) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField T)) _ _
    exact (Spec.map_apply ..).trans ((congrArg (PrimeSpectrum.comap (IsLocalRing.residue T)) hq).trans
      (IsLocalRing.comap_closedPoint (IsLocalRing.residue T)))

  have hcp : a₀ (IsLocalRing.closedPoint B₀) = x₀ := by
    obtain ⟨-, -, -, -, -, e, -, h⟩ := hsh
    obtain ⟨pt⟩ : Nonempty (Spec (.of (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀)))) :=
      ⟨IsLocalRing.closedPoint (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A n π c))).residueField x₀))⟩
    have h2 : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B₀)) ≫ a₀) pt =
        (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀) pt := by rw [h]
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h2
    rw [hres] at h2
    first
      | exact h2.trans (Scheme.fromSpecResidueField_apply ..)
      | (erw [Scheme.fromSpecResidueField_apply] at h2; exact h2)

  set ψ : A →+* B₀ := (Spec.preimage (a₀ ≫ wcQuadModelStr A n π c)).hom with hψ
  have hSψ : Spec.map (CommRingCat.ofHom ψ) = a₀ ≫ wcQuadModelStr A n π c := by
    simp only [ψ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hcomap : Ideal.comap ψ (IsLocalRing.maximalIdeal B₀) =
      Ideal.comap (algebraMap A (wcQuadModelRing A n π c)) x₀.asIdeal := by
    have h1 : (Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint B₀) =
        (wcQuadModelStr A n π c) x₀ :=
      (congrArg (fun f : Spec (.of B₀) ⟶ Spec (.of A) => f (IsLocalRing.closedPoint B₀)) hSψ).trans
        ((Scheme.Hom.comp_apply ..).trans (congrArg (wcQuadModelStr A n π c) hcp))
    have h3 := congrArg PrimeSpectrum.asIdeal
      ((Spec.map_apply ..).symm.trans (h1.trans (Spec.map_apply ..)))
    exact h3
  have hπmem : algebraMap A (wcQuadModelRing A n π c) π ∈ x₀.asIdeal := by
    have e0 : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) :=
      Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
    have e1 : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
        algebraMap A (wcQuadModelRing A n π c) π :=
      e0.trans (by first
        | rfl
        | (rw [Ideal.Quotient.algebraMap_eq]; rfl)
        | simp [Ideal.Quotient.mk_algebraMap])
    rw [← e1]
    simp only [map_sum, map_mul]
    exact Ideal.sum_mem _ (fun p _ => Ideal.sum_mem _ (fun q _ =>
      Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (hx₀ p))))
  have hle : IsLocalRing.maximalIdeal A ≤ Ideal.comap ψ (IsLocalRing.maximalIdeal B₀) := by
    rw [hπ, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, hcomap, Ideal.mem_comap]
    exact hπmem
  haveI hloc : IsLocalHom ψ := ((IsLocalRing.local_hom_TFAE ψ).out 4 1).mp hle

  let κ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField B₀ :=
    IsLocalRing.ResidueField.map ψ
  have w : wcQmSp B₀ ≫ (a₀ ≫ wcQuadModelStr A n π c) =
      Spec.map (CommRingCat.ofHom κ) ≫ wcQmSp A := by
    rw [← hSψ, wcQmSp, wcQmSp, ← Spec.map_comp, ← Spec.map_comp]
    congr 1 <;> first
      | done
      | (ext r; simp [κ, IsLocalRing.ResidueField.map_residue])
  let x := hps.lift (wcQmSp B₀) (Spec.map (CommRingCat.ofHom κ)) w
  have hxι : x ≫ ι = wcQmSp B₀ := hps.lift_fst _ _ w

  haveI hQA : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hQB : IsClosedImmersion (wcQmSp B₀) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hι : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip hQA
  haveI : IsClosedImmersion (x ≫ ι) := by rw [hxι]; exact hQB
  have hci : IsClosedImmersion x := IsClosedImmersion.of_comp_isClosedImmersion x ι

  have hxcp : ι (x (IsLocalRing.closedPoint (IsLocalRing.ResidueField B₀))) =
      IsLocalRing.closedPoint B₀ :=
    (Scheme.Hom.comp_apply x ι (IsLocalRing.closedPoint (IsLocalRing.ResidueField B₀))).symm.trans
      ((congrArg (fun f : Spec (.of (IsLocalRing.ResidueField B₀)) ⟶ Spec (.of B₀) =>
        f (IsLocalRing.closedPoint (IsLocalRing.ResidueField B₀))) hxι).trans (hres B₀ _))
  refine ⟨x, hci, hxι, hxcp, ?_, ?_⟩
  · intro z hz
    exact ι.isClosedEmbedding.isEmbedding.injective (hz.trans hxcp.symm)

  · have hB : IsUnit ((ℓ : ℕ) : B₀) := by simpa using hℓ.map ψ
    have hk := hB.map (IsLocalRing.residue B₀)
    rw [map_natCast] at hk
    exact hk.ne_zero

theorem wc_strict_hens_proper_zmod_proet_finite (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (T : Scheme.{u}) (f : T ⟶ Spec (.of A))
    [IsProper f] [CompactSpace T] [QuasiSeparatedSpace T] (m : ℕ)
    (hm : ((m : ℕ) : IsLocalRing.ResidueField A) ≠ 0) (j : ℕ) :
    Finite (wcZModProEtExt T m j) :=
by
  classical
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero
