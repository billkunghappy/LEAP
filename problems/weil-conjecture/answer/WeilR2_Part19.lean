        (Scheme.IdealSheafData.coe_support_vanishingIdeal _)⟩
  haveI := hix
  obtain ⟨Dx, hDx⟩ := wc_hm_pull_data_exists ix ℓ

  obtain ⟨-, S, E, can, δ, σ, hT, -⟩ := wc_qmbt_pn_xs_skyscraper_triangle hℓ hn hn4 hπ hc hx₀
    hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' hP' hC
    ix hrange Dx hDx

  have hproj : Projective (SheafOfModules.unit (wcRingSheaf Xs ℓ)) := by
    have hprojGen : ∀ (S : Scheme.{u}) (R' : Type u) [CommRing R'] [HenselianLocalRing R']
        [IsSepClosed (IsLocalRing.ResidueField R')] (_eS : S ≅ Spec (.of R')),
        Projective (SheafOfModules.unit (wcRingSheaf S ℓ)) := by
      intro S R' _ _ _ eS
      have hT : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 S)) :=
        Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
          (fun V m => MorphismProperty.Over.Hom.ext
            ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
      have hfree : Projective (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) :=
        wc_proet_free_projective_strict_local S (Scheme.ProEt.mk (𝟙 S)) R' eS
      obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
        (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) (Scheme.ProEt.mk (𝟙 S)) hT
      haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) :=
        sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
      haveI : Projective ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Scheme.ProEt.mk (𝟙 S)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
        hfree
      refine ⟨fun {E X} f p _ => ?_⟩
      haveI : Epi ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map p) := Functor.map_epi _ p
      obtain ⟨φ₁, hφ₁⟩ := Projective.factors (ε ≫ (SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map f)
        ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map p)
      obtain ⟨f', hf'⟩ := (hε E).2 φ₁
      refine ⟨f', (hε X).1 ?_⟩
      dsimp only at hf' ⊢
      rw [Functor.map_comp, ← Category.assoc, hf', hφ₁]
    obtain ⟨α, ha₀⟩ : ∃ α : wcQuadModelRing A n π c →+* B₀,
        Spec.map (CommRingCat.ofHom α) = a₀ :=
      ⟨(Spec.preimage a₀).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    obtain ⟨φ, hφdef⟩ : ∃ φ : A →+* B₀, φ = α.comp (algebraMap A (wcQuadModelRing A n π c)) :=
      ⟨_, rfl⟩
    have hφ : Spec.map (CommRingCat.ofHom φ) = a₀ ≫ wcQuadModelStr A n π c := by
      rw [hφdef, CommRingCat.ofHom_comp, Spec.map_comp, ha₀]
    have hres : ∀ q : Spec (CommRingCat.of (IsLocalRing.ResidueField B₀)),
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)) q = IsLocalRing.closedPoint B₀ :=
      fun q => IsLocalRing.PrimeSpectrum.comap_residue B₀ q
    have hpt : a₀ (IsLocalRing.closedPoint B₀) = x₀ := by
      obtain ⟨e, -, he⟩ := hsh.2.2.2.2.2
      let pt : ↥(Spec (CommRingCat.of (AlgebraicClosure
          ↑((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀)))) :=
        IsLocalRing.closedPoint _
      have h : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
          (IsLocalRing.residue B₀)) ≫ a₀) pt =
          wcEtGeomPt (Spec (CommRingCat.of (wcQuadModelRing A n π c))) x₀ pt := by
        rw [he]
      simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h
      rw [hres] at h
      exact h.trans (Scheme.fromSpecResidueField_apply x₀ _)
    have hx₀' : x₀ = Spec.map (CommRingCat.ofHom α) (IsLocalRing.closedPoint B₀) := by
      rw [ha₀, hpt]
    have hX : ∀ p, α (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
        IsLocalRing.maximalIdeal B₀ := by
      intro p
      have h := hx₀ p
      rw [hx₀'] at h
      exact h
    have hπm : φ π ∈ IsLocalRing.maximalIdeal B₀ := by
      have h1 : algebraMap A (wcQuadModelRing A n π c) π =
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) := by
        show algebraMap A (MvPolynomial (Fin n) A ⧸ wcQuadModelIdeal A n π c) π = _
        rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.eq]
        have e1 : MvPolynomial.C π - ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
              MvPolynomial.X q =
            -(∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
              MvPolynomial.C π) := by ring
        rw [e1]
        exact neg_mem (Ideal.mem_span_singleton_self _)
      rw [hφdef, RingHom.comp_apply, h1]
      simp only [map_sum, map_mul]
      exact Ideal.sum_mem _ fun p _ => Ideal.sum_mem _ fun q _ => Ideal.mul_mem_left _ _ (hX q)
    have hJ : Ideal.map φ (IsLocalRing.maximalIdeal A) ≠ ⊤ := by
      intro htop
      have hle : Ideal.map φ (IsLocalRing.maximalIdeal A) ≤ IsLocalRing.maximalIdeal B₀ := by
        rw [Ideal.map_le_iff_le_comap, hπ, Ideal.span_singleton_le_iff_mem]
        exact hπm
      rw [htop] at hle
      exact (IsLocalRing.maximalIdeal.isMaximal B₀).ne_top (top_le_iff.mp hle)
    rw [← hφ] at hps
    have eX : Xs ≅ Spec (CommRingCat.of (B₀ ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A))) := by
      letI : Algebra A B₀ := φ.toAlgebra
      have h2 := isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct A B₀ (IsLocalRing.ResidueField A))
      try rw [RingHom.algebraMap_toAlgebra] at h2
      try rw [IsLocalRing.ResidueField.algebraMap_eq] at h2
      exact hps.isoIsPullback _ _ h2 ≪≫ Scheme.Spec.mapIso
        ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B₀
          (IsLocalRing.maximalIdeal A)).toRingEquiv.toCommRingCatIso.op)
    obtain ⟨hh, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B₀ _ hJ
    exact @hprojGen Xs (B₀ ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)) _ hh hsep eX

  have hz : ∀ z : DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) (ComplexShape.up ℤ) (n : ℤ)).obj
          (SheafOfModules.unit (wcRingSheaf Xs ℓ))) ⟶
        (Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))), z = 0 := by
    intro z
    have h1 : z ≫ can ≫ σ.hom = 0 :=
      DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective
        (P := SheafOfModules.unit (wcRingSheaf Xs ℓ)) (i := (n : ℤ))
        (L := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
          (ComplexShape.up ℤ) ((n : ℤ) - 1)).obj (wcSuppObj Dx))
        _ ((n : ℤ) - 1) (by omega)
    have h2 : z ≫ can = 0 := by
      rw [← cancel_mono σ.hom, Category.assoc, h1, Limits.zero_comp]
    obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT z h2
    have hg0 : g = 0 :=
      DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective
        (P := SheafOfModules.unit (wcRingSheaf Xs ℓ)) (i := (n : ℤ))
        (L := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
          (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcRingSheaf Xs ℓ)))
        _ 0 (by omega)
    rw [hg, hg0, Limits.zero_comp]

  obtain ⟨α₁, hα₁⟩ : ∃ α₁ : (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        (ComplexShape.up ℤ) (n : ℤ)).obj (SheafOfModules.unit (wcRingSheaf Xs' ℓ)) ⟶
        (Dβ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
            (ComplexShape.up ℤ) (n : ℤ)).obj (SheafOfModules.unit (wcRingSheaf Xs ℓ))),
      α₁ = (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
        (ComplexShape.up ℤ) (n : ℤ)).map Dβ.μ.inv ≫
      (HomologicalComplex.singleMapHomologicalComplex Dβ.Φ (ComplexShape.up ℤ)
        (n : ℤ)).inv.app (SheafOfModules.unit (wcRingSheaf Xs ℓ)) := ⟨_, rfl⟩
  haveI : IsIso α₁ := by rw [hα₁]; infer_instance
  obtain ⟨τ, -, -, hτ0⟩ := wc_rdfp_plus_adj_transpose Pβ Dβ.Φ Dβ.adj
  have hw : ∀ w : DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) (n : ℤ)).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))) ⟶
        DerivedCategory.Q.obj ((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K'),
      w = 0 := by
    intro w
    have e1 : inv (DerivedCategory.Q.map α₁) ≫ w = 0 := by
      have h0 := hz ((τ _ (⟨_, hP'⟩ : DerivedCategory.Plus
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))).symm (inv (DerivedCategory.Q.map α₁) ≫ w))
      have h3 := congrArg (τ _ (⟨_, hP'⟩ : DerivedCategory.Plus
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))) h0
      rw [Equiv.apply_symm_apply, hτ0] at h3
      exact h3
    rw [← IsIso.hom_inv_id_assoc (DerivedCategory.Q.map α₁) w, e1, Limits.comp_zero]

  let σ₁ : (DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) (n : ℤ)).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))))⟦(1 : ℤ)⟧ ≅
      DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) ((n : ℤ) - 1)).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))) :=
    ((DerivedCategory.Q.commShiftIso (1 : ℤ)).app _).symm ≪≫
      DerivedCategory.Q.mapIso (((CochainComplex.singleFunctors
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))).shiftIso 1 ((n : ℤ) - 1) (n : ℤ)
          (by omega)).app _)
  have hsv : σ₁.hom ≫ v = 0 := by
    have e2 : σ₁.hom ≫ v = (shiftFunctor (DerivedCategory (SheafOfModules.{u+1}
        (wcRingSheaf Xs' ℓ))) (1 : ℤ)).map ((shiftFunctor (DerivedCategory
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) (1 : ℤ)).preimage (σ₁.hom ≫ v)) :=
      (Functor.map_preimage _ _).symm
    refine e2.trans ?_
    rw [hw ((shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))
      (1 : ℤ)).preimage (σ₁.hom ≫ v)), Functor.map_zero]
  rw [← cancel_epi σ₁.hom, hsv, Limits.comp_zero]

theorem wc_qxs_split_odd_quadric_top_counts : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)], (ℓ : Ω) ≠ 0 →
    ∀ (e : ℕ) (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y]
      (jY : Y ⟶ wcProjK Ω (2 * e + 2)),
    IsClosedImmersion jY → Set.range jY = wcXspVplus Ω (2 * e + 2) (wcXspSplitCoeff Ω e) →
    Nat.card (wcEtCoh Y ℓ (2 * e + 2)) = ℓ ∧ Subsingleton (wcEtCoh Y ℓ (2 * e + 3)) :=
by
  classical
  intro Ω _ _ ℓ _ hℓ e Y _ jY hjY hY
  have hℓp : ℓ.Prime := Fact.out
  haveI := hjY



  have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
      (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
      IsClosedImmersion (Proj.map f hf) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
      (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
    intro i
    have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
    let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
    let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
    let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
    have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
    have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
      simp only [iV, iU, Proj.opensRange_awayι]
      exact Proj.map_preimage_basicOpen f hf (s i)
    have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
    have hg : IsClosedImmersion g :=
      IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
    have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
          (by
            dsimp only [Arrow.mk_hom, Iso.refl_hom]
            rw [Category.comp_id]
            exact IsPullback.isoPullback_hom_snd _))).mp hg
    have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
      (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictOpensRange _ iV)).mpr h1
    exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
      (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2
  have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
      ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
    obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
    obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
    exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩
  have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) Ω),
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
      p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) Ω) ↔
        p.coeff 0 = 0 := by
    intro n p
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) Ω) := MvPolynomial.gradedAlgebra
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    erw [MvPolynomial.decomposition.decompose'_apply]
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
  letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
    MvPolynomial.gradedAlgebra

  let g : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (e + 1)) Ω := fun t =>
    if h : t.val % 2 = 0 ∧ t.val / 2 < e + 1 then MvPolynomial.X ⟨t.val / 2, h.2⟩ else 0
  let c : Fin (e + 1) → Fin (2 * e + 2 + 1) := fun j => ⟨2 * j.val, by have := j.isLt; omega⟩
  have hg : ∀ t, (g t).IsHomogeneous 1 := by
    intro t
    dsimp only [g]
    split_ifs
    · exact MvPolynomial.isHomogeneous_X Ω _
    · exact MvPolynomial.isHomogeneous_zero _ _ 1
  have hgc : ∀ j, g (c j) = MvPolynomial.X j := by
    intro j
    have h : (c j).val % 2 = 0 ∧ (c j).val / 2 < e + 1 := by
      show 2 * j.val % 2 = 0 ∧ 2 * j.val / 2 < e + 1
      have := j.isLt; omega
    dsimp only [g]
    rw [dif_pos h]
    congr 1
    exact Fin.ext (by show 2 * j.val / 2 = j.val; omega)
  have hX0 : ∀ t, g t = 0 ↔ ¬ (t.val % 2 = 0 ∧ t.val / 2 < e + 1) := by
    intro t
    by_cases h : t.val % 2 = 0 ∧ t.val / 2 < e + 1
    · have h' : g t = MvPolynomial.X ⟨t.val / 2, h.2⟩ := by dsimp only [g]; rw [dif_pos h]
      rw [h']
      exact iff_of_false (MvPolynomial.X_ne_zero _) (not_not.mpr h)
    · have h' : g t = 0 := by dsimp only [g]; rw [dif_neg h]
      exact iff_of_true h' h
  have hsurjc : ∀ t, g t ≠ 0 → ∃ j, c j = t := by
    intro t ht
    have h : t.val % 2 = 0 ∧ t.val / 2 < e + 1 := by
      by_contra h
      exact ht ((hX0 t).mpr h)
    exact ⟨⟨t.val / 2, h.2⟩, Fin.ext (by show 2 * (t.val / 2) = t.val; omega)⟩
  have hT : ∀ t : Fin (2 * e + 2 + 1), g t = 0 ↔ (t.val % 2 = 1 ∨ t.val = 2 * e + 2) := by
    intro t
    rw [hX0]
    have := t.isLt
    omega

  let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) :=
    ⟨(MvPolynomial.aeval g).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      have := hx.aeval g hg
      rw [one_mul] at this
      exact this⟩
  let ψ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω)
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) :=
    ⟨(MvPolynomial.rename c).toRingHom, fun {n x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      exact hx.rename_isHomogeneous⟩
  have hφ : ∀ a, φ a = MvPolynomial.aeval g a := fun a => rfl
  have hψ : ∀ b, ψ b = MvPolynomial.rename c b := fun b => rfl
  have hφψ : ∀ b, φ (ψ b) = b := by
    intro b
    rw [hφ, hψ, MvPolynomial.aeval_rename]
    have hgc' : g ∘ c = MvPolynomial.X := funext hgc
    rw [hgc', MvPolynomial.aeval_X_left_apply]
  have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) ≤
      HomogeneousIdeal.map φ
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)) := by
    intro b hb
    have hb0 : b.coeff 0 = 0 := (s1 (e + 1) b).mp hb
    have hψb : ψ b ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) := by
      apply (s1 (2 * e + 2 + 1) (ψ b)).mpr
      rw [hψ]
      rw [← MvPolynomial.constantCoeff_eq] at hb0 ⊢
      exact (MvPolynomial.constantCoeff_rename c b).trans hb0
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map, ← hφψ b]
    exact Ideal.mem_map_of_mem φ (HomogeneousIdeal.mem_iff.mpr hψb)
  have hdeg : ∀ (n : ℕ) (b : MvPolynomial (Fin (e + 1)) Ω),
      b ∈ MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω n →
      ∃ a ∈ MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω n, φ a = b :=
    fun n b hb => ⟨ψ b, ψ.map_mem hb, hφψ b⟩
  have hcov : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (2 * e + 2 + 1) → MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) := by
    intro x hx
    have hx0 : x.coeff 0 = 0 := (s1 (2 * e + 2 + 1) x).mp (HomogeneousIdeal.mem_iff.mp hx)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hx0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  have hX : ∀ i : Fin (2 * e + 2 + 1),
      (MvPolynomial.X i : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X Ω i)

  let L : wcProjK Ω e ⟶ wcProjK Ω (2 * e + 2) := Proj.map φ hf
  have hLci : IsClosedImmersion L := s4 φ hf (fun i : Fin (2 * e + 2 + 1) => MvPolynomial.X i)
    (fun _ => 1) hX (fun _ => Nat.one_pos) hcov (fun i => s3 φ hdeg _ 1 (hX i))
  haveI := hLci
  have hpre : ∀ a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      L ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω) a =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω) (φ a) :=
    fun a => Proj.map_preimage_basicOpen φ hf a

  let f₀ : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) →+*
      ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω 0) :=
    { toFun := fun a => ⟨φ a, φ.map_mem a.2⟩
      map_one' := Subtype.ext (by
        show φ ((1 : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one])
      map_mul' := fun a b => Subtype.ext (by
        show φ ((a * b : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [SetLike.GradeZero.coe_mul, SetLike.GradeZero.coe_mul, map_mul])
      map_zero' := Subtype.ext (by
        show φ ((0 : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [ZeroMemClass.coe_zero, ZeroMemClass.coe_zero, map_zero])
      map_add' := fun a b => Subtype.ext (by
        show φ ((a + b : ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) :
          MvPolynomial (Fin (2 * e + 2 + 1)) Ω) = _
        rw [AddMemClass.coe_add, AddMemClass.coe_add, map_add]) }
  have hLstr : L ≫ wcProjKStr Ω (2 * e + 2) = wcProjKStr Ω e := by
    have hb := wc_bc_proj_map_toSpecZero φ hf f₀ (fun a => rfl)
    have hcomp : f₀.comp (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0)) =
        algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) Ω 0) := by
      apply RingHom.ext
      intro r
      apply Subtype.ext
      show φ ((algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω 0) r :
        MvPolynomial (Fin (2 * e + 2 + 1)) Ω)) = _
      rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ]
      exact (MvPolynomial.aeval g).commutes r
    show L ≫ (Proj.toSpecZero _ ≫ Spec.map _) = Proj.toSpecZero _ ≫ Spec.map _
    rw [← Category.assoc, hb, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]

  have hret : ∀ a : MvPolynomial (Fin (2 * e + 2 + 1)) Ω,
      a - ψ (φ a) ∈ Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}) := by
    intro a
    have key : (Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0}))).comp
        ((MvPolynomial.rename c).comp (MvPolynomial.aeval g)) =
        Ideal.Quotient.mkₐ Ω (Ideal.span (MvPolynomial.X '' {t : Fin (2 * e + 2 + 1) | g t = 0})) := by
      apply MvPolynomial.algHom_ext
      intro t
      rw [AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.aeval_X]
      by_cases ht : g t = 0
      · rw [ht, map_zero, map_zero, Ideal.Quotient.mkₐ_eq_mk, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span ⟨t, ht, rfl⟩
      · obtain ⟨j, rfl⟩ := hsurjc t ht
        rw [hgc, MvPolynomial.rename_X]
    have h2 := congrArg (fun F => F a) key
    simp only [AlgHom.comp_apply] at h2
    rw [Ideal.Quotient.mkₐ_eq_mk] at h2
    rw [hφ, hψ]
    exact Ideal.Quotient.eq.mp h2.symm

  have hrange : ∀ p : wcProjK Ω (2 * e + 2), p ∈ Set.range L ↔
      ∀ t, g t = 0 → (MvPolynomial.X t : MvPolynomial (Fin (2 * e + 2 + 1)) Ω) ∈ p.asHomogeneousIdeal := by
    intro p
    constructor
    · rintro ⟨z, rfl⟩ t ht
      by_contra hn
      have h1 : L z ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (2 * e + 2 + 1)) Ω)
