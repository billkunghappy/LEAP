    wc_et_coh_zmod_prime_pow_of_prime Xs' ℓ (Fact.out : ℓ.Prime) (2 * e + 1) hsubX
  haveI : CompactSpace (Scheme.ProEt.mk (𝟙 Xs')).left := hcpt
  haveI : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 Xs')).left) := hsep
  have hZ : ∀ k : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf Xs' (Scheme.ProEt.mk (𝟙 Xs')))
