            Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X c)) ^ n *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K)) F := by
            rw [hu1, one_pow, one_mul]
