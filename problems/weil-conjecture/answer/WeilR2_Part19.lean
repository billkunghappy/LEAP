  have resres2 : ∀ (A B C D : (E.Opens)ᵒᵖ) (f : A ⟶ B) (g : B ⟶ D) (f' : A ⟶ C) (g' : C ⟶ D)
      (y : E.presheaf.obj A),
      (E.presheaf.map g).hom ((E.presheaf.map f).hom y) =
        (E.presheaf.map g').hom ((E.presheaf.map f').hom y) := by
    intro A B C D f g f' g' y
    show (E.presheaf.map f ≫ E.presheaf.map g).hom y = (E.presheaf.map f' ≫ E.presheaf.map g').hom y
    rw [← Functor.map_comp, ← Functor.map_comp]
    first
      | rfl
      | exact congrArg (fun k => (E.presheaf.map k).hom y) (Subsingleton.elim _ _)
  have resres1 : ∀ (A B D : (E.Opens)ᵒᵖ) (f : A ⟶ B) (g : B ⟶ D) (k : A ⟶ D)
      (y : E.presheaf.obj A),
      (E.presheaf.map g).hom ((E.presheaf.map f).hom y) = (E.presheaf.map k).hom y := by
    intro A B D f g k y
    show (E.presheaf.map f ≫ E.presheaf.map g).hom y = (E.presheaf.map k).hom y
    rw [← Functor.map_comp]
    first
      | rfl
      | exact congrArg (fun k' => (E.presheaf.map k').hom y) (Subsingleton.elim _ _)
  have cn : ∀ (V : E.Opens) (h : wcQxeV K jE l ⊓ wcQxeV K jE m ≤ V) (x : K),
