  haveI : ∀ x : E₀.left, IsDomain (E₀.left.presheaf.stalk x) := fun x =>
    wcpa_smooth_stalk_isDomain _ E₀.left E₀.hom (n - 2) x
  haveI : IsReduced E₀.left := isReduced_of_isReduced_stalk _
  obtain ⟨g', hg'⟩ := wc_ap_reduced_factor_closed_immersion E₀.left Y Xs' e iY
    (hre.trans hY.symm).subset
  haveI : IsClosedImmersion (g' ≫ iY) := by rw [hg']; exact he
  haveI : IsClosedImmersion g' := IsClosedImmersion.of_comp_isClosedImmersion g' iY
  have hsurj : Set.range g' = Set.univ := by
    apply Set.eq_univ_of_forall
    intro y
    have hy : iY y ∈ Set.range e := by rw [hre, ← hY]; exact ⟨y, rfl⟩
    obtain ⟨w, hw⟩ := hy
    refine ⟨w, (IsClosedImmersion.isClosedEmbedding iY).injective ?_⟩
    rw [← hw, ← hg', Scheme.Hom.comp_apply]
  have hne : ∀ (W : Scheme.{u}) (p : ℕ), Nonempty (wcEtCoh W ℓ p) := by
    intro W p; unfold wcEtCoh; exact ⟨0⟩
  have hcard : ∀ p : ℕ, Nat.card (wcEtCoh E₀.left ℓ p) = Nat.card (wcEtCoh Y ℓ p) := by
    intro p
    have h1 := wc_et_fibre_coh_reduced_invariance Y Y Y E₀.left (𝟙 Y) g' hsurj (𝟙 Y) ℓ p
    obtain ⟨i1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (g' ≫ 𝟙 Y) (𝟙 Y)) ℓ p
    obtain ⟨i2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (𝟙 Y) (𝟙 Y)) ℓ p
    rw [Nat.card_congr i1, Nat.card_congr i2]
    exact h1

  have hd : Even (n - 2) := by
    obtain ⟨r, hr⟩ := hn
    exact ⟨r - 1, by omega⟩
  have hint : (algebraMap (IsLocalRing.ResidueField B₀)
      (AlgebraicClosure (IsLocalRing.ResidueField B₀))).IsIntegral := fun x =>
    Algebra.IsIntegral.isIntegral (R := IsLocalRing.ResidueField B₀) x
  obtain ⟨eqv⟩ := wc_et_coh_purely_inseparable_invariance (IsLocalRing.ResidueField B₀)
    (AlgebraicClosure (IsLocalRing.ResidueField B₀)) hint E₀.left E₀.hom ℓ (j + 1)
  obtain ⟨jΩ, hjΩ, hjΩY, hΩG⟩ := wc_quadric_germ_base_change (IsLocalRing.ResidueField B₀)
    (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (n - 2 + 1) E₀ jE hjE hjEY a hEG
  haveI hpΩ : IsProper (Limits.pullback.snd E₀.hom (Spec.map (CommRingCat.ofHom
      (algebraMap (IsLocalRing.ResidueField B₀) (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) hEp
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange (n - 2)
  haveI hsΩ : SmoothOfRelativeDimension (n - 2) (Limits.pullback.snd E₀.hom (Spec.map
      (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 2))
      (IsPullback.of_hasPullback _ _) hEs
  have haΩ : ((Matrix.of fun p q => algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (a p q)) +
      (Matrix.of fun p q => algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (a p q)).transpose).det ≠ 0 := by
    have hm : (Matrix.of fun p q => algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (a p q)) +
        (Matrix.of fun p q => algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (a p q)).transpose =
        ((Matrix.of a) + (Matrix.of a).transpose).map (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀))) := by
      ext i i'
      simp [Matrix.map_apply, Matrix.add_apply, Matrix.transpose_apply]
    have hdet := RingHom.map_det (algebraMap (IsLocalRing.ResidueField B₀)
      (AlgebraicClosure (IsLocalRing.ResidueField B₀))) ((Matrix.of a) + (Matrix.of a).transpose)
    rw [RingHom.mapMatrix_apply] at hdet
    rw [hm, ← hdet]
    exact (map_ne_zero_iff _ (algebraMap (IsLocalRing.ResidueField B₀)
      (AlgebraicClosure (IsLocalRing.ResidueField B₀))).injective).mpr ha
  obtain ⟨P, hP, hPq⟩ := wc_quadric_split_normal_form_alg_closed
    (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (n - 2) hd _ haΩ
  obtain ⟨jY', hjY', hjY'Y, hY'G⟩ := wc_quadric_germ_linear_change
    (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (n - 2 + 1) _ _ jΩ hjΩ hjΩY
    (Matrix.of fun p q => algebraMap (IsLocalRing.ResidueField B₀)
      (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (a p q)) hΩG P hP
  rw [hPq] at hY'G
  have hℓΩ : ((ℓ : ℕ) : AlgebraicClosure (IsLocalRing.ResidueField B₀)) ≠ 0 := by
    have := (map_ne_zero_iff _ (algebraMap (IsLocalRing.ResidueField B₀)
      (AlgebraicClosure (IsLocalRing.ResidueField B₀))).injective).mpr hℓk
    rwa [map_natCast] at this
  have hsplit := wc_et_split_quadric_all_odd_vanish
    (AlgebraicClosure (IsLocalRing.ResidueField B₀)) ℓ hℓΩ (n - 2) hd _ _ jY' hjY' hjY'Y hY'G
    (j + 1) hq
  haveI := hsplit
  have hE : Subsingleton (wcEtCoh E₀.left ℓ (j + 1)) := eqv.symm.subsingleton
