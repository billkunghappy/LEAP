theorem wc_qmbt_csz_pp_wcontr_kunneth_vanish (k : Type u) [Field k] [IsSepClosed k]
    {Y : Scheme.{u}} (g : Y ⟶ Spec (.of k)) [IsProper g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ((ℓ : ℕ) : k) ≠ 0) (q : ℕ) (hq : ∀ z : wcHM Y ℓ q, z = 0)
    (W : (Spec (.of k)).ProEt)
    (hW : IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))) :
    ∀ z : wcHM (Limits.pullback W.hom g) ℓ q, z = 0 :=
by
  classical

  haveI : IsAffine W.left := hW.1
  haveI : IsAffine ((𝟭 Scheme).obj W.left) := hW.1
  have hQC : QuasiCompact (Limits.pullback.fst W.hom g) := inferInstance
  have hQS : QuasiSeparated (Limits.pullback.fst W.hom g) := inferInstance
  have hC : CompactSpace ↥((𝟭 Scheme).obj W.left) := inferInstance
  have hS : QuasiSeparatedSpace ↥((𝟭 Scheme).obj W.left) := inferInstance
  haveI := hC
  haveI : CompactSpace ↥Y := QuasiCompact.compactSpace_of_compactSpace g
  haveI : QuasiSeparatedSpace ↥Y := quasiSeparatedSpace_of_quasiSeparated g
  haveI : CompactSpace ↥((wcProEtBC g).obj W).left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst W.hom g) hQC hC
  haveI : QuasiSeparatedSpace ↥((wcProEtBC g).obj W).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.fst W.hom g) hS hQS

  have hne : ∀ i : ℕ, ((ℓ ^ i : ℕ) : k) ≠ 0 := by
    intro i
    rw [Nat.cast_pow]
    exact pow_ne_zero i hℓ
  have hneR : ∀ i : ℕ, ((ℓ ^ i : ℕ) : IsLocalRing.ResidueField k) ≠ 0 := by
    intro i h
    apply hne i
    apply (IsLocalRing.residue k).injective
    rw [map_natCast, map_zero]
    exact h

  have hbij : ∀ i : ℕ, ∀ (z : W.left), IsClosed ({z} : Set W.left) → ∀ {Pq : Scheme.{u}}
      (q' : Pq ⟶ Y) (t : Pq ⟶ Spec (W.left.presheaf.stalk z)),
      IsPullback q' t g (W.left.fromSpecStalk z ≫ W.hom ≫ 𝟙 (Spec (.of k))) →
      ∀ (D : wcZModPullData q' (ℓ ^ i)), wcZModPullCanonical D → ∀ j : ℕ,
        Function.Bijective (wcZModPull D j) := by
    intro i z hz Pq q' t hP D hD j
    haveI : HenselianLocalRing (W.left.presheaf.stalk z) := (hW.2.2.2.2 z hz).1
    haveI : IsSepClosed (IsLocalRing.ResidueField (W.left.presheaf.stalk z)) :=
      (hW.2.2.2.2 z hz).2
    exact wc_zmod_proper_strict_henselian_base_pull_bij g (W.left.presheaf.stalk z)
      (W.left.fromSpecStalk z ≫ W.hom ≫ 𝟙 _) q' t hP (ℓ ^ i) (hne i) D hD j

  choose Dk hDk using fun i : ℕ =>
    wc_zmod_pull_data_exists (((wcProEtBC g).obj W).hom ≫ 𝟙 Y) (ℓ ^ i)

  haveI : IsSepClosed (IsLocalRing.ResidueField k) :=
    wc_henselian_sepClosed_transfer.2 k (IsLocalRing.ResidueField k)
      (RingEquiv.ofBijective (IsLocalRing.residue k)
        ⟨(IsLocalRing.residue k).injective, IsLocalRing.residue_surjective⟩) inferInstance

  obtain ⟨D, hD⟩ := wc_hm_pull_data_exists (((wcProEtBC g).obj W).hom ≫ 𝟙 Y) ℓ
  let e : Fin 0 → wcHM Y ℓ q := fun a => a.elim0
  have he : Function.Bijective
      (fun c : Fin 0 → ℚ_[ℓ] => ∑ a, wcHMScalar Y ℓ q (c a) (e a)) := by
    refine ⟨Function.injective_of_subsingleton _, fun y => ⟨0, ?_⟩⟩
    rw [hq y]
    exact Fin.sum_univ_zero _
  have hbijT := wc_hm_ladic_kunneth_passage (Y := Y) (T := ((wcProEtBC g).obj W).left)
    (W₀ := (𝟭 Scheme).obj W.left) ℓ
    (Limits.pullback.fst W.hom g) (((wcProEtBC g).obj W).hom ≫ 𝟙 Y) D hD Dk hDk
    (fun i j _ => wc_strict_hens_proper_zmod_proet_finite k Y g (ℓ ^ i) (hneR i) j)
    (fun i j _ => wc_wcontr_torsion_kunneth_of_base_bij (B := Spec (.of k))
      (U := Spec (.of k)) (O := Y) g g (𝟙 Y) (𝟙 _) (IsPullback.id_horiz g) inferInstance
      inferInstance (ℓ ^ i) W hW (hbij i) j (Dk i) (hDk i))
    q 0 e he

  intro z
  obtain ⟨c, hc⟩ := hbijT.2 z
  rw [← hc]
  exact Fin.sum_univ_zero _

theorem wc_qmbt_csz_pp_push_homology_zero {Y Z : Scheme.{u}} (g : Y ⟶ Z) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf Y ℓ))) (q : ℕ)
    (hvan : ∀ (W : Z.ProEt), (IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))) →
      ∀ z : wcHM (Limits.pullback W.hom g) ℓ q, z = 0) :
    haveI := Dg.additive
    haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont
      Dg.φ).Additive := Adjunction.right_adjoint_additive Dg.adj
    Limits.IsZero ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont
      Dg.φ).mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).homology (q : ℤ)) :=
by
  haveI := Dg.additive
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
  haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
  let Kn := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex

  obtain ⟨Ψ, -, -⟩ := wc_proet_push_homology_sections_hm g ℓ Dg hDg I q
  have hwc : ∀ (W : Z.ProEt), (IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))) →
      ∀ h : (Kn.homology q).val.obj (Opposite.op W), h = 0 := by
    intro W hW h
    have hP := wc_proet_free_projective_wcontractible Z W hW
    exact (Ψ W hP).injective ((hvan W hW _).trans (map_zero (Ψ W hP)).symm)

  have hall : ∀ (V : Z.ProEt) (m : (Kn.homology q).val.obj (Opposite.op V)), m = 0 := by
    intro V m
    apply wc_proet_module_section_eq_zero_of_affine_covers (Kn.homology q) V m
    intro W f hW
    obtain ⟨Δ, δ, hΔa, hδwe, hδs, hcl, hsp, hed, hloc⟩ := wc_exists_wcontractible_cover W.left hW
    have hcomp : WeaklyEtale (δ ≫ W.hom) := by
      haveI := hδwe
      haveI : WeaklyEtale W.hom := W.prop
      exact inferInstance
    let W₀ : Z.ProEt := MorphismProperty.Over.mk ⊤ (δ ≫ W.hom) hcomp
    let e₀ : W₀ ⟶ W := MorphismProperty.Over.homMk δ rfl trivial
    refine ⟨1, fun _ => W₀, fun _ => e₀, fun _ => hΔa, ?_, ?_⟩
    · intro y
      obtain ⟨x, hx⟩ := hδs.surj y
      exact ⟨0, x, hx⟩
    · intro _
      exact hwc W₀ ⟨hΔa, hcl, hsp, hed, hloc⟩ _

  have hHn : Limits.IsZero (Kn.homology q) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact (hall _ _).trans (hall _ _).symm

  let φ : ∀ a : Option ℕ, P.obj (HomologicalComplex.extend.X I.cocomplex a) ≅
      HomologicalComplex.extend.X Kn a := fun a =>
    match a with
    | some k => Iso.refl _
    | none => Limits.IsZero.iso (P.map_isZero (Limits.isZero_zero _)) (Limits.isZero_zero _)
  have hφ : ∀ a b : Option ℕ,
      (φ a).hom ≫ HomologicalComplex.extend.d Kn a b =
        P.map (HomologicalComplex.extend.d I.cocomplex a b) ≫ (φ b).hom := by
    intro a b
    cases a with
    | none => exact (P.map_isZero (Limits.isZero_zero _)).eq_of_src _ _
    | some i =>
      cases b with
      | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
      | some j => exact (Category.id_comp _).trans (Category.comp_id _).symm
  let isoΨ : (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ≅
      Kn.extend ComplexShape.embeddingUpNat :=
    HomologicalComplex.Hom.isoOfComponents
      (fun i => φ (ComplexShape.embeddingUpNat.r i))
      (fun i j _ => hφ _ _)
  exact hHn.of_iso (HomologicalComplex.homologyMapIso isoΨ (q : ℤ) ≪≫
    Kn.extendHomologyIso ComplexShape.embeddingUpNat (j := q) rfl)

theorem wc_qmbt_csz_pp_cone_shift_push {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜]
    [HasDerivedCategory 𝒜] {𝒜' : Type*} [Category 𝒜'] [Abelian 𝒜'] [HasDerivedCategory 𝒜']
    [EnoughInjectives 𝒜'] (P : 𝒜' ⥤ 𝒜) [P.Additive] (S : 𝒜') (J : CochainComplex 𝒜' ℤ)
    [J.IsStrictlyGE 0] (hJ : ∀ m, Injective (J.X m))
    (ε : (HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).obj S ⟶ J) [QuasiIso ε]
    (C : DerivedCategory 𝒜') (hC : DerivedCategory.TStructure.t.plus C)
    (θ : C ≅ (DerivedCategory.singleFunctor 𝒜' 1).obj S) :
    Nonempty (((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
      (⟨C, hC⟩ : DerivedCategory.Plus 𝒜'))⟦(-1 : ℤ)⟧ ≅
      DerivedCategory.Q.obj ((shiftFunctor (CochainComplex 𝒜 ℤ) (-2 : ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj J))) :=
by
  classical
  let J₁ := (shiftFunctor (CochainComplex 𝒜' ℤ) (-1 : ℤ)).obj J
  haveI hJ1ge : J₁.IsStrictlyGE 1 := CochainComplex.isStrictlyGE_shift J 0 (-1) 1 (by norm_num)
  have hJ₁ : ∀ i, Injective (J₁.X i) := fun i => hJ (i + (-1))

  haveI : IsIso (DerivedCategory.Q.map ε) := inferInstance
  let σ : (DerivedCategory.singleFunctor 𝒜' 1).obj S ≅ DerivedCategory.Q.obj J₁ :=
    (((DerivedCategory.singleFunctors 𝒜').shiftIso (-1) 1 0 (by norm_num)).app S).symm ≪≫
    (shiftFunctor (DerivedCategory 𝒜') (-1 : ℤ)).mapIso
      ((DerivedCategory.singleFunctorIsoCompQ 𝒜' 0).app S) ≪≫
    (shiftFunctor (DerivedCategory 𝒜') (-1 : ℤ)).mapIso (asIso (DerivedCategory.Q.map ε)) ≪≫
    ((DerivedCategory.Q.commShiftIso (-1 : ℤ)).app J).symm

  let K' : CochainComplex (InjectiveObject 𝒜') ℤ :=
    { X := fun i => ⟨J₁.X i, hJ₁ i⟩
      d := fun i j => ObjectProperty.homMk (J₁.d i j)
      shape := fun i j h => by
        apply (InjectiveObject.ι 𝒜').map_injective
        simp [J₁.shape i j h]
      d_comp_d' := fun i j k _ _ => by
        apply (InjectiveObject.ι 𝒜').map_injective
        simp }
  let c : ((InjectiveObject.ι 𝒜').mapHomologicalComplex (ComplexShape.up ℤ)).obj K' ≅ J₁ :=
    HomologicalComplex.Hom.isoOfComponents (fun i => Iso.refl _) (by intros; simp [K'])
  have hK'1 : CochainComplex.IsStrictlyGE
      (((InjectiveObject.ι 𝒜').mapHomologicalComplex (ComplexShape.up ℤ)).obj K') 1 :=
    CochainComplex.isStrictlyGE_of_iso c.symm 1
  have hK' : K'.IsStrictlyGE 1 :=
    (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff K' (InjectiveObject.ι 𝒜') 1).mp
      hK'1
  let L : CochainComplex.Plus (InjectiveObject 𝒜') := ⟨K', ⟨1, hK'⟩⟩
  let L₁ := (InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L
  let e₀ : DerivedCategory.Q.obj J₁ ≅ (DerivedCategory.Plus.Q.obj L₁).obj :=
    DerivedCategory.Q.mapIso c.symm ≪≫ ((DerivedCategory.Plus.QCompιIso 𝒜').app L₁).symm

  let τ : (⟨C, hC⟩ : DerivedCategory.Plus 𝒜') ≅ DerivedCategory.Plus.Q.obj L₁ :=
    ObjectProperty.isoMk _ (θ ≪≫ σ ≪≫ e₀)

  let η : (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
      (⟨C, hC⟩ : DerivedCategory.Plus 𝒜') ≅
      DerivedCategory.Q.obj ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj J₁) :=
    (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).mapIso τ ≪≫
      DerivedCategory.Plus.ι.mapIso (asIso (P.rightDerivedFunctorPlusUnit.app L₁)).symm ≪≫
      (DerivedCategory.Plus.QCompιIso 𝒜).app (P.mapCochainComplexPlus.obj L₁) ≪≫
      DerivedCategory.Q.mapIso (P.mapCochainComplexPlusCompι.app L₁) ≪≫
      DerivedCategory.Q.mapIso ((P.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso c)

  have h12 : (-1 : ℤ) + (-1 : ℤ) = (-2 : ℤ) := by norm_num
  exact ⟨(shiftFunctor (DerivedCategory 𝒜) (-1 : ℤ)).mapIso η ≪≫
    ((DerivedCategory.Q.commShiftIso (-1 : ℤ)).app
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj J₁)).symm ≪≫
    DerivedCategory.Q.mapIso
      (((P.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso (-1 : ℤ)).app J₁).symm ≪≫
    DerivedCategory.Q.mapIso ((P.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso
      (((shiftFunctorAdd' (CochainComplex 𝒜' ℤ) (-1 : ℤ) (-1 : ℤ) (-2 : ℤ) h12).app J).symm :
        (shiftFunctor (HomologicalComplex 𝒜' (ComplexShape.up ℤ)) (-1)).obj J₁ ≅
          (shiftFunctor (CochainComplex 𝒜' ℤ) (-2)).obj J)) ≪≫
    DerivedCategory.Q.mapIso
      (((P.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso (-2 : ℤ)).app J)⟩

