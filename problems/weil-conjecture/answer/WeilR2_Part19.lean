theorem wc_qmbt_msk_milnor_fibre_et_counts {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n)
    {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {L : Type u} [Field L] [IsSepClosed L] {φA : A →+* L} (hφA : Function.Injective φA)
    {Y : Scheme.{u}} {pY : Y ⟶ Spec (.of B₀)} {qY : Y ⟶ Spec (.of L)}
    (hY : IsPullback pY qY (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom φA))) :
    (∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Y (ℓ ^ k) 0) = ℓ ^ k) ∧
    (∀ k q : ℕ, 1 ≤ k → (1 ≤ q ∧ q + 2 ≤ n ∨ n ≤ q) → Subsingleton (wcEtCoh Y (ℓ ^ k) q)) ∧
    Nat.card (wcEtCoh Y ℓ (n - 1)) = ℓ :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hn2 : 2 ≤ n := by omega

  have hstr : (wcQuadModelStr A n π c) x₀ = IsLocalRing.closedPoint A := by
    have hπmem : π ∈ Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
        (PrimeSpectrum.asIdeal x₀) := by
      rw [Ideal.mem_comap]
      have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
          algebraMap A (wcQuadModelRing A n π c) π := by
        change _ = Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π)
        exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [← hrel, map_sum]
      refine Ideal.sum_mem _ fun p _ => ?_
      rw [map_sum]
      refine Ideal.sum_mem _ fun q _ => ?_
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hx₀ q)
    have hcomap : Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
        (PrimeSpectrum.asIdeal x₀) = IsLocalRing.maximalIdeal A := by
      refine ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le
        (Ideal.comap_ne_top _ (PrimeSpectrum.isPrime x₀).ne_top) ?_).symm
      rw [hπ, Ideal.span_singleton_le_iff_mem]
      exact hπmem
    apply PrimeSpectrum.ext
    exact hcomap

  obtain ⟨ψ, hψdef⟩ : ∃ ψ : A →+* AlgebraicClosure L,
      ψ = (algebraMap L (AlgebraicClosure L)).comp φA := ⟨_, rfl⟩
  have hψ : Function.Injective ψ := by
    rw [hψdef]
    exact (algebraMap L (AlgebraicClosure L)).injective.comp hφA
  have hℓΩ : ((ℓ : ℕ) : AlgebraicClosure L) ≠ 0 := by
    have h1 := hℓ.map ψ
    rw [map_natCast] at h1
    exact h1.ne_zero

  have hξ : (Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint (AlgebraicClosure L)) ≠
      IsLocalRing.closedPoint A := by
    intro h
    have key : ∀ x : A, x ∈ ((Spec.map (CommRingCat.ofHom ψ))
        (IsLocalRing.closedPoint (AlgebraicClosure L))).asIdeal ↔ ψ x = 0 := by
      intro x
      show x ∈ Ideal.comap ψ (IsLocalRing.maximalIdeal (AlgebraicClosure L)) ↔ _
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_ne_zero,
        not_not]
    have hmem : π ∈ ((Spec.map (CommRingCat.ofHom ψ))
        (IsLocalRing.closedPoint (AlgebraicClosure L))).asIdeal := by
      rw [h]
      show π ∈ IsLocalRing.maximalIdeal A
      rw [hπ]
      exact Ideal.mem_span_singleton_self π
    rw [key] at hmem
    have hπz : π = 0 := hψ (hmem.trans (map_zero ψ).symm)
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, hπz, Ideal.span_singleton_eq_bot]

  have hσξ : Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
      Spec.map (CommRingCat.ofHom φA) = Spec.map (CommRingCat.ofHom ψ) := by
    rw [hψdef, CommRingCat.ofHom_comp, Spec.map_comp]
  have hP := IsPullback.paste_horiz
    (IsPullback.of_hasPullback qY
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))))
    hY
  rw [hσξ] at hP
  have E : ∀ m q : ℕ, Nonempty (wcEtCoh Y m q ≃ wcEtCoh (Limits.pullback
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ψ))) m q) := by
    intro m q
    obtain ⟨e2⟩ := wc_et_coh_purely_inseparable_invariance L (AlgebraicClosure L)
      (algebraMap_isIntegral_iff.mpr inferInstance) Y qY m q
    obtain ⟨eJ⟩ := wc_et_coh_iso_invariance hP.isoPullback.hom m q
    exact ⟨e2.symm.trans eJ.symm⟩
  generalize Spec.map (CommRingCat.ofHom ψ) = ξ at hξ E

  have hπ0 : (Spec.preimage ξ).hom π ≠ 0 := by
    have hker : ∀ y : A, y ∈ (ξ (IsLocalRing.closedPoint (AlgebraicClosure L))).asIdeal ↔
        (Spec.preimage ξ).hom y = 0 := by
      intro y
      conv_lhs => rw [← Spec.map_preimage ξ]
      show y ∈ Ideal.comap (Spec.preimage ξ).hom
        (IsLocalRing.maximalIdeal (AlgebraicClosure L)) ↔ _
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_ne_zero,
        not_not]
    intro h0
    apply hξ
    have hle : IsLocalRing.maximalIdeal A ≤
        (ξ (IsLocalRing.closedPoint (AlgebraicClosure L))).asIdeal := by
      rw [hπ, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, hker]
      exact h0
    have hge : (ξ (IsLocalRing.closedPoint (AlgebraicClosure L))).asIdeal ≤
        IsLocalRing.maximalIdeal A :=
      IsLocalRing.le_maximalIdeal (ξ (IsLocalRing.closedPoint (AlgebraicClosure L))).isPrime.ne_top
    exact PrimeSpectrum.ext (le_antisymm hge hle)

  have C1 : ∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh Y (ℓ ^ k) 0) = ℓ ^ k := by
    intro k _
    have P := wc_quadric_model_milnor_package A ℓ hℓp hℓ k n hn hn2 π c hπ hc x₀ hx₀ hstr
      B₀ Λ₀ W₀ φ₀ a₀ hsh (AlgebraicClosure L) ξ hξ
    exact (Nat.card_congr (E (ℓ ^ k) 0).some).trans P.1

  have C2 : ∀ k q : ℕ, 1 ≤ k → (1 ≤ q ∧ q + 2 ≤ n ∨ n ≤ q) →
      Subsingleton (wcEtCoh Y (ℓ ^ k) q) := by
    intro k q hk hq
    have hM : Subsingleton (wcEtCoh (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ)
        (ℓ ^ k) q) := by
      rcases hq with ⟨h1, h2⟩ | h3
      · exact (wc_quadric_model_milnor_package A ℓ hℓp hℓ k n hn hn2 π c hπ hc x₀ hx₀ hstr
          B₀ Λ₀ W₀ φ₀ a₀ hsh (AlgebraicClosure L) ξ hξ).2.1 q h1 h2
      · have hθ : (Iso.refl (Spec (.of B₀))).hom ≫ a₀ ≫ wcQuadModelStr A n π c =
            a₀ ≫ wcQuadModelStr A n π c := by
          rw [Iso.refl_hom, Category.id_comp]
        exact (wc_quad_model_iso_milnor_fibre_high A ℓ hℓp hℓ n hn hn2 π c hπ hc x₀ hx₀ hstr
          B₀ Λ₀ W₀ φ₀ a₀ hsh (Spec (.of (wcQuadModelRing A n π c))) (wcQuadModelStr A n π c)
          B₀ a₀ (Iso.refl _) hθ (AlgebraicClosure L) ξ hξ k hk).2 q h3
    haveI := hM
    exact (E (ℓ ^ k) q).some.subsingleton
  refine ⟨C1, C2, ?_⟩

  obtain ⟨θ'⟩ := wc_quadric_model_generic_fibre_hyperbolic_iso A n hn hn2 π c hc
    (AlgebraicClosure L) ξ hπ0
  have T : ∀ j : ℕ, Nonempty (wcEtCoh Y ℓ j ≃
      wcEtCoh (Spec (.of (wcQuadModelRing (AlgebraicClosure L) n 1 (Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : AlgebraicClosure L) else 0)))) ℓ j) := by
    intro j
    obtain ⟨C⟩ := wc_quadric_model_milnor_generic_fibre_coh_equiv A ℓ hℓp hℓ n hn hn2 π c hπ hc
      x₀ hx₀ hstr B₀ Λ₀ W₀ φ₀ a₀ hsh (AlgebraicClosure L) ξ hξ j
    obtain ⟨Eθ⟩ := wc_et_coh_iso_invariance θ'.hom ℓ j
    exact ⟨(E ℓ j).some.trans (C.trans Eθ.symm)⟩
  obtain ⟨e, rfl⟩ : ∃ e, n = 2 * (e + 1) := by
    obtain ⟨r, hr⟩ := hn
    exact ⟨r - 1, by omega⟩
  obtain ⟨O, hO⟩ : ∃ O : (Spec (.of (MvPolynomial (Fin (e + 1)) (AlgebraicClosure L)))).Opens,
      O = ⨆ t : Fin (e + 1), PrimeSpectrum.basicOpen
        (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) (AlgebraicClosure L)) :=
    ⟨_, rfl⟩
  have hOmem : ∀ y : Spec (.of (MvPolynomial (Fin (e + 1)) (AlgebraicClosure L))), y ∈ O ↔
      ∃ t : Fin (e + 1),
        (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) (AlgebraicClosure L)) ∉ y.asIdeal := by
    intro y
    subst hO
    exact TopologicalSpace.Opens.mem_iSup (x := y) (s := fun t : Fin (e + 1) =>
      PrimeSpectrum.basicOpen
        (MvPolynomial.X t : MvPolynomial (Fin (e + 1)) (AlgebraicClosure L)))
  have hOset : (O : Set (Spec (.of (MvPolynomial (Fin (e + 1)) (AlgebraicClosure L))))) =
      (Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff :
          MvPolynomial (Fin (e + 1)) (AlgebraicClosure L) →+* AlgebraicClosure L))))ᶜ := by
    ext y
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff, SetLike.mem_coe, hOmem, not_forall]
  obtain ⟨Φ1⟩ := wc_hyperbolic_affine_quadric_punct_coh_equiv (AlgebraicClosure L) ℓ hℓp hℓΩ e
    O hOset (2 * (e + 1) - 1)
  have hcard := wc_et_punct_affine_top_card_prime_pow (AlgebraicClosure L) ℓ hℓΩ (e + 1)
    (by omega) O hOset 1 le_rfl
  simp only [pow_one] at hcard
  exact (Nat.card_congr ((T _).some.trans Φ1)).trans hcard

theorem wc_qmbt_msk_closed_point_pull_bij : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] {X : Scheme.{u}} (g : X ⟶ Spec (.of B))
    (C : Type u) [CommRing C] [HenselianLocalRing C] (c : Spec (.of C) ⟶ Spec (.of B)),
    WeaklyEtale c → c (IsLocalRing.closedPoint C) = IsLocalRing.closedPoint B →
    ∀ {Pq : Scheme.{u}} (q' : Pq ⟶ X) (t : Pq ⟶ Spec (.of C)), IsPullback q' t g c →
    ∀ (m : ℕ) (D : wcZModPullData q' m), wcZModPullCanonical D →
    ∀ j : ℕ, Function.Bijective (wcZModPull D j) :=
by
  intro B _ _ _ X g C _ _ c hW hcl Pq q' t hpb m D hD j
  have hc' : Spec.map (CommRingCat.ofHom (Spec.preimage c).hom) = c := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  set ψ : B →+* C := (Spec.preimage c).hom with hψ
  have hWE := wc_lpkt_specMap_weaklyEtale_ring B C ψ (by rw [hc']; exact hW)
  have hloc : IsLocalHom ψ := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    rw [← hc'] at hcl
    exact hcl
  letI := ψ.toAlgebra
  have hbij : Function.Bijective ψ := wc_olivier B C inferInstance inferInstance hloc hWE
  haveI : IsIso (CommRingCat.ofHom ψ) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI : IsIso c := by rw [← hc']; infer_instance
  haveI : IsIso q' := hpb.isIso_fst_of_isIso
  obtain ⟨D', hD'⟩ := wc_zmod_pull_data_exists (inv q') m
  obtain ⟨D₁, hD₁⟩ := wc_zmod_pull_data_exists (𝟙 X) m
  obtain ⟨D₂, hD₂⟩ := wc_zmod_pull_data_exists (𝟙 Pq) m
  have hl : Function.LeftInverse (wcZModPull D' j) (wcZModPull D j) := by
    intro x
    rw [← wc_zmod_pull_comp q' (inv q') (𝟙 X) (IsIso.inv_hom_id q') D hD D' hD' D₁ hD₁ j x]
    exact wc_zmod_pull_id (𝟙 X) rfl D₁ hD₁ j x
  have hr : Function.RightInverse (wcZModPull D' j) (wcZModPull D j) := by
    intro y
    rw [← wc_zmod_pull_comp (inv q') q' (𝟙 Pq) (IsIso.hom_inv_id q') D' hD' D hD D₂ hD₂ j y]
    exact wc_zmod_pull_id (𝟙 Pq) rfl D₂ hD₂ j y
  exact ⟨hl.injective, hr.surjective⟩

theorem wc_qmbt_csz_milnor_stalk {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    haveI := Dp'.additive
    haveI := Di'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    let Pβ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC βs) _ _ Dβ.cont Dβ.φ
    haveI := Dβ.additive
    haveI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
    ∀ (hP' : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj
      ((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K')))
      (k : Type u) [Field k] [IsSepClosed k] (x : Spec (.of k) ⟶ Xs) [IsClosedImmersion x],
      ι (x (IsLocalRing.closedPoint k)) = IsLocalRing.closedPoint B₀ →
      ∀ (Dx : wcHMPullData x ℓ), wcHMPullCanonical Dx →
      letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf (Spec (.of k)) ℓ))
      haveI := Dx.additive
      haveI := Dx.presLim
      haveI := Dx.presColim
      (∀ j : ℤ, j ≠ 0 → j ≠ (n : ℤ) - 1 → Limits.IsZero ((DerivedCategory.homologyFunctor _ j).obj
        (Dx.Φ.mapDerivedCategory.obj ((Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))))))) ∧
      Nonempty ((DerivedCategory.homologyFunctor _ ((n : ℤ) - 1)).obj
        (Dx.Φ.mapDerivedCategory.obj ((Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))))) ≅
        SheafOfModules.unit (wcRingSheaf (Spec (.of k)) ℓ)) :=
by
  intro P' K' Pβ hP' k _ _ x _ hxcp Dx hDx
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf (Spec (.of k)) ℓ))
  haveI := Dβ.additive
  haveI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
  haveI := Di'.additive
  haveI := Dp'.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
  haveI := Dx.additive
  haveI := Dx.presLim
  haveI := Dx.presColim

  obtain ⟨hιA, halgA⟩ := wc_qmbt_msk_base_alg hπ hπ' hπ'2 hgen hφ' halg'
  have hφA : Function.Injective (φ'.comp ιA) := hφ'.comp hιA
  have hprop := wc_qmbt_nt_beta_proper (a₀ := a₀) (c := c) hgen hbl

  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists (bl ≫ Limits.pullback.fst
    (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) ℓ
  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists ι ℓ
  obtain ⟨Dgp, hDgp⟩ := wc_hm_pull_data_exists (p' ≫ bl ≫ Limits.pullback.fst
    (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) ℓ
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (x ≫ ι) ℓ
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip inferInstance
  haveI := Dg.additive
  haveI := Di.additive
  haveI := Dgp.additive
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  let Pg := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcProEtBC (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))) _ _ Dg.cont Dg.φ
  let Pgp := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcProEtBC (p' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))) _ _ Dgp.cont Dgp.φ
  haveI : Pg.Additive := Adjunction.right_adjoint_additive Dg.adj
  haveI : Pgp.Additive := Adjunction.right_adjoint_additive Dgp.adj

  have hLalg : letI := (RingHom.id L').toAlgebra; Algebra.IsAlgebraic L' L' := by
    letI := (RingHom.id L').toAlgebra
    exact ⟨fun a => isAlgebraic_algebraMap a⟩
  obtain ⟨θ, -⟩ := wc_qmbt_nt_proper_base_change hℓ hn hn4 hπ hc hx₀ hsh (L := L')
    (φA := φ'.comp ιA) hφA halgA (ιL := RingHom.id L') hLalg hps hℓ' hπ' hπ'2 hgen hφ'
    (RingHom.id_comp _).symm hbl hblf hprop hpb' hps' hβ Dβ hDβ Dg hDg Di hDi Dp' hDp' Di' hDi'
    I' hP'

  obtain ⟨κ'⟩ := wc_hm_pull_data_comp_Phi_iso _ p' _ rfl Dg hDg Dp' hDp' Dgp hDgp
  let adj : Dgp.Φ ⊣ P' ⋙ Pg := (Dg.adj.comp Dp'.adj).ofNatIsoLeft κ'.symm
  let ρ : P' ⋙ Pg ≅ Pgp := (Dgp.adj.rightAdjointUniq adj).symm

  obtain ⟨κ⟩ := wc_hm_pull_data_comp_Phi_iso ι x (x ≫ ι) rfl Di hDi Dx hDx Dk hDk
  obtain ⟨hneg, hiso⟩ := wc_qmbt_msk_derived_homology_transport P' Pg Di.Φ Dx.Φ Dk.Φ Pgp
    κ ρ I' _ θ

  have hpb := IsPullback.of_hasPullback (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom (φ'.comp ιA)))
  obtain ⟨βE, hβE₁, hβE₂⟩ := wc_qmbt_nt_generic_fibre hφA hpb hπ' (ιL := RingHom.id L') hφ'
    (RingHom.id_comp _).symm hbl hblf hpb'
  have hY : IsPullback (p' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) q' (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom (φ'.comp ιA))) := by
    have h := hβE₂.paste_horiz hpb
    rw [hβE₁, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp] at h
    exact h
  haveI : IsAffine XE' := IsAffine.of_isIso hY.isoPullback.hom

  obtain ⟨h0, hsub, htop1⟩ := wc_qmbt_msk_milnor_fibre_et_counts hℓ hn hn4 hπ hc hx₀ hsh hφA hY
  have hℓp : ℓ.Prime := Fact.out
  have h2 : Subsingleton (wcEtCoh XE' ℓ (n - 1 + 1)) := by
    have := hsub 1 (n - 1 + 1) le_rfl (Or.inr (by omega))
    rwa [pow_one] at this
  have hlow : ∀ j : ℕ, 1 ≤ j → Subsingleton (wcEtCoh XE' (ℓ ^ j) (n - 1 - 1)) :=
    fun j hj => hsub j (n - 1 - 1) hj (Or.inl ⟨by omega, by omega⟩)
  have hcardk := wc_qmbt_msk_top_card_devissage XE' ℓ hℓp (n - 1) (by omega) htop1 h2 hlow
  obtain ⟨hvanQ, ⟨y, hy⟩, hfin⟩ := wc_qmbt_msk_ladic_of_et_counts XE' ℓ n hn4 h0 hsub hcardk

  have hbij : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (c' : Spec (.of C) ⟶ Spec (.of B₀)),
      WeaklyEtale c' → c' (IsLocalRing.closedPoint C) ∈ Set.range (x ≫ ι) →
      ∀ {Pq : Scheme.{u}} (q'' : Pq ⟶ XE') (t : Pq ⟶ Spec (.of C)),
      IsPullback q'' t (p' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) c' →
      ∀ k' : ℕ, 1 ≤ k' → ∀ (D : wcZModPullData q'' (ℓ ^ k')), wcZModPullCanonical D →
      ∀ j : ℕ, Function.Bijective (wcZModPull D j) := by
    intro C _ _ _ c' hc' hcr Pq q'' t hpq k' _ D hD j
    obtain ⟨z, hz⟩ := hcr
    have hz' : z = IsLocalRing.closedPoint k := Subsingleton.elim (α := Spec (.of k)) _ _
    have hcl : c' (IsLocalRing.closedPoint C) = IsLocalRing.closedPoint B₀ := by
      rw [← hz, hz']
      exact hxcp
    exact wc_qmbt_msk_closed_point_pull_bij B₀ _ C c' hc' hcl q'' t hpq (ℓ ^ k') D hD j

  refine ⟨fun j hj0 hjn => ?_, ?_⟩
  · rcases lt_or_ge j 0 with hjneg | hjpos
    · exact hneg j hjneg
    · obtain ⟨q, rfl⟩ := Int.eq_ofNat_of_zero_le hjpos
      have hq1 : 1 ≤ q := by omega
      have hqn : q ≠ n - 1 := by omega
      refine Limits.IsZero.of_iso ?_ (hiso q).some
      exact wc_qmbt_msk_closed_pull_isZero_of_top_sections (x ≫ ι) ℓ Dk hDk _
        (wc_qmbt_msk_wcontr_sections_vanish B₀ _ (x ≫ ι) ℓ Dgp hDgp I' q (hvanQ q hq1 hqn)
          hfin hbij)
  · have hN : ((n - 1 : ℕ) : ℤ) = (n : ℤ) - 1 := by omega
    rw [← hN]
    obtain ⟨m, hm⟩ := wc_qmssl_ry_kunneth_sections_line B₀ _ (x ≫ ι) ℓ Dgp hDgp I' (n - 1) y hy
      hfin hbij
    obtain ⟨τ⟩ := wc_qmssl_ry_closed_pull_unit_of_top_sections (x ≫ ι) ℓ Dk hDk _ m hm
    exact ⟨(hiso (n - 1)).some ≪≫ τ⟩

theorem wc_qmbt_csz_exact_adj_derived {𝒜 ℬ : Type*} [Category 𝒜] [Category ℬ] [Abelian 𝒜]
    [Abelian ℬ] [HasDerivedCategory 𝒜] [HasDerivedCategory ℬ] (G : 𝒜 ⥤ ℬ) (R : ℬ ⥤ 𝒜)
    [G.Additive] [R.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
    [Limits.PreservesFiniteLimits R] [Limits.PreservesFiniteColimits R] (adj : G ⊣ R)
    (X : DerivedCategory 𝒜) (Y : DerivedCategory ℬ) :
    Nonempty ((X ⟶ R.mapDerivedCategory.obj Y) ≃ (G.mapDerivedCategory.obj X ⟶ Y)) :=
by
  let core : Adjunction.CoreHomEquiv (G.mapHomologicalComplex (ComplexShape.up ℤ))
      (R.mapHomologicalComplex (ComplexShape.up ℤ)) :=
    { homEquiv := fun K L =>
        { toFun := fun f => HomologicalComplex.Hom.mk
            (fun i => adj.homEquiv (K.X i) (L.X i) (f.f i)) (by
              intro i j _
              dsimp
              rw [← Adjunction.homEquiv_naturality_right, ← Adjunction.homEquiv_naturality_left]
              congr 1
              exact f.comm i j)
          invFun := fun g => HomologicalComplex.Hom.mk
            (fun i => (adj.homEquiv (K.X i) (L.X i)).symm (g.f i)) (by
              intro i j _
              dsimp
              rw [← Adjunction.homEquiv_naturality_right_symm,
                ← Adjunction.homEquiv_naturality_left_symm]
              congr 1
              exact g.comm i j)
          left_inv := fun f => by ext i; simp
          right_inv := fun g => by ext i; simp }
      homEquiv_naturality_left_symm := by
        intro K' K L f g
        ext i
        simp [Adjunction.homEquiv_naturality_left_symm]
      homEquiv_naturality_right := by
        intro K L L' f g
        ext i
        simp [Adjunction.homEquiv_naturality_right] }
  let adjC := Adjunction.mkOfHomEquiv core
  letI : CatCommSq (G.mapHomologicalComplex (ComplexShape.up ℤ)) DerivedCategory.Q
      DerivedCategory.Q G.mapDerivedCategory := ⟨(G.mapDerivedCategoryFactors).symm⟩
  letI : CatCommSq (R.mapHomologicalComplex (ComplexShape.up ℤ)) DerivedCategory.Q
      DerivedCategory.Q R.mapDerivedCategory := ⟨(R.mapDerivedCategoryFactors).symm⟩
  let adjD := adjC.localization DerivedCategory.Q (HomologicalComplex.quasiIso 𝒜 (ComplexShape.up ℤ))
    DerivedCategory.Q (HomologicalComplex.quasiIso ℬ (ComplexShape.up ℤ))
    G.mapDerivedCategory R.mapDerivedCategory
  exact ⟨(adjD.homEquiv X Y).symm⟩

theorem wc_qmbt_csz_parity_hom_zero {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
    (N : ℤ) (hN : Odd N) (hN1 : 1 ≤ N) (V Z : DerivedCategory 𝒞)
    (hV : ∀ j : ℤ, j ≠ 0 → j ≠ N → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj V))
    (hP : Projective ((DerivedCategory.homologyFunctor 𝒞 N).obj V))
    (hZ : ∀ j : ℤ, (j < 2 ∨ Odd j) → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj Z))
    (g : V ⟶ Z) : g = 0 :=
by

  have s1 : ∀ (Y : 𝒞) (_ : Projective Y) (X : DerivedCategory 𝒞)
      (_ : ∀ j : ℤ, N ≤ j → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj X))
      (f : (DerivedCategory.singleFunctor 𝒞 N).obj Y ⟶ X), f = 0 := by
    intro Y hY X hX f
    haveI : X.IsLE (N - 1) :=
      (DerivedCategory.isLE_iff X (N - 1)).2 (fun j hj => hX j (by omega))
    obtain ⟨K, hK, ⟨e⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isLE X (N - 1)
    let s := (DerivedCategory.singleFunctorIsoCompQ 𝒞 N).app Y
    let φ : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 N).obj Y) ⟶
        DerivedCategory.Q.obj K := s.inv ≫ f ≫ e.hom
    haveI := hY
    have hφ : φ = 0 :=
      DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective φ (N - 1) (by omega)
    have hf : f = s.hom ≫ φ ≫ e.inv := by
      simp only [φ, Category.assoc, Iso.hom_inv_id, Category.comp_id, Iso.hom_inv_id_assoc]
    rw [hf, hφ, Limits.zero_comp, Limits.comp_zero]

  obtain ⟨A, B, hA, hB, i, p, δ, hT⟩ :=
    Triangulated.TStructure.exists_triangle DerivedCategory.TStructure.t V 0 1 rfl
  have hAle : DerivedCategory.TStructure.t.IsLE A 0 := ⟨hA⟩
  have hBge : DerivedCategory.TStructure.t.IsGE B 1 := ⟨hB⟩
  have hAz : ∀ j : ℤ, 0 < j → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj A) :=
    fun j hj => DerivedCategory.isZero_of_isLE A 0 j hj (hX := hAle)
  have hBz1 : ∀ j : ℤ, j < 1 → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj B) :=
    fun j hj => DerivedCategory.isZero_of_isGE B 1 j hj (hX := hBge)
  have hBz : ∀ j : ℤ, j ≠ N → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj B) := by
    intro j hj
    by_cases hj1 : j < 1
    · exact hBz1 j hj1
    · exact (DerivedCategory.HomologySequence.exact₃ _ hT j (j + 1)).isZero_X₂
        ((hV j (by omega) hj).eq_of_src _ _) ((hAz (j + 1) (by omega)).eq_of_tgt _ _)
  have hmono : Mono ((DerivedCategory.homologyFunctor 𝒞 N).map p) :=
    (DerivedCategory.HomologySequence.exact₂ _ hT N).mono_g
      ((hAz N (by omega)).eq_of_src _ _)
  have hepi : Epi ((DerivedCategory.homologyFunctor 𝒞 N).map p) :=
    (DerivedCategory.HomologySequence.exact₃ _ hT N (N + 1)).epi_f
      ((hAz (N + 1) (by omega)).eq_of_tgt _ _)
  haveI : IsIso ((DerivedCategory.homologyFunctor 𝒞 N).map p) := isIso_of_mono_of_epi _
  have hPB : Projective ((DerivedCategory.homologyFunctor 𝒞 N).obj B) :=
    Projective.of_iso (asIso ((DerivedCategory.homologyFunctor 𝒞 N).map p)) hP
  haveI hBge' : B.IsGE N := (DerivedCategory.isGE_iff B N).2 (fun j hj => hBz j (by omega))
  haveI hBle' : B.IsLE N := (DerivedCategory.isLE_iff B N).2 (fun j hj => hBz j (by omega))
  obtain ⟨Y, ⟨eB⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE B N
  have hY : Projective Y :=
    Projective.of_iso ((DerivedCategory.homologyFunctor 𝒞 N).mapIso eB ≪≫
      (DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒞 N).app Y) hPB

  have hZge2 : DerivedCategory.TStructure.t.IsGE Z 2 :=
    (DerivedCategory.isGE_iff Z 2).2 (fun j hj => hZ j (Or.inl hj))
  have h4 : i ≫ g = 0 :=
    DerivedCategory.TStructure.t.zero_of_isLE_of_isGE (i ≫ g) 0 2 (by norm_num) hAle hZge2
  obtain ⟨g', hg'⟩ := Pretriangulated.Triangle.yoneda_exact₂ _ hT g h4

  obtain ⟨X₁, Y₁, hX₁, hY₁, i₁, p₁, δ₁, hT₁⟩ :=
    Triangulated.TStructure.exists_triangle DerivedCategory.TStructure.t Z N (N + 1) rfl
  have hX₁le : DerivedCategory.TStructure.t.IsLE X₁ N := ⟨hX₁⟩
  have hY₁ge : DerivedCategory.TStructure.t.IsGE Y₁ (N + 1) := ⟨hY₁⟩
  have hY₁z : ∀ j : ℤ, j ≤ N → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj Y₁) :=
    fun j hj => DerivedCategory.isZero_of_isGE Y₁ (N + 1) j (by omega) (hX := hY₁ge)
  have hX₁z : ∀ j : ℤ, N ≤ j → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj X₁) := by
    intro j hj
    rcases eq_or_lt_of_le hj with h | h
    · rw [← h]
      exact (DerivedCategory.HomologySequence.exact₁ _ hT₁ (N - 1) N (by omega)).isZero_X₂
        ((hY₁z (N - 1) (by omega)).eq_of_src _ _) ((hZ N (Or.inr hN)).eq_of_tgt _ _)
    · exact DerivedCategory.isZero_of_isLE X₁ N j h (hX := hX₁le)

  have hBleN : DerivedCategory.TStructure.t.IsLE B N := hBle'
  have h6 : g' ≫ p₁ = 0 :=
    DerivedCategory.TStructure.t.zero_of_isLE_of_isGE (g' ≫ p₁) N (N + 1) (by omega) hBleN hY₁ge
  obtain ⟨h, hh⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT₁ g' h6

  have h7 : eB.inv ≫ h = 0 := s1 Y hY X₁ hX₁z (eB.inv ≫ h)
  have h0 : h = 0 := by
    have : h = eB.hom ≫ (eB.inv ≫ h) := by simp
    rw [this, h7, Limits.comp_zero]

  rw [hg', hh, h0, Limits.zero_comp, Limits.comp_zero]

theorem wc_qmbt_csz_point_unit_projective (k : Type u) [Field k] [IsSepClosed k] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] :
    Projective (SheafOfModules.unit (wcRingSheaf (Spec (.of k)) ℓ)) :=
by
  classical
  set S : Scheme.{u} := Spec (.of k) with hS

  let T : S.ProEt := Scheme.ProEt.mk (𝟙 S)
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  haveI : HenselianLocalRing k := Field.henselian k
  let e : k ≃+* IsLocalRing.ResidueField k :=
    RingEquiv.ofBijective (IsLocalRing.residue k)
      ⟨(IsLocalRing.residue k).injective, IsLocalRing.residue_surjective⟩
  haveI hsep : IsSepClosed (IsLocalRing.ResidueField k) := by
    apply IsSepClosed.of_exists_root
    intro p hmon hirr hsepp
    have hdeg : (p.map (e.symm : IsLocalRing.ResidueField k →+* k)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root
      (p.map (e.symm : IsLocalRing.ResidueField k →+* k)) hdeg
      (hsepp.map (f := (e.symm : IsLocalRing.ResidueField k →+* k)))
    refine ⟨e y, ?_⟩
    have h2 := hy.map (f := (e : k →+* IsLocalRing.ResidueField k))
    rw [Polynomial.map_map] at h2
    have hc : (e : k →+* IsLocalRing.ResidueField k).comp
        (e.symm : IsLocalRing.ResidueField k →+* k) = RingHom.id _ := by
      ext x; simp
    rw [hc, Polynomial.map_id] at h2
    exact h2

  haveI hfree : Projective (wcFreeSheaf S T) :=
    wc_proet_free_projective_strict_local S T k (Iso.refl _)

  obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
    (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) T hT
  haveI : Projective ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := hfree

  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
    (wcRingSheaf S ℓ)

  refine ⟨fun {E X} f p _ => ?_⟩
  haveI : Epi ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map p) := Functor.map_epi _ p
  obtain ⟨φ₁, hφ₁⟩ := Projective.factors (ε ≫ (SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map f)
    ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map p)
  obtain ⟨f', hf'⟩ := (hε E).2 φ₁
  refine ⟨f', (hε X).1 ?_⟩
  dsimp only at hf' ⊢
  rw [Functor.map_comp, ← Category.assoc, hf', hφ₁]

theorem wc_qmbt_dn_cone_shift_hom_zero {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    haveI := Dp'.additive
    haveI := Di'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    let eK' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xm ℓ))
          (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P' (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
        (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι'
    let eΨ' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
          (ComplexShape.up ℤ) 0).map Di'.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di'.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf Xm ℓ)) ≫
        (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    let Pβ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC βs) _ _ Dβ.cont Dβ.φ
    haveI := Dβ.additive
    haveI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
    ∀ (hP' : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj
      ((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K')))
      (hC : DerivedCategory.TStructure.t.plus
        (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ')))
      (v : (Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))) ⟶
        ((Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hC⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))))⟦(-1 : ℤ)⟧),
      v = 0 :=
by
  intro P' K' eK' eΨ' Pβ hP' hC v
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
  haveI := Dβ.additive
  haveI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
  haveI := Di'.additive
  haveI := Dp'.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj

  obtain ⟨Y, iY, hYci, hYred, EY, hEY, hYset, ⟨θ⟩⟩ := wc_qmbt_csz_cone_single hℓ hn hn4 hπ hc
    hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'

  have hYodd := wc_qmbt_csz_Y_odd hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl
    hblf hpb' hps' Y iY hYset
  have hYsub : Set.range iY ⊆ (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀} := by
    rw [hYset]
    exact Set.inter_subset_right

  obtain ⟨k, _, _, x, hx, Dx, hDx, hxcp, hPx, M, hM, ⟨ψ⟩⟩ := wc_qmbt_csz_push_point hℓ hn hn4 hπ
    hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I'
    Y iY EY hEY hYsub hYodd hC θ
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf (Spec (.of k)) ℓ))
  haveI := Dx.additive
  haveI := Dx.presLim
  haveI := Dx.presColim
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC x) _ _ Dx.cont
      Dx.φ).Additive := Adjunction.right_adjoint_additive Dx.adj
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC x) _ _ Dx.cont Dx.φ) :=
    @Limits.PreservesLimitsOfSize.preservesFiniteLimits _ _ _ _ _
      Dx.adj.rightAdjoint_preservesLimits.{0, 0}

  obtain ⟨e⟩ := wc_qmbt_csz_exact_adj_derived Dx.Φ
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC x) _ _ Dx.cont Dx.φ) Dx.adj
    ((Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
      (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))))
    (DerivedCategory.Q.obj M)

  obtain ⟨hvan, ⟨iN⟩⟩ := wc_qmbt_csz_milnor_stalk hℓ hn hn4 hπ hc hx₀ hsh hps hℓ' hπ' hπ'2 hgen
    hφ' halg' hbl hblf hpb' hps' hβ Dβ hDβ Dp' hDp' Di' hDi' I' hP' k x hxcp Dx hDx

  have hProj := Projective.of_iso iN.symm (wc_qmbt_csz_point_unit_projective k ℓ)
  have hodd : Odd ((n : ℤ) - 1) := by
    obtain ⟨r, hr⟩ := hn
    exact ⟨(r : ℤ) - 1, by rw [hr]; push_cast; ring⟩
  have hN1 : 1 ≤ (n : ℤ) - 1 := by omega

  have h0 := fun g => wc_qmbt_csz_parity_hom_zero ((n : ℤ) - 1) hodd hN1 _ _ hvan hProj hM g
  have hv : v ≫ ψ.hom = 0 := e.injective ((h0 _).trans (h0 _).symm)
  calc v = (v ≫ ψ.hom) ≫ ψ.inv := by rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
    _ = 0 := by rw [hv, Limits.zero_comp]

theorem wc_rdfp_plus_adj_transpose {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasDerivedCategory 𝒜]
    {𝒜' : Type*} [Category 𝒜'] [Abelian 𝒜'] [HasDerivedCategory 𝒜'] [EnoughInjectives 𝒜']
    (P : 𝒜' ⥤ 𝒜) [P.Additive] (Φ : 𝒜 ⥤ 𝒜') [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
    [Limits.PreservesFiniteColimits Φ] (adj : Φ ⊣ P) :
    ∃ τ : ∀ (X : CochainComplex 𝒜 ℤ) (Y : DerivedCategory.Plus 𝒜'),
        (DerivedCategory.Q.obj X ⟶ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y) ≃
          (DerivedCategory.Q.obj ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj X) ⟶ Y.obj),
      (∀ (X : CochainComplex 𝒜 ℤ) (Y Y' : DerivedCategory.Plus 𝒜')
          (a : DerivedCategory.Q.obj X ⟶ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y)
          (g : Y ⟶ Y'),
          τ X Y' (a ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map g) =
            τ X Y a ≫ g.hom) ∧
      (∀ (X X' : CochainComplex 𝒜 ℤ) (Y : DerivedCategory.Plus 𝒜') (h : X' ⟶ X)
          (a : DerivedCategory.Q.obj X ⟶ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y),
          τ X' Y (DerivedCategory.Q.map h ≫ a) =
            DerivedCategory.Q.map ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map h) ≫ τ X Y a) ∧
      (∀ (X : CochainComplex 𝒜 ℤ) (Y : DerivedCategory.Plus 𝒜'), τ X Y 0 = 0) :=
by
  classical

  have s1' : ∀ (K L : CochainComplex 𝒜' ℤ) [CochainComplex.IsKInjective L],
      (∀ φ : DerivedCategory.Q.obj K ⟶ DerivedCategory.Q.obj L,
        ∃ f : K ⟶ L, DerivedCategory.Q.map f = φ) ∧
      (∀ f g : K ⟶ L, DerivedCategory.Q.map f = DerivedCategory.Q.map g →
        Nonempty (Homotopy f g)) := by
    intro K L _
    have hb := CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient 𝒜' (ComplexShape.up ℤ)).obj K) L
    have key : ∀ f : K ⟶ L, DerivedCategory.Q.map f =
        (DerivedCategory.quotientCompQhIso 𝒜').inv.app K ≫
          DerivedCategory.Qh.map ((HomotopyCategory.quotient 𝒜' (ComplexShape.up ℤ)).map f) ≫
          (DerivedCategory.quotientCompQhIso 𝒜').hom.app L := by
      intro f
      exact (NatIso.naturality_1 (DerivedCategory.quotientCompQhIso 𝒜') f).symm
    refine ⟨fun φ => ?_, fun f g hfg => ?_⟩
    · obtain ⟨ψ, hψ⟩ := hb.2 ((DerivedCategory.quotientCompQhIso 𝒜').hom.app K ≫ φ ≫
        (DerivedCategory.quotientCompQhIso 𝒜').inv.app L)
      refine ⟨Quot.out ψ, ?_⟩
      rw [key, HomotopyCategory.quotient_map_out, hψ]
      simp
    · rw [key f, key g] at hfg
      have h2 := (cancel_mono _).1 ((cancel_epi _).1 hfg)
      exact ⟨HomotopyCategory.homotopyOfEq f g (hb.1 h2)⟩

  have s1 : ∀ (K L : CochainComplex 𝒜 ℤ) [CochainComplex.IsKInjective L],
      (∀ φ : DerivedCategory.Q.obj K ⟶ DerivedCategory.Q.obj L,
        ∃ f : K ⟶ L, DerivedCategory.Q.map f = φ) := by
    intro K L _
    have hb := CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient 𝒜 (ComplexShape.up ℤ)).obj K) L
    have key : ∀ f : K ⟶ L, DerivedCategory.Q.map f =
        (DerivedCategory.quotientCompQhIso 𝒜).inv.app K ≫
          DerivedCategory.Qh.map ((HomotopyCategory.quotient 𝒜 (ComplexShape.up ℤ)).map f) ≫
          (DerivedCategory.quotientCompQhIso 𝒜).hom.app L := by
      intro f
      exact (NatIso.naturality_1 (DerivedCategory.quotientCompQhIso 𝒜) f).symm
    intro φ
    obtain ⟨ψ, hψ⟩ := hb.2 ((DerivedCategory.quotientCompQhIso 𝒜).hom.app K ≫ φ ≫
      (DerivedCategory.quotientCompQhIso 𝒜).inv.app L)
    refine ⟨Quot.out ψ, ?_⟩
    rw [key, HomotopyCategory.quotient_map_out, hψ]
    simp

  let cK : ∀ K : CochainComplex 𝒜' ℤ, (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ⟶ K := fun K =>
    { f := fun n => adj.counit.app (K.X n)
      comm' := by
        intro i j _
        simp only [Functor.mapHomologicalComplex_obj_d]
        exact (adj.counit_naturality (K.d i j)).symm }
  have cK_f : ∀ (K : CochainComplex 𝒜' ℤ) (n : ℤ), (cK K).f n = adj.counit.app (K.X n) :=
    fun _ _ => rfl

  have s2 : ∀ (X : CochainComplex 𝒜 ℤ) (I : CochainComplex 𝒜' ℤ),
      (∀ g : (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj X ⟶ I,
        ∃ f : X ⟶ (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I,
          (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map f ≫ cK I = g) ∧
      (∀ f₁ f₂ : X ⟶ (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I,
        Homotopy ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map f₁ ≫ cK I)
          ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map f₂ ≫ cK I) →
          Nonempty (Homotopy f₁ f₂)) := by
    intro X I
    have key : ∀ (f : X ⟶ (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I) (n : ℤ),
        ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map f ≫ cK I).f n =
          (adj.homEquiv _ _).symm (f.f n) := by
      intro f n
      rw [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f, cK_f,
        Adjunction.homEquiv_counit]
    constructor
    · intro g
      refine ⟨{ f := fun n => adj.homEquiv _ _ (g.f n), comm' := ?_ }, ?_⟩
      · intro i j _
        simp only [Functor.mapHomologicalComplex_obj_d]
        rw [← Adjunction.homEquiv_naturality_right, ← Adjunction.homEquiv_naturality_left]
        congr 1
        have := g.comm i j
        simpa only [Functor.mapHomologicalComplex_obj_d] using this
      · ext n
        rw [key]
        exact (adj.homEquiv _ _).symm_apply_apply _
    · intro f₁ f₂ H
      refine ⟨{ hom := fun i j => adj.homEquiv _ _ (H.hom i j), zero := ?_, comm := ?_ }⟩
      · intro i j hij
        rw [H.zero i j hij, ← Adjunction.homAddEquiv_apply, map_zero]
      · intro i
        have h := H.comm i
        rw [key, key] at h
        have h' := congrArg (adj.homAddEquiv _ _) h
        rw [map_add, map_add] at h'
        simp only [Adjunction.homAddEquiv_apply, Equiv.apply_symm_apply] at h'
        rw [h']
        have r1 : (ComplexShape.up ℤ).Rel i (i + 1) := rfl
        have r2 : (ComplexShape.up ℤ).Rel (i - 1) i := by simp
        rw [dNext_eq _ r1, dNext_eq _ r1, prevD_eq _ r2, prevD_eq _ r2]
        simp only [Functor.mapHomologicalComplex_obj_d]
        rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]

  let G : DerivedCategory.Plus 𝒜 ⥤ DerivedCategory 𝒜' :=
    DerivedCategory.Plus.ι ⋙ Φ.mapDerivedCategory
  let W := CochainComplex.Plus.quasiIso 𝒜'
  let α := P.rightDerivedFunctorPlusUnit
  let α' : P.mapCochainComplexPlus ⋙ DerivedCategory.Plus.Q ⋙ G ⟶
      DerivedCategory.Plus.Q ⋙ (P.rightDerivedFunctorPlus ⋙ G) :=
    Functor.whiskerRight α G
  have hDer := CochainComplex.Plus.localizerMorphism_derives_mapCochainComplexPlus P
  have hD : (CochainComplex.Plus.localizerMorphism 𝒜').Derives
      (P.mapCochainComplexPlus ⋙ DerivedCategory.Plus.Q ⋙ G) :=
    MorphismProperty.IsInvertedBy.of_comp _ _ hDer G
  have hαiso : ∀ L : CochainComplex.Plus (InjectiveObject 𝒜'),
      IsIso (α.app ((CochainComplex.Plus.localizerMorphism 𝒜').functor.obj L)) := fun L =>
    LocalizerMorphism.Derives.isIso_of_isRightDerivedFunctor hDer α L
  haveI hRF : (P.rightDerivedFunctorPlus ⋙ G).IsRightDerivedFunctor α' W := by
    apply hD.isRightDerivedFunctor_of_isIso
    intro L
    haveI := hαiso L
    change IsIso (G.map (α.app ((CochainComplex.Plus.localizerMorphism 𝒜').functor.obj L)))
    infer_instance
  let β : P.mapCochainComplexPlus ⋙ DerivedCategory.Plus.Q ⋙ G ⟶
      DerivedCategory.Plus.Q ⋙ DerivedCategory.Plus.ι :=
    { app := fun K => Φ.mapDerivedCategoryFactors.hom.app
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj K.obj) ≫
          DerivedCategory.Q.map (cK K.obj)
      naturality := by
        intro K K' φ
        change Φ.mapDerivedCategory.map (DerivedCategory.Q.map
            ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map φ.hom)) ≫ _ =
          _ ≫ DerivedCategory.Q.map φ.hom
        have e1 := Φ.mapDerivedCategoryFactors.hom.naturality
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map φ.hom)
        simp only [Functor.comp_map] at e1
        have e2 : (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map φ.hom) ≫ cK K'.obj =
              cK K.obj ≫ φ.hom := by
          ext n
          simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f, cK_f]
          exact adj.counit_naturality _
        rw [← Category.assoc, e1, Category.assoc, ← Functor.map_comp, e2, Functor.map_comp,
          Category.assoc] }
  let ε : P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι ⋙ Φ.mapDerivedCategory ⟶
      DerivedCategory.Plus.ι :=
    (P.rightDerivedFunctorPlus ⋙ G).rightDerivedDesc α' W DerivedCategory.Plus.ι β
  have hε : ∀ K : CochainComplex.Plus 𝒜',
      Φ.mapDerivedCategoryFactors.inv.app
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj K.obj) ≫
        Φ.mapDerivedCategory.map (DerivedCategory.Plus.ι.map (α.app K)) ≫
          ε.app (DerivedCategory.Plus.Q.obj K) = DerivedCategory.Q.map (cK K.obj) := by
    intro K
    have h := Functor.rightDerived_fac_app (P.rightDerivedFunctorPlus ⋙ G) α' W
      DerivedCategory.Plus.ι β K
    have h' : Φ.mapDerivedCategory.map (DerivedCategory.Plus.ι.map (α.app K)) ≫
        ε.app (DerivedCategory.Plus.Q.obj K) =
          Φ.mapDerivedCategoryFactors.hom.app
            ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj K.obj) ≫
          DerivedCategory.Q.map (cK K.obj) := h
    rw [h', Iso.inv_hom_id_app_assoc]

  let T : ∀ (X : CochainComplex 𝒜 ℤ) (Y : DerivedCategory.Plus 𝒜'),
      (DerivedCategory.Q.obj X ⟶ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y) →
        (DerivedCategory.Q.obj ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj X) ⟶ Y.obj) :=
    fun X Y a => Φ.mapDerivedCategoryFactors.inv.app X ≫ Φ.mapDerivedCategory.map a ≫ ε.app Y
  have nat1 : ∀ (X : CochainComplex 𝒜 ℤ) (Y Y' : DerivedCategory.Plus 𝒜')
      (a : DerivedCategory.Q.obj X ⟶ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y)
      (g : Y ⟶ Y'),
      T X Y' (a ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map g) =
        T X Y a ≫ g.hom := by
    intro X Y Y' a g
    have e : Φ.mapDerivedCategory.map ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map g)
        ≫ ε.app Y' = ε.app Y ≫ g.hom := ε.naturality g
    simp only [T, Functor.map_comp, Category.assoc]
    rw [e]

  have s4 : ∀ (L : CochainComplex.Plus (InjectiveObject 𝒜')) (X : CochainComplex 𝒜 ℤ),
      Function.Bijective (T X (DerivedCategory.Plus.Q.obj
        ((CochainComplex.Plus.localizerMorphism 𝒜').functor.obj L))) := by
    intro L X
    let K := (CochainComplex.Plus.localizerMorphism 𝒜').functor.obj L
    let I := K.obj
    let J := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I
    haveI hI : CochainComplex.IsKInjective I :=
      (inferInstance : CochainComplex.IsKInjective
        (((InjectiveObject.ι 𝒜').mapHomologicalComplex (ComplexShape.up ℤ)).obj L.obj))
    obtain ⟨d, hd⟩ := (P.mapCochainComplexPlus.obj K).property
    haveI : CochainComplex.IsStrictlyGE J d := hd
    haveI hIX : ∀ n, Injective (I.X n) := fun n => (L.obj.X n).property
    haveI : ∀ n, Injective (J.X n) := fun n => Injective.injective_of_adjoint adj (I.X n)
    haveI hJ : CochainComplex.IsKInjective J := CochainComplex.isKInjective_of_injective J d
    let u : DerivedCategory.Q.obj J ⟶
        (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj (DerivedCategory.Plus.Q.obj K) :=
      DerivedCategory.Plus.ι.map (α.app K)
    haveI : IsIso (α.app K) := hαiso L
    haveI hu : IsIso u := (inferInstance : IsIso (DerivedCategory.Plus.ι.map (α.app K)))
    have KEY := hε K
    have form : ∀ f : X ⟶ J, T X (DerivedCategory.Plus.Q.obj K) (DerivedCategory.Q.map f ≫ u) =
        DerivedCategory.Q.map ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map f ≫ cK I) := by
      intro f
      have e : DerivedCategory.Q.map ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map f) ≫
          Φ.mapDerivedCategoryFactors.inv.app J =
            Φ.mapDerivedCategoryFactors.inv.app X ≫
              Φ.mapDerivedCategory.map (DerivedCategory.Q.map f) :=
        Φ.mapDerivedCategoryFactors.inv.naturality f
      simp only [T, Functor.map_comp, Category.assoc]
      rw [← reassoc_of% e, KEY]
    constructor
    · intro a₁ a₂ h
      obtain ⟨f₁, hf₁⟩ := s1 X J (a₁ ≫ inv u)
      obtain ⟨f₂, hf₂⟩ := s1 X J (a₂ ≫ inv u)
      have ha₁ : a₁ = DerivedCategory.Q.map f₁ ≫ u := by rw [hf₁]; simp
      have ha₂ : a₂ = DerivedCategory.Q.map f₂ ≫ u := by rw [hf₂]; simp
      rw [ha₁, ha₂, form, form] at h
      obtain ⟨H⟩ := (s1' _ I).2 _ _ h
      obtain ⟨H'⟩ := (s2 X I).2 f₁ f₂ H
      rw [ha₁, ha₂, DerivedCategory.Q_map_eq_of_homotopy _ H']
    · intro b
      obtain ⟨g, hg⟩ := (s1' ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj X) I).1 b
      obtain ⟨f, hf⟩ := (s2 X I).1 g
      exact ⟨DerivedCategory.Q.map f ≫ u, by rw [form, hf, hg]⟩

  have repl : ∀ Y : DerivedCategory.Plus 𝒜', ∃ L : CochainComplex.Plus (InjectiveObject 𝒜'),
      Nonempty (Y ≅ DerivedCategory.Plus.Q.obj
        ((CochainComplex.Plus.localizerMorphism 𝒜').functor.obj L)) := by
    intro Y
    haveI := Localization.essSurj DerivedCategory.Plus.Q (CochainComplex.Plus.quasiIso 𝒜')
    obtain ⟨R⟩ := (inferInstance : (CochainComplex.Plus.localizerMorphism 𝒜').HasRightResolutions)
      (DerivedCategory.Plus.Q.objPreimage Y)
    haveI : IsIso (DerivedCategory.Plus.Q.map R.w) :=
      Localization.inverts DerivedCategory.Plus.Q (CochainComplex.Plus.quasiIso 𝒜') R.w R.hw
    exact ⟨R.X₁, ⟨(DerivedCategory.Plus.Q.objObjPreimageIso Y).symm ≪≫
      asIso (DerivedCategory.Plus.Q.map R.w)⟩⟩

  have bij : ∀ X Y, Function.Bijective (T X Y) := by
    intro X Y
    obtain ⟨L, ⟨e⟩⟩ := repl Y
    have hB := s4 L X
    have hcomm := fun a => nat1 X _ _ a e.hom
    haveI : IsIso e.hom.hom := (inferInstance : IsIso (DerivedCategory.Plus.ι.map e.hom))
    constructor
    · intro a₁ a₂ h
      have h2 : a₁ ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map e.hom =
          a₂ ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map e.hom :=
        hB.1 (by rw [hcomm, hcomm, h])
      exact (cancel_mono _).1 h2
    · intro b
      obtain ⟨a', ha'⟩ := hB.2 (b ≫ e.hom.hom)
      refine ⟨a' ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map e.inv, ?_⟩
      have h1 : T X Y (a' ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map e.inv) ≫
          e.hom.hom = b ≫ e.hom.hom := by
        rw [← hcomm, Category.assoc, ← CategoryTheory.Functor.map_comp, e.inv_hom_id,
          CategoryTheory.Functor.map_id, Category.comp_id, ha']
      exact (cancel_mono _).1 h1
  refine ⟨fun X Y => Equiv.ofBijective (T X Y) (bij X Y), ?_, ?_, ?_⟩
  · intro X Y Y' a g
    exact nat1 X Y Y' a g
  · intro X X' Y h a
    have e : DerivedCategory.Q.map ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map h) ≫
        Φ.mapDerivedCategoryFactors.inv.app X =
          Φ.mapDerivedCategoryFactors.inv.app X' ≫
            Φ.mapDerivedCategory.map (DerivedCategory.Q.map h) :=
      Φ.mapDerivedCategoryFactors.inv.naturality h
    simp only [Equiv.ofBijective_apply, T, Functor.map_comp, Category.assoc]
    rw [reassoc_of% e]
  · intro X Y
    simp only [Equiv.ofBijective_apply, T, Functor.map_zero, Limits.zero_comp, Limits.comp_zero]

theorem wc_rdfp_plus_isGE_zero {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasDerivedCategory 𝒜]
    {𝒜' : Type*} [Category 𝒜'] [Abelian 𝒜'] [HasDerivedCategory 𝒜'] [EnoughInjectives 𝒜']
    (P : 𝒜' ⥤ 𝒜) [P.Additive] (X : CochainComplex 𝒜' ℤ) [X.IsStrictlyGE 0]
    (hX : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj X)) :
    DerivedCategory.TStructure.t.IsGE
      ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
        (⟨_, hX⟩ : DerivedCategory.Plus 𝒜')) 0 :=
by
  have h1 : (DerivedCategory.Q.obj X).IsGE 0 := (DerivedCategory.isGE_Q_obj_iff X 0).mpr inferInstance
  haveI h2 : DerivedCategory.Plus.IsGE (⟨_, hX⟩ : DerivedCategory.Plus 𝒜') 0 :=
    (DerivedCategory.Plus.isGE_ι_obj_iff (⟨_, hX⟩ : DerivedCategory.Plus 𝒜') 0).mp h1
  obtain ⟨L, hL, ⟨e⟩⟩ :=
    DerivedCategory.Plus.exists_injective_nonempty_iso (⟨_, hX⟩ : DerivedCategory.Plus 𝒜') 0
  haveI h4 : CochainComplex.IsStrictlyGE
      (((InjectiveObject.ι 𝒜').mapHomologicalComplex (ComplexShape.up ℤ)).obj L.obj) 0 :=
    (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff L.obj (InjectiveObject.ι 𝒜') 0).mpr hL
  haveI h4' : CochainComplex.IsStrictlyGE
      (((InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L).obj) 0 := h4
  have h5 : DerivedCategory.TStructure.t.IsGE (DerivedCategory.Q.obj
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L).obj)) 0 :=
    (DerivedCategory.isGE_Q_obj_iff _ 0).mpr inferInstance
  let E := (DerivedCategory.Plus.ι.mapIso
      (asIso (P.rightDerivedFunctorPlusUnit.app
        ((InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L))).symm ≪≫
      (DerivedCategory.Plus.QCompιIso 𝒜).app
        (P.mapCochainComplexPlus.obj ((InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L))).symm ≪≫
    DerivedCategory.Plus.ι.mapIso (P.rightDerivedFunctorPlus.mapIso e)
  have h6 : DerivedCategory.TStructure.t.IsGE
      ((CochainComplex.Plus.ι 𝒜 ⋙ DerivedCategory.Q).obj
        (P.mapCochainComplexPlus.obj ((InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L))) 0 :=
    h5
  exact DerivedCategory.TStructure.t.isGE_of_iso E 0

theorem wc_qmbt_pn_xsp_locNoeth {A : Type u} [CommRing A] [IsDomain A]
