import WeilR2_Part18
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_qmbt_nearby_transfer {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {L : Type u} [Field L] [IsSepClosed L] {φA : A →+* L} (hφA : Function.Injective φA)
    (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    {σ₂ : L →+* L} (hσ₂ : σ₂.comp φA = φA)
    {L' : Type u} [Field L'] [IsSepClosed L'] {ιL : L →+* L'}
    (hLalg : letI := ιL.toAlgebra; Algebra.IsAlgebraic L L')
    {σ' : L' →+* L'} (hσι : σ'.comp ιL = ιL.comp σ₂)
    {XE : Scheme.{u}} {p : XE ⟶ Spec (.of B₀)} {q : XE ⟶ Spec (.of L)}
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom φA)))
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {w : XE ⟶ XE} (hw₁ : w ≫ p = p) (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ₂))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {φ' : A' →+* L'} (hφ' : Function.Injective φ') (hφ'A : φ'.comp ιA = ιL.comp φA)
    (hσφ' : σ'.comp φ' = φ')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {w' : XE' ⟶ XE'} (hw₁' : w' ≫ p' = p') (hw₂' : w' ≫ q' = q' ≫ Spec.map (CommRingCat.ofHom σ'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Dτ : wcHMPullData w ℓ) (hDτ : wcHMPullCanonical Dτ)
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE ℓ)))
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Dτ' : wcHMPullData w' ℓ) (hDτ' : wcHMPullCanonical Dτ')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    haveI := Dp.cont
    haveI := Dτ.cont
    haveI : (wcProEtBC p ⋙ wcProEtBC w).IsContinuous
        (Scheme.ProEt.topology (Spec (.of B₀))) (Scheme.ProEt.topology XE) :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE) _
    let α : wcProEtBC p ⟶ wcProEtBC p ⋙ wcProEtBC w :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁.symm).hom
    haveI := Dp.additive
    haveI := Dτ.additive
    haveI := Di.additive
    ∀ (hφ : (Dp.φ ≫ ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology (Spec (.of B₀))) (Scheme.ProEt.topology XE)).map Dτ.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.ProEt.topology (Spec (.of B₀))) (Scheme.ProEt.topology XE)).app
          (wcRingSheaf XE ℓ) = Dp.φ)
      (t : (Dτ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
        I.cochainComplex),
      (Dτ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dτ.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcRingSheaf XE ℓ)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dτ.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
              (wcProEtBC w) _ _ Dτ.cont Dτ.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w) _ _ Dτ.cont Dτ.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive Dτ.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Dp.φ Dτ.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
          I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dτ.Φ ⋙ Pw from Dτ.adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dτ.Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
    let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    let TΨ := (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T
    haveI := Dp'.cont
    haveI := Dτ'.cont
    haveI : (wcProEtBC p' ⋙ wcProEtBC w').IsContinuous
        (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE') :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE') _
    let α' : wcProEtBC p' ⟶ wcProEtBC p' ⋙ wcProEtBC w' :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁'.symm).hom
    haveI := Dp'.additive
    haveI := Dτ'.additive
    haveI := Di'.additive
    ∀ (hφ' : (Dp'.φ ≫ ((wcProEtBC p').sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).map Dτ'.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α' RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).app
          (wcRingSheaf XE' ℓ) = Dp'.φ)
      (t' : (Dτ'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex ⟶
        I'.cochainComplex),
      (Dτ'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι' ≫ t' =
        (HomologicalComplex.singleMapHomologicalComplex Dτ'.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dτ'.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
              (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ)) ≫
        I'.ι' →
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let Pw' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ
    haveI : Pw'.Additive := Adjunction.right_adjoint_additive Dτ'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    let γ' : Pw' ⋙ P' ⟶ P' := (SheafOfModules.pushforwardComp Dp'.φ Dτ'.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α' ≫ (SheafOfModules.pushforwardCongr hφ').hom
    let Tflat' := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
          I'.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dτ'.Φ ⋙ Pw' from Dτ'.adj.unit)
          (ComplexShape.up ℤ)).app I'.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dτ'.Φ ⋙ Pw'))
          (ComplexShape.up ℤ)).inv.app I'.cochainComplex ≫
        (Pw'.mapHomologicalComplex (ComplexShape.up ℤ)).map t'
    let T' : K' ⟶ K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat' ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw' ⋙ P'))
          (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ' (ComplexShape.up ℤ)).app I'.cochainComplex
    let TΨ' := (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    let Pβ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC βs) _ _ Dβ.cont Dβ.φ
    haveI := Dβ.additive
    haveI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
    ∀ (hP' : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj
      ((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K'))),
    DerivedCategory.Q.map TΨ = 𝟙 _ →
      (Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
        (ObjectProperty.homMk
          (X := (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))))
          (Y := (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)))) (DerivedCategory.Q.map TΨ')) =
        𝟙 _ :=
by
  intro α hφ t ht P Pw K γ Tflat T TΨ α' hφc' t' ht' P' Pw' K' γ' Tflat' T' TΨ' Pβ hP' hT
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))

  obtain ⟨βE, hβp, hβq⟩ := wc_qmbt_nt_generic_fibre hφA hpb hπ' hφ' hφ'A hbl hblf hpb'

  have hwβ : w' ≫ βE = βE ≫ w := by
    apply hpb.hom_ext
    · rw [Category.assoc, Category.assoc, hw₁, hβp, ← Category.assoc w' p', hw₁']
    · have e : Spec.map (CommRingCat.ofHom σ') ≫ Spec.map (CommRingCat.ofHom ιL) =
          Spec.map (CommRingCat.ofHom ιL) ≫ Spec.map (CommRingCat.ofHom σ₂) := by
        rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← CommRingCat.ofHom_comp, hσι]
      calc (w' ≫ βE) ≫ q = (w' ≫ q') ≫ Spec.map (CommRingCat.ofHom ιL) := by
            rw [Category.assoc, hβq.w, Category.assoc]
        _ = q' ≫ Spec.map (CommRingCat.ofHom ιL) ≫ Spec.map (CommRingCat.ofHom σ₂) := by
            rw [hw₂', Category.assoc, e]
        _ = (βE ≫ w) ≫ q := by
            rw [Category.assoc, hw₂, ← Category.assoc βE q, hβq.w, Category.assoc]

  have hprop := wc_qmbt_nt_beta_proper hgen hbl

  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists (bl ≫ Limits.pullback.fst
    (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) ℓ
  haveI := Di.additive
  haveI := Dg.additive
  let Pg := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcProEtBC (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))) _ _ Dg.cont Dg.φ
  haveI : Pg.Additive := Adjunction.right_adjoint_additive Dg.adj

  obtain ⟨e, ⟨H⟩⟩ := wc_qmbt_nt_conj_homotopy hLalg hβp hβq hw₁ hw₁' hwβ Dg hDg Dp hDp Dτ hDτ I
    Dp' hDp' Dτ' hDτ' I' hφ t ht hφc' t' ht'
  have H' : Homotopy (T ≫ e.hom) (e.hom ≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map T') :=
    H

  obtain ⟨θ, hθ⟩ := wc_qmbt_nt_proper_base_change hℓ hn hn4 hπ hc hx₀ hsh hφA halg hLalg hps
    hℓ' hπ' hπ'2 hgen hφ' hφ'A hbl hblf hprop hpb' hps' hβ Dβ hDβ Dg hDg Di hDi Dp' hDp'
    Di' hDi' I' hP'

  have hu : IsIso (DerivedCategory.Q.map
      ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom)) := by
    refine ⟨⟨DerivedCategory.Q.map ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map e.inv),
      ?_, ?_⟩⟩
    · rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp,
        DerivedCategory.Q_map_eq_of_homotopy _ (Di.Φ.mapHomotopy e.homotopyHomInvId),
        CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
    · rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp,
        DerivedCategory.Q_map_eq_of_homotopy _ (Di.Φ.mapHomotopy e.homotopyInvHomId),
        CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]

  have h2 : DerivedCategory.Q.map TΨ ≫ DerivedCategory.Q.map
      ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom) =
      DerivedCategory.Q.map ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom) ≫
        DerivedCategory.Q.map ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map
          ((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map T')) := by
    have h := DerivedCategory.Q_map_eq_of_homotopy _ (Di.Φ.mapHomotopy H')
    simp only [CategoryTheory.Functor.map_comp] at h
    exact h

  have conj : ∀ {X M Y : DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))}
      (a : X ⟶ X) (v : X ⟶ M) (c₁ : M ⟶ M) (θ₁ : M ≅ Y) (b : Y ⟶ Y),
      IsIso v → a = 𝟙 X → a ≫ v = v ≫ c₁ → c₁ ≫ θ₁.hom = θ₁.hom ≫ b → b = 𝟙 Y := by
    intro X M Y a v c₁ θ₁ b hv ha h1 h3
    have hc : c₁ = 𝟙 M := by
      rw [ha, Category.id_comp] at h1
      exact (cancel_epi v).mp (h1.symm.trans (Category.comp_id v).symm)
    rw [hc, Category.id_comp] at h3
    exact (cancel_epi θ₁.hom).mp (h3.symm.trans (Category.comp_id _).symm)
  exact conj _ _ _ θ _ hu hT h2 (hθ T')

theorem wc_qmbt_hmconst_mul_zero (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ c c' : ℚ_[ℓ], wcHMConst S ℓ c ≫ wcHMConst S ℓ c' = wcHMConst S ℓ (c * c')) ∧
      wcHMConst S ℓ 0 = 0 :=
by
  have s0 : ∀ (c : ℚ_[ℓ]) (X : (S.ProEt)ᵒᵖ),
      (SheafOfModules.unitHomEquiv (SheafOfModules.unit (wcRingSheaf S ℓ))
        (wcHMConst S ℓ c)).val X = ContinuousMap.const _ (ULift.up c) := by
    intro c X
    unfold wcHMConst
    rw [Equiv.apply_symm_apply]
    rfl
  have s1 : ∀ (c : ℚ_[ℓ]) (X : (S.ProEt)ᵒᵖ),
      ((wcHMConst S ℓ c).val.app X).hom (1 : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])) =
        ContinuousMap.const _ (ULift.up c) := by
    intro c X
    exact (SheafOfModules.unitHomEquiv_apply_coe (SheafOfModules.unit (wcRingSheaf S ℓ))
      (wcHMConst S ℓ c) X).symm.trans (s0 c X)
  have s2 : ∀ (c : ℚ_[ℓ]) (X : (S.ProEt)ᵒᵖ) (x : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])),
      @Eq C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) (((wcHMConst S ℓ c).val.app X).hom x)
        (x * ContinuousMap.const (Opposite.unop X).left (ULift.up c)) := by
    intro c X x
    have h := LinearMap.map_smul ((wcHMConst S ℓ c).val.app X).hom x
      (1 : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]))
    have e1 : @Eq C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) x (x * 1) := (mul_one x).symm
    exact (congrArg (((wcHMConst S ℓ c).val.app X).hom) e1).trans
      (h.trans (congrArg (fun y : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) => x * y) (s1 c X)))
  refine ⟨fun c c' => ?_, ?_⟩
  · apply (SheafOfModules.unitHomEquiv (SheafOfModules.unit (wcRingSheaf S ℓ))).injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have A1 : @Eq C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])
        (((wcHMConst S ℓ c ≫ wcHMConst S ℓ c').val.app X).hom
          (1 : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])))
        (((wcHMConst S ℓ c').val.app X).hom (((wcHMConst S ℓ c).val.app X).hom
          (1 : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])))) := rfl
    have A2 : @Eq C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])
        (((wcHMConst S ℓ c').val.app X).hom (((wcHMConst S ℓ c).val.app X).hom
          (1 : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]))))
        (ContinuousMap.const (Opposite.unop X).left (ULift.up c) *
          ContinuousMap.const (Opposite.unop X).left (ULift.up c')) :=
      (s2 c' X _).trans (congrArg (fun y : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) =>
        y * ContinuousMap.const (Opposite.unop X).left (ULift.up c')) (s1 c X))
    have A3 : @Eq C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])
        (ContinuousMap.const (Opposite.unop X).left (ULift.up c) *
          ContinuousMap.const (Opposite.unop X).left (ULift.up c'))
        (ContinuousMap.const (Opposite.unop X).left (ULift.up (c * c'))) := by
      apply ContinuousMap.ext
      intro t
      rfl
    exact A1.trans (A2.trans (A3.trans (s1 (c * c') X).symm))
  · apply (SheafOfModules.unitHomEquiv (SheafOfModules.unit (wcRingSheaf S ℓ))).injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have h0 : (0 : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf S ℓ)).val = 0 := by
      first
        | rfl
        | (rw [← SheafOfModules.forget_map, Functor.map_zero])
    have B1 : @Eq C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])
        (((wcHMConst S ℓ 0).val.app X).hom (1 : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])))
        0 := by
      refine (s1 0 X).trans ?_
      apply ContinuousMap.ext
      intro t
      rfl
    have B2 : @Eq C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])
        (((0 : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
          SheafOfModules.unit (wcRingSheaf S ℓ)).val.app X).hom
            (1 : C((Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]))) 0 := by
      first
        | rfl
        | (rw [h0]; rfl)
        | (rw [h0, PresheafOfModules.zero_app]; rfl)
        | (simp [h0])
    exact B1.trans B2.symm

theorem wc_qmbt_detect_scalar_comm (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : CochainComplex (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ℤ)
    (e : (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ⟶ X) (d : ℚ_[ℓ]) :
    ∃ σ : X ⟶ X, (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (ComplexShape.up ℤ) 0).map (wcHMConst S ℓ d) ≫ e = e ≫ σ :=
by
  classical

  let r : ∀ V : (S.ProEt)ᵒᵖ, (wcRingSheaf S ℓ).obj.obj V := fun V =>
    (ContinuousMap.const ↥(Opposite.unop V).left (ULift.up d) :
      C(↥(Opposite.unop V).left, ULift.{u+1} ℚ_[ℓ]))
  have hcomm : ∀ (V : (S.ProEt)ᵒᵖ) (s : (wcRingSheaf S ℓ).obj.obj V), r V * s = s * r V := by
    intro V s
    exact @mul_comm C(↥(Opposite.unop V).left, ULift.{u+1} ℚ_[ℓ]) _ (r V) s

  let m : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), M ⟶ M := fun M =>
    SheafOfModules.Hom.mk (PresheafOfModules.Hom.mk (fun V => ModuleCat.ofHom
      ({ toFun := fun x => r V • x
         map_add' := fun x y => smul_add _ _ _
         map_smul' := fun s x => by
           rw [RingHom.id_apply, smul_smul, smul_smul, hcomm] } :
        M.val.obj V →ₗ[(wcRingSheaf S ℓ).obj.obj V] M.val.obj V))
      (by
        intro V W f
        ext x
        exact (M.val.map_smul f (r V) x).symm))
  have hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (φ : M ⟶ N),
      m M ≫ φ = φ ≫ m N := by
    intro M N φ
    apply SheafOfModules.Hom.ext
    apply PresheafOfModules.Hom.ext
    funext V
    ext x
    change (φ.val.app V).hom (r V • x) = r V • (φ.val.app V).hom x
    exact (φ.val.app V).hom.map_smul (r V) x
  have hunit : m (SheafOfModules.unit (wcRingSheaf S ℓ)) = wcHMConst S ℓ d := by
    apply (SheafOfModules.unit (wcRingSheaf S ℓ)).unitHomEquiv.injective
    rw [wcHMConst, Equiv.apply_symm_apply]
    apply PresheafOfModules.sections_ext
    intro V
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    exact mul_one (r V)
  refine ⟨{ f := fun i => m (X.X i), comm' := fun i j _ => hnat _ _ _ }, ?_⟩
  apply HomologicalComplex.from_single_hom_ext
  rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, HomologicalComplex.single_map_f_self]
  change _ = e.f 0 ≫ m (X.X 0)
  rw [← hunit, Category.assoc, Category.assoc, hnat]
  simp only [Category.assoc, Iso.hom_inv_id_assoc]

theorem wc_qmbt_hl_cov {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f) :
    ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f :=
by
  obtain ⟨Xm₀, f₀, bl₀, hbl₀, hblf₀, -, -, hcov₀, -⟩ :=
    wc_qmbt_blowup_model hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen

  obtain ⟨φ, hφ, -⟩ := hbl₀.2 Xm bl hbl.1
  obtain ⟨ψ, hψ, -⟩ := hbl.2 Xm₀ bl₀ hbl₀.1
  have h1 : φ ≫ ψ = 𝟙 Xm := by
    apply (hbl.2 Xm bl hbl.1).unique
    · simp only [Category.assoc, hψ, hφ]
    · simp only [Category.id_comp]
  have h2 : ψ ≫ φ = 𝟙 Xm₀ := by
    apply (hbl₀.2 Xm₀ bl₀ hbl₀.1).unique
    · simp only [Category.assoc, hφ, hψ]
    · simp only [Category.id_comp]
  haveI : IsIso φ := ⟨⟨ψ, h1, h2⟩⟩
  have hf : φ ≫ f₀ = f := by
    rw [← hblf₀, ← Category.assoc, hφ, hblf]

  intro x
  obtain ⟨U₀, r, g₀, hx, hg₀, heq⟩ := hcov₀ (φ x)
  haveI := hg₀
  refine ⟨φ ⁻¹ᵁ U₀, r, (φ ∣_ U₀) ≫ g₀, ?_, ?_, ?_⟩
  · exact (Scheme.Hom.mem_preimage φ).mpr hx
  · infer_instance
  · rw [Category.assoc, heq, ← Category.assoc, morphismRestrict_ι, Category.assoc, hf]

theorem wc_qmbt_hl_mv_closed_cover {S Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ S) (i₂ : Z₂ ⟶ S)
    (iY : ZY ⟶ S) [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hcover : Set.range i₁ ∪ Set.range i₂ = Set.univ)
    (hinter : Set.range iY = Set.range i₁ ∩ Set.range i₂)
    (E₁ : wcHMPullData i₁ ℓ) (hE₁ : wcHMPullCanonical E₁)
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂)
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY) :
    ∃ (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
      (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
        Limits.biprod.desc ρ₁ (-ρ₂) = 0),
      (ShortComplex.mk _ _ hz).ShortExact :=
by
  classical

  have G1 : ∀ x : S, x ∈ Set.range i₁ ∨ x ∈ Set.range i₂ := fun x => by
    have h : x ∈ Set.range i₁ ∪ Set.range i₂ := by rw [hcover]; exact Set.mem_univ x
    exact h
  have G2 : ∀ x : S, x ∈ Set.range i₁ → x ∈ Set.range i₂ → x ∈ Set.range iY := fun x h1 h2 => by
    rw [hinter]; exact ⟨h1, h2⟩
  have G31 : ∀ x : S, x ∈ Set.range iY → x ∈ Set.range i₁ := fun x h => by
    rw [hinter] at h; exact h.1
  have G32 : ∀ x : S, x ∈ Set.range iY → x ∈ Set.range i₂ := fun x h => by
    rw [hinter] at h; exact h.2

  have s1 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
      {L E₁ E₂ EY : 𝒞} (u₁ : L ⟶ E₁) (u₂ : L ⟶ E₂) (uY : L ⟶ EY)
      (hu₁ : Epi u₁) (hu₂ : Epi u₂) (huY : Epi uY)
      (ρ₁ : E₁ ⟶ EY) (ρ₂ : E₂ ⟶ EY) (h₁ : u₁ ≫ ρ₁ = uY) (h₂ : u₂ ≫ ρ₂ = uY)
      (hmono : ∀ {P : 𝒞} (g : P ⟶ L), g ≫ u₁ = 0 → g ≫ u₂ = 0 → g = 0)
      (hsplit : ∀ {P : 𝒞} (d : P ⟶ L), d ≫ uY = 0 →
        ∃ k₁ k₂ : P ⟶ L, k₁ ≫ u₁ = 0 ∧ k₂ ≫ u₂ = 0 ∧ d = k₁ + k₂)
      (hz : Limits.biprod.lift u₁ u₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = 0),
      (ShortComplex.mk _ _ hz).ShortExact := by
    intro 𝒞 _ _ L E₁ E₂ EY u₁ u₂ uY hu₁ hu₂ huY ρ₁ ρ₂ h₁ h₂ hmono hsplit hz
    have hmf : Mono (Limits.biprod.lift u₁ u₂) := by
      apply Preadditive.mono_of_cancel_zero
      intro P q hq
      apply hmono q
      · have := congrArg (· ≫ Limits.biprod.fst) hq
        simpa using this
      · have := congrArg (· ≫ Limits.biprod.snd) hq
        simpa using this
    have hρ₁ : Epi ρ₁ := epi_of_epi_fac h₁
    have heg : Epi (Limits.biprod.desc ρ₁ (-ρ₂)) := epi_of_epi_fac (Limits.biprod.inl_desc ρ₁ (-ρ₂))
    refine @ShortComplex.ShortExact.mk _ _ _ _ ?_ hmf heg
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro P (x₂ : P ⟶ E₁ ⊞ E₂) hx₂
    have hx₂' : x₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = 0 := hx₂
    set y₁ := x₂ ≫ Limits.biprod.fst
    set y₂ := x₂ ≫ Limits.biprod.snd
    have hstar : y₁ ≫ ρ₁ = y₂ ≫ ρ₂ := by
      have e : x₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = y₁ ≫ ρ₁ - y₂ ≫ ρ₂ := by
        rw [Limits.biprod.desc_eq]
        simp [y₁, y₂, Preadditive.comp_add, Preadditive.comp_neg, sub_eq_add_neg]
      rw [hx₂'] at e
      exact (sub_eq_zero.mp e.symm)
    obtain ⟨P₁, π₁, hπ₁, a₁, ha₁⟩ := surjective_up_to_refinements_of_epi u₁ y₁
    obtain ⟨P₂, π₂, hπ₂, a₂, ha₂⟩ := surjective_up_to_refinements_of_epi u₂ (π₁ ≫ y₂)
    have e1 : a₁ ≫ uY = π₁ ≫ y₁ ≫ ρ₁ := by
      rw [← h₁, ← Category.assoc, ← ha₁, Category.assoc]
    have e2 : a₂ ≫ uY = π₂ ≫ π₁ ≫ y₂ ≫ ρ₂ := by
      rw [← h₂, ← Category.assoc, ← ha₂]
      simp only [Category.assoc]
    obtain ⟨k₁, k₂, hk₁, hk₂, hd⟩ := hsplit (π₂ ≫ a₁ - a₂) (by
      rw [Preadditive.sub_comp, Category.assoc, e1, e2, hstar, sub_self])
    refine ⟨P₂, π₂ ≫ π₁, epi_comp _ _, π₂ ≫ a₁ - k₁, ?_⟩
    apply Limits.biprod.hom_ext
    · show ((π₂ ≫ π₁) ≫ x₂) ≫ Limits.biprod.fst =
        ((π₂ ≫ a₁ - k₁) ≫ Limits.biprod.lift u₁ u₂) ≫ Limits.biprod.fst
      simp only [Category.assoc, Limits.biprod.lift_fst, Preadditive.sub_comp, hk₁, sub_zero]
      change π₂ ≫ π₁ ≫ y₁ = _
      rw [ha₁]
    · show ((π₂ ≫ π₁) ≫ x₂) ≫ Limits.biprod.snd =
        ((π₂ ≫ a₁ - k₁) ≫ Limits.biprod.lift u₁ u₂) ≫ Limits.biprod.snd
      simp only [Category.assoc, Limits.biprod.lift_snd]
      have e : π₂ ≫ a₁ - k₁ = a₂ + k₂ := by
        have h' := hd
        rw [sub_eq_iff_eq_add] at h'
        rw [h']
        abel
      rw [e, Preadditive.add_comp, hk₂, add_zero, ← ha₂]

  have s2 : ∀ {X : Scheme.{u}} {i : X ⟶ S} (E : wcHMPullData i ℓ) (hE : wcHMPullCanonical E)
      {P : SheafOfModules.{u+1} (wcRingSheaf S ℓ)}
      (g : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ)),
      g ≫ wcSuppUnitMap E = 0 ↔
        ∀ (V : S.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left),
          V.hom x ∈ Set.range i →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p)) x = 0 := by
    intro X i E hE P g
    constructor
    · intro h0 V p x hx
      have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom p) h0
      change ((wcSuppUnitMap E).val.app (Opposite.op V)).hom
        ((g.val.app (Opposite.op V)).hom p) = 0 at hk
      have hx' : x ∈ Set.range (Limits.pullback.fst V.hom i) := by
        rw [Scheme.Pullback.range_fst]; exact hx
      obtain ⟨z, rfl⟩ := hx'
      obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit E
      have htw := wc_supp_hom_twist_formula E hE (wcSuppUnitMap E) V
        ((g.val.app (Opposite.op V)).hom p)
      rw [hk] at htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
      have h2 := congrArg (fun φ : C(↥X, ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd V.hom i).base.hom z)) hc'
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply] at h1 h2
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
              ((Limits.pullback.fst V.hom i).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap E))
              ((Limits.pullback.snd V.hom i).base.hom z) := h1
      show (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
        ((Limits.pullback.fst V.hom i).base.hom z) = 0
      linear_combination
        (-(c' ((Limits.pullback.snd V.hom i).base.hom z))) * h1' -
        ((@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op V)).hom p))
          ((Limits.pullback.fst V.hom i).base.hom z)) * h2
    · intro hv
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro p
      induction W using Opposite.rec with
      | op W =>
      change ((wcSuppUnitMap E).val.app (Opposite.op W)).hom
        ((g.val.app (Opposite.op W)).hom p) = 0
      have htw := wc_supp_hom_twist_formula E hE (wcSuppUnitMap E) W
        ((g.val.app (Opposite.op W)).hom p)
      refine htw.trans (ContinuousMap.ext fun z => ?_)
      have hz : W.hom ((Limits.pullback.fst W.hom i).base z) ∈ Set.range i :=
        ⟨(Limits.pullback.snd W.hom i).base z,
          (congrArg (fun φ => φ.base z) (Limits.pullback.condition (f := W.hom) (g := i))).symm⟩
      have h0 := hv W p _ hz
      show (@id C(↥W.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op W)).hom p))
          ((Limits.pullback.fst W.hom i).base.hom z) *
        (wcSuppTwist (wcSuppUnitMap E)) ((Limits.pullback.snd W.hom i).base.hom z) = 0
      rw [h0, zero_mul]

  have s3 : ∀ (Z₁ Z₂ : Set ↥S) (hZ₁ : IsClosed Z₁) (hZ₂ : IsClosed Z₂)
      (hcov : ∀ y : ↥S, y ∈ Z₁ ∨ y ∈ Z₂)
      {P : SheafOfModules.{u+1} (wcRingSheaf S ℓ)}
      (d : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      (hd : ∀ (V : S.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left),
        V.hom x ∈ Z₁ → V.hom x ∈ Z₂ →
        (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((d.val.app (Opposite.op V)).hom p)) x = 0),
      ∃ k₁ k₂ : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ), d = k₁ + k₂ ∧
        (∀ (V : S.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left), V.hom x ∈ Z₁ →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((k₁.val.app (Opposite.op V)).hom p)) x = 0) ∧
        (∀ (V : S.ProEt) (p : P.val.obj (Opposite.op V)) (x : ↥V.left), V.hom x ∈ Z₂ →
          (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((k₂.val.app (Opposite.op V)).hom p)) x = 0) := by
    intro Z₁ Z₂ hZ₁ hZ₂ hcov P d hd
    classical
    let ds : ∀ (V : S.ProEt), P.val.obj (Opposite.op V) → C(↥V.left, ULift.{u+1} ℚ_[ℓ]) :=
      fun V p => (d.val.app (Opposite.op V)).hom p
    let pst : ∀ (V : S.ProEt), P.val.obj (Opposite.op V) → C(↥V.left, ULift.{u+1} ℚ_[ℓ]) :=
      fun V p => ⟨fun x => if V.hom x ∈ Z₁ then ds V p x else 0, by
        have hA₁ : IsClosed (V.hom ⁻¹' Z₁) := hZ₁.preimage V.hom.continuous
        have hA₂ : IsClosed (V.hom ⁻¹' Z₂) := hZ₂.preimage V.hom.continuous
        have hU : (V.hom ⁻¹' Z₁ ∪ V.hom ⁻¹' Z₂) = Set.univ :=
          Set.eq_univ_of_forall (fun x => hcov (V.hom x))
        rw [← continuousOn_univ, ← hU]
        refine ContinuousOn.union_of_isClosed ?_ ?_ hA₁ hA₂
        · exact (ds V p).continuous.continuousOn.congr (fun x hx => if_pos hx)
        · refine (continuousOn_const (c := (0 : ULift.{u+1} ℚ_[ℓ]))).congr (fun x hx => ?_)
          by_cases h : V.hom x ∈ Z₁
          · rw [if_pos h]; exact hd V p x h hx
          · rw [if_neg h]⟩
    have hpst : ∀ V p x, pst V p x = if V.hom x ∈ Z₁ then ds V p x else 0 := fun _ _ _ => rfl
    have hds_add : ∀ V (p q : P.val.obj (Opposite.op V)), ds V (p + q) = ds V p + ds V q :=
      fun V p q => map_add _ p q
    have hds_smul : ∀ (V : S.ProEt) (r : (wcRingSheaf S ℓ).obj.obj (Opposite.op V))
        (p : P.val.obj (Opposite.op V)),
        ds V (r • p) = (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) r) * ds V p :=
      fun V r p => map_smul (d.val.app (Opposite.op V)).hom r p
    have hds_nat : ∀ {V W : S.ProEt} (g : W ⟶ V) (p : P.val.obj (Opposite.op V)),
        ds W ((P.val.map g.op).hom p) = (ds V p).comp g.left.base.hom := by
      intro V W g p
      exact PresheafOfModules.naturality_apply d.val g.op p
    let φ : P.val.presheaf ⟶ (SheafOfModules.unit (wcRingSheaf S ℓ)).val.presheaf :=
      { app := fun X => AddCommGrpCat.ofHom
          { toFun := fun p => (pst X.unop p : C(↥X.unop.left, ULift.{u+1} ℚ_[ℓ]))
            map_zero' := by
              apply ContinuousMap.ext; intro x
              rw [hpst]
              split_ifs
              · rw [show ds X.unop 0 = 0 from map_zero _]; rfl
              · rfl
            map_add' := by
              intro p q
              apply ContinuousMap.ext; intro x
              change pst X.unop (p + q) x = pst X.unop p x + pst X.unop q x
              rw [hpst, hpst, hpst, hds_add]
              split_ifs
              · rfl
              · rw [add_zero] }
        naturality := by
          intro X Y g
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro p
          apply ContinuousMap.ext
          intro y
          have hw : Y.unop.hom y = X.unop.hom (g.unop.left y) := by
            exact (congrArg (fun k => k.base y) (MorphismProperty.Over.w g.unop)).symm
          show (if Y.unop.hom y ∈ Z₁ then ds Y.unop ((P.val.map g).hom p) y else 0) =
            (if X.unop.hom (g.unop.left y) ∈ Z₁ then ds X.unop p (g.unop.left y) else 0)
          rw [hw]
          split_ifs
          · exact congrArg (fun f : C(↥Y.unop.left, ULift.{u+1} ℚ_[ℓ]) => f y) (hds_nat g.unop p)
          · rfl }
    let k₂ : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ) :=
      ⟨PresheafOfModules.homMk φ (by
        intro X r p
        apply ContinuousMap.ext
        intro x
        show (if X.unop.hom x ∈ Z₁ then ds X.unop (r • p) x else 0) =
          (@id C(↥X.unop.left, ULift.{u+1} ℚ_[ℓ]) r) x *
            (if X.unop.hom x ∈ Z₁ then ds X.unop p x else 0)
        rw [hds_smul]
        split_ifs
        · rfl
        · rw [mul_zero])⟩
    have hk₂ : ∀ (V : S.ProEt) (p : P.val.obj (Opposite.op V)), (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) ((k₂.val.app (Opposite.op V)).hom p)) =
        pst V p := fun V p => rfl
    refine ⟨d - k₂, k₂, (sub_add_cancel d k₂).symm, ?_, ?_⟩
    · intro V p x hx
      change (@id C(↥V.left, ULift.{u+1} ℚ_[ℓ]) (((d.val - k₂.val).app (Opposite.op V)).hom p)) x = 0
      rw [PresheafOfModules.sub_app, ModuleCat.hom_sub, LinearMap.sub_apply]
      change (ds V p - pst V p) x = 0
      rw [ContinuousMap.sub_apply, hpst, if_pos hx, sub_self]
    · intro V p x hx
      rw [hk₂, hpst]
      split_ifs with h
      · exact hd V p x h hx
      · rfl

  haveI hu₁ : Epi (wcSuppUnitMap E₁) := wc_supp_unit_epi_of_closed i₁ ℓ E₁ hE₁
  haveI hu₂ : Epi (wcSuppUnitMap E₂) := wc_supp_unit_epi_of_closed i₂ ℓ E₂ hE₂
  haveI huY : Epi (wcSuppUnitMap EY) := wc_supp_unit_epi_of_closed iY ℓ EY hEY

  have hk₁ : Limits.kernel.ι (wcSuppUnitMap E₁) ≫ wcSuppUnitMap EY = 0 := by
    have hv := (s2 E₁ hE₁ _).1 (Limits.kernel.condition _)
    exact (s2 EY hEY _).2 (fun V p x hx => hv V p x (G31 _ hx))
  have hk₂ : Limits.kernel.ι (wcSuppUnitMap E₂) ≫ wcSuppUnitMap EY = 0 := by
    have hv := (s2 E₂ hE₂ _).1 (Limits.kernel.condition _)
    exact (s2 EY hEY _).2 (fun V p x hx => hv V p x (G32 _ hx))
  let ρ₁ := Abelian.epiDesc (wcSuppUnitMap E₁) (wcSuppUnitMap EY) hk₁
  let ρ₂ := Abelian.epiDesc (wcSuppUnitMap E₂) (wcSuppUnitMap EY) hk₂
  have h₁ : wcSuppUnitMap E₁ ≫ ρ₁ = wcSuppUnitMap EY := Abelian.comp_epiDesc _ _ _
  have h₂ : wcSuppUnitMap E₂ ≫ ρ₂ = wcSuppUnitMap EY := Abelian.comp_epiDesc _ _ _

  have hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0 := by
    rw [Limits.biprod.lift_desc, Preadditive.comp_neg, h₁, h₂, add_neg_cancel]

  have hmono : ∀ {P : SheafOfModules.{u+1} (wcRingSheaf S ℓ)}
      (g : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ)),
      g ≫ wcSuppUnitMap E₁ = 0 → g ≫ wcSuppUnitMap E₂ = 0 → g = 0 := by
    intro P g hg₁ hg₂
    have v₁ := (s2 E₁ hE₁ g).1 hg₁
    have v₂ := (s2 E₂ hE₂ g).1 hg₂
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro p
    induction W using Opposite.rec with
    | op W =>
    change (@id C(↥W.left, ULift.{u+1} ℚ_[ℓ]) ((g.val.app (Opposite.op W)).hom p)) = 0
    apply ContinuousMap.ext
    intro x
    rcases G1 (W.hom x) with h | h
    · exact v₁ W p x h
    · exact v₂ W p x h

  have hsplit : ∀ {P : SheafOfModules.{u+1} (wcRingSheaf S ℓ)}
      (d : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ)), d ≫ wcSuppUnitMap EY = 0 →
      ∃ k₁ k₂ : P ⟶ SheafOfModules.unit (wcRingSheaf S ℓ),
        k₁ ≫ wcSuppUnitMap E₁ = 0 ∧ k₂ ≫ wcSuppUnitMap E₂ = 0 ∧ d = k₁ + k₂ := by
    intro P d hd
    have vY := (s2 EY hEY d).1 hd
    obtain ⟨k₁, k₂, hdk, hv₁, hv₂⟩ := s3 (Set.range i₁) (Set.range i₂)
      (Scheme.Hom.isClosedEmbedding i₁).isClosed_range
      (Scheme.Hom.isClosedEmbedding i₂).isClosed_range G1 d
      (fun V p x h1 h2 => vY V p x (G2 _ h1 h2))
    exact ⟨k₁, k₂, (s2 E₁ hE₁ k₁).2 hv₁, (s2 E₂ hE₂ k₂).2 hv₂, hdk⟩

  exact ⟨ρ₁, ρ₂, hz, s1 _ _ _ hu₁ hu₂ huY ρ₁ ρ₂ h₁ h₂ hmono hsplit hz⟩

theorem wc_qmbt_hl_cone_single {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
    [HasDerivedCategory 𝒞] (O SY : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
    (e : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O ⟶ Ψ)
    (hGE : (DerivedCategory.Q.obj (CochainComplex.mappingCone e)).IsGE 1)
    (hΨ : ∀ q : ℤ, 2 ≤ q → Limits.IsZero (Ψ.homology q))
    (h1 : Nonempty (Ψ.homology 1 ≅ SY)) :
    Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone e))⟦(1 : ℤ)⟧ ≅
      (DerivedCategory.singleFunctor 𝒞 0).obj SY) :=
by
  let T := DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle e)
  have hT : T ∈ distTriang (DerivedCategory 𝒞) :=
    DerivedCategory.mappingCone_triangle_distinguished e
  have hZ : ∀ n : ℤ, n ≠ 0 →
      Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 n).obj T.obj₁) := by
    intro n hn
    exact (HomologicalComplex.isZero_single_obj_homology (ComplexShape.up ℤ) 0 O n hn).of_iso
      ((DerivedCategory.homologyFunctorFactors 𝒞 n).app _)
  have s1 : ∀ q : ℤ, 2 ≤ q → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj
      (DerivedCategory.Q.obj (CochainComplex.mappingCone e))) := by
    intro q hq
    have hS := DerivedCategory.HomologySequence.exact₃ T hT q (q + 1) rfl
    have hX1 : Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₂) :=
      (hΨ q hq).of_iso ((DerivedCategory.homologyFunctorFactors 𝒞 q).app Ψ)
    have hX3 := hZ (q + 1) (by omega)
    exact hS.isZero_X₂ (hX1.eq_of_src _ _) (hX3.eq_of_tgt _ _)
  have s2 : Nonempty ((DerivedCategory.homologyFunctor 𝒞 1).obj
      (DerivedCategory.Q.obj (CochainComplex.mappingCone e)) ≅ Ψ.homology 1) := by
    have h2 := DerivedCategory.HomologySequence.exact₂ T hT 1
    have h3 := DerivedCategory.HomologySequence.exact₃ T hT 1 2 rfl
    have : Mono ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂) :=
      h2.mono_g ((hZ 1 one_ne_zero).eq_of_src _ _)
    have : Epi ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂) :=
      h3.epi_f ((hZ 2 two_ne_zero).eq_of_tgt _ _)
    have := isIso_of_mono_of_epi ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂)
    exact ⟨(asIso ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂)).symm ≪≫
      (DerivedCategory.homologyFunctorFactors 𝒞 1).app Ψ⟩
  have : (DerivedCategory.Q.obj (CochainComplex.mappingCone e)).IsLE 1 := by
    rw [DerivedCategory.isLE_iff]
    intro i hi
    exact s1 i (by omega)
  obtain ⟨Y, ⟨φ⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE
    (DerivedCategory.Q.obj (CochainComplex.mappingCone e)) 1
  obtain ⟨i₁⟩ := s2
  obtain ⟨i₂⟩ := h1
  let ψY : Y ≅ SY := ((DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒞 1).app Y).symm ≪≫
    (DerivedCategory.homologyFunctor 𝒞 1).mapIso φ.symm ≪≫ i₁ ≪≫ i₂
  exact ⟨(shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).mapIso φ ≪≫
    ((DerivedCategory.singleFunctors 𝒞).shiftIso 1 0 1 (by norm_num)).app Y ≪≫
    (DerivedCategory.singleFunctor 𝒞 0).mapIso ψY⟩

theorem wc_qmbt_hl_xs_noeth {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    IsLocallyNoetherian Xs' :=
by
  classical
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh

  haveI hB₀ : IsNoetherianRing B₀ := by
    let ψ : wcQuadModelRing A n π c →+* B₀ := (Spec.preimage a₀).hom
    let P : Ideal (wcQuadModelRing A n π c) := Ideal.comap ψ (IsLocalRing.maximalIdeal B₀)
    haveI hPp : P.IsPrime := Ideal.comap_isPrime _ _
    haveI : IsNoetherianRing (wcQuadModelRing A n π c) := by
      unfold wcQuadModelRing
      infer_instance
    have hg : ∀ y : P.primeCompl, IsUnit (ψ y) := by
      intro y
      have hy : y.1 ∉ P := y.2
      by_contra h
      exact hy (Ideal.mem_comap.mpr ((IsLocalRing.mem_maximalIdeal _).mpr h))
    let θ : Localization.AtPrime P →+* B₀ :=
      IsLocalization.lift (M := P.primeCompl) (S := Localization.AtPrime P) hg
    have hθ : θ.comp (algebraMap _ (Localization.AtPrime P)) = ψ := IsLocalization.lift_comp hg
    have hloc : IsLocalHom θ := by
      refine ⟨fun x hx => ?_⟩
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl x
      have e : ψ a = ψ s * θ (IsLocalization.mk' (Localization.AtPrime P) a s) :=
        (IsLocalization.lift_mk'_spec (M := P.primeCompl) (S := Localization.AtPrime P)
          (g := ψ) hg a _ s).mp rfl
      have hua : IsUnit (ψ a) := e ▸ (hg s).mul hx
      have haP : a ∈ P.primeCompl := by
        intro ha
        exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mem_comap.mp ha) hua
      exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime P) P a s).mpr haP
    have e : Spec.map (CommRingCat.ofHom ψ) = a₀ := by
      simp only [ψ, CommRingCat.ofHom_hom, Spec.map_preimage]
    have hRB := wc_lpkt_specMap_weaklyEtale_ring _ B₀ ψ (e ▸ ha₀)
    have hRC : Algebra.WeaklyEtale _ (Localization.AtPrime P) :=
      wc_localization_weaklyEtale _ (Localization.AtPrime P) P.primeCompl
    letI : Algebra (wcQuadModelRing A n π c) B₀ := ψ.toAlgebra
    letI : Algebra (Localization.AtPrime P) B₀ := θ.toAlgebra
    have hT : @IsScalarTower (wcQuadModelRing A n π c)
        (Localization.AtPrime P) B₀ Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
      IsScalarTower.of_algebraMap_eq' hθ.symm
    have hCB : @Algebra.WeaklyEtale (Localization.AtPrime P) B₀ _ _ θ.toAlgebra :=
      @wc_weaklyEtale_cancel _ (Localization.AtPrime P) B₀ _ _ _ _ _ _ hT hRC hRB
    exact (wc_tla_shens_noeth_unram (Localization.AtPrime P) B₀ θ hloc hCB).1

  haveI hP : IsNoetherian (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    letI := ιA.toAlgebra
    have hfin : ιA.Finite := by
      show Module.Finite A A'
      refine ⟨⟨{1, π'}, ?_⟩⟩
      rw [Submodule.eq_top_iff']
      intro a'
      obtain ⟨x, y, rfl⟩ := hgen a'
      rw [Finset.coe_insert, Finset.coe_singleton]
      exact Submodule.mem_span_pair.mpr ⟨x, y, by
        rw [Algebra.smul_def, Algebra.smul_def, mul_one]; rfl⟩
    haveI : IsFinite (Spec.map (CommRingCat.ofHom ιA)) := by
      rw [IsFinite.SpecMap_iff]
      exact hfin
    haveI := LocallyOfFiniteType.isLocallyNoetherian
        (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
    haveI := QuasiCompact.compactSpace_of_compactSpace
        (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
    constructor <;> infer_instance

  have c3 : ∀ (X : Scheme.{u}) [IsNoetherian X] (I : X.IdealSheafData) (X' : Scheme.{u})
      (r : X' ⟶ X), wcCsdIsBlowup I r → IsLocallyNoetherian X' := by
    intro X _ I X' r hb
    obtain ⟨X'', r'', hb'', hN⟩ := wc_csd_blowup_exists_noeth X I
    obtain ⟨φ, hφ, -⟩ := hb''.2 X' r hb.1
    obtain ⟨ψ, hψ, -⟩ := hb.2 X'' r'' hb''.1
    have h1 : φ ≫ ψ = 𝟙 X' := by
      apply (hb.2 X' r hb.1).unique
      · simp only [Category.assoc, hψ, hφ]
      · simp only [Category.id_comp]
    have h2 : ψ ≫ φ = 𝟙 X'' := by
      apply (hb''.2 X'' r'' hb''.1).unique
      · simp only [Category.assoc, hφ, hψ]
      · simp only [Category.id_comp]
    haveI : IsIso φ := ⟨⟨ψ, h1, h2⟩⟩
    haveI := hN
    exact isLocallyNoetherian_of_isOpenImmersion φ
  haveI : IsLocallyNoetherian Xm := c3 _ _ Xm bl hbl

  haveI hQm : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip hQm
  exact LocallyOfFiniteType.isLocallyNoetherian ι'

theorem wc_qmbt_hl_chart_coords_off {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det)
    (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' c' j)) :
    ∃ (h : wcQmbtChart A' n π' c' j) (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
      h ∉ 𝔭.asIdeal ∧
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away h) ∧
      ψ.Etale ∧
      ∀ 𝔮 : PrimeSpectrum (Localization.Away h),
        𝔮.asIdeal.comap (algebraMap (wcQmbtChart A' n π' c' j) (Localization.Away h)) =
          𝔭.asIdeal →
        ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) ∈ 𝔮.asIdeal →
        ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2)))) ∈ 𝔮.asIdeal →
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∈ 𝔭.asIdeal ∧
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∈ 𝔭.asIdeal :=
by
  classical

  have caseB : ∀ {i₀ : Fin n} (hij : i₀ ≠ j) (τ : Fin (n - 2) ≃ {p : Fin n // p ≠ i₀ ∧ p ≠ j})
      (ε : A'),
      ∃ ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away ((2 : wcQmbtChart A' n π' c' j) *
          Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) *
          Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (MvPolynomial.X (some i₀) + MvPolynomial.C ε)),
        ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' _ ∧ ψ.Etale ∧
        IsUnit (ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2))))) := by
    intro i₀ hij τ ε

    have c4 : ∀ {M K : Type u} [CommRing M] [CommRing K] (κ m₀ : M) (α : M →+* K) (t : K),
        (∀ {L : Type u} [CommRing L] (β : M →+* L) (r : L), r ^ 2 = β κ →
          IsUnit (β (2 * m₀) * r) →
          ∃ Φ : K →+* L, Φ.comp α = β ∧ Φ t = r ∧
            ∀ Ψ : L →+* K, Ψ.comp β = α → Ψ r = t → Ψ.comp Φ = RingHom.id K) →
        t ^ 2 = α κ → IsUnit (α (2 * m₀) * t) → α.Etale := by
      intro M K _ _ κ m₀ α t hU h1 h2
      have hmk : AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X) =
          AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C κ) (2 * m₀) *
            AdjoinRoot.root (Polynomial.X ^ 2 - Polynomial.C κ) := by
        rw [map_mul, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
      have hval : algebraMap M (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
            (Polynomial.C (2 * m₀) * Polynomial.X))) (2 * m₀) *
          algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
            (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
            (Polynomial.C (2 * m₀) * Polynomial.X))) (AdjoinRoot.root _) =
          algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
            (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
            (Polynomial.C (2 * m₀) * Polynomial.X)))
            (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
              (Polynomial.C (2 * m₀) * Polynomial.X)) := by
        show algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ)) _
          (AdjoinRoot.of _ (2 * m₀)) * _ = _
        rw [← map_mul, ← hmk]
      have hu0 := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (AdjoinRoot.mk
        (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X)))
        (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X))
      rw [← hval] at hu0
      have hr0 : (algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
          (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
            (Polynomial.C (2 * m₀) * Polynomial.X))) (AdjoinRoot.root _)) ^ 2 =
          algebraMap M (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
            (Polynomial.C (2 * m₀) * Polynomial.X))) κ := by
        have h0 : (AdjoinRoot.root (Polynomial.X ^ 2 - Polynomial.C κ)) ^ 2 -
            AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C κ) κ = 0 := by
          rw [← AdjoinRoot.mk_X, ← AdjoinRoot.mk_C, ← map_pow, ← map_sub]
          exact AdjoinRoot.mk_self
        have h0' := congrArg (algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
          (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
            (Polynomial.C (2 * m₀) * Polynomial.X)))) h0
        rw [map_sub, map_pow, map_zero] at h0'
        exact sub_eq_zero.mp h0'
      obtain ⟨Φ, h3, h4, h5⟩ := hU _ _ hr0 hu0
      let P : StandardEtalePair M :=
        { f := Polynomial.X ^ 2 - Polynomial.C κ
          monic_f := Polynomial.monic_X_pow_sub_C κ two_ne_zero
          g := Polynomial.C (2 * m₀) * Polynomial.X
          cond := ⟨Polynomial.C m₀, 0, 1, by
            simp [Polynomial.C_ofNat]
            ring⟩ }
      have : Algebra.Etale M P.Ring := inferInstance
      have hL : Algebra.Etale M (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X))) :=
        Algebra.Etale.of_equiv P.equivAwayAdjoinRoot
      have hLe := RingHom.etale_algebraMap.mpr hL
      have h0 : (Polynomial.X ^ 2 - Polynomial.C κ).eval₂ α t = 0 := by simp [h1]
      let Ψ₀ : AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ) →+* K := AdjoinRoot.lift α t h0
      have hΨ₀e : IsUnit (Ψ₀ (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X))) := by
        simp only [Ψ₀, AdjoinRoot.lift_mk, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_X]
        exact h2
      let Ψ : Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X)) →+* K :=
        IsLocalization.Away.lift (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X)) hΨ₀e
      have hΨB : ∀ b, Ψ (algebraMap _ _ b) = Ψ₀ b := fun b => IsLocalization.Away.lift_eq _ _ b
      have hT : ∀ a : M, algebraMap M (Localization.Away (AdjoinRoot.mk
          (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X))) a =
          algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ)) _ (AdjoinRoot.of _ a) :=
        fun a => rfl
      have hΨ1 : Ψ.comp (algebraMap M _) = α := by
        ext a
        rw [RingHom.comp_apply, hT, hΨB]
        exact AdjoinRoot.lift_of _
      have hΨ2 : Ψ (algebraMap _ _ (AdjoinRoot.root (Polynomial.X ^ 2 - Polynomial.C κ))) = t := by
        rw [hΨB]; exact AdjoinRoot.lift_root _
      have hΨΦ := h5 Ψ hΨ1 hΨ2
      have hΦΨ : Φ.comp Ψ = RingHom.id _ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (AdjoinRoot.mk
          (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X)))
        apply AdjoinRoot.ringHom_ext
        · ext a
          simp only [RingHom.comp_apply, RingHom.id_apply, hΨB]
          rw [show Ψ₀ (AdjoinRoot.of _ a) = α a from AdjoinRoot.lift_of _,
            ← RingHom.comp_apply Φ α, h3, hT]
        · simp only [RingHom.comp_apply, RingHom.id_apply, hΨB]
          rw [show Ψ₀ (AdjoinRoot.root _) = t from AdjoinRoot.lift_root _, h4]
      let E := RingEquiv.ofRingHom Ψ Φ hΨΦ hΦΨ
      have hαE : α = E.toRingHom.comp (algebraMap M _) := by
        rw [← hΨ1]; rfl
      rw [hαE]
      exact RingHom.Etale.respectsIso.1 _ E hLe

    have hcol : ∀ (m : ℕ) {R : Type u} [CommRing R] (f : A' →+* R) (z : Fin (m + 2) → R),
        ∑ a : Fin (m + 2), ∑ b : Fin (m + 2), f ((Matrix.of fun a b : Fin (m + 2) =>
          if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) a b) * z a * z b =
        z ⟨0, by omega⟩ * z ⟨1, by omega⟩ := by
      intro m R _ f z
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (m + 2))]
      · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (m + 2))]
        · simp
        · intro b _ hb
          have hb' : b.val ≠ 1 := fun h => hb (Fin.ext h)
          simp [hb']
        · simp
      · intro a _ ha
        have ha' : a.val ≠ 0 := fun h => ha (Fin.ext h)
        apply Finset.sum_eq_zero
        intro b _
        rw [Matrix.of_apply, if_neg (fun h => ha' h.1), map_zero, zero_mul, zero_mul]
      · simp

    have c1 : ∀ {T : Type u} [CommRing T] (m : ℕ) (ι : A' →+* T) (y : Fin (m + 2) → T),
        y ⟨0, by omega⟩ * y ⟨1, by omega⟩ = ι π' →
        ∃ α : wcQmbtSSRing A' m π' →+* T, α.comp (algebraMap A' (wcQmbtSSRing A' m π')) = ι ∧
          ∀ a : Fin (m + 2), α (Ideal.Quotient.mk (wcQuadModelIdeal A' (m + 2) π'
            (Matrix.of fun a b : Fin (m + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X a)) = y a := by
      intro T _ m ι y hy
      have hker : ∀ a ∈ wcQuadModelIdeal A' (m + 2) π'
          (Matrix.of fun a b : Fin (m + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0),
          MvPolynomial.eval₂Hom ι y a = 0 := by
        intro a ha
        obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        rw [map_mul]
        apply mul_eq_zero_of_right
        simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
        rw [hcol m ι y, hy, sub_self]
      refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom ι y) hker, ?_, ?_⟩
      · ext a
        show Ideal.Quotient.lift (wcQuadModelIdeal A' (m + 2) π' (Matrix.of fun a b : Fin (m + 2) =>
            if a.val = 0 ∧ b.val = 1 then (1 : A') else 0)) (MvPolynomial.eval₂Hom ι y) hker
          (Ideal.Quotient.mk (wcQuadModelIdeal A' (m + 2) π' (Matrix.of fun a b : Fin (m + 2) =>
            if a.val = 0 ∧ b.val = 1 then (1 : A') else 0)) (MvPolynomial.C a)) = ι a
        rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
      · intro a
        rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']

    have c3 : ∀ {T : Type u} [CommRing T] (ι : A' →+* T) (z : T) (w : Fin n → T),
        w j * z = ι π' →
        ∑ p, ∑ q, ι (c' p q) * (if p = j then 1 else w p) * (if q = j then 1 else w q) = z ^ 2 →
        ∃ φ : wcQmbtChart A' n π' c' j →+* T, φ.comp (algebraMap A' _) = ι ∧
          φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none)) = z ∧
          ∀ p, φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (MvPolynomial.X (some p))) = w p := by
      intro T _ ι z w h1 h2
      obtain ⟨e, he⟩ : ∃ e : MvPolynomial (Option (Fin n)) A' →+* T,
          e = MvPolynomial.eval₂Hom ι (fun o => Option.elim o z w) := ⟨_, rfl⟩
      have heC : ∀ a, e (MvPolynomial.C a) = ι a := fun a => by rw [he, MvPolynomial.eval₂Hom_C]
      have heN : e (MvPolynomial.X none) = z := by rw [he, MvPolynomial.eval₂Hom_X']; rfl
      have heS : ∀ p, e (MvPolynomial.X (some p)) = w p := fun p => by
        rw [he, MvPolynomial.eval₂Hom_X']; rfl
      have hhat : ∀ p, e (wcQmbtChartHat (A' := A') j p) = if p = j then 1 else w p := by
        intro p
        by_cases hp : p = j
        · rw [if_pos hp]; simp only [wcQmbtChartHat, if_pos hp, map_one]
        · rw [if_neg hp]; simp only [wcQmbtChartHat, if_neg hp, heS]
      have hker : ∀ a ∈ wcQmbtChartIdeal A' n π' c' j, e a = 0 := by
        intro a ha
        have hle : wcQmbtChartIdeal A' n π' c' j ≤ RingHom.ker e := by
          rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
          refine ⟨?_, ?_⟩
          · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, heS, heN, heC, h1, sub_self]
          · rw [SetLike.mem_coe, RingHom.mem_ker]
            simp only [map_sub, map_sum, map_mul, map_pow, heC, hhat, heN]
            rw [h2, sub_self]
        exact hle ha
      refine ⟨Ideal.Quotient.lift _ e hker, ?_, ?_, ?_⟩
      · ext a
        show Ideal.Quotient.lift (wcQmbtChartIdeal A' n π' c' j) e hker
          (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.C a)) = ι a
        rw [Ideal.Quotient.lift_mk, heC]
      · rw [Ideal.Quotient.lift_mk, heN]
      · intro p; rw [Ideal.Quotient.lift_mk, heS]

    set mkC := Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) with hmkC
    set mkM := Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
      (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
      with hmkM
    set H : wcQmbtChart A' n π' c' j := (2 : wcQmbtChart A' n π' c' j) * mkC (MvPolynomial.X none) *
      mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε) with hH
    set algC := algebraMap (wcQmbtChart A' n π' c' j) (Localization.Away H) with halgC
    have hAK : ∀ a, algebraMap A' (Localization.Away H) a = algC (mkC (MvPolynomial.C a)) := by
      intro a
      rw [IsScalarTower.algebraMap_apply A' (wcQmbtChart A' n π' c' j) (Localization.Away H)]
      rfl

    set S := algC (mkC (MvPolynomial.X none)) with hSdef
    set V := algC (mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)) with hVdef
    have hHK : algC H = 2 * S * V := by
      show algC ((2 : wcQmbtChart A' n π' c' j) * mkC (MvPolynomial.X none) *
        mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)) = _
      rw [map_mul, map_mul, map_ofNat]
    have hHu : IsUnit (algC H) := IsLocalization.Away.algebraMap_isUnit H
    have hSV : IsUnit S ∧ IsUnit V := by
      rw [hHK] at hHu
      obtain ⟨h1, h2⟩ := IsUnit.mul_iff.mp hHu
      exact ⟨(IsUnit.mul_iff.mp h1).2, h2⟩
    obtain ⟨hS, hV⟩ := hSV
    have hVe : V = algC (mkC (MvPolynomial.X (some i₀))) + algebraMap A' (Localization.Away H) ε := by
      rw [hAK, hVdef, map_add, map_add]
    obtain ⟨Vinv, hVinv⟩ : ∃ x, x = (↑hV.unit⁻¹ : Localization.Away H) := ⟨_, rfl⟩
    have hVV : V * Vinv = 1 := by rw [hVinv]; exact IsUnit.mul_val_inv hV

    obtain ⟨y, hy⟩ : ∃ y : Fin (n - 2 + 2) → Localization.Away H, y = fun a : Fin (n - 2 + 2) =>
        if h0 : a.val = 0 then V else if h1 : a.val = 1 then
          algebraMap A' (Localization.Away H) π' * Vinv
        else algC (mkC (MvPolynomial.X (some (τ ⟨a.val - 2, by have := a.isLt; omega⟩).1))) :=
      ⟨_, rfl⟩
    have hy0 : y ⟨0, by omega⟩ = V := by rw [hy]; rfl
    have hy1 : y ⟨1, by omega⟩ = algebraMap A' (Localization.Away H) π' * Vinv := by
      rw [hy]; simp
    have hyk : ∀ k : Fin (n - 2), y ⟨k.val + 2, Nat.add_lt_add_right k.isLt 2⟩ =
        algC (mkC (MvPolynomial.X (some (τ k).1))) := by
      intro k
      rw [hy]
      simp only [Nat.add_eq_zero_iff, OfNat.ofNat_ne_zero, and_false, dite_false,
        Nat.add_sub_cancel, Fin.eta]
      rw [dif_neg (by omega)]
    have hyπ : y ⟨0, by omega⟩ * y ⟨1, by omega⟩ = algebraMap A' (Localization.Away H) π' := by
      rw [hy0, hy1, mul_left_comm, hVV, mul_one]
    obtain ⟨α, hαA, hαX⟩ := c1 (n - 2) (algebraMap A' (Localization.Away H)) y hyπ
    have hαa : ∀ a, α (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) =
        algebraMap A' (Localization.Away H) a := fun a => by rw [← RingHom.comp_apply, hαA]

    obtain ⟨m₀, hm₀⟩ : ∃ x : wcQmbtSSRing A' (n - 2) π', x = mkM (MvPolynomial.X ⟨0, by omega⟩) :=
      ⟨_, rfl⟩
    have hc2 : m₀ * mkM (MvPolynomial.X ⟨1, by omega⟩) =
        algebraMap A' (wcQmbtSSRing A' (n - 2) π') π' := by
      have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton
        (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun a b : Fin (n - 2 + 2) =>
          if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π')))
      rw [← hmkM] at h
      simp only [map_sub, map_sum, map_mul] at h
      have h2 := hcol (n - 2) (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))
        (fun a => mkM (MvPolynomial.X a))
      rw [hm₀, ← h2, ← sub_eq_zero]
      exact h

    let η : Fin n → wcQmbtSSRing A' (n - 2) π' := fun p =>
      if hpj : p = j then 1 else if hpi : p = i₀ then
        m₀ - algebraMap A' (wcQmbtSSRing A' (n - 2) π') ε
      else mkM (MvPolynomial.X ⟨(τ.symm ⟨p, hpi, hpj⟩).val + 2,
        Nat.add_lt_add_right (τ.symm ⟨p, hpi, hpj⟩).isLt 2⟩)
    obtain ⟨κ, hκ⟩ : ∃ x : wcQmbtSSRing A' (n - 2) π', x = ∑ p, ∑ q,
        algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q) * η p * η q := ⟨_, rfl⟩
    have hηj : η j = 1 := dif_pos rfl
    have hηi : η i₀ = m₀ - algebraMap A' (wcQmbtSSRing A' (n - 2) π') ε := by
      simp only [η, dif_neg hij]; exact dif_pos trivial
    have hηk : ∀ k : Fin (n - 2), η (τ k).1 =
        mkM (MvPolynomial.X ⟨k.val + 2, Nat.add_lt_add_right k.isLt 2⟩) := by
      intro k
      simp only [η, dif_neg (τ k).2.2, dif_neg (τ k).2.1, Subtype.coe_eta, Equiv.symm_apply_apply]
    have hαX' : ∀ a, α (mkM (MvPolynomial.X a)) = y a := hαX
    have hαm₀ : α m₀ = V := by rw [hm₀, hαX', hy0]

    have hGC : mkC (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q) = mkC (MvPolynomial.X none) ^ 2 := by
      have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert_of_mem
        (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π')
        (Set.mem_singleton (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
          wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2))))
      rw [← hmkC, map_sub, sub_eq_zero, map_pow] at h
      exact h
    have hxs : mkC (MvPolynomial.X (some j)) * mkC (MvPolynomial.X none) =
        mkC (MvPolynomial.C π') := by
      have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert
        (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π')
        {∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
          wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2}))
      rw [← hmkC, map_sub, sub_eq_zero, map_mul] at h
      exact h
    have hhat : ∀ p, p ≠ j → wcQmbtChartHat (A' := A') j p = MvPolynomial.X (some p) :=
      fun p hp => if_neg hp

    have hαη : ∀ p, α (η p) = algC (mkC (wcQmbtChartHat (A' := A') j p)) := by
      intro p
      by_cases hpj : p = j
      · subst hpj
        rw [hηj, map_one, show wcQmbtChartHat (A' := A') p p = 1 from if_pos rfl, map_one, map_one]
      · rw [hhat p hpj]
        by_cases hpi : p = i₀
        · subst hpi
          rw [hηi, map_sub, hαm₀, hαa, hVe, add_sub_cancel_right]
        · obtain ⟨k, hk⟩ : ∃ k, (τ k).1 = p := ⟨τ.symm ⟨p, hpi, hpj⟩, by simp⟩
          subst hk
          rw [hηk, hαX', hyk]

    have h1 : S ^ 2 = α κ := by
      rw [hSdef, ← map_pow, ← hGC, hκ]
      simp only [map_sum, map_mul, hαa, hαη, hAK]

    have h2 : IsUnit (α (2 * m₀) * S) := by
      rw [map_mul, map_ofNat, hαm₀, show (2 : Localization.Away H) * V * S = 2 * S * V by ring,
        ← hHK]
      exact hHu
    have hunit : IsUnit (α m₀) := by rw [hαm₀]; exact hV
    rw [hm₀] at hunit
    refine ⟨α, hαA, c4 κ m₀ α S ?_ h1 h2, hunit⟩
    intro L _ β r hr2 hu
    obtain ⟨h2m, hru⟩ := IsUnit.mul_iff.mp hu
    rw [map_mul, map_ofNat] at h2m
    have hm0u := (IsUnit.mul_iff.mp h2m).2
    obtain ⟨rinv, hrinv⟩ : ∃ x, x = (↑hru.unit⁻¹ : L) := ⟨_, rfl⟩
    have hrr : rinv * r = 1 := by rw [hrinv]; exact IsUnit.val_inv_mul hru

    obtain ⟨w, hw⟩ : ∃ w : Fin n → L, w = fun p =>
        if p = j then β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') π') * rinv
        else β (η p) := ⟨_, rfl⟩
    have hwj : w j = β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') π') * rinv := by
      rw [hw]; exact if_pos rfl
    have hwp : ∀ p, p ≠ j → w p = β (η p) := by
      intro p hp; rw [hw]; exact if_neg hp
    have hŵ : ∀ p, (if p = j then 1 else w p) = β (η p) := by
      intro p
      by_cases hp : p = j
      · subst hp; rw [if_pos rfl, hηj, map_one]
      · rw [if_neg hp, hwp p hp]
    obtain ⟨φ, hφA, hφN, hφS⟩ := c3 (β.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) r w
      (by rw [hwj, RingHom.comp_apply, mul_assoc, hrr, mul_one])
      (by
        simp only [hŵ, RingHom.comp_apply]
        rw [hr2, hκ]
        simp only [map_sum, map_mul])
    have hφN' : φ (mkC (MvPolynomial.X none)) = r := hφN
    have hφS' : ∀ p, φ (mkC (MvPolynomial.X (some p))) = w p := hφS
    have hφa : ∀ a, φ (mkC (MvPolynomial.C a)) =
        β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) := by
      intro a
      rw [← RingHom.comp_apply β (algebraMap A' (wcQmbtSSRing A' (n - 2) π')), ← hφA]
      rfl
    have hφv : φ (mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)) = β m₀ := by
      rw [map_add, map_add, hφS', hφa, hwp i₀ hij, hηi, map_sub, sub_add_cancel]
    have hφH : IsUnit (φ H) := by
      show IsUnit (φ ((2 : wcQmbtChart A' n π' c' j) * mkC (MvPolynomial.X none) *
        mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)))
      rw [map_mul, map_mul, map_ofNat, hφN', hφv,
        show (2 : L) * r * β m₀ = 2 * β m₀ * r by ring]
      exact h2m.mul hru
    let Φ := IsLocalization.Away.lift (S := Localization.Away H) H hφH
    have hΦC : ∀ c, Φ (algC c) = φ c := fun c => IsLocalization.Away.lift_eq H hφH c
    have hΦA : ∀ a, Φ (algebraMap A' (Localization.Away H) a) =
        β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) := by
      intro a; rw [hAK, hΦC, hφa]
    have hΦV : Φ V = β m₀ := by rw [hVdef, hΦC, hφv]
    refine ⟨Φ, ?_, ?_, ?_⟩
    ·
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        show Φ (α (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)) =
          β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)
        rw [hαa, hΦA]
      · intro a
        show Φ (α (mkM (MvPolynomial.X a))) = β (mkM (MvPolynomial.X a))
        rw [hαX']
        by_cases ha0 : a.val = 0
        · have ha : a = ⟨0, by omega⟩ := Fin.ext ha0
          rw [ha, hy0, hΦV, hm₀]
        · by_cases ha1 : a.val = 1
          · have ha : a = ⟨1, by omega⟩ := Fin.ext ha1
            rw [ha, hy1]
            apply (hm0u.mul_left_inj).mp
            rw [← hΦV, ← map_mul, mul_assoc, mul_comm Vinv V, hVV, mul_one, hΦA, hΦV, ← map_mul,
              mul_comm (mkM _) m₀, hc2]
          · obtain ⟨k, hk⟩ : ∃ k : Fin (n - 2), a = ⟨k.val + 2, Nat.add_lt_add_right k.isLt 2⟩ :=
              ⟨⟨a.val - 2, by have := a.isLt; omega⟩, Fin.ext (by simp; omega)⟩
            subst hk
            rw [hyk, hΦC, hφS', hwp _ (τ k).2.2, hηk]
    ·
      rw [hSdef, hΦC, hφN']
    ·
      intro Ψ hΨ1 hΨ2
      apply IsLocalization.ringHom_ext (Submonoid.powers H)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        show Ψ (Φ (algC (mkC (MvPolynomial.C a)))) = algC (mkC (MvPolynomial.C a))
        rw [hΦC, hφa, ← RingHom.comp_apply Ψ β, hΨ1, hαa, hAK]
      · intro o
        show Ψ (Φ (algC (mkC (MvPolynomial.X o)))) = algC (mkC (MvPolynomial.X o))
        rw [hΦC]
        cases o with
        | none => rw [hφN', hΨ2]
        | some p =>
          rw [hφS']
          by_cases hp : p = j
          · subst hp
            rw [hwj]
            apply (hS.mul_left_inj).mp
            rw [← hΨ2, ← map_mul, mul_assoc, hrr, mul_one, ← RingHom.comp_apply Ψ β, hΨ1, hαa,
              hΨ2, hSdef, ← map_mul, hxs, hAK]
          · rw [hwp p hp, ← RingHom.comp_apply Ψ β, hΨ1, hαη, hhat p hp]

  have hcompl : ∀ i : Fin n, i ≠ j →
      Nonempty (Fin (n - 2) ≃ {p : Fin n // p ≠ i ∧ p ≠ j}) := by
    intro i hij
    refine ⟨Fintype.equivOfCardEq ?_⟩
    rw [Fintype.card_fin, Fintype.card_subtype]
    have e : (Finset.univ.filter fun p : Fin n => p ≠ i ∧ p ≠ j) = Finset.univ \ {i, j} := by
      ext p
      simp
    rw [e, Finset.card_univ_diff, Finset.card_pair hij, Fintype.card_fin]
  by_cases H : ∃ i, i ≠ j ∧ Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
      (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q) ∉ 𝔭.asIdeal
  ·
    obtain ⟨i, hij, hi⟩ := H
    obtain ⟨τ⟩ := hcompl i hij
    obtain ⟨ψ, hA, hE, h0, h1⟩ := wc_qmbt_cc_case_a (π' := π') (c' := c') hij τ
    refine ⟨_, ψ, hi, hA, hE, ?_⟩
    intro 𝔮 h𝔮 hm₀ hm₁
    rw [h0] at hm₀
    rw [h1] at hm₁
    rw [← h𝔮]
    exact ⟨Ideal.mem_comap.mpr hm₀, Ideal.mem_comap.mpr hm₁⟩
  ·
    push_neg at H
    let κ := 𝔭.asIdeal.ResidueField
    let φ : wcQmbtChart A' n π' c' j →+* κ := algebraMap _ κ
    let ι : A' →+* κ :=
      φ.comp ((Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)).comp MvPolynomial.C)
    let û : Fin n → κ := fun p =>
      φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (wcQmbtChartHat (A' := A') j p))
    let sb : κ := φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none))
    have hdet : ((c'.map ι) + (c'.map ι).transpose).det ≠ 0 := by
      have h1 : c'.map ι + (c'.map ι).transpose = (c' + c'.transpose).map ι := by
        ext a b
        simp [Matrix.map_apply, Matrix.transpose_apply]
      rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact (hc'.map ι).ne_zero
    have hG : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
          wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    have hquad : ∑ p, ∑ q, (c'.map ι) p q * û p * û q = sb ^ 2 := by
      have := congrArg φ hG
      simp only [map_sub, map_sum, map_mul, map_pow, map_zero] at this
      exact sub_eq_zero.mp this
    have hmv : ∀ i, (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
        φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)) := by
      intro i
      simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, map_add, Matrix.add_apply,
        Matrix.transpose_apply, Matrix.map_apply, ι, û, RingHom.comp_apply]
    have hûj : û j = 1 := by
      simp [û, wcQmbtChartHat]
    have hne : (2 : κ) ≠ 0 ∧ sb ≠ 0 := by
      by_contra hcon
      have h2s : (2 : κ) * sb ^ 2 = 0 := by
        rcases not_and_or.mp hcon with h | h
        · push_neg at h
          rw [h, zero_mul]
        · push_neg at h
          rw [h]
          ring
      have hzero_off : ∀ i, i ≠ j → (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i = 0 := by
        intro i hij
        rw [hmv i]
        exact Ideal.algebraMap_residueField_eq_zero.mpr (H i hij)
      have hsum1 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
          (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) j := by
        rw [Finset.sum_eq_single j]
        · rw [hûj, one_mul]
        · intro b _ hb
          rw [hzero_off b hb, mul_zero]
        · intro h
          exact absurd (Finset.mem_univ j) h
      have e3 : ∑ i, ∑ q, (c'.map ι) q i * û i * û q = ∑ p, ∑ q, (c'.map ι) p q * û p * û q := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x _ => ?_
        ring
      have hsum2 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i = 2 * sb ^ 2 := by
        have e1 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
            ∑ i, ∑ q, (c'.map ι) i q * û i * û q + ∑ i, ∑ q, (c'.map ι) q i * û i * û q := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.transpose_apply,
            Finset.mul_sum]
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun q _ => ?_
          ring
        rw [e1, e3, hquad]
        ring
      have hNu : Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û = 0 := by
        funext i
        by_cases hij : i = j
        · rw [hij, ← hsum1, hsum2, h2s]
          rfl
        · exact hzero_off i hij
      have hû0 : û ≠ 0 := by
        intro h
        have := congrFun h j
        rw [hûj] at this
        exact one_ne_zero this
      exact hdet (Matrix.exists_mulVec_eq_zero_iff.mp ⟨û, hû0, hNu⟩)
    have h2p : (2 : wcQmbtChart A' n π' c' j) ∉ 𝔭.asIdeal := by
      intro h
      have := Ideal.algebraMap_residueField_eq_zero.mpr h
      rw [map_ofNat] at this
      exact hne.1 this
    have hsp : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∉
        𝔭.asIdeal := by
      intro h
      exact hne.2 (Ideal.algebraMap_residueField_eq_zero.mpr h)
    obtain ⟨i₀, hi₀⟩ : ∃ i₀ : Fin n, i₀ ≠ j := by
      by_cases hj : j.val = 0
      · refine ⟨⟨1, by omega⟩, fun h => ?_⟩
        rw [← h] at hj
        exact Nat.one_ne_zero hj
      · exact ⟨⟨0, by omega⟩, fun h => hj (by rw [← h])⟩
    obtain ⟨ε, hv⟩ : ∃ ε : A', Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
        (MvPolynomial.X (some i₀) + MvPolynomial.C ε) ∉ 𝔭.asIdeal := by
      by_cases hu : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (MvPolynomial.X (some i₀)) ∈ 𝔭.asIdeal
      · refine ⟨1, fun hmem => ?_⟩
        simp only [map_add, map_one] at hmem
        have h1 := (Ideal.add_mem_iff_right _ hu).mp hmem
        exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      · refine ⟨0, ?_⟩
        simpa using hu
    have hh : (2 : wcQmbtChart A' n π' c' j) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (MvPolynomial.X (some i₀) + MvPolynomial.C ε) ∉ 𝔭.asIdeal := by
      intro hmem
      rcases 𝔭.isPrime.mem_or_mem hmem with h1 | h1
      · rcases 𝔭.isPrime.mem_or_mem h1 with h2 | h2
        · exact h2p h2
        · exact hsp h2
      · exact hv h1
    obtain ⟨τ⟩ := hcompl i₀ hi₀
    obtain ⟨ψ, hA, hE, hU⟩ := caseB hi₀ τ ε
    refine ⟨_, ψ, hh, hA, hE, ?_⟩
    intro 𝔮 _ hm₀ _
    exact absurd (Ideal.eq_top_of_isUnit_mem _ hm₀ hU) 𝔮.isPrime.ne_top

theorem wc_qmbt_hl_chart_none_unit {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det)
    (𝔭 : PrimeSpectrum (wcQmbtChartNone A' n c')) :
    ∃ (h : wcQmbtChartNone A' n c') (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
      h ∉ 𝔭.asIdeal ∧
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away h) ∧
      ψ.Etale ∧
      IsUnit (ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2))))) :=
by
  classical
  have hP : 𝔭.asIdeal.IsPrime := 𝔭.isPrime
  have hCmk : ∀ a : A', Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C a) =
      algebraMap A' (wcQmbtChartNone A' n c') a := by
    intro a
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  obtain ⟨i, hi⟩ : ∃ i : Fin n, wcQmbtCnD c' i ∉ 𝔭.asIdeal := by
    by_contra hcon
    push_neg at hcon
    set f := algebraMap A' (wcQmbtChartNone A' n c') with hf
    set y : Fin n → wcQmbtChartNone A' n c' :=
      fun p => Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p) with hy
    set N' := (c' + c'.transpose).map f with hN'
    have hd : ∀ j, wcQmbtCnD c' j = N'.mulVec y j := by
      intro j
      simp only [wcQmbtCnD, map_sum, map_mul, map_add, hCmk, Matrix.mulVec, dotProduct, hN',
        Matrix.map_apply, Matrix.add_apply, Matrix.transpose_apply, hy, hf]
    have hu : IsUnit N'.det := by
      rw [hN', ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact hc'.map f
    have key : N'.det • y = N'.adjugate.mulVec (N'.mulVec y) := by
      rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul]
      ext p
      simp [Matrix.mulVec, dotProduct, Matrix.one_apply]
    have hyp : ∀ p, y p ∈ 𝔭.asIdeal := by
      intro p
      have h1 : N'.det * y p ∈ 𝔭.asIdeal := by
        have := congrFun key p
        rw [Pi.smul_apply, smul_eq_mul] at this
        rw [this]
        have hmem : ∀ j, N'.mulVec y j ∈ 𝔭.asIdeal := fun j => (hd j) ▸ hcon j
        simp only [Matrix.mulVec, dotProduct] at hmem ⊢
        exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hmem j))
      obtain ⟨u, hu'⟩ := hu
      have h2 : y p = ↑u⁻¹ * (N'.det * y p) := by
        rw [← hu', ← mul_assoc, Units.inv_mul, one_mul]
      rw [h2]
      exact Ideal.mul_mem_left _ _ h1
    have hF : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [map_sub, map_one, sub_eq_zero] at hF
    have hQ : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q) ∈ 𝔭.asIdeal := by
      rw [map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hyp q)
    rw [hF] at hQ
    exact hP.ne_top ((Ideal.eq_top_iff_one _).mpr hQ)
  have hN : n = n - 2 + 2 := by omega
  let e : Fin n ≃ Fin (n - 2 + 2) :=
    (finCongr hN).trans (Equiv.swap (Fin.cast hN i) ⟨1, by omega⟩)
  have he1 : (e i).val = 1 := by
    simp only [e, Equiv.trans_apply, finCongr_apply, Equiv.swap_apply_left]
  let k0 : Fin n := e.symm ⟨0, by omega⟩
  have he0 : (e k0).val = 0 := by
    simp only [k0, Equiv.apply_symm_apply]
  have hik : i ≠ k0 := by
    intro h
    rw [h] at he1
    omega
  let eps : A' := if Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) ∈
    𝔭.asIdeal then 1 else 0
  have hv : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) +
      algebraMap A' (wcQmbtChartNone A' n c') eps ∉ 𝔭.asIdeal := by
    by_cases hk : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) ∈ 𝔭.asIdeal
    · have heps : eps = 1 := if_pos hk
      rw [heps, map_one]
      intro hv
      apply hP.ne_top
      rw [Ideal.eq_top_iff_one]
      have := 𝔭.asIdeal.sub_mem hv hk
      simpa using this
    · have heps : eps = 0 := if_neg hk
      rw [heps, map_zero, add_zero]
      exact hk
  have hh : wcQmbtCnD c' i * (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) +
      algebraMap A' (wcQmbtChartNone A' n c') eps) ∉ 𝔭.asIdeal := by
    intro hm
    rcases hP.mul_mem_iff_mem_or_mem.mp hm with h1 | h1
    · exact hi h1
    · exact hv h1
  obtain ⟨Φ, hΦb, hΦc⟩ := wc_qmbt_cn_chart_iso π' c' i k0 hik eps e he0 he1
  refine ⟨_, Φ.comp (algebraMap _ _), hh, hΦc, ?_, ?_⟩
  · have h1 : (algebraMap (wcQmbtSSRing A' (n - 2) π') (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
          wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') (wcQmbtCnPoly π' c' i k0 eps e)
            (wcQmbtCnMk A' n π' (MvPolynomial.X (e k0))))).Etale :=
      RingHom.etale_algebraMap.mpr (wc_qmbt_cn_etale_pres _ _ _)
    have h2 : Φ.Etale := RingHom.Etale.of_bijective hΦb
    exact RingHom.Etale.stableUnderComposition _ _ h1 h2
  · have hgen : ∀ (M : Type u) [CommRing M] (g : Polynomial M) (b : M),
        IsUnit (algebraMap M (MvPolynomial (Fin 2) M ⧸ wcQmbtCnPres M g b) b) := by
      intro M _ g b
      have hr : Ideal.Quotient.mk (wcQmbtCnPres M g b) (MvPolynomial.X 1 * MvPolynomial.C b *
          Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) M) (Polynomial.derivative g)
            - 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
      rw [map_sub, map_mul, map_mul, map_one, sub_eq_zero] at hr
      have hSmk : Ideal.Quotient.mk (wcQmbtCnPres M g b) (MvPolynomial.C b) =
          algebraMap M (MvPolynomial (Fin 2) M ⧸ wcQmbtCnPres M g b) b := by
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      rw [hSmk] at hr
      refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk (wcQmbtCnPres M g b) (MvPolynomial.X 1) *
        Ideal.Quotient.mk (wcQmbtCnPres M g b)
          (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) M)
            (Polynomial.derivative g)), ?_⟩
      rw [← hr]
      ring
    have hk : e k0 = ⟨0, by omega⟩ := Fin.ext he0
    rw [RingHom.comp_apply, ← hk]
    exact (hgen _ _ _).map Φ

theorem wc_qmbt_hl_chart_generize {A' : Type u} [CommRing A'] {n : ℕ} (π' : A')
    (c' : Matrix (Fin n) (Fin n) A') (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' c' j))
    (hs : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∈ 𝔭.asIdeal)
    (hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∈
      𝔭.asIdeal) :
    ∃ 𝔭' : PrimeSpectrum (wcQmbtChart A' n π' c' j), 𝔭' ≤ 𝔭 ∧
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∈ 𝔭'.asIdeal ∧
      algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ 𝔭'.asIdeal ∧
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∉ 𝔭'.asIdeal :=
by
  have hg₁ : (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π' :
      MvPolynomial (Option (Fin n)) A') ∈ wcQmbtChartIdeal A' n π' c' j :=
    Ideal.subset_span (Set.mem_insert _ _)
  have hg₂ : (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q -
      MvPolynomial.X none ^ 2 : MvPolynomial (Option (Fin n)) A') ∈
      wcQmbtChartIdeal A' n π' c' j :=
    Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  obtain ⟨D, _, _, ϕ, hϕker⟩ : ∃ (D : Type u) (_ : CommRing D) (_ : IsDomain D)
      (ϕ : wcQmbtChart A' n π' c' j →+* D), ∀ c, ϕ c = 0 ↔ c ∈ 𝔭.asIdeal :=
    ⟨wcQmbtChart A' n π' c' j ⧸ 𝔭.asIdeal, Ideal.Quotient.commRing _,
      Ideal.Quotient.isDomain _, Ideal.Quotient.mk 𝔭.asIdeal,
      fun c => Ideal.Quotient.eq_zero_iff_mem⟩
  set mk := Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) with hmk
  have hϕs : ϕ (mk (MvPolynomial.X none)) = 0 := (hϕker _).mpr hs
  have hϕx : ϕ (mk (MvPolynomial.X (some j))) = 0 := (hϕker _).mpr hx
  have hR1 : mk (MvPolynomial.C π') =
      mk (MvPolynomial.X (some j)) * mk (MvPolynomial.X none) := by
    have h : mk (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π') = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hg₁
    rw [map_sub, map_mul, sub_eq_zero] at h
    exact h.symm
  have hπ𝔭 : mk (MvPolynomial.C π') ∈ 𝔭.asIdeal := by
    rw [hR1]; exact Ideal.mul_mem_left _ _ hs
  have hϕπ : ϕ (mk (MvPolynomial.C π')) = 0 := (hϕker _).mpr hπ𝔭
  have halg : algebraMap A' (wcQmbtChart A' n π' c' j) π' = mk (MvPolynomial.C π') := by
    rw [hmk, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  let κc : A' →+* Polynomial D :=
    Polynomial.C.comp (ϕ.comp (mk.comp MvPolynomial.C))
  let v : Option (Fin n) → Polynomial D := fun o =>
    Option.elim o 0 (fun p => if p = j then Polynomial.X
      else Polynomial.C (ϕ (mk (MvPolynomial.X (some p)))))
  let e := MvPolynomial.eval₂Hom κc v
  let χ : MvPolynomial (Option (Fin n)) A' →+* Polynomial D :=
    Polynomial.C.comp (ϕ.comp mk)
  have eC : ∀ a, e (MvPolynomial.C a) = χ (MvPolynomial.C a) := fun a => by
    simp only [e, χ, κc, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
  have enone : e (MvPolynomial.X none) = 0 := by
    simp only [e, v, MvPolynomial.eval₂Hom_X']
    rfl
  have ej : e (MvPolynomial.X (some j)) = Polynomial.X := by
    simp only [e, v, MvPolynomial.eval₂Hom_X', Option.elim_some, if_pos rfl, if_true]
  have eHat : ∀ p, e (wcQmbtChartHat j p) = χ (wcQmbtChartHat j p) := by
    intro p
    by_cases h : p = j
    · simp only [wcQmbtChartHat, if_pos h, map_one]
    · simp only [wcQmbtChartHat, if_neg h, e, v, χ, MvPolynomial.eval₂Hom_X', Option.elim_some,
        RingHom.comp_apply]
  have hχs : χ (MvPolynomial.X none ^ 2) = 0 := by
    show Polynomial.C (ϕ (mk (MvPolynomial.X none ^ 2))) = 0
    rw [map_pow, map_pow, hϕs]
    simp
  have hle : wcQmbtChartIdeal A' n π' c' j ≤ RingHom.ker e := by
    rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    refine ⟨?_, ?_⟩
    · show e _ = 0
      rw [map_sub, map_mul, ej, enone, eC, mul_zero, zero_sub, neg_eq_zero]
      show Polynomial.C (ϕ (mk (MvPolynomial.C π'))) = 0
      rw [hϕπ, map_zero]
    · show e _ = 0
      have h1 : e (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q) =
          χ (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q) := by
        simp only [map_sum, map_mul, eC, eHat]
      have h2 : χ (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat j p * wcQmbtChartHat j q -
          MvPolynomial.X none ^ 2) = 0 := by
        show Polynomial.C (ϕ (mk _)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hg₂, map_zero, map_zero]
      rw [map_sub, hχs, sub_zero] at h2
      rw [map_sub, h1, h2, map_pow, enone]
      simp
  have hI : ∀ a ∈ wcQmbtChartIdeal A' n π' c' j, e a = 0 := fun a ha => hle ha
  let σ := Ideal.Quotient.lift (wcQmbtChartIdeal A' n π' c' j) e hI
  have hσ : ∀ f, σ (mk f) = e f := fun f => Ideal.Quotient.lift_mk _ _ _
  have hev : ∀ f, Polynomial.eval 0 (e f) = ϕ (mk f) := by
    intro f
    have key : (Polynomial.evalRingHom (0 : D)).comp e =
        ϕ.comp mk := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, e, κc, MvPolynomial.eval₂Hom_C, Polynomial.coe_evalRingHom,
          Polynomial.eval_C]
      · intro o
        cases o with
        | none =>
          simp only [RingHom.comp_apply, e, v, MvPolynomial.eval₂Hom_X', Option.elim_none,
            Polynomial.coe_evalRingHom, Polynomial.eval_zero, hϕs]
        | some p =>
          by_cases h : p = j
          · subst h
            simp only [RingHom.comp_apply, e, v, MvPolynomial.eval₂Hom_X', Option.elim_some,
              if_pos rfl, if_true, Polynomial.coe_evalRingHom, Polynomial.eval_X, hϕx]
          · simp only [RingHom.comp_apply, e, v, MvPolynomial.eval₂Hom_X', Option.elim_some,
              if_neg h, Polynomial.coe_evalRingHom, Polynomial.eval_C]
    have := RingHom.congr_fun key f
    simpa only [RingHom.comp_apply, Polynomial.coe_evalRingHom] using this
  refine ⟨⟨RingHom.ker σ, RingHom.ker_isPrime σ⟩, ?_, ?_, ?_, ?_⟩
  · rw [← PrimeSpectrum.asIdeal_le_asIdeal]
    intro c hc
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective c
    have h1 : σ (mk f) = 0 := RingHom.mem_ker.mp hc
    rw [hσ] at h1
    have h2 := hev f
    rw [h1, Polynomial.eval_zero] at h2
    exact (hϕker _).mp h2.symm
  · exact RingHom.mem_ker.mpr ((hσ _).trans enone)
  · refine RingHom.mem_ker.mpr ?_
    rw [halg, hσ, eC]
    show Polynomial.C (ϕ (mk (MvPolynomial.C π'))) = 0
    rw [hϕπ, map_zero]
  · intro h
    have h1 : σ (mk (MvPolynomial.X (some j))) = 0 := RingHom.mem_ker.mp h
    rw [hσ, ej] at h1
    exact Polynomial.X_ne_zero h1

theorem wc_qmbt_hl_model_adapted {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π') :
    ∃ (Xm₀ : Scheme.{u}) (f₀ : Xm₀ ⟶ Spec (.of A'))
      (bl₀ : Xm₀ ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))),
    wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range (fun i : Option (Fin n) =>
      Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl₀ ∧
    bl₀ ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) = f₀ ∧
    ∀ x : Xm₀, ∃ (U : Xm₀.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
      (y : U.toScheme),
      U.ι y = x ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f₀ ∧
      (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) →
       Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) →
       (∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
           PrimeSpectrum.asIdeal (a₀ ((bl₀ ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
             (Spec.map (CommRingCat.ofHom ιA))) x))) ∧
       ∃ x' : Xm₀, x' ⤳ x ∧ f₀ x' = IsLocalRing.closedPoint A' ∧
         ∃ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∉
           PrimeSpectrum.asIdeal (a₀ ((bl₀ ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
             (Spec.map (CommRingCat.ofHom ιA))) x'))) :=
by
  classical
  have hn2 : 2 ≤ n := by omega

  obtain ⟨θ, hθX, hθA, sq₁⟩ := wc_qmbt_bm_quad_pullback ιA n π c π' hπ'2
  obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      gP ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
    ⟨sq₁.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
  have sqL : IsPullback (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) gP a₀ (Spec.map (CommRingCat.ofHom θ)) := by
    refine IsPullback.of_bot ?_ hgP1.symm sq₁
    rw [hgP2]
    exact IsPullback.of_hasPullback _ _
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hgPw : WeaklyEtale gP := MorphismProperty.of_isPullback (P := @WeaklyEtale) sqL ha₀

  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) :=
    inferInstance
  obtain ⟨X₁, r₁, hb₁, hX₁⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k))))
  haveI := hX₁
  haveI hfst : WeaklyEtale (Limits.pullback.fst r₁ gP) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback r₁ gP).flip hgPw
  haveI hfstflat : Flat (Limits.pullback.fst r₁ gP) := hfst.flat

  haveI hgPflat : Flat gP := hgPw.flat
  haveI hPaff : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    dsimp only [wcQuadModelStr]
    infer_instance
  have hbl := wc_qmbt_bm_flat_base_change
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ gP hb₁

  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have h1 : c.map ιA + (c.map ιA).transpose = (c + c.transpose).map ιA := by
      ext i j
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hc.map ιA
  choose φs hφs using fun j => wc_qmbt_bm_chart_algebra hπ' (c.map ιA) j
  obtain ⟨φ0, hφ0⟩ := wc_qmbt_bm_chart_algebra_none hπ' (c.map ιA)
  let Φ : ∀ k, CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k := fun k =>
    Option.rec (motive := fun k => CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k) (CommRingCat.ofHom φ0)
      (fun j => CommRingCat.ofHom (φs j)) k
  obtain ⟨e, he_open, he_comp, he_cover⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ hb₁ (wcQmbtCharts A' n π' (c.map ιA)) Φ
    (fun k => by cases k with
      | none => exact hφ0.2.2.1
      | some j => exact (hφs j).2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.1
      | some j => exact (hφs j).2.2.2.1)
    (fun k => by cases k with
      | none => exact hφ0.2.2.2.2
      | some j => exact (hφs j).2.2.2.2)

  have key : ∀ (C : Type u) [CommRing C] [Algebra A' C] (e₀ : Spec (CommRingCat.of C) ⟶ X₁)
      [IsOpenImmersion e₀] (φ : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* C),
      e₀ ≫ r₁ = Spec.map (CommRingCat.ofHom φ) →
      φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) = algebraMap A' C →
      ∀ (y : Spec (CommRingCat.of C)) (h : C)
        (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
      h ∉ PrimeSpectrum.asIdeal y →
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away h) →
      ψ.Etale →
      ∃ (W : X₁.Opens) (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
        e₀ y ∈ W ∧ WeaklyEtale gW ∧
        gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
          W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) ∧
        ∀ w : W, (w : X₁) = e₀ y → ∃ q : PrimeSpectrum (Localization.Away h),
          q.asIdeal.comap (algebraMap C (Localization.Away h)) = PrimeSpectrum.asIdeal y ∧
          gW w = Spec.map (CommRingCat.ofHom ψ) q := by
    intro C _ _ e₀ _ φ he hφ y h ψ hy hψ hψe
    let lh : Spec (CommRingCat.of (Localization.Away h)) ⟶ Spec (CommRingCat.of C) :=
      Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away h)))
    obtain ⟨q0, hq⟩ : y ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away h))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away h) h]
      exact (PrimeSpectrum.mem_basicOpen h y).mpr hy
    let q : Spec (CommRingCat.of (Localization.Away h)) := q0
    have hlq : lh q = y := hq
    have hWι : (lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀) = (lh ≫ e₀).opensRange.ι := by
      rw [Iso.inv_comp_eq, Scheme.Hom.isoOpensRange_hom_ι]
    haveI : Etale (Spec.map (CommRingCat.ofHom ψ)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hψe
    refine ⟨(lh ≫ e₀).opensRange, (lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom ψ),
      ?_, inferInstance, ?_, ?_⟩
    · exact Scheme.Hom.mem_opensRange.mpr
        ⟨q, (Scheme.Hom.comp_apply lh e₀ q).trans (congrArg e₀ hlq)⟩
    · have halg : algebraMap A' (Localization.Away h) =
          (algebraMap C (Localization.Away h)).comp
            (φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
        rw [hφ]
        exact IsScalarTower.algebraMap_eq _ _ _
      calc ((lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
            Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π')))
          = (lh ≫ e₀).isoOpensRange.inv ≫ Spec.map (CommRingCat.ofHom
              (ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')))) := by
            rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = (lh ≫ e₀).isoOpensRange.inv ≫ lh ≫ Spec.map (CommRingCat.ofHom φ) ≫
              Spec.map (CommRingCat.ofHom
                (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
            rw [hψ, halg]
            simp only [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, lh]
        _ = ((lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀)) ≫ r₁ ≫
              Spec.map (CommRingCat.ofHom
                (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
            rw [← he]
            simp only [Category.assoc]
        _ = _ := by rw [hWι]
    · intro w hw
      refine ⟨q, congrArg PrimeSpectrum.asIdeal hq, ?_⟩
      have h1 : (lh ≫ e₀) ((lh ≫ e₀).isoOpensRange.inv w) = (lh ≫ e₀) q := by
        rw [show (lh ≫ e₀) ((lh ≫ e₀).isoOpensRange.inv w) =
            ((lh ≫ e₀).isoOpensRange.inv ≫ (lh ≫ e₀)) w from (Scheme.Hom.comp_apply _ _ _).symm,
          hWι, Scheme.Opens.ι_apply, hw, Scheme.Hom.comp_apply, hlq]
      have h2 := (lh ≫ e₀).isOpenEmbedding.injective h1
      exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ)) h2)

  have local_chart : ∀ x₁ : X₁, ∃ (W : X₁.Opens)
      (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
      x₁ ∈ W ∧ WeaklyEtale gW ∧
      gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) ∧
      ∀ w : W, (w : X₁) = x₁ →
        Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2))) ∈ PrimeSpectrum.asIdeal (gW w) →
        Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2))) ∈ PrimeSpectrum.asIdeal (gW w) →
        (∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
          PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ) (r₁ x₁))) ∧
        ∃ x₁' : X₁, x₁' ⤳ x₁ ∧
          Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
            (r₁ x₁') = IsLocalRing.closedPoint A' ∧
          ∃ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∉
            PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom θ) (r₁ x₁')) := by
    intro x₁
    obtain ⟨k, y, hy⟩ := he_cover x₁
    subst hy
    cases k with
    | none =>
      obtain ⟨h, ψ, hh, hψ, hψe, hU⟩ := wc_qmbt_hl_chart_none_unit hπ' hn2 hc' y
      obtain ⟨W, gW, h1, h2, h3, hq⟩ :=
        @key (wcQmbtChartNone A' n (c.map ιA)) _ _ (e none) (he_open none) φ0 (he_comp none)
          hφ0.2.1 y h ψ hh hψ hψe
      refine ⟨W, gW, h1, h2, h3, ?_⟩
      intro w hw hm₀ _
      obtain ⟨q, -, hq2⟩ := hq w hw
      rw [hq2] at hm₀
      replace hm₀ : ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) ∈ q.asIdeal := hm₀
      exact absurd (Ideal.eq_top_of_isUnit_mem _ hm₀ hU) q.isPrime.ne_top
    | some j =>
      obtain ⟨h, ψ, hh, hψ, hψe, hoff⟩ := wc_qmbt_hl_chart_coords_off hπ' hn2 hc' j y
      obtain ⟨W, gW, h1, h2, h3, hq⟩ :=
        @key (wcQmbtChart A' n π' (c.map ιA) j) _ _ (e (some j)) (he_open (some j)) (φs j)
          (he_comp (some j)) (hφs j).2.1 y h ψ hh hψ hψe
      refine ⟨W, gW, h1, h2, h3, ?_⟩
      intro w hw hm₀ hm₁
      obtain ⟨q, hq1, hq2⟩ := hq w hw
      rw [hq2] at hm₀ hm₁
      obtain ⟨hs, hx⟩ := hoff q hq1 hm₀ hm₁
      have hr : r₁ (e (some j) y) = Spec.map (CommRingCat.ofHom (φs j)) y := by
        rw [← Scheme.Hom.comp_apply, he_comp (some j)]
        rfl
      refine ⟨fun p => ?_, ?_⟩
      · rw [hr]
        show φs j (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))) ∈
          PrimeSpectrum.asIdeal y
        rw [hθX p, (hφs j).1 p, map_mul, mul_comm]
        exact Ideal.mul_mem_left _ _ hx
      · obtain ⟨𝔭', hle, -, hπ𝔭, hxn⟩ := wc_qmbt_hl_chart_generize π' (c.map ιA) j y hs hx
        let y' : ↥(Spec (wcQmbtCharts A' n π' (c.map ιA) (some j))) := 𝔭'
        have hr' : r₁ (e (some j) y') = Spec.map (CommRingCat.ofHom (φs j)) y' := by
          rw [← Scheme.Hom.comp_apply, he_comp (some j)]
          rfl
        have hsp : y' ⤳ y := (PrimeSpectrum.le_iff_specializes _ _).mp hle
        refine ⟨e (some j) y', hsp.map (e (some j)).continuous, ?_, j, ?_⟩
        · rw [hr']
          apply PrimeSpectrum.ext
          show Ideal.comap (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
              (Ideal.comap (φs j) 𝔭'.asIdeal) = IsLocalRing.maximalIdeal A'
          rw [Ideal.comap_comap, (hφs j).2.1]
          symm
          apply (IsLocalRing.maximalIdeal.isMaximal A').eq_of_le
            (Ideal.IsPrime.ne_top inferInstance)
          rw [hπ', Ideal.span_le, Set.singleton_subset_iff]
          exact Ideal.mem_comap.mpr hπ𝔭
        · rw [hr']
          show φs j (θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))) ∉
            𝔭'.asIdeal
          rw [hθX j, (hφs j).1 j, show wcQmbtChartHat (A' := A') j j = 1 from if_pos rfl,
            mul_one]
          exact hxn

  have transfer : ∀ (W : X₁.Opens)
      (gW : (W : Scheme.{u}) ⟶ Spec (CommRingCat.of (wcQmbtSSRing A' (n - 2) π'))),
      WeaklyEtale gW →
      gW ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        W.ι ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) →
      WeaklyEtale ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) ∧
      ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) ≫
          Spec.map (CommRingCat.ofHom (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) =
        (Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι ≫ (Limits.pullback.snd r₁ gP ≫
          Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) := by
    intro W gW hgW hcomm
    refine ⟨inferInstance, ?_⟩
    rw [Category.assoc, hcomm, morphismRestrict_ι_assoc, Limits.pullback.condition_assoc, hgP2]
  have hpt : ∀ (W : X₁.Opens) (xU : ↥(Limits.pullback.fst r₁ gP ⁻¹ᵁ W).toScheme),
      W.ι ((Limits.pullback.fst r₁ gP ∣_ W) xU) =
        Limits.pullback.fst r₁ gP ((Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι xU) := by
    intro W xU
    have e1 := congrArg (fun φ => φ xU) (morphismRestrict_ι (Limits.pullback.fst r₁ gP) W)
    exact (Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))

  have I1 : ∀ x : ↥(Limits.pullback r₁ gP : Scheme.{u}),
      a₀ ((Limits.pullback.snd r₁ gP ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) =
      Spec.map (CommRingCat.ofHom θ) (r₁ (Limits.pullback.fst r₁ gP x)) := by
    intro x
    have h : Limits.pullback.snd r₁ gP ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ =
        Limits.pullback.fst r₁ gP ≫ r₁ ≫ Spec.map (CommRingCat.ofHom θ) := by
      rw [← hgP1, ← Limits.pullback.condition_assoc]
    have := congrArg (fun φ => φ x) h
    simpa only [Scheme.Hom.comp_apply] using this
  have I2 : ∀ x : ↥(Limits.pullback r₁ gP : Scheme.{u}),
      (Limits.pullback.snd r₁ gP ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x =
      Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
        (r₁ (Limits.pullback.fst r₁ gP x)) := by
    intro x
    have h : Limits.pullback.snd r₁ gP ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) =
        Limits.pullback.fst r₁ gP ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
      rw [← hgP2, ← Limits.pullback.condition_assoc]
    have := congrArg (fun φ => φ x) h
    simpa only [Scheme.Hom.comp_apply] using this
  refine ⟨Limits.pullback r₁ gP, Limits.pullback.snd r₁ gP ≫
      Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)),
    Limits.pullback.snd r₁ gP, ?_, rfl, ?_⟩
  ·
    convert hbl using 4
    funext i
    cases i with
    | none =>
      show (Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π') =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) π'))
      rw [← hgP2, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
      congr 1
      have := congrArg (fun φ => φ.hom π') (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    | some j =>
      show ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j))) =
        gP.appTop.hom ((Scheme.ΓSpecIso
          (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X j)))
      rw [← hgP1, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, ← hθX j]
      congr 1
      have := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X j))) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
  ·
    intro x
    obtain ⟨W, gW, hxW, hgW, hcomm, hDL⟩ := local_chart (Limits.pullback.fst r₁ gP x)
    obtain ⟨t1, t2⟩ := transfer W gW hgW hcomm
    have hxW' : x ∈ Limits.pullback.fst r₁ gP ⁻¹ᵁ W := hxW
    let xU : ↥(Limits.pullback.fst r₁ gP ⁻¹ᵁ W).toScheme := ⟨x, hxW'⟩
    have hxU : (Limits.pullback.fst r₁ gP ⁻¹ᵁ W).ι xU = x := Scheme.Opens.ι_apply _ _
    refine ⟨Limits.pullback.fst r₁ gP ⁻¹ᵁ W, n - 2, (Limits.pullback.fst r₁ gP ∣_ W) ≫ gW,
      xU, hxU, t1, t2, ?_⟩
    intro hm₀ hm₁
    have hgy : ((Limits.pullback.fst r₁ gP ∣_ W) ≫ gW) xU =
        gW ((Limits.pullback.fst r₁ gP ∣_ W) xU) := Scheme.Hom.comp_apply _ _ _
    rw [hgy] at hm₀ hm₁
    obtain ⟨ha, x₁', hsp, hcl, p, hp⟩ := hDL ((Limits.pullback.fst r₁ gP ∣_ W) xU)
      ((Scheme.Opens.ι_apply W _).symm.trans ((hpt W xU).trans
        (congrArg (Limits.pullback.fst r₁ gP) hxU))) hm₀ hm₁
    refine ⟨fun q => ?_, ?_⟩
    · rw [I1 x]
      exact ha q
    · obtain ⟨x', hx'sp, hx'⟩ :=
        AlgebraicGeometry.Flat.generalizingMap (Limits.pullback.fst r₁ gP) hsp
      refine ⟨x', hx'sp, ?_, p, ?_⟩
      · rw [I2 x', hx']
        exact hcl
      · rw [I1 x', hx']
        exact hp

theorem wc_qmbt_hl_b0_origin_fibre {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] {π : A} {n : ℕ} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀) :
    (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B₀))) ∧
    ∀ b : Spec (.of B₀), (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal (a₀ b)) → b = IsLocalRing.closedPoint B₀ :=
by
  classical

  have hcp0 : a₀ (IsLocalRing.closedPoint B₀) = x₀ := by
    have hsh' := hsh
    unfold wcHalShData at hsh'
    obtain ⟨-, -, -, -, -, eκ, -, heκ⟩ := hsh'
    obtain ⟨s0⟩ : Nonempty (PrimeSpectrum (AlgebraicClosure
        ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀))) := inferInstance
    let s : ↥(Spec (CommRingCat.of (AlgebraicClosure
        ((Spec (CommRingCat.of (wcQuadModelRing A n π c))).residueField x₀)))) := s0
    have hb : a₀ (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))
        (Spec.map (CommRingCat.ofHom eκ) s)) = x₀ := by
      have h1 := congrArg (fun f => f s) heκ
      simp only [Scheme.Hom.comp_apply, wcEtGeomPt] at h1
      exact h1.trans (Scheme.fromSpecResidueField_apply x₀ _)
    have hc : Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))
        (Spec.map (CommRingCat.ofHom eκ) s) = IsLocalRing.closedPoint B₀ := by
      obtain ⟨t, ht⟩ : ∃ t : PrimeSpectrum (IsLocalRing.ResidueField B₀),
          t = Spec.map (CommRingCat.ofHom eκ) s := ⟨_, rfl⟩
      rw [← ht]
      apply PrimeSpectrum.ext
      show Ideal.comap (IsLocalRing.residue B₀) (PrimeSpectrum.asIdeal t) =
        IsLocalRing.maximalIdeal B₀
      rw [Ideal.eq_bot_of_prime (PrimeSpectrum.asIdeal t)]
      exact IsLocalRing.ker_residue
    rw [← hc]
    exact hb
  refine ⟨fun p => by rw [hcp0]; exact hx₀ p, ?_⟩

  intro b hb
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  let ψ : wcQuadModelRing A n π c →+* B₀ := (Spec.preimage a₀).hom
  let P : Ideal (wcQuadModelRing A n π c) := Ideal.comap ψ (IsLocalRing.maximalIdeal B₀)
  haveI hPp : P.IsPrime := Ideal.comap_isPrime _ _
  haveI : IsNoetherianRing (wcQuadModelRing A n π c) := by
    unfold wcQuadModelRing
    infer_instance
  have hg : ∀ y : P.primeCompl, IsUnit (ψ y) := by
    intro y
    have hy : y.1 ∉ P := y.2
    by_contra h
    exact hy (Ideal.mem_comap.mpr ((IsLocalRing.mem_maximalIdeal _).mpr h))
  let θ : Localization.AtPrime P →+* B₀ :=
    IsLocalization.lift (M := P.primeCompl) (S := Localization.AtPrime P) hg
  have hθ : θ.comp (algebraMap _ (Localization.AtPrime P)) = ψ := IsLocalization.lift_comp hg
  have hloc : IsLocalHom θ := by
    refine ⟨fun x hx => ?_⟩
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl x
    have e : ψ a = ψ s * θ (IsLocalization.mk' (Localization.AtPrime P) a s) :=
      (IsLocalization.lift_mk'_spec (M := P.primeCompl) (S := Localization.AtPrime P)
        (g := ψ) hg a _ s).mp rfl
    have hua : IsUnit (ψ a) := e ▸ (hg s).mul hx
    have haP : a ∈ P.primeCompl := by
      intro ha
      exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mem_comap.mp ha) hua
    exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime P) P a s).mpr haP
  have e : Spec.map (CommRingCat.ofHom ψ) = a₀ := by
    simp only [ψ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hRB := wc_lpkt_specMap_weaklyEtale_ring _ B₀ ψ (e ▸ ha₀)
  have hRC : Algebra.WeaklyEtale _ (Localization.AtPrime P) :=
    wc_localization_weaklyEtale _ (Localization.AtPrime P) P.primeCompl
  have hCB : @Algebra.WeaklyEtale (Localization.AtPrime P) B₀ _ _ θ.toAlgebra := by
    letI : Algebra (wcQuadModelRing A n π c) B₀ := ψ.toAlgebra
    letI : Algebra (Localization.AtPrime P) B₀ := θ.toAlgebra
    have hT : @IsScalarTower (wcQuadModelRing A n π c)
        (Localization.AtPrime P) B₀ Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
      IsScalarTower.of_algebraMap_eq' hθ.symm
    exact @wc_weaklyEtale_cancel _ (Localization.AtPrime P) B₀ _ _ _ _ _ _ hT hRC hRB
  obtain ⟨-, hun⟩ := wc_tla_shens_noeth_unram (Localization.AtPrime P) B₀ θ hloc hCB
  have hkey : Ideal.map ψ P = IsLocalRing.maximalIdeal B₀ := by
    rw [← hun, ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, hθ]
  have hmax := wc_qmbt_bm_origin_maximal hπ n c
  have hab : a₀ b = Spec.map (CommRingCat.ofHom ψ) b := by rw [e]
  let Pb : Ideal (wcQuadModelRing A n π c) := Ideal.comap ψ b.asIdeal
  haveI hbp : (PrimeSpectrum.asIdeal b).IsPrime := PrimeSpectrum.isPrime b
  haveI hPbp : Pb.IsPrime := Ideal.comap_isPrime _ _
  have h1 : Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤ Pb := by
    rw [Ideal.span_le]
    rintro _ ⟨p, rfl⟩
    have := hb p
    rw [hab] at this
    exact this
  have hbm : b.asIdeal ≤ IsLocalRing.maximalIdeal B₀ :=
    IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top b.isPrime)
  have h2 : Pb ≤ P := Ideal.comap_mono hbm
  have e1 := hmax.eq_of_le (Ideal.IsPrime.ne_top hPbp) h1
  have e2 := hmax.eq_of_le (Ideal.IsPrime.ne_top hPp) (h1.trans h2)
  have hPPb : P = Pb := e2.symm.trans e1
  have h3 : IsLocalRing.maximalIdeal B₀ ≤ b.asIdeal := by
    rw [← hkey, hPPb]
    exact Ideal.map_comap_le
  apply PrimeSpectrum.ext
  exact le_antisymm hbm h3

theorem wc_qmbt_hl_adapted_charts {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {Y : Scheme.{u}} (iY : Y ⟶ Xs') [IsClosedImmersion iY]
    (hYset : Set.range iY =
      closure ((fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
      (fun x : Xs' => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) x) ⁻¹' {IsLocalRing.closedPoint B₀})
    (w : Xs') (hw : w ∉ Set.range iY) :
    ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
      (y : U.toScheme),
      U.ι y = ι' w ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f ∧
      (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal (g y) ∨
        Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal (g y)) :=
by
  classical
  obtain ⟨Xm₀, f₀, bl₀, hbl₀, hblf₀, hcov₀⟩ :=
    wc_qmbt_hl_model_adapted hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen
  obtain ⟨hcp, huniq⟩ := wc_qmbt_hl_b0_origin_fibre hπ hx₀ hsh

  obtain ⟨φ, hφ, -⟩ := hbl₀.2 Xm bl hbl.1
  obtain ⟨ψ, hψ, -⟩ := hbl.2 Xm₀ bl₀ hbl₀.1
  have h1 : φ ≫ ψ = 𝟙 Xm := by
    apply (hbl.2 Xm bl hbl.1).unique
    · simp only [Category.assoc, hψ, hφ]
    · simp only [Category.id_comp]
  have h2 : ψ ≫ φ = 𝟙 Xm₀ := by
    apply (hbl₀.2 Xm₀ bl₀ hbl₀.1).unique
    · simp only [Category.assoc, hφ, hψ]
    · simp only [Category.id_comp]
  haveI : IsIso φ := ⟨⟨ψ, h1, h2⟩⟩
  have hf : φ ≫ f₀ = f := by
    rw [← hblf₀, ← Category.assoc, hφ, hblf]
  have hpt : ∀ v : Xm, ψ (φ v) = v := fun v => by
    rw [← Scheme.Hom.comp_apply, h1]; rfl
  have hpt' : ∀ v : Xm₀, φ (ψ v) = v := fun v => by
    rw [← Scheme.Hom.comp_apply, h2]; rfl
  have hβ : ∀ v : Xs', (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) v =
      (bl₀ ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) (φ (ι' v)) := by
    intro v
    rw [← hφ]
    simp only [Scheme.Hom.comp_apply]

  obtain ⟨U₀, r, g₀, y₀, hy₀, hg₀, heq, hDL⟩ := hcov₀ (φ (ι' w))
  haveI := hg₀
  have hxU₀ : φ (ι' w) ∈ U₀ := by
    have e : U₀.ι y₀ = y₀.1 := Scheme.Opens.ι_apply _ _
    rw [← hy₀, e]
    exact y₀.2
  have hmem : ι' w ∈ φ ⁻¹ᵁ U₀ := (Scheme.Hom.mem_preimage φ).mpr hxU₀
  let yU : (φ ⁻¹ᵁ U₀).toScheme := ⟨ι' w, hmem⟩
  have hyU : (φ ⁻¹ᵁ U₀).ι yU = ι' w := Scheme.Opens.ι_apply _ _
  have hres : (φ ∣_ U₀) yU = y₀ := by
    have e1 := congrArg (fun k => k yU) (morphismRestrict_ι φ U₀)
    have e2 : U₀.ι ((φ ∣_ U₀) yU) = U₀.ι y₀ :=
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))).trans
        ((congrArg φ hyU).trans hy₀.symm)
    exact U₀.ι.isOpenEmbedding.injective e2
  have hgy : ((φ ∣_ U₀) ≫ g₀) yU = g₀ y₀ :=
    (Scheme.Hom.comp_apply _ _ _).trans (congrArg g₀ hres)
  refine ⟨φ ⁻¹ᵁ U₀, r, (φ ∣_ U₀) ≫ g₀, yU, hyU, inferInstance, ?_, ?_⟩
  · rw [Category.assoc, heq, ← Category.assoc, morphismRestrict_ι, Category.assoc, hf]
  rw [hgy]
  by_contra hcon
  have hm0 := not_not.mp (fun h => hcon (Or.inl h))
  have hm1 := not_not.mp (fun h => hcon (Or.inr h))
  obtain ⟨ha, x₀', hsp, hf₀, p, hp⟩ := hDL hm0 hm1

  have hwZ : (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) w = IsLocalRing.closedPoint B₀ := by
    apply huniq
    intro q
    rw [hβ]
    exact ha q

  have hx'sp : ψ x₀' ⤳ ι' w := by
    have := hsp.map ψ.continuous
    rwa [hpt] at this
  have hfx' : f (ψ x₀') = IsLocalRing.closedPoint A' := by
    rw [← hf, Scheme.Hom.comp_apply, hpt', hf₀]
  obtain ⟨s₀⟩ : Nonempty (PrimeSpectrum (IsLocalRing.ResidueField A')) := inferInstance
  let s₁ : ↥(Spec (CommRingCat.of (IsLocalRing.ResidueField A'))) := s₀
  have hs₁ : wcQmSp A' s₁ = IsLocalRing.closedPoint A' := by
    apply PrimeSpectrum.ext
    show Ideal.comap (IsLocalRing.residue A') (PrimeSpectrum.asIdeal s₀) =
      IsLocalRing.maximalIdeal A'
    rw [Ideal.eq_bot_of_prime (PrimeSpectrum.asIdeal s₀)]
    exact IsLocalRing.ker_residue
  obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f) (g := wcQmSp A')
    (ψ x₀') s₁ (hfx'.trans hs₁.symm)
  have hw' : ι' (hps'.isoPullback.inv z) = ψ x₀' := by
    rw [← Scheme.Hom.comp_apply, hps'.isoPullback_inv_fst]
    exact hz1
  haveI : IsClosedImmersion (wcQmSp A') :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip inferInstance
  have hw'sp : hps'.isoPullback.inv z ⤳ w := by
    have hind := (IsClosedImmersion.isClosedEmbedding ι').isInducing
    rw [← hind.specializes_iff, hw']
    exact hx'sp
  have hw'Z : (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) (hps'.isoPullback.inv z) ≠
      IsLocalRing.closedPoint B₀ := by
    intro hcz
    rw [hβ, hw', hpt'] at hcz
    apply hp
    rw [hcz]
    exact hcp p

  apply hw
  rw [hYset]
  refine ⟨?_, hwZ⟩
  have hcl : w ∈ closure {hps'.isoPullback.inv z} := specializes_iff_mem_closure.mp hw'sp
  refine closure_mono ?_ hcl
  rw [Set.singleton_subset_iff]
  exact hw'Z

theorem wc_qmbt_hl_off_Y_vanish {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (hℓ' : IsUnit ((ℓ : ℕ) : A')) {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    (O : Xs'.Opens)
    (hO : ∀ w ∈ O, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
      (y : U.toScheme),
      U.ι y = ι' w ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f ∧
      (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal (g y) ∨
        Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal (g y)))
    (Dj : wcHMPullData O.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (q : ℕ) (hq : 1 ≤ q) :
    haveI := Dp'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    Limits.IsZero (Dj.Φ.obj (Di'.Φ.obj
      (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology q))) :=
by
  intro P'
  haveI := Dp'.additive
  classical

  have hdet : ∀ {Xv : Scheme.{u}} (πv : Xv ⟶ Spec (.of A')) (η : Spec (.of L') ⟶ Spec (.of A'))
      (Vt : Xv.ProEt)
      (hVt : IsAffine Vt.left ∧ IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
        (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} ∧
        (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
          HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x)))
      (j : ℕ)
      (hst : ∀ z : Vt.left, IsClosed ({z} : Set Vt.left) →
        Subsingleton (wcEtCoh (Limits.pullback (Vt.left.fromSpecStalk z)
          (Limits.pullback.fst (Vt.hom ≫ πv) η)) ℓ (j + 1))),
      Subsingleton (wcEtCoh (Limits.pullback (Vt.hom ≫ πv) η) ℓ (j + 1)) := by
    intro Xv πv η Vt hVt j hst
    haveI : IsAffine Vt.left := hVt.1
    haveI : IsAffine ((𝟭 Scheme.{u}).obj Vt.left) := hVt.1
    haveI hQC : QuasiCompact (Limits.pullback.fst (Vt.hom ≫ πv) η) := inferInstance
    haveI hQS : QuasiSeparated (Limits.pullback.fst (Vt.hom ≫ πv) η) := inferInstance
    haveI hP0c : CompactSpace (Limits.pullback (Vt.hom ≫ πv) η : Scheme.{u}) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst (Vt.hom ≫ πv) η)
    haveI hP0q : QuasiSeparatedSpace (Limits.pullback (Vt.hom ≫ πv) η : Scheme.{u}) :=
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst (Vt.hom ≫ πv) η)
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all ℓ (j + 1)
    have hstalk : ∀ z : Vt.left, IsClosed ({z} : Set Vt.left) →
        Subsingleton (wcZModProEtExt (Limits.pullback (Vt.left.fromSpecStalk z)
          (Limits.pullback.fst (Vt.hom ≫ πv) η)) ℓ (j + 1)) := by
      intro z hz
      haveI := hst z hz
      obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (Vt.left.fromSpecStalk z)
        (Limits.pullback.fst (Vt.hom ≫ πv) η)) ℓ (j + 1)
      haveI : Subsingleton (wcEtZModExt (Limits.pullback (Vt.left.fromSpecStalk z)
          (Limits.pullback.fst (Vt.hom ≫ πv) η)) ℓ (j + 1)) := E.subsingleton
      have hzc : CompactSpace (Limits.pullback (Vt.left.fromSpecStalk z)
          (Limits.pullback.fst (Vt.hom ≫ πv) η) : Scheme.{u}) :=
        QuasiCompact.compactSpace_of_compactSpace
          (Limits.pullback.fst (Vt.left.fromSpecStalk z) (Limits.pullback.fst (Vt.hom ≫ πv) η))
      have hzq : QuasiSeparatedSpace (Limits.pullback (Vt.left.fromSpecStalk z)
          (Limits.pullback.fst (Vt.hom ≫ πv) η) : Scheme.{u}) :=
        quasiSeparatedSpace_of_quasiSeparated
          (Limits.pullback.fst (Vt.left.fromSpecStalk z) (Limits.pullback.fst (Vt.hom ≫ πv) η))
      exact (hΘ _ hzc hzq).2.subsingleton
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf (Limits.pullback (Vt.hom ≫ πv) η) ℓ)) :=
      HasExt.standard _
    have hFunOne : ∀ (S : Scheme.{u}) (m : ℕ), wcZModFun S m 1 = 𝟙 _ := by
      intro S m
      apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext V
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      rw [← SheafOfModules.unitHomEquiv_apply_coe]
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    have hFunMul : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
        wcZModFun S m (r * r') = wcZModFun S m r ≫ wcZModFun S m r' := by
      intro S m r r'
      apply (SheafOfModules.unitHomEquiv _).injective
      rw [SheafOfModules.unitHomEquiv_comp_apply]
      apply Subtype.ext
      funext V
      have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
          ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
          (c.comp (Opposite.unop V).hom.base.hom :
            C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
        intro c
        simp only [wcZModFun, Equiv.apply_symm_apply]
        rfl
      show _ = ((wcZModFun S m r').val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V)
      rw [hvalP, hvalP]
      apply ContinuousMap.ext
      intro x
      rfl
    have hFunAdd : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
        wcZModFun S m (r + r') = wcZModFun S m r + wcZModFun S m r' := by
      intro S m r r'
      apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext V
      have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
          ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
          (c.comp (Opposite.unop V).hom.base.hom :
            C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
        intro c
        simp only [wcZModFun, Equiv.apply_symm_apply]
        rfl
