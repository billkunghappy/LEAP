  have L6 : ∀ (K : Type u) [Field K] (N : ℕ) (c : Fin (N + 1)) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (R : Type u) [CommRing R], letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)); ∀ ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c) →+* R, Function.Surjective ψ → RingHom.ker ψ = Ideal.span {HomogeneousLocalization.Away.isLocalizationElem ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) G.2} → Set.range (Spec.map (CommRingCat.ofHom ψ) ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) Nat.one_pos) = {p | p ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c) ∧ p ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (G : MvPolynomial (Fin (N + 1)) K)} ∧ ∀ (y : Spec (.of R)) (i : Fin (N + 1)), (Spec.map (CommRingCat.ofHom ψ) ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) Nat.one_pos) y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) ↔ ψ (HomogeneousLocalization.Away.isLocalizationElem ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K i))) ∉ y.asIdeal := by
