    obtain ⟨Eq⟩ := wc_et_coh_iso_invariance φ.inv ℓ q
    haveI := wc_et_affine_partial_punct_vanishing Ω ℓ hℓp hℓ (2 * e + 1) k (by omega) E hE q
      (by omega)
    exact Eq.subsingleton
  have hMV : ∀ n, n ≤ e → ∀ q, 2 * e + 1 ≤ q →
      Subsingleton (wcEtCoh ((⨆ (k : ℕ) (_ : k ≤ n), W k : Y.Opens) : Scheme.{u}) ℓ q) := by
    intro n
    induction n with
    | zero =>
      intro _ q hq
      have h0 : (⨆ (k : ℕ) (_ : k ≤ 0), W k) = W 0 := by
        apply le_antisymm
        · exact iSup₂_le (fun k hk => by rw [Nat.le_zero.mp hk])
        · exact le_iSup₂_of_le 0 le_rfl le_rfl
      rw [h0]
      exact hW1 0 (by omega) q (by omega)
    | succ n ih =>
      intro hn q hq
      obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
      have hsup : (⨆ (k : ℕ) (_ : k ≤ n), W k) ⊔ W (n + 1) = ⨆ (k : ℕ) (_ : k ≤ n + 1), W k := by
        apply le_antisymm
        · apply sup_le
          · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
          · exact le_iSup₂_of_le (n + 1) le_rfl le_rfl
        · apply iSup₂_le
          intro k hk
          rcases Nat.lt_or_ge k (n + 1) with h | h
          · exact le_sup_of_le_left (le_iSup₂_of_le k (by omega) le_rfl)
          · have hk' : k = n + 1 := by omega
            subst hk'; exact le_sup_right
      have hinf : (⨆ (k : ℕ) (_ : k ≤ n), W k) ⊓ W (n + 1) =
          W (n + 1) ⊓ ⨆ (i : ℕ) (_ : i < n + 1), W i := by
        rw [inf_comm]
        congr 1
        apply le_antisymm
        · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
        · exact iSup₂_le (fun k hk => le_iSup₂_of_le k (by omega) le_rfl)
      haveI h1 : Subsingleton (wcEtCoh (((⨆ (k : ℕ) (_ : k ≤ n), W k) ⊓ W (n + 1) : Y.Opens) :
          Scheme.{u}) ℓ q') := by
        rw [hinf]
        exact hW2 (n + 1) (by omega) hn q' (by omega)
      haveI h2 := ih (by omega) (q' + 1) hq
      haveI h3 := hW1 (n + 1) hn (q' + 1) (by omega)
      obtain ⟨hfin, hcard⟩ := wc_et_zariski_mv_card_le Y _ _ _ hsup ℓ q'
        Finite.of_subsingleton Finite.of_subsingleton Finite.of_subsingleton
      haveI := hfin
      have c1 := Finite.card_le_one_iff_subsingleton.mpr h1
      have c2 := Finite.card_le_one_iff_subsingleton.mpr h2
      have c3 := Finite.card_le_one_iff_subsingleton.mpr h3
      have hle : Nat.card (wcEtCoh ((⨆ (k : ℕ) (_ : k ≤ n + 1), W k : Y.Opens) : Scheme.{u}) ℓ
          (q' + 1)) ≤ 1 :=
        calc _ ≤ _ := hcard
          _ ≤ 1 * (1 * 1) := Nat.mul_le_mul c1 (Nat.mul_le_mul c2 c3)
          _ = 1 := rfl
      exact Finite.card_le_one_iff_subsingleton.mp hle



  haveI := wc_proj_space_isProper Ω (2 * e + 2)
  haveI : CompactSpace Y :=
    QuasiCompact.compactSpace_of_compactSpace (jY ≫ wcProjKStr Ω (2 * e + 2))
  haveI : SmoothOfRelativeDimension e (i ≫ jY ≫ wcProjKStr Ω (2 * e + 2)) := by
    rw [hstr]; exact wc_proj_space_smooth Ω e
  haveI := wc_proj_space_irreducible Ω e
  have hne : Nonempty (wcProjK Ω e) := inferInstance
  have hO : ((⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens) : Set Y) = (Set.range i)ᶜ := by
    rw [hirange, compl_compl]



  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i ℓ
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists (⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens).ι ℓ
  have hles := wc_et_supp_open_les i _ hO ℓ D Dj
  have hOv : ∀ q, 2 * e + 1 ≤ q → Subsingleton (wcEtZModExt
      ((⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens) : Scheme.{u}) ℓ q) := by
    intro q hq
    obtain ⟨eO⟩ := wc_et_zmodext_coh_equiv
      ((⨆ (k : ℕ) (_ : k ≤ e), W k : Y.Opens) : Scheme.{u}) ℓ q
    haveI := hMV e le_rfl q hq
    exact eO.subsingleton
  obtain ⟨P0⟩ := wc_et_smooth_pair_purity_ext_equiv Ω (jY ≫ wcProjKStr Ω (2 * e + 2))
    (2 * e + 1) e (e + 1) (by omega) i ℓ hℓ hne D 0
  obtain ⟨P1⟩ := wc_et_smooth_pair_purity_ext_equiv Ω (jY ≫ wcProjKStr Ω (2 * e + 2))
    (2 * e + 1) e (e + 1) (by omega) i ℓ hℓ hne D 1
  rw [show 0 + 2 * (e + 1) = 2 * e + 2 by omega] at P0
  rw [show 1 + 2 * (e + 1) = 2 * e + 3 by omega] at P1
  obtain ⟨E0⟩ := wc_et_zmodext_coh_equiv (wcProjK Ω e) ℓ 0
  obtain ⟨E1⟩ := wc_et_zmodext_coh_equiv (wcProjK Ω e) ℓ 1
  have hH0 : Nat.card (wcEtCoh (wcProjK Ω e) ℓ 0) = ℓ :=
    wc_et_coh_zero_connected_card _ ℓ hℓp.ne_zero
  haveI hH1 : Subsingleton (wcEtCoh (wcProjK Ω e) ℓ 1) :=
    wc_et_proj_space_odd_vanish Ω ℓ hℓ e 1 odd_one
  haveI hS3 : Subsingleton (wcEtSuppExt D (2 * e + 3)) := (P1.symm.trans E1).subsingleton
  have hS2 : Nat.card (wcEtSuppExt D (2 * e + 2)) = ℓ :=
    (Nat.card_congr (P0.symm.trans E0)).trans hH0



  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  haveI := hOv (2 * e + 1) le_rfl
  haveI := hOv (2 * e + 2) (by omega)
  haveI := hOv (2 * e + 3) (by omega)
  have hbij : Function.Bijective (fun x : wcEtSuppExt D (2 * e + 2) =>
      (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp x (zero_add (2 * e + 2))) := by
    refine ⟨fun x₁ x₂ h12 => ?_, fun y => (hles.1 (2 * e + 2) y).mp (Subsingleton.elim _ _)⟩
    obtain ⟨δ, hδ, -⟩ := hles.2.2 (2 * e + 1) (2 * e + 2) (by omega)
    have h0 : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp (x₁ + -x₂) (zero_add (2 * e + 2)) = 0 := by
      rw [Abelian.Ext.comp_add, Abelian.Ext.comp_neg]
      exact add_neg_eq_zero.mpr h12
    obtain ⟨b, hb⟩ := (hδ _).mp h0
    have hb0 : b = 0 := Subsingleton.elim _ _
    rw [hb0, map_zero] at hb
    exact add_neg_eq_zero.mp hb.symm
  obtain ⟨eY2⟩ := wc_et_zmodext_coh_equiv Y ℓ (2 * e + 2)
  obtain ⟨eY3⟩ := wc_et_zmodext_coh_equiv Y ℓ (2 * e + 3)
  refine ⟨?_, ?_⟩
  · exact ((Nat.card_congr eY2).symm.trans (Nat.card_congr (Equiv.ofBijective _ hbij)).symm).trans hS2
  · haveI : Subsingleton (wcEtZModExt Y ℓ (2 * e + 3)) := by
      constructor
      intro y₁ y₂
      obtain ⟨x₁, hx₁⟩ := (hles.1 (2 * e + 3) y₁).mp (Subsingleton.elim _ _)
      obtain ⟨x₂, hx₂⟩ := (hles.1 (2 * e + 3) y₂).mp (Subsingleton.elim _ _)
      rw [← hx₁, ← hx₂, Subsingleton.elim x₁ x₂]
    exact eY3.symm.subsingleton

theorem wc_hm_ne_zero_of_et_counts_qcqs : ∀ (S : Scheme.{u}) [CompactSpace S]
    [QuasiSeparatedSpace S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ),
    (∀ k : ℕ, 1 ≤ k → Nat.card (wcEtCoh S (ℓ ^ k) N) = ℓ ^ k) →
    Subsingleton (wcEtCoh S ℓ (N + 1)) → ∃ y : wcHM S ℓ N, y ≠ 0 :=
by
  intro S hcS hqS ℓ _ N hcard htopE
  classical
  have hℓp : ℓ.Prime := Fact.out
  have EP : ∀ m j : ℕ, Nonempty (wcZModProEtExt S m j ≃ wcEtCoh S m j) := by
    intro m j
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all.{u} m j
    obtain ⟨Ez⟩ := wc_et_zmodext_coh_equiv S m j
    exact ⟨(Equiv.ofBijective (Θ S) (hΘ S hcS hqS)).symm.trans Ez⟩
  have hfinE : ∀ k : ℕ, 1 ≤ k → Finite (wcEtCoh S (ℓ ^ k) N) := fun k hk =>
    Nat.finite_of_card_ne_zero (by rw [hcard k hk]; exact (pow_pos hℓp.pos k).ne')
  have passage : ∀ (S : Scheme.{u}) (_ : CompactSpace S) (_ : QuasiSeparatedSpace S) (N : ℕ),
      Finite (wcZModProEtExt S ℓ N) → Nat.card (wcZModProEtExt S ℓ N) ≤ ℓ →
      Subsingleton (wcZModProEtExt S ℓ (N + 1)) →
      (∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt S (ℓ ^ k) N) ∧
        ℓ ^ k ≤ Nat.card (wcZModProEtExt S (ℓ ^ k) N)) →
      ∃ y : wcHM S ℓ N, y ≠ 0 := by
    intro S hcS hqS N hfin1 hcard1 htop hge
    let U : S.ProEt := Scheme.ProEt.mk (𝟙 S)
    have Em : ∀ m : ℕ, 0 < m → ∀ j : ℕ,
        Nonempty (wcZModProEtExt S m j ≃+ Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S m) j) := by
      intro m hm j
      obtain ⟨Φ, hΦb, -, -⟩ := wc_proet_free_zmod_ext_mod_model.{u} m j hm
      exact ⟨AddEquiv.ofBijective (Φ S U) (hΦb S U)⟩
    have hℓpos : 0 < ℓ := hℓp.pos
    obtain ⟨E1⟩ := Em ℓ hℓpos N
    obtain ⟨E2⟩ := Em ℓ hℓpos (N + 1)
    have h1 : Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) :=
      Finite.of_equiv _ E1.toEquiv
    have h2 : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) ≤ ℓ := by
      rw [← Nat.card_congr E1.toEquiv]
      exact hcard1
    have h3 : ∀ z : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) (N + 1), z = 0 := by
      intro z
      rw [← E2.apply_symm_apply z, Subsingleton.elim (E2.symm z) 0, map_zero]
    have h4 : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) →
        ℓ ^ k ≤ Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) := by
      intro k hk _
      obtain ⟨Ek⟩ := Em (ℓ ^ k) (pow_pos hℓpos k) N
      rw [← Nat.card_congr Ek.toEquiv]
      exact (hge k hk).2
    obtain ⟨hcnt, hsN, -⟩ := wc_local_tower_counts S ℓ (wcFreeSheaf S U) N h1 h2 h3 h4
    have hkill : ∀ (m : ℕ) (t : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N),
        ℓ ^ m • t = 0 := by
      intro m t
      have hc' : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N) = ℓ ^ m :=
        (hcnt m).2
      have h := card_nsmul_eq_zero' (G := Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ m)) N)
        (x := t)
      rw [hc'] at h
      exact h
    have hcyc := wc_zmod_local_nakayama_cyclic S ℓ (wcFreeSheaf S U) N h1 h2 h3 hkill
    obtain ⟨g, hg1, hg2, hg3⟩ := ladic_tower_compatible_generators ℓ
      (fun m => Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod (ℓ ^ m))) N)
      (fun m => (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ m)
        continuous_of_discreteTopology)).postcomp (wcFreeSheaf S U) (add_zero N))
      hcnt hcyc (fun m t => hsN m t)
    have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := by
      intro k
      show Continuous (fun x : ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) k x)
      rw [continuous_discrete_rng]
      intro b
      rw [Metric.isOpen_iff]
      intro x hx
      have hℓ' : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓpos
      refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos hℓ' _, fun y hy => ?_⟩
      have e1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
        rw [Metric.mem_ball, dist_eq_norm] at hy
        exact hy.le
      have e2 := (PadicInt.norm_le_pow_iff_mem_span_pow (y - x) k).mp e1
      rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at e2
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
      rw [e2]
      exact hx
    have hg1' : ∀ k : ℕ, (g (k + 1)).comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ k)
        continuous_of_discreteTopology)) (add_zero N) = g k := by
      intro k
      have h := hg1 k
      simpa only [Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply] using h
    obtain ⟨xI, hxI⟩ := wc_proet_int_lim_surj S U ℓ hc N g hg1'
    have hnt : ∀ r : ℕ, ℓ ^ r • xI ≠ 0 := by
      intro r hr
      obtain ⟨xC, hxCdef⟩ : ∃ xC : Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S ℤ_[ℓ]) N,
          xC = xI := ⟨xI, rfl⟩
      have hxC : xC.comp (Abelian.Ext.mk₀ (wcContSheafMap S
          (PadicInt.toZModPow (p := ℓ) (r + 1)).toAddMonoidHom (hc (r + 1)))) (add_zero N) =
          g (r + 1) := by
        rw [hxCdef]; exact hxI (r + 1)
      have hrC : ℓ ^ r • xC = 0 := by rw [hxCdef]; exact hr
      have hlin : ∀ c : ℕ, (c • xC).comp (Abelian.Ext.mk₀ (wcContSheafMap S
          (PadicInt.toZModPow (p := ℓ) (r + 1)).toAddMonoidHom (hc (r + 1)))) (add_zero N) =
          c • g (r + 1) := by
        intro c
        induction c with
        | zero =>
          rw [zero_smul, zero_smul, Abelian.Ext.zero_comp]
        | succ c ih =>
          rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih, hxC]
      have h0 := hlin (ℓ ^ r)
      rw [hrC, Abelian.Ext.zero_comp] at h0
      have h0z : (ℓ ^ r) • g (r + 1) = 0 := h0.symm
      have h0' : ((ℓ ^ r : ℕ) : ℤ) • g (r + 1) = 0 := by rw [natCast_zsmul]; exact h0z
      have hdvd := hg3 (r + 1) _ h0'
      have hdvd' : ℓ ^ (r + 1) ∣ ℓ ^ r := by exact_mod_cast hdvd
      have hle := Nat.le_of_dvd (pow_pos hℓpos r) hdvd'
      have hlt : ℓ ^ r < ℓ ^ (r + 1) := Nat.pow_lt_pow_right hℓp.one_lt (Nat.lt_succ_self r)
      omega
    haveI : CompactSpace ↥U.left := (hcS : CompactSpace ↥S)
    haveI : QuasiSeparatedSpace ↥U.left := (hqS : QuasiSeparatedSpace ↥S)
    obtain ⟨-, htor⟩ := proet_qcqs_ladic_rationalization S U ℓ N
    obtain ⟨Θ, -⟩ := wc_hm_ladic_bridge S ℓ N
    refine ⟨Θ.symm (xI.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero N)), ?_⟩
    intro h0
    have hx0 : xI.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero N) = 0 := by
      rw [← Θ.apply_symm_apply (xI.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero N)), h0,
        map_zero]
    obtain ⟨r, hr⟩ := htor xI hx0
    exact hnt r hr
  have pf1 : Finite (wcZModProEtExt S ℓ N) := by
    have h := hfinE 1 le_rfl
    rw [pow_one] at h
    exact Finite.of_equiv _ (EP ℓ N).some.symm
  have pc1 : Nat.card (wcZModProEtExt S ℓ N) ≤ ℓ := by
    have h := hcard 1 le_rfl
    rw [pow_one] at h
    exact ((Nat.card_congr (EP ℓ N).some).trans h).le
  have ps1 : Subsingleton (wcZModProEtExt S ℓ (N + 1)) := by
    haveI := htopE
    exact (EP ℓ (N + 1)).some.subsingleton
  have pge : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt S (ℓ ^ k) N) ∧
      ℓ ^ k ≤ Nat.card (wcZModProEtExt S (ℓ ^ k) N) := by
    intro k hk
    haveI := hfinE k hk
    exact ⟨Finite.of_equiv _ (EP (ℓ ^ k) N).some.symm,
      ((Nat.card_congr (EP (ℓ ^ k) N).some).trans (hcard k hk)).ge⟩
  exact passage S hcS hqS N pf1 pc1 ps1 pge

theorem wc_qmbt_xspl_xsp_split_quadric_card_transport {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    ∃ (e : ℕ) (_ : n = 2 * e + 2) (R : Scheme.{u}) (_ : AlgebraicGeometry.IsReduced R)
      (jR : R ⟶ wcProjK (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (2 * e + 2)),
      IsClosedImmersion jR ∧
      Set.range jR = wcXspVplus (AlgebraicClosure (IsLocalRing.ResidueField B₀)) (2 * e + 2)
        (wcXspSplitCoeff (AlgebraicClosure (IsLocalRing.ResidueField B₀)) e) ∧
      ∀ q : ℕ, Nat.card (wcEtCoh Xs' ℓ q) = Nat.card (wcEtCoh R ℓ q) :=
by
  obtain ⟨f₀, hf₀def⟩ : ∃ g : Xs' ⟶ Spec (.of B₀), g = ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) := ⟨_, rfl⟩
  haveI hι' : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A'))
        IsLocalRing.residue_surjective)
  haveI : IsProper (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := wc_qmbt_nt_beta_proper hgen hbl
  haveI hf₀ : IsProper f₀ := by rw [hf₀def]; infer_instance

  have hℓB : IsUnit ((ℓ : ℕ) : B₀) := by
    have h := hℓ.map (Spec.preimage (a₀ ≫ wcQuadModelStr A n π c)).hom
    rwa [map_natCast] at h
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField B₀) ≠ 0 := by
    have h := hℓB.map (IsLocalRing.residue B₀)
    rw [map_natCast] at h
    exact h.ne_zero
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero

  have hF : IsPullback (Limits.pullback.fst f₀ (wcQmSp B₀)) (Limits.pullback.snd f₀ (wcQmSp B₀))
      (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))) (wcQmSp B₀) := by
    rw [← hf₀def]; exact IsPullback.of_hasPullback _ _
  obtain ⟨a0, R₀, hR₀, r₀, j₀, hdet, hr₀, hr₀s, hj₀, hj₀c, hj₀r⟩ :=
    wc_qxs_exc_fibre_quadric hn hn4 hπ hc hx₀ hsh hπ' hπ'2 hgen hbl hblf hps' hF
  obtain ⟨e, hne, R, hR, r, jR, hr, hrs, hjR, hjRr⟩ :=
    wc_qxs_quadric_base_change_split (IsLocalRing.ResidueField B₀) n hn hn4 a0 hdet
      (Limits.pullback f₀ (wcQmSp B₀)) R₀ (Limits.pullback.snd f₀ (wcQmSp B₀)) r₀ j₀
      hr₀ hr₀s hj₀ hj₀c hj₀r _
      (Limits.pullback.fst (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀))))))
      (Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀))))))
      (IsPullback.of_hasPullback _ _)
  haveI := hR
  haveI := hr
  refine ⟨e, hne, R, hR, jR, hjR, hjRr, fun q => ?_⟩

  have hred := wc_et_fibre_coh_reduced_invariance _ _ _ R
    (Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) r hrs (𝟙 _) ℓ q
  obtain ⟨I1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
    (r ≫ Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) (𝟙 _)) ℓ q
  obtain ⟨I2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
    (Limits.pullback.snd (Limits.pullback.snd f₀ (wcQmSp B₀))
        (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
          (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) (𝟙 _)) ℓ q
  have hR_FK : Nat.card (wcEtCoh (Limits.pullback (Limits.pullback.snd f₀ (wcQmSp B₀))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ℓ q) =
      Nat.card (wcEtCoh R ℓ q) := by
    rw [Nat.card_congr I2, ← hred, ← Nat.card_congr I1]

  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst
    (Limits.pullback.snd f₀ (wcQmSp B₀))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ℓ
  have hbij := wc_et_sepclosed_field_ext_proper_pull_bij (IsLocalRing.ResidueField B₀)
    (AlgebraicClosure (IsLocalRing.ResidueField B₀))
    (algebraMap (IsLocalRing.ResidueField B₀) (AlgebraicClosure (IsLocalRing.ResidueField B₀)))
    (Limits.pullback f₀ (wcQmSp B₀)) (Limits.pullback.snd f₀ (wcQmSp B₀)) _ _ _
    (IsPullback.of_hasPullback _ _) ℓ hℓk D q
  obtain ⟨Z1⟩ := wc_et_zmodext_coh_equiv (Limits.pullback f₀ (wcQmSp B₀)) ℓ q
  obtain ⟨Z2⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (Limits.pullback.snd f₀ (wcQmSp B₀))
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B₀)
        (AlgebraicClosure (IsLocalRing.ResidueField B₀)))))) ℓ q
  have EF := Z1.symm.trans ((Equiv.ofBijective _ hbij).trans Z2)

  obtain ⟨E1⟩ := wc_et_henselian_closed_fibre_coh B₀ Xs' f₀ ℓ hℓ0
    wc_et_henselian_proper_vanishing q
  have E1' : wcEtCoh Xs' ℓ q ≃ wcEtCoh (Limits.pullback f₀ (wcQmSp B₀)) ℓ q := E1
  exact (Nat.card_congr E1').trans ((Nat.card_congr EF).trans hR_FK)

theorem wc_hens_proper_closed_fibre_hm_pull_inj : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (X : Scheme.{u}) (f : X ⟶ Spec (.of B))
    [IsProper f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : IsLocalRing.ResidueField B) ≠ 0 →
    ∀ {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i],
    Set.range i = f ⁻¹' {IsLocalRing.closedPoint B} →
    ∀ (E : wcHMPullData i ℓ), wcHMPullCanonical E → ∀ q : ℕ, Function.Injective (wcHMPull E q) :=
by
  intro B _ _ _ X f _ ℓ _ hℓ Z i _ hrange E hE q
  classical

  have hetbij : ∀ (m : ℕ), m ≠ 0 → ∀ (D : wcEtPullData i m) (q : ℕ),
      Function.Bijective (wcEtPull D q) := by
    intro m hm D q
    have hset : (Set.range i)ᶜ =
        f ⁻¹' ({IsLocalRing.closedPoint B}ᶜ : Set (Spec (.of B))) := by
      rw [hrange, Set.preimage_compl]
    have hSo : IsOpen ({IsLocalRing.closedPoint B}ᶜ : Set (Spec (.of B))) :=
      (IsLocalRing.isClosed_singleton_closedPoint B).isOpen_compl
    have hSne : ({IsLocalRing.closedPoint B}ᶜ : Set (Spec (.of B))) ≠ Set.univ := by
      intro h
      have hc : IsLocalRing.closedPoint B ∈ ({IsLocalRing.closedPoint B}ᶜ : Set (Spec (.of B))) := by
        rw [h]; trivial
      exact hc rfl
    have hvan := wc_et_henselian_proper_vanishing B X f m hm _ hSo hSne
    rw [← hset] at hvan
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X m)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    haveI hepi : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
    have hker : ∀ j : ℕ, Subsingleton (Abelian.Ext (SheafOfModules.unit (wcEtZModRing X m))
        (Limits.kernel (wcEtSuppUnitMap D)) j) := by
      intro j
      obtain ⟨E1⟩ := wc_et_zmod_modext_toSheaf_equiv X m (Nat.pos_of_ne_zero hm)
        (Limits.kernel (wcEtSuppUnitMap D)) j
      obtain ⟨e⟩ := wc_et_supp_unit_ker_extZero_iso i m D
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
      let P := (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))
      let E2 : Abelian.Ext P ((SheafOfModules.toSheaf (wcEtZModRing X m)).obj
          (Limits.kernel (wcEtSuppUnitMap D))) j ≃
          Abelian.Ext P (wcEtExtZero X (Set.range i)ᶜ m) j :=
        { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero j)
          invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero j)
          left_inv := fun x => by
            simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
          right_inv := fun y => by
            simp only
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
      haveI : Subsingleton (Abelian.Ext P (wcEtExtZero X (Set.range i)ᶜ m) j) := hvan j
      exact (E1.trans E2).subsingleton
    let Sc : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing X m)) :=
      ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
        (Limits.kernel.condition (wcEtSuppUnitMap D))
    have hS : Sc.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hepi
    have hpost : Function.Bijective (fun x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing X m))
        (SheafOfModules.unit (wcEtZModRing X m)) q =>
          x.comp (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)) (add_zero q)) := by
      constructor
      · intro x y hxy
        have h0 : (x - y).comp (Abelian.Ext.mk₀ Sc.g) (add_zero q) = 0 := by
          change ((Abelian.Ext.mk₀ Sc.g).postcomp _ (add_zero q)) (x - y) = 0
          rw [map_sub]
          exact sub_eq_zero.mpr hxy
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (x - y) h0
        have h1 : x₁ = 0 := @Subsingleton.elim _ (hker q) _ _
        rw [h1, Abelian.Ext.zero_comp] at hx₁
        exact sub_eq_zero.mp hx₁.symm
      · intro y
        have hz : y.comp hS.extClass (rfl : q + 1 = q + 1) = 0 :=
          @Subsingleton.elim _ (hker (q + 1)) _ _
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS y rfl hz
        exact ⟨x₂, hx₂⟩
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X m)) :=
      sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology X) (wcEtZModRing X m)
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Z m)) :=
      sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Z) (wcEtZModRing Z m)
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).Additive :=
      Adjunction.right_adjoint_additive D.adj
    haveI : Limits.PreservesFiniteLimits
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) := by
      have := D.adj.rightAdjoint_preservesLimits
      infer_instance
    haveI : Limits.PreservesFiniteColimits
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) :=
      wc_et_finite_push_modules_exact i m D
    exact wc_ext_pull_bij_of_unit_post_bij D.Φ
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) D.adj
      (SheafOfModules.unit (wcEtZModRing X m)) (SheafOfModules.unit (wcEtZModRing Z m)) D.μ q hpost

  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace i
  haveI : QuasiSeparatedSpace Z := quasiSeparatedSpace_of_quasiSeparated i

  choose Dk hDk using fun k : ℕ => wc_zmod_pull_data_exists i (ℓ ^ k)

  have hℓk : ∀ k : ℕ, ((ℓ ^ k : ℕ) : IsLocalRing.ResidueField B) ≠ 0 := fun k => by
    rw [Nat.cast_pow]; exact pow_ne_zero k hℓ
  have hpos : ∀ k : ℕ, 0 < ℓ ^ k := fun k => pow_pos (Fact.out : ℓ.Prime).pos k

  refine wc_ladic_pull_injective_of_torsion ℓ i E hE Dk hDk q
    (fun k _ => wc_strict_hens_proper_zmod_proet_finite B X f (ℓ ^ k) (hℓk k) (q - 1)) ?_
  intro k _
  obtain ⟨Et⟩ := wc_et_zmod_pull_data_exists i (ℓ ^ k)
  exact (wc_zmod_proet_pull_bij_of_et_pull_bij i (ℓ ^ k) (hpos k) (Dk k) (hDk k) Et q
    (hetbij (ℓ ^ k) (hpos k).ne' Et q)).injective

theorem wc_qmbt_xspl_exc_restr_Hn_ne_zero {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    {βs : Xs' ⟶ Xs}
    (hβ : βs ≫ ι = ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)))
    (Dβ : wcHMPullData βs ℓ) (hDβ : wcHMPullCanonical Dβ)
    [EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))]
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ)))
    {Z₂ : Scheme.{u}} (i₂ : Z₂ ⟶ Xs') [IsClosedImmersion i₂]
    (h₂ : Set.range i₂ = (fun z => (ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹'
        {IsLocalRing.closedPoint B₀})
    (E₂ : wcHMPullData i₂ ℓ) (hE₂ : wcHMPullCanonical E₂) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    ∃ v : DerivedCategory.Q.obj ((HomologicalComplex.single
        (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) ((n : ℤ) - 1)).obj
          (SheafOfModules.unit (wcRingSheaf Xs' ℓ))) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) 0).obj
            (SheafOfModules.unit (wcRingSheaf Xs' ℓ))))⟦(1 : ℤ)⟧,
      v ≫ (DerivedCategory.Q.map ((HomologicalComplex.single
          (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (ComplexShape.up ℤ) 0).map
            (wcSuppUnitMap E₂)))⟦(1 : ℤ)⟧' ≠ 0 :=
by
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z₂ ℓ)) := HasExt.standard _

  obtain ⟨f₀, hf₀def⟩ : ∃ g : Xs' ⟶ Spec (.of B₀), g = ι' ≫ bl ≫ Limits.pullback.fst
      (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) := ⟨_, rfl⟩
  haveI hι' : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A'))
        IsLocalRing.residue_surjective)
  haveI : IsProper (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := wc_qmbt_nt_beta_proper hgen hbl
  haveI hf₀ : IsProper f₀ := by rw [hf₀def]; infer_instance
  haveI hcpt : CompactSpace Xs' := QuasiCompact.compactSpace_of_compactSpace f₀
  haveI hqs : QuasiSeparatedSpace Xs' := quasiSeparatedSpace_of_quasiSeparated f₀
  have hℓB : IsUnit ((ℓ : ℕ) : B₀) := by
    have h := hℓ.map (Spec.preimage (a₀ ≫ wcQuadModelStr A n π c)).hom
    rwa [map_natCast] at h
  have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField B₀) ≠ 0 := by
    have h := hℓB.map (IsLocalRing.residue B₀)
    rw [map_natCast] at h
    exact h.ne_zero
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure (IsLocalRing.ResidueField B₀)) ≠ 0 := by
    rw [← map_natCast (algebraMap (IsLocalRing.ResidueField B₀)
      (AlgebraicClosure (IsLocalRing.ResidueField B₀)))]
    exact (map_ne_zero _).mpr hℓk

  obtain ⟨e, hne, R, hR, jR, hjR, hjRr, hcard⟩ :=
    wc_qmbt_xspl_xsp_split_quadric_card_transport hℓ hn hn4 hπ hc hx₀ hsh hπ' hπ'2 hgen
      hbl hblf hps'
  haveI := hR
  obtain ⟨hR2, hR3⟩ := wc_qxs_split_odd_quadric_top_counts _ ℓ hℓK e R jR hjR hjRr
  have hR1 := wc_qxs_split_odd_quadric_vanish _ ℓ (Fact.out : ℓ.Prime) hℓK e R jR hjR hjRr
  have hsubT : ∀ q, Subsingleton (wcEtCoh R ℓ q) → Subsingleton (wcEtCoh Xs' ℓ q) := by
    intro q hq
    obtain ⟨ZR⟩ := wc_et_zmodext_coh_equiv R ℓ q
    have h1 : Nat.card (wcEtCoh R ℓ q) = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hq, ⟨ZR 0⟩⟩
    exact (Nat.card_eq_one_iff_unique.mp ((hcard q).trans h1)).1
  have hX2 : Nat.card (wcEtCoh Xs' ℓ n) = ℓ := by
