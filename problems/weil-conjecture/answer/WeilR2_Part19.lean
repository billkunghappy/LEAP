        have h2 := (Scheme.Hom.mem_preimage L).mpr h1
        rw [hpre, hφ, MvPolynomial.aeval_X, ht, Proj.basicOpen_zero] at h2
        exact TopologicalSpace.Opens.mem_bot.mp h2
      · intro H
        haveI hpr : p.asHomogeneousIdeal.toIdeal.IsPrime := p.isPrime
        have hK : Ideal.span (MvPolynomial.X '' {t : Fin (e + 1 + 1) | g t = 0}) ≤
            p.asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨t, ht, rfl⟩
          exact H t ht
        obtain ⟨i, hi⟩ : ∃ i : Fin (e + 1 + 1),
