  have hA : ∀ (z : E.left) (y0 : Spec (.of (wcQmbtChartNone A' n c'))), g z ≠ e0 y0 := by
    intro z y0 hzy
    obtain ⟨i, hi⟩ := hcov z
    have hT := S2 r₁ (e i) e0 (φ i) φ0 (P9 i) P10 (wcQmbtGen A' n π' c' (some i))
      (wcQmbtGen A' n π' c' none) (wcQmdlCX A' n π' c' i none)
      (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X i)) (R2 i) (R3 i) (P3 i)
      (ψ i (⟨z, hi⟩ : wcQmdlV K hn jE i)) y0 ((hgpt i z hi).symm.trans hzy)
    apply hT
    refine (S1 _ _ (χ i) (ψ i) (hχ i).2.2.2.2 ⟨z, hi⟩ (wcQmdlCX A' n π' c' i none)).mpr ?_
    rw [(hχ i).1, map_zero]
    exact Ideal.zero_mem _

  have hB : ∀ (j : Fin n) (z : E.left) (y' : Spec (.of (wcQmbtChart A' n π' c' j))),
      g z = e j y' → z ∈ wcQmdlV K hn jE j := by
    intro j z y' hzy
    obtain ⟨i, hi⟩ := hcov z
    by_cases hij : i = j
    · subst hij; exact hi
    have hU := S2 r₁ (e i) (e j) (φ i) (φ j) (P9 i) (P9 j) (wcQmbtGen A' n π' c' (some i))
      (wcQmbtGen A' n π' c' (some j)) (wcQmdlCX A' n π' c' i (some j))
      (wcQmdlCX A' n π' c' j (some i)) (R1 i j (Ne.symm hij)) (R1 j i hij) (P3 i)
      (ψ i (⟨z, hi⟩ : wcQmdlV K hn jE i)) y' ((hgpt i z hi).symm.trans hzy)
    have h1 : IsUnit ((E.left.presheaf.germ (wcQmdlV K hn jE i) z hi).hom
        (χ i (wcQmdlCX A' n π' c' i (some j)))) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hm
      exact hU ((S1 _ _ (χ i) (ψ i) (hχ i).2.2.2.2 ⟨z, hi⟩ _).mpr hm)
    rw [(hχ i).2.2.1 j (Ne.symm hij), ← Scheme.mem_basicOpen E.left _ z hi,
      ← Scheme.preimage_basicOpen, (SGE _ _ _).2] at h1
    have h3 : jE z ∈ wcSgD K (n - 2 + 1) (wcQmdlIdx hn i) ⊓ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j) :=
      h1
    have h4 : jE z ∈ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j) :=
      SetLike.le_def.mp (inf_le_right (a := wcSgD K (n - 2 + 1) (wcQmdlIdx hn i))
        (b := wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))) h3
    exact h4

  have PSI : ∀ j, IsClosedImmersion (ψ j) := by
    intro j
    have hD : IsAffineOpen (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)) :=
      @Proj.isAffineOpen_basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (n - 2 + 1 + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X (wcQmdlIdx hn j)) 1
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K _)) one_pos
    haveI : IsAffine (wcQmdlV K hn jE j).toScheme := hD.preimage jE
    have hsurjχ : Function.Surjective (χ j) := by
      letI := (wcCnSigma E.hom (jE ⁻¹ᵁ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))).toAlgebra
      have hgen := DTC (n - 2 + 1) E jE hjE hjEY (wcQmdlIdx hn j)
      intro y
      have hy : y ∈ Algebra.adjoin K (Set.range fun p =>
          (jE.app (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))).hom
            (wcSgE K (n - 2 + 1) (wcQmdlIdx hn j) p)) := by
        rw [hgen]; exact Algebra.mem_top
      induction hy using Algebra.adjoin_induction with
      | mem x hx =>
        obtain ⟨p, rfl⟩ := hx
        by_cases hpj : (Fin.cast (by omega) p : Fin n) = j
        · have hp : p = wcQmdlIdx hn j := Fin.ext (by rw [← hpj]; rfl)
          refine ⟨1, ?_⟩
          rw [map_one, hp]
          beta_reduce
          rw [(SGE (n - 2 + 1) (wcQmdlIdx hn j) (wcQmdlIdx hn j)).1, map_one]
        · refine ⟨wcQmdlCX A' n π' c' j (some (Fin.cast (by omega) p)), ?_⟩
          rw [(hχ j).2.2.1 _ hpj]
          rfl
      | algebraMap c =>
        obtain ⟨x, hx⟩ := IsLocalRing.residue_surjective (σ.symm c)
        refine ⟨algebraMap A' _ x, ?_⟩
        rw [(hχ j).2.2.2.1 x, hx, RingEquiv.apply_symm_apply]
        rfl
      | add x y _ _ hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a + b, map_add _ _ _⟩
      | mul x y _ _ hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a * b, map_mul _ _ _⟩
    apply IsClosedImmersion.of_surjective_of_isAffine
    intro t
    obtain ⟨f, hf⟩ := hsurjχ ((wcQmdlV K hn jE j).topIso.hom t)
    refine ⟨(Scheme.ΓSpecIso _).inv.hom f, ?_⟩
    have h1 := (hχ j).2.2.2.2 f
    rw [hf] at h1
    exact h1.trans (Iso.hom_inv_id_apply (wcQmdlV K hn jE j).topIso t)

  let U : Option (Fin n) → X₁.Opens := fun k => Option.elim k e0.opensRange (fun j => (e j).opensRange)
  have hU : iSup U = ⊤ := by
    rw [eq_top_iff]
    rintro x -
    rw [TopologicalSpace.Opens.mem_iSup]
    rcases P11 x with ⟨y, hy⟩ | ⟨j, y, hy⟩
    · refine ⟨none, ?_⟩
      show x ∈ e0.opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨y, hy⟩
    · refine ⟨some j, ?_⟩
      show x ∈ (e j).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨y, hy⟩
  refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @IsClosedImmersion) U hU).mpr ?_
  intro k
  cases k with
  | none =>
    show IsClosedImmersion (g ∣_ e0.opensRange)
    haveI : IsEmpty (g ⁻¹ᵁ e0.opensRange).toScheme := by
      constructor
      rintro ⟨z, hz⟩
      have hz' : g z ∈ e0.opensRange := hz
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hz'
      obtain ⟨y, hy⟩ := hz'
      exact hA z y hy.symm
    exact IsClosedImmersion.instOfIsEmptyCarrierCarrierCommRingCat _
  | some j =>
    show IsClosedImmersion (g ∣_ (e j).opensRange)
    have hVg : wcQmdlV K hn jE j = g ⁻¹ᵁ (e j).opensRange := by
      ext z
      constructor
      · intro hz
        show g z ∈ (e j).opensRange
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        exact ⟨_, (hgpt j z hz).symm⟩
      · intro hz
        have hz' : g z ∈ (e j).opensRange := hz
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hz'
        obtain ⟨y, hy⟩ := hz'
        exact hB j z y hy.symm
    have key : g ∣_ (e j).opensRange =
        (E.left.isoOfEq hVg).inv ≫ ψ j ≫ (e j).isoOpensRange.hom := by
      rw [← cancel_mono ((e j).opensRange.ι), morphismRestrict_ι]
      simp only [Category.assoc]
      rw [Scheme.Hom.isoOpensRange_hom_ι, ← hg j, ← Scheme.isoOfEq_hom_ι E.left hVg]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [key]
    haveI := PSI j
    infer_instance

theorem wc_qmdl_range_sub {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0)
    {o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hoeq : o.asIdeal = Ideal.span (Set.range (wcQmbtGen A' n π' c')))
    (hmax : (Ideal.span (Set.range (wcQmbtGen A' n π' c'))).IsMaximal)
    {E : Scheme.{u}}
    (e₁ : E ⟶ Limits.pullback (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A'))
    (hz : ∀ z : E, ∃ (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' c' j))),
      Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') (e₁ z) = e j y ∧
        wcQmdlCX A' n π' c' j none ∈ y.asIdeal ∧ wcQmdlCX A' n π' c' j (some j) ∈ y.asIdeal ∧
        algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y.asIdeal) :
    Set.range e₁ ⊆ closure ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) z) ⁻¹' {o})ᶜ ∩
          (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) z) ⁻¹' {o} :=
by
  classical
  obtain ⟨hφX, hφA, -, -, -, -, -, -, he, -, -⟩ := hpkg
  haveI hfst : IsClosedImmersion (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')).flip
      (IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective)
  have himg : ∀ (j : Fin n) (q : Spec (.of (wcQmbtChart A' n π' c' j))),
      r₁ (e j q) = PrimeSpectrum.comap (φ j) q := by
    intro j q
    have h1 := Scheme.Hom.comp_apply (e j) r₁ q
    rw [← h1, he j, Spec.map_apply]
    rfl
  have hgen0 : ∀ j, φ j (wcQmbtGen A' n π' c' none) =
      algebraMap A' (wcQmbtChart A' n π' c' j) π' := by
    intro j
    show φ j (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') = _
    exact RingHom.congr_fun (hφA j) π'
  have hgenS : ∀ j p, φ j (wcQmbtGen A' n π' c' (some p)) =
      wcQmdlCX A' n π' c' j (some j) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (wcQmbtChartHat j p) := by
    intro j p
    show φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = _
    rw [hφX j p, map_mul]
  have hgenSj : ∀ j, φ j (wcQmbtGen A' n π' c' (some j)) = wcQmdlCX A' n π' c' j (some j) := by
    intro j
    rw [hgenS j j]
    simp [wcQmbtChartHat]
  have hto : ∀ (j : Fin n) (q : Spec (.of (wcQmbtChart A' n π' c' j))),
      wcQmdlCX A' n π' c' j (some j) ∈ q.asIdeal →
      algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ q.asIdeal → r₁ (e j q) = o := by
    intro j q hX hπ
    haveI := q.isPrime
    have hne : Ideal.comap (φ j) q.asIdeal ≠ ⊤ := (Ideal.comap_isPrime (φ j) q.asIdeal).ne_top
    rw [himg]
    apply PrimeSpectrum.ext
    change Ideal.comap (φ j) q.asIdeal = o.asIdeal
    rw [hoeq]
    have hle : Ideal.span (Set.range (wcQmbtGen A' n π' c')) ≤ Ideal.comap (φ j) q.asIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap]
      cases k with
      | none => rw [hgen0]; exact hπ
      | some p => rw [hgenS]; exact Ideal.mul_mem_right _ _ hX
    exact (hmax.eq_of_le hne hle).symm
  have hfrom : ∀ (j : Fin n) (q : Spec (.of (wcQmbtChart A' n π' c' j))),
      r₁ (e j q) = o → wcQmdlCX A' n π' c' j (some j) ∈ q.asIdeal := by
    intro j q h
    have hmem : wcQmbtGen A' n π' c' (some j) ∈ o.asIdeal := by
      rw [hoeq]; exact Ideal.subset_span ⟨some j, rfl⟩
    rw [← h, himg] at hmem
    have hmem' : φ j (wcQmbtGen A' n π' c' (some j)) ∈ q.asIdeal := hmem
    rw [hgenSj] at hmem'
    exact hmem'
  rintro _ ⟨z, rfl⟩
  obtain ⟨j, y, hy, hT, hX, hπy⟩ := hz z
  refine ⟨?_, ?_⟩
  · obtain ⟨p', hle, -, hπp, hXp⟩ := wc_qmbt_hl_chart_generize π' c' j y hT hX
    obtain ⟨q', hq'⟩ : ∃ q' : Spec (.of (wcQmbtChart A' n π' c' j)), q' = p' := ⟨p', rfl⟩
    subst hq'
    have hlift : (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (e j q') =
        wcQmSp A' (IsLocalRing.closedPoint (IsLocalRing.ResidueField A')) := by
      have h2 : wcQmSp A' (IsLocalRing.closedPoint (IsLocalRing.ResidueField A')) =
          IsLocalRing.closedPoint A' :=
        (Spec.map_apply _ _).trans (IsLocalRing.PrimeSpectrum.comap_residue A' _)
      rw [Scheme.Hom.comp_apply, himg, h2]
      refine (Spec.map_apply _ _).trans ?_
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))
        (Ideal.comap (φ j) q'.asIdeal) = IsLocalRing.maximalIdeal A'
      rw [Ideal.comap_comap, hφA j]
      haveI := q'.isPrime
      have hne : Ideal.comap (algebraMap A' (wcQmbtChart A' n π' c' j)) q'.asIdeal ≠ ⊤ :=
        (Ideal.comap_isPrime _ q'.asIdeal).ne_top
      have hle' : IsLocalRing.maximalIdeal A' ≤
          Ideal.comap (algebraMap A' (wcQmbtChart A' n π' c' j)) q'.asIdeal := by
        rw [hπ', Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]; exact hπp
      exact ((IsLocalRing.maximalIdeal.isMaximal A').eq_of_le hne hle').symm
    obtain ⟨w', hw'1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := r₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
      (g := wcQmSp A') (e j q') _ hlift
    have hw'F : w' ∈ ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map
        (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
        (wcQmSp A') ≫ r₁) z) ⁻¹' {o})ᶜ := by
      intro hw
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply] at hw
      rw [hw'1] at hw
      exact hXp (hfrom j q' hw)
    have hsp : w' ⤳ e₁ z := by
      have h1 : e j q' ⤳ e j y :=
        ((PrimeSpectrum.le_iff_specializes q' y).mp hle).map (e j).continuous
      rw [← hw'1, ← hy] at h1
      exact (IsClosedImmersion.isClosedEmbedding _).isInducing.specializes_iff.mp h1
    exact closure_mono (Set.singleton_subset_iff.mpr hw'F) hsp.mem_closure
  · simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
    rw [hy]
    exact hto j y hX hπy

theorem wc_qmdl_range_sup {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ}
    {c' : Matrix (Fin n) (Fin n) A'} {X₁ : Scheme.{u}}
    {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    {φ : ∀ j : Fin n, wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j}
    {φ0 : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c'}
    {e : ∀ j : Fin n, Spec (.of (wcQmbtChart A' n π' c' j)) ⟶ X₁}
    {e0 : Spec (.of (wcQmbtChartNone A' n c')) ⟶ X₁}
    (hpkg : wcQmdlChartPkg π' c' r₁ φ φ0 e e0)
    {o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hoeq : o.asIdeal = Ideal.span (Set.range (wcQmbtGen A' n π' c')))
    (hmax : (Ideal.span (Set.range (wcQmbtGen A' n π' c'))).IsMaximal)
    {E : Scheme.{u}}
    (e₁ : E ⟶ Limits.pullback (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A'))
    (hfib : ∀ (j : Fin n) (y : Spec (.of (wcQmbtChart A' n π' c' j))),
      wcQmdlCX A' n π' c' j none ∈ y.asIdeal → wcQmdlCX A' n π' c' j (some j) ∈ y.asIdeal →
      algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y.asIdeal →
      ∃ z : E, Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') (e₁ z) = e j y) :
    closure ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) z) ⁻¹' {o})ᶜ ∩
          (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) z) ⁻¹' {o} ⊆ Set.range e₁ :=
by
  classical
  unfold wcQmdlChartPkg at hpkg
  obtain ⟨P1, P2, -, -, P5, P6, P7, P8, P9, P10, P11⟩ := hpkg
  have hπm : π' ∈ IsLocalRing.maximalIdeal A' := by
    rw [hπ']; exact Ideal.mem_span_singleton_self π'
  have hπres : IsLocalRing.residue A' π' = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hπm
  haveI hfstci : IsClosedImmersion (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')).flip
      (IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective)
  have hfinj : Function.Injective (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) :=
    (Scheme.Hom.isClosedEmbedding _).toIsEmbedding.injective

  have key : ∀ {C : Type u} [CommRing C] [Algebra A' C]
      (φk : wcQuadModelRing A' n (π' ^ 2) c' →+* C)
      (_hφA : φk.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) = algebraMap A' C)
      (ek : Spec (.of C) ⟶ X₁) (_hek : ek ≫ r₁ = Spec.map (CommRingCat.ofHom φk))
      (w : ↥(Limits.pullback (C := Scheme.{u}) (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')))
      (y : Spec (.of C)),
      Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') w = ek y →
      algebraMap A' C π' ∈ y.asIdeal ∧
      ((Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ r₁) w = o ↔
        ∀ i, φk (wcQmbtGen A' n π' c' i) ∈ y.asIdeal) := by
    intro C _ _ φk hφA ek hek w y hw
    have hGI : ((Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ r₁) w).asIdeal =
        Ideal.comap φk y.asIdeal := by
      rw [Scheme.Hom.comp_apply, hw,
        show r₁ (ek y) = (ek ≫ r₁) y from (Scheme.Hom.comp_apply _ _ _).symm, hek,
        Spec.map_apply]
      rfl
    refine ⟨?_, ?_⟩
    · have hc : (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫
            (r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))) w =
          (Limits.pullback.snd (r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ wcQmSp A') w := by
        rw [Limits.pullback.condition]
      have h1 : π' ∈ ((Limits.pullback.snd (r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫
            wcQmSp A') w).asIdeal := by
        rw [Scheme.Hom.comp_apply, Spec.map_apply]
        have h0 := Ideal.zero_mem (Limits.pullback.snd (r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') w).asIdeal
        rw [← hπres] at h0
        exact h0
      rw [← hc, ← Category.assoc, Scheme.Hom.comp_apply, Spec.map_apply] at h1
      have h3 : algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π' ∈
          ((Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ r₁) w).asIdeal := h1
      rw [hGI, Ideal.mem_comap] at h3
      rw [← RingHom.congr_fun hφA π']
      exact h3
    · constructor
      · intro h i
        have hi : wcQmbtGen A' n π' c' i ∈ ((Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) w).asIdeal := by
          rw [h, hoeq]; exact Ideal.subset_span ⟨i, rfl⟩
        rw [hGI, Ideal.mem_comap] at hi
        exact hi
      · intro h
        apply PrimeSpectrum.ext
        rw [hoeq]
        have hle : Ideal.span (Set.range (wcQmbtGen A' n π' c')) ≤
            ((Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) w).asIdeal := by
          rw [hGI]
          exact Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact h i)
        exact (hmax.eq_of_le (PrimeSpectrum.isPrime _).ne_top hle).symm

  rintro w ⟨hwcl, hwF⟩
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hwF
  rw [mem_closure_iff] at hwcl
  rcases P11 (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') w) with
    ⟨y, hy⟩ | ⟨j, y, hy⟩
  ·
    exfalso
    haveI := P8
    have hO : IsOpen ((Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) ⁻¹' Set.range e0) :=
      ((Scheme.Hom.isOpenEmbedding e0).isOpenMap.isOpen_range).preimage
        (Scheme.Hom.continuous _)
    obtain ⟨w'', ⟨y'', hy''⟩, hw''F⟩ := hwcl _ hO ⟨y, hy⟩
    apply hw''F
    obtain ⟨hπy, hiff⟩ := key φ0 P6 e0 P10 w'' y'' hy''.symm
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    rw [hiff]
    rintro (_ | p)
    · show φ0 (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') ∈ y''.asIdeal
      rw [← RingHom.comp_apply, P6]
      exact hπy
    · show φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) ∈
        y''.asIdeal
      rw [P5, map_mul]
      exact Ideal.mul_mem_right _ _ hπy
  ·
    haveI := P7 j
    obtain ⟨hπy, hiff⟩ := key (φ j) (P2 j) (e j) (P9 j) w y hy.symm
    have hX : wcQmdlCX A' n π' c' j (some j) ∈ y.asIdeal := by
      have h0 := (hiff.mp hwF) (some j)
      have e1 : φ j (wcQmbtGen A' n π' c' (some j)) = wcQmdlCX A' n π' c' j (some j) := by
        show φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j)) = _
        rw [P1, wcQmbtChartHat, if_pos rfl, mul_one]
      rwa [e1] at h0
    have hXT : ∀ y' : Spec (.of (wcQmbtChart A' n π' c' j)),
        algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y'.asIdeal →
        wcQmdlCX A' n π' c' j none ∉ y'.asIdeal →
        wcQmdlCX A' n π' c' j (some j) ∈ y'.asIdeal := by
      intro y' hπ1 hT1
      have hrel : wcQmdlCX A' n π' c' j (some j) * wcQmdlCX A' n π' c' j none =
          algebraMap A' (wcQmbtChart A' n π' c' j) π' := by
        show Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) *
            Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) =
          Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.C π')
        rw [← map_mul, Ideal.Quotient.eq]
        exact Ideal.subset_span (Set.mem_insert _ _)
      rw [← hrel] at hπ1
      exact (y'.isPrime.mem_or_mem hπ1).resolve_right hT1
    have hF : ∀ (w' : ↥(Limits.pullback (C := Scheme.{u}) (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')))
        (y' : Spec (.of (wcQmbtChart A' n π' c' j))),
        Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') w' = e j y' →
        wcQmdlCX A' n π' c' j (some j) ∈ y'.asIdeal →
        (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ r₁) w' = o := by
      intro w' y' hw' hX'
      obtain ⟨hπy', hiff'⟩ := key (φ j) (P2 j) (e j) (P9 j) w' y' hw'
      rw [hiff']
      rintro (_ | p)
      · show φ j (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') ∈ y'.asIdeal
        rw [← RingHom.comp_apply, P2 j]
        exact hπy'
      · show φ j (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) ∈
          y'.asIdeal
        rw [P1, map_mul]
        exact Ideal.mul_mem_right _ _ hX'
    have hT : wcQmdlCX A' n π' c' j none ∈ y.asIdeal := by
      by_contra hT
      have hS : IsOpen {y' : Spec (.of (wcQmbtChart A' n π' c' j)) |
          wcQmdlCX A' n π' c' j none ∉ y'.asIdeal} :=
        PrimeSpectrum.isOpen_basicOpen (a := wcQmdlCX A' n π' c' j none)
      have hU := (Scheme.Hom.isOpenEmbedding (e j)).isOpenMap _ hS
      have hW := hU.preimage (Scheme.Hom.continuous (Limits.pullback.fst (r₁ ≫ Spec.map
        (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')))
      obtain ⟨w'', ⟨y'', hy''T, hy''⟩, hw''F⟩ := hwcl _ hW ⟨y, hT, hy⟩
      apply hw''F
      obtain ⟨hπ'', -⟩ := key (φ j) (P2 j) (e j) (P9 j) w'' y'' hy''.symm
      exact hF w'' y'' hy''.symm (hXT y'' hπ'' hy''T)
    obtain ⟨z, hz⟩ := hfib j y hT hX hπy
    exact ⟨z, hfinj (hz.trans hy)⟩

theorem wc_qmdl_spec_point_mem {X : Scheme.{u}} (V : X.Opens) (C : CommRingCat.{u})
    (χ : C →+* Γ(X, V)) (ψ : V.toScheme ⟶ Spec C)
    (hψ : ∀ f : C, ψ.appTop.hom ((Scheme.ΓSpecIso C).inv.hom f) = V.topIso.inv.hom (χ f))
    (z : V) (f : C) :
    f ∈ (ψ z).asIdeal ↔
      (X.presheaf.germ V z.1 z.2).hom (χ f) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z.1) :=
by
  rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, ← Scheme.mem_basicOpen X (χ f) z.1 z.2]
  have hD : (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv.hom f) = PrimeSpectrum.basicOpen f :=
    basicOpen_eq_of_affine f
  have h1 : f ∉ (ψ z).asIdeal ↔
      z ∈ ψ ⁻¹ᵁ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv.hom f) := by
    have e : z ∈ ψ ⁻¹ᵁ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv.hom f) ↔
        ψ z ∈ (Spec C).basicOpen ((Scheme.ΓSpecIso C).inv.hom f) := Iff.rfl
    rw [e, hD]
    exact (PrimeSpectrum.mem_basicOpen f (ψ z)).symm
  rw [h1, Scheme.Hom.preimage_basicOpen_top, hψ]
  have h2 := V.ι.preimage_image_eq ((V : Scheme).basicOpen (V.topIso.inv.hom (χ f)))
  rw [Scheme.Opens.ι_image_basicOpen_topIso_inv] at h2
  rw [← h2]
  exact Iff.rfl

theorem wc_qmdl_cfs_on_quadric (K : Type u) [Field K] (N : ℕ) (V : Scheme.{u})
    (fV : V ⟶ Spec (.of K)) (t : Fin (N + 1) → Γ(V, ⊤))
    (w : Fin (N + 1) → Fin (N + 1) → K)
    (hq : ∑ p, ∑ q, fV.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (w p q)) * t p * t q = 0)
    (φ : V ⟶ wcProjK K N) (hφ : φ ≫ wcProjKStr K N = fV)
    (hbo : ∀ J, φ ⁻¹ᵁ wcSgD K N J = V.basicOpen (t J))
    (hrel : ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K N J),
        φ.appLE (wcSgD K N J) O hO (wcSgE K N J L) *
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
        V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L)) :
    ∀ (x : V) (c : Fin (N + 1)) (hc : φ x ∈ wcSgD K N c),
      ((wcProjK K N).presheaf.germ (wcSgD K N c) (φ x) hc).hom
          (wcLdpSec K N (wcLdpQuad K N w) c) ∈
        IsLocalRing.maximalIdeal ((wcProjK K N).presheaf.stalk (φ x)) :=
by
  intro x c hc

  have hsec : wcLdpSec K N (wcLdpQuad K N w) c =
      ∑ p, ∑ q, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X c)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X c))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) (w p q))) *
        wcSgE K N c p * wcSgE K N c q := by
    have hcv : ∀ k : K, (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers (MvPolynomial.X c))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) k)).val =
        Localization.mk (MvPolynomial.C k) 1 := by
      intro k
      rfl
    unfold wcLdpSec wcSgE
    simp only [← map_mul, ← map_sum]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply]
    simp only [map_sum, map_mul, HomogeneousLocalization.algebraMap_apply, hcv,
      HomogeneousLocalization.Away.val_mk]
    unfold wcLdpQuad
    simp only [Localization.mk_sum]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    rw [Localization.mk_mul, Localization.mk_mul, Localization.mk_eq_mk_iff,
      Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_mul, Submonoid.coe_one, OneMemClass.coe_one]
    ring

  have hconst : ∀ k : K, ((wcProjK K N).presheaf.germ (wcSgD K N c) (φ x) hc).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X c)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X c))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) k))) =
      wcLdpConst K (wcProjKStr K N) (φ x) k := by
    intro k
    have f_deg : (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)
    have h1 : (wcSgD K N c).ι =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X c) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c)
            f_deg one_pos := by
      rw [← Proj.basicOpenIsoSpec_hom _ _ f_deg one_pos,
        ← Proj.basicOpenIsoSpec_inv_ι _ _ f_deg one_pos, Iso.hom_inv_id_assoc]
    have h2 : (wcSgD K N c).ι ≫ wcProjKStr K N =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X c) ≫
          Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              (Submonoid.powers (MvPolynomial.X c)))) := by
      rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ f_deg one_pos]
      simp only [wcProjKStr, Category.assoc]
    have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X c)).appTop =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c)))).hom ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X c) ≫
          (wcSgD K N c).topIso.inv :=
      Proj.basicOpenToSpec_app_top _ _
    have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K N).appTop ≫
          (wcSgD K N c).ι.appTop =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X c))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X c) ≫
          (wcSgD K N c).topIso.inv := by
      rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, h4]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have h3 : (wcSgD K N c).ι.appTop ≫ (wcSgD K N c).topIso.hom =
        (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N c ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      first
        | (erw [← Functor.map_comp]; rfl)
        | (simp only [← Functor.map_comp]; rfl)
        | exact ((wcProjK K N).presheaf.map_comp _ _).symm
    have H' : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K N).appTop ≫
          (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N c ≤ ⊤)).op =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (Submonoid.powers (MvPolynomial.X c))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X c) := by
      rw [← h3, reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
    have e := congrArg (fun ψ => ψ.hom k) H'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
    have hg := congrArg (fun ψ => ψ.hom ((wcProjKStr K N).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom k)))
      (TopCat.Presheaf.germ_res (wcProjK K N).presheaf (homOfLE (le_top : wcSgD K N c ≤ ⊤))
        (φ x) hc)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hg
    rw [← e]
    exact hg

  let SG : Γ(wcProjK K N, wcSgD K N c) →+* V.presheaf.stalk x :=
    (φ.stalkMap x).hom.comp ((wcProjK K N).presheaf.germ (wcSgD K N c) (φ x) hc).hom
  have hpush : ∀ y, SG y = (V.presheaf.germ (φ ⁻¹ᵁ wcSgD K N c) x hc).hom
      ((φ.app (wcSgD K N c)).hom y) := fun y =>
    Scheme.Hom.germ_stalkMap_apply φ (wcSgD K N c) x hc y
  have hpushTop : ∀ y, (φ.stalkMap x).hom (((wcProjK K N).presheaf.germ ⊤ (φ x) trivial).hom y) =
      (V.presheaf.germ ⊤ x trivial).hom (φ.appTop.hom y) := fun y =>
    Scheme.Hom.germ_stalkMap_apply φ ⊤ x trivial y

  have hk : ∀ k : K, SG ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X c)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X c))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) k))) =
      (V.presheaf.germ ⊤ x trivial).hom (fV.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom k)) := by
    intro k
    show (φ.stalkMap x).hom (((wcProjK K N).presheaf.germ (wcSgD K N c) (φ x) hc).hom _) = _
    rw [hconst k]
    simp only [wcLdpConst, RingHom.comp_apply]
    rw [hpushTop, ← hφ]
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, wcProjKStr]

  have hcoord : ∀ p, SG (wcSgE K N c p) * (V.presheaf.germ ⊤ x trivial).hom (t c) =
      (V.presheaf.germ ⊤ x trivial).hom (t p) := by
    intro p
    have h := hrel c p (φ ⁻¹ᵁ wcSgD K N c) le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h
    have h' := congrArg (V.presheaf.germ (φ ⁻¹ᵁ wcSgD K N c) x hc).hom h
    have hres : ∀ z : Γ(V, ⊤), (V.presheaf.germ (φ ⁻¹ᵁ wcSgD K N c) x hc).hom
        (V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcSgD K N c ≤ ⊤)).op z) =
        (V.presheaf.germ ⊤ x trivial).hom z := fun z =>
      TopCat.Presheaf.germ_res_apply V.presheaf (homOfLE le_top) x hc z
    rw [map_mul, hres, hres] at h'
    rw [hpush]
    exact h'

  have hu : IsUnit ((V.presheaf.germ ⊤ x trivial).hom (t c)) := by
    have hx : x ∈ V.basicOpen (t c) := by
      rw [← hbo c]
      exact hc
    exact (Scheme.mem_basicOpen_top V (t c) x).mp hx

  have key : SG (wcLdpSec K N (wcLdpQuad K N w) c) *
      ((V.presheaf.germ ⊤ x trivial).hom (t c) * (V.presheaf.germ ⊤ x trivial).hom (t c)) =
      (V.presheaf.germ ⊤ x trivial).hom
        (∑ p, ∑ q, fV.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (w p q)) * t p * t q) := by
    rw [hsec, map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul, map_mul, map_mul, ← hk (w p q), ← hcoord p, ← hcoord q]
    ring
  rw [hq, map_zero] at key
  have hZ : SG (wcLdpSec K N (wcLdpQuad K N w) c) = 0 := (hu.mul hu).mul_left_eq_zero.mp key

  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hunit
  have hm := hunit.map (φ.stalkMap x).hom
  change IsUnit (SG (wcLdpSec K N (wcLdpQuad K N w) c)) at hm
  rw [hZ] at hm
  exact not_isUnit_zero hm

theorem wc_qmdl_cfs_quad_rel {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'} {n : ℕ}
    (hn : 4 ≤ n) (c' : Matrix (Fin n) (Fin n) A') {K : Type u} [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (j : Fin n) (I : Ideal (wcQmbtChart A' n π' c' j))
    (hT : wcQmdlCX A' n π' c' j none ∈ I) (κ : K →+* wcQmbtChart A' n π' c' j ⧸ I)
    (hκ : ∀ x : A', κ (σ (IsLocalRing.residue A' x)) =
      Ideal.Quotient.mk I (algebraMap A' (wcQmbtChart A' n π' c' j) x)) :
    ∑ p : Fin (n - 2 + 1 + 1), ∑ q : Fin (n - 2 + 1 + 1), κ (wcQmdlA hn c' σ p q) *
        Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (wcQmbtChartHat j (Fin.cast (by omega) p))) *
        Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (wcQmbtChartHat j (Fin.cast (by omega) q))) = 0 :=
by
  classical
  have hm : n - 2 + 1 + 1 = n := by omega
  set Φ : MvPolynomial (Option (Fin n)) A' →+* wcQmbtChart A' n π' c' j ⧸ I :=
    (Ideal.Quotient.mk I).comp (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)) with hΦ
  have h1 : ∀ p q : Fin (n - 2 + 1 + 1), κ (wcQmdlA hn c' σ p q) *
        Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (wcQmbtChartHat j (Fin.cast hm p))) *
        Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (wcQmbtChartHat j (Fin.cast hm q))) =
      Φ (MvPolynomial.C (c' (Fin.cast hm p) (Fin.cast hm q)) *
        wcQmbtChartHat j (Fin.cast hm p) * wcQmbtChartHat j (Fin.cast hm q)) := by
    intro p q
    have hc : κ (wcQmdlA hn c' σ p q) =
        Φ (MvPolynomial.C (c' (Fin.cast hm p) (Fin.cast hm q))) := by
      show κ (σ (IsLocalRing.residue A' (c' (Fin.cast hm p) (Fin.cast hm q)))) = _
      rw [hκ]
      rfl
    rw [map_mul, map_mul, hc]
    rfl
  have h2 : ∀ g : Fin n → Fin n → wcQmbtChart A' n π' c' j ⧸ I,
      ∑ p : Fin (n - 2 + 1 + 1), ∑ q : Fin (n - 2 + 1 + 1), g (Fin.cast hm p) (Fin.cast hm q) =
        ∑ a, ∑ b, g a b := by
    intro g
    exact (Fin.sum_congr' (fun a => ∑ q : Fin (n - 2 + 1 + 1), g a (Fin.cast hm q)) hm).trans
      (Finset.sum_congr rfl (fun a _ => Fin.sum_congr' (g a) hm))
  refine (Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => h1 p q))).trans ?_
  refine (h2 (fun a b => Φ (MvPolynomial.C (c' a b) * wcQmbtChartHat j a *
    wcQmbtChartHat j b))).trans ?_
  have hG : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
      (∑ a, ∑ b, MvPolynomial.C (c' a b) * wcQmbtChartHat j a * wcQmbtChartHat j b) =
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none ^ 2) := by
    apply Ideal.Quotient.eq.mpr
    apply Ideal.subset_span
    first
      | exact Set.mem_insert_of_mem _ rfl
      | exact Set.mem_insert _ _
      | simp
  have hT' : Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
      (MvPolynomial.X none)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hT
  have hfin : Φ (∑ a, ∑ b, MvPolynomial.C (c' a b) * wcQmbtChartHat j a *
      wcQmbtChartHat j b) = 0 := by
    have e1 : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none ^ 2) =
        wcQmdlCX A' n π' c' j none ^ 2 := map_pow _ _ _
    have e2 : Ideal.Quotient.mk I (wcQmdlCX A' n π' c' j none ^ 2) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (I.pow_mem_of_mem hT 2 two_pos)
    show Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
      (∑ a, ∑ b, MvPolynomial.C (c' a b) * wcQmbtChartHat j a * wcQmbtChartHat j b)) = 0
    rw [hG, e1]
    exact e2
  rw [← hfin, map_sum]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  rw [map_sum]

theorem wc_qmdl_cfs_lift {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'} {n : ℕ}
    (hn : 4 ≤ n) (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Over (Spec (.of K)))
    (jE : E.left ⟶ wcProjK K (n - 2 + 1)) (hjEY : jE ≫ wcProjKStr K (n - 2 + 1) = E.hom)
    (j : Fin n) (χ : wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j))
    (ψ : (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : wcQmdlChiPkg π' hn c' σ E jE j χ ψ) (I : Ideal (wcQmbtChart A' n π' c' j))
    (hT : wcQmdlCX A' n π' c' j none ∈ I) (hX : wcQmdlCX A' n π' c' j (some j) ∈ I)
    (κ : K →+* wcQmbtChart A' n π' c' j ⧸ I)
    (hκ : ∀ x : A', κ (σ (IsLocalRing.residue A' x)) =
      Ideal.Quotient.mk I (algebraMap A' (wcQmbtChart A' n π' c' j) x))
    (φ : Spec (.of (wcQmbtChart A' n π' c' j ⧸ I)) ⟶ wcProjK K (n - 2 + 1))
    (hφ : φ ≫ wcProjKStr K (n - 2 + 1) = Spec.map (CommRingCat.ofHom κ))
    (htop : ⊤ ≤ φ ⁻¹ᵁ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))
    (hrel : ∀ L : Fin (n - 2 + 1 + 1),
      (φ.appLE (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)) ⊤ htop).hom
          (wcSgE K (n - 2 + 1) (wcQmdlIdx hn j) L) =
        (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ I))).inv.hom
          (Ideal.Quotient.mk I (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (wcQmbtChartHat j (Fin.cast (by omega) L))))) :
    ∀ f : wcQmbtChart A' n π' c' j,
      ∃ a : Γ(wcProjK K (n - 2 + 1), wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)),
        χ f = (jE.app (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j))).hom a ∧
        Ideal.Quotient.mk I f = (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ I))).hom
          ((φ.appLE (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)) ⊤ htop).hom a) :=
by
  classical
  obtain ⟨hC1, hC2, hC3, hC4, -⟩ := hχ

  have s1 : ∀ {X Y : Scheme.{u}} {R : CommRingCat.{u}} (g : X ⟶ Y)
      (sY : Y ⟶ Spec R) (sX : X ⟶ Spec R) (_hs : g ≫ sY = sX) (U : Y.Opens) (V : X.Opens)
      (e : V ≤ g ⁻¹ᵁ U) (r : Γ(Spec R, ⊤)),
      (g.appLE U V e).hom ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (sY.appTop.hom r)) =
        (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (sX.appTop.hom r) := by
    intro X Y R g sY sX hs U V e r
    subst hs
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE, Scheme.Hom.comp_appTop,
      CommRingCat.comp_apply, Scheme.Hom.appLE, CommRingCat.comp_apply]
    rfl
  let C := wcQmbtChart A' n π' c' j
  let U := wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)
  let jA : Γ(wcProjK K (n - 2 + 1), U) →+* Γ(E.left, wcQmdlV K hn jE j) := (jE.app U).hom
  let α : Γ(wcProjK K (n - 2 + 1), U) →+* C ⧸ I :=
    (Scheme.ΓSpecIso (.of (C ⧸ I))).hom.hom.comp (φ.appLE U ⊤ htop).hom
  let G : Subring C :=
    { carrier := {f | ∃ a, jA a = χ f ∧ α a = Ideal.Quotient.mk I f}
      mul_mem' := by
        rintro f g ⟨a, ha1, ha2⟩ ⟨b, hb1, hb2⟩
        exact ⟨a * b, by rw [map_mul, map_mul, ha1, hb1], by rw [map_mul, map_mul, ha2, hb2]⟩
      one_mem' := ⟨1, by rw [map_one, map_one], by rw [map_one, map_one]⟩
      add_mem' := by
        rintro f g ⟨a, ha1, ha2⟩ ⟨b, hb1, hb2⟩
        exact ⟨a + b, by rw [map_add, map_add, ha1, hb1], by rw [map_add, map_add, ha2, hb2]⟩
      zero_mem' := ⟨0, by rw [map_zero, map_zero], by rw [map_zero, map_zero]⟩
      neg_mem' := by
        rintro f ⟨a, ha1, ha2⟩
        exact ⟨-a, by rw [map_neg, map_neg, ha1], by rw [map_neg, map_neg, ha2]⟩ }
  have hmem : ∀ f : C, f ∈ G ↔ ∃ a, jA a = χ f ∧ α a = Ideal.Quotient.mk I f := by
    intro f
    rfl
  have hgen : ∀ i, wcQmdlCX A' n π' c' j i ∈ G := by
    intro i
    rw [hmem]
    rcases i with _ | p
    · refine ⟨0, ?_, ?_⟩
      · rw [map_zero, hC1]
      · rw [map_zero]; exact ((Ideal.Quotient.eq_zero_iff_mem).mpr hT).symm
    · by_cases hp : p = j
      · rw [hp]
        refine ⟨0, ?_, ?_⟩
        · rw [map_zero, hC2]
        · rw [map_zero]; exact ((Ideal.Quotient.eq_zero_iff_mem).mpr hX).symm
      · refine ⟨wcSgE K (n - 2 + 1) (wcQmdlIdx hn j) (wcQmdlIdx hn p), (hC3 p hp).symm, ?_⟩
        show (Scheme.ΓSpecIso _).hom.hom ((φ.appLE U ⊤ htop).hom _) = _
        rw [hrel, CommRingCat.hom_inv_apply]
        congr 2
        have e : (Fin.cast (by omega) (wcQmdlIdx hn p) : Fin n) = p := Fin.ext rfl
        rw [e]
        simp [wcQmbtChartHat, hp]
  have hall : ∀ f : C, f ∈ G := by
    intro f
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective f
    induction P using MvPolynomial.induction_on with
    | C x =>
      rw [hmem]
      have hx : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.C x) =
          algebraMap A' C x := rfl
      rw [hx]
      refine ⟨((wcProjK K (n - 2 + 1)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        ((wcProjKStr K (n - 2 + 1)).appTop.hom
          ((Scheme.ΓSpecIso (.of K)).inv.hom (σ (IsLocalRing.residue A' x)))), ?_, ?_⟩
      · rw [hC4]
        show (jE.app U).hom _ = _
        rw [Scheme.Hom.app_eq_appLE, s1 jE _ _ hjEY]
        rfl
      · show (Scheme.ΓSpecIso _).hom.hom ((φ.appLE U ⊤ htop).hom _) = _
        rw [s1 φ _ _ hφ, ← hκ x]
        rw [show homOfLE (le_top : (⊤ : (Spec (CommRingCat.of (C ⧸ I))).Opens) ≤ ⊤) = 𝟙 _ from
          Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id, CommRingCat.id_apply,
          ← CommRingCat.comp_apply, Scheme.ΓSpecIso_naturality, CommRingCat.comp_apply,
          CommRingCat.hom_inv_apply]
        rfl
    | add p q hp hq =>
      rw [map_add]
      exact G.add_mem hp hq
    | mul_X p i hp =>
      rw [map_mul]
      exact G.mul_mem hp (hgen i)
  intro f
  obtain ⟨a, h1, h2⟩ := (hmem f).1 (hall f)
  exact ⟨a, h1.symm, h2.symm⟩

theorem wc_qmdl_cfs_common_point_mem {P E : Scheme.{u}} (U : P.Opens) (jE : E ⟶ P)
    {R : CommRingCat.{u}} (φ : Spec R ⟶ P) (hW : ⊤ ≤ φ ⁻¹ᵁ U) (z₀ : E) (w : Spec R)
    (hz : jE z₀ = φ w) (hz₀ : z₀ ∈ jE ⁻¹ᵁ U) (a : Γ(P, U)) :
    (E.presheaf.germ (jE ⁻¹ᵁ U) z₀ hz₀).hom ((jE.app U).hom a) ∈
        IsLocalRing.maximalIdeal (E.presheaf.stalk z₀) ↔
      (Scheme.ΓSpecIso R).hom ((φ.appLE U ⊤ hW).hom a) ∈ w.asIdeal :=
by
  have hL : (E.presheaf.germ (jE ⁻¹ᵁ U) z₀ hz₀).hom ((jE.app U).hom a) ∈
        IsLocalRing.maximalIdeal (E.presheaf.stalk z₀) ↔ jE z₀ ∉ P.basicOpen a := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      ← Scheme.mem_basicOpen E ((jE.app U).hom a) z₀ hz₀, ← Scheme.Hom.preimage_basicOpen]
    rfl
  have h1 : (Spec R).basicOpen ((φ.appLE U ⊤ hW).hom a) = ⊤ ⊓ φ ⁻¹ᵁ P.basicOpen a :=
    Scheme.basicOpen_appLE ..
  have h2 : w ∈ (Spec R).basicOpen ((φ.appLE U ⊤ hW).hom a) ↔ φ w ∈ P.basicOpen a := by
    rw [h1]
    exact ⟨fun h => h.2, fun h => ⟨trivial, h⟩⟩
  have h3 : w ∈ (Spec R).basicOpen ((φ.appLE U ⊤ hW).hom a) ↔
      (Scheme.ΓSpecIso R).hom ((φ.appLE U ⊤ hW).hom a) ∉ w.asIdeal := by
    rw [basicOpen_eq_of_affine']
    exact PrimeSpectrum.mem_basicOpen _ _
  rw [hL, hz, ← h2, h3, not_not]

theorem wc_qmdl_chart_fibre_surj {A' : Type u} [CommRing A'] [IsLocalRing A'] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ} (hn : 4 ≤ n)
    (c' : Matrix (Fin n) (Fin n) A') (K : Type u) [Field K]
    (σ : IsLocalRing.ResidueField A' ≃+* K) (E : Over (Spec (.of K)))
    (jE : E.left ⟶ wcProjK K (n - 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (n - 2 + 1) = E.hom)
    (hEall : ∀ p : wcProjK K (n - 2 + 1), (∀ (c : Fin (n - 2 + 1 + 1))
        (hp : p ∈ wcSgD K (n - 2 + 1) c),
        ((wcProjK K (n - 2 + 1)).presheaf.germ (wcSgD K (n - 2 + 1) c) p hp).hom
            (wcLdpSec K (n - 2 + 1) (wcLdpQuad K (n - 2 + 1) (wcQmdlA hn c' σ)) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (n - 2 + 1)).presheaf.stalk p)) →
      p ∈ Set.range jE)
    (j : Fin n) (χ : wcQmbtChart A' n π' c' j →+* Γ(E.left, wcQmdlV K hn jE j))
    (ψ : (wcQmdlV K hn jE j).toScheme ⟶ Spec (.of (wcQmbtChart A' n π' c' j)))
    (hχ : wcQmdlChiPkg π' hn c' σ E jE j χ ψ) :
    ∀ y : Spec (.of (wcQmbtChart A' n π' c' j)),
      wcQmdlCX A' n π' c' j none ∈ y.asIdeal → wcQmdlCX A' n π' c' j (some j) ∈ y.asIdeal →
      algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ y.asIdeal →
      ∃ z : wcQmdlV K hn jE j, ψ z = y :=
by
  classical
  intro y hyT hyX hyπ

  obtain ⟨J, hJ⟩ : ∃ J : Ideal (wcQmbtChart A' n π' c' j), J = Ideal.span
      {wcQmdlCX A' n π' c' j none, wcQmdlCX A' n π' c' j (some j),
        algebraMap A' (wcQmbtChart A' n π' c' j) π'} := ⟨_, rfl⟩
  have hTJ : wcQmdlCX A' n π' c' j none ∈ J := by
    rw [hJ]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hXJ : wcQmdlCX A' n π' c' j (some j) ∈ J := by
    rw [hJ]; exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
  have hπJ : algebraMap A' (wcQmbtChart A' n π' c' j) π' ∈ J := by
    rw [hJ]; exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
  have hJy : J ≤ y.asIdeal := by
    rw [hJ, Ideal.span_le]
    intro x hx
    rcases hx with rfl | rfl | rfl
    · exact hyT
    · exact hyX
    · exact hyπ

  have hker : ∀ a ∈ IsLocalRing.maximalIdeal A',
      ((Ideal.Quotient.mk J).comp (algebraMap A' (wcQmbtChart A' n π' c' j))) a = 0 := by
    intro a ha
    rw [hπ', Ideal.mem_span_singleton] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
    exact J.mul_mem_right _ hπJ
  let κ₀ : IsLocalRing.ResidueField A' →+* (wcQmbtChart A' n π' c' j ⧸ J) :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal A')
      ((Ideal.Quotient.mk J).comp (algebraMap A' (wcQmbtChart A' n π' c' j))) hker
  obtain ⟨κ, hκ⟩ : ∃ κ : K →+* (wcQmbtChart A' n π' c' j ⧸ J), ∀ x : A',
      κ (σ (IsLocalRing.residue A' x)) =
        Ideal.Quotient.mk J (algebraMap A' (wcQmbtChart A' n π' c' j) x) := by
    refine ⟨κ₀.comp σ.symm.toRingHom, fun x => ?_⟩
    change κ₀ (σ.symm (σ (IsLocalRing.residue A' x))) = _
    rw [RingEquiv.symm_apply_apply]
    exact Ideal.Quotient.lift_mk _ _ _

  obtain ⟨t, ht_def⟩ : ∃ t : Fin (n - 2 + 1 + 1) →
      Γ(Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)), ⊤), ∀ L, t L =
        (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom
          (Ideal.Quotient.mk J (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (wcQmbtChartHat j (Fin.cast (by omega) L)))) := ⟨_, fun _ => rfl⟩
  have ht1 : t (wcQmdlIdx hn j) = 1 := by
    rw [ht_def]
    have hc : (Fin.cast (by omega) (wcQmdlIdx hn j) : Fin n) = j := Fin.ext rfl
    rw [hc]
    simp [wcQmbtChartHat]
  have ht : Ideal.span (Set.range t) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨wcQmdlIdx hn j, ht1⟩) isUnit_one

  obtain ⟨φ, hφ, hbo, hrel₀⟩ := wc_ldpi_oai_proj_lift K (n - 2 + 1)
    (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))) (Spec.map (CommRingCat.ofHom κ)) t ht
  have htop : ⊤ ≤ φ ⁻¹ᵁ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j) := by
    have h1 : (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).basicOpen
        (t (wcQmdlIdx hn j)) = ⊤ := by
      rw [ht1]; exact Scheme.basicOpen_of_isUnit _ isUnit_one
    rw [hbo, h1] <;> exact le_rfl
  have hid : ∀ s : Γ(Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)), ⊤),
      (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).presheaf.map
        (homOfLE (le_top : (⊤ : (Spec (CommRingCat.of
          (wcQmbtChart A' n π' c' j ⧸ J))).Opens) ≤ ⊤)).op s = s := by
    intro s
    rw [show homOfLE (le_top : (⊤ : (Spec (CommRingCat.of
        (wcQmbtChart A' n π' c' j ⧸ J))).Opens) ≤ ⊤) = 𝟙 _ from Subsingleton.elim _ _,
      op_id, CategoryTheory.Functor.map_id]
    rfl
  have hrel : ∀ L : Fin (n - 2 + 1 + 1),
      (φ.appLE (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)) ⊤ htop).hom
          (wcSgE K (n - 2 + 1) (wcQmdlIdx hn j) L) =
        (Scheme.ΓSpecIso (.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom
          (Ideal.Quotient.mk J (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
            (wcQmbtChartHat j (Fin.cast (by omega) L)))) := by
    intro L
    have h := hrel₀ (wcQmdlIdx hn j) L ⊤ htop
    rw [ht1, hid, hid, mul_one, ht_def] at h
    exact h

  have hkerq : RingHom.ker (Ideal.Quotient.mk J) ≤ y.asIdeal := by
    rw [Ideal.mk_ker]; exact hJy
  haveI : y.asIdeal.IsPrime := y.isPrime
  let ybar : Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)) :=
    (⟨Ideal.map (Ideal.Quotient.mk J) y.asIdeal,
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hkerq⟩ :
        PrimeSpectrum (wcQmbtChart A' n π' c' j ⧸ J))
  have hstar : ∀ f, Ideal.Quotient.mk J f ∈ Ideal.map (Ideal.Quotient.mk J) y.asIdeal ↔
      f ∈ y.asIdeal := by
    intro f
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective,
      sup_eq_left.mpr hkerq]

  have hnat : ∀ k : K, (Spec.map (CommRingCat.ofHom κ)).appTop.hom
      ((Scheme.ΓSpecIso (.of K)).inv.hom k) =
      (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom (κ k) := by
    intro k
    have h := Scheme.ΓSpecIso_inv_naturality (R := CommRingCat.of K)
      (S := CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J)) (CommRingCat.ofHom κ)
    have h2 := congrArg (fun g => g.hom k) h
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    exact h2.symm
  have hq : ∑ p, ∑ q, (Spec.map (CommRingCat.ofHom κ)).appTop.hom
      ((Scheme.ΓSpecIso (.of K)).inv.hom (wcQmdlA hn c' σ p q)) * t p * t q = 0 := by
    have e := congrArg
      (fun x => (Scheme.ΓSpecIso (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))).inv.hom x)
      (wc_qmdl_cfs_quad_rel hn c' σ j J hTJ κ hκ)
    simp only [map_zero, map_sum] at e
    rw [← e]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul, hnat, ht_def, ht_def]
  have hon := wc_qmdl_cfs_on_quadric K (n - 2 + 1)
    (Spec (CommRingCat.of (wcQmbtChart A' n π' c' j ⧸ J))) (Spec.map (CommRingCat.ofHom κ)) t
    (wcQmdlA hn c' σ) hq φ hφ hbo hrel₀ ybar

  obtain ⟨z₀, hz⟩ := hEall (φ ybar) hon
  have hz₀ : z₀ ∈ jE ⁻¹ᵁ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j) := by
    have h1 : ybar ∈ φ ⁻¹ᵁ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j) := htop trivial
    rw [Scheme.Hom.mem_preimage] at h1 ⊢
    rw [hz]; exact h1

  refine ⟨⟨z₀, hz₀⟩, ?_⟩
  apply PrimeSpectrum.ext
  ext f
  obtain ⟨a, ha1, ha2⟩ := wc_qmdl_cfs_lift hn c' K σ E jE hjEY j χ ψ hχ J hTJ hXJ κ hκ φ hφ
    htop hrel f
  refine (wc_qmdl_spec_point_mem (wcQmdlV K hn jE j)
    (CommRingCat.of (wcQmbtChart A' n π' c' j)) χ ψ hχ.2.2.2.2 ⟨z₀, hz₀⟩ f).trans ?_
  change (E.left.presheaf.germ (jE ⁻¹ᵁ wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)) z₀ hz₀).hom (χ f) ∈
      IsLocalRing.maximalIdeal (E.left.presheaf.stalk z₀) ↔ f ∈ y.asIdeal
  rw [ha1]
  refine (wc_qmdl_cfs_common_point_mem (wcSgD K (n - 2 + 1) (wcQmdlIdx hn j)) jE φ htop z₀ ybar
    hz hz₀ a).trans ?_
  rw [← ha2]
  exact hstar f

theorem wc_qmbt_qm_model_double_locus {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ} (hn : 4 ≤ n)
    {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det)
    {X₁ : Scheme.{u}} {r₁ : X₁ ⟶ Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c'))).inv.hom
          (wcQmbtGen A' n π' c' k)))) r₁)
    {o : Spec (.of (wcQuadModelRing A' n (π' ^ 2) c'))}
    (ho : ∀ k, wcQmbtGen A' n π' c' k ∈ o.asIdeal)
    (K : Type u) [Field K] (σ : IsLocalRing.ResidueField A' ≃+* K) :
    ∃ (E₀ : Over (Spec (.of K))) (_ : IsProper E₀.hom)
      (_ : SmoothOfRelativeDimension (n - 2) E₀.hom)
      (jE : E₀.left ⟶ wcProjK K (n - 2 + 1)),
      IsClosedImmersion jE ∧ jE ≫ wcProjKStr K (n - 2 + 1) = E₀.hom ∧
      (∀ (x : E₀.left) (c'' : Fin (n - 2 + 1 + 1))
        (hx : x ∈ jE ⁻¹ᵁ wcSgD K (n - 2 + 1) c''),
        wcLdpGerm K (n - 2 + 1) jE
          (wcLdpQuad K (n - 2 + 1) (fun p q => σ (IsLocalRing.residue A'
            (c' (Fin.cast (by omega) p) (Fin.cast (by omega) q))))) c'' x hx ∈
          IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x)) ∧
      ∃ (ρ : wcQuadModelRing A' n (π' ^ 2) c' →+* K)
        (e₁ : E₀.left ⟶ Limits.pullback (r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')),
        (∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0) ∧
        ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
          σ.toRingHom.comp (IsLocalRing.residue A') ∧
        IsClosedImmersion e₁ ∧
        e₁ ≫ Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') ≫ r₁ =
          E₀.hom ≫ Spec.map (CommRingCat.ofHom ρ) ∧
        Set.range e₁ = closure ((fun z => (Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) z) ⁻¹' {o})ᶜ ∩
          (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))))
            (wcQmSp A') ≫ r₁) z) ⁻¹' {o} :=
by
  classical
  have hn' : n - 2 + 1 + 1 = n := by omega
  have ha : (Matrix.of (wcQmdlA hn c' σ) + (Matrix.of (wcQmdlA hn c' σ)).transpose).det ≠ 0 := by
    have hu' := hc'.map (σ.toRingHom.comp (IsLocalRing.residue A'))
    rw [RingHom.map_det, RingHom.mapMatrix_apply] at hu'
    rw [← Matrix.det_submatrix_equiv_self (finCongr hn')] at hu'
    convert hu'.ne_zero using 2
    ext i j
    simp [wcQmdlA, Matrix.add_apply, Matrix.transpose_apply, Matrix.submatrix_apply,
      Matrix.map_apply, finCongr_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
  obtain ⟨E₀, hEp, hEs, jE, hjE, hjEY, hEG, hEall⟩ :=
    wc_smooth_quadric_hypersurface K (n - 2) (wcQmdlA hn c' σ) ha
  haveI := hEs
  obtain ⟨ρ₀, hρ₀X, hρ₀A, hmax⟩ := wc_qmdl_gen_ideal_maximal hπ' n c'
  obtain ⟨ρ, hρX, hρA⟩ : ∃ ρ : wcQuadModelRing A' n (π' ^ 2) c' →+* K,
      (∀ p, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) = 0) ∧
      ρ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        σ.toRingHom.comp (IsLocalRing.residue A') :=
    ⟨σ.toRingHom.comp ρ₀, fun p => by rw [RingHom.comp_apply, hρ₀X p, map_zero],
      by rw [RingHom.comp_assoc, hρ₀A]⟩
  have hoeq : o.asIdeal = Ideal.span (Set.range (wcQmbtGen A' n π' c')) := by
    have hle : Ideal.span (Set.range (wcQmbtGen A' n π' c')) ≤ o.asIdeal :=
      Ideal.span_le.mpr (by rintro _ ⟨k, rfl⟩; exact ho k)
    exact (hmax.eq_of_le o.isPrime.ne_top hle).symm
  obtain ⟨φ, φ0, e, e0, hpkg⟩ := wc_qmdl_charts_exist hπ' c' hr
  choose χ ψ hχ hmem using fun j => wc_qmdl_chart_maps hπ' hn c' K σ E₀ jE hjEY hEG j
  obtain ⟨g, hcov, hgι, hgpt, hgsq⟩ :=
    wc_qmdl_glue_map hπ' hn hr hpkg K σ E₀ jE hjEY χ ψ hχ ρ hρX hρA
  haveI hgci : IsClosedImmersion g :=
    wc_qmdl_glue_closed_imm hn hpkg K σ E₀ jE hjE hjEY χ ψ hχ g hcov hgι
  have hcr : CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) ≫
      CommRingCat.ofHom ρ =
      CommRingCat.ofHom (IsLocalRing.residue A') ≫ CommRingCat.ofHom σ.toRingHom := by
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact hρA
  have hw : g ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))) =
      (E₀.hom ≫ Spec.map (CommRingCat.ofHom σ.toRingHom)) ≫ wcQmSp A' := by
    calc g ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))
        = (g ≫ r₁) ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))) := by rw [Category.assoc]
      _ = E₀.hom ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) ≫ CommRingCat.ofHom ρ) := by
          rw [hgsq, Spec.map_comp, Category.assoc]
      _ = E₀.hom ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A') ≫
          CommRingCat.ofHom σ.toRingHom) := by rw [hcr]
      _ = (E₀.hom ≫ Spec.map (CommRingCat.ofHom σ.toRingHom)) ≫ wcQmSp A' := by
          simp only [Spec.map_comp, Category.assoc, wcQmSp]
  obtain ⟨e₁, he₁⟩ : ∃ e₁ : E₀.left ⟶ Limits.pullback (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A'),
      e₁ ≫ Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') = g :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _⟩
  haveI hfst : IsClosedImmersion (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')).flip
      (IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective)
  haveI : IsClosedImmersion (e₁ ≫ Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A')) := by
    rw [he₁]; exact hgci
  haveI he₁ci : IsClosedImmersion e₁ :=
    IsClosedImmersion.of_comp_isClosedImmersion e₁ (Limits.pullback.fst (r₁ ≫ Spec.map
      (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A'))
  have hpt : ∀ j (z : E₀.left) (hz : z ∈ wcQmdlV K hn jE j),
      Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')))) (wcQmSp A') (e₁ z) =
        e j (ψ j (⟨z, hz⟩ : wcQmdlV K hn jE j)) := by
    intro j z hz
    have h1 := hgpt j z hz
    rw [← he₁, Scheme.Hom.comp_apply] at h1
    exact h1
  refine ⟨E₀, hEp, hEs, jE, hjE, hjEY, hEG, ρ, e₁, hρX, hρA, he₁ci, ?_, ?_⟩
  · rw [← Category.assoc, he₁, hgsq]
  · apply Set.Subset.antisymm
    · apply wc_qmdl_range_sub hπ' hpkg hoeq hmax e₁
      intro z
      obtain ⟨j, hj⟩ := hcov z
      exact ⟨j, ψ j ⟨z, hj⟩, hpt j z hj, hmem j ⟨z, hj⟩⟩
    · apply wc_qmdl_range_sup hπ' hpkg hoeq hmax e₁
      intro j y h1 h2 h3
      obtain ⟨z, hz⟩ := wc_qmdl_chart_fibre_surj hπ' hn c' K σ E₀ jE hjE hjEY hEall j (χ j)
        (ψ j) (hχ j) y h1 h2 h3
      refine ⟨z.1, ?_⟩
      rw [hpt j z.1 z.2, ← hz]

theorem wc_qm_pullback_double_locus_transfer {X X₁ S E : Scheme.{u}} {B : Type u} [CommRing B]
    [IsLocalRing B] {h : X ⟶ X₁} {β : X ⟶ Spec (.of B)} {g : X₁ ⟶ S} {a : Spec (.of B) ⟶ S}
    (hP : IsPullback h β g a) [IsSeparated a] (hgen : GeneralizingMap h)
    [TopologicalSpace.NoetherianSpace X₁] {s₀ : S} (hs₀ : IsClosed ({s₀} : Set S))
    (ha : ∀ b, a b = s₀ ↔ b = IsLocalRing.closedPoint B)
    (hinj : ∀ y y' : X, β y = IsLocalRing.closedPoint B → β y' = IsLocalRing.closedPoint B →
      h y = h y' → y = y')
    (e₁ : E ⟶ X₁) [IsClosedImmersion e₁]
    (hr₁ : Set.range e₁ = closure ((fun z => g z) ⁻¹' {s₀})ᶜ ∩ (fun z => g z) ⁻¹' {s₀})
    (u : E ⟶ Spec (.of B)) (hu : u ≫ a = e₁ ≫ g) :
    ∃ e : E ⟶ X, IsClosedImmersion e ∧ e ≫ h = e₁ ∧
      Set.range e = closure ((fun z => β z) ⁻¹' {IsLocalRing.closedPoint B})ᶜ ∩
        (fun z => β z) ⁻¹' {IsLocalRing.closedPoint B} :=
by
  classical

  have hfib : ∀ x : X, β x = IsLocalRing.closedPoint B ↔ g (h x) = s₀ := by
    intro x
    have hx : g (h x) = a (β x) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hP.w]
    rw [hx, ha]

  haveI : IsSeparated h :=
    MorphismProperty.of_isPullback (P := @IsSeparated) hP.flip ‹IsSeparated a›
  let e : E ⟶ X := hP.lift e₁ u hu.symm
  have he : e ≫ h = e₁ := hP.lift_fst _ _ _
  haveI : IsClosedImmersion (e ≫ h) := by rw [he]; infer_instance
  haveI : IsClosedImmersion e := IsClosedImmersion.of_comp e h
  have heh : ∀ y, h (e y) = e₁ y := fun y => by rw [← Scheme.Hom.comp_apply, he]

  let U : Set X₁ := ((fun z => g z) ⁻¹' {s₀})ᶜ
  have hUo : IsOpen U := (hs₀.preimage g.continuous).isOpen_compl
  have hspec : ∀ y ∈ closure U, ∃ η ∈ U, η ⤳ y := by
    obtain ⟨T, hTf, hTc, hTi, hTeq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible
        (isClosed_closure (s := U))
    have hsub : closure U ⊆ ⋃₀ {t ∈ T | (t ∩ U).Nonempty} := by
      apply closure_minimal
      · intro x hx
        have hx' : x ∈ ⋃₀ T := by rw [← hTeq]; exact subset_closure hx
        obtain ⟨t, ht, hxt⟩ := hx'
        exact ⟨t, ⟨ht, x, hxt, hx⟩, hxt⟩
      · exact (hTf.subset (fun t ht => ht.1)).isClosed_sUnion (fun t ht => hTc t ht.1)
    intro y hy
    obtain ⟨t, ⟨htT, htU⟩, hyt⟩ := hsub hy
    have hη := (hTi t htT).isGenericPoint_genericPoint (hTc t htT)
    exact ⟨_, (hη.mem_open_set_iff hUo).mpr htU, hη.specializes hyt⟩
  have hgcl : ∀ x : X, h x ∈ closure U → x ∈ closure (⇑h ⁻¹' U) := by
    intro x hx
    obtain ⟨η, hηU, hηx⟩ := hspec _ hx
    obtain ⟨x', hx'x, hx'η⟩ := hgen hηx
    have hx'U : x' ∈ ⇑h ⁻¹' U := by
      rw [Set.mem_preimage, hx'η]; exact hηU
    exact closure_mono (Set.singleton_subset_iff.mpr hx'U) hx'x.mem_closure
  have hZc : ((fun z => β z) ⁻¹' {IsLocalRing.closedPoint B})ᶜ = ⇑h ⁻¹' U := by
    ext x
    show ¬ (β x = IsLocalRing.closedPoint B) ↔ ¬ (g (h x) = s₀)
    exact not_congr (hfib x)
  refine ⟨e, inferInstance, he, ?_⟩
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    have h1 : e₁ y ∈ Set.range e₁ := ⟨y, rfl⟩
    rw [hr₁] at h1
    obtain ⟨h1a, h1b⟩ := h1
    have hz : β (e y) = IsLocalRing.closedPoint B := (hfib _).mpr (by rw [heh]; exact h1b)
    refine ⟨?_, hz⟩
    rw [hZc]
    apply hgcl
    rw [heh]
    exact h1a
  · rintro ⟨hx1, hx2⟩
    have hb : β x = IsLocalRing.closedPoint B := hx2
    have hc : h x ∈ closure U := by
      rw [hZc] at hx1
      exact h.continuous.closure_preimage_subset U hx1
    have hz : h x ∈ Set.range e₁ := by rw [hr₁]; exact ⟨hc, (hfib x).mp hb⟩
    obtain ⟨y, hy⟩ := hz
    refine ⟨y, hinj _ _ ?_ hb ?_⟩
    · exact (hfib _).mpr (by rw [heh, hy]; exact (hfib x).mp hb)
    · rw [heh, hy]

theorem wc_qm_pullback_fibre_injective {X X₁ S : Scheme.{u}} {B : Type u} [CommRing B]
    [IsLocalRing B] {h : X ⟶ X₁} {β : X ⟶ Spec (.of B)} {g : X₁ ⟶ S} {a : Spec (.of B) ⟶ S}
    (hP : IsPullback h β g a) {s₀ : S} (ha0 : a (IsLocalRing.closedPoint B) = s₀)
    (hiso : IsIso (Limits.pullback.snd a (S.fromSpecResidueField s₀))) :
    ∀ y y' : X, β y = IsLocalRing.closedPoint B → β y' = IsLocalRing.closedPoint B →
      h y = h y' → y = y' :=
by
  intro y y' hy hy' hyy'
  haveI := hiso
  have hpre : IsPreimmersion (Limits.pullback.fst a (S.fromSpecResidueField s₀) ≫ a) := by
    rw [Limits.pullback.condition]; infer_instance
  have hQ : IsPullback (Limits.pullback.fst β (Limits.pullback.fst a (S.fromSpecResidueField s₀)) ≫ h)
      (Limits.pullback.snd β (Limits.pullback.fst a (S.fromSpecResidueField s₀))) g
      (Limits.pullback.fst a (S.fromSpecResidueField s₀) ≫ a) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback _ _) hP
  have hpre2 : IsPreimmersion
      (Limits.pullback.fst β (Limits.pullback.fst a (S.fromSpecResidueField s₀)) ≫ h) :=
    MorphismProperty.of_isPullback (P := @IsPreimmersion) hQ.flip hpre
  have hinj := (Scheme.Hom.isEmbedding
    (Limits.pullback.fst β (Limits.pullback.fst a (S.fromSpecResidueField s₀)) ≫ h)).injective
  have hpt : a (IsLocalRing.closedPoint B) =
      (S.fromSpecResidueField s₀) (IsLocalRing.closedPoint (S.residueField s₀)) := by
    exact ha0.trans (Scheme.fromSpecResidueField_apply s₀ _).symm
  obtain ⟨p, hp, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hpt
  obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback y p (hy.trans hp.symm)
  obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback y' p (hy'.trans hp.symm)
  have hzz : z = z' := by
    apply hinj
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hz, hz', hyy']
  rw [← hz, ← hz', hzz]

theorem wc_qmbt_qm_residue_equiv {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'}
    {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) (hπ'2 : π' ^ 2 = ιA π)
    (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π') :
    ∃ σ : IsLocalRing.ResidueField A' ≃+* IsLocalRing.ResidueField B₀,
      ∀ x : A, σ (IsLocalRing.residue A' (ιA x)) =
        IsLocalRing.residue B₀
          ((Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A n π c) x)) :=
by
  classical

  have s1 : ∀ {K₁ K₂ : Type u} [Field K₁] [Field K₂] (χ : A →+* K₁) (ψ : A →+* K₂),
      Function.Surjective χ → Function.Surjective ψ → ∃ σ : K₁ ≃+* K₂, ∀ x : A, σ (χ x) = ψ x := by
    intro K₁ K₂ _ _ χ ψ hχ hψ
    have h1 : RingHom.ker χ = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective χ hχ)
    have h2 : RingHom.ker ψ = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ψ hψ)
    refine ⟨(RingHom.quotientKerEquivOfSurjective hχ).symm.trans
      ((Ideal.quotEquivOfEq (h1.trans h2.symm)).trans (RingHom.quotientKerEquivOfSurjective hψ)),
      fun x => ?_⟩
    have e : (RingHom.quotientKerEquivOfSurjective hχ).symm (χ x) = Ideal.Quotient.mk _ x := by
      rw [RingEquiv.symm_apply_eq]; rfl
    rw [RingEquiv.trans_apply, RingEquiv.trans_apply, e, Ideal.quotEquivOfEq_mk]
    rfl

  have hχ : Function.Surjective ((IsLocalRing.residue A').comp ιA) := by
    intro k
    obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective k
    obtain ⟨x, y, rfl⟩ := hgen a'
    refine ⟨x, ?_⟩
    have hπ0 : IsLocalRing.residue A' π' = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr (hπ' ▸ Ideal.mem_span_singleton_self π')
    simp [hπ0]

  have hm : x₀.asIdeal.IsMaximal := by
    have hmax := wc_qmbt_bm_origin_maximal hπ n c
    have hle : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤ x₀.asIdeal :=
      Ideal.span_le.mpr (by rintro _ ⟨p, rfl⟩; exact hx₀ p)
    have heq := hmax.eq_of_le x₀.isPrime.ne_top hle
    exact heq ▸ hmax

  have hj : Function.Surjective (Spec.preimage
      ((Spec (.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀)).hom := by
    set j := (Spec (.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀ with hjdef
    have hcl : IsClosed ({x₀} : Set (Spec (.of (wcQuadModelRing A n π c)))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal x₀).mpr hm
    have hj : IsClosedImmersion j := isClosed_singleton_iff_isClosedImmersion.mp hcl
    have : IsClosedImmersion (Spec.map (Spec.preimage j)) := by rw [Spec.map_preimage]; exact hj
    have hsurj := IsClosedImmersion.isAffine_surjective_of_isAffine (Spec.map (Spec.preimage j))
    have hnat := Scheme.ΓSpecIso_naturality (Spec.preimage j)
    intro y
    obtain ⟨s, hs⟩ := hsurj.2 ((Scheme.ΓSpecIso _).inv y)
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).hom s, ?_⟩
    have := congrArg (fun f => f.hom s) hnat
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [← this, hs]
    exact Iso.inv_hom_id_apply _ _

  obtain ⟨-, -, hiso⟩ := wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh

  have hs : Function.Surjective ((IsLocalRing.residue B₀).comp (Spec.preimage a₀).hom) := by
    set j := (Spec (.of (wcQuadModelRing A n π c))).fromSpecResidueField x₀ with hjdef
    set t := inv (Limits.pullback.snd a₀ j) ≫ Limits.pullback.fst a₀ j with htdef
    have ht : t ≫ a₀ = j := by
      rw [htdef, Category.assoc, Limits.pullback.condition, IsIso.inv_hom_id_assoc]
    set τ := Spec.preimage t with hτdef
    have hcomp : Spec.preimage a₀ ≫ τ = Spec.preimage j := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_preimage, ht]
    have hcomp' : τ.hom.comp (Spec.preimage a₀).hom = (Spec.preimage j).hom := by
      rw [← CommRingCat.hom_comp, hcomp]
    have hτs : Function.Surjective τ.hom := by
      intro k
      obtain ⟨r, hr⟩ := hj k
      exact ⟨(Spec.preimage a₀).hom r, by rw [← hr, ← hcomp']; rfl⟩
    have hker : RingHom.ker τ.hom = IsLocalRing.maximalIdeal B₀ :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective τ.hom hτs)
    intro k
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective k
    obtain ⟨r, hr⟩ := hj (τ.hom b)
    refine ⟨r, ?_⟩
    have h1 : τ.hom ((Spec.preimage a₀).hom r) = τ.hom b := by
      rw [← hr, ← hcomp']; rfl
    have h2 : b - (Spec.preimage a₀).hom r ∈ IsLocalRing.maximalIdeal B₀ := by
      rw [← hker, RingHom.mem_ker, map_sub, h1, sub_self]
    rw [RingHom.comp_apply, eq_comm, ← sub_eq_zero, ← map_sub]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr h2

  obtain ⟨-, hmaxB, -⟩ := wc_qmbt_ecc_shens_maximal hπ hx₀ hsh
  have hX : ∀ p, (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
      (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B₀ := by
    intro p
    rw [hmaxB]; exact Ideal.subset_span ⟨p, rfl⟩

  set ψ := (IsLocalRing.residue B₀).comp
    ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A n π c))) with hψdef
  have hext : ((IsLocalRing.residue B₀).comp (Spec.preimage a₀).hom).comp
      (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) = ψ.comp MvPolynomial.constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_C, hψdef]
      rfl
    · intro p
      simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr (hX p)
  have hψ : Function.Surjective ψ := by
    intro k
    obtain ⟨r, hr⟩ := hs k
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    refine ⟨MvPolynomial.constantCoeff f, ?_⟩
    have := RingHom.congr_fun hext f
    simp only [RingHom.comp_apply] at this hr ⊢
    rw [← this, hr]
  obtain ⟨σ, hσ⟩ := s1 _ _ hχ hψ
  exact ⟨σ, fun x => hσ x⟩

theorem wc_qmbt_csz_Y_quadric_model {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A')) :
    ∃ (E₀ : Over (Spec (.of (IsLocalRing.ResidueField B₀)))) (_ : IsProper E₀.hom)
      (_ : SmoothOfRelativeDimension (n - 2) E₀.hom)
      (jE : E₀.left ⟶ wcProjK (IsLocalRing.ResidueField B₀) (n - 2 + 1))
      (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → IsLocalRing.ResidueField B₀),
      IsClosedImmersion jE ∧ jE ≫ wcProjKStr (IsLocalRing.ResidueField B₀) (n - 2 + 1) = E₀.hom ∧
      (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 ∧
      (∀ (x : E₀.left) (c' : Fin (n - 2 + 1 + 1))
        (hx : x ∈ jE ⁻¹ᵁ wcSgD (IsLocalRing.ResidueField B₀) (n - 2 + 1) c'),
        wcLdpGerm (IsLocalRing.ResidueField B₀) (n - 2 + 1) jE
          (wcLdpQuad (IsLocalRing.ResidueField B₀) (n - 2 + 1) a) c' x hx ∈
          IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x)) ∧
      ∃ e : E₀.left ⟶ Xs', IsClosedImmersion e ∧
        Set.range e = closure ((fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀})ᶜ ∩
        (fun z => (ι' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) z) ⁻¹' {IsLocalRing.closedPoint B₀} :=
by
  classical

  obtain ⟨θ, X₁, r₁, ψ, hθX, hθA, hr₁, hsq, hψ, hnoeth⟩ :=
    wc_qmbt_qm_model_square_ext hsh hπ'2 hbl

  obtain ⟨o, ho, hθo⟩ := wc_qmbt_hlsc_theta_fibre hπ hx₀ hπ' hπ'2 θ hθX hθA

  obtain ⟨σ, hσ⟩ := wc_qmbt_qm_residue_equiv hπ hx₀ hsh hπ' hπ'2 hgen

  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have hu := hc.map ιA
    rw [RingHom.map_det, RingHom.mapMatrix_apply] at hu
    have hM : (c + c.transpose).map ιA = c.map ιA + (c.map ιA).transpose := by
      ext i j
      simp [Matrix.add_apply, Matrix.transpose_apply]
    rw [hM] at hu
    exact hu

  obtain ⟨E₀, hEp, hEs, jE, hjE, hjEY, hEG, ρ, e₁, hρX, hρA, he₁, he₁r, hre₁⟩ :=
    wc_qmbt_qm_model_double_locus hπ' hn4 hc' hr₁ ho (IsLocalRing.ResidueField B₀) σ

  have hcond : (ι' ≫ ψ) ≫ (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) = s' ≫ wcQmSp A' := by
    simp only [Category.assoc]
    rw [hψ, hblf]
    exact hps'.w
  obtain ⟨h, hh1, hh2⟩ : ∃ h : Xs' ⟶ Limits.pullback (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A'),
      h ≫ Limits.pullback.fst _ _ = ι' ≫ ψ ∧ h ≫ Limits.pullback.snd _ _ = s' :=
    ⟨Limits.pullback.lift (ι' ≫ ψ) s' hcond, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hout : IsPullback ι' (h ≫ Limits.pullback.snd _ _)
      (ψ ≫ r₁ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') := by
    rw [hh2, hψ, hblf]
    exact hps'
  have htop : IsPullback ι' h ψ (Limits.pullback.fst _ _) :=
    IsPullback.of_bot hout hh1.symm (IsPullback.of_hasPullback _ _)
  have hP := IsPullback.paste_vert htop.flip hsq

  haveI : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI : Flat h := MorphismProperty.of_isPullback (P := @Flat) hP.flip
    (inferInstance : Flat a₀)
  have hgenh : GeneralizingMap h := Flat.generalizingMap h
  haveI : IsSeparated a₀ := IsSeparated.of_isAffineHom a₀
  haveI := hnoeth
  haveI := he₁

  have hs₀ : IsClosed ({x₀} : Set (Spec (.of (wcQuadModelRing A n π c)))) := by
    have hmax := wc_qmbt_bm_origin_maximal hπ n c
    have hle : Ideal.span (Set.range fun p : Fin n =>
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ≤ x₀.asIdeal :=
      Ideal.span_le.mpr (by rintro _ ⟨p, rfl⟩; exact hx₀ p)
    have heq := hmax.eq_of_le x₀.isPrime.ne_top hle
    have hm : x₀.asIdeal.IsMaximal := heq ▸ hmax
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal x₀).mpr hm
  obtain ⟨hx1, hx2, hx3⟩ := wc_qmbt_hlsc_x0_fibre hπ hx₀ hsh
  have ha : ∀ b, a₀ b = x₀ ↔ b = IsLocalRing.closedPoint B₀ :=
    fun b => ⟨hx2 b, fun e => e ▸ hx1⟩
  have hinj := wc_qm_pullback_fibre_injective hP hx1 hx3
  have hpre : (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁ ≫
        Spec.map (CommRingCat.ofHom θ)) z) ⁻¹' {x₀} =
      (fun z => (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁) z) ⁻¹'
        {o} := by
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
    exact hθo _

  have hring : (IsLocalRing.residue B₀).comp (Spec.preimage a₀).hom = ρ.comp θ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro x
      have e1 : (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.C x) =
          algebraMap A (wcQuadModelRing A n π c) x := rfl
      have e2 := RingHom.congr_fun hθA x
      have e3 := RingHom.congr_fun hρA (ιA x)
      simp only [RingHom.comp_apply] at e2 e3 ⊢
      rw [e1, e2, e3]
      exact (hσ x).symm
    · intro p
      obtain ⟨-, hmax, -⟩ := wc_qmbt_ecc_shens_maximal hπ hx₀ hsh
      have hm : (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B₀ := by
        rw [hmax]; exact Ideal.subset_span ⟨p, rfl⟩
      simp only [RingHom.comp_apply]
      rw [(IsLocalRing.residue_eq_zero_iff _).mpr hm, hθX p, hρX p]
  have hcr : Spec.preimage a₀ ≫ CommRingCat.ofHom (IsLocalRing.residue B₀) =
      CommRingCat.ofHom θ ≫ CommRingCat.ofHom ρ := by
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact hring
  have hu : (E₀.hom ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) ≫ a₀ =
      e₁ ≫ (Limits.pullback.fst (r₁ ≫ Spec.map (CommRingCat.ofHom
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))) (wcQmSp A') ≫ r₁ ≫
        Spec.map (CommRingCat.ofHom θ)) := by
    calc (E₀.hom ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀))) ≫ a₀
        = E₀.hom ≫ Spec.map (Spec.preimage a₀ ≫
            CommRingCat.ofHom (IsLocalRing.residue B₀)) := by
          rw [Spec.map_comp, Spec.map_preimage, Category.assoc]
      _ = E₀.hom ≫ Spec.map (CommRingCat.ofHom θ ≫ CommRingCat.ofHom ρ) := by rw [hcr]
      _ = _ := by
          rw [Spec.map_comp, ← Category.assoc, ← he₁r]
          simp only [Category.assoc]

  obtain ⟨e, he, -, hre⟩ := wc_qm_pullback_double_locus_transfer hP hgenh hs₀ ha hinj e₁
    (by rw [hpre]; exact hre₁) _ hu
  refine ⟨E₀, hEp, hEs, jE, _, hjE, hjEY, ?_, hEG, e, he, hre⟩

  have hn' : n - 2 + 1 + 1 = n := by omega
  have hu' := hc'.map (σ.toRingHom.comp (IsLocalRing.residue A'))
  rw [RingHom.map_det, RingHom.mapMatrix_apply] at hu'
  rw [← Matrix.det_submatrix_equiv_self (finCongr hn')] at hu'
  convert hu'.ne_zero using 2
  ext i j
  simp [Matrix.add_apply, Matrix.transpose_apply, Matrix.submatrix_apply, Matrix.map_apply,
    finCongr_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]

theorem wc_quadric_section_full (K : Type u) [Field K] (d : ℕ) (hd1 : 1 ≤ d) (E₀ : Over (Spec (.of K)))
    [IsProper E₀.hom] [SmoothOfRelativeDimension d E₀.hom] [Nonempty E₀.left]
    (jE : E₀.left ⟶ wcProjK K (d + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (d + 1) = E₀.hom)
    (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (hEG : ∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) c),
      wcLdpGerm K (d + 1) jE (wcLdpQuad K (d + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x)) :
    ∀ p : wcProjK K (d + 1), (∀ (c : Fin (d + 1 + 1)) (hp : p ∈ wcSgD K (d + 1) c),
        ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) p hp).hom
            (wcLdpSec K (d + 1) (wcLdpQuad K (d + 1) a) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (d + 1)).presheaf.stalk p)) →
      p ∈ Set.range jE :=
by
  classical
  have hprime := wc_qsf_quad_prime K d hd1 a ha
  generalize wcLdpQuad K (d + 1) a = G at hEG hprime ⊢
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) :=
    MvPolynomial.gradedAlgebra
  obtain ⟨DG, hDG⟩ : ∃ U : (wcProjK K (d + 1)).Opens, U = @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) MvPolynomial.gradedAlgebra
      (G : MvPolynomial (Fin (d + 1 + 1)) K) := ⟨_, rfl⟩
  have hX : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hXirr : ∀ k : Fin (d + 1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1 + 1)) K) ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) := by
    intro k
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)
        (MvPolynomial.X k) 0 : MvPolynomial (Fin (d + 1 + 1)) K)) =
        MvPolynomial.homogeneousComponent 0 (MvPolynomial.X k) :=
      MvPolynomial.decomposition.decompose'_apply _ 0
    rw [h6, MvPolynomial.homogeneousComponent_of_mem (hX k)]
    simp

  have hcover : ∀ q : wcProjK K (d + 1), ∃ c : Fin (d + 1 + 1), q ∈ wcSgD K (d + 1) c := by
    intro q
    by_contra hno
    push_neg at hno
    have hall : ∀ i : Fin (d + 1 + 1), MvPolynomial.X i ∈ q.asHomogeneousIdeal.toIdeal := by
      intro i
      have h8 := hno i
      rw [Proj.mem_basicOpen, not_not] at h8
      exact h8
    apply ProjectiveSpectrum.not_irrelevant_le q
    intro x hx
    have hx0 : x.coeff 0 = 0 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hx
      have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) x 0 :
          MvPolynomial (Fin (d + 1 + 1)) K)) = MvPolynomial.homogeneousComponent 0 x :=
        MvPolynomial.decomposition.decompose'_apply x 0
      rw [h6, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hx
      exact hx
    have hspan : x ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1 + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      rw [MvPolynomial.mem_support_iff] at hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact hm hx0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1 + 1)))) ≤
        q.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le, Set.image_subset_iff]
      intro i _
      exact hall i
    exact hle hspan

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 2) (hg' : g ∈ 𝒜 (2 • 1)),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen
        (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg hg'
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg' := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg (by norm_num : 0 < 2)
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg') =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg')).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have hkey : ∀ c : Fin (d + 1 + 1),
      (wcProjK K (d + 1)).basicOpen (wcLdpSec K (d + 1) G c) = wcSgD K (d + 1) c ⊓ DG := by
    intro c
    rw [hDG]
    exact (L1 _ (MvPolynomial.X c) (G : MvPolynomial (Fin (d + 1 + 1)) K) (hX c) G.2 G.2).symm
  have hgerm : ∀ (c : Fin (d + 1 + 1)) (q : wcProjK K (d + 1)) (hq : q ∈ wcSgD K (d + 1) c),
      ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) q hq).hom
          (wcLdpSec K (d + 1) G c) ∈
        IsLocalRing.maximalIdeal ((wcProjK K (d + 1)).presheaf.stalk q) ↔ q ∉ DG := by
    intro c q hq
    have e1 := Scheme.mem_basicOpen (wcProjK K (d + 1)) (wcLdpSec K (d + 1) G c) q hq
    rw [hkey c, TopologicalSpace.Opens.mem_inf] at e1
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro h h'
      exact h (e1.mp ⟨hq, h'⟩)
    · intro h h'
      exact h (e1.mpr h').2

  have hpull : ∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) c),
      wcLdpGerm K (d + 1) jE G c x hx ∈ IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x) →
      ((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (jE x) hx).hom
          (wcLdpSec K (d + 1) G c) ∈
        IsLocalRing.maximalIdeal ((wcProjK K (d + 1)).presheaf.stalk (jE x)) := by
    intro x c hx h
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h ⊢
    intro hu
    apply h
    have e := Scheme.Hom.germ_stalkMap_apply jE (wcSgD K (d + 1) c) x hx (wcLdpSec K (d + 1) G c)
    have hu' : IsUnit ((jE.stalkMap x).hom
        (((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (jE x) hx).hom
          (wcLdpSec K (d + 1) G c))) := (isUnit_map_iff (jE.stalkMap x).hom _).mpr hu
    have e' : (jE.stalkMap x).hom
        (((wcProjK K (d + 1)).presheaf.germ (wcSgD K (d + 1) c) (jE x) hx).hom
          (wcLdpSec K (d + 1) G c)) = wcLdpGerm K (d + 1) jE G c x hx := e
    rw [e'] at hu'
    exact hu'

  have hGh : (G : MvPolynomial (Fin (d + 1 + 1)) K).IsHomogeneous 2 :=
    (MvPolynomial.mem_homogeneousSubmodule 2 _).mp G.2
  have hG0 : (G : MvPolynomial (Fin (d + 1 + 1)) K) ≠ 0 := hprime.ne_zero

  have hIhom : Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)
      (Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}) := by
    apply Ideal.homogeneous_span
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact ⟨2, G.2⟩
  have hIprime : (Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}).IsPrime :=
    (Ideal.span_singleton_prime hG0).mpr hprime
  have hnirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) ≤
      (⟨Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}, hIhom⟩ :
        HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)) := by
    intro hle
    have h1 : (MvPolynomial.X 0 : MvPolynomial (Fin (d + 1 + 1)) K) ∈
        Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)} := hle (hXirr 0)
    rw [Ideal.mem_span_singleton] at h1
    obtain ⟨h, hh⟩ := h1
    have hh0 : h ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hh
      exact MvPolynomial.X_ne_zero _ hh
    have h2 := congrArg MvPolynomial.totalDegree hh
    rw [MvPolynomial.totalDegree_X, MvPolynomial.totalDegree_mul_of_isDomain hG0 hh0,
      hGh.totalDegree hG0] at h2
    omega
  let η : wcProjK K (d + 1) := ProjectiveSpectrum.mk
    (⟨Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)}, hIhom⟩ :
      HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)) hIprime hnirr
  have hZeq : {q : wcProjK K (d + 1) | q ∉ DG} = closure {η} := by
    ext q
    simp only [Set.mem_setOf_eq]
    rw [hDG, Proj.mem_basicOpen, not_not]
    have key := (ProjectiveSpectrum.le_iff_mem_closure
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) η q)
    refine Iff.trans ?_ ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η q).trans key)
    constructor
    · intro hq x hx
      have hle : Ideal.span {(G : MvPolynomial (Fin (d + 1 + 1)) K)} ≤
          q.asHomogeneousIdeal.toIdeal :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq)
      exact hle hx
    · intro hle
      exact hle (Ideal.subset_span (Set.mem_singleton _))
  have hZirr : IsIrreducible {q : wcProjK K (d + 1) | q ∉ DG} := by
    rw [hZeq]
    exact isIrreducible_singleton.closure
  have hZcl : IsClosed {q : wcProjK K (d + 1) | q ∉ DG} :=
    DG.isOpen.isClosed_compl

  have hbotprime : (⊥ : HomogeneousIdeal
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)).toIdeal.IsPrime := by
    rw [HomogeneousIdeal.toIdeal_bot]
    exact Ideal.isPrime_bot
  have hbotirr : ¬ HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) ≤ ⊥ := by
    intro hle
    have h1 : (MvPolynomial.X 0 : MvPolynomial (Fin (d + 1 + 1)) K) ∈
        (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)).toIdeal :=
      hle (hXirr 0)
    rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h1
    exact MvPolynomial.X_ne_zero _ h1
  let η₀ : wcProjK K (d + 1) := ProjectiveSpectrum.mk ⊥ hbotprime hbotirr
  have huniv : (Set.univ : Set (wcProjK K (d + 1))) = closure {η₀} := by
    ext q
    simp only [Set.mem_univ, true_iff]
    have key := (ProjectiveSpectrum.le_iff_mem_closure
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K) η₀ q)
    refine key.mp ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η₀ q).mp ?_)
    exact bot_le
  have hη₀ : η₀ ∈ DG := by
    rw [hDG, Proj.mem_basicOpen]
    intro h
    have h1 : (G : MvPolynomial (Fin (d + 1 + 1)) K) ∈
        (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) K)).toIdeal := h
    rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h1
    exact hG0 h1

  have hstalk : ∀ (X : Scheme.{u}) (x : X),
      ringKrullDim (X.presheaf.stalk x) ≤ topologicalKrullDim X := by
    intro X x
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    let x' : U := ⟨x, hxU⟩
    have hloc := hU.isLocalization_stalk x'
    have e1 : ringKrullDim (X.presheaf.stalk (x' : X)) =
        ((hU.primeIdealOf x').asIdeal.height : WithBot ℕ∞) := by
      first
      | exact @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ (hU.primeIdealOf x').asIdeal _
          (X.presheaf.stalk (x' : X)) _ ?alg hloc
      | (letI : Algebra Γ(X, U) (X.presheaf.stalk (x' : X)) :=
            TopCat.Presheaf.algebra_section_stalk X.presheaf x'
         exact IsLocalization.AtPrime.ringKrullDim_eq_height _ _)
      | (letI : Algebra Γ(X, U) (X.presheaf.stalk (x' : X)) :=
            (X.presheaf.germ U x hxU).hom.toAlgebra
         exact IsLocalization.AtPrime.ringKrullDim_eq_height _ _)
    have e2 : ((hU.primeIdealOf x').asIdeal.height : WithBot ℕ∞) ≤ ringKrullDim Γ(X, U) :=
      Ideal.height_le_ringKrullDim_of_ne_top (hU.primeIdealOf x').isPrime.ne_top
    have e3 : ringKrullDim Γ(X, U) = topologicalKrullDim (Spec Γ(X, U)) :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm
    have e4 : topologicalKrullDim U.toScheme = topologicalKrullDim (Spec Γ(X, U)) :=
      IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso hU.isoSpec).isHomeomorph
    have e5 : topologicalKrullDim U.toScheme ≤ topologicalKrullDim X :=
      Topology.IsInducing.topologicalKrullDim_le U.ι.isOpenEmbedding.isInducing
    calc ringKrullDim (X.presheaf.stalk x)
        = ((hU.primeIdealOf x').asIdeal.height : WithBot ℕ∞) := e1
      _ ≤ ringKrullDim Γ(X, U) := e2
      _ = topologicalKrullDim (Spec Γ(X, U)) := e3
      _ = topologicalKrullDim U.toScheme := e4.symm
      _ ≤ topologicalKrullDim X := e5

  haveI := hjE
  have hWcl : IsClosed (Set.range jE) := jE.isClosedEmbedding.isClosed_range
  haveI : CompactSpace E₀.left :=
    (quasiCompact_iff_compactSpace (Y := Spec (.of K)) E₀.hom).mp inferInstance
  obtain ⟨z, -, hz⟩ := IsClosed.exists_closed_singleton (X := E₀.left) isClosed_univ
    ⟨Classical.arbitrary _, trivial⟩
  have hd_stalk := wc_lfi_smooth_stalk_dim K E₀.left E₀.hom d z hz
  have hdimE : (d : WithBot ℕ∞) ≤ topologicalKrullDim E₀.left := by
    rw [← hd_stalk]
    exact hstalk E₀.left z
  have hind : Topology.IsInducing (Set.codRestrict jE (Set.range jE) (fun x => Set.mem_range_self x)) :=
    jE.isClosedEmbedding.isInducing.codRestrict (fun x => Set.mem_range_self x)
  have hdimW : (d : WithBot ℕ∞) ≤ topologicalKrullDim (Set.range jE) :=
    hdimE.trans hind.topologicalKrullDim_le
  have hsub : Set.range jE ⊆ {q : wcProjK K (d + 1) | q ∉ DG} := by
    rintro _ ⟨x, rfl⟩
    obtain ⟨c, hc⟩ := hcover (jE x)
    exact (hgerm c (jE x) hc).mp (hpull x c hc (hEG x c hc))

  have hZne : {q : wcProjK K (d + 1) | q ∉ DG} ≠ Set.univ := by
    intro h
    have h1 : η₀ ∈ {q : wcProjK K (d + 1) | q ∉ DG} := by
      rw [h]; exact Set.mem_univ η₀
    exact h1 hη₀
  have hunivirr : IsIrreducible (Set.univ : Set (wcProjK K (d + 1))) := by
    rw [huniv]
    exact isIrreducible_singleton.closure
  have hZdim : ¬ ((d + 1 : ℕ) : WithBot ℕ∞) ≤
      topologicalKrullDim {q : wcProjK K (d + 1) | q ∉ DG} := by
    intro h
    have h2 := wc_dim_succ_le_of_proper_closed_subset _ Set.univ _ hunivirr hZcl
      (Set.subset_univ _) hZne (d + 1) h
    have e1 : topologicalKrullDim (Set.univ : Set (wcProjK K (d + 1))) =
        topologicalKrullDim (wcProjK K (d + 1)) :=
      IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ _).isHomeomorph
    rw [e1, wc_proj_space_dim] at h2
    have h3 : d + 1 + 1 ≤ d + 1 := by exact_mod_cast h2
    omega

  intro p hp
  by_contra hpW
  obtain ⟨c, hc⟩ := hcover p
  have hpZ : p ∈ {q : wcProjK K (d + 1) | q ∉ DG} := (hgerm c p hc).mp (hp c hc)
  have hne : Set.range jE ≠ {q : wcProjK K (d + 1) | q ∉ DG} := by
    intro h
    rw [← h] at hpZ
    exact hpW hpZ
  exact hZdim (wc_dim_succ_le_of_proper_closed_subset _ _ _ hZirr hWcl hsub hne d hdimW)

theorem wc_hq_chart_affine_iso : ∀ (Ω : Type u) [Field Ω] (d : ℕ), Even d → 2 ≤ d → ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] (jY : Y ⟶ wcProjK Ω (d + 1)), IsClosedImmersion jY → Set.range jY = {p | p ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) : MvPolynomial (Fin (d + 1 + 1)) Ω)} → ∀ k : ℕ, k ≤ d / 2 + 1 → Nonempty ((jY ⁻¹ᵁ wcSgD Ω (d + 1) ⟨if k ≤ d / 2 then 2 * k + 1 else d, by split_ifs <;> omega⟩ : Scheme.{u}) ≅ Spec (.of (MvPolynomial (Fin d) Ω))) :=
by
  intro Ω _ d hd hd2 Y _ jY hjY hY k hk
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) :=
    MvPolynomial.gradedAlgebra
  haveI := hjY
  obtain ⟨t, ht⟩ := hd

  have s2 : ∀ (m : ℕ) (a : Fin (m + 1)) (g₀ : MvPolynomial (Fin m) Ω),
      Function.Surjective (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X)) ∧
      RingHom.ker (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X)) =
        Ideal.span {MvPolynomial.X a + MvPolynomial.rename a.succAbove g₀} := by
    intro m a g₀
    have hC : ∀ c : Ω, (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X))
        (MvPolynomial.C c) = MvPolynomial.C c := fun c => by rw [MvPolynomial.eval₂Hom_C]
    have hXa : (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X))
        (MvPolynomial.X a) = -g₀ := by
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same]
    have hXs : ∀ i : Fin m, (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X))
        (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i := fun i => by
      rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]
    generalize (MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) Ω) a (-g₀) MvPolynomial.X)) = φ
      at hC hXa hXs ⊢
    have hφι : ∀ p, φ (MvPolynomial.rename a.succAbove p) = p := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r => rw [MvPolynomial.rename_C, hC]
      | add p q hp hq => rw [map_add, map_add, hp, hq]
      | mul_X p n hp => rw [map_mul, map_mul, hp, MvPolynomial.rename_X, hXs]
    refine ⟨fun p => ⟨_, hφι p⟩, ?_⟩
    have hdiff : ∀ F, F - MvPolynomial.rename a.succAbove (φ F) ∈
        Ideal.span {MvPolynomial.X a + MvPolynomial.rename a.succAbove g₀} := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C r => rw [hC, MvPolynomial.rename_C, sub_self]; exact zero_mem _
      | add p q hp hq => rw [map_add, map_add, add_sub_add_comm]; exact add_mem hp hq
      | mul_X p n hp =>
        rw [map_mul, map_mul]
        have e : p * MvPolynomial.X n - MvPolynomial.rename a.succAbove (φ p) *
            MvPolynomial.rename a.succAbove (φ (MvPolynomial.X n)) =
            (p - MvPolynomial.rename a.succAbove (φ p)) * MvPolynomial.X n +
            MvPolynomial.rename a.succAbove (φ p) *
              (MvPolynomial.X n - MvPolynomial.rename a.succAbove (φ (MvPolynomial.X n))) := by
          ring
        rw [e]
        refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
        rcases Fin.eq_self_or_eq_succAbove a n with h | ⟨j, h⟩
        · subst h
          rw [hXa, map_neg, sub_neg_eq_add]
          exact Ideal.mem_span_singleton_self _
        · subst h
          rw [hXs, MvPolynomial.rename_X, sub_self]
          exact zero_mem _
    apply le_antisymm
    · intro F hF
      rw [RingHom.mem_ker] at hF
      have h := hdiff F
      rwa [hF, map_zero, sub_zero] at h
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_add, hXa,
        hφι, neg_add_cancel]

  have s5 : ∀ (W Z U : Scheme.{u}) [AlgebraicGeometry.IsReduced W]
      [AlgebraicGeometry.IsReduced Z] (g : W ⟶ U) (z : Z ⟶ U) [IsClosedImmersion g]
      [IsClosedImmersion z], Set.range g = Set.range z → Nonempty (W ≅ Z) := by
    intro W Z U _ _ g z _ _ h
    have H : z.ker ≤ g.ker := by
      show z.ker ≤ Scheme.IdealSheafData.ofIdeals
        (fun V : U.affineOpens => RingHom.ker (g.app V).hom)
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro V s hs
      have hz : (z.app V).hom s = 0 :=
        Scheme.IdealSheafData.ideal_ofIdeals_le
          (I := fun V : U.affineOpens => RingHom.ker (z.app V).hom) V hs
      have hX : z ⁻¹ᵁ U.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen]
        erw [hz]
        exact Scheme.basicOpen_zero _ _
      have hW : W.basicOpen ((g.app V).hom s) = ⊥ := by
        rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
        intro w hw
        obtain ⟨x, hx⟩ : g w ∈ Set.range z := h ▸ ⟨w, rfl⟩
        have hx' : x ∈ z ⁻¹ᵁ U.basicOpen s := by
          show z x ∈ U.basicOpen s
          rw [hx]; exact hw
        rw [hX] at hx'
        exact hx'.elim
      exact eq_zero_of_basicOpen_eq_bot _ hW
    have hg' : IsClosedImmersion.lift z g H ≫ z = g := IsClosedImmersion.lift_fac z g H
    have : IsClosedImmersion (IsClosedImmersion.lift z g H ≫ z) := by rw [hg']; infer_instance
    have : IsClosedImmersion (IsClosedImmersion.lift z g H) :=
      IsClosedImmersion.of_comp (IsClosedImmersion.lift z g H) z
    have : Surjective (IsClosedImmersion.lift z g H) := by
      constructor
      intro w'
      obtain ⟨w, hw⟩ : z w' ∈ Set.range g := h ▸ ⟨w', rfl⟩
      refine ⟨w, z.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, hg', hw]
    have := isIso_of_isClosedImmersion_of_surjective (IsClosedImmersion.lift z g H)
    exact ⟨asIso (IsClosedImmersion.lift z g H)⟩

  have s1 : ∀ (a : Fin (d + 1 + 1)), ∃ e : MvPolynomial (Fin (d + 1)) Ω ≃+*
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
        (MvPolynomial.X a),
      ∀ (n : ℕ) (F : MvPolynomial (Fin (d + 1 + 1)) Ω)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω (n • 1)),
        e (MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (d + 1)) Ω) a 1 MvPolynomial.X) F) =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a))
          n F hF := by
    intro a
    have scale : ∀ {S : Type u} [CommRing S] (φ : Ω →+* S) (x : Fin (d + 1 + 1) → S) (t : S)
        (n : ℕ) (F : MvPolynomial (Fin (d + 1 + 1)) Ω), F.IsHomogeneous n →
        MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
      intro S _ φ x t n F hF
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : Finsupp.degree d = n := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
        simp only [mul_pow]
        rw [Finsupp.prod_mul]
        congr 1
        rw [← hdeg, Finsupp.degree_apply]
        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hX : (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X Ω a)
    have hg : ∀ i : Fin (d + 1), (MvPolynomial.X (a.succAbove i) :
        MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω (1 • 1) := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X Ω _)
    obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin (d + 1)) Ω →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          (MvPolynomial.X a),
        (∀ c : Ω, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0) c)) ∧
        (∀ i : Fin (d + 1), ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hX 1
          (MvPolynomial.X (a.succAbove i)) (hg i)) :=
      ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0)))
        (fun i => HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω)
          hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
        fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
        fun i => by rw [MvPolynomial.eval₂Hom_X']⟩
    obtain ⟨ρt, hρC, hρa, hρs, hρdef⟩ : ∃ ρt : MvPolynomial (Fin (d + 1 + 1)) Ω →+*
        MvPolynomial (Fin (d + 1)) Ω,
        (∀ c : Ω, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
        (∀ i : Fin (d + 1), ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) ∧
        ρt = MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (d + 1)) Ω) a 1 MvPolynomial.X) :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (d + 1)) Ω) a 1 MvPolynomial.X),
        fun c => by rw [MvPolynomial.eval₂Hom_C],
        by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
        fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove], rfl⟩
    have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
    have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) *
        algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
          (MvPolynomial.X a) = 1 := by
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
    obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X a) →+*
        MvPolynomial (Fin (d + 1)) Ω,
        (∀ z y, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) z =
          algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) y →
            ρ z = ρt y) ∧
        (∀ (n : ℕ) (F : MvPolynomial (Fin (d + 1 + 1)) Ω)
          (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω (n • 1)),
          ρ (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hX n F hF) = ρt F) := by
      refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω) →+*
            MvPolynomial (Fin (d + 1)) Ω).comp (algebraMap _ _), ?_, ?_⟩
      · intro z y hzy
        rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
      · intro n F hF
        rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk]
        have hs := IsLocalization.mk'_spec
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) F
          (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
            Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
        rw [← Localization.mk_eq_mk'_apply] at hs
        have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω) →+*
            MvPolynomial (Fin (d + 1)) Ω) hs
        rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
        simp only [map_pow, hρa, one_pow, mul_one] at hs2
        exact hs2
    have hΨC : ∀ c : Ω, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
          (ψ (MvPolynomial.C c)) =
        algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
          (MvPolynomial.C c) := by
      intro c
      rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
      have h1 : ((algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 0)) :
            MvPolynomial (Fin (d + 1 + 1)) Ω) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    have hΨX : ∀ i : Fin (d + 1), algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
          (ψ (MvPolynomial.X i)) =
        (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) *
        algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
          (MvPolynomial.X (a.succAbove i)) := by
      intro i
      rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      congr 1
      ext
      simp
    have hcomp : ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))).comp ψ).comp
          ρt =
        MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))).comp
            MvPolynomial.C)
          (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) *
            algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
              (MvPolynomial.X j)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
          RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
        rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
        · subst h
          rw [hρa, map_one, map_one, hu1]
        · subst h
          rw [hρs, hΨX]
    have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))).comp
            MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
              (MvPolynomial.X j)) =
        algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X']
    have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (d + 1 + 1)) Ω), F.IsHomogeneous n →
        algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) (ψ (ρt F)) *
          algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
            (MvPolynomial.X a ^ n) =
        algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) F := by
      intro n F hF
      have h1 := RingHom.congr_fun hcomp F
      rw [RingHom.comp_apply, RingHom.comp_apply] at h1
      rw [h1, MvPolynomial.coe_eval₂Hom]
      have hs := scale ((algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))).comp
            MvPolynomial.C)
        (fun j => algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
              (MvPolynomial.X j))
        (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
      rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
      calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) ^ n *
            algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) F *
            algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
              (MvPolynomial.X a) ^ n
          = ((Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) *
            algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω))
              (MvPolynomial.X a)) ^ n *
            algebraMap (MvPolynomial (Fin (d + 1 + 1)) Ω)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (d + 1 + 1)) Ω)) F := by
            ring
        _ = _ := by rw [hu1, one_pow, one_mul]
    have h1 : ψ.comp ρ = RingHom.id _ := by
      apply RingHom.ext
      intro z
      obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hX z
      rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
      have hFh : F.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at hF
        exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
      apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
      rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
        Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
      exact key n F hFh
    have h2 : ρ.comp ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
      · intro i
        rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
    refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun n F hF => ?_⟩
    rw [RingEquiv.ofRingHom_apply, ← hρdef, ← hρ2 n F hF]
    exact RingHom.congr_fun h1 _

  have main : ∀ (c v p₀ q₀ : Fin (d + 1 + 1)), p₀.val % 2 = 0 → q₀.val = p₀.val + 1 →
      ((p₀ = c ∧ q₀ = v) ∨ (p₀ = v ∧ q₀ = c)) →
      Nonempty ((jY ⁻¹ᵁ wcSgD Ω (d + 1) c : Scheme.{u}) ≅
        Spec (.of (MvPolynomial (Fin d) Ω))) := by
    intro c v p₀ q₀ hp₀ hq₀ hpart
    have hval : (p₀.val = c.val ∧ q₀.val = v.val) ∨ (p₀.val = v.val ∧ q₀.val = c.val) := by
      rcases hpart with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact Or.inl ⟨congrArg Fin.val h1, congrArg Fin.val h2⟩
      · exact Or.inr ⟨congrArg Fin.val h1, congrArg Fin.val h2⟩
    have hvc : v ≠ c := by
      intro h
      have := congrArg Fin.val h
      omega
    obtain ⟨u', hu'⟩ := Fin.exists_succAbove_eq hvc

    have s3 : ∃ g₀ : MvPolynomial (Fin d) Ω,
        MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin (d + 1)) Ω) c 1 MvPolynomial.X)
          (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
              MvPolynomial (Fin (d + 1 + 1)) Ω) =
        MvPolynomial.X u' + MvPolynomial.rename u'.succAbove g₀ := by
      set y : Fin (d + 1 + 1) → MvPolynomial (Fin (d + 1)) Ω :=
        Fin.insertNth (α := fun _ => MvPolynomial (Fin (d + 1)) Ω) c 1 MvPolynomial.X with hy
      have hyc : y c = 1 := Fin.insertNth_apply_same _ _ _
      have hyv : y v = MvPolynomial.X u' := by
        rw [← hu']
        exact Fin.insertNth_apply_succAbove _ _ _ _
      have hyR : ∀ p : Fin (d + 1 + 1), p ≠ c → p ≠ v →
          y p ∈ (MvPolynomial.rename (R := Ω) u'.succAbove).range := by
        intro p hpc hpv
        obtain ⟨p', rfl⟩ := Fin.exists_succAbove_eq hpc
        have hyp : y (c.succAbove p') = MvPolynomial.X p' :=
          Fin.insertNth_apply_succAbove _ _ _ _
        rw [hyp]
        have hne : p' ≠ u' := by
          intro h
          apply hpv
          rw [h, hu']
        obtain ⟨j, hj⟩ := Fin.exists_succAbove_eq hne
        exact (AlgHom.mem_range _).mpr ⟨MvPolynomial.X j, by rw [MvPolynomial.rename_X, hj]⟩
      have hsum : MvPolynomial.eval₂Hom MvPolynomial.C y
          (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
              MvPolynomial (Fin (d + 1 + 1)) Ω) =
          ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
            MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) *
              (y p * y q) := by
        show MvPolynomial.eval₂Hom MvPolynomial.C y (∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
          MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) *
            (MvPolynomial.X p * MvPolynomial.X q)) = _
        simp only [map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      have hterm : ∀ p q : Fin (d + 1 + 1),
          MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) *
            (y p * y q) - (if p = p₀ ∧ q = q₀ then MvPolynomial.X u' else 0) ∈
          (MvPolynomial.rename (R := Ω) u'.succAbove).range := by
        intro p q
        by_cases hpq : p.val % 2 = 0 ∧ q.val = p.val + 1
        · rw [if_pos hpq, map_one, one_mul]
          by_cases h0 : p = p₀ ∧ q = q₀
          · rw [if_pos h0]
            obtain ⟨rfl, rfl⟩ := h0
            rcases hpart with ⟨h1, h2⟩ | ⟨h1, h2⟩
            · rw [h1, h2, hyc, hyv, one_mul, sub_self]; exact zero_mem _
            · rw [h1, h2, hyc, hyv, mul_one, sub_self]; exact zero_mem _
          · rw [if_neg h0, sub_zero]
            have hp0 : ¬ (p.val = p₀.val ∧ q.val = q₀.val) := fun h =>
              h0 ⟨Fin.ext h.1, Fin.ext h.2⟩
            have hpc : p ≠ c := fun h => by have := congrArg Fin.val h; omega
            have hpv : p ≠ v := fun h => by have := congrArg Fin.val h; omega
            have hqc : q ≠ c := fun h => by have := congrArg Fin.val h; omega
            have hqv : q ≠ v := fun h => by have := congrArg Fin.val h; omega
            exact Subalgebra.mul_mem _ (hyR p hpc hpv) (hyR q hqc hqv)
        · rw [if_neg hpq, map_zero, zero_mul, zero_sub]
          have h0 : ¬ (p = p₀ ∧ q = q₀) := by
            rintro ⟨rfl, rfl⟩
            exact hpq ⟨hp₀, hq₀⟩
          rw [if_neg h0, neg_zero]
          exact zero_mem _
      have hδ : ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
          (if p = p₀ ∧ q = q₀ then (MvPolynomial.X u' : MvPolynomial (Fin (d + 1)) Ω) else 0) =
          MvPolynomial.X u' := by
        rw [Fintype.sum_eq_single p₀ (fun p hp => Finset.sum_eq_zero
            (fun q _ => if_neg (fun h => hp h.1))),
          Fintype.sum_eq_single q₀ (fun q hq => if_neg (fun h => hq h.2)), if_pos ⟨rfl, rfl⟩]
      have hmem : MvPolynomial.eval₂Hom MvPolynomial.C y
          (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
              MvPolynomial (Fin (d + 1 + 1)) Ω) - MvPolynomial.X u' ∈
          (MvPolynomial.rename (R := Ω) u'.succAbove).range := by
        rw [hsum, ← hδ, ← Finset.sum_sub_distrib]
        refine Subalgebra.sum_mem _ (fun p _ => ?_)
        rw [← Finset.sum_sub_distrib]
        exact Subalgebra.sum_mem _ (fun q _ => hterm p q)
      obtain ⟨g₀, hg₀⟩ := (AlgHom.mem_range _).mp hmem
      exact ⟨g₀, by rw [hg₀]; ring⟩
    obtain ⟨g₀, hg₀⟩ := s3
    obtain ⟨e, he⟩ := s1 c
    obtain ⟨hφs, hφk⟩ := s2 d u' g₀
    have hXc : (MvPolynomial.X c : MvPolynomial (Fin (d + 1 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω c)
    have heH := he 2 _ (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).2
    rw [hg₀] at heH
    obtain ⟨π, hπ⟩ : ∃ π : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X c) →+*
        MvPolynomial (Fin d) Ω, ∀ x, π x = MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin d) Ω) u' (-g₀) MvPolynomial.X)
          (e.symm x) :=
      ⟨(MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin d) Ω) u' (-g₀) MvPolynomial.X)).comp
          e.symm.toRingHom, fun x => rfl⟩
    have hπs : Function.Surjective π := by
      intro b
      obtain ⟨p, hp⟩ := hφs b
      exact ⟨e p, by rw [hπ, RingEquiv.symm_apply_apply, hp]⟩
    have hπk : RingHom.ker π = Ideal.span {HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hXc 2
        (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
            MvPolynomial (Fin (d + 1 + 1)) Ω)
        (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).2} := by
      ext x
      rw [RingHom.mem_ker, Ideal.mem_span_singleton', hπ, ← RingHom.mem_ker, hφk,
        Ideal.mem_span_singleton']
      constructor
      · rintro ⟨a, ha⟩
        refine ⟨e a, ?_⟩
        rw [← heH, ← map_mul, ha, RingEquiv.apply_symm_apply]
      · rintro ⟨b, hb⟩
        refine ⟨e.symm b, ?_⟩
        rw [← hb, map_mul, ← heH, RingEquiv.symm_apply_apply]

    obtain ⟨iso, hiso⟩ : ∃ iso, iso = Proj.basicOpenIsoSpec
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X c) hXc
        Nat.one_pos := ⟨_, rfl⟩
    have hstar : ∀ x : Spec (.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X c))),
        ((wcSgD Ω (d + 1) c).ι (iso.inv x) ∈ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
          (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
              MvPolynomial (Fin (d + 1 + 1)) Ω)) ↔
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hXc 2
          (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
              MvPolynomial (Fin (d + 1 + 1)) Ω)
          (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).2 ∉ x.asIdeal := by
      intro x
      have e1 : (wcSgD Ω (d + 1) c).ι (iso.inv x) = Proj.awayι
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X c) hXc
          Nat.one_pos x := by
        rw [← Scheme.Hom.comp_apply, hiso, Proj.basicOpenIsoSpec_inv_ι]
      have hpre := Proj.awayι_preimage_basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hXc Nat.one_pos
        (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).2 (by norm_num : 0 < 2)
      have ha : HomogeneousLocalization.Away.isLocalizationElem hXc
          (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).2 =
          HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hXc 2
            (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
              if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
                MvPolynomial (Fin (d + 1 + 1)) Ω)
            (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
              if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).2 := by
        apply HomogeneousLocalization.val_injective
        simp [HomogeneousLocalization.Away.val_mk]
      rw [e1, ← Scheme.Hom.mem_preimage, hpre, ha]
      exact Iff.rfl
    obtain ⟨mz, hmz⟩ : ∃ mz : Spec (.of (MvPolynomial (Fin d) Ω)) ⟶
        (wcSgD Ω (d + 1) c : Scheme.{u}), mz = Spec.map (CommRingCat.ofHom π) ≫ iso.inv :=
      ⟨_, rfl⟩
    have : IsClosedImmersion (Spec.map (CommRingCat.ofHom π)) :=
      IsClosedImmersion.spec_of_surjective _ hπs
    have : IsClosedImmersion mz := by rw [hmz]; infer_instance
    have hrm : Set.range mz = {x | (wcSgD Ω (d + 1) c).ι x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
        (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
            MvPolynomial (Fin (d + 1 + 1)) Ω)} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Set.mem_setOf_eq, hmz, Scheme.Hom.comp_apply, hstar, not_not, Spec.map_apply]
        refine (Ideal.mem_comap (f := π) (K := z.asIdeal)).mpr ?_
        have h0 : π (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) hXc 2
            (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
              if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
                MvPolynomial (Fin (d + 1 + 1)) Ω)
            (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
              if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0)).2) = 0 := by
          rw [← RingHom.mem_ker, hπk]
          exact Ideal.mem_span_singleton_self _
        rw [h0]
        exact zero_mem _
      · intro hy
        have hy' : (wcSgD Ω (d + 1) c).ι (iso.inv (iso.hom y)) ∉ @Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
            (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
              if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
                MvPolynomial (Fin (d + 1 + 1)) Ω) := by
          rw [Scheme.hom_inv_apply]
          exact hy
        rw [hstar, not_not] at hy'
        have hm : (show PrimeSpectrum (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) (MvPolynomial.X c)) from
            iso.hom y) ∈ PrimeSpectrum.zeroLocus (RingHom.ker π : Set _) := by
          rw [PrimeSpectrum.mem_zeroLocus, hπk]
          exact fun w hw => (Ideal.span_singleton_le_iff_mem _).mpr hy' hw
        rw [← range_comap_of_surjective _ π hπs] at hm
        obtain ⟨z, hz⟩ := hm
        let z' : Spec (.of (MvPolynomial (Fin d) Ω)) := z
        have e2 : (Spec.map (CommRingCat.ofHom π)) z' = iso.hom y := by
          rw [Spec.map_apply]
          exact hz
        refine ⟨z', ?_⟩
        rw [hmz, Scheme.Hom.comp_apply, e2, Scheme.hom_inv_apply]

    have hrf : Set.range (jY ∣_ wcSgD Ω (d + 1) c) = {x | (wcSgD Ω (d + 1) c).ι x ∉
        @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra
        (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) :
            MvPolynomial (Fin (d + 1 + 1)) Ω)} := by
      ext x
      constructor
      · rintro ⟨w, rfl⟩
        show (wcSgD Ω (d + 1) c).ι ((jY ∣_ wcSgD Ω (d + 1) c) w) ∉ _
        rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
        have hmem : jY ((jY ⁻¹ᵁ wcSgD Ω (d + 1) c).ι w) ∈ Set.range jY := ⟨_, rfl⟩
        rw [hY] at hmem
        exact hmem
      · intro hx
        have hmem : (wcSgD Ω (d + 1) c).ι x ∈ Set.range jY := by rw [hY]; exact hx
        obtain ⟨w, hw⟩ := hmem
        have hwU : w ∈ jY ⁻¹ᵁ wcSgD Ω (d + 1) c := by
          show jY w ∈ wcSgD Ω (d + 1) c
          rw [hw]
          exact x.2
        refine ⟨⟨w, hwU⟩, ?_⟩
        apply (wcSgD Ω (d + 1) c).ι.isOpenEmbedding.injective
        have e3 := Scheme.Hom.comp_apply (jY ∣_ wcSgD Ω (d + 1) c) (wcSgD Ω (d + 1) c).ι
          ⟨w, hwU⟩
        rw [morphismRestrict_ι] at e3
        exact e3.symm.trans hw
    exact s5 _ _ _ (jY ∣_ wcSgD Ω (d + 1) c) mz (hrf.trans hrm.symm)

  by_cases hkd : k ≤ d / 2
  · exact main _ ⟨2 * k, by omega⟩ ⟨2 * k, by omega⟩ _ (by simp only; omega)
      (by simp only [if_pos hkd]) (Or.inr ⟨rfl, rfl⟩)
  · exact main _ ⟨d + 1, by omega⟩ _ ⟨d + 1, by omega⟩ (by simp only [if_neg hkd]; omega)
      (by simp only [if_neg hkd]) (Or.inl ⟨rfl, rfl⟩)

theorem wc_hq_chart_overlap_iso : ∀ (Ω : Type u) [Field Ω] (d : ℕ), Even d → 2 ≤ d → ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] (jY : Y ⟶ wcProjK Ω (d + 1)), IsClosedImmersion jY → Set.range jY = {p | p ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1 + 1)) Ω) MvPolynomial.gradedAlgebra (wcLdpQuad Ω (d + 1) (fun p q : Fin (d + 1 + 1) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : Ω) else 0) : MvPolynomial (Fin (d + 1 + 1)) Ω)} → ∀ k : ℕ, 1 ≤ k → k ≤ d / 2 + 1 → ∃ E : (Spec (.of (MvPolynomial (Fin d) Ω))).Opens, (E : Set (Spec (.of (MvPolynomial (Fin d) Ω)))) = {x | ∃ j : Fin d, j.val < min k (d / 2) ∧ (MvPolynomial.X j : MvPolynomial (Fin d) Ω) ∉ x.asIdeal} ∧ Nonempty ((((jY ⁻¹ᵁ wcSgD Ω (d + 1) ⟨if k ≤ d / 2 then 2 * k + 1 else d, by split_ifs <;> omega⟩) ⊓ ⨆ (i : ℕ) (_ : i < k), jY ⁻¹ᵁ wcSgD Ω (d + 1) ⟨if i ≤ d / 2 then 2 * i + 1 else d, by split_ifs <;> omega⟩ : Y.Opens) : Scheme.{u}) ≅ (E : Scheme.{u})) :=
by
  intro Ω _ d hd hd2 Y _ jY hjY hY k hk1 hk
  have L1 : ∀ (Y P S M : Scheme.{u}) [AlgebraicGeometry.IsReduced Y] [AlgebraicGeometry.IsReduced M] (jY : Y ⟶ P) [IsClosedImmersion jY] (a : S ⟶ P) [IsOpenImmersion a] (μ : M ⟶ S) [IsClosedImmersion μ] (hr : Set.range (μ ≫ a) = Set.range a ∩ Set.range jY) (U : Set P) (O : Y.Opens) (E : M.Opens) (hO : ∀ x : Y, x ∈ O ↔ jY x ∈ Set.range a ∧ jY x ∈ U) (hE : ∀ y : M, y ∈ E ↔ (μ ≫ a) y ∈ U), Nonempty ((O : Scheme.{u}) ≅ (E : Scheme.{u})) := by
    intro Y P S M _ _ jY _ a _ μ _ hr U O E hO hE
    have e1 : ∀ (W X Y : Scheme.{u}) (g : W ⟶ Y) (z : X ⟶ Y) [IsClosedImmersion z] [IsReduced W], Set.range g ⊆ Set.range z → ∃ g' : W ⟶ X, g' ≫ z = g := by
      intro W X Y g z _ _ hrange
      have H : z.ker ≤ g.ker := by
        show z.ker ≤ Scheme.IdealSheafData.ofIdeals (fun U : Y.affineOpens => RingHom.ker (g.app U).hom)
        rw [Scheme.IdealSheafData.le_ofIdeals_iff]
        intro U s hs
        have hz : (z.app U).hom s = 0 :=
          Scheme.IdealSheafData.ideal_ofIdeals_le
            (I := fun U : Y.affineOpens => RingHom.ker (z.app U).hom) U hs
        have hX : z ⁻¹ᵁ Y.basicOpen s = ⊥ := by
          rw [Scheme.Hom.preimage_basicOpen]
          erw [hz]
          exact Scheme.basicOpen_zero _ _
        have hW : W.basicOpen ((g.app U).hom s) = ⊥ := by
          rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
          intro w hw
          obtain ⟨x, hx⟩ := hrange ⟨w, rfl⟩
          have hx' : x ∈ z ⁻¹ᵁ Y.basicOpen s := by
            show z x ∈ Y.basicOpen s
            rw [hx]; exact hw
          rw [hX] at hx'
          exact hx'.elim
        exact eq_zero_of_basicOpen_eq_bot _ hW
      exact ⟨IsClosedImmersion.lift z g H, IsClosedImmersion.lift_fac z g H⟩
    have hOmem : ∀ x : (O : Scheme.{u}), O.ι x ∈ O := fun x => by
      have : O.ι x ∈ Set.range O.ι := ⟨x, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have hEmem : ∀ y : (E : Scheme.{u}), E.ι y ∈ E := fun y => by
      have : E.ι y ∈ Set.range E.ι := ⟨y, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have h1 : Set.range (O.ι ≫ jY) ⊆ Set.range a := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact ((hO (O.ι x)).mp (hOmem x)).1
    let h := IsOpenImmersion.lift a (O.ι ≫ jY) h1
    have hh : h ≫ a = O.ι ≫ jY := IsOpenImmersion.lift_fac _ _ _
    have h2 : Set.range h ⊆ Set.range μ := by
      rintro _ ⟨x, rfl⟩
      have hx : a (h x) ∈ Set.range (μ ≫ a) := by
        rw [hr]
        refine ⟨⟨h x, rfl⟩, ⟨O.ι x, ?_⟩⟩
        rw [← Scheme.Hom.comp_apply, ← hh, Scheme.Hom.comp_apply]
      obtain ⟨m', hm'⟩ := hx
      exact ⟨m', a.isOpenEmbedding.injective (by rw [← Scheme.Hom.comp_apply]; exact hm')⟩
    obtain ⟨g, hg⟩ := e1 _ _ _ h μ h2
    have h3 : Set.range g ⊆ Set.range E.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      rw [SetLike.mem_coe, hE]
      have e : (μ ≫ a) (g x) = jY (O.ι x) := by
        rw [← Scheme.Hom.comp_apply, ← Category.assoc, hg, hh, Scheme.Hom.comp_apply]
      rw [e]
      exact ((hO (O.ι x)).mp (hOmem x)).2
    let g' := IsOpenImmersion.lift E.ι g h3
    have hg' : g' ≫ E.ι = g := IsOpenImmersion.lift_fac _ _ _
    have h4 : Set.range (E.ι ≫ μ ≫ a) ⊆ Set.range jY := by
      rintro _ ⟨y, rfl⟩
      have : (E.ι ≫ μ ≫ a) y ∈ Set.range (μ ≫ a) := ⟨E.ι y, rfl⟩
      rw [hr] at this
      exact this.2
    obtain ⟨f, hf⟩ := e1 _ _ _ (E.ι ≫ μ ≫ a) jY h4
    have h5 : Set.range f ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      rw [SetLike.mem_coe, hO]
      have e : jY (f y) = (μ ≫ a) (E.ι y) := by
        rw [← Scheme.Hom.comp_apply, hf, Scheme.Hom.comp_apply]
      rw [e]
      refine ⟨?_, (hE (E.ι y)).mp (hEmem y)⟩
      have : (μ ≫ a) (E.ι y) ∈ Set.range (μ ≫ a) := ⟨E.ι y, rfl⟩
      rw [hr] at this
      exact this.1
    let f' := IsOpenImmersion.lift O.ι f h5
    have hf' : f' ≫ O.ι = f := IsOpenImmersion.lift_fac _ _ _
    refine ⟨⟨g', f', ?_, ?_⟩⟩
    · rw [← cancel_mono (O.ι ≫ jY)]
      rw [Category.id_comp, Category.assoc, ← Category.assoc f', hf', hf, ← Category.assoc,
        ← Category.assoc, hg', Category.assoc, ← Category.assoc g, hg, hh]
    · rw [← cancel_mono (E.ι ≫ μ ≫ a)]
      rw [Category.id_comp, Category.assoc, ← Category.assoc g', hg', ← Category.assoc g, hg,
        ← Category.assoc, Category.assoc, hh, ← Category.assoc, hf', hf]

  have L4 : ∀ (K A : Type u) [CommRing K] [CommRing A] (ι : K →+* A) (N n' : ℕ) (t : Fin N → A) (c u : Fin N) (τ : Fin N → MvPolynomial (Fin n') K) (s : Fin n' → Fin N) (ψ : A →+* MvPolynomial (Fin n') K) (hgen : ∀ z : A, ∃ F : MvPolynomial (Fin N) K, MvPolynomial.eval₂ ι t F = z) (htc : t c = 1) (hψι : ∀ a : K, ψ (ι a) = MvPolynomial.C a) (hψt : ∀ j : Fin N, ψ (t j) = τ j) (hτs : ∀ b : Fin n', τ (s b) = MvPolynomial.X b) (hcov : ∀ j : Fin N, j ≠ c → j ≠ u → ∃ b : Fin n', s b = j), Function.Surjective ψ ∧ RingHom.ker ψ = Ideal.span {t u - MvPolynomial.eval₂ ι (fun b => t (s b)) (τ u)} := by
    intro K A _ _ ι N n' t c u τ s ψ hgen htc hψι hψt hτs hcov
    set σ : MvPolynomial (Fin n') K →+* A := MvPolynomial.eval₂Hom ι (fun b => t (s b)) with hσ
    have hψσ : ψ.comp σ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, hσ, MvPolynomial.eval₂Hom_C, hψι, RingHom.id_apply]
      · intro b
        rw [RingHom.comp_apply, hσ, MvPolynomial.eval₂Hom_X', hψt, hτs, RingHom.id_apply]
