    have h0 : (Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
        (ObjectProperty.homMk
          (X := (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))))
          (Y := (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))))
          (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ') ≫ 0 ≫
