        obtain ⟨i, hi⟩ := hex
        obtain ⟨w', hw'w, hw'⟩ := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).2
          ((wcEtToProEt (wcP1Over F'').left).obj W) w ⟨i, hi⟩
        have hw'O : ∀ j : Fin D.m, W.hom w' ≠ D.S j (IsLocalRing.closedPoint F'') := by
          intro j hj
          exact hw' ⟨j, hj⟩
        obtain ⟨W₁, f₁, hv, hf₁⟩ := wc_pencil_et_Rq_cospec_injective F' F'' Y n hn hn2 D ℓ hℓ
          k I W s w w' i hi hw'w hw'O
          ⟨_, wcEtOpenι (wcP1Over F'').left W (W.hom ⁻¹ᵁ O), by
            show w' ∈ Set.range (W.hom ⁻¹ᵁ O).ι
            rw [Scheme.Opens.range_ι]
            exact (hO _).2 hw'O, hs⟩
        exact ⟨W₁, f₁, hv, hf₁⟩)
    simpa using hall

  obtain ⟨c, hc⟩ := wc_pencil_et_Rq_local_bounded_extension F' F'' Y n hn hn2 D ℓ hℓ O hO
  refine ⟨c, ?_⟩
  intro k I V _hVaff h
  exact glue (wcP1Over F'').left O _ (ℓ ^ c) (hinj k I) V h (fun v hv => by
    have hex : ∃ i : Fin D.m, V.hom v = D.S i (IsLocalRing.closedPoint F'') := by
      by_contra hne
      push_neg at hne
      exact hv ((hO _).2 hne)
    obtain ⟨i, hi⟩ := hex
    exact hc k I V h v i hi)

