    have hw1 : WeaklyEtale ((wcProEtPullback D.f).obj V₀).hom :=
      ((wcProEtPullback D.f).obj V₀).prop
    have hw2 : WeaklyEtale (g.left ≫ ((wcProEtPullback D.f).obj V₀).hom) := by
      rw [MorphismProperty.Over.w g]; exact Th.prop
    exact @WeaklyEtale.of_comp _ _ _ g.left _ hw2 hw1
  haveI hcE : WeaklyEtale (eB.inv ≫ g.left) := inferInstance
  have hc0 : (eB.inv ≫ g.left) (IsLocalRing.closedPoint B) = xb := by
    have hmem : eB.inv (IsLocalRing.closedPoint B) ∈ g.left ⁻¹' {xb} := by
      rw [hpre]; exact Set.mem_singleton _
    exact (Scheme.Hom.comp_apply _ _ _).trans hmem

  have hgeom : ∀ {X T : Scheme.{u}} (x : X) (gT : T ⟶ X) (eT : T ≅ Spec (.of B))
      (hpreT : gT ⁻¹' {x} = {eT.inv (IsLocalRing.closedPoint B)})
      (hfibT : IsIso (Limits.pullback.snd gT (X.fromSpecResidueField x))),
      ∃ q : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶ Spec (.of B),
        q (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) =
          IsLocalRing.closedPoint B ∧
        q ≫ (eT.inv ≫ gT) = wcEtGeomPt X x := by
    intro X T x gT eT hpreT hfibT
    have e1 : (Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
        inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
          Limits.pullback.fst gT (X.fromSpecResidueField x)) ≫ gT =
        Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫ X.fromSpecResidueField x := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition, IsIso.inv_hom_id_assoc]
    refine ⟨(Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
        inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
          Limits.pullback.fst gT (X.fromSpecResidueField x)) ≫ eT.hom, ?_, ?_⟩
    · have ht : gT ((Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
            inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
              Limits.pullback.fst gT (X.fromSpecResidueField x))
            (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) = x :=
        (Scheme.Hom.comp_apply _ gT _).symm.trans
          ((congrArg (fun φ => φ (IsLocalRing.closedPoint
              (AlgebraicClosure (X.residueField x)))) e1).trans
            ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)))
      have hmem : ((Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
            inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
              Limits.pullback.fst gT (X.fromSpecResidueField x))
            (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) ∈
          gT ⁻¹' {x} := ht
      rw [hpreT] at hmem
      exact (Scheme.Hom.comp_apply _ _ _).trans
        ((congrArg eT.hom (Set.mem_singleton_iff.mp hmem)).trans (Scheme.inv_hom_apply _ _))
    · rw [Category.assoc, Iso.hom_inv_id_assoc, e1]
  obtain ⟨q, hq0, hq1⟩ := hgeom xb g.left eB hpre hfib

  obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point xb B' Λ' W'' φ' a' hsh B (eB.inv ≫ g.left) q
    hq0 hq1
  haveI hδi : IsIso δ := wc_pltr_shens_lift_iso xb B' Λ' W'' φ' a' hsh B (eB.inv ≫ g.left)
    hcE hc0 δ hδ
  have hψ : (inv δ ≫ eB.inv) ≫ g.left = a' := by
    rw [Category.assoc, ← hδ, IsIso.inv_hom_id_assoc]

  obtain ⟨μ, κ, hμκ⟩ : ∃ (μ : Fm.left ⟶ Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)
      (κ : Limits.pullback a' ((wcProEtPullback D.f).map a₀).left ⟶ Fm.left),
      μ ≫ κ = 𝟙 Fm.left := by
    have w1 : (Limits.pullback.fst a' ((wcProEtPullback D.f).map a₀).left ≫ inv δ ≫ eB.inv) ≫
        g.left = Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left ≫
          ((wcProEtPullback D.f).map a₀).left := by
      rw [Category.assoc, hψ]
      exact Limits.pullback.condition
    have w2 : (rT.left ≫ eB.hom ≫ δ) ≫ a' = rW.left ≫ ((wcProEtPullback D.f).map a₀).left := by
      simp only [Category.assoc]
      rw [hδ, Iso.hom_inv_id_assoc]
      exact hpb.toCommSq.w
    refine ⟨Limits.pullback.lift _ _ w2, hpb.lift _ _ w1, ?_⟩
    apply hpb.hom_ext
    · rw [Category.assoc, IsPullback.lift_fst, Limits.pullback.lift_fst_assoc]
      simp only [Category.assoc, IsIso.hom_inv_id_assoc, Iso.hom_inv_id, Category.comp_id,
        Category.id_comp]
    · rw [Category.assoc, IsPullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]

  obtain ⟨Dκ, hDκ⟩ := wc_zmod_pull_data_exists κ (ℓ ^ k)
  obtain ⟨Dμ, hDμ⟩ := wc_zmod_pull_data_exists μ (ℓ ^ k)
  obtain ⟨D1, hD1⟩ := wc_zmod_pull_data_exists (𝟙 Fm.left) (ℓ ^ k)
  have hret : ∀ x : wcZModProEtExt Fm.left (ℓ ^ k) (n - 1),
      wcZModPull Dμ (n - 1) (wcZModPull Dκ (n - 1) x) = x := fun x => by
    rw [← wc_zmod_pull_comp κ μ (𝟙 _) hμκ Dκ hDκ Dμ hDμ D1 hD1 (n - 1) x,
      wc_zmod_pull_id (𝟙 _) rfl D1 hD1 (n - 1) x]
  have hinj : Function.Injective (fun x => wcZModPull Dκ (n - 1) x) := by
    intro x y hxy
    have h := congrArg (fun t => wcZModPull Dμ (n - 1) t) hxy
    simp only at h
    rwa [hret, hret] at h
  haveI hfinFib : Finite (wcZModProEtExt (Limits.pullback a' ((wcProEtPullback D.f).map a₀).left)
      (ℓ ^ k) (n - 1)) := Nat.finite_of_card_ne_zero (by rw [hcardFib]; exact hm)
  exact (Nat.card_le_card_of_injective _ hinj).trans hcardFib.le

theorem wc_pmtv_punct_top_generator (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓK : ((ℓ : ℕ) : K) ≠ 0) (m q : ℕ) (hm : 1 ≤ m) (hq : q + 1 = 2 * m)
    (U₀ : (Spec (.of (MvPolynomial (Fin m) K))).Opens)
    (hU₀ : (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
      (Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K))))ᶜ)
    (k : ℕ) (hk : 1 ≤ k) :
    ∃ ω : wcZModProEtExt (U₀ : Scheme.{u}) (ℓ ^ k) q, ℓ ^ k ≤ addOrderOf ω :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hℓp.pos

  have transfer : ∀ (S : Scheme.{u}) [CompactSpace S] [QuasiSeparatedSpace S] (N : ℕ),
      (∀ kk : ℕ, 1 ≤ kk → Nat.card (wcEtCoh S (ℓ ^ kk) N) = ℓ ^ kk) →
      Subsingleton (wcEtCoh S ℓ (N + 1)) →
      ∀ kk : ℕ, 1 ≤ kk → ∃ ω : wcZModProEtExt S (ℓ ^ kk) N, ℓ ^ kk ≤ addOrderOf ω := by
    intro S hcS hqS N hcard htopE kk hkk
    have EP : ∀ n j : ℕ, Nonempty (wcZModProEtExt S n j ≃ wcEtCoh S n j) := by
      intro n j
      obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all.{u} n j
      obtain ⟨Ez⟩ := wc_et_zmodext_coh_equiv S n j
      exact ⟨(Equiv.ofBijective (Θ S) (hΘ S hcS hqS)).symm.trans Ez⟩
    have hfinE : ∀ k : ℕ, 1 ≤ k → Finite (wcEtCoh S (ℓ ^ k) N) := fun k hk =>
      Nat.finite_of_card_ne_zero (by rw [hcard k hk]; exact (pow_pos hℓpos k).ne')
    have pf1 : Finite (wcZModProEtExt S ℓ N) := by
      have h := hfinE 1 le_rfl
      rw [pow_one] at h
      exact Finite.of_equiv _ (EP ℓ N).some.symm
    have pc1 : Nat.card (wcZModProEtExt S ℓ N) ≤ ℓ := by
      have h := hcard 1 le_rfl
      rw [pow_one] at h
      exact ((Nat.card_congr (EP ℓ N).some).trans h).le
    have ps1 : Subsingleton (wcZModProEtExt S ℓ (N + 1)) := by
      haveI := htopE
      exact (EP ℓ (N + 1)).some.subsingleton
    have pge : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt S (ℓ ^ k) N) ∧
        ℓ ^ k ≤ Nat.card (wcZModProEtExt S (ℓ ^ k) N) := by
      intro k hk
      haveI := hfinE k hk
      exact ⟨Finite.of_equiv _ (EP (ℓ ^ k) N).some.symm,
        ((Nat.card_congr (EP (ℓ ^ k) N).some).trans (hcard k hk)).ge⟩
    let U : S.ProEt := Scheme.ProEt.mk (𝟙 S)
    have Em : ∀ n : ℕ, 0 < n → ∀ j : ℕ,
        Nonempty (wcZModProEtExt S n j ≃+ Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S n) j) := by
      intro n hn j
      obtain ⟨Φ, hΦb, -, -⟩ := wc_proet_free_zmod_ext_mod_model.{u} n j hn
      exact ⟨AddEquiv.ofBijective (Φ S U) (hΦb S U)⟩
    obtain ⟨E1⟩ := Em ℓ hℓpos N
    obtain ⟨E2⟩ := Em ℓ hℓpos (N + 1)
    have h1 : Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) :=
      Finite.of_equiv _ E1.toEquiv
    have h2 : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) N) ≤ ℓ := by
      rw [← Nat.card_congr E1.toEquiv]
      exact pc1
    have h3 : ∀ z : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S ℓ) (N + 1), z = 0 := by
      intro z
      rw [← E2.apply_symm_apply z, Subsingleton.elim (E2.symm z) 0, map_zero]
    have h4 : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) →
        ℓ ^ k ≤ Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ k)) N) := by
      intro k hk _
      obtain ⟨Ek⟩ := Em (ℓ ^ k) (pow_pos hℓpos k) N
      rw [← Nat.card_congr Ek.toEquiv]
      exact (pge k hk).2
    obtain ⟨hcnt, -, -⟩ := wc_local_tower_counts S ℓ (wcFreeSheaf S U) N h1 h2 h3 h4
    have hkill : ∀ (n : ℕ) (t : Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ n)) N),
        ℓ ^ n • t = 0 := by
      intro n t
      have hc' : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ n)) N) = ℓ ^ n :=
        (hcnt n).2
      have h := card_nsmul_eq_zero' (G := Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ n)) N)
        (x := t)
      rw [hc'] at h
      exact h
    have hcyc := wc_zmod_local_nakayama_cyclic S ℓ (wcFreeSheaf S U) N h1 h2 h3 hkill
    obtain ⟨y, hy⟩ := hcyc kk
    have hytop : AddSubgroup.zmultiples y = ⊤ := by
      rw [AddSubgroup.eq_top_iff']
      intro x
      obtain ⟨z, hz⟩ := hy x
      exact AddSubgroup.mem_zmultiples_iff.mpr ⟨z, hz.symm⟩
    have hordy : addOrderOf y = ℓ ^ kk := by
      have hc' : Nat.card (Abelian.Ext (wcFreeSheaf S U) (wcZModSheaf S (ℓ ^ kk)) N) = ℓ ^ kk :=
        (hcnt kk).2
      rw [← Nat.card_zmultiples, hytop, AddSubgroup.card_top]
      exact hc'
    obtain ⟨Ek⟩ := Em (ℓ ^ kk) (pow_pos hℓpos kk) N
    refine ⟨Ek.symm y, ?_⟩
    have hord : addOrderOf (Ek.symm y) = ℓ ^ kk := by
      first
        | (rw [AddEquiv.addOrderOf_eq]; exact hordy)
        | (rw [addOrderOf_injective Ek.symm.toAddMonoidHom Ek.symm.injective y]; exact hordy)
    exact hord.ge

  have hE : (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
      {x | ∃ j : Fin m, j.val < m ∧ (MvPolynomial.X j : MvPolynomial (Fin m) K) ∉ x.asIdeal} := by
    rw [hU₀]
    ext x
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall, Set.mem_setOf_eq]
    exact ⟨fun ⟨j, hj⟩ => ⟨j, j.isLt, hj⟩, fun ⟨j, _, hj⟩ => ⟨j, hj⟩⟩
  have hsub : Subsingleton (wcEtCoh (U₀ : Scheme.{u}) ℓ (q + 1)) :=
    wc_et_affine_partial_punct_vanishing K ℓ hℓp hℓK m m le_rfl U₀ hE (q + 1) (by omega)
  have hq' : 2 * m - 1 = q := by omega
  have hcnt : ∀ kk : ℕ, 1 ≤ kk → Nat.card (wcEtCoh (U₀ : Scheme.{u}) (ℓ ^ kk) q) = ℓ ^ kk := by
    rcases Nat.lt_or_ge m 2 with hm1 | hm2
    ·
      have htors : ∀ (Z : Scheme.{u}) (n j : ℕ) (y : wcEtZModExt Z n j), n • y = 0 := by
        intro Z n j y
        letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z n)) := HasExt.standard _
        have hsm : ∀ (c : ℕ) X (s : (SheafOfModules.unit (wcEtZModRing Z n)).val.obj X),
            ((c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z n))).val.app X).hom s = c • s := by
          intro c X s
          induction c with
          | zero =>
            rw [zero_smul, zero_smul]
            have h00 : ((0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                  SheafOfModules.unit (wcEtZModRing Z n)).val.app X).hom s =
                ((0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                  SheafOfModules.unit (wcEtZModRing Z n)).val.app X).hom s +
                ((0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                  SheafOfModules.unit (wcEtZModRing Z n)).val.app X).hom s := by
              conv_lhs => rw [← add_zero (0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                SheafOfModules.unit (wcEtZModRing Z n))]
              rw [SheafOfModules.add_val, PresheafOfModules.add_app]
              rfl
            exact add_left_cancel (h00.symm.trans (add_zero _).symm)
          | succ c ih =>
            rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app]
            rw [ModuleCat.hom_add, LinearMap.add_apply, ih]
            rfl
        obtain ⟨-, -, -, hn⟩ := wc_et_zmod_ring_locbij Z n
        have hmU : n • 𝟙 (SheafOfModules.unit (wcEtZModRing Z n)) = 0 := by
          apply SheafOfModules.hom_ext
          apply PresheafOfModules.hom_ext
          intro X
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro s
          rw [hsm n X s, show (0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
              SheafOfModules.unit (wcEtZModRing Z n)) =
              0 • 𝟙 (SheafOfModules.unit (wcEtZModRing Z n)) from (zero_smul _ _).symm, hsm 0 X s,
            zero_smul, ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Z n).obj.obj X), hn X, zero_smul]
        have hcomp : ∀ c : ℕ, y.comp (Abelian.Ext.mk₀ (c • 𝟙 (SheafOfModules.unit
            (wcEtZModRing Z n)))) (add_zero j) = c • y := by
          intro c
          induction c with
          | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
          | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
              Abelian.Ext.comp_mk₀_id]
        rw [← hcomp n, hmU, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      have S6 : ∀ (Z : Scheme.{u}) (j : ℕ), Finite (wcEtCoh Z ℓ j) → Nat.card (wcEtCoh Z ℓ j) ≤ ℓ →
          (∃ ω : wcEtZModExt Z ℓ j, ω ≠ 0) → Nat.card (wcEtCoh Z ℓ j) = ℓ := by
        intro Z j hfin hcard hex
        obtain ⟨ω, hω⟩ := hex
        obtain ⟨EO⟩ := wc_et_zmodext_coh_equiv Z ℓ j
        haveI := hfin
        haveI : Finite (wcEtZModExt Z ℓ j) := Finite.of_equiv _ EO.symm
        have hG : Nat.card (wcEtZModExt Z ℓ j) ≤ ℓ := (Nat.card_congr EO).trans_le hcard
        have hord : addOrderOf ω = ℓ := addOrderOf_eq_prime (htors Z ℓ j ω) hω
        have hlow : ℓ ≤ Nat.card (wcEtZModExt Z ℓ j) := by
          have h1 : Nat.card (AddSubgroup.zmultiples ω) = ℓ := by rw [Nat.card_zmultiples, hord]
          have h2 := Nat.card_le_card_of_injective
            (Subtype.val : AddSubgroup.zmultiples ω → wcEtZModExt Z ℓ j) Subtype.val_injective
          exact (le_of_eq h1.symm).trans h2
        rw [← Nat.card_congr EO]
        exact le_antisymm hG hlow
      obtain ⟨hfin, hcard⟩ := wc_et_punctured_affine_coh_card_le K m hm ℓ hℓp hℓK U₀ hU₀
      obtain ⟨ω, hω⟩ := wc_et_punctured_affine_top_ne_zero K ℓ hℓK m hm U₀ hU₀
      have h1 := S6 (U₀ : Scheme.{u}) (2 * m - 1) hfin hcard ⟨ω, hω⟩
      rw [hq'] at h1
      obtain rfl : q = 1 := by omega
      have h2 : Subsingleton (wcEtCoh (U₀ : Scheme.{u}) ℓ 2) := hsub
      have hbot : ∀ x : Spec (.of (MvPolynomial (Fin m) K)), x.asIdeal = ⊥ →
          x ∈ (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) := by
        intro x hx
        rw [hU₀, Set.mem_compl_iff, wc_affine_origin_range_iff]
        intro h
        have h0 := h ⟨0, by omega⟩
        rw [hx, Ideal.mem_bot] at h0
        exact MvPolynomial.X_ne_zero _ h0
      have hne : (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))).Nonempty :=
        ⟨(⊥ : PrimeSpectrum (MvPolynomial (Fin m) K)), hbot _ PrimeSpectrum.asIdeal_bot⟩
      have hirr : IsIrreducible (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) :=
        IsPreirreducible.subset_irreducible
          (IrreducibleSpace.isIrreducible_univ _).isPreirreducible hne U₀.isOpen subset_rfl
          (Set.subset_univ _)
      haveI hirrU : IrreducibleSpace (U₀ : Scheme.{u}) := Subtype.irreducibleSpace hirr
      haveI : ConnectedSpace (U₀ : Scheme.{u}) := inferInstance
      exact wc_et_coh_one_card_prime_pow (U₀ : Scheme.{u}) ℓ hℓp h1 h2
    · intro kk hkk
      have h := wc_et_punct_affine_top_card_prime_pow K ℓ hℓK m hm2 U₀ hU₀ kk hkk
      rw [hq'] at h
      exact h

  haveI : CompactSpace (U₀ : Scheme.{u}) := QuasiCompact.compactSpace_of_compactSpace U₀.ι
  exact transfer (U₀ : Scheme.{u}) q hcnt hsub k hk

theorem wc_pmtv_morse_model_at_B (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb))) :
    ∃ (π : A) (c : Matrix (Fin n) (Fin n) A) (β : wcQuadModelRing A n π c →+* B),
      IsLocalRing.maximalIdeal A = Ideal.span {π} ∧ IsUnit (c + c.transpose).det ∧
      WeaklyEtale (Spec.map (CommRingCat.ofHom β)) ∧
      (∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
        IsLocalRing.maximalIdeal B) ∧
      eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom =
        Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c)))) :=
by
  classical

  have hx₂ : Limits.pullback.snd V₀.hom D.f xb = D.xs i (IsLocalRing.closedPoint F'') := hxb
  have hx₁ : Limits.pullback.fst V₀.hom D.f xb = e.inv (IsLocalRing.closedPoint A) := by
    have hv' : V₀.hom (Limits.pullback.fst V₀.hom D.f xb) =
        D.S i (IsLocalRing.closedPoint F'') :=
      calc V₀.hom (Limits.pullback.fst V₀.hom D.f xb)
          = (Limits.pullback.fst V₀.hom D.f ≫ V₀.hom) xb := (Scheme.Hom.comp_apply _ _ _).symm
        _ = (Limits.pullback.snd V₀.hom D.f ≫ D.f) xb := by
          first
            | rw [Limits.pullback.condition]
            | exact congrArg (fun φ : Limits.pullback V₀.hom D.f ⟶ (wcP1Over F'').left => φ xb)
                Limits.pullback.condition
        _ = D.f (Limits.pullback.snd V₀.hom D.f xb) := Scheme.Hom.comp_apply _ _ _
        _ = D.f (D.xs i (IsLocalRing.closedPoint F'')) := congrArg D.f hx₂
        _ = (D.xs i ≫ D.f) (IsLocalRing.closedPoint F'') := (Scheme.Hom.comp_apply _ _ _).symm
        _ = D.S i (IsLocalRing.closedPoint F'') :=
          congrArg (fun φ => φ (IsLocalRing.closedPoint F'')) (D.hxs i)
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := D.S i)
      _ _ hv'
    obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := D.S i)
      _ _ hv
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure F''))
      infer_instance
    have hzz : z = z' := by
      have h := congrArg ε.inv (Subsingleton.elim (ε.hom z) (ε.hom z'))
      rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at h
    rw [← hz, ← hz', hzz]

  obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', eB', h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization xb
  have hsh : wcHalShData xb B' Λ' W'' φ' a' := ⟨h1, h2, h3, h4, h5, eB', h6, h7⟩
  obtain ⟨π, c, hπ, hc, β', hβ', hX', hA'⟩ :=
    wc_pmn_hc_morse_at_x F' F'' Y n hn hn2 D i V₀ A e hv xb hx₁ hx₂ B' Λ' W'' φ' a' hsh

  haveI hWE : WeaklyEtale g.left := by
    have hw1 : WeaklyEtale ((wcProEtPullback D.f).obj V₀).hom :=
      ((wcProEtPullback D.f).obj V₀).prop
    have hw2 : WeaklyEtale (g.left ≫ ((wcProEtPullback D.f).obj V₀).hom) := by
      rw [MorphismProperty.Over.w g]; exact Th.prop
    exact @WeaklyEtale.of_comp _ _ _ g.left _ hw2 hw1
  haveI hcE : WeaklyEtale (eB.inv ≫ g.left) := inferInstance
  have hc0 : (eB.inv ≫ g.left) (IsLocalRing.closedPoint B) = xb := by
    have hmem : eB.inv (IsLocalRing.closedPoint B) ∈ g.left ⁻¹' {xb} := by
      rw [hpre]; exact Set.mem_singleton _
    exact (Scheme.Hom.comp_apply _ _ _).trans hmem

  have hgeom : ∀ {X T : Scheme.{u}} (x : X) (gT : T ⟶ X) (eT : T ≅ Spec (.of B))
      (hpreT : gT ⁻¹' {x} = {eT.inv (IsLocalRing.closedPoint B)})
      (hfibT : IsIso (Limits.pullback.snd gT (X.fromSpecResidueField x))),
      ∃ q : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶ Spec (.of B),
        q (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) =
          IsLocalRing.closedPoint B ∧
        q ≫ (eT.inv ≫ gT) = wcEtGeomPt X x := by
    intro X T x gT eT hpreT hfibT
    have e1 : (Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
        inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
          Limits.pullback.fst gT (X.fromSpecResidueField x)) ≫ gT =
        Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫ X.fromSpecResidueField x := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition, IsIso.inv_hom_id_assoc]
    refine ⟨(Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
        inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
          Limits.pullback.fst gT (X.fromSpecResidueField x)) ≫ eT.hom, ?_, ?_⟩
    · have ht : gT ((Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
            inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
              Limits.pullback.fst gT (X.fromSpecResidueField x))
            (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) = x :=
        (Scheme.Hom.comp_apply _ gT _).symm.trans
          ((congrArg (fun φ => φ (IsLocalRing.closedPoint
              (AlgebraicClosure (X.residueField x)))) e1).trans
            ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)))
      have hmem : ((Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫
            inv (Limits.pullback.snd gT (X.fromSpecResidueField x)) ≫
              Limits.pullback.fst gT (X.fromSpecResidueField x))
            (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) ∈
          gT ⁻¹' {x} := ht
      rw [hpreT] at hmem
      exact (Scheme.Hom.comp_apply _ _ _).trans
        ((congrArg eT.hom (Set.mem_singleton_iff.mp hmem)).trans (Scheme.inv_hom_apply _ _))
    · rw [Category.assoc, Iso.hom_inv_id_assoc, e1]
  obtain ⟨q, hq0, hq1⟩ := hgeom xb g.left eB hpre hfib

  obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point xb B' Λ' W'' φ' a' hsh B (eB.inv ≫ g.left) q
    hq0 hq1
  haveI hδi : IsIso δ := wc_pltr_shens_lift_iso xb B' Λ' W'' φ' a' hsh B (eB.inv ≫ g.left)
    hcE hc0 δ hδ

  obtain ⟨θ, hθ⟩ : ∃ θ : CommRingCat.of B' ⟶ CommRingCat.of B, Spec.map θ = δ :=
    ⟨Spec.preimage δ, Spec.map_preimage δ⟩
  obtain ⟨θ', hθ'⟩ : ∃ θ' : CommRingCat.of B ⟶ CommRingCat.of B', Spec.map θ' = inv δ :=
    ⟨Spec.preimage (inv δ), Spec.map_preimage (inv δ)⟩
  have hθθ' : θ ≫ θ' = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hθ, hθ', IsIso.inv_hom_id, Spec.map_id]
  have hkey : ∀ (S : Type u) [CommRing S] (g₀ : S →+* B'),
      Spec.map (CommRingCat.ofHom (θ.hom.comp g₀)) = δ ≫ Spec.map (CommRingCat.ofHom g₀) := by
    intro S _ g₀
    rw [← hθ, ← Spec.map_comp]
    rfl
  have hmax : ∀ y : B', y ∈ IsLocalRing.maximalIdeal B' →
      θ.hom y ∈ IsLocalRing.maximalIdeal B := by
    intro y hy
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hy ⊢
    intro hu
    apply hy
    have hyy : θ'.hom (θ.hom y) = y := by
      change (θ ≫ θ').hom y = y
      rw [hθθ']
      rfl
    rw [← hyy]
    exact hu.map θ'.hom
  refine ⟨π, c, θ.hom.comp β', hπ, hc, ?_, ?_, ?_⟩
  · rw [hkey _ β']
    haveI := hβ'
    infer_instance
  · intro p
    exact hmax _ (hX' p)
  · rw [RingHom.comp_assoc, hkey _ (β'.comp (algebraMap A (wcQuadModelRing A n π c))), hA',
      ← Category.assoc δ a', hδ, Category.assoc]

theorem wc_pmtv_hyp_coords_prime (A : Type u) [CommRing A] (π : A) (m n : ℕ) (hnm : n = 2 * m)
    (c P : Matrix (Fin n) (Fin n) A) (hP : IsUnit P.det)
    (D' : MvPolynomial (Fin n) A) (hD0 : MvPolynomial.constantCoeff D' = 0)
    (hhyp : (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
        ∑ t : Fin m, MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (B : Type u) [CommRing B] [IsLocalRing B] (β : wcQuadModelRing A n π c →+* B)
    (hβX : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B)
    (𝔮 : Ideal B) (h𝔮 : 𝔮.IsPrime)
    (hy : ∀ t : Fin m, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
      (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a)) ∈ 𝔮) :
    β (algebraMap A (wcQuadModelRing A n π c) π) ∈ 𝔮 :=
by
  classical

  obtain ⟨σ, hσC, hσX⟩ : ∃ σ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) A,
      (∀ r : A, σ (MvPolynomial.C r) = MvPolynomial.C r) ∧
      ∀ a : Fin n, σ (MvPolynomial.X a) =
        ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b :=
    ⟨MvPolynomial.eval₂Hom MvPolynomial.C
        (fun a => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b),
      fun r => MvPolynomial.eval₂Hom_C _ _ _, fun a => MvPolynomial.eval₂Hom_X' _ _ _⟩
  have hPP : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP

  have hσL : ∀ p, σ (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) = MvPolynomial.X p := by
    intro p
    rw [map_sum]
    simp only [map_mul, hσC, hσX]
    calc ∑ a, MvPolynomial.C (P p a) * ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b
        = ∑ b, MvPolynomial.C ((P * P⁻¹) p b) * (MvPolynomial.X b : MvPolynomial (Fin n) A) := by
          simp only [Finset.mul_sum, Matrix.mul_apply, map_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun a _ => ?_
          rw [MvPolynomial.C_mul]
          ring
      _ = MvPolynomial.X p := by
          rw [hPP, Finset.sum_eq_single p]
          · simp
          · intro b _ hb
            simp [Matrix.one_apply, Ne.symm hb]
          · simp

  have hstar : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) =
      ∑ t : Fin m, σ (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) *
          σ (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)) +
        MvPolynomial.C π * σ D' := by
    have hL : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) = σ (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [map_sum]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [map_mul, map_mul, hσC, hσL, hσL]
    rw [hL, hhyp, map_add, map_sum, map_mul, hσC]
    refine congrArg (· + _) (Finset.sum_congr rfl fun t _ => ?_)
    rw [map_mul]
  set mk := Ideal.Quotient.mk (wcQuadModelIdeal A n π c) with hmk
  have hmkq : mk (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) = mk (MvPolynomial.C π) :=
    Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
  have hπ : algebraMap A (wcQuadModelRing A n π c) π = mk (MvPolynomial.C π) := by
    rw [hmk, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have h1 : mk (∑ t : Fin m, σ (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) *
          σ (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n))) +
        mk (MvPolynomial.C π) * mk (σ D') = mk (MvPolynomial.C π) := by
    rw [← map_mul, ← map_add, ← hstar]
    exact hmkq
  have h2 := congrArg β h1
  rw [map_add, map_mul] at h2

  have hS : β (mk (∑ t : Fin m, σ (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) *
          σ (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)))) ∈ 𝔮 := by
    rw [map_sum, map_sum]
    refine Ideal.sum_mem _ fun t _ => ?_
    rw [map_mul, map_mul]
    refine Ideal.mul_mem_right _ _ ?_
    rw [hσX]
    exact hy t

  have hw : β (mk (σ D')) ∈ IsLocalRing.maximalIdeal B := by
    have hγX : ∀ p, ((β.comp mk).comp σ) (MvPolynomial.X p) ∈ IsLocalRing.maximalIdeal B := by
      intro p
      rw [RingHom.comp_apply, hσX, map_sum]
      refine Ideal.sum_mem _ fun b _ => ?_
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hβX b)
    have key : (IsLocalRing.residue B).comp ((β.comp mk).comp σ) =
        (((IsLocalRing.residue B).comp ((β.comp mk).comp σ)).comp MvPolynomial.C).comp
          MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_C]
      · intro p
        simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr (hγX p)
    have h3 := congrArg (fun f => f D') key
    simp only [RingHom.comp_apply, hD0, map_zero] at h3
    exact (IsLocalRing.residue_eq_zero_iff _).mp h3
  have hb : β (algebraMap A (wcQuadModelRing A n π c) π) * (1 - β (mk (σ D'))) ∈ 𝔮 := by
    have e : β (algebraMap A (wcQuadModelRing A n π c) π) * (1 - β (mk (σ D'))) =
        β (mk (∑ t : Fin m, σ (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) *
          σ (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)))) := by
      rw [hπ]
      linear_combination (-1 : B) * h2
    rw [e]
    exact hS
  have hu : IsUnit (1 - β (mk (σ D'))) :=
    IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp hw)
  rcases h𝔮.mem_or_mem hb with h | h
  · exact h
  · exact absurd (Ideal.eq_top_of_isUnit_mem _ h hu) h𝔮.ne_top

theorem wc_pmtv_tube_base_off_closed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [IsLocalRing A] (e : V₀.left ≅ Spec (.of A))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] (eB : Th.left ≅ Spec (.of B))
    (Tη : D.Yt.left.ProEt) (j : Tη ⟶ Th)
    (hrange : Set.range j.left = {z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')})
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (γ : A →+* B)
    (hγ : eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom =
      Spec.map (CommRingCat.ofHom γ)) :
    ∀ z : Tη.left, γ π ∉ (eB.hom (j.left z)).asIdeal :=
by
  intro z hz
  have hp : Spec.map (CommRingCat.ofHom γ) (eB.hom (j.left z)) = IsLocalRing.closedPoint A := by
    have hmem : π ∈ (Spec.map (CommRingCat.ofHom γ) (eB.hom (j.left z))).asIdeal := by
      first
        | exact hz
        | (rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal, CommRingCat.hom_ofHom, Ideal.mem_comap]
           exact hz)
    have hle : IsLocalRing.maximalIdeal A ≤
        (Spec.map (CommRingCat.ofHom γ) (eB.hom (j.left z))).asIdeal := by
      rw [hπ, Ideal.span_singleton_le_iff_mem]
      exact hmem
    have hle2 := IsLocalRing.le_maximalIdeal
      (Spec.map (CommRingCat.ofHom γ) (eB.hom (j.left z))).isPrime.ne_top
    apply PrimeSpectrum.ext
    exact le_antisymm hle2 hle
  have h0 : (eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom) (eB.hom (j.left z)) =
      IsLocalRing.closedPoint A := by
    rw [hγ, hp]
  have h1 : e.hom (Limits.pullback.fst V₀.hom D.f (g.left (eB.inv (eB.hom (j.left z))))) =
      IsLocalRing.closedPoint A := h0
  rw [Scheme.hom_inv_apply] at h1
  have h2 : Limits.pullback.fst V₀.hom D.f (g.left (j.left z)) =
      e.inv (IsLocalRing.closedPoint A) := by
    rw [← h1, Scheme.hom_inv_apply]
  have hc : (Limits.pullback.fst V₀.hom D.f ≫ V₀.hom) (g.left (j.left z)) =
      (Limits.pullback.snd V₀.hom D.f ≫ D.f) (g.left (j.left z)) := by
    rw [Limits.pullback.condition]
  have hc' : V₀.hom (Limits.pullback.fst V₀.hom D.f (g.left (j.left z))) =
      D.f (Limits.pullback.snd V₀.hom D.f (g.left (j.left z))) := hc
  have h3 : D.f (Limits.pullback.snd V₀.hom D.f (g.left (j.left z))) =
      D.S i (IsLocalRing.closedPoint F'') := by
    rw [← hc', h2, hv]
  have hw : (g.left ≫ ((wcProEtPullback D.f).obj V₀).hom) (j.left z) = Th.hom (j.left z) := by
    first
      | exact congrArg (fun φ => φ (j.left z)) (MorphismProperty.Over.w g)
      | rw [MorphismProperty.Over.w g]
      | exact congrArg (fun φ => φ (j.left z)) (Over.w g)
      | exact congrArg (fun φ => φ (j.left z)) g.w
  have h4 : Limits.pullback.snd V₀.hom D.f (g.left (j.left z)) = Th.hom (j.left z) := hw
  have hmem : j.left z ∈ Set.range j.left := Set.mem_range_self z
  rw [hrange] at hmem
  exact hmem (h4 ▸ h3)

theorem wc_pmtv_tube_hyperbolic_map (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (Ω : (wcP1Over F'').left.ProEt) (a₀ : Ω ⟶ V₀)
    (L : Type u) [Field L] [IsSepClosed L] (eΩ : Ω.left ≅ Spec (.of L))
    (hΩ : ∀ (z : Ω.left) (j : Fin D.m), Ω.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (Fm : D.Yt.left.ProEt) (rW : Fm ⟶ (wcProEtPullback D.f).obj Ω) (rT : Fm ⟶ Th)
    (hsq : rT ≫ g = rW ≫ (wcProEtPullback D.f).map a₀)
    (hpb : IsPullback rT.left rW.left g.left ((wcProEtPullback D.f).map a₀).left)
    (Tη : D.Yt.left.ProEt) (j : Tη ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')})
    (ρ : Fm ⟶ Tη) (hρ : ρ ≫ j = rT) (hnm : n = 2 * (n / 2)) :
    ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (ι : K →+* A) (π : A)
      (c : Matrix (Fin n) (Fin n) A) (β : wcQuadModelRing A n π c →+* B)
      (P : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A)
      (U₀ : (Spec (.of (MvPolynomial (Fin (n / 2)) K))).Opens)
      (ψ : Tη.left ⟶ (U₀ : Scheme.{u})),
      Function.Bijective ((IsLocalRing.residue A).comp ι) ∧ ((ℓ : ℕ) : K) ≠ 0 ∧
      IsLocalRing.maximalIdeal A = Ideal.span {π} ∧ IsUnit (c + c.transpose).det ∧
      WeaklyEtale (Spec.map (CommRingCat.ofHom β)) ∧
      (∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
        IsLocalRing.maximalIdeal B) ∧
      eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom =
        Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c)))) ∧
      IsUnit P.det ∧ MvPolynomial.constantCoeff D' = 0 ∧
      (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
        ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D' ∧
      (U₀ : Set (Spec (.of (MvPolynomial (Fin (n / 2)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))))ᶜ ∧
      ψ ≫ U₀.ι = j.left ≫ eB.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ι)
        (fun t : Fin (n / 2) => β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) *
            MvPolynomial.X a))))) :=
by
  classical

  obtain ⟨K, _, _, ι, hι, hℓK⟩ :=
    wc_pmn_hc_coeff_field F'' (D.S i) (D.hS i) V₀ A e hv ℓ hℓ

  haveI : IsAlgClosed (IsLocalRing.ResidueField A) :=
    IsAlgClosed.of_ringEquiv K (IsLocalRing.ResidueField A)
      (RingEquiv.ofBijective ((IsLocalRing.residue A).comp ι) hι)

  obtain ⟨π, c, β, hπ, hc, hβ, hβX, hβA⟩ :=
    wc_pmtv_morse_model_at_B F' F'' Y n hn hn2 D i V₀ A e ε hv xb hxb Th g B eB hpre hfib

  obtain ⟨P, D', hP, hD', hhyp⟩ :=
    wc_pmn_hc_hyperbolic_change A π hπ (n / 2) n hnm (by omega) c hc

  have hsurj : Function.Surjective
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K) :=
    fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  have hclosed : IsClosed (Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K)))) :=
    (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))).isClosedEmbedding.isClosed_range
  let U₀ : (Spec (.of (MvPolynomial (Fin (n / 2)) K))).Opens :=
    ⟨(Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))))ᶜ, hclosed.isOpen_compl⟩

  set φ : MvPolynomial (Fin (n / 2)) K →+* B := MvPolynomial.eval₂Hom
        ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ι)
        (fun t : Fin (n / 2) => β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) *
            MvPolynomial.X a))) with hφ
  set Ψ₀ : Tη.left ⟶ Spec (.of (MvPolynomial (Fin (n / 2)) K)) :=
    j.left ≫ eB.hom ≫ Spec.map (CommRingCat.ofHom φ) with hΨ₀
  have hsub : Set.range Ψ₀ ⊆ Set.range U₀.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩ hz
    have hz' := (wc_affine_origin_range_iff K (n / 2) (Ψ₀ z)).mp hz
    have hid : (Ψ₀ z).asIdeal = Ideal.comap φ (eB.hom (j.left z)).asIdeal := rfl
    have hy : ∀ t : Fin (n / 2), β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a)) ∈
          (eB.hom (j.left z)).asIdeal := by
      intro t
      have h1 := hz' t
      rw [hid, Ideal.mem_comap, hφ, MvPolynomial.eval₂Hom_X'] at h1
      exact h1
    have hmem := wc_pmtv_hyp_coords_prime A π (n / 2) n hnm c P hP D' hD' hhyp B β hβX
      (eB.hom (j.left z)).asIdeal (eB.hom (j.left z)).isPrime hy
    exact wc_pmtv_tube_base_off_closed F' F'' Y n D i V₀ A e hv Th g B eB Tη j hrange π hπ
      (β.comp (algebraMap A (wcQuadModelRing A n π c))) hβA z hmem
  refine ⟨K, inferInstance, inferInstance, ι, π, c, β, P, D', U₀,
    IsOpenImmersion.lift U₀.ι Ψ₀ hsub, hι, hℓK, hπ, hc, hβ, hβX, hβA, hP, hD', hhyp, rfl,
    IsOpenImmersion.lift_fac U₀.ι Ψ₀ hsub⟩

theorem wc_pmhpi_rescaled_factor (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (Ω : (wcP1Over F'').left.ProEt) (a₀ : Ω ⟶ V₀)
    (L : Type u) [Field L] [IsSepClosed L] (eΩ : Ω.left ≅ Spec (.of L))
    (hΩ : ∀ (z : Ω.left) (j : Fin D.m), Ω.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (Fm : D.Yt.left.ProEt) (rW : Fm ⟶ (wcProEtPullback D.f).obj Ω) (rT : Fm ⟶ Th)
    (hsq : rT ≫ g = rW ≫ (wcProEtPullback D.f).map a₀)
    (hpb : IsPullback rT.left rW.left g.left ((wcProEtPullback D.f).map a₀).left)
    (Tη : D.Yt.left.ProEt) (j : Tη ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')})
    (ρ : Fm ⟶ Tη) (hρ : ρ ≫ j = rT) (hnm : n = 2 * (n / 2))
    (K : Type u) [Field K] [IsAlgClosed K] (ι : K →+* A) (π : A)
    (c : Matrix (Fin n) (Fin n) A) (β : wcQuadModelRing A n π c →+* B)
    (P : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A)
    (U₀ : (Spec (.of (MvPolynomial (Fin (n / 2)) K))).Opens)
    (ψ : Tη.left ⟶ (U₀ : Scheme.{u}))
    (hι : Function.Bijective ((IsLocalRing.residue A).comp ι)) (hℓK : ((ℓ : ℕ) : K) ≠ 0)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β)))
    (hβX : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B)
    (hβA : eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom =
      Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c)))))
    (hP : IsUnit P.det) (hD' : MvPolynomial.constantCoeff D' = 0)
    (hhyp : (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
        ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (hU₀ : (U₀ : Set (Spec (.of (MvPolynomial (Fin (n / 2)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))))ᶜ)
    (hψ : ψ ≫ U₀.ι = j.left ≫ eB.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ι)
        (fun t : Fin (n / 2) => β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) *
            MvPolynomial.X a)))))) :
    ∃ (lam : A →+* L) (_ : Spec.map (CommRingCat.ofHom lam) = eΩ.inv ≫ a₀.left ≫ e.hom)
      (_ : lam π ≠ 0)
      (h : Fm.left ⟶ Spec (.of (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))))
      (e' : Spec (.of (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))
          ⟶ (U₀ : Scheme.{u})),
      e' ≫ U₀.ι = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            (lam.comp ι))
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))))) ∧
      h ≫ Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) =
        rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom ∧
      h ≫ e' = ρ.left ≫ ψ :=
by
  classical

  have s1 : ∀ {L₁ S₁ : Type u} [CommRing L₁] [CommRing S₁] (f : L₁ →+* S₁) (v : Fin n → S₁),
      ∑ p, ∑ q, f (Matrix.of (fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L₁) else 0) p q) * v p * v q =
        ∑ t : Fin (n / 2), v ⟨2 * t.val, by omega⟩ * v ⟨2 * t.val + 1, by omega⟩ := by
    intro L₁ S₁ _ _ f v
    have hf : ∀ p q : Fin n, f (Matrix.of (fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L₁) else 0) p q) * v p * v q =
        if (p.val % 2 = 0 ∧ q.val = p.val + 1) then v p * v q else 0 := by
      intro p q
      simp only [Matrix.of_apply]
      split_ifs <;> simp
    simp only [hf]
    have hε : ∀ x ∈ (Finset.univ : Finset (Fin (n / 2))), ∀ y ∈ (Finset.univ : Finset (Fin (n / 2))),
        (⟨2 * x.val, by omega⟩ : Fin n) = ⟨2 * y.val, by omega⟩ → x = y := by
      intro x _ y _ hxy
      apply Fin.ext
      have := congrArg Fin.val hxy
      simp only at this
      omega
    have h1 : ∑ p : Fin n, (∑ q : Fin n, if (p.val % 2 = 0 ∧ q.val = p.val + 1) then v p * v q else 0) =
        ∑ t : Fin (n / 2), (∑ q : Fin n, if ((⟨2 * t.val, by omega⟩ : Fin n).val % 2 = 0 ∧
          q.val = (⟨2 * t.val, by omega⟩ : Fin n).val + 1) then v ⟨2 * t.val, by omega⟩ * v q else 0) := by
      rw [← Finset.sum_image (f := fun p : Fin n => ∑ q : Fin n,
        if (p.val % 2 = 0 ∧ q.val = p.val + 1) then v p * v q else 0) hε]
      symm
      apply Finset.sum_subset (Finset.subset_univ _)
      intro p _ hp
      apply Finset.sum_eq_zero
      intro q _
      rw [if_neg]
      rintro ⟨h2, -⟩
      apply hp
      rw [Finset.mem_image]
      exact ⟨⟨p.val / 2, by omega⟩, Finset.mem_univ _, Fin.ext (by simp only; omega)⟩
    rw [h1]
    apply Finset.sum_congr rfl
    intro t _
    rw [Finset.sum_eq_single (⟨2 * t.val + 1, by omega⟩ : Fin n)]
    · rw [if_pos ⟨by show (2 * t.val) % 2 = 0; omega, rfl⟩]
    · intro q _ hq
      rw [if_neg]
      rintro ⟨-, h⟩
      exact hq (Fin.ext h)
    · intro h
      exact absurd (Finset.mem_univ _) h

  have s2 : IsUnit (1 - β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.bind₁
        (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b) D'))) ∧
      ∑ t : Fin (n / 2), β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a)) *
        β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val + 1, by omega⟩ : Fin n) a) * MvPolynomial.X a)) =
      β (algebraMap A (wcQuadModelRing A n π c) π) *
        (1 - β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.bind₁
          (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b) D'))) := by
    have hZ : ∀ p, ∑ a, MvPolynomial.C (P p a) *
        (∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b : MvPolynomial (Fin n) A) =
        MvPolynomial.X p := by
      intro p
      simp only [Finset.mul_sum, ← mul_assoc, ← map_mul]
      rw [Finset.sum_comm]
      simp only [← Finset.sum_mul, ← map_sum]
      have hPP := Matrix.mul_nonsing_inv P hP
      have h1 : ∀ b, ∑ a, P p a * P⁻¹ a b = (1 : Matrix (Fin n) (Fin n) A) p b := fun b => by
        rw [← hPP, Matrix.mul_apply]
      simp only [h1, Matrix.one_apply]
      rw [Finset.sum_eq_single p (fun b _ hb => by rw [if_neg (Ne.symm hb), map_zero, zero_mul])
        (fun h => absurd (Finset.mem_univ p) h), if_pos rfl, map_one, one_mul]
    have hb := congrArg (MvPolynomial.bind₁
      (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b)) hhyp
    simp only [map_sum, map_mul, map_add, MvPolynomial.bind₁_C_right, MvPolynomial.bind₁_X_right,
      hZ] at hb
    have hmkQ : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) =
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) := by
      rw [Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    have hAlg : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) =
        algebraMap A (wcQuadModelRing A n π c) π := rfl
    refine ⟨?_, ?_⟩
    · have hXm : ∀ b, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ b a) * MvPolynomial.X a)) ∈ IsLocalRing.maximalIdeal B := by
        intro b
        simp only [map_sum, map_mul]
        exact Ideal.sum_mem _ (fun a _ => Ideal.mul_mem_left _ _ (hβX a))
      have hres : (IsLocalRing.residue B).comp (β.comp ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)).comp
          (MvPolynomial.bind₁ (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b)).toRingHom)) =
          ((IsLocalRing.residue B).comp (β.comp ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)).comp
          (MvPolynomial.bind₁ (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b)).toRingHom))).comp
            (MvPolynomial.C.comp MvPolynomial.constantCoeff) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_C]
        · intro b
          simp only [RingHom.comp_apply, MvPolynomial.constantCoeff_X, map_zero]
          rw [IsLocalRing.residue_eq_zero_iff]
          show β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) ((MvPolynomial.bind₁
              (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b))
              (MvPolynomial.X b))) ∈ _
          rw [MvPolynomial.bind₁_X_right]; exact hXm b
      have hD'm : β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.bind₁
          (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b) D')) ∈
          IsLocalRing.maximalIdeal B := by
        have := congrArg (fun φ => φ D') hres
        simp only [RingHom.comp_apply, hD', map_zero] at this
        exact (IsLocalRing.residue_eq_zero_iff _).mp this
      exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
        ((IsLocalRing.mem_maximalIdeal _).mp hD'm)
    · have h3 : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ t : Fin (n / 2), (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a) *
            (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val + 1, by omega⟩ : Fin n) a) * MvPolynomial.X a) +
            MvPolynomial.C π * MvPolynomial.bind₁
              (fun a : Fin n => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b) D') =
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) := by
        rw [← hb]; exact hmkQ
      rw [map_add, map_mul, hAlg] at h3
      have h4 := congrArg β h3
      rw [map_add, map_mul, map_sum, map_sum] at h4
      simp only [map_mul] at h4
      linear_combination h4

  have s5 : ∀ {T : Type u} [CommRing T] (σ : L →+* T) (c₀ : L) (y z : Fin (n / 2) → T),
      ∑ t, y t * z t = σ c₀ →
      ∃ θ : wcQuadModelRing L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) →+* T,
        θ.comp (algebraMap L _) = σ ∧
        (∀ t : Fin (n / 2), θ (Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))) = y t) ∧
        (∀ t : Fin (n / 2), θ (Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n))) = z t) := by
    intro T _ σ c₀ y z hyz
    let v : Fin n → T := fun p =>
      if p.val % 2 = 0 then y ⟨p.val / 2, by omega⟩ else z ⟨p.val / 2, by omega⟩
    have hv0 : ∀ t : Fin (n / 2), v ⟨2 * t.val, by omega⟩ = y t := by
      intro t
      simp only [v]
      rw [if_pos (by omega)]
      exact congrArg y (Fin.ext (by simp only; omega))
    have hv1 : ∀ t : Fin (n / 2), v ⟨2 * t.val + 1, by omega⟩ = z t := by
      intro t
      simp only [v]
      rw [if_neg (by omega)]
      exact congrArg z (Fin.ext (by simp only; omega))
    have hgen : MvPolynomial.eval₂Hom σ v (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C c₀) = 0 := by
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      rw [s1 σ v]
      simp only [hv0, hv1, hyz, sub_self]
    have H : ∀ a ∈ wcQuadModelIdeal L n c₀
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0),
        MvPolynomial.eval₂Hom σ v a = 0 := by
      intro a ha
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hgen, mul_zero]
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom σ v) H, ?_, ?_, ?_⟩
    · ext l
      rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk,
        MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C]
    · intro t
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', hv0]
    · intro t
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', hv1]

  have s6a : ∀ {Rr : CommRingCat.{u}} (gg : Fm.left ⟶ Spec Rr),
      Fm.left.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso Rr).inv ≫ gg.appTop) = gg := by
    intro Rr gg
    rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
      toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  have s6b : ∀ {Rr : CommRingCat.{u}} (φ φ' : Rr ⟶ Γ(Fm.left, ⊤)),
      Fm.left.toSpecΓ ≫ Spec.map φ = Fm.left.toSpecΓ ≫ Spec.map φ' → φ = φ' := by
    intro Rr φ φ' hh
    have key : ∀ φ₀ : Rr ⟶ Γ(Fm.left, ⊤),
        (Scheme.ΓSpecIso Rr).inv ≫ (Fm.left.toSpecΓ ≫ Spec.map φ₀).appTop = φ₀ := by
      intro φ₀
      rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc]
    rw [← key φ, hh, key]

  have hw₀ : a₀.left ≫ V₀.hom = Ω.hom := by
    first
      | exact MorphismProperty.Over.w a₀
      | exact Over.w a₀
      | simp
  have hf : (eΩ.inv ≫ a₀.left ≫ e.hom) (IsLocalRing.closedPoint L) ≠ IsLocalRing.closedPoint A := by
    intro h0
    have h1 : (eΩ.inv ≫ a₀.left ≫ e.hom) (IsLocalRing.closedPoint L) =
        e.hom (a₀.left (eΩ.inv (IsLocalRing.closedPoint L))) := by
      first
        | rfl
        | exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _)
    have h2 : a₀.left (eΩ.inv (IsLocalRing.closedPoint L)) = e.inv (IsLocalRing.closedPoint A) :=
      (Scheme.hom_inv_apply e _).symm.trans (congrArg e.inv (h1.symm.trans h0))
    have h3 : Ω.hom (eΩ.inv (IsLocalRing.closedPoint L)) =
        V₀.hom (a₀.left (eΩ.inv (IsLocalRing.closedPoint L))) := by
      first
        | exact (congrArg (fun f : Ω.left ⟶ (wcP1Over F'').left =>
            f (eΩ.inv (IsLocalRing.closedPoint L))) hw₀).symm.trans (Scheme.Hom.comp_apply _ _ _)
        | (rw [← hw₀]; rfl)
    exact hΩ (eΩ.inv (IsLocalRing.closedPoint L)) i (h3.trans ((congrArg V₀.hom h2).trans hv))
  obtain ⟨lam, hlam, hlamπ⟩ : ∃ lam : A →+* L,
      Spec.map (CommRingCat.ofHom lam) = eΩ.inv ≫ a₀.left ≫ e.hom ∧ lam π ≠ 0 := by
    refine ⟨(Spec.preimage (eΩ.inv ≫ a₀.left ≫ e.hom)).hom,
      by rw [CommRingCat.ofHom_hom, Spec.map_preimage], ?_⟩
    intro h0
    apply hf
    have hf' : (eΩ.inv ≫ a₀.left ≫ e.hom) (IsLocalRing.closedPoint L) =
        PrimeSpectrum.comap (Spec.preimage (eΩ.inv ≫ a₀.left ≫ e.hom)).hom
          (IsLocalRing.closedPoint L) :=
      (congrArg (fun gg => gg (IsLocalRing.closedPoint L))
        (Spec.map_preimage (eΩ.inv ≫ a₀.left ≫ e.hom))).symm.trans (Spec.map_apply _ _)
    rw [hf']
    apply PrimeSpectrum.ext
    rw [PrimeSpectrum.comap_asIdeal]
    show Ideal.comap _ (IsLocalRing.maximalIdeal L) = IsLocalRing.maximalIdeal A
    symm
    apply Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal A)
      (Ideal.comap_ne_top _ (IsLocalRing.maximalIdeal.isMaximal L).ne_top)
    rw [hπ, Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, h0]
    exact zero_mem _

  obtain ⟨σL, hσL⟩ : ∃ σL : CommRingCat.of L ⟶ Γ(Fm.left, ⊤),
      Fm.left.toSpecΓ ≫ Spec.map σL = rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom :=
    ⟨_, s6a _⟩
  obtain ⟨bF, hbF⟩ : ∃ bF : CommRingCat.of B ⟶ Γ(Fm.left, ⊤),
      Fm.left.toSpecΓ ≫ Spec.map bF = rT.left ≫ eB.hom := ⟨_, s6a _⟩

  have hmapfst : ((wcProEtPullback D.f).map a₀).left ≫ Limits.pullback.fst V₀.hom D.f =
      Limits.pullback.fst Ω.hom D.f ≫ a₀.left := by
    first
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
      | (unfold wcProEtPullback; erw [MorphismProperty.Over.pullback_map_left];
         exact Limits.pullback.lift_fst _ _ _)
      | simp [wcProEtPullback]
  have hSq : rT.left ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f =
      rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ a₀.left :=
    calc rT.left ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f
        = (rT.left ≫ g.left) ≫ Limits.pullback.fst V₀.hom D.f := (Category.assoc _ _ _).symm
      _ = (rW.left ≫ ((wcProEtPullback D.f).map a₀).left) ≫ Limits.pullback.fst V₀.hom D.f :=
          congrArg (fun x : Fm.left ⟶ ((wcProEtPullback D.f).obj V₀).left =>
            x ≫ Limits.pullback.fst V₀.hom D.f) hpb.w
      _ = rW.left ≫ (((wcProEtPullback D.f).map a₀).left ≫ Limits.pullback.fst V₀.hom D.f) :=
          Category.assoc _ _ _
      _ = rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ a₀.left :=
          congrArg (fun x : ((wcProEtPullback D.f).obj Ω).left ⟶ V₀.left => rW.left ≫ x) hmapfst

  have hCA : CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c))) ≫ bF =
      CommRingCat.ofHom lam ≫ σL := by
    apply s6b
    rw [Spec.map_comp, Spec.map_comp, ← Category.assoc, ← Category.assoc, hbF, hσL, ← hβA, hlam]
    calc (rT.left ≫ eB.hom) ≫ eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom
        = rT.left ≫ eB.hom ≫ eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom :=
          Category.assoc _ _ _
      _ = rT.left ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom :=
          congrArg (fun x : Th.left ⟶ Spec (.of A) => rT.left ≫ x) (Iso.hom_inv_id_assoc eB _)
      _ = rT.left ≫ (g.left ≫ Limits.pullback.fst V₀.hom D.f) ≫ e.hom :=
          congrArg (fun x : Th.left ⟶ Spec (.of A) => rT.left ≫ x) (Category.assoc _ _ _).symm
      _ = (rT.left ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f) ≫ e.hom :=
          (Category.assoc _ _ _).symm
      _ = (rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ a₀.left) ≫ e.hom :=
          congrArg (fun x : Fm.left ⟶ V₀.left => x ≫ e.hom) hSq
      _ = rW.left ≫ (Limits.pullback.fst Ω.hom D.f ≫ a₀.left) ≫ e.hom := Category.assoc _ _ _
      _ = rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ a₀.left ≫ e.hom :=
          congrArg (fun x : ((wcProEtPullback D.f).obj Ω).left ⟶ Spec (.of A) => rW.left ≫ x)
            (Category.assoc _ _ _)
      _ = rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom ≫ eΩ.inv ≫ a₀.left ≫ e.hom :=
          congrArg (fun x : Ω.left ⟶ Spec (.of A) => rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ x)
            (Iso.hom_inv_id_assoc eΩ _).symm
      _ = rW.left ≫ (Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom) ≫ eΩ.inv ≫ a₀.left ≫ e.hom :=
          congrArg (fun x : ((wcProEtPullback D.f).obj Ω).left ⟶ Spec (.of A) => rW.left ≫ x)
            (Category.assoc _ _ _).symm
      _ = (rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom) ≫ eΩ.inv ≫ a₀.left ≫ e.hom :=
          (Category.assoc _ _ _).symm
  have hCA' : ∀ a : A, bF.hom (β (algebraMap A (wcQuadModelRing A n π c) a)) = σL.hom (lam a) := by
    intro a
    have := congrArg (fun φ => φ.hom a) hCA
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at this
    exact this

  obtain ⟨hw, hid⟩ := s2
  have hyz : ∑ t : Fin (n / 2), bF.hom (β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a))) *
        bF.hom (β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val + 1, by omega⟩ : Fin n) a) * MvPolynomial.X a)) *
          ↑hw.unit⁻¹) = σL.hom (lam π) := by
    have e2 : bF.hom (β (algebraMap A (wcQuadModelRing A n π c) π)) =
        bF.hom ((∑ t : Fin (n / 2), β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a)) *
        β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val + 1, by omega⟩ : Fin n) a) * MvPolynomial.X a))) *
          ↑hw.unit⁻¹) := by
      rw [hid, mul_assoc, hw.mul_val_inv, mul_one]
    rw [← hCA', e2, Finset.sum_mul, map_sum bF.hom]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [← map_mul, mul_assoc]

  obtain ⟨θ, hθ1, hθ2, -⟩ := s5 σL.hom (lam π) _ _ hyz

  have s4 : ∀ x : Spec (.of (wcQuadModelRing L n (lam π)
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))),
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            (lam.comp ι))
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))))) x ∉
        Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))) := by
    intro x
    rintro ⟨y, hy⟩
    have hmem : ∀ t : Fin (n / 2), Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
        (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal x := by
      intro t
      have hX : (MvPolynomial.X t : MvPolynomial (Fin (n / 2)) K) ∈ PrimeSpectrum.asIdeal
          (Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K)) y) := by
        rw [Spec.map_apply]
        exact Ideal.mem_comap.mpr (by
          rw [CommRingCat.hom_ofHom, MvPolynomial.constantCoeff_X]; exact zero_mem _)
      rw [hy, Spec.map_apply] at hX
      have h3 := Ideal.mem_comap.mp hX
      rwa [CommRingCat.hom_ofHom, MvPolynomial.eval₂Hom_X'] at h3
    have hrel : ∑ t : Fin (n / 2), Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
        (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) *
        Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
        (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)) =
        algebraMap L (wcQuadModelRing L n (lam π)
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (lam π) := by
      have h1 := s1 (MvPolynomial.C : L →+* MvPolynomial (Fin n) L) MvPolynomial.X
      have h2 : Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin n =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) *
            MvPolynomial.X p * MvPolynomial.X q) =
          Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.C (lam π)) := by
        rw [Ideal.Quotient.eq]
        exact Ideal.subset_span (Set.mem_singleton _)
      rw [h1, map_sum] at h2
      simp only [map_mul] at h2
      rw [h2]
      rfl
    have hone : (1 : wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)) ∈
        PrimeSpectrum.asIdeal x := by
      have e1 : (1 : wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)) =
          ∑ t : Fin (n / 2), (algebraMap L _ (lam π)⁻¹ * Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n))) *
            Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) := by
        have e2 : ∑ t : Fin (n / 2), (algebraMap L _ (lam π)⁻¹ * Ideal.Quotient.mk
            (wcQuadModelIdeal L n (lam π)
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n))) *
            Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) =
            algebraMap L (wcQuadModelRing L n (lam π)
              (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
                (lam π)⁻¹ *
            ∑ t : Fin (n / 2), Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)) *
            Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
            (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)) := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun t _ => by ring)
        rw [e2, hrel, ← map_mul, inv_mul_cancel₀ hlamπ, map_one]
      rw [e1]
      exact Ideal.sum_mem _ (fun t _ => Ideal.mul_mem_left _ _ (hmem t))
    exact (PrimeSpectrum.isPrime x).ne_top ((Ideal.eq_top_iff_one _).mpr hone)

  have H' : Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            (lam.comp ι))
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)))))).base ⊆ Set.range U₀.ι.base := by
    rintro _ ⟨x, rfl⟩
    have hmem : (Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            (lam.comp ι))
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)))))) x ∈
        (U₀ : Set (Spec (.of (MvPolynomial (Fin (n / 2)) K)))) := by
      rw [hU₀]; exact s4 x
    have hr : Set.range U₀.ι = (U₀ : Set (Spec (.of (MvPolynomial (Fin (n / 2)) K)))) :=
      Scheme.Opens.range_ι U₀
    rw [← hr] at hmem
    exact hmem
  refine ⟨lam, hlam, hlamπ, Fm.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom θ),
    IsOpenImmersion.lift U₀.ι _ H', IsOpenImmersion.lift_fac _ _ _, ?_, ?_⟩
  ·
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hθ1, CommRingCat.ofHom_hom, hσL]
  ·
    rw [← cancel_mono U₀.ι]
    simp only [Category.assoc, IsOpenImmersion.lift_fac]
    rw [hψ]
    have hρL : ρ.left ≫ j.left = rT.left := by
      rw [← hρ]
      first
        | rfl
        | simp
    rw [← Category.assoc ρ.left j.left, hρL, ← Category.assoc rT.left eB.hom, ← hbF,
      Category.assoc, ← Spec.map_comp, ← Spec.map_comp]
    congr 2
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro k
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.eval₂Hom_C]
      rw [hCA']
      exact RingHom.congr_fun hθ1 _
    · intro t
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.eval₂Hom_X']
      exact hθ2 t

theorem wc_pmhpi_et_affine_space_pull_bij_any : ∀ (K : Type u) [Field K] [IsAlgClosed K] (n : ℕ), (n : K) ≠ 0 → ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → ∀ (D : wcEtPullData p n) (k : ℕ), Function.Bijective (wcEtPull D k) :=
by
  classical
  intro K _ _ n hn

  have hn0 : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · exact absurd (by rw [h0, Nat.cast_zero]) hn
    · exact h0
  have hpK : ∀ p : ℕ, p ∣ n → (p : K) ≠ 0 := by
    intro p hp hp0
    obtain ⟨c, hc⟩ := hp
    apply hn
    rw [hc, Nat.cast_mul, hp0, zero_mul]

  have s1 : ∀ (Z : Scheme.{u}) (j : ℕ) (m : ℕ), 0 < m →
      (∀ p : ℕ, p.Prime → p ∣ m → Subsingleton (wcEtCoh Z p j)) →
      Subsingleton (wcEtCoh Z m j) := by
    intro Z j m
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})), S.ShortExact →
        ∀ m : ℕ, Subsingleton (Abelian.Ext X S.X₁ m) → Subsingleton (Abelian.Ext X S.X₃ m) →
          Subsingleton (Abelian.Ext X S.X₂ m) := by
      intro X S hS m h1 h3
      let ψ : Abelian.Ext X S.X₂ m →+ Abelian.Ext X S.X₃ m :=
        (Abelian.Ext.mk₀ S.g).postcomp X (add_zero m)
      let φ : Abelian.Ext X S.X₁ m →+ Abelian.Ext X S.X₂ m :=
        (Abelian.Ext.mk₀ S.f).postcomp X (add_zero m)
      have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
        Abelian.Ext.covariant_sequence_exact₂ X hS b hb
      have hz : ∀ b : Abelian.Ext X S.X₂ m, b = 0 := by
        intro b
        obtain ⟨a, ha⟩ := hex b (Subsingleton.elim _ _)
        rw [← ha, Subsingleton.elim a 0, map_zero]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Z)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    have key0 : ∀ (X W : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}),
        Limits.IsZero W → ∀ (x : Abelian.Ext X W j), x = 0 := by
      intro X W hW x
      rw [← Abelian.Ext.comp_mk₀_id x, hW.eq_of_src (𝟙 W) 0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    revert m
    intro m
    induction m using Nat.strong_induction_on with
    | _ m IH =>
      intro hm hp
      by_cases hm1 : m = 1
      · subst hm1
        haveI : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
        have hG : Limits.IsZero (AddCommGrpCat.of (ULift.{u+1} (ZMod 1))) :=
          @AddCommGrpCat.isZero_of_subsingleton _ (inferInstanceAs (Subsingleton (ULift.{u+1} (ZMod 1))))
        have hF := Functor.map_isZero
          (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) hG
        exact ⟨fun x y => (key0 _ _ hF x).trans (key0 _ _ hF y).symm⟩
      · obtain ⟨p, hpdef⟩ : ∃ p, p = Nat.minFac m := ⟨_, rfl⟩
        have hpr : p.Prime := by rw [hpdef]; exact Nat.minFac_prime hm1
        have hpm : p ∣ m := by rw [hpdef]; exact Nat.minFac_dvd m
        have hk : p * (m / p) = m := Nat.mul_div_cancel' hpm
        have hk0 : 0 < m / p := by
          rcases Nat.eq_zero_or_pos (m / p) with h0 | h0
          · rw [h0, mul_zero] at hk
            omega
          · exact h0
        have hklt : m / p < m := Nat.div_lt_self hm hpr.one_lt
        have IHk := IH (m / p) hklt hk0
          (fun q hq hqk => hp q hq (dvd_trans hqk (Dvd.intro_left p hk)))
        have Hp := hp p hpr hpm
        obtain ⟨f, g, hw, hS₀⟩ := hses p (m / p) hpr.ne_zero
        have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        rw [← hk]
        exact hmid _ _ hS j IHk Hp

  have hV : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (q : ℕ), 1 ≤ q →
      Subsingleton (wcEtCoh (Limits.pullback s
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) n q) := by
    intro A _ _ _ s q hq
    exact s1 _ q n hn0 (fun p hp hpn =>
      wc_et_henselian_affine_line_acyclic K p hp (hpK p hpn) A s q hq)

  have s2 : ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K))
      (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n))))) (m : ℕ), 1 ≤ m →
      Limits.IsZero ((((wcEtPush (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).homology m) := by
    intro X fX I m hm
    haveI hπaff : IsAffineHom (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback fX _).flip
        inferInstance
    apply wc_et_stalks_zero
    intro b'
    obtain ⟨A, _, _, _, Λ, _, _, W', φ, a', e, hinit, haff, hφ, hφa, hlim, -, -⟩ :=
      wc_et_geom_strict_henselization b'
    obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) b' Λ W' hinit I.cocomplex m
    obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) A Λ
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt X b')) (Scheme.Etale.forget X)) φ a'
      haff hφ hφa hlim n I m
    obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
      ((Limits.pullbackSymmetry (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) a').hom ≫
        (Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) a').hom) n m
    haveI := hV A (a' ≫ fX) m hm
    exact (E₁.trans (E₂.trans E₃.symm)).subsingleton

  have s3 : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (D : wcEtPullData r n),
      (∀ (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n))))) (k : ℕ), 1 ≤ k →
        Limits.IsZero ((((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          J.cocomplex).homology k)) →
      letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
        @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
      ∃ I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Q n)), ∀ k : ℕ, 1 ≤ k →
        Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont
          D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology k) := by
    intro T Q r D hJ
    letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives Q
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives T
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Q) (wcEtZModRing Q n)
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T) (wcEtZModRing T n)
    haveI hIRQ : HasInjectiveResolutions (SheafOfModules.{u+1} (wcEtZModRing Q n)) :=
      ⟨fun Z => ⟨⟨InjectiveResolution.of Z⟩⟩⟩
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Q)
      (wcEtZModRing Q n)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology T)
      (wcEtZModRing T n)
    have hnpos : 0 < n := hn0
    have sdiv : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        [Injective E], Epi (n • 𝟙 E) := by
      intro X E _
      have hP : Injective ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) :=
        Injective.injective_of_adjoint
          (sheafificationAdjunction (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) E
      have hdiv : ∀ (U : X.Etale)
          (s : ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E).obj
            (Opposite.op U)), ∃ t, n • t = s := by
        intro U s
        let P := (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E
        let G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
          yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
        let φ : G ⟶ P :=
          { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
              (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
            naturality := by
              intro V W h
              apply AddCommGrpCat.hom_ext
              apply FreeAbelianGroup.lift_ext
              intro f
              show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
                  ((G.map h).hom (FreeAbelianGroup.of f)) =
                (P.map h).hom ((FreeAbelianGroup.lift
                  (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
              have hG : (G.map h).hom (FreeAbelianGroup.of f) =
                  FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
              rw [hG]
              erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
              show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
              rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
              rfl }
        have tf : ∀ (Y : Type (u+1)) (a b : FreeAbelianGroup Y), n • a = n • b → a = b := by
          intro Y a b hab
          apply (FreeAbelianGroup.equivFinsupp Y).injective
          ext x
          have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp Y z x) hab
          simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
          exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hnpos.ne') hx
        have hmono : Mono (n • 𝟙 G) := by
          have : ∀ V, Mono ((n • 𝟙 G).app V) := by
            intro V
            rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
            intro a b hab
            simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
              AddMonoidHom.id_apply] at hab
            exact tf _ a b hab
          exact NatTrans.mono_of_mono_app _
        let g := Injective.factorThru φ (n • 𝟙 G)
        have hg : (n • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (n • 𝟙 G)
        rw [Preadditive.nsmul_comp, Category.id_comp] at hg
        refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
        have h1 := congrArg (fun α : G ⟶ P =>
          (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
        have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
          show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
            (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
          rw [FreeAbelianGroup.lift_apply_of]
          simp
        rw [← h2, ← h1]
        simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
        rfl
      have hmap : (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (n • 𝟙 E) =
          n • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      apply Functor.epi_of_epi_map (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      rw [hmap]
      have : ∀ V, Epi ((n • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X)
          AddCommGrpCat.{u+1}).obj E)).app V) := by
        intro V
        rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
        intro s
        obtain ⟨t, ht⟩ := hdiv V.unop s
        exact ⟨t, by simpa using ht⟩
      exact NatTrans.epi_of_epi_app _
    have hker : ∀ (E : Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) [Injective E],
        Epi ((wcEtPush r).map (n • 𝟙 E)) → ∀ q : ℕ,
        Limits.IsZero (((wcEtPush r).rightDerived (q + 1)).obj (Limits.kernel (n • 𝟙 E))) := by
      intro E _ hRe q
      let S := ShortComplex.mk (Limits.kernel.ι (n • 𝟙 E)) (n • 𝟙 E) (Limits.kernel.condition _)
      have hS : S.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ (by dsimp [S]; infer_instance) (sdiv Q E)
        exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (n • 𝟙 E))
      obtain ⟨_, _, hles⟩ := wc_rightDerived_les_package (wcEtPush r) S hS
      obtain ⟨_, δ, h1, h2, _, hex⟩ := hles q
      have hf : ((wcEtPush r).rightDerived (q + 1)).map S.f = 0 :=
        (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) q E).eq_of_tgt _ _
      have hδ : δ = 0 := by
        cases q with
        | zero =>
          have hRe' : Epi ((wcEtPush r).map S.g) := hRe
          have hepi : Epi (((wcEtPush r).rightDerived 0).map S.g) := by
            rw [← NatIso.naturality_2 (wcEtPush r).rightDerivedZeroIsoSelf S.g]
            infer_instance
          exact (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
        | succ m =>
          exact (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) m E).eq_of_src _ _
      exact hex.isZero_X₂ hδ hf
    obtain ⟨α₀, hinj₀, hsurj₀, hR⟩ := wc_et_zmod_ring_locbij Q n
    obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Q)
      (wcEtZModRing Q n) n α₀ hinj₀ hsurj₀
    haveI := hfull
    have hacyc : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Q n)) [Injective I] (k : ℕ),
        Limits.IsZero (((wcEtPush r).rightDerived (k + 1)).obj
          ((SheafOfModules.toSheaf (wcEtZModRing Q n)).obj I)) := by
      intro I _ k
      let Φ := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Q n)
      have hI0 : n • 𝟙 (Φ.obj I) = 0 := by
        apply (sheafToPresheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).map_injective
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
          CategoryTheory.Functor.map_zero]
        ext X m
        have key : ∀ m' : (I.val.obj X : Type _), n • m' = 0 := fun m' => by
          rw [← Nat.cast_smul_eq_nsmul ((wcEtZModRing Q n).obj.obj X) n m', hR X, zero_smul]
        simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
          AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
          AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
        exact key m
      let E := Injective.under (Φ.obj I)
      let ι := Injective.ι (Φ.obj I)
      have hιn : ι ≫ (n • 𝟙 E) = 0 := by
        have h1 : n • ι = (n • 𝟙 (Φ.obj I)) ≫ ι := by
          rw [Preadditive.nsmul_comp, Category.id_comp]
        rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
      let j := Limits.kernel.lift (n • 𝟙 E) ι hιn
      have hj : j ≫ Limits.kernel.ι (n • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
      have : Mono j := mono_of_mono_fac hj
      have hK0 : n • 𝟙 (Limits.kernel (n • 𝟙 E)) = 0 := by
        apply (cancel_mono (Limits.kernel.ι (n • 𝟙 E))).1
        have h1 : Limits.kernel.ι (n • 𝟙 E) ≫ (n • 𝟙 E) = n • Limits.kernel.ι (n • 𝟙 E) := by
          rw [Preadditive.comp_nsmul, Category.comp_id]
        rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
      obtain ⟨M', ⟨β⟩⟩ := hess _ hK0
      let g := Φ.preimage (j ≫ β.inv)
      have hg : Φ.map g = j ≫ β.inv := Φ.map_preimage _
      have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
      let rr := Injective.factorThru (𝟙 I) g
      have hr : g ≫ rr = 𝟙 I := Injective.comp_factorThru _ _
      let ρ := β.inv ≫ Φ.map rr
      have hjρ : j ≫ ρ = 𝟙 _ := by
        calc j ≫ ρ = (j ≫ β.inv) ≫ Φ.map rr := by simp only [ρ, Category.assoc]
          _ = Φ.map (g ≫ rr) := by rw [Φ.map_comp, hg]
          _ = 𝟙 _ := by rw [hr, Φ.map_id]
      have hEinj : Injective ((wcEtPush r).obj E) := by
        obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint r
        haveI := hL
        exact adj.map_injective E inferInstance
      haveI := hEinj
      have hepi : Epi ((wcEtPush r).map (n • 𝟙 E)) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
        exact sdiv T _
      have hK := hker E hepi k
      rw [Limits.IsZero.iff_id_eq_zero]
      calc 𝟙 _ = ((wcEtPush r).rightDerived (k + 1)).map (𝟙 (Φ.obj I)) :=
            (CategoryTheory.Functor.map_id _ _).symm
        _ = ((wcEtPush r).rightDerived (k + 1)).map j ≫
              ((wcEtPush r).rightDerived (k + 1)).map ρ := by
            rw [← hjρ, CategoryTheory.Functor.map_comp]
        _ = 0 := by
            rw [hK.eq_of_tgt (((wcEtPush r).rightDerived (k + 1)).map j) 0, Limits.zero_comp]
    obtain ⟨βc⟩ := wc_et_toSheaf_pushforward_iso r n D
    have hisoR := wc_rightDerived_exact_conj_iso
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) (wcEtPush r)
      (SheafOfModules.toSheaf (wcEtZModRing Q n)) (SheafOfModules.toSheaf (wcEtZModRing T n))
      ⟨βc⟩ hacyc
    refine ⟨InjectiveResolution.of _, fun k hk1 => ?_⟩
    obtain ⟨Θ⟩ := hisoR (SheafOfModules.unit (wcEtZModRing Q n)) k
    obtain ⟨e⟩ := wc_et_zmod_unit_toSheaf_iso Q n
    have h1 : Limits.IsZero (((wcEtPush r).rightDerived k).obj
        ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod n))))) :=
      (hJ (InjectiveResolution.of _) k hk1).of_iso
        ((InjectiveResolution.of _).isoRightDerivedObj (wcEtPush r) k)
    have h2 : Limits.IsZero (((wcEtPush r).rightDerived k).obj
        ((SheafOfModules.toSheaf (wcEtZModRing Q n)).obj (SheafOfModules.unit (wcEtZModRing Q n)))) :=
      h1.of_iso (((wcEtPush r).rightDerived k).mapIso e)
    have h3 := h2.of_iso Θ.symm
    have reflZero : ∀ {Y : SheafOfModules.{u+1} (wcEtZModRing T n)},
        Limits.IsZero ((SheafOfModules.toSheaf (wcEtZModRing T n)).obj Y) → Limits.IsZero Y := by
      intro Y hY
      rw [Limits.IsZero.iff_id_eq_zero]
      apply (SheafOfModules.toSheaf (wcEtZModRing T n)).map_injective
      rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
      exact hY.eq_of_src _ _
    have h4 := reflZero h3
    exact h4.of_iso ((InjectiveResolution.of (SheafOfModules.unit (wcEtZModRing Q n))).isoRightDerivedObj
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) k).symm

  have hA1 : ∀ (T : Scheme.{u}) (fT : T ⟶ Spec (.of K))
      (E : wcEtPullData (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) n) (i : ℕ),
      Function.Bijective (wcEtPull E i) := by
    intro T fT E i
    have h7a := s2 T fT
    obtain ⟨I, hI⟩ := s3 _ E h7a
    have h6 := wc_et_affine_line_unit_iso K T fT n E
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) _ _ E.cont E.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ E.adj E.additive
    haveI := E.additive
    haveI := E.presLim
    haveI := E.presColim
    exact wc_ext_map_bijective_of_degenerate_leray E.Φ
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) _ _ E.cont E.φ)
      E.adj _ _ E.μ h6 I hI i

  have hid : ∀ {X : Scheme.{u}} (E : wcEtPullData (𝟙 X) n) (i : ℕ) (x : wcEtZModExt X n i),
      wcEtPull E i x = x := by
    intro X E i x
    have h' := wc_et_pull_comp (𝟙 X) (𝟙 X) (𝟙 X) (Category.id_comp _) E E E i x
    have h0 : wcEtPull E i (wcEtPull E i x - x) = 0 := by
      rw [map_sub, ← h', sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective E i _ h0)
  have hiso : ∀ {X Z : Scheme.{u}} (g : Z ⟶ X) [IsIso g] (E : wcEtPullData g n) (i : ℕ),
      Function.Bijective (wcEtPull E i) := by
    intro X Z g _ E i
    obtain ⟨Eh⟩ := wc_et_zmod_pull_data_exists (inv g) n
    obtain ⟨EX⟩ := wc_et_zmod_pull_data_exists (𝟙 X) n
    obtain ⟨EZ⟩ := wc_et_zmod_pull_data_exists (𝟙 Z) n
    refine ⟨fun x y hxy => ?_, fun y => ⟨wcEtPull Eh i y, ?_⟩⟩
    · have hx := wc_et_pull_comp g (inv g) (𝟙 X) (IsIso.inv_hom_id g) E Eh EX i x
      have hy := wc_et_pull_comp g (inv g) (𝟙 X) (IsIso.inv_hom_id g) E Eh EX i y
      rw [hid] at hx hy
      calc x = wcEtPull Eh i (wcEtPull E i x) := hx
        _ = wcEtPull Eh i (wcEtPull E i y) := by rw [hxy]
        _ = y := hy.symm
    · have h' := wc_et_pull_comp (inv g) g (𝟙 Z) (IsIso.hom_inv_id g) Eh E EZ i y
      rw [hid] at h'
      exact h'.symm
  intro S fS c P p q hpb D k

  have hpaste : ∀ {S Y W V Z P' : Scheme.{u}} (fS : S ⟶ Z) (g : Y ⟶ Z) (h : W ⟶ Z) (a : V ⟶ Y)
      (b : V ⟶ W) (p' : P' ⟶ S) (q' : P' ⟶ Y), IsPullback p' q' fS g → IsPullback a b g h →
      ∃ r : Limits.pullback (p' ≫ fS) h ⟶ V,
        IsPullback (Limits.pullback.fst (p' ≫ fS) h ≫ p') r fS (a ≫ g) := by
    intro S Y W V Z P' fS g h a b p' q' hA hab
    refine ⟨hab.lift (Limits.pullback.fst (p' ≫ fS) h ≫ q') (Limits.pullback.snd (p' ≫ fS) h) ?_, ?_⟩
    · rw [Category.assoc, ← hA.w]
      exact Limits.pullback.condition
    · refine IsPullback.paste_horiz ?_ hA
      refine IsPullback.of_bot ?_ (hab.lift_fst _ _ _).symm hab
      rw [hab.lift_snd, ← hA.w]
      exact IsPullback.of_hasPullback _ _

  have haffsq : ∀ c : ℕ, ∃ (a : Spec (.of (MvPolynomial (Fin (c + 1)) K)) ⟶ Spec (.of (MvPolynomial (Fin c) K)))
      (b : Spec (.of (MvPolynomial (Fin (c + 1)) K)) ⟶ Spec (.of (Polynomial K))),
      IsPullback a b (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧
      a ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) =
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c + 1)) K))) := by
    intro c
    have h1 := CommRingCat.isPushout_tensorProduct K (MvPolynomial (Fin c) K) (Polynomial K)
    have h2 := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ h1
    let Φ : MvPolynomial (Fin (c + 1)) K ≃ₐ[K]
        TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K) :=
      (MvPolynomial.finSuccEquiv K c).trans (polyEquivTensor K (MvPolynomial (Fin c) K))
    let φi := Φ.toRingEquiv.toCommRingCatIso
    let E := asIso (Spec.map φi.hom)
    refine ⟨E.inv ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom :
          MvPolynomial (Fin c) K →+* TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K))),
      E.inv ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight :
          Polynomial K →ₐ[K] TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K)).toRingHom),
      ?_, ?_⟩
    · refine IsPullback.of_iso h2 E (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · simp
      · simp
    · have hring : CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)) ≫
          CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            MvPolynomial (Fin c) K →+* TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K)) =
          CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c + 1)) K)) ≫ φi.hom := by
        ext x
        change (Algebra.TensorProduct.includeLeftRingHom :
            MvPolynomial (Fin c) K →+* TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K))
            (algebraMap K (MvPolynomial (Fin c) K) x) = Φ (algebraMap K _ x)
        rw [Φ.commutes, Algebra.TensorProduct.algebraMap_apply]
        rfl
      rw [Category.assoc, ← Spec.map_comp, hring, Spec.map_comp]
      simp [E]

  have hsucc : ∀ (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S)
      (q : P ⟶ Spec (.of (MvPolynomial (Fin (c + 1)) K))),
      IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c + 1)) K)))) →
      ∃ (P' : Scheme.{u}) (p' : P' ⟶ S) (q' : P' ⟶ Spec (.of (MvPolynomial (Fin c) K)))
        (e : P ⟶ Limits.pullback (p' ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))),
        IsPullback p' q' fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ∧
        IsIso e ∧
        (e ≫ Limits.pullback.fst (p' ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ≫ p' = p := by
    intro c P p q hpb
    obtain ⟨a, b, hab, hag⟩ := haffsq c
    have hA := IsPullback.of_hasPullback fS
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))
    obtain ⟨r, hQ⟩ := hpaste fS _ (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) a b _ _
      hA hab
    rw [hag] at hQ
    refine ⟨_, _, _, (hpb.isoIsPullback _ _ hQ).hom, hA, inferInstance, ?_⟩
    rw [Category.assoc]
    exact IsPullback.isoIsPullback_hom_fst _ _ hpb hQ

  have main : ∀ (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S)
      (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))),
      IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) →
      ∀ (D : wcEtPullData p n) (k : ℕ), Function.Bijective (wcEtPull D k) := by
    intro c
    induction c with
    | zero =>
      intro P p q hpb D k
      have hbij : Function.Bijective (algebraMap K (MvPolynomial (Fin 0) K)) :=
        ⟨MvPolynomial.C_injective _ _, MvPolynomial.C_surjective _⟩
      haveI : IsIso (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 0) K))) :=
        (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
      haveI : IsIso p := hpb.isIso_fst_of_isIso
      exact hiso p D k
    | succ c ih =>
      intro P p q hpb D k
      obtain ⟨P', p', q', e, hpb', he, hep⟩ := hsucc c P p q hpb
      haveI := he
      obtain ⟨Dp'⟩ := wc_et_zmod_pull_data_exists p' n
      obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (p' ≫ fS)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) n
      obtain ⟨De⟩ := wc_et_zmod_pull_data_exists e n
      obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (e ≫ Limits.pullback.fst (p' ≫ fS)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) n
      have h1 := ih P' p' q' hpb' Dp' k
      have h2 := hA1 P' (p' ≫ fS) Dπ k
      have h3 := hiso e De k
      have hfun : ⇑(wcEtPull D k) =
          ⇑(wcEtPull De k) ∘ ⇑(wcEtPull Dπ k) ∘ ⇑(wcEtPull Dp' k) := by
        funext x
        rw [wc_et_pull_comp p' _ p hep Dp' Dr D k x, wc_et_pull_comp _ e _ rfl Dπ De Dr k]
        rfl
      rw [hfun]
      exact h3.comp (h2.comp h1)
  exact main c P p q hpb D k

