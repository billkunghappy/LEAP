theorem wc_srdcbR_pbc_homology : ∀ {X X' Z Z' : Scheme.{u}} (β : X' ⟶ X) [IsProper β] (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ X') (βZ : Z' ⟶ Z), IsPullback i' βZ β i → ∀ (m : ℕ), 0 < m → ∀ (Dβ : wcEtPullData β m) (Di : wcEtPullData i m) (DβZ : wcEtPullData βZ m) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X' m))) (J : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Z' m))) (q : ℕ), haveI := Dβ.additive; haveI := DβZ.additive; letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange β) _ _ Dβ.cont Dβ.φ).Additive := Adjunction.right_adjoint_additive Dβ.adj; letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange βZ) _ _ DβZ.cont DβZ.φ).Additive := Adjunction.right_adjoint_additive DβZ.adj; Nonempty (Di.Φ.obj ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange β) _ _ Dβ.cont Dβ.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) ≅ (((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange βZ) _ _ DβZ.cont DβZ.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology q) :=
