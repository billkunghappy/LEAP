  have hmOpe : Mono (wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE)) := by
    haveI : Mono (wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE)).left := by
      show Mono (Limits.pullback.snd Op.ι (wcGeomPoint K E₀ hE).hom)
      infer_instance
    exact ⟨fun g h e' => MorphismProperty.Over.Hom.ext
      ((cancel_mono (wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE)).left).mp (by
        have e'' := congrArg (fun t => t.left) e'
        first
          | exact e''
          | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e''))⟩
  have hmU : Mono (wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))) := by
    haveI : Mono (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)).left := by
      show Mono (Limits.pullback.snd U.ι (wcGeomPoint K E₀ hE).hom)
      infer_instance
    haveI : Mono (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)) := ⟨fun g h e' =>
      MorphismProperty.Over.Hom.ext
      ((cancel_mono (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)).left).mp (by
        have e'' := congrArg (fun t => t.left) e'
        first
          | exact e''
          | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e''))⟩
    unfold wcFreeSheafMap
    exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology E₀.left) AddCommGrpCat.{u+1})
      (Functor.whiskerRight (yoneda.map (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have hmO : Mono (wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE))) := by
    haveI := hmOpe
    unfold wcFreeSheafMap
    exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology E₀.left) AddCommGrpCat.{u+1})
      (Functor.whiskerRight (yoneda.map (wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))

  obtain ⟨ΦU, hΦU⟩ := Hres U (wcGeomPoint K E₀ hE) (wcGeomFrob K E₀ hE)
  obtain ⟨ΦO, hΦO⟩ := Hres Op (wcGeomPoint K E₀ hE) (wcGeomFrob K E₀ hE)
  have hΦUO : ΦU ≫ jUO = jUO ≫ ΦO := by
    rw [← cancel_mono (wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE))]
    rw [Category.assoc, hjUO, hΦU, Category.assoc, hΦO, ← Category.assoc, hjUO]
  have hdU : wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)) ≫
      wcFreeSheafMap E₀.left (wcGeomFrob K E₀ hE) ≫
      Limits.cokernel.π (wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)))
        = 0 := by
    rw [← Category.assoc, ← F0, ← hΦU, F0, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  obtain ⟨ΨU, hΨU⟩ : ∃ ΨU : Limits.cokernel (wcFreeSheafMap E₀.left
        (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))) ⟶
      Limits.cokernel (wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))),
      Limits.cokernel.π (wcFreeSheafMap E₀.left
          (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))) ≫ ΨU =
        wcFreeSheafMap E₀.left (wcGeomFrob K E₀ hE) ≫
          Limits.cokernel.π (wcFreeSheafMap E₀.left
            (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))) :=
    ⟨_, Limits.cokernel.π_desc _ _ hdU⟩
  have hd' : wcFreeSheafMap E₀.left jUO ≫ wcFreeSheafMap E₀.left ΦO ≫
      Limits.cokernel.π (wcFreeSheafMap E₀.left jUO) = 0 := by
    rw [← Category.assoc, ← F0, ← hΦUO, F0, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  obtain ⟨Ψ', hΨ'⟩ : ∃ Ψ' : Limits.cokernel (wcFreeSheafMap E₀.left jUO) ⟶
      Limits.cokernel (wcFreeSheafMap E₀.left jUO),
      Limits.cokernel.π (wcFreeSheafMap E₀.left jUO) ≫ Ψ' =
        wcFreeSheafMap E₀.left ΦO ≫ Limits.cokernel.π (wcFreeSheafMap E₀.left jUO) :=
    ⟨_, Limits.cokernel.π_desc _ _ hd'⟩

  have hS1 : (ShortComplex.mk
      (wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)))
      (Limits.cokernel.π (wcFreeSheafMap E₀.left
        (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmU inferInstance
  have hc5 : ∀ j, 1 ≤ j → ∀ x : Abelian.Ext (wcFreeSheaf E₀.left
      (wcOpenRestr E₀.left U (wcGeomPoint K E₀ hE))) (wcContSheaf E₀.left (ZMod (ℓ ^ k))) j,
      x = 0 :=
    fun j hj x => wc_proet_affine_open_acyclic K ℓ hℓ E₀ hE U (e + 2) φ hφ k j hj x
  obtain ⟨B, hBdef⟩ : ∃ B : Abelian.Ext (Limits.cokernel (wcFreeSheafMap E₀.left
        (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))))
        (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2) →+
      wcCohG K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2),
      ∀ y, B y = (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap E₀.left
        (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))))).comp y (zero_add (e + 2)) :=
    ⟨(Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap E₀.left
        (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))))).precomp _ (zero_add (e + 2)),
      fun y => rfl⟩
  have hBsurj : Function.Surjective B := by
    intro x
    obtain ⟨y, hy⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS1 _ x (hc5 _ (by omega) _)
    exact ⟨y, (hBdef y).trans hy⟩
  have hBinj : Function.Injective B := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    rw [hBdef] at hy
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS1 _ y hy
      (show 1 + (e + 1) = e + 2 by omega)
    rw [← hx₁, hc5 (e + 1) (by omega) x₁, Abelian.Ext.comp_zero]
  have hBinvB : ∀ z, (AddEquiv.ofBijective B ⟨hBinj, hBsurj⟩).symm (B z) = z :=
    fun z => (AddEquiv.ofBijective B ⟨hBinj, hBsurj⟩).symm_apply_apply z

  haveI := hmO
  obtain ⟨a, bm, w, hA, hB, hS2⟩ := C1 (wcFreeSheafMap E₀.left jUO)
    (wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE)))
    (wcFreeSheafMap E₀.left (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE)))
    ((F0 _ _).symm.trans (congrArg _ hjUO))
  obtain ⟨A, hAdef⟩ : ∃ A : Abelian.Ext (Limits.cokernel (wcFreeSheafMap E₀.left
        (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))))
        (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2) →+
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap E₀.left jUO))
        (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2),
      ∀ y, A y = (Abelian.Ext.mk₀ a).comp y (zero_add (e + 2)) :=
    ⟨(Abelian.Ext.mk₀ a).precomp _ (zero_add (e + 2)), fun y => rfl⟩
  have hAinj : Function.Injective A := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    rw [hAdef] at hy
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS2 _ y hy
    rw [← hx₃, wc_proet_rat_point_supp_semipurity K ℓ hℓ E₀ (e + 2) hE s hs Op hOs k (e + 2)
      (by omega) x₃, Abelian.Ext.comp_zero]
  have haΨ : a ≫ ΨU = Ψ' ≫ a := by
    rw [← cancel_epi (Limits.cokernel.π (wcFreeSheafMap E₀.left jUO))]
    rw [reassoc_of% hA, hΨU, reassoc_of% hΨ', hA, ← Category.assoc, ← Category.assoc, ← F0,
      ← F0, hΦO]

  haveI : SmoothOfRelativeDimension (e + 1 + 1) E₀.hom :=
    (inferInstance : SmoothOfRelativeDimension (e + 2) E₀.hom)
  obtain ⟨γ, hγ, hγF⟩ := wc_proet_open_smooth_divisor_gysin_frob K ℓ hℓ E₀ (e + 1) hE Op U hUO
    D hD iD hiD hiDE hrange jUO hjUO ΦO hΦO Ψ' hΨ' k e
  obtain ⟨ψ, hψ, hψF⟩ := wc_proet_cohG_A1_contraction_inj K ℓ hℓ D E₁ (e + 1) hD hE₁ σ π hσ hπ
    hσπ h i₀ i₁ hhK hi₀f hi₀s hi₁f hi₁s hh₀ hh₁ k e

  refine ⟨ψ.comp (γ.comp (A.comp (AddEquiv.ofBijective B ⟨hBinj, hBsurj⟩).symm.toAddMonoidHom)),
    ?_, ?_⟩
  · intro x y hxy
    apply (AddEquiv.ofBijective B ⟨hBinj, hBsurj⟩).symm.injective
    apply hAinj
    apply hγ
    apply hψ
    exact hxy
  · intro x
    obtain ⟨y, rfl⟩ := hBsurj x
    have e2 : wcCohGFrob K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2) (B y) =
        B ((Abelian.Ext.mk₀ ΨU).comp y (zero_add (e + 2))) := by
      rw [hBdef, hBdef]
      show (Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left (wcGeomFrob K E₀ hE))).comp
          ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap E₀.left
            (wcOpenRestrIncl E₀.left U (wcGeomPoint K E₀ hE))))).comp y (zero_add (e + 2)))
          (zero_add (e + 2)) = _
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hΨU]
    have e3 : A ((Abelian.Ext.mk₀ ΨU).comp y (zero_add (e + 2))) =
        (Abelian.Ext.mk₀ Ψ').comp (A y) (zero_add (e + 2)) := by
      rw [hAdef, hAdef, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, haΨ]
    show ψ (γ (A ((AddEquiv.ofBijective B ⟨hBinj, hBsurj⟩).symm
        (wcCohGFrob K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2) (B y))))) =
      Nat.card K • wcCohGFrob K E₁ hE₁ (wcContSheaf E₁.left (ZMod (ℓ ^ k))) e
        (ψ (γ (A ((AddEquiv.ofBijective B ⟨hBinj, hBsurj⟩).symm (B y)))))
    rw [e2, hBinvB, hBinvB, e3, hγF, map_nsmul, hψF]

theorem wc_even_quadric_zmod_frob_sq (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ¬ ℓ ∣ Nat.card K) (d : ℕ) (hd : Even d) (E₀ : Over (Spec (.of K)))
    [IsProper E₀.hom] [SmoothOfRelativeDimension d E₀.hom]
    (jE : E₀.left ⟶ wcProjK K (d + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (d + 1) = E₀.hom)
    (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (hEG : ∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) c),
      wcLdpGerm K (d + 1) jE (wcLdpQuad K (d + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (k : ℕ) :
    ∀ x : wcCohG K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) d,
      wcCohGFrob K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) d
          (wcCohGFrob K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) d x) =
        (Nat.card K ^ d) • x :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have hyon : ∀ (S : Scheme.{u}) (V : S.ProEt) (g : V ⟶ V)
      (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      (∀ t : G.obj.obj (Opposite.op V), G.obj.map g.op t = t) →
      ∀ φ : wcFreeSheaf S V ⟶ G, wcFreeSheafMap S g ≫ φ = φ := by
    intro S V g G hG φ
    let Q : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let α : Q ⟶ Q :=
      Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let adj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
    let adjW := Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}
    let β : uliftYoneda.{u+1}.obj V ⟶ uliftYoneda.{u+1}.obj V := uliftYoneda.{u+1}.map g
    have hψ : ∀ ψ : Q ⟶ G.obj, α ≫ ψ = ψ := by
      intro ψ
      have key : β ≫ adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ =
          adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ := by
        apply (uliftYonedaEquiv.{u+1} (X := V) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})).injective
        have h3 := uliftYonedaEquiv_naturality.{u+1}
          (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ) g.op
        exact h3.symm.trans (hG (uliftYonedaEquiv.{u+1} (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ)))
      have h4 : ((Functor.whiskeringRight S.ProEtᵒᵖ (Type (u+1)) AddCommGrpCat.{u+1}).obj
          AddCommGrpCat.free).map β ≫ ψ = ψ := by
        apply (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj).injective
        exact (adjW.homEquiv_naturality_left β ψ).trans key
      exact h4
    have e1 := adj.homEquiv_naturality_left α φ
    apply (adj.homEquiv Q G).injective
    exact e1.trans (hψ (adj.homEquiv Q G φ))

  suffices H : ∀ d : ℕ, Even d → ∀ (E₀ : Over (Spec (.of K)))
      [IsProper E₀.hom] [SmoothOfRelativeDimension d E₀.hom]
      (jE : E₀.left ⟶ wcProjK K (d + 1)), IsClosedImmersion jE →
      jE ≫ wcProjKStr K (d + 1) = E₀.hom →
      ∀ (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K),
      (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 →
      (∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) c),
        wcLdpGerm K (d + 1) jE (wcLdpQuad K (d + 1) a) c x hx ∈
          IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x)) →
      ∀ (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))),
      ∀ x : wcCohG K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) d,
        wcCohGFrob K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) d
            (wcCohGFrob K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) d x) =
          (Nat.card K ^ d) • x by
    exact H d hd E₀ jE hjE hjEY a ha hEG hE
  intro d
  refine Nat.strong_induction_on d ?_
  intro d IH
  match d, IH with
  | 0, _ =>

    intro _ E₀ _ _ jE hjE hjEY a ha hEG hE x
    have hfix := wc_quadric_dim0_frob_sq_fix K E₀ jE hjE hjEY a ha hEG hE
    have hsec : ∀ t : (wcContSheaf E₀.left (ZMod (ℓ ^ k))).obj.obj
        (Opposite.op (wcGeomPoint K E₀ hE)),
        (wcContSheaf E₀.left (ZMod (ℓ ^ k))).obj.map
          (wcGeomFrob K E₀ hE ≫ wcGeomFrob K E₀ hE).op t = t := by
      have key : ∀ (f : C(↥(wcGeomPoint K E₀ hE).left, ZMod (ℓ ^ k)))
          (z : ↥(wcGeomPoint K E₀ hE).left),
          f ((wcGeomFrob K E₀ hE).left ((wcGeomFrob K E₀ hE).left z)) = f z := by
        intro f z
        rw [hfix z]
      intro t
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact key (ULift.down t) z
    have hx := Abelian.Ext.mk₀_homEquiv₀_apply x
    generalize Abelian.Ext.homEquiv₀ x = φ at hx
    subst hx
    show (Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left (wcGeomFrob K E₀ hE))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left (wcGeomFrob K E₀ hE))).comp
          (Abelian.Ext.mk₀ φ) (zero_add 0)) (zero_add 0) =
      (Nat.card K ^ 0) • Abelian.Ext.mk₀ φ
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, ← Category.assoc, ← F0,
      hyon _ _ _ _ hsec φ, pow_zero, one_smul]
  | 1, _ =>

    intro hd
    exact absurd hd Nat.not_even_one
  | e + 2, IH =>
    intro hd E₀ _ _ jE hjE hjEY a ha hEG hE x
    rcases isEmpty_or_nonempty E₀.left with hemp | hne
    ·
      rw [wc_cohG_empty_zero K E₀ hE _ _ x, map_zero, map_zero, smul_zero]
    ·
      have he : Even e := by
        rcases hd with ⟨r, hr⟩
        exact ⟨r - 1, by omega⟩
      have hEall := wc_quadric_section_full K (e + 2) (by omega) E₀ jE hjE hjEY a ha hEG
      obtain ⟨a', b, L, M, ha', hb, hL, hM, hLM, hML, hab⟩ :=
        wc_quadric_hyperbolic_normal_form K e a ha
      obtain ⟨jE', hjE', hjEY', hEG', hEall'⟩ :=
        wc_quadric_linear_reembed K (e + 2 + 1) E₀.left jE hjE a b L M hL hM hLM hML hab hEG hEall
      have hjEY'' : jE' ≫ wcProjKStr K (e + 2 + 1) = E₀.hom := hjEY'.trans hjEY
      obtain ⟨E₁, hpr₁, hsm₁, jE₁, hjE₁, hjEY₁, hEG₁, hEall₁⟩ :=
        wc_smooth_quadric_hypersurface K e a' ha'
      haveI := hpr₁
      haveI := hsm₁
      have hE₁ : WeaklyEtale (Limits.pullback.fst E₁.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
        MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
          (wc_weaklyEtale_algebraicClosure K)
      obtain ⟨ι, hinj, hιF⟩ := wc_split_quadric_cone_step K ℓ hℓ e he a' ha' b hb E₀ jE' hjE'
        hjEY'' hEG' hEall' hE E₁ jE₁ hjE₁ hjEY₁ hEG₁ hEall₁ hE₁ k
      have hsq := IH e (by omega) he E₁ jE₁ hjE₁ hjEY₁ a' ha' hEG₁ hE₁
      apply hinj
      simp only [hιF, map_nsmul, hsq, smul_smul]
      congr 1
      ring

theorem wc_mtube_ratpt_strict_germ_punct_et_vanish (K : Type u) [Field K] [Finite K]
    (X : Over (Spec (.of K))) (n : ℕ) [IsProper X.hom] [SmoothOfRelativeDimension n X.hom]
    (x : Spec (.of K) ⟶ X.left) (hx : x ≫ X.hom = 𝟙 _)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (T : X.left.ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : T.left ≅ Spec (.of B))
    (hpt : T.hom (eB.inv (IsLocalRing.closedPoint B)) = x (IsLocalRing.closedPoint K))
    (VT : X.left.ProEt) (jc : VT ⟶ T) (hjc : IsOpenImmersion jc.left)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (jj : ℕ) (h1 : 1 ≤ jj) (h2 : jj + 2 ≤ 2 * n) :
    Subsingleton (wcEtCoh VT.left ℓ jj) :=
by
  classical

  have hlift : ∀ ψ : K →+* B, ∃ τ : AlgebraicClosure K →+* B,
      τ.comp (algebraMap K (AlgebraicClosure K)) = ψ := by
    intro ψ
    letI := Fintype.ofFinite K
    obtain ⟨p, hpK⟩ := CharP.exists K
    haveI := hpK
    haveI hp : Fact p.Prime := ⟨CharP.char_is_prime K p⟩
    have hp2 : 2 ≤ p := hp.out.two_le
    haveI : CharP B p := charP_of_injective_ringHom ψ.injective p
    have iter : ∀ (b : B) (N : ℕ), b ^ (p ^ N) = b → ∀ k, b ^ (p ^ (N * k)) = b := by
      intro b N h k
      induction k with
      | zero => simp
      | succ k ih => rw [Nat.mul_succ, pow_add, pow_mul, ih, h]

    have hU : ∀ (b b' : B) (N : ℕ), 1 ≤ N → b ^ (p ^ N) = b → b' ^ (p ^ N) = b' →
        IsLocalRing.residue B b = IsLocalRing.residue B b' → b = b' := by
      intro b b' N hN hb hb' hr
      have hd : b - b' ∈ IsLocalRing.maximalIdeal B := by
        rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hr, sub_self]
      have hQ : 2 ≤ p ^ N := le_trans hp2 (by
        calc p = p ^ 1 := (pow_one p).symm
          _ ≤ p ^ N := Nat.pow_le_pow_right (by omega) hN)
      have hdQ : (b - b') ^ (p ^ N) = b - b' := by rw [sub_pow_char_pow, hb, hb']
      have hm : (b - b') ^ (p ^ N - 1) ∈ IsLocalRing.maximalIdeal B :=
        Ideal.pow_mem_of_mem _ hd _ (by omega)
      have hu : IsUnit (1 - (b - b') ^ (p ^ N - 1)) :=
        IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hm
      have h0 : (b - b') * (1 - (b - b') ^ (p ^ N - 1)) = 0 := by
        have : (b - b') * (b - b') ^ (p ^ N - 1) = (b - b') ^ (p ^ N) := by
          rw [← pow_succ']; congr 1; omega
        rw [mul_sub, mul_one, this, hdQ, sub_self]
      exact sub_eq_zero.mp ((hu.mul_left_eq_zero).mp h0)

    have hE : ∀ (s : IsLocalRing.ResidueField B) (N : ℕ), 1 ≤ N → s ^ (p ^ N) = s →
        ∃ b : B, b ^ (p ^ N) = b ∧ IsLocalRing.residue B b = s := by
      intro s N hN hs
      have hQ : 2 ≤ p ^ N := le_trans hp2 (by
        calc p = p ^ 1 := (pow_one p).symm
          _ ≤ p ^ N := Nat.pow_le_pow_right (by omega) hN)
      obtain ⟨b₀, hb₀⟩ := IsLocalRing.residue_surjective s
      have hmon : (Polynomial.X ^ (p ^ N) - Polynomial.X : Polynomial B).Monic := by
        apply Polynomial.monic_X_pow_sub
        rw [Polynomial.degree_X]
        exact_mod_cast (by omega : 1 < p ^ N)
      have hQ0 : ((p ^ N : ℕ) : B) = 0 := by
        rw [Nat.cast_pow, CharP.cast_eq_zero, zero_pow (by omega)]
      have hev : Polynomial.eval b₀ (Polynomial.X ^ (p ^ N) - Polynomial.X : Polynomial B) ∈
          IsLocalRing.maximalIdeal B := by
        rw [← IsLocalRing.residue_eq_zero_iff]
        simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, map_sub, map_pow,
          hb₀, hs, sub_self]
      have hder : IsUnit (Polynomial.eval b₀
          (Polynomial.derivative (Polynomial.X ^ (p ^ N) - Polynomial.X : Polynomial B))) := by
        simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_X,
          Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_one, hQ0,
          zero_mul, zero_sub]
        exact isUnit_one.neg
      obtain ⟨b, hbroot, hbm⟩ := HenselianLocalRing.is_henselian _ hmon b₀ hev hder
      refine ⟨b, ?_, ?_⟩
      · have h := hbroot.eq_zero
        simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X] at h
        exact sub_eq_zero.mp h
      · rw [← hb₀]
        have h := (IsLocalRing.residue_eq_zero_iff _).mpr hbm
        rw [map_sub] at h
        exact sub_eq_zero.mp h

    have hX : ∀ a : AlgebraicClosure K, ∃ N, 1 ≤ N ∧ a ^ (p ^ N) = a := by
      intro a
      have hint : IsIntegral K a := Algebra.IsIntegral.isIntegral a
      haveI : FiniteDimensional K (IntermediateField.adjoin K {a}) :=
        IntermediateField.adjoin.finiteDimensional hint
      haveI : Finite (IntermediateField.adjoin K {a}) := Module.finite_of_finite K
      letI := Fintype.ofFinite (IntermediateField.adjoin K {a})
      haveI : CharP (IntermediateField.adjoin K {a}) p :=
        charP_of_injective_ringHom (algebraMap K (IntermediateField.adjoin K {a})).injective p
      obtain ⟨m, -, hm⟩ := FiniteField.card (IntermediateField.adjoin K {a}) p
      refine ⟨m, m.pos, ?_⟩
      have h := FiniteField.pow_card
        (⟨a, IntermediateField.mem_adjoin_simple_self K a⟩ : IntermediateField.adjoin K {a})
      rw [hm] at h
      have h' := congrArg (fun y : IntermediateField.adjoin K {a} => (y : AlgebraicClosure K)) h
      simpa using h'

    letI : Algebra K (IsLocalRing.ResidueField B) := ((IsLocalRing.residue B).comp ψ).toAlgebra
    let σ : AlgebraicClosure K →ₐ[K] IsLocalRing.ResidueField B := IsSepClosed.lift
    choose N hN1 hNa using hX
    have hE' : ∀ a : AlgebraicClosure K, ∃ b : B, b ^ (p ^ N a) = b ∧
        IsLocalRing.residue B b = σ a := fun a =>
      hE (σ a) (N a) (hN1 a) (by rw [← map_pow, hNa a])
    choose τf hτp hτr using hE'
    have hchar : ∀ (a : AlgebraicClosure K) (b : B) (M : ℕ), 1 ≤ M → b ^ (p ^ M) = b →
        IsLocalRing.residue B b = σ a → τf a = b := by
      intro a b M hM hb hr
      apply hU (τf a) b (N a * M) (Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero
        (by have := hN1 a; omega) (by omega))) (iter _ _ (hτp a) M)
      · rw [mul_comm]; exact iter b M hb (N a)
      · rw [hτr a, hr]
    have hNN : ∀ a a' : AlgebraicClosure K, 1 ≤ N a * N a' := fun a a' =>
      Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by have := hN1 a; omega)
        (by have := hN1 a'; omega))
    let τ : AlgebraicClosure K →+* B :=
      { toFun := τf
        map_one' := hchar 1 1 1 le_rfl (one_pow _) (by rw [map_one, map_one])
        map_mul' := fun a a' => hchar (a * a') (τf a * τf a') (N a * N a') (hNN a a')
          (by rw [mul_pow, iter _ _ (hτp a), mul_comm (N a), iter _ _ (hτp a')])
          (by rw [map_mul, hτr, hτr, map_mul])
        map_zero' := hchar 0 0 1 le_rfl (zero_pow (by positivity)) (by rw [map_zero, map_zero])
        map_add' := fun a a' => hchar (a + a') (τf a + τf a') (N a * N a') (hNN a a')
          (by rw [add_pow_char_pow, iter _ _ (hτp a), mul_comm (N a), iter _ _ (hτp a')])
          (by rw [map_add, hτr, hτr, map_add]) }
    refine ⟨τ, ?_⟩
    ext c
    obtain ⟨f, -, hf⟩ := FiniteField.card K p
    show τf (algebraMap K (AlgebraicClosure K) c) = ψ c
    apply hchar _ (ψ c) f f.pos
    · rw [← map_pow, ← hf, FiniteField.pow_card]
    · rw [AlgHom.commutes]
      rfl

  obtain ⟨ι, hι⟩ : ∃ ι : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of K),
      ι = Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := ⟨_, rfl⟩
  have hιw : WeaklyEtale ι := hι ▸ wc_weaklyEtale_algebraicClosure K
  haveI : SmoothOfRelativeDimension n (Limits.pullback.snd X.hom ι) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
      (IsPullback.of_hasPullback X.hom ι) ‹_›
  haveI : IsLocallyNoetherian (Limits.pullback X.hom ι) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd X.hom ι)
  have hfst : WeaklyEtale (Limits.pullback.fst X.hom ι) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback X.hom ι).flip hιw
  have hxι : (ι ≫ x) ≫ X.hom = 𝟙 _ ≫ ι := by
    rw [Category.assoc, hx, Category.comp_id, Category.id_comp]
  obtain ⟨i, hi₁, hi₂⟩ : ∃ i : Spec (.of (AlgebraicClosure K)) ⟶ Limits.pullback X.hom ι,
      i ≫ Limits.pullback.fst X.hom ι = ι ≫ x ∧ i ≫ Limits.pullback.snd X.hom ι = 𝟙 _ :=
    ⟨Limits.pullback.lift (ι ≫ x) (𝟙 _) hxι, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  haveI : IsClosedImmersion (i ≫ Limits.pullback.snd X.hom ι) := by rw [hi₂]; infer_instance
  haveI : IsSeparated (Limits.pullback.snd X.hom ι) := inferInstance
  haveI : IsClosedImmersion i := IsClosedImmersion.of_comp i (Limits.pullback.snd X.hom ι)
  haveI : SmoothOfRelativeDimension 0 (i ≫ Limits.pullback.snd X.hom ι) := by
    rw [hi₂]; infer_instance
  have hℓK : (ℓ : K) ≠ 0 := by
    intro h0
    letI := Fintype.ofFinite K
    obtain ⟨p, hpK⟩ := CharP.exists K
    haveI := hpK
    have hpd : p ∣ ℓ := (CharP.cast_eq_zero_iff K p ℓ).mp h0
    have hpp : p.Prime := CharP.char_is_prime K p
    have hpl : p = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hpd
    have hc0 : ((Nat.card K : ℕ) : K) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero K
    have := (CharP.cast_eq_zero_iff K p _).mp hc0
    rw [hpl] at this
    exact hℓ this
  have hℓKbar : (ℓ : AlgebraicClosure K) ≠ 0 := by
    rw [← map_natCast (algebraMap K (AlgebraicClosure K))]
    exact (map_ne_zero _).mpr hℓK
  obtain ⟨V, hV⟩ : ∃ V : (Limits.pullback X.hom ι).Opens, (V : Set _) = (Set.range i)ᶜ :=
    ⟨⟨_, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩

  haveI hT : WeaklyEtale T.hom := T.prop
  obtain ⟨τ, hτ⟩ := hlift (Spec.preimage (R := .of K) (S := .of B) (eB.inv ≫ T.hom ≫ X.hom)).hom
  have hw : (eB.inv ≫ T.hom) ≫ X.hom = Spec.map (CommRingCat.ofHom τ) ≫ ι := by
    rw [hι, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hτ, CommRingCat.ofHom_hom,
      Spec.map_preimage, Category.assoc]
  obtain ⟨c, hc₁⟩ : ∃ c : Spec (.of B) ⟶ Limits.pullback X.hom ι,
      c ≫ Limits.pullback.fst X.hom ι = eB.inv ≫ T.hom :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _⟩
  have hcw : WeaklyEtale (c ≫ Limits.pullback.fst X.hom ι) := by rw [hc₁]; infer_instance
  have hc : WeaklyEtale c :=
    MorphismProperty.of_postcomp @WeaklyEtale (W' := @WeaklyEtale) c
      (Limits.pullback.fst X.hom ι) hfst hcw

  have hcp : Limits.pullback.fst X.hom ι (c (IsLocalRing.closedPoint B)) =
      x (IsLocalRing.closedPoint K) :=
    (Scheme.Hom.comp_apply c (Limits.pullback.fst X.hom ι) (IsLocalRing.closedPoint B)).symm.trans
      ((congrArg (fun g : Spec (.of B) ⟶ X.left => g (IsLocalRing.closedPoint B)) hc₁).trans
        ((Scheme.Hom.comp_apply eB.inv T.hom (IsLocalRing.closedPoint B)).trans hpt))
  have huniq : ∀ y y' : ↥(Limits.pullback X.hom ι),
      Limits.pullback.fst X.hom ι y = x (IsLocalRing.closedPoint K) →
      Limits.pullback.fst X.hom ι y' = x (IsLocalRing.closedPoint K) → y = y' := by
    intro y y' hy hy'
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst X.hom ι) (g := x) y (IsLocalRing.closedPoint K) hy
    obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst X.hom ι) (g := x) y' (IsLocalRing.closedPoint K) hy'
    haveI : IsIso (x ≫ X.hom) := by rw [hx]; infer_instance
    let e := Limits.pullbackSymmetry (Limits.pullback.fst X.hom ι) x ≪≫
      Limits.pullbackRightPullbackFstIso X.hom ι x ≪≫
      asIso (Limits.pullback.snd (x ≫ X.hom) ι)
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure K))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure K))
      infer_instance
    have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
    rw [← hz1, ← hz1', hzz]
  have hsubK : Subsingleton (Spec (.of K)) := by
    show Subsingleton (PrimeSpectrum K)
    infer_instance
  have hF1 : ∀ w, Limits.pullback.fst X.hom ι (i w) = x (IsLocalRing.closedPoint K) := by
    intro w
    rw [← Scheme.Hom.comp_apply, hi₁, Scheme.Hom.comp_apply,
      Subsingleton.elim (ι w) (IsLocalRing.closedPoint K)]
  have hrng : c ⁻¹' Set.range i = {IsLocalRing.closedPoint B} := by
    ext z
    simp only [Set.mem_preimage, Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨w, hw⟩
      apply wc_yjl_weaklyEtale_fibre_specializes _ hcw z _ (IsLocalRing.specializes_closedPoint z)
      exact (Scheme.Hom.comp_apply c (Limits.pullback.fst X.hom ι) z).trans
        ((congrArg (fun y => Limits.pullback.fst X.hom ι y) hw.symm).trans ((hF1 w).trans
          (hcp.symm.trans (Scheme.Hom.comp_apply c (Limits.pullback.fst X.hom ι) _).symm)))
    · rintro rfl
      exact ⟨IsLocalRing.closedPoint (AlgebraicClosure K), huniq _ _ (hF1 _) hcp⟩

  haveI := hjc
  haveI : IsOpenImmersion (jc.left ≫ eB.hom) := inferInstance
  have ht : Set.range (jc.left ≫ eB.hom) = {IsLocalRing.closedPoint B}ᶜ := by
    ext z
    simp only [Set.mem_range, Set.mem_compl_iff, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
    constructor
    · rintro ⟨v, rfl⟩ h
      have hv : jc.left v ∈ Set.range jc.left := ⟨v, rfl⟩
      rw [hrc, Set.mem_compl_iff, Set.mem_singleton_iff] at hv
      apply hv
      exact (Scheme.hom_inv_apply eB _).symm.trans (congrArg (fun p => eB.inv p) h)
    · intro hz
      have hmem : eB.inv z ∈ Set.range jc.left := by
        rw [hrc, Set.mem_compl_iff, Set.mem_singleton_iff]
        intro h
        apply hz
        exact (Scheme.inv_hom_apply eB z).symm.trans
          ((congrArg (fun p => eB.hom p) h).trans (Scheme.inv_hom_apply eB _))
      obtain ⟨v, hv⟩ := hmem
      exact ⟨v, by rw [hv, Scheme.inv_hom_apply]⟩
  have hpre' : Set.range (jc.left ≫ eB.hom) = c ⁻¹' (V : Set _) := by
    rw [ht, hV, Set.preimage_compl, hrng]
  obtain ⟨q, hP⟩ : ∃ q : VT.left ⟶ (V : Scheme.{u}), IsPullback q (jc.left ≫ eB.hom) V.ι c := by
    have hU : Set.range (jc.left ≫ eB.hom) = Set.range (c ⁻¹ᵁ V).ι := by
      rw [Scheme.Opens.range_ι, Scheme.Hom.coe_preimage, hpre']
    let e := IsOpenImmersion.isoOfRangeEq (jc.left ≫ eB.hom) (c ⁻¹ᵁ V).ι hU
    have he : e.hom ≫ (c ⁻¹ᵁ V).ι = jc.left ≫ eB.hom :=
      IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hU
    refine ⟨e.hom ≫ (c ∣_ V), ?_⟩
    refine IsPullback.of_iso (isPullback_morphismRestrict c V) e.symm (Iso.refl _) (Iso.refl _)
      (Iso.refl _) ?_ ?_ ?_ ?_
    · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, Iso.inv_hom_id_assoc]
    · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← he, Iso.inv_hom_id_assoc]
    · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
    · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]

  exact wc_smooth_pair_compl_strict_stalk_et_low_vanish (AlgebraicClosure K)
    (Limits.pullback.snd X.hom ι) n 0 i ℓ hℓKbar V hV (CommRingCat.of B) c hc q
    (jc.left ≫ eB.hom) hP jj h1 (by omega)

theorem wc_mtube_punct_germ_low_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (VT : D.Yt.left.ProEt) (jc : VT ⟶ Th) (hjc : IsOpenImmersion jc.left)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (k jj : ℕ) (h1 : 1 ≤ jj) (h2 : jj + 2 ≤ 2 * n) :
    ∀ y : Abelian.Ext (wcFreeSheaf D.Yt.left VT) (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) jj, y = 0 :=
by
  classical
  intro y
  cases k with
  | zero =>
    have hsub : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
    have hzero0 : 𝟙 (wcContSheaf D.Yt.left (ZMod (ℓ ^ 0))) = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      exact Subsingleton.elim _ _
    rw [← Abelian.Ext.comp_mk₀_id y, hzero0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  | succ k' =>
    haveI := D.proper
    haveI := D.smooth
    haveI := hjc
    have hx : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
      rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
    have hg : g.left (eB.inv (IsLocalRing.closedPoint B)) = xb := by
      have hmem : eB.inv (IsLocalRing.closedPoint B) ∈ g.left ⁻¹' {xb} := by
        rw [hpre]; rfl
      exact hmem
    have hpt : Th.hom (eB.inv (IsLocalRing.closedPoint B)) =
        D.xs i (IsLocalRing.closedPoint F'') := by
      have hw : g.left ≫ ((wcProEtPullback D.f).obj V₀).hom = Th.hom :=
        MorphismProperty.Over.w g
      rw [← hw, Scheme.Hom.comp_apply, hg, hxb]
    haveI hNB : TopologicalSpace.NoetherianSpace (Spec (.of B)) :=
      inferInstanceAs (TopologicalSpace.NoetherianSpace (PrimeSpectrum B))
    haveI hNT : TopologicalSpace.NoetherianSpace Th.left :=
      TopologicalSpace.noetherianSpace_of_surjective eB.inv eB.inv.continuous
        (fun t => ⟨eB.hom t, Scheme.hom_inv_apply eB t⟩)
    haveI : CompactSpace VT.left := by
      apply isCompact_univ_iff.mp
      apply (jc.left.isOpenEmbedding.isEmbedding.isCompact_iff).mpr
      rw [Set.image_univ]
      exact TopologicalSpace.NoetherianSpace.isCompact _
    haveI : IsSeparated (Limits.terminal.from VT.left) := by
      rw [show Limits.terminal.from VT.left =
          jc.left ≫ eB.hom ≫ Limits.terminal.from _ from Limits.terminal.hom_ext _ _]
      infer_instance
    have hsub := wc_mtube_ratpt_strict_germ_punct_et_vanish F'' D.Yt n (D.xs i) hx ℓ hℓ Th B eB
      hpt VT jc hjc hrc jj h1 h2
    have hsub' := wc_et_coh_zmod_prime_pow_of_prime VT.left ℓ (Fact.out) jj hsub k'
    obtain ⟨c₁⟩ := wc_contSheaf_discrete_const D.Yt.left (ZMod (ℓ ^ (k' + 1)))
    obtain ⟨c₂⟩ := wc_zmod_sheaf_const D.Yt.left (ℓ ^ (k' + 1))
    let c := c₁ ≪≫ c₂.symm
    have hx' := wc_proet_free_zmod_ext_vanish_of_et_qcsep D.Yt.left VT (ℓ ^ (k' + 1)) jj hsub'
      (y.comp (Abelian.Ext.mk₀ c.hom) (add_zero jj))
    have key : y = (y.comp (Abelian.Ext.mk₀ c.hom) (add_zero jj)).comp
        (Abelian.Ext.mk₀ c.inv) (add_zero jj) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      exact (Abelian.Ext.comp_mk₀_id y).symm
    rw [key, hx', Abelian.Ext.zero_comp]

theorem wc_mtube_open_frob_lifts (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀) (φh : Th ⟶ Th)
    (hφh : φh ≫ g = g ≫ (wcProEtPullback D.f).map φ₀)
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (Tη : D.Yt.left.ProEt) (j : Tη ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')})
    (VT : D.Yt.left.ProEt) (jc : VT ⟶ Th) (hjc : IsOpenImmersion jc.left)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ) :
    ∃ (jη : Tη ⟶ VT) (φV : VT ⟶ VT) (φT : Tη ⟶ Tη),
      IsOpenImmersion jη.left ∧ jη ≫ jc = j ∧ φV ≫ jc = jc ≫ φh ∧ φT ≫ jη = jη ≫ φV ∧
      Set.range jη.left = {z | D.f (VT.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')} :=
by
  classical

  have hlift : ∀ {U V T : D.Yt.left.ProEt} (jc' : V ⟶ T), IsOpenImmersion jc'.left →
      ∀ (a : U ⟶ T), Set.range a.left ⊆ Set.range jc'.left → ∃ l : U ⟶ V, l ≫ jc' = a := by
    intro U V T jc' hjc' a ha
    haveI := hjc'
    have hover : IsOpenImmersion.lift jc'.left a.left ha ≫ V.hom = U.hom := by
      rw [← MorphismProperty.Over.w jc', ← Category.assoc, IsOpenImmersion.lift_fac,
        MorphismProperty.Over.w a]
    refine ⟨MorphismProperty.Over.homMk (IsOpenImmersion.lift jc'.left a.left ha) hover trivial,
      ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact IsOpenImmersion.lift_fac _ _ _

  have hov : ∀ {U V : D.Yt.left.ProEt} (a : U ⟶ V) (x : U.left), V.hom (a.left x) = U.hom x := by
    intro U V a x
    rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]

  have huniq : ∀ w w' : ((wcProEtPullback D.f).obj V₀).left,
      ((wcProEtPullback D.f).obj V₀).hom w = D.xs i (IsLocalRing.closedPoint F'') →
      ((wcProEtPullback D.f).obj V₀).hom w' = D.xs i (IsLocalRing.closedPoint F'') → w = w' := by
    intro w w' hw hw'
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w (IsLocalRing.closedPoint F'') hw
    obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w' (IsLocalRing.closedPoint F'') hw'
    let e := Limits.pullbackLeftPullbackSndIso V₀.hom D.f (D.xs i) ≪≫
      Limits.pullback.congrHom rfl (D.hxs i) ≪≫ ε
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure F''))
      infer_instance
    have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
    rw [← hz1, ← hz1', hzz]
  set c := eB.inv (IsLocalRing.closedPoint B) with hc
  have hgc : g.left c = xb := by
    have : c ∈ g.left ⁻¹' {xb} := by rw [hpre]; rfl
    exact this
  have hThc : Th.hom c = D.xs i (IsLocalRing.closedPoint F'') := by
    rw [← hov g c, hgc, hxb]
  have hfy : D.f (D.xs i (IsLocalRing.closedPoint F'')) = D.S i (IsLocalRing.closedPoint F'') := by
    rw [← D.hxs i]
    first
      | rfl
      | exact (Scheme.Hom.comp_apply (D.xs i) D.f _).symm
  have hkey : ∀ z : Th.left, Th.hom z = D.xs i (IsLocalRing.closedPoint F'') → z = c := by
    intro z hz
    have h1 : g.left z = xb := huniq _ _ (by rw [hov g z, hz]) hxb
    have : z ∈ g.left ⁻¹' {xb} := h1
    rw [hpre] at this
    exact this
  haveI := hjc
  haveI := hj

  have hsub1 : Set.range j.left ⊆ Set.range jc.left := by
    rintro x ⟨t, rfl⟩
    rw [hrc]
    intro hx
    have h2 : j.left t ∈ Set.range j.left := ⟨t, rfl⟩
    rw [hrange] at h2
    exact h2 (by rw [Set.mem_singleton_iff.mp hx, hThc, hfy])
  obtain ⟨jη, hfac⟩ := hlift jc hjc j hsub1
  have hfacL : jη.left ≫ jc.left = j.left := by
    exact congrArg (fun k => k.left) hfac
  have hjη : IsOpenImmersion jη.left := by
    haveI : IsOpenImmersion (jη.left ≫ jc.left) := by rw [hfacL]; exact hj
    exact IsOpenImmersion.of_comp jη.left jc.left
  have hrη : Set.range jη.left = {z | D.f (VT.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')} := by
    ext z
    constructor
    · rintro ⟨t, rfl⟩
      show D.f (VT.hom (jη.left t)) ≠ _
      rw [← hov jc (jη.left t)]
      have h2 : j.left t ∈ Set.range j.left := ⟨t, rfl⟩
      rw [hrange, ← hfacL, Scheme.Hom.comp_apply] at h2
      exact h2
    · intro hz
      have h2 : jc.left z ∈ Set.range j.left := by
        rw [hrange]
        show D.f (Th.hom (jc.left z)) ≠ _
        rw [hov jc z]; exact hz
      obtain ⟨t, ht⟩ := h2
      refine ⟨t, jc.left.isOpenEmbedding.injective ?_⟩
      show (jη.left ≫ jc.left) t = jc.left z
      rw [hfacL, ht]

  have hsub2 : Set.range (jc ≫ φh).left ⊆ Set.range jc.left := by
    rintro x ⟨z, rfl⟩
    rw [hrc]
    intro hx
    change φh.left (jc.left z) ∈ ({c} : Set Th.left) at hx
    have h3 : Th.hom (jc.left z) = D.xs i (IsLocalRing.closedPoint F'') := by
      rw [← hov φh (jc.left z), Set.mem_singleton_iff.mp hx, hThc]
    have h4 : jc.left z ∈ Set.range jc.left := ⟨z, rfl⟩
    rw [hrc] at h4
    exact h4 (hkey _ h3)
  obtain ⟨φV, hφV⟩ := hlift jc hjc (jc ≫ φh) hsub2

  have hsub3 : Set.range (jη ≫ φV).left ⊆ Set.range jη.left := by
    rintro x ⟨t, rfl⟩
    rw [hrη]
    change D.f (VT.hom (φV.left (jη.left t))) ≠ _
    rw [hov φV]
    have h5 : jη.left t ∈ Set.range jη.left := ⟨t, rfl⟩
    rw [hrη] at h5
    exact h5
  obtain ⟨φT, hφT⟩ := hlift jη hjη (jη ≫ φV) hsub3
  exact ⟨jη, φV, φT, hjη, hfac, hφV, hφT, hrη⟩

theorem wc_mtube_coker_restr_bij (S : Scheme.{u}) (Th VT Tη : S.ProEt) (j : Tη ⟶ Th)
    (jc : VT ⟶ Th) (jη : Tη ⟶ VT) (hfac : jη ≫ jc = j)
    (hj : Mono j.left) (hjη : Mono jη.left) (hproj : Projective (wcFreeSheaf S Th))
    (φh : Th ⟶ Th) (φV : VT ⟶ VT) (φT : Tη ⟶ Tη)
    (hφV : φV ≫ jc = jc ≫ φh) (hφT : φT ≫ jη = jη ≫ φV)
    (Φ : Limits.cokernel (wcFreeSheafMap S j) ⟶ Limits.cokernel (wcFreeSheafMap S j))
    (hΦ : Limits.cokernel.π (wcFreeSheafMap S j) ≫ Φ =
      wcFreeSheafMap S φh ≫ Limits.cokernel.π (wcFreeSheafMap S j))
    (Φη : Limits.cokernel (wcFreeSheafMap S jη) ⟶ Limits.cokernel (wcFreeSheafMap S jη))
    (hΦη : Limits.cokernel.π (wcFreeSheafMap S jη) ≫ Φη =
      wcFreeSheafMap S φV ≫ Limits.cokernel.π (wcFreeSheafMap S jη))
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (m : ℕ) (hm : 2 ≤ m)
    (hv1 : ∀ y : Abelian.Ext (wcFreeSheaf S VT) G (m - 1), y = 0)
    (hv2 : ∀ y : Abelian.Ext (wcFreeSheaf S VT) G m, y = 0) :
    ∃ ρ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S j)) G m →+
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap S jη)) G m,
      Function.Bijective ρ ∧
      ∀ z, ρ ((Abelian.Ext.mk₀ Φ).comp z (zero_add m)) = (Abelian.Ext.mk₀ Φη).comp (ρ z) (zero_add m) :=
by
  classical
  have hfun : ∀ {A₁ B₁ C₁ : S.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro A₁ B₁ C₁ a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have wc_free_sheaf_map_mono : ∀ (S : Scheme.{u}) (V U : S.ProEt) (ι : V ⟶ U)
      (hι : Mono ι.left), Mono (wcFreeSheafMap S ι) := by
    intro S V U ι hι
    haveI : Mono ι := ⟨fun g h e => MorphismProperty.Over.Hom.ext ((cancel_mono ι.left).mp
      (by
        have e' := congrArg (fun t => t.left) e
        first
          | exact e'
          | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e'))⟩
    unfold wcFreeSheafMap
    exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (Functor.whiskerRight (yoneda.map ι) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have hm' : 1 + (m - 1) = m := by omega

  have gen : ∀ (T : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}))
      (hT : T.ShortExact),
      (∀ y : Abelian.Ext T.X₂ G (m - 1), y = 0) → (∀ y : Abelian.Ext T.X₂ G m, y = 0) →
      Function.Bijective (hT.extClass.precomp G hm') := by
    intro T hT h1 h2
    constructor
    · rw [injective_iff_map_eq_zero]
      intro y hy
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hT G y hm' hy
      rw [← hx₂, h1 x₂, Abelian.Ext.comp_zero]
    · intro x₃
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hT G x₃ (h2 _) hm'
      exact ⟨x₁, hx₁⟩

  have hS₁ : (ShortComplex.mk (wcFreeSheafMap S j) (Limits.cokernel.π (wcFreeSheafMap S j))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
      (wc_free_sheaf_map_mono S Tη Th j hj)
      (show Epi (Limits.cokernel.π (wcFreeSheafMap S j)) from inferInstance)
  have hS₂ : (ShortComplex.mk (wcFreeSheafMap S jη) (Limits.cokernel.π (wcFreeSheafMap S jη))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
      (wc_free_sheaf_map_mono S Tη VT jη hjη)
      (show Epi (Limits.cokernel.π (wcFreeSheafMap S jη)) from inferInstance)
  haveI := hproj
  have hvan : ∀ (p : ℕ), 1 ≤ p → ∀ x : Abelian.Ext (wcFreeSheaf S Th) G p, x = 0 := by
    intro p hp x
    obtain ⟨r, rfl⟩ : ∃ r, p = r + 1 := ⟨p - 1, by omega⟩
    exact Abelian.Ext.eq_zero_of_projective x
  have hb₁ := gen _ hS₁ (hvan (m - 1) (by omega)) (hvan m (by omega))
  have hb₂ := gen _ hS₂ hv1 hv2

  have hcomm : φT ≫ j = j ≫ φh := by
    rw [← hfac, ← Category.assoc, hφT, Category.assoc, hφV, ← Category.assoc]
  let τ₁ : ShortComplex.mk (wcFreeSheafMap S j) (Limits.cokernel.π (wcFreeSheafMap S j))
      (Limits.cokernel.condition _) ⟶
      ShortComplex.mk (wcFreeSheafMap S j) (Limits.cokernel.π (wcFreeSheafMap S j))
      (Limits.cokernel.condition _) :=
    { τ₁ := wcFreeSheafMap S φT
      τ₂ := wcFreeSheafMap S φh
      τ₃ := Φ
      comm₁₂ := by
        show wcFreeSheafMap S φT ≫ wcFreeSheafMap S j = wcFreeSheafMap S j ≫ wcFreeSheafMap S φh
        rw [← hfun, ← hfun, hcomm]
      comm₂₃ := hΦ.symm }
  let τ₂ : ShortComplex.mk (wcFreeSheafMap S jη) (Limits.cokernel.π (wcFreeSheafMap S jη))
      (Limits.cokernel.condition _) ⟶
      ShortComplex.mk (wcFreeSheafMap S jη) (Limits.cokernel.π (wcFreeSheafMap S jη))
      (Limits.cokernel.condition _) :=
    { τ₁ := wcFreeSheafMap S φT
      τ₂ := wcFreeSheafMap S φV
      τ₃ := Φη
      comm₁₂ := by
        show wcFreeSheafMap S φT ≫ wcFreeSheafMap S jη = wcFreeSheafMap S jη ≫ wcFreeSheafMap S φV
        rw [← hfun, ← hfun, hφT]
      comm₂₃ := hΦη.symm }
  have hnat₁ : hS₁.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap S φT)) (add_zero 1) =
      (Abelian.Ext.mk₀ Φ).comp hS₁.extClass (zero_add 1) :=
    hS₁.extClass_naturality hS₁ τ₁
  have hnat₂ : hS₂.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap S φT)) (add_zero 1) =
      (Abelian.Ext.mk₀ Φη).comp hS₂.extClass (zero_add 1) :=
    hS₂.extClass_naturality hS₂ τ₂
  have heq₁ : ∀ y : Abelian.Ext (wcFreeSheaf S Tη) G (m - 1),
      hS₁.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S φT)).comp y (zero_add (m - 1))) hm' =
        (Abelian.Ext.mk₀ Φ).comp (hS₁.extClass.comp y hm') (zero_add m) := by
    intro y
    rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add (m - 1)) (by omega), hnat₁,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 1) hm' (by omega)]
  have heq₂ : ∀ y : Abelian.Ext (wcFreeSheaf S Tη) G (m - 1),
      hS₂.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S φT)).comp y (zero_add (m - 1))) hm' =
        (Abelian.Ext.mk₀ Φη).comp (hS₂.extClass.comp y hm') (zero_add m) := by
    intro y
    rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add (m - 1)) (by omega), hnat₂,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 1) hm' (by omega)]

  let δ₁ := hS₁.extClass.precomp G hm'
  let δ₂ := hS₂.extClass.precomp G hm'
  let e₁ := AddEquiv.ofBijective δ₁ hb₁
  refine ⟨δ₂.comp (e₁.symm : _ →+ _), hb₂.comp e₁.symm.bijective, fun z => ?_⟩
  obtain ⟨y, rfl⟩ := hb₁.2 z
  have k1 : e₁.symm (δ₁ y) = y := e₁.symm_apply_apply y
  have k2 : e₁.symm ((Abelian.Ext.mk₀ Φ).comp (δ₁ y) (zero_add m)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap S φT)).comp y (zero_add (m - 1)) := by
    have h3 : (Abelian.Ext.mk₀ Φ).comp (δ₁ y) (zero_add m) =
        e₁ ((Abelian.Ext.mk₀ (wcFreeSheafMap S φT)).comp y (zero_add (m - 1))) := (heq₁ y).symm
    rw [h3]
    exact e₁.symm_apply_apply _
  show δ₂ (e₁.symm ((Abelian.Ext.mk₀ Φ).comp (δ₁ y) (zero_add m))) =
    (Abelian.Ext.mk₀ Φη).comp (δ₂ (e₁.symm (δ₁ y))) (zero_add m)
  rw [k2, k1]
  exact heq₂ y

theorem wc_bm_punct_fibre_smooth (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) :
    SmoothOfRelativeDimension (n - 1) ((wcCritPunctOpen D i).ι ≫ Limits.pullback.snd D.f (D.S i)) :=
by
  classical
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance
  have hxsCI : IsClosedImmersion (D.xs i) := by
    apply isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hclos : closure ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) =
      {D.xs i (IsLocalRing.closedPoint F'')} := by
    have hrange : Set.range ⇑(D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        exact Set.mem_singleton _
      · intro hy
        rw [Set.mem_singleton_iff] at hy
        exact ⟨_, hy.symm⟩
    have hc : IsClosed (Set.range ⇑(D.xs i)) := by
      haveI := hxsCI
      first
        | exact (D.xs i).isClosedEmbedding.isClosed_range
        | exact (IsClosedImmersion.isClosedEmbedding (D.xs i)).isClosed_range
        | exact IsClosedImmersion.base_closed.isClosed_range
    rw [hrange] at hc
    exact hc.closure_eq
  have hmemO : ∀ y, y ∈ (wcCritPunctOpen D i : (Limits.pullback D.f (D.S i)).Opens) ↔
      ¬ Limits.pullback.fst D.f (D.S i) y = D.xs i (IsLocalRing.closedPoint F'') := by
    intro y
    have h1 : (¬ Limits.pullback.fst D.f (D.S i) y = D.xs i (IsLocalRing.closedPoint F'')) ↔
        Limits.pullback.fst D.f (D.S i) y ∈
          (closure ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left))ᶜ := by
      rw [hclos]; simp
    rw [h1]
    all_goals first
      | exact Iff.rfl
      | simp [wcCritPunctOpen, Scheme.Hom.mem_preimage]
  haveI hZLn : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) := by
    first
      | infer_instance
      | exact HasRingHomProperty.instIsZariskiLocalAtSource (P := @SmoothOfRelativeDimension n)
  haveI hZLn1 : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (n - 1)) := by
    first
      | infer_instance
      | exact HasRingHomProperty.instIsZariskiLocalAtSource
          (P := @SmoothOfRelativeDimension (n - 1))
  haveI hP1 := wc_p1_smooth_reldim_one F''
  have s2 : ∀ (V' : D.Yt.left.Opens), Smooth (V'.ι ≫ D.f) →
      SmoothOfRelativeDimension (n - 1)
        ((Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ V').ι ≫ Limits.pullback.snd D.f (D.S i)) := by
    intro V' hV'
    haveI := hV'
    haveI h1 : SmoothOfRelativeDimension n ((V'.ι ≫ D.f) ≫ (wcP1Over F'').hom) := by
      rw [Category.assoc, D.hf]
      exact IsZariskiLocalAtSource.comp (P := @SmoothOfRelativeDimension n) D.smooth V'.ι
    have h2 := wc_smooth_reldim_of_comp_reldim (V'.ι ≫ D.f) (wcP1Over F'').hom n 1
    have hsq := IsPullback.paste_vert
      (isPullback_morphismRestrict (Limits.pullback.fst D.f (D.S i)) V')
      (IsPullback.of_hasPullback D.f (D.S i))
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq h2
  have havoid : ∀ (z : (wcCritPunctOpen D i : Scheme.{u})) (k : Fin D.m),
      Limits.pullback.fst D.f (D.S i) ((wcCritPunctOpen D i).ι z) ≠
        D.xs k (IsLocalRing.closedPoint F'') := by
    intro z k hk
    have hz : (wcCritPunctOpen D i).ι z ∈ (wcCritPunctOpen D i) := by
      have : (wcCritPunctOpen D i).ι z ∈ Set.range (wcCritPunctOpen D i).ι := ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι] at this
      exact this
    generalize (wcCritPunctOpen D i).ι z = x at hk hz
    have h1 : D.f (Limits.pullback.fst D.f (D.S i) x) =
        D.S i (Limits.pullback.snd D.f (D.S i) x) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    have h2 : D.f (D.xs k (IsLocalRing.closedPoint F'')) =
        D.S k (IsLocalRing.closedPoint F'') := by
      have e0 : (D.xs k ≫ D.f) (IsLocalRing.closedPoint F'') =
          D.S k (IsLocalRing.closedPoint F'') := by rw [D.hxs k]
      refine Eq.trans ?_ e0
      first
        | exact (Scheme.Hom.comp_apply _ _ _).symm
        | rfl
        | simp [Scheme.Hom.comp_apply]
    have h3 : D.S k (IsLocalRing.closedPoint F'') = D.S i (IsLocalRing.closedPoint F'') := by
      rw [← h2, ← hk, h1, Subsingleton.elim (Limits.pullback.snd D.f (D.S i) x)
        (IsLocalRing.closedPoint F'')]
    have hki : k = i := D.hSinj h3
    rw [hki] at hk
    exact (hmemO x).mp hz hk
  choose V hyV hV using fun z => D.smooth_off _ (havoid z)
  have hcov : ⨆ z, (wcCritPunctOpen D i).ι ⁻¹ᵁ
      (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ V z) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨z, hyV z⟩
  refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @SmoothOfRelativeDimension (n - 1)) _
    hcov (fun z => ?_)
  rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
  exact IsZariskiLocalAtSource.comp (s2 _ (hV z)) _

theorem wc_skc_frob_residue (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left)
    (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [IsLocalRing A]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom u0)
    (ρ : A →+* A) (hρ : e.inv ≫ φ₀.left ≫ e.hom = Spec.map (CommRingCat.ofHom ρ))
    (hfib : ∀ v : V₀.left, V₀.hom v = u0 (IsLocalRing.closedPoint F'') →
      v = e.inv (IsLocalRing.closedPoint A)) :
    ∃ r : A →+* AlgebraicClosure F'', RingHom.ker r = IsLocalRing.maximalIdeal A ∧
      ∀ a : A, r (ρ a) ^ Nat.card F'' = r a :=
by
  classical

  obtain ⟨r, hr⟩ : ∃ r : A →+* AlgebraicClosure F'', Spec.map (CommRingCat.ofHom r) =
      ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ e.hom :=
    ⟨(Spec.preimage (R := CommRingCat.of A) (S := CommRingCat.of (AlgebraicClosure F''))
      (ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ e.hom)).hom, by
        rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage _⟩

  have hρ' : φ₀.left ≫ e.hom = e.hom ≫ Spec.map (CommRingCat.ofHom ρ) := by
    rw [← hρ]; simp

  have hPρ : Spec.map (CommRingCat.ofHom r) ≫ Spec.map (CommRingCat.ofHom ρ) =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫ Spec.map (CommRingCat.ofHom r) := by
    have h1 := eq_whisker hεφ e.hom
    simp only [Category.assoc] at h1
    rw [hr]
    simp only [Category.assoc]
    rw [← hρ']
    exact h1

  have hrρ : ∀ a : A, r (ρ a) = ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'') (r a) := by
    rw [← Spec.map_comp, ← Spec.map_comp] at hPρ
    have h3 := Spec.map_injective hPρ
    have h4 := congrArg CommRingCat.Hom.hom h3
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom,
      CommRingCat.hom_ofHom] at h4
    intro a
    exact RingHom.congr_fun h4 a

  have hfrob : ∀ y : AlgebraicClosure F'', (((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'') y) ^ Nat.card F'' = y := by
    intro y
    letI := Fintype.ofFinite F''
    rw [Nat.card_eq_fintype_card]
    have h1 := FiniteField.frobeniusAlgEquivOfAlgebraic_apply F'' (AlgebraicClosure F'')
      ((FiniteField.frobeniusAlgEquivOfAlgebraic F'' (AlgebraicClosure F'')).symm y)
    rw [AlgEquiv.apply_symm_apply] at h1
    exact h1.symm

  have hpt : ∀ (k : Type u) [Field k] (x y : PrimeSpectrum k), x = y := by
    intro k _ x y
    apply PrimeSpectrum.ext
    rw [Ideal.eq_bot_of_prime x.asIdeal, Ideal.eq_bot_of_prime y.asIdeal]
  let pt : Spec (.of (AlgebraicClosure F'')) := IsLocalRing.closedPoint (AlgebraicClosure F'')
  have hcond : V₀.hom (Limits.pullback.fst V₀.hom u0 (ε.inv pt)) =
      u0 (IsLocalRing.closedPoint F'') := by
    have h1 : V₀.hom (Limits.pullback.fst V₀.hom u0 (ε.inv pt)) =
        (Limits.pullback.fst V₀.hom u0 ≫ V₀.hom) (ε.inv pt) := rfl
    rw [h1, Limits.pullback.condition]
    have h2 : (Limits.pullback.snd V₀.hom u0 ≫ u0) (ε.inv pt) =
        u0 (Limits.pullback.snd V₀.hom u0 (ε.inv pt)) := rfl
    rw [h2]
    congr 1
    exact hpt F'' _ _
  have hv := hfib _ hcond
  have hPpt : (ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ e.hom) pt = IsLocalRing.closedPoint A := by
    have h1 : (ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ e.hom) pt =
        e.hom (Limits.pullback.fst V₀.hom u0 (ε.inv pt)) := rfl
    rw [h1, hv]
    have h2 : e.hom (e.inv (IsLocalRing.closedPoint A)) =
        (e.inv ≫ e.hom) (IsLocalRing.closedPoint A) := rfl
    rw [h2, Iso.inv_hom_id]
    all_goals first
      | rfl
      | exact Scheme.id_apply _ _
      | (simp; done)
  have hker : RingHom.ker r = IsLocalRing.maximalIdeal A := by
    have h1 : (Spec.map (CommRingCat.ofHom r)) pt = IsLocalRing.closedPoint A := by
      rw [hr]; exact hPpt
    have h2 := congrArg PrimeSpectrum.asIdeal h1
    have hb : ∀ x : PrimeSpectrum (AlgebraicClosure F''),
        Ideal.comap r x.asIdeal = Ideal.comap r ⊥ := fun x => by
      rw [Ideal.eq_bot_of_prime x.asIdeal]
    have h4 : ((Spec.map (CommRingCat.ofHom r)) pt).asIdeal = Ideal.comap r ⊥ := hb pt
    rw [h4] at h2
    rw [RingHom.ker_eq_comap_bot]
    exact h2
  refine ⟨r, hker, fun a => ?_⟩
  rw [hrρ a]
  exact hfrob (r a)

theorem wc_frobNbhd_geom_lift (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (x : (wcP1Over K).left) (N : wcFrobNbhd K x 1) :
    ∃ g : N.V ⟶ wcGeomPoint K (wcP1Over K) hP, N.φ ≫ g = g ≫ wcGeomFrob K (wcP1Over K) hP :=
by
  classical
  have s1 : ∀ (A : Type u) [CommRing A] [Nontrivial A] (c : K →+* A) (n : ℕ),
      (∀ x y : A, (x + y) ^ (Nat.card K ^ n) = x ^ (Nat.card K ^ n) + y ^ (Nat.card K ^ n)) ∧
      (∀ x y : A, (x - y) ^ (Nat.card K ^ n) = x ^ (Nat.card K ^ n) - y ^ (Nat.card K ^ n)) ∧
      (1 ≤ n → ((Nat.card K ^ n : ℕ) : A) = 0) ∧
      (1 ≤ n → 2 ≤ Nat.card K ^ n) := by
    intro A _ _ c n
    set p := ringChar K with hp
    haveI : Fact p.Prime := ⟨CharP.char_is_prime K p⟩
    haveI : CharP A p := charP_of_injective_ringHom c.injective p
    letI := Fintype.ofFinite K
    obtain ⟨r, hr, hcard⟩ := FiniteField.card K p
    have hq : Nat.card K ^ n = p ^ ((r : ℕ) * n) := by
      rw [Nat.card_eq_fintype_card, hcard, pow_mul]
    refine ⟨fun x y => ?_, fun x y => ?_, fun hn => ?_, fun hn => ?_⟩
    · rw [hq]; exact add_pow_char_pow x y p _
    · rw [hq]; exact sub_pow_char_pow x y _
    · rw [hq, Nat.cast_pow, CharP.cast_eq_zero A p, zero_pow]
      have : 0 < (r : ℕ) := r.pos
      positivity
    · rw [hq]
      have h2 : 2 ≤ p := (Fact.out : p.Prime).two_le
      have : 1 ≤ (r : ℕ) * n := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero r.ne_zero (by omega))
      calc 2 ≤ p := h2
        _ = p ^ 1 := (pow_one p).symm
        _ ≤ p ^ ((r : ℕ) * n) := Nat.pow_le_pow_right (by omega) this
  have s2 : ∀ z : AlgebraicClosure K, ∃ n : ℕ, 1 ≤ n ∧ z ^ (Nat.card K ^ n) = z := by
    intro z
    have hint : IsIntegral K z := Algebra.IsIntegral.isIntegral z
    haveI : FiniteDimensional K (IntermediateField.adjoin K {z}) :=
      IntermediateField.adjoin.finiteDimensional hint
    refine ⟨Module.finrank K (IntermediateField.adjoin K {z}), Module.finrank_pos, ?_⟩
    haveI : Finite (IntermediateField.adjoin K {z}) := Module.finite_of_finite K
    letI := Fintype.ofFinite (IntermediateField.adjoin K {z})
    have hc : Nat.card (IntermediateField.adjoin K {z}) =
        Nat.card K ^ Module.finrank K (IntermediateField.adjoin K {z}) :=
      Module.natCard_eq_pow_finrank
    have h := FiniteField.pow_card (IntermediateField.AdjoinSimple.gen K z)
    rw [← Nat.card_eq_fintype_card, hc] at h
    have h2 := congrArg (fun w : IntermediateField.adjoin K {z} => (w : AlgebraicClosure K)) h
    simp only [IntermediateField.coe_pow, IntermediateField.AdjoinSimple.coe_gen] at h2
    exact h2
  have s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (c : K →+* A) (n : ℕ) (hn : 1 ≤ n)
      (a b : A) (ha : a ^ (Nat.card K ^ n) = a) (hb : b ^ (Nat.card K ^ n) = b)
      (hab : a - b ∈ IsLocalRing.maximalIdeal A), a = b := by
    intro A _ _ c n hn a b ha hb hab
    obtain ⟨_, hsub, _, h2⟩ := s1 A c n
    have hQ := h2 hn
    set Q := Nat.card K ^ n with hQdef
    set d := a - b with hd
    have hdQ : d ^ Q = d := by rw [hd, hsub, ha, hb]
    have hQ1 : Q = (Q - 1) + 1 := by omega
    have hmul : d * (1 - d ^ (Q - 1)) = 0 := by
      have : d * d ^ (Q - 1) = d := by
        rw [← pow_succ', ← hQ1, hdQ]
      rw [mul_sub, mul_one, this, sub_self]
    have hmem : d ^ (Q - 1) ∈ IsLocalRing.maximalIdeal A :=
      Ideal.pow_mem_of_mem _ hab _ (by omega)
    have hunit : IsUnit (1 - d ^ (Q - 1)) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hmem
    have : d = 0 := by
      obtain ⟨u, hu⟩ := hunit
      have := congrArg (· * (↑u⁻¹ : A)) hmul
      simp only [← hu, mul_assoc, Units.mul_inv, mul_one, zero_mul] at this
      exact this
    exact sub_eq_zero.mp this
  have s4 : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (c : K →+* A) (n : ℕ)
      (hn : 1 ≤ n) (y : IsLocalRing.ResidueField A) (hy : y ^ (Nat.card K ^ n) = y),
      ∃ a : A, a ^ (Nat.card K ^ n) = a ∧ IsLocalRing.residue A a = y := by
    intro A _ _ c n hn y hy
    obtain ⟨_, _, h0, h2⟩ := s1 A c n
    have hQ := h2 hn
    have hQ0 := h0 hn
    set Q := Nat.card K ^ n with hQdef
    set f : Polynomial A := Polynomial.X ^ Q - Polynomial.X with hf
    have hmon : f.Monic := Polynomial.monic_X_pow_sub
      (by rw [Polynomial.degree_X]; exact_mod_cast (by omega : 1 < Q))
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective y
    have h1 : Polynomial.eval a₀ f ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp [hf, ha₀, hy]
    have h2' : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f)) := by
      simp only [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
        Polynomial.derivative_X, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_one, Polynomial.eval_pow, Polynomial.eval_X]
      rw [hQ0, zero_mul, zero_sub]
      exact isUnit_neg_one
    obtain ⟨a, ha, hsub⟩ := HenselianLocalRing.is_henselian f hmon a₀ h1 h2'
    refine ⟨a, ?_, ?_⟩
    · have := ha
      rw [Polynomial.IsRoot.def] at this
      simpa [hf, sub_eq_zero] using this
    · rw [← ha₀]
      have := (IsLocalRing.residue_eq_zero_iff _).mpr hsub
      rw [map_sub, sub_eq_zero] at this
      exact this

  have s5 : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (c : K →+* A),
      ∃ ι : AlgebraicClosure K →+* A, ι.comp (algebraMap K (AlgebraicClosure K)) = c := by
    intro A _ _ _ c
    have hiter : ∀ (a : A) (n : ℕ), a ^ (Nat.card K ^ n) = a → ∀ j : ℕ,
        a ^ (Nat.card K ^ (n * j)) = a := by
      intro a n ha j
      induction j with
      | zero => simp
      | succ j ih =>
        rw [Nat.mul_succ, pow_add, pow_mul, ih, ha]
    have hcommon : ∀ (a b : A) (n m : ℕ), a ^ (Nat.card K ^ n) = a →
        b ^ (Nat.card K ^ m) = b →
        a ^ (Nat.card K ^ (n * m)) = a ∧ b ^ (Nat.card K ^ (n * m)) = b := by
      intro a b n m ha hb
      refine ⟨hiter a n ha m, ?_⟩
      rw [Nat.mul_comm]; exact hiter b m hb n
    have hq1 : 2 ≤ Nat.card K ^ 1 := (s1 A c 1).2.2.2 le_rfl
    let T : Subring A :=
      { carrier := {a | ∃ n : ℕ, 1 ≤ n ∧ a ^ (Nat.card K ^ n) = a}
        zero_mem' := ⟨1, le_rfl, zero_pow (by omega)⟩
        one_mem' := ⟨1, le_rfl, one_pow _⟩
        add_mem' := by
          rintro a b ⟨n, hn, ha⟩ ⟨m, hm, hb⟩
          obtain ⟨ha', hb'⟩ := hcommon a b n m ha hb
          refine ⟨n * m, Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega)), ?_⟩
          rw [(s1 A c (n * m)).1, ha', hb']
        mul_mem' := by
          rintro a b ⟨n, hn, ha⟩ ⟨m, hm, hb⟩
          obtain ⟨ha', hb'⟩ := hcommon a b n m ha hb
          refine ⟨n * m, Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega)), ?_⟩
          rw [mul_pow, ha', hb']
        neg_mem' := by
          rintro a ⟨n, hn, ha⟩
          refine ⟨n, hn, ?_⟩
          have h2 := (s1 A c n).2.2.2 hn
          have := (s1 A c n).2.1 0 a
          rw [zero_sub, zero_pow (by omega), zero_sub, ha] at this
          exact this }
    have hTinj : ∀ a b : A, a ∈ T → b ∈ T →
        IsLocalRing.residue A a = IsLocalRing.residue A b → a = b := by
      rintro a b ⟨n, hn, ha⟩ ⟨m, hm, hb⟩ hab
      obtain ⟨ha', hb'⟩ := hcommon a b n m ha hb
      refine s3 A c (n * m) (Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega)))
        a b ha' hb' ?_
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hab, sub_self]
    letI : Algebra K (IsLocalRing.ResidueField A) := ((IsLocalRing.residue A).comp c).toAlgebra
    let τ : AlgebraicClosure K →ₐ[K] IsLocalRing.ResidueField A :=
      IsSepClosed.lift (K := K) (L := AlgebraicClosure K) (M := IsLocalRing.ResidueField A)
    let ρ : T →+* IsLocalRing.ResidueField A := (IsLocalRing.residue A).comp T.subtype
    have hρinj : Function.Injective ρ := by
      intro a b hab
      exact Subtype.ext (hTinj a.1 b.1 a.2 b.2 hab)
    have hrange : ∀ z : AlgebraicClosure K, (τ : AlgebraicClosure K →+* _) z ∈ ρ.range := by
      intro z
      obtain ⟨n, hn, hz⟩ := s2 z
      have hy : (τ z) ^ (Nat.card K ^ n) = τ z := by rw [← map_pow, hz]
      obtain ⟨a, ha, hres⟩ := s4 A c n hn (τ z) hy
      exact ⟨⟨a, n, hn, ha⟩, hres⟩
    let eT : T ≃+* ρ.range := RingEquiv.ofBijective ρ.rangeRestrict
      ⟨fun a b hab => hρinj (congrArg Subtype.val hab), ρ.rangeRestrict_surjective⟩
    let τ' : AlgebraicClosure K →+* ρ.range :=
      (τ : AlgebraicClosure K →+* IsLocalRing.ResidueField A).codRestrict ρ.range hrange
    let ι : AlgebraicClosure K →+* A := T.subtype.comp (eT.symm.toRingHom.comp τ')
    have hιT : ∀ z, ι z ∈ T := fun z => (eT.symm (τ' z)).2
    have hιres : ∀ z, IsLocalRing.residue A (ι z) = τ z := by
      intro z
      have h1 : eT (eT.symm (τ' z)) = τ' z := eT.apply_symm_apply _
      have h2 := congrArg Subtype.val h1
      exact h2
    refine ⟨ι, ?_⟩
    ext k
    simp only [RingHom.comp_apply]
    apply hTinj _ _ (hιT _)
    · refine ⟨1, le_rfl, ?_⟩
      letI := Fintype.ofFinite K
      rw [pow_one, ← map_pow, Nat.card_eq_fintype_card, FiniteField.pow_card]
    · rw [hιres]
      exact τ.commutes k
  have s6 : ∀ (A : Type u) [CommRing A] [IsLocalRing A]
      (ι : AlgebraicClosure K →+* A) (ψ : A →+* A),
      (∀ a : A, ψ a ^ (Nat.card K ^ 1) - a ∈ IsLocalRing.maximalIdeal A) →
      ψ.comp ι = ι.comp ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _).symm : AlgebraicClosure K →+* AlgebraicClosure K) := by
    intro A _ _ ι ψ hfrob
    letI := Fintype.ofFinite K
    set c := ι.comp (algebraMap K (AlgebraicClosure K)) with hc
    ext z
    simp only [RingHom.comp_apply, RingHom.coe_coe]
    set w := (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)).symm z with hw
    have hwq : w ^ (Nat.card K ^ 1) = z := by
      rw [pow_one, Nat.card_eq_fintype_card, ← FiniteField.frobeniusAlgEquivOfAlgebraic_apply, hw,
        AlgEquiv.apply_symm_apply]
    obtain ⟨n, hn, hz⟩ := s2 z
    have hwn : w ^ (Nat.card K ^ n) = w := by
      rw [hw, ← map_pow, hz]
    have hα : (ψ (ι z)) ^ (Nat.card K ^ n) = ψ (ι z) := by rw [← map_pow, ← map_pow, hz]
    have hβ : (ι w) ^ (Nat.card K ^ n) = ι w := by rw [← map_pow, hwn]
    apply s3 A c n hn _ _ hα hβ
    have h1 := hfrob (ι z)
    have hβq : (ι w) ^ (Nat.card K ^ 1) = ι z := by rw [← map_pow, hwq]
    have h2 : (ψ (ι z) - ι w) ^ (Nat.card K ^ 1) ∈ IsLocalRing.maximalIdeal A := by
      rw [(s1 A c 1).2.1, hβq]; exact h1
    exact (IsLocalRing.maximalIdeal.isMaximal A).isPrime.mem_of_pow_mem _ h2

  letI := N.ringA
  letI := N.hensA
  letI := N.sepA
  obtain ⟨c, hc⟩ : ∃ c : K →+* N.A,
      Spec.map (CommRingCat.ofHom c) = N.e.inv ≫ N.V.hom ≫ (wcP1Over K).hom :=
    ⟨(Spec.preimage (R := CommRingCat.of K) (S := CommRingCat.of N.A)
        (N.e.inv ≫ N.V.hom ≫ (wcP1Over K).hom)).hom, by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  obtain ⟨ι, hι⟩ := s5 N.A c
  have hrig := s6 N.A ι N.ψ N.hfrob
  have hk : N.V.hom ≫ (wcP1Over K).hom = (N.e.hom ≫ Spec.map (CommRingCat.ofHom ι)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hι, hc, Iso.hom_inv_id_assoc]
  obtain ⟨gl, hgl1, hgl2⟩ : ∃ gl : N.V.left ⟶ Limits.pullback (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))),
      gl ≫ Limits.pullback.fst _ _ = N.V.hom ∧
      gl ≫ Limits.pullback.snd _ _ = N.e.hom ≫ Spec.map (CommRingCat.ofHom ι) :=
    ⟨_, Limits.pullback.lift_fst _ _ hk, Limits.pullback.lift_snd _ _ hk⟩
  have hFr1 : (wcGeomFrob K (wcP1Over K) hP).left ≫ Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hFr2 : (wcGeomFrob K (wcP1Over K) hP).left ≫ Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
        (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
          AlgebraicClosure K →+* AlgebraicClosure K)) :=
    Limits.pullback.lift_snd _ _ _
  have hφe : N.φ.left ≫ N.e.hom = N.e.hom ≫ Spec.map (CommRingCat.ofHom N.ψ) := by
    rw [← N.hψ, Iso.hom_inv_id_assoc]
  refine ⟨MorphismProperty.Over.homMk gl (by exact hgl1) trivial, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  change N.φ.left ≫ gl = gl ≫ (wcGeomFrob K (wcP1Over K) hP).left
  apply Limits.pullback.hom_ext
  · calc (N.φ.left ≫ gl) ≫ Limits.pullback.fst _ _ = N.φ.left ≫ N.V.hom := by
          rw [Category.assoc, hgl1]
      _ = N.V.hom := MorphismProperty.Over.w N.φ
      _ = gl ≫ Limits.pullback.fst _ _ := hgl1.symm
      _ = gl ≫ ((wcGeomFrob K (wcP1Over K) hP).left ≫ Limits.pullback.fst _ _) :=
          congrArg (fun t => gl ≫ t) hFr1.symm
      _ = (gl ≫ (wcGeomFrob K (wcP1Over K) hP).left) ≫ Limits.pullback.fst _ _ :=
          (Category.assoc _ _ _).symm
  · calc (N.φ.left ≫ gl) ≫ Limits.pullback.snd _ _
          = N.φ.left ≫ N.e.hom ≫ Spec.map (CommRingCat.ofHom ι) := by
          rw [Category.assoc, hgl2]
      _ = N.e.hom ≫ Spec.map (CommRingCat.ofHom (N.ψ.comp ι)) := by
          rw [← Category.assoc, hφe, Category.assoc, CommRingCat.ofHom_comp, Spec.map_comp]
      _ = N.e.hom ≫ Spec.map (CommRingCat.ofHom (ι.comp
            ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
              (AlgebraicClosure K) _ _ _).symm : AlgebraicClosure K →+* AlgebraicClosure K))) := by
          rw [hrig]
      _ = (gl ≫ Limits.pullback.snd _ _) ≫
            Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
              (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
                AlgebraicClosure K →+* AlgebraicClosure K)) := by
          rw [hgl2, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
      _ = gl ≫ ((wcGeomFrob K (wcP1Over K) hP).left ≫ Limits.pullback.snd _ _) := by
          rw [Category.assoc]; exact congrArg (fun t => gl ≫ t) hFr2.symm
      _ = (gl ≫ (wcGeomFrob K (wcP1Over K) hP).left) ≫ Limits.pullback.snd _ _ :=
          (Category.assoc _ _ _).symm

theorem wc_mtube_vt_geom_lift (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀) (φh : Th ⟶ Th)
    (hφh : φh ≫ g = g ≫ (wcProEtPullback D.f).map φ₀)
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (VT : D.Yt.left.ProEt) (jc : VT ⟶ Th)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (φV : VT ⟶ VT) (hφV : φV ≫ jc = jc ≫ φh)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hY : WeaklyEtale (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    (∀ v : VT.left, VT.hom v ∉ closure {D.xs i (IsLocalRing.closedPoint F'')}) ∧
    ∃ gV : VT ⟶ wcGeomPoint F'' D.Yt hY, φV ≫ gV = gV ≫ wcGeomFrob F'' D.Yt hY :=
by
  classical
  have hsubF : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
    show Subsingleton (PrimeSpectrum (AlgebraicClosure F''))
    infer_instance

  have hov : ∀ {U V : D.Yt.left.ProEt} (a : U ⟶ V) (x : U.left), V.hom (a.left x) = U.hom x := by
    intro U V a x
    rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]
  refine ⟨?_, ?_⟩
  ·
    have huniq : ∀ w w' : ((wcProEtPullback D.f).obj V₀).left,
        ((wcProEtPullback D.f).obj V₀).hom w = D.xs i (IsLocalRing.closedPoint F'') →
        ((wcProEtPullback D.f).obj V₀).hom w' = D.xs i (IsLocalRing.closedPoint F'') → w = w' := by
      intro w w' hw hw'
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w (IsLocalRing.closedPoint F'') hw
      obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w' (IsLocalRing.closedPoint F'') hw'
      let e' := Limits.pullbackLeftPullbackSndIso V₀.hom D.f (D.xs i) ≪≫
        Limits.pullback.congrHom rfl (D.hxs i) ≪≫ ε
      have hzz : z = z' := e'.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
      rw [← hz1, ← hz1', hzz]

    have hxsci : IsClosedImmersion (D.xs i) := by
      haveI : IsProper D.Yt.hom := D.proper
      have hcomp : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
        rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
      haveI : IsClosedImmersion (D.xs i ≫ D.Yt.hom) := by rw [hcomp]; infer_instance
      exact IsClosedImmersion.of_comp (D.xs i) D.Yt.hom
    have hrange : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        rw [Set.mem_singleton_iff, Subsingleton.elim x (IsLocalRing.closedPoint F'')]
      · intro h
        rw [Set.mem_singleton_iff] at h
        exact ⟨_, h.symm⟩
    have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
      rw [← hrange]
      exact (D.xs i).isClosedEmbedding.isClosed_range
    intro v hv'
    rw [hclosed.closure_eq, Set.mem_singleton_iff] at hv'
    have h1 : g.left (jc.left v) = xb := huniq _ _ (by rw [hov g, hov jc, hv']) hxb
    have h2 : jc.left v ∈ g.left ⁻¹' {xb} := h1
    rw [hpre] at h2
    have h3 : jc.left v ∈ Set.range jc.left := ⟨v, rfl⟩
    rw [hrc] at h3
    exact h3 h2
  ·
    have hfib : ∀ v : V₀.left, V₀.hom v = D.S i (IsLocalRing.closedPoint F'') →
        v = e.inv (IsLocalRing.closedPoint A) := by
      intro v hv'
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := D.S i)
        v (IsLocalRing.closedPoint F'') hv'
      obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := D.S i)
        (e.inv (IsLocalRing.closedPoint A)) (IsLocalRing.closedPoint F'') hv
      have hzz : z = z' := ε.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
      rw [← hz, ← hz', hzz]
    let ρ : A →+* A := (Spec.preimage (e.inv ≫ φ₀.left ≫ e.hom)).hom
    have hρ : e.inv ≫ φ₀.left ≫ e.hom = Spec.map (CommRingCat.ofHom ρ) := by
      show _ = Spec.map (CommRingCat.ofHom (Spec.preimage (e.inv ≫ φ₀.left ≫ e.hom)).hom)
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    obtain ⟨r, hker, hr⟩ := wc_skc_frob_residue F'' (D.S i) V₀ φ₀ A e ε hεφ ρ hρ hfib
    have hfrob : ∀ a : A, ρ a ^ (Nat.card F'' ^ 1) - a ∈ IsLocalRing.maximalIdeal A := by
      intro a
      rw [pow_one, ← hker, RingHom.mem_ker, map_sub, map_pow, hr, sub_self]
    let N : wcFrobNbhd F'' (D.S i (IsLocalRing.closedPoint F'')) 1 :=
      { V := V₀, φ := φ₀, A := A, e := e, hx := hv, ψ := ρ, hψ := hρ, hfrob := hfrob }
    obtain ⟨g₀, hg₀⟩ : ∃ g₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP,
        φ₀ ≫ g₀ = g₀ ≫ wcGeomFrob F'' (wcP1Over F'') hP :=
      wc_frobNbhd_geom_lift F'' hP _ N
    obtain ⟨eY, heY⟩ : ∃ eY : wcGeomPoint F'' D.Yt hY ≅
        (wcProEtPullback D.f).obj (wcGeomPoint F'' (wcP1Over F'') hP),
        eY.hom ≫ (wcProEtPullback D.f).map (wcGeomFrob F'' (wcP1Over F'') hP) =
          wcGeomFrob F'' D.Yt hY ≫ eY.hom :=
      wc_geomPoint_pullback_iso F'' (wcP1Over F'') D.Yt
        (Over.homMk (U := D.Yt) (V := wcP1Over F'') D.f D.hf) hP hY
    have heY' : (wcProEtPullback D.f).map (wcGeomFrob F'' (wcP1Over F'') hP) ≫ eY.inv =
        eY.inv ≫ wcGeomFrob F'' D.Yt hY := by
      rw [Iso.comp_inv_eq, Category.assoc, ← heY, Iso.inv_hom_id_assoc]
    refine ⟨jc ≫ g ≫ (wcProEtPullback D.f).map g₀ ≫ eY.inv, ?_⟩
    rw [reassoc_of% hφV, reassoc_of% hφh, ← Functor.map_comp_assoc, hg₀, Functor.map_comp_assoc,
      heY']
    simp only [Category.assoc]

theorem wc_proet_open_descend_geom_lift (K : Type u) [Field K] [Finite K]
    (Xo : Over (Spec (.of K)))
    (hX : WeaklyEtale (Limits.pullback.fst Xo.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (W : Xo.left.Opens)
    (hW : WeaklyEtale (Limits.pullback.fst (Over.mk (W.ι ≫ Xo.hom)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    {Z : Scheme.{u}} (i : Z ⟶ Xo.left)
    (V T : Xo.left.ProEt) (hV : ∀ v : V.left, V.hom v ∈ W)
    (a : V ⟶ V) (g : V ⟶ wcGeomPoint K Xo hX) (hg : a ≫ g = g ≫ wcGeomFrob K Xo hX)
    (jT : T ⟶ V) (hjT : IsOpenImmersion jT.left)
    (hrT : Set.range jT.left = {z | V.hom z ∉ Set.range i})
    (bT : T ⟶ T) (hbT : bT ≫ jT = jT ≫ a) :
    ∃ (Vw Tw : (W : Scheme.{u}).ProEt)
      (β : (wcSliceFunctor Xo.left (Scheme.ProEt.mk W.ι)).obj Vw ≅ V)
      (βT : (wcSliceFunctor Xo.left (Scheme.ProEt.mk W.ι)).obj Tw ≅ T)
      (aw : Vw ⟶ Vw) (gw : Vw ⟶ wcGeomPoint K (Over.mk (W.ι ≫ Xo.hom)) hW)
      (jw : Tw ⟶ Vw) (bw : Tw ⟶ Tw),
      β.hom ≫ a = (wcSliceFunctor Xo.left (Scheme.ProEt.mk W.ι)).map aw ≫ β.hom ∧
      aw ≫ gw = gw ≫ wcGeomFrob K (Over.mk (W.ι ≫ Xo.hom)) hW ∧
      βT.hom ≫ jT = (wcSliceFunctor Xo.left (Scheme.ProEt.mk W.ι)).map jw ≫ β.hom ∧
      βT.hom ≫ bT = (wcSliceFunctor Xo.left (Scheme.ProEt.mk W.ι)).map bw ≫ βT.hom ∧
      bw ≫ jw = jw ≫ aw ∧ IsOpenImmersion jw.left ∧
      Set.range jw.left = {z | Vw.hom z ∉ Set.range (i ∣_ W)} :=
by
  classical

  have key : ∀ w : (W : Scheme.{u}), W.ι w ∈ Set.range i ↔ w ∈ Set.range (i ∣_ W) := by
    intro w
    constructor
    · rintro ⟨x, hx⟩
      have hw : W.ι w ∈ Set.range W.ι := ⟨w, rfl⟩
      rw [Scheme.Opens.range_ι] at hw
      have hxW : x ∈ i ⁻¹ᵁ W := by
        show i x ∈ W
        rw [hx]
        exact hw
      obtain ⟨y, hy⟩ : x ∈ Set.range (i ⁻¹ᵁ W).ι := by
        rw [Scheme.Opens.range_ι]; exact hxW
      refine ⟨y, ?_⟩
      apply (Scheme.Hom.isOpenEmbedding W.ι).injective
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply, hy]
      exact hx
    · rintro ⟨y, rfl⟩
      exact ⟨(i ⁻¹ᵁ W).ι y, by
        rw [← Scheme.Hom.comp_apply, ← morphismRestrict_ι, Scheme.Hom.comp_apply]⟩

  have hVsub : Set.range V.hom ⊆ Set.range W.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨v, rfl⟩
    exact hV v
  have hTsub : Set.range T.hom ⊆ Set.range W.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨t, rfl⟩
    rw [← MorphismProperty.Over.w jT, Scheme.Hom.comp_apply]
    exact hV _
  obtain ⟨lV, hfV⟩ : ∃ l : V.left ⟶ (W : Scheme.{u}), l ≫ W.ι = V.hom :=
    ⟨IsOpenImmersion.lift W.ι V.hom hVsub, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨lT, hfT⟩ : ∃ l : T.left ⟶ (W : Scheme.{u}), l ≫ W.ι = T.hom :=
    ⟨IsOpenImmersion.lift W.ι T.hom hTsub, IsOpenImmersion.lift_fac _ _ _⟩
  haveI : WeaklyEtale (lV ≫ W.ι) := by rw [hfV]; exact V.prop
  haveI : WeaklyEtale (lT ≫ W.ι) := by rw [hfT]; exact T.prop
  haveI : WeaklyEtale lV := WeaklyEtale.of_comp lV W.ι
  haveI : WeaklyEtale lT := WeaklyEtale.of_comp lT W.ι

  have haL : a.left ≫ lV = lV := (cancel_mono W.ι).mp (by
    rw [Category.assoc, hfV]
    exact MorphismProperty.Over.w a)
  have hjL : jT.left ≫ lV = lT := (cancel_mono W.ι).mp (by
    rw [Category.assoc, hfV, hfT]
    exact MorphismProperty.Over.w jT)
  have hbL : bT.left ≫ lT = lT := (cancel_mono W.ι).mp (by
    rw [Category.assoc, hfT]
    exact MorphismProperty.Over.w bT)

  have hgV : g.left ≫ Limits.pullback.fst Xo.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) = V.hom :=
    MorphismProperty.Over.w g
  have hc : lV ≫ (Over.mk (W.ι ≫ Xo.hom)).hom =
      (g.left ≫ Limits.pullback.snd Xo.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    have e1 : lV ≫ W.ι ≫ Xo.hom = V.hom ≫ Xo.hom :=
      (Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ Xo.hom) hfV)
    have e2 : V.hom ≫ Xo.hom =
        (g.left ≫ Limits.pullback.snd Xo.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) :=
      (congrArg (fun t => t ≫ Xo.hom) hgV.symm).trans <| (Category.assoc _ _ _).trans <|
        (congrArg (fun t => g.left ≫ t) Limits.pullback.condition).trans
          (Category.assoc _ _ _).symm
    exact e1.trans e2
  obtain ⟨gwL, hgw1, hgw2⟩ : ∃ f : V.left ⟶ Limits.pullback (Over.mk (W.ι ≫ Xo.hom)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))),
      f ≫ Limits.pullback.fst (Over.mk (W.ι ≫ Xo.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) = lV ∧
      f ≫ Limits.pullback.snd (Over.mk (W.ι ≫ Xo.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        g.left ≫ Limits.pullback.snd Xo.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    ⟨Limits.pullback.lift lV _ hc, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨φ, hφX, hφW⟩ : ∃ φ : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of (AlgebraicClosure K)),
      (wcGeomFrob K Xo hX).left ≫ Limits.pullback.snd Xo.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Limits.pullback.snd Xo.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫ φ ∧
      (wcGeomFrob K (Over.mk (W.ι ≫ Xo.hom)) hW).left ≫
        Limits.pullback.snd (Over.mk (W.ι ≫ Xo.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Limits.pullback.snd (Over.mk (W.ι ≫ Xo.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫ φ :=
    ⟨_, Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hFr1W : (wcGeomFrob K (Over.mk (W.ι ≫ Xo.hom)) hW).left ≫
      Limits.pullback.fst (Over.mk (W.ι ≫ Xo.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.fst (Over.mk (W.ι ≫ Xo.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    MorphismProperty.Over.w _
  have hga : a.left ≫ g.left = g.left ≫ (wcGeomFrob K Xo hX).left :=
    congrArg (fun f => f.left) hg
  refine ⟨Scheme.ProEt.mk lV, Scheme.ProEt.mk lT,
    MorphismProperty.Over.isoMk (Iso.refl V.left) (by
      show 𝟙 V.left ≫ V.hom = lV ≫ W.ι
      rw [Category.id_comp, hfV]),
    MorphismProperty.Over.isoMk (Iso.refl T.left) (by
      show 𝟙 T.left ≫ T.hom = lT ≫ W.ι
      rw [Category.id_comp, hfT]),
    MorphismProperty.Over.homMk a.left haL trivial,
    MorphismProperty.Over.homMk gwL hgw1 trivial,
    MorphismProperty.Over.homMk jT.left hjL trivial,
    MorphismProperty.Over.homMk bT.left hbL trivial, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    show 𝟙 V.left ≫ a.left = a.left ≫ 𝟙 V.left
    rw [Category.id_comp, Category.comp_id]
  · apply MorphismProperty.Over.Hom.ext
    show a.left ≫ gwL = gwL ≫ (wcGeomFrob K (Over.mk (W.ι ≫ Xo.hom)) hW).left
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans <| (congrArg (fun t => a.left ≫ t) hgw1).trans <|
        haL.trans <| hgw1.symm.trans <| (congrArg (fun t => gwL ≫ t) hFr1W).symm.trans
          (Category.assoc _ _ _).symm
    · exact (Category.assoc _ _ _).trans <| (congrArg (fun t => a.left ≫ t) hgw2).trans <|
        (Category.assoc _ _ _).symm.trans <|
        (congrArg (fun t => t ≫ Limits.pullback.snd Xo.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hga).trans <|
        (Category.assoc _ _ _).trans <| (congrArg (fun t => g.left ≫ t) hφX).trans <|
        (Category.assoc _ _ _).symm.trans <| (congrArg (fun t => t ≫ φ) hgw2.symm).trans <|
        (Category.assoc _ _ _).trans <| (congrArg (fun t => gwL ≫ t) hφW.symm).trans
          (Category.assoc _ _ _).symm
  · apply MorphismProperty.Over.Hom.ext
    show 𝟙 T.left ≫ jT.left = jT.left ≫ 𝟙 V.left
    rw [Category.id_comp, Category.comp_id]
  · apply MorphismProperty.Over.Hom.ext
    show 𝟙 T.left ≫ bT.left = bT.left ≫ 𝟙 T.left
    rw [Category.id_comp, Category.comp_id]
  · apply MorphismProperty.Over.Hom.ext
    show bT.left ≫ jT.left = jT.left ≫ a.left
    exact congrArg (fun f => f.left) hbT
  · show IsOpenImmersion jT.left
    exact hjT
  · show Set.range jT.left = {z | lV z ∉ Set.range (i ∣_ W)}
    rw [hrT]
    ext z
    simp only [Set.mem_setOf_eq]
    rw [← hfV, Scheme.Hom.comp_apply]
    exact not_congr (key (lV z))

theorem wc_proet_open_slice_free_ext_transport (S : Scheme.{u}) (W : S.Opens)
    {V : (W : Scheme.{u}).ProEt} (a' : V ⟶ V) {U : S.ProEt} (a : U ⟶ U)
    (β : (wcSliceFunctor S (Scheme.ProEt.mk W.ι)).obj V ≅ U)
    (h : β.hom ≫ a = (wcSliceFunctor S (Scheme.ProEt.mk W.ι)).map a' ≫ β.hom)
    (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] (j : ℕ) :
    ∃ T : Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S A) j →+
        Abelian.Ext (wcFreeSheaf (W : Scheme.{u}) V) (wcContSheaf (W : Scheme.{u}) A) j,
      Function.Bijective T ∧
      ∀ z, T ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp z (zero_add j)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (W : Scheme.{u}) a')).comp (T z) (zero_add j) :=
by
  classical
  suffices key : ∀ (U₀ : S.ProEt) {V : U₀.left.ProEt} (a' : V ⟶ V)
      (β : (wcSliceFunctor S U₀).obj V ≅ U)
      (h : β.hom ≫ a = (wcSliceFunctor S U₀).map a' ≫ β.hom),
      ∃ T : Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S A) j →+
          Abelian.Ext (wcFreeSheaf U₀.left V) (wcContSheaf U₀.left A) j,
        Function.Bijective T ∧
        ∀ z, T ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp z (zero_add j)) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap U₀.left a')).comp (T z) (zero_add j) by
    exact key (Scheme.ProEt.mk W.ι) a' β h
  intro U₀ V a' β h

  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e
  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc
  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcSliceFunctor S U).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))
  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  have natIso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (Φ : C ⥤ D) [Φ.IsContinuous J K]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
      (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K),
      ∃ θ : ∀ X : C, L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
          (presheafToSheaf K AddCommGrpCat.{u+1}).obj
            (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
        ∀ {X X' : C} (g : X ⟶ X'),
          L.map ((presheafToSheaf J AddCommGrpCat.{u+1}).map
              (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
            (θ X').hom =
          (θ X).hom ≫ (presheafToSheaf K AddCommGrpCat.{u+1}).map
              (Functor.whiskerRight (yoneda.map (Φ.map g)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro C D _ _ J K _ _ Φ _ L adj
    have s1 : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] {Y Y' : E} (g : Y ⟶ Y')
        (G : Sheaf J' AddCommGrpCat.{u+1})
        (φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G),
        uliftYonedaEquiv ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G
              ((presheafToSheaf J' AddCommGrpCat.{u+1}).map
                (Functor.whiskerRight (yoneda.map g)
                  (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ φ))) =
          ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1}).map g.op
            (uliftYonedaEquiv ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
              ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ))) := by
      intro E _ J' _ Y Y' g G φ
      have e1 := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_naturality_left
        (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) φ
      have e2 := (Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv_naturality_left
        (uliftYoneda.{u+1}.map g) ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)
      have e3 := uliftYonedaEquiv_naturality
        (F := (sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1})
        ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)) g.op
      refine Eq.trans ?_ e3.symm
      refine Eq.trans ?_ (congrArg uliftYonedaEquiv e2)
      exact congrArg (fun t => uliftYonedaEquiv ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G) t))
        e1
    have s2 : ∀ (F F' : Sheaf K AddCommGrpCat.{u+1} ⥤ Type (u+1)) (τ : F' ⟶ F)
        {A A' B B' : Sheaf K AddCommGrpCat.{u+1}}
        (rA : F.CorepresentableBy A) (rA' : F'.CorepresentableBy A')
        (rB : F.CorepresentableBy B) (rB' : F'.CorepresentableBy B')
        (a : A ⟶ A') (b : B ⟶ B'),
        (∀ {G : Sheaf K AddCommGrpCat.{u+1}} (φ : A' ⟶ G),
          rA.homEquiv (a ≫ φ) = τ.app G (rA'.homEquiv φ)) →
        (∀ {G : Sheaf K AddCommGrpCat.{u+1}} (φ : B' ⟶ G),
          rB.homEquiv (b ≫ φ) = τ.app G (rB'.homEquiv φ)) →
        a ≫ (rA'.uniqueUpToIso rB').hom = (rA.uniqueUpToIso rB).hom ≫ b := by
      intro F F' τ A A' B B' rA rA' rB rB' a b ha hb
      show a ≫ rA'.homEquiv.symm (rB'.homEquiv (𝟙 _)) = rA.homEquiv.symm (rB.homEquiv (𝟙 _)) ≫ b
      apply rA.homEquiv.injective
      have hb1 := hb (𝟙 _)
      rw [Category.comp_id] at hb1
      rw [ha, Equiv.apply_symm_apply, rA.homEquiv_comp, Equiv.apply_symm_apply, ← rB.homEquiv_comp,
        Category.id_comp, hb1]
    let rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
      fun {E} _ J' _ Y =>
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    let r3 : ∀ X : C, (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := fun X =>
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans (rep J X).homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show (rep J X).homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, (rep J X).homEquiv_comp]
          rfl }
    refine ⟨fun X => (r3 X).uniqueUpToIso (rep K (Φ.obj X)), ?_⟩
    intro X X' g
    refine s2 _ _ (Functor.whiskerLeft (sheafToPresheaf K AddCommGrpCat.{u+1})
        (Functor.whiskerRight ((evaluation Dᵒᵖ AddCommGrpCat.{u+1}).map (Φ.map g).op)
          (forget AddCommGrpCat.{u+1})))
      (r3 X) (r3 X') (rep K (Φ.obj X)) (rep K (Φ.obj X')) _ _ ?_ ?_
    · intro G φ
      show (rep J X).homEquiv (adj.homEquiv _ G (L.map _ ≫ φ)) = _
      rw [Adjunction.homEquiv_naturality_left]
      exact s1 J g ((Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).obj G)
        (adj.homEquiv _ G φ)
    · intro G φ
      exact s1 K (Φ.map g) G φ
  have F0 : ∀ {S : Scheme.{u}} {U V T : S.ProEt} (a : U ⟶ V) (b : V ⟶ T),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V T a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have hcov : CoverPreserving (Scheme.ProEt.topology U₀.left) (Scheme.ProEt.topology S)
      (wcSliceFunctor S U₀) :=
    CoverPreserving.mk (fun {V} {R} hR =>
      (wc_proet_mem_topology_iff S ((wcSliceFunctor S U₀).obj V)
        (Sieve.functorPushforward (wcSliceFunctor S U₀) R)).2
        ((Sieve.functorPushforward_comp (wcSliceFunctor S U₀)
          (Scheme.ProEt.forget S ⋙ Over.forget S) R) ▸ (wc_proet_mem_topology_iff U₀.left V R).1 hR))
  haveI hcont : (wcSliceFunctor S U₀).IsContinuous (Scheme.ProEt.topology U₀.left)
      (Scheme.ProEt.topology S) :=
    Functor.isContinuous_of_coverPreserving (wc_slice_compatiblePreserving S U₀) hcov
  haveI hcocont : (wcSliceFunctor S U₀).IsCocontinuous (Scheme.ProEt.topology U₀.left)
      (Scheme.ProEt.topology S) :=
    Functor.IsCocontinuous.mk (fun {V} {T} hT => by
      have h1 := (wc_proet_mem_topology_iff S ((wcSliceFunctor S U₀).obj V) T).1 hT
      rw [← wc_slice_pushforward_functorPullback S U₀ V T] at h1
      exact (wc_proet_mem_topology_iff U₀.left V _).2 h1)
  haveI hlan : Limits.PreservesFiniteLimits ((wcSliceFunctor S U₀).op.lan :
      ((U₀.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (wcSliceFunctor S U₀).op
      (fun Y => wc_lan_eval_iso (wcSliceFunctor S U₀).op Y)
      (fun Y => wc_slice_costructuredArrow_final S U₀ Y.unop)

  let G := (wcSliceFunctor S U₀).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U₀.left) (Scheme.ProEt.topology S)
  let F := (wcSliceFunctor S U₀).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U₀.left) (Scheme.ProEt.topology S)
  let adj : F ⊣ G := (wcSliceFunctor S U₀).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U₀.left) (Scheme.ProEt.topology S)
  let adj2 := (wcSliceFunctor S U₀).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U₀.left) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits F :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits G :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits G
  haveI : Limits.PreservesLimitsOfSize.{0, 0} G := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits G :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits G
  haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
  haveI : G.Additive := Functor.additive_of_preserves_binary_products G
  haveI : F.Additive := adj.left_adjoint_additive

  obtain ⟨θ, hθ⟩ := natIso (Scheme.ProEt.topology U₀.left) (Scheme.ProEt.topology S)
    (wcSliceFunctor S U₀) F adj
  let θ' : ∀ X : U₀.left.ProEt, F.obj (wcFreeSheaf U₀.left X) ≅
      wcFreeSheaf S ((wcSliceFunctor S U₀).obj X) := θ
  have hθ' : ∀ {X X' : U₀.left.ProEt} (g : X ⟶ X'),
      F.map (wcFreeSheafMap U₀.left g) ≫ (θ' X').hom =
        (θ' X).hom ≫ wcFreeSheafMap S ((wcSliceFunctor S U₀).map g) := fun g => hθ g
  let fr : ∀ {T T' : S.ProEt} (β : T ≅ T'), wcFreeSheaf S T ≅ wcFreeSheaf S T' := fun β =>
    (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).mapIso
      (Functor.isoWhiskerRight (yoneda.mapIso β) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have hfr : ∀ {T T' : S.ProEt} (β : T ≅ T'), (fr β).hom = wcFreeSheafMap S β.hom :=
    fun β => rfl
  let p : F.obj (wcFreeSheaf U₀.left V) ≅ wcFreeSheaf S U := θ' V ≪≫ fr β
  have hp : F.map (wcFreeSheafMap U₀.left a') ≫ p.hom = p.hom ≫ wcFreeSheafMap S a := by
    show F.map (wcFreeSheafMap U₀.left a') ≫ ((θ' V).hom ≫ (fr β).hom) =
      ((θ' V).hom ≫ (fr β).hom) ≫ wcFreeSheafMap S a
    rw [hfr, ← Category.assoc, hθ' a', Category.assoc, Category.assoc, ← F0, ← F0, h]

  have hE : ∀ (g : wcFreeSheaf U₀.left V ⟶ wcFreeSheaf U₀.left V)
      (e : Abelian.Ext (F.obj (wcFreeSheaf U₀.left V)) (wcContSheaf S A) j),
      adj.extEquiv ((Abelian.Ext.mk₀ (F.map g)).comp e (zero_add j)) =
        (Abelian.Ext.mk₀ g).comp (adj.extEquiv e) (zero_add j) := by
    intro g e
    have hu : adj.unit.app (wcFreeSheaf U₀.left V) ≫ G.map (F.map g) =
        g ≫ adj.unit.app (wcFreeSheaf U₀.left V) := adj.unit_naturality g
    rw [Adjunction.extEquiv_apply, Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc]
    first
      | rw [hu, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
      | erw [hu, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
      | (simp only [hu]; rw [← Abelian.Ext.mk₀_comp_mk₀_assoc])
      | (refine (congrArg (fun m => (Abelian.Ext.mk₀ m).comp (Abelian.Ext.mapExactFunctor G e)
            (zero_add j)) hu).trans ?_
