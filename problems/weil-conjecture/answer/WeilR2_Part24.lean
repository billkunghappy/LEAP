theorem wc_etqm_srdmv_origin_fibre (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (c : Matrix (Fin n) (Fin n) A)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c))) (f' : X' ⟶ Spec (.of A))
