        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))))
      (V : (wcP1Over F'').left.Etale)
      (h : ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology (n - 1)).obj.obj
        (Opposite.op (wcEtOpen (wcP1Over F'').left V (V.hom ⁻¹ᵁ O))))
