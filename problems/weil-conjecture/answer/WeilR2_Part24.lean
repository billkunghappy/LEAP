theorem wc_srtq_single_push_supp : ∀ {X X' Z Z' : Scheme.{u}} (β : X' ⟶ X) [IsProper β] (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ X') (βZ : Z' ⟶ Z), IsPullback i' βZ β i → ∀ (m : ℕ), 0 < m → ∀ (Dβ : wcEtPullData β m) (Di : wcEtPullData i m) (Di' : wcEtPullData i' m) (N : SheafOfModules.{u+1} (wcEtZModRing X' m)), Limits.IsZero (Di'.Φ.obj N) → ∀ (J : InjectiveResolution N) (k : ℕ), haveI := Dβ.additive; haveI := Di.additive; letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange β) _ _ Dβ.cont Dβ.φ).Additive := Adjunction.right_adjoint_additive Dβ.adj; Limits.IsZero (Di.Φ.obj ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange β) _ _ Dβ.cont Dβ.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology k)) :=
by
