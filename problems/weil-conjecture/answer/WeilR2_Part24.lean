          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) 0 :=
        tt.isLE_of_iso ((DerivedCategory.singleFunctorIsoCompQ 𝒞 0).app One) 0
      exact tt.isLE_shift _ 0 1 (-1)
    have h2' : tt.IsGE (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ)) 1 := h2
    have hk0 : k' = 0 :=
      @Triangulated.TStructure.zero _ _ _ _ _ _ _ tt _ _ k' (-1) 1 (by omega) hLE h2'
    have hh2 : h ≫ DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) = 0 := by
      exact hk'.trans (by subst hk0; exact Limits.comp_zero)
    obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hdist h hh2
    change DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) ⟶
      DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One) at g
    change h = g ≫ DerivedCategory.Q.map eΨ at hg
    have hV : DerivedCategory.Q.map TΨ - 𝟙 _ =
        DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ g ≫
          DerivedCategory.Q.map eΨ := by
      rw [hh, hg]
    obtain ⟨ν, hν⟩ := hline0
    obtain ⟨g₀, hg₀⟩ := hdet0
    obtain ⟨a₀, ha₀⟩ := hν g₀
    obtain ⟨a, ha⟩ := hν g
    obtain ⟨x, hxdef⟩ : ∃ x, F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ ν ≫
          DerivedCategory.Q.map eΨ)) = x := ⟨_, rfl⟩
    have hlin : ∀ j : ℕ, F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ (j • ν) ≫
          DerivedCategory.Q.map eΨ)) = j • x := by
      intro j
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul]
      change F.map (j • ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ ν ≫
          DerivedCategory.Q.map eΨ)) = j • x
      rw [F.map_nsmul, hxdef]
    have hx1 : m • x = 0 := by
      rw [← hlin, hkill0 ν, Limits.zero_comp, Limits.comp_zero]
      change F.map (0 : (⟨_, hP⟩ : DerivedCategory.Plus 𝒞) ⟶ ⟨_, hP⟩) = 0
      exact F.map_zero _ _
    have hord : addOrderOf x = m := by
      apply Nat.dvd_antisymm (addOrderOf_dvd_of_nsmul_eq_zero hx1)
      have h5 := addOrderOf_smul_dvd (x := x) a₀
      rw [← hlin a₀, ← ha₀, hg₀] at h5
      exact h5
    have hFT : F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (N • (DerivedCategory.Q.map TΨ - 𝟙 (DerivedCategory.Q.obj Ψ)))) = 0 := by
      change F.map (N • (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞)) (DerivedCategory.Q.map TΨ) -
          𝟙 (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))) = 0
      rw [F.map_nsmul, F.map_sub, F.map_id]
      have e1 : F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
          (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞)) (DerivedCategory.Q.map TΨ)) =
          θ.hom ≫ TY ≫ θ.inv := by
        rw [← Category.assoc, ← hθ0, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [e1]
      have e2 : θ.hom ≫ TY ≫ θ.inv - 𝟙 _ = θ.hom ≫ (TY - 𝟙 Y) ≫ θ.inv := by
        rw [Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp, Iso.hom_inv_id]
      rw [e2, ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, hzero0, Limits.zero_comp,
        Limits.comp_zero]
    have hV' : N • (DerivedCategory.Q.map TΨ - 𝟙 (DerivedCategory.Q.obj Ψ)) =
        DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ ((N * a) • ν) ≫
          DerivedCategory.Q.map eΨ := by
      rw [hV, ha]
      simp only [Preadditive.nsmul_comp, Preadditive.comp_nsmul, smul_smul]
    have hFx : (N * a) • x = 0 := by
      rw [← hlin, ← hV']
      exact hFT
    have hdvd : m ∣ N * a := hord ▸ addOrderOf_dvd_of_nsmul_eq_zero hFx
    obtain ⟨q, hq⟩ := hdvd
    rw [hV', hq, mul_comm m q, ← smul_smul, hkill0 ν, smul_zero, Limits.zero_comp,
      Limits.comp_zero]
  let Pβ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange βs) _ _ Dβ.cont Dβ.φ
  haveI := Dβ.additive
  haveI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
  exact hne (key _ _ _ _ (Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι) hP' (ℓ ^ k)
    (ℓ ^ (k - 1)) _ _ θ hT' hge h7 (fun g => hkill _ _ g) hline hdet hθ hzero)

theorem wc_et_quad_model_var_not_killed (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (n : ℕ)
    (hn : Even n) (hn2 : 2 ≤ n) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A) (hc : IsUnit (c + c.transpose).det)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (ϖ : A) (hϖ : IsLocalRing.maximalIdeal A = Ideal.span {ϖ})
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom ϖ) :
    wcEtTplStar (wcQuadModelStr A n π c) ξ σ ℓ k :=
by
  classical

  have hσ' : (Spec.preimage σ).hom.comp (Spec.preimage ξ).hom = (Spec.preimage ξ).hom := by
    have h := congrArg (fun f => (Spec.preimage f).hom) hσ
    simp only [Spec.preimage_comp, CommRingCat.hom_comp] at h
    exact h
  have htameπ : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π :=
    wc_pltr_tame_transfer A ℓ hℓ ϖ π hϖ hπ Ω _ _ hσ' htame
  have hπm : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.subset_span rfl

  have Hh : wcEtTplStar (wcQuadModelStr A n π
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
      ξ σ ℓ k := by
    obtain ⟨m, hm⟩ := hn
    by_cases h2 : n = 2
    · subst h2
      have hch : (Matrix.of fun p q : Fin 2 => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) =
          (Matrix.of fun i j : Fin (0 + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
        ext i j
        fin_cases i <;> fin_cases j <;> simp
      rw [hch]

      let c0 : Matrix (Fin (0 + 2)) (Fin (0 + 2)) A :=
        Matrix.of fun i j : Fin (0 + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0
      let f0 : MvPolynomial (Fin (0 + 2)) A →+* IsLocalRing.ResidueField A :=
        MvPolynomial.eval₂Hom (IsLocalRing.residue A) (fun _ => 0)
      have hf0 : ∀ a ∈ wcQuadModelIdeal A (0 + 2) π c0, f0 a = 0 := by
        intro a ha
        obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        rw [map_mul]
        apply mul_eq_zero_of_right
        have hr : IsLocalRing.residue A π = 0 := (IsLocalRing.residue_eq_zero_iff π).mpr hπm
        simp [f0, hr]
      let ψ : wcQuadModelRing A (0 + 2) π c0 →+* IsLocalRing.ResidueField A :=
        Ideal.Quotient.lift _ f0 hf0
      let J : Ideal (wcQuadModelRing A (0 + 2) π c0) :=
        Ideal.span (Set.range fun q : Fin (0 + 2) =>
          Ideal.Quotient.mk (wcQuadModelIdeal A (0 + 2) π c0) (MvPolynomial.X q))
      have hJle : J ≤ RingHom.ker ψ := by
        apply Ideal.span_le.mpr
        rintro _ ⟨q, rfl⟩
        show ψ (Ideal.Quotient.mk _ (MvPolynomial.X q)) = 0
        simp [ψ, f0]
      have hJ : J ≠ ⊤ := by
        intro hJ
        have h1 : (1 : wcQuadModelRing A (0 + 2) π c0) ∈ RingHom.ker ψ := hJle (hJ ▸ Submodule.mem_top)
        rw [RingHom.mem_ker, map_one] at h1
        exact one_ne_zero h1
      obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal J hJ
      let u : Spec (.of (wcQuadModelRing A (0 + 2) π c0)) := (⟨M, hM.isPrime⟩ : PrimeSpectrum _)
      have h0 : Ideal.Quotient.mk (wcQuadModelIdeal A (0 + 2) π c0)
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (0 + 2))) ∈
          PrimeSpectrum.asIdeal ((𝟙 (Spec (.of (wcQuadModelRing A (0 + 2) π c0)))) u) :=
        hJM (Ideal.subset_span ⟨_, rfl⟩)
      have h1 : Ideal.Quotient.mk (wcQuadModelIdeal A (0 + 2) π c0)
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (0 + 2))) ∈
          PrimeSpectrum.asIdeal ((𝟙 (Spec (.of (wcQuadModelRing A (0 + 2) π c0)))) u) :=
        hJM (Ideal.subset_span ⟨_, rfl⟩)
      have key := wc_etqm_ss_etale_chart_star A ℓ hℓ k hk π hπ 0
        (Spec (.of (wcQuadModelRing A (0 + 2) π c0))) (𝟙 _) inferInstance u h0 h1 Ω ξ σ hσ htameπ
      rw [Category.id_comp] at key
      exact key
    · have h4 : 4 ≤ n := by omega
      exact wc_etqm_small_res_star A ℓ hℓ k hk n ⟨m, hm⟩ h4 π hπ Ω ξ σ hσ htameπ
        (fun r U g hg u h0 h1 =>
          wc_etqm_ss_etale_chart_star A ℓ hℓ k hk π hπ r U g hg u h0 h1 Ω ξ σ hσ htameπ)

  obtain ⟨Φ⟩ := wc_etqm_hyperbolic_iso A n hn π c hc
  let e : CommRingCat.of (wcQuadModelRing A n π
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)) ≅
      CommRingCat.of (wcQuadModelRing A n π c) := Φ.toRingEquiv.toCommRingCatIso
  let j : Spec (.of (wcQuadModelRing A n π
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))) ⟶
      Spec (.of (wcQuadModelRing A n π c)) := Spec.map e.inv
  have hj : Etale j := inferInstance
  have hjs : j ≫ wcQuadModelStr A n π c = wcQuadModelStr A n π
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) := by
    simp only [j, wcQuadModelStr, ← Spec.map_comp]
    congr 1
    ext x
    exact Φ.symm.commutes x
  rw [← hjs] at Hh
  exact wc_et_tpl_var_etale_reflect A _ _ (wcQuadModelStr A n π c) j hj Ω ξ σ ℓ k Hh

