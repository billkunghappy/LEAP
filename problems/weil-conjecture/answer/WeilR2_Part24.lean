            (@Functor.op X.Etale _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
              (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))) ⋙
          presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) AddCommGrpCat.{u+1} _
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology _) Dπ.cont).rightUnitor.symm ≪≫
      Functor.isoWhiskerLeft (@Functor.sheafPushforwardContinuous _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
          AddCommGrpCat.{u+1} _ (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology _) Dπ.cont)
        (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology X)
          AddCommGrpCat.{u+1}).counit).symm ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight (@Functor.sheafPushforwardContinuousCompSheafToPresheafIso _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
          AddCommGrpCat.{u+1} _ (Scheme.smallEtaleTopology X)
          (Scheme.smallEtaleTopology _) Dπ.cont)
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _
    haveI hfin' : Limits.PreservesFiniteColimits
        (sheafToPresheaf (Scheme.smallEtaleTopology _) AddCommGrpCat.{u+1} ⋙
          (Functor.whiskeringLeft (X.Etale)ᵒᵖ _ AddCommGrpCat.{u+1}).obj
            (@Functor.op X.Etale _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
              (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))) ⋙
          presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := hfin
    haveI hc : Limits.PreservesFiniteColimits
        (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) AddCommGrpCat.{u+1} _
          (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology _) Dπ.cont) :=
      Limits.preservesFiniteColimits_of_natIso e0.symm
    haveI hl : Limits.PreservesFiniteLimits
        (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) AddCommGrpCat.{u+1} _
          (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology _) Dπ.cont) := inferInstance
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology X)
      (wcEtZModRing X (ℓ ^ k))
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology _)
      (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k))
    exact (sheafOfModules_pushforward_exact (J := Scheme.smallEtaleTopology X)
      (K := Scheme.smallEtaleTopology _) _ (wcEtZModRing X (ℓ ^ k))
      (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k)) Dπ.φ).2.2

  obtain ⟨E1⟩ := wc_et_toSheaf_pushforward_iso _ (ℓ ^ k) Dπ
  obtain ⟨E2⟩ := wc_et_zmod_unit_toSheaf_iso (Limits.pullback fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k)
  obtain ⟨E3⟩ := wc_et_push_const_of_homeomorph _ hV (ℓ ^ k)
    (wc_et_const_sheaf_local_form _ (ℓ ^ k)).1 (wc_et_const_sheaf_local_form _ (ℓ ^ k)).2
  obtain ⟨E4⟩ := wc_et_zmod_unit_toSheaf_iso X (ℓ ^ k)
  obtain ⟨α, hinj, hsurj, _⟩ := wc_et_zmod_ring_locbij X (ℓ ^ k)
  haveI : (SheafOfModules.toSheaf (wcEtZModRing X (ℓ ^ k))).Full :=
    (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology X) (wcEtZModRing X (ℓ ^ k))
      (ℓ ^ k) α hinj hsurj).1
  let Θ : (SheafOfModules.toSheaf (wcEtZModRing X (ℓ ^ k))).obj
      ((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) _ _
        Dπ.cont Dπ.φ).obj
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k)))) ≅
      (SheafOfModules.toSheaf (wcEtZModRing X (ℓ ^ k))).obj
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) :=
    E1.app (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k))) ≪≫
      (wcEtPush _).mapIso E2 ≪≫ E3 ≪≫ E4.symm
  let ψ := (SheafOfModules.toSheaf (wcEtZModRing X (ℓ ^ k))).preimageIso Θ

  have hTr := wc_ext_adjoint_transfer Dπ.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) _ _
      Dπ.cont Dπ.φ) Dπ.adj
    (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k))) q
  have hz : ∀ z : Abelian.Ext (Dπ.Φ.obj (wcEtSuppObj D))
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k))) q,
      z = 0 := by
    intro z
    have hx : (Abelian.Ext.mk₀ φ.hom).comp ((Abelian.Ext.mk₀ φ.inv).comp z (zero_add _))
        (zero_add _) = z := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [← hx, hvan ((Abelian.Ext.mk₀ φ.inv).comp z (zero_add _)), Abelian.Ext.comp_zero]
  have hw : ∀ w : Abelian.Ext (wcEtSuppObj D)
      ((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) _ _
        Dπ.cont Dπ.φ).obj
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k)))) q,
      w = 0 := by
    intro w
    obtain ⟨z, hzw⟩ := hTr.2 w
    obtain ⟨z0, hz0⟩ := hTr.2 0
    have e1 : z = z0 := (hz z).trans (hz z0).symm
    rw [← hzw, e1]
    exact hz0
  have hθ : θ = (θ.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero q)).comp
      (Abelian.Ext.mk₀ ψ.hom) (add_zero q) := by
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  rw [hθ, hw (θ.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero q)), Abelian.Ext.zero_comp]

theorem wc_srdcb_point_supp_vanish (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (hk : 1 ≤ k) (Z₀ : Scheme.{u}) (i₀ : Z₀ ⟶ Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A))
    [IsClosedImmersion i₀] (hZ₀ : Nonempty Z₀)
    (hi₀ : ∀ (z : Z₀) (p : Fin n), Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((i₀ ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) z))
    (D₀ : wcEtPullData i₀ (ℓ ^ k)) (ZΛ : Scheme.{u})
    (iΛ : ZΛ ⟶ Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) [IsClosedImmersion iΛ]
    (hΛ : Set.range iΛ = ⇑(Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) ⁻¹'
      PrimeSpectrum.zeroLocus {r | ∃ p : Fin n, p.val % 2 = 0 ∧
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) = r})
    (DΛ : wcEtPullData iΛ (ℓ ^ k)) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
    ∀ q : ℤ, 0 ≤ q → q < (n : ℤ) →
      ∀ f : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj D₀)) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (wcEtSuppObj DΛ)))⟦q⟧, f = 0 :=
by
  classical
  intro q hq0 hqn f
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k))) := HasExt.standard _
  obtain ⟨q', rfl⟩ := Int.eq_ofNat_of_zero_le hq0
  have hq'n : q' < n := by omega
  obtain ⟨t, ht⟩ := hn

  have hcpq0 : ∀ p s : Fin n, ¬ p.val % 2 = 0 → c p s = 0 := by
    intro p s hp
    rw [hc]
    exact if_neg (fun h => hp h.1)
  have hres : IsLocalRing.residue A π = 0 :=
    (IsLocalRing.residue_eq_zero_iff π).2 (by rw [hπ]; exact Ideal.mem_span_singleton_self π)

  obtain ⟨g, hg0, hg1⟩ : ∃ g : Fin n → MvPolynomial (Fin t) (IsLocalRing.ResidueField A),
      (∀ p : Fin n, p.val % 2 = 0 → g p = 0) ∧
      ∀ p : Fin n, ¬ p.val % 2 = 0 →
        g p = MvPolynomial.X (⟨p.val / 2, by have := p.isLt; omega⟩ : Fin t) :=
    ⟨fun p => if p.val % 2 = 0 then 0 else
        MvPolynomial.X (⟨p.val / 2, by have := p.isLt; omega⟩ : Fin t),
      fun p hp => if_pos hp, fun p hp => if_neg hp⟩
  have hgodd : ∀ (i : Fin t) (hb : 2 * i.val + 1 < n),
      g ⟨2 * i.val + 1, hb⟩ = MvPolynomial.X i := by
    intro i hb
    rw [hg1 ⟨2 * i.val + 1, hb⟩ (by show ¬ (2 * i.val + 1) % 2 = 0; omega)]
    congr 1
    exact Fin.ext (by show (2 * i.val + 1) / 2 = i.val; omega)
  obtain ⟨ψt, hψtC, hψtX⟩ : ∃ ψt : MvPolynomial (Fin n) A →+*
      MvPolynomial (Fin t) (IsLocalRing.ResidueField A),
      (∀ a : A, ψt (MvPolynomial.C a) = MvPolynomial.C (IsLocalRing.residue A a)) ∧
      ∀ p : Fin n, ψt (MvPolynomial.X p) = g p :=
    ⟨MvPolynomial.eval₂Hom ((algebraMap (IsLocalRing.ResidueField A)
        (MvPolynomial (Fin t) (IsLocalRing.ResidueField A))).comp (IsLocalRing.residue A)) g,
      fun a => MvPolynomial.eval₂Hom_C _ _ _, fun p => MvPolynomial.eval₂Hom_X' _ _ _⟩
  have hψtQ : ψt (∑ p, ∑ s, MvPolynomial.C (c p s) * MvPolynomial.X p * MvPolynomial.X s) = 0 := by
    rw [map_sum]
    refine Finset.sum_eq_zero (fun p _ => ?_)
    rw [map_sum]
    refine Finset.sum_eq_zero (fun s _ => ?_)
    rw [map_mul, map_mul, hψtX, hψtX]
    by_cases hp : p.val % 2 = 0
    · rw [hg0 p hp, mul_zero, zero_mul]
    · rw [hψtC, hcpq0 p s hp, map_zero, MvPolynomial.C_0, zero_mul, zero_mul]
  have hψt : ∀ a ∈ wcQuadModelIdeal A n π c, ψt a = 0 := by
    intro a ha
    have ha' : a ∈ Ideal.span {∑ p, ∑ s, MvPolynomial.C (c p s) * MvPolynomial.X p *
        MvPolynomial.X s - MvPolynomial.C π} := ha
    rw [Ideal.mem_span_singleton'] at ha'
    obtain ⟨b, rfl⟩ := ha'
    rw [map_mul, map_sub, hψtC, hres, MvPolynomial.C_0, sub_zero, hψtQ, mul_zero]
  obtain ⟨ψ, hψmk⟩ : ∃ ψ : wcQuadModelRing A n π c →+*
      MvPolynomial (Fin t) (IsLocalRing.ResidueField A),
      ∀ f0, ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) f0) = ψt f0 :=
    ⟨Ideal.Quotient.lift _ ψt hψt, fun f0 => Ideal.Quotient.lift_mk _ _ _⟩
  have hsurj : Function.Surjective ψ := by
    intro b
    refine MvPolynomial.induction_on (motive := fun b => ∃ a, ψ a = b) b ?_ ?_ ?_
    · intro a
      obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective a
      exact ⟨Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a'),
        by rw [hψmk, hψtC]⟩
    · rintro p1 p2 ⟨r1, hr1⟩ ⟨r2, hr2⟩
      exact ⟨r1 + r2, by rw [map_add, hr1, hr2]⟩
    · rintro p1 i ⟨r1, hr1⟩
      refine ⟨r1 * Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X ⟨2 * i.val + 1, by have := i.isLt; omega⟩), ?_⟩
      rw [map_mul, hr1, hψmk, hψtX, hgodd]
  have hcomp : ψ.comp (algebraMap A (wcQuadModelRing A n π c)) =
      (algebraMap (IsLocalRing.ResidueField A)
        (MvPolynomial (Fin t) (IsLocalRing.ResidueField A))).comp (IsLocalRing.residue A) := by
    refine RingHom.ext (fun a => ?_)
    show ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a)) =
      MvPolynomial.C (IsLocalRing.residue A a)
    rw [hψmk, hψtC]

  obtain ⟨Iev, hIev⟩ : ∃ J : Ideal (wcQuadModelRing A n π c), J = Ideal.span
      {r | ∃ p : Fin n, p.val % 2 = 0 ∧
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) = r} := ⟨_, rfl⟩
  have hXev : ∀ p : Fin n, p.val % 2 = 0 →
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ Iev := by
    intro p hp
    rw [hIev]
    exact Ideal.subset_span ⟨p, hp, rfl⟩
  have hQev : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
      (∑ p, ∑ s, MvPolynomial.C (c p s) * MvPolynomial.X p * MvPolynomial.X s) ∈ Iev := by
    rw [map_sum]
    refine Ideal.sum_mem _ (fun p _ => ?_)
    rw [map_sum]
    refine Ideal.sum_mem _ (fun s _ => ?_)
    by_cases hp : p.val % 2 = 0
    · rw [map_mul, map_mul]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (hXev p hp))
    · rw [hcpq0 p s hp, MvPolynomial.C_0, zero_mul, zero_mul, map_zero]
      exact Iev.zero_mem
  have hπQ : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ p, ∑ s, MvPolynomial.C (c p s) * MvPolynomial.X p * MvPolynomial.X s) := by
    rw [Ideal.Quotient.eq, ← neg_sub]
    exact neg_mem (Ideal.mem_span_singleton_self _)
  have hφ0 : ∀ a ∈ IsLocalRing.maximalIdeal A,
      ((Ideal.Quotient.mk Iev).comp (algebraMap A (wcQuadModelRing A n π c))) a = 0 := by
    intro a ha
    rw [hπ, Ideal.mem_span_singleton'] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [map_mul]
    have h0 : ((Ideal.Quotient.mk Iev).comp (algebraMap A (wcQuadModelRing A n π c))) π = 0 := by
      show Ideal.Quotient.mk Iev
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π)) = 0
      rw [hπQ, Ideal.Quotient.eq_zero_iff_mem]
      exact hQev
    rw [h0]
    exact mul_zero (M₀ := wcQuadModelRing A n π c ⧸ Iev) _
  obtain ⟨lam, hlam⟩ : ∃ lam : IsLocalRing.ResidueField A →+* wcQuadModelRing A n π c ⧸ Iev,
      ∀ a : A, lam (IsLocalRing.residue A a) =
        Ideal.Quotient.mk Iev (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a)) :=
    ⟨Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) _ hφ0, fun a => rfl⟩
  obtain ⟨θ, hθC, hθX⟩ : ∃ θ : MvPolynomial (Fin t) (IsLocalRing.ResidueField A) →+*
      wcQuadModelRing A n π c ⧸ Iev,
      (∀ b, θ (MvPolynomial.C b) = lam b) ∧
      ∀ i : Fin t, θ (MvPolynomial.X i) = Ideal.Quotient.mk Iev
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X (⟨2 * i.val + 1, by have := i.isLt; omega⟩ : Fin n))) :=
    ⟨MvPolynomial.eval₂Hom lam (fun i : Fin t => Ideal.Quotient.mk Iev
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X (⟨2 * i.val + 1, by have := i.isLt; omega⟩ : Fin n)))),
      fun b => MvPolynomial.eval₂Hom_C _ _ _,
      fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩
  have hθψ : θ.comp ψt =
      (Ideal.Quotient.mk Iev).comp (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      show θ (ψt (MvPolynomial.C a)) = Ideal.Quotient.mk Iev
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a))
      rw [hψtC, hθC, hlam]
    · intro p
      show θ (ψt (MvPolynomial.X p)) = Ideal.Quotient.mk Iev
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))
      rw [hψtX]
      by_cases hp : p.val % 2 = 0
      · rw [hg0 p hp, map_zero]
        exact ((Ideal.Quotient.eq_zero_iff_mem).2 (hXev p hp)).symm
      · rw [hg1 p hp, hθX]
        exact congrArg (fun x : Fin n => Ideal.Quotient.mk Iev
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X x)))
          (Fin.ext (by show 2 * (p.val / 2) + 1 = p.val; omega))
  have hkerev : RingHom.ker ψ ≤ Iev := by
    intro r hr
    obtain ⟨f0, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [RingHom.mem_ker, hψmk] at hr
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have h1 := congrArg (fun h => h f0) hθψ
    simp only [RingHom.comp_apply] at h1
    rw [← h1, hr, map_zero]

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : Spec (.of (MvPolynomial (Fin t) (IsLocalRing.ResidueField A))) ⟶
      Spec (.of (wcQuadModelRing A n π c)), Ψ = Spec.map (CommRingCat.ofHom ψ) := ⟨_, rfl⟩
  obtain ⟨fB, hfB⟩ : ∃ fB : Spec (.of (MvPolynomial (Fin t) (IsLocalRing.ResidueField A))) ⟶
      Spec (.of (IsLocalRing.ResidueField A)),
      fB = Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (MvPolynomial (Fin t) (IsLocalRing.ResidueField A)))) := ⟨_, rfl⟩
  have hw : Ψ ≫ wcQuadModelStr A n π c = fB ≫ wcQmSp A := by
    rw [hΨ, hfB]
    dsimp only [wcQuadModelStr, wcQmSp]
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      hcomp]
  obtain ⟨j, hjfst⟩ : ∃ j : Spec (.of (MvPolynomial (Fin t) (IsLocalRing.ResidueField A))) ⟶
      Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A),
      j ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) = Ψ :=
    ⟨Limits.pullback.lift Ψ fB hw, Limits.pullback.lift_fst _ _ _⟩
  haveI hsp : IsClosedImmersion (wcQmSp A) := by
    unfold wcQmSp
    exact IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hfinj : Function.Injective
      (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) :=
    (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)).isClosedEmbedding.injective
  haveI hΨc : IsClosedImmersion Ψ := by
    rw [hΨ]
    exact IsClosedImmersion.spec_of_surjective _ hsurj
