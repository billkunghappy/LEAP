    (hO : ∀ p : (wcP1Over F'').left, p ∈ O ↔ ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'')) :
    ∃ c : ℕ, ∀ (k : ℕ)
