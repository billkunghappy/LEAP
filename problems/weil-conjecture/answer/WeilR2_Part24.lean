  have hsmW : SmoothOfRelativeDimension (n - 2) (ID.subschemeι ≫ Limits.pullback.snd f' (wcQmSp A)) := by
    refine c4 (IsLocalRing.ResidueField A) _ _ (Limits.pullback.snd f' (wcQmSp A)) ID.subschemeι
