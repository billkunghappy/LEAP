  have key : (∃ z : wcEtZModExt (Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η)) (ℓ ^ k) (n - 1),
        ℓ ^ k ∣ ℓ ^ (K + τ η + τ (D.S i (IsLocalRing.closedPoint F''))) *
