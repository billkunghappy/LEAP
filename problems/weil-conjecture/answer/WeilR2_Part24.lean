  let I := injectiveResolution (wcRootTwist (Over.mk (W.ι ≫ X.hom)).left (ℓ ^ k) 1)
  have hvan : ∀ q : ℕ, q ≠ 2 → Limits.IsZero
      (((((wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).rightAdjoint).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex).homology q) := by
    intro q hq
    rcases Nat.lt_or_gt_of_ne hq with h | h
    · exact wc_smooth_divisor_proet_mu_shriek_low_vanish K (Over.mk (W.ι ≫ X.hom)).hom d
        (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ) ℓ hℓK k
        (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).rightAdjoint adj I q h
    · exact wc_smooth_divisor_proet_mu_shriek_high_vanish K (Over.mk (W.ι ≫ X.hom)).hom d
        (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ) ℓ hℓK k
        (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).rightAdjoint adj I q h
  obtain ⟨ψ, hψ⟩ := wc_smooth_divisor_proet_mu_shriek_top_iso K (Over.mk (W.ι ≫ X.hom)).hom d
    (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ) ℓ hℓK k
    (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).rightAdjoint adj I
  haveI := hψ
  obtain ⟨τ, hτ⟩ := ext_shifted_degenerate_leray_bijective
    (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ))
    (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).rightAdjoint adj
    (wcRootTwist (Over.mk (W.ι ≫ X.hom)).left (ℓ ^ k) 1) I
    (wcContSheaf Z.left (ZMod (ℓ ^ k))) 2 ψ hvan
  let gHom : Abelian.Ext (wcFreeSheaf Z.left (wcGeomPoint K Z hZ))
      (wcContSheaf Z.left (ZMod (ℓ ^ k))) j →+
      Abelian.Ext ((wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).obj
          (wcFreeSheaf Z.left (wcGeomPoint K Z hZ)))
        (wcRootTwist (Over.mk (W.ι ≫ X.hom)).left (ℓ ^ k) 1) (j + 2) :=
    AddMonoidHom.mk' (fun y => (Abelian.Ext.mapExactFunctor
        (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)) y).comp τ rfl)
      (fun a c => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hg : Function.Bijective gHom :=
    hτ (wcFreeSheaf Z.left (wcGeomPoint K Z hZ)) j (j + 2) rfl
  have h3 : ∀ y, gHom ((Abelian.Ext.mk₀ (wcFreeSheafMap Z.left (wcGeomFrob K Z hZ))).comp y
      (zero_add j)) =
      (Abelian.Ext.mk₀ ((wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).map
        (wcFreeSheafMap Z.left (wcGeomFrob K Z hZ)))).comp (gHom y) (zero_add (j + 2)) := by
    intro y
    show (Abelian.Ext.mapExactFunctor
        (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ))
        ((Abelian.Ext.mk₀ (wcFreeSheafMap Z.left (wcGeomFrob K Z hZ))).comp y
          (zero_add j))).comp τ rfl =
      (Abelian.Ext.mk₀ ((wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)).map
        (wcFreeSheafMap Z.left (wcGeomFrob K Z hZ)))).comp
        ((Abelian.Ext.mapExactFunctor
          (wcProEtPush (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ)) y).comp τ rfl)
        (zero_add (j + 2))
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add j) rfl (by omega)

  let eΘ := AddEquiv.ofBijective Θ1 hΘ1b
  let eg := AddEquiv.ofBijective gHom hg
  have e6 : ∀ w, eg.symm (gHom w) = w := fun w => eg.symm_apply_apply w
  refine ⟨((eg.symm.toAddMonoidHom.comp K1).comp eΘ.symm.toAddMonoidHom).comp T, ?_, ?_⟩
  · exact (eg.symm.injective.comp (hK1.comp eΘ.symm.injective)).comp hTb.1
  · intro z
    obtain ⟨y, hy⟩ := hΘ1b.2 (T z)
    have e0 : T ((Abelian.Ext.mk₀ Ψ).comp z (zero_add (j + 2))) =
        (Abelian.Ext.mk₀ Ψ').comp (Θ1 y) (zero_add (j + 2)) := by
      rw [hTF, hy]
    have e1 : (Abelian.Ext.mk₀ Ψ').comp (Θ1 y) (zero_add (j + 2)) =
        Θ1 ((Nat.card K ^ 1) • (Abelian.Ext.mk₀ Ψ').comp y (zero_add (j + 2))) := by
      rw [map_nsmul, hΘ1F]
    have e2 : eΘ.symm (Θ1 y) = y := eΘ.symm_apply_apply y
    have e3 : eΘ.symm (Θ1 ((Nat.card K ^ 1) • (Abelian.Ext.mk₀ Ψ').comp y (zero_add (j + 2)))) =
        (Nat.card K ^ 1) • (Abelian.Ext.mk₀ Ψ').comp y (zero_add (j + 2)) :=
      eΘ.symm_apply_apply _
    have e4 : gHom (eg.symm (K1 y)) = K1 y := eg.apply_symm_apply (K1 y)
    have e5 : K1 ((Abelian.Ext.mk₀ Ψ').comp y (zero_add (j + 2))) =
        gHom ((Abelian.Ext.mk₀ (wcFreeSheafMap Z.left (wcGeomFrob K Z hZ))).comp
          (eg.symm (K1 y)) (zero_add j)) := by
      rw [h3, e4, h2]
    show eg.symm (K1 (eΘ.symm (T ((Abelian.Ext.mk₀ Ψ).comp z (zero_add (j + 2)))))) =
      Nat.card K • (Abelian.Ext.mk₀ (wcFreeSheafMap Z.left (wcGeomFrob K Z hZ))).comp
        (eg.symm (K1 (eΘ.symm (T z)))) (zero_add j)
    rw [e0, ← hy, e1, e3, e2, map_nsmul, e5, map_nsmul, e6, pow_one]

theorem wc_zmod_A1_proj_supp_unit_iso {N : Scheme.{u}} (n : ℕ)
    (Dp : wcZModPullData (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) n)
    (hDp : wcZModPullCanonical Dp) : IsIso (wcZModSuppUnitMap Dp) :=
by
  classical

  have s1 : ∀ {M M' : SheafOfModules.{u+1} (wcZModRingSheaf N n)} (φ : M ⟶ M'),
      (∀ X, Function.Bijective (φ.val.app X).hom) → IsIso φ := by
    intro M M' φ h
    have h2 : ∀ X, IsIso (((PresheafOfModules.toPresheaf (wcZModRingSheaf N n).val).map
        ((SheafOfModules.forget (wcZModRingSheaf N n)).map φ)).app X) := by
      intro X
      rw [ConcreteCategory.isIso_iff_bijective]
      exact h X
    have : IsIso ((PresheafOfModules.toPresheaf (wcZModRingSheaf N n).val).map
        ((SheafOfModules.forget (wcZModRingSheaf N n)).map φ)) := NatIso.isIso_of_isIso_app _
    have : IsIso ((SheafOfModules.forget (wcZModRingSheaf N n)).map φ) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf (wcZModRingSheaf N n).val)
    exact isIso_of_reflects_iso φ (SheafOfModules.forget (wcZModRingSheaf N n))

  have hfib : ∀ {V : Scheme.{u}} (g : V ⟶ N) (v : V),
      _root_.IsPreconnected
        ((Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom ⁻¹' {v}) := by
    intro V g v
    let ι := V.fromSpecResidueField v
    let f₀ := ι ≫ g
    let π := AffineSpace (ULift.{u} (Fin 1)) (Spec (V.residueField v)) ↘ Spec (V.residueField v)
    let m := AffineSpace.map (ULift.{u} (Fin 1)) f₀
    have w : (π ≫ ι) ≫ g = m ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) := by
      rw [AffineSpace.map_over, Category.assoc]
    let h := Limits.pullback.lift (π ≫ ι) m w
    have hfst : h ≫ Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) = π ≫ ι :=
      Limits.pullback.lift_fst _ _ _
    have hsnd : h ≫ Limits.pullback.snd g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) = m :=
      Limits.pullback.lift_snd _ _ _
    have hout : IsPullback (h ≫ Limits.pullback.snd g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) π
        (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) (ι ≫ g) := by
      rw [hsnd]; exact AffineSpace.isPullback_map f₀
    have hL : IsPullback h π (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι :=
      IsPullback.of_right hout hfst (IsPullback.of_hasPullback g _).flip
    have e1 : hL.isoPullback.hom ≫
        Limits.pullback.fst (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι = h :=
      hL.isoPullback_hom_fst
    have e1' : ∀ y, (Limits.pullback.fst (Limits.pullback.fst g
        (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι).base.hom (hL.isoPullback.hom.base.hom y) =
        h.base.hom y := fun y =>
      congrArg (fun f : AffineSpace (ULift.{u} (Fin 1)) (Spec (V.residueField v)) ⟶
        Limits.pullback g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) => f.base.hom y) e1
    have hrange : Set.range h.base.hom =
        (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom ⁻¹' {v} := by
      have hr2 : Set.range h.base.hom = Set.range
          (Limits.pullback.fst (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι) := by
        ext x
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨hL.isoPullback.hom y, e1' y⟩
        · rintro ⟨y, rfl⟩
          obtain ⟨z, rfl⟩ := hL.isoPullback.hom.surjective y
          exact ⟨z, (e1' z).symm⟩
      rw [hr2, Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
    rw [← hrange]
    exact isPreconnected_range h.base.hom.continuous
  have hsurjG : ∀ {W : Scheme.{u}} (g : W ⟶ N),
      Function.Surjective (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom :=
    fun g => Scheme.Hom.surjective (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N))
  have hopenG : ∀ {W : Scheme.{u}} (g : W ⟶ N),
      IsOpenMap (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom :=
    fun g => Scheme.Hom.isOpenMap (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N))
  let σ : ∀ V : N.ProEt, C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
      ULift.{u+1} (ZMod n)) := fun V =>
    ((wcZModSuppUnitMap Dp).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n)))
  let ρf : ∀ V : N.ProEt, C(↥V.left, ULift.{u+1} (ZMod n)) →
      C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)), ULift.{u+1} (ZMod n)) :=
    fun V t => ((wcZModSuppUnitMap Dp).val.app (Opposite.op V)).hom t

  have hunit : ∀ V : N.ProEt, ∃ c : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
      ULift.{u+1} (ZMod n)), σ V * c = 1 := by
    intro V
    letI := Dp.cont
    let u := SheafOfModules.unitToPushforwardObjUnit Dp.φ
    let ψ₁ := (Dp.adj.homEquiv _ _).symm u
    let h : SheafOfModules.unit (wcZModRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) n) ⟶
        SheafOfModules.unit (wcZModRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) n) :=
      Dp.μ.inv ≫ ψ₁
    have hfac : u = wcZModSuppUnitMap Dp ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _
          (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).map h := by
      have e1 : Dp.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u = Dp.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = Dp.adj.homEquiv _ _ (Dp.μ.hom ≫ h) := by rw [e1]
        _ = Dp.adj.homEquiv _ _ Dp.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _
              (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcZModSuppUnitMap Dp ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _
              (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let cV : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap Dp).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n)))
    let a : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)) :=
      (h.val.app (Opposite.op ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V))).hom
        (1 : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
          ULift.{u+1} (ZMod n)))
    have hu1 : (u.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n))) =
        (1 : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
          ULift.{u+1} (ZMod n))) :=
      (Dp.φ.hom.app (Opposite.op V)).hom.map_one
    have hev : (u.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n))) =
        (h.val.app (Opposite.op ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V))).hom
          cV := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)),
        (h.val.app (Opposite.op ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V))).hom
          x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op
        ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V))).hom.map_smul x
        (1 : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
          ULift.{u+1} (ZMod n)))
      have e2 : (h.val.app (Opposite.op
            ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V))).hom x =
          (h.val.app (Opposite.op
            ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op
          ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cV * a = 1 := by
      rw [← hlin cV, ← hev, hu1]
    exact ⟨a, key⟩

  have hlinρ : ∀ (V : N.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod n))),
      ρf V t = t.comp (Limits.pullback.fst V.hom
        (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom * σ V := by
    intro V t
    let mt : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)) := ρf V t
    let φt : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)) := (Dp.φ.hom.app (Opposite.op V)).hom t
    have hφ : φt = t.comp (Limits.pullback.fst V.hom
        (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom := hDp V t
    have h := ((wcZModSuppUnitMap Dp).val.app (Opposite.op V)).hom.map_smul t
      (1 : C(↥V.left, ULift.{u+1} (ZMod n)))
    let mt1 : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap Dp).val.app (Opposite.op V)).hom (t * 1)
    have h' : mt1 = φt * σ V := h
    rw [hφ] at h'
    have h0 : mt1 = mt :=
      congrArg (fun x => ((wcZModSuppUnitMap Dp).val.app (Opposite.op V)).hom x) (mul_one t)
    exact h0.symm.trans h'
  haveI hTD : TotallyDisconnectedSpace (ULift.{u+1} (ZMod n)) := inferInstance

  apply s1
  intro X
  rcases X with ⟨V⟩
  let fstV := (Limits.pullback.fst V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom
  obtain ⟨c, hc⟩ := hunit V
  have e2 : ∀ z, σ V z * c z = 1 := fun z =>
    congrArg (fun φ => φ z) hc
  constructor
  · intro t t' htt
    let t0 : C(↥V.left, ULift.{u+1} (ZMod n)) := t
    let t0' : C(↥V.left, ULift.{u+1} (ZMod n)) := t'
    have H : ContinuousMap.comp t0 fstV * σ V = ContinuousMap.comp t0' fstV * σ V :=
      (hlinρ V t0).symm.trans (htt.trans (hlinρ V t0'))
    change t0 = t0'
    apply ContinuousMap.ext
    intro x
    obtain ⟨z, hz⟩ := hsurjG V.hom x
    have hz' : fstV z = x := hz
    have H1 := congrArg (fun φ : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)) => φ z) H
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply] at H1
    rw [← hz']
    change t0 (fstV z) = t0' (fstV z)
    linear_combination (c z) * H1 - (t0 (fstV z) - t0' (fstV z)) * e2 z
  · intro s
    let s0 : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} (ZMod n)) := s
    let s' := s0 * c
    have hq : Topology.IsQuotientMap fstV :=
      IsOpenMap.isQuotientMap (hopenG V.hom) fstV.continuous (hsurjG V.hom)
    have hfac : Function.FactorsThrough s' fstV := by
      intro a b hab
      have hpc := (hfib V.hom (fstV b)).image s' s'.continuous.continuousOn
      exact hpc.subsingleton (Set.mem_image_of_mem _ hab) (Set.mem_image_of_mem _ rfl)
    refine ⟨hq.lift s' hfac, ?_⟩
    have hl := hq.lift_comp s' hfac
    change ρf V (hq.lift s' hfac) = s0
    rw [hlinρ, hl]
    apply ContinuousMap.ext
    intro z
    simp only [s', ContinuousMap.mul_apply]
    linear_combination (s0 z) * e2 z

theorem wc_zmod_A1_proj_higher_vanish (K : Type u) [Field K] {N : Scheme.{u}} (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓK : (ℓ : K) ≠ 0) (qN : N ⟶ Spec (.of K)) (k : ℕ)
    (Dp : wcZModPullData (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) (ℓ ^ k))
    (hDp : wcZModPullCanonical Dp)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcZModRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) (ℓ ^ k))))
    (q : ℕ) (hq : 1 ≤ q) :
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dp.adj Dp.additive
    Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical
  rcases k with _ | k'
  ·
    have hD : ∀ (S : Scheme.{u}) (M : SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ 0))),
        Limits.IsZero M := by
      intro S M
      rw [Limits.IsZero.iff_id_eq_zero]
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      haveI hR : Subsingleton ((wcZModRingSheaf S (ℓ ^ 0)).obj.obj X) := by
        change Subsingleton C(↥(Opposite.unop X).left, ULift.{u+1} (ZMod (ℓ ^ 0)))
        infer_instance
      haveI := Module.subsingleton ((wcZModRingSheaf S (ℓ ^ 0)).obj.obj X) (M.val.obj X)
      exact Subsingleton.elim _ _
    exact hD _ _
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dp.adj Dp.additive
  letI : HasExt (SheafOfModules.{u+1}
      (wcZModRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) (ℓ ^ (k' + 1)))) :=
    HasExt.standard _
  haveI := Dp.cont
  obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
  have hn : 0 < ℓ ^ (k' + 1) := pow_pos (Fact.out : Nat.Prime ℓ).pos _

  obtain ⟨αp, hp1, hp2, hp3⟩ :=
