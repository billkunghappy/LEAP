    Functor.isContinuous_of_coverPreserving (wc_slice_compatiblePreserving S U) hcov
  haveI hcocont : (wcSliceFunctor S U).IsCocontinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology S) :=
    Functor.IsCocontinuous.mk (fun {V} {T} hT => by
      have h1 := (wc_proet_mem_topology_iff S ((wcSliceFunctor S U).obj V) T).1 hT
      rw [← wc_slice_pushforward_functorPullback S U V T] at h1
      exact (wc_proet_mem_topology_iff U.left V _).2 h1)
  haveI hlan : Limits.PreservesFiniteLimits ((wcSliceFunctor S U).op.lan :
      ((U.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (wcSliceFunctor S U).op
      (fun Y => wc_lan_eval_iso (wcSliceFunctor S U).op Y)
      (fun Y => wc_slice_costructuredArrow_final S U Y.unop)

  let G := (wcSliceFunctor S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
  let F := (wcSliceFunctor S U).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
  let adj : F ⊣ G := (wcSliceFunctor S U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
  let adj2 := (wcSliceFunctor S U).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits F :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits G :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits G
  haveI : Limits.PreservesLimitsOfSize.{0, 0} G := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits G :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits G
  haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
  haveI : G.Additive := Functor.additive_of_preserves_binary_products G
  haveI : F.Additive := adj.left_adjoint_additive

  obtain ⟨θ, hθ⟩ := natIso (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    (wcSliceFunctor S U) F adj
  let θ' : ∀ V : U.left.ProEt, F.obj (wcFreeSheaf U.left V) ≅
      wcFreeSheaf S ((wcSliceFunctor S U).obj V) := θ
  have hθ' : ∀ {X X' : U.left.ProEt} (g : X ⟶ X'),
      F.map (wcFreeSheafMap U.left g) ≫ (θ' X').hom =
        (θ' X).hom ≫ wcFreeSheafMap S ((wcSliceFunctor S U).map g) := fun g => hθ g
  let fr : ∀ {T T' : S.ProEt} (β : T ≅ T'), wcFreeSheaf S T ≅ wcFreeSheaf S T' := fun β =>
    (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).mapIso
      (Functor.isoWhiskerRight (yoneda.mapIso β) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have hfr : ∀ {T T' : S.ProEt} (β : T ≅ T'), (fr β).hom = wcFreeSheafMap S β.hom :=
    fun β => rfl
  let p : F.obj (wcFreeSheaf U.left V₁) ≅ wcFreeSheaf S U₁ := θ' V₁ ≪≫ fr β₁
  let q : F.obj (wcFreeSheaf U.left V₂) ≅ wcFreeSheaf S U₂ := θ' V₂ ≪≫ fr β₂
  have hp : F.map (wcFreeSheafMap U.left ι') ≫ q.hom = p.hom ≫ wcFreeSheafMap S ι := by
    show F.map (wcFreeSheafMap U.left ι') ≫ ((θ' V₂).hom ≫ (fr β₂).hom) =
      ((θ' V₁).hom ≫ (fr β₁).hom) ≫ wcFreeSheafMap S ι
    rw [hfr, hfr, ← Category.assoc, hθ' ι', Category.assoc, Category.assoc, ← F0, ← F0, h₁]
  have hq : F.map (wcFreeSheafMap U.left a') ≫ q.hom = q.hom ≫ wcFreeSheafMap S a := by
    show F.map (wcFreeSheafMap U.left a') ≫ ((θ' V₂).hom ≫ (fr β₂).hom) =
      ((θ' V₂).hom ≫ (fr β₂).hom) ≫ wcFreeSheafMap S a
    rw [hfr, ← Category.assoc, hθ' a', Category.assoc, Category.assoc, ← F0, ← F0, h₂]

  let κ : F.obj (Limits.cokernel (wcFreeSheafMap U.left ι')) ≅
      Limits.cokernel (wcFreeSheafMap S ι) :=
    Limits.PreservesCokernel.iso F (wcFreeSheafMap U.left ι') ≪≫
      Limits.cokernel.mapIso (F.map (wcFreeSheafMap U.left ι')) (wcFreeSheafMap S ι) p q hp
  have hκπ : F.map (Limits.cokernel.π (wcFreeSheafMap U.left ι')) ≫ κ.hom =
      q.hom ≫ Limits.cokernel.π (wcFreeSheafMap S ι) := by
    rw [Iso.trans_hom, ← Category.assoc, Limits.PreservesCokernel.π_iso_hom,
      Limits.cokernel.mapIso_hom]
    exact Limits.cokernel.π_desc _ _ _
  have hint : F.map Ψ' ≫ κ.hom = κ.hom ≫ Ψ := by
    haveI : Epi (F.map (Limits.cokernel.π (wcFreeSheafMap U.left ι'))) := inferInstance
    rw [← cancel_epi (F.map (Limits.cokernel.π (wcFreeSheafMap U.left ι')))]
    rw [← Functor.map_comp_assoc, hΨ', Functor.map_comp_assoc, hκπ, reassoc_of% hκπ,
      reassoc_of% hq, hΨ]

  have hE : ∀ (h : Limits.cokernel (wcFreeSheafMap U.left ι') ⟶
      Limits.cokernel (wcFreeSheafMap U.left ι'))
      (e : Abelian.Ext (F.obj (Limits.cokernel (wcFreeSheafMap U.left ι'))) (wcContSheaf S A) i),
      adj.extEquiv ((Abelian.Ext.mk₀ (F.map h)).comp e (zero_add i)) =
        (Abelian.Ext.mk₀ h).comp (adj.extEquiv e) (zero_add i) := by
    intro h e
    have hu : adj.unit.app (Limits.cokernel (wcFreeSheafMap U.left ι')) ≫ G.map (F.map h) =
        h ≫ adj.unit.app (Limits.cokernel (wcFreeSheafMap U.left ι')) := adj.unit_naturality h
    rw [Adjunction.extEquiv_apply, Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc]
    first
      | rw [hu, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
      | erw [hu, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
      | (simp only [hu]; rw [← Abelian.Ext.mk₀_comp_mk₀_assoc])
      | (refine (congrArg (fun m => (Abelian.Ext.mk₀ m).comp (Abelian.Ext.mapExactFunctor G e)
            (zero_add i)) hu).trans ?_
         exact (Abelian.Ext.mk₀_comp_mk₀_assoc _ _ _).symm)

  let E₀ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcContSheaf S A) i ≃+
      Abelian.Ext (F.obj (Limits.cokernel (wcFreeSheafMap U.left ι'))) (wcContSheaf S A) i :=
    { toFun := fun x => (Abelian.Ext.mk₀ κ.hom).comp x (zero_add i)
      invFun := fun y => (Abelian.Ext.mk₀ κ.inv).comp y (zero_add i)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
  refine ⟨(E₀.trans adj.extEquiv).toAddMonoidHom, (E₀.trans adj.extEquiv).bijective, ?_⟩
  intro z
  show adj.extEquiv ((Abelian.Ext.mk₀ κ.hom).comp ((Abelian.Ext.mk₀ Ψ).comp z (zero_add i))
      (zero_add i)) =
    (Abelian.Ext.mk₀ Ψ').comp (adj.extEquiv ((Abelian.Ext.mk₀ κ.hom).comp z (zero_add i)))
      (zero_add i)
  rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hint, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hE]

theorem wc_proet_free_bc_corepresents {Y Z : Scheme.{u}} (i : Z ⟶ Y) (V : Y.ProEt)
    (M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) :
    Function.Bijective (fun g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M =>
      ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
          (Functor.whiskerRight (yonedaMap (wcProEtBC i) V)
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft (wcProEtBC i).op (toSheafify (Scheme.ProEt.topology Z)
              (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :
          wcFreeSheaf Y V ⟶ (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V))) ≫
        (wcProEtPush i).map g) :=
by
  classical

  have freeof : ∀ {α β : Type (u+1)} (f : α ⟶ β) (a : α),
      (AddCommGrpCat.free.map f) (FreeAbelianGroup.of a) = FreeAbelianGroup.of (f a) := by
    intro α β f a
    rw [AddCommGrpCat.free_map_coe]
    rfl

  have PY : ∀ {C : Type (u+1)} [Category.{u} C] (T : C) (Q : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Function.Bijective
        (fun h : (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
          (h.app (Opposite.op T)) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
    intro C _ T Q
    have gen : ∀ (W : C) (f : W ⟶ T),
        ((yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f.op)
          (FreeAbelianGroup.of (ULift.up (𝟙 T))) = FreeAbelianGroup.of (ULift.up f) := by
      intro W f
      refine (freeof _ _).trans ?_
      show FreeAbelianGroup.of (ULift.up (f ≫ 𝟙 T)) = FreeAbelianGroup.of (ULift.up f)
      rw [Category.comp_id]
    have nat : ∀ (h : (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q)
        (W : C) (f : W ⟶ T),
        (h.app (Opposite.op W)) (FreeAbelianGroup.of (ULift.up f)) =
          (Q.map f.op) ((h.app (Opposite.op T)) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      intro h W f
      have e := NatTrans.naturality_apply h f.op (FreeAbelianGroup.of (ULift.up (𝟙 T)))
      refine Eq.trans ?_ e
      exact congrArg (fun z => (h.app (Opposite.op W)) z) (gen W f).symm
    constructor
    · intro h h' e
      apply NatTrans.ext
      funext W
      apply AddCommGrpCat.hom_ext
      refine FreeAbelianGroup.lift_ext (α := ULift.{u+1} (W.unop ⟶ T)) _ _ ?_
      intro x
      have h1 := nat h W.unop x.down
      have h2 := nat h' W.unop x.down
      have e2 : (h.app (Opposite.op T)) (FreeAbelianGroup.of (ULift.up (𝟙 T))) =
          (h'.app (Opposite.op T)) (FreeAbelianGroup.of (ULift.up (𝟙 T))) := e
      rw [e2] at h1
      exact h1.trans h2.symm
    · intro q
      refine ⟨{ app := fun W => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
                (fun x : ULift.{u+1} (W.unop ⟶ T) => (Q.map x.down.op) q))
                naturality := ?_ }, ?_⟩
      · intro W W' k
        apply AddCommGrpCat.hom_ext
        refine FreeAbelianGroup.lift_ext (α := ULift.{u+1} (W.unop ⟶ T)) _ _ ?_
        intro x
        show (FreeAbelianGroup.lift (fun y : ULift.{u+1} (W'.unop ⟶ T) => (Q.map y.down.op) q))
            ((AddCommGrpCat.free.map (uliftFunctor.{u+1, u}.map ((yoneda.obj T).map k)))
              (FreeAbelianGroup.of x)) =
          (Q.map k) ((FreeAbelianGroup.lift
            (fun y : ULift.{u+1} (W.unop ⟶ T) => (Q.map y.down.op) q)) (FreeAbelianGroup.of x))
        have hx := freeof (uliftFunctor.{u+1, u}.map ((yoneda.obj T).map k)) x
        refine Eq.trans (congrArg (FreeAbelianGroup.lift
          (fun y : ULift.{u+1} (W'.unop ⟶ T) => (Q.map y.down.op) q)) hx) ?_
        refine (FreeAbelianGroup.lift_apply_of _ _).trans ?_
        refine Eq.trans ?_ (congrArg (fun z => (Q.map k) z)
          (FreeAbelianGroup.lift_apply_of _ _).symm)
        show (Q.map (k.unop ≫ x.down).op) q = (Q.map k) ((Q.map x.down.op) q)
        rw [op_comp, CategoryTheory.Functor.map_comp]
        rfl
      · refine (FreeAbelianGroup.lift_apply_of _ _).trans ?_
        show (Q.map (𝟙 T).op) q = q
        rw [op_id, CategoryTheory.Functor.map_id]
        rfl

  have TH : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D) (V : C)
      (Q : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Function.Bijective
        (fun h : (yoneda.obj (G.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
          Functor.whiskerRight (yonedaMap G V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft G.op h) := by
    intro C D _ _ G V Q
    have key : ∀ h : (yoneda.obj (G.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q,
        ((Functor.whiskerRight (yonedaMap G V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft G.op h).app (Opposite.op V)) (FreeAbelianGroup.of (ULift.up (𝟙 V)))
          = (h.app (Opposite.op (G.obj V))) (FreeAbelianGroup.of (ULift.up (𝟙 (G.obj V)))) := by
      intro h
      change (h.app (Opposite.op (G.obj V))) ((AddCommGrpCat.free.map
        (uliftFunctor.{u+1, u}.map ((yonedaMap G V).app (Opposite.op V))))
          (FreeAbelianGroup.of (ULift.up (𝟙 V)))) = _
      refine congrArg (fun z => (h.app (Opposite.op (G.obj V))) z) ((freeof _ _).trans ?_)
      show FreeAbelianGroup.of (ULift.up (G.map (𝟙 V))) = FreeAbelianGroup.of (ULift.up (𝟙 (G.obj V)))
      rw [G.map_id]
    have hcomp := (Function.Bijective.of_comp_iff' (PY V (G.op ⋙ Q))
      (fun h : (yoneda.obj (G.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
          Functor.whiskerRight (yonedaMap G V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft G.op h))
    refine hcomp.mp ?_
    have hf : ((fun h : (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G.op ⋙ Q =>
          (h.app (Opposite.op V)) (FreeAbelianGroup.of (ULift.up (𝟙 V)))) ∘
        (fun h : (yoneda.obj (G.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
          Functor.whiskerRight (yonedaMap G V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft G.op h)) =
        (fun h : (yoneda.obj (G.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
          (h.app (Opposite.op (G.obj V))) (FreeAbelianGroup.of (ULift.up (𝟙 (G.obj V))))) := by
      funext h
      exact key h
    rw [hf]
    exact PY (G.obj V) Q

  have S2 : ∀ {P R : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}},
      Presheaf.IsSheaf (Scheme.ProEt.topology Y) R →
      Function.Bijective (fun α : P ⟶ R =>
        (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map α) := by
    intro P R hR
    have := isIso_toSheafify (Scheme.ProEt.topology Y) hR
    have nat : ∀ α : P ⟶ R, α ≫ toSheafify (Scheme.ProEt.topology Y) R =
        toSheafify (Scheme.ProEt.topology Y) P ≫
          ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map α).hom :=
      fun α => toSheafify_naturality (Scheme.ProEt.topology Y) α
    constructor
    · intro α α' e
      have e' : ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map α).hom =
          ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map α').hom :=
        congrArg (fun t => t.hom) e
      rw [← cancel_mono (toSheafify (Scheme.ProEt.topology Y) R), nat, nat, e']
    · intro f
      refine ⟨toSheafify (Scheme.ProEt.topology Y) P ≫ f.hom ≫
        inv (toSheafify (Scheme.ProEt.topology Y) R), ?_⟩
      apply Sheaf.hom_ext
      apply sheafify_hom_ext (Scheme.ProEt.topology Y) _ _
        ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj R).property
      rw [← nat]
      simp

  have hcont : (wcProEtBC i).IsContinuous (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) :=
    (wc_proet_pullback_continuous_flat i).1
  have hR : Presheaf.IsSheaf (Scheme.ProEt.topology Y) ((wcProEtBC i).op ⋙ M.obj) :=
    Functor.op_comp_isSheaf (wcProEtBC i) (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) M
  have hA := ((sheafificationAdjunction (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}).homEquiv
    (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) M).bijective
  have hT := TH (wcProEtBC i) V M.obj
  have hS := S2 (P := yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) hR
  have hall := hS.comp (hT.comp hA)
  have hfun : ∀ g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M,
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yonedaMap (wcProEtBC i) V)
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          Functor.whiskerLeft (wcProEtBC i).op
            ((sheafificationAdjunction (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}).homEquiv
              (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
              M g)) =
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yonedaMap (wcProEtBC i) V)
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          Functor.whiskerLeft (wcProEtBC i).op (toSheafify (Scheme.ProEt.topology Z)
            (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
        (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcProEtBC i).op g.hom) := by
    intro g
    have hAg : (sheafificationAdjunction (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) M g =
        toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          g.hom := by
      refine (Adjunction.homEquiv_unit _ _ _ _).trans ?_
      rw [sheafificationAdjunction_unit_app]
      rfl
    rw [hAg]
    have e1 : Functor.whiskerLeft (wcProEtBC i).op (toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          g.hom) =
        Functor.whiskerLeft (wcProEtBC i).op (toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
        Functor.whiskerLeft (wcProEtBC i).op g.hom :=
      Functor.whiskerLeft_comp _ _ _
    rw [e1]
    exact (congrArg (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
      (Category.assoc _ _ _).symm).trans (CategoryTheory.Functor.map_comp _ _ _)
  exact (congrArg Function.Bijective (funext hfun)).mp hall

theorem wc_proet_closed_free_bc_locally_surjective_of_ext {Y Z : Scheme.{u}} (i : Z ⟶ Y) (V : Y.ProEt)
    (hsieve : ∀ (W : Y.ProEt) [IsAffine W.left] (R : Sieve ((wcProEtBC i).obj W)),
      R ∈ Scheme.ProEt.topology Z ((wcProEtBC i).obj W) →
      Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
        IsAffine W'.left ∧ (IsEmpty ((wcProEtBC i).obj W').left ∨ R.arrows ((wcProEtBC i).map w))) ∈
        Scheme.ProEt.topology Y W)
    (hext : ∀ (W : Y.ProEt) [IsAffine W.left] (a : (wcProEtBC i).obj W ⟶ (wcProEtBC i).obj V),
      Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
        IsEmpty ((wcProEtBC i).obj W').left ∨
          ∃ b : W' ⟶ V, (wcProEtBC i).map b = (wcProEtBC i).map w ≫ a) ∈
        Scheme.ProEt.topology Y W) :
    Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
      (Functor.whiskerRight (yonedaMap (wcProEtBC i) V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcProEtBC i).op (toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
by
  classical
  have gen : ∀ (Φ : Y.ProEt ⥤ Z.ProEt),
      (∀ (W : Y.ProEt) [IsAffine W.left] (R : Sieve (Φ.obj W)),
        R ∈ Scheme.ProEt.topology Z (Φ.obj W) →
        Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
          IsAffine W'.left ∧ (IsEmpty (Φ.obj W').left ∨ R.arrows (Φ.map w))) ∈
          Scheme.ProEt.topology Y W) →
      (∀ (W : Y.ProEt) [IsAffine W.left] (a : Φ.obj W ⟶ Φ.obj V),
        Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
          IsEmpty (Φ.obj W').left ∨
            ∃ b : W' ⟶ V, Φ.map b = Φ.map w ≫ a) ∈
          Scheme.ProEt.topology Y W) →
      Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
        (Functor.whiskerRight (yonedaMap Φ V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          Functor.whiskerLeft Φ.op (toSheafify (Scheme.ProEt.topology Z)
            (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := by
    intro Φ hsieve hext

    have affine_local : ∀ (U : Y.ProEt) (R : Sieve U),
        (∀ (V : Y.ProEt) (f : V ⟶ U), IsAffine V.left → R.pullback f ∈ Scheme.ProEt.topology Y V) →
        R ∈ Scheme.ProEt.topology Y U := by
      intro U R hR
      have hU : WeaklyEtale U.hom := U.prop
      let W : U.left.affineCover.I₀ → Y.ProEt := fun j =>
        MorphismProperty.Over.mk ⊤ (U.left.affineCover.f j ≫ U.hom) inferInstance
      let e : ∀ j, W j ⟶ U := fun j =>
        MorphismProperty.Over.homMk (U.left.affineCover.f j) rfl trivial
      have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage Y).coverings U := by
        show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Y ⋙ Over.forget Y)
          Scheme.proetalePrecoverage).coverings U
        rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
        change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
        exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
          U.left.affineCover.mem₀.1,
          MorphismProperty.ofArrows_mem_precoverage.mpr (fun j => inferInstance)⟩
      refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) R ?_
      intro T f hf
      obtain ⟨T', h, g', hg', rfl⟩ := hf
      rcases hg' with ⟨j⟩
      rw [Sieve.pullback_comp]
      exact GrothendieckTopology.pullback_stable _ h
        (hR (W j) (e j) (show IsAffine (U.left.affineCover.X j) by infer_instance))

    have L3 : ∀ {F G : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (f : F ⟶ G) (U : Y.ProEt),
        Presheaf.imageSieve f (0 : G.obj (Opposite.op U)) ∈ Scheme.ProEt.topology Y U ∧
        (∀ s : G.obj (Opposite.op U), Presheaf.imageSieve f s ∈ Scheme.ProEt.topology Y U →
          Presheaf.imageSieve f (-s) ∈ Scheme.ProEt.topology Y U) ∧
        (∀ s t : G.obj (Opposite.op U), Presheaf.imageSieve f s ∈ Scheme.ProEt.topology Y U →
          Presheaf.imageSieve f t ∈ Scheme.ProEt.topology Y U →
          Presheaf.imageSieve f (s + t) ∈ Scheme.ProEt.topology Y U) ∧
        (∀ (V' : Y.ProEt) (g : V' ⟶ U) (s : G.obj (Opposite.op U)),
          Presheaf.imageSieve f (G.map g.op s) ≤ (Presheaf.imageSieve f s).pullback g) := by
      intro F G f U
      refine ⟨?_, ?_, ?_, ?_⟩
      · have h := Presheaf.imageSieve_app f (U := U) 0
        rw [map_zero] at h
        rw [h]
        exact GrothendieckTopology.top_mem _ _
      · intro s hs
        refine GrothendieckTopology.superset_covering _ ?_ hs
        intro W g hg
        obtain ⟨t, ht⟩ := hg
        exact ⟨-t, by simp only [map_neg, ht]⟩
      · intro s t hs ht
        refine GrothendieckTopology.superset_covering _ ?_
          (GrothendieckTopology.intersection_covering _ hs ht)
        intro W g hg
        obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hg
        exact ⟨a + b, by simp only [map_add, ha, hb]⟩
      · intro V' g s T h hh
        obtain ⟨t, ht⟩ := hh
        refine ⟨t, ht.trans ?_⟩
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

    have L2 : ∀ (T : Z.ProEt) [IsEmpty T.left]
        (x : (sheafify (Scheme.ProEt.topology Z)
          (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj
            (Opposite.op T)), x = 0 := by
      intro T _ x
      have h := (Sheaf.isTerminalOfBotCover
        ((presheafToSheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) T
        (Scheme.ProEt.bot_mem_topology T)).isZero
      exact @Subsingleton.elim _ (AddCommGrpCat.subsingleton_of_isZero h) x 0

    have L4 : ∀ (W : Y.ProEt) [IsAffine W.left] (a : Φ.obj W ⟶ Φ.obj V),
        Presheaf.imageSieve
          (Functor.whiskerRight (yonedaMap Φ V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft Φ.op (toSheafify (Scheme.ProEt.topology Z)
              (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
          ((toSheafify (Scheme.ProEt.topology Z)
              (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op (Φ.obj W)) (FreeAbelianGroup.of (ULift.up a))) ∈
          Scheme.ProEt.topology Y W := by
      intro W _ a
      refine GrothendieckTopology.superset_covering _ ?_ (hext W a)
      rw [Sieve.generate_le_iff]
      intro W'' w'' hw
      rcases hw with hE | ⟨b, hb⟩
      · haveI := hE
        refine ⟨0, ?_⟩
        rw [map_zero]
        exact (L2 (Φ.obj W'') _).symm
      · refine ⟨FreeAbelianGroup.of (ULift.up b), ?_⟩
        show (toSheafify (Scheme.ProEt.topology Z)
            (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
              (Opposite.op (Φ.obj W'')) (FreeAbelianGroup.of (ULift.up (Φ.map b))) =
          (sheafify (Scheme.ProEt.topology Z)
            (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).map
              (Φ.map w'').op
            ((toSheafify (Scheme.ProEt.topology Z)
              (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op (Φ.obj W)) (FreeAbelianGroup.of (ULift.up a)))
        have hn := NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology Z)
            (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) (Φ.map w'').op
          (FreeAbelianGroup.of (ULift.up a))
        have e1 := congrArg (fun m : Φ.obj W'' ⟶ Φ.obj V =>
          (toSheafify (Scheme.ProEt.topology Z)
            (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
              (Opposite.op (Φ.obj W'')) (FreeAbelianGroup.of (ULift.up m))) hb
        exact e1.trans hn

    haveI hσ : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Z)
        (toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have main : ∀ (W : Y.ProEt), IsAffine W.left →
        ∀ s : (Φ.op ⋙ sheafify (Scheme.ProEt.topology Z)
          (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj (Opposite.op W),
        Presheaf.imageSieve
          (Functor.whiskerRight (yonedaMap Φ V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft Φ.op (toSheafify (Scheme.ProEt.topology Z)
              (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) s ∈
          Scheme.ProEt.topology Y W := by
      intro W hW s
      haveI := hW
      have hR := Presheaf.imageSieve_mem (Scheme.ProEt.topology Z)
        (toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        (U := Opposite.op (Φ.obj W)) s
      refine GrothendieckTopology.transitive _ (hsieve W _ hR) _ ?_
      intro W' f hf
      obtain ⟨W₁, h, w, hgen, rfl⟩ := hf
      rw [Sieve.pullback_comp]
      apply GrothendieckTopology.pullback_stable _ h
      refine GrothendieckTopology.superset_covering _ ((L3 _ W).2.2.2 W₁ w s) ?_
      obtain ⟨hA, hE | ⟨x, hx⟩⟩ := hgen
      · haveI := hE
        have h0 : (Φ.op ⋙ sheafify (Scheme.ProEt.topology Z)
            (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).map w.op s = 0 :=
          L2 (Φ.obj W₁) _
        rw [h0]
        exact (L3 _ W₁).1
      · haveI := hA
        have h1 : (Φ.op ⋙ sheafify (Scheme.ProEt.topology Z)
            (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).map w.op s =
            (toSheafify (Scheme.ProEt.topology Z)
              (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op (Φ.obj W₁)) x := hx.symm
        rw [h1]
        clear h1 hx
        obtain ⟨φ, hφ⟩ : ∃ φ : FreeAbelianGroup (ULift.{u+1} (Φ.obj W₁ ⟶ Φ.obj V)) →+ _,
            φ = ConcreteCategory.hom ((toSheafify (Scheme.ProEt.topology Z)
              (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op (Φ.obj W₁))) := ⟨_, rfl⟩
        have key : ∀ y : FreeAbelianGroup (ULift.{u+1} (Φ.obj W₁ ⟶ Φ.obj V)),
            Presheaf.imageSieve
              (Functor.whiskerRight (yonedaMap Φ V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
                Functor.whiskerLeft Φ.op (toSheafify (Scheme.ProEt.topology Z)
                  (yoneda.obj (Φ.obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
              (U := W₁) (φ y) ∈ Scheme.ProEt.topology Y W₁ := by
          intro y
          induction y using FreeAbelianGroup.induction_on with
          | zero => rw [map_zero]; exact (L3 _ W₁).1
          | of a => rw [hφ]; exact L4 W₁ a.down
          | neg a ih => rw [map_neg]; exact (L3 _ W₁).2.1 _ ih
          | add x y ihx ihy => rw [map_add]; exact (L3 _ W₁).2.2.1 _ _ ihx ihy
        have := key x
        rw [hφ] at this
        exact this

    apply Presheaf.IsLocallySurjective.mk
    intro U s
    apply affine_local U
    intro W f hW
    exact GrothendieckTopology.superset_covering _ ((L3 _ U).2.2.2 W f s) (main W hW _)
  exact gen (wcProEtBC i) hsieve hext

theorem wc_proet_closed_sieve_extension_affine {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (W : Y.ProEt) [IsAffine W.left]
    (R : Sieve ((wcProEtBC i).obj W)) (hR : R ∈ Scheme.ProEt.topology Z ((wcProEtBC i).obj W)) :
    Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
      IsAffine W'.left ∧ (IsEmpty ((wcProEtBC i).obj W').left ∨ R.arrows ((wcProEtBC i).map w))) ∈
      Scheme.ProEt.topology Y W :=
by
  classical

  have lift : ∀ (U : Y.ProEt) (_ : IsAffine U.left) (V' : Z.ProEt)
      (g' : V' ⟶ (wcProEtBC i).obj U) (_ : IsAffine V'.left),
      ∃ (W' : Y.ProEt) (w : W' ⟶ U) (a : (wcProEtBC i).obj W' ⟶ V'),
        IsAffine W'.left ∧ a ≫ g' = (wcProEtBC i).map w ∧ Surjective a.left := by
    intro U hU V' g' hV'
    haveI := hU
    haveI hV'i : IsAffine V'.left := hV'
    have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      intro R' S' _ _ _ hW
      have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff]
        exact hW.flat
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
        exact hW.flat_lmul'
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
        rw [diagonal_SpecMap]
        infer_instance
      exact ⟨hfl, hd⟩
    have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
      intro R' S' _ _ _ hW
      have hfl : Module.Flat R' S' := by
        have := hW.flat
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff] at this
        exact this
      have hd := hW.flat_diagonal
      rw [diagonal_SpecMap] at hd
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
              (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [e]
        haveI := hd
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
      exact Algebra.WeaklyEtale.mk hfl hmu
    have appTopWE : ∀ {X Z : Scheme.{u}} [IsAffine X] [IsAffine Z] (h : X ⟶ Z), WeaklyEtale h →
        WeaklyEtale (Spec.map h.appTop) := by
      intro X Z _ _ h hh
      have e : Spec.map h.appTop = X.isoSpec.inv ≫ h ≫ Z.isoSpec.hom := by
        rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
      rw [e]
      infer_instance
    haveI hUaff' : IsAffine ((𝟭 Scheme.{u}).obj U.left) := inferInstanceAs (IsAffine U.left)
    haveI hjci : IsClosedImmersion (Limits.pullback.fst U.hom i) := inferInstance
    obtain ⟨hZaff, hjsurj⟩ :=
      IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst U.hom i)
    haveI := hZaff
    obtain ⟨g0, hg0def⟩ : ∃ g0 : V'.left ⟶ Limits.pullback U.hom i, g0 = g'.left := ⟨_, rfl⟩
    have hw0 : g0 ≫ Limits.pullback.snd U.hom i = V'.hom := by
      rw [hg0def]; exact MorphismProperty.Over.w g'
    have hg0 : WeaklyEtale g0 := by
      have h1 : WeaklyEtale (g0 ≫ Limits.pullback.snd U.hom i) := by
        rw [hw0]; exact V'.prop
      have h2 : WeaklyEtale (Limits.pullback.snd U.hom i) := ((wcProEtBC i).obj U).prop
      exact @WeaklyEtale.of_comp _ _ _ g0 _ h1 h2
    letI alg1 : Algebra Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) :=
      (Limits.pullback.fst U.hom i).appTop.hom.toAlgebra
    letI alg2 : Algebra Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) := g0.appTop.hom.toAlgebra
    have hπ : Function.Surjective (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)) := hjsurj
    have hW : Algebra.WeaklyEtale Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) :=
      toRing _ _ (appTopWE g0 hg0)
    obtain ⟨C, _, _, β, hC, hβ, hsurj⟩ :=
      wcl_weaklyEtale_lift_tensor_surj Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) hπ hW
    haveI := toSch _ _ hC
    haveI := U.prop
    obtain ⟨p, hpdef⟩ : ∃ p : Spec (CommRingCat.of C) ⟶ U.left,
        p = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) ≫ U.left.isoSpec.inv :=
      ⟨_, rfl⟩
    haveI hpwe : WeaklyEtale p := by rw [hpdef]; infer_instance
    have hp : p ≫ U.left.isoSpec.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hpdef, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback (p ≫ U.hom) i ⟶ Limits.pullback U.hom i,
        m = ((wcProEtBC i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U)).left :=
      ⟨_, rfl⟩
    have hsq : m ≫ Limits.pullback.fst U.hom i = Limits.pullback.fst (p ≫ U.hom) i ≫ p := by
      rw [hmdef]
      exact Limits.pullback.lift_fst _ _ _
    have hmsnd : m ≫ Limits.pullback.snd U.hom i = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [hmdef]
      exact MorphismProperty.Over.w ((wcProEtBC i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U))
    have eq₁ : p ≫ U.left.isoSpec.hom =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hp, Category.id_comp]
    have eq₂ : Limits.pullback.fst U.hom i ≫ U.left.isoSpec.hom =
        (Limits.pullback U.hom i).isoSpec.hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))) := by
      have hnat := Scheme.isoSpec_hom_naturality (Limits.pullback.fst U.hom i)
      exact hnat.symm
    obtain ⟨M, hMdef⟩ : ∃ M : Limits.pullback p (Limits.pullback.fst U.hom i) ⟶
        Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))),
        M = Limits.pullback.map p (Limits.pullback.fst U.hom i)
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))))
          (𝟙 _) (Limits.pullback U.hom i).isoSpec.hom U.left.isoSpec.hom eq₁ eq₂ := ⟨_, rfl⟩
    haveI hMiso : IsIso M := by
      rw [hMdef]
      infer_instance
    have hMsnd : M ≫ Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      rw [hMdef]
      exact Limits.pullback.lift_snd _ _ _
    let e₁ := asIso M ≪≫ pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)
    have he₁ : e₁.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show (M ≫ (pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).hom) ≫ _ = _
      rw [Category.assoc]
      refine (congrArg (fun k => M ≫ k)
        (pullbackSpecIso_hom_snd Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤))).trans ?_
      exact hMsnd
    have hRR : (Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) = m := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_fst, hsq]
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_snd, hmsnd]
    let e := (Limits.pullbackRightPullbackFstIso U.hom i p).symm ≪≫ e₁
    have he : e.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        m ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show ((Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫ e₁.hom) ≫ _ = _
      rw [Category.assoc, he₁, ← Category.assoc, hRR]
    obtain ⟨βc, hβc⟩ : ∃ βc : Γ(V'.left, ⊤) ⟶
        CommRingCat.of (TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)),
        βc.hom = β := ⟨CommRingCat.ofHom β, rfl⟩
    subst hβc
    obtain ⟨a₀, ha₀def⟩ : ∃ a₀ : Limits.pullback (p ≫ U.hom) i ⟶ V'.left,
        a₀ = e.hom ≫ Spec.map βc ≫ V'.left.isoSpec.inv := ⟨_, rfl⟩
    have h8a : a₀ ≫ g0 = m := by
      rw [← cancel_mono (Limits.pullback U.hom i).isoSpec.hom, ha₀def]
      simp only [Category.assoc]
      rw [← Scheme.isoSpec_hom_naturality g0, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← he]
      refine congrArg (fun k => e.hom ≫ Spec.map k) ?_
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact hβ
    have h8b : a₀ ≫ V'.hom = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [← hw0, ← Category.assoc, h8a, hmsnd]
    have ha₀s : Surjective a₀ := by
      constructor
      intro v
      obtain ⟨P, hP⟩ := hsurj (V'.left.isoSpec.hom v)
      refine ⟨e.inv P, ?_⟩
      have h1 : (Spec.map βc) P = V'.left.isoSpec.hom v := hP
      have h2 : e.hom (e.inv P) = P := Scheme.inv_hom_apply e P
      have h3 : a₀ (e.inv P) = V'.left.isoSpec.inv ((Spec.map βc) (e.hom (e.inv P))) := by
        rw [ha₀def, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact h3.trans ((congrArg (fun z => V'.left.isoSpec.inv ((Spec.map βc) z)) h2).trans
        ((congrArg V'.left.isoSpec.inv h1).trans (Scheme.hom_inv_apply _ _)))
    refine ⟨Scheme.ProEt.mk (p ≫ U.hom),
      (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U),
      MorphismProperty.Over.homMk a₀ h8b trivial, ?_, ?_, ha₀s⟩
    · show IsAffine (Spec (CommRingCat.of C))
      infer_instance
    · apply MorphismProperty.Over.Hom.ext
      show a₀ ≫ g'.left = _
      rw [← hg0def]
      exact h8a.trans hmdef

  haveI hWaff' : IsAffine ((𝟭 Scheme.{u}).obj W.left) := inferInstanceAs (IsAffine W.left)
  obtain ⟨hZW, -⟩ :=
    IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst W.hom i)
  have hBCaff : IsAffine ((wcProEtBC i).obj W).left := hZW

  obtain ⟨n, Q, r, hRr, hQ, hsurj⟩ :=
    wc_proet_affine_sieve_finite_jointly_surjective Z ((wcProEtBC i).obj W) hBCaff R hR

  choose Wk wk ak hWk hfac hsa using fun k => lift W inferInstance (Q k) (r k) (hQ k)

  obtain ⟨m, B, b, hB, hE, hcovB⟩ := wc_closed_compl_proet_finite_cover i W

  have hgen : ∀ (W' : Y.ProEt) (w : W' ⟶ W), IsAffine W'.left →
      (IsEmpty ((wcProEtBC i).obj W').left ∨ R.arrows ((wcProEtBC i).map w)) →
      (Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
        IsAffine W'.left ∧ (IsEmpty ((wcProEtBC i).obj W').left ∨
          R.arrows ((wcProEtBC i).map w)))).arrows w := by
    intro W' w h1 h2
    exact ⟨W', 𝟙 W', w, ⟨h1, h2⟩, Category.id_comp w⟩
  have hTwk : ∀ k, R.arrows ((wcProEtBC i).map (wk k)) := by
    intro k
    rw [← hfac k]
    exact R.downward_closed (hRr k) (ak k)

  have hpt : ∀ (W' : Y.ProEt) (f : W' ⟶ W) (p : ((wcProEtBC i).obj W').left),
      f.left (Limits.pullback.fst W'.hom i p) =
        Limits.pullback.fst W.hom i (((wcProEtBC i).map f).left p) := by
    intro W' f p
    have hsq : ((wcProEtBC i).map f).left ≫ Limits.pullback.fst W.hom i =
        Limits.pullback.fst W'.hom i ≫ f.left := Limits.pullback.lift_fst _ _ _
    have e1 := Scheme.Hom.comp_apply (Limits.pullback.fst W'.hom i) f.left p
    have e2 := Scheme.Hom.comp_apply ((wcProEtBC i).map f).left (Limits.pullback.fst W.hom i) p
    exact e1.symm.trans ((congrArg (fun g => g p) hsq.symm).trans e2)

  have hcov : ∀ y : W.left, (∃ k, y ∈ Set.range (wk k).left) ∨
      (∃ l, y ∈ Set.range (b l).left) := by
    intro y
    by_cases hy : y ∈ Set.range (Limits.pullback.fst W.hom i)
    · obtain ⟨z, rfl⟩ := hy
      obtain ⟨k, q, hq⟩ := hsurj z
      obtain ⟨p, hp⟩ := (hsa k).surj q
      have hp' : (ak k).left p = q := hp
      have hz : ((wcProEtBC i).map (wk k)).left p = z := by
        rw [← hfac k]
        show ((ak k).left ≫ (r k).left) p = z
        rw [Scheme.Hom.comp_apply, hp', hq]
      left
      refine ⟨k, Limits.pullback.fst (Wk k).hom i p, ?_⟩
      rw [hpt, hz]
    · right
      exact hcovB y hy

  obtain ⟨e, -⟩ : ∃ e : Fin n ⊕ Fin m ≃ Fin (n + m), True := ⟨finSumFinEquiv, trivial⟩
  refine GrothendieckTopology.superset_covering _ ?_
    (proet_finite_affine_jointly_surjective_covers Y W (n + m)
      (fun j => Sum.elim Wk B (e.symm j))
      (fun j => Sum.rec (motive := fun s => Sum.elim Wk B s ⟶ W) wk b (e.symm j)) ?_ ?_)
  · rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    generalize e.symm j = s
    rcases s with k | l
    · exact hgen _ (wk k) (hWk k) (Or.inr (hTwk k))
    · exact hgen _ (b l) (hB l) (Or.inl (hE l))
  · intro j
    generalize e.symm j = s
    rcases s with k | l
    · exact hWk k
    · exact hB l
  · intro x
    have h3 : ∃ s : Fin n ⊕ Fin m,
        x ∈ Set.range (Sum.rec (motive := fun s => Sum.elim Wk B s ⟶ W) wk b s).left := by
      rcases hcov x with ⟨k, hk⟩ | ⟨l, hl⟩
      · exact ⟨Sum.inl k, hk⟩
      · exact ⟨Sum.inr l, hl⟩
    obtain ⟨s, hs⟩ := h3
    refine ⟨e s, ?_⟩
    first
      | (rw [Equiv.symm_apply_apply]; exact hs)
      | (simp only [Equiv.symm_apply_apply]; exact hs)

theorem wc_proet_closed_map_local_extension {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (W V : Y.ProEt) [IsAffine W.left]
    (a : (wcProEtBC i).obj W ⟶ (wcProEtBC i).obj V) :
    Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
      IsEmpty ((wcProEtBC i).obj W').left ∨
        ∃ b : W' ⟶ V, (wcProEtBC i).map b = (wcProEtBC i).map w ≫ a) ∈
      Scheme.ProEt.topology Y W :=
by
  classical
  have c5 : ∀ (U : Y.ProEt) (hU : IsAffine U.left) (V' : Z.ProEt)
      (g' : V' ⟶ (wcProEtBC i).obj U) (hV' : IsAffine V'.left),
      ∃ (W₁ : Y.ProEt) (w : W₁ ⟶ U) (a' : (wcProEtBC i).obj W₁ ⟶ V'),
        IsAffine W₁.left ∧ a' ≫ g' = (wcProEtBC i).map w ∧ Surjective a'.left := by
    intro U hU V' g' hV'
    haveI hUi : IsAffine U.left := hU
    haveI hV'i : IsAffine V'.left := hV'
    have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      intro R' S' _ _ _ hW
      have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff]
        exact hW.flat
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
        exact hW.flat_lmul'
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
        rw [diagonal_SpecMap]
        infer_instance
      exact ⟨hfl, hd⟩
    have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
      intro R' S' _ _ _ hW
      have hfl : Module.Flat R' S' := by
        have := hW.flat
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff] at this
        exact this
      have hd := hW.flat_diagonal
      rw [diagonal_SpecMap] at hd
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
              (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [e]
        haveI := hd
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
      exact Algebra.WeaklyEtale.mk hfl hmu
    have appTopWE : ∀ {X Z : Scheme.{u}} [IsAffine X] [IsAffine Z] (h : X ⟶ Z), WeaklyEtale h →
        WeaklyEtale (Spec.map h.appTop) := by
      intro X Z _ _ h hh
      have e : Spec.map h.appTop = X.isoSpec.inv ≫ h ≫ Z.isoSpec.hom := by
        rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
      rw [e]
      infer_instance
    haveI hUaff' : IsAffine ((𝟭 Scheme.{u}).obj U.left) := inferInstanceAs (IsAffine U.left)
    haveI hjci : IsClosedImmersion (Limits.pullback.fst U.hom i) := inferInstance
    obtain ⟨hZaff, hjsurj⟩ :=
      IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst U.hom i)
    haveI := hZaff
    obtain ⟨g0, hg0def⟩ : ∃ g0 : V'.left ⟶ Limits.pullback U.hom i, g0 = g'.left := ⟨_, rfl⟩
    have hw0 : g0 ≫ Limits.pullback.snd U.hom i = V'.hom := by
      rw [hg0def]; exact MorphismProperty.Over.w g'
    have hg0 : WeaklyEtale g0 := by
      have h1 : WeaklyEtale (g0 ≫ Limits.pullback.snd U.hom i) := by
        rw [hw0]; exact V'.prop
      have h2 : WeaklyEtale (Limits.pullback.snd U.hom i) := ((wcProEtBC i).obj U).prop
      exact @WeaklyEtale.of_comp _ _ _ g0 _ h1 h2
    letI alg1 : Algebra Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) :=
      (Limits.pullback.fst U.hom i).appTop.hom.toAlgebra
    letI alg2 : Algebra Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) := g0.appTop.hom.toAlgebra
    have hπ : Function.Surjective (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)) := hjsurj
    have hW : Algebra.WeaklyEtale Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) :=
      toRing _ _ (appTopWE g0 hg0)
    obtain ⟨C, _, _, β, hC, hβ, hsurj⟩ :=
      wcl_weaklyEtale_lift_tensor_surj Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) hπ hW
    haveI := toSch _ _ hC
    haveI := U.prop
    obtain ⟨p, hpdef⟩ : ∃ p : Spec (CommRingCat.of C) ⟶ U.left,
        p = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) ≫ U.left.isoSpec.inv :=
      ⟨_, rfl⟩
    haveI hpwe : WeaklyEtale p := by rw [hpdef]; infer_instance
    have hp : p ≫ U.left.isoSpec.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hpdef, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback (p ≫ U.hom) i ⟶ Limits.pullback U.hom i,
        m = ((wcProEtBC i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U)).left :=
      ⟨_, rfl⟩
    have hsq : m ≫ Limits.pullback.fst U.hom i = Limits.pullback.fst (p ≫ U.hom) i ≫ p := by
      rw [hmdef]
      exact Limits.pullback.lift_fst _ _ _
    have hmsnd : m ≫ Limits.pullback.snd U.hom i = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [hmdef]
      exact MorphismProperty.Over.w ((wcProEtBC i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U))
    have eq₁ : p ≫ U.left.isoSpec.hom =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hp, Category.id_comp]
    have eq₂ : Limits.pullback.fst U.hom i ≫ U.left.isoSpec.hom =
        (Limits.pullback U.hom i).isoSpec.hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))) := by
      have hnat := Scheme.isoSpec_hom_naturality (Limits.pullback.fst U.hom i)
      exact hnat.symm
    obtain ⟨M, hMdef⟩ : ∃ M : Limits.pullback p (Limits.pullback.fst U.hom i) ⟶
        Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))),
        M = Limits.pullback.map p (Limits.pullback.fst U.hom i)
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))))
          (𝟙 _) (Limits.pullback U.hom i).isoSpec.hom U.left.isoSpec.hom eq₁ eq₂ := ⟨_, rfl⟩
    haveI hMiso : IsIso M := by
      rw [hMdef]
      infer_instance
    have hMsnd : M ≫ Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      rw [hMdef]
      exact Limits.pullback.lift_snd _ _ _
    let e₁ := asIso M ≪≫ pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)
    have he₁ : e₁.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show (M ≫ (pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).hom) ≫ _ = _
      rw [Category.assoc]
      refine (congrArg (fun k => M ≫ k)
        (pullbackSpecIso_hom_snd Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤))).trans ?_
      exact hMsnd
    have hR : (Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) = m := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_fst, hsq]
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_snd, hmsnd]
    let e := (Limits.pullbackRightPullbackFstIso U.hom i p).symm ≪≫ e₁
    have he : e.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        m ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show ((Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫ e₁.hom) ≫ _ = _
      rw [Category.assoc, he₁, ← Category.assoc, hR]
    obtain ⟨βc, hβc⟩ : ∃ βc : Γ(V'.left, ⊤) ⟶
        CommRingCat.of (TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)),
        βc.hom = β := ⟨CommRingCat.ofHom β, rfl⟩
    subst hβc
    obtain ⟨a₀, ha₀def⟩ : ∃ a₀ : Limits.pullback (p ≫ U.hom) i ⟶ V'.left,
        a₀ = e.hom ≫ Spec.map βc ≫ V'.left.isoSpec.inv := ⟨_, rfl⟩
    have h8a : a₀ ≫ g0 = m := by
      rw [← cancel_mono (Limits.pullback U.hom i).isoSpec.hom, ha₀def]
      simp only [Category.assoc]
      rw [← Scheme.isoSpec_hom_naturality g0, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← he]
      refine congrArg (fun k => e.hom ≫ Spec.map k) ?_
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact hβ
    have h8b : a₀ ≫ V'.hom = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [← hw0, ← Category.assoc, h8a, hmsnd]
    have ha₀s : Surjective a₀ := by
      constructor
      intro v
      obtain ⟨P, hP⟩ := hsurj (V'.left.isoSpec.hom v)
      refine ⟨e.inv P, ?_⟩
      have h1 : (Spec.map βc) P = V'.left.isoSpec.hom v := hP
      have h2 : e.hom (e.inv P) = P := Scheme.inv_hom_apply e P
      have h3 : a₀ (e.inv P) = V'.left.isoSpec.inv ((Spec.map βc) (e.hom (e.inv P))) := by
        rw [ha₀def, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact h3.trans ((congrArg (fun z => V'.left.isoSpec.inv ((Spec.map βc) z)) h2).trans
        ((congrArg V'.left.isoSpec.inv h1).trans (Scheme.hom_inv_apply _ _)))
    rw [hg0def, hmdef] at h8a
    refine ⟨Scheme.ProEt.mk (p ≫ U.hom), MorphismProperty.Over.homMk p rfl trivial,
      MorphismProperty.Over.homMk a₀ h8b trivial, ?_, MorphismProperty.Over.Hom.ext h8a, ha₀s⟩
    show IsAffine (Spec (CommRingCat.of C))
    infer_instance
  generalize hT : Sieve.generate (fun (W' : Y.ProEt) (w : W' ⟶ W) =>
      IsEmpty ((wcProEtBC i).obj W').left ∨
        ∃ b : W' ⟶ V, (wcProEtBC i).map b = (wcProEtBC i).map w ≫ a) = T
  have hTe : ∀ (W' : Y.ProEt) (w : W' ⟶ W), IsEmpty ((wcProEtBC i).obj W').left → T.arrows w := by
    intro W' w h
    rw [← hT]
    exact ⟨W', 𝟙 _, w, Or.inl h, Category.id_comp _⟩
  have hTb : ∀ (W' : Y.ProEt) (w : W' ⟶ W) (b : W' ⟶ V),
      (wcProEtBC i).map b = (wcProEtBC i).map w ≫ a → T.arrows w := by
    intro W' w b hb
    rw [← hT]
    exact ⟨W', 𝟙 _, w, Or.inr ⟨b, hb⟩, Category.id_comp _⟩

  have BCm : ∀ {X X' : Y.ProEt} (f : X ⟶ X'),
      ∃ M : Limits.pullback X.hom i ⟶ Limits.pullback X'.hom i,
        M = ((wcProEtBC i).map f).left ∧
        M ≫ Limits.pullback.fst X'.hom i = Limits.pullback.fst X.hom i ≫ f.left ∧
        M ≫ Limits.pullback.snd X'.hom i = Limits.pullback.snd X.hom i :=
    fun f => ⟨_, rfl, Limits.pullback.lift_fst _ _ _, MorphismProperty.Over.w ((wcProEtBC i).map f)⟩

  have pt : ∀ {A B C D' E : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (m : A ⟶ C) (h : C ⟶ E)
      (p : A ⟶ D') (k : D' ⟶ E), f ≫ g = m → m ≫ h = p ≫ k → ∀ x, h (g (f x)) = k (p x) := by
    intro A B C D' E f g m h p k h1 h2 x
    have e : f ≫ g ≫ h = p ≫ k := by rw [← Category.assoc, h1, h2]
    have := congrArg (fun φ : A ⟶ E => φ x) e
    first
      | exact this
      | simpa only [Scheme.Hom.comp_apply] using this
      | simpa using this

  obtain ⟨al, hal, ha⟩ : ∃ al : Limits.pullback W.hom i ⟶ Limits.pullback V.hom i,
      al = a.left ∧ al ≫ Limits.pullback.snd V.hom i = Limits.pullback.snd W.hom i :=
    ⟨_, rfl, MorphismProperty.Over.w a⟩

  have Lcover : ∀ (n : ℕ) (W' : Fin n → Y.ProEt) (w : ∀ k, W' k ⟶ W),
      (∀ k, IsAffine (W' k).left) → (∀ k, T.arrows (w k)) →
      (∀ y : W.left, y ∈ Set.range (Limits.pullback.fst W.hom i) →
        ∃ k, y ∈ Set.range (w k).left) →
      T ∈ Scheme.ProEt.topology Y W := by
    intro n W' w hW' hw hZ
    obtain ⟨m, B, g, hBa, hBe, hBc⟩ := wc_closed_compl_proet_finite_cover i W
    let E : Fin (n + m) → Σ X : Y.ProEt, (X ⟶ W) :=
      Fin.append (fun k => (⟨W' k, w k⟩ : Σ X : Y.ProEt, (X ⟶ W)))
        (fun l => (⟨B l, g l⟩ : Σ X : Y.ProEt, (X ⟶ W)))
    have hEl : ∀ k, E (Fin.castAdd m k) = ⟨W' k, w k⟩ := fun k => Fin.append_left _ _ k
    have hEr : ∀ l, E (Fin.natAdd n l) = ⟨B l, g l⟩ := fun l => Fin.append_right _ _ l
    have hgood : ∀ k, IsAffine (E k).1.left ∧ T.arrows (E k).2 := by
      intro k
      induction k using Fin.addCases with
      | left k => rw [hEl]; exact ⟨hW' k, hw k⟩
      | right l => rw [hEr]; exact ⟨hBa l, hTe _ _ (hBe l)⟩
    have key := proet_finite_affine_jointly_surjective_covers Y W (n + m) (fun k => (E k).1)
      (fun k => (E k).2) (fun k => (hgood k).1) ?_
    · refine GrothendieckTopology.superset_covering _ ?_ key
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨k⟩
      exact (hgood k).2
    · intro y
      by_cases hy : y ∈ Set.range (Limits.pullback.fst W.hom i)
      · obtain ⟨k, hk⟩ := hZ y hy
        refine ⟨Fin.castAdd m k, ?_⟩
        show y ∈ Set.range (E (Fin.castAdd m k)).2.left
        rw [hEl]
        exact hk
      · obtain ⟨l, hl⟩ := hBc y hy
        refine ⟨Fin.natAdd n l, ?_⟩
        show y ∈ Set.range (E (Fin.natAdd n l)).2.left
        rw [hEr]
        exact hl

  have Lchart : ∀ {X P : Scheme.{u}} [CompactSpace X] (σ : X ⟶ P),
      ∃ (n : ℕ) (D : Fin n → X.Opens) (O : Fin n → P.Opens),
        (∀ k, IsAffineOpen (D k)) ∧ (∀ k, IsAffineOpen (O k)) ∧ (∀ k, D k ≤ σ ⁻¹ᵁ O k) ∧
        ∀ x : X, ∃ k, x ∈ D k := by
    intro X P _ σ
    have hO : ∀ x : X, ∃ O : P.Opens, IsAffineOpen O ∧ σ x ∈ O := by
      intro x
      obtain ⟨O, hO, hxO, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Scheme.isBasis_affineOpens P)) (TopologicalSpace.Opens.mem_top (σ x))
      exact ⟨O, hO, hxO⟩
    choose O hOa hxO using hO
    have hD : ∀ x : X, ∃ D : X.Opens, IsAffineOpen D ∧ x ∈ D ∧ D ≤ σ ⁻¹ᵁ O x := by
      intro x
      obtain ⟨D, hD, hxD, hDle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Scheme.isBasis_affineOpens X)) (show x ∈ σ ⁻¹ᵁ O x from hxO x)
      exact ⟨D, hD, hxD, hDle⟩
    choose D hDa hxD hDle using hD
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (D x : Set X))
      (fun x => (D x).isOpen.mem_nhds (hxD x))
    refine ⟨t.card, fun k => D (t.equivFin.symm k).1, fun k => O (t.equivFin.symm k).1,
      fun k => hDa _, fun k => hOa _, fun k => hDle _, ?_⟩
    intro x
    have hx : x ∈ ⋃ y ∈ t, (D y : Set X) := by rw [ht]; trivial
    simp only [Set.mem_iUnion] at hx
    obtain ⟨y, hyt, hxy⟩ := hx
    refine ⟨t.equivFin ⟨y, hyt⟩, ?_⟩
    show x ∈ D (t.equivFin.symm (t.equivFin ⟨y, hyt⟩)).1
    rw [Equiv.symm_apply_apply]
    exact hxy

  have Lgraph : ∀ (Q : Z.ProEt) (r : Q ⟶ (wcProEtBC i).obj W)
      (rl : Q.left ⟶ Limits.pullback W.hom i) (hrl : rl = r.left)
      (O : (Limits.pullback W.hom V.hom).Opens) (hO : IsAffineOpen O) (τ : Q.left ⟶ O)
      (h₁ : τ ≫ O.ι ≫ Limits.pullback.fst W.hom V.hom = rl ≫ Limits.pullback.fst W.hom i)
      (h₂ : τ ≫ O.ι ≫ Limits.pullback.snd W.hom V.hom =
        rl ≫ al ≫ Limits.pullback.fst V.hom i),
      ∃ (U : Y.ProEt) (pU : U ⟶ W) (qU : U ⟶ V) (s : Q ⟶ (wcProEtBC i).obj U),
        IsAffine U.left ∧ s ≫ (wcProEtBC i).map pU = r ∧ s ≫ (wcProEtBC i).map qU = r ≫ a := by
    intro Q r rl hrl O hO τ h₁ h₂
    haveI := W.prop
    haveI := V.prop
    have hr : rl ≫ Limits.pullback.snd W.hom i = Q.hom := by
      subst hrl
      exact MorphismProperty.Over.w r
    have hstar : τ ≫ O.ι ≫ Limits.pullback.fst W.hom V.hom ≫ W.hom = Q.hom ≫ i := by
      calc τ ≫ O.ι ≫ Limits.pullback.fst W.hom V.hom ≫ W.hom
          = (τ ≫ O.ι ≫ Limits.pullback.fst W.hom V.hom) ≫ W.hom := by
            simp only [Category.assoc]
        _ = rl ≫ Limits.pullback.fst W.hom i ≫ W.hom := by rw [h₁, Category.assoc]
        _ = (rl ≫ Limits.pullback.snd W.hom i) ≫ i := by
            rw [Limits.pullback.condition, Category.assoc]
        _ = Q.hom ≫ i := by rw [hr]
    let U : Y.ProEt := Scheme.ProEt.mk (O.ι ≫ Limits.pullback.fst W.hom V.hom ≫ W.hom)
    let pU : U ⟶ W := MorphismProperty.Over.homMk (O.ι ≫ Limits.pullback.fst W.hom V.hom)
      (Category.assoc _ _ _) trivial
    let qU : U ⟶ V := MorphismProperty.Over.homMk (O.ι ≫ Limits.pullback.snd W.hom V.hom)
      (by
        show (O.ι ≫ Limits.pullback.snd W.hom V.hom) ≫ V.hom =
          O.ι ≫ Limits.pullback.fst W.hom V.hom ≫ W.hom
        rw [Category.assoc, Limits.pullback.condition]) trivial
    obtain ⟨sl, hsl1, hsl2⟩ : ∃ sl : Q.left ⟶ Limits.pullback U.hom i,
        sl ≫ Limits.pullback.fst U.hom i = τ ∧ sl ≫ Limits.pullback.snd U.hom i = Q.hom :=
      ⟨Limits.pullback.lift τ Q.hom hstar, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    let s : Q ⟶ (wcProEtBC i).obj U := MorphismProperty.Over.homMk sl hsl2 trivial
    refine ⟨U, pU, qU, s, hO, ?_, ?_⟩
    · obtain ⟨M, hM, hM1, hM2⟩ := BCm pU
      have key : sl ≫ M = rl := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hM1, ← Category.assoc, hsl1]
          exact h₁
        · rw [Category.assoc, hM2, hsl2, hr]
      subst hM
      subst hrl
      exact MorphismProperty.Over.Hom.ext key
    · obtain ⟨M, hM, hM1, hM2⟩ := BCm qU
      have key : sl ≫ M = rl ≫ al := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hM1, ← Category.assoc, hsl1, Category.assoc]
          exact h₂
        · rw [Category.assoc, hM2, hsl2, Category.assoc, ha, hr]
      subst hM
      subst hrl
      subst hal
      exact MorphismProperty.Over.Hom.ext key

  have Lsect : ∀ (U : Y.ProEt) (hU : IsAffine U.left) (pU : U ⟶ W) (qU : U ⟶ V) (Q : Z.ProEt)
      (hQ : IsAffine Q.left) (r : Q ⟶ (wcProEtBC i).obj W) (s : Q ⟶ (wcProEtBC i).obj U),
      s ≫ (wcProEtBC i).map pU = r → s ≫ (wcProEtBC i).map qU = r ≫ a →
      ∃ (W₁ : Y.ProEt) (v : W₁ ⟶ W) (b : W₁ ⟶ V), IsAffine W₁.left ∧
        (wcProEtBC i).map b = (wcProEtBC i).map v ≫ a ∧
        ∀ q : Q.left, Limits.pullback.fst W.hom i (r.left q) ∈ Set.range v.left := by
    intro U hU pU qU Q hQ r s hs1 hs2
    obtain ⟨W₁, w₁, a₁, hW₁, ha₁, hsurj⟩ := c5 U hU Q s hQ
    refine ⟨W₁, w₁ ≫ pU, w₁ ≫ qU, hW₁, ?_, ?_⟩
    · calc (wcProEtBC i).map (w₁ ≫ qU)
          = (wcProEtBC i).map w₁ ≫ (wcProEtBC i).map qU := CategoryTheory.Functor.map_comp _ _ _
        _ = (a₁ ≫ s) ≫ (wcProEtBC i).map qU := by rw [ha₁]
        _ = a₁ ≫ (r ≫ a) := by rw [Category.assoc, hs2]
        _ = (a₁ ≫ s ≫ (wcProEtBC i).map pU) ≫ a := by rw [hs1]; simp only [Category.assoc]
        _ = ((a₁ ≫ s) ≫ (wcProEtBC i).map pU) ≫ a := by simp only [Category.assoc]
        _ = (wcProEtBC i).map (w₁ ≫ pU) ≫ a := by rw [ha₁, CategoryTheory.Functor.map_comp]
    · intro q
      have hr : a₁ ≫ r = (wcProEtBC i).map (w₁ ≫ pU) := by
        rw [CategoryTheory.Functor.map_comp, ← ha₁, Category.assoc, hs1]
      obtain ⟨x, rfl⟩ := hsurj.surj q
      exact ⟨Limits.pullback.fst W₁.hom i x,
        (pt a₁.left r.left ((wcProEtBC i).map (w₁ ≫ pU)).left (Limits.pullback.fst W.hom i)
          (Limits.pullback.fst W₁.hom i) (w₁ ≫ pU).left
          (congrArg (fun f => f.left) hr) (Limits.pullback.lift_fst _ _ _) x).symm⟩

  haveI hWaff' : IsAffine ((𝟭 Scheme.{u}).obj W.left) := inferInstanceAs (IsAffine W.left)
  obtain ⟨hZaff, -⟩ :=
    IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst W.hom i)
  haveI : IsAffine (Limits.pullback W.hom i) := hZaff
  have hσ : Limits.pullback.fst W.hom i ≫ W.hom =
      (al ≫ Limits.pullback.fst V.hom i) ≫ V.hom := by
    rw [Category.assoc, Limits.pullback.condition (f := V.hom) (g := i), ← Category.assoc, ha,
      Limits.pullback.condition]
  obtain ⟨σ₀, hσ₁, hσ₂⟩ : ∃ σ₀ : Limits.pullback W.hom i ⟶ Limits.pullback W.hom V.hom,
      σ₀ ≫ Limits.pullback.fst W.hom V.hom = Limits.pullback.fst W.hom i ∧
      σ₀ ≫ Limits.pullback.snd W.hom V.hom = al ≫ Limits.pullback.fst V.hom i :=
    ⟨Limits.pullback.lift _ _ hσ, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨n, D, O, hDa, hOa, hDO, hcov⟩ := Lchart σ₀
  have chart : ∀ k, ∃ (W₁ : Y.ProEt) (v : W₁ ⟶ W) (b : W₁ ⟶ V), IsAffine W₁.left ∧
      (wcProEtBC i).map b = (wcProEtBC i).map v ≫ a ∧
      ∀ z : ↥(Limits.pullback W.hom i), z ∈ D k →
        (Limits.pullback.fst W.hom i) z ∈ Set.range v.left := by
    intro k
    have hτ : σ₀.resLE (O k) (D k) (hDO k) ≫ (O k).ι = (D k).ι ≫ σ₀ :=
      Scheme.Hom.resLE_comp_ι _ _
    have h₁ : σ₀.resLE (O k) (D k) (hDO k) ≫ (O k).ι ≫ Limits.pullback.fst W.hom V.hom =
        (D k).ι ≫ Limits.pullback.fst W.hom i := by
      rw [← Category.assoc, hτ, Category.assoc, hσ₁]
    have h₂ : σ₀.resLE (O k) (D k) (hDO k) ≫ (O k).ι ≫ Limits.pullback.snd W.hom V.hom =
        (D k).ι ≫ al ≫ Limits.pullback.fst V.hom i := by
      rw [← Category.assoc, hτ, Category.assoc, hσ₂]
    haveI : WeaklyEtale (Limits.pullback.snd W.hom i) := ((wcProEtBC i).obj W).prop
    let Q : Z.ProEt := Scheme.ProEt.mk ((D k).ι ≫ Limits.pullback.snd W.hom i)
    let r : Q ⟶ (wcProEtBC i).obj W := MorphismProperty.Over.homMk (D k).ι rfl trivial
    have hQ : IsAffine Q.left := hDa k
    obtain ⟨U, pU, qU, s, hU, hs1, hs2⟩ :=
      Lgraph Q r (D k).ι rfl (O k) (hOa k) (σ₀.resLE (O k) (D k) (hDO k)) h₁ h₂
    obtain ⟨W₁, v, b, hW₁, hb, hcov'⟩ := Lsect U hU pU qU Q hQ r s hs1 hs2
    refine ⟨W₁, v, b, hW₁, hb, fun z hz => ?_⟩
    obtain ⟨q, rfl⟩ : z ∈ Set.range (D k).ι := by rw [Scheme.Opens.range_ι]; exact hz
    exact hcov' q
  choose W₁ v b hW₁ hb hcovk using chart
  apply Lcover n W₁ v hW₁ (fun k => hTb _ _ (b k) (hb k))
  rintro y ⟨z, rfl⟩
  obtain ⟨k, hk⟩ := hcov z
  exact ⟨k, hcovk k z hk⟩

theorem wc_proet_closed_free_unit_epi {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y]
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush i) (V : Y.ProEt) :
    Epi (adj.unit.app (wcFreeSheaf Y V)) :=
by
  classical

  obtain ⟨β, hβdef⟩ : ∃ β, β = Functor.whiskerRight (yonedaMap (wcProEtBC i) V)
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcProEtBC i).op (toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj ((wcProEtBC i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    ⟨_, rfl⟩

  have hβ : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) β := by
    rw [hβdef]
    exact wc_proet_closed_free_bc_locally_surjective_of_ext i V
      (fun W _ R hR => wc_proet_closed_sieve_extension_affine i W R hR)
      (fun W _ a => wc_proet_closed_map_local_extension i W V a)
  obtain ⟨η, hηdef⟩ : ∃ η : wcFreeSheaf Y V ⟶
      (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V)),
      η = (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map β := ⟨_, rfl⟩

  have hηepi : Epi η := by
    have hnat := toSheafify_naturality (Scheme.ProEt.topology Y) β
    haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
        (toSheafify (Scheme.ProEt.topology Y)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
        (β ≫ toSheafify (Scheme.ProEt.topology Y) _) :=
      Presheaf.isLocallySurjective_comp _ _ _
    haveI hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
        (sheafifyMap (Scheme.ProEt.topology Y) β) :=
      Presheaf.isLocallySurjective_of_isLocallySurjective_fac _ hnat.symm
    haveI : Sheaf.IsLocallySurjective η := by
      rw [hηdef]
      exact (Sheaf.isLocallySurjective_sheafToPresheaf_map_iff _).mp hls
    exact Sheaf.epi_of_isLocallySurjective η

  obtain ⟨φ, hφdef⟩ : ∃ φ : L.obj (wcFreeSheaf Y V) ⟶ wcFreeSheaf Z ((wcProEtBC i).obj V),
      adj.homEquiv _ _ φ = η := ⟨_, Equiv.apply_symm_apply _ _⟩
  have hφ : adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map φ = η := by
    rw [Adjunction.homEquiv_unit] at hφdef
    exact hφdef
  have hbij : ∀ M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M => φ ≫ g) := by
    intro M
    have h1 : (adj.homEquiv (wcFreeSheaf Y V) M) ∘
        (fun g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M => φ ≫ g) =
        (fun g => η ≫ (wcProEtPush i).map g) := by
      funext g
      simp only [Function.comp_apply]
      rw [Adjunction.homEquiv_naturality_right, hφdef]
    refine (Function.Bijective.of_comp_iff' (adj.homEquiv (wcFreeSheaf Y V) M).bijective _).mp ?_
    rw [h1, hηdef, hβdef]
    exact wc_proet_free_bc_corepresents i V M
  obtain ⟨ψ, hψ⟩ := (hbij (L.obj (wcFreeSheaf Y V))).2 (𝟙 _)
  have hψ1 : φ ≫ ψ = 𝟙 _ := hψ
  have hψ2 : ψ ≫ φ = 𝟙 _ := by
    apply (hbij (wcFreeSheaf Z ((wcProEtBC i).obj V))).1
    show φ ≫ (ψ ≫ φ) = φ ≫ 𝟙 _
    rw [← Category.assoc, hψ1, Category.id_comp, Category.comp_id]
  haveI : IsIso φ := ⟨⟨ψ, hψ1, hψ2⟩⟩
  have hunit : adj.unit.app (wcFreeSheaf Y V) = η ≫ (wcProEtPush i).map (inv φ) := by
    rw [← hφ, Category.assoc, ← CategoryTheory.Functor.map_comp, IsIso.hom_inv_id,
      CategoryTheory.Functor.map_id]
    first
      | exact (Category.comp_id _).symm
      | (erw [Category.comp_id])
      | simp
  rw [hunit]
  exact epi_comp _ _

theorem wc_proet_sheafify_exact_refine (S : Scheme.{u}) {P₁ P₂ P₃ : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
    (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃) (w : f ≫ g = 0)
    (hex : ∀ (U : S.ProEt) (x : P₂.obj (Opposite.op U)), (g.app (Opposite.op U)).hom x = 0 →
      ∃ R ∈ Scheme.ProEt.topology S U, ∀ (V : S.ProEt) (k : V ⟶ U), R.arrows k →
        ∃ y : P₁.obj (Opposite.op V), (f.app (Opposite.op V)).hom y = (P₂.map k.op).hom x)
    (T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (h : T ⟶ (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj P₂)
    (hh : h ≫ (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g = 0) :
    ∃ (T' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (p : T' ⟶ T)
      (h' : T' ⟶ (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj P₁),
      Epi p ∧ p ≫ h = h' ≫ (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f :=
by
  classical
  have hιinj : ∀ W, Function.Injective ((Limits.kernel.ι g).app W).hom := by
    intro W
    have hm : Mono ((Limits.kernel.ι g).app W) :=
      (NatTrans.mono_iff_mono_app (Limits.kernel.ι g)).mp inferInstance W
    exact (AddCommGrpCat.mono_iff_injective _).mp hm
  have hb : ∀ W (y : P₁.obj W), ((Limits.kernel.ι g).app W).hom
      (((Limits.kernel.lift g f w).app W).hom y) = (f.app W).hom y := by
    intro W y
    have h := congrArg (fun φ => (φ.app W).hom y) (Limits.kernel.lift_ι g f w)
    first
      | exact h
      | (simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
          Function.comp_apply] at h; exact h)
  have hc : ∀ W (s : (Limits.kernel g).obj W),
      (g.app W).hom (((Limits.kernel.ι g).app W).hom s) = 0 := by
    intro W s
    have h := congrArg (fun φ => (φ.app W).hom s) (Limits.kernel.condition g)
    first
      | exact h
      | (simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
          Function.comp_apply, NatTrans.app_zero, AddCommGrpCat.hom_zero,
          AddMonoidHom.zero_apply] at h; exact h)
  have hk : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
      (Limits.kernel.lift g f w) := by
    constructor
    intro U s
    obtain ⟨R, hR, hy⟩ := hex U (((Limits.kernel.ι g).app (Opposite.op U)).hom s) (hc _ s)
    refine (Scheme.ProEt.topology S).superset_covering ?_ hR
    intro V i hi
    obtain ⟨y, hy⟩ := hy V i hi
    refine ⟨y, ?_⟩
    change ((Limits.kernel.lift g f w).app (Opposite.op V)).hom y =
      ((Limits.kernel g).map i.op).hom s
    apply hιinj
    rw [hb, hy]
    have h := congrArg (fun φ => φ.hom s) ((Limits.kernel.ι g).naturality i.op)
    simpa using h.symm
  have w' : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f ≫
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g = 0 := by
    rw [← Functor.map_comp, w, Functor.map_zero]
  have hS₀ : (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).Exact :=
    (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).exact_of_f_is_kernel
      (Limits.kernelIsKernel g)
  have hS₀L := hS₀.map (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
  let φ : ShortComplex.mk ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f)
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g) w' ⟶
      (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).map
        (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    { τ₁ := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f w)
      τ₂ := 𝟙 _
      τ₃ := 𝟙 _
      comm₁₂ := by
        show (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
            (Limits.kernel.lift g f w) ≫
            (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
              (Limits.kernel.ι g) =
          (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f ≫ 𝟙 _
        rw [← Functor.map_comp, Limits.kernel.lift_ι, Category.comp_id]
      comm₂₃ := by
        show 𝟙 _ ≫ (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g =
          (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g ≫ 𝟙 _
        rw [Category.id_comp, Category.comp_id] }
  haveI : Sheaf.IsLocallySurjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f w)) :=
    (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
  haveI : Epi φ.τ₁ := Sheaf.epi_of_isLocallySurjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f w))
  haveI : IsIso φ.τ₂ := by dsimp [φ]; infer_instance
  haveI : Mono φ.τ₃ := by dsimp [φ]; infer_instance
  have hE := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mpr hS₀L
  obtain ⟨A', π, hπ, x₁, hfac⟩ := hE.exact_up_to_refinements h hh
  exact ⟨A', π, x₁, hπ, hfac⟩

theorem wc_proet_closed_free_bc_comp_zero {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt) :
    Functor.whiskerRight (yoneda.map (wcOpenRestrIncl Y O V)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
      (Functor.whiskerRight (yonedaMap (wcProEtBaseChange i) V) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcProEtBaseChange i).op (toSheafify (Scheme.ProEt.topology Z)
          (yoneda.obj ((wcProEtBaseChange i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) = 0 :=
by
  classical
  apply NatTrans.ext
  funext T
  rw [NatTrans.app_zero]
  rcases isEmpty_or_nonempty (T.unop ⟶ wcOpenRestr Y O V) with hE | hN
  · have hz : Limits.IsZero ((yoneda.obj (wcOpenRestr Y O V) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free).obj T) := by
      haveI : Subsingleton ↑((yoneda.obj (wcOpenRestr Y O V) ⋙ uliftFunctor.{u+1, u} ⋙
          AddCommGrpCat.free).obj T) :=
        (inferInstance : Subsingleton (FreeAbelianGroup (ULift.{u+1} (T.unop ⟶ wcOpenRestr Y O V))))
      exact AddCommGrpCat.isZero_of_subsingleton _
    exact hz.eq_of_src _ _
  · obtain ⟨v⟩ := hN
    have hmem : ∀ t : T.unop.left, T.unop.hom t ∈ (O : Set Y) := by
      intro t
      have hw : v.left ≫ (wcOpenRestr Y O V).hom = T.unop.hom := MorphismProperty.Over.w v
      have hU : (wcOpenRestr Y O V).hom = Limits.pullback.fst O.ι V.hom ≫ O.ι := by
        show Limits.pullback.snd O.ι _ ≫ _ = _
        exact Limits.pullback.condition.symm
      rw [← hw, hU]
      change O.ι (Limits.pullback.fst O.ι V.hom (v.left t)) ∈ (O : Set Y)
      rw [← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    haveI hE' : IsEmpty ((wcProEtBaseChange i).obj T.unop).left := by
      refine ⟨fun z => ?_⟩
      change ↥(Limits.pullback T.unop.hom i) at z
      have hc0 := congrArg (fun g => g z) (Limits.pullback.condition (f := T.unop.hom) (g := i))
      have hc : T.unop.hom (Limits.pullback.fst T.unop.hom i z) =
          i (Limits.pullback.snd T.unop.hom i z) := by
        first
          | exact hc0
          | simpa only [Scheme.Hom.comp_apply] using hc0
          | simpa using hc0
      have h1 := hmem (Limits.pullback.fst _ i z)
      rw [hc, hO] at h1
      exact h1 ⟨_, rfl⟩
    have hbot := Scheme.ProEt.bot_mem_topology ((wcProEtBaseChange i).obj T.unop)
    have hz := (Sheaf.isTerminalOfBotCover (wcFreeSheaf Z ((wcProEtBaseChange i).obj V)) _
      hbot).isZero
    exact hz.eq_of_tgt _ _

theorem wc_proet_closed_free_openRestr_surj_off {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (hO : (O : Set Y) = (Set.range i)ᶜ) (V T : Y.ProEt)
    (hT : IsEmpty ((wcProEtBC i).obj T).left)
    (x : (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj (Opposite.op T)) :
    ∃ y : (yoneda.obj (wcOpenRestr Y O V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj
        (Opposite.op T),
      ((Functor.whiskerRight (yoneda.map (wcOpenRestrIncl Y O V))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op T)).hom y = x :=
by
  classical
  have hpt : ∀ t : T.left, T.hom t ∈ (O : Set Y) := by
    intro t
    rw [hO]
    rintro ⟨z, hz⟩
    obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback t z hz.symm
    have hE : IsEmpty ↥(Limits.pullback T.hom i) := hT
    exact hE.false w
  have hrange : Set.range T.hom.base ⊆ Set.range O.ι.base := by
    rintro _ ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hpt t
  let lam := IsOpenImmersion.lift O.ι T.hom hrange
  have hlam : lam ≫ O.ι = T.hom := IsOpenImmersion.lift_fac _ _ _
  let s : (T ⟶ V) → (T ⟶ wcOpenRestr Y O V) := fun a =>
    MorphismProperty.Over.homMk
      (Limits.pullback.lift lam a.left (hlam.trans (MorphismProperty.Over.w a).symm)) (by
        change Limits.pullback.lift _ _ _ ≫ Limits.pullback.snd O.ι V.hom ≫ V.hom = T.hom
        rw [Limits.pullback.lift_snd_assoc, MorphismProperty.Over.w a]) trivial
  have hs : ∀ a, s a ≫ wcOpenRestrIncl Y O V = a := by
    intro a
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.lift _ _ _ ≫ Limits.pullback.snd O.ι V.hom = a.left
    exact Limits.pullback.lift_snd _ _ _
  refine ⟨FreeAbelianGroup.map (fun a : ULift.{u+1} (T ⟶ V) => ULift.up (s a.down)) x, ?_⟩
  change FreeAbelianGroup.map
      (fun b : ULift.{u+1} (T ⟶ wcOpenRestr Y O V) => ULift.up (b.down ≫ wcOpenRestrIncl Y O V))
      (FreeAbelianGroup.map (fun a : ULift.{u+1} (T ⟶ V) => ULift.up (s a.down)) x) = x
  have hid : ((fun b : ULift.{u+1} (T ⟶ wcOpenRestr Y O V) =>
      (ULift.up (b.down ≫ wcOpenRestrIncl Y O V) : ULift.{u+1} (T ⟶ V))) ∘
      (fun a : ULift.{u+1} (T ⟶ V) => ULift.up (s a.down))) = id := by
    funext a
    simp only [Function.comp_apply, id_eq, hs]
  have key : ∀ z : FreeAbelianGroup (ULift.{u+1} (T ⟶ V)),
      FreeAbelianGroup.map
        (fun b : ULift.{u+1} (T ⟶ wcOpenRestr Y O V) =>
          (ULift.up (b.down ≫ wcOpenRestrIncl Y O V) : ULift.{u+1} (T ⟶ V)))
        (FreeAbelianGroup.map (fun a : ULift.{u+1} (T ⟶ V) => ULift.up (s a.down)) z) = z := by
    intro z
    rw [← FreeAbelianGroup.map_comp_apply, hid, FreeAbelianGroup.map_id_apply]
  exact key x

theorem wc_proet_closed_free_bc_sheafify_kernel_local {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] (V W : Y.ProEt) (hW : IsAffine W.left)
    (x : FreeAbelianGroup (ULift.{u+1} (W ⟶ V)))
    (hx : ((toSheafify (Scheme.ProEt.topology Z)
        (yoneda.obj ((wcProEtBaseChange i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op ((wcProEtBaseChange i).obj W))).hom
        (FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) =>
          ULift.up.{u+1} ((wcProEtBaseChange i).map a.down)) x) = 0) :
    ∃ (m : ℕ) (W' : Fin m → Y.ProEt) (w : ∀ k, W' k ⟶ W),
      (∀ k, IsAffine (W' k).left) ∧
      (∀ k, FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) =>
        ULift.up.{u+1} ((wcProEtBaseChange i).map (w k ≫ a.down))) x = 0) ∧
      ∀ y : W.left, y ∈ Set.range (Limits.pullback.fst W.hom i) → ∃ k, y ∈ Set.range (w k).left :=
by
  classical

  have L6 : ∀ (U : Y.ProEt), IsAffine U.left → ∀ (V' : Z.ProEt)
      (g' : V' ⟶ (wcProEtBaseChange i).obj U), IsAffine V'.left →
      ∃ (W₁ : Y.ProEt) (w : W₁ ⟶ U) (a : (wcProEtBaseChange i).obj W₁ ⟶ V'),
        IsAffine W₁.left ∧ a ≫ g' = (wcProEtBaseChange i).map w ∧ Surjective a.left := by
    intro U hU V' g' hV'
    haveI : IsAffine U.left := hU
    haveI hV'i : IsAffine V'.left := hV'
    have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      intro R' S' _ _ _ hW
      have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff]
        exact hW.flat
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
        exact hW.flat_lmul'
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
        rw [diagonal_SpecMap]
        infer_instance
      exact ⟨hfl, hd⟩
    have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
      intro R' S' _ _ _ hW
      have hfl : Module.Flat R' S' := by
        have := hW.flat
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff] at this
        exact this
      have hd := hW.flat_diagonal
      rw [diagonal_SpecMap] at hd
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
              (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [e]
        haveI := hd
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
      exact Algebra.WeaklyEtale.mk hfl hmu
    have appTopWE : ∀ {X Z : Scheme.{u}} [IsAffine X] [IsAffine Z] (h : X ⟶ Z), WeaklyEtale h →
        WeaklyEtale (Spec.map h.appTop) := by
      intro X Z _ _ h hh
      have e : Spec.map h.appTop = X.isoSpec.inv ≫ h ≫ Z.isoSpec.hom := by
        rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
      rw [e]
      infer_instance
    haveI hUaff' : IsAffine ((𝟭 Scheme.{u}).obj U.left) := inferInstanceAs (IsAffine U.left)
    haveI hjci : IsClosedImmersion (Limits.pullback.fst U.hom i) := inferInstance
    obtain ⟨hZaff, hjsurj⟩ :=
      IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst U.hom i)
    haveI := hZaff
    obtain ⟨g0, hg0def⟩ : ∃ g0 : V'.left ⟶ Limits.pullback U.hom i, g0 = g'.left := ⟨_, rfl⟩
    have hw0 : g0 ≫ Limits.pullback.snd U.hom i = V'.hom := by
      rw [hg0def]; exact MorphismProperty.Over.w g'
    have hg0 : WeaklyEtale g0 := by
      have h1 : WeaklyEtale (g0 ≫ Limits.pullback.snd U.hom i) := by
        rw [hw0]; exact V'.prop
      have h2 : WeaklyEtale (Limits.pullback.snd U.hom i) := ((wcProEtBaseChange i).obj U).prop
      exact @WeaklyEtale.of_comp _ _ _ g0 _ h1 h2
    letI alg1 : Algebra Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) :=
      (Limits.pullback.fst U.hom i).appTop.hom.toAlgebra
    letI alg2 : Algebra Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) := g0.appTop.hom.toAlgebra
    have hπ : Function.Surjective (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)) := hjsurj
    have hW : Algebra.WeaklyEtale Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) :=
      toRing _ _ (appTopWE g0 hg0)
    obtain ⟨C, _, _, β, hC, hβ, hsurj⟩ :=
      wcl_weaklyEtale_lift_tensor_surj Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) hπ hW
    haveI := toSch _ _ hC
    haveI := U.prop
    obtain ⟨p, hpdef⟩ : ∃ p : Spec (CommRingCat.of C) ⟶ U.left,
        p = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) ≫ U.left.isoSpec.inv :=
      ⟨_, rfl⟩
    haveI hpwe : WeaklyEtale p := by rw [hpdef]; infer_instance
    have hp : p ≫ U.left.isoSpec.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hpdef, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback (p ≫ U.hom) i ⟶ Limits.pullback U.hom i,
        m = ((wcProEtBaseChange i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U)).left :=
      ⟨_, rfl⟩
    have hsq : m ≫ Limits.pullback.fst U.hom i = Limits.pullback.fst (p ≫ U.hom) i ≫ p := by
      rw [hmdef]
      exact Limits.pullback.lift_fst _ _ _
    have hmsnd : m ≫ Limits.pullback.snd U.hom i = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [hmdef]
      exact MorphismProperty.Over.w ((wcProEtBaseChange i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U))
    have eq₁ : p ≫ U.left.isoSpec.hom =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hp, Category.id_comp]
    have eq₂ : Limits.pullback.fst U.hom i ≫ U.left.isoSpec.hom =
        (Limits.pullback U.hom i).isoSpec.hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))) := by
      have hnat := Scheme.isoSpec_hom_naturality (Limits.pullback.fst U.hom i)
      exact hnat.symm
    obtain ⟨M, hMdef⟩ : ∃ M : Limits.pullback p (Limits.pullback.fst U.hom i) ⟶
        Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))),
        M = Limits.pullback.map p (Limits.pullback.fst U.hom i)
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))))
          (𝟙 _) (Limits.pullback U.hom i).isoSpec.hom U.left.isoSpec.hom eq₁ eq₂ := ⟨_, rfl⟩
    haveI hMiso : IsIso M := by
      rw [hMdef]
      infer_instance
    have hMsnd : M ≫ Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      rw [hMdef]
      exact Limits.pullback.lift_snd _ _ _
    let e₁ := asIso M ≪≫ pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)
    have he₁ : e₁.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show (M ≫ (pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).hom) ≫ _ = _
      rw [Category.assoc]
      refine (congrArg (fun k => M ≫ k)
        (pullbackSpecIso_hom_snd Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤))).trans ?_
      exact hMsnd
    have hR : (Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) = m := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_fst, hsq]
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_snd, hmsnd]
    let e := (Limits.pullbackRightPullbackFstIso U.hom i p).symm ≪≫ e₁
    have he : e.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        m ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show ((Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫ e₁.hom) ≫ _ = _
      rw [Category.assoc, he₁, ← Category.assoc, hR]
    obtain ⟨βc, hβc⟩ : ∃ βc : Γ(V'.left, ⊤) ⟶
        CommRingCat.of (TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)),
        βc.hom = β := ⟨CommRingCat.ofHom β, rfl⟩
    subst hβc
    obtain ⟨a₀, ha₀def⟩ : ∃ a₀ : Limits.pullback (p ≫ U.hom) i ⟶ V'.left,
        a₀ = e.hom ≫ Spec.map βc ≫ V'.left.isoSpec.inv := ⟨_, rfl⟩
    have h8a : a₀ ≫ g0 = m := by
      rw [← cancel_mono (Limits.pullback U.hom i).isoSpec.hom, ha₀def]
      simp only [Category.assoc]
      rw [← Scheme.isoSpec_hom_naturality g0, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← he]
      refine congrArg (fun k => e.hom ≫ Spec.map k) ?_
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact hβ
    have h8b : a₀ ≫ V'.hom = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [← hw0, ← Category.assoc, h8a, hmsnd]
    have ha₀s : Surjective a₀ := by
      constructor
      intro v
      obtain ⟨P, hP⟩ := hsurj (V'.left.isoSpec.hom v)
      refine ⟨e.inv P, ?_⟩
      have h1 : (Spec.map βc) P = V'.left.isoSpec.hom v := hP
      have h2 : e.hom (e.inv P) = P := Scheme.inv_hom_apply e P
      have h3 : a₀ (e.inv P) = V'.left.isoSpec.inv ((Spec.map βc) (e.hom (e.inv P))) := by
        rw [ha₀def, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact h3.trans ((congrArg (fun z => V'.left.isoSpec.inv ((Spec.map βc) z)) h2).trans
        ((congrArg V'.left.isoSpec.inv h1).trans (Scheme.hom_inv_apply _ _)))
    refine ⟨Scheme.ProEt.mk (p ≫ U.hom), MorphismProperty.Over.homMk p rfl trivial,
      MorphismProperty.Over.homMk a₀ h8b trivial, ?_, ?_, ?_⟩
    · show IsAffine (Spec (CommRingCat.of C))
      infer_instance
    · apply MorphismProperty.Over.Hom.ext
      show a₀ ≫ g'.left = _
      exact (congrArg (a₀ ≫ ·) hg0def.symm).trans (h8a.trans hmdef)
    · exact ha₀s

  haveI hWi : IsAffine W.left := hW
  haveI hWaff' : IsAffine ((𝟭 Scheme.{u}).obj W.left) := inferInstanceAs (IsAffine W.left)
  have hBCaff : IsAffine ((wcProEtBaseChange i).obj W).left :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst W.hom i)).1

  have hmem := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology Z)
    (toSheafify (Scheme.ProEt.topology Z)
      (yoneda.obj ((wcProEtBaseChange i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    (X := Opposite.op ((wcProEtBaseChange i).obj W))
    (FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) =>
      ULift.up.{u+1} ((wcProEtBaseChange i).map a.down)) x) 0 (by rw [map_zero]; exact hx)
  obtain ⟨n, Q, r, hrR, hQaff, hrcov⟩ :=
    wc_proet_affine_sieve_finite_jointly_surjective Z _ hBCaff _ hmem

  have hA2 : ∀ k, FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) =>
      ULift.up.{u+1} (r k ≫ (wcProEtBaseChange i).map a.down)) x = 0 := by
    intro k
    have h : ((yoneda.obj ((wcProEtBaseChange i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free).map (r k).op).hom
        (FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) =>
          ULift.up.{u+1} ((wcProEtBaseChange i).map a.down)) x) =
        ((yoneda.obj ((wcProEtBaseChange i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free).map (r k).op).hom 0 := hrR k
    rw [map_zero] at h
    exact (FreeAbelianGroup.map_comp_apply
      (f := fun a : ULift.{u+1} (W ⟶ V) => ULift.up.{u+1} ((wcProEtBaseChange i).map a.down))
      (g := fun c : ULift.{u+1} ((wcProEtBaseChange i).obj W ⟶ (wcProEtBaseChange i).obj V) =>
        ULift.up.{u+1} (r k ≫ c.down)) x).trans h

  choose W₁ w a hW₁ hfac hsurj using fun k => L6 W hW (Q k) (r k) (hQaff k)
  refine ⟨n, W₁, w, hW₁, fun k => ?_, fun y hy => ?_⟩
  ·
    have hfun : (fun a' : ULift.{u+1} (W ⟶ V) =>
          ULift.up.{u+1} ((wcProEtBaseChange i).map (w k ≫ a'.down))) =
        (fun c : ULift.{u+1} (Q k ⟶ (wcProEtBaseChange i).obj V) => ULift.up.{u+1} (a k ≫ c.down)) ∘
        (fun a' : ULift.{u+1} (W ⟶ V) =>
          ULift.up.{u+1} (r k ≫ (wcProEtBaseChange i).map a'.down)) := by
      funext b
      show ULift.up.{u+1} _ = ULift.up.{u+1} _
      congr 1
      rw [Functor.map_comp, ← hfac k, Category.assoc]
    rw [hfun, FreeAbelianGroup.map_comp_apply, hA2 k, map_zero]
  ·
    obtain ⟨q₀, rfl⟩ := hy
    obtain ⟨k, q, hq⟩ := hrcov q₀
    obtain ⟨q', hq'⟩ := (hsurj k).surj q
    refine ⟨k, Limits.pullback.fst (W₁ k).hom i q', ?_⟩
    have h1 : ((wcProEtBaseChange i).map (w k)).left ≫ Limits.pullback.fst W.hom i =
        Limits.pullback.fst (W₁ k).hom i ≫ (w k).left := Limits.pullback.lift_fst _ _ _
    have h2 : ((wcProEtBaseChange i).map (w k)).left = (a k).left ≫ (r k).left := by
      have := congrArg (fun f => f.left) (hfac k)
      exact this.symm
    have key : (a k).left ≫ (r k).left ≫ Limits.pullback.fst W.hom i =
        Limits.pullback.fst (W₁ k).hom i ≫ (w k).left :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ Limits.pullback.fst W.hom i) h2.symm).trans h1)
    have h5 : (w k).left (Limits.pullback.fst (W₁ k).hom i q') =
        Limits.pullback.fst W.hom i ((r k).left ((a k).left q')) := by
      have := congrArg (fun g => g q') key
      exact this.symm
    subst hq hq'
    exact h5

theorem wc_proet_closed_free_bc_presheaf_kernel_local {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] (V W : Y.ProEt) (hW : IsAffine W.left)
    (x : FreeAbelianGroup (ULift.{u+1} (W ⟶ V)))
    (hx : FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) =>
      ULift.up.{u+1} ((wcProEtBaseChange i).map a.down)) x = 0) :
    ∃ (m : ℕ) (W' : Fin m → Y.ProEt) (e : ∀ j, W' j ⟶ W),
      (∀ j, IsAffine (W' j).left) ∧
      (∀ j, FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) => ULift.up.{u+1} (e j ≫ a.down)) x = 0) ∧
      ∀ y : W.left, y ∈ Set.range (Limits.pullback.fst W.hom i) → ∃ j, y ∈ Set.range (e j).left :=
by
  classical

  have heq : ∀ (U : Y.ProEt) (g₁ g₂ : U ⟶ V), ∃ (E : Y.ProEt) (ε : E ⟶ U),
      ε ≫ g₁ = ε ≫ g₂ ∧ ∀ (T : Scheme.{u}) (t : T ⟶ U.left), t ≫ g₁.left = t ≫ g₂.left →
        ∃ s : T ⟶ E.left, s ≫ ε.left = t := by
    intro U g₁ g₂
    haveI : WeaklyEtale V.hom := V.prop
    haveI : WeaklyEtale U.hom := U.prop
    have hq : g₁.left ≫ V.hom = g₂.left ≫ V.hom :=
      (MorphismProperty.Over.w g₁).trans (MorphismProperty.Over.w g₂).symm
    obtain ⟨q, hq1, hq2⟩ : ∃ q : U.left ⟶ Limits.pullback V.hom V.hom,
        q ≫ Limits.pullback.fst V.hom V.hom = g₁.left ∧
          q ≫ Limits.pullback.snd V.hom V.hom = g₂.left :=
      ⟨Limits.pullback.lift g₁.left g₂.left hq, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have h1 : Limits.pullback.fst q (Limits.pullback.diagonal V.hom) ≫ g₁.left =
        Limits.pullback.snd q (Limits.pullback.diagonal V.hom) := by
      rw [← hq1, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.diagonal_fst, Category.comp_id]
    have h2 : Limits.pullback.fst q (Limits.pullback.diagonal V.hom) ≫ g₂.left =
        Limits.pullback.snd q (Limits.pullback.diagonal V.hom) := by
      rw [← hq2, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.diagonal_snd, Category.comp_id]
    refine ⟨MorphismProperty.Over.mk ⊤
        (Limits.pullback.fst q (Limits.pullback.diagonal V.hom) ≫ U.hom) inferInstance,
      MorphismProperty.Over.homMk (Limits.pullback.fst q (Limits.pullback.diagonal V.hom))
        rfl trivial, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst q (Limits.pullback.diagonal V.hom) ≫ g₁.left =
        Limits.pullback.fst q (Limits.pullback.diagonal V.hom) ≫ g₂.left
      rw [h1, h2]
    · intro T t ht
      refine ⟨Limits.pullback.lift t (t ≫ g₁.left) ?_, Limits.pullback.lift_fst _ _ _⟩
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, hq1, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, Category.assoc, hq2, Limits.pullback.diagonal_snd, Category.comp_id, ht]

  have hbc : ∀ {A' B' : Y.ProEt} (c : A' ⟶ B'),
      ((wcProEtBaseChange i).map c).left ≫ Limits.pullback.fst B'.hom i =
        Limits.pullback.fst A'.hom i ≫ c.left := by
    intro A' B' c
    have h0 : (Limits.pullback.fst A'.hom i ≫ c.left) ≫ B'.hom =
        Limits.pullback.snd A'.hom i ≫ i := by
      rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition
    have hmap : ((wcProEtBaseChange i).map c).left = Limits.pullback.lift
        (Limits.pullback.fst A'.hom i ≫ c.left) (Limits.pullback.snd A'.hom i) h0 := by
      first
        | rfl
        | (unfold wcProEtBaseChange; exact MorphismProperty.Over.pullback_map_left _ _ i c)
    rw [hmap]; exact Limits.pullback.lift_fst _ _ _

  have hind : ∀ S : Finset (ULift.{u+1} (W ⟶ V) × ULift.{u+1} (W ⟶ V)),
      (∀ p ∈ S, Limits.pullback.fst W.hom i ≫ p.1.down.left =
        Limits.pullback.fst W.hom i ≫ p.2.down.left) →
      ∃ (E : Y.ProEt) (ε : E ⟶ W) (σ : Limits.pullback W.hom i ⟶ E.left),
        σ ≫ ε.left = Limits.pullback.fst W.hom i ∧ ∀ p ∈ S, ε ≫ p.1.down = ε ≫ p.2.down := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      refine ⟨W, 𝟙 W, Limits.pullback.fst W.hom i, ?_, fun p hp => absurd hp (Finset.notMem_empty p)⟩
      change Limits.pullback.fst W.hom i ≫ 𝟙 W.left = _
      exact Category.comp_id _
    | insert p S hpS ih =>
      intro hS
      obtain ⟨E, ε, σ, hσ, hε⟩ := ih (fun p' hp' => hS p' (Finset.mem_insert_of_mem hp'))
      obtain ⟨E', ε', hε', huniv⟩ := heq E (ε ≫ p.1.down) (ε ≫ p.2.down)
      obtain ⟨s, hs⟩ := huniv _ σ (by
        have hp := hS p (Finset.mem_insert_self _ _)
        change σ ≫ (ε.left ≫ p.1.down.left) = σ ≫ (ε.left ≫ p.2.down.left)
        rw [← Category.assoc, ← Category.assoc, hσ, hp])
      refine ⟨E', ε' ≫ ε, s, ?_, ?_⟩
      · change s ≫ (ε'.left ≫ ε.left) = _
        rw [← Category.assoc, hs, hσ]
      · intro p' hp'
        rcases Finset.mem_insert.mp hp' with rfl | hp'
        · rw [Category.assoc, Category.assoc]; exact hε'
        · rw [Category.assoc, Category.assoc, hε p' hp']

  have hsum : ∀ {G : Type (u+1)} [AddCommGroup G] (g : ULift.{u+1} (W ⟶ V) → G),
      FreeAbelianGroup.lift g x = (FreeAbelianGroup.toFinsupp x).sum (fun a n => n • g a) := by
    intro G _ g
    have gen : ∀ f : ULift.{u+1} (W ⟶ V) →₀ ℤ,
        FreeAbelianGroup.lift g (Finsupp.toFreeAbelianGroup f) = f.sum (fun a n => n • g a) := by
      intro f
      induction f using Finsupp.induction_linear with
      | zero => rw [map_zero, map_zero, Finsupp.sum_zero_index]
      | add f₁ f₂ h₁ h₂ =>
        rw [map_add, map_add, h₁, h₂]
        exact (Finsupp.sum_add_index' (h := fun a n => n • g a) (fun _ => zero_smul ℤ _)
          (fun _ _ _ => add_smul _ _ _)).symm
      | single a n =>
        rw [Finsupp.toFreeAbelianGroup_single, map_zsmul, FreeAbelianGroup.lift_apply_of]
        exact (Finsupp.sum_single_index (h := fun a n => n • g a) (zero_smul ℤ (g a))).symm
    conv_lhs => rw [← Finsupp.toFreeAbelianGroup_toFinsupp x]
    exact gen _
  let S : Finset (ULift.{u+1} (W ⟶ V) × ULift.{u+1} (W ⟶ V)) :=
    ((FreeAbelianGroup.toFinsupp x).support ×ˢ (FreeAbelianGroup.toFinsupp x).support).filter
      (fun p => (wcProEtBaseChange i).map p.1.down = (wcProEtBaseChange i).map p.2.down)
  have hcollapse : ∀ {W'' : Y.ProEt} (e : W'' ⟶ W), (∀ p ∈ S, e ≫ p.1.down = e ≫ p.2.down) →
      FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) => ULift.up.{u+1} (e ≫ a.down)) x = 0 := by
    intro W'' e he
    let φ := fun a : ULift.{u+1} (W ⟶ V) => ULift.up.{u+1} ((wcProEtBaseChange i).map a.down)
    let ψ := fun a : ULift.{u+1} (W ⟶ V) => ULift.up.{u+1} (e ≫ a.down)
    let θ : ULift.{u+1} ((wcProEtBaseChange i).obj W ⟶ (wcProEtBaseChange i).obj V) →
        FreeAbelianGroup (ULift.{u+1} (W'' ⟶ V)) := fun b =>
      if h : ∃ a ∈ (FreeAbelianGroup.toFinsupp x).support, φ a = b then
        FreeAbelianGroup.of (ψ (Classical.choose h)) else 0
    have hθ : ∀ a ∈ (FreeAbelianGroup.toFinsupp x).support, θ (φ a) = FreeAbelianGroup.of (ψ a) := by
      intro a ha
      have h : ∃ a' ∈ (FreeAbelianGroup.toFinsupp x).support, φ a' = φ a := ⟨a, ha, rfl⟩
      change (if h : ∃ a' ∈ (FreeAbelianGroup.toFinsupp x).support, φ a' = φ a then
        FreeAbelianGroup.of (ψ (Classical.choose h)) else 0) = _
      rw [dite_cond_eq_true (eq_true h)]
      obtain ⟨ha', hφ'⟩ := Classical.choose_spec h
      have hmem : (Classical.choose h, a) ∈ S :=
        Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨ha', ha⟩, ULift.up_inj.mp hφ'⟩
      have := he _ hmem
      change FreeAbelianGroup.of (ULift.up.{u+1} (e ≫ (Classical.choose h).down)) =
        FreeAbelianGroup.of (ULift.up.{u+1} (e ≫ a.down))
      rw [this]
    have h1 : FreeAbelianGroup.map ψ x = FreeAbelianGroup.lift (θ ∘ φ) x := by
      change FreeAbelianGroup.lift (FreeAbelianGroup.of ∘ ψ) x = _
      rw [hsum, hsum]
      unfold Finsupp.sum
      refine Finset.sum_congr rfl (fun a ha => ?_)
      change _ • FreeAbelianGroup.of (ψ a) = _ • θ (φ a)
      rw [hθ a ha]
    change FreeAbelianGroup.map ψ x = 0
    rw [h1, FreeAbelianGroup.lift_comp]
    change FreeAbelianGroup.lift θ (FreeAbelianGroup.map φ x) = 0
    rw [hx, map_zero]

  obtain ⟨E, ε, σ, hσ, hε⟩ := hind S (by
    intro p hp
    have h := (Finset.mem_filter.mp hp).2
    rw [← hbc, ← hbc, h])
  haveI : IsAffine W.left := hW
  haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hW
  haveI : IsAffine (Limits.pullback W.hom i) :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst W.hom i)).1
  haveI : WeaklyEtale E.hom := E.prop
  have hK : IsCompact (Set.range σ) := isCompact_range (Scheme.Hom.continuous σ)
  choose Aff hAaff hxA _ using fun z : E.left =>
    exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤)
      (show z ∈ (⊤ : E.left.Opens) from trivial)
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun z => ((Aff z : E.left.Opens) : Set E.left))
    (fun z => (Aff z).isOpen) (fun y _ => Set.mem_iUnion.2 ⟨y, hxA y⟩)
  let eqv := t.equivFin
  refine ⟨t.card, fun j => MorphismProperty.Over.mk ⊤ ((Aff (eqv.symm j).1).ι ≫ E.hom) inferInstance,
    fun j => MorphismProperty.Over.homMk (Aff (eqv.symm j).1).ι rfl trivial ≫ ε,
    fun j => hAaff _, fun j => ?_, ?_⟩
  · apply hcollapse
    intro p hp
    dsimp only
    exact (Category.assoc _ _ _).trans ((congrArg _ (hε p hp)).trans (Category.assoc _ _ _).symm)
  · rintro y ⟨z, rfl⟩
    obtain ⟨w0, hw0, hzw⟩ := Set.mem_iUnion₂.1 (ht ⟨z, rfl⟩)
    refine ⟨eqv ⟨w0, hw0⟩, ?_⟩
    have hk : (eqv.symm (eqv ⟨w0, hw0⟩)).1 = w0 := by simp
    obtain ⟨u0, hu0⟩ : σ z ∈ Set.range (Aff w0).ι := by
      rw [Scheme.Opens.range_ι]; exact hzw
    have hσz : ε.left (σ z) = Limits.pullback.fst W.hom i z := by
      rw [← hσ, Scheme.Hom.comp_apply]
    show Limits.pullback.fst W.hom i z ∈
      Set.range ((Aff (eqv.symm (eqv ⟨w0, hw0⟩)).1).ι ≫ ε.left)
    rw [hk]
    exact ⟨u0, by rw [Scheme.Hom.comp_apply, hu0, hσz]⟩

theorem wc_proet_closed_free_unit_exact {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y]
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush i) (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt)
    (T : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (h : T ⟶ wcFreeSheaf Y V)
    (hh : h ≫ adj.unit.app (wcFreeSheaf Y V) = 0) :
    ∃ (T' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (p : T' ⟶ T)
      (h' : T' ⟶ wcFreeSheaf Y (wcOpenRestr Y O V)),
      Epi p ∧ p ≫ h = h' ≫ wcFreeSheafMap Y (wcOpenRestrIncl Y O V) :=
by
  classical

  let P1 := yoneda.obj (wcOpenRestr Y O V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let P2 := yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let f : P1 ⟶ P2 := Functor.whiskerRight (yoneda.map (wcOpenRestrIncl Y O V))
    (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
  let g := Functor.whiskerRight (yonedaMap (wcProEtBaseChange i) V)
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
    Functor.whiskerLeft (wcProEtBaseChange i).op (toSheafify (Scheme.ProEt.topology Z)
      (yoneda.obj ((wcProEtBaseChange i).obj V) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))

  have hw : f ≫ g = 0 := wc_proet_closed_free_bc_comp_zero i O hO V

  let η0 : wcFreeSheaf Y V ⟶ (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBaseChange i).obj V)) :=
    (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map g
  have hη : adj.unit.app (wcFreeSheaf Y V) ≫
      (wcProEtPush i).map ((adj.homEquiv _ _).symm η0) = η0 := by
    exact (Adjunction.homEquiv_unit adj _ _ ((adj.homEquiv _ _).symm η0)).symm.trans
      (Equiv.apply_symm_apply (adj.homEquiv _ _) η0)
  have hh2 : h ≫ (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map g = 0 := by
    change h ≫ η0 = 0
    rw [← hη, ← Category.assoc, hh, Limits.zero_comp]

  have hcomp2 : ∀ {W₁ W₂ W₃ : Y.ProEt} (k₁ : W₁ ⟶ W₂) (k₂ : W₂ ⟶ W₃)
      (z : P2.obj (Opposite.op W₃)),
      (P2.map k₁.op).hom ((P2.map k₂.op).hom z) = (P2.map (k₁ ≫ k₂).op).hom z := by
    intro W₁ W₂ W₃ k₁ k₂ z
    rw [op_comp, Functor.map_comp]
    rfl
  have hnatf : ∀ {W W' : Y.ProEt} (k : W' ⟶ W) (y : P1.obj (Opposite.op W)),
      (f.app (Opposite.op W')).hom ((P1.map k.op).hom y) =
        (P2.map k.op).hom ((f.app (Opposite.op W)).hom y) := by
    intro W W' k y
    exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) (f.naturality k.op)

  have hex : ∀ (U : Y.ProEt) (x : P2.obj (Opposite.op U)), (g.app (Opposite.op U)).hom x = 0 →
      ∃ R ∈ Scheme.ProEt.topology Y U, ∀ (W : Y.ProEt) (k : W ⟶ U), R.arrows k →
        ∃ y : P1.obj (Opposite.op W), (f.app (Opposite.op W)).hom y = (P2.map k.op).hom x := by
    intro U x hx
    refine ⟨{ arrows := fun W k => ∃ y : P1.obj (Opposite.op W),
                (f.app (Opposite.op W)).hom y = (P2.map k.op).hom x
              downward_closed := by
                intro W W' k hk k'
                obtain ⟨y, hy⟩ := hk
                exact ⟨(P1.map k'.op).hom y, by rw [hnatf, hy, hcomp2]⟩ }, ?_,
      fun W k hk => hk⟩
    apply wc_proet_sieve_of_affine_finite_covers
    intro W v hW
    have gW : (g.app (Opposite.op W)).hom ((P2.map v.op).hom x) = 0 := by
      have h1 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) (g.naturality v.op)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply, hx,
        map_zero] at h1
      exact h1
    haveI : IsAffine W.left := hW
    obtain ⟨n₁, A, a, hAaff, hAemp, hAcov⟩ := wc_closed_compl_proet_finite_cover i W
    obtain ⟨m, W', w, hW'aff, hvan, hcovZ⟩ :=
      wc_proet_closed_free_bc_sheafify_kernel_local i V W hW ((P2.map v.op).hom x) gW
    have h7 : ∀ k : Fin m, ∃ (m' : ℕ) (W'' : Fin m' → Y.ProEt) (e : ∀ j, W'' j ⟶ W' k),
        (∀ j, IsAffine (W'' j).left) ∧
        (∀ j, FreeAbelianGroup.map (fun a : ULift.{u+1} (W' k ⟶ V) =>
          ULift.up.{u+1} (e j ≫ a.down)) ((P2.map (w k).op).hom ((P2.map v.op).hom x)) = 0) ∧
        ∀ y : (W' k).left, y ∈ Set.range (Limits.pullback.fst (W' k).hom i) →
          ∃ j, y ∈ Set.range (e j).left := by
      intro k
      refine wc_proet_closed_free_bc_presheaf_kernel_local i V (W' k) (hW'aff k) _ ?_
      let z : FreeAbelianGroup (ULift.{u+1} (W ⟶ V)) := (P2.map v.op).hom x
      have hz : FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) =>
          ULift.up.{u+1} ((wcProEtBaseChange i).map (w k ≫ a.down))) z = 0 := hvan k
      change FreeAbelianGroup.map (fun a : ULift.{u+1} (W' k ⟶ V) =>
          ULift.up.{u+1} ((wcProEtBaseChange i).map a.down))
        (FreeAbelianGroup.map (fun a : ULift.{u+1} (W ⟶ V) => ULift.up.{u+1} (w k ≫ a.down)) z) = 0
      first
        | (rw [← FreeAbelianGroup.map_comp_apply]; exact hz)
        | (rw [FreeAbelianGroup.map_comp_apply]; exact hz)
        | exact (FreeAbelianGroup.map_comp_apply _ _ _).symm.trans hz
        | exact (FreeAbelianGroup.map_comp_apply _ _ _).trans hz
    choose m' W'' e he_aff he_van he_cov using h7
    let obj : (Fin n₁ ⊕ (Σ k : Fin m, Fin (m' k))) → Y.ProEt := fun s =>
      Sum.elim A (fun p : (Σ k : Fin m, Fin (m' k)) => W'' p.1 p.2) s
    let mp : ∀ s : (Fin n₁ ⊕ (Σ k : Fin m, Fin (m' k))), obj s ⟶ W := fun s =>
      match s with
      | Sum.inl k => a k
      | Sum.inr p => e p.1 p.2 ≫ w p.1
    have haff : ∀ s, IsAffine (obj s).left := by
      rintro (k | ⟨k, j⟩)
      · exact hAaff k
      · exact he_aff k j
    have harr : ∀ s, ∃ y : P1.obj (Opposite.op (obj s)),
        (f.app (Opposite.op (obj s))).hom y = (P2.map (mp s ≫ v).op).hom x := by
      rintro (k | ⟨k, j⟩)
      · obtain ⟨y, hy⟩ := wc_proet_closed_free_openRestr_surj_off i O hO V (A k) (hAemp k)
          ((P2.map (a k).op).hom ((P2.map v.op).hom x))
        exact ⟨y, hy.trans (hcomp2 _ _ _)⟩
      · refine ⟨0, ?_⟩
        show (f.app (Opposite.op (W'' k j))).hom 0 = (P2.map ((e k j ≫ w k) ≫ v).op).hom x
        rw [map_zero, ← hcomp2, ← hcomp2]
        exact (he_van k j).symm
    have hcov : ∀ y : W.left, ∃ s, y ∈ Set.range (mp s).left := by
      intro y
      by_cases hy : y ∈ Set.range (Limits.pullback.fst W.hom i)
      · obtain ⟨k, y', hy'⟩ := hcovZ y hy
        have hy'Z : y' ∈ Set.range (Limits.pullback.fst (W' k).hom i) := by
          rw [Scheme.Pullback.range_fst] at hy ⊢
          show (W' k).hom y' ∈ Set.range i
          rw [← MorphismProperty.Over.w (w k), Scheme.Hom.comp_apply, hy']
          exact hy
        obtain ⟨j, y'', hy''⟩ := he_cov k y' hy'Z
        refine ⟨Sum.inr ⟨k, j⟩, y'', ?_⟩
        show ((e k j).left ≫ (w k).left) y'' = y
        rw [Scheme.Hom.comp_apply, hy'', hy']
      · obtain ⟨k, hk⟩ := hAcov y hy
        exact ⟨Sum.inl k, hk⟩
    refine ⟨Fintype.card (Fin n₁ ⊕ (Σ k : Fin m, Fin (m' k))),
      fun j => obj ((Fintype.equivFin _).symm j),
      fun j => mp ((Fintype.equivFin _).symm j), fun j => haff _, fun y => ?_, fun j => harr _⟩
    obtain ⟨s, hs⟩ := hcov y
    refine ⟨Fintype.equivFin _ s, ?_⟩
    have key : ∀ t, t = s → y ∈ Set.range (mp t).left := by
      rintro t rfl
      exact hs
    exact key _ (Equiv.symm_apply_apply _ _)

  obtain ⟨T', p, h', hp, he⟩ := wc_proet_sheafify_exact_refine Y f g hw hex T h hh2
  exact ⟨T', p, h', hp, he⟩

theorem wc_proet_closed_coker_geom_push_iso (K : Type u) [Field K] [Finite K]
    (Xt E : Over (Spec (.of K))) (iE : E.left ⟶ Xt.left) (hiE : IsClosedImmersion iE)
    (hiEX : iE ≫ Xt.hom = E.hom) (hln : IsLocallyNoetherian Xt.left)
    (Ot : Xt.left.Opens) (hOt : (Ot : Set Xt.left) = (Set.range iE)ᶜ)
    (hXt : WeaklyEtale (Limits.pullback.fst Xt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (hE : WeaklyEtale (Limits.pullback.fst E.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) :
    ∃ κ : (wcProEtPush iE).obj (wcFreeSheaf E.left (wcGeomPoint K E hE)) ≅
        Limits.cokernel (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))),
      ∀ (Ψt : Limits.cokernel (wcFreeSheafMap Xt.left
            (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ⟶
          Limits.cokernel (wcFreeSheafMap Xt.left
            (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt)))),
        Limits.cokernel.π _ ≫ Ψt =
          wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫ Limits.cokernel.π _ →
        (wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)) ≫ κ.hom = κ.hom ≫ Ψt :=
by
  classical
  haveI := hiE
  haveI := hln

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have F1 : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    first
      | (simp [wcFreeSheafMap]; done)
      | (simp [wcFreeSheafMap]; rfl)
      | (unfold wcFreeSheafMap
         rw [yoneda.map_id, Functor.whiskerRight_id']
         exact (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_id _)

  have hfree0 : ∀ (S : Scheme.{u}) (V : S.ProEt), IsEmpty V.left → Limits.IsZero (wcFreeSheaf S V) := by
    intro S V hV
    haveI : Finite V.left := Finite.of_subsingleton
    haveI : QuasiSeparatedSpace V.left := ⟨fun U W _ _ _ _ => (U ∩ W).toFinite.isCompact⟩
    have hcov := proet_finite_affine_jointly_surjective_covers S V 0 (fun i => i.elim0)
      (fun i => i.elim0) (fun i => i.elim0) (fun x => (hV.false x).elim)
    have hbot : (⊥ : Sieve V) ∈ Scheme.ProEt.topology S V := by
      refine (Scheme.ProEt.topology S).superset_covering ?_ hcov
      rintro T f ⟨Y, g, k, hk, -⟩
      cases hk with
      | mk i => exact i.elim0
    obtain ⟨eq, -, -⟩ := proet_free_sheaf_hom_equiv S V
    have hz : Limits.IsZero ((wcFreeSheaf S V).obj.obj (Opposite.op V)) :=
      (Sheaf.isTerminalOfBotCover (wcFreeSheaf S V) V hbot).isZero
    haveI := AddCommGrpCat.subsingleton_of_isZero hz
    haveI : Subsingleton (wcFreeSheaf S V ⟶ wcFreeSheaf S V) := (eq (wcFreeSheaf S V)).subsingleton
    exact (Limits.IsZero.iff_id_eq_zero _).mpr (Subsingleton.elim _ _)

  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat iE
  obtain ⟨e, he⟩ : ∃ e : wcGeomPoint K E hE ≅ (wcProEtPullback iE).obj (wcGeomPoint K Xt hXt),
      e.hom ≫ (wcProEtPullback iE).map (wcGeomFrob K Xt hXt) = wcGeomFrob K E hE ≫ e.hom :=
    wc_geomPoint_pullback_iso K Xt E (Over.homMk iE hiEX) hXt hE
  haveI : (wcProEtPush iE).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : (wcProEtPush iE).PreservesZeroMorphisms := by
    first
      | exact Functor.preservesZeroMorphisms_of_isRightAdjoint _
      | exact inferInstance
  have hun : ∀ {X Y : Sheaf (Scheme.ProEt.topology Xt.left) AddCommGrpCat.{u+1}} (f : X ⟶ Y),
      f ≫ adj.unit.app Y = adj.unit.app X ≫ (wcProEtPush iE).map (L.map f) :=
    fun f => adj.unit.naturality f

  obtain ⟨ζ, hζ⟩ : ∃ ζ : L.obj (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≅
      wcFreeSheaf E.left (wcGeomPoint K E hE),
      ζ.hom = (θ (wcGeomPoint K Xt hXt)).hom ≫ wcFreeSheafMap E.left e.inv :=
    ⟨θ (wcGeomPoint K Xt hXt) ≪≫
      { hom := wcFreeSheafMap E.left e.inv
        inv := wcFreeSheafMap E.left e.hom
        hom_inv_id := by rw [← F0, e.inv_hom_id, F1]
        inv_hom_id := by rw [← F0, e.hom_inv_id, F1] }, rfl⟩

  have he' : (wcProEtPullback iE).map (wcGeomFrob K Xt hXt) ≫ e.inv =
      e.inv ≫ wcGeomFrob K E hE := by
    rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
    exact he
  have hζFr : L.map (wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt)) ≫ ζ.hom =
      ζ.hom ≫ wcFreeSheafMap E.left (wcGeomFrob K E hE) := by
    rw [hζ, ← Category.assoc, hθ, Category.assoc, Category.assoc, ← F0, he', F0]
  have hFr : wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫
      adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≫ (wcProEtPush iE).map ζ.hom =
      adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≫ (wcProEtPush iE).map ζ.hom ≫
        (wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)) := by
    rw [← Category.assoc (wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt)), hun, Category.assoc,
      ← Functor.map_comp, hζFr, Functor.map_comp]

  have hempty : IsEmpty ((wcProEtPullback iE).obj
      (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt))).left := by
    have hmemO : ∀ y : (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).left,
        (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).hom y ∈ (Ot : Set Xt.left) := by
      intro y
      have hU : (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).hom =
          Limits.pullback.fst Ot.ι (wcGeomPoint K Xt hXt).hom ≫ Ot.ι := by
        show Limits.pullback.snd Ot.ι _ ≫ _ = _
        exact Limits.pullback.condition.symm
      rw [hU]
      change Ot.ι (Limits.pullback.fst Ot.ι (wcGeomPoint K Xt hXt).hom y) ∈ (Ot : Set Xt.left)
      rw [← Scheme.Opens.range_ι Ot]
      exact Set.mem_range_self _
    refine ⟨fun z => ?_⟩
    change ↥(Limits.pullback (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).hom iE) at z
    have hc0 := congrArg (fun g => g z)
      (Limits.pullback.condition (f := (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).hom)
        (g := iE))
    have hc : (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).hom
        (Limits.pullback.fst (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).hom iE z) =
        iE (Limits.pullback.snd (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)).hom iE z) := by
      first
        | exact hc0
        | simpa only [Scheme.Hom.comp_apply] using hc0
        | simpa using hc0
    have h1 := hmemO (Limits.pullback.fst _ iE z)
    rw [hc, hOt] at h1
    exact h1 ⟨_, rfl⟩
  have hz0 := hfree0 _ _ hempty
  have hLι : L.map (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ≫
      ζ.hom = 0 := by
    rw [hζ, ← Category.assoc, hθ,
      hz0.eq_of_tgt (θ (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt))).hom 0,
      Limits.zero_comp, Limits.zero_comp]
  have hkill : wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt)) ≫
      (adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≫
        (wcProEtPush iE).map ζ.hom) = 0 := by
    rw [← Category.assoc (wcFreeSheafMap Xt.left
        (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))), hun, Category.assoc,
      ← Functor.map_comp, hLι, Functor.map_zero, Limits.comp_zero]

  let c := Limits.cokernel.desc _ _ hkill
  have hπc : Limits.cokernel.π (wcFreeSheafMap Xt.left
      (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ≫ c =
      adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≫ (wcProEtPush iE).map ζ.hom :=
    Limits.cokernel.π_desc _ _ hkill
  haveI : IsIso ((wcProEtPush iE).map ζ.hom) := inferInstance

  haveI : Epi (adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt))) :=
    wc_proet_closed_free_unit_epi iE L adj _
  haveI : Epi (adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≫
      (wcProEtPush iE).map ζ.hom) := epi_comp _ _
  haveI : Epi c := epi_of_epi_fac hπc

  haveI : Mono c := by
    apply Preadditive.mono_of_cancel_zero
    intro T k hk
    haveI : Epi (Limits.pullback.fst k (Limits.cokernel.π
        (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))))) :=
      Abelian.epi_pullback_of_epi_g _ _
    have hcond := (Limits.pullback.condition (f := k) (g := Limits.cokernel.π
        (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt)))))
    have hq : Limits.pullback.snd k (Limits.cokernel.π
        (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt)))) ≫
        adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) = 0 := by
      apply (cancel_mono ((wcProEtPush iE).map ζ.hom)).mp
      rw [Limits.zero_comp, Category.assoc, ← hπc, ← Category.assoc, ← hcond, Category.assoc, hk,
        Limits.comp_zero]
    obtain ⟨T', p, h', hp, hph⟩ := wc_proet_closed_free_unit_exact iE L adj Ot hOt _ _ _ hq
    haveI := hp
    apply (cancel_epi (p ≫ Limits.pullback.fst k (Limits.cokernel.π
        (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt)))))).mp
    rw [Limits.comp_zero, Category.assoc, hcond, ← Category.assoc, hph, Category.assoc,
      Limits.cokernel.condition, Limits.comp_zero]
  haveI : IsIso c := isIso_of_mono_of_epi c
  refine ⟨(asIso c).symm, fun Ψt hΨt => ?_⟩
  have key : Ψt ≫ c = c ≫ (wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)) := by
    apply (cancel_epi (Limits.cokernel.π
        (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))))).mp
    calc Limits.cokernel.π (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ≫ Ψt ≫ c
        = (Limits.cokernel.π (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ≫ Ψt) ≫ c :=
          (Category.assoc _ _ _).symm
      _ = wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫ (Limits.cokernel.π (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ≫ c) := by
          rw [hΨt, Category.assoc]
      _ = wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫
          adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≫
            (wcProEtPush iE).map ζ.hom := by rw [hπc]
      _ = adj.unit.app (wcFreeSheaf Xt.left (wcGeomPoint K Xt hXt)) ≫
            (wcProEtPush iE).map ζ.hom ≫
              (wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)) := hFr
      _ = (Limits.cokernel.π (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ≫ c) ≫
            (wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)) := by
          rw [hπc, Category.assoc]
      _ = _ := Category.assoc _ _ _
  rw [Iso.symm_hom, asIso_inv, IsIso.comp_inv_eq, Category.assoc, key, IsIso.inv_hom_id_assoc]

theorem wc_proet_push_closed_isLeftAdjoint_ab {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y] :
    (wcProEtPush i).IsLeftAdjoint :=
by
  classical

  have t_s3d : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
      (K : GrothendieckTopology D) [HasSheafify J AddCommGrpCat.{u+1}]
      [HasSheafify K AddCommGrpCat.{u+1}]
      (G : C ⥤ D) {I : Type (u+1)} [Category.{u+1} I] (F : I ⥤ Sheaf K AddCommGrpCat.{u+1}),
      IsIso ((presheafToSheaf J AddCommGrpCat.{u+1}).map (Functor.whiskerLeft G.op
        (toSheafify K (Limits.colimit (F ⋙ sheafToPresheaf K AddCommGrpCat.{u+1}))))) →
      Limits.PreservesColimit F (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙
        (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj G.op ⋙
          presheafToSheaf J AddCommGrpCat.{u+1}) := by
    intro C D _ _ J K _ _ G I _ F hiso
    let W := (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj G.op
    let a := presheafToSheaf J AddCommGrpCat.{u+1}
    let c := Limits.colimit.cocone (F ⋙ sheafToPresheaf K AddCommGrpCat.{u+1})
    let s := Sheaf.sheafifyCocone c
    have hs : Limits.IsColimit s := Sheaf.isColimitSheafifyCocone c (Limits.colimit.isColimit _)
    have hc' : Limits.IsColimit ((W ⋙ a).mapCocone c) :=
      Limits.isColimitOfPreserves (W ⋙ a) (Limits.colimit.isColimit _)
    apply Limits.preservesColimit_of_preserves_colimit_cocone hs
    refine Limits.IsColimit.ofIsoColimit hc' (Limits.Cocone.ext (@asIso _ _ _ _ _ hiso) ?_)
    intro k
    change a.map (W.map (c.ι.app k)) ≫ a.map (W.map (toSheafify K _)) =
      a.map (W.map ((s.ι.app k).hom))
    rw [Sheaf.sheafifyCocone_ι_app_val, ← a.map_comp, ← W.map_comp]
    rfl

  have c1 : ∀ (S : Scheme.{u}) (U : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (f : ∀ k, W k ⟶ U),
      (∀ k, IsOpenImmersion (f k).left) → (∀ x : U.left, ∃ k, x ∈ Set.range (f k).left) →
      Sieve.generate (Presieve.ofArrows W f) ∈ Scheme.ProEt.topology S U := by
    intro S U n W f hf hsurj
    apply Precoverage.generate_mem_toGrothendieck
    show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
      Scheme.proetalePrecoverage).coverings U
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    have hZ : Presieve.ofArrows (fun k => (W k).left) (fun k => (f k).left) ∈
        Scheme.zariskiPrecoverage.coverings U.left :=
      (Scheme.ofArrows_mem_precoverage_iff IsOpenImmersion).mpr ⟨hsurj, hf⟩
    exact (⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left hZ, hZ.1,
      MorphismProperty.ofArrows_mem_precoverage.mpr (fun k => inferInstance)⟩ :
      Presieve.ofArrows (fun k => (W k).left) (fun k => (f k).left) ∈
        Scheme.proetalePrecoverage.coverings U.left)

  have c2 : ∀ (S : Scheme.{u}) (U : S.ProEt), IsAffine U.left → ∀ (R : Sieve U),
      R ∈ Scheme.ProEt.topology S U → ∃ (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ U),
        (∀ k, R.arrows (h k)) ∧ (∀ k, IsAffine (W k).left) ∧
        ∀ x : U.left, ∃ k, x ∈ Set.range (h k).left := by
    intro S U hU R hR
    have h1 := (CoverPreserving.of_isContinuous (Scheme.ProEt.forget S) (Scheme.ProEt.topology S)
      (Scheme.proetaleTopology.over S)).cover_preserve hR
    rw [GrothendieckTopology.mem_over_iff] at h1
    obtain ⟨R', hR', hle⟩ := Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition.mp h1
    obtain ⟨𝒰, hqc, rfl⟩ :=
