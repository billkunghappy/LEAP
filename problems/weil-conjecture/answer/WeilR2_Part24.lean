            D'.φ).map e).val.app (Opposite.op V)).hom
            (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h0
        have hB := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom
          (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h1
        exact hA.trans hB
      have h2 : eF (ρV V 1) = 1 := h2'.trans h3
      have h4 : ∀ y, eF y = y * eF 1 := by
        intro y
        have h := (e.val.app (Opposite.op ((wcEtBaseChange i').obj V))).hom.map_smul y
          (1 : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))))
        exact (congrArg eF (mul_one y).symm).trans h
      exact ⟨ρV V 1, eF 1, rfl, (h4 _).symm.trans h2⟩
    have hrefl : (SheafOfModules.toSheaf (wcEtZModRing Y' n)).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcEtZModRing Y' n))
    haveI : Sheaf.IsLocallySurjective
        ((SheafOfModules.toSheaf (wcEtZModRing Y' n)).map (wcEtSuppUnitMap D')) := by
      refine Presheaf.IsLocallySurjective.mk (fun {V} m => ?_)
      apply hcov
      intro v
      let m' : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) := m
      obtain ⟨s, t, hs, hst⟩ := huntw V
      obtain ⟨O, hvO, k, hk⟩ := hres V v (t * m')
      have hm : m' = s * (t * m') := by rw [← mul_assoc, hst, one_mul]
      refine ⟨wcEtOpen Y' V O, wcEtOpenι Y' V O, ⟨v, hvO⟩,
        ⟨(k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))), ?_⟩, ?_, rfl⟩
      · change ρV (wcEtOpen Y' V O)
            (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
          ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom m'
        have e1 : ρV (wcEtOpen Y' V O)
            (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
            (k : ↑((wcEtZModRing X' n).obj.obj
              (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O))))) *
              ρV (wcEtOpen Y' V O) 1 := by
          have hk1 : (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
              k • (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) :=
            (Int.smul_one_eq_cast k).symm
          rw [hk1, map_zsmul, zsmul_eq_mul]
        have e2 : ρV (wcEtOpen Y' V O) 1 =
            ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom
              (ρV V 1) := by
          have h := PresheafOfModules.naturality_apply (wcEtSuppUnitMap D').val
            (wcEtOpenι Y' V O).op (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))
          have h1' : ((wcEtZModRing Y' n).obj.map (wcEtOpenι Y' V O).op).hom
              (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V))) = 1 := map_one _
          exact (congrArg (ρV (wcEtOpen Y' V O)) h1'.symm).trans h
        rw [e1, e2, hs, hm, map_mul, hk]
        exact Int.cast_comm _ _
      · show Etale O.ι
        infer_instance
    exact Sheaf.epi_of_isLocallySurjective _
  haveI : Epi (wcEtSuppUnitMap D') := hepi

  have hval : ∀ φ₁ φ₂ : SheafOfModules.unit (wcEtZModRing Y' n) ⟶ N,
      (∀ U : Y'.Etale, (φ₁.val.app (Opposite.op U)).hom (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U)) =
        (φ₂.val.app (Opposite.op U)).hom (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U))) → φ₁ = φ₂ := by
    intro φ₁ φ₂ h
    apply N.unitHomEquiv.injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    exact h X.unop

  have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
      (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
      T ∈ Scheme.smallEtaleTopology S V := by
    intro S V T h
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h
  have hsep : Presheaf.IsSeparated (Scheme.smallEtaleTopology X') (wcEtZModRing X' n).obj :=
    Sheaf.isSeparated (wcEtZModRing X' n)
  have hempty : ∀ (Q : X'.Etale), IsEmpty Q.left →
      ∀ a b : ↑((wcEtZModRing X' n).obj.obj (Opposite.op Q)), a = b := by
    intro Q hQ a b
    exact hsep Q ⊥ (hcov X' Q ⊥ (fun v => isEmptyElim v)) a b (fun _ _ h => False.elim h)
  refine ⟨?_, ?_, ?_⟩
  · intro ψ₁ ψ₂ h
    exact (cancel_epi (wcEtSuppUnitMap D')).mp (hval _ _ h)
  · intro ψ U hU
    haveI : Subsingleton ((wcEtSuppObj D').val.obj (Opposite.op U)) :=
      ⟨fun a b => hempty ((wcEtBaseChange i').obj U) hU a b⟩
    have h0 : ((wcEtSuppUnitMap D').val.app (Opposite.op U)).hom
        (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U)) = 0 := Subsingleton.elim _ _
    change (ψ.val.app (Opposite.op U)).hom (((wcEtSuppUnitMap D').val.app (Opposite.op U)).hom
      (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U))) = 0
    rw [h0]
    exact map_zero _
  · intro v hcompat hvan
    obtain ⟨s, hs⟩ : ∃ s : N.val.sections, ∀ X : (Y'.Etale)ᵒᵖ, s.1 X = v X.unop :=
      ⟨PresheafOfModules.sectionsMk (M := N.val) (fun X => v X.unop)
        (fun X Y f => (hcompat X.unop Y.unop f.unop).symm),
        fun X => PresheafOfModules.sectionsMk_coe _ _ X⟩
    obtain ⟨w, hw⟩ : ∃ w : SheafOfModules.unit (wcEtZModRing Y' n) ⟶ N, N.unitHomEquiv w = s :=
      ⟨N.unitHomEquiv.symm s, Equiv.apply_symm_apply _ _⟩
    have Hw : ∀ U : Y'.Etale, (w.val.app (Opposite.op U)).hom
        (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U)) = v U := by
      intro U
      rw [← SheafOfModules.unitHomEquiv_apply_coe, hw]
      exact hs (Opposite.op U)
    have hk : Limits.kernel.ι (wcEtSuppUnitMap D') ≫ w = 0 :=
      kerkill i' D' N w (fun U hU => (Hw U).trans (hvan U hU))
    refine ⟨Abelian.epiDesc (wcEtSuppUnitMap D') w hk, fun U => ?_⟩
    exact (congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Y' n) ⟶ N =>
      (φ.val.app (Opposite.op U)).hom (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U)))
      (Abelian.comp_epiDesc (wcEtSuppUnitMap D') w hk)).trans (Hw U)

theorem wc_srdcbR_derived_homology_bridge {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasDerivedCategory 𝒜]
    {𝒜' : Type*} [Category 𝒜'] [Abelian 𝒜'] [HasDerivedCategory 𝒜'] [EnoughInjectives 𝒜']
    (P : 𝒜' ⥤ 𝒜) [P.Additive] (M' : 𝒜') (I : InjectiveResolution M')
    (h1 : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj
      ((HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).obj M'))) (q : ℕ) :
    Nonempty ((DerivedCategory.homologyFunctor 𝒜 (q : ℤ)).obj
      ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj (⟨_, h1⟩ : DerivedCategory.Plus 𝒜')) ≅
      ((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  have hInj : ∀ n : ℤ, (isInjective 𝒜') (I.cochainComplex.X n) :=
    fun n => (inferInstance : Injective (I.cochainComplex.X n))
  let L₀ : CochainComplex (InjectiveObject 𝒜') ℤ :=
    HomologicalComplex.liftObjectProperty (isInjective 𝒜') I.cochainComplex hInj
  have hL₀ : L₀.IsStrictlyGE 0 := by
    rw [← CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff L₀ (InjectiveObject.ι 𝒜') 0]
    exact (inferInstance : I.cochainComplex.IsStrictlyGE 0)
  let L : CochainComplex.Plus (InjectiveObject 𝒜') := ⟨L₀, ⟨0, hL₀⟩⟩
  let J : CochainComplex.Plus 𝒜' := (InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L
  let Y : DerivedCategory.Plus 𝒜' := ⟨_, h1⟩
  let e' : DerivedCategory.Plus.ι.obj (DerivedCategory.Plus.Q.obj J) ≅
      DerivedCategory.Plus.ι.obj Y :=
    (DerivedCategory.Plus.QCompιIso 𝒜').app J ≪≫
      (asIso (DerivedCategory.Q.map I.ι')).symm
  let e : DerivedCategory.Plus.Q.obj J ≅ Y := DerivedCategory.Plus.ι.preimageIso e'
  let E : DerivedCategory.Q.obj ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      I.cochainComplex) ≅ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y :=
    ((DerivedCategory.Plus.QCompιIso 𝒜).app (P.mapCochainComplexPlus.obj J)).symm ≪≫
      DerivedCategory.Plus.ι.mapIso (asIso (P.rightDerivedFunctorPlusUnit.app J)) ≪≫
      DerivedCategory.Plus.ι.mapIso (P.rightDerivedFunctorPlus.mapIso e)
  let H1 : (DerivedCategory.homologyFunctor 𝒜 (q : ℤ)).obj
      ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y) ≅
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).homology (q : ℤ) :=
    (DerivedCategory.homologyFunctor 𝒜 (q : ℤ)).mapIso E.symm ≪≫
      (DerivedCategory.homologyFunctorFactors 𝒜 (q : ℤ)).app
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
  have hext : Nonempty ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (I.cocomplex.extend ComplexShape.embeddingUpNat) ≅
        ((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat) := by
    let K := I.cocomplex
    let K' := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj K
    let ψ : (o : Option ℕ) →
        (P.obj (HomologicalComplex.extend.X K o) ≅ HomologicalComplex.extend.X K' o) :=
      fun o => match o with
        | some a => Iso.refl (P.obj (K.X a))
        | none => Limits.IsZero.iso (P.map_isZero (Limits.isZero_zero 𝒜'))
            (Limits.isZero_zero 𝒜)
    have s2 : ∀ o o' : Option ℕ, (ψ o).hom ≫ HomologicalComplex.extend.d K' o o' =
        P.map (HomologicalComplex.extend.d K o o') ≫ (ψ o').hom := by
      intro o o'
      cases o with
      | none => exact (P.map_isZero (Limits.isZero_zero 𝒜')).eq_of_src _ _
      | some a =>
        cases o' with
        | none => exact (Limits.isZero_zero 𝒜).eq_of_tgt _ _
        | some b =>
          show 𝟙 _ ≫ P.map (K.d a b) = P.map (K.d a b) ≫ 𝟙 _
          rw [Category.id_comp, Category.comp_id]
    exact ⟨HomologicalComplex.Hom.isoOfComponents
      (fun n => ψ (ComplexShape.embeddingUpNat.r n)) (fun n m _ => s2 _ _)⟩
  obtain ⟨φ⟩ := hext
  let H2 : ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).homology (q : ℤ) ≅
      ((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q :=
    HomologicalComplex.homologyMapIso φ (q : ℤ) ≪≫
      ((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extendHomologyIso
        ComplexShape.embeddingUpNat (ComplexShape.embeddingUpNat_f q)
  exact ⟨H1 ≪≫ H2⟩

theorem wc_srdcbR_open_iso_higher_vanish : ∀ {Y X' : Scheme.{u}} (b : X' ⟶ Y) (V : Y.Opens), IsIso (b ∣_ V) → ∀ (m : ℕ), 0 < m → ∀ (Db : wcEtPullData b m) (Dj : wcEtPullData V.ι m) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X' m))) (q : ℕ), 1 ≤ q → haveI := Db.additive; letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont Db.φ).Additive := Adjunction.right_adjoint_additive Db.adj; Limits.IsZero (Dj.Φ.obj ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont Db.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :=
by
  intro Y X' b V hV m _hm Db Dj I q hq
  haveI := Db.additive
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont
    Db.φ).Additive := Adjunction.right_adjoint_additive Db.adj
  obtain ⟨q', rfl⟩ := Nat.exists_eq_add_of_le' hq

  have hK0 : Limits.IsZero ((((SheafOfModules.toSheaf (wcEtZModRing X' m)).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex).homology (q' + 1)) := by
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology X')
      (wcEtZModRing X' m)
    rw [← HomologicalComplex.exactAt_iff_isZero_homology,
      HomologicalComplex.exactAt_iff' _ q' (q' + 1) (q' + 2) (CochainComplex.prev_nat_succ q')
        (CochainComplex.next ℕ (q' + 1))]
    have hI := I.cocomplex_exactAt_succ q'
    rw [HomologicalComplex.exactAt_iff' _ q' (q' + 1) (q' + 2) (CochainComplex.prev_nat_succ q')
        (CochainComplex.next ℕ (q' + 1))] at hI
    exact hI.map (SheafOfModules.toSheaf (wcEtZModRing X' m))

  have hloc0 := wc_et_sheaf_exact_local _ q' hK0
  have hkill := wc_et_locKill_iso_locus Y X' b (V : Set Y) V.isOpen
    (fun U hU => by
      obtain rfl : U = V := TopologicalSpace.Opens.ext hU
      exact hV) _ q' hloc0

  have hcov : ∀ (V0 : Y.Etale) (T : Sieve V0), (∀ v : V0.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V0),
      T.arrows c ∧ v ∈ Set.range c.left) → T ∈ Scheme.smallEtaleTopology Y V0 := by
    intro V0 T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale Y V0
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hT x
    have hw : c.left ≫ V0.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V0.hom := V0.prop
      have h2 : Etale (c.left ≫ V0.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V0.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  let S1 := ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont
    Db.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).sc' q' (q' + 1) (q' + 2)).map
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m))
  let Sp := S1.map (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
  have hloc : ∀ (V0 : Y.Etale) (c : Sp.X₂.obj (Opposite.op V0)),
      (Sp.g.app (Opposite.op V0)).hom c = 0 →
      ∀ v : V0.left, V0.hom v ∈ (V : Set Y) →
      ∃ (W : Y.Etale) (g' : W ⟶ V0) (w : W.left) (e : Sp.X₁.obj (Opposite.op W)),
        g'.left w = v ∧ (Sp.f.app (Opposite.op W)).hom e = (Sp.X₂.map g'.op).hom c :=
    fun V0 c hc v hv => hkill V0 c hc v hv

  have sB : ∀ (V0 : Y.Etale), (∀ v : V0.left, V0.hom v ∈ (V : Set Y)) →
      ∀ (z : Sp.homology.obj (Opposite.op V0)),
        Presheaf.equalizerSieve (F := Sp.homology) (X := Opposite.op V0) z 0 ∈
          Scheme.smallEtaleTopology Y V0 := by
    intro V0 hV0 z
    have hπ : Epi (Sp.homologyπ.app (Opposite.op V0)) :=
      (NatTrans.epi_iff_epi_app _).1 inferInstance _
    obtain ⟨k, rfl⟩ := (AddCommGrpCat.epi_iff_surjective _).1 hπ z
    have hι : ∀ X, Function.Injective (ConcreteCategory.hom (Sp.iCycles.app X)) := fun X =>
      (AddCommGrpCat.mono_iff_injective _).1 ((NatTrans.mono_iff_mono_app _).1 inferInstance X)
    have hc : (Sp.g.app (Opposite.op V0)).hom ((Sp.iCycles.app (Opposite.op V0)).hom k) = 0 := by
      have := congrArg (fun φ => (φ.app (Opposite.op V0)).hom k) Sp.iCycles_g
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply, NatTrans.app_zero, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] at this
      exact this
    apply hcov
    intro v
    obtain ⟨W, g', w, e, hw, he⟩ := hloc V0 _ hc v (hV0 v)
    refine ⟨W, g', ?_, w, hw⟩
    rw [Presheaf.equalizerSieve_apply, map_zero]
    have h1 : ConcreteCategory.hom (Sp.cycles.map g'.op) k =
        ConcreteCategory.hom (Sp.toCycles.app (Opposite.op W)) e := by
      apply hι
      rw [NatTrans.naturality_apply]
      have n2 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) Sp.toCycles_i
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply] at n2
      exact (he.symm.trans n2.symm)
    rw [← NatTrans.naturality_apply, h1]
    have n3 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) Sp.toCycles_comp_homologyπ
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      Function.comp_apply] at n3
    simpa using n3

  have sC : ∀ (V0 : Y.Etale), (∀ v : V0.left, V0.hom v ∈ (V : Set Y)) →
      ∀ σ : ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        Sp.homology).obj.obj (Opposite.op V0), σ = 0 := by
    intro V0 hV0 σ
    let η := toSheafify (Scheme.smallEtaleTopology Y) Sp.homology
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η σ
    have hR : Presheaf.equalizerSieve
        (F := ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          Sp.homology).obj) (X := Opposite.op V0) σ 0 ∈ Scheme.smallEtaleTopology Y V0 := by
      refine GrothendieckTopology.transitive _ hI _ ?_
      intro V₁ f hf
      obtain ⟨t, ht⟩ := hf
      have hV₁ : ∀ x : V₁.left, V₁.hom x ∈ (V : Set Y) := by
        intro x
        have hw : f.left ≫ V0.hom = V₁.hom := MorphismProperty.Over.w f
        rw [← hw]
        exact hV0 (f.left x)
      refine GrothendieckTopology.superset_covering _ ?_ (sB V₁ hV₁ t)
      intro V₂ g hg
      rw [Presheaf.equalizerSieve_apply, map_zero] at hg
      rw [Sieve.pullback_apply, Presheaf.equalizerSieve_apply, map_zero]
      change (sheafify (Scheme.smallEtaleTopology Y) Sp.homology).map (g ≫ f).op σ = 0
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, ← ht,
        ← NatTrans.naturality_apply, hg, map_zero]
    exact Sheaf.isSeparated _ V0 _ hR σ 0 (fun _ _ hf => hf)

  have hsec : ∀ (W : Y.Etale), (∀ w : W.left, W.hom w ∈ (V : Set Y)) →
      ∀ s : ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj ((((@SheafOfModules.pushforward.{u+1}
        _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont Db.φ).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).homology (q' + 1))).obj.obj (Opposite.op W),
        s = 0 := by
    intro W hW s
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Y)
      (wcEtZModRing Y m)
    let E := (SheafOfModules.toSheaf (wcEtZModRing Y m)).mapIso
        ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont
          Db.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyIsoSc'
          q' (q' + 1) (q' + 2) (CochainComplex.prev_nat_succ q') (CochainComplex.next ℕ (q' + 1))) ≪≫
      (ShortComplex.mapHomologyIso ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcEtBaseChange b) _ _ Db.cont Db.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).sc' q' (q' + 1) (q' + 2)) (SheafOfModules.toSheaf (wcEtZModRing Y m))).symm ≪≫
      ShortComplex.homologyMapIso
        (ShortComplex.mapNatIso S1 (sheafificationNatIso (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1})) ≪≫
      Sp.mapHomologyIso (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    let e' := (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
      (evaluation _ _).obj (Opposite.op W)).mapIso E
    have h1 : e'.hom s = 0 := sC W hW _
    rw [← Iso.hom_inv_id_apply e' s, h1, map_zero]

  haveI hc := (wc_et_slice_continuous
    (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) : Y.Etale)).1
  obtain ⟨φ, ⟨e⟩⟩ := @wc_et_open_pull_data_restr_iso _ V m Dj hc
  refine Limits.IsZero.of_iso ?_ (e.app _)
  rw [Limits.IsZero.iff_id_eq_zero]
  apply (SheafOfModules.toSheaf (wcEtZModRing (V : Scheme.{u}) m) ⋙
    sheafToPresheaf _ _).map_injective
  apply Limits.IsZero.eq_of_src
  apply Functor.isZero
  intro W'
  have hW' : ∀ w : ((wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
      Y.Etale)).obj W'.unop).left,
      ((wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
        Y.Etale)).obj W'.unop).hom w ∈ (V : Set Y) := by
    intro w
    change V.ι (W'.unop.hom w) ∈ (V : Set Y)
    exact (W'.unop.hom w).2
  exact @AddCommGrpCat.isZero_of_subsingleton _
    ⟨fun x y => (hsec _ hW' x).trans (hsec _ hW' y).symm⟩

theorem wc_srdcbR_betas_proper_iso_off_plane (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] (n : ℕ) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (c : Matrix (Fin n) (Fin n) A) (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c))) (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n => (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ : Fin n)))))) β) (hprop : IsProper β) (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f') (βs : Limits.pullback f' (wcQmSp A) ⟶ Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (hβs1 : βs ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) = Limits.pullback.fst f' (wcQmSp A) ≫ β) (hβs2 : βs ≫ Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A) = Limits.pullback.snd f' (wcQmSp A)) : IsProper βs ∧ ∀ U : (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).Opens, (U : Set _) = (⇑(Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) ⁻¹' PrimeSpectrum.zeroLocus {r | ∃ p : Fin n, p.val % 2 = 0 ∧ Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) = r})ᶜ → IsIso (βs ∣_ U) :=
by

  have s4 : ∀ {X X₁ Y Y₁ : Scheme.{u}} (b : X₁ ⟶ X) (g : Y ⟶ X) (g₁ : Y₁ ⟶ X₁) (b₁ : Y₁ ⟶ Y),
      IsPullback g₁ b₁ b g → ∀ (W : X.Opens), IsIso (b ∣_ W) → IsIso (b₁ ∣_ (g ⁻¹ᵁ W)) := by
    intro X X₁ Y Y₁ b g g₁ b₁ hsq W hW
    have s := ((isPullback_morphismRestrict b₁ (g ⁻¹ᵁ W)).flip).paste_horiz hsq
    rw [← morphismRestrict_ι g W] at s
    have t := (isPullback_morphismRestrict b W).flip
    have r := IsPullback.of_right (v₁₁ := b₁ ∣_ (g ⁻¹ᵁ W)) (h₂₁ := g ∣_ W)
      (h₁₁ := t.lift ((b₁ ⁻¹ᵁ (g ⁻¹ᵁ W)).ι ≫ g₁) ((b₁ ∣_ (g ⁻¹ᵁ W)) ≫ (g ∣_ W)) (by
        rw [s.w, Category.assoc])) ?_ ?_ t
    · exact r.isIso_snd_of_isIso
    · rwa [t.lift_fst]
    · exact t.lift_snd _ _ _

  have s3 : ((Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
            Fin n)))))).support : Set (Spec (.of (wcQuadModelRing A n π c)))) =
      PrimeSpectrum.zeroLocus {r | ∃ p : Fin n, p.val % 2 = 0 ∧
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) = r} := by
    rw [Scheme.IdealSheafData.coe_support_ofIdealTop, Scheme.zeroLocus_span, Set.range_comp',
      Spec_zeroLocus_eq_zeroLocus]
    congr 1
    ext r
    simp only [Set.mem_range, Set.mem_setOf_eq]
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨_, Nat.mul_mod_right 2 _, rfl⟩
    · rintro ⟨p, hp, rfl⟩
      refine ⟨p, ?_⟩
      congr 2
      ext
      exact Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero hp)

  have hsq : IsPullback (Limits.pullback.fst f' (wcQmSp A)) βs β
      (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) := by
    refine IsPullback.of_bot ?_ hβs1.symm
      (IsPullback.of_hasPullback (wcQuadModelStr A n π c) (wcQmSp A))
    rw [hβs2, hf']
    exact IsPullback.of_hasPullback f' (wcQmSp A)
  refine ⟨MorphismProperty.of_isPullback (P := @IsProper) hsq hprop, ?_⟩
  intro U hU
  set I := Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
            Fin n))))) with hI
  let W : (Spec (.of (wcQuadModelRing A n π c))).Opens :=
    ⟨((I.support : Set (Spec (.of (wcQuadModelRing A n π c)))))ᶜ, I.support.isClosed.isOpen_compl⟩
  have hW : IsIso (β ∣_ W) := by

    have blow : ∀ (X X' : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (W : X.Opens),
        wcCsdIsBlowup I r → (I.support : Set X) ∩ (W : Set X) = ∅ → IsIso (r ∣_ W) := by
      intro X X' I r W hb hW
      obtain ⟨-, hUniq⟩ := hb
      have H : ∀ (T : Scheme.{u}) (h : T ⟶ X), (∀ t : T, h t ∉ (I.support : Set X)) →
          wcCsdInvPull I h := by
        intro T h hh t
        obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
          exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := h t) trivial
        have hns : h t ∉ X.zeroLocus (U := U₀) (I.ideal ⟨U₀, hU₀⟩ : Set Γ(X, U₀)) := by
          rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
          exact hh t
        rw [Scheme.mem_zeroLocus_iff] at hns
        push_neg at hns
        obtain ⟨a, haI, hxa⟩ := hns
        have htD : t ∈ h ⁻¹ᵁ X.basicOpen a := (Scheme.Hom.mem_preimage h).mpr hxa
        obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
        have hVD : V₀ ≤ h ⁻¹ᵁ X.basicOpen a := hV₀sub
        have hVU : V₀ ≤ h ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono h (X.basicOpen_le a))
        refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV₀, haI, ?_⟩
        have hbo : T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) = V₀ := by
          rw [Scheme.basicOpen_appLE]
          exact inf_eq_left.mpr hVD
        have hunit : IsUnit ((h.appLE U₀ V₀ hVU).hom a) := by
          apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace V₀
          intro y hy
          have hy' : y ∈ T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) := by rw [hbo]; exact hy
          exact (T.mem_basicOpen _ y hy).mp hy'
        refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
        rw [Ideal.span_singleton_eq_top.mpr hunit]
        exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ haI) hunit
      have memι : ∀ (V : X'.Opens) (z : V.toScheme), V.ι z ∈ V := by
        intro V z
        have hz : V.ι z ∈ Set.range V.ι := ⟨z, rfl⟩
        rwa [Scheme.Opens.range_ι] at hz
      have memW : ∀ y : W.toScheme, W.ι y ∈ W := by
        intro y
        have hy : W.ι y ∈ Set.range W.ι := ⟨y, rfl⟩
        rwa [Scheme.Opens.range_ι] at hy
      have hWav : ∀ y : W.toScheme, W.ι y ∉ (I.support : Set X) := by
        intro y hy
        have hmem : W.ι y ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hy, memW y⟩
        rw [hW] at hmem
        exact hmem
      obtain ⟨s, hs, -⟩ := hUniq W.toScheme W.ι (H _ _ hWav)
      have hrange : Set.range s ⊆ Set.range (r ⁻¹ᵁ W).ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨y, rfl⟩
        show s y ∈ r ⁻¹ᵁ W
        rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hs]
        exact memW y
      haveI : Mono W.ι := IsOpenImmersion.mono W.ι
      haveI : Mono (r ⁻¹ᵁ W).ι := IsOpenImmersion.mono (r ⁻¹ᵁ W).ι
      let s' := IsOpenImmersion.lift (r ⁻¹ᵁ W).ι s hrange
      have hs' : s' ≫ (r ⁻¹ᵁ W).ι = s := IsOpenImmersion.lift_fac _ _ _
      have h4 : s' ≫ (r ∣_ W) = 𝟙 _ := by
        rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hs', hs,
          Category.id_comp]
      have hιav : ∀ z : (r ⁻¹ᵁ W).toScheme, ((r ⁻¹ᵁ W).ι ≫ r) z ∉ (I.support : Set X) := by
        intro z hz
        have hz1 : (r ⁻¹ᵁ W).ι z ∈ r ⁻¹ᵁ W := memι (r ⁻¹ᵁ W) z
        rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply] at hz1
        have hmem : ((r ⁻¹ᵁ W).ι ≫ r) z ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hz, hz1⟩
        rw [hW] at hmem
        exact hmem
      have hh := H _ _ hιav
      have h5 : (r ∣_ W) ≫ s' = 𝟙 _ := by
        rw [← cancel_mono (r ⁻¹ᵁ W).ι, Category.id_comp]
        apply (hUniq _ _ hh).unique
        · simp only [Category.assoc]
          rw [reassoc_of% hs', hs, morphismRestrict_ι]
        · rfl
      exact IsIso.mk ⟨s', h5, h4⟩
    exact blow _ X' I β W hbl (Set.inter_compl_self _)
  have hUW : U = (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) ⁻¹ᵁ W := by
    apply TopologicalSpace.Opens.ext
    rw [hU, Scheme.Hom.coe_preimage]
    show _ = _ ⁻¹' ((I.support : Set (Spec (.of (wcQuadModelRing A n π c)))))ᶜ
    rw [s3]
    rfl
  subst hUW
  exact s4 β _ _ βs hsq W hW

theorem wc_etqm_srt_iso_push {Y Y' : Scheme.{u}} (g : Y' ⟶ Y) [IsIso g] (m : ℕ)
    (D : wcEtPullData g m) :
    Limits.PreservesFiniteColimits
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ) ∧
      IsIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _
        D.cont D.φ) :=
by
  haveI := D.cont

  have hSurj : ∀ (Z : Scheme.{u}) (V : Z.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Z V →
      ∀ y : V.left, ∃ (V₁ : Z.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
    intro Z V R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
    exact ⟨V₁, c, w, hc, hw⟩
  have hjs : ∀ (Z : Scheme.{u}) (V : Z.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Z.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Z V := by
    intro Z V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Z V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  haveI hcoc : (wcEtBaseChange g).IsCocontinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Y') := by
    constructor
    intro U S hS
    apply hjs
    intro u
    obtain ⟨W, f, w, hf, hw⟩ := hSurj Y' _ S hS (inv (Limits.pullback.fst U.hom g) u)
    have hfw : f.left ≫ Limits.pullback.snd U.hom g = W.hom := MorphismProperty.Over.w f
    haveI hWet : Etale W.hom := W.prop
    let V : Y.Etale := MorphismProperty.Over.mk ⊤ (W.hom ≫ g) inferInstance
    have hcw : (f.left ≫ Limits.pullback.fst U.hom g) ≫ U.hom = V.hom :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun k => f.left ≫ k) Limits.pullback.condition).trans
          ((Category.assoc _ _ _).symm.trans (congrArg (fun k => k ≫ g) hfw)))
    let c : V ⟶ U := MorphismProperty.Over.homMk (f.left ≫ Limits.pullback.fst U.hom g) hcw trivial
    have hφw : Limits.pullback.fst V.hom g ≫ W.hom = Limits.pullback.snd V.hom g :=
      (cancel_mono g).mp ((Category.assoc _ _ _).trans Limits.pullback.condition)
    let φ : (wcEtBaseChange g).obj V ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.fst V.hom g) hφw trivial
    have h0 : (Limits.pullback.fst V.hom g ≫ c.left) ≫ U.hom = Limits.pullback.snd V.hom g ≫ g :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun k => Limits.pullback.fst V.hom g ≫ k) (MorphismProperty.Over.w c)).trans
          Limits.pullback.condition)
    let m' : Limits.pullback V.hom g ⟶ Limits.pullback U.hom g :=
      Limits.pullback.lift (Limits.pullback.fst V.hom g ≫ c.left) (Limits.pullback.snd V.hom g) h0
    have hm : ((wcEtBaseChange g).map c).left = m' := rfl
    have hm' : m' = Limits.pullback.fst V.hom g ≫ f.left := by
      apply Limits.pullback.hom_ext
      · exact (Limits.pullback.lift_fst _ _ _).trans (Category.assoc _ _ _).symm
      · exact (Limits.pullback.lift_snd _ _ _).trans (hφw.symm.trans
          ((congrArg (fun k => Limits.pullback.fst V.hom g ≫ k) hfw).symm.trans
            (Category.assoc _ _ _).symm))
    have hmap : (wcEtBaseChange g).map c = φ ≫ f :=
      MorphismProperty.Over.Hom.ext (hm.trans hm')
    refine ⟨V, c, ?_, w, ?_⟩
    · show S.arrows ((wcEtBaseChange g).map c)
      rw [hmap]
      exact S.downward_closed hf φ
    · show (f.left ≫ Limits.pullback.fst U.hom g) w = u
      have hu : (inv (Limits.pullback.fst U.hom g) ≫ Limits.pullback.fst U.hom g) u = u := by
        first
          | exact (congrArg (fun h : U.left ⟶ U.left => h u) (IsIso.inv_hom_id _)).trans rfl
          | simp
          | (rw [IsIso.inv_hom_id]; rfl)
      exact (Scheme.Hom.comp_apply _ _ w).trans
        ((congrArg (fun z => (Limits.pullback.fst U.hom g) z) hw).trans
          ((Scheme.Hom.comp_apply _ _ u).symm.trans hu))
  refine ⟨?_, ?_⟩
  ·
    have hTS : ∀ {C : Type (u+1)} [Category.{u} C]
        (J : GrothendieckTopology C)
        [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
        (R : Sheaf J RingCat.{u+1}), Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) := by
      intro C _ J _ _ R
      constructor
      intro I _ _
      constructor
      intro K
      let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 R.obj)
      haveI : IsIso adj.counit := inferInstance
      haveI hP : Limits.PreservesColimitsOfShape I
          (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimitsOfShape_of_natIso
          (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 R.obj)).symm
      let K₀ := K ⋙ (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj))
      let c₀ := Limits.colimit.cocone K₀
      let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
      have ht : Limits.IsColimit
          ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀) :=
        Limits.isColimitOfPreserves _ h₀
      have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R).mapCocone
          ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀)) :=
        Limits.IsColimit.ofIsoColimit
          (Limits.isColimitOfPreserves
            (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) h₀)
          (Functor.mapCoconeMapCocone c₀).symm
      haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj))
          (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
      let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ≅ K :=
        Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫ Functor.rightUnitor K
      exact Limits.preservesColimit_of_iso_diagram _ e
    haveI := hTS (Scheme.smallEtaleTopology Y) (wcEtZModRing Y m)
    haveI := hTS (Scheme.smallEtaleTopology Y') (wcEtZModRing Y' m)
    have adjB := (wcEtBaseChange g).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y')
    haveI := adjB.leftAdjoint_preservesColimits.{0, 0}
    haveI : Limits.PreservesFiniteColimits ((wcEtBaseChange g).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y')) :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits _
    constructor
    intro I _ _
    haveI : Limits.PreservesColimitsOfShape I
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ ⋙
          SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) :=
      Limits.preservesColimitsOfShape_of_natIso
        (F := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y' m) ⋙
          (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
            (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y')) (Iso.refl _)
    haveI : Limits.ReflectsColimitsOfShape I (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact Limits.preservesColimitsOfShape_of_reflects_of_preserves
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ)
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m))
  ·
    let γ : wcEtZModRing Y m ≅ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange g)
        RingCat.{u+1} _ (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y') D.cont).obj
        (wcEtZModRing Y' m) :=
      (Functor.pushforwardContinuousSheafificationCompatibility (wcEtBaseChange g) RingCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y')).app
        ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod m))))
    have huniq : ∀ (S : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1})
        (f g : wcEtZModRing Y m ⟶ S), f = g := by
      intro S f g
      let P : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
        (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod m)))
      let adj := sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}
      let f' : (presheafToSheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).obj P ⟶ S := f
      let g' : (presheafToSheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).obj P ⟶ S := g
      show f' = g'
      apply (adj.homEquiv P S).injective
      apply NatTrans.ext
      funext U
      apply RingCat.hom_ext
      apply RingHom.ext
      intro x
      let e : ZMod m →+* ULift.{u+1} (ZMod m) := (ULift.ringEquiv).symm.toRingHom
      let a : ULift.{u+1} (ZMod m) →+* ↑(S.obj.obj U) := ((adj.homEquiv P S f').app U).hom
      let b : ULift.{u+1} (ZMod m) →+* ↑(S.obj.obj U) := ((adj.homEquiv P S g').app U).hom
      have hab := RingHom.ext_zmod (a.comp e) (b.comp e)
      exact congrArg (fun h => h x.down) hab
    have hψ : D.φ = γ.hom := huniq _ _ _
    rw [hψ]
    let u := SheafOfModules.unitToPushforwardObjUnit γ.hom
    show IsIso u
    have hU : ∀ U, IsIso (((PresheafOfModules.toPresheaf _).map
        ((SheafOfModules.forget _).map u)).app U) := by
      intro U
      have hb : Function.Bijective
          (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map
            ((SheafOfModules.forget _).map u)).app U)) :=
        ConcreteCategory.bijective_of_isIso (γ.hom.hom.app U)
      have h2 : IsIso ((forget AddCommGrpCat.{u+1}).map (((PresheafOfModules.toPresheaf _).map
            ((SheafOfModules.forget _).map u)).app U)) :=
        (isIso_iff_bijective _).mpr hb
      exact isIso_of_reflects_iso _ (forget AddCommGrpCat.{u+1})
    have h3 : IsIso ((PresheafOfModules.toPresheaf _).map
        ((SheafOfModules.forget _).map u)) := NatIso.isIso_of_isIso_app _
    have h4 : IsIso ((SheafOfModules.forget _).map u) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf _)
    exact isIso_of_reflects_iso u (SheafOfModules.forget _)

theorem wc_etqm_srt_bc_coherence {S : Scheme.{u}} {m : ℕ}
    {XE : Scheme.{u}} {p : XE ⟶ S} {Xm : Scheme.{u}} {g : Xm ⟶ S}
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {βE : XE' ⟶ XE} (hβp : βE ≫ p = p' ≫ g)
    {w : XE ⟶ XE} (hw₁ : w ≫ p = p) {w' : XE' ⟶ XE'} (hw₁' : w' ≫ p' = p')
    (hwβ : w' ≫ βE = βE ≫ w)
    (Dg : wcEtPullData g m) (Dp : wcEtPullData p m) (Dτ : wcEtPullData w m)
    (Dp' : wcEtPullData p' m) (Dτ' : wcEtPullData w' m) (DβE : wcEtPullData βE m) :
    haveI := Dp.cont
    haveI := Dτ.cont
    haveI : (wcEtBaseChange p ⋙ wcEtBaseChange w).IsContinuous (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology XE) :=
      Functor.isContinuous_comp (wcEtBaseChange p) (wcEtBaseChange w) (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology XE) (Scheme.smallEtaleTopology XE)
    let α : wcEtBaseChange p ⟶ wcEtBaseChange p ⋙ wcEtBaseChange w :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) p :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) p :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p)) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) w p p hw₁.symm).hom
    ∀ (hφ : (Dp.φ ≫ ((wcEtBaseChange p).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology XE)).map Dτ.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology XE)).app (wcEtZModRing XE m) = Dp.φ),
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dτ.cont Dτ.φ
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Dp.φ Dτ.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    haveI := Dp'.cont
    haveI := Dτ'.cont
    haveI : (wcEtBaseChange p' ⋙ wcEtBaseChange w').IsContinuous (Scheme.smallEtaleTopology Xm)
        (Scheme.smallEtaleTopology XE') :=
      Functor.isContinuous_comp (wcEtBaseChange p') (wcEtBaseChange w') (Scheme.smallEtaleTopology Xm)
        (Scheme.smallEtaleTopology XE') (Scheme.smallEtaleTopology XE')
    let α' : wcEtBaseChange p' ⟶ wcEtBaseChange p' ⋙ wcEtBaseChange w' :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) p' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) p' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p')) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) w' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) w' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w')) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) w' p' p' hw₁'.symm).hom
    ∀ (hφ' : (Dp'.φ ≫ ((wcEtBaseChange p').sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology Xm) (Scheme.smallEtaleTopology XE')).map Dτ'.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α' RingCat.{u+1}
          (Scheme.smallEtaleTopology Xm) (Scheme.smallEtaleTopology XE')).app (wcEtZModRing XE' m) = Dp'.φ),
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange p') _ _ Dp'.cont Dp'.φ
    let Pw' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w') _ _ Dτ'.cont Dτ'.φ
    let γ' : Pw' ⋙ P' ⟶ P' := (SheafOfModules.pushforwardComp Dp'.φ Dτ'.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α' ≫ (SheafOfModules.pushforwardCongr hφ').hom
    let Pg := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ
    haveI := DβE.cont
    let PE := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange βE) _ _ DβE.cont DβE.φ
    ∃ (β : P' ⋙ Pg ≅ PE ⋙ P) (βw : Pw' ⋙ PE ⟶ PE ⋙ Pw),
      (∀ M : SheafOfModules.{u+1} (wcEtZModRing XE' m),
        Pg.map (γ'.app M) ≫ β.hom.app M =
          β.hom.app (Pw'.obj M) ≫ P.map (βw.app M) ≫ γ.app (PE.obj M)) ∧
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange βE) _ _ DβE.cont DβE.φ ≫
          PE.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcEtBaseChange w') _ _ Dτ'.cont Dτ'.φ) ≫
          βw.app (SheafOfModules.unit (wcEtZModRing XE' m)) =
        @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dτ.cont Dτ.φ ≫
          Pw.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcEtBaseChange βE) _ _ DβE.cont DβE.φ)) :=
by
  have zmodExt : ∀ (Y : Scheme.{u}) (m : ℕ)
      (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (φ ψ : wcEtZModRing Y m ⟶ R),
      φ = ψ := by
    intro Y m R φ ψ
    have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod m) →+* T), f = g := by
      intro T _ f g
      have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom =
          g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom :=
        Subsingleton.elim _ _
      ext x
      exact RingHom.congr_fun h x.down
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv _
      R).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    exact key _ _ _
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst B.hom h =
        Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.snd B.hom h =
        Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have natAux : ∀ {A₁ A₂ Q₁ Q₂ B' V₁ V₂ X₁ X₂ Y₁ Y₂ : Scheme.{u}} {mA : A₁ ⟶ A₂} {mQ : Q₁ ⟶ Q₂}
      {e₁ : A₁ ⟶ Q₁} {e₂ : A₂ ⟶ Q₂} {sA₁ : A₁ ⟶ B'} {sA₂ : A₂ ⟶ B'} {sQ₁ : Q₁ ⟶ B'}
      {sQ₂ : Q₂ ⟶ B'} {fA₁ : A₁ ⟶ X₁} {fA₂ : A₂ ⟶ X₂} {gA₁ : X₁ ⟶ V₁} {gA₂ : X₂ ⟶ V₂}
      {mX : X₁ ⟶ X₂} {fQ₁ : Q₁ ⟶ Y₁} {fQ₂ : Q₂ ⟶ Y₂} {gQ₁ : Y₁ ⟶ V₁} {gQ₂ : Y₂ ⟶ V₂}
      {mY : Y₁ ⟶ Y₂} {a : V₁ ⟶ V₂}
      (he₁s : e₁ ≫ sQ₁ = sA₁) (he₂s : e₂ ≫ sQ₂ = sA₂)
      (he₁f : e₁ ≫ fQ₁ ≫ gQ₁ = fA₁ ≫ gA₁) (he₂f : e₂ ≫ fQ₂ ≫ gQ₂ = fA₂ ≫ gA₂)
      (hmAs : mA ≫ sA₂ = sA₁) (hmAf : mA ≫ fA₂ = fA₁ ≫ mX) (hmX : mX ≫ gA₂ = gA₁ ≫ a)
      (hmQs : mQ ≫ sQ₂ = sQ₁) (hmQf : mQ ≫ fQ₂ = fQ₁ ≫ mY) (hmY : mY ≫ gQ₂ = gQ₁ ≫ a)
      (hext : ∀ φ ψ : A₁ ⟶ Q₂, φ ≫ sQ₂ = ψ ≫ sQ₂ → φ ≫ fQ₂ ≫ gQ₂ = ψ ≫ fQ₂ ≫ gQ₂ → φ = ψ),
      mA ≫ e₂ = e₁ ≫ mQ := by
    intro A₁ A₂ Q₁ Q₂ B' V₁ V₂ X₁ X₂ Y₁ Y₂ mA mQ e₁ e₂ sA₁ sA₂ sQ₁ sQ₂ fA₁ fA₂ gA₁ gA₂ mX
      fQ₁ fQ₂ gQ₁ gQ₂ mY a he₁s he₂s he₁f he₂f hmAs hmAf hmX hmQs hmQf hmY hext
    apply hext
    · simp only [Category.assoc]
      rw [he₂s, hmAs, hmQs, he₁s]
    · simp only [Category.assoc]
      rw [he₂f, reassoc_of% hmAf, hmX, reassoc_of% hmQf, hmY, reassoc_of% he₁f]
  have s1 : ∀ {Y A B C : Scheme.{u}} (f1 : A ⟶ Y) (f2 : B ⟶ A) (h1 : C ⟶ Y) (h2 : B ⟶ C)
