        (PadicInt.toZModPow (p := ℓ) (j + 1)).toAddMonoidHom (hc (j + 1)))) (add_zero (n - 1))}
  let f : ∀ j, X (j + 1) → X j := fun j y =>
    ⟨y.1.comp (Abelian.Ext.mk₀ (wcContSheafMap D.Yt.left (wcTowerCast ℓ (j + 1))
