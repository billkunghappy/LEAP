    exact ⟨(⟨y, hy⟩ : X j.unop)⟩
  obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system G
  have hcompat : ∀ j, (f j (sec (Opposite.op (j + 1)))).1 = (sec (Opposite.op j)).1 := by
