    (hS : (ShortComplex.mk f g hfg).ShortExact) (q : ℕ) (N : ℤ) (hqN : (q : ℤ) + 1 = N)
    (hA : ∀ e : Abelian.Ext T A q, e = 0) (hB : ∀ e : Abelian.Ext T B q, e = 0) :
    ∃ ν : (DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj X₃))⟦(-1 : ℤ)⟧ ⟶
        DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj X₁),
