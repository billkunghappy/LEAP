  let E₀ : Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S A) j ≃+
      Abelian.Ext (F.obj (wcFreeSheaf U₀.left V)) (wcContSheaf S A) j :=
    { toFun := fun x => (Abelian.Ext.mk₀ p.hom).comp x (zero_add j)
      invFun := fun y => (Abelian.Ext.mk₀ p.inv).comp y (zero_add j)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add j) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add j) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
  refine ⟨(E₀.trans adj.extEquiv).toAddMonoidHom, (E₀.trans adj.extEquiv).bijective, ?_⟩
  intro z
  show adj.extEquiv ((Abelian.Ext.mk₀ p.hom).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp z (zero_add j)) (zero_add j)) =
    (Abelian.Ext.mk₀ (wcFreeSheafMap U₀.left a')).comp
      (adj.extEquiv ((Abelian.Ext.mk₀ p.hom).comp z (zero_add j))) (zero_add j)
  rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hp, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hE]

theorem wc_proet_geom_lift_scaled_twist (K : Type u) [Field K] [Finite K]
    (Xo : Over (Spec (.of K)))
    (hX : WeaklyEtale (Limits.pullback.fst Xo.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (k : ℕ)
    (V : Xo.left.ProEt) (a : V ⟶ V) (g : V ⟶ wcGeomPoint K Xo hX)
    (hg : a ≫ g = g ≫ wcGeomFrob K Xo hX) :
    ∃ φ : ((Scheme.ProEt.topology Xo.left).overPullback AddCommGrpCat.{u+1} V).obj
          (wcRootTwist Xo.left (ℓ ^ k) 1) ⟶
        ((Scheme.ProEt.topology Xo.left).overPullback AddCommGrpCat.{u+1} V).obj
          (wcContSheaf Xo.left (ZMod (ℓ ^ k))),
      IsIso φ ∧ ∀ W' : Over V, φ.hom.app (Opposite.op (Over.mk (W'.hom ≫ a))) =
        Nat.card K • φ.hom.app (Opposite.op W') :=
by
  obtain ⟨ρ, hρi, hρs, hρF⟩ := wc_root_twist_slice_presheaf_map K Xo ℓ hℓ hX k 1
  obtain ⟨ψ, hψiso, hψF⟩ := wc_slice_sheafify_scaled_iso Xo.left (wcGeomPoint K Xo hX)
    (wcGeomFrob K Xo hX) (wcRootTwistPre Xo.left (ℓ ^ k) 1) (wcZModSheaf Xo.left (ℓ ^ k)) ρ
    (Nat.card K ^ 1) hρi hρs hρF
  let φ : ((Scheme.ProEt.topology Xo.left).overPullback AddCommGrpCat.{u+1} V).obj
          (wcRootTwist Xo.left (ℓ ^ k) 1) ⟶
        ((Scheme.ProEt.topology Xo.left).overPullback AddCommGrpCat.{u+1} V).obj
          (wcContSheaf Xo.left (ZMod (ℓ ^ k))) :=
    ((Scheme.ProEt.topology Xo.left).overMapPullback AddCommGrpCat.{u+1} g).map ψ
  have hφapp : ∀ W' : Over V, φ.hom.app (Opposite.op W') =
      ψ.hom.app (Opposite.op (Over.mk (W'.hom ≫ g))) := fun W' => rfl
  have key : ∀ (W' : Over V) (x y : W'.left ⟶ wcGeomPoint K Xo hX), x = y →
      ψ.hom.app (Opposite.op (Over.mk x)) = ψ.hom.app (Opposite.op (Over.mk y)) := by
    rintro _ _ _ rfl; rfl
  refine ⟨φ, ?_, ?_⟩
  · haveI := hψiso
    exact Functor.map_isIso ((Scheme.ProEt.topology Xo.left).overMapPullback
      AddCommGrpCat.{u+1} g) ψ
  · intro W'
    have e := hψF (Over.mk (W'.hom ≫ g))
    rw [pow_one] at e
    rw [hφapp, hφapp]
    refine (key W' ((W'.hom ≫ a) ≫ g) ((W'.hom ≫ g) ≫ wcGeomFrob K Xo hX) ?_).trans e
    rw [Category.assoc, hg, Category.assoc]

theorem wc_proet_closed_push_free_coker_nat {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y] (V T : Y.ProEt) (jT : T ⟶ V)
    (hjT : IsOpenImmersion jT.left) (hr : Set.range jT.left = {z | V.hom z ∉ Set.range i})
    (a : V ⟶ V)
    (Ψ : Limits.cokernel (wcFreeSheafMap Y jT) ⟶ Limits.cokernel (wcFreeSheafMap Y jT))
    (hΨ : Limits.cokernel.π (wcFreeSheafMap Y jT) ≫ Ψ =
      wcFreeSheafMap Y a ≫ Limits.cokernel.π (wcFreeSheafMap Y jT)) :
    ∃ κ : (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtPullback i).obj V)) ≅
        Limits.cokernel (wcFreeSheafMap Y jT),
      (wcProEtPush i).map (wcFreeSheafMap Z ((wcProEtPullback i).map a)) ≫ κ.hom = κ.hom ≫ Ψ :=
by
  classical
  haveI := hjT

  have F0 : ∀ {S : Scheme.{u}} {U V T : S.ProEt} (a : U ⟶ V) (b : V ⟶ T),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V T a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have hfree0 : ∀ (S : Scheme.{u}) (W : S.ProEt), IsEmpty W.left →
      Limits.IsZero (wcFreeSheaf S W) := by
    intro S W hW
    haveI : Finite W.left := Finite.of_subsingleton
    haveI : QuasiSeparatedSpace W.left := ⟨fun U W _ _ _ _ => (U ∩ W).toFinite.isCompact⟩
    have hcov := proet_finite_affine_jointly_surjective_covers S W 0 (fun i => i.elim0)
      (fun i => i.elim0) (fun i => i.elim0) (fun x => (hW.false x).elim)
    have hbot : (⊥ : Sieve W) ∈ Scheme.ProEt.topology S W := by
      refine (Scheme.ProEt.topology S).superset_covering ?_ hcov
      rintro T f ⟨Y, g, k, hk, -⟩
      cases hk with
      | mk i => exact i.elim0
    obtain ⟨eq, -, -⟩ := proet_free_sheaf_hom_equiv S W
    have hz : Limits.IsZero ((wcFreeSheaf S W).obj.obj (Opposite.op W)) :=
      (Sheaf.isTerminalOfBotCover (wcFreeSheaf S W) W hbot).isZero
    haveI := AddCommGrpCat.subsingleton_of_isZero hz
    haveI : Subsingleton (wcFreeSheaf S W ⟶ wcFreeSheaf S W) := (eq (wcFreeSheaf S W)).subsingleton
    exact (Limits.IsZero.iff_id_eq_zero _).mpr (Subsingleton.elim _ _)

  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat i
  haveI : (wcProEtPush i).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : (wcProEtPush i).PreservesZeroMorphisms := by
    first
      | exact Functor.preservesZeroMorphisms_of_isRightAdjoint _
      | exact inferInstance
  have hun : ∀ {X X' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f : X ⟶ X'),
      f ≫ adj.unit.app X' = adj.unit.app X ≫ (wcProEtPush i).map (L.map f) :=
    fun f => adj.unit.naturality f

  let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hO : (O : Set Y) = (Set.range i)ᶜ := rfl
  have hsub : Set.range (wcOpenRestrIncl Y O V).left ⊆ Set.range jT.left := by
    rintro _ ⟨y, rfl⟩
    have hU : (wcOpenRestrIncl Y O V).left ≫ V.hom = Limits.pullback.fst O.ι V.hom ≫ O.ι := by
      show Limits.pullback.snd O.ι V.hom ≫ V.hom = _
      exact Limits.pullback.condition.symm
    have hc0 := congrArg (fun g => g y) hU
    have hc : V.hom ((wcOpenRestrIncl Y O V).left y) =
        O.ι (Limits.pullback.fst O.ι V.hom y) := by
      first
        | exact hc0
        | simpa only [Scheme.Hom.comp_apply] using hc0
        | simpa using hc0
    have hm : O.ι (Limits.pullback.fst O.ι V.hom y) ∈ (O : Set Y) := by
      rw [← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    rw [hr]
    show V.hom ((wcOpenRestrIncl Y O V).left y) ∉ Set.range i
    rw [hc]
    exact hm
  have hσl : IsOpenImmersion.lift jT.left (wcOpenRestrIncl Y O V).left hsub ≫ jT.left =
      (wcOpenRestrIncl Y O V).left := IsOpenImmersion.lift_fac _ _ _
  obtain ⟨σ, hσ⟩ : ∃ σ : wcOpenRestr Y O V ⟶ T, σ ≫ jT = wcOpenRestrIncl Y O V := by
    refine ⟨MorphismProperty.Over.homMk
      (IsOpenImmersion.lift jT.left (wcOpenRestrIncl Y O V).left hsub) ?_ trivial, ?_⟩
    · rw [← MorphismProperty.Over.w jT, ← Category.assoc, hσl,
        MorphismProperty.Over.w (wcOpenRestrIncl Y O V)]
    · apply MorphismProperty.Over.Hom.ext
      exact hσl

  have hempty : IsEmpty ((wcProEtPullback i).obj T).left := by
    refine ⟨fun z => ?_⟩
    change ↥(Limits.pullback T.hom i) at z
    have hc0 := congrArg (fun g => g z) (Limits.pullback.condition (f := T.hom) (g := i))
    have hc : T.hom (Limits.pullback.fst T.hom i z) = i (Limits.pullback.snd T.hom i z) := by
      first
        | exact hc0
        | simpa only [Scheme.Hom.comp_apply] using hc0
        | simpa using hc0
    have hT0 := congrArg (fun g => g (Limits.pullback.fst T.hom i z)) (MorphismProperty.Over.w jT)
    have hT : V.hom (jT.left (Limits.pullback.fst T.hom i z)) =
        T.hom (Limits.pullback.fst T.hom i z) := by
      first
        | exact hT0
        | simpa only [Scheme.Hom.comp_apply] using hT0
        | simpa using hT0
    have hmem : jT.left (Limits.pullback.fst T.hom i z) ∈ Set.range jT.left := ⟨_, rfl⟩
    rw [hr] at hmem
    have h2 : V.hom (jT.left (Limits.pullback.fst T.hom i z)) ∈ Set.range i := by
      rw [hT, hc]
      exact ⟨_, rfl⟩
    exact hmem h2
  have hz0 := hfree0 _ _ hempty
  have hLj : L.map (wcFreeSheafMap Y jT) ≫ (θ V).hom = 0 := by
    rw [hθ, hz0.eq_of_tgt (θ T).hom 0, Limits.zero_comp]
  let g : wcFreeSheaf Y V ⟶ (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtPullback i).obj V)) :=
    adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom
  have hkill : wcFreeSheafMap Y jT ≫ g = 0 := by
    show wcFreeSheafMap Y jT ≫
      (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom) = 0
    rw [← Category.assoc, hun, Category.assoc, ← Functor.map_comp, hLj, Functor.map_zero,
      Limits.comp_zero]
  haveI : IsIso ((wcProEtPush i).map (θ V).hom) := inferInstance

  have hmono : Mono (wcFreeSheafMap Y jT) := by
    apply wc_free_sheaf_map_mono
    infer_instance

  haveI : Epi (adj.unit.app (wcFreeSheaf Y V)) := wc_proet_closed_free_unit_epi i L adj V
  have hepi : Epi g := by
    haveI h2 : Epi ((wcProEtPush i).map (θ V).hom) := IsIso.epi_of_iso _
    have h3 : Epi (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom) :=
      epi_comp _ _
    exact h3

  have hexact : (ShortComplex.mk (wcFreeSheafMap Y jT) g hkill).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro A x₂ hx
    have hq : x₂ ≫ adj.unit.app (wcFreeSheaf Y V) = 0 := by
      apply (cancel_mono ((wcProEtPush i).map (θ V).hom)).mp
      rw [Limits.zero_comp, Category.assoc]
      exact hx
    obtain ⟨T', p, h', hp, hph⟩ := wc_proet_closed_free_unit_exact i L adj O hO V A x₂ hq
    refine ⟨T', p, hp, h' ≫ wcFreeSheafMap Y σ, ?_⟩
    show p ≫ x₂ = (h' ≫ wcFreeSheafMap Y σ) ≫ wcFreeSheafMap Y jT
    rw [hph, Category.assoc, ← F0, hσ]
  have hS : (ShortComplex.mk (wcFreeSheafMap Y jT) g hkill).ShortExact :=
    ShortComplex.ShortExact.mk' hexact hmono hepi

  let κ0 := hS.gIsCokernel.coconePointUniqueUpToIso
    (Limits.cokernelIsCokernel (wcFreeSheafMap Y jT))
  have hκ0 : g ≫ κ0.hom = Limits.cokernel.π (wcFreeSheafMap Y jT) := by
    first
      | exact hS.gIsCokernel.comp_coconePointUniqueUpToIso_hom
          (Limits.cokernelIsCokernel (wcFreeSheafMap Y jT)) Limits.WalkingParallelPair.one
      | simpa using hS.gIsCokernel.comp_coconePointUniqueUpToIso_hom
          (Limits.cokernelIsCokernel (wcFreeSheafMap Y jT)) Limits.WalkingParallelPair.one
  obtain ⟨κ, hgκ⟩ : ∃ κ : (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtPullback i).obj V)) ≅
      Limits.cokernel (wcFreeSheafMap Y jT),
      g ≫ κ.hom = Limits.cokernel.π (wcFreeSheafMap Y jT) := ⟨κ0, hκ0⟩

  have hg : wcFreeSheafMap Y a ≫ g =
      g ≫ (wcProEtPush i).map (wcFreeSheafMap Z ((wcProEtPullback i).map a)) := by
    show wcFreeSheafMap Y a ≫ (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom) =
      (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom) ≫
        (wcProEtPush i).map (wcFreeSheafMap Z ((wcProEtPullback i).map a))
    rw [← Category.assoc, hun, Category.assoc, ← Functor.map_comp, hθ a, Functor.map_comp,
      Category.assoc]

  refine ⟨κ, ?_⟩
  haveI := hepi
  have e1 : g ≫ (wcProEtPush i).map (wcFreeSheafMap Z ((wcProEtPullback i).map a)) ≫ κ.hom =
      wcFreeSheafMap Y a ≫ Limits.cokernel.π (wcFreeSheafMap Y jT) := by
    rw [← Category.assoc, ← hg, Category.assoc, hgκ]
  have e2 : g ≫ κ.hom ≫ Ψ = wcFreeSheafMap Y a ≫ Limits.cokernel.π (wcFreeSheafMap Y jT) := by
    rw [← Category.assoc, hgκ, hΨ]
  exact (cancel_epi g).mp (e1.trans e2.symm)

theorem wc_smooth_divisor_proet_mu_purity_ext (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (m j N : ℕ) (hjN : j + 2 = N)
    (P : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) :
    ∃ gP : Abelian.Ext P (wcContSheaf Z (ZMod (ℓ ^ m))) j →+
        Abelian.Ext ((wcProEtPush i).obj P) (wcRootTwist Y (ℓ ^ m) 1) N,
      Function.Bijective gP ∧
      ∀ (φ : P ⟶ P) (y : Abelian.Ext P (wcContSheaf Z (ZMod (ℓ ^ m))) j),
        gP ((Abelian.Ext.mk₀ φ).comp y (zero_add j)) =
          (Abelian.Ext.mk₀ ((wcProEtPush i).map φ)).comp (gP y) (zero_add N) :=
by
  classical

  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI hln : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY

  haveI := wc_proet_push_closed_isLeftAdjoint_ab i
  obtain ⟨Li, adjL, -, -⟩ := wc_proet_push_left_adjoint_free_nat i
  haveI := wc_proet_push_closed_preservesFiniteColimits i
  haveI : (wcProEtPush i).IsRightAdjoint := ⟨_, ⟨adjL⟩⟩
  haveI : Limits.PreservesFiniteLimits (wcProEtPush i) := inferInstance
  haveI : (wcProEtPush i).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : (wcProEtPush i).Additive := Functor.additive_of_preserves_binary_products _
  let adj := Adjunction.ofIsLeftAdjoint (wcProEtPush i)
  haveI : ((wcProEtPush i).rightAdjoint).Additive := Adjunction.right_adjoint_additive adj

  let I := injectiveResolution (wcRootTwist Y (ℓ ^ m) 1)
  have hvan : ∀ q : ℕ, q ≠ 2 → Limits.IsZero (((((wcProEtPush i).rightAdjoint).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex).homology q) := by
    intro q hq
    rcases Nat.lt_or_gt_of_ne hq with h | h
    · exact wc_smooth_divisor_proet_mu_shriek_low_vanish k pY d i ℓ hℓ m
        (wcProEtPush i).rightAdjoint adj I q h
    · exact wc_smooth_divisor_proet_mu_shriek_high_vanish k pY d i ℓ hℓ m
        (wcProEtPush i).rightAdjoint adj I q h
  obtain ⟨ψ, hψ⟩ := wc_smooth_divisor_proet_mu_shriek_top_iso k pY d i ℓ hℓ m
    (wcProEtPush i).rightAdjoint adj I
  haveI := hψ

  obtain ⟨τ, hτ⟩ := ext_shifted_degenerate_leray_bijective (wcProEtPush i)
    (wcProEtPush i).rightAdjoint adj (wcRootTwist Y (ℓ ^ m) 1) I
    (wcContSheaf Z (ZMod (ℓ ^ m))) 2 ψ hvan

  let gHom : Abelian.Ext P (wcContSheaf Z (ZMod (ℓ ^ m))) j →+
      Abelian.Ext ((wcProEtPush i).obj P) (wcRootTwist Y (ℓ ^ m) 1) N :=
    AddMonoidHom.mk' (fun y => (Abelian.Ext.mapExactFunctor (wcProEtPush i) y).comp τ hjN)
      (fun a c => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  refine ⟨gHom, hτ P j N hjN, ?_⟩

  intro φ y
  show (Abelian.Ext.mapExactFunctor (wcProEtPush i)
      ((Abelian.Ext.mk₀ φ).comp y (zero_add j))).comp τ hjN =
    (Abelian.Ext.mk₀ ((wcProEtPush i).map φ)).comp
      ((Abelian.Ext.mapExactFunctor (wcProEtPush i) y).comp τ hjN) (zero_add N)
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
  exact Abelian.Ext.comp_assoc _ _ _ (zero_add j) hjN (by omega)

theorem wc_proet_open_slice_closed_pullback_iso {S Z : Scheme.{u}} (i : Z ⟶ S) (W : S.Opens)
    (V : (W : Scheme.{u}).ProEt) (a : V ⟶ V) :
    ∃ βZ : (wcSliceFunctor Z (Scheme.ProEt.mk (i ⁻¹ᵁ W).ι)).obj ((wcProEtPullback (i ∣_ W)).obj V) ≅
        (wcProEtPullback i).obj ((wcSliceFunctor S (Scheme.ProEt.mk W.ι)).obj V),
      βZ.hom ≫ (wcProEtPullback i).map ((wcSliceFunctor S (Scheme.ProEt.mk W.ι)).map a) =
        (wcSliceFunctor Z (Scheme.ProEt.mk (i ⁻¹ᵁ W).ι)).map ((wcProEtPullback (i ∣_ W)).map a) ≫ βZ.hom :=
by
  have hP : IsPullback (Limits.pullback.fst V.hom (i ∣_ W))
      (Limits.pullback.snd V.hom (i ∣_ W) ≫ (i ⁻¹ᵁ W).ι) (V.hom ≫ W.ι) i :=
    (IsPullback.of_hasPullback V.hom (i ∣_ W)).paste_vert (isPullback_morphismRestrict i W)
  have ha : a.left ≫ V.hom = V.hom := MorphismProperty.Over.w a
  have h1 : (Limits.pullback.fst V.hom (i ∣_ W) ≫ a.left) ≫ V.hom =
      Limits.pullback.snd V.hom (i ∣_ W) ≫ (i ∣_ W) := by
    rw [Category.assoc, ha]; exact Limits.pullback.condition
  have h2 : (Limits.pullback.fst (V.hom ≫ W.ι) i ≫ a.left) ≫ V.hom ≫ W.ι =
      Limits.pullback.snd (V.hom ≫ W.ι) i ≫ i := by
    rw [Category.assoc, ← Category.assoc a.left, ha]; exact Limits.pullback.condition
  refine ⟨MorphismProperty.Over.isoMk hP.isoPullback hP.isoPullback_hom_snd, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  change hP.isoPullback.hom ≫ Limits.pullback.lift
      (Limits.pullback.fst (V.hom ≫ W.ι) i ≫ a.left) (Limits.pullback.snd (V.hom ≫ W.ι) i) h2 =
    Limits.pullback.lift (Limits.pullback.fst V.hom (i ∣_ W) ≫ a.left)
      (Limits.pullback.snd V.hom (i ∣_ W)) h1 ≫ hP.isoPullback.hom
  apply Limits.pullback.hom_ext
  · simp only [Category.assoc, Limits.pullback.lift_fst, IsPullback.isoPullback_hom_fst,
      IsPullback.isoPullback_hom_fst_assoc]
  · simp only [Category.assoc, Limits.pullback.lift_snd, IsPullback.isoPullback_hom_snd,
      Limits.pullback.lift_snd_assoc]

theorem wc_mtube_punct_supp_gysin (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀) (φh : Th ⟶ Th)
    (hφh : φh ≫ g = g ≫ (wcProEtPullback D.f).map φ₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (VT : D.Yt.left.ProEt) (jc : VT ⟶ Th) (hjc : IsOpenImmersion jc.left)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (φV : VT ⟶ VT) (hφV : φV ≫ jc = jc ≫ φh)
    (Tη : D.Yt.left.ProEt) (jη : Tη ⟶ VT) (hjη : IsOpenImmersion jη.left)
    (hrη : Set.range jη.left = {z | D.f (VT.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')})
    (Φη : Limits.cokernel (wcFreeSheafMap D.Yt.left jη) ⟶ Limits.cokernel (wcFreeSheafMap D.Yt.left jη))
    (hΦη : Limits.cokernel.π (wcFreeSheafMap D.Yt.left jη) ≫ Φη =
      wcFreeSheafMap D.Yt.left φV ≫ Limits.cokernel.π (wcFreeSheafMap D.Yt.left jη))
    (k : ℕ) :
    ∃ Gy : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i))
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj VT))
          (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) (n - 2) →+
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap D.Yt.left jη))
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) n,
      Function.Bijective Gy ∧
      ∀ y, (Abelian.Ext.mk₀ Φη).comp (Gy y) (zero_add n) =
        Nat.card F'' • Gy ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map φV))).comp y (zero_add (n - 2))) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V T : S.ProEt} (a : U ⟶ V) (b : V ⟶ T),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V T a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  have hY : WeaklyEtale (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  let O : D.Yt.left.Opens :=
    ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ, isClosed_closure.isOpen_compl⟩
  have hW : WeaklyEtale (Limits.pullback.fst (Over.mk (O.ι ≫ D.Yt.hom)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')

  have hℓ' : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI : Fintype F'' := Fintype.ofFinite F''
    have hq0 : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F''
    have hcop : Nat.Coprime ℓ (Nat.card F'') :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : ℓ.Prime)).2 hℓ
    obtain ⟨a, b, hab⟩ := Nat.isCoprime_iff_coprime.2 hcop
    have h2 := congrArg (Int.cast : ℤ → F'') hab
    push_cast at h2
    rw [h0, hq0] at h2
    simp at h2

  have hSi : IsClosedImmersion (D.S i) := by
    haveI : IsClosedImmersion (D.S i ≫ (wcP1Over F'').hom) := by
      rw [D.hS i]; infer_instance
    haveI : IsSeparated (wcP1Over F'').hom := by
      show IsSeparated (@Proj.toSpecZero _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom (algebraMap F''
          ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0))))
      infer_instance
    exact IsClosedImmersion.of_comp (D.S i) (wcP1Over F'').hom
  haveI hιc : IsClosedImmersion (Limits.pullback.fst D.f (D.S i)) := by
    first
      | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback _ _).flip hSi
      | (haveI := hSi; infer_instance)
  haveI hic : IsClosedImmersion (Limits.pullback.fst D.f (D.S i) ∣_ O) :=
    IsZariskiLocalAtTarget.restrict hιc O

  haveI hsmYt : SmoothOfRelativeDimension n D.Yt.hom := D.smooth
  haveI hsmO : SmoothOfRelativeDimension (n - 1 + 1) (O.ι ≫ D.Yt.hom) := by
    have h := smoothOfRelativeDimension_comp 0 n O.ι D.Yt.hom
    rw [zero_add] at h
    rwa [Nat.sub_add_cancel (by omega : 1 ≤ n)]
  haveI hpr : IsProper D.Yt.hom := D.proper
  haveI hnoeth : IsLocallyNoetherian (O : Scheme.{u}) := by
    first
      | exact LocallyOfFiniteType.isLocallyNoetherian (O.ι ≫ D.Yt.hom)
      | infer_instance
  haveI hsmZ0 : SmoothOfRelativeDimension (n - 1)
      ((Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O).ι ≫ Limits.pullback.snd D.f (D.S i)) :=
    wc_bm_punct_fibre_smooth F' F'' Y n hn2 D i
  have hcomp : (Limits.pullback.fst D.f (D.S i) ∣_ O) ≫ O.ι ≫ D.Yt.hom =
      (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O).ι ≫ Limits.pullback.snd D.f (D.S i) := by
    rw [← Category.assoc, morphismRestrict_ι, Category.assoc, ← D.hf,
      Limits.pullback.condition_assoc, D.hS i, Category.comp_id]
  haveI hsmZ : SmoothOfRelativeDimension (n - 1)
      ((Limits.pullback.fst D.f (D.S i) ∣_ O) ≫ O.ι ≫ D.Yt.hom) := by
    rw [hcomp]; exact hsmZ0

  have hrS : Set.range (D.S i) = {D.S i (IsLocalRing.closedPoint F'')} := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      rw [Set.mem_singleton_iff, Subsingleton.elim x (IsLocalRing.closedPoint F'')]
    · intro h
      rw [Set.mem_singleton_iff] at h
      exact ⟨_, h.symm⟩
  have hrι : Set.range (Limits.pullback.fst D.f (D.S i)) =
      {y | D.f y = D.S i (IsLocalRing.closedPoint F'')} := by
    rw [Scheme.Pullback.range_fst, hrS]
    rfl
  have hrη' : Set.range jη.left = {z | VT.hom z ∉ Set.range (Limits.pullback.fst D.f (D.S i))} := by
    rw [hrη, hrι]
    rfl

  haveI := hjη
  have hsub : Set.range (jη.left ≫ φV.left) ⊆ Set.range jη.left := by
    rintro _ ⟨z, rfl⟩
    have hz : jη.left z ∈ Set.range jη.left := ⟨z, rfl⟩
    rw [hrη] at hz ⊢
    have h1 : VT.hom (φV.left (jη.left z)) = VT.hom (jη.left z) := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w φV]
    show D.f (VT.hom ((jη.left ≫ φV.left) z)) ≠ D.S i (IsLocalRing.closedPoint F'')
    rw [Scheme.Hom.comp_apply, h1]
    exact hz
  have hφTl : IsOpenImmersion.lift jη.left (jη.left ≫ φV.left) hsub ≫ jη.left =
      jη.left ≫ φV.left := IsOpenImmersion.lift_fac _ _ _
  obtain ⟨φT, hφT⟩ : ∃ φT : Tη ⟶ Tη, φT ≫ jη = jη ≫ φV := by
    refine ⟨MorphismProperty.Over.homMk (IsOpenImmersion.lift jη.left (jη.left ≫ φV.left) hsub)
      ?_ trivial, ?_⟩
    · rw [← MorphismProperty.Over.w jη, ← Category.assoc, hφTl, Category.assoc,
        MorphismProperty.Over.w φV]
    · apply MorphismProperty.Over.Hom.ext
      exact hφTl

  obtain ⟨hland, gV, hgV⟩ := wc_mtube_vt_geom_lift F' F'' Y n D i V₀ φ₀ A e ε hv hε hεφ xb hxb
    Th g φh hφh B eB hpre VT jc hrc φV hφV hP hY
  have hV : ∀ v : VT.left, VT.hom v ∈ O := fun v => hland v

  obtain ⟨Vw, Tw, β, βT, aw, gw, jw, bw, h1, h2, h3, h4, h5, hjw, hrw⟩ :=
    wc_proet_open_descend_geom_lift F'' D.Yt hY O hW (Limits.pullback.fst D.f (D.S i)) VT Tη hV
      φV gV hgV jη hjη hrη' φT hφT

  have hdescw : wcFreeSheafMap (O : Scheme.{u}) jw ≫ (wcFreeSheafMap (O : Scheme.{u}) aw ≫
      Limits.cokernel.π (wcFreeSheafMap (O : Scheme.{u}) jw)) = 0 := by
    rw [← Category.assoc, ← F0, ← h5, F0, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  obtain ⟨Φw, hΦw⟩ : ∃ Φw : Limits.cokernel (wcFreeSheafMap (O : Scheme.{u}) jw) ⟶
      Limits.cokernel (wcFreeSheafMap (O : Scheme.{u}) jw),
      Limits.cokernel.π (wcFreeSheafMap (O : Scheme.{u}) jw) ≫ Φw =
        wcFreeSheafMap (O : Scheme.{u}) aw ≫ Limits.cokernel.π (wcFreeSheafMap (O : Scheme.{u}) jw) :=
    ⟨_, Limits.cokernel.π_desc _ _ hdescw⟩

  obtain ⟨Tc, hTcb, hTc⟩ := wc_proet_open_slice_coker_ext_transport D.Yt.left O jw aw jη φV
    βT β h3 h1 Φη hΦη Φw hΦw (ZMod (ℓ ^ k)) n

  obtain ⟨φ, hφi, hφs⟩ := wc_proet_geom_lift_scaled_twist F'' (Over.mk (O.ι ≫ D.Yt.hom)) hW ℓ hℓ k
    Vw aw gw h2
  obtain ⟨Θ, hΘb, hΘ⟩ := wc_lfi_coker_scaled_transport (O : Scheme.{u}) Vw Tw jw aw bw h5 Φw hΦw
    (wcRootTwist (O : Scheme.{u}) (ℓ ^ k) 1) (wcContSheaf (O : Scheme.{u}) (ZMod (ℓ ^ k))) φ
    (Nat.card F'') hφi hφs n

  obtain ⟨κ, hκ⟩ := wc_proet_closed_push_free_coker_nat (Limits.pullback.fst D.f (D.S i) ∣_ O)
    Vw Tw jw hjw hrw aw Φw hΦw

  obtain ⟨gP, hgPb, hgP⟩ := wc_smooth_divisor_proet_mu_purity_ext F'' (O.ι ≫ D.Yt.hom) (n - 1)
    (Limits.pullback.fst D.f (D.S i) ∣_ O) ℓ hℓ' k (n - 2) n (by omega)
    (wcFreeSheaf (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O : Scheme.{u})
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i) ∣_ O)).obj Vw))

  obtain ⟨βZ, hβZ⟩ := wc_proet_open_slice_closed_pullback_iso (Limits.pullback.fst D.f (D.S i)) O
    Vw aw
  have hβX : (βZ ≪≫ (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).mapIso β).hom ≫
      (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map φV =
      (wcSliceFunctor (Limits.pullback D.f (D.S i))
          (Scheme.ProEt.mk (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O).ι)).map
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i) ∣_ O)).map aw) ≫
      (βZ ≪≫ (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).mapIso β).hom := by
    rw [Iso.trans_hom, Functor.mapIso_hom, Category.assoc, ← Functor.map_comp, h1,
      Functor.map_comp, ← Category.assoc, hβZ, Category.assoc]
  obtain ⟨Tz, hTzb, hTz⟩ := wc_proet_open_slice_free_ext_transport (Limits.pullback D.f (D.S i))
    (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O)
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i) ∣_ O)).map aw)
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map φV)
    (βZ ≪≫ (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).mapIso β) hβX (ZMod (ℓ ^ k)) (n - 2)

  let eK : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (O : Scheme.{u}) jw))
      (wcRootTwist (O : Scheme.{u}) (ℓ ^ k) 1) n ≃+
      Abelian.Ext ((wcProEtPush (Limits.pullback.fst D.f (D.S i) ∣_ O)).obj
        (wcFreeSheaf (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O : Scheme.{u})
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i) ∣_ O)).obj Vw)))
        (wcRootTwist (O : Scheme.{u}) (ℓ ^ k) 1) n :=
    { toFun := fun x => (Abelian.Ext.mk₀ κ.hom).comp x (zero_add n)
      invFun := fun y => (Abelian.Ext.mk₀ κ.inv).comp y (zero_add n)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
  let eTc := AddEquiv.ofBijective Tc hTcb
  refine ⟨(eTc.symm : _ →+ _).comp (Θ.comp ((eK.symm : _ →+ _).comp (gP.comp Tz))), ?_, ?_⟩
  · exact eTc.symm.bijective.comp (hΘb.comp (eK.symm.bijective.comp (hgPb.comp hTzb)))
  · intro y
    have keyTc : ∀ u, (Abelian.Ext.mk₀ Φη).comp (eTc.symm u) (zero_add n) =
        eTc.symm ((Abelian.Ext.mk₀ Φw).comp u (zero_add n)) := by
      intro u
      apply eTc.injective
      rw [AddEquiv.apply_symm_apply]
      have e1 := hTc (eTc.symm u)
      have e2 : Tc (eTc.symm u) = u := eTc.apply_symm_apply u
      rw [e2] at e1
      exact e1
    have hKc : ∀ w, eK ((Abelian.Ext.mk₀ Φw).comp w (zero_add n)) =
        (Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f (D.S i) ∣_ O)).map
          (wcFreeSheafMap (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O : Scheme.{u})
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i) ∣_ O)).map aw)))).comp
          (eK w) (zero_add n) := by
      intro w
      show (Abelian.Ext.mk₀ κ.hom).comp ((Abelian.Ext.mk₀ Φw).comp w (zero_add n)) (zero_add n) =
        _
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hκ, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
      rfl
    have hw : ∀ v, eK.symm ((Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f (D.S i) ∣_ O)).map
          (wcFreeSheafMap (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ O : Scheme.{u})
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i) ∣_ O)).map aw)))).comp
          v (zero_add n)) = (Abelian.Ext.mk₀ Φw).comp (eK.symm v) (zero_add n) := by
      intro v
      apply eK.injective
      rw [AddEquiv.apply_symm_apply, hKc, AddEquiv.apply_symm_apply]
    show (Abelian.Ext.mk₀ Φη).comp (eTc.symm (Θ (eK.symm (gP (Tz y))))) (zero_add n) =
      Nat.card F'' • eTc.symm (Θ (eK.symm (gP (Tz _))))
    rw [hTz, hgP, hw, ← map_nsmul eTc.symm, hΘ, keyTc]

theorem wc_bm_crit_point_stalk (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m)
    (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → F'')
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (t : Fin n → D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))
    (τ : (wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
    (A : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))))
    (ht : IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) =
        Ideal.span (Set.range t))
    (hτ : IsLocalRing.maximalIdeal
          ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) =
        Ideal.span {τ})
    (hA : (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) ^ 3)
    (hAa : ∀ p c : Fin (n - 2 + 1 + 1),
        A (Fin.cast (by omega) p) (Fin.cast (by omega) c) -
            wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) (a p c) ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))) :
    IsNoetherianRing (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) ∧
    ringKrullDim (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) = n ∧
    IsUnit (A + A.transpose).det ∧
    ∀ p : ↥(Limits.pullback D.f (D.S i) : Scheme.{u}),
      Limits.pullback.fst D.f (D.S i) p = D.xs i (IsLocalRing.closedPoint F'') →
      Nonempty ((Limits.pullback D.f (D.S i)).presheaf.stalk p ≃+*
        D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')) ⧸
          Ideal.span {(D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ}) :=
by
  haveI hSci : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  haveI hxci : IsClosedImmersion (D.xs i) :=
    isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i) hxsY
  have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
    have h1 : IsClosed (Set.range (D.xs i)) := (D.xs i).isClosedEmbedding.isClosed_range
    have h2 : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint F'')]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← h2]; exact h1

  have h1 : IsNoetherianRing (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) := by
    haveI := D.proper
    haveI : IsLocallyNoetherian (Spec (.of F'')) :=
      isLocallyNoetherian_Spec.mpr (inferInstanceAs (IsNoetherianRing F''))
    haveI := LocallyOfFiniteType.isLocallyNoetherian D.Yt.hom
    infer_instance

  have h2 : ringKrullDim (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) = n := by
    haveI := D.smooth
    exact wc_lfi_smooth_stalk_dim F'' D.Yt.left D.Yt.hom n _ hclosed

  have h3 : IsUnit (A + A.transpose).det := by
    have hm : n - 2 + 1 + 1 = n := by omega
    let e : Fin (n - 2 + 1 + 1) ≃ Fin n := finCongr hm
    let ι := wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F''))
    let π := IsLocalRing.residue (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))
    have hentry : ∀ p c, π (A (e p) (e c)) = (π.comp ι) (a p c) := by
      intro p c
      have hpc := hAa p c
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero] at hpc
      exact hpc
    have hmat : π.mapMatrix ((A + A.transpose).submatrix e e) =
        (π.comp ι).mapMatrix (Matrix.of a + (Matrix.of a).transpose) := by
      ext p c
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.submatrix_apply,
        Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply, map_add]
      rw [hentry p c, hentry c p]
    have hdet : π (A + A.transpose).det =
        (π.comp ι) (Matrix.of a + (Matrix.of a).transpose).det := by
      rw [← Matrix.det_submatrix_equiv_self e (A + A.transpose), RingHom.map_det, hmat,
        ← RingHom.map_det]
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
    change π _ ≠ 0
    rw [hdet]
    exact (map_ne_zero_iff _ (π.comp ι).injective).mpr ha

  have h4 : ∀ (y : D.Yt.left) (τ' : (wcP1Over F'').left.presheaf.stalk (D.f y)),
      IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.f y)) = Ideal.span {τ'} →
      ∀ p : ↥(Limits.pullback D.f (D.S i) : Scheme.{u}), Limits.pullback.fst D.f (D.S i) p = y →
      Nonempty ((Limits.pullback D.f (D.S i)).presheaf.stalk p ≃+*
        D.Yt.left.presheaf.stalk y ⧸ Ideal.span {(D.f.stalkMap y).hom τ'}) := by
    intro y τ' hτ' p hp
    subst hp
    haveI hfci : IsClosedImmersion (Limits.pullback.fst D.f (D.S i)) := by
      first
        | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
            (IsPullback.of_hasPullback D.f (D.S i)).flip hSci
        | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
            (IsPullback.of_hasPullback D.f (D.S i)) hSci
        | infer_instance
    have hsurj := (Limits.pullback.fst D.f (D.S i)).stalkMap_surjective p
    have hsq : IsPullback (Limits.pullback.fst D.f (D.S i)) (Limits.pullback.snd D.f (D.S i))
        (D.f ≫ 𝟙 _) (D.S i) := by
      rw [Category.comp_id]; exact IsPullback.of_hasPullback D.f (D.S i)
    have hker := wc_cpfo_stalk_ker_closed_pt_base_change (Limits.pullback.fst D.f (D.S i))
      (Limits.pullback.snd D.f (D.S i)) D.f (𝟙 _) (D.S i) hsq p τ' hτ'
    have hid : ((𝟙 (wcP1Over F'').left : (wcP1Over F'').left ⟶ _).stalkMap
        (D.f (Limits.pullback.fst D.f (D.S i) p))).hom τ' = τ' := by
      rw [Scheme.Hom.stalkMap_id]
      first | rfl | simp
    rw [hid] at hker
    exact ⟨((Ideal.quotEquivOfEq hker.symm).trans
      (RingHom.quotientKerEquivOfSurjective hsurj)).symm⟩
  exact ⟨h1, h2, h3, fun p hp => h4 _ τ hτ p hp⟩

theorem wc_bm_blowup_stalk_chart : ∀ (K : Type u) [Field K] [Finite K] (P : Scheme.{u})
    (fP : P ⟶ Spec (.of K)) [IsProper fP] (n : ℕ) (xb : P) (hxb : IsClosed ({xb} : Set P))
    (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : Fin n → R) (h : R)
    (M : Matrix (Fin n) (Fin n) R), 2 ≤ n → ringKrullDim R = n →
    IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
    IsUnit (M + M.transpose).det → Nonempty (P.presheaf.stalk xb ≃+* R ⧸ Ideal.span {h}) →
    ∀ (I : P.IdealSheafData),
    I = Scheme.IdealSheafData.vanishingIdeal (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P) →
    ∀ (Yb : Scheme.{u}) (r : Yb ⟶ P) [IsProper r], wcCsdIsBlowup I r →
    ∀ y : Yb, IsClosed ({y} : Set Yb) → r y = xb →
    ∃ (j : Fin n) (g : MvPolynomial (Fin n) R) (β : Ideal (wcOdpB t j g)) (_ : β.IsMaximal),
      MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g ∈ wcOdpJ0 t j ∧
      g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} ∧
      algebraMap R (wcOdpB t j g) (t j) ∈ β ∧
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (wcOdpB t j g) C)
        (_ : IsLocalization.AtPrime C β) (e : Yb.presheaf.stalk y ≃+* C),
        ∀ (W : Yb.affineOpens) (hyW : y ∈ W.1),
          Ideal.map (e : Yb.presheaf.stalk y →+* C)
            (Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W)) =
          Ideal.span {algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j))} :=
by
  have hComap : ∀ (X Y : Scheme.{u}) (J : Y.IdealSheafData) (π : X ⟶ Y) (U : Y.affineOpens) (W : X.affineOpens) (e : W.1 ≤ π ⁻¹ᵁ U.1), (J.comap π).ideal W = Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) := by
    intro X Y J π U W e
    rw [Scheme.IdealSheafData.comap, Scheme.Hom.ker_apply]
    apply le_antisymm
    · have hW : IsAffineOpen W.1 := W.2
      have hU : IsAffineOpen U.1 := U.2
      set IB := Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) with hIB
      have H : J.ideal U ≤ Ideal.comap (π.appLE U.1 W.1 e).hom IB := Ideal.le_comap_map
      let ψ : (Γ(Y, U.1) ⧸ J.ideal U) →+* (Γ(X, W.1) ⧸ IB) :=
        Ideal.quotientMap IB (π.appLE U.1 W.1 e).hom H
      let t : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X :=
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec
      let g : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ J.subscheme :=
        Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U
      have hw : t ≫ π = g ≫ J.subschemeι := by
        show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ≫ π =
          (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι
        have hc := J.subschemeCover_map_subschemeι U
        rw [J.glueDataObjι_ι U] at hc
        have hg : (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι =
            Spec.map (CommRingCat.ofHom ψ) ≫
              (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (J.ideal U))) ≫ hU.fromSpec) :=
          (Category.assoc _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ) ≫ ·) hc)
        rw [hg, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec π hU hW e]
        rw [← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        congr 2
      let l := Limits.pullback.lift t g hw
      have hl : l ≫ Limits.pullback.fst π J.subschemeι = t := Limits.pullback.lift_fst _ _ _
      intro b hb
      rw [RingHom.mem_ker] at hb
      have e0 : ⊤ ≤ t ⁻¹ᵁ W.1 := by
        intro p _
        show hW.fromSpec ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) p) ∈ (W.1 : Set X)
        rw [← hW.range_fromSpec]
        exact ⟨_, rfl⟩
      have h1 : ∀ (e : ⊤ ≤ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ⁻¹ᵁ W.1),
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec).appLE W.1 ⊤ e =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        have hb : ∀ (e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1),
            hW.fromSpec.appLE W.1 ⊤ e₁ = (Scheme.ΓSpecIso Γ(X, W.1)).inv := by
          intro e₁
          rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
          have hid : ∀ (f : Opposite.op (⊤ : (Spec Γ(X, W.1)).Opens) ⟶ Opposite.op ⊤),
              (Spec Γ(X, W.1)).presheaf.map f = 𝟙 _ := by
            intro f
            rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
              CategoryTheory.Functor.map_id]
          rw [hid, Category.comp_id]
        intro e
        have e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1 :=
          hW.fromSpec_preimage_self.ge
        have e₂ : (⊤ : (Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB))).Opens) ≤
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) ⁻¹ᵁ ⊤ := le_top
        rw [← Scheme.Hom.appLE_comp_appLE _ hW.fromSpec W.1 ⊤ ⊤ e₁ e₂, hb e₁]
        have happ : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appLE ⊤ ⊤ e₂ =
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appTop :=
          Scheme.Hom.appLE_eq_app _
        rw [happ, ← Scheme.ΓSpecIso_inv_naturality]
      have key : ∀ (s : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X) (hs : s = t)
          (e1 : ⊤ ≤ s ⁻¹ᵁ W.1), s.appLE W.1 ⊤ e1 =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        rintro s rfl e1
        exact h1 e1
      have e2 : ⊤ ≤ (l ≫ Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 := by
        rw [hl]; exact e0
      have h2 := key _ hl e2
      rw [Scheme.Hom.comp_appLE] at h2
      have h3 := congrArg (fun f => f.hom b) h2
      simp only [CommRingCat.comp_apply, hb, map_zero] at h3
      have h4 := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, W.1) ⧸ IB))).hom.hom h3
      simp only [map_zero, Iso.inv_hom_id_apply] at h4
      exact (Ideal.Quotient.eq_zero_iff_mem).mp h4.symm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have hP := Limits.pullback.condition (f := π) (g := J.subschemeι)
      have key : ∀ (s : Limits.pullback π J.subschemeι ⟶ Y)
          (hs : Limits.pullback.fst π J.subschemeι ≫ π = s)
          (e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤ s ⁻¹ᵁ U.1),
          ((Limits.pullback.fst π J.subschemeι).app W.1).hom ((π.appLE U.1 W.1 e).hom a) =
            (s.appLE U.1 _ e1).hom a := by
        rintro s rfl e1
        rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
      have e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤
          (Limits.pullback.snd π J.subschemeι ≫ J.subschemeι) ⁻¹ᵁ U.1 := by
        rw [← hP]; intro x hx; exact e hx
      rw [key _ hP e1, Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
      have h0 : (J.subschemeι.app U.1).hom a = 0 := by
        rw [← RingHom.mem_ker, Scheme.IdealSheafData.ker_subschemeι_app]; exact ha
      rw [h0, map_zero]
  have hL3 :∀ (A : Type u) [CommRing A] [IsLocalRing A] (S : Set A) (α : A),
      α ∈ nonZeroDivisors A → Ideal.span S = Ideal.span {α} →
      ∃ s ∈ S, s ∈ nonZeroDivisors A ∧ Ideal.span {s} = Ideal.span {α} := by
    intro A _ _ S α hα hS
    by_contra hcon
    push_neg at hcon
    have hle : Ideal.span S ≤ IsLocalRing.maximalIdeal A * Ideal.span {α} := by
      rw [Ideal.span_le]
      intro s hs
      have hs' : s ∈ Ideal.span {α} := by rw [← hS]; exact Ideal.subset_span hs
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hs'
      rw [SetLike.mem_coe, Ideal.mem_mul_span_singleton]
      refine ⟨d, ?_, hd⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hdu
      apply hcon s hs
      · rw [← hd]
        exact Submonoid.mul_mem _ (hdu.mem_nonZeroDivisors) hα
      · rw [← hd]
        exact Ideal.span_singleton_mul_left_unit hdu α
    have hαS : α ∈ Ideal.span S := by rw [hS]; exact Ideal.mem_span_singleton_self α
    obtain ⟨m, hm, hmα⟩ := Ideal.mem_mul_span_singleton.mp (hle hαS)
    have h1 : (1 - m) * α = 0 := by rw [sub_mul, one_mul, hmα, sub_self]
    have h2 : 1 - m = 0 := (mem_nonZeroDivisors_iff_right.mp hα) _ h1
    have h3 : m = 1 := (sub_eq_zero.mp h2).symm
    exact (IsLocalRing.mem_maximalIdeal _).mp hm (h3 ▸ isUnit_one)
  have hL2 :∀ (R : Type u) [CommRing R] (n : ℕ) (t : Fin n → R) (h : R)
      (j : Fin n) (g : MvPolynomial (Fin n) R),
      MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g ∈ wcOdpJ0 t j →
      algebraMap R (wcOdpB t j g) h = 0 ∧
      (∀ b, algebraMap R (wcOdpB t j g) (t b) ∈ Ideal.span {algebraMap R (wcOdpB t j g) (t j)}) ∧
      ∀ (D : Type u) [CommRing D] (ρ : R →+* D), ρ h = 0 → ρ (t j) ∈ nonZeroDivisors D →
        (∀ b, ρ (t b) ∈ Ideal.span {ρ (t j)}) →
        ∃! ψ : wcOdpB t j g →+* D, ψ.comp (algebraMap R (wcOdpB t j g)) = ρ := by
    intro R _ n t h j g hG
    have hJle : wcOdpJ0 t j ≤ wcOdpJ0 t j ⊔ Ideal.span {g} := le_sup_left
    have hgmem : g ∈ wcOdpJ0 t j ⊔ Ideal.span {g} :=
      (le_sup_right : Ideal.span {g} ≤ wcOdpJ0 t j ⊔ Ideal.span {g}) (Ideal.mem_span_singleton_self g)
    have hXj : MvPolynomial.X j - 1 ∈ wcOdpJ0 t j := by
      unfold wcOdpJ0; exact Ideal.subset_span (Set.mem_insert _ _)
    have hf : ∀ b, MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈ wcOdpJ0 t j := by
      intro b; unfold wcOdpJ0; exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)
    obtain ⟨mk, hmkdef⟩ : ∃ mk : MvPolynomial (Fin n) R →+* wcOdpB t j g,
        mk = Ideal.Quotient.mk (wcOdpJ0 t j ⊔ Ideal.span {g}) := ⟨_, rfl⟩
    have hal : ∀ x : R, algebraMap R (wcOdpB t j g) x = mk (MvPolynomial.C x) := by
      intro x; rw [hmkdef]; rfl
    have hmk0 : ∀ x ∈ wcOdpJ0 t j, mk x = 0 := fun x hx => by
      rw [hmkdef]; exact Ideal.Quotient.eq_zero_iff_mem.mpr (hJle hx)
    have hmkg : mk g = 0 := by rw [hmkdef]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hgmem
    have hh : algebraMap R (wcOdpB t j g) h = 0 := by
      rw [hal]
      have e : MvPolynomial.C h = (MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g) +
          MvPolynomial.C (t j) ^ 2 * g := by ring
      rw [e, map_add, map_mul, hmk0 _ hG, hmkg, mul_zero, add_zero]
    have hdivB : ∀ b, algebraMap R (wcOdpB t j g) (t b) =
        algebraMap R (wcOdpB t j g) (t j) * mk (MvPolynomial.X b) := by
      intro b
      rw [hal, hal, ← map_mul]
      symm
      rw [← sub_eq_zero, ← map_sub]
      exact hmk0 _ (hf b)
    refine ⟨hh, fun b => Ideal.mem_span_singleton'.mpr ⟨mk (MvPolynomial.X b), by
      rw [hdivB b, mul_comm]⟩, ?_⟩
    intro D _ ρ hρh hρnzd hρdiv
    choose c hc using fun b => Ideal.mem_span_singleton'.mp (hρdiv b)
    obtain ⟨E, hEdef⟩ : ∃ E : MvPolynomial (Fin n) R →+* D, E = MvPolynomial.eval₂Hom ρ c :=
      ⟨_, rfl⟩
    have hEC : ∀ x, E (MvPolynomial.C x) = ρ x := fun x => by rw [hEdef]; exact MvPolynomial.eval₂Hom_C ρ c x
    have hEX : ∀ b, E (MvPolynomial.X b) = c b := fun b => by rw [hEdef]; exact MvPolynomial.eval₂Hom_X' ρ c b
    have hcj : c j = 1 := by
      have h1 : (c j - 1) * ρ (t j) = 0 := by rw [sub_mul, hc j, one_mul, sub_self]
      exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff_right.mp hρnzd) _ h1)
    have hJE : wcOdpJ0 t j ≤ RingHom.ker E := by
      unfold wcOdpJ0
      rw [Ideal.span_le, Set.insert_subset_iff]
      refine ⟨?_, ?_⟩
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, hEX, map_one, hcj, sub_self]
      · rintro _ ⟨b, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, hEC, hEX, hEC, mul_comm, hc b,
          sub_self]
    have hEg : E g = 0 := by
      have h1 : E (MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g) = 0 := hJE hG
      rw [map_sub, map_mul, map_pow, hEC, hEC, hρh, zero_sub, neg_eq_zero] at h1
      have h2 : (E g * ρ (t j)) * ρ (t j) = 0 := by linear_combination h1
      exact (mem_nonZeroDivisors_iff_right.mp hρnzd) _
        ((mem_nonZeroDivisors_iff_right.mp hρnzd) _ h2)
    have hker : wcOdpJ0 t j ⊔ Ideal.span {g} ≤ RingHom.ker E := by
      refine sup_le hJE ?_
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      exact hEg
    refine ⟨Ideal.Quotient.lift _ E (fun a ha => RingHom.mem_ker.mp (hker ha)), ?_, ?_⟩
    · ext x
      rw [RingHom.comp_apply, hal, hmkdef, Ideal.Quotient.lift_mk, hEC]
    · intro ψ' hψ'
      have e0 : ∀ x : R, ρ x = ψ' (algebraMap R (wcOdpB t j g) x) := fun x => by
        rw [← hψ', RingHom.comp_apply]
      rw [hmkdef] at hal hdivB
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk, hEC, e0, hal]
      · intro b
        rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.lift_mk, hEX]
        have h1 : (ψ' (Ideal.Quotient.mk _ (MvPolynomial.X b)) - c b) * ρ (t j) = 0 := by
          rw [sub_mul, hc b, e0 (t b), e0 (t j), hdivB b, map_mul]
          ring
        exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff_right.mp hρnzd) _ h1)
  have hL1 :∀ (R : Type u) [CommRing R] (n : ℕ) (t : Fin n → R) (h : R)
      (M : Matrix (Fin n) (Fin n) R) (j : Fin n),
      h - ∑ a, ∑ c, M a c * t a * t c ∈ Ideal.span (Set.range t) ^ 3 →
      ∃ g : MvPolynomial (Fin n) R, MvPolynomial.C h - MvPolynomial.C (t j) ^ 2 * g ∈ wcOdpJ0 t j ∧
        g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
          wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} := by
    intro R _ n t h M j hq
    have hf : ∀ b, MvPolynomial.C (t b) - MvPolynomial.C (t j) * MvPolynomial.X b ∈ wcOdpJ0 t j := by
      intro b
      have h1 : MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈ wcOdpJ0 t j := by
        unfold wcOdpJ0; exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)
      have h2 := (wcOdpJ0 t j).neg_mem h1
      rwa [neg_sub] at h2
    have hQmul : ∀ a b : ℕ, (wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ a}) *
        (wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ b}) ≤
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ (a + b)} := by
      intro a b
      rw [Ideal.mul_le]
      intro x hx y hy
      obtain ⟨j1, hj1, p, hp, rfl⟩ := Submodule.mem_sup.mp hx
      obtain ⟨j2, hj2, q, hq', rfl⟩ := Submodule.mem_sup.mp hy
      obtain ⟨p', rfl⟩ := Ideal.mem_span_singleton'.mp hp
      obtain ⟨q'', rfl⟩ := Ideal.mem_span_singleton'.mp hq'
      have e : (j1 + p' * MvPolynomial.C (t j) ^ a) * (j2 + q'' * MvPolynomial.C (t j) ^ b) =
          (j1 * (j2 + q'' * MvPolynomial.C (t j) ^ b) + (p' * MvPolynomial.C (t j) ^ a) * j2) +
          (p' * q'') * MvPolynomial.C (t j) ^ (a + b) := by ring
      rw [e]
      refine Submodule.add_mem_sup ((wcOdpJ0 t j).add_mem ((wcOdpJ0 t j).mul_mem_right _ hj1)
        ((wcOdpJ0 t j).mul_mem_left _ hj2)) ?_
      exact Ideal.mem_span_singleton'.mpr ⟨_, rfl⟩
    have hQ1 : Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) (Ideal.span (Set.range t)) ≤
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ 1} := by
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
      have e : MvPolynomial.C (t b) = (MvPolynomial.C (t b) - MvPolynomial.C (t j) * MvPolynomial.X b) +
          MvPolynomial.X b * MvPolynomial.C (t j) ^ 1 := by ring
      rw [SetLike.mem_coe, e]
      exact Submodule.add_mem_sup (hf b) (Ideal.mem_span_singleton'.mpr ⟨_, rfl⟩)
    have hpow : ∀ k : ℕ, (Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R)
        (Ideal.span (Set.range t))) ^ k ≤ wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ k} := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ]
        exact (Ideal.mul_mono ih hQ1).trans (hQmul k 1)
    have hx3 : MvPolynomial.C (h - ∑ a, ∑ c, M a c * t a * t c) ∈
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j) ^ 3} := by
      refine hpow 3 ?_
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hq
    obtain ⟨j0, hj0, p, hp, hjp⟩ := Submodule.mem_sup.mp hx3
    obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    have hDq : MvPolynomial.C (∑ a, ∑ c, M a c * t a * t c) - MvPolynomial.C (t j) ^ 2 *
        (∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c) ∈ wcOdpJ0 t j := by
      have e : MvPolynomial.C (∑ a, ∑ c, M a c * t a * t c) - MvPolynomial.C (t j) ^ 2 *
          (∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c) =
          ∑ a, ∑ c, MvPolynomial.C (M a c) * (MvPolynomial.C (t a) * (MvPolynomial.C (t c) -
