    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (xs : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (∀ (V V' : (wcP1Over F'').left.ProEt) (k : V' ⟶ V) (h : V ⟶ T)
        (hV : ∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F''))
        (hV' : ∀ (v : V'.left) (i : Fin D.m), V'.hom v ≠ D.S i (IsLocalRing.closedPoint F'')),
        ((wcRq D.f ℓ (n - 1)).obj.map k.op).hom (xs V h hV) = xs V' (k ≫ h) hV') →
      ∃ x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T),
        ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T)
          (hV : ∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')),
          ((wcRq D.f ℓ (n - 1)).obj.map h.op).hom x = xs V h hV :=
by
  classical

  have nat : ∀ {G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (φ : G ⟶ G') {V T : (wcP1Over F'').left.ProEt} (h : V ⟶ T) (z : G.obj.obj (Opposite.op T)),
      (G'.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom z) =
        (φ.hom.app (Opposite.op V)).hom ((G.obj.map h.op).hom z) := by
    intro G G' φ V T h z
    have e := congrArg (fun f => f.hom z) (φ.hom.naturality h.op)
    exact e.symm
  have resComp : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      {V W T : (wcP1Over F'').left.ProEt} (h : V ⟶ W) (e : W ⟶ T) (z : G.obj.obj (Opposite.op T)),
      (G.obj.map (h ≫ e).op).hom z = (G.obj.map h.op).hom ((G.obj.map e.op).hom z) := by
    intro G V W T h e z
    rw [op_comp, Functor.map_comp]
    rfl

  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hPirr : IrreducibleSpace (wcP1Over F'').left := wc_proj_space_irreducible F'' 1
  haveI hPqs : QuasiSeparatedSpace (wcP1Over F'').left :=
    quasiSeparatedSpace_of_quasiSeparated (wcP1Over F'').hom
  have hclosed : ∀ i : Fin D.m, IsClosed ({D.S i (IsLocalRing.closedPoint F'')} :
      Set (wcP1Over F'').left) := by
    intro i
    haveI : IsClosedImmersion (D.S i) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
    have h1 := (D.S i).isClosedEmbedding.isClosed_range
    convert h1 using 1
    ext p
    constructor
    · rintro rfl
      exact ⟨_, rfl⟩
    · rintro ⟨a, rfl⟩
      rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
      rfl
  have hOopen : IsOpen {p : (wcP1Over F'').left |
      ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'')} := by
    have e : {p : (wcP1Over F'').left | ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'')} =
        ⋂ i, ({D.S i (IsLocalRing.closedPoint F'')}ᶜ : Set (wcP1Over F'').left) := by
      ext p
      simp
    rw [e]
    exact isOpen_iInter_of_finite (fun i => (hclosed i).isOpen_compl)
  obtain ⟨O, hOmem⟩ : ∃ O : (wcP1Over F'').left.Opens,
      ∀ p, p ∈ O ↔ ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'') :=
    ⟨⟨_, hOopen⟩, fun p => Iff.rfl⟩
  have hOc : IsCompact (O : Set (wcP1Over F'').left) :=
    (wc_curve_points_closed_opens_compact F'' (wcP1Over F'').left (wcP1Over F'').hom
      (wc_proj_space_dim F'' 1)).2 O

  have s7a : ∀ (W : (wcP1Over F'').left.ProEt) (v : (wcOpenRestr (wcP1Over F'').left O W).left),
      (wcOpenRestr (wcP1Over F'').left O W).hom v ∈ O := by
    intro W v
    have h1 : O.ι (Limits.pullback.fst O.ι W.hom v) ∈ O := by
      have h0 : O.ι (Limits.pullback.fst O.ι W.hom v) ∈ Set.range O.ι := Set.mem_range_self _
      rw [Scheme.Opens.range_ι] at h0
      exact h0
    have h2 : (Limits.pullback.snd O.ι W.hom ≫ W.hom) v ∈ O := by
      rw [← Limits.pullback.condition]; exact h1
    exact h2
  have s7b : ∀ (W V : (wcP1Over F'').left.ProEt) (h : V ⟶ W), (∀ v : V.left, V.hom v ∈ O) →
      ∃ h' : V ⟶ wcOpenRestr (wcP1Over F'').left O W,
        h' ≫ wcOpenRestrIncl (wcP1Over F'').left O W = h := by
    intro W V h hV
    have hsub : Set.range V.hom ⊆ Set.range O.ι := by
      rintro _ ⟨v, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact hV v
    have ha : IsOpenImmersion.lift O.ι V.hom hsub ≫ O.ι = V.hom := IsOpenImmersion.lift_fac _ _ _
    have hcomm : IsOpenImmersion.lift O.ι V.hom hsub ≫ O.ι = h.left ≫ W.hom := by
      rw [ha, MorphismProperty.Over.w h]
    refine ⟨MorphismProperty.Over.homMk
      (Limits.pullback.lift (IsOpenImmersion.lift O.ι V.hom hsub) h.left hcomm) ?_ trivial, ?_⟩
    · change Limits.pullback.lift (IsOpenImmersion.lift O.ι V.hom hsub) h.left hcomm ≫
          (Limits.pullback.snd O.ι W.hom ≫ W.hom) = V.hom
      rw [← Category.assoc, Limits.pullback.lift_snd, MorphismProperty.Over.w h]
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.lift (IsOpenImmersion.lift O.ι V.hom hsub) h.left hcomm ≫
          Limits.pullback.snd O.ι W.hom = h.left
      exact Limits.pullback.lift_snd _ _ _
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := by
    intro k
    have e : (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom =
        (Pi.evalAddMonoidHom (fun m : ℕ => ZMod (ℓ ^ m)) k).comp (wcTowerIncl ℓ) := by
      ext a; rfl
    rw [e, AddMonoidHom.coe_comp]
    exact (continuous_apply k).comp (wc_padic_tower_facts ℓ).1

  have star : ∀ (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op (wcOpenRestr (wcP1Over F'').left O T))),
      ∃ x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T),
        ((wcRq D.f ℓ (n - 1)).obj.map (wcOpenRestrIncl (wcP1Over F'').left O T).op).hom x = y := by
    intro T g y

    obtain ⟨c, hK⟩ := wc_pencil_et_Rq_bounded_extension F' F'' Y n hn hn2 D ℓ hℓ O hOmem
    haveI := wc_et_enough_injectives D.Yt.left

    have g3 : ∀ (k : ℕ) (T : (wcP1Over F'').left.ProEt),
        (∃ A : (wcP1Over F'').left.Opens, IsAffineOpen A ∧ wcAffIndEt (wcP1Over F'').left A T) →
        ∀ t : (((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.obj
            (Opposite.op (wcOpenRestr (wcP1Over F'').left O T)),
        ∃ x : (((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.obj (Opposite.op T),
          ((((wcProEtPush D.f).rightDerived (n - 1)).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.map
              (wcOpenRestrIncl (wcP1Over F'').left O T).op).hom x = ℓ ^ c • t := by
      rintro k T ⟨A, hA, hT⟩ t
      obtain ⟨θ⟩ := wc_proet_rightDerived_push_epsInv F'' D.Yt.left (wcP1Over F'').left
        (wcP1Over F'').hom D.f (ℓ ^ k) (InjectiveResolution.of _) (n - 1)
      obtain ⟨x'', hx''⟩ := wc_epsInv_extend_of_etale_extend (wcP1Over F'').left O hOc _ (ℓ ^ c)
        (hK k (InjectiveResolution.of _)) A hA T hT
        ((θ.hom.hom.app (Opposite.op (wcOpenRestr (wcP1Over F'').left O T))).hom t)
      have hinv : ∀ z, (θ.inv.hom.app (Opposite.op (wcOpenRestr (wcP1Over F'').left O T))).hom
          ((θ.hom.hom.app (Opposite.op (wcOpenRestr (wcP1Over F'').left O T))).hom z) = z := by
        intro z
        have e := congrArg
          (fun φ => (φ.hom.app (Opposite.op (wcOpenRestr (wcP1Over F'').left O T))).hom z)
          θ.hom_inv_id
        exact e
      refine ⟨(θ.inv.hom.app (Opposite.op T)).hom x'', ?_⟩
      rw [nat, hx'', map_nsmul, hinv]

    have g4 : ∀ (k : ℕ) (T : (wcP1Over F'').left.ProEt)
        (x : (((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.obj (Opposite.op T)),
        ((((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).obj.map
            (wcOpenRestrIncl (wcP1Over F'').left O T).op).hom x = 0 → x = 0 := by
      intro k T x hx
      apply wc_pencil_Rq_torsion_noPunct F' F'' Y n hn hn2 D ℓ hℓ k T x
      intro V h hV
      obtain ⟨h', rfl⟩ := s7b T V h (fun v => (hOmem _).mpr (hV v))
      rw [resComp, hx, map_zero]

    have hcongr : ∀ (k : ℕ) (φ ψ : ℤ_[ℓ] →+ ZMod (ℓ ^ k)) (hφ : Continuous φ)
        (hψ : Continuous ψ), φ = ψ →
        wcContSheafMap D.Yt.left φ hφ = wcContSheafMap D.Yt.left ψ hψ := by
      rintro k φ ψ hφ hψ rfl
      rfl
    have hmap : ∀ k : ℕ,
        ((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
          (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom (hc (k + 1))) ≫
        ((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
          (wcTowerCast ℓ k) continuous_of_discreteTopology) =
        ((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k)) := by
      intro k
      rw [← Functor.map_comp, ← (wc_contSheafMap_comp_sub D.Yt.left
        (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom
        (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom (hc (k + 1)) (hc (k + 1))
        (wcTowerCast ℓ k) continuous_of_discreteTopology).1]
      congr 1
      apply hcongr
      ext a
      exact PadicInt.cast_toZModPow k (k + 1) (by omega) a
    have hρ : ∀ (k : ℕ) (W : (wcP1Over F'').left.ProEt)
        (z : (((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.obj (Opposite.op W)),
        ((((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
          (wcTowerCast ℓ k) continuous_of_discreteTopology)).hom.app (Opposite.op W)).hom
          (((((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
            (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom (hc (k + 1)))).hom.app
              (Opposite.op W)).hom z) =
        ((((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))).hom.app (Opposite.op W)).hom z := by
      intro k W z
      exact congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom z) (hmap k)

    have g5 : ∀ (T : (wcP1Over F'').left.ProEt),
        (∃ A : (wcP1Over F'').left.Opens, IsAffineOpen A ∧ wcAffIndEt (wcP1Over F'').left A T) →
        ∀ t : (((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.obj
            (Opposite.op (wcOpenRestr (wcP1Over F'').left O T)),
        ∃ x : (((wcProEtPush D.f).rightDerived (n - 1)).obj
          (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.obj (Opposite.op T),
          ((((wcProEtPush D.f).rightDerived (n - 1)).obj
            (wcContSheaf D.Yt.left ℤ_[ℓ])).obj.map
              (wcOpenRestrIncl (wcP1Over F'').left O T).op).hom x = ℓ ^ c • t := by
      intro T hQ t
      choose xk hxk using fun k : ℕ => g3 k T hQ
        (((((wcProEtPush D.f).rightDerived (n - 1)).map (wcContSheafMap D.Yt.left
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))).hom.app
            (Opposite.op (wcOpenRestr (wcP1Over F'').left O T))).hom t)
      have hcompat : ∀ k : ℕ, ((((wcProEtPush D.f).rightDerived (n - 1)).map
          (wcContSheafMap D.Yt.left (wcTowerCast ℓ k) continuous_of_discreteTopology)).hom.app
            (Opposite.op T)).hom (xk (k + 1)) = xk k := by
        intro k
        rw [← sub_eq_zero]
        apply g4 k T
        rw [map_sub, nat, hxk (k + 1), hxk k, map_nsmul, hρ, sub_self]
      obtain ⟨x, hx⟩ := wc_pencil_Rq_int_lift_compatible F' F'' Y n hn2 D ℓ hℓ hP hc T xk hcompat
      refine ⟨x, ?_⟩
      rw [← sub_eq_zero]
      apply wc_pencil_Rq_int_detect_torsion F' F'' Y n hn2 D ℓ hℓ hP hc
      intro k
      rw [map_sub, ← nat, hx k, hxk k, map_nsmul, sub_self]

    obtain ⟨x, hx⟩ := wc_proet_extend_of_local_extend (wcP1Over F'').left O
      (wcGeomPoint F'' (wcP1Over F'') hP) (wcRq D.f ℓ (n - 1)) 1
      (fun T => ∃ A : (wcP1Over F'').left.Opens, IsAffineOpen A ∧
        wcAffIndEt (wcP1Over F'').left A T)
      (fun U => wc_proet_affIndEt_covering (wcP1Over F'').left U)
      (fun T' g' x hx => wc_pencil_Rq_no_punctual_sections F' F'' Y n hn hn2 D ℓ hℓ hP T' g' x
        (fun V h hV => by
          obtain ⟨h', rfl⟩ := s7b T' V h (fun v => (hOmem _).mpr (hV v))
          rw [resComp, hx, map_zero]))
      (fun T' hQ y' => by
        have hT'aff : IsAffine T'.left := by
          obtain ⟨A, -, hT'⟩ := hQ
          unfold wcAffIndEt at hT'
          exact hT'.1

        obtain ⟨x, hx⟩ := wc_pencil_Rq_rat_extend_of_int F' F'' Y n D ℓ (n - 1) c O T' hT'aff
          (g5 T' hQ) y'
        exact ⟨x, by rw [hx, one_nsmul]⟩)
      T g y
    exact ⟨x, by rw [hx, one_nsmul]⟩

  intro T g xs hxs
  have hT0 : ∀ (v : (wcOpenRestr (wcP1Over F'').left O T).left) (i : Fin D.m),
      (wcOpenRestr (wcP1Over F'').left O T).hom v ≠ D.S i (IsLocalRing.closedPoint F'') :=
    fun v => (hOmem _).mp (s7a T v)
  obtain ⟨x, hx⟩ := star T g (xs _ (wcOpenRestrIncl (wcP1Over F'').left O T) hT0)
  refine ⟨x, fun V h hV => ?_⟩
  obtain ⟨h', rfl⟩ := s7b T V h (fun v => (hOmem _).mpr (hV v))
  rw [resComp, hx]
  exact hxs _ V h' _ hT0 hV

theorem wc_proet_over_iso_restrict (S : Scheme.{u}) (B W : S.ProEt) (w : W ⟶ B)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
    (h : Nonempty (G.over B ≅ (wcContSheaf S A).over B)) :
    Nonempty (G.over W ≅ (wcContSheaf S A).over W) :=
by
  obtain ⟨φ⟩ := h
  exact ⟨(((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} w).mapIso φ :
    G.over W ≅ (wcContSheaf S A).over W)⟩

theorem wc_proet_over_frame_hom_linear (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt) (hW : ConnectedSpace W.left)
    (X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (f : X ⟶ Y) (a b : ℕ)
    (θX : X.over W ≅ (wcContSheaf S (Fin a → ℚ_[ℓ])).over W)
    (θY : Y.over W ≅ (wcContSheaf S (Fin b → ℚ_[ℓ])).over W) :
    ∃ L : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]),
      (∀ (T : Over W) (x : X.obj.obj (Opposite.op T.left)) (z : T.left.left),
        wcContEval S T.left ((θY.hom.hom.app (Opposite.op T)).hom
          ((f.hom.app (Opposite.op T.left)).hom x)) z =
          L (wcContEval S T.left ((θX.hom.hom.app (Opposite.op T)).hom x) z)) ∧
      (Mono f → Function.Injective L) :=
by
  classical
  let Φ : (wcContSheaf S (Fin a → ℚ_[ℓ])).over W ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over W :=
    θX.inv ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map f ≫ θY.hom
  obtain ⟨L, hL⟩ := wc_contSheaf_over_hom_linear S ℓ W hW a b Φ
  have hR : ∀ (T : Over W) (x : X.obj.obj (Opposite.op T.left)) (z : T.left.left),
      wcContEval S T.left ((θY.hom.hom.app (Opposite.op T)).hom
        ((f.hom.app (Opposite.op T.left)).hom x)) z =
        L (wcContEval S T.left ((θX.hom.hom.app (Opposite.op T)).hom x) z) := by
    intro T x z
    have h2 : (θX.inv.hom.app (Opposite.op T)).hom ((θX.hom.hom.app (Opposite.op T)).hom x) = x :=
      congrArg (fun φ => (φ.hom.app (Opposite.op T)).hom x) θX.hom_inv_id
    have h1 := congrArg (fun ψ => wcContEval S T.left
      ((ψ.hom.app (Opposite.op T)).hom ((θX.hom.hom.app (Opposite.op T)).hom x)) z) hL
    refine (congrArg (fun x' => wcContEval S T.left ((θY.hom.hom.app (Opposite.op T)).hom
      ((f.hom.app (Opposite.op T.left)).hom x')) z) h2).symm.trans (h1.trans ?_)
    rfl
  refine ⟨L, hR, ?_⟩
  intro hf v w hvw
  obtain ⟨z₀⟩ := hW.toNonempty
  haveI : Mono f.hom :=
    (Sheaf.Hom.mono_iff_presheaf_mono (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} f).mp hf
  have hfW : Function.Injective (f.hom.app (Opposite.op W)).hom :=
    (AddCommGrpCat.mono_iff_injective _).mp
      ((NatTrans.mono_iff_mono_app f.hom).mp inferInstance (Opposite.op W))
  let κ : ∀ u : Fin a → ℚ_[ℓ], (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
    fun u => (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op W) from
      ULift.up (ContinuousMap.const ↥W.left u))
  let xs : ∀ u : Fin a → ℚ_[ℓ], X.obj.obj (Opposite.op W) :=
    fun u => (θX.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom (κ u)
  have hxs : ∀ u, (θX.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom (xs u) = κ u := fun u =>
    congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom (κ u)) θX.inv_hom_id
  have hval : ∀ u (z : W.left), wcContEval S W ((θY.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      ((f.hom.app (Opposite.op W)).hom (xs u))) z = L u := by
    intro u z
    have e := hR (Over.mk (𝟙 W)) (xs u) z
    refine e.trans ?_
    rw [hxs u]
    rfl
  have hY : (θY.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      ((f.hom.app (Opposite.op W)).hom (xs v)) =
      (θY.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      ((f.hom.app (Opposite.op W)).hom (xs w)) := by
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    have e1 := hval v z
    have e2 := hval w z
    exact e1.trans (hvw.trans e2.symm)
  have hinvY : ∀ p : Y.obj.obj (Opposite.op W),
      (θY.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θY.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom p) = p := fun p =>
    congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom p) θY.hom_inv_id
  have hfx : (f.hom.app (Opposite.op W)).hom (xs v) = (f.hom.app (Opposite.op W)).hom (xs w) := by
    rw [← hinvY ((f.hom.app (Opposite.op W)).hom (xs v)),
      ← hinvY ((f.hom.app (Opposite.op W)).hom (xs w)), hY]
  have hx : xs v = xs w := hfW hfx
  have hκ : κ v = κ w := by rw [← hxs v, ← hxs w, hx]
  have := congrArg (fun c => wcContEval S W c z₀) hκ
  exact this

theorem wc_proet_coker_frame_of_linear (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt) (X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (i : X ⟶ Y)
    (a b : ℕ)
    (θX : X.over W ≅ (wcContSheaf S (Fin a → ℚ_[ℓ])).over W)
    (θY : Y.over W ≅ (wcContSheaf S (Fin b → ℚ_[ℓ])).over W)
    (J : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])) (hJ : Function.Injective J)
    (hiJ : ∀ (T : Over W) (x : X.obj.obj (Opposite.op T.left)) (z : T.left.left),
      wcContEval S T.left ((θY.hom.hom.app (Opposite.op T)).hom
        ((i.hom.app (Opposite.op T.left)).hom x)) z =
        J (wcContEval S T.left ((θX.hom.hom.app (Opposite.op T)).hom x) z)) :
    ∃ (k : ℕ) (q : (Fin b → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
      (θ' : (Limits.cokernel i).over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W),
      Function.Surjective q ∧ LinearMap.ker q = LinearMap.range J ∧
      ∀ (T : Over W) (y : Y.obj.obj (Opposite.op T.left)) (z : T.left.left),
        wcContEval S T.left ((θ'.hom.hom.app (Opposite.op T)).hom
          (((Limits.cokernel.π i).hom.app (Opposite.op T.left)).hom y)) z =
          q (wcContEval S T.left ((θY.hom.hom.app (Opposite.op T)).hom y) z) :=
by
  classical

  have wc_contSheaf_shortExact : ∀ (S : Scheme.{u}) {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C] (φ : A →+ B) (hφ : Continuous φ) (ψ : B →+ C) (hψ : Continuous ψ), Topology.IsEmbedding φ → (∀ b : B, ψ b = 0 ↔ ∃ a : A, φ a = b) → (∃ σ : C → B, Continuous σ ∧ ∀ c, ψ (σ c) = c) → ∃ hzero : wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ = 0, (ShortComplex.mk (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) hzero).ShortExact := by
    intro S A B C _ _ _ _ _ _ _ _ _ φ hφ ψ hψ hemb hker hsec
    obtain ⟨σ, hσc, hσ⟩ := hsec
    have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
        (g : G ⟶ H),
        (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
        (∀ U, Function.Injective (f.hom.app U)) →
        (∀ U, Function.Surjective (g.hom.app U)) →
        (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
        ∃ hzero : f ≫ g = 0, (ShortComplex.mk f g hzero).ShortExact := by
      intro F G H f g h1 h0 h2 h3
      have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
          (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
        intro X Y U y
        rfl
      have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
          (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
          (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
        intro X Y Z p q U y
        rfl
      have w : f ≫ g = 0 := by
        apply Sheaf.hom_ext
        ext U x
        rw [hcomp, hzero, h1]
      haveI : Epi g := by
        haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
        haveI : Epi g.hom := NatTrans.epi_of_epi_app _
        exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
      haveI : Mono f := by
        haveI : ∀ U, Mono (f.hom.app U) := fun U => (AddCommGrpCat.mono_iff_injective _).mpr (h0 U)
        haveI : Mono f.hom := NatTrans.mono_of_mono_app _
        exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
      have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
          f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
        intro A k hk
        have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
          intro U y
          have := congrArg (fun φ => φ.hom.app U y) hk
          simp only at this
          rw [hcomp, hzero] at this
          exact this
        have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
            k.hom.app U x = k.hom.app U x' := by
          intro U x x' hxx
          obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
          have := hk' U y
          rw [hy, map_sub, sub_eq_zero] at this
          exact this
        let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
        have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
        let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
          (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
            intro φ ψ
            rw [← map_add]
            apply hd
            rw [map_add, hσ, hσ, hσ]))
        have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
        let l : H ⟶ A := ObjectProperty.homMk
          { app := lU
            naturality := by
              intro U V r
              ext φ
              rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
                ← NatTrans.naturality_apply]
              apply hd
              rw [hσ, NatTrans.naturality_apply, hσ] }
        refine ⟨l, ?_⟩
        apply Sheaf.hom_ext
        ext U x
        rw [hcomp]
        change lU U (g.hom.app U x) = k.hom.app U x
        rw [hlU]
        apply hd
        rw [hσ]
      refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
      exact ShortComplex.exact_of_g_is_cokernel _ (Limits.CokernelCofork.IsColimit.ofπ' g w fac)
    refine crit (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) ?_ ?_ ?_ ?_
    · intro U x
      let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change ψ (φ (x0 t)) = 0
      exact (hker _).mpr ⟨_, rfl⟩
    · intro U x x' hxx
      let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
      let x1 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x'.down
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      have h := congrArg (fun z => (ULift.down z :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)) t) hxx
      have h' : φ (x0 t) = φ (x1 t) := h
      exact hemb.injective h'
    · intro U z
      let z0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C) := z.down
      refine ⟨ULift.up (⟨fun t => σ (z0 t), hσc.comp z0.continuous⟩ :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)), ?_⟩
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change ψ (σ (z0 t)) = z0 t
      exact hσ _
    · intro U x hx
      let y0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B) := x.down
      have hx' : ∀ t, ψ (y0 t) = 0 := by
        intro t
        have := congrArg (fun z => (ULift.down z :
          C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C)) t) hx
        exact this
      choose k hk using fun t => (hker (y0 t)).mp (hx' t)
      have hkc : Continuous k := by
        rw [hemb.continuous_iff]
        have e : (⇑φ ∘ k) = ⇑y0 := funext hk
        rw [e]
        exact y0.continuous
      refine ⟨ULift.up (⟨k, hkc⟩ :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A)), ?_⟩
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change φ (k t) = y0 t
      exact hk t

  let R := LinearMap.range J
  let k := Module.finrank ℚ_[ℓ] ((Fin b → ℚ_[ℓ]) ⧸ R)
  let eQ : ((Fin b → ℚ_[ℓ]) ⧸ R) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]) :=
    LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ]).symm
  let q : (Fin b → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]) := eQ.toLinearMap ∘ₗ R.mkQ
  have hqs : Function.Surjective q := eQ.surjective.comp R.mkQ_surjective
  have hexact0 : ∀ w, q w = 0 ↔ w ∈ R := by
    intro w
    show eQ (R.mkQ w) = 0 ↔ w ∈ R
    rw [LinearEquiv.map_eq_zero_iff, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  have hker : LinearMap.ker q = LinearMap.range J := by
    ext w
    rw [LinearMap.mem_ker]
    exact hexact0 w
  have hexact : ∀ w, q.toAddMonoidHom w = 0 ↔ ∃ u, J.toAddMonoidHom u = w := by
    intro w
    show q w = 0 ↔ ∃ u, J u = w
    rw [hexact0 w]
    exact LinearMap.mem_range
  have hJc : Continuous (J.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional J
  have hqc : Continuous (q.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional q
  have hemb : Topology.IsEmbedding J.toAddMonoidHom :=
    (LinearMap.isClosedEmbedding_of_injective (LinearMap.ker_eq_bot.mpr hJ)).isEmbedding
  obtain ⟨σq, hσq⟩ := LinearMap.exists_rightInverse_of_surjective q
    (LinearMap.range_eq_top.mpr hqs)
  have hsec : ∃ s : (Fin k → ℚ_[ℓ]) → (Fin b → ℚ_[ℓ]), Continuous s ∧
      ∀ y, q.toAddMonoidHom (s y) = y :=
    ⟨σq, LinearMap.continuous_of_finiteDimensional σq, fun y => LinearMap.congr_fun hσq y⟩
  obtain ⟨wq, hSE⟩ := wc_contSheaf_shortExact S J.toAddMonoidHom hJc q.toAddMonoidHom hqc
    hemb hexact hsec
  have hQ : Limits.IsColimit (Limits.CokernelCofork.ofπ _ wq) := hSE.gIsCokernel

  set ρ := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W with hρ
  have adj := (Over.forget W).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over W) (Scheme.ProEt.topology S)
  haveI : ρ.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  set cJ := wcContSheafMap S J.toAddMonoidHom hJc with hcJ
  set cq := wcContSheafMap S q.toAddMonoidHom hqc with hcq
  set π := Limits.cokernel.π i with hπdef

  have hρi : ρ.map i ≫ θY.hom = θX.hom ≫ ρ.map cJ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact hiJ T.unop x z
  have hρi' : ρ.map cJ ≫ θY.inv = θX.inv ≫ ρ.map i := by
    rw [← cancel_epi θX.hom, Iso.hom_inv_id_assoc, ← Category.assoc, ← hρi, Category.assoc,
      Iso.hom_inv_id, Category.comp_id]

  have w1 : ρ.map i ≫ ρ.map π = 0 := by
    rw [← ρ.map_comp, hπdef, Limits.cokernel.condition, ρ.map_zero]
  have hπ : Limits.IsColimit (Limits.CokernelCofork.ofπ (ρ.map π) w1) :=
    Limits.CokernelCofork.mapIsColimit _ (Limits.cokernelIsCokernel i) ρ
  have w2 : ρ.map cJ ≫ ρ.map cq = 0 := by
    rw [← ρ.map_comp, wq, ρ.map_zero]
  have hqρ : Limits.IsColimit (Limits.CokernelCofork.ofπ (ρ.map cq) w2) :=
    Limits.CokernelCofork.mapIsColimit _ hQ ρ

  have h1 : ρ.map i ≫ (θY.hom ≫ ρ.map cq) = 0 := by
    rw [← Category.assoc, hρi, Category.assoc, w2, Limits.comp_zero]
  have h2 : ρ.map cJ ≫ (θY.inv ≫ ρ.map π) = 0 := by
    rw [← Category.assoc, hρi', Category.assoc, w1, Limits.comp_zero]
  obtain ⟨Th, hTh⟩ := Limits.CokernelCofork.IsColimit.desc' hπ _ h1
  obtain ⟨Ti, hTi⟩ := Limits.CokernelCofork.IsColimit.desc' hqρ _ h2
  have hTh' : ρ.map π ≫ Th = θY.hom ≫ ρ.map cq := hTh
  have hTi' : ρ.map cq ≫ Ti = θY.inv ≫ ρ.map π := hTi
  have hhi : Th ≫ Ti = 𝟙 _ := by
    apply Limits.Cofork.IsColimit.hom_ext hπ
    show ρ.map π ≫ Th ≫ Ti = ρ.map π ≫ 𝟙 _
    rw [← Category.assoc, hTh', Category.assoc, hTi', Iso.hom_inv_id_assoc, Category.comp_id]
  have hih : Ti ≫ Th = 𝟙 _ := by
    apply Limits.Cofork.IsColimit.hom_ext hqρ
    show ρ.map cq ≫ Ti ≫ Th = ρ.map cq ≫ 𝟙 _
    rw [← Category.assoc, hTi', Category.assoc, hTh', Iso.inv_hom_id_assoc, Category.comp_id]
  let θ' : (Limits.cokernel i).over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W :=
    ⟨Th, Ti, hhi, hih⟩

  refine ⟨k, q, θ', hqs, hker, ?_⟩
  intro T y z
  have e := congrArg (fun g => wcContEval S T.left ((g.hom.app (Opposite.op T)).hom y) z) hTh'
  exact e

theorem wc_honest_fixed_VQ_deck_frame (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP)
    (hfix : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ u ∈ wcHonestEhon H, H.fr γ u = u) :
    ∃ (k : ℕ) (θ : (wcPencilVQ D ℓ hP).over H.W ≅
        (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over H.W),
      ∀ (V₀ : (wcP1Over F'').left.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ H.W)
        (x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V₀)),
        h₁ ≫ H.w = h₂ ≫ H.w → ∀ z : V₀.left,
          wcContEval (wcP1Over F'').left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
            wcContEval (wcP1Over F'').left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z :=
by
  classical

  obtain ⟨z₀⟩ := H.hconn.toNonempty

  have hconst : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (k : ℕ) (Θ : G.over H.W ≅ (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over H.W)
      (v : Fin k → ℚ_[ℓ]), ∃ s : G.obj.obj (Opposite.op H.W), ∀ z : H.W.left,
        wcContEval (wcP1Over F'').left H.W
          ((Θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s) z = v := by
    intro G k Θ v
    let κ : (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op H.W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op H.W) from
        ULift.up (ContinuousMap.const ↥H.W.left v))
    refine ⟨(Θ.inv.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom κ, fun z => ?_⟩
    have h2 : (Θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom
        ((Θ.inv.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom κ) = κ :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom κ) Θ.inv_hom_id
    rw [h2]
    rfl

  have hRgE : wcHonestRg H ≤ wcHonestEhon H := by
    unfold wcHonestRg
    rw [Submodule.span_le]
    rintro v ⟨γ, u, hγ, rfl⟩
    exact H.hrange γ hγ u
  have hRgfix : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ u ∈ wcHonestRg H, H.fr γ u = u :=
    fun γ hγ u hu => hfix γ hγ u (hRgE hu)
  have hUr : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ x, H.fr γ x - x ∈ wcHonestRg H := by
    intro γ hγ x
    unfold wcHonestRg
    exact Submodule.subset_span ⟨γ, x, hγ, rfl⟩

  obtain ⟨M, hM, hUniv⟩ := wc_proet_theta_subsheaf (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
    H.W H.N H.θ (wcHonestRg H)
  have htw := wc_honest_Rg_twist_stable F' F'' Y n D ℓ hP H

  have hMGC : wcPencilGC F'' hP ℓ (Subobject.underlying.obj M) := by
    refine wc_kss_geomConst_of_extension F'' hP ℓ D.m D.S D.hS (wcRq D.f ℓ (n - 1)) H.W H.w H.N
      H.hqc H.hcov H.θ (wcHonestRg H) (fun V₀ _ h₁ h₂ x hx => htw V₀ h₁ h₂ x hx) ?_ M hM
      (wc_pencil_Rq_no_punctual_sections F' F'' Y n hn hn2 D ℓ hℓ hP)
      (wc_pencil_Rq_extend_off_crit F' F'' Y n hn hn2 D ℓ hℓ hP)
    intro V₀ hV₀ h₁ h₂ x hx hw z
    obtain ⟨γ, hγ, rfl⟩ := H.hgal V₀ h₁ h₂ hV₀ hw
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) H.W
      H.hconn H.N H.θ γ
    have hAfr : ∀ v, A v = H.fr γ v := by
      intro v
      obtain ⟨s, hs⟩ := hconst _ H.N H.θ v
      have e1 := hA H.W (𝟙 H.W) γ (Category.id_comp γ).symm s z₀
      have e2 := H.hfr γ hγ s z₀
      have e3 := hs z₀
      calc A v = A (wcContEval (wcP1Over F'').left H.W
            ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s) z₀) := by rw [e3]
        _ = wcContEval (wcP1Over F'').left H.W
            ((H.θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z₀ := e1.symm
        _ = H.fr γ (wcContEval (wcP1Over F'').left H.W
            ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s) z₀) := e2
        _ = H.fr γ v := by rw [e3]
    have e := hA V₀ h₁ (h₁ ≫ γ) rfl x z
    have e2 : A (wcContEval (wcP1Over F'').left V₀
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) =
        wcContEval (wcP1Over F'').left V₀
          ((H.θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z := by
      rw [hAfr]
      exact hRgfix γ hγ _ (hx z)
    exact e.trans e2

  have hstable : wcPencilStable D ℓ M := by
    intro c
    refine hUniv _ (M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c) ?_
    intro T x V h h' z
    have hy := (hM T ((M.arrow.hom.app (Opposite.op T)).hom x)).mp ⟨x, rfl⟩ V h h' z
    have e1 : ((wcRq D.f ℓ (n - 1)).obj.map h.op).hom
        (((M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom x) =
        ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom
          (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom ((M.arrow.hom.app (Opposite.op T)).hom x)) :=
      (congrArg (fun f => AddCommGrpCat.Hom.hom f ((M.arrow.hom.app (Opposite.op T)).hom x))
        ((wcRqScalar D.f ℓ (n - 1) c).hom.naturality h.op)).symm
    have e2 := congrArg (fun f => AddCommGrpCat.Hom.hom (f.hom.app (Opposite.op (Over.mk h')))
        (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom ((M.arrow.hom.app (Opposite.op T)).hom x)))
        (H.hθc c)
    have e3 : wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom
          (((M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom x))) z =
        c • wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom ((M.arrow.hom.app (Opposite.op T)).hom x))) z := by
      rw [e1]
      exact congrArg (fun f => wcContEval (wcP1Over F'').left V f z) e2
    have hc := Submodule.smul_mem (wcHonestRg H) c hy
    rw [← e3] at hc
    exact hc

  have hC := wc_pencil_GC_max_exists F' F'' Y n hn hn2 D ℓ hℓ hP
  have hMC : M ≤ wcPencilC D ℓ hP := by
    unfold wcPencilC
    rw [dif_pos hC]
    exact (Classical.choose_spec hC).2.2 M hstable hMGC

  have hME : M ≤ wcPencilE D ℓ hP := by
    unfold wcPencilE
    split_ifs with hE
    · exact wc_honest_theta_le_of_coker_GC F' F'' Y n hn hn2 D ℓ hℓ hP H (wcHonestRg H) le_rfl
        M hM _ (Classical.choose_spec hE).2.1
    · exact le_top
  have hMB : M ≤ wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP := le_inf hME hMC

  have hs7 : ∀ u ∈ wcHonestRg H, ∃ y : (Subobject.underlying.obj
      (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)).obj.obj (Opposite.op H.W), ∀ z : H.W.left,
      wcContEval (wcP1Over F'').left H.W ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom
        (((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom y)) z = u := by
    intro u hu
    obtain ⟨s, hs⟩ := hconst _ H.N H.θ u
    have hthc : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ H.W) (z : V.left),
        wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk h))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom s)) z = u := by
      intro V h z
      have hnat := congrArg (fun g => wcContEval (wcP1Over F'').left V
          (AddCommGrpCat.Hom.hom g s) z)
        (H.θ.hom.hom.naturality (Over.homMk h (Category.comp_id h) :
          Over.mk h ⟶ Over.mk (𝟙 H.W)).op)
      exact hnat.trans (hs (h.left z))
    have hsθ : wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) H.W H.N H.θ
        (wcHonestRg H) H.W s := by
      intro V h h' z
      exact htw V h h' _ (fun z' => by rw [hthc V h z']; exact hu) z
    obtain ⟨x', hx'⟩ := (hM H.W s).mpr hsθ
    have hy : ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom
        (((Subobject.ofLE M (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) hMB).hom.app
          (Opposite.op H.W)).hom x') = s := by
      have := congrArg (fun g => (g.hom.app (Opposite.op H.W)).hom x') (Subobject.ofLE_arrow hMB)
      exact this.trans hx'
    refine ⟨((Subobject.ofLE M (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) hMB).hom.app
      (Opposite.op H.W)).hom x', fun z => ?_⟩
    rw [hy]
    exact hs z

  obtain ⟨b0, hb0⟩ := wc_pencil_EC_geomConst F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨θB⟩ := wc_proet_over_iso_restrict (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)
    H.W H.w _ _ hb0
  have hdisj : (∃ b : ℕ, Nonempty ((Limits.cokernel (wcPencilE D ℓ hP).arrow).over H.W ≅
      (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over H.W)) ∨
      Limits.IsZero (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
    by_cases hE : ∃ M₀ : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M₀ ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M₀.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M₀ ≤ M'
    · have hEeq : wcPencilE D ℓ hP = Classical.choose hE := by
        unfold wcPencilE
        rw [dif_pos hE]
      left
      obtain ⟨b, hb⟩ := (Classical.choose_spec hE).2.1
      rw [hEeq]
      exact ⟨b, wc_proet_over_iso_restrict (wcP1Over F'').left
        (wcGeomPoint F'' (wcP1Over F'') hP) H.W H.w _ _ hb⟩
    · have hEeq : wcPencilE D ℓ hP = ⊤ := by
        unfold wcPencilE
        rw [dif_neg hE]
      right
      rw [hEeq]
      haveI : IsIso (⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow := Subobject.isIso_top_arrow
      exact Limits.isZero_cokernel_of_epi _
  obtain ⟨a, ⟨θE⟩⟩ := wc_proet_sub_over_triv_of_coker (wcP1Over F'').left ℓ H.W H.hconn
    (wcRq D.f ℓ (n - 1)) (wcPencilE D ℓ hP) H.N ⟨H.θ⟩ hdisj

  obtain ⟨bE, hbE, hbEinj⟩ := wc_proet_over_frame_hom_linear (wcP1Over F'').left ℓ H.W H.hconn
    _ _ (wcPencilE D ℓ hP).arrow a H.N θE H.θ
  have hbEi : Function.Injective bE := hbEinj inferInstance
  obtain ⟨J, hJ, hJinj⟩ := wc_proet_over_frame_hom_linear (wcP1Over F'').left ℓ H.W H.hconn
    _ _ (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP) inf_le_left)
    b0 a θB θE

  obtain ⟨k, q, θ', hqs, hker, hq⟩ := wc_proet_coker_frame_of_linear (wcP1Over F'').left ℓ H.W
    _ _ (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP) inf_le_left)
    b0 a θB θE J (hJinj inferInstance) hJ
  refine ⟨k, θ', ?_⟩

  intro V₀ hV₀ h₁ h₂ x hw z
  obtain ⟨γ, hγ, rfl⟩ := H.hgal V₀ h₁ h₂ hV₀ hw
  obtain ⟨AE, hAE⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ _ H.W H.hconn a θE γ
  obtain ⟨A', hA'⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ _ H.W H.hconn k θ' γ

  have hbA : ∀ v, bE (AE v) = H.fr γ (bE v) := by
    intro v
    obtain ⟨yv, hyv⟩ := hconst _ a θE v
    have e1 := hbE (Over.mk γ) yv z₀
    have e2 := hAE H.W (𝟙 H.W) γ (Category.id_comp γ).symm yv z₀
    have e3 := hbE (Over.mk (𝟙 H.W)) yv z₀
    have e4 := H.hfr γ hγ (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom yv) z₀
    have e5 := hyv z₀
    calc bE (AE v) = bE (AE (wcContEval (wcP1Over F'').left H.W
          ((θE.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom yv) z₀)) := by rw [e5]
      _ = bE (wcContEval (wcP1Over F'').left H.W
          ((θE.hom.hom.app (Opposite.op (Over.mk γ))).hom yv) z₀) := congrArg bE e2.symm
      _ = wcContEval (wcP1Over F'').left H.W ((H.θ.hom.hom.app (Opposite.op (Over.mk γ))).hom
          (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom yv)) z₀ := e1.symm
      _ = H.fr γ (wcContEval (wcP1Over F'').left H.W
          ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom
            (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom yv)) z₀) := e4
      _ = H.fr γ (bE (wcContEval (wcP1Over F'').left H.W
          ((θE.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom yv) z₀)) := congrArg (H.fr γ) e3
      _ = H.fr γ (bE v) := by rw [e5]

  have hqA : ∀ v, q (AE v) = q v := by
    intro v
    obtain ⟨y', hy'⟩ := hs7 (H.fr γ (bE v) - bE v) (hUr γ hγ (bE v))
    have hBa : ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom y' =
        ((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom
          (((Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP)
            inf_le_left).hom.app (Opposite.op H.W)).hom y') :=
      (congrArg (fun g => (g.hom.app (Opposite.op H.W)).hom y')
        (Subobject.ofLE_arrow (inf_le_left : wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP ≤
          wcPencilE D ℓ hP))).symm
    have f1 := hbE (Over.mk (𝟙 H.W))
      (((Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP)
        inf_le_left).hom.app (Opposite.op H.W)).hom y') z₀
    have f2 := hJ (Over.mk (𝟙 H.W)) y' z₀
    have f3 := hy' z₀
    rw [hBa] at f3
    have hu : H.fr γ (bE v) - bE v = bE (J (wcContEval (wcP1Over F'').left H.W
        ((θB.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom y') z₀)) :=
      f3.symm.trans (f1.trans (congrArg bE f2))
    have hmem : AE v - v ∈ LinearMap.range J := by
      refine ⟨wcContEval (wcP1Over F'').left H.W
        ((θB.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom y') z₀, hbEi ?_⟩
      show bE (J (wcContEval (wcP1Over F'').left H.W
        ((θB.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom y') z₀)) = bE (AE v - v)
      rw [map_sub, hbA, hu]
    have h0 : q (AE v - v) = 0 := by
      have h1 : AE v - v ∈ LinearMap.ker q := by
        rw [hker]
        exact hmem
      exact h1
    rw [map_sub, sub_eq_zero] at h0
    exact h0

  have hA'id : ∀ w', A' w' = w' := by
    intro w'
    obtain ⟨v, rfl⟩ := hqs w'
    obtain ⟨yv, hyv⟩ := hconst _ a θE v
    have g1 := hq (Over.mk (𝟙 H.W)) yv z₀
    have g2 := hq (Over.mk γ) yv z₀
    have g3 := hA' H.W (𝟙 H.W) γ (Category.id_comp γ).symm
      (((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
        (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op H.W)).hom yv) z₀
    have g4 := hAE H.W (𝟙 H.W) γ (Category.id_comp γ).symm yv z₀
    have g5 := hyv z₀
    calc A' (q v) = A' (q (wcContEval (wcP1Over F'').left H.W
          ((θE.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom yv) z₀)) := by rw [g5]
      _ = A' (wcContEval (wcP1Over F'').left H.W
          ((θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom
            (((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
              (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op H.W)).hom yv)) z₀) :=
          congrArg A' g1.symm
      _ = wcContEval (wcP1Over F'').left H.W
          ((θ'.hom.hom.app (Opposite.op (Over.mk γ))).hom
            (((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
              (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op H.W)).hom yv)) z₀ := g3.symm
      _ = q (wcContEval (wcP1Over F'').left H.W
          ((θE.hom.hom.app (Opposite.op (Over.mk γ))).hom yv) z₀) := g2
      _ = q (AE (wcContEval (wcP1Over F'').left H.W
          ((θE.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom yv) z₀)) := congrArg q g4
      _ = q (AE v) := by rw [g5]
      _ = q v := hqA v

  have g := hA' V₀ h₁ (h₁ ≫ γ) rfl x z
  exact g.trans (hA'id _)

theorem wc_honest_fixed_VQ_gc_envelope (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP)
    (hfix : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ u ∈ wcHonestEhon H, H.fr γ u = u) :
    ∃ (G P : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (ι : wcPencilVQ D ℓ hP ⟶ G) (π : G ⟶ P) (hw : ι ≫ π = 0),
      (ShortComplex.mk ι π hw).ShortExact ∧ wcPencilGC F'' hP ℓ G ∧
      ∀ V : (wcP1Over F'').left.ProEt,
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) P 0, y = 0 :=
by
  classical

  have hO : ∀ p : (wcP1Over F'').left, p ∈ wcPencilSOpen D ↔
      ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'') := by
    have hcl := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
    intro p
    show p ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ ↔ _
    rw [Set.mem_compl_iff, Set.mem_iUnion]
    constructor
    · intro h i hpi
      apply h
      refine ⟨i, ?_⟩
      rw [hpi]
      exact subset_closure (Set.mem_singleton _)
    · rintro h ⟨i, hi⟩
      have hsub : closure {D.S i (IsLocalRing.closedPoint F'')} ⊆
          {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} :=
        closure_minimal (by rintro x rfl; exact ⟨i, rfl⟩) hcl
      obtain ⟨j, hj⟩ := hsub hi
      exact h j hj

  obtain ⟨G, ι, e, he1, he2⟩ :=
    wc_proet_open_envelope (wcP1Over F'').left (wcPencilSOpen D) (wcPencilVQ D ℓ hP)

  have hinj : ∀ (T : (wcP1Over F'').left.ProEt) (x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op T)),
      (ι.hom.app (Opposite.op T)).hom x = 0 → x = 0 := by
    intro T x hx
    apply wc_proet_quot_restr_injective F'' hP ℓ D.m D.S D.hS (wcPencilSOpen D) hO
      (wcRq D.f ℓ (n - 1)) (wc_pencil_Rq_no_punctual_sections F' F'' Y n hn hn2 D ℓ hℓ hP)
      (wcPencilE D ℓ hP) (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) inf_le_left
      (wc_pencil_EC_geomConst F' F'' Y n hn hn2 D ℓ hℓ hP) T x
    have h1 := he1 T x
    rw [hx, map_zero] at h1
    exact h1.symm
  have hmono : Mono ι := by
    haveI : ∀ T, Mono (ι.hom.app T) := by
      intro T
      rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      have h1 : (ι.hom.app T).hom (a - b) = 0 := by
        rw [map_sub]
        exact sub_eq_zero.mpr hab
      exact sub_eq_zero.mp (hinj T.unop (a - b) h1)
    haveI : Mono ι.hom := NatTrans.mono_of_mono_app ι.hom
    exact Sheaf.Hom.mono_of_presheaf_mono _ _ ι

  have hSE : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hmono inferInstance

  obtain ⟨k, θ, hdeck0⟩ := wc_honest_fixed_VQ_deck_frame F' F'' Y n hn hn2 D ℓ hℓ hP H hfix
  have hfc := (wc_kss_frame_change (wcP1Over F'').left ℓ (wcGeomPoint F'' (wcP1Over F'') hP) H.W H.w
      (wcPencilVQ D ℓ hP) k θ ⊤ (fun _ _ _ _ _ _ _ => Submodule.mem_top)
      (fun V₀ hV₀ h₁ h₂ x _ hw z => hdeck0 V₀ hV₀ h₁ h₂ x hw z)).2
  have hGC : wcPencilGC F'' hP ℓ G :=
    wc_proet_open_envelope_GC F'' hP ℓ D.m D.S D.hS (wcPencilSOpen D) hO (wcPencilVQ D ℓ hP) G e
      he2 H.W H.w H.hqc H.hcov k θ
      (fun V h₁ h₂ x hw z => hfc V h₁ h₂ x (fun _ => Submodule.mem_top) hw z)

  refine ⟨G, Limits.cokernel ι, ι, Limits.cokernel.π ι, Limits.cokernel.condition ι, hSE, hGC, ?_⟩
  intro V hV
  exact wc_proet_open_envelope_supp (wcP1Over F'').left (wcPencilSOpen D) (wcPencilVQ D ℓ hP) G ι
    e he1 V (fun v => (hO _).2 (fun i => hV v i))

theorem wc_P1_geom_section_zero_of_local (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (huniq : ∀ (i : Fin m) (p p' : (wcGeomPoint K (wcP1Over K) hP).left),
      (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
      (wcGeomPoint K (wcP1Over K) hP).hom p' = S i (IsLocalRing.closedPoint K) → p = p')
    (y : wcCohG K (wcP1Over K) hP G 0)
    (hy : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp y (zero_add 0) = 0)
    (hloc : ∀ i : Fin m, ∃ (V : (wcP1Over K).left.ProEt)
      (g : V ⟶ wcGeomPoint K (wcP1Over K) hP) (v : V.left),
      V.hom v = S i (IsLocalRing.closedPoint K) ∧
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp y (zero_add 0) = 0) :
    y = 0 :=
by
  classical
  let Pb := wcGeomPoint K (wcP1Over K) hP

  have hYon : ∀ (S : Scheme.{u}), ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
      (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (s : G.obj.obj (Opposite.op T)),
        ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
      ∀ (T T' : S.ProEt) (c : T' ⟶ T),
        ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
          ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
    intro S
    let J := Scheme.ProEt.topology S
    let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
      fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
        (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
        (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
        e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
    refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
    · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
    · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
    · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
      let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
      have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
            ((w.app (Opposite.op T')).hom x') :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
      have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans
          (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
        congr 1
      have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
        NatTrans.naturality_apply (toSheafify J P) c.op x
      change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
      rw [h1, h2, hn]
  obtain ⟨η, hU, hN⟩ := hYon (wcP1Over K).left
  let φ : wcFreeSheaf (wcP1Over K).left Pb ⟶ G := Abelian.Ext.homEquiv₀ y
  have hyφ : y = Abelian.Ext.mk₀ φ := (Abelian.Ext.mk₀_homEquiv₀_apply y).symm
  let s : G.obj.obj (Opposite.op Pb) := (φ.hom.app (Opposite.op Pb)).hom (η Pb)
  have ha : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ Pb),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp y (zero_add 0) = 0 →
      (G.obj.map g.op).hom s = 0 := by
    intro V g hg
    rw [hyφ, Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_zero] at hg
    have h0 : wcFreeSheafMap (wcP1Over K).left g ≫ φ = 0 := (Abelian.Ext.mk₀_bijective _ _).1 hg
    have h1 : (φ.hom.app (Opposite.op V)).hom
        (((wcFreeSheafMap (wcP1Over K).left g).hom.app (Opposite.op V)).hom (η V)) = 0 := by
      have h2 : ((wcFreeSheafMap (wcP1Over K).left g ≫ φ).hom.app (Opposite.op V)).hom (η V) =
          ((0 : wcFreeSheaf (wcP1Over K).left V ⟶ G).hom.app (Opposite.op V)).hom (η V) := by
        rw [h0]
      exact h2.trans (by simp)
    rw [hN Pb V g] at h1
    have hn : (φ.hom.app (Opposite.op V)).hom (((wcFreeSheaf (wcP1Over K).left Pb).obj.map g.op).hom
        (η Pb)) = (G.obj.map g.op).hom ((φ.hom.app (Opposite.op Pb)).hom (η Pb)) :=
      NatTrans.naturality_apply φ.hom g.op (η Pb)
    rw [hn] at h1
    exact h1
  have hb : s = 0 → y = 0 := by
    intro hs
    obtain ⟨g0, -, huq⟩ := hU Pb G 0
    have e1 : φ = g0 := huq φ hs
    have e2 : (0 : wcFreeSheaf (wcP1Over K).left Pb ⟶ G) = g0 := huq 0 (by simp)
    rw [hyφ, e1, ← e2, Abelian.Ext.mk₀_zero]

  haveI : LocallyOfFiniteType (wcP1Over K).hom := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hft : (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)
        (MvPolynomial (Fin (1 + 1)) K)).FiniteType := by
      apply RingHom.FiniteType.of_comp_finiteType
        (f := algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))
      have e : (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)
          (MvPolynomial (Fin (1 + 1)) K)).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) =
          algebraMap K (MvPolynomial (Fin (1 + 1)) K) := by
        ext <;> rfl
      rw [e]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    haveI : Algebra.FiniteType ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)
        (MvPolynomial (Fin (1 + 1)) K) := hft
    have h1 : LocallyOfFiniteType
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)) := inferInstance
    have hsurj : Function.Surjective
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) := by
      intro x
      have hx : (x : MvPolynomial (Fin (1 + 1)) K) ∈
          (1 : Submodule K (MvPolynomial (Fin (1 + 1)) K)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]; exact x.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hx
      exact ⟨c, Subtype.ext hc⟩
    have h2 : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.FiniteType.of_surjective _ hsurj)
    change LocallyOfFiniteType
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))))
    infer_instance
  haveI hPbN : IsLocallyNoetherian Pb.left := by
    have gen : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) [LocallyOfFiniteType f],
        LocallyOfFiniteType (Limits.pullback.snd f g) := fun _ _ _ => inferInstance
    haveI hsnd : LocallyOfFiniteType (Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      @gen _ _ _ (wcP1Over K).hom _ this
    exact @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hsnd inferInstance

  have hSigma : IsClosed {x : (wcP1Over K).left | ∃ i, x = S i (IsLocalRing.closedPoint K)} := by
    haveI : Subsingleton (Spec (.of K)) := by
      show Subsingleton (PrimeSpectrum K); infer_instance
    have e : {x : (wcP1Over K).left | ∃ i, x = S i (IsLocalRing.closedPoint K)} =
        ⋃ i, Set.range (S i) := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_iUnion, Set.mem_range]
      constructor
      · rintro ⟨i, rfl⟩; exact ⟨i, _, rfl⟩
      · rintro ⟨i, p, rfl⟩
        exact ⟨i, by rw [Subsingleton.elim p (IsLocalRing.closedPoint K)]⟩
    rw [e]
    refine isClosed_iUnion_of_finite (fun i => ?_)
    haveI := isClosedImmersion_of_comp_eq_id (wcP1Over K).hom (S i) (hS i)
    exact (S i).isClosedEmbedding.isClosed_range

  let Z : Set Pb.left := Pb.hom ⁻¹' {x : (wcP1Over K).left | ∃ i, x = S i (IsLocalRing.closedPoint K)}
  have hZ : IsClosed Z := hSigma.preimage Pb.hom.continuous
  let U : Pb.left.Opens := ⟨Zᶜ, hZ.isOpen_compl⟩
  let W0 : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (U.ι ≫ Pb.hom)
  let g0 : W0 ⟶ Pb := MorphismProperty.Over.homMk U.ι rfl trivial
  have hW0 : ∀ (v : W0.left) (i : Fin m), W0.hom v ≠ S i (IsLocalRing.closedPoint K) := by
    intro v i h
    have hv : (v : U).1 ∉ Z := (v : U).2
    apply hv
    refine ⟨i, ?_⟩
    have e : W0.hom v = Pb.hom (v : U).1 :=
      (Scheme.Hom.comp_apply U.ι Pb.hom (v : U)).trans
        (congrArg Pb.hom (Scheme.Opens.ι_apply U (v : U)))
    rw [← e]; exact h
  have hg0 : (G.obj.map g0.op).hom s = 0 := ha W0 g0 (hy W0 g0 hW0)

  choose V g v hv hz using hloc
  have hA : ∀ i, ∃ A : (V i).left.Opens, IsAffineOpen A ∧ v i ∈ A := fun i => by
    obtain ⟨A, hA, hvA, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := v i) trivial
    exact ⟨A, hA, hvA⟩
  choose A hAaff hvA using hA
  let Wi : Fin m → (wcP1Over K).left.ProEt := fun i => Scheme.ProEt.mk ((A i).ι ≫ (V i).hom)
  let ai : ∀ i, Wi i ⟶ V i := fun i => MorphismProperty.Over.homMk (A i).ι rfl trivial
  let hm : ∀ i, Wi i ⟶ Pb := fun i => ai i ≫ g i
  have hmv : ∀ i, (G.obj.map (hm i).op).hom s = 0 := by
    intro i
    change (G.obj.map (ai i ≫ g i).op).hom s = 0
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
      ha (V i) (g i) (hz i), map_zero]

  let ι := ULift.{u+1} (Option (Fin m))
  let Wf : ι → (wcP1Over K).left.ProEt := fun j => match j with
    | ⟨none⟩ => W0
    | ⟨some i⟩ => Wi i
  let g' : ∀ j, Wf j ⟶ Pb := fun j => match j with
    | ⟨none⟩ => g0
    | ⟨some i⟩ => hm i
  have hsurj : ∀ x : Pb.left, ∃ j : ι, ∃ w : (Wf j).left, (g' j).left w = x := by
    intro x
    by_cases hx : x ∈ U
    · exact ⟨⟨none⟩, (⟨x, hx⟩ : U), Scheme.Opens.ι_apply U ⟨x, hx⟩⟩
    · have hxZ : x ∈ Z := by
        by_contra h
        exact hx h
      obtain ⟨i, hi⟩ := hxZ
      refine ⟨⟨some i⟩, (⟨v i, hvA i⟩ : A i), ?_⟩
      refine Eq.trans (Scheme.Hom.comp_apply (A i).ι (g i).left ⟨v i, hvA i⟩) ?_
      refine Eq.trans (congrArg (g i).left (Scheme.Opens.ι_apply (A i) ⟨v i, hvA i⟩)) ?_
      apply huniq i _ _ _ hi
      refine (Scheme.Hom.comp_apply (g i).left Pb.hom (v i)).symm.trans ?_
      exact (congrArg (fun f => f (v i)) (MorphismProperty.Over.w (g i))).trans (hv i)
  have hvan : ∀ j, (G.obj.map (g' j).op).hom s = 0 := by
    rintro ⟨_ | i⟩
    · exact hg0
    · exact hmv i
  have hWe : ∀ j, WeaklyEtale (g' j).left := fun j => by
    haveI : WeaklyEtale ((g' j).left ≫ Pb.hom) := by
      rw [MorphismProperty.Over.w (g' j)]; exact (Wf j).prop
    exact WeaklyEtale.of_comp (g' j).left Pb.hom
  have hQC : ∀ j, QuasiCompact (g' j).left := by
    rintro ⟨_ | i⟩
    · exact (inferInstance : QuasiCompact U.ι)
    · haveI : IsAffine (A i) := hAaff i
      have hc : CompactSpace (A i) := inferInstance
      exact @quasiCompact_of_compactSpace _ _ (hm i).left hc inferInstance

  let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) Pb.left :=
    Scheme.Cover.mkOfCovers (P := @WeaklyEtale) ι (fun j => (Wf j).left) (fun j => (g' j).left)
      hsurj hWe
  have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
    @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage hQC
      (inferInstanceAs (Finite ι))
  have hR : Presieve.ofArrows (fun j : ι => (Wf j).left) (fun j => (g' j).left) ∈
      Scheme.proetalePrecoverage.coverings Pb.left :=
    Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
  have e := Presieve.map_ofArrows
    (F := Scheme.ProEt.forget (wcP1Over K).left ⋙ Over.forget (wcP1Over K).left) (Y := Wf) g'
  have hR' : Presieve.ofArrows Wf g' ∈
      (Scheme.ProEt.precoverage (wcP1Over K).left).coverings Pb :=
    Precoverage.mem_comap_iff.mpr (e ▸ hR)
  have hRJ : Sieve.generate (Presieve.ofArrows Wf g') ∈
      (Scheme.ProEt.topology (wcP1Over K).left) Pb :=
    Precoverage.generate_mem_toGrothendieck hR'
  have hs0 : s = 0 := by
    refine Sheaf.isSeparated G Pb _ hRJ s 0 ?_
    rintro Y f ⟨Y', h, k, hk, rfl⟩
    rcases hk with ⟨j⟩
    change (G.obj.map (h ≫ g' j).op).hom s = (G.obj.map (h ≫ g' j).op).hom 0
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hvan j,
      map_zero, map_zero]
  exact hb hs0

theorem wc_strict_nbhd_frob_geom_generic_point (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ j, S j ≫ (wcP1Over K).hom = 𝟙 _)
    (V₀ : (wcP1Over K).left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A)) :
    ∃ (Ω : (wcP1Over K).left.ProEt) (a₀ : Ω ⟶ V₀) (φΩ : Ω ⟶ Ω) (L : Type u) (_ : Field L)
      (_ : IsSepClosed L) (eΩ : Ω.left ≅ Spec (.of L)),
      φΩ ≫ a₀ = a₀ ≫ φ₀ ∧ ∀ (z : Ω.left) (j : Fin m), Ω.hom z ≠ S j (IsLocalRing.closedPoint K) :=
by
  classical
  haveI hV : WeaklyEtale V₀.hom := V₀.prop

  obtain ⟨η, hηf, hfix⟩ : ∃ η : V₀.left, IsField (V₀.left.presheaf.stalk η) ∧ φ₀.left η = η := by
    haveI : SmoothOfRelativeDimension 1 (wcP1Over K).hom := wc_proj_space_smooth K 1
    have hk : WeaklyEtale (e.inv ≫ V₀.hom) := inferInstance
    haveI hA : IsDomain (CommRingCat.of A) :=
      wc_strictHensel_weaklyEtale_smooth_isDomain K (wcP1Over K).hom 1 (CommRingCat.of A)
        (e.inv ≫ V₀.hom) hk
    haveI : IsDomain A := hA
    haveI : IsIntegral (Spec (.of A)) := inferInstance
    haveI : Nonempty V₀.left := ⟨e.inv (IsLocalRing.closedPoint A)⟩
    haveI : IsIntegral V₀.left := isIntegral_of_isOpenImmersion e.hom
    refine ⟨genericPoint V₀.left, Field.toIsField V₀.left.functionField, ?_⟩
    have hw : φ₀.left ≫ V₀.hom = V₀.hom := MorphismProperty.Over.w φ₀
    haveI : WeaklyEtale (φ₀.left ≫ V₀.hom) := by rw [hw]; exact hV
    haveI : WeaklyEtale φ₀.left := WeaklyEtale.of_comp φ₀.left V₀.hom
    haveI : Flat φ₀.left := inferInstance
    have h1 : genericPoint V₀.left ⤳ φ₀.left (genericPoint V₀.left) :=
      (genericPoint_spec V₀.left).specializes (Set.mem_univ _)
    obtain ⟨a', ha', ha'η⟩ := (Flat.generalizingMap φ₀.left) h1
    have h2 : genericPoint V₀.left ⤳ a' := (genericPoint_spec V₀.left).specializes (Set.mem_univ _)
    have h3 : a' = genericPoint V₀.left := (ha'.antisymm h2).eq
    calc φ₀.left (genericPoint V₀.left) = φ₀.left a' := by rw [h3]
      _ = genericPoint V₀.left := ha'η

  haveI := wc_fromSpecStalk_weaklyEtale V₀.left η
  haveI hres : IsIso (V₀.left.residue η) := by
    rw [ConcreteCategory.isIso_iff_bijective, Scheme.residue.eq_1]
    refine ⟨?_, IsLocalRing.residue_surjective⟩
    show Function.Injective (IsLocalRing.residue _)
    rw [RingHom.injective_iff_ker_eq_bot, IsLocalRing.ker_residue]
    exact IsLocalRing.isField_iff_maximalIdeal_eq.mp hηf
  haveI : WeaklyEtale (V₀.left.fromSpecResidueField η) := by
    rw [Scheme.fromSpecResidueField.eq_1]
    infer_instance

  let ρ : V₀.left.residueField η ⟶ V₀.left.residueField η :=
    (Scheme.residueFieldCongr hfix.symm).hom ≫ φ₀.left.residueFieldMap η
  have K1 : Spec.map ρ ≫ V₀.left.fromSpecResidueField η =
      V₀.left.fromSpecResidueField η ≫ φ₀.left := by
    show Spec.map ((Scheme.residueFieldCongr hfix.symm).hom ≫ φ₀.left.residueFieldMap η) ≫
      V₀.left.fromSpecResidueField η = V₀.left.fromSpecResidueField η ≫ φ₀.left
    rw [Spec.map_comp, Category.assoc, Scheme.residueFieldCongr_fromSpecResidueField,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]

  let jκ : V₀.left.residueField η →+* SeparableClosure (V₀.left.residueField η) :=
    algebraMap (V₀.left.residueField η) (SeparableClosure (V₀.left.residueField η))
  obtain ⟨ρL, hρL⟩ : ∃ ρL : SeparableClosure (V₀.left.residueField η) →+*
      SeparableClosure (V₀.left.residueField η), ρL.comp jκ = jκ.comp ρ.hom := by
    let f := @IsSepClosed.lift (V₀.left.residueField η) (SeparableClosure (V₀.left.residueField η))
      (SeparableClosure (V₀.left.residueField η)) _ _ _ _ ((jκ.comp ρ.hom).toAlgebra) _ _
    refine ⟨@AlgHom.toRingHom (V₀.left.residueField η) _ _ _ _ _ _ ((jκ.comp ρ.hom).toAlgebra) f,
      RingHom.ext fun x => ?_⟩
    have hc := @AlgHom.commutes (V₀.left.residueField η) (SeparableClosure (V₀.left.residueField η))
      (SeparableClosure (V₀.left.residueField η)) _ _ _ _ ((jκ.comp ρ.hom).toAlgebra) f x
    exact hc
  have K2 : Spec.map (CommRingCat.ofHom ρL) ≫ Spec.map (CommRingCat.ofHom jκ) =
      Spec.map (CommRingCat.ofHom jκ) ≫ Spec.map ρ := by
    have : CommRingCat.ofHom jκ ≫ CommRingCat.ofHom ρL = ρ ≫ CommRingCat.ofHom jκ := by
      apply CommRingCat.hom_ext
      exact hρL
    have h := congrArg Spec.map this
    rw [Spec.map_comp] at h
    rw [h]
    exact Spec.map_comp ρ (CommRingCat.ofHom jκ)

  haveI := wc_fpe_sepClosure_weaklyEtale (V₀.left.residueField η)
  let jj : Spec (.of (SeparableClosure (V₀.left.residueField η))) ⟶ V₀.left :=
    Spec.map (CommRingCat.ofHom jκ) ≫ V₀.left.fromSpecResidueField η
  haveI hjj : WeaklyEtale jj := by dsimp only [jj, jκ]; infer_instance
  have hW : WeaklyEtale (jj ≫ V₀.hom) := inferInstance
  let Ω : (wcP1Over K).left.ProEt := MorphismProperty.Over.mk ⊤ (jj ≫ V₀.hom) hW
  let a₀ : Ω ⟶ V₀ := MorphismProperty.Over.homMk jj rfl trivial

  have hsq : Spec.map (CommRingCat.ofHom ρL) ≫ jj = jj ≫ φ₀.left := by
    show Spec.map (CommRingCat.ofHom ρL) ≫ Spec.map (CommRingCat.ofHom jκ) ≫
      V₀.left.fromSpecResidueField η =
      (Spec.map (CommRingCat.ofHom jκ) ≫ V₀.left.fromSpecResidueField η) ≫ φ₀.left
    rw [← Category.assoc, K2, Category.assoc, K1, Category.assoc]
  have hover : Spec.map (CommRingCat.ofHom ρL) ≫ Ω.hom = Ω.hom := by
    show Spec.map (CommRingCat.ofHom ρL) ≫ (jj ≫ V₀.hom) = jj ≫ V₀.hom
    rw [← Category.assoc, hsq, Category.assoc, MorphismProperty.Over.w φ₀]
  let φΩ : Ω ⟶ Ω := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom ρL)) hover trivial
  let eL : Ω.left ≅ Spec (.of (SeparableClosure (V₀.left.residueField η))) := Iso.refl _
  have hsub : ∀ x y : Ω.left, x = y := by
    intro x y
    have h1 : ∀ w : Ω.left, eL.inv (eL.hom w) = w := fun w => by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    rw [← h1 x, ← h1 y]
    congr 1
    exact Subsingleton.elim (α := PrimeSpectrum (SeparableClosure (V₀.left.residueField η))) _ _
  refine ⟨Ω, a₀, φΩ, SeparableClosure (V₀.left.residueField η), inferInstance,
    SeparableClosure.isSepClosed _, eL, ?_, fun z j hz => ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact hsq
  · obtain ⟨t', -, ht'⟩ := (wc_P1_sections_closed_generize K m S hS).2 Ω z ⟨j, hz⟩
    rw [hsub t' z] at ht'
    exact ht' ⟨j, hz⟩

theorem wc_gc_strict_local_res_injective (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (hG : wcPencilGC K hP ℓ G)
    (V₀ : (wcP1Over K).left.ProEt) (g₀ : V₀ ⟶ wcGeomPoint K (wcP1Over K) hP)
    (A : Type u) [CommRing A] [IsLocalRing A] (e : V₀.left ≅ Spec (.of A))
    (Ω : (wcP1Over K).left.ProEt) (a₀ : Ω ⟶ V₀) (hΩ : Nonempty Ω.left) :
    ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left V₀) G 0,
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a₀)).comp y (zero_add 0) = 0 → y = 0 :=
by
  intro y h0
  obtain ⟨ev, -, hnat⟩ := wc_free_ext0_eval (wcP1Over K).left
  obtain ⟨r, ⟨θ⟩⟩ := hG
  obtain ⟨ω⟩ := hΩ

  have hres : (G.obj.map a₀.op).hom (ev V₀ G y) = 0 := by
    have h1 := hnat V₀ Ω a₀ G y
    have h2 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left a₀)).precomp G (zero_add 0) y
        = 0 := h0
    rw [h2, map_zero] at h1
    exact h1.symm

  let X₀ : Over (wcGeomPoint K (wcP1Over K) hP) := Over.mk g₀
  let X₁ : Over (wcGeomPoint K (wcP1Over K) hP) := Over.mk (a₀ ≫ g₀)
  let hX : X₁ ⟶ X₀ := Over.homMk a₀ rfl
  have key : (θ.hom.hom.app (Opposite.op X₁)).hom ((G.obj.map a₀.op).hom (ev V₀ G y)) =
      ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map a₀.op).hom
        ((θ.hom.hom.app (Opposite.op X₀)).hom (ev V₀ G y)) := by
    have h2 := congrArg (fun f => AddCommGrpCat.Hom.hom f (ev V₀ G y))
      (θ.hom.hom.naturality hX.op)
    exact h2
  have hz : (θ.hom.hom.app (Opposite.op X₁)).hom ((G.obj.map a₀.op).hom (ev V₀ G y)) = 0 :=
    (congrArg (θ.hom.hom.app (Opposite.op X₁)).hom hres).trans (map_zero _)
  have key3 := hz.symm.trans key
  let φ : C(V₀.left, Fin r → ℚ_[ℓ]) :=
    (show ULift.{u+1} C(V₀.left, Fin r → ℚ_[ℓ]) from
      (θ.hom.hom.app (Opposite.op X₀)).hom (ev V₀ G y)).down
  have key2 : (0 : ULift.{u+1} C(Ω.left, Fin r → ℚ_[ℓ])) =
      ULift.up (φ.comp a₀.left.base.hom) := key3
  have hφω : φ (a₀.left ω) = 0 := by
    have h3 := congrArg (fun x : ULift.{u+1} C(Ω.left, Fin r → ℚ_[ℓ]) => x.down ω) key2
    exact h3.symm

  have hspec : ∀ x : V₀.left, φ x = φ (e.inv (IsLocalRing.closedPoint A)) := by
    intro x
    have h1 : e.hom x ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint _
    have h2 : e.inv (e.hom x) ⤳ e.inv (IsLocalRing.closedPoint A) :=
      h1.map e.inv.continuous
    rw [Scheme.hom_inv_apply] at h2
    exact (h2.map φ.continuous).eq
  have hφ0 : φ = 0 := by
    ext x
    rw [hspec x, ← hspec (a₀.left ω), hφω]
    rfl
  have hy0 : (θ.hom.hom.app (Opposite.op X₀)).hom (ev V₀ G y) = 0 := by
    have h4 : (show ULift.{u+1} C(V₀.left, Fin r → ℚ_[ℓ]) from
        (θ.hom.hom.app (Opposite.op X₀)).hom (ev V₀ G y)) = 0 := ULift.ext _ _ hφ0
    exact h4
  have hinv : (θ.inv.hom.app (Opposite.op X₀)).hom
      ((θ.hom.hom.app (Opposite.op X₀)).hom (ev V₀ G y)) = ev V₀ G y := by
    have h1 := Iso.hom_inv_id_app ((sheafToPresheaf _ _).mapIso θ) (Opposite.op X₀)
    have h2 := congrArg (fun f => AddCommGrpCat.Hom.hom f (ev V₀ G y)) h1
    exact h2
  rw [hy0, map_zero] at hinv
  exact (ev V₀ G).map_eq_zero_iff.mp hinv.symm

theorem wc_pencil_Rq_free_ext_transport (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ) :
    ∃ Λ : ∀ V : (wcP1Over F'').left.ProEt, Projective (wcFreeSheaf (wcP1Over F'').left V) →
        (Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ q) 0 ≃+
          Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V))
            (wcLadicSheaf D.Yt.left ℓ) q),
      ∀ (V V' : (wcP1Over F'').left.ProEt) (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
        (hV' : Projective (wcFreeSheaf (wcP1Over F'').left V')) (a : V' ⟶ V)
        (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ q) 0),
        Λ V' hV' ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp y (zero_add 0)) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a))).comp
            (Λ V hV y) (zero_add q) :=
by
  classical
  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat D.f
  obtain ⟨ed, hbij, hnat, -⟩ := ext_rightDerived_adj_edge L (wcProEtPush D.f) adj
    (wcLadicSheaf D.Yt.left ℓ) q
  let κ : ∀ V : (wcP1Over F'').left.ProEt,
      Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V))
          (wcLadicSheaf D.Yt.left ℓ) q →+
        Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V)) (wcLadicSheaf D.Yt.left ℓ) q :=
    fun V => (Abelian.Ext.mk₀ (θ V).hom).precomp (wcLadicSheaf D.Yt.left ℓ) (zero_add q)
  have hκ : ∀ V, Function.Bijective (κ V) := by
    intro V
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun t => (Abelian.Ext.mk₀ (θ V).inv).comp t (zero_add q), ?_, ?_⟩
    · intro t
      show (Abelian.Ext.mk₀ (θ V).inv).comp
        ((Abelian.Ext.mk₀ (θ V).hom).comp t (zero_add q)) (zero_add q) = t
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · intro t
      show (Abelian.Ext.mk₀ (θ V).hom).comp
        ((Abelian.Ext.mk₀ (θ V).inv).comp t (zero_add q)) (zero_add q) = t
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  let Φ : ∀ V : (wcP1Over F'').left.ProEt,
      Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V))
          (wcLadicSheaf D.Yt.left ℓ) q →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) (wcRq D.f ℓ q) 0 :=
    fun V => (ed (wcFreeSheaf (wcP1Over F'').left V)).comp (κ V)
  have hΦ : ∀ V (hV : Projective (wcFreeSheaf (wcP1Over F'').left V)),
      Function.Bijective (Φ V) := by
    intro V hV
    exact (@hbij _ hV).comp (hκ V)
  have hs4 : ∀ {V V' : (wcP1Over F'').left.ProEt} (a : V' ⟶ V)
      (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V))
          (wcLadicSheaf D.Yt.left ℓ) q),
      Φ V' ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a))).comp z
          (zero_add q)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp (Φ V z) (zero_add 0) := by
    intro V V' a z
    show ed _ ((Abelian.Ext.mk₀ (θ V').hom).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a))).comp z
          (zero_add q)) (zero_add q)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp
        (ed _ ((Abelian.Ext.mk₀ (θ V).hom).comp z (zero_add q))) (zero_add 0)
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hθ a, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hnat]
  refine ⟨fun V hV => (AddEquiv.ofBijective (Φ V) (hΦ V hV)).symm, ?_⟩
  intro V V' hV hV' a y
  beta_reduce
  rw [AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply, hs4 a]
  rw [show Φ V ((AddEquiv.ofBijective (Φ V) (hΦ V hV)).symm y) = y from
    (AddEquiv.ofBijective (Φ V) (hΦ V hV)).apply_symm_apply y]

theorem wc_pencil_total_odp_point (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i)) :
    ∃ xb : ((wcProEtPullback D.f).obj V₀).left,
      ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F'') ∧
      ((wcProEtPullback D.f).map φ₀).left xb = xb ∧
      IsLocallyNoetherian ((wcProEtPullback D.f).obj V₀).left ∧
      IsSepClosed (IsLocalRing.ResidueField
        (((wcProEtPullback D.f).obj V₀).left.presheaf.stalk xb)) :=
by
  classical

  have resid : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (p : Y ⟶ Spec (.of K))
      [LocallyOfFiniteType p] (y : Y), IsClosed ({y} : Set Y) →
      IsAlgClosed (IsLocalRing.ResidueField (Y.presheaf.stalk y)) := by
    intro K _ _ Y p _ y hy
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
    haveI h2 : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    haveI h3 : LocallyOfFiniteType (Y.fromSpecResidueField y ≫ p) := inferInstance
    obtain ⟨φ, hφeq⟩ := Spec.map_surjective (Y.fromSpecResidueField y ≫ p)
    have h4 : LocallyOfFiniteType (Spec.map φ) := by rw [hφeq]; exact h3
    have hφ : φ.hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h4
    letI : Algebra K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) := φ.hom.toAlgebra
    haveI : Algebra.FiniteType K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      RingHom.finiteType_algebraMap.mp hφ
    haveI : Module.Finite K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      finite_of_finite_type_of_isJacobsonRing K _
    haveI : Algebra.IsIntegral K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      Algebra.IsIntegral.of_finite K _
    have hb := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K)
      (K := IsLocalRing.ResidueField (Y.presheaf.stalk y))
    exact IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective _ hb)
  haveI hsubb : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
    show Subsingleton (PrimeSpectrum (AlgebraicClosure F'')); infer_instance
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance

  have fibre_lemma : ∀ {Tl Xs Q : Scheme.{u}} (Th : Tl ⟶ Xs) (p₀ : Q ⟶ Xs) [Subsingleton Q]
      (q : Q) (E : Limits.pullback Th p₀ ≅ Spec (.of (AlgebraicClosure F''))),
      ∀ t : Tl, Th t = p₀ q ↔
        t = Limits.pullback.fst Th p₀ (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F''))) := by
    intro Tl Xs Q Th p₀ _ q E
    have hPsub : ∀ z z' : ↥(Limits.pullback (C := Scheme.{u}) Th p₀), z = z' := by
      intro z z'
      exact E.hom.isOpenEmbedding.injective (Subsingleton.elim (E.hom z) (E.hom z'))
    intro t
    constructor
    · intro ht
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback t q ht
      rw [← hz1, hPsub z]
    · rintro rfl
      have hc := congrArg (fun g : Limits.pullback Th p₀ ⟶ Xs =>
        g (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F''))))
        (Limits.pullback.condition (f := Th) (g := p₀))
      simp only [Scheme.Hom.comp_apply] at hc
      exact hc.trans (congrArg (fun x => p₀ x) (Subsingleton.elim _ _))

  have s2 : ∀ {Tl X : Scheme.{u}} (ι : Tl ⟶ X) [IsClosedImmersion ι]
      (E : Tl ≅ Spec (.of (AlgebraicClosure F''))) (t : Tl),
      IsSepClosed (IsLocalRing.ResidueField (X.presheaf.stalk (ι t))) := by
    intro Tl X ι _ E t
    have hTsub : ∀ z z' : Tl, z = z' := by
      intro z z'
      exact E.hom.isOpenEmbedding.injective (Subsingleton.elim (E.hom z) (E.hom z'))
    have hcl : IsClosed ({t} : Set Tl) := by
      have h : ({t} : Set Tl) = Set.univ := Set.eq_univ_of_forall (fun x => hTsub x t)
      rw [h]; exact isClosed_univ
    haveI : LocallyOfFiniteType E.hom := inferInstance
    haveI hac := resid (AlgebraicClosure F'') Tl E.hom t hcl
    have hsurj : Function.Surjective (ι.stalkMap t) := by
      first
        | exact ι.stalkMap_surjective t
        | exact SurjectiveOnStalks.surj_on_stalks t
    have hbij : Function.Bijective (IsLocalRing.ResidueField.map (ι.stalkMap t).hom) := by
      refine ⟨(IsLocalRing.ResidueField.map (ι.stalkMap t).hom).injective, fun y => ?_⟩
      obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨a, rfl⟩ := hsurj s
      exact ⟨IsLocalRing.residue _ a, IsLocalRing.ResidueField.map_residue _ a⟩
    haveI : IsAlgClosed (IsLocalRing.ResidueField (X.presheaf.stalk (ι t))) :=
      IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective _ hbij).symm
    first
      | infer_instance
      | exact IsSepClosed.of_isAlgClosed _

  have s1 : IsNoetherianRing A := by
    obtain ⟨c, ψ, j, hj, hfac, hc, -, hwe⟩ := wc_stpf_chart F'' (D.S i) (D.hS i) V₀ A e hv
    have hmem : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
      let pA : ↥(Spec (.of A)) := IsLocalRing.closedPoint A
      let pF : ↥(Spec (.of F'')) := IsLocalRing.closedPoint F''
      have h1 : j (Spec.map (CommRingCat.ofHom ψ) pA) =
          j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c)) pF) := by
        have ha := congrArg (fun g => g pA) hfac
        have hb := congrArg (fun g => g pF) hc
        simp only [Scheme.Hom.comp_apply] at ha hb
        have hv' : V₀.hom (e.inv pA) = D.S i pF := hv
        rw [← ha, hb]
        exact hv'
      haveI := hj
      have h2 := j.isOpenEmbedding.injective h1
      have h3 := congrArg PrimeSpectrum.asIdeal h2
      change Ideal.comap ψ (IsLocalRing.maximalIdeal A) =
        Ideal.comap (Polynomial.evalRingHom c) (IsLocalRing.maximalIdeal F'') at h3
      have h4 : Polynomial.X - Polynomial.C c ∈
          Ideal.comap (Polynomial.evalRingHom c) (IsLocalRing.maximalIdeal F'') := by
        rw [Ideal.mem_comap, IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]
        simp
      rw [← h3, Ideal.mem_comap] at h4
      exact h4
    obtain ⟨-, -, hnf⟩ := wc_skc_dvr F'' A c ψ hwe hmem
    generalize ψ (Polynomial.X - Polynomial.C c) = t at hnf
    haveI : IsPrincipalIdealRing A := ⟨fun I => by
      by_cases h : ∃ k : ℕ, t ^ k ∈ I
      · refine ⟨⟨t ^ Nat.find h, ?_⟩⟩
        apply le_antisymm
        · intro b hb
          by_cases hb0 : b = 0
          · rw [hb0]; exact Submodule.zero_mem _
          · obtain ⟨v, m, hbv⟩ := hnf b hb0
            have hm : t ^ m ∈ I := by
              have h5 := I.mul_mem_left (↑v⁻¹ : A) hb
              rwa [hbv, ← mul_assoc, Units.inv_mul, one_mul] at h5
            have hN : Nat.find h ≤ m := Nat.find_min' h hm
            show b ∈ Ideal.span {t ^ Nat.find h}
            refine Ideal.mem_span_singleton'.mpr ⟨(v : A) * t ^ (m - Nat.find h), ?_⟩
            rw [hbv, mul_assoc, ← pow_add, Nat.sub_add_cancel hN]
        · show Ideal.span {t ^ Nat.find h} ≤ I
          exact (Ideal.span_singleton_le_iff_mem I).mpr (Nat.find_spec h)
      · refine ⟨⟨0, ?_⟩⟩
        show I = Ideal.span {0}
        rw [Ideal.span_singleton_eq_bot.mpr rfl, eq_bot_iff]
        intro b hb
        rw [Ideal.mem_bot]
        by_contra hb0
        obtain ⟨v, m, hbv⟩ := hnf b hb0
        have hm : t ^ m ∈ I := by
          have h5 := I.mul_mem_left (↑v⁻¹ : A) hb
          rwa [hbv, ← mul_assoc, Units.inv_mul, one_mul] at h5
        exact h ⟨m, hm⟩⟩
    infer_instance

  have hxsCI : IsClosedImmersion (D.xs i) := by
    apply isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  haveI hYp := D.proper
  haveI : LocallyOfFiniteType (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI hfL : LocallyOfFiniteType D.f := locallyOfFiniteType_of_comp D.f (wcP1Over F'').hom
  set T := (wcProEtPullback D.f).obj V₀ with hT
  have E : Limits.pullback T.hom (D.xs i) ≅ Spec (.of (AlgebraicClosure F'')) :=
    Limits.pullbackLeftPullbackSndIso V₀.hom D.f (D.xs i) ≪≫
      Limits.pullback.congrHom rfl (D.hxs i) ≪≫ ε
  have hxbiff := fibre_lemma T.hom (D.xs i) (IsLocalRing.closedPoint F'') E
  refine ⟨Limits.pullback.fst T.hom (D.xs i)
    (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F''))), (hxbiff _).mpr rfl, ?_, ?_, ?_⟩
  · have h1 : (((wcProEtPullback D.f).map φ₀).left ≫ T.hom)
        (Limits.pullback.fst T.hom (D.xs i)
          (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F'')))) =
        T.hom (Limits.pullback.fst T.hom (D.xs i)
          (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F'')))) := by
      rw [MorphismProperty.Over.w ((wcProEtPullback D.f).map φ₀)]
    rw [Scheme.Hom.comp_apply] at h1
    exact (hxbiff _).mp (h1.trans ((hxbiff _).mpr rfl))
  · haveI := s1
    haveI : IsLocallyNoetherian V₀.left := LocallyOfFiniteType.isLocallyNoetherian e.hom
    have hfst : LocallyOfFiniteType (Limits.pullback.fst V₀.hom D.f) := by
      first
        | infer_instance
        | exact MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
            (IsPullback.of_hasPullback V₀.hom D.f).flip hfL
        | exact MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
            (IsPullback.of_hasPullback V₀.hom D.f) hfL
    haveI := hfst
    have hV' : IsLocallyNoetherian ((𝟭 Scheme.{u}).obj V₀.left) :=
      LocallyOfFiniteType.isLocallyNoetherian e.hom
    have hX := @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.fst V₀.hom D.f) hfst hV'
    first
      | exact hX
      | (rw [hT]; exact hX)
      | (show IsLocallyNoetherian (Limits.pullback V₀.hom D.f); exact hX)
  · haveI := hxsCI
    haveI : IsClosedImmersion (Limits.pullback.fst T.hom (D.xs i)) := inferInstance
    exact s2 (Limits.pullback.fst T.hom (D.xs i)) E
      (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F'')))

theorem wc_proet_frob_pullback_square (S : Scheme.{u}) {T U W : S.ProEt} (g : T ⟶ U) (a : W ⟶ U)
    (φT : T ⟶ T) (φU : U ⟶ U) (φW : W ⟶ W) (hT : φT ≫ g = g ≫ φU) (hW : φW ≫ a = a ≫ φU) :
    ∃ (Fm : S.ProEt) (rW : Fm ⟶ W) (rT : Fm ⟶ T) (φF : Fm ⟶ Fm),
      rT ≫ g = rW ≫ a ∧ IsPullback rT.left rW.left g.left a.left ∧
      φF ≫ rW = rW ≫ φW ∧ φF ≫ rT = rT ≫ φT :=
by
  classical
  have hgw : g.left ≫ U.hom = T.hom := MorphismProperty.Over.w g
  have hg : WeaklyEtale g.left := by
    haveI : WeaklyEtale (g.left ≫ U.hom) := by rw [hgw]; exact T.prop
    haveI : WeaklyEtale U.hom := U.prop
    exact WeaklyEtale.of_comp g.left U.hom
  have hsnd : WeaklyEtale (Limits.pullback.snd g.left a.left) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback g.left a.left) hg
  have hcomp : WeaklyEtale (Limits.pullback.snd g.left a.left ≫ W.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ _ _ hsnd W.prop
  let Fm : S.ProEt :=
    MorphismProperty.Over.mk ⊤ (Limits.pullback.snd g.left a.left ≫ W.hom) hcomp
  let rW : Fm ⟶ W :=
    MorphismProperty.Over.homMk (Limits.pullback.snd g.left a.left) rfl trivial
  have hfst : Limits.pullback.fst g.left a.left ≫ T.hom =
      Limits.pullback.snd g.left a.left ≫ W.hom := by
    rw [← MorphismProperty.Over.w g, Limits.pullback.condition_assoc, MorphismProperty.Over.w a]
  let rT : Fm ⟶ T :=
    MorphismProperty.Over.homMk (Limits.pullback.fst g.left a.left) hfst trivial
  have e1 : g.left ≫ φU.left = φT.left ≫ g.left := by
    have h := congrArg (fun k => k.left) hT
    exact h.symm
  have e2 : a.left ≫ φU.left = φW.left ≫ a.left := by
    have h := congrArg (fun k => k.left) hW
    exact h.symm
  let φFl : Limits.pullback g.left a.left ⟶ Limits.pullback g.left a.left :=
    Limits.pullback.map g.left a.left g.left a.left φT.left φW.left φU.left e1 e2
