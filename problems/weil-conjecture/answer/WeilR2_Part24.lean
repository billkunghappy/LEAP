              _ = T.hom := MorphismProperty.Over.w t
          let l' : T ⟶ W' k := MorphismProperty.Over.homMk l hover trivial
          have hl' : l' ≫ ι k = t ≫ a := by
            apply MorphismProperty.Over.Hom.ext
            exact hl
          have e : t ≫ (wcProEtBC i).map w₀ = l' ≫ h' k := by
            rw [← ha, ← Category.assoc, ← hl', Category.assoc, hg]
          rw [e]
          exact R.downward_closed (hRh k) l')
      refine GrothendieckTopology.superset_covering _ ?_ hSW
      intro Y1 f hf
      show SR.arrows (f ≫ w₀)
      rcases hSWR Y1 f hf with hb | hr
      · exact Or.inl hb
      · right
        rw [Functor.map_comp]
        exact hr
    · haveI : IsEmpty ((wcProEtBC i).obj (Wc j')).left := hWcempty j'
      have hmem : SR.arrows (wc j') := Or.inl (Scheme.ProEt.bot_mem_topology _)
      show Sieve.pullback (wc j') SR ∈ Scheme.ProEt.topology _ (Wc j')
      rw [Sieve.pullback_eq_top_of_mem _ hmem]
      exact GrothendieckTopology.top_mem _ _

  have hcov := c6 (Scheme.ProEt.topology Z) (wcProEtBC i) c7
  have hA : Limits.PreservesColimitsOfSize.{u+1, u+1}
      (sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
        (Functor.whiskeringLeft (Y.ProEt)ᵒᵖ (Z.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (wcProEtBC i).op ⋙
          presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) := by
    constructor
    intro I _
    constructor
    intro F
    apply t_s3d (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) (wcProEtBC i) F
    rw [← GrothendieckTopology.W_iff, GrothendieckTopology.W_iff_isLocallyBijective]
    exact ⟨c3 _ _ (wcProEtBC i) hcov _ _ _ (c5 _ F) (Presheaf.isLocallyInjective_toSheafify' _ _),
      c4 _ _ (wcProEtBC i) hcov _ ((presheafToSheaf _ _).obj _) _
        (Presheaf.isLocallySurjective_toSheafify' _ _)⟩
  haveI hA' : Limits.PreservesColimitsOfSize.{u+1, u+1} (wcProEtPush i) := hA
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) :=
    inferInstance
  haveI : Limits.HasColimitsOfSize.{u+1, u+1}
      (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.hasColimits _
  haveI : WellPowered.{u+1} (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.wellPowered _
  haveI : WellPowered.{u+1} (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})ᵒᵖ :=
    Abelian.wellPowered_opposite
  haveI : HasSeparator (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.hasSeparator
  exact isLeftAdjoint_of_preservesColimits_of_isSeparating
    (P := ObjectProperty.singleton
      (separator (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})))
    (isSeparator_separator _)
    (wcProEtPush i)

theorem wc_proet_rightAdj_homology_zero_of_free_ext_local {Z : Scheme.{u}}
    {𝒟 : Type*} [Category 𝒟] [Abelian 𝒟] [HasExt 𝒟]
    (L : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⥤ 𝒟)
    (R : 𝒟 ⥤ Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) [R.Additive]
    (adj : L ⊣ R) (A : 𝒟) (I : InjectiveResolution A) (q : ℕ)
    (hgood : ∀ W : Z.ProEt, Sieve.generate (fun (W' : Z.ProEt) (_ : W' ⟶ W) =>
        ∀ x : Abelian.Ext (L.obj (wcFreeSheaf Z W')) A q, x = 0) ∈ Scheme.ProEt.topology Z W) :
    Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical

  have hfreeEquiv : ∀ (S : Scheme.{u}) (U : S.ProEt),
      ∃ e : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U),
      (∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf S U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g)) ∧
      (∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}, e F 0 = 0) := by
    intro S U
    let e2 : ∀ G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op U) :=
      fun G => ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := U) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have hnat2 : ∀ (G G' : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
        (h : yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G' (h ≫ ψ) = ψ.app (Opposite.op U) (e2 G h) := by
      intro G G' ψ h
      have hW := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u}) h ψ
      have hY := uliftYonedaEquiv_comp.{u+1}
        ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G h)
        (((Functor.whiskeringRight S.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
            (forget AddCommGrpCat.{u+1})).map ψ)
      exact (congrArg (uliftYonedaEquiv.{u+1} (X := U) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
    let e : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U) := fun F =>
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 F.obj)
    have hnat : ∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf S U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g) := by
      intro F F' φ g
      have hA := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
      exact (congrArg (e2 F'.obj) hA).trans (hnat2 F.obj F'.obj φ.hom _)
    refine ⟨e, hnat, fun F => ?_⟩
    have h1 := hnat F F 0 0
    rw [Limits.zero_comp] at h1
    rw [h1]
    have h0 : (0 : F ⟶ F).hom = 0 :=
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_zero F F
    rw [h0, NatTrans.app_zero]
    rfl

  have hcomp : ∀ {M N P : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (p : M ⟶ N) (p' : N ⟶ P) (V : Z.ProEtᵒᵖ) (x : M.obj.obj V),
      ((p ≫ p').hom.app V).hom x = (p'.hom.app V).hom ((p.hom.app V).hom x) :=
    fun _ _ _ _ => rfl
  have hnat : ∀ {M N : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}} (p : M ⟶ N)
      {W W' : Z.ProEt} (g : W' ⟶ W) (x : M.obj.obj (Opposite.op W)),
      (p.hom.app (Opposite.op W')).hom ((M.obj.map g.op).hom x) =
        (N.obj.map g.op).hom ((p.hom.app (Opposite.op W)).hom x) := by
    intro M N p W W' g x
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) (p.hom.naturality g.op)
    exact h
  have hMmap : ∀ {M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}} {W Y Y' : Z.ProEt}
      (h₀ : Y ⟶ W) (g' : Y' ⟶ Y) (x : M.obj.obj (Opposite.op W)),
      (M.obj.map (g' ≫ h₀).op).hom x = (M.obj.map g'.op).hom ((M.obj.map h₀.op).hom x) := by
    intro M W Y Y' h₀ g' x
    rw [op_comp, Functor.map_comp]
    rfl
  have hmono : ∀ {M N : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}} (p : M ⟶ N)
      [Mono p] (W : Z.ProEt), Function.Injective (p.hom.app (Opposite.op W)).hom := by
    intro M N p _ W
    have h1 : Mono ((sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
        (evaluation _ _).obj (Opposite.op W)).map p) := Functor.map_mono _ p
    exact (AddCommGrpCat.mono_iff_injective _).1 h1

  have s1 : ∀ (P : CochainComplex (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) ℕ),
      (∀ (W : Z.ProEt) (s : (P.X q).obj.obj (Opposite.op W)),
        ((P.d q (q + 1)).hom.app (Opposite.op W)).hom s = 0 →
        Sieve.generate (fun (W' : Z.ProEt) (g : W' ⟶ W) =>
          ∃ y : (P.X ((ComplexShape.up ℕ).prev q)).obj.obj (Opposite.op W'),
            ((P.X q).obj.map g.op).hom s =
              ((P.d ((ComplexShape.up ℕ).prev q) q).hom.app (Opposite.op W')).hom y) ∈
          Scheme.ProEt.topology Z W) →
      Limits.IsZero (P.homology q) := by
    intro P hloc
    have hTi : ∀ (V : Z.ProEtᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).obj.obj V),
        ((P.iCycles q).hom.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).hom.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).hom.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    have hTπ : ∀ (V : Z.ProEtᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).obj.obj V),
        ((P.homologyπ q).hom.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).hom.app V).hom y) = 0 := by
      intro V y
      rw [← hcomp, P.toCycles_comp_homologyπ]
      rfl
    have hzero : ∀ (W : Z.ProEt) (z : (P.cycles q).obj.obj (Opposite.op W)),
        ((P.homologyπ q).hom.app (Opposite.op W)).hom z = 0 := by
      intro W z
      have hs : ((P.d q (q + 1)).hom.app (Opposite.op W)).hom
          (((P.iCycles q).hom.app (Opposite.op W)).hom z) = 0 := by
        rw [← hcomp, P.iCycles_d]
        rfl
      refine (Sheaf.isSeparated (P.homology q)) W _ (hloc W _ hs)
        (((P.homologyπ q).hom.app (Opposite.op W)).hom z) 0 ?_
      rintro Y f ⟨Y', k, g₀, ⟨y, hy⟩, rfl⟩
      have hw : ((P.cycles q).obj.map g₀.op).hom z =
          ((P.toCycles ((ComplexShape.up ℕ).prev q) q).hom.app (Opposite.op Y')).hom y := by
        apply hmono (P.iCycles q) Y'
        rw [hnat, hy, hTi]
      have h1 : ((P.homology q).obj.map (k ≫ g₀).op).hom
          (((P.homologyπ q).hom.app (Opposite.op W)).hom z) = 0 := by
        rw [hMmap, ← hnat, hw, hTπ]
        exact map_zero _
      change ((P.homology q).obj.map (k ≫ g₀).op).hom
          (((P.homologyπ q).hom.app (Opposite.op W)).hom z) =
        ((P.homology q).obj.map (k ≫ g₀).op).hom 0
      rw [h1, map_zero]
    have hπ0 : P.homologyπ q = 0 := by
      apply Sheaf.hom_ext
      ext ⟨W⟩ z
      rw [hzero W z]
      rfl
    exact Limits.IsZero.of_epi_eq_zero _ hπ0

  have hcob : ∀ {X : 𝒟} (f : X ⟶ I.cocomplex.X q) (hf : f ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk f (q + 1) rfl hf = 0 → ∃ k : X ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev q),
        f = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q := by
    intro X f hf h0
    by_cases hr : (ComplexShape.up ℕ).Rel ((ComplexShape.up ℕ).prev q) q
    · obtain ⟨k, hk⟩ := (I.extMk_eq_zero_iff f (q + 1) rfl hf _ hr).1 h0
      exact ⟨k, hk.symm⟩
    · have ht : q = 0 := by
        rcases Nat.eq_zero_or_pos q with ht | ht
        · exact ht
        · exfalso
          have hr' : (ComplexShape.up ℕ).Rel (q - 1) q := by
            simp only [ComplexShape.up_Rel]; omega
          rw [ComplexShape.prev_eq' _ hr'] at hr
          exact hr hr'
      refine ⟨0, ?_⟩
      rw [Limits.zero_comp]
      subst ht
      have h1 := congrArg I.extEquivCohomologyClass h0
      rw [InjectiveResolution.extEquivCohomologyClass_extMk,
        InjectiveResolution.extEquivCohomologyClass_zero,
        CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
        CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
          (by norm_num)] at h1
      obtain ⟨g', hg'⟩ := h1
      have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
        CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1)
      rw [hz.eq_of_tgt g' 0, Limits.zero_comp] at hg'
      rw [← cancel_mono (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv, Limits.zero_comp]
      exact hg'.symm

  have s2 : ∀ (W : Z.ProEt),
      (∀ x : Abelian.Ext (L.obj (wcFreeSheaf Z W)) A q, x = 0) →
      ∀ (s : (R.obj (I.cocomplex.X q)).obj.obj (Opposite.op W)),
        ((R.map (I.cocomplex.d q (q + 1))).hom.app (Opposite.op W)).hom s = 0 →
        ∃ y : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).obj.obj (Opposite.op W),
          s = ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).hom.app
            (Opposite.op W)).hom y := by
    intro W hext s hs
    obtain ⟨ev, hn', hev0⟩ := hfreeEquiv Z W
    have hσ : (ev _).symm s ≫ R.map (I.cocomplex.d q (q + 1)) = 0 := by
      apply (ev _).injective
      rw [hn', Equiv.apply_symm_apply, hev0]
      exact hs
    have hσ' : (adj.homEquiv _ _).symm ((ev _).symm s) ≫ I.cocomplex.d q (q + 1) = 0 := by
      apply (adj.homEquiv _ _).injective
      rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, hσ,
        Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
    obtain ⟨k, hk⟩ := hcob _ _ (hext (I.extMk _ (q + 1) rfl hσ'))
    refine ⟨ev _ (adj.homEquiv _ _ k), ?_⟩
    have e1 : (ev _).symm s = adj.homEquiv _ _ k ≫
        R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) := by
      rw [← Adjunction.homEquiv_naturality_right, ← hk, Equiv.apply_symm_apply]
    calc s = ev _ ((ev _).symm s) := (Equiv.apply_symm_apply _ _).symm
      _ = _ := by rw [e1, hn']

  refine s1 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) ?_
  intro W s hs
  refine (Scheme.ProEt.topology Z).superset_covering ?_ (hgood W)
  rw [Sieve.generate_le_iff]
  intro W' g hgd
  apply Sieve.le_generate
  have hs' : ((R.map (I.cocomplex.d q (q + 1))).hom.app (Opposite.op W')).hom
      (((R.obj (I.cocomplex.X q)).obj.map g.op).hom s) = 0 := by
    rw [hnat]
    exact (congrArg ((R.obj (I.cocomplex.X (q + 1))).obj.map g.op).hom hs).trans (map_zero _)
  exact s2 W' hgd _ hs'

theorem wc_proet_closed_push_free_bc_coker_iso {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt) :
    Nonempty ((wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V)) ≅
      Limits.cokernel (wcFreeSheafMap Y (wcOpenRestrIncl Y O V))) :=
by
  classical

  have hfree0 : ∀ (S : Scheme.{u}) (W : S.ProEt), IsEmpty W.left →
      Limits.IsZero (wcFreeSheaf S W) := by
    intro S W hW
    haveI : Finite W.left := Finite.of_subsingleton
    haveI : QuasiSeparatedSpace W.left := ⟨fun U W' _ _ _ _ => (U ∩ W').toFinite.isCompact⟩
    have hcov := proet_finite_affine_jointly_surjective_covers S W 0 (fun k => k.elim0)
      (fun k => k.elim0) (fun k => k.elim0) (fun x => (hW.false x).elim)
    have hbot : (⊥ : Sieve W) ∈ Scheme.ProEt.topology S W := by
      refine (Scheme.ProEt.topology S).superset_covering ?_ hcov
      rintro T f ⟨Y', g, k, hk, -⟩
      cases hk with
      | mk j => exact j.elim0
    obtain ⟨eq, -, -⟩ := proet_free_sheaf_hom_equiv S W
    have hz : Limits.IsZero ((wcFreeSheaf S W).obj.obj (Opposite.op W)) :=
      (Sheaf.isTerminalOfBotCover (wcFreeSheaf S W) W hbot).isZero
    haveI := AddCommGrpCat.subsingleton_of_isZero hz
    haveI : Subsingleton (wcFreeSheaf S W ⟶ wcFreeSheaf S W) :=
      (eq (wcFreeSheaf S W)).subsingleton
    exact (Limits.IsZero.iff_id_eq_zero _).mpr (Subsingleton.elim _ _)

  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat i
  haveI : (wcProEtPush i).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : (wcProEtPush i).PreservesZeroMorphisms := by
    first
      | exact Functor.preservesZeroMorphisms_of_isRightAdjoint _
      | exact inferInstance
  have hun : ∀ {X X' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f : X ⟶ X'),
      f ≫ adj.unit.app X' = adj.unit.app X ≫ (wcProEtPush i).map (L.map f) :=
    fun f => adj.unit.naturality f
  let ζ : L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtBC i).obj V) := θ V

  have hempty : IsEmpty ((wcProEtPullback i).obj (wcOpenRestr Y O V)).left := by
    have hmemO : ∀ y : (wcOpenRestr Y O V).left,
        (wcOpenRestr Y O V).hom y ∈ (O : Set Y) := by
      intro y
      have hU : (wcOpenRestr Y O V).hom =
          Limits.pullback.fst O.ι V.hom ≫ O.ι := by
        show Limits.pullback.snd O.ι _ ≫ _ = _
        exact Limits.pullback.condition.symm
      rw [hU]
      change O.ι (Limits.pullback.fst O.ι V.hom y) ∈ (O : Set Y)
      rw [← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    refine ⟨fun z => ?_⟩
    change ↥(Limits.pullback (wcOpenRestr Y O V).hom i) at z
    have hc0 := congrArg (fun g => g z)
      (Limits.pullback.condition (f := (wcOpenRestr Y O V).hom) (g := i))
    have hc : (wcOpenRestr Y O V).hom
        (Limits.pullback.fst (wcOpenRestr Y O V).hom i z) =
        i (Limits.pullback.snd (wcOpenRestr Y O V).hom i z) := by
      first
        | exact hc0
        | simpa only [Scheme.Hom.comp_apply] using hc0
        | simpa using hc0
    have h1 := hmemO (Limits.pullback.fst _ i z)
    rw [hc, hO] at h1
    exact h1 ⟨_, rfl⟩
  have hz0 := hfree0 _ _ hempty
  have hLι : L.map (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) ≫ ζ.hom = 0 := by
    show L.map (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) ≫ (θ V).hom = 0
    rw [hθ, hz0.eq_of_tgt (θ (wcOpenRestr Y O V)).hom 0, Limits.zero_comp]
  have hkill : wcFreeSheafMap Y (wcOpenRestrIncl Y O V) ≫
      (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom) = 0 := by
    rw [← Category.assoc (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)), hun, Category.assoc,
      ← Functor.map_comp, hLι, Functor.map_zero, Limits.comp_zero]

  let c := Limits.cokernel.desc _ _ hkill
  have hπc : Limits.cokernel.π (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) ≫ c =
      adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom :=
    Limits.cokernel.π_desc _ _ hkill
  haveI : IsIso ((wcProEtPush i).map ζ.hom) := inferInstance

  haveI : Epi (adj.unit.app (wcFreeSheaf Y V)) := wc_proet_closed_free_unit_epi i L adj V
  haveI : Epi (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom) := epi_comp _ _
  haveI : Epi c := epi_of_epi_fac hπc

  haveI : Mono c := by
    apply Preadditive.mono_of_cancel_zero
    intro T k hk
    haveI : Epi (Limits.pullback.fst k (Limits.cokernel.π
        (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)))) :=
      Abelian.epi_pullback_of_epi_g _ _
    have hcond := (Limits.pullback.condition (f := k) (g := Limits.cokernel.π
        (wcFreeSheafMap Y (wcOpenRestrIncl Y O V))))
    have hq : Limits.pullback.snd k (Limits.cokernel.π
        (wcFreeSheafMap Y (wcOpenRestrIncl Y O V))) ≫
        adj.unit.app (wcFreeSheaf Y V) = 0 := by
      apply (cancel_mono ((wcProEtPush i).map ζ.hom)).mp
      rw [Limits.zero_comp, Category.assoc, ← hπc, ← Category.assoc, ← hcond, Category.assoc, hk,
        Limits.comp_zero]
    obtain ⟨T', p, h', hp, hph⟩ := wc_proet_closed_free_unit_exact i L adj O hO V _ _ hq
    haveI := hp
    apply (cancel_epi (p ≫ Limits.pullback.fst k (Limits.cokernel.π
        (wcFreeSheafMap Y (wcOpenRestrIncl Y O V))))).mp
    rw [Limits.comp_zero, Category.assoc, hcond, ← Category.assoc, hph, Category.assoc,
      Limits.cokernel.condition, Limits.comp_zero]
  haveI : IsIso c := isIso_of_mono_of_epi c
  exact ⟨(asIso c).symm⟩

theorem wc_sdgri_flat_restrict_injective_of_local_nzd {V Y : Scheme.{u}} (q : V ⟶ Y) [Flat q]
    (O : Y.Opens)
    (hloc : ∀ y : Y, ∃ U : Y.Opens, IsAffineOpen U ∧ y ∈ U ∧ ∃ t ∈ nonZeroDivisors Γ(Y, U),
      Y.basicOpen t ≤ O) :
    Function.Injective (Limits.pullback.snd O.ι q).appTop.hom :=
by
  classical
  rw [injective_iff_map_eq_zero]
  intro f hf
  have s1 : ∀ (x : V) (hx : q x ∈ O), (V.presheaf.germ ⊤ x trivial).hom f = 0 := by
    intro x hx
    have hxr : x ∈ Set.range (Limits.pullback.snd O.ι q) := by
      rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
      exact hx
    obtain ⟨p, rfl⟩ := hxr
    have h1 := Scheme.Hom.germ_stalkMap_apply (Limits.pullback.snd O.ι q) ⊤ p trivial f
    have h2 : ((Limits.pullback.snd O.ι q).app ⊤).hom f = 0 := hf
    rw [h2, map_zero] at h1
    have hinj : Function.Injective ((Limits.pullback.snd O.ι q).stalkMap p).hom :=
      (ConcreteCategory.bijective_of_isIso _).1
    apply hinj
    rw [h1, map_zero]
  apply TopCat.Presheaf.section_ext V.sheaf ⊤ f 0
  intro v _
  rw [map_zero]
  obtain ⟨U, hU, hyU, t, ht, hle⟩ := hloc (q v)
  have hvU : v ∈ q ⁻¹ᵁ U := hyU
  obtain ⟨W, hWa, hvW, hWU⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens V)) hvU
  have hg := HasRingHomProperty.appLE @Flat q inferInstance ⟨U, hU⟩ ⟨W, hWa⟩ hWU
  have hres : ∀ (y : V) (hy : y ∈ W),
      (V.presheaf.germ W y hy).hom ((V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom f) =
        (V.presheaf.germ ⊤ y trivial).hom f := by
    intro y hy
    exact TopCat.Presheaf.germ_res_apply V.presheaf (homOfLE (le_top : W ≤ ⊤)) y hy f
  set x := (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom f with hxdef
  set s := (q.appLE U W hWU).hom t with hsdef
  have hxB : TopCat.Presheaf.restrictOpen (F := V.presheaf) x (V.basicOpen s)
      (V.basicOpen_le s) = 0 := by
    apply TopCat.Presheaf.section_ext V.sheaf
    intro y hy
    change (V.presheaf.germ (V.basicOpen s) y hy).hom
        ((V.presheaf.map (homOfLE (V.basicOpen_le s)).op).hom x) =
      (V.presheaf.germ (V.basicOpen s) y hy).hom 0
    rw [map_zero]
    have hyW : y ∈ W := V.basicOpen_le s hy
    have hy' : y ∈ V.basicOpen s := hy
    rw [hsdef, Scheme.basicOpen_appLE] at hy'
    have hqy : q y ∈ O := hle hy'.2
    have e1 := TopCat.Presheaf.germ_res_apply V.presheaf (homOfLE (V.basicOpen_le s)) y hy x
    refine e1.trans ?_
    rw [hres y hyW]
    exact s1 y hqy
  obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen V hWa x s hxB
  have hx0 : x = 0 := by
    letI := (q.appLE U W hWU).hom.toAlgebra
    haveI : Module.Flat Γ(Y, U) Γ(V, W) := hg
    have hreg : IsSMulRegular Γ(V, W) (t ^ n) :=
      (Module.Flat.isSMulRegular_of_nonZeroDivisors ht).pow n
    apply hreg.right_eq_zero_of_smul
    rw [Algebra.smul_def, map_pow, RingHom.algebraMap_toAlgebra]
    exact hn
  change (V.presheaf.germ ⊤ v trivial).hom f = 0
  rw [← hres v hvW, hx0, map_zero]

theorem wc_sdgri_reduced_local_nzd_avoiding_closed (Y : Scheme.{u}) [IsLocallyNoetherian Y]
    [AlgebraicGeometry.IsReduced Y] (T : Set Y) (hT : IsClosed T)
    (hgen : ∀ y : Y, (∀ y' : Y, y' ⤳ y → y' = y) → y ∉ T) :
    ∀ y : Y, ∃ U : Y.Opens, IsAffineOpen U ∧ y ∈ U ∧ ∃ t ∈ nonZeroDivisors Γ(Y, U),
      ∀ x ∈ Y.basicOpen t, x ∉ T :=
by
  classical
  have sA : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [_root_.IsReduced R] (J : Ideal R),
      (∀ p ∈ minimalPrimes R, ¬ J ≤ p) → ∃ t ∈ J, t ∈ nonZeroDivisors R := by
    intro R _ _ _ J hJ
    have hfin : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
    have hprime : ∀ i ∈ hfin.toFinset, i ≠ ⊥ → i ≠ ⊥ → ((fun q : Ideal R => q) i).IsPrime := by
      intro i hi _ _
      exact Ideal.minimalPrimes_isPrime ((Set.Finite.mem_toFinset hfin).mp hi)
    have hnot : ¬ ((J : Set R) ⊆ ⋃ i ∈ (↑hfin.toFinset : Set (Ideal R)),
        (((fun q : Ideal R => q) i : Ideal R) : Set R)) := by
      intro hsub
      obtain ⟨p, hp, hJp⟩ := (Ideal.subset_union_prime ⊥ ⊥ hprime).mp hsub
      exact hJ p ((Set.Finite.mem_toFinset hfin).mp hp) hJp
    obtain ⟨t, htJ, htn⟩ := Set.not_subset.mp hnot
    refine ⟨t, htJ, ?_⟩
    have key : ∀ x : R, t * x = 0 → x = 0 := by
      intro x hx
      have hxmem : x ∈ sInf (minimalPrimes R) := by
        rw [Ideal.mem_sInf]
        intro p hp
        have hpp : p.IsPrime := Ideal.minimalPrimes_isPrime hp
        have h0 : t * x ∈ p := by rw [hx]; exact p.zero_mem
        rcases hpp.mem_or_mem h0 with h | h
        · exact absurd (Set.mem_biUnion (Finset.mem_coe.mpr
            ((Set.Finite.mem_toFinset hfin).mpr hp)) h) htn
        · exact h
      have hrad : x ∈ (⊥ : Ideal R).radical := by
        rw [← Ideal.sInf_minimalPrimes]
        exact hxmem
      obtain ⟨n, hn⟩ := hrad
      exact IsReduced.eq_zero x ⟨n, by simpa using hn⟩
    exact mem_nonZeroDivisors_iff_left.mpr key
  have sB : ∀ (U : Y.Opens) (hU : IsAffineOpen U) (p : PrimeSpectrum Γ(Y, U)),
      p.asIdeal ∈ minimalPrimes Γ(Y, U) → ∀ y' : Y, y' ⤳ hU.fromSpec p → y' = hU.fromSpec p := by
    intro U hU p hp y' hy'
    have hmem : hU.fromSpec p ∈ (U : Set Y) := by
      rw [← hU.range_fromSpec]; exact ⟨p, rfl⟩
    have hy'U : y' ∈ (U : Set Y) := hy'.mem_open U.isOpen hmem
    rw [← hU.range_fromSpec] at hy'U
    obtain ⟨q, rfl⟩ := hy'U
    have hqp : q ⤳ p := (hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp hy'
    have hle : q.asIdeal ≤ p.asIdeal := (PrimeSpectrum.le_iff_specializes q p).mpr hqp
    have hp' : Minimal (fun I : Ideal Γ(Y, U) => I.IsPrime ∧ ⊥ ≤ I) p.asIdeal := hp
    have heq : p.asIdeal = q.asIdeal := (hp'.eq_of_le ⟨q.isPrime, bot_le⟩ hle).symm
    rw [PrimeSpectrum.ext heq]
  intro y
  obtain ⟨U, hU, hyU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (AlgebraicGeometry.Scheme.isBasis_affineOpens Y))
    (show y ∈ (⊤ : Y.Opens) from trivial)
  have hU : IsAffineOpen U := hU
  haveI : IsNoetherianRing Γ(Y, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  haveI : _root_.IsReduced Γ(Y, U) := AlgebraicGeometry.IsReduced.component_reduced U
  let S : Set (PrimeSpectrum Γ(Y, U)) := hU.fromSpec ⁻¹' T
  have hS : IsClosed S := hT.preimage hU.fromSpec.continuous
  have hJ : ∀ P ∈ minimalPrimes Γ(Y, U), ¬ PrimeSpectrum.vanishingIdeal S ≤ P := by
    intro P hP hJP
    let p : PrimeSpectrum Γ(Y, U) := ⟨P, Ideal.minimalPrimes_isPrime hP⟩
    have hpS : p ∈ S := by
      have h1 : p ∈ PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal S : Set Γ(Y, U)) :=
        (PrimeSpectrum.mem_zeroLocus _ _).mpr hJP
      rwa [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hS.closure_eq] at h1
    exact hgen (hU.fromSpec p) (sB U hU p hP) hpS
  obtain ⟨t, htJ, htnzd⟩ := sA Γ(Y, U) _ hJ
  refine ⟨U, hU, hyU, t, htnzd, ?_⟩
  intro x hx hxT
  have hxU : x ∈ (U : Set Y) := Y.basicOpen_le t hx
  rw [← hU.range_fromSpec] at hxU
  obtain ⟨q, rfl⟩ := hxU
  have hq : q ∈ hU.fromSpec ⁻¹ᵁ Y.basicOpen t := hx
  rw [hU.fromSpec_preimage_basicOpen] at hq
  have htq : t ∉ q.asIdeal := (PrimeSpectrum.mem_basicOpen _ _).mp hq
  exact htq ((PrimeSpectrum.mem_vanishingIdeal _ _).mp htJ q hxT)

theorem wc_smooth_divisor_generic_not_mem (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (y : Y) (hy : ∀ y' : Y, y' ⤳ y → y' = y) : y ∉ Set.range i :=
by
  intro hmem
  obtain ⟨z, rfl⟩ := hmem
  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI hdom : IsDomain (Y.presheaf.stalk (i z)) := (wc_fntame_smooth_stalk_normal k Y pY (i z)).1

  have hA : IsField (Y.presheaf.stalk (i z)) := by
    have hmax : ∀ I : Ideal (Y.presheaf.stalk (i z)), I.IsPrime → I.IsMaximal := by
      intro I hI
      let p : PrimeSpectrum (Y.presheaf.stalk (i z)) := ⟨I, hI⟩
      have h1 : Y.fromSpecStalk (i z) p ⤳ i z := by
        have : Y.fromSpecStalk (i z) p ∈ Set.range (Y.fromSpecStalk (i z)) := ⟨p, rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      have h2 := hy _ h1
      have h3 : Y.fromSpecStalk (i z) p =
          Y.fromSpecStalk (i z) (IsLocalRing.closedPoint (Y.presheaf.stalk (i z))) := by
        rw [h2, Scheme.fromSpecStalk_closedPoint]
      have h4 := (Y.fromSpecStalk (i z)).isEmbedding.injective h3
      have h5 : I = IsLocalRing.maximalIdeal (Y.presheaf.stalk (i z)) :=
        congrArg PrimeSpectrum.asIdeal h4
      rw [h5]
      exact IsLocalRing.maximalIdeal.isMaximal _
    haveI : Ring.KrullDimLE 0 (Y.presheaf.stalk (i z)) := Ring.KrullDimLE.mk₀ hmax
    exact Ring.KrullDimLE.isField_of_isDomain

  have hsurj : Function.Surjective (i.stalkMap z).hom := i.stalkMap_surjective z
  have hinj : Function.Injective (i.stalkMap z).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    obtain ⟨b, hb⟩ := hA.mul_inv_cancel hne
    have : (1 : Z.presheaf.stalk z) = 0 := by
      rw [← map_one (i.stalkMap z).hom, ← hb, map_mul, ha, zero_mul]
    exact one_ne_zero this

  have hc : (i.stalkMap z).hom.comp (wcLdpConst k pY (i z)) = wcLdpConst k (i ≫ pY) z := by
    ext r
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply i ⊤ z trivial _)

  have hrank : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] [Nontrivial A]
      (φA : R →+* A) (φB : R →+* B) (f : A →+* B), Function.Bijective f → f.comp φA = φB →
      (letI := φA.toAlgebra; Module.Free A Ω[A⁄R]) →
      (letI := φA.toAlgebra; Module.finrank A Ω[A⁄R]) =
        (letI := φB.toAlgebra; Module.finrank B Ω[B⁄R]) := by
    intro R A B _ _ _ _ φA φB f hf hcf hfree
    letI : Algebra R A := φA.toAlgebra
    letI : Algebra R B := φB.toAlgebra
    letI : Algebra A B := f.toAlgebra
    haveI : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq' hcf.symm
    haveI : Algebra.Etale A B := RingHom.Etale.toAlgebra (RingHom.Etale.of_bijective hf)
    haveI : Nontrivial B := hf.1.nontrivial
    haveI := hfree
    rw [← LinearEquiv.finrank_eq (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R A B),
      Module.finrank_baseChange]
  have hY := wc_ldp_il_stalk_of_smooth_field k pY (d + 1) (i z)
  have hZ := wc_ldp_il_stalk_of_smooth_field k (i ≫ pY) d z
  have heq := hrank (wcLdpConst k pY (i z)) (wcLdpConst k (i ≫ pY) z) (i.stalkMap z).hom
    ⟨hinj, hsurj⟩ hc hY.2.1
  have := hY.2.2.2.1.symm.trans (heq.trans hZ.2.2.2.1)
  omega

theorem wc_smooth_divisor_proet_gamma_restrict_injective (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt) (hVa : IsAffine V.left) :
    Function.Injective (Limits.pullback.snd O.ι V.hom).appTop.hom :=
by
  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : ∀ x : Y, IsDomain (Y.presheaf.stalk x) :=
    fun x => (wc_fntame_smooth_stalk_normal k Y pY x).1
  haveI : AlgebraicGeometry.IsReduced Y := isReduced_of_isReduced_stalk Y
  haveI : Flat V.hom := @WeaklyEtale.flat _ _ V.hom V.prop
  have hT : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  have hl0 := wc_sdgri_reduced_local_nzd_avoiding_closed Y (Set.range i) hT
    (fun y hy => wc_smooth_divisor_generic_not_mem k pY d i y hy)
  have hloc : ∀ y : Y, ∃ U : Y.Opens, IsAffineOpen U ∧ y ∈ U ∧
      ∃ t ∈ nonZeroDivisors Γ(Y, U), Y.basicOpen t ≤ O := by
    intro y
    obtain ⟨U, hU, hy, t, ht, hTt⟩ := hl0 y
    refine ⟨U, hU, hy, t, ht, fun x hx => ?_⟩
    rw [← SetLike.mem_coe, hO]
    exact hTt x hx
  exact wc_sdgri_flat_restrict_injective_of_local_nzd V.hom O hloc

theorem wc_roots_restrict_injective_of_generization (X : Scheme.{u}) (U W : X.Opens)
    (hgen : ∀ x : X, ∃ x' : X, x' ⤳ x ∧ x' ∈ U)
    (m : ℕ) (hm : ∀ x : X, IsUnit ((m : ℕ) : X.presheaf.stalk x))
    (ξ₁ ξ₂ : Γ(X, W)) (h₁ : ξ₁ ^ m = 1) (h₂ : ξ₂ ^ m = 1)
    (hres : (X.presheaf.map (homOfLE (inf_le_left : W ⊓ U ≤ W)).op).hom ξ₁ =
      (X.presheaf.map (homOfLE (inf_le_left : W ⊓ U ≤ W)).op).hom ξ₂) :
    ξ₁ = ξ₂ :=
by
  classical
  have core : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (a b : R),
      IsUnit (m : R) → a ^ m = 1 → b ^ m = 1 → ¬ IsUnit (a - b) → a = b := by
    intro R _ _ a b hmR ha hb hab
    have hm0 : m ≠ 0 := by
      rintro rfl
      have h0 : IsUnit (0 : R) := by simpa using hmR
      exact not_isUnit_zero h0
    have hrab : IsLocalRing.residue R a = IsLocalRing.residue R b := by
      have h0 : IsLocalRing.residue R (a - b) = 0 := by
        by_contra hne
        exact hab ((IsLocalRing.residue_ne_zero_iff_isUnit _).mp hne)
      rw [map_sub, sub_eq_zero] at h0
      exact h0
    have hra : IsLocalRing.residue R a ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit a).mpr (IsUnit.of_pow_eq_one ha hm0)
    have hrm : (m : IsLocalRing.ResidueField R) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue R) m]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hmR
    have hrS : IsLocalRing.residue R (∑ i ∈ Finset.range m, a ^ i * b ^ (m - 1 - i)) ≠ 0 := by
      rw [map_sum]
      simp only [map_mul, map_pow, ← hrab]
      rw [geom_sum₂_self]
      exact mul_ne_zero hrm (pow_ne_zero _ hra)
    have hSu := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hrS
    have hmul : (∑ i ∈ Finset.range m, a ^ i * b ^ (m - 1 - i)) * (a - b) = 0 := by
      rw [geom_sum₂_mul, ha, hb, sub_self]
    exact sub_eq_zero.mp ((IsUnit.mul_right_eq_zero hSu).mp hmul)
  apply TopCat.Presheaf.section_ext X.sheaf
  intro x hx
  show (X.presheaf.germ W x hx).hom ξ₁ = (X.presheaf.germ W x hx).hom ξ₂
  obtain ⟨x', hsp, hx'U⟩ := hgen x
  have hx'W : x' ∈ W := hsp.mem_open W.isOpen hx
  have hx'WU : x' ∈ W ⊓ U := ⟨hx'W, hx'U⟩
  have e : ∀ ξ : Γ(X, W), (X.presheaf.stalkSpecializes hsp).hom ((X.presheaf.germ W x hx).hom ξ) =
      (X.presheaf.germ (W ⊓ U) x' hx'WU).hom
        ((X.presheaf.map (homOfLE (inf_le_left : W ⊓ U ≤ W)).op).hom ξ) := by
    intro ξ
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
    exact (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_left : W ⊓ U ≤ W))
      x' hx'WU ξ).symm
  apply core (X.presheaf.stalk x) _ _ (hm x)
  · rw [← map_pow, h₁, map_one]
  · rw [← map_pow, h₂, map_one]
  · intro hu
    have h1 := IsUnit.map (X.presheaf.stalkSpecializes hsp).hom hu
    rw [map_sub, e, e, hres, sub_self] at h1
    exact not_isUnit_zero h1

theorem wc_affine_germ_vanish_spread (X : Scheme.{u}) [IsAffine X] (U' : X.Opens)
    (hU' : IsCompact (U' : Set X)) (z : X) (s : Γ(X, U'))
    (hs : ∀ (x : X) (hx : x ∈ U'), x ⤳ z → (X.presheaf.germ U' x hx).hom s = 0) :
    ∃ f : Γ(X, ⊤), z ∈ X.basicOpen f ∧
      (X.presheaf.map (homOfLE (inf_le_right : X.basicOpen f ⊓ U' ≤ U')).op).hom s = 0 :=
by
  classical

  obtain ⟨S, hS1, hS2⟩ : ∃ S : Finset Γ(X, ⊤), (∀ g ∈ S, X.basicOpen g ≤ U') ∧
      ∀ x ∈ U', ∃ g ∈ S, x ∈ X.basicOpen g := by
    obtain ⟨s0, hfin, heq⟩ := (TopologicalSpace.Opens.IsBasis.isCompact_open_iff_eq_finite_iUnion
      X.basicOpen (isBasis_basicOpen X) (fun g => ((isAffineOpen_top X).basicOpen g).isCompact)
      (U' : Set X)).mp ⟨hU', U'.isOpen⟩
    refine ⟨hfin.toFinset, ?_, ?_⟩
    · intro g hg x hx
      have : x ∈ (U' : Set X) := by
        rw [heq]; exact Set.mem_iUnion₂.mpr ⟨g, hfin.mem_toFinset.mp hg, hx⟩
      exact this
    · intro x hx
      have hx' : x ∈ (U' : Set X) := hx
      rw [heq] at hx'
      obtain ⟨g, hg, hxg⟩ := Set.mem_iUnion₂.mp hx'
      exact ⟨g, hfin.mem_toFinset.mpr hg, hxg⟩

  have piece : ∀ g : Γ(X, ⊤), ∃ a : Γ(X, ⊤), z ∈ X.basicOpen a ∧
      (X.basicOpen g ≤ U' → ∀ (x : X) (hx : x ∈ U'), x ∈ X.basicOpen g → x ∈ X.basicOpen a →
        (X.presheaf.germ U' x hx).hom s = 0) := by
    intro g
    by_cases hg : X.basicOpen g ≤ U'
    swap
    · exact ⟨1, by rw [Scheme.basicOpen_one]; trivial, fun h => absurd h hg⟩
    have hV : IsAffineOpen (X.basicOpen g) := (isAffineOpen_top X).basicOpen g
    obtain ⟨t, htdef⟩ : ∃ t : Γ(X, X.basicOpen g), t = (X.presheaf.map (homOfLE hg).op).hom s :=
      ⟨_, rfl⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : Γ(X, ⊤) →+* Γ(X, X.basicOpen g),
        φ = (X.presheaf.map (homOfLE (le_top : X.basicOpen g ≤ ⊤)).op).hom := ⟨_, rfl⟩
    have hφD : ∀ a : Γ(X, ⊤), X.basicOpen (φ a) = X.basicOpen g ⊓ X.basicOpen a := by
      intro a; rw [hφ, Scheme.basicOpen_res]

    have key : ∃ a : Γ(X, ⊤), z ∈ X.basicOpen a ∧ φ a * t = 0 := by
      by_contra hcon
      push_neg at hcon
      let N : Submonoid Γ(X, ⊤) :=
        { carrier := {a | z ∈ X.basicOpen a}
          one_mem' := by
            show z ∈ X.basicOpen (1 : Γ(X, ⊤))
            rw [Scheme.basicOpen_one]; trivial
          mul_mem' := by
            intro a b ha hb
            show z ∈ X.basicOpen (a * b)
            rw [Scheme.basicOpen_mul]; exact ⟨ha, hb⟩ }
      let M : Submonoid Γ(X, X.basicOpen g) := N.map φ.toMonoidHom
      let I : Ideal Γ(X, X.basicOpen g) := (Submodule.span Γ(X, X.basicOpen g) {t}).annihilator
      have hI : ∀ r, r ∈ I ↔ r * t = 0 := fun r => by
        rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul]
      have hdisj : Disjoint (I : Set Γ(X, X.basicOpen g)) (M : Set Γ(X, X.basicOpen g)) := by
        rw [Set.disjoint_left]
        rintro b hbI ⟨a, ha, rfl⟩
        exact hcon a ha ((hI _).mp hbI)
      obtain ⟨Q, hQp, hIQ, hQM⟩ := Ideal.exists_le_prime_disjoint I M hdisj
      have hQa : ∀ a : Γ(X, ⊤), z ∈ X.basicOpen a → φ a ∉ Q := by
        intro a ha hQ
        exact Set.disjoint_left.mp hQM hQ ⟨a, ha, rfl⟩
      let q : PrimeSpectrum Γ(X, X.basicOpen g) := ⟨Q, hQp⟩
      have hxV : hV.fromSpec q ∈ X.basicOpen g := by
        have : hV.fromSpec q ∈ Set.range hV.fromSpec := ⟨q, rfl⟩
        rw [hV.range_fromSpec] at this; exact this
      have hmemb : ∀ r : Γ(X, X.basicOpen g), r ∉ Q → hV.fromSpec q ∈ X.basicOpen r := by
        intro r hr
        have : q ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen r := by
          rw [hV.fromSpec_preimage_basicOpen]; exact hr
        exact this
      have hxz : hV.fromSpec q ⤳ z := by
        rw [specializes_iff_forall_open]
        intro W hW hzW
        obtain ⟨_, ⟨a, rfl⟩, hza, hle⟩ :=
          (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen X))
            (show z ∈ (⟨W, hW⟩ : TopologicalSpace.Opens X) from hzW)
        have h1 := hmemb (φ a) (hQa a hza)
        rw [hφD] at h1
        exact hle h1.2
      have hgerm : (X.presheaf.germ (X.basicOpen g) (hV.fromSpec q) hxV).hom t = 0 := by
        rw [htdef, TopCat.Presheaf.germ_res_apply]
        exact hs _ (hg hxV) hxz
      obtain ⟨W, hxW, iU, iV, hW⟩ := TopCat.Presheaf.germ_eq X.presheaf (hV.fromSpec q) hxV hxV
        t 0 (by rw [hgerm, map_zero])
      obtain ⟨u, huW, hxu⟩ := hV.exists_basicOpen_le (V := W) ⟨hV.fromSpec q, hxW⟩ hxV
      obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X hV t u
        (by
          apply TopCat.Presheaf.section_ext X.sheaf
          intro y hy
          change (X.presheaf.germ (X.basicOpen u) y hy).hom
              ((X.presheaf.map (homOfLE (X.basicOpen_le u)).op).hom t) =
            (X.presheaf.germ (X.basicOpen u) y hy).hom 0
          rw [TopCat.Presheaf.germ_res_apply,
            ← TopCat.Presheaf.germ_res_apply X.presheaf iU y (huW hy), hW]
          simp)
      have huQ : u ∉ Q := by
        have : q ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen u := hxu
        rw [hV.fromSpec_preimage_basicOpen] at this; exact this
      exact huQ (hQp.mem_of_pow_mem n (hIQ ((hI _).mpr hn)))
    obtain ⟨a, hza, hat⟩ := key
    refine ⟨a, hza, fun _ x hx hxg hxa => ?_⟩
    have hxφ : x ∈ X.basicOpen (φ a) := by
      rw [hφD]; exact ⟨hxg, hxa⟩
    have h0 := germ_eq_zero_of_pow_mul_eq_zero (X := X) (U := X.basicOpen g) ⟨x, hxg⟩
      (f := t) (s := φ a) hxφ (n := 1) (by rw [pow_one]; exact hat)
    rw [htdef, TopCat.Presheaf.germ_res_apply] at h0
    exact h0

  choose a ha using piece
  refine ⟨∏ g ∈ S, a g, ?_, ?_⟩
  · exact Finset.prod_induction a (fun b => z ∈ X.basicOpen b)
      (fun b c hb hc => by rw [Scheme.basicOpen_mul]; exact ⟨hb, hc⟩)
      (by rw [Scheme.basicOpen_one]; trivial) (fun g _ => (ha g).1)
  · apply TopCat.Presheaf.section_ext X.sheaf
    intro x hx
    change (X.presheaf.germ _ x hx).hom ((X.presheaf.map (homOfLE inf_le_right).op).hom s) =
      (X.presheaf.germ _ x hx).hom 0
    rw [TopCat.Presheaf.germ_res_apply, map_zero]
    obtain ⟨g, hgS, hxg⟩ := hS2 x hx.2
    have hle : X.basicOpen (∏ g ∈ S, a g) ≤ X.basicOpen (a g) := by
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem a hgS
      rw [hc, Scheme.basicOpen_mul]; exact inf_le_left
    exact (ha g).2 (hS1 g hgS) x _ hxg (hle hx.1)

theorem wc_domain_stalk_roots_germ_const (X : Scheme.{u}) (z : X)
    (hdom : IsDomain (X.presheaf.stalk z)) (m : ℕ) (hm : 0 < m) (ω : X.presheaf.stalk z)
    (hω : IsPrimitiveRoot ω m) (U' : X.Opens) (ζ : Γ(X, U')) (hζ : ζ ^ m = 1) :
    ∃ a : ℕ, ∀ (x : X) (hx : x ∈ U') (hxz : x ⤳ z),
      (X.presheaf.germ U' x hx).hom ζ = ((X.presheaf.stalkSpecializes hxz).hom ω) ^ a :=
by
  classical

  have hloc : ∀ (x₁ z₁ : X) (h : x₁ ⤳ z₁),
      letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk x₁)
        ((IsLocalRing.maximalIdeal (X.presheaf.stalk x₁)).comap
          (X.presheaf.stalkSpecializes h).hom) := by
    intro x₁ z₁ h
    have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
        (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
        ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
        @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
        @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
        letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
      intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
      letI : Algebra A R := gR.toAlgebra
      letI : Algebra A S := gS.toAlgebra
      letI : Algebra R S := φ.toAlgebra
      have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
      haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
      have hle : P.primeCompl ≤ Q.primeCompl := by
        intro a ha haQ
        have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
        have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
        have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
          exact Ideal.mem_map_of_mem _ haQ
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
      haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
      show IsLocalization _ S
      refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
      · rintro _ ⟨a, ha, rfl⟩
        show φ (gR a) ∉ IsLocalRing.maximalIdeal S
        rw [hc a]
        exact IsLocalRing.notMem_maximalIdeal.mpr
          (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
      · intro r hr
        exact IsLocalRing.notMem_maximalIdeal.mp hr
    obtain ⟨W, hW, hzW, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₁) (U := ⊤) trivial
    have hxW : x₁ ∈ W := h.mem_open W.isOpen hzW
    have hLz := hW.isLocalization_stalk ⟨z₁, hzW⟩
    have hLx := hW.isLocalization_stalk ⟨x₁, hxW⟩
    have hcomp : (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ W z₁ hzW).hom =
        (X.presheaf.germ W x₁ hxW).hom := by
      rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
    exact key Γ(X, W) _ _ _ _ _ hcomp _ _ hLz hLx

  have G : ∀ (y w : X) (h : y ⤳ w), IsDomain (X.presheaf.stalk w) →
      IsDomain (X.presheaf.stalk y) ∧ Function.Injective (X.presheaf.stalkSpecializes h).hom := by
    intro y w h hw
    haveI := hw
    letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
    haveI := hloc y w h
    have hle : ((IsLocalRing.maximalIdeal (X.presheaf.stalk y)).comap
        (X.presheaf.stalkSpecializes h).hom).primeCompl ≤ nonZeroDivisors (X.presheaf.stalk w) :=
      Ideal.primeCompl_le_nonZeroDivisors _
    exact ⟨IsLocalization.isDomain_of_le_nonZeroDivisors (X.presheaf.stalk y) hle,
      IsLocalization.injective (X.presheaf.stalk y) hle⟩

  haveI := hdom
  let p0 : PrimeSpectrum (X.presheaf.stalk z) := ⟨⊥, Ideal.isPrime_bot⟩
  let η : X := X.fromSpecStalk z p0
  have hgen : ∀ x : X, x ⤳ z → η ⤳ x := by
    intro x hx
    have hr : x ∈ Set.range (X.fromSpecStalk z) := by
      rw [Scheme.range_fromSpecStalk]; exact hx
    obtain ⟨q, rfl⟩ := hr
    have hpq : p0 ⤳ q :=
      (PrimeSpectrum.le_iff_specializes p0 q).mp (show p0.asIdeal ≤ q.asIdeal from bot_le)
    exact hpq.map (X.fromSpecStalk z).continuous
  have hηz : η ⤳ z := hgen z specializes_rfl
  haveI : NeZero m := ⟨hm.ne'⟩

  by_cases hη : η ∈ U'
  · obtain ⟨hdη, hinj⟩ := G η z hηz hdom
    haveI := hdη
    have hω' : IsPrimitiveRoot ((X.presheaf.stalkSpecializes hηz).hom ω) m :=
      hω.map_of_injective hinj
    have hζη : ((X.presheaf.germ U' η hη).hom ζ) ^ m = 1 := by
      rw [← map_pow, hζ, map_one]
    obtain ⟨i, -, hi⟩ := hω'.eq_pow_of_pow_eq_one hζη
    refine ⟨i, fun x hx hxz => ?_⟩

    have hηx := hgen x hxz
    obtain ⟨hdx, -⟩ := G x z hxz hdom
    obtain ⟨-, hinjx⟩ := G η x hηx hdx
    apply hinjx
    rw [map_pow, TopCat.Presheaf.stalkSpecializes_comp_apply,
      TopCat.Presheaf.germ_stalkSpecializes_apply]
    exact hi.symm
  · exact ⟨0, fun x hx hxz => absurd ((hgen x hxz).mem_open U'.isOpen hx) hη⟩

theorem wc_smooth_divisor_wcontr_roots_extend (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (m : ℕ) (hm : (m : k) ≠ 0) (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt)
    (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)))
    (ζ : rootsOfUnity m Γ(Limits.pullback O.ι V.hom, ⊤)) :
    ∃ ξ : rootsOfUnity m Γ(V.left, ⊤),
      restrictRootsOfUnity (Limits.pullback.snd O.ι V.hom).appTop.hom m ξ = ζ :=
by
  classical
  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI hln : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : IsAffine V.left := hV.1
  haveI : WeaklyEtale V.hom := V.prop
  haveI : Flat V.hom := WeaklyEtale.flat
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero

  have hmx : ∀ x : V.left, IsUnit ((m : ℕ) : V.left.presheaf.stalk x) := by
    intro x
    have h1 : IsUnit (m : k) := isUnit_iff_ne_zero.mpr hm
    have h2 := IsUnit.map ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (V.hom ≫ pY).appTop ≫
      V.left.presheaf.germ ⊤ x trivial).hom h1
    have h3 : ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (V.hom ≫ pY).appTop ≫
      V.left.presheaf.germ ⊤ x trivial).hom (m : k) = (m : V.left.presheaf.stalk x) :=
      map_natCast _ m
    rw [h3] at h2
    exact h2

  have gres : ∀ {A B : V.left.Opens} (j : A ⟶ B) (x : V.left) (hx : x ∈ A)
      (s : Γ(V.left, B)),
      (V.left.presheaf.germ A x hx).hom ((V.left.presheaf.map j.op).hom s) =
        (V.left.presheaf.germ B x (leOfHom j hx)).hom s :=
    fun j x hx s => TopCat.Presheaf.germ_res_apply V.left.presheaf j x hx s
  have gspec : ∀ {A : V.left.Opens} {y : V.left} (hy : y ∈ A) {x : V.left} (h : x ⤳ y)
      (s : Γ(V.left, A)),
      (V.left.presheaf.stalkSpecializes h).hom ((V.left.presheaf.germ A y hy).hom s) =
        (V.left.presheaf.germ A x (h.mem_open A.isOpen hy)).hom s := by
    intro A y hy x h s
    exact TopCat.Presheaf.germ_stalkSpecializes_apply V.left.presheaf hy h s

  obtain ⟨U, hUdef⟩ : ∃ U : V.left.Opens, U = (Limits.pullback.snd O.ι V.hom) ''ᵁ ⊤ := ⟨_, rfl⟩
  have hUrange : (U : Set V.left) = Set.range (Limits.pullback.snd O.ι V.hom) := by
    rw [hUdef, Scheme.Hom.image_top_eq_opensRange, Scheme.Hom.coe_opensRange]
  have hUmem : ∀ x : V.left, x ∈ U ↔ V.hom x ∉ Set.range i := by
    intro x
    have h2 : Set.range (Limits.pullback.snd O.ι V.hom) = V.hom ⁻¹' (O : Set Y) := by
      rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
      rfl
    rw [← SetLike.mem_coe, hUrange, h2, Set.mem_preimage, hO]
    exact Iff.rfl
  have hUc : IsCompact (U : Set V.left) := by
    have hcV : CompactSpace V.left := inferInstance
    have hcP : CompactSpace (Limits.pullback O.ι V.hom : Scheme.{u}) :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd O.ι V.hom) _ hcV
    rw [hUrange]
    exact isCompact_range (Limits.pullback.snd O.ι V.hom).continuous

  have hgen : ∀ t : V.left, ∃ t' : V.left, t' ⤳ t ∧ t' ∈ U := by
    intro t
    obtain ⟨K, hK, hyK⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      ({V.hom t} : Set Y) isIrreducible_singleton
    obtain ⟨y₀, hy₀⟩ := QuasiSober.sober hK.prop (isClosed_of_mem_irreducibleComponents K hK)
    have hmax : ∀ y' : Y, y' ⤳ y₀ → y' = y₀ := by
      intro y' hy'
      have hcl : K ⊆ closure {y'} := by
        rw [← hy₀.def]
        exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hy'))
          isClosed_closure
      have heq : K = closure {y'} := hK.eq_of_le isIrreducible_singleton.closure hcl
      have h2 : y₀ ⤳ y' := by
        rw [specializes_iff_mem_closure, hy₀.def, heq]
        exact subset_closure rfl
      exact (hy'.antisymm h2).eq
    obtain ⟨t', ht', hgt'⟩ := Flat.generalizingMap V.hom (hy₀.specializes (hyK rfl))
    refine ⟨t', ht', (hUmem t').mpr ?_⟩
    rw [hgt']
    exact wc_smooth_divisor_generic_not_mem k pY d i y₀ hmax

  obtain ⟨e, he⟩ : ∃ e : Γ(Limits.pullback O.ι V.hom, ⊤) ≃+* Γ(V.left, U),
      ∀ s, e ((Limits.pullback.snd O.ι V.hom).appTop.hom s) =
        (V.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom s := by
    subst hUdef
    exact ⟨((Limits.pullback.snd O.ι V.hom).appIso ⊤).symm.commRingCatIsoToRingEquiv,
      fun s => congrArg (fun φ => φ.hom s)
        (Scheme.Hom.app_appIso_inv (Limits.pullback.snd O.ι V.hom) ⊤)⟩
  have hζ₀ : ((ζ : Γ(Limits.pullback O.ι V.hom, ⊤)ˣ) : Γ(Limits.pullback O.ι V.hom, ⊤)) ^ m
      = 1 := by
    rw [← Units.val_pow_eq_pow_val, (mem_rootsOfUnity m _).mp ζ.2, Units.val_one]
  obtain ⟨ζ', hζ'def⟩ : ∃ ζ' : Γ(V.left, U),
      ζ' = e ((ζ : Γ(Limits.pullback O.ι V.hom, ⊤)ˣ) : Γ(Limits.pullback O.ι V.hom, ⊤)) :=
    ⟨_, rfl⟩
  have hζ' : ζ' ^ m = 1 := by rw [hζ'def, ← map_pow, hζ₀, map_one]

  have hloc : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      ∃ (a : Γ(V.left, ⊤)) (ω : Γ(V.left, V.left.basicOpen a)),
        z ∈ V.left.basicOpen a ∧ ω ^ m = 1 ∧
        ∀ (x : V.left) (hx : x ∈ V.left.basicOpen a) (hxU : x ∈ U),
          (V.left.presheaf.germ _ x hx).hom ω = (V.left.presheaf.germ U x hxU).hom ζ' := by
    intro z hz
    have hsh := hV.2.2.2.2 z hz
    haveI : HenselianLocalRing (V.left.presheaf.stalk z) := hsh.1
    haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := hsh.2
    obtain ⟨ω, hω⟩ := wc_henselian_sepClosed_primitive_root (V.left.presheaf.stalk z) m (hmx z)
    have hdom := wc_weaklyEtale_smooth_stalk_isDomain k pY (d + 1) V z hsh
    obtain ⟨W₁, hzW₁, ω₁, hω₁⟩ := TopCat.Presheaf.exists_germ_eq V.left.presheaf ω
    have hg : (V.left.presheaf.germ W₁ z hzW₁).hom (ω₁ ^ m) =
        (V.left.presheaf.germ W₁ z hzW₁).hom 1 := by
      rw [map_pow, map_one]
      exact (congrArg (· ^ m) hω₁).trans hω.pow_eq_one
    obtain ⟨W₂, hzW₂, iU, iV, hW₂⟩ :=
      TopCat.Presheaf.germ_eq V.left.presheaf z hzW₁ hzW₁ _ _ hg
    obtain ⟨_, ⟨a₀, rfl⟩, hza₀, hle⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen V.left)) hzW₂
    obtain ⟨ω₂, hω₂def⟩ : ∃ ω₂ : Γ(V.left, V.left.basicOpen a₀),
        ω₂ = (V.left.presheaf.map (homOfLE hle).op).hom ((V.left.presheaf.map iU.op).hom ω₁) :=
      ⟨_, rfl⟩
    have hω₂m : ω₂ ^ m = 1 := by
      rw [hω₂def, ← map_pow, ← map_pow]
      erw [hW₂]
      rw [map_one, map_one]
    have hgz : (V.left.presheaf.germ _ z hza₀).hom ω₂ = ω := by
      rw [hω₂def, gres, gres]
      exact hω₁

    obtain ⟨U', hU'def⟩ : ∃ U' : V.left.Opens, U' = V.left.basicOpen a₀ ⊓ U := ⟨_, rfl⟩
    have hU'c : IsCompact (U' : Set V.left) := by
      rw [hU'def, TopologicalSpace.Opens.coe_inf]
      exact QuasiSeparatedSpace.inter_isCompact _ _ (V.left.basicOpen a₀).isOpen
        ((isAffineOpen_top V.left).basicOpen a₀).isCompact U.isOpen hUc
    have hU'D : U' ≤ V.left.basicOpen a₀ := by rw [hU'def]; exact inf_le_left
    have hU'U : U' ≤ U := by rw [hU'def]; exact inf_le_right
    obtain ⟨ζ'', hζ''def⟩ : ∃ ζ'' : Γ(V.left, U'),
        ζ'' = (V.left.presheaf.map (homOfLE hU'U).op).hom ζ' := ⟨_, rfl⟩
    have hζ'' : ζ'' ^ m = 1 := by rw [hζ''def, ← map_pow, hζ', map_one]
    obtain ⟨a, ha⟩ := wc_domain_stalk_roots_germ_const V.left z hdom m (Nat.pos_of_ne_zero hm0)
      ω hω U' ζ'' hζ''
    obtain ⟨s, hsdef⟩ : ∃ s : Γ(V.left, U'),
        s = ζ'' - ((V.left.presheaf.map (homOfLE hU'D).op).hom ω₂) ^ a := ⟨_, rfl⟩
    have hs : ∀ (x : V.left) (hx : x ∈ U'), x ⤳ z → (V.left.presheaf.germ U' x hx).hom s = 0 := by
      intro x hx hxz
      have e1 := ha x hx hxz
      have e2 : (V.left.presheaf.germ U' x hx).hom
          ((V.left.presheaf.map (homOfLE hU'D).op).hom ω₂) =
          (V.left.presheaf.stalkSpecializes hxz).hom ω := by
        rw [gres, ← hgz, gspec]
      rw [hsdef, map_sub, map_pow, e1, e2, sub_self]
    obtain ⟨f, hzf, hf0⟩ := wc_affine_germ_vanish_spread V.left U' hU'c z s hs
    have hDmul : V.left.basicOpen (a₀ * f) ≤ V.left.basicOpen a₀ := by
      rw [Scheme.basicOpen_mul]; exact inf_le_left
    refine ⟨a₀ * f, ((V.left.presheaf.map (homOfLE hDmul).op).hom ω₂) ^ a, ?_, ?_, ?_⟩
    · rw [Scheme.basicOpen_mul]; exact ⟨hza₀, hzf⟩
    · rw [← pow_mul, mul_comm a m, pow_mul, ← map_pow, hω₂m, map_one, one_pow]
    · intro x hx hxU
      have hx' : x ∈ V.left.basicOpen a₀ ⊓ V.left.basicOpen f := by
        rw [← Scheme.basicOpen_mul]; exact hx
      have hxU' : x ∈ U' := by rw [hU'def]; exact ⟨hx'.1, hxU⟩
      have hxfU' : x ∈ V.left.basicOpen f ⊓ U' := ⟨hx'.2, hxU'⟩
      have h0 : (V.left.presheaf.germ U' x hxU').hom s = 0 := by
        have := congrArg (V.left.presheaf.germ _ x hxfU').hom hf0
        rwa [gres, map_zero] at this
      have h1 : (V.left.presheaf.germ U' x hxU').hom ζ'' =
          (V.left.presheaf.germ U x hxU).hom ζ' := by
        rw [hζ''def, gres]
      rw [hsdef, map_sub, map_pow, sub_eq_zero, h1, gres] at h0
      rw [map_pow, gres, h0]

  choose a ω hzD hωm hωg using hloc
  choose zt hzt using fun t => (hV.2.2.1 t).exists
  obtain ⟨Wf, hWf⟩ : ∃ Wf : V.left → V.left.Opens,
      Wf = fun t => V.left.basicOpen (a (zt t) (hzt t).1) := ⟨_, rfl⟩
  have hxW : ∀ t, t ∈ Wf t := by
    intro t
    rw [hWf]
    exact (hzt t).2.mem_open (V.left.basicOpen _).isOpen (hzD _ _)
  obtain ⟨sf, hsf⟩ : ∃ sf : ∀ t, Γ(V.left, Wf t), HEq sf (fun t => ω (zt t) (hzt t).1) := by
    subst hWf; exact ⟨_, HEq.rfl⟩
  have hsfm : ∀ t, sf t ^ m = 1 := by
    subst hWf; cases hsf; intro t; exact hωm _ _
  have hsfg : ∀ t (x : V.left) (hx : x ∈ Wf t) (hxU : x ∈ U),
      (V.left.presheaf.germ _ x hx).hom (sf t) = (V.left.presheaf.germ U x hxU).hom ζ' := by
    subst hWf; cases hsf; intro t x hx hxU; exact hωg _ _ x hx hxU
  have hcover : (⊤ : V.left.Opens) ≤ iSup Wf := by
    intro x _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxW x⟩
  have hcompat : TopCat.Presheaf.IsCompatible V.left.sheaf.obj Wf sf := by
    intro t t'
    apply wc_roots_restrict_injective_of_generization V.left U (Wf t ⊓ Wf t') hgen m hmx
    · have h := congrArg (V.left.presheaf.map ((Wf t).infLELeft (Wf t')).op).hom (hsfm t)
      rw [map_pow, map_one] at h
      exact h
    · have h := congrArg (V.left.presheaf.map ((Wf t).infLERight (Wf t')).op).hom (hsfm t')
      rw [map_pow, map_one] at h
      exact h
    · apply TopCat.Presheaf.section_ext V.left.sheaf
      intro x hx
      have e1 := gres (homOfLE (inf_le_left : Wf t ⊓ Wf t' ⊓ U ≤ Wf t ⊓ Wf t')) x hx
        ((V.left.presheaf.map ((Wf t).infLELeft (Wf t')).op).hom (sf t))
      have e2 := gres (homOfLE (inf_le_left : Wf t ⊓ Wf t' ⊓ U ≤ Wf t ⊓ Wf t')) x hx
        ((V.left.presheaf.map ((Wf t).infLERight (Wf t')).op).hom (sf t'))
      erw [e1, e2, gres, gres, hsfg t x hx.1.1 hx.2, hsfg t' x hx.1.2 hx.2]
  obtain ⟨Ξ, hΞ, -⟩ := TopCat.Sheaf.existsUnique_gluing' V.left.sheaf Wf ⊤
    (fun t => homOfLE le_top) hcover sf hcompat
  have hΞm : Ξ ^ m = 1 := by
    apply TopCat.Sheaf.eq_of_locally_eq' V.left.sheaf Wf ⊤ (fun t => homOfLE le_top) hcover
    intro t
    rw [map_pow, hΞ t]
    exact (hsfm t).trans (map_one _).symm
  have hΞU : (V.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom Ξ = ζ' := by
    apply TopCat.Presheaf.section_ext V.left.sheaf
    intro x hx
    have e1 := gres (homOfLE (le_top : Wf x ≤ ⊤)) x (hxW x) Ξ
    have e2 := hsfg x x (hxW x) hx
    erw [gres, ← e1]
    erw [hΞ x]
    exact e2
  have hΞu : IsUnit Ξ := IsUnit.of_pow_eq_one hΞm hm0
  obtain ⟨u, hu⟩ : ∃ u : (Γ(V.left, ⊤))ˣ, (u : Γ(V.left, ⊤)) = Ξ := ⟨hΞu.unit, hΞu.unit_spec⟩
  have hum : u ^ m = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one, hu]
    exact hΞm
  refine ⟨⟨u, (mem_rootsOfUnity _ _).2 hum⟩, ?_⟩
  apply Subtype.ext
  apply Units.ext
  rw [restrictRootsOfUnity_coe_apply]
  apply e.injective
  rw [he, ← hζ'def]
  simp only
  rw [hu]
  exact hΞU

theorem wc_proet_coker_open_restr_ext_low_vanish (S : Scheme.{u}) (O : S.Opens) (V : S.ProEt)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (hproj : Projective (wcFreeSheaf S V))
    (hbij : Function.Bijective (G.obj.map (wcOpenRestrIncl S O V).op))
    (q : ℕ) (hq : q < 2)
    (x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O V))) G q) :
    x = 0 :=
by
  classical

  have hext0 : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      ∃ e : ∀ W : S.ProEt, Abelian.Ext (wcFreeSheaf S W) F 0 ≃ F.obj.obj (Opposite.op W),
        ∀ (W W' : S.ProEt) (f : W' ⟶ W) (y : Abelian.Ext (wcFreeSheaf S W) F 0),
          e W' ((Abelian.Ext.mk₀ (wcFreeSheafMap S f)).comp y (zero_add 0)) =
            F.obj.map f.op (e W y) := by
    intro F
    let e2 : ∀ (W : S.ProEt) (G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}),
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op W) :=
      fun W G => ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := W) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    let ec : ∀ (W : S.ProEt), (wcFreeSheaf S W ⟶ F) ≃ F.obj.obj (Opposite.op W) := fun W =>
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 W F.obj)
    have hnatW : ∀ (W W' : S.ProEt) (f : W' ⟶ W) (g : wcFreeSheaf S W ⟶ F),
        ec W' (wcFreeSheafMap S f ≫ g) = F.obj.map f.op (ec W g) := by
      intro W W' f g
      have h1 := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_left
        (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) g
      have h2 := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_left
        (uliftYoneda.{u+1}.map f)
        ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g)
      have h3 := uliftYonedaEquiv_naturality.{u+1}
        (F := F.obj ⋙ forget AddCommGrpCat.{u+1})
        ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) F.obj
          ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
            (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g))
        f.op
      have k1 := congrArg (fun t => uliftYonedaEquiv.{u+1} (X := W') (F := F.obj ⋙ forget AddCommGrpCat.{u+1})
        ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj W' ⋙ uliftFunctor.{u+1, u}) F.obj t)) h1
      have k2 := congrArg (uliftYonedaEquiv.{u+1} (X := W') (F := F.obj ⋙ forget AddCommGrpCat.{u+1})) h2
      exact k1.trans (k2.trans h3.symm)
    refine ⟨fun W => Abelian.Ext.homEquiv₀.trans (ec W), fun W W' f y => ?_⟩
    obtain ⟨g, rfl⟩ : ∃ g, y = Abelian.Ext.mk₀ g := ⟨_, (Abelian.Ext.mk₀_homEquiv₀_apply y).symm⟩
    have hh : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (h : A ⟶ F),
        Abelian.Ext.homEquiv₀ (Abelian.Ext.mk₀ h) = h := by
      intro A h
      rw [← Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply]
    show ec W' (Abelian.Ext.homEquiv₀ _) = F.obj.map f.op (ec W (Abelian.Ext.homEquiv₀ _))
    rw [Abelian.Ext.mk₀_comp_mk₀, hh, hh, hnatW]

  have hmono : ∀ (V₁ U₁ : S.ProEt) (κ : V₁ ⟶ U₁), Mono κ.left → Mono (wcFreeSheafMap S κ) := by
    intro V₁ U₁ κ hκ
    haveI : Mono κ := ⟨fun g h e => MorphismProperty.Over.Hom.ext ((cancel_mono κ.left).mp
      (by
        have e' := congrArg (fun t => t.left) e
        first
          | exact e'
          | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e'))⟩
    unfold wcFreeSheafMap
    exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (Functor.whiskerRight (yoneda.map κ) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))

  have hj : Mono (wcOpenRestrIncl S O V).left := by
    show Mono (Limits.pullback.snd O.ι V.hom)
    infer_instance
  haveI hι : Mono (wcFreeSheafMap S (wcOpenRestrIncl S O V)) := hmono _ _ _ hj
  let S' : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    ShortComplex.mk (wcFreeSheafMap S (wcOpenRestrIncl S O V))
      (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O V)))
      (Limits.cokernel.condition _)
  have hS : S'.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hι inferInstance

  obtain ⟨e, he⟩ := hext0 G
  have hN : ∀ y : Abelian.Ext (wcFreeSheaf S V) G 0,
      e (wcOpenRestr S O V)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap S (wcOpenRestrIncl S O V))).comp y (zero_add 0)) =
        G.obj.map (wcOpenRestrIncl S O V).op (e V y) :=
    fun y => he V (wcOpenRestr S O V) (wcOpenRestrIncl S O V) y
  have hinj : ∀ y : Abelian.Ext (wcFreeSheaf S V) G 0,
      (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcOpenRestrIncl S O V))).comp y (zero_add 0) = 0 →
        y = 0 := by
    intro y hy
    have h1 := hN y
    have h2 := hN 0
    rw [hy] at h1
    rw [Abelian.Ext.comp_zero] at h2
    exact (e V).injective (hbij.1 (h1.symm.trans h2))
  have hsurj : ∀ x₁ : Abelian.Ext (wcFreeSheaf S (wcOpenRestr S O V)) G 0, ∃ y,
      (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcOpenRestrIncl S O V))).comp y (zero_add 0) = x₁ := by
    intro x₁
    obtain ⟨t, ht⟩ := hbij.2 (e _ x₁)
    refine ⟨(e V).symm t, (e _).injective ?_⟩
    rw [hN, Equiv.apply_symm_apply, ht]

  obtain rfl | rfl : q = 0 ∨ q = 1 := by omega
  ·
    obtain ⟨f, rfl⟩ : ∃ f, x = Abelian.Ext.mk₀ f := ⟨_, (Abelian.Ext.mk₀_homEquiv₀_apply x).symm⟩
    have h1 : (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcOpenRestrIncl S O V))).comp
        ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O V)))).comp
          (Abelian.Ext.mk₀ f) (zero_add 0)) (zero_add 0) = 0 := by
      rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition_assoc,
        Limits.zero_comp, Abelian.Ext.mk₀_zero]
    have h2 := hinj _ h1
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at h2
    have h3 : f = 0 :=
      (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O V)))).mp
        (h2.trans Limits.comp_zero.symm)
    rw [h3, Abelian.Ext.mk₀_zero]
  ·
    haveI := hproj
    have h0 : (Abelian.Ext.mk₀ S'.g).comp x (zero_add 1) = 0 :=
      Abelian.Ext.eq_zero_of_projective _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS G x h0 (n₀ := 0) rfl
    obtain ⟨y, rfl⟩ := hsurj x₁
    rw [← hx₁]
    have hc : hS.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcOpenRestrIncl S O V)))
        (add_zero 1) = 0 := hS.extClass_comp
    rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 0) (by omega), hc,
      Abelian.Ext.zero_comp]

theorem wc_root_twist_one_sections_nat (S : Scheme.{u}) (m : ℕ) (hm : 0 < m) :
    ∃ e : ∀ W : S.ProEt, (wcRootTwist S m 1).obj.obj (Opposite.op W) ≃+
        Additive (rootsOfUnity m Γ(W.left, ⊤)),
      ∀ {W W' : S.ProEt} (f : W' ⟶ W) (s : (wcRootTwist S m 1).obj.obj (Opposite.op W)),
        e W' ((wcRootTwist S m 1).obj.map f.op s) =
          Additive.ofMul (restrictRootsOfUnity f.left.appTop.hom m (Additive.toMul (e W s))) :=
by
  classical

  have hΓ : Presieve.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget CommRingCat.{u}) := by
    have hb : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ ⋙ forget CommRingCat.{u}) := by
      let A1 : Scheme.{u} := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ)))
      let e : yoneda.obj A1 ≅ Scheme.Γ ⋙ forget CommRingCat.{u} :=
        NatIso.ofComponents (fun T => Equiv.toIso
          ((AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := T.unop)).trans
            (Equiv.funUnique PUnit.{u+1} _))) (by
          intro T T' g
          ext h
          exact AffineSpace.toSpecMvPolyIntEquiv_comp PUnit.{u+1} g.unop h PUnit.unit)
      exact Presieve.isSheaf_iso Scheme.fpqcTopology e
        (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (yoneda.obj A1))
    have hb' : Presieve.IsSheaf Scheme.proetaleTopology.{u} (Scheme.Γ ⋙ forget CommRingCat.{u}) :=
      Presieve.isSheaf_of_le _ Scheme.proetaleTopology_le_fpqcTopology hb
    let G : Sheaf Scheme.proetaleTopology.{u} (Type u) :=
      ⟨Scheme.Γ ⋙ forget CommRingCat.{u}, (isSheaf_iff_isSheaf_of_type _ _).2 hb'⟩
    exact (isSheaf_iff_isSheaf_of_type _ _).1
      (Functor.op_comp_isSheaf (Scheme.ProEt.forget S ⋙ Over.forget S) (Scheme.ProEt.topology S)
        Scheme.proetaleTopology G)

  have hUnits : ∀ (R : (S.ProEt)ᵒᵖ ⥤ CommRingCat.{u}),
      Presieve.IsSheaf (Scheme.ProEt.topology S) (R ⋙ forget CommRingCat.{u}) →
      Presheaf.IsSheaf (Scheme.ProEt.topology S)
        (R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u}) := by
    intro R hR
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S)
      (R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u})
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro V Sv hS x hx
    have hP := hR Sv hS
    let Q := R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
        CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ⋙
          forget AddCommGrpCat.{u+1}
    let P := R ⋙ forget CommRingCat.{u}
    let val : ∀ (W : (S.ProEt)ᵒᵖ), Q.obj W → P.obj W :=
      fun W a => ((Additive.toMul (ULift.down a) : (R.obj W)ˣ) : R.obj W)
    let ival : ∀ (W : (S.ProEt)ᵒᵖ), Q.obj W → P.obj W :=
      fun W a => (((Additive.toMul (ULift.down a) : (R.obj W)ˣ)⁻¹ : (R.obj W)ˣ) : R.obj W)
    have hmap : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
        val W' (Q.map g a) = P.map g (val W a) := fun g a => rfl
    have hmapi : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
        ival W' (Q.map g a) = P.map g (ival W a) := fun g a => rfl
    have hext : ∀ {W : (S.ProEt)ᵒᵖ} (a b : Q.obj W), val W a = val W b → a = b := by
      intro W a b h
      apply ULift.ext
      apply Additive.toMul.injective
      exact Units.ext h
    let a : Presieve.FamilyOfElements P Sv.arrows := fun Y f hf => val _ (x f hf)
    let b : Presieve.FamilyOfElements P Sv.arrows := fun Y f hf => ival _ (x f hf)
    have ha : a.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      change P.map g₁.op (val _ (x f₁ h₁)) = P.map g₂.op (val _ (x f₂ h₂))
      rw [← hmap, ← hmap]
      exact congrArg (val _) (hx g₁ g₂ h₁ h₂ comm)
    have hb : b.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      change P.map g₁.op (ival _ (x f₁ h₁)) = P.map g₂.op (ival _ (x f₂ h₂))
      rw [← hmapi, ← hmapi]
      exact congrArg (ival _) (hx g₁ g₂ h₁ h₂ comm)
    let α := hP.amalgamate a ha
    let β := hP.amalgamate b hb
    have hα : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : Sv.arrows f), P.map f.op α = a f hf :=
      fun Y f hf => hP.valid_glue ha f hf
    have hβ : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : Sv.arrows f), P.map f.op β = b f hf :=
      fun Y f hf => hP.valid_glue hb f hf
    have hαβ : (α * β : R.obj (Opposite.op V)) = 1 := by
      apply hP.isSeparatedFor.ext
      intro Y f hf
      change (R.map f.op).hom (α * β) = (R.map f.op).hom 1
      rw [map_mul, map_one]
      change P.map f.op α * P.map f.op β = 1
      rw [hα f hf, hβ f hf]
      exact Units.mul_inv _
    have hβα : (β * α : R.obj (Opposite.op V)) = 1 := by
      apply hP.isSeparatedFor.ext
      intro Y f hf
      change (R.map f.op).hom (β * α) = (R.map f.op).hom 1
      rw [map_mul, map_one]
      change P.map f.op β * P.map f.op α = 1
      rw [hα f hf, hβ f hf]
      exact Units.inv_mul _
    let υ : (R.obj (Opposite.op V))ˣ := ⟨α, β, hαβ, hβα⟩
    let t : Q.obj (Opposite.op V) := ULift.up (Additive.ofMul υ)
    refine ⟨t, ?_, ?_⟩
    · intro Y f hf
      apply hext
      exact (hmap f.op t).trans (hα f hf)
    · intro y hy
      apply hext
      refine hP.isSeparatedFor a (val _ y) α (fun Y f hf => ?_) hα
      rw [← hmap]
      exact congrArg (val _) (hy f hf)
  have hG := hUnits ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ) hΓ

  have hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) := by
    let R := (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ
    let Q := ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
          forget₂ CommRingCat CommMonCat ⋙
          CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ⋙
        forget AddCommGrpCat.{u+1}
    let P := ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u}) ⋙ forget AddCommGrpCat.{u+1}
    have hQ : Presieve.IsSheaf (Scheme.ProEt.topology S) Q :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _
          (forget AddCommGrpCat.{u+1})).1 hG)
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro V Sv hSv x hx
    have hP := hQ Sv hSv
    let incl : ∀ W : (S.ProEt)ᵒᵖ, P.obj W → Q.obj W := fun W a =>
      ULift.up (Additive.ofMul
        ((Additive.toMul (ULift.down a) : rootsOfUnity m (R.obj W)) : (R.obj W)ˣ))
    have hmapP : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : P.obj W),
        incl W' (P.map g a) = Q.map g (incl W a) := fun _ _ => rfl
    have hinj : ∀ {W : (S.ProEt)ᵒᵖ} (a b : P.obj W), incl W a = incl W b → a = b := by
      intro W a b h
      apply ULift.ext
      apply Additive.toMul.injective
      apply Subtype.ext
      exact congrArg (fun z : Q.obj W => (Additive.toMul (ULift.down z) : (R.obj W)ˣ)) h
    let pw : ∀ W : (S.ProEt)ᵒᵖ, Q.obj W → Q.obj W := fun W a =>
      ULift.up (Additive.ofMul ((Additive.toMul (ULift.down a) : (R.obj W)ˣ) ^ m))
    let one : ∀ W : (S.ProEt)ᵒᵖ, Q.obj W := fun W => ULift.up (Additive.ofMul (1 : (R.obj W)ˣ))
    have hpw : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
        Q.map g (pw W a) = pw W' (Q.map g a) := by
      intro W W' g a
      apply ULift.ext
      apply Additive.toMul.injective
      apply Units.ext
      change (R.map g).hom (((Additive.toMul (ULift.down a) : (R.obj W)ˣ) ^ m : (R.obj W)ˣ) :
          R.obj W) =
        (((Additive.toMul (ULift.down (Q.map g a)) : (R.obj W')ˣ) ^ m : (R.obj W')ˣ) : R.obj W')
      rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, map_pow]
      rfl
    have hone : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W'), Q.map g (one W) = one W' := by
      intro W W' g
      apply ULift.ext
      apply Additive.toMul.injective
      apply Units.ext
      change (R.map g).hom (1 : R.obj W) = (1 : R.obj W')
      exact map_one _
    have hincl_pw : ∀ (W : (S.ProEt)ᵒᵖ) (a : P.obj W), pw W (incl W a) = one W := by
      intro W a
      apply ULift.ext
      apply Additive.toMul.injective
      change ((Additive.toMul (ULift.down a) : rootsOfUnity m (R.obj W)) : (R.obj W)ˣ) ^ m = 1
      exact (mem_rootsOfUnity m _).1 (Additive.toMul (ULift.down a) : rootsOfUnity m (R.obj W)).2
    let y : Presieve.FamilyOfElements Q Sv.arrows := fun Y f hf => incl _ (x f hf)
    have hy : y.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      change Q.map g₁.op (incl _ (x f₁ h₁)) = Q.map g₂.op (incl _ (x f₂ h₂))
      rw [← hmapP, ← hmapP]
      exact congrArg (incl _) (hx g₁ g₂ h₁ h₂ comm)
    let t := hP.amalgamate y hy
    have ht : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : Sv.arrows f), Q.map f.op t = y f hf :=
      fun Y f hf => hP.valid_glue hy f hf
    have htm : pw _ t = one _ := by
      apply hP.isSeparatedFor.ext
      intro Y f hf
      exact (hpw f.op t).trans ((congrArg (pw _) (ht f hf)).trans
        ((hincl_pw _ (x f hf)).trans (hone f.op).symm))
    have hvm : (Additive.toMul (ULift.down t) : (R.obj (Opposite.op V))ˣ) ^ m = 1 :=
      congrArg (fun z : Q.obj (Opposite.op V) =>
        (Additive.toMul (ULift.down z) : (R.obj (Opposite.op V))ˣ)) htm
    let s : P.obj (Opposite.op V) := ULift.up (Additive.ofMul
      (⟨(Additive.toMul (ULift.down t) : (R.obj (Opposite.op V))ˣ), (mem_rootsOfUnity m _).2 hvm⟩ :
        rootsOfUnity m (R.obj (Opposite.op V))))
    have hs : incl _ s = t := rfl
    refine ⟨s, ?_, ?_⟩
    · intro Y f hf
      apply hinj
      exact (hmapP f.op s).trans ((congrArg (Q.map f.op) hs).trans (ht f hf))
    · intro s' hs'
      apply hinj
      exact (hP.isSeparatedFor y (incl _ s') t
        (fun Y f hf => (hmapP f.op s').symm.trans (congrArg (incl _) (hs' f hf)))
        (fun Y f hf => ht f hf)).trans hs.symm


  have hbij : ∀ (M : Type u) [AddCommGroup M], (∀ x : M, m • x = 0) →
      Function.Bijective
        (fun ζ : M => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ)) := by
    intro M _ hM
    have : NeZero m := ⟨by omega⟩
    set e : PiTensorProduct ℤ (fun _ : Fin 1 => M) ≃ₗ[ℤ] M :=
      PiTensorProduct.subsingletonEquiv (0 : Fin 1) with he_def
    have he : ∀ ζ : M, e (PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ)) = ζ := fun ζ =>
      PiTensorProduct.subsingletonEquiv_apply_tprod _ _
    have hes : ∀ ζ : M, e.symm ζ = PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ) := fun ζ => by
      rw [LinearEquiv.symm_apply_eq, he]
    set g0 : ℤ →+ (PiTensorProduct ℤ (fun _ : Fin 1 => M) →ₗ[ℤ] M) :=
      zmultiplesHom (PiTensorProduct ℤ (fun _ : Fin 1 => M) →ₗ[ℤ] M) e.toLinearMap with hg0_def
    have hg0v : ∀ (k : ℤ) p, g0 k p = k • e p := by
      intro k p
      simp [g0, zmultiplesHom_apply]
    have hg0 : g0 (m : ℤ) = 0 := by
      refine LinearMap.ext fun p => ?_
      rw [hg0v, LinearMap.zero_apply, natCast_zsmul, hM]
    set B : ZMod m →+ (PiTensorProduct ℤ (fun _ : Fin 1 => M) →ₗ[ℤ] M) :=
      ZMod.lift m ⟨g0, hg0⟩ with hB_def
    have hBv : ∀ (k : ℤ) p, B (k : ZMod m) p = k • e p := by
      intro k p
      rw [hB_def, ZMod.lift_coe]
      exact hg0v k p
    set β := TensorProduct.lift B.toIntLinearMap with hβ_def
    have hβ : ∀ (k : ℤ) p, β ((k : ZMod m) ⊗ₜ[ℤ] p) = k • e p := by
      intro k p
      rw [hβ_def, TensorProduct.lift.tmul]
      exact hBv k p
    set f := (fun ζ : M => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ))
      with hf_def
    have hf : ∀ ζ, f ζ = (1 : ZMod m) ⊗ₜ[ℤ] e.symm ζ := fun ζ => by rw [hes]
    have hleft : Function.LeftInverse β f := by
      intro ζ
      rw [hf, ← Int.cast_one, hβ, one_smul, LinearEquiv.apply_symm_apply]
    have hright : Function.RightInverse β f := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, hf, map_zero, TensorProduct.tmul_zero]
      | tmul a p =>
        obtain ⟨k, rfl⟩ := ZMod.intCast_surjective a
        rw [hβ, hf, map_zsmul, LinearEquiv.symm_apply_apply, TensorProduct.tmul_smul,
          TensorProduct.smul_tmul', zsmul_eq_mul, mul_one]
      | add x y hx hy =>
        rw [map_add, hf, map_add, TensorProduct.tmul_add, ← hf, ← hf, hx, hy]
    exact ⟨hleft.injective, hright.surjective⟩
  have hιex : Nonempty ((⟨_, hμ⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ≅
      wcRootTwist S m 1) := by
    let θ : ∀ (M : Type u) [AddCommGroup M],
        M →+ TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin 1 => M)) :=
      fun M _ => ((TensorProduct.mk ℤ (ZMod m) (PiTensorProduct ℤ fun _ : Fin 1 => M) 1).comp
        (PiTensorProduct.subsingletonEquiv (R := ℤ) (s := fun _ : Fin 1 => M)
          0).symm.toLinearMap).toAddMonoidHom
    have hθ : ∀ (M : Type u) [AddCommGroup M] (a : M),
        θ M a = (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => a) := by
      intro M _ a
      have h1 : (PiTensorProduct.subsingletonEquiv (R := ℤ) (s := fun _ : Fin 1 => M) 0).symm a =
          PiTensorProduct.tprod ℤ (fun _ : Fin 1 => a) := by
        rw [LinearEquiv.symm_apply_eq, PiTensorProduct.subsingletonEquiv_apply_tprod]
      show (1 : ZMod m) ⊗ₜ[ℤ] (PiTensorProduct.subsingletonEquiv (R := ℤ)
        (s := fun _ : Fin 1 => M) 0).symm a = _
      rw [h1]
    have htor : ∀ (R : CommRingCat.{u}) (x : Additive (rootsOfUnity m R)), m • x = 0 := by
      intro R x
      apply Additive.toMul.injective
      rw [toMul_nsmul, toMul_zero]
      apply Subtype.ext
      simpa using (mem_rootsOfUnity m _).mp (Additive.toMul x).prop
    let η : wcRootsFun m ⟶ wcRootsFun m ⋙ wcTwistFun m 1 :=
      { app := fun R => AddCommGrpCat.ofHom (θ ((wcRootsFun m).obj R))
        naturality := by
          intro R R' φ
          ext x
          change θ ((wcRootsFun m).obj R') (((wcRootsFun m).map φ).hom x) =
            (LinearMap.lTensor (ZMod m) (PiTensorProduct.map fun _ : Fin 1 =>
              ((wcRootsFun m).map φ).hom.toIntLinearMap)) (θ ((wcRootsFun m).obj R) x)
          rw [hθ, hθ, LinearMap.lTensor_tmul, PiTensorProduct.map_tprod]
          rfl }
    let ν : (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u} ⟶ wcRootTwistPre S m 1 :=
      Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
        (Functor.whiskerRight η AddCommGrpCat.uliftFunctor.{u+1, u})
    have hbijν : ∀ W, Function.Bijective (ν.app W).hom := by
      intro W
      have hb := hbij ((wcRootsFun m).obj (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙
        Scheme.Γ).obj W)) (fun x => htor _ x)
      have hfun : (⇑(θ ((wcRootsFun m).obj (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙
          Scheme.Γ).obj W)))) =
          fun ζ => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ) :=
        funext (hθ _)
      rw [← hfun] at hb
      exact Equiv.ulift.symm.bijective.comp (hb.comp Equiv.ulift.bijective)
    haveI : ∀ W, IsIso (ν.app W) := fun W =>
      (ConcreteCategory.isIso_iff_bijective _).mpr (hbijν W)
    haveI : IsIso ν := NatIso.isIso_of_isIso_app ν
    exact ⟨sheafificationIso ⟨_, hμ⟩ ≪≫
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).mapIso (asIso ν)⟩
  obtain ⟨ι⟩ := hιex

  let ιp := (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).mapIso ι
  refine ⟨fun W => ((ιp.app (Opposite.op W)).symm.addCommGroupIsoToAddEquiv).trans
    AddEquiv.ulift, ?_⟩
  intro W W' f s
  have h := congrArg (fun g => g s) (congrArg ConcreteCategory.hom (ιp.inv.naturality f.op))
  simp only [ConcreteCategory.comp_apply] at h
  refine (congrArg (fun x : ULift.{u+1, u} (Additive (rootsOfUnity m Γ(W'.left, ⊤))) =>
    x.down) h).trans ?_
  rfl

theorem wc_smooth_divisor_proet_mu_shriek_low_vanish (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (n : ℕ)
    (R : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) [R.Additive]
    (adj : wcProEtPush i ⊣ R)
    (I : InjectiveResolution (wcRootTwist Y (ℓ ^ n) 1)) (q : ℕ) (hq : q < 2) :
    Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical
  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI hln : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  have hm0 : 0 < ℓ ^ n := pow_pos (Fact.out : ℓ.Prime).pos n
  have hmk : ((ℓ ^ n : ℕ) : k) ≠ 0 := by
    rw [Nat.cast_pow]; exact pow_ne_zero n hℓ
  let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hO : (O : Set Y) = (Set.range i)ᶜ := rfl
  obtain ⟨e, he⟩ := wc_root_twist_one_sections_nat Y (ℓ ^ n) hm0

  have chart : ∀ V : Y.ProEt,
      (IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
        (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
        (∀ x : V.left, IsClosed ({x} : Set V.left) →
          HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))) →
      ∀ x : Abelian.Ext ((wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V)))
        (wcRootTwist Y (ℓ ^ n) 1) q, x = 0 := by
    intro V hV x
    have hinj := wc_smooth_divisor_proet_gamma_restrict_injective k pY d i O hO V hV.1
    have hbij : Function.Bijective
        ((wcRootTwist Y (ℓ ^ n) 1).obj.map (wcOpenRestrIncl Y O V).op) := by
      constructor
      · intro s t hst
        have h1 := congrArg (e (wcOpenRestr Y O V)) hst
        rw [he, he] at h1
        have h2 := Additive.ofMul.injective h1
        apply (e V).injective
        apply Additive.toMul.injective
        apply Subtype.ext
        apply Units.ext
        apply hinj
        have h3 := Units.ext_iff.mp (Subtype.ext_iff.mp h2)
        simp only [restrictRootsOfUnity_coe_apply] at h3
        exact h3
      · intro y
        obtain ⟨ξ, hξ⟩ := wc_smooth_divisor_wcontr_roots_extend k pY d i (ℓ ^ n) hmk O hO V hV
          (Additive.toMul (e (wcOpenRestr Y O V) y))
        refine ⟨(e V).symm (Additive.ofMul ξ), ?_⟩
        apply (e (wcOpenRestr Y O V)).injective
        rw [he, AddEquiv.apply_symm_apply]
        exact congrArg Additive.ofMul hξ
    obtain ⟨κ⟩ := wc_proet_closed_push_free_bc_coker_iso i O hO V
    have hproj := wc_proet_free_projective_wcontractible Y V hV
    have hy := wc_proet_coker_open_restr_ext_low_vanish Y O V (wcRootTwist Y (ℓ ^ n) 1) hproj
      hbij q hq ((Abelian.Ext.mk₀ κ.inv).comp x (zero_add q))
    have hx : x = (Abelian.Ext.mk₀ κ.hom).comp
        ((Abelian.Ext.mk₀ κ.inv).comp x (zero_add q)) (zero_add q) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [hx, hy, Abelian.Ext.comp_zero]

  refine wc_proet_rightAdj_homology_zero_of_free_ext_local (wcProEtPush i) R adj
    (wcRootTwist Y (ℓ ^ n) 1) I q ?_
  intro W
  refine (Scheme.ProEt.topology Z).superset_covering ?_ (wc_proet_closed_bc_wcontr_cover i W)
  rw [Sieve.generate_le_iff]
  intro W' g hg
  obtain ⟨V, rfl, hV⟩ := hg
  exact Sieve.le_generate _ _ g (chart V hV)

theorem wc_sheaf_ab_rightAdj_homology_iso_of_good_basis {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (Q : Sheaf J AddCommGrpCat.{u+1})
    {𝒟 : Type*} [Category 𝒟] [Abelian 𝒟] [HasExt 𝒟]
    (L : Sheaf J AddCommGrpCat.{u+1} ⥤ 𝒟) [L.Additive]
    (R : 𝒟 ⥤ Sheaf J AddCommGrpCat.{u+1}) [R.Additive] (adj : L ⊣ R)
    (A : 𝒟) (I : InjectiveResolution A) (t : ℕ)
    (τ : Abelian.Ext (L.obj Q) A t)
    (hgood : ∀ W : C, Sieve.generate (fun (W' : C) (_ : W' ⟶ W) =>
        ∀ (P : Sheaf J AddCommGrpCat.{u+1})
          (ev : ∀ M : Sheaf J AddCommGrpCat.{u+1}, (P ⟶ M) ≃ M.obj.obj (Opposite.op W')),
          (∀ (M N : Sheaf J AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P ⟶ M),
            ev N (g ≫ ψ) = ψ.hom.app (Opposite.op W') (ev M g)) →
          (∀ (M : Sheaf J AddCommGrpCat.{u+1}) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
          Function.Bijective
            (fun a : Q.obj.obj (Opposite.op W') =>
              (Abelian.Ext.mk₀ (L.map ((ev Q).symm a))).comp τ (zero_add t))) ∈ J W) :
    ∃ ψ : Q ⟶ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology t,
      IsIso ψ :=
by
  classical

  have hcomp : ∀ {M N L : Sheaf J AddCommGrpCat.{u+1}} (p : M ⟶ N) (p' : N ⟶ L) (V : Cᵒᵖ)
      (x : M.obj.obj V), (p ≫ p').hom.app V x = p'.hom.app V (p.hom.app V x) :=
    fun _ _ _ _ => rfl
  have hnat : ∀ {M N : Sheaf J AddCommGrpCat.{u+1}} (p : M ⟶ N) {W W' : C} (g : W' ⟶ W)
      (x : M.obj.obj (Opposite.op W)),
      p.hom.app (Opposite.op W') (M.obj.map g.op x) =
        N.obj.map g.op (p.hom.app (Opposite.op W) x) :=
    fun p _ _ g x => NatTrans.naturality_apply p.hom g.op x
  have hMmap : ∀ {M : Sheaf J AddCommGrpCat.{u+1}} {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y)
      (x : M.obj.obj (Opposite.op W)),
      M.obj.map (g' ≫ h₀).op x = M.obj.map g'.op (M.obj.map h₀.op x) := by
    intro M W Y Z h₀ g' x
    rw [op_comp, Functor.map_comp]
    rfl

  have hmono : ∀ {M N : Sheaf J AddCommGrpCat.{u+1}} (p : M ⟶ N) [Mono p] (W : C),
      Function.Injective (p.hom.app (Opposite.op W)) := by
    intro M N p _ W
    have h1 : Mono ((sheafToPresheaf J AddCommGrpCat.{u+1} ⋙
        (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)).map p) := Functor.map_mono _ p
    exact (AddCommGrpCat.mono_iff_injective _).1 h1

  have hepi : ∀ {M N : Sheaf J AddCommGrpCat.{u+1}} (p : M ⟶ N) [Epi p] (W : C)
      (s : N.obj.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ t : M.obj.obj (Opposite.op W'),
        p.hom.app (Opposite.op W') t = N.obj.map g.op s) ∈ J W := by
    intro M N p _ W s
    have h2 := (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} p).2 inferInstance
    have : Presheaf.IsLocallySurjective J p.hom := h2
    have h3 := Presheaf.imageSieve_mem J p.hom (U := Opposite.op W) s
    refine J.superset_covering ?_ h3
    intro W' g hg
    obtain ⟨t, ht⟩ := hg
    exact ⟨_, 𝟙 _, g, ⟨t, ht⟩, Category.id_comp _⟩

  have hker : ∀ (T : ShortComplex (Sheaf J AddCommGrpCat.{u+1})), T.Exact → Mono T.f → ∀ (W : C)
      (x₂ : T.X₂.obj.obj (Opposite.op W)), T.g.hom.app (Opposite.op W) x₂ = 0 →
      ∃ x₁ : T.X₁.obj.obj (Opposite.op W), T.f.hom.app (Opposite.op W) x₁ = x₂ := by
    intro T hT hf W x₂ hx
    have hE := hT.map_of_mono_of_preservesKernel (sheafToPresheaf J AddCommGrpCat.{u+1} ⋙
      (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)) hf inferInstance
    exact (ShortComplex.ab_exact_iff _).1 hE x₂ hx

  have hexact : ∀ (T : ShortComplex (Sheaf J AddCommGrpCat.{u+1})), T.Exact → ∀ (W : C)
      (x₂ : T.X₂.obj.obj (Opposite.op W)), T.g.hom.app (Opposite.op W) x₂ = 0 →
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ x₁ : T.X₁.obj.obj (Opposite.op W'),
        T.f.hom.app (Opposite.op W') x₁ = T.X₂.obj.map g.op x₂) ∈ J W := by
    intro T hT W x₂ hx
    obtain ⟨z, hz⟩ := hker (ShortComplex.mk T.iCycles T.g T.iCycles_g)
      (ShortComplex.exact_of_f_is_kernel _ T.cyclesIsKernel) inferInstance W x₂ hx
    have := hT.epi_toCycles
    refine J.superset_covering ?_ (hepi T.toCycles W z)
    rw [Sieve.generate_le_iff]
    rintro W' g ⟨t, ht⟩
    apply Sieve.le_generate
    refine ⟨t, ?_⟩
    rw [← T.toCycles_i, hcomp, ht, hnat]
    exact congrArg _ hz

  have htrans : ∀ (W : C) (P₁ P₂ : Presieve W), Sieve.generate P₁ ∈ J W →
      (∀ (Y : C) (g₀ : Y ⟶ W), P₁ g₀ →
        Sieve.generate (fun (Y' : C) (g' : Y' ⟶ Y) => P₂ (g' ≫ g₀)) ∈ J Y) →
      Sieve.generate P₂ ∈ J W := by
    intro W P₁ P₂ h1 h2
    refine J.transitive h1 _ ?_
    intro Y' f hf
    obtain ⟨Y, k, g₀, hg₀, rfl⟩ := hf
    have h3 : Sieve.generate (fun (Y'' : C) (g' : Y'' ⟶ Y) => P₂ (g' ≫ g₀)) ≤
        (Sieve.generate P₂).pullback g₀ := by
      rw [Sieve.generate_le_iff]
      intro Y'' g' hg'
      exact ⟨_, 𝟙 _, g' ≫ g₀, hg', Category.id_comp _⟩
    have h4 := J.superset_covering h3 (h2 Y g₀ hg₀)
    rw [Sieve.pullback_comp]
    exact J.pullback_stable k h4

  have hsep : ∀ (W : C) (x : Q.obj.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => Q.obj.map g.op x = 0) ∈ J W → x = 0 := by
    intro W x hx
    apply (Sheaf.isSeparated Q) W _ hx x 0
    intro Y f hf
    obtain ⟨Z, k, k₀, hk₀, rfl⟩ := hf
    show Q.obj.map (k ≫ k₀).op x = Q.obj.map (k ≫ k₀).op 0
    rw [map_zero, hMmap, hk₀, map_zero]

  have hmain : ∀ (q : ℕ) (P : CochainComplex (Sheaf J AddCommGrpCat.{u+1}) ℕ)
      (g : Q ⟶ P.X q) (hg : g ≫ P.d q (q + 1) = 0),
      (∀ (W : C) (c : Q.obj.obj (Opposite.op W))
        (y : (P.X ((ComplexShape.up ℕ).prev q)).obj.obj (Opposite.op W)),
        g.hom.app (Opposite.op W) c =
          (P.d ((ComplexShape.up ℕ).prev q) q).hom.app (Opposite.op W) y →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => Q.obj.map h.op c = 0) ∈ J W) →
      (∀ (W : C) (s : (P.X q).obj.obj (Opposite.op W)),
        (P.d q (q + 1)).hom.app (Opposite.op W) s = 0 →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ (c : Q.obj.obj (Opposite.op W'))
            (y : (P.X ((ComplexShape.up ℕ).prev q)).obj.obj (Opposite.op W')),
            (P.X q).obj.map h.op s =
              g.hom.app (Opposite.op W') c +
              (P.d ((ComplexShape.up ℕ).prev q) q).hom.app (Opposite.op W') y) ∈ J W) →
      IsIso (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
    intro q P g hg H2 H3
    have hLi : ∀ (V : Cᵒᵖ) (x : Q.obj.obj V),
        (P.iCycles q).hom.app V ((P.liftCycles g (q + 1) (by simp) hg).hom.app V x) =
        g.hom.app V x := by
      intro V x
      rw [← hcomp, P.liftCycles_i]
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).obj.obj V),
        (P.iCycles q).hom.app V ((P.toCycles ((ComplexShape.up ℕ).prev q) q).hom.app V y) =
        (P.d ((ComplexShape.up ℕ).prev q) q).hom.app V y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    have hTπ : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).obj.obj V),
        (P.homologyπ q).hom.app V
          ((P.toCycles ((ComplexShape.up ℕ).prev q) q).hom.app V y) = 0 := by
      intro V y
      rw [← hcomp, P.toCycles_comp_homologyπ]
      rfl

    have hinj : ∀ (W : C) (c : Q.obj.obj (Opposite.op W)),
        (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).hom.app (Opposite.op W) c = 0 →
        c = 0 := by
      intro W c hc
      obtain ⟨z, hz⟩ : ∃ z : (P.cycles q).obj.obj (Opposite.op W), z =
          (P.liftCycles g (q + 1) (by simp) hg).hom.app (Opposite.op W) c :=
        ⟨_, rfl⟩
      have hπz : (P.homologyπ q).hom.app (Opposite.op W) z = 0 := by
        rw [hz, ← hc]
        rfl
      have hTex := ShortComplex.exact_of_g_is_cokernel
        (ShortComplex.mk (P.toCycles ((ComplexShape.up ℕ).prev q) q) (P.homologyπ q)
          (P.toCycles_comp_homologyπ _ q)) (P.homologyIsCokernel _ q rfl)
      apply hsep W c
      apply htrans W _ _ (hexact _ hTex W z hπz)
      rintro Y h₀ ⟨y, hy⟩
      have hd : g.hom.app (Opposite.op Y) (Q.obj.map h₀.op c) =
          (P.d ((ComplexShape.up ℕ).prev q) q).hom.app (Opposite.op Y) y := by
        rw [← hTi]
        erw [hy]
        rw [hnat, hz]
        exact (congrArg _ (hLi _ c).symm).trans (hnat (P.iCycles q) h₀ _).symm
      refine J.superset_covering ?_ (H2 Y _ y hd)
      rw [Sieve.generate_le_iff]
      intro Z g' hg'
      apply Sieve.le_generate
      show Q.obj.map (g' ≫ h₀).op c = 0
      rw [hMmap]
      exact hg'

    have hloc : ∀ (W : C) (x : (P.homology q).obj.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ c : Q.obj.obj (Opposite.op W'),
          (P.homology q).obj.map h.op x =
            (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).hom.app
              (Opposite.op W') c) ∈ J W := by
      intro W x
      apply htrans W _ _ (hepi (P.homologyπ q) W x)
      rintro Y h₀ ⟨z, hz⟩
      have hs : (P.d q (q + 1)).hom.app (Opposite.op Y)
          ((P.iCycles q).hom.app (Opposite.op Y) z) = 0 := by
        rw [← hcomp, P.iCycles_d]
        rfl
      refine J.superset_covering ?_ (H3 Y _ hs)
      rw [Sieve.generate_le_iff]
      rintro Z h' ⟨c, y, hcy⟩
      apply Sieve.le_generate
      refine ⟨c, ?_⟩
      have hw : (P.cycles q).obj.map h'.op z =
          (P.liftCycles g (q + 1) (by simp) hg).hom.app (Opposite.op Z) c +
            (P.toCycles ((ComplexShape.up ℕ).prev q) q).hom.app (Opposite.op Z) y := by
        apply hmono (P.iCycles q) Z
        rw [map_add, hnat, hcy, hTi]
        congr 1
        exact (hLi _ c).symm
      rw [hMmap, ← hz, ← hnat, hw, map_add, hTπ, add_zero]
      rfl

    have hM : Mono (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
      constructor
      intro X a b hab
      apply Sheaf.hom_ext
      ext V x
      have h1 : (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).hom.app V
            (a.hom.app V x) =
          (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).hom.app V
            (b.hom.app V x) := by
        rw [← hcomp, ← hcomp, hab]
      have hd0 : (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).hom.app V
          (a.hom.app V x - b.hom.app V x) = 0 := by
        rw [map_sub, h1, sub_self]
      have h2 := hinj V.unop _ hd0
      exact sub_eq_zero.mp h2

    have hE : Epi (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
      apply (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).1
      have : Presheaf.IsLocallySurjective J
          (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).hom := by
        refine ⟨fun {U} s => ?_⟩
        refine J.superset_covering ?_ (hloc U s)
        rw [Sieve.generate_le_iff]
        rintro W' k ⟨c, hc⟩
        exact ⟨c, hc.symm⟩
      exact this
    exact isIso_of_mono_of_epi _

  have hfree : ∀ U : C, ∃ (P : Sheaf J AddCommGrpCat.{u+1})
      (ev : ∀ M : Sheaf J AddCommGrpCat.{u+1}, (P ⟶ M) ≃ M.obj.obj (Opposite.op U)),
      (∀ (M N : Sheaf J AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = ψ.hom.app (Opposite.op U) (ev M g)) ∧
      (∀ (M : Sheaf J AddCommGrpCat.{u+1}) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') := by
    intro U
    let Y : Cᵒᵖ ⥤ Type (u+1) := uliftYoneda.{u+1}.obj U
    let F₀ : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} := Y ⋙ AddCommGrpCat.free
    let adjS := sheafificationAdjunction J AddCommGrpCat.{u+1}
    let adjF := Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj.{u+1}
    let P := (presheafToSheaf J AddCommGrpCat.{u+1}).obj F₀
    let ev : ∀ M : Sheaf J AddCommGrpCat.{u+1}, (P ⟶ M) ≃ M.obj.obj (Opposite.op U) := fun M =>
      (adjS.homEquiv F₀ M).trans ((adjF.homEquiv Y M.obj).trans uliftYonedaEquiv)
    have hnatF : ∀ (M N : Sheaf J AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = ψ.hom.app (Opposite.op U) (ev M g) := by
      intro M N ψ g
      change uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ N (g ≫ ψ))) =
        ψ.hom.app (Opposite.op U) (uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ M g)))
      rw [adjS.homEquiv_naturality_right, adjF.homEquiv_naturality_right, uliftYonedaEquiv_comp]
      rfl
    refine ⟨P, ev, hnatF, ?_⟩
    intro M g g'
    have h0 : ∀ h : P ⟶ M, ev M h = h.hom.app (Opposite.op U) (ev P (𝟙 P)) := by
      intro h
      rw [← hnatF, Category.id_comp]
    rw [h0, h0 g, h0 g', Sheaf.Hom.add_app]
    rfl

  have hzero : ∀ {X : 𝒟} (f : X ⟶ I.cocomplex.X t) (hf : f ≫ I.cocomplex.d t (t + 1) = 0)
      (k : X ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev t)),
      f = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev t) t → I.extMk f (t + 1) rfl hf = 0 := by
    intro X f hf k hk
    by_cases hr : (ComplexShape.up ℕ).Rel ((ComplexShape.up ℕ).prev t) t
    · exact (I.extMk_eq_zero_iff f (t + 1) rfl hf _ hr).2 ⟨k, hk.symm⟩
    · have h0 : I.cocomplex.d ((ComplexShape.up ℕ).prev t) t = 0 := I.cocomplex.shape _ _ hr
      rw [h0, Limits.comp_zero] at hk
      subst hk
      exact I.extMk_zero (t + 1) rfl
  have hcob : ∀ {X : 𝒟} (f : X ⟶ I.cocomplex.X t) (hf : f ≫ I.cocomplex.d t (t + 1) = 0),
      I.extMk f (t + 1) rfl hf = 0 → ∃ k : X ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev t),
        f = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
    intro X f hf h0
    by_cases hr : (ComplexShape.up ℕ).Rel ((ComplexShape.up ℕ).prev t) t
    · obtain ⟨k, hk⟩ := (I.extMk_eq_zero_iff f (t + 1) rfl hf _ hr).1 h0
      exact ⟨k, hk.symm⟩
    · have ht : t = 0 := by
        rcases Nat.eq_zero_or_pos t with ht | ht
        · exact ht
        · exfalso
          have hr' : (ComplexShape.up ℕ).Rel (t - 1) t := by
            simp only [ComplexShape.up_Rel]; omega
          rw [ComplexShape.prev_eq' _ hr'] at hr
          exact hr hr'
      refine ⟨0, ?_⟩
      rw [Limits.zero_comp]
      subst ht
      have h1 := congrArg I.extEquivCohomologyClass h0
      rw [InjectiveResolution.extEquivCohomologyClass_extMk,
        InjectiveResolution.extEquivCohomologyClass_zero,
        CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
        CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
          (by norm_num)] at h1
      obtain ⟨g', hg'⟩ := h1
      have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
        CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1)
      rw [hz.eq_of_tgt g' 0, Limits.zero_comp] at hg'
      rw [← cancel_mono (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv, Limits.zero_comp]
      exact hg'.symm

  obtain ⟨c, hc, hτ⟩ := I.extMk_surjective τ (t + 1) rfl
  have hg : adj.homEquiv _ _ c ≫
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d t (t + 1) = 0 := by
    show adj.homEquiv _ _ c ≫ R.map (I.cocomplex.d t (t + 1)) = 0
    rw [← Adjunction.homEquiv_naturality_right, hc, Adjunction.homEquiv_unit, Functor.map_zero,
      Limits.comp_zero]

  have s2 : ∀ (W : C) (P : Sheaf J AddCommGrpCat.{u+1})
      (ev : ∀ M : Sheaf J AddCommGrpCat.{u+1}, (P ⟶ M) ≃ M.obj.obj (Opposite.op W)),
      (∀ (M N : Sheaf J AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = ψ.hom.app (Opposite.op W) (ev M g)) →
      (∀ (M : Sheaf J AddCommGrpCat.{u+1}) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
      Function.Injective (fun a : Q.obj.obj (Opposite.op W) =>
        (Abelian.Ext.mk₀ (L.map ((ev Q).symm a))).comp τ (zero_add t)) →
      ∀ (a : Q.obj.obj (Opposite.op W))
        (y : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev t))).obj.obj (Opposite.op W)),
        (adj.homEquiv _ _ c).hom.app (Opposite.op W) a =
          (R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t)).hom.app (Opposite.op W) y →
        a = 0 := by
    intro W P ev hn' ha' hinj a y hay
    have e1 : (ev _).symm a ≫ adj.homEquiv _ _ c =
        (ev _).symm y ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t) := by
      apply (ev _).injective
      rw [hn', hn', Equiv.apply_symm_apply, Equiv.apply_symm_apply, hay]
    have e2 : L.map ((ev _).symm a) ≫ c = (adj.homEquiv _ _).symm ((ev _).symm y) ≫
        I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
      have h1 := congrArg (adj.homEquiv _ _).symm e1
      rw [Adjunction.homEquiv_naturality_left_symm, Equiv.symm_apply_apply,
        Adjunction.homEquiv_naturality_right_symm] at h1
      exact h1
    have hev0 : (ev Q).symm 0 = 0 := by
      apply (ev _).injective
      rw [Equiv.apply_symm_apply]
      have h := ha' Q 0 0
      rw [add_zero] at h
      exact (by simpa using h : ev Q 0 = 0).symm
    have e3 : L.map ((ev Q).symm 0) ≫ c =
        (0 : L.obj P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev t)) ≫
          I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
      rw [hev0, Functor.map_zero, Limits.zero_comp, Limits.zero_comp]
    apply hinj
    show (Abelian.Ext.mk₀ (L.map ((ev _).symm a))).comp τ (zero_add t) =
      (Abelian.Ext.mk₀ (L.map ((ev _).symm 0))).comp τ (zero_add t)
    rw [← hτ, InjectiveResolution.mk₀_comp_extMk, InjectiveResolution.mk₀_comp_extMk]
    exact (hzero _ _ _ e2).trans (hzero _ _ _ e3).symm

  have s3 : ∀ (W : C) (P : Sheaf J AddCommGrpCat.{u+1})
      (ev : ∀ M : Sheaf J AddCommGrpCat.{u+1}, (P ⟶ M) ≃ M.obj.obj (Opposite.op W)),
      (∀ (M N : Sheaf J AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = ψ.hom.app (Opposite.op W) (ev M g)) →
      (∀ (M : Sheaf J AddCommGrpCat.{u+1}) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
      Function.Surjective (fun a : Q.obj.obj (Opposite.op W) =>
        (Abelian.Ext.mk₀ (L.map ((ev Q).symm a))).comp τ (zero_add t)) →
      ∀ (s : (R.obj (I.cocomplex.X t)).obj.obj (Opposite.op W)),
        (R.map (I.cocomplex.d t (t + 1))).hom.app (Opposite.op W) s = 0 →
        ∃ (a : Q.obj.obj (Opposite.op W))
          (y : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev t))).obj.obj (Opposite.op W)),
          s = (adj.homEquiv _ _ c).hom.app (Opposite.op W) a +
            (R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t)).hom.app (Opposite.op W) y := by
    intro W P ev hn' ha' hsurj s hs
    have hev0 : ∀ M, ev M 0 = 0 := by
      intro M
      have h := ha' M 0 0
      rw [add_zero] at h
      simpa using h
    have hσ : (ev _).symm s ≫ R.map (I.cocomplex.d t (t + 1)) = 0 := by
      apply (ev _).injective
      rw [hn', Equiv.apply_symm_apply, hs, hev0]
    have hσ' : (adj.homEquiv _ _).symm ((ev _).symm s) ≫ I.cocomplex.d t (t + 1) = 0 := by
      rw [← Adjunction.homEquiv_naturality_right_symm, hσ, Adjunction.homEquiv_counit,
        Functor.map_zero, Limits.zero_comp]
    obtain ⟨a, ha⟩ := hsurj (I.extMk _ (t + 1) rfl hσ')
    have ha2 : (Abelian.Ext.mk₀ (L.map ((ev Q).symm a))).comp τ
        (zero_add t) = I.extMk _ (t + 1) rfl hσ' := ha
    rw [← hτ, InjectiveResolution.mk₀_comp_extMk] at ha2
    have hmc : (L.map ((ev Q).symm a) ≫ c) ≫
        I.cocomplex.d t (t + 1) = 0 := by
      rw [Category.assoc, hc, Limits.comp_zero]
    have hd := I.sub_extMk _ _ (t + 1) rfl hσ' hmc
    rw [← ha2, sub_self] at hd
    obtain ⟨k, hk⟩ := hcob _ _ hd.symm
    have e0 : (adj.homEquiv _ _).symm ((ev _).symm s) =
        L.map ((ev Q).symm a) ≫ c +
          k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
      rw [← hk]
      abel
    have hadd' : ∀ {X : Sheaf J AddCommGrpCat.{u+1}} {Y : 𝒟} (f₁ f₂ : L.obj X ⟶ Y),
        adj.homEquiv _ _ (f₁ + f₂) = adj.homEquiv _ _ f₁ + adj.homEquiv _ _ f₂ := by
      intro X Y f₁ f₂
      simp only [Adjunction.homEquiv_unit, Functor.map_add, Preadditive.comp_add]
    have e1 : (ev _).symm s = (ev _).symm a ≫ adj.homEquiv _ _ c +
        adj.homEquiv _ _ k ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t) := by
      have h1 : (ev _).symm s = adj.homEquiv _ _ ((adj.homEquiv _ _).symm ((ev _).symm s)) :=
        (Equiv.apply_symm_apply _ _).symm
      rw [h1, e0, hadd', Adjunction.homEquiv_naturality_left,
        Adjunction.homEquiv_naturality_right]
    refine ⟨a, ev _ (adj.homEquiv _ _ k), ?_⟩
    calc s = ev _ ((ev _).symm s) := (Equiv.apply_symm_apply _ _).symm
      _ = _ := by rw [e1, ha', hn', hn', Equiv.apply_symm_apply]

  refine ⟨_, hmain t ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
    (adj.homEquiv _ _ c) hg ?_ ?_⟩
  · intro W a y hay
    refine J.superset_covering ?_ (hgood W)
    rw [Sieve.generate_le_iff]
    intro W' h hgd
    apply Sieve.le_generate
    obtain ⟨P, ev, hn', ha'⟩ := hfree W'
    have e := hnat (adj.homEquiv _ _ c) h a
    have e' := hnat (R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t)) h y
    refine s2 W' P ev hn' ha' (hgd P ev hn' ha').1 (Q.obj.map h.op a)
      ((R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev t))).obj.map h.op y) ?_
    refine e.trans (Eq.trans ?_ e'.symm)
    exact congrArg (fun z => (R.obj (I.cocomplex.X t)).obj.map h.op z) hay
  · intro W s hs
    refine J.superset_covering ?_ (hgood W)
    rw [Sieve.generate_le_iff]
    intro W' h hgd
    apply Sieve.le_generate
    obtain ⟨P, ev, hn', ha'⟩ := hfree W'
    have hs' : (R.map (I.cocomplex.d t (t + 1))).hom.app (Opposite.op W')
        ((R.obj (I.cocomplex.X t)).obj.map h.op s) = 0 := by
      rw [hnat]
      exact (congrArg (fun z => (R.obj (I.cocomplex.X (t + 1))).obj.map h.op z) hs).trans
        (map_zero _)
    obtain ⟨a, y, hay⟩ := s3 W' P ev hn' ha' (hgd P ev hn' ha').2 _ hs'
    exact ⟨a, y, hay⟩

theorem wc_proet_closed_free_push_ses {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt) :
    ∃ (g : wcFreeSheaf Y V ⟶ (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V)))
      (w : wcFreeSheafMap Y (wcOpenRestrIncl Y O V) ≫ g = 0),
      (ShortComplex.mk (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) g w).ShortExact :=
by
  classical

  have hfree0 : ∀ (S : Scheme.{u}) (W : S.ProEt), IsEmpty W.left →
      Limits.IsZero (wcFreeSheaf S W) := by
    intro S W hW
    haveI : Finite W.left := Finite.of_subsingleton
    haveI : QuasiSeparatedSpace W.left := ⟨fun U W _ _ _ _ => (U ∩ W).toFinite.isCompact⟩
    have hcov := proet_finite_affine_jointly_surjective_covers S W 0 (fun i => i.elim0)
      (fun i => i.elim0) (fun i => i.elim0) (fun x => (hW.false x).elim)
    have hbot : (⊥ : Sieve W) ∈ Scheme.ProEt.topology S W := by
      refine (Scheme.ProEt.topology S).superset_covering ?_ hcov
      rintro T f ⟨Y, g, k, hk, -⟩
      cases hk with
      | mk i => exact i.elim0
    obtain ⟨eq, -, -⟩ := proet_free_sheaf_hom_equiv S W
    have hz : Limits.IsZero ((wcFreeSheaf S W).obj.obj (Opposite.op W)) :=
      (Sheaf.isTerminalOfBotCover (wcFreeSheaf S W) W hbot).isZero
    haveI := AddCommGrpCat.subsingleton_of_isZero hz
    haveI : Subsingleton (wcFreeSheaf S W ⟶ wcFreeSheaf S W) := (eq (wcFreeSheaf S W)).subsingleton
    exact (Limits.IsZero.iff_id_eq_zero _).mpr (Subsingleton.elim _ _)

  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat i
  haveI : (wcProEtPush i).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : (wcProEtPush i).PreservesZeroMorphisms := by
    first
      | exact Functor.preservesZeroMorphisms_of_isRightAdjoint _
      | exact inferInstance
  have hun : ∀ {X X' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f : X ⟶ X'),
      f ≫ adj.unit.app X' = adj.unit.app X ≫ (wcProEtPush i).map (L.map f) :=
    fun f => adj.unit.naturality f

  have hempty : IsEmpty ((wcProEtPullback i).obj (wcOpenRestr Y O V)).left := by
    have hmemO : ∀ y : (wcOpenRestr Y O V).left,
        (wcOpenRestr Y O V).hom y ∈ (O : Set Y) := by
      intro y
      have hU : (wcOpenRestr Y O V).hom = Limits.pullback.fst O.ι V.hom ≫ O.ι := by
        show Limits.pullback.snd O.ι _ ≫ _ = _
        exact Limits.pullback.condition.symm
      rw [hU]
      change O.ι (Limits.pullback.fst O.ι V.hom y) ∈ (O : Set Y)
      rw [← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    refine ⟨fun z => ?_⟩
    change ↥(Limits.pullback (wcOpenRestr Y O V).hom i) at z
    have hc0 := congrArg (fun g => g z)
      (Limits.pullback.condition (f := (wcOpenRestr Y O V).hom) (g := i))
    have hc : (wcOpenRestr Y O V).hom (Limits.pullback.fst (wcOpenRestr Y O V).hom i z) =
        i (Limits.pullback.snd (wcOpenRestr Y O V).hom i z) := by
      first
        | exact hc0
        | simpa only [Scheme.Hom.comp_apply] using hc0
        | simpa using hc0
    have h1 := hmemO (Limits.pullback.fst _ i z)
    rw [hc, hO] at h1
    exact h1 ⟨_, rfl⟩
  have hz0 := hfree0 _ _ hempty
  have hLι : L.map (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) ≫ (θ V).hom = 0 := by
    rw [hθ, hz0.eq_of_tgt (θ (wcOpenRestr Y O V)).hom 0, Limits.zero_comp]
  let g : wcFreeSheaf Y V ⟶ (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V)) :=
    adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom
  have hkill : wcFreeSheafMap Y (wcOpenRestrIncl Y O V) ≫ g = 0 := by
    show wcFreeSheafMap Y (wcOpenRestrIncl Y O V) ≫
      (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom) = 0
    rw [← Category.assoc, hun, Category.assoc, ← Functor.map_comp, hLι, Functor.map_zero,
      Limits.comp_zero]
  refine ⟨g, hkill, ?_⟩
  haveI : IsIso ((wcProEtPush i).map (θ V).hom) := inferInstance

  have hmono : Mono (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) := by
    apply wc_free_sheaf_map_mono
    show Mono (Limits.pullback.snd O.ι V.hom)
    infer_instance

  haveI : Epi (adj.unit.app (wcFreeSheaf Y V)) := wc_proet_closed_free_unit_epi i L adj V
  have hepi : Epi g := by
    haveI h2 : Epi ((wcProEtPush i).map (θ V).hom) := IsIso.epi_of_iso _
    have h3 : Epi (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map (θ V).hom) :=
      epi_comp _ _
    exact h3

  have hexact : (ShortComplex.mk (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) g hkill).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro A x₂ hx
    have hq : x₂ ≫ adj.unit.app (wcFreeSheaf Y V) = 0 := by
      apply (cancel_mono ((wcProEtPush i).map (θ V).hom)).mp
      rw [Limits.zero_comp, Category.assoc]
      exact hx
    obtain ⟨T', p, h', hp, hph⟩ := wc_proet_closed_free_unit_exact i L adj O hO V A x₂ hq
    exact ⟨T', p, hp, h', hph⟩
  exact ShortComplex.ShortExact.mk' hexact hmono hepi

theorem wc_root_twist_free_ext_vanish_of_et (S : Scheme.{u}) (U : S.ProEt)
    [CompactSpace U.left] [IsSeparated (Limits.terminal.from U.left)]
    (K : Type u) [Field K] [IsSepClosed K] (t : U.left ⟶ Spec (.of K))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (n q : ℕ)
    (h : Subsingleton (wcEtCoh U.left ℓ q)) :
    ∀ x : Abelian.Ext (wcFreeSheaf S U) (wcRootTwist S (ℓ ^ n) 1) q, x = 0 :=
by
  classical

  have transport : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj A ⟶
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj B),
      IsIso ψ → (∀ y : Abelian.Ext (wcFreeSheaf S U) B q, y = 0) →
      ∀ x : Abelian.Ext (wcFreeSheaf S U) A q, x = 0 := by
    intro A B ψ hψ hB x
    letI : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨ΘA⟩ := wc_proet_free_slice_ext_equiv S U A q
    obtain ⟨ΘB⟩ := wc_proet_free_slice_ext_equiv S U B q
    have hz : (ΘA x).comp (Abelian.Ext.mk₀ ψ) (add_zero q) = 0 := by
      rw [← ΘB.apply_symm_apply ((ΘA x).comp (Abelian.Ext.mk₀ ψ) (add_zero q)),
        hB (ΘB.symm _), map_zero]
    have hy : ΘA x = 0 := by
      calc ΘA x = (ΘA x).comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero q) :=
            (Abelian.Ext.comp_mk₀_id _).symm
        _ = (ΘA x).comp (Abelian.Ext.mk₀ (ψ ≫ inv ψ)) (add_zero q) := by rw [IsIso.hom_inv_id]
        _ = ((ΘA x).comp (Abelian.Ext.mk₀ ψ) (add_zero q)).comp
              (Abelian.Ext.mk₀ (inv ψ)) (add_zero q) := by
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀]
        _ = 0 := by rw [hz, Abelian.Ext.zero_comp]
    exact ΘA.injective (hy.trans (map_zero ΘA).symm)

  have untwist : ∀ (m d : ℕ), ((m : ℕ) : K) ≠ 0 →
      ∃ ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
          (wcRootTwist S m d) ⟶
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj (wcZModSheaf S m),
        IsIso ψ := by
    intro m d hmK
    have hm : IsUnit ((m : ℕ) : K) := isUnit_iff_ne_zero.2 hmK
    have wc_rtsp_locSurj_of_const : ∀ (S : Scheme.{u}) (U : S.ProEt) (m : ℕ)
        (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (ρ : (Over.forget U).op ⋙ P ⟶
          (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
            (wcZModSheaf S m)).obj),
        (∀ (V : Over U) (R : Sieve V),
          (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
            ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) →
              R.arrows e) →
          R ∈ (Scheme.ProEt.topology S).over U V) →
        (∀ (V : Over U) (a : ZMod m), ∃ t : P.obj (Opposite.op V.left),
          ULift.down (ρ.app (Opposite.op V) t) = ContinuousMap.const V.left.left a) →
        Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) ρ := by
      intro S U m P ρ hcov hconst
      refine ⟨fun {V} s => ?_⟩
      apply hcov V
      intro y
      let s' : C(V.left.left, ZMod m) := ULift.down s
      refine ⟨⟨s' ⁻¹' {s' y}, s'.continuous.isOpen_preimage _ (isOpen_discrete _)⟩,
        rfl, fun W e he => ?_⟩
      rw [Presheaf.imageSieve_apply]
      obtain ⟨t, ht⟩ := hconst W (s' y)
      refine ⟨t, ?_⟩
      apply ULift.ext
      refine ht.trans ?_
      apply ContinuousMap.ext
      intro z
      have hz : s' (e.left.left z) = s' y := he ⟨z, rfl⟩
      exact hz.symm
    have wc_rtsp_locInj_of_local_zero : ∀ (S : Scheme.{u}) (U : S.ProEt)
        (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (Q : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ρ : (Over.forget U).op ⋙ P ⟶ Q),
        (∀ (V : Over U) (R : Sieve V),
          (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
            ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) →
              R.arrows e) →
          R ∈ (Scheme.ProEt.topology S).over U V) →
        (∀ (V : Over U) (x : P.obj (Opposite.op V.left)), ρ.app (Opposite.op V) x = 0 →
          ∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
            ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) →
              P.map e.left.op x = 0) →
        Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U) ρ := by
      intro S U P Q ρ hcov hz
      refine ⟨fun {V} x₁ x₂ hx => ?_⟩
      apply hcov V.unop
      intro y
      have h0 : ρ.app V (x₁ - x₂) = 0 := by rw [map_sub, hx, sub_self]
      obtain ⟨O, hyO, hO⟩ := hz V.unop (x₁ - x₂) h0 y
      refine ⟨O, hyO, fun W e he => ?_⟩
      rw [Presheaf.equalizerSieve_apply]
      have h1 := hO W e he
      rw [map_sub, sub_eq_zero] at h1
      exact h1

    have hm0 : m ≠ 0 := by
      rintro rfl
      rw [Nat.cast_zero] at hm
      exact not_isUnit_zero hm
    haveI : NeZero m := ⟨hm0⟩
    haveI : NeZero ((m : ℕ) : K) := ⟨hm.ne_zero⟩
    haveI := IsSepClosed.hasEnoughRootsOfUnity K m
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K m

    have hprim : ∀ (V : Over U) (z : V.left.left),
        IsPrimitiveRoot ((V.left.left.evaluation ⊤ z trivial).hom
          ((V.hom.left ≫ t).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom ζ))) m := by
      intro V z
      let χ : K →+* V.left.left.residueField z :=
        ((V.left.left.evaluation ⊤ z trivial).hom.comp
          ((V.hom.left ≫ t).appTop.hom)).comp
          (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
      exact hζ.map_of_injective (f := χ) χ.injective
    have hunit : ∀ V : Over U, IsUnit ((m : ℕ) : Γ(V.left.left, ⊤)) := by
      intro V
      have := hm.map (((V.hom.left ≫ t).appTop.hom).comp
          (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom)
      rwa [map_natCast] at this
    have hpow : ∀ V : Over U,
        ((V.hom.left ≫ t).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom ζ) :
              Γ(V.left.left, ⊤)) ^ m = 1 := by
      intro V
      rw [← map_pow, ← map_pow, hζ.pow_eq_one, map_one, map_one]
    have hnat : ∀ (V V' : Over U) (g : V' ⟶ V),
        ((V'.hom.left ≫ t).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom ζ) :
              Γ(V'.left.left, ⊤)) =
          g.left.left.appTop.hom
            ((V.hom.left ≫ t).appTop.hom
                ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom ζ)) := by
      intro V V' g
      have hw : g.left.left ≫ V.hom.left = V'.hom.left := by
        first
          | exact congrArg (fun k => k.left) (Over.w g)
          | (have hg := Over.w g; rw [← hg]; rfl)
          | (have hg := Over.w g; rw [← hg]; simp)
          | simp
      have key : V'.hom.left ≫ t = g.left.left ≫ (V.hom.left ≫ t) :=
        (congrArg (fun k => k ≫ t) hw).symm.trans (Category.assoc _ _ _)
      first
        | (rw [key, Scheme.Hom.comp_appTop]; rfl)
        | exact (congrArg (fun φ => φ.appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom ζ)) key).trans
            (by rw [Scheme.Hom.comp_appTop]; rfl)

    obtain ⟨ω, hω⟩ : ∃ ω : ∀ V : Over U, Γ(V.left.left, ⊤), ∀ V, ω V =
        (V.hom.left ≫ t).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom ζ) :=
      ⟨fun V => (V.hom.left ≫ t).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom ζ), fun V => rfl⟩
    have hprim' : ∀ (V : Over U) (z : V.left.left),
        IsPrimitiveRoot ((V.left.left.evaluation ⊤ z trivial).hom (ω V)) m := by
      intro V z; rw [hω]; exact hprim V z
    have hpow' : ∀ V : Over U, ω V ^ m = 1 := by
      intro V; rw [hω]; exact hpow V
    have hnat' : ∀ (V V' : Over U) (g : V' ⟶ V),
        ω V' = g.left.left.appTop.hom (ω V) := by
      intro V V' g; rw [hω, hω]; exact hnat V V' g
    let ωu : ∀ V : Over U, Additive (rootsOfUnity m Γ(V.left.left, ⊤)) :=
      fun V => Additive.ofMul (rootsOfUnity.mkOfPowEq (ω V) (hpow' V))
    have hωu : ∀ V : Over U,
        (((Additive.toMul (ωu V) : rootsOfUnity m Γ(V.left.left, ⊤)) : Γ(V.left.left, ⊤)ˣ) :
          Γ(V.left.left, ⊤)) = ω V :=
      fun V => rootsOfUnity.val_mkOfPowEq_coe _ _

    choose L hL using fun V : Over U =>
      wc_rtsp_dlog_exists V.left.left m (ω V) (hprim' V)
    choose D hD using fun V : Over U =>
      (wc_rtsp_tensor_lift m d (Additive (rootsOfUnity m Γ(V.left.left, ⊤)))).2
        C(V.left.left, ZMod m) (L V)
    let G : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun.{u} m ⋙
        wcTwistFun.{u} m d
    let D' : ∀ V : Over U, G.obj (Opposite.op V.left) →+ C(V.left.left, ZMod m) :=
      fun V => D V
    have hnatD : ∀ (V V' : Over U) (g : V' ⟶ V) (w : G.obj (Opposite.op V.left))
        (z : V'.left.left), D' V' (G.map g.left.op w) z = D' V w (g.left.left z) := by
      intro V V' g w z
      have hL' : ∀ (v : Additive (rootsOfUnity m Γ(V'.left.left, ⊤))) (z : V'.left.left) (j : ℕ),
          L V' v z = (j : ZMod m) ↔
            (V'.left.left.evaluation ⊤ z trivial).hom
                (((Additive.toMul v : rootsOfUnity m Γ(V'.left.left, ⊤)) : Γ(V'.left.left, ⊤)ˣ) :
                  Γ(V'.left.left, ⊤)) =
              ((V'.left.left.evaluation ⊤ z trivial).hom (g.left.left.appTop.hom (ω V))) ^ j := by
        intro v z j; rw [← hnat' V V' g]; exact hL V' v z j
      exact wc_rtsp_dlog_tensor_natural V.left.left V'.left.left g.left.left m d (ω V) (L V) (L V')
        (D V) (D V') (hL V) hL' (hD V) (hD V') w z

    let ρ : (Over.forget U).op ⋙ (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ⟶
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
          (wcZModSheaf S m)).obj :=
      { app := fun V => AddCommGrpCat.ofHom (AddMonoidHom.mk'
            (fun x : ULift.{u+1} (G.obj (Opposite.op V.unop.left)) =>
              (ULift.up (D' V.unop x.down) : ULift.{u+1} C(V.unop.left.left, ZMod m)))
            (fun x y => by
              rw [show (x + y).down = x.down + y.down from rfl, map_add]
              rfl))
        naturality := fun V W f => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro x
          apply ULift.ext
          apply ContinuousMap.ext
          intro z
          exact hnatD V.unop W.unop f.unop x.down z }
    have hρD : ∀ (V : Over U) (w : G.obj (Opposite.op V.left)),
        ULift.down (ρ.app (Opposite.op V) (ULift.up w)) = D' V w := fun V w => rfl
    have hcov := wc_rtsp_open_cover_mem S U

    have hinj : Presheaf.IsLocallyInjective
        ((Scheme.ProEt.topology S).over U) ρ := by
      refine wc_rtsp_locInj_of_local_zero S U
        (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) _ ρ hcov ?_
      intro V x hx y
      have hDx : D V x.down = 0 := by
        have h1 := (hρD V x.down).symm.trans (congrArg ULift.down hx)
        exact h1
      have H5 : ∀ (Z' : Scheme.{u}) (f : Z' ⟶ V.left.left)
          (v : Additive (rootsOfUnity m Γ(V.left.left, ⊤))) (k : ℕ),
          (∀ z' : Z', L V v (f z') = (k : ZMod m)) →
          MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) v =
            k • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) (ωu V) :=
        fun Z' f v k hk => wc_rtsp_root_eq_of_dlog_const V.left.left m (ω V) (L V) (hunit V)
          (hL V) Z' f v (ωu V) k (hωu V) hk
      obtain ⟨O, hyO, hO⟩ := wc_rtsp_tensor_locally_pure V.left.left m d (ωu V) (L V) (D V) H5
        (hD V) x.down y
      refine ⟨O, hyO, fun W e he => ?_⟩
      have h2 := hO W.left.left e.left.left he
      rw [hDx, ContinuousMap.zero_apply, TensorProduct.zero_tmul] at h2
      exact ULift.ext _ _ h2

    have hsurj : Presheaf.IsLocallySurjective
        ((Scheme.ProEt.topology S).over U) ρ := by
      refine wc_rtsp_locSurj_of_const S U m
        (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ρ hcov ?_
      intro V a
      have h1 : L V (ωu V) = 1 := by
        ext z
        have h3 := (hL V (ωu V) z 1).2 (by rw [hωu, pow_one])
        rw [h3]
        simp
      refine ⟨ULift.up ((a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin d => ωu V) :
        TensorProduct ℤ (ZMod m)
          (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(V.left.left, ⊤)))))), ?_⟩
      refine (hρD V _).trans ?_
      refine (hD V a _).trans ?_
      simp only [h1, Finset.prod_const_one]
      ext z
      simp

    have hscale1 : ∀ V : Over U,
        ρ.app (Opposite.op (Over.mk (V.hom ≫ 𝟙 U))) =
          1 • ρ.app (Opposite.op V) := by
      intro V
      let g : Over.mk (V.hom ≫ 𝟙 U) ⟶ V :=
        Over.homMk (U := Over.mk (V.hom ≫ 𝟙 U)) (V := V) (𝟙 V.left) (by simp)
      have hn := ρ.naturality g.op
      have e1 : ((Over.forget U).op ⋙
          (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})).map g.op = 𝟙 _ :=
        (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map_id (Opposite.op V.left)
      have e2 : (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1}
          U).obj (wcZModSheaf S m)).obj.map g.op = 𝟙 _ :=
        (wcZModSheaf S m).obj.map_id (Opposite.op V.left)
      rw [e1, e2] at hn
      have key : ρ.app (Opposite.op (Over.mk (V.hom ≫ 𝟙 U))) =
          ρ.app (Opposite.op V) := by
        first
          | exact (Category.id_comp _).symm.trans (hn.trans (Category.comp_id _))
          | (erw [Category.id_comp, Category.comp_id] at hn; exact hn)
          | simpa using hn
      first
        | exact key.trans (one_smul ℕ _).symm
        | (rw [key]; exact (one_smul ℕ _).symm)
        | (erw [one_smul]; exact key)

    obtain ⟨ψ, hψiso, -⟩ := wc_slice_sheafify_scaled_iso S U
      (𝟙 U) (wcRootTwistPre S m d) (wcZModSheaf S m) ρ 1
      hinj hsurj hscale1
    exact ⟨ψ, hψiso⟩

  have key0 : ∀ m : ℕ, m = 1 →
      ∀ x : Abelian.Ext (wcFreeSheaf S U) (wcRootTwist S m 1) q, x = 0 := by
    rintro m rfl x
    have h1 : 𝟙 (wcRootTwist S 1 1) = 0 := by simpa using wc_lfd_root_twist_torsion S 1 1
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero q) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = 0 := by rw [h1, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  intro x
  cases n with
  | zero => exact key0 (ℓ ^ 0) (pow_zero ℓ) x
  | succ n' =>
    have hm : ((ℓ ^ (n' + 1) : ℕ) : K) ≠ 0 := by
      rw [Nat.cast_pow]; exact pow_ne_zero _ hℓ
    obtain ⟨ψ, hψ⟩ := untwist (ℓ ^ (n' + 1)) 1 hm
    have hB := wc_proet_free_zmod_ext_vanish_of_et_qcsep S U (ℓ ^ (n' + 1)) q
      (wc_et_coh_zmod_prime_pow_of_prime U.left ℓ (Fact.out) q h n')
    exact transport _ _ ψ hψ hB x

theorem wc_smooth_divisor_proet_mu_shriek_high_vanish (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (n : ℕ)
    (R : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) [R.Additive]
    (adj : wcProEtPush i ⊣ R)
    (I : InjectiveResolution (wcRootTwist Y (ℓ ^ n) 1)) (q : ℕ) (hq : 2 < q) :
    Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical

  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : (wcProEtPush i).Additive := Adjunction.left_adjoint_additive adj
  obtain ⟨j, rfl⟩ : ∃ j, q = j + 3 := ⟨q - 3, by omega⟩
  let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hO : (O : Set Y) = (Set.range i)ᶜ := rfl
  have hℓ' : (ℓ : SeparableClosure k) ≠ 0 := by
    rw [← map_natCast (algebraMap k (SeparableClosure k)) ℓ]
    exact (map_ne_zero _).2 hℓ

  have hroot : ∀ V : Y.ProEt, IsAffine V.left →
      IsClosed {x : V.left | IsClosed ({x} : Set V.left)} →
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) →
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} →
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)) →
      ∃ t : V.left ⟶ Spec (.of (SeparableClosure k)),
        t ≫ Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))) = V.hom ≫ pY := by
    intro V h1 h2 h3 h4 h5
    haveI := h1
    haveI : IsAffine ((𝟭 Scheme.{u}).obj V.left) := h1
    have hwe : WeaklyEtale (Limits.pullback.fst (V.hom ≫ pY)
        (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k))))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
        (wc_fpe_sepClosure_weaklyEtale k)
    obtain ⟨σ, hσ⟩ := wc_wlocal_strictHensel_retraction V.left h1 h2 h3 h4 h5 _
      (Limits.pullback.fst (V.hom ≫ pY)
        (Spec.map (CommRingCat.ofHom (algebraMap k (SeparableClosure k)))))
      inferInstance hwe inferInstance
    refine ⟨σ ≫ Limits.pullback.snd _ _, ?_⟩
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]

  have hchart : ∀ V : Y.ProEt, (IsAffine V.left ∧
      IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))) →
      ∀ y : Abelian.Ext ((wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V)))
        (wcRootTwist Y (ℓ ^ n) 1) (j + 3), y = 0 := by
    intro V hV
    obtain ⟨h1, h2, h3, h4, h5⟩ := hV
    haveI := h1
    haveI : IsAffine ((𝟭 Scheme.{u}).obj V.left) := h1
    obtain ⟨t, ht⟩ := hroot V h1 h2 h3 h4 h5
    have V1 : ∀ x : Abelian.Ext (wcFreeSheaf Y V) (wcRootTwist Y (ℓ ^ n) 1) (j + 3), x = 0 :=
      wc_root_twist_free_ext_vanish_of_et Y V (SeparableClosure k) t ℓ hℓ' n (j + 3)
        (wc_wstrictly_local_affine_et_vanish k ℓ hℓ (V.hom ≫ pY) ⟨h1, h2, h3, h4, h5⟩ (j + 2))
    have hC : CompactSpace (Limits.pullback (C := Scheme.{u}) O.ι V.hom) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd O.ι V.hom)
    have hS : IsSeparated (Limits.terminal.from (Limits.pullback (C := Scheme.{u}) O.ι V.hom)) := by
      have e : Limits.terminal.from (Limits.pullback (C := Scheme.{u}) O.ι V.hom) =
          Limits.pullback.snd O.ι V.hom ≫
            Limits.terminal.from ((𝟭 Scheme.{u}).obj V.left) := Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    haveI : CompactSpace (wcOpenRestr Y O V).left := hC
    haveI : IsSeparated (Limits.terminal.from (wcOpenRestr Y O V).left) := hS
    have V2 : ∀ x : Abelian.Ext (wcFreeSheaf Y (wcOpenRestr Y O V)) (wcRootTwist Y (ℓ ^ n) 1)
        (j + 2), x = 0 :=
      wc_root_twist_free_ext_vanish_of_et Y (wcOpenRestr Y O V) (SeparableClosure k)
        (Limits.pullback.snd O.ι V.hom ≫ t) ℓ hℓ' n (j + 2)
        (wc_smooth_divisor_compl_wcontr_et_vanish k pY d i ℓ hℓ O hO V ⟨h1, h2, h3, h4, h5⟩ t ht j)
    obtain ⟨g, w, hSE⟩ := wc_proet_closed_free_push_ses i O hO V
    intro y
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hSE _ y (V1 _)
      (show 1 + (j + 2) = j + 3 by omega)
    rw [← hx₁, V2 x₁, Abelian.Ext.comp_zero]

  have hP : ∀ V : Y.ProEt, (IsAffine V.left ∧
      IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))) →
      ∀ (P : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
        (ev : ∀ M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1},
          (P ⟶ M) ≃ M.obj.obj (Opposite.op ((wcProEtBC i).obj V))),
        (∀ (M N : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P ⟶ M),
          ev N (g ≫ ψ) = ψ.hom.app (Opposite.op ((wcProEtBC i).obj V)) (ev M g)) →
        ∀ x : Abelian.Ext ((wcProEtPush i).obj P) (wcRootTwist Y (ℓ ^ n) 1) (j + 3), x = 0 := by
    intro V hV P ev hn x
    obtain ⟨e, he, -⟩ := proet_free_sheaf_hom_equiv Z ((wcProEtBC i).obj V)
    obtain ⟨a, ha⟩ : ∃ a : P ⟶ wcFreeSheaf Z ((wcProEtBC i).obj V),
        ev _ a = e _ (𝟙 (wcFreeSheaf Z ((wcProEtBC i).obj V))) :=
      ⟨(ev _).symm _, Equiv.apply_symm_apply _ _⟩
    obtain ⟨b, hb⟩ : ∃ b : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ P, e _ b = ev _ (𝟙 P) :=
      ⟨(e _).symm _, Equiv.apply_symm_apply _ _⟩
    have hab : a ≫ b = 𝟙 P := by
      apply (ev P).injective
      rw [hn, ha, ← he, Category.id_comp, hb]
    have hx : x = (Abelian.Ext.mk₀ ((wcProEtPush i).map a)).comp
        ((Abelian.Ext.mk₀ ((wcProEtPush i).map b)).comp x (zero_add _)) (zero_add _) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← CategoryTheory.Functor.map_comp, hab,
        CategoryTheory.Functor.map_id, Abelian.Ext.mk₀_id_comp]
    rw [hx, hchart V hV ((Abelian.Ext.mk₀ ((wcProEtPush i).map b)).comp x (zero_add _)),
      Abelian.Ext.comp_zero]

  obtain ⟨Q0, hQ0⟩ : ∃ Q : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}, Limits.IsZero Q :=
    ⟨_, Limits.isZero_zero _⟩
  obtain ⟨ψ, hψ⟩ := wc_sheaf_ab_rightAdj_homology_iso_of_good_basis (Scheme.ProEt.topology Z)
    Q0 (wcProEtPush i) R adj (wcRootTwist Y (ℓ ^ n) 1) I (j + 3) 0 (by
      intro W
      refine (Scheme.ProEt.topology Z).superset_covering ?_ (wc_proet_closed_bc_wcontr_cover i W)
      rw [Sieve.generate_le_iff]
      rintro W' f ⟨V, hV, h1, h2, h3, h4, h5⟩
      subst hV
      apply Sieve.le_generate
      intro P ev hn _
      constructor
      · intro a₁ a₂ _
        haveI : Subsingleton (P ⟶ Q0) := ⟨fun f g => hQ0.eq_of_tgt f g⟩
        exact (ev Q0).symm.injective (Subsingleton.elim _ _)
      · intro z
        refine ⟨ev Q0 0, ?_⟩
        exact (Abelian.Ext.comp_zero _ _ _ _ _).trans
          (hP V ⟨h1, h2, h3, h4, h5⟩ P ev hn z).symm)
  haveI := hψ
  exact hQ0.of_iso (asIso ψ).symm

theorem ext_kummer_divisor_chart_two_step {C : Type*} [Category C] [Abelian C] [HasExt C]
    {A G M D X XO Cc B : C} (m : ℕ)
    (ιK : A ⟶ G) (wK : ιK ≫ (m • 𝟙 G) = 0) (hK : (ShortComplex.mk ιK (m • 𝟙 G) wK).ShortExact)
    (ιD : G ⟶ M) (p : M ⟶ D) (wD : ιD ≫ p = 0) (hD : (ShortComplex.mk ιD p wD).ShortExact)
    (ι : XO ⟶ X) (q : X ⟶ Cc) (wV : ι ≫ q = 0) (hV : (ShortComplex.mk ι q wV).ShortExact)
    [Projective X]
    (hM : Function.Bijective (fun t : X ⟶ M => ι ≫ t))
    (hpic : ∀ y : Abelian.Ext XO G 1, m • y = 0 → y = 0)
    (δ : B ⟶ D) {H : Type*} [AddCommGroup H] (β : H →+ (Cc ⟶ B))
    (hβi : Function.Injective (fun b : H => q ≫ β b ≫ δ))
    (hβs : ∀ s : X ⟶ D, ι ≫ s = 0 → ∃ b : H, q ≫ β b ≫ δ = s) :
    (∀ b : H, (Abelian.Ext.mk₀ (β b)).comp ((Abelian.Ext.mk₀ δ).comp
        (hD.extClass.comp hK.extClass (by norm_num : 1 + 1 = 2)) (zero_add 2)) (zero_add 2) = 0 ↔
        ∃ c : H, b = m • c) ∧
    Function.Surjective (fun b : H => (Abelian.Ext.mk₀ (β b)).comp ((Abelian.Ext.mk₀ δ).comp
        (hD.extClass.comp hK.extClass (by norm_num : 1 + 1 = 2)) (zero_add 2)) (zero_add 2)) :=
by

  have N1 : ∀ {Y₁ Y₂ : C} (r : ℕ) (f : Y₁ ⟶ Y₂),
      Abelian.Ext.mk₀ (r • f) = r • Abelian.Ext.mk₀ f := by
    intro Y₁ Y₂ r f
    induction r with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ r ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have N2 : ∀ {Y₁ Y₂ Y₃ : C} {a b c : ℕ} (r : ℕ) (α : Abelian.Ext Y₁ Y₂ a)
      (β' : Abelian.Ext Y₂ Y₃ b) (h : a + b = c), (r • α).comp β' h = r • α.comp β' h := by
    intro Y₁ Y₂ Y₃ a b c r α β' h
    induction r with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ r ih => rw [succ_nsmul, Abelian.Ext.add_comp, ih, succ_nsmul]
  have N3 : ∀ {Y₁ Y₂ Y₃ : C} {a b c : ℕ} (r : ℕ) (α : Abelian.Ext Y₁ Y₂ a)
      (β' : Abelian.Ext Y₂ Y₃ b) (h : a + b = c), α.comp (r • β') h = r • α.comp β' h := by
    intro Y₁ Y₂ Y₃ a b c r α β' h
    induction r with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.comp_zero]
    | succ r ih => rw [succ_nsmul, Abelian.Ext.comp_add, ih, succ_nsmul]
  haveI : Epi q := hV.epi_g

  have htor : ∀ w : Abelian.Ext Cc G 2, m • w = 0 → w = 0 := by
    intro w hw
    have ha : (Abelian.Ext.mk₀ q).comp w (zero_add 2) = 0 :=
      Abelian.Ext.eq_zero_of_projective _
    obtain ⟨y, hy⟩ := Abelian.Ext.contravariant_sequence_exact₃ hV G w ha
      (n₀ := 1) (by norm_num)
    have hinj : ∀ y' : Abelian.Ext XO G 1,
        hV.extClass.comp y' (by norm_num : 1 + 1 = 2) = 0 → y' = 0 := by
      intro y' hy'
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hV G y' _ hy'
      have hx0 : x₂ = 0 := @Abelian.Ext.eq_zero_of_projective _ _ _ _ X G 0 _ x₂
      rw [← hx₂, hx0, Abelian.Ext.comp_zero]
    have hmy : m • y = 0 := by
      apply hinj
      rw [N3, hy, hw]
    rw [← hy, hpic y hmy, Abelian.Ext.comp_zero]

  have h0 : ∀ u : Cc ⟶ M, u = 0 := by
    intro u
    have e1 : ι ≫ (q ≫ u) = ι ≫ (q ≫ 0) := by
      rw [← Category.assoc, wV, Limits.zero_comp, Limits.comp_zero, Limits.comp_zero]
    have e2 : q ≫ u = q ≫ 0 := hM.1 e1
    exact (cancel_epi q).mp e2
  have hz0 : ∀ x : Abelian.Ext Cc M 0, x = 0 := by
    intro x
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply x, h0 (Abelian.Ext.homEquiv₀ x), Abelian.Ext.mk₀_zero]
  have h1 : ∀ u : Abelian.Ext Cc M 1, u = 0 := by
    intro u
    have ha : (Abelian.Ext.mk₀ q).comp u (zero_add 1) = 0 :=
      Abelian.Ext.eq_zero_of_projective _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hV M u ha
      (n₀ := 0) (by norm_num)
    obtain ⟨g, hg⟩ := hM.2 (Abelian.Ext.homEquiv₀ x₁)
    have hg' : ι ≫ g = Abelian.Ext.homEquiv₀ x₁ := hg
    have hx : x₁ = (Abelian.Ext.mk₀ ι).comp (Abelian.Ext.mk₀ g) (zero_add 0) := by
      rw [Abelian.Ext.mk₀_comp_mk₀, hg', Abelian.Ext.mk₀_homEquiv₀_apply]
    have hc : hV.extClass.comp (Abelian.Ext.mk₀ ι) (add_zero 1) = 0 := hV.extClass_comp
    rw [← hx₁, hx, ← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 0) (by norm_num), hc,
      Abelian.Ext.zero_comp]

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : (Cc ⟶ D) → Abelian.Ext Cc G 1,
      ∀ t, Ψ t = (Abelian.Ext.mk₀ t).comp hD.extClass (zero_add 1) := ⟨_, fun _ => rfl⟩
  have hΨi : Function.Injective Ψ := by
    intro t t' htt
    rw [hΨ, hΨ] at htt
    have e1 : (Abelian.Ext.mk₀ (t - t')).comp hD.extClass (zero_add 1) = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, Abelian.Ext.add_comp,
        Abelian.Ext.neg_comp, htt, add_neg_cancel]
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ Cc hD _ (zero_add 1) e1
    have hx0 : x₂ = 0 := hz0 x₂
    rw [hx0, Abelian.Ext.zero_comp] at hx₂
    have e2 : t - t' = 0 :=
      (Abelian.Ext.mk₀_bijective Cc D).1 (hx₂.symm.trans (Abelian.Ext.mk₀_zero Cc D).symm)
    exact sub_eq_zero.mp e2
  have hΨs : Function.Surjective Ψ := by
    intro x
    have hx : x.comp (Abelian.Ext.mk₀ ιD) (add_zero 1) = 0 := h1 _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ Cc hD x hx (zero_add 1)
    refine ⟨Abelian.Ext.homEquiv₀ x₃, ?_⟩
    rw [hΨ, Abelian.Ext.mk₀_homEquiv₀_apply]
    exact hx₃
  have hΨm : ∀ t : Cc ⟶ D, Ψ (m • t) = m • Ψ t := by
    intro t
    rw [hΨ, hΨ, N1, N2]

  have hR : ∀ x : Abelian.Ext Cc G 1,
      x.comp (Abelian.Ext.mk₀ (m • 𝟙 G)) (add_zero 1) = m • x := by
    intro x
    rw [N1, N3, Abelian.Ext.comp_mk₀_id]
  have hKm : m • hK.extClass = 0 := by
    have e : (Abelian.Ext.mk₀ (m • 𝟙 G)).comp hK.extClass (zero_add 1) = 0 := hK.comp_extClass
    rw [N1, N2, Abelian.Ext.mk₀_id_comp] at e
    exact e
  have hker : ∀ y : Abelian.Ext Cc G 1, y.comp hK.extClass (by norm_num : 1 + 1 = 2) = 0 ↔
      ∃ x : Abelian.Ext Cc G 1, y = m • x := by
    intro y
    constructor
    · intro hy
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ Cc hK y _ hy
      refine ⟨x₂, ?_⟩
      rw [← hx₂]
      exact hR x₂
    · rintro ⟨x, rfl⟩
      rw [N2, ← N3, hKm, Abelian.Ext.comp_zero]
  have hsurj : ∀ z : Abelian.Ext Cc A 2,
      ∃ y : Abelian.Ext Cc G 1, y.comp hK.extClass (by norm_num : 1 + 1 = 2) = z := by
    intro z
    have hιm : m • ιK = 0 := by
      rw [← wK, Preadditive.comp_nsmul, Category.comp_id]
    have hw : z.comp (Abelian.Ext.mk₀ ιK) (add_zero 2) = 0 := by
      apply htor
      rw [← N3, ← N1, hιm, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ Cc hK z hw (n₀ := 1) (by norm_num)
    exact ⟨x₃, hx₃⟩

  have hI : ∀ b : H, (Abelian.Ext.mk₀ (β b)).comp ((Abelian.Ext.mk₀ δ).comp
        (hD.extClass.comp hK.extClass (by norm_num : 1 + 1 = 2)) (zero_add 2)) (zero_add 2) =
      (Ψ (β b ≫ δ)).comp hK.extClass (by norm_num : 1 + 1 = 2) := by
    intro b
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hΨ]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (by norm_num) (by norm_num)).symm
  have hsm : ∀ c : H, β (m • c) ≫ δ = m • (β c ≫ δ) := by
    intro c
    rw [map_nsmul, Preadditive.nsmul_comp]
  have hsi : ∀ b b' : H, β b ≫ δ = β b' ≫ δ → b = b' := by
    intro b b' h
    exact hβi (show q ≫ β b ≫ δ = q ≫ β b' ≫ δ by rw [h])
  have hss : ∀ t : Cc ⟶ D, ∃ b : H, β b ≫ δ = t := by
    intro t
    obtain ⟨b, hb⟩ := hβs (q ≫ t) (by rw [← Category.assoc, wV, Limits.zero_comp])
    exact ⟨b, (cancel_epi q).mp hb⟩
  refine ⟨fun b => ?_, fun z => ?_⟩
  · rw [hI]
    constructor
    · intro hΦ
      obtain ⟨x, hx⟩ := (hker _).1 hΦ
      obtain ⟨t, rfl⟩ := hΨs x
      obtain ⟨c, rfl⟩ := hss t
      refine ⟨c, hsi _ _ (hΨi ?_)⟩
      rw [hx, hsm, hΨm]
    · rintro ⟨c, rfl⟩
      exact (hker _).2 ⟨Ψ (β c ≫ δ), by rw [hsm, hΨm]⟩
  · obtain ⟨y, hy⟩ := hsurj z
    obtain ⟨t, rfl⟩ := hΨs y
    obtain ⟨b, rfl⟩ := hss t
    refine ⟨b, ?_⟩
    show (Abelian.Ext.mk₀ (β b)).comp ((Abelian.Ext.mk₀ δ).comp
        (hD.extClass.comp hK.extClass (by norm_num : 1 + 1 = 2)) (zero_add 2)) (zero_add 2) = z
    rw [hI, hy]

theorem wc_proet_corep_iso_reduction {S : Scheme.{u}} (W : S.ProEt)
    (P P₀ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ev : ∀ M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      (P ⟶ M) ≃ M.obj.obj (Opposite.op W))
    (ev₀ : ∀ M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      (P₀ ⟶ M) ≃ M.obj.obj (Opposite.op W))
    (hnat : ∀ (M N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = ψ.hom.app (Opposite.op W) (ev M g))
    (hnat₀ : ∀ (M N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ψ : M ⟶ N) (g : P₀ ⟶ M),
      ev₀ N (g ≫ ψ) = ψ.hom.app (Opposite.op W) (ev₀ M g)) :
    ∃ φ : P ≅ P₀, ∀ (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (s : M.obj.obj (Opposite.op W)), (ev M).symm s = φ.hom ≫ (ev₀ M).symm s :=
by
  have K : ∀ (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (g : P ⟶ M),
      ev M g = g.hom.app (Opposite.op W) (ev P (𝟙 P)) := by
    intro M g
    have h := hnat P M g (𝟙 P)
    rwa [Category.id_comp] at h
  have K₀ : ∀ (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (g : P₀ ⟶ M),
      ev₀ M g = g.hom.app (Opposite.op W) (ev₀ P₀ (𝟙 P₀)) := by
    intro M g
    have h := hnat₀ P₀ M g (𝟙 P₀)
    rwa [Category.id_comp] at h
  obtain ⟨a, hA⟩ : ∃ a : P ⟶ P₀, ev P₀ a = ev₀ P₀ (𝟙 P₀) :=
    ⟨(ev P₀).symm (ev₀ P₀ (𝟙 P₀)), Equiv.apply_symm_apply _ _⟩
  obtain ⟨b, hB⟩ : ∃ b : P₀ ⟶ P, ev₀ P b = ev P (𝟙 P) :=
    ⟨(ev₀ P).symm (ev P (𝟙 P)), Equiv.apply_symm_apply _ _⟩
  have hab : a ≫ b = 𝟙 P := by
    apply (ev P).injective
    rw [hnat P₀ P b a, hA, ← K₀ P b, hB]
  have hba : b ≫ a = 𝟙 P₀ := by
    apply (ev₀ P₀).injective
    rw [hnat₀ P P₀ a b, hB, ← K P₀ a, hA]
  refine ⟨⟨a, b, hab, hba⟩, fun M s => ?_⟩
  show (ev M).symm s = a ≫ (ev₀ M).symm s
  rw [Equiv.symm_apply_eq, hnat P₀ M ((ev₀ M).symm s) a, hA, ← K₀ M ((ev₀ M).symm s),
    Equiv.apply_symm_apply]

theorem wc_contSheaf_int_zmod_ses (S : Scheme.{u}) (m : ℕ) (hm : 0 < m) :
    ∃ w : (m • 𝟙 (wcContSheaf S ℤ)) ≫
        wcContSheafMap S (Int.castAddHom (ZMod m)) continuous_of_discreteTopology = 0,
      (ShortComplex.mk _ _ w).ShortExact ∧
      (∀ W : S.ProEt, Function.Surjective
        ((wcContSheafMap S (Int.castAddHom (ZMod m)) continuous_of_discreteTopology).hom.app
          (Opposite.op W))) ∧
      ∀ (W : S.ProEt) (b : (wcContSheaf S ℤ).obj.obj (Opposite.op W)),
        (wcContSheafMap S (Int.castAddHom (ZMod m)) continuous_of_discreteTopology).hom.app
          (Opposite.op W) b = 0 → ∃ c, b = m • c :=
by
  classical
  haveI : NeZero m := ⟨hm.ne'⟩
  have hmZ : (m : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr hm.ne'

  have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
      (g : G ⟶ H),
      (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
      (∀ U, Function.Injective (f.hom.app U)) →
      (∀ U, Function.Surjective (g.hom.app U)) →
      (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
      ∃ hzero : f ≫ g = 0, (ShortComplex.mk f g hzero).ShortExact := by
    intro F G H f g h1 h0 h2 h3
    have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
        (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
      intro X Y U y
      rfl
    have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
        (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
        (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
      intro X Y Z p q U y
      rfl
    have w : f ≫ g = 0 := by
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp, hzero, h1]
    haveI : Epi g := by
      haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
      haveI : Epi g.hom := NatTrans.epi_of_epi_app _
      exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
    haveI : Mono f := by
      haveI : ∀ U, Mono (f.hom.app U) := fun U => (AddCommGrpCat.mono_iff_injective _).mpr (h0 U)
      haveI : Mono f.hom := NatTrans.mono_of_mono_app _
      exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
    have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
        f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
      intro A k hk
      have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
        intro U y
        have := congrArg (fun φ => φ.hom.app U y) hk
        simp only at this
        rw [hcomp, hzero] at this
        exact this
      have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
          k.hom.app U x = k.hom.app U x' := by
        intro U x x' hxx
        obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
        have := hk' U y
        rw [hy, map_sub, sub_eq_zero] at this
        exact this
      let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
      have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
      let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
          intro φ ψ
          rw [← map_add]
          apply hd
          rw [map_add, hσ, hσ, hσ]))
      have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
      let l : H ⟶ A := ObjectProperty.homMk
        { app := lU
          naturality := by
            intro U V r
            ext φ
            rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
              ← NatTrans.naturality_apply]
            apply hd
            rw [hσ, NatTrans.naturality_apply, hσ] }
      refine ⟨l, ?_⟩
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp]
      change lU U (g.hom.app U x) = k.hom.app U x
      rw [hlU]
      apply hd
      rw [hσ]
    refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
    exact ShortComplex.exact_of_g_is_cokernel _ (Limits.CokernelCofork.IsColimit.ofπ' g w fac)

  have hsm : ∀ {F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : ℕ)
      (U : S.ProEtᵒᵖ) (x : F.obj.obj U), (k • 𝟙 F).hom.app U x = k • x := by
    intro F k U x
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Sheaf.Hom.add_app]
      change (ConcreteCategory.hom ((k • 𝟙 F).hom.app U)) x + x = k • x + x
      rw [ih]
  have h1 : ∀ U (x : (wcContSheaf S ℤ).obj.obj U),
      (wcContSheafMap S (Int.castAddHom (ZMod m)) continuous_of_discreteTopology).hom.app U
        ((m • 𝟙 (wcContSheaf S ℤ)).hom.app U x) = 0 := by
    intro U x
    rw [hsm]
    let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ) := x.down
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change (Int.castAddHom (ZMod m)) (m • x0 t) = 0
    rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have h0 : ∀ U, Function.Injective ((m • 𝟙 (wcContSheaf S ℤ)).hom.app U) := by
    intro U x x' hxx
    rw [hsm, hsm] at hxx
    let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ) := x.down
    let x1 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ) := x'.down
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    have h := congrArg (fun z => (ULift.down z :
      C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ)) t) hxx
    have h' : m • x0 t = m • x1 t := h
    rw [nsmul_eq_mul, nsmul_eq_mul] at h'
    exact mul_left_cancel₀ hmZ h'
  have h2 : ∀ U, Function.Surjective
      ((wcContSheafMap S (Int.castAddHom (ZMod m)) continuous_of_discreteTopology).hom.app U) := by
    intro U a
    let a0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ZMod m) := a.down
    refine ⟨ULift.up (⟨fun t => (((a0 t).val : ℕ) : ℤ),
      (continuous_of_discreteTopology (f := fun c : ZMod m => ((c.val : ℕ) : ℤ))).comp
        a0.continuous⟩ :
      C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ)), ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change ((((a0 t).val : ℕ) : ℤ) : ZMod m) = a0 t
    rw [Int.cast_natCast, ZMod.natCast_zmod_val]
  have h3 : ∀ U (b : (wcContSheaf S ℤ).obj.obj U),
      (wcContSheafMap S (Int.castAddHom (ZMod m)) continuous_of_discreteTopology).hom.app U b = 0 →
      ∃ c, (m • 𝟙 (wcContSheaf S ℤ)).hom.app U c = b := by
    intro U b hb
    let b0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ) := b.down
    have hdvd : ∀ t, (m : ℤ) ∣ b0 t := by
      intro t
      have h := congrArg (fun z => (ULift.down z :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ZMod m)) t) hb
      have h' : ((b0 t : ℤ) : ZMod m) = 0 := h
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd (b0 t) m).mp h'
    refine ⟨ULift.up (⟨fun t => b0 t / (m : ℤ),
      (continuous_of_discreteTopology (f := fun z : ℤ => z / (m : ℤ))).comp b0.continuous⟩ :
      C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ)), ?_⟩
    refine (hsm _ _ _).trans ?_
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change m • (b0 t / (m : ℤ)) = b0 t
    rw [nsmul_eq_mul]
    exact Int.mul_ediv_cancel' (hdvd t)
  obtain ⟨w, hSE⟩ := crit _ _ h1 h0 h2 h3
  refine ⟨w, hSE, fun W => h2 (Opposite.op W), fun W b hb => ?_⟩
  obtain ⟨c, hc⟩ := h3 (Opposite.op W) b hb
  exact ⟨c, hc.symm.trans (hsm _ _ _)⟩

theorem wc_smooth_divisor_kummer_rootTwist_ses (k : Type u) [Field k] {Y : Scheme.{u}}
    (pY : Y ⟶ Spec (.of k)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (n : ℕ)
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology Y)
      ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})) :
    ∃ (ιK : wcRootTwist Y (ℓ ^ n) 1 ⟶ (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}))
      (w : ιK ≫ ((ℓ ^ n : ℕ) • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})) = 0),
      (ShortComplex.mk ιK _ w).ShortExact :=
by
  have hm : 0 < ℓ ^ n := pow_pos (Fact.out : ℓ.Prime).pos n
  have hk : ((ℓ ^ n : ℕ) : k) ≠ 0 := by
    rw [Nat.cast_pow]
    exact pow_ne_zero n hℓ
  have hu : IsUnit ((ℓ ^ n : ℕ) : k) := hk.isUnit
  have hunit : ∀ U : Y.ProEt, IsUnit (((ℓ ^ n : ℕ) : ℕ) : Γ(U.left, ⊤)) := by
    intro U
    let ψ : k →+* Γ(U.left, ⊤) :=
      ((U.hom ≫ pY).appTop.hom).comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom
    have h1 := hu.map ψ
    rwa [map_natCast] at h1
  have hμ := wc_d1_roots_isSheaf Y (ℓ ^ n) hG
  have hloc : ∀ (U : Y.ProEt) (y : (Γ(U.left, ⊤))ˣ), ∃ (V : Y.ProEt) (g : V ⟶ U)
      (x : (Γ(V.left, ⊤))ˣ),
      Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology Y U ∧
      (x : Γ(V.left, ⊤)) ^ (ℓ ^ n) = g.left.appTop.hom (y : Γ(U.left, ⊤)) :=
    fun U y => wc_d1_local_root_cover Y (ℓ ^ n) hm (wc_d1_kummer_algebra (ℓ ^ n) hm) U (hunit U) y
  obtain ⟨ι₀, w₀, h₀⟩ := wc_d1_kummer_ses Y (ℓ ^ n) hG hμ hloc
  obtain ⟨e⟩ := wc_d1_roots_twist_iso Y (ℓ ^ n) hm hμ (wc_d1_zmod_tensor_one_bij (ℓ ^ n) hm)
  have w : (e.inv ≫ ι₀) ≫ ((ℓ ^ n : ℕ) •
      𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})) = 0 := by
    rw [Category.assoc, w₀, Limits.comp_zero]
  refine ⟨e.inv ≫ ι₀, w, ?_⟩
  have iso : ShortComplex.mk ι₀ _ w₀ ≅ ShortComplex.mk (e.inv ≫ ι₀) _ w :=
    ShortComplex.isoMk e (Iso.refl _) (Iso.refl _) (by simp) (by simp)
  exact ShortComplex.shortExact_of_iso iso h₀

theorem wc_proet_closed_push_free_bc_canonical_ses {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt)
    (ηY : (wcFreeSheaf Y V).obj.obj (Opposite.op V))
    (hηY : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (s : G.obj.obj (Opposite.op V)),
      ∃! g : wcFreeSheaf Y V ⟶ G, (g.hom.app (Opposite.op V)).hom ηY = s)
    (ηZ : (wcFreeSheaf Z ((wcProEtBC i).obj V)).obj.obj (Opposite.op ((wcProEtBC i).obj V)))
    (hηZ : ∀ (G : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (s : G.obj.obj (Opposite.op ((wcProEtBC i).obj V))),
      ∃! g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ G,
        (g.hom.app (Opposite.op ((wcProEtBC i).obj V))).hom ηZ = s)
    (q : wcFreeSheaf Y V ⟶ (wcProEtPush i).obj (wcFreeSheaf Z ((wcProEtBC i).obj V)))
    (hq : (q.hom.app (Opposite.op V)).hom ηY =
      ((toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange i).op ⋙
        (wcFreeSheaf Z ((wcProEtBC i).obj V)).obj)).app (Opposite.op V)).hom ηZ) :
    ∃ w : wcFreeSheafMap Y (wcOpenRestrIncl Y O V) ≫ q = 0,
      (ShortComplex.mk (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) q w).ShortExact :=
by
  classical

  have hfree0 : ∀ (S : Scheme.{u}) (W : S.ProEt), IsEmpty W.left →
      Limits.IsZero (wcFreeSheaf S W) := by
    intro S W hW
    haveI : Finite W.left := Finite.of_subsingleton
    haveI : QuasiSeparatedSpace W.left := ⟨fun U W' _ _ _ _ => (U ∩ W').toFinite.isCompact⟩
    have hcov := proet_finite_affine_jointly_surjective_covers S W 0 (fun k => k.elim0)
      (fun k => k.elim0) (fun k => k.elim0) (fun x => (hW.false x).elim)
    have hbot : (⊥ : Sieve W) ∈ Scheme.ProEt.topology S W := by
      refine (Scheme.ProEt.topology S).superset_covering ?_ hcov
      rintro T f ⟨Y', g, k, hk, -⟩
      cases hk with
      | mk j => exact j.elim0
    obtain ⟨eq, -, -⟩ := proet_free_sheaf_hom_equiv S W
    have hz : Limits.IsZero ((wcFreeSheaf S W).obj.obj (Opposite.op W)) :=
      (Sheaf.isTerminalOfBotCover (wcFreeSheaf S W) W hbot).isZero
    haveI := AddCommGrpCat.subsingleton_of_isZero hz
    haveI : Subsingleton (wcFreeSheaf S W ⟶ wcFreeSheaf S W) :=
      (eq (wcFreeSheaf S W)).subsingleton
    exact (Limits.IsZero.iff_id_eq_zero _).mpr (Subsingleton.elim _ _)

  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat i
  haveI : (wcProEtPush i).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : (wcProEtPush i).PreservesZeroMorphisms := by
    first
      | exact Functor.preservesZeroMorphisms_of_isRightAdjoint _
      | exact inferInstance
  have hun : ∀ {X X' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f : X ⟶ X'),
      f ≫ adj.unit.app X' = adj.unit.app X ≫ (wcProEtPush i).map (L.map f) :=
    fun f => adj.unit.naturality f
  let ζ : L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtBC i).obj V) := θ V

  have hempty : IsEmpty ((wcProEtPullback i).obj (wcOpenRestr Y O V)).left := by
    have hmemO : ∀ y : (wcOpenRestr Y O V).left,
        (wcOpenRestr Y O V).hom y ∈ (O : Set Y) := by
      intro y
      have hU : (wcOpenRestr Y O V).hom =
          Limits.pullback.fst O.ι V.hom ≫ O.ι := by
        show Limits.pullback.snd O.ι _ ≫ _ = _
        exact Limits.pullback.condition.symm
      rw [hU]
      change O.ι (Limits.pullback.fst O.ι V.hom y) ∈ (O : Set Y)
      rw [← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    refine ⟨fun z => ?_⟩
    change ↥(Limits.pullback (wcOpenRestr Y O V).hom i) at z
    have hc0 := congrArg (fun g => g z)
      (Limits.pullback.condition (f := (wcOpenRestr Y O V).hom) (g := i))
    have hc : (wcOpenRestr Y O V).hom
        (Limits.pullback.fst (wcOpenRestr Y O V).hom i z) =
        i (Limits.pullback.snd (wcOpenRestr Y O V).hom i z) := by
      first
        | exact hc0
        | simpa only [Scheme.Hom.comp_apply] using hc0
        | simpa using hc0
    have h1 := hmemO (Limits.pullback.fst _ i z)
    rw [hc, hO] at h1
    exact h1 ⟨_, rfl⟩
  have hz0 := hfree0 _ _ hempty
  have hLι : L.map (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) ≫ ζ.hom = 0 := by
    show L.map (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) ≫ (θ V).hom = 0
    rw [hθ, hz0.eq_of_tgt (θ (wcOpenRestr Y O V)).hom 0, Limits.zero_comp]
  have hkill : wcFreeSheafMap Y (wcOpenRestrIncl Y O V) ≫
      (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom) = 0 := by
    rw [← Category.assoc (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)), hun, Category.assoc,
      ← CategoryTheory.Functor.map_comp, hLι, Functor.map_zero, Limits.comp_zero]
  haveI : IsIso ((wcProEtPush i).map ζ.hom) := inferInstance
  haveI : Epi (adj.unit.app (wcFreeSheaf Y V)) := wc_proet_closed_free_unit_epi i L adj V

  haveI hcont : (wcProEtBaseChange i).IsContinuous (Scheme.ProEt.topology Y)
      (Scheme.ProEt.topology Z) := (wc_proet_pullback_continuous_flat i).1
  have hθM : ∀ M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1},
      Function.Bijective (fun x : M.obj.obj (Opposite.op ((wcProEtBaseChange i).obj V)) =>
        ((toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange i).op ⋙ M.obj)).app
          (Opposite.op V)).hom x) := by
    intro M
    have hs := Functor.op_comp_isSheaf (wcProEtBaseChange i) (Scheme.ProEt.topology Y)
      (Scheme.ProEt.topology Z) M
    haveI := isIso_toSheafify (Scheme.ProEt.topology Y)
      (P := (wcProEtBaseChange i).op ⋙ M.obj) hs
    haveI := NatIso.isIso_app_of_isIso
      (toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange i).op ⋙ M.obj)) (Opposite.op V)
    exact ConcreteCategory.bijective_of_isIso _

  have hEY : ∀ G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1},
      Function.Bijective (fun t : wcFreeSheaf Y V ⟶ G => (t.hom.app (Opposite.op V)).hom ηY) :=
    fun G => ⟨fun g g' h => (hηY G ((g.hom.app (Opposite.op V)).hom ηY)).unique rfl h.symm,
      fun s => (hηY G s).exists⟩
  have hEZ : ∀ M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M =>
        (g.hom.app (Opposite.op ((wcProEtBC i).obj V))).hom ηZ) :=
    fun M => ⟨fun g g' h => (hηZ M ((g.hom.app (Opposite.op ((wcProEtBC i).obj V))).hom ηZ)).unique
      rfl h.symm, fun s => (hηZ M s).exists⟩
  have T2 : ∀ (M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M),
      ((q ≫ (wcProEtPush i).map g).hom.app (Opposite.op V)).hom ηY =
        ((toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange i).op ⋙ M.obj)).app
          (Opposite.op V)).hom ((g.hom.app (Opposite.op ((wcProEtBC i).obj V))).hom ηZ) := by
    intro M g
    have e := congrArg (fun f => (f.app (Opposite.op V)).hom ηZ)
      (toSheafify_naturality (Scheme.ProEt.topology Y)
        (Functor.whiskerLeft (wcProEtBaseChange i).op g.hom))
    show (((wcProEtPush i).map g).hom.app (Opposite.op V)).hom
      ((q.hom.app (Opposite.op V)).hom ηY) = _
    rw [hq]
    exact e.symm

  have hqb : ∀ M : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M =>
        q ≫ (wcProEtPush i).map g) := by
    intro M
    refine ((hEY ((wcProEtPush i).obj M)).of_comp_iff' _).mp ?_
    have hc : (fun t : wcFreeSheaf Y V ⟶ (wcProEtPush i).obj M =>
          (t.hom.app (Opposite.op V)).hom ηY) ∘
        (fun g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M => q ≫ (wcProEtPush i).map g) =
        (fun x => ((toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange i).op ⋙ M.obj)).app
          (Opposite.op V)).hom x) ∘
          (fun g : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶ M =>
            (g.hom.app (Opposite.op ((wcProEtBC i).obj V))).hom ηZ) := by
      funext g
      exact T2 M g
    rw [hc]
    exact (hθM M).comp (hEZ M)

  obtain ⟨g₀, hg₀⟩ : ∃ g₀ : wcFreeSheaf Z ((wcProEtBC i).obj V) ⟶
      wcFreeSheaf Z ((wcProEtBC i).obj V),
      (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom) ≫
        (wcProEtPush i).map g₀ = q :=
    ⟨ζ.inv ≫ (adj.homEquiv _ _).symm q, by
      rw [Category.assoc, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id_assoc]
      first
        | exact (adj.homEquiv_unit _ _ _).symm.trans (Equiv.apply_symm_apply _ q)
        | exact (Adjunction.homEquiv_unit adj _ _ ((adj.homEquiv _ _).symm q)).symm.trans
            (Equiv.apply_symm_apply (adj.homEquiv _ _) q)
        | simp [Adjunction.homEquiv_unit]
        | exact (adj.homEquiv _ _).apply_symm_apply q⟩
  obtain ⟨g₁, hg₁⟩ := (hqb (wcFreeSheaf Z ((wcProEtBC i).obj V))).2
    (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom)
  have hg₁' : q ≫ (wcProEtPush i).map g₁ =
      adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom := hg₁
  have hsplit : g₁ ≫ g₀ = 𝟙 _ := by
    apply (hqb _).1
    show q ≫ (wcProEtPush i).map (g₁ ≫ g₀) = q ≫ (wcProEtPush i).map (𝟙 _)
    rw [CategoryTheory.Functor.map_comp, ← Category.assoc, hg₁', hg₀,
      CategoryTheory.Functor.map_id, Category.comp_id]
  haveI : IsSplitEpi ((wcProEtPush i).map g₀) :=
    IsSplitEpi.mk' ⟨(wcProEtPush i).map g₁, by
      rw [← CategoryTheory.Functor.map_comp, hsplit, CategoryTheory.Functor.map_id]⟩

  have w : wcFreeSheafMap Y (wcOpenRestrIncl Y O V) ≫ q = 0 := by
    rw [← hg₀, ← Category.assoc, hkill, Limits.zero_comp]
  have hmono : Mono (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) := by
    apply wc_free_sheaf_map_mono
    show Mono (Limits.pullback.snd O.ι V.hom)
    first
      | infer_instance
      | exact AlgebraicGeometry.IsOpenImmersion.mono _
  have hepi : Epi q := by
    haveI : Epi (adj.unit.app (wcFreeSheaf Y V) ≫ (wcProEtPush i).map ζ.hom) := epi_comp _ _
    rw [← hg₀]
    exact epi_comp _ _
  have hexact : (ShortComplex.mk (wcFreeSheafMap Y (wcOpenRestrIncl Y O V)) q w).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro A x₂ hx₂
    have hx₂' : x₂ ≫ q = 0 := hx₂
    have hu0 : x₂ ≫ adj.unit.app (wcFreeSheaf Y V) = 0 := by
      apply (cancel_mono ((wcProEtPush i).map ζ.hom)).mp
      rw [Limits.zero_comp, Category.assoc, ← hg₁', ← Category.assoc, hx₂', Limits.zero_comp]
    obtain ⟨T', p, h', hp, hph⟩ := wc_proet_closed_free_unit_exact i L adj O hO V A x₂ hu0
    exact ⟨T', p, hp, h', hph⟩
  exact ⟨w, ShortComplex.ShortExact.mk' hexact hmono hepi⟩

theorem wc_sdpu_global_equation (k : Type u) [Field k] {Y Z : Scheme.{u}}
    (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) :
    ∃ f : Γ(V.left, ⊤), V.left.basicOpen f = V.hom ⁻¹ᵁ O :=
by
  classical
  haveI : IsAffine V.left := h1


  have s1 : ∀ (W : Y.Opens) (_hW : IsAffine (W : Scheme.{u})) (_hi : IsClosedImmersion (i ∣_ W))
      (a : Γ(W, ⊤)), RingHom.ker (i ∣_ W).appTop.hom = Ideal.span {a} →
      Y.basicOpen (W.topIso.hom a) = W ⊓ O := by
    intro W _ _ a hker
    have hpt : ∀ t, W.ι ((i ∣_ W) t) = i ((i ⁻¹ᵁ W).ι t) := fun t => by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι]
    have hWr : ∀ y : Y, y ∈ W ↔ ∃ w, W.ι w = y := by
      intro y
      have := W.range_ι
      constructor
      · intro hy
        have hy' : y ∈ Set.range W.ι := by rw [this]; exact hy
        exact hy'
      · intro hy
        have hy' : y ∈ Set.range W.ι := hy
        rw [this] at hy'
        exact hy'
    have hmem : ∀ w, w ∈ Set.range (i ∣_ W) ↔ W.ι w ∈ Set.range i := by
      intro w
      constructor
      · rintro ⟨t, rfl⟩
        exact ⟨_, (hpt t).symm⟩
      · rintro ⟨z, hz⟩
        have hzW : z ∈ Set.range (i ⁻¹ᵁ W).ι := by
          rw [Scheme.Opens.range_ι]
          show i z ∈ W
          rw [hz, hWr]; exact ⟨w, rfl⟩
        obtain ⟨t, ht⟩ := hzW
        refine ⟨t, W.ι.isOpenEmbedding.injective ?_⟩
        rw [hpt, ht, hz]
    have hrange : Set.range (i ∣_ W) = (((W : Scheme.{u}).basicOpen a : Set W))ᶜ := by
      have h1' : ((Scheme.Hom.ker (i ∣_ W)).support : Set W) = Set.range (i ∣_ W) := by
        rw [Scheme.Hom.support_ker, (i ∣_ W).isClosedEmbedding.isClosed_range.closure_eq]
      have h2' := Scheme.IdealSheafData.coe_support_inter (Scheme.Hom.ker (i ∣_ W))
        ⟨⊤, isAffineOpen_top (W : Scheme.{u})⟩
      rw [Scheme.Hom.ker_apply] at h2'
      have h3' : RingHom.ker ((i ∣_ W).app ⊤).hom = Ideal.span {a} := hker
      simp only [h3', Scheme.zeroLocus_span, Scheme.zeroLocus_singleton,
        TopologicalSpace.Opens.coe_top, Set.inter_univ, h1'] at h2'
      exact h2'
    have e1 := Scheme.Opens.ι_image_basicOpen_topIso_inv W (W.topIso.hom a)
    rw [Iso.hom_inv_id_apply] at e1
    rw [← e1]
    apply SetLike.coe_injective
    rw [Scheme.Hom.coe_image, TopologicalSpace.Opens.coe_inf, hO]
    ext y
    constructor
    · rintro ⟨w, hw, rfl⟩
      refine ⟨(hWr _).mpr ⟨w, rfl⟩, ?_⟩
      intro hyi
      have : w ∈ Set.range (i ∣_ W) := (hmem w).mpr hyi
      rw [hrange] at this
      exact this hw
    · rintro ⟨hyW, hyO⟩
      obtain ⟨w, rfl⟩ := (hWr y).mp hyW
      refine ⟨w, ?_, rfl⟩
      by_contra hc
      have : w ∈ Set.range (i ∣_ W) := by
        rw [hrange]; exact hc
      exact hyO ((hmem _).mp this)

  have s2 : ∀ {X : Type u} [TopologicalSpace X] [CompactSpace X]
      (_hcl : ∀ z : X, IsClosed ({z} : Set X) → ∀ U : Set X, IsOpen U → z ∈ U →
        ∃ C : Set X, IsClopen C ∧ z ∈ C ∧ C ⊆ U)
      (_hu : ∀ x : X, ∃ z : X, IsClosed ({z} : Set X) ∧ x ⤳ z)
      (N : X → Set X) (_hN : ∀ x, IsOpen (N x)) (_hxN : ∀ x, x ∈ N x),
      ∃ (n : ℕ) (C : Fin n → Set X) (c : Fin n → X), (∀ k, IsClopen (C k)) ∧
        (∀ j k, j ≠ k → Disjoint (C j) (C k)) ∧ (∀ x, ∃ k, x ∈ C k) ∧
        ∀ k, C k ⊆ N (c k) := by
    intro X _ _ hcl hu N hN hxN
    choose z hz hxz using hu
    choose E hE hzE hEN using fun x => hcl (z x) (hz x) (N (z x)) (hN _) (hxN _)
    have hxE : ∀ x, x ∈ E x := fun x => (hxz x).mem_open (hE x).isOpen (hzE x)
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover E (fun x => (hE x).isOpen)
      (fun x _ => Set.mem_iUnion.mpr ⟨x, hxE x⟩)
    let e := t.equivFin.symm
    let B : Fin t.card → Set X := fun k => E (e k)
    refine ⟨t.card, fun k => B k \ ⋃ j ∈ Finset.univ.filter (· < k), B j, fun k => z (e k),
      ?_, ?_, ?_, ?_⟩
    · intro k
      exact (hE _).diff (isClopen_biUnion_finset (fun j _ => hE _))
    · intro j k hjk
      rw [Set.disjoint_left]
      rcases lt_or_gt_of_ne hjk with h | h
      · intro x hxj hxk
        exact hxk.2 (Set.mem_biUnion (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩) hxj.1)
      · intro x hxj hxk
        exact hxj.2 (Set.mem_biUnion (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩) hxk.1)
    · intro x
      have hx := ht (Set.mem_univ x)
      simp only [Set.mem_iUnion] at hx
      obtain ⟨t₀, ht₀, hxt₀⟩ := hx
      have hS : (Finset.univ.filter (fun k => x ∈ B k)).Nonempty :=
        ⟨e.symm ⟨t₀, ht₀⟩, by simp [B, hxt₀]⟩
      refine ⟨(Finset.univ.filter (fun k => x ∈ B k)).min' hS, ?_, ?_⟩
      · exact (Finset.mem_filter.mp (Finset.min'_mem _ hS)).2
      · intro hmem
        simp only [Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ, true_and] at hmem
        obtain ⟨j, hj, hxj⟩ := hmem
        have := Finset.min'_le (Finset.univ.filter (fun k => x ∈ B k)) j
          (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxj⟩)
        exact absurd hj (not_lt.mpr this)
    · intro k
      exact Set.sdiff_subset.trans (hEN _)

  have s3 : ∀ (X : Scheme.{u}) (U : X.Opens) (n : ℕ) (C : Fin n → X.Opens)
      (_hdisj : ∀ j k, j ≠ k → C j ⊓ C k = ⊥) (_hcov : ∀ x : X, ∃ k, x ∈ C k)
      (τ : ∀ k, Γ(X, C k)) (_hτ : ∀ k, X.basicOpen (τ k) = C k ⊓ U),
      ∃ f : Γ(X, ⊤), X.basicOpen f = U := by
    intro X U n C hdisj hcov τ hτ
    have hcompat : TopCat.Presheaf.IsCompatible X.sheaf.obj C τ := by
      intro j k
      by_cases hjk : j = k
      · subst hjk; rfl
      · apply TopCat.Presheaf.section_ext X.sheaf
        intro x hx
        exfalso
        have : x ∈ C j ⊓ C k := hx
        rw [hdisj j k hjk] at this
        exact this
    have hcover : (⊤ : X.Opens) ≤ iSup C := by
      intro x _
      obtain ⟨k, hk⟩ := hcov x
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hk⟩
    obtain ⟨f, hf, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf C ⊤ (fun k => homOfLE le_top)
      hcover τ hcompat
    refine ⟨f, ?_⟩
    have key : ∀ k, C k ⊓ X.basicOpen f = C k ⊓ U := by
      intro k
      rw [← hτ k, ← hf k]
      exact (Scheme.basicOpen_res X f (homOfLE le_top).op).symm
    ext x
    obtain ⟨k, hk⟩ := hcov x
    constructor
    · intro hx
      have : x ∈ C k ⊓ X.basicOpen f := ⟨hk, hx⟩
      rw [key k] at this
      exact this.2
    · intro hx
      have : x ∈ C k ⊓ U := ⟨hk, hx⟩
      rw [← key k] at this
      exact this.2

  have hY : ∀ y : Y, ∃ W : Y.Opens, y ∈ W ∧ ∃ r : Γ(Y, W), Y.basicOpen r = W ⊓ O := by
    intro y
    by_cases hy : y ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hy
      haveI inst : SmoothOfRelativeDimension (d + 1 - 1) (i ≫ pY) :=
        ‹SmoothOfRelativeDimension d (i ≫ pY)›
      obtain ⟨W, -, hzW, h, hcut⟩ := wc_smooth_pair_local_cutout k Y Z pY (d + 1) 1 i
        (by omega) z
      obtain ⟨hWa, hci, hker⟩ := hcut
      have hker' : RingHom.ker (i ∣_ W).appTop.hom = Ideal.span {h 0} := by
        rw [hker, Set.range_unique] <;> rfl
      exact ⟨W, hzW, _, s1 W hWa hci (h 0) hker'⟩
    · have hyO : y ∈ O := by
        show y ∈ (O : Set Y)
        rw [hO]; exact hy
      exact ⟨O, hyO, 1, by rw [Scheme.basicOpen_one, inf_idem]⟩

  have hX : ∀ x : V.left, ∃ N : V.left.Opens, x ∈ N ∧
      ∃ τ : Γ(V.left, N), V.left.basicOpen τ = N ⊓ V.hom ⁻¹ᵁ O := by
    intro x
    obtain ⟨W, hyW, r, hr⟩ := hY (V.hom x)
    refine ⟨V.hom ⁻¹ᵁ W, hyW, V.hom.app W r, ?_⟩
    rw [← Scheme.preimage_basicOpen]
    change V.hom ⁻¹ᵁ Y.basicOpen r = _
    rw [hr, Scheme.Hom.preimage_inf]
  choose N hxN τ hτ using hX

  obtain ⟨n, C, c, hCcl, hCdisj, hCcov, hCsub⟩ := s2 (X := V.left)
    (fun z hz U hU hzU => wc_wlocal_clopen_nbhd_in_open V.left h2 h3 z hz U hU hzU)
    (fun x => (h3 x).exists) (fun x => (N x : Set V.left)) (fun x => (N x).isOpen) hxN

  let C' : Fin n → V.left.Opens := fun k => ⟨C k, (hCcl k).isOpen⟩
  have hsub : ∀ k, C' k ≤ N (c k) := fun k => hCsub k
  let τ' : ∀ k, Γ(V.left, C' k) := fun k =>
    V.left.presheaf.map (homOfLE (hsub k)).op (τ (c k))
  have hτ' : ∀ k, V.left.basicOpen (τ' k) = C' k ⊓ V.hom ⁻¹ᵁ O := by
    intro k
    show V.left.basicOpen (V.left.presheaf.map (homOfLE (hsub k)).op (τ (c k))) = _
    rw [Scheme.basicOpen_res, hτ, ← inf_assoc, inf_of_le_left (hsub k)]
  have hdisj : ∀ j k, j ≠ k → C' j ⊓ C' k = ⊥ := by
    intro j k hjk
    apply SetLike.coe_injective
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_bot]
    exact Set.disjoint_iff_inter_eq_empty.mp (hCdisj j k hjk)

  exact s3 V.left _ n C' hdisj hCcov τ' hτ'

theorem wc_sdpu_pic_spread_generator (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Invertible R M] (T : Submonoid R) (S : Type u) [CommRing S]
    [Algebra R S] [IsLocalization T S] (hS : Subsingleton (CommRing.Pic S)) :
    ∃ ρ ∈ T, ∃ μ : M, (∀ y : M, ∃ (N : ℕ) (b : R), ρ ^ N • y = b • μ) ∧
      (∀ b : R, b • μ = 0 → ∃ N : ℕ, ρ ^ N * b = 0) :=
by
  classical
  by_cases h0 : (0 : R) ∈ T
  · exact ⟨0, h0, 0, fun y => ⟨1, 0, by simp⟩, fun b _ => ⟨1, by simp⟩⟩
  haveI : Nontrivial S := by
    rw [← not_subsingleton_iff_nontrivial]
    intro hsub
    have h1 : algebraMap R S 1 = algebraMap R S 0 := Subsingleton.elim _ _
    obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := T) h1
    rw [mul_one, mul_zero] at hc
    exact h0 (hc ▸ c.2)
  let φ : M →ₗ[R] TensorProduct R S M := TensorProduct.mk R S M 1
  haveI hloc : IsLocalizedModule T φ :=
    (isLocalizedModule_iff_isBaseChange T S φ).mpr (TensorProduct.isBaseChange R M S)
  haveI : Module.Invertible S (TensorProduct R S M) := Module.Invertible.of_isLocalization T φ
  haveI := hS
  haveI : Module.Free S (TensorProduct R S M) := inferInstance
  have hrk : Module.finrank S (TensorProduct R S M) = 1 := Module.Invertible.finrank_eq_one S _
  haveI : Module.FinitePresentation R M := Module.finitePresentation_of_projective R M
  obtain ⟨r, hrT, hfree, hrank⟩ :=
    Module.FinitePresentation.exists_free_localizedModule_powers T φ S
  rw [hrk] at hrank
  refine ⟨r, hrT, ?_⟩
  haveI : Nontrivial (Localization (Submonoid.powers r)) := by
    rw [← not_subsingleton_iff_nontrivial]
    intro hsub
    have h1 : algebraMap R (Localization (Submonoid.powers r)) 1 =
        algebraMap R (Localization (Submonoid.powers r)) 0 := Subsingleton.elim _ _
    obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers r) h1
    rw [mul_one, mul_zero] at hc
    obtain ⟨N, hN⟩ := c.2
    apply h0
    rw [← hc, ← hN]
    exact pow_mem hrT N
  haveI := commRing_strongRankCondition (Localization (Submonoid.powers r))
  haveI : Module.Finite (Localization (Submonoid.powers r)) (LocalizedModule.Away r M) :=
    Module.finite_of_finrank_pos (by rw [hrank]; norm_num)
  let β := Module.finBasisOfFinrankEq _ _ hrank
  obtain ⟨μ, s, hs⟩ : ∃ (μ : M) (s : Submonoid.powers r), β 0 = LocalizedModule.mk μ s := by
    induction β 0 using LocalizedModule.induction_on with
    | h m s => exact ⟨m, s, rfl⟩
  obtain ⟨k, hk⟩ := s.2
  refine ⟨μ, ?_, ?_⟩
  · intro y
    have hy : (LocalizedModule.mk y (1 : Submonoid.powers r) : LocalizedModule.Away r M) =
        β.repr (LocalizedModule.mk y 1) 0 • β 0 := by
      conv_lhs => rw [← β.sum_repr (LocalizedModule.mk y 1)]
      rw [Fin.sum_univ_one]
    obtain ⟨b, t, hc⟩ : ∃ (b : R) (t : Submonoid.powers r),
        β.repr (LocalizedModule.mk y 1) 0 = Localization.mk b t := by
      induction β.repr (LocalizedModule.mk y 1) 0 using Localization.induction_on with
      | H x => exact ⟨x.1, x.2, rfl⟩
    rw [hc, hs, LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq] at hy
    obtain ⟨u, hu⟩ := hy
    obtain ⟨i, hi⟩ := u.2
    obtain ⟨j, hj⟩ := t.2
    simp only [Submonoid.smul_def, one_smul, smul_smul, Submonoid.coe_mul] at hu
    rw [← hi, ← hj, ← hk] at hu
    refine ⟨i + j + k, r ^ i * b, ?_⟩
    rw [← hu, pow_add, pow_add, mul_assoc]
  · intro b hb
    have h1 : (Localization.mk b 1 : Localization (Submonoid.powers r)) • β 0 = 0 := by
      rw [hs, LocalizedModule.mk_smul_mk, hb, LocalizedModule.zero_mk]
    have h2 := congrArg (fun x => β.repr x 0) h1
    simp only [map_smul, Finsupp.smul_apply, Module.Basis.repr_self, Finsupp.single_eq_same,
      smul_eq_mul, mul_one, map_zero, Finsupp.coe_zero, Pi.zero_apply] at h2
    rw [Localization.mk_one_eq_algebraMap, IsLocalization.map_eq_zero_iff (Submonoid.powers r)] at h2
    obtain ⟨m, hm⟩ := h2
    obtain ⟨N, hN⟩ := m.2
    refine ⟨N, ?_⟩
    have hN' : r ^ N = (m : R) := hN
    rw [hN']
    exact hm

theorem wc_sdpu_idempotent_glue_free (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M]
    [Module R M] (n : ℕ) (e ρ γ : Fin n → R) (μ : Fin n → M)
    (he : ∀ k, IsIdempotentElem (e k)) (horth : ∀ k l, k ≠ l → e k * e l = 0)
    (hsum : ∑ k, e k = 1) (hfac : ∀ k, e k = γ k * ρ k)
    (hgen : ∀ k (y : M), ∃ (N : ℕ) (b : R), ρ k ^ N • y = b • μ k)
    (htf : ∀ k (b : R), b • μ k = 0 → ∃ N : ℕ, ρ k ^ N * b = 0) : Module.Free R M :=
by
  classical
  set m : M := ∑ k, e k • μ k with hm
  have F1 : ∀ (r : R) (k : Fin n), (r * e k) • m = (r * e k) • μ k := by
    intro r k
    rw [hm, Finset.smul_sum, Fintype.sum_eq_single k]
    · rw [smul_smul, mul_assoc, (he k).eq]
    · intro l hl
      rw [smul_smul, mul_assoc, horth k l (Ne.symm hl), mul_zero, zero_smul]
  have F2 : ∀ (k : Fin n) (N : ℕ), e k = (γ k ^ (N + 1) * ρ k) * ρ k ^ N := by
    intro k N
    calc e k = e k ^ (N + 1) := ((he k).pow_succ_eq N).symm
      _ = (γ k * ρ k) ^ (N + 1) := by rw [← hfac k]
      _ = _ := by ring
  have F3 : ∀ b : R, b = ∑ k, e k * b := by
    intro b
    rw [← Finset.sum_mul, hsum, one_mul]
  have inj : ∀ b : R, b • m = 0 → b = 0 := by
    intro b hb
    have hk : ∀ k, e k * b = 0 := by
      intro k
      have h1 : (b * e k) • μ k = 0 := by
        rw [← F1 b k, mul_comm, ← smul_smul, hb, smul_zero]
      obtain ⟨N, hN⟩ := htf k _ h1
      have h2 := F2 k N
      have h3 := (he k).eq
      calc e k * b = (b * e k) * e k := by linear_combination (-b) * h3
        _ = (b * e k) * ((γ k ^ (N + 1) * ρ k) * ρ k ^ N) := by rw [← h2]
        _ = (γ k ^ (N + 1) * ρ k) * (ρ k ^ N * (b * e k)) := by ring
        _ = 0 := by rw [hN, mul_zero]
    rw [F3 b]
    exact Finset.sum_eq_zero (fun k _ => hk k)
  have surj : ∀ y : M, ∃ b : R, b • m = y := by
    intro y
    choose N b hb using fun k => hgen k y
    refine ⟨∑ k, (γ k ^ (N k + 1) * ρ k) * b k * e k, ?_⟩
    rw [Finset.sum_smul]
    calc ∑ k, ((γ k ^ (N k + 1) * ρ k) * b k * e k) • m
        = ∑ k, e k • y := by
          refine Finset.sum_congr rfl (fun k _ => ?_)
          have h2 := F2 k (N k)
          have h3 := (he k).eq
          rw [F1, show (γ k ^ (N k + 1) * ρ k) * b k * e k
              = (e k * (γ k ^ (N k + 1) * ρ k)) * b k by ring, mul_smul, ← hb k, smul_smul,
            show e k * (γ k ^ (N k + 1) * ρ k) * ρ k ^ N k = e k by
              linear_combination (-(e k)) * h2 + h3]
      _ = y := by rw [← Finset.sum_smul, hsum, one_smul]
  let φ := LinearMap.toSpanSingleton R M m
  have hφ : Function.Bijective φ := by
    constructor
    · intro a c hac
      simp only [φ, LinearMap.toSpanSingleton_apply] at hac
      have := inj (a - c) (by rw [sub_smul, hac, sub_self])
      exact sub_eq_zero.mp this
    · intro y
      obtain ⟨b, hb⟩ := surj y
      exact ⟨b, by simp only [φ, LinearMap.toSpanSingleton_apply, hb]⟩
  exact Module.Free.of_equiv' (Module.Free.self R) (LinearEquiv.ofBijective φ hφ)

theorem wc_sdpu_wlocal_clopen_refinement (X : Scheme.{u}) (h1 : IsAffine X)
    (h2 : IsClosed {x : X | IsClosed ({x} : Set X)})
    (h3 : ∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y) (P : Γ(X, ⊤) → Prop)
    (hP : ∀ z : X, IsClosed ({z} : Set X) → ∃ a : Γ(X, ⊤), z ∈ X.basicOpen a ∧ P a) :
    ∃ (n : ℕ) (W : Fin n → Set X) (a : Fin n → Γ(X, ⊤)), (∀ k, IsClopen (W k)) ∧
      (∀ k l, k ≠ l → Disjoint (W k) (W l)) ∧ (⋃ k, W k) = Set.univ ∧
      (∀ k, W k ⊆ (X.basicOpen (a k) : Set X)) ∧ (∀ k, P (a k)) :=
by
  classical
  haveI := h1
  choose a₀ hza hPa using fun z : {z : X // IsClosed ({z} : Set X)} => hP z.1 z.2
  choose V hVc hzV hVa using fun z : {z : X // IsClosed ({z} : Set X)} =>
    wc_wlocal_clopen_nbhd_in_open X h2 h3 z.1 z.2 (X.basicOpen (a₀ z) : Set X)
      (X.basicOpen (a₀ z)).isOpen (hza z)
  have hcov : Set.univ ⊆ ⋃ z : {z : X // IsClosed ({z} : Set X)}, V z := by
    intro x _
    obtain ⟨y, ⟨hy, hxy⟩, _⟩ := h3 x
    exact Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hxy.mem_open (hVc ⟨y, hy⟩).isOpen (hzV ⟨y, hy⟩)⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover V (fun z => (hVc z).isOpen) hcov
  let e := t.equivFin
  let U : Fin t.card → Set X := fun k => V (e.symm k).1
  have hU : ∀ k, IsClopen (U k) := fun k => hVc _
  have hUcov : (⋃ k, U k) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro x
    have hx := ht (Set.mem_univ x)
    obtain ⟨z, hz, hxz⟩ := Set.mem_iUnion₂.mp hx
    refine Set.mem_iUnion.mpr ⟨e ⟨z, hz⟩, ?_⟩
    show x ∈ V (e.symm (e ⟨z, hz⟩)).1
    rw [Equiv.symm_apply_apply]
    exact hxz
  refine ⟨t.card, disjointed U, fun k => a₀ (e.symm k).1, ?_, ?_, ?_, ?_, ?_⟩
  · intro k
    rw [disjointed_apply, Finset.sup_set_eq_biUnion]
    exact (hU k).diff (isClopen_biUnion_finset fun j _ => hU j)
  · intro k l hkl
    exact disjoint_disjointed U hkl
  · exact iUnion_disjointed.trans hUcov
  · intro k
    exact (disjointed_le U k).trans (hVa _)
  · intro k
    exact hPa _

theorem wc_sdpu_affine_clopen_partition_idempotents (X : Scheme.{u}) [IsAffine X] (n : ℕ)
    (W : Fin n → Set X) (hW : ∀ k, IsClopen (W k))
    (hdisj : ∀ k l, k ≠ l → Disjoint (W k) (W l)) (hcov : (⋃ k, W k) = Set.univ) :
    ∃ e : Fin n → Γ(X, ⊤), (∀ k, IsIdempotentElem (e k)) ∧
      (∀ k l, k ≠ l → e k * e l = 0) ∧ (∑ k, e k = 1) ∧
      ∀ (k : Fin n) (a : Γ(X, ⊤)), W k ⊆ (X.basicOpen a : Set X) → ∃ γ : Γ(X, ⊤), e k = γ * a :=
by
  classical

  have LA : ∀ (R : Type u) [CommRing R] (s : Fin n → Set (PrimeSpectrum R)),
      (∀ k, IsClopen (s k)) → (∀ k l, k ≠ l → Disjoint (s k) (s l)) → (⋃ k, s k) = Set.univ →
      ∃ e : Fin n → R, (∀ k, IsIdempotentElem (e k)) ∧ (∀ k l, k ≠ l → e k * e l = 0) ∧
        (∑ k, e k = 1) ∧
        ∀ k, s k = ((PrimeSpectrum.basicOpen (e k) : TopologicalSpace.Opens (PrimeSpectrum R)) :
          Set (PrimeSpectrum R)) := by
    intro R _ s hs hd hc
    choose e he hse using fun k => PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen (hs k)
    have horth : ∀ k l, k ≠ l → e k * e l = 0 := by
      intro k l hkl
      apply IsIdempotentElem.eq_zero_of_isNilpotent ((he k).mul (he l))
      rw [← PrimeSpectrum.basicOpen_eq_bot_iff, eq_bot_iff]
      intro q hq
      rw [PrimeSpectrum.mem_basicOpen] at hq
      have h1 : q ∈ s k := by
        rw [hse k]
        exact (PrimeSpectrum.mem_basicOpen _ _).mpr (fun h => hq (q.asIdeal.mul_mem_right _ h))
      have h2 : q ∈ s l := by
        rw [hse l]
        exact (PrimeSpectrum.mem_basicOpen _ _).mpr (fun h => hq (q.asIdeal.mul_mem_left _ h))
      exact (Set.disjoint_left.mp (hd k l hkl) h1 h2).elim
    have hproj : ∀ k, e k * ∑ l, e l = e k := by
      intro k
      rw [Finset.mul_sum, Finset.sum_eq_single k]
      · exact he k
      · intro l _ hlk
        exact horth k l (Ne.symm hlk)
      · intro h
        exact absurd (Finset.mem_univ k) h
    have hσi : IsIdempotentElem (∑ l, e l) := by
      show (∑ l, e l) * (∑ l, e l) = ∑ l, e l
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl (fun k _ => hproj k)
    have hz : 1 - ∑ l, e l = 0 := by
      apply IsIdempotentElem.eq_zero_of_isNilpotent hσi.one_sub
      rw [← PrimeSpectrum.basicOpen_eq_bot_iff, eq_bot_iff]
      intro q hq
      rw [PrimeSpectrum.mem_basicOpen] at hq
      have hq' : q ∈ ⋃ k, s k := by rw [hc]; trivial
      obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hq'
      rw [hse k] at hk
      have hek : e k ∉ q.asIdeal := (PrimeSpectrum.mem_basicOpen _ _).mp hk
      have hprod : e k * (1 - ∑ l, e l) = 0 := by rw [mul_sub, mul_one, hproj k, sub_self]
      have hmem : e k * (1 - ∑ l, e l) ∈ q.asIdeal := by rw [hprod]; exact q.asIdeal.zero_mem
      rcases q.isPrime.mem_or_mem hmem with h | h
      · exact (hek h).elim
      · exact (hq h).elim
    exact ⟨e, he, horth, (sub_eq_zero.mp hz).symm, hse⟩

  have LB : ∀ (e a : Γ(X, ⊤)), IsIdempotentElem e →
      PrimeSpectrum.basicOpen e ≤ PrimeSpectrum.basicOpen a → ∃ γ : Γ(X, ⊤), e = γ * a := by
    intro e a he hle
    obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp ((PrimeSpectrum.basicOpen_le_basicOpen_iff e a).mp hle)
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hN
    refine ⟨c * e, ?_⟩
    calc e = e ^ (N + 1) := (he.pow_succ_eq N).symm
      _ = e ^ N * e := pow_succ e N
      _ = c * a * e := by rw [hc]
      _ = c * e * a := by ring

  let h : X ≃ₜ Spec Γ(X, ⊤) := Scheme.homeoOfIso X.isoSpec
  have hT : ∀ (g : Γ(X, ⊤)) (x : X), x ∈ X.basicOpen g →
      (h x : PrimeSpectrum Γ(X, ⊤)) ∈ PrimeSpectrum.basicOpen g := by
    intro g x hx
    rw [← Scheme.toSpecΓ_preimage_basicOpen X g] at hx
    have : h x = X.toSpecΓ x := by
      simp only [h, Scheme.homeoOfIso_apply, Scheme.isoSpec_hom]
    rw [this]
    exact hx
  let s : Fin n → Set (PrimeSpectrum Γ(X, ⊤)) := fun k => (h.symm ⁻¹' W k : Set _)
  have hs : ∀ k, IsClopen (s k) := fun k => (hW k).preimage h.symm.continuous
  have hsd : ∀ k l, k ≠ l → Disjoint (s k) (s l) := fun k l hkl => (hdisj k l hkl).preimage h.symm
  have hsc : (⋃ k, s k) = Set.univ := by
    show (⋃ k, h.symm ⁻¹' W k) = Set.univ
    rw [← Set.preimage_iUnion, hcov, Set.preimage_univ]
  obtain ⟨e, he, horth, hsum, hbo⟩ := LA Γ(X, ⊤) s hs hsd hsc
  refine ⟨e, he, horth, hsum, ?_⟩
  intro k a hka
  apply LB (e k) a (he k)
  intro q hq
  have h1 : h.symm q ∈ W k := by
    have : q ∈ s k := by rw [hbo k]; exact hq
    exact this
  have h3 := hT a (h.symm q) (hka h1)
  have e : (h (h.symm q) : PrimeSpectrum Γ(X, ⊤)) = q := h.apply_symm_apply q
  rw [e] at h3
  exact h3

theorem wc_sdpu_away_localization_commute (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (Q : Submonoid A) [IsLocalization Q B] (f : A) :
    ∃ _ : Algebra (Localization.Away f) (Localization.Away (algebraMap A B f)),
      IsLocalization (Algebra.algebraMapSubmonoid (Localization.Away f) Q)
        (Localization.Away (algebraMap A B f)) :=
by
  letI : Algebra (Localization.Away f) (Localization.Away (algebraMap A B f)) :=
    (Localization.awayMap (algebraMap A B) f).toAlgebra
  haveI : IsScalarTower A (Localization.Away f) (Localization.Away (algebraMap A B f)) := by
    refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
    rw [RingHom.algebraMap_toAlgebra]
    show _ = IsLocalization.map _ (algebraMap A B) _ (algebraMap A (Localization.Away f) x)
    rw [IsLocalization.map_eq, ← IsScalarTower.algebraMap_apply]
  haveI : IsLocalization (Algebra.algebraMapSubmonoid B (Submonoid.powers f))
      (Localization.Away (algebraMap A B f)) := by
    rw [Algebra.algebraMapSubmonoid_powers]
    infer_instance
  exact ⟨inferInstance, IsLocalization.commutes (Localization.Away f) B
    (Localization.Away (algebraMap A B f)) (Submonoid.powers f) Q⟩

theorem wc_sdpu_wlocal_pic_local_global_scheme (X : Scheme.{u}) (h1 : IsAffine X)
    (h2 : IsClosed {x : X | IsClosed ({x} : Set X)})
    (h3 : ∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y) (f : Γ(X, ⊤))
    (hloc : ∀ x : X, IsClosed ({x} : Set X) →
      Subsingleton (CommRing.Pic (Localization.Away ((X.presheaf.germ ⊤ x trivial).hom f)))) :
    Subsingleton (CommRing.Pic (Localization.Away f)) :=
by
  classical
  haveI := h1
  rw [CommRing.Pic.subsingleton_iff]
  intro M _ _ hM
  haveI := hM

  have hP : ∀ z : X, IsClosed ({z} : Set X) → ∃ a : Γ(X, ⊤), z ∈ X.basicOpen a ∧
      ∃ μ : M, (∀ y : M, ∃ (N : ℕ) (b : Localization.Away f),
        (algebraMap Γ(X, ⊤) (Localization.Away f) a) ^ N • y = b • μ) ∧
      (∀ b : Localization.Away f, b • μ = 0 →
        ∃ N : ℕ, (algebraMap Γ(X, ⊤) (Localization.Away f) a) ^ N * b = 0) := by
    intro z hz
    letI : Algebra Γ(X, ⊤) (X.presheaf.stalk z) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨z, trivial⟩ : (⊤ : X.Opens))
    haveI hst : IsLocalization.AtPrime (X.presheaf.stalk z)
        ((isAffineOpen_top X).primeIdealOf ⟨z, trivial⟩).asIdeal :=
      IsAffineOpen.isLocalization_stalk (isAffineOpen_top X) ⟨z, trivial⟩
    obtain ⟨inst, hcomm⟩ := wc_sdpu_away_localization_commute Γ(X, ⊤) (X.presheaf.stalk z)
      ((isAffineOpen_top X).primeIdealOf ⟨z, trivial⟩).asIdeal.primeCompl f
    have hS : Subsingleton (CommRing.Pic
        (Localization.Away (algebraMap Γ(X, ⊤) (X.presheaf.stalk z) f))) := hloc z hz
    obtain ⟨ρ, hρ, μ, hgen, htf⟩ := wc_sdpu_pic_spread_generator (Localization.Away f) M
      (Algebra.algebraMapSubmonoid (Localization.Away f)
        ((isAffineOpen_top X).primeIdealOf ⟨z, trivial⟩).asIdeal.primeCompl)
      (Localization.Away (algebraMap Γ(X, ⊤) (X.presheaf.stalk z) f)) hS
    obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hρ
    refine ⟨a, ?_, μ, hgen, htf⟩
    rw [Scheme.mem_basicOpen_top]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk z) _ a).mpr ha

  obtain ⟨n, W, a, hWc, hWd, hWu, hWa, hPa⟩ := wc_sdpu_wlocal_clopen_refinement X h1 h2 h3
    (fun a => ∃ μ : M, (∀ y : M, ∃ (N : ℕ) (b : Localization.Away f),
        (algebraMap Γ(X, ⊤) (Localization.Away f) a) ^ N • y = b • μ) ∧
      (∀ b : Localization.Away f, b • μ = 0 →
        ∃ N : ℕ, (algebraMap Γ(X, ⊤) (Localization.Away f) a) ^ N * b = 0)) hP
  obtain ⟨e, he, horth, hsum, hfac⟩ :=
    wc_sdpu_affine_clopen_partition_idempotents X n W hWc hWd hWu
  choose γ hγ using fun k => hfac k (a k) (hWa k)
  choose μ hgen htf using hPa

  exact wc_sdpu_idempotent_glue_free (Localization.Away f) M n
    (fun k => algebraMap Γ(X, ⊤) (Localization.Away f) (e k))
    (fun k => algebraMap Γ(X, ⊤) (Localization.Away f) (a k))
    (fun k => algebraMap Γ(X, ⊤) (Localization.Away f) (γ k)) μ
    (fun k => (he k).map _)
    (fun k l hkl => by
      rw [← map_mul, horth k l hkl, map_zero])
    (by rw [← map_sum, hsum, map_one])
    (fun k => by
      rw [hγ k, map_mul])
    hgen htf

theorem wc_sdpu_affine_units_ext_one_vanish (S : Scheme.{u})
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (U : S.ProEt) (hU : IsAffine U.left) (hpic : Subsingleton (CommRing.Pic Γ(U.left, ⊤)))
    (y : Abelian.Ext (wcFreeSheaf S U)
      (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) 1) : y = 0 :=
by
  classical

  let E : ∀ W : S.ProEt, (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj.obj
      (Opposite.op W) → (Γ(W.left, ⊤))ˣ := fun W x => Additive.toMul (ULift.down x)
  have hEinj : ∀ (W : S.ProEt) (x x' : (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S)
      AddCommGrpCat.{u+1}).obj.obj (Opposite.op W)), E W x = E W x' → x = x' := by
    intro W x x' h
    exact congrArg (fun v => (ULift.up (Additive.ofMul v) : (⟨_, hG⟩ : Sheaf
      (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj.obj (Opposite.op W))) h
  have hEsurj : ∀ (W : S.ProEt) (v : (Γ(W.left, ⊤))ˣ), ∃ x, E W x = v :=
    fun W v => ⟨(ULift.up (Additive.ofMul v) : (⟨_, hG⟩ : Sheaf
      (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj.obj (Opposite.op W)), rfl⟩
  have hEadd : ∀ (W : S.ProEt) (x x' : (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S)
      AddCommGrpCat.{u+1}).obj.obj (Opposite.op W)), E W (x + x') = E W x * E W x' :=
    fun W x x' => rfl
  have hEsub : ∀ (W : S.ProEt) (x x' : (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S)
      AddCommGrpCat.{u+1}).obj.obj (Opposite.op W)), E W (x - x') = E W x / E W x' :=
    fun W x x' => rfl
  have hE0 : ∀ (W : S.ProEt), E W 0 = 1 := fun W => rfl
  have hEmap : ∀ (W W' : S.ProEt) (g : W' ⟶ W) (x : (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S)
      AddCommGrpCat.{u+1}).obj.obj (Opposite.op W)),
      E W' ((⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj.map g.op x) =
        Units.map g.left.appTop.hom.toMonoidHom (E W x) := fun W W' g x => rfl

  have L2 : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] [Module.FaithfullyFlat A C]
      (z : C), ((1 : C) ⊗ₜ[A] z : TensorProduct A C C) = z ⊗ₜ[A] (1 : C) →
      ∃ a : A, algebraMap A C a = z := by
    intro A C _ _ _ _ z hz
    let f : A →ₗ[A] C := Algebra.linearMap A C
    let g : C →ₗ[A] TensorProduct A C C :=
      TensorProduct.mk A C C 1 - (TensorProduct.mk A C C).flip 1
    have hex : Function.Exact f g := by
      rw [← Module.FaithfullyFlat.lTensor_exact_iff_exact A C f g]
      let h : TensorProduct A C (TensorProduct A C C) →ₗ[A] TensorProduct A C C :=
        (LinearMap.mul' A C).rTensor C ∘ₗ (TensorProduct.assoc A C C C).symm.toLinearMap
      let k : TensorProduct A C C →ₗ[A] TensorProduct A C A :=
        (TensorProduct.mk A C A).flip 1 ∘ₗ LinearMap.mul' A C
      have key : h ∘ₗ g.lTensor C = LinearMap.id - f.lTensor C ∘ₗ k := by
        apply TensorProduct.ext'
        intro u w
        simp [h, k, g, f]
      have hgf : g ∘ₗ f = 0 := by
        ext
        simp [g, f]
      intro w
      constructor
      · intro hw
        refine ⟨k w, ?_⟩
        have e := congrArg (fun φ => φ w) key
        simp only [LinearMap.comp_apply, hw, map_zero, LinearMap.sub_apply,
          LinearMap.id_apply] at e
        exact (sub_eq_zero.mp e.symm).symm
      · rintro ⟨v, rfl⟩
        rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hgf]
        simp
    have hg : g z = 0 := by
      simp [g, hz]
    obtain ⟨a, ha⟩ := (hex z).mp hg
    exact ⟨a, ha⟩

  have L1 : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] [Module.FaithfullyFlat A C],
      Subsingleton (CommRing.Pic A) → ∀ (c : TensorProduct A C C), IsUnit c →
      (Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight c :
        TensorProduct A C (TensorProduct A C C)) =
        Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft c *
        Algebra.TensorProduct.includeRight c →
      ∃ m : C, IsUnit m ∧ ((1 : C) ⊗ₜ[A] m : TensorProduct A C C) = c * (m ⊗ₜ[A] (1 : C)) := by
    intro A C _ _ _ _ hpic c hc hcoc
    have heq := L2 A C
    have hloc := wc_ff_unit_cocycle_locally_trivial A C
    set cm : TensorProduct A C C := ((hc.unit⁻¹ : (TensorProduct A C C)ˣ) : TensorProduct A C C)
      with hcm_def
    have hccm : c * cm = 1 := hc.mul_val_inv
    have hcm_unit : IsUnit cm := (hc.unit⁻¹).isUnit
    have hcocm : (Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight cm :
          TensorProduct A C (TensorProduct A C C)) =
          Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft cm *
          Algebra.TensorProduct.includeRight cm := by
      have e1 : (Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight cm :
          TensorProduct A C (TensorProduct A C C)) *
          Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight c = 1 := by
        rw [← map_mul, mul_comm, hccm, map_one]
      have e2 : (Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft cm :
          TensorProduct A C (TensorProduct A C C)) *
          Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft c = 1 := by
        rw [← map_mul, mul_comm, hccm, map_one]
      have e3 : (Algebra.TensorProduct.includeRight cm : TensorProduct A C (TensorProduct A C C)) *
          Algebra.TensorProduct.includeRight c = 1 := by
        rw [← map_mul, mul_comm, hccm, map_one]
      linear_combination
        (-(Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight cm :
          TensorProduct A C (TensorProduct A C C))) * e2 +
        (-((Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight cm :
          TensorProduct A C (TensorProduct A C C)) *
          Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft cm *
          Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft c)) * e3 +
        ((Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft cm :
          TensorProduct A C (TensorProduct A C C)) *
          Algebra.TensorProduct.includeRight cm) * e1 -
        ((Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeRight cm :
          TensorProduct A C (TensorProduct A C C)) *
          Algebra.TensorProduct.map (AlgHom.id A C) Algebra.TensorProduct.includeLeft cm *
          Algebra.TensorProduct.includeRight cm) * hcoc
    let Lof : TensorProduct A C C → Submodule A C := fun e =>
      { carrier := {x | ((1 : C) ⊗ₜ[A] x : TensorProduct A C C) = e * (x ⊗ₜ[A] (1 : C))}
        add_mem' := by
          intro x y hx hy
          change ((1 : C) ⊗ₜ[A] x : TensorProduct A C C) = e * (x ⊗ₜ[A] (1 : C)) at hx
          change ((1 : C) ⊗ₜ[A] y : TensorProduct A C C) = e * (y ⊗ₜ[A] (1 : C)) at hy
          change ((1 : C) ⊗ₜ[A] (x + y) : TensorProduct A C C) = e * ((x + y) ⊗ₜ[A] (1 : C))
          rw [TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add, hx, hy]
        zero_mem' := by
          change ((1 : C) ⊗ₜ[A] (0 : C) : TensorProduct A C C) = e * ((0 : C) ⊗ₜ[A] (1 : C))
          rw [TensorProduct.tmul_zero, TensorProduct.zero_tmul, mul_zero]
        smul_mem' := by
          intro a x hx
          change ((1 : C) ⊗ₜ[A] x : TensorProduct A C C) = e * (x ⊗ₜ[A] (1 : C)) at hx
          change ((1 : C) ⊗ₜ[A] (a • x) : TensorProduct A C C) = e * ((a • x) ⊗ₜ[A] (1 : C))
          rw [TensorProduct.tmul_smul, ← TensorProduct.smul_tmul', mul_smul_comm, hx] }
    have memL : ∀ e x, x ∈ Lof e ↔
        ((1 : C) ⊗ₜ[A] x : TensorProduct A C C) = e * (x ⊗ₜ[A] (1 : C)) := fun e x => Iff.rfl
    have hmul : ∀ x ∈ Lof c, ∀ x' ∈ Lof cm, ∃ a : A, algebraMap A C a = x * x' := by
      intro x hx x' hx'
      rw [memL] at hx hx'
      apply heq
      have e1 : ((1 : C) ⊗ₜ[A] (x * x') : TensorProduct A C C) =
          ((1 : C) ⊗ₜ[A] x) * ((1 : C) ⊗ₜ[A] x') := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      have e2 : ((x * x') ⊗ₜ[A] (1 : C) : TensorProduct A C C) =
          (x ⊗ₜ[A] (1 : C)) * (x' ⊗ₜ[A] (1 : C)) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      rw [e1, e2, hx, hx']
      calc c * (x ⊗ₜ[A] (1 : C)) * (cm * (x' ⊗ₜ[A] (1 : C)))
          = (c * cm) * ((x ⊗ₜ[A] (1 : C)) * (x' ⊗ₜ[A] (1 : C))) := by ring
        _ = (x ⊗ₜ[A] (1 : C)) * (x' ⊗ₜ[A] (1 : C)) := by rw [hccm, one_mul]
    have hle : Lof c * Lof cm ≤ 1 := by
      rw [Submodule.mul_le]
      intro x hx x' hx'
      obtain ⟨a, ha⟩ := hmul x hx x' hx'
      exact Submodule.mem_one.mpr ⟨a, ha⟩
    have hone : (1 : C) ∈ Lof c * Lof cm := by
      by_contra hne
      let I : Ideal A := Submodule.comap (Algebra.linearMap A C) (Lof c * Lof cm)
      have hI : I ≠ ⊤ := by
        intro htop
        apply hne
        have h1 : (1 : A) ∈ I := htop ▸ Submodule.mem_top
        have h2 : Algebra.linearMap A C 1 ∈ Lof c * Lof cm := h1
        rwa [Algebra.linearMap_apply, map_one] at h2
      obtain ⟨P, hPmax, hIP⟩ := Ideal.exists_le_maximal I hI
      have hP := hPmax.isPrime
      obtain ⟨s, hs, m, n, hm, hmn⟩ := hloc c hc hcoc P hP
      obtain ⟨s', hs', m', n', hm', hmn'⟩ := hloc cm hcm_unit hcocm P hP
      have hmL : m ∈ Lof c := hm
      have hm'L : m' ∈ Lof cm := hm'
      have hmm : m * m' ∈ Lof c * Lof cm := Submodule.mul_mem_mul hmL hm'L
      obtain ⟨a, ha⟩ := hmul m hmL m' hm'L
      have haI : a ∈ I := by
        show Algebra.linearMap A C a ∈ Lof c * Lof cm
        rw [Algebra.linearMap_apply, ha]
        exact hmm
      have haP : a ∈ P := hIP haI
      have hss : s * s' ∈ P := by
        rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := C) P, Ideal.mem_comap, map_mul,
          ← hmn, ← hmn']
        have e : m * n * (m' * n') = algebraMap A C a * (n * n') := by rw [ha]; ring
        rw [e]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ haP)
      rcases hP.mem_or_mem hss with h | h
      · exact hs h
      · exact hs' h
    have hLL : Lof c * Lof cm = 1 := le_antisymm hle ((Submodule.one_le).mpr hone)
    haveI : FaithfulSMul A C := Module.FaithfullyFlat.faithfulSMul
    let LL : (Submodule A C)ˣ := ⟨Lof c, Lof cm, hLL, by rw [mul_comm]; exact hLL⟩
    have hinv : Module.Invertible A ↥(LL : Submodule A C) :=
      Submodule.instInvertibleSubtypeMemVal LL
    have hfree : Module.Free A ↥(LL : Submodule A C) :=
      CommRing.Pic.subsingleton_iff.mp hpic _ hinv
    obtain ⟨e⟩ := (Module.Invertible.free_iff_linearEquiv).mp hfree
    have hm0L : ((e.symm 1 : ↥(LL : Submodule A C)) : C) ∈ Lof c := (e.symm 1).2
    have hgen : ∀ x ∈ Lof c, ∃ r : A,
        x = algebraMap A C r * ((e.symm 1 : ↥(LL : Submodule A C)) : C) := by
      intro x hx
      refine ⟨e ⟨x, hx⟩, ?_⟩
      have h1 : (⟨x, hx⟩ : ↥(LL : Submodule A C)) = (e ⟨x, hx⟩) • e.symm 1 := by
        conv_lhs => rw [← e.symm_apply_apply ⟨x, hx⟩]
        rw [← map_smul, smul_eq_mul, mul_one]
      have h2 := congrArg Subtype.val h1
      rw [Submodule.coe_smul, Algebra.smul_def] at h2
      exact h2
    have hdiv : ∀ z ∈ Lof c * Lof cm, ∃ w : C,
        z = ((e.symm 1 : ↥(LL : Submodule A C)) : C) * w := by
      intro z hz
      refine Submodule.mul_induction_on hz ?_ ?_
      · intro x hx x' _
        obtain ⟨r, hr⟩ := hgen x hx
        exact ⟨algebraMap A C r * x', by rw [hr]; ring⟩
      · rintro z z' ⟨w, hw⟩ ⟨w', hw'⟩
        exact ⟨w + w', by rw [hw, hw']; ring⟩
    obtain ⟨w, hw⟩ := hdiv 1 hone
    exact ⟨_, isUnit_iff_exists_inv.mpr ⟨w, hw.symm⟩, hm0L⟩

  have hext : ∀ (A C R : Type u) [CommRing A] [CommRing C] [CommRing R] [Algebra A C]
      (φ ψ : TensorProduct A C C → R),
      (∀ a b, φ (a * b) = φ a * φ b) → (∀ a b, φ (a + b) = φ a + φ b) → φ 0 = 0 →
      (∀ a b, ψ (a * b) = ψ a * ψ b) → (∀ a b, ψ (a + b) = ψ a + ψ b) → ψ 0 = 0 →
      (∀ x : C, φ (x ⊗ₜ[A] (1 : C)) = ψ (x ⊗ₜ[A] (1 : C))) →
      (∀ x : C, φ ((1 : C) ⊗ₜ[A] x) = ψ ((1 : C) ⊗ₜ[A] x)) → ∀ t, φ t = ψ t := by
    intro A C R _ _ _ _ φ ψ hφm hφa hφ0 hψm hψa hψ0 h1 h2 t
    induction t using TensorProduct.induction_on with
    | zero => rw [hφ0, hψ0]
    | tmul x y =>
      have e : (x ⊗ₜ[A] y : TensorProduct A C C) = (x ⊗ₜ[A] (1 : C)) * ((1 : C) ⊗ₜ[A] y) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e, hφm, hψm, h1, h2]
    | add a b ha hb => rw [hφa, hψa, ha, hb]

  haveI : IsAffine U.left := hU
  obtain ⟨Ω, p, hΩa, hproj, hcov, hff⟩ : ∃ (Ω : S.ProEt) (p : Ω ⟶ U), IsAffine Ω.left ∧
      Projective (wcFreeSheaf S Ω) ∧
      Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S U ∧
      (p.left.appTop.hom).FaithfullyFlat := by
    obtain ⟨Δ, δ, hΔ, hδw, hδs, h2, h3, h4, h5⟩ := wc_exists_wcontractible_cover U.left hU
    haveI : IsAffine Δ := hΔ
    haveI : WeaklyEtale δ := hδw
    let Ω : S.ProEt := MorphismProperty.Over.mk ⊤ (δ ≫ U.hom)
      (@MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ δ U.hom hδw U.prop)
    let p : Ω ⟶ U := MorphismProperty.Over.homMk δ rfl trivial
    refine ⟨Ω, p, hΔ, wc_proet_free_projective_wcontractible S Ω ⟨hΔ, h2, h3, h4, h5⟩, ?_, ?_⟩
    · refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
        (proet_finite_affine_jointly_surjective_covers S U 1 (fun _ => Ω) (fun _ => p)
          (fun _ => hΔ) (fun x => ⟨0, hδs.surj x⟩))
      rintro _ _ ⟨i⟩
      exact Presieve.singleton.mk
    · exact (Flat.flat_and_surjective_iff_faithfullyFlat_of_isAffine δ).mp ⟨WeaklyEtale.flat, hδs⟩
  haveI : IsAffine Ω.left := hΩa
  letI : Algebra Γ(U.left, ⊤) Γ(Ω.left, ⊤) := p.left.appTop.hom.toAlgebra
  haveI : Module.FaithfullyFlat Γ(U.left, ⊤) Γ(Ω.left, ⊤) :=
    RingHom.faithfullyFlat_algebraMap_iff.mp hff

  have hspec : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C), Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom (g.comp f)) := by
    intro A B C _ _ _ f g
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  have L3gen : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C]
      (iK : U.left ≅ Spec (CommRingCat.of A)) (iΩ : Ω.left ≅ Spec (CommRingCat.of C)),
      iΩ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A C)) = p.left ≫ iK.hom →
      ∃ (κ₂ : (wcFpeNerve S U Ω p 2).left ≅ Spec (CommRingCat.of (TensorProduct A C C)))
        (κ₃ : (wcFpeNerve S U Ω p 3).left ≅
          Spec (CommRingCat.of (TensorProduct A C (TensorProduct A C C)))),
        κ₂.hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : C →+* TensorProduct A C C)) =
          (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left ≫ iΩ.hom ∧
        κ₂.hom ≫ Spec.map (CommRingCat.ofHom
          ((Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A C C).toRingHom)) =
          (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left ≫ iΩ.hom ∧
        κ₃.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          C →+* TensorProduct A C (TensorProduct A C C))) =
          (Limits.WidePullback.π (fun _ : Fin 3 => p) 0).left ≫ iΩ.hom ∧
        κ₃.hom ≫ Spec.map (CommRingCat.ofHom (((Algebra.TensorProduct.includeRight :
          TensorProduct A C C →ₐ[A] TensorProduct A C (TensorProduct A C C)).toRingHom).comp
          (Algebra.TensorProduct.includeLeftRingHom : C →+* TensorProduct A C C))) =
          (Limits.WidePullback.π (fun _ : Fin 3 => p) 1).left ≫ iΩ.hom ∧
        κ₃.hom ≫ Spec.map (CommRingCat.ofHom (((Algebra.TensorProduct.includeRight :
          TensorProduct A C C →ₐ[A] TensorProduct A C (TensorProduct A C C)).toRingHom).comp
          ((Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A C C).toRingHom))) =
          (Limits.WidePullback.π (fun _ : Fin 3 => p) 2).left ≫ iΩ.hom := by
    intro A C _ _ _ iK iΩ hp1
    let inc0 : C →+* TensorProduct A C C := Algebra.TensorProduct.includeLeftRingHom
    let inc1 : C →+* TensorProduct A C C :=
      (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A C C).toRingHom
    let inc30 : C →+* TensorProduct A C (TensorProduct A C C) :=
      Algebra.TensorProduct.includeLeftRingHom
    let incR3 : TensorProduct A C C →+* TensorProduct A C (TensorProduct A C C) :=
      (Algebra.TensorProduct.includeRight :
        TensorProduct A C C →ₐ[A] TensorProduct A C (TensorProduct A C C)).toRingHom
    show ∃ (κ₂ : (wcFpeNerve S U Ω p 2).left ≅ Spec (CommRingCat.of (TensorProduct A C C)))
        (κ₃ : (wcFpeNerve S U Ω p 3).left ≅
          Spec (CommRingCat.of (TensorProduct A C (TensorProduct A C C)))),
        κ₂.hom ≫ Spec.map (CommRingCat.ofHom inc0) =
          (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left ≫ iΩ.hom ∧
        κ₂.hom ≫ Spec.map (CommRingCat.ofHom inc1) =
          (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left ≫ iΩ.hom ∧
        κ₃.hom ≫ Spec.map (CommRingCat.ofHom inc30) =
          (Limits.WidePullback.π (fun _ : Fin 3 => p) 0).left ≫ iΩ.hom ∧
        κ₃.hom ≫ Spec.map (CommRingCat.ofHom (incR3.comp inc0)) =
          (Limits.WidePullback.π (fun _ : Fin 3 => p) 1).left ≫ iΩ.hom ∧
        κ₃.hom ≫ Spec.map (CommRingCat.ofHom (incR3.comp inc1)) =
          (Limits.WidePullback.π (fun _ : Fin 3 => p) 2).left ≫ iΩ.hom
    have T1 : ∀ (n : ℕ) (T : Scheme.{u}) (t₀ : T ⟶ U.left) (t : Fin n → (T ⟶ Ω.left)),
        (∀ l, t l ≫ p.left = t₀) → ∃! f : T ⟶ (wcFpeNerve S U Ω p n).left,
          (∀ l, f ≫ (Limits.WidePullback.π (fun _ : Fin n => p) l).left = t l) ∧
          f ≫ (Limits.WidePullback.base (fun _ : Fin n => p)).left = t₀ := by
      intro n T t₀ t ht
      let D := Limits.WidePullbackShape.wideCospan U (fun _ : Fin n => Ω) (fun _ => p)
      have hc : Limits.IsLimit
          ((Scheme.ProEt.forget S ⋙ Over.forget S).mapCone (Limits.limit.cone D)) :=
        Limits.isLimitOfPreserves _ (Limits.limit.isLimit D)
      let s : Limits.Cone (D ⋙ (Scheme.ProEt.forget S ⋙ Over.forget S)) :=
        Limits.WidePullbackShape.mkCone (F := D ⋙ (Scheme.ProEt.forget S ⋙ Over.forget S))
          t₀ t (fun l => ht l)
      refine ⟨hc.lift s, ⟨fun l => hc.fac s (some l), hc.fac s none⟩, ?_⟩
      rintro f' ⟨h1, h2⟩
      apply hc.hom_ext
      rintro (_ | l)
      · exact h2.trans (hc.fac s none).symm
      · exact (h1 l).trans (hc.fac s (some l)).symm
    let P : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap A C)))
        (Spec.map (CommRingCat.ofHom (algebraMap A C))) ≅
        Spec (CommRingCat.of (TensorProduct A C C)) :=
      pullbackSpecIso A C C
    have e0 : P.hom ≫ Spec.map (CommRingCat.ofHom inc0) = Limits.pullback.fst _ _ :=
      pullbackSpecIso_hom_fst _ _ _
    have e1 : P.hom ≫ Spec.map (CommRingCat.ofHom inc1) = Limits.pullback.snd _ _ :=
      pullbackSpecIso_hom_snd _ _ _
    have i0 : P.inv ≫ Limits.pullback.fst _ _ = Spec.map (CommRingCat.ofHom inc0) :=
      pullbackSpecIso_inv_fst _ _ _
    have i1 : P.inv ≫ Limits.pullback.snd _ _ = Spec.map (CommRingCat.ofHom inc1) :=
      pullbackSpecIso_inv_snd _ _ _
    have T2 : ∀ (T : Scheme.{u}) (a₁ a₂ : T ⟶ Spec (CommRingCat.of C)),
        a₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap A C)) =
          a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap A C)) →
        ∃! f : T ⟶ Spec (CommRingCat.of (TensorProduct A C C)),
          f ≫ Spec.map (CommRingCat.ofHom inc0) = a₁ ∧
          f ≫ Spec.map (CommRingCat.ofHom inc1) = a₂ := by
      intro T a₁ a₂ h
      refine ⟨Limits.pullback.lift a₁ a₂ h ≫ P.hom, ⟨?_, ?_⟩, ?_⟩
      · rw [Category.assoc, e0, Limits.pullback.lift_fst]
      · rw [Category.assoc, e1, Limits.pullback.lift_snd]
      · rintro f' ⟨h1, h2⟩
        have hf : f' ≫ P.inv = Limits.pullback.lift a₁ a₂ h := by
          apply Limits.pullback.hom_ext
          · rw [Limits.pullback.lift_fst, Category.assoc, i0, h1]
          · rw [Limits.pullback.lift_snd, Category.assoc, i1, h2]
        rw [← hf, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have c2 : Spec.map (CommRingCat.ofHom inc0) ≫
          Spec.map (CommRingCat.ofHom (algebraMap A C)) =
