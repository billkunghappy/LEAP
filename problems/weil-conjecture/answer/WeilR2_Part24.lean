  have hηb : V.hom v' ⤳ D.S i (IsLocalRing.closedPoint F'') := by
    have := hsp.map (hcont V.hom)
    rwa [hv] at this
  have hηne : V.hom v' ≠ D.S i (IsLocalRing.closedPoint F'') := hηO i

  obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, heint, hpt⟩ :=
    wc_et_geom_strict_henselization (D.S i (IsLocalRing.closedPoint F''))
  have hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a := by
    first
    | exact ⟨hinit, haff, hφ, hφa, hlim, e, heint, hpt⟩
    | exact ⟨hinit, haff, hφ, hφa, hlim, ⟨e, heint, hpt⟩⟩
    | exact ⟨hinit, haff, @hφ, hφa, hlim, e, heint, hpt⟩
  obtain ⟨ξ, hξ⟩ : ∃ ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField (V.hom v'))))
