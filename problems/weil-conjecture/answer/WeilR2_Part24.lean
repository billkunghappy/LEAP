  have hcone : Cβ.IsGE 1 ∧ ∀ j : ℤ, 1 ≤ j → IsIso ((DerivedCategory.homologyFunctor _ j).map vβ) :=
    wc_srdcb_cone_homology (SheafOfModules.unit (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k))) ((Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj ⟨_, h1⟩) Cβ u hu0 vβ wβ hT
  have hCge : Cβ.IsGE 1 := hcone.1
  have hCiso : ∀ j : ℤ, 1 ≤ j → IsIso ((DerivedCategory.homologyFunctor _ j).map vβ) := hcone.2
  haveI := hCge
  have hRj := wc_srdcb_Rj_structure A ℓ hℓ k n hn hn4 π hπ c hc X' β hbl hprop f' hf' βs hβs1
