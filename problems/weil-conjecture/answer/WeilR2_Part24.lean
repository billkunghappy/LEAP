  have C2 : ∀ k, (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a₀))).comp
      (Yk k) (zero_add (n - 1)) =
      w.comp (Abelian.Ext.mk₀ (wcContSheafMap D.Yt.left
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero (n - 1)) := by
