theorem wc_etqm_srdtp_pset_nonempty (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (n : ℕ) (hn4 : 4 ≤ n) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (e : Fin n → (Spec (.of (wcQuadModelRing A n π
