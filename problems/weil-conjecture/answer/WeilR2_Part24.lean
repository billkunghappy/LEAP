    obtain ⟨γ, hγdef⟩ : ∃ γ : T ⟶ (F.obj Z)⟦N⟧,
        Θ Z γ = ι₀.hom ≫ γY ≫ (shiftFunctor _ N).map (θ.inv ≫ cI.inv) :=
      ⟨_, AddEquiv.apply_symm_apply _ _⟩
    have hγ : ℓ ^ j • (γ ≫ (shiftFunctor _ N).map (F.map hhm)) ≠ 0 := by
