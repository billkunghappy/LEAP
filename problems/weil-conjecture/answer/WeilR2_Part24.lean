        have hy1 : ψ' (y p1) = ρ.hom (x p1) + S := by
          have e1 := hc (x p1)
          have hx1 : φ (x p1) = y p1 + y p0 * y p1 -
              ∑ a, ∑ b, algebraMap A _ (wcSrmCh A r a b) * y a * y b := by
