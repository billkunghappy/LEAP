theorem wc_odp_residue_quadric_form (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) :
    ∃ (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → F'')
      (t : Fin n → D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))
      (τ : (wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
      (A : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))),
      (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 ∧
      IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) =
        Ideal.span (Set.range t) ∧
      IsLocalRing.maximalIdeal
          ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) =
        Ideal.span {τ} ∧
      (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) ^ 3 ∧
      ∀ p c : Fin (n - 2 + 1 + 1),
        A (Fin.cast (by omega) p) (Fin.cast (by omega) c) -
            wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) (a p c) ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) :=
by
  classical
  have key : ∀ (E : Type u) [Field E] (X : Scheme.{u}) (s : X ⟶ Spec (.of E))
      (x : Spec (.of E) ⟶ X), x ≫ s = 𝟙 _ →
      ∃ ev : X.presheaf.stalk (x (IsLocalRing.closedPoint E)) →+* E,
        ∀ r : X.presheaf.stalk (x (IsLocalRing.closedPoint E)),
          r - wcLdpConst E s (x (IsLocalRing.closedPoint E)) (ev r) ∈
            IsLocalRing.maximalIdeal (X.presheaf.stalk (x (IsLocalRing.closedPoint E))) := by
    intro E _ X s x hx
    let ev : X.presheaf.stalk (x (IsLocalRing.closedPoint E)) →+* E :=
      (x.stalkMap (IsLocalRing.closedPoint E) ≫
        (stalkClosedPointIso (CommRingCat.of E)).hom).hom
    have h1 : X.presheaf.germ ⊤ (x (IsLocalRing.closedPoint E)) trivial ≫
        x.stalkMap (IsLocalRing.closedPoint E) ≫ (stalkClosedPointIso (CommRingCat.of E)).hom =
        x.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of E)).hom := by
      have e1 := Scheme.Hom.germ_stalkMap_assoc x ⊤ (IsLocalRing.closedPoint E) trivial
        (stalkClosedPointIso (CommRingCat.of E)).hom
      have e2 := germ_stalkClosedPointIso_hom (CommRingCat.of E)
      exact e1.trans (congrArg (fun φ => Scheme.Hom.app x ⊤ ≫ φ) e2)
    have hmor : (Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ s.appTop ≫
        X.presheaf.germ ⊤ (x (IsLocalRing.closedPoint E)) trivial ≫
        x.stalkMap (IsLocalRing.closedPoint E) ≫ (stalkClosedPointIso (CommRingCat.of E)).hom =
        𝟙 _ := by
      rw [h1, ← Category.assoc s.appTop, ← Scheme.Hom.comp_appTop, hx, Scheme.Hom.id_appTop,
        Category.id_comp, Iso.inv_hom_id]
    have hleft : ∀ c : E, ev (wcLdpConst E s (x (IsLocalRing.closedPoint E)) c) = c := by
      intro c
      have := congrArg (fun φ => φ.hom c) hmor
      exact this
    refine ⟨ev, fun r => ?_⟩
    by_contra hmem
    have hu : IsUnit (r - wcLdpConst E s (x (IsLocalRing.closedPoint E)) (ev r)) :=
      IsLocalRing.notMem_maximalIdeal.mp hmem
    apply (hu.map ev).ne_zero
    rw [map_sub, hleft, sub_self]
  obtain ⟨t, τ, A, ht, hτ, hA, hdet⟩ := D.odp i
  have hsec : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  obtain ⟨ev, hev⟩ := key F'' D.Yt.left D.Yt.hom (D.xs i) hsec
  have h : n - 2 + 1 + 1 = n := by omega
  refine ⟨fun p c => ev (A (Fin.cast h p) (Fin.cast h c)), t, τ, A, ?_, ht, hτ, hA,
    fun p c => hev _⟩
  have hM : (Matrix.of (fun p c : Fin (n - 2 + 1 + 1) => ev (A (Fin.cast h p) (Fin.cast h c))) +
      (Matrix.of (fun p c : Fin (n - 2 + 1 + 1) =>
        ev (A (Fin.cast h p) (Fin.cast h c)))).transpose) =
      (ev.mapMatrix (A + A.transpose)).submatrix (finCongr h) (finCongr h) := by
    ext p c
    simp [Matrix.add_apply, Matrix.transpose_apply, map_add]
  rw [hM, Matrix.det_submatrix_equiv_self, ← RingHom.map_det]
  exact (hdet.map ev).ne_zero

theorem wc_quadric_dim0_frob_sq_fix (K : Type u) [Field K] [Finite K] (E₀ : Over (Spec (.of K)))
    [IsProper E₀.hom] [SmoothOfRelativeDimension 0 E₀.hom]
    (jE : E₀.left ⟶ wcProjK K (0 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (0 + 1) = E₀.hom)
    (a : Fin (0 + 1 + 1) → Fin (0 + 1 + 1) → K)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (hEG : ∀ (x : E₀.left) (c : Fin (0 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (0 + 1) c),
      wcLdpGerm K (0 + 1) jE (wcLdpQuad K (0 + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))) :
    ∀ z : (wcGeomPoint K E₀ hE).left,
      (wcGeomFrob K E₀ hE).left ((wcGeomFrob K E₀ hE).left z) = z :=
by
  classical
  let τ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K :=
    (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm
  let T : CommRingCat.of (AlgebraicClosure K) ⟶ CommRingCat.of (AlgebraicClosure K) :=
    CommRingCat.ofHom (τ : AlgebraicClosure K →+* AlgebraicClosure K)

  have quad : ∀ (A B C : K), (A ≠ 0 ∨ B ≠ 0 ∨ C ≠ 0) → ∀ b : AlgebraicClosure K,
      algebraMap K (AlgebraicClosure K) A * b ^ 2 + algebraMap K (AlgebraicClosure K) B * b +
        algebraMap K (AlgebraicClosure K) C = 0 → τ (τ b) = b := by
    intro A B C hne b hb
    have hinj : Function.Injective (algebraMap K (AlgebraicClosure K)) :=
      (algebraMap K (AlgebraicClosure K)).injective
    have hb' : algebraMap K (AlgebraicClosure K) A * (τ b) ^ 2 +
        algebraMap K (AlgebraicClosure K) B * τ b + algebraMap K (AlgebraicClosure K) C = 0 := by
      have := congrArg τ hb
      simpa only [map_add, map_mul, map_pow, AlgEquiv.commutes, map_zero] using this
    by_cases hA : A = 0
    · have hA0 : algebraMap K (AlgebraicClosure K) A = 0 := by rw [hA, map_zero]
      by_cases hB : B = 0
      · have hB0 : algebraMap K (AlgebraicClosure K) B = 0 := by rw [hB, map_zero]
        have hC : C ≠ 0 := by
          rcases hne with h | h | h
          · exact absurd hA h
          · exact absurd hB h
          · exact h
        exfalso
        apply hC
        apply hinj
        rw [map_zero]
        linear_combination hb - b ^ 2 * hA0 - b * hB0
      · have hB0 : algebraMap K (AlgebraicClosure K) B ≠ 0 :=
          fun h => hB (hinj (h.trans (map_zero _).symm))
        have h1 : algebraMap K (AlgebraicClosure K) B * (b - τ b) = 0 := by
          linear_combination hb - hb' - (b ^ 2 - (τ b) ^ 2) * hA0
        have h2 : τ b = b := (sub_eq_zero.mp ((mul_eq_zero.mp h1).resolve_left hB0)).symm
        rw [h2, h2]
    · have hA0 : algebraMap K (AlgebraicClosure K) A ≠ 0 :=
        fun h => hA (hinj (h.trans (map_zero _).symm))
      by_cases h : τ b = b
      · rw [h, h]
      · have h1 : algebraMap K (AlgebraicClosure K) A * (b + τ b) +
            algebraMap K (AlgebraicClosure K) B = 0 := by
          have h0 : (b - τ b) * (algebraMap K (AlgebraicClosure K) A * (b + τ b) +
              algebraMap K (AlgebraicClosure K) B) = 0 := by
            linear_combination hb - hb'
          rcases mul_eq_zero.mp h0 with h0 | h0
          · exact absurd (sub_eq_zero.mp h0).symm h
          · exact h0
        have h2 : algebraMap K (AlgebraicClosure K) A * (τ b + τ (τ b)) +
            algebraMap K (AlgebraicClosure K) B = 0 := by
          have := congrArg τ h1
          simpa only [map_add, map_mul, AlgEquiv.commutes, map_zero] using this
        have h3 : algebraMap K (AlgebraicClosure K) A * (b - τ (τ b)) = 0 := by
          linear_combination h1 - h2
        exact (sub_eq_zero.mp ((mul_eq_zero.mp h3).resolve_left hA0)).symm

  have hfix : ∀ (b : Fin 2 → Fin 2 → K), (Matrix.of b + (Matrix.of b).transpose).det ≠ 0 →
      ∀ (β : Fin 2 → AlgebraicClosure K) (c : Fin 2), β c = 1 →
      ∑ p, ∑ q, algebraMap K (AlgebraicClosure K) (b p q) * β p * β q = 0 →
      ∀ i, τ (τ (β i)) = β i := by
    intro b hb β c hc hq i
    have hnd : b 0 0 ≠ 0 ∨ b 0 1 + b 1 0 ≠ 0 ∨ b 1 1 ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      obtain ⟨h1, h2, h3⟩ := hcon
      apply hb
      rw [Matrix.det_fin_two]
      simp only [Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply]
      linear_combination (4 * b 1 1) * h1 - (b 0 1 + b 1 0) * h2
    have hc01 : ∀ c : Fin 2, c = 0 ∨ c = 1 := by decide
    have h1fix : ∀ y : AlgebraicClosure K, y = 1 → τ (τ y) = y := by
      rintro y rfl
      rw [map_one, map_one]
    simp only [Fin.sum_univ_two] at hq
    rcases hc01 c with rfl | rfl
    · rcases hc01 i with rfl | rfl
      · exact h1fix _ hc
      · apply quad (b 1 1) (b 0 1 + b 1 0) (b 0 0)
          (by rcases hnd with h | h | h
              · exact Or.inr (Or.inr h)
              · exact Or.inr (Or.inl h)
              · exact Or.inl h)
        rw [hc] at hq
        rw [map_add]
        linear_combination hq
    · rcases hc01 i with rfl | rfl
      · apply quad (b 0 0) (b 0 1 + b 1 0) (b 1 1) hnd
        rw [hc] at hq
        rw [map_add]
        linear_combination hq
      · exact h1fix _ hc
  haveI : Etale E₀.hom := (Etale.iff_smoothOfRelativeDimension_zero E₀.hom).mpr inferInstance
  haveI := hjE

  have hmain : ∀ (x : E₀.left) (φ : E₀.left.residueField x ⟶ CommRingCat.of (AlgebraicClosure K)),
      (Spec.map φ ≫ E₀.left.fromSpecResidueField x) ≫ E₀.hom =
        Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) → φ ≫ T ≫ T = φ := by
    intro x φ h

    have hφK : ∀ k : K, φ.hom ((E₀.left.residue x).hom (wcLdpConst K E₀.hom x k)) =
        algebraMap K (AlgebraicClosure K) k := by
      intro k
      have hconst : CommRingCat.ofHom (wcLdpConst K E₀.hom x) =
          (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ E₀.hom.appTop ≫
            E₀.left.presheaf.germ ⊤ x trivial := rfl
      have hstalk : E₀.left.fromSpecStalk x ≫ E₀.hom =
          Spec.map (CommRingCat.ofHom (wcLdpConst K E₀.hom x)) := by
        calc E₀.left.fromSpecStalk x ≫ E₀.hom
            = E₀.left.fromSpecStalk x ≫ E₀.hom ≫ (Spec (CommRingCat.of K)).toSpecΓ ≫
                Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
              rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
          _ = E₀.left.fromSpecStalk x ≫ E₀.left.toSpecΓ ≫ Spec.map E₀.hom.appTop ≫
                Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
              rw [← Category.assoc E₀.hom, Scheme.toSpecΓ_naturality, Category.assoc]
          _ = Spec.map (E₀.left.presheaf.germ ⊤ x trivial) ≫ Spec.map E₀.hom.appTop ≫
                Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
              rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ]
          _ = Spec.map (CommRingCat.ofHom (wcLdpConst K E₀.hom x)) := by
              rw [hconst, Spec.map_comp, Spec.map_comp, Category.assoc]
      have hcompat : E₀.left.fromSpecResidueField x ≫ E₀.hom =
          Spec.map (CommRingCat.ofHom (wcLdpConst K E₀.hom x) ≫ E₀.left.residue x) := by
        rw [Spec.map_comp, Scheme.fromSpecResidueField, Category.assoc, hstalk]
      rw [Category.assoc, hcompat, ← Spec.map_comp, Spec.map_inj] at h
      exact congrArg (fun g => g.hom k) h

    have hxtop : jE x ∈ (⨆ c : Fin (0 + 1 + 1), wcSgD K (0 + 1) c) :=
      (congrArg (fun U => jE x ∈ U) (wc_pp_basicOpen_cover K (0 + 1))).mpr trivial
    obtain ⟨c, hyP⟩ := TopologicalSpace.Opens.mem_iSup.mp hxtop
    have hy : x ∈ jE ⁻¹ᵁ wcSgD K (0 + 1) c := hyP
    obtain ⟨hK1, hK2, hK3, -⟩ := wc_ldp_lnf_chart_germ K (0 + 1) E₀ jE hjEY
      (wc_ldp_il_proj_const K (0 + 1)) (fun a w => wc_ldp_lnf_sec_quad K (0 + 1) a w) c x hy
    obtain ⟨β, hβ⟩ : ∃ β : Fin (0 + 1 + 1) → AlgebraicClosure K, ∀ i, β i =
        φ.hom ((E₀.left.residue x).hom ((E₀.left.presheaf.germ (jE ⁻¹ᵁ wcSgD K (0 + 1) c) x hy).hom
          ((jE.app (wcSgD K (0 + 1) c)).hom (wcSgE K (0 + 1) c i)))) := ⟨_, fun i => rfl⟩

    have hβc : β c = 1 := by rw [hβ, hK2, map_one, map_one]
    have hβq : ∑ p, ∑ q, algebraMap K (AlgebraicClosure K) (a p q) * β p * β q = 0 := by
      have h0 : (E₀.left.residue x).hom (wcLdpGerm K (0 + 1) jE (wcLdpQuad K (0 + 1) a) c x hy) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr (hEG x c hy)
      rw [hK3 a] at h0
      have h1 := congrArg φ.hom h0
      simp only [map_sum, map_mul, map_zero, hφK] at h1
      simp only [hβ]
      exact h1
    have hβfix : ∀ i, τ (τ (β i)) = β i := hfix a ha β c hβc hβq

    have hext : ∀ ψ₁ ψ₂ : E₀.left.residueField x →+* AlgebraicClosure K,
        (∀ k : K, ψ₁ ((E₀.left.residue x).hom (wcLdpConst K E₀.hom x k)) =
          ψ₂ ((E₀.left.residue x).hom (wcLdpConst K E₀.hom x k))) →
        (∀ i, ψ₁ ((E₀.left.residue x).hom ((E₀.left.presheaf.germ (jE ⁻¹ᵁ wcSgD K (0 + 1) c) x hy).hom
            ((jE.app (wcSgD K (0 + 1) c)).hom (wcSgE K (0 + 1) c i)))) =
          ψ₂ ((E₀.left.residue x).hom ((E₀.left.presheaf.germ (jE ⁻¹ᵁ wcSgD K (0 + 1) c) x hy).hom
            ((jE.app (wcSgD K (0 + 1) c)).hom (wcSgE K (0 + 1) c i))))) → ψ₁ = ψ₂ := by
      intro ψ₁ ψ₂ hK hX
      have hgs : ∀ s, (E₀.left.residue x).hom ((jE.stalkMap x).hom
          (((wcProjK K (0 + 1)).presheaf.germ (wcSgD K (0 + 1) c) (jE x) hyP).hom s)) =
          (E₀.left.residue x).hom ((E₀.left.presheaf.germ (jE ⁻¹ᵁ wcSgD K (0 + 1) c) x hy).hom
            ((jE.app (wcSgD K (0 + 1) c)).hom s)) :=
        fun s => congrArg (E₀.left.residue x).hom (Scheme.Hom.germ_stalkMap_apply jE _ x hyP s)
      let G : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (0 + 1 + 1)) K)
          (MvPolynomial.X c) →+* (wcProjK K (0 + 1)).presheaf.stalk (jE x) :=
        ((wcProjK K (0 + 1)).presheaf.germ (wcSgD K (0 + 1) c) (jE x) hyP).hom.comp
          (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (0 + 1 + 1)) K)
            (MvPolynomial.X c)).hom
      let R : (wcProjK K (0 + 1)).presheaf.stalk (jE x) →+* E₀.left.residueField x :=
        (E₀.left.residue x).hom.comp (jE.stalkMap x).hom
      have hΛ : (ψ₁.comp R).comp G = (ψ₂.comp R).comp G := by
        have hle : Subring.closure (Set.range (fun i : Fin (0 + 1 + 1) =>
            HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (0 + 1 + 1)) K)
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K c)) 1
            (MvPolynomial.X i)
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))) ∪
            Set.range ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (0 + 1 + 1)) K)
              (Submonoid.powers (MvPolynomial.X c))).comp (algebraMap K _))) ≤
            ((ψ₁.comp R).comp G).eqLocus ((ψ₂.comp R).comp G) := by
          rw [Subring.closure_le]
          rintro _ (⟨i, rfl⟩ | ⟨k, rfl⟩)
          · rw [SetLike.mem_coe, RingHom.mem_eqLocus]
            exact (congrArg ψ₁ (hgs (wcSgE K (0 + 1) c i))).trans
              ((hX i).trans (congrArg ψ₂ (hgs (wcSgE K (0 + 1) c i))).symm)
          · rw [SetLike.mem_coe, RingHom.mem_eqLocus]
            have e : R (G (((HomogeneousLocalization.fromZeroRingHom
                (MvPolynomial.homogeneousSubmodule (Fin (0 + 1 + 1)) K)
                (Submonoid.powers (MvPolynomial.X c))).comp (algebraMap K _)) k)) =
                (E₀.left.residue x).hom (wcLdpConst K E₀.hom x k) :=
              (hgs _).trans (congrArg (E₀.left.residue x).hom (hK1 k))
            exact (congrArg ψ₁ e).trans ((hK k).trans (congrArg ψ₂ e).symm)
        rw [wc_away_X_closure_top K (0 + 1) c] at hle
        ext w
        exact RingHom.mem_eqLocus.mp (hle (Subring.mem_top w))
      have hΘ : ∀ w, ψ₁ (R w) = ψ₂ (R w) := by
        intro w
        obtain ⟨r, σ, hu, hw⟩ := wc_ldp_il_proj_stalk_frac K (0 + 1) c (jE x) hyP w
        have e1 : ψ₁ (R w) * ((ψ₁.comp R).comp G) σ = ((ψ₁.comp R).comp G) r := by
          have := congrArg (fun y => ψ₁ (R y)) hw
          simp only [map_mul] at this
          exact this
        have e2 : ψ₂ (R w) * ((ψ₂.comp R).comp G) σ = ((ψ₂.comp R).comp G) r := by
          have := congrArg (fun y => ψ₂ (R y)) hw
          simp only [map_mul] at this
          exact this
        have hunit : IsUnit (((ψ₁.comp R).comp G) σ) := hu.map (ψ₁.comp R)
        rw [hΛ] at e1 hunit
        exact (hunit.mul_left_inj).mp (e1.trans e2.symm)
      apply RingHom.ext
      intro α
      obtain ⟨m, rfl⟩ := Scheme.residue_surjective E₀.left x α
      obtain ⟨w, rfl⟩ := jE.stalkMap_surjective x m
      exact hΘ w
    apply CommRingCat.hom_ext
    apply hext
    · intro k
      show τ (τ (φ.hom _)) = φ.hom _
      rw [hφK k, AlgEquiv.commutes, AlgEquiv.commutes]
    · intro i
      show τ (τ (φ.hom _)) = φ.hom _
      rw [← hβ i]
      exact hβfix i

  have key : ∀ (Frl : (Limits.pullback E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) : Scheme.{u}) ⟶
        Limits.pullback E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))),
      Frl ≫ Limits.pullback.fst E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Limits.pullback.fst E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) →
      Frl ≫ Limits.pullback.snd E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        Limits.pullback.snd E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫ Spec.map T →
      ∀ z : (Limits.pullback E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) : Scheme.{u}),
        Frl (Frl z) = z := by
    intro Frl hFf hFs z
    obtain ⟨t, ht, htz⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure K)
      (Limits.pullback.snd E₀.hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (𝟙 _) z (Subsingleton.elim _ _)
    obtain ⟨x, φ, hu⟩ : ∃ (x : E₀.left)
        (φ : E₀.left.residueField x ⟶ CommRingCat.of (AlgebraicClosure K)),
        Spec.map φ ≫ E₀.left.fromSpecResidueField x = t ≫ Limits.pullback.fst E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
      ⟨_, _, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField (AlgebraicClosure K)
        E₀.left _⟩
    have hφ : φ ≫ T ≫ T = φ := hmain x φ (by
      rw [hu, Category.assoc, Limits.pullback.condition, ← Category.assoc, ht, Category.id_comp])
    have hTT : Spec.map T ≫ Spec.map T ≫ t ≫ Limits.pullback.fst E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
        t ≫ Limits.pullback.fst E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
      rw [← hu]
      calc Spec.map T ≫ Spec.map T ≫ Spec.map φ ≫ E₀.left.fromSpecResidueField x
          = Spec.map (φ ≫ T ≫ T) ≫ E₀.left.fromSpecResidueField x := by
            simp only [Spec.map_comp, Category.assoc]
        _ = Spec.map φ ≫ E₀.left.fromSpecResidueField x := by rw [hφ]
    have hsq : t ≫ Frl ≫ Frl = Spec.map T ≫ Spec.map T ≫ t := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hFf]
        exact hTT.symm
      · simp only [Category.assoc, hFs, reassoc_of% hFs, reassoc_of% ht, ht, Category.comp_id,
          Category.id_comp]
    rw [← htz]
    calc Frl (Frl (t (IsLocalRing.closedPoint (AlgebraicClosure K))))
        = (t ≫ Frl ≫ Frl) (IsLocalRing.closedPoint (AlgebraicClosure K)) := by
          first
            | rfl
            | rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
            | simp
      _ = (Spec.map T ≫ Spec.map T ≫ t) (IsLocalRing.closedPoint (AlgebraicClosure K)) := by
          rw [hsq]
      _ = t ((Spec.map T ≫ Spec.map T) (IsLocalRing.closedPoint (AlgebraicClosure K))) := by
          first
            | rfl
            | rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
            | simp
      _ = t (IsLocalRing.closedPoint (AlgebraicClosure K)) := congrArg _ (Subsingleton.elim _ _)
  exact key (wcGeomFrob K E₀ hE).left
    ((Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _))
    (Limits.pullback.lift_snd _ _ _)

theorem wc_cohG_empty_zero (K : Type u) [Field K] (E₀ : Over (Spec (.of K))) [IsEmpty E₀.left]
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (G : Sheaf (Scheme.ProEt.topology E₀.left) AddCommGrpCat.{u+1}) (i : ℕ)
    (x : wcCohG K E₀ hE G i) : x = 0 :=
by
  have s1 : ∀ W : E₀.left.ProEt, IsEmpty W.left :=
    fun W => ⟨fun w => (‹IsEmpty E₀.left›).false (W.hom.base w)⟩
  have s3 : ∀ H : Sheaf (Scheme.ProEt.topology E₀.left) AddCommGrpCat.{u+1}, Limits.IsZero H := by
    intro H
    have h : Limits.IsZero H.obj := Functor.isZero H.obj (fun X => by
      haveI := s1 X.unop
      exact (Sheaf.isTerminalOfBotCover H X.unop (Scheme.ProEt.bot_mem_topology X.unop)).isZero)
    exact Limits.IsZero.of_full_of_faithful_of_isZero
      (sheafToPresheaf (Scheme.ProEt.topology E₀.left) AddCommGrpCat.{u+1}) H h
  have hG := s3 G
  rw [← Abelian.Ext.comp_mk₀_id x, hG.eq_of_src (𝟙 G) 0, Abelian.Ext.mk₀_zero,
    Abelian.Ext.comp_zero]

theorem wc_quadric_hyperbolic_normal_form (K : Type u) [Field K] [Finite K] (e : ℕ)
    (a : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0) :
    ∃ (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
      (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
      (L M : Fin (e + 2 + 1 + 1) → MvPolynomial (Fin (e + 2 + 1 + 1)) K),
      (Matrix.of a' + (Matrix.of a').transpose).det ≠ 0 ∧
      (∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0) ∧
      (∀ i, (L i).IsHomogeneous 1) ∧ (∀ i, (M i).IsHomogeneous 1) ∧
      (∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i) ∧
      (∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i) ∧
      MvPolynomial.aeval L ((wcLdpQuad K (e + 2 + 1) b : MvPolynomial (Fin (e + 2 + 1 + 1)) K)) =
        (wcLdpQuad K (e + 2 + 1) a : MvPolynomial (Fin (e + 2 + 1 + 1)) K) :=
by
  classical

  have s1 : ∀ (m : ℕ) (c : Fin m → Fin m → K) (R : Matrix (Fin m) (Fin m) K),
      MvPolynomial.aeval (fun i => ∑ j, MvPolynomial.C (R i j) * MvPolynomial.X j)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * (MvPolynomial.X p * MvPolynomial.X q) :
            MvPolynomial (Fin m) K) =
        ∑ p, ∑ q, MvPolynomial.C ((R.transpose * Matrix.of c * R) p q) *
          (MvPolynomial.X p * MvPolynomial.X q) := by
    intro m c R
    set T : Fin m → Fin m → Fin m → Fin m → MvPolynomial (Fin m) K := fun p q r s =>
      MvPolynomial.C (R p r * c p q * R q s) * (MvPolynomial.X r * MvPolynomial.X s) with hT
    have hL : MvPolynomial.aeval (fun i => ∑ j, MvPolynomial.C (R i j) * MvPolynomial.X j)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * (MvPolynomial.X p * MvPolynomial.X q) :
            MvPolynomial (Fin m) K) = ∑ p, ∑ q, ∑ r, ∑ s, T p q r s := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [map_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      simp only [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, MvPolynomial.algebraMap_eq]
      rw [Finset.sum_mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun s _ => ?_)
      simp only [hT, map_mul]
      ring
    have hR : ∀ r s, MvPolynomial.C ((R.transpose * Matrix.of c * R) r s) *
        (MvPolynomial.X r * MvPolynomial.X s) = ∑ q, ∑ p, T p q r s := by
      intro r s
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Finset.sum_mul,
        map_sum]
      refine Finset.sum_congr rfl (fun q _ => Finset.sum_congr rfl (fun p _ => ?_))
      simp only [hT]
    rw [hL, Finset.sum_congr rfl (fun r _ => Finset.sum_congr rfl (fun s _ => hR r s))]
    calc (∑ p, ∑ q, ∑ r, ∑ s, T p q r s)
        = ∑ p, ∑ r, ∑ q, ∑ s, T p q r s :=
          Finset.sum_congr rfl (fun p _ => Finset.sum_comm)
      _ = ∑ r, ∑ p, ∑ q, ∑ s, T p q r s := Finset.sum_comm
      _ = ∑ r, ∑ p, ∑ s, ∑ q, T p q r s :=
          Finset.sum_congr rfl (fun r _ => Finset.sum_congr rfl (fun p _ => Finset.sum_comm))
      _ = ∑ r, ∑ s, ∑ p, ∑ q, T p q r s :=
          Finset.sum_congr rfl (fun r _ => Finset.sum_comm)
      _ = ∑ r, ∑ s, ∑ q, ∑ p, T p q r s :=
          Finset.sum_congr rfl (fun r _ => Finset.sum_congr rfl (fun s _ => Finset.sum_comm))

  have s2 : ∀ (m : ℕ) (A B : Matrix (Fin m) (Fin m) K), A * B = 1 → ∀ i : Fin m,
      MvPolynomial.aeval (fun j => ∑ k, MvPolynomial.C (B j k) * MvPolynomial.X k)
          (∑ j, MvPolynomial.C (A i j) * MvPolynomial.X j : MvPolynomial (Fin m) K) =
        MvPolynomial.X i := by
    intro m A B hAB i
    simp only [map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq, Finset.mul_sum]
    rw [Finset.sum_comm]
    have : ∀ k, (∑ j, MvPolynomial.C (A i j) * (MvPolynomial.C (B j k) * MvPolynomial.X k) :
        MvPolynomial (Fin m) K) = MvPolynomial.C ((A * B) i k) * MvPolynomial.X k := by
      intro k
      rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
      exact Finset.sum_congr rfl (fun j _ => by rw [map_mul, mul_assoc])
    simp only [this, hAB, Matrix.one_apply]
    simp [apply_ite]

  have s3 : ∀ (m : ℕ) (c d : Fin m → Fin m → K), (∀ i, c i i = d i i) →
      (∀ i j, c i j + c j i = d i j + d j i) →
      (∑ p, ∑ q, MvPolynomial.C (c p q) * (MvPolynomial.X p * MvPolynomial.X q) :
          MvPolynomial (Fin m) K) =
        ∑ p, ∑ q, MvPolynomial.C (d p q) * (MvPolynomial.X p * MvPolynomial.X q) := by
    intro m c d hdiag hsym
    rw [← sub_eq_zero, ← Finset.sum_sub_distrib]
    simp only [← Finset.sum_sub_distrib, ← sub_mul, ← map_sub]
    set u : Fin m → Fin m → K := fun p q => c p q - d p q with hu
    have hu0 : ∀ p, u p p = 0 := fun p => by simp [hu, hdiag]
    have hus : ∀ p q, u q p = - u p q := fun p q => by
      simp only [hu]; linear_combination hsym p q
    change (∑ p, ∑ q, MvPolynomial.C (u p q) * (MvPolynomial.X p * MvPolynomial.X q) :
      MvPolynomial (Fin m) K) = 0
    rw [← Finset.sum_product' (f := fun p q =>
      (MvPolynomial.C (u p q) * (MvPolynomial.X p * MvPolynomial.X q) : MvPolynomial (Fin m) K))]
    refine Finset.sum_involution (fun x _ => (x.2, x.1)) ?_ ?_ ?_ ?_
    · rintro ⟨p, q⟩ _
      simp only
      rw [hus p q, map_neg, mul_comm (MvPolynomial.X q) (MvPolynomial.X p)]
      ring
    · rintro ⟨p, q⟩ _ hne heq
      simp only [Prod.mk.injEq] at heq
      obtain ⟨rfl, -⟩ := heq
      exact hne (by simp [hu0])
    · intro x _; simp
    · intro x _; simp

  have s4 : ∀ (m : ℕ), 3 ≤ m → ∀ (a : Fin m → Fin m → K),
      ∃ v : Fin m → K, v ≠ 0 ∧ ∑ p, ∑ q, a p q * v p * v q = 0 := by
    intro m hm a
    haveI := Fintype.ofFinite K
    set f : MvPolynomial (Fin m) K :=
      ∑ p, ∑ q, MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q) with hf
    have hhom : f.IsHomogeneous 2 := by
      apply MvPolynomial.IsHomogeneous.sum
      intro p _
      apply MvPolynomial.IsHomogeneous.sum
      intro q _
      exact ((MvPolynomial.isHomogeneous_X K p).mul (MvPolynomial.isHomogeneous_X K q)).C_mul _
    have hdeg : f.totalDegree < Fintype.card (Fin m) := by
      have := hhom.totalDegree_le
      simp only [Fintype.card_fin]
      omega
    have hev : ∀ x : Fin m → K, MvPolynomial.eval x f = ∑ p, ∑ q, a p q * x p * x q := by
      intro x
      simp [hf, map_sum, mul_assoc]
    haveI : CharP K (ringChar K) := ringChar.charP K
    have hp : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
    have hdvd := char_dvd_card_solutions (K := K) (ringChar K) hdeg
    have hpos : 0 < Fintype.card {x : Fin m → K // MvPolynomial.eval x f = 0} :=
      Fintype.card_pos_iff.mpr ⟨⟨0, by rw [hev]; simp⟩⟩
    have h2 : 1 < Fintype.card {x : Fin m → K // MvPolynomial.eval x f = 0} :=
      lt_of_lt_of_le hp.one_lt (Nat.le_of_dvd hpos hdvd)
    obtain ⟨s, t, hst⟩ := Fintype.one_lt_card_iff.mp h2
    by_cases hs : s.val = 0
    · have ht : t.val ≠ 0 := fun ht => hst (Subtype.ext (hs.trans ht.symm))
      exact ⟨t.val, ht, by rw [← hev]; exact t.2⟩
    · exact ⟨s.val, hs, by rw [← hev]; exact s.2⟩

  have s5 : ∀ (m : ℕ) (a : Fin m → Fin m → K),
      (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 → ∀ (v : Fin m → K), v ≠ 0 →
      ∑ p, ∑ q, a p q * v p * v q = 0 →
      ∃ w : Fin m → K, ∑ p, ∑ q, a p q * w p * w q = 0 ∧
        ∑ p, ∑ q, v p * (a p q + a q p) * w q = 1 := by
    intro m a ha v hv0 hv
    have hSv : (Matrix.of a + (Matrix.of a).transpose).mulVec v ≠ 0 :=
      fun h => ha (Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv0, h⟩)
    obtain ⟨j₀, hj₀⟩ := Function.ne_iff.mp hSv
    set σ := (Matrix.of a + (Matrix.of a).transpose).mulVec v j₀ with hσ
    have hσ' : σ = ∑ p, v p * (a p j₀ + a j₀ p) := by
      rw [hσ]
      simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.of_apply,
        Matrix.transpose_apply]
      exact Finset.sum_congr rfl (fun p _ => by ring)
    have hσ0 : σ ≠ 0 := hj₀
    set w₀ : Fin m → K := Pi.single j₀ σ⁻¹ with hw₀
    have hBvw₀ : (∑ p, ∑ q, v p * (a p q + a q p) * w₀ q) = 1 := by
      have : ∀ p, (∑ q, v p * (a p q + a q p) * w₀ q) = v p * (a p j₀ + a j₀ p) * σ⁻¹ := by
        intro p
        rw [Finset.sum_eq_single j₀]
        · simp [hw₀]
        · intro q _ hq; simp [hw₀, hq]
        · intro h; exact absurd (Finset.mem_univ _) h
      rw [Finset.sum_congr rfl (fun p _ => this p), ← Finset.sum_mul, ← hσ',
        mul_inv_cancel₀ hσ0]
    set t := ∑ p, ∑ q, a p q * w₀ p * w₀ q with ht
    set X1 := ∑ p, ∑ q, a p q * w₀ p * v q with hX1
    set X2 := ∑ p, ∑ q, a p q * v p * w₀ q with hX2
    have hB12 : (∑ p, ∑ q, v p * (a p q + a q p) * w₀ q) = X2 + X1 := by
      have e1 : ∀ p q, v p * (a p q + a q p) * w₀ q =
          a p q * v p * w₀ q + a q p * w₀ q * v p := fun p q => by ring
      simp only [e1, Finset.sum_add_distrib]
      congr 1
      exact Finset.sum_comm
    have hBvv : (∑ p, ∑ q, v p * (a p q + a q p) * v q) =
        2 * ∑ p, ∑ q, a p q * v p * v q := by
      have e1 : ∀ p q, v p * (a p q + a q p) * v q = a p q * v p * v q + a q p * v q * v p :=
        fun p q => by ring
      simp only [e1, Finset.sum_add_distrib]
      rw [Finset.sum_comm (f := fun p q => a q p * v q * v p)]
      ring
    refine ⟨fun i => w₀ i - t * v i, ?_, ?_⟩
    · have e1 : ∀ p q, a p q * (w₀ p - t * v p) * (w₀ q - t * v q) =
          a p q * w₀ p * w₀ q - t * (a p q * w₀ p * v q) - t * (a p q * v p * w₀ q) +
            t ^ 2 * (a p q * v p * v q) := fun p q => by ring
      simp only [e1, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
      rw [← ht, ← hX1, ← hX2, hv]
      have : X2 + X1 = 1 := hB12 ▸ hBvw₀
      linear_combination (-t) * this
    · have e1 : ∀ p q, v p * (a p q + a q p) * (w₀ q - t * v q) =
          v p * (a p q + a q p) * w₀ q - t * (v p * (a p q + a q p) * v q) := fun p q => by ring
      simp only [e1, Finset.sum_sub_distrib, ← Finset.mul_sum]
      rw [hBvw₀, hBvv, hv]
      ring

  have s6 : ∀ (v w : Fin (e + 2 + 1 + 1) → K),
      ∑ p, ∑ q, v p * (a p q + a q p) * v q = 0 →
      ∑ p, ∑ q, w p * (a p q + a q p) * w q = 0 →
      ∑ p, ∑ q, v p * (a p q + a q p) * w q = 1 →
      ∃ P : Matrix (Fin (e + 2 + 1 + 1)) (Fin (e + 2 + 1 + 1)) K, P.det ≠ 0 ∧
        (∀ i, P i 0 = v i) ∧ (∀ i, P i ⟨e + 3, by omega⟩ = w i) ∧
        ∀ j : Fin (e + 2 + 1 + 1), 1 ≤ j.val → j.val ≤ e + 2 →
          (∑ p, ∑ q, v p * (a p q + a q p) * P q j = 0) ∧
          (∑ p, ∑ q, w p * (a p q + a q p) * P q j = 0) := by
    intro v w hvv hww hvw
    let φ : (Fin (e + 2 + 1 + 1) → K) → (Fin (e + 2 + 1 + 1) → K) →ₗ[K] K := fun y =>
      { toFun := fun x => ∑ p, ∑ q, y p * (a p q + a q p) * x q
        map_add' := fun x x' => by
          simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
        map_smul' := fun c x => by
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
          exact Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => by ring)) }
    have hφ : ∀ y x, φ y x = ∑ p, ∑ q, y p * (a p q + a q p) * x q := fun _ _ => rfl
    have hsymm : ∀ x y, φ x y = φ y x := by
      intro x y
      rw [hφ, hφ, Finset.sum_comm]
      exact Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => by ring))
    have hvv' : φ v v = 0 := hvv
    have hww' : φ w w = 0 := hww
    have hvw' : φ v w = 1 := hvw
    have hwv' : φ w v = 1 := by rw [hsymm]; exact hvw
    let f : (Fin (e + 2 + 1 + 1) → K) →ₗ[K] (Fin 2 → K) := LinearMap.pi ![φ v, φ w]
    have hf : ∀ x, f x = ![φ v x, φ w x] := by
      intro x; funext i; fin_cases i <;> rfl
    have hsurj : LinearMap.range f = ⊤ := by
      rw [LinearMap.range_eq_top]
      intro y
      refine ⟨y 0 • w + y 1 • v, ?_⟩
      rw [hf]
      funext i
      fin_cases i <;> simp [hvv', hww', hvw', hwv']
    set W := LinearMap.ker f with hW
    have hdimW : Module.finrank K W = e + 2 := by
      have h := LinearMap.finrank_range_add_finrank_ker f
      rw [hsurj, finrank_top, Module.finrank_fin_fun, Module.finrank_fin_fun] at h
      have h2 : Module.finrank K W = Module.finrank K (LinearMap.ker f) := rfl
      omega
    have hmemW : ∀ x : W, φ v x = 0 ∧ φ w x = 0 := by
      intro x
      have h : f x = 0 := x.2
      rw [hf] at h
      exact ⟨congrFun h 0, congrFun h 1⟩
    let β := Module.finBasisOfFinrankEq K W hdimW
    let P : Matrix (Fin (e + 2 + 1 + 1)) (Fin (e + 2 + 1 + 1)) K := fun i j =>
      if h0 : j.val = 0 then v i else if hl : j.val = e + 3 then w i else
        ((β ⟨j.val - 1, by omega⟩ : W) : Fin (e + 2 + 1 + 1) → K) i
    have hPm : ∀ j : Fin (e + 2 + 1 + 1), (h1 : 1 ≤ j.val) → (h2 : j.val ≤ e + 2) →
        (fun q => P q j) = ((β ⟨j.val - 1, by omega⟩ : W) : Fin (e + 2 + 1 + 1) → K) := by
      intro j h1 h2
      funext q
      simp only [P]
      rw [dif_neg (by omega), dif_neg (by omega)]
    refine ⟨P, ?_, fun i => by simp [P], fun i => by simp [P], ?_⟩
    · intro hdet
      obtain ⟨y, hy0, hy⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
      have hdecomp : P.mulVec y = y 0 • v + y (Fin.last _) • w +
          ∑ k : Fin (e + 2), y ⟨k.val + 1, by omega⟩ • ((β k : W) : Fin (e + 2 + 1 + 1) → K) := by
        funext i
        simp only [Matrix.mulVec, dotProduct, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
          Finset.sum_apply]
        rw [Fin.sum_univ_succ, Fin.sum_univ_castSucc]
        have e0 : P i 0 = v i := by simp [P]
        have el : P i (Fin.last (e + 2)).succ = w i := by simp [P]
        have hl : (Fin.last (e + 2)).succ = Fin.last (e + 2 + 1) := rfl
        rw [e0, el, hl]
        have em : ∀ k : Fin (e + 2), P i (Fin.castSucc k).succ * y (Fin.castSucc k).succ =
            y ⟨k.val + 1, by omega⟩ * ((β k : W) : Fin (e + 2 + 1 + 1) → K) i := by
          intro k
          have hk := k.isLt
          have e1 : (Fin.castSucc k).succ = (⟨k.val + 1, by omega⟩ : Fin (e + 2 + 1 + 1)) :=
            Fin.ext (by simp)
          rw [e1]
          simp only [P]
          rw [dif_neg (by simp), dif_neg (by simp; omega), mul_comm]
          rfl
        simp only [em]
        ring
      rw [hdecomp] at hy
      have hβ : ∀ k, φ v ((β k : W) : Fin (e + 2 + 1 + 1) → K) = 0 ∧
          φ w ((β k : W) : Fin (e + 2 + 1 + 1) → K) = 0 := fun k => hmemW (β k)
      have h1 := congrArg (φ v) hy
      have h2 := congrArg (φ w) hy
      simp only [map_add, map_smul, map_sum, smul_eq_mul, map_zero, (hβ _).1, (hβ _).2,
        mul_zero, Finset.sum_const_zero, add_zero, zero_add, hvv', hvw', hww', hwv', mul_one]
        at h1 h2
      simp only [h1, h2, zero_smul, zero_add] at hy
      have hli := β.linearIndependent
      have hsumW : ∑ k : Fin (e + 2), y ⟨k.val + 1, by omega⟩ • β k = 0 := by
        apply Subtype.ext
        rw [Submodule.coe_sum]
        simpa using hy
      have hcoef := Fintype.linearIndependent_iff.mp hli _ hsumW
      apply hy0
      funext j
      have hj := j.isLt
      rcases (by omega : j.val = 0 ∨ (1 ≤ j.val ∧ j.val ≤ e + 2) ∨ j.val = e + 3) with h | h | h
      · rw [show j = 0 from Fin.ext (by simp [h])]; exact h2
      · have := hcoef ⟨j.val - 1, by omega⟩
        calc y j = y ⟨j.val - 1 + 1, by omega⟩ := congrArg y (Fin.ext (by simp; omega))
          _ = 0 := this
      · rw [show j = Fin.last _ from Fin.ext (by simp [h])]; exact h1
    · intro j hj1 hj2
      have := hmemW (β ⟨j.val - 1, by omega⟩)
      rw [← hPm j hj1 hj2] at this
      exact this

  have s7 : ∀ (c : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K),
      (Matrix.of c + (Matrix.of c).transpose).det ≠ 0 →
      (∀ j : Fin (e + 2 + 1 + 1), 1 ≤ j.val → j.val ≤ e + 2 → c 0 j + c j 0 = 0) →
      (∀ j : Fin (e + 2 + 1 + 1), 1 ≤ j.val → j.val ≤ e + 2 →
        c ⟨e + 3, by omega⟩ j + c j ⟨e + 3, by omega⟩ = 0) →
      (Matrix.of (fun i j : Fin (e + 1 + 1) =>
          c ⟨i.val + 1, by have := i.isLt; omega⟩ ⟨j.val + 1, by have := j.isLt; omega⟩) +
        (Matrix.of (fun i j : Fin (e + 1 + 1) =>
          c ⟨i.val + 1, by have := i.isLt; omega⟩
            ⟨j.val + 1, by have := j.isLt; omega⟩)).transpose).det ≠ 0 := by
    intro c hc h0 hl hdet
    obtain ⟨u, hu0, hu⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    let x : Fin (e + 2 + 1 + 1) → K := fun s =>
      if h : 1 ≤ s.val ∧ s.val ≤ e + 2 then u ⟨s.val - 1, by omega⟩ else 0
    have hsum : ∀ g : Fin (e + 2 + 1 + 1) → K,
        (∑ s, g s * x s) = ∑ k : Fin (e + 1 + 1), g ⟨k.val + 1, by omega⟩ * u k := by
      intro g
      rw [Fin.sum_univ_succ, Fin.sum_univ_castSucc]
      have hx0 : x 0 = 0 := by simp [x]
      have hxl : x (Fin.last (e + 2)).succ = 0 := by
        simp only [x]; rw [dif_neg]; simp
      rw [hx0, hxl, mul_zero, mul_zero, zero_add, add_zero]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      have hk := k.isLt
      have e1 : (Fin.castSucc k).succ = (⟨k.val + 1, by omega⟩ : Fin (e + 2 + 1 + 1)) :=
        Fin.ext (by simp)
      rw [e1]
      congr 1
      simp only [x]
      rw [dif_pos (by simp; omega)]
      exact congrArg u (Fin.ext (by simp))
    have hSx : (Matrix.of c + (Matrix.of c).transpose).mulVec x = 0 := by
      funext r
      simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.of_apply,
        Matrix.transpose_apply, Pi.zero_apply]
      rw [hsum (fun s => c r s + c s r)]
      have hr := r.isLt
      rcases (by omega : r.val = 0 ∨ (1 ≤ r.val ∧ r.val ≤ e + 2) ∨ r.val = e + 3) with h | h | h
      · obtain rfl : r = 0 := Fin.ext (by simp [h])
        refine Finset.sum_eq_zero (fun k _ => ?_)
        rw [h0 _ (by simp) (by have := k.isLt; simp; omega), zero_mul]
      · have := congrFun hu ⟨r.val - 1, by omega⟩
        simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.of_apply,
          Matrix.transpose_apply, Pi.zero_apply] at this
        rw [← this]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        have er : r = ⟨r.val - 1 + 1, by omega⟩ := Fin.ext (by simp; omega)
        rw [← er]
      · rw [show r = ⟨e + 3, by omega⟩ from Fin.ext h]
        refine Finset.sum_eq_zero (fun k _ => ?_)
        rw [hl _ (by simp) (by have := k.isLt; simp; omega), zero_mul]
    have hx0 : x ≠ 0 := by
      intro hx
      apply hu0
      funext k
      have := congrFun hx ⟨k.val + 1, by omega⟩
      simp only [x, Pi.zero_apply] at this
      rw [dif_pos (by simp; omega)] at this
      simpa using this
    exact hc (Matrix.exists_mulVec_eq_zero_iff.mp ⟨x, hx0, hSx⟩)

  have hQ : ∀ d : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K,
      (wcLdpQuad K (e + 2 + 1) d : MvPolynomial (Fin (e + 2 + 1 + 1)) K) =
        ∑ p, ∑ q, MvPolynomial.C (d p q) * (MvPolynomial.X p * MvPolynomial.X q) :=
    fun d => rfl
  have hB2 : ∀ x : Fin (e + 2 + 1 + 1) → K, (∑ p, ∑ q, x p * (a p q + a q p) * x q) =
      2 * ∑ p, ∑ q, a p q * x p * x q := by
    intro x
    have h1 : (∑ p, ∑ q, x p * (a p q + a q p) * x q) =
        (∑ p, ∑ q, a p q * x p * x q) + ∑ p, ∑ q, a q p * x p * x q := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun q _ => by ring)
    have h2 : (∑ p, ∑ q, a q p * x p * x q) = ∑ p, ∑ q, a p q * x p * x q := by
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => by ring))
    rw [h1, h2]
    ring
  obtain ⟨v, hv0, hv⟩ := s4 (e + 2 + 1 + 1) (by omega) a
  obtain ⟨w, hw, hvw⟩ := s5 (e + 2 + 1 + 1) a ha v hv0 hv
  have hvv : (∑ p, ∑ q, v p * (a p q + a q p) * v q) = 0 := by rw [hB2 v, hv, mul_zero]
  have hww : (∑ p, ∑ q, w p * (a p q + a q p) * w q) = 0 := by rw [hB2 w, hw, mul_zero]
  obtain ⟨P, hP, hP0, hPl, hPmid⟩ := s6 v w hvv hww hvw
  have hcol0 : ∀ k : Fin (e + 2 + 1 + 1), k.val = 0 → ∀ i, P i k = v i := by
    intro k hk i
    rw [show k = 0 from Fin.ext (by simp [hk])]
    exact hP0 i
  have hcoll : ∀ k : Fin (e + 2 + 1 + 1), k.val = e + 3 → ∀ i, P i k = w i := by
    intro k hk i
    rw [show k = ⟨e + 3, by omega⟩ from Fin.ext hk]
