    intro 𝒞 _ _ _hD H H2 M _ _ _ m N _ One Sx Ψ eΨ TΨ ιs β σs ρ cup hT hβadd hβ0 hθ hζ he0 hP hV
    obtain ⟨θ, hθ⟩ := hθ
    obtain ⟨ζ⟩ := hζ
    have hβ : ∀ y, β (σs y) = β y ≫ (DerivedCategory.Q.map TΨ)⟦(N : ℤ)⟧' := fun y => hβ0 y _ rfl
    obtain ⟨e0, he01⟩ := he0
    haveI hFull : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).Full :=
      Functor.Full.of_iso (DerivedCategory.singleFunctorIsoCompQ 𝒞 0)
    haveI hFaith : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).Faithful :=
      Functor.Faithful.of_iso (DerivedCategory.singleFunctorIsoCompQ 𝒞 0)
    let Fe := AddEquiv.ofBijective
      ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).mapAddHom
        (X := One) (Y := Sx))
      ⟨(HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).map_injective,
        (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).map_surjective⟩
    let e := e0.trans Fe
    have he1 : e 1 = DerivedCategory.Q.map ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map ιs) := by
      show (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).map (e0 1) = _
      rw [he01]
      rfl
    obtain ⟨tr₀, P, hPnd, hP⟩ := hP
    have hdist := DerivedCategory.mappingCone_triangle_distinguished eΨ
    obtain ⟨V, hVr⟩ := Pretriangulated.Triangle.yoneda_exact₂ _ hdist
      (DerivedCategory.Q.map TΨ - 𝟙 _) (by
        change DerivedCategory.Q.map eΨ ≫ (DerivedCategory.Q.map TΨ - 𝟙 _) = 0
        rw [Preadditive.comp_sub, ← Functor.map_comp, hT, Category.comp_id, sub_self])
    change DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) ⟶ DerivedCategory.Q.obj Ψ at V
    change DerivedCategory.Q.map TΨ - 𝟙 _ =
      DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ V at hVr
    have hord := hV V hVr ζ
    generalize hV' : ζ.inv ≫ V⟦(N : ℤ)⟧' = V' at hord
    let g : ZMod m →+ (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx) ⟶
        (DerivedCategory.Q.obj Ψ)⟦(N : ℤ)⟧) :=
      { toFun := fun l => l.val • V'
        map_zero' := by rw [ZMod.val_zero, zero_smul]
        map_add' := fun a b => by
          have hmod := mod_addOrderOf_nsmul V' (a.val + b.val)
          rw [hord] at hmod
          rw [ZMod.val_add, hmod, add_smul] }
    have hg : ∀ l, g l = l.val • V' := fun l => rfl
    let κ : M →+ ZMod m := e.symm.toAddMonoidHom.comp
      ((Preadditive.rightComp _ ζ.hom).comp θ.symm.toAddMonoidHom)
    have hκ : ∀ v, κ v = e.symm (θ.symm v ≫ ζ.hom) := fun v => rfl
    let Φ : M →+ M →+ AddCircle (1 : ℚ) := (P.comp (g.comp κ)).compl₂ θ.symm.toAddMonoidHom
    have hΦ : ∀ v v', Φ v v' = P (g (κ v)) (θ.symm v') := fun v v' => rfl
    refine ⟨tr₀, Φ, ?_, ?_⟩
    · intro v hv
      have h1 : g (κ v) = 0 := hPnd _ (fun φ => by
        have := hv (θ φ)
        rwa [hΦ, AddEquiv.symm_apply_apply] at this)
      rw [hg] at h1
      have h2 : addOrderOf V' ∣ (κ v).val := addOrderOf_dvd_of_nsmul_eq_zero h1
      rw [hord] at h2
      have h3 : (κ v).val = 0 := Nat.eq_zero_of_dvd_of_lt h2 (ZMod.val_lt _)
      have h4 : κ v = 0 := (ZMod.val_eq_zero _).mp h3
      rw [hκ] at h4
      have h5 : θ.symm v ≫ ζ.hom = 0 := by
        have := congrArg e h4
        rwa [AddEquiv.apply_symm_apply, map_zero] at this
      have h6 : θ.symm v = 0 := by
        have : θ.symm v = (θ.symm v ≫ ζ.hom) ≫ ζ.inv := by
          rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
        rw [this, h5, Limits.zero_comp]
      have := congrArg θ h6
      rwa [AddEquiv.apply_symm_apply, map_zero] at this
    · intro y y'
      have hsub : β (σs y - y) = β (σs y) - β y := by
        apply eq_sub_of_add_eq
        rw [← hβadd, sub_add_cancel]
      have ha : β y ≫ (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦(N : ℤ)⟧' =
          θ.symm (ρ y) := by
        rw [← hθ y, AddEquiv.symm_apply_apply]
      have heL : e (κ (ρ y)) = θ.symm (ρ y) ≫ ζ.hom := by
        rw [hκ, AddEquiv.apply_symm_apply]
      have heL' : e (κ (ρ y)) = (κ (ρ y)).val •
          DerivedCategory.Q.map ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map ιs) := by
        rw [← he1, ← map_nsmul, nsmul_one, ZMod.natCast_zmod_val]
      have hmain : β (σs y - y) =
          DerivedCategory.Q.map ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map ιs) ≫
            g (κ (ρ y)) := by
        rw [hsub, hβ, ← Category.comp_id (β y), Category.assoc, ← Preadditive.comp_sub,
          Category.id_comp, ← CategoryTheory.Functor.map_id, ← Functor.map_sub, hVr,
          Functor.map_comp, ← Category.assoc, ha, hg, Preadditive.comp_nsmul, ← Preadditive.nsmul_comp,
          ← heL', heL, ← hV', Category.assoc, Iso.hom_inv_id_assoc]
      rw [hP _ _ hmain y', hΦ, ← hθ y', AddEquiv.symm_apply_apply]
  obtain ⟨tr₀, Φ, hnd, hid⟩ := key (ℓ ^ k) (n - 1) _ _ _ _ _ (wcEtSuppUnitMap Dx) _
    (wcEtPull DσQ (n - 1)) (wcEtPull DrQ (n - 1))
    (wcEtZModCup (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1) (n - 1) (2 * (n - 1))
      (two_mul (n - 1)).symm) hT hβadd hβ hθ hζ he0 hP hV
  refine ⟨tr₀.comp (wcEtPull Du (2 * (n - 1))), Φ, hnd, fun w z => ?_⟩
  rw [hrpull w, hrpull z, hid, AddMonoidHom.comp_apply, wc_et_pull_cup Du,
    map_sub (wcEtPull Du (n - 1)), ← hσpull]

theorem wc_pencil_odp_shens_tame_inv_milnor_orth (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (ϖ : A) (hϖ : IsLocalRing.maximalIdeal A = Ideal.span {ϖ})
    (σ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶
      Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))))
    (hσ : σ ≫ ξ = ξ)
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom ϖ)
    (y : wcEtZModExt (Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η)) (ℓ ^ k) (n - 1))
    (Dσ : wcEtPullData (Limits.pullback.map D.f (wcEtGeomPt (wcP1Over F'').left η) D.f
        (wcEtGeomPt (wcP1Over F'').left η) (𝟙 _) σ (𝟙 _)
        (by simp) (by rw [Category.comp_id, ← hξ, ← Category.assoc, hσ])) (ℓ ^ k))
    (hy : wcEtPull Dσ (n - 1) y = y)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (r : Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ ⟶
      Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η))
    (hr₁ : r ≫ Limits.pullback.fst D.f (wcEtGeomPt (wcP1Over F'').left η) =
      Limits.pullback.fst (a' ≫ Limits.pullback.snd D.f a) ξ ≫ a' ≫ Limits.pullback.fst D.f a)
    (hr₂ : r ≫ Limits.pullback.snd D.f (wcEtGeomPt (wcP1Over F'').left η) =
      Limits.pullback.snd (a' ≫ Limits.pullback.snd D.f a) ξ)
    (Dr : wcEtPullData r (ℓ ^ k)) :
    ∀ z : wcEtZModExt (Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η)) (ℓ ^ k) (n - 1),
      addOrderOf (wcEtPull Dr (n - 1) y) * addOrderOf (wcEtPull Dr (n - 1) z) ∣ ℓ ^ k :=
by
  classical
  intro z
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
      wcEtGeomPt B c x = c := by
    intro B c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])

  obtain ⟨l⟩ : Nonempty Λ := by
    first
    | exact inferInstance
    | exact IsCofiltered.nonempty
  have ha : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    have h1 := wc_shdata_closed_point_compat _ A Λ W' φ a hA l
    have h2 : (W'.obj l).hom.left ≫ (W'.obj l).right.hom =
        wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')) := Over.w (W'.obj l).hom
    exact (congrArg (fun g => g (IsLocalRing.closedPoint A)) (hA.2.2.2.1 l).symm).trans
      ((comp_ap _ _ _).trans ((congrArg (W'.obj l).right.hom h1).trans
        ((comp_ap _ _ _).symm.trans ((congrArg (fun g => g (IsLocalRing.closedPoint
          (AlgebraicClosure ((wcP1Over F'').left.residueField
            (D.S i (IsLocalRing.closedPoint F'')))))) h2).trans (hγ _ _ _)))))
  have hξne : ξ (IsLocalRing.closedPoint (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ≠
      IsLocalRing.closedPoint A := by
    intro h
    apply hηne
    have h1 : (ξ ≫ a) (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over F'').left.residueField η))) = η :=
      (congrArg (fun g => g (IsLocalRing.closedPoint
        (AlgebraicClosure ((wcP1Over F'').left.residueField η)))) hξ).trans (hγ _ _ _)
    have h2 := (comp_ap ξ a _).symm.trans h1
    have h3 := congrArg a h
    exact h2.symm.trans (h3.trans ha)

  haveI hcyc := wc_pencil_odp_shens_milnor_fibre_top_cyclic F' F'' Y n hn hn2 D ℓ
    (Fact.out : ℓ.Prime) hℓ k i A Λ W' φ a hA x hx B Λ' W'' φ' a' hsh
    (AlgebraicClosure ((wcP1Over F'').left.residueField η)) ξ hξne

  have s4 : ∀ (Z : Scheme.{u}) (m j : ℕ) (e : wcEtZModExt Z m j), m • e = 0 := by
    intro Z m j e
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have h1 : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply (SheafOfModules.toSheaf (wcEtZModRing Z m)).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      exact wc_et_zmod_toSheaf_nsmul_zero Z m _
    have h2 : ∀ c : ℕ, c • e = e.comp (Abelian.Ext.mk₀
        (c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)))) (add_zero j) := by
      intro c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih =>
        rw [succ_nsmul, ih, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
          Abelian.Ext.comp_mk₀_id]
    rw [h2 m, h1, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨tr, Φ, hnd, hid⟩ := wc_pencil_odp_shens_tame_PL_duality F' F'' Y n hn hn2 D ℓ hℓ k i A
    Λ W' φ a hA η hηb hηne ξ hξ ϖ hϖ σ hσ htame Dσ x hx B Λ' W'' φ' a' hsh r hr₁ hr₂ Dr
  have huv : Φ (wcEtPull Dr (n - 1) y) (wcEtPull Dr (n - 1) z) = 0 := by
    rw [hid, hy, sub_self, map_zero, AddMonoidHom.zero_apply, map_zero]
  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hmG := s4 (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1)
  generalize wcEtPull Dr (n - 1) y = u at huv ⊢
  generalize wcEtPull Dr (n - 1) z = v at huv ⊢

  obtain ⟨g, hg⟩ := IsAddCyclic.exists_generator
    (α := wcEtZModExt (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1))
  have hdm : addOrderOf g ∣ ℓ ^ k := addOrderOf_dvd_of_nsmul_eq_zero (hmG g)
  have hdpos : 0 < addOrderOf g := Nat.pos_of_dvd_of_pos hdm hm
  have hnat : ∀ w : wcEtZModExt (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1),
      ∃ c : ℕ, c • g = w := by
    intro w
    obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (hg w)
    refine ⟨(j % (addOrderOf g : ℤ)).toNat, ?_⟩
    have h0 : 0 ≤ j % (addOrderOf g : ℤ) := Int.emod_nonneg _ (by exact_mod_cast hdpos.ne')
    rw [← natCast_zsmul, Int.toNat_of_nonneg h0, mod_addOrderOf_zsmul, hj]
  have hbil : ∀ a b : ℕ, Φ (a • g) (b • g) = (a * b) • Φ g g := by
    intro a b
    rw [map_nsmul (Φ (a • g)), map_nsmul Φ, AddMonoidHom.nsmul_apply, smul_smul, mul_comm]
  have hde : addOrderOf g ∣ addOrderOf (Φ g g) := by
    apply addOrderOf_dvd_of_nsmul_eq_zero
    apply hnd
    intro w
    obtain ⟨c, rfl⟩ := hnat w
    rw [hbil, mul_comm, mul_smul, addOrderOf_nsmul_eq_zero, smul_zero]
  obtain ⟨a₀, rfl⟩ := hnat u
  obtain ⟨b₀, rfl⟩ := hnat v
  set d := addOrderOf g with hd
  have hdab : d ∣ a₀ * b₀ :=
    hde.trans (addOrderOf_dvd_of_nsmul_eq_zero (by rw [← hbil]; exact huv))
  have hp : 0 < Nat.gcd d a₀ := Nat.gcd_pos_of_pos_left a₀ hdpos
  have hord : ∀ c : ℕ, addOrderOf (c • g) ∣ d / Nat.gcd d c := by
    intro c
    apply addOrderOf_dvd_of_nsmul_eq_zero
    rw [smul_smul, Nat.div_mul_right_comm (Nat.gcd_dvd_left d c),
      Nat.mul_div_assoc d (Nat.gcd_dvd_right d c), mul_comm, mul_smul, hd,
      addOrderOf_nsmul_eq_zero, smul_zero]
  have key : d / Nat.gcd d a₀ ∣ Nat.gcd d b₀ := by
    have h1 : d / Nat.gcd d a₀ * Nat.gcd d a₀ ∣ (a₀ / Nat.gcd d a₀ * b₀) * Nat.gcd d a₀ := by
      rw [Nat.div_mul_cancel (Nat.gcd_dvd_left d a₀), mul_right_comm,
        Nat.div_mul_cancel (Nat.gcd_dvd_right d a₀)]
      exact hdab
    have h2 : d / Nat.gcd d a₀ ∣ a₀ / Nat.gcd d a₀ * b₀ := Nat.dvd_of_mul_dvd_mul_right hp h1
    have hcop : Nat.Coprime (d / Nat.gcd d a₀) (a₀ / Nat.gcd d a₀) :=
      Nat.coprime_div_gcd_div_gcd hp
    exact Nat.dvd_gcd (Nat.div_dvd_of_dvd (Nat.gcd_dvd_left d a₀)) (hcop.dvd_of_dvd_mul_left h2)
  refine (Nat.mul_dvd_mul (hord a₀) (hord b₀)).trans ((mul_dvd_mul_right key _).trans ?_)
  rw [Nat.mul_div_cancel' (Nat.gcd_dvd_left d b₀)]
  exact hdm

theorem wc_et_proper_zmod_coh_card_eventually_linear (K : Type u) [Field K] [IsAlgClosed K]
    (Z : Scheme.{u}) (f : Z ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : (ℓ : K) ≠ 0) (q : ℕ) :
    ∃ β τ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → Nat.card (wcEtCoh Z (ℓ ^ k) q) = ℓ ^ (β * k + τ) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  have s4 : ∀ (n x y : ℕ → ℕ) (B : ℕ),
      (∀ m, 1 ≤ m → n (m + 1) + y m = n m + x m) →
      (∀ m, 1 ≤ m → x (m + 1) ≤ x m) →
      (∀ m, 1 ≤ m → y m ≤ y (m + 1)) →
      (∀ m, 1 ≤ m → y m ≤ B) →
      (∀ m, 1 ≤ m → x m ≤ n 1) →
      ∃ β τ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ k : ℕ, k₀ ≤ k → n k = β * k + τ := by
    intro n x y B h1 h2 h3 h4 h5
    have chain : ∀ z : ℕ → ℕ, (∀ m, 1 ≤ m → z (m + 1) ≤ z m) →
        ∀ m m', 1 ≤ m → m ≤ m' → z m' ≤ z m := by
      intro z hz m m' hm hmm'
      induction m', hmm' using Nat.le_induction with
      | base => exact le_rfl
      | succ k hk ih => exact (hz k (by omega)).trans ih
    have stab : ∀ z : ℕ → ℕ, (∀ m, 1 ≤ m → z (m + 1) ≤ z m) →
        ∃ m₁, 1 ≤ m₁ ∧ (∀ m, m₁ ≤ m → z m = z m₁) ∧ ∀ m, 1 ≤ m → z m₁ ≤ z m := by
      intro z hz
      have hex : ∃ v, ∃ m, 1 ≤ m ∧ z m = v := ⟨z 1, 1, le_rfl, rfl⟩
      obtain ⟨m₁, hm₁, hz₁⟩ := Nat.find_spec hex
      have hmin : ∀ m, 1 ≤ m → z m₁ ≤ z m := by
        intro m hm
        rw [hz₁]
        exact Nat.find_min' hex ⟨m, hm, rfl⟩
      refine ⟨m₁, hm₁, fun m hm => le_antisymm (chain z hz m₁ m hm₁ hm) (hmin m (by omega)), hmin⟩
    have hyanti : ∀ m, 1 ≤ m → (fun m => B - y m) (m + 1) ≤ (fun m => B - y m) m := by
      intro m hm
      have := h3 m hm; have := h4 (m + 1) (by omega); show B - y (m+1) ≤ B - y m; omega
    obtain ⟨m₁, hm₁, hx1, hx2⟩ := stab x h2
    obtain ⟨m₂, hm₂, hy1, hy2⟩ := stab (fun m => B - y m) hyanti
    set a := x m₁ with ha
    set b := y m₂ with hb
    have hyb : ∀ m, 1 ≤ m → y m ≤ b := by
      intro m hm
      rcases le_total m m₂ with h | h
      · have := chain (fun m => B - y m) hyanti m m₂ hm h
        have := h4 m hm; have := h4 m₂ hm₂; beta_reduce at *; omega
      · have := hy1 m h; have := h4 m hm; have := h4 m₂ hm₂; beta_reduce at *; omega
    have hyeq : ∀ m, m₂ ≤ m → y m = b := by
      intro m hm
      have := hy1 m hm; have := h4 m (by omega); have := h4 m₂ hm₂; beta_reduce at *; omega
    set m₀ := max m₁ m₂ with hm₀
    have hrec : ∀ m, m₀ ≤ m → n (m + 1) + b = n m + a := by
      intro m hm
      have e1 := h1 m (by omega)
      rw [hx1 m (by omega), hyeq m (by omega)] at e1
      exact e1
    have hjj : ∀ j, n (m₀ + j) + j * b = n m₀ + j * a := by
      intro j
      induction j with
      | zero => simp
      | succ j ih =>
        have := hrec (m₀ + j) (by omega)
        rw [← add_assoc]
        nlinarith
    have hba : b ≤ a := by
      by_contra hlt
      push_neg at hlt
      have := hjj (n m₀ + 1)
      nlinarith
    obtain ⟨c, hc⟩ : ∃ c, a = b + c := ⟨a - b, by omega⟩
    have hF : ∀ m, 1 ≤ m → c * m ≤ n m := by
      intro m hm
      induction m, hm using Nat.le_induction with
      | base =>
        have := h5 1 le_rfl
        have := hx2 1 le_rfl
        simp only [mul_one]; omega
      | succ k hk ih =>
        have e1 := h1 k hk
        have e2 := hx2 k hk
        have e3 := hyb k hk
        rw [mul_add, mul_one]
        omega
    refine ⟨c, n m₀ - c * m₀, m₀, by omega, fun k hk => ?_⟩
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
    have e1 := hjj j
    have e2 := hF m₀ (by omega)
    rw [hc, mul_add] at e1
    rw [mul_add]
    have : j * c = c * j := mul_comm _ _
    omega

  have s3 : ∀ (m : ℕ) (M : Type (u+2)) [AddCommGroup M] [Finite M],
      (∀ x : M, ℓ ^ m • x = 0) → ∃ e : ℕ, Nat.card M = ℓ ^ e := by
    intro m M _ _ hM
    refine ⟨(Nat.card M).primeFactorsList.length, Nat.eq_prime_pow_of_unique_prime_dvd
      Nat.card_pos.ne' ?_⟩
    intro d hd hdvd
    haveI : Fact d.Prime := ⟨hd⟩
    obtain ⟨x, hx⟩ := exists_prime_addOrderOf_dvd_card' d hdvd
    have h1 : d ∣ ℓ ^ m := hx ▸ addOrderOf_dvd_of_nsmul_eq_zero (hM x)
    exact (Nat.prime_dvd_prime_iff_eq hd hℓp).mp (hd.dvd_of_dvd_pow h1)

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _

  have cardKerRange : ∀ {M N : Type (u+2)} [AddCommGroup M] [AddCommGroup N] (φ : M →+ N),
      Nat.card M = Nat.card φ.range * Nat.card φ.ker := by
    intro M N _ _ φ
    rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup φ.ker,
      Nat.card_congr (QuotientAddGroup.quotientKerEquivRange φ).toEquiv]
  have s2 : ∀ (P : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (A : ℕ → Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (f : ∀ m, A 1 ⟶ A (m + 1)) (g : ∀ m, A (m + 1) ⟶ A m) (u : ∀ m, A m ⟶ A (m + 1))
      (w : ∀ m, f m ≫ g m = 0),
      (∀ m, 1 ≤ m → (ShortComplex.mk (f m) (g m) (w m)).ShortExact) →
      (∀ m, 1 ≤ m → f (m + 1) = f m ≫ u (m + 1)) →
      (∀ m, 1 ≤ m → u (m + 1) ≫ g (m + 1) = g m ≫ u m) →
      (∀ m, 1 ≤ m → Finite (Abelian.Ext P (A m) q)) →
      Finite (Abelian.Ext P (A 1) (q + 1)) →
      ∃ X Y : ℕ → ℕ, ∀ m, 1 ≤ m →
        Nat.card (Abelian.Ext P (A (m + 1)) q) * Y m = Nat.card (Abelian.Ext P (A m) q) * X m ∧
        X (m + 1) ≤ X m ∧ Y m ≤ Y (m + 1) ∧
        X m ∣ Nat.card (Abelian.Ext P (A 1) q) ∧
        Y m ∣ Nat.card (Abelian.Ext P (A 1) (q + 1)) := by
    intro P A f g u w hS hf hg hfin hfinH
    let α : ∀ m, Abelian.Ext P (A 1) q →+ Abelian.Ext P (A (m + 1)) q := fun m =>
      (Abelian.Ext.mk₀ (f m)).postcomp P (add_zero q)
    let ρ : ∀ m, Abelian.Ext P (A (m + 1)) q →+ Abelian.Ext P (A m) q := fun m =>
      (Abelian.Ext.mk₀ (g m)).postcomp P (add_zero q)
    let σ : ∀ m, Abelian.Ext P (A m) q →+ Abelian.Ext P (A (m + 1)) q := fun m =>
      (Abelian.Ext.mk₀ (u m)).postcomp P (add_zero q)
    let δ : ∀ m, 1 ≤ m → Abelian.Ext P (A m) q →+ Abelian.Ext P (A 1) (q + 1) := fun m hm =>
      (hS m hm).extClass.postcomp P rfl
    have hα : ∀ m x, α m x = x.comp (Abelian.Ext.mk₀ (f m)) (add_zero q) := fun _ _ => rfl
    have hρ : ∀ m x, ρ m x = x.comp (Abelian.Ext.mk₀ (g m)) (add_zero q) := fun _ _ => rfl
    have hσ : ∀ m x, σ m x = x.comp (Abelian.Ext.mk₀ (u m)) (add_zero q) := fun _ _ => rfl
    have hδ : ∀ m hm x, δ m hm x = x.comp (hS m hm).extClass rfl := fun _ _ _ => rfl
    refine ⟨fun m => Nat.card (α m).range,
      fun m => if hm : 1 ≤ m then Nat.card (δ m hm).range else 0, fun m hm => ?_⟩
    have hm1 : 1 ≤ m + 1 := by omega
    simp only [dif_pos hm, dif_pos hm1]
    have ha : (ρ m).ker = (α m).range := by
      ext x
      constructor
      · intro hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS m hm) x hx
        exact ⟨y, hy⟩
      · rintro ⟨y, rfl⟩
        show ρ m (α m y) = 0
        rw [hρ, hα, Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, w m, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    have hb : (δ m hm).ker = (ρ m).range := by
      ext x
      constructor
      · intro hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS m hm) x rfl hx
        exact ⟨y, hy⟩
      · rintro ⟨y, rfl⟩
        show δ m hm (ρ m y) = 0
        rw [hδ m hm, hρ, Abelian.Ext.comp_assoc _ _ _ (add_zero q) (zero_add 1) (by omega)]
        have := (hS m hm).comp_extClass
        simp only [ShortComplex.mk] at this
        rw [this, Abelian.Ext.comp_zero]
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · have c1 := cardKerRange (ρ m)
      have c2 := cardKerRange (δ m hm)
      rw [ha] at c1
      rw [hb] at c2
      rw [c1, c2]
      ring
    · have hcomp : α (m + 1) = (σ (m + 1)).comp (α m) := by
        ext x
        simp only [AddMonoidHom.comp_apply]
        rw [hσ, hα, hα, hf m hm, ← Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega)]
      haveI := hfin (m + 1) hm1
      have hsurj : Function.Surjective (fun y : (α m).range =>
          (⟨σ (m + 1) y, by
            obtain ⟨z, hz⟩ := y.2
            exact ⟨z, by rw [hcomp, AddMonoidHom.comp_apply, hz]⟩⟩ : (α (m + 1)).range)) := by
        rintro ⟨y, z, rfl⟩
        exact ⟨⟨α m z, z, rfl⟩, Subtype.ext (by simp only [hcomp, AddMonoidHom.comp_apply])⟩
      exact Nat.card_le_card_of_surjective _ hsurj
    · have hnat := (hS m hm).extClass_naturality (hS (m + 1) hm1)
        (ShortComplex.homMk (S₁ := ShortComplex.mk (f m) (g m) (w m))
          (S₂ := ShortComplex.mk (f (m + 1)) (g (m + 1)) (w (m + 1)))
          (𝟙 (A 1)) (u (m + 1)) (u m)
          (by simp only [Category.id_comp]; exact hf m hm) (hg m hm))
      simp only [ShortComplex.homMk] at hnat
      rw [Abelian.Ext.comp_mk₀_id] at hnat
      have hle : (δ m hm).range ≤ (δ (m + 1) hm1).range := by
        rintro _ ⟨x, rfl⟩
        refine ⟨σ m x, ?_⟩
        rw [hδ m hm, hδ (m + 1) hm1, hσ,
          Abelian.Ext.comp_assoc _ _ _ (add_zero q) (zero_add 1) (by omega), ← hnat]
      haveI := hfinH
      exact AddSubgroup.card_le_of_le hle
    · have := cardKerRange (α m)
      exact ⟨_, this.trans rfl⟩
    · exact AddSubgroup.card_addSubgroup_dvd_card _

  have hℓ0 : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓp.ne_zero
  have hk0 : ∀ m : ℕ, (zmultiplesHom (ZMod (ℓ ^ (m + 1))) ((ℓ ^ m : ℕ) : ZMod (ℓ ^ (m + 1))))
      ((ℓ ^ 1 : ℕ) : ℤ) = 0 := by
    intro m
    rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, ← pow_add,
      add_comm 1 m, ZMod.natCast_self]
  have hk1 : ∀ m : ℕ, (zmultiplesHom (ZMod (ℓ ^ (m + 1))) ((ℓ : ℕ) : ZMod (ℓ ^ (m + 1))))
      ((ℓ ^ m : ℕ) : ℤ) = 0 := by
    intro m
    rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, ← pow_succ,
      ZMod.natCast_self]
  let α₀ : ∀ m : ℕ, ZMod (ℓ ^ 1) →+ ZMod (ℓ ^ (m + 1)) := fun m =>
    ZMod.lift (ℓ ^ 1) ⟨zmultiplesHom (ZMod (ℓ ^ (m + 1))) ((ℓ ^ m : ℕ) : ZMod (ℓ ^ (m + 1))), hk0 m⟩
  let ν₀ : ∀ m : ℕ, ZMod (ℓ ^ m) →+ ZMod (ℓ ^ (m + 1)) := fun m =>
    ZMod.lift (ℓ ^ m) ⟨zmultiplesHom (ZMod (ℓ ^ (m + 1))) ((ℓ : ℕ) : ZMod (ℓ ^ (m + 1))), hk1 m⟩
  let β₀ : ∀ m : ℕ, ZMod (ℓ ^ (m + 1)) →+ ZMod (ℓ ^ m) := fun m =>
    (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m))).toAddMonoidHom
  have hα₀ : ∀ (m : ℕ) (z : ℤ), α₀ m (z : ZMod (ℓ ^ 1)) =
      ((z * ((ℓ ^ m : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (m + 1))) := by
    intro m z
    show (ZMod.lift (ℓ ^ 1) ⟨zmultiplesHom (ZMod (ℓ ^ (m + 1))) ((ℓ ^ m : ℕ) : ZMod (ℓ ^ (m + 1))),
      hk0 m⟩) (z : ZMod (ℓ ^ 1)) = _
    rw [ZMod.lift_coe]
    change z • ((ℓ ^ m : ℕ) : ZMod (ℓ ^ (m + 1))) = _
    rw [zsmul_eq_mul]
    push_cast
    ring
  have hν₀ : ∀ (m : ℕ) (z : ℤ), ν₀ m (z : ZMod (ℓ ^ m)) =
      ((z * (ℓ : ℤ) : ℤ) : ZMod (ℓ ^ (m + 1))) := by
    intro m z
    show (ZMod.lift (ℓ ^ m) ⟨zmultiplesHom (ZMod (ℓ ^ (m + 1))) ((ℓ : ℕ) : ZMod (ℓ ^ (m + 1))),
      hk1 m⟩) (z : ZMod (ℓ ^ m)) = _
    rw [ZMod.lift_coe]
    change z • ((ℓ : ℕ) : ZMod (ℓ ^ (m + 1))) = _
    rw [zsmul_eq_mul]
    push_cast
    ring
  have hβ₀ : ∀ (m : ℕ) (z : ℤ), β₀ m (z : ZMod (ℓ ^ (m + 1))) = (z : ZMod (ℓ ^ m)) := fun m z =>
    map_intCast (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m))) z
  let A' : ℕ → AddCommGrpCat.{u+1} := fun m => AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m)))
  let F : ∀ m, A' 1 ⟶ A' (m + 1) := fun m =>
    AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp (α₀ m)).comp
      AddEquiv.ulift.toAddMonoidHom)
  let G : ∀ m, A' (m + 1) ⟶ A' m := fun m =>
    AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp (β₀ m)).comp
      AddEquiv.ulift.toAddMonoidHom)
  let V : ∀ m, A' m ⟶ A' (m + 1) := fun m =>
    AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp (ν₀ m)).comp
      AddEquiv.ulift.toAddMonoidHom)
  have hβα : ∀ m x, β₀ m (α₀ m x) = 0 := by
    intro m x
    obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
    rw [hα₀, hβ₀, ZMod.intCast_zmod_eq_zero_iff_dvd]
    exact Dvd.intro_left z rfl
  have w0 : ∀ m, F m ≫ G m = 0 := by
    intro m
    ext x
    exact hβα m x.down
  have hS0 : ∀ m, 1 ≤ m → (ShortComplex.mk (F m) (G m) (w0 m)).ShortExact := by
    intro m _
    have hαinj : Function.Injective (α₀ m) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα₀, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hx' : (ℓ : ℤ) ^ m * ℓ ∣ (ℓ : ℤ) ^ m * z := by
        push_cast at hx
        rw [pow_succ, mul_comm z] at hx
        exact hx
      have := (mul_dvd_mul_iff_left (pow_ne_zero m hℓ0)).mp hx'
      push_cast
      simpa using this
    have hβsurj : Function.Surjective (β₀ m) := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (ℓ ^ (m + 1))), hβ₀ m z⟩
    have hker : ∀ y, β₀ m y = 0 → ∃ x, α₀ m x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ₀, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod (ℓ ^ 1)), ?_⟩
      rw [hα₀]
      congr 1
      ring
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩
  have hF0 : ∀ m, F (m + 1) = F m ≫ V (m + 1) := by
    intro m
    ext x
    show α₀ (m + 1) x.down = ν₀ (m + 1) (α₀ m x.down)
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective x.down
    rw [← hz, hα₀, hα₀, hν₀]
    congr 1
    push_cast
    ring
  have hG0 : ∀ m, V (m + 1) ≫ G (m + 1) = G m ≫ V m := by
    intro m
    ext x
    show β₀ (m + 1) (ν₀ (m + 1) x.down) = ν₀ m (β₀ m x.down)
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective x.down
    rw [← hz, hν₀, hβ₀, hβ₀, hν₀]
  have htor0 : ∀ m, (ℓ ^ m) • 𝟙 (A' m) = 0 := by
    intro m
    ext x
    show (ℓ ^ m) • x.down = 0
    rw [nsmul_eq_mul]
    simp

  let cs := constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}
  haveI : Limits.PreservesFiniteLimits cs :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Z)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
  let P := cs.obj (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let A : ℕ → Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} := fun m => cs.obj (A' m)
  have hcoh : ∀ m i, wcEtCoh Z (ℓ ^ m) i = Abelian.Ext P (A m) i := fun _ _ => rfl

  have w : ∀ m, cs.map (F m) ≫ cs.map (G m) = 0 := by
    intro m
    rw [← cs.map_comp, w0 m, cs.map_zero]
  have hS : ∀ m, 1 ≤ m → (ShortComplex.mk (cs.map (F m)) (cs.map (G m)) (w m)).ShortExact :=
    fun m hm => (hS0 m hm).map_of_exact cs
  have hf : ∀ m, 1 ≤ m → cs.map (F (m + 1)) = cs.map (F m) ≫ cs.map (V (m + 1)) := by
    intro m _
    rw [← cs.map_comp, hF0 m]
  have hg : ∀ m, 1 ≤ m → cs.map (V (m + 1)) ≫ cs.map (G (m + 1)) = cs.map (G m) ≫ cs.map (V m) := by
    intro m _
    rw [← cs.map_comp, ← cs.map_comp, hG0 m]

  have hfin : ∀ m i, Finite (Abelian.Ext P (A m) i) := by
    intro m i
    rw [← hcoh]
    exact wc_etale_proper_finite K Z f (ℓ ^ m) (by rw [Nat.cast_pow]; exact pow_ne_zero _ hℓ) i

  have htor : ∀ m i (x : Abelian.Ext P (A m) i), ℓ ^ m • x = 0 := by
    intro m i x
    have hid : (ℓ ^ m) • 𝟙 (A m) = 0 := by
      show (ℓ ^ m) • 𝟙 (cs.obj (A' m)) = 0
      rw [← cs.map_id, ← Functor.map_nsmul, htor0 m, cs.map_zero]
    have hind : ∀ n : ℕ, x.comp (Abelian.Ext.mk₀ (n • 𝟙 (A m))) (add_zero i) = n • x := by
      intro n
      induction n with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
          Abelian.Ext.comp_mk₀_id]
    rw [← hind, hid, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  have hpowcard : ∀ m i, ∃ e : ℕ, Nat.card (Abelian.Ext P (A m) i) = ℓ ^ e := by
    intro m i
    haveI := hfin m i
    exact s3 m _ (htor m i)

  obtain ⟨X, Y, hXY⟩ := s2 P A (fun m => cs.map (F m)) (fun m => cs.map (G m))
    (fun m => cs.map (V m)) w hS hf hg (fun m _ => hfin m q) (hfin 1 (q + 1))

  choose n hn using fun m => hpowcard m q
  obtain ⟨eH, heH⟩ := hpowcard 1 (q + 1)
  have hxex : ∀ m, ∃ x : ℕ, 1 ≤ m → x ≤ n 1 ∧ X m = ℓ ^ x := by
    intro m
    by_cases hm : 1 ≤ m
    · have h := (hXY m hm).2.2.2.1
      rw [hn 1] at h
      obtain ⟨x, hx, hxe⟩ := (Nat.dvd_prime_pow hℓp).mp h
      exact ⟨x, fun _ => ⟨hx, hxe⟩⟩
    · exact ⟨0, fun h => absurd h hm⟩
  have hyex : ∀ m, ∃ y : ℕ, 1 ≤ m → y ≤ eH ∧ Y m = ℓ ^ y := by
    intro m
    by_cases hm : 1 ≤ m
    · have h := (hXY m hm).2.2.2.2
      rw [heH] at h
      obtain ⟨y, hy, hye⟩ := (Nat.dvd_prime_pow hℓp).mp h
      exact ⟨y, fun _ => ⟨hy, hye⟩⟩
    · exact ⟨0, fun h => absurd h hm⟩
  choose x hx using hxex
  choose y hy using hyex
  have hm1 : ∀ m, 1 ≤ m → 1 ≤ m + 1 := fun m _ => by omega
  obtain ⟨β, τ, k₀, hk₀, hlin⟩ := s4 n x y eH
    (fun m hm => by
      have h := (hXY m hm).1
      rw [hn, hn, (hx m hm).2, (hy m hm).2, ← pow_add, ← pow_add] at h
      exact Nat.pow_right_injective hℓp.two_le h)
    (fun m hm => by
      have h := (hXY m hm).2.1
      rw [(hx m hm).2, (hx (m + 1) (hm1 m hm)).2] at h
      exact (Nat.pow_le_pow_iff_right hℓp.one_lt).mp h)
    (fun m hm => by
      have h := (hXY m hm).2.2.1
      rw [(hy m hm).2, (hy (m + 1) (hm1 m hm)).2] at h
      exact (Nat.pow_le_pow_iff_right hℓp.one_lt).mp h)
    (fun m hm => (hy m hm).1)
    (fun m hm => (hx m hm).1)

  refine ⟨β, τ, k₀, fun k hk => ?_⟩
  rw [hcoh, hn k, hlin k hk]

theorem wc_pencil_odp_shens_milnor_restr_count (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
