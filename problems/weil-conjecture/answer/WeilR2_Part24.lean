  rw [wc_et_pull_comp w (Limits.pullback.fst gV ξ) _ rfl Dw Dr Dc q y₁,
    wc_et_pull_comp w (Limits.pullback.fst gV ξ) _ rfl Dw Dr Dc q y₂, hy]

