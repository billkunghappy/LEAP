          ∃ t : (SheafOfModules.unit (wcEtZModRing S ℓ)).val.obj (Opposite.op W'),
            ((ι 0).val.app (Opposite.op W')).hom t =
              (((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont
                D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology
                  (q + 1)).val.map g'.op).hom s) ∈ Scheme.smallEtaleTopology S W := by
      intro W s
      refine (Scheme.smallEtaleTopology S).superset_covering ?_ (hsurj W s)
      apply Sieve.generate_mono
      rintro W' g' ⟨c, hc⟩
      exact ⟨c 0, by rw [hc, Fin.sum_univ_one]⟩
    haveI := wc_et_mod_isIso_of_inj_locsurj (ι 0) hinj0 hsurj0
    exact ⟨(asIso (ι 0)).symm⟩

theorem wc_srdcbR_proper_sepclosed_shens_base_pull_bij : ∀ (K : Type u) [Field K] [IsSepClosed K] (X : Scheme.{u}) (f : X ⟶ Spec (.of K)) [IsProper f] (m : ℕ), (m : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (PA : Scheme.{u}) (r : PA ⟶ X) (t : PA ⟶ Spec (.of A)), IsPullback r t f s → ∀ (E : wcEtPullData r m) (q : ℕ), Function.Bijective (wcEtPull E q) :=
by
  intro K _ _ X f _ m hm A _ _ _ s PA r t h E q
  classical
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero
  haveI ht : IsProper t := MorphismProperty.of_isPullback (P := @IsProper) h inferInstance
  have hPB0 := IsPullback.of_hasPullback t
    (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
  obtain ⟨Di⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) m
  obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) ≫ r) m
  have hi : Function.Bijective (wcEtPull Di q) :=
    wc_r2gs_hens_closed_fibre_pull_bij A PA t m hm0 wc_et_henselian_proper_vanishing _ _ _
      hPB0 Di q
  have hse : Spec.map (CommRingCat.ofHom ((IsLocalRing.residue A).comp (Spec.preimage s).hom)) =
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ s := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hsq : IsPullback
      (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) ≫ r)
      (Limits.pullback.snd t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) f
      (Spec.map (CommRingCat.ofHom ((IsLocalRing.residue A).comp (Spec.preimage s).hom))) := by
    rw [hse]
    exact hPB0.paste_horiz h
  have hc : Function.Bijective (wcEtPull Dc q) :=
    wc_et_sepclosed_field_ext_proper_pull_bij K (IsLocalRing.ResidueField A)
      ((IsLocalRing.residue A).comp (Spec.preimage s).hom) X f _ _ _ hsq m hm Dc q
  refine (Function.Bijective.of_comp_iff' hi _).mp ?_
  convert hc using 1
  funext x
  exact (wc_et_pull_comp r _ _ rfl E Di Dc q x).symm

theorem wc_srdcbR_projK_sepclosed_zmod_shape : ∀ (κ : Type u) [Field κ] [IsSepClosed κ] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : κ) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (N q : ℕ), (Even q ∧ q ≤ 2 * N → ∃ Ω : wcEtZModExt (wcProjK κ N) (ℓ ^ k) q, (∀ α : wcEtZModExt (wcProjK κ N) (ℓ ^ k) q, ∃ c : ℕ, α = c • Ω) ∧ ∀ c : ℕ, c • Ω = 0 → ℓ ^ k ∣ c) ∧ (¬ (Even q ∧ q ≤ 2 * N) → ∀ α : wcEtZModExt (wcProjK κ N) (ℓ ^ k) q, α = 0) :=
by
  classical
  intro κ _ _ ℓ _ hℓ k hk
  have hℓp : ℓ.Prime := Fact.out
  have hm : 0 < ℓ ^ k := pow_pos hℓp.pos k

  have trA : ∀ (Y Y' : Scheme.{u}) (q q' : ℕ)
      (e : wcEtZModExt Y (ℓ ^ k) q ≃+ wcEtZModExt Y' (ℓ ^ k) q'),
      (∃ Ω : wcEtZModExt Y (ℓ ^ k) q, (∀ α : wcEtZModExt Y (ℓ ^ k) q, ∃ c : ℕ, α = c • Ω) ∧
        ∀ c : ℕ, c • Ω = 0 → ℓ ^ k ∣ c) →
      (∃ Ω : wcEtZModExt Y' (ℓ ^ k) q', (∀ α : wcEtZModExt Y' (ℓ ^ k) q', ∃ c : ℕ, α = c • Ω) ∧
        ∀ c : ℕ, c • Ω = 0 → ℓ ^ k ∣ c) := by
    intro Y Y' q q' e ⟨Ω, hg, ho⟩
    refine ⟨e Ω, fun β => ?_, fun c hc => ho c ?_⟩
    · obtain ⟨c, hc⟩ := hg (e.symm β)
      exact ⟨c, by rw [← map_nsmul, ← hc, AddEquiv.apply_symm_apply]⟩
    · apply e.injective
      rw [map_nsmul, hc, map_zero]
  have trB : ∀ (Y Y' : Scheme.{u}) (q q' : ℕ)
      (e : wcEtZModExt Y (ℓ ^ k) q ≃+ wcEtZModExt Y' (ℓ ^ k) q'),
      (∀ a : wcEtZModExt Y (ℓ ^ k) q, a = 0) → ∀ b : wcEtZModExt Y' (ℓ ^ k) q', b = 0 := by
    intro Y Y' q q' e h b
    rw [← AddEquiv.apply_symm_apply e b, h (e.symm b), map_zero]

  have h0 : ∀ (Y : Scheme.{u}) [IrreducibleSpace Y], ∃ Ω : wcEtZModExt Y (ℓ ^ k) 0,
      (∀ α : wcEtZModExt Y (ℓ ^ k) 0, ∃ c : ℕ, α = c • Ω) ∧ ∀ c : ℕ, c • Ω = 0 → ℓ ^ k ∣ c := by
    intro Y _
    obtain ⟨Ω, hΩ⟩ : ∃ Ω : wcEtZModExt Y (ℓ ^ k) 0, Ω = (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _)
        _ _ (𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k)))) : wcEtZModExt Y (ℓ ^ k) 0) :=
      ⟨_, rfl⟩
    have hne : Nonempty Y := inferInstance
    have hord : ∀ c : ℕ, c • Ω = 0 → ℓ ^ k ∣ c := by
      intro c hc
      rw [hΩ] at hc
      exact wc_et_zmod_unit_class_nsmul_eq_zero Y hne (ℓ ^ k) hm c hc
    refine ⟨Ω, ?_, hord⟩
    obtain ⟨hfin, hcard⟩ := wc_et_coh_zero_irreducible_card_le Y (ℓ ^ k) hm.ne'
    obtain ⟨eZ⟩ := wc_et_zmodext_coh_equiv Y (ℓ ^ k) 0
    haveI : Finite (wcEtZModExt Y (ℓ ^ k) 0) := Finite.of_equiv _ eZ.symm
    have hcard' : Nat.card (wcEtZModExt Y (ℓ ^ k) 0) ≤ ℓ ^ k :=
      (Nat.card_congr eZ).trans_le hcard
    have key : ∀ a b : Fin (ℓ ^ k), (a : ℕ) ≤ b → (a : ℕ) • Ω = (b : ℕ) • Ω → a = b := by
      intro a b hab h
      have h1 : ((b : ℕ) - a) • Ω + (a : ℕ) • Ω = 0 + (a : ℕ) • Ω := by
        rw [← add_nsmul, Nat.sub_add_cancel hab, zero_add]
        exact h.symm
      have h2 := hord _ (add_right_cancel h1)
      have h3 := Nat.eq_zero_of_dvd_of_lt h2 (lt_of_le_of_lt (Nat.sub_le _ _) b.isLt)
      exact Fin.ext (by omega)
    have hinj : Function.Injective (fun c : Fin (ℓ ^ k) => (c : ℕ) • Ω) := by
      intro a b h
      rcases le_total (a : ℕ) b with hab | hab
      · exact key a b hab h
      · exact (key b a hab h.symm).symm
    have hbij := hinj.bijective_of_nat_card_le
      (hcard'.trans_eq (by simp))
    intro α
    obtain ⟨c, hc⟩ := hbij.2 α
    exact ⟨c, hc.symm⟩

  have hyp : ∀ (K : Type u) [Field K] (e : ℕ), ∃ ι : wcProjK K e ⟶ wcProjK K (e + 1),
      IsClosedImmersion ι ∧ ι ≫ wcProjKStr K (e + 1) = wcProjKStr K e ∧
      Set.range ι = ((wcSgD K (e + 1) (Fin.last (e + 1)) : (wcProjK K (e + 1)).Opens) :
        Set (wcProjK K (e + 1)))ᶜ := by
    intro K _ e
    have s4 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
        [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
        (f : 𝒜 →+*ᵍ ℬ)
        (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
        {ι : Type} (s : ι → A) (d : ι → ℕ), (∀ i, s i ∈ 𝒜 (d i)) → (∀ i, 0 < d i) →
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range s) →
        (∀ i, Function.Surjective (HomogeneousLocalization.Away.map f (s i))) →
        IsClosedImmersion (Proj.map f hf) := by
      intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf ι s d hs hd hcov hsurj
      refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
        (fun i => Proj.basicOpen 𝒜 (s i)) (Proj.iSup_basicOpen_eq_top 𝒜 s hcov) ?_
      intro i
      have hs' : f (s i) ∈ ℬ (d i) := f.map_mem (hs i)
      let iV := Proj.awayι 𝒜 (s i) (hs i) (hd i)
      let iU := Proj.awayι ℬ (f (s i)) hs' (hd i)
      let g := Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (s i)))
      have hc : iU ≫ Proj.map f hf = g ≫ iV := Proj.awayι_comp_map f hf (hd i) (s i) (hs i)
      have hpre : Proj.map f hf ⁻¹ᵁ iV.opensRange = iU.opensRange := by
        simp only [iV, iU, Proj.opensRange_awayι]
        exact Proj.map_preimage_basicOpen f hf (s i)
      have hpb : IsPullback g iU iV (Proj.map f hf) := IsOpenImmersion.isPullback g iU iV _ hc hpre
      have hg : IsClosedImmersion g :=
        IsClosedImmersion.spec_of_surjective _ (by simpa using hsurj i)
      have h1 : IsClosedImmersion (Limits.pullback.snd (Proj.map f hf) iV) :=
        (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
          (Arrow.isoMk hpb.flip.isoPullback (Iso.refl _)
            (by
              dsimp only [Arrow.mk_hom, Iso.refl_hom]
              rw [Category.comp_id]
              exact IsPullback.isoPullback_hom_snd _))).mp hg
      have h2 : IsClosedImmersion (Proj.map f hf ∣_ iV.opensRange) :=
        (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
          (morphismRestrictOpensRange _ iV)).mpr h1
      exact (MorphismProperty.arrow_mk_iso_iff @IsClosedImmersion
        (morphismRestrictEq _ (Proj.opensRange_awayι 𝒜 (s i) (hs i) (hd i)))).mp h2
    have s3 : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
        [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
        (f : 𝒜 →+*ᵍ ℬ), (∀ (n : ℕ) (b : B), b ∈ ℬ n → ∃ a ∈ 𝒜 n, f a = b) →
        ∀ (s : A) (d : ℕ), s ∈ 𝒜 d → Function.Surjective (HomogeneousLocalization.Away.map f s) := by
      intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hsurj s d hs y
      obtain ⟨n, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective ℬ (f.map_mem hs) y
      obtain ⟨a, ha, rfl⟩ := hsurj _ b hb
      exact ⟨_, HomogeneousLocalization.Away.map_mk f s hs n a ha⟩
    have s1 : ∀ (n : ℕ) (p : MvPolynomial (Fin n) K),
        letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) K) := MvPolynomial.gradedAlgebra
        p ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin n) K) ↔
          p.coeff 0 = 0 := by
      intro n p
      letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin n) K) := MvPolynomial.gradedAlgebra
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      erw [MvPolynomial.decomposition.decompose'_apply]
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero]
    letI iA : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    letI iB : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) :=
      MvPolynomial.gradedAlgebra
    let g : Fin (e + 1 + 1) → MvPolynomial (Fin (e + 1)) K := fun t =>
      if h : t.val < e + 1 then MvPolynomial.X ⟨t.val, h⟩ else 0
    let c : Fin (e + 1) → Fin (e + 1 + 1) := fun j => ⟨j.val, by have := j.isLt; omega⟩
    have hg : ∀ t, (g t).IsHomogeneous 1 := by
      intro t
      dsimp only [g]
      split_ifs
      · exact MvPolynomial.isHomogeneous_X K _
      · exact MvPolynomial.isHomogeneous_zero _ _ 1
    have hgc : ∀ j, g (c j) = MvPolynomial.X j := by
      intro j
      have h : (c j).val < e + 1 := j.isLt
      dsimp only [g]
      rw [dif_pos h]
    have hX0 : ∀ t, g t = 0 ↔ ¬ (t.val < e + 1) := by
      intro t
      by_cases h : t.val < e + 1
      · have h' : g t = MvPolynomial.X ⟨t.val, h⟩ := by dsimp only [g]; rw [dif_pos h]
        rw [h']
        exact iff_of_false (MvPolynomial.X_ne_zero _) (not_not.mpr h)
      · have h' : g t = 0 := by dsimp only [g]; rw [dif_neg h]
        exact iff_of_true h' h
    have hsurjc : ∀ t, g t ≠ 0 → ∃ j, c j = t := by
      intro t ht
      have h : t.val < e + 1 := by
        by_contra h
        exact ht ((hX0 t).mpr h)
      exact ⟨⟨t.val, h⟩, Fin.ext rfl⟩
    have hT : ∀ t : Fin (e + 1 + 1), g t = 0 ↔ t = Fin.last (e + 1) := by
      intro t
      rw [hX0]
      have ht := t.isLt
      constructor
      · intro h
        apply Fin.ext
        rw [Fin.val_last]
        omega
      · rintro rfl
        rw [Fin.val_last]
        omega
    let φ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K)
        (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) :=
      ⟨(MvPolynomial.aeval g).toRingHom, fun {n x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        have := hx.aeval g hg
        rw [one_mul] at this
        exact this⟩
    let ψ : GradedRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K)
        (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) :=
      ⟨(MvPolynomial.rename c).toRingHom, fun {n x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        exact hx.rename_isHomogeneous⟩
    have hφ : ∀ a, φ a = MvPolynomial.aeval g a := fun a => rfl
    have hψ : ∀ b, ψ b = MvPolynomial.rename c b := fun b => rfl
    have hφψ : ∀ b, φ (ψ b) = b := by
      intro b
      rw [hφ, hψ, MvPolynomial.aeval_rename]
      have hgc' : g ∘ c = MvPolynomial.X := funext hgc
      rw [hgc', MvPolynomial.aeval_X_left_apply]
    have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) ≤
        HomogeneousIdeal.map φ
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K)) := by
      intro b hb
      have hb0 : b.coeff 0 = 0 := (s1 (e + 1) b).mp hb
      have hψb : ψ b ∈
          HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) := by
        apply (s1 (e + 1 + 1) (ψ b)).mpr
        rw [hψ]
        rw [← MvPolynomial.constantCoeff_eq] at hb0 ⊢
        exact (MvPolynomial.constantCoeff_rename c b).trans hb0
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map, ← hφψ b]
      exact Ideal.mem_map_of_mem φ (HomogeneousIdeal.mem_iff.mpr hψb)
    have hdeg : ∀ (n : ℕ) (b : MvPolynomial (Fin (e + 1)) K),
        b ∈ MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K n →
        ∃ a ∈ MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K n, φ a = b :=
      fun n b hb => ⟨ψ b, ψ.map_mem hb, hφψ b⟩
    have hcov : (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (e + 1 + 1) → MvPolynomial (Fin (e + 1 + 1)) K)) := by
      intro x hx
      have hx0 : x.coeff 0 = 0 := (s1 (e + 1 + 1) x).mp (HomogeneousIdeal.mem_iff.mp hx)
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) hx0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ _, by simpa using hi⟩
    have hX : ∀ i : Fin (e + 1 + 1),
        (MvPolynomial.X i : MvPolynomial (Fin (e + 1 + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 1 :=
      fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K i)
    let L : wcProjK K e ⟶ wcProjK K (e + 1) := Proj.map φ hf
    have hLci : IsClosedImmersion L := s4 φ hf (fun i : Fin (e + 1 + 1) => MvPolynomial.X i)
      (fun _ => 1) hX (fun _ => Nat.one_pos) hcov (fun i => s3 φ hdeg _ 1 (hX i))
    have hpre : ∀ a : MvPolynomial (Fin (e + 1 + 1)) K,
        L ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K) a =
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K) (φ a) :=
      fun a => Proj.map_preimage_basicOpen φ hf a
    let f₀ : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0) →+*
        ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K 0) :=
      { toFun := fun a => ⟨φ a, φ.map_mem a.2⟩
        map_one' := Subtype.ext (by
          show φ ((1 : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one])
        map_mul' := fun a b => Subtype.ext (by
          show φ ((a * b : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [SetLike.GradeZero.coe_mul, SetLike.GradeZero.coe_mul, map_mul])
        map_zero' := Subtype.ext (by
          show φ ((0 : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [ZeroMemClass.coe_zero, ZeroMemClass.coe_zero, map_zero])
        map_add' := fun a b => Subtype.ext (by
          show φ ((a + b : ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) :
            MvPolynomial (Fin (e + 1 + 1)) K) = _
          rw [AddMemClass.coe_add, AddMemClass.coe_add, map_add]) }
    have hLstr : L ≫ wcProjKStr K (e + 1) = wcProjKStr K e := by
      have hb := wc_bc_proj_map_toSpecZero φ hf f₀ (fun a => rfl)
      have hcomp : f₀.comp (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0)) =
          algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1)) K 0) := by
        apply RingHom.ext
        intro r
        apply Subtype.ext
        show φ ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 1 + 1)) K 0) r :
          MvPolynomial (Fin (e + 1 + 1)) K)) = _
        rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ]
        exact (MvPolynomial.aeval g).commutes r
      show L ≫ (Proj.toSpecZero _ ≫ Spec.map _) = Proj.toSpecZero _ ≫ Spec.map _
      rw [← Category.assoc, hb, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
    have hret : ∀ a : MvPolynomial (Fin (e + 1 + 1)) K,
        a - ψ (φ a) ∈ Ideal.span (MvPolynomial.X '' {t : Fin (e + 1 + 1) | g t = 0}) := by
      intro a
      have key : (Ideal.Quotient.mkₐ K (Ideal.span (MvPolynomial.X '' {t : Fin (e + 1 + 1) | g t = 0}))).comp
          ((MvPolynomial.rename c).comp (MvPolynomial.aeval g)) =
          Ideal.Quotient.mkₐ K (Ideal.span (MvPolynomial.X '' {t : Fin (e + 1 + 1) | g t = 0})) := by
        apply MvPolynomial.algHom_ext
        intro t
        rw [AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.aeval_X]
        by_cases ht : g t = 0
