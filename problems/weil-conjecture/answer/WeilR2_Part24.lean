    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (E₁ : Over (Spec (.of K))) [SmoothOfRelativeDimension e E₁.hom]
    (jE₁ : E₁.left ⟶ wcProjK K (e + 1)) (hjE₁ : IsClosedImmersion jE₁)
    (hjEY₁ : jE₁ ≫ wcProjKStr K (e + 1) = E₁.hom)
    (hEG₁ : ∀ (x : E₁.left) (c : Fin (e + 1 + 1)) (hx : x ∈ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
      wcLdpGerm K (e + 1) jE₁ (wcLdpQuad K (e + 1) a') c x hx ∈
        IsLocalRing.maximalIdeal (E₁.left.presheaf.stalk x))
    (hEall₁ : ∀ p : wcProjK K (e + 1), (∀ (c : Fin (e + 1 + 1)) (hp : p ∈ wcSgD K (e + 1) c),
        ((wcProjK K (e + 1)).presheaf.germ (wcSgD K (e + 1) c) p hp).hom
            (wcLdpSec K (e + 1) (wcLdpQuad K (e + 1) a') c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 1)).presheaf.stalk p)) → p ∈ Set.range jE₁)
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ)
    (D : Over (Spec (.of K))) [SmoothOfRelativeDimension (e + 1) D.hom]
    (iD : D.left ⟶ Op.toScheme) (hiD : IsClosedImmersion iD) (hiDE : iD ≫ Op.ι ≫ E₀.hom = D.hom)
    (hrange : Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left)) :
    ∃ (σ : E₁.left ⟶ D.left) (π : D.left ⟶ E₁.left),
      σ ≫ D.hom = E₁.hom ∧ π ≫ E₁.hom = D.hom ∧ σ ≫ π = 𝟙 _ ∧
      ∀ (c : Fin (e + 1 + 1)) (J L : Fin (e + 2 + 1 + 1)) (O : D.left.Opens)
        (hO : O ≤ ((π ≫ σ) ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J)
        (hOW : O ≤ (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
        ((π ≫ σ) ≫ iD ≫ Op.ι ≫ jE).appLE (wcSgD K (e + 2 + 1) J) O hO
            (wcSgE K (e + 2 + 1) J L) *
          D.left.presheaf.map (homOfLE hOW).op (wcScqCcV K e (iD ≫ Op.ι ≫ jE) c J) =
        D.left.presheaf.map (homOfLE hOW).op (wcScqCcV K e (iD ≫ Op.ι ≫ jE) c L) :=
by
  obtain ⟨σ, hσK, hσbo, hσrel⟩ := wc_scq_cc_sigma_lift K e a' b hb E₀ jE hjE hjEY hEall
    E₁ jE₁ hjE₁ hjEY₁ hEG₁ U Op hU hOp D iD hiD hiDE hrange
  obtain ⟨π, hπK, hπbo, hπrel⟩ := wc_scq_cc_pi_lift K e a' b hb E₀ jE hjEY hEG
    E₁ jE₁ hjE₁ hjEY₁ hEall₁ U Op hU hOp D iD hiDE hrange
  exact ⟨σ, π, hσK, hπK,
    wc_scq_cc_sec_retr K e E₀ jE Op E₁ jE₁ hjE₁ hjEY₁ D iD σ π hσK hπK hσbo hσrel hπrel,
    wc_scq_cc_rho_coords K e E₀ jE Op E₁ jE₁ D iD σ π hσrel hπbo hπrel⟩

theorem wc_projK_scale_first_coord (K : Type u) [Field K] (n : ℕ) (T : Scheme.{u})
    (fT : T ⟶ Spec (.of K)) (g : T ⟶ wcProjK K (n + 1))
    (hcov : ∀ x : T, ∃ c : Fin (n + 1), g x ∈ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩) :
    ∃ ht : Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⟶
        wcProjK K (n + 1),
      ht ≫ wcProjKStr K (n + 1) =
          Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ fT ∧
      (∀ (c : Fin (n + 1)) (J : Fin (n + 1 + 1)),
        ht ⁻¹ᵁ wcSgD K (n + 1) J ⊓
            Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
              (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩) =
          (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).basicOpen
            (wcScqHtTuple K n fT g c J)) ∧
      ∀ (c : Fin (n + 1)) (J L : Fin (n + 1 + 1))
        (O : (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).Opens)
        (hO : O ≤ ht ⁻¹ᵁ wcSgD K (n + 1) J)
        (hOW : O ≤ Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
              (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)),
        ht.appLE (wcSgD K (n + 1) J) O hO (wcSgE K (n + 1) J L) *
            (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.map
              (homOfLE hOW).op (wcScqHtTuple K n fT g c J) =
          (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.map
              (homOfLE hOW).op (wcScqHtTuple K n fT g c L) :=
by
  have Φ : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (V V' : Y.Opens) (W' : X.Opens) (hV : V' ≤ V)
      (e : W' ≤ f ⁻¹ᵁ V') (hW : W' ≤ f ⁻¹ᵁ V) (s : Γ(Y, V)),
      X.presheaf.map (homOfLE hW).op ((f.app V).hom s) =
        (f.appLE V' W' e).hom (Y.presheaf.map (homOfLE hV).op s) := by
    intro X Y f V V' W' hV e hW s
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.app_eq_appLE,
      Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  have RR : ∀ {X : Scheme.{u}} (U V W : X.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U)
      (s : Γ(X, U)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op s) =
        X.presheaf.map (homOfLE h3).op s := by
    intro X U V W h1 h2 h3 s
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have RRh : ∀ {X : Scheme.{u}} (U V W : X.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U)
      (s : Γ(X, U)),
      X.presheaf.map (homOfLE h2).op ((X.presheaf.map (homOfLE h1).op).hom s) =
        (X.presheaf.map (homOfLE h3).op).hom s := fun U V W h1 h2 h3 s => RR U V W h1 h2 h3 s
  have key : ∀ (P : Scheme.{u}) (p : P ⟶ T) (τ : Γ(P, ⊤))
      (r : ∀ c : Fin (n + 1), Fin (n + 1 + 1) →
        Γ(P, p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)))
      (hr : ∀ (c : Fin (n + 1)) (J : Fin (n + 1 + 1)), r c J = if J.val = 0 then
          (P.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1)
            ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ≤ ⊤)).op).hom τ *
          (p.app (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
            ((g.app (wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
              (wcSgE K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ J))
        else
          (p.app (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
            ((g.app (wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
              (wcSgE K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ J))),
      ∃ ht : P ⟶ wcProjK K (n + 1), ht ≫ wcProjKStr K (n + 1) = p ≫ fT ∧
        (∀ (c : Fin (n + 1)) (J : Fin (n + 1 + 1)), ht ⁻¹ᵁ wcSgD K (n + 1) J ⊓
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) =
            P.basicOpen (r c J)) ∧
        ∀ (c : Fin (n + 1)) (J L : Fin (n + 1 + 1)) (O : P.Opens)
          (hO : O ≤ ht ⁻¹ᵁ wcSgD K (n + 1) J)
          (hOW : O ≤ p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)),
          ht.appLE (wcSgD K (n + 1) J) O hO (wcSgE K (n + 1) J L) *
            P.presheaf.map (homOfLE hOW).op (r c J) =
          P.presheaf.map (homOfLE hOW).op (r c L) := by
    intro P p τ r hr
    have hU : (⨆ c : Fin (n + 1),
        p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      obtain ⟨c, hc⟩ := hcov (p x)
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨c, hc⟩
    have hr1 : ∀ (c : Fin (n + 1)) (J : Fin (n + 1 + 1)), J.val ≠ 0 → r c J =
        (p.app (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
            ((g.app (wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
              (wcSgE K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ J)) := by
      intro c J hJ
      rw [hr, if_neg hJ]
    have hdiag : ∀ c : Fin (n + 1), r c ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ = 1 := by
      intro c
      rw [hr1 c _ (by simp), (wc_projK_chart_tuple_facts K (n + 1) T g
        ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩).1, map_one]
    have hspan : ∀ c : Fin (n + 1), Ideal.span (Set.range (r c)) = ⊤ := fun c =>
      Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨_, hdiag c⟩) isUnit_one
    have hle : ∀ c c' : Fin (n + 1),
        p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
        p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ ⊓
          g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) := by
      intro c c' x hx
      exact hx
    have hA : ∀ (c c' : Fin (n + 1)) (L : Fin (n + 1 + 1)),
        P.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩))).op
          ((p.app (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩)).hom
            ((g.app (wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩)).hom
              (wcSgE K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩ L))) =
        P.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩))).op
          ((p.app (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩)).hom
            ((g.app (wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩)).hom
              (wcSgE K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩
                ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩))) *
        P.presheaf.map (homOfLE (inf_le_left :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩))).op
          ((p.app (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
            ((g.app (wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
              (wcSgE K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ L))) := by
      intro c c' L
      obtain ⟨-, -, h3, -⟩ := wc_projK_chart_tuple_facts K (n + 1) T g
        ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩
      rw [Φ p _ _ _ inf_le_right (hle c c'), Φ p _ _ _ inf_le_right (hle c c'),
        Φ p _ _ _ inf_le_left (hle c c'), ← map_mul, h3 L]
    have hunit : ∀ c c' : Fin (n + 1),
        P.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩))).op
          (r c' ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) *
        P.presheaf.map (homOfLE (inf_le_left :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩))).op
          (r c ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) = 1 := by
      intro c c'
      obtain ⟨-, -, -, h4⟩ := wc_projK_chart_tuple_facts K (n + 1) T g
        ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩
      rw [hr1 c' _ (by simp), hr1 c _ (by simp), Φ p _ _ _ inf_le_right (hle c c'),
        Φ p _ _ _ inf_le_left (hle c c'), ← map_mul, h4, map_one]
    have htr : ∀ (c c' : Fin (n + 1)) (J : Fin (n + 1 + 1)),
        P.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩))).op
          (r c' J) =
        P.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩))).op
          (r c' ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) *
        P.presheaf.map (homOfLE (inf_le_left :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩))).op
          (r c J) := by
      intro c c' J
      rw [hr1 c' ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ (by simp)]
      by_cases hJ : J.val = 0
      · rw [hr c' J, hr c J, if_pos hJ, if_pos hJ, map_mul, map_mul,
          RRh _ _ _ _ _ le_top, RRh _ _ _ _ _ le_top, hA c c' J]
        ring
      · rw [hr1 c' J hJ, hr1 c J hJ]
        exact hA c c' J
    obtain ⟨φ, h1, h2, h3⟩ := wc_projK_glue_local_coords K (n + 1) P (p ≫ fT)
      (fun c : Fin (n + 1) =>
        p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)) hU r hspan
      (fun c c' => P.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩) ⊓
            p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩) ≤
          p ⁻¹ᵁ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c'.val + 1, Nat.succ_lt_succ c'.isLt⟩))).op
          (r c' ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩))
      (fun c c' => IsUnit.of_mul_eq_one _ (hunit c c')) htr
    exact ⟨φ, h1, h2, h3⟩
  exact key _ (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
    ((Limits.pullback.snd fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial K))).inv.hom Polynomial.X))
    (wcScqHtTuple K n fT g) (fun c J => rfl)

theorem wc_projK_scale_quad_germ (K : Type u) [Field K] (n : ℕ) (T : Scheme.{u})
    (fT : T ⟶ Spec (.of K)) (g : T ⟶ wcProjK K (n + 1)) (hg : g ≫ wcProjKStr K (n + 1) = fT)
    (ht : Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⟶
        wcProjK K (n + 1))
    (hht : ht ≫ wcProjKStr K (n + 1) =
        Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ fT)
    (c : Fin (n + 1))
    (hbo : ∀ J : Fin (n + 1 + 1), ht ⁻¹ᵁ wcSgD K (n + 1) J ⊓
        Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
          (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩) =
        (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).basicOpen
          (wcScqHtTuple K n fT g c J))
    (hrel : ∀ (J L : Fin (n + 1 + 1))
        (O : (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).Opens)
        (hO : O ≤ ht ⁻¹ᵁ wcSgD K (n + 1) J)
        (hOW : O ≤ Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
              (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)),
        ht.appLE (wcSgD K (n + 1) J) O hO (wcSgE K (n + 1) J L) *
            (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.map
              (homOfLE hOW).op (wcScqHtTuple K n fT g c J) =
          (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.map
              (homOfLE hOW).op (wcScqHtTuple K n fT g c L))
    (w : Fin (n + 1 + 1) → Fin (n + 1 + 1) → K)
    (hw0 : ∀ p : Fin (n + 1 + 1), w p 0 = 0)
    (hw0' : ∀ q : Fin (n + 1 + 1), q ≠ Fin.last (n + 1) → w 0 q = 0)
    (hlast : (g.app (wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)).hom
        (wcSgE K (n + 1) ⟨c.val + 1, by omega⟩ (Fin.last (n + 1))) = 0)
    (hgerm : ∀ (x : T) (hx : x ∈ g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩),
        wcLdpGerm K (n + 1) g (wcLdpQuad K (n + 1) w) ⟨c.val + 1, by omega⟩ x hx ∈
          IsLocalRing.maximalIdeal (T.presheaf.stalk x)) :
    ∀ (y : ↥(Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))))
      (hy : y ∈ Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
          (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩))
      (J : Fin (n + 1 + 1)) (hJ : ht y ∈ wcSgD K (n + 1) J),
      ((wcProjK K (n + 1)).presheaf.germ (wcSgD K (n + 1) J) (ht y) hJ).hom
          (wcLdpSec K (n + 1) (wcLdpQuad K (n + 1) w) J) ∈
        IsLocalRing.maximalIdeal ((wcProjK K (n + 1)).presheaf.stalk (ht y)) :=
by

  have hconst : ∀ (m : ℕ) (a : Fin (m + 1)) (p : wcProjK K m) (hp : p ∈ wcSgD K m a) (c : K),
      ((wcProjK K m).presheaf.germ (wcSgD K m a) p hp).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c))) =
        wcLdpConst K (wcProjKStr K m) p c := by
    intro m a p hp c
    have f_deg : (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
    have h1 : (wcSgD K m a).ι =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)
            f_deg one_pos := by
      rw [← Proj.basicOpenIsoSpec_hom _ _ f_deg one_pos,
        ← Proj.basicOpenIsoSpec_inv_ι _ _ f_deg one_pos, Iso.hom_inv_id_assoc]
    have h2 : (wcSgD K m a).ι ≫ wcProjKStr K m =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
              (Submonoid.powers (MvPolynomial.X a)))) := by
      rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ f_deg one_pos]
      simp only [wcProjKStr, Category.assoc]
    have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (MvPolynomial.X a)).appTop =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)))).hom ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K m a).topIso.inv :=
      Proj.basicOpenToSpec_app_top _ _
    have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
          (wcSgD K m a).ι.appTop =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K m a).topIso.inv := by
      rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, h4]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have h3 : (wcSgD K m a).ι.appTop ≫ (wcSgD K m a).topIso.hom =
        (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      first
        | (erw [← Functor.map_comp]; rfl)
        | (simp only [← Functor.map_comp]; rfl)
        | exact ((wcProjK K m).presheaf.map_comp _ _).symm
    have H' : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
          (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (MvPolynomial.X a) := by
      rw [← h3, reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
    have e := congrArg (fun φ => φ.hom c) H'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
    have hg := congrArg (fun φ => φ.hom ((wcProjKStr K m).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)))
      (TopCat.Presheaf.germ_res (wcProjK K m).presheaf (homOfLE (le_top : wcSgD K m a ≤ ⊤)) p hp)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hg
    rw [← e]
    exact hg

  have hsec : ∀ (N : ℕ) (a : Fin (N + 1)) (v : Fin (N + 1) → Fin (N + 1) → K),
      wcLdpSec K N (wcLdpQuad K N v) a =
        ∑ p, ∑ q, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X a)).hom
            (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              (Submonoid.powers (MvPolynomial.X a))
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) (v p q))) *
          wcSgE K N a p * wcSgE K N a q := by
    intro N a v
    have hc : ∀ c : K, (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers (MvPolynomial.X a))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := by
      intro c
      rfl
    unfold wcLdpSec wcSgE
    simp only [← map_mul, ← map_sum]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply]
    simp only [map_sum, map_mul, HomogeneousLocalization.algebraMap_apply, hc,
      HomogeneousLocalization.Away.val_mk]
    unfold wcLdpQuad
    simp only [Localization.mk_sum]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    rw [Localization.mk_mul, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_mul, Submonoid.coe_one, OneMemClass.coe_one]
    ring

  have expand : ∀ {X : Scheme.{u}} (s : X ⟶ Spec (.of K)) (ι : X ⟶ wcProjK K (n + 1))
      (hιX : ι ≫ wcProjKStr K (n + 1) = s) (a : Fin (n + 1 + 1)) (x : X)
      (hx : x ∈ ι ⁻¹ᵁ wcSgD K (n + 1) a),
      wcLdpGerm K (n + 1) ι (wcLdpQuad K (n + 1) w) a x hx =
        ∑ p, ∑ q, wcLdpConst K s x (w p q) *
          (X.presheaf.germ (ι ⁻¹ᵁ wcSgD K (n + 1) a) x hx).hom
            ((ι.app (wcSgD K (n + 1) a)).hom (wcSgE K (n + 1) a p)) *
          (X.presheaf.germ (ι ⁻¹ᵁ wcSgD K (n + 1) a) x hx).hom
            ((ι.app (wcSgD K (n + 1) a)).hom (wcSgE K (n + 1) a q)) := by
    intro X s ι hιX a x hx
    have s2 : ∀ c : K, (ι.stalkMap x).hom (wcLdpConst K (wcProjKStr K (n + 1)) (ι x) c) =
        wcLdpConst K s x c := by
      intro c
      simp only [wcLdpConst, RingHom.comp_apply]
      refine (Scheme.Hom.germ_stalkMap_apply (f := ι) (U := ⊤) (x := x) (hx := trivial) _).trans ?_
      rw [← hιX, Scheme.Hom.comp_appTop]
      rfl
    have s3 : ∀ c : K, (X.presheaf.germ (ι ⁻¹ᵁ wcSgD K (n + 1) a) x hx).hom
        ((ι.app (wcSgD K (n + 1) a)).hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
              (MvPolynomial.X a)).hom
            (HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K)
              (Submonoid.powers (MvPolynomial.X a))
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0) c)))) =
        wcLdpConst K s x c := by
      intro c
      refine (Scheme.Hom.germ_stalkMap_apply (f := ι) (U := wcSgD K (n + 1) a) (x := x)
        (hx := hx) _).symm.trans ?_
      rw [hconst (n + 1) a (ι x) hx c]
      exact s2 c
    unfold wcLdpGerm
    rw [hsec (n + 1) a w]
    simp only [map_sum, map_mul, s3]

  have Hloc : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) (z : Y.presheaf.stalk (f x)),
      (f.stalkMap x).hom z ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ↔
        z ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x)) := by
    intro X Y f x z
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
    exact map_mem_nonunits_iff (f.stalkMap x).hom z
  intro y hy J hJ

  rw [← Hloc ht y, Scheme.Hom.germ_stalkMap_apply]
  change wcLdpGerm K (n + 1) ht (wcLdpQuad K (n + 1) w) J y hJ ∈ _

  rw [expand _ ht hht J y hJ]
  have hy0 : y ∈ ht ⁻¹ᵁ wcSgD K (n + 1) J ⊓
      Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
        (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩) := ⟨hJ, hy⟩

  have hC : ∀ p : Fin (n + 1 + 1),
      ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (ht ⁻¹ᵁ wcSgD K (n + 1) J) y hJ).hom
          ((ht.app (wcSgD K (n + 1) J)).hom (wcSgE K (n + 1) J p)) *
        ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c J) =
      ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c p) := by
    intro p
    have h := congrArg
      ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
        _ y hy0).hom (hrel J p _ inf_le_left inf_le_right)
    rw [map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply] at h
    rw [← h]
    congr 1
    exact (TopCat.Presheaf.germ_res_apply _ (homOfLE inf_le_left) y hy0 _).symm

  have hu : IsUnit (((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
      (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
        (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c J)) := by
    have hb : y ∈ (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).basicOpen
        (wcScqHtTuple K n fT g c J) := by
      rw [← hbo J]
      exact hy0
    exact (Scheme.mem_basicOpen _ _ y hy).mp hb

  rw [← Ideal.unit_mul_mem_iff_mem _ (hu.pow 2)]
  have hsum : (((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
      (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
        (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c J)) ^ 2 *
      ∑ p, ∑ q, wcLdpConst K (Limits.pullback.fst fT
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ fT) y (w p q) *
        ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (ht ⁻¹ᵁ wcSgD K (n + 1) J) y hJ).hom
          ((ht.app (wcSgD K (n + 1) J)).hom (wcSgE K (n + 1) J p)) *
        ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (ht ⁻¹ᵁ wcSgD K (n + 1) J) y hJ).hom
          ((ht.app (wcSgD K (n + 1) J)).hom (wcSgE K (n + 1) J q)) =
      ∑ p, ∑ q, wcLdpConst K (Limits.pullback.fst fT
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ fT) y (w p q) *
        ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c p) *
        ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c q) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [← hC p, ← hC q]
    ring
  rw [hsum]

  have hcc : ∀ a : K, wcLdpConst K (Limits.pullback.fst fT
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ fT) y a =
      ((Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).stalkMap y).hom
        (wcLdpConst K fT (Limits.pullback.fst fT
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) y) a) := by
    intro a
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply _ ⊤ y trivial _).symm
  have hτ : ∀ p : Fin (n + 1 + 1), p.val ≠ 0 →
      ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c p) =
      ((Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).stalkMap y).hom
        ((T.presheaf.germ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩) _ hy).hom
          ((g.app (wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)).hom
            (wcSgE K (n + 1) ⟨c.val + 1, by omega⟩ p))) := by
    intro p hp
    unfold wcScqHtTuple
    rw [if_neg hp]
    exact (Scheme.Hom.germ_stalkMap_apply _ _ y hy _).symm
  have key : ∑ p, ∑ q, wcLdpConst K (Limits.pullback.fst fT
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ fT) y (w p q) *
        ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c p) *
        ((Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.germ
          (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) y hy).hom (wcScqHtTuple K n fT g c q) =
      ((Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).stalkMap y).hom
        (∑ p, ∑ q, wcLdpConst K fT (Limits.pullback.fst fT
            (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) y) (w p q) *
          (T.presheaf.germ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩) _ hy).hom
            ((g.app (wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (n + 1) ⟨c.val + 1, by omega⟩ p)) *
          (T.presheaf.germ (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩) _ hy).hom
            ((g.app (wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (n + 1) ⟨c.val + 1, by omega⟩ q))) := by
    rw [map_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    by_cases hq : q.val = 0
    · have hq0 : q = 0 := Fin.ext (by rw [hq, Fin.val_zero])
      rw [hq0, hw0 p]
      simp only [map_zero, zero_mul]
    · by_cases hp : p.val = 0
      · have hp0 : p = 0 := Fin.ext (by rw [hp, Fin.val_zero])
        subst hp0
        by_cases hql : q = Fin.last (n + 1)
        · subst hql
          rw [hτ _ hq, hlast]
          simp only [map_zero, mul_zero]
        · rw [hw0' q hql]
          simp only [map_zero, zero_mul]
      · rw [hτ p hp, hτ q hq, hcc, map_mul, map_mul]
  rw [key, Hloc, ← expand fT g hg ⟨c.val + 1, by omega⟩ _ hy]
  exact hgerm _ hy

theorem wc_projK_scale_section_chart_eq (K : Type u) [Field K] (n : ℕ) (T : Scheme.{u})
    (fT : T ⟶ Spec (.of K)) (g : T ⟶ wcProjK K (n + 1))
    (ht : Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⟶
        wcProjK K (n + 1))
    (hht : ht ≫ wcProjKStr K (n + 1) =
        Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ fT)
    (c : Fin (n + 1))
    (hrel : ∀ (J L : Fin (n + 1 + 1))
        (O : (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).Opens)
        (hO : O ≤ ht ⁻¹ᵁ wcSgD K (n + 1) J)
        (hOW : O ≤ Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
              (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)),
        ht.appLE (wcSgD K (n + 1) J) O hO (wcSgE K (n + 1) J L) *
            (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.map
              (homOfLE hOW).op (wcScqHtTuple K n fT g c J) =
          (Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).presheaf.map
              (homOfLE hOW).op (wcScqHtTuple K n fT g c L))
    (s : T ⟶ Limits.pullback fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
    (t : K)
    (hsf : s ≫ Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = 𝟙 _)
    (hss : s ≫ Limits.pullback.snd fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
        fT ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom t)))
    (g' : T ⟶ wcProjK K (n + 1)) (hg' : g' ≫ wcProjKStr K (n + 1) = fT)
    (v : Fin (n + 1 + 1) → Γ(T, g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩))
    (hv0 : v 0 =
        (T.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ ≤ ⊤)).op).hom
          (fT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom t)) *
        (g.app (wcSgD K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩)).hom
          (wcSgE K (n + 1) ⟨c.val + 1, Nat.succ_lt_succ c.isLt⟩ 0))
    (hv : ∀ J : Fin (n + 1 + 1), J.val ≠ 0 →
        v J = (g.app (wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)).hom
          (wcSgE K (n + 1) ⟨c.val + 1, by omega⟩ J))
    (hg'rel : ∀ (J L : Fin (n + 1 + 1)) (O : T.Opens) (hO : O ≤ g' ⁻¹ᵁ wcSgD K (n + 1) J)
        (hOW : O ≤ g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩),
        g'.appLE (wcSgD K (n + 1) J) O hO (wcSgE K (n + 1) J L) *
            T.presheaf.map (homOfLE hOW).op (v J) =
          T.presheaf.map (homOfLE hOW).op (v L)) :
    (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩).ι ≫ s ≫ ht =
      (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩).ι ≫ g' :=
by
  classical

  have L1 : ∀ {Z : Scheme.{u}} {ι : Type} (D : ι → Z.Opens) (E : ∀ J : ι, ι → Γ(Z, D J))
      {S Y : Scheme.{u}} (f : S ⟶ Y) (h : Y ⟶ Z) (W : Y.Opens)
      (r : ι → Γ(Y, W))
      (hrel : ∀ J L (O : Y.Opens) (hO : O ≤ h ⁻¹ᵁ D J) (hOW : O ≤ W),
        h.appLE (D J) O hO (E J L) * Y.presheaf.map (homOfLE hOW).op (r J) =
          Y.presheaf.map (homOfLE hOW).op (r L))
      (W' : S.Opens) (hW' : W' ≤ f ⁻¹ᵁ W),
      ∀ J L (O : S.Opens) (hO : O ≤ (f ≫ h) ⁻¹ᵁ D J) (hOW : O ≤ W'),
        (f ≫ h).appLE (D J) O hO (E J L) *
            (S.presheaf.map (homOfLE hOW).op).hom ((f.appLE W W' hW').hom (r J)) =
          (S.presheaf.map (homOfLE hOW).op).hom ((f.appLE W W' hW').hom (r L)) := by
    intro Z ι D E S Y f h W r hrel W' hW' J L O hO hOW
    have e₂ : O ≤ f ⁻¹ᵁ (W ⊓ h ⁻¹ᵁ D J) := by
      rw [Scheme.Hom.preimage_inf]
      exact le_inf (hOW.trans hW') (by rw [← Scheme.Hom.comp_preimage]; exact hO)
    have H := congrArg (f.appLE (W ⊓ h ⁻¹ᵁ D J) O e₂).hom
      (hrel J L (W ⊓ h ⁻¹ᵁ D J) inf_le_right inf_le_left)
    rw [map_mul] at H
    have k1 : ∀ x, (f.appLE (W ⊓ h ⁻¹ᵁ D J) O e₂).hom
        ((h.appLE (D J) (W ⊓ h ⁻¹ᵁ D J) inf_le_right).hom x) =
        ((f ≫ h).appLE (D J) O hO).hom x := by
      intro x
      have b1 := congrArg (fun φ => φ.hom x)
        (Scheme.Hom.appLE_comp_appLE f h (D J) (W ⊓ h ⁻¹ᵁ D J) O inf_le_right e₂)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at b1
      exact b1
    have k2 : ∀ y, (f.appLE (W ⊓ h ⁻¹ᵁ D J) O e₂).hom
        ((Y.presheaf.map (homOfLE (inf_le_left : W ⊓ h ⁻¹ᵁ D J ≤ W)).op).hom y) =
        (S.presheaf.map (homOfLE hOW).op).hom ((f.appLE W W' hW').hom y) := by
      intro y
      have b1 := congrArg (fun φ => φ.hom y)
        (Scheme.Hom.map_appLE f e₂ (homOfLE (inf_le_left : W ⊓ h ⁻¹ᵁ D J ≤ W)).op)
      have b2 := congrArg (fun φ => φ.hom y) (Scheme.Hom.appLE_map f hW' (homOfLE hOW).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at b1 b2
      rw [b1, b2]
    have H' : ((f ≫ h).appLE (D J) O hO).hom (E J L) *
        (S.presheaf.map (homOfLE hOW).op).hom ((f.appLE W W' hW').hom (r J)) =
        (S.presheaf.map (homOfLE hOW).op).hom ((f.appLE W W' hW').hom (r L)) := by
      rw [← k1, ← k2, ← k2]
      exact H
    exact H'

  have L3 : ∀ {X Y : Scheme.{u}} (s : X ⟶ Y) (p : Y ⟶ X), s ≫ p = 𝟙 X → ∀ (V : X.Opens)
      (h : V ≤ s ⁻¹ᵁ (p ⁻¹ᵁ V)) (a : Γ(X, V)),
      (s.appLE (p ⁻¹ᵁ V) V h).hom ((p.app V).hom a) = a := by
    intro X Y s p hsp V h a
    have b1 := congrArg (fun φ => φ.hom a)
      (Scheme.Hom.appLE_comp_appLE s p V (p ⁻¹ᵁ V) V le_rfl h)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at b1
    rw [Scheme.Hom.app_eq_appLE, b1]
    have aux : ∀ (f : X ⟶ X) (hf : f = 𝟙 X) (e : V ≤ f ⁻¹ᵁ V), (f.appLE V V e).hom a = a := by
      rintro _ rfl e
      show (X.presheaf.map (homOfLE e).op).hom (((𝟙 X : X ⟶ X).app V).hom a) = a
      rw [Scheme.Hom.id_app]
      show (X.presheaf.map (𝟙 (Opposite.op V))).hom a = a
      rw [CategoryTheory.Functor.map_id]
      rfl
    exact aux _ hsp _

  have H4 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (W : Y.Opens) (V : X.Opens) (h : V ≤ f ⁻¹ᵁ W)
      (x : Γ(Y, ⊤)), (f.appLE W V h).hom ((Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom x) =
        (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (f.appTop.hom x) := by
    intro X Y f W V h x
    have b1 := congrArg (fun φ => φ.hom x) (Scheme.Hom.map_appLE f h (homOfLE (le_top : W ≤ ⊤)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at b1
    rw [b1]
    rfl

  have L2 : ∀ (i : T ⟶ Limits.pullback fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
      (t : K)
      (hi : i ≫ Limits.pullback.snd fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
        fT ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom t))),
      i.appTop.hom ((Limits.pullback.snd fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial K))).inv.hom Polynomial.X)) =
      fT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom t) := by
    intro i t hi
    have e1 := congrArg (fun φ => φ.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial K))).inv.hom Polynomial.X)) hi
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e1
    rw [e1]
    congr 1
    have h2 := congrArg (fun φ => φ.hom Polynomial.X)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (Polynomial.evalRingHom t)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
      Polynomial.coe_evalRingHom, Polynomial.eval_X] at h2
    exact h2.symm

  have hW' : g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩ ≤
      s ⁻¹ᵁ (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
        (g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩)) := by
    rw [← Scheme.Hom.comp_preimage, hsf, Scheme.Hom.id_preimage]

  have hρ : ∀ J, (s.appLE _ _ hW').hom (wcScqHtTuple K n fT g c J) = v J := by
    intro J
    by_cases hJ : J.val = 0
    · have hJ0 : J = 0 := Fin.ext hJ
      subst hJ0
      rw [hv0]
      unfold wcScqHtTuple
      rw [if_pos (show (0 : Fin (n + 1 + 1)).val = 0 from rfl), map_mul, L3 s _ hsf _ hW', H4,
        L2 s t hss]
    · rw [hv J hJ]
      unfold wcScqHtTuple
      rw [if_neg hJ, L3 s _ hsf _ hW']

  have hrelS : ∀ (J L : Fin (n + 1 + 1)) (O : T.Opens)
      (hO : O ≤ (s ≫ ht) ⁻¹ᵁ wcSgD K (n + 1) J)
      (hOW : O ≤ g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩),
      (s ≫ ht).appLE (wcSgD K (n + 1) J) O hO (wcSgE K (n + 1) J L) *
          T.presheaf.map (homOfLE hOW).op (v J) =
        T.presheaf.map (homOfLE hOW).op (v L) := by
    intro J L O hO hOW
    rw [← hρ J, ← hρ L]
    exact L1 (wcSgD K (n + 1)) (wcSgE K (n + 1)) s ht _ (wcScqHtTuple K n fT g c) hrel _ hW'
      J L O hO hOW

  have hK : (s ≫ ht) ≫ wcProjKStr K (n + 1) = g' ≫ wcProjKStr K (n + 1) := by
    rw [Category.assoc, hht, ← Category.assoc, hsf, Category.id_comp, hg']

  have hspan : (⨆ J, T.basicOpen (v J)) = g ⁻¹ᵁ wcSgD K (n + 1) ⟨c.val + 1, by omega⟩ := by
    apply le_antisymm
    · exact iSup_le fun J => T.basicOpen_le (v J)
    · have h1 : v ⟨c.val + 1, by omega⟩ = 1 := by
        rw [hv _ (Nat.succ_ne_zero c.val), (wc_ldpi_oai_sgE_facts K (n + 1)
          ⟨c.val + 1, by omega⟩ ⟨c.val + 1, by omega⟩).1]
        exact map_one _
      refine le_iSup_of_le ⟨c.val + 1, by omega⟩ ?_
      rw [h1, Scheme.basicOpen_one]

  exact wc_csd_proj_uniq_of_relations K (n + 1) T _ (s ≫ ht) g' v hK hspan hrelS hg'rel

theorem wc_scq_cc_homotopy (K : Type u) [Field K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K)))
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (e + 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c),
      wcLdpGerm K (e + 2 + 1) jE (wcLdpQuad K (e + 2 + 1) b) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ)
    (D : Over (Spec (.of K))) [SmoothOfRelativeDimension (e + 1) D.hom]
    (iD : D.left ⟶ Op.toScheme) (hiD : IsClosedImmersion iD) (hiDE : iD ≫ Op.ι ≫ E₀.hom = D.hom)
    (hrange : Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left))
    (ρ : D.left ⟶ D.left) (hρK : ρ ≫ D.hom = D.hom)
    (hρ : ∀ (c : Fin (e + 1 + 1)) (J L : Fin (e + 2 + 1 + 1)) (O : D.left.Opens)
        (hO : O ≤ (ρ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J)
        (hOW : O ≤ (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
        (ρ ≫ iD ≫ Op.ι ≫ jE).appLE (wcSgD K (e + 2 + 1) J) O hO (wcSgE K (e + 2 + 1) J L) *
          D.left.presheaf.map (homOfLE hOW).op (wcScqCcV K e (iD ≫ Op.ι ≫ jE) c J) =
        D.left.presheaf.map (homOfLE hOW).op (wcScqCcV K e (iD ≫ Op.ι ≫ jE) c L))
    (i₀ i₁ : D.left ⟶
        Limits.pullback D.hom (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
    (hi₀f : i₀ ≫ Limits.pullback.fst D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = 𝟙 _)
    (hi₀s : i₀ ≫ Limits.pullback.snd D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
        D.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : K))))
    (hi₁f : i₁ ≫ Limits.pullback.fst D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = 𝟙 _)
    (hi₁s : i₁ ≫ Limits.pullback.snd D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
        D.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (1 : K)))) :
    ∃ h : Limits.pullback D.hom (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⟶
        D.left,
      h ≫ D.hom = Limits.pullback.fst D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ D.hom ∧
      i₀ ≫ h = ρ ∧ i₁ ≫ h = 𝟙 _ :=
by

  haveI := hiD
  haveI := hjE
  have hκ : (iD ≫ Op.ι ≫ jE) ≫ wcProjKStr K (e + 2 + 1) = D.hom := by
    simp only [Category.assoc, hjEY]
    exact hiDE

  haveI hDred : IsReduced D.left := wcpa_dj_sst_smooth_reduced D.hom (e + 1) inferInstance
  have hsnd : SmoothOfRelativeDimension (e + 1) (Limits.pullback.snd D.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (e + 1))
      (IsPullback.of_hasPullback D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) inferInstance
  haveI hPred : IsReduced (Limits.pullback D.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) :=
    wcpa_dj_sst_smooth_reduced _ (e + 1) hsnd

  have N6 := wc_scq_cc_kappa_facts K e b E₀ jE hEG U Op hU hOp D.left iD hrange

  have ht2 : ∀ c' : Fin (e + 2 + 1),
      ((iD ≫ Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) ⟨c'.val + 1, by omega⟩)).hom
        (wcSgE K (e + 2 + 1) ⟨c'.val + 1, by omega⟩ (Fin.last (e + 2 + 1))) = 0 := by
    intro c'
    rw [← AlgebraicGeometry.basicOpen_eq_bot_iff, ← Scheme.Hom.preimage_basicOpen,
      (wc_ldpi_oai_sgE_facts K (e + 2 + 1) _ _).2, eq_bot_iff]
    intro x hx
    exfalso
    exact (N6 x).1 ((Scheme.Hom.mem_preimage _).mp hx).2

  obtain ⟨ht, hht, hbo, hrel⟩ := wc_projK_scale_first_coord K (e + 2) D.left D.hom
    (iD ≫ Op.ι ≫ jE) (fun x => by
      obtain ⟨c, hc⟩ := (N6 x).2.1
      exact ⟨⟨c.val, by omega⟩, hc⟩)

  have hw0 : ∀ p : Fin (e + 2 + 1 + 1), b p 0 = 0 := by
    intro p
    rw [hb]
    split_ifs with h1 h2
    · exfalso
      have := h1.2
      rw [Fin.val_zero] at this
      omega
    · exfalso
      have := h2.2.2.1
      rw [Fin.val_zero] at this
      omega
    · rfl
  have hw0' : ∀ q : Fin (e + 2 + 1 + 1), q ≠ Fin.last (e + 2 + 1) → b 0 q = 0 := by
    intro q hq
    rw [hb]
    split_ifs with h1 h2
    · exfalso
      apply hq
      apply Fin.ext
      rw [Fin.val_last]
      omega
    · exfalso
      have := h2.1
      rw [Fin.val_zero] at this
      omega
    · rfl

  obtain ⟨h, hh⟩ := wc_scq_cc_lift_to_divisor K e b E₀ jE hjE hEall U Op hU hOp D.left iD hiD
    hrange (Limits.pullback D.hom (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
    ht (by
      intro y
      obtain ⟨c, hc⟩ := (N6 (Limits.pullback.fst D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) y)).2.1
      obtain ⟨c', hy⟩ : ∃ c' : Fin (e + 2 + 1), y ∈ Limits.pullback.fst D.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
            ((iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c'.val + 1, by omega⟩) :=
        ⟨⟨c.val, by omega⟩, hc⟩
      refine ⟨?_, ?_, ?_⟩
      · intro J hJ
        exact wc_projK_scale_quad_germ K (e + 2) D.left D.hom (iD ≫ Op.ι ≫ jE) hκ ht hht c'
          (hbo c') (hrel c') b hw0 hw0' (ht2 c') (fun x hx => (N6 x).2.2 _ hx) y hy J hJ
      · intro hlastmem
        have hr : wcScqHtTuple K (e + 2) D.hom (iD ≫ Op.ι ≫ jE) c' (Fin.last (e + 2 + 1)) = 0 := by
          unfold wcScqHtTuple
          rw [if_neg (by simp), ht2 c', map_zero]
        have hb' := hbo c' (Fin.last (e + 2 + 1))
        rw [hr, Scheme.basicOpen_zero] at hb'
        have hmem : y ∈ ht ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) ⊓
            Limits.pullback.fst D.hom
              (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
              ((iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c'.val + 1, by omega⟩) :=
          ⟨hlastmem, hy⟩
        rw [hb'] at hmem
        exact absurd hmem (by simp)
      · refine ⟨c', ?_⟩
        have hr1 : wcScqHtTuple K (e + 2) D.hom (iD ≫ Op.ι ≫ jE) c'
            ⟨c'.val + 1, by omega⟩ = 1 := by
          unfold wcScqHtTuple
          rw [if_neg (by simp), (wc_ldpi_oai_sgE_facts K (e + 2 + 1) _ 0).1, map_one, map_one]
        have hb' := hbo c' ⟨c'.val + 1, by omega⟩
        rw [hr1, Scheme.basicOpen_one] at hb'
        have hmem : y ∈ ht ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c'.val + 1, by omega⟩ ⊓
            Limits.pullback.fst D.hom
              (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⁻¹ᵁ
              ((iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c'.val + 1, by omega⟩) := by
          rw [hb']
          exact hy
        have e1 : c'.succ = ⟨c'.val + 1, by omega⟩ := Fin.ext rfl
        rw [e1]
        exact hmem.1)

  have hhK : h ≫ D.hom = Limits.pullback.fst D.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ D.hom := by
    rw [← hht, ← hh]
    simp only [Category.assoc, hjEY]
    rw [hiDE]

  have key1 : i₁ ≫ ht = iD ≫ Op.ι ≫ jE := by
    apply Scheme.hom_ext_of_forall
    intro x
    obtain ⟨c, hc⟩ := (N6 x).2.1
    refine ⟨(iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩, hc, ?_⟩
    exact wc_projK_scale_section_chart_eq K (e + 2) D.left D.hom (iD ≫ Op.ι ≫ jE) ht hht
      ⟨c.val, by omega⟩ (hrel _) i₁ 1 hi₁f hi₁s (iD ≫ Op.ι ≫ jE) hκ
      (fun J => ((iD ≫ Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
        (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ J))
      (by simp only [map_one, one_mul]) (fun J _ => rfl)
      (wc_projK_chart_tuple_facts K (e + 2 + 1) D.left (iD ≫ Op.ι ≫ jE)
        ⟨c.val + 1, by omega⟩ ⟨c.val + 1, by omega⟩).2.1

  have key0 : i₀ ≫ ht = ρ ≫ iD ≫ Op.ι ≫ jE := by
    apply Scheme.hom_ext_of_forall
    intro x
    obtain ⟨c, hc⟩ := (N6 x).2.1
    refine ⟨(iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩, hc, ?_⟩
    have hg' : (ρ ≫ iD ≫ Op.ι ≫ jE) ≫ wcProjKStr K (e + 2 + 1) = D.hom := by
      rw [Category.assoc, hκ, hρK]
    exact wc_projK_scale_section_chart_eq K (e + 2) D.left D.hom (iD ≫ Op.ι ≫ jE) ht hht
      ⟨c.val, by omega⟩ (hrel _) i₀ 0 hi₀f hi₀s (ρ ≫ iD ≫ Op.ι ≫ jE) hg'
      (wcScqCcV K e (iD ≫ Op.ι ≫ jE) c)
      (by
        unfold wcScqCcV
        rw [if_neg (by simp)]
        simp only [map_zero, zero_mul])
      (by
        intro J hJ
        unfold wcScqCcV
        split_ifs with h1
        · rfl
        · have hJl : J = Fin.last (e + 2 + 1) := by
            apply Fin.ext
            rw [Fin.val_last]
            have := J.isLt
            omega
          subst hJl
          exact (ht2 ⟨c.val, by omega⟩).symm)
      (hρ c)
  refine ⟨h, hhK, ?_, ?_⟩
  · rw [← cancel_mono (iD ≫ Op.ι ≫ jE), Category.assoc, hh, key0]
  · rw [← cancel_mono (iD ≫ Op.ι ≫ jE), Category.assoc, hh, key1, Category.id_comp]

theorem wc_scq_cone_contraction (K : Type u) [Field K] [Finite K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (ha' : (Matrix.of a' + (Matrix.of a').transpose).det ≠ 0)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K))) [IsProper E₀.hom] [SmoothOfRelativeDimension (e + 2) E₀.hom]
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (e + 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c),
      wcLdpGerm K (e + 2 + 1) jE (wcLdpQuad K (e + 2 + 1) b) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (E₁ : Over (Spec (.of K))) [IsProper E₁.hom] [SmoothOfRelativeDimension e E₁.hom]
    (jE₁ : E₁.left ⟶ wcProjK K (e + 1)) (hjE₁ : IsClosedImmersion jE₁)
    (hjEY₁ : jE₁ ≫ wcProjKStr K (e + 1) = E₁.hom)
    (hEG₁ : ∀ (x : E₁.left) (c : Fin (e + 1 + 1)) (hx : x ∈ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
      wcLdpGerm K (e + 1) jE₁ (wcLdpQuad K (e + 1) a') c x hx ∈
        IsLocalRing.maximalIdeal (E₁.left.presheaf.stalk x))
    (hEall₁ : ∀ p : wcProjK K (e + 1), (∀ (c : Fin (e + 1 + 1)) (hp : p ∈ wcSgD K (e + 1) c),
        ((wcProjK K (e + 1)).presheaf.germ (wcSgD K (e + 1) c) p hp).hom
            (wcLdpSec K (e + 1) (wcLdpQuad K (e + 1) a') c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 1)).presheaf.stalk p)) → p ∈ Set.range jE₁)
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ)
    (D : Over (Spec (.of K))) [SmoothOfRelativeDimension (e + 1) D.hom]
    (iD : D.left ⟶ Op.toScheme) (hiD : IsClosedImmersion iD) (hiDE : iD ≫ Op.ι ≫ E₀.hom = D.hom)
    (hrange : Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left)) :
    ∃ (σ : E₁.left ⟶ D.left) (π : D.left ⟶ E₁.left)
      (h : Limits.pullback D.hom (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ⟶
        D.left)
      (i₀ i₁ : D.left ⟶
        Limits.pullback D.hom (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))),
      σ ≫ D.hom = E₁.hom ∧ π ≫ E₁.hom = D.hom ∧ σ ≫ π = 𝟙 _ ∧
      h ≫ D.hom = Limits.pullback.fst D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫ D.hom ∧
      i₀ ≫ Limits.pullback.fst D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = 𝟙 _ ∧
      i₀ ≫ Limits.pullback.snd D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
        D.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : K))) ∧
      i₁ ≫ Limits.pullback.fst D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = 𝟙 _ ∧
      i₁ ≫ Limits.pullback.snd D.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
        D.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (1 : K))) ∧
      i₀ ≫ h = π ≫ σ ∧ i₁ ≫ h = 𝟙 _ :=
by
  have hev : ∀ t : K, CommRingCat.ofHom (algebraMap K (Polynomial K)) ≫
      CommRingCat.ofHom (Polynomial.evalRingHom t) = 𝟙 _ := by
    intro t
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    simp
  have hw : ∀ t : K, 𝟙 D.left ≫ D.hom =
      (D.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom t))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := by
    intro t
    rw [Category.id_comp, Category.assoc, ← Spec.map_comp, hev, Spec.map_id, Category.comp_id]
  obtain ⟨σ, π, hσ, hπ, hσπ, hρ⟩ := wc_scq_cc_retraction K e a' b hb E₀ jE hjE hjEY hEG hEall
    E₁ jE₁ hjE₁ hjEY₁ hEG₁ hEall₁ U Op hU hOp D iD hiD hiDE hrange
  have hρK : (π ≫ σ) ≫ D.hom = D.hom := by
    rw [Category.assoc, hσ, hπ]
  obtain ⟨h, hhK, hh₀, hh₁⟩ := wc_scq_cc_homotopy K e a' b hb E₀ jE hjE hjEY hEG hEall U Op hU hOp
    D iD hiD hiDE hrange (π ≫ σ) hρK hρ
    (Limits.pullback.lift (𝟙 _) _ (hw 0)) (Limits.pullback.lift (𝟙 _) _ (hw 1))
    (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _)
    (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _)
  exact ⟨σ, π, h, Limits.pullback.lift (𝟙 _) _ (hw 0), Limits.pullback.lift (𝟙 _) _ (hw 1),
    hσ, hπ, hσπ, hhK, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _,
    Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _, hh₀, hh₁⟩

theorem wc_proet_affine_open_acyclic (K : Type u) [Field K] [Finite K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (X : Over (Spec (.of K)))
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (U : X.left.Opens) (n : ℕ) (φ : U.toScheme ≅ Spec (.of (MvPolynomial (Fin n) K)))
    (hφ : φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K))) =
      U.ι ≫ X.hom)
    (k j : ℕ) (hj : 1 ≤ j)
    (x : Abelian.Ext (wcFreeSheaf X.left (wcOpenRestr X.left U (wcGeomPoint K X hX)))
      (wcContSheaf X.left (ZMod (ℓ ^ k))) j) : x = 0 :=
by
  rcases k with _ | k'
  · haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
    have h0 : 𝟙 (wcContSheaf X.left (ZMod (ℓ ^ 0))) = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext W
      apply AddCommGrpCat.ext
      intro y
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      exact Subsingleton.elim _ _
    rw [← Abelian.Ext.comp_mk₀_id x, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  ·
    have hℓK : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
      classical
      haveI := Fintype.ofFinite K
      have hc : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
      have hcq : ringChar K ∣ Nat.card K := by
        rw [Nat.card_eq_fintype_card]
        exact ringChar.dvd (FiniteField.cast_card_eq_zero K)
      intro h
      have h' : ((ℓ : ℕ) : K) = 0 := by
        apply (algebraMap K (AlgebraicClosure K)).injective
        rw [map_natCast, map_zero]
        exact h
      have hcl : ringChar K ∣ ℓ := ringChar.dvd h'
      have heq : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hc Fact.out).mp hcl
      exact hℓ (heq ▸ hcq)

    haveI hA : Subsingleton
        (wcEtCoh (Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K)))) (ℓ ^ (k' + 1)) j) :=
      wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out j
        (wc_et_affine_space_coh_vanishing (AlgebraicClosure K) ℓ Fact.out hℓK n j hj) k'

    let s := Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    let p := Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))
    let e : TensorProduct K (MvPolynomial (Fin n) K) (AlgebraicClosure K) ≃+*
        MvPolynomial (Fin n) (AlgebraicClosure K) :=
      (Algebra.TensorProduct.comm K (MvPolynomial (Fin n) K) (AlgebraicClosure K)).toRingEquiv.trans
        (MvPolynomial.algebraTensorAlgEquiv K (AlgebraicClosure K)).toRingEquiv
    have e₁ : (φ.hom ≫ p) ≫ 𝟙 _ = φ.hom ≫ p := Category.comp_id _
    have e₂ : s ≫ 𝟙 _ = 𝟙 _ ≫ s := by simp
    let eV : Limits.pullback U.ι (Limits.pullback.fst X.hom s) ≅
        Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K))) :=
      Limits.pullbackRightPullbackFstIso X.hom s U.ι ≪≫ Limits.pullback.congrHom hφ.symm rfl ≪≫
        asIso (Limits.pullback.map (φ.hom ≫ p) s p s φ.hom (𝟙 _) (𝟙 _) e₁ e₂) ≪≫
        pullbackSpecIso K (MvPolynomial (Fin n) K) (AlgebraicClosure K) ≪≫
        Scheme.Spec.mapIso e.toCommRingCatIso.symm.op
    let eV' : (wcOpenRestr X.left U (wcGeomPoint K X hX)).left ≅
        Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K))) := eV
    haveI : CompactSpace (wcOpenRestr X.left U (wcGeomPoint K X hX)).left :=
      (Scheme.homeoOfIso eV'.symm).compactSpace
    haveI : IsSeparated (Limits.terminal.from (wcOpenRestr X.left U (wcGeomPoint K X hX)).left) := by
      rw [Limits.terminal.hom_ext (Limits.terminal.from _) (eV'.hom ≫ Limits.terminal.from _)]
      infer_instance
    have hV : Subsingleton
        (wcEtCoh (wcOpenRestr X.left U (wcGeomPoint K X hX)).left (ℓ ^ (k' + 1)) j) :=
      (Classical.choice (wc_et_coh_iso_invariance eV'.hom (ℓ ^ (k' + 1)) j)).symm.subsingleton

    obtain ⟨c1⟩ := wc_contSheaf_discrete_const X.left (ZMod (ℓ ^ (k' + 1)))
    obtain ⟨c2⟩ := wc_zmod_sheaf_const X.left (ℓ ^ (k' + 1))
    have hy := wc_proet_free_zmod_ext_vanish_of_et_qcsep X.left
      (wcOpenRestr X.left U (wcGeomPoint K X hX)) (ℓ ^ (k' + 1)) j hV
      (x.comp (Abelian.Ext.mk₀ (c1 ≪≫ c2.symm).hom) (add_zero j))
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero j) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = (x.comp (Abelian.Ext.mk₀ (c1 ≪≫ c2.symm).hom) (add_zero j)).comp
            (Abelian.Ext.mk₀ (c1 ≪≫ c2.symm).inv) (add_zero j) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = 0 := by rw [hy, Abelian.Ext.zero_comp]

theorem wc_rpss_h0_restr_bijective : ∀ (Y : Scheme.{u}) [IrreducibleSpace Y] (O : Y.Opens), (O : Set Y).Nonempty → ∀ (m : ℕ), Function.Bijective (fun y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y m) 0 => (Abelian.Ext.mk₀ (wcFreeSheafMap Y (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))).comp y (zero_add 0)) :=
by
  intro Y _ O hO m


  have hYon : ∀ (S : Scheme.{u}), ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
      (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (s : G.obj.obj (Opposite.op T)),
        ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
      ∀ (T T' : S.ProEt) (c : T' ⟶ T),
        ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
          ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
    intro S
    let J := Scheme.ProEt.topology S
    let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
      fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
        (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
        (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
        e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
    refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
    · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
    · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
    · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
      let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
      have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
            ((w.app (Opposite.op T')).hom x') :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
      have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans
          (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
        congr 1
      have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
        NatTrans.naturality_apply (toSheafify J P) c.op x
      change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
      rw [h1, h2, hn]
  obtain ⟨η, hY1, hY2⟩ := hYon Y
  let T : Y.ProEt := Scheme.ProEt.mk (𝟙 Y)
  let V : Y.ProEt := Scheme.ProEt.mk O.ι
  let c : V ⟶ T := MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  let G := wcZModSheaf Y m
  let r : G.obj.obj (Opposite.op T) → G.obj.obj (Opposite.op V) := fun t => (G.obj.map c.op).hom t

  have hpre : PreconnectedSpace Y := inferInstance
  have hpreO : PreconnectedSpace O.toScheme :=
    ⟨Set.preimage_univ (f := O.ι) ▸ ((PreirreducibleSpace.isPreirreducible_univ (X := Y)).preimage
      (Scheme.Hom.isOpenEmbedding O.ι)).isPreconnected⟩
  obtain ⟨o, ho⟩ := hO
  let z0 : O.toScheme := ⟨o, ho⟩

  have hrinj : Function.Injective r := by
    intro t t' h
    let f1 : C(Y, ZMod m) := ULift.down t
    let f2 : C(Y, ZMod m) := ULift.down t'
    have h1 : ∀ z : O.toScheme, f1 (O.ι z) = f2 (O.ι z) := fun z => by
      have := congrArg (fun w : G.obj.obj (Opposite.op V) =>
        (ULift.down w : C(O.toScheme, ZMod m)) z) h
      exact this
    apply ULift.ext
    apply ContinuousMap.ext
    intro x
    change f1 x = f2 x
    exact (PreconnectedSpace.constant hpre f1.continuous).trans
      ((h1 z0).trans (PreconnectedSpace.constant hpre f2.continuous))
  have hrsurj : Function.Surjective r := by
    intro s
    let h0 : C(O.toScheme, ZMod m) := ULift.down s
    refine ⟨ULift.up (ContinuousMap.const Y (h0 z0)), ?_⟩
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    change h0 z0 = h0 z
    exact PreconnectedSpace.constant hpreO h0.continuous

  have hint : ∀ φ : wcFreeSheaf Y T ⟶ G,
      ((wcFreeSheafMap Y c ≫ φ).hom.app (Opposite.op V)).hom (η V) =
        r ((φ.hom.app (Opposite.op T)).hom (η T)) := by
    intro φ
    change (φ.hom.app (Opposite.op V)).hom
      (((wcFreeSheafMap Y c).hom.app (Opposite.op V)).hom (η V)) = _
    rw [hY2 T V c]
    exact NatTrans.naturality_apply φ.hom c.op (η T)
  constructor
  · intro x y hxy
    obtain ⟨φ1, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    obtain ⟨φ2, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hxy' : Abelian.Ext.mk₀ (wcFreeSheafMap Y c ≫ φ1) =
        Abelian.Ext.mk₀ (wcFreeSheafMap Y c ≫ φ2) := by
      rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀]
      exact hxy
    have h2 := (Abelian.Ext.mk₀_bijective _ _).1 hxy'
    have h3 : r ((φ1.hom.app (Opposite.op T)).hom (η T)) =
        r ((φ2.hom.app (Opposite.op T)).hom (η T)) :=
      (hint φ1).symm.trans
        ((congrArg (fun ψ : wcFreeSheaf Y V ⟶ G => (ψ.hom.app (Opposite.op V)).hom (η V)) h2).trans
          (hint φ2))
    have h4 := hrinj h3
    have h5 : φ1 = φ2 := (hY1 T G ((φ2.hom.app (Opposite.op T)).hom (η T))).unique h4 rfl
    rw [h5]
  · intro x
    obtain ⟨ψ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    obtain ⟨t, ht⟩ := hrsurj ((ψ.hom.app (Opposite.op V)).hom (η V))
    obtain ⟨φ, hφ, -⟩ := hY1 T G t
    have h5 : wcFreeSheafMap Y c ≫ φ = ψ :=
      (hY1 V G ((ψ.hom.app (Opposite.op V)).hom (η V))).unique
        ((hint φ).trans ((congrArg r hφ).trans ht)) rfl
    refine ⟨Abelian.Ext.mk₀ φ, ?_⟩
    show (Abelian.Ext.mk₀ (wcFreeSheafMap Y c)).comp (Abelian.Ext.mk₀ φ) (zero_add 0) =
      Abelian.Ext.mk₀ ψ
    rw [Abelian.Ext.mk₀_comp_mk₀, h5]

theorem wc_rpss_affine_origin_semipurity : ∀ (K : Type u) [Field K] [IsAlgClosed K] (n ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (O : (Spec (.of (MvPolynomial (Fin n) K))).Opens), (O : Set (Spec (.of (MvPolynomial (Fin n) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K))))ᶜ → ∀ (j : ℕ), j < 2 * n → ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Spec (.of (MvPolynomial (Fin n) K))) (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin n) K))))))) (wcZModSheaf (Spec (.of (MvPolynomial (Fin n) K))) ℓ) j, x = 0 :=
by
  classical
  intro K _ _ n ℓ _ hℓK O hO j hj x
  have hℓp : ℓ.Prime := Fact.out
  have hn1 : 1 ≤ n := by omega

  let A : Scheme.{u} := Spec (.of (MvPolynomial (Fin n) K))
  let ιO : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 A) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  have hmono : Mono (wcFreeSheafMap A ιO) :=
    wc_free_sheaf_map_mono A _ _ ιO (show Mono O.ι from inferInstance)
  have hS₀ : (ShortComplex.mk (wcFreeSheafMap A ιO) (Limits.cokernel.π (wcFreeSheafMap A ιO))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  have hOne : (O : Set (Spec (.of (MvPolynomial (Fin n) K)))).Nonempty := by
    refine ⟨(show PrimeSpectrum (MvPolynomial (Fin n) K) from ⟨⊥, Ideal.isPrime_bot⟩), ?_⟩
    rw [hO]
    rintro ⟨t, ht⟩
    have hX : (MvPolynomial.X ⟨0, hn1⟩ : MvPolynomial (Fin n) K) ∈
        PrimeSpectrum.asIdeal (R := MvPolynomial (Fin n) K) ((Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K))) t) := by
      try rw [Spec.map_apply]
      show MvPolynomial.constantCoeff (MvPolynomial.X ⟨0, hn1⟩ : MvPolynomial (Fin n) K) ∈
        PrimeSpectrum.asIdeal (R := K) t
      rw [MvPolynomial.constantCoeff_X]
      exact zero_mem _
    rw [ht] at hX
    change _ ∈ (⊥ : Ideal (MvPolynomial (Fin n) K)) at hX
    exact MvPolynomial.X_ne_zero _ (Ideal.mem_bot.mp hX)

  haveI hAirr : IrreducibleSpace (Spec (.of (MvPolynomial (Fin n) K))) := by
    first
      | exact (inferInstance : IrreducibleSpace (Spec (.of (MvPolynomial (Fin n) K))))
      | infer_instance
  have hρ := wc_rpss_h0_restr_bijective (Spec (.of (MvPolynomial (Fin n) K))) O hOne ℓ
  rcases Nat.eq_zero_or_pos j with rfl | hj1
  ·
    let r : Abelian.Ext (Limits.cokernel (wcFreeSheafMap A ιO)) (wcZModSheaf A ℓ) 0 →
        Abelian.Ext (wcFreeSheaf A (Scheme.ProEt.mk (𝟙 A))) (wcZModSheaf A ℓ) 0 :=
      fun x => (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO))).comp x (zero_add 0)
    have hr : Function.Injective r := by
      intro x y hxy
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      have h1 : Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO) ≫ f) =
          Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO) ≫ g) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀]
        exact hxy
      have h2 := (Abelian.Ext.mk₀_bijective _ _).1 h1
      rw [cancel_epi] at h2
      rw [h2]
    have hρr : (Abelian.Ext.mk₀ (wcFreeSheafMap A ιO)).comp (r x) (zero_add 0) = 0 := by
      show (Abelian.Ext.mk₀ (wcFreeSheafMap A ιO)).comp
        ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO))).comp x (zero_add 0))
          (zero_add 0) = 0
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.zero_comp]
    have h0 : r x = 0 := by
      apply hρ.1
      show (Abelian.Ext.mk₀ (wcFreeSheafMap A ιO)).comp (r x) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap A ιO)).comp 0 (zero_add 0)
      rw [hρr, Abelian.Ext.comp_zero]
    apply hr
    rw [h0]
    show (0 : Abelian.Ext (wcFreeSheaf A (Scheme.ProEt.mk (𝟙 A))) (wcZModSheaf A ℓ) 0) =
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO))).comp 0 (zero_add 0)
    rw [Abelian.Ext.comp_zero]
  ·
    haveI hcA : CompactSpace (Scheme.ProEt.mk (𝟙 A)).left :=
      (inferInstance : CompactSpace (Spec (.of (MvPolynomial (Fin n) K))))
    haveI hsA : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 A)).left) :=
      (inferInstance : IsSeparated (Limits.terminal.from (Spec (.of (MvPolynomial (Fin n) K)))))
    have h0 : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO))).comp x (zero_add j) = 0 :=
      wc_proet_free_zmod_ext_vanish_of_et_qcsep A (Scheme.ProEt.mk (𝟙 A)) ℓ j
        (wc_et_affine_space_coh_vanishing K ℓ hℓp hℓK n j hj1) _
    by_cases hj2 : j = 1
    ·
      subst hj2
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₀ (wcZModSheaf A ℓ) x h0
        (show 1 + 0 = 1 from rfl)
      obtain ⟨y, hy⟩ := hρ.2 x₁
      have e := Abelian.Ext.comp_assoc_of_second_deg_zero hS₀.extClass
        (Abelian.Ext.mk₀ (wcFreeSheafMap A ιO)) y (show 1 + 0 = 1 from rfl)
      have hz : hS₀.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap A ιO)) (add_zero 1) = 0 :=
        hS₀.extClass_comp
      rw [← hx₁, ← hy]
      exact e.symm.trans (by rw [hz, Abelian.Ext.zero_comp])
    ·
      have hn : 1 + (j - 1) = j := by omega
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₀ (wcZModSheaf A ℓ) x h0 hn
      haveI hRn : IsNoetherianRing (MvPolynomial (Fin n) K) := by
        first
          | infer_instance
          | exact MvPolynomial.isNoetherianRing
      haveI hAln : IsLocallyNoetherian (Spec (.of (MvPolynomial (Fin n) K))) := by
        first
          | infer_instance
          | exact (isLocallyNoetherian_Spec).mpr hRn
      haveI hOqc : QuasiCompact (O.ι : (O : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin n) K))) := by
        first
          | infer_instance
          | exact @instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion _ _ hAln O.ι inferInstance
          | exact quasiCompact_of_noetherianSpace_source O.ι
      have hOc0 : CompactSpace (O : Scheme.{u}) := by
        first
          | exact QuasiCompact.compactSpace_of_compactSpace O.ι
          | exact isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact
              (O : Set (Spec (.of (MvPolynomial (Fin n) K)))))
      haveI hOc : CompactSpace (Scheme.ProEt.mk O.ι).left := hOc0
      have hOs0 : IsSeparated (Limits.terminal.from (O : Scheme.{u})) := by
        have e : Limits.terminal.from (O : Scheme.{u}) =
            O.ι ≫ Limits.terminal.from (Spec (.of (MvPolynomial (Fin n) K))) :=
          Limits.terminal.hom_ext _ _
        rw [e]
        haveI hAsep : IsSeparated (Limits.terminal.from (Spec (.of (MvPolynomial (Fin n) K)))) :=
          inferInstance
        haveI hOιsep : IsSeparated (O.ι : (O : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin n) K))) :=
          inferInstance
        first
          | infer_instance
          | exact IsSeparated.instCompScheme _ _
      haveI hOs : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk O.ι).left) := hOs0
      have hsubO : Subsingleton (wcEtCoh (Scheme.ProEt.mk O.ι).left ℓ (j - 1)) :=
        wc_rpss_punct_affine_low_vanishing K n ℓ hℓK O hO (j - 1) (by omega) (by omega)
      have hx₁0 : x₁ = 0 :=
        wc_proet_free_zmod_ext_vanish_of_et_qcsep A (Scheme.ProEt.mk O.ι) ℓ (j - 1) hsubO x₁
      rw [← hx₁, hx₁0, Abelian.Ext.comp_zero]

theorem wc_proet_rat_point_supp_semipurity (K : Type u) [Field K] [Finite K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (X : Over (Spec (.of K))) (n : ℕ)
    [SmoothOfRelativeDimension n X.hom]
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (s : Spec (.of K) ⟶ X.left) (hs : s ≫ X.hom = 𝟙 _)
    (O : X.left.Opens) (hO : (O : Set X.left) = {s (IsLocalRing.closedPoint K)}ᶜ)
    (k j : ℕ) (hj : j < 2 * n)
    (x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left
        (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))))
      (wcContSheaf X.left (ZMod (ℓ ^ k))) j) : x = 0 :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  haveI : NeZero ℓ := ⟨hℓ0⟩
  haveI hι₀ : IsOpenImmersion (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)).left := by
    show IsOpenImmersion (Limits.pullback.snd O.ι (wcGeomPoint K X hX).hom)
    infer_instance

  have fibre : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : C ⟶ B) (s : B ⟶ A), s ≫ f = 𝟙 _ →
      ∀ (y : C ⟶ Limits.pullback f g), y ≫ Limits.pullback.fst f g = g ≫ s →
      y ≫ Limits.pullback.snd f g = 𝟙 _ → (∀ b b' : B, b = b') → (∀ c c' : C, c = c') →
      ∀ (b : B) (c : C) (z : ↥(Limits.pullback f g)), Limits.pullback.fst f g z = s b → z = y c := by
    intro A B C f g s hs y hy1 hy2 hB hC b c z hz
    have hzr : z ∈ Set.range (Limits.pullback.snd s (Limits.pullback.fst f g)) := by
      rw [Scheme.Pullback.range_snd]
      exact Set.mem_preimage.mpr (Set.mem_range.mpr ⟨b, hz.symm⟩)
    obtain ⟨q, rfl⟩ := hzr
    have hkey : (Limits.pullback.snd s (Limits.pullback.fst f g) ≫ Limits.pullback.snd f g) ≫ g =
        Limits.pullback.fst s (Limits.pullback.fst f g) := by
      rw [Category.assoc, ← Limits.pullback.condition (f := f) (g := g), ← Category.assoc,
        ← Limits.pullback.condition (f := s) (g := Limits.pullback.fst f g), Category.assoc, hs,
        Category.comp_id]
    have hee : (Limits.pullback.snd s (Limits.pullback.fst f g) ≫ Limits.pullback.snd f g) ≫
        Limits.pullback.lift g y hy1.symm = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.id_comp, hkey]
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp]
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hy1, ← Category.assoc, hkey,
            Limits.pullback.condition (f := s) (g := Limits.pullback.fst f g)]
        · rw [Category.assoc, hy2, Category.comp_id]
    have h1 : (Limits.pullback.lift g y hy1.symm)
        ((Limits.pullback.snd s (Limits.pullback.fst f g) ≫ Limits.pullback.snd f g) q) = q := by
      rw [← Scheme.Hom.comp_apply, hee] <;> rfl
    rw [← h1, ← Scheme.Hom.comp_apply, Limits.pullback.lift_snd]
    exact congrArg _ (hC _ _)

  have H : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left
        (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)))) (wcZModSheaf X.left ℓ) j, y = 0 := by
    intro y
    have hneℓ : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
      intro h0
      have hp : ringChar K ∣ ℓ := (CharP.cast_eq_zero_iff (AlgebraicClosure K) (ringChar K) ℓ).mp h0
      have hpp : Nat.Prime (ringChar K) := CharP.char_is_prime K (ringChar K)
      have hpl : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
      letI := Fintype.ofFinite K
      have hc : ((Nat.card K : ℕ) : K) = 0 := by
        rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero K
      have hdvd : ringChar K ∣ Nat.card K := (ringChar.spec K _).mp hc
      exact hℓ (hpl ▸ hdvd)
    let fY : (wcGeomPoint K X hX).left ⟶ Spec (.of (AlgebraicClosure K)) :=
      Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    haveI hsm : SmoothOfRelativeDimension n fY :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n)
        (IsPullback.of_hasPullback X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) inferInstance
    haveI : Smooth fY := SmoothOfRelativeDimension.smooth n fY
    haveI : IsLocallyNoetherian (wcGeomPoint K X hX).left :=
      LocallyOfFiniteType.isLocallyNoetherian fY

    have hw : (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s) ≫ X.hom =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
      rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
    obtain ⟨y₀, hy1, hy₀f⟩ : ∃ y₀ : Spec (.of (AlgebraicClosure K)) ⟶ (wcGeomPoint K X hX).left,
        y₀ ≫ Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
          Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s ∧
        y₀ ≫ fY = 𝟙 _ :=
      ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨xb, hy₀pt⟩ : ∃ xb, y₀ (IsLocalRing.closedPoint (AlgebraicClosure K)) = xb := ⟨_, rfl⟩
    have hpt : Set.range (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)).left = {xb}ᶜ := by
      show Set.range (Limits.pullback.snd O.ι (wcGeomPoint K X hX).hom) = _
      rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι, hO]
      ext z
      rw [Set.mem_preimage, Set.mem_compl_iff, Set.mem_compl_iff, Set.mem_singleton_iff,
        Set.mem_singleton_iff]
      apply not_congr
      constructor
      · intro hz
        rw [← hy₀pt]
        exact fibre X.hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) s hs
          y₀ hy1 hy₀f (fun a b => Subsingleton.elim a b) (fun a b => Subsingleton.elim a b) _ _ z hz
      · intro hz
        rw [hz, ← hy₀pt]
        show Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
            (y₀ (IsLocalRing.closedPoint (AlgebraicClosure K))) = _
        have e := Scheme.Hom.comp_apply y₀ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
          (IsLocalRing.closedPoint (AlgebraicClosure K))
        rw [hy1] at e
        exact e.symm.trans ((Scheme.Hom.comp_apply _ _ _).trans (congrArg s (Subsingleton.elim _ _)))

    obtain ⟨W0, ιW, hιW, v₀0, φ0, hv₀ι0, hφet0, hv₀φ0, hfib0⟩ :=
      wc_smooth_rational_point_etale_chart (AlgebraicClosure K) (wcGeomPoint K X hX).left fY n y₀ hy₀f
    haveI := hιW
    haveI := hφet0
    set orig : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K))) :=
      Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin n) (AlgebraicClosure K) →+* AlgebraicClosure K))
      with horig
    set pt : Spec (.of (AlgebraicClosure K)) := IsLocalRing.closedPoint (AlgebraicClosure K) with hptdef

    obtain ⟨W₁, hW₁aff, hw₀W₁, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := W0) (x := v₀0 pt) (U := ⊤) (by simp)
    haveI : IsAffine W₁.toScheme := hW₁aff
    have H0 : Set.range v₀0 ⊆ Set.range W₁.ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι, Subsingleton.elim p pt]
      exact hw₀W₁
    obtain ⟨v₀, hv₀'⟩ : ∃ v : Spec (.of (AlgebraicClosure K)) ⟶ W₁.toScheme, v ≫ W₁.ι = v₀0 :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H0⟩
    obtain ⟨ι, hιdef⟩ : ∃ ι : W₁.toScheme ⟶ (wcGeomPoint K X hX).left, ι = W₁.ι ≫ ιW := ⟨_, rfl⟩
    obtain ⟨φ, hφdef⟩ : ∃ φ : W₁.toScheme ⟶ Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K))),
      φ = W₁.ι ≫ φ0 := ⟨_, rfl⟩
    haveI : IsOpenImmersion ι := by rw [hιdef]; infer_instance
    haveI : Etale φ := by rw [hφdef]; infer_instance
    have hv₀ι : v₀ ≫ ι = y₀ := by rw [hιdef, ← Category.assoc, hv₀', hv₀ι0]
    have hv₀φ : v₀ ≫ φ = orig := by rw [hφdef, ← Category.assoc, hv₀', hv₀φ0]
    have hfib : ∀ v : W₁.toScheme, φ v = orig pt → v = v₀ pt := by
      intro v hv
      apply W₁.ι.isOpenEmbedding.injective
      rw [hφdef, Scheme.Hom.comp_apply] at hv
      rw [hfib0 _ hv, ← Scheme.Hom.comp_apply, hv₀']
    haveI : CompactSpace W₁.toScheme := inferInstance
    have hopK : orig ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : AlgebraicClosure K →+* MvPolynomial (Fin n) (AlgebraicClosure K))) = 𝟙 _ := by
      rw [horig, ← Spec.map_comp, ← Spec.map_id]
      congr 1
      ext x
      simp
    haveI : IsClosedImmersion orig := by
      haveI : IsClosedImmersion (orig ≫ Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : AlgebraicClosure K →+* MvPolynomial (Fin n) (AlgebraicClosure K)))) := by
        rw [hopK]; infer_instance
      exact IsClosedImmersion.of_comp orig (Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : AlgebraicClosure K →+* MvPolynomial (Fin n) (AlgebraicClosure K))))
    have hclosed : IsClosed (Set.range orig) := (Scheme.Hom.isClosedEmbedding orig).isClosed_range
    let OA : (Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K)))).Opens :=
      ⟨(Set.range orig)ᶜ, hclosed.isOpen_compl⟩
    have hrangeO : ∀ p : Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K))),
        p ∈ Set.range orig ↔ p = orig pt := by
      intro p
      constructor
      · rintro ⟨q, rfl⟩
        rw [Subsingleton.elim q pt]
      · intro hp
        exact ⟨pt, hp.symm⟩
    have hιw₀ : ι (v₀ pt) = xb := by rw [← Scheme.Hom.comp_apply, hv₀ι, hy₀pt]
    have hφw₀ : φ (v₀ pt) = orig pt := by rw [← Scheme.Hom.comp_apply, hv₀φ]
    have hmemO : ∀ v : W₁.toScheme,
        φ v ∈ (OA : Set (Spec (.of (MvPolynomial (Fin n) (AlgebraicClosure K))))) ↔ v ≠ v₀ pt := by
      intro v
      show φ v ∈ (Set.range orig)ᶜ ↔ _
      rw [Set.mem_compl_iff, hrangeO]
