      ∃ (W : (wcP1Over F'').left.Etale) (f : W ⟶ V)
        (x : ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology (n - 1)).obj.obj (Opposite.op W)),
        v ∈ Set.range f.left ∧
        ∀ (Z : (wcP1Over F'').left.Etale) (g : Z ⟶ W)
          (g' : Z ⟶ wcEtOpen (wcP1Over F'').left V (V.hom ⁻¹ᵁ O)),
          g ≫ f = g' ≫ wcEtOpenι (wcP1Over F'').left V (V.hom ⁻¹ᵁ O) →
          (((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
            I.cocomplex).homology (n - 1)).obj.map g.op).hom x =
          ℓ ^ c • (((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
            I.cocomplex).homology (n - 1)).obj.map g'.op).hom h :=
by
  classical

  obtain ⟨c, hc⟩ := wc_pencil_odp_shens_inv_bounded F' F'' Y n hn hn2 D ℓ hℓ
  refine ⟨c, ?_⟩
  intro k I V h v i hv

  haveI hPp : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  have hm : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
