          (Abelian.Ext.mk₀ (Limits.biprod.inr : B ⟶ A ⊞ B)) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.comp_assoc_of_second_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_add,
        ← Abelian.Ext.mk₀_add, Limits.biprod.total, Abelian.Ext.comp_mk₀_id]
    rw [h1, hA (e.comp _ _), hB (e.comp _ _), Abelian.Ext.zero_comp, Abelian.Ext.zero_comp,
      add_zero]
  let T₀ := hS.singleTriangle
  have hT₀ : T₀ ∈ distTriang _ := hS.singleTriangle_distinguished
  let T₁ := T₀.invRotate
  have hT₁ : T₁ ∈ distTriang _ := Pretriangulated.inv_rot_of_distTriang _ hT₀
  let T₂ := T₁.invRotate
  have hT₂ : T₂ ∈ distTriang _ := Pretriangulated.inv_rot_of_distTriang _ hT₁
  have hT₃ := Pretriangulated.Triangle.shift_distinguished T₂ hT₂ N
  rw [Pretriangulated.Triangle.shiftFunctor_eq] at hT₃
  refine ⟨T₁.mor₁, fun x hx => ?_⟩
  have hx' : (x : _ ⟶ ((Pretriangulated.Triangle.shiftFunctor _ N).obj T₂).obj₂) ≫
      ((Pretriangulated.Triangle.shiftFunctor _ N).obj T₂).mor₂ = 0 := by
    show x ≫ (((N.negOnePow : ℤˣ) : ℤ) • (shiftFunctor _ N).map T₁.mor₁) = 0
    refine (Preadditive.comp_zsmul _ _ _).trans ?_
    have hx2 : (x ≫ (shiftFunctor (DerivedCategory C) N).map T₁.mor₁ :
        _ ⟶ (shiftFunctor (DerivedCategory C) N).obj T₁.obj₂) = 0 := hx
    first
      | rw [hx2, smul_zero]
      | exact (congrArg (fun t : (_ ⟶ (shiftFunctor (DerivedCategory C) N).obj T₁.obj₂) =>
          ((N.negOnePow : ℤˣ) : ℤ) • t) hx2).trans (smul_zero _)
  obtain ⟨y, hy⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hT₃ x hx'
  let ι := (shiftFunctorAdd' (DerivedCategory C) (-1) N (q : ℤ) (by omega)).app
    ((DerivedCategory.singleFunctor C 0).obj (A ⊞ B))
  have hz : (y ≫ ι.inv : _ ⟶ _) = 0 := by
    have h0 := hAB ((Abelian.Ext.homAddEquiv (X := T) (Y := A ⊞ B) (n := q)).symm (y ≫ ι.inv))
    have h2 := congrArg (Abelian.Ext.homAddEquiv (X := T) (Y := A ⊞ B) (n := q)) h0
    rwa [AddEquiv.apply_symm_apply, map_zero] at h2
  have hy0 : y = 0 := (cancel_mono ι.inv).1 (hz.trans Limits.zero_comp.symm)
  rw [hy, hy0]
  exact Limits.zero_comp

theorem wc_etqm_srdmv_exc_smooth (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (e : Fin n → (Spec (.of (wcQuadModelRing A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X'))
    (he_open : ∀ k, IsOpenImmersion (e k)) (he_cov : ∀ x : X', ∃ k y, e k y = x)
    (he_str : ∀ k, e k ≫ β ≫ wcQuadModelStr A n π c = wcQuadModelStr A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (hE : ∀ k y, (∀ p : Fin n, p.val % 2 = 0 → Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal ((e k ≫ β) y)) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y)
    (hP : ∀ k y, (∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
          PrimeSpectrum.asIdeal ((e k ≫ β) y)) ↔
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π
            (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          Ideal.Quotient.mk (wcQuadModelIdeal A n π
            (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          ∀ p : Fin n, p.val % 2 = 1 → 3 ≤ p.val → Ideal.Quotient.mk (wcQuadModelIdeal A n π
            (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal y)) :
    ∃ (W : Scheme.{u}) (iW : W ⟶ Limits.pullback f' (wcQmSp A)) (_ : IsClosedImmersion iW),
      Set.range iW = {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n, p.val % 2 = 0 →
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} ∧
      SmoothOfRelativeDimension (n - 1) (iW ≫ Limits.pullback.snd f' (wcQmSp A)) ∧
      ∃ (PW : Scheme.{u}) (jP : PW ⟶ W) (_ : IsClosedImmersion jP),
        Set.range (jP ≫ iW) = {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n,
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} ∧
        SmoothOfRelativeDimension (n - 1 - n / 2) (jP ≫ iW ≫ Limits.pullback.snd f' (wcQmSp A)) :=
by
  classical
  have hn2 : n % 2 = 0 := Nat.even_iff.mp hn

  have s1 : ∀ {X : Scheme.{u}} (T : Set X), IsClosed T → ∃ (R : Scheme.{u}) (r : R ⟶ X),
      IsClosedImmersion r ∧ IsReduced R ∧ Set.range r = T := by
    intro X T hT
    let I : X.IdealSheafData := Scheme.IdealSheafData.vanishingIdeal ⟨T, hT⟩
    have h2 : Set.range I.subschemeι = T := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have hring : ∀ U : X.affineOpens, _root_.IsReduced (Γ(X, U) ⧸ I.ideal U) := fun U =>
      (Ideal.isRadical_iff_quotient_reduced _).mp (by
        rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
        exact PrimeSpectrum.isRadical_vanishingIdeal _)
    have hpieces : ∀ i, IsReduced (I.subschemeCover.openCover.X i) := fun (U : X.affineOpens) => by
      haveI := hring U
      exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(X, (U : X.Opens)) ⧸ I.ideal U))))
    have h3 : IsReduced I.subscheme := IsReduced.of_openCover _ I.subschemeCover.openCover
    exact ⟨I.subscheme, I.subschemeι, inferInstance, h3, h2⟩

  have s2 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] [IsReduced Z],
      i.ker = Scheme.IdealSheafData.vanishingIdeal
        ⟨Set.range i, i.isClosedEmbedding.isClosed_range⟩ := by
    intro X Z i _ _
    have hrad : i.ker.radical = i.ker := by
      apply Scheme.IdealSheafData.ext
      funext U
      rw [Scheme.IdealSheafData.radical_ideal, Scheme.Hom.ker_apply]
      apply Ideal.IsRadical.radical
      rintro x ⟨m, hm⟩
      rw [RingHom.mem_ker] at hm ⊢
      rw [map_pow] at hm
      exact IsNilpotent.eq_zero ⟨m, hm⟩
    have hsupp : i.ker.support = ⟨Set.range i, i.isClosedEmbedding.isClosed_range⟩ := by
      apply TopologicalSpace.Closeds.ext
      rw [Scheme.Hom.support_ker, i.isClosedEmbedding.isClosed_range.closure_eq]
      rfl
    rw [← hsupp, Scheme.IdealSheafData.vanishingIdeal_support, hrad]

  have s3 : ∀ {X S W : Scheme.{u}} (s : X ⟶ S) (i : W ⟶ X) [IsClosedImmersion i] [IsReduced W]
      (d : ℕ) {ι : Type} (V M : ι → Scheme.{u}) (u : ∀ k, V k ⟶ X) (j : ∀ k, M k ⟶ V k)
      (hu : ∀ k, IsOpenImmersion (u k)) (hj : ∀ k, IsClosedImmersion (j k))
      (hM : ∀ k, IsReduced (M k)) (hcov : ∀ x : X, ∃ k, ∃ y : V k, u k y = x)
      (hr : ∀ k, Set.range (j k) = (u k) ⁻¹' Set.range i)
      (hs : ∀ k, SmoothOfRelativeDimension d (j k ≫ u k ≫ s)),
      SmoothOfRelativeDimension d (i ≫ s) := by
    intro X S W s i _ _ d ι V M u j hu hj hM hcov hr hs
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension d) :=
      HasRingHomProperty.instIsZariskiLocalAtSource (P := @SmoothOfRelativeDimension d)
    have piece : ∀ k, SmoothOfRelativeDimension d (Limits.pullback.fst i (u k) ≫ i ≫ s) := by
      intro k
      haveI := hu k
      haveI := hj k
      haveI := hM k
      haveI : IsReduced (Limits.pullback i (u k)) :=
        isReduced_of_isOpenImmersion (Limits.pullback.fst i (u k))
      have hkerq : (j k).ker = (Limits.pullback.snd i (u k)).ker := by
        rw [s2 (j k), s2 (Limits.pullback.snd i (u k))]
        congr 1
        apply TopologicalSpace.Closeds.ext
        show Set.range (j k) = Set.range (Limits.pullback.snd i (u k))
        rw [hr k, Scheme.Pullback.range_snd]
      have hker := hkerq.le
      haveI := IsClosedImmersion.isIso_lift (j k) (Limits.pullback.snd i (u k)) hkerq
      have e : Limits.pullback.fst i (u k) ≫ i ≫ s =
          IsClosedImmersion.lift (j k) (Limits.pullback.snd i (u k)) hker ≫ (j k ≫ u k ≫ s) := by
        rw [Limits.pullback.condition_assoc, IsClosedImmersion.lift_fac_assoc]
      rw [e]
      exact IsZariskiLocalAtSource.comp (hs k) _
    have htop : ⨆ k, (Limits.pullback.fst i (u k)).opensRange = ⊤ := by
      rw [eq_top_iff]
      intro w _
      rw [TopologicalSpace.Opens.mem_iSup]
      obtain ⟨k, y, hy⟩ := hcov (i w)
      refine ⟨k, ?_⟩
      haveI := hu k
      show w ∈ Set.range (Limits.pullback.fst i (u k))
      rw [Scheme.Pullback.range_fst]
      exact ⟨y, hy⟩
    refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @SmoothOfRelativeDimension d) _ htop
      (fun k => ?_)
    haveI := hu k
    rw [← Scheme.Hom.isoOpensRange_inv_comp (Limits.pullback.fst i (u k)), Category.assoc]
    exact IsZariskiLocalAtSource.comp (piece k) _

  have s4 : ∀ (R : Type u) [CommRing R] (φA : A →+* R)
      (e₀ : Spec (.of R) ⟶ X')
      (he₀ : e₀ ≫ f' = Spec.map (CommRingCat.ofHom φA)) (d : ℕ)
      (ψ : R →+* MvPolynomial (Fin d) (IsLocalRing.ResidueField A)) (hψ : Function.Surjective ψ)
      (hcomp : ψ.comp φA = (algebraMap (IsLocalRing.ResidueField A)
        (MvPolynomial (Fin d) (IsLocalRing.ResidueField A))).comp (IsLocalRing.residue A))
      (Q : Set (Spec (.of R)))
      (hQ : ∀ y : Spec (.of R), y ∈ Set.range (Spec.map (CommRingCat.ofHom ψ)) ↔
        (y ∈ Q ∧ Ideal.comap φA (PrimeSpectrum.asIdeal y) = IsLocalRing.maximalIdeal A)),
      ∃ jm : Spec (.of (MvPolynomial (Fin d) (IsLocalRing.ResidueField A))) ⟶
          Limits.pullback e₀ (Limits.pullback.fst f' (wcQmSp A)),
        IsClosedImmersion jm ∧
        Set.range jm = {v | Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A)) v ∈ Q} ∧
        jm ≫ Limits.pullback.snd e₀ (Limits.pullback.fst f' (wcQmSp A)) ≫
          Limits.pullback.snd f' (wcQmSp A) =
          Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
            (MvPolynomial (Fin d) (IsLocalRing.ResidueField A)))) := by
    intro R _ φA e₀ he₀ d ψ hψ hcomp Q hQ
    haveI : IsClosedImmersion (wcQmSp A) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    have hcond : (Spec.map (CommRingCat.ofHom ψ) ≫ e₀) ≫ f' =
        Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
          (MvPolynomial (Fin d) (IsLocalRing.ResidueField A)))) ≫ wcQmSp A := by
      rw [Category.assoc, he₀]
      show _ = _ ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
      rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
        hcomp]
    have hres : ∀ x : PrimeSpectrum (IsLocalRing.ResidueField A),
        Ideal.comap (IsLocalRing.residue A) x.asIdeal = IsLocalRing.maximalIdeal A := by
      intro x
      rw [Ideal.eq_bot_of_prime x.asIdeal, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    let t := Limits.pullback.lift _ _ hcond
    let jm := Limits.pullback.lift (Spec.map (CommRingCat.ofHom ψ)) t
      (Limits.pullback.lift_fst _ _ hcond).symm
    have hj1 : jm ≫ Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A)) =
        Spec.map (CommRingCat.ofHom ψ) := Limits.pullback.lift_fst _ _ _
    refine ⟨jm, ?_, ?_, ?_⟩
    · haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom ψ)) :=
        IsClosedImmersion.spec_of_surjective _ hψ
      have : IsClosedImmersion (jm ≫ Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A))) := by
        rw [hj1]; infer_instance
      exact IsClosedImmersion.comp_iff.mp this
    · ext v
      constructor
      · rintro ⟨x, rfl⟩
        show (jm ≫ Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A))) x ∈ Q
        rw [hj1]
        exact ((hQ _).mp ⟨x, rfl⟩).1
      · intro hv
        have heq : Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A)) ≫
            Spec.map (CommRingCat.ofHom φA) =
            (Limits.pullback.snd e₀ (Limits.pullback.fst f' (wcQmSp A)) ≫
              Limits.pullback.snd f' (wcQmSp A)) ≫ wcQmSp A := by
          rw [← he₀, Limits.pullback.condition_assoc, Category.assoc, Limits.pullback.condition]
        have h1 : (Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A)) ≫
            Spec.map (CommRingCat.ofHom φA)) v =
            ((Limits.pullback.snd e₀ (Limits.pullback.fst f' (wcQmSp A)) ≫
              Limits.pullback.snd f' (wcQmSp A)) ≫ wcQmSp A) v := by rw [heq]
        have hcm : Ideal.comap φA (PrimeSpectrum.asIdeal
            (Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A)) v)) =
            IsLocalRing.maximalIdeal A := by
          change PrimeSpectrum.asIdeal ((Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A)) ≫
            Spec.map (CommRingCat.ofHom φA)) v) = _
          rw [h1]
          change Ideal.comap (IsLocalRing.residue A) (PrimeSpectrum.asIdeal
            ((Limits.pullback.snd e₀ (Limits.pullback.fst f' (wcQmSp A)) ≫
              Limits.pullback.snd f' (wcQmSp A)) v)) = _
          exact hres _
        obtain ⟨x, hx⟩ := (hQ _).mpr ⟨hv, hcm⟩
        refine ⟨x, (Limits.pullback.fst e₀ (Limits.pullback.fst f' (wcQmSp A))).isClosedEmbedding.injective ?_⟩
        rw [← Scheme.Hom.comp_apply, hj1, hx]
    · rw [Limits.pullback.lift_snd_assoc, Limits.pullback.lift_snd]

  have hπm : π ∈ IsLocalRing.maximalIdeal A := by rw [hπ]; exact Ideal.mem_span_singleton_self π
  have s5 : ∀ (d : ℕ) (v : Fin n → Option (Fin d)),
      v ⟨0, by omega⟩ = none → (∀ j : Fin d, ∃ p, v p = some j) →
      (∀ (p q : Fin n) (j : Fin d), v p = some j → v q = some j → p = q) →
      ∃ ψ : wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →+*
          MvPolynomial (Fin d) (IsLocalRing.ResidueField A),
        Function.Surjective ψ ∧
        ψ.comp (algebraMap A _) = (algebraMap (IsLocalRing.ResidueField A)
          (MvPolynomial (Fin d) (IsLocalRing.ResidueField A))).comp (IsLocalRing.residue A) ∧
        ∀ y : Spec (.of (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
          y ∈ Set.range (Spec.map (CommRingCat.ofHom ψ)) ↔
          ((∀ p : Fin n, v p = none → Ideal.Quotient.mk (wcQuadModelIdeal A n π
              (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
              (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal y) ∧
            Ideal.comap (algebraMap A _) (PrimeSpectrum.asIdeal y) = IsLocalRing.maximalIdeal A) := by
    intro d v hv0 hon hinj
    classical
    set c₀ : Matrix (Fin n) (Fin n) A :=
      Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0 with hc₀
    set I := wcQuadModelIdeal A n π c₀ with hI
    set κ := IsLocalRing.ResidueField A
    set P := MvPolynomial (Fin d) κ
    let yh : Fin n → P := fun p => Option.elim (v p) 0 MvPolynomial.X
    have hyn : ∀ p, v p = none → yh p = 0 := fun p hp => by simp only [yh, hp, Option.elim_none]
    have hys : ∀ p j, v p = some j → yh p = MvPolynomial.X j := fun p j hp => by
      simp only [yh, hp, Option.elim_some]
    let ψt : MvPolynomial (Fin n) A →+* P :=
      MvPolynomial.eval₂Hom ((algebraMap κ P).comp (IsLocalRing.residue A)) yh
    have hy0 : ∀ p : Fin n, p.val = 0 → yh p = 0 := by
      intro p hp
      have : p = ⟨0, by omega⟩ := Fin.ext hp
      rw [this]; exact hyn _ hv0
    have hterm : ∀ p q : Fin n,
        ψt (MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q) = 0 := by
      intro p q
      rw [map_mul, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_X']
      by_cases hp : p.val = 0
      · rw [hy0 p hp, mul_zero, zero_mul]
      · have : c₀ p q = 0 := by simp [hc₀, Matrix.of_apply, hp]
        rw [this]; simp
    have hg : ψt (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π) = 0 := by
      rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
        (IsLocalRing.residue_eq_zero_iff π).mpr hπm, map_zero, sub_zero]
      refine Finset.sum_eq_zero (fun p _ => ?_)
      rw [map_sum]
      exact Finset.sum_eq_zero (fun q _ => hterm p q)
    have hIker : ∀ a ∈ I, ψt a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hg, mul_zero]
    let ψ : wcQuadModelRing A n π c₀ →+* P := Ideal.Quotient.lift I ψt hIker
    have hψmk : ∀ a, ψ (Ideal.Quotient.mk I a) = ψt a := fun a => Ideal.Quotient.lift_mk _ _ _
    have hψX : ∀ p, ψ (Ideal.Quotient.mk I (MvPolynomial.X p)) = yh p := fun p => by
      rw [hψmk, MvPolynomial.eval₂Hom_X']
    have hcomp : ψ.comp (algebraMap A _) = (algebraMap κ P).comp (IsLocalRing.residue A) := by
      refine RingHom.ext fun a => ?_
      rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, hψmk,
        MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C]
    have hsurj : Function.Surjective ψ := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C a =>
        obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective a
        refine ⟨algebraMap A _ b, ?_⟩
        rw [← RingHom.comp_apply ψ, hcomp, RingHom.comp_apply, MvPolynomial.algebraMap_eq]
      | add f g hf hg =>
        obtain ⟨a, rfl⟩ := hf
        obtain ⟨b, rfl⟩ := hg
        exact ⟨a + b, map_add _ _ _⟩
      | mul_X f j hf =>
        obtain ⟨a, rfl⟩ := hf
        obtain ⟨p, hp⟩ := hon j
        exact ⟨a * Ideal.Quotient.mk I (MvPolynomial.X p), by rw [map_mul, hψX, hys p j hp]⟩
    refine ⟨ψ, hsurj, hcomp, ?_⟩

    let J : Ideal (wcQuadModelRing A n π c₀) :=
      Ideal.span ((fun p => Ideal.Quotient.mk I (MvPolynomial.X p)) '' {p | v p = none}) ⊔
        Ideal.map (algebraMap A _) (IsLocalRing.maximalIdeal A)
    have hker : RingHom.ker ψ ≤ J := by
      let τ : κ →+* wcQuadModelRing A n π c₀ ⧸ J :=
        Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) ((Ideal.Quotient.mk J).comp (algebraMap A _))
          (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha)))
      have hτ : ∀ a, τ (IsLocalRing.residue A a) = Ideal.Quotient.mk J (algebraMap A _ a) :=
        fun a => Ideal.Quotient.lift_mk _ _ _
      choose pj hpj using hon
      let σ : P →+* wcQuadModelRing A n π c₀ ⧸ J :=
        MvPolynomial.eval₂Hom τ (fun j => Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.X (pj j))))
      have hσC : ∀ a, σ (MvPolynomial.C a) = τ a := fun a => MvPolynomial.eval₂Hom_C _ _ _
      have hσX : ∀ j, σ (MvPolynomial.X j) =
          Ideal.Quotient.mk J (Ideal.Quotient.mk I (MvPolynomial.X (pj j))) :=
        fun j => MvPolynomial.eval₂Hom_X' _ _ _
      have hσ : σ.comp ψ = Ideal.Quotient.mk J := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [hψmk, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, ← MvPolynomial.algebraMap_eq,
            MvPolynomial.algebraMap_eq]
          change σ (MvPolynomial.C (IsLocalRing.residue A a)) = _
          rw [hσC, hτ]; rfl
        · intro p
          simp only [RingHom.comp_apply]
          rw [hψX]
          cases hp : v p with
          | none =>
            rw [hyn p hp, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.mem_sup_left (Ideal.subset_span ⟨p, hp, rfl⟩)
          | some j =>
            rw [hys p j hp, hσX, hinj (pj j) p j (hpj j) hp]
      intro m hm
      rw [RingHom.mem_ker] at hm
      have : Ideal.Quotient.mk J m = 0 := by
        rw [← hσ, RingHom.comp_apply, hm, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp this
    intro y
    constructor
    · rintro ⟨x, rfl⟩
      constructor
      · intro p hp
        show ψ (Ideal.Quotient.mk I (MvPolynomial.X p)) ∈ x.asIdeal
        rw [hψX, hyn p hp]
        exact zero_mem _
      · show Ideal.comap (algebraMap A _) (Ideal.comap ψ x.asIdeal) = _
        haveI : x.asIdeal.IsPrime := x.2
        rw [Ideal.comap_comap, hcomp, ← Ideal.comap_comap,
          Ideal.eq_bot_of_prime (Ideal.comap (algebraMap κ P) x.asIdeal),
          ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    · rintro ⟨h1, h2⟩
      have hJ : J ≤ y.asIdeal := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le]
          rintro _ ⟨p, hp, rfl⟩
          exact h1 p hp
        · rw [Ideal.map_le_iff_le_comap, h2]
      have hk : RingHom.ker ψ ≤ y.asIdeal := hker.trans hJ
      haveI : y.asIdeal.IsPrime := y.2
      haveI := Ideal.map_isPrime_of_surjective hsurj hk
      refine ⟨(⟨Ideal.map ψ y.asIdeal, this⟩ : PrimeSpectrum P), ?_⟩
      apply PrimeSpectrum.ext
      show Ideal.comap ψ (Ideal.map ψ y.asIdeal) = y.asIdeal
      rw [Ideal.comap_map_of_surjective' ψ hsurj, sup_eq_left.mpr hk]

  have hmv : ∀ (c' : ℕ), SmoothOfRelativeDimension c' (Spec.map (CommRingCat.ofHom
      (algebraMap (IsLocalRing.ResidueField A) (MvPolynomial (Fin c') (IsLocalRing.ResidueField A))))) := by
    intro c'
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension c'), CommRingCat.hom_ofHom]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have h := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial (IsLocalRing.ResidueField A) (Fin c')
    rwa [Nat.card_fin] at h


  have hZcl : ∀ p : Fin n, IsClosed {z : ↥(Limits.pullback f' (wcQmSp A)) |
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} := by
    intro p
    have h := (PrimeSpectrum.isClosed_zeroLocus
      {Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)}).preimage
        (Limits.pullback.fst f' (wcQmSp A) ≫ β).continuous
    convert h using 1
    ext z
    constructor
    · intro hz
      exact Set.singleton_subset_iff.mpr hz
    · intro hz
      exact (Set.singleton_subset_iff (s := (SetLike.coe ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z).asIdeal))).mp hz
  have hZ2 : IsClosed {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n, p.val % 2 = 0 →
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} := by
    have h := isClosed_iInter fun p : Fin n => isClosed_iInter fun _ : p.val % 2 = 0 => hZcl p
    convert h using 1
    ext z
    simp only [Set.mem_setOf_eq, Set.mem_iInter]
  have hZP : IsClosed {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n,
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} := by
    have h := isClosed_iInter fun p : Fin n => hZcl p
    convert h using 1
    ext z
    simp only [Set.mem_setOf_eq, Set.mem_iInter]
  obtain ⟨W, iW, hiW, hWred, hrW⟩ := s1 _ hZ2
  obtain ⟨PW, iP, hiP, hPred, hrP⟩ := s1 _ hZP
  haveI := hiW
  haveI := hiP
  haveI := hWred
  haveI := hPred

  have hker : iW.ker ≤ iP.ker := by
    rw [s2 iW, s2 iP]
    apply Scheme.IdealSheafData.vanishingIdeal_antimono
    intro z hz
    change z ∈ Set.range iW
    change z ∈ Set.range iP at hz
    rw [hrW]
    rw [hrP] at hz
    exact fun p _ => hz p
  set jP := IsClosedImmersion.lift iW iP hker with hjPdef
  have hfac : jP ≫ iW = iP := IsClosedImmersion.lift_fac iW iP hker
  have hjP : IsClosedImmersion jP := by
    apply IsClosedImmersion.comp_iff (g := iW).mp
    rw [hfac]
    exact hiP

  have he₀ : ∀ k, e k ≫ f' = Spec.map (CommRingCat.ofHom
      (algebraMap A (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))) := by
    intro k
    rw [← hf']
    exact he_str k
  have hpt : ∀ k (v : ↥(Limits.pullback (e k) (Limits.pullback.fst f' (wcQmSp A)))),
      (Limits.pullback.fst f' (wcQmSp A) ≫ β)
        (Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)) v) =
      (e k ≫ β) (Limits.pullback.fst (e k) (Limits.pullback.fst f' (wcQmSp A)) v) := by
    intro k v
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition_assoc]
  have hcov : ∀ x : ↥(Limits.pullback f' (wcQmSp A)), ∃ k,
      ∃ y : ↥(Limits.pullback (e k) (Limits.pullback.fst f' (wcQmSp A))),
        Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)) y = x := by
    intro x
    obtain ⟨k, y, hy⟩ := he_cov (Limits.pullback.fst f' (wcQmSp A) x)
    have hx : x ∈ Set.range (Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A))) := by
      rw [Scheme.Pullback.range_snd]
      exact ⟨y, hy⟩
    obtain ⟨w, hw⟩ := hx
    exact ⟨k, w, hw⟩
  have hu : ∀ k, IsOpenImmersion (Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A))) := by
    intro k
    haveI := he_open k
    infer_instance

  obtain ⟨vE, hvE⟩ : ∃ vE : Fin n → Option (Fin (n - 1)), ∀ p : Fin n,
      vE p = if h : p.val = 0 then none else some ⟨p.val - 1, by have := p.isLt; omega⟩ :=
    ⟨_, fun _ => rfl⟩
  have hvE0 : vE ⟨0, by omega⟩ = none := by rw [hvE, dif_pos rfl]
  have hvEn : ∀ p, vE p = none → p.val = 0 := by
    intro p hp
    by_contra h
    rw [hvE, dif_neg h] at hp
    exact absurd hp (by simp)
  have hvEs : ∀ p j, vE p = some j → p.val ≠ 0 ∧ p.val - 1 = j.val := by
    intro p j hp
    by_cases h : p.val = 0
    · rw [hvE, dif_pos h] at hp
      exact absurd hp (by simp)
    · rw [hvE, dif_neg h] at hp
      exact ⟨h, congrArg Fin.val (Option.some.inj hp)⟩
  have hvEon : ∀ j : Fin (n - 1), ∃ p, vE p = some j := by
    intro j
    refine ⟨⟨j.val + 1, by omega⟩, ?_⟩
    rw [hvE, dif_neg (by simp)]
    congr 1
  have hvEinj : ∀ (p q : Fin n) (j : Fin (n - 1)), vE p = some j → vE q = some j → p = q := by
    intro p q j hp hq
    obtain ⟨h1, h2⟩ := hvEs p j hp
    obtain ⟨h3, h4⟩ := hvEs q j hq
    exact Fin.ext (by omega)
  obtain ⟨ψE, hψEs, hψEc, hψEr⟩ := s5 (n - 1) vE hvE0 hvEon hvEinj
  have hQE : ∀ y : Spec (.of (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
      y ∈ Set.range (Spec.map (CommRingCat.ofHom ψE)) ↔
      (y ∈ {y : Spec (.of (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) |
          Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y} ∧
        Ideal.comap (algebraMap A _) (PrimeSpectrum.asIdeal y) = IsLocalRing.maximalIdeal A) := by
    intro y
    rw [hψEr y]
    apply and_congr_left'
    constructor
    · intro h
      exact h ⟨0, by omega⟩ hvE0
    · intro h p hp
      have h0 := hvEn p hp
      have hp0 : p = ⟨0, by omega⟩ := Fin.ext h0
      rw [hp0]
      exact h
  have hjmE : ∀ k, ∃ jm : Spec (.of (MvPolynomial (Fin (n - 1)) (IsLocalRing.ResidueField A))) ⟶
        Limits.pullback (e k) (Limits.pullback.fst f' (wcQmSp A)),
      IsClosedImmersion jm ∧
      Set.range jm = {v | Limits.pullback.fst (e k) (Limits.pullback.fst f' (wcQmSp A)) v ∈
        {y : Spec (.of (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) |
          Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y}} ∧
      jm ≫ Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)) ≫
        Limits.pullback.snd f' (wcQmSp A) =
        Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
          (MvPolynomial (Fin (n - 1)) (IsLocalRing.ResidueField A)))) :=
    fun k => s4 _ _ (e k) (he₀ k) (n - 1) ψE hψEs hψEc _ hQE
  choose jmE hjmEc hjmEr hjmEs using hjmE
  have hrE : ∀ k, Set.range (jmE k) =
      (Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A))) ⁻¹' Set.range iW := by
    intro k
    rw [hjmEr k, hrW]
    ext v
    simp only [Set.mem_setOf_eq, Set.mem_preimage]
    rw [hpt k v]
    exact (hE k _).symm
  have hsE : ∀ k, SmoothOfRelativeDimension (n - 1) (jmE k ≫
      Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)) ≫
        Limits.pullback.snd f' (wcQmSp A)) := by
    intro k
    rw [hjmEs k]
    exact hmv (n - 1)
  have hsmW : SmoothOfRelativeDimension (n - 1) (iW ≫ Limits.pullback.snd f' (wcQmSp A)) :=
    s3 (Limits.pullback.snd f' (wcQmSp A)) iW (n - 1)
      (fun k => Limits.pullback (e k) (Limits.pullback.fst f' (wcQmSp A)))
      (fun _ => Spec (.of (MvPolynomial (Fin (n - 1)) (IsLocalRing.ResidueField A))))
      (fun k => Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)))
      jmE hu hjmEc (fun _ => inferInstance) hcov hrE hsE

  obtain ⟨vP, hvP⟩ : ∃ vP : Fin n → Option (Fin (n - 1 - n / 2)), ∀ p : Fin n,
      vP p = if h : p.val % 2 = 0 ∧ p.val ≠ 0 then
        some ⟨p.val / 2 - 1, by have := p.isLt; omega⟩ else none :=
    ⟨_, fun _ => rfl⟩
  have hvPn : ∀ p, vP p = none → ¬ (p.val % 2 = 0 ∧ p.val ≠ 0) := by
    intro p hp h
    rw [hvP, dif_pos h] at hp
    exact absurd hp (by simp)
  have hvPn' : ∀ p : Fin n, ¬ (p.val % 2 = 0 ∧ p.val ≠ 0) → vP p = none := by
    intro p h
    rw [hvP, dif_neg h]
  have hvPs : ∀ p j, vP p = some j → (p.val % 2 = 0 ∧ p.val ≠ 0) ∧ p.val / 2 - 1 = j.val := by
    intro p j hp
    by_cases h : p.val % 2 = 0 ∧ p.val ≠ 0
    · rw [hvP, dif_pos h] at hp
      exact ⟨h, congrArg Fin.val (Option.some.inj hp)⟩
    · rw [hvP, dif_neg h] at hp
      exact absurd hp (by simp)
  have hvP0 : vP ⟨0, by omega⟩ = none := hvPn' _ (by simp)
  have hvPon : ∀ j : Fin (n - 1 - n / 2), ∃ p, vP p = some j := by
    intro j
    have hj := j.isLt
    refine ⟨⟨2 * j.val + 2, by omega⟩, ?_⟩
    rw [hvP, dif_pos (by constructor <;> simp <;> omega)]
    congr 1
    exact Fin.ext (by show (2 * j.val + 2) / 2 - 1 = j.val; omega)
  have hvPinj : ∀ (p q : Fin n) (j : Fin (n - 1 - n / 2)), vP p = some j → vP q = some j →
      p = q := by
    intro p q j hp hq
    obtain ⟨⟨h1, h2⟩, h3⟩ := hvPs p j hp
    obtain ⟨⟨h4, h5⟩, h6⟩ := hvPs q j hq
    exact Fin.ext (by omega)
  obtain ⟨ψP, hψPs, hψPc, hψPr⟩ := s5 (n - 1 - n / 2) vP hvP0 hvPon hvPinj
  have hQP : ∀ y : Spec (.of (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
      y ∈ Set.range (Spec.map (CommRingCat.ofHom ψP)) ↔
      (y ∈ {y : Spec (.of (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) |
          Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          ∀ p : Fin n, p.val % 2 = 1 → 3 ≤ p.val → Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal y} ∧
        Ideal.comap (algebraMap A _) (PrimeSpectrum.asIdeal y) = IsLocalRing.maximalIdeal A) := by
    intro y
    rw [hψPr y]
    apply and_congr_left'
    constructor
    · intro h
      refine ⟨h ⟨0, by omega⟩ hvP0, h ⟨1, by omega⟩ (hvPn' _ (by simp)), ?_⟩
      intro p hp1 _
      exact h p (hvPn' p (by omega))
    · rintro ⟨h0, h1, h3⟩ p hp
      have hc := hvPn p hp
      by_cases hp0 : p.val = 0
      · have e0 : p = ⟨0, by omega⟩ := Fin.ext hp0
        rw [e0]
        exact h0
      · by_cases hp1 : p.val = 1
        · have e1 : p = ⟨1, by omega⟩ := Fin.ext hp1
          rw [e1]
          exact h1
        · exact h3 p (by omega) (by omega)
  have hjmP : ∀ k, ∃ jm : Spec (.of (MvPolynomial (Fin (n - 1 - n / 2))
        (IsLocalRing.ResidueField A))) ⟶
        Limits.pullback (e k) (Limits.pullback.fst f' (wcQmSp A)),
      IsClosedImmersion jm ∧
      Set.range jm = {v | Limits.pullback.fst (e k) (Limits.pullback.fst f' (wcQmSp A)) v ∈
        {y : Spec (.of (wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) |
          Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          ∀ p : Fin n, p.val % 2 = 1 → 3 ≤ p.val → Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal y}} ∧
      jm ≫ Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)) ≫
        Limits.pullback.snd f' (wcQmSp A) =
        Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
          (MvPolynomial (Fin (n - 1 - n / 2)) (IsLocalRing.ResidueField A)))) :=
    fun k => s4 _ _ (e k) (he₀ k) (n - 1 - n / 2) ψP hψPs hψPc _ hQP
  choose jmP hjmPc hjmPr hjmPs using hjmP
  have hrP' : ∀ k, Set.range (jmP k) =
      (Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A))) ⁻¹' Set.range iP := by
    intro k
    rw [hjmPr k, hrP]
    ext v
    simp only [Set.mem_setOf_eq, Set.mem_preimage]
    rw [hpt k v]
    exact (hP k _).symm
  have hsP : ∀ k, SmoothOfRelativeDimension (n - 1 - n / 2) (jmP k ≫
      Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)) ≫
        Limits.pullback.snd f' (wcQmSp A)) := by
    intro k
    rw [hjmPs k]
    exact hmv (n - 1 - n / 2)
  have hsmP : SmoothOfRelativeDimension (n - 1 - n / 2)
      (iP ≫ Limits.pullback.snd f' (wcQmSp A)) :=
    s3 (Limits.pullback.snd f' (wcQmSp A)) iP (n - 1 - n / 2)
      (fun k => Limits.pullback (e k) (Limits.pullback.fst f' (wcQmSp A)))
      (fun _ => Spec (.of (MvPolynomial (Fin (n - 1 - n / 2)) (IsLocalRing.ResidueField A))))
      (fun k => Limits.pullback.snd (e k) (Limits.pullback.fst f' (wcQmSp A)))
      jmP hu hjmPc (fun _ => inferInstance) hcov hrP' hsP
  refine ⟨W, iW, hiW, hrW, hsmW, PW, jP, hjP, ?_, ?_⟩
  · rw [hfac, hrP]
  · rw [← Category.assoc, hfac]
    exact hsmP

theorem wc_etqm_srdmv_strict_smooth (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (e : Fin n → (Spec (.of (wcQuadModelRing A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X'))
    (he_open : ∀ k, IsOpenImmersion (e k)) (he_cov : ∀ x : X', ∃ k y, e k y = x)
    (he_str : ∀ k, e k ≫ β ≫ wcQuadModelStr A n π c = wcQuadModelStr A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (hE : ∀ k y, (∀ p : Fin n, p.val % 2 = 0 → Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
