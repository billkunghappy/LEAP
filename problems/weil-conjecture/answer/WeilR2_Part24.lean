  obtain ⟨σ, hσ, hext⟩ := GLUE0 (wcProjK K n) φl hcompat
  refine ⟨σ, ?_, ?_, ?_⟩
  · apply hext
    intro i
    rw [← Category.assoc, hσ, hφq]
  · intro i J
    have h1 : (U i).ι ⁻¹ᵁ (σ ⁻¹ᵁ wcSgD K n J) =
        (↑(U i) : Scheme.{u}).basicOpen ((U i).topIso.inv (s i J)) := by
      rw [← Scheme.Hom.comp_preimage, hσ, hφpre]
    have h2 := congrArg (fun O => (U i).ι ''ᵁ O) h1
    simp only at h2
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      Scheme.Opens.ι_image_basicOpen_topIso_inv] at h2
    rw [inf_comm]
    exact h2
  · intro i J L O hO hOi
    have hOe : (U i).ι ⁻¹ᵁ O ≤ ((U i).ι ≫ σ) ⁻¹ᵁ wcSgD K n J := Scheme.Hom.preimage_mono _ hO
    have e : ((U i).ι ≫ σ).appLE (wcSgD K n J) ((U i).ι ⁻¹ᵁ O) hOe (wcSgE K n J L) *
        (↑(U i) : Scheme.{u}).presheaf.map (homOfLE (le_top : (U i).ι ⁻¹ᵁ O ≤ ⊤)).op
          ((U i).topIso.inv (s i J)) =
        (↑(U i) : Scheme.{u}).presheaf.map (homOfLE (le_top : (U i).ι ⁻¹ᵁ O ≤ ⊤)).op
          ((U i).topIso.inv (s i L)) := by
      have := hφrel i J L ((U i).ι ⁻¹ᵁ O)
      rw [← hσ i] at this
