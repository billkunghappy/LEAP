    intro i j h1 h2
    rw [hcs]
    simp only [hcol0 i h1]
    exact (hPmid j h2.1 h2.2).1
  have Flm : ∀ i j : Fin (e + 2 + 1 + 1), i.val = e + 3 → (1 ≤ j.val ∧ j.val ≤ e + 2) →
