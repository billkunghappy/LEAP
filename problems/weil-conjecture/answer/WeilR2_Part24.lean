    fun i j => (P.transpose * Matrix.of a * P) i j with hcdef
  have hc : ∀ i j, c i j = ∑ p, ∑ q, P p i * a p q * P q j := by
    intro i j
    simp only [hcdef, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Finset.sum_mul]
