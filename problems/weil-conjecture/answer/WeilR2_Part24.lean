theorem wc_srdcbR_epb_model_fibre : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] (n : ℕ), Even n → 4 ≤ n → ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (c : Matrix (Fin n) (Fin n) A), c = Matrix.of (fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) → ∀ (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c))), wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n => (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ : Fin n)))))) β → ∀ (ρ : wcQuadModelRing A n π c →+* MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)), ρ.comp (algebraMap A (wcQuadModelRing A n π c)) = (MvPolynomial.C : IsLocalRing.ResidueField A →+* MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)).comp (IsLocalRing.residue A) → (∀ p : Fin n, p.val % 2 = 0 → ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0) → (∀ (p : Fin n) (hp : p.val % 2 = 1), ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = MvPolynomial.X ⟨p, hp⟩) → ∀ (g : Spec (.of (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A))) ⟶ Spec (.of (wcQuadModelRing A n π c))), g = Spec.map (CommRingCat.ofHom ρ) → ∀ (q : Spec (.of (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A))) ⟶ Spec (.of (IsLocalRing.ResidueField A))), q = Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A) (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)))) → ∃ e : Limits.pullback β g ≅ Limits.pullback (wcProjKStr (IsLocalRing.ResidueField A) (n / 2 - 1)) q, e.hom ≫ Limits.pullback.snd _ _ = Limits.pullback.snd β g :=
by
  intro A _ _ _ n hn hn4 π hπ c hc X' β hbl ρ hρA hρev hρodd g hg q hq
