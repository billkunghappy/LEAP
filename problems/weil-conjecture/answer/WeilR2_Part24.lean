  obtain ⟨α⟩ := wc_et_pull_data_toSheaf_iso Di
  have hZ' : Limits.IsZero ((SheafOfModules.toSheaf (wcEtZModRing Z m)).obj (Di.Φ.obj
      ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange β) _ _ Dβ.cont
        Dβ.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology k))) :=
    hZ1.of_iso (α.app _)
  rw [Limits.IsZero.iff_id_eq_zero]
  apply (SheafOfModules.toSheaf (wcEtZModRing Z m)).map_injective
  rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
  exact hZ'.eq_of_src _ _

theorem wc_srtq_dv_bottom_shift : ∀ {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] (C : CochainComplex 𝒜 ℤ) (d : ℤ), C.IsStrictlyGE d → (∀ n, Injective (C.X n)) → C.ExactAt d → ∃ E : CochainComplex 𝒜 ℤ, E.IsStrictlyGE (d + 1) ∧ (∀ n, Injective (E.X n)) ∧ Nonempty (HomotopyEquiv C E) :=
by
  intro 𝒜 _ _ C d hC hinj hex
  haveI := hC

  have hmono : Mono (C.d d (d + 1)) := by
    have h1 := (HomologicalComplex.exactAt_iff' C (d - 1) d (d + 1)
      (CochainComplex.prev ℤ d) (CochainComplex.next ℤ d)).mp hex
    exact h1.mono_g ((CochainComplex.isZero_of_isStrictlyGE C d (d - 1) (by omega)).eq_of_src _ _)

  haveI := hinj d
  let r : C.X (d + 1) ⟶ C.X d := Injective.factorThru (𝟙 (C.X d)) (C.d d (d + 1))
  have hr : C.d d (d + 1) ≫ r = 𝟙 _ := Injective.comp_factorThru _ _

  let hom : ∀ i j : ℤ, C.X i ⟶ C.X j := fun i j =>
    if h : i = d + 1 ∧ j = d then
      eqToHom (congrArg C.X h.1) ≫ (-r) ≫ eqToHom (congrArg C.X h.2.symm) else 0
  have hom_zero : ∀ i j, ¬ (ComplexShape.up ℤ).Rel j i → hom i j = 0 := by
    intro i j hij
    simp only [hom]
    rw [dif_neg]
    rintro ⟨rfl, rfl⟩
    exact hij rfl
  have hom1 : hom (d + 1) d = -r := by
    simp [hom]
  have hom2 : ∀ i j, j ≠ d → hom i j = 0 := by
    intro i j hj
    simp only [hom]
    rw [dif_neg]
    rintro ⟨-, h⟩
    exact hj h
  let N : C ⟶ C := Homotopy.nullHomotopicMap hom

  have hNd : N.f d = -𝟙 _ := by
    rw [Homotopy.nullHomotopicMap_f (k₂ := d - 1) (k₁ := d) (k₀ := d + 1) (by simp) (by simp) hom,
      hom1, hom2 d (d - 1) (by omega)]
    simp [hr]
  have hNd1 : N.f (d + 1) = -(r ≫ C.d d (d + 1)) := by
    rw [Homotopy.nullHomotopicMap_f (k₂ := d) (k₁ := d + 1) (k₀ := d + 1 + 1) (by simp) (by simp)
      hom, hom1, hom2 (d + 1 + 1) (d + 1) (by omega)]
    simp
  have hNk : ∀ k, k ≠ d → k ≠ d + 1 → N.f k = 0 := by
    intro k h1 h2
    rw [Homotopy.nullHomotopicMap_f (k₂ := k - 1) (k₁ := k) (k₀ := k + 1) (by simp) (by simp) hom,
      hom2 (k + 1) k h1, hom2 k (k - 1) (by omega)]
    simp

  let e : C ⟶ C := 𝟙 C + N
  have hef : ∀ k, e.f k = 𝟙 _ + N.f k := fun k => by
    simp [e]
  have H : Homotopy e (𝟙 C) :=
    ((Homotopy.refl (𝟙 C)).add (Homotopy.nullHomotopy hom hom_zero)).trans
      (Homotopy.ofEq (add_zero _))
  have he : e ≫ e = e := by
    ext k
    rw [HomologicalComplex.comp_f, hef]
    by_cases h1 : k = d
    · subst h1
      rw [hNd]
      simp
    · by_cases h2 : k = d + 1
      · subst h2
        rw [hNd1]
        simp only [Preadditive.add_comp, Preadditive.comp_add, Category.id_comp,
          Category.comp_id, Preadditive.neg_comp, Preadditive.comp_neg, neg_neg, Category.assoc,
          reassoc_of% hr]
        abel
      · rw [hNk k h1 h2]
        simp
  have hvan : ∀ j : ℤ, j < d + 1 → e.f j = 0 := by
    intro j hj
    by_cases h1 : j = d
    · subst h1
      rw [hef, hNd]
      simp
    · exact (CochainComplex.isZero_of_isStrictlyGE C d j (by omega)).eq_of_src _ _

  obtain ⟨E, i, p, hip, hpi⟩ := IsIdempotentComplete.idempotents_split C e he
  refine ⟨E, ?_, ?_, ⟨⟨p, i, (Homotopy.ofEq hpi).trans H, Homotopy.ofEq hip⟩⟩⟩
  · rw [CochainComplex.isStrictlyGE_iff]
    intro j hj
    rw [Limits.IsZero.iff_id_eq_zero]
    have h1 : i ≫ e ≫ p = 𝟙 E := by
      rw [← hpi, Category.assoc, reassoc_of% hip, hip]
    have h2 := congrArg (fun φ => HomologicalComplex.Hom.f φ j) h1
    simp only [HomologicalComplex.comp_f, HomologicalComplex.id_f] at h2
    rw [← h2, hvan j hj]
    simp
  · intro n
    haveI := hinj n
    exact Retract.injective ⟨i.f n, p.f n, by
      rw [← HomologicalComplex.comp_f, hip, HomologicalComplex.id_f]⟩

theorem wc_srtq_dv_resolution_comparison : ∀ {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] (C : CochainComplex 𝒜 ℤ) (d : ℤ), C.IsStrictlyGE d → (∀ n, Injective (C.X n)) → ∀ (I : InjectiveResolution (C.homology d)), ∃ f : I.cocomplex.extend (ComplexShape.embeddingUpIntGE d) ⟶ C, QuasiIsoAt f d :=
by
  intro 𝒜 _ _ C d hC hinj I
  let e := ComplexShape.embeddingUpIntGE d
  let D := C.restriction e
  haveI := hC
  haveI : IsIso (HomologicalComplex.restrictionToTruncGE' C e) :=
    HomologicalComplex.Hom.isIso_of_components _
  have hπ : IsIso (HomologicalComplex.πTruncGE C e) := inferInstance
  let ψ : D.extend e ⟶ C :=
    (e.extendFunctor 𝒜).map (HomologicalComplex.restrictionToTruncGE' C e) ≫
      @inv _ _ _ _ (HomologicalComplex.πTruncGE C e) hπ
  haveI : IsIso ψ := by
    dsimp only [ψ]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ (Functor.map_isIso _ _) (@IsIso.inv_isIso _ _ _ _ _ hπ)
  have h0 : e.f 0 = d := by simp [e]
  let β : C.homology d ≅ D.cycles 0 :=
    (asIso (HomologicalComplex.homologyMap ψ d)).symm ≪≫ D.extendHomologyIso e h0 ≪≫
      (CochainComplex.isoHomologyπ₀ D).symm
  have hD : ∀ n, Injective (D.X n) := fun n => hinj _
  let S := (CochainComplex.single₀ 𝒜).obj (C.homology d)
  let σ : S.X 0 ≅ C.homology d := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 _
  let α : S.X 0 ⟶ D.X 0 := σ.hom ≫ β.hom ≫ D.iCycles 0
  have hα : α ≫ D.d 0 1 = 0 := by
    simp only [α, Category.assoc, HomologicalComplex.iCycles_d, Limits.comp_zero]

  haveI hm : Mono (I.ι.f 0) := I.instMonoFNatι 0
  let g0 : I.cocomplex.X 0 ⟶ D.X 0 := Injective.factorThru α (I.ι.f 0)
  have hg0 : I.ι.f 0 ≫ g0 = α := Injective.comp_factorThru _ _
  have hs1 : I.ι.f 0 ≫ g0 ≫ D.d 0 1 = 0 := by
    rw [← Category.assoc, hg0, hα]
  let g1 : I.cocomplex.X 1 ⟶ D.X 1 := I.exact₀.descToInjective (g0 ≫ D.d 0 1) hs1
  have hg1 : I.cocomplex.d 0 1 ≫ g1 = g0 ≫ D.d 0 1 := I.exact₀.comp_descToInjective _ _
  let g : I.cocomplex ⟶ D := CochainComplex.mkHom I.cocomplex D g0 g1 hg1.symm
    (fun n p => ⟨(I.exact_succ n).descToInjective (p.2.1 ≫ D.d (n + 1) (n + 2)) (by
        rw [← Category.assoc, ← p.2.2, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero]),
      ((I.exact_succ n).comp_descToInjective _ _).symm⟩)
  have hg : I.ι.f 0 ≫ g.f 0 = α := by
    rw [CochainComplex.mkHom_f_0]; exact hg0

  have hq0 : QuasiIsoAt g 0 := by
    rw [quasiIsoAt_iff_isIso_homologyMap]
    have hφ : (I.ι ≫ g).f 0 = α := by
      rw [HomologicalComplex.comp_f]; exact hg
    let c0 : S.cycles 0 ⟶ D.cycles 0 :=
      (HomologicalComplex.singleObjCyclesSelfIso (ComplexShape.up ℕ) 0 (C.homology d)).hom ≫ β.hom
    have hc : HomologicalComplex.cyclesMap (I.ι ≫ g) 0 = c0 := by
      rw [← cancel_mono (D.iCycles 0), HomologicalComplex.cyclesMap_i, hφ]
      simp only [c0, α, σ, HomologicalComplex.singleObjCyclesSelfIso_hom, Category.assoc]
    haveI : IsIso (HomologicalComplex.cyclesMap (I.ι ≫ g) 0) := by rw [hc]; infer_instance
    have hnat := HomologicalComplex.homologyπ_naturality (I.ι ≫ g) 0
    haveI : IsIso (S.homologyπ 0 ≫ HomologicalComplex.homologyMap (I.ι ≫ g) 0) := by
      rw [hnat]; infer_instance
    haveI : IsIso (HomologicalComplex.homologyMap (I.ι ≫ g) 0) :=
      IsIso.of_isIso_comp_left (S.homologyπ 0) _
    have hcomp := HomologicalComplex.homologyMap_comp I.ι g 0
    haveI : IsIso (HomologicalComplex.homologyMap I.ι 0 ≫ HomologicalComplex.homologyMap g 0) := by
      rw [← hcomp]; infer_instance
    exact IsIso.of_isIso_comp_left (HomologicalComplex.homologyMap I.ι 0) _

  have hge : QuasiIsoAt (HomologicalComplex.extendMap g e) d := by
    rw [quasiIsoAt_iff_isIso_homologyMap]
    rw [quasiIsoAt_iff_isIso_homologyMap] at hq0
    have hn := HomologicalComplex.extendHomologyIso_hom_naturality g e h0
    haveI : IsIso (HomologicalComplex.homologyMap (HomologicalComplex.extendMap g e) d ≫
        (D.extendHomologyIso e h0).hom) := by rw [hn]; infer_instance
    exact IsIso.of_isIso_comp_right _ (D.extendHomologyIso e h0).hom
  refine ⟨HomologicalComplex.extendMap g e ≫ ψ, ?_⟩
  rw [quasiIsoAt_iff_isIso_homologyMap, HomologicalComplex.homologyMap_comp]
  rw [quasiIsoAt_iff_isIso_homologyMap] at hge
  infer_instance

theorem wc_srtq_dv_cone_homology : ∀ {𝒜 𝒞 : Type*} [Category 𝒜] [Category 𝒞] [Abelian 𝒜] [Abelian 𝒞] (Φ : 𝒜 ⥤ 𝒞) [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ] {X Y : CochainComplex 𝒜 ℤ} (φ : X ⟶ Y) (q q' : ℤ), q + 1 = q' → (Limits.IsZero (Φ.obj (X.homology q)) → Limits.IsZero (Φ.obj ((CochainComplex.mappingCone φ).homology q)) → Limits.IsZero (Φ.obj (Y.homology q))) ∧ (Limits.IsZero (Φ.obj (Y.homology q)) → Mono (HomologicalComplex.homologyMap φ q') → Limits.IsZero (Φ.obj ((CochainComplex.mappingCone φ).homology q))) ∧ (Epi (HomologicalComplex.homologyMap φ q) → Mono (HomologicalComplex.homologyMap φ q') → Limits.IsZero ((CochainComplex.mappingCone φ).homology q)) :=
by
  intro 𝒜 𝒞 _ _ _ _ Φ _ _ _ X Y φ q q' hqq'
  let H := HomotopyCategory.homologyFunctor 𝒜 (ComplexShape.up ℤ) 0
  let Q := HomotopyCategory.quotient 𝒜 (ComplexShape.up ℤ)
  let T := CochainComplex.mappingCone.triangleh φ
  have hT : T ∈ distTriang (HomotopyCategory 𝒜 (ComplexShape.up ℤ)) :=
    HomotopyCategory.mappingCone_triangleh_distinguished φ
  let e : ∀ (n : ℤ) (K : CochainComplex 𝒜 ℤ), (H.shift n).obj (Q.obj K) ≅ K.homology n :=
    fun n K => (HomotopyCategory.homologyFunctorFactors 𝒜 (ComplexShape.up ℤ) n).app K
  have hN : ∀ (n : ℤ) {K L : CochainComplex 𝒜 ℤ} (f : K ⟶ L),
      (H.shift n).map (Q.map f) ≫ (e n L).hom =
        (e n K).hom ≫ HomologicalComplex.homologyMap f n :=
    fun n K L f => (HomotopyCategory.homologyFunctorFactors 𝒜 (ComplexShape.up ℤ) n).hom.naturality f
  have hφ : ∀ n : ℤ, (H.shift n).map T.mor₁ =
      (e n X).hom ≫ HomologicalComplex.homologyMap φ n ≫ (e n Y).inv := by
    intro n
    rw [← Category.assoc, ← hN, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rfl
  have hδ : Mono (HomologicalComplex.homologyMap φ q') → H.homologySequenceδ T q q' hqq' = 0 := by
    intro hm
    rw [← H.homologySequence_mono_shift_map_mor₁_iff T hT q q' hqq', hφ]
    have i1 : Mono (e q' X).hom := ⟨fun g h w => by simpa using congrArg (· ≫ (e q' X).inv) w⟩
    have i2 : Mono (e q' Y).inv := ⟨fun g h w => by simpa using congrArg (· ≫ (e q' Y).hom) w⟩
    exact @mono_comp _ _ _ _ _ _ i1 _ (@mono_comp _ _ _ _ _ _ hm _ i2)
  have ex2 := H.homologySequence_exact₂ T hT q
  have ex3 := H.homologySequence_exact₃ T hT q q' hqq'
  refine ⟨fun hX hC => ?_, fun hY hm => ?_, fun he hm => ?_⟩
  · have hX' : Limits.IsZero (Φ.obj ((H.shift q).obj T.obj₁)) := hX.of_iso (Φ.mapIso (e q X))
    have hC' : Limits.IsZero (Φ.obj ((H.shift q).obj T.obj₃)) := hC.of_iso (Φ.mapIso (e q _))
    have h := (ex2.map Φ).isZero_X₂ (hX'.eq_of_src _ _) (hC'.eq_of_tgt _ _)
    exact h.of_iso (Φ.mapIso (e q Y)).symm
  · have hY' : Limits.IsZero (Φ.obj ((H.shift q).obj T.obj₂)) := hY.of_iso (Φ.mapIso (e q Y))
    have hg : Φ.map (H.homologySequenceδ T q q' hqq') = 0 := by rw [hδ hm, Φ.map_zero]
    have h := (ex3.map Φ).isZero_X₂ (hY'.eq_of_src _ _) hg
    exact h.of_iso (Φ.mapIso (e q _)).symm
  · have h2 : (H.shift q).map T.mor₂ = 0 := by
      rw [← H.homologySequence_epi_shift_map_mor₁_iff T hT q, hφ]
      have i1 : Epi (e q X).hom := ⟨fun g h w => by simpa using congrArg ((e q X).inv ≫ ·) w⟩
      have i2 : Epi (e q Y).inv := ⟨fun g h w => by simpa using congrArg ((e q Y).hom ≫ ·) w⟩
      exact @epi_comp _ _ _ _ _ _ i1 _ (@epi_comp _ _ _ _ _ _ he _ i2)
    have h := ex3.isZero_X₂ h2 (hδ hm)
    exact h.of_iso (e q _).symm

theorem wc_srtq_dv_map_extend_homology : ∀ {𝒜 ℬ : Type*} [Category 𝒜] [Category ℬ] [Abelian 𝒜] [Abelian ℬ] (P : 𝒜 ⥤ ℬ) [P.Additive] (K : CochainComplex 𝒜 ℕ) (d : ℤ), (∀ q : ℤ, q < d → Limits.IsZero (((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj (K.extend (ComplexShape.embeddingUpIntGE d))).homology q)) ∧ ∀ k : ℕ, Nonempty (((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj (K.extend (ComplexShape.embeddingUpIntGE d))).homology (d + k) ≅ ((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology k) :=
by
  intro 𝒜 ℬ _ _ _ _ P _ K d
  refine ⟨fun q hq => ?_, fun k => ?_⟩
  · have h1 : Limits.IsZero ((K.extend (ComplexShape.embeddingUpIntGE d)).X q) :=
      HomologicalComplex.isZero_extend_X K _ q (fun k => by
        rw [ComplexShape.embeddingUpIntGE_f]; omega)
    have h2 : Limits.IsZero (((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (K.extend (ComplexShape.embeddingUpIntGE d))).X q) := P.map_isZero h1
    exact ShortComplex.isZero_homology_of_isZero_X₂ _ h2
  · set e := ComplexShape.embeddingUpIntGE d with he
    set PK := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj K with hPK
    let g : ∀ o : Option ℕ, P.obj (HomologicalComplex.extend.X K o) ≅
        HomologicalComplex.extend.X PK o := fun o =>
      match o with
      | some _ => Iso.refl _
      | none => Limits.IsZero.iso (P.map_isZero (HomologicalComplex.extend.isZero_X K rfl))
          (HomologicalComplex.extend.isZero_X PK rfl)
    have hg : ∀ o o' : Option ℕ, (g o).hom ≫ HomologicalComplex.extend.d PK o o' =
        P.map (HomologicalComplex.extend.d K o o') ≫ (g o').hom := by
      intro o o'
      cases o with
      | none => exact Limits.IsZero.eq_of_src (P.map_isZero (HomologicalComplex.extend.isZero_X K rfl)) _ _
      | some a =>
        cases o' with
        | none => exact Limits.IsZero.eq_of_tgt (HomologicalComplex.extend.isZero_X PK rfl) _ _
        | some b =>
          show 𝟙 _ ≫ P.map (K.d a b) = P.map (K.d a b) ≫ 𝟙 _
          simp
    let φ : (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj (K.extend e) ≅ PK.extend e :=
      HomologicalComplex.Hom.isoOfComponents (fun i => g (e.r i)) (fun i j _ => hg (e.r i) (e.r j))
    exact ⟨HomologicalComplex.homologyMapIso φ (d + k) ≪≫
      PK.extendHomologyIso e (ComplexShape.embeddingUpIntGE_f d k)⟩

theorem wc_srtq_complex_devissage : ∀ {𝒜 𝒜' ℬ 𝒞 : Type*} [Category 𝒜] [Category 𝒜'] [Category ℬ] [Category 𝒞] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ] [Abelian 𝒞] [EnoughInjectives 𝒜] (Φ' : 𝒜 ⥤ 𝒜') [Φ'.Additive] [Limits.PreservesFiniteLimits Φ'] [Limits.PreservesFiniteColimits Φ'] (P : 𝒜 ⥤ ℬ) [P.Additive] [Limits.PreservesFiniteLimits P] (Φ : ℬ ⥤ 𝒞) [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ], (∀ (N : 𝒜), Limits.IsZero (Φ'.obj N) → ∀ (J : InjectiveResolution N) (k : ℕ), Limits.IsZero (Φ.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology k))) → ∀ (C : CochainComplex 𝒜 ℤ) (d : ℤ), C.IsStrictlyGE d → (∀ n, Injective (C.X n)) → (∀ q, Limits.IsZero (Φ'.obj (C.homology q))) → ∀ q : ℤ, Limits.IsZero (Φ.obj (((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj C).homology q)) :=
by
  intro 𝒜 𝒜' ℬ 𝒞 _ _ _ _ _ _ _ _ _ Φ' _ _ _ P _ _ Φ _ _ _ hyp
  have key : ∀ n : ℕ, ∀ (C : CochainComplex 𝒜 ℤ) (d : ℤ), C.IsStrictlyGE d →
      (∀ i, Injective (C.X i)) → (∀ j, Limits.IsZero (Φ'.obj (C.homology j))) →
      ∀ q : ℤ, q < d + n →
      Limits.IsZero (Φ.obj (((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj C).homology q)) := by
    intro n
    induction n with
    | zero =>
      intro C d hC _ _ q hq
      apply Φ.map_isZero
      exact ShortComplex.isZero_homology_of_isZero_X₂
        (((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj C).sc q)
        (P.map_isZero (CochainComplex.isZero_of_isStrictlyGE C d q (by simpa using hq)))
    | succ n ih =>
      intro C d hC hinj hΦ' q hq
      let I : InjectiveResolution (C.homology d) := injectiveResolution (C.homology d)
      obtain ⟨f, hf⟩ := wc_srtq_dv_resolution_comparison C d hC hinj I
      rw [quasiIsoAt_iff_isIso_homologyMap] at hf

      have hI'zero : ∀ j : ℤ, j ≠ d →
          Limits.IsZero ((I.cocomplex.extend (ComplexShape.embeddingUpIntGE d)).homology j) := by
        intro j hj
        by_cases hjd : j < d
        · rw [← HomologicalComplex.exactAt_iff_isZero_homology]
          apply HomologicalComplex.extend_exactAt
          intro k
          rw [ComplexShape.embeddingUpIntGE_f]
          omega
        · obtain ⟨k, hk⟩ : ∃ k : ℕ, d + ((k + 1 : ℕ) : ℤ) = j := ⟨(j - d - 1).toNat, by omega⟩
          refine Limits.IsZero.of_iso ?_ (I.cocomplex.extendHomologyIso
            (ComplexShape.embeddingUpIntGE d) (j := k + 1) (j' := j)
            (by rw [ComplexShape.embeddingUpIntGE_f]; exact hk))
          rw [← HomologicalComplex.exactAt_iff_isZero_homology]
          exact I.cocomplex_exactAt_succ k
      have hmono : ∀ j : ℤ, Mono (HomologicalComplex.homologyMap f j) := by
        intro j
        by_cases hj : j = d
        · rw [hj]; infer_instance
        · exact (hI'zero j hj).mono _

      have hM0 : ∀ j, Limits.IsZero (Φ'.obj ((CochainComplex.mappingCone f).homology j)) :=
        fun j => (wc_srtq_dv_cone_homology Φ' f j (j + 1) rfl).2.1 (hΦ' j) (hmono (j + 1))
      have hCd1 : Limits.IsZero (C.homology (d - 1)) :=
        ShortComplex.isZero_homology_of_isZero_X₂ (C.sc (d - 1))
          (CochainComplex.isZero_of_isStrictlyGE C d (d - 1) (by omega))
      have hMd1 : (CochainComplex.mappingCone f).ExactAt (d - 1) := by
        rw [HomologicalComplex.exactAt_iff_isZero_homology]
        exact (wc_srtq_dv_cone_homology (𝟭 𝒜) f (d - 1) d (by omega)).2.2 (hCd1.epi _) (hmono d)
      have hMd : Limits.IsZero ((CochainComplex.mappingCone f).homology d) :=
        (wc_srtq_dv_cone_homology (𝟭 𝒜) f d (d + 1) rfl).2.2 inferInstance (hmono (d + 1))
      have hMge : (CochainComplex.mappingCone f).IsStrictlyGE (d - 1) := by
        rw [CochainComplex.isStrictlyGE_iff]
        intro i hi
