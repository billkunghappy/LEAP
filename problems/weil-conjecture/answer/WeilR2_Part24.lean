  have hΦ : Limits.cokernel.π (wcFreeSheafMap D.Yt.left j) ≫ Φ =
      wcFreeSheafMap D.Yt.left φh ≫ Limits.cokernel.π (wcFreeSheafMap D.Yt.left j) :=
