    let c' : DerivedCategory.Plus.ι.obj Z ⟶ DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) := c
    haveI : IsIso c' := hcI
    let cI : DerivedCategory.Plus.ι.obj Z ≅ DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) :=
