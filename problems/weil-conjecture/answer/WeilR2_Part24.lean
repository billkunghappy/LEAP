    exact Finite.of_subsingleton
  ·
    have hℓk : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
    obtain ⟨Φ, hΦb, -, -⟩ := wc_proet_free_zmod_ext_mod_model (ℓ ^ k) j hℓk
    suffices hF : Finite (wcZModProEtExt Fm.left (ℓ ^ k) j) from
      Finite.of_surjective (Φ D.Yt.left Fm) (hΦb D.Yt.left Fm).2

    have hx₂ : Limits.pullback.snd V₀.hom D.f xb = D.xs i (IsLocalRing.closedPoint F'') := hxb
    have hx₁ : Limits.pullback.fst V₀.hom D.f xb = e.inv (IsLocalRing.closedPoint A) := by
      have hv' : V₀.hom (Limits.pullback.fst V₀.hom D.f xb) =
          D.S i (IsLocalRing.closedPoint F'') :=
        calc V₀.hom (Limits.pullback.fst V₀.hom D.f xb)
            = (Limits.pullback.fst V₀.hom D.f ≫ V₀.hom) xb := (Scheme.Hom.comp_apply _ _ _).symm
          _ = (Limits.pullback.snd V₀.hom D.f ≫ D.f) xb := by
            first
              | rw [Limits.pullback.condition]
              | exact congrArg (fun φ : Limits.pullback V₀.hom D.f ⟶ (wcP1Over F'').left => φ xb)
                  Limits.pullback.condition
          _ = D.f (Limits.pullback.snd V₀.hom D.f xb) := Scheme.Hom.comp_apply _ _ _
          _ = D.f (D.xs i (IsLocalRing.closedPoint F'')) := congrArg D.f hx₂
          _ = (D.xs i ≫ D.f) (IsLocalRing.closedPoint F'') := (Scheme.Hom.comp_apply _ _ _).symm
          _ = D.S i (IsLocalRing.closedPoint F'') :=
            congrArg (fun φ => φ (IsLocalRing.closedPoint F'')) (D.hxs i)
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := D.S i)
        _ _ hv'
      obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := D.S i)
        _ _ hv
      have hsub : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
        show Subsingleton (PrimeSpectrum (AlgebraicClosure F''))
        infer_instance
      have hzz : z = z' := by
        have h := congrArg ε.inv (Subsingleton.elim (ε.hom z) (ε.hom z'))
        rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at h
      rw [← hz, ← hz', hzz]

    obtain ⟨B', _, _, _, Λ', _, _, W'', φ', a', eB', h1, h2, h3, h4, h5, h6, h7⟩ :=
      wc_et_geom_strict_henselization xb
    have hsh : wcHalShData xb B' Λ' W'' φ' a' := ⟨h1, h2, h3, h4, h5, eB', h6, h7⟩
    have hfinFib := wc_pmn_milnor_fib_zmod_finite F' F'' Y n hn hn2 D ℓ hℓ i V₀ A e hv Ω a₀ L
      eΩ hΩ xb hx₁ hx₂ B' Λ' W'' φ' a' hsh k j hk

    haveI hWE : WeaklyEtale g.left := by
      have hw1 : WeaklyEtale ((wcProEtPullback D.f).obj V₀).hom :=
        ((wcProEtPullback D.f).obj V₀).prop
      have hw2 : WeaklyEtale (g.left ≫ ((wcProEtPullback D.f).obj V₀).hom) := by
        rw [MorphismProperty.Over.w g]; exact Th.prop
      exact @WeaklyEtale.of_comp _ _ _ g.left _ hw2 hw1
    haveI hcE : WeaklyEtale (eB.inv ≫ g.left) := inferInstance
    have hc0 : (eB.inv ≫ g.left) (IsLocalRing.closedPoint B) = xb := by
      have hmem : eB.inv (IsLocalRing.closedPoint B) ∈ g.left ⁻¹' {xb} := by
