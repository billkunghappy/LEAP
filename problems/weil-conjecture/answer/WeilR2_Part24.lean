    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun q _ => by ring)
  have F00 : ∀ i : Fin (e + 2 + 1 + 1), i.val = 0 → c i i = 0 := by
    intro i h
    rw [hc]
    simp only [hcol0 i h]
    rw [← hv]
    exact Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => by ring))
  have Fll : ∀ i : Fin (e + 2 + 1 + 1), i.val = e + 3 → c i i = 0 := by
    intro i h
    rw [hc]
    simp only [hcoll i h]
    rw [← hw]
    exact Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => by ring))
  have F0l : ∀ i j : Fin (e + 2 + 1 + 1), i.val = 0 → j.val = e + 3 → c i j + c j i = 1 := by
    intro i j h1 h2
    rw [hcs]
    simp only [hcol0 i h1, hcoll j h2]
    exact hvw
  have F0m : ∀ i j : Fin (e + 2 + 1 + 1), i.val = 0 → (1 ≤ j.val ∧ j.val ≤ e + 2) →
