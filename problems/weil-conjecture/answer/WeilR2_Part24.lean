  have hinj : ∀ I, Injective I → Injective ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcEtBaseChange e.hom) _ _ De.cont De.φ).obj I) :=
    fun I hI => De.adj.map_injective I hI
  let ρ : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange e.hom) _ _ De.cont De.φ) ⋙
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g') _ _ Dg'.cont Dg'.φ) ≅
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ Dg.cont Dg.φ) :=
    ((Dg.adj.ofNatIsoLeft θ).rightAdjointUniq (Dg'.adj.comp De.adj)).symm
  let μ : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange e.hom) _ _ De.cont
