    intro x
    obtain ⟨μ, hz, hSES⟩ := hses k
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSES x (ih _)
    rw [← hx₁, H x₁, Abelian.Ext.zero_comp]

theorem wc_open_slice_geomPoint_iso (K : Type u) [Field K] [Finite K]
    (X : Over (Spec (.of K)))
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (W O : X.left.Opens) (hOW : O ≤ W)
    (hW : WeaklyEtale (Limits.pullback.fst (Over.mk (W.ι ≫ X.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (jOW : wcOpenRestr X.left O (wcGeomPoint K X hX) ⟶ wcOpenRestr X.left W (wcGeomPoint K X hX))
    (hjOW : jOW ≫ wcOpenRestrIncl X.left W (wcGeomPoint K X hX) =
      wcOpenRestrIncl X.left O (wcGeomPoint K X hX))
    (ΦW : wcOpenRestr X.left W (wcGeomPoint K X hX) ⟶ wcOpenRestr X.left W (wcGeomPoint K X hX))
    (hΦW : ΦW ≫ wcOpenRestrIncl X.left W (wcGeomPoint K X hX) =
      wcOpenRestrIncl X.left W (wcGeomPoint K X hX) ≫ wcGeomFrob K X hX) :
    ∃ (β₁ : (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).obj
          (wcOpenRestr (Over.mk (W.ι ≫ X.hom)).left (W.ι ⁻¹ᵁ O)
            (wcGeomPoint K (Over.mk (W.ι ≫ X.hom)) hW)) ≅
          wcOpenRestr X.left O (wcGeomPoint K X hX))
      (β₂ : (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).obj
          (wcGeomPoint K (Over.mk (W.ι ≫ X.hom)) hW) ≅
          wcOpenRestr X.left W (wcGeomPoint K X hX)),
      β₁.hom ≫ jOW = (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).map
          (wcOpenRestrIncl (Over.mk (W.ι ≫ X.hom)).left (W.ι ⁻¹ᵁ O)
            (wcGeomPoint K (Over.mk (W.ι ≫ X.hom)) hW)) ≫ β₂.hom ∧
      β₂.hom ≫ ΦW = (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).map
          (wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW) ≫ β₂.hom :=
by
  classical

  have G1 : ∀ {Y T S V : Scheme.{u}} (f : Y ⟶ S) (g : T ⟶ S) (f' : V ⟶ Y),
      ((Limits.pullbackRightPullbackFstIso f g f').inv ≫
          Limits.pullback.snd f' (Limits.pullback.fst f g)) ≫ Limits.pullback.fst f g =
        Limits.pullback.fst (f' ≫ f) g ≫ f' := by
    intro Y T S V f g f'
    simp only [Category.assoc]
    rw [← Limits.pullback.condition]
    exact Limits.pullbackRightPullbackFstIso_inv_fst_assoc _ _ _ _

  have G3 : ∀ {Y T S V : Scheme.{u}} (f : Y ⟶ S) (g : T ⟶ S) (f' : V ⟶ Y) (τ : T ⟶ T)
      (φ' : Limits.pullback (f' ≫ f) g ⟶ Limits.pullback (f' ≫ f) g)
      (φ : Limits.pullback f g ⟶ Limits.pullback f g),
      φ' ≫ Limits.pullback.fst (f' ≫ f) g = Limits.pullback.fst (f' ≫ f) g →
      φ' ≫ Limits.pullback.snd (f' ≫ f) g = Limits.pullback.snd (f' ≫ f) g ≫ τ →
      φ ≫ Limits.pullback.fst f g = Limits.pullback.fst f g →
      φ ≫ Limits.pullback.snd f g = Limits.pullback.snd f g ≫ τ →
      φ' ≫ ((Limits.pullbackRightPullbackFstIso f g f').inv ≫
          Limits.pullback.snd f' (Limits.pullback.fst f g)) =
        ((Limits.pullbackRightPullbackFstIso f g f').inv ≫
          Limits.pullback.snd f' (Limits.pullback.fst f g)) ≫ φ := by
    intro Y T S V f g f' τ φ' φ h1' h2' h1 h2
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [h1, ← Limits.pullback.condition, Limits.pullbackRightPullbackFstIso_inv_fst_assoc,
        ← Category.assoc, h1']
    · simp only [Category.assoc]
      rw [h2, Limits.pullbackRightPullbackFstIso_inv_snd_snd_assoc,
        Limits.pullbackRightPullbackFstIso_inv_snd_snd]
      exact h2'

  have G4 : ∀ {Y T S : Scheme.{u}} (f : Y ⟶ S) (g : T ⟶ S) (W O : Y.Opens), O ≤ W →
      Set.range ⇑(Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ f) g) ≫
        (Limits.pullbackRightPullbackFstIso f g W.ι).inv ≫
          Limits.pullback.snd W.ι (Limits.pullback.fst f g)) =
      Set.range ⇑(Limits.pullback.snd O.ι (Limits.pullback.fst f g)) := by
    intro Y T S f g W O hOW
    have hpt : ∀ z, (Limits.pullback.fst f g)
        (((Limits.pullbackRightPullbackFstIso f g W.ι).inv ≫
          Limits.pullback.snd W.ι (Limits.pullback.fst f g)) z) =
        W.ι ((Limits.pullback.fst (W.ι ≫ f) g) z) := by
      intro z
      rw [← Scheme.Hom.comp_apply, G1 f g W.ι, Scheme.Hom.comp_apply]
    have hxz : ∀ z₀, ((Limits.pullbackRightPullbackFstIso f g W.ι).inv ≫
          Limits.pullback.snd W.ι (Limits.pullback.fst f g))
          ((Limits.pullbackRightPullbackFstIso f g W.ι).hom z₀) =
        Limits.pullback.snd W.ι (Limits.pullback.fst f g) z₀ := by
      intro z₀
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id_assoc]
    rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      have hx : (Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ f) g)) x ∈
          Set.range (Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ f) g)) :=
        ⟨x, rfl⟩
      rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι, Set.mem_preimage, SetLike.mem_coe,
        Scheme.Hom.mem_preimage] at hx
      rw [Set.mem_preimage, SetLike.mem_coe, Scheme.Hom.comp_apply, hpt]
      exact hx
    · intro hy
      rw [Set.mem_preimage, SetLike.mem_coe] at hy
      have hyW : y ∈ Set.range (Limits.pullback.snd W.ι (Limits.pullback.fst f g)) := by
        rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι, Set.mem_preimage, SetLike.mem_coe]
        exact hOW hy
      obtain ⟨z₀, rfl⟩ := hyW
      have hxO : (Limits.pullbackRightPullbackFstIso f g W.ι).hom z₀ ∈
          Set.range (Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ f) g)) := by
        rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι, Set.mem_preimage, SetLike.mem_coe,
          Scheme.Hom.mem_preimage, ← hpt, hxz]
        exact hy
      obtain ⟨w, hw⟩ := hxO
      refine ⟨w, ?_⟩
      rw [Scheme.Hom.comp_apply, hw, hxz]

  let s := Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
  letI : Fintype K := Fintype.ofFinite K
  let τ : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of (AlgebraicClosure K)) :=
    Spec.map (CommRingCat.ofHom
      ((FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)).symm :
        AlgebraicClosure K →+* AlgebraicClosure K))
  have ha : (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv ≫
      Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) ≫ Limits.pullback.fst X.hom s =
      Limits.pullback.fst (W.ι ≫ X.hom) s ≫ W.ι := by
    rw [← Category.assoc]
    exact G1 _ _ _
  have hR := G4 X.hom s W O hOW
  let iso₁ := IsOpenImmersion.isoOfRangeEq
    (Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ X.hom) s) ≫
        (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv ≫
          Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s))
    (Limits.pullback.snd O.ι (Limits.pullback.fst X.hom s)) hR
  have hfac : iso₁.hom ≫ Limits.pullback.snd O.ι (Limits.pullback.fst X.hom s) =
      Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ X.hom) s) ≫
        (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv ≫
          Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) :=
    IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hR
  let β₂ : (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).obj
          (wcGeomPoint K (Over.mk (W.ι ≫ X.hom)) hW) ≅
          wcOpenRestr X.left W (wcGeomPoint K X hX) :=
    MorphismProperty.Over.isoMk (Limits.pullbackRightPullbackFstIso X.hom s W.ι).symm (by
      show (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv ≫
          (Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) ≫ Limits.pullback.fst X.hom s) =
        Limits.pullback.fst (W.ι ≫ X.hom) s ≫ W.ι
      exact ha)
  let β₁ : (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).obj
          (wcOpenRestr (Over.mk (W.ι ≫ X.hom)).left (W.ι ⁻¹ᵁ O)
            (wcGeomPoint K (Over.mk (W.ι ≫ X.hom)) hW)) ≅
          wcOpenRestr X.left O (wcGeomPoint K X hX) :=
    MorphismProperty.Over.isoMk iso₁ (by
      show iso₁.hom ≫ (Limits.pullback.snd O.ι (Limits.pullback.fst X.hom s) ≫
          Limits.pullback.fst X.hom s) =
        (Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ X.hom) s) ≫
          Limits.pullback.fst (W.ι ≫ X.hom) s) ≫ W.ι
      rw [← Category.assoc, hfac]
      simp only [Category.assoc]
      rw [ha])
  have hj : jOW.left ≫ Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) =
      Limits.pullback.snd O.ι (Limits.pullback.fst X.hom s) := by
    have := congrArg (fun t : wcOpenRestr X.left O (wcGeomPoint K X hX) ⟶ wcGeomPoint K X hX =>
      t.left) hjOW
    exact this
  have hΦ : ΦW.left ≫ Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) =
      Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) ≫ (wcGeomFrob K X hX).left := by
    have := congrArg (fun t : wcOpenRestr X.left W (wcGeomPoint K X hX) ⟶ wcGeomPoint K X hX =>
      t.left) hΦW
    exact this
  have hF1 : (wcGeomFrob K X hX).left ≫ Limits.pullback.fst X.hom s =
      Limits.pullback.fst X.hom s :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hF2 : (wcGeomFrob K X hX).left ≫ Limits.pullback.snd X.hom s =
      Limits.pullback.snd X.hom s ≫ τ :=
    Limits.pullback.lift_snd _ _ _
  have hF1' : (wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW).left ≫
      Limits.pullback.fst (W.ι ≫ X.hom) s = Limits.pullback.fst (W.ι ≫ X.hom) s :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hF2' : (wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW).left ≫
      Limits.pullback.snd (W.ι ≫ X.hom) s = Limits.pullback.snd (W.ι ≫ X.hom) s ≫ τ :=
    Limits.pullback.lift_snd _ _ _
  have hFr := G3 X.hom s W.ι τ (wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW).left
    (wcGeomFrob K X hX).left hF1' hF2' hF1 hF2
  have hA : β₁.hom ≫ jOW = (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).map
      (wcOpenRestrIncl (Over.mk (W.ι ≫ X.hom)).left (W.ι ⁻¹ᵁ O)
        (wcGeomPoint K (Over.mk (W.ι ≫ X.hom)) hW)) ≫ β₂.hom := by
    apply MorphismProperty.Over.Hom.ext
    show iso₁.hom ≫ jOW.left =
      Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ X.hom) s) ≫
        (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv
    have key : (iso₁.hom ≫ jOW.left) ≫ Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) =
        (Limits.pullback.snd (W.ι ⁻¹ᵁ O).ι (Limits.pullback.fst (W.ι ≫ X.hom) s) ≫
          (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv) ≫
          Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) :=
      (Category.assoc _ _ _).trans ((congrArg (fun t => iso₁.hom ≫ t) hj).trans
        (hfac.trans (Category.assoc _ _ _).symm))
    exact Mono.right_cancellation (f := Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s))
      _ _ key
  have hB : β₂.hom ≫ ΦW = (wcSliceFunctor X.left (Scheme.ProEt.mk W.ι)).map
      (wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW) ≫ β₂.hom := by
    apply MorphismProperty.Over.Hom.ext
    show (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv ≫ ΦW.left =
      (wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW).left ≫
        (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv
    have key : ((Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv ≫ ΦW.left) ≫
        Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) =
        ((wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW).left ≫
          (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv) ≫
          Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s) :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun t => (Limits.pullbackRightPullbackFstIso X.hom s W.ι).inv ≫ t) hΦ).trans
          ((Category.assoc _ _ _).symm.trans (hFr.symm.trans (Category.assoc _ _ _).symm)))
    exact Mono.right_cancellation (f := Limits.pullback.snd W.ι (Limits.pullback.fst X.hom s))
      _ _ key
  exact ⟨β₁, β₂, hA, hB⟩

theorem wc_proet_open_slice_coker_ext_transport (S : Scheme.{u}) (W : S.Opens)
    {V₁ V₂ : (W : Scheme.{u}).ProEt} (ι' : V₁ ⟶ V₂) (a' : V₂ ⟶ V₂)
    {U₁ U₂ : S.ProEt} (ι : U₁ ⟶ U₂) (a : U₂ ⟶ U₂)
    (β₁ : (wcSliceFunctor S (Scheme.ProEt.mk W.ι)).obj V₁ ≅ U₁)
    (β₂ : (wcSliceFunctor S (Scheme.ProEt.mk W.ι)).obj V₂ ≅ U₂)
    (h₁ : β₁.hom ≫ ι = (wcSliceFunctor S (Scheme.ProEt.mk W.ι)).map ι' ≫ β₂.hom)
    (h₂ : β₂.hom ≫ a = (wcSliceFunctor S (Scheme.ProEt.mk W.ι)).map a' ≫ β₂.hom)
    (Ψ : Limits.cokernel (wcFreeSheafMap S ι) ⟶ Limits.cokernel (wcFreeSheafMap S ι))
    (hΨ : Limits.cokernel.π (wcFreeSheafMap S ι) ≫ Ψ =
      wcFreeSheafMap S a ≫ Limits.cokernel.π (wcFreeSheafMap S ι))
    (Ψ' : Limits.cokernel (wcFreeSheafMap (W : Scheme.{u}) ι') ⟶
      Limits.cokernel (wcFreeSheafMap (W : Scheme.{u}) ι'))
    (hΨ' : Limits.cokernel.π (wcFreeSheafMap (W : Scheme.{u}) ι') ≫ Ψ' =
      wcFreeSheafMap (W : Scheme.{u}) a' ≫ Limits.cokernel.π (wcFreeSheafMap (W : Scheme.{u}) ι'))
    (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] (i : ℕ) :
    ∃ T : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcContSheaf S A) i →+
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap (W : Scheme.{u}) ι'))
          (wcContSheaf (W : Scheme.{u}) A) i,
      Function.Bijective T ∧
      ∀ z, T ((Abelian.Ext.mk₀ Ψ).comp z (zero_add i)) =
        (Abelian.Ext.mk₀ Ψ').comp (T z) (zero_add i) :=
by
  classical
  suffices key : ∀ (U : S.ProEt) {V₁ V₂ : U.left.ProEt} (ι' : V₁ ⟶ V₂) (a' : V₂ ⟶ V₂)
      (β₁ : (wcSliceFunctor S U).obj V₁ ≅ U₁) (β₂ : (wcSliceFunctor S U).obj V₂ ≅ U₂)
      (h₁ : β₁.hom ≫ ι = (wcSliceFunctor S U).map ι' ≫ β₂.hom)
      (h₂ : β₂.hom ≫ a = (wcSliceFunctor S U).map a' ≫ β₂.hom)
      (Ψ' : Limits.cokernel (wcFreeSheafMap U.left ι') ⟶
        Limits.cokernel (wcFreeSheafMap U.left ι'))
      (hΨ' : Limits.cokernel.π (wcFreeSheafMap U.left ι') ≫ Ψ' =
        wcFreeSheafMap U.left a' ≫ Limits.cokernel.π (wcFreeSheafMap U.left ι')),
      ∃ T : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcContSheaf S A) i →+
          Abelian.Ext (Limits.cokernel (wcFreeSheafMap U.left ι')) (wcContSheaf U.left A) i,
        Function.Bijective T ∧
        ∀ z, T ((Abelian.Ext.mk₀ Ψ).comp z (zero_add i)) =
          (Abelian.Ext.mk₀ Ψ').comp (T z) (zero_add i) by
    exact key (Scheme.ProEt.mk W.ι) ι' a' β₁ β₂ h₁ h₂ Ψ' hΨ'
  intro U V₁ V₂ ι' a' β₁ β₂ h₁ h₂ Ψ' hΨ'

  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e
  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
