    intro P
    by_cases hP : 1 ≤ P.val ∧ P.val ≤ e + 2
    · rw [dif_pos hP]
      have h2 : π.appLE (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) O hOU
          ((jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨P.val - 1, by omega⟩)) =
          (π ≫ jE₁).appLE (wcSgD K (e + 1) c) O hOV
            (wcSgE K (e + 1) c ⟨P.val - 1, by omega⟩) := by
        rw [Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
      rw [h2]
      have h3 := hπrel c c ⟨P.val - 1, by omega⟩ O hOV hOW
      rw [hu1, map_one, mul_one] at h3
      rw [h3]
      have hk : (⟨(⟨P.val - 1, by omega⟩ : Fin (e + 1 + 1)).val + 1, by omega⟩ :
          Fin (e + 2 + 1 + 1)) = P := Fin.ext (by simp only []; omega)
      rw [hk]
      unfold wcScqCcV
      rw [if_pos hP]
    · rw [dif_neg hP, map_zero]
      unfold wcScqCcV
      rw [if_neg hP, map_zero]
  revert hO
  rw [Category.assoc]
  intro hO
  have hO₀ : O ≤ π ⁻¹ᵁ (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓
      (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J) := by
    intro x hx
    exact ⟨hOU hx, hO hx⟩
  have e1 : ∀ x, π.appLE _ O hO₀ ((σ ≫ iD ≫ Op.ι ≫ jE).appLE (wcSgD K (e + 2 + 1) J) _
      (inf_le_right : jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓
        (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J ≤ _) x) =
      (π ≫ σ ≫ iD ≫ Op.ι ≫ jE).appLE (wcSgD K (e + 2 + 1) J) O hO x := by
    intro x
    rw [← Scheme.Hom.appLE_comp_appLE π (σ ≫ iD ≫ Op.ι ≫ jE) _ _ O _ hO₀]
    rfl
  have e2 : ∀ x, π.appLE _ O hO₀ (E₁.left.presheaf.map (homOfLE
      (inf_le_left : jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓
        (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J ≤ _)).op x) =
      π.appLE (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) O hOU x := by
    intro x
