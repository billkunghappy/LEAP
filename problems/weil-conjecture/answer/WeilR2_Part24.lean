  have hmemβ : ∀ s : wcOdpB t j g, s ∈ β ↔ ψ s ∈ IsLocalRing.maximalIdeal (Yb.presheaf.stalk y) := by
    intro s; rw [hβ, Ideal.mem_comap]
  have hunit : ∀ s : β.primeCompl, IsUnit (ψ s) := by
    intro s
    by_contra hn
    exact s.2 ((hmemβ s).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hn))
  obtain ⟨ψβ, hψβ⟩ : ∃ ψβ : C →+* Yb.presheaf.stalk y,
      ψβ = IsLocalization.lift (M := β.primeCompl) (S := C) hunit := ⟨_, rfl⟩
  have hψβc : ψβ.comp (algebraMap (wcOdpB t j g) C) = ψ := by
    rw [hψβ]; exact IsLocalization.lift_comp hunit
  have hψβloc : IsLocalHom ψβ := by
    refine ⟨fun x hx => ?_⟩
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective β.primeCompl x
    have e1 := IsLocalization.mk'_spec C b s
    have e2 : ψβ (IsLocalization.mk' C b s) * ψ s = ψ b := by
      rw [← hψβc, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, e1]
    have hb : IsUnit (ψ b) := by rw [← e2]; exact hx.mul (hunit s)
    have hbβ : b ∈ β.primeCompl := fun hbm =>
      (IsLocalRing.mem_maximalIdeal _).mp ((hmemβ b).mp hbm) hb
    have hu : IsUnit (algebraMap (wcOdpB t j g) C b) := IsLocalization.map_units C ⟨b, hbβ⟩
    rw [← e1] at hu
    exact isUnit_of_mul_isUnit_left hu

  obtain ⟨ρC, hρC⟩ : ∃ ρC : R →+* C, ρC = (algebraMap (wcOdpB t j g) C).comp
      (algebraMap R (wcOdpB t j g)) := ⟨_, rfl⟩
  have hρCh : ρC h = 0 := by rw [hρC, RingHom.comp_apply, hBh, map_zero]
  have hτnzd : algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j)) ∈
      nonZeroDivisors C := (wc_odp_chart_nzd R n t M j g hdim hmax hdet hG2).2 β C
  have hdivC : ∀ b, ρC (t b) ∈ Ideal.span {ρC (t j)} := by
    intro b
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hBdiv b)
    refine Ideal.mem_span_singleton'.mpr ⟨algebraMap (wcOdpB t j g) C c, ?_⟩
    rw [hρC, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, hc]
  have hker : ∀ a ∈ Ideal.span {h}, ρC a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hρCh, mul_zero]
  obtain ⟨κ, hκ⟩ : ∃ κ : P.presheaf.stalk (r y) →+* C,
      κ = (Ideal.Quotient.lift (Ideal.span {h}) ρC hker).comp σ.toRingHom := ⟨_, rfl⟩
  have hκπ : ∀ x, κ (π x) = ρC x := by
    intro x
    rw [hκ, hπ, RingHom.comp_apply, RingHom.comp_apply]
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.apply_symm_apply,
      Ideal.Quotient.lift_mk]
  have hτdef : ρC (t j) = algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j)) := by
    rw [hρC]; rfl
  have hκm : Ideal.map κ (IsLocalRing.maximalIdeal (P.presheaf.stalk (r y))) =
      Ideal.span {algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j))} := by
    rw [hmOt, Ideal.map_span, ← Set.range_comp]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨b, rfl⟩
      show κ (π (t b)) ∈ _
      rw [hκπ]
      have := hdivC b
      rw [hτdef] at this
      exact this
    · rw [Ideal.span_singleton_le_iff_mem]
      apply Ideal.subset_span
      refine ⟨j, ?_⟩
      show κ (π (t j)) = _
      rw [hκπ, hτdef]
  haveI : IsLocalRing C := IsLocalization.AtPrime.isLocalRing C β
  haveI hLc : IsLocalRing (CommRingCat.of C) := inferInstanceAs (IsLocalRing C)
  obtain ⟨κc, hκc⟩ : ∃ κc : P.presheaf.stalk (r y) ⟶ CommRingCat.of C,
      κc.hom = κ := ⟨CommRingCat.ofHom (R := P.presheaf.stalk (r y)) (S := C) κ, rfl⟩
  have hIP1 : wcCsdInvPull I (Spec.map κc ≫ P.fromSpecStalk (r y)) := by
    refine hL8 P I (r y) ⟨U₀, hU₀⟩ hyU₀ (CommRingCat.of C)
      κc _ hτnzd ?_
    rw [hκc, hL4, hκm]
  obtain ⟨γ, hγ, -⟩ := hbl.2 _ _ hIP1

  have hIP2 : wcCsdInvPull I (Spec.map (r.stalkMap y) ≫ P.fromSpecStalk (r y)) := by
    refine hL8 P I (r y) ⟨U₀, hU₀⟩ hyU₀ (Yb.presheaf.stalk y)
      (r.stalkMap y) (ρ₀ (t j)) hsnzd ?_
    rw [hL4, hB0, hspanj]
  rw [Scheme.SpecMap_stalkMap_fromSpecStalk] at hIP2
  obtain ⟨μ, hμ⟩ : ∃ μ : CommRingCat.of C ⟶ Yb.presheaf.stalk y, μ.hom = ψβ :=
    ⟨CommRingCat.ofHom (R := C) (S := Yb.presheaf.stalk y) ψβ, rfl⟩
  have hκμ : κc ≫ μ = r.stalkMap y := by
    ext x
    obtain ⟨a, rfl⟩ := hπs x
    rw [CommRingCat.comp_apply]
    show μ.hom (κc.hom (π a)) = (r.stalkMap y).hom (π a)
    rw [hμ, hκc, hκπ, hρC, RingHom.comp_apply, ← RingHom.comp_apply ψβ, hψβc,
      ← RingHom.comp_apply ψ, hψ, hρ₀, RingHom.comp_apply]
  have hcomp : (Spec.map μ ≫ γ) ≫ r = Yb.fromSpecStalk y ≫ r := by
    rw [Category.assoc, hγ, ← Category.assoc, ← Spec.map_comp, hκμ,
      Scheme.SpecMap_stalkMap_fromSpecStalk]
  have hstar2 : Spec.map μ ≫ γ = Yb.fromSpecStalk y := (hbl.2 _ _ hIP2).unique hcomp rfl

  have hμloc : IsLocalHom μ.hom := by rw [hμ]; exact hψβloc
  obtain ⟨θ, hθμ, hθr⟩ := hL9 P Yb r y (CommRingCat.of C) γ μ
    κc hμloc hstar2 hγ

  obtain ⟨-, -, hCuniq⟩ := hL2 R n t h j g hG1
  have hθψ : θ.hom.comp ψ = algebraMap (wcOdpB t j g) C := by
    refine (hCuniq C ρC hρCh (by rw [hρC]; exact hτnzd) hdivC).unique ?_ ?_
    · ext x
      have e1 := congrArg (fun f => f.hom (π x)) hθr
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1
      rw [hκc] at e1
      rw [RingHom.comp_apply, RingHom.comp_apply,
        ← RingHom.comp_apply ψ (algebraMap R (wcOdpB t j g)), hψ, hρ₀,
        RingHom.comp_apply, e1, hκπ]
    · exact hρC.symm
  have hθψβ : θ.hom.comp ψβ = RingHom.id C := by
    apply IsLocalization.ringHom_ext β.primeCompl
    rw [RingHom.comp_assoc, hψβc, hθψ, RingHom.id_comp]
  have hψβθ : ψβ.comp θ.hom = RingHom.id (Yb.presheaf.stalk y) := by
    have := congrArg CommRingCat.Hom.hom hθμ
    rw [CommRingCat.hom_comp, CommRingCat.hom_id, hμ] at this
    exact this

  refine ⟨j, g, β, hβmax, hG1, hG2, hτβ, C, inferInstance, inferInstance, inferInstance,
    RingEquiv.ofRingHom θ.hom ψβ hθψβ hψβθ, ?_⟩
  intro W hyW
  rw [hstar W hyW, Ideal.map_span, Set.image_singleton, RingEquiv.coe_ringHom_ofRingHom,
    ← hψ, RingHom.comp_apply, ← RingHom.comp_apply θ.hom ψ, hθψ]

theorem wc_bm_chart_fibre_regular : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [Finite (IsLocalRing.ResidueField R)] (n : ℕ) (t : Fin n → R)
    (M : Matrix (Fin n) (Fin n) R) (j : Fin n) (g : MvPolynomial (Fin n) R),
    2 ≤ n → ringKrullDim R = n → IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
    IsUnit (M + M.transpose).det →
    g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
      wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} →
    ∀ (β : Ideal (wcOdpB t j g)) [β.IsMaximal], algebraMap R (wcOdpB t j g) (t j) ∈ β →
    ∀ (C : Type u) [CommRing C] [Algebra (wcOdpB t j g) C] [IsLocalization.AtPrime C β],
    IsRegularLocalRing (C ⧸ Ideal.span {algebraMap (wcOdpB t j g) C
      (algebraMap R (wcOdpB t j g) (t j))}) ∧
    ringKrullDim (C ⧸ Ideal.span {algebraMap (wcOdpB t j g) C
      (algebraMap R (wcOdpB t j g) (t j))}) =
      ((n - 1 - 1 : ℕ) : WithBot ℕ∞) :=
by
  classical

  have s1 : ∀ (B D : Type u) [CommRing B] [CommRing D] (f : B →+* D), Function.Surjective f →
      ∀ (β : Ideal B) [β.IsPrime] (p : Ideal D) [p.IsPrime], Ideal.comap f p = β →
      ∀ (C : Type u) [CommRing C] [Algebra B C] [IsLocalization.AtPrime C β]
        (E : Type u) [CommRing E] [Algebra D E] [IsLocalization.AtPrime E p],
      Nonempty (C ⧸ Ideal.map (algebraMap B C) (RingHom.ker f) ≃+* E) := by
    intro B D _ _ f hf β _ p _ hp C _ _ _ E _ _ _
    set I := Ideal.map (algebraMap B C) (RingHom.ker f) with hI
    have hmem : ∀ b : B, b ∈ β.primeCompl ↔ f b ∈ p.primeCompl := by
      intro b
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, ← hp, Ideal.mem_comap]
    let g₁ : B →+* E := (algebraMap D E).comp f
    have hg₁ : ∀ y : β.primeCompl, IsUnit (g₁ y) := fun y =>
      IsLocalization.map_units E (⟨f y, (hmem y).1 y.2⟩ : p.primeCompl)
    let l₁ : C →+* E := IsLocalization.lift (M := β.primeCompl) hg₁
    have hl₁ : ∀ b, l₁ (algebraMap B C b) = algebraMap D E (f b) := fun b =>
      IsLocalization.lift_eq hg₁ b
    have hIl : ∀ x ∈ I, l₁ x = 0 := by
      intro x hx
      have hle : I ≤ RingHom.ker l₁ := by
        rw [hI, Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker, hl₁, RingHom.mem_ker.mp hb, map_zero]
      exact hle hx
    let Φ : C ⧸ I →+* E := Ideal.Quotient.lift I l₁ hIl
    have hΦ : ∀ x, Φ (Ideal.Quotient.mk I x) = l₁ x := fun x => Ideal.Quotient.lift_mk I l₁ hIl
    let e₀ : D ≃+* B ⧸ RingHom.ker f := (RingHom.quotientKerEquivOfSurjective hf).symm
    let q : B ⧸ RingHom.ker f →+* C ⧸ I :=
      Ideal.quotientMap I (algebraMap B C) Ideal.le_comap_map
    let h₀ : D →+* C ⧸ I := q.comp e₀.toRingHom
    have hh₀ : ∀ b, h₀ (f b) = Ideal.Quotient.mk I (algebraMap B C b) := by
      intro b
      have he : e₀ (f b) = Ideal.Quotient.mk _ b := by
        apply (RingHom.quotientKerEquivOfSurjective hf).injective
        rw [RingHom.quotientKerEquivOfSurjective_apply_mk]
        exact RingEquiv.apply_symm_apply _ _
      show q (e₀ (f b)) = _
      rw [he]
      exact Ideal.quotientMap_mk
    have hh₀u : ∀ y : p.primeCompl, IsUnit (h₀ y) := by
      rintro ⟨y, hy⟩
      obtain ⟨b, rfl⟩ := hf y
      show IsUnit (h₀ (f b))
      rw [hh₀]
      exact (IsLocalization.map_units C (⟨b, (hmem b).2 hy⟩ : β.primeCompl)).map _
    let Ψ : E →+* C ⧸ I := IsLocalization.lift (M := p.primeCompl) hh₀u
    have hΨ : ∀ d, Ψ (algebraMap D E d) = h₀ d := fun d => IsLocalization.lift_eq hh₀u d
    refine ⟨RingEquiv.ofRingHom Φ Ψ ?_ ?_⟩
    · apply IsLocalization.ringHom_ext p.primeCompl
      refine RingHom.ext fun d => ?_
      obtain ⟨b, rfl⟩ := hf d
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΨ, hh₀, hΦ, hl₁]
    · apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext β.primeCompl
      refine RingHom.ext fun b => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦ, hl₁, hΨ, hh₀]

  have s2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (n : ℕ) (t : Fin n → R)
      (M : Matrix (Fin n) (Fin n) R) (j : Fin n) (g : MvPolynomial (Fin n) R),
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
      g - ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c ∈
        wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} →
      ∃ f : wcOdpB t j g →+* (MvPolynomial (Fin n) (IsLocalRing.ResidueField R) ⧸
        Ideal.span {MvPolynomial.X j - 1, ∑ a, ∑ c,
          MvPolynomial.C (IsLocalRing.residue R (M a c)) * MvPolynomial.X a * MvPolynomial.X c}),
        Function.Surjective f ∧
          RingHom.ker f = Ideal.span {algebraMap R (wcOdpB t j g) (t j)} := by
    intro R _ _ n t M j g hmax hG2
    set q : MvPolynomial (Fin n) R :=
      ∑ a, ∑ c, MvPolynomial.C (M a c) * MvPolynomial.X a * MvPolynomial.X c with hqdef
    set Qb : MvPolynomial (Fin n) (IsLocalRing.ResidueField R) :=
      ∑ a, ∑ c, MvPolynomial.C (IsLocalRing.residue R (M a c)) * MvPolynomial.X a *
        MvPolynomial.X c with hQbdef
    set Kb : Ideal (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) :=
      Ideal.span {MvPolynomial.X j - 1, Qb} with hKb
    set φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) (IsLocalRing.ResidueField R) :=
      MvPolynomial.map (IsLocalRing.residue R) with hφ
    set θ := (Ideal.Quotient.mk Kb).comp φ with hθ
    set J := wcOdpJ0 t j ⊔ Ideal.span {g} with hJ
    have hφs : Function.Surjective φ :=
      MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
    have hθs : Function.Surjective θ := Ideal.Quotient.mk_surjective.comp hφs
    have hφX : φ (MvPolynomial.X j - 1) = MvPolynomial.X j - 1 := by
      rw [map_sub, map_one, hφ, MvPolynomial.map_X]
    have hφq : φ q = Qb := by
      simp only [hqdef, hQbdef, hφ, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]
    set P := Ideal.span {MvPolynomial.X j - 1, q} ⊔
      Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R) with hP
    have hkerθ : RingHom.ker θ = P := by
      rw [hθ, ← RingHom.comap_ker, Ideal.mk_ker]
      have hK : Kb = Ideal.map φ (Ideal.span {MvPolynomial.X j - 1, q}) := by
        rw [Ideal.map_span, Set.image_pair, hφX, hφq]
      rw [hK, Ideal.comap_map_of_surjective φ hφs, ← RingHom.ker_eq_comap_bot, hφ,
        MvPolynomial.ker_map, IsLocalRing.ker_residue]
    have hJ0P : wcOdpJ0 t j ≤ P := by
      rw [wcOdpJ0, Ideal.span_le]
      have hCt : ∀ b, MvPolynomial.C (t b) ∈ P := fun b =>
        Ideal.mem_sup_right (Ideal.mem_map_of_mem _
          (by rw [hmax]; exact Ideal.subset_span ⟨b, rfl⟩))
      rintro x (rfl | ⟨b, rfl⟩)
      · exact Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      · exact P.sub_mem (P.mul_mem_right _ (hCt j)) (hCt b)
    have hCtjP : MvPolynomial.C (t j) ∈ P :=
      Ideal.mem_sup_right (Ideal.mem_map_of_mem _
        (by rw [hmax]; exact Ideal.subset_span ⟨j, rfl⟩))
    have hqP : q ∈ P := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have hG2P : g - q ∈ P := by
      have : wcOdpJ0 t j ⊔ Ideal.span {MvPolynomial.C (t j)} ≤ P :=
        sup_le hJ0P (by rw [Ideal.span_singleton_le_iff_mem]; exact hCtjP)
      exact this hG2
    have hPeq : P = J ⊔ Ideal.span {MvPolynomial.C (t j)} := by
      apply le_antisymm
      · apply sup_le
        · rw [Ideal.span_le]
          rintro x (rfl | rfl)
          · exact Ideal.mem_sup_left (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _)))
          · have h1 : g ∈ J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
              Ideal.mem_sup_left (Ideal.mem_sup_right (Ideal.mem_span_singleton_self g))
            have h2 : g - q ∈ J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
              (sup_le_sup_right (le_sup_left : wcOdpJ0 t j ≤ J) _) hG2
            have := Ideal.sub_mem _ h1 h2
            rwa [sub_sub_cancel] at this
        · rw [hmax, Ideal.map_span, Ideal.span_le]
          rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
          have h1 : MvPolynomial.C (t j) * MvPolynomial.X b ∈
              J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
            Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
          have h2 : MvPolynomial.C (t j) * MvPolynomial.X b - MvPolynomial.C (t b) ∈
              J ⊔ Ideal.span {MvPolynomial.C (t j)} :=
            Ideal.mem_sup_left (Ideal.mem_sup_left
              (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨b, rfl⟩)))
          have := Ideal.sub_mem _ h1 h2
          rwa [sub_sub_cancel] at this
      · apply sup_le (sup_le hJ0P ?_) (by rw [Ideal.span_singleton_le_iff_mem]; exact hCtjP)
        rw [Ideal.span_singleton_le_iff_mem]
        have := P.add_mem hqP hG2P
        rwa [add_sub_cancel] at this
    have hJθ : ∀ a ∈ J, θ a = 0 := by
      intro a ha
      rw [← RingHom.mem_ker, hkerθ, hPeq]
      exact Ideal.mem_sup_left ha
    refine ⟨Ideal.Quotient.lift J θ hJθ,
      Ideal.Quotient.lift_surjective_of_surjective J hJθ hθs, ?_⟩
    have hk : RingHom.ker (Ideal.Quotient.lift J θ hJθ) =
        Ideal.map (Ideal.Quotient.mk J) (RingHom.ker θ) :=
      Ideal.ker_quotient_lift θ (fun a ha => hJθ a ha)
    rw [hk, hkerθ, hPeq, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq,
      Ideal.map_span, Set.image_singleton]
    rfl

  have s3 : ∀ (k : Type u) [Field k] (n : ℕ) (N : Matrix (Fin n) (Fin n) k) (j : Fin n)
      (v : Fin n → k), (N + N.transpose).det ≠ 0 → v j = 1 → ∑ a, ∑ b, N a b * v a * v b = 0 →
      ∃ c, c ≠ j ∧ ∑ b, (N c b + N b c) * v b ≠ 0 := by
    intro k _ n N j v hdet hvj hq
    by_contra hcon
    push_neg at hcon
    have euler : ∑ c, v c * ∑ b, (N c b + N b c) * v b = 0 := by
      have e : ∑ c, v c * ∑ b, (N c b + N b c) * v b =
          (∑ a, ∑ b, N a b * v a * v b) + ∑ a, ∑ b, N a b * v a * v b := by
        simp only [Finset.mul_sum, add_mul, mul_add, Finset.sum_add_distrib]
        congr 1
        · exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
        · exact Finset.sum_comm.trans
            (Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring)
      rw [e, hq, add_zero]
    have hj : ∑ b, (N j b + N b j) * v b = 0 := by
      rw [Finset.sum_eq_single j (fun c _ hc => by rw [hcon c hc, mul_zero]) (by simp), hvj,
        one_mul] at euler
      exact euler
    have hw : ∀ c, ∑ b, (N c b + N b c) * v b = 0 := by
      intro c
      by_cases hc : c = j
      · rw [hc]; exact hj
      · exact hcon c hc
    apply hdet
    apply Matrix.exists_mulVec_eq_zero_iff.mp
    refine ⟨v, fun h => by have := congrFun h j; rw [hvj] at this; simp at this, ?_⟩
    ext c
    simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.transpose_apply,
      Pi.zero_apply]
    exact hw c

  have s7 : ∀ (k : Type u) [Field k] (N : ℕ) (𝔫 : Ideal (MvPolynomial (Fin N) k)),
      𝔫.IsMaximal → (N : ℕ∞) ≤ 𝔫.height := by
    intro k _ N
    induction N with
    | zero => intro n _; simp
    | succ N ih =>
      intro n hn
      let e : MvPolynomial (Fin (N + 1)) k ≃+* Polynomial (MvPolynomial (Fin N) k) :=
        (MvPolynomial.finSuccEquiv k N).toRingEquiv
      let P : Ideal (Polynomial (MvPolynomial (Fin N) k)) := Ideal.map e n
      haveI hP : P.IsMaximal := Ideal.map_isMaximal_of_equiv e
      have hnP : n.height = P.height := by
        have h1 : Ideal.comap e P = n := Ideal.comap_map_of_bijective e e.bijective
        rw [← RingEquiv.height_comap e P, h1]
      let p : Ideal (MvPolynomial (Fin N) k) := Ideal.comap Polynomial.C P
      haveI hp : p.IsMaximal := Polynomial.isMaximal_comap_C_of_isJacobsonRing P
      haveI : P.LiesOver p := by
        constructor
        rw [Ideal.under_def, Polynomial.algebraMap_eq]
      have hPp : P.height = p.height + 1 := Polynomial.height_eq_height_add_one p P
      rw [hnP, hPp]
      have := ih p hp
      push_cast
      exact add_le_add this le_rfl

  have sA : ∀ (k : Type u) [Field k] [PerfectField k] (N : ℕ)
      (𝔐 : Ideal (MvPolynomial (Fin N) k)) [𝔐.IsMaximal],
      IsRegularLocalRing (Localization.AtPrime 𝔐) ∧
        ringKrullDim (Localization.AtPrime 𝔐) = (N : WithBot ℕ∞) := by
    intro k _ _ N 𝔐 _
    haveI : IsNoetherianRing (Localization.AtPrime 𝔐) :=
      IsLocalization.isNoetherianRing 𝔐.primeCompl _ inferInstance
    obtain ⟨hfs, hfree, hfin, hrk, hfsκ⟩ := wcpa_affine_local_smooth_data k N 𝔐
    have hemb : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐)) ≤ N :=
      (wcpa_embdim_le_rank_omega k (Localization.AtPrime 𝔐) hfs hfree hfin hfsκ).trans_eq hrk
    have hht := s7 k N 𝔐 inferInstance
    have hup := ringKrullDim_le_spanFinrank_maximalIdeal (Localization.AtPrime 𝔐)
    have h1 : (N : WithBot ℕ∞) ≤ ringKrullDim (Localization.AtPrime 𝔐) := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height 𝔐 (Localization.AtPrime 𝔐)]
      exact_mod_cast hht
    have h2 : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐)) : ℕ) :
        WithBot ℕ∞) ≤ N := by
      exact_mod_cast hemb
    exact ⟨IsRegularLocalRing.mk (le_antisymm (h2.trans h1) hup),
      le_antisymm (hup.trans h2) h1⟩

  have sQ : ∀ (L : Type u) [CommRing L] [IsRegularLocalRing L] (N : ℕ) (x y : L),
      ringKrullDim L = (N : WithBot ℕ∞) →
      x ∈ IsLocalRing.maximalIdeal L → y ∈ IsLocalRing.maximalIdeal L →
      (∀ a b : L, a * x + b * y ∈ IsLocalRing.maximalIdeal L ^ 2 →
        a ∈ IsLocalRing.maximalIdeal L ∧ b ∈ IsLocalRing.maximalIdeal L) →
      IsRegularLocalRing (L ⧸ Ideal.span {x, y}) ∧
        ringKrullDim (L ⧸ Ideal.span {x, y}) = ((N - 2 : ℕ) : WithBot ℕ∞) := by
    intro L _ _ N x y hdim hx hy hind
    let z : Fin 2 → IsLocalRing.maximalIdeal L := ![⟨x, hx⟩, ⟨y, hy⟩]
    have hli : LinearIndependent (IsLocalRing.ResidueField L)
        (fun i => (IsLocalRing.maximalIdeal L).toCotangent (z i)) := by
      have hfun : (fun i => (IsLocalRing.maximalIdeal L).toCotangent (z i)) =
          ![(IsLocalRing.maximalIdeal L).toCotangent ⟨x, hx⟩,
            (IsLocalRing.maximalIdeal L).toCotangent ⟨y, hy⟩] := by
        funext i; fin_cases i <;> rfl
      rw [hfun, LinearIndependent.pair_iff]
      intro s t hst
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective s
      obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective t
      rw [← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul, algebraMap_smul] at hst
      have e : a • (IsLocalRing.maximalIdeal L).toCotangent ⟨x, hx⟩ +
          b • (IsLocalRing.maximalIdeal L).toCotangent ⟨y, hy⟩ =
          (IsLocalRing.maximalIdeal L).toCotangent
            (a • (⟨x, hx⟩ : IsLocalRing.maximalIdeal L) + b • ⟨y, hy⟩) := by
        rw [map_add, map_smul, map_smul]
      rw [e, Ideal.toCotangent_eq_zero] at hst
      have hmem : a * x + b * y ∈ IsLocalRing.maximalIdeal L ^ 2 := by
        simpa using hst
      obtain ⟨ha, hb⟩ := hind a b hmem
      exact ⟨(IsLocalRing.residue_eq_zero_iff a).mpr ha, (IsLocalRing.residue_eq_zero_iff b).mpr hb⟩
    obtain ⟨hreg, hd⟩ := wcpa_rs_quotient_regular L 2 z hli
    have hz : (fun i => (z i : L)) = ![x, y] := by
      funext i; fin_cases i <;> rfl
    have hrange : Set.range (fun i => (z i : L)) = {x, y} := by
      rw [hz, Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
        Set.singleton_union]
    rw [hrange] at hreg hd
    rw [hdim] at hd
    refine ⟨hreg, ?_⟩
    haveI := hreg
    have hnb : ringKrullDim (L ⧸ Ideal.span {x, y}) ≠ ⊥ :=
      ne_bot_of_le_ne_bot (by simp) (ringKrullDim_nonneg_of_nontrivial (R := L ⧸ Ideal.span {x, y}))
    obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp hnb
    rw [← he] at hd ⊢
    have hd' : e + 2 = (N : ℕ∞) := by
      have h3 : ((e + 2 : ℕ∞) : WithBot ℕ∞) = ((N : ℕ∞) : WithBot ℕ∞) := by
        first
          | (push_cast; exact hd)
          | exact_mod_cast hd
          | (rw [WithBot.coe_add]; exact hd)
      exact WithBot.coe_injective h3
    clear hd
    induction e using ENat.recTopCoe with
    | top =>
      exfalso
      rw [top_add] at hd'
      exact absurd hd' (by simp)
    | coe m =>
      have h4 : m + 2 = N := by exact_mod_cast hd'
      have h5 : m = N - 2 := by omega
      subst h5
      rfl

  have sB : ∀ (k : Type u) [Field k] (n : ℕ) (N : Matrix (Fin n) (Fin n) k) (j : Fin n)
      (𝔐 : Ideal (MvPolynomial (Fin n) k)) [𝔐.IsMaximal], (N + N.transpose).det ≠ 0 →
      MvPolynomial.X j - 1 ∈ 𝔐 →
      (∑ a, ∑ c, MvPolynomial.C (N a c) * MvPolynomial.X a * MvPolynomial.X c) ∈ 𝔐 →
      ∀ x y : Localization.AtPrime 𝔐,
      x * algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐) (MvPolynomial.X j - 1) +
        y * algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐)
          (∑ a, ∑ c, MvPolynomial.C (N a c) * MvPolynomial.X a * MvPolynomial.X c) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐) ^ 2 →
      x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐) ∧
        y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐) := by
    intro k _ n N j 𝔐 _ hdet hX hQ x y hxy
    set Q : MvPolynomial (Fin n) k :=
      ∑ a, ∑ c, MvPolynomial.C (N a c) * MvPolynomial.X a * MvPolynomial.X c with hQdef
    letI : Field (MvPolynomial (Fin n) k ⧸ 𝔐) := Ideal.Quotient.field 𝔐
    set ev : MvPolynomial (Fin n) k →+* (MvPolynomial (Fin n) k ⧸ 𝔐) :=
      Ideal.Quotient.mk 𝔐 with hev
    have hev0 : ∀ p, ev p = 0 ↔ p ∈ 𝔐 := fun p => Ideal.Quotient.eq_zero_iff_mem
    have D2 : ∀ (c : Fin n) (p q : MvPolynomial (Fin n) k),
        ev (MvPolynomial.pderiv c (p * q)) =
          ev (MvPolynomial.pderiv c p) * ev q + ev p * ev (MvPolynomial.pderiv c q) := by
      intro c p q
      rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul]
    have D3 : ∀ (c : Fin n) (m : MvPolynomial (Fin n) k), m ∈ 𝔐 ^ 2 →
        ev (MvPolynomial.pderiv c m) = 0 := by
      intro c m hm
      rw [pow_two] at hm
      refine Submodule.mul_induction_on (C := fun m => ev (MvPolynomial.pderiv c m) = 0) hm ?_ ?_
      · intro a ha b hb
        show ev (MvPolynomial.pderiv c (a * b)) = 0
        rw [D2, (hev0 a).mpr ha, (hev0 b).mpr hb, mul_zero, zero_mul, add_zero]
      · intro a b ha hb
        show ev (MvPolynomial.pderiv c (a + b)) = 0
        rw [map_add, map_add, ha, hb, add_zero]
    have D4 : ∀ c : Fin n, ev (MvPolynomial.pderiv c (MvPolynomial.X j - 1)) =
        if c = j then 1 else 0 := by
      intro c
      rw [map_sub, MvPolynomial.pderiv_X, Derivation.map_one_eq_zero, sub_zero, Pi.single_apply]
      by_cases h : c = j
      · subst h; simp
      · rw [if_neg (Ne.symm h), if_neg h, map_zero]
    have hterm : ∀ c a b : Fin n, ev (MvPolynomial.pderiv c
        (MvPolynomial.C (N a b) * MvPolynomial.X a * MvPolynomial.X b)) =
        ev (MvPolynomial.C (N a b)) * ((if a = c then 1 else 0) * ev (MvPolynomial.X b) +
          ev (MvPolynomial.X a) * (if b = c then 1 else 0)) := by
      intro c a b
      rw [D2, D2, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X, MvPolynomial.pderiv_X,
        Pi.single_apply, Pi.single_apply, map_mul]
      split_ifs <;> simp only [map_one, map_zero, zero_mul, zero_add, mul_one, mul_zero,
        add_zero, one_mul] <;> ring
    have D5 : ∀ c : Fin n, ev (MvPolynomial.pderiv c Q) =
        ∑ b, (ev (MvPolynomial.C (N c b)) + ev (MvPolynomial.C (N b c))) *
          ev (MvPolynomial.X b) := by
      intro c
      have e1 : ∑ a, ∑ b, ev (MvPolynomial.C (N a b)) *
          ((if a = c then 1 else 0) * ev (MvPolynomial.X b)) =
          ∑ b, ev (MvPolynomial.C (N c b)) * ev (MvPolynomial.X b) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun b _ => ?_
        simp [mul_ite, ite_mul]
      have e2 : ∑ a, ∑ b, ev (MvPolynomial.C (N a b)) *
          (ev (MvPolynomial.X a) * (if b = c then 1 else 0)) =
          ∑ a, ev (MvPolynomial.C (N a c)) * ev (MvPolynomial.X a) := by
        refine Finset.sum_congr rfl fun a _ => ?_
        simp [mul_ite]
      rw [hQdef]
      simp only [map_sum]
      simp only [hterm, mul_add, Finset.sum_add_distrib]
      rw [e1, e2]
      simp only [add_mul, Finset.sum_add_distrib]

    obtain ⟨⟨p₁, s₁⟩, hx1⟩ := IsLocalization.mk'_surjective 𝔐.primeCompl x
    obtain ⟨⟨p₂, s₂⟩, hy1⟩ := IsLocalization.mk'_surjective 𝔐.primeCompl y
    change IsLocalization.mk' (Localization.AtPrime 𝔐) p₁ s₁ = x at hx1
    change IsLocalization.mk' (Localization.AtPrime 𝔐) p₂ s₂ = y at hy1
    subst hx1 hy1
    set a₁ : MvPolynomial (Fin n) k := p₁ * (s₂ : MvPolynomial (Fin n) k) with ha₁
    set b₁ : MvPolynomial (Fin n) k := p₂ * (s₁ : MvPolynomial (Fin n) k) with hb₁
    set P : MvPolynomial (Fin n) k :=
      a₁ * (MvPolynomial.X j - 1) + b₁ * Q with hPdef
    have hP1 : algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐)
        ((s₁ : MvPolynomial (Fin n) k) * s₂) *
        (IsLocalization.mk' (Localization.AtPrime 𝔐) p₁ s₁ *
          algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐) (MvPolynomial.X j - 1) +
         IsLocalization.mk' (Localization.AtPrime 𝔐) p₂ s₂ *
          algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐) Q) =
        algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐) P := by
      have h1 := IsLocalization.mk'_spec (Localization.AtPrime 𝔐) p₁ s₁
      have h2 := IsLocalization.mk'_spec (Localization.AtPrime 𝔐) p₂ s₂
      rw [hPdef, ha₁, hb₁]
      simp only [map_add, map_mul]
      rw [← h1, ← h2]
      ring
    have hP2 : algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐) P ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐) ^ 2 := by
      rw [← hP1]; exact Ideal.mul_mem_left _ _ hxy
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔐 (Localization.AtPrime 𝔐),
      ← Ideal.map_pow] at hP2
    obtain ⟨⟨⟨m, hm⟩, u⟩, hmu⟩ :=
      (IsLocalization.mem_map_algebraMap_iff 𝔐.primeCompl (Localization.AtPrime 𝔐)).mp hP2
    have hmu' : algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐) (P * u) =
        algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime 𝔐) m := by
      rw [map_mul]; exact hmu
    obtain ⟨c', hc'⟩ :=
      (IsLocalization.eq_iff_exists 𝔐.primeCompl (Localization.AtPrime 𝔐)).mp hmu'
    have hw : (c' : MvPolynomial (Fin n) k) * u ∉ 𝔐 := 𝔐.primeCompl.mul_mem c'.2 u.2
    have hwP : (c' : MvPolynomial (Fin n) k) * u * P ∈ 𝔐 ^ 2 := by
      have : (c' : MvPolynomial (Fin n) k) * u * P = c' * m := by rw [← hc']; ring
      rw [this]; exact Ideal.mul_mem_left _ _ hm
    have hevX : ev (MvPolynomial.X j - 1) = 0 := (hev0 _).mpr hX
    have hevQ : ev Q = 0 := (hev0 _).mpr hQ
    have hevP : ev P = 0 := by
      simp only [hPdef, map_add, map_mul, hevX, hevQ, mul_zero, add_zero]
    have hevw : ev ((c' : MvPolynomial (Fin n) k) * u) ≠ 0 := fun h => hw ((hev0 _).mp h)
    have hδP : ∀ c, ev (MvPolynomial.pderiv c P) = 0 := by
      intro c
      have h1 := D3 c _ hwP
      rw [D2, hevP, mul_zero, zero_add] at h1
      exact (mul_eq_zero.mp h1).resolve_left hevw
    have hstar : ∀ c, ev a₁ * (if c = j then 1 else 0) + ev b₁ *
        ∑ b, (ev (MvPolynomial.C (N c b)) + ev (MvPolynomial.C (N b c))) *
          ev (MvPolynomial.X b) = 0 := by
      intro c
      have h := hδP c
      rw [hPdef, map_add, map_add, D2 c a₁ (MvPolynomial.X j - 1),
        D2 c b₁ Q, hevX, hevQ, D4, D5] at h
      simpa only [mul_zero, zero_add] using h

    set φ : k →+* (MvPolynomial (Fin n) k ⧸ 𝔐) := ev.comp MvPolynomial.C with hφ
    have hdetF : (N.map φ + (N.map φ).transpose).det ≠ 0 := by
      have h1 : N.map φ + (N.map φ).transpose = (N + N.transpose).map φ := by
        ext a b
        simp only [Matrix.add_apply, Matrix.transpose_apply, Matrix.map_apply, map_add]
      rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact fun h => hdet (φ.injective (h.trans (map_zero φ).symm))
    have hvj : ev (MvPolynomial.X j) = 1 := by
      have h := hevX
      rw [map_sub, map_one, sub_eq_zero] at h
      exact h
    have hqF : ∑ a, ∑ b, (N.map φ) a b * ev (MvPolynomial.X a) * ev (MvPolynomial.X b) = 0 := by
      have h := hevQ
      rw [hQdef] at h
      simp only [map_sum, map_mul] at h
      exact h
    obtain ⟨c₀, hc₀j, hw₀⟩ := s3 (MvPolynomial (Fin n) k ⧸ 𝔐) n (N.map φ) j
      (fun b => ev (MvPolynomial.X b)) hdetF hvj hqF
    have hw₀' : ∑ b, (ev (MvPolynomial.C (N c₀ b)) + ev (MvPolynomial.C (N b c₀))) *
        ev (MvPolynomial.X b) ≠ 0 := hw₀
    have hb' : ev b₁ = 0 := by
      have h := hstar c₀
      rw [if_neg hc₀j, mul_zero, zero_add] at h
      exact (mul_eq_zero.mp h).resolve_right hw₀'
    have ha' : ev a₁ = 0 := by
      have h := hstar j
      rw [if_pos rfl, mul_one, hb', zero_mul, add_zero] at h
      exact h
    have hpr : 𝔐.IsPrime := Ideal.IsMaximal.isPrime inferInstance
    have hp₁ : p₁ ∈ 𝔐 := (hpr.mem_or_mem ((hev0 _).mp ha')).resolve_right s₂.2
    have hp₂ : p₂ ∈ 𝔐 := (hpr.mem_or_mem ((hev0 _).mp hb')).resolve_right s₁.2
    exact ⟨IsLocalization.mk'_mem_iff.mpr
        ((IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔐 _).mpr hp₁),
      IsLocalization.mk'_mem_iff.mpr
        ((IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔐 _).mpr hp₂)⟩

  intro R _ _ _ _ n t M j g hn _ hmax hdet hG2 β _ hτ C _ _ _
  set Q : MvPolynomial (Fin n) (IsLocalRing.ResidueField R) :=
    ∑ a, ∑ c, MvPolynomial.C (IsLocalRing.residue R (M a c)) *
        MvPolynomial.X a * MvPolynomial.X c with hQ
  set Kb : Ideal (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) :=
    Ideal.span {MvPolynomial.X j - 1, Q} with hKb
  set τ := algebraMap R (wcOdpB t j g) (t j) with hτdef
  obtain ⟨f, hfs, hfk⟩ := s2 R n t M j g hmax hG2
  have hkerβ : RingHom.ker f ≤ β := by
    rw [hfk, Ideal.span_singleton_le_iff_mem]; exact hτ
  haveI hβbmax : (Ideal.map f β).IsMaximal :=
    Ideal.IsMaximal.map_of_surjective_of_ker_le hfs hkerβ
  set βb := Ideal.map f β with hβb
  have hcomap : Ideal.comap f βb = β := by
    rw [hβb, Ideal.comap_map_of_surjective f hfs, ← RingHom.ker_eq_comap_bot,
      sup_eq_left.mpr hkerβ]
  obtain ⟨e₁⟩ := s1 (wcOdpB t j g) _ f hfs β βb hcomap C (Localization.AtPrime βb)
  have heq1 : Ideal.map (algebraMap (wcOdpB t j g) C) (RingHom.ker f) =
      Ideal.span {algebraMap (wcOdpB t j g) C τ} := by
    rw [hfk, Ideal.map_span, Set.image_singleton]
  let e₁' := (Ideal.quotEquivOfEq heq1.symm).trans e₁
  haveI h𝔐max : (Ideal.comap (Ideal.Quotient.mk Kb) βb).IsMaximal :=
    Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
  set 𝔐 := Ideal.comap (Ideal.Quotient.mk Kb) βb with h𝔐
  obtain ⟨e₂⟩ := s1 (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) _
    (Ideal.Quotient.mk Kb) Ideal.Quotient.mk_surjective
    𝔐 βb rfl (Localization.AtPrime 𝔐) (Localization.AtPrime βb)
  have heq2 : Ideal.map (algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
      (Localization.AtPrime 𝔐)) (RingHom.ker (Ideal.Quotient.mk Kb)) =
      Ideal.span {algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
          (Localization.AtPrime 𝔐) (MvPolynomial.X j - 1),
        algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
          (Localization.AtPrime 𝔐) Q} := by
    rw [Ideal.mk_ker]
    exact (Ideal.map_span _ _).trans (by rw [Set.image_pair])
  let e₂' := (Ideal.quotEquivOfEq heq2.symm).trans e₂
  have hK𝔐 : Kb ≤ 𝔐 := fun x hx => by
    rw [h𝔐, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]; exact βb.zero_mem
  have hX𝔐 : MvPolynomial.X j - 1 ∈ 𝔐 := hK𝔐 (Ideal.subset_span (Set.mem_insert _ _))
  have hQ𝔐 : Q ∈ 𝔐 := hK𝔐 (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  set N : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField R) := M.map (IsLocalRing.residue R)
    with hN
  have hdetN : (N + N.transpose).det ≠ 0 := by
    have h1 : (N + N.transpose) = (M + M.transpose).map (IsLocalRing.residue R) := by
      ext a b
      simp only [hN, Matrix.add_apply, Matrix.transpose_apply, Matrix.map_apply, map_add]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (hdet.map (IsLocalRing.residue R)).ne_zero
  haveI : PerfectField (IsLocalRing.ResidueField R) := PerfectField.ofFinite
  obtain ⟨hregL, hdimL⟩ := sA (IsLocalRing.ResidueField R) n 𝔐
  have hind := sB (IsLocalRing.ResidueField R) n N j 𝔐 hdetN hX𝔐 hQ𝔐
  have hx := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔐) 𝔐
    (MvPolynomial.X j - 1)).mpr hX𝔐
  have hy := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔐) 𝔐 Q).mpr hQ𝔐
  haveI := hregL
  obtain ⟨hreg2, hdim2⟩ := sQ (Localization.AtPrime 𝔐) n _ _ hdimL hx hy hind
  let e := e₁'.trans e₂'.symm
  haveI := hreg2
  refine ⟨?_, ?_⟩
  · first
      | exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime 𝔐 ⧸ Ideal.span
          {algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
            (Localization.AtPrime 𝔐) (MvPolynomial.X j - 1),
          algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
            (Localization.AtPrime 𝔐) Q}) e.symm
      | exact @IsRegularLocalRing.of_ringEquiv _ _ hreg2 _ _ e.symm
  · have hde : ringKrullDim (C ⧸ Ideal.span {algebraMap (wcOdpB t j g) C τ}) =
        ringKrullDim (Localization.AtPrime 𝔐 ⧸ Ideal.span
          {algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
            (Localization.AtPrime 𝔐) (MvPolynomial.X j - 1),
          algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
            (Localization.AtPrime 𝔐) Q}) := by
      first
        | exact ringKrullDim_eq_of_ringEquiv (S := Localization.AtPrime 𝔐 ⧸ Ideal.span
            {algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
              (Localization.AtPrime 𝔐) (MvPolynomial.X j - 1),
            algebraMap (MvPolynomial (Fin n) (IsLocalRing.ResidueField R))
              (Localization.AtPrime 𝔐) Q}) e
        | exact @ringKrullDim_eq_of_ringEquiv _ _ _ _ e
    rw [hde, hdim2, show n - 1 - 1 = n - 2 by omega]

theorem wc_bm_blowup_smooth_reduced : ∀ (K : Type u) [Field K] [Finite K] (P : Scheme.{u})
    (fP : P ⟶ Spec (.of K)) [IsProper fP] (n : ℕ) (xb : P) (O : P.Opens)
    (Z : TopologicalSpace.Closeds P), 2 ≤ n → (Z : Set P) = {xb} → (O : Set P) = {xb}ᶜ →
    SmoothOfRelativeDimension (n - 1) (O.ι ≫ fP) →
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (t : Fin n → R) (h : R)
      (M : Matrix (Fin n) (Fin n) R), ringKrullDim R = n →
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) →
      h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 →
      IsUnit (M + M.transpose).det → Nonempty (P.presheaf.stalk xb ≃+* R ⧸ Ideal.span {h}) →
    ∀ (Yb : Scheme.{u}) (r : Yb ⟶ P) [IsProper r],
      wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal Z) r →
      SmoothOfRelativeDimension (n - 1) (r ≫ fP) ∧
        IsReduced ((Scheme.IdealSheafData.vanishingIdeal Z).comap r).subscheme :=
by
  intro K _ _ P fP _ n xb O Z hn2 hZ hO hsm R _ _ _ t h M hdim hmax hq hdet hσ Yb r _ hbl

  have hxb : IsClosed ({xb} : Set P) := by rw [← hZ]; exact Z.isClosed
  have hZeq : Z = (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P) := TopologicalSpace.Closeds.ext hZ
  set I : P.IdealSheafData := Scheme.IdealSheafData.vanishingIdeal Z with hIdef
  have hI : I = Scheme.IdealSheafData.vanishingIdeal
      (⟨{xb}, hxb⟩ : TopologicalSpace.Closeds P) := by
    rw [hIdef]; exact congrArg _ hZeq
  have hIsupp : (I.support : Set P) = {xb} :=
    (Scheme.IdealSheafData.coe_support_vanishingIdeal Z).trans hZ

  have hrange : Set.range (I.comap r).subschemeι = r ⁻¹' {xb} := by
    ext y
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap]
    change r y ∈ (I.support : Set P) ↔ _
    rw [hIsupp]
    rfl

  have hdisj : (I.support : Set P) ∩ (O : Set P) = ∅ := by
    rw [hIsupp, hO]; exact Set.inter_compl_self _
  haveI hiso : IsIso (r ∣_ O) := wc_csd_blowup_iso_off_center P Yb I r O hbl hdisj

  have hfin : Finite (IsLocalRing.ResidueField R) := by
    obtain ⟨σ⟩ := hσ
    haveI : JacobsonSpace (Spec (.of K)) :=
      (PrimeSpectrum.isJacobsonRing_iff_jacobsonSpace (R := K)).mp inferInstance
    haveI : JacobsonSpace P := LocallyOfFiniteType.jacobsonSpace fP
    haveI : LocallyOfFiniteType (P.fromSpecResidueField xb) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hxb
    have hg : LocallyOfFiniteType (Spec.map (Spec.preimage (P.fromSpecResidueField xb ≫ fP))) := by
      rw [Spec.map_preimage]; infer_instance
    have hft : (Spec.preimage (P.fromSpecResidueField xb ≫ fP)).hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hg
    letI : Algebra K (P.residueField xb) :=
      (Spec.preimage (P.fromSpecResidueField xb ≫ fP)).hom.toAlgebra
    haveI : Algebra.FiniteType K (P.residueField xb) := hft
    haveI : Module.Finite K (P.residueField xb) := finite_of_finite_type_of_isJacobsonRing K _
    haveI hL : Finite (P.residueField xb) := Module.finite_of_finite K
    let ψ : R →+* P.presheaf.stalk xb := σ.symm.toRingHom.comp (Ideal.Quotient.mk _)
    have hψ : Function.Surjective ψ := σ.symm.surjective.comp Ideal.Quotient.mk_surjective
    haveI : IsLocalHom ψ := hψ.isLocalHom ψ
    haveI : Finite (IsLocalRing.ResidueField (P.presheaf.stalk xb)) := hL
    exact Finite.of_injective (IsLocalRing.ResidueField.map ψ)
      (IsLocalRing.ResidueField.map ψ).injective
  haveI := hfin

  have hchart : ∀ y : Yb, IsClosed ({y} : Set Yb) → r y = xb →
      IsRegularLocalRing (Yb.presheaf.stalk y) ∧
      ringKrullDim (Yb.presheaf.stalk y) = ((n - 1 : ℕ) : WithBot ℕ∞) ∧
      ∀ (W : Yb.affineOpens) (hyW : y ∈ W.1),
        IsRegularLocalRing (Yb.presheaf.stalk y ⧸
          Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W)) ∧
        ringKrullDim (Yb.presheaf.stalk y ⧸
          Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W)) =
          ((n - 1 - 1 : ℕ) : WithBot ℕ∞) := by
    intro y hy hry
    obtain ⟨j, g, β, hβ, hG1, hG2, hτ, C, _, _, hloc, e, he⟩ :=
      wc_bm_blowup_stalk_chart K P fP n xb hxb R t h M hn2 hdim hmax hq hdet hσ I hI
        Yb r hbl y hy hry
    haveI : IsLocalRing C := IsLocalization.AtPrime.isLocalRing C β
    haveI : IsNoetherianRing C := IsLocalization.isNoetherianRing β.primeCompl C inferInstance
    have hnzd := (wc_odp_chart_nzd R n t M j g hdim hmax hdet hG2).2 β C
    obtain ⟨hfreg, hfdim⟩ :=
      wc_bm_chart_fibre_regular R n t M j g hn2 hdim hmax hdet hG2 β hτ C
    have hmem : algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j)) ∈
          IsLocalRing.maximalIdeal C :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff C β _).mpr hτ
    obtain ⟨hreg, hdimC⟩ :=
      wc_odp_regular_lift_nzd C _ (n - 1 - 1) hmem hnzd hfreg hfdim
    have hn' : n - 1 - 1 + 1 = n - 1 := by omega
    rw [hn'] at hdimC
    haveI := hreg
    refine ⟨IsRegularLocalRing.of_ringEquiv e.symm, (ringKrullDim_eq_of_ringEquiv e).trans hdimC,
      ?_⟩
    intro W hyW
    let e2 := Ideal.quotientEquiv
      (Ideal.map (Yb.presheaf.germ W.1 y hyW).hom ((I.comap r).ideal W))
      (Ideal.span {algebraMap (wcOdpB t j g) C (algebraMap R (wcOdpB t j g) (t j))}) e
      (by first | exact (he W hyW).symm | (rw [← he W hyW]; rfl))
    haveI := hfreg
    exact ⟨IsRegularLocalRing.of_ringEquiv e2.symm,
      (ringKrullDim_eq_of_ringEquiv e2).trans hfdim⟩

  have hsmY : SmoothOfRelativeDimension (n - 1) (r ≫ fP) := by
    apply wc_odp_smooth_of_closed_regular K Yb (r ≫ fP) (n - 1)
    intro y hy
    by_cases hry : r y = xb
    · right
      exact ⟨(hchart y hy hry).1, (hchart y hy hry).2.1⟩
    · left
      refine ⟨r ⁻¹ᵁ O, (O : Scheme.{u}), O.ι ≫ fP, asIso (r ∣_ O), ?_, hsm, ?_⟩
      · change r y ∈ (O : Set P)
        rw [hO]; exact hry
      · rw [asIso_hom, ← Category.assoc, morphismRestrict_ι, Category.assoc]

  have hsmE : SmoothOfRelativeDimension (n - 1 - 1) ((I.comap r).subschemeι ≫ r ≫ fP) := by
    apply wc_odp_smooth_of_closed_regular K _ _ (n - 1 - 1)
    intro z hz
    right
    have hyc : IsClosed ({(I.comap r).subschemeι z} : Set Yb) := by
      have := (I.comap r).subschemeι.isClosedEmbedding.isClosedMap _ hz
      rwa [Set.image_singleton] at this
    have hry : r ((I.comap r).subschemeι z) = xb := by
      have hmem : (I.comap r).subschemeι z ∈ Set.range (I.comap r).subschemeι := ⟨z, rfl⟩
      rw [hrange] at hmem
      exact hmem
    obtain ⟨W, hW, hzW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⊤) (x := (I.comap r).subschemeι z) trivial
    obtain ⟨-, -, hquot⟩ := hchart _ hyc hry
    obtain ⟨hqr, hqd⟩ := hquot ⟨W, hW⟩ hzW
    obtain ⟨φ⟩ := wc_odp_subscheme_stalk Yb (I.comap r) z ⟨W, hW⟩ hzW
    haveI := hqr
    exact ⟨IsRegularLocalRing.of_ringEquiv φ.symm, (ringKrullDim_eq_of_ringEquiv φ).trans hqd⟩

  haveI := hsmE
  haveI hstalk : ∀ z : (I.comap r).subscheme,
      _root_.IsReduced ((I.comap r).subscheme.presheaf.stalk z) := by
    intro z
    haveI := wcpa_smooth_stalk_isDomain K _ ((I.comap r).subschemeι ≫ r ≫ fP) (n - 1 - 1) z
    infer_instance
  exact ⟨hsmY, AlgebraicGeometry.isReduced_of_isReduced_stalk _⟩

theorem wc_beq_crit_point_data (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m)
    (τ : (wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
    (hτ : IsLocalRing.maximalIdeal
          ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) =
        Ideal.span {τ}) :
    ∃ (s : Spec (.of F'') ⟶ Limits.pullback D.f (D.S i))
      (φ : D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')) →+*
        (Limits.pullback D.f (D.S i)).presheaf.stalk (s (IsLocalRing.closedPoint F''))),
      s ≫ Limits.pullback.snd D.f (D.S i) = 𝟙 _ ∧
      (SetLike.coe (wcCritPunctOpen D i) : Set ↥(Limits.pullback D.f (D.S i) : Scheme.{u})) =
        {s (IsLocalRing.closedPoint F'')}ᶜ ∧
      Function.Surjective φ ∧
      Ideal.map φ (IsLocalRing.maximalIdeal
          (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))) =
        IsLocalRing.maximalIdeal
          ((Limits.pullback D.f (D.S i)).presheaf.stalk (s (IsLocalRing.closedPoint F''))) ∧
      RingHom.ker φ = Ideal.span {(D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ} ∧
      φ.comp (wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F''))) =
        wcLdpConst F'' (Limits.pullback.snd D.f (D.S i)) (s (IsLocalRing.closedPoint F'')) ∧
      ∀ y, ∃ c : F'', y - wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) c ∈
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) :=
by
  classical
  have hxsf : D.xs i ≫ D.f = 𝟙 _ ≫ D.S i := (D.hxs i).trans (Category.id_comp _).symm
  let s : Spec (.of F'') ⟶ Limits.pullback D.f (D.S i) := Limits.pullback.lift (D.xs i) (𝟙 _) hxsf
  have hs : s ≫ Limits.pullback.snd D.f (D.S i) = 𝟙 _ := Limits.pullback.lift_snd _ _ _
  have hsf : s ≫ Limits.pullback.fst D.f (D.S i) = D.xs i := Limits.pullback.lift_fst _ _ _
  haveI hSci : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  haveI hxci : IsClosedImmersion (D.xs i) :=
    isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i) hxsY
  have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
    have h1 : IsClosed (Set.range (D.xs i)) := (D.xs i).isClosedEmbedding.isClosed_range
    have h2 : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint F'')]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← h2]; exact h1
  haveI hfci : IsClosedImmersion (Limits.pullback.fst D.f (D.S i)) := by
    first
      | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback D.f (D.S i)).flip hSci
      | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback D.f (D.S i)) hSci
      | infer_instance
  have hfinj : Function.Injective (Limits.pullback.fst D.f (D.S i)) :=
    (Limits.pullback.fst D.f (D.S i)).isClosedEmbedding.injective
  have hfs : (Limits.pullback.fst D.f (D.S i)) (s (IsLocalRing.closedPoint F'')) =
      D.xs i (IsLocalRing.closedPoint F'') := by
    first
      | exact congrArg (fun g : Spec (.of F'') ⟶ D.Yt.left => g (IsLocalRing.closedPoint F'')) hsf
      | exact (Scheme.Hom.comp_apply _ _ _).symm.trans
          (congrArg (fun g : Spec (.of F'') ⟶ D.Yt.left => g (IsLocalRing.closedPoint F'')) hsf)
      | simp [← hsf]
  have hO : SetLike.coe (wcCritPunctOpen D i) = {s (IsLocalRing.closedPoint F'')}ᶜ := by
    ext x
    show x ∈ (Limits.pullback.fst D.f (D.S i)) ⁻¹' (closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ ↔ _
    rw [hclosed.closure_eq]
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
    constructor
    · intro h hx
      exact h (hx ▸ hfs)
    · intro h hx
      exact h (hfinj (hx.trans hfs.symm))

  have L1 : ∀ {X Z : Scheme.{u}} (f₁ : X ⟶ Z) (g : Z ⟶ Spec (.of F'')) (x : X),
      (f₁.stalkMap x).hom.comp (wcLdpConst F'' g (f₁ x)) = wcLdpConst F'' (f₁ ≫ g) x := by
    intro X Z f₁ g x
    ext c
    simp only [wcLdpConst, RingHom.comp_apply]
    refine (Scheme.Hom.germ_stalkMap_apply f₁ ⊤ x trivial _).trans ?_
    rw [Scheme.Hom.comp_appTop]
    rfl
  have hfY : Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom = Limits.pullback.snd D.f (D.S i) := by
    rw [← D.hf, ← Category.assoc, Limits.pullback.condition, Category.assoc, D.hS i,
      Category.comp_id]
  have key : ∀ (y : D.Yt.left) (p : ↥(Limits.pullback D.f (D.S i) : Scheme.{u}))
      (_ : Limits.pullback.fst D.f (D.S i) p = y)
      (τ' : (wcP1Over F'').left.presheaf.stalk (D.f y))
      (_ : IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.f y)) = Ideal.span {τ'}),
      ∃ φ : D.Yt.left.presheaf.stalk y →+* (Limits.pullback D.f (D.S i)).presheaf.stalk p,
        Function.Surjective φ ∧
        Ideal.map φ (IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y)) =
          IsLocalRing.maximalIdeal ((Limits.pullback D.f (D.S i)).presheaf.stalk p) ∧
        RingHom.ker φ = Ideal.span {(D.f.stalkMap y).hom τ'} ∧
        φ.comp (wcLdpConst F'' D.Yt.hom y) = wcLdpConst F'' (Limits.pullback.snd D.f (D.S i)) p := by
    intro y p hp τ' hτ'
    subst hp
    have hsurj := (Limits.pullback.fst D.f (D.S i)).stalkMap_surjective p
    have hsq : IsPullback (Limits.pullback.fst D.f (D.S i)) (Limits.pullback.snd D.f (D.S i))
        (D.f ≫ 𝟙 _) (D.S i) := by
      rw [Category.comp_id]; exact IsPullback.of_hasPullback D.f (D.S i)
    have hker := wc_cpfo_stalk_ker_closed_pt_base_change (Limits.pullback.fst D.f (D.S i))
      (Limits.pullback.snd D.f (D.S i)) D.f (𝟙 _) (D.S i) hsq p τ' hτ'
    have hid : ((𝟙 (wcP1Over F'').left : (wcP1Over F'').left ⟶ _).stalkMap
        (D.f (Limits.pullback.fst D.f (D.S i) p))).hom τ' = τ' := by
      rw [Scheme.Hom.stalkMap_id]
      first | rfl | simp
    rw [hid] at hker
    refine ⟨((Limits.pullback.fst D.f (D.S i)).stalkMap p).hom, hsurj,
      IsLocalRing.map_maximalIdeal_of_surjective _ hsurj, hker, ?_⟩
    rw [L1, hfY]
  obtain ⟨φ, hsurj, hmax, hker, hconst⟩ := key _ (s (IsLocalRing.closedPoint F'')) hfs τ hτ

  have hres : ∀ y, ∃ c : F'', y - wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) c ∈
      IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) := by
    let ε : D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')) →+* F'' :=
      (stalkClosedPointIso (CommRingCat.of F'')).hom.hom.comp
        ((D.xs i).stalkMap (IsLocalRing.closedPoint F'')).hom
    have hg : (Spec (CommRingCat.of F'')).presheaf.germ ⊤ (IsLocalRing.closedPoint F'') trivial =
        (Scheme.ΓSpecIso (CommRingCat.of F'')).hom ≫ (stalkClosedPointIso (CommRingCat.of F'')).inv :=
      (ΓSpecIso_hom_stalkClosedPointIso_inv _).symm
    have hε : ∀ c, ε (wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) c) = c := by
      intro c
      have h1 := congrArg (fun ψ => ψ c) (L1 (D.xs i) D.Yt.hom (IsLocalRing.closedPoint F''))
      simp only [RingHom.comp_apply] at h1
      show (stalkClosedPointIso (CommRingCat.of F'')).hom.hom
        (((D.xs i).stalkMap (IsLocalRing.closedPoint F'')).hom
          (wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) c)) = c
      rw [h1, hxsY]
      simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.id_appTop, hg]
      simp
    intro y
    refine ⟨ε y, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h0 := hu.map ε
    rw [map_sub, hε, sub_self] at h0
    exact not_isUnit_zero h0
  exact ⟨s, φ, hs, hO, hsurj, hmax, hker, hconst, hres⟩

theorem wc_bm_exceptional_quadric (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m)
    (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → F'')
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (t : Fin n → D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))
    (τ : (wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
    (A : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))))
    (ht : IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) =
        Ideal.span (Set.range t))
    (hτ : IsLocalRing.maximalIdeal
          ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) =
        Ideal.span {τ})
    (hA : (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) ^ 3)
    (hAa : ∀ p c : Fin (n - 2 + 1 + 1),
        A (Fin.cast (by omega) p) (Fin.cast (by omega) c) -
            wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) (a p c) ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))))
    (E₀ : Over (Spec (.of F''))) (hpr : IsProper E₀.hom)
    (hsm : SmoothOfRelativeDimension (n - 2) E₀.hom)
    (jE : E₀.left ⟶ wcProjK F'' (n - 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr F'' (n - 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (n - 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD F'' (n - 2 + 1) c),
      wcLdpGerm F'' (n - 2 + 1) jE (wcLdpQuad F'' (n - 2 + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK F'' (n - 2 + 1), (∀ (c : Fin (n - 2 + 1 + 1))
        (hp : p ∈ wcSgD F'' (n - 2 + 1) c),
        ((wcProjK F'' (n - 2 + 1)).presheaf.germ (wcSgD F'' (n - 2 + 1) c) p hp).hom
            (wcLdpSec F'' (n - 2 + 1) (wcLdpQuad F'' (n - 2 + 1) a) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK F'' (n - 2 + 1)).presheaf.stalk p)) →
      p ∈ Set.range jE)
    (Yb : Scheme.{u}) (r : Yb ⟶ Limits.pullback D.f (D.S i)) [IsProper r]
    (Z : TopologicalSpace.Closeds ↥(Limits.pullback D.f (D.S i) : Scheme.{u}))
    (hZ : (Z : Set ↥(Limits.pullback D.f (D.S i) : Scheme.{u})) = (SetLike.coe (wcCritPunctOpen D i))ᶜ)
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal Z) r)
    (hred : IsReduced ((Scheme.IdealSheafData.vanishingIdeal Z).comap r).subscheme) :
    ∃ iE : E₀.left ⟶ Yb, IsClosedImmersion iE ∧
      iE ≫ r ≫ Limits.pullback.snd D.f (D.S i) = E₀.hom ∧
      Set.range iE = r ⁻¹' (SetLike.coe (wcCritPunctOpen D i))ᶜ :=
by
  classical
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 + 1 := ⟨n - 2, by omega⟩

  obtain ⟨hnoeth, hdim, hdet, -⟩ :=
    wc_bm_crit_point_stalk F' F'' Y (k + 1 + 1) hn2 D i a ha t τ A ht hτ hA hAa
  haveI := hnoeth

  obtain ⟨s, φ, hs, hO, hφsurj, hφmax, hφker, hφconst, hres⟩ :=
    wc_beq_crit_point_data F' F'' Y (k + 1 + 1) D i τ hτ

  have hP1sep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (wcProjKStr F'' 1)
    infer_instance
  haveI := hP1sep
  haveI hYtp : IsProper D.Yt.hom := D.proper
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact hYtp
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hXp : IsProper (Limits.pullback.snd D.f (D.S i)) := inferInstance
  haveI hXln : IsLocallyNoetherian (Limits.pullback D.f (D.S i)) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd D.f (D.S i))
  have hZp : (Z : Set ↥(Limits.pullback D.f (D.S i) : Scheme.{u})) =
      {s (IsLocalRing.closedPoint F'')} := by
    rw [hZ, hO, compl_compl]

  have hspan : Ideal.span (Set.range (fun b => φ (t b))) =
      IsLocalRing.maximalIdeal ((Limits.pullback D.f (D.S i)).presheaf.stalk
        (s (IsLocalRing.closedPoint F''))) := by
    rw [← hφmax, ht, Ideal.map_span, ← Set.range_comp]
    rfl

  obtain ⟨U, hp, g, hg, hIU⟩ := wc_beq_point_generators (Limits.pullback D.f (D.S i)) hXln
    (s (IsLocalRing.closedPoint F'')) Z hZp (k + 1 + 1) (fun b => φ (t b)) hspan

  obtain ⟨P, ι, κ', hι, hκ', hcomm, hrange, hbl, hIdeal, hrel⟩ :=
    wc_beq_affine_blowup_model F'' (Limits.pullback D.f (D.S i)) (Limits.pullback.snd D.f (D.S i))
      inferInstance (Scheme.IdealSheafData.vanishingIdeal Z) U (k + 1) g hIU Yb r hr
  have hφh : φ ((D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ) = 0 := by
    rw [← RingHom.mem_ker, hφker]
    exact Ideal.mem_span_singleton_self _

  have hgermE : ∀ (x : E₀.left) (c : Fin (k + 1 + 1 - 2 + 1 + 1))
      (hc : jE x ∈ wcSgD F'' (k + 1 + 1 - 2 + 1) c),
      ((wcProjK F'' (k + 1 + 1 - 2 + 1)).presheaf.germ (wcSgD F'' (k + 1 + 1 - 2 + 1) c)
          (jE x) hc).hom (wcLdpSec F'' (k + 1 + 1 - 2 + 1) (wcLdpQuad F'' (k + 1 + 1 - 2 + 1) a) c) ∈
        IsLocalRing.maximalIdeal ((wcProjK F'' (k + 1 + 1 - 2 + 1)).presheaf.stalk (jE x)) := by
    intro x c hc
    have h4 := hEG x c hc
    have h5 : (jE.stalkMap x).hom
        (((wcProjK F'' (k + 1 + 1 - 2 + 1)).presheaf.germ (wcSgD F'' (k + 1 + 1 - 2 + 1) c)
          (jE x) hc).hom (wcLdpSec F'' (k + 1 + 1 - 2 + 1)
            (wcLdpQuad F'' (k + 1 + 1 - 2 + 1) a) c)) ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x) := by
      rw [Scheme.Hom.germ_stalkMap_apply]
      exact h4
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h5 ⊢
    exact fun hu => h5 (hu.map _)

  have hset : ∀ v : wcProjK F'' (k + 1), v ∈ Set.range jE ↔ ∃ y : P,
      U.1.ι ((ι ≫ Limits.pullback.fst (U.1.ι ≫ Limits.pullback.snd D.f (D.S i))
        (wcProjKStr F'' (k + 1))) y) = s (IsLocalRing.closedPoint F'') ∧
      (ι ≫ Limits.pullback.snd (U.1.ι ≫ Limits.pullback.snd D.f (D.S i))
        (wcProjKStr F'' (k + 1))) y = v := by
    intro v
    constructor
    · rintro ⟨x, rfl⟩
      exact wc_beq_quadric_in_fibre F'' (Limits.pullback D.f (D.S i))
        (Limits.pullback.snd D.f (D.S i)) (Scheme.IdealSheafData.vanishingIdeal Z) U
        (s (IsLocalRing.closedPoint F'')) hp (k + 1) g P ι hι hIdeal hbl hrel
        (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) t
        ((D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ) A
        (wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F''))) φ a
        hdim ht hA hdet hφsurj hφker hφmax hφconst hres (fun p c => hAa p c) hg (jE x) (hgermE x)
    · rintro ⟨y, hy, rfl⟩
      apply hEall
      intro c hc
      exact wc_beq_fibre_in_quadric F'' (Limits.pullback D.f (D.S i))
        (Limits.pullback.snd D.f (D.S i)) U (s (IsLocalRing.closedPoint F'')) hp (k + 1) g P ι
        hι hrel (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) t
        ((D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ) A
        (wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F''))) φ a
        ht hA hφh hφmax hφconst (fun p c => hAa p c) hg y hy c hc

  have hrangeE : Set.range ((Scheme.IdealSheafData.vanishingIdeal Z).comap r).subschemeι =
      r ⁻¹' {s (IsLocalRing.closedPoint F'')} := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_comap]
    show r ⁻¹' ((Scheme.IdealSheafData.vanishingIdeal Z).support : Set _) = _
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, hZp]

  haveI := hsm
  haveI : ∀ x : E₀.left, _root_.IsReduced (E₀.left.presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain F'' E₀.left E₀.hom (k + 1 + 1 - 2) x
    infer_instance
  have hE₀red : AlgebraicGeometry.IsReduced E₀.left := isReduced_of_isReduced_stalk E₀.left

  obtain ⟨iE, hiE, hstr, hrng⟩ := wc_beq_exceptional_embed F'' (Limits.pullback D.f (D.S i))
    (Limits.pullback.snd D.f (D.S i)) s hs U.1 hp (k + 1) P ι Yb r κ' hι hκ' hcomm hrange
    _ ((Scheme.IdealSheafData.vanishingIdeal Z).comap r).subschemeι inferInstance hred hrangeE
    E₀.left jE hjE hE₀red hset
  refine ⟨iE, hiE, hstr.trans hjEY, ?_⟩
  rw [hrng, hrangeE, hO, compl_compl]

theorem wc_odp_fibre_blowup_model (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m)
    (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → F'')
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (t : Fin n → D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))
    (τ : (wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
    (A : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))))
    (ht : IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) =
        Ideal.span (Set.range t))
    (hτ : IsLocalRing.maximalIdeal
          ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) =
        Ideal.span {τ})
    (hA : (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) ^ 3)
    (hAa : ∀ p c : Fin (n - 2 + 1 + 1),
        A (Fin.cast (by omega) p) (Fin.cast (by omega) c) -
            wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) (a p c) ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))))
    (E₀ : Over (Spec (.of F''))) (hpr : IsProper E₀.hom)
    (hsm : SmoothOfRelativeDimension (n - 2) E₀.hom)
    (jE : E₀.left ⟶ wcProjK F'' (n - 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr F'' (n - 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (n - 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD F'' (n - 2 + 1) c),
      wcLdpGerm F'' (n - 2 + 1) jE (wcLdpQuad F'' (n - 2 + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK F'' (n - 2 + 1), (∀ (c : Fin (n - 2 + 1 + 1))
        (hp : p ∈ wcSgD F'' (n - 2 + 1) c),
        ((wcProjK F'' (n - 2 + 1)).presheaf.germ (wcSgD F'' (n - 2 + 1) c) p hp).hom
            (wcLdpSec F'' (n - 2 + 1) (wcLdpQuad F'' (n - 2 + 1) a) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK F'' (n - 2 + 1)).presheaf.stalk p)) →
      p ∈ Set.range jE) :
    ∃ (Xt : Over (Spec (.of F''))) (_ : IsProper Xt.hom)
      (_ : SmoothOfRelativeDimension (n - 2 + 1) Xt.hom)
      (b : Xt.left ⟶ Limits.pullback D.f (D.S i)) (iE : E₀.left ⟶ Xt.left),
      IsProper b ∧ b ≫ Limits.pullback.snd D.f (D.S i) = Xt.hom ∧
      IsIso (b ∣_ wcCritPunctOpen D i) ∧ IsClosedImmersion iE ∧ iE ≫ Xt.hom = E₀.hom ∧
      ((b ⁻¹ᵁ wcCritPunctOpen D i : Xt.left.Opens) : Set Xt.left) = (Set.range iE)ᶜ :=
by
  classical
  have hP1sep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (wcProjKStr F'' 1)
    infer_instance
  haveI := hP1sep
  haveI hYtp : IsProper D.Yt.hom := D.proper
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact hYtp
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hXp : IsProper (Limits.pullback.snd D.f (D.S i)) := inferInstance
  have hxsf : D.xs i ≫ D.f = 𝟙 _ ≫ D.S i := (D.hxs i).trans (Category.id_comp _).symm
  let s : Spec (.of F'') ⟶ Limits.pullback D.f (D.S i) := Limits.pullback.lift (D.xs i) (𝟙 _) hxsf
  have hsf : s ≫ Limits.pullback.fst D.f (D.S i) = D.xs i := Limits.pullback.lift_fst _ _ _
  haveI hSci : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  haveI hxci : IsClosedImmersion (D.xs i) :=
    isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i) hxsY
  have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
    have h1 : IsClosed (Set.range (D.xs i)) := (D.xs i).isClosedEmbedding.isClosed_range
    have h2 : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint F'')]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← h2]; exact h1
  have hfinj : Function.Injective (Limits.pullback.fst D.f (D.S i)) :=
    (Limits.pullback.fst D.f (D.S i)).isClosedEmbedding.injective
  have hfs : (Limits.pullback.fst D.f (D.S i)) (s (IsLocalRing.closedPoint F'')) =
      D.xs i (IsLocalRing.closedPoint F'') := by
    first
      | exact congrArg (fun g : Spec (.of F'') ⟶ D.Yt.left => g (IsLocalRing.closedPoint F'')) hsf
      | exact (Scheme.Hom.comp_apply _ _ _).symm.trans
          (congrArg (fun g : Spec (.of F'') ⟶ D.Yt.left => g (IsLocalRing.closedPoint F'')) hsf)
      | simp [← hsf]
  have hO : SetLike.coe (wcCritPunctOpen D i) = {s (IsLocalRing.closedPoint F'')}ᶜ := by
    ext x
    show x ∈ (Limits.pullback.fst D.f (D.S i)) ⁻¹' (closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ ↔ _
    rw [hclosed.closure_eq]
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
    constructor
    · intro h hx
      exact h (hx ▸ hfs)
    · intro h hx
      exact h (hfinj (hx.trans hfs.symm))

  obtain ⟨hnoeth, hdim, hdet, hstalk⟩ :=
    wc_bm_crit_point_stalk F' F'' Y n hn2 D i a ha t τ A ht hτ hA hAa
  haveI := hnoeth

  let Z : TopologicalSpace.Closeds ↥(Limits.pullback D.f (D.S i) : Scheme.{u}) :=
    ⟨(SetLike.coe (wcCritPunctOpen D i))ᶜ, (wcCritPunctOpen D i).isOpen.isClosed_compl⟩
  have hZ : (Z : Set ↥(Limits.pullback D.f (D.S i) : Scheme.{u})) = (SetLike.coe (wcCritPunctOpen D i))ᶜ := rfl
  have hZp : (Z : Set ↥(Limits.pullback D.f (D.S i) : Scheme.{u})) = {s (IsLocalRing.closedPoint F'')} := by
    rw [hZ, hO, compl_compl]

  obtain ⟨Yb, r, hr, hrp⟩ := wc_odp_blowup_proper F'' (Limits.pullback D.f (D.S i))
    (Limits.pullback.snd D.f (D.S i)) (Scheme.IdealSheafData.vanishingIdeal Z)
  haveI := hrp

  have hsupp : ((Scheme.IdealSheafData.vanishingIdeal Z).support : Set ↥(Limits.pullback D.f (D.S i) : Scheme.{u})) =
      (SetLike.coe (wcCritPunctOpen D i))ᶜ :=
    (Scheme.IdealSheafData.coe_support_vanishingIdeal Z).trans hZ
  have hiso : IsIso (r ∣_ wcCritPunctOpen D i) :=
    wc_csd_blowup_iso_off_center _ _ _ r _ hr (by rw [hsupp]; exact Set.compl_inter_self _)

  obtain ⟨hsmooth, hred⟩ := wc_bm_blowup_smooth_reduced F'' (Limits.pullback D.f (D.S i))
    (Limits.pullback.snd D.f (D.S i)) n (s (IsLocalRing.closedPoint F'')) (wcCritPunctOpen D i) Z
    hn2 hZp hO (wc_bm_punct_fibre_smooth F' F'' Y n hn2 D i) _ t _ A hdim ht hA hdet
    (hstalk _ hfs) Yb r hr

  obtain ⟨iE, hiE, hiEX, hrange⟩ := wc_bm_exceptional_quadric F' F'' Y n hn2 D i a ha t τ A ht hτ
    hA hAa E₀ hpr hsm jE hjE hjEY hEG hEall Yb r Z hZ hr hred
  have hn : n - 1 = n - 2 + 1 := by omega
  refine ⟨Over.mk (r ≫ Limits.pullback.snd D.f (D.S i)), ?_, ?_, r, iE, hrp, rfl, hiso, hiE,
    hiEX, ?_⟩
  · show IsProper (r ≫ Limits.pullback.snd D.f (D.S i))
    infer_instance
  · show SmoothOfRelativeDimension (n - 2 + 1) (r ≫ Limits.pullback.snd D.f (D.S i))
    rw [← hn]
    exact hsmooth
  · first
      | (rw [hrange, Set.preimage_compl, compl_compl]; rfl)
      | rw [hrange, Set.preimage_compl, compl_compl]

theorem wc_mpq_res_bij_over_iso_locus {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (O : Y.Opens) (hO : IsIso (i ∣_ O))
    (U : Y.ProEt) (hU : Set.range U.hom ⊆ (O : Set Y)) (n : ℕ) (hn : 0 < n) (j : ℕ) :
    Function.Bijective (wcProEtRes i L adj θ (ZMod n) U j) :=
by
  classical
  have topι : ∀ {X : Scheme.{u}} (V : X.Opens), V = ⊤ → IsIso V.ι := by
    intro X V hV
    subst hV
    rw [← Scheme.topIso_hom]
    infer_instance
  have isoTop : ∀ {X X' : Scheme.{u}} (f : X ⟶ X') (V : X'.Opens), V = ⊤ →
      IsIso (f ∣_ V) → IsIso f := by
    intro X X' f V hV hf
    haveI := topι V hV
    haveI := topι (f ⁻¹ᵁ V) (by rw [hV]; exact Scheme.Hom.preimage_top f)
    haveI : IsIso ((f ⁻¹ᵁ V).ι ≫ f) := by rw [← morphismRestrict_ι]; infer_instance
    exact IsIso.of_isIso_comp_left (f ⁻¹ᵁ V).ι f
  haveI hp : IsIso (Limits.pullback.fst U.hom i) :=
    isoTop _ (U.hom ⁻¹ᵁ O) (top_unique fun x _ => hU ⟨x, rfl⟩)
      (wc_isIso_restrict_pullback_fst U.hom i O hO)
  obtain ⟨Dp, hDp⟩ := wc_zmod_pull_data_exists (Limits.pullback.fst U.hom i) n
  obtain ⟨Dq, hDq⟩ := wc_zmod_pull_data_exists (inv (Limits.pullback.fst U.hom i)) n
  obtain ⟨D₁, hD₁⟩ := wc_zmod_pull_data_exists (𝟙 (Limits.pullback U.hom i)) n
  obtain ⟨D₂, hD₂⟩ := wc_zmod_pull_data_exists (𝟙 U.left) n
  have hleft : Function.LeftInverse (wcZModPull Dq j) (wcZModPull Dp j) := by
    intro x
    have h1 := wc_zmod_pull_comp (Limits.pullback.fst U.hom i)
      (inv (Limits.pullback.fst U.hom i)) (𝟙 U.left) (IsIso.inv_hom_id _)
      Dp hDp Dq hDq D₂ hD₂ j x
    rw [← h1]
    exact wc_zmod_pull_id (𝟙 U.left) rfl D₂ hD₂ j x
  have hright : Function.RightInverse (wcZModPull Dq j) (wcZModPull Dp j) := by
    intro y
    have h1 := wc_zmod_pull_comp (inv (Limits.pullback.fst U.hom i))
      (Limits.pullback.fst U.hom i) (𝟙 (Limits.pullback U.hom i)) (IsIso.hom_inv_id _)
      Dq hDq Dp hDp D₁ hD₁ j y
    rw [← h1]
    exact wc_zmod_pull_id (𝟙 (Limits.pullback U.hom i)) rfl D₁ hD₁ j y
  exact wc_proet_res_bij_of_zmod_pull_bij i L adj θ U n hn Dp hDp j
    ⟨hleft.injective, hright.surjective⟩

theorem wc_mpq_punct_germ_over_punct_open (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (VT : D.Yt.left.ProEt) (jc : VT ⟶ Th) (hjc : IsOpenImmersion jc.left)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ) :
    ∀ z, (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj VT).hom z :
      ↥(Limits.pullback D.f (D.S i))) ∈ wcCritPunctOpen D i :=
by
  intro z

  have hsec : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hci : IsClosedImmersion (D.xs i) := isClosedImmersion_of_comp_eq_id _ _ hsec
  have hrange : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
    ext y
    constructor
    · rintro ⟨a, rfl⟩
      exact Set.mem_singleton_iff.mpr
        (congrArg (fun b => D.xs i b) (Subsingleton.elim a (IsLocalRing.closedPoint F'')))
    · intro hy
      exact ⟨_, (Set.mem_singleton_iff.mp hy).symm⟩
  have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
    rw [← hrange]
    exact (D.xs i).isClosedEmbedding.isClosed_range

  have hfib : ∀ w w' : ((wcProEtPullback D.f).obj V₀).left,
      ((wcProEtPullback D.f).obj V₀).hom w = D.xs i (IsLocalRing.closedPoint F'') →
      ((wcProEtPullback D.f).obj V₀).hom w' = D.xs i (IsLocalRing.closedPoint F'') →
      w = w' := by
    intro w w' hw hw'
    obtain ⟨p, hp, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w (IsLocalRing.closedPoint F'') hw
    obtain ⟨p', hp', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w' (IsLocalRing.closedPoint F'') hw'
    let E : Limits.pullback (Limits.pullback.snd V₀.hom D.f) (D.xs i) ≅
        Spec (.of (AlgebraicClosure F'')) :=
      Limits.pullbackLeftPullbackSndIso V₀.hom D.f (D.xs i) ≪≫
        Limits.pullback.congrHom rfl (D.hxs i) ≪≫ ε
    have hpp : p = p' := by
      calc p = E.inv (E.hom p) := (Scheme.hom_inv_apply E p).symm
        _ = E.inv (E.hom p') := by rw [Subsingleton.elim (E.hom p) (E.hom p')]
        _ = p' := Scheme.hom_inv_apply E p'
    rw [← hp, ← hp', hpp]

  rw [wcCritPunctOpen, Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_mk,
    Set.mem_compl_iff]
  intro hcl
  rw [hclosed.closure_eq, Set.mem_singleton_iff] at hcl
  have h2 : VT.hom (Limits.pullback.fst VT.hom (Limits.pullback.fst D.f (D.S i)) z) =
      Limits.pullback.fst D.f (D.S i)
        (Limits.pullback.snd VT.hom (Limits.pullback.fst D.f (D.S i)) z) := by
    have a := Scheme.Hom.comp_apply
      (Limits.pullback.fst VT.hom (Limits.pullback.fst D.f (D.S i))) VT.hom z
    have b := Scheme.Hom.comp_apply
      (Limits.pullback.snd VT.hom (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.fst D.f (D.S i)) z
    rw [Limits.pullback.condition] at a
    rw [← a, ← b]
  generalize Limits.pullback.fst VT.hom (Limits.pullback.fst D.f (D.S i)) z = z' at h2
  have h3 : VT.hom z' = D.xs i (IsLocalRing.closedPoint F'') := by
    rw [h2]
    exact hcl
  have h4 : ((wcProEtPullback D.f).obj V₀).hom (g.left (jc.left z')) =
      D.xs i (IsLocalRing.closedPoint F'') := by
    have a := Scheme.Hom.comp_apply g.left ((wcProEtPullback D.f).obj V₀).hom (jc.left z')
    have b := Scheme.Hom.comp_apply jc.left Th.hom z'
    rw [MorphismProperty.Over.w g] at a
    rw [MorphismProperty.Over.w jc] at b
    rw [← a, ← b]
    exact h3
  have h5 : g.left (jc.left z') = xb := hfib _ _ h4 hxb
  have h6 : jc.left z' ∈ g.left ⁻¹' {xb} := Set.mem_preimage.mpr (Set.mem_singleton_iff.mpr h5)
  rw [hpre] at h6
  have h7 : jc.left z' ∈ Set.range jc.left := ⟨z', rfl⟩
  rw [hrc] at h7
  exact h7 h6

theorem wc_mpq_germ_xs_fibre_points (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m)
    (V₀ : (wcP1Over F'').left.ProEt)
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (Xt E₀ : Scheme.{u}) (b : Xt ⟶ Limits.pullback D.f (D.S i)) (iE : E₀ ⟶ Xt)
    (hrangeE : ((b ⁻¹ᵁ wcCritPunctOpen D i : Xt.Opens) : Set Xt) = (Set.range iE)ᶜ) :
    ∀ u : ↥(Limits.pullback (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b),
      (Limits.pullback.snd (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b u ∈
          Set.range iE ↔
        eB.hom (Limits.pullback.fst Th.hom (Limits.pullback.fst D.f (D.S i))
          (Limits.pullback.fst (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b u)) =
          IsLocalRing.closedPoint B) :=
by

  have hsec : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hci : IsClosedImmersion (D.xs i) := isClosedImmersion_of_comp_eq_id _ _ hsec
  have hrange : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
    ext y
    constructor
    · rintro ⟨a, rfl⟩
      exact Set.mem_singleton_iff.mpr
        (congrArg (fun b => D.xs i b) (Subsingleton.elim a (IsLocalRing.closedPoint F'')))
    · intro hy
      exact ⟨_, (Set.mem_singleton_iff.mp hy).symm⟩
  have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
    rw [← hrange]
    exact (D.xs i).isClosedEmbedding.isClosed_range

  have hfib : ∀ w w' : ((wcProEtPullback D.f).obj V₀).left,
      ((wcProEtPullback D.f).obj V₀).hom w = D.xs i (IsLocalRing.closedPoint F'') →
      ((wcProEtPullback D.f).obj V₀).hom w' = D.xs i (IsLocalRing.closedPoint F'') →
      w = w' := by
    intro w w' hw hw'
    obtain ⟨p, hp, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w (IsLocalRing.closedPoint F'') hw
    obtain ⟨p', hp', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w' (IsLocalRing.closedPoint F'') hw'
    let E : Limits.pullback (Limits.pullback.snd V₀.hom D.f) (D.xs i) ≅
        Spec (.of (AlgebraicClosure F'')) :=
      Limits.pullbackLeftPullbackSndIso V₀.hom D.f (D.xs i) ≪≫
        Limits.pullback.congrHom rfl (D.hxs i) ≪≫ ε
    have hpp : p = p' := by
      calc p = E.inv (E.hom p) := (Scheme.hom_inv_apply E p).symm
        _ = E.inv (E.hom p') := by rw [Subsingleton.elim (E.hom p) (E.hom p')]
        _ = p' := Scheme.hom_inv_apply E p'
    rw [← hp, ← hp', hpp]

  have hO : ∀ z : ↥(Limits.pullback D.f (D.S i)), z ∈ wcCritPunctOpen D i ↔
      Limits.pullback.fst D.f (D.S i) z ≠ D.xs i (IsLocalRing.closedPoint F'') := by
    intro z
    rw [wcCritPunctOpen, Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_mk,
      Set.mem_compl_iff, hclosed.closure_eq, Set.mem_singleton_iff]
  have hmem : ∀ x : Xt, x ∈ Set.range iE ↔
      Limits.pullback.fst D.f (D.S i) (b x) = D.xs i (IsLocalRing.closedPoint F'') := by
    intro x
    have h := Set.ext_iff.mp hrangeE x
    rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, hO, Set.mem_compl_iff] at h
    exact (not_iff_not.mp h).symm

  have hfibB : ∀ t : Th.left, Th.hom t = D.xs i (IsLocalRing.closedPoint F'') ↔
      eB.hom t = IsLocalRing.closedPoint B := by
    intro t
    have a := Scheme.Hom.comp_apply g.left ((wcProEtPullback D.f).obj V₀).hom t
    rw [MorphismProperty.Over.w g] at a
    constructor
    · intro ht
      have h4 : ((wcProEtPullback D.f).obj V₀).hom (g.left t) =
          D.xs i (IsLocalRing.closedPoint F'') := by
        rw [← a]; exact ht
      have h5 : g.left t = xb := hfib _ _ h4 hxb
      have h6 : t ∈ g.left ⁻¹' {xb} := Set.mem_preimage.mpr (Set.mem_singleton_iff.mpr h5)
      rw [hpre, Set.mem_singleton_iff] at h6
      rw [h6]
      exact Scheme.inv_hom_apply eB _
    · intro ht
      have h6 : t = eB.inv (IsLocalRing.closedPoint B) := by
        rw [← ht]
        exact (Scheme.hom_inv_apply eB t).symm
      have h7 : t ∈ g.left ⁻¹' {xb} := by
        rw [hpre]
        exact Set.mem_singleton_iff.mpr h6
      have h5 : g.left t = xb := Set.mem_singleton_iff.mp (Set.mem_preimage.mp h7)
      rw [a, h5]
      exact hxb

  intro u
  have h1 : b (Limits.pullback.snd (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b u) =
      Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))
        (Limits.pullback.fst (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b u) := by
    have a := Scheme.Hom.comp_apply
      (Limits.pullback.fst (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b)
      (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) u
    have c := Scheme.Hom.comp_apply
      (Limits.pullback.snd (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b) b u
    rw [Limits.pullback.condition] at a
    rw [← a, ← c]
  have h2 : ∀ v : ↥(Limits.pullback Th.hom (Limits.pullback.fst D.f (D.S i))),
      Th.hom (Limits.pullback.fst Th.hom (Limits.pullback.fst D.f (D.S i)) v) =
      Limits.pullback.fst D.f (D.S i)
        (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i)) v) := by
    intro v
    have a := Scheme.Hom.comp_apply
      (Limits.pullback.fst Th.hom (Limits.pullback.fst D.f (D.S i))) Th.hom v
    have c := Scheme.Hom.comp_apply
      (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.fst D.f (D.S i)) v
    rw [Limits.pullback.condition] at a
    rw [← a, ← c]
  rw [hmem, h1, ← h2, hfibB]

theorem wc_mpq_germ_xs_fibre_frob (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀) (φh : Th ⟶ Th)
    (hφh : φh ≫ g = g ≫ (wcProEtPullback D.f).map φ₀)
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb))) :
    ∃ εT : Limits.pullback Th.hom (D.xs i) ≅ Spec (.of (AlgebraicClosure F'')),
      εT.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
        Limits.pullback.snd Th.hom (D.xs i) ∧
      εT.inv ≫ Limits.pullback.fst Th.hom (D.xs i) ≫ φh.left =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
          (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
            AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
          εT.inv ≫ Limits.pullback.fst Th.hom (D.xs i) :=
by

  have c2 : ∀ {P V Yt Z Wl Sl : Scheme.{u}}
      (v : V ⟶ P) (f : Yt ⟶ P) (S : Z ⟶ P) (x : Z ⟶ Yt) (_hx : x ≫ f = S)
      (σ : Sl ⟶ Z) (Fr : Sl ⟶ Sl) (_hFr : Fr ≫ σ = σ)
      (ε : Limits.pullback v S ≅ Sl) (_hε : ε.hom ≫ σ = Limits.pullback.snd v S)
      (φ : V ⟶ V)
      (_hεφ : ε.inv ≫ Limits.pullback.fst v S ≫ φ = Fr ≫ ε.inv ≫ Limits.pullback.fst v S)
      (wv : Wl ⟶ V) (wh : Wl ⟶ Yt) (_hW : IsPullback wv wh v f)
      (φW : Wl ⟶ Wl) (_hφW1 : φW ≫ wv = wv ≫ φ) (_hφW2 : φW ≫ wh = wh),
      ∃ εQ : Limits.pullback wh x ≅ Sl,
        εQ.hom ≫ σ = Limits.pullback.snd wh x ∧
        εQ.inv ≫ Limits.pullback.fst wh x ≫ φW = Fr ≫ εQ.inv ≫ Limits.pullback.fst wh x := by
    intro P V Yt Z Wl Sl v f S x hx σ Fr hFr ε hε φ hεφ wv wh hW φW hφW1 hφW2
    have hA : (Limits.pullback.fst wh x ≫ wv) ≫ v = Limits.pullback.snd wh x ≫ S := by
      rw [Category.assoc, hW.w, ← hx, Limits.pullback.condition_assoc]
    let A : Limits.pullback wh x ⟶ Limits.pullback v S :=
      Limits.pullback.lift (Limits.pullback.fst wh x ≫ wv) (Limits.pullback.snd wh x) hA
    have Af : A ≫ Limits.pullback.fst v S = Limits.pullback.fst wh x ≫ wv :=
      Limits.pullback.lift_fst _ _ _
    have As : A ≫ Limits.pullback.snd v S = Limits.pullback.snd wh x :=
      Limits.pullback.lift_snd _ _ _
    have hl : Limits.pullback.fst v S ≫ v = (Limits.pullback.snd v S ≫ x) ≫ f := by
      rw [Category.assoc, hx]; exact Limits.pullback.condition
    let l : Limits.pullback v S ⟶ Wl := hW.lift _ _ hl
    have lv : l ≫ wv = Limits.pullback.fst v S := hW.lift_fst _ _ _
    have lh : l ≫ wh = Limits.pullback.snd v S ≫ x := hW.lift_snd _ _ _
    let B : Limits.pullback v S ⟶ Limits.pullback wh x :=
      Limits.pullback.lift l (Limits.pullback.snd v S) lh
    have Bf : B ≫ Limits.pullback.fst wh x = l := Limits.pullback.lift_fst _ _ _
    have Bs : B ≫ Limits.pullback.snd wh x = Limits.pullback.snd v S :=
      Limits.pullback.lift_snd _ _ _
    have AB : A ≫ B = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Bf, Category.id_comp]
        apply hW.hom_ext
        · rw [Category.assoc, lv, Af]
        · rw [Category.assoc, lh, ← Category.assoc, As, Limits.pullback.condition]
      · rw [Category.assoc, Bs, As, Category.id_comp]
    have BA : B ≫ A = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Af, ← Category.assoc, Bf, lv, Category.id_comp]
      · rw [Category.assoc, As, Bs, Category.id_comp]
    have e1 : ∀ {Z' : Scheme.{u}} (h : Z ⟶ Z'), ε.inv ≫ Limits.pullback.snd v S ≫ h = σ ≫ h := by
      intro Z' h
      rw [← hε, Category.assoc, Iso.inv_hom_id_assoc]
    have hFr' : ∀ {Z' : Scheme.{u}} (h : Z ⟶ Z'), Fr ≫ σ ≫ h = σ ≫ h := by
      intro Z' h
      rw [← Category.assoc, hFr]
    have Bf' : ∀ {Z' : Scheme.{u}} (h : Wl ⟶ Z'), B ≫ Limits.pullback.fst wh x ≫ h = l ≫ h := by
      intro Z' h
      rw [← Category.assoc, Bf]
    have Bs' : ∀ {Z' : Scheme.{u}} (h : Z ⟶ Z'),
        B ≫ Limits.pullback.snd wh x ≫ h = Limits.pullback.snd v S ≫ h := by
      intro Z' h
      rw [← Category.assoc, Bs]
    have lv' : ∀ {Z' : Scheme.{u}} (h : V ⟶ Z'), l ≫ wv ≫ h = Limits.pullback.fst v S ≫ h := by
      intro Z' h
      rw [← Category.assoc, lv]
    refine ⟨Iso.mk A B AB BA ≪≫ ε, ?_, ?_⟩
    · show (A ≫ ε.hom) ≫ σ = _
      rw [Category.assoc, hε, As]
    · show (ε.inv ≫ B) ≫ Limits.pullback.fst wh x ≫ φW =
        Fr ≫ (ε.inv ≫ B) ≫ Limits.pullback.fst wh x
      apply hW.hom_ext
      · simp only [Category.assoc, hφW1, Bf', lv', lv]
        exact hεφ
      · simp only [Category.assoc, hφW2, Limits.pullback.condition_assoc, Bs', e1, hFr',
          Limits.pullback.condition]

  have c3 : ∀ {Wl Yt Z : Scheme.{u}} (L : Type u) [Field L]
      (wh : Wl ⟶ Yt) (x : Z ⟶ Yt) (εQ : Limits.pullback wh x ≅ Spec (.of L))
      (w₀ : Wl) (z₀ : Z) (_hw₀ : wh w₀ = x z₀),
      ∃ β : Limits.pullback wh x ⟶ Spec (Wl.residueField w₀),
        β ≫ Wl.fromSpecResidueField w₀ = Limits.pullback.fst wh x := by
    intro Wl Yt Z L _ wh x εQ w₀ z₀ hw₀
    obtain ⟨q₀, hq₀, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := wh) (g := x) w₀ z₀ hw₀
    have hpt : ∀ z : Spec (.of L), z = IsLocalRing.closedPoint L := fun z =>
      @Subsingleton.elim (PrimeSpectrum L) _ _ _
    have hq : εQ.inv (εQ.hom q₀) = q₀ := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
    have hinv : εQ.inv (IsLocalRing.closedPoint L) = q₀ := by
      rw [← hpt (εQ.hom q₀)]
      exact hq
    have h : (εQ.inv ≫ Limits.pullback.fst wh x) (IsLocalRing.closedPoint L) = w₀ :=
      (Scheme.Hom.comp_apply _ _ _).trans ((congrArg (Limits.pullback.fst wh x) hinv).trans hq₀)
    subst h
    exact ⟨εQ.hom ≫ Spec.map (Scheme.descResidueField
      (Scheme.stalkClosedPointTo (εQ.inv ≫ Limits.pullback.fst wh x))),
      (Category.assoc _ _ _).trans ((congrArg (εQ.hom ≫ ·)
        (Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField L Wl
          (εQ.inv ≫ Limits.pullback.fst wh x))).trans (Iso.hom_inv_id_assoc _ _))⟩

  have c1 : ∀ {T Wl Yt Z R Sl : Scheme.{u}}
      (th : T ⟶ Yt) (wh : Wl ⟶ Yt) (x : Z ⟶ Yt) (g : T ⟶ Wl) (_hg : g ≫ wh = th)
      (r : R ⟶ Wl) (_hfib : IsIso (Limits.pullback.snd g r))
      (β : Limits.pullback wh x ⟶ R) (_hβ : β ≫ r = Limits.pullback.fst wh x)
      (φT : T ⟶ T) (φW : Wl ⟶ Wl) (_hφg : φT ≫ g = g ≫ φW)
      (εQ : Limits.pullback wh x ≅ Sl) (σ : Sl ⟶ Z) (Fr : Sl ⟶ Sl)
      (_hεQ : εQ.hom ≫ σ = Limits.pullback.snd wh x)
      (_hεQφ : εQ.inv ≫ Limits.pullback.fst wh x ≫ φW = Fr ≫ εQ.inv ≫ Limits.pullback.fst wh x),
      ∃ εT : Limits.pullback th x ≅ Sl,
        εT.hom ≫ σ = Limits.pullback.snd th x ∧
        εT.inv ≫ Limits.pullback.fst th x ≫ φT = Fr ≫ εT.inv ≫ Limits.pullback.fst th x := by
    intro T Wl Yt Z R Sl th wh x g hg r hfib β hβ φT φW hφg εQ σ Fr hεQ hεQφ
    subst hg
    haveI := hfib
    have U : ∀ {X : Scheme.{u}} (h : X ⟶ T) (k : X ⟶ R), h ≫ g = k ≫ r →
        h = k ≫ inv (Limits.pullback.snd g r) ≫ Limits.pullback.fst g r := by
      intro X h k w
      have h1 : Limits.pullback.lift h k w ≫ Limits.pullback.snd g r = k :=
        Limits.pullback.lift_snd _ _ _
      have h2 : Limits.pullback.lift h k w = k ≫ inv (Limits.pullback.snd g r) :=
        (IsIso.eq_comp_inv _).mpr h1
      rw [← Category.assoc, ← h2, Limits.pullback.lift_fst]
    have hΓ : (Limits.pullback.fst (g ≫ wh) x ≫ g) ≫ wh = Limits.pullback.snd (g ≫ wh) x ≫ x := by
      rw [Category.assoc]; exact Limits.pullback.condition
    let Γ : Limits.pullback (g ≫ wh) x ⟶ Limits.pullback wh x :=
      Limits.pullback.lift _ _ hΓ
    have Γf : Γ ≫ Limits.pullback.fst wh x = Limits.pullback.fst (g ≫ wh) x ≫ g :=
      Limits.pullback.lift_fst _ _ _
    have Γs : Γ ≫ Limits.pullback.snd wh x = Limits.pullback.snd (g ≫ wh) x :=
      Limits.pullback.lift_snd _ _ _
    have hτr : inv (Limits.pullback.snd g r) ≫ Limits.pullback.fst g r ≫ g = r := by
      rw [Limits.pullback.condition, IsIso.inv_hom_id_assoc]
    have D1' : (β ≫ inv (Limits.pullback.snd g r) ≫ Limits.pullback.fst g r) ≫ g =
        Limits.pullback.fst wh x := by
      rw [Category.assoc, Category.assoc, hτr, hβ]
    have hΔ : (β ≫ inv (Limits.pullback.snd g r) ≫ Limits.pullback.fst g r) ≫ g ≫ wh =
        Limits.pullback.snd wh x ≫ x := by
      rw [← Category.assoc, D1', Limits.pullback.condition]
    let Δ : Limits.pullback wh x ⟶ Limits.pullback (g ≫ wh) x :=
      Limits.pullback.lift _ _ hΔ
    have Δf : Δ ≫ Limits.pullback.fst (g ≫ wh) x =
        β ≫ inv (Limits.pullback.snd g r) ≫ Limits.pullback.fst g r :=
      Limits.pullback.lift_fst _ _ _
    have Δs : Δ ≫ Limits.pullback.snd (g ≫ wh) x = Limits.pullback.snd wh x :=
      Limits.pullback.lift_snd _ _ _
    have D1 : Δ ≫ Limits.pullback.fst (g ≫ wh) x ≫ g = Limits.pullback.fst wh x := by
      rw [← Category.assoc, Δf, D1']
    have D1a : ∀ {Z' : Scheme.{u}} (h : Wl ⟶ Z'),
        Δ ≫ Limits.pullback.fst (g ≫ wh) x ≫ g ≫ h = Limits.pullback.fst wh x ≫ h := by
      intro Z' h
      rw [← D1]
      simp only [Category.assoc]
    have hβa : ∀ {Z' : Scheme.{u}} (h : Wl ⟶ Z'), β ≫ r ≫ h = Limits.pullback.fst wh x ≫ h := by
      intro Z' h
      rw [← hβ, Category.assoc]
    have ΔΓ : Δ ≫ Γ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Γf, D1, Category.id_comp]
      · rw [Category.assoc, Γs, Δs, Category.id_comp]
    have ΓΔ : Γ ≫ Δ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Δf, Category.id_comp]
        have hU : Limits.pullback.fst (g ≫ wh) x ≫ g = (Γ ≫ β) ≫ r := by
          rw [Category.assoc, hβ, Γf]
        exact ((U _ _ hU).trans (Category.assoc _ _ _)).symm
      · rw [Category.assoc, Δs, Γs, Category.id_comp]
    refine ⟨Iso.mk Γ Δ ΓΔ ΔΓ ≪≫ εQ, ?_, ?_⟩
    · show (Γ ≫ εQ.hom) ≫ σ = _
      rw [Category.assoc, hεQ, Γs]
    · show (εQ.inv ≫ Δ) ≫ Limits.pullback.fst (g ≫ wh) x ≫ φT =
        Fr ≫ (εQ.inv ≫ Δ) ≫ Limits.pullback.fst (g ≫ wh) x
      have ha : ((εQ.inv ≫ Δ) ≫ Limits.pullback.fst (g ≫ wh) x ≫ φT) ≫ g =
          (Fr ≫ εQ.inv ≫ β) ≫ r := by
        simp only [Category.assoc, hφg, D1a, hβ]
        exact hεQφ
      have hb : (Fr ≫ (εQ.inv ≫ Δ) ≫ Limits.pullback.fst (g ≫ wh) x) ≫ g =
          (Fr ≫ εQ.inv ≫ β) ≫ r := by
        simp only [Category.assoc, D1, hβ]
      rw [U _ _ ha, U _ _ hb]

  have hFr : Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    rw [← Spec.map_comp]
    congr 1
    ext a
    exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _ (Fintype.ofFinite F'')
      (AlgebraicClosure F'') _ _ _).symm.commutes a)
  have hW : IsPullback (Limits.pullback.fst V₀.hom D.f :
      ((wcProEtPullback D.f).obj V₀).left ⟶ V₀.left) ((wcProEtPullback D.f).obj V₀).hom
      V₀.hom D.f :=
    IsPullback.of_hasPullback V₀.hom D.f
  have hφW1 : ((wcProEtPullback D.f).map φ₀).left ≫
      (Limits.pullback.fst V₀.hom D.f : ((wcProEtPullback D.f).obj V₀).left ⟶ V₀.left) =
      Limits.pullback.fst V₀.hom D.f ≫ φ₀.left :=
    Limits.pullback.lift_fst _ _ _
  have hφW2 : ((wcProEtPullback D.f).map φ₀).left ≫ ((wcProEtPullback D.f).obj V₀).hom =
      ((wcProEtPullback D.f).obj V₀).hom :=
    MorphismProperty.Over.w _
  obtain ⟨εQ, hεQ, hεQφ⟩ := c2 V₀.hom D.f (D.S i) (D.xs i) (D.hxs i) _ _ hFr ε hε φ₀.left hεφ
    _ _ hW _ hφW1 hφW2
  obtain ⟨β, hβ⟩ := c3 (AlgebraicClosure F'') _ (D.xs i) εQ xb (IsLocalRing.closedPoint F'') hxb
  have hg : g.left ≫ ((wcProEtPullback D.f).obj V₀).hom = Th.hom := MorphismProperty.Over.w g
  have hφg : φh.left ≫ g.left = g.left ≫ ((wcProEtPullback D.f).map φ₀).left := by
    first
      | exact congrArg (fun k => k.left) hφh
      | simpa using congrArg (fun k => k.left) hφh
  exact c1 Th.hom _ (D.xs i) g.left hg _ hfib β hβ φh.left _ hφg εQ _ _ hεQ hεQφ

theorem wc_mpq_exc_factor_xs (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m)
    (E₀ : Over (Spec (.of F''))) (hsm : SmoothOfRelativeDimension (n - 2) E₀.hom)
    (Xt : Over (Spec (.of F''))) (b : Xt.left ⟶ Limits.pullback D.f (D.S i))
    (iE : E₀.left ⟶ Xt.left) (hbX : b ≫ Limits.pullback.snd D.f (D.S i) = Xt.hom)
    (hiEX : iE ≫ Xt.hom = E₀.hom)
    (hrangeE : ((b ⁻¹ᵁ wcCritPunctOpen D i : Xt.left.Opens) : Set Xt.left) = (Set.range iE)ᶜ) :
    iE ≫ b ≫ Limits.pullback.fst D.f (D.S i) = E₀.hom ≫ D.xs i :=
by
  haveI hred : IsReduced E₀.left := wcpa_dj_sst_smooth_reduced E₀.hom (n - 2) hsm
  have hsec : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  haveI hci : IsClosedImmersion (D.xs i) :=
    isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i) hsec
  have hclosed : IsClosed (Set.range (D.xs i)) :=
    (D.xs i).isClosedEmbedding.isClosed_range
  have hcl : closure {D.xs i (IsLocalRing.closedPoint F'')} ⊆ Set.range (D.xs i) :=
    closure_minimal (Set.singleton_subset_iff.mpr ⟨_, rfl⟩) hclosed
  have hrange : Set.range (iE ≫ b ≫ Limits.pullback.fst D.f (D.S i)) ⊆ Set.range (D.xs i) := by
    rintro _ ⟨e, rfl⟩
    apply hcl
    have h1 : iE e ∉ ((b ⁻¹ᵁ wcCritPunctOpen D i : Xt.left.Opens) : Set Xt.left) := by
      rw [hrangeE]
      exact fun h => h ⟨e, rfl⟩
    have h2 : b (iE e) ∉ wcCritPunctOpen D i := fun h => h1 h
    have h3 : Limits.pullback.fst D.f (D.S i) (b (iE e)) ∉
        (closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ := fun h => h2 h
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    simpa using h3
  obtain ⟨h, hh⟩ := wc_ap_reduced_factor_closed_immersion E₀.left (Spec (.of F'')) D.Yt.left
    (iE ≫ b ≫ Limits.pullback.fst D.f (D.S i)) (D.xs i) hrange
  have key : h ≫ D.xs i ≫ D.Yt.hom = E₀.hom := by
    rw [← Category.assoc, hh, ← D.hf]
    simp only [Category.assoc]
    rw [Limits.pullback.condition_assoc, D.hS i, Category.comp_id, hbX, hiEX]
  rw [hsec, Category.comp_id] at key
  rw [← hh, key]

theorem wc_mpq_closed_fibre_res_bij {Xt E : Scheme.{u}} (iE : E ⟶ Xt) [IsClosedImmersion iE]
    (L : Sheaf (Scheme.ProEt.topology Xt) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush iE)
    (θ : ∀ V : Xt.ProEt, L.obj (wcFreeSheaf Xt V) ≅ wcFreeSheaf E ((wcProEtPullback iE).obj V))
    (U : Xt.ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (fU : U.left ⟶ Spec (.of B)) [IsProper fU]
    (hfib : ∀ u : U.left, U.hom u ∈ Set.range iE ↔ fU u = IsLocalRing.closedPoint B)
    (K : Type u) [Field K] [IsAlgClosed K]
    (pP : Limits.pullback U.hom iE ⟶ Spec (.of K)) [IsProper pP]
    [IsReduced (Limits.pullback U.hom iE)]
    (m : ℕ) (hm : 0 < m) (hmK : (m : K) ≠ 0) (j : ℕ) :
    Function.Bijective (wcProEtRes iE L adj θ (ZMod m) U j) :=
by
  classical
  haveI hcB : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue B))
      IsLocalRing.residue_surjective
  have hcBpt : ∀ x : Spec (.of (IsLocalRing.ResidueField B)),
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) x = IsLocalRing.closedPoint B := by
    intro x
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue B))) := by
      rw [CommRingCat.hom_ofHom]; infer_instance
    have hx : x = IsLocalRing.closedPoint (IsLocalRing.ResidueField B) := Subsingleton.elim _ _
    rw [hx]
    exact Spec_closedPoint (f := CommRingCat.ofHom (IsLocalRing.residue B))
  have hsub : Set.range (Limits.pullback.fst U.hom iE ≫ fU) ⊆
      Set.range (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) := by
    rintro _ ⟨z, rfl⟩
    refine ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField B), (hcBpt _).trans ?_⟩
    rw [Scheme.Hom.comp_apply]
    symm
    apply (hfib _).mp
    refine ⟨Limits.pullback.snd U.hom iE z, ?_⟩
    have h2 : (Limits.pullback.fst U.hom iE ≫ U.hom) z =
        (Limits.pullback.snd U.hom iE ≫ iE) z := by rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h2
    exact h2.symm
  obtain ⟨a, ha⟩ := wc_ap_reduced_factor_closed_immersion _ _ _
    (Limits.pullback.fst U.hom iE ≫ fU) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) hsub
  let ρ : Limits.pullback U.hom iE ⟶
      Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) :=
    Limits.pullback.lift (Limits.pullback.fst U.hom iE) a ha.symm
  have hρ : ρ ≫ Limits.pullback.fst fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) =
      Limits.pullback.fst U.hom iE :=
    Limits.pullback.lift_fst _ _ _
  haveI hρci : IsClosedImmersion ρ := by
    haveI : IsClosedImmersion
        (ρ ≫ Limits.pullback.fst fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))) := by
      rw [hρ]; infer_instance
    exact IsClosedImmersion.of_comp_isClosedImmersion ρ
      (Limits.pullback.fst fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))))
  have hρsurj : Set.range ρ = Set.univ := by
    refine Set.eq_univ_iff_forall.mpr fun z₀ => ?_
    have hy : fU (Limits.pullback.fst fU
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z₀) =
        IsLocalRing.closedPoint B := by
      have h2 : (Limits.pullback.fst fU
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ fU) z₀ =
          (Limits.pullback.snd fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫
            Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z₀ := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h2
      rw [h2, hcBpt]
    obtain ⟨e, he⟩ := (hfib _).mpr hy
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := U.hom) (g := iE)
      (Limits.pullback.fst fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z₀) e he.symm
    refine ⟨z, ?_⟩
    apply (Limits.pullback.fst fU
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))).isClosedEmbedding.isEmbedding.injective
    show (Limits.pullback.fst fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))) (ρ z) = _
    rw [← Scheme.Hom.comp_apply, hρ, hz1]

  have hfinP : Finite (wcEtCoh (Limits.pullback U.hom iE) m j) :=
    wc_etale_proper_finite K _ pP m hmK j
  obtain ⟨Eρ⟩ := wc_et_zmod_pull_data_exists ρ m
  have hρinj := wc_et_pull_surj_closed_immersion_injective ρ hρsurj m Eρ j
  have hcard : Nat.card (wcEtCoh (Limits.pullback U.hom iE) m j) =
      Nat.card (wcEtCoh (Limits.pullback fU
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))) m j) := by
    have h1 := wc_et_fibre_coh_reduced_invariance _ _ _ _
      (𝟙 (Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))))) ρ hρsurj
      (𝟙 (Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))))) m j
    obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
      (ρ ≫ 𝟙 (Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))))
      (𝟙 (Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))))) m j
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
      (𝟙 (Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))))
      (𝟙 (Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))))) m j
    rw [Nat.card_congr e1, Nat.card_congr e2]
    exact h1
  obtain ⟨eP⟩ := wc_et_zmodext_coh_equiv (Limits.pullback U.hom iE) m j
  obtain ⟨eZ⟩ := wc_et_zmodext_coh_equiv
    (Limits.pullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))) m j
  haveI : Finite (wcEtZModExt (Limits.pullback U.hom iE) m j) := (Equiv.finite_iff eP).mpr hfinP
  have hρb : Function.Bijective (wcEtPull Eρ j) := by
    refine hρinj.bijective_of_nat_card_le ?_
    rw [Nat.card_congr eP, Nat.card_congr eZ, hcard]

  obtain ⟨E0⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))) m
  have hE0 := wc_r2gs_hens_closed_fibre_pull_bij B U.left fU m hm.ne'
    wc_et_henselian_proper_vanishing _
    (Limits.pullback.fst fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))))
    (Limits.pullback.snd fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))))
    (IsPullback.of_hasPullback fU (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))) E0 j

  obtain ⟨Ep⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst U.hom iE) m
  have hcomp : ⇑(wcEtPull Ep j) = ⇑(wcEtPull Eρ j) ∘ ⇑(wcEtPull E0 j) := by
    funext x
    exact wc_et_pull_comp _ ρ _ hρ E0 Eρ Ep j x
  have hbij : Function.Bijective (wcEtPull Ep j) := by
    rw [hcomp]; exact hρb.comp hE0

  haveI : CompactSpace U.left := QuasiCompact.compactSpace_of_compactSpace fU
  haveI : QuasiSeparatedSpace U.left := quasiSeparatedSpace_of_quasiSeparated fU
  haveI : CompactSpace ↥((𝟭 Scheme.{u}).obj U.left) := QuasiCompact.compactSpace_of_compactSpace fU
  haveI : QuasiSeparatedSpace ↥((𝟭 Scheme.{u}).obj U.left) :=
    quasiSeparatedSpace_of_quasiSeparated fU
  haveI : IsProper (Limits.pullback.fst U.hom iE ≫ fU) := inferInstance
  haveI : CompactSpace ↥(Limits.pullback U.hom iE : Scheme.{u}) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst U.hom iE ≫ fU)
  haveI : QuasiSeparatedSpace ↥(Limits.pullback U.hom iE : Scheme.{u}) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst U.hom iE ≫ fU)
  obtain ⟨D, hD⟩ := wc_zmod_pull_data_exists (Limits.pullback.fst U.hom iE) m
  have hz := wc_zmod_proet_pull_bij_of_et_pull_bij (Limits.pullback.fst U.hom iE) m hm D hD Ep j hbij
  exact wc_proet_res_bij_of_zmod_pull_bij iE L adj θ U m hm D hD j hz

theorem wc_mpq_exc_geom_point_iso (K : Type u) [Field K] [Finite K] {Yt X Xt : Scheme.{u}}
    (Th : Yt.ProEt) (φh : Th ⟶ Th) (ι : X ⟶ Yt) (b : Xt ⟶ X)
    (E₀ : Over (Spec (.of K))) (iE : E₀.left ⟶ Xt)
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (xs : Spec (.of K) ⟶ Yt) (hfac : iE ≫ b ≫ ι = E₀.hom ≫ xs)
    (εT : Limits.pullback Th.hom xs ≅ Spec (.of (AlgebraicClosure K)))
    (hεT : εT.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
      Limits.pullback.snd Th.hom xs)
    (hεTφ : εT.inv ≫ Limits.pullback.fst Th.hom xs ≫ φh.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
        (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
          AlgebraicClosure K →+* AlgebraicClosure K)) ≫
        εT.inv ≫ Limits.pullback.fst Th.hom xs) :
    ∃ κ : wcGeomPoint K E₀ hE ≅
        (wcProEtPullback iE).obj ((wcProEtPullback b).obj ((wcProEtPullback ι).obj Th)),
      κ.hom ≫ (wcProEtPullback iE).map ((wcProEtPullback b).map ((wcProEtPullback ι).map φh)) =
        wcGeomFrob K E₀ hE ≫ κ.hom :=
by
  classical
  have helper : ∀ {A B C D E : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ C) (c : A ⟶ D) (d : D ⟶ C)
      (e : C ⟶ E) (r : D ⟶ E), a ≫ b = c ≫ d → d ≫ e = r → a ≫ b ≫ e = c ≫ r := by
    intro A B C D E a b c d e r h1 h2
    rw [← Category.assoc, h1, Category.assoc, h2]

  have s1 : ∀ {T Yt X Xt E Bs S UT Tt P G Z : Scheme.{u}}
      (tT : T ⟶ Yt) (ι : X ⟶ Yt) (b : Xt ⟶ X) (iE : E ⟶ Xt)
      (eK : E ⟶ Bs) (xs : Bs ⟶ Yt) (σ : S ⟶ Bs)
      (fU : UT ⟶ T) (sU : UT ⟶ X) (hU : IsPullback fU sU tT ι)
      (fT : Tt ⟶ UT) (sT : Tt ⟶ Xt) (hT : IsPullback fT sT sU b)
      (p : P ⟶ Tt) (qE : P ⟶ E) (hP : IsPullback p qE sT iE)
      (fG : G ⟶ T) (sG : G ⟶ Bs) (hG : IsPullback fG sG tT xs)
      (zE : Z ⟶ E) (zS : Z ⟶ S) (hZ : IsPullback zE zS eK σ)
      (hfac : iE ≫ b ≫ ι = eK ≫ xs) (εT : G ≅ S) (hεT : εT.hom ≫ σ = sG),
      ∃ κ₀ : Z ≅ P, κ₀.hom ≫ qE = zE ∧ κ₀.hom ≫ p ≫ fT ≫ fU = zS ≫ εT.inv ≫ fG := by
    intro T Yt X Xt E Bs S UT Tt P G Z tT ι b iE eK xs σ fU sU hU fT sT hT p qE hP fG sG hG
      zE zS hZ hfac εT hεT
    have CU : fU ≫ tT = sU ≫ ι := hU.w
    have CT : fT ≫ sU = sT ≫ b := hT.w
    have CP : p ≫ sT = qE ≫ iE := hP.w
    have CG : fG ≫ tT = sG ≫ xs := hG.w
    have CZ : zE ≫ eK = zS ≫ σ := hZ.w
    have w1 : (zS ≫ εT.inv ≫ fG) ≫ tT = (zE ≫ iE ≫ b) ≫ ι := by
      simp only [Category.assoc]
      rw [CG, hfac, ← hεT]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
      rw [← Category.assoc zE, CZ, Category.assoc]
    obtain ⟨uU, huU1, huU2⟩ : ∃ uU : Z ⟶ UT,
        uU ≫ fU = zS ≫ εT.inv ≫ fG ∧ uU ≫ sU = zE ≫ iE ≫ b :=
      ⟨hU.lift _ _ w1, hU.lift_fst _ _ _, hU.lift_snd _ _ _⟩
    have w2 : uU ≫ sU = (zE ≫ iE) ≫ b := by rw [huU2, Category.assoc]
    obtain ⟨uT, huT1, huT2⟩ : ∃ uT : Z ⟶ Tt, uT ≫ fT = uU ∧ uT ≫ sT = zE ≫ iE :=
      ⟨hT.lift _ _ w2, hT.lift_fst _ _ _, hT.lift_snd _ _ _⟩
    obtain ⟨κh, hκ1, hκ2⟩ : ∃ κh : Z ⟶ P, κh ≫ p = uT ∧ κh ≫ qE = zE :=
      ⟨hP.lift _ _ huT2, hP.lift_fst _ _ _, hP.lift_snd _ _ _⟩
    have w4 : (p ≫ fT ≫ fU) ≫ tT = (qE ≫ eK) ≫ xs := by
      simp only [Category.assoc]
      rw [CU, ← Category.assoc fT, CT, Category.assoc, ← Category.assoc p, CP, Category.assoc,
        hfac]
    obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : P ⟶ G, gP ≫ fG = p ≫ fT ≫ fU ∧ gP ≫ sG = qE ≫ eK :=
      ⟨hG.lift _ _ w4, hG.lift_fst _ _ _, hG.lift_snd _ _ _⟩
    have w5 : qE ≫ eK = (gP ≫ εT.hom) ≫ σ := by rw [Category.assoc, hεT, hgP2]
    obtain ⟨lh, hl1, hl2⟩ : ∃ lh : P ⟶ Z, lh ≫ zE = qE ∧ lh ≫ zS = gP ≫ εT.hom :=
      ⟨hZ.lift _ _ w5, hZ.lift_fst _ _ _, hZ.lift_snd _ _ _⟩
    have hκg : κh ≫ gP = zS ≫ εT.inv := by
      apply hG.hom_ext
      · rw [Category.assoc, hgP1, ← Category.assoc κh, hκ1, ← Category.assoc uT, huT1, huU1,
          Category.assoc]
      · rw [Category.assoc, hgP2, ← Category.assoc κh, hκ2, CZ, Category.assoc, ← hεT,
          Iso.inv_hom_id_assoc]
    have hc : κh ≫ lh = 𝟙 Z := by
      apply hZ.hom_ext
      · rw [Category.assoc, hl1, hκ2, Category.id_comp]
      · rw [Category.assoc, hl2, ← Category.assoc κh, hκg, Category.assoc, Iso.inv_hom_id,
          Category.comp_id, Category.id_comp]
    have hd : lh ≫ κh = 𝟙 P := by
      apply hP.hom_ext
      · rw [Category.assoc, hκ1, Category.id_comp]
        apply hT.hom_ext
        · rw [Category.assoc, huT1]
          apply hU.hom_ext
          · rw [Category.assoc, huU1, ← Category.assoc lh, hl2, Category.assoc,
              Iso.hom_inv_id_assoc, hgP1, Category.assoc]
          · rw [Category.assoc, huU2, ← Category.assoc lh, hl1, Category.assoc, CT,
              ← Category.assoc p, CP, Category.assoc]
        · rw [Category.assoc, huT2, ← Category.assoc lh, hl1, CP]
      · rw [Category.assoc, hκ2, hl1, Category.id_comp]
    refine ⟨⟨κh, lh, hc, hd⟩, hκ2, ?_⟩
    show κh ≫ p ≫ fT ≫ fU = zS ≫ εT.inv ≫ fG
    rw [← Category.assoc κh, hκ1, ← Category.assoc uT, huT1, huU1]

  have s2 : ∀ {T Yt X Xt E UT Tt P Z : Scheme.{u}}
      (tT : T ⟶ Yt) (ι : X ⟶ Yt) (b : Xt ⟶ X) (iE : E ⟶ Xt)
      (fU : UT ⟶ T) (sU : UT ⟶ X) (hU : IsPullback fU sU tT ι)
      (fT : Tt ⟶ UT) (sT : Tt ⟶ Xt) (hT : IsPullback fT sT sU b)
      (p : P ⟶ Tt) (qE : P ⟶ E) (hP : IsPullback p qE sT iE)
      (φT : T ⟶ T) (prE : Z ⟶ E) (th : Z ⟶ T) (k : Z ⟶ P)
      (hk1 : k ≫ qE = prE) (hk2 : k ≫ p ≫ fT ≫ fU = th)
      (M : P ⟶ P) (hM1 : M ≫ qE = qE) (hM2 : M ≫ p ≫ sT = p ≫ sT)
      (hM3 : M ≫ p ≫ fT ≫ fU = p ≫ fT ≫ fU ≫ φT)
      (N : Z ⟶ Z) (hN1 : N ≫ prE = prE) (hN2 : N ≫ th = th ≫ φT),
      k ≫ M = N ≫ k := by
    intro T Yt X Xt E UT Tt P Z tT ι b iE fU sU hU fT sT hT p qE hP φT prE th k hk1 hk2 M hM1
      hM2 hM3 N hN1 hN2
    have CT : fT ≫ sU = sT ≫ b := hT.w
    have CP : p ≫ sT = qE ≫ iE := hP.w
    have e1 : k ≫ p ≫ sT = prE ≫ iE := by rw [CP, ← Category.assoc, hk1]
    apply hP.hom_ext
    · simp only [Category.assoc]
      apply hT.hom_ext
      · simp only [Category.assoc]
        apply hU.hom_ext
        · simp only [Category.assoc]
          rw [hM3, reassoc_of% hk2, hk2, hN2]
        · simp only [Category.assoc]
          rw [CT, reassoc_of% hM2, reassoc_of% e1, reassoc_of% hN1]
      · simp only [Category.assoc]
        rw [hM2, e1, reassoc_of% hN1]
    · simp only [Category.assoc]
      rw [hM1, hk1, hN1]

  obtain ⟨κ₀, hk1, hk2⟩ := s1 Th.hom ι b iE E₀.hom xs
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    _ _ (IsPullback.of_hasPullback Th.hom ι)
    _ _ (IsPullback.of_hasPullback (Limits.pullback.snd Th.hom ι) b)
    _ _ (IsPullback.of_hasPullback
      (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE)
    _ _ (IsPullback.of_hasPullback Th.hom xs)
    _ _ (IsPullback.of_hasPullback E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    hfac εT hεT

  have hφ1a : ((wcProEtPullback ι).map φh).left ≫ Limits.pullback.fst Th.hom ι =
      Limits.pullback.fst Th.hom ι ≫ φh.left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (unfold wcProEtPullback; rw [MorphismProperty.Over.pullback_map_left];
         exact Limits.pullback.lift_fst _ _ _)
  have hφ1b : ((wcProEtPullback ι).map φh).left ≫ Limits.pullback.snd Th.hom ι =
      Limits.pullback.snd Th.hom ι := by
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (unfold wcProEtPullback; rw [MorphismProperty.Over.pullback_map_left];
         exact Limits.pullback.lift_snd _ _ _)
  have hφ2a : ((wcProEtPullback b).map ((wcProEtPullback ι).map φh)).left ≫
      Limits.pullback.fst (Limits.pullback.snd Th.hom ι) b =
      Limits.pullback.fst (Limits.pullback.snd Th.hom ι) b ≫ ((wcProEtPullback ι).map φh).left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (unfold wcProEtPullback; rw [MorphismProperty.Over.pullback_map_left];
         exact Limits.pullback.lift_fst _ _ _)
  have hφ2b : ((wcProEtPullback b).map ((wcProEtPullback ι).map φh)).left ≫
      Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b =
      Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b := by
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (unfold wcProEtPullback; rw [MorphismProperty.Over.pullback_map_left];
         exact Limits.pullback.lift_snd _ _ _)
  have hφ3a : ((wcProEtPullback iE).map ((wcProEtPullback b).map
        ((wcProEtPullback ι).map φh))).left ≫
      Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE =
      Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE ≫
        ((wcProEtPullback b).map ((wcProEtPullback ι).map φh)).left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (unfold wcProEtPullback; rw [MorphismProperty.Over.pullback_map_left];
         exact Limits.pullback.lift_fst _ _ _)
  have hφ3b : ((wcProEtPullback iE).map ((wcProEtPullback b).map
        ((wcProEtPullback ι).map φh))).left ≫
      Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE =
      Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE := by
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (unfold wcProEtPullback; rw [MorphismProperty.Over.pullback_map_left];
         exact Limits.pullback.lift_snd _ _ _)
  have hM2 : ((wcProEtPullback iE).map ((wcProEtPullback b).map
        ((wcProEtPullback ι).map φh))).left ≫
      Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE ≫
        Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b =
      Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE ≫
        Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b := by
    exact helper _ _ _ _ _ _ hφ3a hφ2b
  have hM3 : ((wcProEtPullback iE).map ((wcProEtPullback b).map
        ((wcProEtPullback ι).map φh))).left ≫
      Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE ≫
        Limits.pullback.fst (Limits.pullback.snd Th.hom ι) b ≫ Limits.pullback.fst Th.hom ι =
      Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE ≫
        Limits.pullback.fst (Limits.pullback.snd Th.hom ι) b ≫ Limits.pullback.fst Th.hom ι ≫
          φh.left := by
    exact helper _ _ _ _ _ _ hφ3a (helper _ _ _ _ _ _ hφ2a hφ1a)

  have hN1 : (wcGeomFrob K E₀ hE).left ≫ Limits.pullback.fst E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.fst E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    first
      | exact MorphismProperty.Over.w (wcGeomFrob K E₀ hE)
      | exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hNS : (wcGeomFrob K E₀ hE).left ≫ Limits.pullback.snd E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
        (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
          AlgebraicClosure K →+* AlgebraicClosure K)) := by
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (unfold wcGeomFrob; exact Limits.pullback.lift_snd _ _ _)
      | (simp [wcGeomFrob])
  have hN2 : (wcGeomFrob K E₀ hE).left ≫ (Limits.pullback.snd E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫ εT.inv ≫
        Limits.pullback.fst Th.hom xs) =
      (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫ εT.inv ≫
          Limits.pullback.fst Th.hom xs) ≫ φh.left := by
    refine (helper _ _ _ _ _ _ hNS hεTφ.symm).trans ?_
    simp only [Category.assoc]
    first | rfl | exact Eq.refl _

  refine ⟨MorphismProperty.Over.isoMk κ₀ hk1, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  have key := s2 Th.hom ι b iE _ _ (IsPullback.of_hasPullback Th.hom ι)
    _ _ (IsPullback.of_hasPullback (Limits.pullback.snd Th.hom ι) b)
    _ _ (IsPullback.of_hasPullback
      (Limits.pullback.snd (Limits.pullback.snd Th.hom ι) b) iE)
    φh.left _ _ κ₀.hom hk1 hk2 _ hφ3b hM2 hM3 _ hN1 hN2
  first
    | exact key
    | exact (MorphismProperty.Comma.comp_left _ _).trans
        (key.trans (MorphismProperty.Comma.comp_left _ _).symm)
    | (erw [MorphismProperty.Comma.comp_left, MorphismProperty.Comma.comp_left,
        MorphismProperty.Over.isoMk_hom_left]; exact key)

theorem wc_mpq_germ_exc_pbc (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀) (φh : Th ⟶ Th)
    (hφh : φh ≫ g = g ≫ (wcProEtPullback D.f).map φ₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (E₀ : Over (Spec (.of F''))) (hpr : IsProper E₀.hom)
    (hsm : SmoothOfRelativeDimension (n - 2) E₀.hom)
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Xt : Over (Spec (.of F''))) (hpXt : IsProper Xt.hom)
    (hsXt : SmoothOfRelativeDimension (n - 2 + 1) Xt.hom)
    (b : Xt.left ⟶ Limits.pullback D.f (D.S i)) (iE : E₀.left ⟶ Xt.left)
    (hb : IsProper b) (hbX : b ≫ Limits.pullback.snd D.f (D.S i) = Xt.hom)
    (hbO : IsIso (b ∣_ wcCritPunctOpen D i)) (hiE : IsClosedImmersion iE)
    (hiEX : iE ≫ Xt.hom = E₀.hom)
    (hrangeE : ((b ⁻¹ᵁ wcCritPunctOpen D i : Xt.left.Opens) : Set Xt.left) = (Set.range iE)ᶜ)
    (k : ℕ) :
    ∃ Ψ : wcCohG F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2) →+
        Abelian.Ext (wcFreeSheaf Xt.left ((wcProEtPullback b).obj
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th)))
          (wcContSheaf Xt.left (ZMod (ℓ ^ k))) (n - 2),
      Function.Surjective Ψ ∧
      ∀ x, (Abelian.Ext.mk₀ (wcFreeSheafMap Xt.left ((wcProEtPullback b).map
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map φh)))).comp (Ψ x)
            (zero_add (n - 2)) =
        Ψ (wcCohGFrob F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2) x) :=
by
  classical
  have hfun : ∀ {S : Scheme.{u}} {A₁ B₁ C₁ : S.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S A₁ B₁ C₁ a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have hid : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    unfold wcFreeSheafMap
    rw [yoneda.map_id, Functor.whiskerRight_id']
    exact (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_id _
  haveI := hpr
  haveI := hb
  haveI := hiE
  haveI hSc : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)

  obtain ⟨L, adj, hLlim, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat iE
  haveI := hLlim
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L

  have hn0 : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hmK : ((ℓ ^ k : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ((ℓ ^ k : ℕ) : F'') = 0 := by
      apply (algebraMap F'' (AlgebraicClosure F'')).injective
      rw [map_natCast, map_zero]
      exact h0
    have h2 : ringChar F'' ∣ ℓ ^ k := (ringChar.spec F'' _).mp h1
    have h3 : ringChar F'' ∣ ℓ := hp.dvd_of_dvd_pow h2
    have h4 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out)).mp h3
    have h5 : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F''
    have h6 : ringChar F'' ∣ Nat.card F'' := (ringChar.spec F'' _).mp h5
    exact hℓ (h4 ▸ h6)

  have hfacY := wc_mpq_exc_factor_xs F' F'' Y n D i E₀ hsm Xt b iE hbX hiEX hrangeE
  obtain ⟨εT, hεT, hεTφ⟩ := wc_mpq_germ_xs_fibre_frob F' F'' Y n D i V₀ φ₀ ε hε hεφ xb hxb Th g
    φh hφh hfib
  obtain ⟨κ, hκ⟩ := wc_mpq_exc_geom_point_iso F'' Th φh (Limits.pullback.fst D.f (D.S i)) b E₀ iE
    hE (D.xs i) hfacY εT hεT hεTφ
  have hκ' : (wcProEtPullback iE).map ((wcProEtPullback b).map
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map φh)) ≫ κ.inv =
      κ.inv ≫ wcGeomFrob F'' E₀ hE := by
    rw [Iso.comp_inv_eq, Category.assoc, ← hκ, Iso.inv_hom_id_assoc]

  let fU : ((wcProEtPullback b).obj
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th)).left ⟶ Spec (.of B) :=
    Limits.pullback.fst (Limits.pullback.snd Th.hom (Limits.pullback.fst D.f (D.S i))) b ≫
      Limits.pullback.fst Th.hom (Limits.pullback.fst D.f (D.S i)) ≫ eB.hom
  haveI hfUp : IsProper fU := by
    show IsProper (Limits.pullback.fst (Limits.pullback.snd Th.hom
      (Limits.pullback.fst D.f (D.S i))) b ≫
        Limits.pullback.fst Th.hom (Limits.pullback.fst D.f (D.S i)) ≫ eB.hom)
    infer_instance
  have hfibU : ∀ u : ((wcProEtPullback b).obj
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th)).left,
      ((wcProEtPullback b).obj
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th)).hom u ∈ Set.range iE ↔
        fU u = IsLocalRing.closedPoint B := by
    intro u
    exact wc_mpq_germ_xs_fibre_points F' F'' Y n D i V₀ ε xb hxb Th g B eB hpre Xt.left E₀.left
      b iE hrangeE u
  have hκl1 : κ.inv.left ≫ κ.hom.left = 𝟙 _ := by
    have h := congrArg (fun f => f.left) κ.inv_hom_id
    first
      | exact h
      | simpa using h
  have hκl2 : κ.hom.left ≫ κ.inv.left = 𝟙 _ := by
    have h := congrArg (fun f => f.left) κ.hom_inv_id
    first
      | exact h
      | simpa using h
  haveI hκiso : IsIso κ.inv.left := ⟨⟨κ.hom.left, hκl1, hκl2⟩⟩
  let kl : Limits.pullback ((wcProEtPullback b).obj
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th)).hom iE ⟶
      Limits.pullback E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := κ.inv.left
  haveI hkliso : IsIso kl := hκiso
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange (n - 2)
  have hsmE : SmoothOfRelativeDimension (n - 2) (Limits.pullback.snd E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 2))
      (IsPullback.of_hasPullback E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hsm
  haveI hEred : IsReduced (Limits.pullback E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    wcpa_dj_sst_smooth_reduced _ (n - 2) hsmE
  haveI hPred : IsReduced (Limits.pullback ((wcProEtPullback b).obj
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th)).hom iE) :=
    isReduced_of_isOpenImmersion kl
  let pP : Limits.pullback ((wcProEtPullback b).obj
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th)).hom iE ⟶
      Spec (.of (AlgebraicClosure F'')) :=
    kl ≫ Limits.pullback.snd E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
  haveI hpPp : IsProper pP := by
    show IsProper (kl ≫ Limits.pullback.snd E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    infer_instance
  have hRb := wc_mpq_closed_fibre_res_bij iE L adj θ
    ((wcProEtPullback b).obj ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th))
    B fU hfibU (AlgebraicClosure F'') pP (ℓ ^ k) hn0 hmK (n - 2)
  let eR := AddEquiv.ofBijective _ hRb
  have hRes : ∀ w, wcProEtRes iE L adj θ (ZMod (ℓ ^ k))
      ((wcProEtPullback b).obj ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th))
      (n - 2) (eR.symm w) = w :=
    fun w => eR.apply_symm_apply w
  have hRnat := (wc_proet_res_theta_swap_natural iE L adj θ θ (ZMod (ℓ ^ k)) (n - 2)).2 hθ

  let pre := (Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left κ.inv)).precomp
    (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (zero_add (n - 2))
  have hpre_surj : Function.Surjective pre := by
    intro z
    refine ⟨(Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left κ.hom)).comp z (zero_add (n - 2)), ?_⟩
    show (Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left κ.inv)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left κ.hom)).comp z (zero_add (n - 2)))
        (zero_add (n - 2)) = z
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun, κ.inv_hom_id, hid, Abelian.Ext.mk₀_id_comp]
  refine ⟨(eR.symm : _ →+ _).comp pre, ?_, ?_⟩
  · exact eR.symm.surjective.comp hpre_surj
  · intro x
    apply eR.injective
    show wcProEtRes iE L adj θ (ZMod (ℓ ^ k))
        ((wcProEtPullback b).obj ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th))
        (n - 2)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap Xt.left ((wcProEtPullback b).map
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map φh)))).comp
          (eR.symm (pre x)) (zero_add (n - 2))) =
      wcProEtRes iE L adj θ (ZMod (ℓ ^ k))
        ((wcProEtPullback b).obj ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th))
        (n - 2)
        (eR.symm (pre (wcCohGFrob F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2) x)))
    rw [hRnat, hRes, hRes]
    show (Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left ((wcProEtPullback iE).map
        ((wcProEtPullback b).map ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map φh))))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left κ.inv)).comp x (zero_add (n - 2)))
        (zero_add (n - 2)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left κ.inv)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap E₀.left (wcGeomFrob F'' E₀ hE))).comp x
          (zero_add (n - 2))) (zero_add (n - 2))
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun, ← hfun, hκ']

theorem wc_pmod_geom_coker_pull_iso (K : Type u) [Field K] [Finite K]
    (X Xt : Over (Spec (.of K))) (b : Xt.left ⟶ X.left) (hbX : b ≫ X.hom = Xt.hom)
    (O : X.left.Opens)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (hXt : WeaklyEtale (Limits.pullback.fst Xt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (L : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Xt.left) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (θ : ∀ V : X.left.ProEt, L.obj (wcFreeSheaf X.left V) ≅
      wcFreeSheaf Xt.left ((wcProEtPullback b).obj V))
    (hθ : ∀ {V V' : X.left.ProEt} (a : V ⟶ V'),
      L.map (wcFreeSheafMap X.left a) ≫ (θ V').hom =
        (θ V).hom ≫ wcFreeSheafMap Xt.left ((wcProEtPullback b).map a)) :
    ∃ κ : L.obj (Limits.cokernel (wcFreeSheafMap X.left
          (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)))) ≅
        Limits.cokernel (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt))),
      ∀ (Ψ : Limits.cokernel (wcFreeSheafMap X.left (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))) ⟶
          Limits.cokernel (wcFreeSheafMap X.left (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))))
        (Ψt : Limits.cokernel (wcFreeSheafMap Xt.left
              (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt))) ⟶
          Limits.cokernel (wcFreeSheafMap Xt.left
              (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt)))),
        Limits.cokernel.π _ ≫ Ψ =
          wcFreeSheafMap X.left (wcGeomFrob K X hX) ≫ Limits.cokernel.π _ →
        Limits.cokernel.π _ ≫ Ψt =
          wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫ Limits.cokernel.π _ →
        L.map Ψ ≫ κ.hom = κ.hom ≫ Ψt :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have F1 : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    first
      | (unfold wcFreeSheafMap
         rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id]
         rfl)
      | (unfold wcFreeSheafMap wcFreeSheaf
         rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id]
         done)
      | (simp [wcFreeSheafMap, wcFreeSheaf]; done)

  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) {V V' : S.ProEt} (ψ : V ⟶ V'),
      ∃ ψo : wcOpenRestr S O V ⟶ wcOpenRestr S O V',
        ψo ≫ wcOpenRestrIncl S O V' = wcOpenRestrIncl S O V ≫ ψ := by
    intro S O V V' ψ
    have w : ψ.left ≫ V'.hom = V.hom := MorphismProperty.Over.w ψ
    have hc : Limits.pullback.fst O.ι V.hom ≫ O.ι =
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) ≫ V'.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι V.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι V.hom)
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) hc ≫ (Limits.pullback.snd O.ι V'.hom ≫ V'.hom) =
        Limits.pullback.snd O.ι V.hom ≫ V.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ V'.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι V.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι V.hom)
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _


  have GP : ∀ (F' : Type u) [Field F'] [Finite F'] (Y W : Over (Spec (.of F')))
      (p : W ⟶ Y)
      (hY : WeaklyEtale (Limits.pullback.fst Y.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (hW : WeaklyEtale (Limits.pullback.fst W.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))),
      ∃ e : wcGeomPoint F' W hW ≅ (wcProEtPullback p.left).obj (wcGeomPoint F' Y hY),
        e.hom ≫ (wcProEtPullback p.left).map (wcGeomFrob F' Y hY) =
          wcGeomFrob F' W hW ≫ e.hom := by
    intro F' _ _ Y W p hY hW
    have key : ∀ (S K A B : Scheme.{u}) (σ : K ⟶ S) (φ : K ⟶ K) (a : A ⟶ S) (b : B ⟶ S)
        (f : B ⟶ A)
        (hf : f ≫ a = b) (FrA : Limits.pullback a σ ⟶ Limits.pullback a σ)
        (FrB : Limits.pullback b σ ⟶ Limits.pullback b σ)
        (hA1 : FrA ≫ Limits.pullback.fst a σ = Limits.pullback.fst a σ)
        (_hA2 : FrA ≫ Limits.pullback.snd a σ = Limits.pullback.snd a σ ≫ φ)
        (hB1 : FrB ≫ Limits.pullback.fst b σ = Limits.pullback.fst b σ)
        (_hB2 : FrB ≫ Limits.pullback.snd b σ = Limits.pullback.snd b σ ≫ φ),
        ∃ ε : Limits.pullback b σ ≅ Limits.pullback (Limits.pullback.fst a σ) f,
          ε.hom ≫ Limits.pullback.snd (Limits.pullback.fst a σ) f = Limits.pullback.fst b σ ∧
          ε.hom ≫ Limits.pullback.lift (Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ FrA)
            (Limits.pullback.snd (Limits.pullback.fst a σ) f)
            (by rw [Category.assoc, hA1]; exact Limits.pullback.condition) = FrB ≫ ε.hom := by
      intro S K A B σ φ a b f hf FrA FrB hA1 hA2 hB1 hB2
      let E₁ : Limits.pullback b σ ⟶ Limits.pullback a σ :=
        Limits.pullback.lift (Limits.pullback.fst b σ ≫ f) (Limits.pullback.snd b σ)
          (by rw [Category.assoc, hf]; exact Limits.pullback.condition)
      have E₁f : E₁ ≫ Limits.pullback.fst a σ = Limits.pullback.fst b σ ≫ f :=
        Limits.pullback.lift_fst _ _ _
      have E₁s : E₁ ≫ Limits.pullback.snd a σ = Limits.pullback.snd b σ :=
        Limits.pullback.lift_snd _ _ _
      let E : Limits.pullback b σ ⟶ Limits.pullback (Limits.pullback.fst a σ) f :=
        Limits.pullback.lift E₁ (Limits.pullback.fst b σ) E₁f
      have Ef : E ≫ Limits.pullback.fst (Limits.pullback.fst a σ) f = E₁ :=
        Limits.pullback.lift_fst _ _ _
      have Es : E ≫ Limits.pullback.snd (Limits.pullback.fst a σ) f = Limits.pullback.fst b σ :=
        Limits.pullback.lift_snd _ _ _
      have hc : Limits.pullback.snd (Limits.pullback.fst a σ) f ≫ b =
          (Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ Limits.pullback.snd a σ) ≫ σ := by
        simp only [Category.assoc]
        rw [← Limits.pullback.condition, ← hf, Limits.pullback.condition_assoc]
      let E' : Limits.pullback (Limits.pullback.fst a σ) f ⟶ Limits.pullback b σ :=
        Limits.pullback.lift (Limits.pullback.snd (Limits.pullback.fst a σ) f)
          (Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ Limits.pullback.snd a σ) hc
      have E'f : E' ≫ Limits.pullback.fst b σ = Limits.pullback.snd (Limits.pullback.fst a σ) f :=
        Limits.pullback.lift_fst _ _ _
      have E's : E' ≫ Limits.pullback.snd b σ =
          Limits.pullback.fst (Limits.pullback.fst a σ) f ≫ Limits.pullback.snd a σ :=
        Limits.pullback.lift_snd _ _ _
      have h1 : E ≫ E' = 𝟙 _ := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, E'f, Es, Category.id_comp]
        · rw [Category.assoc, E's, ← Category.assoc, Ef, E₁s, Category.id_comp]
      have h2 : E' ≫ E = 𝟙 _ := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Ef, Category.id_comp]
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, E₁f, ← Category.assoc, E'f, ← Limits.pullback.condition]
          · rw [Category.assoc, E₁s, E's]
        · rw [Category.assoc, Es, E'f, Category.id_comp]
      have hE₁Fr : E₁ ≫ FrA = FrB ≫ E₁ := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hA1, E₁f, Category.assoc, E₁f, ← Category.assoc, hB1]
        · rw [Category.assoc, hA2, ← Category.assoc, E₁s, Category.assoc, E₁s, hB2]
      refine ⟨Iso.mk E E' h1 h2, Es, ?_⟩
      show E ≫ _ = FrB ≫ E
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Ef, Category.assoc, Ef,
          hE₁Fr]
      · rw [Category.assoc, Limits.pullback.lift_snd, Es, Category.assoc, Es, hB1]
    have hp : p.left ≫ Y.hom = W.hom := Over.w p
    obtain ⟨ε, hε1, hε2⟩ := key _ _ _ _
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
      (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F' _
        (Fintype.ofFinite F') (AlgebraicClosure F') _ _ _).symm :
          AlgebraicClosure F' →+* AlgebraicClosure F')))
      Y.hom W.hom p.left hp (wcGeomFrob F' Y hY).left (wcGeomFrob F' W hW).left
      (MorphismProperty.Over.w (wcGeomFrob F' Y hY)) (Limits.pullback.lift_snd _ _ _)
      (MorphismProperty.Over.w (wcGeomFrob F' W hW)) (Limits.pullback.lift_snd _ _ _)
    refine ⟨MorphismProperty.Over.isoMk ε hε1, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact hε2


  have ORI : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (O : Y.Opens) (V : Y.ProEt),
      ∃ β : (wcProEtPullback g).obj (wcOpenRestr Y O V) ≅
          wcOpenRestr X (g ⁻¹ᵁ O) ((wcProEtPullback g).obj V),
        β.hom ≫ wcOpenRestrIncl X (g ⁻¹ᵁ O) ((wcProEtPullback g).obj V) =
          (wcProEtPullback g).map (wcOpenRestrIncl Y O V) := by
    intro X Y g O V
    have H := isPullback_morphismRestrict g O
    let p1 := Limits.pullback.fst O.ι V.hom
    let p2 := Limits.pullback.snd O.ι V.hom
    let w := p2 ≫ V.hom
    let a1 := Limits.pullback.fst w g
    let a2 := Limits.pullback.snd w g
    let q1 := Limits.pullback.fst V.hom g
    let q2 := Limits.pullback.snd V.hom g
    let r1 := Limits.pullback.fst (g ⁻¹ᵁ O).ι q2
    let r2 := Limits.pullback.snd (g ⁻¹ᵁ O).ι q2
    have cP : p1 ≫ O.ι = p2 ≫ V.hom := Limits.pullback.condition
    have cL : a1 ≫ w = a2 ≫ g := Limits.pullback.condition
    have cQ : q1 ≫ V.hom = q2 ≫ g := Limits.pullback.condition
    have cR : r1 ≫ (g ⁻¹ᵁ O).ι = r2 ≫ q2 := Limits.pullback.condition
    have cH : g ∣_ O ≫ O.ι = (g ⁻¹ᵁ O).ι ≫ g := morphismRestrict_ι g O
    have wm : (a1 ≫ p2) ≫ V.hom = a2 ≫ g := by rw [Category.assoc]; exact cL
    have wk : (a1 ≫ p1) ≫ O.ι = a2 ≫ g := by rw [Category.assoc, cP]; exact cL
    let m : Limits.pullback w g ⟶ Limits.pullback V.hom g := Limits.pullback.lift (a1 ≫ p2) a2 wm
    let k : Limits.pullback w g ⟶ (g ⁻¹ᵁ O : Scheme) := H.lift (a1 ≫ p1) a2 wk
    have km1 : k ≫ g ∣_ O = a1 ≫ p1 := H.lift_fst _ _ _
    have km2 : k ≫ (g ⁻¹ᵁ O).ι = a2 := H.lift_snd _ _ _
    have mq1 : m ≫ q1 = a1 ≫ p2 := Limits.pullback.lift_fst _ _ _
    have mq2 : m ≫ q2 = a2 := Limits.pullback.lift_snd _ _ _
    have wφ : k ≫ (g ⁻¹ᵁ O).ι = m ≫ q2 := by rw [km2, mq2]
    let φ : Limits.pullback w g ⟶ Limits.pullback (g ⁻¹ᵁ O).ι q2 := Limits.pullback.lift k m wφ
    have φr1 : φ ≫ r1 = k := Limits.pullback.lift_fst _ _ _
    have φr2 : φ ≫ r2 = m := Limits.pullback.lift_snd _ _ _
    have wn : (r1 ≫ g ∣_ O) ≫ O.ι = (r2 ≫ q1) ≫ V.hom := by
      rw [Category.assoc, cH, ← Category.assoc, cR, Category.assoc, Category.assoc, cQ]
    let n : Limits.pullback (g ⁻¹ᵁ O).ι q2 ⟶ Limits.pullback O.ι V.hom :=
      Limits.pullback.lift (r1 ≫ g ∣_ O) (r2 ≫ q1) wn
    have np1 : n ≫ p1 = r1 ≫ g ∣_ O := Limits.pullback.lift_fst _ _ _
    have np2 : n ≫ p2 = r2 ≫ q1 := Limits.pullback.lift_snd _ _ _
    have wψ : n ≫ w = (r2 ≫ q2) ≫ g := by
      show n ≫ p2 ≫ V.hom = _
      rw [← Category.assoc, np2, Category.assoc, cQ, Category.assoc]
    let ψ : Limits.pullback (g ⁻¹ᵁ O).ι q2 ⟶ Limits.pullback w g :=
      Limits.pullback.lift n (r2 ≫ q2) wψ
    have ψa1 : ψ ≫ a1 = n := Limits.pullback.lift_fst _ _ _
    have ψa2 : ψ ≫ a2 = r2 ≫ q2 := Limits.pullback.lift_snd _ _ _
    have h1 : φ ≫ ψ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · show (φ ≫ ψ) ≫ a1 = 𝟙 _ ≫ a1
        rw [Category.assoc, ψa1, Category.id_comp]
        apply Limits.pullback.hom_ext
        · show (φ ≫ n) ≫ p1 = a1 ≫ p1
          rw [Category.assoc, np1, ← Category.assoc, φr1, km1]
        · show (φ ≫ n) ≫ p2 = a1 ≫ p2
          rw [Category.assoc, np2, ← Category.assoc, φr2, mq1]
      · show (φ ≫ ψ) ≫ a2 = 𝟙 _ ≫ a2
        rw [Category.assoc, ψa2, ← Category.assoc, φr2, mq2, Category.id_comp]
    have h2 : ψ ≫ φ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · show (ψ ≫ φ) ≫ r1 = 𝟙 _ ≫ r1
        rw [Category.assoc, φr1, Category.id_comp]
        apply H.hom_ext
        · rw [Category.assoc, km1, ← Category.assoc, ψa1, np1]
        · rw [Category.assoc, km2, ψa2, cR]
      · show (ψ ≫ φ) ≫ r2 = 𝟙 _ ≫ r2
        rw [Category.assoc, φr2, Category.id_comp]
        apply Limits.pullback.hom_ext
        · show (ψ ≫ m) ≫ q1 = r2 ≫ q1
          rw [Category.assoc, mq1, ← Category.assoc, ψa1, np2]
        · show (ψ ≫ m) ≫ q2 = r2 ≫ q2
          rw [Category.assoc, mq2, ψa2]
    let e : Limits.pullback w g ≅ Limits.pullback (g ⁻¹ᵁ O).ι q2 := ⟨φ, ψ, h1, h2⟩
    have we : e.hom ≫ (r2 ≫ q2) = a2 := by
      show φ ≫ r2 ≫ q2 = a2
      rw [← Category.assoc, φr2, mq2]
    refine ⟨MorphismProperty.Over.isoMk (A := (wcProEtPullback g).obj (wcOpenRestr Y O V))
      (B := wcOpenRestr X (g ⁻¹ᵁ O) ((wcProEtPullback g).obj V)) e we, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    change φ ≫ r2 = _
    rw [φr2]
    first
      | rfl
      | (apply Limits.pullback.hom_ext
         · rw [mq1]
           first
             | exact (Limits.pullback.lift_fst _ _ _).symm
             | (erw [MorphismProperty.Over.pullback_map_left, Limits.pullback.lift_fst]; rfl)
         · rw [mq2]
           first
             | exact (Limits.pullback.lift_snd _ _ _).symm
             | (erw [MorphismProperty.Over.pullback_map_left, Limits.pullback.lift_snd]))

  have T : ∀ {A B : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}}
      {A' B' : Sheaf (Scheme.ProEt.topology Xt.left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B) (f' : A' ⟶ B') (qh : L.obj B ⟶ B') (qi : B' ⟶ L.obj B),
      qh ≫ qi = 𝟙 _ → qi ≫ qh = 𝟙 _ →
      L.map f ≫ qh ≫ Limits.cokernel.π f' = 0 →
      f' ≫ qi ≫ Limits.cokernel.π (L.map f) = 0 →
      ∃ κ : L.obj (Limits.cokernel f) ≅ Limits.cokernel f',
        ∀ (φ : B ⟶ B) (φ' : B' ⟶ B') (Ψ : Limits.cokernel f ⟶ Limits.cokernel f)
          (Ψ' : Limits.cokernel f' ⟶ Limits.cokernel f'),
          L.map φ ≫ qh = qh ≫ φ' →
          Limits.cokernel.π f ≫ Ψ = φ ≫ Limits.cokernel.π f →
          Limits.cokernel.π f' ≫ Ψ' = φ' ≫ Limits.cokernel.π f' →
          L.map Ψ ≫ κ.hom = κ.hom ≫ Ψ' := by
    intro A B A' B' f f' qh qi hhi hih h1 h2
    haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_additive L
    haveI : Limits.PreservesColimitsOfShape Limits.WalkingParallelPair L :=
      Limits.PreservesFiniteColimits.preservesFiniteColimits (F := L) Limits.WalkingParallelPair
    haveI : Limits.PreservesColimit (Limits.parallelPair f 0) L := inferInstance
    let I := Limits.PreservesCokernel.iso L f
    have I1 : L.map (Limits.cokernel.π f) ≫ I.hom = Limits.cokernel.π (L.map f) :=
      Limits.PreservesCokernel.π_iso_hom L f
    let d₁ := Limits.cokernel.desc (L.map f) (qh ≫ Limits.cokernel.π f') h1
    let d₂ := Limits.cokernel.desc f' (qi ≫ Limits.cokernel.π (L.map f)) h2
    have hd₁ : Limits.cokernel.π (L.map f) ≫ d₁ = qh ≫ Limits.cokernel.π f' :=
      Limits.cokernel.π_desc _ _ _
    have hd₂ : Limits.cokernel.π f' ≫ d₂ = qi ≫ Limits.cokernel.π (L.map f) :=
      Limits.cokernel.π_desc _ _ _
    have e1 : d₁ ≫ d₂ = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π (L.map f))).mp
      rw [reassoc_of% hd₁, hd₂, ← Category.assoc, hhi, Category.id_comp, Category.comp_id]
    have e2 : d₂ ≫ d₁ = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π f')).mp
      rw [reassoc_of% hd₂, hd₁, ← Category.assoc, hih, Category.id_comp, Category.comp_id]
    let κ₀ : Limits.cokernel (L.map f) ≅ Limits.cokernel f' := ⟨d₁, d₂, e1, e2⟩
    have star : L.map (Limits.cokernel.π f) ≫ (I ≪≫ κ₀).hom = qh ≫ Limits.cokernel.π f' := by
      rw [Iso.trans_hom, ← Category.assoc, I1]
      exact hd₁
    haveI : Epi (L.map (Limits.cokernel.π f)) := by
      have hfac : L.map (Limits.cokernel.π f) = Limits.cokernel.π (L.map f) ≫ I.inv := by
        rw [← I1, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [hfac]
      exact epi_comp _ _
    refine ⟨I ≪≫ κ₀, ?_⟩
    intro φ φ' Ψ Ψ' hq hΨ hΨ'
    apply (cancel_epi (L.map (Limits.cokernel.π f))).mp
    rw [← Functor.map_comp_assoc, hΨ, Functor.map_comp_assoc, star, reassoc_of% hq, ← hΨ',
      ← reassoc_of% star]

  obtain ⟨e, he⟩ : ∃ e : wcGeomPoint K Xt hXt ≅ (wcProEtPullback b).obj (wcGeomPoint K X hX),
      e.hom ≫ (wcProEtPullback b).map (wcGeomFrob K X hX) = wcGeomFrob K Xt hXt ≫ e.hom :=
    GP K X Xt (Over.homMk b hbX) hX hXt
  obtain ⟨β₀, hβ₀⟩ := ORI b O (wcGeomPoint K X hX)
  obtain ⟨ψ1, hψ1⟩ := Hres (b ⁻¹ᵁ O) e.inv
  obtain ⟨ψ2, hψ2⟩ := Hres (b ⁻¹ᵁ O) e.hom
  have hFr : (wcProEtPullback b).map (wcGeomFrob K X hX) ≫ e.inv = e.inv ≫ wcGeomFrob K Xt hXt := by
    rw [Iso.comp_inv_eq, Category.assoc, ← he, Iso.inv_hom_id_assoc]
  have key1 : (wcProEtPullback b).map (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)) ≫ e.inv =
      (β₀.hom ≫ ψ1) ≫ wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt) := by
    rw [← hβ₀]
    simp only [Category.assoc]
    rw [hψ1]
  have key2 : wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt) ≫ e.hom =
      (ψ2 ≫ β₀.inv) ≫ (wcProEtPullback b).map (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)) := by
    rw [← hψ2, ← hβ₀]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
  have hθι := hθ (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))
  have hθι' : wcFreeSheafMap Xt.left
        ((wcProEtPullback b).map (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))) ≫
        (θ (wcGeomPoint K X hX)).inv =
      (θ (wcOpenRestr X.left O (wcGeomPoint K X hX))).inv ≫
        L.map (wcFreeSheafMap X.left (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))) := by
    rw [Iso.comp_inv_eq, Category.assoc, hθι, Iso.inv_hom_id_assoc]
  have k1 : wcFreeSheafMap Xt.left
        ((wcProEtPullback b).map (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))) ≫
        wcFreeSheafMap Xt.left e.inv =
      wcFreeSheafMap Xt.left (β₀.hom ≫ ψ1) ≫
        wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt)) := by
    rw [← F0, ← F0, key1]
  have k2 : wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt)) ≫
        wcFreeSheafMap Xt.left e.hom =
      wcFreeSheafMap Xt.left (ψ2 ≫ β₀.inv) ≫ wcFreeSheafMap Xt.left
        ((wcProEtPullback b).map (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))) := by
    rw [← F0, ← F0, key2]
  have hhi : ((θ (wcGeomPoint K X hX)).hom ≫ wcFreeSheafMap Xt.left e.inv) ≫
      (wcFreeSheafMap Xt.left e.hom ≫ (θ (wcGeomPoint K X hX)).inv) = 𝟙 _ := by
    simp only [Category.assoc]
    rw [← Category.assoc (wcFreeSheafMap Xt.left e.inv), ← F0, Iso.inv_hom_id, F1,
      Category.id_comp, Iso.hom_inv_id]
  have hih : (wcFreeSheafMap Xt.left e.hom ≫ (θ (wcGeomPoint K X hX)).inv) ≫
      ((θ (wcGeomPoint K X hX)).hom ≫ wcFreeSheafMap Xt.left e.inv) = 𝟙 _ := by
    simp only [Category.assoc]
    rw [Iso.inv_hom_id_assoc, ← F0, Iso.hom_inv_id, F1]
  have h1 : L.map (wcFreeSheafMap X.left (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))) ≫
      ((θ (wcGeomPoint K X hX)).hom ≫ wcFreeSheafMap Xt.left e.inv) ≫
      Limits.cokernel.π (wcFreeSheafMap Xt.left
        (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt))) = 0 := by
    simp only [Category.assoc]
    rw [reassoc_of% hθι, reassoc_of% k1, Limits.cokernel.condition]
    simp
  have h2 : wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt)) ≫
      (wcFreeSheafMap Xt.left e.hom ≫ (θ (wcGeomPoint K X hX)).inv) ≫
      Limits.cokernel.π (L.map (wcFreeSheafMap X.left
        (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)))) = 0 := by
    simp only [Category.assoc]
    rw [reassoc_of% k2, reassoc_of% hθι', Limits.cokernel.condition]
    simp
  have hcomm : L.map (wcFreeSheafMap X.left (wcGeomFrob K X hX)) ≫
      ((θ (wcGeomPoint K X hX)).hom ≫ wcFreeSheafMap Xt.left e.inv) =
      ((θ (wcGeomPoint K X hX)).hom ≫ wcFreeSheafMap Xt.left e.inv) ≫
        wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) := by
    simp only [Category.assoc]
    rw [reassoc_of% (hθ (wcGeomFrob K X hX)),
      ← F0 ((wcProEtPullback b).map (wcGeomFrob K X hX)) e.inv, hFr, F0]
  obtain ⟨κ, hκ⟩ := T (wcFreeSheafMap X.left (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)))
    (wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt)))
    ((θ (wcGeomPoint K X hX)).hom ≫ wcFreeSheafMap Xt.left e.inv)
    (wcFreeSheafMap Xt.left e.hom ≫ (θ (wcGeomPoint K X hX)).inv) hhi hih h1 h2
  exact ⟨κ, fun Ψ Ψt hΨ hΨt => hκ _ _ Ψ Ψt hcomm hΨ hΨt⟩

theorem wc_smooth_divisor_local_coh_gysin_frob (K : Type u) [Field K] [Finite K]
    (Xt E : Over (Spec (.of K))) (hpXt : IsProper Xt.hom) (d : ℕ)
    (hsXt : SmoothOfRelativeDimension (d + 1) Xt.hom) (hpE : IsProper E.hom)
    (hsE : SmoothOfRelativeDimension d E.hom)
    (iE : E.left ⟶ Xt.left) (hiE : IsClosedImmersion iE) (hiEX : iE ≫ Xt.hom = E.hom)
    (Ot : Xt.left.Opens) (hOt : (Ot : Set Xt.left) = (Set.range iE)ᶜ)
    (hXt : WeaklyEtale (Limits.pullback.fst Xt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (hE : WeaklyEtale (Limits.pullback.fst E.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (k m : ℕ) (hm : 2 ≤ m)
    (Ψt : Limits.cokernel (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ⟶
      Limits.cokernel (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))))
    (hΨt : Limits.cokernel.π _ ≫ Ψt =
      wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫ Limits.cokernel.π _) :
    ∃ γ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Xt.left
            (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))))
          (wcContSheaf Xt.left (ZMod (ℓ ^ k))) m →+
        wcCohG K E hE (wcContSheaf E.left (ZMod (ℓ ^ k))) (m - 2),
      Function.Injective γ ∧
      ∀ z, γ ((Abelian.Ext.mk₀ Ψt).comp z (zero_add m)) =
        Nat.card K • wcCohGFrob K E hE (wcContSheaf E.left (ZMod (ℓ ^ k))) (m - 2) (γ z) :=
by
  classical

  haveI := hsXt
  haveI := hsE
  haveI := hiE
  haveI : Smooth Xt.hom := SmoothOfRelativeDimension.smooth (d + 1) Xt.hom
  haveI hln : IsLocallyNoetherian Xt.left := LocallyOfFiniteType.isLocallyNoetherian Xt.hom
  haveI : SmoothOfRelativeDimension d (iE ≫ Xt.hom) := by rw [hiEX]; exact hsE
  have hℓK : (ℓ : K) ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite K
    obtain ⟨p, hp⟩ := CharP.exists K
    haveI := hp
    obtain ⟨n, hpprime, hcard⟩ := FiniteField.card K p
    have hpl : p ∣ ℓ := (CharP.cast_eq_zero_iff K p ℓ).mp h0
    have hpl' : p = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd p hpl).resolve_left hpprime.one_lt.ne'
    apply hℓ
    rw [← hpl', Nat.card_eq_fintype_card, hcard]
    exact dvd_pow_self p n.ne_zero
  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ φo : wcOpenRestr S O Tc ⟶ wcOpenRestr S O Tc,
        φo ≫ wcOpenRestrIncl S O Tc = wcOpenRestrIncl S O Tc ≫ φ := by
    intro S O Tc φ
    have w : φ.left ≫ Tc.hom = Tc.hom := MorphismProperty.Over.w φ
    have hc : Limits.pullback.fst O.ι Tc.hom ≫ O.ι =
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) ≫ Tc.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc ≫ (Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom) =
        Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ Tc.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨b, hab⟩ := Hres Ot (wcGeomPoint K Xt hXt) (wcGeomFrob K Xt hXt)

  obtain ⟨ρ, hρi, hρs, hρF⟩ := wc_root_twist_slice_presheaf_map K Xt ℓ hℓ hXt k 1
  obtain ⟨φ, hφiso, hφF⟩ := wc_slice_sheafify_scaled_iso Xt.left (wcGeomPoint K Xt hXt)
    (wcGeomFrob K Xt hXt) (wcRootTwistPre Xt.left (ℓ ^ k) 1) (wcZModSheaf Xt.left (ℓ ^ k)) ρ
    (Nat.card K ^ 1) hρi hρs hρF
  obtain ⟨Θ1, hΘ1b, hΘ1F⟩ := wc_lfi_coker_scaled_transport Xt.left (wcGeomPoint K Xt hXt)
    (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)) (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))
    (wcGeomFrob K Xt hXt) b hab Ψt hΨt (wcRootTwist Xt.left (ℓ ^ k) 1)
    (wcContSheaf Xt.left (ZMod (ℓ ^ k))) φ (Nat.card K ^ 1) hφiso hφF m

  obtain ⟨κ, hκ⟩ := wc_proet_closed_coker_geom_push_iso K Xt E iE hiE hiEX hln Ot hOt hXt hE
  have hκΨ := hκ Ψt hΨt
  let K1 := (Abelian.Ext.mk₀ κ.hom).precomp (wcRootTwist Xt.left (ℓ ^ k) 1) (zero_add m)
  have hK1 : Function.Injective K1 := by
    intro z₁ z₂ h
    change (Abelian.Ext.mk₀ κ.hom).comp z₁ (zero_add m) =
      (Abelian.Ext.mk₀ κ.hom).comp z₂ (zero_add m) at h
    have h' := congrArg (fun w => (Abelian.Ext.mk₀ κ.inv).comp w (zero_add m)) h
    simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] at h'
    exact h'
  have h2 : ∀ w, K1 ((Abelian.Ext.mk₀ Ψt).comp w (zero_add m)) =
      (Abelian.Ext.mk₀ ((wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)))).comp
        (K1 w) (zero_add m) := by
    intro w
    change (Abelian.Ext.mk₀ κ.hom).comp ((Abelian.Ext.mk₀ Ψt).comp w (zero_add m)) (zero_add m) =
      (Abelian.Ext.mk₀ ((wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)))).comp
        ((Abelian.Ext.mk₀ κ.hom).comp w (zero_add m)) (zero_add m)
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hκΨ, ← Abelian.Ext.mk₀_comp_mk₀_assoc]

  haveI := wc_proet_push_closed_isLeftAdjoint_ab iE
  obtain ⟨Li, adjL, -, -⟩ := wc_proet_push_left_adjoint_free_nat iE
  haveI := wc_proet_push_closed_preservesFiniteColimits iE
  haveI : (wcProEtPush iE).IsRightAdjoint := ⟨_, ⟨adjL⟩⟩
  haveI : Limits.PreservesFiniteLimits (wcProEtPush iE) := inferInstance
  haveI : (wcProEtPush iE).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : (wcProEtPush iE).Additive := Functor.additive_of_preserves_binary_products _
  let adj := Adjunction.ofIsLeftAdjoint (wcProEtPush iE)
  haveI : ((wcProEtPush iE).rightAdjoint).Additive := Adjunction.right_adjoint_additive adj

  let I := injectiveResolution (wcRootTwist Xt.left (ℓ ^ k) 1)
  have hvan : ∀ q : ℕ, q ≠ 2 → Limits.IsZero (((((wcProEtPush iE).rightAdjoint).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex).homology q) := by
    intro q hq
    rcases Nat.lt_or_gt_of_ne hq with h | h
    · exact wc_smooth_divisor_proet_mu_shriek_low_vanish K Xt.hom d iE ℓ hℓK k
        (wcProEtPush iE).rightAdjoint adj I q h
    · exact wc_smooth_divisor_proet_mu_shriek_high_vanish K Xt.hom d iE ℓ hℓK k
        (wcProEtPush iE).rightAdjoint adj I q h
  obtain ⟨ψ, hψ⟩ := wc_smooth_divisor_proet_mu_shriek_top_iso K Xt.hom d iE ℓ hℓK k
    (wcProEtPush iE).rightAdjoint adj I
  haveI := hψ
  obtain ⟨τ, hτ⟩ := ext_shifted_degenerate_leray_bijective (wcProEtPush iE)
    (wcProEtPush iE).rightAdjoint adj (wcRootTwist Xt.left (ℓ ^ k) 1) I
    (wcContSheaf E.left (ZMod (ℓ ^ k))) 2 ψ hvan
  have hmm : m - 2 + 2 = m := by omega
  let gHom : Abelian.Ext (wcFreeSheaf E.left (wcGeomPoint K E hE))
      (wcContSheaf E.left (ZMod (ℓ ^ k))) (m - 2) →+
      Abelian.Ext ((wcProEtPush iE).obj (wcFreeSheaf E.left (wcGeomPoint K E hE)))
        (wcRootTwist Xt.left (ℓ ^ k) 1) m :=
    AddMonoidHom.mk' (fun y => (Abelian.Ext.mapExactFunctor (wcProEtPush iE) y).comp τ hmm)
      (fun a c => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hg : Function.Bijective gHom :=
    hτ (wcFreeSheaf E.left (wcGeomPoint K E hE)) (m - 2) m hmm
  have h3 : ∀ y, gHom ((Abelian.Ext.mk₀ (wcFreeSheafMap E.left (wcGeomFrob K E hE))).comp y
      (zero_add (m - 2))) =
      (Abelian.Ext.mk₀ ((wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)))).comp
        (gHom y) (zero_add m) := by
    intro y
    show (Abelian.Ext.mapExactFunctor (wcProEtPush iE)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap E.left (wcGeomFrob K E hE))).comp y
          (zero_add (m - 2)))).comp τ hmm =
      (Abelian.Ext.mk₀ ((wcProEtPush iE).map (wcFreeSheafMap E.left (wcGeomFrob K E hE)))).comp
        ((Abelian.Ext.mapExactFunctor (wcProEtPush iE) y).comp τ hmm) (zero_add m)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add (m - 2)) hmm (by omega)

  let eΘ := AddEquiv.ofBijective Θ1 hΘ1b
  let eg := AddEquiv.ofBijective gHom hg
  have e6 : ∀ w, eg.symm (gHom w) = w := fun w => eg.symm_apply_apply w
  refine ⟨(eg.symm.toAddMonoidHom.comp K1).comp eΘ.symm.toAddMonoidHom, ?_, ?_⟩
  · exact eg.symm.injective.comp (hK1.comp eΘ.symm.injective)
  · intro z
    obtain ⟨y, rfl⟩ := hΘ1b.2 z
    have e1 : (Abelian.Ext.mk₀ Ψt).comp (Θ1 y) (zero_add m) =
        Θ1 ((Nat.card K ^ 1) • (Abelian.Ext.mk₀ Ψt).comp y (zero_add m)) := by
      rw [map_nsmul, hΘ1F]
    have e2 : eΘ.symm (Θ1 y) = y := eΘ.symm_apply_apply y
    have e3 : eΘ.symm (Θ1 ((Nat.card K ^ 1) • (Abelian.Ext.mk₀ Ψt).comp y (zero_add m))) =
        (Nat.card K ^ 1) • (Abelian.Ext.mk₀ Ψt).comp y (zero_add m) := eΘ.symm_apply_apply _
    have e4 : gHom (eg.symm (K1 y)) = K1 y := eg.apply_symm_apply (K1 y)
    have e5 : K1 ((Abelian.Ext.mk₀ Ψt).comp y (zero_add m)) =
        gHom ((Abelian.Ext.mk₀ (wcFreeSheafMap E.left (wcGeomFrob K E hE))).comp
          (eg.symm (K1 y)) (zero_add (m - 2))) := by
      rw [h3, e4, h2]
    show eg.symm (K1 (eΘ.symm ((Abelian.Ext.mk₀ Ψt).comp (Θ1 y) (zero_add m)))) =
      Nat.card K • (Abelian.Ext.mk₀ (wcFreeSheafMap E.left (wcGeomFrob K E hE))).comp
        (eg.symm (K1 (eΘ.symm (Θ1 y)))) (zero_add (m - 2))
    rw [e1, e3, e2, map_nsmul, e5, map_nsmul, e6, pow_one]

theorem wc_odp_fibre_sing_point (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i)) :
    ∃ xb : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀)).left,
      Set.range (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
            ((wcProEtPullback D.f).obj V₀))).left = {xb}ᶜ ∧
      (∀ φ : (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
            ((wcProEtPullback D.f).obj V₀) ⟶
          (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
            ((wcProEtPullback D.f).obj V₀), φ.left xb = xb) ∧
      IsLocallyNoetherian ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).left ∧
      QuasiSeparatedSpace ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).left ∧
      IsSepClosed (IsLocalRing.ResidueField
        (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).left.presheaf.stalk xb)) :=
by
  classical

  have resid : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (p : Y ⟶ Spec (.of K))
      [LocallyOfFiniteType p] (y : Y), IsClosed ({y} : Set Y) →
      IsAlgClosed (IsLocalRing.ResidueField (Y.presheaf.stalk y)) := by
    intro K _ _ Y p _ y hy
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
    haveI h2 : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    haveI h3 : LocallyOfFiniteType (Y.fromSpecResidueField y ≫ p) := inferInstance
    obtain ⟨φ, hφeq⟩ := Spec.map_surjective (Y.fromSpecResidueField y ≫ p)
    have h4 : LocallyOfFiniteType (Spec.map φ) := by rw [hφeq]; exact h3
    have hφ : φ.hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h4
    letI : Algebra K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) := φ.hom.toAlgebra
    haveI : Algebra.FiniteType K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      RingHom.finiteType_algebraMap.mp hφ
    haveI : Module.Finite K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      finite_of_finite_type_of_isJacobsonRing K _
    haveI : Algebra.IsIntegral K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      Algebra.IsIntegral.of_finite K _
    have hb := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K)
      (K := IsLocalRing.ResidueField (Y.presheaf.stalk y))
    exact IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective _ hb)

  have fibre_lemma : ∀ {Tl Xs Q : Scheme.{u}} (Th : Tl ⟶ Xs) (p₀ : Q ⟶ Xs) [Subsingleton Q]
      (q : Q) (_E : Limits.pullback Th p₀ ≅ Spec (.of (AlgebraicClosure F''))),
      ∃ xb : Tl, ∀ t : Tl, Th t = p₀ q ↔ t = xb := by
    intro Tl Xs Q Th p₀ _ q E
    haveI hsubb : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure F'')); infer_instance
    have hPsub : ∀ z z' : ↥(Limits.pullback (C := Scheme.{u}) Th p₀), z = z' := by
      intro z z'
      exact E.hom.isOpenEmbedding.injective (Subsingleton.elim (E.hom z) (E.hom z'))
    refine ⟨Limits.pullback.fst Th p₀ (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F''))),
      fun t => ⟨fun ht => ?_, ?_⟩⟩
    · obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback t q ht
      rw [← hz1, hPsub z]
    · rintro rfl
      have hc := congrArg (fun g : Limits.pullback Th p₀ ⟶ Xs =>
        g (E.inv (IsLocalRing.closedPoint (AlgebraicClosure F''))))
        (Limits.pullback.condition (f := Th) (g := p₀))
      simp only [Scheme.Hom.comp_apply] at hc
      exact hc.trans (congrArg (fun x => p₀ x) (Subsingleton.elim _ _))
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance

  have hSi : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hι : IsClosedImmersion (Limits.pullback.fst D.f (D.S i)) := by
    haveI := hSi
    first
      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback D.f (D.S i)).flip hSi
      | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback D.f (D.S i)) hSi
  have hιinj : Function.Injective ⇑(Limits.pullback.fst D.f (D.S i)) := by
    haveI := hι
    first
      | exact (Limits.pullback.fst D.f (D.S i)).isClosedEmbedding.injective
      | exact (IsClosedImmersion.isClosedEmbedding (Limits.pullback.fst D.f (D.S i))).injective
      | exact IsClosedImmersion.base_closed.injective
  have hxsCI : IsClosedImmersion (D.xs i) := by
    apply isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hclos : closure ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) =
      {D.xs i (IsLocalRing.closedPoint F'')} := by
    have hrange : Set.range ⇑(D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        exact Set.mem_singleton _
      · intro hy
        rw [Set.mem_singleton_iff] at hy
        exact ⟨_, hy.symm⟩
    have hc : IsClosed (Set.range ⇑(D.xs i)) := by
      haveI := hxsCI
      first
        | exact (D.xs i).isClosedEmbedding.isClosed_range
        | exact (IsClosedImmersion.isClosedEmbedding (D.xs i)).isClosed_range
        | exact IsClosedImmersion.base_closed.isClosed_range
    rw [hrange] at hc
    exact hc.closure_eq
  have hmemO : ∀ y, y ∈ (wcCritPunctOpen D i : (Limits.pullback D.f (D.S i)).Opens) ↔
      ¬ Limits.pullback.fst D.f (D.S i) y = D.xs i (IsLocalRing.closedPoint F'') := by
    intro y
    have h1 : (¬ Limits.pullback.fst D.f (D.S i) y = D.xs i (IsLocalRing.closedPoint F'')) ↔
        Limits.pullback.fst D.f (D.S i) y ∈
          (closure ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left))ᶜ := by
      rw [hclos]; simp
    rw [h1]
    all_goals first
      | exact Iff.rfl
      | simp [wcCritPunctOpen, Scheme.Hom.mem_preimage]

  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : Spec (.of F'') ⟶ Limits.pullback D.f (D.S i),
      p₀ ≫ Limits.pullback.fst D.f (D.S i) = D.xs i :=
    ⟨Limits.pullback.lift (D.xs i) (𝟙 _) (by rw [D.hxs i, Category.id_comp]),
      Limits.pullback.lift_fst _ _ _⟩
  have hpt : ∀ y, Limits.pullback.fst D.f (D.S i) y = D.xs i (IsLocalRing.closedPoint F'') ↔
      y = p₀ (IsLocalRing.closedPoint F'') := by
    have h0 : Limits.pullback.fst D.f (D.S i) (p₀ (IsLocalRing.closedPoint F'')) =
        D.xs i (IsLocalRing.closedPoint F'') := by
      first
        | rw [← hp₀, Scheme.Hom.comp_apply]
        | (rw [← hp₀]; rfl)
    intro y
    constructor
    · intro hy; exact hιinj (hy.trans h0.symm)
    · rintro rfl; exact h0

  haveI hYp := D.proper
  haveI : LocallyOfFiniteType (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : QuasiSeparated (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI hfL : LocallyOfFiniteType D.f := locallyOfFiniteType_of_comp D.f (wcP1Over F'').hom
  haveI hfQ : QuasiSeparated D.f := QuasiSeparated.of_comp D.f (wcP1Over F'').hom
  have hπL : LocallyOfFiniteType (Limits.pullback.snd D.f (D.S i)) := by
    first
      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
          (IsPullback.of_hasPullback D.f (D.S i)) hfL
      | exact MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
          (IsPullback.of_hasPullback D.f (D.S i)).flip hfL
  have hπQ : QuasiSeparated (Limits.pullback.snd D.f (D.S i)) := by
    first
      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @QuasiSeparated)
          (IsPullback.of_hasPullback D.f (D.S i)) hfQ
      | exact MorphismProperty.of_isPullback (P := @QuasiSeparated)
          (IsPullback.of_hasPullback D.f (D.S i)).flip hfQ

  have Sq1 : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) :=
    IsPullback.of_hasPullback _ _
  have Sq2 : IsPullback (Limits.pullback.fst V₀.hom D.f) (Limits.pullback.snd V₀.hom D.f)
      V₀.hom D.f := IsPullback.of_hasPullback _ _
  have Big := Sq1.paste_horiz Sq2
  rw [Limits.pullback.condition (f := D.f) (g := D.S i)] at Big
  have Sq3 : IsPullback (Limits.pullback.fst V₀.hom (D.S i)) (Limits.pullback.snd V₀.hom (D.S i))
      V₀.hom (D.S i) := IsPullback.of_hasPullback _ _
  have key : ∀ {A' : Scheme.{u}} (r : A' ⟶ Limits.pullback V₀.hom (D.S i))
      (v : A' ⟶ Limits.pullback D.f (D.S i)),
      IsPullback r v (Limits.pullback.snd V₀.hom (D.S i)) (Limits.pullback.snd D.f (D.S i)) →
      ∃ p : A' ⟶ Spec (.of (AlgebraicClosure F'')), LocallyOfFiniteType p ∧ QuasiSeparated p := by
    intro A' r v hsq
    have hrL : LocallyOfFiniteType r := by
      first
        | exact MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hsq.flip hπL
        | exact MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hsq hπL
    have hrQ : QuasiSeparated r := by
      first
        | exact MorphismProperty.of_isPullback (P := @QuasiSeparated) hsq.flip hπQ
        | exact MorphismProperty.of_isPullback (P := @QuasiSeparated) hsq hπQ
    refine ⟨r ≫ ε.hom, ?_, ?_⟩
    · haveI := hrL; infer_instance
    · haveI := hrQ; infer_instance

  set T := (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
    ((wcProEtPullback D.f).obj V₀) with hT
  obtain ⟨p, hpL, hpQ⟩ : ∃ p : T.left ⟶ Spec (.of (AlgebraicClosure F'')),
      LocallyOfFiniteType p ∧ QuasiSeparated p :=
    key _ _ (IsPullback.of_right' Big Sq3)
  have E : Limits.pullback T.hom p₀ ≅ Spec (.of (AlgebraicClosure F'')) :=
    Limits.pullbackLeftPullbackSndIso (Limits.pullback.snd V₀.hom D.f)
        (Limits.pullback.fst D.f (D.S i)) p₀ ≪≫
      Limits.pullback.congrHom rfl hp₀ ≪≫
      Limits.pullbackLeftPullbackSndIso V₀.hom D.f (D.xs i) ≪≫
      Limits.pullback.congrHom rfl (D.hxs i) ≪≫ ε
  obtain ⟨xb, hxb0⟩ := fibre_lemma T.hom p₀ (IsLocalRing.closedPoint F'') E
  have hxb : ∀ t : T.left, Limits.pullback.fst D.f (D.S i) (T.hom t) =
      D.xs i (IsLocalRing.closedPoint F'') ↔ t = xb := fun t => (hpt _).trans (hxb0 t)
  have hrange1 : Set.range ⇑(wcOpenRestrIncl (Limits.pullback D.f (D.S i))
      (wcCritPunctOpen D i) T).left = {xb}ᶜ := by
    show Set.range ⇑(Limits.pullback.snd (wcCritPunctOpen D i).ι T.hom) = {xb}ᶜ
    rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
    ext t
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
    exact (hmemO _).trans (not_congr (hxb t))
  refine ⟨xb, hrange1, ?_, ?_, ?_, ?_⟩
  · intro φ
    have h1 : (φ.left ≫ T.hom) xb = T.hom xb := by rw [MorphismProperty.Over.w φ]
    rw [Scheme.Hom.comp_apply] at h1
    exact (hxb (φ.left xb)).mp
      ((congrArg (fun y => Limits.pullback.fst D.f (D.S i) y) h1).trans ((hxb xb).mpr rfl))
  · haveI := hpL
    exact LocallyOfFiniteType.isLocallyNoetherian p
  · haveI := hpQ
    exact quasiSeparatedSpace_of_quasiSeparated p
  · have hopen : IsOpen (Set.range ⇑(wcOpenRestrIncl (Limits.pullback D.f (D.S i))
        (wcCritPunctOpen D i) T).left) := by
      show IsOpen (Set.range ⇑(Limits.pullback.snd (wcCritPunctOpen D i).ι T.hom))
      exact (Limits.pullback.snd (wcCritPunctOpen D i).ι T.hom).isOpenEmbedding.isOpen_range
    rw [hrange1] at hopen
    have hcl : IsClosed ({xb} : Set T.left) := isOpen_compl_iff.mp hopen
    haveI := hpL
    haveI := resid (AlgebraicClosure F'') T.left p xb hcl
    first
      | infer_instance
      | exact IsSepClosed.of_isAlgClosed _

theorem wc_mpq_crit_germ_excision_data (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (VT : D.Yt.left.ProEt) (jc : VT ⟶ Th)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (xb' : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀)).left)
    (hxb' : Set.range (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀))).left = {xb'}ᶜ) :
    CompactSpace ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th).left ∧
    Set.range ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map jc).left =
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map g).left ⁻¹' {xb'}ᶜ ∧
    IsIso (Limits.pullback.snd ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map g).left
      (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀)).left.fromSpecResidueField xb')) :=
by
  classical

  have E1 : ∀ {S T : Scheme.{u}} (f : T ⟶ S) {A B : S.ProEt} (a : A ⟶ B),
      ((wcProEtPullback f).map a).left ≫ Limits.pullback.fst B.hom f =
        Limits.pullback.fst A.hom f ≫ a.left := by
    intro S T f A B a
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have E2 : ∀ {S T : Scheme.{u}} (f : T ⟶ S) {A B : S.ProEt} (a : A ⟶ B),
      ((wcProEtPullback f).map a).left ≫ Limits.pullback.snd B.hom f =
        Limits.pullback.snd A.hom f := by
    intro S T f A B a
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_snd _ _ _)

  have hres : ∀ {X₁ Y₁ : Scheme.{u}} (f : X₁ ⟶ Y₁) [IsClosedImmersion f] (x : X₁),
      IsIso (f.residueFieldMap x) := by
    intro X₁ Y₁ f _ x
    rw [ConcreteCategory.isIso_iff_bijective]
    refine ⟨RingHom.injective _, ?_⟩
    intro y
    obtain ⟨s, rfl⟩ := Scheme.residue_surjective X₁ x y
    obtain ⟨t, rfl⟩ := f.stalkMap_surjective x s
    refine ⟨Y₁.residue (f x) t, ?_⟩
    have h := ConcreteCategory.congr_hom (Scheme.residue_residueFieldMap f x) t
    first
      | exact h
      | (simp only [CategoryTheory.comp_apply] at h; exact h)
      | (simpa using h)

  have R3 : ∀ {S Z T₀ W₀ U₀ : Scheme.{u}} (ι : Z ⟶ S) [IsClosedImmersion ι]
      (tW : W₀ ⟶ S) (tT : T₀ ⟶ S) (tV : U₀ ⟶ S) (gl : T₀ ⟶ W₀) (jl : U₀ ⟶ T₀)
      (hj : jl ≫ tT = tV)
      (g' : Limits.pullback tT ι ⟶ Limits.pullback tW ι)
      (J : Limits.pullback tV ι ⟶ Limits.pullback tT ι)
      (e1g : g' ≫ Limits.pullback.fst tW ι = Limits.pullback.fst tT ι ≫ gl)
      (e1j : J ≫ Limits.pullback.fst tT ι = Limits.pullback.fst tV ι ≫ jl)
      (e2j : J ≫ Limits.pullback.snd tT ι = Limits.pullback.snd tV ι)
      (c : T₀) (xb : W₀) (hpre : gl ⁻¹' {xb} = {c}) (hrc : Set.range jl = {c}ᶜ)
      (x : ↥(Limits.pullback tW ι)) (hx : Limits.pullback.fst tW ι x = xb),
      Set.range J = g' ⁻¹' {x}ᶜ := by
    intro S Z T₀ W₀ U₀ ι _ tW tT tV gl jl hj g' J e1g e1j e2j c xb hpre hrc x hx
    have e : J = Limits.pullback.map tV ι tT ι jl (𝟙 Z) (𝟙 S)
        ((Category.comp_id _).trans hj.symm)
        ((Category.comp_id ι).trans (Category.id_comp ι).symm) := by
      apply Limits.pullback.hom_ext
      · exact e1j.trans (Limits.pullback.lift_fst _ _ _).symm
      · exact e2j.trans ((Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)).symm
    have hinj : Function.Injective (Limits.pullback.fst tW ι) :=
      (Limits.pullback.fst tW ι).isClosedEmbedding.injective
    have hpt : ∀ p, Limits.pullback.fst tW ι (g' p) = gl (Limits.pullback.fst tT ι p) := by
      intro p
      rw [← Scheme.Hom.comp_apply, e1g, Scheme.Hom.comp_apply]
    have hkey : ∀ p, g' p = x ↔ Limits.pullback.fst tT ι p = c := by
      intro p
      constructor
      · intro h
        have h3 : gl (Limits.pullback.fst tT ι p) = xb := by rw [← hpt, h, hx]
        have h4 : Limits.pullback.fst tT ι p ∈ gl ⁻¹' {xb} := h3
        rw [hpre] at h4
        exact h4
      · intro h
        apply hinj
        have h5 : c ∈ gl ⁻¹' {xb} := by rw [hpre]; rfl
        rw [hpt, h, hx]
        exact h5
    rw [e, Scheme.Pullback.range_map, hrc]
    ext p
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff,
      hkey]
    constructor
    · exact fun h => h.1
    · intro h
      refine ⟨h, ?_⟩
      first
        | exact ⟨_, rfl⟩
        | simp

  have R4 : ∀ {S Z T₀ W₀ : Scheme.{u}} (ι : Z ⟶ S) [IsClosedImmersion ι]
      (tW : W₀ ⟶ S) (tT : T₀ ⟶ S) (gl : T₀ ⟶ W₀) (hw : gl ≫ tW = tT)
      (g' : Limits.pullback tT ι ⟶ Limits.pullback tW ι)
      (e1g : g' ≫ Limits.pullback.fst tW ι = Limits.pullback.fst tT ι ≫ gl)
      (e2g : g' ≫ Limits.pullback.snd tW ι = Limits.pullback.snd tT ι)
      (x : ↥(Limits.pullback tW ι))
      (hfib : IsIso (Limits.pullback.snd gl
        (W₀.fromSpecResidueField (Limits.pullback.fst tW ι x)))),
      IsIso (Limits.pullback.snd g' ((Limits.pullback tW ι).fromSpecResidueField x)) := by
    intro S Z T₀ W₀ ι _ tW tT gl hw g' e1g e2g x hfib
    have hR : IsPullback (Limits.pullback.snd tW ι) (Limits.pullback.fst tW ι) ι tW :=
      (IsPullback.of_hasPullback tW ι).flip
    have hBig : IsPullback (g' ≫ Limits.pullback.snd tW ι)
        (Limits.pullback.fst tT ι) ι (gl ≫ tW) := by
      rw [e2g, hw]
      exact (IsPullback.of_hasPullback tT ι).flip
    have Sq : IsPullback g' (Limits.pullback.fst tT ι) (Limits.pullback.fst tW ι) gl :=
      IsPullback.of_right hBig e1g hR
    haveI := hres (Limits.pullback.fst tW ι) x
    have hc : (Limits.pullback tW ι).fromSpecResidueField x ≫ Limits.pullback.fst tW ι =
        Spec.map ((Limits.pullback.fst tW ι).residueFieldMap x) ≫
          W₀.fromSpecResidueField (Limits.pullback.fst tW ι x) :=
      (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField _ x).symm
    have P1 := IsPullback.of_hasPullback g' ((Limits.pullback tW ι).fromSpecResidueField x)
    have Big2 := P1.paste_horiz Sq.flip
    rw [hc] at Big2
    have w : (Limits.pullback.fst g' ((Limits.pullback tW ι).fromSpecResidueField x) ≫
          Limits.pullback.fst tT ι) ≫ gl =
        (Limits.pullback.snd g' ((Limits.pullback tW ι).fromSpecResidueField x) ≫
          Spec.map ((Limits.pullback.fst tW ι).residueFieldMap x)) ≫
          W₀.fromSpecResidueField (Limits.pullback.fst tW ι x) :=
      Big2.w.trans (Category.assoc _ _ _).symm
    have Big3 : IsPullback (Limits.pullback.lift _ _ w ≫ Limits.pullback.fst gl
          (W₀.fromSpecResidueField (Limits.pullback.fst tW ι x)))
        (Limits.pullback.snd g' ((Limits.pullback tW ι).fromSpecResidueField x)) gl
        (Spec.map ((Limits.pullback.fst tW ι).residueFieldMap x) ≫
          W₀.fromSpecResidueField (Limits.pullback.fst tW ι x)) := by
      rw [Limits.pullback.lift_fst]
      exact Big2
    have Sq2 := IsPullback.of_right Big3 (Limits.pullback.lift_snd _ _ w)
      (IsPullback.of_hasPullback gl (W₀.fromSpecResidueField (Limits.pullback.fst tW ι x)))
    exact Sq2.flip.isIso_fst_of_isIso

  haveI : IsClosedImmersion (D.S i) := isClosedImmersion_of_comp_eq_id _ _ (D.hS i)

  have hlies : Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom
      (Limits.pullback.fst D.f (D.S i)) xb' = xb := by
    have hsec : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
      rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
    have hci : IsClosedImmersion (D.xs i) := isClosedImmersion_of_comp_eq_id _ _ hsec
    have hrange : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        exact Set.mem_singleton_iff.mpr
          (congrArg (fun b => D.xs i b) (Subsingleton.elim a (IsLocalRing.closedPoint F'')))
      · intro hy
        exact ⟨_, (Set.mem_singleton_iff.mp hy).symm⟩
    have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
      rw [← hrange]
      exact (D.xs i).isClosedEmbedding.isClosed_range
    have hfibW : ∀ w w' : ((wcProEtPullback D.f).obj V₀).left,
        ((wcProEtPullback D.f).obj V₀).hom w = D.xs i (IsLocalRing.closedPoint F'') →
        ((wcProEtPullback D.f).obj V₀).hom w' = D.xs i (IsLocalRing.closedPoint F'') →
        w = w' := by
      intro w w' hw hw'
      obtain ⟨p, hp, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w (IsLocalRing.closedPoint F'') hw
      obtain ⟨p', hp', -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.snd V₀.hom D.f) (g := D.xs i) w' (IsLocalRing.closedPoint F'') hw'
      let E : Limits.pullback (Limits.pullback.snd V₀.hom D.f) (D.xs i) ≅
          Spec (.of (AlgebraicClosure F'')) :=
        Limits.pullbackLeftPullbackSndIso V₀.hom D.f (D.xs i) ≪≫
          Limits.pullback.congrHom rfl (D.hxs i) ≪≫ ε
      have hpp : p = p' := by
        calc p = E.inv (E.hom p) := (Scheme.hom_inv_apply E p).symm
          _ = E.inv (E.hom p') := by rw [Subsingleton.elim (E.hom p) (E.hom p')]
          _ = p' := Scheme.hom_inv_apply E p'
      rw [← hp, ← hp', hpp]
    have hn : xb' ∉ Set.range (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀))).left := by
      rw [hxb']
      exact fun h => h rfl
    have hU : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).hom xb' ∉ wcCritPunctOpen D i := by
      intro hmem
      apply hn
      show xb' ∈ Set.range (Limits.pullback.snd (wcCritPunctOpen D i).ι
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).hom)
      rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
      exact hmem
    have hcl : Limits.pullback.fst D.f (D.S i)
        (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).hom xb') ∈
        closure {D.xs i (IsLocalRing.closedPoint F'')} := by
      by_contra hc
      apply hU
      rw [wcCritPunctOpen, Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_mk,
        Set.mem_compl_iff]
      exact hc
    rw [hclosed.closure_eq, Set.mem_singleton_iff] at hcl
    have h2 : ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst
          ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f (D.S i)) xb') =
        Limits.pullback.fst D.f (D.S i) (Limits.pullback.snd
          ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f (D.S i)) xb') := by
      have a := Scheme.Hom.comp_apply (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom
        (Limits.pullback.fst D.f (D.S i))) ((wcProEtPullback D.f).obj V₀).hom xb'
      have b := Scheme.Hom.comp_apply (Limits.pullback.snd ((wcProEtPullback D.f).obj V₀).hom
        (Limits.pullback.fst D.f (D.S i))) (Limits.pullback.fst D.f (D.S i)) xb'
      rw [Limits.pullback.condition] at a
      rw [← a, ← b]
    have h3 : ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst
          ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f (D.S i)) xb') =
        D.xs i (IsLocalRing.closedPoint F'') := by
      rw [h2]
      exact hcl
    exact hfibW _ _ h3 hxb

  haveI hι : IsClosedImmersion (Limits.pullback.fst D.f (D.S i)) := inferInstance
  have hcpt : CompactSpace
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj Th).left := by
    haveI hTc : CompactSpace Th.left := (Scheme.homeoOfIso eB.symm).compactSpace
    have hq : QuasiCompact (Limits.pullback.fst Th.hom (Limits.pullback.fst D.f (D.S i))) :=
      inferInstance
    have hc := @QuasiCompact.compactSpace_of_compactSpace _ _
      (Limits.pullback.fst Th.hom (Limits.pullback.fst D.f (D.S i))) hq hTc
    exact hc

  refine ⟨hcpt, ?_, ?_⟩
  · exact R3 (Limits.pullback.fst D.f (D.S i)) ((wcProEtPullback D.f).obj V₀).hom Th.hom VT.hom
      g.left jc.left (MorphismProperty.Over.w jc)
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map g).left
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map jc).left
      (E1 _ g) (E1 _ jc) (E2 _ jc) _ xb hpre hrc xb' hlies
  · have hfib' : IsIso (Limits.pullback.snd g.left
        (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField
          (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom
            (Limits.pullback.fst D.f (D.S i)) xb'))) := by
      subst hlies
      exact hfib
    exact R4 (Limits.pullback.fst D.f (D.S i)) ((wcProEtPullback D.f).obj V₀).hom Th.hom
      g.left (MorphismProperty.Over.w g)
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map g).left
      (E1 _ g) (E2 _ g) xb' hfib'

theorem wc_even_quadric_zmod_all_odd_vanish (K : Type u) [Field K] [Finite K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (d : ℕ) (hd : Even d) (E₀ : Over (Spec (.of K)))
    (hpr : IsProper E₀.hom) (hsm : SmoothOfRelativeDimension d E₀.hom)
    (jE : E₀.left ⟶ wcProjK K (d + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (d + 1) = E₀.hom)
    (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (hEG : ∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) c),
      wcLdpGerm K (d + 1) jE (wcLdpQuad K (d + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (k q : ℕ) (hq : Odd q) :
    ∀ x : wcCohG K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) q, x = 0 :=
by
  classical
  haveI := hpr
  haveI := hsm
  intro x
  have hℓp : ℓ.Prime := Fact.out
  cases k with
  | zero =>
    have hzero0 : (𝟙 (wcContSheaf E₀.left (ZMod (ℓ ^ 0))) : _ ⟶ _) = 0 := by
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply AddCommGrpCat.ext
      intro y
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      exact Subsingleton.elim _ _
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = 0 := by rw [hzero0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  | succ n =>
    have hg1 : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
      intro h
      have hK : ((ℓ : ℕ) : K) = 0 := by
        apply (algebraMap K (AlgebraicClosure K)).injective
        rw [map_natCast, map_zero]
        exact h
      haveI := Fintype.ofFinite K
      have hp : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
      have h1 : ringChar K ∣ ℓ := ringChar.dvd hK
      have h2 : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hp hℓp).mp h1
      have h3 : ((Fintype.card K : ℕ) : K) = 0 := FiniteField.cast_card_eq_zero K
      have h4 : ringChar K ∣ Fintype.card K := ringChar.dvd h3
      apply hℓ
      rw [← h2, Nat.card_eq_fintype_card]
      exact h4
    haveI hP : IsProper (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
    haveI hS : SmoothOfRelativeDimension d (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension d)
        (IsPullback.of_hasPullback E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ‹_›
    have hEt : Subsingleton (wcEtCoh (Limits.pullback E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ (n + 1)) q) := by
      apply wc_et_coh_zmod_prime_pow_of_prime _ ℓ hℓp
      obtain ⟨jΩ, hjΩ, hjΩY, hgermΩ⟩ :=
        wc_quadric_germ_base_change K (AlgebraicClosure K) (d + 1) E₀ jE hjE hjEY a hEG
      have hAdet : ((Matrix.of a).map (algebraMap K (AlgebraicClosure K)) +
          ((Matrix.of a).map (algebraMap K (AlgebraicClosure K))).transpose).det ≠ 0 := by
        have e1 : (Matrix.of a).map (algebraMap K (AlgebraicClosure K)) +
            ((Matrix.of a).map (algebraMap K (AlgebraicClosure K))).transpose =
            (Matrix.of a + (Matrix.of a).transpose).map (algebraMap K (AlgebraicClosure K)) := by
          rw [Matrix.map_add _ (fun x y => map_add (algebraMap K (AlgebraicClosure K)) x y),
            Matrix.transpose_map]
        have e2 : ((Matrix.of a + (Matrix.of a).transpose).map
            (algebraMap K (AlgebraicClosure K))).det =
            algebraMap K (AlgebraicClosure K) (Matrix.of a + (Matrix.of a).transpose).det :=
          (RingHom.map_det _ _).symm
        rw [e1, e2]
        exact (map_ne_zero _).mpr ha
      obtain ⟨P, hPdet, hPeq⟩ := wc_quadric_split_normal_form_alg_closed (AlgebraicClosure K) d hd
        ((Matrix.of a).map (algebraMap K (AlgebraicClosure K))) hAdet
      obtain ⟨jY, hjY, hjYY, hgermY⟩ := wc_quadric_germ_linear_change (AlgebraicClosure K) (d + 1)
        _ (Limits.pullback.snd E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) jΩ hjΩ hjΩY
        ((Matrix.of a).map (algebraMap K (AlgebraicClosure K)))
        (fun w c hw => hgermΩ w c hw) P hPdet
      exact wc_et_split_quadric_all_odd_vanish (AlgebraicClosure K) ℓ hg1 d hd _
        (Limits.pullback.snd E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) jY hjY hjYY
        (fun w c hw => by rw [← hPeq]; exact hgermY w c hw) q hq
    have hEt' : Subsingleton (wcEtCoh (wcGeomPoint K E₀ hE).left (ℓ ^ (n + 1)) q) := hEt
    have hfY : IsProper (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          (wcGeomPoint K E₀ hE).left ⟶ Spec (.of (AlgebraicClosure K))) := hP
    obtain ⟨e3⟩ := @wc_proet_etale_comparison_zmod (AlgebraicClosure K) _
      (wcGeomPoint K E₀ hE).left
      (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          (wcGeomPoint K E₀ hE).left ⟶ Spec (.of (AlgebraicClosure K))) hfY (ℓ ^ (n + 1)) q
    obtain ⟨c₁⟩ := wc_contSheaf_discrete_const (wcGeomPoint K E₀ hE).left (ZMod (ℓ ^ (n + 1)))
    obtain ⟨c₂⟩ := wc_zmod_sheaf_const (wcGeomPoint K E₀ hE).left (ℓ ^ (n + 1))
    have hZ : ∀ z : Abelian.Ext (wcFreeSheaf (wcGeomPoint K E₀ hE).left
        (Scheme.ProEt.mk (𝟙 (wcGeomPoint K E₀ hE).left)))
        (wcContSheaf (wcGeomPoint K E₀ hE).left (ZMod (ℓ ^ (n + 1)))) q, z = 0 := by
      intro z
      haveI := hEt'
      haveI := e3.subsingleton
      have h1 : z.comp (Abelian.Ext.mk₀ (c₁ ≪≫ c₂.symm).hom) (add_zero q) = 0 :=
        Subsingleton.elim _ _
      calc z = (z.comp (Abelian.Ext.mk₀ (c₁ ≪≫ c₂.symm).hom) (add_zero q)).comp
            (Abelian.Ext.mk₀ (c₁ ≪≫ c₂.symm).inv) (add_zero q) := by
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        _ = 0 := by rw [h1, Abelian.Ext.zero_comp]
    obtain ⟨E1⟩ := wc_ext_free_slice_cont E₀.left (wcGeomPoint K E₀ hE) (ZMod (ℓ ^ (n + 1))) q
    exact E1.injective ((hZ (E1 x)).trans (hZ (E1 0)).symm)

theorem wc_smooth_divisor_local_coh_low_vanish (K : Type u) [Field K] [Finite K]
    (Xt E : Over (Spec (.of K))) (hpXt : IsProper Xt.hom) (d : ℕ)
    (hsXt : SmoothOfRelativeDimension (d + 1) Xt.hom) (hpE : IsProper E.hom)
    (hsE : SmoothOfRelativeDimension d E.hom)
    (iE : E.left ⟶ Xt.left) (hiE : IsClosedImmersion iE) (hiEX : iE ≫ Xt.hom = E.hom)
    (Ot : Xt.left.Opens) (hOt : (Ot : Set Xt.left) = (Set.range iE)ᶜ)
    (hXt : WeaklyEtale (Limits.pullback.fst Xt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (hE : WeaklyEtale (Limits.pullback.fst E.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (k m : ℕ) (hm : m < 2) :
    ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Xt.left
        (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))))
      (wcContSheaf Xt.left (ZMod (ℓ ^ k))) m, z = 0 :=
by
  classical

  haveI := hsXt
  haveI := hsE
  haveI := hiE
  haveI : Smooth Xt.hom := SmoothOfRelativeDimension.smooth (d + 1) Xt.hom
  haveI hln : IsLocallyNoetherian Xt.left := LocallyOfFiniteType.isLocallyNoetherian Xt.hom
  haveI : SmoothOfRelativeDimension d (iE ≫ Xt.hom) := by rw [hiEX]; exact hsE
  have hℓK : (ℓ : K) ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite K
    obtain ⟨p, hp⟩ := CharP.exists K
    haveI := hp
    obtain ⟨n, hpprime, hcard⟩ := FiniteField.card K p
    have hpl : p ∣ ℓ := (CharP.cast_eq_zero_iff K p ℓ).mp h0
    have hpl' : p = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd p hpl).resolve_left hpprime.one_lt.ne'
    apply hℓ
    rw [← hpl', Nat.card_eq_fintype_card, hcard]
    exact dvd_pow_self p n.ne_zero
  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ φo : wcOpenRestr S O Tc ⟶ wcOpenRestr S O Tc,
        φo ≫ wcOpenRestrIncl S O Tc = wcOpenRestrIncl S O Tc ≫ φ := by
    intro S O Tc φ
    have w : φ.left ≫ Tc.hom = Tc.hom := MorphismProperty.Over.w φ
    have hc : Limits.pullback.fst O.ι Tc.hom ≫ O.ι =
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) ≫ Tc.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc ≫ (Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom) =
        Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ Tc.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨b, hab⟩ := Hres Ot (wcGeomPoint K Xt hXt) (wcGeomFrob K Xt hXt)

  have hdesc : wcFreeSheafMap Xt.left (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt)) ≫
      wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫
        Limits.cokernel.π (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) = 0 := by
    rw [← Category.assoc, ← F0, ← hab, F0, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  let Ψt := Limits.cokernel.desc _ (wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫
    Limits.cokernel.π (wcFreeSheafMap Xt.left
      (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt)))) hdesc
  have hΨt : Limits.cokernel.π (wcFreeSheafMap Xt.left
      (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) ≫ Ψt =
      wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫ Limits.cokernel.π (wcFreeSheafMap Xt.left
        (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))) :=
    Limits.cokernel.π_desc _ _ _

  obtain ⟨ρ, hρi, hρs, hρF⟩ := wc_root_twist_slice_presheaf_map K Xt ℓ hℓ hXt k 1
  obtain ⟨φ, hφiso, hφF⟩ := wc_slice_sheafify_scaled_iso Xt.left (wcGeomPoint K Xt hXt)
    (wcGeomFrob K Xt hXt) (wcRootTwistPre Xt.left (ℓ ^ k) 1) (wcZModSheaf Xt.left (ℓ ^ k)) ρ
    (Nat.card K ^ 1) hρi hρs hρF
  obtain ⟨Θ1, hΘ1b, -⟩ := wc_lfi_coker_scaled_transport Xt.left (wcGeomPoint K Xt hXt)
    (wcOpenRestr Xt.left Ot (wcGeomPoint K Xt hXt)) (wcOpenRestrIncl Xt.left Ot (wcGeomPoint K Xt hXt))
    (wcGeomFrob K Xt hXt) b hab Ψt hΨt (wcRootTwist Xt.left (ℓ ^ k) 1)
    (wcContSheaf Xt.left (ZMod (ℓ ^ k))) φ (Nat.card K ^ 1) hφiso hφF m

  obtain ⟨κ, -⟩ := wc_proet_closed_coker_geom_push_iso K Xt E iE hiE hiEX hln Ot hOt hXt hE

  haveI := wc_proet_push_closed_isLeftAdjoint_ab iE
  let adj := Adjunction.ofIsLeftAdjoint (wcProEtPush iE)
  haveI := adj.rightAdjoint_preservesLimits
  haveI : ((wcProEtPush iE).rightAdjoint).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : ((wcProEtPush iE).rightAdjoint).Additive :=
    Functor.additive_of_preserves_binary_products _
  let I := injectiveResolution (wcRootTwist Xt.left (ℓ ^ k) 1)
  have h0 := wc_smooth_divisor_proet_mu_shriek_low_vanish K Xt.hom d iE ℓ hℓK k
    (wcProEtPush iE).rightAdjoint adj I 0 (by norm_num)
  have h1 := wc_smooth_divisor_proet_mu_shriek_low_vanish K Xt.hom d iE ℓ hℓK k
    (wcProEtPush iE).rightAdjoint adj I 1 (by norm_num)

  have hw : ∀ (m' : ℕ), m' < 2 → ∀ x : Abelian.Ext ((wcProEtPush iE).obj
      (wcFreeSheaf E.left (wcGeomPoint K E hE))) (wcRootTwist Xt.left (ℓ ^ k) 1) m', x = 0 := by
    intro m' hm'
    set R := (wcProEtPush iE).rightAdjoint with hR
    set P := wcFreeSheaf E.left (wcGeomPoint K E hE) with hP
    set J := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hJ
    have hmono : Mono (R.map (I.cocomplex.d 0 1)) := by
      have hex : J.ExactAt 0 := (HomologicalComplex.exactAt_iff_isZero_homology J 0).mpr h0
      rw [HomologicalComplex.exactAt_iff' J 0 0 1 (by simp) (by simp)] at hex
      have hz : (J.sc' 0 0 1).f = 0 := J.shape 0 0 (by simp)
      exact hex.mono_g hz
    have hex1 : (J.sc' 0 1 2).Exact := by
      have hex : J.ExactAt 1 := (HomologicalComplex.exactAt_iff_isZero_homology J 1).mpr h1
      rwa [HomologicalComplex.exactAt_iff' J 0 1 2 (by simp) (by simp)] at hex
    have hnat : ∀ {n n' : ℕ} (f : (wcProEtPush iE).obj P ⟶ I.cocomplex.X n),
        adj.homEquiv _ _ (f ≫ I.cocomplex.d n n') =
          adj.homEquiv _ _ f ≫ R.map (I.cocomplex.d n n') := fun f =>
      adj.homEquiv_naturality_right f _
    have hzero : ∀ {n : ℕ}, adj.homEquiv P (I.cocomplex.X n) 0 = 0 := by
      intro n
      rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
    interval_cases m'
    · intro x
      obtain ⟨f, hf, hx⟩ := I.extMk_surjective x 1 rfl
      rw [← hx]
      have h1' : adj.homEquiv _ _ f ≫ R.map (I.cocomplex.d 0 1) =
          0 ≫ R.map (I.cocomplex.d 0 1) := by
        rw [← hnat, hf, hzero, Limits.zero_comp]
      have h2 : adj.homEquiv _ _ f = adj.homEquiv _ _ 0 := by
        rw [hzero]; exact (cancel_mono _).mp h1'
      have hf0 : f = 0 := (adj.homEquiv _ _).injective h2
      subst hf0
      exact I.extMk_zero 1 rfl
    · intro x
      obtain ⟨f, hf, hx⟩ := I.extMk_surjective x 2 rfl
      rw [← hx]
      have hk : adj.homEquiv _ _ f ≫ (J.sc' 0 1 2).g = 0 := by
        change adj.homEquiv _ _ f ≫ R.map (I.cocomplex.d 1 2) = 0
        rw [← hnat, hf, hzero]
      have : Mono (J.sc' 0 1 2).f := hmono
      let g0 : P ⟶ R.obj (I.cocomplex.X 0) := hex1.lift (adj.homEquiv _ _ f) hk
      have hg0 : g0 ≫ R.map (I.cocomplex.d 0 1) = adj.homEquiv _ _ f := hex1.lift_f _ hk
      rw [InjectiveResolution.extMk_eq_zero_iff I f 2 rfl hf 0 rfl]
      refine ⟨(adj.homEquiv _ _).symm g0, ?_⟩
      have e := adj.homEquiv_naturality_right_symm g0 (I.cocomplex.d 0 1)
      rw [hg0, Equiv.symm_apply_apply] at e
      exact e.symm

  intro z
  obtain ⟨y, rfl⟩ := hΘ1b.2 z
  have hy1 : y = (Abelian.Ext.mk₀ κ.inv).comp ((Abelian.Ext.mk₀ κ.hom).comp y (zero_add m))
      (zero_add m) := by
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  rw [hy1, hw m hm ((Abelian.Ext.mk₀ κ.hom).comp y (zero_add m)), Abelian.Ext.comp_zero, map_zero]

theorem wc_mpq_germ_exc_restr_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (VT : D.Yt.left.ProEt) (jc : VT ⟶ Th) (hjc : IsOpenImmersion jc.left)
    (hrc : Set.range jc.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → F'')
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (E₀ : Over (Spec (.of F''))) (hpr : IsProper E₀.hom)
    (hsm : SmoothOfRelativeDimension (n - 2) E₀.hom)
    (jE : E₀.left ⟶ wcProjK F'' (n - 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr F'' (n - 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (n - 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD F'' (n - 2 + 1) c),
      wcLdpGerm F'' (n - 2 + 1) jE (wcLdpQuad F'' (n - 2 + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Xt : Over (Spec (.of F''))) (hpXt : IsProper Xt.hom)
    (hsXt : SmoothOfRelativeDimension (n - 2 + 1) Xt.hom)
    (b : Xt.left ⟶ Limits.pullback D.f (D.S i)) (iE : E₀.left ⟶ Xt.left)
    (hb : IsProper b) (hbX : b ≫ Limits.pullback.snd D.f (D.S i) = Xt.hom)
    (hbO : IsIso (b ∣_ wcCritPunctOpen D i)) (hiE : IsClosedImmersion iE)
    (hiEX : iE ≫ Xt.hom = E₀.hom)
    (hrangeE : ((b ⁻¹ᵁ wcCritPunctOpen D i : Xt.left.Opens) : Set Xt.left) = (Set.range iE)ᶜ)
    (k : ℕ) :
    Function.Surjective ((Abelian.Ext.mk₀ (wcFreeSheafMap Xt.left ((wcProEtPullback b).map
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map jc)))).precomp
      (wcContSheaf Xt.left (ZMod (ℓ ^ k))) (zero_add (n - 2))) :=
by
  classical

  have c0 : ∀ {S T : Scheme.{u}} (f : T ⟶ S) {A B : S.ProEt} (a : A ⟶ B),
      IsOpenImmersion a.left → IsOpenImmersion ((wcProEtPullback f).map a).left := by
    intro S T f A B a ha
    have h1 := MorphismProperty.pullbackMap (P := @IsOpenImmersion) (f := A.hom) (g := f)
      (f' := B.hom) (g' := f) (i₁ := a.left) (i₂ := 𝟙 T) ha
      (inferInstance : IsOpenImmersion (𝟙 T)) (MorphismProperty.Over.w a).symm
      (Category.id_comp f).symm
    have e : ((wcProEtPullback f).map a).left =
        Limits.pullback.map A.hom f B.hom f a.left (𝟙 T) (𝟙 S)
          ((Category.comp_id _).trans (MorphismProperty.Over.w a).symm)
          ((Category.comp_id f).trans (Category.id_comp f).symm) := by
      have e1 : ((wcProEtPullback f).map a).left ≫ Limits.pullback.fst B.hom f =
          Limits.pullback.fst A.hom f ≫ a.left := by
        first
          | exact Limits.pullback.lift_fst _ _ _
          | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
      have e2 : ((wcProEtPullback f).map a).left ≫ Limits.pullback.snd B.hom f =
          Limits.pullback.snd A.hom f := by
        first
          | exact Limits.pullback.lift_snd _ _ _
          | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_snd _ _ _)
      apply Limits.pullback.hom_ext
      · exact e1.trans (Limits.pullback.lift_fst _ _ _).symm
      · exact e2.trans ((Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)).symm
    rw [e]
    exact h1
  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have F1 : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    first
      | (unfold wcFreeSheafMap
         rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id]
         rfl)
      | (unfold wcFreeSheafMap wcFreeSheaf
         rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id]
         done)
      | (simp [wcFreeSheafMap, wcFreeSheaf]; done)
  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) {V V' : S.ProEt} (ψ : V ⟶ V'),
      ∃ ψo : wcOpenRestr S O V ⟶ wcOpenRestr S O V',
        ψo ≫ wcOpenRestrIncl S O V' = wcOpenRestrIncl S O V ≫ ψ := by
    intro S O V V' ψ
    have w : ψ.left ≫ V'.hom = V.hom := MorphismProperty.Over.w ψ
    have hc : Limits.pullback.fst O.ι V.hom ≫ O.ι =
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) ≫ V'.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι V.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι V.hom)
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) hc ≫ (Limits.pullback.snd O.ι V'.hom ≫ V'.hom) =
        Limits.pullback.snd O.ι V.hom ≫ V.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ V'.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι V.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι V.hom)
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _
  have Hcok : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ Φ : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ⟶
          Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ≫ Φ =
          wcFreeSheafMap S φ ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) := by
    intro S O Tc φ
    obtain ⟨φo, hcomm⟩ := Hres O φ
    have hdesc : wcFreeSheafMap S (wcOpenRestrIncl S O Tc) ≫ wcFreeSheafMap S φ ≫
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) = 0 := by
      rw [← Category.assoc, ← F0, ← hcomm, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    exact ⟨_, Limits.cokernel.π_desc _ _ hdesc⟩
  have L1 : ∀ {S : Scheme.{u}} (O : S.Opens) {U U' : S.ProEt} (β : U ≅ U'),
      Nonempty (Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)) ≅
          Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U'))) := by
    intro S O U U' β
    have hdesc : ∀ {V V' : S.ProEt} (ψ : V ⟶ V'),
        wcFreeSheafMap S (wcOpenRestrIncl S O V) ≫ wcFreeSheafMap S ψ ≫
          Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O V')) = 0 := by
      intro V V' ψ
      obtain ⟨ψo, hψo⟩ := Hres O ψ
      rw [← Category.assoc, ← F0, ← hψo, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    obtain ⟨kh, hkh⟩ : ∃ kh : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)) ⟶
        Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U')),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U)) ≫ kh =
          wcFreeSheafMap S β.hom ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U')) :=
      ⟨_, Limits.cokernel.π_desc _ _ (hdesc β.hom)⟩
    obtain ⟨ki, hki⟩ : ∃ ki : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U')) ⟶
        Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U')) ≫ ki =
          wcFreeSheafMap S β.inv ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U)) :=
      ⟨_, Limits.cokernel.π_desc _ _ (hdesc β.inv)⟩
    have e1 : kh ≫ ki = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U)))).mp
      rw [reassoc_of% hkh, hki, ← Category.assoc, ← F0, Iso.hom_inv_id, F1, Category.id_comp,
        Category.comp_id]
    have e2 : ki ≫ kh = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U')))).mp
      rw [reassoc_of% hki, hkh, ← Category.assoc, ← F0, Iso.inv_hom_id, F1, Category.id_comp,
        Category.comp_id]
    exact ⟨⟨kh, ki, e1, e2⟩⟩
  have liftV : ∀ {S : Scheme.{u}} {T To Th VT : S.ProEt} (incl : To ⟶ T)
      (hι : IsOpenImmersion incl.left) (xb : T.left) (hxb : Set.range incl.left = {xb}ᶜ)
      (g : Th ⟶ T) (j : VT ⟶ Th) (hrj : Set.range j.left = g.left ⁻¹' {xb}ᶜ),
      ∃ gV : VT ⟶ To, gV ≫ incl = j ≫ g := by
    intro S T To Th VT incl hι xb hxb g j hrj
    haveI := hι
    have hsub : Set.range (j ≫ g).left ⊆ Set.range incl.left := by
      rintro _ ⟨v, rfl⟩
      rw [hxb]
      have h3 : j.left v ∈ Set.range j.left := ⟨v, rfl⟩
      rw [hrj] at h3
      have h4 : (j ≫ g).left v = g.left (j.left v) := by
        rw [show (j ≫ g).left = j.left ≫ g.left from rfl, Scheme.Hom.comp_apply]
      rw [h4]
      exact h3
    let Lg : VT.left ⟶ To.left := IsOpenImmersion.lift incl.left (j ≫ g).left hsub
    have hLg : Lg ≫ incl.left = (j ≫ g).left := IsOpenImmersion.lift_fac _ _ hsub
    have hLgw : Lg ≫ To.hom = VT.hom := by
      rw [← MorphismProperty.Over.w incl, ← Category.assoc, hLg]
      show (j.left ≫ g.left) ≫ T.hom = VT.hom
      rw [Category.assoc, MorphismProperty.Over.w g, MorphismProperty.Over.w j]
    exact ⟨MorphismProperty.Over.homMk Lg hLgw trivial, MorphismProperty.Over.Hom.ext hLg⟩
  have hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f (D.S i))).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  have hXt : WeaklyEtale (Limits.pullback.fst Xt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')

  obtain ⟨L, adj, hLlim, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat b
  haveI := hLlim
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L

  have hι0 : IsOpenImmersion (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀))).left := by
    show IsOpenImmersion (Limits.pullback.snd (wcCritPunctOpen D i).ι _)
    infer_instance
  obtain ⟨xb', hxb', -, hln, hqs, -⟩ := wc_odp_fibre_sing_point F' F'' Y n D i V₀ A e ε hv hε
  obtain ⟨hTc, hrj, hfib'⟩ := wc_mpq_crit_germ_excision_data F' F'' Y n D i V₀ ε xb hxb Th g B
    eB hpre hfib VT jc hrc xb' hxb'
  have hJ : IsOpenImmersion ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map jc).left :=
    c0 _ jc hjc
  obtain ⟨gV, hgV⟩ := liftV _ hι0 xb' hxb'
