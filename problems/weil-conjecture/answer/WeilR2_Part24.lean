    (AlgebraicClosure ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))
    V.hom (wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F''))) v
    (hv.trans (hγ _ _).symm)
  let Nv : StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
