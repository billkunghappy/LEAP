  unfold wcFpeCocycle at hc
  have hc' := congrArg (E (wcFpeNerve S U Ω p 3)) hc
  rw [hEadd, hEsub, hEmap, hEmap, hEmap, hE0, div_mul_eq_mul_div, div_eq_one] at hc'
  have hval : (wcFpeFace S U Ω p 0).left.appTop.hom (E (wcFpeNerve S U Ω p 2) c : _) *
      (wcFpeFace S U Ω p 2).left.appTop.hom (E (wcFpeNerve S U Ω p 2) c : _) =
      (wcFpeFace S U Ω p 1).left.appTop.hom (E (wcFpeNerve S U Ω p 2) c : _) :=
    congrArg Units.val hc'
  obtain ⟨c', hκ⟩ : ∃ c' : TensorProduct Γ(U.left, ⊤) Γ(Ω.left, ⊤) Γ(Ω.left, ⊤),
      κ₂ c' = (E (wcFpeNerve S U Ω p 2) c : Γ((wcFpeNerve S U Ω p 2).left, ⊤)) :=
    ⟨_, κ₂.apply_symm_apply _⟩
  have hcu : IsUnit c' := by
    have h1 : IsUnit (κ₂ c') := hκ ▸ (E (wcFpeNerve S U Ω p 2) c).isUnit
    have h2 := h1.map κ₂.symm
    rwa [RingEquiv.symm_apply_apply] at h2
  have hcoc' : d1 c' = d2 c' * d0 c' := by
    apply κ₃.injective
    rw [map_mul, ← hF1 c', ← hF2 c', ← hF0 c', hκ, mul_comm]
    exact hval.symm
  obtain ⟨m, hm, hmc⟩ := L1 _ _ hpic c' hcu hcoc'

  refine ⟨(ULift.up (Additive.ofMul hm.unit) : (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S)
    AddCommGrpCat.{u+1}).obj.obj (Opposite.op Ω)), ?_⟩
  apply hEinj
  have key : E (wcFpeNerve S U Ω p 2) c *
      Units.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left.appTop.hom.toMonoidHom hm.unit =
      Units.map (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left.appTop.hom.toMonoidHom
        hm.unit := by
    apply Units.ext
    show (E (wcFpeNerve S U Ω p 2) c : Γ((wcFpeNerve S U Ω p 2).left, ⊤)) *
        (Limits.WidePullback.π (fun _ : Fin 2 => p) 0).left.appTop.hom m =
      (Limits.WidePullback.π (fun _ : Fin 2 => p) 1).left.appTop.hom m
    rw [← h20, ← h21, ← hκ, ← map_mul, ← hmc]
  exact (eq_div_iff_mul_eq'.mpr key)

theorem wc_smooth_divisor_wcontr_punct_units_ext_one_torsion_free (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (n : ℕ)
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology Y)
      ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (y : Abelian.Ext (wcFreeSheaf Y (wcOpenRestr Y O V))
      (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) 1)
    (hy : (ℓ ^ n : ℕ) • y = 0) : y = 0 :=
by
  classical

  obtain ⟨f, hf⟩ := wc_sdpu_global_equation k pY d i O hO V h1 h2 h3

  have hPf : Subsingleton (CommRing.Pic (Localization.Away f)) :=
    wc_sdpu_wlocal_pic_local_global_scheme V.left h1 h2 h3 f
      (fun x hx => wc_sdpu_stalk_punct_pic_trivial k pY d i O hO V f hf x (h5 x hx))

  have transport : ∀ (A B : Type u) [CommRing A] [CommRing B] (_ : A ≃+* B),
      Subsingleton (CommRing.Pic A) → Subsingleton (CommRing.Pic B) := by
    intro A B _ _ e hA
    constructor
    intro M N
    have h : ∀ M : CommRing.Pic B, CommRing.Pic.mapRingHom (e : A →+* B)
        (CommRing.Pic.mapRingHom (e.symm : B →+* A) M) = M := by
      intro M
      rw [CommRing.Pic.mapRingHom_mapRingHom]
      have : (e : A →+* B).comp (e.symm : B →+* A) = RingHom.id B := by ext; simp
      rw [this, CommRing.Pic.mapRingHom_id]; rfl
    rw [← h M, ← h N, Subsingleton.elim (CommRing.Pic.mapRingHom (e.symm : B →+* A) M)
      (CommRing.Pic.mapRingHom (e.symm : B →+* A) N)]

  haveI : IsAffine V.left := h1
  have hUaff : IsAffineOpen (V.hom ⁻¹ᵁ O) := by
    rw [← hf]; exact (isAffineOpen_top V.left).basicOpen f
  let e : (wcOpenRestr Y O V).left ≅ (V.hom ⁻¹ᵁ O).toScheme :=
    Limits.pullbackSymmetry O.ι V.hom ≪≫ pullbackRestrictIsoRestrict V.hom O
  haveI : IsAffine (V.hom ⁻¹ᵁ O).toScheme := hUaff
  have hVOaff : IsAffine (wcOpenRestr Y O V).left := IsAffine.of_isIso e.hom
  have hPU : Subsingleton (CommRing.Pic Γ(V.left, V.hom ⁻¹ᵁ O)) := by
    rw [← hf]
    haveI := (isAffineOpen_top V.left).isLocalization_basicOpen f
    exact transport _ _ (IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f)
      Γ(V.left, V.left.basicOpen f)).toRingEquiv hPf
  have hPVO : Subsingleton (CommRing.Pic Γ((wcOpenRestr Y O V).left, ⊤)) :=
    transport _ _ ((V.hom ⁻¹ᵁ O).topIso.symm ≪≫ Scheme.Γ.mapIso e.op).commRingCatIsoToRingEquiv
      hPU

  exact wc_sdpu_affine_units_ext_one_vanish Y hG (wcOpenRestr Y O V) hVOaff hPVO y

theorem wc_sddc_iota_app_injective (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (W : Y.ProEt) :
    Function.Injective ((wcSddcIota Y O).app (Opposite.op W)) :=
by
  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : ∀ x : Y, IsDomain (Y.presheaf.stalk x) :=
    fun x => (wc_fntame_smooth_stalk_normal k Y pY x).1
  haveI : AlgebraicGeometry.IsReduced Y := isReduced_of_isReduced_stalk Y
  haveI : Flat W.hom := @WeaklyEtale.flat _ _ W.hom W.prop
  have hT : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  have hl0 := wc_sdgri_reduced_local_nzd_avoiding_closed Y (Set.range i) hT
    (fun y hy => wc_smooth_divisor_generic_not_mem k pY d i y hy)
  have hloc : ∀ y : Y, ∃ U : Y.Opens, IsAffineOpen U ∧ y ∈ U ∧
      ∃ t ∈ nonZeroDivisors Γ(Y, U), Y.basicOpen t ≤ O := by
    intro y
    obtain ⟨U, hU, hy, t, ht, hTt⟩ := hl0 y
    refine ⟨U, hU, hy, t, ht, fun x hx => ?_⟩
    rw [← SetLike.mem_coe, hO]
    exact hTt x hx
  have hsnd := wc_sdgri_flat_restrict_injective_of_local_nzd W.hom O hloc
  have hsym : Function.Injective
      (Limits.pullbackSymmetry W.hom O.ι).hom.appTop.hom := by
    intro a b hab
    have h1 : ∀ x, (Limits.pullbackSymmetry W.hom O.ι).inv.appTop.hom
        ((Limits.pullbackSymmetry W.hom O.ι).hom.appTop.hom x) = x := by
      intro x
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id,
        Scheme.Hom.id_appTop]
      rfl
    rw [← h1 a, ← h1 b, hab]
  have hfst : Function.Injective (Limits.pullback.fst W.hom O.ι).appTop.hom := by
    have e : Limits.pullback.fst W.hom O.ι =
        (Limits.pullbackSymmetry W.hom O.ι).hom ≫ Limits.pullback.snd O.ι W.hom :=
      (Limits.pullbackSymmetry_hom_comp_snd W.hom O.ι).symm
    rw [e, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.coe_comp]
    exact hsym.comp hsnd
  intro a b h
  apply ULift.ext
  apply Additive.toMul.injective
  apply Units.ext
  apply hfst
  have h' := congrArg (fun x => ((Additive.toMul x.down : (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) :
    Γ(Limits.pullback W.hom O.ι, ⊤))) h
  exact h'

theorem wc_sddc_open_bc_iso (Y : Scheme.{u}) (O : Y.Opens) (V : Y.ProEt) :
    IsIso ((wcProEtBaseChange O.ι).map (wcOpenRestrIncl Y O V)).left :=
by
  show IsIso (Limits.pullback.lift
    (Limits.pullback.fst (Limits.pullback.snd O.ι V.hom ≫ V.hom) O.ι ≫
      Limits.pullback.snd O.ι V.hom)
    (Limits.pullback.snd (Limits.pullback.snd O.ι V.hom ≫ V.hom) O.ι)
    (by rw [Category.assoc]; exact Limits.pullback.condition) :
    Limits.pullback (Limits.pullback.snd O.ι V.hom ≫ V.hom) O.ι ⟶ Limits.pullback V.hom O.ι)
  generalize V.hom = a
  generalize hΦ : (Limits.pullback.lift
    (Limits.pullback.fst (Limits.pullback.snd O.ι a ≫ a) O.ι ≫
      Limits.pullback.snd O.ι a)
    (Limits.pullback.snd (Limits.pullback.snd O.ι a ≫ a) O.ι)
    (by rw [Category.assoc]; exact Limits.pullback.condition) :
    Limits.pullback (Limits.pullback.snd O.ι a ≫ a) O.ι ⟶ Limits.pullback a O.ι) = Φ
  have E1 : Φ ≫ Limits.pullback.fst a O.ι =
      Limits.pullback.fst (Limits.pullback.snd O.ι a ≫ a) O.ι ≫ Limits.pullback.snd O.ι a := by
    rw [← hΦ]; exact Limits.pullback.lift_fst _ _ _
  have E2 : Φ ≫ Limits.pullback.snd a O.ι =
      Limits.pullback.snd (Limits.pullback.snd O.ι a ≫ a) O.ι := by
    rw [← hΦ]; exact Limits.pullback.lift_snd _ _ _
  obtain ⟨u, hu1, hu2⟩ : ∃ u : Limits.pullback a O.ι ⟶ Limits.pullback O.ι a,
      u ≫ Limits.pullback.snd O.ι a = Limits.pullback.fst a O.ι ∧
      u ≫ Limits.pullback.fst O.ι a = Limits.pullback.snd a O.ι :=
    ⟨Limits.pullback.lift (Limits.pullback.snd _ _) (Limits.pullback.fst _ _)
      Limits.pullback.condition.symm, Limits.pullback.lift_snd _ _ _,
      Limits.pullback.lift_fst _ _ _⟩
  have hc : u ≫ Limits.pullback.snd O.ι a ≫ a = Limits.pullback.snd a O.ι ≫ O.ι := by
    rw [← Category.assoc, hu1]; exact Limits.pullback.condition
  obtain ⟨Ψ, hΨ1, hΨ2⟩ : ∃ Ψ : Limits.pullback a O.ι ⟶
      Limits.pullback (Limits.pullback.snd O.ι a ≫ a) O.ι,
      Ψ ≫ Limits.pullback.fst (Limits.pullback.snd O.ι a ≫ a) O.ι = u ∧
      Ψ ≫ Limits.pullback.snd (Limits.pullback.snd O.ι a ≫ a) O.ι =
        Limits.pullback.snd a O.ι :=
    ⟨Limits.pullback.lift u (Limits.pullback.snd _ _) hc, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hr : Limits.pullback.snd (Limits.pullback.snd O.ι a ≫ a) O.ι =
      Limits.pullback.fst (Limits.pullback.snd O.ι a ≫ a) O.ι ≫ Limits.pullback.fst O.ι a := by
    apply (cancel_mono O.ι).1
    rw [Category.assoc, Limits.pullback.condition (f := O.ι) (g := a)]
    exact (Limits.pullback.condition (f := Limits.pullback.snd O.ι a ≫ a) (g := O.ι)).symm
  have h1 : Φ ≫ Ψ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hΨ1, Category.id_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hu2, E2, hr]
      · rw [Category.assoc, hu1, E1]
    · rw [Category.assoc, hΨ2, E2, Category.id_comp]
  have h2 : Ψ ≫ Φ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, E1, ← Category.assoc, hΨ1, hu1, Category.id_comp]
    · rw [Category.assoc, E2, hΨ2, Category.id_comp]
  exact ⟨⟨Ψ, h1, h2⟩⟩

theorem wc_sddcld_local_equation (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)] (z : Z) :
    ∃ (U : Y.Opens) (t : Γ(Y, U)), i z ∈ U ∧ wcSddcLE i U t :=
by
  classical

  have LE2 : ∀ (U : Y.Opens) (hU : IsAffineOpen U) (t : Γ(Y, U)),
      RingHom.ker (i.app U).hom = Ideal.span {t} → ∀ (x : Y) (hx : x ∈ U),
      (x ∈ Set.range i ↔
        (Y.presheaf.germ U x hx).hom t ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) := by
    intro U hU t hker x hx
    have hcl : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
    have hs : (i.ker.support : Set Y) = Set.range i := by
      rw [Scheme.Hom.support_ker, hcl.closure_eq]
    rw [← hs, SetLike.mem_coe,
      Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hU⟩) hx, Scheme.Hom.ker_apply]
    show x ∈ Y.zeroLocus ((RingHom.ker (i.app U).hom : Ideal Γ(Y, U)) : Set Γ(Y, U)) ↔ _
    rw [hker, Scheme.mem_zeroLocus_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      ← Scheme.mem_basicOpen _ _ _ hx]
    constructor
    · intro h
      exact h t (Ideal.mem_span_singleton_self t)
    · intro h f hf
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hf
      rw [Scheme.basicOpen_mul]
      exact fun h' => h h'.2

  have LE3 : ∀ (U : Y.Opens) (hU : IsAffineOpen U) (t : Γ(Y, U)),
      RingHom.ker (i.app U).hom = Ideal.span {t} → ∀ (z : Z) (hz : i z ∈ U),
      RingHom.ker (i.stalkMap z).hom = Ideal.span {(Y.presheaf.germ U (i z) hz).hom t} := by
    intro U hU t hker z hz
    have hstar : ∀ b, (i.stalkMap z).hom ((Y.presheaf.germ U (i z) hz).hom b) =
        (Z.presheaf.germ (i ⁻¹ᵁ U) z hz).hom ((i.app U).hom b) :=
      fun b => i.germ_stalkMap_apply U z hz b
    have ht0 : (i.app U).hom t = 0 := by
      rw [← RingHom.mem_ker, hker]; exact Ideal.mem_span_singleton_self t
    apply le_antisymm
    · intro s hs
      rw [RingHom.mem_ker] at hs
      letI : Algebra Γ(Y, U) (Y.presheaf.stalk (i z)) :=
        TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨i z, hz⟩
      haveI : IsLocalization.AtPrime (Y.presheaf.stalk (i z))
          (hU.primeIdealOf ⟨i z, hz⟩).asIdeal :=
        hU.isLocalization_stalk ⟨i z, hz⟩
      have hV : IsAffineOpen (i ⁻¹ᵁ U) := hU.preimage i
      letI : Algebra Γ(Z, i ⁻¹ᵁ U) (Z.presheaf.stalk z) :=
        TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hz⟩
      haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hz⟩).asIdeal :=
        hV.isLocalization_stalk ⟨z, hz⟩
      have hg : ∀ b, algebraMap Γ(Y, U) (Y.presheaf.stalk (i z)) b =
          (Y.presheaf.germ U (i z) hz).hom b := fun b => rfl
      have hgz : ∀ b, algebraMap Γ(Z, i ⁻¹ᵁ U) (Z.presheaf.stalk z) b =
          (Z.presheaf.germ (i ⁻¹ᵁ U) z hz).hom b := fun b => rfl
      obtain ⟨⟨a, m⟩, hs'⟩ := IsLocalization.mk'_surjective
        (hU.primeIdealOf ⟨i z, hz⟩).asIdeal.primeCompl (S := Y.presheaf.stalk (i z)) s
      simp only at hs'
      have hspec := IsLocalization.mk'_spec (Y.presheaf.stalk (i z)) a m
      rw [hs', hg, hg] at hspec
      have h1 : algebraMap Γ(Z, i ⁻¹ᵁ U) (Z.presheaf.stalk z) ((i.app U).hom a) = 0 := by
        rw [hgz, ← hstar, ← hspec, map_mul, hs, zero_mul]
      rw [IsLocalization.map_eq_zero_iff (hV.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl] at h1
      obtain ⟨n, hn⟩ := h1
      obtain ⟨m', hm'⟩ := i.app_surjective U hU (n : Γ(Z, i ⁻¹ᵁ U))
      have hm'a : m' * a ∈ RingHom.ker (i.app U).hom := by
        rw [RingHom.mem_ker, map_mul, hm', hn]
      rw [hker] at hm'a
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hm'a
      have hu1 : IsUnit ((Y.presheaf.germ U (i z) hz).hom m') := by
        rw [← isUnit_map_iff (i.stalkMap z).hom, hstar, hm', ← hgz]
        exact IsLocalization.map_units _ n
      have hu2 : IsUnit ((Y.presheaf.germ U (i z) hz).hom (m : Γ(Y, U))) := by
        rw [← hg]; exact IsLocalization.map_units (Y.presheaf.stalk (i z)) m
      obtain ⟨u1, hu1'⟩ := hu1
      obtain ⟨u2, hu2'⟩ := hu2
      rw [Ideal.mem_span_singleton']
      refine ⟨↑u1⁻¹ * ↑u2⁻¹ * (Y.presheaf.germ U (i z) hz).hom c, ?_⟩
      have e1 : (Y.presheaf.germ U (i z) hz).hom c * (Y.presheaf.germ U (i z) hz).hom t =
          (u1 : Y.presheaf.stalk (i z)) * u2 * s := by
        rw [← map_mul, hc, map_mul, ← hspec, hu1', hu2']
        ring
      rw [mul_assoc, e1]
      linear_combination (↑u2⁻¹ * ↑u2 * s) * u1.inv_mul + s * u2.inv_mul
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, hstar, ht0, map_zero]

  have LE1 : ∀ (U : Y.Opens) (hU : IsAffineOpen U) (t : Γ(Y, U)),
      _root_.IsReduced Γ(Y, U) →
      (∀ (x : Y) (hx : x ∈ U), x ∈ Set.range i ↔
        (Y.presheaf.germ U x hx).hom t ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x)) →
      (∀ y : Y, (∀ y' : Y, y' ⤳ y → y' = y) → y ∉ Set.range i) →
      t ∈ nonZeroDivisors Γ(Y, U) := by
    intro U hU t hred hLE2 hgen
    rw [mem_nonZeroDivisors_iff_right]
    intro a hat
    by_contra ha
    have hbot : sInf (⊥ : Ideal Γ(Y, U)).minimalPrimes = ⊥ := by
      rw [Ideal.sInf_minimalPrimes, Ideal.radical_bot_of_isReduced]
    have hnot : a ∉ sInf (⊥ : Ideal Γ(Y, U)).minimalPrimes := by
      rw [hbot, Ideal.mem_bot]; exact ha
    rw [Ideal.mem_sInf] at hnot
    push_neg at hnot
    obtain ⟨q, hq, haq⟩ := hnot
    have hqmin : Minimal (fun p : Ideal Γ(Y, U) => p.IsPrime ∧ ⊥ ≤ p) q := hq
    have hqp : q.IsPrime := hqmin.prop.1
    have htq : t ∈ q := by
      have : a * t ∈ q := by rw [hat]; exact q.zero_mem
      exact (hqp.mem_or_mem this).resolve_left haq
    let P : PrimeSpectrum Γ(Y, U) := ⟨q, hqp⟩
    have hPU : hU.fromSpec P ∈ U := by
      rw [← SetLike.mem_coe, ← hU.range_fromSpec]; exact ⟨P, rfl⟩
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk (hU.fromSpec P)) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨_, hPU⟩
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk (hU.fromSpec P)) q :=
      hU.isLocalization_stalk' P hPU
    have hmem : hU.fromSpec P ∈ Set.range i := by
      rw [hLE2 _ hPU]
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (Y.presheaf.stalk (hU.fromSpec P)) q t).mpr htq
    apply hgen _ ?_ hmem
    intro y' hy'
    have hy'U : y' ∈ U := hy'.mem_open U.isOpen hPU
    rw [← SetLike.mem_coe, ← hU.range_fromSpec] at hy'U
    obtain ⟨P', rfl⟩ := hy'U
    haveI := hU.isOpenImmersion_fromSpec
    have hsp : P' ⤳ P := (hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp hy'
    have hsp' : P'.asIdeal ≤ q :=
      (PrimeSpectrum.le_iff_specializes (R := Γ(Y, U)) P' P).mpr hsp
    have hP' : P'.asIdeal = q := hqmin.eq_of_le ⟨P'.isPrime, bot_le⟩ hsp'
    have : P' = P := PrimeSpectrum.ext hP'
    rw [this]

  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI : SmoothOfRelativeDimension (d + 1 - 1) (i ≫ pY) := by
    rw [Nat.add_sub_cancel]; infer_instance
  obtain ⟨W, hW, hzW, h, hcut⟩ :=
    wc_smooth_pair_local_cutout k Y Z pY (d + 1) 1 i (by omega) z
  obtain ⟨_, _, hc⟩ := hcut
  rw [Set.range_unique] at hc
  have hker : RingHom.ker (i.app (W.ι ''ᵁ ⊤)).hom = Ideal.span {h default} := by
    ext x
    have key : (i ∣_ W).appTop.hom x = 0 ↔ (i.app (W.ι ''ᵁ ⊤)).hom x = 0 := by
      have aux : ∀ {A B C : CommRingCat} (f : A ⟶ B) (g : B ⟶ C), IsIso g → ∀ (y : A),
          (f ≫ g).hom y = 0 ↔ f.hom y = 0 := by
        intro A B C f g hg y
        change g.hom (f.hom y) = 0 ↔ _
        constructor
        · intro h0
          exact (ConcreteCategory.bijective_of_isIso g).1 (h0.trans (map_zero _).symm)
        · intro h0; rw [h0, map_zero]
      rw [morphismRestrict_appTop]
      exact aux _ _ (Functor.map_isIso Z.presheaf _) x
    have hx : x ∈ RingHom.ker (i ∣_ W).appTop.hom ↔ x ∈ Ideal.span {h default} := by rw [hc]
    rw [RingHom.mem_ker, ← key]
    exact hx
  have hzU : i z ∈ W.ι ''ᵁ ⊤ := by rw [Scheme.Opens.ι_image_top]; exact hzW
  have hU : IsAffineOpen (W.ι ''ᵁ ⊤) := by rw [Scheme.Opens.ι_image_top]; exact hW

  haveI : ∀ x : Y, IsDomain (Y.presheaf.stalk x) :=
    fun x => (wc_fntame_smooth_stalk_normal k Y pY x).1
  haveI : AlgebraicGeometry.IsReduced Y := isReduced_of_isReduced_stalk Y
  have hred : _root_.IsReduced Γ(Y, W.ι ''ᵁ ⊤) := IsReduced.component_reduced _

  have hgen : ∀ y : Y, (∀ y' : Y, y' ⤳ y → y' = y) → y ∉ Set.range i :=
    fun y hy => wc_smooth_divisor_generic_not_mem k pY d i y hy

  have hLE2 := LE2 _ hU _ hker
  refine ⟨W.ι ''ᵁ ⊤, h default, hzU, hU, LE1 _ hU _ hred hLE2 hgen, hLE2, ?_⟩
  intro z' hz'
  exact ⟨i.stalkMap_surjective z', LE3 _ hU _ hker z' hz'⟩

theorem wc_sddccm_vanish_off {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (hO : (O : Set Y) = (Set.range i)ᶜ)
    {D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (p' : wcSddcMPre Y O ⟶ D.obj)
    (hw : wcSddcIota Y O ≫ p' = 0) : wcSddcH0 i O p' :=
by
  intro W m hW
  have hsurj : Function.Surjective (Limits.pullback.fst W.hom O.ι) := by
    intro a
    have ha : W.hom a ∈ (O : Set Y) := by rw [hO]; exact hW a
    rw [← Scheme.Opens.range_ι O] at ha
    obtain ⟨o, ho⟩ := ha
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback a o ho.symm
    exact ⟨z, hz⟩
  haveI : IsIso (Limits.pullback.fst W.hom O.ι) :=
    (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, ⟨hsurj⟩⟩
  have hiso : IsIso (wcSddcUnitsFun.map (Limits.pullback.fst W.hom O.ι).op) :=
    Functor.map_isIso _ _
  have hbij : Function.Bijective ((wcSddcIota Y O).app (Opposite.op W)) :=
    ConcreteCategory.bijective_of_isIso (C := AddCommGrpCat.{u+1})
      (f := wcSddcUnitsFun.map (Limits.pullback.fst W.hom O.ι).op)
  obtain ⟨v, rfl⟩ := hbij.2 m
  have h := congrArg (fun φ => φ.app (Opposite.op W) v) hw
  simp only [NatTrans.app_zero] at h
  first
    | exact h
    | (rw [ConcreteCategory.comp_apply] at h; simpa using h)
    | (simpa [CategoryTheory.comp_apply] using h)

theorem wc_sddccm_class_compat {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (p' : wcSddcMPre Y O ⟶ D.obj)
    (hw : wcSddcIota Y O ≫ p' = 0) : wcSddcHc i O p' :=
by

  have tsep : ∀ (W : Y.ProEt) (s₁ s₂ : D.obj.obj (Opposite.op W)),
      (∀ x : W.left, ∃ N : W.left.Opens, x ∈ N ∧
        D.obj.map (wcSddcOpenSubIncl W N).op s₁ = D.obj.map (wcSddcOpenSubIncl W N).op s₂) →
      s₁ = s₂ := by
    intro W s₁ s₂ h
    choose N hxN hEq using h
    have hR : Sieve.generate (Presieve.ofArrows (fun x => wcSddcOpenSub W (N x))
        (fun x => wcSddcOpenSubIncl W (N x))) ∈ Scheme.ProEt.topology Y W := by
      apply Precoverage.generate_mem_toGrothendieck
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Y ⋙ Over.forget Y)
        Scheme.proetalePrecoverage).coverings W
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      haveI : MorphismProperty.ContainsIdentities (@WeaklyEtale : MorphismProperty Scheme.{u}) :=
        MorphismProperty.IsMultiplicative.toContainsIdentities
      apply Scheme.zariskiPrecoverage_le_propQCPrecoverage (P := @WeaklyEtale)
      rw [Scheme.zariskiPrecoverage, Scheme.ofArrows_mem_precoverage_iff]
      refine ⟨fun y => ⟨y, ?_⟩, fun x => ?_⟩
      · show y ∈ Set.range (N y).ι
        rw [Scheme.Opens.range_ι]
        exact hxN y
      · show IsOpenImmersion (N x).ι
        infer_instance
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology Y) (D.obj ⋙ forget AddCommGrpCat) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((Presheaf.isSheaf_iff_isSheaf_forget _ D.obj (forget AddCommGrpCat)).mp D.property)
    exact (hsh.isSheafFor _ hR).isSeparatedFor.ext (by rintro _ _ ⟨x⟩; exact hEq x)

  have tkey : ∀ (V : Y.ProEt) (U G : Y.Opens) (t : Γ(Y, U))
      (k : V ⟶ wcSddcYU Y U) (hGU : G ≤ U) (hW : ⊤ ≤ V.hom ⁻¹ᵁ G),
      k.left.appTop.hom (U.topIso.inv.hom t) =
        (V.hom.appLE G ⊤ hW).hom ((Y.presheaf.map (homOfLE hGU).op).hom t) := by
    intro V U G t k hGU hW
    have appLE_congr' : ∀ {A B : Scheme.{u}} (f f' : A ⟶ B) (P : B.Opens) (Q : A.Opens)
        (e : Q ≤ f ⁻¹ᵁ P) (e' : Q ≤ f' ⁻¹ᵁ P), f = f' →
        ∀ x, (f.appLE P Q e).hom x = (f'.appLE P Q e').hom x := by
      intro A B f f' P Q e e' hf x
      subst hf
      rfl
    have hk : k.left ≫ (U.ι ≫ 𝟙 Y) = V.hom := MorphismProperty.Over.w k
    have e1 : (⊤ : (U : Scheme.{u}).Opens) ≤ (U.ι ≫ 𝟙 Y) ⁻¹ᵁ U := by
      intro z _
      show (U.ι ≫ 𝟙 Y) z ∈ U
      rw [Category.comp_id]
      have : U.ι z ∈ Set.range U.ι := ⟨z, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have e1' : (⊤ : (U : Scheme.{u}).Opens) ≤ U.ι ⁻¹ᵁ U := by
      intro z _
      show U.ι z ∈ U
      have : U.ι z ∈ Set.range U.ι := ⟨z, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have e2 : (⊤ : V.left.Opens) ≤ k.left ⁻¹ᵁ ⊤ := le_of_eq (Scheme.Hom.preimage_top _).symm
    have e3 : (⊤ : V.left.Opens) ≤ (k.left ≫ (U.ι ≫ 𝟙 Y)) ⁻¹ᵁ U := by
      intro z _
      show (k.left ≫ (U.ι ≫ 𝟙 Y)) z ∈ U
      rw [Scheme.Hom.comp_apply]
      exact e1 (Set.mem_univ _)
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
    rw [appLE_congr' V.hom (k.left ≫ (U.ι ≫ 𝟙 Y)) U ⊤ _ e3 hk.symm]
    rw [← Scheme.Hom.appLE_comp_appLE k.left (U.ι ≫ 𝟙 Y) U ⊤ ⊤ e1 e2, CommRingCat.comp_apply]
    have h1 : ((U.ι ≫ 𝟙 Y).appLE U ⊤ e1).hom t = U.topIso.inv.hom t := by
      rw [appLE_congr' (U.ι ≫ 𝟙 Y) U.ι U ⊤ e1 e1' (Category.comp_id _), Scheme.Opens.ι_appLE,
        Scheme.Opens.topIso_inv]
      rfl
    refine Eq.trans ?_ (congrArg (fun x => (k.left.appLE ⊤ ⊤ e2).hom x) h1).symm
    show (k.left.app ⊤).hom (U.topIso.inv.hom t) =
      (k.left.app ⊤ ≫ V.left.presheaf.map (homOfLE e2).op).hom (U.topIso.inv.hom t)
    rw [show (homOfLE e2).op = 𝟙 (Opposite.op (⊤ : V.left.Opens)) from rfl]
    erw [CategoryTheory.Functor.map_id, Category.comp_id]
    rfl

  have s3 : ∀ (U U' : Y.Opens) (t : Γ(Y, U)) (t' : Γ(Y, U')) (hLE : wcSddcLE i U t)
      (hLE' : wcSddcLE i U' t') (y : Y) (hy : y ∈ U) (hy' : y ∈ U'),
      ∃ u : (Y.presheaf.stalk y)ˣ,
        (Y.presheaf.germ U' y hy').hom t' =
          (u : Y.presheaf.stalk y) * (Y.presheaf.germ U y hy).hom t := by
    intro U U' t t' hLE hLE' y hy hy'
    by_cases hyr : y ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hyr
      have h1 := (hLE.2.2.2 z hy).2
      have h2 := (hLE'.2.2.2 z hy').2
      rw [h1] at h2
      set T := (Y.presheaf.germ U (i z) hy).hom t
      set T' := (Y.presheaf.germ U' (i z) hy').hom t'
      have hT' : T' ∈ Ideal.span {T} := by rw [h2]; exact Ideal.subset_span rfl
      have hT : T ∈ Ideal.span {T'} := by rw [← h2]; exact Ideal.subset_span rfl
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hT'
      obtain ⟨a', ha'⟩ := Ideal.mem_span_singleton'.mp hT
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (a' * a) with hu | hu
      · have hau : IsUnit a := isUnit_of_mul_isUnit_right hu
        exact ⟨hau.unit, by rw [IsUnit.unit_spec, ha]⟩
      · have h0 : (1 - a' * a) * T = 0 := by
          rw [sub_mul, one_mul, mul_assoc, ha, ha', sub_self]
        have hT0 : T = 0 := (hu.mul_right_eq_zero).mp h0
        refine ⟨1, ?_⟩
        rw [← ha, hT0, mul_zero, mul_zero]
    · have hu : IsUnit ((Y.presheaf.germ U y hy).hom t) :=
        IsLocalRing.notMem_maximalIdeal.mp (fun h => hyr ((hLE.2.2.1 y hy).mpr h))
      have hu' : IsUnit ((Y.presheaf.germ U' y hy').hom t') :=
        IsLocalRing.notMem_maximalIdeal.mp (fun h => hyr ((hLE'.2.2.1 y hy').mpr h))
      refine ⟨hu'.unit * hu.unit⁻¹, ?_⟩
      rw [Units.val_mul, mul_assoc, hu.val_inv_mul, mul_one, IsUnit.unit_spec]

  have s4 : ∀ (U U' : Y.Opens) (t : Γ(Y, U)) (t' : Γ(Y, U')) (y : Y) (hy : y ∈ U)
      (hy' : y ∈ U') (u : (Y.presheaf.stalk y)ˣ),
      (Y.presheaf.germ U' y hy').hom t' =
        (u : Y.presheaf.stalk y) * (Y.presheaf.germ U y hy).hom t →
      ∃ (G : Y.Opens) (hGU : G ≤ U) (hGU' : G ≤ U'), y ∈ G ∧ ∃ e : (Γ(Y, G))ˣ,
        (Y.presheaf.map (homOfLE hGU').op).hom t' =
          (e : Γ(Y, G)) * (Y.presheaf.map (homOfLE hGU).op).hom t := by
    intro U U' t t' y hy hy' u hu
    obtain ⟨G₁, m, a, ha⟩ := TopCat.Presheaf.exists_germ_eq Y.presheaf (u : Y.presheaf.stalk y)
    have hyG₂ : y ∈ Y.basicOpen a := by
      rw [Scheme.mem_basicOpen Y a y m]
      erw [ha]
      exact u.isUnit
    have hG₂ : Y.basicOpen a ≤ G₁ := Y.basicOpen_le a
    set H : Y.Opens := U ⊓ U' ⊓ Y.basicOpen a with hH
    have hyH : y ∈ H := ⟨⟨hy, hy'⟩, hyG₂⟩
    have hHU : H ≤ U := fun x hx => hx.1.1
    have hHU' : H ≤ U' := fun x hx => hx.1.2
    have hHG : H ≤ Y.basicOpen a := fun x hx => hx.2
    have hHG₁ : H ≤ G₁ := hHG.trans hG₂
    set τ := (Y.presheaf.map (homOfLE hHU).op).hom t
    set τ' := (Y.presheaf.map (homOfLE hHU').op).hom t'
    set α := (Y.presheaf.map (homOfLE hHG₁).op).hom a
    have hα : IsUnit α := by
      have h1 := RingedSpace.isUnit_res_basicOpen Y.toRingedSpace a
      have h2 := h1.map (Y.presheaf.map (homOfLE hHG).op).hom
      have e : (Y.presheaf.map (homOfLE hHG).op).hom
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom a) = α := by
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]
        rfl
      rw [← e]
      exact h2
    have hgerm : (Y.presheaf.germ H y hyH).hom τ' = (Y.presheaf.germ H y hyH).hom (α * τ) := by
      rw [map_mul]
      simp only [τ', τ, α]
      rw [TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
        TopCat.Presheaf.germ_res_apply, hu, ha]
    obtain ⟨G, hyG, iU, iV, hG⟩ := TopCat.Presheaf.germ_eq Y.presheaf y hyH hyH τ' (α * τ) hgerm
    have hGH : G ≤ H := leOfHom iU
    refine ⟨G, hGH.trans hHU, hGH.trans hHU', hyG, (hα.map (Y.presheaf.map iV.op).hom).unit, ?_⟩
    rw [IsUnit.unit_spec]
    have e1 : (Y.presheaf.map (homOfLE (hGH.trans hHU')).op).hom t' =
        (Y.presheaf.map iU.op).hom τ' := by
      simp only [τ']
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    have e2 : (Y.presheaf.map (homOfLE (hGH.trans hHU)).op).hom t =
        (Y.presheaf.map iV.op).hom τ := by
      simp only [τ]
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    rw [e1, e2, hG, map_mul]

  intro W U U' t t' g g' hLE hLE'
  have appTop_comm : ∀ {A B B' C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (f' : A ⟶ B')
      (g' : B' ⟶ C), f ≫ g = f' ≫ g' → ∀ y,
      f.appTop.hom (g.appTop.hom y) = f'.appTop.hom (g'.appTop.hom y) := by
    intro A B B' C f g f' g' h y
    calc f.appTop.hom (g.appTop.hom y) = (f ≫ g).appTop.hom y := by
          rw [Scheme.Hom.comp_appTop]; rfl
      _ = (f' ≫ g').appTop.hom y := by rw [h]
      _ = _ := by rw [Scheme.Hom.comp_appTop]; rfl

  have sigma_isUnit : ∀ (U : Y.Opens) (t : Γ(Y, U)) (hLE : wcSddcLE i U t),
      IsUnit ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t)) := by
    intro U t hLE
    apply RingedSpace.isUnit_of_isUnit_germ (Limits.pullback (U.ι ≫ 𝟙 Y) O.ι).toRingedSpace ⊤
    intro a ha
    have h1 : a ∈ (Limits.pullback (U.ι ≫ 𝟙 Y) O.ι).basicOpen
        ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t)) := by
      rw [← Scheme.preimage_basicOpen_top, Scheme.Hom.mem_preimage,
        ← Scheme.Hom.apply_mem_image_iff U.ι, Scheme.Opens.ι_image_basicOpen_topIso_inv]
      have hyU : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∈ U := by
        have : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∈ Set.range U.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at this
      have hyO : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∈ (O : Set Y) := by
        have hb : Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a ∈
            Set.range (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι) := ⟨a, rfl⟩
        rw [Scheme.Pullback.range_fst, Set.mem_preimage, Scheme.Opens.range_ι,
          Scheme.Hom.comp_apply] at hb
        exact hb
      have hni : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∉ Set.range i := by
        rw [hO] at hyO
        exact hyO
      rw [Scheme.mem_basicOpen _ _ _ hyU]
      have e2 := mt (hLE.2.2.1 (U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a)) hyU).mpr hni
      exact IsLocalRing.notMem_maximalIdeal.mp e2
    rw [Scheme.mem_basicOpen_top] at h1
    exact h1
  have hσ := sigma_isUnit U t hLE
  have hσ' := sigma_isUnit U' t' hLE'
  apply tsep W
  intro x
  have hg : g.left ≫ (U.ι ≫ 𝟙 Y) = W.hom := MorphismProperty.Over.w g
  have hg' : g'.left ≫ (U'.ι ≫ 𝟙 Y) = W.hom := MorphismProperty.Over.w g'
  have hyU : W.hom x ∈ U := by
    have h1 : W.hom x = U.ι (g.left x) := by rw [← hg]; rfl
    rw [h1]
    have : U.ι (g.left x) ∈ Set.range U.ι := ⟨_, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  have hyU' : W.hom x ∈ U' := by
    have h1 : W.hom x = U'.ι (g'.left x) := by rw [← hg']; rfl
    rw [h1]
    have : U'.ι (g'.left x) ∈ Set.range U'.ι := ⟨_, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  obtain ⟨u, hu⟩ := s3 U U' t t' hLE hLE' (W.hom x) hyU hyU'
  obtain ⟨G, hGU, hGU', hyG, e, he⟩ := s4 U U' t t' (W.hom x) hyU hyU' u hu
  refine ⟨W.hom ⁻¹ᵁ G, hyG, ?_⟩
  set N : W.left.Opens := W.hom ⁻¹ᵁ G with hN
  set V : Y.ProEt := wcSddcOpenSub W N with hV
  set ι : V ⟶ W := wcSddcOpenSubIncl W N with hι
  have hWV : ⊤ ≤ V.hom ⁻¹ᵁ G := by
    intro v _
    have : N.ι v ∈ Set.range N.ι := ⟨v, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this
  have nat : ∀ (U₀ : Y.Opens) (k₀ : W ⟶ wcSddcYU Y U₀) (m : (wcSddcMPre Y O).obj
      (Opposite.op (wcSddcYU Y U₀))),
      D.obj.map ι.op (D.obj.map k₀.op (p'.app (Opposite.op (wcSddcYU Y U₀)) m)) =
        p'.app (Opposite.op V) ((wcSddcMPre Y O).map (ι ≫ k₀).op m) := by
    intro U₀ k₀ m
    rw [NatTrans.naturality_apply, op_comp, Functor.map_comp_apply]
  rw [nat, nat]
  let fstV := (wcSddcFst Y O).app V
  let E : ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).obj
        (Opposite.op V) :=
    ULift.up (Additive.ofMul (Units.map (V.hom.appLE G ⊤ hWV).hom.toMonoidHom e))
  have hval : ∀ (U₀ : Y.Opens) (t₀ : Γ(Y, U₀))
      (hσ₀ : IsUnit ((Limits.pullback.fst (U₀.ι ≫ 𝟙 Y) O.ι).appTop.hom (U₀.topIso.inv.hom t₀)))
      (k₀ : V ⟶ wcSddcYU Y U₀) (hG0 : G ≤ U₀),
      (((Additive.toMul ((wcSddcMPre Y O).map k₀.op (wcSddcSigma Y O U₀ t₀)).down) :
          (Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤))ˣ) : Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤)) =
        fstV.appTop.hom ((V.hom.appLE G ⊤ hWV).hom ((Y.presheaf.map (homOfLE hG0).op).hom t₀)) := by
    intro U₀ t₀ hσ₀ k₀ hG0
    have hn := (wcSddcFst Y O).naturality k₀
    change ((wcProEtBaseChange O.ι).map k₀).left ≫ Limits.pullback.fst (U₀.ι ≫ 𝟙 Y) O.ι =
      fstV ≫ k₀.left at hn
    have hn' := appTop_comm ((wcProEtBaseChange O.ι).map k₀).left
      (Limits.pullback.fst (U₀.ι ≫ 𝟙 Y) O.ι) fstV k₀.left hn (U₀.topIso.inv.hom t₀)
    change ((wcProEtBaseChange O.ι).map k₀).left.appTop.hom
      ((wcSddcUnitOr ((Limits.pullback.fst (U₀.ι ≫ 𝟙 Y) O.ι).appTop.hom
        (U₀.topIso.inv.hom t₀)) : _ˣ) : Γ(Limits.pullback (U₀.ι ≫ 𝟙 Y) O.ι, ⊤)) = _
    rw [wcSddcUnitOr, dif_pos hσ₀, IsUnit.unit_spec]
    exact hn'.trans (congrArg fstV.appTop.hom (tkey V U₀ G t₀ k₀ hG0 hWV))
  have hext : ∀ a b : (wcSddcMPre Y O).obj (Opposite.op V),
      (((Additive.toMul a.down) : (Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤))ˣ) :
        Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤)) =
      (((Additive.toMul b.down) : (Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤))ˣ) :
        Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤)) → a = b := by
    intro a b h
    exact ULift.ext _ _ (Additive.toMul.injective (Units.ext h))
  have hE : (((Additive.toMul ((wcSddcIota Y O).app (Opposite.op V) E).down) :
          (Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤))ˣ) : Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤)) =
        fstV.appTop.hom ((V.hom.appLE G ⊤ hWV).hom (e : Γ(Y, G))) := rfl
  have hsr : (wcSddcMPre Y O).map (ι ≫ g').op (wcSddcSigma Y O U' t') =
      (wcSddcIota Y O).app (Opposite.op V) E +
        (wcSddcMPre Y O).map (ι ≫ g).op (wcSddcSigma Y O U t) := by
    apply hext
    refine (hval U' t' hσ' _ hGU').trans ?_
    show _ = (((Additive.toMul ((wcSddcIota Y O).app (Opposite.op V) E).down) :
          (Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤))ˣ) : Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤)) *
      (((Additive.toMul ((wcSddcMPre Y O).map (ι ≫ g).op (wcSddcSigma Y O U t)).down) :
          (Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤))ˣ) : Γ(((wcProEtBaseChange O.ι).obj V).left, ⊤))
    rw [hval U t hσ _ hGU, hE, he, map_mul]
    exact map_mul fstV.appTop.hom _ _
  have hιD : p'.app (Opposite.op V) ((wcSddcIota Y O).app (Opposite.op V) E) = 0 := by
    have h0 := congrArg (fun φ => (φ.app (Opposite.op V)).hom E) hw
    simp only [NatTrans.comp_app, NatTrans.app_zero] at h0
    exact h0
  rw [hsr, map_add, hιD, zero_add]

theorem wc_sddcld_sigma_isUnit {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (hO : (O : Set Y) = (Set.range i)ᶜ) (U : Y.Opens) (t : Γ(Y, U)) (hLE : wcSddcLE i U t) :
    IsUnit ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t)) :=
by
  apply RingedSpace.isUnit_of_isUnit_germ (Limits.pullback (U.ι ≫ 𝟙 Y) O.ι).toRingedSpace ⊤
  intro a ha
  have h1 : a ∈ (Limits.pullback (U.ι ≫ 𝟙 Y) O.ι).basicOpen
      ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t)) := by
    rw [← Scheme.preimage_basicOpen_top, Scheme.Hom.mem_preimage,
      ← Scheme.Hom.apply_mem_image_iff U.ι, Scheme.Opens.ι_image_basicOpen_topIso_inv]
    have hyU : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∈ U := by
      have : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∈ Set.range U.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have hyO : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∈ (O : Set Y) := by
      have hb : Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a ∈
          Set.range (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι) := ⟨a, rfl⟩
      rw [Scheme.Pullback.range_fst, Set.mem_preimage, Scheme.Opens.range_ι,
        Scheme.Hom.comp_apply] at hb
      exact hb
    have hni : U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a) ∉ Set.range i := by
      rw [hO] at hyO
      exact hyO
    rw [Scheme.mem_basicOpen _ _ _ hyU]
    have e2 := mt (hLE.2.2.1 (U.ι (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι a)) hyU).mpr hni
    exact IsLocalRing.notMem_maximalIdeal.mp e2
  rw [Scheme.mem_basicOpen_top] at h1
  exact h1

theorem wc_sddccm_class_nondeg (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology Y)
      ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
    (hM : Presheaf.IsSheaf (Scheme.ProEt.topology Y) (wcSddcMPre Y O))
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (p : (⟨_, hM⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ⟶ D)
    (w : (ObjectProperty.homMk (wcSddcIota Y O) :
      (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ⟶ ⟨_, hM⟩) ≫ p = 0)
    (hSES : (ShortComplex.mk _ p w).ShortExact) : wcSddcHn i O p.hom :=
by
  classical

  have alg : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S), Function.Injective φ →
      ∀ (τ : R), ¬ IsUnit τ → ∀ (ν : Sˣ), (ν : S) = φ τ → ∀ (v : Rˣ) (c : ℤ),
      φ (v : R) = ((ν ^ c : Sˣ) : S) → c = 0 := by
    intro R S _ _ φ hφ τ hτ ν hν v c hv
    rcases c with n | n
    · rcases Nat.eq_zero_or_pos n with rfl | hn
      · rfl
      · exfalso
        apply hτ
        rw [Int.ofNat_eq_coe, zpow_natCast, Units.val_pow_eq_pow_val, hν, ← map_pow] at hv
        have h1 := hφ hv
        exact (isUnit_pow_iff hn.ne').mp (by rw [← h1]; exact v.isUnit)
    · exfalso
      apply hτ
      rw [zpow_negSucc] at hv
      have h1 : φ ((v : R) * τ ^ (n + 1)) = φ 1 := by
        rw [map_mul, map_pow, ← hν, hv, map_one, ← Units.val_pow_eq_pow_val, Units.inv_mul]
      have h2 := hφ h1
      exact (isUnit_pow_iff (Nat.succ_ne_zero n)).mp
        (isUnit_iff_exists_inv.mpr ⟨(v : R), by rw [mul_comm]; exact h2⟩)

  haveI : Smooth pY := SmoothOfRelativeDimension.smooth (d + 1) pY
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : ∀ x : Y, IsDomain (Y.presheaf.stalk x) :=
    fun x => (wc_fntame_smooth_stalk_normal k Y pY x).1
  haveI : AlgebraicGeometry.IsReduced Y := isReduced_of_isReduced_stalk Y
  have hT : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  have hl0 := wc_sdgri_reduced_local_nzd_avoiding_closed Y (Set.range i) hT
    (fun y hy => wc_smooth_divisor_generic_not_mem k pY d i y hy)
  have hloc : ∀ y : Y, ∃ U : Y.Opens, IsAffineOpen U ∧ y ∈ U ∧
      ∃ t ∈ nonZeroDivisors Γ(Y, U), Y.basicOpen t ≤ O := by
    intro y
    obtain ⟨U, hU, hy, t, ht, hTt⟩ := hl0 y
    refine ⟨U, hU, hy, t, ht, fun x hx => ?_⟩
    rw [← SetLike.mem_coe, hO]
    exact hTt x hx
  have hfstinj : ∀ W : Y.ProEt, Function.Injective (Limits.pullback.fst W.hom O.ι).appTop.hom := by
    intro W
    haveI : Flat W.hom := @WeaklyEtale.flat _ _ W.hom W.prop
    have hsnd := wc_sdgri_flat_restrict_injective_of_local_nzd W.hom O hloc
    have hsym : Function.Injective
        (Limits.pullbackSymmetry W.hom O.ι).hom.appTop.hom := by
      intro a b hab
      have h1 : ∀ x, (Limits.pullbackSymmetry W.hom O.ι).inv.appTop.hom
          ((Limits.pullbackSymmetry W.hom O.ι).hom.appTop.hom x) = x := by
        intro x
        rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id,
          Scheme.Hom.id_appTop]
        rfl
      rw [← h1 a, ← h1 b, hab]
    have e : Limits.pullback.fst W.hom O.ι =
        (Limits.pullbackSymmetry W.hom O.ι).hom ≫ Limits.pullback.snd O.ι W.hom :=
      (Limits.pullbackSymmetry_hom_comp_snd W.hom O.ι).symm
    rw [e, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.coe_comp]
    exact hsym.comp hsnd

  have compAT : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : Γ(C, ⊤)),
      (f ≫ g).appTop.hom x = f.appTop.hom (g.appTop.hom x) := by
    intro A B C f g x
    rw [Scheme.Hom.comp_appTop]
    rfl

  intro W U t g c hLE hw h
  obtain ⟨w₀, hw₀⟩ := hw

  have hnat : (p.hom.app (Opposite.op W)).hom ((wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t)) =
      D.obj.map g.op (p.hom.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) :=
    NatTrans.naturality_apply p.hom g.op (wcSddcSigma Y O U t)
  have hker : (p.hom.app (Opposite.op W)).hom
      (c • (wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t)) = 0 := by
    rw [map_zsmul, hnat]
    exact h

  obtain ⟨η, hηu, -⟩ := wc_proet_free_sheaf_yoneda Y
  obtain ⟨mh, hmh, -⟩ := hηu W ⟨_, hM⟩ (c • (wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t))
  have hmh0 : mh ≫ p = 0 := by
    apply (hηu W D 0).unique
    · show (p.hom.app (Opposite.op W)).hom ((mh.hom.app (Opposite.op W)).hom (η W)) = 0
      rw [hmh]
      exact hker
    · have e : (0 : wcFreeSheaf Y W ⟶ D).hom = 0 :=
        (sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map_zero _ _
      rw [e, NatTrans.app_zero]
      rfl
  have hex := hSES.exact
  haveI := hSES.mono_f
  have hah := hex.lift_f mh hmh0
  set a := ((hex.lift mh hmh0).hom.app (Opposite.op W)).hom (η W) with ha_def
  have ha : ((wcSddcIota Y O).app (Opposite.op W)).hom a =
      c • (wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t) := by
    have e := congrArg (fun f => (f.hom.app (Opposite.op W)).hom (η W)) hah
    rw [← hmh]
    exact e

  have hv : (Limits.pullback.fst W.hom O.ι).appTop.hom
      ((Additive.toMul a.down : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) =
      (((Additive.toMul ((wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t)).down :
        (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) ^ c : (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) :
        Γ(Limits.pullback W.hom O.ι, ⊤)) := by
    have h' := congrArg (fun x => ((Additive.toMul x.down : (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) :
      Γ(Limits.pullback W.hom O.ι, ⊤))) ha
    have e2 : (Additive.toMul (c • (wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t)).down :
          (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) =
        (Additive.toMul ((wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t)).down :
          (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) ^ c := by
      first
        | exact toMul_zsmul c _
        | rfl
    exact h'.trans (congrArg Units.val e2)

  have hσ := wc_sddcld_sigma_isUnit i O hO U t hLE
  have hK4 : ((Additive.toMul ((wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t)).down :
        (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) : Γ(Limits.pullback W.hom O.ι, ⊤)) =
      ((wcProEtBaseChange O.ι).map g).left.appTop.hom
        ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t)) := by
    show ((wcProEtBaseChange O.ι).map g).left.appTop.hom
      ((wcSddcUnitOr ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t)) :
        (Γ(Limits.pullback (U.ι ≫ 𝟙 Y) O.ι, ⊤))ˣ) : Γ(Limits.pullback (U.ι ≫ 𝟙 Y) O.ι, ⊤)) = _
    unfold wcSddcUnitOr
    rw [dif_pos hσ, IsUnit.unit_spec]
  have hnatF : ((wcProEtBaseChange O.ι).map g).left ≫ Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι =
      Limits.pullback.fst W.hom O.ι ≫ g.left := (wcSddcFst Y O).naturality g
  have hν : ((Additive.toMul ((wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t)).down :
        (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) : Γ(Limits.pullback W.hom O.ι, ⊤)) =
      (Limits.pullback.fst W.hom O.ι).appTop.hom (g.left.appTop.hom (U.topIso.inv.hom t)) := by
    rw [hK4]
    have e1 := compAT ((wcProEtBaseChange O.ι).map g).left
      (Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι) (U.topIso.inv.hom t)
    have e2 := congrArg (fun f => f.appTop.hom (U.topIso.inv.hom t)) hnatF
    have e3 := compAT (Limits.pullback.fst W.hom O.ι) g.left (U.topIso.inv.hom t)
    exact (e1.symm.trans e2).trans e3

  have hτ : ¬ IsUnit (g.left.appTop.hom (U.topIso.inv.hom t)) := by
    intro hτu
    have h1 : IsUnit ((W.left.presheaf.germ (g.left ⁻¹ᵁ ⊤) w₀ trivial).hom
        ((g.left.app ⊤).hom (U.topIso.inv.hom t))) := hτu.map _
    have h1' : IsUnit ((g.left.stalkMap w₀).hom
        (((wcSddcYU Y U).left.presheaf.germ ⊤ (g.left w₀) trivial).hom (U.topIso.inv.hom t))) := by
      have e : (g.left.stalkMap w₀).hom
          (((wcSddcYU Y U).left.presheaf.germ ⊤ (g.left w₀) trivial).hom (U.topIso.inv.hom t)) =
          (W.left.presheaf.germ (g.left ⁻¹ᵁ ⊤) w₀ trivial).hom
            ((g.left.app ⊤).hom (U.topIso.inv.hom t)) :=
        congrArg (fun f => f.hom (U.topIso.inv.hom t)) (Scheme.Hom.germ_stalkMap g.left ⊤ w₀ trivial)
      rw [e]
      exact h1
    have h2 := (isUnit_map_iff (g.left.stalkMap w₀).hom _).mp h1'
    have h3 : g.left w₀ ∈ (U : Scheme.{u}).basicOpen (U.topIso.inv.hom t) :=
      ((U : Scheme.{u}).mem_basicOpen_top _ _).mpr h2
    have h4 : U.ι (g.left w₀) ∈ U.ι ''ᵁ (U : Scheme.{u}).basicOpen (U.topIso.inv.hom t) :=
      (Scheme.Hom.apply_mem_image_iff U.ι).mpr h3
    rw [Scheme.Opens.ι_image_basicOpen_topIso_inv] at h4
    have hy : W.hom w₀ = U.ι (g.left w₀) := by
      rw [← MorphismProperty.Over.w g]
      show (g.left ≫ U.ι ≫ 𝟙 Y) w₀ = _
      first
        | rfl
        | (rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]; rfl)
        | simp
    rw [← hy] at h4
    have hyU : W.hom w₀ ∈ U := Y.basicOpen_le t h4
    have h5 := (Y.mem_basicOpen t (W.hom w₀) hyU).mp h4
    have h6 := ((hLE.2.2.1 (W.hom w₀) hyU).mp hw₀)
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h6
    exact h6 h5
  exact alg _ (hfstinj W) _ hτ _ hν _ c hv

theorem wc_sddccm_desc_exists_unique {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (O : Y.Opens) (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (p' : wcSddcMPre Y O ⟶ D.obj) (h0 : wcSddcH0 i O p') (hc : wcSddcHc i O p')
    (hex : ∀ z : Z, ∃ (U : Y.Opens) (t : Γ(Y, U)), i z ∈ U ∧ wcSddcLE i U t)
    (W : Y.ProEt) (b : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W))) :
    ∃! s : D.obj.obj (Opposite.op W), wcSddcDesc i O p' W b s :=
by
  classical
  have t_s1 : ∀ {ι : Type u} (N : ι → W.left.Opens), (∀ x : W.left, ∃ j, x ∈ N j) →
      Sieve.generate (Presieve.ofArrows (fun j => wcSddcOpenSub W (N j))
        (fun j => wcSddcOpenSubIncl W (N j))) ∈ Scheme.ProEt.topology Y W := by
    intro ι N hN
    apply Precoverage.generate_mem_toGrothendieck
    rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    have hle : Scheme.zariskiPrecoverage ≤ Scheme.proetalePrecoverage := by
      haveI : MorphismProperty.ContainsIdentities (@WeaklyEtale : MorphismProperty Scheme.{u}) :=
        MorphismProperty.IsMultiplicative.toContainsIdentities
      exact Scheme.zariskiPrecoverage_le_propQCPrecoverage (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
    apply hle
    rw [Scheme.ofArrows_mem_precoverage_iff]
    refine ⟨fun x => ?_, fun j => ?_⟩
    · obtain ⟨j, hj⟩ := hN x
      refine ⟨j, ?_⟩
      show x ∈ Set.range (N j).ι
      rw [Scheme.Opens.range_ι]
      exact hj
    · show IsOpenImmersion (N j).ι
      infer_instance
  have t_s4 : ∀ {ι : Type u} (N : ι → W.left.Opens)
      (hcov : Sieve.generate (Presieve.ofArrows (fun j => wcSddcOpenSub W (N j))
        (fun j => wcSddcOpenSubIncl W (N j))) ∈ Scheme.ProEt.topology Y W)
      (v : ∀ j, D.obj.obj (Opposite.op (wcSddcOpenSub W (N j)))),
      (∀ (j k : ι) (T : Y.ProEt) (ga : T ⟶ wcSddcOpenSub W (N j))
        (gb : T ⟶ wcSddcOpenSub W (N k)),
        ga ≫ wcSddcOpenSubIncl W (N j) = gb ≫ wcSddcOpenSubIncl W (N k) →
        D.obj.map ga.op (v j) = D.obj.map gb.op (v k)) →
      ∃! s : D.obj.obj (Opposite.op W), ∀ j, D.obj.map (wcSddcOpenSubIncl W (N j)).op s = v j := by
    intro ι N hcov v hv
    have hD := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology Y) D.obj
      (forget AddCommGrpCat.{u+1})).1 D.property
    have hD' := (isSheaf_iff_isSheaf_of_type _ _).1 hD
    have hR := hD'.isSheafFor _ hcov
    exact (Presieve.isSheafFor_arrows_iff _ _).1 hR v hv

  have t_s2 : ∀ (N N' : W.left.Opens) (v : D.obj.obj (Opposite.op (wcSddcOpenSub W N)))
      (v' : D.obj.obj (Opposite.op (wcSddcOpenSub W N'))),
      wcSddcDatum i O p' W b N v → wcSddcDatum i O p' W b N' v' →
      ∀ (T : Y.ProEt) (ga : T ⟶ wcSddcOpenSub W N) (gb : T ⟶ wcSddcOpenSub W N'),
      ga ≫ wcSddcOpenSubIncl W N = gb ≫ wcSddcOpenSubIncl W N' →
      D.obj.map ga.op v = D.obj.map gb.op v' := by
    intro N N' v v' hv hv' T ga gb hab
    have hF : ∀ {A B C : Y.ProEt} (a : A ⟶ B) (c : B ⟶ C) (x : D.obj.obj (Opposite.op C)),
        D.obj.map a.op (D.obj.map c.op x) = D.obj.map (a ≫ c).op x := by
      intro A B C a c x
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
    by_cases hT : ∃ w : T.left, T.hom w ∈ Set.range i
    · obtain ⟨z'', hz''⟩ := hT
      have hmemN : ∀ (M : W.left.Opens) (gm : T ⟶ wcSddcOpenSub W M),
          (gm ≫ wcSddcOpenSubIncl W M).left z'' ∈ M := by
        intro M gm
        have h1 : (gm ≫ wcSddcOpenSubIncl W M).left z'' = M.ι (gm.left z'') :=
          Scheme.Hom.comp_apply gm.left M.ι z''
        rw [h1, ← SetLike.mem_coe, ← Scheme.Opens.range_ι M]
        exact ⟨_, rfl⟩
      set x'' := (ga ≫ wcSddcOpenSubIncl W N).left z'' with hx''
      have hxN : x'' ∈ N := hmemN N ga
      have hxN' : x'' ∈ N' := by
        rw [hx'', hab]
        exact hmemN N' gb
      have hWx : W.hom x'' ∈ Set.range i := by
        have hw : (ga ≫ wcSddcOpenSubIncl W N).left ≫ W.hom = T.hom := by
          first
            | exact MorphismProperty.Over.w _
            | simpa using (ga ≫ wcSddcOpenSubIncl W N).w
        have := Scheme.Hom.comp_apply (ga ≫ wcSddcOpenSubIncl W N).left W.hom z''
        rw [hw] at this
        rw [hx'', ← this]
        exact hz''
      have hxP : x'' ∈ Set.range (Limits.pullback.fst W.hom i) := by
        rw [Scheme.Pullback.range_fst]
        exact hWx
      obtain ⟨z₁, hz₁⟩ := hxP
      rcases hv with ⟨hA, -⟩ | ⟨U, t, c, g, hLE, hb, rfl⟩
      · exact absurd (hz₁ ▸ hxN) (hA z₁)
      rcases hv' with ⟨hA', -⟩ | ⟨U', t', c', g', hLE', hb', rfl⟩
      · exact absurd (hz₁ ▸ hxN') (hA' z₁)
      have hcc : c = c' := (hb z₁ (hz₁ ▸ hxN)).symm.trans (hb' z₁ (hz₁ ▸ hxN'))
      subst hcc
      rw [map_zsmul, map_zsmul, hF, hF, hc T U U' t t' (ga ≫ g) (gb ≫ g') hLE hLE']
    · push_neg at hT
      have hzero : ∀ (M : W.left.Opens) (u : D.obj.obj (Opposite.op (wcSddcOpenSub W M))),
          wcSddcDatum i O p' W b M u → ∀ f : T ⟶ wcSddcOpenSub W M, D.obj.map f.op u = 0 := by
        intro M u hu f
        rcases hu with ⟨-, rfl⟩ | ⟨U, t, c, g, -, -, rfl⟩
        · exact map_zero _
        · rw [map_zsmul, hF, ← NatTrans.naturality_apply p' (f ≫ g).op (wcSddcSigma Y O U t),
            h0 T _ hT, smul_zero]
      rw [hzero N v hv ga, hzero N' v' hv' gb]
  have t_s3 : ∀ x : W.left, ∃ (N : W.left.Opens) (v : D.obj.obj (Opposite.op (wcSddcOpenSub W N))),
      x ∈ N ∧ wcSddcDatum i O p' W b N v := by
    intro x
    have hπ : Topology.IsClosedEmbedding (Limits.pullback.fst W.hom i) :=
      Scheme.Hom.isClosedEmbedding _
    by_cases hx : x ∈ Set.range (Limits.pullback.fst W.hom i)
    · obtain ⟨z₀, hz₀⟩ := hx
      have hWx : W.hom x = i (Limits.pullback.snd W.hom i z₀) := by
        rw [← hz₀, ← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      obtain ⟨U, t, hU, hLE⟩ := hex (Limits.pullback.snd W.hom i z₀)
      let fb : C(↥(Limits.pullback W.hom i), ℤ) :=
        (show ULift.{u+1} C(↥((wcProEtBaseChange i).obj W).left, ℤ) from b).down
      have hfb : ∀ z, wcContEval Z ((wcProEtBaseChange i).obj W) b z = fb z := fun z => rfl
      have hS : IsOpen (fb ⁻¹' {fb z₀}) := fb.continuous.isOpen_preimage _ (isOpen_discrete _)
      obtain ⟨G, hG, hpre⟩ := hπ.isInducing.isOpen_iff.1 hS
      let N : W.left.Opens := ⟨G, hG⟩ ⊓ W.hom ⁻¹ᵁ U
      have hxN : x ∈ N := by
        refine ⟨?_, ?_⟩
        · show x ∈ G
          have : z₀ ∈ (Limits.pullback.fst W.hom i) ⁻¹' G := by rw [hpre]; rfl
          rw [← hz₀]; exact this
        · show W.hom x ∈ U
          rw [hWx]; exact hU
      let g : wcSddcOpenSub W N ⟶ wcSddcYU Y U :=
        MorphismProperty.Over.homMk (W.hom.resLE U N inf_le_right)
          (by
            show W.hom.resLE U N inf_le_right ≫ U.ι ≫ 𝟙 Y = N.ι ≫ W.hom
            rw [Category.comp_id, Scheme.Hom.resLE_comp_ι]) trivial
      refine ⟨N, fb z₀ • D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)),
        hxN, Or.inr ⟨U, t, fb z₀, g, hLE, fun z hz => ?_, rfl⟩⟩
      have h1 : z ∈ (Limits.pullback.fst W.hom i) ⁻¹' G := hz.1
      rw [hpre] at h1
      exact h1
    · refine ⟨⟨(Set.range (Limits.pullback.fst W.hom i))ᶜ, hπ.isClosed_range.isOpen_compl⟩, 0, hx,
        Or.inl ⟨fun z hz => hz ⟨z, rfl⟩, rfl⟩⟩
  have hF : ∀ {A B C : Y.ProEt} (a : A ⟶ B) (c : B ⟶ C) (x : D.obj.obj (Opposite.op C)),
      D.obj.map a.op (D.obj.map c.op x) = D.obj.map (a ≫ c).op x := by
    intro A B C a c x
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

  have hD0 : ∀ s : D.obj.obj (Opposite.op W), wcSddcDesc i O p' W b s ↔
      ∀ x : W.left, ∃ N : W.left.Opens, x ∈ N ∧
        wcSddcDatum i O p' W b N (D.obj.map (wcSddcOpenSubIncl W N).op s) := fun s => Iff.rfl

  choose Nx vx hx hd using t_s3
  have hcov := t_s1 Nx (fun x => ⟨x, hx x⟩)
  obtain ⟨s, hs, -⟩ := t_s4 Nx hcov vx (fun j k T ga gb hab =>
    t_s2 (Nx j) (Nx k) (vx j) (vx k) (hd j) (hd k) T ga gb hab)
  have hdesc : wcSddcDesc i O p' W b s := by
    rw [hD0]
    intro x
    refine ⟨Nx x, hx x, ?_⟩
    rw [hs x]
    exact hd x
  refine ⟨s, hdesc, fun s' hs' => ?_⟩

  have uniq : ∀ s₁ s₂ : D.obj.obj (Opposite.op W), wcSddcDesc i O p' W b s₁ →
      wcSddcDesc i O p' W b s₂ → s₁ = s₂ := by
    intro s₁ s₂ h₁ h₂
    rw [hD0] at h₁ h₂
    choose N₁ hx₁ hd₁ using h₁
    choose N₂ hx₂ hd₂ using h₂
    let N'' : W.left → W.left.Opens := fun x => N₁ x ⊓ N₂ x
    have hcov'' := t_s1 N'' (fun x => ⟨x, ⟨hx₁ x, hx₂ x⟩⟩)
    let k₁ : ∀ x, wcSddcOpenSub W (N'' x) ⟶ wcSddcOpenSub W (N₁ x) := fun x =>
      MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_left : N₁ x ⊓ N₂ x ≤ N₁ x))
        (by
          show W.left.homOfLE _ ≫ (N₁ x).ι ≫ W.hom = (N₁ x ⊓ N₂ x).ι ≫ W.hom
          rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
    let k₂ : ∀ x, wcSddcOpenSub W (N'' x) ⟶ wcSddcOpenSub W (N₂ x) := fun x =>
      MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_right : N₁ x ⊓ N₂ x ≤ N₂ x))
        (by
          show W.left.homOfLE _ ≫ (N₂ x).ι ≫ W.hom = (N₁ x ⊓ N₂ x).ι ≫ W.hom
          rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
    have hk₁ : ∀ x, k₁ x ≫ wcSddcOpenSubIncl W (N₁ x) = wcSddcOpenSubIncl W (N'' x) := fun x =>
      MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_left : N₁ x ⊓ N₂ x ≤ N₁ x))
    have hk₂ : ∀ x, k₂ x ≫ wcSddcOpenSubIncl W (N₂ x) = wcSddcOpenSubIncl W (N'' x) := fun x =>
      MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_right : N₁ x ⊓ N₂ x ≤ N₂ x))
    have hglue := t_s4 N'' hcov'' (fun x => D.obj.map (wcSddcOpenSubIncl W (N'' x)).op s₂)
      (fun j k T ga gb hab => by rw [hF, hF, hab])
    refine hglue.unique (fun x => ?_) (fun x => rfl)
    calc D.obj.map (wcSddcOpenSubIncl W (N'' x)).op s₁
        = D.obj.map (k₁ x).op (D.obj.map (wcSddcOpenSubIncl W (N₁ x)).op s₁) := by
          rw [hF, hk₁ x]
      _ = D.obj.map (k₂ x).op (D.obj.map (wcSddcOpenSubIncl W (N₂ x)).op s₂) := ?_
      _ = D.obj.map (wcSddcOpenSubIncl W (N'' x)).op s₂ := by
          rw [hF, hk₂ x]
    exact t_s2 (N₁ x) (N₂ x) _ _ (hd₁ x) (hd₂ x) _ (k₁ x) (k₂ x)
      ((hk₁ x).trans (hk₂ x).symm)
  exact uniq s' s hs' hdesc

theorem wc_sddccm_desc_restrict {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (p' : wcSddcMPre Y O ⟶ D.obj)
    {W W' : Y.ProEt} (f : W' ⟶ W)
    (b : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W)))
    (s : D.obj.obj (Opposite.op W)) (h : wcSddcDesc i O p' W b s) :
    wcSddcDesc i O p' W' ((wcContSheaf Z ℤ).obj.map ((wcProEtBaseChange i).map f).op b)
      (D.obj.map f.op s) :=
by
  classical
  intro x'
  obtain ⟨N, hxN, hND⟩ := h (f.left x')
  let N' : W'.left.Opens := f.left ⁻¹ᵁ N
  have hx' : x' ∈ N' := hxN
  have hk : f.left.resLE N N' le_rfl ≫ (wcSddcOpenSub W N).hom = (wcSddcOpenSub W' N').hom := by
    show f.left.resLE N N' le_rfl ≫ (N.ι ≫ W.hom) = N'.ι ≫ W'.hom
    rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, MorphismProperty.Over.w f]
  let k : wcSddcOpenSub W' N' ⟶ wcSddcOpenSub W N :=
    MorphismProperty.Over.homMk (f.left.resLE N N' le_rfl) hk trivial
  have hSq : k ≫ wcSddcOpenSubIncl W N = wcSddcOpenSubIncl W' N' ≫ f := by
    apply MorphismProperty.Over.Hom.ext
    show f.left.resLE N N' le_rfl ≫ N.ι = N'.ι ≫ f.left
    exact Scheme.Hom.resLE_comp_ι _ _
  have hR : ∀ σ₀ : D.obj.obj (Opposite.op W),
      D.obj.map (wcSddcOpenSubIncl W' N').op (D.obj.map f.op σ₀) =
        D.obj.map k.op (D.obj.map (wcSddcOpenSubIncl W N).op σ₀) := by
    intro σ₀
    rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
      ← Functor.map_comp, ← op_comp, ← op_comp, hSq]
  have hsq : ((wcProEtBaseChange i).map f).left ≫ Limits.pullback.fst W.hom i =
      Limits.pullback.fst W'.hom i ≫ f.left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have hP : ∀ z' : ↥(Limits.pullback W'.hom i),
      Limits.pullback.fst W.hom i (((wcProEtBaseChange i).map f).left z') =
        f.left (Limits.pullback.fst W'.hom i z') := by
    intro z'
    have e := congrArg (fun m : Limits.pullback W'.hom i ⟶ W.left => m z') hsq
    first
      | exact (Scheme.Hom.comp_apply _ _ z').symm.trans (e.trans (Scheme.Hom.comp_apply _ _ z'))
      | exact e
      | (simp only [Scheme.Hom.comp_apply] at e; exact e)
  have hE : ∀ z' : ↥(Limits.pullback W'.hom i),
      wcContEval Z ((wcProEtBaseChange i).obj W')
          ((wcContSheaf Z ℤ).obj.map ((wcProEtBaseChange i).map f).op b) z' =
        wcContEval Z ((wcProEtBaseChange i).obj W) b (((wcProEtBaseChange i).map f).left z') := by
    intro z'
    rfl
  refine ⟨N', hx', ?_⟩
  rcases hND with ⟨hA, h0s⟩ | ⟨U, t, c, g, hLE, hb, heq⟩
  · left
    refine ⟨fun z' hz' => hA (((wcProEtBaseChange i).map f).left z') ?_, ?_⟩
    · rw [hP]
      exact hz'
    · rw [hR, h0s, map_zero]
  · right
    refine ⟨U, t, c, k ≫ g, hLE, fun z' hz' => ?_, ?_⟩
    · rw [hE]
      apply hb
      rw [hP]
      exact hz'
    · rw [hR, heq, map_zsmul, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

theorem wc_sddccm_desc_add {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (p' : wcSddcMPre Y O ⟶ D.obj)
    (h0 : wcSddcH0 i O p') (hc : wcSddcHc i O p') (W : Y.ProEt)
    (b b' : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W)))
    (s s' : D.obj.obj (Opposite.op W)) (h : wcSddcDesc i O p' W b s)
    (h' : wcSddcDesc i O p' W b' s') : wcSddcDesc i O p' W (b + b') (s + s') :=
by
  classical
  have hF : ∀ {A B C : Y.ProEt} (a : A ⟶ B) (c : B ⟶ C) (x : D.obj.obj (Opposite.op C)),
      D.obj.map a.op (D.obj.map c.op x) = D.obj.map (a ≫ c).op x := by
    intro A B C a c x
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  intro x
  obtain ⟨N, hxN, hN⟩ := h x
  obtain ⟨N', hxN', hN'⟩ := h' x
  let k : wcSddcOpenSub W (N ⊓ N') ⟶ wcSddcOpenSub W N :=
    MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_left : N ⊓ N' ≤ N))
      (by
        show W.left.homOfLE _ ≫ N.ι ≫ W.hom = (N ⊓ N').ι ≫ W.hom
        rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
  let k' : wcSddcOpenSub W (N ⊓ N') ⟶ wcSddcOpenSub W N' :=
    MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_right : N ⊓ N' ≤ N'))
      (by
        show W.left.homOfLE _ ≫ N'.ι ≫ W.hom = (N ⊓ N').ι ≫ W.hom
        rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
  have hk : k ≫ wcSddcOpenSubIncl W N = wcSddcOpenSubIncl W (N ⊓ N') :=
    MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_left : N ⊓ N' ≤ N))
  have hk' : k' ≫ wcSddcOpenSubIncl W N' = wcSddcOpenSubIncl W (N ⊓ N') :=
    MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_right : N ⊓ N' ≤ N'))
  have hR : D.obj.map (wcSddcOpenSubIncl W (N ⊓ N')).op (s + s') =
      D.obj.map k.op (D.obj.map (wcSddcOpenSubIncl W N).op s) +
        D.obj.map k'.op (D.obj.map (wcSddcOpenSubIncl W N').op s') := by
    rw [map_add, hF, hF, hk, hk']
  refine ⟨N ⊓ N', ⟨hxN, hxN'⟩, ?_⟩
  by_cases hP : ∃ z : ↥(Limits.pullback W.hom i), Limits.pullback.fst W.hom i z ∈ N ⊓ N'
  · obtain ⟨z₀, hz₀⟩ := hP
    rcases hN with ⟨hA, -⟩ | ⟨U, t, c, g, hLE, hb, hs⟩
    · exact absurd hz₀.1 (hA z₀)
    rcases hN' with ⟨hA', -⟩ | ⟨U', t', c', g', hLE', hb', hs'⟩
    · exact absurd hz₀.2 (hA' z₀)
    refine Or.inr ⟨U, t, c + c', k ≫ g, hLE, fun z hz => ?_, ?_⟩
    · have hev : wcContEval Z ((wcProEtBaseChange i).obj W) (b + b') z =
          wcContEval Z ((wcProEtBaseChange i).obj W) b z +
            wcContEval Z ((wcProEtBaseChange i).obj W) b' z := rfl
      rw [hev, hb z hz.1, hb' z hz.2]
    · rw [hR, hs, hs', map_zsmul, map_zsmul, hF, hF,
        hc (wcSddcOpenSub W (N ⊓ N')) U' U t' t (k' ≫ g') (k ≫ g) hLE' hLE, add_smul]
  · have hoff : ∀ w : (wcSddcOpenSub W (N ⊓ N')).left,
        (wcSddcOpenSub W (N ⊓ N')).hom w ∉ Set.range i := by
      intro w hw
      have h1 : (wcSddcOpenSub W (N ⊓ N')).hom w = W.hom ((N ⊓ N').ι w) :=
        Scheme.Hom.comp_apply (N ⊓ N').ι W.hom w
      rw [h1] at hw
      have h2 : (N ⊓ N').ι w ∈ Set.range (Limits.pullback.fst W.hom i) := by
        rw [Scheme.Pullback.range_fst]
        exact hw
      obtain ⟨z, hz⟩ := h2
      apply hP
      refine ⟨z, ?_⟩
      rw [hz, ← SetLike.mem_coe, ← Scheme.Opens.range_ι (N ⊓ N')]
      exact ⟨w, rfl⟩
    have hzero : ∀ (M : W.left.Opens) (f : wcSddcOpenSub W (N ⊓ N') ⟶ wcSddcOpenSub W M)
        (u : D.obj.obj (Opposite.op (wcSddcOpenSub W M))),
        (u = 0 ∨ ∃ (U : Y.Opens) (t : Γ(Y, U)) (c : ℤ) (g : wcSddcOpenSub W M ⟶ wcSddcYU Y U),
          u = c • D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t))) →
        D.obj.map f.op u = 0 := by
      intro M f u hu
      rcases hu with rfl | ⟨U, t, c, g, rfl⟩
      · exact map_zero _
      · rw [map_zsmul, hF, ← NatTrans.naturality_apply p' (f ≫ g).op (wcSddcSigma Y O U t),
          h0 (wcSddcOpenSub W (N ⊓ N')) _ hoff, smul_zero]
    have e1 := hzero N k _ (hN.imp (fun hA => hA.2)
      (fun ⟨U, t, c, g, _, _, hs⟩ => ⟨U, t, c, g, hs⟩))
    have e2 := hzero N' k' _ (hN'.imp (fun hA => hA.2)
      (fun ⟨U, t, c, g, _, _, hs⟩ => ⟨U, t, c, g, hs⟩))
    refine Or.inl ⟨fun z hz => hP ⟨z, hz⟩, ?_⟩
    rw [hR, e1, e2, add_zero]

theorem wc_sddccm_desc_inj {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (p' : wcSddcMPre Y O ⟶ D.obj)
    (hc : wcSddcHc i O p') (hn : wcSddcHn i O p') (W : Y.ProEt)
    (b b' : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W)))
    (s : D.obj.obj (Opposite.op W)) (h : wcSddcDesc i O p' W b s)
    (h' : wcSddcDesc i O p' W b' s) : b = b' :=
by
  have hF : ∀ {A B C : Y.ProEt} (a : A ⟶ B) (c : B ⟶ C) (x : D.obj.obj (Opposite.op C)),
      D.obj.map a.op (D.obj.map c.op x) = D.obj.map (a ≫ c).op x := by
    intro A B C a c x
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  have key : ∀ z : ↥(Limits.pullback W.hom i),
      wcContEval Z ((wcProEtBaseChange i).obj W) b z =
        wcContEval Z ((wcProEtBaseChange i).obj W) b' z := by
    intro z
    obtain ⟨N, hxN, hN⟩ := h (Limits.pullback.fst W.hom i z)
    obtain ⟨N', hxN', hN'⟩ := h' (Limits.pullback.fst W.hom i z)
    rcases hN with ⟨hA, -⟩ | ⟨U, t, c, g, hLE, hb, hs⟩
    · exact absurd hxN (hA z)
    rcases hN' with ⟨hA', -⟩ | ⟨U', t', c', g', hLE', hb', hs'⟩
    · exact absurd hxN' (hA' z)
    rw [hb z hxN, hb' z hxN']
    let k : wcSddcOpenSub W (N ⊓ N') ⟶ wcSddcOpenSub W N :=
      MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_left : N ⊓ N' ≤ N))
        (by
          show W.left.homOfLE _ ≫ N.ι ≫ W.hom = (N ⊓ N').ι ≫ W.hom
          rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
    let k' : wcSddcOpenSub W (N ⊓ N') ⟶ wcSddcOpenSub W N' :=
      MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_right : N ⊓ N' ≤ N'))
        (by
          show W.left.homOfLE _ ≫ N'.ι ≫ W.hom = (N ⊓ N').ι ≫ W.hom
          rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
    have hk : k ≫ wcSddcOpenSubIncl W N = wcSddcOpenSubIncl W (N ⊓ N') :=
      MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_left : N ⊓ N' ≤ N))
    have hk' : k' ≫ wcSddcOpenSubIncl W N' = wcSddcOpenSubIncl W (N ⊓ N') :=
      MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_right : N ⊓ N' ≤ N'))
    have e1 : D.obj.map (wcSddcOpenSubIncl W (N ⊓ N')).op s =
        c • D.obj.map (k ≫ g).op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) := by
      rw [← hk, ← hF, hs, map_zsmul, hF]
    have e2 : D.obj.map (wcSddcOpenSubIncl W (N ⊓ N')).op s =
        c' • D.obj.map (k' ≫ g').op
          (p'.app (Opposite.op (wcSddcYU Y U')) (wcSddcSigma Y O U' t')) := by
      rw [← hk', ← hF, hs', map_zsmul, hF]
    have hce := hc (wcSddcOpenSub W (N ⊓ N')) U U' t t' (k ≫ g) (k' ≫ g') hLE hLE'
    have h0 : (c - c') •
        D.obj.map (k ≫ g).op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) = 0 := by
      rw [sub_smul, ← e1, hce, ← e2, sub_self]
    have hcond : W.hom (Limits.pullback.fst W.hom i z) = i (Limits.pullback.snd W.hom i z) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    have hpt : ∃ w : (wcSddcOpenSub W (N ⊓ N')).left,
        (wcSddcOpenSub W (N ⊓ N')).hom w ∈ Set.range i := by
      refine ⟨(⟨Limits.pullback.fst W.hom i z, ⟨hxN, hxN'⟩⟩ : ↥(N ⊓ N')),
        Limits.pullback.snd W.hom i z, ?_⟩
      have h1 : (wcSddcOpenSub W (N ⊓ N')).hom
          (⟨Limits.pullback.fst W.hom i z, ⟨hxN, hxN'⟩⟩ : ↥(N ⊓ N')) =
          W.hom ((N ⊓ N').ι (⟨Limits.pullback.fst W.hom i z, ⟨hxN, hxN'⟩⟩ : ↥(N ⊓ N'))) :=
        Scheme.Hom.comp_apply (N ⊓ N').ι W.hom _
      rw [h1, Scheme.Opens.ι_apply]
      exact hcond.symm
    have hcc := hn (wcSddcOpenSub W (N ⊓ N')) U t (k ≫ g) (c - c') hLE hpt h0
    exact sub_eq_zero.mp hcc
  show (show ULift.{u+1} C(↥((wcProEtBaseChange i).obj W).left, ℤ) from b) =
    (show ULift.{u+1} C(↥((wcProEtBaseChange i).obj W).left, ℤ) from b')
  exact ULift.ext _ _ (ContinuousMap.ext key)

theorem wc_sddccm_desc_of_locDesc {Y Z : Scheme.{u}} (i : Z ⟶ Y) (O : Y.Opens)
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (p' : wcSddcMPre Y O ⟶ D.obj)
    (hc : wcSddcHc i O p') (hn : wcSddcHn i O p') (W : Y.ProEt) (s : D.obj.obj (Opposite.op W))
    (hs : ∀ x : W.left, wcSddcLocDesc i O p' W s x) :
    ∃ b, wcSddcDesc i O p' W b s :=
by
  classical
  have hF : ∀ {A B C : Y.ProEt} (a : A ⟶ B) (c : B ⟶ C) (x : D.obj.obj (Opposite.op C)),
      D.obj.map a.op (D.obj.map c.op x) = D.obj.map (a ≫ c).op x := by
    intro A B C a c x
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
  have agree : ∀ (N N' : W.left.Opens) (U U' : Y.Opens) (t : Γ(Y, U)) (t' : Γ(Y, U'))
      (c c' : ℤ) (g : wcSddcOpenSub W N ⟶ wcSddcYU Y U)
      (g' : wcSddcOpenSub W N' ⟶ wcSddcYU Y U'),
      wcSddcLE i U t → wcSddcLE i U' t' →
      D.obj.map (wcSddcOpenSubIncl W N).op s =
        c • D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) →
      D.obj.map (wcSddcOpenSubIncl W N').op s =
        c' • D.obj.map g'.op (p'.app (Opposite.op (wcSddcYU Y U')) (wcSddcSigma Y O U' t')) →
      ∀ z : ↥(Limits.pullback W.hom i), Limits.pullback.fst W.hom i z ∈ N →
        Limits.pullback.fst W.hom i z ∈ N' → c = c' := by
    intro N N' U U' t t' c c' g g' hLE hLE' hs hs' z hxN hxN'
    let k : wcSddcOpenSub W (N ⊓ N') ⟶ wcSddcOpenSub W N :=
      MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_left : N ⊓ N' ≤ N))
        (by
          show W.left.homOfLE _ ≫ N.ι ≫ W.hom = (N ⊓ N').ι ≫ W.hom
          rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
    let k' : wcSddcOpenSub W (N ⊓ N') ⟶ wcSddcOpenSub W N' :=
      MorphismProperty.Over.homMk (W.left.homOfLE (inf_le_right : N ⊓ N' ≤ N'))
        (by
          show W.left.homOfLE _ ≫ N'.ι ≫ W.hom = (N ⊓ N').ι ≫ W.hom
          rw [← Category.assoc, Scheme.homOfLE_ι]) trivial
    have hk : k ≫ wcSddcOpenSubIncl W N = wcSddcOpenSubIncl W (N ⊓ N') :=
      MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_left : N ⊓ N' ≤ N))
    have hk' : k' ≫ wcSddcOpenSubIncl W N' = wcSddcOpenSubIncl W (N ⊓ N') :=
      MorphismProperty.Over.Hom.ext (Scheme.homOfLE_ι W.left (inf_le_right : N ⊓ N' ≤ N'))
    have e1 : D.obj.map (wcSddcOpenSubIncl W (N ⊓ N')).op s =
        c • D.obj.map (k ≫ g).op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) := by
      rw [← hk, ← hF, hs, map_zsmul, hF]
    have e2 : D.obj.map (wcSddcOpenSubIncl W (N ⊓ N')).op s =
        c' • D.obj.map (k' ≫ g').op
          (p'.app (Opposite.op (wcSddcYU Y U')) (wcSddcSigma Y O U' t')) := by
      rw [← hk', ← hF, hs', map_zsmul, hF]
    have hce := hc (wcSddcOpenSub W (N ⊓ N')) U U' t t' (k ≫ g) (k' ≫ g') hLE hLE'
    have h0 : (c - c') •
        D.obj.map (k ≫ g).op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) = 0 := by
      rw [sub_smul, ← e1, hce, ← e2, sub_self]
    have hcond : W.hom (Limits.pullback.fst W.hom i z) = i (Limits.pullback.snd W.hom i z) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    have hpt : ∃ w : (wcSddcOpenSub W (N ⊓ N')).left,
        (wcSddcOpenSub W (N ⊓ N')).hom w ∈ Set.range i := by
      refine ⟨(⟨Limits.pullback.fst W.hom i z, ⟨hxN, hxN'⟩⟩ : ↥(N ⊓ N')),
        Limits.pullback.snd W.hom i z, ?_⟩
      have h1 : (wcSddcOpenSub W (N ⊓ N')).hom
          (⟨Limits.pullback.fst W.hom i z, ⟨hxN, hxN'⟩⟩ : ↥(N ⊓ N')) =
          W.hom ((N ⊓ N').ι (⟨Limits.pullback.fst W.hom i z, ⟨hxN, hxN'⟩⟩ : ↥(N ⊓ N'))) :=
        Scheme.Hom.comp_apply (N ⊓ N').ι W.hom _
      rw [h1, Scheme.Opens.ι_apply]
      exact hcond.symm
    have hcc := hn (wcSddcOpenSub W (N ⊓ N')) U t (k ≫ g) (c - c') hLE hpt h0
    exact sub_eq_zero.mp hcc
  choose N hxN hN using hs
  have hB : ∀ z : ↥(Limits.pullback W.hom i), ∃ (U : Y.Opens) (t : Γ(Y, U)) (c : ℤ)
      (g : wcSddcOpenSub W (N (Limits.pullback.fst W.hom i z)) ⟶ wcSddcYU Y U),
      wcSddcLE i U t ∧
      D.obj.map (wcSddcOpenSubIncl W (N (Limits.pullback.fst W.hom i z))).op s =
        c • D.obj.map g.op (p'.app (Opposite.op (wcSddcYU Y U)) (wcSddcSigma Y O U t)) :=
    fun z => (hN (Limits.pullback.fst W.hom i z)).resolve_left
      (fun hA => hA.1 z (hxN (Limits.pullback.fst W.hom i z)))
  choose Uz tz cz gz hLz hsz using hB
  have hloc : ∀ z z' : ↥(Limits.pullback W.hom i),
      Limits.pullback.fst W.hom i z' ∈ N (Limits.pullback.fst W.hom i z) → cz z' = cz z :=
    fun z z' h => agree _ _ _ _ _ _ _ _ (gz z') (gz z) (hLz z') (hLz z) (hsz z') (hsz z) z'
      (hxN _) h
  have hlc : IsLocallyConstant cz := by
    rw [IsLocallyConstant.iff_exists_open]
    intro z
    exact ⟨(Limits.pullback.fst W.hom i) ⁻¹' (N (Limits.pullback.fst W.hom i z) : Set W.left),
      (N _).isOpen.preimage (Limits.pullback.fst W.hom i).continuous, hxN _,
      fun z' hz' => hloc z z' hz'⟩
  let b : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W)) :=
    (show ULift.{u+1} C(↥((wcProEtBaseChange i).obj W).left, ℤ) from
      ULift.up ⟨cz, hlc.continuous⟩)
  refine ⟨b, fun x => ⟨N x, hxN x, ?_⟩⟩
  rcases hN x with hA | ⟨U, t, c, g, hL, hsx⟩
  · exact Or.inl hA
  · refine Or.inr ⟨U, t, c, g, hL, fun z hz => ?_, hsx⟩
    show cz z = c
    exact agree _ _ _ _ _ _ _ _ (gz z) g (hLz z) hL (hsz z) hsx z (hxN _) hz

theorem wc_sddc_class_map (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology Y)
      ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
    (hM : Presheaf.IsSheaf (Scheme.ProEt.topology Y) (wcSddcMPre Y O))
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (p : (⟨_, hM⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ⟶ D)
    (w : (ObjectProperty.homMk (wcSddcIota Y O) :
      (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ⟶ ⟨_, hM⟩) ≫ p = 0)
    (hSES : (ShortComplex.mk _ p w).ShortExact) :
    ∃ δ₀ : (wcProEtBaseChange i).op ⋙ (wcContSheaf Z ℤ).obj ⟶ D.obj,
      (∀ W : Y.ProEt, Function.Injective (δ₀.app (Opposite.op W))) ∧
      ∀ (W : Y.ProEt) (s : D.obj.obj (Opposite.op W)),
        (∀ x : W.left, wcSddcLocDesc i O p.hom W s x) →
        ∃ b, δ₀.app (Opposite.op W) b = s :=
by
  classical
  have hw : wcSddcIota Y O ≫ p.hom = 0 := by
    have h := congrArg
      (fun φ => (sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map φ) w
    simp only [Functor.map_comp, Functor.map_zero] at h
    exact h
  have h0 := wc_sddccm_vanish_off i O hO p.hom hw
  have hc := wc_sddccm_class_compat i O hO D p.hom hw
  have hn := wc_sddccm_class_nondeg k pY d i hG O hO hM D p w hSES
  have hex := wc_sddcld_local_equation k pY d i
  have hEU : ∀ (W : Y.ProEt)
      (b : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W))),
      ∃ s : D.obj.obj (Opposite.op W), wcSddcDesc i O p.hom W b s ∧
        ∀ s' : D.obj.obj (Opposite.op W), wcSddcDesc i O p.hom W b s' → s' = s :=
    fun W b => wc_sddccm_desc_exists_unique i O D p.hom h0 hc hex W b
  choose δW hδ huniq using hEU
  have hadd : ∀ (W : Y.ProEt)
      (b b' : (wcContSheaf Z ℤ).obj.obj (Opposite.op ((wcProEtBaseChange i).obj W))),
      δW W (b + b') = δW W b + δW W b' := fun W b b' =>
    (huniq W (b + b') _
      (wc_sddccm_desc_add i O D p.hom h0 hc W b b' _ _ (hδ W b) (hδ W b'))).symm
  let δ₀ : (wcProEtBaseChange i).op ⋙ (wcContSheaf Z ℤ).obj ⟶ D.obj :=
    { app := fun W => AddCommGrpCat.ofHom (AddMonoidHom.mk' (δW W.unop) (hadd W.unop))
      naturality := by
        intro W W' a
        ext b
        exact (huniq W'.unop _ _
          (wc_sddccm_desc_restrict i O D p.hom a.unop b (δW W.unop b) (hδ W.unop b))).symm }
  refine ⟨δ₀, fun W b b' hbb => ?_, fun W s hs => ?_⟩
  · have h1 := hδ W b
    have h2 := hδ W b'
    have hbb' : δW W b = δW W b' := hbb
    rw [← hbb'] at h2
    exact wc_sddccm_desc_inj i O D p.hom hc hn W b b' _ h1 h2
  · obtain ⟨b, hb⟩ := wc_sddccm_desc_of_locDesc i O D p.hom hc hn W s hs
    exact ⟨b, (huniq W b s hb).symm⟩

theorem wc_sddcld_equation_prime (k : Type u) [Field k] {Y Z T : Scheme.{u}}
    (pY : Y ⟶ Spec (.of k)) (d : ℕ) (i : Z ⟶ Y) [IsClosedImmersion i]
    [SmoothOfRelativeDimension d (i ≫ pY)] (q : T ⟶ Y) (hq : WeaklyEtale q)
    (U : Y.Opens) (t : Γ(Y, U)) (hLE : wcSddcLE i U t) (z : T) (hzU : q z ∈ U)
    (hzi : q z ∈ Set.range i)
    (hsh : HenselianLocalRing (T.presheaf.stalk z) ∧ IsSepClosed (T.residueField z)) :
    Prime ((T.presheaf.germ (q ⁻¹ᵁ U) z hzU).hom ((q.app U).hom t)) ∧
      ∀ a : T.presheaf.stalk z,
        (T.presheaf.germ (q ⁻¹ᵁ U) z hzU).hom ((q.app U).hom t) * a = 0 → a = 0 :=
by
  classical

  have hτ : (q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t) =
      (T.presheaf.germ (q ⁻¹ᵁ U) z hzU).hom ((q.app U).hom t) :=
    Scheme.Hom.germ_stalkMap_apply q U z hzU t

  have hA1 : ∀ a : T.presheaf.stalk z,
      (q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t) * a = 0 → a = 0 := by
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk (q z)) := (Y.presheaf.germ U (q z) hzU).hom.toAlgebra
    haveI hloc : IsLocalization.AtPrime (Y.presheaf.stalk (q z))
        (hLE.1.primeIdealOf ⟨q z, hzU⟩).asIdeal := hLE.1.isLocalization_stalk ⟨q z, hzU⟩
    haveI : Module.Flat Γ(Y, U) (Y.presheaf.stalk (q z)) :=
      IsLocalization.flat _ (hLE.1.primeIdealOf ⟨q z, hzU⟩).asIdeal.primeCompl
    have h1 : IsSMulRegular (Y.presheaf.stalk (q z)) t :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hLE.2.1
    have h2 : IsSMulRegular (Y.presheaf.stalk (q z)) ((Y.presheaf.germ U (q z) hzU).hom t) := by
      rw [isSMulRegular_iff_right_eq_zero_of_smul] at h1 ⊢
      intro a ha
      apply h1 a
      rw [Algebra.smul_def]
      exact ha
    haveI : Flat q := @WeaklyEtale.flat _ _ q hq
    letI : Algebra (Y.presheaf.stalk (q z)) (T.presheaf.stalk z) := (q.stalkMap z).hom.toAlgebra
    haveI : Module.Flat (Y.presheaf.stalk (q z)) (T.presheaf.stalk z) := Flat.stalkMap q z
    have h3 := IsSMulRegular.of_flat (S := T.presheaf.stalk z) h2
    rw [isSMulRegular_iff_right_eq_zero_of_smul] at h3
    intro a ha
    exact h3 a ha

  have hA2 : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (I : Ideal A), I ≠ ⊤ →
      HenselianLocalRing (A ⧸ I) := by
    intro A _ _ I hI
    haveI : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    haveI : IsLocalRing (A ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    haveI : IsLocalHom (Ideal.Quotient.mk I) :=
      Function.Surjective.isLocalHom _ Ideal.Quotient.mk_surjective
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ h₁ h₂
    obtain ⟨F, hFf, -, hFm⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts f).mpr (Polynomial.map_surjective _ Ideal.Quotient.mk_surjective f)) hf
    obtain ⟨b₀, rfl⟩ := Ideal.Quotient.mk_surjective a₀
    have e1 : Ideal.Quotient.mk I (F.eval b₀) = f.eval (Ideal.Quotient.mk I b₀) := by
      rw [← hFf, Polynomial.eval_map_apply]
    have e2 : Ideal.Quotient.mk I ((Polynomial.derivative F).eval b₀) =
        (Polynomial.derivative f).eval (Ideal.Quotient.mk I b₀) := by
      rw [← hFf, Polynomial.derivative_map, Polynomial.eval_map_apply]
    have h3 : F.eval b₀ ∈ IsLocalRing.maximalIdeal A := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' := hu.map (Ideal.Quotient.mk I)
      rw [e1] at hu'
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h₁)) hu'
    have h4 : IsUnit ((Polynomial.derivative F).eval b₀) :=
      (isUnit_map_iff (Ideal.Quotient.mk I) ((Polynomial.derivative F).eval b₀)).mp
        (by rw [e2]; exact h₂)
    obtain ⟨b, hb, hbb⟩ := HenselianLocalRing.is_henselian F hFm b₀ h3 h4
    refine ⟨Ideal.Quotient.mk I b, ?_, ?_⟩
    · show Polynomial.eval (Ideal.Quotient.mk I b) f = 0
      rw [← hFf, Polynomial.eval_map_apply, hb.eq_zero, map_zero]
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← map_sub]
      intro hu
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hbb))
        ((isUnit_map_iff (Ideal.Quotient.mk I) (b - b₀)).mp hu)

  have hA3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (I : Ideal A) [IsLocalRing (A ⧸ I)],
      IsSepClosed (IsLocalRing.ResidueField (A ⧸ I)) := by
    intro A _ _ _ I _
    haveI : IsLocalHom (Ideal.Quotient.mk I) :=
      Function.Surjective.isLocalHom _ Ideal.Quotient.mk_surjective
    let κ := IsLocalRing.ResidueField.map (Ideal.Quotient.mk I)
    have hsurj : Function.Surjective κ := by
      intro w
      obtain ⟨v, rfl⟩ := IsLocalRing.residue_surjective w
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective v
      exact ⟨IsLocalRing.residue A r, IsLocalRing.ResidueField.map_residue _ r⟩
    have hinj : Function.Injective κ := RingHom.injective κ
    let e := RingEquiv.ofBijective κ ⟨hinj, hsurj⟩
    refine IsSepClosed.of_exists_root _ ?_
    intro p _ hirr hsep
    have hdeg : (p.map (e.symm : IsLocalRing.ResidueField (A ⧸ I) →+*
        IsLocalRing.ResidueField A)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root _ hdeg hsep.map
    refine ⟨(e : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField (A ⧸ I)) x, ?_⟩
    have hp : (p.map (e.symm : IsLocalRing.ResidueField (A ⧸ I) →+*
        IsLocalRing.ResidueField A)).map
        (e : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField (A ⧸ I)) = p := by
      rw [Polynomial.map_map, RingEquiv.comp_symm, Polynomial.map_id]
    rw [← hp, Polynomial.eval_map_apply, hx.eq_zero, map_zero]

  have hA4 : ∀ (B R : CommRingCat.{u}) (φ : B ⟶ R), WeaklyEtale (Spec.map φ) → ∀ (J : Ideal B),
      ∃ f : Spec (CommRingCat.of (R ⧸ Ideal.map φ.hom J)) ⟶ Spec (CommRingCat.of (B ⧸ J)),
        WeaklyEtale f := by
    intro B R φ hφ J
    letI := φ.hom.toAlgebra
    have hφ' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap B R))) := hφ
    have hpb : WeaklyEtale (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B R)))
        (Spec.map (CommRingCat.ofHom (algebraMap B (B ⧸ J))))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _) hφ'
    have h2 : WeaklyEtale ((pullbackSpecIso B R (B ⧸ J)).inv ≫
        Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B R)))
          (Spec.map (CommRingCat.ofHom (algebraMap B (B ⧸ J))))) := by
      haveI := hpb
      infer_instance
    let e : TensorProduct B R (B ⧸ J) ≃+* R ⧸ Ideal.map φ.hom J :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R J).symm.toRingEquiv
    haveI := h2
    refine ⟨Spec.map e.toCommRingCatIso.hom ≫ ((pullbackSpecIso B R (B ⧸ J)).inv ≫
        Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap B R)))
          (Spec.map (CommRingCat.ofHom (algebraMap B (B ⧸ J))))), ?_⟩
    infer_instance

  have hA5 : ∀ (y : Y) (hy : y ∈ U), y ∈ Set.range i →
      ∃ f : Spec (CommRingCat.of (Y.presheaf.stalk y ⧸
        Ideal.span {(Y.presheaf.germ U y hy).hom t})) ⟶ Z, WeaklyEtale f := by
    rintro y hy ⟨z₀, rfl⟩
    obtain ⟨hs, hk⟩ := hLE.2.2.2 z₀ hy
    let e : (Y.presheaf.stalk (i z₀) ⧸ Ideal.span {(Y.presheaf.germ U (i z₀) hy).hom t}) ≃+*
        Z.presheaf.stalk z₀ :=
      (Ideal.quotEquivOfEq hk.symm).trans (RingHom.quotientKerEquivOfSurjective hs)
    haveI := wc_lfi_fromSpecStalk_weaklyEtale Z z₀
    refine ⟨Spec.map e.symm.toCommRingCatIso.hom ≫ Z.fromSpecStalk z₀, ?_⟩
    infer_instance

  have hφ : WeaklyEtale (Spec.map (q.stalkMap z)) := by
    haveI := hq
    haveI := wc_lfi_fromSpecStalk_weaklyEtale T z
    haveI := wc_lfi_fromSpecStalk_weaklyEtale Y (q z)
    haveI : WeaklyEtale (Spec.map (q.stalkMap z) ≫ Y.fromSpecStalk (q z)) := by
      rw [Scheme.SpecMap_stalkMap_fromSpecStalk]
      infer_instance
    exact WeaklyEtale.of_comp _ (Y.fromSpecStalk (q z))

  have hgm : (Y.presheaf.germ U (q z) hzU).hom t ∈
      IsLocalRing.maximalIdeal (Y.presheaf.stalk (q z)) := (hLE.2.2.1 (q z) hzU).mp hzi
  have hτnu : ¬ IsUnit ((q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)) := by
    intro hu
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hgm))
      ((isUnit_map_iff (q.stalkMap z).hom _).mp hu)
  rw [← hτ]
  refine ⟨?_, hA1⟩
  have hI : Ideal.span {(q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact hτnu
  have hJI : Ideal.map (q.stalkMap z).hom (Ideal.span {(Y.presheaf.germ U (q z) hzU).hom t}) =
      Ideal.span {(q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)} := by
    rw [Ideal.map_span, Set.image_singleton]

  haveI := hsh.1
  haveI hH := hA2 _ _ hI
  haveI : IsSepClosed (IsLocalRing.ResidueField (T.presheaf.stalk z)) := hsh.2
  have hsep := hA3 _ (Ideal.span {(q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)})

  obtain ⟨f₁, hf₁⟩ := hA4 _ _ (q.stalkMap z) hφ
    (Ideal.span {(Y.presheaf.germ U (q z) hzU).hom t})
  obtain ⟨f₂, hf₂⟩ := hA5 (q z) hzU hzi
  let e₀ := Ideal.quotEquivOfEq hJI
  haveI := hf₁
  haveI := hf₂
  have hk₀ : WeaklyEtale (Spec.map e₀.toCommRingCatIso.hom ≫ f₁ ≫ f₂) := inferInstance

  haveI hH' : HenselianLocalRing (CommRingCat.of (T.presheaf.stalk z ⧸
      Ideal.span {(q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)})) := hH
  haveI : IsSepClosed (IsLocalRing.ResidueField (CommRingCat.of (T.presheaf.stalk z ⧸
      Ideal.span {(q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)}))) := hsep
  have hdom := wc_strictHensel_weaklyEtale_smooth_isDomain k (i ≫ pY) d
    (CommRingCat.of (T.presheaf.stalk z ⧸
      Ideal.span {(q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)})) _ hk₀
  have hdom' : IsDomain (T.presheaf.stalk z ⧸
      Ideal.span {(q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t)}) := hdom
  have hprime := (Ideal.Quotient.isDomain_iff_prime _).mp hdom'
  have hτ0 : (q.stalkMap z).hom ((Y.presheaf.germ U (q z) hzU).hom t) ≠ 0 := by
    intro h0
    have h1 := hA1 1 (by rw [h0, zero_mul])
    exact one_ne_zero h1
  exact (Ideal.span_singleton_prime hτ0).mp hprime

theorem wc_sddcld_unit_factor {P T : Scheme.{u}} (j : P ⟶ T) [IsOpenImmersion j]
    (z : T) (N0 : T.Opens) (hz : z ∈ N0) (τ : Γ(T, N0))
    (hG : ∀ (x : T) (hx : x ∈ N0), x ∈ Set.range j ↔ IsUnit ((T.presheaf.germ N0 x hx).hom τ))
    (hprime : Prime ((T.presheaf.germ N0 z hz).hom τ))
    (hreg : ∀ a : T.presheaf.stalk z, (T.presheaf.germ N0 z hz).hom τ * a = 0 → a = 0)
    (u : (Γ(P, ⊤))ˣ) :
    ∃ (N : T.Opens) (_ : z ∈ N) (hN : N ≤ N0) (c : ℤ) (w : (Γ(T, N))ˣ)
      (hτ : IsUnit ((j.appLE N0 (j ⁻¹ᵁ N) (j.preimage_mono hN)).hom τ)),
      (P.presheaf.map (homOfLE le_top).op).hom (u : Γ(P, ⊤)) =
        (j.app N).hom (w : Γ(T, N)) * ((hτ.unit ^ c : (Γ(P, j ⁻¹ᵁ N))ˣ) : Γ(P, j ⁻¹ᵁ N)) :=
by

  have hF : ∀ (X : Scheme.{u}) {U V W : X.Opens} (i : V ⟶ U) (k : W ⟶ V) (l : W ⟶ U)
      (x : Γ(X, U)),
      (X.presheaf.map k.op).hom ((X.presheaf.map i.op).hom x) = (X.presheaf.map l.op).hom x := by
    intro X U V W i k l x
    have hl : l.op = i.op ≫ k.op := rfl
    rw [hl, Functor.map_comp]
    rfl
  have hF3 : ∀ (X : Scheme.{u}) {U V W Y : X.Opens} (i : V ⟶ U) (k : W ⟶ V) (k' : Y ⟶ W)
      (l : Y ⟶ U) (x : Γ(X, U)),
      (X.presheaf.map k'.op).hom ((X.presheaf.map k.op).hom ((X.presheaf.map i.op).hom x)) =
        (X.presheaf.map l.op).hom x := by
    intro X U V W Y i k k' l x
    rw [hF X i k (k ≫ i) x, hF X (k ≫ i) k' l x]

  have s1 : ∀ {B : Type u} [CommRing B] (π : B), Prime π → (∀ x : B, π * x = 0 → x = 0) →
      ∀ (M : ℕ) (a b : B), a * b = π ^ M → ∃ (ε : Bˣ) (e : ℕ), a = (ε : B) * π ^ e := by
    intro B _ π hπ hr M
    have hC : ∀ x y : B, π * x = π * y → x = y := by
      intro x y h
      have := hr (x - y) (by rw [mul_sub, h, sub_self])
      exact sub_eq_zero.mp this
    induction M with
    | zero =>
      intro a b hab
      rw [pow_zero] at hab
      exact ⟨⟨a, b, hab, by rw [mul_comm]; exact hab⟩, 0, by simp⟩
    | succ M ih =>
      intro a b hab
      rw [pow_succ'] at hab
      rcases hπ.dvd_or_dvd ⟨π ^ M, hab⟩ with ⟨a', rfl⟩ | ⟨b', rfl⟩
      · obtain ⟨ε, e, he⟩ := ih a' b (hC _ _ (by rw [← hab]; ring))
        exact ⟨ε, e + 1, by rw [he]; ring⟩
      · obtain ⟨ε, e, he⟩ := ih a b' (hC _ _ (by rw [← hab]; ring))
        exact ⟨ε, e, he⟩

  have s4 : ∀ (N : T.Opens) (hN : N ≤ N0),
      IsUnit ((j.appLE N0 (j ⁻¹ᵁ N) (j.preimage_mono hN)).hom τ) := by
    intro N hN
    apply RingedSpace.isUnit_of_isUnit_germ P.toRingedSpace
    intro p hp
    have hjp : j p ∈ N0 := hN (show j p ∈ N from hp)
    have e1 : (j.appLE N0 (j ⁻¹ᵁ N) (j.preimage_mono hN)) =
        j.app N0 ≫ P.presheaf.map (homOfLE (j.preimage_mono hN)).op := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    have key : (P.presheaf.germ (j ⁻¹ᵁ N) p hp).hom
        ((j.appLE N0 (j ⁻¹ᵁ N) (j.preimage_mono hN)).hom τ) =
        (j.stalkMap p).hom ((T.presheaf.germ N0 (j p) hjp).hom τ) := by
      rw [e1, Scheme.Hom.germ_stalkMap_apply]
      exact TopCat.Presheaf.germ_res_apply P.presheaf _ p hp _
    have hu := ((hG (j p) hjp).mp ⟨p, rfl⟩).map (j.stalkMap p).hom
    rw [← key] at hu
    exact hu

  have s3 : ∀ (W : T.Opens) (z : T) (hz : z ∈ W) (a t : Γ(T, W)) (e : ℕ)
      (ε : (T.presheaf.stalk z)ˣ),
      (T.presheaf.germ W z hz).hom a =
        (ε : T.presheaf.stalk z) * ((T.presheaf.germ W z hz).hom t) ^ e →
      ∃ (N : T.Opens) (_ : z ∈ N) (hNW : N ≤ W) (w : (Γ(T, N))ˣ),
        (T.presheaf.map (homOfLE hNW).op).hom a =
          (w : Γ(T, N)) * ((T.presheaf.map (homOfLE hNW).op).hom t) ^ e := by
    intro W z hz a t e ε h
    obtain ⟨W1, hz1, s1, hs1⟩ := T.presheaf.exists_germ_eq (ε : T.presheaf.stalk z)
    obtain ⟨W2, hz2, s2, hs2⟩ :=
      T.presheaf.exists_germ_eq ((ε⁻¹ : (T.presheaf.stalk z)ˣ) : T.presheaf.stalk z)
    obtain ⟨N', hzN', l1, l2, l3⟩ : ∃ N' : T.Opens, z ∈ N' ∧ N' ≤ W1 ∧ N' ≤ W2 ∧ N' ≤ W :=
      ⟨(W1 ⊓ W2) ⊓ W, ⟨⟨hz1, hz2⟩, hz⟩, fun x hx => hx.1.1, fun x hx => hx.1.2,
        fun x hx => hx.2⟩
    have g1 : (T.presheaf.germ N' z hzN').hom ((T.presheaf.map (homOfLE l1).op).hom s1 *
        (T.presheaf.map (homOfLE l2).op).hom s2) = (T.presheaf.germ N' z hzN').hom 1 := by
      rw [map_mul, map_one, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
        hs1, hs2, Units.mul_inv]
    obtain ⟨N1, hzN1, i1, i1', h1⟩ := T.presheaf.germ_eq z hzN' hzN' _ _ g1
    have g2 : (T.presheaf.germ W z hz).hom a = (T.presheaf.germ N' z hzN').hom
        ((T.presheaf.map (homOfLE l1).op).hom s1 *
          ((T.presheaf.map (homOfLE l3).op).hom t) ^ e) := by
      rw [map_mul, map_pow, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
        hs1, h]
    obtain ⟨N2, hzN2, i2, i2', h2⟩ := T.presheaf.germ_eq z hz hzN' _ _ g2
    have m1 : N1 ≤ N' := leOfHom i1
    have m2 : N2 ≤ W := leOfHom i2
    obtain ⟨N, hzN, n1, n2⟩ : ∃ N : T.Opens, z ∈ N ∧ N ≤ N1 ∧ N ≤ N2 :=
      ⟨N1 ⊓ N2, ⟨hzN1, hzN2⟩, fun x hx => hx.1, fun x hx => hx.2⟩
    have hNW : N ≤ W := n2.trans m2
    have hNN' : N ≤ N' := n1.trans m1
    have hw : (T.presheaf.map (homOfLE n1).op).hom ((T.presheaf.map i1.op).hom
          ((T.presheaf.map (homOfLE l1).op).hom s1)) *
        (T.presheaf.map (homOfLE n1).op).hom ((T.presheaf.map i1.op).hom
          ((T.presheaf.map (homOfLE l2).op).hom s2)) = 1 := by
      have := congrArg (T.presheaf.map (homOfLE n1).op).hom h1
      rw [map_mul, map_mul, map_one, map_one] at this
      exact this
    refine ⟨N, hzN, hNW, ⟨_, _, hw, by rw [mul_comm]; exact hw⟩, ?_⟩
    have := congrArg (T.presheaf.map (homOfLE n2).op).hom h2
    simp only [map_mul, map_pow] at this
    rw [hF T i2 (homOfLE n2) (homOfLE hNW),
      hF3 T (homOfLE l3) i2' (homOfLE n2) (homOfLE hNW),
      hF3 T (homOfLE l1) i2' (homOfLE n2) (homOfLE (hNN'.trans l1))] at this
    rw [this]
    show _ = (T.presheaf.map (homOfLE n1).op).hom ((T.presheaf.map i1.op).hom
          ((T.presheaf.map (homOfLE l1).op).hom s1)) * _
    rw [hF3 T (homOfLE l1) i1 (homOfLE n1) (homOfLE (hNN'.trans l1))]

  have s2 : ∀ (W : T.Opens) (hW : IsAffineOpen W) (hWN : W ≤ N0) (y : (Γ(P, j ⁻¹ᵁ W))ˣ),
      ∃ (n M k : ℕ) (a b : Γ(T, W)),
        (y : Γ(P, j ⁻¹ᵁ W)) * ((j.app W).hom ((T.presheaf.map (homOfLE hWN).op).hom τ)) ^ n =
          (j.app W).hom a ∧
        ((T.presheaf.map (homOfLE hWN).op).hom τ) ^ k * (a * b) =
          ((T.presheaf.map (homOfLE hWN).op).hom τ) ^ k *
            ((T.presheaf.map (homOfLE hWN).op).hom τ) ^ M := by
    intro W hW hWN y
    have hVeq : ∀ x, x ∈ T.basicOpen ((T.presheaf.map (homOfLE hWN).op).hom τ) ↔
        x ∈ W ∧ x ∈ Set.range j := by
      intro x
      rw [Scheme.basicOpen_res, TopologicalSpace.Opens.mem_inf]
      constructor
      · rintro ⟨hxW, hxτ⟩
        exact ⟨hxW, (hG x (hWN hxW)).mpr ((T.mem_basicOpen τ x (hWN hxW)).mp hxτ)⟩
      · rintro ⟨hxW, hxj⟩
        exact ⟨hxW, (T.mem_basicOpen τ x (hWN hxW)).mpr ((hG x (hWN hxW)).mp hxj)⟩
    obtain ⟨t, ht⟩ : ∃ t, t = (T.presheaf.map (homOfLE hWN).op).hom τ := ⟨_, rfl⟩
    rw [← ht] at hVeq ⊢
    have hVle : T.basicOpen t ≤ j.opensRange := by
      intro x hx
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ((hVeq x).mp hx).2
    have : IsIso (j.app (T.basicOpen t)) := Scheme.Hom.isIso_app j _ hVle
    have hVW : T.basicOpen t ≤ W := T.basicOpen_le t
    have hpre2 : j ⁻¹ᵁ (T.basicOpen t) ≤ j ⁻¹ᵁ W := j.preimage_mono hVW
    have hpre1 : j ⁻¹ᵁ W ≤ j ⁻¹ᵁ (T.basicOpen t) := by
      intro p hp
      exact (hVeq (j p)).mpr ⟨hp, p, rfl⟩
    have hσσ : ∀ x, (P.presheaf.map (homOfLE hpre1).op).hom
        ((P.presheaf.map (homOfLE hpre2).op).hom x) = x := by
      intro x
      rw [hF P (homOfLE hpre2) (homOfLE hpre1) (𝟙 (j ⁻¹ᵁ W)) x, op_id,
        CategoryTheory.Functor.map_id]
      rfl
    have hΘ : ∀ x, (j.app (T.basicOpen t)).hom ((inv (j.app (T.basicOpen t))).hom x) = x := by
      intro x
      show (inv (j.app (T.basicOpen t)) ≫ j.app (T.basicOpen t)).hom x = x
      rw [IsIso.inv_hom_id]
      rfl
    have hnat : ∀ x, (P.presheaf.map (homOfLE hpre2).op).hom ((j.app W).hom x) =
        (j.app (T.basicOpen t)).hom ((T.presheaf.map (homOfLE hVW).op).hom x) := by
      intro x
      show (j.app W ≫ P.presheaf.map (homOfLE hpre2).op).hom x =
        (T.presheaf.map (homOfLE hVW).op ≫ j.app (T.basicOpen t)).hom x
      rw [Scheme.Hom.naturality]
      rfl
    have hloc : IsLocalization.Away t Γ(T, T.basicOpen t) := hW.isLocalization_basicOpen t
    have hr : ∀ x, algebraMap Γ(T, W) Γ(T, T.basicOpen t) x =
        (T.presheaf.map (homOfLE hVW).op).hom x := fun x => rfl
    have hyy : (inv (j.app (T.basicOpen t))).hom ((P.presheaf.map (homOfLE hpre2).op).hom
          (y : Γ(P, j ⁻¹ᵁ W))) *
        (inv (j.app (T.basicOpen t))).hom ((P.presheaf.map (homOfLE hpre2).op).hom
          ((y⁻¹ : (Γ(P, j ⁻¹ᵁ W))ˣ) : Γ(P, j ⁻¹ᵁ W))) = 1 := by
      rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
    obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj t ((inv (j.app (T.basicOpen t))).hom
      ((P.presheaf.map (homOfLE hpre2).op).hom (y : Γ(P, j ⁻¹ᵁ W))))
    obtain ⟨m, b, hmb⟩ := IsLocalization.Away.surj t ((inv (j.app (T.basicOpen t))).hom
      ((P.presheaf.map (homOfLE hpre2).op).hom ((y⁻¹ : (Γ(P, j ⁻¹ᵁ W))ˣ) : Γ(P, j ⁻¹ᵁ W))))
    have hab : algebraMap Γ(T, W) Γ(T, T.basicOpen t) (a * b) =
        algebraMap Γ(T, W) Γ(T, T.basicOpen t) (t ^ (n + m)) := by
      rw [map_mul, ← hna, ← hmb, map_pow, pow_add]
      linear_combination ((algebraMap Γ(T, W) Γ(T, T.basicOpen t) t) ^ n *
        (algebraMap Γ(T, W) Γ(T, T.basicOpen t) t) ^ m) * hyy
    obtain ⟨k, hk⟩ := IsLocalization.Away.exists_of_eq t hab
    refine ⟨n, n + m, k, a, b, ?_, hk⟩
    have h1 : (P.presheaf.map (homOfLE hpre2).op).hom
        ((y : Γ(P, j ⁻¹ᵁ W)) * ((j.app W).hom t) ^ n) =
        (P.presheaf.map (homOfLE hpre2).op).hom ((j.app W).hom a) := by
      rw [map_mul, map_pow, hnat, hnat, ← hΘ ((P.presheaf.map (homOfLE hpre2).op).hom
        (y : Γ(P, j ⁻¹ᵁ W))), ← map_pow, ← map_mul, ← hr, ← hr, hna]
    have := congrArg (P.presheaf.map (homOfLE hpre1).op).hom h1
    rwa [hσσ, hσσ] at this

  have alg : ∀ {R : Type u} [CommRing R] (U : Rˣ) (X A : R) (e n : ℕ),
      X * (U : R) ^ n = A * (U : R) ^ e → X = A * ((U ^ ((e : ℤ) - n) : Rˣ) : R) := by
    intro R _ U X A e n h
    rw [zpow_sub, zpow_natCast, zpow_natCast, Units.val_mul, Units.val_pow_eq_pow_val,
      ← mul_assoc, ← h, mul_assoc, ← Units.val_pow_eq_pow_val, Units.mul_inv, mul_one]

  obtain ⟨W, hW, hzW, hWsub⟩ := exists_isAffineOpen_mem_and_subset hz
  have hWN : W ≤ N0 := hWsub
  obtain ⟨n, M, k, a, b, E1, E2⟩ := s2 W hW hWN
    (Units.map (P.presheaf.map (homOfLE le_top).op).hom.toMonoidHom u)
  have hgt : (T.presheaf.germ W z hzW).hom ((T.presheaf.map (homOfLE hWN).op).hom τ) =
      (T.presheaf.germ N0 z hz).hom τ :=
    TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE hWN) z hzW τ
  have hC : ∀ x y : T.presheaf.stalk z, (T.presheaf.germ N0 z hz).hom τ * x =
      (T.presheaf.germ N0 z hz).hom τ * y → x = y := by
    intro x y h
    have := hreg (x - y) (by rw [mul_sub, h, sub_self])
    exact sub_eq_zero.mp this
  have hcancel : ∀ k : ℕ, ∀ x y : T.presheaf.stalk z, ((T.presheaf.germ N0 z hz).hom τ) ^ k * x =
      ((T.presheaf.germ N0 z hz).hom τ) ^ k * y → x = y := by
    intro k
    induction k with
    | zero => intro x y h; simpa using h
    | succ k ih =>
      intro x y h
      apply ih
      apply hC
      rw [pow_succ] at h
      linear_combination h
  have E2' := congrArg (T.presheaf.germ W z hzW).hom E2
  simp only [map_mul, map_pow, hgt] at E2'
  obtain ⟨ε, e, he⟩ := s1 _ hprime hreg M _ _ (hcancel k _ _ E2')
  obtain ⟨N, hzN, hNW, w, E3⟩ := s3 W z hzW a ((T.presheaf.map (homOfLE hWN).op).hom τ) e ε
    (by rw [he, hgt])
  have hN : N ≤ N0 := hNW.trans hWN
  have hτ := s4 N hN
  refine ⟨N, hzN, hN, (e : ℤ) - n, w, hτ, ?_⟩
  have I2 : ∀ x : Γ(T, W), (P.presheaf.map (homOfLE (j.preimage_mono hNW)).op).hom
      ((j.app W).hom x) = (j.app N).hom ((T.presheaf.map (homOfLE hNW).op).hom x) := by
    intro x
    show (j.app W ≫ P.presheaf.map (homOfLE (j.preimage_mono hNW)).op).hom x =
      (T.presheaf.map (homOfLE hNW).op ≫ j.app N).hom x
    rw [Scheme.Hom.naturality]
    rfl
  have I3 : (j.app N).hom ((T.presheaf.map (homOfLE hNW).op).hom
      ((T.presheaf.map (homOfLE hWN).op).hom τ)) =
      (j.appLE N0 (j ⁻¹ᵁ N) (j.preimage_mono hN)).hom τ := by
    rw [hF T (homOfLE hWN) (homOfLE hNW) (homOfLE hN)]
    show (T.presheaf.map (homOfLE hN).op ≫ j.app N).hom τ = _
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.map_appLE]
  have I1 : (P.presheaf.map (homOfLE (j.preimage_mono hNW)).op).hom
      ((P.presheaf.map (homOfLE (le_top : j ⁻¹ᵁ W ≤ ⊤)).op).hom (u : Γ(P, ⊤))) =
      (P.presheaf.map (homOfLE (le_top : j ⁻¹ᵁ N ≤ ⊤)).op).hom (u : Γ(P, ⊤)) :=
    hF P _ _ _ _
  have hE := congrArg (P.presheaf.map (homOfLE (j.preimage_mono hNW)).op).hom E1
  rw [map_mul, map_pow, I2, I2, I3, E3, map_mul, map_pow, I3] at hE
  have hy : ((Units.map (P.presheaf.map (homOfLE le_top).op).hom.toMonoidHom u :
      (Γ(P, j ⁻¹ᵁ W))ˣ) : Γ(P, j ⁻¹ᵁ W)) =
      (P.presheaf.map (homOfLE (le_top : j ⁻¹ᵁ W ≤ ⊤)).op).hom (u : Γ(P, ⊤)) := rfl
  rw [hy, I1, ← hτ.unit_spec] at hE
  exact alg hτ.unit _ _ e n hE

theorem wc_sddcld_transport {Y : Scheme.{u}} (O : Y.Opens) (W : Y.ProEt) (N : W.left.Opens)
    (U : Y.Opens) (t : Γ(Y, U)) (g : wcSddcOpenSub W N ⟶ wcSddcYU Y U)
    (hN : N ≤ W.hom ⁻¹ᵁ U)
    (hσ : IsUnit ((Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t)))
    (u : (wcSddcMPre Y O).obj (Opposite.op W)) (c : ℤ) (w : (Γ(W.left, N))ˣ)
    (hτ : IsUnit (((Limits.pullback.fst W.hom O.ι).appLE (W.hom ⁻¹ᵁ U)
       ((Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N)
       ((Limits.pullback.fst W.hom O.ι).preimage_mono hN)).hom ((W.hom.app U).hom t)))
    (heq : ((Limits.pullback W.hom O.ι).presheaf.map (homOfLE le_top).op).hom
        ((Additive.toMul u.down : (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) : Γ(Limits.pullback W.hom O.ι, ⊤)) =
      ((Limits.pullback.fst W.hom O.ι).app N).hom (w : Γ(W.left, N)) *
        ((hτ.unit ^ c : (Γ(Limits.pullback W.hom O.ι, (Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N))ˣ) :
          Γ(Limits.pullback W.hom O.ι, (Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N))) :
    (wcSddcMPre Y O).map (wcSddcOpenSubIncl W N).op u =
      (wcSddcIota Y O).app (Opposite.op (wcSddcOpenSub W N))
          (ULift.up (Additive.ofMul (Units.map (N.topIso.inv.hom : Γ(W.left, N) →+* Γ(↑N, ⊤)).toMonoidHom w))) +
        c • (wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t) :=
by
  classical

  have C1 : ∀ {A B : Scheme.{u}} (k : A ⟶ B) (V : B.Opens) (e : ⊤ ≤ k ⁻¹ᵁ V) (x : Γ(B, ⊤)),
      (k.appLE V ⊤ e).hom ((B.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom x) =
        k.appTop.hom x := by
    intro A B k V e x
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE, Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl

  have C2 : ∀ {X A : Scheme.{u}} (V : X.Opens) (f : A ⟶ X) (a : A ⟶ (V : Scheme.{u}))
      (_ : f = a ≫ V.ι) (e : ⊤ ≤ f ⁻¹ᵁ V) (x : Γ(X, V)),
      (f.appLE V ⊤ e).hom x = a.appTop.hom (V.topIso.inv.hom x) := by
    intro X A V f a hf e x
    subst hf
    rw [← Scheme.Hom.appLE_comp_appLE a V.ι V ⊤ ⊤ (Scheme.Opens.ι_preimage_self V).ge le_top,
      CommRingCat.comp_apply, Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv, Scheme.Hom.appTop,
      Scheme.Hom.app_eq_appLE]
    rfl

  have C3 : ∀ {S : Type u} [CommRing S] (a b d : Sˣ),
      a = b * d ^ c →
      (ULift.up (Additive.ofMul a) : ULift.{u+1} (Additive Sˣ)) =
        ULift.up (Additive.ofMul b) + c • ULift.up (Additive.ofMul d) := by
    intro S _ a b d hab
    apply ULift.ext
    show Additive.ofMul a = Additive.ofMul b + c • Additive.ofMul d
    rw [hab, ofMul_mul, ofMul_zpow]

  obtain ⟨k, hk⟩ : ∃ k : Limits.pullback (N.ι ≫ W.hom) O.ι ⟶ Limits.pullback W.hom O.ι,
      k = ((wcProEtBaseChange O.ι).map (wcSddcOpenSubIncl W N)).left := ⟨_, rfl⟩
  obtain ⟨kg, hkg⟩ : ∃ kg : Limits.pullback (N.ι ≫ W.hom) O.ι ⟶ Limits.pullback (U.ι ≫ 𝟙 Y) O.ι,
      kg = ((wcProEtBaseChange O.ι).map g).left := ⟨_, rfl⟩
  have H1 : k ≫ Limits.pullback.fst W.hom O.ι = Limits.pullback.fst (N.ι ≫ W.hom) O.ι ≫ N.ι := by
    subst hk
    first
      | exact Limits.pullback.lift_fst _ _ _
      | exact (wcSddcFst Y O).naturality (wcSddcOpenSubIncl W N)
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have H2 : kg ≫ Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι =
      Limits.pullback.fst (N.ι ≫ W.hom) O.ι ≫ g.left := by
    subst hkg
    first
      | exact Limits.pullback.lift_fst _ _ _
      | exact (wcSddcFst Y O).naturality g
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have H3' : g.left ≫ U.ι ≫ 𝟙 Y = N.ι ≫ W.hom := MorphismProperty.Over.w g
  have H3 : g.left ≫ U.ι = N.ι ≫ W.hom :=
    (congrArg (fun x => g.left ≫ x) (Category.comp_id U.ι)).symm.trans H3'
  have hfac : (k ≫ Limits.pullback.fst W.hom O.ι) ≫ W.hom =
      (kg ≫ Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι) ≫ U.ι :=
    calc (k ≫ Limits.pullback.fst W.hom O.ι) ≫ W.hom
        = (Limits.pullback.fst (N.ι ≫ W.hom) O.ι ≫ N.ι) ≫ W.hom :=
          congrArg (fun x => x ≫ W.hom) H1
      _ = Limits.pullback.fst (N.ι ≫ W.hom) O.ι ≫ (N.ι ≫ W.hom) := Category.assoc _ _ _
      _ = Limits.pullback.fst (N.ι ≫ W.hom) O.ι ≫ (g.left ≫ U.ι) :=
          congrArg (fun x => Limits.pullback.fst (N.ι ≫ W.hom) O.ι ≫ x) H3.symm
      _ = (Limits.pullback.fst (N.ι ≫ W.hom) O.ι ≫ g.left) ≫ U.ι := (Category.assoc _ _ _).symm
      _ = (kg ≫ Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι) ≫ U.ι :=
          congrArg (fun x => x ≫ U.ι) H2.symm
  have e : (⊤ : (Limits.pullback (N.ι ≫ W.hom) O.ι).Opens) ≤
      k ⁻¹ᵁ ((Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N) := by
    first
      | (rw [← Scheme.Hom.comp_preimage, H1, Scheme.Hom.comp_preimage,
          Scheme.Opens.ι_preimage_self]; exact le_of_eq (Scheme.Hom.preimage_top _).symm)
      | (intro a _
         show (Limits.pullback.fst W.hom O.ι) (k a) ∈ N
         rw [← Scheme.Hom.comp_apply, H1, Scheme.Hom.comp_apply]
         exact (Limits.pullback.fst (N.ι ≫ W.hom) O.ι a).2)

  have hYid : (k.appLE _ ⊤ e).hom (((Limits.pullback.fst W.hom O.ι).app N).hom (w : Γ(W.left, N))) =
      (Limits.pullback.fst (N.ι ≫ W.hom) O.ι).appTop.hom (N.topIso.inv.hom (w : Γ(W.left, N))) := by
    rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
    exact C2 N _ _ H1 _ _

  have hZid : (k.appLE _ ⊤ e).hom (((Limits.pullback.fst W.hom O.ι).appLE (W.hom ⁻¹ᵁ U)
       ((Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N)
       ((Limits.pullback.fst W.hom O.ι).preimage_mono hN)).hom ((W.hom.app U).hom t)) =
      (kg ≫ Limits.pullback.fst (U.ι ≫ 𝟙 Y) O.ι).appTop.hom (U.topIso.inv.hom t) := by
    rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
    exact C2 U _ _ hfac _ _
  rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply] at hZid

  have hsig : wcSddcSigma Y O U t =
      (ULift.up (Additive.ofMul hσ.unit) : (wcSddcMPre Y O).obj (Opposite.op (wcSddcYU Y U))) := by
    unfold wcSddcSigma wcSddcUnitOr
    split
    · rfl
    · rename_i hn
      exact absurd hσ hn
  have hX : (wcSddcMPre Y O).map (wcSddcOpenSubIncl W N).op u =
      ULift.up (Additive.ofMul (Units.map k.appTop.hom.toMonoidHom
        (Additive.toMul u.down : (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ))) := by
    subst hk; rfl
  have hY : (wcSddcIota Y O).app (Opposite.op (wcSddcOpenSub W N))
          (ULift.up (Additive.ofMul (Units.map (N.topIso.inv.hom : Γ(W.left, N) →+* Γ(↑N, ⊤)).toMonoidHom w))) =
      ULift.up (Additive.ofMul (Units.map
        (Limits.pullback.fst (N.ι ≫ W.hom) O.ι).appTop.hom.toMonoidHom
        (Units.map (N.topIso.inv.hom : Γ(W.left, N) →+* Γ(↑N, ⊤)).toMonoidHom w))) := rfl
  have hZ : (wcSddcMPre Y O).map g.op (wcSddcSigma Y O U t) =
      ULift.up (Additive.ofMul (Units.map kg.appTop.hom.toMonoidHom hσ.unit)) := by
    rw [hsig]; subst hkg; rfl
  have hunit : Units.map kg.appTop.hom.toMonoidHom hσ.unit =
      Units.map (k.appLE _ ⊤ e).hom.toMonoidHom hτ.unit := by
    apply Units.ext
    show kg.appTop.hom (hσ.unit : Γ(Limits.pullback (U.ι ≫ 𝟙 Y) O.ι, ⊤)) =
      (k.appLE _ ⊤ e).hom
        (hτ.unit : Γ(Limits.pullback W.hom O.ι, (Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N))
    rw [IsUnit.unit_spec, IsUnit.unit_spec, hZid]
  have key : (ULift.up (Additive.ofMul (Units.map k.appTop.hom.toMonoidHom
        (Additive.toMul u.down : (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ))) :
        ULift.{u+1} (Additive (Γ(Limits.pullback (N.ι ≫ W.hom) O.ι, ⊤))ˣ)) =
      ULift.up (Additive.ofMul (Units.map
        (Limits.pullback.fst (N.ι ≫ W.hom) O.ι).appTop.hom.toMonoidHom
        (Units.map (N.topIso.inv.hom : Γ(W.left, N) →+* Γ(↑N, ⊤)).toMonoidHom w))) +
        c • ULift.up (Additive.ofMul (Units.map kg.appTop.hom.toMonoidHom hσ.unit)) := by
    apply C3
    rw [hunit, ← map_zpow (Units.map (k.appLE _ ⊤ e).hom.toMonoidHom)]
    apply Units.ext
    show k.appTop.hom ((Additive.toMul u.down : (Γ(Limits.pullback W.hom O.ι, ⊤))ˣ) :
        Γ(Limits.pullback W.hom O.ι, ⊤)) =
      (Limits.pullback.fst (N.ι ≫ W.hom) O.ι).appTop.hom (N.topIso.inv.hom (w : Γ(W.left, N))) *
        (k.appLE _ ⊤ e).hom
          ((hτ.unit ^ c : (Γ(Limits.pullback W.hom O.ι, (Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N))ˣ) :
            Γ(Limits.pullback W.hom O.ι, (Limits.pullback.fst W.hom O.ι) ⁻¹ᵁ N))
    rw [← C1 k _ e, heq, map_mul, hYid]
  first
    | (rw [hX, hY, hZ]; exact key)
    | exact hX.trans (key.trans (congrArg₂ (fun a b => a + c • b) hY hZ).symm)

theorem wc_sddc_chart_local_desc (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology Y)
      ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
    (hM : Presheaf.IsSheaf (Scheme.ProEt.topology Y) (wcSddcMPre Y O))
    (D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (p : (⟨_, hM⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ⟶ D)
    (w : (ObjectProperty.homMk (wcSddcIota Y O) :
      (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ⟶ ⟨_, hM⟩) ≫ p = 0)
    (hSES : (ShortComplex.mk _ p w).ShortExact)
    (V : Y.ProEt) (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (s : D.obj.obj (Opposite.op V)) (x : V.left) :
    wcSddcLocDesc i O p.hom V s x :=
by
  classical
  haveI : Epi p := hSES.epi_g
  haveI := wc_proet_free_projective_wcontractible Y V ⟨h1, h2, h3, h4, h5⟩

  obtain ⟨η, hη, -⟩ := wc_proet_free_sheaf_yoneda Y
  obtain ⟨sh, hsh, -⟩ := hη V D s
  have hf : Projective.factorThru sh p ≫ p = sh := Projective.factorThru_comp sh p
  let u : (wcSddcMPre Y O).obj (Opposite.op V) :=
    ((Projective.factorThru sh p).hom.app (Opposite.op V)).hom (η V)
  have hu : p.hom.app (Opposite.op V) u = s := by
    rw [← hsh, ← hf]
    rfl

  have P1 : ∀ {W W' : Y.ProEt} (f : W' ⟶ W) (m : (wcSddcMPre Y O).obj (Opposite.op W)),
      D.obj.map f.op (p.hom.app (Opposite.op W) m) =
        p.hom.app (Opposite.op W') ((wcSddcMPre Y O).map f.op m) :=
    fun f m => (NatTrans.naturality_apply p.hom f.op m).symm
  have P2 : ∀ (W : Y.ProEt) v,
      p.hom.app (Opposite.op W) ((wcSddcIota Y O).app (Opposite.op W) v) = 0 := by
    intro W v
    have e := congrArg (fun φ => (φ.hom.app (Opposite.op W)) v) w
    exact e
  by_cases hx : V.hom x ∈ Set.range i
  ·
    obtain ⟨z, ⟨hzc, hxz⟩, -⟩ := h3 x
    have hzi : V.hom z ∈ Set.range i :=
      (hxz.map V.hom.continuous).mem_closed i.isClosedEmbedding.isClosed_range hx
    obtain ⟨z₀, hz₀⟩ := hzi
    obtain ⟨U, t, hzU, hLE⟩ := wc_sddcld_local_equation k pY d i z₀
    rw [hz₀] at hzU
    have hG' : ∀ (x' : V.left) (hx' : x' ∈ V.hom ⁻¹ᵁ U),
        x' ∈ Set.range (Limits.pullback.fst V.hom O.ι) ↔
          IsUnit ((V.left.presheaf.germ (V.hom ⁻¹ᵁ U) x' hx').hom ((V.hom.app U).hom t)) := by
      intro x' hx'
      rw [show (V.left.presheaf.germ (V.hom ⁻¹ᵁ U) x' hx').hom ((V.hom.app U).hom t) =
          (V.hom.stalkMap x').hom ((Y.presheaf.germ U (V.hom x') hx').hom t) from
          (Scheme.Hom.germ_stalkMap_apply V.hom U x' hx' t).symm]
      rw [isUnit_map_iff, Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
      have e2 := hLE.2.2.1 (V.hom x') hx'
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at e2
      rw [Set.mem_preimage, hO, Set.mem_compl_iff, e2, not_not]
    obtain ⟨hprime, hreg⟩ := wc_sddcld_equation_prime k pY d i V.hom V.prop U t hLE z hzU
      ⟨z₀, hz₀⟩ (h5 z hzc)
    obtain ⟨N, hzN, hN, c, w₀, hτ, heq⟩ := wc_sddcld_unit_factor (Limits.pullback.fst V.hom O.ι)
      z (V.hom ⁻¹ᵁ U) hzU ((V.hom.app U).hom t) hG' hprime hreg
      (Additive.toMul u.down : (Γ(Limits.pullback V.hom O.ι, ⊤))ˣ)
    have hxN : x ∈ N := hxz.mem_open N.isOpen hzN
    have H' : Set.range (N.ι ≫ V.hom) ⊆ Set.range (U.ι ≫ 𝟙 Y) := by
      rw [Category.comp_id, Scheme.Opens.range_ι]
      rintro _ ⟨a, rfl⟩
      have ha : N.ι a ∈ N := by
        have : N.ι a ∈ Set.range N.ι := ⟨a, rfl⟩
        rwa [Scheme.Opens.range_ι] at this
      rw [Scheme.Hom.comp_apply]
      exact hN ha
    have H'' : Set.range (N.ι ≫ V.hom) ⊆ Set.range U.ι := by
      simpa only [Category.comp_id] using H'
    have hYU : (wcSddcYU Y U).hom = U.ι := by
      first
      | exact Category.comp_id U.ι
      | (show U.ι ≫ 𝟙 Y = U.ι; exact Category.comp_id _)
      | simp [wcSddcYU, wcSddcOpenSub]
    let gl : (N : Scheme.{u}) ⟶ (U : Scheme.{u}) := IsOpenImmersion.lift U.ι (N.ι ≫ V.hom) H''
    have hgl : gl ≫ U.ι = N.ι ≫ V.hom := IsOpenImmersion.lift_fac U.ι (N.ι ≫ V.hom) H''
    let g : wcSddcOpenSub V N ⟶ wcSddcYU Y U :=
      MorphismProperty.Over.homMk gl (by rw [hYU]; exact hgl) trivial
    have hσ := wc_sddcld_sigma_isUnit i O hO U t hLE
    have htr := wc_sddcld_transport O V N U t g hN hσ u c w₀ hτ heq
    refine ⟨N, hxN, Or.inr ⟨U, t, c, g, hLE, ?_⟩⟩
    rw [← hu, P1 (wcSddcOpenSubIncl V N) u, htr, map_add, map_zsmul]
    have e0 := P2 (wcSddcOpenSub V N)
      (ULift.up (Additive.ofMul (Units.map (N.topIso.inv.hom : Γ(V.left, N) →+* Γ(↑N, ⊤)).toMonoidHom w₀)))
    exact (congrArg₂ (· + ·) e0 (congrArg (fun m => c • m) (P1 g (wcSddcSigma Y O U t)).symm)).trans
      (zero_add _)
  ·
    refine ⟨V.hom ⁻¹ᵁ O, ?_, Or.inl ⟨?_, ?_⟩⟩
    · show V.hom x ∈ (O : Set Y)
      rw [hO]
      exact hx
    · intro z' hz'
      have hz'O : V.hom (Limits.pullback.fst V.hom i z') ∈ (O : Set Y) := hz'
      rw [hO, ← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply] at hz'O
      exact hz'O ⟨_, rfl⟩
    · rw [← hu, P1 (wcSddcOpenSubIncl V (V.hom ⁻¹ᵁ O)) u]

      have hsurj : Function.Surjective
          ((wcSddcIota Y O).app (Opposite.op (wcSddcOpenSub V (V.hom ⁻¹ᵁ O)))) := by
        haveI : IsIso (Limits.pullback.fst (wcSddcOpenSub V (V.hom ⁻¹ᵁ O)).hom O.ι) := by
          rw [isIso_iff_isOpenImmersion_and_surjective]
          refine ⟨inferInstance, ⟨fun a => ?_⟩⟩
          have ha : (V.hom ⁻¹ᵁ O).ι a ∈ V.hom ⁻¹ᵁ O := by
            have : (V.hom ⁻¹ᵁ O).ι a ∈ Set.range (V.hom ⁻¹ᵁ O).ι := ⟨a, rfl⟩
            rwa [Scheme.Opens.range_ι] at this
          have hb : (wcSddcOpenSub V (V.hom ⁻¹ᵁ O)).hom a ∈ Set.range O.ι := by
            rw [Scheme.Opens.range_ι]
            show ((V.hom ⁻¹ᵁ O).ι ≫ V.hom) a ∈ O
            exact ha
          obtain ⟨b, hb⟩ := hb
          obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback a b hb.symm
          exact ⟨z', hz'⟩
        exact (@ConcreteCategory.bijective_of_isIso _ _ _ _ _ _ _ _ _
          (Functor.map_isIso wcSddcUnitsFun
            (Limits.pullback.fst (wcSddcOpenSub V (V.hom ⁻¹ᵁ O)).hom O.ι).op)).2
      obtain ⟨v, hv⟩ := hsurj ((wcSddcMPre Y O).map (wcSddcOpenSubIncl V (V.hom ⁻¹ᵁ O)).op u)
      rw [← hv, P2]

theorem wc_smooth_divisor_proet_divisor_ses_chart (k : Type u) [Field k]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (d : ℕ) [SmoothOfRelativeDimension (d + 1) pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension d (i ≫ pY)]
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology Y)
      ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) :
    ∃ (M D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (ιD : (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) ⟶ M) (p : M ⟶ D)
