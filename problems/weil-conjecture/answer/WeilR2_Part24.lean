    exact congrArg Subtype.val this
  let Yk : ∀ k, Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) (n - 1) := fun k => match k with
    | 0 => (sec (Opposite.op 0)).1.comp (Abelian.Ext.mk₀ (wcContSheafMap D.Yt.left (wcTowerCast ℓ 0)
        continuous_of_discreteTopology)) (add_zero (n - 1))
    | j + 1 => (sec (Opposite.op j)).1
  have C1 : ∀ k, (Yk (k + 1)).comp (Abelian.Ext.mk₀ (wcContSheafMap D.Yt.left (wcTowerCast ℓ k)
      continuous_of_discreteTopology)) (add_zero (n - 1)) = Yk k := by
    intro k
    cases k with
