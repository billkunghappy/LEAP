  obtain ⟨κ⟩ := wc_etqm_srd_fibre_supp (jQ ≫ iW) iW jQ (𝟙 Q) hP m DQ Ew DQ'
  have hsrc : ∀ e' : Abelian.Ext (Ew.Φ.obj (wcEtSuppObj DQ))
      (SheafOfModules.unit (wcEtZModRing W m)) q, e' = 0 := by
    intro e'
    have h0 : (Abelian.Ext.mk₀ κ.inv).comp e' (zero_add q) = 0 := hvan _
    have hx : (Abelian.Ext.mk₀ κ.hom).comp ((Abelian.Ext.mk₀ κ.inv).comp e' (zero_add q))
        (zero_add q) = e' := by
