        A'.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (f.appTop y) := fun y => by
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      rfl
    rw [c1, c2, c2] at e
    exact e

  have hspan' : ∀ i, Ideal.span (Set.range (fun J => (U i).topIso.inv (s i J))) = ⊤ := by
    intro i
    have : Set.range (fun J => (U i).topIso.inv (s i J)) =
        (U i).topIso.inv.hom '' Set.range (s i) := by
      rw [← Set.range_comp]; rfl
    rw [this, ← Ideal.map_span, hs i, Ideal.map_top]
  choose φl hφq hφpre hφrel using fun i =>
    wc_ldpi_oai_proj_lift K n (U i) ((U i).ι ≫ fX) (fun J => (U i).topIso.inv (s i J)) (hspan' i)

  have hcompat : ∀ i j, X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i) ≫ φl i =
      X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φl j := by
    intro i j
    have hr' : ∀ J, (X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).appTop
          ((U j).topIso.inv (s j J)) =
        (U i ⊓ U j).topIso.inv (w i j) *
          (X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).appTop ((U i).topIso.inv (s i J)) := by
      intro J
      rw [hHT, hHT, htr, map_mul]
    have hu : IsUnit ((U i ⊓ U j).topIso.inv (w i j)) := (hw i j).map _
    have hpre_l : ∀ J, (X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i) ≫ φl i) ⁻¹ᵁ wcSgD K n J =
        (↑(U i ⊓ U j) : Scheme.{u}).basicOpen
          ((X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).appTop ((U i).topIso.inv (s i J))) := by
      intro J
      rw [Scheme.Hom.comp_preimage, hφpre, Scheme.preimage_basicOpen]
      rfl
    have hcovP : (⨆ a : Fin (n + 1), wcSgD K n a) = ⊤ := wc_pp_basicOpen_cover K n
    have hcov' : (⨆ J, (↑(U i ⊓ U j) : Scheme.{u}).basicOpen
        ((X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).appTop ((U i).topIso.inv (s i J)))) = ⊤ := by
      rw [← iSup_congr hpre_l, ← Scheme.Hom.preimage_iSup, hcovP, Scheme.Hom.preimage_top]
    have hq : (X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i) ≫ φl i) ≫ wcProjKStr K n =
        (X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φl j) ≫ wcProjKStr K n := by
      rw [Category.assoc, Category.assoc, hφq, hφq, ← Category.assoc, ← Category.assoc,
        Scheme.homOfLE_ι, Scheme.homOfLE_ι]
    have hrel_r : ∀ J L (O : (↑(U i ⊓ U j) : Scheme.{u}).Opens)
        (hO : O ≤ (X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φl j) ⁻¹ᵁ wcSgD K n J),
        (X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φl j).appLE (wcSgD K n J) O hO
            (wcSgE K n J L) *
          (↑(U i ⊓ U j) : Scheme.{u}).presheaf.map (homOfLE (le_top : O ≤ ⊤)).op
            ((X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).appTop ((U i).topIso.inv (s i J))) =
        (↑(U i ⊓ U j) : Scheme.{u}).presheaf.map (homOfLE (le_top : O ≤ ⊤)).op
            ((X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).appTop ((U i).topIso.inv (s i L))) := by
      intro J L O hO
      have e := hpull _ _ _ _ _ (hφrel j) J L O hO
      rw [hr', hr', map_mul, map_mul, mul_left_comm] at e
      exact (hu.map _).mul_left_cancel e
    have huq := wc_csd_proj_uniq_of_relations K n _ ⊤
      (X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i) ≫ φl i)
      (X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φl j)
      (fun J => (X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).appTop ((U i).topIso.inv (s i J)))
      hq hcov' (fun J L O hO _ => hpull _ _ _ _ _ (hφrel i) J L O hO)
      (fun J L O hO _ => hrel_r J L O hO)
