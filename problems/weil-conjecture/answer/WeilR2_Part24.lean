  haveI : Limits.PreservesFiniteLimits P := inferInstance
  haveI : Limits.PreservesFiniteColimits P := wc_et_finite_push_modules_exact iW m Ew
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing W m)) :=
    sheafOfModules_enoughInjectives _ _
