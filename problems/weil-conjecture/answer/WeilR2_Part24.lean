  obtain ⟨ρ, hρi, hρs, hρF⟩ := wc_root_twist_slice_presheaf_map K (Over.mk (W.ι ≫ X.hom)) ℓ hℓ
    hW' k 1
  obtain ⟨φ, hφiso, hφF⟩ := wc_slice_sheafify_scaled_iso (Over.mk (W.ι ≫ X.hom)).left
    (wcGeomPoint K (Over.mk (W.ι ≫ X.hom)) hW') (wcGeomFrob K (Over.mk (W.ι ≫ X.hom)) hW')
