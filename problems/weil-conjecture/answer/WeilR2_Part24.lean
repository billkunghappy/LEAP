  obtain ⟨l₁, ⟨cc⟩⟩ : ∃ l₁ : Λ, Nonempty (W'.obj l₁ ⟶ Nv) := ⟨c0.left, ⟨c0.hom⟩⟩
  have hccV : cc.right.left ≫ V.hom = (W'.obj l₁).right.hom := MorphismProperty.Over.w cc.right
  have hle : (W'.obj l₁).right.hom ⁻¹ᵁ O ≤ cc.right.left ⁻¹ᵁ (V.hom ⁻¹ᵁ O) := by
