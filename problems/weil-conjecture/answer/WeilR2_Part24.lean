      (hle2 : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J * MvPolynomial.X L) ≤ wcSgD K n m) (p : Fin (n + 1)),
      W.presheaf.map (homOfLE hle1).op ((κ.app (wcSgD K n m)).hom (wcSgE K n m p)) =
        θ (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          hg hx (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX m) 1
            (MvPolynomial.X p) (hX p))) := by
    intro m g hg hx hle1 hle2 p
    have e1 : κ.app (wcSgD K n m) ≫ W.presheaf.map (homOfLE hle1).op =
        (wcProjK K n).presheaf.map (homOfLE hle2).op ≫
          (wcProjK K n).presheaf.map (homOfLE hV).op ≫ κ.appLE _ _ hO := by
      rw [← Category.assoc, ← Functor.map_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map,
        Scheme.Hom.map_appLE]
    have e3 := Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hg hx
    have E : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (MvPolynomial.X m) ≫ κ.app (wcSgD K n m) ≫ W.presheaf.map (homOfLE hle1).op =
        CommRingCat.ofHom (HomogeneousLocalization.awayMap
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hg hx) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
            (MvPolynomial.X J * MvPolynomial.X L) ≫
          (wcProjK K n).presheaf.map (homOfLE hV).op ≫ κ.appLE _ _ hO := by
      rw [e1, ← Category.assoc, ← Category.assoc, ← e3]
      rfl
    exact congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX m) 1
            (MvPolynomial.X p) (hX p))) E
  have hxL : MvPolynomial.X J * MvPolynomial.X L =
      (MvPolynomial.X L * MvPolynomial.X J : MvPolynomial (Fin (n + 1)) K) := mul_comm _ _
  have hxJ : MvPolynomial.X J * MvPolynomial.X L =
      (MvPolynomial.X J * MvPolynomial.X L : MvPolynomial (Fin (n + 1)) K) := rfl
  have I1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (hX J) hxL (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX L) 1 (MvPolynomial.X j) (hX j)) =
      HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (hX J) hxL (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX L) 1 (MvPolynomial.X J) (hX J)) *
      HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (hX L) hxJ (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1 (MvPolynomial.X j) (hX j)) := by
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul]; ring⟩
  have I2 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (hX J) hxL (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX L) 1 (MvPolynomial.X J) (hX J)) *
      HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (hX L) hxJ (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1 (MvPolynomial.X L) (hX L)) =
      1 := by
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul, HomogeneousLocalization.val_one]
    rw [← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, mul_one]; ring⟩
  refine ⟨θ (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (hX J) hxL (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX L) 1 (MvPolynomial.X J) (hX J))),
    ?_, ?_⟩
  · refine isUnit_iff_exists_inv.mpr ⟨θ (HomogeneousLocalization.awayMap
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX L) hxJ
      (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (hX J) 1 (MvPolynomial.X L) (hX L))), ?_⟩
    rw [← map_mul, I2, map_one]
  · rw [key L (MvPolynomial.X J) (hX J) hxL inf_le_right hVL j,
      key J (MvPolynomial.X L) (hX L) hxJ inf_le_left hVJ j, ← map_mul, I1]

theorem wc_scqd_principal_smooth (K : Type u) [Field K] (n : ℕ) {Y Z : Scheme.{u}}
    (s : Y ⟶ Spec (.of K)) [SmoothOfRelativeDimension (n + 1) s]
    (g : Z ⟶ Y) [LocallyOfFiniteType (g ≫ s)]
    (hg : ∀ z : Z, ∃ t : Y.presheaf.stalk (g z),
      Function.Surjective (g.stalkMap z).hom ∧
      RingHom.ker (g.stalkMap z).hom = Ideal.span {t} ∧
      (letI := (wcLdpConst K s (g z)).toAlgebra
       KaehlerDifferential.D K (Y.presheaf.stalk (g z)) t ∉
         (IsLocalRing.maximalIdeal (Y.presheaf.stalk (g z))) •
           (⊤ : Submodule (Y.presheaf.stalk (g z)) Ω[Y.presheaf.stalk (g z)⁄K]))) :
    SmoothOfRelativeDimension n (g ≫ s) :=
by

  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of K)) (y : A),
      wcLdpConst K (f ≫ s) y = (f.stalkMap y).hom.comp (wcLdpConst K s (f y)) := by
    intro A B f s y
    ext c
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm

  have htrans : ∀ {A B C : Type u} [CommRing A] [CommRing B] [IsLocalRing B] [CommRing C]
      [IsLocalRing C] (f : B →+* C) [IsLocalHom f] (ρ : A →+* B)
      (d : A →+ IsLocalRing.ResidueField B),
      (∀ a b, d (a * b) = IsLocalRing.residue B (ρ a) * d b + IsLocalRing.residue B (ρ b) * d a) →
      ∀ a b, ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) (a * b) =
        IsLocalRing.residue C (f (ρ a)) * ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) b +
        IsLocalRing.residue C (f (ρ b)) * ((IsLocalRing.ResidueField.map f).toAddMonoidHom.comp d) a := by
    intro A B C _ _ _ _ _ f _ ρ d hd a b
    show IsLocalRing.ResidueField.map f (d (a * b)) =
      IsLocalRing.residue C (f (ρ a)) * IsLocalRing.ResidueField.map f (d b) +
      IsLocalRing.residue C (f (ρ b)) * IsLocalRing.ResidueField.map f (d a)
    rw [hd, map_add, map_mul, map_mul, IsLocalRing.ResidueField.map_residue,
      IsLocalRing.ResidueField.map_residue]
  apply wc_ldp_il_smooth_local
  intro z
  obtain ⟨hRfs, hRfree, hRfin, hRrk, -⟩ :=
    wc_ldp_il_stalk_of_smooth_field K s (n + 1) (g z)
  letI algR : Algebra K (Y.presheaf.stalk (g z)) := (wcLdpConst K s (g z)).toAlgebra
  haveI := hRfs
  haveI := hRfree
  haveI := hRfin
  obtain ⟨t, hsurj, hker, hD⟩ := hg z

  have htk : (g.stalkMap z).hom t = 0 := by
    have : t ∈ RingHom.ker (g.stalkMap z).hom := by
      rw [hker]; exact Ideal.mem_span_singleton_self t
    exact RingHom.mem_ker.mp this
  have htm : t ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (g z)) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h1 := hu.map (g.stalkMap z).hom
    rw [htk] at h1
    exact not_isUnit_zero h1

  obtain ⟨δ₀, hδ₀L, hδ₀K, hδ₀1⟩ := wc_ldp_il_submersive_derivation K
    (Y.presheaf.stalk (g z)) 1 t (by
      rw [one_smul, Derivation.map_one_eq_zero, smul_zero, sub_zero]; exact hD)
  have hδh : δ₀ t = 1 := by
    rw [map_one, one_mul, (IsLocalRing.residue_eq_zero_iff t).mpr htm, zero_mul, sub_zero]
      at hδ₀1
    exact hδ₀1

  letI algS : Algebra K (Z.presheaf.stalk z) := (wcLdpConst K (g ≫ s) z).toAlgebra
  let ψ : Y.presheaf.stalk (g z) →ₐ[K] Z.presheaf.stalk z :=
    { (g.stalkMap z).hom with
      commutes' := fun c' => by
        show (g.stalkMap z).hom (wcLdpConst K s (g z) c') = wcLdpConst K (g ≫ s) z c'
        exact (congrArg (fun φ => φ c') (hcc g s z)).symm }
  have hker' : RingHom.ker ψ = Ideal.span {t} := by
    rw [← hker]; ext r; rw [RingHom.mem_ker, RingHom.mem_ker]; rfl
  let δS : Y.presheaf.stalk (g z) →+ IsLocalRing.ResidueField (Z.presheaf.stalk z) :=
    (IsLocalRing.ResidueField.map (g.stalkMap z).hom).toAddMonoidHom.comp δ₀
  have hδSL : ∀ a b, δS (a * b) =
      IsLocalRing.residue _ (ψ a) * δS b + IsLocalRing.residue _ (ψ b) * δS a :=
    htrans (g.stalkMap z).hom (RingHom.id _) δ₀ hδ₀L
  have hδSK : ∀ c' : K, δS (algebraMap K _ c') = 0 := fun c' =>
    (congrArg (IsLocalRing.ResidueField.map (g.stalkMap z).hom) (hδ₀K c')).trans (map_zero _)
  have hδSh : δS t ≠ 0 := by
    have e2 := (congrArg (IsLocalRing.ResidueField.map (g.stalkMap z).hom) hδh).trans (map_one _)
    exact e2.symm ▸ one_ne_zero
  obtain ⟨hSfs, hSfree, hSfin, hSrk⟩ :=
    wc_ldp_il_hypersurface_criterion K _ _ ψ hsurj t hker' δS hδSL hδSK hδSh
  have hrk : Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄K] = n := by
    omega
  exact wc_ldp_il_spread_abs K (g ≫ s) n z hSfs hSfree hSfin hrk

theorem wc_scqd_divisor_submersive (K : Type u) [Field K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (ha' : (Matrix.of a' + (Matrix.of a').transpose).det ≠ 0)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    {Y : Scheme.{u}} (s : Y ⟶ Spec (.of K)) [SmoothOfRelativeDimension (e + 2) s]
    (κ : Y ⟶ wcProjK K (e + 2 + 1)) (hκs : κ ≫ wcProjKStr K (e + 2 + 1) = s)
    (y : Y) (hsurj : Function.Surjective (κ.stalkMap y).hom)
    (c : Fin (e + 2 + 1 + 1)) (hc1 : 1 ≤ c.val) (hc2 : c.val ≤ e + 2)
    (hy : y ∈ κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c)
    (hq : wcLdpGerm K (e + 2 + 1) κ (wcLdpQuad K (e + 2 + 1) b) c y hy = 0)
    (hN : (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
        ((κ.app (wcSgD K (e + 2 + 1) c)).hom (wcSgE K (e + 2 + 1) c (Fin.last (e + 2 + 1)))) ∈
      IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) :
    letI := (wcLdpConst K s y).toAlgebra
    KaehlerDifferential.D K (Y.presheaf.stalk y)
        ((Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
          ((κ.app (wcSgD K (e + 2 + 1) c)).hom (wcSgE K (e + 2 + 1) c (Fin.last (e + 2 + 1))))) ∉
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) •
        (⊤ : Submodule (Y.presheaf.stalk y) Ω[Y.presheaf.stalk y⁄K]) :=
by
  classical
  have s2 : ∀ (R : Type u) (M : Type u) [CommRing R] [IsLocalRing R]
      [AddCommGroup M] [Module R M] [Module.Free R M] [Module.Finite R M] (n : ℕ),
      Module.finrank R M = n → ∀ (v : Fin n → M), Submodule.span R (Set.range v) = ⊤ →
      ∀ (r : Fin n → R), ∑ i, r i • v i ∈ (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R M) →
      ∀ i, r i ∈ IsLocalRing.maximalIdeal R := by
    intro R M _ _ _ _ _ _ n hrk v hspan r hr
    set L := Fintype.linearCombination R v with hL
    have hLr : ∀ w, L w = ∑ i, w i • v i := fun w => Fintype.linearCombination_apply R v w
    have hsurj : Function.Surjective L := by
      rw [← LinearMap.range_eq_top, hL, Fintype.range_linearCombination, hspan]
    let b := Module.finBasisOfFinrankEq R M hrk
    have hinj : Function.Injective L := by
      have hf : Function.Surjective (b.equivFun.toLinearMap ∘ₗ L) :=
        b.equivFun.surjective.comp hsurj
      have := OrzechProperty.injective_of_surjective_endomorphism _ hf
      intro x y hxy
      apply this
      simp [hxy]
    let Q : Submodule R (Fin n → R) := Submodule.pi Set.univ (fun _ => IsLocalRing.maximalIdeal R)
    have hle : (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R M) ≤ Q.map L := by
      rw [Submodule.smul_le]
      intro m hm y _
      obtain ⟨w, rfl⟩ := hsurj y
      refine ⟨m • w, ?_, by simp⟩
      intro i _
      simp only [Pi.smul_apply, smul_eq_mul]
      exact Ideal.mul_mem_right _ _ hm
    obtain ⟨w', hw'Q, hw'⟩ := hle hr
    rw [hLr] at hw'
    have : w' = r := hinj (by rw [hLr, hLr]; exact hw')
    intro i
    rw [← this]
    exact hw'Q i (Set.mem_univ i)

  have s4 : ∀ (R : Type u) [CommRing R] [Algebra K R] (N : ℕ)
      (a : Fin (N + 1) → Fin (N + 1) → K) (u : Fin (N + 1) → R) (c : Fin (N + 1)), u c = 1 →
      KaehlerDifferential.D K R (∑ p, ∑ q, algebraMap K R (a p q) * u p * u q) =
        ∑ i : Fin N, (∑ q, algebraMap K R (a (c.succAbove i) q + a q (c.succAbove i)) * u q) •
          KaehlerDifferential.D K R (u (c.succAbove i)) := by
    intro R _ _ N a u c hc
    set D := KaehlerDifferential.D K R
    have h1 : ∀ k x y, D (algebraMap K R k * x * y) =
        (algebraMap K R k * x) • D y + (algebraMap K R k * y) • D x := by
      intro k x y
      rw [Derivation.leibniz, Derivation.leibniz, Derivation.map_algebraMap, smul_zero, add_zero,
        smul_smul, mul_comm y]
    have hDc : D (u c) = 0 := by rw [hc]; exact Derivation.map_one_eq_zero D
    have step : D (∑ p, ∑ q, algebraMap K R (a p q) * u p * u q) =
        ∑ e, (∑ q, algebraMap K R (a e q + a q e) * u q) • D (u e) := by
      simp only [map_sum, h1, Finset.sum_add_distrib]
      simp only [map_add, add_mul, add_smul, Finset.sum_add_distrib, Finset.sum_smul]
      rw [add_comm]
      congr 1
      rw [Finset.sum_comm]
    rw [step, Fin.sum_univ_succAbove _ c, hDc, smul_zero, zero_add]

  have s5 : ∀ (L : Type u) [Field L] (f : K →+* L) (n : ℕ)
      (a : Fin n → Fin n → K), (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 →
      ∀ (ξ : Fin n → L) (c : Fin n), ξ c = 1 →
      ∑ p, ∑ q, f (a p q) * ξ p * ξ q = 0 →
      (∀ e, e ≠ c → ∑ q, f (a e q + a q e) * ξ q = 0) → False := by
    intro L _ f n a ha ξ c hξ hG hM
    set M' := (Matrix.of a + (Matrix.of a).transpose).map f with hM'
    have hMv : ∀ e, (M'.mulVec ξ) e = ∑ q, f (a e q + a q e) * ξ q := by
      intro e
      simp [M', Matrix.mulVec, dotProduct, Matrix.map_apply, Matrix.add_apply,
        Matrix.transpose_apply]
    have heul : ∑ e, ξ e * (M'.mulVec ξ) e = 0 := by
      have : ∑ e, ξ e * (M'.mulVec ξ) e =
          ∑ p, ∑ q, f (a p q) * ξ p * ξ q + ∑ p, ∑ q, f (a p q) * ξ p * ξ q := by
        have h2 : ∑ x, ∑ i, ξ x * (f (a i x) * ξ i) = ∑ p, ∑ q, f (a p q) * ξ p * ξ q := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => by ring))
        have h3 : ∑ e, ξ e * (M'.mulVec ξ) e =
            ∑ x, ∑ i, f (a x i) * ξ x * ξ i + ∑ x, ∑ i, ξ x * (f (a i x) * ξ i) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun x _ => ?_)
          rw [hMv, Finset.mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_add]; ring
        rw [h3, h2]
      rw [this, hG, add_zero]
    have hc : (M'.mulVec ξ) c = 0 := by
      rw [Finset.sum_eq_single c] at heul
      · rwa [hξ, one_mul] at heul
      · intro e _ hec
        rw [hMv e, hM e hec, mul_zero]
      · intro h; exact absurd (Finset.mem_univ c) h
    have hzero : M'.mulVec ξ = 0 := by
      funext e
      by_cases hec : e = c
      · subst hec; exact hc
      · rw [hMv e, hM e hec]; rfl
    have hdet : M'.det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨ξ, ?_, hzero⟩
      intro h0
      have := congrFun h0 c
      rw [hξ] at this
      exact one_ne_zero this
    have : M'.det = f (Matrix.of a + (Matrix.of a).transpose).det := by
      rw [hM', RingHom.map_det]; rfl
    rw [this] at hdet
    exact ha ((map_eq_zero f).mp hdet)

  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of K)) (y : A),
      wcLdpConst K (f ≫ s) y = (f.stalkMap y).hom.comp (wcLdpConst K s (f y)) := by
    intro A B f s y
    ext c
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm
  have reidx : ∀ (L : Type u) [Field L] (f : K →+* L) (ξ : Fin (e + 2 + 1 + 1) → L),
      (∑ p, ∑ q, f (b p q) * ξ p * ξ q =
        ξ 0 * ξ (Fin.last _) + ∑ j : Fin (e + 1 + 1), ∑ k : Fin (e + 1 + 1),
          f (a' j k) * ξ ⟨j.val + 1, by have := j.isLt; omega⟩ *
            ξ ⟨k.val + 1, by have := k.isLt; omega⟩) ∧
      ∀ j : Fin (e + 1 + 1),
        ∑ q, f (b ⟨j.val + 1, by have := j.isLt; omega⟩ q +
            b q ⟨j.val + 1, by have := j.isLt; omega⟩) * ξ q =
          ∑ k : Fin (e + 1 + 1), f (a' j k + a' k j) * ξ ⟨k.val + 1, by have := k.isLt; omega⟩ := by
    intro L _ f ξ
    have peel : ∀ (F : Fin (e + 2 + 1 + 1) → L),
        ∑ q, F q = F 0 + F (Fin.last _) +
          ∑ j : Fin (e + 1 + 1), F ⟨j.val + 1, by have := j.isLt; omega⟩ := by
      intro F
      have h2 : ∑ i : Fin (e + 2), F i.castSucc.succ =
          ∑ j : Fin (e + 1 + 1), F ⟨j.val + 1, by have := j.isLt; omega⟩ :=
        Finset.sum_congr rfl (fun j _ => congrArg F (Fin.ext (by simp)))
      rw [Fin.sum_univ_succ, Fin.sum_univ_castSucc, Fin.succ_last, h2]
      abel
    have hbq0 : ∀ q, b q 0 = 0 := by
      intro q; rw [hb]; simp
    have hblast : ∀ q, b (Fin.last _) q = 0 := by
      intro q; rw [hb]; simp
    have hb0l : b 0 (Fin.last _) = 1 := by rw [hb]; simp
    have hb0M : ∀ k : Fin (e + 1 + 1), b 0 ⟨k.val + 1, by have := k.isLt; omega⟩ = 0 := by
      intro k; have := k.isLt; rw [hb]; simp <;> omega
    have hbMl : ∀ j : Fin (e + 1 + 1),
        b ⟨j.val + 1, by have := j.isLt; omega⟩ (Fin.last _) = 0 := by
      intro j; have := j.isLt; rw [hb]; simp <;> omega
    have hbMM : ∀ j k : Fin (e + 1 + 1),
        b ⟨j.val + 1, by have := j.isLt; omega⟩ ⟨k.val + 1, by have := k.isLt; omega⟩ = a' j k := by
      intro j k
      have hj : j.val ≤ e + 1 := by have := j.isLt; omega
      have hk : k.val ≤ e + 1 := by have := k.isLt; omega
      rw [hb]; simp [hj, hk]
    refine ⟨?_, ?_⟩
    · rw [peel]
      simp only [hbq0, hblast, hb0l, hb0M, hbMl, hbMM, map_zero, map_one, zero_mul, one_mul,
        Finset.sum_const_zero, add_zero, zero_add, peel]
    · intro j
      rw [peel]
      simp only [hbq0, hblast, hb0M, hbMl, hbMM, map_zero, map_add, zero_mul, add_zero, zero_add]

  have s6 : ∀ (R : Type u) (M : Type u) [CommRing R] [IsLocalRing R]
      [AddCommGroup M] [Module R M] [Module.Free R M] [Module.Finite R M] (n : ℕ),
      Module.finrank R M = n → ∀ (v : Fin (n + 1) → M), Submodule.span R (Set.range v) = ⊤ →
      ∀ (r : Fin (n + 1) → R), ∑ i, r i • v i = 0 → ∀ (j k : Fin (n + 1)), j ≠ k →
      IsUnit (r j) → v k ∉ (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R M) := by
    intro R M _ _ _ _ _ _ n hrk v hspan r hrel j k hjk hj hk
    have hspan' : Submodule.span R (Set.range (fun i => v (j.succAbove i))) = ⊤ := by
      refine eq_top_iff.mpr ?_
      rw [← hspan]
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      by_cases hij : i = j
      · subst hij
        rw [Fin.sum_univ_succAbove _ i] at hrel
        obtain ⟨μ, hμ⟩ := hj
        have hv : v i = (↑μ⁻¹ : R) • -(∑ t, r (i.succAbove t) • v (i.succAbove t)) := by
          rw [← eq_neg_of_add_eq_zero_left hrel, ← hμ, smul_smul, Units.inv_mul, one_smul]
        rw [hv]
        exact Submodule.smul_mem _ _ (Submodule.neg_mem _ (Submodule.sum_mem _
          (fun t _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨t, rfl⟩))))
      · obtain ⟨t, rfl⟩ := Fin.exists_succAbove_eq hij
        exact Submodule.subset_span ⟨t, rfl⟩
    obtain ⟨k', rfl⟩ := Fin.exists_succAbove_eq hjk.symm
    have h1 := s2 R M n hrk (fun i => v (j.succAbove i)) hspan' (Pi.single k' (1 : R)) (by
      rw [Finset.sum_eq_single k']
      · simpa using hk
      · intro b' _ hb'
        simp [Pi.single_eq_of_ne hb']
      · intro h; exact absurd (Finset.mem_univ k') h) k'
    rw [Pi.single_eq_same] at h1
    exact (Ideal.ne_top_iff_one _).mp (IsLocalRing.maximalIdeal.isMaximal R).ne_top h1
  letI algR : Algebra K (Y.presheaf.stalk y) := (wcLdpConst K s y).toAlgebra
  obtain ⟨u, hu_def⟩ : ∃ u : Fin (e + 2 + 1 + 1) → Y.presheaf.stalk y, ∀ t, u t =
      (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
        ((κ.app (wcSgD K (e + 2 + 1) c)).hom (wcSgE K (e + 2 + 1) c t)) := ⟨_, fun t => rfl⟩

  obtain ⟨-, huc, hquad, -⟩ := wc_ldp_lnf_chart_germ K (e + 2 + 1) (Over.mk s) κ hκs
    (fun a p hp c' => wc_ldp_il_proj_const K (e + 2 + 1) a p hp c')
    (fun a w => wc_ldp_lnf_sec_quad K (e + 2 + 1) a w) c y hy
  have huc' : u c = 1 := by rw [hu_def]; exact huc
  have H0 : ∑ p, ∑ q, algebraMap K (Y.presheaf.stalk y) (b p q) * u p * u q = 0 := by
    have h := hquad b
    rw [hq] at h
    refine Eq.trans ?_ h.symm
    (simp only [hu_def, RingHom.algebraMap_toAlgebra]) <;> rfl

  obtain ⟨-, hfree, hfin, hrk, -⟩ := wc_ldp_il_stalk_of_smooth_field K s (e + 2) y
  haveI := hfree
  haveI := hfin

  have hspan : Submodule.span (Y.presheaf.stalk y)
      (Set.range fun i : Fin (e + 2 + 1) =>
        KaehlerDifferential.D K (Y.presheaf.stalk y) (u (c.succAbove i))) = ⊤ := by
    set Sp := Submodule.span (Y.presheaf.stalk y)
      (Set.range fun i : Fin (e + 2 + 1) =>
        KaehlerDifferential.D K (Y.presheaf.stalk y) (u (c.succAbove i))) with hSp
    have hDu : ∀ t, KaehlerDifferential.D K (Y.presheaf.stalk y) (u t) ∈ Sp := by
      intro t
      by_cases htc : t = c
      · rw [htc, huc', Derivation.map_one_eq_zero]; exact Sp.zero_mem
      · obtain ⟨i, hi⟩ := Fin.exists_succAbove_eq htc
        rw [← hi]; exact Submodule.subset_span ⟨i, rfl⟩
    let T : Subring (Y.presheaf.stalk y) :=
      { carrier := {x | KaehlerDifferential.D K (Y.presheaf.stalk y) x ∈ Sp}
        mul_mem' := fun {x y} hx hy => by
          show KaehlerDifferential.D K _ (x * y) ∈ Sp
          rw [Derivation.leibniz]; exact Sp.add_mem (Sp.smul_mem _ hy) (Sp.smul_mem _ hx)
        one_mem' := by
          show KaehlerDifferential.D K _ 1 ∈ Sp
          rw [Derivation.map_one_eq_zero]; exact Sp.zero_mem
        add_mem' := fun {x y} hx hy => by
          show KaehlerDifferential.D K _ (x + y) ∈ Sp
          rw [map_add]; exact Sp.add_mem hx hy
        zero_mem' := by
          show KaehlerDifferential.D K _ 0 ∈ Sp
          rw [map_zero]; exact Sp.zero_mem
        neg_mem' := fun {x} hx => by
          show KaehlerDifferential.D K _ (-x) ∈ Sp
          rw [map_neg]; exact Sp.neg_mem hx }
    have h2 : ∀ c' : K, wcLdpConst K s y c' =
        (κ.stalkMap y).hom (wcLdpConst K (wcProjKStr K (e + 2 + 1)) (κ y) c') := by
      intro c'
      rw [← hκs, hcc, RingHom.comp_apply]
    have hconst : ∀ c' : K, (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
        ((κ.app (wcSgD K (e + 2 + 1) c)).hom
          ((wcProjK K (e + 2 + 1)).presheaf.map (homOfLE (le_top : wcSgD K (e + 2 + 1) c ≤ ⊤)).op
            ((wcProjKStr K (e + 2 + 1)).appTop ((Scheme.ΓSpecIso (.of K)).inv c')))) =
        algebraMap K (Y.presheaf.stalk y) c' := by
      intro c'
      refine (Scheme.Hom.germ_stalkMap_apply κ (wcSgD K (e + 2 + 1) c) y hy _).symm.trans ?_
      rw [RingHom.algebraMap_toAlgebra, h2 c']
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ
        ((wcProjKStr K (e + 2 + 1)).appTop ((Scheme.ΓSpecIso (.of K)).inv c')))
        ((wcProjK K (e + 2 + 1)).presheaf.germ_res (homOfLE (le_top : wcSgD K (e + 2 + 1) c ≤ ⊤))
          (κ y) hy)
      have h3 : ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) (κ y) hy).hom
          ((wcProjK K (e + 2 + 1)).presheaf.map (homOfLE (le_top : wcSgD K (e + 2 + 1) c ≤ ⊤)).op
            ((wcProjKStr K (e + 2 + 1)).appTop ((Scheme.ΓSpecIso (.of K)).inv c'))) =
          wcLdpConst K (wcProjKStr K (e + 2 + 1)) (κ y) c' := by
        first
          | exact h1
          | simpa [wcLdpConst] using h1
      exact congrArg (κ.stalkMap y).hom h3
    have hγT : ∀ w : Γ(wcProjK K (e + 2 + 1), wcSgD K (e + 2 + 1) c),
        (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
          ((κ.app (wcSgD K (e + 2 + 1) c)).hom w) ∈ T := by
      intro w
      refine (Subring.closure_le (t := T.comap
        (((Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom).comp
          (κ.app (wcSgD K (e + 2 + 1) c)).hom))).mpr ?_ (wc_ldpi_oai_proj_gen K (e + 2 + 1) c w)
      rintro x (⟨t, rfl⟩ | ⟨c', rfl⟩)
      · have h := hDu t
        rw [hu_def] at h
        exact h
      · show KaehlerDifferential.D K (Y.presheaf.stalk y)
          ((Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
            ((κ.app (wcSgD K (e + 2 + 1) c)).hom
              ((wcProjK K (e + 2 + 1)).presheaf.map (homOfLE (le_top : wcSgD K (e + 2 + 1) c ≤ ⊤)).op
                ((wcProjKStr K (e + 2 + 1)).appTop ((Scheme.ΓSpecIso (.of K)).inv c'))))) ∈ Sp
        rw [hconst, Derivation.map_algebraMap]; exact Sp.zero_mem
    have hall : ∀ r : Y.presheaf.stalk y, KaehlerDifferential.D K (Y.presheaf.stalk y) r ∈ Sp := by
      intro r
      obtain ⟨z, rfl⟩ := hsurj r
      obtain ⟨ρ, σ, hσu, hz⟩ := wc_ldp_il_proj_stalk_frac K (e + 2 + 1) c (κ y) hy z
      have h1 := hγT ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
        (MvPolynomial.X c)).hom σ)
      have h2' := hγT ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
        (MvPolynomial.X c)).hom ρ)
      have e1 : (κ.stalkMap y).hom (((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c)
          (κ y) hy).hom ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
            (MvPolynomial.X c)).hom σ)) =
          (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
            ((κ.app (wcSgD K (e + 2 + 1) c)).hom
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
                (MvPolynomial.X c)).hom σ)) :=
        Scheme.Hom.germ_stalkMap_apply κ _ y hy _
      have e2 : (κ.stalkMap y).hom (((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c)
          (κ y) hy).hom ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
            (MvPolynomial.X c)).hom ρ)) =
          (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
            ((κ.app (wcSgD K (e + 2 + 1) c)).hom
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
                (MvPolynomial.X c)).hom ρ)) :=
        Scheme.Hom.germ_stalkMap_apply κ _ y hy _
      have hz' := congrArg (κ.stalkMap y).hom hz
      rw [map_mul, e1, e2] at hz'
      have hσu' := hσu.map (κ.stalkMap y).hom
      rw [e1] at hσu'
      generalize (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
          ((κ.app (wcSgD K (e + 2 + 1) c)).hom
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
              (MvPolynomial.X c)).hom σ)) = gs at h1 hσu' hz'
      generalize (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) c) y hy).hom
          ((κ.app (wcSgD K (e + 2 + 1) c)).hom
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
              (MvPolynomial.X c)).hom ρ)) = gr at h2' hz'
      generalize (κ.stalkMap y).hom z = r at hz' ⊢
      have h1' : KaehlerDifferential.D K (Y.presheaf.stalk y) gs ∈ Sp := h1
      have h2'' : KaehlerDifferential.D K (Y.presheaf.stalk y) gr ∈ Sp := h2'
      have h3 : KaehlerDifferential.D K (Y.presheaf.stalk y) (r * gs) =
          KaehlerDifferential.D K (Y.presheaf.stalk y) gr := by rw [hz']
      rw [Derivation.leibniz] at h3
      have h4 : gs • KaehlerDifferential.D K (Y.presheaf.stalk y) r ∈ Sp := by
        have e : gs • KaehlerDifferential.D K (Y.presheaf.stalk y) r =
            KaehlerDifferential.D K (Y.presheaf.stalk y) gr -
              r • KaehlerDifferential.D K (Y.presheaf.stalk y) gs := by
          rw [← h3]; abel
        rw [e]; exact Sp.sub_mem h2'' (Sp.smul_mem _ h1')
      obtain ⟨w, hw⟩ := hσu'
      have e3 : KaehlerDifferential.D K (Y.presheaf.stalk y) r =
          (↑w⁻¹ : Y.presheaf.stalk y) • (gs • KaehlerDifferential.D K (Y.presheaf.stalk y) r) := by
        rw [← hw, smul_smul, Units.inv_mul, one_smul]
      rw [e3]; exact Sp.smul_mem _ h4
    refine eq_top_iff.mpr ?_
    rw [← KaehlerDifferential.span_range_derivation K (Y.presheaf.stalk y)]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨r, rfl⟩
    exact hall r

  have hrel : ∑ i : Fin (e + 2 + 1), (∑ q, algebraMap K (Y.presheaf.stalk y)
      (b (c.succAbove i) q + b q (c.succAbove i)) * u q) •
      KaehlerDifferential.D K (Y.presheaf.stalk y) (u (c.succAbove i)) = 0 := by
    rw [← s4 (Y.presheaf.stalk y) (e + 2 + 1) b u c huc', H0, map_zero]

  obtain ⟨fK, hfK⟩ : ∃ fK : K →+* IsLocalRing.ResidueField (Y.presheaf.stalk y),
      fK = (IsLocalRing.residue _).comp (algebraMap K (Y.presheaf.stalk y)) := ⟨_, rfl⟩
  obtain ⟨ξ, hξ⟩ : ∃ ξ : Fin (e + 2 + 1 + 1) → IsLocalRing.ResidueField (Y.presheaf.stalk y),
      ∀ t, ξ t = IsLocalRing.residue _ (u t) := ⟨_, fun t => rfl⟩
  have hξl : ξ (Fin.last (e + 2 + 1)) = 0 := by
    rw [hξ, IsLocalRing.residue_eq_zero_iff, hu_def]; exact hN
  have hGb : ∑ p, ∑ q, fK (b p q) * ξ p * ξ q = 0 := by
    have h := congrArg (IsLocalRing.residue (Y.presheaf.stalk y)) H0
    simp only [map_sum, map_mul, map_zero] at h
    rw [← h]
    (simp only [hξ, hfK, RingHom.comp_apply]) <;> rfl
  obtain ⟨hR1, hR2⟩ := reidx _ fK ξ
  have hG' : ∑ j : Fin (e + 1 + 1), ∑ k : Fin (e + 1 + 1),
      fK (a' j k) * ξ ⟨j.val + 1, by have := j.isLt; omega⟩ *
        ξ ⟨k.val + 1, by have := k.isLt; omega⟩ = 0 := by
    have h := hR1.symm.trans hGb
    rw [hξl, mul_zero, zero_add] at h
    exact h
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : Fin (e + 1 + 1), c₀.val = c.val - 1 :=
    ⟨⟨c.val - 1, by omega⟩, rfl⟩
  have hζc₀ : ξ ⟨c₀.val + 1, by have := c₀.isLt; omega⟩ = 1 := by
    have hcc0 : (⟨c₀.val + 1, by have := c₀.isLt; omega⟩ : Fin (e + 2 + 1 + 1)) = c :=
      Fin.ext (by show c₀.val + 1 = c.val; omega)
    rw [hcc0, hξ, huc', map_one]
  have hex : ∃ j : Fin (e + 1 + 1), j ≠ c₀ ∧
      ∑ k, fK (a' j k + a' k j) * ξ ⟨k.val + 1, by have := k.isLt; omega⟩ ≠ 0 := by
    by_contra hne
    push_neg at hne
    exact s5 (IsLocalRing.ResidueField (Y.presheaf.stalk y)) fK (e + 1 + 1) a' ha'
      (fun j => ξ ⟨j.val + 1, by have := j.isLt; omega⟩) c₀ hζc₀ hG' hne
  obtain ⟨j, hjc, hjne⟩ := hex
  have hj2 : j.val + 1 < e + 2 + 1 + 1 := by have := j.isLt; omega
  have he'c : (⟨j.val + 1, hj2⟩ : Fin (e + 2 + 1 + 1)) ≠ c := by
    intro h
    have h' : j.val + 1 = c.val := congrArg Fin.val h
    exact hjc (Fin.ext (by omega))
  have hlc : Fin.last (e + 2 + 1) ≠ c := by
    intro h
    have h' : e + 2 + 1 = c.val := congrArg Fin.val h
    omega
  obtain ⟨j₁, hj₁⟩ := Fin.exists_succAbove_eq he'c
  obtain ⟨k₁, hk₁⟩ := Fin.exists_succAbove_eq hlc
  have hjk : j₁ ≠ k₁ := by
    intro h
    rw [h, hk₁] at hj₁
    have h' : e + 2 + 1 = j.val + 1 := congrArg Fin.val hj₁
    have := j.isLt
    omega
  have hunit : IsUnit (∑ q, algebraMap K (Y.presheaf.stalk y)
      (b (c.succAbove j₁) q + b q (c.succAbove j₁)) * u q) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
    intro h0
    apply hjne
    rw [← hR2 j, ← h0, hj₁]
    (simp only [map_sum, map_mul, hξ, hfK, RingHom.comp_apply]) <;> rfl
  have hfin := s6 (Y.presheaf.stalk y) Ω[Y.presheaf.stalk y⁄K] (e + 2) hrk
    (fun i => KaehlerDifferential.D K (Y.presheaf.stalk y) (u (c.succAbove i))) hspan
    (fun i => ∑ q, algebraMap K (Y.presheaf.stalk y)
      (b (c.succAbove i) q + b q (c.succAbove i)) * u q) hrel j₁ k₁ hjk hunit
  simp only [hk₁] at hfin
  rw [hu_def] at hfin
  exact hfin

theorem wc_scqd_quad_germ_zero (K : Type u) [Field K] (N n : ℕ)
    (X : Over (Spec (.of K))) [SmoothOfRelativeDimension n X.hom]
    (jE : X.left ⟶ wcProjK K N) (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2)
    (hEG : ∀ (x : X.left) (c : Fin (N + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K N c),
      wcLdpGerm K N jE H c x hx ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x))
    {Y : Scheme.{u}} (f : Y ⟶ X.left) (c : Fin (N + 1)) (y : Y)
    (hy : y ∈ (f ≫ jE) ⁻¹ᵁ wcSgD K N c) :
    wcLdpGerm K N (f ≫ jE) H c y hy = 0 :=
by
  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom
  haveI : ∀ x : X.left, _root_.IsReduced (X.left.presheaf.stalk x) := fun x => by
    haveI := (wc_fntame_smooth_stalk_normal K X.left X.hom x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X.left := AlgebraicGeometry.isReduced_of_isReduced_stalk _
  have ht : (jE.app (wcSgD K N c)).hom (wcLdpSec K N H c) = 0 := by
    rw [← AlgebraicGeometry.basicOpen_eq_bot_iff]
    rw [eq_bot_iff]
    intro x hx
    exfalso
    have hxV : x ∈ jE ⁻¹ᵁ wcSgD K N c := X.left.basicOpen_le _ hx
    have hu := (X.left.mem_basicOpen _ x hxV).mp hx
    have hm := hEG x c hxV
    exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hm
  have e : ((f ≫ jE).app (wcSgD K N c)).hom (wcLdpSec K N H c) =
      (f.app (jE ⁻¹ᵁ wcSgD K N c)).hom ((jE.app (wcSgD K N c)).hom (wcLdpSec K N H c)) := by
    first
      | rfl
      | (rw [Scheme.Hom.comp_app]; rfl)
      | simp [Scheme.Hom.comp_app]
  have e0 : ((f ≫ jE).app (wcSgD K N c)).hom (wcLdpSec K N H c) = 0 := by
    rw [e, ht]
    first
      | exact map_zero _
      | rfl
      | simp
  unfold wcLdpGerm
  rw [e0, map_zero]

theorem wc_scq_cone_divisor (K : Type u) [Field K] [Finite K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (ha' : (Matrix.of a' + (Matrix.of a').transpose).det ≠ 0)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K))) [IsProper E₀.hom] [SmoothOfRelativeDimension (e + 2) E₀.hom]
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (e + 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c),
      wcLdpGerm K (e + 2 + 1) jE (wcLdpQuad K (e + 2 + 1) b) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) :
    U ≤ Op ∧
    ∃ (D : Over (Spec (.of K))) (_ : SmoothOfRelativeDimension (e + 1) D.hom)
      (iD : D.left ⟶ Op.toScheme),
      IsClosedImmersion iD ∧ iD ≫ Op.ι ≫ E₀.hom = D.hom ∧
      Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left) :=
by
  classical
  haveI := hjE

  have hUO : U ≤ Op := by
    rw [hU, hOp]
    have hl : Fin.last (e + 2 + 1) = (Fin.last (e + 2)).succ := (Fin.succ_last (e + 2)).symm
    rw [hl]
    exact le_iSup (fun c : Fin (e + 2 + 1) => jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) (Fin.last (e + 2))

  haveI hZL : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (e + 2)) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  haveI hsY : SmoothOfRelativeDimension (e + 2) (Op.ι ≫ E₀.hom) :=
    IsZariskiLocalAtSource.comp ‹SmoothOfRelativeDimension (e + 2) E₀.hom› Op.ι

  have hcov : (⨆ c : Fin (e + 2 + 1), (Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) = ⊤ := by
    rw [eq_top_iff]
    intro p _
    have hp : Op.ι p ∈ Op := by
      have : Op.ι p ∈ Set.range Op.ι := ⟨p, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    obtain ⟨c, hc⟩ := TopologicalSpace.Opens.mem_iSup.mp (hOp.le hp)
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨c, hc⟩
  have hcovp : ∀ p : Op.toScheme, ∃ c : Fin (e + 2 + 1),
      p ∈ (Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ := by
    intro p
    have : p ∈ (⨆ c : Fin (e + 2 + 1), (Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) := by
      rw [hcov]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp this
  have hW : ∀ c : Fin (e + 2 + 1),
      IsAffineOpen ((Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) := by
    intro c
    have h1 : IsAffineOpen (wcSgD K (e + 2 + 1) c.succ) :=
      Proj.isAffineOpen_basicOpen _ (MvPolynomial.X c.succ)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K _))
        Nat.one_pos
    have h2 : IsAffineOpen (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) := h1.preimage jE
    have hle : jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ ≤ Op.ι.opensRange := by
      rw [Scheme.Opens.opensRange_ι, hOp]
      exact le_iSup (fun c : Fin (e + 2 + 1) => jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) c
    have h3 := h2.preimage_of_isOpenImmersion Op.ι hle
    first
      | exact h3
      | (rw [Scheme.Hom.comp_preimage]; exact h3)

  obtain ⟨Z, g, hg, -, hrange, hstalk⟩ := wc_ldpi_principal_subscheme Op.toScheme
    (Fin (e + 2 + 1)) (fun c => (Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) hW hcov
    (fun c => ((Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) c.succ)).hom
      (wcSgE K (e + 2 + 1) c.succ (Fin.last (e + 2 + 1))))
    (fun i j => wc_scqd_sgE_transition K (e + 2 + 1) Op.toScheme (Op.ι ≫ jE) i.succ j.succ
      (Fin.last (e + 2 + 1)))
  haveI := hg

  have c2 : ∀ (p : Op.toScheme) (J : Fin (e + 2 + 1 + 1))
      (hp : p ∈ (Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J),
      (Op.toScheme.presheaf.germ ((Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J) p hp).hom
          (((Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) J)).hom
            (wcSgE K (e + 2 + 1) J (Fin.last (e + 2 + 1)))) ∈
        IsLocalRing.maximalIdeal (Op.toScheme.presheaf.stalk p) ↔
      (Op.ι ≫ jE) p ∉ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) := by
    intro p J hp
    rw [← not_iff_not, not_not, IsLocalRing.notMem_maximalIdeal]
    refine (Scheme.mem_basicOpen _ _ p hp).symm.trans ?_
    rw [← Scheme.preimage_basicOpen,
      (wc_ldpi_oai_sgE_facts K (e + 2 + 1) J (Fin.last (e + 2 + 1))).2,
      Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_inf]
    exact ⟨fun h => h.2, fun h => ⟨hp, h⟩⟩

  have g4 : ∀ p : Op.toScheme, p ∈ Set.range g ↔
      (Op.ι ≫ jE) p ∉ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) := by
    intro p
    rw [hrange p]
    constructor
    · intro H
      obtain ⟨c, hc⟩ := hcovp p
      exact (c2 p c.succ hc).mp (H c hc)
    · intro H c hc
      exact (c2 p c.succ hc).mpr H
  have hU' : ∀ p : Op.toScheme, Op.ι p ∈ U ↔
      (Op.ι ≫ jE) p ∈ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) := by
    intro p
    rw [hU, Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]

  have hrng : Set.range (g ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left) := by
    ext x
    constructor
    · rintro ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      refine ⟨?_, ?_⟩
      · have : Op.ι (g z) ∈ Set.range Op.ι := ⟨g z, rfl⟩
        rwa [Scheme.Opens.range_ι] at this
      · intro hx
        exact (g4 (g z)).mp ⟨z, rfl⟩ ((hU' (g z)).mp hx)
    · rintro ⟨hxO, hxU⟩
      have : x ∈ Set.range Op.ι := by rw [Scheme.Opens.range_ι]; exact hxO
      obtain ⟨p, rfl⟩ := this
      obtain ⟨z, rfl⟩ := (g4 p).mpr (fun h => hxU ((hU' p).mpr h))
      exact ⟨z, by rw [Scheme.Hom.comp_apply]⟩

  haveI : LocallyOfFiniteType (g ≫ Op.ι ≫ E₀.hom) := inferInstance
  haveI : SmoothOfRelativeDimension (e + 1 + 1) (Op.ι ≫ E₀.hom) := hsY
  have hsm : SmoothOfRelativeDimension (e + 1) (g ≫ Op.ι ≫ E₀.hom) := by
    refine wc_scqd_principal_smooth K (e + 1) (Op.ι ≫ E₀.hom) g ?_
    intro z
    obtain ⟨c, hc⟩ := hcovp (g z)
    obtain ⟨hsurj, hker⟩ := hstalk z c hc
    have hnot : (Op.ι ≫ jE) (g z) ∉ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) :=
      (g4 (g z)).mp ⟨z, rfl⟩
    have hc2 : c.succ.val ≤ e + 2 := by
      have hne : c.succ ≠ Fin.last (e + 2 + 1) := by
        intro heq
        apply hnot
        rw [← heq]
        exact hc
      have h1 : c.succ.val ≠ e + 3 := fun h => hne (Fin.ext (by rw [Fin.val_last]; omega))
      have h2 := c.isLt
      rw [Fin.val_succ] at h1 ⊢
      omega
    have hc1 : 1 ≤ c.succ.val := by rw [Fin.val_succ]; omega
    have hsurjκ : Function.Surjective ((Op.ι ≫ jE).stalkMap (g z)).hom := by
      first
        | exact Scheme.Hom.stalkMap_surjective _ _
        | exact (Op.ι ≫ jE).stalkMap_surjective (g z)
    refine ⟨_, hsurj, hker, ?_⟩
    exact wc_scqd_divisor_submersive K e a' ha' b hb (Op.ι ≫ E₀.hom) (Op.ι ≫ jE)
      (by rw [Category.assoc, hjEY]) (g z) hsurjκ c.succ hc1 hc2 hc
      (wc_scqd_quad_germ_zero K (e + 2 + 1) (e + 2) E₀ jE (wcLdpQuad K (e + 2 + 1) b) hEG
        Op.ι c.succ (g z) hc)
      ((hrange (g z)).mp ⟨z, rfl⟩ c hc)

  exact ⟨hUO, Over.mk (g ≫ Op.ι ≫ E₀.hom), hsm, g, hg, rfl, hrng⟩

theorem wc_projK_quad_germ_coords (K : Type u) [Field K] (n : ℕ) (T : Scheme.{u})
    (fT : T ⟶ Spec (.of K)) (g : T ⟶ wcProjK K n) (hg : g ≫ wcProjKStr K n = fT)
    (W : T.Opens) (t : Fin (n + 1) → Γ(T, W))
    (hrel : ∀ J L (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K n J) (hOW : O ≤ W),
      g.appLE (wcSgD K n J) O hO (wcSgE K n J L) * T.presheaf.map (homOfLE hOW).op (t J) =
        T.presheaf.map (homOfLE hOW).op (t L))
    (hbo : ∀ J, g ⁻¹ᵁ wcSgD K n J ⊓ W = T.basicOpen (t J))
    (w : Fin (n + 1) → Fin (n + 1) → K) (J : Fin (n + 1)) (x : T) (hxW : x ∈ W)
    (hxJ : x ∈ g ⁻¹ᵁ wcSgD K n J) :
    (((wcProjK K n).presheaf.germ (wcSgD K n J) (g x) hxJ).hom
        (wcLdpSec K n (wcLdpQuad K n w) J) ∈ IsLocalRing.maximalIdeal ((wcProjK K n).presheaf.stalk (g x)) ↔
      wcLdpGerm K n g (wcLdpQuad K n w) J x hxJ ∈ IsLocalRing.maximalIdeal (T.presheaf.stalk x)) ∧
    (wcLdpGerm K n g (wcLdpQuad K n w) J x hxJ ∈ IsLocalRing.maximalIdeal (T.presheaf.stalk x) ↔
      (∑ p, ∑ q, wcLdpConst K fT x (w p q) * (T.presheaf.germ W x hxW).hom (t p) *
        (T.presheaf.germ W x hxW).hom (t q)) ∈ IsLocalRing.maximalIdeal (T.presheaf.stalk x)) :=
by
  classical
  have hxO : x ∈ g ⁻¹ᵁ wcSgD K n J ⊓ W := ⟨hxJ, hxW⟩
  refine ⟨?_, ?_⟩
  ·
    have h1 : wcLdpGerm K n g (wcLdpQuad K n w) J x hxJ =
        (g.stalkMap x).hom (((wcProjK K n).presheaf.germ (wcSgD K n J) (g x) hxJ).hom
          (wcLdpSec K n (wcLdpQuad K n w) J)) :=
      (Scheme.Hom.germ_stalkMap_apply g (wcSgD K n J) x hxJ _).symm
    rw [h1, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
    exact (map_mem_nonunits_iff (g.stalkMap x).hom _).symm
  ·
    set γ : Fin (n + 1) → T.presheaf.stalk x := fun p =>
      (T.presheaf.germ (g ⁻¹ᵁ wcSgD K n J) x hxJ).hom ((g.app (wcSgD K n J)).hom (wcSgE K n J p))
      with hγ
    set τ : Fin (n + 1) → T.presheaf.stalk x := fun p => (T.presheaf.germ W x hxW).hom (t p)
      with hτ
    have h3 : wcLdpGerm K n g (wcLdpQuad K n w) J x hxJ =
        ∑ p, ∑ q, wcLdpConst K fT x (w p q) * γ p * γ q :=
      (wc_ldp_lnf_chart_germ K n (Over.mk fT) g hg
        (fun a p hp c => wc_ldp_il_proj_const K n a p hp c)
        (fun a w => wc_ldp_lnf_sec_quad K n a w) J x hxJ).2.2.1 w
    have hu : IsUnit (τ J) := by
      have hb : x ∈ T.basicOpen (t J) := by
        rw [← hbo J]
        exact hxO
      exact (Scheme.mem_basicOpen T (t J) x hxW).mp hb
    have hratio : ∀ p, γ p * τ J = τ p := by
      intro p
      have h := congrArg (T.presheaf.germ (g ⁻¹ᵁ wcSgD K n J ⊓ W) x hxO).hom
        (hrel J p (g ⁻¹ᵁ wcSgD K n J ⊓ W) inf_le_left inf_le_right)
      have hE : g.app (wcSgD K n J) ≫ T.presheaf.map (homOfLE (inf_le_left :
            g ⁻¹ᵁ wcSgD K n J ⊓ W ≤ g ⁻¹ᵁ wcSgD K n J)).op =
          g.appLE (wcSgD K n J) (g ⁻¹ᵁ wcSgD K n J ⊓ W) inf_le_left := by
        rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
      have happ : g.appLE (wcSgD K n J) (g ⁻¹ᵁ wcSgD K n J ⊓ W) inf_le_left (wcSgE K n J p) =
          T.presheaf.map (homOfLE (inf_le_left :
            g ⁻¹ᵁ wcSgD K n J ⊓ W ≤ g ⁻¹ᵁ wcSgD K n J)).op
            ((g.app (wcSgD K n J)).hom (wcSgE K n J p)) := by
        rw [← hE]
        rfl
      rw [map_mul, happ, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
        TopCat.Presheaf.germ_res_apply] at h
      exact h
    rw [h3]
    have hsum : ∑ p, ∑ q, wcLdpConst K fT x (w p q) * τ p * τ q =
        (τ J * τ J) * ∑ p, ∑ q, wcLdpConst K fT x (w p q) * γ p * γ q := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [← hratio p, ← hratio q]
      ring
    show _ ↔ (∑ p, ∑ q, wcLdpConst K fT x (w p q) * τ p * τ q) ∈ _
    rw [hsum, Ideal.unit_mul_mem_iff_mem _ (hu.mul hu)]

theorem wc_scq_cc_lift_to_divisor (K : Type u) [Field K] (e : ℕ)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (E₀ : Over (Spec (.of K)))
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ)
    (D : Scheme.{u}) (iD : D ⟶ Op.toScheme) (hiD : IsClosedImmersion iD)
    (hrange : Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left))
    (T : Scheme.{u}) [IsReduced T] (g : T ⟶ wcProjK K (e + 2 + 1))
    (hg : ∀ y : T, (∀ (c : Fin (e + 2 + 1 + 1)) (hp : g y ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) (g y) hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk (g y))) ∧
      g y ∉ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) ∧
      ∃ c : Fin (e + 2 + 1), g y ∈ wcSgD K (e + 2 + 1) c.succ) :
    ∃ ℓ : T ⟶ D, ℓ ≫ iD ≫ Op.ι ≫ jE = g :=
by
  have factor : ∀ (W X Y : Scheme.{u}) (g : W ⟶ Y) (z : X ⟶ Y) [IsClosedImmersion z]
      [IsReduced W], Set.range g ⊆ Set.range z → ∃ g' : W ⟶ X, g' ≫ z = g := by
    intro W X Y g z _ _ hrange
    have H : z.ker ≤ g.ker := by
      show z.ker ≤ Scheme.IdealSheafData.ofIdeals
        (fun U : Y.affineOpens => RingHom.ker (g.app U).hom)
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      have hz : (z.app U).hom s = 0 :=
        Scheme.IdealSheafData.ideal_ofIdeals_le
          (I := fun U : Y.affineOpens => RingHom.ker (z.app U).hom) U hs
      have hX : z ⁻¹ᵁ Y.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen]
        erw [hz]
        exact Scheme.basicOpen_zero _ _
      have hW : W.basicOpen ((g.app U).hom s) = ⊥ := by
        rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
        intro w hw
        obtain ⟨x, hx⟩ := hrange ⟨w, rfl⟩
        have hx' : x ∈ z ⁻¹ᵁ Y.basicOpen s := by
          show z x ∈ Y.basicOpen s
          rw [hx]; exact hw
        rw [hX] at hx'
        exact hx'.elim
      exact eq_zero_of_basicOpen_eq_bot _ hW
    exact ⟨IsClosedImmersion.lift z g H, IsClosedImmersion.lift_fac z g H⟩
  haveI := hjE
  haveI := hiD
  have s1 : Set.range g ⊆ Set.range jE := by
    rintro _ ⟨y, rfl⟩
    exact hEall (g y) (hg y).1
  obtain ⟨g', hg'⟩ := factor T E₀.left (wcProjK K (e + 2 + 1)) g jE s1
  have hpt : ∀ y : T, jE (g' y) = g y := by
    intro y
    rw [← hg', Scheme.Hom.comp_apply]
  have s3a : ∀ y : T, g' y ∈ Op := by
    intro y
    obtain ⟨c, hc⟩ := (hg y).2.2
    rw [hOp, TopologicalSpace.Opens.mem_iSup]
    refine ⟨c, ?_⟩
    rw [Scheme.Hom.mem_preimage, hpt]
    exact hc
  have s3b : ∀ y : T, g' y ∉ U := by
    intro y
    rw [hU, Scheme.Hom.mem_preimage, hpt]
    exact (hg y).2.1
  have H' : Set.range g' ⊆ Set.range Op.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    exact s3a y
  set g'' := IsOpenImmersion.lift Op.ι g' H' with hg''def
  have hg'' : g'' ≫ Op.ι = g' := IsOpenImmersion.lift_fac _ _ _
  have s5 : Set.range g'' ⊆ Set.range iD := by
    rintro _ ⟨y, rfl⟩
    have hmem : g' y ∈ (Op : Set E₀.left) \ (U : Set E₀.left) := ⟨s3a y, s3b y⟩
    rw [← hrange] at hmem
    obtain ⟨d, hd⟩ := hmem
    refine ⟨d, ?_⟩
    apply (Scheme.Hom.isOpenEmbedding Op.ι).injective
    rw [← Scheme.Hom.comp_apply, hd, ← Scheme.Hom.comp_apply, hg'']
  obtain ⟨ℓ, hℓ⟩ := factor T D Op.toScheme g'' iD s5
  refine ⟨ℓ, ?_⟩
  rw [← Category.assoc, hℓ, ← Category.assoc, hg'', hg']

theorem wc_scq_cc_quad_reindex (K : Type u) [Field K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (R : Type u) [CommRing R] (C : K →+* R) (γ : Fin (e + 2 + 1 + 1) → R)
    (hγ : γ (Fin.last (e + 2 + 1)) = 0) :
    ∑ p, ∑ q, C (b p q) * γ p * γ q =
      ∑ i : Fin (e + 1 + 1), ∑ j : Fin (e + 1 + 1),
        C (a' i j) * γ ⟨i.val + 1, by omega⟩ * γ ⟨j.val + 1, by omega⟩ :=
by
  classical
  let s : Fin (e + 1 + 1) → Fin (e + 2 + 1 + 1) := fun k => ⟨k.val + 1, by omega⟩
  have hsv : ∀ k, (s k).val = k.val + 1 := fun k => rfl
  have hsinj : Function.Injective s := by
    intro k k' h
    apply Fin.ext
    have := congrArg Fin.val h
    rw [hsv, hsv] at this
    omega
  have hrange : ∀ p : Fin (e + 2 + 1 + 1), p ∉ Set.range s → p.val = 0 ∨ p.val = e + 3 := by
    intro p hp
    by_contra hcon
    apply hp
    refine ⟨⟨p.val - 1, by omega⟩, ?_⟩
    apply Fin.ext
    rw [hsv]
    simp only
    omega
  have hT0 : ∀ p q : Fin (e + 2 + 1 + 1),
      (p.val = 0 ∨ p.val = e + 3 ∨ q.val = 0 ∨ q.val = e + 3) →
      C (b p q) * γ p * γ q = 0 := by
    intro p q hpq
    by_cases hq : q.val = e + 3
    · have hql : q = Fin.last (e + 2 + 1) := Fin.ext (by rw [Fin.val_last]; omega)
      rw [hql, hγ, mul_zero]
    · have hb0 : b p q = 0 := by
        rw [hb, if_neg (by omega), dif_neg (by omega)]
      rw [hb0, map_zero, zero_mul, zero_mul]
  have hint : ∀ i j : Fin (e + 1 + 1), b (s i) (s j) = a' i j := by
    intro i j
    rw [hb, if_neg (by rw [hsv]; omega), dif_pos (by rw [hsv, hsv]; omega)]
    all_goals (congr 1 <;> apply Fin.ext <;> simp [hsv])
  have hrow : ∀ i : Fin (e + 1 + 1),
      ∑ q, C (b (s i) q) * γ (s i) * γ q = ∑ j, C (a' i j) * γ (s i) * γ (s j) := by
    intro i
    symm
    apply Fintype.sum_of_injective s hsinj
    · intro q hq
      apply hT0
      rcases hrange q hq with h | h
      · exact Or.inr (Or.inr (Or.inl h))
      · exact Or.inr (Or.inr (Or.inr h))
    · intro j
      rw [hint]
  calc ∑ p, ∑ q, C (b p q) * γ p * γ q = ∑ i, ∑ q, C (b (s i) q) * γ (s i) * γ q := by
        symm
        apply Fintype.sum_of_injective s hsinj
        · intro p hp
          apply Finset.sum_eq_zero
          intro q _
          apply hT0
          rcases hrange p hp with h | h
          · exact Or.inl h
          · exact Or.inr (Or.inl h)
        · intro i
          rfl
    _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        exact hrow i

theorem wc_scq_cc_sigma_lift (K : Type u) [Field K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K)))
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (E₁ : Over (Spec (.of K))) [SmoothOfRelativeDimension e E₁.hom]
    (jE₁ : E₁.left ⟶ wcProjK K (e + 1)) (hjE₁ : IsClosedImmersion jE₁)
    (hjEY₁ : jE₁ ≫ wcProjKStr K (e + 1) = E₁.hom)
    (hEG₁ : ∀ (x : E₁.left) (c : Fin (e + 1 + 1)) (hx : x ∈ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
      wcLdpGerm K (e + 1) jE₁ (wcLdpQuad K (e + 1) a') c x hx ∈
        IsLocalRing.maximalIdeal (E₁.left.presheaf.stalk x))
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ)
    (D : Over (Spec (.of K)))
    (iD : D.left ⟶ Op.toScheme) (hiD : IsClosedImmersion iD) (hiDE : iD ≫ Op.ι ≫ E₀.hom = D.hom)
    (hrange : Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left)) :
    ∃ σ : E₁.left ⟶ D.left, σ ≫ D.hom = E₁.hom ∧
      (∀ (c : Fin (e + 1 + 1)) (J : Fin (e + 2 + 1 + 1)),
        (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c =
          E₁.left.basicOpen (if h : 1 ≤ J.val ∧ J.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨J.val - 1, by omega⟩)
            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c)))) ∧
      ∀ (c : Fin (e + 1 + 1)) (J L : Fin (e + 2 + 1 + 1)) (O : E₁.left.Opens)
        (hO : O ≤ (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J)
        (hOW : O ≤ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
        (σ ≫ iD ≫ Op.ι ≫ jE).appLE (wcSgD K (e + 2 + 1) J) O hO (wcSgE K (e + 2 + 1) J L) *
          E₁.left.presheaf.map (homOfLE hOW).op (if h : 1 ≤ J.val ∧ J.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨J.val - 1, by omega⟩)
            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))) =
        E₁.left.presheaf.map (homOfLE hOW).op (if h : 1 ≤ L.val ∧ L.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨L.val - 1, by omega⟩)
            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))) :=
by
  classical

  haveI hE₁red : IsReduced E₁.left := wcpa_dj_sst_smooth_reduced E₁.hom e inferInstance
  have hκ : (iD ≫ Op.ι ≫ jE) ≫ wcProjKStr K (e + 2 + 1) = D.hom := by
    simp only [Category.assoc, hjEY]
    exact hiDE

  have hcov : (⨆ c : Fin (e + 1 + 1), jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) = ⊤ := by
    have h1 := Scheme.Hom.preimage_iSup jE₁ (fun c : Fin (e + 1 + 1) => wcSgD K (e + 1) c)
    have h2 : (⨆ c : Fin (e + 1 + 1), wcSgD K (e + 1) c) = ⊤ := wc_pp_basicOpen_cover K (e + 1)
    rw [h2, Scheme.Hom.preimage_top] at h1
    exact h1.symm
  have hcovpt : ∀ y : E₁.left, ∃ c : Fin (e + 1 + 1), y ∈ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c := by
    intro y
    have hy : y ∈ (⨆ c : Fin (e + 1 + 1), jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) := by
      rw [hcov]; simp
    exact TopologicalSpace.Opens.mem_iSup.mp hy
  have hboE : ∀ (c J' : Fin (e + 1 + 1)),
      jE₁ ⁻¹ᵁ wcSgD K (e + 1) J' ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c =
        E₁.left.basicOpen ((jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c J')) := by
    intro c J'
    rw [← Scheme.Hom.preimage_basicOpen, (wc_ldpi_oai_sgE_facts K (e + 1) c J').2,
      Scheme.Hom.preimage_inf]
    exact inf_comm _ _

  obtain ⟨s, hs_def⟩ : ∃ s : ∀ c : Fin (e + 1 + 1), Fin (e + 2 + 1 + 1) →
      Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
      s = fun c J => if h : 1 ≤ J.val ∧ J.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨J.val - 1, by omega⟩)
            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c)) := ⟨_, rfl⟩
  have hsv : ∀ (c : Fin (e + 1 + 1)) (J : Fin (e + 2 + 1 + 1)) (h : 1 ≤ J.val ∧ J.val ≤ e + 2),
      s c J = (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨J.val - 1, by omega⟩) := by
    intro c J h
    rw [hs_def]
    exact dif_pos h
  have hsz : ∀ (c : Fin (e + 1 + 1)) (J : Fin (e + 2 + 1 + 1)), ¬ (1 ≤ J.val ∧ J.val ≤ e + 2) →
      s c J = 0 := by
    intro c J h
    rw [hs_def]
    exact dif_neg h
  have hsi : ∀ (c i : Fin (e + 1 + 1)), s c ⟨i.val + 1, by omega⟩ =
      (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c i) := by
    intro c i
    have hi := i.isLt
    rw [hsv c _ ⟨by show 1 ≤ i.val + 1; omega, by show i.val + 1 ≤ e + 2; omega⟩]
    exact congrArg (fun k => (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c k))
      (Fin.ext (by show i.val + 1 - 1 = i.val; omega))
  have hslast : ∀ c : Fin (e + 1 + 1), s c (Fin.last (e + 2 + 1)) = 0 := by
    intro c
    exact hsz c _ (by rw [Fin.val_last]; omega)
  have hs1 : ∀ c : Fin (e + 1 + 1), s c ⟨c.val + 1, by omega⟩ = 1 := by
    intro c
    rw [hsi c c]
    exact (wc_projK_chart_tuple_facts K (e + 1) E₁.left jE₁ c c).1
  have hspan : ∀ c : Fin (e + 1 + 1), Ideal.span (Set.range (s c)) = ⊤ := by
    intro c
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨_, hs1 c⟩) isUnit_one

  obtain ⟨w, hw_def⟩ : ∃ w : ∀ c c' : Fin (e + 1 + 1),
      Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c'),
      w = fun c c' => E₁.left.presheaf.map (homOfLE (inf_le_right :
          jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c' ≤
            jE₁ ⁻¹ᵁ wcSgD K (e + 1) c')).op
          ((jE₁.app (wcSgD K (e + 1) c')).hom (wcSgE K (e + 1) c' c)) := ⟨_, rfl⟩
  have hw : ∀ c c' : Fin (e + 1 + 1), IsUnit (w c c') := by
    intro c c'
    rw [hw_def]
    exact IsUnit.of_mul_eq_one _ (wc_projK_chart_tuple_facts K (e + 1) E₁.left jE₁ c c').2.2.2
  have htr : ∀ (c c' : Fin (e + 1 + 1)) (J : Fin (e + 2 + 1 + 1)),
      E₁.left.presheaf.map (homOfLE (inf_le_right :
          jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c' ≤
            jE₁ ⁻¹ᵁ wcSgD K (e + 1) c')).op (s c' J) =
        w c c' * E₁.left.presheaf.map (homOfLE (inf_le_left :
          jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c' ≤
            jE₁ ⁻¹ᵁ wcSgD K (e + 1) c)).op (s c J) := by
    intro c c' J
    by_cases h : 1 ≤ J.val ∧ J.val ≤ e + 2
    · rw [hsv c' J h, hsv c J h, hw_def]
      exact (wc_projK_chart_tuple_facts K (e + 1) E₁.left jE₁ c c').2.2.1 ⟨J.val - 1, by omega⟩
    · rw [hsz c' J h, hsz c J h, map_zero, map_zero, mul_zero]

  obtain ⟨σt, hσK, hσbo, hσrel⟩ := wc_projK_glue_local_coords K (e + 2 + 1) E₁.left E₁.hom
    (fun c : Fin (e + 1 + 1) => jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) hcov s hspan w hw htr
  have hσbo' : ∀ (c : Fin (e + 1 + 1)) (J : Fin (e + 2 + 1 + 1)),
      σt ⁻¹ᵁ wcSgD K (e + 2 + 1) J ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c = E₁.left.basicOpen (s c J) :=
    hσbo
  have hσrel' : ∀ (c : Fin (e + 1 + 1)) (J L : Fin (e + 2 + 1 + 1)) (O : E₁.left.Opens)
      (hO : O ≤ σt ⁻¹ᵁ wcSgD K (e + 2 + 1) J) (hOi : O ≤ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
      σt.appLE (wcSgD K (e + 2 + 1) J) O hO (wcSgE K (e + 2 + 1) J L) *
          E₁.left.presheaf.map (homOfLE hOi).op (s c J) =
        E₁.left.presheaf.map (homOfLE hOi).op (s c L) :=
    hσrel

  obtain ⟨σ, hσ⟩ := wc_scq_cc_lift_to_divisor K e b E₀ jE hjE hEall U Op hU hOp D.left iD hiD
    hrange E₁.left σt (by
      intro y
      obtain ⟨c, hyc⟩ := hcovpt y
      refine ⟨?_, ?_, ?_⟩
      · intro J hJ
        have hxJ : y ∈ σt ⁻¹ᵁ wcSgD K (e + 2 + 1) J := hJ
        have N4a := wc_projK_quad_germ_coords K (e + 2 + 1) E₁.left E₁.hom σt hσK
          (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) (s c) (hσrel' c) (hσbo' c) b J y hyc hxJ
        have N4b := wc_projK_quad_germ_coords K (e + 1) E₁.left E₁.hom jE₁ hjEY₁
          (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c)
          (fun k => (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c k))
          (wc_projK_chart_tuple_facts K (e + 1) E₁.left jE₁ c c).2.1
          (fun J' => hboE c J') a' c y hyc hyc
        have hg := N4b.2.mp (hEG₁ y c hyc)
        have hQ := wc_scq_cc_quad_reindex K e a' b hb _ (wcLdpConst K E₁.hom y)
          (fun p => (E₁.left.presheaf.germ (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) y hyc).hom (s c p))
          (by
            show (E₁.left.presheaf.germ (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) y hyc).hom
              (s c (Fin.last (e + 2 + 1))) = 0
            rw [hslast c, map_zero])
        apply N4a.1.mpr
        apply N4a.2.mpr
        rw [hQ]
        simp only [hsi c]
        exact hg
      · intro hlast
        have hmem : y ∈ σt ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) ⊓
            jE₁ ⁻¹ᵁ wcSgD K (e + 1) c := ⟨hlast, hyc⟩
        rw [hσbo' c, hslast c, Scheme.basicOpen_zero] at hmem
        exact absurd hmem (by simp)
      · refine ⟨⟨c.val, by omega⟩, ?_⟩
        have hb' := hσbo' c ⟨c.val + 1, by omega⟩
        rw [hs1 c, Scheme.basicOpen_one] at hb'
        have hmem : y ∈ σt ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⊓
            jE₁ ⁻¹ᵁ wcSgD K (e + 1) c := by
          rw [hb']
          exact hyc
        have e1 : (⟨c.val, by omega⟩ : Fin (e + 2 + 1)).succ = ⟨c.val + 1, by omega⟩ := Fin.ext rfl
        rw [e1]
        exact hmem.1)

  subst hσ
  subst hs_def
  refine ⟨σ, ?_, hσbo', hσrel'⟩
  rw [← hκ]
  simpa only [Category.assoc] using hσK

theorem wc_scq_cc_kappa_facts (K : Type u) [Field K] (e : ℕ)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (E₀ : Over (Spec (.of K)))
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1))
    (hEG : ∀ (x : E₀.left) (c : Fin (e + 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c),
      wcLdpGerm K (e + 2 + 1) jE (wcLdpQuad K (e + 2 + 1) b) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ)
    (D : Scheme.{u}) (iD : D ⟶ Op.toScheme)
    (hrange : Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left)) :
    ∀ x : D, (iD ≫ Op.ι ≫ jE) x ∉ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) ∧
      (∃ c : Fin (e + 1 + 1), (iD ≫ Op.ι ≫ jE) x ∈ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩) ∧
      ∀ (J : Fin (e + 2 + 1 + 1)) (hx : x ∈ (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J),
        wcLdpGerm K (e + 2 + 1) (iD ≫ Op.ι ≫ jE) (wcLdpQuad K (e + 2 + 1) b) J x hx ∈
          IsLocalRing.maximalIdeal (D.presheaf.stalk x) :=
by
  have key : ∀ {Y Z : Scheme.{u}} (g : Y ⟶ wcProjK K (e + 2 + 1)) (f : Z ⟶ Y),
      (∀ (y : Y) (J : Fin (e + 2 + 1 + 1)) (hy : y ∈ g ⁻¹ᵁ wcSgD K (e + 2 + 1) J),
        wcLdpGerm K (e + 2 + 1) g (wcLdpQuad K (e + 2 + 1) b) J y hy ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) →
      ∀ (z : Z) (J : Fin (e + 2 + 1 + 1)) (hz : z ∈ (f ≫ g) ⁻¹ᵁ wcSgD K (e + 2 + 1) J),
        wcLdpGerm K (e + 2 + 1) (f ≫ g) (wcLdpQuad K (e + 2 + 1) b) J z hz ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk z) := by
    intro Y Z g f hg z J hz
    have hfz : f z ∈ g ⁻¹ᵁ wcSgD K (e + 2 + 1) J := hz
    have h1 := hg (f z) J hfz
    have heq : wcLdpGerm K (e + 2 + 1) (f ≫ g) (wcLdpQuad K (e + 2 + 1) b) J z hz =
        (f.stalkMap z).hom (wcLdpGerm K (e + 2 + 1) g (wcLdpQuad K (e + 2 + 1) b) J (f z) hfz) := by
      unfold wcLdpGerm
      rw [Scheme.Hom.germ_stalkMap_apply]
      rfl
    rw [heq, IsLocalRing.mem_maximalIdeal]
    exact (map_mem_nonunits_iff (f.stalkMap z).hom _).mpr ((IsLocalRing.mem_maximalIdeal _).mp h1)
  have hc1 := key jE Op.ι hEG
  have hc2 := key (Op.ι ≫ jE) iD hc1
  intro x
  have hx' : (iD ≫ Op.ι) x ∈ (Op : Set E₀.left) \ (U : Set E₀.left) := by
    rw [← hrange]; exact Set.mem_range_self x
  have hpt : (iD ≫ Op.ι ≫ jE) x = jE ((iD ≫ Op.ι) x) := by
    simp only [Scheme.Hom.comp_apply]
  generalize hy : (iD ≫ Op.ι) x = y at hx' hpt
  have ha : (iD ≫ Op.ι ≫ jE) x ∉ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) := by
    intro h
    apply hx'.2
    rw [hpt] at h
    rw [hU]
    exact h
  refine ⟨ha, ?_, fun J hx => hc2 x J hx⟩
  have hOpx : y ∈ Op := hx'.1
  rw [hOp] at hOpx
  obtain ⟨c', hc'0⟩ := TopologicalSpace.Opens.mem_iSup.mp hOpx
  have hc' : (iD ≫ Op.ι ≫ jE) x ∈ wcSgD K (e + 2 + 1) c'.succ := by
    rw [hpt]; exact hc'0
  by_cases hcv : c'.val = e + 2
  · exfalso
    apply ha
    have : c'.succ = Fin.last (e + 2 + 1) := by
      ext; simp [Fin.val_succ, Fin.val_last, hcv]
    rw [← this]; exact hc'
  · refine ⟨⟨c'.val, by omega⟩, ?_⟩
    have heq : (⟨c'.val + 1, by omega⟩ : Fin (e + 2 + 1 + 1)) = c'.succ := by
      ext; simp [Fin.val_succ]
    rw [heq]; exact hc'

theorem wc_scq_cc_pi_germ (K : Type u) [Field K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (T : Scheme.{u}) (fT : T ⟶ Spec (.of K))
    (κ : T ⟶ wcProjK K (e + 2 + 1)) (hκ : κ ≫ wcProjKStr K (e + 2 + 1) = fT)
    (g : T ⟶ wcProjK K (e + 1)) (hg : g ≫ wcProjKStr K (e + 1) = fT)
    (c : Fin (e + 1 + 1))
    (hlast : (κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
        (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ (Fin.last (e + 2 + 1))) = 0)
    (hgerm : ∀ (x : T) (hx : x ∈ κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
        wcLdpGerm K (e + 2 + 1) κ (wcLdpQuad K (e + 2 + 1) b) ⟨c.val + 1, by omega⟩ x hx ∈
          IsLocalRing.maximalIdeal (T.presheaf.stalk x))
    (hbo : ∀ J : Fin (e + 1 + 1),
        g ⁻¹ᵁ wcSgD K (e + 1) J ⊓ κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ =
          T.basicOpen ((κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
            (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨J.val + 1, by omega⟩)))
    (hrel : ∀ (J L : Fin (e + 1 + 1)) (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K (e + 1) J)
        (hOW : O ≤ κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
        g.appLE (wcSgD K (e + 1) J) O hO (wcSgE K (e + 1) J L) *
          T.presheaf.map (homOfLE hOW).op ((κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
            (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨J.val + 1, by omega⟩)) =
        T.presheaf.map (homOfLE hOW).op ((κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
            (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨L.val + 1, by omega⟩)))
    (x : T) (hx : x ∈ κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)
    (J : Fin (e + 1 + 1)) (hJ : g x ∈ wcSgD K (e + 1) J) :
    ((wcProjK K (e + 1)).presheaf.germ (wcSgD K (e + 1) J) (g x) hJ).hom
        (wcLdpSec K (e + 1) (wcLdpQuad K (e + 1) a') J) ∈
      IsLocalRing.maximalIdeal ((wcProjK K (e + 1)).presheaf.stalk (g x)) :=
by
  have hxJ : x ∈ g ⁻¹ᵁ wcSgD K (e + 1) J := hJ

  have hb0 : ∀ p q : Fin (e + 2 + 1 + 1), (p.val = 0 ∨ p.val = e + 3 ∨ q.val = 0 ∨ q.val = e + 3) →
      ¬ (p.val = 0 ∧ q.val = e + 3) → b p q = 0 := by
    intro p q h1 h2
    rw [hb p q, if_neg h2, dif_neg (by omega)]
  have hb1 : ∀ i j : Fin (e + 1 + 1),
      b ⟨i.val + 1, by omega⟩ ⟨j.val + 1, by omega⟩ = a' i j := by
    intro i j
    have h1 : ¬ (i.val + 1 = 0 ∧ j.val + 1 = e + 3) := by omega
    have h2 : 1 ≤ i.val + 1 ∧ i.val + 1 ≤ e + 2 ∧ 1 ≤ j.val + 1 ∧ j.val + 1 ≤ e + 2 := by omega
    rw [hb, if_neg h1, dif_pos h2]
    first
      | rfl
      | (congr 1 <;> apply Fin.ext <;> simp)
      | (congr 1 <;> apply Fin.ext <;> simp only [] <;> omega)
  have hι : Function.Injective
      (fun i : Fin (e + 1 + 1) => (⟨i.val + 1, by omega⟩ : Fin (e + 2 + 1 + 1))) := by
    intro i j h
    have h' : i.val + 1 = j.val + 1 := congrArg Fin.val h
    exact Fin.ext (by omega)
  have hoff : ∀ p : Fin (e + 2 + 1 + 1),
      p ∉ Set.range (fun i : Fin (e + 1 + 1) => (⟨i.val + 1, by omega⟩ : Fin (e + 2 + 1 + 1))) →
      p.val = 0 ∨ p.val = e + 3 := by
    intro p hp
    by_contra hc
    push_neg at hc
    have hplt := p.isLt
    exact hp ⟨⟨p.val - 1, by omega⟩, Fin.ext (show p.val - 1 + 1 = p.val by omega)⟩

  have alg : ∀ (R : Type u) [CommRing R] (I : Ideal R) (C : K →+* R)
      (γ : Fin (e + 2 + 1 + 1) → R) (γ' : Fin (e + 1 + 1) → R),
      γ (Fin.last (e + 2 + 1)) = 0 →
      (∀ p : Fin (e + 1 + 1), γ' p * γ ⟨J.val + 1, by omega⟩ = γ ⟨p.val + 1, by omega⟩) →
      IsUnit (γ ⟨J.val + 1, by omega⟩) →
      (∑ p, ∑ q, C (b p q) * γ p * γ q) ∈ I →
      (∑ p, ∑ q, C (a' p q) * γ' p * γ' q) ∈ I := by
    intro R _ I C γ γ' hl hk hu hmem
    have hQ : (∑ p, ∑ q, C (b p q) * γ p * γ q) =
        ∑ i : Fin (e + 1 + 1), ∑ j : Fin (e + 1 + 1),
          C (a' i j) * γ ⟨i.val + 1, by omega⟩ * γ ⟨j.val + 1, by omega⟩ := by
      symm
      refine Fintype.sum_of_injective _ hι _ _ ?_ ?_
      · intro p hp
        rcases hoff p hp with h0 | h3
        · apply Finset.sum_eq_zero
          intro q _
          by_cases hq : q.val = e + 3
          · have hql : q = Fin.last (e + 2 + 1) := Fin.ext (by simp only [Fin.val_last]; omega)
            rw [hql, hl, mul_zero]
          · rw [hb0 p q (Or.inl h0) (fun h => hq h.2), map_zero, zero_mul, zero_mul]
        · apply Finset.sum_eq_zero
          intro q _
          rw [hb0 p q (Or.inr (Or.inl h3)) (fun h => by omega), map_zero, zero_mul, zero_mul]
      · intro i
        refine Fintype.sum_of_injective _ hι _ _ ?_ ?_
        · intro q hq
          rw [hb0 ⟨i.val + 1, by omega⟩ q (Or.inr (Or.inr (hoff q hq)))
            (fun h => by simp at h),
            map_zero, zero_mul, zero_mul]
        · intro j
          rw [hb1 i j]
    have hS : (∑ i : Fin (e + 1 + 1), ∑ j : Fin (e + 1 + 1),
          C (a' i j) * γ ⟨i.val + 1, by omega⟩ * γ ⟨j.val + 1, by omega⟩) =
        (γ ⟨J.val + 1, by omega⟩ * γ ⟨J.val + 1, by omega⟩) *
          ∑ p, ∑ q, C (a' p q) * γ' p * γ' q := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [← hk p, ← hk q]
      ring
    rw [hQ, hS] at hmem
    obtain ⟨v, hv⟩ := hu.mul hu
    have h3 := I.mul_mem_left (↑v⁻¹ : R) hmem
    rwa [← hv, ← mul_assoc, Units.inv_mul, one_mul] at h3

  have CGg := (wc_ldp_lnf_chart_germ K (e + 1) (Over.mk fT) g hg
      (wc_ldp_il_proj_const K (e + 1)) (wc_ldp_lnf_sec_quad K (e + 1)) J x hxJ).2.2.1 a'
  have CGk := (wc_ldp_lnf_chart_germ K (e + 2 + 1) (Over.mk fT) κ hκ
      (wc_ldp_il_proj_const K (e + 2 + 1)) (wc_ldp_lnf_sec_quad K (e + 2 + 1))
      ⟨c.val + 1, by omega⟩ x hx).2.2.1 b

  suffices H : wcLdpGerm K (e + 1) g (wcLdpQuad K (e + 1) a') J x hxJ ∈
      IsLocalRing.maximalIdeal (T.presheaf.stalk x) by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at H ⊢
    intro hu
    apply H
    have h3 : (g.stalkMap x).hom
          (((wcProjK K (e + 1)).presheaf.germ (wcSgD K (e + 1) J) (g x) hJ).hom
            (wcLdpSec K (e + 1) (wcLdpQuad K (e + 1) a') J)) =
        (T.presheaf.germ (g ⁻¹ᵁ wcSgD K (e + 1) J) x hxJ).hom
          ((g.app (wcSgD K (e + 1) J)).hom (wcLdpSec K (e + 1) (wcLdpQuad K (e + 1) a') J)) :=
      Scheme.Hom.germ_stalkMap_apply g _ x hJ _
    have h4 := hu.map (g.stalkMap x).hom
    rw [h3] at h4
    exact h4
  refine Eq.mpr (congrArg (fun r => r ∈ IsLocalRing.maximalIdeal (T.presheaf.stalk x)) CGg) ?_
  refine alg (T.presheaf.stalk x) (IsLocalRing.maximalIdeal (T.presheaf.stalk x))
    (wcLdpConst K (Over.mk fT).hom x)
    (fun p => (T.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩) x hx).hom
      ((κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
        (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ p)))
    (fun p => (T.presheaf.germ (g ⁻¹ᵁ wcSgD K (e + 1) J) x hxJ).hom
      ((g.app (wcSgD K (e + 1) J)).hom (wcSgE K (e + 1) J p))) ?_ ?_ ?_ ?_
  · show (T.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩) x hx).hom
      ((κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
        (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ (Fin.last (e + 2 + 1)))) = 0
    rw [hlast, map_zero]
  · intro p
    obtain ⟨O₀, hO₀⟩ : ∃ O : T.Opens, O = g ⁻¹ᵁ wcSgD K (e + 1) J ⊓
        κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ := ⟨_, rfl⟩
    have hO : O₀ ≤ g ⁻¹ᵁ wcSgD K (e + 1) J := by rw [hO₀]; exact inf_le_left
    have hOW : O₀ ≤ κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ := by
      rw [hO₀]; exact inf_le_right
    have hx0 : x ∈ O₀ := by
      rw [hO₀]; exact TopologicalSpace.Opens.mem_inf.mpr ⟨hxJ, hx⟩
    have h := congrArg (T.presheaf.germ O₀ x hx0).hom (hrel J p O₀ hO hOW)
    have e1 : (T.presheaf.germ O₀ x hx0).hom
        (g.appLE (wcSgD K (e + 1) J) O₀ hO (wcSgE K (e + 1) J p)) =
        (T.presheaf.germ (g ⁻¹ᵁ wcSgD K (e + 1) J) x hxJ).hom
          ((g.app (wcSgD K (e + 1) J)).hom (wcSgE K (e + 1) J p)) :=
      TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE hO) x hx0
        ((g.app (wcSgD K (e + 1) J)).hom (wcSgE K (e + 1) J p))
    have e2 : ∀ L : Fin (e + 1 + 1), (T.presheaf.germ O₀ x hx0).hom
        (T.presheaf.map (homOfLE hOW).op ((κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
          (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨L.val + 1, by omega⟩))) =
        (T.presheaf.germ (κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩) x hx).hom
          ((κ.app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
            (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨L.val + 1, by omega⟩)) := fun L =>
      TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE hOW) x hx0 _
    rw [map_mul, e1, e2 J, e2 p] at h
    exact h
  · have hx1 : x ∈ g ⁻¹ᵁ wcSgD K (e + 1) J ⊓ κ ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨hxJ, hx⟩
    rw [hbo J] at hx1
    exact (Scheme.mem_basicOpen T _ x hx).mp hx1
  · exact Eq.mp (congrArg (fun r => r ∈ IsLocalRing.maximalIdeal (T.presheaf.stalk x)) CGk)
      (hgerm x hx)

theorem wc_scq_cc_pi_lift (K : Type u) [Field K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K)))
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1))
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (e + 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c),
      wcLdpGerm K (e + 2 + 1) jE (wcLdpQuad K (e + 2 + 1) b) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (E₁ : Over (Spec (.of K)))
    (jE₁ : E₁.left ⟶ wcProjK K (e + 1)) (hjE₁ : IsClosedImmersion jE₁)
    (hjEY₁ : jE₁ ≫ wcProjKStr K (e + 1) = E₁.hom)
    (hEall₁ : ∀ p : wcProjK K (e + 1), (∀ (c : Fin (e + 1 + 1)) (hp : p ∈ wcSgD K (e + 1) c),
        ((wcProjK K (e + 1)).presheaf.germ (wcSgD K (e + 1) c) p hp).hom
            (wcLdpSec K (e + 1) (wcLdpQuad K (e + 1) a') c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 1)).presheaf.stalk p)) → p ∈ Set.range jE₁)
    (U Op : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ)
    (D : Over (Spec (.of K))) [SmoothOfRelativeDimension (e + 1) D.hom]
    (iD : D.left ⟶ Op.toScheme) (hiDE : iD ≫ Op.ι ≫ E₀.hom = D.hom)
    (hrange : Set.range (iD ≫ Op.ι) = (Op : Set E₀.left) \ (U : Set E₀.left)) :
    ∃ π : D.left ⟶ E₁.left, π ≫ E₁.hom = D.hom ∧
      (∀ (c J : Fin (e + 1 + 1)),
        (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J ⊓
            (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ =
          D.left.basicOpen (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨J.val + 1, by omega⟩))) ∧
      ∀ (c J L : Fin (e + 1 + 1)) (O : D.left.Opens)
        (hO : O ≤ (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J)
        (hOW : O ≤ (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
        (π ≫ jE₁).appLE (wcSgD K (e + 1) J) O hO (wcSgE K (e + 1) J L) *
          D.left.presheaf.map (homOfLE hOW).op (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨J.val + 1, by omega⟩)) =
        D.left.presheaf.map (homOfLE hOW).op (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨L.val + 1, by omega⟩)) :=
by
  haveI := hjE₁

  have hκ : (iD ≫ Op.ι ≫ jE) ≫ wcProjKStr K (e + 2 + 1) = D.hom := by
    simp only [Category.assoc, hjEY]
    exact hiDE

  haveI hDred : IsReduced D.left := wcpa_dj_sst_smooth_reduced D.hom (e + 1) inferInstance
  have N6 := wc_scq_cc_kappa_facts K e b E₀ jE hEG U Op hU hOp D.left iD hrange

  have ht2 : ∀ c' : Fin (e + 1 + 1),
      ((iD ≫ Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) ⟨c'.val + 1, by omega⟩)).hom
        (wcSgE K (e + 2 + 1) ⟨c'.val + 1, by omega⟩ (Fin.last (e + 2 + 1))) = 0 := by
    intro c'
    rw [← AlgebraicGeometry.basicOpen_eq_bot_iff, ← Scheme.Hom.preimage_basicOpen,
      (wc_ldpi_oai_sgE_facts K (e + 2 + 1) _ _).2, eq_bot_iff]
    intro x hx
    exfalso
    exact (N6 x).1 ((Scheme.Hom.mem_preimage _).mp hx).2

  obtain ⟨π', hπK, hπbo, hπrel⟩ := wc_projK_glue_local_coords K (e + 1) D.left D.hom
    (I := Fin (e + 1 + 1))
    (fun c => (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)
    (by
      rw [eq_top_iff]
      intro x _
      obtain ⟨c, hc⟩ := (N6 x).2.1
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨c, hc⟩)
    (fun c k => ((iD ≫ Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
        (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨k.val + 1, by omega⟩))
    (by
      intro c
      exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨c,
        (wc_projK_chart_tuple_facts K (e + 2 + 1) D.left (iD ≫ Op.ι ≫ jE)
          ⟨c.val + 1, by omega⟩ ⟨c.val + 1, by omega⟩).1⟩) isUnit_one)
    (fun i j => D.left.presheaf.map (homOfLE (inf_le_right :
        (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨i.val + 1, by omega⟩ ⊓
          (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨j.val + 1, by omega⟩ ≤
          (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨j.val + 1, by omega⟩)).op
        (((iD ≫ Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) ⟨j.val + 1, by omega⟩)).hom
          (wcSgE K (e + 2 + 1) ⟨j.val + 1, by omega⟩ ⟨i.val + 1, by omega⟩)))
    (fun i j => IsUnit.of_mul_eq_one _
      (wc_projK_chart_tuple_facts K (e + 2 + 1) D.left (iD ≫ Op.ι ≫ jE)
        ⟨i.val + 1, by omega⟩ ⟨j.val + 1, by omega⟩).2.2.2)
    (fun i j k => (wc_projK_chart_tuple_facts K (e + 2 + 1) D.left (iD ≫ Op.ι ≫ jE)
        ⟨i.val + 1, by omega⟩ ⟨j.val + 1, by omega⟩).2.2.1 ⟨k.val + 1, by omega⟩)

  have hrange' : Set.range π' ⊆ Set.range jE₁ := by
    rintro _ ⟨x, rfl⟩
    apply hEall₁
    intro J hJ
    obtain ⟨c, hc⟩ := (N6 x).2.1
    exact wc_scq_cc_pi_germ K e a' b hb D.left D.hom (iD ≫ Op.ι ≫ jE) hκ π' hπK c (ht2 c)
      (fun y hy => (N6 y).2.2 _ hy) (hπbo c) (fun J L O hO hOW => hπrel c J L O hO hOW)
      x hc J hJ

  obtain ⟨π, hπ⟩ := wc_ap_reduced_factor_closed_immersion D.left E₁.left (wcProjK K (e + 1))
    π' jE₁ hrange'
  subst hπ
  refine ⟨π, ?_, fun c J => hπbo c J, fun c J L O hO hOW => hπrel c J L O hO hOW⟩
  rw [← hjEY₁, ← Category.assoc, hπK]

theorem wc_scq_cc_sec_retr (K : Type u) [Field K] (e : ℕ)
    (E₀ : Over (Spec (.of K))) (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (Op : E₀.left.Opens)
    (E₁ : Over (Spec (.of K)))
    (jE₁ : E₁.left ⟶ wcProjK K (e + 1)) (hjE₁ : IsClosedImmersion jE₁)
    (hjEY₁ : jE₁ ≫ wcProjKStr K (e + 1) = E₁.hom)
    (D : Over (Spec (.of K))) (iD : D.left ⟶ Op.toScheme)
    (σ : E₁.left ⟶ D.left) (π : D.left ⟶ E₁.left)
    (hσK : σ ≫ D.hom = E₁.hom) (hπK : π ≫ E₁.hom = D.hom)
    (hσbo : ∀ (c : Fin (e + 1 + 1)) (J : Fin (e + 2 + 1 + 1)),
        (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J ⊓ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c =
          E₁.left.basicOpen (if h : 1 ≤ J.val ∧ J.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨J.val - 1, by omega⟩)
            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))))
    (hσrel : ∀ (c : Fin (e + 1 + 1)) (J L : Fin (e + 2 + 1 + 1)) (O : E₁.left.Opens)
        (hO : O ≤ (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J)
        (hOW : O ≤ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
        (σ ≫ iD ≫ Op.ι ≫ jE).appLE (wcSgD K (e + 2 + 1) J) O hO (wcSgE K (e + 2 + 1) J L) *
          E₁.left.presheaf.map (homOfLE hOW).op (if h : 1 ≤ J.val ∧ J.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨J.val - 1, by omega⟩)
            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))) =
        E₁.left.presheaf.map (homOfLE hOW).op (if h : 1 ≤ L.val ∧ L.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨L.val - 1, by omega⟩)
            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))))
    (hπrel : ∀ (c J L : Fin (e + 1 + 1)) (O : D.left.Opens)
        (hO : O ≤ (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J)
        (hOW : O ≤ (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
        (π ≫ jE₁).appLE (wcSgD K (e + 1) J) O hO (wcSgE K (e + 1) J L) *
          D.left.presheaf.map (homOfLE hOW).op (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨J.val + 1, by omega⟩)) =
        D.left.presheaf.map (homOfLE hOW).op (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨L.val + 1, by omega⟩))) :
    σ ≫ π = 𝟙 _ :=
by
  classical
  haveI := hjE₁

  have hchart : ∀ c : Fin (e + 1 + 1),
      (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c).ι ≫ σ ≫ π ≫ jE₁ = (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c).ι ≫ jE₁ := by
    intro c
    obtain ⟨hC1, hC2, -, -⟩ := wc_projK_chart_tuple_facts K (e + 1) E₁.left jE₁ c c

    have hs : ∀ (J : Fin (e + 2 + 1 + 1)) (k : Fin (e + 1 + 1)), J.val = k.val + 1 →
        (if h : 1 ≤ J.val ∧ J.val ≤ e + 2 then
          (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨J.val - 1, by omega⟩)
          else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))) =
        (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c k) := by
      intro J k hJ
      have hc : 1 ≤ J.val ∧ J.val ≤ e + 2 := by omega
      rw [dif_pos hc]
      have key : ∀ (m : ℕ) (hm : m < e + 1 + 1), m = k.val →
          (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨m, hm⟩) =
          (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c k) := by
        rintro m hm rfl; rfl
      exact key _ _ (by omega)
    have hsc := (hs ⟨c.val + 1, by omega⟩ c rfl).trans hC1

    have hbo : (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⊓
        jE₁ ⁻¹ᵁ wcSgD K (e + 1) c = jE₁ ⁻¹ᵁ wcSgD K (e + 1) c :=
      ((hσbo c ⟨c.val + 1, by omega⟩).trans (congrArg E₁.left.basicOpen hsc)).trans
        (by rw [Scheme.basicOpen_one])
    have hUV : jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ≤
        (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ :=
      inf_eq_right.mp hbo
    have hUV' : jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ≤
        σ ⁻¹ᵁ ((iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩) :=
      fun x hx => hUV hx
    have hid : ∀ y : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
        E₁.left.presheaf.map (homOfLE (le_refl (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))).op y = y := by
      intro y
      have hop : (homOfLE (le_refl (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))).op =
          𝟙 (Opposite.op (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c)) := rfl
      rw [hop, CategoryTheory.Functor.map_id]
      first | rfl | simp

    have hpull : ∀ k : Fin (e + 1 + 1),
        (σ.appLE _ _ hUV').hom (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨k.val + 1, by omega⟩)) =
          (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c k) := by
      intro k
      have h2 := hσrel c ⟨c.val + 1, by omega⟩ ⟨k.val + 1, by omega⟩
        (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) hUV (le_refl _)
      rw [hs ⟨c.val + 1, by omega⟩ c rfl, hs ⟨k.val + 1, by omega⟩ k rfl, hC1, map_one,
        mul_one, hid] at h2
      have h3 := congrArg (fun f => f.hom (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩
        ⟨k.val + 1, by omega⟩)) (Scheme.Hom.comp_appLE σ (iD ≫ Op.ι ≫ jE) _ _ hUV)
      exact h3.symm.trans h2

    have hRg : ∀ (J L : Fin (e + 1 + 1)) (O : E₁.left.Opens)
