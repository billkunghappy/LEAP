    intro k' hk'
    refine ⟨wc_pencil_odp_shens_milnor_fibre_top_cyclic F' F'' Y n hn hn2 D ℓ hℓp hℓ k' i A Λ W' φ a hA
      x hx B Λ' W'' φ' a' hsh _ ξ hξne, ?_⟩
    rw [Nat.card_congr (Classical.choice (wc_et_zmodext_coh_equiv _ _ _))]
    exact (wc_pencil_odp_shens_milnor_fibre_top_card F' F'' Y n hn hn2 D ℓ hℓp hℓ i A Λ W' φ a hA
      x hx B Λ' W'' φ' a' hsh _ ξ hξne).2.2 k' hk'
  obtain ⟨K, hKdef⟩ : ∃ K : ℕ, K = max (max (k0 η) (k0 (D.S i (IsLocalRing.closedPoint F'')))) 1 :=
    ⟨_, rfl⟩
  have hc₀ := hc i η hηb hηne
