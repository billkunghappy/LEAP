      apply le_antisymm
      · exact iSup_le fun J => E₁.left.basicOpen_le _
      · have hb1 : jE₁ ⁻¹ᵁ wcSgD K (e + 1) c = E₁.left.basicOpen
            ((jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c c)) := by
          rw [hC1, Scheme.basicOpen_one]
        exact hb1.le.trans (le_iSup (fun J => E₁.left.basicOpen
          ((jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c J))) c)
