      simp only [Category.assoc, hjEY₁, hπK, hσK]
    exact wc_csd_proj_uniq_of_relations K (e + 1) E₁.left (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c)
      (σ ≫ π ≫ jE₁) jE₁ (fun J => (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c J))
      hK hcov hRg hC2

  have hcovE : (⨆ c : Fin (e + 1 + 1), jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup]
    have h4 : (⨆ c : Fin (e + 1 + 1), wcSgD K (e + 1) c) = ⊤ := wc_pp_basicOpen_cover K (e + 1)
    rw [h4]
    first
      | exact Scheme.Hom.preimage_top _
      | rfl
      | simp

  rw [← cancel_mono jE₁, Category.assoc, Category.id_comp]
  apply Scheme.Cover.hom_ext (E₁.left.openCoverOfIsOpenCover
    (fun c => jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) (TopologicalSpace.IsOpenCover.mk hcovE))
  refine fun (c : Fin (e + 1 + 1)) => ?_
  rw [Scheme.openCoverOfIsOpenCover_f]
  exact hchart c

theorem wc_scq_cc_rho_coords (K : Type u) [Field K] (e : ℕ)
    (E₀ : Over (Spec (.of K))) (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (Op : E₀.left.Opens)
    (E₁ : Over (Spec (.of K))) (jE₁ : E₁.left ⟶ wcProjK K (e + 1))
    (D : Over (Spec (.of K))) (iD : D.left ⟶ Op.toScheme)
    (σ : E₁.left ⟶ D.left) (π : D.left ⟶ E₁.left)
    (hσrel : ∀ (c : Fin (e + 1 + 1)) (J L : Fin (e + 2 + 1 + 1)) (O : E₁.left.Opens)
        (hO : O ≤ (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J)
        (hOW : O ≤ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
