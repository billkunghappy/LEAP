        fun h s hs => Set.image_subset_iff.mp h hs⟩
    · have h := hc2b.2
      rw [hd.1] at h
      exact h
  exact ⟨ID.subscheme, ID.subschemeι, inferInstance, hrW, hsmW, IP.subscheme,
    Scheme.IdealSheafData.inclusion hle, hjP, hrP, hsmP⟩

theorem wc_et_smooth_pair_supp_strict_exists_pow_sep : ∀ (K : Type u) [Field K] [IsSepClosed K]
