      Limits.pullback.snd g.left a.left ≫ φW.left :=
    Limits.pullback.lift_snd _ _ _
  have hφFl_fst : φFl ≫ Limits.pullback.fst g.left a.left =
      Limits.pullback.fst g.left a.left ≫ φT.left :=
    Limits.pullback.lift_fst _ _ _
  have hφF : φFl ≫ (Limits.pullback.snd g.left a.left ≫ W.hom) =
      Limits.pullback.snd g.left a.left ≫ W.hom := by
    rw [← Category.assoc, hφFl_snd, Category.assoc, MorphismProperty.Over.w φW]
  let φF : Fm ⟶ Fm := MorphismProperty.Over.homMk φFl hφF trivial
  refine ⟨Fm, rW, rT, φF, ?_, ?_, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.condition
  · exact IsPullback.of_hasPullback g.left a.left
  · apply MorphismProperty.Over.Hom.ext
    exact hφFl_snd
  · apply MorphismProperty.Over.Hom.ext
    exact hφFl_fst

theorem wc_rat_pt_nbhd_zmod_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
