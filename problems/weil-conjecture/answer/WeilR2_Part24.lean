      (∀ p : Fin (r + 2), p.val % 2 = 1 → 3 ≤ p.val →
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X p) ∈ J) →
      ∑ a, ∑ b, algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) (wcSrmCh A r a b) *
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X a) *
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X b) ∈ J := by
    intro J h0 hodd
