    · obtain ⟨t, ht⟩ := hr
      exact ⟨t, ht⟩

  have c5 : ∀ {D : Type (u+1)} [Category.{u} D] (K : GrothendieckTopology D) {I : Type (u+1)}
      [Category.{u+1} I] (F : I ⥤ Sheaf K AddCommGrpCat.{u+1}) (U : D), (⊥ : Sieve U) ∈ K U →
