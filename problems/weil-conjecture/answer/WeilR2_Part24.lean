    rw [Scheme.Opens.range_ι]
    show (W'.obj l).right.hom ((ξ ≫ φ l) x) ∈ O
    have e1 : (W'.obj l).right.hom ((ξ ≫ φ l) x) = V.hom v' := by
      calc (W'.obj l).right.hom ((ξ ≫ φ l) x)
