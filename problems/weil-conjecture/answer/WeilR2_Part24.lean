theorem wc_shens_proper_pullback_zmodext_card_eq {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f] (y : Y)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Y)
    (hA : wcHalShData y A Λ W' φ a) (m : ℕ) (hm : m ≠ 0) (q : ℕ) :
    Nat.card (wcEtZModExt (Limits.pullback f a) m q) =
      Nat.card (wcEtZModExt (Limits.pullback f (wcEtGeomPt Y y)) m q) :=
by
  classical
  obtain ⟨-, -, -, -, -, e, he, hcomp⟩ := hA
  have sq1 : IsPullback (Limits.pullback.fst f a) (Limits.pullback.snd f a) f a :=
    IsPullback.of_hasPullback f a
  have sq2 : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd f a)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (Limits.pullback.snd (Limits.pullback.snd f a)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (Limits.pullback.snd f a) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) :=
    IsPullback.of_hasPullback _ _
  have sq3 : IsPullback
      (Limits.pullback.fst
        (Limits.pullback.snd (Limits.pullback.snd f a)
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
        (Spec.map (CommRingCat.ofHom e)))
      (Limits.pullback.snd
        (Limits.pullback.snd (Limits.pullback.snd f a)
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
        (Spec.map (CommRingCat.ofHom e)))
      (Limits.pullback.snd (Limits.pullback.snd f a)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (Spec.map (CommRingCat.ofHom e)) :=
    IsPullback.of_hasPullback _ _

  obtain ⟨Di⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst (Limits.pullback.snd f a)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) m
  have hbi := wc_r2gs_hens_closed_fibre_pull_bij A (Limits.pullback f a) (Limits.pullback.snd f a)
    m hm wc_et_henselian_proper_vanishing _ _ _ sq2 Di q

  obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst
      (Limits.pullback.snd (Limits.pullback.snd f a)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (Spec.map (CommRingCat.ofHom e))) m
  have hbπ := wc_r2gs_integral_field_ext_pull_bij _ _ e he _ _ _ _ _ sq3 m hm Dπ q

  have h123 := IsPullback.paste_horiz (IsPullback.paste_horiz sq3 sq2) sq1
  have hbot : (Spec.map (CommRingCat.ofHom e) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) ≫ a = wcEtGeomPt Y y := by
    rw [Category.assoc]; exact hcomp
  rw [hbot] at h123
  have c1 := Classical.choice (wc_et_coh_iso_invariance h123.isoPullback.hom m q)
  have eP := Classical.choice (wc_et_zmodext_coh_equiv
    (Limits.pullback
      (Limits.pullback.snd (Limits.pullback.snd f a)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (Spec.map (CommRingCat.ofHom e))) m q)
  have eγ := Classical.choice (wc_et_zmodext_coh_equiv
    (Limits.pullback f (wcEtGeomPt Y y)) m q)
  rw [Nat.card_congr (Equiv.ofBijective _ hbi), Nat.card_congr (Equiv.ofBijective _ hbπ)]
  exact Nat.card_congr (eP.trans (c1.symm.trans eγ.symm))

theorem wc_pencil_odp_shens_milnor_restr_img_dichotomy (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') :
    ∃ c : ℕ, ∀ (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
        (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
      (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left),
      wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a →
      ∀ (η : (wcP1Over F'').left), η ⤳ D.S i (IsLocalRing.closedPoint F'') →
      η ≠ D.S i (IsLocalRing.closedPoint F'') →
      ∀ (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
        (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η),
      ∀ (x : ↥(Limits.pullback D.f a)), Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F'') →
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
        (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
          (Scheme.Etale.forget (Limits.pullback D.f a)))
        (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a),
      wcHalShData x B Λ' W'' φ' a' →
      ∀ (r : Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ ⟶
          Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η)),
        r ≫ Limits.pullback.fst D.f (wcEtGeomPt (wcP1Over F'').left η) =
          Limits.pullback.fst (a' ≫ Limits.pullback.snd D.f a) ξ ≫ a' ≫ Limits.pullback.fst D.f a →
        r ≫ Limits.pullback.snd D.f (wcEtGeomPt (wcP1Over F'').left η) =
          Limits.pullback.snd (a' ≫ Limits.pullback.snd D.f a) ξ →
      ∀ (Dr : wcEtPullData r (ℓ ^ k)),
        (∃ z : wcEtZModExt (Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η)) (ℓ ^ k) (n - 1),
          ℓ ^ k ∣ ℓ ^ c * addOrderOf (wcEtPull Dr (n - 1) z)) ∨
        ∀ z : wcEtZModExt (Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η)) (ℓ ^ k) (n - 1),
          ℓ ^ c • wcEtPull Dr (n - 1) z = 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓ2 : 2 ≤ ℓ := hℓp.two_le
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
