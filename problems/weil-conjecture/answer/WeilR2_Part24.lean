    rw [addOrderOf_zero, hk0, pow_zero]
  · have hk1 : 1 ≤ k := hkpos
    intro P' K' eK' eΨ' Pβ hP'
    haveI := Dg'.additive
    haveI := Dh'.additive
    haveI := Dβ.additive
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dh'.adj
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing
      (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing
