        (hOW : O ≤ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
        (σ ≫ π ≫ jE₁).appLE (wcSgD K (e + 1) J) O hO (wcSgE K (e + 1) J L) *
          E₁.left.presheaf.map (homOfLE hOW).op
            ((jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c J)) =
        E₁.left.presheaf.map (homOfLE hOW).op
            ((jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c L)) := by
      intro J L O hO hOW
      have hO₀ : O ≤ σ ⁻¹ᵁ ((iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⊓
          (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J) := fun x hx => ⟨hUV (hOW hx), hO hx⟩
      have h1 := congrArg (σ.appLE _ O hO₀).hom
        (hπrel c J L ((iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⊓
          (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J) inf_le_right inf_le_left)
      rw [map_mul] at h1
      have hres : ∀ (y : Γ(D.left,
          (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)),
          (σ.appLE _ O hO₀).hom (D.left.presheaf.map (homOfLE (inf_le_left :
            (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⊓
              (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J ≤
            (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).op y) =
          E₁.left.presheaf.map (homOfLE hOW).op ((σ.appLE _ _ hUV').hom y) := by
        intro y
        have m1 := Scheme.Hom.map_appLE σ hO₀ (homOfLE (inf_le_left :
            (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⊓
              (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J ≤
            (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).op
        have m2 := Scheme.Hom.appLE_map σ hUV' (homOfLE hOW).op
        exact congrArg (fun f => f.hom y) (m1.trans m2.symm)
      have hcomp : ∀ x, (σ.appLE _ O hO₀).hom ((π ≫ jE₁).appLE (wcSgD K (e + 1) J)
          ((iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⊓
            (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J) inf_le_right x) =
          (σ ≫ π ≫ jE₁).appLE (wcSgD K (e + 1) J) O hO x := by
        intro x
        exact congrArg (fun f => f.hom x)
          (Scheme.Hom.appLE_comp_appLE σ (π ≫ jE₁) _ _ O inf_le_right hO₀)
      rw [hres, hres, hcomp, hpull J, hpull L] at h1
      exact h1

    have hcov : (⨆ J, E₁.left.basicOpen
        ((jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c J))) =
