      ∀ z : wcEtZModExt (Limits.pullback D.f (wcEtGeomPt (wcP1Over F'').left η)) (ℓ ^ k) (n - 1),
        ℓ ^ (K + τ η + τ (D.S i (IsLocalRing.closedPoint F''))) • wcEtPull Dr (n - 1) z = 0 := by
    rcases Nat.eq_zero_or_pos k with hk0 | hk1
    · exact Or.inl ⟨0, Dvd.dvd.mul_right (pow_dvd_pow ℓ (by omega)) _⟩
    · haveI := (hM k hk1).1
      obtain ⟨e, hek, hce, himp⟩ := s5 k (hM k hk1).2 (wcEtPull Dr (n - 1))
