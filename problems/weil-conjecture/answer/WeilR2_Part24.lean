    obtain ⟨C'', i'', w'', hε⟩ := Pretriangulated.distinguished_cocone_triangle (uβ ≫ F.map a')
    let O := Triangulated.someOctahedron rfl hTβ hFZ hε
    have hsh := Pretriangulated.Triangle.shift_distinguished _ O.mem N
    rw [Pretriangulated.Triangle.shiftFunctor_eq, Pretriangulated.Triangle.shiftFunctor_obj] at hsh
    have hm3inj : ∀ f : C'' ⟶ F.obj X2, i'' ≫ f = 0 → f = 0 := by
      intro f hf
      obtain ⟨g', hg'⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hε f hf
      rw [hg', hL g', Limits.comp_zero]
    have hord : addOrderOf (F.map g ≫ F.map hhm) = ℓ ^ (j + 1) := by
      apply addOrderOf_eq_prime_pow _ hkillbh
