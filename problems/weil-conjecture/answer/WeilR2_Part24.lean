  obtain ⟨σb, hσb1, hσb2⟩ : ∃ σb : Limits.pullback Z.hom (wcCtrSK K) ⟶ Limits.pullback D.hom (wcCtrSK K),
      σb ≫ Limits.pullback.fst D.hom (wcCtrSK K) = Limits.pullback.fst Z.hom (wcCtrSK K) ≫ σ ∧
      σb ≫ Limits.pullback.snd D.hom (wcCtrSK K) = Limits.pullback.snd Z.hom (wcCtrSK K) :=
    ⟨Limits.pullback.lift _ _ (by rw [Category.assoc, hσ]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨πb, hπb1, hπb2⟩ : ∃ πb : Limits.pullback D.hom (wcCtrSK K) ⟶ Limits.pullback Z.hom (wcCtrSK K),
      πb ≫ Limits.pullback.fst Z.hom (wcCtrSK K) = Limits.pullback.fst D.hom (wcCtrSK K) ≫ π ∧
      πb ≫ Limits.pullback.snd Z.hom (wcCtrSK K) = Limits.pullback.snd D.hom (wcCtrSK K) :=
    ⟨Limits.pullback.lift _ _ (by rw [Category.assoc, hπ]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨prb, hprb1, hprb2⟩ : ∃ prb : Limits.pullback (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) ⟶
        Limits.pullback D.hom (wcCtrSK K),
      prb ≫ Limits.pullback.fst D.hom (wcCtrSK K) =
        Limits.pullback.fst (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) ≫
          Limits.pullback.fst D.hom (wcCtrA1 K) ∧
      prb ≫ Limits.pullback.snd D.hom (wcCtrSK K) =
        Limits.pullback.snd (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) :=
    ⟨Limits.pullback.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨hb, hhb1, hhb2⟩ : ∃ hb : Limits.pullback (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) ⟶
        Limits.pullback D.hom (wcCtrSK K),
      hb ≫ Limits.pullback.fst D.hom (wcCtrSK K) =
        Limits.pullback.fst (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) ≫ h ∧
      hb ≫ Limits.pullback.snd D.hom (wcCtrSK K) =
        Limits.pullback.snd (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) :=
    ⟨Limits.pullback.lift _ _ (by rw [Category.assoc, hhK]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨ib0, hib01, hib02⟩ : ∃ ib : Limits.pullback D.hom (wcCtrSK K) ⟶
        Limits.pullback (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K),
      ib ≫ Limits.pullback.fst (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) =
        Limits.pullback.fst D.hom (wcCtrSK K) ≫ i₀ ∧
      ib ≫ Limits.pullback.snd (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) =
        Limits.pullback.snd D.hom (wcCtrSK K) :=
    ⟨Limits.pullback.lift _ _ (by
        rw [Category.assoc, reassoc_of% hi₀f]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨ib1, hib11, hib12⟩ : ∃ ib : Limits.pullback D.hom (wcCtrSK K) ⟶
        Limits.pullback (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K),
      ib ≫ Limits.pullback.fst (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) =
        Limits.pullback.fst D.hom (wcCtrSK K) ≫ i₁ ∧
      ib ≫ Limits.pullback.snd (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K) =
        Limits.pullback.snd D.hom (wcCtrSK K) :=
    ⟨Limits.pullback.lift _ _ (by
        rw [Category.assoc, reassoc_of% hi₁f]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have G2 : ib0 ≫ prb = 𝟙 _ := by
    apply Limits.pullback.hom_ext <;>
      simp only [Category.assoc, Category.id_comp, Category.comp_id, hprb1, hprb2,
        reassoc_of% hib01, hib02, hi₀f]
  have G3 : ib1 ≫ prb = 𝟙 _ := by
    apply Limits.pullback.hom_ext <;>
      simp only [Category.assoc, Category.id_comp, Category.comp_id, hprb1, hprb2,
        reassoc_of% hib11, hib12, hi₁f]
  have G4 : ib1 ≫ hb = 𝟙 _ := by
    apply Limits.pullback.hom_ext <;>
      simp only [Category.assoc, Category.id_comp, Category.comp_id, hhb1, hhb2,
        reassoc_of% hib11, hib12, hh₁]
  have G5 : ib0 ≫ hb = πb ≫ σb := by
    apply Limits.pullback.hom_ext <;>
      simp only [Category.assoc, hhb1, hhb2, reassoc_of% hib01, hib02, hh₀, hσb1, hσb2,
        reassoc_of% hπb1, hπb2]
  have G6gen : ∀ (FD : Limits.pullback D.hom (wcCtrSK K) ⟶ Limits.pullback D.hom (wcCtrSK K))
      (FZ : Limits.pullback Z.hom (wcCtrSK K) ⟶ Limits.pullback Z.hom (wcCtrSK K))
      (φK : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of (AlgebraicClosure K))),
      FD ≫ Limits.pullback.fst D.hom (wcCtrSK K) = Limits.pullback.fst D.hom (wcCtrSK K) →
      FD ≫ Limits.pullback.snd D.hom (wcCtrSK K) = Limits.pullback.snd D.hom (wcCtrSK K) ≫ φK →
      FZ ≫ Limits.pullback.fst Z.hom (wcCtrSK K) = Limits.pullback.fst Z.hom (wcCtrSK K) →
      FZ ≫ Limits.pullback.snd Z.hom (wcCtrSK K) = Limits.pullback.snd Z.hom (wcCtrSK K) ≫ φK →
      σb ≫ FD = FZ ≫ σb := by
    intro FD FZ φK h1 h2 h3 h4
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, h1, hσb1, reassoc_of% h3]
    · simp only [Category.assoc]
      rw [h2, reassoc_of% hσb2, hσb2, h4]
  obtain ⟨φK, hFD2, hFZ2⟩ : ∃ φK : Spec (.of (AlgebraicClosure K)) ⟶ Spec (.of (AlgebraicClosure K)),
      (wcGeomFrob K D hD).left ≫ Limits.pullback.snd D.hom (wcCtrSK K) =
        Limits.pullback.snd D.hom (wcCtrSK K) ≫ φK ∧
      (wcGeomFrob K Z hZ).left ≫ Limits.pullback.snd Z.hom (wcCtrSK K) =
        Limits.pullback.snd Z.hom (wcCtrSK K) ≫ φK :=
    ⟨_, Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hFD1 : (wcGeomFrob K D hD).left ≫ Limits.pullback.fst D.hom (wcCtrSK K) =
      Limits.pullback.fst D.hom (wcCtrSK K) :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hFZ1 : (wcGeomFrob K Z hZ).left ≫ Limits.pullback.fst Z.hom (wcCtrSK K) =
      Limits.pullback.fst Z.hom (wcCtrSK K) :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have G6 : σb ≫ (wcGeomFrob K D hD).left = (wcGeomFrob K Z hZ).left ≫ σb :=
    G6gen _ _ φK hFD1 hFD2 hFZ1 hFZ2

  obtain ⟨Dσ, hDσ⟩ := wc_zmod_pull_data_exists σb (ℓ ^ k)
  obtain ⟨Dπ, hDπ⟩ := wc_zmod_pull_data_exists πb (ℓ ^ k)
  obtain ⟨Dp, hDp⟩ := wc_zmod_pull_data_exists prb (ℓ ^ k)
  obtain ⟨Dh, hDh⟩ := wc_zmod_pull_data_exists hb (ℓ ^ k)
  obtain ⟨D0, hD0⟩ := wc_zmod_pull_data_exists ib0 (ℓ ^ k)
  obtain ⟨D1, hD1⟩ := wc_zmod_pull_data_exists ib1 (ℓ ^ k)
  obtain ⟨Did, hDid⟩ := wc_zmod_pull_data_exists (𝟙 (Limits.pullback D.hom (wcCtrSK K))) (ℓ ^ k)
  obtain ⟨Dk0, hDk0⟩ := wc_zmod_pull_data_exists (πb ≫ σb) (ℓ ^ k)
  obtain ⟨DFD, hDFD⟩ := wc_zmod_pull_data_exists (wcGeomFrob K D hD).left (ℓ ^ k)
  obtain ⟨DFZ, hDFZ⟩ := wc_zmod_pull_data_exists (wcGeomFrob K Z hZ).left (ℓ ^ k)
  obtain ⟨DkF, hDkF⟩ := wc_zmod_pull_data_exists (σb ≫ (wcGeomFrob K D hD).left) (ℓ ^ k)

  have hsurj : Function.Surjective (wcZModPull Dp j) := by
    obtain ⟨e, he⟩ := wc_poly_bc_affine_line_iso K D.hom (wcCtrSK K) prb hprb1 hprb2
    have G7 : e.inv ≫ (AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback D.hom (wcCtrSK K)) ↘
        Limits.pullback D.hom (wcCtrSK K)) = prb := by
      rw [Iso.inv_comp_eq]; exact he.symm
    obtain ⟨DA, hDA⟩ := wc_zmod_pull_data_exists
      (AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback D.hom (wcCtrSK K)) ↘ Limits.pullback D.hom (wcCtrSK K))
      (ℓ ^ k)
    have hA : Function.Bijective (wcZModPull DA j) := by
      haveI := DA.additive
      haveI := DA.presLim
      haveI := DA.presColim
      letI : (@SheafOfModules.pushforward _ _ _ _ _ _
          (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback D.hom (wcCtrSK K)) ↘
            Limits.pullback D.hom (wcCtrSK K))) _ _ DA.cont DA.φ).Additive :=
        @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ DA.adj DA.additive
      have hunit : IsIso (DA.adj.unit.app
          (SheafOfModules.unit (wcZModRingSheaf (Limits.pullback D.hom (wcCtrSK K)) (ℓ ^ k)))) := by
        have h' : IsIso (wcZModSuppUnitMap DA) := wc_zmod_A1_proj_supp_unit_iso (ℓ ^ k) DA hDA
        exact @IsIso.of_isIso_comp_right _ _ _ _ _
          (DA.adj.unit.app
            (SheafOfModules.unit (wcZModRingSheaf (Limits.pullback D.hom (wcCtrSK K)) (ℓ ^ k))))
          ((@SheafOfModules.pushforward _ _ _ _ _ _
            (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback D.hom (wcCtrSK K)) ↘
              Limits.pullback D.hom (wcCtrSK K))) _ _ DA.cont DA.φ).map DA.μ.hom)
          inferInstance h'
      haveI := sheafOfModules_enoughInjectives
        (Scheme.ProEt.topology (AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback D.hom (wcCtrSK K))))
        (wcZModRingSheaf (AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback D.hom (wcCtrSK K))) (ℓ ^ k))
      have key := wc_ext_map_bijective_of_degenerate_leray DA.Φ
        (@SheafOfModules.pushforward _ _ _ _ _ _
          (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback D.hom (wcCtrSK K)) ↘
            Limits.pullback D.hom (wcCtrSK K))) _ _ DA.cont DA.φ)
        DA.adj (SheafOfModules.unit (wcZModRingSheaf (Limits.pullback D.hom (wcCtrSK K)) (ℓ ^ k))) _
        DA.μ hunit (InjectiveResolution.of _)
        (fun q hq => wc_zmod_A1_proj_higher_vanish (AlgebraicClosure K) ℓ hℓK
          (Limits.pullback.snd D.hom (wcCtrSK K)) k DA hDA _ q hq) j
      exact key
    intro z
    obtain ⟨Deh, hDeh⟩ := wc_zmod_pull_data_exists e.hom (ℓ ^ k)
    obtain ⟨Dei, hDei⟩ := wc_zmod_pull_data_exists e.inv (ℓ ^ k)
    obtain ⟨DidP, hDidP⟩ := wc_zmod_pull_data_exists
      (𝟙 (Limits.pullback (Limits.pullback.fst D.hom (wcCtrA1 K) ≫ D.hom) (wcCtrSK K))) (ℓ ^ k)
    have ez := wc_zmod_pull_comp e.hom e.inv (𝟙 _) e.inv_hom_id Deh hDeh Dei hDei DidP hDidP j z
    rw [wc_zmod_pull_id _ rfl DidP hDidP] at ez
    obtain ⟨y, hy⟩ := hA.2 (wcZModPull Deh j z)
    refine ⟨y, ?_⟩
    rw [wc_zmod_pull_comp _ e.inv prb G7 DA hDA Dei hDei Dp hDp j y, hy, ← ez]

  have hinj : Function.Injective (wcZModPull Dσ j) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨w, hw⟩ := hsurj (wcZModPull Dh j x)
    have hw0 : w = 0 := by
      have e1 := wc_zmod_pull_comp hb ib0 (πb ≫ σb) G5 Dh hDh D0 hD0 Dk0 hDk0 j x
      have e2 := wc_zmod_pull_comp σb πb (πb ≫ σb) rfl Dσ hDσ Dπ hDπ Dk0 hDk0 j x
      have e3 := wc_zmod_pull_comp prb ib0 (𝟙 _) G2 Dp hDp D0 hD0 Did hDid j w
      rw [wc_zmod_pull_id _ rfl Did hDid] at e3
      rw [e3, hw, ← e1, e2, hx, map_zero]
    rw [← wc_zmod_pull_id _ rfl Did hDid j x,
      wc_zmod_pull_comp hb ib1 (𝟙 _) G4 Dh hDh D1 hD1 Did hDid j x, ← hw,
      ← wc_zmod_pull_comp prb ib1 (𝟙 _) G3 Dp hDp D1 hD1 Did hDid j w,
      wc_zmod_pull_id _ rfl Did hDid, hw0]

  let ED := AddEquiv.ofBijective (Φ D.left (wcGeomPoint K D hD)) (hbij _ _)
  have hED : ∀ y, ED.symm (Φ D.left (wcGeomPoint K D hD) y) = y := fun y => ED.symm_apply_apply y
  refine ⟨(Φ Z.left (wcGeomPoint K Z hZ)).comp
    ((wcZModPull Dσ j).comp ED.symm.toAddMonoidHom), ?_, ?_⟩
  · exact (hbij _ _).1.comp (hinj.comp ED.symm.injective)
  · intro x
    obtain ⟨y, rfl⟩ := (hbij D.left (wcGeomPoint K D hD)).2 x
    have e1 : wcCohGFrob K D hD (wcContSheaf D.left (ZMod (ℓ ^ k))) j
        (Φ D.left (wcGeomPoint K D hD) y) =
        Φ D.left (wcGeomPoint K D hD) (wcZModPull DFD j y) :=
      hnat D.left (wcGeomFrob K D hD) DFD hDFD y
    have e2 : wcCohGFrob K Z hZ (wcContSheaf Z.left (ZMod (ℓ ^ k))) j
        (Φ Z.left (wcGeomPoint K Z hZ) (wcZModPull Dσ j y)) =
        Φ Z.left (wcGeomPoint K Z hZ) (wcZModPull DFZ j (wcZModPull Dσ j y)) :=
      hnat Z.left (wcGeomFrob K Z hZ) DFZ hDFZ _
    have hq : wcZModPull Dσ j (wcZModPull DFD j y) = wcZModPull DFZ j (wcZModPull Dσ j y) :=
      (wc_zmod_pull_comp _ _ _ rfl DFD hDFD Dσ hDσ DkF hDkF j y).symm.trans
        (wc_zmod_pull_comp _ _ _ G6.symm Dσ hDσ DFZ hDFZ DkF hDkF j y)
    change Φ Z.left (wcGeomPoint K Z hZ) (wcZModPull Dσ j (ED.symm
        (wcCohGFrob K D hD (wcContSheaf D.left (ZMod (ℓ ^ k))) j
          (Φ D.left (wcGeomPoint K D hD) y)))) =
      wcCohGFrob K Z hZ (wcContSheaf Z.left (ZMod (ℓ ^ k))) j
        (Φ Z.left (wcGeomPoint K Z hZ) (wcZModPull Dσ j (ED.symm
          (Φ D.left (wcGeomPoint K D hD) y))))
    rw [e1, hED, hED, e2, hq]

theorem wc_split_quadric_cone_step (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ¬ ℓ ∣ Nat.card K) (e : ℕ) (he : Even e)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (ha' : (Matrix.of a' + (Matrix.of a').transpose).det ≠ 0)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K))) [IsProper E₀.hom] [SmoothOfRelativeDimension (e + 2) E₀.hom]
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (e + 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c),
      wcLdpGerm K (e + 2 + 1) jE (wcLdpQuad K (e + 2 + 1) b) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (E₁ : Over (Spec (.of K))) [IsProper E₁.hom] [SmoothOfRelativeDimension e E₁.hom]
    (jE₁ : E₁.left ⟶ wcProjK K (e + 1)) (hjE₁ : IsClosedImmersion jE₁)
    (hjEY₁ : jE₁ ≫ wcProjKStr K (e + 1) = E₁.hom)
    (hEG₁ : ∀ (x : E₁.left) (c : Fin (e + 1 + 1)) (hx : x ∈ jE₁ ⁻¹ᵁ wcSgD K (e + 1) c),
      wcLdpGerm K (e + 1) jE₁ (wcLdpQuad K (e + 1) a') c x hx ∈
        IsLocalRing.maximalIdeal (E₁.left.presheaf.stalk x))
    (hEall₁ : ∀ p : wcProjK K (e + 1), (∀ (c : Fin (e + 1 + 1)) (hp : p ∈ wcSgD K (e + 1) c),
        ((wcProjK K (e + 1)).presheaf.germ (wcSgD K (e + 1) c) p hp).hom
            (wcLdpSec K (e + 1) (wcLdpQuad K (e + 1) a') c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 1)).presheaf.stalk p)) → p ∈ Set.range jE₁)
    (hE₁ : WeaklyEtale (Limits.pullback.fst E₁.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (k : ℕ) :
    ∃ ι : wcCohG K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2) →+
        wcCohG K E₁ hE₁ (wcContSheaf E₁.left (ZMod (ℓ ^ k))) e,
      Function.Injective ι ∧
      ∀ x, ι (wcCohGFrob K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (e + 2) x) =
        Nat.card K • wcCohGFrob K E₁ hE₁ (wcContSheaf E₁.left (ZMod (ℓ ^ k))) e (ι x) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ φo : wcOpenRestr S O Tc ⟶ wcOpenRestr S O Tc,
        φo ≫ wcOpenRestrIncl S O Tc = wcOpenRestrIncl S O Tc ≫ φ := by
    intro S O Tc φ
    have w : φ.left ≫ Tc.hom = Tc.hom := MorphismProperty.Over.w φ
    have hc : Limits.pullback.fst O.ι Tc.hom ≫ O.ι =
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) ≫ Tc.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc ≫ (Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom) =
        Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ Tc.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _

  have C1 : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology E₀.left) AddCommGrpCat.{u+1}}
      (f : X ⟶ Y) (g : Y ⟶ Z) (h : X ⟶ Z) (_hfg : f ≫ g = h) [Mono g],
      ∃ (a : Limits.cokernel f ⟶ Limits.cokernel h) (b : Limits.cokernel h ⟶ Limits.cokernel g)
        (w : a ≫ b = 0),
        Limits.cokernel.π f ≫ a = g ≫ Limits.cokernel.π h ∧
        Limits.cokernel.π h ≫ b = Limits.cokernel.π g ∧
        (ShortComplex.mk a b w).ShortExact := by
    intro X Y Z f g h hfg _
    subst hfg
    have ha : f ≫ g ≫ Limits.cokernel.π (f ≫ g) = 0 := by
      rw [← Category.assoc, Limits.cokernel.condition]
    have hb : (f ≫ g) ≫ Limits.cokernel.π g = 0 := by
      rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    obtain ⟨a, hA⟩ : ∃ a : Limits.cokernel f ⟶ Limits.cokernel (f ≫ g),
        Limits.cokernel.π f ≫ a = g ≫ Limits.cokernel.π (f ≫ g) :=
      ⟨_, Limits.cokernel.π_desc _ _ ha⟩
    obtain ⟨b, hB⟩ : ∃ b : Limits.cokernel (f ≫ g) ⟶ Limits.cokernel g,
        Limits.cokernel.π (f ≫ g) ≫ b = Limits.cokernel.π g :=
      ⟨_, Limits.cokernel.π_desc _ _ hb⟩
    have w : a ≫ b = 0 := by
      rw [← cancel_epi (Limits.cokernel.π f), ← Category.assoc, hA, Category.assoc, hB,
        Limits.cokernel.condition, Limits.comp_zero]
    have : Epi b := epi_of_epi_fac hB
    have : Mono a := by
      apply Preadditive.mono_of_cancel_zero
      intro P t ht
      obtain ⟨P₁, e₁, he₁, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π f) t
      have h1 : (y ≫ g) ≫ Limits.cokernel.π (f ≫ g) = 0 := by
        rw [Category.assoc, ← hA, ← Category.assoc, ← hy, Category.assoc, ht, Limits.comp_zero]
      obtain ⟨P₂, e₂, he₂, x, hx⟩ :=
        (ShortComplex.exact_cokernel (f ≫ g)).exact_up_to_refinements (y ≫ g) h1
      have h2 : e₂ ≫ y = x ≫ f := by
        rw [← cancel_mono g]
        simpa only [Category.assoc] using hx
      rw [← cancel_epi (e₂ ≫ e₁), Limits.comp_zero, Category.assoc, hy, ← Category.assoc, h2,
        Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    refine ⟨a, b, w, hA, hB, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro P t ht
    obtain ⟨P₁, e₁, he₁, z, hz⟩ :=
      surjective_up_to_refinements_of_epi (Limits.cokernel.π (f ≫ g)) t
    have h1 : z ≫ Limits.cokernel.π g = 0 := by
      dsimp at ht
      rw [← hB, ← Category.assoc, ← hz, Category.assoc, ht, Limits.comp_zero]
    obtain ⟨P₂, e₂, he₂, y, hy⟩ := (ShortComplex.exact_cokernel g).exact_up_to_refinements z h1
    refine ⟨P₂, e₂ ≫ e₁, epi_comp _ _, y ≫ Limits.cokernel.π f, ?_⟩
    dsimp at hy ⊢
    rw [Category.assoc, hz, ← Category.assoc, hy]
    simp only [Category.assoc, hA]

  obtain ⟨U, hU⟩ : ∃ U : E₀.left.Opens,
      U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)) := ⟨_, rfl⟩
  obtain ⟨Op, hOp⟩ : ∃ Op : E₀.left.Opens,
      Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ := ⟨_, rfl⟩
  obtain ⟨hUO, D, hDsm, iD, hiD, hiDE, hrange⟩ :=
    wc_scq_cone_divisor K e a' ha' b hb E₀ jE hjE hjEY hEG hEall U Op hU hOp
  haveI := hDsm
  obtain ⟨s, hs, hOs⟩ := wc_scq_vertex_rational_point K e a' b hb E₀ jE hjE hjEY hEall Op hOp
  obtain ⟨φ, hφ⟩ := wc_scq_affine_cell_iso K e a' ha' b hb E₀ jE hjE hjEY hEG hEall U hU
  obtain ⟨σ, π, h, i₀, i₁, hσ, hπ, hσπ, hhK, hi₀f, hi₀s, hi₁f, hi₁s, hh₀, hh₁⟩ :=
    wc_scq_cone_contraction K e a' ha' b hb E₀ jE hjE hjEY hEG hEall E₁ jE₁ hjE₁ hjEY₁ hEG₁
      hEall₁ U Op hU hOp D iD hiD hiDE hrange
  have hD : WeaklyEtale (Limits.pullback.fst D.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure K)

  have hc : (Limits.pullback.fst U.ι (wcGeomPoint K E₀ hE).hom ≫ E₀.left.homOfLE hUO) ≫ Op.ι =
      Limits.pullback.snd U.ι (wcGeomPoint K E₀ hE).hom ≫ (wcGeomPoint K E₀ hE).hom := by
    rw [Category.assoc, Scheme.homOfLE_ι, Limits.pullback.condition]
  have hw : Limits.pullback.lift _ _ hc ≫ (Limits.pullback.snd Op.ι (wcGeomPoint K E₀ hE).hom ≫
      (wcGeomPoint K E₀ hE).hom) =
      Limits.pullback.snd U.ι (wcGeomPoint K E₀ hE).hom ≫ (wcGeomPoint K E₀ hE).hom := by
    rw [Limits.pullback.lift_snd_assoc]
  obtain ⟨jUO, hjUO⟩ : ∃ jUO : wcOpenRestr E₀.left U (wcGeomPoint K E₀ hE) ⟶
      wcOpenRestr E₀.left Op (wcGeomPoint K E₀ hE),
      jUO ≫ wcOpenRestrIncl E₀.left Op (wcGeomPoint K E₀ hE) =
