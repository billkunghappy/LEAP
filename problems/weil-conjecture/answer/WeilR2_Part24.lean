theorem wc_etqm_srdmv_sing_locus (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (e : Fin n → (Spec (.of (wcQuadModelRing A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X'))
    (he_open : ∀ k, IsOpenImmersion (e k)) (he_cov : ∀ x : X', ∃ k y, e k y = x)
    (he_str : ∀ k, e k ≫ β ≫ wcQuadModelStr A n π c = wcQuadModelStr A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (hE : ∀ k y, (∀ p : Fin n, p.val % 2 = 0 → Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal ((e k ≫ β) y)) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y) :
    {z : ↥(Limits.pullback f' (wcQmSp A)) | ¬ ∃ U : (Limits.pullback f' (wcQmSp A)).Opens, z ∈ U ∧
        Smooth (U.ι ≫ Limits.pullback.snd f' (wcQmSp A))} =
      {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n, p.val % 2 = 0 →
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} ∩
        closure {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n, p.val % 2 = 0 →
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)}ᶜ :=
by
  obtain ⟨r, rfl⟩ : ∃ r, n = r + 2 := ⟨n - 2, by omega⟩
  have heK : ∀ k, e k ≫ f' = wcQuadModelStr A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    intro k
    rw [← hf']
    exact he_str k
  set T : Set ↥(Limits.pullback f' (wcQmSp A)) := {z | ∀ p : Fin (r + 2), p.val % 2 = 0 →
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} with hTdef
  have hT : ∀ k (z' : ↥(Limits.pullback f' (wcQmSp A))) y',
      Limits.pullback.fst f' (wcQmSp A) z' = e k y' →
        (z' ∈ T ↔ Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y') := by
    intro k z' y' hz
    have h1 : (Limits.pullback.fst f' (wcQmSp A) ≫ β) z' = (e k ≫ β) y' := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hz]
    show (∀ p : Fin (r + 2), p.val % 2 = 0 →
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z')) ↔ _
    rw [h1]
    exact hE k y'
  ext z
  obtain ⟨k, y, hy⟩ := he_cov (Limits.pullback.fst f' (wcQmSp A) z)
  haveI := he_open k
  have hz : Limits.pullback.fst f' (wcQmSp A) z = e k y := hy.symm
  have iT := hT k z y hz
  have iC := wc_srdci_chart_closure_iff A r π hπ X' f' (e k) (heK k) T (hT k) z y hz
  rw [Set.mem_inter_iff, iT, iC]
  constructor
  · intro hS
    by_contra hneg
    rw [not_and_or] at hneg
    exact hS (wc_srdci_offdouble_fibre_smooth A r π X' f' (e k) (heK k) z y hz hneg)
  · rintro ⟨h0, h1⟩
    exact wc_srdci_double_fibre_not_smooth A r π X' f' (e k) (heK k) z y hz h0 h1

theorem wc_srdtp_shift_ext_equiv {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C] [HasExt C]
    (T T' M M' : C) (eT : T ≅ T') (eM : M ≅ M') (q : ℕ) :
    (∀ (a b : ℤ), a + b = (q : ℤ) →
      Nonempty ((DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj T) ⟶
        ((DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj M))⟦a⟧)⟦b⟧) ≃+
        Abelian.Ext T' M' q)) ∧
    (∀ (a b d : ℤ), a + b + d = (q : ℤ) →
      Nonempty ((DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj T) ⟶
        (((DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj M))⟦a⟧)⟦b⟧)⟦d⟧) ≃+
        Abelian.Ext T' M' q)) :=
by
  have E : ∀ {X X' Y Y' : DerivedCategory C} (_ : X ≅ X') (_ : Y ≅ Y'),
      (X ⟶ Y) ≃+ (X' ⟶ Y') := fun α β =>
    AddEquiv.mk' (α.homCongr β) (fun f g => by
      simp only [Iso.homCongr_apply, Preadditive.add_comp, Preadditive.comp_add])
  have αT : DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj T) ≅
      (DerivedCategory.singleFunctor C 0).obj T' :=
    ((DerivedCategory.singleFunctorIsoCompQ C 0).app T).symm ≪≫
      (DerivedCategory.singleFunctor C 0).mapIso eT
  have αM : DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj M) ≅
      (DerivedCategory.singleFunctor C 0).obj M' :=
    ((DerivedCategory.singleFunctorIsoCompQ C 0).app M).symm ≪≫
      (DerivedCategory.singleFunctor C 0).mapIso eM
  constructor
  · intro a b hab
    have β : ((DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj M))⟦a⟧)⟦b⟧ ≅
        ((DerivedCategory.singleFunctor C 0).obj M')⟦(q : ℤ)⟧ :=
      ((shiftFunctorAdd' (DerivedCategory C) a b (q : ℤ) hab).app _).symm ≪≫
        (shiftFunctor (DerivedCategory C) (q : ℤ)).mapIso αM
    exact ⟨(E αT β).trans (Abelian.Ext.homAddEquiv (X := T') (Y := M') (n := q)).symm⟩
  · intro a b d habd
    have β : (((DerivedCategory.Q.obj ((HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj M))⟦a⟧)⟦b⟧)⟦d⟧ ≅
        ((DerivedCategory.singleFunctor C 0).obj M')⟦(q : ℤ)⟧ :=
      (shiftFunctor (DerivedCategory C) d).mapIso
          ((shiftFunctorAdd' (DerivedCategory C) a b (a + b) rfl).app _).symm ≪≫
        ((shiftFunctorAdd' (DerivedCategory C) (a + b) d (q : ℤ) habd).app _).symm ≪≫
        (shiftFunctor (DerivedCategory C) (q : ℤ)).mapIso αM
    exact ⟨(E αT β).trans (Abelian.Ext.homAddEquiv (X := T') (Y := M') (n := q)).symm⟩

theorem wc_srdtp_supp_transfer_equiv {S W Q : Scheme.{u}} (iW : W ⟶ S) [IsClosedImmersion iW]
    (jQ : Q ⟶ W) [IsClosedImmersion jQ] (m : ℕ) (Ew : wcEtPullData iW m)
    (DQ : wcEtPullData (jQ ≫ iW) m) (DQ' : wcEtPullData jQ m) (q : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S m)) := HasExt.standard _
    Nonempty (Abelian.Ext (wcEtSuppObj DQ) (wcEtSuppObj Ew) q ≃+ wcEtSuppExt DQ' q) :=
by
  letI hS : HasExt (SheafOfModules.{u+1} (wcEtZModRing S m)) := HasExt.standard _
  letI hW : HasExt (SheafOfModules.{u+1} (wcEtZModRing W m)) := HasExt.standard _
  haveI := Ew.additive
  haveI := Ew.presLim
  haveI := Ew.presColim
  haveI := Ew.cont
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange iW) _ _ Ew.cont Ew.φ
  haveI : P.Additive := Ew.adj.right_adjoint_additive
  haveI : Limits.PreservesLimitsOfSize.{0, 0} P := Ew.adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits P := inferInstance
  haveI : Limits.PreservesFiniteColimits P := wc_et_finite_push_modules_exact iW m Ew
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing W m)) :=
    sheafOfModules_enoughInjectives _ _
  have hP : IsPullback (𝟙 Q) jQ (jQ ≫ iW) iW :=
    IsPullback.of_horiz_isIso_mono ⟨by simp⟩
  obtain ⟨κ⟩ := wc_etqm_srd_fibre_supp (jQ ≫ iW) iW jQ (𝟙 Q) hP m DQ Ew DQ'
  let U := SheafOfModules.unit (wcEtZModRing W m)
  let δ := wcEtSuppObj DQ
  let ψ : Abelian.Ext (Ew.Φ.obj δ) U q →+ Abelian.Ext δ (P.obj U) q :=
    AddMonoidHom.mk' (fun e => (Abelian.Ext.mk₀ (Ew.adj.unit.app δ)).comp
      (Abelian.Ext.mapExactFunctor P e) (zero_add q))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  have hbij : Function.Bijective ψ := wc_ext_adjoint_transfer Ew.Φ P Ew.adj δ U q
  let Ψ := AddEquiv.ofBijective ψ hbij
  let K : Abelian.Ext (Ew.Φ.obj δ) U q ≃+ Abelian.Ext (wcEtSuppObj DQ') U q :=
    { toFun := fun x => (Abelian.Ext.mk₀ κ.inv).comp x (zero_add q)
      invFun := fun y => (Abelian.Ext.mk₀ κ.hom).comp y (zero_add q)
      left_inv := fun x => by
        dsimp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        dsimp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun a b => Abelian.Ext.comp_add _ _ _ _ }
  exact ⟨Ψ.symm.trans K⟩

theorem wc_etqm_srdtp_double_smooth (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (e : Fin n → (Spec (.of (wcQuadModelRing A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X'))
    (he_open : ∀ k, IsOpenImmersion (e k)) (he_cov : ∀ x : X', ∃ k y, e k y = x)
    (he_str : ∀ k, e k ≫ β ≫ wcQuadModelStr A n π c = wcQuadModelStr A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (hE : ∀ k y, (∀ p : Fin n, p.val % 2 = 0 → Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal ((e k ≫ β) y)) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y)
    (hP : ∀ k y, (∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
          PrimeSpectrum.asIdeal ((e k ≫ β) y)) ↔
        (Ideal.Quotient.mk (wcQuadModelIdeal A n π
            (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          Ideal.Quotient.mk (wcQuadModelIdeal A n π
            (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal y ∧
          ∀ p : Fin n, p.val % 2 = 1 → 3 ≤ p.val → Ideal.Quotient.mk (wcQuadModelIdeal A n π
            (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal y)) :
    ∃ (W : Scheme.{u}) (iW : W ⟶ Limits.pullback f' (wcQmSp A)) (_ : IsClosedImmersion iW),
      Set.range iW = {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n, p.val % 2 = 0 →
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} ∩
        closure {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n, p.val % 2 = 0 →
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)}ᶜ ∧
      SmoothOfRelativeDimension (n - 2) (iW ≫ Limits.pullback.snd f' (wcQmSp A)) ∧
      ∃ (PW : Scheme.{u}) (jP : PW ⟶ W) (_ : IsClosedImmersion jP),
        Set.range (jP ≫ iW) = {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n,
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} ∧
        SmoothOfRelativeDimension (n - 2 - (n / 2 - 1))
          (jP ≫ iW ≫ Limits.pullback.snd f' (wcQmSp A)) :=
by
  classical
  have c1 (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ) (hn : 2 ≤ n) (π : A)
      (hπ : π ∈ IsLocalRing.maximalIdeal A) :
      ∃ q : wcQuadModelRing A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →+*
        (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin n) * MvPolynomial.X (⟨1, by omega⟩ : Fin n)}),
        (∀ p : Fin n, q (Ideal.Quotient.mk (wcQuadModelIdeal A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p)) = Ideal.Quotient.mk _ (MvPolynomial.X p)) ∧
        IsPullback (Spec.map (CommRingCat.ofHom q))
          (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A) (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin n) * MvPolynomial.X (⟨1, by omega⟩ : Fin n)}))))
          (wcQuadModelStr A n π (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (wcQmSp A) := by
    classical
    set c₀ : Matrix (Fin n) (Fin n) A :=
      Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0 with hc₀
    set i0 : Fin n := ⟨0, by omega⟩ with hi0
    set i1 : Fin n := ⟨1, by omega⟩ with hi1
    set I₀ := wcQuadModelIdeal A n π c₀ with hI₀
    set J₀ : Ideal (MvPolynomial (Fin n) (IsLocalRing.ResidueField A)) :=
      Ideal.span {MvPolynomial.X i0 * MvPolynomial.X i1} with hJ₀
    have hsum : (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) = MvPolynomial.X i0 * MvPolynomial.X i1 := by
      rw [Finset.sum_eq_single i0]
      · rw [Finset.sum_eq_single i1]
        · simp [c₀, i0, i1]
        · intro b _ hb
          have : ¬ (b.val = 1) := fun h => hb (Fin.ext h)
          simp [c₀, i0, this]
        · simp
      · intro b _ hb
        apply Finset.sum_eq_zero
        intro q _
        have : ¬ (b.val = 0) := fun h => hb (Fin.ext h)
        simp [c₀, this]
      · simp
    have hgen : I₀ = Ideal.span {MvPolynomial.X i0 * MvPolynomial.X i1 - MvPolynomial.C π} := by
      rw [hI₀, wcQuadModelIdeal, hsum]
    have hres : IsLocalRing.residue A π = 0 := (IsLocalRing.residue_eq_zero_iff π).mpr hπ
    let f0 : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ J₀ :=
      (Ideal.Quotient.mk J₀).comp (MvPolynomial.map (IsLocalRing.residue A))
    have hf0 : ∀ a ∈ I₀, f0 a = 0 := by
      intro a ha
      rw [hgen, Ideal.mem_span_singleton'] at ha
      obtain ⟨r, rfl⟩ := ha
      rw [map_mul]
      have : f0 (MvPolynomial.X i0 * MvPolynomial.X i1 - MvPolynomial.C π) = 0 := by
        show Ideal.Quotient.mk J₀ (MvPolynomial.map (IsLocalRing.residue A)
          (MvPolynomial.X i0 * MvPolynomial.X i1 - MvPolynomial.C π)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X,
          MvPolynomial.map_C, hres, map_zero, sub_zero]
        exact Ideal.mem_span_singleton_self _
      rw [this, mul_zero]
    let q := Ideal.Quotient.lift I₀ f0 hf0
    have hqX : ∀ p : Fin n, q (Ideal.Quotient.mk I₀ (MvPolynomial.X p)) =
        Ideal.Quotient.mk J₀ (MvPolynomial.X p) := by
      intro p
      show f0 (MvPolynomial.X p) = _
      show Ideal.Quotient.mk J₀ (MvPolynomial.map (IsLocalRing.residue A) (MvPolynomial.X p)) = _
      rw [MvPolynomial.map_X]
    have hqC : ∀ a : A, q (Ideal.Quotient.mk I₀ (MvPolynomial.C a)) =
        Ideal.Quotient.mk J₀ (MvPolynomial.C (IsLocalRing.residue A a)) := by
      intro a
      show Ideal.Quotient.mk J₀ (MvPolynomial.map (IsLocalRing.residue A) (MvPolynomial.C a)) = _
      rw [MvPolynomial.map_C]
    refine ⟨q, hqX, ?_⟩
    apply isPullback_SpecMap_of_isPushout
    have hcomm : CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c₀)) ≫ CommRingCat.ofHom q =
        CommRingCat.ofHom (IsLocalRing.residue A) ≫
          CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
            (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ J₀)) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact hqC a
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ _ hcomm) ?_
    have hmkC : ∀ a : A, Ideal.Quotient.mk I₀ (MvPolynomial.C a) =
        algebraMap A (wcQuadModelRing A n π c₀) a := fun a => rfl
    have hX01 : Ideal.Quotient.mk I₀ (MvPolynomial.X i0 * MvPolynomial.X i1) =
        Ideal.Quotient.mk I₀ (MvPolynomial.C π) := by
      rw [Ideal.Quotient.eq, hgen]
      exact Ideal.mem_span_singleton_self _
    let desc : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c₀)))
        (CommRingCat.ofHom (IsLocalRing.residue A)),
        (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ J₀) →+* s.pt := fun s =>
      Ideal.Quotient.lift J₀ (MvPolynomial.eval₂Hom s.inr.hom
        (fun p => s.inl.hom (Ideal.Quotient.mk I₀ (MvPolynomial.X p)))) (by
          intro a ha
          rw [hJ₀, Ideal.mem_span_singleton'] at ha
          obtain ⟨r, rfl⟩ := ha
          rw [map_mul, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', ← map_mul,
            ← map_mul, hX01, hmkC]
          have hc := congrArg (fun φ => φ.hom π) s.condition
          simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at hc
          rw [hc, hres, map_zero, mul_zero])
    have hdescX : ∀ s p, desc s (Ideal.Quotient.mk J₀ (MvPolynomial.X p)) =
        s.inl.hom (Ideal.Quotient.mk I₀ (MvPolynomial.X p)) := by
      intro s p
      show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X p) = _
      rw [MvPolynomial.eval₂Hom_X']
    have hdescC : ∀ s x, desc s (Ideal.Quotient.mk J₀ (MvPolynomial.C x)) = s.inr.hom x := by
      intro s x
      show MvPolynomial.eval₂Hom _ _ (MvPolynomial.C x) = _
      rw [MvPolynomial.eval₂Hom_C]
    refine Limits.PushoutCocone.IsColimit.mk _ (fun s => CommRingCat.ofHom (desc s)) ?_ ?_ ?_
    · intro s
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        have hc := congrArg (fun φ => φ.hom a) s.condition
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at hc
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
          Limits.PushoutCocone.mk_inl]
        rw [hqC, hdescC, hmkC, hc]
      · intro p
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
          Limits.PushoutCocone.mk_inl]
        rw [hqX, hdescX]
    · intro s
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
        Limits.PushoutCocone.mk_inr]
      exact hdescC s x
    · intro s m h1 h2
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro x
        have := congrArg (fun φ => φ.hom x) h2
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
          Limits.PushoutCocone.mk_inr] at this
        simp only [RingHom.comp_apply, CommRingCat.hom_ofHom]
        rw [hdescC]
        exact this
      · intro p
        have := congrArg (fun φ => φ.hom (Ideal.Quotient.mk I₀ (MvPolynomial.X p))) h1
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
          Limits.PushoutCocone.mk_inl] at this
        rw [hqX] at this
        simp only [RingHom.comp_apply, CommRingCat.hom_ofHom]
        rw [hdescX]
        exact this

  have c2 (K : Type u) [Field K] (σ : Type) [Finite σ] (T : σ → Prop) (g : MvPolynomial σ K)
      (hg : g ∈ Ideal.span (MvPolynomial.X '' {s | T s})) :
      (Ideal.span ((fun s => Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.X s)) '' {s | T s})).IsPrime ∧
      Algebra.IsStandardSmoothOfRelativeDimension (Nat.card {s // ¬ T s}) K
        ((MvPolynomial σ K ⧸ Ideal.span {g}) ⧸
          Ideal.span ((fun s => Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.X s)) '' {s | T s})) := by
    classical
    set I : Ideal (MvPolynomial σ K) := Ideal.span (MvPolynomial.X '' {s | T s}) with hIdef
    let φ : σ → MvPolynomial {s // ¬ T s} K := fun s => if h : T s then 0 else MvPolynomial.X ⟨s, h⟩
    have hker : I ≤ RingHom.ker (MvPolynomial.aeval (R := K) φ) := by
      rw [hIdef, Ideal.span_le]
      rintro _ ⟨s, hs, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker]
      simp [φ, show T s from hs]
    let Φ : (MvPolynomial σ K ⧸ I) →ₐ[K] MvPolynomial {s // ¬ T s} K :=
      Ideal.Quotient.liftₐ I (MvPolynomial.aeval φ) (fun a ha => hker ha)
    let Ψ : MvPolynomial {s // ¬ T s} K →ₐ[K] (MvPolynomial σ K ⧸ I) :=
      (Ideal.Quotient.mkₐ K I).comp (MvPolynomial.rename Subtype.val)
    have hΦ : ∀ s, Φ (Ideal.Quotient.mk I (MvPolynomial.X s)) = φ s := by
      intro s
      show MvPolynomial.aeval φ (MvPolynomial.X s) = φ s
      exact MvPolynomial.aeval_X _ _
    have h1 : Ψ.comp Φ = AlgHom.id K _ := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro s
      show Ψ (Φ (Ideal.Quotient.mk I (MvPolynomial.X s))) = Ideal.Quotient.mk I (MvPolynomial.X s)
      rw [hΦ]
      by_cases hs : T s
      · have hmem : (MvPolynomial.X s : MvPolynomial σ K) ∈ I := Ideal.subset_span ⟨s, hs, rfl⟩
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
        simp only [φ, dif_pos hs, map_zero]
      · simp only [φ, dif_neg hs, Ψ, AlgHom.comp_apply, MvPolynomial.rename_X,
          Ideal.Quotient.mkₐ_eq_mk]
    have h2 : Φ.comp Ψ = AlgHom.id K _ := by
      apply MvPolynomial.algHom_ext
      intro s
      show Φ (Ideal.Quotient.mk I (MvPolynomial.rename Subtype.val (MvPolynomial.X s))) = MvPolynomial.X s
      rw [MvPolynomial.rename_X, hΦ]
      simp only [φ, dif_neg s.2]
    let e1 : (MvPolynomial σ K ⧸ I) ≃ₐ[K] MvPolynomial {s // ¬ T s} K := AlgEquiv.ofAlgHom Φ Ψ h2 h1
    have hle : Ideal.span {g} ≤ I := (Ideal.span_singleton_le_iff_mem _).mpr hg
    have hJ : Ideal.span ((fun s => Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.X s)) '' {s | T s}) =
        Ideal.map (Ideal.Quotient.mkₐ K (Ideal.span {g})) I := by
      rw [hIdef, Ideal.map_span, Set.image_image]
      rfl
    let e2 := (Ideal.quotientEquivAlgOfEq K hJ).trans ((DoubleQuot.quotQuotEquivQuotOfLEₐ K hle).trans e1)
    haveI : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card {s // ¬ T s}) K
        (MvPolynomial {s // ¬ T s} K) :=
      Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K _
    refine ⟨?_, Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv _ e2.symm⟩
    rw [← Ideal.Quotient.isDomain_iff_prime]
    exact MulEquiv.isDomain _ e2.toMulEquiv

  have c4 (K : Type u) [Field K] (S Y : Scheme.{u}) (sS : S ⟶ Spec (.of K)) (i : Y ⟶ S)
      [IsClosedImmersion i] [IsReduced Y] (B : Type u) [CommRing B] [Algebra K B] {ι : Type}
      (u : ι → (Spec (.of B) ⟶ S)) (hu_open : ∀ k, IsOpenImmersion (u k))
      (hu_cov : ∀ x : S, ∃ k y, u k y = x)
      (hu_str : ∀ k, u k ≫ sS = Spec.map (CommRingCat.ofHom (algebraMap K B)))
      (J : Ideal B) (hJ : J.IsRadical)
      (hJT : ∀ k, (u k) ⁻¹' Set.range i = PrimeSpectrum.zeroLocus (J : Set B)) (d : ℕ)
      (hsm : Algebra.IsStandardSmoothOfRelativeDimension d K (B ⧸ J)) :
      SmoothOfRelativeDimension d (i ≫ sS) := by
    haveI hZL : IsZariskiLocalAtSource (@SmoothOfRelativeDimension d) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    have hbase : SmoothOfRelativeDimension d
        (Spec.map (CommRingCat.ofHom (algebraMap K (B ⧸ J)))) := by
      rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension d)]
      exact RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _
        ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap d).mpr hsm)
    have hloc : ∀ k, SmoothOfRelativeDimension d
        (Limits.pullback.fst i (u k) ≫ i ≫ sS) := by
      intro k
      haveI := hu_open k
      set g := Limits.pullback.snd i (u k) with hg
      have hgci : IsClosedImmersion g := inferInstance
      haveI : IsReduced (Limits.pullback i (u k)) :=
        isReduced_of_isOpenImmersion (Limits.pullback.fst i (u k))
      obtain ⟨I, ε, hε⟩ := IsClosedImmersion.Spec_iff.mp hgci
      have hrange : Set.range g = PrimeSpectrum.zeroLocus (J : Set B) := by
        rw [hg, Scheme.Pullback.range_snd, hJT k]
      have hrange2 : Set.range g =
          Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
        rw [hε]
        ext x
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨ε.hom y, by rw [Scheme.Hom.comp_apply]⟩
        · rintro ⟨y, rfl⟩
          refine ⟨ε.inv y, ?_⟩
          rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply ε.inv ε.hom, Iso.inv_hom_id]
          rfl
      have hrange3 : Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) =
          PrimeSpectrum.zeroLocus (I : Set B) := by
        have := range_comap_of_surjective (B ⧸ I) (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
        rw [Ideal.mk_ker] at this
        rw [← this]
        rfl
      have hzl : PrimeSpectrum.zeroLocus (I : Set B) = PrimeSpectrum.zeroLocus (J : Set B) := by
        rw [← hrange3, ← hrange2, hrange]
      have hrad : I.radical = J := by
        rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hzl,
          PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hJ.radical]
      haveI : IsReduced (Spec (.of (B ⧸ I))) := isReduced_of_isOpenImmersion ε.inv
      have hIr : I.IsRadical := by
        rw [Ideal.isRadical_iff_quotient_reduced]
        have h1 : _root_.IsReduced Γ(Spec (.of (B ⧸ I)), ⊤) := IsReduced.component_reduced ⊤
        exact isReduced_of_injective (Scheme.ΓSpecIso (.of (B ⧸ I))).inv.hom
          (fun a b h => by
            have := congrArg (Scheme.ΓSpecIso (.of (B ⧸ I))).hom.hom h
            simpa using this)
      have hIJ : I = J := by rw [← hrad, hIr.radical]
      subst hIJ
      have hcomp : Limits.pullback.fst i (u k) ≫ i ≫ sS =
          ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (B ⧸ I))) := by
        rw [← Category.assoc, Limits.pullback.condition, Category.assoc, hu_str k, ← hg, hε,
          Category.assoc, ← Spec.map_comp]
        rfl
      rw [hcomp]
      exact IsZariskiLocalAtSource.comp hbase ε.hom
    let 𝒰 : Y.OpenCover := Scheme.Cover.mkOfCovers ι (fun k => Limits.pullback i (u k))
      (fun k => Limits.pullback.fst i (u k)) (fun y => by
        obtain ⟨k, v, hv⟩ := hu_cov (i y)
        obtain ⟨p, hp1, _⟩ := Scheme.Pullback.exists_preimage_pullback (f := i) (g := u k) y v hv.symm
        exact ⟨k, p, hp1⟩) (fun k => by haveI := hu_open k; exact inferInstance)
    exact IsZariskiLocalAtSource.of_openCover 𝒰 (fun k => hloc k)

  have c6 (R : Type u) [CommRing R] (a b : R) (hab : a * b = 0) (hb : (Ideal.span {b}).IsPrime)
      (ha : a ∉ Ideal.span {b}) :
      closure {p : PrimeSpectrum R | a ∉ p.asIdeal} = PrimeSpectrum.zeroLocus {b} := by
    apply le_antisymm
    · apply closure_minimal _ (PrimeSpectrum.isClosed_zeroLocus _)
      intro p hp
      simp only [Set.mem_setOf_eq] at hp
      rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
      have : a * b ∈ p.asIdeal := by rw [hab]; exact p.asIdeal.zero_mem
      exact (p.isPrime.mem_or_mem this).resolve_left hp
    · let q₀ : PrimeSpectrum R := ⟨Ideal.span {b}, hb⟩
      have hq : q₀ ∈ {p : PrimeSpectrum R | a ∉ p.asIdeal} := ha
      have e : PrimeSpectrum.zeroLocus ({b} : Set R) = closure {q₀} := by
        rw [PrimeSpectrum.closure_singleton, ← PrimeSpectrum.zeroLocus_span]
      rw [e]
      exact closure_mono (Set.singleton_subset_iff.mpr hq)

  have c7 (n : ℕ) (hn : Even n) (h2 : 2 ≤ n) :
      Nat.card {s : Fin n // ¬ (s.val = 0 ∨ s.val % 2 = 1)} = n - 2 - (n / 2 - 1) ∧
      Nat.card {s : Fin n // ¬ (s.val = 0 ∨ s.val = 1)} = n - 2 := by
    have key : ∀ (P : ℕ → Prop) [DecidablePred P],
        Nat.card {s : Fin n // P s.val} = ((Finset.range n).filter P).card := by
      intro P _
      rw [← Nat.card_eq_finsetCard]
      exact Nat.card_congr
        { toFun := fun s => ⟨s.1.val, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr s.1.isLt, s.2⟩⟩
          invFun := fun x => ⟨⟨x.1, Finset.mem_range.mp (Finset.mem_filter.mp x.2).1⟩,
            (Finset.mem_filter.mp x.2).2⟩
          left_inv := fun s => rfl
          right_inv := fun x => rfl }
    obtain ⟨m, rfl⟩ := hn
    constructor
    · rw [key (fun s => ¬ (s = 0 ∨ s % 2 = 1))]
      have : ∀ m : ℕ, ((Finset.range (m + m)).filter (fun s => ¬ (s = 0 ∨ s % 2 = 1))).card = m - 1 := by
        intro m
        induction m with
        | zero => simp
        | succ k ih =>
          have e : k + 1 + (k + 1) = (k + k) + 1 + 1 := by omega
          rw [e, Finset.range_add_one, Finset.range_add_one, Finset.filter_insert, Finset.filter_insert]
          have h1 : ¬ ¬ ((k + k + 1) = 0 ∨ (k + k + 1) % 2 = 1) := by omega
          rw [if_neg h1]
          by_cases hk : k = 0
          · subst hk; simp
          · have h3 : ¬ ((k + k) = 0 ∨ (k + k) % 2 = 1) := by omega
            rw [if_pos h3, Finset.card_insert_of_notMem (by simp), ih]
            omega
      rw [this m]
      omega
    · rw [key (fun s => ¬ (s = 0 ∨ s = 1))]
      have hfe : (Finset.range (m + m)).filter (fun s => ¬ (s = 0 ∨ s = 1)) =
          ((Finset.range (m + m)).erase 0).erase 1 := by
        ext x
        simp only [Finset.mem_filter, Finset.mem_erase, Finset.mem_range]
        constructor
        · intro h; omega
        · intro h; omega
      have hm1 : (1 : ℕ) ∈ (Finset.range (m + m)).erase 0 :=
        Finset.mem_erase.mpr ⟨(by omega : (1 : ℕ) ≠ 0), Finset.mem_range.mpr (by omega : 1 < m + m)⟩
      have hm0 : (0 : ℕ) ∈ Finset.range (m + m) := Finset.mem_range.mpr (by omega : 0 < m + m)
      rw [hfe, Finset.card_erase_of_mem hm1, Finset.card_erase_of_mem hm0, Finset.card_range]
      omega

  have c8 {X' M V Base Pt : Scheme.{u}} (f' : X' ⟶ Base) (σ : Pt ⟶ Base) (t : M ⟶ Base)
      (qS : V ⟶ M) (aS : V ⟶ Pt) (hV : IsPullback qS aS t σ) {ι : Type} (e : ι → (M ⟶ X'))
      (he_open : ∀ k, IsOpenImmersion (e k)) (he_cov : ∀ x : X', ∃ k y, e k y = x)
      (het : ∀ k, e k ≫ f' = t) :
      ∃ u : ι → (V ⟶ Limits.pullback f' σ), (∀ k, IsOpenImmersion (u k)) ∧
        (∀ z : ↥(Limits.pullback f' σ), ∃ k w, u k w = z) ∧
        (∀ k, u k ≫ Limits.pullback.snd f' σ = aS) ∧
        (∀ k, u k ≫ Limits.pullback.fst f' σ = qS ≫ e k) := by
    have hw : ∀ k, (qS ≫ e k) ≫ f' = aS ≫ σ := fun k => by
      rw [Category.assoc, het k, hV.w]
    let u : ι → (V ⟶ Limits.pullback f' σ) := fun k => Limits.pullback.lift (qS ≫ e k) aS (hw k)
    have hu1 : ∀ k, u k ≫ Limits.pullback.fst f' σ = qS ≫ e k := fun k => Limits.pullback.lift_fst _ _ _
    have hu2 : ∀ k, u k ≫ Limits.pullback.snd f' σ = aS := fun k => Limits.pullback.lift_snd _ _ _
    have hk : ∀ k, IsPullback (u k) qS (Limits.pullback.fst f' σ) (e k) := by
      intro k
      apply IsPullback.of_right (h₁₂ := Limits.pullback.snd f' σ) (h₂₂ := f') (v₁₃ := σ)
      · rw [hu2 k, het k]; exact hV.flip
      · exact hu1 k
      · exact (IsPullback.of_hasPullback f' σ).flip
    refine ⟨u, fun k => ?_, fun z => ?_, hu2, hu1⟩
    · haveI := he_open k
      exact MorphismProperty.of_isPullback (P := @IsOpenImmersion) (hk k).flip (he_open k)
    · obtain ⟨k, y, hy⟩ := he_cov (Limits.pullback.fst f' σ z)
      obtain ⟨p, hp1, _⟩ := Scheme.Pullback.exists_preimage_pullback (f := Limits.pullback.fst f' σ)
        (g := e k) z y hy.symm
      refine ⟨k, (hk k).isoPullback.inv p, ?_⟩
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hp1]
  have hred : ∀ (X : Scheme.{u}) (Z : TopologicalSpace.Closeds X),
      IsReduced (Scheme.IdealSheafData.vanishingIdeal Z).subscheme := by
    intro X Z
    set I := Scheme.IdealSheafData.vanishingIdeal Z with hI
    have hrad : ∀ U : X.affineOpens, _root_.IsReduced (Γ(X, U) ⧸ I.ideal U) := fun U =>
      (Ideal.isRadical_iff_quotient_reduced _).mp
        (by rw [hI, Scheme.IdealSheafData.vanishingIdeal_ideal]; exact PrimeSpectrum.isRadical_vanishingIdeal _)
    have hcov : ∀ i, IsReduced (I.subschemeCover.openCover.X i) := by
      intro i
      haveI : _root_.IsReduced (I.subschemeCover.X i) := hrad i
      have h2 : IsReduced (Spec (I.subschemeCover.X i)) := inferInstance
      exact h2
    exact IsReduced.of_openCover _ I.subschemeCover.openCover

  have h2n : 2 ≤ n := by omega
  have hπm : π ∈ IsLocalRing.maximalIdeal A := by rw [hπ]; exact Ideal.mem_span_singleton_self π
  have het : ∀ k, e k ≫ f' = wcQuadModelStr A n π
      (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    intro k; rw [← hf']; exact he_str k

  set J₀ : Ideal (MvPolynomial (Fin n) (IsLocalRing.ResidueField A)) :=
    Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin n) * MvPolynomial.X (⟨1, by omega⟩ : Fin n)}
    with hJ₀
  obtain ⟨q, hqX, hV⟩ := c1 A n h2n π hπm
  obtain ⟨u, hu_open, hu_cov, hu_s, hu_ι⟩ := c8 f' (wcQmSp A) _ _ _ hV e he_open he_cov het

  have hpt : ∀ k (w : ↥(Spec (.of (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ J₀)))),
      (Limits.pullback.fst f' (wcQmSp A) ≫ β) (u k w) = (e k ≫ β) (Spec.map (CommRingCat.ofHom q) w) := by
    intro k w
    have h := congrArg (fun φ => φ ≫ β) (hu_ι k)
    simp only [Category.assoc] at h
    rw [← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply]
  have hmem : ∀ (w : ↥(Spec (.of (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ J₀)))) (p : Fin n),
      Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom q) w) ↔
      Ideal.Quotient.mk J₀ (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal w := by
    intro w p
    show q (Ideal.Quotient.mk _ (MvPolynomial.X p)) ∈ PrimeSpectrum.asIdeal w ↔ _
    rw [hqX]
  set Z₂ := {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n, p.val % 2 = 0 →
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} with hZ₂
  set P := {z : ↥(Limits.pullback f' (wcQmSp A)) | ∀ p : Fin n,
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) z)} with hPdef

  have hZ2 : ∀ k w, u k w ∈ Z₂ ↔
      Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∈ PrimeSpectrum.asIdeal w := by
    intro k w
    show (∀ p : Fin n, p.val % 2 = 0 →
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) (u k w))) ↔ _
    rw [hpt k w, hE k, hmem]
  have hPc : ∀ k w, u k w ∈ P ↔ ∀ s : Fin n, (s.val = 0 ∨ s.val % 2 = 1) →
      Ideal.Quotient.mk J₀ (MvPolynomial.X s) ∈ PrimeSpectrum.asIdeal w := by
    intro k w
    show (∀ p : Fin n,
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal ((Limits.pullback.fst f' (wcQmSp A) ≫ β) (u k w))) ↔ _
    rw [hpt k w, hP k]
    simp only [hmem]
    constructor
    · rintro ⟨h0, h1, h3⟩ s hs
      by_cases hs0 : s.val = 0
      · rw [show s = ⟨0, by omega⟩ from Fin.ext hs0]; exact h0
      · by_cases hs1 : s.val = 1
        · rw [show s = ⟨1, by omega⟩ from Fin.ext hs1]; exact h1
        · exact h3 s (by omega) (by omega)
    · intro h
      exact ⟨h _ (Or.inl rfl), h _ (Or.inr rfl), fun p hp _ => h p (Or.inr hp)⟩

  have hg1 : (MvPolynomial.X (⟨0, by omega⟩ : Fin n) * MvPolynomial.X (⟨1, by omega⟩ : Fin n) :
      MvPolynomial (Fin n) (IsLocalRing.ResidueField A)) ∈
      Ideal.span (MvPolynomial.X '' {s : Fin n | s.val = 1}) :=
    Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨1, by omega⟩, rfl, rfl⟩)
  have hg2 : (MvPolynomial.X (⟨0, by omega⟩ : Fin n) * MvPolynomial.X (⟨1, by omega⟩ : Fin n) :
      MvPolynomial (Fin n) (IsLocalRing.ResidueField A)) ∈
      Ideal.span (MvPolynomial.X '' {s : Fin n | s.val = 0 ∨ s.val % 2 = 1}) :=
    Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨⟨0, by omega⟩, Or.inl rfl, rfl⟩)
  have hgD : (MvPolynomial.X (⟨0, by omega⟩ : Fin n) * MvPolynomial.X (⟨1, by omega⟩ : Fin n) :
      MvPolynomial (Fin n) (IsLocalRing.ResidueField A)) ∈
      Ideal.span (MvPolynomial.X '' {s : Fin n | s.val = 0 ∨ s.val = 1}) :=
    Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨⟨0, by omega⟩, Or.inl rfl, rfl⟩)
  have hc2a := c2 (IsLocalRing.ResidueField A) (Fin n) (fun s => s.val = 1) _ hg1
  have hc2b := c2 (IsLocalRing.ResidueField A) (Fin n) (fun s => s.val = 0 ∨ s.val % 2 = 1) _ hg2
  have hc2c := c2 (IsLocalRing.ResidueField A) (Fin n) (fun s => s.val = 0 ∨ s.val = 1) _ hgD
  have hd := c7 n hn h2n
  have hJ1 : ((fun s => Ideal.Quotient.mk J₀ (MvPolynomial.X s)) '' {s : Fin n | s.val = 1}) =
      {Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨1, by omega⟩ : Fin n))} := by
    ext x
    constructor
    · rintro ⟨s, hs, rfl⟩
      rw [Set.mem_singleton_iff, show s = ⟨1, by omega⟩ from Fin.ext hs]
    · rintro rfl
      exact ⟨⟨1, by omega⟩, rfl, rfl⟩
  have hJ1prime : (Ideal.span {Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨1, by omega⟩ : Fin n))}).IsPrime := by
    rw [← hJ1]; exact hc2a.1

  have hab : Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) *
      Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨1, by omega⟩ : Fin n)) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self _
  have ha : Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∉
      Ideal.span {Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨1, by omega⟩ : Fin n))} := by
    intro h
    rw [Ideal.mem_span_singleton'] at h
    obtain ⟨r, hr⟩ := h
    let ev : (MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ J₀) →+* IsLocalRing.ResidueField A :=
      Ideal.Quotient.lift J₀
        (MvPolynomial.eval (fun s : Fin n => if s.val = 0 then (1 : IsLocalRing.ResidueField A) else 0))
        (by
          intro a ha
          rw [hJ₀, Ideal.mem_span_singleton'] at ha
          obtain ⟨t, rfl⟩ := ha
          simp)
    have h2 := congrArg ev hr
    simp [ev] at h2
  have hZ1 : ∀ k, (u k) ⁻¹' closure Z₂ᶜ =
      PrimeSpectrum.zeroLocus {Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨1, by omega⟩ : Fin n))} := by
    intro k
    haveI := hu_open k
    rw [(u k).isOpenEmbedding.isOpenMap.preimage_closure_eq_closure_preimage (u k).continuous]
    have h1 : (u k) ⁻¹' Z₂ᶜ = {w | Ideal.Quotient.mk J₀ (MvPolynomial.X (⟨0, by omega⟩ : Fin n)) ∉
        PrimeSpectrum.asIdeal w} := by
      ext w
      rw [Set.mem_preimage, Set.mem_compl_iff, hZ2 k w]
      rfl
    rw [h1]
    exact c6 _ _ _ hab hJ1prime ha

  have hZ2cl : IsClosed Z₂ := by
    have h1 : Z₂ = ⋂ p : Fin n, ⋂ (_ : p.val % 2 = 0), (Limits.pullback.fst f' (wcQmSp A) ≫ β) ⁻¹'
        PrimeSpectrum.zeroLocus {Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)} := by
      ext z
      exact ⟨fun h => Set.mem_iInter.mpr fun p => Set.mem_iInter.mpr fun hp =>
          Set.singleton_subset_iff.mpr (h p hp),
        fun h p hp => Set.singleton_subset_iff.mp (Set.mem_iInter.mp (Set.mem_iInter.mp h p) hp)⟩
    rw [h1]
    exact isClosed_iInter fun p => isClosed_iInter fun _ =>
      (PrimeSpectrum.isClosed_zeroLocus _).preimage (Scheme.Hom.continuous _)
  set Dbl := Z₂ ∩ closure Z₂ᶜ with hDbl
  have hDcl : IsClosed Dbl := hZ2cl.inter isClosed_closure
  have hDchart : ∀ k, (u k) ⁻¹' Dbl = PrimeSpectrum.zeroLocus
      ((Ideal.span ((fun s => Ideal.Quotient.mk J₀ (MvPolynomial.X s)) ''
        {s : Fin n | s.val = 0 ∨ s.val = 1}) : Ideal _) : Set _) := by
    intro k
    rw [PrimeSpectrum.zeroLocus_span]
    ext w
    show (u k w ∈ Z₂ ∧ w ∈ (u k) ⁻¹' closure Z₂ᶜ) ↔ _
    rw [hZ1 k, hZ2 k w]
    constructor
    · rintro ⟨h0, h1⟩
      refine Set.image_subset_iff.mpr (fun s hs => ?_)
      rcases hs with hs | hs
      · rw [show s = ⟨0, by omega⟩ from Fin.ext hs]; exact h0
      · rw [show s = ⟨1, by omega⟩ from Fin.ext hs]; exact h1 (Set.mem_singleton _)
    · intro h
      exact ⟨Set.image_subset_iff.mp h
          (show (⟨0, by omega⟩ : Fin n) ∈ {s : Fin n | s.val = 0 ∨ s.val = 1} from Or.inl rfl),
        Set.singleton_subset_iff.mpr (Set.image_subset_iff.mp h
          (show (⟨1, by omega⟩ : Fin n) ∈ {s : Fin n | s.val = 0 ∨ s.val = 1} from Or.inr rfl))⟩

  have hPclosed : IsClosed P := by
    have h1 : P = ⋂ p : Fin n, (Limits.pullback.fst f' (wcQmSp A) ≫ β) ⁻¹'
        PrimeSpectrum.zeroLocus {Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)} := by
      ext z
      exact ⟨fun h => Set.mem_iInter.mpr fun p => Set.singleton_subset_iff.mpr (h p),
