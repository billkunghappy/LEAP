      (IsLocalRing.isClosed_singleton_closedPoint B)
    convert h2 using 1
    ext z
    constructor
    · intro hz
      obtain rfl : z = eB.inv (IsLocalRing.closedPoint B) := hz
      exact ⟨_, rfl, rfl⟩
    · rintro ⟨w, hw, rfl⟩
      obtain rfl : w = IsLocalRing.closedPoint B := hw
