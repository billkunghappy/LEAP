theorem wc_etqm_srt_generic_iso (A : Type u) [CommRing A] (n : ℕ) (π : A)
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β)
    (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (Ω : Type u) [Field Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφπ : (Spec.preimage ξ).hom π ≠ 0) :
    ∃ βE : Limits.pullback f' ξ ⟶ Limits.pullback (wcQuadModelStr A n π c) ξ,
      IsIso βE ∧
      βE ≫ Limits.pullback.fst (wcQuadModelStr A n π c) ξ = Limits.pullback.fst f' ξ ≫ β ∧
      βE ≫ Limits.pullback.snd (wcQuadModelStr A n π c) ξ = Limits.pullback.snd f' ξ :=
by
  classical


  have hoff : ∀ (X X' : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (W : X.Opens),
      wcCsdIsBlowup I r → (I.support : Set X) ∩ (W : Set X) = ∅ → IsIso (r ∣_ W) := by
    intro X X' I r W hb hW
    obtain ⟨-, hUniq⟩ := hb
    have H : ∀ (T : Scheme.{u}) (h : T ⟶ X), (∀ t : T, h t ∉ (I.support : Set X)) →
        wcCsdInvPull I h := by
      intro T h hh t
      obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := h t) trivial
      have hns : h t ∉ X.zeroLocus (U := U₀) (I.ideal ⟨U₀, hU₀⟩ : Set Γ(X, U₀)) := by
        rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
        exact hh t
      rw [Scheme.mem_zeroLocus_iff] at hns
      push_neg at hns
      obtain ⟨a, haI, hxa⟩ := hns
      have htD : t ∈ h ⁻¹ᵁ X.basicOpen a := (Scheme.Hom.mem_preimage h).mpr hxa
      obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
      have hVD : V₀ ≤ h ⁻¹ᵁ X.basicOpen a := hV₀sub
      have hVU : V₀ ≤ h ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono h (X.basicOpen_le a))
      refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV₀, haI, ?_⟩
      have hbo : T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) = V₀ := by
        rw [Scheme.basicOpen_appLE]
        exact inf_eq_left.mpr hVD
      have hunit : IsUnit ((h.appLE U₀ V₀ hVU).hom a) := by
        apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace V₀
        intro y hy
        have hy' : y ∈ T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) := by rw [hbo]; exact hy
        exact (T.mem_basicOpen _ y hy).mp hy'
      refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
      rw [Ideal.span_singleton_eq_top.mpr hunit]
      exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ haI) hunit
    have memι : ∀ (V : X'.Opens) (z : V.toScheme), V.ι z ∈ V := by
      intro V z
      have hz : V.ι z ∈ Set.range V.ι := ⟨z, rfl⟩
      rwa [Scheme.Opens.range_ι] at hz
    have memW : ∀ y : W.toScheme, W.ι y ∈ W := by
      intro y
      have hy : W.ι y ∈ Set.range W.ι := ⟨y, rfl⟩
      rwa [Scheme.Opens.range_ι] at hy
    have hWav : ∀ y : W.toScheme, W.ι y ∉ (I.support : Set X) := by
      intro y hy
      have hmem : W.ι y ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hy, memW y⟩
      rw [hW] at hmem
      exact hmem
    obtain ⟨s, hs, -⟩ := hUniq W.toScheme W.ι (H _ _ hWav)
    have hrange : Set.range s ⊆ Set.range (r ⁻¹ᵁ W).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      show s y ∈ r ⁻¹ᵁ W
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hs]
      exact memW y
    haveI : Mono W.ι := IsOpenImmersion.mono W.ι
    haveI : Mono (r ⁻¹ᵁ W).ι := IsOpenImmersion.mono (r ⁻¹ᵁ W).ι
    let s' := IsOpenImmersion.lift (r ⁻¹ᵁ W).ι s hrange
    have hs' : s' ≫ (r ⁻¹ᵁ W).ι = s := IsOpenImmersion.lift_fac _ _ _
    have h4 : s' ≫ (r ∣_ W) = 𝟙 _ := by
      rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hs', hs,
        Category.id_comp]
    have hιav : ∀ z : (r ⁻¹ᵁ W).toScheme, ((r ⁻¹ᵁ W).ι ≫ r) z ∉ (I.support : Set X) := by
      intro z hz
      have hz1 : (r ⁻¹ᵁ W).ι z ∈ r ⁻¹ᵁ W := memι (r ⁻¹ᵁ W) z
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply] at hz1
      have hmem : ((r ⁻¹ᵁ W).ι ≫ r) z ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hz, hz1⟩
      rw [hW] at hmem
      exact hmem
    have hh := H _ _ hιav
    have h5 : (r ∣_ W) ≫ s' = 𝟙 _ := by
      rw [← cancel_mono (r ⁻¹ᵁ W).ι, Category.id_comp]
      apply (hUniq _ _ hh).unique
      · simp only [Category.assoc]
        rw [reassoc_of% hs', hs, morphismRestrict_ι]
      · rfl
    exact IsIso.mk ⟨s', h5, h4⟩

  let ψ := (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
  let J : Ideal Γ(Spec (.of (wcQuadModelRing A n π c)), ⊤) := Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n))))
  let πX : Γ(Spec (.of (wcQuadModelRing A n π c)), ⊤) := ψ (algebraMap A (wcQuadModelRing A n π c) π)
  have hmem : πX ∈ J := by
    have h1 : algebraMap A (wcQuadModelRing A n π c) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) := by
      rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
      symm
      rw [Ideal.Quotient.eq]
      exact Ideal.subset_span rfl
    show ψ _ ∈ J
    rw [h1, map_sum, map_sum]
    refine Ideal.sum_mem _ fun p _ => ?_
    rw [map_sum, map_sum]
    refine Ideal.sum_mem _ fun q _ => ?_
    rw [map_mul, map_mul, map_mul, map_mul]
    subst hc
    simp only [Matrix.of_apply]
    split_ifs with h
