    have hch3 := wc_etqm_srd_mv_inj A ℓ hℓ k n hn hn4 π hπ c hc X' β hbl
      hprop f' hf' βs hβs1 hβs2 hk1 Z₀ i₀ hZ₀ hi₀ DP Y iY hYr DY
    obtain ⟨ν, hν⟩ := hch3
