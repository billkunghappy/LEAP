        (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) (i₀ w₀)) =
        Ideal.span (Set.range fun p : Fin n =>
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) := by
      rw [← Scheme.Hom.comp_apply]
      exact (hle _ (hi₀ w₀)).symm
