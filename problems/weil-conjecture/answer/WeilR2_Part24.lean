    fun z z' => map_sub (hS.extClass.precomp (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) hm') z z'
  have hPn : ∀ (N : ℕ) (z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap D.Yt.left j))
