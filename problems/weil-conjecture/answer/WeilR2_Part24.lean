  · exact Or.inl ⟨z, hz.trans (mul_dvd_mul_right (pow_dvd_pow ℓ hc₀) _)⟩
  · refine Or.inr (fun z => ?_)
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hc₀
