        (MvPolynomial.X J * MvPolynomial.X L)).hom)
  have key : ∀ (m : Fin (n + 1)) (g : MvPolynomial (Fin (n + 1)) K)
      (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1)
      (hx : MvPolynomial.X J * MvPolynomial.X L = MvPolynomial.X m * g)
