theorem wc_scqd_sgE_transition (K : Type u) [Field K] (n : ℕ) (W : Scheme.{u})
    (κ : W ⟶ wcProjK K n) (J L j : Fin (n + 1)) :
    ∃ u : Γ(W, κ ⁻¹ᵁ wcSgD K n J ⊓ κ ⁻¹ᵁ wcSgD K n L), IsUnit u ∧
      W.presheaf.map (homOfLE (inf_le_right :
          κ ⁻¹ᵁ wcSgD K n J ⊓ κ ⁻¹ᵁ wcSgD K n L ≤ κ ⁻¹ᵁ wcSgD K n L)).op
          ((κ.app (wcSgD K n L)).hom (wcSgE K n L j)) =
        u * W.presheaf.map (homOfLE (inf_le_left :
          κ ⁻¹ᵁ wcSgD K n J ⊓ κ ⁻¹ᵁ wcSgD K n L ≤ κ ⁻¹ᵁ wcSgD K n J)).op
          ((κ.app (wcSgD K n J)).hom (wcSgE K n J j)) :=
