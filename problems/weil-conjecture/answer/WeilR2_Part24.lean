        rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hw]
      · apply MorphismProperty.Over.Hom.ext
        change a.left.resLE _ _ hle ≫ (T.hom ⁻¹ᵁ O).ι = (Z.hom ⁻¹ᵁ O).ι ≫ a.left
        exact Scheme.Hom.resLE_comp_ι _ _
    choose lf hlf using L1

    let R : Presieve V := fun W f => ∃ x : G.obj.obj (Opposite.op W),
      ∀ (Z : B.Etale) (g : Z ⟶ W) (g' : Z ⟶ wcEtOpen B V (V.hom ⁻¹ᵁ O)),
        g ≫ f = g' ≫ wcEtOpenι B V (V.hom ⁻¹ᵁ O) →
        (G.obj.map g.op).hom x = N • (G.obj.map g'.op).hom h
    have hι : R (wcEtOpenι B V (V.hom ⁻¹ᵁ O)) := by
      refine ⟨N • h, ?_⟩
      intro Z g g' hgg
      rw [L2 g g' hgg, map_nsmul]
    have hcov : Sieve.generate R ∈ Scheme.smallEtaleTopology B V := by
      apply wc_etale_jointly_surjective_covers B V (Sieve.generate R)
      intro v
      by_cases hv : V.hom v ∈ O
      · refine ⟨_, wcEtOpenι B V (V.hom ⁻¹ᵁ O), Sieve.le_generate R _ _ hι, ?_⟩
        show v ∈ Set.range (V.hom ⁻¹ᵁ O).ι
        rw [Scheme.Opens.range_ι]
        exact hv
      · obtain ⟨W, f, x, hvf, hgood⟩ := hloc v hv
        exact ⟨W, f, Sieve.le_generate R _ f ⟨x, hgood⟩, hvf⟩
    have hsh : Presieve.IsSheaf (Scheme.smallEtaleTopology B) (G.obj ⋙ forget AddCommGrpCat) :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology B) G.obj
          (forget AddCommGrpCat.{u+1})).1 G.cond)
    let fam : Presieve.FamilyOfElements (G.obj ⋙ forget AddCommGrpCat) R :=
      fun W f hf => Classical.choose hf
    have hcompat : fam.Compatible := by
      intro Y₁ Y₂ Z a₁ a₂ f₁ f₂ h₁ h₂ hcomm
      show (G.obj.map a₁.op).hom (Classical.choose h₁) = (G.obj.map a₂.op).hom (Classical.choose h₂)
      rw [← sub_eq_zero]
      apply hinj Z
      rw [map_sub, ← resComp, ← resComp,
        Classical.choose_spec h₁ _ (wcEtOpenι B Z (Z.hom ⁻¹ᵁ O) ≫ a₁) (lf V Z (a₁ ≫ f₁))
          (by rw [hlf, Category.assoc]),
        Classical.choose_spec h₂ _ (wcEtOpenι B Z (Z.hom ⁻¹ᵁ O) ≫ a₂) (lf V Z (a₁ ≫ f₁))
          (by rw [hlf, Category.assoc, hcomm]),
        sub_self]
    have hS := hsh.isSheafFor R hcov
    refine ⟨hS.amalgamate fam hcompat, ?_⟩
    have e1 : (G.obj.map (wcEtOpenι B V (V.hom ⁻¹ᵁ O)).op).hom (hS.amalgamate fam hcompat) =
        Classical.choose hι :=
      hS.valid_glue hcompat _ hι
    rw [e1]
    have e2 := Classical.choose_spec hι _ (𝟙 _) (𝟙 _) rfl
    simpa using e2

  have hinj : ∀ (k : ℕ)
      (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))))
      (W : (wcP1Over F'').left.Etale)
      (s : ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology (n - 1)).obj.obj (Opposite.op W)),
      (((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology (n - 1)).obj.map
          (wcEtOpenι (wcP1Over F'').left W (W.hom ⁻¹ᵁ O)).op).hom s = 0 → s = 0 := by
    intro k I W s hs
    have hall := (wc_etale_section_vanishing_open (wcP1Over F'').left
      ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
