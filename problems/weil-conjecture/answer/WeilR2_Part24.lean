  have H := congrArg (fun x => π.appLE _ O hO₀ x)
    (hσrel c J L (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c ⊓
      (σ ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J) inf_le_right inf_le_left)
  simp only [map_mul, e1, e2, key] at H
