  obtain ⟨cco, hcco⟩ : ∃ cco : wcEtOpen (wcP1Over F'').left (W'.obj l₁).right
      ((W'.obj l₁).right.hom ⁻¹ᵁ O) ⟶ wcEtOpen (wcP1Over F'').left V (V.hom ⁻¹ᵁ O),
      cco ≫ wcEtOpenι (wcP1Over F'').left V (V.hom ⁻¹ᵁ O) =
