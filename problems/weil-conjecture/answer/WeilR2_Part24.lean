  intro α hφ t ht P K eK eΨ Ψ Pw γ Tflat T TΨ V hV ζ


  have c1 : ∀ {𝒞 : Type _} [Category 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞] (m : ℕ),
      (∀ M : 𝒞, m • 𝟙 M = 0) → ∀ (L : CochainComplex 𝒞 ℤ) (Z : DerivedCategory 𝒞)
