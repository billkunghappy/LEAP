  obtain ⟨κ, hκ⟩ := wc_proet_closed_coker_geom_push_iso K (Over.mk (W.ι ≫ X.hom)) Z
    (show Z.left ⟶ (Over.mk (W.ι ≫ X.hom)).left from iZ) hiZ' hiZX hln (W.ι ⁻¹ᵁ O) hOt hW' hZ
  have hκΨ := hκ Ψ' hΨ'
  let K1 := (Abelian.Ext.mk₀ κ.hom).precomp (wcRootTwist (Over.mk (W.ι ≫ X.hom)).left (ℓ ^ k) 1)
