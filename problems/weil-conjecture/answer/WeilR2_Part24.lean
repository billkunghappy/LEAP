      Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology A) _
    haveI : (wcEtBaseChange h1 ⋙ wcEtBaseChange h2).IsContinuous (Scheme.smallEtaleTopology Y)
        (Scheme.smallEtaleTopology B) :=
      Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology C) _
    let φH : wcEtZModRing Y m ⟶ ((wcEtBaseChange h1 ⋙ wcEtBaseChange h2).sheafPushforwardContinuous
