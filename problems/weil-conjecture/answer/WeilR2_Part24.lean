    have hkill : ∀ (L : CochainComplex (SheafOfModules.{u+1}
        (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) ℤ)
        (Z : DerivedCategory (SheafOfModules.{u+1}
          (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))))
