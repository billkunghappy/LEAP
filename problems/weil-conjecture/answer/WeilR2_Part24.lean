          D.left.basicOpen (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨J.val + 1, by omega⟩)))
    (hπrel : ∀ (c J L : Fin (e + 1 + 1)) (O : D.left.Opens)
        (hO : O ≤ (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) J)
        (hOW : O ≤ (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
        (π ≫ jE₁).appLE (wcSgD K (e + 1) J) O hO (wcSgE K (e + 1) J L) *
          D.left.presheaf.map (homOfLE hOW).op (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨J.val + 1, by omega⟩)) =
        D.left.presheaf.map (homOfLE hOW).op (((iD ≫ Op.ι ≫ jE).app
            (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
              (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨L.val + 1, by omega⟩))) :
    ∀ (c : Fin (e + 1 + 1)) (J L : Fin (e + 2 + 1 + 1)) (O : D.left.Opens)
      (hO : O ≤ ((π ≫ σ) ≫ iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) J)
      (hOW : O ≤ (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩),
      ((π ≫ σ) ≫ iD ≫ Op.ι ≫ jE).appLE (wcSgD K (e + 2 + 1) J) O hO
          (wcSgE K (e + 2 + 1) J L) *
        D.left.presheaf.map (homOfLE hOW).op (wcScqCcV K e (iD ≫ Op.ι ≫ jE) c J) =
      D.left.presheaf.map (homOfLE hOW).op (wcScqCcV K e (iD ≫ Op.ι ≫ jE) c L) :=
by
  intro c J L O hO hOW
  have hdiag : ∀ (n : ℕ) (J : Fin (n + 1)), wcSgE K n J J = 1 := by
    intro n J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have h1 : HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1
        (MvPolynomial.X J) (hX J) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
        ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp⟩
    show Proj.awayToSection _ _ _ = 1
    rw [h1, map_one]
  have hu1 : ((iD ≫ Op.ι ≫ jE).app (wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩)).hom
      (wcSgE K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ⟨c.val + 1, by omega⟩) = 1 := by
    rw [hdiag, map_one]
  have hV1 : (iD ≫ Op.ι ≫ jE) ⁻¹ᵁ wcSgD K (e + 2 + 1) ⟨c.val + 1, by omega⟩ ≤
      (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) c := by
    have h := hπbo c c
    rw [hu1, Scheme.basicOpen_one] at h
    exact inf_eq_right.mp h
  have hOV : O ≤ (π ≫ jE₁) ⁻¹ᵁ wcSgD K (e + 1) c := hOW.trans hV1
  have hOU : O ≤ π ⁻¹ᵁ (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) :=
    hOV.trans (Scheme.Hom.comp_preimage π jE₁ _).le
  have key : ∀ P : Fin (e + 2 + 1 + 1),
      π.appLE (jE₁ ⁻¹ᵁ wcSgD K (e + 1) c) O hOU
        (if h : 1 ≤ P.val ∧ P.val ≤ e + 2 then
