    rw [hφX, hF1]
    simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
      Ideal.Quotient.mk_algebraMap]
  have hφev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 →
      φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r)) (MvPolynomial.X p)) =
