      (ζ' : (DerivedCategory.Q.obj C)⟦(N : ℤ)⟧ ≅ Z),
      (∀ f : Z ⟶ (DerivedCategory.Q.obj Ψ')⟦(N : ℤ)⟧, p ^ k • f = 0) →
