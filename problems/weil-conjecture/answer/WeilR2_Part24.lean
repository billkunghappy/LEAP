  obtain ⟨Z₀, i₀, hi₀c, hZ₀, hi₀⟩ := wc_etqm_srd_origin A n π hπ c
  haveI := hi₀c
  obtain ⟨D₀⟩ := wc_et_zmod_pull_data_exists i₀ (ℓ ^ k)
  obtain ⟨DP⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i₀ βs) (ℓ ^ k)
  haveI := hiY
  obtain ⟨DY⟩ := wc_et_zmod_pull_data_exists iY (ℓ ^ k)
  rcases Nat.eq_zero_or_pos k with hk0 | hkpos
  · intro P' K' eK' eΨ' Pβ hP'
    haveI := Dg'.additive
    haveI := Dh'.additive
    haveI := Dβ.additive
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dh'.adj
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing
