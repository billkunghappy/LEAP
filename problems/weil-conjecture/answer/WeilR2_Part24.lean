  haveI := Di.presColim
  let Pβ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange β) _ _ Dβ.cont Dβ.φ
  let PβZ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange βZ) _ _ DβZ.cont DβZ.φ
  letI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
  letI : PβZ.Additive := Adjunction.right_adjoint_additive DβZ.adj
  obtain ⟨Di'⟩ := wc_et_zmod_pull_data_exists i' m
  obtain ⟨DG⟩ := wc_et_zmod_pull_data_exists (𝟙 X') m
  haveI := Di'.additive
  haveI := Di'.presLim
  haveI := Di'.presColim
  haveI := DG.additive
  haveI := DG.presLim
  haveI := DG.presColim
  let PG := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (𝟙 X')) _ _ DG.cont DG.φ
  letI : PG.Additive := Adjunction.right_adjoint_additive DG.adj
  obtain ⟨hPGcolim, hPGunit⟩ := wc_etqm_srt_iso_push (𝟙 X') m DG
  haveI : Limits.PreservesFiniteColimits PG := hPGcolim
  haveI : Limits.PreservesFiniteLimits PG := by
    haveI : Limits.PreservesLimitsOfSize.{0, 0} PG := DG.adj.rightAdjoint_preservesLimits
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits PG
  haveI : DG.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape DG.Φ
  have hPGinj : ∀ A : SheafOfModules.{u+1} (wcEtZModRing X' m), Injective A → Injective (PG.obj A) :=
    fun A _ => Injective.injective_of_adjoint DG.adj A
  haveI := hPGunit
  let κG : PG.obj (SheafOfModules.unit (wcEtZModRing X' m)) ≅
      SheafOfModules.unit (wcEtZModRing X' m) :=
    (asIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (𝟙 X')) _ _
      DG.cont DG.φ)).symm

  obtain ⟨e1, -, he1⟩ := wc_lsi_exact_aug_quasiIso PG (SheafOfModules.unit (wcEtZModRing X' m))
    I.cocomplex I.ι I.quasiIso _ κG
  let I' : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X' m)) :=
    { cocomplex := (PG.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
      injective := fun n => hPGinj _ (I.injective n)
      ι := e1
      quasiIso := he1 }
  let h : HomotopyEquiv ((PG.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
      I.cocomplex := InjectiveResolution.homotopyEquiv I' I

  obtain ⟨e2, he2f, he2⟩ := wc_lsi_exact_aug_quasiIso Di'.Φ
    (SheafOfModules.unit (wcEtZModRing X' m))
    ((PG.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) e1 he1 _ Di'.μ
  obtain ⟨θ, hθ⟩ := wc_lsi_exact_aug_lift Di'.Φ (SheafOfModules.unit (wcEtZModRing X' m))
    ((PG.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) e1 he1 _ Di'.μ J
  have hcomp : e2 ≫ θ = J.ι := by
    apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f, he2f]
    simp only [Category.assoc]
    rw [hθ]
    simp only [Iso.inv_hom_id_assoc]
    first
      | exact Category.id_comp _
      | erw [Category.id_comp]
      | simp
  haveI := he2
  haveI : QuasiIso (e2 ≫ θ) := by rw [hcomp]; exact J.quasiIso
  haveI : QuasiIso θ := quasiIso_of_comp_left e2 θ

  obtain ⟨a⟩ := wc_mapHC_extend_iso PG I.cocomplex
  obtain ⟨b⟩ := wc_mapHC_extend_iso Di'.Φ
    ((PG.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
  let c := (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso a ≪≫ b
  let K := (PG.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
  let j : (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J.cochainComplex :=
    c.hom ≫ HomologicalComplex.extendMap θ ComplexShape.embeddingUpNat
  have hj : QuasiIso j := by
    have hc : QuasiIso c.hom := quasiIso_of_isIso _
    have he : QuasiIso (HomologicalComplex.extendMap θ ComplexShape.embeddingUpNat) :=
      (HomologicalComplex.quasiIso_extendMap_iff θ ComplexShape.embeddingUpNat).mpr inferInstance
    exact quasiIso_comp (hφ := hc) (hφ' := he)

  obtain ⟨δ, H⟩ := wc_etqm_srt_pbc_qiso β i i' βZ hsq (𝟙 X') m hm Dβ Di Di' DβZ DG I
  let u : (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((Pβ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ⟶
      (PβZ.mapHomologicalComplex (ComplexShape.up ℤ)).obj J.cochainComplex :=
    { f := fun p => δ.app (K.X p) ≫ PβZ.map (j.f p)
      comm' := fun p p' _ => by
        have h1 := δ.naturality (K.d p p')
        have h2 := j.comm p p'
        simp only [Functor.comp_map, Functor.mapHomologicalComplex_obj_d] at h1 h2 ⊢
        rw [reassoc_of% h1, ← PβZ.map_comp, ← h2]
        simp only [Functor.map_comp, Category.assoc] }
  have hu : QuasiIso u := H J.cochainComplex 0 inferInstance (fun p => inferInstance) j
    hj u (fun p => rfl)
  haveI : IsIso (HomologicalComplex.homologyMap u (q : ℤ)) :=
    (quasiIsoAt_iff_isIso_homologyMap u (q : ℤ)).mp (hu.quasiIsoAt (q : ℤ))
  let ω := asIso (HomologicalComplex.homologyMap u (q : ℤ))

  haveI : Di.Φ.PreservesHomology := Functor.preservesHomologyOfExact Di.Φ
  let ℓ1 : ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((Pβ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)).homology (q : ℤ) ≅
      Di.Φ.obj (((Pβ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology (q : ℤ)) :=
    (((Pβ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).sc (q : ℤ)).mapHomologyIso Di.Φ
  let ℓ2 := HomologicalComplex.homologyMapIso ((Pβ.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso a)
    (q : ℤ)
  obtain ⟨a3⟩ := wc_mapHC_extend_iso Pβ
    ((PG.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
  let ℓ3 := HomologicalComplex.homologyMapIso a3 (q : ℤ) ≪≫
    ((Pβ.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      ((PG.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)).extendHomologyIso
      ComplexShape.embeddingUpNat (ComplexShape.embeddingUpNat_f q)
  let ℓ4 := (Pβ.mapHomotopyEquiv h).toHomologyIso q

  obtain ⟨a4⟩ := wc_mapHC_extend_iso PβZ J.cocomplex
  let ρ := HomologicalComplex.homologyMapIso a4 (q : ℤ) ≪≫
    ((PβZ.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).extendHomologyIso
      ComplexShape.embeddingUpNat (ComplexShape.embeddingUpNat_f q)
  exact ⟨(ℓ1 ≪≫ Di.Φ.mapIso (ℓ2 ≪≫ ℓ3 ≪≫ ℓ4)).symm ≪≫ ω ≪≫ ρ⟩

theorem wc_srdcbR_epb_plane : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] (n : ℕ) (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (c : Matrix (Fin n) (Fin n) A), c = Matrix.of (fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) → ∃ (ρ : wcQuadModelRing A n π c →+* MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)) (jΛ : Spec (.of (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A))) ⟶ Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)), ρ.comp (algebraMap A (wcQuadModelRing A n π c)) = (MvPolynomial.C : IsLocalRing.ResidueField A →+* MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)).comp (IsLocalRing.residue A) ∧ (∀ p : Fin n, p.val % 2 = 0 → ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0) ∧ (∀ (p : Fin n) (hp : p.val % 2 = 1), ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = MvPolynomial.X ⟨p, hp⟩) ∧ IsClosedImmersion jΛ ∧ ⇑(Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) ⁻¹' PrimeSpectrum.zeroLocus {r | ∃ p : Fin n, p.val % 2 = 0 ∧ Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) = r} ⊆ Set.range jΛ ∧ jΛ ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) = Spec.map (CommRingCat.ofHom ρ) ∧ jΛ ≫ Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A) = Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A) (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)))) :=
by
  intro A _ _ _ n π hπ c hc
  classical

  obtain ⟨v, hv⟩ : ∃ v : Fin n → MvPolynomial {p : Fin n // p.val % 2 = 1}
      (IsLocalRing.ResidueField A),
      ∀ p, v p = if h : p.val % 2 = 1 then MvPolynomial.X ⟨p, h⟩ else 0 := ⟨_, fun _ => rfl⟩
  obtain ⟨ρ₀, hρ₀C, hρ₀X⟩ : ∃ ρ₀ : MvPolynomial (Fin n) A →+*
      MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A),
      (∀ a, ρ₀ (MvPolynomial.C a) = MvPolynomial.C (IsLocalRing.residue A a)) ∧
      (∀ p : Fin n, ρ₀ (MvPolynomial.X p) = v p) :=
    ⟨MvPolynomial.eval₂Hom (MvPolynomial.C.comp (IsLocalRing.residue A)) v,
      MvPolynomial.eval₂Hom_C _ v, MvPolynomial.eval₂Hom_X' _ v⟩
  have hπm : π ∈ IsLocalRing.maximalIdeal A := hπ ▸ Ideal.mem_span_singleton_self π
  have hresπ : IsLocalRing.residue A π = 0 := (IsLocalRing.residue_eq_zero_iff π).mpr hπm
  have hG : ρ₀ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C π) = 0 := by
    rw [map_sub, map_sum, hρ₀C, hresπ, map_zero, sub_zero]
    refine Finset.sum_eq_zero (fun p _ => ?_)
    rw [map_sum]
    refine Finset.sum_eq_zero (fun q _ => ?_)
    rw [map_mul, map_mul, hρ₀C, hρ₀X p, hc, Matrix.of_apply]
    by_cases h : p.val % 2 = 0 ∧ q.val = p.val + 1
    · rw [hv p, dif_neg (show ¬ p.val % 2 = 1 by omega)]
      simp
    · rw [if_neg h]
      simp
  have hI : ∀ t ∈ wcQuadModelIdeal A n π c, ρ₀ t = 0 := by
    intro t ht
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ht
    rw [map_mul, hG, mul_zero]
  obtain ⟨ρ, hρmk⟩ : ∃ ρ : wcQuadModelRing A n π c →+*
      MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A),
      ∀ t, ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) t) = ρ₀ t :=
    ⟨Ideal.Quotient.lift (wcQuadModelIdeal A n π c) ρ₀ hI, fun t => Ideal.Quotient.lift_mk _ _ _⟩
  have hAlg : ∀ a : A, algebraMap A (wcQuadModelRing A n π c) a =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a) := by
    intro a
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hρA : ρ.comp (algebraMap A (wcQuadModelRing A n π c)) =
      (MvPolynomial.C : IsLocalRing.ResidueField A →+*
        MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)).comp
        (IsLocalRing.residue A) := by
    refine RingHom.ext (fun a => ?_)
    rw [RingHom.comp_apply, RingHom.comp_apply, hAlg, hρmk, hρ₀C]
  have hρev : ∀ p : Fin n, p.val % 2 = 0 →
      ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0 := by
    intro p hp
    rw [hρmk, hρ₀X, hv, dif_neg (by omega)]
  have hρodd : ∀ (p : Fin n) (hp : p.val % 2 = 1),
      ρ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
        MvPolynomial.X ⟨p, hp⟩ := by
    intro p hp
    rw [hρmk, hρ₀X, hv, dif_pos hp]

  have hsurj : Function.Surjective ρ := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C a =>
      obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective a
      refine ⟨algebraMap A (wcQuadModelRing A n π c) a', ?_⟩
      rw [← RingHom.comp_apply, hρA, RingHom.comp_apply]
    | add f g hf hg =>
      obtain ⟨r, rfl⟩ := hf
      obtain ⟨r', rfl⟩ := hg
      exact ⟨r + r', map_add _ _ _⟩
    | mul_X f q hf =>
      obtain ⟨r, rfl⟩ := hf
      refine ⟨r * Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X q.1), ?_⟩
      rw [map_mul, hρodd q.1 q.2]

  have hker : ∀ P : Ideal (wcQuadModelRing A n π c),
      (∀ p : Fin n, p.val % 2 = 0 →
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈ P) →
      (∀ a ∈ IsLocalRing.maximalIdeal A, algebraMap A (wcQuadModelRing A n π c) a ∈ P) →
      RingHom.ker ρ ≤ P := by
    intro P hev hm
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : IsLocalRing.ResidueField A →+* wcQuadModelRing A n π c ⧸ P,
        ∀ a, ℓ (IsLocalRing.residue A a) =
          Ideal.Quotient.mk P (algebraMap A (wcQuadModelRing A n π c) a) :=
      ⟨Ideal.Quotient.lift (IsLocalRing.maximalIdeal A)
        ((Ideal.Quotient.mk P).comp (algebraMap A (wcQuadModelRing A n π c)))
        (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr (hm a ha)),
        fun a => Ideal.Quotient.lift_mk _ _ _⟩
    obtain ⟨g, hg⟩ : ∃ g : {p : Fin n // p.val % 2 = 1} → wcQuadModelRing A n π c ⧸ P,
        ∀ q, g q = Ideal.Quotient.mk P
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X q.1)) := ⟨_, fun _ => rfl⟩
    obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial {p : Fin n // p.val % 2 = 1}
        (IsLocalRing.ResidueField A) →+* wcQuadModelRing A n π c ⧸ P,
        (∀ x, ψ (MvPolynomial.C x) = ℓ x) ∧ (∀ q, ψ (MvPolynomial.X q) = g q) :=
      ⟨MvPolynomial.eval₂Hom ℓ g, MvPolynomial.eval₂Hom_C ℓ g, MvPolynomial.eval₂Hom_X' ℓ g⟩
    have hψ : ψ.comp ρ = Ideal.Quotient.mk P := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply]
        rw [hρmk, hρ₀C, hψC, hℓ, hAlg]
      · intro p
        simp only [RingHom.comp_apply]
        rcases Nat.mod_two_eq_zero_or_one p.val with h | h
        · rw [hρev p h, map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr (hev p h)).symm
        · rw [hρodd p h, hψX, hg]
    intro t ht
    rw [RingHom.mem_ker] at ht
    have h0 : Ideal.Quotient.mk P t = 0 := by
      rw [← hψ, RingHom.comp_apply, ht, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp h0

  have hw : Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A n π c =
      Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)))) ≫
        wcQmSp A := by
    show Spec.map (CommRingCat.ofHom ρ) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c))) =
      Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)))) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      MvPolynomial.algebraMap_eq, hρA]
  obtain ⟨jΛ, hfst, hsnd⟩ : ∃ jΛ : Spec (.of (MvPolynomial {p : Fin n // p.val % 2 = 1}
      (IsLocalRing.ResidueField A))) ⟶ Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A),
      jΛ ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) =
        Spec.map (CommRingCat.ofHom ρ) ∧
      jΛ ≫ Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A) =
        Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
          (MvPolynomial {p : Fin n // p.val % 2 = 1} (IsLocalRing.ResidueField A)))) :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hfstci : IsClosedImmersion (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) :=
    inferInstance
  have hci : IsClosedImmersion jΛ := by
    haveI : IsClosedImmersion (jΛ ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) := by
      rw [hfst]
      exact IsClosedImmersion.spec_of_surjective _ hsurj
    exact IsClosedImmersion.of_comp_isClosedImmersion jΛ
      (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A))
  have hrange : ⇑(Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) ⁻¹'
      PrimeSpectrum.zeroLocus {r | ∃ p : Fin n, p.val % 2 = 0 ∧
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) = r} ⊆
      Set.range jΛ := by
    intro w hw'
    have hS : ∀ p : Fin n, p.val % 2 = 0 →
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
          ((Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) w).asIdeal :=
      fun p hp => hw' ⟨p, hp, rfl⟩
    have hcond : (wcQuadModelStr A n π c)
        ((Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) w) =
        (wcQmSp A) ((Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A)) w) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have hcond' := congrArg PrimeSpectrum.asIdeal hcond
    have hm : ∀ a ∈ IsLocalRing.maximalIdeal A, algebraMap A (wcQuadModelRing A n π c) a ∈
        ((Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) w).asIdeal := by
      intro a ha
      have h1 : a ∈ Ideal.comap (IsLocalRing.residue A)
          ((Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A)) w).asIdeal := by
        rw [Ideal.mem_comap, (IsLocalRing.residue_eq_zero_iff a).mpr ha]
        exact Ideal.zero_mem _
      have h2 : a ∈ Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
          ((Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) w).asIdeal := by
        have e : Ideal.comap (algebraMap A (wcQuadModelRing A n π c))
            ((Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) w).asIdeal =
            Ideal.comap (IsLocalRing.residue A)
            ((Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A)) w).asIdeal := hcond'
        rw [e]
        exact h1
      exact Ideal.mem_comap.mp h2
    have hk := hker _ hS hm
    have hmem : (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) w ∈
        Set.range (PrimeSpectrum.comap ρ) := by
      rw [range_comap_of_surjective _ ρ hsurj]
      exact (PrimeSpectrum.mem_zeroLocus _ _).mpr hk
    obtain ⟨z, hz⟩ := hmem
    have e : (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) (jΛ z) =
        (Spec.map (CommRingCat.ofHom ρ)) z := by
      first
        | (rw [← hfst]; rfl)
        | (have h0 := Scheme.Hom.comp_apply jΛ
              (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) z
           rw [hfst] at h0
           exact h0.symm)
        | simp [← hfst]
    exact ⟨z, (Limits.pullback.fst (wcQuadModelStr A n π c)
      (wcQmSp A)).isClosedEmbedding.isEmbedding.injective (e.trans hz)⟩
  exact ⟨ρ, jΛ, hρA, hρev, hρodd, hci, hrange, hfst, hsnd⟩

