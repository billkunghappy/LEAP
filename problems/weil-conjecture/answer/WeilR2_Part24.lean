by
  classical
  have hπm : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]; exact Ideal.mem_span_singleton_self π
  have key : ∀ c₀ : Matrix (Fin n) (Fin n) A, ∃ y₀ : Spec (.of (wcQuadModelRing A n π c₀)),
      (∀ p : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c₀) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal y₀) ∧
      (wcQuadModelStr A n π c₀) y₀ = (wcQmSp A)
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    intro c₀
    let φ : MvPolynomial (Fin n) A →+* IsLocalRing.ResidueField A :=
      MvPolynomial.eval₂Hom (IsLocalRing.residue A) (fun _ => 0)
    have hI : ∀ a ∈ wcQuadModelIdeal A n π c₀, φ a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp [φ, hπm]
    let ψ : wcQuadModelRing A n π c₀ →+* IsLocalRing.ResidueField A :=
      Ideal.Quotient.lift _ φ hI
    have hψ : ∀ a, ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c₀) a) = φ a := fun a =>
      Ideal.Quotient.lift_mk _ _ _
    refine ⟨⟨RingHom.ker ψ, RingHom.ker_isPrime ψ⟩, fun p => ?_, ?_⟩
    · show ψ _ = 0
      rw [hψ]
      simp [φ]
    · dsimp only [wcQuadModelStr, wcQmSp]
      erw [Spec.map_apply, Spec.map_apply]
      apply PrimeSpectrum.ext
      erw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal]
      ext a
      rw [Ideal.mem_comap, Ideal.mem_comap]
      show ψ (algebraMap A (wcQuadModelRing A n π c₀) a) = 0 ↔ _
      rw [← Ideal.Quotient.mk_algebraMap, hψ, MvPolynomial.algebraMap_eq]
      simp only [φ, MvPolynomial.eval₂Hom_C, CommRingCat.hom_ofHom]
      show _ ↔ IsLocalRing.residue A a ∈ IsLocalRing.maximalIdeal (IsLocalRing.ResidueField A)
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]
  obtain ⟨y₀, hX, hy⟩ := key (Matrix.of fun i j : Fin n => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
  have H2 := (hP ⟨0, by omega⟩ y₀).mpr ⟨hX _, hX _, fun p _ _ => hX p⟩
  have hf : f' (e ⟨0, by omega⟩ y₀) = (wcQmSp A)
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    rw [← hy, ← he_str ⟨0, by omega⟩, ← hf']
    simp only [Scheme.Hom.comp_apply]
  obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hf
  refine ⟨z, fun p => ?_⟩
  rw [Scheme.Hom.comp_apply, hz1, ← Scheme.Hom.comp_apply]
  exact H2 p

