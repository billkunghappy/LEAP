    intro i j h1 h2
    rw [hcs]
    simp only [hcoll i h1]
    exact (hPmid j h2.1 h2.2).2
  have hcM : Matrix.of c = P.transpose * Matrix.of a * P := by
    ext i j
    rfl
  have hnd : (Matrix.of c + (Matrix.of c).transpose).det ≠ 0 := by
    have hS : Matrix.of c + (Matrix.of c).transpose =
        P.transpose * (Matrix.of a + (Matrix.of a).transpose) * P := by
      rw [hcM]
      simp only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_add,
        Matrix.add_mul, Matrix.mul_assoc]
    rw [hS, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    exact mul_ne_zero (mul_ne_zero hP ha) hP
  have h0 : ∀ j : Fin (e + 2 + 1 + 1), 1 ≤ j.val → j.val ≤ e + 2 → c 0 j + c j 0 = 0 :=
    fun j hj1 hj2 => F0m 0 j (by simp) ⟨hj1, hj2⟩
  have hl : ∀ j : Fin (e + 2 + 1 + 1), 1 ≤ j.val → j.val ≤ e + 2 →
      c ⟨e + 3, by omega⟩ j + c j ⟨e + 3, by omega⟩ = 0 :=
    fun j hj1 hj2 => Flm ⟨e + 3, by omega⟩ j rfl ⟨hj1, hj2⟩
  have hPP : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P (isUnit_iff_ne_zero.mpr hP)
  have hPP' : P⁻¹ * P = 1 := Matrix.nonsing_inv_mul P (isUnit_iff_ne_zero.mpr hP)
  let a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K := fun i j =>
    c ⟨i.val + 1, by have := i.isLt; omega⟩ ⟨j.val + 1, by have := j.isLt; omega⟩
  have hnd' : (Matrix.of a' + (Matrix.of a').transpose).det ≠ 0 := s7 c hnd h0 hl
  obtain ⟨b, hb⟩ : ∃ b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K,
      ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0 :=
    ⟨_, fun _ _ => rfl⟩
  have hcmid : ∀ (i j : Fin (e + 2 + 1 + 1)) (hi : 1 ≤ i.val ∧ i.val ≤ e + 2)
      (hj : 1 ≤ j.val ∧ j.val ≤ e + 2) (p1 : i.val - 1 < e + 1 + 1) (p2 : j.val - 1 < e + 1 + 1),
      a' ⟨i.val - 1, p1⟩ ⟨j.val - 1, p2⟩ = c i j := by
    intro i j hi hj p1 p2
    show c ⟨i.val - 1 + 1, _⟩ ⟨j.val - 1 + 1, _⟩ = c i j
    exact congrArg₂ c (Fin.ext (by show i.val - 1 + 1 = i.val; omega))
      (Fin.ext (by show j.val - 1 + 1 = j.val; omega))
  have hb1 : ∀ i j : Fin (e + 2 + 1 + 1), i.val = 0 → j.val = e + 3 → b i j = 1 := by
    intro i j h1 h2
    rw [hb, if_pos ⟨h1, h2⟩]
  have hb2 : ∀ i j : Fin (e + 2 + 1 + 1), (1 ≤ i.val ∧ i.val ≤ e + 2) →
      (1 ≤ j.val ∧ j.val ≤ e + 2) → b i j = c i j := by
    intro i j h1 h2
    rw [hb, if_neg (show ¬(i.val = 0 ∧ j.val = e + 3) by omega),
      dif_pos (show 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 by omega)]
    exact hcmid i j h1 h2 _ _
  have hb3 : ∀ i j : Fin (e + 2 + 1 + 1), ¬(i.val = 0 ∧ j.val = e + 3) →
      ¬((1 ≤ i.val ∧ i.val ≤ e + 2) ∧ (1 ≤ j.val ∧ j.val ≤ e + 2)) → b i j = 0 := by
    intro i j h1 h2
    rw [hb, if_neg h1,
      dif_neg (show ¬(1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2) by omega)]
  have hdiag : ∀ i, b i i = c i i := by
    intro i
    have hi := i.isLt
    rcases (by omega : i.val = 0 ∨ (1 ≤ i.val ∧ i.val ≤ e + 2) ∨ i.val = e + 3) with h | h | h
    · rw [hb3 i i (by omega) (by omega), F00 i h]
    · exact hb2 i i h h
    · rw [hb3 i i (by omega) (by omega), Fll i h]
  have hsym : ∀ i j, b i j + b j i = c i j + c j i := by
    intro i j
    have hi := i.isLt
    have hj := j.isLt
    rcases (by omega : i.val = 0 ∨ (1 ≤ i.val ∧ i.val ≤ e + 2) ∨ i.val = e + 3) with h1 | h1 | h1 <;>
    rcases (by omega : j.val = 0 ∨ (1 ≤ j.val ∧ j.val ≤ e + 2) ∨ j.val = e + 3) with h2 | h2 | h2
    · obtain rfl : i = j := Fin.ext (by omega)
      rw [hdiag]
    · rw [hb3 i j (by omega) (by omega), hb3 j i (by omega) (by omega), F0m i j h1 h2]
      ring
    · rw [hb1 i j h1 h2, hb3 j i (by omega) (by omega), F0l i j h1 h2]
      ring
    · rw [hb3 i j (by omega) (by omega), hb3 j i (by omega) (by omega), add_comm (c i j),
        F0m j i h2 h1]
      ring
    · rw [hb2 i j h1 h2, hb2 j i h2 h1]
    · rw [hb3 i j (by omega) (by omega), hb3 j i (by omega) (by omega), add_comm (c i j),
        Flm j i h2 h1]
      ring
    · rw [hb3 i j (by omega) (by omega), hb1 j i h2 h1, add_comm (c i j), F0l j i h2 h1]
      ring
    · rw [hb3 i j (by omega) (by omega), hb3 j i (by omega) (by omega), Flm i j h1 h2]
      ring
    · obtain rfl : i = j := Fin.ext (by omega)
      rw [hdiag]
  have hR : P⁻¹.transpose * Matrix.of c * P⁻¹ = Matrix.of a := by
    rw [hcM]
    have e1 : P⁻¹.transpose * P.transpose = 1 := by
      rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one]
    calc P⁻¹.transpose * (P.transpose * Matrix.of a * P) * P⁻¹
        = (P⁻¹.transpose * P.transpose) * Matrix.of a * (P * P⁻¹) := by
          simp only [Matrix.mul_assoc]
      _ = Matrix.of a := by rw [e1, hPP, Matrix.one_mul, Matrix.mul_one]
  refine ⟨a', b, fun i => ∑ j, MvPolynomial.C (P⁻¹ i j) * MvPolynomial.X j,
    fun i => ∑ j, MvPolynomial.C (P i j) * MvPolynomial.X j, hnd', hb,
    fun i => MvPolynomial.IsHomogeneous.sum _ _ _
      (fun j _ => MvPolynomial.isHomogeneous_C_mul_X _ _),
    fun i => MvPolynomial.IsHomogeneous.sum _ _ _
      (fun j _ => MvPolynomial.isHomogeneous_C_mul_X _ _),
    fun i => s2 _ P P⁻¹ hPP i,
    fun i => s2 _ P⁻¹ P hPP' i, ?_⟩
  rw [hQ b, hQ a, s3 _ b c hdiag hsym, s1 _ c P⁻¹, hR]
  simp only [Matrix.of_apply]

theorem wc_quadric_linear_reembed (K : Type u) [Field K] (N : ℕ) (X : Scheme.{u})
    (jE : X ⟶ wcProjK K N) (hjE : IsClosedImmersion jE)
    (a b : Fin (N + 1) → Fin (N + 1) → K) (L M : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)
    (hL : ∀ i, (L i).IsHomogeneous 1) (hM : ∀ i, (M i).IsHomogeneous 1)
    (hLM : ∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i)
    (hML : ∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i)
    (hab : MvPolynomial.aeval L ((wcLdpQuad K N b : MvPolynomial (Fin (N + 1)) K)) =
      (wcLdpQuad K N a : MvPolynomial (Fin (N + 1)) K))
    (hEG : ∀ (x : X) (c : Fin (N + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K N c),
      wcLdpGerm K N jE (wcLdpQuad K N a) c x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (hEall : ∀ p : wcProjK K N, (∀ (c : Fin (N + 1)) (hp : p ∈ wcSgD K N c),
        ((wcProjK K N).presheaf.germ (wcSgD K N c) p hp).hom (wcLdpSec K N (wcLdpQuad K N a) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K N).presheaf.stalk p)) → p ∈ Set.range jE) :
    ∃ jE' : X ⟶ wcProjK K N, IsClosedImmersion jE' ∧
      jE' ≫ wcProjKStr K N = jE ≫ wcProjKStr K N ∧
      (∀ (x : X) (c : Fin (N + 1)) (hx : x ∈ jE' ⁻¹ᵁ wcSgD K N c),
        wcLdpGerm K N jE' (wcLdpQuad K N b) c x hx ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) ∧
      (∀ p : wcProjK K N, (∀ (c : Fin (N + 1)) (hp : p ∈ wcSgD K N c),
        ((wcProjK K N).presheaf.germ (wcSgD K N c) p hp).hom (wcLdpSec K N (wcLdpQuad K N b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K N).presheaf.stalk p)) → p ∈ Set.range jE') :=
by
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have bc : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      (f₀ : ↥(𝒜 0) →+* ↥(ℬ 0)), (∀ a : ↥(𝒜 0), ((f₀ a : ↥(ℬ 0)) : B) = f (a : A)) →
      Proj.map f hf ≫ Proj.toSpecZero 𝒜 = Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom f₀) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf f₀ hf₀
    have s1 : ∀ s : A, (HomogeneousLocalization.Away.map f s).comp
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers s)) =
        (HomogeneousLocalization.fromZeroRingHom ℬ (Submonoid.powers (f s))).comp f₀ := by
      intro s
      refine RingHom.ext (fun a => ?_)
      apply HomogeneousLocalization.val_injective
      simp only [RingHom.comp_apply]
      show (HomogeneousLocalization.Away.map f s (HomogeneousLocalization.mk ⟨0, a, 1, _⟩)).val =
        (HomogeneousLocalization.mk ⟨0, f₀ a, 1, _⟩ :
          HomogeneousLocalization ℬ (Submonoid.powers (f s))).val
      rw [HomogeneousLocalization.Away.map, HomogeneousLocalization.map_mk,
        HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
      simp only [SetLike.GradeZero.coe_one, map_one, hf₀]
    have s2 : ∀ x : Proj ℬ, ∃ i, ∃ s ∈ 𝒜 i, 0 < i ∧ x ∈ Proj.basicOpen ℬ (f s) := by
      intro x
      by_contra hcon
      push_neg at hcon
      apply ProjectiveSpectrum.not_irrelevant_le (x : ProjectiveSpectrum ℬ)
      intro b hb
      have hb' := hf hb
      have hle : (HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜)).toIdeal ≤
          (x : ProjectiveSpectrum ℬ).asHomogeneousIdeal.toIdeal := by
        rw [HomogeneousIdeal.toIdeal_map, HomogeneousIdeal.irrelevant_eq_span, Ideal.map_span,
          Ideal.span_le]
        rintro _ ⟨y, hy, rfl⟩
        simp only [Set.mem_iUnion] at hy
        obtain ⟨i, hi, hyi⟩ := hy
        have h1 := hcon i y hyi hi
        rw [Proj.mem_basicOpen] at h1
        push_neg at h1
        exact h1
      exact hle hb'
    let 𝒰 : (Proj ℬ).OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion)
        {p : ℕ × A // p.2 ∈ 𝒜 p.1 ∧ 0 < p.1}
        (fun j => Spec (.of (HomogeneousLocalization.Away ℬ (f j.1.2))))
        (fun j => Proj.awayι ℬ (f j.1.2) (f.map_mem j.2.1) j.2.2) (fun x => by
          obtain ⟨i, s, hs, hi, hx⟩ := s2 x
          rw [← Proj.opensRange_awayι ℬ (f s) (f.map_mem hs) hi] at hx
          obtain ⟨y, hy⟩ := hx
          exact ⟨⟨(i, s), hs, hi⟩, y, hy⟩)
    refine Scheme.Cover.hom_ext 𝒰 _ _ (fun j => ?_)
    obtain ⟨⟨i, s⟩, hs, hi⟩ := j
    have hs' : s ∈ 𝒜 i := hs
    have hi' : 0 < i := hi
    show Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _ = Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _
    rw [Proj.awayι_comp_map_assoc f hf hi' s hs', Proj.awayι_toSpecZero, Proj.awayι_toSpecZero_assoc,
      ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, s1]

  have hcc : ∀ (P : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K), (∀ i, (P i).IsHomogeneous 1) →
      ∀ p : MvPolynomial (Fin (N + 1)) K,
        MvPolynomial.constantCoeff (MvPolynomial.aeval P p) = MvPolynomial.constantCoeff p := by
    intro P hP p
    induction p using MvPolynomial.induction_on with
    | C r => rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
    | mul_X p i hp =>
      have h0 : MvPolynomial.constantCoeff (P i) = 0 := by
        rw [MvPolynomial.constantCoeff_eq]
        exact (hP i).coeff_eq_zero (by simp)
      rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, h0]
  have hirr : ∀ a : MvPolynomial (Fin (N + 1)) K,
      a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ↔
        MvPolynomial.constantCoeff a = 0 := by
    intro a
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    change ((MvPolynomial.decomposition.decompose' a 0 : MvPolynomial (Fin (N + 1)) K)) = 0 ↔ _
    rw [MvPolynomial.decomposition.decompose'_apply, MvPolynomial.homogeneousComponent_zero,
      MvPolynomial.C_eq_zero, MvPolynomial.constantCoeff_eq]
  let Φ : ∀ P : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K, (∀ i, (P i).IsHomogeneous 1) →
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    fun P hP => GradedRingHom.mk (MvPolynomial.aeval P).toRingHom (fun {n} {x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      simpa using hx.aeval P hP)
  have hΦ : ∀ P hP (x : MvPolynomial (Fin (N + 1)) K), Φ P hP x = MvPolynomial.aeval P x :=
    fun _ _ _ => rfl
  have hinv : ∀ P P' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K,
      (∀ i, MvPolynomial.aeval P (P' i) = MvPolynomial.X i) →
      ∀ x, MvPolynomial.aeval P (MvPolynomial.aeval P' x) = x := by
    intro P P' h x
    have e : (MvPolynomial.aeval P).comp (MvPolynomial.aeval P') =
        AlgHom.id K (MvPolynomial (Fin (N + 1)) K) :=
      MvPolynomial.algHom_ext (fun i => by
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X, h i, AlgHom.id_apply])
    exact AlgHom.congr_fun e x
  have hcond : ∀ (P P' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)
      (hP : ∀ i, (P i).IsHomogeneous 1),
      (∀ i, (P' i).IsHomogeneous 1) →
      (∀ i, MvPolynomial.aeval P (P' i) = MvPolynomial.X i) →
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≤
        HomogeneousIdeal.map (Φ P hP)
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) := by
    intro P P' hP hP' h a ha
    have hb : MvPolynomial.aeval P' a ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      (hirr _).mpr (by rw [hcc P' hP', (hirr a).mp ha])
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map]
    have hm := Ideal.mem_map_of_mem (Φ P hP) (HomogeneousIdeal.mem_iff.mpr hb)
    rwa [hΦ P hP, hinv P P' h] at hm
  have hcomp : ∀ (P P' : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)
      (hP : ∀ i, (P i).IsHomogeneous 1) (hP' : ∀ i, (P' i).IsHomogeneous 1),
      (∀ i, MvPolynomial.aeval P (P' i) = MvPolynomial.X i) →
      (Φ P hP).comp (Φ P' hP') = GradedRingHom.id _ := by
    intro P P' hP hP' h
    apply GradedRingHom.ext
    intro x
    rw [GradedRingHom.comp_apply, GradedRingHom.id_apply, hΦ P' hP', hΦ P hP, hinv P P' h]
  have key : ∀ (f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hf,
      f = GradedRingHom.id _ → Proj.map f hf = 𝟙 _ := by
    rintro f hf rfl
    exact Proj.map_id
  have hL' := hcond L M hL hM hLM
  have hM' := hcond M L hM hL hML
  have h0 : ∀ a : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0),
      (((RingHom.id _) a : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) :
        MvPolynomial (Fin (N + 1)) K) = Φ L hL (a : MvPolynomial (Fin (N + 1)) K) := by
    intro a
    rw [hΦ L hL, RingHom.id_apply]
    have ha : (a : MvPolynomial (Fin (N + 1)) K).IsHomogeneous 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 _).mp a.2
    have htd : (a : MvPolynomial (Fin (N + 1)) K).totalDegree = 0 :=
      Nat.le_zero.mp ha.totalDegree_le
    rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at htd
    rw [htd, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
  obtain ⟨g, hgiso, hgstr, hgpre⟩ : ∃ g : wcProjK K N ⟶ wcProjK K N, IsIso g ∧
      g ≫ wcProjKStr K N = wcProjKStr K N ∧
      ∀ s : MvPolynomial (Fin (N + 1)) K,
        g ⁻¹ᵁ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s) =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.aeval L s) := by
    refine ⟨Proj.map (Φ L hL) hL', ⟨Proj.map (Φ M hM) hM', ?_, ?_⟩, ?_, ?_⟩
    · rw [← Proj.map_comp]
      exact key _ _ (hcomp L M hL hM hLM)
    · rw [← Proj.map_comp]
      exact key _ _ (hcomp M L hM hL hML)
    · have hb := bc (Φ L hL) hL' (RingHom.id _) h0
      have e1 : CommRingCat.ofHom
          (RingHom.id ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) = 𝟙 _ :=
        CommRingCat.ofHom_id
      rw [wcProjKStr, ← Category.assoc, hb]
      simp only [e1, Spec.map_id, Category.comp_id]
    · intro s
      rw [Proj.map_preimage_basicOpen, hΦ L hL]
  haveI := hgiso

  have hcovtop : (⨆ c : Fin (N + 1), wcSgD K N c) = ⊤ := by
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hcov : ∀ q : wcProjK K N, ∃ c, q ∈ wcSgD K N c := by
    intro q
    have hq : q ∈ (⨆ c : Fin (N + 1), wcSgD K N c) := by rw [hcovtop]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hq

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 2),
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g =
        (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg two_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv
            (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 2 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have hXc : ∀ c : Fin (N + 1), (MvPolynomial.X c : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun c =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)
  have s2 : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (c : Fin (N + 1))
      (p : wcProjK K N) (hp : p ∈ wcSgD K N c),
      ((wcProjK K N).presheaf.germ (wcSgD K N c) p hp).hom (wcLdpSec K N G c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K N).presheaf.stalk p) ↔
        p ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (G : MvPolynomial (Fin (N + 1)) K) := by
    intro G c p hp
    have hL1 := L1 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X c)
      (G : MvPolynomial (Fin (N + 1)) K) (hXc c) G.2
    have e := Scheme.mem_basicOpen (wcProjK K N) (wcLdpSec K N G c) p hp
    have e' : p ∈ wcSgD K N c ⊓ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (G : MvPolynomial (Fin (N + 1)) K) ↔
        IsUnit (((wcProjK K N).presheaf.germ (wcSgD K N c) p hp).hom (wcLdpSec K N G c)) :=
      (SetLike.ext_iff.mp hL1 p).trans e
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro h hpD
      exact h (e'.mp ⟨hp, hpD⟩)
    · intro h hu
      exact h (e'.mpr hu).2

  have s4 : ∀ {Y : Scheme.{u}} (ι : Y ⟶ wcProjK K N)
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (c : Fin (N + 1)) (x : Y)
      (hx : x ∈ ι ⁻¹ᵁ wcSgD K N c),
      wcLdpGerm K N ι G c x hx ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) ↔
        ((wcProjK K N).presheaf.germ (wcSgD K N c) (ι x) hx).hom (wcLdpSec K N G c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K N).presheaf.stalk (ι x)) := by
    intro Y ι G c x hx
    have h : wcLdpGerm K N ι G c x hx = (ι.stalkMap x).hom
        (((wcProjK K N).presheaf.germ (wcSgD K N c) (ι x) hx).hom (wcLdpSec K N G c)) :=
      (Scheme.Hom.germ_stalkMap_apply ι _ x hx _).symm
    rw [h, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
    exact map_mem_nonunits_iff (ι.stalkMap x).hom _

  have Zp : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 2) (q : wcProjK K N),
      (∀ (c : Fin (N + 1)) (hq : q ∈ wcSgD K N c),
        ((wcProjK K N).presheaf.germ (wcSgD K N c) q hq).hom (wcLdpSec K N G c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K N).presheaf.stalk q)) ↔
        q ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (G : MvPolynomial (Fin (N + 1)) K) := by
    intro G q
    constructor
    · intro h
      obtain ⟨c, hc⟩ := hcov q
      exact (s2 G c q hc).mp (h c hc)
    · intro h c hc
      exact (s2 G c q hc).mpr h

  have KF : ∀ q : wcProjK K N,
      g q ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (wcLdpQuad K N b : MvPolynomial (Fin (N + 1)) K) ↔
        q ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (wcLdpQuad K N a : MvPolynomial (Fin (N + 1)) K) := by
    intro q
    rw [← hab, ← hgpre]
    exact Iff.rfl

  haveI := hjE
  refine ⟨jE ≫ g, inferInstance, by rw [Category.assoc, hgstr], ?_, ?_⟩
  · intro x c hx
    rw [s4 (jE ≫ g) _ c x hx]
    have h1 : jE x ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (wcLdpQuad K N a : MvPolynomial (Fin (N + 1)) K) :=
      (Zp _ (jE x)).mp (fun c' hc' => (s4 jE _ c' x hc').mp (hEG x c' hc'))
    have h2 : g (jE x) ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (wcLdpQuad K N b : MvPolynomial (Fin (N + 1)) K) := fun h => h1 ((KF _).mp h)
    exact (s2 _ c ((jE ≫ g) x) hx).mpr h2
  · intro p hp
    have h1 := (Zp _ p).mp hp
    have hgq : g ((inv g) p) = p := by
      have : (inv g ≫ g) p = p := by rw [IsIso.inv_hom_id] <;> rfl
      exact this
    have h2 : (inv g) p ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (wcLdpQuad K N a : MvPolynomial (Fin (N + 1)) K) := by
      intro h
      apply h1
      rw [← hgq]
      exact (KF _).mpr h
    obtain ⟨x, hx⟩ := hEall ((inv g) p) ((Zp _ _).mpr h2)
    exact ⟨x, by rw [Scheme.Hom.comp_apply, hx, hgq]⟩

theorem wc_vrp_origin_point (K : Type u) [Field K] (n : ℕ) :
    ∃ x₀ : Spec (.of K) ⟶ wcProjK K n, x₀ ≫ wcProjKStr K n = 𝟙 _ ∧
      x₀ (IsLocalRing.closedPoint K) ∈ wcSgD K n 0 ∧
      ∀ j : Fin (n + 1), j ≠ 0 → x₀ (IsLocalRing.closedPoint K) ∉ wcSgD K n j :=
by
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ b : Fin (n + 1), (MvPolynomial.X b : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 :=
    fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)

  obtain ⟨g, hgdef⟩ : ∃ g : MvPolynomial (Fin (n + 1)) K →+* K,
      g = MvPolynomial.eval (Pi.single 0 1) := ⟨_, rfl⟩
  have g1 : g (MvPolynomial.X 0) = 1 := by
    rw [hgdef, MvPolynomial.eval_X, Pi.single_eq_same]
  have g2 : ∀ j : Fin (n + 1), j ≠ 0 → g (MvPolynomial.X j) = 0 := by
    intro j hj
    rw [hgdef, MvPolynomial.eval_X, Pi.single_eq_of_ne hj]
  have g3 : ∀ c : K, g (MvPolynomial.C c) = c := by
    intro c
    rw [hgdef, MvPolynomial.eval_C]
  have hu : IsUnit (g (MvPolynomial.X 0)) := by rw [g1]; exact isUnit_one
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) →+* K,
      ψ = IsLocalization.Away.lift (MvPolynomial.X 0) hu := ⟨_, rfl⟩
  have hψ : ∀ a, ψ (algebraMap _ _ a) = g a := fun a => by
    rw [hψdef]; exact IsLocalization.Away.lift_eq _ hu a
  have hmk : ∀ (x : MvPolynomial (Fin (n + 1)) K)
      (s : Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K)),
      ψ (Localization.mk x s) * g s = g x := by
    intro x s
    rw [← hψ, ← hψ, ← map_mul, Localization.mk_eq_mk', IsLocalization.mk'_spec]
  obtain ⟨φ, hφdef⟩ : ∃ φ : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X 0) →+* K,
      φ = ψ.comp (algebraMap _ _) := ⟨_, rfl⟩
  have hφ : ∀ z, φ z = ψ z.val := fun z => by
    rw [hφdef, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]

  have s2 : ∀ c : K, φ (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X 0))
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) = c := by
    intro c
    have hC : (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := by
      rw [Localization.mk_one_eq_algebraMap]; rfl
    rw [hφ, hC, Localization.mk_one_eq_algebraMap, hψ, g3]

  have s3 : ∀ j : Fin (n + 1), j ≠ 0 →
      φ (HomogeneousLocalization.Away.isLocalizationElem (hX 0) (hX j)) = 0 := by
    intro j hj
    rw [hφ]
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
    have key : ∀ s : Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K),
        (s : MvPolynomial (Fin (n + 1)) K) = MvPolynomial.X 0 ^ 1 →
        ψ (Localization.mk (MvPolynomial.X j ^ 1) s) = 0 := by
      intro s hs
      have h := hmk (MvPolynomial.X j ^ 1) s
      rw [hs, map_pow, map_pow, g1, g2 j hj, one_pow, mul_one, zero_pow one_ne_zero] at h
      exact h
    exact key _ rfl

  refine ⟨Spec.map (CommRingCat.ofHom φ) ≫ Proj.awayι
    (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X 0) (hX 0) one_pos,
    ?_, ?_, ?_⟩
  · have h1 : (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X 0)))) ≫ CommRingCat.ofHom φ =
        𝟙 (CommRingCat.of K) := by
      ext c
      simpa using s2 c
    simp only [Category.assoc, wcProjKStr]
    rw [Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← Spec.map_comp, h1, Spec.map_id]

  · have key : ∀ z : Spec (.of K), (Spec.map (CommRingCat.ofHom φ) ≫ Proj.awayι
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X 0) (hX 0) one_pos) z ∈
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (MvPolynomial.X 0) := by
      intro z
      rw [← Proj.opensRange_awayι _ _ (hX 0) one_pos, Scheme.Hom.comp_apply]
      exact Scheme.Hom.mem_opensRange.mpr ⟨_, rfl⟩
    exact key _

  · intro j hj
    have key : ∀ z : Spec (.of K), (Spec.map (CommRingCat.ofHom φ) ≫ Proj.awayι
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X 0) (hX 0) one_pos) z ∈
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (MvPolynomial.X j) → False := by
      intro z hz
      rw [Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage,
        Proj.awayι_preimage_basicOpen _ (hX 0) one_pos (hX j) one_pos] at hz
      have hz' := (PrimeSpectrum.mem_basicOpen _ _).mp hz
      apply hz'
      rw [Spec.map_apply]
      exact Ideal.mem_comap.mpr (by rw [CommRingCat.hom_ofHom, s3 j hj]; exact zero_mem _)
    exact key _

theorem wc_vrp_axis_point_unique (K : Type u) [Field K] (n : ℕ) (q q' : wcProjK K n)
    (hq : ∀ j : Fin (n + 1), j ≠ 0 → q ∉ wcSgD K n j)
    (hq' : ∀ j : Fin (n + 1), j ≠ 0 → q' ∉ wcSgD K n j) : q = q' :=
by
  classical
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))
  set P0 : Ideal (MvPolynomial (Fin (n + 1)) K) :=
    Ideal.span (MvPolynomial.X '' {j : Fin (n + 1) | j ≠ 0}) with hP0
  have s1 : ∀ (d : ℕ) (f : MvPolynomial (Fin (n + 1)) K), f.IsHomogeneous d →
      f - MvPolynomial.C (f.coeff (Finsupp.single 0 d)) * MvPolynomial.X 0 ^ d ∈ P0 := by
    intro d f hf
    rw [hP0, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul,
      MvPolynomial.coeff_X_pow] at hm
    by_cases hmd : Finsupp.single 0 d = m
    · rw [if_pos hmd, ← hmd, mul_one, sub_self] at hm
      exact absurd rfl hm
    · rw [if_neg hmd, mul_zero, sub_zero] at hm
      have hdeg : m.degree = d := by
        by_contra h
        exact hm (hf.coeff_eq_zero h)
      by_contra hcon
      push_neg at hcon
      apply hmd
      have hm' : m = Finsupp.single 0 (m 0) := by
        ext a
        by_cases ha : a = 0
        · subst ha; simp
        · rw [hcon a ha]
          exact (Finsupp.single_eq_of_ne ha).symm
      have h0 : m 0 = d := by
        rw [hm', Finsupp.degree_single] at hdeg
        exact hdeg
      rw [hm', h0]
  have s2 : ∀ (i : ℕ), 0 < i → ∀ p : MvPolynomial (Fin (n + 1)) K, p.IsHomogeneous i →
      p ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) K)) := by
    intro i hi p hp
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hdeg : m.degree = i := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hm) (hp.coeff_eq_zero h)
    have hm0 : m ≠ 0 := by
      rintro rfl
      simp at hdeg
      omega
    obtain ⟨j, hj⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨j, Set.mem_univ _, hj⟩
  have key : ∀ x : wcProjK K n, (∀ j : Fin (n + 1), j ≠ 0 → x ∉ wcSgD K n j) →
      x.asHomogeneousIdeal.toIdeal = P0 := by
    intro x hx
    have hX : ∀ j : Fin (n + 1), j ≠ 0 → MvPolynomial.X j ∈ x.asHomogeneousIdeal.toIdeal := by
      intro j hj
      have h1 := hx j hj
      rw [Proj.mem_basicOpen] at h1
      exact not_not.mp h1
    have hprime : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
    have hX0 : MvPolynomial.X 0 ∉ x.asHomogeneousIdeal.toIdeal := by
      intro h0
      have hall : Ideal.span (Set.range (MvPolynomial.X :
          Fin (n + 1) → MvPolynomial (Fin (n + 1)) K)) ≤ x.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        by_cases hi : i = 0
        · subst hi; exact h0
        · exact hX i hi
      apply x.not_irrelevant_le
      show (HomogeneousIdeal.irrelevant _).toIdeal ≤ x.asHomogeneousIdeal.toIdeal
      rw [HomogeneousIdeal.toIdeal_irrelevant_le]
      intro i hi p hp
      exact hall (s2 i hi p ((MvPolynomial.mem_homogeneousSubmodule i p).mp hp))
    have hP0I : P0 ≤ x.asHomogeneousIdeal.toIdeal := by
      rw [hP0, Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      exact hX j hj
    apply le_antisymm _ hP0I
    intro f hf
    rw [← MvPolynomial.sum_homogeneousComponent f]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    have hgI : MvPolynomial.homogeneousComponent i f ∈ x.asHomogeneousIdeal.toIdeal := by
      have h1 := x.asHomogeneousIdeal.isHomogeneous i hf
      have e : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) f i :
          MvPolynomial (Fin (n + 1)) K)) = MvPolynomial.homogeneousComponent i f :=
        MvPolynomial.decomposition.decompose'_apply f i
      rw [← e]
      exact h1
    have hgh := MvPolynomial.homogeneousComponent_isHomogeneous i f
    have hr := s1 i _ hgh
    have hcI : MvPolynomial.C ((MvPolynomial.homogeneousComponent i f).coeff
        (Finsupp.single 0 i)) * MvPolynomial.X 0 ^ i ∈ x.asHomogeneousIdeal.toIdeal := by
      have h2 := Ideal.sub_mem _ hgI (hP0I hr)
      rwa [sub_sub_cancel] at h2
    have hc : (MvPolynomial.homogeneousComponent i f).coeff (Finsupp.single 0 i) = 0 := by
      by_contra hc
      apply hX0
      apply hprime.mem_of_pow_mem i
      have h3 := Ideal.mul_mem_left _ (MvPolynomial.C
        ((MvPolynomial.homogeneousComponent i f).coeff (Finsupp.single 0 i))⁻¹) hcI
      rwa [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc, MvPolynomial.C_1,
        one_mul] at h3
    rwa [hc, MvPolynomial.C_0, zero_mul, sub_zero] at hr
  have e1 := key q hq
  have e2 := key q' hq'
  exact ProjectiveSpectrum.ext (HomogeneousIdeal.ext (e1.trans e2.symm))

theorem wc_scq_vertex_rational_point (K : Type u) [Field K] [Finite K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K)))
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (Op : E₀.left.Opens)
    (hOp : Op = ⨆ c : Fin (e + 2 + 1), jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c.succ) :
    ∃ s : Spec (.of K) ⟶ E₀.left, s ≫ E₀.hom = 𝟙 _ ∧
      (Op : Set E₀.left) = {s (IsLocalRing.closedPoint K)}ᶜ :=
by
  classical
  obtain ⟨x₀, hx₀s, hx₀0, hx₀j⟩ := wc_vrp_origin_point K (e + 2 + 1)
  have hb00 : b 0 0 = 0 := by
    rw [hb 0 0]
    simp

  have hnu : ∀ (p : wcProjK K (e + 2 + 1)) (hp : p ∈ wcSgD K (e + 2 + 1) 0),
      (∀ j : Fin (e + 2 + 1 + 1), j ≠ 0 → p ∉ wcSgD K (e + 2 + 1) j) →
      ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) 0) p hp).hom
        (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) 0) ∈
      IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p) := by
    intro p hp hpj
    have key : ∀ j : Fin (e + 2 + 1 + 1), j ≠ 0 →
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) 0) p hp).hom
          (wcSgE K (e + 2 + 1) 0 j) ∈
        IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p) := by
      intro j hj
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have h1 : p ∈ (wcProjK K (e + 2 + 1)).basicOpen (wcSgE K (e + 2 + 1) 0 j) :=
        (Scheme.mem_basicOpen _ _ p hp).mpr hu
      rw [(wc_ldpi_oai_sgE_facts K (e + 2 + 1) 0 j).2] at h1
      exact hpj j hj h1.2
    rw [(wc_ldp_lnf_sec_quad K (e + 2 + 1) 0 b).2, map_sum]
    refine Ideal.sum_mem _ (fun a _ => ?_)
    rw [map_sum]
    refine Ideal.sum_mem _ (fun c _ => ?_)
    rw [map_mul, map_mul]
    by_cases ha : a = 0
    · subst ha
      by_cases hc : c = 0
      · subst hc
        rw [hb00]
        simp
      · exact Ideal.mul_mem_left _ _ (key c hc)
    · exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (key a ha))
  have hmem : x₀ (IsLocalRing.closedPoint K) ∈ Set.range jE := by
    apply hEall
    intro c hp
    by_cases hc : c = 0
    · subst hc
      exact hnu _ hp hx₀j
    · exact absurd hp (hx₀j c hc)
  have hrange : Set.range x₀ ⊆ Set.range jE := by
    rintro _ ⟨z, rfl⟩
    rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
    exact hmem
  haveI := hjE
  obtain ⟨s, hs⟩ := wc_ap_reduced_factor_closed_immersion (Spec (.of K)) E₀.left
    (wcProjK K (e + 2 + 1)) x₀ jE hrange
  have hspt : jE (s (IsLocalRing.closedPoint K)) = x₀ (IsLocalRing.closedPoint K) := by
    rw [← hs]
    rfl
  have hinj : Function.Injective jE := jE.isClosedEmbedding.isEmbedding.injective
  refine ⟨s, ?_, ?_⟩
  · rw [← hjEY, ← Category.assoc, hs, hx₀s]
  · subst hOp
    ext y
    rw [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, Set.mem_compl_singleton_iff]
    constructor
    · rintro ⟨c, hc⟩ rfl
      have h1 : jE (s (IsLocalRing.closedPoint K)) ∈ wcSgD K (e + 2 + 1) c.succ := hc
      rw [hspt] at h1
      exact hx₀j c.succ (Fin.succ_ne_zero c) h1
    · intro hy
      by_contra hcon
      push_neg at hcon
      apply hy
      apply hinj
      rw [hspt]
      apply wc_vrp_axis_point_unique K (e + 2 + 1) _ _ _ hx₀j
      intro j hj hjm
      obtain ⟨c, rfl⟩ := Fin.exists_succ_eq.mpr hj
      exact hcon c hjm

theorem wc_scq_affine_cell_iso (K : Type u) [Field K] [Finite K] (e : ℕ)
    (a' : Fin (e + 1 + 1) → Fin (e + 1 + 1) → K)
    (ha' : (Matrix.of a' + (Matrix.of a').transpose).det ≠ 0)
    (b : Fin (e + 2 + 1 + 1) → Fin (e + 2 + 1 + 1) → K)
    (hb : ∀ i j : Fin (e + 2 + 1 + 1), b i j = if i.val = 0 ∧ j.val = e + 3 then 1 else
        if h : 1 ≤ i.val ∧ i.val ≤ e + 2 ∧ 1 ≤ j.val ∧ j.val ≤ e + 2 then
          a' ⟨i.val - 1, by omega⟩ ⟨j.val - 1, by omega⟩ else 0)
    (E₀ : Over (Spec (.of K))) [IsProper E₀.hom] [SmoothOfRelativeDimension (e + 2) E₀.hom]
    (jE : E₀.left ⟶ wcProjK K (e + 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (e + 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (e + 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c),
      wcLdpGerm K (e + 2 + 1) jE (wcLdpQuad K (e + 2 + 1) b) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK K (e + 2 + 1), (∀ (c : Fin (e + 2 + 1 + 1))
        (hp : p ∈ wcSgD K (e + 2 + 1) c),
        ((wcProjK K (e + 2 + 1)).presheaf.germ (wcSgD K (e + 2 + 1) c) p hp).hom
            (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK K (e + 2 + 1)).presheaf.stalk p)) → p ∈ Set.range jE)
    (U : E₀.left.Opens)
    (hU : U = jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1))) :
    ∃ φ : U.toScheme ≅ Spec (.of (MvPolynomial (Fin (e + 2)) K)),
      φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 2)) K))) =
        U.ι ≫ E₀.hom :=
by
  classical
  subst hU
  haveI : IsClosedImmersion jE := hjE

  have hcomp : ∀ {X Y : Scheme.{u}} (g : Y ⟶ X) (sX : X ⟶ Spec (.of K)) (V : X.Opens)
      (O : Y.Opens) (e' : O ≤ g ⁻¹ᵁ V) (c : K),
      (g.appLE V O e').hom (wcCnSigma sX V c) = wcCnSigma (g ≫ sX) O c := by
    intro X Y g sX V O e' c
    exact congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))
      (Scheme.Hom.appLE_comp_appLE g sX ⊤ V O le_top e')
  have hAgen : ∀ (m : ℕ) (a : Fin (m + 1)) (c : K),
      (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c)) =
        wcCnSigma (wcProjKStr K m) (wcSgD K m a) c := by
    intro m a c
    have f_deg : (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
    have h1 : (wcSgD K m a).ι =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)
            f_deg one_pos := by
      rw [← Proj.basicOpenIsoSpec_hom _ _ f_deg one_pos,
        ← Proj.basicOpenIsoSpec_inv_ι _ _ f_deg one_pos, Iso.hom_inv_id_assoc]
    have h2 : (wcSgD K m a).ι ≫ wcProjKStr K m =
        Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
            CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
              (Submonoid.powers (MvPolynomial.X a)))) := by
      rw [h1, Spec.map_comp, ← Proj.awayι_toSpecZero _ _ f_deg one_pos]
      simp only [wcProjKStr, Category.assoc]
    have h4 : (Proj.basicOpenToSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          (MvPolynomial.X a)).appTop =
        (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)))).hom ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K m a).topIso.inv :=
      Proj.basicOpenToSpec_app_top _ _
    have H : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
          (wcSgD K m a).ι.appTop =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) ≫
          (wcSgD K m a).topIso.inv := by
      rw [← Scheme.Hom.comp_appTop, h2, Scheme.Hom.comp_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, h4]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have h3 : (wcSgD K m a).ι.appTop ≫ (wcSgD K m a).topIso.hom =
        (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      first
        | (erw [← Functor.map_comp]; rfl)
        | (simp only [← Functor.map_comp]; rfl)
        | exact ((wcProjK K m).presheaf.map_comp _ _).symm
    have H' : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (wcProjKStr K m).appTop ≫
          (wcProjK K m).presheaf.map (homOfLE (le_top : wcSgD K m a ≤ ⊤)).op =
        CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫
          Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
            (MvPolynomial.X a) := by
      rw [← h3, reassoc_of% H, Iso.inv_hom_id, Category.comp_id]
    have e := congrArg (fun φ => φ.hom c) H'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
    exact e.symm

  have v0 : ((0 : Fin (e + 2 + 1 + 1)) : ℕ) = 0 := rfl
  have vL : ((Fin.last (e + 2 + 1) : Fin (e + 2 + 1 + 1)) : ℕ) = e + 3 := rfl
  have vk : ∀ k : Fin (e + 2), ((k.succ.castSucc : Fin (e + 2 + 1 + 1)) : ℕ) = k.val + 1 :=
    fun k => by simp
  have hb00 : b 0 0 = 0 := by rw [hb]; split_ifs <;> (try simp only [v0, vL, vk] at *) <;> first | rfl | (exfalso; omega)
  have hb0m : ∀ l : Fin (e + 2), b 0 l.succ.castSucc = 0 := by
    intro l; have hl := l.isLt; rw [hb]; split_ifs <;> (try simp only [v0, vL, vk] at *) <;> first | rfl | (exfalso; omega)
  have hb0L : b 0 (Fin.last (e + 2 + 1)) = 1 := by
    rw [hb, if_pos (by simp)]
  have hbL : ∀ q, b (Fin.last (e + 2 + 1)) q = 0 := by
    intro q; have hq := q.isLt; rw [hb]; split_ifs <;> (try simp only [v0, vL, vk] at *) <;> first | rfl | (exfalso; omega)
  have hbm0 : ∀ k : Fin (e + 2), b k.succ.castSucc 0 = 0 := by
    intro k; have hk := k.isLt; rw [hb]; split_ifs <;> (try simp only [v0, vL, vk] at *) <;> first | rfl | (exfalso; omega)
  have hbmL : ∀ k : Fin (e + 2), b k.succ.castSucc (Fin.last (e + 2 + 1)) = 0 := by
    intro k; have hk := k.isLt; rw [hb]; split_ifs <;> (try simp only [v0, vL, vk] at *) <;> first | rfl | (exfalso; omega)
  have hbmm : ∀ k l : Fin (e + 2), b k.succ.castSucc l.succ.castSucc = a' k l := by
    intro k l
    have hk := k.isLt
    have hl := l.isLt
    rw [hb, if_neg (by simp), dif_pos (by simp; omega)]
    congr 1 <;> ext <;> simp
  have L1 : ∀ (R : Type u) [CommRing R] (f : K →+* R) (v : Fin (e + 2 + 1 + 1) → R),
      ∑ p, ∑ q, f (b p q) * v p * v q =
        v 0 * v (Fin.last (e + 2 + 1)) +
          ∑ k : Fin (e + 2), ∑ l : Fin (e + 2), f (a' k l) * v k.succ.castSucc * v l.succ.castSucc := by
    intro R _ f v
    have hsplit : ∀ g : Fin (e + 2 + 1 + 1) → R, ∑ q, g q =
        g 0 + ∑ k : Fin (e + 2), g k.succ.castSucc + g (Fin.last (e + 2 + 1)) := by
      intro g
      rw [Fin.sum_univ_succ, Fin.sum_univ_castSucc]
      simp only [Fin.succ_last, Fin.succ_castSucc]
      ring
    simp only [hsplit, hb00, hb0m, hb0L, hbL, hbm0, hbmL, hbmm, map_zero, map_one, zero_mul,
      mul_zero, Finset.sum_const_zero, add_zero, zero_add, one_mul]

  have hXb : ∀ c : Fin (e + 2 + 1 + 1), (MvPolynomial.X c : MvPolynomial (Fin (e + 2 + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K 1 := fun c =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K c)
  have hDaff : ∀ c : Fin (e + 2 + 1 + 1), IsAffineOpen (wcSgD K (e + 2 + 1) c) := fun c =>
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X c) 1 (hXb c) one_pos
  have hVaff : ∀ c : Fin (e + 2 + 1 + 1), IsAffineOpen (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c) := fun c =>
    (hDaff c).preimage jE

  have qs10 : ∀ (K : Type u) [Field K] (n : ℕ) (Y : Scheme.{u})
      (s : Y ⟶ Spec (.of K)) [SmoothOfRelativeDimension n s] (V : Y.Opens), IsAffineOpen V →
      ∀ x ∈ V, ∃ (f : Γ(Y, V)) (g : MvPolynomial (Fin n) K →+* Γ(Y, Y.basicOpen f)),
        x ∈ Y.basicOpen f ∧ g.Etale ∧
        g.comp MvPolynomial.C = (Y.presheaf.map (homOfLE (le_top : Y.basicOpen f ≤ ⊤)).op).hom.comp
          (s.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) := by
    intro K _ n Y s _ V hV x hxV
    obtain ⟨U, hU, V', hV', hxV', e, hss⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := s) x
    obtain ⟨g₀, hg₀C, hg₀⟩ := hss.exists_etale_mvPolynomial
    have hUtop : U = ⊤ := by
      have h1 : s x ∈ U := e hxV'
      refine eq_top_iff.mpr (fun w _ => ?_)
      rwa [Subsingleton.elim w (s x)]
    subst hUtop
    let e₀ : K ≃+* Γ(Spec (.of K), ⊤) :=
      (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv
    let g₁ := g₀.comp (MvPolynomial.mapEquiv (Fin n) e₀).toRingHom
    have hg₁ : g₁.Etale := RingHom.Etale.respectsIso.2 g₀ (MvPolynomial.mapEquiv (Fin n) e₀) hg₀
    obtain ⟨f, f', hff', hxf⟩ := exists_basicOpen_le_affine_inter hV hV' x ⟨hxV, hxV'⟩
    let r : Γ(Y, V') →+* Γ(Y, Y.basicOpen f') :=
      (Y.presheaf.map (homOfLE (Y.basicOpen_le f')).op).hom
    have hr : r.Etale := by
      haveI := hV'.isLocalization_basicOpen f'
      haveI : Algebra.Etale Γ(Y, V') Γ(Y, Y.basicOpen f') := Algebra.Etale.of_isLocalizationAway f'
      exact RingHom.etale_algebraMap.mpr inferInstance
    have h : Opposite.op (Y.basicOpen f') = Opposite.op (Y.basicOpen f) := congrArg Opposite.op hff'.symm
    let ι₁ : Γ(Y, Y.basicOpen f') ≃+* Γ(Y, Y.basicOpen f) :=
      (Y.presheaf.mapIso (eqToIso h)).commRingCatIsoToRingEquiv
    have hle : Y.basicOpen f ≤ s ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have key : ∀ y, ι₁ (r ((s.appLE ⊤ V' e).hom y)) = (s.appLE ⊤ (Y.basicOpen f) hle).hom y := by
      intro y
      change ((s.appLE ⊤ V' e ≫ Y.presheaf.map (homOfLE (Y.basicOpen_le f')).op) ≫
        Y.presheaf.map (eqToHom h)).hom y = _
      rw [Scheme.Hom.appLE_map, Scheme.Hom.appLE_map]
    refine ⟨f, ι₁.toRingHom.comp (r.comp g₁), hxf, ?_, ?_⟩
    · exact RingHom.Etale.respectsIso.1 _ ι₁ (RingHom.Etale.stableUnderComposition _ _ hg₁ hr)
    · refine RingHom.ext fun c => ?_
      have h1 : g₁ (MvPolynomial.C c) = (s.appLE ⊤ V' e).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c) := by
        show g₀ ((MvPolynomial.mapEquiv (Fin n) e₀) (MvPolynomial.C c)) = _
        rw [MvPolynomial.mapEquiv_apply, MvPolynomial.map_C]
        exact RingHom.congr_fun hg₀C _
      show ι₁ (r (g₁ (MvPolynomial.C c))) = _
      rw [h1, key]
      rfl
  have hred : ∀ (R : Type u) [CommRing R] (g : MvPolynomial (Fin (e + 2)) K →+* R), g.Etale →
      _root_.IsReduced R := by
    intro R _ g hg
    letI := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin (e + 2)) K) R := hg
    have hinj := Algebra.TensorProduct.includeRight_injective (R := MvPolynomial (Fin (e + 2)) K)
      (A := FractionRing (MvPolynomial (Fin (e + 2)) K)) (B := R)
      (IsFractionRing.injective (MvPolynomial (Fin (e + 2)) K) (FractionRing (MvPolynomial (Fin (e + 2)) K)))
    haveI : _root_.IsReduced (TensorProduct (MvPolynomial (Fin (e + 2)) K)
        (FractionRing (MvPolynomial (Fin (e + 2)) K)) R) :=
      Algebra.FormallyUnramified.isReduced_of_field (FractionRing (MvPolynomial (Fin (e + 2)) K)) _
    exact isReduced_of_injective _ hinj
  have hY : (⨆ j : Fin (e + 2 + 1 + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K) (MvPolynomial.X j)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩
  haveI hRed : AlgebraicGeometry.IsReduced E₀.left := by
    haveI : ∀ x : E₀.left, _root_.IsReduced (E₀.left.presheaf.stalk x) := by
      intro x
      have hx : jE x ∈ (⨆ j : Fin (e + 2 + 1 + 1), Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K) (MvPolynomial.X j)) := by
        rw [hY]; trivial
      obtain ⟨c, hc⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      have hxc : x ∈ jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c := hc
      obtain ⟨f, g, hxf, hgE, -⟩ := qs10 K (e + 2) E₀.left E₀.hom (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) c)
        (hVaff c) x hxc
      have hW := (hVaff c).basicOpen f
      haveI := hred _ g hgE
      letI := TopCat.Presheaf.algebra_section_stalk E₀.left.presheaf (⟨x, hxf⟩ : E₀.left.basicOpen f)
      haveI := hW.isLocalization_stalk ⟨x, hxf⟩
      exact isReduced_localizationPreserves (hW.primeIdealOf ⟨x, hxf⟩).asIdeal.primeCompl
        (E₀.left.presheaf.stalk ((⟨x, hxf⟩ : E₀.left.basicOpen f) : E₀.left)) ‹_›
    exact isReduced_of_isReduced_stalk E₀.left

  have hconstJ : ∀ c : K, (jE.app (wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K) (MvPolynomial.X (Fin.last (e + 2 + 1)))).hom
          (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K)
            (Submonoid.powers (MvPolynomial.X (Fin.last (e + 2 + 1))))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (e + 2 + 1 + 1)) K 0) c))) =
        wcCnSigma E₀.hom (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1))) c := by
    intro c
    rw [hAgen, Scheme.Hom.app_eq_appLE, hcomp, hjEY]

  have hr0 : (jE.app (wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))).hom (wcLdpSec K (e + 2 + 1) (wcLdpQuad K (e + 2 + 1) b) (Fin.last (e + 2 + 1))) = 0 := by
    rw [← basicOpen_eq_bot_iff]
    refine eq_bot_iff.mpr (fun x hx => ?_)
    have hxV : x ∈ (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1))) := E₀.left.basicOpen_le _ hx
    have h1 := (Scheme.mem_basicOpen _ _ x hxV).mp hx
    have h2 := hEG x (Fin.last (e + 2 + 1)) hxV
    unfold wcLdpGerm at h2
    exact ((IsLocalRing.mem_maximalIdeal _).mp h2 h1).elim
  set s : Fin (e + 2) → Γ(E₀.left, (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))) :=
    fun k => (jE.app (wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))).hom (wcSgE K (e + 2 + 1) (Fin.last (e + 2 + 1)) k.succ.castSucc) with hs
  have hrel : (jE.app (wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))).hom (wcSgE K (e + 2 + 1) (Fin.last (e + 2 + 1)) 0) =
      -∑ k : Fin (e + 2), ∑ l : Fin (e + 2), wcCnSigma E₀.hom (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1))) (a' k l) * s k * s l := by
    have h0 := hr0
    rw [(wc_ldp_lnf_sec_quad K (e + 2 + 1) (Fin.last (e + 2 + 1)) b).2] at h0
    simp only [map_sum, map_mul, hconstJ] at h0
    have hL := L1 Γ(E₀.left, (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))) (wcCnSigma E₀.hom (jE ⁻¹ᵁ wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1))))
      (fun p => (jE.app (wcSgD K (e + 2 + 1) (Fin.last (e + 2 + 1)))).hom (wcSgE K (e + 2 + 1) (Fin.last (e + 2 + 1)) p))
    rw [hL, (wc_ldp_lnf_sec_quad K (e + 2 + 1) (Fin.last (e + 2 + 1)) b).1, map_one, mul_one] at h0
    exact eq_neg_of_add_eq_zero_left h0
