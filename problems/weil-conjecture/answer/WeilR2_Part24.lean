      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  have hV : wcSgD K n J ⊓ wcSgD K n L ≤
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J * MvPolynomial.X L) :=
    (Proj.basicOpen_mul _ _ _).ge
  have hVL : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      (MvPolynomial.X J * MvPolynomial.X L) ≤ wcSgD K n L :=
    (Proj.basicOpen_mul _ _ _).le.trans inf_le_right
  have hVJ : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      (MvPolynomial.X J * MvPolynomial.X L) ≤ wcSgD K n J :=
    (Proj.basicOpen_mul _ _ _).le.trans inf_le_left
  have hO : κ ⁻¹ᵁ wcSgD K n J ⊓ κ ⁻¹ᵁ wcSgD K n L ≤ κ ⁻¹ᵁ (wcSgD K n J ⊓ wcSgD K n L) :=
    (Scheme.Hom.preimage_inf κ).ge
  let θ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
