theorem wc_srdcbR_proper_local_class_gen : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (f : X ⟶ Spec (.of K)) [IsProper f] (m : ℕ), m ≠ 0 → ∀ (q : ℕ) (Ω : wcEtZModExt X m q), (∀ α : wcEtZModExt X m q, ∃ c : ℕ, α = c • Ω) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (PA : Scheme.{u}) (r : PA ⟶ X) (t : PA ⟶ Spec (.of A)), IsPullback r t f s → ∀ (E : wcEtPullData r m), Function.Bijective (wcEtPull E q)) → ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (YV : Scheme.{u}) (gV : YV ⟶ V) (w : YV ⟶ X), IsPullback w gV f fV → ∀ (α : wcEtZModExt YV m q) (x : V), ∃ (V' : Scheme.{u}) (v' : V' ⟶ V), Etale v' ∧ x ∈ Set.range v' ∧ ∃ c : ℕ, ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ V') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' → ∀ (Dw' : wcEtPullData w' m) (Dc : wcEtPullData (w' ≫ w) m), wcEtPull Dw' q α = c • wcEtPull Dc q Ω :=
