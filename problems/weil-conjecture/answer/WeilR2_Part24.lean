    (hvan : ∀ θ : wcEtSuppExt DQ' q, θ = 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S m)) := HasExt.standard _
    ∀ e : Abelian.Ext (wcEtSuppObj DQ) (wcEtSuppObj Ew) q, e = 0 :=
