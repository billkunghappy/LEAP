            else (0 : Γ(E₁.left, jE₁ ⁻¹ᵁ wcSgD K (e + 1) c))) =
        E₁.left.presheaf.map (homOfLE hOW).op (if h : 1 ≤ L.val ∧ L.val ≤ e + 2 then
            (jE₁.app (wcSgD K (e + 1) c)).hom (wcSgE K (e + 1) c ⟨L.val - 1, by omega⟩)
