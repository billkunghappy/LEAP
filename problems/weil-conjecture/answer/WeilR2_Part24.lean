    (hO : ∀ p : (wcP1Over F'').left, p ∈ O ↔ ∀ i : Fin D.m, p ≠ D.S i (IsLocalRing.closedPoint F'')) :
    ∃ c : ℕ, ∀ (k : ℕ)
      (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))))
      (V : (wcP1Over F'').left.Etale), IsAffine V.left →
      ∀ h : ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology (n - 1)).obj.obj
          (Opposite.op (wcEtOpen (wcP1Over F'').left V (V.hom ⁻¹ᵁ O))),
      ∃ x : ((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology (n - 1)).obj.obj (Opposite.op V),
        (((((wcEtPush D.f).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology (n - 1)).obj.map
            (wcEtOpenι (wcP1Over F'').left V (V.hom ⁻¹ᵁ O)).op).hom x = ℓ ^ c • h :=
by
  classical

  have glue : ∀ (B : Scheme.{u}) (O : B.Opens)
      (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (N : ℕ),
      (∀ (W : B.Etale) (s : G.obj.obj (Opposite.op W)),
        (G.obj.map (wcEtOpenι B W (W.hom ⁻¹ᵁ O)).op).hom s = 0 → s = 0) →
      ∀ (V : B.Etale) (h : G.obj.obj (Opposite.op (wcEtOpen B V (V.hom ⁻¹ᵁ O)))),
      (∀ v : V.left, V.hom v ∉ O →
        ∃ (W : B.Etale) (f : W ⟶ V) (x : G.obj.obj (Opposite.op W)), v ∈ Set.range f.left ∧
          ∀ (Z : B.Etale) (g : Z ⟶ W) (g' : Z ⟶ wcEtOpen B V (V.hom ⁻¹ᵁ O)),
            g ≫ f = g' ≫ wcEtOpenι B V (V.hom ⁻¹ᵁ O) →
            (G.obj.map g.op).hom x = N • (G.obj.map g'.op).hom h) →
      ∃ x : G.obj.obj (Opposite.op V),
        (G.obj.map (wcEtOpenι B V (V.hom ⁻¹ᵁ O)).op).hom x = N • h := by
    intro B O G N hinj V h hloc
    have resComp : ∀ {A₁ A₂ A₃ : B.Etale} (a : A₁ ⟶ A₂) (b : A₂ ⟶ A₃)
        (z : G.obj.obj (Opposite.op A₃)),
        (G.obj.map (a ≫ b).op).hom z = (G.obj.map a.op).hom ((G.obj.map b.op).hom z) := by
      intro A₁ A₂ A₃ a b z
      rw [op_comp, Functor.map_comp]
      rfl

    have L2 : ∀ {T Z : B.Etale} (a b : Z ⟶ wcEtOpen B T (T.hom ⁻¹ᵁ O)),
        a ≫ wcEtOpenι B T (T.hom ⁻¹ᵁ O) = b ≫ wcEtOpenι B T (T.hom ⁻¹ᵁ O) → a = b := by
      intro T Z a b hab
      apply MorphismProperty.Over.Hom.ext
      haveI : Mono (T.hom ⁻¹ᵁ O).ι := IsOpenImmersion.mono _
      have h1 : a.left ≫ (T.hom ⁻¹ᵁ O).ι = b.left ≫ (T.hom ⁻¹ᵁ O).ι :=
        congrArg (fun φ => φ.left) hab
      exact (cancel_mono (T.hom ⁻¹ᵁ O).ι).1 h1

    have L1 : ∀ (T Z : B.Etale) (a : Z ⟶ T),
        ∃ a' : wcEtOpen B Z (Z.hom ⁻¹ᵁ O) ⟶ wcEtOpen B T (T.hom ⁻¹ᵁ O),
          a' ≫ wcEtOpenι B T (T.hom ⁻¹ᵁ O) = wcEtOpenι B Z (Z.hom ⁻¹ᵁ O) ≫ a := by
      intro T Z a
      have hw : a.left ≫ T.hom = Z.hom := MorphismProperty.Over.w a
      have hle : Z.hom ⁻¹ᵁ O ≤ a.left ⁻¹ᵁ (T.hom ⁻¹ᵁ O) := by
        intro z hz
        have e : T.hom (a.left z) = Z.hom z := by
          rw [← hw]
          rfl
        show T.hom (a.left z) ∈ O
        rw [e]
        exact hz
