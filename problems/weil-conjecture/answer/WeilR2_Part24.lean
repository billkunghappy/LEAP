  have hM : ∀ k' : ℕ, 1 ≤ k' →
      IsAddCyclic (wcEtZModExt (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k') (n - 1)) ∧
      Nat.card (wcEtZModExt (Limits.pullback (a' ≫ Limits.pullback.snd D.f a) ξ) (ℓ ^ k') (n - 1)) =
