  have hyw := sub_eq_zero.mp hd

  have hM0 : ((ℓ ^ b * ℓ ^ a₁ : ℕ) : ℚ_[ℓ]) ≠ 0 :=
    Nat.cast_ne_zero.mpr (mul_ne_zero (pow_ne_zero _ hℓ0) (pow_ne_zero _ hℓ0))
  refine ⟨(yI.comp (Abelian.Ext.mk₀ (wcIntToLadic D.Yt.left ℓ)) (add_zero (n - 1))).comp
    (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ (((ℓ ^ b * ℓ ^ a₁ : ℕ) : ℚ_[ℓ]))⁻¹))
    (add_zero (n - 1)), ?_⟩
  rw [X1, X1, hyw, hwι, Q1]
