  have memb : ∀ (e : Equiv.Perm (Fin (r + 2))), (∀ p : Fin (r + 2), (e p).val % 2 = p.val % 2) →
      ∀ J : Ideal (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)),
      ((∀ p : Fin (r + 2), p.val % 2 = 0 →
          φ0 (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
            (MvPolynomial.X (e p))) ∈ J) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
