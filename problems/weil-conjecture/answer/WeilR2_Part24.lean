  have c3 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
      (K : GrothendieckTopology D) (G : C ⥤ D),
      (∀ (V : C) (R : Sieve (G.obj V)), R ∈ K (G.obj V) → ∃ S : Sieve V, S ∈ J V ∧
        ∀ (W : C) (f : W ⟶ V), S.arrows f →
          (⊥ : Sieve (G.obj W)) ∈ K (G.obj W) ∨ R.arrows (G.map f)) →
      ∀ (P Q : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) (α : P ⟶ Q),
      (∀ U : D, (⊥ : Sieve U) ∈ K U → Subsingleton ↑(P.obj (Opposite.op U))) →
      Presheaf.IsLocallyInjective K α →
        Presheaf.IsLocallyInjective J (Functor.whiskerLeft G.op α) := by
    intro C D _ _ J K G hL P Q α hsub hα
    apply Presheaf.IsLocallyInjective.mk
    rintro ⟨V⟩ x y hxy
    have hR := Presheaf.equalizerSieve_mem K α (X := Opposite.op (G.obj V)) x y hxy
    obtain ⟨S, hS, hSR⟩ := hL V _ hR
    refine J.superset_covering ?_ hS
    intro W f hf
    rw [Presheaf.equalizerSieve_apply]
    rcases hSR W f hf with hb | hr
    · exact @Subsingleton.elim _ (hsub _ hb) _ _
    · rw [Presheaf.equalizerSieve_apply] at hr
      exact hr

  have c4 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
