        intro f
        obtain ⟨I, -⟩ : ∃ I : ((DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦(-1 : ℤ)⟧)⟦N⟧ ≅
            (E⟦(-1 : ℤ)⟧)⟦N⟧, True :=
