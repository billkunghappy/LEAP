  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth (d + 1) X.hom
  haveI : IsLocallyNoetherian X.left := LocallyOfFiniteType.isLocallyNoetherian X.hom
  haveI hlnW : IsLocallyNoetherian (W : Scheme.{u}) := inferInstance
