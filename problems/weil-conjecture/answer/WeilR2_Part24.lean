        rw [Category.assoc, hψ]
        exact Limits.pullback.condition
      have w2 : (rT.left ≫ eB.hom ≫ δ) ≫ a' = rW.left ≫ ((wcProEtPullback D.f).map a₀).left := by
        simp only [Category.assoc]
        rw [hδ, Iso.hom_inv_id_assoc]
        exact hpb.toCommSq.w
      refine ⟨Limits.pullback.lift _ _ w2, hpb.lift _ _ w1, ?_⟩
      apply hpb.hom_ext
      · rw [Category.assoc, IsPullback.lift_fst, Limits.pullback.lift_fst_assoc]
        simp only [Category.assoc, IsIso.hom_inv_id_assoc, Iso.hom_inv_id, Category.comp_id,
          Category.id_comp]
      · rw [Category.assoc, IsPullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]

    obtain ⟨Dκ, hDκ⟩ := wc_zmod_pull_data_exists κ (ℓ ^ k)
    obtain ⟨Dμ, hDμ⟩ := wc_zmod_pull_data_exists μ (ℓ ^ k)
    obtain ⟨D1, hD1⟩ := wc_zmod_pull_data_exists (𝟙 Fm.left) (ℓ ^ k)
    have hret : ∀ x : wcZModProEtExt Fm.left (ℓ ^ k) j,
        wcZModPull Dμ j (wcZModPull Dκ j x) = x := fun x => by
      rw [← wc_zmod_pull_comp κ μ (𝟙 _) hμκ Dκ hDκ Dμ hDμ D1 hD1 j x,
        wc_zmod_pull_id (𝟙 _) rfl D1 hD1 j x]
    haveI := hfinFib
    refine Finite.of_injective (fun x => wcZModPull Dκ j x) (fun x y hxy => ?_)
    have h := congrArg (fun t => wcZModPull Dμ j t) hxy
