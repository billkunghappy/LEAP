        MvPolynomial.C (wcSrmC0 A r a b) * MvPolynomial.X a * MvPolynomial.X b -
        MvPolynomial.C π) = 0 := by
      rw [hQ0, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C, hv00, zero_mul, hf0π, sub_zero]
    have hker : ∀ a ∈ wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r),
        MvPolynomial.eval₂Hom f0 v a = 0 := by
      intro a ha
      have hle : wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r) ≤
          RingHom.ker (MvPolynomial.eval₂Hom f0 v) := by
        apply Ideal.span_le.mpr
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact RingHom.mem_ker.mpr hQ0'
      exact RingHom.mem_ker.mp (hle ha)
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom f0 v) hker, ?_, ?_⟩
    · apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply]
        have e2 : ψ (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) a) =
            algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) a := RingHom.congr_fun hψA a
        have e3 : ρ (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) a) =
            MvPolynomial.C (IsLocalRing.residue A a) := RingHom.congr_fun hρA a
        rw [hmkR, e2, e3, ← hmkM, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, hf0,
          RingHom.comp_apply, RingHom.comp_apply]
      · intro q
        simp only [RingHom.comp_apply]
        rw [hψX q, Ideal.Quotient.lift_mk, K1 q]
        obtain ⟨p, rfl⟩ : ∃ p, q = ε p := ⟨ε q, (hεε q).symm⟩
        rw [hεε p]
        have hpp := hpar p
        by_cases h0 : p.val = 0
        · rw [hF0 p h0, MvPolynomial.eval₂Hom_X', hv0 p h0, hyo0 (ε p) (by omega)]
        by_cases h1 : p.val = 1
        · rw [hF1 p h1, map_sub, map_add, map_mul, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', hv00, zero_mul, add_zero]
          simp only [map_sum, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
          rw [hSum, hv, if_pos h1, hv', if_neg (by omega)]
          ring
        by_cases he : p.val % 2 = 0
        · rw [hFev p he h0, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', hv00,
            zero_mul, hyo0 (ε p) (by omega)]
        · rw [hFodd p (by omega) h1, MvPolynomial.eval₂Hom_X', hvne1 p h1, hv', if_neg he]
    · intro L
      have hc : (ε (wcEmfEv r L)).val % 2 = 0 := by
        rw [hpar]; show 2 * L.val % 2 = 0; omega
      have hLlt : (wcEmfEv r L).val / 2 < (r + 2) / 2 - 1 + 1 := by
        show 2 * L.val / 2 < (r + 2) / 2 - 1 + 1; have := L.isLt; omega
      unfold wcEmfU
      by_cases h0 : (ε (wcEmfEv r L)).val = 0
      · rw [if_pos h0, map_one]
        have e1 : ε (wcEmfEv r L) = ε (wcEmfEv r t) := by rw [ht]; exact Fin.ext h0
        have h2 : 2 * L.val = 2 * t.val := congrArg Fin.val (hinv.injective e1)
        have e3 : L = t := Fin.ext (by omega)
        rw [e3, hw]
      · rw [if_neg h0, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X',
          hvne1 (ε (wcEmfEv r L)) (by omega), hv', if_pos hc, if_neg h0, hεε, hW, dif_pos hLlt]
        congr 1
        exact Fin.ext (by show 2 * L.val / 2 = L.val; omega)
  ·
    intro B _ γ γ' hγ hu
    have U0 : ∀ y, γ (ψ y) = γ' (ψ y) := fun y => RingHom.congr_fun hγ y
    have U1 : ∀ a : A, γ (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) a) =
        γ' (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) a) := by
      intro a
      have e : ψ (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) a) =
          algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) a := RingHom.congr_fun hψA a
      rw [← e]; exact U0 _
    have U2 : ∀ p, γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (wcSrmFimg A r p)) = γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (wcSrmC0 A r)) (wcSrmFimg A r p)) := by
      intro p
      have h := U0 (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
        (MvPolynomial.X (ε p)))
      rwa [hψX, hεε] at h
    have U3 : ∀ p : Fin (r + 2), p.val = 0 →
        γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X p)) =
        γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X p)) := by
      intro p hp; have h := U2 p; rwa [hF0 p hp] at h
    have U4 : ∀ p : Fin (r + 2), p.val % 2 = 1 → p.val ≠ 1 →
        γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X p)) =
        γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X p)) := by
      intro p ho h1; have h := U2 p; rwa [hFodd p ho h1] at h
    have U5 : ∀ c : Fin (r + 2), c.val % 2 = 0 → c.val ≠ 0 →
        γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X c)) =
        γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X c)) := by
      intro c he h0
      have hec : (ε c).val % 2 = 0 := by rw [hpar]; exact he
      have hlt : (ε c).val / 2 < (r + 2) / 2 - 1 + 1 := by
        obtain ⟨m, hm⟩ := hr
        have := (ε c).isLt
        omega
      have hevL : wcEmfEv r ⟨(ε c).val / 2, hlt⟩ = ε c :=
        Fin.ext (by show 2 * ((ε c).val / 2) = (ε c).val; omega)
      have h := hu ⟨(ε c).val / 2, hlt⟩
      unfold wcEmfU at h
      rwa [hevL, hεε, if_neg h0] at h
    have hP : γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩)) =
        γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩)) := by
      rw [hY01]; exact U1 π
    have hT : ∀ a b : Fin (r + 2), γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (wcSrmC0 A r)) (MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a *
        MvPolynomial.X b)) = γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (wcSrmC0 A r)) (MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a *
        MvPolynomial.X b)) := by
      intro a b
      rw [hCh]
      by_cases h1 : a.val % 2 = 0 ∧ b.val = a.val + 1
      · rw [if_pos h1, map_one, one_mul]
        obtain ⟨h1a, h1b⟩ := h1
        by_cases h2 : a.val = 0
        · have ha : a = ⟨0, by omega⟩ := Fin.ext h2
          have hb : b = ⟨1, by omega⟩ := Fin.ext (by show b.val = 1; omega)
          rw [ha, hb]
          exact hP
        · simp only [map_mul]
          rw [U5 a h1a h2, U4 b (by omega) (by omega)]
      · rw [if_neg h1]
        simp only [map_zero, zero_mul]
    have U7 : γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X ⟨1, by omega⟩)) = γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (wcSrmC0 A r)) (MvPolynomial.X ⟨1, by omega⟩)) := by
      have h := U2 ⟨1, by omega⟩
      rw [hF1 _ rfl] at h
      have hS : γ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
          (∑ a : Fin (r + 2), ∑ b : Fin (r + 2),
            MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b)) =
          γ' (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
          (∑ a : Fin (r + 2), ∑ b : Fin (r + 2),
            MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b)) := by
        simp only [map_sum]
        exact Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => hT a b))
      simp only [map_sub, map_add] at h
      rw [hP, hS] at h
      linear_combination h
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply]
      rw [hmkM]; exact U1 a
    · intro p
      simp only [RingHom.comp_apply]
      by_cases h0 : p.val = 0
      · exact U3 p h0
      by_cases h1 : p.val = 1
      · have hp1 : p = ⟨1, by omega⟩ := Fin.ext h1
        rw [hp1]; exact U7
      by_cases he : p.val % 2 = 0
      · exact U5 p he h0
      · exact U4 p (by omega) h1

theorem wc_srdcbR_emf_transition {X' T : Scheme.{u}} {R C : Type u} [CommRing R] [CommRing C]
    (β : X' ⟶ Spec (.of R)) (e e' : Spec (.of C) ⟶ X') [IsOpenImmersion e] [IsOpenImmersion e']
    (ψ ψ' : R →+* C) (heβ : e ≫ β = Spec.map (CommRingCat.ofHom ψ))
    (heβ' : e' ≫ β = Spec.map (CommRingCat.ofHom ψ')) (z : C) (hz : z ∈ nonZeroDivisors C)
    (x₀ x : R) (a u u' : C) (h₀ : ψ x₀ = z) (hx : ψ x = z * u) (ha : ψ' x₀ = z * a)
    (hu' : ψ' x = z * u') (h : T ⟶ X') (l l' : T ⟶ Spec (.of C)) (hl : l ≫ e = h)
    (hl' : l' ≫ e' = h) :
    l'.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom u') =
      l'.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom a) *
        l.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom u) :=
by
  classical

  have pull : ∀ {S : Scheme.{u}} (θ : R →+* C) (f : S ⟶ Spec (.of C)) (y : R),
      f.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom (θ y)) =
        (f ≫ Spec.map (CommRingCat.ofHom θ)).appTop.hom
          ((Scheme.ΓSpecIso (.of R)).inv.hom y) := by
    intro S θ f y
    have h2 := congrArg (fun φ => φ.hom y)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom θ))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    rw [h2, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]

  have hzhat : (Scheme.ΓSpecIso (.of C)).inv.hom z ∈ nonZeroDivisors Γ(Spec (.of C), ⊤) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    have e1 : ∀ w : C, (Scheme.ΓSpecIso (.of C)).hom.hom
        ((Scheme.ΓSpecIso (.of C)).inv.hom w) = w := fun w => by
      have := congrArg (fun φ => φ.hom w) (Scheme.ΓSpecIso (.of C)).inv_hom_id
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
        RingHom.id_apply] using this
    have e2 : ∀ w, (Scheme.ΓSpecIso (.of C)).inv.hom
        ((Scheme.ΓSpecIso (.of C)).hom.hom w) = w := fun w => by
      have := congrArg (fun φ => φ.hom w) (Scheme.ΓSpecIso (.of C)).hom_inv_id
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
        RingHom.id_apply] using this
    have h3 : (Scheme.ΓSpecIso (.of C)).hom.hom y * z = 0 := by
      have := congrArg (Scheme.ΓSpecIso (.of C)).hom.hom hy
      rwa [map_mul, e1, map_zero] at this
    have h4 := (mem_nonZeroDivisors_iff_right.mp hz) _ h3
    rw [← e2 y, h4, map_zero]

  have nzd_restrict : ∀ (T : Scheme.{u}) (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W →
      ∀ b : Γ(T, W), b ∈ nonZeroDivisors Γ(T, W) →
        T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro T W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (T.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
      haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
      exact hnz
    show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst

  set W' : (Spec (.of C)).Opens := e' ⁻¹ᵁ e.opensRange with hW'
  have hιz : W'.ι.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom z) ∈
      nonZeroDivisors Γ(W'.toScheme, ⊤) := by
    rw [Scheme.Opens.ι_appTop]
    exact nzd_restrict (Spec (.of C)) ⊤ (W'.ι ''ᵁ ⊤) le_top (isAffineOpen_top _) _ hzhat

  have H1 : Set.range (W'.ι ≫ e') ⊆ Set.range e := by
    rintro _ ⟨w, rfl⟩
    have hw : W'.ι w ∈ (W' : Set (Spec (.of C))) := by
      rw [← Scheme.Opens.range_ι W']
      exact ⟨w, rfl⟩
    have hw2 : e' (W'.ι w) ∈ e.opensRange := hw
    obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hw2
    exact ⟨y, by rw [hy, Scheme.Hom.comp_apply]⟩
  set l₀ := IsOpenImmersion.lift e (W'.ι ≫ e') H1 with hl₀def
  have hl₀ : l₀ ≫ e = W'.ι ≫ e' := IsOpenImmersion.lift_fac _ _ _

  have hG : l₀ ≫ Spec.map (CommRingCat.ofHom ψ) = W'.ι ≫ Spec.map (CommRingCat.ofHom ψ') := by
    rw [← heβ, ← heβ', ← Category.assoc, hl₀, Category.assoc]
  have E : ∀ y : R, l₀.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom (ψ y)) =
      W'.ι.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom (ψ' y)) := by
    intro y
    rw [pull ψ l₀ y, pull ψ' W'.ι y, hG]
  have E1 := E x₀
  have E2 := E x
  rw [h₀, ha, map_mul, map_mul] at E1
  rw [hx, hu', map_mul, map_mul, map_mul, map_mul, E1] at E2
  have KEY : W'.ι.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom u') =
      W'.ι.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom a) *
        l₀.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom u) := by
    rw [← mul_cancel_left_mem_nonZeroDivisors hιz, ← E2]
    ring

  have H2 : Set.range l' ⊆ Set.range W'.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨t, rfl⟩
    show l' t ∈ W'
    rw [hW', Scheme.Hom.mem_preimage, Scheme.Hom.mem_opensRange]
    refine ⟨l t, ?_⟩
    rw [← Scheme.Hom.comp_apply, hl, ← hl', Scheme.Hom.comp_apply]
  set m := IsOpenImmersion.lift W'.ι l' H2 with hmdef
  have hm : m ≫ W'.ι = l' := IsOpenImmersion.lift_fac _ _ _
  have hm₀ : m ≫ l₀ = l := by
    rw [← cancel_mono e, Category.assoc, hl₀, ← Category.assoc, hm, hl', hl]

  rw [← hm, ← hm₀]
  simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  rw [KEY, map_mul]

theorem wc_projK_glue_local_coords (K : Type u) [Field K] (n : ℕ) (X : Scheme.{u})
    (fX : X ⟶ Spec (.of K)) {I : Type} (U : I → X.Opens) (hU : (⨆ i, U i) = ⊤)
    (s : ∀ i, Fin (n + 1) → Γ(X, U i)) (hs : ∀ i, Ideal.span (Set.range (s i)) = ⊤)
    (w : ∀ i j, Γ(X, U i ⊓ U j)) (hw : ∀ i j, IsUnit (w i j))
    (htr : ∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) =
      w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) :
    ∃ φ : X ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fX ∧
      (∀ i J, φ ⁻¹ᵁ wcSgD K n J ⊓ U i = X.basicOpen (s i J)) ∧
      ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J) (hOi : O ≤ U i),
        φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) * X.presheaf.map (homOfLE hOi).op (s i J) =
          X.presheaf.map (homOfLE hOi).op (s i L) :=
by
  have hres : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl

  have GLUE0 : ∀ (Y : Scheme.{u}) (φ : ∀ i, (U i : Scheme.{u}) ⟶ Y),
      (∀ i j, X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i) ≫ φ i =
        X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φ j) →
      ∃ σ : X ⟶ Y, (∀ i, (U i).ι ≫ σ = φ i) ∧
        ∀ (Z : Scheme.{u}) (f g : X ⟶ Z), (∀ i, (U i).ι ≫ f = (U i).ι ≫ g) → f = g := by
    intro Y φ hφ
    let 𝒰 := X.openCoverOfIsOpenCover U hU
    refine ⟨𝒰.glueMorphisms φ ?_, fun i => 𝒰.ι_glueMorphisms φ _ i,
      fun Z f g h => 𝒰.hom_ext f g h⟩
    intro i j
    have hp := isPullback_opens_inf (U i) (U j)
    have e1 := hp.isoPullback_hom_fst
    have e2 := hp.isoPullback_hom_snd
    show Limits.pullback.fst (U i).ι (U j).ι ≫ φ i = Limits.pullback.snd (U i).ι (U j).ι ≫ φ j
    rw [← cancel_epi hp.isoPullback.hom, ← Category.assoc, ← Category.assoc, e1, e2]
    exact hφ i j
  have hHT : ∀ (A B : X.Opens) (e : A ≤ B) (x : Γ(X, B)),
      (X.homOfLE e).appTop (B.topIso.inv x) = A.topIso.inv (X.presheaf.map (homOfLE e).op x) := by
    intro A B e x
    rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_inv, Scheme.Opens.topIso_inv]
    erw [← CategoryTheory.comp_apply, ← CategoryTheory.comp_apply, ← Functor.map_comp,
      ← Functor.map_comp]
    rfl
  have hTI : ∀ (V : X.Opens) (O : (V : Scheme.{u}).Opens) (x : Γ(X, V)) (k : V.ι ''ᵁ O ≤ V),
      (V : Scheme.{u}).presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (V.topIso.inv x) =
        X.presheaf.map (homOfLE k).op x := by
    intro V O x k
    rw [Scheme.Opens.topIso_inv]
    erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl

  have hpull : ∀ (A' B' : Scheme.{u}) (f : A' ⟶ B') (h : B' ⟶ wcProjK K n)
      (t : Fin (n + 1) → Γ(B', ⊤)),
      (∀ J L (O : B'.Opens) (hO : O ≤ h ⁻¹ᵁ wcSgD K n J),
          h.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
            B'.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
          B'.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L)) →
      ∀ J L (O : A'.Opens) (hO : O ≤ (f ≫ h) ⁻¹ᵁ wcSgD K n J),
        (f ≫ h).appLE (wcSgD K n J) O hO (wcSgE K n J L) *
            A'.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (f.appTop (t J)) =
          A'.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (f.appTop (t L)) := by
    intro A' B' f h t hrel J L O hO
    have hO' : O ≤ f ⁻¹ᵁ (h ⁻¹ᵁ wcSgD K n J) := hO
