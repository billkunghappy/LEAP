    have hle3 : O ≤ (U i).ι ''ᵁ ((U i).ι ⁻¹ᵁ O) := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact le_inf hOi le_rfl
    have hk2 : (U i).ι ''ᵁ ((U i).ι ⁻¹ᵁ O) ≤ U i := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_le_left
    have hOe' : (U i).ι ⁻¹ᵁ O ≤ (U i).ι ⁻¹ᵁ (σ ⁻¹ᵁ wcSgD K n J) := hOe
    have c1 : ∀ x, ((U i).ι ≫ σ).appLE (wcSgD K n J) ((U i).ι ⁻¹ᵁ O) hOe x =
        (U i).ι.appLE (σ ⁻¹ᵁ wcSgD K n J) ((U i).ι ⁻¹ᵁ O) hOe'
          (σ.appLE (wcSgD K n J) (σ ⁻¹ᵁ wcSgD K n J) le_rfl x) := by
      intro x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_comp_appLE]
    rw [hTI _ _ _ hk2, hTI _ _ _ hk2, c1, Scheme.Opens.ι_appLE] at e
    have e' := congrArg (X.presheaf.map (homOfLE hle3).op) e
    have hk3 : (U i).ι ''ᵁ ((U i).ι ⁻¹ᵁ O) ≤ σ ⁻¹ᵁ wcSgD K n J := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact le_trans inf_le_right hO
    have g1 : ∀ x, σ.appLE (wcSgD K n J) O hO x = X.presheaf.map (homOfLE hle3).op
        (X.presheaf.map (homOfLE hk3).op
          (σ.appLE (wcSgD K n J) (σ ⁻¹ᵁ wcSgD K n J) le_rfl x)) := by
      intro x
      rw [← CategoryTheory.comp_apply, ← CategoryTheory.comp_apply, ← Category.assoc,
        Scheme.Hom.appLE_map, Scheme.Hom.appLE_map]
    have g2 : ∀ x, X.presheaf.map (homOfLE hOi).op x =
        X.presheaf.map (homOfLE hle3).op (X.presheaf.map (homOfLE hk2).op x) := fun x =>
      (hres _ _ _ _ _ _ x).symm
    rw [g1, g2, g2, ← map_mul]
    exact e'

theorem wc_srdcbR_emf_proj_map (K : Type u) [Field K] (N : ℕ) (F : Scheme.{u})
    (fX : F ⟶ Spec (.of K)) (C : Type u) [CommRing C] {ι : Type} (O : ι → F.Opens)
    (hO : (⨆ k, O k) = ⊤) (l : ∀ k, (O k).toScheme ⟶ Spec (.of C)) (u : ι → Fin (N + 1) → C)
    (τ : ι → Fin (N + 1)) (hτ : ∀ k, u k (τ k) = 1)
    (htr : ∀ k k' L,
      (F.homOfLE (inf_le_right : O k ⊓ O k' ≤ O k') ≫ l k').appTop.hom
          ((Scheme.ΓSpecIso (.of C)).inv.hom (u k' L)) =
        (F.homOfLE (inf_le_right : O k ⊓ O k' ≤ O k') ≫ l k').appTop.hom
            ((Scheme.ΓSpecIso (.of C)).inv.hom (u k' (τ k))) *
          (F.homOfLE (inf_le_left : O k ⊓ O k' ≤ O k) ≫ l k).appTop.hom
            ((Scheme.ΓSpecIso (.of C)).inv.hom (u k L))) :
    ∃ φ : F ⟶ wcProjK K N, φ ≫ wcProjKStr K N = fX ∧
      (∀ k J (t : (O k).toScheme),
        (O k).ι t ∈ φ ⁻¹ᵁ wcSgD K N J ↔ u k J ∉ PrimeSpectrum.asIdeal (l k t)) ∧
      ∀ k J L (O' : F.Opens) (h1 : O' ≤ φ ⁻¹ᵁ wcSgD K N J) (h2 : O' ≤ O k),
        φ.appLE (wcSgD K N J) O' h1 (wcSgE K N J L) *
            F.presheaf.map (homOfLE h2).op
              ((O k).topIso.hom ((l k).appTop ((Scheme.ΓSpecIso (.of C)).inv (u k J)))) =
          F.presheaf.map (homOfLE h2).op
            ((O k).topIso.hom ((l k).appTop ((Scheme.ΓSpecIso (.of C)).inv (u k L)))) :=
by
  classical

  have s2 : ∀ {U V : F.Opens} (h : V ≤ U) {Y : Scheme.{u}} (f : U.toScheme ⟶ Y)
      (c : Γ(Y, ⊤)), F.presheaf.map (homOfLE h).op (U.topIso.hom (f.appTop c)) =
        V.topIso.hom ((F.homOfLE h ≫ f).appTop c) := by
    intro U V h Y f c
    rw [Scheme.Hom.comp_appTop, Scheme.homOfLE_appTop, Scheme.Opens.topIso_hom,
      Scheme.Opens.topIso_hom]
    change (f.appTop ≫ F.presheaf.map _ ≫ F.presheaf.map _) c =
      (f.appTop ≫ F.presheaf.map _ ≫ F.presheaf.map _) c
    erw [← Functor.map_comp, ← Functor.map_comp]
    rfl

  have s3 : ∀ (U : F.Opens) (l' : U.toScheme ⟶ Spec (.of C)) (c : C) (t : U.toScheme),
      U.ι t ∈ F.basicOpen (U.topIso.hom (l'.appTop ((Scheme.ΓSpecIso (.of C)).inv c))) ↔
        c ∉ PrimeSpectrum.asIdeal (l' t) := by
    intro U l' c t
    rw [← Scheme.Opens.ι_image_basicOpen_topIso_inv, Iso.hom_inv_id_apply,
      ← Scheme.Hom.preimage_basicOpen_top]
    rw [← Scheme.Hom.mem_preimage, Scheme.Hom.preimage_image_eq, Scheme.Hom.mem_preimage,
      basicOpen_eq_of_affine]
    exact PrimeSpectrum.mem_basicOpen _ _
  let sec : ∀ k, Fin (N + 1) → Γ(F, O k) := fun k J =>
    (O k).topIso.hom ((l k).appTop ((Scheme.ΓSpecIso (.of C)).inv (u k J)))
  let w : ∀ k k', Γ(F, O k ⊓ O k') := fun k k' =>
    (O k ⊓ O k').topIso.hom ((F.homOfLE (inf_le_right : O k ⊓ O k' ≤ O k') ≫ l k').appTop
      ((Scheme.ΓSpecIso (.of C)).inv (u k' (τ k))))
  have hsec1 : ∀ k, sec k (τ k) = 1 := by
    intro k
    simp only [sec, hτ k, map_one]
  have hs : ∀ k, Ideal.span (Set.range (sec k)) = ⊤ := fun k =>
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨τ k, rfl⟩)
      (by rw [hsec1 k]; exact isUnit_one)
  have htr' : ∀ i j J,
      F.presheaf.map (homOfLE (inf_le_right : O i ⊓ O j ≤ O j)).op (sec j J) =
        w i j * F.presheaf.map (homOfLE (inf_le_left : O i ⊓ O j ≤ O i)).op (sec i J) := by
    intro i j J
    simp only [sec, w]
    rw [s2, s2, ← map_mul]
    exact congrArg (fun x => (O i ⊓ O j).topIso.hom x) (htr i j J)
  have hw : ∀ i j, IsUnit (w i j) := by
    intro i j
    have h := htr i j (τ j)
    rw [hτ j] at h
    have h1 := congrArg (fun x => (O i ⊓ O j).topIso.hom x) h
    simp only [map_one, map_mul] at h1
    exact IsUnit.of_mul_eq_one _ h1.symm
  obtain ⟨φ, hφ, hB, hRel⟩ := wc_projK_glue_local_coords K N F fX O hO sec hs w hw htr'
  refine ⟨φ, hφ, ?_, fun k J L O' h1 h2 => hRel k J L O' h1 h2⟩
  intro k J t
  have hmem : (O k).ι t ∈ O k := by
    have : (O k).ι t ∈ Set.range (O k).ι := ⟨t, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  rw [← s3 (O k) (l k) (u k J) t]
  change _ ↔ (O k).ι t ∈ F.basicOpen (sec k J)
  rw [← hB k J]
  constructor
  · intro h
    exact ⟨h, hmem⟩
  · intro h
    exact h.1

theorem wc_projK_chart_tuple_facts (K : Type u) [Field K] (n : ℕ) (T : Scheme.{u})
    (g : T ⟶ wcProjK K n) (c c' : Fin (n + 1)) :
    (g.app (wcSgD K n c)).hom (wcSgE K n c c) = 1 ∧
    (∀ (J L : Fin (n + 1)) (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K n J)
        (hOW : O ≤ g ⁻¹ᵁ wcSgD K n c),
      g.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
          T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n c)).hom (wcSgE K n c J)) =
        T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n c)).hom (wcSgE K n c L))) ∧
    (∀ L : Fin (n + 1),
      T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
          g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' L)) =
        T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
          g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' c)) *
        T.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
          g ⁻¹ᵁ wcSgD K n c)).op ((g.app (wcSgD K n c)).hom (wcSgE K n c L))) ∧
    T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
        g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' c)) *
      T.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
        g ⁻¹ᵁ wcSgD K n c)).op ((g.app (wcSgD K n c)).hom (wcSgE K n c c')) = 1 :=
by

  have L2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
    intro σ A _ _ _ 𝒜 _ f g h hf hg hh
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
        exact this.symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
        exact this.symm
      rw [e1, e1, e2, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _
  have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)

  have C0 : ∀ J L j : Fin (n + 1),
      (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤
          wcSgD K n J)).op (wcSgE K n J j) =
        (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤
          wcSgD K n J)).op (wcSgE K n J L) *
        (wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n J ⊓ wcSgD K n L ≤
          wcSgD K n L)).op (wcSgE K n L j) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    intro J L j
    exact L2 _ (MvPolynomial.X J) (MvPolynomial.X L) (MvPolynomial.X j) (hX J) (hX L) (hX j)

  have E1 : ∀ J : Fin (n + 1), wcSgE K n J J = 1 := by
    intro J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have h1 : HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1
        (MvPolynomial.X J) (hX J) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
        ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp⟩
    show Proj.awayToSection _ _ _ = 1
    rw [h1, map_one]

  have T0 : ∀ (A A' : (wcProjK K n).Opens) (k : A' ≤ A) (s : Γ(wcProjK K n, A)) (O : T.Opens)
      (h' : O ≤ g ⁻¹ᵁ A') (h : O ≤ g ⁻¹ᵁ A),
      g.appLE A' O h' ((wcProjK K n).presheaf.map (homOfLE k).op s) = g.appLE A O h s := by
    intro A A' k s O h' h
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]

  have II : ∀ (a J L : Fin (n + 1)) (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K n J)
      (hOW : O ≤ g ⁻¹ᵁ wcSgD K n a),
      g.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
          T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a J)) =
        T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a L)) := by
    intro a J L O hO hOW
    have hW : O ≤ g ⁻¹ᵁ (wcSgD K n a ⊓ wcSgD K n J) := by
      rw [Scheme.Hom.preimage_inf]
      exact le_inf hOW hO
    have e1 : T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a J)) =
        g.appLE (wcSgD K n a ⊓ wcSgD K n J) O hW
          ((wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n a ⊓ wcSgD K n J ≤
            wcSgD K n a)).op (wcSgE K n a J)) :=
      (T0 _ _ inf_le_left _ O hW hOW).symm
    have e2 : T.presheaf.map (homOfLE hOW).op ((g.app (wcSgD K n a)).hom (wcSgE K n a L)) =
        g.appLE (wcSgD K n a ⊓ wcSgD K n J) O hW
          ((wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n a ⊓ wcSgD K n J ≤
            wcSgD K n a)).op (wcSgE K n a L)) :=
      (T0 _ _ inf_le_left _ O hW hOW).symm
    have e3 : g.appLE (wcSgD K n J) O hO (wcSgE K n J L) =
        g.appLE (wcSgD K n a ⊓ wcSgD K n J) O hW
          ((wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n a ⊓ wcSgD K n J ≤
            wcSgD K n J)).op (wcSgE K n J L)) :=
      (T0 _ _ inf_le_right _ O hW hO).symm
    rw [e1, e2, e3, C0 a J L, map_mul, mul_comm]
  refine ⟨?_, II c, ?_, ?_⟩
  · rw [E1 c, map_one]
  · intro L
    have h := II c' c L (g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c') inf_le_left inf_le_right
    exact h.symm.trans (mul_comm _ _)
  · have h := II c' c c' (g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c') inf_le_left inf_le_right
    have h1 : T.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcSgD K n c ⊓ g ⁻¹ᵁ wcSgD K n c' ≤
        g ⁻¹ᵁ wcSgD K n c')).op ((g.app (wcSgD K n c')).hom (wcSgE K n c' c')) = 1 := by
      rw [E1 c', map_one, map_one]
    exact (mul_comm _ _).trans (h.trans h1)

theorem wc_srdcbR_emf_local_inverse (K : Type u) [Field K] (N : ℕ) {X' : Scheme.{u}}
    {R C B₀ : Type u} [CommRing R] [CommRing C] [CommRing B₀]
    (β : X' ⟶ Spec (.of R)) (ρ : R →+* B₀) (q : Spec (.of B₀) ⟶ Spec (.of K))
    (e : Spec (.of C) ⟶ X') [IsOpenImmersion e] (ψ : R →+* C)
    (heβ : e ≫ β = Spec.map (CommRingCat.ofHom ψ))
    (u : Fin (N + 1) → C) (t : Fin (N + 1)) (hut : u t = 1)
    (EX : ∀ (B : Type u) [CommRing B] (χ : B₀ →+* B) (w : Fin (N + 1) → B), w t = 1 →
      ∃ γ : C →+* B, γ.comp ψ = χ.comp ρ ∧ ∀ L, γ (u L) = w L)
    (UN : ∀ (B : Type u) [CommRing B] (γ γ' : C →+* B), γ.comp ψ = γ'.comp ψ →
      (∀ L, γ (u L) = γ' (u L)) → γ = γ')
    (φ : Limits.pullback β (Spec.map (CommRingCat.ofHom ρ)) ⟶ wcProjK K N)
    (hφ : φ ≫ wcProjKStr K N = Limits.pullback.snd β (Spec.map (CommRingCat.ofHom ρ)) ≫ q)
    (l : (Limits.pullback.fst β (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ e.opensRange).toScheme ⟶
      Spec (.of C))
    (hl : l ≫ e = (Limits.pullback.fst β (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ e.opensRange).ι ≫
      Limits.pullback.fst β (Spec.map (CommRingCat.ofHom ρ)))
    (hsub : φ ⁻¹ᵁ wcSgD K N t ≤ Limits.pullback.fst β (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ e.opensRange)
    (REL : ∀ J L (O' : (Limits.pullback β (Spec.map (CommRingCat.ofHom ρ))).Opens)
      (h1 : O' ≤ φ ⁻¹ᵁ wcSgD K N J)
      (h2 : O' ≤ Limits.pullback.fst β (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ e.opensRange),
      φ.appLE (wcSgD K N J) O' h1 (wcSgE K N J L) *
          (Limits.pullback β (Spec.map (CommRingCat.ofHom ρ))).presheaf.map (homOfLE h2).op
            ((Limits.pullback.fst β (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ e.opensRange).topIso.hom
              (l.appTop ((Scheme.ΓSpecIso (.of C)).inv (u J)))) =
        (Limits.pullback β (Spec.map (CommRingCat.ofHom ρ))).presheaf.map (homOfLE h2).op
          ((Limits.pullback.fst β (Spec.map (CommRingCat.ofHom ρ)) ⁻¹ᵁ e.opensRange).topIso.hom
            (l.appTop ((Scheme.ΓSpecIso (.of C)).inv (u L))))) :
    ∃ Θ : (Limits.pullback.fst (wcProjKStr K N) q ⁻¹ᵁ wcSgD K N t).toScheme ⟶
        Limits.pullback β (Spec.map (CommRingCat.ofHom ρ)),
      Θ ≫ Limits.pullback.lift φ (Limits.pullback.snd β (Spec.map (CommRingCat.ofHom ρ))) hφ =
          (Limits.pullback.fst (wcProjKStr K N) q ⁻¹ᵁ wcSgD K N t).ι ∧
        (Limits.pullback.lift φ (Limits.pullback.snd β (Spec.map (CommRingCat.ofHom ρ))) hφ ∣_
            (Limits.pullback.fst (wcProjKStr K N) q ⁻¹ᵁ wcSgD K N t)) ≫ Θ =
          (Limits.pullback.lift φ (Limits.pullback.snd β (Spec.map (CommRingCat.ofHom ρ))) hφ ⁻¹ᵁ
            (Limits.pullback.fst (wcProjKStr K N) q ⁻¹ᵁ wcSgD K N t)).ι :=
by

  have s1i : ∀ {T : Scheme.{u}} {R : CommRingCat.{u}} (c : R ⟶ Γ(T, ⊤)),
      (Scheme.ΓSpecIso R).inv ≫ (T.toSpecΓ ≫ Spec.map c).appTop = c := by
    intro T R c
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc, Scheme.toSpecΓ_appTop, Iso.inv_hom_id, Category.comp_id]
  have s1iii : ∀ {T : Scheme.{u}} {R S : CommRingCat.{u}} (c : S ⟶ R) (f : T ⟶ Spec R),
      (Scheme.ΓSpecIso S).inv ≫ (f ≫ Spec.map c).appTop =
        c ≫ (Scheme.ΓSpecIso R).inv ≫ f.appTop := by
    intro T R S c f
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  have appTop_res : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (W : X.Opens) (e : W ≤ f ⁻¹ᵁ ⊤)
      (y : Γ(Y, ⊤)), X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (f.appTop y) =
        f.appLE ⊤ W e y := by
    intro X Y f W e y
    have h1 := Scheme.Hom.appLE_map f (le_refl (f ⁻¹ᵁ ⊤)) (homOfLE e).op
    rw [Scheme.Hom.appLE_eq_app] at h1
    exact congrArg (fun g => g.hom y) h1
  have appLE_res : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {V V' : X.Opens}
      (e : V ≤ f ⁻¹ᵁ U) (hV : V' ≤ V) (z : Γ(Y, U)),
      X.presheaf.map (homOfLE hV).op (f.appLE U V e z) = f.appLE U V' (hV.trans e) z := by
    intro X Y f U V V' e hV z
    exact congrArg (fun g => g.hom z) (Scheme.Hom.appLE_map f e (homOfLE hV).op)
  have res_appLE : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} {V : X.Opens}
      (e : V ≤ f ⁻¹ᵁ U) (hU : U ≤ U') (z : Γ(Y, U')),
      f.appLE U V e (Y.presheaf.map (homOfLE hU).op z) =
        f.appLE U' V (e.trans (f.preimage_mono hU)) z := by
    intro X Y f U U' V e hU z
    exact congrArg (fun g => g.hom z) (Scheme.Hom.map_appLE f e (homOfLE hU).op)
  have appLE_comp' : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (U : Z.Opens) (V : Y.Opens)
      (W : X.Opens) (e₁ : V ≤ g ⁻¹ᵁ U) (e₂ : W ≤ f ⁻¹ᵁ V) (e₃ : W ≤ (f ≫ g) ⁻¹ᵁ U) (z : Γ(Z, U)),
      f.appLE V W e₂ (g.appLE U V e₁ z) = (f ≫ g).appLE U W e₃ z := by
    intro X Y Z f g U V W e₁ e₂ e₃ z
    exact congrArg (fun k => k.hom z) (Scheme.Hom.appLE_comp_appLE f g U V W e₁ e₂)
  have compTop : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (z : Γ(Z, ⊤)),
      f.appTop (g.appTop z) = (f ≫ g).appTop z := by
    intro X Y Z f g z
    rw [Scheme.Hom.comp_appTop]; rfl
  have appLE_eq : ∀ {X Y : Scheme.{u}} {f g : X ⟶ Y} (h : f = g) (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U), f.appLE U V e = g.appLE U V (h ▸ e) := by
    intro X Y f g h U V e
    subst h
    rfl
  have map_top : ∀ {X : Scheme.{u}} (y : Γ(X, ⊤)),
      X.presheaf.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op y = y := by
    intro X y
    rw [show (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
      CategoryTheory.Functor.map_id]
    rfl
  have s2 : ∀ {T F : Scheme.{u}} (O : F.Opens) (h : T ⟶ F) (θ : T ⟶ O.toScheme), θ ≫ O.ι = h →
      ∀ (W : T.Opens) (hle : W ≤ h ⁻¹ᵁ O) (x : Γ(O.toScheme, ⊤)),
      h.appLE O W hle (O.topIso.hom x) =
        T.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (θ.appTop x) := by
    intro T F O h θ hθ W hle x
    subst hθ
    have hk : (⊤ : O.toScheme.Opens) ≤ O.ι ⁻¹ᵁ O := by rw [Scheme.Opens.ι_preimage_self]
    rw [← Scheme.Hom.appLE_comp_appLE θ O.ι O ⊤ W hk le_top]
    have hK : O.topIso.hom ≫ O.ι.appLE O ⊤ hk = 𝟙 _ := by
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_hom]
      exact (F.presheaf.map_comp _ _).symm.trans
        ((congrArg F.presheaf.map (Subsingleton.elim _ _)).trans (F.presheaf.map_id _))
    have hx : (O.ι.appLE O ⊤ hk) (O.topIso.hom x) = x := by
      rw [← CommRingCat.comp_apply, hK]; rfl
    rw [CommRingCat.comp_apply, hx]
    exact (appTop_res θ W _ x).symm

  have s3 : ∀ {Fs T : Scheme.{u}} (φ : Fs ⟶ wcProjK K N) (OF : Fs.Opens)
      (s : Fin (N + 1) → Γ(Fs, OF)),
      (∀ (J L : Fin (N + 1)) (O' : Fs.Opens) (h1 : O' ≤ φ ⁻¹ᵁ wcSgD K N J) (h2 : O' ≤ OF),
        φ.appLE (wcSgD K N J) O' h1 (wcSgE K N J L) * Fs.presheaf.map (homOfLE h2).op (s J) =
          Fs.presheaf.map (homOfLE h2).op (s L)) →
      ∀ (h : T ⟶ Fs) (hTO : ∀ O : T.Opens, O ≤ h ⁻¹ᵁ OF) (J L : Fin (N + 1)) (O : T.Opens)
        (hO : O ≤ (h ≫ φ) ⁻¹ᵁ wcSgD K N J),
        (h ≫ φ).appLE (wcSgD K N J) O hO (wcSgE K N J L) * h.appLE OF O (hTO O) (s J) =
          h.appLE OF O (hTO O) (s L) := by
    intro Fs T φ OF s hrel h hTO J L O hO
    have hO' : O ≤ h ⁻¹ᵁ (OF ⊓ φ ⁻¹ᵁ wcSgD K N J) := by
      rw [Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage]
      exact le_inf (hTO O) hO
    have H := congrArg (fun z => (h.appLE (OF ⊓ φ ⁻¹ᵁ wcSgD K N J) O hO') z)
      (hrel J L (OF ⊓ φ ⁻¹ᵁ wcSgD K N J) inf_le_right inf_le_left)
    simp only [map_mul] at H
    rw [appLE_comp' h φ _ _ _ _ _ hO, res_appLE, res_appLE] at H
    exact H

  have s4 : ∀ (T : Scheme.{u}) (g g' : T ⟶ wcProjK K N)
      (ht : ∀ O : T.Opens, O ≤ g' ⁻¹ᵁ wcSgD K N t),
      g ≫ wcProjKStr K N = g' ≫ wcProjKStr K N →
      (∀ (J L : Fin (N + 1)) (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K N J),
        g.appLE (wcSgD K N J) O hO (wcSgE K N J L) *
            g'.appLE (wcSgD K N t) O (ht O) (wcSgE K N t J) =
          g'.appLE (wcSgD K N t) O (ht O) (wcSgE K N t L)) → g = g' := by
    intro T g g' ht hstr hrel
    obtain ⟨τ, hτ⟩ : ∃ τ : Fin (N + 1) → Γ(T, ⊤),
        ∀ J, τ J = g'.appLE (wcSgD K N t) ⊤ (ht ⊤) (wcSgE K N t J) := ⟨_, fun _ => rfl⟩
    have hRτ : ∀ (J : Fin (N + 1)) (O : T.Opens) (hOW : O ≤ ⊤),
        T.presheaf.map (homOfLE hOW).op (τ J) = g'.appLE (wcSgD K N t) O (ht O) (wcSgE K N t J) := by
      intro J O hOW
      rw [hτ, appLE_res]
    have hcov : (⨆ J, T.basicOpen (τ J)) = ⊤ := by
      apply le_antisymm le_top
      have h1 : τ t = 1 := by
        rw [hτ, (wc_ldpi_oai_sgE_facts K N t t).1, map_one]
      calc (⊤ : T.Opens) = T.basicOpen (τ t) := by rw [h1, Scheme.basicOpen_one]
        _ ≤ ⨆ J, T.basicOpen (τ J) := le_iSup (fun J => T.basicOpen (τ J)) t
    have key := wc_csd_proj_uniq_of_relations K N T ⊤ g g' τ hstr hcov
      (fun J L O hO hOW => by rw [hRτ, hRτ]; exact hrel J L O hO)
      (fun J L O hO hOW => by
        rw [hRτ, hRτ]
        exact (wc_projK_chart_tuple_facts K N T g' t t).2.1 J L O hO (ht O))
    rw [← Scheme.topIso_hom] at key
    exact (cancel_epi _).mp key

  have s5 : ∀ {T : Scheme.{u}} (f₁ f₂ : T ⟶ Spec (.of C)),
      f₁ ≫ Spec.map (CommRingCat.ofHom ψ) = f₂ ≫ Spec.map (CommRingCat.ofHom ψ) →
      (∀ L, f₁.appTop ((Scheme.ΓSpecIso (.of C)).inv (u L)) =
        f₂.appTop ((Scheme.ΓSpecIso (.of C)).inv (u L))) → f₁ = f₂ := by
    intro T f₁ f₂ h1 h2
    have e1 : (Scheme.ΓSpecIso (.of R)).inv ≫ (f₁ ≫ Spec.map (CommRingCat.ofHom ψ)).appTop =
        (Scheme.ΓSpecIso (.of R)).inv ≫ (f₂ ≫ Spec.map (CommRingCat.ofHom ψ)).appTop := by
      rw [h1]
    rw [s1iii, s1iii] at e1
    have hγ : ((Scheme.ΓSpecIso (.of C)).inv ≫ f₁.appTop).hom =
        ((Scheme.ΓSpecIso (.of C)).inv ≫ f₂.appTop).hom := by
      apply UN Γ(T, ⊤)
      · ext x
        exact congrArg (fun g => g.hom x) e1
      · intro L
        exact h2 L
    apply ext_of_isAffine
    rw [← cancel_epi (Scheme.ΓSpecIso (.of C)).inv]
    exact CommRingCat.hom_ext hγ

  have main : ∀ (Fs P : Scheme.{u}) (p1 : Fs ⟶ X') (p2 : Fs ⟶ Spec (.of B₀))
      (fP : P ⟶ wcProjK K N) (sP : P ⟶ Spec (.of B₀))
      (hcond : p1 ≫ β = p2 ≫ Spec.map (CommRingCat.ofHom ρ))
      (hext : ∀ {Z : Scheme.{u}} (f g : Z ⟶ Fs), f ≫ p1 = g ≫ p1 → f ≫ p2 = g ≫ p2 → f = g)
      (hlift : ∀ {Z : Scheme.{u}} (f : Z ⟶ X') (g : Z ⟶ Spec (.of B₀)),
        f ≫ β = g ≫ Spec.map (CommRingCat.ofHom ρ) → ∃ h : Z ⟶ Fs, h ≫ p1 = f ∧ h ≫ p2 = g)
      (hcondP : fP ≫ wcProjKStr K N = sP ≫ q)
      (hextP : ∀ {Z : Scheme.{u}} (f g : Z ⟶ P), f ≫ fP = g ≫ fP → f ≫ sP = g ≫ sP → f = g)
      (φ : Fs ⟶ wcProjK K N) (Ψ : Fs ⟶ P) (hΨ1 : Ψ ≫ fP = φ) (hΨ2 : Ψ ≫ sP = p2)
      (OF : Fs.Opens) (hOF : ∀ x : Fs, p1 x ∈ Set.range e → x ∈ OF)
      (l : OF.toScheme ⟶ Spec (.of C)) (hl : l ≫ e = OF.ι ≫ p1)
      (V : P.Opens) (hV : ∀ x : P, x ∈ V ↔ fP x ∈ wcSgD K N t)
      (hsub : φ ⁻¹ᵁ wcSgD K N t ≤ OF)
      (REL : ∀ J L (O' : Fs.Opens) (h1 : O' ≤ φ ⁻¹ᵁ wcSgD K N J) (h2 : O' ≤ OF),
        φ.appLE (wcSgD K N J) O' h1 (wcSgE K N J L) *
            Fs.presheaf.map (homOfLE h2).op
              (OF.topIso.hom (l.appTop ((Scheme.ΓSpecIso (.of C)).inv (u J)))) =
          Fs.presheaf.map (homOfLE h2).op
            (OF.topIso.hom (l.appTop ((Scheme.ΓSpecIso (.of C)).inv (u L))))),
      ∃ Θ : V.toScheme ⟶ Fs, Θ ≫ Ψ = V.ι ∧ (Ψ ∣_ V) ≫ Θ = (Ψ ⁻¹ᵁ V).ι := by
    intro Fs P p1 p2 fP sP hcond hext hlift hcondP hextP φ Ψ hΨ1 hΨ2 OF hOF l hl V hV hsub REL

    obtain ⟨sec, hsec⟩ : ∃ sec : Fin (N + 1) → Γ(Fs, OF),
        ∀ J, sec J = OF.topIso.hom (l.appTop ((Scheme.ΓSpecIso (.of C)).inv (u J))) :=
      ⟨_, fun _ => rfl⟩
    have REL' : ∀ (J L : Fin (N + 1)) (O' : Fs.Opens) (h1 : O' ≤ φ ⁻¹ᵁ wcSgD K N J)
        (h2 : O' ≤ OF), φ.appLE (wcSgD K N J) O' h1 (wcSgE K N J L) *
          Fs.presheaf.map (homOfLE h2).op (sec J) = Fs.presheaf.map (homOfLE h2).op (sec L) := by
      intro J L O' h1 h2
      rw [hsec, hsec]
      exact REL J L O' h1 h2

    have hVι : ∀ x : V.toScheme, fP (V.ι x) ∈ wcSgD K N t := fun x => (hV _).mp (by
      have : V.ι x ∈ Set.range V.ι := ⟨x, rfl⟩
      rwa [Scheme.Opens.range_ι] at this)
    have hVt : ∀ O : V.toScheme.Opens, O ≤ (V.ι ≫ fP) ⁻¹ᵁ wcSgD K N t := by
      intro O x _
      exact (Scheme.Hom.mem_preimage _).mpr (by rw [Scheme.Hom.comp_apply]; exact hVι x)

    obtain ⟨b, hb_def⟩ : ∃ b : V.toScheme ⟶ Spec (.of B₀), b = V.ι ≫ sP := ⟨_, rfl⟩
    obtain ⟨χ, hχ⟩ : ∃ χ : B₀ →+* Γ(V.toScheme, ⊤),
        χ = ((Scheme.ΓSpecIso (.of B₀)).inv ≫ b.appTop).hom := ⟨_, rfl⟩
    obtain ⟨w, hw⟩ : ∃ w : Fin (N + 1) → Γ(V.toScheme, ⊤),
        ∀ L, w L = (V.ι ≫ fP).appLE (wcSgD K N t) ⊤ (hVt ⊤) (wcSgE K N t L) :=
      ⟨_, fun _ => rfl⟩
    have hwt : w t = 1 := by
      rw [hw, (wc_ldpi_oai_sgE_facts K N t t).1, map_one]
