  obtain ⟨v', hv'sp, hv'S⟩ := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).2
    ((wcEtToProEt (wcP1Over F'').left).obj V) v ⟨i, hv⟩
  have hsp : (v' : V.left) ⤳ v := hv'sp
  have hηO : ∀ j : Fin D.m, V.hom v' ≠ D.S j (IsLocalRing.closedPoint F'') :=
