      Γ(W, κ ⁻¹ᵁ wcSgD K n J ⊓ κ ⁻¹ᵁ wcSgD K n L) :=
    (κ.appLE _ _ hO).hom.comp (((wcProjK K n).presheaf.map (homOfLE hV).op).hom.comp
