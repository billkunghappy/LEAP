  obtain ⟨ξo, hξo⟩ : ∃ ξo : ∀ l, Spec (.of (AlgebraicClosure
      ((wcP1Over F'').left.residueField (V.hom v')))) ⟶ ((W'.obj l).right.hom ⁻¹ᵁ O).toScheme,
      ∀ l, ξo l ≫ ((W'.obj l).right.hom ⁻¹ᵁ O).ι = ξ ≫ φ l :=
    ⟨fun l => IsOpenImmersion.lift _ _ (hξrange l), fun l => IsOpenImmersion.lift_fac _ _ _⟩

  haveI hVet : Etale V.hom := V.prop
  obtain ⟨tv, htv, htvpt⟩ : ∃ t : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField
      (D.S i (IsLocalRing.closedPoint F''))))) ⟶ V.left,
      t ≫ V.hom = wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')) ∧
