import WeilR2_Part23
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_srdcbu_chart_fibre : ∀ (A : Type u) [CommRing A] (r : ℕ) (π : A) (K : Type u) [Field K] (φ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) (ε : Fin (r + 2) → Fin (r + 2)), φ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) = algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) → Function.Involutive ε → (∀ q, (ε q).val % 2 = q.val % 2) → (∀ q, φ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r)) (MvPolynomial.X q)) = Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (wcSrmFimg A r (ε q))) → ∀ (τ : CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ⟶ CommRingCat.of K), (∀ q : Fin (r + 2), q.val % 2 = 0 → τ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r)) (MvPolynomial.X q)) = 0) → PreconnectedSpace ↥(Limits.pullback (Spec.map τ) (Spec.map (CommRingCat.ofHom φ))) ∧ ∃ p₀ : ↥(Limits.pullback (Spec.map τ) (Spec.map (CommRingCat.ofHom φ))), ∀ q : Fin (r + 2), q.val % 2 = 0 → q.val ≠ 0 → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X q) ∉ (Limits.pullback.snd (Spec.map τ) (Spec.map (CommRingCat.ofHom φ)) p₀).asIdeal :=
by
  intro A _ r π K _ φ ε hφA hinv hpar hφX τ hτ
  classical



  let x : Fin (r + 2) → wcQuadModelRing A (r + 2) π (wcSrmCh A r) :=
    fun p => Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r)) (MvPolynomial.X p)
  let y : Fin (r + 2) → wcQuadModelRing A (r + 2) π (wcSrmC0 A r) :=
    fun p => Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X p)
  set p0 : Fin (r + 2) := ⟨0, by omega⟩ with hp0
  set p1 : Fin (r + 2) := ⟨1, by omega⟩ with hp1
  have Lc0 : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmC0 A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ := by
    intro S _ g f
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · simp
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      simp [this]
    · simp
  have Lch : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmCh A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ +
        ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * f i.succ * f b := by
    intro S _ g f
    rw [Fin.sum_univ_succ]
    congr 1
    rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
    · simp
    · intro b _ hb
      have : b.val ≠ 1 := fun h => hb (Fin.ext h)
      simp [this]
    · simp
  have hF0 : wcSrmFimg A r p0 = MvPolynomial.X p0 := by simp [wcSrmFimg, hp0]
  have hF1 : wcSrmFimg A r p1 = MvPolynomial.X p1 + MvPolynomial.X p0 * MvPolynomial.X p1 -
      ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b := by
    simp [wcSrmFimg, hp0, hp1]
  have hFev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 →
      wcSrmFimg A r p = MvPolynomial.X p0 * MvPolynomial.X p := by
    intro p h0 h2
    have h1 : p.val ≠ 1 := by omega
    simp [wcSrmFimg, h0, h1, h2, hp0]
  have hFodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 →
      wcSrmFimg A r p = MvPolynomial.X p := by
    intro p h1 h2
    have h0 : p.val ≠ 0 := by omega
    simp [wcSrmFimg, h0, h1, h2]
  have hφF : ∀ p, φ (x (ε p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (wcSrmFimg A r p) := by
    intro p
    have h := hφX (ε p)
    rw [hinv p] at h
    exact h
  have hφ0 : φ (x (ε p0)) = y p0 := by
    rw [hφF, hF0]
  have hφev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 → φ (x (ε p)) = y p0 * y p := by
    intro p h0 h2
    rw [hφF, hFev p h0 h2, map_mul]
  have hφodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → φ (x (ε p)) = y p := by
    intro p h1 h2
    rw [hφF, hFodd p h1 h2]
  have hφ1 : φ (x (ε p1)) = y p1 + y p0 * y p1 -
      ∑ a, ∑ b, algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) (wcSrmCh A r a b) *
        y a * y b := by
    rw [hφF, hF1]
    simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
      Ideal.Quotient.mk_algebraMap]
    rfl
  have hrelR : ∑ a, ∑ b, (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))
      (wcSrmCh A r a b)) * x a * x b =
      algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) π := by
    have h : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
        (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [map_sub, sub_eq_zero] at h
    simpa only [map_sum, map_mul, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      using h



  have hext : ∀ (S : Type u) [CommRing S]
      (ψ₁ ψ₂ : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+* S),
      ψ₁.comp φ = ψ₂.comp φ →
      (∀ z : {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0}, ψ₁ (y z.val) = ψ₂ (y z.val)) →
      ψ₁ = ψ₂ := by
    intro S _ ψ₁ ψ₂ hψ hZ
    have hc : ∀ t, ψ₁ (φ t) = ψ₂ (φ t) := fun t => by
      rw [← RingHom.comp_apply, hψ, RingHom.comp_apply]
    have hga : ∀ c, ψ₁ (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) c) =
        ψ₂ (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) c) := by
      intro c
      rw [← hφA, RingHom.comp_apply, hc]
    have hy0 : ψ₁ (y p0) = ψ₂ (y p0) := by rw [← hφ0, hc]
    have hyodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → ψ₁ (y p) = ψ₂ (y p) := by
      intro p h1 h2
      rw [← hφodd p h1 h2, hc]
    have hyev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 → ψ₁ (y p) = ψ₂ (y p) :=
      fun p h0 h2 => hZ ⟨p, h2, h0⟩
    have hy1 : ψ₁ (y p1) = ψ₂ (y p1) := by
      have e : y p1 = φ (x (ε p1)) + ∑ i : Fin (r + 1), ∑ b,
          algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) (wcSrmCh A r i.succ b) *
            y i.succ * y b := by
        rw [hφ1, Lch (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r))) y]
        ring
      rw [e, map_add, map_add, hc]
      congr 1
      simp only [map_sum, map_mul]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun b _ => ?_))
      by_cases h : (Fin.succ i).val % 2 = 0 ∧ b.val = (Fin.succ i).val + 1
      · have hs : (Fin.succ i).val = i.val + 1 := Fin.val_succ i
        rw [hga, hyev _ (by omega) h.1, hyodd b (by omega) (by omega)]
      · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul]
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply]
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hga]
    · intro p
      simp only [RingHom.comp_apply]
      change ψ₁ (y p) = ψ₂ (y p)
      by_cases h0 : p.val = 0
      · have : p = p0 := Fin.ext h0
        rw [this]; exact hy0
      by_cases h1 : p.val = 1
      · have : p = p1 := Fin.ext h1
        rw [this]; exact hy1
      by_cases h2 : p.val % 2 = 0
      · exact hyev p h0 h2
      · exact hyodd p h1 h2



  let a : Fin (r + 2) → K := fun p => τ.hom (x (ε p))
  have ha_ev : ∀ p : Fin (r + 2), p.val % 2 = 0 → a p = 0 := by
    intro p h
    exact hτ (ε p) (by rw [hpar p]; exact h)
  have hτπ : τ.hom (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) π) = 0 := by
    rw [← hrelR]
    simp only [map_sum, map_mul]
    apply Finset.sum_eq_zero
    intro c _
    apply Finset.sum_eq_zero
    intro b _
    by_cases h : c.val % 2 = 0 ∧ b.val = c.val + 1
    · rw [show τ.hom (x c) = 0 from hτ c h.1]
      ring
    · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul]
  let g : A →+* MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K :=
    MvPolynomial.C.comp (τ.hom.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))))
  let w : Fin (r + 2) → MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K :=
    fun p => if h : p.val % 2 = 0 ∧ p.val ≠ 0 then MvPolynomial.X ⟨p, h⟩
      else if p.val % 2 = 0 then 0 else MvPolynomial.C (a p)
  let S : MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K :=
    ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * w i.succ * w b
  let v : Fin (r + 2) → MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K :=
    fun p => if p.val = 1 then MvPolynomial.C (a p1) + S else w p
  have hv0 : v p0 = 0 := by simp [v, w, hp0]
  have hv1 : v p1 = MvPolynomial.C (a p1) + S := by simp [v, hp1]
  have hvev : ∀ (p : Fin (r + 2)) (h0 : p.val ≠ 0) (h2 : p.val % 2 = 0),
      v p = MvPolynomial.X ⟨p, h2, h0⟩ := by
    intro p h0 h2
    have h1 : p.val ≠ 1 := by omega
    simp only [v, w]
    rw [if_neg h1, dif_pos ⟨h2, h0⟩]
  have hvodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → v p = MvPolynomial.C (a p) := by
    intro p h1 h2
    simp only [v, w]
    rw [if_neg h1, dif_neg (fun h => h2 h.1), if_neg h2]
  have htail : ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * v i.succ * v b = S := by
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun b _ => ?_))
    by_cases h : (Fin.succ i).val % 2 = 0 ∧ b.val = (Fin.succ i).val + 1
    · have hs : (Fin.succ i).val = i.val + 1 := Fin.val_succ i
      have h1 : (Fin.succ i).val ≠ 1 := by omega
      have h3 : b.val ≠ 1 := by omega
      have e1 : v i.succ = w i.succ := by simp only [v]; rw [if_neg h1]
      have e2 : v b = w b := by simp only [v]; rw [if_neg h3]
      rw [e1, e2]
    · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul]
  let ψt : MvPolynomial (Fin (r + 2)) A →+*
      MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K := MvPolynomial.eval₂Hom g v
  have hψt : ∀ c ∈ wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r), ψt c = 0 := by
    intro c hc
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp hc
    rw [map_mul]
    convert mul_zero (ψt d)
    simp only [ψt, map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
    rw [Lc0 g v, hv0, zero_mul]
    simp [g, hτπ]
  let ι : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+*
      MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K :=
    Ideal.Quotient.lift (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) ψt hψt
  have hιy : ∀ p, ι (y p) = v p := by
    intro p
    show Ideal.Quotient.lift _ ψt hψt (Ideal.Quotient.mk _ _) = _
    rw [Ideal.Quotient.lift_mk]
    exact MvPolynomial.eval₂Hom_X' g v p
  have hιalg : ∀ c, ι (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) c) = g c := by
    intro c
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
    show Ideal.Quotient.lift _ ψt hψt (Ideal.Quotient.mk _ _) = _
    rw [Ideal.Quotient.lift_mk]
    exact MvPolynomial.eval₂Hom_C g v c
  have hιφ : ι.comp φ = MvPolynomial.C.comp τ.hom := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c
      have e : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r)) (MvPolynomial.C c) =
          algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) c := by
        rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      simp only [RingHom.comp_apply]
      rw [e, ← RingHom.comp_apply φ, hφA, hιalg]
      rfl
    · intro q
      simp only [RingHom.comp_apply]
      change ι (φ (x q)) = MvPolynomial.C (τ.hom (x q))
      obtain ⟨p, rfl⟩ : ∃ p, ε p = q := ⟨ε q, hinv q⟩
      change ι (φ (x (ε p))) = MvPolynomial.C (a p)
      by_cases h0 : p.val = 0
      · have : p = p0 := Fin.ext h0
        rw [this, hφ0, hιy, hv0, ha_ev p0 (by simp [hp0]), map_zero]
      by_cases h1 : p.val = 1
      · have : p = p1 := Fin.ext h1
        rw [this, hφ1]
        simp only [map_sub, map_add, map_mul, map_sum, hιalg, hιy]
        rw [Lch g v, htail, hv0, hv1]
        ring
      by_cases h2 : p.val % 2 = 0
      · rw [hφev p h0 h2, map_mul, hιy, hv0, zero_mul, ha_ev p h2, map_zero]
      · rw [hφodd p h1 h2, hιy, hvodd p h1 h2]
  have hιφ' : ∀ t, ι (φ t) = MvPolynomial.C (τ.hom t) := fun t => RingHom.congr_fun hιφ t



  have hcomm : τ ≫ CommRingCat.ofHom
      (MvPolynomial.C : K →+* MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K) =
      CommRingCat.ofHom φ ≫ CommRingCat.ofHom ι := by
    apply CommRingCat.hom_ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact hιφ.symm
  have hpo : IsPushout τ (CommRingCat.ofHom φ) (CommRingCat.ofHom
      (MvPolynomial.C : K →+* MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K))
      (CommRingCat.ofHom ι) := by
    refine IsPushout.mk (CommSq.mk hcomm) ⟨Limits.PushoutCocone.IsColimit.mk hcomm
      (fun s => CommRingCat.ofHom (MvPolynomial.eval₂Hom s.inl.hom
        (fun z => s.inr.hom (y z.val)))) ?_ ?_ ?_⟩
    · intro s
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      exact MvPolynomial.eval₂Hom_comp_C _ _
    · intro s
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      apply hext
      · apply RingHom.ext
        intro t
        simp only [RingHom.comp_apply]
        rw [hιφ', MvPolynomial.eval₂Hom_C]
        have h2 := congrArg (fun f => CommRingCat.Hom.hom f t) s.condition
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
        exact h2
      · intro z
        rw [RingHom.comp_apply, hιy, hvev z.val z.2.2 z.2.1, MvPolynomial.eval₂Hom_X']
    · intro s m h1 h2
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [MvPolynomial.eval₂Hom_C]
        have h3 := congrArg (fun f => CommRingCat.Hom.hom f c) h1
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h3
        exact h3
      · intro z
        rw [MvPolynomial.eval₂Hom_X']
        have h3 := congrArg (fun f => CommRingCat.Hom.hom f (y z.val)) h2
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h3
        show m.hom (MvPolynomial.X z) = s.inr.hom (y z.val)
        rw [← h3, hιy, hvev z.val z.2.2 z.2.1]



  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hsnd : hpb.isoPullback.hom ≫
      Limits.pullback.snd (Spec.map τ) (Spec.map (CommRingCat.ofHom φ)) =
      Spec.map (CommRingCat.ofHom ι) := hpb.isoPullback_hom_snd
  refine ⟨?_, ?_⟩
  · let H := Scheme.homeoOfIso hpb.isoPullback
    haveI : IrreducibleSpace
        ↥(Limits.pullback (Spec.map τ) (Spec.map (CommRingCat.ofHom φ))) :=
      Function.Surjective.irreducibleSpace H.continuous H.surjective
    exact (IrreducibleSpace.connectedSpace _).toPreconnectedSpace
  · let ev : MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K →+* K :=
      MvPolynomial.eval (fun _ => (1 : K))
    let yP : ↥(Spec (CommRingCat.of
        (MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K))) :=
      (⟨RingHom.ker ev, RingHom.ker_isPrime ev⟩ :
        PrimeSpectrum (MvPolynomial {q : Fin (r + 2) // q.val % 2 = 0 ∧ q.val ≠ 0} K))
    refine ⟨hpb.isoPullback.hom yP, ?_⟩
    intro q hq0 hq1 hmem
    have e1 : Limits.pullback.snd (Spec.map τ) (Spec.map (CommRingCat.ofHom φ))
        (hpb.isoPullback.hom yP) = Spec.map (CommRingCat.ofHom ι) yP := by
      rw [← Scheme.Hom.comp_apply, hsnd]
    rw [e1, Spec.map_apply, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap,
      CommRingCat.hom_ofHom] at hmem
    change ι (y q) ∈ RingHom.ker ev at hmem
    rw [RingHom.mem_ker, hιy, hvev q hq1 hq0] at hmem
    simp [ev] at hmem

theorem wc_srdcbu_cover_connected : ∀ {S X' T : Scheme.{u}} (β : X' ⟶ S) {ι : Type} (C : ι → Scheme.{u}) (e : ∀ k, C k ⟶ X'), (∀ x : X', ∃ k, ∃ y, e k y = x) → ∀ (ψ : ∀ k, C k ⟶ S), (∀ k, e k ≫ β = ψ k) → ∀ (t : T ⟶ S), (∀ k, PreconnectedSpace ↥(Limits.pullback t (ψ k))) → ∀ (k₀ : ι) (p₀ : ↥(Limits.pullback t (ψ k₀))), (∀ k, e k₀ (Limits.pullback.snd t (ψ k₀) p₀) ∈ Set.range (e k)) → ConnectedSpace ↥(Limits.pullback t β) :=
by
  intro S X' T β ι C e hcov ψ hψ t hP k₀ p₀ hcommon

  have s2 : ∀ {Cc : Scheme.{u}} (ee : Cc ⟶ X') (ψψ : Cc ⟶ S), ee ≫ β = ψψ →
      ∀ (m : Limits.pullback t ψψ ⟶ Limits.pullback t β),
      m ≫ Limits.pullback.fst t β = Limits.pullback.fst t ψψ →
      m ≫ Limits.pullback.snd t β = Limits.pullback.snd t ψψ ≫ ee →
      ∀ q : ↥(Limits.pullback t β), Limits.pullback.snd t β q ∈ Set.range ee →
        q ∈ Set.range m := by
    intro Cc ee ψψ hee m hm1 hm2 q hq
    obtain ⟨y, hy⟩ := hq
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd t β) (g := ee) q y hy.symm
    have hw : (Limits.pullback.fst (Limits.pullback.snd t β) ee ≫ Limits.pullback.fst t β) ≫ t =
        Limits.pullback.snd (Limits.pullback.snd t β) ee ≫ ψψ := by
      rw [Category.assoc, Limits.pullback.condition (f := t) (g := β), ← Category.assoc,
        Limits.pullback.condition (f := Limits.pullback.snd t β) (g := ee), Category.assoc, hee]
    let w : Limits.pullback (Limits.pullback.snd t β) ee ⟶ Limits.pullback t ψψ :=
      Limits.pullback.lift _ _ hw
    have hwm : w ≫ m = Limits.pullback.fst (Limits.pullback.snd t β) ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hm1]
        exact Limits.pullback.lift_fst _ _ _
      · rw [Category.assoc, hm2, ← Category.assoc, Limits.pullback.lift_snd]
        exact (Limits.pullback.condition (f := Limits.pullback.snd t β) (g := ee)).symm
    refine ⟨w z, ?_⟩
    have h1 := Scheme.Hom.comp_apply w m z
    rw [hwm] at h1
    rw [← h1]
    exact hz1

  let m : ∀ k, Limits.pullback t (ψ k) ⟶ Limits.pullback t β := fun k =>
    Limits.pullback.lift (Limits.pullback.fst t (ψ k)) (Limits.pullback.snd t (ψ k) ≫ e k)
      (by rw [Limits.pullback.condition, Category.assoc, hψ k])
  have hm1 : ∀ k, m k ≫ Limits.pullback.fst t β = Limits.pullback.fst t (ψ k) :=
    fun k => Limits.pullback.lift_fst _ _ _
  have hm2 : ∀ k, m k ≫ Limits.pullback.snd t β = Limits.pullback.snd t (ψ k) ≫ e k :=
    fun k => Limits.pullback.lift_snd _ _ _
  have hrange : ∀ k (q : ↥(Limits.pullback t β)),
      Limits.pullback.snd t β q ∈ Set.range (e k) → q ∈ Set.range (m k) :=
    fun k => s2 (e k) (ψ k) (hψ k) (m k) (hm1 k) (hm2 k)

  have hcov' : (⋃ k, Set.range (m k)) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro q
    obtain ⟨k, y, hy⟩ := hcov (Limits.pullback.snd t β q)
    exact Set.mem_iUnion.mpr ⟨k, hrange k q ⟨y, hy⟩⟩

  have hq₀ : Limits.pullback.snd t β (m k₀ p₀) = e k₀ (Limits.pullback.snd t (ψ k₀) p₀) := by
    have h1 := Scheme.Hom.comp_apply (m k₀) (Limits.pullback.snd t β) p₀
    rw [hm2, Scheme.Hom.comp_apply] at h1
    exact h1.symm
  have hinter : (⋂ k, Set.range (m k)).Nonempty := by
    refine ⟨m k₀ p₀, Set.mem_iInter.mpr fun k => hrange k _ ?_⟩
    rw [hq₀]
    exact hcommon k

  have hpre : _root_.IsPreconnected (⋃ k, Set.range (m k)) :=
    isPreconnected_iUnion hinter (fun k => by
      haveI := hP k
      exact isPreconnected_range (m k).continuous)
  rw [hcov'] at hpre
  rw [connectedSpace_iff_univ]
  exact ⟨⟨m k₀ p₀, trivial⟩, hpre⟩

theorem wc_srdcbu_offcentre_fibre : ∀ (R : CommRingCat.{u}) {ι : Type} (b : ι → R) (X' : Scheme.{u}) (β : X' ⟶ Spec R), wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k => (Scheme.ΓSpecIso R).inv.hom (b k)))) β → ∀ (K : Type u) [Field K] (t : Spec (.of K) ⟶ Spec R), (∃ k, b k ∉ (t (IsLocalRing.closedPoint K)).asIdeal) → ConnectedSpace ↥(Limits.pullback t β) :=
by
  classical


  have isoOff : ∀ (X X' : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (W : X.Opens),
      wcCsdIsBlowup I r → (I.support : Set X) ∩ (W : Set X) = ∅ → IsIso (r ∣_ W) := by
    intro X X' I r W hb hW
    obtain ⟨-, hUniq⟩ := hb
    have H : ∀ (T : Scheme.{u}) (h : T ⟶ X), (∀ t : T, h t ∉ (I.support : Set X)) →
        wcCsdInvPull I h := by
      intro T h hh t
      obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := h t) trivial
      have hns : h t ∉ X.zeroLocus (U := U₀) (I.ideal ⟨U₀, hU₀⟩ : Set Γ(X, U₀)) := by
        rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
        exact hh t
      rw [Scheme.mem_zeroLocus_iff] at hns
      push_neg at hns
      obtain ⟨a, haI, hxa⟩ := hns
      have htD : t ∈ h ⁻¹ᵁ X.basicOpen a := (Scheme.Hom.mem_preimage h).mpr hxa
      obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
      have hVD : V₀ ≤ h ⁻¹ᵁ X.basicOpen a := hV₀sub
      have hVU : V₀ ≤ h ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono h (X.basicOpen_le a))
      refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV₀, haI, ?_⟩
      have hbo : T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) = V₀ := by
        rw [Scheme.basicOpen_appLE]
        exact inf_eq_left.mpr hVD
      have hunit : IsUnit ((h.appLE U₀ V₀ hVU).hom a) := by
        apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace V₀
        intro y hy
        have hy' : y ∈ T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) := by rw [hbo]; exact hy
        exact (T.mem_basicOpen _ y hy).mp hy'
      refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
      rw [Ideal.span_singleton_eq_top.mpr hunit]
      exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ haI) hunit
    have memι : ∀ (V : X'.Opens) (z : V.toScheme), V.ι z ∈ V := by
      intro V z
      have hz : V.ι z ∈ Set.range V.ι := ⟨z, rfl⟩
      rwa [Scheme.Opens.range_ι] at hz
    have memW : ∀ y : W.toScheme, W.ι y ∈ W := by
      intro y
      have hy : W.ι y ∈ Set.range W.ι := ⟨y, rfl⟩
      rwa [Scheme.Opens.range_ι] at hy
    have hWav : ∀ y : W.toScheme, W.ι y ∉ (I.support : Set X) := by
      intro y hy
      have hmem : W.ι y ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hy, memW y⟩
      rw [hW] at hmem
      exact hmem
    obtain ⟨s, hs, -⟩ := hUniq W.toScheme W.ι (H _ _ hWav)
    have hrange : Set.range s ⊆ Set.range (r ⁻¹ᵁ W).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      show s y ∈ r ⁻¹ᵁ W
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hs]
      exact memW y
    haveI : Mono W.ι := IsOpenImmersion.mono W.ι
    haveI : Mono (r ⁻¹ᵁ W).ι := IsOpenImmersion.mono (r ⁻¹ᵁ W).ι
    let s' := IsOpenImmersion.lift (r ⁻¹ᵁ W).ι s hrange
    have hs' : s' ≫ (r ⁻¹ᵁ W).ι = s := IsOpenImmersion.lift_fac _ _ _
    have h4 : s' ≫ (r ∣_ W) = 𝟙 _ := by
      rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hs', hs,
        Category.id_comp]
    have hιav : ∀ z : (r ⁻¹ᵁ W).toScheme, ((r ⁻¹ᵁ W).ι ≫ r) z ∉ (I.support : Set X) := by
      intro z hz
      have hz1 : (r ⁻¹ᵁ W).ι z ∈ r ⁻¹ᵁ W := memι (r ⁻¹ᵁ W) z
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply] at hz1
      have hmem : ((r ⁻¹ᵁ W).ι ≫ r) z ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hz, hz1⟩
      rw [hW] at hmem
      exact hmem
    have hh := H _ _ hιav
    have h5 : (r ∣_ W) ≫ s' = 𝟙 _ := by
      rw [← cancel_mono (r ⁻¹ᵁ W).ι, Category.id_comp]
      apply (hUniq _ _ hh).unique
      · simp only [Category.assoc]
        rw [reassoc_of% hs', hs, morphismRestrict_ι]
      · rfl
    exact IsIso.mk ⟨s', h5, h4⟩
  intro R ι b X' β hbl K _ t hk
  set I := Scheme.IdealSheafData.ofIdealTop
    (Ideal.span (Set.range fun k => (Scheme.ΓSpecIso R).inv.hom (b k))) with hI

  let W : (Spec R).Opens := ⟨(↑I.support)ᶜ, I.support.isClosed.isOpen_compl⟩
  have hdisj : (I.support : Set (Spec R)) ∩ (W : Set (Spec R)) = ∅ := Set.inter_compl_self _

  haveI hiso : IsIso (β ∣_ W) := isoOff (Spec R) X' I β W hbl hdisj

  have hrange : Set.range t ⊆ Set.range W.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    have hx : x = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    subst hx
    show t (IsLocalRing.closedPoint K) ∉ (I.support : Set (Spec R))
    intro hy
    rw [hI, Scheme.IdealSheafData.coe_support_ofIdealTop, Scheme.mem_zeroLocus_iff] at hy
    obtain ⟨k, hbk⟩ := hk
    have h3 := hy _ (Ideal.subset_span ⟨k, rfl⟩)
    rw [basicOpen_eq_of_affine] at h3
    exact h3 ((PrimeSpectrum.mem_basicOpen _ _).mpr hbk)

  let t' := IsOpenImmersion.lift W.ι t hrange
  have hfac : t' ≫ W.ι = t := IsOpenImmersion.lift_fac W.ι t hrange

  have hP : IsPullback (Limits.pullback.fst t' (β ∣_ W))
      (Limits.pullback.snd t' (β ∣_ W) ≫ (β ⁻¹ᵁ W).ι) (t' ≫ W.ι) β :=
    ((IsPullback.of_hasPullback t' (β ∣_ W)).flip.paste_horiz
      (isPullback_morphismRestrict β W).flip).flip
  rw [hfac] at hP

  haveI : IsIso (Limits.pullback.fst t' (β ∣_ W)) :=
    Limits.pullback_fst_iso_of_right_iso t' (β ∣_ W)
  let E : Spec (.of K) ≅ Limits.pullback t β :=
    (asIso (Limits.pullback.fst t' (β ∣_ W))).symm ≪≫ hP.isoPullback
  exact (Scheme.homeoOfIso E).surjective.connectedSpace (Scheme.homeoOfIso E).continuous

theorem wc_srdcb_unit_iso (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β)
    (hprop : IsProper β) (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (βs : Limits.pullback f' (wcQmSp A) ⟶ Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A))
    (hβs1 : βs ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) =
      Limits.pullback.fst f' (wcQmSp A) ≫ β)
    (hβs2 : βs ≫ Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A) =
      Limits.pullback.snd f' (wcQmSp A))
    (Dβ : wcEtPullData βs (ℓ ^ k)) :
    IsIso (wcEtSuppUnitMap Dβ) :=
by
  classical

  obtain ⟨r, rfl⟩ : ∃ r, n = r + 2 := ⟨n - 2, by omega⟩
  subst hc

  have hsq : IsPullback βs (Limits.pullback.fst f' (wcQmSp A))
      (Limits.pullback.fst (wcQuadModelStr A (r + 2) π (wcSrmCh A r)) (wcQmSp A)) β := by
    refine IsPullback.of_right
      (h₁₂ := Limits.pullback.snd (wcQuadModelStr A (r + 2) π (wcSrmCh A r)) (wcQmSp A))
      (h₂₂ := wcQuadModelStr A (r + 2) π (wcSrmCh A r)) (v₁₃ := wcQmSp A) ?_ hβs1
      (IsPullback.of_hasPullback _ _).flip
    rw [hβs2, hf']
    exact (IsPullback.of_hasPullback f' (wcQmSp A)).flip

  haveI : IsProper βs := MorphismProperty.of_isPullback (P := @IsProper) hsq.flip hprop

  have hpt : ∀ (K : Type u) [Field K]
      (τ : CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ⟶ CommRingCat.of K)
      (x : wcQuadModelRing A (r + 2) π (wcSrmCh A r)),
      x ∈ ((Spec.map τ) (IsLocalRing.closedPoint K)).asIdeal → τ.hom x = 0 := by
    intro K _ τ x hx
    have h2 : τ.hom x ∈ IsLocalRing.maximalIdeal K := hx
    rwa [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot] at h2

  have hG : ∀ (K : Type u) [Field K]
      (t : Spec (.of K) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))),
      ConnectedSpace ↥(Limits.pullback t β) := by
    intro K _ t
    by_cases hoff : ∃ i, wcSrmGen A r π i ∉ (t (IsLocalRing.closedPoint K)).asIdeal
    · exact wc_srdcbu_offcentre_fibre (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))
        (wcSrmGen A r π) X' β hbl K t hoff
    · push_neg at hoff
      obtain ⟨τ, rfl⟩ : ∃ τ, Spec.map τ = t := ⟨_, Spec.map_preimage t⟩
      have hτ : ∀ q : Fin (r + 2), q.val % 2 = 0 →
          τ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
            (MvPolynomial.X q)) = 0 := by
        intro q hq
        have hgen : wcSrmGen A r π q = Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
            (MvPolynomial.X q) := by
          unfold wcSrmGen
          congr 2
          apply Fin.ext
          show 2 * (q.val / 2) = q.val
          omega
        have h1 := hoff q
        rw [hgen] at h1
        exact hpt K τ _ h1
      obtain ⟨φ0, σ, ε, e, hφA, hφX, hσA, hεinv, hεpar, hσX, he_open, he_comp, he_cov, hover⟩ :=
        wc_srdcbu_charts A r hn π hπ X' β hbl
      have hP := fun k : Fin (r + 2) =>
        wc_srdcbu_chart_fibre A r π K
          (φ0.comp (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
            wcQuadModelRing A (r + 2) π (wcSrmCh A r))) (ε k)
          (by rw [RingHom.comp_assoc, hσA k, hφA]) (hεinv k) (hεpar k)
          (fun q => by
            show φ0 ((σ k) _) = _
            rw [hσX k q, hφX]) τ hτ
      refine wc_srdcbu_cover_connected β
        (fun _ => Spec (.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))) e he_cov
        (fun k => Spec.map (CommRingCat.ofHom (φ0.comp (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
            wcQuadModelRing A (r + 2) π (wcSrmCh A r))))) he_comp (Spec.map τ)
        (fun k => (hP k).1) ⟨0, by omega⟩ (hP ⟨0, by omega⟩).2.choose (fun k => ?_)
      apply hover k
      by_cases hk : k.val / 2 = 0
      · exact Or.inl hk
      · refine Or.inr ((hP ⟨0, by omega⟩).2.choose_spec
          ⟨2 * (k.val / 2), lt_of_le_of_lt (Nat.mul_div_le k.val 2) k.isLt⟩ ?_ ?_)
        · show 2 * (k.val / 2) % 2 = 0
          omega
        · show 2 * (k.val / 2) ≠ 0
          omega

  have hG' : ∀ (K : Type u) [Field K]
      (t : Spec (.of K) ⟶ Limits.pullback (wcQuadModelStr A (r + 2) π (wcSrmCh A r)) (wcQmSp A)),
      ConnectedSpace ↥(Limits.pullback t βs) := by
    intro K _ t
    haveI := hG K (t ≫ Limits.pullback.fst (wcQuadModelStr A (r + 2) π (wcSrmCh A r)) (wcQmSp A))
    let I := ((IsPullback.of_hasPullback t βs).flip.paste_horiz hsq.flip).flip.isoPullback
    exact (Scheme.homeoOfIso I.symm).surjective.connectedSpace (Scheme.homeoOfIso I.symm).continuous

  exact wc_srdcbu_unit_iso_of_lc_bij βs (ℓ ^ k) Dβ
    (fun V => wc_srdcbu_lc_comap_bij βs hG' V.hom (ZMod (ℓ ^ k)))

theorem wc_etqm_srdmv_supp_range_iso {X Z₁ Z₂ : Scheme.{u}} (i₁ : Z₁ ⟶ X) [IsClosedImmersion i₁]
    (i₂ : Z₂ ⟶ X) [IsClosedImmersion i₂] (h : Set.range i₁ = Set.range i₂) (m : ℕ)
    (D₁ : wcEtPullData i₁ m) (D₂ : wcEtPullData i₂ m) :
    Nonempty (wcEtSuppObj D₁ ≅ wcEtSuppObj D₂) :=
by
  suffices dict : ∀ {X' Y' : Scheme.{u}} {n : ℕ} (i' : X' ⟶ Y') [IsClosedImmersion i'] (D' : wcEtPullData i' n) (N : SheafOfModules.{u+1} (wcEtZModRing Y' n)), (∀ ψ₁ ψ₂ : wcEtSuppObj D' ⟶ N, (∀ U : Y'.Etale, ((wcEtSuppUnitMap D' ≫ ψ₁).val.app (Opposite.op U)).hom (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U)) = ((wcEtSuppUnitMap D' ≫ ψ₂).val.app (Opposite.op U)).hom (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U))) → ψ₁ = ψ₂) ∧ (∀ (ψ : wcEtSuppObj D' ⟶ N) (U : Y'.Etale), IsEmpty ((wcEtBaseChange i').obj U).left → ((wcEtSuppUnitMap D' ≫ ψ).val.app (Opposite.op U)).hom (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U)) = 0) ∧ (∀ v : ∀ U : Y'.Etale, N.val.obj (Opposite.op U), (∀ (U U' : Y'.Etale) (g : U' ⟶ U), v U' = (N.val.map g.op).hom (v U)) → (∀ U : Y'.Etale, IsEmpty ((wcEtBaseChange i').obj U).left → v U = 0) → ∃ ψ : wcEtSuppObj D' ⟶ N, ∀ U : Y'.Etale, ((wcEtSuppUnitMap D' ≫ ψ).val.app (Opposite.op U)).hom (1 : (wcEtZModRing Y' n).obj.obj (Opposite.op U)) = v U) by

    have hE : ∀ {Za Zb : Scheme.{u}} (ia : Za ⟶ X) (ib : Zb ⟶ X), Set.range ia = Set.range ib →
        ∀ U : X.Etale, IsEmpty ((wcEtBaseChange ia).obj U).left →
          IsEmpty ((wcEtBaseChange ib).obj U).left := by
      intro Za Zb ia ib hab U hU
      change IsEmpty ↥(Limits.pullback U.hom ia) at hU
      change IsEmpty ↥(Limits.pullback U.hom ib)
      refine ⟨fun z => ?_⟩
      have hz := Set.mem_range_self (f := ⇑(Limits.pullback.fst U.hom ib)) z
      rw [Scheme.Pullback.range_fst, ← hab, ← Scheme.Pullback.range_fst] at hz
      obtain ⟨w, -⟩ := hz
      exact hU.false w

    have hcompat : ∀ {Za : Scheme.{u}} {ia : Za ⟶ X} (Da : wcEtPullData ia m) (U U' : X.Etale)
        (g : U' ⟶ U),
        ((wcEtSuppUnitMap Da).val.app (Opposite.op U')).hom
            (1 : (wcEtZModRing X m).obj.obj (Opposite.op U')) =
          ((wcEtSuppObj Da).val.map g.op).hom (((wcEtSuppUnitMap Da).val.app (Opposite.op U)).hom
            (1 : (wcEtZModRing X m).obj.obj (Opposite.op U))) := by
      intro Za ia Da U U' g
      have hn := PresheafOfModules.naturality_apply (wcEtSuppUnitMap Da).val g.op
        (1 : (wcEtZModRing X m).obj.obj (Opposite.op U))
      have h1' : ((wcEtZModRing X m).obj.map g.op).hom
          (1 : (wcEtZModRing X m).obj.obj (Opposite.op U)) = 1 := map_one _
      exact (congrArg (fun x => ((wcEtSuppUnitMap Da).val.app (Opposite.op U')).hom x)
        h1'.symm).trans hn

    have van : ∀ {Za : Scheme.{u}} {ia : Za ⟶ X} [IsClosedImmersion ia] (Da : wcEtPullData ia m)
        (U : X.Etale), IsEmpty ((wcEtBaseChange ia).obj U).left →
        ((wcEtSuppUnitMap Da).val.app (Opposite.op U)).hom
          (1 : (wcEtZModRing X m).obj.obj (Opposite.op U)) = 0 := by
      intro Za ia _ Da U hU
      have h0 := (dict ia Da (wcEtSuppObj Da)).2.1 (𝟙 _) U hU
      rw [Category.comp_id] at h0
      exact h0
    obtain ⟨C1₁, -, -⟩ := dict i₁ D₁ (wcEtSuppObj D₁)
    obtain ⟨C1₂, -, -⟩ := dict i₂ D₂ (wcEtSuppObj D₂)
    obtain ⟨-, -, C3₁⟩ := dict i₁ D₁ (wcEtSuppObj D₂)
    obtain ⟨-, -, C3₂⟩ := dict i₂ D₂ (wcEtSuppObj D₁)
    obtain ⟨ψ₁₂, h₁₂⟩ := C3₁ (fun U => ((wcEtSuppUnitMap D₂).val.app (Opposite.op U)).hom
        (1 : (wcEtZModRing X m).obj.obj (Opposite.op U)))
