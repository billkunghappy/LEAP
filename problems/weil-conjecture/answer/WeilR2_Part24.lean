    rw [← hx₂, hvan (n - 1) (by omega) x₂, Abelian.Ext.comp_zero]
  let τm : ShortComplex.mk (wcFreeSheafMap D.Yt.left j)
      (Limits.cokernel.π (wcFreeSheafMap D.Yt.left j)) (Limits.cokernel.condition _) ⟶
