by
  intro Ω _ _ W hW hWt X uX ι hM x τ hτ w hw hSm σ σ' b hP hP' hb X₁ r₁ ι₁ hbl₁ hι₁ hM₁ σ₁ hσ₁

  have hIeq : σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b =
