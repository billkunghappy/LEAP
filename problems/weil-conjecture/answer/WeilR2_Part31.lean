  intro K' L _ _ _ _ R hfree hrank r Vs hVsR hVsall happ hpos i₀ z hz0 k hcoef hk0 hkinv
  classical
  obtain ⟨O, hOdef⟩ : ∃ O, (Vs i₀).comap (algebraMap K' L) = O := ⟨_, rfl⟩
  have hO : O.toSubring = R := hOdef ▸ hVsR i₀
  subst hO
