theorem wcpa_dj_lr1u_mn_integral : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W), a ≠ 0 → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), Flat uX → IsOpenImmersion ι → (∀ x : X, x ∈ Set.range ⇑ι ↔ a ∉ (uX x).asIdeal) → AlgebraicGeometry.IsIntegral X :=
