      intro x
      exact congrArg (fun φ => φ.hom x) key
    have s3 : Ideal.map (wcLdnmTvRho h (p ξ) (lam (f ξ)) e) (RingHom.ker (lam.stalkMap (f ξ)).hom) ≤
        RingHom.ker (p.stalkMap ξ).hom := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, s2 x, RingHom.mem_ker.mp hx, map_zero]
    refine ⟨hπs, le_antisymm ?_ s3⟩
    set I := Ideal.map (wcLdnmTvRho h (p ξ) (lam (f ξ)) e)
      (RingHom.ker (lam.stalkMap (f ξ)).hom) with hIdef
    by_cases hI : I = ⊤
    · rw [hI]; exact le_top
    haveI : Nontrivial (Z.presheaf.stalk (p ξ) ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    haveI hQloc : IsLocalRing (Z.presheaf.stalk (p ξ) ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    let Q : CommRingCat.{u} := CommRingCat.of (Z.presheaf.stalk (p ξ) ⧸ I)
    haveI : IsLocalRing Q := hQloc
    let φ : Z.presheaf.stalk (p ξ) ⟶ Q := CommRingCat.ofHom (Ideal.Quotient.mk I)
    haveI : IsLocalHom φ.hom :=
      Function.Surjective.isLocalHom (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    have hK : RingHom.ker (lam.stalkMap (f ξ)).hom ≤
        RingHom.ker ((Ideal.Quotient.mk I).comp (wcLdnmTvRho h (p ξ) (lam (f ξ)) e)) := by
      intro x hx
      rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ hx
    let μ0 := ((lam.stalkMap (f ξ)).hom.liftOfSurjective hlams) ⟨_, hK⟩
    have hμ0 : μ0.comp (lam.stalkMap (f ξ)).hom =
        (Ideal.Quotient.mk I).comp (wcLdnmTvRho h (p ξ) (lam (f ξ)) e) :=
      RingHom.liftOfSurjective_comp _ hlams _
    let μ : L.presheaf.stalk (f ξ) ⟶ Q := CommRingCat.ofHom μ0
    have hcone : lam.stalkMap (f ξ) ≫ μ =
        Y.presheaf.stalkSpecializes (specializes_of_eq e) ≫ h.stalkMap (p ξ) ≫ φ := by
      ext x
      exact RingHom.congr_fun hμ0 x
    have hY1 : Y.fromSpecStalk (h (p ξ)) =
        Spec.map (Y.presheaf.stalkSpecializes (specializes_of_eq e)) ≫ Y.fromSpecStalk (lam (f ξ)) :=
      (Scheme.SpecMap_stalkSpecializes_fromSpecStalk (specializes_of_eq e)).symm
    have w : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) ≫ h = (Spec.map μ ≫ L.fromSpecStalk (f ξ)) ≫ lam := by
      have e1 := congrArg Spec.map hcone
      simp only [Spec.map_comp, Category.assoc] at e1
