    have hO : f₂.fromNormalization ⁻¹ᵁ (U.ι ''ᵁ W) ≤ (f₂.fromNormalization ⁻¹ᵁ U).ι.opensRange := by
      rw [Scheme.Opens.opensRange_ι]
      exact Scheme.Hom.preimage_mono _ (Scheme.Opens.ι_image_le U W)
    have h7 := L2 t (f₂.fromNormalization ⁻¹ᵁ U).ι f₂.toNormalization ht
      (f₂.fromNormalization ⁻¹ᵁ (U.ι ''ᵁ W)) hO (L1 f₂ (U.ι ''ᵁ W) hW').1
      (L1 f₂ (U.ι ''ᵁ W) hW').2
    have hOW : (f₂.fromNormalization ⁻¹ᵁ U).ι ⁻¹ᵁ f₂.fromNormalization ⁻¹ᵁ (U.ι ''ᵁ W) =
        (f₂.fromNormalization ∣_ U) ⁻¹ᵁ W := by
      rw [← Scheme.Hom.comp_preimage, ← morphismRestrict_ι, Scheme.Hom.comp_preimage,
        Scheme.Hom.preimage_image_eq]
    rw [hOW] at h7
    have hτ := (L1 f₂' W hW).1
    have hDW : D ⁻¹ᵁ (f₂.fromNormalization ∣_ U) ⁻¹ᵁ W = f₂'.fromNormalization ⁻¹ᵁ W := by
      rw [← Scheme.Hom.comp_preimage, hD]
    rw [← hDW] at hτ
    exact L4 f₂'.toNormalization D t (f₂.fromNormalization ∣_ U) htD W hW hτ h7.1 h7.2
  have hE : f₂'.toNormalization ≫ E = s := Scheme.Hom.toNormalization_normalizationDesc _ _ _ _
  have hE2 : E ≫ Limits.pullback.snd _ _ = f₂'.fromNormalization :=
    Scheme.Hom.normalizationDesc_comp _ _ _ _
  refine ⟨inv D ≫ E ≫ Limits.pullback.fst _ _, t, ht, ?_, ?_⟩
  · rw [← htD, Category.assoc, IsIso.hom_inv_id_assoc, ← Category.assoc, hE,
      Limits.pullback.lift_fst]
  · rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc E, hE2, ← hD,
      Category.assoc, IsIso.inv_hom_id_assoc]

theorem wcpa_dj_lr1k_ebnb_closed_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X₁ X₂ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (u₂ : X₂ ⟶ Spec (.of ↥W))
      (ι₁ : wcProjK Ω 1 ⟶ X₁) (ι₂ : wcProjK Ω 1 ⟶ X₂)
      [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)]
      [QuasiCompact (γ ≫ ι₂)] [QuasiSeparated (γ ≫ ι₂)],
    wcpaDjLkModel W u₁ ι₁ → wcpaDjLkModel W u₂ ι₂ →
    ∀ (U : X₂.Opens) (g : U.toScheme ⟶ X₁), g ≫ u₁ = U.ι ≫ u₂ →
    IsFinite (γ ≫ ι₁).fromNormalization → IsFinite (γ ≫ ι₂).fromNormalization →
    ∀ (Φ : ((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).toScheme ⟶ (γ ≫ ι₁).normalization),
      Φ ≫ (γ ≫ ι₁).fromNormalization = ((γ ≫ ι₂).fromNormalization ∣_ U) ≫ g →
    ∀ y₂ : ↥(wcpaDjLkFib W (γ ≫ ι₂) u₂), IsClosed ({y₂} : Set ↥(wcpaDjLkFib W (γ ≫ ι₂) u₂)) →
    ∀ w : ↥((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).toScheme,
      ((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι w = wcNdPt W (γ ≫ ι₂) u₂ y₂ →
    ∃ y₁ : ↥(wcpaDjLkFib W (γ ≫ ι₁) u₁),
      IsClosed ({y₁} : Set ↥(wcpaDjLkFib W (γ ≫ ι₁) u₁)) ∧ wcNdPt W (γ ≫ ι₁) u₁ y₁ = Φ w :=
by
  intro Ω _ _ W hW hWt C γ hcov X₁ X₂ u₁ u₂ ι₁ ι₂ _ _ _ _ hM₁ hM₂ U g hg hfin₁ hfin₂ Φ hΦ y₂ hcl
    w hw
  have key : ∀ {N₁ N₂ Y₁ Y₂ S K : Scheme.{u}} (ν₁ : N₁ ⟶ Y₁) (ν₂ : N₂ ⟶ Y₂) (v₁ : Y₁ ⟶ S)
      (v₂ : Y₂ ⟶ S) (s : K ⟶ S) [LocallyOfFiniteType (Limits.pullback.snd (ν₁ ≫ v₁) s)]
      [LocallyOfFiniteType (Limits.pullback.snd (ν₂ ≫ v₂) s)] [JacobsonSpace ↥K]
      (U : Y₂.Opens) (g : U.toScheme ⟶ Y₁), g ≫ v₁ = U.ι ≫ v₂ →
      ∀ Φ : (ν₂ ⁻¹ᵁ U).toScheme ⟶ N₁, Φ ≫ ν₁ = (ν₂ ∣_ U) ≫ g →
      ∀ y₂ : ↥(Limits.pullback (ν₂ ≫ v₂) s), IsClosed ({y₂} : Set ↥(Limits.pullback (ν₂ ≫ v₂) s)) →
      ∀ w : ↥(ν₂ ⁻¹ᵁ U).toScheme, (ν₂ ⁻¹ᵁ U).ι w = Limits.pullback.fst (ν₂ ≫ v₂) s y₂ →
      ∃ y₁ : ↥(Limits.pullback (ν₁ ≫ v₁) s),
        IsClosed ({y₁} : Set ↥(Limits.pullback (ν₁ ≫ v₁) s)) ∧
        Limits.pullback.fst (ν₁ ≫ v₁) s y₁ = Φ w := by
    intro N₁ N₂ Y₁ Y₂ S K ν₁ ν₂ v₁ v₂ s _ _ _ U g hg Φ hΦ y₂ hcl w hw
    haveI : JacobsonSpace ↥(Limits.pullback (ν₁ ≫ v₁) s) :=
      LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd (ν₁ ≫ v₁) s)
    have hyO : y₂ ∈ Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U) := by
      show Limits.pullback.fst (ν₂ ≫ v₂) s y₂ ∈ ν₂ ⁻¹ᵁ U
      rw [← hw]
      exact w.2
    obtain ⟨y₂', hιy⟩ : ∃ y₂' : ↥(Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).toScheme,
        (Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι y₂' = y₂ :=
      ⟨⟨y₂, hyO⟩, rfl⟩
    have hcl' : IsClosed
        ({y₂'} : Set ↥(Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).toScheme) := by
      have e : ({y₂'} : Set ↥(Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).toScheme) =
          (Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι ⁻¹' {y₂} := by
        ext z
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl; exact hιy
        · intro hz
          apply (Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι.isOpenEmbedding.injective
          rw [hz, hιy]
      rw [e]
      exact hcl.preimage (Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι.continuous
    have ha : (Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) ≫ (ν₂ ⁻¹ᵁ U).ι =
        (Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι ≫ Limits.pullback.fst (ν₂ ≫ v₂) s :=
      morphismRestrict_ι _ _
    have hν : (ν₂ ∣_ U) ≫ U.ι = (ν₂ ⁻¹ᵁ U).ι ≫ ν₂ := morphismRestrict_ι _ _
    have hsq : ((Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) ≫ Φ) ≫ ν₁ ≫ v₁ =
        ((Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι ≫
          Limits.pullback.snd (ν₂ ≫ v₂) s) ≫ s := by
      calc ((Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) ≫ Φ) ≫ ν₁ ≫ v₁
          = (Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) ≫ (Φ ≫ ν₁) ≫ v₁ := by
            simp only [Category.assoc]
        _ = (Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) ≫ (ν₂ ∣_ U) ≫ g ≫ v₁ := by
            rw [hΦ, Category.assoc]
        _ = (Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) ≫ ((ν₂ ∣_ U) ≫ U.ι) ≫ v₂ := by
            rw [hg, Category.assoc]
        _ = ((Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) ≫ (ν₂ ⁻¹ᵁ U).ι) ≫ ν₂ ≫ v₂ := by
            rw [hν]; simp only [Category.assoc]
        _ = (Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι ≫
              (Limits.pullback.fst (ν₂ ≫ v₂) s ≫ ν₂ ≫ v₂) := by
            rw [ha, Category.assoc]
        _ = _ := by rw [Limits.pullback.condition, Category.assoc]
    have hΨ₂ : Limits.pullback.lift _ _ hsq ≫ Limits.pullback.snd (ν₁ ≫ v₁) s =
        (Limits.pullback.fst (ν₂ ≫ v₂) s ⁻¹ᵁ (ν₂ ⁻¹ᵁ U)).ι ≫ Limits.pullback.snd (ν₂ ≫ v₂) s :=
      Limits.pullback.lift_snd _ _ _
    haveI : LocallyOfFiniteType
        (Limits.pullback.lift _ _ hsq ≫ Limits.pullback.snd (ν₁ ≫ v₁) s) := by
      rw [hΨ₂]; infer_instance
    haveI : LocallyOfFiniteType (Limits.pullback.lift _ _ hsq) :=
      locallyOfFiniteType_of_comp (Limits.pullback.lift _ _ hsq) (Limits.pullback.snd (ν₁ ≫ v₁) s)
    have hcp := (Limits.pullback.lift _ _ hsq).closePoints_subset_preimage_closedPoints hcl'
    refine ⟨Limits.pullback.lift _ _ hsq y₂', hcp, ?_⟩
    have hay : (Limits.pullback.fst (ν₂ ≫ v₂) s ∣_ (ν₂ ⁻¹ᵁ U)) y₂' = w := by
      apply (ν₂ ⁻¹ᵁ U).ι.isOpenEmbedding.injective
      rw [← Scheme.Hom.comp_apply, ha, Scheme.Hom.comp_apply, hιy, hw]
    rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply, hay]
  haveI : IsProper u₁ := hM₁.1.2.1
  haveI : IsProper u₂ := hM₂.1.2.1
  haveI := hfin₁
  haveI := hfin₂
  exact key (γ ≫ ι₁).fromNormalization (γ ≫ ι₂).fromNormalization u₁ u₂
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) U g hg Φ hΦ
    y₂ hcl w hw

theorem wcpa_dj_lr1k_ebnb_stalk_inj : ∀ {X Y : Scheme.{u}} [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral Y] (f : Y ⟶ X) [IsDominant f] (y : ↥Y), Function.Injective (f.stalkMap y).hom :=
by
  intro X Y _ _ f _ y
  haveI := irreducibleSpace_of_isIntegral X
  haveI := irreducibleSpace_of_isIntegral Y
  have hY : genericPoint Y ⤳ y := (genericPoint_spec Y).specializes (Set.mem_univ y)
  have h1 : f (genericPoint Y) ⤳ f y := hY.map f.continuous
  have h0 : genericPoint X ⤳ f (genericPoint Y) :=
    (genericPoint_spec X).specializes (Set.mem_univ _)
  have s2 : f (genericPoint Y) = genericPoint X := by
    have h := (genericPoint_spec Y).image f.continuous
    rw [Set.image_univ, f.denseRange.closure_range] at h
    exact h.eq (genericPoint_spec X)
  have s3aux : ∀ z : X, z = genericPoint X → IsField (X.presheaf.stalk z) := by
    rintro z rfl
    exact Field.toIsField X.functionField
  have s3 := s3aux _ s2
  have s4 : Function.Injective (f.stalkMap (genericPoint Y)).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    obtain ⟨b, hb⟩ := s3.mul_inv_cancel hne
    have h := congrArg (f.stalkMap (genericPoint Y)).hom hb
    rw [map_mul, ha, zero_mul, map_one] at h
    exact zero_ne_one h
  have s5 : Function.Injective (X.presheaf.stalkSpecializes h1).hom := by
    have hc := TopCat.Presheaf.stalkSpecializes_comp X.presheaf h0 h1
    have hinj : Function.Injective (X.presheaf.stalkSpecializes (h0.trans h1)).hom :=
      IsFractionRing.injective (X.presheaf.stalk (f y)) X.functionField
    rw [← hc, CommRingCat.hom_comp, RingHom.coe_comp] at hinj
    exact hinj.of_comp
  have s6 := Scheme.Hom.stalkSpecializes_stalkMap f _ _ hY
  have s7 : Function.Injective ((f.stalkMap y) ≫ Y.presheaf.stalkSpecializes hY).hom := by
    rw [← s6, CommRingCat.hom_comp, RingHom.coe_comp]
    exact s4.comp s5
  rw [CommRingCat.hom_comp, RingHom.coe_comp] at s7
  exact s7.of_comp

theorem wcpa_dj_lr1k_ebnb_dominant : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι → AlgebraicGeometry.IsIntegral C ∧ IsDominant (γ ≫ ι) :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι hM
  haveI hsm : SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) := hcov.2.1
  haveI hirr : IrreducibleSpace C := hcov.2.2.1
  obtain ⟨V, hVd, hVet⟩ := hcov.2.2.2.2
  haveI hflat : Flat uX := hM.1.1
  have hpb := hM.2.2

  have s1 : ∀ c : C, IsDomain (C.presheaf.stalk c) := fun c =>
    wcpa_smooth_stalk_isDomain Ω C (γ ≫ wcProjKStr Ω 1) 1 c
  haveI hstred : ∀ c : C, _root_.IsReduced (C.presheaf.stalk c) := fun c => by
    haveI := s1 c; infer_instance
  haveI : IsReduced C := isReduced_of_isReduced_stalk C
  haveI hCint : AlgebraicGeometry.IsIntegral C := isIntegral_of_irreducibleSpace_of_isReduced C
  refine ⟨hCint, ?_⟩

  obtain ⟨s₀⟩ : Nonempty (Spec (.of Ω)) := inferInstance
  have hη : ∀ y : Spec (.of ↥W),
      Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) s₀ ⤳ y := by
    intro y
    have h1 : (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) s₀ : PrimeSpectrum ↥W) =
        (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum ↥W) := by
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap ↥W Ω) s₀.asIdeal = ⊥
      rw [@Ideal.eq_bot_of_prime Ω _ s₀.asIdeal s₀.isPrime]
      exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective ↥W Ω)
    have h2 := (PrimeSpectrum.le_iff_specializes
      (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum ↥W) y).mp bot_le
    rw [← h1] at h2
    exact h2
  have s5 : ∀ x : X, ∃ p : wcProjK Ω 1, ι p ⤳ x := by
    intro x
    obtain ⟨x', hx'x, hux'⟩ := Flat.generalizingMap uX (hη (uX x))
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := uX) (g := Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x' s₀ hux'
    refine ⟨hpb.isoPullback.inv z, ?_⟩
    have : ι (hpb.isoPullback.inv z) = x' := by
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hz]
    rw [this]
    exact hx'x
  haveI : AlgebraicGeometry.IsIntegral (wcProjK Ω 1) := (wc_projK_integral_normal Ω 1).1
  have hξ : ∀ q : wcProjK Ω 1, _root_.genericPoint (wcProjK Ω 1) ⤳ q := fun q =>
    (genericPoint_spec (wcProjK Ω 1)).specializes (Set.mem_univ q)
  have s6 : ∃ c : C, γ c = _root_.genericPoint (wcProjK Ω 1) := by
    obtain ⟨v₀, hv₀⟩ := hVd.nonempty
    haveI := hVet
    obtain ⟨v', -, hv'⟩ := Flat.generalizingMap (V.ι ≫ γ)
      (hξ ((V.ι ≫ γ) (⟨v₀, hv₀⟩ : V.toScheme)))
    exact ⟨V.ι v', by rw [← Scheme.Hom.comp_apply]; exact hv'⟩
  obtain ⟨c, hc⟩ := s6
  refine IsDominant.mk ?_
  rw [denseRange_iff_closure_range]
  apply Set.eq_univ_of_forall
  intro x
  obtain ⟨p, hp⟩ := s5 x
  have h1 : (γ ≫ ι) c ⤳ x := by
    rw [Scheme.Hom.comp_apply, hc]
    exact ((hξ p).map ι.continuous).trans hp
  exact closure_mono (Set.singleton_subset_iff.mpr (Set.mem_range_self c)) h1.mem_closure

theorem wcpa_dj_lr1k_ebnb_primitive : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X₁ X₂ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (u₂ : X₂ ⟶ Spec (.of ↥W))
      (ι₁ : wcProjK Ω 1 ⟶ X₁) (ι₂ : wcProjK Ω 1 ⟶ X₂)
      [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)]
      [QuasiCompact (γ ≫ ι₂)] [QuasiSeparated (γ ≫ ι₂)],
    wcpaDjLkModel W u₁ ι₁ → wcpaDjLkModel W u₂ ι₂ →
    ∀ (U : X₂.Opens) (g : U.toScheme ⟶ X₁) (ι₂' : wcProjK Ω 1 ⟶ U.toScheme),
      g ≫ u₁ = U.ι ≫ u₂ → ι₂' ≫ U.ι = ι₂ → ι₂' ≫ g = ι₁ →
    ∀ (Φ : ((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).toScheme ⟶ (γ ≫ ι₁).normalization)
      (t : C ⟶ ((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).toScheme),
      t ≫ ((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι = (γ ≫ ι₂).toNormalization →
      t ≫ Φ = (γ ≫ ι₁).toNormalization →
      Φ ≫ (γ ≫ ι₁).fromNormalization = ((γ ≫ ι₂).fromNormalization ∣_ U) ≫ g →
    ∀ w : ↥((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).toScheme,
    ∃ θ : ↥((γ ≫ ι₁).normalization.presheaf.stalk (Φ w)),
      ∀ r : ↥((γ ≫ ι₂).normalization.presheaf.stalk (((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι w)),
      ∃ c c' : Polynomial ↥(U.toScheme.presheaf.stalk (((γ ≫ ι₂).fromNormalization ∣_ U) w)),
        c'.eval₂ (((γ ≫ ι₂).fromNormalization ∣_ U).stalkMap w ≫
            inv (((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι.stalkMap w)).hom
          ((Φ.stalkMap w ≫ inv (((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι.stalkMap w)).hom θ) ≠ 0 ∧
        r * c'.eval₂ (((γ ≫ ι₂).fromNormalization ∣_ U).stalkMap w ≫
            inv (((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι.stalkMap w)).hom
          ((Φ.stalkMap w ≫ inv (((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι.stalkMap w)).hom θ) =
        c.eval₂ (((γ ≫ ι₂).fromNormalization ∣_ U).stalkMap w ≫
            inv (((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι.stalkMap w)).hom
          ((Φ.stalkMap w ≫ inv (((γ ≫ ι₂).fromNormalization ⁻¹ᵁ U).ι.stalkMap w)).hom θ) :=
by
  intro Ω _ _ W hW hWt C γ hcov X₁ X₂ u₁ u₂ ι₁ ι₂ _ _ _ _ hM₁ hM₂ U g ι₂' hg hι₂' hgι Φ t ht₂
    htΦ hΦ w
  classical

  have halg : ∀ (A O R S K L : Type u) [CommRing A] [IsDomain A] [CommRing O] [CommRing R]
      [CommRing S] [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra K L]
      [FiniteDimensional K L] [Algebra.IsSeparable K L] (ψ : A →+* O) (ρ₁ : A →+* R)
      (ρ : O →+* S) (τ : R →+* S) (j : S →+* L), τ.comp ρ₁ = ρ.comp ψ → Function.Injective j →
      (algebraMap K L).comp (algebraMap A K) = j.comp (ρ.comp ψ) →
      (∀ x : L, (j.comp τ).IsIntegralElem x → ∃ r : R, j (τ r) = x) →
      ∃ θ : R, ∀ s : S, ∃ c c' : Polynomial O, c'.eval₂ ρ (τ θ) ≠ 0 ∧
        s * c'.eval₂ ρ (τ θ) = c.eval₂ ρ (τ θ) := by
    intro A O R S K L _ _ _ _ _ _ _ _ _ _ _ _ ψ ρ₁ ρ τ j hcomm hj hbase hint
    obtain ⟨θ₀, hθ₀⟩ := Field.exists_primitive_element K L
    letI : Algebra A L := ((algebraMap K L).comp (algebraMap A K)).toAlgebra
    haveI : IsScalarTower A K L := IsScalarTower.of_algebraMap_eq' rfl
    have hθ₀alg : IsAlgebraic A θ₀ :=
      (IsFractionRing.isAlgebraic_iff A K L).mpr (Algebra.IsAlgebraic.isAlgebraic θ₀)
    obtain ⟨y, hy0, hyint⟩ := hθ₀alg.exists_integral_multiple
    set x : L := y • θ₀ with hx
