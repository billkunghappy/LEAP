theorem wcpa_dj_lr1k_ebnt_dm_branch_bound : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (H G : Q) (c γ : ↥W), c ≠ 0 → γ ≠ 0 → H * G = σ c → (∀ (K : Type u) [Field K] (V : ValuationSubring K) (k : Q →+* V), IsLocalHom k → (∃ μ ∈ IsLocalRing.maximalIdeal ↥W, μ ≠ 0 ∧ k (σ μ) ∣ k (f (wcEbntX W b 0)) ∧ k (σ μ) ∣ k (f (wcEbntX W b 1))) → k (σ γ) ∣ k H) → ∃ s : Q, s ∉ Ideal.span {f (wcEbntX W b 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ∧ s * H ∈ Ideal.span {σ γ} :=
