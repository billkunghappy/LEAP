theorem wcpa_dj_lr1k_gn_node_completion : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [_root_.IsReduced R] (φ : K →+* R), (∀ a : R, ∃ c : K, a - φ c ∈ IsLocalRing.maximalIdeal R) → ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → Module.length R (↥(integralClosure R (FractionRing R)) ⧸ LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) = 1 → ENat.card (MaximalSpectrum ↥(integralClosure R (FractionRing R))) = 2 → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by

  have wcpa_dj_lr1k_gnnc_equalizer : ∀ (K R A : Type u) [Field K] [CommRing R] [CommRing A] [Algebra R A] (s₀ s₁ : A →+* K), Module.length R (A ⧸ LinearMap.range (Algebra.linearMap R A)) = 1 → (∀ r : R, s₀ (algebraMap R A r) = s₁ (algebraMap R A r)) → (∃ f : A, s₀ f ≠ s₁ f) → ∀ g : A, (∃ b : R, algebraMap R A b = g) ↔ s₀ g = s₁ g := by
    intro K R A _ _ _ _ s₀ s₁ hδ hc hf g
    constructor
    · rintro ⟨b, rfl⟩; exact hc b
    · intro hg
      by_contra hng
      haveI : IsSimpleModule R (A ⧸ LinearMap.range (Algebra.linearMap R A)) :=
        Module.length_eq_one_iff.mp hδ
      have hne : Submodule.mkQ (LinearMap.range (Algebra.linearMap R A)) g ≠ 0 := by
        intro h
        apply hng
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, LinearMap.mem_range] at h
        obtain ⟨b, hb⟩ := h
        exact ⟨b, hb⟩
      have htop := IsSimpleModule.span_singleton_eq_top R hne
      obtain ⟨f, hf⟩ := hf
      have hmem : Submodule.mkQ (LinearMap.range (Algebra.linearMap R A)) f ∈
          R ∙ Submodule.mkQ (LinearMap.range (Algebra.linearMap R A)) g := by
        rw [htop]; trivial
      obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hmem
      rw [← LinearMap.map_smul, Submodule.mkQ_apply, Submodule.mkQ_apply,
        Submodule.Quotient.eq, LinearMap.mem_range] at hr
      obtain ⟨r', hr'⟩ := hr
      rw [Algebra.linearMap_apply, Algebra.smul_def] at hr'
      have hfe : f = algebraMap R A r * g - algebraMap R A r' := by rw [hr']; ring
      apply hf
      rw [hfe, map_sub, map_sub, map_mul, map_mul, hg, hc r, hc r']

  have wcpa_dj_lr1k_gnnc_length_one_finite : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A], Module.length R (A ⧸ LinearMap.range (Algebra.linearMap R A)) = 1 → Module.Finite R A := by
    intro R A _ _ _ hδ
    haveI : IsSimpleModule R (A ⧸ LinearMap.range (Algebra.linearMap R A)) :=
      Module.length_eq_one_iff.mp hδ
    haveI : Nontrivial (A ⧸ LinearMap.range (Algebra.linearMap R A)) :=
      IsSimpleModule.nontrivial R _
    obtain ⟨x, hx⟩ := exists_ne (0 : A ⧸ LinearMap.range (Algebra.linearMap R A))
    obtain ⟨b, rfl⟩ := Submodule.mkQ_surjective _ x
    have htop := IsSimpleModule.span_singleton_eq_top R hx
    classical
    refine ⟨⟨({1, b} : Finset A), ?_⟩⟩
    rw [eq_top_iff]
    intro a _
    have hmem : Submodule.mkQ (LinearMap.range (Algebra.linearMap R A)) a ∈
        R ∙ Submodule.mkQ (LinearMap.range (Algebra.linearMap R A)) b := by
      rw [htop]; trivial
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hmem
    rw [← LinearMap.map_smul, Submodule.mkQ_apply, Submodule.mkQ_apply,
      Submodule.Quotient.eq, LinearMap.mem_range] at hr
    obtain ⟨r', hr'⟩ := hr
    rw [Algebra.linearMap_apply, Algebra.algebraMap_eq_smul_one] at hr'
    have ha : a = r • b - r' • 1 := by rw [hr']; abel
    rw [ha]
    refine Submodule.sub_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
      (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
    · simp
    · simp

  have wcpa_dj_lr1k_gnnc_field_length_zero : ∀ (R : Type u) [CommRing R], IsField R → Module.length R (↥(integralClosure R (FractionRing R)) ⧸ LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) = 0 := by
    intro R _ hF
    rw [Module.length_eq_zero_iff]
    letI := hF.toField
    have hsurj : Function.Surjective (algebraMap R (FractionRing R)) := by
      intro q
      obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors R) q
      have hs : (s : R) ≠ 0 := nonZeroDivisors.ne_zero s.2
      refine ⟨r * (s : R)⁻¹, ?_⟩
      rw [IsLocalization.eq_mk'_iff_mul_eq, ← map_mul, mul_assoc, inv_mul_cancel₀ hs, mul_one]
    constructor
    intro x y
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ x
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective _ y
    rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq, LinearMap.mem_range]
    obtain ⟨r, hr⟩ := hsurj ((x - y : ↥(integralClosure R (FractionRing R))) : FractionRing R)
    exact ⟨r, Subtype.ext hr⟩

  have wcpa_dj_lr1k_gnnc_loc_residue : ∀ (K A : Type u) [Field K] [CommRing A] (κA : K →+* A) (P : Ideal A) [P.IsMaximal], (∀ a : A, ∃ c : K, a - κA c ∈ P) → ∀ y : Localization.AtPrime P, ∃ c : K, y - ((algebraMap A (Localization.AtPrime P)).comp κA) c ∈ IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
    intro K A _ _ κA P _ hres y
    obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl y
    obtain ⟨ca, hca⟩ := hres a
    obtain ⟨ct, hct⟩ := hres t
    have hct0 : ct ≠ 0 := by
      intro h
      rw [h, map_zero, sub_zero] at hct
      exact t.2 hct
    refine ⟨ca / ct, ?_⟩
    have hkey : a - κA (ca / ct) * t ∈ P := by
      have : a - κA (ca / ct) * t = (a - κA ca) - κA (ca / ct) * (t - κA ct) := by
        rw [mul_sub, ← map_mul, div_mul_cancel₀ ca hct0]; ring
      rw [this]
      exact P.sub_mem hca (P.mul_mem_left _ hct)
    have he : IsLocalization.mk' (Localization.AtPrime P) a t -
        ((algebraMap A (Localization.AtPrime P)).comp κA) (ca / ct) =
