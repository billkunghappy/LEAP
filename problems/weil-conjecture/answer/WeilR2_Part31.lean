      fun j hj => ⟨(mul_dvd_mul_right hAA.dvd _).trans (hdomL j hj).1,
        (mul_dvd_mul_right hAA.dvd _).trans (hdomL j hj).2⟩
    have hdomR' : ∀ j ≤ max d₃ d₄,
        A * (if 0 ≤ e then l' ^ e.toNat else l ^ (-e).toNat) ∣ a₂ j * l' ^ j ∧
        A * (if 0 ≤ e then l' ^ e.toNat else l ^ (-e).toNat) ∣ a₂' j * l ^ (j + 1) :=
      fun j hj => ⟨(mul_dvd_mul_right hAA.dvd _).trans (hdomR j hj).1,
        (mul_dvd_mul_right hAA.dvd _).trans (hdomR j hj).2⟩
    exact wcpa_dj_lr1k_ebnt_dms_interior_bound Ω W Q σ b f hf l l' A π e N (max d₃ d₄) a₂ a₂' F
      hll' ⟨z, hl'⟩ hl0 hnN hAl hAl' hAπ hdomL' hdomR' hpF₂ K V k hlx hly
  ·
    obtain ⟨e₀, e₁, he₀, he₁, hkx₁, hky₁⟩ := hG3₁
    by_cases he : 0 ≤ e
    · simp only [if_pos he] at hkF₁ ⊢
      rw [show (1 : Fin 2) - 0 = 1 from rfl]
      have hn : e.toNat = e.natAbs := by omega
      rw [hn] at hkF₁
      have hU : IsUnit (ε₁ * e₁ ^ e.natAbs) := hε₁.mul (he₁.pow _)
      have heq : k₁ (F * f (wcEbntX W b 1) ^ e.natAbs) =
          (ε₁ * e₁ ^ e.natAbs) * k₁ (σ (A * b ^ e.natAbs)) := by
        rw [map_mul k₁ F, map_pow k₁, hkF₁, hky₁, ← hω6]
        simp only [map_mul, map_pow]
        ring
      rw [heq]
      exact (hU.mul_left_dvd).mpr dvd_rfl
    · simp only [if_neg he] at hkF₁ ⊢
      rw [show (1 : Fin 2) - 1 = 0 from rfl]
      have hn : (-e).toNat = e.natAbs := by omega
      rw [hn] at hkF₁
      have hU : IsUnit (ε₁ * e₀ ^ e.natAbs) := hε₁.mul (he₀.pow _)
      have heq : k₁ (F * f (wcEbntX W b 0) ^ e.natAbs) =
          (ε₁ * e₀ ^ e.natAbs) * k₁ (σ (A * b ^ e.natAbs)) := by
        rw [map_mul k₁ F, map_pow k₁, hkF₁, hkx₁, ← hω6]
        simp only [map_mul, map_pow]
        ring
      rw [heq]
      exact (hU.mul_left_dvd).mpr dvd_rfl

theorem wcpa_dj_lr1k_ebnt_dmne_node_colon : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (b γ : ↥W) (k : ℕ) (p : wcEbntN W b), wcEbntX W b 0 ^ k * p ∈ Ideal.span {(Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) (MvPolynomial.C γ) : wcEbntN W b)} → wcEbntX W b 1 ^ k * p ∈ Ideal.span {(Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) (MvPolynomial.C γ) : wcEbntN W b)} → p ∈ Ideal.span {(Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) (MvPolynomial.C γ) : wcEbntN W b)} :=
by
  intro Ω _ W b γ k p h₀ h₁
  classical

  have hcoeffCT : ∀ (a : ↥W) (n m : ℤ),
      (LaurentPolynomial.C a * LaurentPolynomial.T n).coeff m = if n = m then a else 0 := by
    intro a n m
    rw [← LaurentPolynomial.single_eq_C_mul_T, AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
  have hcoeffC : ∀ (a : ↥W) (g : LaurentPolynomial ↥W) (m : ℤ),
      (LaurentPolynomial.C a * g).coeff m = a * g.coeff m := by
    intro a g m
    rw [← LaurentPolynomial.smul_eq_C_mul]
    simp [AddMonoidAlgebra.coeff_smul]
  have hcoeffadd : ∀ (f g : LaurentPolynomial ↥W) (m : ℤ), (f + g).coeff m = f.coeff m + g.coeff m := by
    intro f g m
    rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply]

  have s3 : ∀ (j n : ℕ) (A : Polynomial ↥W),
      (LaurentPolynomial.T (j : ℤ) * A.eval₂ LaurentPolynomial.C (LaurentPolynomial.T 1)).coeff
        ((n : ℤ) + (j : ℤ)) = A.coeff n := by
    intro j n A
    induction A using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [Polynomial.eval₂_add, mul_add, hcoeffadd, hp, hq, Polynomial.coeff_add]
    | monomial i a =>
      rw [Polynomial.eval₂_monomial, LaurentPolynomial.T_pow, mul_left_comm,
        ← LaurentPolynomial.T_add, hcoeffCT, Polynomial.coeff_monomial]
      by_cases h : i = n
      · subst h; rw [if_pos (by push_cast; ring), if_pos rfl]
      · rw [if_neg (by push_cast; omega), if_neg h]

  have s4 : ∀ (c b' : ↥W) (j m : ℤ) (B : Polynomial ↥W), j < m →
      (LaurentPolynomial.C c * LaurentPolynomial.T j *
        B.eval₂ LaurentPolynomial.C (LaurentPolynomial.C b' * LaurentPolynomial.T (-1))).coeff m = 0 := by
    intro c b' j m B hjm
    induction B using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [Polynomial.eval₂_add, mul_add, hcoeffadd, hp, hq, add_zero]
    | monomial i a =>
      rw [Polynomial.eval₂_monomial, mul_pow, ← map_pow, LaurentPolynomial.T_pow]
      have e : LaurentPolynomial.C c * LaurentPolynomial.T j *
          (LaurentPolynomial.C a * (LaurentPolynomial.C (b' ^ i) * LaurentPolynomial.T ((i : ℤ) * -1)))
          = LaurentPolynomial.C (c * a * b' ^ i) * LaurentPolynomial.T (j + (i : ℤ) * -1) := by
        rw [map_mul, map_mul, LaurentPolynomial.T_add]; ring
      rw [e, hcoeffCT, if_neg (by omega)]

  have hR : wcEbntX W b 0 * wcEbntX W b 1 =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
        (MvPolynomial.C b) := by
    show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  obtain ⟨ι, hι⟩ : ∃ ι : ↥W →+* wcEbntN W b,
      ι = (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})).comp
        MvPolynomial.C := ⟨_, rfl⟩
  have hιw : ∀ w : ↥W, ι w = Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) (MvPolynomial.C w) := by
    intro w; rw [hι]; rfl
  have hR' : wcEbntX W b 0 * wcEbntX W b 1 = ι b := by rw [hR, hιw]
  have hdivX : ∀ (A : Polynomial ↥W) (z : wcEbntN W b),
      A.eval₂ ι z = A.divX.eval₂ ι z * z + ι (A.coeff 0) := by
    intro A z
    have := congrArg (Polynomial.eval₂ ι z) (Polynomial.divX_mul_X_add A)
    rw [Polynomial.eval₂_add, Polynomial.eval₂_mul_X, Polynomial.eval₂_C] at this
    exact this.symm
  have hmul : ∀ (A B : Polynomial ↥W) (z : wcEbntN W b),
      (A * B).eval₂ ι z = A.eval₂ ι z * B.eval₂ ι z := fun A B z =>
    Polynomial.eval₂_mul ι z

  have hdecomp : ∀ P : MvPolynomial (Fin 2) ↥W, ∃ A B : Polynomial ↥W,
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) P =
        A.eval₂ ι (wcEbntX W b 0) + wcEbntX W b 1 * B.eval₂ ι (wcEbntX W b 1) := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a =>
      refine ⟨Polynomial.C a, 0, ?_⟩
      rw [Polynomial.eval₂_C, Polynomial.eval₂_zero, mul_zero, add_zero, hιw]
    | add P Q hP hQ =>
      obtain ⟨A₁, B₁, h₁⟩ := hP
      obtain ⟨A₂, B₂, h₂⟩ := hQ
      refine ⟨A₁ + A₂, B₁ + B₂, ?_⟩
      rw [map_add, h₁, h₂, Polynomial.eval₂_add, Polynomial.eval₂_add]
      ring
    | mul_X P n hP =>
      obtain ⟨A, B, hAB⟩ := hP
      rw [map_mul, hAB]
      obtain rfl | rfl : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      · refine ⟨A * Polynomial.X + Polynomial.C (b * B.coeff 0), Polynomial.C b * B.divX, ?_⟩
        show (A.eval₂ ι (wcEbntX W b 0) + wcEbntX W b 1 * B.eval₂ ι (wcEbntX W b 1)) *
          wcEbntX W b 0 = _
        have hB := hdivX B (wcEbntX W b 1)
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul_X, Polynomial.eval₂_C, hmul,
          Polynomial.eval₂_C, map_mul]
        linear_combination B.eval₂ ι (wcEbntX W b 1) * hR' + ι b * hB
      · refine ⟨Polynomial.C b * A.divX, Polynomial.C (A.coeff 0) + Polynomial.X * B, ?_⟩
        show (A.eval₂ ι (wcEbntX W b 0) + wcEbntX W b 1 * B.eval₂ ι (wcEbntX W b 1)) *
          wcEbntX W b 1 = _
        have hA := hdivX A (wcEbntX W b 0)
        rw [hmul, Polynomial.eval₂_C, Polynomial.eval₂_add, Polynomial.eval₂_C,
          Polynomial.eval₂_X_mul]
        linear_combination wcEbntX W b 1 * hA + A.divX.eval₂ ι (wcEbntX W b 0) * hR'

  have hlift : ∀ (s t : LaurentPolynomial ↥W), s * t = LaurentPolynomial.C b →
      ∃ φ : wcEbntN W b →+* LaurentPolynomial ↥W, φ (wcEbntX W b 0) = s ∧
        φ (wcEbntX W b 1) = t ∧ φ.comp ι = LaurentPolynomial.C := by
    intro s t hst
    let e : MvPolynomial (Fin 2) ↥W →+* LaurentPolynomial ↥W :=
      MvPolynomial.eval₂Hom LaurentPolynomial.C ![s, t]
    have H : ∀ a ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b},
        e a = 0 := by
      intro a ha
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp only [e, map_mul, map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
      simp [hst]
    refine ⟨Ideal.Quotient.lift _ e H, ?_, ?_, ?_⟩
    · show Ideal.Quotient.lift _ e H (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = s
      rw [Ideal.Quotient.lift_mk]; simp [e]
    · show Ideal.Quotient.lift _ e H (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = t
      rw [Ideal.Quotient.lift_mk]; simp [e]
    · apply RingHom.ext
      intro w
      rw [RingHom.comp_apply, hιw, Ideal.Quotient.lift_mk]
      simp [e]

  obtain ⟨P, hP⟩ := Ideal.Quotient.mk_surjective p
  obtain ⟨A, B, hAB⟩ := hdecomp P
  have hp := hP.symm.trans hAB
  have hγ : (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
      (MvPolynomial.C γ) : wcEbntN W b) = ι γ := (hιw γ).symm
  rw [hγ] at h₀ h₁ ⊢

  have hAd : ∀ n, γ ∣ A.coeff n := by
    obtain ⟨ψ, hx, hy, hψι⟩ := hlift (LaurentPolynomial.T 1)
      (LaurentPolynomial.C b * LaurentPolynomial.T (-1))
      (by rw [mul_left_comm, ← LaurentPolynomial.T_add]; simp)
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp h₀
    have e := congrArg ψ hg
    rw [map_mul, map_mul, map_pow, hp, map_add, map_mul, Polynomial.hom_eval₂,
      Polynomial.hom_eval₂, hψι, hx, hy, ← RingHom.comp_apply ψ ι, hψι,
      LaurentPolynomial.T_pow] at e
    intro n
    have e2 := congrArg (fun f : LaurentPolynomial ↥W => f.coeff ((n : ℤ) + (k : ℤ))) e
    rw [mul_comm, hcoeffC, mul_add, hcoeffadd] at e2
    have r1 : (LaurentPolynomial.T ((k : ℤ) * 1) *
        A.eval₂ LaurentPolynomial.C (LaurentPolynomial.T 1)).coeff ((n : ℤ) + (k : ℤ)) =
        A.coeff n := by
      rw [mul_one]; exact s3 k n A
    have r2 : (LaurentPolynomial.T ((k : ℤ) * 1) *
        (LaurentPolynomial.C b * LaurentPolynomial.T (-1) *
          B.eval₂ LaurentPolynomial.C (LaurentPolynomial.C b * LaurentPolynomial.T (-1)))).coeff
          ((n : ℤ) + (k : ℤ)) = 0 := by
      have ee : LaurentPolynomial.T ((k : ℤ) * 1) *
          (LaurentPolynomial.C b * LaurentPolynomial.T (-1) *
            B.eval₂ LaurentPolynomial.C (LaurentPolynomial.C b * LaurentPolynomial.T (-1))) =
          LaurentPolynomial.C b * LaurentPolynomial.T ((k : ℤ) - 1) *
            B.eval₂ LaurentPolynomial.C (LaurentPolynomial.C b * LaurentPolynomial.T (-1)) := by
        rw [mul_one, sub_eq_add_neg, LaurentPolynomial.T_add]; ring
      rw [ee]
      exact s4 b b ((k : ℤ) - 1) ((n : ℤ) + (k : ℤ)) B (by omega)
    rw [r1, r2, add_zero] at e2
    exact ⟨_, e2.symm⟩

  have hBd : ∀ n, γ ∣ B.coeff n := by
    obtain ⟨ψ, hx, hy, hψι⟩ := hlift (LaurentPolynomial.C b * LaurentPolynomial.T (-1))
      (LaurentPolynomial.T 1)
      (by rw [mul_assoc, ← LaurentPolynomial.T_add]; simp)
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp h₁
    have e := congrArg ψ hg
    rw [map_mul, map_mul, map_pow, hp, map_add, map_mul, Polynomial.hom_eval₂,
      Polynomial.hom_eval₂, hψι, hx, hy, ← RingHom.comp_apply ψ ι, hψι,
      LaurentPolynomial.T_pow] at e
    intro n
    have e2 := congrArg (fun f : LaurentPolynomial ↥W => f.coeff ((n : ℤ) + ((k + 1 : ℕ) : ℤ))) e
    rw [mul_comm, hcoeffC, mul_add, hcoeffadd] at e2
    have r1 : (LaurentPolynomial.T ((k : ℤ) * 1) *
        A.eval₂ LaurentPolynomial.C (LaurentPolynomial.C b * LaurentPolynomial.T (-1))).coeff
          ((n : ℤ) + ((k + 1 : ℕ) : ℤ)) = 0 := by
      have ee : LaurentPolynomial.T ((k : ℤ) * 1) *
          A.eval₂ LaurentPolynomial.C (LaurentPolynomial.C b * LaurentPolynomial.T (-1)) =
          LaurentPolynomial.C 1 * LaurentPolynomial.T (k : ℤ) *
            A.eval₂ LaurentPolynomial.C (LaurentPolynomial.C b * LaurentPolynomial.T (-1)) := by
        rw [map_one, one_mul, mul_one]
      rw [ee]
      exact s4 1 b (k : ℤ) ((n : ℤ) + ((k + 1 : ℕ) : ℤ)) A (by push_cast; omega)
    have r2 : (LaurentPolynomial.T ((k : ℤ) * 1) *
        (LaurentPolynomial.T 1 * B.eval₂ LaurentPolynomial.C (LaurentPolynomial.T 1))).coeff
          ((n : ℤ) + ((k + 1 : ℕ) : ℤ)) = B.coeff n := by
      have ee : LaurentPolynomial.T ((k : ℤ) * 1) *
          (LaurentPolynomial.T 1 * B.eval₂ LaurentPolynomial.C (LaurentPolynomial.T 1)) =
          LaurentPolynomial.T (((k + 1 : ℕ) : ℤ)) *
            B.eval₂ LaurentPolynomial.C (LaurentPolynomial.T 1) := by
        rw [← mul_assoc, ← LaurentPolynomial.T_add]
        congr 2
        push_cast; ring
      rw [ee]
      exact s3 (k + 1) n B
    rw [r1, r2, zero_add] at e2
    exact ⟨_, e2.symm⟩

  obtain ⟨A', hA'⟩ := (Polynomial.C_dvd_iff_dvd_coeff γ A).mpr hAd
  obtain ⟨B', hB'⟩ := (Polynomial.C_dvd_iff_dvd_coeff γ B).mpr hBd
  rw [hp, hA', hB']
  apply Ideal.mem_span_singleton'.mpr
  refine ⟨A'.eval₂ ι (wcEbntX W b 0) + wcEbntX W b 1 * B'.eval₂ ι (wcEbntX W b 1), ?_⟩
  rw [hmul, hmul, Polynomial.eval₂_C, Polynomial.eval₂_C]
  ring

theorem wcNd_nodal_eval_injective : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (g' : ↥W) (P : Type u) [CommRing P] [IsDomain P] [IsLocalRing P] (φ : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g'}) →+* P), Function.Injective (φ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) → (∀ c : ↥W, c ∉ IsLocalRing.maximalIdeal ↥W → IsUnit (φ (Ideal.Quotient.mk _ (MvPolynomial.C c)))) → φ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ IsLocalRing.maximalIdeal P → φ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ IsLocalRing.maximalIdeal P → ∀ (J₁ J₂ : Ideal P), J₁.IsPrime → J₂.IsPrime → (∀ c ∈ IsLocalRing.maximalIdeal ↥W, φ (Ideal.Quotient.mk _ (MvPolynomial.C c)) ∈ J₁ ∧ φ (Ideal.Quotient.mk _ (MvPolynomial.C c)) ∈ J₂) → φ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ J₁ → φ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∉ J₁ → φ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ J₂ → φ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∉ J₂ → Function.Injective φ :=
by
  intro Ω _ W g' P _ _ _ φ hinj _hunit hξm hηm J₁ J₂ hJ₁ hJ₂ hsJ hηJ₁ hξJ₁ hξJ₂ hηJ₂
  classical

  have evsplit : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (t : S)
      (F : Polynomial R),
      Polynomial.eval₂ f t F = t * Polynomial.eval₂ f t F.divX + f (F.coeff 0) := by
    intro R S _ _ f t F
    conv_lhs => rw [← Polynomial.X_mul_divX_add F]
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C]
    ring

  have nf : ∀ (R : Type u) [CommRing R] (ψ : MvPolynomial (Fin 2) ↥W →+* R),
      ψ (MvPolynomial.X 0) * ψ (MvPolynomial.X 1) = ψ (MvPolynomial.C g') →
      ∀ h : MvPolynomial (Fin 2) ↥W, ∃ A B : Polynomial ↥W,
        ψ h = Polynomial.eval₂ (ψ.comp MvPolynomial.C) (ψ (MvPolynomial.X 0)) A +
          ψ (MvPolynomial.X 1) *
            Polynomial.eval₂ (ψ.comp MvPolynomial.C) (ψ (MvPolynomial.X 1)) B := by
    intro R _ ψ hxy h
    induction h using MvPolynomial.induction_on with
    | C a =>
      refine ⟨Polynomial.C a, 0, ?_⟩
      rw [Polynomial.eval₂_C, Polynomial.eval₂_zero, mul_zero, add_zero, RingHom.comp_apply]
    | add p q hp hq =>
      obtain ⟨A₁, B₁, h₁⟩ := hp
      obtain ⟨A₂, B₂, h₂⟩ := hq
      refine ⟨A₁ + A₂, B₁ + B₂, ?_⟩
      rw [map_add, h₁, h₂, Polynomial.eval₂_add, Polynomial.eval₂_add]
      ring
    | mul_X p n hp =>
      obtain ⟨A, B, hAB⟩ := hp
      obtain rfl | rfl : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      · refine ⟨Polynomial.X * A + Polynomial.C (g' * B.coeff 0),
          Polynomial.C g' * B.divX, ?_⟩
        have hB := evsplit (ψ.comp MvPolynomial.C) (ψ (MvPolynomial.X 1)) B
        rw [map_mul, hAB]
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_C,
          Polynomial.eval₂_mul, Polynomial.eval₂_X, RingHom.comp_apply, map_mul] at hB ⊢
        linear_combination
          (Polynomial.eval₂ (ψ.comp MvPolynomial.C) (ψ (MvPolynomial.X 1)) B) * hxy +
            ψ (MvPolynomial.C g') * hB
      · refine ⟨Polynomial.C g' * A.divX, Polynomial.C (A.coeff 0) + Polynomial.X * B, ?_⟩
        have hA := evsplit (ψ.comp MvPolynomial.C) (ψ (MvPolynomial.X 0)) A
        rw [map_mul, hAB]
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_X_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_mul, Polynomial.eval₂_X, RingHom.comp_apply] at hA ⊢
        linear_combination ψ (MvPolynomial.X 1) * hA +
          (Polynomial.eval₂ (ψ.comp MvPolynomial.C) (ψ (MvPolynomial.X 0)) A.divX) * hxy

  have s3 : ∀ (A B : Polynomial ↥W), (A ≠ 0 ∨ B ≠ 0) → ∃ (c : ↥W) (A' B' : Polynomial ↥W),
      c ≠ 0 ∧ A = Polynomial.C c * A' ∧ B = Polynomial.C c * B' ∧
        ∃ n : ℕ, A'.coeff n = 1 ∨ B'.coeff n = 1 := by
    intro A B hAB
    have aux : ∀ T : Finset ↥W, T.Nonempty → ∃ c ∈ T, ∀ a ∈ T, c ∣ a := by
      intro T hT
      induction hT using Finset.Nonempty.cons_induction with
      | singleton a =>
        exact ⟨a, Finset.mem_singleton_self a, fun b hb =>
          dvd_of_eq (Finset.mem_singleton.mp hb).symm⟩
      | cons a T haT hT ih =>
        obtain ⟨c, hcT, hc⟩ := ih
        rcases ValuationRing.dvd_total c a with h | h
        · refine ⟨c, Finset.mem_cons_of_mem hcT, fun b hb => ?_⟩
          rcases Finset.mem_cons.mp hb with rfl | hb
          · exact h
          · exact hc b hb
        · refine ⟨a, Finset.mem_cons_self a T, fun b hb => ?_⟩
          rcases Finset.mem_cons.mp hb with rfl | hb
          · exact dvd_rfl
          · exact h.trans (hc b hb)
    have hSne : (A.support.image A.coeff ∪ B.support.image B.coeff).Nonempty := by
      rcases hAB with h | h
      · exact ((Polynomial.support_nonempty.mpr h).image _).mono Finset.subset_union_left
      · exact ((Polynomial.support_nonempty.mpr h).image _).mono Finset.subset_union_right
    obtain ⟨c, hcS, hc⟩ := aux _ hSne
    have hcA : ∀ i, c ∣ A.coeff i := by
      intro i
      by_cases h : A.coeff i = 0
      · rw [h]; exact dvd_zero c
      · exact hc _ (Finset.mem_union_left _
          (Finset.mem_image_of_mem _ (Polynomial.mem_support_iff.mpr h)))
    have hcB : ∀ i, c ∣ B.coeff i := by
      intro i
      by_cases h : B.coeff i = 0
      · rw [h]; exact dvd_zero c
      · exact hc _ (Finset.mem_union_right _
          (Finset.mem_image_of_mem _ (Polynomial.mem_support_iff.mpr h)))
    obtain ⟨A', hA'⟩ := (Polynomial.C_dvd_iff_dvd_coeff c A).mpr hcA
    obtain ⟨B', hB'⟩ := (Polynomial.C_dvd_iff_dvd_coeff c B).mpr hcB
    have hc0 : c ≠ 0 := by
      rcases Finset.mem_union.mp hcS with h | h
      · obtain ⟨n, hn, hn'⟩ := Finset.mem_image.mp h
        rw [← hn']; exact Polynomial.mem_support_iff.mp hn
      · obtain ⟨n, hn, hn'⟩ := Finset.mem_image.mp h
        rw [← hn']; exact Polynomial.mem_support_iff.mp hn
    refine ⟨c, A', B', hc0, hA', hB', ?_⟩
    rcases Finset.mem_union.mp hcS with h | h
    · obtain ⟨n, -, hn⟩ := Finset.mem_image.mp h
      refine ⟨n, Or.inl ?_⟩
      have e : c * A'.coeff n = c * 1 := by
        rw [mul_one, ← Polynomial.coeff_C_mul, ← hA', hn]
      exact mul_left_cancel₀ hc0 e
    · obtain ⟨n, -, hn⟩ := Finset.mem_image.mp h
      refine ⟨n, Or.inr ?_⟩
      have e : c * B'.coeff n = c * 1 := by
        rw [mul_one, ← Polynomial.coeff_C_mul, ← hB', hn]
      exact mul_left_cancel₀ hc0 e
  set s : ↥W →+* P := φ.comp ((Ideal.Quotient.mk (Ideal.span
    {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)})).comp
      MvPolynomial.C) with hs
  set ξ : P := φ (Ideal.Quotient.mk (Ideal.span
    {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)})
      (MvPolynomial.X 0)) with hξ
  set η : P := φ (Ideal.Quotient.mk (Ideal.span
    {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)})
      (MvPolynomial.X 1)) with hη

  have s2 : ∀ (J : Ideal P), J.IsPrime → (∀ c ∈ IsLocalRing.maximalIdeal ↥W, s c ∈ J) →
      ∀ t ∈ IsLocalRing.maximalIdeal P, t ∉ J → ∀ n : ℕ, ∀ F : Polynomial ↥W,
      Polynomial.eval₂ s t F ∈ J → F.coeff n ∈ IsLocalRing.maximalIdeal ↥W := by
    intro J hJ hsJ' t htm htJ
    have star : ∀ F : Polynomial ↥W, Polynomial.eval₂ s t F ∈ J →
        F.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W ∧ Polynomial.eval₂ s t F.divX ∈ J := by
      intro F hF
      have hsplit := evsplit s t F
      have h0 : F.coeff 0 ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra h
        have hu : IsUnit (s (F.coeff 0)) := ((IsLocalRing.notMem_maximalIdeal).mp h).map s
        have hm : s (F.coeff 0) ∈ IsLocalRing.maximalIdeal P := by
          have e : s (F.coeff 0) =
              Polynomial.eval₂ s t F - t * Polynomial.eval₂ s t F.divX := by
            rw [hsplit]; ring
          rw [e]
          exact Ideal.sub_mem _ (IsLocalRing.le_maximalIdeal hJ.ne_top hF)
            (Ideal.mul_mem_right _ _ htm)
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hm
      refine ⟨h0, ?_⟩
      have e : t * Polynomial.eval₂ s t F.divX = Polynomial.eval₂ s t F - s (F.coeff 0) := by
        rw [hsplit]; ring
      have h1 : t * Polynomial.eval₂ s t F.divX ∈ J := by
        rw [e]; exact J.sub_mem hF (hsJ' _ h0)
      exact (hJ.mem_or_mem h1).resolve_left htJ
    intro n
    induction n with
    | zero => intro F hF; exact (star F hF).1
    | succ n ih =>
      intro F hF
      rw [← Polynomial.coeff_divX]
      exact ih _ (star F hF).2

  have core : ∀ A B : Polynomial ↥W,
      Polynomial.eval₂ s ξ A + η * Polynomial.eval₂ s η B = 0 → A = 0 ∧ B = 0 := by
    intro A B hG
    by_contra hne
    have hAB : A ≠ 0 ∨ B ≠ 0 := by
      by_contra h
      push_neg at h
      exact hne h
    obtain ⟨c, A', B', hc0, rfl, rfl, n, hn⟩ := s3 A B hAB
    have hsc : s c ≠ 0 := fun h => hc0 (hinj (h.trans (map_zero s).symm))
    have hG' : Polynomial.eval₂ s ξ A' + η * Polynomial.eval₂ s η B' = 0 := by
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_mul, Polynomial.eval₂_C,
        Polynomial.eval₂_C] at hG
      have h1 : s c * (Polynomial.eval₂ s ξ A' + η * Polynomial.eval₂ s η B') = 0 := by
        rw [← hG]; ring
      exact (mul_eq_zero.mp h1).resolve_left hsc
    have hA'J₁ : Polynomial.eval₂ s ξ A' ∈ J₁ := by
      have e : Polynomial.eval₂ s ξ A' = -(η * Polynomial.eval₂ s η B') :=
        eq_neg_of_add_eq_zero_left hG'
      rw [e]
      exact J₁.neg_mem (J₁.mul_mem_right _ hηJ₁)
    have hA'm := s2 J₁ hJ₁ (fun c hc => (hsJ c hc).1) ξ hξm hξJ₁
    have hA'J₂ : Polynomial.eval₂ s ξ A' ∈ J₂ := by
      rw [evsplit s ξ A']
      exact J₂.add_mem (J₂.mul_mem_right _ hξJ₂) (hsJ _ (hA'm 0 A' hA'J₁)).2
    have hB'J₂ : Polynomial.eval₂ s η B' ∈ J₂ := by
      have e : η * Polynomial.eval₂ s η B' = -Polynomial.eval₂ s ξ A' :=
        eq_neg_of_add_eq_zero_right hG'
      have h1 : η * Polynomial.eval₂ s η B' ∈ J₂ := by
        rw [e]; exact J₂.neg_mem hA'J₂
      exact (hJ₂.mem_or_mem h1).resolve_left hηJ₂
    have hB'm := s2 J₂ hJ₂ (fun c hc => (hsJ c hc).2) η hηm hηJ₂
    have h1m : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
      rcases hn with h | h
      · rw [← h]; exact hA'm n A' hA'J₁
      · rw [← h]; exact hB'm n B' hB'J₂
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1m) isUnit_one

  have hxyR : Ideal.Quotient.mk (Ideal.span
      {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)})
        (MvPolynomial.X 0) *
      Ideal.Quotient.mk (Ideal.span
      {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)})
        (MvPolynomial.X 1) =
      Ideal.Quotient.mk (Ideal.span
      {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)})
        (MvPolynomial.C g') := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_singleton _)
  refine (injective_iff_map_eq_zero φ).mpr ?_
  intro z hz
  obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨A, B, hAB⟩ := nf (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span
      {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)})
    (Ideal.Quotient.mk (Ideal.span
      {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g' : MvPolynomial (Fin 2) ↥W)}))
    hxyR h
  rw [hAB] at hz ⊢
  rw [map_add, map_mul, Polynomial.hom_eval₂, Polynomial.hom_eval₂] at hz
  obtain ⟨rfl, rfl⟩ := core A B hz
  simp

theorem wcpa_dj_lr1k_ebnt_dmne_pres_flat : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → @RingHom.Flat (wcEbntN W b) Q _ _ f :=
by
  intro Ω _ _ W hdim hWt Q _ σ b f hf
  classical

  have s1 : ∀ (A P : Type u) [CommRing A] [CommRing P] (e : A →+* P),
      (∀ F : Finset P, ∃ (T : Type u) (_ : CommRing T) (_ : Algebra A T) (_ : Module.Flat A T)
        (γ : T →+* P), Function.Injective γ ∧ γ.comp (algebraMap A T) = e ∧
          ∀ x ∈ F, x ∈ γ.range) → e.Flat := by
    intro A P _ _ e hch
    letI : Algebra A P := e.toAlgebra
    show Module.Flat A P
    apply Module.Flat.of_forall_isTrivialRelation
    intro l a x hax
    obtain ⟨T, _, _, _, γ, hγi, hγc, hγr⟩ := hch (Finset.univ.image x)
    have hx : ∀ i, ∃ t : T, γ t = x i := by
      intro i
      exact RingHom.mem_range.mp (hγr (x i) (Finset.mem_image_of_mem x (Finset.mem_univ i)))
    choose t ht using hx
    have hγs : ∀ (r : A) (z : T), γ (r • z) = e r * γ z := by
      intro r z
      rw [Algebra.smul_def, map_mul, ← RingHom.comp_apply, hγc]
    have hT : ∑ i, a i • t i = 0 := by
      apply hγi
      rw [map_sum, map_zero]
      simp only [hγs, ht]
      exact hax
    obtain ⟨k, α, y, hy, hα⟩ :=
      Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := A) (M := T) (f := a) (x := t) hT
    refine ⟨k, α, fun j => γ (y j), ?_, hα⟩
    intro i
    rw [← ht i, hy i, map_sum]
    simp only [hγs]
    rfl

  have s2 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (p : Ideal A)
      (P : Type u) [CommRing P] (e : A →+* P), wcNdIsHens p P e → Function.Injective e →
      ∀ F : Finset P, ∃ (T : Type u) (_ : CommRing T) (_ : Algebra A T) (_ : Module.Flat A T)
        (γ : T →+* P), Function.Injective γ ∧ γ.comp (algebraMap A T) = e ∧
          ∀ x ∈ F, x ∈ γ.range := by
    intro A _ _ _ p P _ e he hinj F
    haveI : HenselianLocalRing P := he.1
    obtain ⟨E, _, _, _, φ, hφ, hF⟩ := wcNd_hne_etale_approx A p P e he F
    set q : Ideal E := (IsLocalRing.maximalIdeal P).comap φ with hq
    haveI hqp : q.IsPrime := Ideal.comap_isPrime φ _
    have hunit : ∀ s : q.primeCompl, IsUnit (φ s) := by
      intro s
      have hs : φ (s : E) ∉ IsLocalRing.maximalIdeal P := s.2
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hs
      exact hs
    let ψ : Localization.AtPrime q →+* P :=
      IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit
    have hψ : ∀ z : E, ψ (algebraMap E (Localization.AtPrime q) z) = φ z := fun z =>
      IsLocalization.lift_eq hunit z
    have hcomp : ψ.comp (algebraMap A (Localization.AtPrime q)) = e := by
      apply RingHom.ext
      intro a
      show ψ (algebraMap A (Localization.AtPrime q) a) = e a
      rw [IsScalarTower.algebraMap_apply A E (Localization.AtPrime q) a, hψ, ← RingHom.comp_apply,
        hφ]
    haveI : Module.Flat A (Localization.AtPrime q) := inferInstance
    have hdom : IsDomain (Localization.AtPrime q) := (wc_pks_etale_localization_normal A E q).1
    have hψi : Function.Injective ψ :=
      wcNd_hne_local_injective A E q hdom P ψ (by rw [hcomp]; exact hinj)
        (wcNd_hne_etale_algebraic A E)
    refine ⟨Localization.AtPrime q, inferInstance, inferInstance, inferInstance, ψ, hψi, hcomp, ?_⟩
    intro x hx
    obtain ⟨z, hz⟩ := RingHom.mem_range.mp (hF x hx)
    exact RingHom.mem_range.mpr ⟨algebraMap E _ z, by rw [hψ, hz]⟩

  have hX0 : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → ¬ IsUnit (f (wcEbntX W c 0)) := by
    intro P _ σ c f hf hu
    apply (hf.2.2.2.2.1 _).mp hu
    apply Ideal.mem_map_of_mem
    apply Ideal.mem_sup_left
    apply Ideal.subset_span
    exact Set.mem_insert _ _
  have hprime : ∀ (A : Type u) [CommRing A] (p : Ideal A) (P : Type u) [CommRing P]
      (e : A →+* P), wcNdIsHens p P e → p.IsPrime := by
    intro A _ p P _ e he
    haveI := he.1
    have hp : p = (IsLocalRing.maximalIdeal P).comap e := by
      ext t
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he.2.1 t, not_not]
    rw [hp]
    exact Ideal.comap_isPrime e _
  have hb0 : b ≠ 0 := hf.2.1
  haveI : HenselianLocalRing Q := hf.2.2.2.1
  haveI : IsDomain (wcEbntN W b) := (wcNd_nodal_poly_normal Ω W b hb0).1
  haveI : IsIntegrallyClosed (wcEbntN W b) := (wcNd_nodal_poly_normal Ω W b hb0).2
  haveI : IsDomain Q := (wcNd_hens_normal_domain (wcEbntN W b) _
    (hprime _ _ _ _ hf.2.2.2) Q f hf.2.2.2).1
  obtain ⟨f', hf', hf'0, hf'1⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W Q σ b f hf
  obtain ⟨hJ1p, hJ1x, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hdim hWt Q σ b f hf
  obtain ⟨hJ2p, hJ2x, -⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hdim hWt Q σ b f' hf'
  rw [hf'1] at hJ2p hJ2x
  rw [hf'0] at hJ2x
  have hfσ : ∀ w : ↥W, f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C b}) (MvPolynomial.C w)) = σ w := fun w => RingHom.congr_fun hf.2.2.1 w
  have hσinj := wcpa_dj_lr1k_ebnt_pres_sigma_injective Ω W Q σ b f hf
  have hy0 : ¬ IsUnit (f (wcEbntX W b 1)) := by
    have := hX0 _ _ _ _ hf'
    rw [hf'0] at this
    exact this
  have hinjf : Function.Injective f := by
    refine wcNd_nodal_eval_injective Ω W b Q f ?_ ?_ ?_ ?_
      (Ideal.span {f (wcEbntX W b 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ)
      (Ideal.span {f (wcEbntX W b 0)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ)
      hJ1p hJ2p ?_ ?_ hJ1x ?_ hJ2x
    · intro x y hxy
      apply hσinj
      rw [← hfσ x, ← hfσ y]
      exact hxy
    · intro c hc
      rw [hfσ]
      apply IsUnit.map σ
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hc
    · exact (IsLocalRing.mem_maximalIdeal _).mpr (hX0 _ _ _ _ hf)
    · exact (IsLocalRing.mem_maximalIdeal _).mpr hy0
    · intro c hc
      rw [hfσ]
      exact ⟨Ideal.mem_sup_right (Ideal.mem_map_of_mem σ hc),
        Ideal.mem_sup_right (Ideal.mem_map_of_mem σ hc)⟩
    · exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
    · exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)

  exact s1 (wcEbntN W b) Q f (s2 (wcEbntN W b) _ Q f hf.2.2.2 hinjf)

theorem wcpa_dj_lr1k_ebnt_dm_no_embedded : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (γ : ↥W) (u q : Q), u ∉ Ideal.span {f (wcEbntX W b 0)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ → u ∉ Ideal.span {f (wcEbntX W b 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ → u * q ∈ Ideal.span {σ γ} → q ∈ Ideal.span {σ γ} :=
by
  intro Ω _ _ W hW hWt Q _ σ b f hf γ u q hu0 hu1 huq
  classical

  have s5 : ∀ (B M : Type u) [CommRing B] [CommRing M] (g : B →+* M), g.Flat → ∀ (s t c : B),
      (∀ p : B, s * p ∈ Ideal.span {c} → t * p ∈ Ideal.span {c} → p ∈ Ideal.span {c}) →
      ∀ m : M, g s * m ∈ Ideal.span {g c} → g t * m ∈ Ideal.span {g c} →
        m ∈ Ideal.span {g c} := by
    intro B M _ _ g hg s t c hB m hs ht
    letI : Algebra B M := g.toAlgebra
    haveI : Module.Flat B M := hg
    have hsmul : ∀ (r : B) (z : M), r • z = g r * z := fun r z => rfl
    obtain ⟨m1, hm1⟩ := Ideal.mem_span_singleton'.mp hs
    obtain ⟨m2, hm2⟩ := Ideal.mem_span_singleton'.mp ht
    let x : (Fin 3 → B) →ₗ[B] M := Fintype.linearCombination B ![m, m1, m2]
    let fK : (Fin 2 → B) →ₗ[B] (Fin 3 → B) :=
      Fintype.linearCombination B ![![s, -c, 0], ![t, 0, -c]]
    have hx : ∀ v : Fin 3 → B, x v = g (v 0) * m + g (v 1) * m1 + g (v 2) * m2 := by
      intro v
      simp only [x, Fintype.linearCombination_apply, Fin.sum_univ_three, hsmul]
      rfl
    have h0 : x (fK (Pi.single 0 1)) = 0 := by
      simp only [fK, Fintype.linearCombination_apply_single, one_smul]
      rw [hx]
      show g s * m + g (-c) * m1 + g 0 * m2 = 0
      rw [map_neg, map_zero, ← hm1]; ring
    have h1 : x (fK (Pi.single 1 1)) = 0 := by
      simp only [fK, Fintype.linearCombination_apply_single, one_smul]
      rw [hx]
      show g t * m + g 0 * m1 + g (-c) * m2 = 0
      rw [map_neg, map_zero, ← hm2]; ring
    have h : x ∘ₗ fK = 0 := by
      apply LinearMap.pi_ext'
      rw [Fin.forall_fin_two]
      constructor <;> apply LinearMap.ext_ring
      · first | exact h0 | simpa using h0
      · first | exact h1 | simpa using h1
    obtain ⟨k, a, y, hxy, haf⟩ := Module.Flat.exists_factorization_of_comp_eq_zero_of_free h
    set e : Fin 3 → (Fin 3 → B) := fun i => Pi.single i 1 with he
    have hdec : ∀ v : Fin 3 → B, v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      intro v
      ext j
      fin_cases j <;> simp [he, Pi.single_apply]
    have hrel0 : ∀ v : Fin 3 → B, a v = v 0 • a (e 0) + v 1 • a (e 1) + v 2 • a (e 2) := by
      intro v
      conv_lhs => rw [hdec v]
      simp only [map_add, map_smul]
    have hz : ∀ i : Fin 2, a (fK (Pi.single i 1)) = 0 := by
      intro i
      have := congrArg (fun φ => φ (Pi.single i 1)) haf
      simpa using this
    have hz0 := hz 0
    have hz1 := hz 1
    simp only [fK, Fintype.linearCombination_apply_single, one_smul] at hz0 hz1
    rw [hrel0] at hz0 hz1
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, zero_smul, add_zero, zero_add] at hz0 hz1
    have hcol : ∀ j, a (e 0) j ∈ Ideal.span {c} := by
      intro j
      have e0 := congrArg (fun v : Fin k →₀ B => v j) hz0
      have e1 := congrArg (fun v : Fin k →₀ B => v j) hz1
      simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, Finsupp.coe_zero,
        Pi.zero_apply] at e0 e1
      apply hB
      · exact Ideal.mem_span_singleton'.mpr ⟨a (e 1) j, by linear_combination -e0⟩
      · exact Ideal.mem_span_singleton'.mpr ⟨a (e 2) j, by linear_combination -e1⟩
    choose w hw using fun j => Ideal.mem_span_singleton'.mp (hcol j)
    let w' : Fin k →₀ B := Finsupp.equivFunOnFinite.symm w
    have haw : a (e 0) = c • w' := by
      ext j
      show a (e 0) j = c * w' j
      rw [← hw j, mul_comm]
      rfl
    have hm : m = x (e 0) := by
      rw [hx]; simp [he]
    rw [Ideal.mem_span_singleton']
    refine ⟨y w', ?_⟩
    rw [hm, hxy, LinearMap.comp_apply, haw, map_smul, hsmul, mul_comm]

  have s1 : ∀ (γ t : ↥W), γ ≠ 0 → t ∈ IsLocalRing.maximalIdeal ↥W → ∃ n : ℕ, γ ∣ t ^ n := by
    intro γ t hγ ht
    by_contra hcon
    push_neg at hcon
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hdisj : Disjoint (↑(Ideal.span {γ}) : Set ↥W) ↑(Submonoid.powers t) := by
      rw [Set.disjoint_left]
      rintro z hz ⟨n, rfl⟩
      exact hcon n (Ideal.mem_span_singleton.mp hz)
    obtain ⟨p, hp, hle, hpd⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
    have htp : t ∉ p := fun h => Set.disjoint_left.mp hpd h ⟨1, pow_one t⟩
    rcases Ring.krullDimLE_one_iff.mp inferInstance p hp with h | h
    · have hbot : p ≤ ⊥ := h.2 ⟨inferInstance, bot_le⟩ bot_le
      apply hγ
      have : γ ∈ p := hle (Ideal.mem_span_singleton_self γ)
      exact (Submodule.mem_bot _).mp (hbot this)
    · exact htp (by rw [IsLocalRing.eq_maximalIdeal h]; exact ht)

  have hrel : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → f (wcEbntX W c 0) * f (wcEbntX W c 1) = σ c := by
    intro P _ σ c f hf
    have h1 : (wcEbntX W c 0) * (wcEbntX W c 1) =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})
          (MvPolynomial.C c) := by
      show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
      rw [← map_mul, Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    rw [← map_mul, h1, ← hf.2.2.1]
    rfl
  have hX0 : ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (c : ↥W) (f : wcEbntN W c →+* P),
      wcEbntPres W σ c f → ¬ IsUnit (f (wcEbntX W c 0)) := by
    intro P _ σ c f hf hu
    apply (hf.2.2.2.2.1 _).mp hu
    apply Ideal.mem_map_of_mem
    apply Ideal.mem_sup_left
    apply Ideal.subset_span
    exact Set.mem_insert _ _
  have hprime : ∀ (A : Type u) [CommRing A] (p : Ideal A) (P : Type u) [CommRing P]
      (e : A →+* P), wcNdIsHens p P e → p.IsPrime := by
    intro A _ p P _ e he
    haveI := he.1
    have hp : p = (IsLocalRing.maximalIdeal P).comap e := by
      ext t
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, he.2.1 t, not_not]
    rw [hp]
    exact Ideal.comap_isPrime e _
  have hb0 : b ≠ 0 := hf.2.1
  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := hf.1
  haveI : HenselianLocalRing Q := hf.2.2.2.1
  haveI : IsDomain (wcEbntN W b) := (wcNd_nodal_poly_normal Ω W b hb0).1
  haveI : IsIntegrallyClosed (wcEbntN W b) := (wcNd_nodal_poly_normal Ω W b hb0).2
  haveI : IsDomain Q := (wcNd_hens_normal_domain (wcEbntN W b) _
    (hprime _ _ _ _ hf.2.2.2) Q f hf.2.2.2).1
  obtain ⟨f', hf', hf'0, hf'1⟩ := wcpa_dj_lr1k_ebnt_pres_swap Ω W Q σ b f hf
  have hxnu : ¬ IsUnit (f (wcEbntX W b 0)) := hX0 _ _ _ _ hf
  have hynu : ¬ IsUnit (f (wcEbntX W b 1)) := by
    rw [← hf'0]; exact hX0 _ _ _ _ hf'
  have hfσ : ∀ w : ↥W, f (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C b}) (MvPolynomial.C w)) = σ w := fun w => RingHom.congr_fun hf.2.2.1 w

  by_cases hγ : γ = 0
  · subst hγ
    rw [map_zero] at huq ⊢
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp huq
    rw [mul_zero] at hr
    have hu : u ≠ 0 := by
      rintro rfl
      exact hu0 (Submodule.zero_mem _)
    have hq : q = 0 := (mul_eq_zero.mp hr.symm).resolve_left hu
    rw [hq]
    exact Submodule.zero_mem _

  have hclaim : ∀ P : Ideal Q, P.IsPrime → Ideal.span {u, σ γ} ≤ P →
      f (wcEbntX W b 0) ∈ P ∧ f (wcEbntX W b 1) ∈ P := by
    intro P hP hJ
    have huP : u ∈ P := hJ (Ideal.subset_span (Set.mem_insert _ _))
    have hγP : σ γ ∈ P := hJ (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    have hmP : (IsLocalRing.maximalIdeal ↥W).map σ ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      intro t ht
      obtain ⟨n, w, hw⟩ := s1 γ t hγ ht
      rw [Ideal.mem_comap]
      apply hP.mem_of_pow_mem n
      rw [← map_pow, hw, map_mul]
      exact P.mul_mem_right _ hγP
    have hxy : f (wcEbntX W b 0) * f (wcEbntX W b 1) ∈ P := by
      rw [hrel _ _ _ _ hf]; exact hmP (Ideal.mem_map_of_mem σ hbm)
    have hmaxP : P.IsMaximal → f (wcEbntX W b 0) ∈ P ∧ f (wcEbntX W b 1) ∈ P := fun hmax => by
      rw [IsLocalRing.eq_maximalIdeal hmax]
      exact ⟨(IsLocalRing.mem_maximalIdeal _).mpr hxnu, (IsLocalRing.mem_maximalIdeal _).mpr hynu⟩
    rcases hP.mem_or_mem hxy with hx | hy
    · obtain ⟨-, -, hcl⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt Q σ b f' hf'
      have hle : Ideal.span {f' (wcEbntX W b 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ≤ P :=
        sup_le ((Ideal.span_singleton_le_iff_mem _).mpr (by rw [hf'1]; exact hx)) hmP
      rcases hcl P hP hle with heq | hmax
      · exfalso
        rw [heq, hf'1] at huP
        exact hu0 huP
      · exact hmaxP hmax
    · obtain ⟨-, -, hcl⟩ := wcpa_dj_lr1k_ebnt_pres_branch Ω W hW hWt Q σ b f hf
      have hle : Ideal.span {f (wcEbntX W b 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ≤ P :=
        sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hy) hmP
      rcases hcl P hP hle with heq | hmax
      · exfalso
        rw [heq] at huP
        exact hu1 huP
      · exact hmaxP hmax
  have hrad : ∀ z : Q, (∀ P : Ideal Q, P.IsPrime → Ideal.span {u, σ γ} ≤ P → z ∈ P) →
      ∃ n : ℕ, z ^ n ∈ Ideal.span {u, σ γ} := by
    intro z hz
    have : z ∈ (Ideal.span {u, σ γ}).radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro P ⟨hJ, hP⟩
      exact hz P hP hJ
    exact this
  obtain ⟨k₀, hk₀⟩ := hrad _ (fun P hP hJ => (hclaim P hP hJ).1)
  obtain ⟨k₁, hk₁⟩ := hrad _ (fun P hP hJ => (hclaim P hP hJ).2)
  set k := k₀ + k₁ with hk
  have hxk : f (wcEbntX W b 0) ^ k ∈ Ideal.span {u, σ γ} := by
    rw [hk, pow_add]; exact Ideal.mul_mem_right _ _ hk₀
  have hyk : f (wcEbntX W b 1) ^ k ∈ Ideal.span {u, σ γ} := by
    rw [hk, pow_add]; exact Ideal.mul_mem_left _ _ hk₁
  have hmulq : ∀ z : Q, z ∈ Ideal.span {u, σ γ} → z * q ∈ Ideal.span {σ γ} := by
    intro z hz
    obtain ⟨a₁, d₁, hz'⟩ := Ideal.mem_span_pair.mp hz
    rw [← hz', add_mul, mul_assoc]
    refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ huq) ?_
    exact Ideal.mem_span_singleton'.mpr ⟨d₁ * q, by ring⟩

  have hflat := wcpa_dj_lr1k_ebnt_dmne_pres_flat Ω W hW hWt Q σ b f hf
  have key := s5 (wcEbntN W b) Q f hflat (wcEbntX W b 0 ^ k) (wcEbntX W b 1 ^ k)
    (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
      (MvPolynomial.C γ))
    (wcpa_dj_lr1k_ebnt_dmne_node_colon Ω W b γ k) q
  rw [hfσ, map_pow, map_pow] at key
  exact key (hmulq _ hxk) (hmulq _ hyk)

theorem wcpa_dj_lr1k_ebnt_branch_monomial : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P), wcEbntPres W σ a f → ∀ t : P, t ∈ Ideal.span {f (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ∨ ∃ (k : ℕ) (ε : P), IsUnit ε ∧ t - ε * f (wcEbntX W a 0) ^ k ∈ Ideal.span {f (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
by
  intro Ω _ _ W _ _ P _ σ a f hf t
  classical

  have s2 : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (I : Ideal R), I ≠ ⊤ →
      HenselianLocalRing (R ⧸ I) := by
    intro R _ _ I hI
    haveI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    have hsurj : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
    haveI : IsLocalRing (R ⧸ I) := IsLocalRing.of_surjective' _ hsurj
    haveI : IsLocalHom (Ideal.Quotient.mk I) := IsLocalHom.of_surjective _ hsurj
    refine HenselianLocalRing.mk ?_
    intro g hg a₀ ha₀ hd
    have hlift : g ∈ Polynomial.lifts (Ideal.Quotient.mk I) :=
      (Polynomial.mem_lifts g).mpr (Polynomial.map_surjective _ hsurj g)
    obtain ⟨G, hGg, -, hGm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hg
    obtain ⟨b₀, rfl⟩ := hsurj a₀
    have e1 : Ideal.Quotient.mk I (G.eval b₀) = g.eval (Ideal.Quotient.mk I b₀) := by
      rw [← hGg, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have e2 : Ideal.Quotient.mk I ((Polynomial.derivative G).eval b₀) =
        (Polynomial.derivative g).eval (Ideal.Quotient.mk I b₀) := by
      rw [← hGg, Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have h1 : G.eval b₀ ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := hu.map (Ideal.Quotient.mk I)
      rw [e1] at this
      exact (IsLocalRing.mem_maximalIdeal _).mp ha₀ this
    have h2 : IsUnit ((Polynomial.derivative G).eval b₀) := by
      rw [← isUnit_map_iff (Ideal.Quotient.mk I), e2]; exact hd
    obtain ⟨b, hb, hbb⟩ := HenselianLocalRing.is_henselian G hGm b₀ h1 h2
    refine ⟨Ideal.Quotient.mk I b, ?_, ?_⟩
    · rw [← hGg]; exact Polynomial.IsRoot.map hb
    · rw [← map_sub]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hbb ⊢
      intro hu; exact hbb ((isUnit_map_iff _ _).mp hu)

  have s3 : ∀ (H : Type u) [CommRing H] [IsLocalRing H] [IsNoetherianRing H] (π : H),
      IsLocalRing.maximalIdeal H = Ideal.span {π} → ∀ h : H, h ≠ 0 →
      ∃ (k : ℕ) (u : H), IsUnit u ∧ h = u * π ^ k := by
    intro H _ _ _ π hmax h hh
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal H)
      (IsLocalRing.maximalIdeal.isMaximal H).ne_top
    have hex : ∃ n, h ∉ Ideal.span {π ^ n} := by
      by_contra hc
      push_neg at hc
      apply hh
      have : h ∈ ⨅ i, IsLocalRing.maximalIdeal H ^ i := by
        rw [Submodule.mem_iInf]
        intro i
        rw [hmax, Ideal.span_singleton_pow]; exact hc i
      rw [hK] at this
      exact (Submodule.mem_bot H).mp this
    obtain ⟨N, hN, hmin⟩ : ∃ N, h ∉ Ideal.span {π ^ N} ∧ ∀ m < N, h ∈ Ideal.span {π ^ m} :=
      ⟨Nat.find hex, Nat.find_spec hex, fun m hm => not_not.mp (Nat.find_min hex hm)⟩
    have hN0 : N ≠ 0 := by
      rintro rfl; apply hN; rw [pow_zero, Ideal.span_singleton_one]; exact Submodule.mem_top
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hN0
    obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp (hmin k (Nat.lt_succ_self k))
    refine ⟨k, s, ?_, hs.symm⟩
    by_contra hsu
    have hsm : s ∈ Ideal.span {π} := by
      rw [← hmax]; exact (IsLocalRing.mem_maximalIdeal _).mpr hsu
    obtain ⟨s', hs'⟩ := Ideal.mem_span_singleton'.mp hsm
    apply hN
    exact Ideal.mem_span_singleton'.mpr ⟨s', by rw [← hs, ← hs', pow_succ]; ring⟩

  obtain ⟨ham, ha0, hfσ, hH⟩ := hf
  obtain ⟨hHens, hunit, hUPP⟩ := hH
  haveI := hHens
  have hσ : ∀ c, f (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.C c)) =
      σ c := fun c => RingHom.congr_fun hfσ c

  have s1 : ∀ p : MvPolynomial (Fin 2) ↥W,
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) p ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) ↔
      MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal ↥W := by
    intro p
    have hb : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W) ≤
        (IsLocalRing.maximalIdeal ↥W).comap
          (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) ↥W →+* ↥W) := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        simp [Set.insert_subset_iff, Ideal.mem_comap]
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc
        simpa [Ideal.mem_comap] using hc
    have hGJ : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a ∈
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W) :=
      Ideal.sub_mem _ (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ham))
    constructor
    · intro hp
      rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hp
      obtain ⟨p', hp'J, hp'⟩ := hp
      have hd := Ideal.Quotient.eq.mp hp'
      have hdJ := (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hGJ)) hd
      have : p ∈ Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W) := by
        have := Ideal.sub_mem _ hp'J hdJ; rwa [sub_sub_cancel] at this
      exact hb this
    · intro hp
      apply Ideal.mem_map_of_mem
      have hr : p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
          Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
        have : ({MvPolynomial.X 0, MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) ↥W)) =
            MvPolynomial.X '' {0, 1} := by
          rw [Set.image_pair]
        rw [this, MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        have hm0 : m ≠ 0 := by
          rintro rfl
          rw [MvPolynomial.mem_support_iff] at hm
          apply hm
          simp [MvPolynomial.coeff_sub, MvPolynomial.coeff_C, MvPolynomial.constantCoeff_eq]
        obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
        exact ⟨i, by fin_cases i <;> simp, by simpa using hi⟩
      have := Ideal.add_mem _ (Ideal.mem_sup_left hr : _ ∈ Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem MvPolynomial.C hp))
      rwa [sub_add_cancel] at this

  have hy_nu : ¬ IsUnit (f (wcEbntX W a 1)) := by
    rw [hunit, not_not]; exact (s1 (MvPolynomial.X 1)).mpr (by simp)
  set 𝔟 := Ideal.span {f (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ with h𝔟
  have h𝔟le : 𝔟 ≤ IsLocalRing.maximalIdeal P := by
    refine sup_le ((Ideal.span_singleton_le_iff_mem _).mpr
      ((IsLocalRing.mem_maximalIdeal _).mpr hy_nu)) ?_
    rw [Ideal.map_le_iff_le_comap]
    intro c hc
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hσ c, hunit, not_not]
    exact (s1 (MvPolynomial.C c)).mpr (by simpa using hc)
  have h𝔟ne : 𝔟 ≠ ⊤ := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal P).ne_top (eq_top_iff.mpr (h ▸ h𝔟le))
  haveI hD : HenselianLocalRing (P ⧸ 𝔟) := s2 P 𝔟 h𝔟ne
  haveI : Nontrivial (P ⧸ 𝔟) := Ideal.Quotient.nontrivial_iff.mpr h𝔟ne
  haveI hqloc : IsLocalHom (Ideal.Quotient.mk 𝔟) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hqx : Ideal.Quotient.mk 𝔟 (f (wcEbntX W a 0)) ∈ IsLocalRing.maximalIdeal (P ⧸ 𝔟) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff, hunit, not_not]
    exact (s1 (MvPolynomial.X 0)).mpr (by simp)
  have hqy : Ideal.Quotient.mk 𝔟 (f (wcEbntX W a 1)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))

  obtain ⟨θ, hθC, hθX0, hθX1⟩ : ∃ θ : wcEbntN W a →+* Polynomial (IsLocalRing.ResidueField ↥W),
      (∀ r, θ (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.C r)) =
          Polynomial.C (IsLocalRing.residue ↥W r)) ∧
      θ (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 0)) =
          Polynomial.X ∧
      θ (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 1)) =
          0 := by
    have hra : IsLocalRing.residue ↥W a = 0 := (IsLocalRing.residue_eq_zero_iff a).mpr ham
    have hθwd : ∀ z ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a},
        MvPolynomial.eval₂Hom (Polynomial.C.comp (IsLocalRing.residue ↥W))
          (![Polynomial.X, 0] : Fin 2 → Polynomial (IsLocalRing.ResidueField ↥W)) z = 0 := by
      intro z hz
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      simp [hra]
    refine ⟨Ideal.Quotient.lift _ _ hθwd, ?_, ?_, ?_⟩
    · intro r; simp
    · simp
    · simp
  have hF3 : ∀ p, (θ (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) p)).coeff 0 =
      IsLocalRing.residue ↥W (MvPolynomial.constantCoeff p) := by
    intro p
    have : (Polynomial.constantCoeff).comp (θ.comp (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))) =
        (IsLocalRing.residue ↥W).comp MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, hθC, Polynomial.constantCoeff_apply, Polynomial.coeff_C_zero,
          MvPolynomial.constantCoeff_C]
      · intro i
        fin_cases i
        · show Polynomial.constantCoeff (θ (Ideal.Quotient.mk _ (MvPolynomial.X 0))) =
            IsLocalRing.residue ↥W (MvPolynomial.constantCoeff (MvPolynomial.X 0))
          rw [hθX0]; simp
        · show Polynomial.constantCoeff (θ (Ideal.Quotient.mk _ (MvPolynomial.X 1))) =
            IsLocalRing.residue ↥W (MvPolynomial.constantCoeff (MvPolynomial.X 1))
          rw [hθX1]; simp
    have h2 := RingHom.congr_fun this p
    simpa only [RingHom.comp_apply, Polynomial.constantCoeff_apply] using h2

  haveI hIp : (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}).IsPrime :=
    (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr Polynomial.prime_X
  haveI : IsNoetherianRing (Localization.AtPrime
      (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))})) :=
    IsLocalization.isNoetherianRing
      (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}).primeCompl _
      inferInstance
  obtain ⟨H, _, _, _, ι₀, hι₀loc, -, hι₀max, hUP, -⟩ := wc_hnas_henselization_exists
    (Localization.AtPrime (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}))
  obtain ⟨ι, hιdef⟩ : ∃ ι : Polynomial (IsLocalRing.ResidueField ↥W) →+* H,
      ι = ι₀.comp (algebraMap _ _) := ⟨_, rfl⟩
  have hX0 : ∀ s : Polynomial (IsLocalRing.ResidueField ↥W),
      s ∈ Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))} ↔ s.coeff 0 = 0 := by
    intro s; rw [Ideal.mem_span_singleton, Polynomial.X_dvd_iff]
  have hιu : ∀ s : Polynomial (IsLocalRing.ResidueField ↥W), IsUnit (ι s) ↔ s.coeff 0 ≠ 0 := by
    intro s
    rw [hιdef, RingHom.comp_apply, isUnit_map_iff ι₀,
      IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime
        (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}))
        (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}) s,
      Ideal.mem_primeCompl_iff, hX0]
  have hmaxH : IsLocalRing.maximalIdeal H = Ideal.span {ι Polynomial.X} := by
    have e := @Localization.AtPrime.map_eq_maximalIdeal _ _
      (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}) hIp
    rw [← hι₀max]
    erw [← e]
    rw [Ideal.map_map, Ideal.map_span, Set.image_singleton, hιdef]
  have hHUP : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      (g : Polynomial (IsLocalRing.ResidueField ↥W) →+* A),
      (∀ s, IsUnit (g s) ↔ s.coeff 0 ≠ 0) → ∃ h : H →+* A, IsLocalHom h ∧ h.comp ι = g := by
    intro A _ _ g hg
    have hgu : ∀ y : (Ideal.span
        {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}).primeCompl, IsUnit (g y) := by
      intro y
      rw [hg]
      have := y.2
      rw [Ideal.mem_primeCompl_iff, hX0] at this
      exact this
    have hg'loc : IsLocalHom (IsLocalization.lift (S := Localization.AtPrime
        (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))})) hgu) := by
      constructor
      intro r hr
      obtain ⟨⟨s, y⟩, rfl⟩ := IsLocalization.mk'_surjective
        (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}).primeCompl r
      rw [IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime
        (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}))
        (Ideal.span {(Polynomial.X : Polynomial (IsLocalRing.ResidueField ↥W))}) s y,
        Ideal.mem_primeCompl_iff, hX0]
      rw [IsLocalization.lift_mk'] at hr
      exact (hg s).mp (IsUnit.mul_iff.mp hr).1
    obtain ⟨h, ⟨hloc, hcomp⟩, -⟩ := hUP A _ hg'loc
    refine ⟨h, hloc, ?_⟩
    rw [hιdef, ← RingHom.comp_assoc, hcomp]
    exact IsLocalization.lift_comp hgu

  have hgH : ∀ s : wcEbntN W a, IsUnit ((ι.comp θ) s) ↔
      s ∉ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) := by
    intro s
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective s
    rw [RingHom.comp_apply, hιu, hF3, s1, Ne, IsLocalRing.residue_eq_zero_iff]
  obtain ⟨ψ₀, ⟨hψ₀f, hψ₀loc⟩, -⟩ := hUPP H inferInstance (ι.comp θ) hgH

  obtain ⟨lam, hlam⟩ : ∃ lam : IsLocalRing.ResidueField ↥W →+* P ⧸ 𝔟,
      ∀ c, lam (IsLocalRing.residue ↥W c) = Ideal.Quotient.mk 𝔟 (σ c) := by
    have hlamwd : ∀ c ∈ IsLocalRing.maximalIdeal ↥W, ((Ideal.Quotient.mk 𝔟).comp σ) c = 0 := by
      intro c hc
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_right (Ideal.mem_map_of_mem σ hc)
    exact ⟨Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W) ((Ideal.Quotient.mk 𝔟).comp σ) hlamwd,
      fun c => rfl⟩
  obtain ⟨χ, hχC, hχX⟩ : ∃ χ : Polynomial (IsLocalRing.ResidueField ↥W) →+* P ⧸ 𝔟,
      (∀ r, χ (Polynomial.C r) = lam r) ∧ χ Polynomial.X = Ideal.Quotient.mk 𝔟 (f (wcEbntX W a 0)) :=
    ⟨Polynomial.eval₂RingHom lam _, fun r => Polynomial.eval₂_C _ _, Polynomial.eval₂_X _ _⟩
  have hχu : ∀ s : Polynomial (IsLocalRing.ResidueField ↥W), IsUnit (χ s) ↔ s.coeff 0 ≠ 0 := by
    intro s
    have hs : χ s = Ideal.Quotient.mk 𝔟 (f (wcEbntX W a 0)) * χ s.divX + lam (s.coeff 0) := by
      conv_lhs => rw [← Polynomial.X_mul_divX_add s]
      rw [map_add, map_mul, hχX, hχC]
    have hmem : Ideal.Quotient.mk 𝔟 (f (wcEbntX W a 0)) * χ s.divX ∈
        IsLocalRing.maximalIdeal (P ⧸ 𝔟) := Ideal.mul_mem_right _ _ hqx
    constructor
    · intro hu h0
      rw [hs, h0, map_zero, add_zero] at hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hmem hu
    · intro h0
      obtain ⟨c, hc⟩ := IsLocalRing.residue_surjective (s.coeff 0)
      have hcu : IsUnit c := by
        by_contra hcn
        apply h0
        rw [← hc]
        exact (IsLocalRing.residue_eq_zero_iff c).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hcn)
      have hlamu : IsUnit (lam (s.coeff 0)) := by
        rw [← hc, hlam]; exact (hcu.map σ).map _
      rw [hs]
      by_contra hn
      have h1 : Ideal.Quotient.mk 𝔟 (f (wcEbntX W a 0)) * χ s.divX + lam (s.coeff 0) ∈
          IsLocalRing.maximalIdeal (P ⧸ 𝔟) := (IsLocalRing.mem_maximalIdeal _).mpr hn
      have h2 := Ideal.sub_mem _ h1 hmem
      rw [add_sub_cancel_left] at h2
      exact (IsLocalRing.mem_maximalIdeal _).mp h2 hlamu
  obtain ⟨φ, hφloc, hφι⟩ := hHUP (P ⧸ 𝔟) χ hχu

  have hcomp1 : χ.comp θ = (Ideal.Quotient.mk 𝔟).comp f := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply]
      rw [hθC, hχC, hlam, hσ r]
    · intro i
      fin_cases i
      · show χ (θ (Ideal.Quotient.mk _ (MvPolynomial.X 0))) =
          Ideal.Quotient.mk 𝔟 (f (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
        rw [hθX0, hχX]
      · show χ (θ (Ideal.Quotient.mk _ (MvPolynomial.X 1))) =
          Ideal.Quotient.mk 𝔟 (f (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
        rw [hθX1, map_zero]
        exact hqy.symm
  have hg'u : ∀ s, IsUnit (((Ideal.Quotient.mk 𝔟).comp f) s) ↔
      s ∉ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) := by
    intro s; rw [RingHom.comp_apply, isUnit_map_iff, hunit]
  have hφψ : φ.comp ψ₀ = Ideal.Quotient.mk 𝔟 := by
    refine (hUPP (P ⧸ 𝔟) inferInstance ((Ideal.Quotient.mk 𝔟).comp f) hg'u).unique
      ⟨?_, inferInstance⟩ ⟨rfl, hqloc⟩
    rw [RingHom.comp_assoc, hψ₀f, ← RingHom.comp_assoc, hφι, hcomp1]

  have hqt : Ideal.Quotient.mk 𝔟 t = φ (ψ₀ t) := by
    rw [← hφψ]; rfl
  by_cases h0 : ψ₀ t = 0
  · left
    rw [← Ideal.Quotient.eq_zero_iff_mem, hqt, h0, map_zero]
  · right
    obtain ⟨k, u, hu, hku⟩ := s3 H (ι Polynomial.X) hmaxH (ψ₀ t) h0
    obtain ⟨ε, hε⟩ := Ideal.Quotient.mk_surjective (I := 𝔟) (φ u)
    refine ⟨k, ε, ?_, ?_⟩
    · rw [← isUnit_map_iff (Ideal.Quotient.mk 𝔟), hε]; exact hu.map φ
    · have hx : φ (ι Polynomial.X) = Ideal.Quotient.mk 𝔟 (f (wcEbntX W a 0)) := by
        rw [← hχX, ← hφι]; rfl
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_pow, hε, hqt, hku, map_mul,
        map_pow, hx, sub_self]

theorem wcNd_hens_algebraic : ∀ (A : Type u) [CommRing A] [IsDomain A] (p : Ideal A) (Q : Type u) [CommRing Q] [IsDomain Q] (q : A →+* Q), wcNdIsHens p Q q → ∀ z : Q, ∃ h : Polynomial A, h ≠ 0 ∧ Polynomial.eval₂ q z h = 0 :=
by
  intro A _ _ p Q _ _ q hQ z
  obtain ⟨E, _, _, _, φ, hφ, hF⟩ := wcNd_hne_etale_approx A p Q q hQ {z}
  obtain ⟨y, hy⟩ := hF z (Finset.mem_singleton_self z)
  obtain ⟨c, hc0, hc⟩ := wcNd_hne_etale_algebraic A E y
  refine ⟨c, hc0, ?_⟩
  have e := Polynomial.hom_eval₂ c (algebraMap A E) φ y
  rw [hφ, hy] at e
  rw [← e, ← Polynomial.aeval_def, hc, map_zero]

theorem wcpa_dj_lr1k_ebnt_bbd_kaplansky : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [IsIntegrallyClosed R] (p q : R) (n k : ℕ) (d : ℕ → R), k ≤ n → IsUnit (d k) → ∑ i ∈ Finset.range (n + 1), d i * p ^ i * q ^ (n - i) = 0 → q ∣ p ∨ p ∣ q :=
by
  intro R _ _ _ _ p q n k d hk hu hrel
  classical
  have hinj : Function.Injective (algebraMap R (FractionRing R)) :=
    IsFractionRing.injective R (FractionRing R)

  have hlead : ∀ (t : FractionRing R) (N : ℕ) (e : ℕ → R),
      ∑ i ∈ Finset.range (N + 2), algebraMap R (FractionRing R) (e i) * t ^ i = 0 →
      ∃ r : R, algebraMap R (FractionRing R) r = algebraMap R (FractionRing R) (e (N + 1)) * t := by
    intro t N e h
    set φ := algebraMap R (FractionRing R) with hφ
    set a := e (N + 1) with ha
    set S : Polynomial R := ∑ i ∈ Finset.range (N + 1),
      Polynomial.C (e i * a ^ (N - i)) * Polynomial.X ^ i with hS
    have hSdeg : S.degree < ((N + 1 : ℕ) : WithBot ℕ) := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      rw [hS, Polynomial.finset_sum_coeff]
      apply Finset.sum_eq_zero
      intro i hi
      have hi' : i < N + 1 := Finset.mem_range.mp hi
      rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
    have hmon : (Polynomial.X ^ (N + 1) + S).Monic := Polynomial.monic_X_pow_add hSdeg
    have hev : Polynomial.eval₂ φ (φ a * t) (Polynomial.X ^ (N + 1) + S) = 0 := by
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, hS, Polynomial.eval₂_finset_sum]
      rw [Finset.sum_range_succ] at h
      have hterm : ∀ i ∈ Finset.range (N + 1),
          Polynomial.eval₂ φ (φ a * t) (Polynomial.C (e i * a ^ (N - i)) * Polynomial.X ^ i) =
            φ a ^ N * (φ (e i) * t ^ i) := by
        intro i hi
        have hi' : i ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, map_mul, map_pow,
          mul_pow, ← pow_mul_pow_sub (φ a) hi']
        ring
      rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum]
      calc (φ a * t) ^ (N + 1) + φ a ^ N * ∑ i ∈ Finset.range (N + 1), φ (e i) * t ^ i
          = φ a ^ N * (∑ i ∈ Finset.range (N + 1), φ (e i) * t ^ i + φ (e (N + 1)) * t ^ (N + 1)) := by
            rw [ha]; ring
        _ = 0 := by rw [h, mul_zero]
    have hint : IsIntegral R (φ a * t) := ⟨_, hmon, hev⟩
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
    exact ⟨r, hr⟩

  have hdesc : ∀ (t : FractionRing R) (N k : ℕ) (e : ℕ → R), k ≤ N → IsUnit (e k) →
      ∑ i ∈ Finset.range (N + 1), algebraMap R (FractionRing R) (e i) * t ^ i = 0 →
      (∃ a : R, algebraMap R (FractionRing R) a = t) ∨
        (∃ b : R, algebraMap R (FractionRing R) b * t = 1) := by
    intro t N
    induction N with
    | zero =>
      intro k e hk hu h
      have hk0 : k = 0 := by omega
      rw [hk0] at hu
      rw [Finset.sum_range_one, pow_zero, mul_one] at h
      have he0 : e 0 = 0 := hinj (by rw [h, map_zero])
      rw [he0] at hu
      exact absurd hu not_isUnit_zero
    | succ N ih =>
      intro k e hk hu h
      obtain ⟨r, hr⟩ := hlead t N e h
      by_cases hN : IsUnit (e (N + 1))
      · left
        obtain ⟨u, hu'⟩ := hN
        refine ⟨↑u⁻¹ * r, ?_⟩
        rw [map_mul, hr, ← hu', ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
      · have hkN : k ≤ N := by
          by_contra hcon
          have hk1 : k = N + 1 := by omega
          rw [hk1] at hu
          exact hN hu
        set e' : ℕ → R := Function.update e N (e N + r) with he'
        have h' : ∑ i ∈ Finset.range (N + 1), algebraMap R (FractionRing R) (e' i) * t ^ i = 0 := by
          rw [← h, Finset.sum_range_succ, Finset.sum_range_succ _ (N + 1), Finset.sum_range_succ]
          have hsame : ∑ i ∈ Finset.range N, algebraMap R (FractionRing R) (e' i) * t ^ i =
              ∑ i ∈ Finset.range N, algebraMap R (FractionRing R) (e i) * t ^ i := by
            refine Finset.sum_congr rfl (fun i hi => ?_)
            have hi' : i < N := Finset.mem_range.mp hi
            rw [he', Function.update_of_ne (by omega)]
          rw [hsame, he', Function.update_self, map_add, hr]
          ring
        rcases Nat.lt_or_ge k N with hlt | hge
        · apply ih k e' (by omega) _ h'
          rw [he', Function.update_of_ne (by omega)]
          exact hu
        · have hkN' : k = N := by omega
          rw [hkN'] at hu
          by_cases hU : IsUnit (e N + r)
          · apply ih N e' le_rfl _ h'
            rw [he', Function.update_self]
            exact hU
          · right
            have h2 : IsUnit (e N + r) ∨ IsUnit (-r) :=
              IsLocalRing.isUnit_or_isUnit_of_isUnit_add (by rwa [add_neg_cancel_right])
            have hr' : IsUnit r := by
              rcases h2 with h3 | h3
              · exact absurd h3 hU
              · simpa using h3.neg
            obtain ⟨v, hv⟩ := hr'
            refine ⟨e (N + 1) * ↑v⁻¹, ?_⟩
            rw [map_mul, mul_comm (algebraMap R (FractionRing R) (e (N + 1))), mul_assoc, ← hr,
              ← hv, ← map_mul, Units.inv_mul, map_one]

  by_cases hq : q = 0
  · right
    rw [hq]
    exact dvd_zero p
  set φ := algebraMap R (FractionRing R) with hφ
  have hφq : φ q ≠ 0 := fun h0 => hq (hinj (by rw [h0, map_zero]))
  set t : FractionRing R := φ p / φ q with ht
  have htq : t * φ q = φ p := div_mul_cancel₀ _ hφq
  have hrelK : ∑ i ∈ Finset.range (n + 1), φ (d i) * t ^ i = 0 := by
    have h1 := congrArg φ hrel
    rw [map_sum, map_zero] at h1
    have h2 : φ q ^ n * ∑ i ∈ Finset.range (n + 1), φ (d i) * t ^ i =
        ∑ i ∈ Finset.range (n + 1), φ (d i * p ^ i * q ^ (n - i)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      rw [map_mul, map_mul, map_pow, map_pow, ← pow_mul_pow_sub (φ q) hi', ← htq]
      ring
    rw [h1] at h2
    exact (mul_eq_zero.mp h2).resolve_left (pow_ne_zero _ hφq)
  rcases hdesc t n k d hk hu hrelK with ⟨a, ha⟩ | ⟨b, hb⟩
  · left
    refine ⟨a, ?_⟩
    apply hinj
    rw [map_mul]
    linear_combination (-(φ q)) * ha - htq
  · right
    refine ⟨b, ?_⟩
    apply hinj
    rw [map_mul, ← htq]
    linear_combination (-(φ q)) * hb

theorem wcpa_dj_lr1k_ebnt_bbd_clear_x1 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (b : ↥W) (n : ℕ) (e : ℕ → (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})), ∃ (M : ℕ) (P : ℕ → Polynomial ↥W), ∀ i ≤ n, (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.X 0)) ^ M * e i = Polynomial.eval₂ ((Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b : MvPolynomial (Fin 2) ↥W)})).comp MvPolynomial.C) (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b : MvPolynomial (Fin 2) ↥W)}) (MvPolynomial.X 0)) (P i) :=
by
  intro Ω _ W b n e
  classical
  set mk := Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 -
    MvPolynomial.C b : MvPolynomial (Fin 2) ↥W)}) with hmk
  set x := mk (MvPolynomial.X 0) with hx
  set φ := mk.comp MvPolynomial.C with hφ
  have hK : x * mk (MvPolynomial.X 1) = φ b := by
    rw [hx, hφ, RingHom.comp_apply, ← map_mul]
    exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hmul : ∀ A B : Polynomial ↥W, Polynomial.eval₂ φ x (A * B) =
      Polynomial.eval₂ φ x A * Polynomial.eval₂ φ x B := fun A B =>
    Polynomial.eval₂_mul φ x
  have hS : ∀ p : MvPolynomial (Fin 2) ↥W, ∃ (M : ℕ) (P : Polynomial ↥W),
      x ^ M * mk p = Polynomial.eval₂ φ x P := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C c =>
      refine ⟨0, Polynomial.C c, ?_⟩
      rw [pow_zero, one_mul, Polynomial.eval₂_C, hφ, RingHom.comp_apply]
    | add p q hp hq =>
      obtain ⟨M₁, P₁, h₁⟩ := hp
      obtain ⟨M₂, P₂, h₂⟩ := hq
      refine ⟨M₁ + M₂, Polynomial.X ^ M₂ * P₁ + Polynomial.X ^ M₁ * P₂, ?_⟩
      rw [Polynomial.eval₂_add, hmul, hmul,
        Polynomial.eval₂_X_pow, Polynomial.eval₂_X_pow, ← h₁, ← h₂, map_add]
      ring
    | mul_X p i hp =>
