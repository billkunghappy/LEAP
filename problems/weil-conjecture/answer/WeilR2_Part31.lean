      haveI hloc := hV.isLocalization_stalk ⟨w, hwV⟩
      letI := TopCat.Presheaf.algebra_section_stalk (Limits.pullback u₁ (Spec.map
        (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf
        (⟨w, hwV⟩ : V)
      refine ⟨IsLocalRing.ResidueField ↥W, inferInstance, inferInstance, _, inferInstance,
        inferInstance, inferInstance, (Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).presheaf.germ V w hwV |>.hom, ?_⟩
      intro o
      obtain ⟨⟨a, s⟩, hos⟩ := IsLocalization.mk'_surjective
        (hV.primeIdealOf ⟨w, hwV⟩).asIdeal.primeCompl o
      refine ⟨a, s, IsLocalization.map_units _ s, ?_⟩
      rw [← hos]
      exact IsLocalization.mk'_spec _ a s
  obtain ⟨O, _, _, τ, hτ, hdimO, hker₁, k, _, _, D₀, _, _, _, θ₀, hθ₀⟩ :=
    s1 (g v₂) (g v') hsp₁ hcl

  have hcat : g.stalkMap v₂ ≫ U.toScheme.presheaf.stalkSpecializes hsp ≫ U.toScheme.residue v' =
      X₁.presheaf.stalkSpecializes hsp₁ ≫ X₁.residue (g v') ≫ g.residueFieldMap v' := by
    rw [Scheme.residue_residueFieldMap, ← Category.assoc,
      ← Scheme.Hom.stalkSpecializes_stalkMap g v' v₂ hsp, Category.assoc]
  set φ : ↥(X₁.presheaf.stalk (g v₂)) →+* ↥(U.toScheme.residueField v') :=
    (U.toScheme.presheaf.stalkSpecializes hsp ≫ U.toScheme.residue v').hom.comp
      (g.stalkMap v₂).hom with hφdef
  have heq : ∀ a, φ a = (g.residueFieldMap v').hom
      ((X₁.presheaf.stalkSpecializes hsp₁ ≫ X₁.residue (g v')).hom a) := by
    intro a
    show (g.stalkMap v₂ ≫ U.toScheme.presheaf.stalkSpecializes hsp ≫ U.toScheme.residue v').hom a =
      (X₁.presheaf.stalkSpecializes hsp₁ ≫ X₁.residue (g v') ≫ g.residueFieldMap v').hom a
    rw [hcat]
  have hker : ∀ a, τ a = 0 → φ a = 0 := by
    intro a ha
    rw [heq a, hker₁ a ha, map_zero]

  have hkerle : RingHom.ker τ ≤ RingHom.ker φ := fun a ha => hker a ha
  let φb : O →+* ↥(U.toScheme.residueField v') := (RingHom.liftOfSurjective τ hτ) ⟨φ, hkerle⟩
  have hφb : ∀ a, φb (τ a) = φ a := fun a =>
    RingHom.liftOfSurjective_comp_apply τ hτ ⟨φ, hkerle⟩ a
  let ρ : O →+* ↥φ.range := φb.codRestrict φ.range (fun o => by
    obtain ⟨a, rfl⟩ := hτ o
    exact RingHom.mem_range.mpr ⟨a, (hφb a).symm⟩)
  have hρ : Function.Surjective ρ := by
    rintro ⟨y, hy⟩
    obtain ⟨a, rfl⟩ := RingHom.mem_range.mp hy
    exact ⟨τ a, Subtype.ext (hφb a)⟩
  have hnoeth : IsNoetherianRing ↥φ.range := isNoetherianRing_of_surjective O _ ρ hρ
  have hdimR : ringKrullDim ↥φ.range ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    (ringKrullDim_le_of_surjective ρ hρ).trans hdimO
  let θ : D₀ →+* ↥(U.toScheme.residueField v') := φb.comp θ₀
  have hθ₁ : ∀ d, ∃ a, φ a = θ d := by
    intro d
    obtain ⟨a, ha⟩ := hτ (θ₀ d)
    refine ⟨a, ?_⟩
    rw [← hφb, ha]
    rfl
  have hθ₂ : ∀ a, ∃ d e : D₀, θ e ≠ 0 ∧ (∃ b, φ b * θ e = 1) ∧ φ a * θ e = θ d := by
    intro a
    obtain ⟨d, e, hu, he⟩ := hθ₀ (τ a)
    obtain ⟨u, hu'⟩ := hu.exists_left_inv
    obtain ⟨b, hb⟩ := hτ u
    have h1 : φ b * θ e = 1 := by
      rw [← hφb, hb]
      show φb u * φb (θ₀ e) = 1
      rw [← map_mul, hu', map_one]
    refine ⟨d, e, fun h0 => ?_, ⟨b, h1⟩, ?_⟩
    · rw [h0, mul_zero] at h1
      exact zero_ne_one h1
    · rw [← hφb]
      show φb (τ a) * φb (θ₀ e) = φb (θ₀ d)
      rw [← map_mul, he]

  have hfrac : ∀ x : ↥(U.toScheme.residueField v'), ∃ d e : D₀, θ e ≠ 0 ∧ x * θ e = θ d := by
    intro x
    obtain ⟨a, c, hc0, hxc⟩ := hbir x
    change φ c ≠ 0 at hc0
    change x * φ c = φ a at hxc
    obtain ⟨d₁, e₁, he₁0, -, h₁⟩ := hθ₂ a
    obtain ⟨d₂, e₂, he₂0, -, h₂⟩ := hθ₂ c
    refine ⟨d₁ * e₂, e₁ * d₂, ?_, ?_⟩
    · rw [map_mul, ← h₂]
      exact mul_ne_zero he₁0 (mul_ne_zero hc0 he₂0)
    · rw [map_mul, map_mul, ← h₂, ← h₁]
      linear_combination (θ e₁ * θ e₂) * hxc

  have s4 : ∀ (k K D₀ : Type u) [Field k] [PerfectField k] [Field K]
      [CommRing D₀] [Algebra k D₀] [Algebra.FiniteType k D₀] (θ : D₀ →+* K),
      (∀ x : K, ∃ d e : D₀, θ e ≠ 0 ∧ x * θ e = θ d) →
      Module.Finite ↥θ.range ↥(integralClosure (↥θ.range) K) := by
    intro k K D₀ _ _ _ _ _ _ θ hfr
    letI : Algebra k ↥θ.range := (θ.rangeRestrict.comp (algebraMap k D₀)).toAlgebra
    let φa : D₀ →ₐ[k] ↥θ.range :=
      { θ.rangeRestrict with commutes' := fun r => rfl }
    haveI : Algebra.FiniteType k ↥θ.range :=
      Algebra.FiniteType.of_surjective φa θ.rangeRestrict_surjective
    haveI hN := noether_integralClosure_finite k ↥θ.range
    haveI : FaithfulSMul ↥θ.range K :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr Subtype.val_injective
    haveI : IsFractionRing ↥θ.range K := by
      apply IsFractionRing.of_field
      intro z
      obtain ⟨d, e, he, hz⟩ := hfr z
      refine ⟨⟨θ d, RingHom.mem_range_self θ d⟩, ⟨θ e, RingHom.mem_range_self θ e⟩, ?_⟩
      show z = θ d / θ e
      rw [eq_div_iff he, hz]
    let ε : FractionRing ↥θ.range ≃ₐ[↥θ.range] K :=
      IsLocalization.algEquiv (nonZeroDivisors ↥θ.range) (FractionRing ↥θ.range) K
    have hmap := integralClosure_map_algEquiv (R := ↥θ.range) ε
    let e1 := (AlgEquiv.subalgebraMap ε
      (integralClosure (↥θ.range) (FractionRing ↥θ.range))).trans (Subalgebra.equivOfEq _ _ hmap)
    exact Module.Finite.equiv e1.toLinearEquiv
  have hfinD := s4 k _ D₀ θ hfrac

  have s5 : ∀ (A K : Type u) [CommRing A] [Field K]
      (φ : A →+* K) (D : Subring K), (∀ d ∈ D, ∃ a : A, φ a = d) →
      (∀ a : A, ∃ d ∈ D, ∃ e ∈ D, e ≠ 0 ∧ (∃ b : A, φ b * e = 1) ∧ φ a * e = d) →
      Module.Finite ↥D ↥(integralClosure (↥D) K) →
      ∃ (n : ℕ) (f : Fin n → K), (∀ i, φ.IsIntegralElem (f i)) ∧
        ∀ x, φ.IsIntegralElem x → ∃ c : Fin n → A, x = ∑ i, φ (c i) * f i := by
    intro A K _ _ φ D h1 h2 hfin
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := ↥D) (M := ↥(integralClosure (↥D) K))
    refine ⟨n, fun i => ((s i : ↥(integralClosure (↥D) K)) : K), ?_, ?_⟩
    · intro i
      have hi : IsIntegral (↥D) ((s i : ↥(integralClosure (↥D) K)) : K) := (s i).2
      obtain ⟨p, hpm, hp⟩ := hi
      have hlift : p.map D.subtype ∈ Polynomial.lifts φ := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro j
        rw [Polynomial.coeff_map]
        exact h1 _ (p.coeff j).2
      obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift (hpm.map _)
      refine ⟨q, hqm, ?_⟩
      rw [← Polynomial.eval_map, hq, Polynomial.eval_map]
      exact hp
    · have hcd : ∀ S : Finset A, ∃ s ∈ D, ∃ t : A, φ t * s = 1 ∧ ∀ a ∈ S, s * φ a ∈ D := by
        intro S
        induction S using Finset.induction_on with
        | empty => exact ⟨1, D.one_mem, 1, by simp, by simp⟩
        | insert a S ha ih =>
          obtain ⟨s, hsD, t, hts, hS⟩ := ih
          obtain ⟨d, hdD, e, heD, -, ⟨b, hb⟩, hae⟩ := h2 a
          refine ⟨s * e, D.mul_mem hsD heD, t * b, ?_, ?_⟩
          · rw [map_mul]
            linear_combination (φ b * e) * hts + hb
          · intro x hx
            rcases Finset.mem_insert.mp hx with rfl | hx
            · have e1 : s * e * φ x = s * d := by rw [← hae]; ring
              rw [e1]
              exact D.mul_mem hsD hdD
            · have e1 : s * e * φ x = (s * φ x) * e := by ring
              rw [e1]
              exact D.mul_mem (hS x hx) heD
      intro x hx
      obtain ⟨p, hpm, hp⟩ := hx
      set N := p.natDegree with hN
      obtain ⟨σ, hσD, t, hts, hS⟩ := hcd ((Finset.range N).image p.coeff)
      have hPdeg : (p.map φ).natDegree = N := hpm.natDegree_map φ
      have hcoef : ∀ j, φ (p.coeff j) * σ ^ (N - j) ∈ D := by
        intro j
        rcases lt_trichotomy j N with hj | hj | hj
        · have hm := hS (p.coeff j) (Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr hj, rfl⟩)
          have e1 : φ (p.coeff j) * σ ^ (N - j) = (σ * φ (p.coeff j)) * σ ^ (N - j - 1) := by
            obtain ⟨m, hm'⟩ : ∃ m, N - j = m + 1 := ⟨N - j - 1, by omega⟩
            rw [hm', show m + 1 - 1 = m by omega, pow_succ]
            ring
          rw [e1]
          exact D.mul_mem hm (D.pow_mem hσD _)
        · subst hj
          have : p.coeff p.natDegree = 1 := hpm.coeff_natDegree
          rw [this, map_one, Nat.sub_self, pow_zero, one_mul]
          exact D.one_mem
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hj, map_zero, zero_mul]
          exact D.zero_mem
      have hQlift : (p.map φ).scaleRoots σ ∈ Polynomial.lifts D.subtype := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro j
        rw [Polynomial.coeff_scaleRoots, Polynomial.coeff_map, hPdeg]
        exact ⟨⟨_, hcoef j⟩, rfl⟩
      have hQm : ((p.map φ).scaleRoots σ).Monic :=
        (Polynomial.monic_scaleRoots_iff σ).mpr (hpm.map φ)
      obtain ⟨Q', hQ', -, hQ'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hQlift hQm
      have hroot : Polynomial.eval₂ (RingHom.id K) ((RingHom.id K) σ * x)
          ((p.map φ).scaleRoots σ) = 0 := by
        apply Polynomial.scaleRoots_eval₂_eq_zero
        rw [Polynomial.eval₂_map, RingHom.id_comp]
        exact hp
      rw [← hQ', Polynomial.eval₂_map, RingHom.id_comp, RingHom.id_apply] at hroot
      have hint : IsIntegral (↥D) (σ * x) := ⟨Q', hQ'm, hroot⟩
      have hmem : (⟨σ * x, hint⟩ : ↥(integralClosure (↥D) K)) ∈
          Submodule.span (↥D) (Set.range s) := by rw [hs]; exact Submodule.mem_top
      obtain ⟨c', hc'⟩ := (Submodule.mem_span_range_iff_exists_fun (↥D)).mp hmem
      have hc'K : σ * x = ∑ i, (c' i : K) * ((s i : ↥(integralClosure (↥D) K)) : K) := by
        have := congrArg (fun m : ↥(integralClosure (↥D) K) => (m : K)) hc'
        simp only at this
        rw [← this]
        push_cast
        rfl
      choose a ha using fun i => h1 (c' i) (c' i).2
      refine ⟨fun i => t * a i, ?_⟩
      simp only [map_mul, ha]
      calc x = (φ t * σ) * x := by rw [hts, one_mul]
        _ = φ t * (σ * x) := by ring
        _ = _ := by rw [hc'K, Finset.mul_sum]; refine Finset.sum_congr rfl (fun i _ => by ring)
  obtain ⟨n, f, hf1, hf2⟩ := s5 _ _ φ θ.range
    (fun d hd => by
      obtain ⟨d₀, rfl⟩ := RingHom.mem_range.mp hd
      exact hθ₁ d₀)
    (fun a => by
      obtain ⟨d, e, he0, hb, hde⟩ := hθ₂ a
      exact ⟨θ d, RingHom.mem_range_self θ d, θ e, RingHom.mem_range_self θ e, he0, hb, hde⟩)
    hfinD
  exact ⟨hnoeth, hdimR, n, f, hf1, hf2⟩

theorem wcpa_dj_lr1k_ebntbp_branch_valuation : ∀ (A₁ A₂ K : Type u) [CommRing A₁] [IsLocalRing A₁]
    [CommRing A₂] [IsLocalRing A₂] [Field K] (ψ : A₁ →+* A₂), IsLocalHom ψ →
    ∀ (μ : A₂ →+* K), (∃ s₁ ∈ IsLocalRing.maximalIdeal A₁, μ (ψ s₁) ≠ 0) →
    (∀ k : K, ∃ a c : A₁, μ (ψ c) ≠ 0 ∧ k * μ (ψ c) = μ (ψ a)) →
    IsNoetherianRing ↥((μ.comp ψ).range) →
    ringKrullDim ↥((μ.comp ψ).range) ≤ ((1 : ℕ) : WithBot ℕ∞) →
    (∃ (n : ℕ) (f : Fin n → K), (∀ i, (μ.comp ψ).IsIntegralElem (f i)) ∧
      ∀ k, (μ.comp ψ).IsIntegralElem k → ∃ c : Fin n → A₁, k = ∑ i, μ (ψ (c i)) * f i) →
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A₁ B) (n : Ideal B) (hn : n.IsMaximal)
      (V : Type u) (_ : CommRing V) (_ : IsDomain V) (_ : IsIntegrallyClosed V)
      (β : B →+* V) (lm : A₂ →+* V),
      Module.Finite A₁ B ∧
      @IsLocalization B _ (@Ideal.primeCompl B _ n hn.isPrime) V _ β.toAlgebra ∧
      (∀ a, IsUnit (lm a) ↔ a ∉ IsLocalRing.maximalIdeal A₂) ∧
      β.comp (algebraMap A₁ B) = lm.comp ψ ∧
      (∀ b : B, ∃ a c : A₁, lm (ψ c) ≠ 0 ∧ β b * lm (ψ c) = lm (ψ a)) ∧
      (∀ a : A₂, lm a = 0 ↔ μ a = 0) :=
by
  intro A₁ A₂ K _ _ _ _ _ ψ hψ μ hs₁ hfrac hnoeth hdim hfin
  classical

  obtain ⟨V₀, hV, hU⟩ : ∃ (V₀ : ValuationSubring K) (hV : ∀ a, μ a ∈ V₀),
      ∀ a, IsUnit (μ.codRestrict V₀ hV a) ↔ a ∉ IsLocalRing.maximalIdeal A₂ := by
    obtain ⟨V₀, hle⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.range μ)
    obtain ⟨h, hloc⟩ := LocalSubring.le_def.mp hle
    have hmem : ∀ a, μ a ∈ (LocalSubring.range μ).toSubring := fun a => by
      rw [LocalSubring.range_toSubring]; exact RingHom.mem_range_self μ a
    have hV : ∀ a, μ a ∈ V₀ := fun a => h (hmem a)
    refine ⟨V₀, hV, fun a => ⟨fun hu ha => ?_, fun ha => ?_⟩⟩
    · have hu' : IsUnit (Subring.inclusion h ⟨μ a, hmem a⟩) := hu
      have hu'' : IsUnit (⟨μ a, hmem a⟩ : ↥(LocalSubring.range μ).toSubring) :=
        IsLocalHom.map_nonunit _ hu'
      obtain ⟨w, hw⟩ := hu''.exists_right_inv
      have h2 : ∀ x ∈ (LocalSubring.range μ).toSubring, x ∈ μ.range := by
        rw [LocalSubring.range_toSubring]; exact fun x hx => hx
      have hw2 : (w : K) ∈ μ.range := h2 _ w.2
      obtain ⟨b, hb⟩ := hw2
      have h1 : μ a * μ b = 1 := by
        rw [hb]; exact congrArg Subtype.val hw
      have hab : a * b ∈ IsLocalRing.maximalIdeal A₂ := Ideal.mul_mem_right b _ ha
      have hunit := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
        ((IsLocalRing.mem_maximalIdeal _).mp hab)
      apply (hunit.map μ).ne_zero
      rw [map_sub, map_one, map_mul, h1, sub_self]
    · exact (IsLocalRing.notMem_maximalIdeal.mp ha).map (μ.codRestrict V₀ hV)
  set φ : A₁ →+* K := μ.comp ψ with hφdef
  set R : Subring K := φ.range with hRdef
  have hcomp : (algebraMap R K).comp φ.rangeRestrict = φ := RingHom.ext fun _ => rfl
  have hRV : ∀ x ∈ R, x ∈ V₀ := by
    rintro x ⟨a, rfl⟩; exact hV (ψ a)

  have hint1 : ∀ x : K, φ.IsIntegralElem x → IsIntegral R x := by
    rintro x ⟨p, hpm, hp⟩
    refine ⟨p.map φ.rangeRestrict, hpm.map _, ?_⟩
    rw [Polynomial.eval₂_map, hcomp]; exact hp
  have hint2 : ∀ x : K, IsIntegral R x → φ.IsIntegralElem x := by
    rintro x ⟨q, hqm, hq⟩
    obtain ⟨p, hpq, -, hpm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts q).mpr
        (Polynomial.map_surjective _ φ.rangeRestrict_surjective q)) hqm
    refine ⟨p, hpm, ?_⟩
    rw [← hcomp, ← Polynomial.eval₂_map, hpq]; exact hq

  obtain ⟨nf, f, hfi, hfs⟩ := hfin
  haveI hRfin : Module.Finite R (integralClosure R K) := by
    let g : Fin nf → integralClosure R K := fun i => ⟨f i, hint1 _ (hfi i)⟩
    refine ⟨⟨Finset.univ.image g, ?_⟩⟩
    rw [eq_top_iff]
    rintro k -
    obtain ⟨c, hc⟩ := hfs k (hint2 k ((mem_integralClosure_iff _ _).mp k.2))
    have hk : k = ∑ i, φ.rangeRestrict (c i) • g i := by
      apply Subtype.ext
      rw [hc, AddSubmonoidClass.coe_finsetSum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rfl
    rw [hk]
    refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_)
    simp

  haveI hfr : IsFractionRing (integralClosure R K) K := by
    unfold IsFractionRing
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, hy⟩
      exact isUnit_iff_ne_zero.mpr (fun h => nonZeroDivisors.ne_zero hy (Subtype.ext h))
    · intro z
      obtain ⟨a, c, hc, hz⟩ := hfrac z
      refine ⟨(algebraMap R (integralClosure R K) (φ.rangeRestrict a),
        ⟨algebraMap R (integralClosure R K) (φ.rangeRestrict c),
          mem_nonZeroDivisors_of_ne_zero (fun h => hc (congrArg Subtype.val h))⟩), ?_⟩
      exact hz
    · intro x y h
      have hxy : x = y := Subtype.ext h
      exact ⟨1, by rw [hxy]⟩
  haveI : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr hdim
  haveI hR1 : Ring.DimensionLEOne R := ⟨fun hp hpp => hpp.isMaximal_of_ne_bot hp⟩
  haveI : Ring.DimensionLEOne (integralClosure R K) := Ring.DimensionLEOne.integralClosure R K
  haveI : IsNoetherianRing (integralClosure R K) := IsNoetherianRing.of_finite R _
  haveI hded : IsDedekindDomain (integralClosure R K) := by
    rw [isDedekindDomain_iff _ K]
    refine ⟨inferInstance, inferInstance, inferInstance, fun {x} hx => ?_⟩
    exact ⟨⟨x, isIntegral_trans x hx⟩, rfl⟩

  have hBV : ∀ b : integralClosure R K, algebraMap (integralClosure R K) K b ∈ V₀ := by
    intro b
    obtain ⟨p, hpm, hp⟩ := (mem_integralClosure_iff _ _).mp b.2
    let incl : R →+* V₀ := (algebraMap R K).codRestrict V₀ (fun r => hRV _ r.2)
    have hincl : (algebraMap V₀ K).comp incl = algebraMap R K := RingHom.ext fun _ => rfl
    have hint : IsIntegral V₀ (b : K) := by
      refine ⟨p.map incl, hpm.map _, ?_⟩
      rw [Polynomial.eval₂_map, hincl]; exact hp
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    show (b : K) ∈ V₀
    rw [← hy]; exact y.2
  set β : integralClosure R K →+* V₀ := (algebraMap (integralClosure R K) K).codRestrict V₀ hBV
    with hβdef
  set lm : A₂ →+* V₀ := μ.codRestrict V₀ hV with hlmdef
  set n : Ideal (integralClosure R K) := Ideal.comap β (IsLocalRing.maximalIdeal V₀) with hndef
  have hn0 : n ≠ ⊥ := by
    obtain ⟨s₁, hs₁m, hs₁⟩ := hs₁
    intro hbot
    have hψs : ψ s₁ ∈ IsLocalRing.maximalIdeal A₂ := by
      by_contra hc
      have hu := IsLocalHom.map_nonunit s₁ (IsLocalRing.notMem_maximalIdeal.mp hc)
      exact ((IsLocalRing.mem_maximalIdeal _).mp hs₁m) hu
    have ht : algebraMap R (integralClosure R K) (φ.rangeRestrict s₁) ∈ n := by
      show β _ ∈ IsLocalRing.maximalIdeal V₀
      have : β (algebraMap R _ (φ.rangeRestrict s₁)) = lm (ψ s₁) := Subtype.ext rfl
      rw [this, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hU, not_not]
      exact hψs
    rw [hbot] at ht
    exact hs₁ (congrArg Subtype.val (Ideal.mem_bot.mp ht))
  haveI hnp : n.IsPrime := Ideal.comap_isPrime β _
  have hn : n.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hn0 hnp

  have hloc : @IsLocalization _ _ (@Ideal.primeCompl _ _ n hn.isPrime) V₀ _ β.toAlgebra := by
    letI : Algebra (integralClosure R K) V₀ := β.toAlgebra
    haveI : IsDomain (Localization.AtPrime n) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors n)
    haveI : IsDiscreteValuationRing (Localization.AtPrime n) :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain _ hn0 _
    haveI : ValuationRing (Localization.AtPrime n) := inferInstance
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨s, hs⟩
      exact IsLocalRing.notMem_maximalIdeal.mp hs
    · intro v
      obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective (A := integralClosure R K) (v : K)
      have hy0 : algebraMap (integralClosure R K) K y ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy
      obtain ⟨c, hc⟩ : ∃ c : Localization.AtPrime n,
          algebraMap _ (Localization.AtPrime n) x * c = algebraMap _ (Localization.AtPrime n) y ∨
          algebraMap _ (Localization.AtPrime n) y * c = algebraMap _ (Localization.AtPrime n) x := by
        rcases ValuationRing.dvd_total (algebraMap _ (Localization.AtPrime n) x)
          (algebraMap _ (Localization.AtPrime n) y) with ⟨c, hc⟩ | ⟨c, hc⟩
        · exact ⟨c, Or.inl hc.symm⟩
        · exact ⟨c, Or.inr hc.symm⟩
      obtain ⟨⟨b, ⟨s, hsn⟩⟩, hbs⟩ := IsLocalization.surj n.primeCompl c
      dsimp only at hbs
      have hinj := IsLocalization.injective (Localization.AtPrime n) (Ideal.primeCompl_le_nonZeroDivisors n)
      rcases hc with hc | hc
      · have e : x * b = y * s := by
          apply hinj
          rw [map_mul, map_mul, ← hbs, ← mul_assoc, hc]
        have e' := congrArg (algebraMap (integralClosure R K) K) e
        simp only [map_mul] at e'
        have eK : (v : K) * algebraMap _ K b = algebraMap _ K s := by
          rw [← hxy, div_mul_eq_mul_div, div_eq_iff hy0]
          linear_combination e'
        by_cases hb : b ∈ n
        · exfalso
          have h1 : β s ∈ IsLocalRing.maximalIdeal V₀ := by
            have : β s = v * β b := Subtype.ext eK.symm
            rw [this]; exact Ideal.mul_mem_left _ _ hb
          exact hsn h1
        · exact ⟨(s, ⟨b, hb⟩), Subtype.ext eK⟩
      · have e : y * b = x * s := by
          apply hinj
          rw [map_mul, map_mul, ← hbs, ← mul_assoc, hc]
        have e' := congrArg (algebraMap (integralClosure R K) K) e
        simp only [map_mul] at e'
        have eK : (v : K) * algebraMap _ K s = algebraMap _ K b := by
          rw [← hxy, div_mul_eq_mul_div, div_eq_iff hy0]
          linear_combination -e'
        exact ⟨(b, ⟨s, hsn⟩), Subtype.ext eK⟩
    · intro x y h
      have h' : ((algebraMap _ V₀ x : V₀) : K) = ((algebraMap _ V₀ y : V₀) : K) :=
        congrArg Subtype.val h
      have hxy : x = y := Subtype.ext h'
      exact ⟨1, by rw [hxy]⟩

  letI alg : Algebra A₁ (integralClosure R K) :=
    ((algebraMap R (integralClosure R K)).comp φ.rangeRestrict).toAlgebra
  have hfinA : Module.Finite A₁ (integralClosure R K) := by
    have h1 : (algebraMap R (integralClosure R K)).Finite := RingHom.finite_algebraMap.mpr hRfin
    have h2 : φ.rangeRestrict.Finite := RingHom.Finite.of_surjective _ φ.rangeRestrict_surjective
    exact h1.comp h2
  refine ⟨integralClosure R K, inferInstance, alg, n, hn, V₀, inferInstance, inferInstance,
    inferInstance, β, lm, hfinA, hloc, hU, ?_, ?_, ?_⟩
  · exact RingHom.ext fun a => Subtype.ext rfl
  · intro b
    obtain ⟨a, c, hc, hk⟩ := hfrac (b : K)
    exact ⟨a, c, fun h => hc (congrArg Subtype.val h), Subtype.ext hk⟩
  · exact fun a => ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩

theorem wcNd_hf_stage_basic : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (E : Type u) [CommRing E] [Algebra A E] [Algebra.Etale A E] (σ : E →ₐ[A] IsLocalRing.ResidueField A) (q : Ideal E) [q.IsPrime], (∀ e : E, e ∈ q ↔ σ e = 0) → Module.Flat A (Localization.AtPrime q) ∧ (∀ a : A, IsUnit (algebraMap A (Localization.AtPrime q) a) ↔ a ∉ IsLocalRing.maximalIdeal A) ∧ ∀ y : Localization.AtPrime q, ∃ a : A, y - algebraMap A (Localization.AtPrime q) a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
by
  intro A _ _ E _ _ _ σ q _ hq
  have s0 : ∀ a : A, σ (algebraMap A E a) = IsLocalRing.residue A a := by
    intro a
    rw [AlgHom.commutes, IsLocalRing.ResidueField.algebraMap_eq]
  refine ⟨?_, ?_, ?_⟩
  · have := IsLocalization.flat (Localization.AtPrime q) q.primeCompl
    exact Module.Flat.trans A E (Localization.AtPrime q)
  · intro a
    rw [IsScalarTower.algebraMap_apply A E (Localization.AtPrime q),
      IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q,
      Ideal.mem_primeCompl_iff, hq, s0, IsLocalRing.residue_eq_zero_iff]
  · intro y
    obtain ⟨⟨e, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
    have hs : σ (s : E) ≠ 0 := fun h => s.2 ((hq _).mpr h)
    obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective (σ e * (σ s)⁻¹)
    refine ⟨a, ?_⟩
    have hx : e - algebraMap A E a * s ∈ q := by
      rw [hq, map_sub, map_mul, s0, ha, inv_mul_cancel_right₀ hs, sub_self]
    have heq : IsLocalization.mk' (Localization.AtPrime q) e s
        - algebraMap A (Localization.AtPrime q) a
        = IsLocalization.mk' (Localization.AtPrime q) (e - algebraMap A E a * s) s := by
      rw [IsLocalization.eq_mk'_iff_mul_eq, sub_mul, IsLocalization.mk'_spec, map_sub, map_mul,
        IsScalarTower.algebraMap_apply A E (Localization.AtPrime q)]
    rw [heq]
    exact (IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime q) q _ _).mpr hx

theorem wcNd_hf_stage_hom_unique : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (E : Type u) [CommRing E] [Algebra A E] [Algebra.Etale A E] (σ : E →ₐ[A] IsLocalRing.ResidueField A) (q : Ideal E) [q.IsPrime], (∀ e : E, e ∈ q ↔ σ e = 0) → ∀ (C : Type u) [CommRing C] [IsLocalRing C] (ψ : Localization.AtPrime q →+* C) (χ : E →+* C), IsLocalHom ψ → (∀ y : E, σ y = 0 → χ y ∈ IsLocalRing.maximalIdeal C) → ψ.comp (algebraMap A (Localization.AtPrime q)) = χ.comp (algebraMap A E) → ψ.comp (algebraMap E (Localization.AtPrime q)) = χ :=
by
  intro A _ _ E _ _ _ σ q _ hq C _ _ ψ χ hψ hχ hA
  letI : Algebra A C := (χ.comp (algebraMap A E)).toAlgebra
  have hAC : ∀ a : A, algebraMap A C a = χ (algebraMap A E a) := fun a => rfl
  have hτc : ∀ a : A, (ψ.comp (algebraMap E (Localization.AtPrime q))) (algebraMap A E a) =
      algebraMap A C a := by
    intro a
    rw [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply A E (Localization.AtPrime q) a, hAC]
    exact RingHom.congr_fun hA a
  let τ : E →ₐ[A] C :=
    { toRingHom := ψ.comp (algebraMap E (Localization.AtPrime q))
      commutes' := hτc }
  let χ' : E →ₐ[A] C :=
    { toRingHom := χ
      commutes' := fun a => (hAC a).symm }
  have hres : ∀ x : E, IsLocalRing.residue C (τ x) = IsLocalRing.residue C (χ' x) := by
    intro y
    obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective (σ y)
    set d := y - algebraMap A E a with hd
    have hσd : σ d = 0 := by
      rw [hd, map_sub, AlgHom.commutes, IsLocalRing.ResidueField.algebraMap_eq, ha, sub_self]
    have h1 : χ d ∈ IsLocalRing.maximalIdeal C := hχ d hσd
    have hdq : d ∈ q := (hq d).mpr hσd
    have h2' : algebraMap E (Localization.AtPrime q) d ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q d).mpr hdq
    have h2 : ψ (algebraMap E (Localization.AtPrime q) d) ∈ IsLocalRing.maximalIdeal C := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      haveI := hψ
      have := isUnit_of_map_unit ψ _ hu
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h2'
      exact h2' this
    have hy : y = d + algebraMap A E a := by rw [hd]; ring
    have hτy : τ y = ψ (algebraMap E (Localization.AtPrime q) d) + algebraMap A C a := by
      conv_lhs => rw [hy]
      rw [map_add, AlgHom.commutes]
      rfl
    have hχy : χ' y = χ d + algebraMap A C a := by
      conv_lhs => rw [hy]
      rw [map_add, AlgHom.commutes]
      rfl
    have hmem : τ y - χ' y ∈ IsLocalRing.maximalIdeal C := by
      rw [hτy, hχy, add_sub_add_right_eq_sub]
      exact Ideal.sub_mem _ h2 h1
    rw [← sub_eq_zero, ← map_sub]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr hmem
  have heq : τ = χ' := wc_hnas_hs_etale_hom_unique_residue A E C τ χ' hres
  exact RingHom.ext fun x => AlgHom.congr_fun heq x

theorem wcNd_hf_stage_lift : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (E : Type u) [CommRing E] [Algebra A E] [Algebra.Etale A E] (σ : E →ₐ[A] IsLocalRing.ResidueField A) (q : Ideal E) [q.IsPrime], (∀ e : E, e ∈ q ↔ σ e = 0) → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] (gA : A →+* C), (∀ a : A, IsUnit (gA a) ↔ a ∉ IsLocalRing.maximalIdeal A) → ∃ h : Localization.AtPrime q →+* C, h.comp (algebraMap A (Localization.AtPrime q)) = gA ∧ IsLocalHom h :=
by
  intro A _ _ E _ _ _ σ q _ hq C _ _ gA hgA
  letI : Algebra A C := gA.toAlgebra
  have halg : algebraMap A C = gA := RingHom.algebraMap_toAlgebra gA
  haveI hloc : IsLocalHom gA := by
    refine ⟨fun a ha => ?_⟩
    have h1 := (hgA a).mp ha
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at h1
    exact h1
  let σC : E →+* IsLocalRing.ResidueField C :=
    (IsLocalRing.ResidueField.map gA).comp (σ : E →+* IsLocalRing.ResidueField A)
  have hcompat : σC.comp (algebraMap A E) = (IsLocalRing.residue C).comp (algebraMap A C) := by
    apply RingHom.ext
    intro a
    simp only [σC, RingHom.comp_apply, RingHom.coe_coe, AlgHom.commutes, halg]
    rw [IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.ResidueField.map_residue]
  have hzero : ∀ e : E, σC e = 0 ↔ σ e = 0 := by
    intro e
    constructor
    · intro h
      by_contra hne
      exact (map_ne_zero (IsLocalRing.ResidueField.map gA)).mpr hne h
    · intro h
      simp only [σC, RingHom.comp_apply, RingHom.coe_coe, h, map_zero]
  obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base A C
    (fun E' _ _ _ σ' => wc_hnas_smooth_section_henselian C E' σ') E σC hcompat
  have hunitE : ∀ e : E, IsUnit (τ e) ↔ e ∉ q := by
    intro e
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hτ, hq]
    exact not_congr (hzero e)
  have hunit : ∀ y : q.primeCompl, IsUnit ((τ : E →+* C) y) := fun y => (hunitE y).mpr y.2
  let h : Localization.AtPrime q →+* C :=
    IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit
  refine ⟨h, ?_, ?_⟩
  · apply RingHom.ext
    intro a
    rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply A E (Localization.AtPrime q) a]
    simp only [h, IsLocalization.lift_eq, RingHom.coe_coe, AlgHom.commutes, halg]
  · refine ⟨fun z hz => ?_⟩
    obtain ⟨⟨e, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime q) e s
    have h2 : h (IsLocalization.mk' (Localization.AtPrime q) e s) * τ s = τ e := by
      have := congrArg h hspec
      simp only [h, map_mul, IsLocalization.lift_eq, RingHom.coe_coe] at this
      exact this
    have h3 : IsUnit (τ e) := by
      rw [← h2]
      exact hz.mul ((hunitE s).mpr s.2)
    rw [IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime q) q]
    exact (hunitE e).mp h3

theorem wcNd_hf_adjoin_simple_root : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (B : Type u) [CommRing B] [Algebra A B] [Algebra.Etale A B] (σB : B →+* IsLocalRing.ResidueField A), σB.comp (algebraMap A B) = IsLocalRing.residue A → ∀ (f : Polynomial B) (t : IsLocalRing.ResidueField A), f.Monic → f.eval₂ σB t = 0 → f.derivative.eval₂ σB t ≠ 0 → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra A E') (_ : Algebra.Etale A E') (σ' : E' →ₐ[A] IsLocalRing.ResidueField A) (ι : B →ₐ[A] E') (x : E'), (σ' : E' →+* IsLocalRing.ResidueField A).comp (ι : B →+* E') = σB ∧ σ' x = t ∧ f.eval₂ (ι : B →+* E') x = 0 :=
by
  intro A _ _ B _ _ _ σB hσB f t hf h0 h1
  let P : StandardEtalePair B :=
    ⟨f, hf, Polynomial.derivative f, ⟨1, 0, 1, by rw [mul_one, mul_zero, add_zero, pow_one]⟩⟩
  letI algA : Algebra A P.Ring := ((algebraMap B P.Ring).comp (algebraMap A B)).toAlgebra
  haveI : IsScalarTower A B P.Ring := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Algebra.Etale A P.Ring := Algebra.Etale.comp A B P.Ring
  let σ₀ : P.Ring →+* IsLocalRing.ResidueField A := by
    letI algBκ : Algebra B (IsLocalRing.ResidueField A) := σB.toAlgebra
    have hP : P.HasMap t := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.aeval_def]; exact h0
      · rw [Polynomial.aeval_def]; exact Ne.isUnit h1
    exact (P.lift t hP).toRingHom
  have hσ₀B : ∀ b : B, σ₀ (algebraMap B P.Ring b) = σB b := by
    intro b
    letI algBκ : Algebra B (IsLocalRing.ResidueField A) := σB.toAlgebra
    exact AlgHom.commutes _ b
  have hσ₀X : σ₀ P.X = t := by
    letI algBκ : Algebra B (IsLocalRing.ResidueField A) := σB.toAlgebra
    exact StandardEtalePair.lift_X _ _ _
  let σ' : P.Ring →ₐ[A] IsLocalRing.ResidueField A :=
    { σ₀ with
      commutes' := fun a => by
        show σ₀ (algebraMap B P.Ring (algebraMap A B a)) = _
        rw [hσ₀B, IsLocalRing.ResidueField.algebraMap_eq]
        exact RingHom.congr_fun hσB a }
  refine ⟨P.Ring, inferInstance, algA, inferInstance, σ', IsScalarTower.toAlgHom A B P.Ring,
    P.X, ?_, ?_, ?_⟩
  · ext b
    exact hσ₀B b
  · exact hσ₀X
  · have := (StandardEtalePair.hasMap_X (P := P)).1
    rw [Polynomial.aeval_def] at this
    exact this

theorem wcNd_hf_stage_hensel_step : (∀ (A : Type u) [CommRing A] [IsLocalRing A] (B : Type u) [CommRing B] [Algebra A B] [Algebra.Etale A B] (σB : B →+* IsLocalRing.ResidueField A), σB.comp (algebraMap A B) = IsLocalRing.residue A → ∀ (f : Polynomial B) (t : IsLocalRing.ResidueField A), f.Monic → f.eval₂ σB t = 0 → f.derivative.eval₂ σB t ≠ 0 → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra A E') (_ : Algebra.Etale A E') (σ' : E' →ₐ[A] IsLocalRing.ResidueField A) (ι : B →ₐ[A] E') (x : E'), (σ' : E' →+* IsLocalRing.ResidueField A).comp (ι : B →+* E') = σB ∧ σ' x = t ∧ f.eval₂ (ι : B →+* E') x = 0) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] (E : Type u) [CommRing E] [Algebra A E] [Algebra.Etale A E] (σ : E →ₐ[A] IsLocalRing.ResidueField A) (q : Ideal E) [q.IsPrime], (∀ e : E, e ∈ q ↔ σ e = 0) → ∀ (F : Polynomial (Localization.AtPrime q)) (b₀ : Localization.AtPrime q), F.Monic → F.eval b₀ ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) → IsUnit (F.derivative.eval b₀) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra A E') (_ : Algebra.Etale A E') (σ' : E' →ₐ[A] IsLocalRing.ResidueField A) (φ : E →ₐ[A] E') (x : E'), σ'.comp φ = σ ∧ ∀ (C : Type u) [CommRing C] [IsLocalRing C] (χ : E' →+* C) (ψ : Localization.AtPrime q →+* C), (∀ y : E', IsUnit (χ y) ↔ σ' y ≠ 0) → IsLocalHom ψ → ψ.comp (algebraMap E (Localization.AtPrime q)) = χ.comp (φ : E →+* E') → (F.map ψ).eval (χ x) = 0 ∧ χ x - ψ b₀ ∈ IsLocalRing.maximalIdeal C :=
by
  intro H4 A _ _ E _ _ _ σ q _ hq F b₀ hF h1 h2
  classical

  have hσA : ∀ a : A, σ (algebraMap A E a) = IsLocalRing.residue A a := by
    intro a
    rw [AlgHom.commutes, IsLocalRing.ResidueField.algebraMap_eq]

  have hunitσ : ∀ y : q.primeCompl,
      IsUnit ((σ : E →+* IsLocalRing.ResidueField A) (y : E)) := by
    intro y
    apply isUnit_iff_ne_zero.mpr
    intro h0
    exact y.2 ((hq y).mpr h0)
  obtain ⟨ρ, hρE⟩ : ∃ ρ : Localization.AtPrime q →+* IsLocalRing.ResidueField A,
      ∀ e, ρ (algebraMap E (Localization.AtPrime q) e) = σ e :=
    ⟨IsLocalization.lift hunitσ, fun e => IsLocalization.lift_eq hunitσ e⟩
  have hρ0 : ∀ z : Localization.AtPrime q,
      ρ z = 0 ↔ z ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    intro z
    obtain ⟨⟨e, y⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
    rw [IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime q) q, hq]
    have h3 := congrArg ρ (IsLocalization.mk'_spec (Localization.AtPrime q) e y)
    rw [map_mul, hρE, hρE] at h3
    have hy0 : σ (y : E) ≠ 0 := (hunitσ y).ne_zero
    constructor
    · intro h
      rw [← h3, h, zero_mul]
    · intro h
      rw [h] at h3
      exact (mul_eq_zero.mp h3).resolve_right hy0

  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset q.primeCompl
    ((Finset.range (F.natDegree + 1)).image F.coeff)
  have hsL : IsUnit (algebraMap E (Localization.AtPrime q) (b : E)) :=
    IsLocalization.map_units (Localization.AtPrime q) b
  obtain ⟨l₀, hl₀⟩ : ∃ l₀ : Localization.Away (b : E) →+* Localization.AtPrime q,
      ∀ r, l₀ (algebraMap E (Localization.Away (b : E)) r) = algebraMap E (Localization.AtPrime q) r :=
    ⟨IsLocalization.Away.lift (b : E) hsL, fun r => IsLocalization.Away.lift_eq (b : E) hsL r⟩
  have hinv : algebraMap E (Localization.AtPrime q) (b : E) *
      l₀ (IsLocalization.Away.invSelf (S := Localization.Away (b : E)) (b : E)) = 1 := by
    rw [← hl₀, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
  have hlifts : F ∈ Polynomial.lifts l₀ := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    by_cases hn : n ≤ F.natDegree
    · have hc : F.coeff n ∈ (Finset.range (F.natDegree + 1)).image F.coeff :=
        Finset.mem_image.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_of_le hn), rfl⟩
      obtain ⟨e, he⟩ := hb _ hc
      simp only [Algebra.smul_def] at he
      refine ⟨algebraMap E (Localization.Away (b : E)) e *
        IsLocalization.Away.invSelf (S := Localization.Away (b : E)) (b : E), ?_⟩
      rw [map_mul, hl₀, he]
      calc algebraMap E (Localization.AtPrime q) (b : E) * F.coeff n *
            l₀ (IsLocalization.Away.invSelf (S := Localization.Away (b : E)) (b : E))
          = F.coeff n * (algebraMap E (Localization.AtPrime q) (b : E) *
            l₀ (IsLocalization.Away.invSelf (S := Localization.Away (b : E)) (b : E))) := by ring
        _ = F.coeff n := by rw [hinv, mul_one]
    · refine ⟨0, ?_⟩
      rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
  obtain ⟨f, hfmap, -, hfmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hF

  obtain ⟨σs, hσsE⟩ : ∃ σs : Localization.Away (b : E) →+* IsLocalRing.ResidueField A,
      ∀ r, σs (algebraMap E (Localization.Away (b : E)) r) = σ r :=
    ⟨IsLocalization.Away.lift (b : E) (hunitσ b),
      fun r => IsLocalization.Away.lift_eq (b : E) (hunitσ b) r⟩
  have hρl₀ : ρ.comp l₀ = σs := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (b : E))
    ext r
    simp only [RingHom.comp_apply, hl₀, hρE, hσsE]
  have hσsA : σs.comp (algebraMap A (Localization.Away (b : E))) = IsLocalRing.residue A := by
    ext a
    rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply A E (Localization.Away (b : E)),
      hσsE, hσA]
  have hft : f.eval₂ σs (ρ b₀) = 0 := by
    rw [← hρl₀, ← Polynomial.hom_eval₂, ← Polynomial.eval_map, hfmap]
    exact (hρ0 _).mpr h1
  have hf't : f.derivative.eval₂ σs (ρ b₀) ≠ 0 := by
    rw [← hρl₀, ← Polynomial.hom_eval₂, ← Polynomial.eval_map, ← Polynomial.derivative_map,
      hfmap]
    intro h0
    exact (IsLocalRing.mem_maximalIdeal _).mp ((hρ0 _).mp h0) h2

  obtain ⟨E', iE', iA, iEt, σ', ι, x, hσι, hσx, hfx⟩ :=
    H4 A (Localization.Away (b : E)) σs hσsA f (ρ b₀) hfmonic hft hf't
  refine ⟨E', iE', iA, iEt, σ', ι.comp (IsScalarTower.toAlgHom A E (Localization.Away (b : E))),
    x, ?_, ?_⟩
  · apply AlgHom.ext
    intro y
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.toAlgHom_apply]
    exact (RingHom.congr_fun hσι (algebraMap E _ y)).trans (hσsE y)
  · intro C _ _ χ ψ hχ hψl hψ
    haveI := hψl
    have hψE : ∀ y, ψ (algebraMap E (Localization.AtPrime q) y) =
        χ (ι (algebraMap E (Localization.Away (b : E)) y)) := fun y => RingHom.congr_fun hψ y
    have hψl₀ : ψ.comp l₀ = χ.comp (ι : Localization.Away (b : E) →+* E') := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (b : E))
      ext r
      show ψ (l₀ (algebraMap E _ r)) = χ (ι (algebraMap E _ r))
      rw [hl₀]
      exact hψE r
    refine ⟨?_, ?_⟩
    · rw [← hfmap, Polynomial.map_map, hψl₀, Polynomial.eval_map, ← Polynomial.hom_eval₂, hfx,
        map_zero]
    · obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective (σ' x)
      have hψA : ψ (algebraMap A (Localization.AtPrime q) a₀) = χ (algebraMap A E' a₀) := by
        rw [IsScalarTower.algebraMap_apply A E (Localization.AtPrime q), hψE,
          ← IsScalarTower.algebraMap_apply A E (Localization.Away (b : E)), AlgHom.commutes]
      have e1 : χ x - ψ b₀ = χ (x - algebraMap A E' a₀) -
          ψ (b₀ - algebraMap A (Localization.AtPrime q) a₀) := by
        rw [map_sub, map_sub, hψA]
        ring
      rw [e1]
      apply Ideal.sub_mem
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hχ, not_not, map_sub,
          AlgHom.commutes, IsLocalRing.ResidueField.algebraMap_eq, ha₀, sub_self]
      · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have hmem : b₀ - algebraMap A (Localization.AtPrime q) a₀ ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          rw [← hρ0, map_sub, IsScalarTower.algebraMap_apply A E (Localization.AtPrime q), hρE,
            hσA, ha₀, ← hσx, sub_self]
        exact (IsLocalRing.mem_maximalIdeal _).mp hmem (isUnit_of_map_unit ψ _ hu)

theorem wcNd_hf_stage_index : ∀ (A : Type u) [CommRing A] [IsLocalRing A], ∃ (ι : Type u) (_ : Preorder ι) (_ : Nonempty ι) (_ : IsDirectedOrder ι) (E : ι → Type u) (_ : ∀ i, CommRing (E i)) (_ : ∀ i, Algebra A (E i)) (_ : ∀ i, Algebra.Etale A (E i)) (σ : ∀ i, E i →ₐ[A] IsLocalRing.ResidueField A), (∀ i j, i ≤ j ↔ ∃ φ : E i →ₐ[A] E j, (σ j).comp φ = σ i) ∧ ∀ (E' : Type u) [CommRing E'] [Algebra A E'] [Algebra.Etale A E'] (σ' : E' →ₐ[A] IsLocalRing.ResidueField A), ∃ (j : ι) (e : E j ≃ₐ[A] E'), σ'.comp (e : E j →ₐ[A] E') = σ j :=
by
  intro A _ _
  classical
  have instE : ∀ i : wcNdHfIdx A, Algebra.Etale A (wcNdHfStage A i) := fun i => i.2.1.2
  let σ : ∀ i : wcNdHfIdx A, wcNdHfStage A i →ₐ[A] IsLocalRing.ResidueField A := fun i => i.2.2
  let inst : Preorder (wcNdHfIdx A) :=
    { le := fun i j => ∃ φ : wcNdHfStage A i →ₐ[A] wcNdHfStage A j, (σ j).comp φ = σ i
      le_refl := fun i => ⟨AlgHom.id A _, AlgHom.comp_id _⟩
      le_trans := fun i j k ⟨φ₁, h₁⟩ ⟨φ₂, h₂⟩ =>
        ⟨φ₂.comp φ₁, by rw [← AlgHom.comp_assoc, h₂, h₁]⟩ }
  have pres : ∀ (E' : Type u) [CommRing E'] [Algebra A E'] [Algebra.Etale A E']
      (σ' : E' →ₐ[A] IsLocalRing.ResidueField A),
      ∃ (j : wcNdHfIdx A) (e : wcNdHfStage A j ≃ₐ[A] E'),
        σ'.comp (e : wcNdHfStage A j →ₐ[A] E') = σ j := by
    intro E' _ _ _ σ'
    have hfp : Algebra.FinitePresentation A E' := Algebra.Etale.finitePresentation
    have hft : Algebra.FiniteType A E' := Algebra.FiniteType.of_finitePresentation
    obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    let e : (MvPolynomial (Fin n) A ⧸ RingHom.ker f) ≃ₐ[A] E' :=
      Ideal.quotientKerAlgEquivOfSurjective hf
    have hJ : Algebra.Etale A (MvPolynomial (Fin n) A ⧸ RingHom.ker f) :=
      Algebra.Etale.of_equiv e.symm
    exact ⟨⟨n, ⟨RingHom.ker f, hJ⟩, σ'.comp (e : _ →ₐ[A] E')⟩, e, rfl⟩
  have hne : Nonempty (wcNdHfIdx A) := by
    obtain ⟨j, -, -⟩ := pres A (Algebra.ofId A (IsLocalRing.ResidueField A))
    exact ⟨j⟩
  have dir : @IsDirectedOrder (wcNdHfIdx A) inst.toLE := by
    refine ⟨fun i j => ?_⟩
    letI : Algebra.Etale (wcNdHfStage A i) (TensorProduct A (wcNdHfStage A i) (wcNdHfStage A j)) :=
      Algebra.Etale.baseChange A (wcNdHfStage A j) (wcNdHfStage A i)
    have hT : Algebra.Etale A (TensorProduct A (wcNdHfStage A i) (wcNdHfStage A j)) :=
      Algebra.Etale.comp A (wcNdHfStage A i) _
    obtain ⟨k, e, he⟩ := pres (TensorProduct A (wcNdHfStage A i) (wcNdHfStage A j))
      (Algebra.TensorProduct.productMap (σ i) (σ j))
    refine ⟨k, ⟨(e.symm : TensorProduct A (wcNdHfStage A i) (wcNdHfStage A j) →ₐ[A] _).comp
      Algebra.TensorProduct.includeLeft, ?_⟩,
      ⟨(e.symm : TensorProduct A (wcNdHfStage A i) (wcNdHfStage A j) →ₐ[A] _).comp
      Algebra.TensorProduct.includeRight, ?_⟩⟩
    · rw [← he, ← AlgHom.comp_assoc, AlgHom.comp_assoc (Algebra.TensorProduct.productMap (σ i) (σ j)),
        AlgEquiv.comp_symm, AlgHom.comp_id]
      exact Algebra.TensorProduct.productMap_left _ _
    · rw [← he, ← AlgHom.comp_assoc, AlgHom.comp_assoc (Algebra.TensorProduct.productMap (σ i) (σ j)),
        AlgEquiv.comp_symm, AlgHom.comp_id]
      exact Algebra.TensorProduct.productMap_right _ _
  exact ⟨wcNdHfIdx A, inst, hne, dir, wcNdHfStage A, inferInstance, inferInstance, instE, σ,
    fun i j => Iff.rfl, pres⟩

theorem wcNd_hf_stage_transitions : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (ι : Type u) [Preorder ι] (E : ι → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra A (E i)] [∀ i, Algebra.Etale A (E i)] (σ : ∀ i, E i →ₐ[A] IsLocalRing.ResidueField A) (q : ∀ i, Ideal (E i)) [∀ i, (q i).IsPrime], (∀ i (e : E i), e ∈ q i ↔ σ i e = 0) → (∀ i j, i ≤ j → ∃ φ : E i →ₐ[A] E j, (σ j).comp φ = σ i) → (∀ i (C : Type u) [CommRing C] [IsLocalRing C] (ψ : Localization.AtPrime (q i) →+* C) (χ : E i →+* C), IsLocalHom ψ → (∀ y : E i, σ i y = 0 → χ y ∈ IsLocalRing.maximalIdeal C) → ψ.comp (algebraMap A (Localization.AtPrime (q i))) = χ.comp (algebraMap A (E i)) → ψ.comp (algebraMap (E i) (Localization.AtPrime (q i))) = χ) → ∃ f : ∀ i j, i ≤ j → Localization.AtPrime (q i) →+* Localization.AtPrime (q j), DirectedSystem (fun i => Localization.AtPrime (q i)) (fun i j h => f i j h) ∧ (∀ i j (h : i ≤ j), IsLocalHom (f i j h)) ∧ (∀ i j (h : i ≤ j) (a : A), f i j h (algebraMap A (Localization.AtPrime (q i)) a) = algebraMap A (Localization.AtPrime (q j)) a) ∧ ∀ i j (h : i ≤ j) (φ : E i →ₐ[A] E j), (σ j).comp φ = σ i → (f i j h).comp (algebraMap (E i) (Localization.AtPrime (q i))) = (algebraMap (E j) (Localization.AtPrime (q j))).comp (φ : E i →+* E j) :=
by
  intro A _ _ ι _ E _ _ _ σ q _ hq hle hU
  have hcomap : ∀ i j (φ : E i →ₐ[A] E j), (σ j).comp φ = σ i →
      q i = Ideal.comap (φ : E i →+* E j) (q j) := by
    intro i j φ hφ
    ext e
    rw [Ideal.mem_comap, hq i, hq j]
    have h1 := DFunLike.congr_fun hφ e
    simp only [AlgHom.comp_apply] at h1
    simp only [RingHom.coe_coe, h1]
  let f : ∀ i j, i ≤ j → Localization.AtPrime (q i) →+* Localization.AtPrime (q j) :=
    fun i j h => Localization.localRingHom (q i) (q j)
      ((Classical.choose (hle i j h) : E i →ₐ[A] E j) : E i →+* E j)
      (hcomap i j _ (Classical.choose_spec (hle i j h)))
  have hOnE : ∀ i j (h : i ≤ j) (x : E i), f i j h (algebraMap (E i) _ x) =
      algebraMap (E j) (Localization.AtPrime (q j)) ((Classical.choose (hle i j h)) x) := by
    intro i j h x
    exact Localization.localRingHom_to_map _ _ _ _ x
  have hloc : ∀ i j (h : i ≤ j), IsLocalHom (f i j h) := fun i j h =>
    Localization.isLocalHom_localRingHom _ _ _ _
  have htower : ∀ i (a : A), algebraMap A (Localization.AtPrime (q i)) a =
      algebraMap (E i) (Localization.AtPrime (q i)) (algebraMap A (E i) a) := fun i a =>
    IsScalarTower.algebraMap_apply A (E i) _ a
  have hA : ∀ i j (h : i ≤ j) (a : A), f i j h (algebraMap A (Localization.AtPrime (q i)) a) =
      algebraMap A (Localization.AtPrime (q j)) a := by
    intro i j h a
    rw [htower i, hOnE i j h, AlgHom.commutes, ← htower j]
  have hAny : ∀ i j (h : i ≤ j) (φ : E i →ₐ[A] E j), (σ j).comp φ = σ i →
      (f i j h).comp (algebraMap (E i) (Localization.AtPrime (q i))) =
        (algebraMap (E j) (Localization.AtPrime (q j))).comp (φ : E i →+* E j) := by
    intro i j h φ hφ
    apply hU i (Localization.AtPrime (q j)) (f i j h) _ (hloc i j h)
    · intro y hy
      rw [RingHom.comp_apply]
      apply (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime (q j)) (q j) _).mpr
      rw [hq j]
      have h1 := DFunLike.congr_fun hφ y
      simp only [AlgHom.comp_apply] at h1
      simp only [RingHom.coe_coe, h1]
      exact hy
    · ext a
      simp only [RingHom.comp_apply]
      rw [hA i j h, RingHom.coe_coe, AlgHom.commutes, ← htower j]
  refine ⟨f, ⟨?_, ?_⟩, hloc, hA, hAny⟩
  · intro i x
    have h1 := hAny i i le_rfl (AlgHom.id A (E i)) (AlgHom.comp_id _)
    have h2 : f i i le_rfl = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (q i).primeCompl
      refine h1.trans ?_
      ext y
      simp
    exact RingHom.congr_fun h2 x
  · intro k j i hij hjk x
    let φ1 : E i →ₐ[A] E j := Classical.choose (hle i j hij)
    let φ2 : E j →ₐ[A] E k := Classical.choose (hle j k hjk)
    have hs1 : (σ j).comp φ1 = σ i := Classical.choose_spec (hle i j hij)
    have hs2 : (σ k).comp φ2 = σ j := Classical.choose_spec (hle j k hjk)
    have hc : (σ k).comp (φ2.comp φ1) = σ i := by
      rw [← AlgHom.comp_assoc, hs2, hs1]
    have h1 := hAny i k (hij.trans hjk) (φ2.comp φ1) hc
    have h2 : (f j k hjk).comp (f i j hij) = f i k (hij.trans hjk) := by
      apply IsLocalization.ringHom_ext (q i).primeCompl
      rw [RingHom.comp_assoc, h1]
      ext y
      simp only [RingHom.comp_apply]
      rw [hOnE i j hij, hOnE j k hjk]
      rfl
    exact RingHom.congr_fun h2 x

theorem wcNd_hf_stage_system : ∀ (A : Type u) [CommRing A] [IsLocalRing A], ∃ (ι : Type u) (_ : Preorder ι) (_ : Nonempty ι) (_ : IsDirectedOrder ι) (G : ι → Type u) (_ : ∀ i, CommRing (G i)) (_ : ∀ i, IsLocalRing (G i)) (_ : ∀ i, Algebra A (G i)) (f : ∀ i j, i ≤ j → G i →+* G j), DirectedSystem G (fun i j h => f i j h) ∧ (∀ i j (h : i ≤ j), IsLocalHom (f i j h)) ∧ (∀ i j (h : i ≤ j) (a : A), f i j h (algebraMap A (G i) a) = algebraMap A (G j) a) ∧ (∀ i, Module.Flat A (G i)) ∧ (∀ i (a : A), IsUnit (algebraMap A (G i) a) ↔ a ∉ IsLocalRing.maximalIdeal A) ∧ (∀ i (y : G i), ∃ a : A, y - algebraMap A (G i) a ∈ IsLocalRing.maximalIdeal (G i)) ∧ (∀ i (C : Type u) [CommRing C] [HenselianLocalRing C] (gA : A →+* C), (∀ a : A, IsUnit (gA a) ↔ a ∉ IsLocalRing.maximalIdeal A) → ∃! k : G i →+* C, k.comp (algebraMap A (G i)) = gA ∧ IsLocalHom k) ∧ (∀ i (F : Polynomial (G i)) (b₀ : G i), F.Monic → F.eval b₀ ∈ IsLocalRing.maximalIdeal (G i) → IsUnit (F.derivative.eval b₀) → ∃ j, ∃ h : i ≤ j, ∃ b : G j, (F.map (f i j h)).eval b = 0 ∧ b - f i j h b₀ ∈ IsLocalRing.maximalIdeal (G j)) :=
by
  intro A _ _
  obtain ⟨ι, _, _, _, E, _, _, _, σ, hle, hpres⟩ := wcNd_hf_stage_index A
  let q : ∀ i, Ideal (E i) := fun i => RingHom.ker (σ i)
  haveI hqp : ∀ i, (q i).IsPrime := fun i => RingHom.ker_isPrime (σ i)
  have hq : ∀ i (e : E i), e ∈ q i ↔ σ i e = 0 := fun i e => RingHom.mem_ker
  have hU := fun i => wcNd_hf_stage_hom_unique A (E i) (σ i) (q i) (hq i)
  obtain ⟨f, hDS, hloc, hfA, hφ⟩ :=
    wcNd_hf_stage_transitions A ι E σ q hq (fun i j h => (hle i j).mp h) hU
  refine ⟨ι, inferInstance, inferInstance, inferInstance, fun i => Localization.AtPrime (q i),
    inferInstance, inferInstance, inferInstance, f, hDS, hloc, hfA, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    exact (wcNd_hf_stage_basic A (E i) (σ i) (q i) (hq i)).1
  · intro i
    exact (wcNd_hf_stage_basic A (E i) (σ i) (q i) (hq i)).2.1
  · intro i
    exact (wcNd_hf_stage_basic A (E i) (σ i) (q i) (hq i)).2.2
  · intro i C _ _ gA hgA
    obtain ⟨k, hk, hkl⟩ := wcNd_hf_stage_lift A (E i) (σ i) (q i) (hq i) C gA hgA
    refine ⟨k, ⟨hk, hkl⟩, ?_⟩
    rintro k' ⟨hk', hk'l⟩
    have e1 : k'.comp (algebraMap (E i) (Localization.AtPrime (q i))) =
        k.comp (algebraMap (E i) (Localization.AtPrime (q i))) := by
      apply hU i C k' (k.comp (algebraMap (E i) (Localization.AtPrime (q i)))) hk'l
      · intro y hy
        rw [RingHom.comp_apply, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        haveI := hkl
        have h3 := isUnit_of_map_unit k _ hu
        rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime (q i)) (q i)] at h3
        exact h3 ((hq i y).mpr hy)
      · rw [hk', RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq, hk]
    exact IsLocalization.ringHom_ext (q i).primeCompl e1
  · intro i F b₀ hF h1 h2
    obtain ⟨E', _, _, _, σ', φ, x, hσφ, hx⟩ :=
      wcNd_hf_stage_hensel_step wcNd_hf_adjoin_simple_root A (E i) (σ i) (q i) (hq i) F b₀ hF h1 h2
    obtain ⟨j, e, he⟩ := hpres E' σ'
    let φ' : E i →ₐ[A] E j := (e.symm : E' →ₐ[A] E j).comp φ
    have hσφ' : (σ j).comp φ' = σ i := by
      rw [← he, ← hσφ]
      ext y
      simp [φ']
    have hij : i ≤ j := (hle i j).mpr ⟨φ', hσφ'⟩
    refine ⟨j, hij, (algebraMap (E j) (Localization.AtPrime (q j))) (e.symm x), ?_⟩
    have key := hx (Localization.AtPrime (q j))
      ((algebraMap (E j) (Localization.AtPrime (q j))).comp (e.symm : E' →+* E j))
      (f i j hij) ?_ (hloc i j hij) ?_
    · exact key
    · intro y
      rw [RingHom.comp_apply,
        IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime (q j)) (q j)]
      show ¬ (_ ∈ q j) ↔ _
      rw [hq j, ← he]
      simp
    · rw [hφ i j hij φ' hσφ']
      ext y
      simp [φ']

theorem wcNd_hi_hens_exists_flat : ∀ (A : Type u) [CommRing A] [IsLocalRing A],
    ∃ (R : Type u) (_ : CommRing R) (_ : Algebra A R),
      wcNdIsHens (IsLocalRing.maximalIdeal A) R (algebraMap A R) ∧ Module.Flat A R ∧
      ∀ x : R, ∃ a : A, ¬ IsUnit (x - algebraMap A R a) :=
by

  have t_flat : ∀ (A : Type u) [CommRing A] (ι : Type u) [Preorder ι] [Nonempty ι] [IsDirectedOrder ι] (G : ι → Type u) [∀ i, CommRing (G i)] [∀ i, Algebra A (G i)] (f : ∀ i j, i ≤ j → G i →+* G j) (R : Type u) [CommRing R] [Algebra A R] (g : ∀ i, G i →+* R), (∀ i j (h : i ≤ j) (a : A), f i j h (algebraMap A (G i) a) = algebraMap A (G j) a) → (∀ i (a : A), g i (algebraMap A (G i) a) = algebraMap A R a) → (∀ i j (h : i ≤ j) (x : G i), g j (f i j h x) = g i x) → (∀ x : R, ∃ i, ∃ y : G i, g i y = x) → (∀ i (y : G i), g i y = 0 → ∃ j, ∃ h : i ≤ j, f i j h y = 0) → (∀ i, Module.Flat A (G i)) → Module.Flat A R := by
    intro A _ ι _ _ _ G _ _ f R _ _ g hfA hgA c1 c2 c3 hflat
    classical
    rw [Module.Flat.iff_forall_isTrivialRelation]
    intro l c x hx
    choose i y hy using c2
    obtain ⟨k, hk⟩ := Finset.exists_le ((Finset.univ : Finset (Fin l)).image (fun t => i (x t)))
    have hk' : ∀ t, i (x t) ≤ k := fun t => hk _ (Finset.mem_image_of_mem _ (Finset.mem_univ t))
    let y' : Fin l → G k := fun t => f _ k (hk' t) (y (x t))
    have hgy : ∀ t, g k (y' t) = x t := fun t => by
      show g k (f _ k (hk' t) (y (x t))) = x t
      rw [c1, hy]
    have hgsmul : ∀ j (a : A) (z : G j), g j (a • z) = a • g j z := by
      intro j a z
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, hgA]
    have hfsmul : ∀ j j' (h : j ≤ j') (a : A) (z : G j), f j j' h (a • z) = a • f j j' h z := by
      intro j j' h a z
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, hfA]
    have hY : g k (∑ t, c t • y' t) = 0 := by
      rw [map_sum]
      simp only [hgsmul, hgy]
      exact hx
    obtain ⟨m, hkm, hm⟩ := c3 k _ hY
    rw [map_sum] at hm
    simp only [hfsmul] at hm
    obtain ⟨K, a, z, h1, h2⟩ := (Module.Flat.iff_forall_isTrivialRelation.mp (hflat m)) hm
    refine ⟨K, a, fun j => g m (z j), fun t => ?_, h2⟩
    rw [← hgy t, ← c1 k m hkm, show f k m hkm (y' t) = _ from h1 t, map_sum]
    simp only [hgsmul]

  have t_hens : ∀ (ι : Type u) [Preorder ι] [Nonempty ι] [IsDirectedOrder ι] (G : ι → Type u) [∀ i, CommRing (G i)] [∀ i, IsLocalRing (G i)] (f : ∀ i j, i ≤ j → G i →+* G j) (R : Type u) [CommRing R] [IsLocalRing R] (g : ∀ i, G i →+* R), (∀ i j (h : i ≤ j) (x : G i), g j (f i j h x) = g i x) → (∀ x : R, ∃ i, ∃ y : G i, g i y = x) → (∀ i (y : G i), IsUnit (g i y) ↔ IsUnit y) → (∀ i (F : Polynomial (G i)) (b₀ : G i), F.Monic → F.eval b₀ ∈ IsLocalRing.maximalIdeal (G i) → IsUnit (F.derivative.eval b₀) → ∃ j, ∃ h : i ≤ j, ∃ b : G j, (F.map (f i j h)).eval b = 0 ∧ b - f i j h b₀ ∈ IsLocalRing.maximalIdeal (G j)) → HenselianLocalRing R := by
    intro ι _ _ _ G _ _ f R _ _ g c1 c2 hU hhens
    classical
    refine HenselianLocalRing.mk ?_
    intro F hF b₀ hb₀ hd
    choose i y hy using c2
    obtain ⟨k, hk⟩ := Finset.exists_le
      (insert (i b₀) ((Finset.range (F.natDegree + 1)).image (fun n => i (F.coeff n))))
    have hk0 : i b₀ ≤ k := hk _ (Finset.mem_insert_self _ _)
    have hkn : ∀ n ≤ F.natDegree, i (F.coeff n) ≤ k := fun n hn =>
      hk _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))))
    have hlift : F ∈ Polynomial.lifts (g k) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      by_cases hn : n ≤ F.natDegree
      · exact ⟨f _ k (hkn n hn) (y (F.coeff n)), by rw [c1, hy]⟩
      · exact ⟨0, by rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]⟩
    obtain ⟨Q, hQ, -, hQm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hF
    have hy₀ : g k (f _ k hk0 (y b₀)) = b₀ := by rw [c1, hy]
    have hev : ∀ P : Polynomial (G k),
        g k (P.eval (f _ k hk0 (y b₀))) = (P.map (g k)).eval b₀ := by
      intro P
      rw [Polynomial.eval_map, ← Polynomial.eval₂_at_apply, hy₀]
    have h1 : Q.eval (f _ k hk0 (y b₀)) ∈ IsLocalRing.maximalIdeal (G k) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hU, hev, hQ]
      exact (IsLocalRing.mem_maximalIdeal _).mp hb₀
    have h2 : IsUnit (Q.derivative.eval (f _ k hk0 (y b₀))) := by
      rw [← hU, hev, ← Polynomial.derivative_map, hQ]
      exact hd
    obtain ⟨j, hkj, b, hb, hbm⟩ := hhens k Q _ hQm h1 h2
    refine ⟨g j b, ?_, ?_⟩
    · have hc : (g j).comp (f k j hkj) = g k := RingHom.ext (fun x => c1 k j hkj x)
      have hmap : (Q.map (f k j hkj)).map (g j) = F := by
        rw [Polynomial.map_map, hc, hQ]
      show F.eval (g j b) = 0
      rw [← hmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hb, map_zero]
    · have e : g j b - b₀ = g j (b - f k j hkj (f _ k hk0 (y b₀))) := by
        rw [map_sub, c1, hy₀]
      rw [e, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hU]
      exact (IsLocalRing.mem_maximalIdeal _).mp hbm
  intro A _ _
  obtain ⟨ι, _, _, _, G, _, _, _, f, hDS, hloc, hfA, hflat, hunit, hres, hUP, hhens⟩ :=
    wcNd_hf_stage_system A
  haveI := hDS
  let R := Ring.DirectLimit G (fun i j h => f i j h)
  let g : ∀ i, G i →+* R := fun i => Ring.DirectLimit.of G (fun i j h => f i j h) i
  obtain ⟨i₀⟩ := (inferInstance : Nonempty ι)
  let ιA : A →+* R := (g i₀).comp (algebraMap A (G i₀))
  letI : Algebra A R := ιA.toAlgebra
  have c1 : ∀ i j (h : i ≤ j) (x : G i), g j (f i j h x) = g i x := fun i j h x =>
    Ring.DirectLimit.of_f h x
  have c2 : ∀ x : R, ∃ i, ∃ y : G i, g i y = x := fun x => Ring.DirectLimit.exists_of x
  have c3 : ∀ i (y : G i), g i y = 0 → ∃ j, ∃ h : i ≤ j, f i j h y = 0 := fun i y hy =>
    Ring.DirectLimit.of.zero_exact hy
  have c4 : ∀ i, (g i).comp (algebraMap A (G i)) = ιA := by
    intro i
    ext a
    obtain ⟨k, hik, hi₀k⟩ := directed_of (· ≤ ·) i i₀
    show g i (algebraMap A (G i) a) = g i₀ (algebraMap A (G i₀) a)
    rw [← c1 i k hik, ← c1 i₀ k hi₀k, hfA, hfA]
  have c4' : ∀ i (a : A), g i (algebraMap A (G i) a) = algebraMap A R a := fun i a =>
    RingHom.congr_fun (c4 i) a
  have c5 : ∀ (C : Type u) [CommRing C] (k : ∀ i, G i →+* C),
      (∀ i j (h : i ≤ j) (x : G i), k j (f i j h x) = k i x) →
      ∃ φ : R →+* C, ∀ i, φ.comp (g i) = k i := by
    intro C _ k hk
    refine ⟨Ring.DirectLimit.lift G (fun i j h => f i j h) C k hk, fun i => ?_⟩
    ext x
    show Ring.DirectLimit.lift G (fun i j h => f i j h) C k hk
      (Ring.DirectLimit.of G (fun i j h => f i j h) i x) = k i x
    exact Ring.DirectLimit.lift_of ..

  have hU : ∀ i (y : G i), IsUnit (g i y) ↔ IsUnit y := by
    intro i y
    refine ⟨fun hu => ?_, fun hu => hu.map (g i)⟩
    obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu
    obtain ⟨j, z, rfl⟩ := c2 w
    obtain ⟨k, hik, hjk⟩ := directed_of (· ≤ ·) i j
    have h0 : g k (f i k hik y * f j k hjk z - 1) = 0 := by
      rw [map_sub, map_mul, map_one, c1, c1, hw, sub_self]
    obtain ⟨l, hkl, hl⟩ := c3 k _ h0
    rw [map_sub, map_mul, map_one, sub_eq_zero] at hl
    have h1 : IsUnit (f k l hkl (f i k hik y)) := isUnit_iff_exists_inv.mpr ⟨_, hl⟩
    have h2 : IsUnit (f i k hik y) := (hloc k l hkl).map_nonunit _ h1
    exact (hloc i k hik).map_nonunit _ h2
  haveI : Nontrivial R := by
    refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
    have h1 : g i₀ 1 = 0 := by rw [map_one]; exact h01.symm
    obtain ⟨j, hj, hj0⟩ := c3 i₀ 1 h1
    rw [map_one] at hj0
    exact one_ne_zero hj0
  haveI hRl : IsLocalRing R := by
    refine IsLocalRing.of_nonunits_add ?_
    intro x x' hx hx'
    obtain ⟨i, y, rfl⟩ := c2 x
    obtain ⟨i', y', rfl⟩ := c2 x'
    obtain ⟨k, hik, hi'k⟩ := directed_of (· ≤ ·) i i'
    rw [← c1 i k hik y] at hx ⊢
    rw [← c1 i' k hi'k y'] at hx' ⊢
    rw [mem_nonunits_iff, hU] at hx hx'
    rw [← map_add, mem_nonunits_iff, hU]
    exact IsLocalRing.nonunits_add hx hx'
  have H1 : HenselianLocalRing R := t_hens ι G f R g c1 c2 hU hhens
  have H2 : ∀ a, IsUnit (algebraMap A R a) ↔ a ∉ IsLocalRing.maximalIdeal A := by
    intro a
    rw [← c4' i₀ a, hU]
    exact hunit i₀ a
  have hF : Module.Flat A R := t_flat A ι G f R g hfA c4' c1 c2 c3 hflat
  have hRes : ∀ x : R, ∃ a : A, ¬ IsUnit (x - algebraMap A R a) := by
    intro x
    obtain ⟨i, y, rfl⟩ := c2 x
    obtain ⟨a, ha⟩ := hres i y
    refine ⟨a, fun hu => ?_⟩
    have e : g i y - algebraMap A R a = g i (y - algebraMap A (G i) a) := by
      rw [map_sub, c4']
    rw [e, hU] at hu
    exact (IsLocalRing.mem_maximalIdeal _).mp ha hu
  refine ⟨R, inferInstance, inferInstance, ⟨H1, H2, ?_⟩, hF, hRes⟩

  intro C _ hC gA hgA
  haveI := hC
  choose k hk hku using fun i => hUP i C gA hgA
  have hcompat : ∀ i j (h : i ≤ j) (x : G i), k j (f i j h x) = k i x := by
    intro i j h x
    have hl : IsLocalHom ((k j).comp (f i j h)) := by
      haveI := (hk j).2
      haveI := hloc i j h
      exact RingHom.isLocalHom_comp _ _
    have heq : (k j).comp (f i j h) = k i := by
      apply hku i
      refine ⟨?_, hl⟩
      ext a
      simp only [RingHom.comp_apply, hfA]
      exact RingHom.congr_fun (hk j).1 a
    exact RingHom.congr_fun heq x
  obtain ⟨φ, hφ⟩ := c5 C k hcompat
  refine ⟨φ, ⟨?_, ?_⟩, ?_⟩
  · show φ.comp ιA = gA
    rw [← c4 i₀, ← RingHom.comp_assoc, hφ]
    exact (hk i₀).1
  · refine ⟨fun x hx => ?_⟩
    obtain ⟨i, y, rfl⟩ := c2 x
    have : φ (g i y) = k i y := RingHom.congr_fun (hφ i) y
    rw [this] at hx
    haveI := (hk i).2
    exact (hU i y).mpr (isUnit_of_map_unit (k i) y hx)
  · rintro h' ⟨hh', hloc'⟩
    have hstage : ∀ i, h'.comp (g i) = k i := by
      intro i
      apply hku i
      refine ⟨?_, ?_⟩
      · rw [RingHom.comp_assoc, c4 i]
        exact hh'
      · refine ⟨fun y hy => ?_⟩
        exact (hU i y).mp (hloc'.map_nonunit _ hy)
    apply RingHom.ext
    intro x
    obtain ⟨i, y, rfl⟩ := c2 x
    rw [← RingHom.comp_apply, hstage i, ← hφ i, RingHom.comp_apply]

theorem wcNd_hi_factor_hens : ∀ (A R B' L : Type u) [CommRing A] [IsLocalRing A] [CommRing R]
    [CommRing B'] [CommRing L] [IsLocalRing L] [Algebra A R] [Algebra A B'],
    wcNdIsHens (IsLocalRing.maximalIdeal A) R (algebraMap A R) →
    (∀ x : R, ∃ a : A, ¬ IsUnit (x - algebraMap A R a)) → Module.Finite A B' →
    ∀ (n : Ideal B') (hn : n.IsMaximal) (β : B' →+* L),
    @IsLocalization B' _ (@Ideal.primeCompl B' _ n hn.isPrime) L _ β.toAlgebra →
    ∃ (ε : TensorProduct A R B') (e : L →+* Localization.Away ε), IsIdempotentElem ε ∧
      wcNdIsHens (IsLocalRing.maximalIdeal L) (Localization.Away ε) e ∧
      ∀ b : B', e (β b) =
        algebraMap (TensorProduct A R B') (Localization.Away ε) (TensorProduct.tmul A (1 : R) b) :=
by
  intro A R B' L _ _ _ _ _ _ _ _ hR hres hfin n hn β hloc
  classical
  obtain ⟨hRh, hRu, hRuniv⟩ := hR
  haveI := hRh
  haveI := hfin

  have s1 : ∀ (A0 : Type u) [CommRing A0] [HenselianLocalRing A0] (E : Type u) [CommRing E]
      [Algebra A0 E], Algebra.Etale A0 E → ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
      ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
    intro A0 _ hHen
    have sstd : ∀ (S : Type u) [CommRing S] [Algebra A0 S], Algebra.IsStandardEtale A0 S →
        ∀ φ : S →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : S →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A0).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A0)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A0] IsLocalRing.ResidueField A0 :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := sstd _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A0 E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have s2 : ∀ (A0 : Type u) [CommRing A0] [IsLocalRing A0],
      (∀ (E : Type u) [CommRing E] [Algebra A0 E], Algebra.Etale A0 E →
        ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ) →
      ∀ (f : Polynomial A0) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A0)), f.Monic →
        g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A0) = g₀ * h₀ →
        ∃ g h : Polynomial A0, g.Monic ∧ h.Monic ∧ f = g * h ∧
          g.map (IsLocalRing.residue A0) = g₀ ∧ h.map (IsLocalRing.residue A0) = h₀ := by
    intro A0 _ _ s3 f g₀ h₀ hf hg hh hc hfac
    have hofId : ((Algebra.ofId A0 (IsLocalRing.ResidueField A0) :
        A0 →ₐ[A0] IsLocalRing.ResidueField A0) :
        A0 →+* IsLocalRing.ResidueField A0) = IsLocalRing.residue A0 := by
      ext x
      show Algebra.ofId A0 (IsLocalRing.ResidueField A0) x = IsLocalRing.residue A0 x
      rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq A0 f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A0)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap A0 (IsLocalRing.ResidueField A0)) (p : Polynomial A0) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A0)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
    have nat : ∀ (ψ : A0 →ₐ[A0] IsLocalRing.ResidueField A0),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A0 (IsLocalRing.ResidueField A0))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p ((Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2.monic, ?_,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl
  have Lft := wc_idempotent_lift_of_factor_lift R (s2 R (s1 R))

  obtain ⟨k, e, he1, he2, he3, he4⟩ :=
    wc_finite_alg_local_idempotents R Lft (TensorProduct A R B') inferInstance

  have hA : ∀ a : A, algebraMap A B' a ∈ n ↔ a ∈ IsLocalRing.maximalIdeal A := by
    have hint : (algebraMap A B').IsIntegral :=
      algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.of_finite A B')
    have hmx : (Ideal.comap (algebraMap A B') n).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A B') hint n
    have heq := IsLocalRing.eq_maximalIdeal hmx
    intro a
    rw [← heq, Ideal.mem_comap]

  have hkey : ∀ t : TensorProduct A R B', ∃ b : B', ∀ P : Ideal (TensorProduct A R B'),
      (∀ r : R, ¬ IsUnit r → TensorProduct.tmul A r (1 : B') ∈ P) →
      t - TensorProduct.tmul A (1 : R) b ∈ P := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, fun P _ => by rw [TensorProduct.tmul_zero, sub_zero]; exact P.zero_mem⟩
    | tmul r b =>
      obtain ⟨a, ha⟩ := hres r
      refine ⟨a • b, fun P hP => ?_⟩
      have h1 : TensorProduct.tmul A r b - TensorProduct.tmul A (1 : R) (a • b) =
          TensorProduct.tmul A (r - algebraMap A R a) (1 : B') * TensorProduct.tmul A (1 : R) b := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, TensorProduct.sub_tmul,
          TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.algebraMap_eq_smul_one]
      rw [h1]
      exact P.mul_mem_right _ (hP _ ha)
    | add x y hx hy =>
      obtain ⟨b₁, hb₁⟩ := hx
      obtain ⟨b₂, hb₂⟩ := hy
      refine ⟨b₁ + b₂, fun P hP => ?_⟩
      have h1 : x + y - TensorProduct.tmul A (1 : R) (b₁ + b₂) =
          (x - TensorProduct.tmul A (1 : R) b₁) + (y - TensorProduct.tmul A (1 : R) b₂) := by
        rw [TensorProduct.tmul_add]; abel
      rw [h1]
      exact P.add_mem (hb₁ P hP) (hb₂ P hP)
  have huniq : ∀ P P' : Ideal (TensorProduct A R B'),
      (∀ r : R, ¬ IsUnit r → TensorProduct.tmul A r (1 : B') ∈ P) →
      (∀ r : R, ¬ IsUnit r → TensorProduct.tmul A r (1 : B') ∈ P') →
      (∀ b : B', TensorProduct.tmul A (1 : R) b ∈ P → TensorProduct.tmul A (1 : R) b ∈ P') →
      P ≤ P' := by
    intro P P' hP hP' hb t ht
    obtain ⟨b, hb'⟩ := hkey t
    have h1 : TensorProduct.tmul A (1 : R) b ∈ P := by
      have := P.sub_mem ht (hb' P hP)
      rwa [sub_sub_cancel] at this
    have h2 := P'.add_mem (hb' P' hP') (hb b h1)
    rwa [sub_add_cancel] at h2

  have hunit : ∀ x : B', IsUnit (Ideal.Quotient.mk n x) ↔ x ∉ n := by
    intro x
    letI := Ideal.Quotient.field n
    rw [isUnit_iff_ne_zero, Ne, Ideal.Quotient.eq_zero_iff_mem]
  have hHK : HenselianLocalRing (B' ⧸ n) := by
    letI := Ideal.Quotient.field n
    infer_instance
  obtain ⟨f, ⟨hf1, hf2⟩, -⟩ := hRuniv (B' ⧸ n) hHK
    ((Ideal.Quotient.mk n).comp (algebraMap A B')) (fun a => by
      rw [RingHom.comp_apply, hunit, hA])
  have hf0 : ∀ r : R, ¬ IsUnit r → f r = 0 := by
    intro r hr
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (f r)
    by_contra h
    rw [← hx] at h
    have hxn : x ∉ n := fun hx' => h (Ideal.Quotient.eq_zero_iff_mem.mpr hx')
    have hu : IsUnit (f r) := by rw [← hx]; exact (hunit x).mpr hxn
    exact hr (isUnit_of_map_unit f r hu)
  let fA : R →ₐ[A] B' ⧸ n :=
    { f with
      commutes' := fun a => by
        show f (algebraMap A R a) = Ideal.Quotient.mk n (algebraMap A B' a)
        rw [← RingHom.comp_apply, hf1, RingHom.comp_apply] }
  let Φ0 : TensorProduct A R B' →ₐ[A] B' ⧸ n :=
    Algebra.TensorProduct.productMap fA (Ideal.Quotient.mkₐ A n)
  have hΦ0 : ∀ (r : R) (b : B'), Φ0 (TensorProduct.tmul A r b) = f r * Ideal.Quotient.mk n b := by
    intro r b
    rw [Algebra.TensorProduct.productMap_apply_tmul]
    rfl
  have hΦ0s : Function.Surjective Φ0 := by
    intro y
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨TensorProduct.tmul A (1 : R) b, by rw [hΦ0, map_one, one_mul]⟩
  have hmax : (RingHom.ker Φ0).IsMaximal := by
    letI := Ideal.Quotient.field n
    exact RingHom.ker_isMaximal_of_surjective Φ0 hΦ0s
  have hNr : ∀ r : R, ¬ IsUnit r → TensorProduct.tmul A r (1 : B') ∈ RingHom.ker Φ0 := by
    intro r hr
    rw [RingHom.mem_ker, hΦ0, hf0 r hr, zero_mul]
  have hNb : ∀ b : B', TensorProduct.tmul A (1 : R) b ∈ RingHom.ker Φ0 ↔ b ∈ n := by
    intro b
    rw [RingHom.mem_ker, hΦ0, map_one, one_mul, Ideal.Quotient.eq_zero_iff_mem]

  obtain ⟨i, hi⟩ : ∃ i, e i ∉ RingHom.ker Φ0 := by
    by_contra h
    push_neg at h
    apply hmax.ne_top
    rw [Ideal.eq_top_iff_one, ← he3]
    exact Ideal.sum_mem _ (fun j _ => h j)
  haveI : IsLocalRing (Localization.Away (e i)) := he4 i

  have hsurj : Function.Surjective
      (algebraMap (TensorProduct A R B') (Localization.Away (e i))) :=
    IsLocalization.Away.algebraMap_surjective_of_isIdempotentElem (e i) (he1 i)
  have hker : ∀ t, algebraMap (TensorProduct A R B') (Localization.Away (e i)) t = 0 →
      t ∈ RingHom.ker Φ0 := by
    intro t ht
    obtain ⟨⟨m, hm⟩, hmt⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers (e i)) _ t).mp ht
    obtain ⟨j, rfl⟩ := hm
    have h0 : (e i) ^ j * t ∈ RingHom.ker Φ0 := by
      simp only at hmt
      rw [hmt]; exact Ideal.zero_mem _
    rcases hmax.isPrime.mem_or_mem h0 with h | h
    · exact absurd (hmax.isPrime.mem_of_pow_mem j h) hi
    · exact h
  have hmem : ∀ t, t ∈ RingHom.ker Φ0 ↔
      ¬ IsUnit (algebraMap (TensorProduct A R B') (Localization.Away (e i)) t) := by
    have hnu : ∀ t ∈ RingHom.ker Φ0,
        ¬ IsUnit (algebraMap (TensorProduct A R B') (Localization.Away (e i)) t) := by
      intro t ht hu
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      obtain ⟨s, rfl⟩ := hsurj v
      have h1 : 1 - t * s ∈ RingHom.ker Φ0 := hker _ (by rw [map_sub, map_one, map_mul, hv, sub_self])
      have h2 := (RingHom.ker Φ0).add_mem h1 ((RingHom.ker Φ0).mul_mem_right s ht)
      rw [sub_add_cancel] at h2
      exact hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h2)
    intro t
    refine ⟨hnu t, fun h => ?_⟩
    by_contra ht
    obtain ⟨y, j, hj, hyj⟩ := hmax.exists_inv ht
    apply h
    have h1 : algebraMap (TensorProduct A R B') (Localization.Away (e i)) y *
        algebraMap (TensorProduct A R B') (Localization.Away (e i)) t =
        1 - algebraMap (TensorProduct A R B') (Localization.Away (e i)) j := by
      rw [← map_mul, ← map_one (algebraMap (TensorProduct A R B') (Localization.Away (e i))),
        ← hyj, map_add, add_sub_cancel_right]
    have h2 : IsUnit (1 - algebraMap (TensorProduct A R B') (Localization.Away (e i)) j) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ (hnu j hj)
    rw [← h1] at h2
    exact isUnit_of_mul_isUnit_right h2
  have hB : ∀ b : B', IsUnit (algebraMap (TensorProduct A R B') (Localization.Away (e i))
      (TensorProduct.tmul A (1 : R) b)) ↔ b ∉ n := by
    intro b
    rw [← hNb, hmem, not_not]
  have hRnu : ∀ r : R, ¬ IsUnit r → ¬ IsUnit (algebraMap (TensorProduct A R B')
      (Localization.Away (e i)) (TensorProduct.tmul A r (1 : B'))) :=
    fun r hr => (hmem _).mp (hNr r hr)

  letI : Algebra B' L := β.toAlgebra
  haveI := hloc
  have hβ : ∀ b, algebraMap B' L b = β b := fun b => rfl
  have hg : ∀ y : n.primeCompl, IsUnit (((algebraMap (TensorProduct A R B')
      (Localization.Away (e i))).comp
      (Algebra.TensorProduct.includeRight : B' →ₐ[A] TensorProduct A R B').toRingHom) y) := by
    intro y
    exact (hB y).mpr y.2
  let eL : L →+* Localization.Away (e i) := IsLocalization.lift (M := n.primeCompl) hg
  have heL : ∀ b : B', eL (β b) = algebraMap (TensorProduct A R B') (Localization.Away (e i))
      (TensorProduct.tmul A (1 : R) b) := by
    intro b
    rw [← hβ]
    exact IsLocalization.lift_eq hg b
  refine ⟨e i, eL, he1 i, ?_, heL⟩

  have hLunit : ∀ b : B', IsUnit (β b) ↔ b ∉ n := by
    intro b
    rw [← hβ, IsLocalization.AtPrime.isUnit_to_map_iff L n b]
    rfl
  refine ⟨?_, ?_, ?_⟩
  ·
    have hfinS : Module.Finite R (Localization.Away (e i)) :=
      Module.Finite.of_surjective
        (IsScalarTower.toAlgHom R (TensorProduct A R B') (Localization.Away (e i))).toLinearMap
        hsurj
    have hlocS : IsLocalHom (algebraMap R (Localization.Away (e i))) := by
      refine ⟨fun r hr => ?_⟩
      by_contra hn'
      apply hRnu r hn'
      rw [IsScalarTower.algebraMap_apply R (TensorProduct A R B') (Localization.Away (e i))] at hr
      exact hr
    exact wc_finite_local_henselian R Lft (Localization.Away (e i)) hfinS hlocS
  ·
    intro x
    rw [IsLocalRing.notMem_maximalIdeal]
    obtain ⟨⟨b, s⟩, hx⟩ := IsLocalization.surj n.primeCompl x
    simp only [hβ] at hx
    have hs : IsUnit (β s) := (hLunit s).mpr s.2
    have hes : IsUnit (eL (β s)) := by rw [heL]; exact (hB s).mpr s.2
    have h1 : IsUnit x ↔ b ∉ n := by
      rw [← hLunit, ← hx, IsUnit.mul_iff]
      exact ⟨fun h => ⟨h, hs⟩, fun h => h.1⟩
    have h2 : IsUnit (eL x) ↔ b ∉ n := by
      rw [← hB, ← heL, ← hx, map_mul, IsUnit.mul_iff]
      exact ⟨fun h => ⟨h, hes⟩, fun h => h.1⟩
    rw [h1, h2]
  ·
    intro C _ hC g hgC
    haveI := hC
    let φ₀ : A →+* C := g.comp (β.comp (algebraMap A B'))
    have hφ₀ : ∀ a : A, IsUnit (φ₀ a) ↔ a ∉ IsLocalRing.maximalIdeal A := by
      intro a
      show IsUnit (g (β (algebraMap A B' a))) ↔ _
      rw [hgC, IsLocalRing.notMem_maximalIdeal, hLunit, hA]
    obtain ⟨φ, ⟨hφ1, hφ2⟩, hφu⟩ := hRuniv C hC φ₀ hφ₀
    letI : Algebra A C := φ₀.toAlgebra
    let φA : R →ₐ[A] C :=
      { φ with
        commutes' := fun a => by
          show φ (algebraMap A R a) = φ₀ a
          rw [← hφ1, RingHom.comp_apply] }
    let gA : B' →ₐ[A] C :=
      { g.comp β with
        commutes' := fun a => rfl }
    let Φ : TensorProduct A R B' →ₐ[A] C := Algebra.TensorProduct.productMap φA gA
    have hΦ : ∀ (r : R) (b : B'), Φ (TensorProduct.tmul A r b) = φ r * g (β b) := by
      intro r b
      rw [Algebra.TensorProduct.productMap_apply_tmul]
      rfl
    have hPr : ∀ r : R, ¬ IsUnit r →
        TensorProduct.tmul A r (1 : B') ∈ Ideal.comap Φ (IsLocalRing.maximalIdeal C) := by
      intro r hr
      rw [Ideal.mem_comap, hΦ, map_one, map_one, mul_one, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff]
      exact fun hu => hr (isUnit_of_map_unit φ r hu)
    have hPb : ∀ b : B', TensorProduct.tmul A (1 : R) b ∈
        Ideal.comap Φ (IsLocalRing.maximalIdeal C) ↔ b ∈ n := by
      intro b
      rw [Ideal.mem_comap, hΦ, map_one, one_mul, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        hgC, IsLocalRing.notMem_maximalIdeal, hLunit, not_not]
    have hPeq : Ideal.comap Φ (IsLocalRing.maximalIdeal C) = RingHom.ker Φ0 := by
      apply le_antisymm
      · exact huniq _ _ hPr hNr (fun b hb => (hNb b).mpr ((hPb b).mp hb))
      · exact huniq _ _ hNr hPr (fun b hb => (hPb b).mpr ((hNb b).mp hb))
    have hΦmem : ∀ t, IsUnit (Φ t) ↔
        IsUnit (algebraMap (TensorProduct A R B') (Localization.Away (e i)) t) := by
      intro t
      have := hmem t
      rw [← hPeq, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at this
      exact not_iff_not.mp this
    have hΦε : IsUnit (Φ (e i)) :=
      (hΦmem _).mpr (IsLocalization.Away.algebraMap_isUnit (e i))
    have hpow : ∀ y : Submonoid.powers (e i), IsUnit ((Φ : TensorProduct A R B' →+* C) y) := by
      rintro ⟨y, j, rfl⟩
      show IsUnit (Φ ((e i) ^ j))
      rw [map_pow]
      exact hΦε.pow j
    let h : Localization.Away (e i) →+* C :=
      IsLocalization.lift (M := Submonoid.powers (e i)) hpow
    have hh : ∀ t, h (algebraMap (TensorProduct A R B') (Localization.Away (e i)) t) = Φ t :=
      fun t => IsLocalization.lift_eq hpow t
    have hhπ : h.comp (algebraMap (TensorProduct A R B') (Localization.Away (e i))) =
        (Φ : TensorProduct A R B' →+* C) := RingHom.ext hh
    refine ⟨h, ⟨?_, ?_⟩, ?_⟩
    · apply IsLocalization.ringHom_ext n.primeCompl
      ext b
      simp only [RingHom.comp_apply]
      rw [hβ, heL, hh, hΦ, map_one, one_mul]
    · refine ⟨fun y hy => ?_⟩
      obtain ⟨t, rfl⟩ := hsurj y
      rw [hh] at hy
      exact (hΦmem t).mp hy
    · rintro h' ⟨hh'1, hh'2⟩
      let ψ : R →+* C := (h'.comp (algebraMap (TensorProduct A R B') (Localization.Away (e i)))).comp
        (algebraMap R (TensorProduct A R B'))
      have hψr : ∀ r, ψ r = h' (algebraMap (TensorProduct A R B') (Localization.Away (e i))
          (TensorProduct.tmul A r (1 : B'))) := fun r => rfl
      have hψ1 : ψ.comp (algebraMap A R) = φ₀ := by
        ext a
        rw [RingHom.comp_apply, hψr]
        have e1 : TensorProduct.tmul A (algebraMap A R a) (1 : B') =
            TensorProduct.tmul A (1 : R) (algebraMap A B' a) := by
          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul]
        rw [e1, ← heL, ← RingHom.comp_apply h' eL, hh'1]
        rfl
      have hψ2 : IsLocalHom ψ := by
        refine ⟨fun r hr => ?_⟩
        rw [hψr] at hr
        by_contra hn'
        exact hRnu r hn' (isUnit_of_map_unit h' _ hr)
      have hψφ : ψ = φ := hφu ψ ⟨hψ1, hψ2⟩
      have hcomp : h'.comp (algebraMap (TensorProduct A R B') (Localization.Away (e i))) =
          (Φ : TensorProduct A R B' →+* C) := by
        apply RingHom.ext
        intro t
        induction t using TensorProduct.induction_on with
        | zero => simp only [map_zero]
        | tmul r b =>
          have e2 : TensorProduct.tmul A r b =
              TensorProduct.tmul A r (1 : B') * TensorProduct.tmul A (1 : R) b := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [RingHom.comp_apply, e2, map_mul, map_mul, ← hψr, hψφ, ← heL,
            ← RingHom.comp_apply h' eL, hh'1]
          show φ r * g (β b) = Φ (TensorProduct.tmul A r (1 : B') * TensorProduct.tmul A (1 : R) b)
          rw [← e2, hΦ]
        | add x y hx hy =>
          rw [map_add, map_add, hx, hy]
      exact IsLocalization.ringHom_ext (Submonoid.powers (e i)) (hcomp.trans hhπ.symm)

theorem wcpa_dj_lr1k_ebntbp_hens_core : ∀ (A₁ A₂ : Type u) [CommRing A₁] [IsLocalRing A₁]
    [CommRing A₂] [IsLocalRing A₂] (ψ : A₁ →+* A₂), IsLocalHom ψ →
    ∀ (P₁ : Type u) [CommRing P₁] (e₁ : A₁ →+* P₁),
      wcNdIsHens (IsLocalRing.maximalIdeal A₁) P₁ e₁ →
    ∀ (P₂ : Type u) [CommRing P₂] (e₂ : A₂ →+* P₂),
      wcNdIsHens (IsLocalRing.maximalIdeal A₂) P₂ e₂ →
    ∀ (h : P₁ →+* P₂), IsLocalHom h → h.comp e₁ = e₂.comp ψ →
    ∀ (B : Type u) [CommRing B] [Algebra A₁ B], Module.Finite A₁ B →
    ∀ (n : Ideal B) (hn : n.IsMaximal) (V : Type u) [CommRing V] [IsDomain V]
      [IsIntegrallyClosed V] (β : B →+* V),
      @IsLocalization B _ (@Ideal.primeCompl B _ n hn.isPrime) V _ β.toAlgebra →
    ∀ (lm : A₂ →+* V), (∀ a, IsUnit (lm a) ↔ a ∉ IsLocalRing.maximalIdeal A₂) →
      β.comp (algebraMap A₁ B) = lm.comp ψ →
      (∀ b : B, ∃ a c : A₁, lm (ψ c) ≠ 0 ∧ β b * lm (ψ c) = lm (ψ a)) →
    ∃ 𝔔 : Ideal P₂, 𝔔.IsPrime ∧ (∀ a : A₂, e₂ a ∈ 𝔔 ↔ lm a = 0) ∧
      (∀ q : P₂, ∃ a b : P₁, h b ∉ 𝔔 ∧ q * h b - h a ∈ 𝔔) :=
by
  intro A₁ A₂ _ _ _ _ ψ hψ P₁ _ e₁ he₁ P₂ _ e₂ he₂ h hh hcomm B _ _ hBfin n hn V _ _ _ β hloc
    lm hlmu hβ hfrac
  haveI := hψ
  haveI := hh
  letI : Algebra B V := β.toAlgebra
  haveI : n.IsPrime := hn.isPrime
  haveI : IsLocalization.AtPrime V n := hloc
  haveI : IsLocalRing V := IsLocalization.AtPrime.isLocalRing V n
  have hVunit : ∀ v : V, v ∉ IsLocalRing.maximalIdeal V ↔ IsUnit v := fun v => by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]

  obtain ⟨R, _, _, hRh, -, hRres⟩ := wcNd_hi_hens_exists_flat A₁
  haveI : HenselianLocalRing R := hRh.1

  obtain ⟨θ', ⟨hθ'c, hθ'l⟩, -⟩ := hRh.2.2 P₁ he₁.1 e₁ he₁.2.1
  haveI := hθ'l

  obtain ⟨ε, e, hε, heH, hβe⟩ := wcNd_hi_factor_hens A₁ R B V hRh hRres hBfin n hn β hloc
  haveI : HenselianLocalRing (Localization.Away ε) := heH.1

  have einj : Function.Injective e := by
    obtain ⟨RV, _, _, hRV, hRVflat, -⟩ := wcNd_hi_hens_exists_flat V
    haveI : HenselianLocalRing RV := hRV.1
    haveI : IsLocalHom (algebraMap V RV) := ⟨fun a ha => (hVunit a).mp ((hRV.2.1 a).mp ha)⟩
    haveI : Module.FaithfullyFlat V RV := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hinjRV : Function.Injective (algebraMap V RV) := by
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot]
      have := Ideal.comap_map_eq_self_of_faithfullyFlat (A := V) (B := RV) ⊥
      rwa [Ideal.map_bot] at this
    obtain ⟨τ, hτ, -⟩ := heH.2.2 RV hRV.1 (algebraMap V RV) hRV.2.1
    intro x y hxy
    apply hinjRV
    have e1 := RingHom.congr_fun hτ.1 x
    have e2 := RingHom.congr_fun hτ.1 y
    simp only [RingHom.comp_apply] at e1 e2
    rw [← e1, ← e2, hxy]

  obtain ⟨𝔓, h𝔓p, -, h𝔓S⟩ := Ideal.exists_le_prime_disjoint ⊥
    (Submonoid.map e (nonZeroDivisors V)) (by
      rw [Set.disjoint_left]
      intro x hx hxS
      have hx0 : x = 0 := by simpa using hx
      obtain ⟨v, hv, hvx⟩ := Submonoid.mem_map.mp hxS
      have hv0 : v = 0 := einj (by rw [hvx, hx0, map_zero])
      exact nonZeroDivisors.ne_zero hv hv0)
  have h𝔓 : ∀ v : V, e v ∈ 𝔓 ↔ v = 0 := by
    intro v
    constructor
    · intro hv
      by_contra hne
      exact Set.disjoint_left.mp h𝔓S hv
        (Submonoid.mem_map_of_mem e (mem_nonZeroDivisors_of_ne_zero hne))
    · rintro rfl
      rw [map_zero]
      exact 𝔓.zero_mem

  have hunit2 : ∀ a, IsUnit ((e.comp lm) a) ↔ a ∉ IsLocalRing.maximalIdeal A₂ := by
    intro a
    rw [RingHom.comp_apply, heH.2.1, hVunit, hlmu]
  obtain ⟨Φ₂, ⟨hΦ₂, hΦ₂l⟩, -⟩ := he₂.2.2 _ heH.1 (e.comp lm) hunit2
  haveI := hΦ₂l

  have hsurj : Function.Surjective
      (algebraMap (TensorProduct A₁ R B) (Localization.Away ε)) := by
    have hu : IsUnit (algebraMap (TensorProduct A₁ R B) (Localization.Away ε) ε) :=
      IsLocalization.Away.algebraMap_isUnit ε
    have hu1 : algebraMap (TensorProduct A₁ R B) (Localization.Away ε) ε = 1 :=
      (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp (by
        unfold IsIdempotentElem
        rw [← map_mul, hε.eq])
    intro z
    obtain ⟨k, a, hz⟩ := IsLocalization.Away.surj ε z
    exact ⟨a, by rw [← hz, hu1, one_pow, mul_one]⟩
  have hRT : ∀ r : R, algebraMap R (TensorProduct A₁ R B) r = r ⊗ₜ[A₁] (1 : B) := fun r => by
    first
      | rfl
      | (rw [Algebra.TensorProduct.algebraMap_apply]; rfl)
      | simp [Algebra.TensorProduct.algebraMap_apply]
  have hfinRT : (algebraMap R (TensorProduct A₁ R B)).Finite :=
    RingHom.finite_algebraMap.mpr (Module.Finite.base_change A₁ R B)
  have hρfin : ((algebraMap (TensorProduct A₁ R B) (Localization.Away ε)).comp
      (algebraMap R (TensorProduct A₁ R B))).Finite :=
    (RingHom.Finite.of_surjective _ hsurj).comp hfinRT
  have hρloc : IsLocalHom ((algebraMap (TensorProduct A₁ R B) (Localization.Away ε)).comp
      (algebraMap R (TensorProduct A₁ R B))) := by
    have hint := hρfin.to_isIntegral
    have hmax := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint
      (IsLocalRing.maximalIdeal (Localization.Away ε))
    have heq := IsLocalRing.eq_maximalIdeal hmax
    refine ⟨fun a ha => ?_⟩
    have h1 : ((algebraMap (TensorProduct A₁ R B) (Localization.Away ε)).comp
        (algebraMap R (TensorProduct A₁ R B))) a ∉ IsLocalRing.maximalIdeal _ := fun hm =>
      (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hm)) ha
    have h2 : a ∉ IsLocalRing.maximalIdeal R := by
      rw [← heq]
      exact h1
    by_contra hna
    exact h2 ((IsLocalRing.mem_maximalIdeal a).mpr (mem_nonunits_iff.mpr hna))

  have hlocψ : ∀ a, ψ a ∈ IsLocalRing.maximalIdeal A₂ ↔ a ∈ IsLocalRing.maximalIdeal A₁ := by
    intro a
    simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (isUnit_map_iff ψ a).not
  have hg₀ : ∀ a, IsUnit ((e.comp (lm.comp ψ)) a) ↔ a ∉ IsLocalRing.maximalIdeal A₁ := by
    intro a
    rw [← hlocψ]
    exact hunit2 (ψ a)
  have hρι : ∀ a : A₁, algebraMap (TensorProduct A₁ R B) (Localization.Away ε)
      ((algebraMap A₁ R a) ⊗ₜ[A₁] (1 : B)) = e (lm (ψ a)) := by
    intro a
    rw [Algebra.TensorProduct.tmul_one_eq_one_tmul, ← hβe]
    have e2 := RingHom.congr_fun hβ a
    simp only [RingHom.comp_apply] at e2
    rw [e2]
  obtain ⟨θ0, -, huniq⟩ := hRh.2.2 _ heH.1 (e.comp (lm.comp ψ)) hg₀
  haveI : IsLocalHom (Φ₂.comp h) := RingHom.isLocalHom_comp _ _
  haveI : IsLocalHom ((Φ₂.comp h).comp θ') := RingHom.isLocalHom_comp _ _
  have hρeq : (algebraMap (TensorProduct A₁ R B) (Localization.Away ε)).comp
      (algebraMap R (TensorProduct A₁ R B)) = (Φ₂.comp h).comp θ' := by
    have h1 := huniq ((algebraMap (TensorProduct A₁ R B) (Localization.Away ε)).comp
      (algebraMap R (TensorProduct A₁ R B))) ⟨RingHom.ext fun a => by
        simp only [RingHom.comp_apply]
        rw [hRT]
        exact hρι a, hρloc⟩
    have h2 := huniq ((Φ₂.comp h).comp θ') ⟨RingHom.ext fun a => by
        have e1 := RingHom.congr_fun hθ'c a
        have e2 := RingHom.congr_fun hcomm a
        have e3 := RingHom.congr_fun hΦ₂ (ψ a)
        simp only [RingHom.comp_apply] at e1 e2 e3 ⊢
        rw [e1, e2, e3], inferInstance⟩
    rw [h1, h2]
  have hρr : ∀ r : R, Φ₂ (h (θ' r)) =
      algebraMap (TensorProduct A₁ R B) (Localization.Away ε) (r ⊗ₜ[A₁] (1 : B)) := by
    intro r
    have := RingHom.congr_fun hρeq r
    simp only [RingHom.comp_apply] at this
    rw [hRT] at this
    exact this.symm

  have t1 : ∀ u v : R, (u * v) ⊗ₜ[A₁] (1 : B) = (u ⊗ₜ[A₁] (1 : B)) * (v ⊗ₜ[A₁] (1 : B)) :=
    fun u v => by rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
  have hfracT : ∀ x : TensorProduct A₁ R B, ∃ N D : R,
      algebraMap (TensorProduct A₁ R B) (Localization.Away ε) (D ⊗ₜ[A₁] (1 : B)) ∉ 𝔓 ∧
      algebraMap (TensorProduct A₁ R B) (Localization.Away ε) x *
        algebraMap (TensorProduct A₁ R B) (Localization.Away ε) (D ⊗ₜ[A₁] (1 : B)) =
      algebraMap (TensorProduct A₁ R B) (Localization.Away ε) (N ⊗ₜ[A₁] (1 : B)) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero =>
      refine ⟨0, 1, ?_, ?_⟩
      · rw [← Algebra.TensorProduct.one_def, map_one]
        exact fun h1 => h𝔓p.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      · rw [map_zero, zero_mul, TensorProduct.zero_tmul, map_zero]
    | tmul r b =>
      obtain ⟨a', c', hc', hbc⟩ := hfrac b
      refine ⟨r * algebraMap A₁ R a', algebraMap A₁ R c', ?_, ?_⟩
      · rw [hρι]
        exact fun hm => hc' ((h𝔓 _).mp hm)
      · have hsplit : r ⊗ₜ[A₁] b = (r ⊗ₜ[A₁] (1 : B)) * ((1 : R) ⊗ₜ[A₁] b) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsplit, t1, map_mul, map_mul, hρι, hρι, ← hβe, mul_assoc, ← map_mul e, hbc]
    | add x y hx hy =>
      obtain ⟨Nx, Dx, hDx, hx'⟩ := hx
      obtain ⟨Ny, Dy, hDy, hy'⟩ := hy
      refine ⟨Nx * Dy + Ny * Dx, Dx * Dy, ?_, ?_⟩
      · rw [t1, map_mul]
        intro hm
        rcases h𝔓p.mem_or_mem hm with h1 | h1
        exacts [hDx h1, hDy h1]
      · simp only [TensorProduct.add_tmul, t1, map_add, map_mul]
        linear_combination
          (algebraMap (TensorProduct A₁ R B) (Localization.Away ε) (Dy ⊗ₜ[A₁] (1 : B))) * hx' +
          (algebraMap (TensorProduct A₁ R B) (Localization.Away ε) (Dx ⊗ₜ[A₁] (1 : B))) * hy'

  refine ⟨𝔓.comap Φ₂, Ideal.IsPrime.comap Φ₂, ?_, ?_⟩
  · intro a
    rw [Ideal.mem_comap]
    have := RingHom.congr_fun hΦ₂ a
    simp only [RingHom.comp_apply] at this
    rw [this, h𝔓]
  · intro q
    obtain ⟨x, hx⟩ := hsurj (Φ₂ q)
    obtain ⟨N, D, hD, hND⟩ := hfracT x
    refine ⟨θ' N, θ' D, ?_, ?_⟩
    · rw [Ideal.mem_comap, hρr]
      exact hD
    · rw [Ideal.mem_comap, map_sub, map_mul, hρr, hρr, ← hx, hND, sub_self]
      exact 𝔓.zero_mem

theorem wcpa_dj_lr1k_ebnt_branch_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (X₁ X₂ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (u₂ : X₂ ⟶ Spec (.of ↥W))
      (ι₁ : wcProjK Ω 1 ⟶ X₁) (ι₂ : wcProjK Ω 1 ⟶ X₂),
    wcpaDjLkModel W u₁ ι₁ → wcpaDjLkModel W u₂ ι₂ →
    ∀ (U : X₂.Opens) (g : U.toScheme ⟶ X₁) (ι₂' : wcProjK Ω 1 ⟶ U.toScheme),
      g ≫ u₁ = U.ι ≫ u₂ → ι₂' ≫ U.ι = ι₂ → ι₂' ≫ g = ι₁ →
    ∀ (w₂ : ↥(Limits.pullback u₂
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))
      (w₁ : ↥(Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
      ¬ wcpaDjLkSmAt W u₂ w₂ → ¬ wcpaDjLkSmAt W u₁ w₁ →
    ∀ v₂ : ↥U.toScheme, U.ι v₂ = Limits.pullback.fst u₂
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₂ →
      g v₂ = Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₁ →
      (∃ z : ↥X₂, z ∈ U ∧
        z ⤳ Limits.pullback.fst u₂
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₂ ∧
        u₂ z = IsLocalRing.closedPoint ↥W ∧
        ∀ v : ↥U, U.ι v = z → g v ≠ Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₁) →
    ∀ (P₁ : Type u) [CommRing P₁] (e₁ : ↥(X₁.presheaf.stalk (g v₂)) →+* P₁),
      wcNdIsHens (IsLocalRing.maximalIdeal ↥(X₁.presheaf.stalk (g v₂))) P₁ e₁ →
    ∀ (P₂ : Type u) [CommRing P₂] (e₂ : ↥(U.toScheme.presheaf.stalk v₂) →+* P₂),
      wcNdIsHens (IsLocalRing.maximalIdeal ↥(U.toScheme.presheaf.stalk v₂)) P₂ e₂ →
    ∀ (h : P₁ →+* P₂), IsLocalHom h → h.comp e₁ = e₂.comp (g.stalkMap v₂).hom →
    ∃ 𝔔 : Ideal P₂, 𝔔.IsPrime ∧
      (∀ t ∈ IsLocalRing.maximalIdeal ↥W, (e₂.comp (wcNdSig (U.ι ≫ u₂) v₂)) t ∈ 𝔔) ∧
      (∃ t ∉ 𝔔, ¬ IsUnit t) ∧ (∃ t : P₁, h t ∉ 𝔔 ∧ ¬ IsUnit t) ∧
      (∀ q : P₂, ∃ a b : P₁, h b ∉ 𝔔 ∧ q * h b - h a ∈ 𝔔) :=
by
  intro Ω _ _ W hW hWt X₁ X₂ u₁ u₂ ι₁ ι₂ hM₁ hM₂ U g ι₂' hg hι₂' hgι w₂ w₁ hns₂ hns₁ v₂ hv₂
    hgv hz P₁ _ e₁ he₁ P₂ _ e₂ he₂ h hhloc hh
  obtain ⟨z, hzU, hzsp, hzc, hzx⟩ := hz
  let v' : ↥U.toScheme := ⟨z, hzU⟩
  have hv' : U.ι v' = z := rfl
  have hsp : v' ⤳ v₂ := by
    apply (U.ι.isOpenEmbedding.isInducing.specializes_iff).mp
    rw [hv', hv₂]
    exact hzsp
  have hne : g v' ≠ g v₂ := fun hh' => hzx v' hv' (hh'.trans hgv)
  obtain ⟨hi, ⟨s, hsm, hs⟩, ⟨s₁, hs₁m, hs₁⟩⟩ :=
    wcpa_dj_lr1k_ebntbp_points U.toScheme X₁ (U.ι ≫ u₂) g v₂ v' hsp hne
  have hzc' : u₂ (U.ι v') = IsLocalRing.closedPoint ↥W := by rw [hv']; exact hzc
  have hbir := wcpa_dj_lr1k_ebntbp_birational Ω W hW hWt X₁ X₂ u₁ u₂ ι₁ ι₂ hM₁ hM₂ U g ι₂'
    hg hι₂' hgι v₂ v' hsp hzc' hne
  obtain ⟨hnoeth, hdim, hfin⟩ := wcpa_dj_lr1k_ebntbp_branch_finite Ω W hW hWt X₁ X₂ u₁ u₂
    ι₁ ι₂ hM₁ hM₂ U g ι₂' hg hι₂' hgι v₂ v' hsp hzc' hne hbir
  obtain ⟨B, _, _, n, hn, V, _, _, _, β, lm, hBfin, hloc, hlmu, hβ, hBfrac, hlm0⟩ :=
    wcpa_dj_lr1k_ebntbp_branch_valuation _ _ _ (g.stalkMap v₂).hom inferInstance
      (U.toScheme.presheaf.stalkSpecializes hsp ≫ U.toScheme.residue v').hom
      ⟨s₁, hs₁m, hs₁⟩ hbir hnoeth hdim hfin
  obtain ⟨𝔔, h𝔔p, h𝔔, h𝔔frac⟩ := wcpa_dj_lr1k_ebntbp_hens_core _ _ (g.stalkMap v₂).hom
    inferInstance P₁ e₁ he₁ P₂ e₂ he₂ h hhloc hh B hBfin n hn V β hloc lm hlmu hβ hBfrac
  have key : ∀ a, e₂ a ∈ 𝔔 ↔
      (U.toScheme.presheaf.stalkSpecializes hsp ≫ U.toScheme.residue v').hom a = 0 :=
    fun a => (h𝔔 a).trans (hlm0 a)
  have hhs : h (e₁ s₁) = e₂ ((g.stalkMap v₂).hom s₁) := by
    rw [← RingHom.comp_apply, hh, RingHom.comp_apply]
  refine ⟨𝔔, h𝔔p, ?_, ⟨e₂ s, ?_, ?_⟩, ⟨e₁ s₁, ?_, ?_⟩, h𝔔frac⟩
  · intro t ht
    rw [RingHom.comp_apply, key]
    apply hi
    show t ∈ (u₂ (U.ι v')).asIdeal
    rw [hzc']
    exact ht
  · rw [key]; exact hs
  · exact fun hu => (he₂.2.1 s).mp hu hsm
  · rw [hhs, key]; exact hs₁
  · exact fun hu => (he₁.2.1 s₁).mp hu hs₁m

theorem wcpa_dj_lr1k_ebnt_pres_swap : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P), wcEbntPres W σ a f → ∃ f' : wcEbntN W a →+* P, wcEbntPres W σ a f' ∧ f' (wcEbntX W a 0) = f (wcEbntX W a 1) ∧ f' (wcEbntX W a 1) = f (wcEbntX W a 0) :=
by
  intro Ω _ W P _ σ a f hf
  classical
  let I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
  let ρ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W :=
    (MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1)).toRingHom
  have hρX0 : ρ (MvPolynomial.X 0) = MvPolynomial.X 1 := by
    simp [ρ, MvPolynomial.rename_X]
  have hρX1 : ρ (MvPolynomial.X 1) = MvPolynomial.X 0 := by
    simp [ρ, MvPolynomial.rename_X]
  have hρC : ∀ r, ρ (MvPolynomial.C r) = MvPolynomial.C r := by
    intro r; simp [ρ, MvPolynomial.rename_C]
  have hρρ : ∀ p, ρ (ρ p) = p := by
    intro p
    have e : (⇑(Equiv.swap (0 : Fin 2) 1) ∘ ⇑(Equiv.swap (0 : Fin 2) 1)) = id :=
      funext fun i => Equiv.swap_apply_self _ _ _
    show MvPolynomial.rename _ (MvPolynomial.rename _ p) = p
    rw [MvPolynomial.rename_rename, e]
    simp
  have hρg : ρ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) =
      MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a := by
    rw [map_sub, map_mul, hρX0, hρX1, hρC, mul_comm (MvPolynomial.X 1)]
  have hH : ∀ p ∈ I, (Ideal.Quotient.mk I).comp ρ p = 0 := by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    rw [RingHom.comp_apply, map_mul, hρg, map_mul,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), mul_zero]
  let s : wcEbntN W a →+* wcEbntN W a := Ideal.Quotient.lift I ((Ideal.Quotient.mk I).comp ρ) hH
  have hs : ∀ p, s (Ideal.Quotient.mk I p) = Ideal.Quotient.mk I (ρ p) := fun p =>
    Ideal.Quotient.lift_mk _ _ _
  have hss : ∀ t, s (s t) = t := by
    intro t
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
    rw [hs, hs, hρρ]
  let M : Ideal (wcEbntN W a) :=
    (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk I)
  have hsM1 : ∀ t ∈ M, s t ∈ M := by
    intro t ht
    have hle : M ≤ M.comap s := by
      apply Ideal.map_le_iff_le_comap.mpr
      apply sup_le
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | hx
        · show s (Ideal.Quotient.mk I (MvPolynomial.X 0)) ∈ M
          rw [hs, hρX0]
          exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
        · rw [Set.mem_singleton_iff] at hx
          subst hx
          show s (Ideal.Quotient.mk I (MvPolynomial.X 1)) ∈ M
          rw [hs, hρX1]
          exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span (by simp)))
      · apply Ideal.map_le_iff_le_comap.mpr
        intro r hr
        show s (Ideal.Quotient.mk I (MvPolynomial.C r)) ∈ M
        rw [hs, hρC]
        exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hr))
    exact hle ht
  have hsM : ∀ t, s t ∈ M ↔ t ∈ M := by
    intro t
    refine ⟨fun h => ?_, hsM1 t⟩
    have := hsM1 _ h
    rwa [hss] at this
  unfold wcEbntPres wcNdIsHens at hf ⊢
  obtain ⟨ha, ha0, hσ, hHen, hU, hUP⟩ := hf
  refine ⟨f.comp s, ⟨ha, ha0, ?_, hHen, ?_, ?_⟩, ?_, ?_⟩
  · rw [← hσ]
    apply RingHom.ext
    intro r
    show f (s (Ideal.Quotient.mk I (MvPolynomial.C r))) = f (Ideal.Quotient.mk I (MvPolynomial.C r))
    rw [hs, hρC]
  · intro t
    exact (hU (s t)).trans (not_congr (hsM t))
  · intro B _ hB g hg
    have hg' : ∀ t, IsUnit ((g.comp s) t) ↔ t ∉ M := fun t =>
      (hg (s t)).trans (not_congr (hsM t))
    obtain ⟨k, ⟨hk, hkl⟩, hku⟩ := hUP B hB (g.comp s) hg'
    refine ⟨k, ⟨?_, hkl⟩, fun k' hk' => hku k' ⟨?_, hk'.2⟩⟩
    · apply RingHom.ext
      intro t
      have := RingHom.congr_fun hk (s t)
      simp only [RingHom.comp_apply] at this ⊢
      rw [this, hss]
    · apply RingHom.ext
      intro t
      have := RingHom.congr_fun hk'.1 (s t)
      simp only [RingHom.comp_apply] at this ⊢
      rw [hss] at this
      exact this
  · show f (s (Ideal.Quotient.mk I (MvPolynomial.X 0))) = f (Ideal.Quotient.mk I (MvPolynomial.X 1))
    rw [hs, hρX0]
  · show f (s (Ideal.Quotient.mk I (MvPolynomial.X 1))) = f (Ideal.Quotient.mk I (MvPolynomial.X 0))
    rw [hs, hρX1]

theorem wcNd_hens_quotient : ∀ (A : Type u) [CommRing A] (p 𝔞 : Ideal A) (P : Type u) [CommRing P] (e : A →+* P), wcNdIsHens p P e → 𝔞 ≤ p → wcNdIsHens (p.map (Ideal.Quotient.mk 𝔞)) (P ⧸ 𝔞.map e) (Ideal.quotientMap (𝔞.map e) e Ideal.le_comap_map) :=
by
  intro A _ p 𝔞 P _ e he h𝔞
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (I : Ideal R), I ≠ ⊤ →
      HenselianLocalRing (R ⧸ I) := by
    intro R _ _ I hI
    haveI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    have hsurj : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
    haveI : IsLocalRing (R ⧸ I) := IsLocalRing.of_surjective' _ hsurj
    haveI : IsLocalHom (Ideal.Quotient.mk I) := IsLocalHom.of_surjective _ hsurj
    refine HenselianLocalRing.mk ?_
    intro g hg a₀ ha₀ hd
    have hlift : g ∈ Polynomial.lifts (Ideal.Quotient.mk I) :=
      (Polynomial.mem_lifts g).mpr (Polynomial.map_surjective _ hsurj g)
    obtain ⟨G, hGg, -, hGm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hg
    obtain ⟨b₀, rfl⟩ := hsurj a₀
    have e1 : Ideal.Quotient.mk I (G.eval b₀) = g.eval (Ideal.Quotient.mk I b₀) := by
      rw [← hGg, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have e2 : Ideal.Quotient.mk I ((Polynomial.derivative G).eval b₀) =
        (Polynomial.derivative g).eval (Ideal.Quotient.mk I b₀) := by
      rw [← hGg, Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have h1 : G.eval b₀ ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have := hu.map (Ideal.Quotient.mk I)
      rw [e1] at this
      exact (IsLocalRing.mem_maximalIdeal _).mp ha₀ this
    have h2 : IsUnit ((Polynomial.derivative G).eval b₀) := by
      rw [← isUnit_map_iff (Ideal.Quotient.mk I), e2]; exact hd
    obtain ⟨b, hb, hbb⟩ := HenselianLocalRing.is_henselian G hGm b₀ h1 h2
    refine ⟨Ideal.Quotient.mk I b, ?_, ?_⟩
    · rw [← hGg]; exact Polynomial.IsRoot.map hb
    · rw [← map_sub]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hbb ⊢
      intro hu; exact hbb ((isUnit_map_iff _ _).mp hu)
  obtain ⟨hH, hU, hUP⟩ := he
  haveI := hH

  have hJle : 𝔞.map e ≤ IsLocalRing.maximalIdeal P := by
    rw [Ideal.map_le_iff_le_comap]
    intro t ht
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (hU t).mp hu (h𝔞 ht)
  have hJne : 𝔞.map e ≠ ⊤ := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal P).ne_top (eq_top_iff.mpr (h ▸ hJle))
  haveI : Nontrivial (P ⧸ 𝔞.map e) := Ideal.Quotient.nontrivial_iff.mpr hJne
  have hsurj : Function.Surjective (Ideal.Quotient.mk (𝔞.map e)) := Ideal.Quotient.mk_surjective
  haveI hπ : IsLocalHom (Ideal.Quotient.mk (𝔞.map e)) := IsLocalHom.of_surjective _ hsurj
  have hHq : HenselianLocalRing (P ⧸ 𝔞.map e) := s1 P (𝔞.map e) hJne

  have hM : ∀ t : A, Ideal.Quotient.mk 𝔞 t ∈ p.map (Ideal.Quotient.mk 𝔞) ↔ t ∈ p := by
    intro t
    constructor
    · intro ht
      have : t ∈ (p.map (Ideal.Quotient.mk 𝔞)).comap (Ideal.Quotient.mk 𝔞) :=
        Ideal.mem_comap.mpr ht
      rwa [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr h𝔞] at this
    · exact Ideal.mem_map_of_mem _
  have hē : ∀ t : A, Ideal.quotientMap (𝔞.map e) e Ideal.le_comap_map (Ideal.Quotient.mk 𝔞 t) =
      Ideal.Quotient.mk (𝔞.map e) (e t) := fun t => Ideal.quotientMap_mk
  refine ⟨hHq, ?_, ?_⟩
  · intro a
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [hē, isUnit_map_iff, hU, hM]
  · intro B _ hB g hg
    have hg0 : ∀ t, IsUnit ((g.comp (Ideal.Quotient.mk 𝔞)) t) ↔ t ∉ p := by
      intro t
      rw [RingHom.comp_apply, hg, hM]
    obtain ⟨h, ⟨hhe, hhl⟩, huniq⟩ := hUP B hB (g.comp (Ideal.Quotient.mk 𝔞)) hg0
    have hJker : ∀ z ∈ 𝔞.map e, h z = 0 := by
      have hle : 𝔞.map e ≤ RingHom.ker h := by
        rw [Ideal.map_le_iff_le_comap]
        intro t ht
        rw [Ideal.mem_comap, RingHom.mem_ker]
        have := RingHom.congr_fun hhe t
        rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr ht,
          map_zero] at this
        exact this
      exact fun z hz => RingHom.mem_ker.mp (hle hz)
    refine ⟨Ideal.Quotient.lift (𝔞.map e) h hJker, ⟨?_, ?_⟩, ?_⟩
    · apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun t => ?_
      simp only [RingHom.comp_apply]
      rw [hē, Ideal.Quotient.lift_mk]
      exact RingHom.congr_fun hhe t
    · refine ⟨fun x hx => ?_⟩
      obtain ⟨z, rfl⟩ := hsurj x
      rw [Ideal.Quotient.lift_mk] at hx
      exact (isUnit_of_map_unit h z hx).map _
    · rintro h' ⟨h1', h2'⟩
      haveI := h2'
      have hloc : IsLocalHom (h'.comp (Ideal.Quotient.mk (𝔞.map e))) := inferInstance
      have heq : h'.comp (Ideal.Quotient.mk (𝔞.map e)) = h := by
        refine huniq _ ⟨RingHom.ext fun t => ?_, hloc⟩
        have := RingHom.congr_fun h1' (Ideal.Quotient.mk 𝔞 t)
        simp only [RingHom.comp_apply] at this ⊢
        rw [hē] at this
        exact this
      apply Ideal.Quotient.ringHom_ext
      rw [heq, Ideal.Quotient.lift_comp_mk]

theorem wcNd_line_hens_dvr : ∀ (k : Type u) [Field k] (H : Type u) [CommRing H] (e : Polynomial k →+* H), wcNdIsHens (Ideal.span {Polynomial.X}) H e → ∃ (_ : IsDomain H), IsDiscreteValuationRing H ∧ Irreducible (e Polynomial.X) :=
by
  intro k _ H _ e hE
  classical
  generalize hp : Ideal.span {(Polynomial.X : Polynomial k)} = p at hE
  haveI hpr : p.IsPrime := by
    rw [← hp]
    exact (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr Polynomial.prime_X

  have hne : p ≠ ⊥ := by
    rw [← hp]
    exact Ideal.span_singleton_eq_bot.not.mpr Polynomial.X_ne_zero
  haveI hdvrO : IsDiscreteValuationRing (Localization.AtPrime p) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (Polynomial k) hne
      (Localization.AtPrime p)
  have hirrO : Irreducible (algebraMap (Polynomial k) (Localization.AtPrime p) Polynomial.X) := by
    rw [IsDiscreteValuationRing.irreducible_iff_uniformizer, ← Localization.AtPrime.map_eq_maximalIdeal]
    have hmp : Ideal.map (algebraMap (Polynomial k) (Localization.AtPrime p)) p =
        Ideal.map (algebraMap (Polynomial k) (Localization.AtPrime p))
          (Ideal.span {(Polynomial.X : Polynomial k)}) := by rw [hp]
    rw [hmp, Ideal.map_span, Set.image_singleton]

  obtain ⟨H₀, _, hhens, hnoeth, ι, hloc, hres, hmax, hUP₀, hwe⟩ :=
    wc_lfi_henselization_weaklyEtale (Localization.AtPrime p)
  haveI := hloc
  haveI := hhens
  obtain ⟨hdom₀, hdvr₀, -, hirrι, -⟩ :=
    wc_hss_henselization_is_dvr (Localization.AtPrime p) H₀ ι hres hmax hwe
  haveI := hdom₀
  haveI := hdvr₀

  obtain ⟨hH, hU, hUP⟩ := hE
  haveI := hH
  have hU₀ : ∀ a, IsUnit ((ι.comp (algebraMap (Polynomial k) (Localization.AtPrime p))) a) ↔
      a ∉ p := by
    intro a
    rw [RingHom.comp_apply, isUnit_map_iff ι,
      IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime p) p a,
      Ideal.mem_primeCompl_iff]
  obtain ⟨h, ⟨hhe, hhloc⟩, -⟩ :=
    hUP H₀ hhens (ι.comp (algebraMap (Polynomial k) (Localization.AtPrime p))) hU₀
  haveI := hhloc
  have hunit : ∀ y : p.primeCompl, IsUnit (e y) := fun y => (hU y).mpr y.2
  let e' : Localization.AtPrime p →+* H :=
    IsLocalization.lift (M := p.primeCompl) (S := Localization.AtPrime p) hunit
  have hl : ∀ a, e' (algebraMap (Polynomial k) (Localization.AtPrime p) a) = e a :=
    fun a => IsLocalization.lift_eq hunit a
  have he' : e'.comp (algebraMap (Polynomial k) (Localization.AtPrime p)) = e :=
    RingHom.ext hl
  haveI he'loc : IsLocalHom e' := by
    refine ⟨fun z hz => ?_⟩
    obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj p.primeCompl z
    dsimp only at hts
    have h1 : e' z * e s = e t := by
      rw [← hl s, ← map_mul, hts, hl]
    have h2 : IsUnit (e t) := h1 ▸ hz.mul (hunit s)
    have h3 : t ∉ p := (hU t).mp h2
    have h4 : IsUnit (algebraMap (Polynomial k) (Localization.AtPrime p) t) := by
      rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime p) p t,
        Ideal.mem_primeCompl_iff]
      exact h3
    rw [← hts] at h4
    exact isUnit_of_mul_isUnit_left h4
  obtain ⟨h', ⟨hh'loc, hh'ι⟩, -⟩ := hUP₀ H e' he'loc
  haveI := hh'loc
  have hhe' : h.comp e' = ι := by
    apply IsLocalization.ringHom_ext p.primeCompl
    rw [RingHom.comp_assoc, he', hhe]
  have hcomp1 : h.comp h' = RingHom.id H₀ := by
    obtain ⟨u, -, huniq⟩ := hUP₀ H₀ ι hloc
    have a1 := huniq (h.comp h') ⟨RingHom.isLocalHom_comp h h',
      by rw [RingHom.comp_assoc, hh'ι, hhe']⟩
    have a2 := huniq (RingHom.id H₀) ⟨isLocalHom_id H₀, RingHom.id_comp ι⟩
    exact a1.trans a2.symm
  have hcomp2 : h'.comp h = RingHom.id H := by
    obtain ⟨u, -, huniq⟩ := hUP H hH e hU
    have a1 := huniq (h'.comp h) ⟨by rw [RingHom.comp_assoc, hhe, ← RingHom.comp_assoc, hh'ι, he'],
      RingHom.isLocalHom_comp h' h⟩
    have a2 := huniq (RingHom.id H) ⟨RingHom.id_comp e, isLocalHom_id H⟩
    exact a1.trans a2.symm
  let ψ : H₀ ≃+* H := RingEquiv.ofRingHom h' h hcomp2 hcomp1
  have hψ : ∀ a, ψ (ι (algebraMap (Polynomial k) (Localization.AtPrime p) a)) = e a := by
    intro a
    show h' (ι (algebraMap (Polynomial k) (Localization.AtPrime p) a)) = e a
    rw [← RingHom.comp_apply h' ι, hh'ι, hl]
  haveI hdomH : IsDomain H := MulEquiv.isDomain H₀ ψ.symm.toMulEquiv
  refine ⟨hdomH, IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing ψ, ?_⟩
  rw [← hψ]
  exact (hirrι _ hirrO).map ψ

theorem wcpa_dj_lr1k_ebnt_branch_base_iso : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (a : R), a ∈ IsLocalRing.maximalIdeal R → ∃ Φ : ((MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ⧸ (Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) R)} ⊔ (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))) ≃+* Polynomial (IsLocalRing.ResidueField R), Φ (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.X 0))) = Polynomial.X ∧ Ideal.map Φ (((Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) R), MvPolynomial.X 1} ⊔ (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))).map (Ideal.Quotient.mk _)) = Ideal.span {Polynomial.X} :=
by
  intro R _ _ a ha
  classical
  set I₀ : Ideal (MvPolynomial (Fin 2) R) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a} with hI₀
  set I₁ : Ideal (MvPolynomial (Fin 2) R) :=
    Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) R)} ⊔
      (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R) with hI₁
  set 𝔞 : Ideal (MvPolynomial (Fin 2) R ⧸ I₀) := I₁.map (Ideal.Quotient.mk I₀) with h𝔞
  have hres : ∀ c ∈ IsLocalRing.maximalIdeal R, IsLocalRing.residue R c = 0 :=
    fun c hc => (IsLocalRing.residue_eq_zero_iff c).mpr hc
  let ψ : MvPolynomial (Fin 2) R →+* Polynomial (IsLocalRing.ResidueField R) :=
    MvPolynomial.eval₂Hom (Polynomial.C.comp (IsLocalRing.residue R)) ![Polynomial.X, 0]
  have hψX0 : ψ (MvPolynomial.X 0) = Polynomial.X := by simp [ψ]
  have hψX1 : ψ (MvPolynomial.X 1) = 0 := by simp [ψ]
  have hψC : ∀ c, ψ (MvPolynomial.C c) = Polynomial.C (IsLocalRing.residue R c) := by
    intro c; simp [ψ]
  have hψ0 : ∀ p ∈ I₀, ψ p = 0 := by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    rw [map_mul, map_sub, map_mul, hψX0, hψX1, hψC, hres a ha]
    simp
  let ψ₀ : (MvPolynomial (Fin 2) R ⧸ I₀) →+* Polynomial (IsLocalRing.ResidueField R) :=
    Ideal.Quotient.lift I₀ ψ hψ0
  have hI₁ψ : I₁ ≤ RingHom.ker ψ := by
    apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      exact hψX1
    · rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, RingHom.mem_ker, hψC, hres c hc, map_zero]
  have h𝔞ψ : ∀ z ∈ 𝔞, ψ₀ z = 0 := by
    intro z hz
    have hle : 𝔞 ≤ RingHom.ker ψ₀ := by
      rw [h𝔞, Ideal.map_le_iff_le_comap]
      intro p hp
      rw [Ideal.mem_comap, RingHom.mem_ker]
      show ψ p = 0
      exact hI₁ψ hp
    exact hle hz
  let Φf : (MvPolynomial (Fin 2) R ⧸ I₀) ⧸ 𝔞 →+* Polynomial (IsLocalRing.ResidueField R) :=
    Ideal.Quotient.lift 𝔞 ψ₀ h𝔞ψ
  have hΦf : ∀ p, Φf (Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ p)) = ψ p := fun p => rfl
  let ρ₀ : R →+* (MvPolynomial (Fin 2) R ⧸ I₀) ⧸ 𝔞 :=
    (Ideal.Quotient.mk 𝔞).comp ((Ideal.Quotient.mk I₀).comp MvPolynomial.C)
  have hρ₀ : ∀ c ∈ IsLocalRing.maximalIdeal R, ρ₀ c = 0 := by
    intro c hc
    show Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ (MvPolynomial.C c)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hc))
  let ρ : IsLocalRing.ResidueField R →+* (MvPolynomial (Fin 2) R ⧸ I₀) ⧸ 𝔞 :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) ρ₀ hρ₀
  have hρ : ∀ c, ρ (IsLocalRing.residue R c) = ρ₀ c := fun c => rfl
  let χ : Polynomial (IsLocalRing.ResidueField R) →+* (MvPolynomial (Fin 2) R ⧸ I₀) ⧸ 𝔞 :=
    Polynomial.eval₂RingHom ρ (Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ (MvPolynomial.X 0)))
  have hχC : ∀ k, χ (Polynomial.C k) = ρ k := fun k => Polynomial.eval₂_C _ _
  have hχX : χ Polynomial.X = Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ (MvPolynomial.X 0)) :=
    Polynomial.eval₂_X _ _
  have hX1z : Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)) = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
  have key : χ.comp ψ = (Ideal.Quotient.mk 𝔞).comp (Ideal.Quotient.mk I₀) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, RingHom.comp_apply, hψC, hχC, hρ]
      rfl
    · intro i
      fin_cases i
      · show χ (ψ (MvPolynomial.X 0)) = _
        rw [hψX0, hχX]
        rfl
      · show χ (ψ (MvPolynomial.X 1)) =
          Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ (MvPolynomial.X 1))
        rw [hψX1, map_zero]
        exact hX1z.symm
  have h₂ : χ.comp Φf = RingHom.id _ := by
    apply RingHom.ext
    intro z
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [RingHom.comp_apply, hΦf, RingHom.id_apply]
    exact RingHom.congr_fun key p
  have h₁ : Φf.comp χ = RingHom.id _ := by
    apply Polynomial.ringHom_ext
    · intro k
      obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective k
      rw [RingHom.comp_apply, hχC, hρ, RingHom.id_apply]
      show Φf (Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ (MvPolynomial.C c))) = _
      rw [hΦf, hψC]
    · rw [RingHom.comp_apply, hχX, hΦf, hψX0, RingHom.id_apply]
  refine ⟨RingEquiv.ofRingHom Φf χ h₁ h₂, ?_, ?_⟩
  · show Φf (Ideal.Quotient.mk 𝔞 (Ideal.Quotient.mk I₀ (MvPolynomial.X 0))) = _
    rw [hΦf, hψX0]
  · have hcomp : (Φf.comp (Ideal.Quotient.mk 𝔞)).comp (Ideal.Quotient.mk I₀) = ψ :=
      RingHom.ext fun p => rfl
    show Ideal.map Φf _ = _
    rw [Ideal.map_map, Ideal.map_map, hcomp, Ideal.map_sup, Ideal.map_span, Set.image_pair,
      hψX0, hψX1, Ideal.map_map]
    have hbot : Ideal.map (ψ.comp MvPolynomial.C) (IsLocalRing.maximalIdeal R) = ⊥ := by
      rw [Ideal.map_eq_bot_iff_le_ker]
      intro c hc
      rw [RingHom.mem_ker, RingHom.comp_apply, hψC, hres c hc, map_zero]
    rw [hbot, sup_bot_eq, Set.pair_comm, Ideal.span_insert_zero]

theorem wcpa_dj_lr1k_ebnt_pres_branch : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (P : Type u) [CommRing P] (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P), wcEbntPres W σ a f → (Ideal.span {f (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ).IsPrime ∧ f (wcEbntX W a 0) ∉ Ideal.span {f (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ∧ ∀ 𝔔 : Ideal P, 𝔔.IsPrime → Ideal.span {f (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ≤ 𝔔 → 𝔔 = Ideal.span {f (wcEbntX W a 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ ∨ 𝔔.IsMaximal :=
by
  intro Ω _ _ W _ _ P _ σ a f hf

  have s2 : ∀ (A B Q : Type u) [CommRing A] [CommRing B] [CommRing Q] (φ : A ≃+* B)
      (p : Ideal A) (e : A →+* Q), wcNdIsHens p Q e →
      wcNdIsHens (Ideal.map φ p) Q (e.comp φ.symm.toRingHom) := by
    intro A B Q _ _ _ φ p e he
    obtain ⟨hH, hU, hUP⟩ := he
    have hle : Ideal.map φ p ≤ Ideal.comap φ.symm p :=
      Ideal.map_le_iff_le_comap.mpr (fun x hx => by
        rw [Ideal.mem_comap, Ideal.mem_comap, RingEquiv.symm_apply_apply]; exact hx)
    have hmem : ∀ b : B, b ∈ Ideal.map φ p ↔ φ.symm b ∈ p := by
      intro b
      constructor
      · intro hb; exact Ideal.mem_comap.mp (hle hb)
      · intro hb
        have := Ideal.mem_map_of_mem (φ : A →+* B) hb
        rw [RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply] at this
        exact this
    refine ⟨hH, ?_, ?_⟩
    · intro b
      show IsUnit (e (φ.symm b)) ↔ _
      rw [hU, hmem]
    · intro C _ hC g hg
      have hg' : ∀ t, IsUnit ((g.comp φ.toRingHom) t) ↔ t ∉ p := by
        intro t
        show IsUnit (g (φ t)) ↔ _
        rw [hg, hmem, RingEquiv.symm_apply_apply]
      obtain ⟨h, ⟨hh1, hh2⟩, huniq⟩ := hUP C hC (g.comp φ.toRingHom) hg'
      refine ⟨h, ⟨RingHom.ext fun b => ?_, hh2⟩, ?_⟩
      · have := RingHom.congr_fun hh1 (φ.symm b)
        simpa using this
      · rintro h' ⟨h1', h2'⟩
        apply huniq
        refine ⟨RingHom.ext fun t => ?_, h2'⟩
        have := RingHom.congr_fun h1' (φ t)
        simpa using this

  have key : ∀ (J : Ideal P) [IsDomain (P ⧸ J)] [IsDiscreteValuationRing (P ⧸ J)] (x : P),
      Irreducible (Ideal.Quotient.mk J x) →
      J.IsPrime ∧ x ∉ J ∧
        ∀ 𝔔 : Ideal P, 𝔔.IsPrime → J ≤ 𝔔 → 𝔔 = J ∨ 𝔔.IsMaximal := by
    intro J hdom _ x hirr
    refine ⟨(Ideal.Quotient.isDomain_iff_prime J).mp hdom, ?_, ?_⟩
    · intro hxJ
      exact hirr.ne_zero (Ideal.Quotient.eq_zero_iff_mem.mpr hxJ)
    · intro 𝔔 h𝔔 hle
      have hsurj : Function.Surjective (Ideal.Quotient.mk J) := Ideal.Quotient.mk_surjective
      have hker : RingHom.ker (Ideal.Quotient.mk J) ≤ 𝔔 := by rw [Ideal.mk_ker]; exact hle
      haveI hp : (𝔔.map (Ideal.Quotient.mk J)).IsPrime := Ideal.map_isPrime_of_surjective hsurj hker
      have hcomap : (𝔔.map (Ideal.Quotient.mk J)).comap (Ideal.Quotient.mk J) = 𝔔 := by
        rw [Ideal.comap_map_of_surjective' _ hsurj, sup_eq_left.mpr hker]
      by_cases hbot : 𝔔.map (Ideal.Quotient.mk J) = ⊥
      · left
        rw [← hcomap, hbot, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      · right
        haveI : (𝔔.map (Ideal.Quotient.mk J)).IsMaximal := IsPrime.to_maximal_ideal hbot
        rw [← hcomap]
        exact Ideal.comap_isMaximal_of_surjective _ hsurj
  obtain ⟨ha, -, hfσ, hP⟩ := hf

  have gen : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (b : R)
      (g : (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}) →+* P)
      (τ : R →+* P), b ∈ IsLocalRing.maximalIdeal R →
      g.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})).comp MvPolynomial.C) = τ →
      wcNdIsHens (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}))
        (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) R), MvPolynomial.X 1} ⊔ Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R))) P g →
      (Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 1))} ⊔ (IsLocalRing.maximalIdeal R).map τ).IsPrime ∧
      g (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∉ Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 1))} ⊔ (IsLocalRing.maximalIdeal R).map τ ∧
      ∀ 𝔔 : Ideal P, 𝔔.IsPrime → Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 1))} ⊔ (IsLocalRing.maximalIdeal R).map τ ≤ 𝔔 →
        𝔔 = Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 1))} ⊔ (IsLocalRing.maximalIdeal R).map τ ∨ 𝔔.IsMaximal := by
    intro R _ _ b g τ hb hgτ hH

    have h𝔞𝔪 : (Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) R)} ⊔
        (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})) ≤
        (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) R), MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})) :=
      Ideal.map_mono (sup_le_sup_right (Ideal.span_mono (Set.subset_insert _ _)) _)

    have hJ : Ideal.map g ((Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) R)} ⊔
        (IsLocalRing.maximalIdeal R).map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)).map
          (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}))) =
        Ideal.span {g (Ideal.Quotient.mk _ (MvPolynomial.X 1))} ⊔ (IsLocalRing.maximalIdeal R).map τ := by
      rw [Ideal.map_map, Ideal.map_sup, Ideal.map_span, Set.image_singleton, Ideal.map_map,
        RingHom.comp_assoc, hgτ]
      rfl

    have hQ := wcNd_hens_quotient _ _ _ P g hH h𝔞𝔪
    obtain ⟨Φ, hΦX, hΦI⟩ := wcpa_dj_lr1k_ebnt_branch_base_iso R b hb
    have hS := s2 _ _ _ Φ _ _ hQ
    rw [hΦI] at hS
    obtain ⟨hdom, hdvr, hirr⟩ := wcNd_line_hens_dvr (IsLocalRing.ResidueField R) _ _ hS
    have hsymm : Φ.symm Polynomial.X =
        Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) := by
      rw [RingEquiv.symm_apply_eq]
      exact hΦX.symm
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at hirr
    rw [hsymm, Ideal.quotientMap_mk] at hirr
    rw [← hJ]
    exact key _ _ hirr
  exact gen (↥W) a f σ ha hfσ hP

theorem wcNd_nodal_poly_normal : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (g : ↥W), g ≠ 0 →
    IsDomain (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) ∧
    IsIntegrallyClosed (MvPolynomial (Fin 2) ↥W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) :=
by

  have s2 : ∀ (W : Type u) [CommRing W] (g : W), ∃ σ : (MvPolynomial (Fin 2) W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) →+*
        (MvPolynomial (Fin 2) W ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}),
      σ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = Ideal.Quotient.mk _ (MvPolynomial.X 1) ∧
      σ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Ideal.Quotient.mk _ (MvPolynomial.X 0) ∧
      (∀ c : W, σ (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
        Ideal.Quotient.mk _ (MvPolynomial.C c)) ∧
      ∀ z, σ (σ z) = z := by
    intro W _ g
    set J : Ideal (MvPolynomial (Fin 2) W) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} with hJ
    obtain ⟨e, he⟩ : ∃ e : MvPolynomial (Fin 2) W →+* MvPolynomial (Fin 2) W ⧸ J,
        e = MvPolynomial.eval₂Hom ((Ideal.Quotient.mk J).comp MvPolynomial.C)
          ![Ideal.Quotient.mk J (MvPolynomial.X 1), Ideal.Quotient.mk J (MvPolynomial.X 0)] :=
      ⟨_, rfl⟩
    have hq0 : Ideal.Quotient.mk J (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have he0 : e (MvPolynomial.X 0) = Ideal.Quotient.mk J (MvPolynomial.X 1) := by
      rw [he, MvPolynomial.eval₂Hom_X']; rfl
    have he1 : e (MvPolynomial.X 1) = Ideal.Quotient.mk J (MvPolynomial.X 0) := by
      rw [he, MvPolynomial.eval₂Hom_X']; rfl
    have heC : ∀ c, e (MvPolynomial.C c) = Ideal.Quotient.mk J (MvPolynomial.C c) := by
      intro c; rw [he, MvPolynomial.eval₂Hom_C]; rfl
    have H : ∀ a ∈ J, e a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      have : e (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g) = 0 := by
        rw [map_sub, map_mul, he0, he1, heC, ← hq0, map_sub, map_mul]; ring
      rw [map_mul, this, mul_zero]
    refine ⟨Ideal.Quotient.lift J e H, ?_, ?_, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk, he0]
    · rw [Ideal.Quotient.lift_mk, he1]
    · intro c; rw [Ideal.Quotient.lift_mk, heC]
    · have hσσ : (Ideal.Quotient.lift J e H).comp (Ideal.Quotient.lift J e H) =
          RingHom.id _ := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply, Ideal.Quotient.lift_mk, heC, RingHom.id_apply]
        · intro i
          obtain rfl | rfl : i = 0 ∨ i = 1 := by fin_cases i <;> simp
          · simp only [RingHom.comp_apply, Ideal.Quotient.lift_mk, he0, he1, RingHom.id_apply]
          · simp only [RingHom.comp_apply, Ideal.Quotient.lift_mk, he0, he1, RingHom.id_apply]
      intro z
      exact RingHom.congr_fun hσσ z

  have s4 : ∀ (W : Type u) [CommRing W] (g : W) (w c : MvPolynomial (Fin 2) W ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}),
      Ideal.Quotient.mk _ (MvPolynomial.X 0) * c = w * Ideal.Quotient.mk _ (MvPolynomial.X 1) →
      ∃ d : MvPolynomial (Fin 2) W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g},
        w = Ideal.Quotient.mk _ (MvPolynomial.X 0) * d := by
    intro W _ g w c hwc
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨r₀, rfl⟩ := Ideal.Quotient.mk_surjective c
    set J : Ideal (MvPolynomial (Fin 2) W) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} with hJ
    obtain ⟨e, he⟩ : ∃ e : MvPolynomial (Fin 2) W →+* Polynomial W,
        e = MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X] := ⟨_, rfl⟩
    have he0 : e (MvPolynomial.X 0) = 0 := by rw [he, MvPolynomial.eval₂Hom_X']; rfl
    have he1 : e (MvPolynomial.X 1) = Polynomial.X := by rw [he, MvPolynomial.eval₂Hom_X']; rfl
    have heC : ∀ a, e (MvPolynomial.C a) = Polynomial.C a := by
      intro a; rw [he, MvPolynomial.eval₂Hom_C]
    obtain ⟨ι1, hι1⟩ : ∃ ι1 : Polynomial W →+* MvPolynomial (Fin 2) W,
        ι1 = Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1) := ⟨_, rfl⟩
    have hι1X : ι1 Polynomial.X = MvPolynomial.X 1 := by simp [hι1]
    have hι1C : ∀ a, ι1 (Polynomial.C a) = MvPolynomial.C a := by intro a; simp [hι1]
    have hdec : ∀ p : MvPolynomial (Fin 2) W, ∃ p', p = ι1 (e p) + MvPolynomial.X 0 * p' := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => exact ⟨0, by rw [heC, hι1C]; ring⟩
      | add p₁ p₂ h₁ h₂ =>
        obtain ⟨k₁, e₁⟩ := h₁
        obtain ⟨k₂, e₂⟩ := h₂
        refine ⟨k₁ + k₂, ?_⟩
        rw [map_add, map_add]
        linear_combination e₁ + e₂
      | mul_X p n ih =>
        obtain ⟨k, ek⟩ := ih
        obtain rfl | rfl : n = 0 ∨ n = 1 := by fin_cases n <;> simp
        · refine ⟨p, ?_⟩
          rw [map_mul, he0, mul_zero, map_zero]; ring
        · refine ⟨k * MvPolynomial.X 1, ?_⟩
          rw [map_mul, he1, map_mul, hι1X]
          linear_combination (MvPolynomial.X 1) * ek
    have hmem : p * MvPolynomial.X 1 - MvPolynomial.X 0 * r₀ ∈ J := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_mul, hwc, sub_self]
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp hmem
    have hh' := congrArg e hh
    simp only [map_mul, map_sub, he0, he1, heC] at hh'
    set r := -e h with hr
    have hkey : e p * Polynomial.X = Polynomial.C g * r := by
      rw [hr]; linear_combination -hh'
    have hep : e p = Polynomial.C g * r.divX := by
      ext k
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_divX, ← Polynomial.coeff_mul_X (e p) k, hkey,
        Polynomial.coeff_C_mul]
    obtain ⟨p', hp'⟩ := hdec p
    have hxy : Ideal.Quotient.mk J (MvPolynomial.C g) =
        Ideal.Quotient.mk J (MvPolynomial.X 0) * Ideal.Quotient.mk J (MvPolynomial.X 1) := by
      rw [← map_mul, Ideal.Quotient.eq]
      rw [← neg_sub]
      exact J.neg_mem (Ideal.subset_span rfl)
    refine ⟨Ideal.Quotient.mk J (MvPolynomial.X 1) * Ideal.Quotient.mk J (ι1 r.divX) +
      Ideal.Quotient.mk J p', ?_⟩
    rw [hp', hep]
    simp only [map_add, map_mul, hι1C, hxy]
    ring

  have s1 : ∀ (W : Type u) [CommRing W] [IsDomain W] (g : W), g ≠ 0 →
      ∀ (p : MvPolynomial (Fin 2) W),
      MvPolynomial.eval₂Hom LaurentPolynomial.C (![LaurentPolynomial.T 1,
        LaurentPolynomial.C g * LaurentPolynomial.T (-1)] : Fin 2 → LaurentPolynomial W) p = 0 →
      p ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} := by
    intro W _ _ g hg p hp
    obtain ⟨q, hq⟩ : ∃ q : MvPolynomial (Fin 2) W, q = MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C g := ⟨_, rfl⟩
    rw [← hq]
    obtain ⟨ev, hev⟩ : ∃ ev : MvPolynomial (Fin 2) W →+* LaurentPolynomial W,
        ev = MvPolynomial.eval₂Hom LaurentPolynomial.C (![LaurentPolynomial.T 1,
          LaurentPolynomial.C g * LaurentPolynomial.T (-1)] : Fin 2 → LaurentPolynomial W) :=
      ⟨_, rfl⟩
    rw [← hev] at hp
    obtain ⟨ι0, hι0⟩ : ∃ ι0 : Polynomial W →+* MvPolynomial (Fin 2) W,
        ι0 = Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0) := ⟨_, rfl⟩
    have hι0X : ι0 Polynomial.X = MvPolynomial.X 0 := by simp [hι0]
    have hι0C : ∀ a, ι0 (Polynomial.C a) = MvPolynomial.C a := by intro a; simp [hι0]
    have hA : ∀ p : MvPolynomial (Fin 2) W, ∃ (d : ℕ) (P : Polynomial W)
        (h : MvPolynomial (Fin 2) W), MvPolynomial.X 0 ^ d * p = ι0 P + q * h := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => exact ⟨0, Polynomial.C a, 0, by rw [hι0C]; ring⟩
      | add p₁ p₂ h₁ h₂ =>
        obtain ⟨d₁, P₁, k₁, e₁⟩ := h₁
        obtain ⟨d₂, P₂, k₂, e₂⟩ := h₂
        refine ⟨d₁ + d₂, Polynomial.X ^ d₂ * P₁ + Polynomial.X ^ d₁ * P₂,
          MvPolynomial.X 0 ^ d₂ * k₁ + MvPolynomial.X 0 ^ d₁ * k₂, ?_⟩
        rw [map_add, map_mul, map_mul, map_pow, map_pow, hι0X, pow_add]
        linear_combination (MvPolynomial.X 0 ^ d₂) * e₁ + (MvPolynomial.X 0 ^ d₁) * e₂
      | mul_X p n ih =>
        obtain ⟨d, P, k, e⟩ := ih
        obtain rfl | rfl : n = 0 ∨ n = 1 := by fin_cases n <;> simp
        · refine ⟨d, Polynomial.X * P, MvPolynomial.X 0 * k, ?_⟩
          rw [map_mul, hι0X]
          linear_combination (MvPolynomial.X 0) * e
        · refine ⟨d + 1, Polynomial.C g * P, MvPolynomial.C g * k + MvPolynomial.X 0 ^ d * p, ?_⟩
          rw [map_mul, hι0C]
          linear_combination (MvPolynomial.C g) * e - (MvPolynomial.X 0 ^ d * p) * hq
    have hT : (LaurentPolynomial.T 1 : LaurentPolynomial W) * LaurentPolynomial.T (-1) = 1 := by
      rw [← LaurentPolynomial.T_add]; norm_num [LaurentPolynomial.T_zero]
    have hevq : ev q = 0 := by
      rw [hq, hev]
      simp only [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one]
      linear_combination (LaurentPolynomial.C g) * hT
    have hB : ∀ P : Polynomial W, ev (ι0 P) = Polynomial.toLaurent P := by
      intro P
      have : ev.comp ι0 = Polynomial.toLaurent := by
        apply Polynomial.ringHom_ext
        · intro a
          rw [RingHom.comp_apply, hι0C, hev, MvPolynomial.eval₂Hom_C, Polynomial.toLaurent_C]
        · rw [RingHom.comp_apply, hι0X, hev, MvPolynomial.eval₂Hom_X', Polynomial.toLaurent_X]
          simp
      exact RingHom.congr_fun this P
    obtain ⟨d, P, h, e⟩ := hA p
    have e' := congrArg ev e
    rw [map_mul, hp, mul_zero, map_add, map_mul, hevq, zero_mul, add_zero, hB] at e'
    have hP : P = 0 := Polynomial.toLaurent_injective (by rw [← e', map_zero])
    rw [hP, map_zero, zero_add] at e
    have hX0q : ¬ (MvPolynomial.X 0 ∣ q) := by
      rintro ⟨r, hr⟩
      have := congrArg MvPolynomial.constantCoeff hr
      rw [hq, map_sub, map_mul, map_mul, MvPolynomial.constantCoeff_X,
        MvPolynomial.constantCoeff_C] at this
      apply hg
      linear_combination -this
    have hprime : Prime (MvPolynomial.X 0 : MvPolynomial (Fin 2) W) := MvPolynomial.X_prime
    have hD : ∀ (d : ℕ) (h : MvPolynomial (Fin 2) W),
        MvPolynomial.X 0 ^ d * p = q * h → q ∣ p := by
      intro d
      induction d with
      | zero => intro h e; exact ⟨h, by simpa using e⟩
      | succ d ih =>
        intro h e
        have hdvd : MvPolynomial.X 0 ∣ q * h := ⟨MvPolynomial.X 0 ^ d * p, by rw [← e]; ring⟩
        rcases hprime.dvd_or_dvd hdvd with h1 | ⟨h', rfl⟩
        · exact absurd h1 hX0q
        · apply ih h'
          apply mul_left_cancel₀ (MvPolynomial.X_ne_zero (0 : Fin 2) : (MvPolynomial.X 0 :
            MvPolynomial (Fin 2) W) ≠ 0)
          linear_combination e
    exact Ideal.mem_span_singleton.mpr (hD d h e)

  have s3 : ∀ (W : Type u) [CommRing W] [IsDomain W] [IsIntegrallyClosed W],
      IsDomain (LaurentPolynomial W) ∧ IsIntegrallyClosed (LaurentPolynomial W) := by
    intro W _ _ _
    have hM : Submonoid.powers (Polynomial.X : Polynomial W) ≤ nonZeroDivisors (Polynomial W) :=
      powers_le_nonZeroDivisors_of_noZeroDivisors Polynomial.X_ne_zero
    haveI : IsDomain (LaurentPolynomial W) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (LaurentPolynomial W) hM
    exact ⟨inferInstance, isIntegrallyClosed_of_isLocalization (LaurentPolynomial W) _ hM⟩

  have s5 : ∀ (R : Type u) [CommRing R] (x y : R), (∀ u v : R, x * u = x * v → u = v) →
      (∀ w c : R, x * c = w * y → ∃ d, w = x * d) →
      ∀ (m n : ℕ) (a b : R), a * y ^ m = b * x ^ n → ∃ c, a = c * x ^ n := by
    intro R _ x y hc hd
    have hi : ∀ (m : ℕ) (w c : R), x * c = w * y ^ m → ∃ d, w = x * d := by
      intro m
      induction m with
      | zero => intro w c h; exact ⟨c, by simpa using h.symm⟩
      | succ m ih =>
        intro w c h
        obtain ⟨d', hd'⟩ := ih (w * y) c (by rw [h, pow_succ]; ring)
        exact hd w d' hd'.symm
    intro m n
    induction n with
    | zero => intro a b _; exact ⟨a, by simp⟩
    | succ n ih =>
      intro a b h
      obtain ⟨a', ha'⟩ := hi m a (b * x ^ n) (by rw [h, pow_succ]; ring)
      have h2 : a' * y ^ m = b * x ^ n := hc _ _ (by
        rw [ha', pow_succ] at h
        linear_combination h)
      obtain ⟨c, hc'⟩ := ih a' b h2
      exact ⟨c, by rw [ha', hc', pow_succ]; ring⟩

  have s6 : ∀ (R L : Type u) [CommRing R] [CommRing L] [IsIntegrallyClosed L] (ψ : R →+* L)
      (a : R), Function.Injective ψ → IsUnit (ψ a) →
      (∀ f : L, ∃ (n : ℕ) (r : R), f * ψ a ^ n = ψ r) →
      IsIntegrallyClosed (Localization (Submonoid.powers a)) := by
    intro R L _ _ _ ψ a hinj hu hs
    letI := ψ.toAlgebra
    haveI : IsLocalization (Submonoid.powers a) L := by
      rw [isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨s, hs'⟩
        obtain ⟨k, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hs'
        show IsUnit (ψ (a ^ k))
        rw [map_pow]; exact hu.pow k
      · intro z
        obtain ⟨n, r, h⟩ := hs z
        refine ⟨(r, ⟨a ^ n, n, rfl⟩), ?_⟩
        show z * ψ (a ^ n) = ψ r
        rw [map_pow]; exact h
      · intro u v h
        exact ⟨1, by simp [hinj h]⟩
    exact IsIntegrallyClosed.of_equiv
      (IsLocalization.algEquiv (Submonoid.powers a) L
        (Localization (Submonoid.powers a))).toRingEquiv

  have s7 : ∀ (R : Type u) [CommRing R] [IsDomain R] (x y : R)
      (h : ∀ b : Bool, cond b (Submonoid.powers x) (Submonoid.powers y) ≤ nonZeroDivisors R),
      (∀ (m n : ℕ) (a b : R), a * y ^ m = b * x ^ n → ∃ c, a = c * x ^ n) →
      ⨅ b : Bool, Localization.subalgebra (FractionRing R)
        (cond b (Submonoid.powers x) (Submonoid.powers y)) (h b) = ⊥ := by
    intro R _ _ x y h hdiv
    refine le_antisymm ?_ bot_le
    intro z hz
    rw [Algebra.mem_iInf] at hz
    obtain ⟨a, s, hs, rfl⟩ := hz true
    obtain ⟨b, t, ht, hbt⟩ := hz false
    obtain ⟨n, rfl⟩ := hs
    obtain ⟨m, rfl⟩ := ht
    rw [IsLocalization.mk'_eq_iff_eq] at hbt
    have e := IsFractionRing.injective R (FractionRing R) hbt
    obtain ⟨c, hc⟩ := hdiv m n a b (by simp only at e; linear_combination e)
    rw [Algebra.mem_bot]
    refine ⟨c, ?_⟩
    rw [IsLocalization.eq_mk'_iff_mul_eq]
    simp only
    rw [← map_mul, hc]

  have assembly : ∀ (W : Type u) [CommRing W] [IsDomain W] [IsIntegrallyClosed W] (g : W),
      g ≠ 0 →
      IsDomain (MvPolynomial (Fin 2) W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) ∧
      IsIntegrallyClosed (MvPolynomial (Fin 2) W ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g}) := by
    intro W _ _ _ g hg
    obtain ⟨hLdom, hLic⟩ := s3 W
    obtain ⟨J, hJ⟩ : ∃ J : Ideal (MvPolynomial (Fin 2) W),
      J = Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C g} := ⟨_, rfl⟩
    rw [← hJ]
    obtain ⟨ev, hev⟩ : ∃ ev : MvPolynomial (Fin 2) W →+* LaurentPolynomial W,
        ev = MvPolynomial.eval₂Hom LaurentPolynomial.C (![LaurentPolynomial.T 1,
          LaurentPolynomial.C g * LaurentPolynomial.T (-1)] : Fin 2 → LaurentPolynomial W) :=
      ⟨_, rfl⟩
    have hevX0 : ev (MvPolynomial.X 0) = LaurentPolynomial.T 1 := by
      rw [hev, MvPolynomial.eval₂Hom_X']; rfl
    have hevX1 : ev (MvPolynomial.X 1) = LaurentPolynomial.C g * LaurentPolynomial.T (-1) := by
      rw [hev, MvPolynomial.eval₂Hom_X']; rfl
    have hevC : ∀ a, ev (MvPolynomial.C a) = LaurentPolynomial.C a := by
      intro a; rw [hev, MvPolynomial.eval₂Hom_C]
    have hT : (LaurentPolynomial.T 1 : LaurentPolynomial W) * LaurentPolynomial.T (-1) = 1 := by
      rw [← LaurentPolynomial.T_add]; norm_num [LaurentPolynomial.T_zero]
    have Hφ : ∀ a ∈ J, ev a = 0 := by
      intro a ha
      rw [hJ] at ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, map_sub, map_mul, hevX0, hevX1, hevC]
      linear_combination (ev c * LaurentPolynomial.C g) * hT
    obtain ⟨φ, hφ⟩ : ∃ φ : (MvPolynomial (Fin 2) W ⧸ J) →+* LaurentPolynomial W,
      φ = Ideal.Quotient.lift J ev Hφ := ⟨_, rfl⟩
    have hφmk : ∀ p, φ (Ideal.Quotient.mk J p) = ev p := fun p => by
      rw [hφ]; exact Ideal.Quotient.lift_mk J ev Hφ
    have hinj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [hφmk, hev] at hz
      have := s1 W g hg p hz
      rw [← hJ] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mpr this
    haveI hRdom : IsDomain (MvPolynomial (Fin 2) W ⧸ J) := hinj.isDomain φ
    refine ⟨hRdom, ?_⟩
    obtain ⟨x, hx⟩ : ∃ x, x = Ideal.Quotient.mk J (MvPolynomial.X 0) := ⟨_, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y, y = Ideal.Quotient.mk J (MvPolynomial.X 1) := ⟨_, rfl⟩
    have hφx : φ x = LaurentPolynomial.T 1 := by rw [hx, hφmk, hevX0]
    have hφy : φ y = LaurentPolynomial.C g * LaurentPolynomial.T (-1) := by
      rw [hy, hφmk, hevX1]
    have hx0 : x ≠ 0 := by
      intro h
      have := congrArg φ h
      rw [map_zero, hφx] at this
      exact (LaurentPolynomial.isUnit_T 1).ne_zero this
    have hy0 : y ≠ 0 := by
      intro h
      have := congrArg φ h
      rw [map_zero, hφy] at this
      have hC : (LaurentPolynomial.C g : LaurentPolynomial W) = 0 :=
        (LaurentPolynomial.isUnit_T (-1)).mul_left_eq_zero.mp this
      rw [← Polynomial.toLaurent_C] at hC
      apply hg
      exact Polynomial.C_eq_zero.mp (Polynomial.toLaurent_injective (by rw [hC, map_zero]))
    obtain ⟨ι0, hι0⟩ : ∃ ι0 : Polynomial W →+* MvPolynomial (Fin 2) W,
        ι0 = Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0) := ⟨_, rfl⟩
    have hι0X : ι0 Polynomial.X = MvPolynomial.X 0 := by simp [hι0]
    have hι0C : ∀ a, ι0 (Polynomial.C a) = MvPolynomial.C a := by intro a; simp [hι0]
    obtain ⟨ι1, hι1⟩ : ∃ ι1 : Polynomial W →+* MvPolynomial (Fin 2) W,
        ι1 = Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1) := ⟨_, rfl⟩
    have hι1X : ι1 Polynomial.X = MvPolynomial.X 1 := by simp [hι1]
    have hι1C : ∀ a, ι1 (Polynomial.C a) = MvPolynomial.C a := by intro a; simp [hι1]
    have hB : ∀ P : Polynomial W, ev (ι0 P) = Polynomial.toLaurent P := by
      intro P
      have : ev.comp ι0 = Polynomial.toLaurent := by
        apply Polynomial.ringHom_ext
        · intro a
          rw [RingHom.comp_apply, hι0C, hevC, Polynomial.toLaurent_C]
        · rw [RingHom.comp_apply, hι0X, hevX0, Polynomial.toLaurent_X]
      exact RingHom.congr_fun this P
    have hsurjL : ∀ f : LaurentPolynomial W, ∃ (n : ℕ) (P : Polynomial W),
        f * LaurentPolynomial.T 1 ^ n = Polynomial.toLaurent P := by
      intro f
      obtain ⟨n, P, hP⟩ := LaurentPolynomial.exists_T_pow f
      refine ⟨n, P, ?_⟩
      rw [hP, LaurentPolynomial.T_pow, mul_one]
    have hcx : IsIntegrallyClosed (Localization (Submonoid.powers x)) := by
      refine s6 _ _ φ x hinj (by rw [hφx]; exact LaurentPolynomial.isUnit_T 1) ?_
      intro f
      obtain ⟨n, P, hP⟩ := hsurjL f
      exact ⟨n, Ideal.Quotient.mk J (ι0 P), by rw [hφx, hP, hφmk, hB]⟩
    obtain ⟨σ, hσ0, hσ1, hσC, hσσ⟩ : ∃ σ : (MvPolynomial (Fin 2) W ⧸ J) →+*
        (MvPolynomial (Fin 2) W ⧸ J),
        σ (Ideal.Quotient.mk J (MvPolynomial.X 0)) = Ideal.Quotient.mk J (MvPolynomial.X 1) ∧
        σ (Ideal.Quotient.mk J (MvPolynomial.X 1)) = Ideal.Quotient.mk J (MvPolynomial.X 0) ∧
        (∀ c : W, σ (Ideal.Quotient.mk J (MvPolynomial.C c)) =
          Ideal.Quotient.mk J (MvPolynomial.C c)) ∧
        ∀ z, σ (σ z) = z := by
      subst hJ; exact s2 W g
    have hσι : ∀ P, σ (Ideal.Quotient.mk J (ι1 P)) = Ideal.Quotient.mk J (ι0 P) := by
      intro P
      have : σ.comp ((Ideal.Quotient.mk J).comp ι1) = (Ideal.Quotient.mk J).comp ι0 := by
        apply Polynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, hι1C, hι0C]
          exact hσC a
        · simp only [RingHom.comp_apply, hι1X, hι0X]
          exact hσ1
      exact RingHom.congr_fun this P
    have hcy : IsIntegrallyClosed (Localization (Submonoid.powers y)) := by
      refine s6 _ _ (φ.comp σ) y (hinj.comp (Function.LeftInverse.injective hσσ))
        (by rw [RingHom.comp_apply, hy, hσ1, ← hx, hφx]; exact LaurentPolynomial.isUnit_T 1) ?_
      intro f
      obtain ⟨n, P, hP⟩ := hsurjL f
      refine ⟨n, Ideal.Quotient.mk J (ι1 P), ?_⟩
      rw [RingHom.comp_apply, RingHom.comp_apply, hy, hσ1, ← hx, hφx, hP, hσι, hφmk, hB]
    have h : ∀ b : Bool, cond b (Submonoid.powers x) (Submonoid.powers y) ≤
        nonZeroDivisors (MvPolynomial (Fin 2) W ⧸ J) := by
      intro b
      cases b
      · exact powers_le_nonZeroDivisors_of_noZeroDivisors hy0
      · exact powers_le_nonZeroDivisors_of_noZeroDivisors hx0
    have hd : ∀ w c : MvPolynomial (Fin 2) W ⧸ J, x * c = w * y → ∃ d, w = x * d := by
      rw [hx, hy]; subst hJ; exact s4 W g
    have hc : ∀ u v : MvPolynomial (Fin 2) W ⧸ J, x * u = x * v → u = v :=
      fun u v huv => mul_left_cancel₀ hx0 huv
    have h7 := s7 _ x y h (s5 _ x y hc hd)
    exact IsIntegrallyClosed.of_localization_submonoid
      (fun b => cond b (Submonoid.powers x) (Submonoid.powers y)) h
      (fun b => by cases b; exacts [hcy, hcx]) h7
  intro Ω _ W g hg
  exact assembly ↥W g hg

theorem wcNd_hne_valuation_witness : ∀ (A : Type u) [CommRing A] [IsDomain A] (p : Ideal A), p.IsPrime → ∃ (V : Type u) (_ : CommRing V) (_ : HenselianLocalRing V) (g : A →+* V), Function.Injective g ∧ ∀ a, IsUnit (g a) ↔ a ∉ p :=
by
  intro A _ _ p hp
  classical
  haveI := hp
  let K := FractionRing A
  let Ω := AlgebraicClosure K
  let ι : A →+* Ω := (algebraMap K Ω).comp (algebraMap A K)
  have hι : Function.Injective ι :=
    (algebraMap K Ω).injective.comp (IsFractionRing.injective A K)
  have hunit : ∀ y : p.primeCompl, IsUnit (ι y) := by
    intro y
    apply isUnit_iff_ne_zero.mpr
    intro h0
    apply y.2
    have : (y : A) = 0 := hι (by rw [h0, map_zero])
    rw [this]
    exact p.zero_mem
  let Ap := Localization.AtPrime p
  let lam : Ap →+* Ω := IsLocalization.lift (M := p.primeCompl) (S := Ap) hunit
  have hlam : ∀ a : A, lam (algebraMap A Ap a) = ι a := fun a =>
    IsLocalization.lift_eq (M := p.primeCompl) (S := Ap) hunit a
  let L : LocalSubring Ω := LocalSubring.range lam
  have hLmem : ∀ z, z ∈ L.toSubring ↔ z ∈ Set.range lam := by
    intro z
    rw [LocalSubring.range_toSubring]
    exact Iff.rfl
  obtain ⟨W, hLW⟩ := LocalSubring.exists_le_valuationSubring L
  obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hLW
  have hW : ∀ x : Ap, lam x ∈ W := fun x => hle ((hLmem _).mpr ⟨x, rfl⟩)
  have hιW : ∀ a, ι a ∈ W := fun a => by rw [← hlam]; exact hW _
  let g : A →+* W := ι.codRestrict W hιW
  refine ⟨W, inferInstance, wcpa_dj_lmga_valuation_henselian Ω W, g, ?_, ?_⟩
  · intro a b h
    exact hι (congrArg Subtype.val h)
  · intro a
    constructor
    · intro hu ha
      have htmem : ι a ∈ L.toSubring := (hLmem _).mpr ⟨_, hlam a⟩
      let t : L.toSubring := ⟨ι a, htmem⟩
      have htu : IsUnit t := isUnit_of_map_unit (Subring.inclusion hle) t hu
      obtain ⟨t', htt'⟩ := htu.exists_right_inv
      obtain ⟨w, hw⟩ := (hLmem _).mp t'.2
      have h1 : lam (algebraMap A Ap a * w) = 1 := by
        rw [map_mul, hlam, hw]
        exact congrArg Subtype.val htt'
      have hm : algebraMap A Ap a ∈ IsLocalRing.maximalIdeal Ap :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff Ap p a).mpr ha
      have hm2 : algebraMap A Ap a * w ∈ IsLocalRing.maximalIdeal Ap :=
        Ideal.mul_mem_right _ _ hm
      have hu2 : IsUnit (1 - algebraMap A Ap a * w) :=
        IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp hm2)
      have h3 := hu2.map lam
      rw [map_sub, map_one, h1, sub_self] at h3
      exact not_isUnit_zero h3
    · intro ha
      let s : p.primeCompl := ⟨a, ha⟩
      let w : Ap := IsLocalization.mk' Ap (1 : A) s
      have hw : w * algebraMap A Ap a = 1 := by
        have h4 := IsLocalization.mk'_spec Ap (1 : A) s
        rw [map_one] at h4
        exact h4
      refine isUnit_iff_exists_inv.mpr ⟨⟨lam w, hW w⟩, ?_⟩
      apply Subtype.ext
      show ι a * lam w = 1
      rw [← hlam, ← map_mul, mul_comm, hw, map_one]

theorem wcNd_hne_etale_approx : ∀ (A : Type u) [CommRing A] (p : Ideal A) (P : Type u) [CommRing P] (e : A →+* P), wcNdIsHens p P e → ∀ F : Finset P, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra A E) (_ : Algebra.Etale A E) (φ : E →+* P), φ.comp (algebraMap A E) = e ∧ ∀ x ∈ F, x ∈ φ.range :=
by
  intro A _ p P _ e hH F
  obtain ⟨hP1, hP2, hP3⟩ := hH
  haveI := hP1
  letI : Algebra A P := e.toAlgebra
  have hAP : algebraMap A P = e := RingHom.algebraMap_toAlgebra e

  obtain ⟨H, hHmem, hHfin⟩ := wc_hnas_hs_etale_hull_subring wc_hnas_hs_etale_chart_merge A P

  have hinv : ∀ x ∈ H, IsUnit x → ∃ y ∈ H, x * y = 1 := by
    intro x hx hu
    obtain ⟨E, iE, iAE, hEt, φ, hxφ⟩ := (hHmem x).mp hx
    obtain ⟨e₀, he₀⟩ := (AlgHom.mem_range φ).mp hxφ
    obtain ⟨E', iE', iAE', hEt', φ', y', hy'⟩ :=
      wc_hnas_hs_etale_inverse A P E φ e₀ (by rw [he₀]; exact hu)
    refine ⟨φ' y', (hHmem _).mpr ⟨E', iE', iAE', hEt', φ', (AlgHom.mem_range φ').mpr ⟨y', rfl⟩⟩, ?_⟩
    rw [← he₀, mul_comm]
    exact hy'
  obtain ⟨hHloc, hsub, hmax⟩ := wc_hnas_hs_inverse_closed_subring_local P H hinv
  haveI := hHloc
  haveI := hsub

  have hHhens : HenselianLocalRing ↥H := by
    refine wc_hnas_hs_hull_henselian A P H hmax hHfin ?_
    intro E _ _ _ φ f b hf hb hdb
    obtain ⟨E', iE', iAE', hEt', φ', hbφ⟩ :=
      wc_hnas_hs_etale_simple_root A P E φ f b hf hb hdb
    exact (hHmem b).mpr ⟨E', iE', iAE', hEt', φ', hbφ⟩

  have he' : ∀ a : A, e a ∈ H := by
    intro a
    refine (hHmem (e a)).mpr ⟨A, inferInstance, inferInstance, inferInstance, Algebra.ofId A P,
      (AlgHom.mem_range (Algebra.ofId A P)).mpr ⟨a, ?_⟩⟩
    rw [Algebra.ofId_apply, hAP]
  let e' : A →+* ↥H := e.codRestrict H he'
  have he'u : ∀ a, IsUnit (e' a) ↔ a ∉ p := by
    intro a
    constructor
    · intro hu
      have : IsUnit (H.subtype (e' a)) := hu.map H.subtype
      exact (hP2 a).mp this
    · intro ha
      have : IsUnit (H.subtype (e' a)) := (hP2 a).mpr ha
      exact isUnit_of_map_unit H.subtype _ this

  obtain ⟨h, ⟨hh, hhloc⟩, -⟩ := hP3 (↥H) hHhens e' he'u
  haveI := hhloc
  let j : P →+* P := H.subtype.comp h
  have hjloc : IsLocalHom j := RingHom.isLocalHom_comp H.subtype h
  have hje : j.comp e = e := by
    apply RingHom.ext
    intro a
    show (H.subtype (h (e a))) = e a
    rw [← RingHom.comp_apply h e, hh]
    rfl
  have hjid : j = RingHom.id P :=
    (hP3 P hP1 e hP2).unique ⟨hje, hjloc⟩ ⟨RingHom.id_comp e, inferInstance⟩
  have hall : ∀ x : P, x ∈ H := by
    intro x
    have : j x = x := by rw [hjid]; rfl
    rw [← this]
    exact (h x).2

  obtain ⟨E, iE, iAE, hEt, φ, hφ⟩ := hHfin F (fun x _ => hall x)
  refine ⟨E, iE, iAE, hEt, (φ : E →+* P), ?_, ?_⟩
  · rw [AlgHom.comp_algebraMap, hAP]
  · intro x hx
    obtain ⟨y, hy⟩ := (AlgHom.mem_range φ).mp (hφ x hx)
    exact ⟨y, hy⟩

theorem wcNd_hne_etale_algebraic : ∀ (A E : Type u) [CommRing A] [IsDomain A] [CommRing E] [Algebra A E] [Algebra.Etale A E] (y : E), ∃ c : Polynomial A, c ≠ 0 ∧ Polynomial.aeval y c = 0 :=
by
  intro A E _ _ _ _ _ y
  classical
  have : Module.Finite (FractionRing A) (TensorProduct A (FractionRing A) E) :=
    Algebra.FormallyUnramified.finite_of_free (FractionRing A) (TensorProduct A (FractionRing A) E)
  have hx : IsIntegral (FractionRing A)
      (Algebra.TensorProduct.includeRight y : TensorProduct A (FractionRing A) E) :=
    Algebra.IsIntegral.isIntegral _
  obtain ⟨p, hpm, hpx⟩ := hx
  have hp0 : p ≠ 0 := hpm.ne_zero
  have hc₀ : IsLocalization.integerNormalization (nonZeroDivisors A) p ≠ 0 := by
    intro h
    exact hp0 ((IsFractionRing.integerNormalization_eq_zero_iff (K := FractionRing A)).mp h)
  have hc₀x : Polynomial.aeval
      (Algebra.TensorProduct.includeRight y : TensorProduct A (FractionRing A) E)
      (IsLocalization.integerNormalization (nonZeroDivisors A) p) = 0 :=
    IsLocalization.integerNormalization_aeval_eq_zero (M := nonZeroDivisors A)
      (R' := TensorProduct A (FractionRing A) E) p hpx
  rw [Polynomial.aeval_algHom_apply, Algebra.TensorProduct.includeRight_apply] at hc₀x
  have hmk : TensorProduct.mk A (FractionRing A) E 1
      (Polynomial.aeval y (IsLocalization.integerNormalization (nonZeroDivisors A) p)) =
      TensorProduct.mk A (FractionRing A) E 1 0 := by
    rw [TensorProduct.mk_apply, TensorProduct.mk_apply, hc₀x, TensorProduct.tmul_zero]
  obtain ⟨s, hs⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors A) hmk
  refine ⟨Polynomial.C (s : A) * IsLocalization.integerNormalization (nonZeroDivisors A) p, ?_, ?_⟩
  · exact mul_ne_zero (Polynomial.C_ne_zero.mpr (nonZeroDivisors.ne_zero s.2)) hc₀
  · rw [map_mul, Polynomial.aeval_C, ← Algebra.smul_def]
    rw [smul_zero] at hs
    exact hs

theorem wcNd_hne_local_injective : ∀ (A E : Type u) [CommRing A] [CommRing E] [Algebra A E] (q : Ideal E) [q.IsPrime], IsDomain (Localization.AtPrime q) → ∀ (P : Type u) [CommRing P] (γ : Localization.AtPrime q →+* P), Function.Injective (γ.comp (algebraMap A (Localization.AtPrime q))) → (∀ y : E, ∃ c : Polynomial A, c ≠ 0 ∧ Polynomial.aeval y c = 0) → Function.Injective γ :=
by
  intro A E _ _ _ q _ hdom P _ γ hinj halg
  haveI := hdom
  rw [injective_iff_map_eq_zero]
  intro z hz
  by_contra hz0
  obtain ⟨⟨y, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
  simp only at hz hz0
  have hspec := IsLocalization.mk'_spec (Localization.AtPrime q) y s
  have hγw : γ (algebraMap E (Localization.AtPrime q) y) = 0 := by
    rw [← hspec, map_mul, hz, zero_mul]
  have hs0 : algebraMap E (Localization.AtPrime q) (s : E) ≠ 0 :=
    (IsLocalization.map_units (Localization.AtPrime q) s).ne_zero
  have hw0 : algebraMap E (Localization.AtPrime q) y ≠ 0 := by
    rw [← hspec]; exact mul_ne_zero hz0 hs0
  obtain ⟨c, hc0, hcy⟩ := halg y
  have hcw : Polynomial.aeval (algebraMap E (Localization.AtPrime q) y) c = 0 := by
    rw [Polynomial.aeval_algebraMap_apply, hcy, map_zero]
  obtain ⟨c', hfac, hnd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd c hc0 0
  simp only [map_zero, sub_zero] at hfac hnd
  have hc'0 : c'.coeff 0 ≠ 0 := fun h => hnd (Polynomial.X_dvd_iff.mpr h)
  have hc'w : Polynomial.aeval (algebraMap E (Localization.AtPrime q) y) c' = 0 := by
    rw [hfac, map_mul, map_pow, Polynomial.aeval_X] at hcw
    exact (mul_eq_zero.mp hcw).resolve_left (pow_ne_zero _ hw0)
  apply hc'0
  apply hinj
  have key := Polynomial.hom_eval₂ c' (algebraMap A (Localization.AtPrime q)) γ
    (algebraMap E (Localization.AtPrime q) y)
  rw [← Polynomial.aeval_def, hc'w, map_zero, hγw, Polynomial.eval₂_at_zero] at key
  exact key.symm.trans (map_zero _).symm

theorem wcNd_hne_union_normal : ∀ (P : Type u) [CommRing P] [Nontrivial P], (∀ F : Finset P, ∃ (T : Type u) (_ : CommRing T) (_ : IsDomain T) (_ : IsIntegrallyClosed T) (γ : T →+* P), Function.Injective γ ∧ ∀ x ∈ F, x ∈ γ.range) → IsDomain P ∧ IsIntegrallyClosed P :=
by
  intro P _ _ H
  classical
  have s1 : ∀ (T : Type u) [CommRing T] [IsDomain T] [IsIntegrallyClosed T] (f : Polynomial T)
      (a b : T), f.Monic → b ≠ 0 → Polynomial.eval a (f.scaleRoots b) = 0 → b ∣ a := by
    intro T _ _ _ f a b hf hb hev
    set ι := algebraMap T (FractionRing T) with hι
    have hinj : Function.Injective ι := IsFractionRing.injective T (FractionRing T)
    have hιb : ι b ≠ 0 := fun h => hb (hinj (h.trans (map_zero ι).symm))
    have hbx : ι b * (ι a / ι b) = ι a := by field_simp
    have h1 := Polynomial.scaleRoots_eval₂_mul (p := f) ι (ι a / ι b) b
    rw [hbx, Polynomial.eval₂_hom, hev, map_zero] at h1
    have h2 : Polynomial.eval₂ ι (ι a / ι b) f = 0 :=
      (mul_eq_zero.mp h1.symm).resolve_left (pow_ne_zero _ hιb)
    have hint : IsIntegral T (ι a / ι b) := ⟨f, hf, h2⟩
    obtain ⟨t, ht⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
    refine ⟨t, hinj ?_⟩
    rw [map_mul, ht, hbx]
  have hdom : IsDomain P := by
    have : NoZeroDivisors P := ⟨fun {x y} hxy => by
      obtain ⟨T, _, _, _, γ, hγ, hF⟩ := H {x, y}
      obtain ⟨t₁, rfl⟩ := hF x (by simp)
      obtain ⟨t₂, rfl⟩ := hF y (by simp)
      have h0 : t₁ * t₂ = 0 := hγ (by rw [map_mul, hxy, map_zero])
      rcases mul_eq_zero.mp h0 with h | h
      · left; rw [h, map_zero]
      · right; rw [h, map_zero]⟩
    exact NoZeroDivisors.to_isDomain P
  haveI := hdom
  refine ⟨hdom, ?_⟩
  rw [isIntegrallyClosed_iff (FractionRing P)]
  intro x hx
  obtain ⟨f, hfm, hf⟩ := hx
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := P) x
  set ι := algebraMap P (FractionRing P) with hι
  have hinj : Function.Injective ι := IsFractionRing.injective P (FractionRing P)
  have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
  have hιb : ι b ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
  have hS : Polynomial.eval a (f.scaleRoots b) = 0 := by
    have h1 := Polynomial.scaleRoots_eval₂_eq_zero (s := b) ι hf
    have e : ι b * (ι a / ι b) = ι a := by field_simp
    rw [e, Polynomial.eval₂_hom] at h1
    exact hinj (h1.trans (map_zero ι).symm)
  obtain ⟨T, _, _, _, γ, hγ, hF⟩ :=
    H (insert a (insert b ((Finset.range (f.natDegree + 1)).image f.coeff)))
  obtain ⟨a', ha'⟩ := hF a (Finset.mem_insert_self _ _)
  obtain ⟨b', hb'⟩ := hF b (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
  have hcoeff : ∀ n, f.coeff n ∈ Set.range γ := by
    intro n
    by_cases hn : n ≤ f.natDegree
    · obtain ⟨t, ht⟩ := hF (f.coeff n) (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
        (Finset.mem_image_of_mem _ (Finset.mem_range.mpr (Nat.lt_succ_of_le hn)))))
      exact ⟨t, ht⟩
    · exact ⟨0, by rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]⟩
  have hlift : f ∈ Polynomial.lifts γ := (Polynomial.lifts_iff_coeff_lifts f).mpr hcoeff
  obtain ⟨q, hqf, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hfm
  have hmap : (q.scaleRoots b').map γ = f.scaleRoots b := by
    rw [Polynomial.map_scaleRoots q b' γ (by rw [hqm.leadingCoeff, map_one]; exact one_ne_zero),
      hqf, hb']
  have hS' : Polynomial.eval a' (q.scaleRoots b') = 0 := by
    apply hγ
    rw [map_zero, ← Polynomial.eval₂_hom, ← Polynomial.eval_map, hmap, ha', hS]
  have hb'0 : b' ≠ 0 := by
    rintro rfl
    exact hb0 (by rw [← hb', map_zero])
  obtain ⟨t, ht⟩ := s1 T q a' b' hqm hb'0 hS'
  refine ⟨γ t, ?_⟩
  rw [eq_div_iff hιb, ← map_mul]
  congr 1
  rw [← ha', ht, map_mul, hb', mul_comm]

theorem wcNd_hens_normal_domain : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    (p : Ideal A), p.IsPrime → ∀ (P : Type u) [CommRing P] (e : A →+* P), wcNdIsHens p P e →
    IsDomain P ∧ IsIntegrallyClosed P :=
by
  intro A _ _ _ p hp P _ e hH
  obtain ⟨hPh, hunit, huniv⟩ := hH
  haveI := hPh

  have he : Function.Injective e := by
    obtain ⟨V, _, hV, g, hg, hgu⟩ := wcNd_hne_valuation_witness A p hp
    obtain ⟨h, ⟨hh, _⟩, _⟩ := huniv V hV g hgu
    intro a b hab
    apply hg
    rw [← hh, RingHom.comp_apply, RingHom.comp_apply, hab]

  apply wcNd_hne_union_normal P
  intro F
  obtain ⟨E, iE, iAE, hEt, φ, hφ, hF⟩ :=
    wcNd_hne_etale_approx A p P e ⟨hPh, hunit, huniv⟩ F
  let Q : Ideal E := Ideal.comap φ (IsLocalRing.maximalIdeal P)
  haveI hQ : Q.IsPrime := Ideal.comap_isPrime φ _
  have hlift : ∀ y : Q.primeCompl, IsUnit (φ y) := by
    intro y
    by_contra hy
    apply y.2
    show φ y ∈ IsLocalRing.maximalIdeal P
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hy
  let γ : Localization.AtPrime Q →+* P := IsLocalization.lift (M := Q.primeCompl) hlift
  have hγ : γ.comp (algebraMap E (Localization.AtPrime Q)) = φ :=
    IsLocalization.lift_comp hlift
  obtain ⟨hdom, hic⟩ := wc_pks_etale_localization_normal A E Q
  have hγA : γ.comp (algebraMap A (Localization.AtPrime Q)) = e := by
    rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime Q), ← RingHom.comp_assoc, hγ, hφ]
  have hinj : Function.Injective γ :=
    wcNd_hne_local_injective A E Q hdom P γ (by rw [hγA]; exact he)
      (fun y => wcNd_hne_etale_algebraic A E y)
  refine ⟨Localization.AtPrime Q, inferInstance, hdom, hic, γ, hinj, ?_⟩
  intro x hx
  obtain ⟨y, rfl⟩ := hF x hx
  exact ⟨algebraMap E _ y, by rw [← RingHom.comp_apply, hγ]⟩

theorem wcpa_dj_lr1k_ebnt_node_unit_criterion : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W) (B : Type u) [CommRing B] [IsLocalRing B] (φ : wcEbntN W a →+* B), ¬ IsUnit (φ (wcEbntX W a 0)) → ¬ IsUnit (φ (wcEbntX W a 1)) → (∀ c ∈ IsLocalRing.maximalIdeal ↥W, ¬ IsUnit (φ (Ideal.Quotient.mk _ (MvPolynomial.C c)))) → ∀ t, IsUnit (φ t) ↔ t ∉ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔ (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) :=
by
  intro Ω _ W a B _ _ φ hX0 hX1 hC t
  have hnu : ∀ x : B, ¬ IsUnit x → x ∈ IsLocalRing.maximalIdeal B := fun x hx =>
    (IsLocalRing.mem_maximalIdeal x).mpr hx
  have hle : ∀ s, s ∈ (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
      (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)).map
      (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a :
        MvPolynomial (Fin 2) ↥W)})) → φ s ∈ IsLocalRing.maximalIdeal B := by
    intro s hs
    have h : (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)).map
        (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a :
          MvPolynomial (Fin 2) ↥W)})) ≤ (IsLocalRing.maximalIdeal B).comap φ := by
      rw [Ideal.map_le_iff_le_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl
        · exact hnu _ hX0
        · exact hnu _ hX1
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc
        exact hnu _ (hC c hc)
    exact h hs
  have s2 : ∀ p : MvPolynomial (Fin 2) ↥W, p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C r =>
      simp
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, MvPolynomial.C_add]; ring
      rw [e]
      exact add_mem hp hq
    | mul_X p n _ =>
      have e : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n)) =
          p * MvPolynomial.X n := by
        simp
      rw [e]
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      rcases hn with rfl | rfl
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ rfl
  constructor
  · intro hu ht
    exact (IsLocalRing.mem_maximalIdeal _).mp (hle t ht) hu
  · intro ht
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
    obtain ⟨p₀, hp₀⟩ : ∃ p₀, MvPolynomial.constantCoeff p = p₀ := ⟨_, rfl⟩
    have hr := s2 p
    rw [hp₀] at hr
    have hp0 : p₀ ∉ IsLocalRing.maximalIdeal ↥W := by
      intro hm
      apply ht
      apply Ideal.mem_map_of_mem
      have e : p = (p - MvPolynomial.C p₀) + MvPolynomial.C p₀ := by ring
      rw [e]
      exact add_mem (Ideal.mem_sup_left hr) (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hm))
    have hu : IsUnit (φ (Ideal.Quotient.mk _ (MvPolynomial.C p₀))) :=
      IsUnit.map φ (IsUnit.map _ (IsUnit.map MvPolynomial.C (IsLocalRing.notMem_maximalIdeal.mp hp0)))
    have hn : φ (Ideal.Quotient.mk _ (p - MvPolynomial.C p₀)) ∈ IsLocalRing.maximalIdeal B :=
      hle _ (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left hr))
    have heq : φ (Ideal.Quotient.mk _ p) = φ (Ideal.Quotient.mk _ (MvPolynomial.C p₀)) +
        φ (Ideal.Quotient.mk _ (p - MvPolynomial.C p₀)) := by
      rw [← map_add, ← map_add]; congr 2; ring
    rw [heq]
    apply IsLocalRing.notMem_maximalIdeal.mp
    intro hsum
    have hm : φ (Ideal.Quotient.mk _ (MvPolynomial.C p₀)) ∈ IsLocalRing.maximalIdeal B := by
      have h2 := Ideal.sub_mem _ hsum hn
      rwa [add_sub_cancel_right] at h2
    exact (IsLocalRing.mem_maximalIdeal _).mp hm hu

theorem wcpa_dj_lr1k_ebnt_pres_sigma_injective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (P : Type u) [CommRing P] (σ : ↥W →+* P) (a : ↥W) (f : wcEbntN W a →+* P), wcEbntPres W σ a f → Function.Injective σ :=
by
  intro Ω _ _ W P _ σ a f hf
  obtain ⟨ha, ha0, hfσ, hH⟩ := hf
  have hanu : ¬ IsUnit a := (IsLocalRing.mem_maximalIdeal a).mp ha

  obtain ⟨γ₀, hγ₀⟩ := IsAlgClosed.exists_pow_nat_eq ((a : ↥W) : Ω) two_pos
  have hγ₀ne : γ₀ ≠ 0 := by
    rintro rfl
    rw [zero_pow two_ne_zero] at hγ₀
    exact ha0 (by exact_mod_cast hγ₀.symm)
  have hγW : γ₀ ∈ W := by
    rcases W.mem_or_inv_mem γ₀ with h | h
    · exact h
    · exfalso; apply hanu
      obtain ⟨t, ht⟩ : ∃ t : ↥W, (t : Ω) = γ₀⁻¹ := ⟨⟨γ₀⁻¹, h⟩, rfl⟩
      refine IsUnit.of_mul_eq_one (t ^ 2) ?_
      apply Subtype.ext
      push_cast [ht]
      rw [← hγ₀, ← mul_pow, mul_inv_cancel₀ hγ₀ne, one_pow]
  obtain ⟨γ, hγc⟩ : ∃ γ : ↥W, (γ : Ω) = γ₀ := ⟨⟨γ₀, hγW⟩, rfl⟩
  have hγ2 : γ * γ = a := Subtype.ext (by push_cast [hγc]; rw [← hγ₀]; ring)
  have hγnu : ¬ IsUnit γ := fun hu => hanu (hγ2 ▸ hu.mul hu)

  let g : wcEbntN W a →+* ↥W := Ideal.Quotient.lift _
    (MvPolynomial.eval₂Hom (RingHom.id ↥W) ![γ, γ]) (by
      intro p hp
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      simp [hγ2])
  have hgC : ∀ t, g (Ideal.Quotient.mk _ (MvPolynomial.C t)) = t := by
    intro t; simp [g]
  have hg0 : g (wcEbntX W a 0) = γ := by simp [g, wcEbntX]
  have hg1 : g (wcEbntX W a 1) = γ := by simp [g, wcEbntX]

  have hunit := wcpa_dj_lr1k_ebnt_node_unit_criterion Ω W a ↥W g (by rw [hg0]; exact hγnu)
    (by rw [hg1]; exact hγnu)
    (fun c hc => by rw [hgC]; exact (IsLocalRing.mem_maximalIdeal c).mp hc)

  obtain ⟨k, ⟨hk, _⟩, -⟩ := hH.2.2 ↥W (wcpa_dj_lmga_valuation_henselian Ω W) g hunit
  refine Function.LeftInverse.injective (g := ⇑k) ?_
  intro t
  have e1 : σ t = f (Ideal.Quotient.mk _ (MvPolynomial.C t)) := (RingHom.congr_fun hfσ t).symm
  have e2 := RingHom.congr_fun hk (Ideal.Quotient.mk _ (MvPolynomial.C t))
  simp only [RingHom.comp_apply] at e2
  rw [e1, e2, hgC]

theorem wcpa_dj_lr1k_ebnt_dms_gauss_point : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (μ₀ μ₁ : ↥W), μ₀ ∈ IsLocalRing.maximalIdeal ↥W → μ₁ ∈ IsLocalRing.maximalIdeal ↥W → μ₀ * μ₁ = b → ∃ (K : Type u) (_ : Field K) (V : ValuationSubring K) (k : Q →+* V), IsLocalHom k ∧ (∀ γ : ↥W, γ ≠ 0 → k (σ γ) ≠ 0) ∧ (∀ w₁ w₂ : ↥W, (∃ ε : V, IsUnit ε ∧ k (σ w₁) = ε * k (σ w₂)) → Associated w₁ w₂) ∧ (∃ e₀ e₁ : V, IsUnit e₀ ∧ IsUnit e₁ ∧ k (f (wcEbntX W b 0)) = e₀ * k (σ μ₀) ∧ k (f (wcEbntX W b 1)) = e₁ * k (σ μ₁)) ∧ ∀ (d : ℕ) (a a' : ℕ → ↥W) (δ : ↥W), (∀ i ≤ d, δ ∣ a i * μ₀ ^ i ∧ δ ∣ a' i * μ₁ ^ (i + 1)) → (∃ i ≤ d, a i * μ₀ ^ i ∣ δ ∨ a' i * μ₁ ^ (i + 1) ∣ δ) → ∃ ε : V, IsUnit ε ∧ k (f (Ideal.Quotient.mk _ (∑ i ∈ Finset.range (d + 1), MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i + ∑ j ∈ Finset.range (d + 1), MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1)))) = ε * k (σ δ) :=
by
  intro Ω _ _ W Q _ σ b f hf μ₀ μ₁ hμ₀ hμ₁ hμb
  classical

  have hgauss : ∃ (K : Type u) (_ : Field K) (V : ValuationSubring K) (c : ↥W →+* ↥V) (τ : ↥V),
      IsAlgClosed K ∧ Function.Injective c ∧ ∀ Φ : Polynomial ↥W,
        IsUnit (Polynomial.eval₂ c τ Φ) ↔ ∃ n : ℕ, Φ.coeff n ∉ IsLocalRing.maximalIdeal ↥W := by
    let P : Ideal (Polynomial ↥W) := Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)
    haveI hP : P.IsPrime := Ideal.isPrime_map_C_of_isPrime
    let g₀ : Polynomial ↥W →+* AlgebraicClosure (FractionRing (Polynomial ↥W)) :=
      (algebraMap (FractionRing (Polynomial ↥W)) (AlgebraicClosure (FractionRing (Polynomial ↥W)))).comp
        (algebraMap (Polynomial ↥W) (FractionRing (Polynomial ↥W)))
    have hg₀inj : Function.Injective g₀ :=
      (algebraMap (FractionRing (Polynomial ↥W)) (AlgebraicClosure (FractionRing (Polynomial ↥W)))).injective.comp
        (IsFractionRing.injective _ _)
    have hg₀ : ∀ y : P.primeCompl, IsUnit (g₀ y) := by
      intro y
      apply Ne.isUnit
      intro h
      have : (y : Polynomial ↥W) = 0 := hg₀inj (by rw [h, map_zero])
      exact y.2 (by rw [this]; exact P.zero_mem)
    let j : Localization.AtPrime P →+* AlgebraicClosure (FractionRing (Polynomial ↥W)) :=
      IsLocalization.lift (M := P.primeCompl) hg₀
    have hAR : Function.Injective (algebraMap (Polynomial ↥W) (Localization.AtPrime P)) :=
      IsLocalization.injective (M := P.primeCompl) (Localization.AtPrime P)
        (Ideal.primeCompl_le_nonZeroDivisors P)
    have hjinj : Function.Injective j := by
      rw [IsLocalization.lift_injective_iff]
      intro x y
      exact ⟨fun h => by rw [hAR h], fun h => by rw [hg₀inj h]⟩
    obtain ⟨V, hLV⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.range
      (R := Localization.AtPrime P) (S := AlgebraicClosure (FractionRing (Polynomial ↥W))) j)
    obtain ⟨hLV', hloc⟩ := LocalSubring.le_def.mp hLV
    have hmemL : ∀ r, j r ∈ (LocalSubring.range (R := Localization.AtPrime P)
        (S := AlgebraicClosure (FractionRing (Polynomial ↥W))) j).toSubring := by
      intro r
      rw [LocalSubring.range_toSubring]
      exact ⟨r, rfl⟩
    have hmemV : ∀ r, j r ∈ V := fun r => hLV' (hmemL r)
    let ι : Polynomial ↥W →+* ↥V :=
      (j.comp (algebraMap (Polynomial ↥W) (Localization.AtPrime P))).codRestrict V (fun a => hmemV _)
    have hιval : ∀ a, (ι a : AlgebraicClosure (FractionRing (Polynomial ↥W))) =
        j (algebraMap _ (Localization.AtPrime P) a) := fun a => rfl
    have hιinj : Function.Injective ι := by
      intro a b h
      have h1 := congrArg Subtype.val h
      rw [hιval, hιval] at h1
      exact hAR (hjinj h1)
    have hstar : ∀ Φ : Polynomial ↥W,
        Polynomial.eval₂ (ι.comp Polynomial.C) (ι Polynomial.X) Φ = ι Φ := by
      intro Φ
      conv_rhs => rw [← Polynomial.eval₂_C_X (p := Φ)]
      rw [Polynomial.hom_eval₂]
    refine ⟨AlgebraicClosure (FractionRing (Polynomial ↥W)), inferInstance, V, ι.comp Polynomial.C,
      ι Polynomial.X, inferInstance, hιinj.comp Polynomial.C_injective, ?_⟩
    intro Φ
    rw [hstar]
    have hmemP : Φ ∈ P ↔ ∀ n, Φ.coeff n ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mem_map_C_iff
    constructor
    · intro hu
      by_contra hcon
      push_neg at hcon
      have hΦP : Φ ∈ P := hmemP.mpr hcon
      have hy : IsUnit (Subring.inclusion hLV'
          ⟨j (algebraMap _ (Localization.AtPrime P) Φ), hmemL _⟩) := by
        obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp hu
        refine isUnit_iff_exists_inv.mpr
          ⟨⟨(v : AlgebraicClosure (FractionRing (Polynomial ↥W))), v.2⟩, ?_⟩
        apply Subtype.ext
        have h1 := congrArg Subtype.val hv
        exact h1
      have hy' := hloc.map_nonunit _ hy
      obtain ⟨z, hz⟩ := isUnit_iff_exists_inv.mp hy'
      have hzmem : (z : AlgebraicClosure (FractionRing (Polynomial ↥W))) ∈ Set.range j := by
        have hsub : ∀ x, x ∈ (LocalSubring.range (R := Localization.AtPrime P)
            (S := AlgebraicClosure (FractionRing (Polynomial ↥W))) j).toSubring →
            x ∈ Set.range j := by
          intro x hx
          rw [LocalSubring.range_toSubring] at hx
          exact hx
        exact hsub _ z.2
      obtain ⟨s, hs⟩ := hzmem
      have h1 : j (algebraMap _ (Localization.AtPrime P) Φ * s) = j 1 := by
        rw [map_mul, hs, map_one]
        exact congrArg Subtype.val hz
      have hunitR : IsUnit (algebraMap _ (Localization.AtPrime P) Φ) :=
        isUnit_iff_exists_inv.mpr ⟨s, hjinj h1⟩
      exact (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P) P Φ).mp hunitR hΦP
    · rintro ⟨n, hn⟩
      have hΦP : Φ ∉ P := fun h => hn (hmemP.mp h n)
      have hu : IsUnit (algebraMap _ (Localization.AtPrime P) Φ) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P) P Φ).mpr hΦP
      obtain ⟨r', hr'⟩ := isUnit_iff_exists_inv.mp hu
      refine isUnit_iff_exists_inv.mpr ⟨⟨j r', hmemV r'⟩, ?_⟩
      apply Subtype.ext
      show j (algebraMap _ (Localization.AtPrime P) Φ) * j r' = 1
      rw [← map_mul, hr', map_one]

  have hlaurent : ∀ (V : Type u) [CommRing V] (c : ↥W →+* V) (τ τ' : V), τ * τ' = 1 →
      (∀ Φ : Polynomial ↥W, (∃ n : ℕ, Φ.coeff n ∉ IsLocalRing.maximalIdeal ↥W) →
        IsUnit (Polynomial.eval₂ c τ Φ)) →
      ∀ (d : ℕ) (t t' : ℕ → ↥W) (δ : ↥W), (∀ i ≤ d, δ ∣ t i ∧ δ ∣ t' i) →
        (∃ i ≤ d, t i ∣ δ ∨ t' i ∣ δ) →
        ∃ ε : V, IsUnit ε ∧ ∑ i ∈ Finset.range (d + 1), c (t i) * τ ^ i +
          ∑ j ∈ Finset.range (d + 1), c (t' j) * τ' ^ (j + 1) = ε * c δ := by
    intro V _ c τ τ' hττ' hΦ d t t' δ hdiv hex
    by_cases hδ : δ = 0
    · subst hδ
      refine ⟨1, isUnit_one, ?_⟩
      rw [map_zero, mul_zero]
      have h0 : ∀ i ∈ Finset.range (d + 1), t i = 0 ∧ t' i = 0 := fun i hi => by
        have := hdiv i (by rw [Finset.mem_range] at hi; omega)
        exact ⟨zero_dvd_iff.mp this.1, zero_dvd_iff.mp this.2⟩
      rw [Finset.sum_eq_zero (fun i hi => by rw [(h0 i hi).1, map_zero, zero_mul]),
        Finset.sum_eq_zero (fun i hi => by rw [(h0 i hi).2, map_zero, zero_mul]), add_zero]
    · let q : ℕ → ↥W := fun i => if h : δ ∣ t i then Classical.choose h else 0
      let q' : ℕ → ↥W := fun i => if h : δ ∣ t' i then Classical.choose h else 0
      have hq : ∀ i ≤ d, t i = δ * q i := fun i hi => by
        have h := (hdiv i hi).1
        simp only [q, dif_pos h]
        exact Classical.choose_spec h
      have hq' : ∀ i ≤ d, t' i = δ * q' i := fun i hi => by
        have h := (hdiv i hi).2
        simp only [q', dif_pos h]
        exact Classical.choose_spec h
      have hS : ∑ i ∈ Finset.range (d + 1), c (t i) * τ ^ i +
          ∑ j ∈ Finset.range (d + 1), c (t' j) * τ' ^ (j + 1) =
          c δ * (∑ i ∈ Finset.range (d + 1), c (q i) * τ ^ i +
            ∑ j ∈ Finset.range (d + 1), c (q' j) * τ' ^ (j + 1)) := by
        rw [mul_add, Finset.mul_sum, Finset.mul_sum]
        congr 1
        · apply Finset.sum_congr rfl
          intro i hi
          rw [hq i (by rw [Finset.mem_range] at hi; omega), map_mul]
          ring
        · apply Finset.sum_congr rfl
          intro i hi
          rw [hq' i (by rw [Finset.mem_range] at hi; omega), map_mul]
          ring
      let Φ : Polynomial ↥W :=
        ∑ i ∈ Finset.range (d + 1), Polynomial.C (q i) * Polynomial.X ^ (i + d + 1) +
          ∑ j ∈ Finset.range (d + 1), Polynomial.C (q' j) * Polynomial.X ^ (d - j)
      have heval : Polynomial.eval₂ c τ Φ = τ ^ (d + 1) *
          (∑ i ∈ Finset.range (d + 1), c (q i) * τ ^ i +
            ∑ j ∈ Finset.range (d + 1), c (q' j) * τ' ^ (j + 1)) := by
        simp only [Φ, Polynomial.eval₂_add, Polynomial.eval₂_finset_sum, Polynomial.eval₂_mul,
          Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        rw [mul_add, Finset.mul_sum, Finset.mul_sum]
        congr 1
        · apply Finset.sum_congr rfl
          intro i _
          ring
        · apply Finset.sum_congr rfl
          intro j hj
          have hj' : j ≤ d := by rw [Finset.mem_range] at hj; omega
          have e : τ ^ (d + 1) = τ ^ (d - j) * τ ^ (j + 1) := by
            rw [← pow_add]; congr 1; omega
          rw [e]
          calc c (q' j) * τ ^ (d - j) = c (q' j) * τ ^ (d - j) * (τ * τ') ^ (j + 1) := by
                rw [hττ', one_pow, mul_one]
            _ = τ ^ (d - j) * τ ^ (j + 1) * (c (q' j) * τ' ^ (j + 1)) := by ring
      have hcoeff : ∀ n, Φ.coeff n =
          (∑ i ∈ Finset.range (d + 1), if n = i + d + 1 then q i else 0) +
            ∑ j ∈ Finset.range (d + 1), if n = d - j then q' j else 0 := by
        intro n
        simp only [Φ, Polynomial.coeff_add, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
      have hunitcoeff : ∃ n, Φ.coeff n ∉ IsLocalRing.maximalIdeal ↥W := by
        obtain ⟨i₀, hi₀, h | h⟩ := hex
        · obtain ⟨r, hr⟩ := h
          rw [hq i₀ hi₀] at hr
          have h1 : q i₀ * r = 1 :=
            mul_left_cancel₀ hδ (by rw [mul_one, ← mul_assoc]; exact hr.symm)
          refine ⟨i₀ + d + 1, ?_⟩
          have e1 : (∑ i ∈ Finset.range (d + 1), if i₀ + d + 1 = i + d + 1 then q i else 0) =
              q i₀ := by
            rw [Finset.sum_eq_single i₀ (fun i _ hne => if_neg (by omega))
              (fun h => absurd (Finset.mem_range.mpr (by omega)) h), if_pos rfl]
          have e2 : (∑ j ∈ Finset.range (d + 1), if i₀ + d + 1 = d - j then q' j else 0) = 0 :=
            Finset.sum_eq_zero (fun j _ => if_neg (by omega))
          rw [hcoeff, e1, e2, add_zero]
          exact IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨_, h1⟩)
        · obtain ⟨r, hr⟩ := h
          rw [hq' i₀ hi₀] at hr
          have h1 : q' i₀ * r = 1 :=
            mul_left_cancel₀ hδ (by rw [mul_one, ← mul_assoc]; exact hr.symm)
          refine ⟨d - i₀, ?_⟩
          have e1 : (∑ i ∈ Finset.range (d + 1), if d - i₀ = i + d + 1 then q i else 0) = 0 :=
            Finset.sum_eq_zero (fun i _ => if_neg (by omega))
          have e2 : (∑ j ∈ Finset.range (d + 1), if d - i₀ = d - j then q' j else 0) = q' i₀ := by
            rw [Finset.sum_eq_single i₀
              (fun j hj hne => if_neg (by rw [Finset.mem_range] at hj; omega))
              (fun h => absurd (Finset.mem_range.mpr (by omega)) h), if_pos rfl]
          rw [hcoeff, e1, e2, zero_add]
          exact IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨_, h1⟩)
      have hU := hΦ Φ hunitcoeff
      rw [heval] at hU
      exact ⟨_, isUnit_of_mul_isUnit_right hU, by rw [hS, mul_comm]⟩

  have hcrit : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (φ : wcEbntN W b →+* B),
      ¬ IsUnit (φ (wcEbntX W b 0)) → ¬ IsUnit (φ (wcEbntX W b 1)) →
      (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
        ¬ IsUnit (φ (Ideal.Quotient.mk _ (MvPolynomial.C w)))) →
      ∀ t, IsUnit (φ t) ↔ t ∉ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map MvPolynomial.C).map
        (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})) := by
    intro B _ _ φ hX0 hX1 hC t
    have hnu : ∀ x : B, ¬ IsUnit x → x ∈ IsLocalRing.maximalIdeal B := fun x hx =>
      (IsLocalRing.mem_maximalIdeal x).mpr hx
    have hle : ∀ s, s ∈ (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
        (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)).map
        (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b :
          MvPolynomial (Fin 2) ↥W)})) → φ s ∈ IsLocalRing.maximalIdeal B := by
      intro s hs
      have h : (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} ⊔
          (IsLocalRing.maximalIdeal ↥W).map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)).map
          (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b :
            MvPolynomial (Fin 2) ↥W)})) ≤ (IsLocalRing.maximalIdeal B).comap φ := by
        rw [Ideal.map_le_iff_le_comap]
        refine sup_le ?_ ?_
        · rw [Ideal.span_le]
          intro x hx
          simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
          rcases hx with rfl | rfl
          · exact hnu _ hX0
          · exact hnu _ hX1
        · rw [Ideal.map_le_iff_le_comap]
          intro w hw
          exact hnu _ (hC w hw)
      exact h hs
    have s2 : ∀ p : MvPolynomial (Fin 2) ↥W, p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W), MvPolynomial.X 1} := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r =>
        simp
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
          rw [map_add, MvPolynomial.C_add]; ring
        rw [e]
        exact add_mem hp hq
      | mul_X p n _ =>
        have e : p * MvPolynomial.X n -
            MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X n)) =
            p * MvPolynomial.X n := by
          simp
        rw [e]
        apply Ideal.mul_mem_left
        apply Ideal.subset_span
        have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
        rcases hn with rfl | rfl
        · exact Set.mem_insert _ _
        · exact Set.mem_insert_of_mem _ rfl
    constructor
    · intro hu ht
      exact (IsLocalRing.mem_maximalIdeal _).mp (hle t ht) hu
    · intro ht
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective t
      obtain ⟨p₀, hp₀⟩ : ∃ p₀, MvPolynomial.constantCoeff p = p₀ := ⟨_, rfl⟩
      have hr := s2 p
      rw [hp₀] at hr
      have hp0 : p₀ ∉ IsLocalRing.maximalIdeal ↥W := by
        intro hm
        apply ht
        apply Ideal.mem_map_of_mem
        have e : p = (p - MvPolynomial.C p₀) + MvPolynomial.C p₀ := by ring
        rw [e]
        exact add_mem (Ideal.mem_sup_left hr) (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hm))
      have hu : IsUnit (φ (Ideal.Quotient.mk _ (MvPolynomial.C p₀))) :=
        IsUnit.map φ (IsUnit.map _ (IsUnit.map MvPolynomial.C
          (IsLocalRing.notMem_maximalIdeal.mp hp0)))
      have hn : φ (Ideal.Quotient.mk _ (p - MvPolynomial.C p₀)) ∈ IsLocalRing.maximalIdeal B :=
        hle _ (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left hr))
      have heq : φ (Ideal.Quotient.mk _ p) = φ (Ideal.Quotient.mk _ (MvPolynomial.C p₀)) +
          φ (Ideal.Quotient.mk _ (p - MvPolynomial.C p₀)) := by
        rw [← map_add, ← map_add]; congr 2; ring
      rw [heq]
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hsum
      have hm : φ (Ideal.Quotient.mk _ (MvPolynomial.C p₀)) ∈ IsLocalRing.maximalIdeal B := by
        have h2 := Ideal.sub_mem _ hsum hn
        rwa [add_sub_cancel_right] at h2
      exact (IsLocalRing.mem_maximalIdeal _).mp hm hu

  obtain ⟨K, _, V, c, τ, hK, hc, hiff⟩ := hgauss
  haveI := hK

  haveI hVH : HenselianLocalRing ↥V := by
    refine ⟨fun p hp a₀ h₁ _ => ?_⟩
    have h2 : V.valuation (algebraMap V K (p.eval a₀)) < 1 := (V.valuation_lt_one_iff _).mp h₁
    have hsplit := IsAlgClosed.splits (p.map (algebraMap V K))
    have h3 := Polynomial.Splits.aeval_eq_prod_aroots_of_monic hsplit hp (algebraMap V K a₀)
    rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at h3
    rw [h3] at h2
    have h4 : ∃ α ∈ p.aroots K, V.valuation (algebraMap V K a₀ - α) < 1 := by
      by_contra hcon
      push_neg at hcon
      rw [map_multiset_prod, Multiset.map_map] at h2
      have : 1 ≤ ((p.aroots K).map (V.valuation ∘ fun α => algebraMap V K a₀ - α)).prod := by
        apply Multiset.one_le_prod
        intro x hx
        obtain ⟨α, hα, rfl⟩ := Multiset.mem_map.mp hx
        exact hcon α hα
      exact absurd h2 (not_lt.mpr this)
    obtain ⟨α, hα, hv⟩ := h4
    have hα' := (Polynomial.mem_aroots.mp hα).2
    have hint : _root_.IsIntegral V α := ⟨p, hp, by rwa [← Polynomial.aeval_def]⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, ?_, ?_⟩
    · show Polynomial.eval y p = 0
      apply FaithfulSMul.algebraMap_injective V K
      rw [map_zero, ← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval, hy]
      exact hα'
    · rw [V.valuation_lt_one_iff]
      have e : ((y - a₀ : V) : K) = algebraMap V K y - algebraMap V K a₀ := by
        simp only [ValuationSubring.algebraMap_apply]; push_cast; rfl
      rw [e, hy, Valuation.map_sub_swap]
      exact hv

  have hu1 : ∀ w : ↥W, IsUnit (c w) ↔ w ∉ IsLocalRing.maximalIdeal ↥W := by
    intro w
    have h := hiff (Polynomial.C w)
    rw [Polynomial.eval₂_C] at h
    rw [h]
    constructor
    · rintro ⟨n, hn⟩ hw
      apply hn
      rw [Polynomial.coeff_C]
      split_ifs
      · exact hw
      · exact Ideal.zero_mem _
    · intro hw
      exact ⟨0, by rw [Polynomial.coeff_C_zero]; exact hw⟩
  have hτ : IsUnit τ := by
    have h := (hiff Polynomial.X).mpr ⟨1, by
      rw [Polynomial.coeff_X_one]; exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one⟩
    rwa [Polynomial.eval₂_X] at h
  obtain ⟨τ', hττ'⟩ : ∃ τ' : ↥V, τ * τ' = 1 := ⟨_, hτ.mul_val_inv⟩
  have hτ'u : IsUnit τ' := isUnit_of_mul_isUnit_right (x := τ) (by rw [hττ']; exact isUnit_one)

  let v : Fin 2 → ↥V := ![c μ₀ * τ, c μ₁ * τ']
  have hgX0 : MvPolynomial.eval₂Hom c v (MvPolynomial.X 0) = c μ₀ * τ := by simp [v]
  have hgX1 : MvPolynomial.eval₂Hom c v (MvPolynomial.X 1) = c μ₁ * τ' := by simp [v]
  have hgC : ∀ w, MvPolynomial.eval₂Hom c v (MvPolynomial.C w) = c w := fun w =>
    MvPolynomial.eval₂Hom_C _ _ _
  have hvan : ∀ p ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b :
      MvPolynomial (Fin 2) ↥W)}, MvPolynomial.eval₂Hom c v p = 0 := by
    intro p hp
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    have h0 : MvPolynomial.eval₂Hom c v
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b) = 0 := by
      rw [map_sub, map_mul, hgX0, hgX1, hgC, ← hμb, map_mul]
      linear_combination (c μ₀ * c μ₁) * hττ'
    rw [map_mul, h0, mul_zero]
  let g : wcEbntN W b →+* ↥V := Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom c v) hvan
  have hg : ∀ p, g (Ideal.Quotient.mk _ p) = MvPolynomial.eval₂Hom c v p := fun p =>
    Ideal.Quotient.lift_mk _ _ _
  have hg0 : g (wcEbntX W b 0) = c μ₀ * τ := by
    show g (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = _
    rw [hg, hgX0]
  have hg1 : g (wcEbntX W b 1) = c μ₁ * τ' := by
    show g (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = _
    rw [hg, hgX1]

  have hnu0 : ¬ IsUnit (g (wcEbntX W b 0)) := by
    rw [hg0]
    intro h
    exact (hu1 μ₀).mp (isUnit_of_mul_isUnit_left h) hμ₀
  have hnu1 : ¬ IsUnit (g (wcEbntX W b 1)) := by
    rw [hg1]
    intro h
    exact (hu1 μ₁).mp (isUnit_of_mul_isUnit_left h) hμ₁
  have hnuC : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      ¬ IsUnit (g (Ideal.Quotient.mk _ (MvPolynomial.C w))) := by
    intro w hw h
    rw [hg, hgC] at h
    exact (hu1 w).mp h hw
  have hunit := hcrit ↥V g hnu0 hnu1 hnuC
  obtain ⟨k, ⟨hkf, hkloc⟩, -⟩ := hf.2.2.2.2.2 ↥V hVH g hunit
  have hkfe : ∀ t, k (f t) = g t := fun t => RingHom.congr_fun hkf t
  have hkσ : ∀ w, k (σ w) = c w := by
    intro w
    have h1 : σ w = f (Ideal.Quotient.mk _ (MvPolynomial.C w)) :=
      (RingHom.congr_fun hf.2.2.1 w).symm
    rw [h1, hkfe, hg, hgC]
  have hcz : ∀ w : ↥W, w ≠ 0 → c w ≠ 0 := fun w hw h => hw (hc (h.trans (map_zero c).symm))

  refine ⟨K, inferInstance, V, k, hkloc, ?_, ?_, ⟨τ, τ', hτ, hτ'u, ?_, ?_⟩, ?_⟩
  · intro γ hγ
    rw [hkσ]
    exact hcz γ hγ
  · rintro w₁ w₂ ⟨ε, hε, hw⟩
    rw [hkσ, hkσ] at hw
    rcases ValuationRing.dvd_total w₁ w₂ with ⟨z, hz⟩ | ⟨z, hz⟩
    · by_cases h0 : w₁ = 0
      · rw [hz, h0, zero_mul]
      · have hc0 := hcz w₁ h0
        rw [hz, map_mul] at hw
        have h1 : ε * c z = 1 := by
          apply mul_left_cancel₀ hc0
          linear_combination -hw
        have hczu : IsUnit (c z) := isUnit_of_mul_isUnit_right (x := ε) (by rw [h1]; exact isUnit_one)
        have hzu : IsUnit z := IsLocalRing.notMem_maximalIdeal.mp ((hu1 z).mp hczu)
        exact ⟨hzu.unit, by rw [IsUnit.unit_spec, hz]⟩
    · by_cases h0 : w₂ = 0
      · rw [hz, h0, zero_mul]
      · have hc0 := hcz w₂ h0
        rw [hz, map_mul] at hw
        have h1 : c z = ε := by
          apply mul_left_cancel₀ hc0
          linear_combination hw
        have hzu : IsUnit z := IsLocalRing.notMem_maximalIdeal.mp ((hu1 z).mp (h1 ▸ hε))
        have hass : Associated w₂ w₁ := ⟨hzu.unit, by rw [IsUnit.unit_spec, hz]⟩
        exact hass.symm
  · rw [hkfe, hg0, hkσ, mul_comm]
  · rw [hkfe, hg1, hkσ, mul_comm]
  · intro d a a' δ hdiv hex
    have hval : k (f (Ideal.Quotient.mk _ (∑ i ∈ Finset.range (d + 1),
        MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i + ∑ j ∈ Finset.range (d + 1),
        MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1)))) =
        ∑ i ∈ Finset.range (d + 1), c (a i * μ₀ ^ i) * τ ^ i +
          ∑ j ∈ Finset.range (d + 1), c (a' j * μ₁ ^ (j + 1)) * τ' ^ (j + 1) := by
      rw [hkfe, hg]
      simp only [map_add, map_sum, map_mul, map_pow, hgC, hgX0, hgX1]
      congr 1 <;> refine Finset.sum_congr rfl (fun i _ => by ring)
    obtain ⟨ε, hε, hS⟩ := hlaurent ↥V c τ τ' hττ' (fun Φ h => (hiff Φ).mpr h) d
      (fun i => a i * μ₀ ^ i) (fun j => a' j * μ₁ ^ (j + 1)) δ hdiv hex
    refine ⟨ε, hε, ?_⟩
    rw [hval, hkσ]
    exact hS

theorem wcpa_dj_lr1k_ebnt_dms_approx : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (F : Q) (N : ℕ) (π : ↥W), 1 ≤ N → π ∈ IsLocalRing.maximalIdeal ↥W → π ≠ 0 → ∃ p : wcEbntN W b, F - f p ∈ Ideal.span {f (wcEbntX W b 0) ^ N, f (wcEbntX W b 1) ^ N, σ π} :=
by
  intro Ω _ _ W hdim _ Q _ σ b f hf F N π hN hπm hπ0
  classical

  have hquot : ∀ (A : Type u) [CommRing A] (p 𝔞 : Ideal A) (P : Type u) [CommRing P]
      (e : A →+* P), wcNdIsHens p P e → 𝔞 ≤ p →
      wcNdIsHens (p.map (Ideal.Quotient.mk 𝔞)) (P ⧸ 𝔞.map e)
        (Ideal.quotientMap (𝔞.map e) e Ideal.le_comap_map) := by
    intro A _ p 𝔞 P _ e he h𝔞
    have s1 : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] (I : Ideal R), I ≠ ⊤ →
        HenselianLocalRing (R ⧸ I) := by
      intro R _ _ I hI
      haveI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
      have hsurj : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
      haveI : IsLocalRing (R ⧸ I) := IsLocalRing.of_surjective' _ hsurj
      haveI : IsLocalHom (Ideal.Quotient.mk I) := IsLocalHom.of_surjective _ hsurj
      refine HenselianLocalRing.mk ?_
      intro g hg a₀ ha₀ hd
      have hlift : g ∈ Polynomial.lifts (Ideal.Quotient.mk I) :=
        (Polynomial.mem_lifts g).mpr (Polynomial.map_surjective _ hsurj g)
      obtain ⟨G, hGg, -, hGm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hg
      obtain ⟨b₀, rfl⟩ := hsurj a₀
      have e1 : Ideal.Quotient.mk I (G.eval b₀) = g.eval (Ideal.Quotient.mk I b₀) := by
        rw [← hGg, Polynomial.eval_map, Polynomial.eval₂_at_apply]
      have e2 : Ideal.Quotient.mk I ((Polynomial.derivative G).eval b₀) =
          (Polynomial.derivative g).eval (Ideal.Quotient.mk I b₀) := by
        rw [← hGg, Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
      have h1 : G.eval b₀ ∈ IsLocalRing.maximalIdeal R := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have := hu.map (Ideal.Quotient.mk I)
        rw [e1] at this
        exact (IsLocalRing.mem_maximalIdeal _).mp ha₀ this
      have h2 : IsUnit ((Polynomial.derivative G).eval b₀) := by
        rw [← isUnit_map_iff (Ideal.Quotient.mk I), e2]; exact hd
      obtain ⟨b, hb, hbb⟩ := HenselianLocalRing.is_henselian G hGm b₀ h1 h2
      refine ⟨Ideal.Quotient.mk I b, ?_, ?_⟩
      · rw [← hGg]; exact Polynomial.IsRoot.map hb
      · rw [← map_sub]
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hbb ⊢
        intro hu; exact hbb ((isUnit_map_iff _ _).mp hu)
    obtain ⟨hH, hU, hUP⟩ := he
    haveI := hH
    have hJle : 𝔞.map e ≤ IsLocalRing.maximalIdeal P := by
      rw [Ideal.map_le_iff_le_comap]
      intro t ht
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (hU t).mp hu (h𝔞 ht)
    have hJne : 𝔞.map e ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal P).ne_top (eq_top_iff.mpr (h ▸ hJle))
    haveI : Nontrivial (P ⧸ 𝔞.map e) := Ideal.Quotient.nontrivial_iff.mpr hJne
    have hsurj : Function.Surjective (Ideal.Quotient.mk (𝔞.map e)) := Ideal.Quotient.mk_surjective
    haveI hπ : IsLocalHom (Ideal.Quotient.mk (𝔞.map e)) := IsLocalHom.of_surjective _ hsurj
    have hHq : HenselianLocalRing (P ⧸ 𝔞.map e) := s1 P (𝔞.map e) hJne
    have hM : ∀ t : A, Ideal.Quotient.mk 𝔞 t ∈ p.map (Ideal.Quotient.mk 𝔞) ↔ t ∈ p := by
      intro t
      constructor
      · intro ht
        have : t ∈ (p.map (Ideal.Quotient.mk 𝔞)).comap (Ideal.Quotient.mk 𝔞) :=
          Ideal.mem_comap.mpr ht
        rwa [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
          sup_eq_left.mpr h𝔞] at this
      · exact Ideal.mem_map_of_mem _
    have hē : ∀ t : A, Ideal.quotientMap (𝔞.map e) e Ideal.le_comap_map (Ideal.Quotient.mk 𝔞 t) =
        Ideal.Quotient.mk (𝔞.map e) (e t) := fun t => Ideal.quotientMap_mk
    refine ⟨hHq, ?_, ?_⟩
    · intro a
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [hē, isUnit_map_iff, hU, hM]
    · intro B _ hB g hg
      have hg0 : ∀ t, IsUnit ((g.comp (Ideal.Quotient.mk 𝔞)) t) ↔ t ∉ p := by
        intro t
        rw [RingHom.comp_apply, hg, hM]
      obtain ⟨h, ⟨hhe, hhl⟩, huniq⟩ := hUP B hB (g.comp (Ideal.Quotient.mk 𝔞)) hg0
      have hJker : ∀ z ∈ 𝔞.map e, h z = 0 := by
        have hle : 𝔞.map e ≤ RingHom.ker h := by
          rw [Ideal.map_le_iff_le_comap]
          intro t ht
          rw [Ideal.mem_comap, RingHom.mem_ker]
          have := RingHom.congr_fun hhe t
          rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr ht,
            map_zero] at this
          exact this
        exact fun z hz => RingHom.mem_ker.mp (hle hz)
      refine ⟨Ideal.Quotient.lift (𝔞.map e) h hJker, ⟨?_, ?_⟩, ?_⟩
      · apply Ideal.Quotient.ringHom_ext
        refine RingHom.ext fun t => ?_
        simp only [RingHom.comp_apply]
        rw [hē, Ideal.Quotient.lift_mk]
        exact RingHom.congr_fun hhe t
      · refine ⟨fun x hx => ?_⟩
        obtain ⟨z, rfl⟩ := hsurj x
        rw [Ideal.Quotient.lift_mk] at hx
        exact (isUnit_of_map_unit h z hx).map _
      · rintro h' ⟨h1', h2'⟩
        haveI := h2'
        have hloc : IsLocalHom (h'.comp (Ideal.Quotient.mk (𝔞.map e))) := inferInstance
        have heq : h'.comp (Ideal.Quotient.mk (𝔞.map e)) = h := by
          refine huniq _ ⟨RingHom.ext fun t => ?_, hloc⟩
          have := RingHom.congr_fun h1' (Ideal.Quotient.mk 𝔞 t)
          simp only [RingHom.comp_apply] at this ⊢
          rw [hē] at this
          exact this
        apply Ideal.Quotient.ringHom_ext
        rw [heq, Ideal.Quotient.lift_comp_mk]

  have hnil : ∀ (A : Type u) [CommRing A] (p : Ideal A), (∀ a ∈ p, IsNilpotent a) →
      (∀ a, a ∉ p → IsUnit a) → (1 : A) ∉ p →
      HenselianLocalRing A ∧ ∀ a : A, IsUnit a ↔ a ∉ p := by
    intro A _ p hn hu h1
    haveI : Nontrivial A := ⟨⟨0, 1, fun h => h1 (h ▸ p.zero_mem)⟩⟩
    have hiff : ∀ a : A, IsUnit a ↔ a ∉ p :=
      fun a => ⟨fun ha hp => (hn a hp).not_isUnit ha, hu a⟩
    haveI : IsLocalRing A := IsLocalRing.of_isUnit_or_isUnit_one_sub_self (fun a => by
      by_cases ha : a ∈ p
      · exact Or.inr (hn a ha).isUnit_one_sub
      · exact Or.inl (hu a ha))
    have hmem : ∀ a : A, a ∈ IsLocalRing.maximalIdeal A ↔ a ∈ p := by
      intro a; rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hiff, not_not]
    refine ⟨HenselianLocalRing.mk ?_, hiff⟩
    intro g _ a₀ h0 hd
    have h0' : IsNilpotent (Polynomial.aeval a₀ g) := by
      rw [Polynomial.coe_aeval_eq_eval]; exact hn _ ((hmem _).mp h0)
    have hd' : IsUnit (Polynomial.aeval a₀ (Polynomial.derivative g)) := by
      rw [Polynomial.coe_aeval_eq_eval]; exact hd
    obtain ⟨r, ⟨hr1, hr2⟩, -⟩ := Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero h0' hd'
    refine ⟨r, ?_, ?_⟩
    · rw [Polynomial.coe_aeval_eq_eval] at hr2; exact hr2
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      have : IsNilpotent (r - a₀) := by
        have := hr1.neg; rwa [neg_sub] at this
      exact this.not_isUnit

  have hsurjgen : ∀ (A : Type u) [CommRing A] (p : Ideal A) (P : Type u) [CommRing P]
      (e : A →+* P), wcNdIsHens p P e → HenselianLocalRing A → (∀ a : A, IsUnit a ↔ a ∉ p) →
      Function.Surjective e := by
    intro A _ p P _ e he hA hAu
    obtain ⟨hP, hU, hUP⟩ := he
    obtain ⟨r, ⟨hr, hrl⟩, -⟩ := hUP A hA (RingHom.id A) hAu
    haveI : IsLocalHom e := ⟨fun a ha => (hAu a).mpr ((hU a).mp ha)⟩
    haveI := hrl
    obtain ⟨h0, -, huniq⟩ := hUP P hP e hU
    have h1 : e.comp r = h0 :=
      huniq _ ⟨by rw [RingHom.comp_assoc, hr, RingHom.comp_id], inferInstance⟩
    have h2 : RingHom.id P = h0 := huniq _ ⟨RingHom.id_comp e, inferInstance⟩
    intro y
    refine ⟨r y, ?_⟩
    have := RingHom.congr_fun (h1.trans h2.symm) y
    simpa using this

  obtain ⟨_, _, hσ, hH⟩ := hf

  have hπk : ∀ t ∈ IsLocalRing.maximalIdeal ↥W, ∃ k : ℕ, π ∣ t ^ k := by
    intro t ht
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
    haveI : (⊥ : Ideal ↥W).IsPrime := Ideal.isPrime_bot
    have hmax := (Ring.krullDimLE_one_iff_of_isPrime_bot (R := ↥W)).mp inferInstance
    have hrad : t ∈ (Ideal.span {π}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J' ⟨hJ', hJp'⟩
      have hJ0 : J' ≠ ⊥ := fun h => hπ0 (by
        have : π ∈ J' := hJ' (Ideal.mem_span_singleton_self π)
        rw [h] at this; exact (Ideal.mem_bot.mp this))
      rw [IsLocalRing.eq_maximalIdeal (hmax J' hJ0 hJp')]; exact ht
    obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp hrad
    exact ⟨k, Ideal.mem_span_singleton.mp hk⟩

  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : Ideal (wcEbntN W b), p₀ = Ideal.map (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b}))
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := ⟨_, rfl⟩
  have hH' : wcNdIsHens (A := wcEbntN W b) p₀ Q f := by rw [hp₀]; exact hH
  letI : CommRing (wcEbntN W b) := Ideal.Quotient.commRing _
  obtain ⟨J, hJ⟩ : ∃ J : Ideal (wcEbntN W b), J = Ideal.span {wcEbntX W b 0 ^ N,
      wcEbntX W b 1 ^ N, Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
        (MvPolynomial.C π)} := ⟨_, rfl⟩

  have hX : ∀ i : Fin 2, wcEbntX W b i ∈ p₀ := fun i => by
    rw [hp₀]
    show Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ _
    apply Ideal.mem_map_of_mem
    apply Ideal.mem_sup_left
    apply Ideal.subset_span
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hJp : J ≤ p₀ := by
    rw [hJ, Ideal.span_le]
    intro z hz
    rcases hz with rfl | rfl | rfl
    · exact Ideal.pow_mem_of_mem _ (hX 0) N (by omega)
    · exact Ideal.pow_mem_of_mem _ (hX 1) N (by omega)
    · rw [hp₀]
      apply Ideal.mem_map_of_mem
      apply Ideal.mem_sup_right
      exact Ideal.mem_map_of_mem _ hπm

  have hQ := hquot (wcEbntN W b) p₀ J Q f hH' hJp

  obtain ⟨φ, hφ⟩ : ∃ φ : MvPolynomial (Fin 2) ↥W →+* wcEbntN W b ⧸ J,
      φ = (Ideal.Quotient.mk J).comp (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})) := ⟨_, rfl⟩
  have hp₀' : p₀.map (Ideal.Quotient.mk J) =
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)).map φ := by
    rw [hp₀, Ideal.map_map, hφ]
  have hsurjφ : Function.Surjective φ := by
    rw [hφ]; exact Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hnilA : ∀ a ∈ p₀.map (Ideal.Quotient.mk J), IsNilpotent a := by
    have hle : p₀.map (Ideal.Quotient.mk J) ≤ nilradical (wcEbntN W b ⧸ J) := by
      rw [hp₀', Ideal.map_le_iff_le_comap, sup_le_iff]
      constructor
      · rw [Ideal.span_le]
        intro z hz
        rw [SetLike.mem_coe, Ideal.mem_comap, mem_nilradical]
        refine ⟨N, ?_⟩
        rcases hz with rfl | rfl
        · rw [← map_pow, hφ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_pow, hJ]
          apply Ideal.subset_span
          exact Or.inl rfl
        · rw [← map_pow, hφ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_pow, hJ]
          apply Ideal.subset_span
          exact Or.inr (Or.inl rfl)
      · rw [Ideal.map_le_iff_le_comap]
        intro t ht
        obtain ⟨k, w, hw⟩ := hπk t ht
        rw [Ideal.mem_comap, Ideal.mem_comap, mem_nilradical]
        refine ⟨k, ?_⟩
        rw [← map_pow, ← map_pow, hw, map_mul, map_mul]
        have : φ (MvPolynomial.C π) = 0 := by
          rw [hφ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hJ]
          apply Ideal.subset_span
          exact Or.inr (Or.inr rfl)
        rw [this, zero_mul]
    exact fun a ha => mem_nilradical.mp (hle ha)
  have hconst : ∀ z : MvPolynomial (Fin 2) ↥W,
      z - MvPolynomial.C (MvPolynomial.constantCoeff z) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W)) := by
    intro z
    refine MvPolynomial.induction_on (motive := fun z => z - MvPolynomial.C
      (MvPolynomial.constantCoeff z) ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) ↥W))) z
      ?_ ?_ ?_
    · intro c; simp
    · intro p q hp hq
      have := Ideal.add_mem _ hp hq
      rw [map_add, map_add]
      convert this using 1
      ring
    · intro p n _
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      fin_cases n
      · exact Or.inl rfl
      · exact Or.inr rfl
  have hunitA : ∀ a : wcEbntN W b ⧸ J, a ∉ p₀.map (Ideal.Quotient.mk J) → IsUnit a := by
    intro a ha
    obtain ⟨z, rfl⟩ := hsurjφ a
    have hz0 : MvPolynomial.constantCoeff z ∉ IsLocalRing.maximalIdeal ↥W := by
      intro hm
      apply ha
      rw [hp₀']
      apply Ideal.mem_map_of_mem
      have hz : z = (z - MvPolynomial.C (MvPolynomial.constantCoeff z)) +
          MvPolynomial.C (MvPolynomial.constantCoeff z) := by ring
      rw [hz]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (hconst z))
        (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hm))
    have hu : IsUnit (MvPolynomial.constantCoeff z) := IsLocalRing.notMem_maximalIdeal.mp hz0
    have hn : IsNilpotent (φ (z - MvPolynomial.C (MvPolynomial.constantCoeff z))) := by
      apply hnilA
      rw [hp₀']
      exact Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (hconst z))
    have := IsNilpotent.isUnit_add_left_of_commute hn
      ((hu.map MvPolynomial.C).map φ) (Commute.all _ _)
    have e : φ (MvPolynomial.C (MvPolynomial.constantCoeff z)) +
        φ (z - MvPolynomial.C (MvPolynomial.constantCoeff z)) = φ z := by
      rw [← map_add]; congr 1; ring
    rwa [e] at this

  have h1 : (1 : wcEbntN W b ⧸ J) ∉ p₀.map (Ideal.Quotient.mk J) := by
    intro h
    obtain ⟨n, hn⟩ := hnilA 1 h
    rw [one_pow] at hn
    have : (1 : wcEbntN W b) ∈ J := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_one]; exact hn
    exact (hH'.2.1 1).mp (by rw [map_one]; exact isUnit_one) (hJp this)
  obtain ⟨hA'h, hA'u⟩ := hnil (wcEbntN W b ⧸ J) (p₀.map (Ideal.Quotient.mk J)) hnilA hunitA h1

  have hsurj := hsurjgen _ _ _ _ hQ hA'h hA'u
  obtain ⟨a', ha'⟩ := hsurj (Ideal.Quotient.mk (J.map f) F)
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a'
  refine ⟨p, ?_⟩
  rw [Ideal.quotientMap_mk] at ha'
  have hmem : F - f p ∈ J.map f := Ideal.Quotient.eq.mp ha'.symm
  have hσπ : f (Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
      (MvPolynomial.C π)) = σ π := by
    rw [← hσ]; rfl
  rw [hJ, Ideal.map_span, Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton,
    map_pow, map_pow, hσπ] at hmem
  exact hmem

theorem wcpa_dj_lr1k_ebnt_dms_reduced_form : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (b : ↥W) (p : wcEbntN W b), ∃ (d : ℕ) (a a' : ℕ → ↥W), (∀ i, d < i → a i = 0 ∧ a' i = 0) ∧ p = Ideal.Quotient.mk _ (∑ i ∈ Finset.range (d + 1), MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i + ∑ j ∈ Finset.range (d + 1), MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1)) :=
by
  intro Ω _ W b p
  classical
  have hxy : (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b} :
        Ideal (MvPolynomial (Fin 2) ↥W)) (MvPolynomial.X 0)) *
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b} :
        Ideal (MvPolynomial (Fin 2) ↥W)) (MvPolynomial.X 1) =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b} :
        Ideal (MvPolynomial (Fin 2) ↥W)) (MvPolynomial.C b) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  have hpad : ∀ (d₁ d : ℕ) (a a' : ℕ → ↥W), d₁ ≤ d → (∀ i, d₁ < i → a i = 0 ∧ a' i = 0) →
      (∑ i ∈ Finset.range (d₁ + 1), MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i +
        ∑ j ∈ Finset.range (d₁ + 1), MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1) :
          MvPolynomial (Fin 2) ↥W) =
      ∑ i ∈ Finset.range (d + 1), MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i +
        ∑ j ∈ Finset.range (d + 1), MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1) := by
    intro d₁ d a a' hd hv
    have hsub : Finset.range (d₁ + 1) ⊆ Finset.range (d + 1) :=
      Finset.range_subset_range.mpr (by omega)
    congr 1
    · apply Finset.sum_subset hsub
      intro i hi hni
      rw [Finset.mem_range] at hi hni
      rw [(hv i (by omega)).1, map_zero, zero_mul]
    · apply Finset.sum_subset hsub
      intro i hi hni
      rw [Finset.mem_range] at hi hni
      rw [(hv i (by omega)).2, map_zero, zero_mul]
  have key : ∀ q : MvPolynomial (Fin 2) ↥W, ∃ (d : ℕ) (a a' : ℕ → ↥W),
      (∀ i, d < i → a i = 0 ∧ a' i = 0) ∧
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b} :
        Ideal (MvPolynomial (Fin 2) ↥W)) q =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b} :
        Ideal (MvPolynomial (Fin 2) ↥W))
        (∑ i ∈ Finset.range (d + 1), MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i +
          ∑ j ∈ Finset.range (d + 1), MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1)) := by
    intro q
    induction q using MvPolynomial.induction_on' with
    | monomial u w =>
      have hm : (MvPolynomial.monomial u w : MvPolynomial (Fin 2) ↥W) =
          MvPolynomial.C w * MvPolynomial.X 0 ^ (u 0) * MvPolynomial.X 1 ^ (u 1) := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun i => pow_zero _),
          Fin.prod_univ_two, mul_assoc]
      rcases le_or_gt (u 1) (u 0) with h | h
      · obtain ⟨t, ht⟩ := Nat.exists_eq_add_of_le h
        refine ⟨t, fun i => if i = t then w * b ^ (u 1) else 0, fun _ => 0, ?_, ?_⟩
        · intro i hi
          exact ⟨if_neg (by omega), rfl⟩
        · rw [hm, ht]
          simp only [map_zero, zero_mul, Finset.sum_const_zero, add_zero]
          rw [Finset.sum_eq_single_of_mem t (Finset.mem_range.mpr (by omega))
            (fun i _ hi => by rw [if_neg hi, map_zero, zero_mul])]
          simp only [↓reduceIte, map_mul, map_pow]
          rw [← hxy]
          ring
      · obtain ⟨t, ht⟩ := Nat.exists_eq_add_of_lt h
        refine ⟨t, fun _ => 0, fun j => if j = t then w * b ^ (u 0) else 0, ?_, ?_⟩
        · intro i hi
          exact ⟨rfl, if_neg (by omega)⟩
        · rw [hm, ht]
          simp only [map_zero, zero_mul, Finset.sum_const_zero, zero_add]
          rw [Finset.sum_eq_single_of_mem t (Finset.mem_range.mpr (by omega))
            (fun i _ hi => by rw [if_neg hi, map_zero, zero_mul])]
          simp only [↓reduceIte, map_mul, map_pow]
          rw [← hxy]
          ring
    | add q₁ q₂ h₁ h₂ =>
      obtain ⟨d₁, a, a', hv₁, e₁⟩ := h₁
      obtain ⟨d₂, c, c', hv₂, e₂⟩ := h₂
      refine ⟨max d₁ d₂, fun i => a i + c i, fun i => a' i + c' i, ?_, ?_⟩
      · intro i hi
        have h1 := hv₁ i (lt_of_le_of_lt (le_max_left _ _) hi)
        have h2 := hv₂ i (lt_of_le_of_lt (le_max_right _ _) hi)
        exact ⟨by simp only [h1.1, h2.1, add_zero], by simp only [h1.2, h2.2, add_zero]⟩
      · rw [map_add, e₁, e₂, hpad d₁ (max d₁ d₂) a a' (le_max_left _ _) hv₁,
          hpad d₂ (max d₁ d₂) c c' (le_max_right _ _) hv₂, ← map_add]
        congr 1
        simp only [map_add, add_mul, Finset.sum_add_distrib]
        abel
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective p
  exact key q

theorem wcpa_dj_lr1k_ebnt_dms_rank_one_power : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ s t : ↥W, s ≠ 0 → t ∈ IsLocalRing.maximalIdeal ↥W → t ≠ 0 → ∃ N : ℕ, s ∣ t ^ N :=
by
  intro Ω _ W hdim s t hs ht _
  haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
  haveI : (⊥ : Ideal ↥W).IsPrime := Ideal.isPrime_bot
  have hmax := (Ring.krullDimLE_one_iff_of_isPrime_bot (R := ↥W)).mp inferInstance
  have hrad : t ∈ (Ideal.span {s}).radical := by
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro J ⟨hJ, hJp⟩
    have hJ0 : J ≠ ⊥ := fun h => hs (by
      have : s ∈ J := hJ (Ideal.mem_span_singleton_self s)
      rw [h] at this; exact (Ideal.mem_bot.mp this))
    rw [IsLocalRing.eq_maximalIdeal (hmax J hJ0 hJp)]; exact ht
  obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hrad
  exact ⟨N, Ideal.mem_span_singleton.mp hN⟩

theorem wcpa_dj_lr1k_ebnt_dms_root : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (g : ↥W) (n : ℕ), 0 < n → ∃ r : ↥W, r ^ n = g ∧ (g ∈ IsLocalRing.maximalIdeal ↥W → r ∈ IsLocalRing.maximalIdeal ↥W) ∧ (g ≠ 0 → r ≠ 0) :=
by
  intro Ω _ _ W g n hn
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (g : Ω) hn
  have hzW : z ∈ W := by
    rcases W.mem_or_inv_mem z with h | h
    · exact h
    · by_cases hz0 : z = 0
      · rw [hz0]; exact W.zero_mem
      · obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        have heq : z = (g : Ω) * z⁻¹ ^ m := by
          rw [← hz, pow_succ', mul_assoc, ← mul_pow, mul_inv_cancel₀ hz0, one_pow, mul_one]
        rw [heq]
        exact mul_mem g.2 (pow_mem h m)
  have hr : (⟨z, hzW⟩ : ↥W) ^ n = g := Subtype.ext (by simpa using hz)
  refine ⟨⟨z, hzW⟩, hr, ?_, ?_⟩
  · intro hg
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hg ⊢
    intro hu
    exact hg (by rw [← hr]; exact hu.pow n)
  · intro hg h0
    apply hg
    rw [← hr, h0, zero_pow hn.ne']

theorem wcpa_dj_lr1k_ebnt_dms_window_pure : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (b c ν : ↥W) (d : ℕ) (a a' g g' : ℕ → ↥W), b ≠ 0 → c ≠ 0 → ν ∈ IsLocalRing.maximalIdeal ↥W → ν ≠ 0 → ν ^ 4 ∣ b → (∀ μ₀ μ₁ : ↥W, μ₀ * μ₁ = b → (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₀ = ν * s) → (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₁ = ν * s) → ∃ δ δ' : ↥W, Associated (δ * δ') c ∧ (∀ i ≤ d, δ ∣ a i * μ₀ ^ i ∧ δ ∣ a' i * μ₁ ^ (i + 1)) ∧ (∃ i ≤ d, a i * μ₀ ^ i ∣ δ ∨ a' i * μ₁ ^ (i + 1) ∣ δ) ∧ (∀ i ≤ d, δ' ∣ g i * μ₀ ^ i ∧ δ' ∣ g' i * μ₁ ^ (i + 1)) ∧ (∃ i ≤ d, g i * μ₀ ^ i ∣ δ' ∨ g' i * μ₁ ^ (i + 1) ∣ δ')) → ∃ (A : ↥W) (e : ℤ), A ≠ 0 ∧ ∀ μ₀ μ₁ : ↥W, μ₀ * μ₁ = b → (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₀ = ν * s) → (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₁ = ν * s) → (∀ j ≤ d, A * (if 0 ≤ e then μ₀ ^ e.toNat else μ₁ ^ (-e).toNat) ∣ a j * μ₀ ^ j ∧ A * (if 0 ≤ e then μ₀ ^ e.toNat else μ₁ ^ (-e).toNat) ∣ a' j * μ₁ ^ (j + 1)) ∧ ∃ j ≤ d, a j * μ₀ ^ j ∣ A * (if 0 ≤ e then μ₀ ^ e.toNat else μ₁ ^ (-e).toNat) ∨ a' j * μ₁ ^ (j + 1) ∣ A * (if 0 ≤ e then μ₀ ^ e.toNat else μ₁ ^ (-e).toNat) :=
by
  intro Ω _ _ W b c ν d a a' g g' hb0 hc hνm hν0 hν4 hH
  classical

  obtain ⟨T, hT⟩ : ∃ T : (ℕ → ↥W) → (ℕ → ↥W) → ℕ → ↥W → ↥W → ↥W, ∀ p p' w x y,
      T p p' w x y = if d + 1 ≤ w then p (w - (d + 1)) * x ^ (w - (d + 1))
        else p' (d - w) * y ^ (d - w + 1) := ⟨_, fun _ _ _ _ _ => rfl⟩

  have hSH : ∀ (p p' : ℕ → ↥W) (w : ℕ) (x y r : ↥W),
      r ^ (d + 1) * T p p' w (x * r) y = T p p' w x (y * r) * r ^ w := by
    intro p p' w x y r
    rw [hT, hT]
    split_ifs with h
    · have e : r ^ w = r ^ (w - (d + 1)) * r ^ (d + 1) := by
        rw [← pow_add]; congr 1; omega
      rw [e, mul_pow]; ring
    · have e : r ^ (d + 1) = r ^ (d - w + 1) * r ^ w := by
        rw [← pow_add]; congr 1; omega
      rw [e, mul_pow]; ring

  have hbr1 : ∀ (p p' : ℕ → ↥W) (x y δ : ↥W),
      (∀ i ≤ d, δ ∣ p i * x ^ i ∧ δ ∣ p' i * y ^ (i + 1)) →
      ∀ w ≤ 2 * d + 1, δ ∣ T p p' w x y := by
    intro p p' x y δ h w hw
    rw [hT]
    split_ifs with hw'
    · exact (h (w - (d + 1)) (by omega)).1
    · exact (h (d - w) (by omega)).2
  have hbr2 : ∀ (p p' : ℕ → ↥W) (x y δ : ↥W),
      (∃ i ≤ d, p i * x ^ i ∣ δ ∨ p' i * y ^ (i + 1) ∣ δ) →
      ∃ w ≤ 2 * d + 1, T p p' w x y ∣ δ := by
    intro p p' x y δ ⟨i, hi, h⟩
    rcases h with h | h
    · refine ⟨i + (d + 1), by omega, ?_⟩
      rw [hT, if_pos (show d + 1 ≤ i + (d + 1) by omega), Nat.add_sub_cancel]
      exact h
    · refine ⟨d - i, by omega, ?_⟩
      rw [hT, if_neg (show ¬ (d + 1 ≤ d - i) by omega), show d - (d - i) = i by omega]
      exact h
  have hH' : ∀ μ₀ μ₁ : ↥W, μ₀ * μ₁ = b → (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₀ = ν * s) →
      (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₁ = ν * s) → ∃ δ δ' : ↥W, Associated (δ * δ') c ∧
      (∀ w ≤ 2 * d + 1, δ ∣ T a a' w μ₀ μ₁) ∧ (∃ w ≤ 2 * d + 1, T a a' w μ₀ μ₁ ∣ δ) ∧
      (∀ w ≤ 2 * d + 1, δ' ∣ T g g' w μ₀ μ₁) ∧ (∃ w ≤ 2 * d + 1, T g g' w μ₀ μ₁ ∣ δ') := by
    intro μ₀ μ₁ hμ h0 h1
    obtain ⟨δ, δ', hass, h1a, h2a, h1g, h2g⟩ := hH μ₀ μ₁ hμ h0 h1
    exact ⟨δ, δ', hass, hbr1 a a' μ₀ μ₁ δ h1a, hbr2 a a' μ₀ μ₁ δ h2a, hbr1 g g' μ₀ μ₁ δ' h1g,
      hbr2 g g' μ₀ μ₁ δ' h2g⟩

  have hcan : ∀ (X Y r : ↥W) (p q : ℕ), r ∈ IsLocalRing.maximalIdeal ↥W → r ≠ 0 →
      Associated X c → Associated Y c → X * r ^ p ∣ Y * r ^ q → p ≤ q := by
    intro X Y r p q hrm hr0 hX hY h
    have h1 : c * r ^ p ∣ c * r ^ q :=
      (mul_dvd_mul_right hX.symm.dvd _).trans (h.trans (mul_dvd_mul_right hY.dvd _))
    have h2 : r ^ p ∣ r ^ q := (mul_dvd_mul_iff_left hc).mp h1
    exact (pow_dvd_pow_iff hr0 (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal r).mp hrm))).mp h2
  have hsqrt : ∀ s : ↥W, s ∈ IsLocalRing.maximalIdeal ↥W → s ≠ 0 →
      ∃ r : ↥W, r ^ 2 = s ∧ r ∈ IsLocalRing.maximalIdeal ↥W ∧ r ≠ 0 := by
    intro s hsm hs0
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq (s : Ω) (by norm_num : 0 < 2)
    have hxW : x ∈ W := by
      by_cases hx0 : x = 0
      · rw [hx0]; exact W.zero_mem
      · rcases W.mem_or_inv_mem x with h | h
        · exact h
        · have e : x = (s : Ω) * x⁻¹ := by
            rw [← hx]; field_simp
          rw [e]; exact W.mul_mem _ _ s.2 h
    have hsq : (⟨x, hxW⟩ : ↥W) ^ 2 = s := Subtype.ext (by simpa using hx)
    refine ⟨⟨x, hxW⟩, hsq, ?_, ?_⟩
    · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hsm ⊢
      intro hu
      apply hsm
      rw [← hsq]; exact hu.pow 2
    · intro h
      apply hs0
      rw [← hsq, h]; ring
  have hne : ∀ δ δ' : ↥W, Associated (δ * δ') c → δ ≠ 0 ∧ δ' ≠ 0 := by
    intro δ δ' hass
    refine ⟨fun h => hc ?_, fun h => hc ?_⟩
    · rw [h, zero_mul] at hass; exact hass.eq_zero_iff.mp rfl
    · rw [h, mul_zero] at hass; exact hass.eq_zero_iff.mp rfl

  have hpt : ∀ μ₀ μ₁ : ↥W, μ₀ * μ₁ = b → (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₀ = ν * s) →
      (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₁ = ν * s) → ∀ δ δ' : ↥W, Associated (δ * δ') c →
      (∀ w ≤ 2 * d + 1, δ ∣ T a a' w μ₀ μ₁) → (∀ w ≤ 2 * d + 1, δ' ∣ T g g' w μ₀ μ₁) →
      ∀ wa ≤ 2 * d + 1, ∀ wg ≤ 2 * d + 1, T a a' wa μ₀ μ₁ ∣ δ → T g g' wg μ₀ μ₁ ∣ δ' →
      wa + wg = 2 * (d + 1) := by
    intro μ₀ μ₁ hμ ⟨s₀, hs₀m, hs₀⟩ ⟨s₁, hs₁m, hs₁⟩ δ δ' hass hδ hδ' wa hwa wg hwg hTa hTg
    have hμ₀0 : μ₀ ≠ 0 := fun h => hb0 (by rw [← hμ, h, zero_mul])
    have hμ₁0 : μ₁ ≠ 0 := fun h => hb0 (by rw [← hμ, h, mul_zero])
    have hs₀0 : s₀ ≠ 0 := fun h => hμ₀0 (by rw [hs₀, h, mul_zero])
    have hs₁0 : s₁ ≠ 0 := fun h => hμ₁0 (by rw [hs₁, h, mul_zero])
    apply le_antisymm
    ·
      obtain ⟨r, hr2, hrm, hr0⟩ := hsqrt s₀ hs₀m hs₀0
      have hμ₀' : μ₀ = ν * r * r := by rw [hs₀, ← hr2]; ring
      obtain ⟨δ₂, δ₂', hass₂, hδ₂, -, hδ₂', -⟩ := hH' (ν * r) (μ₁ * r)
        (by rw [← hμ, hμ₀']; ring) ⟨r, hrm, rfl⟩
        ⟨s₁ * r, Ideal.mul_mem_right _ _ hs₁m, by rw [hs₁]; ring⟩
      rw [hμ₀'] at hTa hTg
      have ha : δ₂ * r ^ wa ∣ r ^ (d + 1) * δ :=
        calc δ₂ * r ^ wa ∣ T a a' wa (ν * r) (μ₁ * r) * r ^ wa :=
              mul_dvd_mul_right (hδ₂ wa hwa) _
          _ = r ^ (d + 1) * T a a' wa (ν * r * r) μ₁ := (hSH a a' wa _ _ r).symm
          _ ∣ r ^ (d + 1) * δ := mul_dvd_mul_left _ hTa
      have hg : δ₂' * r ^ wg ∣ r ^ (d + 1) * δ' :=
        calc δ₂' * r ^ wg ∣ T g g' wg (ν * r) (μ₁ * r) * r ^ wg :=
              mul_dvd_mul_right (hδ₂' wg hwg) _
          _ = r ^ (d + 1) * T g g' wg (ν * r * r) μ₁ := (hSH g g' wg _ _ r).symm
          _ ∣ r ^ (d + 1) * δ' := mul_dvd_mul_left _ hTg
      apply hcan (δ₂ * δ₂') (δ * δ') r (wa + wg) (2 * (d + 1)) hrm hr0 hass₂ hass
      have e1 : δ₂ * δ₂' * r ^ (wa + wg) = (δ₂ * r ^ wa) * (δ₂' * r ^ wg) := by ring
      have e2 : δ * δ' * r ^ (2 * (d + 1)) = (r ^ (d + 1) * δ) * (r ^ (d + 1) * δ') := by ring
      rw [e1, e2]
      exact mul_dvd_mul ha hg
    ·
      obtain ⟨r, hr2, hrm, hr0⟩ := hsqrt s₁ hs₁m hs₁0
      have hμ₁' : μ₁ = ν * r * r := by rw [hs₁, ← hr2]; ring
      obtain ⟨δ₁, δ₁', hass₁, hδ₁, -, hδ₁', -⟩ := hH' (μ₀ * r) (ν * r)
        (by rw [← hμ, hμ₁']; ring)
        ⟨s₀ * r, Ideal.mul_mem_right _ _ hs₀m, by rw [hs₀]; ring⟩ ⟨r, hrm, rfl⟩
      rw [hμ₁'] at hTa hTg
      have ha : r ^ (d + 1) * δ₁ ∣ δ * r ^ wa :=
        calc r ^ (d + 1) * δ₁ ∣ r ^ (d + 1) * T a a' wa (μ₀ * r) (ν * r) :=
              mul_dvd_mul_left _ (hδ₁ wa hwa)
          _ = T a a' wa μ₀ (ν * r * r) * r ^ wa := hSH a a' wa _ _ r
          _ ∣ δ * r ^ wa := mul_dvd_mul_right hTa _
      have hg : r ^ (d + 1) * δ₁' ∣ δ' * r ^ wg :=
        calc r ^ (d + 1) * δ₁' ∣ r ^ (d + 1) * T g g' wg (μ₀ * r) (ν * r) :=
              mul_dvd_mul_left _ (hδ₁' wg hwg)
          _ = T g g' wg μ₀ (ν * r * r) * r ^ wg := hSH g g' wg _ _ r
          _ ∣ δ' * r ^ wg := mul_dvd_mul_right hTg _
      apply hcan (δ₁ * δ₁') (δ * δ') r (2 * (d + 1)) (wa + wg) hrm hr0 hass₁ hass
      have e1 : δ₁ * δ₁' * r ^ (2 * (d + 1)) = (r ^ (d + 1) * δ₁) * (r ^ (d + 1) * δ₁') := by ring
      have e2 : δ * δ' * r ^ (wa + wg) = (δ * r ^ wa) * (δ' * r ^ wg) := by ring
      rw [e1, e2]
      exact mul_dvd_mul ha hg

  have hmono : ∀ (p p' : ℕ → ↥W) (x y x' y' r δ ε : ↥W) (w w' : ℕ), x' = x * r → y = y' * r →
      r ≠ 0 → δ ≠ 0 → (∀ v ≤ 2 * d + 1, δ ∣ T p p' v x y) → T p p' w x y ∣ δ →
      (∀ v ≤ 2 * d + 1, T p p' v x y ∣ δ → v = w) →
      ε ∣ T p p' w x' y' → T p p' w' x' y' ∣ ε → w' ≤ 2 * d + 1 → w' ≤ w := by
    intro p p' x y x' y' r δ ε w w' hx hy hr0 hδ0 hδ hw huniq hε hw' hw'n
    subst hx hy
    by_contra hlt
    push_neg at hlt
    have hstar : T p p' w' x (y' * r) * r ^ w' ∣ δ * r ^ w :=
      calc T p p' w' x (y' * r) * r ^ w' = r ^ (d + 1) * T p p' w' (x * r) y' :=
            (hSH p p' w' x y' r).symm
        _ ∣ r ^ (d + 1) * T p p' w (x * r) y' := mul_dvd_mul_left _ (hw'.trans hε)
        _ = T p p' w x (y' * r) * r ^ w := hSH p p' w x y' r
        _ ∣ δ * r ^ w := mul_dvd_mul_right hw _
    have h1 : δ * r ^ w * r ^ (w' - w) ∣ δ * r ^ w * 1 := by
      rw [mul_one, mul_assoc, ← pow_add, show w + (w' - w) = w' by omega]
      exact (mul_dvd_mul_right (hδ w' hw'n) _).trans hstar
    have h2 : r ^ (w' - w) ∣ 1 :=
      (mul_dvd_mul_iff_left (mul_ne_zero hδ0 (pow_ne_zero _ hr0))).mp h1
    have hru : IsUnit r := (isUnit_pow_iff (by omega)).mp (isUnit_of_dvd_one h2)
    have h3 : T p p' w' x (y' * r) ∣ δ :=
      ((hru.pow w).dvd_mul_right).mp ((dvd_mul_right _ _).trans hstar)
    have := huniq w' hw'n h3
    omega

  obtain ⟨z, hz⟩ := hν4
  have hP0 : ν * ν * (ν * (ν * z)) = b := by rw [hz]; ring
  have hP0a : ∃ s ∈ IsLocalRing.maximalIdeal ↥W, ν * ν = ν * s := ⟨ν, hνm, rfl⟩
  have hP0b : ∃ s ∈ IsLocalRing.maximalIdeal ↥W, ν * (ν * z) = ν * s :=
    ⟨ν * z, Ideal.mul_mem_right _ _ hνm, rfl⟩
  obtain ⟨δ₀, δ₀', hass₀, hδ₀, ⟨w₀, hw₀n, hw₀⟩, hδ₀', ⟨u₀, hu₀n, hu₀⟩⟩ := hH' _ _ hP0 hP0a hP0b
  have hsum₀ := hpt _ _ hP0 hP0a hP0b δ₀ δ₀' hass₀ hδ₀ hδ₀' w₀ hw₀n u₀ hu₀n hw₀ hu₀
  obtain ⟨hδ₀0, hδ₀'0⟩ := hne δ₀ δ₀' hass₀
  have hun₀a : ∀ v ≤ 2 * d + 1, T a a' v (ν * ν) (ν * (ν * z)) ∣ δ₀ → v = w₀ := by
    intro v hv hTv
    have := hpt _ _ hP0 hP0a hP0b δ₀ δ₀' hass₀ hδ₀ hδ₀' v hv u₀ hu₀n hTv hu₀
    omega
  have hun₀g : ∀ v ≤ 2 * d + 1, T g g' v (ν * ν) (ν * (ν * z)) ∣ δ₀' → v = u₀ := by
    intro v hv hTv
    have := hpt _ _ hP0 hP0a hP0b δ₀ δ₀' hass₀ hδ₀ hδ₀' w₀ hw₀n v hv hw₀ hTv
    omega

  have hkey : ∀ μ₀ μ₁ : ↥W, μ₀ * μ₁ = b → (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₀ = ν * s) →
      (∃ s ∈ IsLocalRing.maximalIdeal ↥W, μ₁ = ν * s) → ∀ δ δ' : ↥W, Associated (δ * δ') c →
      (∀ w ≤ 2 * d + 1, δ ∣ T a a' w μ₀ μ₁) → (∀ w ≤ 2 * d + 1, δ' ∣ T g g' w μ₀ μ₁) →
      ∀ w ≤ 2 * d + 1, T a a' w μ₀ μ₁ ∣ δ → ∀ u ≤ 2 * d + 1, T g g' u μ₀ μ₁ ∣ δ' → w = w₀ := by
    intro μ₀ μ₁ hμ h0 h1 δ δ' hass hδ hδ' w hwn hw u hun hu
    have hsum := hpt μ₀ μ₁ hμ h0 h1 δ δ' hass hδ hδ' w hwn u hun hw hu
    obtain ⟨hδ0, hδ'0⟩ := hne δ δ' hass
    have huna : ∀ v ≤ 2 * d + 1, T a a' v μ₀ μ₁ ∣ δ → v = w := by
      intro v hv hTv
      have := hpt μ₀ μ₁ hμ h0 h1 δ δ' hass hδ hδ' v hv u hun hTv hu
      omega
    have hung : ∀ v ≤ 2 * d + 1, T g g' v μ₀ μ₁ ∣ δ' → v = u := by
      intro v hv hTv
      have := hpt μ₀ μ₁ hμ h0 h1 δ δ' hass hδ hδ' w hwn v hv hw hTv
      omega
    have hμ₀0 : μ₀ ≠ 0 := fun h => hb0 (by rw [← hμ, h, zero_mul])
    rcases ValuationRing.dvd_total (ν * ν) μ₀ with ⟨r, hr⟩ | ⟨r, hr⟩
    · have hr0 : r ≠ 0 := fun h => hμ₀0 (by rw [hr, h, mul_zero])
      have hy : ν * (ν * z) = μ₁ * r :=
        mul_left_cancel₀ (mul_ne_zero hν0 hν0) (by rw [hP0, ← hμ, hr]; ring)
      have h1' := hmono a a' (ν * ν) (ν * (ν * z)) μ₀ μ₁ r δ₀ δ w₀ w hr hy hr0 hδ₀0 hδ₀ hw₀
        hun₀a (hδ w₀ hw₀n) hw hwn
      have h2' := hmono g g' (ν * ν) (ν * (ν * z)) μ₀ μ₁ r δ₀' δ' u₀ u hr hy hr0 hδ₀'0 hδ₀' hu₀
        hun₀g (hδ' u₀ hu₀n) hu hun
      omega
    · have hr0 : r ≠ 0 := fun h => mul_ne_zero hν0 hν0 (by rw [hr, h, mul_zero])
      have hy : μ₁ = ν * (ν * z) * r :=
        mul_left_cancel₀ hμ₀0 (by rw [hμ, ← hP0, hr]; ring)
      have h1' := hmono a a' μ₀ μ₁ (ν * ν) (ν * (ν * z)) r δ δ₀ w w₀ hr hy hr0 hδ0 hδ hw
        huna (hδ₀ w hwn) hw₀ hw₀n
      have h2' := hmono g g' μ₀ μ₁ (ν * ν) (ν * (ν * z)) r δ' δ₀' u u₀ hr hy hr0 hδ'0 hδ' hu
        hung (hδ₀' u hun) hu₀ hu₀n
      omega

  have hAT : ∀ x y : ↥W,
      (if d + 1 ≤ w₀ then a (w₀ - (d + 1)) else a' (d - w₀)) *
        (if 0 ≤ (w₀ : ℤ) - ((d : ℤ) + 1) then x ^ ((w₀ : ℤ) - ((d : ℤ) + 1)).toNat
          else y ^ (-((w₀ : ℤ) - ((d : ℤ) + 1))).toNat) = T a a' w₀ x y := by
    intro x y
    rw [hT]
    by_cases h : d + 1 ≤ w₀
    · have he : (0 : ℤ) ≤ (w₀ : ℤ) - ((d : ℤ) + 1) := by omega
      have hn : ((w₀ : ℤ) - ((d : ℤ) + 1)).toNat = w₀ - (d + 1) := by omega
      simp only [if_pos h, if_pos he, hn]
    · have he : ¬ (0 : ℤ) ≤ (w₀ : ℤ) - ((d : ℤ) + 1) := by omega
      have hn : (-((w₀ : ℤ) - ((d : ℤ) + 1))).toNat = d - w₀ + 1 := by omega
      simp only [if_neg h, if_neg he, hn]
  refine ⟨if d + 1 ≤ w₀ then a (w₀ - (d + 1)) else a' (d - w₀), (w₀ : ℤ) - ((d : ℤ) + 1), ?_, ?_⟩
  · intro hA0
    have h := hAT (ν * ν) (ν * (ν * z))
    rw [hA0, zero_mul] at h
    rw [← h] at hw₀
    exact hδ₀0 (zero_dvd_iff.mp hw₀)
  · intro μ₀ μ₁ hμ h0 h1
    obtain ⟨δ, δ', hass, h1a, h2a, h1g, h2g⟩ := hH μ₀ μ₁ hμ h0 h1
    obtain ⟨w, hwn, hw⟩ := hbr2 a a' μ₀ μ₁ δ h2a
    obtain ⟨u, hun, hu⟩ := hbr2 g g' μ₀ μ₁ δ' h2g
    have hww := hkey μ₀ μ₁ hμ h0 h1 δ δ' hass (hbr1 a a' μ₀ μ₁ δ h1a) (hbr1 g g' μ₀ μ₁ δ' h1g)
      w hwn hw u hun hu
    rw [hww] at hw
    rw [hAT μ₀ μ₁]
    refine ⟨fun j hj => ⟨hw.trans (h1a j hj).1, hw.trans (h1a j hj).2⟩, ?_⟩
    by_cases h : d + 1 ≤ w₀
    · refine ⟨w₀ - (d + 1), by omega, Or.inl (dvd_of_eq ?_)⟩
      rw [hT, if_pos h]
    · refine ⟨d - w₀, by omega, Or.inr (dvd_of_eq ?_)⟩
      rw [hT, if_neg h]

theorem wcpa_dj_lr1k_ebnt_dms_rigidity : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ω A A' : ↥W) (e e' : ℤ), ω ∈ IsLocalRing.maximalIdeal ↥W → ω ≠ 0 → A ≠ 0 → Associated (A * (if 0 ≤ e then (ω ^ 2) ^ e.toNat else (ω ^ 4) ^ (-e).toNat)) (A' * (if 0 ≤ e' then (ω ^ 2) ^ e'.toNat else (ω ^ 4) ^ (-e').toNat)) → Associated (A * (if 0 ≤ e then (ω ^ 3) ^ e.toNat else (ω ^ 3) ^ (-e).toNat)) (A' * (if 0 ≤ e' then (ω ^ 3) ^ e'.toNat else (ω ^ 3) ^ (-e').toNat)) → e = e' ∧ Associated A A' :=
by
  intro Ω _ W ω A A' e e' hωm hω0 hA0 H1 H2
  have hωu : ¬ IsUnit ω := (IsLocalRing.mem_maximalIdeal ω).mp hωm
  have key : ∀ (p q p' q' : ℕ), Associated (A * ω ^ p) (A' * ω ^ p') →
      Associated (A * ω ^ q) (A' * ω ^ q') → p + q' = p' + q ∧ (q = q' → Associated A A') := by
    intro p q p' q' h1 h2
    have hA'0 : A' ≠ 0 := by
      intro h
      have h0 := h1.ne_zero_iff.mp (mul_ne_zero hA0 (pow_ne_zero p hω0))
      rw [h, zero_mul] at h0
      exact h0 rfl
    have h3 := h1.mul_mul h2.symm
    have e1 : A * ω ^ p * (A' * ω ^ q') = (A * A') * ω ^ (p + q') := by ring
    have e2 : A' * ω ^ p' * (A * ω ^ q) = (A * A') * ω ^ (p' + q) := by ring
    rw [e1, e2] at h3
    have hpow := h3.of_mul_left (Associated.refl _) (mul_ne_zero hA0 hA'0)
    have l1 := (pow_dvd_pow_iff hω0 hωu).mp hpow.dvd
    have l2 := (pow_dvd_pow_iff hω0 hωu).mp hpow.symm.dvd
    refine ⟨le_antisymm l1 l2, fun hq => ?_⟩
    subst hq
    exact h2.of_mul_right (Associated.refl _) (pow_ne_zero q hω0)
  by_cases he : 0 ≤ e <;> by_cases he' : 0 ≤ e'
  · rw [if_pos he, if_pos he'] at H1 H2
    simp only [← pow_mul] at H1 H2
    obtain ⟨h1, h2⟩ := key _ _ _ _ H1 H2
    have heq : e = e' := by omega
    exact ⟨heq, h2 (by omega)⟩
  · rw [if_pos he, if_neg he'] at H1 H2
    simp only [← pow_mul] at H1 H2
    obtain ⟨h1, h2⟩ := key _ _ _ _ H1 H2
    have heq : e = e' := by omega
    exact ⟨heq, h2 (by omega)⟩
  · rw [if_neg he, if_pos he'] at H1 H2
    simp only [← pow_mul] at H1 H2
    obtain ⟨h1, h2⟩ := key _ _ _ _ H1 H2
    have heq : e = e' := by omega
    exact ⟨heq, h2 (by omega)⟩
  · rw [if_neg he, if_neg he'] at H1 H2
    simp only [← pow_mul] at H1 H2
    obtain ⟨h1, h2⟩ := key _ _ _ _ H1 H2
    have heq : e = e' := by omega
    exact ⟨heq, h2 (by omega)⟩

theorem wcpa_dj_lr1k_ebnt_dms_interior_bound : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (l l' α π : ↥W) (e : ℤ) (N d : ℕ) (a a' : ℕ → ↥W) (F : Q), l * l' = b → l ∣ l' → l ≠ 0 → e.natAbs ≤ N → α ∣ l ^ (N - e.natAbs) → α * l' ^ e.natAbs ∣ l ^ N → α * b ^ e.natAbs ∣ π → (∀ j ≤ d, α * (if 0 ≤ e then l ^ e.toNat else l' ^ (-e).toNat) ∣ a j * l ^ j ∧ α * (if 0 ≤ e then l ^ e.toNat else l' ^ (-e).toNat) ∣ a' j * l' ^ (j + 1)) → (∀ j ≤ d, α * (if 0 ≤ e then l' ^ e.toNat else l ^ (-e).toNat) ∣ a j * l' ^ j ∧ α * (if 0 ≤ e then l' ^ e.toNat else l ^ (-e).toNat) ∣ a' j * l ^ (j + 1)) → F - f (Ideal.Quotient.mk _ (∑ i ∈ Finset.range (d + 1), MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i + ∑ j ∈ Finset.range (d + 1), MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1))) ∈ Ideal.span {f (wcEbntX W b 0) ^ N, f (wcEbntX W b 1) ^ N, σ π} → ∀ (K : Type u) [Field K] (V : ValuationSubring K) (k : Q →+* V), k (σ l) ∣ k (f (wcEbntX W b 0)) → k (σ l) ∣ k (f (wcEbntX W b 1)) → k (σ (α * b ^ e.natAbs)) ∣ k (F * f (wcEbntX W b (1 - (if 0 ≤ e then 0 else 1 : Fin 2))) ^ e.natAbs) :=
by
  intro Ω _ W Q _ σ b f hf l l' α π e N d a a' F hll' hll hl0 hnN hAl hAl' hAπ hPL hPR hFp
    K _ V k hlx hly
  have hrel : f (wcEbntX W b 0) * f (wcEbntX W b 1) = σ b := by
    have h1 : (wcEbntX W b 0) * (wcEbntX W b 1) =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b})
          (MvPolynomial.C b) := by
      show Ideal.Quotient.mk _ (MvPolynomial.X 0) * Ideal.Quotient.mk _ (MvPolynomial.X 1) = _
      rw [← map_mul, Ideal.Quotient.eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    rw [← map_mul, h1, ← hf.2.2.1]
    rfl
  have hfC : ∀ w : ↥W, f (Ideal.Quotient.mk _ (MvPolynomial.C w)) = σ w := by
    intro w
    rw [← hf.2.2.1]
    rfl
  have hb0 : b ≠ 0 := hf.2.1
  have hl'0 : l' ≠ 0 := fun h => hb0 (by rw [← hll', h, mul_zero])
  have hXY : k (f (wcEbntX W b 0)) * k (f (wcEbntX W b 1)) = k (σ l) * k (σ l') := by
    rw [← map_mul, hrel, ← hll', map_mul, map_mul]

  have happrox : ∀ D : ↥V, D ∣ k (f (wcEbntX W b 0)) ^ N → D ∣ k (f (wcEbntX W b 1)) ^ N →
      D ∣ k (σ π) →
      (∀ j ≤ d, D ∣ k (σ (a j)) * k (f (wcEbntX W b 0)) ^ j ∧
        D ∣ k (σ (a' j)) * k (f (wcEbntX W b 1)) ^ (j + 1)) → D ∣ k F := by
    intro D h0 h1 hπ hterm
    have hI : Ideal.span {f (wcEbntX W b 0) ^ N, f (wcEbntX W b 1) ^ N, σ π} ≤
        Ideal.comap k (Ideal.span {D}) := by
      rw [Ideal.span_le]
      intro z hz
      rw [SetLike.mem_coe, Ideal.mem_comap, Ideal.mem_span_singleton]
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl | rfl
      · rw [map_pow]; exact h0
      · rw [map_pow]; exact h1
      · exact hπ
    have hmem := hI hFp
    rw [Ideal.mem_comap, Ideal.mem_span_singleton, map_sub] at hmem
    have hD : D ∣ k (f (Ideal.Quotient.mk _ (∑ i ∈ Finset.range (d + 1), MvPolynomial.C (a i) * MvPolynomial.X 0 ^ i + ∑ j ∈ Finset.range (d + 1), MvPolynomial.C (a' j) * MvPolynomial.X 1 ^ (j + 1)))) := by
      simp only [map_add, map_sum, map_mul, map_pow, hfC]
      apply dvd_add
      · apply Finset.dvd_sum
        intro i hi
        rw [Finset.mem_range] at hi
        exact (hterm i (by omega)).1
      · apply Finset.dvd_sum
        intro i hi
        rw [Finset.mem_range] at hi
        exact (hterm i (by omega)).2
    have h2 := dvd_add hmem hD
    rwa [sub_add_cancel] at h2

  have s2 : ∀ (a₀ : ↥W) (Z : ↥V) (j : ℕ), k (σ l) ∣ Z → Z ∣ k (σ l') →
      (e.natAbs ≤ j → α * l ^ e.natAbs ∣ a₀ * l ^ j) →
      (j < e.natAbs → α * l' ^ e.natAbs ∣ a₀ * l' ^ j) →
      k (σ α) * Z ^ e.natAbs ∣ k (σ a₀) * Z ^ j := by
    intro a₀ Z j hlZ hZl' h1 h2
    rcases Nat.lt_or_ge j e.natAbs with hj | hj
    swap
    · have h := h1 hj
      have e1 : a₀ * l ^ j = (a₀ * l ^ (j - e.natAbs)) * l ^ e.natAbs := by
        rw [mul_assoc, ← pow_add, Nat.sub_add_cancel hj]
      rw [e1] at h
      have h' : α ∣ a₀ * l ^ (j - e.natAbs) := (mul_dvd_mul_iff_right (pow_ne_zero _ hl0)).mp h
      have h'' : k (σ α) ∣ k (σ a₀) * Z ^ (j - e.natAbs) := by
        have := map_dvd k (map_dvd σ h')
        simp only [map_mul, map_pow] at this
        exact this.trans (mul_dvd_mul_left _ (pow_dvd_pow_of_dvd hlZ _))
      have e2 : k (σ a₀) * Z ^ j = (k (σ a₀) * Z ^ (j - e.natAbs)) * Z ^ e.natAbs := by
        rw [mul_assoc, ← pow_add, Nat.sub_add_cancel hj]
      rw [e2]
      exact mul_dvd_mul h'' dvd_rfl
    · have h := h2 hj
      have e1 : α * l' ^ e.natAbs = (α * l' ^ (e.natAbs - j)) * l' ^ j := by
        rw [mul_assoc, ← pow_add, Nat.sub_add_cancel hj.le]
      rw [e1] at h
      have h' : α * l' ^ (e.natAbs - j) ∣ a₀ := (mul_dvd_mul_iff_right (pow_ne_zero _ hl'0)).mp h
      have h'' : k (σ α) * Z ^ (e.natAbs - j) ∣ k (σ a₀) := by
        have := map_dvd k (map_dvd σ h')
        simp only [map_mul, map_pow] at this
        exact (mul_dvd_mul_left _ (pow_dvd_pow_of_dvd hZl' _)).trans this
      have e2 : k (σ α) * Z ^ e.natAbs = (k (σ α) * Z ^ (e.natAbs - j)) * Z ^ j := by
        rw [mul_assoc, ← pow_add, Nat.sub_add_cancel hj.le]
      rw [e2]
      exact mul_dvd_mul h'' dvd_rfl

  have s3 : ∀ (a₀ : ↥W) (Z Z' : ↥V) (m : ℕ), k (σ l) ∣ Z' → Z ∣ k (σ l') →
      α * l' ^ e.natAbs ∣ a₀ * l ^ m → k (σ α) * Z ^ e.natAbs ∣ k (σ a₀) * Z' ^ m := by
    intro a₀ Z Z' m hlZ' hZl' h
    have := map_dvd k (map_dvd σ h)
    simp only [map_mul, map_pow] at this
    exact (mul_dvd_mul_left _ (pow_dvd_pow_of_dvd hZl' _)).trans
      (this.trans (mul_dvd_mul_left _ (pow_dvd_pow_of_dvd hlZ' _)))

  have hll'k : k (σ l) ∣ k (σ l') := map_dvd k (map_dvd σ hll)
  have hdual : k (f (wcEbntX W b 0)) ∣ k (σ l') ∧ k (f (wcEbntX W b 1)) ∣ k (σ l') := by
    by_cases hL : k (σ l) = 0
    · have h0 : k (σ l') = 0 := by
        rw [hL] at hll'k
        exact zero_dvd_iff.mp hll'k
      rw [h0]
      exact ⟨dvd_zero _, dvd_zero _⟩
    · obtain ⟨t, ht⟩ := id hly
      obtain ⟨u, hu⟩ := id hlx
      constructor
      · refine ⟨t, ?_⟩
        apply mul_left_cancel₀ hL
        rw [← hXY, ht]
        ring
      · refine ⟨u, ?_⟩
        apply mul_left_cancel₀ hL
        rw [← hXY, hu]
        ring

  have hkey : k (σ (α * b ^ e.natAbs)) = k (σ α) *
      (k (f (wcEbntX W b 0)) ^ e.natAbs * k (f (wcEbntX W b 1)) ^ e.natAbs) := by
    rw [map_mul σ, map_pow σ, ← hrel]
    simp only [map_mul, map_pow]
    ring
  have hπk : k (σ (α * b ^ e.natAbs)) ∣ k (σ π) := map_dvd k (map_dvd σ hAπ)
  rw [hkey] at hπk
  have hlN : α * l ^ e.natAbs ∣ 1 * l ^ N := by
    rw [one_mul, ← Nat.sub_add_cancel hnN, pow_add]
    exact mul_dvd_mul hAl dvd_rfl
  have hl'N : α * l' ^ e.natAbs ∣ 1 * l ^ N := by
    rw [one_mul]; exact hAl'
  by_cases he : 0 ≤ e
  · have hn : e.toNat = e.natAbs := by omega
    simp only [if_pos he, hn] at hPL hPR ⊢
    rw [show (1 : Fin 2) - 0 = 1 from rfl]
    have hD : k (σ α) * k (f (wcEbntX W b 0)) ^ e.natAbs ∣ k F := by
      apply happrox
      · have := s2 1 (k (f (wcEbntX W b 0))) N hlx hdual.1 (fun _ => hlN)
          (fun h => absurd h (by omega))
        simpa only [map_one, one_mul] using this
      · have := s3 1 (k (f (wcEbntX W b 0))) (k (f (wcEbntX W b 1))) N hly hdual.1 hl'N
        simpa only [map_one, one_mul] using this
      · exact (Dvd.intro (k (f (wcEbntX W b 1)) ^ e.natAbs) (by ring)).trans hπk
      · intro j hj
        exact ⟨s2 (a j) _ j hlx hdual.1 (fun _ => (hPL j hj).1) (fun _ => (hPR j hj).1),
          s3 (a' j) _ _ (j + 1) hly hdual.1 (hPR j hj).2⟩
    rw [hkey, map_mul, map_pow, ← mul_assoc]
    exact mul_dvd_mul hD dvd_rfl
  · have hn : (-e).toNat = e.natAbs := by omega
    simp only [if_neg he, hn] at hPL hPR ⊢
    rw [show (1 : Fin 2) - 1 = 0 from rfl]
    have hD : k (σ α) * k (f (wcEbntX W b 1)) ^ e.natAbs ∣ k F := by
      apply happrox
      · have := s3 1 (k (f (wcEbntX W b 1))) (k (f (wcEbntX W b 0))) N hlx hdual.2 hl'N
        simpa only [map_one, one_mul] using this
      · have := s2 1 (k (f (wcEbntX W b 1))) N hly hdual.2 (fun _ => hlN)
          (fun h => absurd h (by omega))
        simpa only [map_one, one_mul] using this
      · exact (Dvd.intro (k (f (wcEbntX W b 0)) ^ e.natAbs) (by ring)).trans hπk
      · intro j hj
        exact ⟨s3 (a j) _ _ j hlx hdual.2 (hPL j hj).1,
          s2 (a' j) _ (j + 1) hly hdual.2 (fun _ => (hPR j hj).2) (fun _ => (hPL j hj).2)⟩
    rw [hkey, map_mul, map_pow]
    have e3 : k (σ α) * (k (f (wcEbntX W b 0)) ^ e.natAbs * k (f (wcEbntX W b 1)) ^ e.natAbs) =
        (k (σ α) * k (f (wcEbntX W b 1)) ^ e.natAbs) * k (f (wcEbntX W b 0)) ^ e.natAbs := by
      ring
    rw [e3]
    exact mul_dvd_mul hD dvd_rfl

theorem wcpa_dj_lr1k_ebnt_dm_slope : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (F G : Q) (c : ↥W), c ≠ 0 → F * G = σ c → ∃ (α : ↥W) (n : ℕ) (i : Fin 2), α ≠ 0 ∧ (∀ (K : Type u) [Field K] (V : ValuationSubring K) (k : Q →+* V), IsLocalHom k → (∃ μ ∈ IsLocalRing.maximalIdeal ↥W, μ ≠ 0 ∧ k (σ μ) ∣ k (f (wcEbntX W b 0)) ∧ k (σ μ) ∣ k (f (wcEbntX W b 1))) → k (σ (α * b ^ n)) ∣ k (F * f (wcEbntX W b (1 - i)) ^ n)) ∧ ∃ (K : Type u) (_ : Field K) (V : ValuationSubring K) (k : Q →+* V), IsLocalHom k ∧ k (σ (α * b ^ n)) ≠ 0 ∧ k (F * f (wcEbntX W b (1 - i)) ^ n) ∣ k (σ (α * b ^ n)) :=
by
  intro Ω _ _ W hdim hWt Q _ σ b f hf F G c hc hFG
  classical
  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := hf.1
  have hb0 : b ≠ 0 := hf.2.1

  have hσm : ∀ t ∈ IsLocalRing.maximalIdeal ↥W, ¬ IsUnit (σ t) := by
    intro t ht hu
    have e : σ t = f (Ideal.Quotient.mk _ (MvPolynomial.C t)) := by
      rw [← hf.2.2.1]; rfl
    rw [e] at hu
    apply (hf.2.2.2.2.1 _).mp hu
    apply Ideal.mem_map_of_mem
    apply Ideal.mem_sup_right
    exact Ideal.mem_map_of_mem _ ht

  have hminF : ∀ (t : ℕ → ↥W) (d : ℕ), ∃ i ≤ d, ∀ j ≤ d, t i ∣ t j := by
    intro t d
    induction d with
    | zero =>
      refine ⟨0, le_rfl, fun j hj => ?_⟩
      obtain rfl : j = 0 := by omega
      exact dvd_rfl
    | succ d ih =>
      obtain ⟨i, hi, hmin⟩ := ih
      rcases ValuationRing.dvd_total (t i) (t (d + 1)) with h | h
      · refine ⟨i, by omega, fun j hj => ?_⟩
        rcases Nat.lt_or_ge j (d + 1) with hj' | hj'
        · exact hmin j (by omega)
        · obtain rfl : j = d + 1 := by omega
          exact h
      · refine ⟨d + 1, le_rfl, fun j hj => ?_⟩
        rcases Nat.lt_or_ge j (d + 1) with hj' | hj'
        · exact h.trans (hmin j (by omega))
        · obtain rfl : j = d + 1 := by omega
          exact dvd_rfl
  have hmin : ∀ (μ₀ μ₁ : ↥W) (d : ℕ) (a a' : ℕ → ↥W), ∃ δ : ↥W,
      (∀ i ≤ d, δ ∣ a i * μ₀ ^ i ∧ δ ∣ a' i * μ₁ ^ (i + 1)) ∧
      (∃ i ≤ d, a i * μ₀ ^ i ∣ δ ∨ a' i * μ₁ ^ (i + 1) ∣ δ) := by
    intro μ₀ μ₁ d a a'
    obtain ⟨i, hi, h1⟩ := hminF (fun i => a i * μ₀ ^ i) d
    obtain ⟨j, hj, h2⟩ := hminF (fun i => a' i * μ₁ ^ (i + 1)) d
    rcases ValuationRing.dvd_total (a i * μ₀ ^ i) (a' j * μ₁ ^ (j + 1)) with h | h
    · exact ⟨a i * μ₀ ^ i, fun k hk => ⟨h1 k hk, h.trans (h2 k hk)⟩, ⟨i, hi, Or.inl dvd_rfl⟩⟩
    · exact ⟨a' j * μ₁ ^ (j + 1), fun k hk => ⟨h.trans (h1 k hk), h2 k hk⟩, ⟨j, hj, Or.inr dvd_rfl⟩⟩

  have hpad : ∀ (d₁ d : ℕ) (a a' : ℕ → ↥W), d₁ ≤ d → (∀ i, d₁ < i → a i = 0 ∧ a' i = 0) →
