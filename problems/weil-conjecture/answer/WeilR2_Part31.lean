      Function.Surjective ((Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec (.of R)).presheaf.germ ⊤ y' trivial).hom := by
    rintro y' rfl
    have h1 : (Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec (.of R)).presheaf.germ ⊤ (IsLocalRing.closedPoint R) trivial =
          (stalkClosedPointIso (.of R)).inv := by
      rw [← ΓSpecIso_hom_stalkClosedPointIso_inv, Iso.inv_hom_id_assoc]
    rw [h1]
    exact (ConcreteCategory.bijective_of_isIso (stalkClosedPointIso (.of R)).inv).2

  have KER : ∀ q : ↥(Spec (.of (IsLocalRing.ResidueField R))),
      RingHom.ker ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))).stalkMap q).hom =
        Ideal.map ((Scheme.ΓSpecIso (.of R)).inv ≫ (Spec (.of R)).presheaf.germ ⊤
          ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) q) trivial).hom
          (IsLocalRing.maximalIdeal R) := by
    intro q
    have helt : ∀ r : R,
        ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))).stalkMap q).hom
          (((Scheme.ΓSpecIso (.of R)).inv ≫ (Spec (.of R)).presheaf.germ ⊤
            ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) q)
              trivial).hom r) =
        (Spec (.of (IsLocalRing.ResidueField R))).presheaf.germ
            ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) ⁻¹ᵁ ⊤)
            q trivial ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField R))).inv
              (algebraMap R (IsLocalRing.ResidueField R) r)) := by
      intro r
      have h2 := congrArg (fun φ => φ.hom r) (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [h2]
      exact Scheme.Hom.germ_stalkMap_apply _ ⊤ q trivial _
    have hsj := hsurjS _ (hc q)
    apply le_antisymm
    · intro a ha
      obtain ⟨r, rfl⟩ := hsj a
      by_cases hr : r ∈ IsLocalRing.maximalIdeal R
      · exact Ideal.mem_map_of_mem _ hr
      · exfalso
        have hu : IsUnit r := by
          by_contra h
          apply hr
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact h
        have hu2 := (hu.map ((Scheme.ΓSpecIso (.of R)).inv ≫ (Spec (.of R)).presheaf.germ ⊤
            ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) q)
              trivial).hom).map
          ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))).stalkMap q).hom
        rw [RingHom.mem_ker.mp ha] at hu2
        exact not_isUnit_zero hu2
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      have hr0 : algebraMap R (IsLocalRing.ResidueField R) r = 0 := by
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact (IsLocalRing.residue_eq_zero_iff r).mpr hr
      rw [Ideal.mem_comap, RingHom.mem_ker, helt r, hr0, map_zero]
      exact map_zero _

  have RHO : ∀ (x : X) (y : ↥(Spec (.of R))) (e : g x = y),
      (wcLdnmTvRho g x y e).comp ((Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec (.of R)).presheaf.germ ⊤ y trivial).hom =
      ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫ X.presheaf.germ ⊤ x trivial).hom := by
    intro x y e
    subst e
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    ext r
    simp only [RingHom.comp_apply, CommRingCat.hom_id, RingHom.id_apply, CommRingCat.hom_comp]
    exact Scheme.Hom.germ_stalkMap_apply g ⊤ x trivial _
  refine ⟨?_, ?_⟩
  · intro x hx
    obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := g) (g := Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))
      x (IsLocalRing.closedPoint (IsLocalRing.ResidueField R)) (hx.trans (hc _).symm)
    exact ⟨w, hw⟩
  · intro w
    have ew : g (Limits.pullback.fst g
          (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) w) =
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))
          (Limits.pullback.snd g
            (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) w) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    obtain ⟨hs, hk⟩ := PB _ _ g _ (IsPullback.of_hasPullback g
      (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) hci w _ rfl ew
    refine ⟨ew.trans (hc _), hs, ?_⟩
    rw [hk, KER, Ideal.map_map, RHO]

theorem wcpa_dj_lr1k_lfnc_datum_algebra : ∀ (B O R K : Type u) [CommRing B] [CommRing O] [CommRing R] [IsLocalRing B] [IsLocalRing O] [IsLocalRing R] [Field K] (β : B →+* O) (π : O →+* R) (φ : K →+* R) (θ : IsLocalRing.ResidueField B ≃+* K), Function.Surjective π → RingHom.ker π = Ideal.map β (IsLocalRing.maximalIdeal B) → π.comp β = (φ.comp θ.toRingHom).comp (IsLocalRing.residue B) → (∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → ∃ ε : AdicCompletion ((IsLocalRing.maximalIdeal O).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal B).map β))) (O ⧸ (IsLocalRing.maximalIdeal B).map β) ≃+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField B) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), ε.toRingHom.comp ((algebraMap (O ⧸ (IsLocalRing.maximalIdeal B).map β) (AdicCompletion ((IsLocalRing.maximalIdeal O).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal B).map β))) (O ⧸ (IsLocalRing.maximalIdeal B).map β))).comp ((Ideal.Quotient.mk ((IsLocalRing.maximalIdeal B).map β)).comp β)) = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (IsLocalRing.residue B)) :=
by
  intro B O R K _ _ _ _ _ _ _ β π φ θ hπ hker hcomp hE
  obtain ⟨e, he⟩ := hE

  have hev : ∀ {C : Type u} [CommRing C] (K : Ideal C) (n : ℕ) (c : C),
      AdicCompletion.evalₐ K n (algebraMap C (AdicCompletion K C) c) =
        Ideal.Quotient.mk (K ^ n) c := by
    intro C _ K n c
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hmap : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (f : B →+* B') (J : Ideal B)
      (J' : Ideal B'), (∀ b ∈ J, f b ∈ J') → ∃ F : AdicCompletion J B →+* AdicCompletion J' B',
      ∀ (n : ℕ) (b : B) (x : AdicCompletion J B),
        AdicCompletion.evalₐ J n x = Ideal.Quotient.mk (J ^ n) b →
        AdicCompletion.evalₐ J' n (F x) = Ideal.Quotient.mk (J' ^ n) (f b) := by
    intro B B' _ _ f J J' h
    have hn : ∀ n : ℕ, J ^ n ≤ (J' ^ n).comap f := fun n => by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr (fun b hb => h b hb)) n
    refine ⟨AdicCompletion.liftRingHom J' (fun n => (Ideal.quotientMap (J' ^ n) f (hn n)).comp
      (AdicCompletion.evalₐ J n).toRingHom) ?_, ?_⟩
    · intro m n hle
      ext x
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective J B x
      have hmm := congrArg (Ideal.quotientMap (J' ^ m) f (hn m))
        (AdicCompletion.Ideal.mk_eq_mk J hle a)
      simp only [Ideal.quotientMap_mk] at hmm
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        AdicCompletion.evalₐ_mk, Ideal.quotientMap_mk]
      rw [← hmm]
      rfl
    · intro n b x hx
      rw [AdicCompletion.evalₐ_liftRingHom]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hx,
        Ideal.quotientMap_mk]
  have t_adic : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (τ : B ≃+* B') (J : Ideal B)
      (J' : Ideal B'), J.map τ = J' → ∃ T : AdicCompletion J B ≃+* AdicCompletion J' B',
      ∀ b : B, T (algebraMap B _ b) = algebraMap B' _ (τ b) := by
    intro B B' _ _ τ J J' hJ
    have h1 : ∀ b ∈ J, (τ : B →+* B') b ∈ J' := by
      intro b hb
      rw [← hJ]
      simpa using Ideal.mem_map_of_mem τ hb
    have h2 : ∀ z ∈ J', (τ.symm : B' →+* B) z ∈ J := by
      intro z hz
      rw [← hJ] at hz
      obtain ⟨x, hx, rfl⟩ := (Ideal.mem_map_of_equiv τ z).mp hz
      simpa using hx
    obtain ⟨F, hF⟩ := hmap (τ : B →+* B') J J' h1
    obtain ⟨G, hG⟩ := hmap (τ.symm : B' →+* B) J' J h2
    have hGF : ∀ x, G (F x) = x := fun x => AdicCompletion.ext_evalₐ (fun n => by
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n x)
      rw [hG n ((τ : B →+* B') b) (F x) (hF n b x hb.symm), ← hb]
      simp)
    have hFG : ∀ x, F (G x) = x := fun x => AdicCompletion.ext_evalₐ (fun n => by
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J' n x)
      rw [hF n ((τ.symm : B' →+* B) b) (G x) (hG n b x hb.symm), ← hb]
      simp)
    refine ⟨RingEquiv.ofRingHom F G (RingHom.ext hFG) (RingHom.ext hGF), fun b => ?_⟩
    rw [RingEquiv.ofRingHom_apply]
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hF n b _ (hev J n b), hev]
    rfl

  set I : Ideal O := (IsLocalRing.maximalIdeal B).map β with hI
  let ρ : (O ⧸ I) ≃+* R :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hπ)
  have hρ : ∀ o, ρ (Ideal.Quotient.mk I o) = π o := fun o => by
    simp only [ρ, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
  have hρc : (ρ : O ⧸ I →+* R).comp (Ideal.Quotient.mk I) = π := RingHom.ext hρ

  have hJ : ((IsLocalRing.maximalIdeal O).map (Ideal.Quotient.mk I)).map ρ =
      IsLocalRing.maximalIdeal R := by
    change ((IsLocalRing.maximalIdeal O).map (Ideal.Quotient.mk I)).map (ρ : O ⧸ I →+* R) = _
    rw [Ideal.map_map, hρc]
    exact IsLocalRing.map_maximalIdeal_of_surjective π hπ
  obtain ⟨T, hT⟩ := t_adic ρ _ _ hJ

  let M : MvPowerSeries (Fin 2) K →+* MvPowerSeries (Fin 2) (IsLocalRing.ResidueField B) :=
    MvPowerSeries.map (θ.symm : K →+* IsLocalRing.ResidueField B)
  let M' : MvPowerSeries (Fin 2) (IsLocalRing.ResidueField B) →+* MvPowerSeries (Fin 2) K :=
    MvPowerSeries.map (θ : IsLocalRing.ResidueField B →+* K)
  have hMM' : M.comp M' = RingHom.id _ := by
    apply RingHom.ext
    intro p
    ext n
    simp [M, M']
  have hM'M : M'.comp M = RingHom.id _ := by
    apply RingHom.ext
    intro p
    ext n
    simp [M, M']
  let Me := RingEquiv.ofRingHom M M' hMM' hM'M
  have hspan : Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
      MvPowerSeries (Fin 2) (IsLocalRing.ResidueField B))} =
      Ideal.map Me (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
        MvPowerSeries (Fin 2) K)}) := by
    rw [Ideal.map_span, Set.image_singleton]
    congr 2
    change _ = M (MvPowerSeries.X 0 * MvPowerSeries.X 1)
    simp [M, MvPowerSeries.map_X]
  let Θ := Ideal.quotientEquiv _ _ Me hspan

  refine ⟨T.trans (e.trans Θ), ?_⟩
  apply RingHom.ext
  intro b
  have h1 := hT (Ideal.Quotient.mk I (β b))
  rw [hρ] at h1
  have h2 : π (β b) = φ (θ (IsLocalRing.residue B b)) := RingHom.congr_fun hcomp b
  have h3 := RingHom.congr_fun he (θ (IsLocalRing.residue B b))
  simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_comp, RingHom.coe_coe,
    Function.comp_apply] at h3 ⊢
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, h1, h2, h3]
  have h4 : Me (MvPowerSeries.C (θ (IsLocalRing.residue B b))) =
      MvPowerSeries.C (IsLocalRing.residue B b) := by
    change MvPowerSeries.map (θ.symm : K →+* IsLocalRing.ResidueField B)
      (MvPowerSeries.C (θ (IsLocalRing.residue B b))) = _
    rw [MvPowerSeries.map_C]
    simp
  have h5 : Θ (Ideal.Quotient.mk _ (MvPowerSeries.C (θ (IsLocalRing.residue B b)))) =
      Ideal.Quotient.mk _ (Me (MvPowerSeries.C (θ (IsLocalRing.residue B b)))) :=
    Ideal.quotientEquiv_mk _ _ Me hspan _
  exact h5.trans (congrArg _ h4)

theorem wcpa_dj_lr1k_lf_node_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι → ∀ y : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
    IsClosed ({y} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) →
    wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) = 1 →
    wcpaDjLkBranches ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) = 2 →
    ∃ a ∈ IsLocalRing.maximalIdeal ↥W, a ≠ 0 ∧
      wcLfChart (S := ↥W) (Q := wcNcRing W a) ((γ ≫ ι).fromNormalization ≫ uX)
        (wcNdPt W (γ ≫ ι) uX y)
        (Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
          (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
            Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))) :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y hy h1 h2

  have s16 : ∀ (B O R K : Type u) [CommRing B] [CommRing O] [CommRing R] [IsLocalRing B]
      [IsLocalRing O] [IsLocalRing R] [Field K] (β : B →+* O) [IsLocalHom β] (π : O →+* R)
      (φ : K →+* R) (θ : IsLocalRing.ResidueField B ≃+* K), IsLocalHom π →
      π.comp β = (φ.comp θ.toRingHom).comp (IsLocalRing.residue B) →
      (∀ r : R, ∃ c : K, r - φ c ∈ IsLocalRing.maximalIdeal R) →
      Function.Bijective (IsLocalRing.ResidueField.map β) := by
    intro B O R K _ _ _ _ _ _ _ β _ π φ θ hπ hc hr
    refine ⟨RingHom.injective _, ?_⟩
    intro t
    obtain ⟨o, rfl⟩ := IsLocalRing.residue_surjective t
    obtain ⟨c, hc'⟩ := hr (π o)
    obtain ⟨k, hk⟩ := θ.surjective c
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective k
    refine ⟨IsLocalRing.residue B b, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue]
    have e1 : φ c = π (β b) := by
      have := congrArg (fun f => f b) hc
      simp only [RingHom.comp_apply] at this
      rw [this, ← hk]
      rfl
    rw [e1, ← map_sub] at hc'
    have hmem : β b - o ∈ IsLocalRing.maximalIdeal O := by
      by_contra hn
      have hu : IsUnit (β b - o) := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hn
        exact hn
      have hu' : IsUnit (π (o - β b)) := by
        rw [← neg_sub, map_neg]
        exact (hu.map π).neg
      exact (IsLocalRing.mem_maximalIdeal _).mp hc' hu'
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact hmem

  have s17 : ∀ (a : ↥W) (P : Ideal (wcNcRing W a)),
      Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) ∈ P →
      Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) ∈ P →
      P.comap (algebraMap ↥W (wcNcRing W a)) = IsLocalRing.maximalIdeal ↥W →
      a ∈ IsLocalRing.maximalIdeal ↥W ∧ P = Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
    intro a P h0 h1' hc
    have halg : ∀ c : ↥W, algebraMap ↥W (wcNcRing W a) c =
        Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) := fun c => rfl
    have hCm : ∀ c : ↥W, Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈ P ↔
        c ∈ IsLocalRing.maximalIdeal ↥W := by
      intro c
      rw [← hc, Ideal.mem_comap, halg]
    have hle : Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro f hf
        rcases hf with rfl | rfl
        · exact h0
        · exact h1'
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc'
        exact (hCm c).mpr hc'
    refine ⟨?_, le_antisymm ?_ hle⟩
    · rw [← hCm]
      have hrel : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C a) =
          Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) *
            Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) := by
        rw [← map_mul, Ideal.Quotient.eq]
        rw [← neg_sub]
        exact neg_mem (Ideal.mem_span_singleton_self _)
      rw [hrel]
      exact P.mul_mem_left _ h1'
    · have hdec0 : ∀ f : MvPolynomial (Fin 2) ↥W,
          f - MvPolynomial.C (MvPolynomial.constantCoeff f) ∈
          Ideal.span ({MvPolynomial.X 0, MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) ↥W)) := by
        intro f
        induction f using MvPolynomial.induction_on with
        | C r => simp
        | add p q hp hq =>
          have : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
              (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
                (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
            rw [map_add, map_add]; ring
          rw [this]
          exact Ideal.add_mem _ hp hq
        | mul_X p i hp =>
          have h0' : MvPolynomial.constantCoeff (p * MvPolynomial.X i) = 0 := by simp
          rw [h0', map_zero, sub_zero]
          apply Ideal.mul_mem_left
          apply Ideal.subset_span
          fin_cases i
          · exact Or.inl rfl
          · exact Or.inr rfl
      intro x hx
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hdec := hdec0 f
      set c := MvPolynomial.constantCoeff f with hcdef
      have hA : Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) ∈
          Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
            (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
        Ideal.mem_map_of_mem _ (Ideal.mem_sup_left hdec)
      have hcP : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈ P := by
        have : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) =
            Ideal.Quotient.mk (wcNcIdeal W a) f -
              Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) := by
          rw [map_sub]; ring
        rw [this]
        exact P.sub_mem hx (hle hA)
      have hcm : c ∈ IsLocalRing.maximalIdeal ↥W := (hCm c).mp hcP
      have hB : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈
          Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
            (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
        Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hcm))
      have : Ideal.Quotient.mk (wcNcIdeal W a) f =
          Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) +
            Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) := by
        rw [map_sub]; ring
      rw [this]
      exact Ideal.add_mem _ hA hB

