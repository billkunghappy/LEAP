        g (wcEbntX W a 0) = x n ∧ g (wcEbntX W a 1) = y n := by
      refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom (RingHom.id ↥W) ![x n, y n]) ?_,
