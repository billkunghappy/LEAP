    rw [Polynomial.hom_eval₂, map_zero, hkσ, hk0] at h1
    exact h1
  apply Polynomial.eq_zero_of_infinite_isRoot p
  exact (Set.infinite_range_of_injective hxinj).mono (by
    rintro _ ⟨n, rfl⟩
    exact hroot n)

