theorem wcpa_dj_lqr_section_residue : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (a : X ⟶ Spec (.of K)) (τ : Spec (.of K) ⟶ X), τ ≫ a = 𝟙 _ → ∀ y : X.presheaf.stalk (τ (IsLocalRing.closedPoint K)), ∃ c : K, y - ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ (τ (IsLocalRing.closedPoint K)) trivial).hom c ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) :=
