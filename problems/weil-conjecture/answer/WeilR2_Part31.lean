      · exact mul_mem (hcD _ (hdiv j k (by omega) hk)) (pow_mem hGD _)
    · exact zero_mem _
  · intro k hk
    show η ^ j0 * (if k ≤ N then ∑ j ∈ Finset.range (N + 1), τ j k else 0) = _
    rw [if_pos hk, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    show η ^ j0 * (if j0 ≤ j then ι (x j k) * η ^ (j - j0)
        else ι (x j k / g ^ (j0 - j)) * (ι g / η) ^ (j0 - j)) = _
    split_ifs with hjj
    · rw [show η ^ j = η ^ j0 * η ^ (j - j0) by rw [← pow_add, Nat.add_sub_cancel' hjj]]
      ring
    · push_neg at hjj
      rw [map_div₀, map_pow, div_pow]
      have e : η ^ j0 = η ^ j * η ^ (j0 - j) := by
        rw [← pow_add, Nat.add_sub_cancel' hjj.le]
      rw [e]
