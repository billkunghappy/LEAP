theorem wcpa_dj_lr1k_ebd_two_section_chart : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (σ σ' : Spec (.of ↥W) ⟶ Z),
    IsSeparated uu → σ ≫ uu = 𝟙 _ → σ' ≫ uu = 𝟙 _ →
    σ (IsLocalRing.closedPoint ↥W) = σ' (IsLocalRing.closedPoint ↥W) →
    (∃ U : Z.Opens, σ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ uu)) →
    ∃ (O : Z.Opens) (m : O.toScheme ⟶ wcEbdA1 W) (σO σ'O : Spec (.of ↥W) ⟶ O.toScheme) (c' : ↥W),
      IsAffineOpen O ∧ Etale m ∧ m ≫ wcEbdStr W = O.ι ≫ uu ∧ σO ≫ O.ι = σ ∧ σ'O ≫ O.ι = σ' ∧
      σO ≫ m = wcEbdSec W 0 ∧ σ'O ≫ m = wcEbdSec W c' ∧
