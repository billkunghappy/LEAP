          by_contra h
          apply hr
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact h
        have hu2 := (hu.map ((Scheme.ΓSpecIso (.of R)).inv ≫ (Spec (.of R)).presheaf.germ ⊤
            ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) q)
              trivial).hom).map
          ((Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))).stalkMap q).hom
        rw [RingHom.mem_ker.mp ha] at hu2
        exact not_isUnit_zero hu2
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      have hr0 : algebraMap R (IsLocalRing.ResidueField R) r = 0 := by
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact (IsLocalRing.residue_eq_zero_iff r).mpr hr
      rw [Ideal.mem_comap, RingHom.mem_ker, helt r, hr0, map_zero]
      exact map_zero _

  have RHO : ∀ (x : X) (y : ↥(Spec (.of R))) (e : g x = y),
      (wcLdnmTvRho g x y e).comp ((Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec (.of R)).presheaf.germ ⊤ y trivial).hom =
      ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫ X.presheaf.germ ⊤ x trivial).hom := by
    intro x y e
    subst e
    unfold wcLdnmTvRho
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    ext r
    simp only [RingHom.comp_apply, CommRingCat.hom_id, RingHom.id_apply, CommRingCat.hom_comp]
    exact Scheme.Hom.germ_stalkMap_apply g ⊤ x trivial _
  refine ⟨?_, ?_⟩
  · intro x hx
    obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := g) (g := Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))
      x (IsLocalRing.closedPoint (IsLocalRing.ResidueField R)) (hx.trans (hc _).symm)
    exact ⟨w, hw⟩
  · intro w
    have ew : g (Limits.pullback.fst g
          (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) w) =
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))
          (Limits.pullback.snd g
            (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) w) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    obtain ⟨hs, hk⟩ := PB _ _ g _ (IsPullback.of_hasPullback g
      (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) hci w _ rfl ew
    refine ⟨ew.trans (hc _), hs, ?_⟩
    rw [hk, KER, Ideal.map_map, RHO]

theorem wcpa_dj_lr1k_ebnt_node_hens : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X),
    wcpaDjLkModel W uX ι →
    ∀ (w : ↥(Limits.pullback uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
      ¬ wcpaDjLkSmAt W uX w →
    ∀ (V : Scheme.{u}) (j : V ⟶ X) [IsOpenImmersion j] (v : ↥V),
      j v = Limits.pullback.fst uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w →
    ∀ (P : Type u) [CommRing P] (e : ↥(V.presheaf.stalk v) →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal ↥(V.presheaf.stalk v)) P e →
      wcNdModelB W P (e.comp (wcNdSig (j ≫ uX) v)) :=
by
  intro Ω _ _ W hW hWt X uX ι hM w hnsm V j _ v hv P _ e he

  have s15 : ∀ (B O : Type u) [CommRing B] [CommRing O] [IsLocalRing B] [IsLocalRing O]
      (β : B →+* O) [IsLocalHom β]
      (ψ : O →+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField B) ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
          MvPowerSeries (Fin 2) (IsLocalRing.ResidueField B))})),
      (∀ b, ψ (β b) = Ideal.Quotient.mk _ (MvPowerSeries.C (IsLocalRing.residue B b))) →
      Function.Bijective (IsLocalRing.ResidueField.map β) := by
    intro B O _ _ _ _ β _ ψ hψ
    have hχ : ∀ t ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
        MvPowerSeries (Fin 2) (IsLocalRing.ResidueField B))},
        MvPowerSeries.constantCoeff t = 0 := by
      intro t ht
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ht
      rw [map_mul, map_mul, MvPowerSeries.constantCoeff_X, zero_mul, mul_zero]
    set Φ : O →+* IsLocalRing.ResidueField B :=
      (Ideal.Quotient.lift _ MvPowerSeries.constantCoeff hχ).comp ψ with hΦ
    have hΦβ : ∀ b, Φ (β b) = IsLocalRing.residue B b := by
      intro b
      rw [hΦ, RingHom.comp_apply, hψ, Ideal.Quotient.lift_mk, MvPowerSeries.constantCoeff_C]
    have hΦu : ∀ o, Φ o = 0 → o ∈ IsLocalRing.maximalIdeal O := by
      intro o ho
      by_contra hn
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hn
      exact (hn.map Φ).ne_zero ho
    refine ⟨RingHom.injective _, ?_⟩
    intro t
    obtain ⟨o, rfl⟩ := IsLocalRing.residue_surjective t
    obtain ⟨b, hb⟩ := IsLocalRing.residue_surjective (Φ o)
    refine ⟨IsLocalRing.residue B b, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue]
    have hmem : o - β b ∈ IsLocalRing.maximalIdeal O :=
      hΦu _ (by rw [map_sub, hΦβ, hb, sub_self])
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff, ← neg_sub]
    exact neg_mem hmem

  have s16 : ∀ (A B : Type u) [CommRing A] [CommRing B] (σ : A →+* B), Function.Bijective σ →
      ∀ (p : Ideal B) (e : B →+* P), wcNdIsHens p P e → wcNdIsHens (p.comap σ) P (e.comp σ) := by
    intro A B _ _ σ hσ p e he
    obtain ⟨hP, hu, hU⟩ := he
    refine ⟨hP, fun a => by rw [RingHom.comp_apply, hu, Ideal.mem_comap], ?_⟩
    intro B₀ _ hB₀ g hg
    let σ' : A ≃+* B := RingEquiv.ofBijective σ hσ
    have hσσ : ∀ b, σ (σ'.symm b) = b := fun b =>
      (RingEquiv.ofBijective_apply σ hσ _).symm.trans (σ'.apply_symm_apply b)
    have hσσ' : ∀ a, σ'.symm (σ a) = a := fun a =>
      (congrArg σ'.symm (RingEquiv.ofBijective_apply σ hσ a).symm).trans (σ'.symm_apply_apply a)
    let g' : B →+* B₀ := g.comp (σ'.symm : B →+* A)
    have hg'apply : ∀ b, g' b = g (σ'.symm b) := fun b => rfl
    have hg' : ∀ b, IsUnit (g' b) ↔ b ∉ p := by
      intro b
      rw [hg'apply, hg, Ideal.mem_comap, hσσ]
    obtain ⟨h₀, ⟨hh₀, hloc⟩, huniq⟩ := hU B₀ hB₀ g' hg'
    refine ⟨h₀, ⟨?_, hloc⟩, ?_⟩
    · apply RingHom.ext
      intro a
      have h1 := congrArg (fun f => f (σ a)) hh₀
      simp only [RingHom.comp_apply] at h1 ⊢
      rw [h1, hg'apply, hσσ']
    · rintro h' ⟨hh', hloc'⟩
      apply huniq h'
      refine ⟨?_, hloc'⟩
      apply RingHom.ext
      intro b
      obtain ⟨a, rfl⟩ := hσ.2 b
      have h1 := congrArg (fun f => f a) hh'
      simp only [RingHom.comp_apply] at h1 ⊢
      rw [h1, hg'apply, hσσ']

  have s17 : ∀ (a : ↥W) (P : Ideal (wcNcRing W a)),
      Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) ∈ P →
      Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) ∈ P →
      P.comap (algebraMap ↥W (wcNcRing W a)) = IsLocalRing.maximalIdeal ↥W →
      a ∈ IsLocalRing.maximalIdeal ↥W ∧ P = Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) := by
    intro a P h0 h1' hc
    have halg : ∀ c : ↥W, algebraMap ↥W (wcNcRing W a) c =
        Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) := fun c => rfl
    have hCm : ∀ c : ↥W, Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈ P ↔
        c ∈ IsLocalRing.maximalIdeal ↥W := by
      intro c
      rw [← hc, Ideal.mem_comap, halg]
    have hle : Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) ≤ P := by
      rw [Ideal.map_le_iff_le_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        intro f hf
        rcases hf with rfl | rfl
        · exact h0
        · exact h1'
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc'
        exact (hCm c).mpr hc'
    refine ⟨?_, le_antisymm ?_ hle⟩
    · rw [← hCm]
      have hrel : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C a) =
          Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) *
            Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) := by
        rw [← map_mul, Ideal.Quotient.eq]
        rw [← neg_sub]
        exact neg_mem (Ideal.mem_span_singleton_self _)
      rw [hrel]
      exact P.mul_mem_left _ h1'
    · have hdec0 : ∀ f : MvPolynomial (Fin 2) ↥W,
          f - MvPolynomial.C (MvPolynomial.constantCoeff f) ∈
          Ideal.span ({MvPolynomial.X 0, MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) ↥W)) := by
        intro f
        induction f using MvPolynomial.induction_on with
        | C r => simp
        | add p q hp hq =>
          have : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
              (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
                (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
            rw [map_add, map_add]; ring
          rw [this]
          exact Ideal.add_mem _ hp hq
        | mul_X p i hp =>
          have h0' : MvPolynomial.constantCoeff (p * MvPolynomial.X i) = 0 := by simp
          rw [h0', map_zero, sub_zero]
          apply Ideal.mul_mem_left
          apply Ideal.subset_span
          fin_cases i
          · exact Or.inl rfl
          · exact Or.inr rfl
      intro x hx
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hdec := hdec0 f
      set c := MvPolynomial.constantCoeff f with hcdef
      have hA : Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) ∈
          Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
            (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
        Ideal.mem_map_of_mem _ (Ideal.mem_sup_left hdec)
      have hcP : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈ P := by
        have : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) =
            Ideal.Quotient.mk (wcNcIdeal W a) f -
              Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) := by
          rw [map_sub]; ring
        rw [this]
        exact P.sub_mem hx (hle hA)
      have hcm : c ∈ IsLocalRing.maximalIdeal ↥W := (hCm c).mp hcP
      have hB : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) ∈
          Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
            (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
        Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hcm))
      have : Ideal.Quotient.mk (wcNcIdeal W a) f =
          Ideal.Quotient.mk (wcNcIdeal W a) (f - MvPolynomial.C c) +
            Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.C c) := by
        rw [map_sub]; ring
      rw [this]
      exact Ideal.add_mem _ hA hB

  have s18 : ∀ {U Y T S : Scheme.{u}} (e : U ⟶ Y) (m : U ⟶ T) (g : Y ⟶ S) (h : T ⟶ S)
      (x : ↥U) (y : ↥Y), Etale e → m ≫ h = e ≫ g → e x = y →
      IsAlgClosed ↥(Y.residueField y) → Function.Bijective (g.residueFieldMap y).hom →
      Function.Bijective (e.residueFieldMap x).hom ∧
        Function.Bijective (m.residueFieldMap x).hom := by
    intro U Y T S e m g h x y he hmh hex hAC hg
    subst hex
    have hes : Function.Surjective (e.residueFieldMap x).hom :=
      wc_etale_residue_surj_of_sepClosed e x inferInstance
    have heb : Function.Bijective (e.residueFieldMap x).hom := ⟨RingHom.injective _, hes⟩
    refine ⟨heb, RingHom.injective _, ?_⟩
    have h1 := Scheme.residueFieldMap_comp m h x
    have h2 := Scheme.residueFieldMap_comp e g x
    have h3 := Scheme.Hom.residueFieldMap_congr hmh x
    have key : Function.Surjective ((m ≫ h).residueFieldMap x).hom := by
      rw [h3, h2]
      simp only [CommRingCat.hom_comp, RingHom.coe_comp]
      exact (heb.2.comp hg.2).comp (Scheme.residueFieldCongr _).commRingCatIsoToRingEquiv.surjective
    intro t
    obtain ⟨s, hs⟩ := key t
    refine ⟨(h.residueFieldMap (m x)).hom s, ?_⟩
    rw [← hs, h1]
    rfl

  have hnat : ∀ {B : Type u} [CommRing B] {X Y : Scheme.{u}} (f : X ⟶ Y)
      (hY : Y ⟶ Spec (.of B)) (x : X),
      (f.stalkMap x).hom.comp (wcNdSig hY (f x)) = wcNdSig (f ≫ hY) x := by
    intro B _ X Y f hY x
    unfold wcNdSig wcCnSigma
    ext b
    simp only [RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      ← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      ← CommRingCat.comp_apply]
    congr 2
    simp only [Scheme.Hom.comp_app, Category.assoc]
    first
      | exact congrArg (fun k => Scheme.Hom.app hY ⊤ ≫ k) (Scheme.Hom.germ_stalkMap f ⊤ x trivial)
      | (simp; exact congrArg (fun k => Scheme.Hom.app hY ⊤ ≫ k)
          (Scheme.Hom.germ_stalkMap f ⊤ x trivial))
      | simp [Scheme.Hom.germ_stalkMap]

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  obtain ⟨hss, hXp, hpb⟩ := id hM
  haveI : IsProper uX := hss.2.1
  have hflat : Flat uX := hss.1
  have hlfp : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) _ _ hflat inferInstance
  have hx₀ : uX (j v) = IsLocalRing.closedPoint ↥W := by
    rw [hv]; exact ((wcpa_dj_p1g_cf_fibre_stalk ↥W X uX).2 w).1

  have hns : ¬ ∃ U : X.Opens, j v ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ uX) := by
    rintro ⟨U, hU, hsm⟩
    apply hnsm
    have h1 := isPullback_morphismRestrict (Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) U
    have h2 := h1.paste_vert (IsPullback.of_hasPullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
    refine ⟨Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ U, ?_,
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hsm⟩
    show Limits.pullback.fst uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w ∈ U
    rw [← hv]; exact hU

  have hdat := wcpa_dj_nc_nonsmooth_fibre_node Ω W X uX (j v) hκ hss hlfp hx₀ hns
  obtain ⟨U, eU, a, m, x', heU, hm, hcomm, hex, hX0, hX1⟩ :=
    wcpa_dj_nc_chart_exists Ω W X uX (j v) hκ hflat hlfp hx₀ hdat

  obtain ⟨-, -, hrng, hsmz⟩ := wcpa_dj_ms_generic_fibre Ω W hW (wcProjK Ω 1) X (wcProjKStr Ω 1)
    uX ι (wc_proj_space_smooth Ω 1) hpb
  have ha0 : a ≠ 0 := by
    intro ha
    subst ha
    exact wcpa_dj_nc_chart_a_ne_zero Ω W X uX U eU m x' heU hm hcomm hX0 hX1
      (fun z hz => hsmz z ((hrng z).mpr hz))

  have h3 : (wcNcStr W a) (m x') = IsLocalRing.closedPoint ↥W := by
    rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply, hex]
    exact hx₀
  have hc : (m x').asIdeal.comap (algebraMap ↥W (wcNcRing W a)) = IsLocalRing.maximalIdeal ↥W := by
    have := congrArg PrimeSpectrum.asIdeal h3
    exact this
  obtain ⟨haM, hP⟩ := s17 a (m x').asIdeal hX0 hX1 hc

  obtain ⟨ε, hε⟩ := hdat
  have hβ := s15 _ _ (uX.stalkMap (j v)).hom
    ((ε.toRingHom.comp (algebraMap _ _)).comp (Ideal.Quotient.mk
      ((IsLocalRing.maximalIdeal _).map (uX.stalkMap (j v)).hom)))
    (fun b => congrArg (fun f => f b) hε)
  have hβ' : Function.Bijective (uX.residueFieldMap (j v)).hom := hβ
  have hκs : ∀ s : ↥(Spec (.of ↥W)), s = IsLocalRing.closedPoint ↥W →
      IsAlgClosed (IsLocalRing.ResidueField ((Spec (.of ↥W)).presheaf.stalk s)) := by
    have hloc : ∀ s : ↥(Spec (.of ↥W)), IsLocalRing ((Spec (.of ↥W)).presheaf.stalk s) :=
      fun s => inferInstance
    intro s hs
    subst hs
    exact IsAlgClosed.of_ringEquiv (IsLocalRing.ResidueField ↥W) _
      (@IsLocalRing.ResidueField.mapEquiv _ _ _ _ _ (hloc _)
        (stalkClosedPointIso (CommRingCat.of ↥W)).symm.commRingCatIsoToRingEquiv)
  haveI := hκs _ hx₀
  haveI hAC : IsAlgClosed ↥(X.residueField (j v)) :=
    IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective _ hβ)

  obtain ⟨hre, hrm⟩ := s18 eU m uX (wcNcStr W a) x' (j v) heU hcomm hex hAC hβ'
  have hchart : wcLfChart (S := ↥W) (Q := wcNcRing W a) uX (j v)
      (Ideal.map (Ideal.Quotient.mk (wcNcIdeal W a))
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
          Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal ↥W))) :=
    ⟨U, eU, m, x', heU, hm, hcomm, hex, hP, hre, hrm⟩

  have hbij : Function.Bijective (j.stalkMap v).hom :=
    ConcreteCategory.bijective_of_isIso (j.stalkMap v)
  have hmax : (IsLocalRing.maximalIdeal ↥(V.presheaf.stalk v)).comap (j.stalkMap v).hom =
      IsLocalRing.maximalIdeal ↥(X.presheaf.stalk (j v)) := by
    ext t
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
      mem_nonunits_iff, mem_nonunits_iff, isUnit_map_iff]
  have he' : wcNdIsHens (IsLocalRing.maximalIdeal ↥(X.presheaf.stalk (j v))) P
      (e.comp (j.stalkMap v).hom) := by
    have := s16 _ _ (j.stalkMap v).hom hbij _ e he
    rwa [hmax] at this

  obtain ⟨φ, hφ, hφh⟩ := wcpa_dj_lr1k_lf_chart_transfer ↥W (wcNcRing W a) X uX (j v) _ hchart
    P (e.comp (j.stalkMap v).hom) he'
  refine ⟨a, haM, ha0, φ, ?_, hφh⟩
  apply RingHom.ext
  intro c
  have h1 := congrArg (fun f => f c) hφ
  have h2 := congrArg (fun f => f c) (hnat j uX v)
  simp only [RingHom.comp_apply] at h1 h2 ⊢
  rw [← h2]
  exact h1

theorem wcpa_dj_lus_cvs_ct_fcn_nc_stalk_prime_dict : ∀ (X : Scheme.{u}) (y : X), (∀ (x x' : X) (h : x ⤳ y) (h' : x' ⤳ y), (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap (X.presheaf.stalkSpecializes h).hom ≤ (IsLocalRing.maximalIdeal (X.presheaf.stalk x')).comap (X.presheaf.stalkSpecializes h').hom → x ⤳ x') ∧ (∀ (g : X) (h : g ⤳ y), (∀ g' : X, g' ⤳ g → g' = g) → (IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap (X.presheaf.stalkSpecializes h).hom ∈ minimalPrimes (X.presheaf.stalk y)) ∧ (∀ (S : Type u) [CommRing S] (v : X ⟶ Spec (.of S)) (n : X) (h : n ⤳ y), (v n).asIdeal = ((IsLocalRing.maximalIdeal (X.presheaf.stalk n)).comap (X.presheaf.stalkSpecializes h).hom).comap ((Scheme.ΓSpecIso (.of S)).inv ≫ v.appTop ≫ X.presheaf.germ ⊤ y trivial).hom) :=
by
  intro X y
