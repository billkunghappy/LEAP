theorem wcpa_dj_lr1k_ebc_cgr_sl_same_point_direction : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) [QuasiSeparated uX] (σ σ' : Spec (.of ↥W) ⟶ X) (b : ↥W), σ ≫ uX = 𝟙 _ → σ' ≫ uX = 𝟙 _ → b ≠ 0 → σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b = σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX b → ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X), wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b) r₁ → ∀ (σt σ₁ : Spec (.of ↥W) ⟶ X₁), σt ≫ r₁ = σ → σ₁ ≫ r₁ = σ' → σt (IsLocalRing.closedPoint ↥W) = σ₁ (IsLocalRing.closedPoint ↥W) → ∃ (U : X.Opens) (hU : IsAffineOpen U) (eσ : ⊤ ≤ σ ⁻¹ᵁ U) (eσ' : ⊤ ≤ σ' ⁻¹ᵁ U), ∀ h ∈ (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).ideal ⟨U, hU⟩, ∃ e ∈ IsLocalRing.maximalIdeal ↥W, (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ'.appLE U ⊤ eσ').hom h) - (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((σ.appLE U ⊤ eσ).hom h) = b * e :=
by
  intro Ω _ W X uX _ σ σ' b hσu hσ'u hb hIeq X₁ r₁ hbl σt σ₁ hσt hσ₁ heq
  subst hσt hσ₁

  have theta_phi : ∀ (Y : Scheme.{u}) (u' : Y ⟶ Spec (.of ↥W)) (s : Spec (.of ↥W) ⟶ Y),
      s ≫ u' = 𝟙 _ → ∀ (V : Y.Opens) (hle : V ≤ u' ⁻¹ᵁ ⊤) (e : ⊤ ≤ s ⁻¹ᵁ V) (c : ↥W),
      (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s.appLE V ⊤ e).hom ((u'.appLE ⊤ V hle).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c))) = c := by
    intro Y u' s hs V hle e c
    have key : ∀ (Z : Scheme.{u}) (f : Z ⟶ Z), f = 𝟙 Z → ∀ h : (⊤ : Z.Opens) ≤ f ⁻¹ᵁ ⊤,
        f.appLE ⊤ ⊤ h = 𝟙 _ := by
      intro Z f hf h
      subst hf
      exact (Scheme.Hom.appLE_eq_app (𝟙 Z) (U := ⊤)).trans (Scheme.Hom.id_app (X := Z) ⊤)
    have h2 : u'.appLE ⊤ V hle ≫ s.appLE V ⊤ e = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact key _ _ hs _
    have h3 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)) h2
    simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.comp_apply,
      RingHom.id_apply] at h3
    rw [h3]
    exact (Scheme.ΓSpecIso (.of ↥W)).inv_hom_id_apply c

  have basicOpen_section : ∀ (Y : Scheme.{u}) (s : Spec (.of ↥W) ⟶ Y) (V : Y.Opens)
      (e : ⊤ ≤ s ⁻¹ᵁ V) (g : Γ(Y, V)),
      s (IsLocalRing.closedPoint ↥W) ∈ Y.basicOpen g ↔
        IsUnit ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s.appLE V ⊤ e).hom g)) := by
    intro Y s V e g
    have key := Scheme.basicOpen_appLE s ⊤ V e g
    rw [top_inf_eq] at key
    have H : ∀ x : Spec (.of ↥W), s x ∈ Y.basicOpen g ↔
        x ∈ (Spec (.of ↥W)).basicOpen ((s.appLE V ⊤ e).hom g) := by
      intro x
      rw [key, Scheme.Hom.mem_preimage]
    refine (H (IsLocalRing.closedPoint ↥W)).trans ?_
    rw [basicOpen_eq_of_affine']
    exact (PrimeSpectrum.mem_basicOpen _ _).trans IsLocalRing.notMem_maximalIdeal

  have centre_ideal : ∀ (s : Spec (.of ↥W) ⟶ X), s ≫ uX = 𝟙 _ → ∀ (V : X.Opens)
      (hV : IsAffineOpen V) (hle : V ≤ uX ⁻¹ᵁ ⊤) (e : ⊤ ≤ s ⁻¹ᵁ V) (a : ↥W),
      (s.ker ⊔ wcNcPrincipal (.of ↥W) X uX a).ideal ⟨V, hV⟩ =
        Ideal.comap (((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (s.appLE V ⊤ e).hom)
          (Ideal.span {a}) := by
    intro s hs V hV hle e a
    haveI : QuasiCompact (s ≫ uX) := by rw [hs]; infer_instance
    haveI : QuasiCompact s := QuasiCompact.of_comp s uX
    set θ : Γ(X, V) →+* ↥W :=
      ((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (s.appLE V ⊤ e).hom with hθ
    set φ : ↥W →+* Γ(X, V) :=
      (uX.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom with hφ
    have hθφ : ∀ c, θ (φ c) = c := fun c => theta_phi X uX s hs V hle e c
    have hker : s.ker.ideal ⟨V, hV⟩ = RingHom.ker θ := by
      rw [Scheme.Hom.ker_apply]
      have hρ : Function.Injective ((Spec (.of ↥W)).presheaf.map (homOfLE e).op).hom := by
        apply Function.LeftInverse.injective
          (g := ((Spec (.of ↥W)).presheaf.map (homOfLE (le_top : s ⁻¹ᵁ V ≤ ⊤)).op).hom)
        intro y
        rw [← CommRingCat.comp_apply, ← CategoryTheory.Functor.map_comp]
        have hid : (homOfLE e).op ≫ (homOfLE (le_top : s ⁻¹ᵁ V ≤ ⊤)).op = 𝟙 _ :=
          Quiver.Hom.unop_inj (Subsingleton.elim _ _)
        rw [hid, CategoryTheory.Functor.map_id]
        rfl
      have hh : Function.Injective (Scheme.ΓSpecIso (.of ↥W)).hom.hom :=
        Function.LeftInverse.injective (g := (Scheme.ΓSpecIso (.of ↥W)).inv.hom)
          (fun y => Iso.hom_inv_id_apply _ _)
      have hθ' : θ = (Scheme.ΓSpecIso (.of ↥W)).hom.hom.comp
          (((Spec (.of ↥W)).presheaf.map (homOfLE e).op).hom.comp (s.app V).hom) := rfl
      rw [hθ', RingHom.ker_comp_of_injective _ hh, RingHom.ker_comp_of_injective _ hρ]
    have hprin : (wcNcPrincipal (.of ↥W) X uX a).ideal ⟨V, hV⟩ = Ideal.span {φ a} := by
      unfold wcNcPrincipal
      rw [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton]
      rfl
    rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, hker, hprin]
    apply le_antisymm
    · refine sup_le ?_ ?_
      · intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker.mp hx]
        exact Ideal.zero_mem _
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hθφ]
        exact Ideal.mem_span_singleton_self a
    · intro x hx
      rw [Ideal.mem_comap, Ideal.mem_span_singleton'] at hx
      obtain ⟨c, hc⟩ := hx
      have h1 : x - φ c * φ a ∈ RingHom.ker θ := by
        rw [RingHom.mem_ker, map_sub, map_mul, hθφ, hθφ, hc, sub_self]
      have h2 : φ c * φ a ∈ Ideal.span {φ a} :=
        Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      have h3 := Ideal.add_mem _ (Ideal.mem_sup_left h1) (Ideal.mem_sup_right h2)
      rwa [sub_add_cancel] at h3

  have congr2 : ∀ (Y : Scheme.{u}) (u' : Y ⟶ Spec (.of ↥W)) (s₁ s₂ : Spec (.of ↥W) ⟶ Y),
      s₁ ≫ u' = 𝟙 _ → s₂ ≫ u' = 𝟙 _ →
      s₁ (IsLocalRing.closedPoint ↥W) = s₂ (IsLocalRing.closedPoint ↥W) →
      ∀ (V : Y.Opens) (e₁ : ⊤ ≤ s₁ ⁻¹ᵁ V) (e₂ : ⊤ ≤ s₂ ⁻¹ᵁ V) (g : Γ(Y, V)),
      (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₂.appLE V ⊤ e₂).hom g) -
        (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom g) ∈
        IsLocalRing.maximalIdeal ↥W := by
    intro Y u' s₁ s₂ h₁ h₂ hcp V e₁ e₂ g
    have hle : V ≤ u' ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have k1 := theta_phi Y u' s₁ h₁ V hle e₁
      ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom g))
    have k2 := theta_phi Y u' s₂ h₂ V hle e₂
      ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom g))
    have z1 : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom
        (g - (u'.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom
          ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom g))))) = 0 := by
      rw [map_sub, map_sub, k1, sub_self]
    have z2 : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₂.appLE V ⊤ e₂).hom
        (g - (u'.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom
          ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom g))))) =
        (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₂.appLE V ⊤ e₂).hom g) -
          (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom g) := by
      rw [map_sub, map_sub, k2]
    have n1 : s₁ (IsLocalRing.closedPoint ↥W) ∉ Y.basicOpen
        (g - (u'.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom
          ((Scheme.ΓSpecIso (.of ↥W)).hom.hom ((s₁.appLE V ⊤ e₁).hom g)))) := by
      rw [basicOpen_section Y s₁ V e₁, z1]
      exact not_isUnit_zero
    rw [hcp, basicOpen_section Y s₂ V e₂, z2] at n1
    exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr n1)

  have alg : ∀ (A B : Type u) [CommRing A] [CommRing B] (ρ : A →+* B) (evσ evσ' : A →+* ↥W)
      (evt ev1 : B →+* ↥W) (I : Ideal A) (a β : A),
      (∀ h, evσ h = evt (ρ h)) → (∀ h, evσ' h = ev1 (ρ h)) →
      I = Ideal.comap evσ (Ideal.span {b}) → I = Ideal.comap evσ' (Ideal.span {b}) →
      a ∈ I → Ideal.map ρ I = Ideal.span {ρ a} → evσ β = b → evσ' β = b →
      (∀ g : B, ev1 g - evt g ∈ IsLocalRing.maximalIdeal ↥W) →
      ∀ h ∈ I, ∃ e ∈ IsLocalRing.maximalIdeal ↥W, evσ' h - evσ h = b * e := by
    intro A B _ _ ρ evσ evσ' evt ev1 I a β hf hf' hI hI' haI hmap hβ hβ' hcong h hh
    have ha1 : evσ a ∈ Ideal.span {b} := by rw [hI] at haI; exact haI
    have ha2 : evσ' a ∈ Ideal.span {b} := by rw [hI'] at haI; exact haI
    obtain ⟨ε, hε⟩ := Ideal.mem_span_singleton'.mp ha1
    obtain ⟨ε', hε'⟩ := Ideal.mem_span_singleton'.mp ha2
    have hβI : β ∈ I := by
      rw [hI, Ideal.mem_comap, hβ]; exact Ideal.mem_span_singleton_self b
    have hρβ : ρ β ∈ Ideal.span {ρ a} := by rw [← hmap]; exact Ideal.mem_map_of_mem ρ hβI
    obtain ⟨gβ, hgβ⟩ := Ideal.mem_span_singleton'.mp hρβ
    have Ht : evt gβ * ε = 1 := by
      have e1 : evt gβ * evt (ρ a) = evt (ρ β) := by rw [← map_mul, hgβ]
      rw [← hf, ← hf, hβ, ← hε] at e1
      apply mul_right_cancel₀ hb
      linear_combination e1
    have H1 : ev1 gβ * ε' = 1 := by
      have e1 : ev1 gβ * ev1 (ρ a) = ev1 (ρ β) := by rw [← map_mul, hgβ]
      rw [← hf', ← hf', hβ', ← hε'] at e1
      apply mul_right_cancel₀ hb
      linear_combination e1
    have hρh : ρ h ∈ Ideal.span {ρ a} := by rw [← hmap]; exact Ideal.mem_map_of_mem ρ hh
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hρh
    have E1 : evσ h = evt g * (ε * b) := by rw [hf, ← hg, map_mul, ← hf, ← hε]
    have E2 : evσ' h = ev1 g * (ε' * b) := by rw [hf', ← hg, map_mul, ← hf', ← hε']
    refine ⟨(ev1 g - evt g) * ε' + evt g * ε * ε' * (evt gβ - ev1 gβ), ?_, ?_⟩
    · apply Ideal.add_mem
      · exact Ideal.mul_mem_right _ _ (hcong g)
      · apply Ideal.mul_mem_left
        have := neg_mem (hcong gβ)
        rwa [neg_sub] at this
    · rw [E1, E2]
      linear_combination (-(b * evt g * ε')) * Ht + (b * evt g * ε) * H1

  obtain ⟨U, V, hVU, a, hpV, haI, -, hmap⟩ := hbl.1 (σt (IsLocalRing.closedPoint ↥W))
  have hp1 : σ₁ (IsLocalRing.closedPoint ↥W) ∈ V.1 := heq ▸ hpV
  have hrU : r₁ (σt (IsLocalRing.closedPoint ↥W)) ∈ U.1 := hVU hpV
