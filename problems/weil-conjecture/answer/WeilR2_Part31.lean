      = y := by
    first
      | exact hp₀
      | exact PrimeSpectrum.ext (by rw [← hp₀]; rfl)
  refine ⟨N, θ.inv ≫ Spec.map (CommRingCat.ofHom β), ?_, ?_, ?_, ?_⟩
  · have hey : N.ι (θ.hom p₀) = e y := by
      have h := congrArg (fun f => f p₀) hθ
      calc N.ι (θ.hom p₀) = (θ.hom ≫ N.ι) p₀ := rfl
        _ = (Spec.map (CommRingCat.ofHom (algebraMap (wcEbdQR W a') (Localization.Away u))) ≫
              e) p₀ := h
        _ = e (Spec.map (CommRingCat.ofHom
              (algebraMap (wcEbdQR W a') (Localization.Away u))) p₀) := rfl
        _ = e y := by rw [hιLy]
    rw [← hey]
    exact memN _
  · rw [key]
    exact flat_pre _ _ _ _ _ θ.inv inferInstance hInvφ
  · rw [Category.assoc, hbL, key]
  · intro n hn
    have h1 : (θ.inv ≫
        Spec.map (CommRingCat.ofHom (algebraMap (wcEbdQR W a') (Localization.Away u))) ≫ e) n
        = e y := by
      rw [← hNι]
      exact hn
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    have h2 := e.isOpenEmbedding.injective h1
    rw [Scheme.Hom.comp_apply]
    exact hbLnode _ (by rw [h2]; exact hy0) (by rw [h2]; exact hy1)

theorem wcpa_dj_lr1k_ebd_generic_point : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (c : ↥W), c ∈ IsLocalRing.maximalIdeal ↥W →
    ∀ y : wcEbdQ W c, wcEbdHX W c y = wcEbdSec W 0 (IsLocalRing.closedPoint ↥W) →
      wcEbdQX W c 1 ∈ y.asIdeal →
    ∃ P : wcEbdQ W c, P ⤳ y ∧
      (wcEbdHX W c ≫ wcEbdStr W) P = IsLocalRing.closedPoint ↥W ∧
      wcEbdHX W c P ≠ wcEbdSec W 0 (IsLocalRing.closedPoint ↥W) :=
by
  intro Ω _ W c hc y hy hy1
  classical
  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} with hI
  set κ := IsLocalRing.ResidueField ↥W with hκ
  set ψt : MvPolynomial (Fin 2) ↥W →+* Polynomial κ :=
    MvPolynomial.eval₂Hom (Polynomial.C.comp (IsLocalRing.residue ↥W))
      (fun i => if i = 0 then Polynomial.X else 0) with hψt
  have hres : IsLocalRing.residue ↥W c = 0 := (IsLocalRing.residue_eq_zero_iff c).mpr hc
  have hψtG : ψt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
    simp [hψt, hres]
  have hIker : ∀ a ∈ I, ψt a = 0 := by
    intro a ha
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hψtG, mul_zero]
  set ψ : wcEbdQR W c →+* Polynomial κ := Ideal.Quotient.lift I ψt hIker with hψ
  have hψmk : ∀ F, ψ (Ideal.Quotient.mk I F) = ψt F := fun F => Ideal.Quotient.lift_mk _ _ _

  have hHX : ∀ (z : wcEbdQ W c) (f : MvPolynomial (Fin 1) ↥W),
      f ∈ (wcEbdHX W c z).asIdeal ↔
        Ideal.Quotient.mk I (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin 2)) f) ∈ z.asIdeal := by
    intro z f
    rfl
  have hSec : ∀ f : MvPolynomial (Fin 1) ↥W,
      f ∈ (wcEbdSec W 0 (IsLocalRing.closedPoint ↥W)).asIdeal ↔
        MvPolynomial.eval (fun _ => (0 : ↥W)) f ∈ IsLocalRing.maximalIdeal ↥W := by
    intro f
    rfl
  have hStr : ∀ (z : wcEbdA1 W) (w : ↥W),
      w ∈ (wcEbdStr W z).asIdeal ↔ MvPolynomial.C w ∈ z.asIdeal := by
    intro z w
    rfl
  have hm : ∀ w ∈ IsLocalRing.maximalIdeal ↥W,
      Ideal.Quotient.mk I (MvPolynomial.C w) ∈ y.asIdeal := by
    intro w hw
    have h1 : (MvPolynomial.C w : MvPolynomial (Fin 1) ↥W) ∈ (wcEbdHX W c y).asIdeal := by
      rw [hy, hSec]; simpa using hw
    rw [hHX] at h1
    simpa using h1
  let P : wcEbdQ W c :=
    (⟨RingHom.ker ψ, RingHom.ker_isPrime ψ⟩ : PrimeSpectrum (wcEbdQR W c))
  have hPmem : ∀ f, f ∈ P.asIdeal ↔ ψ f = 0 := fun f => RingHom.mem_ker
  refine ⟨P, ?_, ?_, ?_⟩
  ·
    refine (PrimeSpectrum.le_iff_specializes (R := wcEbdQR W c) P y).mp ?_
    set π := Ideal.Quotient.mk y.asIdeal with hπ
    let ε : ↥W →+* wcEbdQR W c ⧸ y.asIdeal := (π.comp (Ideal.Quotient.mk I)).comp MvPolynomial.C
    have hε : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, ε w = 0 := by
      intro w hw
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hm w hw)
    let εb : κ →+* wcEbdQR W c ⧸ y.asIdeal :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W) ε hε
    have hεb : ∀ w, εb (IsLocalRing.residue ↥W w) = ε w := fun w =>
      Ideal.Quotient.lift_mk _ _ _
    let θ : Polynomial κ →+* wcEbdQR W c ⧸ y.asIdeal :=
      Polynomial.eval₂RingHom εb (π (wcEbdQX W c 0))
    have hcomp : θ.comp ψt = π.comp (Ideal.Quotient.mk I) := by
      apply MvPolynomial.ringHom_ext
      · intro w
        show θ (ψt (MvPolynomial.C w)) = π (Ideal.Quotient.mk I (MvPolynomial.C w))
        rw [hψt, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C, hεb]
        rfl
      · intro i
        fin_cases i
        · show θ (ψt (MvPolynomial.X 0)) = π (Ideal.Quotient.mk I (MvPolynomial.X 0))
          rw [hψt, MvPolynomial.eval₂Hom_X']
          simp only [θ, ite_true, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          rfl
        · show θ (ψt (MvPolynomial.X 1)) = π (Ideal.Quotient.mk I (MvPolynomial.X 1))
          rw [hψt, MvPolynomial.eval₂Hom_X']
          simp only [show (1 : Fin 2) ≠ 0 from by decide, ite_false, map_zero]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr hy1).symm
    intro f hf
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
    have h1 : ψt F = 0 := by rw [← hψmk]; exact (hPmem _).mp hf
    have h2 : π (Ideal.Quotient.mk I F) = 0 := by
      rw [← RingHom.comp_apply, ← hcomp, RingHom.comp_apply, h1, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp h2
  ·
    apply PrimeSpectrum.ext
    ext w
    rw [Scheme.Hom.comp_apply, hStr, hHX, hPmem, MvPolynomial.rename_C, hψmk]
    change _ ↔ w ∈ IsLocalRing.maximalIdeal ↥W
    rw [hψt, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, Polynomial.C_eq_zero,
      IsLocalRing.residue_eq_zero_iff]
  ·
    intro hP
    have h1 : (MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W) ∈ (wcEbdHX W c P).asIdeal := by
      rw [hP, hSec]; simp
    rw [hHX, hPmem, MvPolynomial.rename_X, hψmk, hψt, MvPolynomial.eval₂Hom_X'] at h1
    simp at h1

theorem wcpa_dj_lr1k_eb_ul_domination : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι →
    ∀ (x : ↥X) (w : ↥(Limits.pullback uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
      Limits.pullback.fst uX
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = x →
      wcpaDjLkSmAt W uX w →
    ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W) (σ' : Spec (.of ↥W) ⟶ X) (a' : ↥W),
      wcpaDjLlPair W uX x σ a → wcpaDjLlPair W uX x σ' a' →
      σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a ≤ σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a' →
    ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁),
      wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) r₁ → ι₁ ≫ r₁ = ι →
      wcpaDjLkModel W (r₁ ≫ uX) ι₁ →
    ∀ (X₂ : Scheme.{u}) (r₂ : X₂ ⟶ X) (ι₂ : wcProjK Ω 1 ⟶ X₂),
      wcCsdIsBlowup (σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX a') r₂ → ι₂ ≫ r₂ = ι →
      wcpaDjLkModel W (r₂ ≫ uX) ι₂ →
    ∀ (w₂ : ↥(Limits.pullback (r₂ ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))),
      r₂ (Limits.pullback.fst (r₂ ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₂) = x →
      ¬ wcpaDjLkSmAt W (r₂ ≫ uX) w₂ →
    ∃ (U : X₂.Opens) (g : U.toScheme ⟶ X₁) (ι₂' : wcProjK Ω 1 ⟶ U.toScheme),
      Limits.pullback.fst (r₂ ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₂ ∈ U ∧
      g ≫ r₁ = U.ι ≫ r₂ ∧ ι₂' ≫ U.ι = ι₂ ∧ ι₂' ≫ g = ι₁ ∧
      (∃ z : ↥X₂, z ∈ U ∧
        z ⤳ Limits.pullback.fst (r₂ ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₂ ∧
        (r₂ ≫ uX) z = IsLocalRing.closedPoint ↥W ∧ r₂ z ≠ x) ∧
      ∃ w₁ : ↥(Limits.pullback (r₁ ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        r₁ (Limits.pullback.fst (r₁ ≫ uX)
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₁) = x ∧
        ¬ wcpaDjLkSmAt W (r₁ ≫ uX) w₁ ∧
        ∀ u₂ : ↥U, U.ι u₂ = Limits.pullback.fst (r₂ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₂ →
          g u₂ = Limits.pullback.fst (r₁ ≫ uX)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w₁ :=
