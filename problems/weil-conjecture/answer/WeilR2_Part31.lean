        π (MvPolynomial.X 0 ^ n * P) =
        Polynomial.eval₂ (π.comp MvPolynomial.C) (π (MvPolynomial.X 0)) Q := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C w => exact ⟨0, Polynomial.C w, by simp⟩
      | add p q hp hq =>
        obtain ⟨n, Q, hQ1⟩ := hp
        obtain ⟨n', Q', hQ2⟩ := hq
        refine ⟨n + n', Polynomial.X ^ n' * Q + Polynomial.X ^ n * Q', ?_⟩
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul,
          Polynomial.eval₂_X_pow, Polynomial.eval₂_X_pow, ← hQ1, ← hQ2, ← map_pow, ← map_pow,
          ← map_mul, ← map_mul, ← map_add]
        congr 1
        ring
      | mul_X p i hp =>
        obtain ⟨n, Q, hQ1⟩ := hp
        obtain rfl | rfl : i = 0 ∨ i = 1 := by fin_cases i <;> simp
        · refine ⟨n, Polynomial.X * Q, ?_⟩
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, ← hQ1, ← map_mul]
          congr 1
          ring
