    intro i hi
    rw [Polynomial.C_dvd_iff_dvd_coeff]
    intro s
    by_cases hs : (P i).coeff s = 0
    · rw [hs]; exact dvd_zero α
    · exact hαdiv _ (hmem i hi s hs)
  refine ⟨α, fun i => if h : Polynomial.C α ∣ P i then Classical.choose h else 0, j, t, hα0, hj',
    ?_, ?_⟩
  · intro i hi
    simp only [dif_pos (hdvd i hi)]
    exact Classical.choose_spec (hdvd i hi)
  · have h1 := Classical.choose_spec (hdvd j hj')
    simp only [dif_pos (hdvd j hj')]
    have h2 := congrArg (fun p => Polynomial.coeff p t) h1
    simp only [Polynomial.coeff_C_mul] at h2
    rw [hjt] at h2
    have h3 : (Classical.choose (hdvd j hj')).coeff t = 1 := (mul_eq_left₀ hα0).mp h2.symm
    rw [h3]
    exact isUnit_one

theorem wcpa_dj_lr1k_ebnt_bbd_unit_coeff : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Q : Type u) [CommRing Q] (σ : ↥W →+* Q) (b : ↥W) (f : wcEbntN W b →+* Q), wcEbntPres W σ b f → ∀ (P : Polynomial ↥W) (t : ℕ), IsUnit (P.coeff t) → Polynomial.eval₂ σ (f (wcEbntX W b 0)) P ∉ Ideal.span {f (wcEbntX W b 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map σ :=
