theorem wcpa_dj_lr1k_eb_rd_artin_upper : ∀ (K' L : Type u) [Field K'] [Field L] [Algebra K' L] [FiniteDimensional K' L] (R : Subring K'), Module.Free ↥R ↥(integralClosure ↥R L) → Module.finrank ↥R ↥(integralClosure ↥R L) = Module.finrank K' L → ∀ (r : ℕ) (Vs : Fin r → ValuationSubring L), (∀ i, ((Vs i).comap (algebraMap K' L)).toSubring = R) → (∀ V'' : ValuationSubring L, (V''.comap (algebraMap K' L)).toSubring = R → ∃ i, Vs i = V'') → (∀ i, ∀ x ∈ Vs i, ∃ y : L, (Vs i).valuation (y - x) < 1 ∧ ∀ j, j ≠ i → (Vs j).valuation (y - 1) < 1) → (∀ i, 0 < wcEbBdResDeg K' (Vs i)) → ∀ (i₀ : Fin r) (z : L), (Vs i₀).valuation z < 1 → ∀ k : ℕ, (∀ j, (LinearMap.charpoly (Algebra.lmul K' L z)).coeff j ∈ R) → (LinearMap.charpoly (Algebra.lmul K' L z)).coeff k ≠ 0 → ((LinearMap.charpoly (Algebra.lmul K' L z)).coeff k)⁻¹ ∈ R → wcEbBdResDeg K' (Vs i₀) ≤ k :=
