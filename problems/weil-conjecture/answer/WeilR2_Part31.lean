  have hInvU₀ : wcCsdInvPull I (U₀.1.ι ≫ r₁) := hchartV X₁ r₁ U₀ e₀ tO htOI hT₀ hmapU₀
  obtain ⟨U1m, hU1inv, hU1max, hU1off⟩ := wcpa_dj_lr1k_ebd_invpull_locus X X₁ I r₁
