    (hprime _ _ _ _ hf.2.2.2) Q f hf.2.2.2).1
  haveI : IsIntegrallyClosed Q := (wcNd_hens_normal_domain (wcEbntN W b) _
    (hprime _ _ _ _ hf.2.2.2) Q f hf.2.2.2).2
