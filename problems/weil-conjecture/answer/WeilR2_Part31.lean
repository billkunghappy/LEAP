      have hv : (↑hu.unit⁻¹ : B ⧸ P) * G.coeff 0 = 1 := hu.val_inv_mul
      linear_combination (-(↑hu.unit⁻¹ : B ⧸ P)) * hlin + hv
    exact ⟨exists_pair_ne _, mul_comm, fun hβ => claim _ hβ⟩

  have s1 : ∀ w : ↥W, ¬ IsUnit w →
      ¬ IsUnit (((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.germ ⊤ ξ trivial).hom w) := by
    intro w hw hσ
    apply hw
    have h1 : ξ ∈ X.basicOpen (uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) := by
      rw [Scheme.mem_basicOpen_top]; exact hσ
    rw [← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine] at h1
    have h2 : w ∉ (uX ξ).asIdeal := h1
    rw [hu] at h2
    have h3 : w ∉ IsLocalRing.maximalIdeal ↥W := h2
    exact IsLocalRing.notMem_maximalIdeal.mp h3

  have s3 : ∃ (V : X.Opens) (hV : ξ ∈ V), ¬ (Ideal.comap (X.presheaf.germ V ξ hV).hom
      (IsLocalRing.maximalIdeal (X.presheaf.stalk ξ))).IsMaximal := by
    have hex : ∃ ξ', ξ ⤳ ξ' ∧ ξ' ≠ ξ := by
      by_contra hcon
      push_neg at hcon
      apply hnc
      rw [← closure_subset_iff_isClosed]
      intro y hy
      exact Set.mem_singleton_iff.mpr (hcon y (specializes_iff_mem_closure.mpr hy))
    obtain ⟨ξ', hsp, hne⟩ := hex
    obtain ⟨V, hVa, hξ'V, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := ξ') trivial
    have hV : ξ ∈ V := hsp.mem_open V.isOpen hξ'V
    refine ⟨V, hV, fun hmax => hne ?_⟩
    have hx : (hVa.primeIdealOf ⟨ξ, hV⟩).asIdeal = Ideal.comap (X.presheaf.germ V ξ hV).hom
        (IsLocalRing.maximalIdeal (X.presheaf.stalk ξ)) := by
      rw [hVa.primeIdealOf_eq_map_closedPoint]
      rfl
    obtain ⟨y, hy⟩ : ξ' ∈ Set.range hVa.fromSpec := by rw [hVa.range_fromSpec]; exact hξ'V
    have hfx : hVa.fromSpec (hVa.primeIdealOf ⟨ξ, hV⟩) = ξ := hVa.fromSpec_primeIdealOf ⟨ξ, hV⟩
    have hxy0 : (hVa.primeIdealOf ⟨ξ, hV⟩ : ↥(Spec Γ(X, V))) ⤳ y :=
      (hVa.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp (by rw [hfx, hy]; exact hsp)
    have hxy : (hVa.primeIdealOf ⟨ξ, hV⟩ : PrimeSpectrum Γ(X, V)) ⤳ (y : PrimeSpectrum Γ(X, V)) :=
      hxy0
    have hle : (hVa.primeIdealOf ⟨ξ, hV⟩).asIdeal ≤ (y : PrimeSpectrum Γ(X, V)).asIdeal :=
      (PrimeSpectrum.le_iff_specializes _ _).mpr hxy
    rw [hx] at hle
    have heq : hVa.primeIdealOf ⟨ξ, hV⟩ = (y : PrimeSpectrum Γ(X, V)) :=
      PrimeSpectrum.ext (hx.trans (hmax.eq_of_le (y : PrimeSpectrum Γ(X, V)).isPrime.ne_top hle))
    exact hy.symm.trans ((congrArg hVa.fromSpec heq.symm).trans hfx)

  by_contra hcon
  push_neg at hcon
  obtain ⟨V, hV, hnm⟩ := s3
  have hkey : ∀ w : ↥W, (X.presheaf.germ V ξ hV).hom
      (((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
        X.presheaf.map (homOfLE le_top : V ⟶ ⊤).op).hom w) =
      (((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.germ ⊤ ξ trivial).hom w) := by
    intro w
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  have hkey' : (X.presheaf.germ V ξ hV).hom.comp
      (((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
        X.presheaf.map (homOfLE le_top : V ⟶ ⊤).op).hom) =
      ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫ X.presheaf.germ ⊤ ξ trivial).hom :=
    RingHom.ext hkey
  have hmp : (IsLocalRing.maximalIdeal (X.presheaf.stalk ξ)).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime
  have hPp : (Ideal.comap (X.presheaf.germ V ξ hV).hom
      (IsLocalRing.maximalIdeal (X.presheaf.stalk ξ))).IsPrime :=
    Ideal.comap_isPrime _ _
  refine hnm (s2 ↥W Γ(X, V) (((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
        X.presheaf.map (homOfLE le_top : V ⟶ ⊤).op).hom) _ hPp ?_ ?_)
  · intro w hw
    rw [Ideal.mem_comap, hkey]
    exact (IsLocalRing.mem_maximalIdeal _).mpr (s1 w hw)
  · intro b
    obtain ⟨q, hq, hqn⟩ := hcon ((X.presheaf.germ V ξ hV).hom b)
    refine ⟨q, hq, ?_⟩
    rw [Ideal.mem_comap, Polynomial.hom_eval₂, hkey']
    exact (IsLocalRing.mem_maximalIdeal _).mpr hqn

theorem wcpa_dj_lr1u_vv_kaplansky : ∀ (A K : Type u) [CommRing A] [IsLocalRing A] [Field K] (φ : A →+* K), (∀ k : K, (∃ p : Polynomial A, p.Monic ∧ p.eval₂ φ k = 0) → k ∈ Set.range φ) → ∀ (x : K) (p : Polynomial A), (∃ i, IsUnit (p.coeff i)) → p.eval₂ φ x = 0 → x ∈ Set.range φ ∨ x⁻¹ ∈ Set.range φ :=
by
  intro A K _ _ _ φ hint x
  classical
  suffices H : ∀ n : ℕ, ∀ p : Polynomial A, p.natDegree = n → (∃ i, IsUnit (p.coeff i)) →
      p.eval₂ φ x = 0 → x ∈ Set.range φ ∨ x⁻¹ ∈ Set.range φ by
    intro p hu h0
    exact H _ p rfl hu h0
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro p hn hu h0
  obtain ⟨i, hi⟩ := hu
  by_cases ha : IsUnit p.leadingCoeff
  · left
    apply hint
    refine ⟨Polynomial.C (↑ha.unit⁻¹ : A) * p, ?_, ?_⟩
    · apply Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one
      exact IsUnit.val_inv_mul ha
    · rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, h0, mul_zero]
  · have hp0 : p ≠ 0 := by
      rintro rfl
      exact hi.ne_zero (Polynomial.coeff_zero i)
    have hd : 1 ≤ p.natDegree := by
      by_contra hlt
      have h1 : i ≤ p.natDegree := Polynomial.le_natDegree_of_ne_zero hi.ne_zero
      have h2 : i = p.natDegree := by omega
      apply ha
      rw [Polynomial.leadingCoeff, ← h2]
      exact hi
    obtain ⟨b, hb⟩ := hint (φ p.leadingCoeff * x)
      ⟨p.integralNormalization, Polynomial.monic_integralNormalization hp0, by
        rw [Polynomial.integralNormalization_eval₂_leadingCoeff_mul hd, h0, mul_zero]⟩
    by_cases hbu : IsUnit b
    · right
      refine ⟨p.leadingCoeff * ↑hbu.unit⁻¹, ?_⟩
      symm
      apply inv_eq_of_mul_eq_one_right
      rw [map_mul]
      calc x * (φ p.leadingCoeff * φ ↑hbu.unit⁻¹)
          = (φ p.leadingCoeff * x) * φ ↑hbu.unit⁻¹ := by ring
        _ = 1 := by rw [← hb, ← map_mul, IsUnit.mul_val_inv, map_one]
    · obtain ⟨e, he⟩ : ∃ e, p.natDegree = e + 1 := ⟨p.natDegree - 1, by omega⟩
      set q := p.eraseLead + Polynomial.C b * Polynomial.X ^ e with hq
      have hqdeg : q.natDegree < n := by
        have : q.natDegree ≤ e :=
          Polynomial.natDegree_add_le_of_degree_le
            (le_trans p.eraseLead_natDegree_le (by omega))
            (Polynomial.natDegree_C_mul_X_pow_le b e)
        omega
      have hpev : p.eval₂ φ x = p.eraseLead.eval₂ φ x + φ p.leadingCoeff * x ^ p.natDegree := by
        conv_lhs => rw [← p.eraseLead_add_C_mul_X_pow]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_X_pow]
      have hqev : q.eval₂ φ x = 0 := by
        rw [← h0, hpev, hq, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_X_pow, hb, he, pow_succ]
        ring
      have hqu : ∃ j, IsUnit (q.coeff j) := by
        have hin : i ≠ p.natDegree := by
          rintro rfl
          exact ha hi
        refine ⟨i, ?_⟩
        rw [hq, Polynomial.coeff_add, Polynomial.eraseLead_coeff_of_ne i hin,
          Polynomial.coeff_C_mul_X_pow]
        split_ifs with hie
        · by_contra hnu
          have hnb : -b ∈ nonunits A := fun h => hbu (by simpa using h.neg)
          have h3 := IsLocalRing.nonunits_add hnu hnb
          apply h3
          simpa using hi
        · simpa using hi
      exact ih _ hqdeg q rfl hqu hqev

theorem wcpa_dj_lr1u_vv_alg_dep : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (s f : (wcProjK Ω 1).functionField), (∀ q : Polynomial ↥W, (∃ i, IsUnit (q.coeff i)) → q.eval₂ ((wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype) s ≠ 0) → ∃ (H : Polynomial (Polynomial ↥W)) (j k : ℕ), (H.coeff j).coeff k = 1 ∧ H.eval₂ (Polynomial.eval₂RingHom ((wcLr1uConst (wcProjKStr Ω 1)).comp W.subtype) s) f = 0 :=
by
  intro Ω _ W _ s f _hs
  classical

  have dep : ∀ (k K : Type u) [Field k] [Field K] (c : k →+* K) (n : ℕ) (t : Fin n → K),
      n ≤ 1 → (letI : Algebra k K := c.toAlgebra; IsTranscendenceBasis k t) → ∀ (s f : K),
      ∃ G : MvPolynomial (Fin 2) k, G ≠ 0 ∧ MvPolynomial.eval₂ c ![s, f] G = 0 := by
    intro k K _ _ c n t hn ht s f
    letI : Algebra k K := c.toAlgebra
    by_contra hcon
    push_neg at hcon
    have hind : AlgebraicIndependent k ![s, f] := by
      rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero]
      intro G hG
      by_contra h0
      exact hcon G h0 hG
    have h1 := hind.lift_cardinalMk_le_trdeg
    have h2 := ht.lift_cardinalMk_eq_trdeg
    rw [← h2] at h1
    simp only [Cardinal.mk_fin, Cardinal.lift_natCast] at h1
    have : 2 ≤ n := by exact_mod_cast h1
    omega

  have norm : ∀ (K : Type u) [Field K] (c : Ω →+* K) (s f : K)
      (G : MvPolynomial (Fin 2) Ω), G ≠ 0 → MvPolynomial.eval₂ c ![s, f] G = 0 →
      ∃ (H : Polynomial (Polynomial ↥W)) (j k : ℕ), (H.coeff j).coeff k = 1 ∧
        H.eval₂ (Polynomial.eval₂RingHom (c.comp W.subtype) s) f = 0 := by
    intro K _ c s f G hG0 hG
    have hne : G.support.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty, Ne, MvPolynomial.support_eq_empty]; exact hG0
    obtain ⟨dm, hdm, hmax⟩ :=
      Finset.exists_max_image G.support (fun d => W.valuation (G.coeff d)) hne
    have ha0 : G.coeff dm ≠ 0 := MvPolynomial.mem_support_iff.mp hdm
    have hva : 0 < W.valuation (G.coeff dm) := (Valuation.pos_iff _).mpr ha0
    have hmem : ∀ d, G.coeff d / G.coeff dm ∈ W := by
      intro d
      by_cases hd : G.coeff d = 0
      · rw [hd, zero_div]; exact W.zero_mem
      · rw [← W.valuation_le_one_iff, Valuation.map_div]
        exact (div_le_one₀ hva).mpr (hmax d (MvPolynomial.mem_support_iff.mpr hd))
    let w : (Fin 2 →₀ ℕ) → W := fun d => ⟨G.coeff d / G.coeff dm, hmem d⟩
    refine ⟨∑ d ∈ G.support, Polynomial.C (Polynomial.C (w d) * Polynomial.X ^ (d 0)) *
      Polynomial.X ^ (d 1), dm 1, dm 0, ?_, ?_⟩
    · rw [Polynomial.finset_sum_coeff, Polynomial.finset_sum_coeff,
        Finset.sum_eq_single_of_mem dm hdm]
      · rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl, Polynomial.coeff_C_mul_X_pow, if_pos rfl]
        apply Subtype.ext
        simp [w, ha0]
      · intro d _ hne
        rw [Polynomial.coeff_C_mul_X_pow]
        split_ifs with h1
        · rw [Polynomial.coeff_C_mul_X_pow, if_neg]
          intro h0
          apply hne
          ext i
          fin_cases i
          · exact h0.symm
          · exact h1.symm
        · simp
    · rw [Polynomial.eval₂_finset_sum]
      rw [MvPolynomial.eval₂_eq'] at hG
      simp only [Fin.prod_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] at hG
      have key : ∀ d ∈ G.support,
          Polynomial.eval₂ (Polynomial.eval₂RingHom (c.comp W.subtype) s) f
          (Polynomial.C (Polynomial.C (w d) * Polynomial.X ^ (d 0)) * Polynomial.X ^ (d 1)) =
          (c (G.coeff dm))⁻¹ * (c (G.coeff d) * (s ^ d 0 * f ^ d 1)) := by
        intro d _
        simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow,
          Polynomial.coe_eval₂RingHom, RingHom.comp_apply, ValuationSubring.coe_subtype, w]
        rw [map_div₀]
        ring
      rw [Finset.sum_congr rfl key, ← Finset.mul_sum, hG, mul_zero]

  haveI : IsProper (wcProjKStr Ω 1) := wc_proj_space_isProper Ω 1
  obtain ⟨-, n, t, ht, hdim⟩ :=
    wcpa_dj_cf_sp_function_field_trdeg Ω (wcProjK Ω 1) (wcProjKStr Ω 1)
  have hn : n ≤ 1 := by
    have h1 := wc_proj_space_dim Ω 1
    rw [h1] at hdim
    have : (1 : ℕ) = n := by exact_mod_cast hdim
    omega
  obtain ⟨G, hG0, hG⟩ := dep Ω (wcProjK Ω 1).functionField (wcLr1uConst (wcProjKStr Ω 1)) n t
    hn ht s f
  exact norm (wcProjK Ω 1).functionField (wcLr1uConst (wcProjKStr Ω 1)) s f G hG0 hG

theorem wcpa_dj_lr1u_vertex_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjSemistable uX → (∃ (N : ℕ) (j : X ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uX) → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → ∀ (ξ : X) (hξ : ι (genericPoint (wcProjK Ω 1)) ⤳ ξ), uX ξ = IsLocalRing.closedPoint ↥W → ¬ IsClosed ({ξ} : Set X) → ∃ V : ValuationSubring (wcProjK Ω 1).functionField, (V : Set (wcProjK Ω 1).functionField) = Set.range ⇑(wcLr1uGerm ι ξ hξ).hom :=
by
