    Infinite (IsLocalRing.ResidueField ↥W) → ∀ (N : ℕ) (y : ℕ → ↥W), (∃ k ≤ N, IsUnit (y k)) →
    ∃ lam : ↥W, IsUnit lam ∧ IsUnit (1 + lam) ∧
      IsUnit (∑ k ∈ Finset.range (N + 1), (-1) ^ k * lam ^ (N - k) * y k) := by
  intro Ω _ W hinf N y hy
  classical
  let φ : Polynomial (IsLocalRing.ResidueField ↥W) := ∑ k ∈ Finset.range (N + 1),
    Polynomial.C ((-1) ^ k * IsLocalRing.residue ↥W (y k)) * Polynomial.X ^ (N - k)
  have hφ : φ ≠ 0 := by
    obtain ⟨k0, hk0, hu⟩ := hy
    intro h0
    have hc := congrArg (fun p => Polynomial.coeff p (N - k0)) h0
    simp only [φ, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow,
