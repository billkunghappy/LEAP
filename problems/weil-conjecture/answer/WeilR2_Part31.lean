theorem wcpa_dj_p1g_cf_fibre_stalk : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u}) (g : X ⟶ Spec (.of R)), (∀ x : X, g x = IsLocalRing.closedPoint R → ∃ w : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))), Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) w = x) ∧ ∀ w : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))), g (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) w) = IsLocalRing.closedPoint R ∧ Function.Surjective ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))).stalkMap w).hom ∧ RingHom.ker ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))).stalkMap w).hom = Ideal.map ((Scheme.ΓSpecIso (.of R)).inv ≫ g.appTop ≫ X.presheaf.germ ⊤ (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) w) trivial).hom (IsLocalRing.maximalIdeal R) :=
by
  intro R _ _ X g

  have PB : ∀ {T Z L Y : Scheme.{u}} (p : T ⟶ Z) (f : T ⟶ L) (h : Z ⟶ Y)
      (lam : L ⟶ Y), IsPullback p f h lam → IsClosedImmersion lam →
      ∀ (ξ : T) (t : L) (ht : f ξ = t) (e : h (p ξ) = lam t),
        Function.Surjective (p.stalkMap ξ).hom ∧
