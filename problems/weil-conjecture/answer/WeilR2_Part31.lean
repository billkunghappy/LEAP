    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext U
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]
  have htop : ∀ (X : Scheme.{u}) [IsAffine X] (I : Ideal Γ(X, ⊤)),
      (Scheme.IdealSheafData.ofIdealTop I).ideal ⟨⊤, isAffineOpen_top X⟩ = I := by
    intro X _ I
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    convert Ideal.map_id I
    rw [show (homOfLE _ : (⊤ : X.Opens) ⟶ ⊤) = 𝟙 _ from Subsingleton.elim _ _]
    simp
  have hbr : ∀ (X T : Scheme.{u}) (h : T ⟶ X) (e : (⊤ : T.Opens) ≤ h ⁻¹ᵁ ⊤),
      h.appLE ⊤ ⊤ e = h.appTop := by
    intro X T h e
    exact (Scheme.Hom.app_eq_appLE h).symm
  have hJ : wcEbdJ W (b * d) = Scheme.IdealSheafData.ofIdealTop
      (Ideal.span {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)} ⊔
        Ideal.span {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.C (b * d))}) := by
    dsimp only [wcEbdJ, wcEbdSec, wcEbdStr, wcEbdA1]
    rw [hkerSpec (MvPolynomial (Fin 1) ↥W) ↥W _ _ hker0, hprinc, hsup]

  obtain ⟨v, huv⟩ : ∃ v : ↥W, u₀ * v = 1 := ⟨_, hu.mul_val_inv⟩
  have hxy : (b * u₀) * (d * v) = b * d := by
    calc (b * u₀) * (d * v) = (b * d) * (u₀ * v) := by ring
      _ = b * d := by rw [huv, mul_one]
  have hx0 : b * u₀ ≠ 0 := mul_ne_zero hb0 hu.ne_zero

  obtain ⟨ψt, hψtC, hψtX0, hψtX1⟩ : ∃ ψt : MvPolynomial (Fin 2) ↥W →+* ↥W,
      (∀ r : ↥W, ψt (MvPolynomial.C r) = r) ∧ ψt (MvPolynomial.X 0) = b * u₀ ∧
        ψt (MvPolynomial.X 1) = d * v :=
    ⟨MvPolynomial.eval ![b * u₀, d * v], fun r => MvPolynomial.eval_C r,
      by simp [MvPolynomial.eval_X], by simp [MvPolynomial.eval_X]⟩
  have hwd : ∀ p ∈ Ideal.span
      {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (b * d) : MvPolynomial (Fin 2) ↥W)},
      ψt p = 0 := by
    intro p hp
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    rw [map_mul, map_sub, map_mul, hψtX0, hψtX1, hψtC, hxy, sub_self, mul_zero]
  obtain ⟨ψ, hψ⟩ : ∃ ψ : wcEbdQR W (b * d) →+* ↥W, ∀ p,
      ψ (Ideal.Quotient.mk (Ideal.span
        {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (b * d) :
          MvPolynomial (Fin 2) ↥W)}) p) = ψt p :=
    ⟨Ideal.Quotient.lift _ ψt hwd, fun p => Ideal.Quotient.lift_mk _ _ _⟩
  have hψS : Spec.map (CommRingCat.ofHom ψ) ≫ wcEbdHX W (b * d) = wcEbdSec W (b * u₀) := by
    dsimp only [wcEbdHX, wcEbdSec]
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.eval_C]
      show ψ (Ideal.Quotient.mk _ (MvPolynomial.rename _ (MvPolynomial.C r))) = _
      rw [MvPolynomial.rename_C, hψ, hψtC]
    · intro i
      rw [Fin.fin_one_eq_zero i]
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.eval_X]
      show ψ (Ideal.Quotient.mk _ (MvPolynomial.rename _ (MvPolynomial.X 0))) = _
      rw [MvPolynomial.rename_X, hψ, hψtX0]

  have hev : ∀ p : MvPolynomial (Fin 1) ↥W,
      (wcEbdSec W (b * u₀)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p) =
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom (MvPolynomial.eval (fun _ : Fin 1 => b * u₀) p) := by
    intro p
    have := congrArg (fun g => g.hom p) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => b * u₀))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    exact this.symm
  have hInv : wcCsdInvPull (wcEbdJ W (b * d)) (wcEbdSec W (b * u₀)) := by
    rw [hJ]
    intro t'
    have hle : (⊤ : (Spec (.of ↥W)).Opens) ≤ (wcEbdSec W (b * u₀)) ⁻¹ᵁ ⊤ := by
      simp
    refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, hle,
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), trivial,
      ?_, ?_, ?_⟩
    · rw [htop]
      exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
    · dsimp only
      rw [hbr, hev]
      simp only [MvPolynomial.eval_X]
      exact nzd_iso _ _ (mem_nonZeroDivisors_of_ne_zero hx0)
    · dsimp only
      rw [hbr, htop, Ideal.map_sup, Ideal.map_span, Ideal.map_span,
        Set.image_singleton, Set.image_singleton, hev, hev]
      simp only [MvPolynomial.eval_X, MvPolynomial.eval_C]
      refine sup_eq_left.mpr (Ideal.span_singleton_le_span_singleton.mpr
        ⟨(Scheme.ΓSpecIso (.of ↥W)).inv.hom (d * v), ?_⟩)
      rw [← map_mul, hxy]

  have h₁ : (Spec.map (CommRingCat.ofHom ψ) ≫ e) ≫ r₀ = wcEbdSec W (b * u₀) := by
    rw [Category.assoc, her, hψS]
  have hleq : l = Spec.map (CommRingCat.ofHom ψ) ≫ e := (hbl.2 _ _ hInv).unique hl h₁
  refine ⟨Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint ↥W), ?_, ?_, ?_⟩
  · rw [hleq]
    first
      | exact Scheme.Hom.comp_apply _ _ _
      | rfl
  · change ψ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∈ (IsLocalRing.closedPoint ↥W).asIdeal
    rw [hψ, hψtX0]
    exact Ideal.mul_mem_right _ _ hbm
  · change ψ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∈ (IsLocalRing.closedPoint ↥W).asIdeal
    rw [hψ, hψtX1]
    exact Ideal.mul_mem_right _ _ hdm

theorem wcpa_dj_lr1k_ebc_cgr_node_image : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
