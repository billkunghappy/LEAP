theorem wcpa_dj_lr1k_eb_bnc_ring_iso : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W), a ≠ 0 → ∃ e : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ≃+* ↥(wcEbRing W a), (e : (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* ↥(wcEbRing W a)).comp (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp MvPolynomial.C) (fun _ : Fin 1 => Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 0))) = wcEbCdRho W a ∧ Ideal.map e (Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 0), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))) = wcEbNode W a :=
by
  intro Ω _ W a ha0
  classical
  set I : Ideal (MvPolynomial (Fin 2) ↥W) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a} with hIdef
  have hT : RatFunc.X ∈ wcEbRing W a := Subring.subset_closure (Or.inr (Set.mem_insert _ _))
  have hU : algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹ ∈ wcEbRing W a :=
    Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))
  let tT : ↥(wcEbRing W a) := ⟨RatFunc.X, hT⟩
  let tU : ↥(wcEbRing W a) := ⟨algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹, hU⟩
  let ψ : MvPolynomial (Fin 2) ↥W →+* ↥(wcEbRing W a) :=
    MvPolynomial.eval₂Hom (wcEbW W a) ![tT, tU]
  have hψC : ∀ w, ψ (MvPolynomial.C w) = wcEbW W a w := fun w => MvPolynomial.eval₂Hom_C _ _ _
  have hψX0 : ψ (MvPolynomial.X 0) = tT := by simp [ψ]
  have hψX1 : ψ (MvPolynomial.X 1) = tU := by simp [ψ]

  have hψI : ∀ p ∈ I, ψ p = 0 := by
    intro p hp
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    have hF : ψ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 := by
      rw [map_sub, map_mul, hψX0, hψX1, hψC]
      apply Subtype.ext
      show RatFunc.X * (algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹) -
        algebraMap Ω (RatFunc Ω) (a : Ω) = 0
      rw [mul_left_comm, mul_inv_cancel₀ RatFunc.X_ne_zero, mul_one, sub_self]
    rw [map_mul, hF, mul_zero]
  let ψb : MvPolynomial (Fin 2) ↥W ⧸ I →+* ↥(wcEbRing W a) := Ideal.Quotient.lift I ψ hψI
  have hψb : ∀ f, ψb (Ideal.Quotient.mk I f) = ψ f := fun f => Ideal.Quotient.lift_mk _ _ _

  have hAnzd : ∀ y : MvPolynomial (Fin 2) ↥W ⧸ I,
      y * Ideal.Quotient.mk I (MvPolynomial.X 0) = 0 → y = 0 := by
    intro y hy
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨σ₀, hσ0, hσ1, hσC⟩ : ∃ σ₀ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W,
        σ₀ (MvPolynomial.X 0) = 0 ∧ σ₀ (MvPolynomial.X 1) = MvPolynomial.X 1 ∧
        ∀ r, σ₀ (MvPolynomial.C r) = MvPolynomial.C r :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 1], by simp, by simp, by simp⟩
    have hdvd : ∀ f : MvPolynomial (Fin 2) ↥W, MvPolynomial.X 0 ∣ f - σ₀ f := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C r => rw [hσC, sub_self]; exact dvd_zero _
      | add f g hf hg => rw [map_add, add_sub_add_comm]; exact dvd_add hf hg
      | mul_X f n hf =>
        rw [map_mul]
        have e : f * MvPolynomial.X n - σ₀ f * σ₀ (MvPolynomial.X n) =
            (f - σ₀ f) * MvPolynomial.X n + σ₀ f * (MvPolynomial.X n - σ₀ (MvPolynomial.X n)) := by
          ring
        rw [e]
        refine dvd_add (dvd_mul_of_dvd_left hf _) (dvd_mul_of_dvd_right ?_ _)
        fin_cases n
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 0 - σ₀ (MvPolynomial.X 0)
          rw [hσ0, sub_zero]
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 1 - σ₀ (MvPolynomial.X 1)
          rw [hσ1, sub_self]; exact dvd_zero _
    have hσg : σ₀ g = 0 := by
      have h1 := congrArg σ₀ hg
      simp only [map_mul, map_sub, hσ0, hσ1, hσC] at h1
      have h2 : σ₀ g * MvPolynomial.C a = 0 := by linear_combination -h1
      exact (mul_eq_zero.mp h2).resolve_right (fun hc' => ha0 (MvPolynomial.C_eq_zero.mp hc'))
    obtain ⟨g', hg'⟩ := hdvd g
    rw [hσg, sub_zero] at hg'
    have hp : p * MvPolynomial.X 0 =
        (g' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a)) * MvPolynomial.X 0 := by
      rw [← hg, hg']; ring
    have hp' := mul_right_cancel₀ (MvPolynomial.X_ne_zero 0) hp
    rw [Ideal.Quotient.eq_zero_iff_mem, hp']
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  have hNnzd : ∀ (N : ℕ) (y : MvPolynomial (Fin 2) ↥W ⧸ I),
      y * Ideal.Quotient.mk I (MvPolynomial.X 0) ^ N = 0 → y = 0 := by
    intro N
    induction N with
    | zero => intro y hy; simpa using hy
    | succ N ih =>
      intro y hy
      apply ih
      apply hAnzd
      rw [mul_assoc, ← pow_succ]
      exact hy

  have hAB : Ideal.Quotient.mk I (MvPolynomial.X 0) * Ideal.Quotient.mk I (MvPolynomial.X 1) =
      Ideal.Quotient.mk I (MvPolynomial.C a) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  let ι : Polynomial ↥W →+* MvPolynomial (Fin 2) ↥W :=
    Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
  have hιC : ∀ r, ι (Polynomial.C r) = MvPolynomial.C r := fun r => Polynomial.eval₂_C _ _
  have hιX : ι Polynomial.X = MvPolynomial.X 0 := Polynomial.eval₂_X _ _
  have hnf : ∀ f : MvPolynomial (Fin 2) ↥W, ∃ (N : ℕ) (g : Polynomial ↥W),
      Ideal.Quotient.mk I (MvPolynomial.X 0) ^ N * Ideal.Quotient.mk I f =
        Ideal.Quotient.mk I (ι g) := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C r => exact ⟨0, Polynomial.C r, by rw [pow_zero, one_mul, hιC]⟩
    | add p q hp hq =>
      obtain ⟨N, g, hg⟩ := hp
      obtain ⟨N', g', hg'⟩ := hq
      refine ⟨N + N', Polynomial.X ^ N' * g + Polynomial.X ^ N * g', ?_⟩
      simp only [map_add, map_mul, map_pow, hιX]
      rw [← hg, ← hg']
      ring
    | mul_X p n hp =>
      obtain ⟨N, g, hg⟩ := hp
      fin_cases n
      · refine ⟨N, Polynomial.X * g, ?_⟩
        show Ideal.Quotient.mk I (MvPolynomial.X 0) ^ N * Ideal.Quotient.mk I (p * MvPolynomial.X 0) =
          Ideal.Quotient.mk I (ι (Polynomial.X * g))
        simp only [map_mul, hιX]
        rw [← hg]
        ring
      · refine ⟨N + 1, Polynomial.C a * g, ?_⟩
        show Ideal.Quotient.mk I (MvPolynomial.X 0) ^ (N + 1) *
          Ideal.Quotient.mk I (p * MvPolynomial.X 1) =
          Ideal.Quotient.mk I (ι (Polynomial.C a * g))
        simp only [map_mul, hιC]
        rw [← hg, ← hAB]
        ring

  have hline : ∀ g : Polynomial ↥W, ψ (ι g) = 0 → g = 0 := by
    have hcomp : ((wcEbRing W a).subtype.comp ψ).comp ι =
        (algebraMap (Polynomial Ω) (RatFunc Ω)).comp (Polynomial.mapRingHom W.subtype) := by
      apply Polynomial.ringHom_ext
      · intro w
        simp only [RingHom.comp_apply]
        rw [hιC, hψC, Polynomial.coe_mapRingHom, Polynomial.map_C, RatFunc.algebraMap_C,
          ← RatFunc.algebraMap_eq_C]
        rfl
      · simp only [RingHom.comp_apply]
        rw [hιX, hψX0, Polynomial.coe_mapRingHom, Polynomial.map_X, RatFunc.algebraMap_X]
        rfl
    intro g hg
    have h1 : (algebraMap (Polynomial Ω) (RatFunc Ω)) (Polynomial.map W.subtype g) = 0 := by
      have := congrArg (fun φ => φ g) hcomp
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom] at this
      rw [← this, hg, map_zero]
    have h2 := (RatFunc.algebraMap_injective Ω) (h1.trans (map_zero _).symm)
    exact (Polynomial.map_eq_zero_iff (fun x y h => Subtype.ext h)).mp h2

  have hsurj : Function.Surjective ψ := by
    intro y
    obtain ⟨y, hy⟩ := y
    have key : ∀ z, z ∈ wcEbRing W a → ∃ f, ((ψ f : ↥(wcEbRing W a)) : RatFunc Ω) = z := by
      intro z hz
      have hz' : z ∈ Subring.closure ((Set.range fun w : ↥W => algebraMap Ω (RatFunc Ω) (w : Ω)) ∪
          {RatFunc.X, algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹}) := hz
      clear hz
      induction hz' using Subring.closure_induction with
      | mem x hx =>
        rcases hx with ⟨w, rfl⟩ | hx
        · exact ⟨MvPolynomial.C w, by rw [hψC]; rfl⟩
        · rcases hx with rfl | rfl
          · exact ⟨MvPolynomial.X 0, by rw [hψX0]⟩
          · exact ⟨MvPolynomial.X 1, by rw [hψX1]⟩
      | zero => exact ⟨0, by rw [map_zero]; rfl⟩
      | one => exact ⟨1, by rw [map_one]; rfl⟩
      | add x y _ _ hx hy =>
        obtain ⟨f, hf⟩ := hx
        obtain ⟨f', hf'⟩ := hy
        exact ⟨f + f', by rw [map_add, Subring.coe_add, hf, hf']⟩
      | neg x _ hx =>
        obtain ⟨f, hf⟩ := hx
        exact ⟨-f, by rw [map_neg, Subring.coe_neg, hf]⟩
      | mul x y _ _ hx hy =>
        obtain ⟨f, hf⟩ := hx
        obtain ⟨f', hf'⟩ := hy
        exact ⟨f * f', by rw [map_mul, Subring.coe_mul, hf, hf']⟩
    obtain ⟨f, hf⟩ := key y hy
    exact ⟨f, Subtype.ext hf⟩

  have hinj : Function.Injective ψb := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [hψb] at hz
    obtain ⟨N, g, hg⟩ := hnf f
    have hg0 : g = 0 := by
      apply hline
      rw [← hψb, ← hg, map_mul, map_pow, hψb, hψb, hz, mul_zero]
    apply hNnzd N
    rw [mul_comm (Ideal.Quotient.mk I f), hg, hg0, map_zero, map_zero]
  have hsurjb : Function.Surjective ψb := by
    intro y
    obtain ⟨f, hf⟩ := hsurj y
    exact ⟨Ideal.Quotient.mk I f, (hψb f).trans hf⟩
  let e : (MvPolynomial (Fin 2) ↥W ⧸ I) ≃+* ↥(wcEbRing W a) :=
    RingEquiv.ofBijective ψb ⟨hinj, hsurjb⟩
  have he : ∀ f, e (Ideal.Quotient.mk I f) = ψ f := fun f => hψb f
  refine ⟨e, ?_, ?_⟩
  · apply MvPolynomial.ringHom_ext
    · intro w
      show e (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
        (fun _ : Fin 1 => Ideal.Quotient.mk I (MvPolynomial.X 0)) (MvPolynomial.C w)) =
        wcEbCdRho W a (MvPolynomial.C w)
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, he, hψC, wcEbCdRho, MvPolynomial.eval₂Hom_C]
    · intro i
      show e (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp MvPolynomial.C)
        (fun _ : Fin 1 => Ideal.Quotient.mk I (MvPolynomial.X 0)) (MvPolynomial.X i)) =
        wcEbCdRho W a (MvPolynomial.X i)
      rw [MvPolynomial.eval₂Hom_X', he, hψX0, wcEbCdRho, MvPolynomial.eval₂Hom_X']
  · have hcomp2 : (e : (MvPolynomial (Fin 2) ↥W ⧸ I) →+* ↥(wcEbRing W a)).comp
        (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I)) = wcEbW W a := by
      apply RingHom.ext
      intro w
      show e (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I) w) = wcEbW W a w
      rw [show algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I) w =
        Ideal.Quotient.mk I (MvPolynomial.C w) from rfl, he, hψC]
    have hm : Ideal.map e (Ideal.map (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I))
        (IsLocalRing.maximalIdeal ↥W)) = Ideal.map (wcEbW W a) (IsLocalRing.maximalIdeal ↥W) := by
      rw [← hcomp2, ← Ideal.map_map]
      rfl
    rw [Ideal.map_sup, Ideal.map_span, Set.image_pair, he, he, hψX0, hψX1, hm]
    rfl

theorem wcpa_dj_lr1k_eb_bnc_model_chart : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W), a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), wcCsdIsBlowup (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔ wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a) r₀ → ∃ c₀ : Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) ⟶ M', IsOpenImmersion c₀ ∧ c₀ ≫ r₀ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp MvPolynomial.C) (fun _ : Fin 1 => Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 0)))) ∧ ∀ y : M', Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) (r₀ y) = IsLocalRing.closedPoint ↥W → (∃ V : M'.Opens, y ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))) ∨ ∃ p, c₀ p = y ∧ PrimeSpectrum.asIdeal p = Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 0), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) (MvPolynomial.X 1)} ⊔ (IsLocalRing.maximalIdeal ↥W).map (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})) :=
by
  intro Ω _ W a ha0 _ham M' r₀ hr₀
  classical
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h e x
    rw [← Scheme.Hom.comp_apply, e]

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f a = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self a
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2
  have hprinc : wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) a =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a)}) := by
    unfold wcNcPrincipal
    have := congrArg (fun g => g.hom a) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    rw [this]
  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro X I J
    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext V
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
