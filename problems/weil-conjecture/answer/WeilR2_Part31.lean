    let ρ : Polynomial A →+* IsLocalRing.ResidueField A :=
      (IsLocalRing.residue A).comp (Polynomial.evalRingHom 0)
    have hρs : Function.Surjective ρ := by
      intro t
      obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective t
      exact ⟨Polynomial.C r, by simp [ρ]⟩
    have hker : RingHom.ker ρ = Ideal.span {Polynomial.X} ⊔
        Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A) := by
      apply le_antisymm
      · intro p hp
        rw [RingHom.mem_ker] at hp
        have h0 : p.coeff 0 ∈ IsLocalRing.maximalIdeal A := by
          rw [Polynomial.coeff_zero_eq_eval_zero, ← IsLocalRing.residue_eq_zero_iff]
          simpa [ρ] using hp
        rw [← Polynomial.X_mul_divX_add p]
        refine Ideal.add_mem _ ?_ ?_
        · apply Ideal.mem_sup_left
          rw [mul_comm]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        · exact Ideal.mem_sup_right (Ideal.mem_map_of_mem _ h0)
      · apply sup_le
        · rw [Ideal.span_le]
          intro p hp
          rw [Set.mem_singleton_iff] at hp
          subst hp
          simp [ρ]
        · rw [Ideal.map_le_iff_le_comap]
          intro r hr
          simp only [Ideal.mem_comap, RingHom.mem_ker, ρ, RingHom.comp_apply,
            Polynomial.coe_evalRingHom, Polynomial.eval_C]
          exact (IsLocalRing.residue_eq_zero_iff r).mpr hr
    have hmax : (Ideal.span {Polynomial.X} ⊔
        Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A)).IsMaximal := by
      rw [← hker]
      exact RingHom.ker_isMaximal_of_surjective ρ hρs
    symm
    apply hmax.eq_of_le
    · exact (Ideal.comap_isPrime ε 𝔮).ne_top
    · apply sup_le
      · rw [Ideal.span_le]
        intro p hp
        rw [Set.mem_singleton_iff] at hp
        subst hp
        exact hεX
      · rw [Ideal.map_le_iff_le_comap]
        intro r hr
        rw [Ideal.mem_comap, Ideal.mem_comap, ← RingHom.comp_apply, hεC, ← Ideal.mem_comap,
          hcomap]
        exact hr

  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  haveI hνfin : IsFinite (γ ≫ ι).fromNormalization :=
