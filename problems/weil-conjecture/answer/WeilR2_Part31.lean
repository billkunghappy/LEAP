      { carrier := {Q | O.valuation ((Q.coeff 0 : ↥O.toSubring) : K') < 1}
        add_mem' := by
          intro a b ha hb
          simp only [Set.mem_ofPred_eq, Polynomial.coeff_add, Subring.coe_add] at *
          exact Valuation.map_add_lt _ ha hb
        zero_mem' := by simp
        smul_mem' := by
          intro c Q hQ
          simp only [Set.mem_ofPred_eq, smul_eq_mul, Polynomial.mul_coeff_zero, Subring.coe_mul,
            map_mul] at *
          rw [mul_comm]
          exact mul_lt_one_of_lt_of_le hQ ((O.valuation_le_one_iff _).mpr (c.coeff 0).2) }
    have hJ : ∀ Q : Polynomial ↥O.toSubring,
        Q ∈ J ↔ O.valuation ((Q.coeff 0 : ↥O.toSubring) : K') < 1 := fun Q => Iff.rfl
    let I : Ideal ↥A := J.map ψ
    have hI : I ≠ ⊤ := by
      intro htop
      have h1 : (1 : ↥A) ∈ I := htop ▸ Submodule.mem_top
      obtain ⟨Q, hQJ, hQ1⟩ := (Ideal.mem_map_iff_of_surjective ψ hψ).mp h1
      have hQ1' : φ Q = 1 := congrArg Subtype.val hQ1
      set G := Q - 1 with hG
