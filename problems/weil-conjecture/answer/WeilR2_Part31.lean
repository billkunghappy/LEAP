      refine RingHom.ext fun t => ?_
      have e1 : f (Ideal.Quotient.mk _ (MvPolynomial.C t)) = σ t :=
        RingHom.congr_fun hf.2.2.1 t
      rw [RingHom.comp_apply, ← e1, ← RingHom.comp_apply k f, hk, hgC, RingHom.id_apply]
    have hk0 : k (f (wcEbntX W a 0)) = x n := by
      rw [← RingHom.comp_apply k f, hk, hg0]
