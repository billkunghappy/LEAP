      rw [← Category.assoc, morphismRestrict_ι, Category.assoc] at h1
      exact hU2max _ (r₂ ⁻¹ᵁ V₂).ι inferInstance h1 t'
  exact hlocal X₂ (r₂ ≫ r₁) (fun t => ⟨_, U2m.ι, inferInstance,
    by rw [Scheme.Opens.range_ι]; exact hall t, hU2inv⟩)

theorem wcpa_dj_lr1k_ebc_cgr_invpull_generic : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι → ∀ (σ : Spec (.of ↥W) ⟶ X) (a : ↥W), σ ≫ uX = 𝟙 _ → a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W → wcCsdInvPull (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX a) ι :=
by
  intro Ω _ W hW hWt X uX ι hM σ a hσ ha0 ham
  classical
  unfold wcCsdInvPull wcNcPrincipal
  set g : Γ(X, ⊤) := uX.appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) with hg

  have hunit : IsUnit (ι.appTop.hom g) := by
    have e1 : ι.appTop.hom g =
        (ι ≫ uX).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) := by
      rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    have e2 : (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))).appTop.hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom a) =
        (Scheme.ΓSpecIso (.of Ω)).inv.hom (algebraMap ↥W Ω a) := by
      have := congrArg (fun f => f.hom a)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap ↥W Ω)))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    rw [e1, hM.2.2.w, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, e2]
    have h3 : IsUnit (algebraMap ↥W Ω a) := by
      rw [isUnit_iff_ne_zero, ValuationSubring.algebraMap_apply]
      exact fun h => ha0 (Subtype.ext h)
    exact (h3.map _).map _

  have hmem : ∀ U : X.affineOpens,
      (X.presheaf.map (homOfLE (le_top : (U : X.Opens) ≤ ⊤)).op).hom g ∈
        (σ.ker ⊔ Scheme.IdealSheafData.ofIdealTop (Ideal.span {g})).ideal U := by
    intro U
    rw [Scheme.IdealSheafData.ideal_sup, Pi.sup_apply]
    apply Ideal.mem_sup_right
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self g)
  intro t
  obtain ⟨U, hU, htU, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens X) (show ι t ∈ (⊤ : X.Opens) from trivial)
  obtain ⟨V, hV, htV, hVU⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens _) (show t ∈ ι ⁻¹ᵁ U from htU)
  have hu : IsUnit ((ι.appLE U V hVU).hom
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom g)) := by
    have e := congrArg (fun f => f.hom g)
      (Scheme.Hom.map_appLE ι hVU (homOfLE (le_top : U ≤ ⊤)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    rw [e]
    unfold Scheme.Hom.appLE
    rw [CommRingCat.hom_comp, RingHom.comp_apply]
    exact hunit.map _
  refine ⟨⟨U, hU⟩, ⟨V, hV⟩, hVU, _, htV, hmem ⟨U, hU⟩, hu.mem_nonZeroDivisors, ?_⟩
  rw [Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ (hmem ⟨U, hU⟩)) hu, eq_comm,
    Ideal.span_singleton_eq_top]
  exact hu

theorem wcpa_dj_lr1k_ebc_cgr_ni_model_same_closed : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (b u₀ : ↥W), b ≠ 0 → u₀ ∈ IsLocalRing.maximalIdeal ↥W → ∀ (M : Scheme.{u}) (r₀ : M ⟶ wcEbdA1 W), wcCsdIsBlowup (wcEbdJ W b) r₀ → ∀ (l₀ l₁ : Spec (.of ↥W) ⟶ M), l₀ ≫ r₀ = wcEbdSec W 0 → l₁ ≫ r₀ = wcEbdSec W (b * u₀) → Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ l₀ = Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ l₁ :=
by
  intro Ω _ W b u₀ hb0 hu₀m M r₀ hbl l₀ l₁ hl₀ hl₁
  classical

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have nzd_iso : ∀ (R : CommRingCat.{u}) (x : R), x ∈ nonZeroDivisors R →
      (Scheme.ΓSpecIso R).inv.hom x ∈ nonZeroDivisors Γ(Spec R, ⊤) := by
    intro R x hx
    rw [mem_nonZeroDivisors_iff_right] at hx ⊢
    intro z hz
    have h1 := congrArg (Scheme.ΓSpecIso R).hom.hom hz
    rw [map_mul, hinvhom, map_zero] at h1
    have h2 := hx _ h1
    rw [← hhominv R z, h2, map_zero]

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp
  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f a = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self a
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2
  have hprinc : wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) b =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b)}) := by
    unfold wcNcPrincipal
    have := congrArg (fun g => g.hom b) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    rw [this]
  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro X I J
    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext U
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]
  have htop : ∀ (X : Scheme.{u}) [IsAffine X] (I : Ideal Γ(X, ⊤)),
      (Scheme.IdealSheafData.ofIdealTop I).ideal ⟨⊤, isAffineOpen_top X⟩ = I := by
    intro X _ I
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    convert Ideal.map_id I
    rw [show (homOfLE _ : (⊤ : X.Opens) ⟶ ⊤) = 𝟙 _ from Subsingleton.elim _ _]
    simp
  have hbr : ∀ (X T : Scheme.{u}) (h : T ⟶ X) (e : (⊤ : T.Opens) ≤ h ⁻¹ᵁ ⊤),
      h.appLE ⊤ ⊤ e = h.appTop := by
    intro X T h e
    exact (Scheme.Hom.app_eq_appLE h).symm
  have hJ : wcEbdJ W b = Scheme.IdealSheafData.ofIdealTop
      (Ideal.span {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)} ⊔
        Ideal.span {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.C b)}) := by
    dsimp only [wcEbdJ, wcEbdSec, wcEbdStr, wcEbdA1]
    rw [hkerSpec (MvPolynomial (Fin 1) ↥W) ↥W _ _ hker0, hprinc, hsup]

  have s1 : ∀ (R : Type u) [CommRing R] (φ : MvPolynomial (Fin 1) ↥W →+* R) (s t₀ t₁ : R),
      (s = φ (MvPolynomial.X 0) ∨ s = φ (MvPolynomial.C b)) →
      φ (MvPolynomial.X 0) = t₀ * s → φ (MvPolynomial.C b) = t₁ * s →
      s ∈ nonZeroDivisors R → wcCsdInvPull (wcEbdJ W b) (Spec.map (CommRingCat.ofHom φ)) := by
    intro R _ φ s t₀ t₁ hs h₀ h₁ hnzd
    have hevφ : ∀ p : MvPolynomial (Fin 1) ↥W,
        (Spec.map (CommRingCat.ofHom φ)).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p) =
        (Scheme.ΓSpecIso (.of R)).inv.hom (φ p) := by
      intro p
      have := congrArg (fun g => g.hom p) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this.symm
    have hspan : Ideal.span {(Scheme.ΓSpecIso (.of R)).inv.hom (φ (MvPolynomial.X 0))} ⊔
        Ideal.span {(Scheme.ΓSpecIso (.of R)).inv.hom (φ (MvPolynomial.C b))} =
        Ideal.span {(Scheme.ΓSpecIso (.of R)).inv.hom s} := by
      apply le_antisymm
      · apply sup_le
        · apply Ideal.span_singleton_le_span_singleton.mpr
          rw [h₀, map_mul]
          exact dvd_mul_left _ _
        · apply Ideal.span_singleton_le_span_singleton.mpr
          rw [h₁, map_mul]
          exact dvd_mul_left _ _
      · rcases hs with h | h
        · rw [h]; exact le_sup_left
        · rw [h]; exact le_sup_right
    rw [hJ]
    intro t'
    have hle : (⊤ : (Spec (.of R)).Opens) ≤ (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤ := by
      simp
    rcases hs with hs | hs
    · refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, hle,
        (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), trivial,
        ?_, ?_, ?_⟩
      · rw [htop]
        exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
      · dsimp only
        rw [hbr, hevφ, ← hs]
        exact nzd_iso _ _ hnzd
      · dsimp only
        rw [hbr, htop, Ideal.map_sup, Ideal.map_span, Ideal.map_span,
          Set.image_singleton, Set.image_singleton, hevφ, hevφ, hspan, hs]
    · refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, hle,
        (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C b), trivial,
        ?_, ?_, ?_⟩
      · rw [htop]
        exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
      · dsimp only
        rw [hbr, hevφ, ← hs]
        exact nzd_iso _ _ hnzd
      · dsimp only
        rw [hbr, htop, Ideal.map_sup, Ideal.map_span, Ideal.map_span,
          Set.image_singleton, Set.image_singleton, hevφ, hevφ, hspan, hs]

  obtain ⟨μ, hμdef⟩ : ∃ μ : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 1) ↥W,
      μ = MvPolynomial.eval₂Hom MvPolynomial.C
        (fun _ : Fin 1 => MvPolynomial.C b * MvPolynomial.X 0) := ⟨_, rfl⟩
  have hμC : ∀ r : ↥W, μ (MvPolynomial.C r) = MvPolynomial.C r := by
    intro r; rw [hμdef, MvPolynomial.eval₂Hom_C]
  have hμX : ∀ i : Fin 1, μ (MvPolynomial.X i) = MvPolynomial.C b * MvPolynomial.X 0 := by
    intro i; rw [hμdef, MvPolynomial.eval₂Hom_X']
  have hCb : (MvPolynomial.C b : MvPolynomial (Fin 1) ↥W) ≠ 0 := by
    intro h; exact hb0 (MvPolynomial.C_eq_zero.mp h)
  have hInv1 : wcCsdInvPull (wcEbdJ W b) (Spec.map (CommRingCat.ofHom μ)) :=
    s1 _ μ (MvPolynomial.C b) (MvPolynomial.X 0) 1 (Or.inr (hμC b).symm)
      (by rw [hμX, mul_comm]) (by rw [hμC, one_mul]) (mem_nonZeroDivisors_of_ne_zero hCb)
  have hInv2 : wcCsdInvPull (wcEbdJ W b) (wcEbdSec W 0) :=
    s1 ↥W (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) b 0 1
      (Or.inr (MvPolynomial.eval_C _).symm) (by rw [MvPolynomial.eval_X, zero_mul])
      (by rw [MvPolynomial.eval_C, one_mul]) (mem_nonZeroDivisors_of_ne_zero hb0)
  have hInv3 : wcCsdInvPull (wcEbdJ W b) (wcEbdSec W (b * u₀)) :=
    s1 ↥W (MvPolynomial.eval (fun _ : Fin 1 => b * u₀)) b u₀ 1
      (Or.inr (MvPolynomial.eval_C _).symm) (by rw [MvPolynomial.eval_X, mul_comm])
      (by rw [MvPolynomial.eval_C, one_mul]) (mem_nonZeroDivisors_of_ne_zero hb0)

  obtain ⟨c₁, hc₁, -⟩ := hbl.2 (wcEbdA1 W) (Spec.map (CommRingCat.ofHom μ)) hInv1

  have hSec : ∀ v : ↥W, wcEbdSec W v ≫ Spec.map (CommRingCat.ofHom μ) = wcEbdSec W (b * v) := by
    intro v
    show Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => v))) ≫
      Spec.map (CommRingCat.ofHom μ) =
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => b * v)))
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hμC,
        MvPolynomial.eval_C]
    · intro i
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hμX,
        map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]

  have hl1' : l₁ = wcEbdSec W u₀ ≫ c₁ :=
    (hbl.2 _ (wcEbdSec W (b * u₀)) hInv3).unique hl₁ (by rw [Category.assoc, hc₁, hSec])
  have hl0' : l₀ = wcEbdSec W 0 ≫ c₁ :=
    (hbl.2 _ (wcEbdSec W 0) hInv2).unique hl₀ (by rw [Category.assoc, hc₁, hSec, mul_zero])

  have hres : Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫
      wcEbdSec W 0 =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫
      wcEbdSec W u₀ := by
    show Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => u₀)))
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.eval_C]
    · intro i
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.eval_X, map_zero]
      rw [IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff u₀).mpr hu₀m]
  rw [hl0', hl1', ← Category.assoc, ← Category.assoc, hres]

theorem wcpa_dj_lr1k_ebc_cgr_ni_chart_residue : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (O : X.Opens) (m : O.toScheme ⟶ wcEbdA1 W) (σO σ'O : Spec (.of ↥W) ⟶ O.toScheme) (c' : ↥W), IsAffineOpen O → σO ≫ O.ι ≫ uX = 𝟙 _ → σ'O ≫ O.ι ≫ uX = 𝟙 _ → σ'O ≫ m = wcEbdSec W c' → RingHom.ker σO.appTop.hom = Ideal.span {m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} → c' ∈ IsLocalRing.maximalIdeal ↥W → Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ σO = Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ σ'O :=
by
  intro Ω _ W X uX O m σO σ'O c' hO h1 h2 h3 h4 h5

  have key : ∀ (A R K : Type u) [CommRing A] [CommRing R] [CommRing K] (S S' : A →+* R)
      (lam : R →+* A) (ρ : R →+* K) (t : A),
      (∀ r, S (lam r) = r) → (∀ r, S' (lam r) = r) → RingHom.ker S = Ideal.span {t} →
      ρ (S' t) = 0 → ∀ a, ρ (S a) = ρ (S' a) := by
    intro A R K _ _ _ S S' lam ρ t hS hS' hk ht a
    have hmem : a - lam (S a) ∈ RingHom.ker S := by
      rw [RingHom.mem_ker, map_sub, hS, sub_self]
    rw [hk, Ideal.mem_span_singleton'] at hmem
    obtain ⟨b, hb⟩ := hmem
    have ha : a = lam (S a) + b * t := by rw [hb]; ring
    have hS'a : S' a = S a + S' b * S' t := by
      conv_lhs => rw [ha]
      rw [map_add, map_mul, hS']
    rw [hS'a, map_add, map_mul, ht, mul_zero, add_zero]
  haveI : IsAffine O.toScheme := hO
  apply ext_of_isAffine
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
  ext a
  simp only [CommRingCat.hom_comp, RingHom.comp_apply]
  refine key _ _ _ σO.appTop.hom σ'O.appTop.hom (uX.appTop ≫ O.ι.appTop).hom _ _ ?_ ?_ h4 ?_ a
  · intro r
    have := congrArg (fun f => f.appTop.hom r) h1
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
      Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply] using this
  · intro r
    have := congrArg (fun f => f.appTop.hom r) h2
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
      Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply] using this
  · have e1 : σ'O.appTop.hom (m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) =
        (σ'O ≫ m).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) := by
      rw [Scheme.Hom.comp_appTop]; rfl
    rw [e1, h3]
    have e2 := congrArg (fun f => f.hom (MvPolynomial.X 0))
      (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c'))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
      MvPolynomial.eval_X] at e2
