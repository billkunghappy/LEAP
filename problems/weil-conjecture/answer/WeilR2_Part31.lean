    intro T Z L Y p f h lam hp hlam ξ t ht e
    subst ht
    haveI : IsClosedImmersion lam := hlam
    haveI hpc : IsClosedImmersion p :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hp.flip hlam
    have hπs : Function.Surjective (p.stalkMap ξ).hom := SurjectiveOnStalks.stalkMap_surjective p ξ
    have hlams : Function.Surjective (lam.stalkMap (f ξ)).hom :=
      SurjectiveOnStalks.stalkMap_surjective lam (f ξ)
