theorem wcpa_dj_lr1u_vv_germ_fraction : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ [AlgebraicGeometry.IsIntegral (wcProjK Ω 1)] (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), AlgebraicGeometry.IsIntegral X → IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → ∀ (ξ : X) (hξ : ι (genericPoint (wcProjK Ω 1)) ⤳ ξ), Function.Injective ⇑(wcLr1uGerm ι ξ hξ).hom ∧ ∀ k : (wcProjK Ω 1).functionField, ∃ a b : X.presheaf.stalk ξ, (wcLr1uGerm ι ξ hξ).hom b ≠ 0 ∧ k * (wcLr1uGerm ι ξ hξ).hom b = (wcLr1uGerm ι ξ hξ).hom a :=
