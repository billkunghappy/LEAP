    H3 a ha0 ham hθa c hc O hO V' hV' b hb1 hb2 hb3 g hgm hg0 hge htr V'' h1 h2 h3)

  refine ⟨t * (t * u b), htI.mul htuI, ?_, ?_, ?_⟩
