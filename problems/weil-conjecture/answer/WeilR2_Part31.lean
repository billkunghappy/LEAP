    have h3 := Polynomial.Splits.aeval_eq_prod_aroots_of_monic hsplit hp (algebraMap W Ω a₀)
    rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at h3
    rw [h3] at h2
    have h4 : ∃ α ∈ p.aroots Ω, W.valuation (algebraMap W Ω a₀ - α) < 1 := by
      by_contra hcon
      push_neg at hcon
      rw [map_multiset_prod, Multiset.map_map] at h2
