  obtain ⟨α, hαS, hαdiv⟩ := hmin S hne
  rw [hS, Finset.mem_biUnion] at hαS
  obtain ⟨j, hj, hαj⟩ := hαS
  obtain ⟨t, ht, hjt⟩ := Finset.mem_image.mp hαj
  have hjt : (P j).coeff t = α := hjt
  have hj' : j ≤ n := by have := Finset.mem_range.mp hj; omega
  have hα0 : α ≠ 0 := by rw [← hjt]; exact Polynomial.mem_support_iff.mp ht
