        rw [Polynomial.reverse_leadingCoeff, Polynomial.trailingCoeff_eq_coeff_zero hGc0]
        apply Subtype.ext
        show ((G.coeff 0 : ↥O.toSubring) : K')⁻¹ * ((G.coeff 0 : ↥O.toSubring) : K') = 1
        exact inv_mul_cancel₀ hu0
      have hmon := Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one huinv'
      letI : Invertible t := invertibleOfNonzero ht0
      have hrev := Polynomial.eval₂_reverse_mul_pow (algebraMap ↥O.toSubring L) t G
      rw [hG0] at hrev
      have hinvt : (⅟t : L) = y := by rw [invOf_eq_inv, ht, inv_inv]
      rw [hinvt] at hrev
      have hrev0 : Polynomial.eval₂ (algebraMap ↥O.toSubring L) y G.reverse = 0 :=
        (mul_eq_zero.mp hrev).resolve_right (pow_ne_zero _ ht0)
      exact hni ⟨_, hmon, by rw [Polynomial.eval₂_mul, hrev0, mul_zero]⟩
    obtain ⟨P, hPmax, hIP⟩ := Ideal.exists_le_maximal I hI
    have : P.IsPrime := hPmax.isPrime
    obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.ofPrime A P)
    obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hV
    have hAV : ∀ a : ↥A, (a : L) ∈ V := fun a => hle (LocalSubring.le_ofPrime A P a.2)
    have hPV : ∀ a : ↥A, a ∈ P → V.valuation (a : L) < 1 := by
      intro a haP
      have h1 : algebraMap ↥A ↥(LocalSubring.ofPrime A P).toSubring a ∈
          IsLocalRing.maximalIdeal ↥(LocalSubring.ofPrime A P).toSubring :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff _ P a).mpr haP
      by_contra hcon
      have hv1 : V.valuation (a : L) = 1 :=
        le_antisymm ((V.valuation_le_one_iff _).mpr (hAV a)) (not_lt.mp hcon)
      have ha0 : (a : L) ≠ 0 := by
        intro h; rw [h, Valuation.map_zero] at hv1; exact zero_ne_one hv1
      have hcoe : ((Subring.inclusion hle (algebraMap ↥A ↥(LocalSubring.ofPrime A P).toSubring a) :
          ↥V.toLocalSubring.toSubring) : L) = (a : L) := rfl
      have hunit : IsUnit (Subring.inclusion hle
          (algebraMap ↥A ↥(LocalSubring.ofPrime A P).toSubring a)) := by
        refine ⟨⟨Subring.inclusion hle (algebraMap ↥A _ a), ⟨(a : L)⁻¹, ?_⟩, ?_, ?_⟩, rfl⟩
        · exact (V.valuation_le_one_iff _).mp (by rw [map_inv₀, hv1, inv_one])
        · apply Subtype.ext
          rw [Subring.coe_mul, hcoe]
          exact mul_inv_cancel₀ ha0
        · apply Subtype.ext
          rw [Subring.coe_mul, hcoe]
          exact inv_mul_cancel₀ ha0
      exact (IsLocalRing.mem_maximalIdeal _).mp h1 (hloc.map_nonunit _ hunit)
    have hXJ : (Polynomial.X : Polynomial ↥O.toSubring) ∈ J := by
      rw [hJ]; simp
    have htP : ψ Polynomial.X ∈ P := hIP (Ideal.mem_map_of_mem ψ hXJ)
    have hψX : ((ψ Polynomial.X : ↥A) : L) = t := by
      show Polynomial.eval₂ (algebraMap ↥O.toSubring L) t Polynomial.X = t
      rw [Polynomial.eval₂_X]
    have hψC : ∀ c : ↥O.toSubring,
        ((ψ (Polynomial.C c) : ↥A) : L) = algebraMap K' L (c : K') := by
      intro c
      show Polynomial.eval₂ (algebraMap ↥O.toSubring L) t (Polynomial.C c) = _
      rw [Polynomial.eval₂_C]
      rfl
    have hyV : y ∉ V := by
      intro hyV
      have h1 := hPV _ htP
      rw [hψX] at h1
      have h3 : V.valuation (y * t) = 1 := by rw [ht, mul_inv_cancel₀ hy0, map_one]
      rw [map_mul] at h3
      have h2 : V.valuation y ≤ 1 := (V.valuation_le_one_iff _).mpr hyV
      rw [mul_comm] at h3
      exact absurd h3 (ne_of_lt (mul_lt_one_of_lt_of_le h1 h2))
    have hcomap : V.comap (algebraMap K' L) = O := by
      ext x
      rw [ValuationSubring.mem_comap]
      constructor
      · intro hx
        by_contra hxO
        have hx0 : x ≠ 0 := by rintro rfl; exact hxO O.zero_mem
        have hinv : x⁻¹ ∈ O := (O.mem_or_inv_mem x).resolve_left hxO
        have hvinv : O.valuation x⁻¹ < 1 := by
          by_contra h
          have h1 : O.valuation x⁻¹ = 1 :=
            le_antisymm ((O.valuation_le_one_iff _).mpr hinv) (not_lt.mp h)
          apply hxO
          apply (O.valuation_le_one_iff _).mp
          rw [← inv_inv x, map_inv₀, h1, inv_one]
        let c : ↥O.toSubring := ⟨x⁻¹, hinv⟩
        have hcJ : Polynomial.C c ∈ J := by
          rw [hJ, Polynomial.coeff_C_zero]; exact hvinv
        have h1 := hPV _ (hIP (Ideal.mem_map_of_mem ψ hcJ))
        rw [hψC] at h1
        have h2 : V.valuation (algebraMap K' L x) ≤ 1 := (V.valuation_le_one_iff _).mpr hx
        have h3 : V.valuation (algebraMap K' L x * algebraMap K' L x⁻¹) = 1 := by
          rw [← map_mul, mul_inv_cancel₀ hx0, map_one, map_one]
        rw [map_mul, mul_comm] at h3
        exact absurd h3 (ne_of_lt (mul_lt_one_of_lt_of_le h1 h2))
      · intro hx
        have e : algebraMap K' L x = ((ψ (Polynomial.C ⟨x, hx⟩) : ↥A) : L) :=
          (hψC ⟨x, hx⟩).symm
        rw [e]; exact hAV _
    exact hyV (hy V hcomap)



  have s2 : ∀ (S : Set L), (∀ y : L, (∀ i, y ∈ Vs i) → y ∈ S) →
      ∀ x : Fin r → L, (∀ i, x i ∈ Vs i) → ∃ b ∈ S, ∀ i, (Vs i).valuation (b - x i) < 1 := by
    intro S hS x hx
    choose e he1 he2 using fun i => happ i 0 (Vs i).zero_mem
    choose w hw1 hw2 using fun i => happ i (x i) (hx i)
    simp only [sub_zero] at he1
    have hlt : ∀ j (a : L), (Vs j).valuation a < 1 → a ∈ Vs j :=
      fun j a h => ((Vs j).valuation_le_one_iff a).mp h.le
    have hw_mem : ∀ i j, w i ∈ Vs j := by
      intro i j
      by_cases hij : j = i
      · subst hij
        have := add_mem (hlt j _ (hw1 j)) (hx j)
        simpa using this
      · have := add_mem (hlt j _ (hw2 i j hij)) (Vs j).one_mem
        simpa using this
    have he_mem : ∀ i j, 1 - e i ∈ Vs j := by
      intro i j
      by_cases hij : j = i
      · subst hij; exact sub_mem (Vs j).one_mem (hlt j _ (he1 j))
      · have := neg_mem (hlt j _ (he2 i j hij))
        simpa using this
    refine ⟨∑ i, (1 - e i) * w i, hS _ (fun j => ?_), fun j => ?_⟩
    · exact sum_mem (fun i _ => mul_mem (he_mem i j) (hw_mem i j))
    · have hsplit : ∑ i, (1 - e i) * w i - x j =
          ((w j - x j) - e j * w j) + ∑ i ∈ Finset.univ.erase j, (1 - e i) * w i := by
        rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j)]; ring
      rw [hsplit]
      apply Valuation.map_add_lt
      · refine lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt (hw1 j) ?_)
        rw [map_mul]
        exact mul_lt_one_of_lt_of_le (he1 j) (((Vs j).valuation_le_one_iff _).mpr (hw_mem j j))
      · apply Valuation.map_sum_lt _ one_ne_zero
        intro i hi
        have hij : j ≠ i := fun h => (Finset.mem_erase.mp hi).1 (h ▸ rfl)
        rw [map_mul]
        refine mul_lt_one_of_lt_of_le ?_ (((Vs j).valuation_le_one_iff _).mpr (hw_mem i j))
        rw [Valuation.map_sub_swap]; exact he2 i j hij



  have s3 : ∀ (V : ValuationSubring L), V.comap (algebraMap K' L) = O →
      ∃ φ : IsLocalRing.ResidueField ↥O →+* IsLocalRing.ResidueField ↥V,
        (∀ (x : K') (hx : x ∈ O) (hy : algebraMap K' L x ∈ V),
