theorem wcpa_dj_lr1k_ebc_dia_norm_bridge : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X₂ : Scheme.{u}) (u₂ : X₂ ⟶ Spec (.of ↥W)) (ι₂ : wcProjK Ω 1 ⟶ X₂)
      [QuasiCompact (γ ≫ ι₂)] [QuasiSeparated (γ ≫ ι₂)],
    wcpaDjLkModel W u₂ ι₂ →
    ∀ (Z : Scheme.{u}) (uZ : Z ⟶ Spec (.of ↥W)) (ιZ : wcProjK Ω 1 ⟶ Z)
      [QuasiCompact (γ ≫ ιZ)] [QuasiSeparated (γ ≫ ιZ)],
    wcpaDjLkModel W uZ ιZ →
    ∀ q : X₂ ⟶ Z, q ≫ uZ = u₂ → ι₂ ≫ q = ιZ →
    ∀ p₂ : ↥X₂,
    ∀ (PZ : Type u) [CommRing PZ] (eZ : ↥(Z.presheaf.stalk (q p₂)) →+* PZ),
      wcNdIsHens (IsLocalRing.maximalIdeal ↥(Z.presheaf.stalk (q p₂))) PZ eZ →
    ∀ (P₂ : Type u) [CommRing P₂] (e₂ : ↥(X₂.presheaf.stalk p₂) →+* P₂),
      wcNdIsHens (IsLocalRing.maximalIdeal ↥(X₂.presheaf.stalk p₂)) P₂ e₂ →
    ∀ (h : PZ →+* P₂), IsLocalHom h → h.comp eZ = e₂.comp (q.stalkMap p₂).hom →
    ∀ y₂ : ↥(wcpaDjLkFib W (γ ≫ ι₂) u₂),
      IsClosed ({y₂} : Set ↥(wcpaDjLkFib W (γ ≫ ι₂) u₂)) →
      wcpaDjLkImg W (γ ≫ ι₂) u₂ y₂ = p₂ →
    ∃ yZ : ↥(wcpaDjLkFib W (γ ≫ ιZ) uZ),
      IsClosed ({yZ} : Set ↥(wcpaDjLkFib W (γ ≫ ιZ) uZ)) ∧
      wcpaDjLkImg W (γ ≫ ιZ) uZ yZ = q p₂ ∧
      ∃ (QZ : Type u) (_ : CommRing QZ)
        (kZ : ↥((γ ≫ ιZ).normalization.presheaf.stalk (wcNdPt W (γ ≫ ιZ) uZ yZ)) →+* QZ)
        (Q₂ : Type u) (_ : CommRing Q₂)
        (k₂ : ↥((γ ≫ ι₂).normalization.presheaf.stalk (wcNdPt W (γ ≫ ι₂) u₂ y₂)) →+* Q₂)
        (jZ : PZ →+* QZ) (j₂ : P₂ →+* Q₂) (κ : QZ →+* Q₂),
        wcNdIsHens (IsLocalRing.maximalIdeal
          ↥((γ ≫ ιZ).normalization.presheaf.stalk (wcNdPt W (γ ≫ ιZ) uZ yZ))) QZ kZ ∧
        wcNdIsHens (IsLocalRing.maximalIdeal
          ↥((γ ≫ ι₂).normalization.presheaf.stalk (wcNdPt W (γ ≫ ι₂) u₂ y₂))) Q₂ k₂ ∧
        IsLocalHom jZ ∧ IsLocalHom j₂ ∧ IsLocalHom κ ∧ κ.comp jZ = j₂.comp h ∧
        Function.Injective jZ ∧ jZ.Finite ∧ Function.Injective j₂ ∧ Function.Injective κ ∧
        IsDomain Q₂ ∧ IsIntegrallyClosed Q₂ ∧
        (∀ x : Q₂, ∃ p : Polynomial Q₂, p.Monic ∧ (∀ i, p.coeff i ∈ κ.range ⊔ j₂.range) ∧
          p.eval x = 0) ∧
        (∀ x : Q₂, ∃ r ∈ κ.range ⊔ j₂.range, ∃ s ∈ κ.range ⊔ j₂.range, s ≠ 0 ∧ x * s = r) ∧
        kZ.comp (wcNdSig ((γ ≫ ιZ).fromNormalization ≫ uZ) (wcNdPt W (γ ≫ ιZ) uZ yZ)) =
          jZ.comp (eZ.comp (wcNdSig uZ (q p₂))) ∧
        k₂.comp (wcNdSig ((γ ≫ ι₂).fromNormalization ≫ u₂) (wcNdPt W (γ ≫ ι₂) u₂ y₂)) =
          j₂.comp (e₂.comp (wcNdSig u₂ p₂)) :=
by
  classical

  have hnat0 : ∀ {B : Type u} [CommRing B] {X Y : Scheme.{u}} (f : X ⟶ Y)
      (hY : Y ⟶ Spec (.of B)) (x : X),
      (f.stalkMap x).hom.comp (wcNdSig hY (f x)) = wcNdSig (f ≫ hY) x := by
    intro B _ X Y f hY x
    unfold wcNdSig wcCnSigma
    ext b
    simp only [RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      ← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
      ← CommRingCat.comp_apply]
    congr 2
    simp only [Scheme.Hom.comp_app, Category.assoc]
    first
      | exact congrArg (fun k => Scheme.Hom.app hY ⊤ ≫ k) (Scheme.Hom.germ_stalkMap f ⊤ x trivial)
      | (simp; exact congrArg (fun k => Scheme.Hom.app hY ⊤ ≫ k)
          (Scheme.Hom.germ_stalkMap f ⊤ x trivial))
      | simp [Scheme.Hom.germ_stalkMap]

  have hens_iso : ∀ {A A' P : Type u} [CommRing A] [IsLocalRing A] [CommRing A'] [IsLocalRing A']
      [CommRing P] (φ : A' ≃+* A) (e : A →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal A) P e →
      wcNdIsHens (IsLocalRing.maximalIdeal A') P (e.comp φ.toRingHom) := by
    intro A A' P _ _ _ _ _ φ e he
    have hmem : ∀ a : A', φ a ∉ IsLocalRing.maximalIdeal A ↔ a ∉ IsLocalRing.maximalIdeal A' := by
      intro a
      simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
      exact isUnit_map_iff φ a
    refine ⟨he.1, fun a => ?_, ?_⟩
    · rw [RingHom.comp_apply, he.2.1]
      exact hmem a
    · intro B _ hB g hg
      have hg' : ∀ b : A, IsUnit ((g.comp φ.symm.toRingHom) b) ↔
          b ∉ IsLocalRing.maximalIdeal A := by
        intro b
        rw [RingHom.comp_apply, hg, ← hmem]
        simp
      obtain ⟨k, ⟨hk, hkl⟩, huniq⟩ := he.2.2 B hB (g.comp φ.symm.toRingHom) hg'
      refine ⟨k, ⟨?_, hkl⟩, ?_⟩
      · ext x
        have := congrArg (fun f => f (φ x)) hk
        simpa using this
      · rintro k' ⟨hk', hk'l⟩
        apply huniq k'
        refine ⟨?_, hk'l⟩
        ext b
        have := congrArg (fun f => f (φ.symm b)) hk'
        simpa using this


  suffices hgen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
      ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
      ∀ (X₁ X₂ : Scheme.{u}) (u₁ : X₁ ⟶ Spec (.of ↥W)) (u₂ : X₂ ⟶ Spec (.of ↥W))
        (ι₁ : wcProjK Ω 1 ⟶ X₁) (ι₂ : wcProjK Ω 1 ⟶ X₂)
        [QuasiCompact (γ ≫ ι₁)] [QuasiSeparated (γ ≫ ι₁)]
        [QuasiCompact (γ ≫ ι₂)] [QuasiSeparated (γ ≫ ι₂)],
      wcpaDjLkModel W u₁ ι₁ → wcpaDjLkModel W u₂ ι₂ →
      ∀ (U : X₂.Opens) (g : U.toScheme ⟶ X₁) (ι₂' : wcProjK Ω 1 ⟶ U.toScheme),
        g ≫ u₁ = U.ι ≫ u₂ → ι₂' ≫ U.ι = ι₂ → ι₂' ≫ g = ι₁ →
      ∀ v₂ : ↥U.toScheme,
      ∀ (P₁ : Type u) [CommRing P₁] (e₁ : ↥(X₁.presheaf.stalk (g v₂)) →+* P₁),
        wcNdIsHens (IsLocalRing.maximalIdeal ↥(X₁.presheaf.stalk (g v₂))) P₁ e₁ →
      ∀ (P₂ : Type u) [CommRing P₂] (e₂ : ↥(U.toScheme.presheaf.stalk v₂) →+* P₂),
        wcNdIsHens (IsLocalRing.maximalIdeal ↥(U.toScheme.presheaf.stalk v₂)) P₂ e₂ →
      ∀ (h : P₁ →+* P₂), IsLocalHom h → h.comp e₁ = e₂.comp (g.stalkMap v₂).hom →
      ∀ y₂ : ↥(wcpaDjLkFib W (γ ≫ ι₂) u₂),
        IsClosed ({y₂} : Set ↥(wcpaDjLkFib W (γ ≫ ι₂) u₂)) →
        wcpaDjLkImg W (γ ≫ ι₂) u₂ y₂ = U.ι v₂ →
      ∃ y₁ : ↥(wcpaDjLkFib W (γ ≫ ι₁) u₁),
        IsClosed ({y₁} : Set ↥(wcpaDjLkFib W (γ ≫ ι₁) u₁)) ∧
        wcpaDjLkImg W (γ ≫ ι₁) u₁ y₁ = g v₂ ∧
        ∃ (Q₁ : Type u) (_ : CommRing Q₁)
          (k₁ : ↥((γ ≫ ι₁).normalization.presheaf.stalk (wcNdPt W (γ ≫ ι₁) u₁ y₁)) →+* Q₁)
          (Q₂ : Type u) (_ : CommRing Q₂)
          (k₂ : ↥((γ ≫ ι₂).normalization.presheaf.stalk (wcNdPt W (γ ≫ ι₂) u₂ y₂)) →+* Q₂)
          (j₁ : P₁ →+* Q₁) (j₂ : P₂ →+* Q₂) (κ : Q₁ →+* Q₂),
          wcNdIsHens (IsLocalRing.maximalIdeal
            ↥((γ ≫ ι₁).normalization.presheaf.stalk (wcNdPt W (γ ≫ ι₁) u₁ y₁))) Q₁ k₁ ∧
          wcNdIsHens (IsLocalRing.maximalIdeal
            ↥((γ ≫ ι₂).normalization.presheaf.stalk (wcNdPt W (γ ≫ ι₂) u₂ y₂))) Q₂ k₂ ∧
          IsLocalHom j₁ ∧ IsLocalHom j₂ ∧ IsLocalHom κ ∧ κ.comp j₁ = j₂.comp h ∧
          Function.Injective j₁ ∧ j₁.Finite ∧ Function.Injective j₂ ∧ Function.Injective κ ∧
          IsDomain Q₂ ∧ IsIntegrallyClosed Q₂ ∧
          (∀ q : Q₂, ∃ p : Polynomial Q₂, p.Monic ∧ (∀ i, p.coeff i ∈ κ.range ⊔ j₂.range) ∧
            p.eval q = 0) ∧
          (∀ q : Q₂, ∃ a ∈ κ.range ⊔ j₂.range, ∃ b ∈ κ.range ⊔ j₂.range, b ≠ 0 ∧ q * b = a) ∧
          k₁.comp (wcNdSig ((γ ≫ ι₁).fromNormalization ≫ u₁) (wcNdPt W (γ ≫ ι₁) u₁ y₁)) =
            j₁.comp (e₁.comp (wcNdSig u₁ (g v₂))) ∧
          k₂.comp (wcNdSig ((γ ≫ ι₂).fromNormalization ≫ u₂) (wcNdPt W (γ ≫ ι₂) u₂ y₂)) =
            j₂.comp (e₂.comp (wcNdSig (U.ι ≫ u₂) v₂)) by

    intro Ω _ _ W hW hWt C γ hcov X₂ u₂ ι₂ _ _ hM₂ Z uZ ιZ _ _ hMZ q hq hι p₂ PZ _ eZ heZ
      P₂ _ e₂ he₂ h hhloc hh y₂ hcl hy₂
    obtain ⟨v₂, rfl⟩ : ∃ v₂ : ↥(⊤ : X₂.Opens).toScheme, (⊤ : X₂.Opens).ι v₂ = p₂ :=
      ⟨⟨p₂, trivial⟩, by first | rfl | simp [Scheme.Opens.ι_apply]⟩
    let ι₂' : wcProjK Ω 1 ⟶ (⊤ : X₂.Opens).toScheme :=
      IsOpenImmersion.lift (⊤ : X₂.Opens).ι ι₂ (by
        rintro x -
        exact ⟨⟨x, trivial⟩, rfl⟩)
    have hι₂' : ι₂' ≫ (⊤ : X₂.Opens).ι = ι₂ := IsOpenImmersion.lift_fac _ _ _
