    apply le_antisymm
    · refine (hτ.2.2 σ' b σ b hP' hP).mpr ⟨dvd_rfl, ?_⟩
      have e : τ σ - τ σ' = -b := by rw [← hb, neg_sub]
      rw [e]
      exact dvd_neg.mpr dvd_rfl
    · exact (hτ.2.2 σ b σ' b hP hP').mpr ⟨dvd_rfl, hb ▸ dvd_rfl⟩

  haveI : IsProper uX := hM.1.2.1
  have hLFP : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) X uX hM.1.1 inferInstance
  have hinv :=
    (wcpa_dj_nc_centre_props Ω W hW X uX σ b hLFP inferInstance hP.1 hP.2.2.1 hP.2.2.2).2.2
  obtain ⟨σt, hσt, -⟩ := hbl₁.2 (Spec (.of ↥W)) σ hinv

  have hneg : wcNcPrincipal (.of ↥W) X uX (-b) = wcNcPrincipal (.of ↥W) X uX b := by
    unfold wcNcPrincipal
    rw [map_neg, map_neg, Ideal.span_singleton_neg]
  have hJ : σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX (-b) =
      σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b := by
    rw [hneg, hIeq]
  have hbl₁' : wcCsdIsBlowup (σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX (-b)) r₁ := by
    rw [hJ]; exact hbl₁
  have hP'n : wcpaDjLlPair W uX x σ' (-b) :=
    ⟨hP'.1, hP'.2.1, neg_ne_zero.mpr hP'.2.2.1, neg_mem hP'.2.2.2⟩
  have hPn : wcpaDjLlPair W uX x σ (-b) :=
    ⟨hP.1, hP.2.1, neg_ne_zero.mpr hP.2.2.1, neg_mem hP.2.2.2⟩
  have hbn : τ σ - τ σ' = -b := by rw [← hb, neg_sub]
  obtain ⟨w₀, hw₀, hsm₀⟩ := wcpa_dj_lr1k_ebc_odf_mid_smooth Ω W hW hWt X uX ι hM x τ hτ w hw hSm
    σ' σ (-b) hP'n hPn hbn X₁ r₁ ι₁ hbl₁' hι₁ hM₁ σt hσt
  refine ⟨σt, hσt, ?_, w₀, hw₀, hsm₀⟩

  intro heq
  obtain ⟨U, hU, eσ, eσ', H⟩ := wcpa_dj_lr1k_ebc_cgr_sl_same_point_direction Ω W X uX σ σ' b
    hP.1 hP'.1 hP.2.2.1 hIeq X₁ r₁ hbl₁ σt σ₁ hσt hσ₁ heq
  exact wcpa_dj_lr1k_ebc_cgr_sl_direction_rigid Ω W hW X uX hLFP inferInstance x τ hτ σ σ' b
