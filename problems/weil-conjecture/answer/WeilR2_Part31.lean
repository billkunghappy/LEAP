          exact congr(CommRingCat.ofHom $(ψ.comp_algebraMap.symm))

      haveI : Epi (CommRingCat.ofHom (algebraMap A (FractionRing A))) :=
        IsLocalization.epi (nonZeroDivisors A) _
      haveI : Mono (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) :=
        Functor.map_mono Scheme.Spec (CommRingCat.ofHom (algebraMap A (FractionRing A))).op
      haveI hflatη : Flat (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) :=
        HasRingHomProperty.Spec_iff.mpr (RingHom.flat_algebraMap_iff.mpr
          (IsLocalization.flat (FractionRing A) (nonZeroDivisors A)))
      haveI : Flat (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) :=
        MorphismProperty.of_isPullback (P := @Flat)
          (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))).flip
          hflatη
      haveI : IsAffineHom (pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) :=
        MorphismProperty.of_isPullback (P := @IsAffineHom)
          (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))).flip
