import WeilR2_Part30
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_lr1k_eb_eg_sep_cond_annulus : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L → wcEbAnGaussStr W L →
    ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    wcEbMoBD W L m U e η u →
    ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W →
      ∀ c : Ω, c * c = (a : Ω) →
      ∀ O : ValuationSubring (RatFunc Ω), (∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInOc W c f) →
      ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = O →
      ∀ b : Fin m, V'.valuation (u b - 1) < 1 →
        V'.valuation (η b) ^ e b = V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) →
        (∀ b', b' ≠ b → V'.valuation (η b') = 1) →
      ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → (g : Ω) ^ e b = (a : Ω) →
      ∀ V'' : ValuationSubring L, wcEgSim Ω L (η b) V'' V' →
        wcEgCond Ω W L (g : Ω) (η b) V'' :=
by
  intro Ω _ _ W hdim hW L _ _ _ _ hdef hGS m U e η u hMoBD a ha0 ham c hc O hO V' hV' b hb1 hb2
    hb3 g hgm hg0 hge V'' hsim
  classical
  set ι : Ω →+* L := (algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)) with hι

  have Tmem : ∀ p q : Polynomial Ω, Polynomial.eval₂ ι (η b) q ≠ 0 →
      Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q ∈ V' →
      Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q ∈ V'' :=
    fun p q hq h => (hsim p q hq).mpr h
  have Tlt : ∀ p q : Polynomial Ω, Polynomial.eval₂ ι (η b) q ≠ 0 →
      V'.valuation (Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q) < 1 →
      V''.valuation (Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q) < 1 := by
    intro p q hq h
    by_cases hx : Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q = 0
    · rw [hx, Valuation.map_zero]; exact zero_lt_one
    have hp : Polynomial.eval₂ ι (η b) p ≠ 0 := fun h0 => hx (by rw [h0, zero_div])
    have hmem : Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q ∈ V'' :=
      (hsim p q hq).mpr ((V'.valuation_le_one_iff _).mp h.le)
    have hle := (V''.valuation_le_one_iff _).mpr hmem
    by_contra hn
    have heq : V''.valuation (Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q) = 1 :=
      le_antisymm hle (not_lt.mp hn)
    have hinv : Polynomial.eval₂ ι (η b) q / Polynomial.eval₂ ι (η b) p ∈ V'' := by
      rw [← V''.valuation_le_one_iff, ← inv_div, map_inv₀, heq, inv_one]
    have hinv' := (V'.valuation_le_one_iff _).mpr ((hsim q p hp).mp hinv)
    rw [← inv_div, map_inv₀] at hinv'
    have hne : V'.valuation (Polynomial.eval₂ ι (η b) p / Polynomial.eval₂ ι (η b) q) ≠ 0 :=
      (Valuation.ne_zero_iff _).mpr hx
    have h1 := (inv_le_one₀ (zero_lt_iff.mpr hne)).mp hinv'
    exact absurd h (not_lt.mpr h1)

  have memO : ∀ f : RatFunc Ω, algebraMap (RatFunc Ω) L f ∈ V' ↔ wcEbAnInOc W c f := by
    intro f
    rw [← hO f, ← hV', ValuationSubring.mem_comap]
  have ha0' : (a : Ω) ≠ 0 := fun h => ha0 (Subtype.ext h)
  have hc0 : c ≠ 0 := by
    rintro rfl
    apply ha0'
    rw [← hc, zero_mul]
  have haW : W.valuation (a : Ω) < 1 := (W.valuation_lt_one_iff a).mp ham
  have hcWv : W.valuation c < 1 := by
    by_contra hn
    push_neg at hn
    have h1 : 1 ≤ W.valuation c * W.valuation c := one_le_mul hn hn
    rw [← map_mul, hc] at h1
    exact absurd haW (not_lt.mpr h1)
  have hcW : c ∈ W := (W.valuation_le_one_iff c).mp hcWv.le
  have hcm : (⟨c, hcW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
    (W.valuation_lt_one_iff _).mpr hcWv
  have inoc : (∀ w : Ω, wcEbAnInOc W c (algebraMap Ω (RatFunc Ω) w) ↔ w ∈ W) ∧
      ∀ P : Polynomial ↥W, wcEbAnInOc W c (Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp
        W.subtype) (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P) ∧ ((∃ i, IsUnit (P.coeff i)) →
        Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp W.subtype)
          (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P ≠ 0 ∧
        wcEbAnInOc W c (Polynomial.eval₂ ((algebraMap Ω (RatFunc Ω)).comp W.subtype)
          (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P)⁻¹) := by
    have hAinj : Function.Injective (algebraMap (Polynomial Ω) (RatFunc Ω)) :=
      RatFunc.algebraMap_injective Ω
    have hAC : ∀ w : Ω, algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C w) =
        algebraMap Ω (RatFunc Ω) w := by
      intro w
      rw [RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    have h1b : (1 : Polynomial Ω).coeff 0 * c ^ 0 ≠ 0 := by simp
    have h1a : ∀ j, (1 : Polynomial Ω).coeff j * c ^ j / ((1 : Polynomial Ω).coeff 0 * c ^ 0) ∈ W := by
      intro j
      rw [Polynomial.coeff_one_zero, pow_zero, mul_one, div_one, Polynomial.coeff_one]
      split_ifs with h
      · subst h
        rw [pow_zero, mul_one]
        exact W.one_mem
      · rw [zero_mul]
        exact W.zero_mem
    refine ⟨fun w => ⟨?_, ?_⟩, fun P => ?_⟩
    · rintro ⟨p, q, i, hne, heq, -, hp⟩
      rw [← hAC, ← map_mul] at heq
      have hpq := hAinj heq
      have h2 := hp i
      rw [← hpq, Polynomial.coeff_C_mul, mul_assoc, mul_div_assoc, div_self hne, mul_one] at h2
      exact h2
    · intro hw
      unfold wcEbAnInOc
      refine ⟨Polynomial.C w, 1, 0, h1b, ?_, h1a, ?_⟩
      · rw [map_one, mul_one, hAC]
      · intro j
        rw [Polynomial.coeff_one_zero, pow_zero, mul_one, div_one, Polynomial.coeff_C]
        split_ifs with h
        · subst h
          rw [pow_zero, mul_one]
          exact hw
        · rw [zero_mul]
          exact W.zero_mem
    · obtain ⟨fP, hfP⟩ : ∃ f : RatFunc Ω, f = Polynomial.eval₂
          ((algebraMap Ω (RatFunc Ω)).comp W.subtype) (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) P :=
        ⟨_, rfl⟩
      rw [← hfP]
      obtain ⟨Q, hQ⟩ : ∃ Q : Polynomial Ω,
          Q = (P.map W.subtype).comp (Polynomial.C c⁻¹ * Polynomial.X) := ⟨_, rfl⟩
      have hQc : ∀ j, Q.coeff j * c ^ j = (P.coeff j : Ω) := by
        intro j
        rw [hQ, Polynomial.comp_C_mul_X_coeff, Polynomial.coeff_map, mul_assoc, ← mul_pow,
          inv_mul_cancel₀ hc0, one_pow, mul_one]
        try rfl
      have hAQ : algebraMap (Polynomial Ω) (RatFunc Ω) Q = fP := by
        have e1 : (algebraMap (Polynomial Ω) (RatFunc Ω)).comp Polynomial.C =
            algebraMap Ω (RatFunc Ω) := RingHom.ext fun w => hAC w
        have e2 : algebraMap (Polynomial Ω) (RatFunc Ω) (Polynomial.C c⁻¹ * Polynomial.X) =
            RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹ := by
          rw [map_mul, hAC, RatFunc.algebraMap_X, mul_comm]
        rw [hfP, hQ, Polynomial.comp, Polynomial.hom_eval₂, Polynomial.eval₂_map, e1, e2]
      have hB : wcEbAnInOc W c fP := by
        unfold wcEbAnInOc
        refine ⟨Q, 1, 0, h1b, ?_, h1a, ?_⟩
        · rw [map_one, mul_one, hAQ]
        · intro j
          rw [hQc, Polynomial.coeff_one_zero, pow_zero, mul_one, div_one]
          exact (P.coeff j).2
      refine ⟨hB, ?_⟩
      rintro ⟨i₀, hu⟩
      have h6a : (P.coeff i₀ : Ω) ≠ 0 := fun h => hu.ne_zero (Subtype.ext h)
      have h6b : (P.coeff i₀ : Ω)⁻¹ ∈ W := by
        obtain ⟨v, hv⟩ := hu
        have h1 : ((↑v⁻¹ : ↥W) : Ω) * (P.coeff i₀ : Ω) = 1 := by
          rw [← hv]
          exact congrArg Subtype.val (Units.inv_mul v)
        rw [← eq_inv_of_mul_eq_one_left h1]
        exact (↑v⁻¹ : ↥W).2
      have hQ0 : Q ≠ 0 := by
        intro h0
        have h3 := hQc i₀
        rw [h0, Polynomial.coeff_zero, zero_mul] at h3
        exact h6a h3.symm
      have hf0 : fP ≠ 0 := by
        rw [← hAQ]
        exact (map_ne_zero_iff _ hAinj).mpr hQ0
      refine ⟨hf0, ?_⟩
      unfold wcEbAnInOc
      refine ⟨1, Q, i₀, by rw [hQc]; exact h6a, ?_, ?_, ?_⟩
      · rw [hAQ, inv_mul_cancel₀ hf0, map_one]
      · intro j
        rw [hQc, hQc, div_eq_mul_inv]
        exact W.mul_mem _ _ (P.coeff j).2 h6b
      · intro j
        rw [hQc, Polynomial.coeff_one]
        split_ifs with h
        · subst h
          rw [pow_zero, mul_one, one_div]
          exact h6b
        · rw [zero_mul, zero_div]
          exact W.zero_mem
  obtain ⟨fact1, fact2⟩ := inoc
  have hmono := fact2 Polynomial.X
  rw [Polynomial.eval₂_X] at hmono
  have hY : wcEbAnInOc W c (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) := hmono.1
  have hZ : wcEbAnInOc W c (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹)⁻¹ :=
    (hmono.2 ⟨1, by rw [Polynomial.coeff_X_one]; exact isUnit_one⟩).2
  have C1 : ∀ w : ↥W, ι (w : Ω) ∈ V' := fun w => (memO _).mpr ((fact1 _).mpr w.2)
  have C2 : ∀ w ∈ IsLocalRing.maximalIdeal ↥W, V'.valuation (ι (w : Ω)) < 1 := by
    intro w hw
    by_cases hw0 : (w : Ω) = 0
    · rw [hw0, map_zero, Valuation.map_zero]; exact zero_lt_one
    by_contra hn
    have heq : V'.valuation (ι (w : Ω)) = 1 :=
      le_antisymm ((V'.valuation_le_one_iff _).mpr (C1 w)) (not_lt.mp hn)
    have hinv : ι ((w : Ω)⁻¹) ∈ V' := by
      rw [← V'.valuation_le_one_iff, map_inv₀, map_inv₀, heq, inv_one]
    have hwinv : (w : Ω)⁻¹ ∈ W := (fact1 _).mp ((memO _).mp hinv)
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hw
    apply hw
    have hmul : w * (⟨_, hwinv⟩ : ↥W) = 1 := Subtype.ext (by
      show (w : Ω) * (w : Ω)⁻¹ = 1
      exact mul_inv_cancel₀ hw0)
    exact isUnit_iff_exists_inv.mpr ⟨_, hmul⟩
  have vc : V'.valuation (ι c) < 1 := C2 _ hcm
  have hYv : V'.valuation
      (algebraMap (RatFunc Ω) L (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹)) ≤ 1 :=
    (V'.valuation_le_one_iff _).mpr ((memO _).mpr hY)
  have hZv : V'.valuation
      (algebraMap (RatFunc Ω) L (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹)⁻¹) ≤ 1 :=
    (V'.valuation_le_one_iff _).mpr ((memO _).mpr hZ)
  have hXK : (RatFunc.X : RatFunc Ω) =
      algebraMap Ω (RatFunc Ω) c * (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) := by
    rw [mul_left_comm, ← map_mul, mul_inv_cancel₀ hc0, map_one, mul_one]
  have hXeq : algebraMap (RatFunc Ω) L RatFunc.X =
      ι c * algebraMap (RatFunc Ω) L (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹) := by
    have h1 := congrArg (algebraMap (RatFunc Ω) L) hXK
    rw [map_mul] at h1
    exact h1
  have vX : V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) < 1 := by
    rw [hXeq, map_mul]
    exact mul_lt_one_of_lt_of_le vc hYv
  have C3 : V'.valuation (η b) < 1 := by
    by_contra hn
    push_neg at hn
    have h1 := one_le_pow_of_one_le' hn (e b)
    rw [hb2] at h1
    exact absurd vX (not_lt.mpr h1)
  have hZK : (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹)⁻¹ =
      algebraMap Ω (RatFunc Ω) c / RatFunc.X := by
    rw [mul_inv, map_inv₀, inv_inv, div_eq_inv_mul]
  have hZeq : algebraMap (RatFunc Ω) L (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹)⁻¹ =
      ι c / algebraMap (RatFunc Ω) L RatFunc.X := by
    rw [hZK, map_div₀]
    rfl
  have haeq : ι (a : Ω) / algebraMap (RatFunc Ω) L RatFunc.X =
      ι c * algebraMap (RatFunc Ω) L (RatFunc.X * algebraMap Ω (RatFunc Ω) c⁻¹)⁻¹ := by
    rw [hZeq, ← hc, map_mul, mul_div_assoc]
  have vaX : V'.valuation (ι (a : Ω) / algebraMap (RatFunc Ω) L RatFunc.X) < 1 := by
    rw [haeq, map_mul]
    exact mul_lt_one_of_lt_of_le vc hZv
  have key : V'.valuation (ι (g : Ω) / η b) ^ e b =
      V'.valuation (ι (a : Ω) / algebraMap (RatFunc Ω) L RatFunc.X) := by
    rw [map_div₀, map_div₀, div_pow, ← hb2, ← hge, map_pow, map_pow]
  have C4 : V'.valuation (ι (g : Ω) / η b) < 1 := by
    by_contra hn
    push_neg at hn
    have h1 := one_le_pow_of_one_le' hn (e b)
    rw [key] at h1
    exact absurd vaX (not_lt.mpr h1)

  have e1 : Polynomial.eval₂ ι (η b) (1 : Polynomial Ω) = 1 := by
    rw [Polynomial.eval₂_one]
  have e1ne : Polynomial.eval₂ ι (η b) (1 : Polynomial Ω) ≠ 0 := by
    rw [e1]; exact one_ne_zero
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro w
    have h := Tmem (Polynomial.C (w : Ω)) 1 e1ne
      (by rw [Polynomial.eval₂_C, e1, div_one]; exact C1 w)
    rw [Polynomial.eval₂_C, e1, div_one] at h
    exact h
  · intro w hw
    have h := Tlt (Polynomial.C (w : Ω)) 1 e1ne
      (by rw [Polynomial.eval₂_C, e1, div_one]; exact C2 w hw)
    rw [Polynomial.eval₂_C, e1, div_one] at h
    exact h
  · have h := Tlt Polynomial.X 1 e1ne (by rw [Polynomial.eval₂_X, e1, div_one]; exact C3)
    rw [Polynomial.eval₂_X, e1, div_one] at h
    exact h
  · by_cases hη : η b = 0
    · rw [hη, div_zero, Valuation.map_zero]; exact zero_lt_one
    have h := Tlt (Polynomial.C (g : Ω)) Polynomial.X (by rw [Polynomial.eval₂_X]; exact hη)
      (by rw [Polynomial.eval₂_C, Polynomial.eval₂_X]; exact C4)
    rw [Polynomial.eval₂_C, Polynomial.eval₂_X] at h
    exact h

theorem wcpa_dj_lr1k_eb_eg_separator : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L → wcEbAnGaussStr W L →
    ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    wcEbMoBD W L m U e η u →
    ∃ θ : ↥W, θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W ∧
    ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W → (θ : Ω) / (a : Ω) ∈ W →
      ∀ c : Ω, c * c = (a : Ω) →
      ∀ O : ValuationSubring (RatFunc Ω), (∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInOc W c f) →
      ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = O →
      ∀ b : Fin m, V'.valuation (u b - 1) < 1 →
        V'.valuation (η b) ^ e b = V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) →
        (∀ b', b' ≠ b → V'.valuation (η b') = 1) →
      ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → (g : Ω) ^ e b = (a : Ω) →
        (∀ p : Polynomial Ω, Polynomial.eval₂
          ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) (η b) p = 0 → p = 0) →
      ∃ s : L, IsIntegral ↥(wcEbEpD W L (g : Ω) (η b)) s ∧ V'.valuation s < 1 ∧
        ∀ V'' : ValuationSubring L, V'' ≠ V' →
          (∀ p q : Polynomial Ω,
            Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)))
              (η b) q ≠ 0 →
            (Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)))
                (η b) p /
              Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)))
                (η b) q ∈ V'' ↔
             Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)))
                (η b) p /
              Polynomial.eval₂ ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω)))
                (η b) q ∈ V')) →
          V''.valuation (s - 1) < 1 :=
by
  classical
  intro Ω _ _ W hdim hW L _ _ _ _ hdef hGS m U e η u hMoBD

  have pick : ∀ x y : ↥W, x ≠ 0 → y ≠ 0 → x ∈ IsLocalRing.maximalIdeal ↥W →
      y ∈ IsLocalRing.maximalIdeal ↥W → ∃ z : ↥W, z ≠ 0 ∧ z ∈ IsLocalRing.maximalIdeal ↥W ∧
        (x : Ω) / (z : Ω) ∈ W ∧ (y : Ω) / (z : Ω) ∈ W := by
    intro x y hx hy hxm hym
    have hx' : (x : Ω) ≠ 0 := fun h => hx (Subtype.ext h)
    have hy' : (y : Ω) ≠ 0 := fun h => hy (Subtype.ext h)
    rcases W.mem_or_inv_mem ((x : Ω) / (y : Ω)) with h | h
    · exact ⟨y, hy, hym, h, by rw [div_self hy']; exact W.one_mem⟩
    · refine ⟨x, hx, hxm, by rw [div_self hx']; exact W.one_mem, ?_⟩
      rwa [inv_div] at h
  have trans : ∀ x y z : ↥W, (y : Ω) ≠ 0 → (x : Ω) / (y : Ω) ∈ W → (y : Ω) / (z : Ω) ∈ W →
      (x : Ω) / (z : Ω) ∈ W := by
    intro x y z hy h1 h2
    have := mul_mem h1 h2
    rwa [div_mul_div_cancel₀ hy] at this
  obtain ⟨π, hπ0, hπm⟩ : ∃ π : ↥W, π ≠ 0 ∧ π ∈ IsLocalRing.maximalIdeal ↥W := by
    obtain ⟨x, hx⟩ : ∃ x : Ω, x ∉ W := by
      by_contra h
      push_neg at h
      exact hW (top_unique fun y _ => h y)
    have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
    have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
    refine ⟨⟨x⁻¹, hxi⟩, fun h => inv_ne_zero hx0 (congrArg Subtype.val h), ?_⟩
    rw [ValuationSubring.valuation_lt_one_iff]
    show W.valuation x⁻¹ < 1
    have h1 : 1 < W.valuation x := by
      rw [← not_le, W.valuation_le_one_iff]; exact hx
    rw [map_inv₀]
    exact inv_lt_one_of_one_lt₀ h1

  have perb : ∀ b : Fin m, ∃ θb : ↥W, θb ≠ 0 ∧ θb ∈ IsLocalRing.maximalIdeal ↥W ∧
      ((∀ p : Polynomial Ω, Polynomial.eval₂
        ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) (η b) p = 0 → p = 0) →
      ∃ gs : ↥W, gs ≠ 0 ∧ ((gs ^ e b : ↥W) : Ω) / (θb : Ω) ∈ W ∧ ∃ s : L,
        (U b).valuation s < 1 ∧
        (∀ U'' : ValuationSubring L, U'' ≠ U b → wcEgSim Ω L (η b) U'' (U b) →
          U''.valuation (s - 1) < 1) ∧
        (∀ U'' : ValuationSubring L, wcEgSim Ω L (η b) U'' (U b) → s ∈ U'') ∧
        (∀ g : ↥W, g ≠ 0 → g ∈ IsLocalRing.maximalIdeal ↥W → (gs : Ω) / (g : Ω) ∈ W →
          IsIntegral ↥(wcEbEpD W L (g : Ω) (η b)) s) ∧
