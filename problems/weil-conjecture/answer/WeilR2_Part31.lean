theorem wcpa_dj_lr1k_eb_mono_etale_primitive : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L → wcEbAnGaussStr W L →
    ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    wcEbMoBD W L m U e η u →
    ∃ θ : ↥W, θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W ∧
    ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W → (θ : Ω) / (a : Ω) ∈ W →
      letI : Algebra ↥(wcEbRing W a) L :=
        ((algebraMap (RatFunc Ω) L).comp (wcEbRing W a).subtype).toAlgebra
      ∀ c : Ω, c * c = (a : Ω) →
      ∀ O : ValuationSubring (RatFunc Ω), (∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInOc W c f) →
      ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = O →
      ∀ (𝔮 : Ideal ↥(integralClosure ↥(wcEbRing W a) L)) [𝔮.IsPrime],
        (∀ s : ↥(integralClosure ↥(wcEbRing W a) L), s ∈ 𝔮 ↔ V'.valuation (s : L) < 1) →
      ∀ b : Fin m, V'.valuation (u b - 1) < 1 →
        V'.valuation (η b) ^ e b = V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) →
        (∀ b', b' ≠ b → V'.valuation (η b') = 1) →
      ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → (g : Ω) ^ e b = (a : Ω) →
      ∀ (sx tx sy ty : ↥(integralClosure ↥(wcEbRing W a) L)) (htx : tx ∉ 𝔮) (hty : ty ∉ 𝔮),
        sx ∈ 𝔮 → sy ∈ 𝔮 → (tx : L) * η b = sx →
        (ty : L) * (algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) (g : Ω)) / η b) = sy →
        (∀ p : Polynomial Ω, Polynomial.eval₂
          ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) (η b) p = 0 → p = 0) →
        (∀ w ∈ IsLocalRing.maximalIdeal ↥W,
          algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L) (wcEbW W a w) ∈ 𝔮) →
      ∀ ψ : wcEbNg W g →+* Localization.AtPrime 𝔮, Function.Injective ψ →
        (∀ w : ↥W, ψ (wcEbNgC W g w) = algebraMap ↥(integralClosure ↥(wcEbRing W a) L)
          (Localization.AtPrime 𝔮) (algebraMap ↥(wcEbRing W a)
            ↥(integralClosure ↥(wcEbRing W a) L) (wcEbW W a w))) →
        ψ (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) *
            MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 0)) =
          IsLocalization.mk' (Localization.AtPrime 𝔮) sx (⟨tx, htx⟩ : 𝔮.primeCompl) →
        ψ (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥W) *
            MvPolynomial.X 1 - MvPolynomial.C g}) (MvPolynomial.X 1)) =
          IsLocalization.mk' (Localization.AtPrime 𝔮) sy (⟨ty, hty⟩ : 𝔮.primeCompl) →
      ∃ (ζ : Localization.AtPrime 𝔮) (f : Polynomial (wcEbNg W g)), f.Monic ∧
        Polynomial.eval₂ ψ ζ f = 0 ∧
        (∀ p : Polynomial (wcEbNg W g), p ≠ 0 → Polynomial.eval₂ ψ ζ p = 0 →
          f.natDegree ≤ p.natDegree) ∧
        (∀ z : Localization.AtPrime 𝔮, ∃ (p : Polynomial (wcEbNg W g)) (d : wcEbNg W g),
          d ≠ 0 ∧ ψ d * z = Polynomial.eval₂ ψ ζ p) ∧
        IsUnit (Polynomial.eval₂ ψ ζ (Polynomial.derivative f)) ∧
        ∃ h : Polynomial (wcEbNg W g), IsUnit (Polynomial.eval₂ ψ ζ h) ∧
          (∃ p₁ : Polynomial (wcEbNg W g), Polynomial.eval₂ ψ ζ h *
            algebraMap ↥(integralClosure ↥(wcEbRing W a) L) (Localization.AtPrime 𝔮)
              (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)
                ⟨RatFunc.X, Subring.subset_closure (Or.inr (Set.mem_insert _ _))⟩) =
            Polynomial.eval₂ ψ ζ p₁) ∧
          (∃ p₂ : Polynomial (wcEbNg W g), Polynomial.eval₂ ψ ζ h *
            algebraMap ↥(integralClosure ↥(wcEbRing W a) L) (Localization.AtPrime 𝔮)
              (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)
                ⟨algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹,
                  Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))⟩) =
            Polynomial.eval₂ ψ ζ p₂) :=
by
  classical
  intro Ω _ _ W hdim hW L _ _ _ _ hdef hGS m U e η u hMoBD
