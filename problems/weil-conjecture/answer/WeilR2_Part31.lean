theorem wcpa_dj_lsa_fl_zmt : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X P : Scheme.{u}) (Φ : X ⟶ P) (p : P ⟶ Spec (.of A)), IsProper Φ → UniversallyClosed (Φ ≫ p) → (∀ x x' : X, (Φ ≫ p) x = IsLocalRing.closedPoint A → Φ x' = Φ x → x' = x) → IsFinite Φ :=
by
  intro A _ _ X P Φ p hΦ hg hinj
  haveI := hΦ
  haveI := hg
  have hQ : ∀ x : X, (Φ ≫ p) x = IsLocalRing.closedPoint A → x ∈ Φ.quasiFiniteLocus := by
    intro x hx
    rw [Scheme.Hom.mem_quasiFiniteLocus, Scheme.Hom.quasiFiniteAt_iff_isOpen_singleton_asFiber]
    haveI : Subsingleton (Φ.fiber (Φ x)) := by
      rw [(Φ.fiberHomeo (Φ x)).toEquiv.subsingleton_congr]
      exact ⟨fun a b => Subtype.ext ((hinj x a.1 hx a.2).trans (hinj x b.1 hx b.2).symm)⟩
    have : ({Φ.asFiber x} : Set (Φ.fiber (Φ x))) = Set.univ :=
      Set.eq_univ_of_forall fun z => Subsingleton.elim _ _
    rw [this]
    exact isOpen_univ
  have htop : Φ.quasiFiniteLocus = ⊤ := by
    apply eq_top_iff.mpr
    intro x _
    by_contra hx
    have hC : IsClosed ((Φ.quasiFiniteLocus : Set X)ᶜ) := Φ.quasiFiniteLocus.isOpen.isClosed_compl
    have hgC : IsClosed ((Φ ≫ p) '' ((Φ.quasiFiniteLocus : Set X)ᶜ)) :=
      (Φ ≫ p).isClosedMap _ hC
    have hmem : IsLocalRing.closedPoint A ∈ (Φ ≫ p) '' ((Φ.quasiFiniteLocus : Set X)ᶜ) :=
      (IsLocalRing.specializes_closedPoint ((Φ ≫ p) x)).mem_closed hgC ⟨x, hx, rfl⟩
    obtain ⟨z, hzC, hz⟩ := hmem
    exact hzC (hQ z hz)
  haveI : LocallyQuasiFinite Φ := (Scheme.Hom.quasiFiniteLocus_eq_top_iff Φ).mp htop
  exact IsFinite.of_isProper_of_locallyQuasiFinite Φ

theorem wcpa_dj_rtsx_dim_lt_of_specializes : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (a b : Z), a ⤳ b → a ≠ b → ringKrullDim (Z.presheaf.stalk a) < ringKrullDim (Z.presheaf.stalk b) :=
by
  intro Z _ a b hab hne
  obtain ⟨U, hU, hbU, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := b) (U := ⊤) trivial
  have haU : a ∈ U := hab.mem_open U.isOpen hbU
  haveI : IsNoetherianRing Γ(Z, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  set pa := hU.primeIdealOf ⟨a, haU⟩ with hpa
  set pb := hU.primeIdealOf ⟨b, hbU⟩ with hpb
  have ea : hU.fromSpec pa = a := hU.fromSpec_primeIdealOf ⟨a, haU⟩
  have eb : hU.fromSpec pb = b := hU.fromSpec_primeIdealOf ⟨b, hbU⟩
  have hind : Topology.IsInducing ⇑hU.fromSpec := hU.fromSpec.isOpenEmbedding.isInducing
  have hsp : hU.fromSpec pa ⤳ hU.fromSpec pb := by rw [ea, eb]; exact hab
  have hle : pa ≤ pb := (PrimeSpectrum.le_iff_specializes pa pb).mpr (hind.specializes_iff.mp hsp)
  have hne' : pa ≠ pb := by
    intro h
    apply hne
    rw [← ea, ← eb, h]
  have hlt : pa.asIdeal < pb.asIdeal :=
    (PrimeSpectrum.asIdeal_lt_asIdeal pa pb).mpr (lt_of_le_of_ne hle hne')
  have hfin : pb.asIdeal.height ≠ ⊤ := Ideal.height_ne_top pb.isPrime.ne_top
  have hn : ((pb.asIdeal.height.toNat : ℕ) : ℕ∞) = pb.asIdeal.height := ENat.coe_toNat hfin
  have hhlt : pa.asIdeal.height < pb.asIdeal.height := by
    have h1 := (Ideal.height_le_iff (p := pb.asIdeal) (n := pb.asIdeal.height.toNat)).mp hn.ge
      pa.asIdeal pa.isPrime hlt
    rwa [hn] at h1
  have da : ringKrullDim (Z.presheaf.stalk a) = (pa.asIdeal.height : WithBot ℕ∞) :=
    @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ pa.asIdeal _
      (Z.presheaf.stalk (⟨a, haU⟩ : U)) _
      (TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨a, haU⟩)
      (hU.isLocalization_stalk ⟨a, haU⟩)
  have db : ringKrullDim (Z.presheaf.stalk b) = (pb.asIdeal.height : WithBot ℕ∞) :=
    @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ pb.asIdeal _
      (Z.presheaf.stalk (⟨b, hbU⟩ : U)) _
      (TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨b, hbU⟩)
      (hU.isLocalization_stalk ⟨b, hbU⟩)
  rw [da, db]
  exact WithBot.coe_lt_coe.mpr hhlt

theorem wcpa_dj_lr1k_gn_closed_dim_ge : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X) [QuasiCompact (φ ≫ ι)] [QuasiSeparated (φ ≫ ι)], wcpaDjLkModel W uX ι → ∀ w : ↥(wcpaDjLkFib W (φ ≫ ι) uX), IsClosed ({w} : Set ↥(wcpaDjLkFib W (φ ≫ ι) uX)) → ((1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim ((wcpaDjLkFib W (φ ≫ ι) uX).presheaf.stalk w) :=
by

  have s1 : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (z : Z), IsClosed ({z} : Set Z) →
      ¬ (((1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (Z.presheaf.stalk z)) → IsOpen ({z} : Set Z) := by
    intro Z _ z hz hlt
    have hnogen : ∀ ξ : Z, ξ ⤳ z → ξ = z := by
      intro ξ hξ
      by_contra hne
      apply hlt
      have h1 := wcpa_dj_rtsx_dim_lt_of_specializes Z ξ z hξ hne
      have h0 : (0 : WithBot ℕ∞) ≤ ringKrullDim (Z.presheaf.stalk ξ) := ringKrullDim_nonneg_of_nontrivial
      have h2 : (0 : WithBot ℕ∞) < ringKrullDim (Z.presheaf.stalk z) := lt_of_le_of_lt h0 h1
      obtain ⟨n, hn⟩ := WithBot.ne_bot_iff_exists.mp (ne_bot_of_gt h2)
      rw [← hn] at h2 ⊢
      have h3 : (0 : ℕ∞) < n := by exact_mod_cast h2
      have h4 : (1 : ℕ∞) ≤ n := Order.one_le_iff_pos.mpr h3
      exact_mod_cast h4
    obtain ⟨V, hV, hzV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
      (show z ∈ (⊤ : Z.Opens) from trivial)
    haveI : IsNoetherianRing Γ(Z, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
    haveI : TopologicalSpace.NoetherianSpace V := noetherianSpace_of_isAffineOpen V hV
    set z' : V := ⟨z, hzV⟩ with hz'
    have hfinC := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := V)
    set F : Set V := ⋃ D ∈ {D ∈ irreducibleComponents V | z' ∉ D}, D with hF
    have hFcl : IsClosed F :=
      (hfinC.subset (Set.sep_subset _ _)).isClosed_biUnion
        (fun D hD => isClosed_of_mem_irreducibleComponents D hD.1)
    have hFc : Fᶜ = {z'} := by
      ext x
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      constructor
      · intro hx
        obtain ⟨D, hD, hxD⟩ :=
          exists_mem_irreducibleComponents_subset_of_isIrreducible {x} isIrreducible_singleton
        have hzD : z' ∈ D := by
          by_contra hzD
          apply hx
          rw [hF, Set.mem_iUnion₂]
          exact ⟨D, ⟨hD, hzD⟩, hxD rfl⟩
        have hirrD : IsIrreducible (Subtype.val '' D : Set Z) :=
          IsIrreducible.image hD.1 Subtype.val continuous_subtype_val.continuousOn
        have hgen := hirrD.isGenericPoint_genericPoint_closure
        have hsp : hirrD.genericPoint ⤳ z :=
          hgen.specializes (subset_closure ⟨z', hzD, rfl⟩)
        have heq := hnogen _ hsp
        have hxcl : x.1 ∈ closure (Subtype.val '' D : Set Z) :=
          subset_closure (Set.mem_image_of_mem Subtype.val (hxD rfl))
        rw [← hgen.def, heq, hz.closure_eq, Set.mem_singleton_iff] at hxcl
        exact Subtype.ext hxcl
      · intro hx hxF
        rw [hF, Set.mem_iUnion₂] at hxF
        obtain ⟨D, hD, hxD⟩ := hxF
        rw [hx] at hxD
        exact hD.2 hxD
    have hopenV : IsOpen ({z'} : Set V) := by rw [← hFc]; exact hFcl.isOpen_compl
    have himg := V.isOpen.isOpenMap_subtype_val _ hopenV
    convert himg using 1
    ext y
    constructor
    · intro hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact ⟨z', rfl, rfl⟩
    · rintro ⟨a, ha, rfl⟩
      have ha' : a = z' := ha
      show a.1 = z
      rw [ha']

  have s5 : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (q : Z ⟶ Spec (.of K)) [IsFinite q]
      [SmoothOfRelativeDimension 1 q], IsEmpty Z := by
    intro K _ Z q _ _
    by_contra hne
    rw [not_isEmpty_iff] at hne
    haveI : IsAffine Z := isAffine_of_isAffineHom q
    obtain ⟨z, -, hz⟩ := IsClosed.exists_closed_singleton (X := Z) isClosed_univ Set.univ_nonempty
    have h1 := wc_lfi_smooth_stalk_dim K Z q 1 z hz
    have hfin : (q.appTop).hom.Finite := Scheme.Hom.finite_appTop q
    let φK : K →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop).hom
    have hφK : φK.Finite := by
      show (q.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom).Finite
      exact hfin.comp (RingHom.Finite.of_surjective _
        (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.symm.surjective)
    letI : Algebra K Γ(Z, ⊤) := φK.toAlgebra
    haveI : Module.Finite K Γ(Z, ⊤) := hφK
    haveI : IsArtinianRing Γ(Z, ⊤) := IsArtinianRing.of_finite K Γ(Z, ⊤)
    have hB : ringKrullDim Γ(Z, ⊤) ≤ 0 := Ring.krullDimLE_iff.mp inferInstance
    have hU : IsAffineOpen (⊤ : Z.Opens) := isAffineOpen_top Z
    letI : Algebra Γ(Z, ⊤) (Z.presheaf.stalk z) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf (⟨z, trivial⟩ : (⊤ : Z.Opens))
    haveI hloc := hU.isLocalization_stalk ⟨z, trivial⟩
    have h2 : ringKrullDim (Z.presheaf.stalk z) = (hU.primeIdealOf ⟨z, trivial⟩).asIdeal.height :=
      IsLocalization.AtPrime.ringKrullDim_eq_height _ _
    have h3 := Ideal.height_le_ringKrullDim_of_ne_top (hU.primeIdealOf ⟨z, trivial⟩).isPrime.ne_top
    have h4 : ringKrullDim (Z.presheaf.stalk z) ≤ 0 := by rw [h2]; exact h3.trans hB
    rw [h1] at h4
    have h5 : (0 : WithBot ℕ∞) < ((1 : ℕ) : WithBot ℕ∞) := by
      exact_mod_cast (zero_lt_one : (0 : ℕ) < 1)
    exact absurd h4 (not_le.mpr h5)
  intro Ω _ _ W hW hWt Ct φ hcov X uX ι _ _ hM w hw
  obtain ⟨hp, hsm, hirr, hfin, hgen⟩ := hcov
  obtain ⟨hss, hXp, hpb⟩ := hM
  haveI hnf : IsFinite (φ ≫ ι).fromNormalization :=
    wcpa_dj_lr1s_normalization_finite Ω W hW hWt Ct (φ ≫ wcProjKStr Ω 1) φ hp hsm hirr hfin rfl
      hgen X uX ι hss hXp hpb
  haveI : IsProper uX := hss.2.1
  haveI hgprop : IsProper ((φ ≫ ι).fromNormalization ≫ uX) := inferInstance
  haveI : LocallyOfFiniteType (Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    inferInstance
  haveI : IsLocallyNoetherian (wcpaDjLkFib W (φ ≫ ι) uX) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  haveI : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W
  by_contra hlt
  have hopen : IsOpen ({w} : Set ↥(wcpaDjLkFib W (φ ≫ ι) uX)) :=
    s1 (wcpaDjLkFib W (φ ≫ ι) uX) w hw hlt

  haveI hsci : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsLocalHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq]; infer_instance
  have hs_pt : ∀ p : Spec (.of (IsLocalRing.ResidueField ↥W)),
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) p =
        IsLocalRing.closedPoint ↥W := by
    intro p
    have hp' : p = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) := Subsingleton.elim _ _
    subst hp'
    exact IsLocalRing.comap_closedPoint (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
  have hfib : ∀ y : (φ ≫ ι).normalization, ((φ ≫ ι).fromNormalization ≫ uX) y =
      IsLocalRing.closedPoint ↥W ↔ y ∈ Set.range (Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := by
    intro y
    rw [Scheme.Pullback.range_fst, Set.mem_preimage]
    constructor
    · intro h
      exact ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W), (hs_pt _).trans h.symm⟩
    · rintro ⟨p, hp'⟩
      exact hp'.symm.trans (hs_pt p)
  have hfce := Scheme.Hom.isClosedEmbedding (Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
  obtain ⟨U, hU, hUw⟩ := hfce.isInducing.isOpen_iff.mp hopen
  have hy0cl : IsClosed ({Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w} :
        Set (φ ≫ ι).normalization) := by
    have := hfce.isClosedMap _ hw
    rwa [Set.image_singleton] at this
  have hy0U : Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w ∈ U := by
    have : w ∈ (Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹' U := by
      rw [hUw]; rfl
    exact this
  have hy0F : ((φ ≫ ι).fromNormalization ≫ uX) (Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w) =
        IsLocalRing.closedPoint ↥W := (hfib _).mpr ⟨w, rfl⟩

  have hflat := wcpa_dj_lr1s_normalization_flat Ω W Ct (φ ≫ wcProjKStr Ω 1) φ X uX ι hfin rfl hpb
  have hgf := wcpa_dj_lr1s_normalization_generic_fibre Ω W Ct (φ ≫ wcProjKStr Ω 1) φ X uX ι hfin
    rfl hpb
  have hη : ∀ q : Spec (.of ↥W),
      Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) (IsLocalRing.closedPoint Ω) ⤳ q := by
    intro q
    refine (PrimeSpectrum.le_iff_specializes (R := ↥W) _ q).mp ?_
    intro a ha
    by_cases ha0 : a = 0
    · rw [ha0]; exact q.asIdeal.zero_mem
    · exfalso
      have ha' : algebraMap ↥W Ω a ∈ IsLocalRing.maximalIdeal Ω := ha
      have hu : IsUnit (algebraMap ↥W Ω a) := by
        refine isUnit_iff_ne_zero.mpr (fun h => ha0 ?_)
        have h' : (a : Ω) = ((0 : ↥W) : Ω) := h
        exact Subtype.ext h'
      exact (IsLocalRing.mem_maximalIdeal _).mp ha' hu
  haveI hYirr : IrreducibleSpace (φ ≫ ι).normalization := by
    rw [irreducibleSpace_def]
    have h1 : IsIrreducible (closure ((φ ≫ ι).toNormalization '' (⊤ : Set Ct))) :=
      (((irreducibleSpace_def Ct).mp hirr).image _
        (φ ≫ ι).toNormalization.continuous.continuousOn).closure
    have h2 : closure ((φ ≫ ι).toNormalization '' (⊤ : Set Ct)) = ⊤ := by
      refine Set.eq_univ_of_forall (fun y => ?_)
      obtain ⟨y', hy'y, hy'⟩ := Flat.generalizingMap ((φ ≫ ι).fromNormalization ≫ uX) (hη _)
      obtain ⟨c, hc, -⟩ := Scheme.exists_preimage_of_isPullback hgf y' (IsLocalRing.closedPoint Ω) hy'
      have hmem : y' ∈ (φ ≫ ι).toNormalization '' (⊤ : Set Ct) := ⟨c, trivial, hc⟩
      exact closure_mono (Set.singleton_subset_iff.mpr hmem)
        (specializes_iff_mem_closure.mp hy'y)
    rw [← h2]; exact h1
  haveI hYconn : PreconnectedSpace (φ ≫ ι).normalization :=
    ⟨((irreducibleSpace_def _).mp hYirr).2.isPreconnected⟩

  have hone : ∀ y : (φ ≫ ι).normalization, ((φ ≫ ι).fromNormalization ≫ uX) y =
      IsLocalRing.closedPoint ↥W → y = Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w := by
    have hFcl : IsClosed (((φ ≫ ι).fromNormalization ≫ uX) ⁻¹' {IsLocalRing.closedPoint ↥W}) :=
      (IsLocalRing.isClosed_singleton_closedPoint ↥W).preimage
        ((φ ≫ ι).fromNormalization ≫ uX).continuous
    obtain ⟨C, hC, hCiff⟩ := wc_proper_henselian_closed_fibre_clopen_extend ↥W _
      ((φ ≫ ι).fromNormalization ≫ uX) _
      ((((φ ≫ ι).fromNormalization ≫ uX) ⁻¹' {IsLocalRing.closedPoint ↥W}) ∩ Uᶜ) hy0cl
      (hFcl.inter hU.isClosed_compl)
      (by
        rw [Set.disjoint_singleton_left]
        rintro ⟨-, h⟩
        exact h hy0U)
      (by
        ext y
        simp only [Set.mem_union, Set.mem_singleton_iff, Set.mem_inter_iff, Set.mem_preimage,
          Set.mem_compl_iff]
        constructor
        · rintro (h | ⟨h, -⟩)
          · rw [h]; exact hy0F
          · exact h
        · intro h
          by_cases hyU : y ∈ U
          · left
            obtain ⟨w', rfl⟩ := (hfib y).mp h
            have : w' ∈ (Limits.pullback.fst ((φ ≫ ι).fromNormalization ≫ uX)
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹' U :=
              hyU
            rw [hUw, Set.mem_singleton_iff] at this
            rw [this]
          · right; exact ⟨h, hyU⟩)
    rcases isClopen_iff.mp hC with h | h
    · exfalso
      have := (hCiff _ hy0F).mpr rfl
      rw [h] at this
      exact this
    · intro y hy
      have := (hCiff y hy).mp (by rw [h]; trivial)
      exact this

  have hgfin : IsFinite ((φ ≫ ι).fromNormalization ≫ uX) :=
    wcpa_dj_lsa_fl_zmt ↥W _ (Spec (.of ↥W)) ((φ ≫ ι).fromNormalization ≫ uX) (𝟙 _) inferInstance
      (by rw [Category.comp_id]; infer_instance)
      (by
        intro x x' hx hxx'
        rw [Category.comp_id] at hx
        rw [hone x hx, hone x' (hxx'.trans hx)])
  haveI hctfin : IsFinite (φ ≫ wcProjKStr Ω 1) :=
    MorphismProperty.of_isPullback (P := @IsFinite) hgf hgfin
  haveI := hsm
  have hempty := s5 Ω Ct (φ ≫ wcProjKStr Ω 1)
  exact isEmptyElim (Classical.choice hirr.toNonempty)

theorem wcpa_dj_lr1k_gn_delta_zero_regular : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [_root_.IsReduced R], ringKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → Module.length R (↥(integralClosure R (FractionRing R)) ⧸ LinearMap.range (Algebra.linearMap R ↥(integralClosure R (FractionRing R)))) = 0 → IsRegularLocalRing R :=
by
  intro R _ _ _ _ hdim hlen
  classical

  have hIC : ∀ x : FractionRing R, _root_.IsIntegral R x →
      ∃ y : R, algebraMap R (FractionRing R) y = x := by
    intro x hx
    have hsub := Module.length_eq_zero_iff.mp hlen
    have htop := Submodule.Quotient.subsingleton_iff.mp hsub
    have hmem : (⟨x, (mem_integralClosure_iff R (FractionRing R)).mpr hx⟩ :
        integralClosure R (FractionRing R)) ∈
        LinearMap.range (Algebra.linearMap R (integralClosure R (FractionRing R))) := by
      rw [htop]; trivial
    obtain ⟨y, hy⟩ := hmem
    refine ⟨y, ?_⟩
    have := congrArg Subtype.val hy
    simpa [Algebra.linearMap_apply] using this

  have hsplit : ∀ a b : R, a * b = 0 → a + b ∈ nonZeroDivisors R → a = 0 ∨ b = 0 := by
    intro a b hab hc
    let s : nonZeroDivisors R := ⟨a + b, hc⟩
    set e : FractionRing R := IsLocalization.mk' (FractionRing R) a s with he
    have hspec : e * algebraMap R (FractionRing R) (a + b) = algebraMap R (FractionRing R) a :=
      IsLocalization.mk'_spec (FractionRing R) a s
    have hu : IsUnit (algebraMap R (FractionRing R) (a + b)) :=
      IsLocalization.map_units (FractionRing R) s
    have hidem : e * e = e := by
      apply hu.mul_right_cancel
      apply hu.mul_right_cancel
      calc e * e * algebraMap R (FractionRing R) (a + b) * algebraMap R (FractionRing R) (a + b)
          = (e * algebraMap R (FractionRing R) (a + b)) *
              (e * algebraMap R (FractionRing R) (a + b)) := by ring
        _ = algebraMap R (FractionRing R) a * algebraMap R (FractionRing R) a := by rw [hspec]
        _ = algebraMap R (FractionRing R) (a * (a + b)) := by rw [mul_add, hab, add_zero, map_mul]
        _ = e * algebraMap R (FractionRing R) (a + b) * algebraMap R (FractionRing R) (a + b) := by
          rw [hspec, map_mul]
    have hint : _root_.IsIntegral R e := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X, ?_, ?_⟩
      · exact Polynomial.monic_X_pow_sub (by rw [Polynomial.degree_X]; norm_num)
      · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hidem,
          sub_self]
    obtain ⟨y, hy⟩ := hIC e hint
    have hinj := IsFractionRing.injective R (FractionRing R)
    have hyc : y * (a + b) = a := hinj (by rw [map_mul, hy, hspec])
    have hyy : y * y = y := hinj (by rw [map_mul, hy, hidem])
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self y with h | h
    · right
      have h1 : y * (y - 1) = 0 := by rw [mul_sub, hyy, mul_one, sub_self]
      have hy1 : y = 1 := sub_eq_zero.mp ((h.mul_right_eq_zero).mp h1)
      rw [hy1, one_mul] at hyc
      linear_combination hyc
    · left
      have h1 : (1 - y) * y = 0 := by rw [sub_mul, one_mul, hyy, sub_self]
      have hy0 : y = 0 := (h.mul_right_eq_zero).mp h1
      rw [hy0, zero_mul] at hyc
      exact hyc.symm

  haveI hbot : (⊥ : Ideal R).IsPrime := by
    by_contra hnp
    have hfin := minimalPrimes.finite_of_isNoetherianRing R
    set S := hfin.toFinset with hS
    have hmemS : ∀ r, r ∈ S ↔ r ∈ minimalPrimes R := fun r => hfin.mem_toFinset
    have hprime : ∀ r ∈ minimalPrimes R, r.IsPrime := fun r hr => hr.1.1
    have hmin : ∀ r ∈ minimalPrimes R, ∀ p : Ideal R, p.IsPrime → p ≤ r → r ≤ p :=
      fun r hr p hp hle => hr.2 ⟨hp, bot_le⟩ hle
    have hinf : sInf (minimalPrimes R) = ⊥ := by
      have := @Ideal.sInf_minimalPrimes R _ ⊥
      rw [Ideal.radical_bot_of_isReduced] at this
      exact this
    have hmemInf : ∀ x : R, (∀ r ∈ minimalPrimes R, x ∈ r) → x = 0 := by
      intro x hx
      have h1 : x ∈ sInf (minimalPrimes R) := Submodule.mem_sInf.mpr hx
      rw [hinf] at h1
      exact (Submodule.mem_bot R).mp h1
    obtain ⟨M, hM⟩ := Ideal.exists_maximal R
    haveI := hM.isPrime
    obtain ⟨p, hp, -⟩ := Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal R)) (J := M) bot_le
    have hp' : p ∈ minimalPrimes R := hp
    have hq : ∃ q ∈ minimalPrimes R, q ≠ p := by
      by_contra hcon
      push_neg at hcon
      apply hnp
      have hpb : p = ⊥ := by
        apply le_antisymm _ bot_le
        intro x hx
        exact (Submodule.mem_bot R).mpr (hmemInf x (fun r hr => by rw [hcon r hr]; exact hx))
      rw [← hpb]
      exact hprime p hp'
    obtain ⟨q, hq, hqp⟩ := hq
    set J : Ideal R := (S.erase p).inf id with hJ
    have hJr : ∀ r ∈ minimalPrimes R, r ≠ p → J ≤ r := fun r hr hrp =>
      Finset.inf_le (f := id) (by rw [Finset.mem_erase]; exact ⟨hrp, (hmemS r).mpr hr⟩)
    have hJq : J ≤ q := hJr q hq hqp
    have hpJ : ∀ x, x ∈ p → x ∈ J → x = 0 := by
      intro x hxp hxJ
      apply hmemInf
      intro r hr
      by_cases hrp : r = p
      · rw [hrp]; exact hxp
      · exact hJr r hr hrp hxJ
    have havoid : ¬ ((p ⊔ J : Ideal R) : Set R) ⊆ ⋃ i ∈ (S : Set (Ideal R)), ((id i : Ideal R) : Set R) := by
      intro hsub
      obtain ⟨r, hrS, hr⟩ := (Ideal.subset_union_prime (s := S) (f := id) p p
        (fun i hi _ _ => hprime i ((hmemS i).mp hi))).mp hsub
      have hrm := (hmemS r).mp hrS
      have hpr : p ≤ r := le_trans le_sup_left hr
      have hrp : r ≤ p := hmin r hrm p (hprime p hp') hpr
      have hJp : J ≤ p := le_trans le_sup_right (hr.trans hrp)
      obtain ⟨r', hr'S, hr'p⟩ := (Ideal.IsPrime.inf_le' (hprime p hp')).mp hJp
      rw [Finset.mem_erase] at hr'S
      have hr'm := (hmemS r').mp hr'S.2
      have h2 : p ≤ r' := hmin p hp' r' (hprime r' hr'm) hr'p
      exact hr'S.1 (le_antisymm hr'p h2)
    rw [Set.not_subset] at havoid
    obtain ⟨c, hcmem, hcnot⟩ := havoid
    have hcr : ∀ r ∈ minimalPrimes R, c ∉ r := by
      intro r hr hcr
      apply hcnot
      exact Set.mem_biUnion (Finset.mem_coe.mpr ((hmemS r).mpr hr)) hcr
    obtain ⟨b, hb, a, ha, hba⟩ := Submodule.mem_sup.mp hcmem
    have hab : a * b = 0 := hpJ _ (Ideal.mul_mem_left _ _ hb) (Ideal.mul_mem_right _ _ ha)
    have hcnz : a + b ∈ nonZeroDivisors R := by
      rw [mem_nonZeroDivisors_iff]
      have key : ∀ x, (a + b) * x = 0 → x = 0 := by
        intro x hx
        apply hmemInf
        intro r hr
        have h0 : (a + b) * x ∈ r := by rw [hx]; exact r.zero_mem
        rcases (hprime r hr).mem_or_mem h0 with h | h
        · exact absurd (show c ∈ r by rw [← hba, add_comm]; exact h) (hcr r hr)
        · exact h
      exact ⟨key, fun x hx => key x (by rw [mul_comm]; exact hx)⟩
    rcases hsplit a b hab hcnz with h | h
    · apply hcr p hp'
      rw [← hba, h, add_zero]
      exact hb
    · apply hcr q hq
      rw [← hba, h, zero_add]
      exact hJq ha
  haveI : IsDomain R := IsDomain.of_bot_isPrime R

  haveI : IsIntegrallyClosed R :=
    (isIntegrallyClosed_iff (FractionRing R)).mpr (fun {x} hx => hIC x hx)

  rw [isRegularLocalRing_iff]
  by_cases hF : IsField R
  · have hm : IsLocalRing.maximalIdeal R = ⊥ := IsLocalRing.isField_iff_maximalIdeal_eq.mp hF
    rw [hm, Submodule.spanFinrank_bot, ringKrullDim_eq_zero_of_isField hF]
    all_goals norm_cast
  · have tfae := IsDiscreteValuationRing.TFAE R hF
    haveI hdvr : IsDiscreteValuationRing R := by
      apply (tfae.out 4 1).mp
      refine ⟨inferInstance, IsLocalRing.maximalIdeal R, ⟨?_, inferInstance⟩, ?_⟩
      · intro h
        exact hF (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
      · rintro P ⟨hP0, hP⟩
        haveI : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr hdim
        rcases Ring.krullDimLE_one_iff.mp inferInstance P hP with h | h
        · exact absurd (le_antisymm (h.2 ⟨hbot, bot_le⟩ bot_le) bot_le) hP0
        · exact IsLocalRing.eq_maximalIdeal h
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    rw [hϖ.maximalIdeal_eq, IsPrincipalIdealRing.ringKrullDim_eq_one R hF]
    have hspan : (Ideal.span {ϖ} : Ideal R) = R ∙ ϖ := rfl
    rw [hspan, Submodule.spanFinrank_singleton hϖ.ne_zero]
    all_goals norm_cast

theorem wcpa_dj_lr1k_gn_regular_closed_smooth : ∀ (F : Type u) [Field F] [PerfectField F] (Z : Scheme.{u}) (sZ : Z ⟶ Spec (.of F)) [LocallyOfFiniteType sZ] (d : ℕ) (z : Z), IsClosed ({z} : Set Z) → IsRegularLocalRing (Z.presheaf.stalk z) → ringKrullDim (Z.presheaf.stalk z) = (d : WithBot ℕ∞) → ∃ U : Z.Opens, z ∈ U ∧ SmoothOfRelativeDimension d (U.ι ≫ sZ) :=
by
  intro F _ _ Z sZ _ d z hz hreg hdim
  classical

  have s4 : ∀ (k S : Type u) [Field k] [CommRing S] [IsLocalRing S] [IsNoetherianRing S]
      [Algebra k S], Module.Free S Ω[S⁄k] → Subsingleton Ω[IsLocalRing.ResidueField S⁄k] →
      Module.finrank S Ω[S⁄k] ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal S) := by
    intro k S _ _ _ _ _ hfree hsub
    haveI := hfree
    have hsurj : Function.Surjective (algebraMap S (IsLocalRing.ResidueField S)) :=
      IsLocalRing.residue_surjective
    have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k S
      (IsLocalRing.ResidueField S) hsurj
    have hc : Function.Surjective
        (KaehlerDifferential.kerCotangentToTensor k S (IsLocalRing.ResidueField S)) := by
      intro y
      have h0 : KaehlerDifferential.mapBaseChange k S (IsLocalRing.ResidueField S) y = 0 :=
        Subsingleton.elim _ _
      exact (hex y).mp h0
    have hK : RingHom.ker (algebraMap S (IsLocalRing.ResidueField S)) =
        IsLocalRing.maximalIdeal S := IsLocalRing.ker_residue
    have hle : IsLocalRing.maximalIdeal S ≤ Ideal.comap (AlgHom.id S S)
        (RingHom.ker (algebraMap S (IsLocalRing.ResidueField S))) := by
      intro x hx
      rw [Ideal.mem_comap, AlgHom.id_apply, hK]
      exact hx
    let ι := Ideal.mapCotangent (IsLocalRing.maximalIdeal S)
      (RingHom.ker (algebraMap S (IsLocalRing.ResidueField S))) (AlgHom.id S S) hle
    have hι : Function.Surjective ι := by
      intro w
      obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective _ w
      have hx' : x ∈ IsLocalRing.maximalIdeal S := by rw [← hK]; exact hx
      refine ⟨(IsLocalRing.maximalIdeal S).toCotangent ⟨x, hx'⟩, ?_⟩
      rw [Ideal.mapCotangent_toCotangent]
      rfl
    let f : IsLocalRing.CotangentSpace S →ₗ[S]
        TensorProduct S (IsLocalRing.ResidueField S) Ω[S⁄k] :=
      (KaehlerDifferential.kerCotangentToTensor k S (IsLocalRing.ResidueField S)).comp ι
    have hf : Function.Surjective f := hc.comp hι
    let fκ := LinearMap.extendScalarsOfSurjective hsurj f
    have hfκ : Function.Surjective fκ := by
      intro y
      obtain ⟨x, hx⟩ := hf y
      exact ⟨x, by simpa [fκ, LinearMap.extendScalarsOfSurjective_apply] using hx⟩
    have h8 : Module.finrank (IsLocalRing.ResidueField S)
        (TensorProduct S (IsLocalRing.ResidueField S) Ω[S⁄k]) ≤
        Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S) := by
      have h1 := LinearMap.finrank_range_le fκ
      rw [LinearMap.range_eq_top.mpr hfκ, finrank_top] at h1
      exact h1
    have h9 : Module.finrank (IsLocalRing.ResidueField S)
        (TensorProduct S (IsLocalRing.ResidueField S) Ω[S⁄k]) = Module.finrank S Ω[S⁄k] :=
      Module.finrank_baseChange
    rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace S, ← h9]
    exact h8

  have s3 : ∀ (k A S : Type u) [Field k] [PerfectField k] [CommRing A] [CommRing S]
      [IsLocalRing S] [Algebra k A] [Algebra.FiniteType k A] [Algebra A S] [Algebra k S]
      [IsScalarTower k A S] (m : Ideal A) [m.IsMaximal] [IsLocalization.AtPrime S m],
      Subsingleton Ω[IsLocalRing.ResidueField S⁄k] ∧
        Algebra.FormallySmooth k (IsLocalRing.ResidueField S) := by
    intro k A S _ _ _ _ _ _ _ _ _ _ m _ _
    let e₀ := IsLocalization.AtPrime.equivQuotMaximalIdeal m S
    have he : ∀ c : k, e₀ (algebraMap k (A ⧸ m) c) =
        algebraMap k (IsLocalRing.ResidueField S) c := by
      intro c
      rw [IsScalarTower.algebraMap_apply k A (A ⧸ m), Ideal.Quotient.algebraMap_eq,
        IsLocalization.AtPrime.equivQuotMaximalIdeal_apply_mk,
        IsScalarTower.algebraMap_apply k S (IsLocalRing.ResidueField S),
        IsScalarTower.algebraMap_apply k A S]
      rfl
    let e : (A ⧸ m) ≃ₐ[k] IsLocalRing.ResidueField S := AlgEquiv.ofRingEquiv (f := e₀) he
    letI : Field (A ⧸ m) := Ideal.Quotient.field m
    haveI : Algebra.FiniteType k (A ⧸ m) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k m) (Ideal.Quotient.mkₐ_surjective k m)
    haveI : Module.Finite k (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ m)
    haveI : Module.Finite k (IsLocalRing.ResidueField S) := Module.Finite.equiv e.toLinearEquiv
    haveI : Algebra.IsSeparable k (IsLocalRing.ResidueField S) := inferInstance
    haveI := Algebra.FormallyUnramified.of_isSeparable k (IsLocalRing.ResidueField S)
    haveI := Algebra.FormallyEtale.of_isSeparable k (IsLocalRing.ResidueField S)
    exact ⟨inferInstance, inferInstance⟩

  have H9 : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (m : Ideal A)
      [m.IsMaximal], ∃ (N : ℕ) (n : Ideal (MvPolynomial (Fin N) F)) (_ : n.IsMaximal)
      (ψ : Localization.AtPrime n →ₐ[F] Localization.AtPrime m), Function.Surjective ψ := by
    intro A _ _ hA m _
    obtain ⟨N, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hA
    set πr : MvPolynomial (Fin N) F →+* A := π.toRingHom with hπr
    have hπr' : Function.Surjective πr := hπ
    haveI hn : (Ideal.comap πr m).IsMaximal := Ideal.comap_isMaximal_of_surjective πr hπr'
    have hto : ∀ x, Localization.localRingHom (Ideal.comap πr m) m πr rfl
        (algebraMap _ (Localization.AtPrime (Ideal.comap πr m)) x) =
        algebraMap A (Localization.AtPrime m) (πr x) :=
      fun x => Localization.localRingHom_to_map (Ideal.comap πr m) m πr rfl x
    have hmk : ∀ (x : MvPolynomial (Fin N) F) (y : (Ideal.comap πr m).primeCompl),
        Localization.localRingHom (Ideal.comap πr m) m πr rfl
          (IsLocalization.mk' (Localization.AtPrime (Ideal.comap πr m)) x y) =
        IsLocalization.mk' (Localization.AtPrime m) (πr x) ⟨πr y, y.2⟩ :=
      fun x y => Localization.localRingHom_mk' (Ideal.comap πr m) m πr rfl x y
    let ψ : Localization.AtPrime (Ideal.comap πr m) →ₐ[F] Localization.AtPrime m :=
      { Localization.localRingHom (Ideal.comap πr m) m πr rfl with
        commutes' := fun r => by
          show Localization.localRingHom (Ideal.comap πr m) m πr rfl (algebraMap F _ r) = _
          rw [IsScalarTower.algebraMap_apply F (MvPolynomial (Fin N) F)
              (Localization.AtPrime (Ideal.comap πr m)), hto]
          have : πr (algebraMap F _ r) = algebraMap F A r := π.commutes r
          rw [this]
          exact (IsScalarTower.algebraMap_apply F A _ r).symm }
    refine ⟨N, Ideal.comap πr m, hn, ψ, ?_⟩
    intro y
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl y
    obtain ⟨a', ha'⟩ := hπr' a
    obtain ⟨s', hs'⟩ := hπr' (s : A)
    have hs'n : s' ∈ (Ideal.comap πr m).primeCompl := by
      show s' ∉ Ideal.comap πr m
      rw [Ideal.mem_comap, hs']
      exact s.2
    refine ⟨IsLocalization.mk' _ a' ⟨s', hs'n⟩, ?_⟩
    show Localization.localRingHom (Ideal.comap πr m) m πr rfl _ =
      IsLocalization.mk' (Localization.AtPrime m) a s
    rw [hmk, ha']
    congr 1
    ext
    exact hs'

  have hD : ∀ (T : Type u) [CommRing T], IsRegularLocalRing T → IsDomain T :=
    fun T _ hT => wcpa_regular_isDomain T wcpa_rs_quotient_regular hT
  have H10 : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra.FiniteType F A] (m : Ideal A)
      [m.IsMaximal], IsRegularLocalRing (Localization.AtPrime m) →
      Algebra.FormallySmooth F (Localization.AtPrime m) := by
    intro A _ _ _ m _ hregm
    obtain ⟨N, n, hn, ψ, hψ⟩ := H9 A m
    haveI := hn
    obtain ⟨h1, h2, h3, h4, h5⟩ := wcpa_affine_local_smooth_data F N n
    have hRreg : IsRegularLocalRing (Localization.AtPrime n) := by
      have hdim : ringKrullDim (Localization.AtPrime n) = (n.height : WithBot ℕ∞) :=
        IsLocalization.AtPrime.ringKrullDim_eq_height n _
      have hN := wcpa_mvpoly_maximal_height F N n hn
      have he := wcpa_embdim_le_rank_omega F (Localization.AtPrime n) h1 h2 h3 h5
      rw [h4] at he
      have hle := ringKrullDim_le_spanFinrank_maximalIdeal (Localization.AtPrime n)
      refine IsRegularLocalRing.mk (le_antisymm ?_ hle)
      calc ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime n)) : ℕ)
            : WithBot ℕ∞) ≤ (((N : ℕ∞)) : WithBot ℕ∞) := by exact_mod_cast he
        _ ≤ (n.height : WithBot ℕ∞) := by exact_mod_cast hN
        _ = ringKrullDim (Localization.AtPrime n) := hdim.symm
    have hq : IsRegularLocalRing (Localization.AtPrime n ⧸ RingHom.ker ψ) :=
      IsRegularLocalRing.of_ringEquiv (Ideal.quotientKerAlgEquivOfSurjective hψ).toRingEquiv.symm
    have hcon := wcpa_regular_quotient_conormal (Localization.AtPrime n) hD
      wcpa_rs_quotient_regular (RingHom.ker ψ) hq
    exact wcpa_conormal_formallySmooth F (Localization.AtPrime n) (Localization.AtPrime m) ψ hψ
      h1 h2 h3 h5 hcon

  have s2 : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra F A] [Algebra.FiniteType F A]
      [Algebra A S] [Algebra F S] [IsScalarTower F A S] (m : Ideal A) [m.IsMaximal]
      [IsLocalization.AtPrime S m], IsRegularLocalRing S → Algebra.FormallySmooth F S := by
    intro A S _ _ _ _ _ _ _ m _ _ hreg
    let e : Localization.AtPrime m ≃ₐ[A] S :=
      IsLocalization.algEquiv m.primeCompl (Localization.AtPrime m) S
    haveI := hreg
    have hregm : IsRegularLocalRing (Localization.AtPrime m) :=
      IsRegularLocalRing.of_ringEquiv e.symm.toRingEquiv
    haveI := H10 A m hregm
    exact Algebra.FormallySmooth.of_equiv (e.restrictScalars F)

  obtain ⟨V, hV, hzV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
  have e₀ : V ≤ sZ ⁻¹ᵁ ⊤ := fun _ _ => trivial
  letI algA : Algebra F Γ(Z, V) :=
    ((sZ.appLE ⊤ V e₀).hom.comp (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom).toAlgebra
  letI algS : Algebra Γ(Z, V) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hzV⟩
  letI algF : Algebra F (Z.presheaf.stalk z) := (wcLdpConst F sZ z).toAlgebra
  haveI hloc : IsLocalization.AtPrime (Z.presheaf.stalk z)
      (hV.primeIdealOf ⟨z, hzV⟩).asIdeal := hV.isLocalization_stalk ⟨z, hzV⟩

  haveI hft : Algebra.FiniteType F Γ(Z, V) := by
    have hφ : (sZ.appLE ⊤ V e₀).hom.FiniteType :=
      HasRingHomProperty.appLE @LocallyOfFiniteType sZ inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ e₀
    have hsurjΓ : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom :=
      ((Scheme.ΓSpecIso (CommRingCat.of F)).symm.commRingCatIsoToRingEquiv).surjective
    have h : ((sZ.appLE ⊤ V e₀).hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom).FiniteType :=
      hφ.comp (RingHom.FiniteType.of_surjective _ hsurjΓ)
    exact h

  haveI hmax : (hV.primeIdealOf ⟨z, hzV⟩).asIdeal.IsMaximal := by
    apply (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp
    haveI := hV.isOpenImmersion_fromSpec
    have hinj : Function.Injective hV.fromSpec := hV.fromSpec.isOpenEmbedding.injective
    have hpre : (hV.fromSpec ⁻¹' {z} : Set _) = {hV.primeIdealOf ⟨z, hzV⟩} := by
      ext p
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hp
        apply hinj
        rw [hp, hV.fromSpec_primeIdealOf]
      · intro hp
        rw [hp, hV.fromSpec_primeIdealOf]
    have hc : IsClosed (hV.fromSpec ⁻¹' {z}) := hz.preimage hV.fromSpec.continuous
    first
      | (convert hc using 1; exact hpre.symm)
      | exact (hpre ▸ hc)
      | (rw [hpre] at hc; exact hc)

  have key : sZ.appTop ≫ Z.presheaf.germ ⊤ z trivial =
      sZ.appLE ⊤ V e₀ ≫ Z.presheaf.germ V z hzV := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    rfl
  haveI hst : IsScalarTower F Γ(Z, V) (Z.presheaf.stalk z) := by
    apply IsScalarTower.of_algebraMap_eq'
    ext c
    exact congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom c)) key

  haveI := hreg
  have hfs : Algebra.FormallySmooth F (Z.presheaf.stalk z) :=
    s2 Γ(Z, V) (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hzV⟩).asIdeal hreg
  haveI := hfs
  haveI : Algebra.EssFiniteType F Γ(Z, V) := Algebra.EssFiniteType.of_finiteType F Γ(Z, V)
  haveI : Algebra.EssFiniteType Γ(Z, V) (Z.presheaf.stalk z) :=
    Algebra.EssFiniteType.of_isLocalization (Z.presheaf.stalk z)
      (hV.primeIdealOf ⟨z, hzV⟩).asIdeal.primeCompl
  haveI : Algebra.EssFiniteType F (Z.presheaf.stalk z) :=
    Algebra.EssFiniteType.comp F Γ(Z, V) (Z.presheaf.stalk z)
  haveI hfin : Module.Finite (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄F] :=
    KaehlerDifferential.finite F _
  haveI hfree : Module.Free (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄F] :=
    Module.free_of_flat_of_isLocalRing
  obtain ⟨hsub, hκ⟩ := s3 F Γ(Z, V) (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hzV⟩).asIdeal
  have hge := wcpa_embdim_le_rank_omega F (Z.presheaf.stalk z) hfs hfree hfin hκ
  have hle := s4 F (Z.presheaf.stalk z) hfree hsub
  have hemb : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) : ℕ) :
      WithBot ℕ∞) = ((d : ℕ) : WithBot ℕ∞) := by
    rw [IsRegularLocalRing.spanFinrank_maximalIdeal, hdim]
  have hemb' : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) = d := by
    exact_mod_cast hemb
  have hrk : Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄F] = d := by omega

  exact wc_ldp_il_spread_abs F sZ d z hfs hfree hfin hrk

theorem wcpa_dj_lr1k_lf_smooth_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (C : Scheme.{u}) (γ : C ⟶ wcProjK Ω 1), wcpaDjLkCov Ω γ →
    ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X)
      [QuasiCompact (γ ≫ ι)] [QuasiSeparated (γ ≫ ι)],
    wcpaDjLkModel W uX ι → ∀ y : ↥(wcpaDjLkFib W (γ ≫ ι) uX),
    IsClosed ({y} : Set ↥(wcpaDjLkFib W (γ ≫ ι) uX)) →
    wcpaDjLkDelta ((wcpaDjLkFib W (γ ≫ ι) uX).presheaf.stalk y) = 0 →
    wcLfChart (S := ↥W) (Q := Polynomial ↥W) ((γ ≫ ι).fromNormalization ≫ uX)
      (wcNdPt W (γ ≫ ι) uX y)
      (Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal ↥W)) :=
by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y hy hδ

  have Hnat : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) (s : Γ(Y, ⊤)),
      (f.residueFieldMap x).hom ((Y.evaluation ⊤ (f x) trivial).hom s) =
        (X.evaluation ⊤ x trivial).hom (f.appTop.hom s) := by
    intro X Y f x s
    exact Scheme.evaluation_naturality_apply f (V := ⊤) x trivial s
  have Hspec : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S) (r : R),
      (Spec.map (CommRingCat.ofHom f)).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r) =
        (Scheme.ΓSpecIso (.of S)).inv.hom (f r) := by
    intro R S _ _ f r
    have := congrArg (fun φ => φ.hom r) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    exact this.symm
  have Hsig : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (a : A),
      wcCnSigma g ⊤ a = g.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
    intro A _ Y g a
    have hid : ∀ (h : (⊤ : Y.Opens) ≤ ⊤), Y.presheaf.map (homOfLE h).op = 𝟙 _ := fun h => by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : Y.Opens)) from rfl,
        CategoryTheory.Functor.map_id]
    simp only [wcCnSigma, RingHom.comp_apply, hid, CommRingCat.hom_id, RingHom.id_apply]

  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A], IsAlgClosed (IsLocalRing.ResidueField A) → ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) [LocallyOfFiniteType g] (y : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))), IsClosed ({y} : Set ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))))) → g (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) y) = IsLocalRing.closedPoint A ∧ Function.Surjective ((Y.evaluation ⊤ (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) y) trivial).hom.comp (wcCnSigma g ⊤)) := by
    intro A _ _ hκ Y g _ y hy
    haveI := hκ
    have gen : ∀ (s₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A)),
        s₀ = Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) →
        ∀ (y : ↥(Limits.pullback g s₀)), IsClosed ({y} : Set ↥(Limits.pullback g s₀)) →
        g (Limits.pullback.fst g s₀ y) = IsLocalRing.closedPoint A ∧
        Function.Surjective ((Y.evaluation ⊤ (Limits.pullback.fst g s₀ y) trivial).hom.comp
          (wcCnSigma g ⊤)) := by
      intro s₀ hs₀ y hy
      have hcond : Limits.pullback.fst g s₀ ≫ g = Limits.pullback.snd g s₀ ≫ s₀ :=
        Limits.pullback.condition
      have key : ∀ p : Spec (.of (IsLocalRing.ResidueField A)),
          (s₀ p).asIdeal = IsLocalRing.maximalIdeal A := by
        intro p
        subst hs₀
        show Ideal.comap (algebraMap A (IsLocalRing.ResidueField A)) p.asIdeal = _
        haveI := p.isPrime
        rw [Ideal.eq_bot_of_prime p.asIdeal, IsLocalRing.ResidueField.algebraMap_eq]
        exact IsLocalRing.ker_residue
      refine ⟨?_, ?_⟩
      · rw [← Scheme.Hom.comp_apply, hcond, Scheme.Hom.comp_apply]
        apply PrimeSpectrum.ext
        exact key _
      · intro t
        have hF := wc_closed_point_residue_surjective (IsLocalRing.ResidueField A) _
