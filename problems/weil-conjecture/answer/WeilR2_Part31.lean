  have s5 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (E : Type u) [CommRing E] (σ : A →+* E) (e : Spec (.of E) ⟶ Y) (x : ↥(Spec (.of E))), IsOpenImmersion e → Spec.map (CommRingCat.ofHom σ) = e ≫ g → g (e x) = IsLocalRing.closedPoint A → Function.Surjective ((Y.evaluation ⊤ (e x) trivial).hom.comp (wcCnSigma g ⊤)) → Ideal.comap σ (PrimeSpectrum.asIdeal x) = IsLocalRing.maximalIdeal A ∧ (∀ a : E, ∃ c : A, a - σ c ∈ PrimeSpectrum.asIdeal x) ∧ ∀ (Q : Type u) [CommRing Q] (j : A →+* Q) (ε : Q →+* E), ε.comp j = σ → Function.Bijective (Scheme.Hom.residueFieldMap (Spec.map (CommRingCat.ofHom ε)) x).hom := by
    intro A _ _ Y g E _ σ e x he hσ hcl hsurj
