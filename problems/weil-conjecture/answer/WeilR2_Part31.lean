by
  intro Ω _ _ W hW hWt C γ hcov X uX ι _ _ hM y _hy P _ e he hA
  obtain ⟨hnoeth, -⟩ := wcpa_dj_lr1k_ndmf_stalk_finiteness Ω W hW hWt C γ hcov X uX ι hM y
  haveI := hnoeth
  obtain ⟨ρ, -⟩ := wcpa_dj_lr1k_ndmf_fibre_stalk_levels Ω W X C (γ ≫ ι) uX y
  obtain ⟨f, hfc, hf⟩ := hA
  obtain ⟨h𝔫, ψ, -⟩ := wcpa_dj_lr1k_ndmf_modelA_levels Ω W
  have hI : Ideal.map (wcNdSig ((γ ≫ ι).fromNormalization ≫ uX) (wcNdPt W (γ ≫ ι) uX y))
      (IsLocalRing.maximalIdeal ↥W) ≤
      IsLocalRing.maximalIdeal
        ↥((γ ≫ ι).normalization.presheaf.stalk (wcNdPt W (γ ≫ ι) uX y)) := by
    rw [Ideal.map_le_iff_le_comap]
