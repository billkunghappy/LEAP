theorem wcpa_dj_lr1k_ebnt_bbd_content : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (n : ℕ) (P : ℕ → Polynomial ↥W), (∃ i ≤ n, P i ≠ 0) → ∃ (α : ↥W) (P' : ℕ → Polynomial ↥W) (j t : ℕ), α ≠ 0 ∧ j ≤ n ∧ (∀ i ≤ n, P i = Polynomial.C α * P' i) ∧ IsUnit ((P' j).coeff t) :=
by
  classical
  intro Ω _ W n P hP
  have hmin : ∀ s : Finset ↥W, s.Nonempty → ∃ a ∈ s, ∀ b ∈ s, a ∣ b := by
    intro s
    induction s using Finset.induction_on with
    | empty => intro h; exact absurd h Finset.not_nonempty_empty
    | insert x s₀ hx ih =>
      intro _
      rcases s₀.eq_empty_or_nonempty with h0 | h0
      · refine ⟨x, Finset.mem_insert_self x s₀, ?_⟩
        intro b hb
        rcases Finset.mem_insert.mp hb with hb | hb
        · rw [hb]
        · rw [h0] at hb; exact absurd hb (Finset.notMem_empty b)
      · obtain ⟨a₀, ha₀, hdiv⟩ := ih h0
        rcases ValuationRing.dvd_total a₀ x with h | h
        · refine ⟨a₀, Finset.mem_insert_of_mem ha₀, ?_⟩
          intro b hb
          rcases Finset.mem_insert.mp hb with hb | hb
          · rw [hb]; exact h
