  obtain ⟨ε, hεet, hεC, hεcomap⟩ := s4 ↥W E σ x.asIdeal hstd hcomap hrep
  refine ⟨Spec (.of E), e, Spec.map (CommRingCat.ofHom ε), x, inferInstance, ?_, ?_, hex, ?_,
    ?_, hres (Polynomial ↥W) Polynomial.C ε hεC⟩
  · exact (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hεet
  · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, Polynomial.algebraMap_eq, hεC, hσ]
