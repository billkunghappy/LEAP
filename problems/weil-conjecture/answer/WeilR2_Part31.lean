  have hRV : ∀ i (x : ↥O.toSubring), algebraMap ↥O.toSubring L x ∈ Vs i := by
    intro i x
    have : (x : K') ∈ (Vs i).comap (algebraMap K' L) := by rw [hOi i]; exact x.2
