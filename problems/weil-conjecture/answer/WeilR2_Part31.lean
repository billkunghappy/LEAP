    rw [if_pos hk]
    have hmem : j0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    rw [← Finset.add_sum_erase _ _ hmem]
    have hτ0 : τ j0 k = ι (x j0 k) := by simp [τ]
    rw [hτ0, add_sub_cancel_left]
    refine Valuation.map_sum_lt _ one_ne_zero (fun j hj => ?_)
    have hjne : j ≠ j0 := Finset.ne_of_mem_erase hj
    have hjN : j ≤ N := by
      have := Finset.mem_range.mp (Finset.mem_of_mem_erase hj); omega
    show V.valuation (if j0 ≤ j then ι (x j k) * η ^ (j - j0)
        else ι (x j k / g ^ (j0 - j)) * (ι g / η) ^ (j0 - j)) < 1
    split_ifs with hjj
    · rw [map_mul, map_pow, mul_comm]
      exact mul_lt_one_of_lt_of_le ((pow_lt_one_iff (by omega)).mpr hVη)
        (hVw ⟨x j k, hxW j k⟩)
    · rw [map_mul, map_pow, mul_comm]
      exact mul_lt_one_of_lt_of_le ((pow_lt_one_iff (by omega)).mpr hVG)
        (hVw ⟨x j k / g ^ (j0 - j), hdiv j k (by omega) hk⟩)

