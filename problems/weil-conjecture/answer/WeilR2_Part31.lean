    obtain ⟨P, hPmax, hIP⟩ := Ideal.exists_le_maximal I hI
    have : P.IsPrime := hPmax.isPrime
    obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.ofPrime A P)
    obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hV
