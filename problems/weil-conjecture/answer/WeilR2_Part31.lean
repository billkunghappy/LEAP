    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hΔ, hx', basicOpen_eq_of_affine] at hz3
    have hp : x₀ ∈ p.asIdeal := by
      by_contra hc
      exact hz3 ((PrimeSpectrum.mem_basicOpen _ _).mpr hc)
    have hne : p.asIdeal ≠ ⊥ := by
      intro h0
      rw [h0] at hp
      exact hx0 ((Submodule.mem_bot _).mp hp)
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hmax : p.asIdeal.IsMaximal :=
      Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance p.asIdeal hne p.isPrime
    have hpc : p = IsLocalRing.closedPoint ↥W :=
      PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
    rw [hpc]

  have hle : U ≤ uX ⁻¹ᵁ ⊤ := by simp
  have hb0 : b ≠ 0 := hP.2.2.1
  have hbm : b ∈ IsLocalRing.maximalIdeal ↥W := hP.2.2.2
  set ev : Γ(X, U) →+* ↥W :=
    ((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (σ.appLE U ⊤ eσ).hom with hev
  set ev' : Γ(X, U) →+* ↥W :=
    ((Scheme.ΓSpecIso (.of ↥W)).hom.hom).comp (σ'.appLE U ⊤ eσ').hom with hev'
  have CI : ∀ (c : ↥W) (h : Γ(X, U)),
      h ∈ (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX c).ideal ⟨U, hU⟩ ↔ c ∣ ev h := by
    intro c h
    rw [centre_ideal σ hP.1 U hU hle eσ c, Ideal.mem_comap, Ideal.mem_span_singleton]
  have CI' : ∀ (c : ↥W) (h : Γ(X, U)),
      h ∈ (σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX c).ideal ⟨U, hU⟩ ↔ c ∣ ev' h := by
    intro c h
    rw [centre_ideal σ' hP'.1 U hU hle eσ' c, Ideal.mem_comap, Ideal.mem_span_singleton]
  have hxU : x ∈ U := by
    have h0 : IsLocalRing.closedPoint ↥W ∈ σ ⁻¹ᵁ U := eσ trivial
    have h1 : σ (IsLocalRing.closedPoint ↥W) ∈ U := h0
    rw [hP.2.1] at h1
    exact h1

  have hIeq : σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b =
      σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX b := by
    apply le_antisymm
    · refine (hτ.2.2 σ' b σ b hP' hP).mpr ⟨dvd_rfl, ?_⟩
      have e : τ σ - τ σ' = -b := by rw [← hb, neg_sub]
      rw [e]
      exact dvd_neg.mpr dvd_rfl
    · exact (hτ.2.2 σ b σ' b hP hP').mpr ⟨dvd_rfl, hb ▸ dvd_rfl⟩

  have hcong : ∀ r : Γ(X, U), b ∣ ev' r - ev r := by
    intro r
    have h1 : ev ((uX.appLE ⊤ U hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (ev r))) = ev r :=
      theta_phi σ hP.1 U hle eσ (ev r)
    have h2 : ev' ((uX.appLE ⊤ U hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (ev r))) = ev r :=
      theta_phi σ' hP'.1 U hle eσ' (ev r)
    have h3 : r - (uX.appLE ⊤ U hle).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (ev r)) ∈
        (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).ideal ⟨U, hU⟩ := by
      rw [CI, map_sub, h1, sub_self]
      exact dvd_zero b
    rw [hIeq, CI', map_sub, h2] at h3
    exact h3

  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp (hFG ⟨U, hU⟩)
  have hgI : ∀ j, g j ∈ (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).ideal ⟨U, hU⟩ :=
    fun j => hg ▸ Submodule.subset_span ⟨j, rfl⟩
  choose e he hed using fun j => H (g j) (hgI j)
  have hed' : ∀ j, ev' (g j) - ev (g j) = b * e j := hed
  have hgb : ∀ j, b ∣ ev (g j) := fun j => (CI b (g j)).mp (hgI j)

  have hcd : ∀ (k : ℕ) (f : Fin k → ↥W), (∀ j, f j ∈ IsLocalRing.maximalIdeal ↥W) →
      ∃ c : ↥W, c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ c ∣ b ∧ ∀ j, c ∣ f j := by
    intro k
    induction k with
    | zero => intro f _; exact ⟨b, hb0, hbm, dvd_rfl, fun j => j.elim0⟩
    | succ k ih =>
      intro f hf
      obtain ⟨c₀, hc0, hcm, hcb, hcf⟩ := ih (fun j => f (Fin.castSucc j)) (fun j => hf _)
      rcases ValuationRing.dvd_total c₀ (f (Fin.last k)) with h | h
      · refine ⟨c₀, hc0, hcm, hcb, fun j => ?_⟩
        refine Fin.lastCases ?_ (fun i => ?_) j
        · exact h
        · exact hcf i
      · refine ⟨f (Fin.last k), ?_, hf _, h.trans hcb, fun j => ?_⟩
        · intro h0
          rw [h0, zero_dvd_iff] at h
          exact hc0 h
        · refine Fin.lastCases ?_ (fun i => ?_) j
          · exact dvd_rfl
          · exact h.trans (hcf i)
  obtain ⟨c, hc0, hcm, hcb, hce⟩ := hcd n e he

  have herr : ∀ i ∈ (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).ideal ⟨U, hU⟩,
      b * c ∣ ev' i - ev i := by
    intro i hi
    rw [← hg] at hi
    obtain ⟨a, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hi
    simp only [smul_eq_mul, map_sum, map_mul]
    rw [← Finset.sum_sub_distrib]
    apply Finset.dvd_sum
    intro j _
    obtain ⟨k, hk⟩ := hcong (a j)
    obtain ⟨l, hl⟩ := hgb j
    obtain ⟨d, hd⟩ := hcb
    obtain ⟨m', hm'⟩ := hce j
    have e1 : ev' (a j) * ev' (g j) - ev (a j) * ev (g j) =
        ev' (a j) * (ev' (g j) - ev (g j)) + (ev' (a j) - ev (a j)) * ev (g j) := by ring
    rw [e1, hed' j, hk, hl, hm']
    exact ⟨ev' (a j) * m' + k * l * d, by rw [hd]; ring⟩

  have hbc0 : b * c ≠ 0 := mul_ne_zero hb0 hc0
  have hbcm : b * c ∈ IsLocalRing.maximalIdeal ↥W := Ideal.mul_mem_right c _ hbm
  have hincl : σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX (b * c) ≤
      σ'.ker ⊔ wcNcPrincipal (.of ↥W) X uX (b * c) := by
    apply local_le _ _ x U hU hxU
    · intro z hz
      exact (hsupp σ' hP'.1 (b * c) hbc0 z hz).trans hP'.2.1
    · intro i hi
      refine ⟨1, by rw [Scheme.basicOpen_one]; exact hxU, ?_⟩
      rw [one_mul, CI']
      have h1 : b * c ∣ ev i := (CI (b * c) i).mp hi
      have h2 : i ∈ (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b).ideal ⟨U, hU⟩ :=
        (CI b i).mpr (dvd_trans (dvd_mul_right b c) h1)
      have h3 := dvd_add (herr i h2) h1
      rwa [sub_add_cancel] at h3

  have hPbc : wcpaDjLlPair W uX x σ (b * c) := ⟨hP.1, hP.2.1, hbc0, hbcm⟩
  have hP'bc : wcpaDjLlPair W uX x σ' (b * c) := ⟨hP'.1, hP'.2.1, hbc0, hbcm⟩
  obtain ⟨-, hdiv⟩ := (hτ.2.2 σ' (b * c) σ (b * c) hP'bc hPbc).mp hincl
  have e0 : τ σ - τ σ' = -b := by rw [← hb, neg_sub]
  rw [e0, dvd_neg] at hdiv
  obtain ⟨d, hd⟩ := hdiv
  have h1 : b * 1 = b * (c * d) := by rw [mul_one, ← mul_assoc]; exact hd
  have h2 : c * d = 1 := (mul_left_cancel₀ hb0 h1).symm
  exact (IsLocalRing.notMem_maximalIdeal.mpr (IsUnit.of_mul_eq_one d h2)) hcm

