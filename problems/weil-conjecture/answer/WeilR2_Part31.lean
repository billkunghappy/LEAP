theorem wcpa_dj_lr1k_lf_chart_transfer : ∀ (S Q : Type u) [CommRing S] [CommRing Q] [Algebra S Q]
    (Y : Scheme.{u}) (g : Y ⟶ Spec (.of S)) (y : Y) (𝔭 : Ideal Q),
    wcLfChart g y 𝔭 →
    ∀ (P : Type u) [CommRing P] (e : ↥(Y.presheaf.stalk y) →+* P),
      wcNdIsHens (IsLocalRing.maximalIdeal ↥(Y.presheaf.stalk y)) P e →
      ∃ φ : Q →+* P, φ.comp (algebraMap S Q) = e.comp (wcNdSig g y) ∧ wcNdIsHens 𝔭 P φ :=
by


  have h4 : ∀ (R E A L : Type u) [CommRing R] [CommRing E] [CommRing A] [CommRing L]
      [IsLocalRing A] [IsLocalRing L] (α : R →+* E) (ρ : R →+* A) (β : E →+* L) (ℓ : A →+* L)
      (M : Submonoid R) (M' : Submonoid E), α.Etale → @IsLocalization R _ M A _ ρ.toAlgebra →
      @IsLocalization E _ M' L _ β.toAlgebra → ℓ.comp ρ = β.comp α → ∀ (hℓ : IsLocalHom ℓ),
      Function.Bijective (@IsLocalRing.ResidueField.map A L _ _ _ _ ℓ hℓ) →
      wcLfLLP ℓ (IsLocalRing.maximalIdeal A) := by
    intro R E A L _ _ _ _ _ _ α ρ β ℓ M M' hα hρ hβ hcomm hℓ hbij B _ hB h₀ hh₀
    letI : Algebra R A := ρ.toAlgebra
    letI : Algebra E L := β.toAlgebra
    haveI := hρ
    haveI := hβ
    haveI := hB
    haveI hh₀l : IsLocalHom h₀ :=
      ⟨fun a ha => IsLocalRing.notMem_maximalIdeal.mp ((hh₀ a).mp ha)⟩
    letI : Algebra R B := (h₀.comp ρ).toAlgebra
    letI : Algebra R E := α.toAlgebra
    haveI : Algebra.Etale R E := hα
    let lam := RingEquiv.ofBijective (IsLocalRing.ResidueField.map ℓ) hbij
    let ι : IsLocalRing.ResidueField L →+* IsLocalRing.ResidueField B :=
      (IsLocalRing.ResidueField.map h₀).comp lam.symm.toRingHom
    let σ : E →+* IsLocalRing.ResidueField B := ι.comp ((IsLocalRing.residue L).comp β)
    have hι : ∀ a : A, ι (IsLocalRing.residue L (ℓ a)) = IsLocalRing.residue B (h₀ a) := by
      intro a
      have h1 : lam.symm (IsLocalRing.residue L (ℓ a)) = IsLocalRing.residue A a := by
        rw [RingEquiv.symm_apply_eq]
        exact (IsLocalRing.ResidueField.map_residue ℓ a).symm
      change IsLocalRing.ResidueField.map h₀ (lam.symm (IsLocalRing.residue L (ℓ a))) = _
      rw [h1, IsLocalRing.ResidueField.map_residue]
    have hσ : σ.comp (algebraMap R E) = (IsLocalRing.residue B).comp (algebraMap R B) := by
      ext r
      change ι (IsLocalRing.residue L (β (α r))) = IsLocalRing.residue B (h₀ (ρ r))
      rw [← RingHom.comp_apply β α r, ← hcomm]
      exact hι (ρ r)
    obtain ⟨τ, hτ⟩ := wc_hnas_hs_etale_section_over_base R B
      (fun E'' _ _ _ σ'' => wc_hnas_smooth_section_henselian B E'' σ'') E σ hσ
    have hunit : ∀ z : E, IsUnit (τ z) ↔ IsUnit (β z) := by
      intro z
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hτ z,
        ← IsLocalRing.residue_ne_zero_iff_isUnit (β z)]
      exact (map_ne_zero ι : ι (IsLocalRing.residue L (β z)) ≠ 0 ↔ _)
    have hM' : ∀ s : M', IsUnit (τ s) := fun s =>
      (hunit _).mpr (IsLocalization.map_units (M := M') L s)
    let h : L →+* B := IsLocalization.lift (M := M') (S := L) (g := (τ : E →+* B)) hM'
    have hhβ : ∀ z, h (β z) = τ z := fun z => IsLocalization.lift_eq hM' z
    have hloc : IsLocalHom h := by
      constructor
      intro l hl
      obtain ⟨⟨z, s⟩, e1⟩ := IsLocalization.surj M' l
      have e1' : l * β s = β z := e1
      have e2 : h l * τ s = τ z := by rw [← hhβ, ← hhβ, ← map_mul, e1']
      have hz : IsUnit (τ z) := by rw [← e2]; exact hl.mul (hM' s)
      have hbz : IsUnit (l * β s) := by rw [e1']; exact (hunit z).mp hz
      exact isUnit_of_mul_isUnit_left hbz
    have hcomp : h.comp ℓ = h₀ := by
      apply IsLocalization.ringHom_ext M (S := A)
      ext r
      change h (ℓ (ρ r)) = h₀ (ρ r)
      rw [← RingHom.comp_apply ℓ ρ r, hcomm, RingHom.comp_apply, hhβ]
      exact τ.commutes r
    refine ⟨h, ⟨hcomp, hloc⟩, ?_⟩
    rintro h₁ ⟨hh₁, hl₁⟩
    haveI := hl₁
    let τ₁ : E →ₐ[R] B := ⟨h₁.comp β, fun r => by
      change h₁ (β (α r)) = h₀ (ρ r)
      rw [← RingHom.comp_apply β α r, ← hcomm, RingHom.comp_apply, ← RingHom.comp_apply h₁ ℓ, hh₁]⟩
    have hres : ∀ z : E, IsLocalRing.residue B (h₁ (β z)) = IsLocalRing.residue B (τ z) := by
      intro z
      obtain ⟨w, hw⟩ := hbij.2 (IsLocalRing.residue L (β z))
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective w
      rw [IsLocalRing.ResidueField.map_residue] at hw
      rw [hτ z]
      change _ = ι (IsLocalRing.residue L (β z))
      rw [← hw, hι, ← IsLocalRing.ResidueField.map_residue h₁ (β z), ← hw,
        IsLocalRing.ResidueField.map_residue, ← RingHom.comp_apply h₁ ℓ, hh₁]
    have heq : τ₁ = τ := wc_hnas_hs_etale_hom_unique_residue R E B τ₁ τ (fun z => hres z)
    apply IsLocalization.ringHom_ext M' (S := L)
    ext z
    change h₁ (β z) = h (β z)
    rw [hhβ]
    exact congrArg (fun f : E →ₐ[R] B => f z) heq

  have h5 : ∀ (Z U : Scheme.{u}) (f : U ⟶ Z) (x : U), Etale f →
      Function.Bijective (f.residueFieldMap x).hom →
      wcLfLLP (f.stalkMap x).hom (IsLocalRing.maximalIdeal ↥(Z.presheaf.stalk (f x))) := by
    intro Z U f x hf hres
    obtain ⟨V, hV, hxV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show f x ∈ (⊤ : Z.Opens) from trivial)
    obtain ⟨V', hV', hxV', hsub⟩ :=
      exists_isAffineOpen_mem_and_subset (show x ∈ f ⁻¹ᵁ V from hxV)
    have hle : V' ≤ f ⁻¹ᵁ V := hsub
    have hα := HasRingHomProperty.appLE @Etale f hf ⟨V, hV⟩ ⟨V', hV'⟩ hle
    refine h4 Γ(Z, V) Γ(U, V') (Z.presheaf.stalk (f x)) (U.presheaf.stalk x)
      (f.appLE V V' hle).hom (Z.presheaf.germ V (f x) hxV).hom (U.presheaf.germ V' x hxV').hom
      (f.stalkMap x).hom _ _ hα (hV.isLocalization_stalk ⟨f x, hxV⟩)
      (hV'.isLocalization_stalk ⟨x, hxV'⟩) ?_ inferInstance hres
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.Hom.germ_stalkMap]
    congr 1
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]

  have h6 : ∀ (Q L : Type u) [CommRing Q] [CommRing L] (σ : Q →+* L) (𝔭 : Ideal Q)
      (h𝔭 : 𝔭.IsPrime), @IsLocalization.AtPrime Q _ L _ σ.toAlgebra 𝔭 h𝔭 →
      (∀ c, IsUnit (σ c) ↔ c ∉ 𝔭) ∧ wcLfLLP σ 𝔭 := by
    intro Q L _ _ σ 𝔭 h𝔭 hloc
    letI := σ.toAlgebra
    haveI := h𝔭
    haveI := hloc
    have hu : ∀ c, IsUnit (σ c) ↔ c ∉ 𝔭 := fun c => IsLocalization.AtPrime.isUnit_to_map_iff L 𝔭 c
    refine ⟨hu, ?_⟩
    intro B _ hB g hg
    have hg' : ∀ y : 𝔭.primeCompl, IsUnit (g y) := fun y => (hg y).mpr y.2
    let h : L →+* B := IsLocalization.lift (M := 𝔭.primeCompl) (S := L) hg'
    have hh : ∀ z, h (σ z) = g z := fun z => IsLocalization.lift_eq hg' z
    have hhc : h.comp σ = g := RingHom.ext hh
    refine ⟨h, ⟨hhc, ⟨fun l hl => ?_⟩⟩, ?_⟩
    · obtain ⟨⟨z, s⟩, e1⟩ := IsLocalization.surj 𝔭.primeCompl l
      have e1' : l * σ s = σ z := e1
      have e2 : h l * g s = g z := by rw [← hh, ← hh, ← map_mul, e1']
      have hz : IsUnit (g z) := by rw [← e2]; exact hl.mul (hg' s)
      have hσz : IsUnit (l * σ s) := by rw [e1']; exact (hu z).mpr ((hg z).mp hz)
      exact isUnit_of_mul_isUnit_left hσz
    · rintro h' ⟨hh', -⟩
      exact IsLocalization.ringHom_ext 𝔭.primeCompl (hh'.trans hhc.symm)

  have h7 : ∀ (Q L₁ L₂ : Type u) [CommRing Q] [CommRing L₁] [CommRing L₂] [IsLocalRing L₁]
      (φ₁ : Q →+* L₁) (φ₂ : L₁ →+* L₂) (𝔭 : Ideal Q), IsLocalHom φ₂ → wcLfLLP φ₁ 𝔭 →
      wcLfLLP φ₂ (IsLocalRing.maximalIdeal L₁) → wcLfLLP (φ₂.comp φ₁) 𝔭 := by
    intro Q L₁ L₂ _ _ _ _ φ₁ φ₂ 𝔭 hφ₂ h1 h2 B _ hB g hg
    haveI := hφ₂
    obtain ⟨k₁, ⟨hk₁, hk₁l⟩, hk₁u⟩ := h1 B hB g hg
    haveI := hk₁l
    have hk₁' : ∀ z, IsUnit (k₁ z) ↔ z ∉ IsLocalRing.maximalIdeal L₁ := fun z => by
      rw [IsLocalRing.notMem_maximalIdeal]; exact isUnit_map_iff k₁ z
    obtain ⟨k₂, ⟨hk₂, hk₂l⟩, hk₂u⟩ := h2 B hB k₁ hk₁'
    refine ⟨k₂, ⟨by rw [← RingHom.comp_assoc, hk₂, hk₁], hk₂l⟩, ?_⟩
    rintro h ⟨hh, hhl⟩
    haveI := hhl
    have e1 : h.comp φ₂ = k₁ :=
      hk₁u _ ⟨by rw [RingHom.comp_assoc]; exact hh, inferInstance⟩
    exact hk₂u _ ⟨e1, hhl⟩

  have h8 : ∀ (Q A L P : Type u) [CommRing Q] [CommRing A] [CommRing L] [IsLocalRing A]
      [IsLocalRing L] [CommRing P] (q : Q →+* L) (a : A →+* L) (𝔭 : Ideal Q) (e : A →+* P),
      IsLocalHom a → (∀ c, IsUnit (q c) ↔ c ∉ 𝔭) → wcLfLLP q 𝔭 →
      wcLfLLP a (IsLocalRing.maximalIdeal A) → wcNdIsHens (IsLocalRing.maximalIdeal A) P e →
      ∃ ψ : L →+* P, ψ.comp a = e ∧ wcNdIsHens 𝔭 P (ψ.comp q) := by
    intro Q A L P _ _ _ _ _ _ q a 𝔭 e ha hqu hq hA hP
    unfold wcNdIsHens at hP
    obtain ⟨H1, H2, H3⟩ := hP
    obtain ⟨ψ, ⟨hψ, hψl⟩, -⟩ := hA P H1 e H2
    haveI := hψl
    haveI := ha
    refine ⟨ψ, hψ, ?_⟩
    unfold wcNdIsHens
    refine ⟨H1, fun c => by rw [RingHom.comp_apply, isUnit_map_iff]; exact hqu c, ?_⟩
    intro B _ hB h₀ hh₀
    obtain ⟨k, ⟨hk, hkl⟩, hku⟩ := hq B hB h₀ hh₀
    haveI := hkl
    have hka : ∀ z, IsUnit ((k.comp a) z) ↔ z ∉ IsLocalRing.maximalIdeal A := fun z => by
      rw [IsLocalRing.notMem_maximalIdeal, RingHom.comp_apply, isUnit_map_iff, isUnit_map_iff]
    obtain ⟨η, ⟨hη, hηl⟩, hηu⟩ := H3 B hB (k.comp a) hka
