  have s4 : ∀ (A E : Type u) [CommRing A] [IsLocalRing A] [CommRing E] (σ : A →+* E) (𝔮 : Ideal E) [𝔮.IsPrime], RingHom.IsStandardSmoothOfRelativeDimension 1 σ → Ideal.comap σ 𝔮 = IsLocalRing.maximalIdeal A → (∀ a : E, ∃ c : A, a - σ c ∈ 𝔮) → ∃ ε : Polynomial A →+* E, ε.Etale ∧ ε.comp Polynomial.C = σ ∧ Ideal.comap ε 𝔮 = Ideal.span {Polynomial.X} ⊔ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A) := by
    intro A E _ _ _ σ 𝔮 _ hstd hcomap hrep
    obtain ⟨g₁, hg₁C, hg₁et⟩ := hstd.exists_etale_mvPolynomial
    let u : Polynomial A ≃+* MvPolynomial (Fin 1) A :=
      (MvPolynomial.uniqueAlgEquiv A (Fin 1)).symm.toRingEquiv
    have huC : ∀ r : A, u (Polynomial.C r) = MvPolynomial.C r := by
      intro r
