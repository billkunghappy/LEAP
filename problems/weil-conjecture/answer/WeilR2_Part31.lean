theorem wcpa_dj_lr1k_ebc_cgr_invpull_composite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι → ∀ (x : ↥X) (w : ↥(Limits.pullback uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))), Limits.pullback.fst uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = x → wcpaDjLkSmAt W uX w → ∀ (σ : Spec (.of ↥W) ⟶ X) (b d : ↥W), wcpaDjLlPair W uX x σ b → d ≠ 0 → d ∈ IsLocalRing.maximalIdeal ↥W → ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁), wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b) r₁ → ι₁ ≫ r₁ = ι → wcpaDjLkModel W (r₁ ≫ uX) ι₁ → ∀ σt : Spec (.of ↥W) ⟶ X₁, σt ≫ r₁ = σ → ∀ (X₂ : Scheme.{u}) (r₂ : X₂ ⟶ X₁) (ι₂ : wcProjK Ω 1 ⟶ X₂), wcCsdIsBlowup (σt.ker ⊔ wcNcPrincipal (.of ↥W) X₁ (r₁ ≫ uX) d) r₂ → ι₂ ≫ r₂ = ι₁ → wcpaDjLkModel W (r₂ ≫ r₁ ≫ uX) ι₂ → ∀ V₂ : X₁.Opens, (V₂ : Set X₁) = {σt (IsLocalRing.closedPoint ↥W)}ᶜ → IsIso (r₂ ∣_ V₂) → wcCsdInvPull (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX (b * d)) (r₂ ≫ r₁) :=
