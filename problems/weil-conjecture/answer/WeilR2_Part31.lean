  intro Ω _ _ W _hdim _hWt Q _ σ b f hf μ₀ μ₁ hμ₀ hμ₁ hμb
  classical

  haveI hWH : HenselianLocalRing ↥W := by
    refine ⟨fun p hp a₀ h₁ _ => ?_⟩
    have h2 : W.valuation (algebraMap W Ω (p.eval a₀)) < 1 := (W.valuation_lt_one_iff _).mp h₁
