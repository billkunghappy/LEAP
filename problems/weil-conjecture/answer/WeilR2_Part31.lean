    have hkey : ∀ p : Polynomial ↥W, θ₀ (p.map (IsLocalRing.residue ↥W)) =
        IsLocalRing.residue ↥V ⟨algebraMap (Polynomial Ω) (RatFunc Ω) (p.map W.subtype), hpoly p⟩ :=
      fun p => RingHom.congr_fun hkeyfun p
    have hCw : ∀ w : ↥W, θ₀ (Polynomial.C (IsLocalRing.residue ↥W w)) =
        IsLocalRing.residue ↥V ⟨algebraMap Ω (RatFunc Ω) (w : Ω), (hC2 _).2 w.2⟩ := by
      intro w
      rw [hθ₀C, IsLocalRing.ResidueField.map_residue]
      exact rescongr' _ _ (hψ₀ w)
    have hθ₀ne : ∀ pb : Polynomial (IsLocalRing.ResidueField ↥W), pb ≠ 0 → θ₀ pb ≠ 0 := by
      intro pb hpb
      obtain ⟨p, rfl⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥W)
        IsLocalRing.residue_surjective pb
      have hp : ∃ i, IsUnit (p.coeff i) := by
        obtain ⟨k, hk⟩ := Polynomial.support_nonempty.mpr hpb
        rw [Polynomial.mem_support_iff, Polynomial.coeff_map] at hk
        exact ⟨k, (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hk⟩
      rw [hkey]
      exact hunitres p hp
    have hφ₀ : nonZeroDivisors (Polynomial (IsLocalRing.ResidueField ↥W)) ≤
        (nonZeroDivisors (IsLocalRing.ResidueField ↥V)).comap θ₀ :=
      fun q hq => mem_nonZeroDivisors_of_ne_zero (hθ₀ne q (nonZeroDivisors.ne_zero hq))
    obtain ⟨θ', hdiv⟩ : ∃ θ' : RatFunc (IsLocalRing.ResidueField ↥W) →+*
        IsLocalRing.ResidueField ↥V, ∀ p q,
        θ' (algebraMap _ _ p / algebraMap _ _ q) = θ₀ p / θ₀ q :=
      ⟨RatFunc.liftRingHom θ₀ hφ₀, RatFunc.liftRingHom_apply_div θ₀ hφ₀⟩
    have hL1 : ∀ p, θ' (algebraMap (Polynomial (IsLocalRing.ResidueField ↥W))
        (RatFunc (IsLocalRing.ResidueField ↥W)) p) = θ₀ p := by
      intro p
      have h := hdiv p 1
      rwa [map_one, div_one, map_one, div_one] at h
    have hinj : Function.Injective θ' := θ'.injective
    have hsurj : Function.Surjective θ' := by
      intro y
      obtain ⟨⟨f, hf⟩, rfl⟩ := IsLocalRing.residue_surjective y
      by_cases hf0 : f = 0
      · refine ⟨0, ?_⟩
        rw [map_zero, ← map_zero (IsLocalRing.residue ↥V)]
        exact rescongr' _ _ hf0.symm
      obtain ⟨a, N, D, _, hN, hD, he'⟩ := s3 f hf0
      have haW : a ∈ W := by
        rw [← hC2]
        have h1 : algebraMap Ω (RatFunc Ω) a =
            f * algebraMap (Polynomial Ω) (RatFunc Ω) (D.map W.subtype) *
              (algebraMap (Polynomial Ω) (RatFunc Ω) (N.map W.subtype))⁻¹ := by
          rw [he', mul_assoc, mul_inv_cancel₀ (hn0 N hN), mul_one]
        rw [h1]
        exact mul_mem (mul_mem hf (hpoly D)) (hpinv N hN)
      refine ⟨algebraMap _ _ (Polynomial.C (IsLocalRing.residue ↥W ⟨a, haW⟩) *
        N.map (IsLocalRing.residue ↥W)) / algebraMap _ _ (D.map (IsLocalRing.residue ↥W)), ?_⟩
      rw [hdiv, map_mul, hCw, hkey N, hkey D, div_eq_iff (hunitres D hD)]
      have hprod : (⟨f, hf⟩ : ↥V) * ⟨_, hpoly D⟩ =
          ⟨algebraMap Ω (RatFunc Ω) a, (hC2 _).2 haW⟩ * ⟨_, hpoly N⟩ := Subtype.ext he'
      have h2 := congrArg (IsLocalRing.residue ↥V) hprod
      rw [map_mul, map_mul] at h2
      exact h2.symm
    refine ⟨RingEquiv.ofBijective θ' ⟨hinj, hsurj⟩, ?_, ?_⟩
    · intro h
      show θ' RatFunc.X = _
      rw [← RatFunc.algebraMap_X (K := IsLocalRing.ResidueField ↥W), hL1, hθ₀X]
    · intro w h
      show θ' (algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W))
        (IsLocalRing.residue ↥W w)) = _
      rw [RatFunc.algebraMap_eq_C (K := IsLocalRing.ResidueField ↥W), ← RatFunc.algebraMap_C, hL1,
        hCw]

  have S2 : ∀ (k : Type u) [Field k] (n : ℕ), 1 ≤ n → ∀ δ : k, δ ≠ 0 →
      ∃ τ : RatFunc k →+* RatFunc k,
        (∀ c : k, τ (algebraMap k (RatFunc k) c) = algebraMap k (RatFunc k) c) ∧
        τ RatFunc.X = algebraMap k (RatFunc k) δ * RatFunc.X ^ n ∧
        Module.finrank ↥τ.fieldRange (RatFunc k) = n := by
    intro k _ n hn δ hδ
    have hn0 : n ≠ 0 := by omega
    set q : Polynomial k := Polynomial.C δ * Polynomial.X ^ n with hq
    have hqdeg : q.natDegree = n := Polynomial.natDegree_C_mul_X_pow n δ hδ
    let ev : Polynomial k →+* RatFunc k :=
      (algebraMap (Polynomial k) (RatFunc k)).comp (Polynomial.compRingHom q)
    have hev : nonZeroDivisors (Polynomial k) ≤ (nonZeroDivisors (RatFunc k)).comap ev := by
      intro p hp
      rw [Submonoid.mem_comap, mem_nonZeroDivisors_iff_ne_zero]
      have hp0 : p ≠ 0 := nonZeroDivisors.ne_zero hp
      intro h0
      have h1 : p.comp q = 0 := by
        apply RatFunc.algebraMap_injective k
        rw [map_zero]
        exact h0
      rw [Polynomial.comp_eq_zero_iff] at h1
      rcases h1 with h1 | ⟨_, h1⟩
      · exact hp0 h1
      · have h2 := congrArg Polynomial.natDegree h1
        rw [Polynomial.natDegree_C, hqdeg] at h2
        exact hn0 h2
    let τ : RatFunc k →+* RatFunc k := RatFunc.liftRingHom ev hev
    have hτalg : ∀ p : Polynomial k, τ (algebraMap (Polynomial k) (RatFunc k) p) =
        algebraMap (Polynomial k) (RatFunc k) (p.comp q) := by
      intro p
      have h1 := RatFunc.liftRingHom_apply_div ev hev p 1
      rw [map_one, div_one, map_one, div_one] at h1
      exact h1
    have hτC : ∀ c : k, τ (algebraMap k (RatFunc k) c) = algebraMap k (RatFunc k) c := by
      intro c
      rw [RatFunc.algebraMap_eq_C, ← RatFunc.algebraMap_C, hτalg, Polynomial.C_comp]
    have hτX : τ RatFunc.X = algebraMap k (RatFunc k) δ * RatFunc.X ^ n := by
      rw [← RatFunc.algebraMap_X, hτalg, Polynomial.X_comp, hq, map_mul, map_pow,
        RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
    refine ⟨τ, hτC, hτX, ?_⟩
    have hmem : ∀ y, τ y ∈ τ.fieldRange := fun y => RingHom.mem_fieldRange.mpr ⟨y, rfl⟩
    have hbij : Function.Bijective τ.rangeRestrictField := by
      constructor
      · intro x y hxy
        apply τ.injective
        have h' := congrArg Subtype.val hxy
        rwa [RingHom.coe_rangeRestrictField, RingHom.coe_rangeRestrictField] at h'
      · rintro ⟨y, hy⟩
        obtain ⟨x, rfl⟩ := RingHom.mem_fieldRange.mp hy
        exact ⟨x, Subtype.ext (RingHom.coe_rangeRestrictField τ x)⟩
    let i : RatFunc k ≃+* ↥τ.fieldRange := RingEquiv.ofBijective τ.rangeRestrictField hbij
    have hi : ∀ y, ((i y : ↥τ.fieldRange) : RatFunc k) = τ y :=
      fun y => RingHom.coe_rangeRestrictField τ y
    have hτa : τ (algebraMap (Polynomial k) (RatFunc k) (Polynomial.C δ⁻¹ * Polynomial.X)) =
        RatFunc.X ^ n := by
      rw [hτalg, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp, hq, ← mul_assoc,
        ← Polynomial.C_mul, inv_mul_cancel₀ hδ, Polynomial.C_1, one_mul, map_pow,
        RatFunc.algebraMap_X]
    let P0 : Polynomial (Polynomial k) :=
      Polynomial.X ^ n - Polynomial.C (Polynomial.C δ⁻¹ * Polynomial.X)
    let P' : Polynomial (RatFunc k) := Polynomial.X ^ n -
      Polynomial.C (algebraMap (Polynomial k) (RatFunc k) (Polynomial.C δ⁻¹ * Polynomial.X))
    have hP'map : P0.map (algebraMap (Polynomial k) (RatFunc k)) = P' := by
      simp only [P0, P', Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
        Polynomial.map_C]
    have hP0mon : P0.Monic := Polynomial.monic_X_pow_sub_C _ hn0
    have hP0deg : P0.natDegree = n := Polynomial.natDegree_X_pow_sub_C
    have hP0irr : Irreducible P0 := by
      have hprime : (Ideal.span {(Polynomial.X : Polynomial k)}).IsPrime :=
        (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr Polynomial.prime_X
      apply Polynomial.irreducible_of_eisenstein_criterion hprime
      · rw [hP0mon.leadingCoeff, Ideal.mem_span_singleton, Polynomial.X_dvd_iff]
        simp
      · intro m hm
        rw [Polynomial.degree_eq_natDegree hP0mon.ne_zero, hP0deg, Nat.cast_lt] at hm
        rw [Ideal.mem_span_singleton, Polynomial.X_dvd_iff]
        have hne : m ≠ n := by omega
        by_cases h0 : m = 0
        · subst h0
          simp [P0, Polynomial.coeff_X_pow, hne]
        · simp [P0, Polynomial.coeff_X_pow, Polynomial.coeff_C, hne, h0]
      · rw [Polynomial.degree_eq_natDegree hP0mon.ne_zero, hP0deg]
        exact_mod_cast Nat.pos_of_ne_zero hn0
      · rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        intro hdvd
        have hc0 : P0.coeff 0 = -(Polynomial.C δ⁻¹ * Polynomial.X) := by
          simp [P0, Polynomial.coeff_X_pow, Ne.symm hn0]
        rw [hc0, dvd_neg, pow_two] at hdvd
        have h2 : (Polynomial.X : Polynomial k) ∣ Polynomial.C δ⁻¹ :=
          (mul_dvd_mul_iff_right Polynomial.X_ne_zero).mp hdvd
        rw [Polynomial.X_dvd_iff, Polynomial.coeff_C_zero] at h2
        exact inv_ne_zero hδ h2
      · exact hP0mon.isPrimitive
    have hP'irr : Irreducible P' := by
      rw [← hP'map]
      exact (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hP0mon).mp hP0irr
    let P : Polynomial ↥τ.fieldRange := P'.map (i : RatFunc k →+* ↥τ.fieldRange)
    have hPirr : Irreducible P := by
      show Irreducible ((Polynomial.mapEquiv i) P')
      exact (MulEquiv.irreducible_iff (Polynomial.mapEquiv i)).mpr hP'irr
    have hPmon : P.Monic := (Polynomial.monic_X_pow_sub_C _ hn0).map _
    have hPX : Polynomial.aeval (RatFunc.X : RatFunc k) P = 0 := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have hcomp : (algebraMap ↥τ.fieldRange (RatFunc k)).comp
          (i : RatFunc k →+* ↥τ.fieldRange) = τ := RingHom.ext fun y => hi y
      rw [hcomp]
      simp only [P', Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hτa,
        sub_self]
    have hmin : P = minpoly ↥τ.fieldRange (RatFunc.X : RatFunc k) :=
      minpoly.eq_of_irreducible_of_monic hPirr hPX hPmon
    have hint : IsIntegral ↥τ.fieldRange (RatFunc.X : RatFunc k) :=
      ⟨P, hPmon, by rwa [Polynomial.aeval_def] at hPX⟩
    have hPdeg : P.natDegree = n := by
      rw [Polynomial.natDegree_map]
      exact Polynomial.natDegree_X_pow_sub_C
    have hC : ∀ c : k, algebraMap (Polynomial k) (RatFunc k) (Polynomial.C c) ∈
        IntermediateField.adjoin ↥τ.fieldRange {(RatFunc.X : RatFunc k)} := by
      intro c
      have h1 : algebraMap (Polynomial k) (RatFunc k) (Polynomial.C c) =
          algebraMap ↥τ.fieldRange (RatFunc k) ⟨_, hmem (algebraMap k (RatFunc k) c)⟩ := by
        show _ = τ (algebraMap k (RatFunc k) c)
        rw [hτC, RatFunc.algebraMap_C, RatFunc.algebraMap_eq_C]
      rw [h1]
      exact IntermediateField.algebraMap_mem _ _
    have hpoly : ∀ p : Polynomial k, algebraMap (Polynomial k) (RatFunc k) p ∈
        IntermediateField.adjoin ↥τ.fieldRange {(RatFunc.X : RatFunc k)} := by
      intro p
      refine Polynomial.induction_on p hC ?_ ?_
      · intro p r hp hr
        rw [map_add]
        exact add_mem hp hr
      · intro m c _
        rw [map_mul, map_pow, RatFunc.algebraMap_X]
        exact mul_mem (hC c) (pow_mem (IntermediateField.mem_adjoin_simple_self _ _) _)
    have htop : IntermediateField.adjoin ↥τ.fieldRange {(RatFunc.X : RatFunc k)} = ⊤ := by
      rw [eq_top_iff]
      intro f _
      rw [← RatFunc.num_div_denom f]
      exact div_mem (hpoly _) (hpoly _)
    rw [← IntermediateField.finrank_top', ← htop, IntermediateField.adjoin.finrank hint, ← hmin,
      hPdeg]

  have S4 : ∀ (F E : Type u) [Field F] [Field E] (τ : F →+* F) (α β : F →+* E),
      (∀ x : F, α x = β (τ x)) →
      (letI : Algebra F E := α.toAlgebra; Module.finrank F E) =
        Module.finrank ↥τ.fieldRange F * (letI : Algebra F E := β.toAlgebra; Module.finrank F E) := by
    intro F E _ _ τ α β h
    have hbij : Function.Bijective τ.rangeRestrictField := by
      constructor
      · intro x y hxy
        apply τ.injective
        have h' := congrArg Subtype.val hxy
        rwa [RingHom.coe_rangeRestrictField, RingHom.coe_rangeRestrictField] at h'
      · rintro ⟨y, hy⟩
        obtain ⟨x, rfl⟩ := RingHom.mem_fieldRange.mp hy
        exact ⟨x, Subtype.ext (RingHom.coe_rangeRestrictField τ x)⟩
    let i : F ≃+* ↥τ.fieldRange := RingEquiv.ofBijective τ.rangeRestrictField hbij
    have h1 : (letI : Algebra F E := α.toAlgebra; Module.finrank F E) =
        (letI : Algebra ↥τ.fieldRange E := (β.comp τ.fieldRange.subtype).toAlgebra;
          Module.finrank ↥τ.fieldRange E) := by
      letI : Algebra F E := α.toAlgebra
      letI : Algebra ↥τ.fieldRange E := (β.comp τ.fieldRange.subtype).toAlgebra
      apply Algebra.finrank_eq_of_equiv_equiv i (RingEquiv.refl E)
      apply RingHom.ext
      intro x
      show β ((i x : ↥τ.fieldRange) : F) = α x
      rw [h x]
      rfl
    have h2 : (letI : Algebra ↥τ.fieldRange E := (β.comp τ.fieldRange.subtype).toAlgebra;
          Module.finrank ↥τ.fieldRange E) =
        Module.finrank ↥τ.fieldRange F * (letI : Algebra F E := β.toAlgebra; Module.finrank F E) := by
      letI : Algebra F E := β.toAlgebra
      letI : Algebra ↥τ.fieldRange E := (β.comp τ.fieldRange.subtype).toAlgebra
      haveI : IsScalarTower ↥τ.fieldRange F E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      exact (Module.finrank_mul_finrank ↥τ.fieldRange F E).symm
    rw [h1, h2]

  have S3 : ∀ (χ : RatFunc Ω →+* L)
      (θ : RatFunc (IsLocalRing.ResidueField ↥W) ≃+* IsLocalRing.ResidueField ↥(V'.comap χ)),
      (∀ h : (RatFunc.X : RatFunc Ω) ∈ V'.comap χ,
        θ RatFunc.X = IsLocalRing.residue ↥(V'.comap χ) ⟨RatFunc.X, h⟩) →
      (∀ (a : ↥W) (h : algebraMap Ω (RatFunc Ω) (a : Ω) ∈ V'.comap χ),
        θ (algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W))
          (IsLocalRing.residue ↥W a)) =
        IsLocalRing.residue ↥(V'.comap χ) ⟨algebraMap Ω (RatFunc Ω) (a : Ω), h⟩) →
      ∃ α : RatFunc (IsLocalRing.ResidueField ↥W) →+* IsLocalRing.ResidueField ↥V',
        (letI : Algebra (RatFunc Ω) L := χ.toAlgebra; wcEbBdResDeg (RatFunc Ω) V') =
          (letI : Algebra (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.ResidueField ↥V') :=
            α.toAlgebra;
          Module.finrank (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.ResidueField ↥V')) ∧
        (∀ h : χ RatFunc.X ∈ V', α RatFunc.X = IsLocalRing.residue ↥V' ⟨χ RatFunc.X, h⟩) ∧
        ∀ (a : ↥W) (h : χ (algebraMap Ω (RatFunc Ω) (a : Ω)) ∈ V'),
          α (algebraMap (IsLocalRing.ResidueField ↥W) (RatFunc (IsLocalRing.ResidueField ↥W))
            (IsLocalRing.residue ↥W a)) =
          IsLocalRing.residue ↥V' ⟨χ (algebraMap Ω (RatFunc Ω) (a : Ω)), h⟩ := by
    intro χ θ hθX hθC
    letI : Algebra (RatFunc Ω) L := χ.toAlgebra
    refine ⟨(wcEbBdResAlg (RatFunc Ω) V').comp θ.toRingHom, ?_, ?_, ?_⟩
    · letI : Algebra (IsLocalRing.ResidueField ↥(V'.comap (algebraMap (RatFunc Ω) L)))
          (IsLocalRing.ResidueField ↥V') := (wcEbBdResAlg (RatFunc Ω) V').toAlgebra
      letI : Algebra (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.ResidueField ↥V') :=
        ((wcEbBdResAlg (RatFunc Ω) V').comp θ.toRingHom).toAlgebra
      have h1 := Algebra.finrank_eq_of_equiv_equiv
        (R₀ := RatFunc (IsLocalRing.ResidueField ↥W)) (S₀ := IsLocalRing.ResidueField ↥V')
        (R₁ := IsLocalRing.ResidueField ↥(V'.comap (algebraMap (RatFunc Ω) L)))
        (S₁ := IsLocalRing.ResidueField ↥V') θ (RingEquiv.refl _) (RingHom.ext fun _ => rfl)
      exact h1.symm
    · intro h
      have hX : (RatFunc.X : RatFunc Ω) ∈ V'.comap χ := h
      show wcEbBdResAlg (RatFunc Ω) V' (θ RatFunc.X) = _
      rw [hθX hX]
      rfl
    · intro a h
      have hC : algebraMap Ω (RatFunc Ω) (a : Ω) ∈ V'.comap χ := h
      show wcEbBdResAlg (RatFunc Ω) V' (θ (algebraMap (IsLocalRing.ResidueField ↥W)
        (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.residue ↥W a))) = _
      rw [hθC a hC]
      rfl

  have hXG : (RatFunc.X : RatFunc Ω) ∈ wcEbGauss W := by
    apply Subring.subset_closure
    refine ⟨Polynomial.X, 1, ⟨0, by simp⟩, by simp, ?_⟩
    rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_X, RatFunc.algebraMap_X]
  have hCG : ∀ a : ↥W, algebraMap Ω (RatFunc Ω) (a : Ω) ∈ wcEbGauss W := by
    intro a
    apply Subring.subset_closure
    refine ⟨Polynomial.C a, 1, ⟨0, by simp⟩, by simp, ?_⟩
    rw [Polynomial.map_one, map_one, mul_one, Polynomial.map_C, RatFunc.algebraMap_C,
      ← RatFunc.algebraMap_eq_C]
    rfl
  have hmemφ : ∀ f, f ∈ wcEbGauss W → φ f ∈ V' := by
    intro f hf
    rw [← hGφ] at hf
    exact hf
  have hmemψ : ∀ f, f ∈ wcEbGauss W → ψ f ∈ V' := by
    intro f hf
    rw [← hGψ] at hf
    exact hf
  have hφX : φ RatFunc.X ∈ V' := hmemφ _ hXG
  have hψX : ψ RatFunc.X ∈ V' := hmemψ _ hXG
  have hφC : ∀ a : ↥W, φ (algebraMap Ω (RatFunc Ω) (a : Ω)) ∈ V' := fun a => hmemφ _ (hCG a)
  have hψC : ∀ a : ↥W, ψ (algebraMap Ω (RatFunc Ω) (a : Ω)) ∈ V' := fun a => hmemψ _ (hCG a)
  have hdW : d ∈ W := by
    rcases W.mem_or_inv_mem d with h | h
    · exact h
    · have h' : d⁻¹ = d := inv_eq_of_mul_eq_one_right hdd
      rwa [h'] at h
  let dW : ↥W := ⟨d, hdW⟩
  have hw1 : w - 1 ∈ V' := (V'.valuation_le_one_iff _).mp hw.le
  have hwV : w ∈ V' := by
    have h := add_mem hw1 V'.one_mem
    rwa [sub_add_cancel] at h
  have hresw : IsLocalRing.residue ↥V' ⟨w, hwV⟩ = 1 := by
    have hm : (⟨w - 1, hw1⟩ : ↥V') ∈ IsLocalRing.maximalIdeal ↥V' :=
      (V'.valuation_lt_one_iff _).mpr hw
    have h0 := (IsLocalRing.residue_eq_zero_iff _).mpr hm
    have heq : (⟨w, hwV⟩ : ↥V') = ⟨w - 1, hw1⟩ + 1 := Subtype.ext (by simp)
    rw [heq, map_add, h0, map_one, zero_add]

  obtain ⟨θφ, hθφX, hθφC⟩ := S1 (V'.comap φ) hGφ
  obtain ⟨θψ, hθψX, hθψC⟩ := S1 (V'.comap ψ) hGψ
  obtain ⟨αφ, hdegφ, hXφ, hCφ⟩ := S3 φ θφ hθφX hθφC
  obtain ⟨αψ, hdegψ, hXψ, hCψ⟩ := S3 ψ θψ hθψX hθψC

  have hconst : ∀ r : IsLocalRing.ResidueField ↥W,
      αφ (algebraMap _ (RatFunc (IsLocalRing.ResidueField ↥W)) r) =
        αψ (algebraMap _ (RatFunc (IsLocalRing.ResidueField ↥W)) r) := by
    intro r
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective r
    rw [hCφ a (hφC a), hCψ a (hψC a)]
    exact congrArg _ (Subtype.ext ((hφw a).trans (hψw a).symm))

  have hιd : ι d ∈ V' := by
    rw [← hφw]
    exact hφC dW
  have hrelV : (⟨ψ RatFunc.X, hψX⟩ : ↥V') ^ e * ⟨w, hwV⟩ =
      ⟨ι d, hιd⟩ * ⟨φ RatFunc.X, hφX⟩ := Subtype.ext hrel
  have h1 := congrArg (IsLocalRing.residue ↥V') hrelV
  rw [map_mul, map_pow, hresw, mul_one, map_mul] at h1
  have hδψ : IsLocalRing.residue ↥V' ⟨ι d, hιd⟩ =
      αψ (algebraMap _ (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.residue ↥W dW)) := by
    rw [hCψ dW (hψC dW)]
    exact congrArg _ (Subtype.ext (hψw d).symm)
  have hδsq : IsLocalRing.residue ↥V' ⟨ι d, hιd⟩ * IsLocalRing.residue ↥V' ⟨ι d, hιd⟩ = 1 := by
    rw [← map_mul, ← map_one (IsLocalRing.residue ↥V')]
    apply congrArg
    apply Subtype.ext
    show ι d * ι d = 1
    rw [← map_mul, hdd, map_one]
  have hδ0sq : IsLocalRing.residue ↥W dW * IsLocalRing.residue ↥W dW = 1 := by
    rw [← map_mul, ← map_one (IsLocalRing.residue ↥W)]
    exact congrArg _ (Subtype.ext hdd)
  have hδ0 : IsLocalRing.residue ↥W dW ≠ 0 := by
    intro h
    rw [h, zero_mul] at hδ0sq
    exact zero_ne_one hδ0sq
  have hs : IsLocalRing.residue ↥V' ⟨φ RatFunc.X, hφX⟩ =
      IsLocalRing.residue ↥V' ⟨ι d, hιd⟩ * IsLocalRing.residue ↥V' ⟨ψ RatFunc.X, hψX⟩ ^ e := by
    rw [h1, ← mul_assoc, hδsq, one_mul]
  have hαX : αφ RatFunc.X = αψ (algebraMap _ (RatFunc (IsLocalRing.ResidueField ↥W))
      (IsLocalRing.residue ↥W dW) * RatFunc.X ^ e) := by
    rw [map_mul, map_pow, hXφ hφX, hXψ hψX, ← hδψ, hs]

  obtain ⟨τ, hτC, hτX, hτdeg⟩ := S2 (IsLocalRing.ResidueField ↥W) e he
    (IsLocalRing.residue ↥W dW) hδ0

  have hcompeq : αφ = αψ.comp τ := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial (IsLocalRing.ResidueField ↥W)))
    apply Polynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply]
      rw [RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C, hτC, hconst]
    · simp only [RingHom.comp_apply]
      rw [RatFunc.algebraMap_X, hτX, hαX]
  have hpt : ∀ x, αφ x = αψ (τ x) := fun x => by rw [hcompeq]; rfl

  have htow := S4 (RatFunc (IsLocalRing.ResidueField ↥W)) (IsLocalRing.ResidueField ↥V') τ αφ αψ hpt
  rw [hτdeg] at htow
  rw [hdegφ, hdegψ]
  exact htow

theorem wcpa_dj_lr1k_eb_pd_resdeg_one : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L → wcEbAnGaussStr W L →
    ∀ (m : ℕ) (U : Fin m → ValuationSubring L) (e : Fin m → ℕ) (η u : Fin m → L),
    wcEbMoBD W L m U e η u →
    ∃ θ : ↥W, θ ≠ 0 ∧ θ ∈ IsLocalRing.maximalIdeal ↥W ∧
    ∀ a : ↥W, a ≠ 0 → a ∈ IsLocalRing.maximalIdeal ↥W → (θ : Ω) / (a : Ω) ∈ W →
      ∀ c : Ω, c * c = (a : Ω) →
      ∀ O : ValuationSubring (RatFunc Ω), (∀ f : RatFunc Ω, f ∈ O ↔ wcEbAnInOc W c f) →
      ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = O →
      ∀ b : Fin m, V'.valuation (u b - 1) < 1 →
        V'.valuation (η b) ^ e b = V'.valuation (algebraMap (RatFunc Ω) L RatFunc.X) →
        (∀ b', b' ≠ b → V'.valuation (η b') = 1) →
      ∀ g : ↥W, g ∈ IsLocalRing.maximalIdeal ↥W → g ≠ 0 → (g : Ω) ^ e b = (a : Ω) →
        (∀ p : Polynomial Ω, Polynomial.eval₂
          ((algebraMap (RatFunc Ω) L).comp (algebraMap Ω (RatFunc Ω))) (η b) p = 0 → p = 0) →
      ∀ γ : Ω, γ * γ = (g : Ω) →
      ∀ ψ : RatFunc Ω →+* L,
        (∀ w : Ω, ψ (algebraMap Ω (RatFunc Ω) w) =
          algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) w)) →
        ψ RatFunc.X = η b / algebraMap (RatFunc Ω) L (algebraMap Ω (RatFunc Ω) γ) →
      letI : Algebra (RatFunc Ω) L := ψ.toAlgebra
