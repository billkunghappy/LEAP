theorem wcpa_dj_mm_semistable_basechange : ∀ (M P'' Z : Scheme.{u}) (φ : P'' ⟶ M) (u : Z ⟶ M),
    wcpaDjSemistable u → wcpaDjSemistable (Limits.pullback.snd u φ) :=
by

  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)

  have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro A _ I m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
    simpa [smul_eq_mul, Ideal.mul_top] using this

  have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
        AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
    intro A B _ _ _ _ σ
    let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
    have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        f n x = Ideal.Quotient.mk _ (σ a) := by
      intro n x a ha
      show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
        (AdicCompletion.evalₐ _ n x) = _
      rw [ha, Ideal.quotientMap_mk]
      rfl
    have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
      intro m n hle
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
      have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
        rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk]
    refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hf n x a ha

  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
    intro A B _ _ _ _ σ
    obtain ⟨Φ, hΦ⟩ := hmap A B σ
    obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
        RingHom.id_apply, hb]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
        RingHom.id_apply, hb]
    refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
        AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
          Ideal.Quotient.mk _ r := by
      intro R _ I r
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
        RingHom.id_apply]
    show AdicCompletion.evalₐ _ n (Φ _) = _
    rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]

  have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
      (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
        i.stalkMap x =
      (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    intro K _ X Y i p q hi x
    have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
        i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
    rw [← hi, Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key

  have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'

  intro M P'' Z φ u hss
  obtain ⟨hflat, hprop, hfib⟩ := hss
  haveI := hflat
  haveI := hprop
  refine ⟨inferInstance, inferInstance, ?_⟩
  intro K _ _ s w
  set i := (Limits.pullbackLeftPullbackSndIso u φ s).hom with hi_def
  have hi : i ≫ Limits.pullback.snd u (s ≫ φ) = Limits.pullback.snd (Limits.pullback.snd u φ) s :=
    Limits.pullbackLeftPullbackSndIso_hom_snd u φ s
  rcases hfib K (s ≫ φ) (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
  · left
    refine ⟨i ⁻¹ᵁ W', hw', ?_⟩
    exact s3 i _ _ hi W' hsm
  · right
    let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
    obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
    refine ⟨Φ.trans e₀, ?_⟩
    have h2 := s2 K i _ _ hi w
    ext1 k
    have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd (Limits.pullback.snd u φ) s).appTop ≫
        (Limits.pullback (Limits.pullback.snd u φ) s).presheaf.germ ⊤ w trivial).hom k) =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u (s ≫ φ)).appTop ≫
        (Limits.pullback u (s ≫ φ)).presheaf.germ ⊤ (i w) trivial).hom k := by
      rw [← h2, RingEquiv.symm_apply_eq]
      rfl
    have := RingHom.congr_fun he₀ k
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
    rw [RingEquiv.trans_apply, hΦ, hk]
    exact this

theorem wcpa_dj_lgs_reduced_dense : ∀ (k : Type u) [Field k] (T : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (sT : T ⟶ Spec (.of k)), LocallyOfFiniteType sT → ∀ (Z : Scheme.{u}) (u : Z ⟶ T), wcpaDjSemistable u → AlgebraicGeometry.IsReduced Z ∧ ∀ V : T.Opens, V ≠ ⊥ → Dense ((u ⁻¹ᵁ V : Z.Opens) : Set Z) :=
by
  intro k _ T _ sT _ Z u h
  haveI : Flat u := h.1
  haveI : IsProper u := h.2.1

  have node_red : ∀ (K : Type u) [Field K], _root_.IsReduced (MvPowerSeries (Fin 2) K ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) := by
    intro K _
    haveI : IsDomain (MvPowerSeries (Fin 2) K) := NoZeroDivisors.to_isDomain _
    have hc : ∀ (i : Fin 2) (φ : MvPowerSeries (Fin 2) K) (m : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff m (id (α := MvPowerSeries (Fin 2) K)
          (fun n => if n i = 0 then MvPowerSeries.coeff n φ else 0)) =
        if m i = 0 then MvPowerSeries.coeff m φ else 0 := fun _ _ _ => rfl
    have hρ : ∀ i : Fin 2, ∃ ρ : MvPowerSeries (Fin 2) K →+* MvPowerSeries (Fin 2) K,
        ∀ φ m, MvPowerSeries.coeff m (ρ φ) = if m i = 0 then MvPowerSeries.coeff m φ else 0 := by
      intro i
      refine ⟨{ toFun := fun φ => id (α := MvPowerSeries (Fin 2) K)
                  (fun n => if n i = 0 then MvPowerSeries.coeff n φ else 0)
                map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ },
        fun φ m => hc i φ m⟩
      · ext m
        rw [hc, MvPowerSeries.coeff_one]
        split_ifs with h1 h2 <;> simp_all
      · intro φ ψ
        ext m
        rw [hc, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
        split_ifs with h
        · refine Finset.sum_congr rfl (fun p hp => ?_)
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          have hpi := congrArg (fun f => f i) hp
          simp only [Finsupp.coe_add, Pi.add_apply] at hpi
          rw [hc, hc, if_pos (by omega), if_pos (by omega)]
        · symm
          refine Finset.sum_eq_zero (fun p hp => ?_)
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          have hpi := congrArg (fun f => f i) hp
          simp only [Finsupp.coe_add, Pi.add_apply] at hpi
          rw [hc, hc]
          by_cases h1 : p.1 i = 0
          · rw [if_neg (show ¬ p.2 i = 0 by omega), mul_zero]
          · rw [if_neg h1, zero_mul]
      · ext m
        rw [hc]
        simp
      · intro φ ψ
        ext m
        rw [map_add, hc, hc, hc, map_add]
        split_ifs <;> simp
    have hprime : ∀ i : Fin 2,
        (Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin 2) K)}).IsPrime := by
      intro i
      obtain ⟨ρ, hρ⟩ := hρ i
      have : Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin 2) K)} = RingHom.ker ρ := by
        ext φ
        rw [Ideal.mem_span_singleton, RingHom.mem_ker, MvPowerSeries.X_dvd_iff]
        constructor
        · intro h
          ext m
          rw [hρ, map_zero]
          split_ifs with hm
          · exact h m hm
          · rfl
        · intro h m hm
          have := congrArg (MvPowerSeries.coeff m) h
          rw [hρ, map_zero, if_pos hm] at this
          exact this
      rw [this]
      exact RingHom.ker_isPrime ρ
    have hinf : Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} =
        Ideal.span {MvPowerSeries.X 0} ⊓ Ideal.span {MvPowerSeries.X 1} := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ rfl
        exact ⟨Ideal.mem_span_singleton.mpr (dvd_mul_right _ _),
          Ideal.mem_span_singleton.mpr (dvd_mul_left _ _)⟩
      · intro f hf
        rw [Ideal.mem_inf] at hf
        obtain ⟨hx, hy⟩ := hf
        rw [Ideal.mem_span_singleton] at hx ⊢
        obtain ⟨g, rfl⟩ := hx
        rcases (hprime 1).mem_or_mem hy with h | h
        · exfalso
          rw [Ideal.mem_span_singleton, MvPowerSeries.X_dvd_iff] at h
          have := h (Finsupp.single 0 1) (by simp)
          rw [MvPowerSeries.coeff_X] at this
          simp at this
        · rw [Ideal.mem_span_singleton] at h
          obtain ⟨h', rfl⟩ := h
          exact ⟨h', by ring⟩
    rw [← Ideal.isRadical_iff_quotient_reduced, hinf]
    exact (hprime 0).isRadical.inf (hprime 1).isRadical

  have hfib : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
      AlgebraicGeometry.IsReduced (Limits.pullback u s) := by
    intro K _ _ s
    haveI : LocallyOfFiniteType (Limits.pullback.snd u s) := inferInstance
    haveI : IsLocallyNoetherian (Limits.pullback u s) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd u s)
    haveI : ∀ w : ↥(Limits.pullback u s),
        _root_.IsReduced ((Limits.pullback u s).presheaf.stalk w) := by
      intro w
      rcases h.2.2 K s w with ⟨W, hw, hsm⟩ | ⟨e, -⟩
      · haveI := hsm
        haveI := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ Limits.pullback.snd u s) 1 ⟨w, hw⟩
        have hinj : Function.Injective (W.stalkIso ⟨w, hw⟩).inv.hom :=
          (W.stalkIso ⟨w, hw⟩).commRingCatIsoToRingEquiv.symm.injective
        exact isReduced_of_injective _ hinj
      · haveI := node_red K
        let φ := e.toRingHom.comp (algebraMap ((Limits.pullback u s).presheaf.stalk w)
          (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w))
            ((Limits.pullback u s).presheaf.stalk w)))
        have hinj : Function.Injective φ := by
          intro a b hab
          apply AdicCompletion.of_injective
            (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w))
          apply e.injective
          simpa [φ, AdicCompletion.algebraMap_apply] using hab
        exact isReduced_of_injective φ hinj
    exact isReduced_of_isReduced_stalk _

  have patch : ∀ (U : T.Opens) (V : Z.Opens) (hU : IsAffineOpen U)
      (hV : IsAffineOpen V) (e : V ≤ u ⁻¹ᵁ U) (L : Type u) [CommRing L] [Algebra Γ(T, U) L],
      AlgebraicGeometry.IsReduced (Limits.pullback u
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec)) →
      letI := (u.appLE U V e).hom.toAlgebra
      _root_.IsReduced (TensorProduct Γ(T, U) Γ(Z, V) L) := by
    intro U V hU hV e L _ _ hred
    letI := (u.appLE U V e).hom.toAlgebra
    have e₁ : Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) Γ(Z, V))) ≫ hU.fromSpec =
        hV.fromSpec ≫ u := by
      have := IsAffineOpen.SpecMap_appLE_fromSpec u hU hV e
      exact this
    have e₂ : Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec =
        𝟙 _ ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec) :=
      (Category.id_comp _).symm
    haveI := Scheme.pullback_map_isOpenImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) Γ(Z, V))))
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L))) u
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)) ≫ hU.fromSpec)
      hV.fromSpec (𝟙 _) hU.fromSpec e₁ e₂
    haveI : AlgebraicGeometry.IsReduced (Limits.pullback
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) Γ(Z, V))))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) L)))) :=
      isReduced_of_isOpenImmersion (Limits.pullback.map _ _ _ _ _ _ _ e₁ e₂)
    haveI : AlgebraicGeometry.IsReduced
        (Spec (CommRingCat.of (TensorProduct Γ(T, U) Γ(Z, V) L))) :=
      isReduced_of_isOpenImmersion (pullbackSpecIso Γ(T, U) Γ(Z, V) L).inv
    exact (affine_isReduced_iff (CommRingCat.of (TensorProduct Γ(T, U) Γ(Z, V) L))).mp
      inferInstance

  have desc : ∀ (A B L : Type u) [CommRing A] [CommRing B] [CommRing L] [Algebra A B]
      [Algebra A L], Module.Flat A B → Function.Injective (algebraMap A L) →
      _root_.IsReduced (TensorProduct A B L) → _root_.IsReduced B := by
    intro A B L _ _ _ _ _ hB hinj hr
    have hj : Function.Injective
        (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := B) (B := L)) := by
      have h1 : Function.Injective (LinearMap.lTensor B (Algebra.linearMap A L)) :=
        Module.Flat.lTensor_preserves_injective_linearMap (Algebra.linearMap A L) hinj
      have h2 : ⇑(Algebra.TensorProduct.includeLeftRingHom (R := A) (A := B) (B := L)) =
          (LinearMap.lTensor B (Algebra.linearMap A L)) ∘ (TensorProduct.rid A B).symm := by
        funext b
        simp [Algebra.TensorProduct.includeLeftRingHom_apply]
      rw [h2]
      exact h1.comp (TensorProduct.rid A B).symm.injective
    exact isReduced_of_injective _ hj
  refine ⟨?_, ?_⟩

  · haveI : ∀ z : Z, _root_.IsReduced (Z.presheaf.stalk z) := by
      intro z
      obtain ⟨U, hU, huz, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        T.isBasis_affineOpens) (show u z ∈ (⊤ : T.Opens) from trivial)
      obtain ⟨V, hV, hz, hVle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        Z.isBasis_affineOpens) (show z ∈ u ⁻¹ᵁ U from huz)
      haveI : Nonempty U := ⟨⟨u z, huz⟩⟩
      haveI : IsDomain Γ(T, U) := IsIntegral.component_integral U
      let A := Γ(T, U)
      let L := AlgebraicClosure (FractionRing A)
      have hinj : Function.Injective (algebraMap A L) := by
        rw [IsScalarTower.algebraMap_eq A (FractionRing A) L]
        exact (algebraMap (FractionRing A) L).injective.comp
          (IsFractionRing.injective A (FractionRing A))
      have h1 := hfib L (Spec.map (CommRingCat.ofHom (algebraMap A L)) ≫ hU.fromSpec)
      have h2 := patch U V hU hV hVle L h1
      letI := (u.appLE U V hVle).hom.toAlgebra
      have hflat : Module.Flat Γ(T, U) Γ(Z, V) :=
        HasRingHomProperty.appLE @Flat u ‹Flat u› ⟨U, hU⟩ ⟨V, hV⟩ hVle
      haveI hB : _root_.IsReduced Γ(Z, V) := desc A Γ(Z, V) L hflat hinj h2
      letI : Algebra Γ(Z, V) (Z.presheaf.stalk ((⟨z, hz⟩ : V) : Z)) :=
        TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hz⟩
      have hloc := hV.isLocalization_stalk ⟨z, hz⟩
      exact @isReduced_localizationPreserves _ _ _ _ _ _ hloc hB
    exact isReduced_of_isReduced_stalk Z

  · intro V hV
    have hη : genericPoint T ∈ V :=
      ((genericPoint_spec T).mem_open_set_iff V.isOpen).mpr
        (by simpa using (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV)
    rw [dense_iff_closure_eq]
    apply Set.eq_univ_of_forall
    intro z
    have h1 : genericPoint T ⤳ u z := (genericPoint_spec T).specializes (Set.mem_univ _)
    obtain ⟨z', hz', hz'e⟩ := Flat.generalizingMap u h1
    have hm : z' ∈ ((u ⁻¹ᵁ V : Z.Opens) : Set Z) := by
      show u z' ∈ V
      rw [hz'e]; exact hη
    exact closure_mono (Set.singleton_subset_iff.mpr hm) (specializes_iff_mem_closure.mp hz')

theorem wcpa_dj_ldx_semistable_fibre_reduced : ∀ (C P : Scheme.{u}) (g : C ⟶ P), wcpaDjSemistable g → ∀ (L : Type u) [Field L] (s : Spec (.of L) ⟶ P), AlgebraicGeometry.IsReduced (Limits.pullback g s) :=
by
  intro C P g hg L _ s
  have hg' : wcpaDjSemistable (Limits.pullback.snd g s) :=
    wcpa_dj_mm_semistable_basechange P (Spec (.of L)) C s g hg
  exact (wcpa_dj_lgs_reduced_dense L (Spec (.of L)) (𝟙 _) inferInstance
    (Limits.pullback g s) (Limits.pullback.snd g s) hg').1

theorem wcpa_dj_lr1u_mn_affine_fibre_reduced : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Z : Scheme.{u}) (uZ : Z ⟶ Spec (.of ↥W)), wcpaDjSemistable uZ → ∀ U : Z.Opens, IsAffineOpen U → _root_.IsReduced (Γ(Z, U) ⧸ Ideal.map (wcCnSigma uZ U) (IsLocalRing.maximalIdeal ↥W)) :=
by
  intro Ω _ W Z uZ hss U hU

  have s2 : ∀ (B : Type u) [CommRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (W : Z.Opens)
      (hW : IsAffineOpen W), hW.fromSpec ≫ h = Spec.map (CommRingCat.ofHom (wcCnSigma h W)) := by
    intro B _ Z h W hW
    have ha := Scheme.toSpecΓ_naturality h
    have hb : (Spec (.of B)).toSpecΓ = Spec.map (Scheme.ΓSpecIso (.of B)).hom := by
      rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom]
    have hc : h = Z.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop) := by
      have := congrArg (· ≫ Spec.map (Scheme.ΓSpecIso (.of B)).inv) ha
      simp only [Category.assoc, hb, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
        Category.comp_id] at this
      exact this
    have e : hW.fromSpec ≫ h = Spec.map (((Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop) ≫
        Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) := by
      conv_lhs => rw [hc]
      rw [← Category.assoc, IsAffineOpen.fromSpec_toSpecΓ hW, ← Spec.map_comp]
    rw [e]
    rfl

  have s3 : ∀ (R B : Type u) [CommRing R] [CommRing B] (σ : R →+* B) (I : Ideal R),
      AlgebraicGeometry.IsReduced (Limits.pullback (Spec.map (CommRingCat.ofHom σ))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) →
      _root_.IsReduced (B ⧸ Ideal.map σ I) := by
    intro R B _ _ σ I H
    letI := σ.toAlgebra
    have H' : AlgebraicGeometry.IsReduced
        (Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R B)))
          (Spec.map (CommRingCat.ofHom (algebraMap R (R ⧸ I))))) := H
    haveI := H'
    haveI : AlgebraicGeometry.IsReduced (Spec (.of (TensorProduct R B (R ⧸ I)))) :=
      isReduced_of_isOpenImmersion (pullbackSpecIso R B (R ⧸ I)).inv
    have h1 : _root_.IsReduced (TensorProduct R B (R ⧸ I)) :=
      (affine_isReduced_iff (CommRingCat.of (TensorProduct R B (R ⧸ I)))).mp inferInstance
    have h2 : _root_.IsReduced (B ⧸ Ideal.map (algebraMap R B) I) :=
      isReduced_of_injective (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).toRingHom
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).injective
    exact h2

  haveI : (IsLocalRing.maximalIdeal ↥W).IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥W
  letI : Field (↥W ⧸ IsLocalRing.maximalIdeal ↥W) :=
    Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W)
  haveI h1 : AlgebraicGeometry.IsReduced (Limits.pullback uZ
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W))))) :=
    wcpa_dj_ldx_semistable_fibre_reduced Z _ uZ hss (↥W ⧸ IsLocalRing.maximalIdeal ↥W)
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W))))
  haveI := hU.isOpenImmersion_fromSpec
  haveI h2 : AlgebraicGeometry.IsReduced
      (Limits.pullback hU.fromSpec (Limits.pullback.fst uZ
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)))))) :=
    isReduced_of_isOpenImmersion (Limits.pullback.snd hU.fromSpec (Limits.pullback.fst uZ
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W))))))
  haveI h3 : AlgebraicGeometry.IsReduced (Limits.pullback (hU.fromSpec ≫ uZ)
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W))))) :=
    isReduced_of_isOpenImmersion (Limits.pullbackRightPullbackFstIso uZ
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W))))
      hU.fromSpec).inv
  haveI h4 : AlgebraicGeometry.IsReduced
      (Limits.pullback (Spec.map (CommRingCat.ofHom (wcCnSigma uZ U)))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W))))) :=
    isReduced_of_isOpenImmersion (Limits.pullback.congrHom (s2 ↥W Z uZ U hU) rfl).inv
  exact s3 ↥W Γ(Z, U) (wcCnSigma uZ U) (IsLocalRing.maximalIdeal ↥W) h4

theorem wcpa_dj_lr1u_mnc_nagata_fp : ∀ (V A : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [CommRing A] [Algebra V A], Algebra.FiniteType V A → Module.Flat V A → Algebra.FinitePresentation V A :=
by
  intro V A _ _ _ _ _ hft hflat
  classical

  have s2 : ∀ {m : ℕ} (a g : MvPolynomial (Fin m) V) (e d : ℕ), g.IsHomogeneous e →
      MvPolynomial.homogeneousComponent d (a * g) =
        if e ≤ d then MvPolynomial.homogeneousComponent (d - e) a * g else 0 := by
    intro m a g e d hg
    induction a using MvPolynomial.induction_on' with
    | monomial μ r =>
      have h1 := MvPolynomial.isHomogeneous_monomial (σ := Fin m) (d := μ) r rfl
      have hh := h1.mul hg
      rw [MvPolynomial.homogeneousComponent_of_mem hh, MvPolynomial.homogeneousComponent_of_mem h1]
      split_ifs <;> first | rfl | omega
    | add p q hp hq =>
      rw [add_mul, map_add, hp, hq]
      split_ifs <;> simp [add_mul]

  have s3 : ∀ {m : ℕ} (H : MvPolynomial (Fin m) V),
      (∀ d, H.coeff d ∈ IsLocalRing.maximalIdeal V) →
      ∃ c ∈ IsLocalRing.maximalIdeal V, ∃ H' : MvPolynomial (Fin m) V,
        H = MvPolynomial.C c * H' ∧ H'.support ⊆ H.support := by
    intro m H hH
    by_cases hH0 : H = 0
    · exact ⟨0, zero_mem _, 0, by simp [hH0], by simp⟩
    have key : ∀ S : Finset (Fin m →₀ ℕ), S.Nonempty →
        ∃ p₀ ∈ S, ∀ p ∈ S, H.coeff p₀ ∣ H.coeff p := by
      intro S hS
      induction S using Finset.induction_on with
      | empty => exact absurd hS Finset.not_nonempty_empty
      | insert a S haS ih =>
        rcases S.eq_empty_or_nonempty with hSe | hSne
        · refine ⟨a, Finset.mem_insert_self _ _, fun p hp => ?_⟩
          rw [hSe] at hp
          rw [Finset.mem_singleton.mp hp]
        · obtain ⟨q, hq, hqd⟩ := ih hSne
          rcases ValuationRing.dvd_total (H.coeff a) (H.coeff q) with h | h
          · refine ⟨a, Finset.mem_insert_self _ _, fun p hp => ?_⟩
            rcases Finset.mem_insert.mp hp with rfl | hp
            · exact dvd_rfl
            · exact h.trans (hqd p hp)
          · refine ⟨q, Finset.mem_insert_of_mem hq, fun p hp => ?_⟩
            rcases Finset.mem_insert.mp hp with rfl | hp
            · exact h
            · exact hqd p hp
    have hne : H.support.Nonempty :=
      Finset.nonempty_iff_ne_empty.mpr (fun h => hH0 (MvPolynomial.support_eq_empty.mp h))
    obtain ⟨μ₀, _, hdvd⟩ := key H.support hne
    choose! q hq using hdvd
    refine ⟨H.coeff μ₀, hH μ₀, ∑ μ ∈ H.support, MvPolynomial.monomial μ (q μ), ?_, ?_⟩
    · rw [Finset.mul_sum]
      conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff H]
      refine Finset.sum_congr rfl fun μ hμ => ?_
      rw [MvPolynomial.C_mul_monomial, ← hq μ hμ]
    · intro ν hν
      by_contra hνH
      rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sum] at hν
      apply hν
      refine Finset.sum_eq_zero fun μ hμ => ?_
      rw [MvPolynomial.coeff_monomial, ite_eq_right_iff]
      rintro rfl
      exact absurd hμ hνH

  have s4 : ∀ {m : ℕ} (φ : MvPolynomial (Fin m) V →ₐ[V] A) (e : ℕ),
      (((RingHom.ker φ).restrictScalars V) ⊓
        MvPolynomial.homogeneousSubmodule (Fin m) V e).FG := by
    intro m φ e
    set Qe := MvPolynomial.homogeneousSubmodule (Fin m) V e with hQedef
    have hQe : Qe = Submodule.map (MvPolynomial.homogeneousComponent e)
        (MvPolynomial.restrictTotalDegree (Fin m) V e) := by
      ext p
      constructor
      · intro hp
        refine ⟨p, ?_, ?_⟩
        · show p ∈ MvPolynomial.restrictTotalDegree (Fin m) V e
          rw [MvPolynomial.mem_restrictTotalDegree]; exact hp.totalDegree_le
        · rw [MvPolynomial.homogeneousComponent_of_mem hp]; simp
      · rintro ⟨q, -, rfl⟩
        exact MvPolynomial.homogeneousComponent_isHomogeneous e q
    have hQfin : Module.Finite V Qe := by
      rw [Module.Finite.iff_fg, hQe]
      exact (Module.Finite.iff_fg.mp inferInstance).map _
    set φe : Qe →ₗ[V] A := φ.toLinearMap ∘ₗ Qe.subtype with hφe
    have : Module.Finite V (LinearMap.range φe) := Module.Finite.range φe
    have := Module.Flat.isTorsionFree (R := V) (M := A)
    have : Module.Flat V (LinearMap.range φe) := by
      rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
      intro x hx
      rw [Submodule.mem_torsion_iff] at hx
      obtain ⟨a, ha⟩ := hx
      have ha0 : (a : V) ≠ 0 := nonZeroDivisors.coe_ne_zero a
      have hreg : IsSMulRegular A (a : V) :=
        Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero ha0)
      have h2 : (a : V) • (x : A) = 0 := by
        have h3 := congrArg Subtype.val ha
        exact h3
      rw [Submodule.mem_bot]
      apply Subtype.ext
      apply hreg
      simp [h2]
    have : Module.Free V (LinearMap.range φe) := Module.free_of_flat_of_isLocalRing
    have : Module.FinitePresentation V (LinearMap.range φe) :=
      Module.finitePresentation_of_projective V _
    have hker : (LinearMap.ker φe).FG := by
      have := Module.FinitePresentation.fg_ker φe.rangeRestrict
        (LinearMap.surjective_rangeRestrict φe)
      rwa [LinearMap.ker_rangeRestrict] at this
    have heq : ((RingHom.ker φ).restrictScalars V) ⊓ Qe =
        Submodule.map Qe.subtype (LinearMap.ker φe) := by
      ext x
      constructor
      · rintro ⟨hx1, hx2⟩
        exact ⟨⟨x, hx2⟩, hx1, rfl⟩
      · rintro ⟨y, hy, rfl⟩
        exact ⟨hy, y.2⟩
    rw [heq]
    exact hker.map _

  have s5 : ∀ {m : ℕ} (φ : MvPolynomial (Fin (m+1)) V →ₐ[V] A), φ (MvPolynomial.X 0) = 1 →
      RingHom.ker φ ≤ Ideal.span {H | H ∈ RingHom.ker φ ∧ ∃ e, H.IsHomogeneous e} ⊔
        Ideal.span {MvPolynomial.X 0 - 1} := by
    intro m φ h0 F hF
    set N := F.totalDegree with hN
    set G := ∑ d ∈ Finset.range (N+1),
      MvPolynomial.X 0 ^ (N - d) * MvPolynomial.homogeneousComponent d F with hGdef
    have hG : G.IsHomogeneous N := by
      apply MvPolynomial.IsHomogeneous.sum
      intro d hd
      have hdN : d ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hd)
      have := (MvPolynomial.isHomogeneous_X_pow (R := V) (0 : Fin (m+1)) (N - d)).mul
        (MvPolynomial.homogeneousComponent_isHomogeneous d F)
      rwa [Nat.sub_add_cancel hdN] at this
    have hφG : φ G = 0 := by
      simp only [hGdef, map_sum, map_mul, map_pow, h0, one_pow, one_mul]
      rw [← map_sum, MvPolynomial.sum_homogeneousComponent]
      exact hF
    have hFG : F - G ∈ Ideal.span {MvPolynomial.X 0 - 1} := by
      have : F - G = ∑ d ∈ Finset.range (N+1),
          (1 - MvPolynomial.X 0 ^ (N - d)) * MvPolynomial.homogeneousComponent d F := by
        conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent F]
        rw [hGdef, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun d _ => by ring
      rw [this]
      refine Ideal.sum_mem _ fun d _ => ?_
      apply Ideal.mul_mem_right
      rw [Ideal.mem_span_singleton]
      have := sub_one_dvd_pow_sub_one (MvPolynomial.X 0 : MvPolynomial (Fin (m+1)) V) (N - d)
      rw [show (1 : MvPolynomial (Fin (m+1)) V) - MvPolynomial.X 0 ^ (N - d) =
        -(MvPolynomial.X 0 ^ (N - d) - 1) by ring]
      exact (dvd_neg).mpr this
    have hsplit : F = G + (F - G) := by ring
    rw [hsplit]
    exact Submodule.add_mem_sup (Ideal.subset_span ⟨(RingHom.mem_ker).mpr hφG, N, hG⟩) hFG

  have s6 : ∀ {m : ℕ} (J : Ideal (MvPolynomial (Fin m) V)),
      (∀ e : ℕ, ((J.restrictScalars V) ⊓ MvPolynomial.homogeneousSubmodule (Fin m) V e).FG) →
      (∀ (e : ℕ) (H : MvPolynomial (Fin m) V), H ∈ J → H.IsHomogeneous e →
        (∀ d, H.coeff d ∈ IsLocalRing.maximalIdeal V) →
        H ∈ IsLocalRing.maximalIdeal V •
          ((J.restrictScalars V) ⊓ MvPolynomial.homogeneousSubmodule (Fin m) V e)) →
      (Ideal.span {H | H ∈ J ∧ ∃ e, H.IsHomogeneous e}).FG := by
    intro m J hfg hmJ
    set T := {H | H ∈ J ∧ ∃ e, H.IsHomogeneous e} with hTdef
    set π : MvPolynomial (Fin m) V →+* MvPolynomial (Fin m) (IsLocalRing.ResidueField V) :=
      MvPolynomial.map (IsLocalRing.residue V) with hπdef
    have hπs : Function.Surjective π :=
      MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
    have hπhc : ∀ (p : MvPolynomial (Fin m) V) (e : ℕ),
        π (MvPolynomial.homogeneousComponent e p) = MvPolynomial.homogeneousComponent e (π p) := by
      intro p e
      ext d
      rw [hπdef, MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent,
        MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_map]
      split_ifs <;> simp
    have hfgk : (Ideal.span (π '' T)).FG := IsNoetherian.noetherian _
    obtain ⟨s', hs'T, hs'⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hfgk
    obtain ⟨T₀, hT₀T, hT₀img⟩ := Finset.subset_set_image_iff.mp hs'T
    set K : Ideal (MvPolynomial (Fin m) V) := Ideal.span (T₀ : Set (MvPolynomial (Fin m) V))
      with hKdef
    have hKmap : Ideal.span (π '' T) = Ideal.map π K := by
      rw [hKdef, Ideal.map_span, ← Finset.coe_image, hT₀img]
      exact hs'
    have hdegex : ∀ t ∈ T₀, ∃ e, t.IsHomogeneous e := fun t ht => (hT₀T ht).2
    choose! deg hdeg using hdegex
    have hKJ : K ≤ J := Ideal.span_le.mpr (fun t ht => (hT₀T ht).1)
    have stepC : ∀ e : ℕ, ((J.restrictScalars V) ⊓ MvPolynomial.homogeneousSubmodule (Fin m) V e) ≤
        K.restrictScalars V ⊔ IsLocalRing.maximalIdeal V •
          ((J.restrictScalars V) ⊓ MvPolynomial.homogeneousSubmodule (Fin m) V e) := by
      intro e H hH
      obtain ⟨hHJ, hHe⟩ := hH
      have hHJ' : H ∈ J := hHJ
      have hHe' : H.IsHomogeneous e := hHe
      have hπH : π H ∈ Ideal.map π K := by
        rw [← hKmap]
        exact Ideal.subset_span ⟨H, ⟨hHJ', e, hHe'⟩, rfl⟩
      obtain ⟨x, hxK, hx⟩ := (Ideal.mem_map_iff_of_surjective π hπs).mp hπH
      obtain ⟨a, -, ha⟩ := (Submodule.mem_span_finset).mp hxK
      set H₁ := MvPolynomial.homogeneousComponent e x with hH₁def
      have hH₁K : H₁ ∈ K := by
        rw [hH₁def, ← ha, map_sum]
        refine Ideal.sum_mem _ fun t ht => ?_
        rw [smul_eq_mul, s2 (a t) t (deg t) e (hdeg t ht)]
        split_ifs
        · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ht)
        · exact zero_mem _
      have hπH₁ : π H₁ = π H := by
        rw [hH₁def, hπhc, hx,
          MvPolynomial.homogeneousComponent_of_mem (hHe'.map (IsLocalRing.residue V))]
        simp [hπdef]
      set D := H - H₁ with hDdef
      have hDJ : D ∈ J := J.sub_mem hHJ' (hKJ hH₁K)
      have hDe : D.IsHomogeneous e :=
        (MvPolynomial.homogeneousSubmodule (Fin m) V e).sub_mem hHe'
          (MvPolynomial.homogeneousComponent_isHomogeneous e x)
      have hπD : π D = 0 := by rw [hDdef, map_sub, hπH₁, sub_self]
      have hDm : ∀ d, D.coeff d ∈ IsLocalRing.maximalIdeal V := by
        intro d
        rw [← IsLocalRing.residue_eq_zero_iff]
        have h1 := congrArg (fun p : MvPolynomial (Fin m) (IsLocalRing.ResidueField V) => p.coeff d) hπD
        simp only [hπdef, MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at h1
        exact h1
      have hDin := hmJ e D hDJ hDe hDm
      have hsum : H = H₁ + D := by rw [hDdef]; ring
      rw [hsum]
      exact Submodule.add_mem_sup hH₁K hDin
    have stepD : ∀ e : ℕ, ((J.restrictScalars V) ⊓ MvPolynomial.homogeneousSubmodule (Fin m) V e) ≤
        K.restrictScalars V := fun e =>
      Submodule.le_of_le_smul_of_le_jacobson_bot (hfg e) (IsLocalRing.maximalIdeal_le_jacobson ⊥)
        (stepC e)
    have hTK : Ideal.span T = K := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro t ⟨htJ, e, hte⟩
        exact stepD e ⟨htJ, hte⟩
      · exact Ideal.span_mono hT₀T
    rw [hTK]
    exact ⟨T₀, rfl⟩

  obtain ⟨n, ψ, hψ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
  set g : Fin (n+1) → A := Fin.cons 1 (fun i => ψ (MvPolynomial.X i)) with hgdef
  set φ : MvPolynomial (Fin (n+1)) V →ₐ[V] A := MvPolynomial.aeval g with hφdef
  have h0 : φ (MvPolynomial.X 0) = 1 := by
    rw [hφdef, MvPolynomial.aeval_X, hgdef, Fin.cons_zero]
  have hφs : Function.Surjective φ := by
    intro a
    obtain ⟨p, rfl⟩ := hψ a
    refine ⟨MvPolynomial.rename Fin.succ p, ?_⟩
    rw [hφdef, MvPolynomial.aeval_rename]
    have hg : g ∘ Fin.succ = fun i => ψ (MvPolynomial.X i) := funext fun i => by
      rw [Function.comp_apply, hgdef, Fin.cons_succ]
    rw [hg]
    have := congrArg (fun f : MvPolynomial (Fin n) V →ₐ[V] A => f p) (MvPolynomial.aeval_unique ψ)
    exact this.symm
  have := Module.Flat.isTorsionFree (R := V) (M := A)

  have hii : ∀ (e : ℕ) (H : MvPolynomial (Fin (n+1)) V), H ∈ RingHom.ker φ →
      H.IsHomogeneous e → (∀ d, H.coeff d ∈ IsLocalRing.maximalIdeal V) →
      H ∈ IsLocalRing.maximalIdeal V •
        (((RingHom.ker φ).restrictScalars V) ⊓
          MvPolynomial.homogeneousSubmodule (Fin (n+1)) V e) := by
    intro e H hHJ hHe hHm
    obtain ⟨c, hc, H', rfl, hsupp⟩ := s3 H hHm
    by_cases hc0 : c = 0
    · rw [hc0, MvPolynomial.C_0, zero_mul]
      exact zero_mem _
    have hH'e : H'.IsHomogeneous e := by
      intro d hd
      exact hHe (MvPolynomial.mem_support_iff.mp (hsupp (MvPolynomial.mem_support_iff.mpr hd)))
    have hreg : IsSMulRegular A c :=
      Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hc0)
    have hH'J : H' ∈ RingHom.ker φ := by
      rw [RingHom.mem_ker] at hHJ ⊢
      rw [map_mul, hφdef, MvPolynomial.aeval_C, ← Algebra.smul_def] at hHJ
      apply hreg
      show c • φ H' = c • (0 : A)
      rw [smul_zero]
      exact hHJ
    rw [← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem_smul hc ⟨hH'J, hH'e⟩

  have hJ : RingHom.ker φ = Ideal.span {H | H ∈ RingHom.ker φ ∧ ∃ e, H.IsHomogeneous e} ⊔
      Ideal.span {MvPolynomial.X 0 - 1} := by
    apply le_antisymm (s5 φ h0)
    apply sup_le
    · rw [Ideal.span_le]
      intro t ht
      exact ht.1
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_sub, h0, map_one, sub_self]
  have hFG : (RingHom.ker φ).FG := by
    rw [hJ]
    exact Submodule.FG.sup (s6 (RingHom.ker φ) (fun e => s4 φ e) hii)
      (Submodule.fg_span_singleton _)
  exact Algebra.FinitePresentation.mk ⟨n+1, φ, hφs, hFG⟩

theorem wcpa_pp_free_of_sat_fg : ∀ (V M : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [AddCommGroup M] [Module V M], Module.IsTorsionFree V M → (∃ e : ℕ → M, Submodule.span V (Set.range e) = ⊤) → (∀ F : Submodule V M, F.FG → (Submodule.span V {x : M | ∃ c : V, c ≠ 0 ∧ c • x ∈ F}).FG) → Module.Projective V M :=
by
  intro V M _ _ _ _ _ htf hgen hsat
  classical
  haveI := htf
  obtain ⟨e, he⟩ := hgen

  have satmem : ∀ (F : Submodule V M) (x : M),
      x ∈ Submodule.span V {y : M | ∃ c : V, c ≠ 0 ∧ c • y ∈ F} ↔
        ∃ c : V, c ≠ 0 ∧ c • x ∈ F := by
    intro F x
    constructor
    · intro hx
      induction hx using Submodule.span_induction with
      | mem y hy => exact hy
      | zero => exact ⟨1, one_ne_zero, by simp⟩
      | add y z _ _ hy hz =>
        obtain ⟨c, hc, hcy⟩ := hy
        obtain ⟨d, hd, hdz⟩ := hz
        refine ⟨c * d, mul_ne_zero hc hd, ?_⟩
        have : (c * d) • (y + z) = d • (c • y) + c • (d • z) := by
          rw [smul_add, smul_smul, smul_smul, mul_comm d c]
        rw [this]
        exact F.add_mem (F.smul_mem d hcy) (F.smul_mem c hdz)
      | smul a y _ hy =>
        obtain ⟨c, hc, hcy⟩ := hy
        refine ⟨c, hc, ?_⟩
        rw [smul_comm]
        exact F.smul_mem a hcy
    · intro h
      exact Submodule.subset_span h

  have fgtf : ∀ (N : Type u) [AddCommGroup N] [Module V N], Module.IsTorsionFree V N →
      Module.Finite V N → Module.Projective V N := by
    intro N _ _ htfN hfinN
    have h1 : Submodule.torsion V N = ⊥ := (Submodule.isTorsionFree_iff_torsion_eq_bot).mp htfN
    have : Module.Flat V N := (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout).mpr h1
    have : Module.Free V N := Module.free_of_flat_of_isLocalRing
    exact Module.Projective.of_free

  have chain : ∀ (G : ℕ → Submodule V M), G 0 = ⊥ → (∀ n, G n ≤ G (n + 1)) →
      (∀ x : M, ∃ n, x ∈ G n) →
      (∀ n, Module.Projective V (↥(G (n + 1)) ⧸ Submodule.comap (G (n + 1)).subtype (G n))) →
      Module.Projective V M := by
    intro G h0 hmono hex hP
    have hmono' : Monotone G := monotone_nat_of_le_succ hmono
    have hσ : ∀ n, ∃ σ : (↥(G (n + 1)) ⧸ Submodule.comap (G (n + 1)).subtype (G n)) →ₗ[V]
        ↥(G (n + 1)),
        (Submodule.comap (G (n + 1)).subtype (G n)).mkQ.comp σ = LinearMap.id := fun n =>
      Module.projective_lifting_property _ LinearMap.id (Submodule.mkQ_surjective _)
    choose σ hσ using hσ
    have hπσ : ∀ n q, (Submodule.comap (G (n + 1)).subtype (G n)).mkQ (σ n q) = q :=
      fun n q => LinearMap.congr_fun (hσ n) q
    have hπ0 : ∀ n (y : ↥(G (n + 1))),
        (Submodule.comap (G (n + 1)).subtype (G n)).mkQ y = 0 ↔ (y : M) ∈ G n := fun n y => by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      rfl
    let τ : ∀ n, (↥(G (n + 1)) ⧸ Submodule.comap (G (n + 1)).subtype (G n)) →ₗ[V] M :=
      fun n => (G (n + 1)).subtype.comp (σ n)
    have hτ : ∀ n q, τ n q = ((σ n q : ↥(G (n + 1))) : M) := fun n q => rfl
    let Φ := DFinsupp.lsum ℕ
      (M := fun n => ↥(G (n + 1)) ⧸ Submodule.comap (G (n + 1)).subtype (G n)) τ
    have hΦs : ∀ n q, Φ (DFinsupp.single n q) = τ n q := fun n q => DFinsupp.lsum_single ℕ τ n q
    have hbound : ∀ N f, (∀ i, N ≤ i → f i = 0) → Φ f ∈ G N := by
      intro N f hf
      have e1 : Φ f = f.sum (fun i q => τ i q) := DFinsupp.sumAddHom_apply _ f
      rw [e1]
      apply Submodule.dfinsuppSum_mem
      intro i hi
      have hiN : i < N := by
        by_contra h
        exact hi (hf i (not_lt.mp h))
      exact hmono' (Nat.succ_le_of_lt hiN) (σ i (f i)).2
    have hinjN : ∀ N f, (∀ i, N ≤ i → f i = 0) → Φ f = 0 → f = 0 := by
      intro N
      induction N with
      | zero =>
        intro f hf _
        ext i
        exact hf i (Nat.zero_le i)
      | succ N ih =>
        intro f hf hΦ
        have hf' : ∀ i, N ≤ i → (f.erase N) i = 0 := by
          intro i hi
          rcases eq_or_lt_of_le hi with h | h
          · rw [← h, DFinsupp.erase_same]
          · rw [DFinsupp.erase_ne (ne_of_gt h)]
            exact hf i h
        have hsplit : f = DFinsupp.single N (f N) + f.erase N :=
          (DFinsupp.single_add_erase N f).symm
        have hb := hbound N (f.erase N) hf'
        have hΦ' : τ N (f N) + Φ (f.erase N) = 0 := by
          rw [← hΦs, ← map_add, ← hsplit]
          exact hΦ
        have hfN : f N = 0 := by
          have hy : σ N (f N) + ⟨Φ (f.erase N), hmono N hb⟩ = 0 := by
            apply Subtype.ext
            rw [Submodule.coe_add, ← hτ]
            exact hΦ'
          have h2 := congrArg (Submodule.comap (G (N + 1)).subtype (G N)).mkQ hy
          rw [map_add, hπσ, map_zero, (hπ0 N _).mpr hb, add_zero] at h2
          exact h2
        have hΦe : Φ (f.erase N) = 0 := by
          rw [hfN, map_zero, zero_add] at hΦ'
          exact hΦ'
        have he' := ih _ hf' hΦe
        rw [hsplit, he', hfN, DFinsupp.single_zero, add_zero]
    have hinj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro f hf
      apply hinjN (f.support.sup id + 1) f _ hf
      intro i hi
      by_contra hne
      have hmem : i ∈ f.support := DFinsupp.mem_support_iff.mpr hne
      have := Finset.le_sup (f := id) hmem
      simp only [id] at this
      omega
    have hsurjN : ∀ n, ∀ x ∈ G n, ∃ f, Φ f = x := by
      intro n
      induction n with
      | zero =>
        intro x hx
        rw [h0, Submodule.mem_bot] at hx
        exact ⟨0, by rw [map_zero, hx]⟩
      | succ n ih =>
        intro x hx
        set y : ↥(G (n + 1)) := ⟨x, hx⟩ with hydef
        set q := (Submodule.comap (G (n + 1)).subtype (G n)).mkQ y with hq
        have hz : ((y - σ n q : ↥(G (n + 1))) : M) ∈ G n := by
          rw [← hπ0, map_sub, hπσ, sub_self]
        obtain ⟨g, hg⟩ := ih _ hz
        refine ⟨g + DFinsupp.single n q, ?_⟩
        rw [map_add, hΦs, hg, hτ, Submodule.coe_sub, sub_add_cancel]
    have hsurj : Function.Surjective Φ := by
      intro x
      obtain ⟨n, hn⟩ := hex x
      exact hsurjN n x hn
    have : ∀ n, Module.Projective V
        (↥(G (n + 1)) ⧸ Submodule.comap (G (n + 1)).subtype (G n)) := hP
    exact Module.Projective.of_equiv (LinearEquiv.ofBijective Φ ⟨hinj, hsurj⟩)

  obtain ⟨F, hFdef⟩ : ∃ F : ℕ → Submodule V M,
      ∀ n, F n = Submodule.span V (e '' Set.Iio n) := ⟨_, fun n => rfl⟩
  obtain ⟨G, hGdef⟩ : ∃ G : ℕ → Submodule V M,
      ∀ n, G n = Submodule.span V {x : M | ∃ c : V, c ≠ 0 ∧ c • x ∈ F n} := ⟨_, fun n => rfl⟩
  have hGmem : ∀ n x, x ∈ G n ↔ ∃ c : V, c ≠ 0 ∧ c • x ∈ F n := by
    intro n x
    rw [hGdef]
    exact satmem _ _
  have g1 : ∀ n, (G n).FG := by
    intro n
    rw [hGdef]
    apply hsat
    rw [hFdef]
    exact Submodule.fg_span ((Set.finite_Iio n).image e)
  have hFmono : ∀ n, F n ≤ F (n + 1) := by
    intro n
    rw [hFdef, hFdef]
    exact Submodule.span_mono (Set.image_mono (Set.Iio_subset_Iio (Nat.le_succ n)))
  have g2 : ∀ n, G n ≤ G (n + 1) := by
    intro n x hx
    obtain ⟨c, hc, hcx⟩ := (hGmem n x).mp hx
    exact (hGmem (n + 1) x).mpr ⟨c, hc, hFmono n hcx⟩
  have g3 : G 0 = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    obtain ⟨c, hc, hcx⟩ := (hGmem 0 x).mp hx
    have hF0 : F 0 = ⊥ := by
      have hE : e '' Set.Iio 0 = ∅ := by
        ext y
        simp
      rw [hFdef, hE, Submodule.span_empty]
    rw [hF0, Submodule.mem_bot] at hcx
    rw [Submodule.mem_bot]
    exact (Module.IsTorsionFree.isSMulRegular (IsRegular.of_ne_zero hc))
      (show c • x = c • (0 : M) by rw [hcx, smul_zero])
  have hei : ∀ i, e i ∈ G (i + 1) := by
    intro i
    refine (hGmem _ _).mpr ⟨1, one_ne_zero, ?_⟩
    rw [one_smul, hFdef]
    exact Submodule.subset_span (Set.mem_image_of_mem e (Nat.lt_succ_self i))
  have g4 : ∀ x : M, ∃ n, x ∈ G n := by
    intro x
    have hle : (⊤ : Submodule V M) ≤ ⨆ n, G n := by
      rw [← he, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact (le_iSup G (i + 1)) (hei i)
    have hx : x ∈ ⨆ n, G n := hle Submodule.mem_top
    exact (Submodule.mem_iSup_of_directed G (monotone_nat_of_le_succ g2).directed_le).mp hx
  have g5 : ∀ n (c : V) (y : M), c ≠ 0 → c • y ∈ G n → y ∈ G n := by
    intro n c y hc h
    obtain ⟨d, hd, hdy⟩ := (hGmem n _).mp h
    exact (hGmem n y).mpr ⟨d * c, mul_ne_zero hd hc, by rw [mul_smul]; exact hdy⟩
  have g8 : ∀ n, Module.Projective V
      (↥(G (n + 1)) ⧸ Submodule.comap (G (n + 1)).subtype (G n)) := by
    intro n
    have : Module.Finite V ↥(G (n + 1)) := Module.Finite.iff_fg.mpr (g1 (n + 1))
    have htfQ : Module.IsTorsionFree V
        (↥(G (n + 1)) ⧸ Submodule.comap (G (n + 1)).subtype (G n)) := by
      apply Module.IsTorsionFree.of_smul_eq_zero
      intro r q hrq
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      by_cases hr : r = 0
      · left
        exact hr
      · right
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hrq
        rw [Submodule.Quotient.mk_eq_zero]
        exact g5 n r y hr hrq
    exact fgtf _ htfQ inferInstance
  exact chain G g3 g2 g4 g8

theorem wcpa_pp_sat_fg_of_pure_embedding : ∀ (V A P : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [AddCommGroup A] [Module V A] [AddCommGroup P] [Module V P] [Module.Projective V P] (φ : A →ₗ[V] P), Function.Injective φ → (∀ (a : A) (c : V) (p : P), c ≠ 0 → φ a = c • p → ∃ a' : A, a = c • a') → ∀ F : Submodule V A, F.FG → (Submodule.span V {x : A | ∃ c : V, c ≠ 0 ∧ c • x ∈ F}).FG :=
by
  intro V A P _ _ _ _ _ _ _ _ φ hφ hpure F hF
  classical

  have s4 : ∀ (M : Type u) [AddCommGroup M] [Module V M] [Module.Finite V M] (N : Submodule V M),
      (∀ (c : V) (m : M), c ≠ 0 → c • m ∈ N → m ∈ N) → N.FG := by
    intro M _ _ _ N hN
    haveI : Module.Finite V (M ⧸ N) := Module.Finite.quotient V N
    have htor : Submodule.torsion V (M ⧸ N) = ⊥ := by
      rw [eq_bot_iff]
      intro z hz
      rw [Submodule.mem_torsion_iff] at hz
      obtain ⟨a, ha⟩ := hz
      obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective N z
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
      rw [Submonoid.smul_def, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at ha
      exact hN a m (nonZeroDivisors.coe_ne_zero a) ha
    haveI : Module.Flat V (M ⧸ N) := (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout).mpr htor
    haveI : Module.Free V (M ⧸ N) := Module.free_of_flat_of_isLocalRing
    obtain ⟨g, hg⟩ := LinearMap.exists_rightInverse_of_surjective N.mkQ (Submodule.range_mkQ N)
    have hrange : LinearMap.range (LinearMap.id - g ∘ₗ N.mkQ) = N := by
      apply le_antisymm
      · rintro _ ⟨m, rfl⟩
        apply (Submodule.Quotient.mk_eq_zero N).mp
        have := LinearMap.congr_fun hg (N.mkQ m)
        simp only [LinearMap.comp_apply, LinearMap.id_apply] at this
        show N.mkQ ((LinearMap.id - g ∘ₗ N.mkQ : M →ₗ[V] M) m) = 0
        simp only [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, map_sub, this,
          sub_self]
      · intro n hn
        refine ⟨n, ?_⟩
        have h0 : N.mkQ n = 0 := by
          rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]; exact hn
        simp only [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, h0, map_zero,
          sub_zero]
    rw [← hrange, LinearMap.range_eq_map]
    exact (Module.Finite.fg_top).map _

  have s2 : ∀ x : A, x ∈ Submodule.span V {y : A | ∃ c : V, c ≠ 0 ∧ c • y ∈ F} ↔
      ∃ c : V, c ≠ 0 ∧ c • x ∈ F := by
    intro x
    constructor
    · intro hx
      induction hx using Submodule.span_induction with
      | mem y hy => exact hy
      | zero => exact ⟨1, one_ne_zero, by rw [smul_zero]; exact F.zero_mem⟩
      | add y z _ _ hy hz =>
        obtain ⟨c, hc, hcy⟩ := hy
        obtain ⟨d, hd, hdz⟩ := hz
        refine ⟨c * d, mul_ne_zero hc hd, ?_⟩
        rw [smul_add]
        have e1 : (c * d) • y = d • (c • y) := by rw [mul_comm, mul_smul]
        have e2 : (c * d) • z = c • (d • z) := by rw [mul_smul]
        rw [e1, e2]
        exact F.add_mem (F.smul_mem _ hcy) (F.smul_mem _ hdz)
      | smul r y _ hy =>
        obtain ⟨c, hc, hcy⟩ := hy
        refine ⟨c, hc, ?_⟩
        rw [smul_comm]
        exact F.smul_mem _ hcy
    · intro hx
      exact Submodule.subset_span hx

  obtain ⟨s, hs⟩ := Module.projective_def'.mp (inferInstance : Module.Projective V P)
  have hπ : ∀ p, Finsupp.linearCombination V id (s p) = p := fun p => LinearMap.congr_fun hs p
  let ψ : A →ₗ[V] (P →₀ V) := s ∘ₗ φ
  have hψa : ∀ a, ψ a = s (φ a) := fun a => rfl
  have hψinj : Function.Injective ψ := by
    intro a b h
    apply hφ
    rw [← hπ (φ a), ← hπ (φ b), ← hψa, ← hψa, h]
  have hψpure : ∀ (a : A) (c : V) (q : P →₀ V), c ≠ 0 → ψ a = c • q → ∃ a', a = c • a' := by
    intro a c q hc h
    apply hpure a c (Finsupp.linearCombination V id q) hc
    have := congrArg (Finsupp.linearCombination V id) h
    rw [map_smul, hψa, hπ] at this
    exact this
  have hcanc : ∀ (c : V) (q : P →₀ V), c ≠ 0 → c • q = 0 → q = 0 := by
    intro c q hc h
    ext i
    have := congrArg (fun f => f i) h
    simp only [Finsupp.smul_apply, smul_eq_mul, Finsupp.coe_zero, Pi.zero_apply] at this
    rw [Finsupp.coe_zero, Pi.zero_apply]
    exact (mul_eq_zero.mp this).resolve_left hc

  obtain ⟨t, ht⟩ := hF
  let T : Finset P := t.biUnion (fun f => (ψ f).support)
  let QT : Submodule V (P →₀ V) := Finsupp.supported V V (↑T : Set P)
  have hQTfg : QT.FG := by
    show (Finsupp.supported V V (↑T : Set P)).FG
    rw [Finsupp.supported_eq_span_single]
    exact Submodule.fg_span ((Finset.finite_toSet T).image _)
  haveI : Module.Finite V QT := Module.Finite.iff_fg.mpr hQTfg
  have hFQ : ∀ x ∈ F, ψ x ∈ QT := by
    intro x hx
    rw [← ht] at hx
    have hle : Submodule.map ψ (Submodule.span V ↑t) ≤ QT := by
      rw [Submodule.map_span, Submodule.span_le]
      rintro _ ⟨f, hf, rfl⟩
      show ψ f ∈ Finsupp.supported V V (↑T : Set P)
      rw [Finsupp.mem_supported]
      intro i hi
      rw [Finset.mem_coe, Finset.mem_biUnion]
      exact ⟨f, hf, hi⟩
    exact hle ⟨x, hx, rfl⟩
  have hSQ : ∀ x ∈ Submodule.span V {y : A | ∃ c : V, c ≠ 0 ∧ c • y ∈ F}, ψ x ∈ QT := by
    intro x hx
    obtain ⟨d, hd, hdx⟩ := (s2 x).mp hx
    have h1 := hFQ _ hdx
    change ψ (d • x) ∈ Finsupp.supported V V (↑T : Set P) at h1
    show ψ x ∈ Finsupp.supported V V (↑T : Set P)
    rw [map_smul, Finsupp.mem_supported, Finsupp.support_smul_eq hd] at h1
    rw [Finsupp.mem_supported]
    exact h1

  let N : Submodule V (P →₀ V) :=
    Submodule.map ψ (Submodule.span V {y : A | ∃ c : V, c ≠ 0 ∧ c • y ∈ F})
  let N' : Submodule V QT := Submodule.comap QT.subtype N
  have hsat : ∀ (c : V) (q : QT), c ≠ 0 → c • q ∈ N' → q ∈ N' := by
    intro c q hc hq
    change (QT.subtype (c • q)) ∈ N at hq
    change QT.subtype q ∈ N
    rw [map_smul, Submodule.subtype_apply] at hq
    rw [Submodule.subtype_apply]
    obtain ⟨x, hxS, hx⟩ := hq
    obtain ⟨d, hd, hdx⟩ := (s2 x).mp hxS
    obtain ⟨a', ha'⟩ := hψpure x c q hc hx
    have hq' : (q : P →₀ V) = ψ a' := by
      apply sub_eq_zero.mp
      apply hcanc c _ hc
      rw [smul_sub, ← map_smul, ← ha', hx, sub_self]
    refine ⟨a', ?_, hq'.symm⟩
    apply (s2 a').mpr
    refine ⟨d * c, mul_ne_zero hd hc, ?_⟩
    rw [mul_smul, ← ha']
    exact hdx

  have hN'fg : N'.FG := s4 QT N' hsat
  have hle : N ≤ QT := by
    rintro _ ⟨x, hx, rfl⟩
    exact hSQ x hx
  have hNfg : N.FG := by
    have h1 := hN'fg.map QT.subtype
    have e : Submodule.map QT.subtype N' = N := by
      show Submodule.map QT.subtype (Submodule.comap QT.subtype N) = N
      rw [Submodule.map_comap_subtype, inf_eq_right.mpr hle]
    rw [e] at h1
    exact h1
  exact Submodule.fg_of_fg_map_injective ψ hψinj hNfg

theorem wcpa_pp_flat_cover_pure : ∀ (V A B : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [CommRing A] [IsDomain A] [Algebra V A] [CommRing B] [Algebra A B], ringKrullDim V ≤ ((1 : ℕ) : WithBot ℕ∞) → Module.Flat A B → Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V) ≠ ⊤ → (∀ 𝔭 : Ideal A, 𝔭.IsPrime → Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V) ≤ 𝔭 → ∃ 𝔮 : Ideal B, 𝔮.IsPrime ∧ Ideal.comap (algebraMap A B) 𝔮 = 𝔭) → Function.Injective (algebraMap A B) ∧ ∀ (a : A) (c : V), c ≠ 0 → algebraMap A B (algebraMap V A c) ∣ algebraMap A B a → algebraMap V A c ∣ a :=
by
  intro V A B _ _ _ _ _ _ _ _ hdim hflat hI hcov
  classical

  have s1 : ∀ (x a : A) (b : B), algebraMap A B x * b = algebraMap A B a →
      ∃ (k : ℕ) (r s : Fin k → A) (y : Fin k → B), (∀ j, r j * a = x * s j) ∧
        ∑ j, algebraMap A B (r j) * y j = 1 := by
    intro x a b hb
    obtain ⟨k, α, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := A) (M := B) (f := ![x, -a]) (x := ![b, 1]) (by
        rw [Fin.sum_univ_two]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
        rw [Algebra.smul_def, Algebra.smul_def, hb, map_neg, mul_one, add_neg_cancel])
    refine ⟨k, fun j => α 1 j, fun j => α 0 j, y, ?_, ?_⟩
    · intro j
      have h := h2 j
      rw [Fin.sum_univ_two] at h
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
      linear_combination -h
    · have h := h1 1
      have h' : (1 : B) = ∑ j, α 1 j • y j := h
      rw [h']
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Algebra.smul_def]

  have s2 : ∀ c : V, c ≠ 0 → ∀ 𝔭 : Ideal A, 𝔭.IsPrime → algebraMap V A c ∈ 𝔭 →
      Ideal.map (algebraMap V A) (IsLocalRing.maximalIdeal V) ≤ 𝔭 := by
    intro c hc 𝔭 h𝔭 hc𝔭
    have : Ring.KrullDimLE 1 V := Ring.krullDimLE_iff.mpr hdim
    have hQ : (Ideal.comap (algebraMap V A) 𝔭).IsPrime := Ideal.IsPrime.comap _
    have hQne : Ideal.comap (algebraMap V A) 𝔭 ≠ ⊥ := by
      intro h
      have hcQ : c ∈ Ideal.comap (algebraMap V A) 𝔭 := hc𝔭
      rw [h, Ideal.mem_bot] at hcQ
      exact hc hcQ
    have hmax : (Ideal.comap (algebraMap V A) 𝔭).IsMaximal :=
      Ideal.isMaximal_of_isPrime_of_ne_bot _ hQne
    rw [Ideal.map_le_iff_le_comap, IsLocalRing.eq_maximalIdeal hmax]

  have h10 : (1 : B) ≠ 0 := by
    intro h
    obtain ⟨𝔪, h𝔪, hI𝔪⟩ := Ideal.exists_le_maximal _ hI
    obtain ⟨𝔮, h𝔮, -⟩ := hcov 𝔪 h𝔪.isPrime hI𝔪
    exact h𝔮.ne_top ((Ideal.eq_top_iff_one _).mpr (h ▸ 𝔮.zero_mem))
  refine ⟨?_, ?_⟩
  ·
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra ha0
    obtain ⟨k, r, s, y, hr, hsum⟩ := s1 0 a 0 (by rw [map_zero, zero_mul, ha])
    apply h10
    rw [← hsum]
    apply Finset.sum_eq_zero
    intro j _
    have hrj : r j = 0 := by
      have h := hr j
      rw [zero_mul] at h
      exact (mul_eq_zero.mp h).resolve_right ha0
    rw [hrj, map_zero, zero_mul]
  ·
    rintro a c hc ⟨b, hb⟩
    obtain ⟨k, r, s, y, hr, hsum⟩ := s1 (algebraMap V A c) a b hb.symm
    by_contra hndvd
    let J : Ideal A :=
      { carrier := {t | algebraMap V A c ∣ t * a}
        add_mem' := fun {x z} hx hz => by
          change algebraMap V A c ∣ (x + z) * a
          rw [add_mul]
          exact dvd_add hx hz
        zero_mem' := by
          change algebraMap V A c ∣ 0 * a
          rw [zero_mul]
          exact dvd_zero _
        smul_mem' := fun z x hx => by
          change algebraMap V A c ∣ (z * x) * a
          rw [mul_assoc]
          exact dvd_mul_of_dvd_right hx z }
    have hmemJ : ∀ t, t ∈ J ↔ algebraMap V A c ∣ t * a := fun t => Iff.rfl
    have hJ : J ≠ ⊤ := by
      intro h
      have h1 : (1 : A) ∈ J := h ▸ Submodule.mem_top
      rw [hmemJ, one_mul] at h1
      exact hndvd h1
    obtain ⟨𝔪, h𝔪, hJ𝔪⟩ := Ideal.exists_le_maximal J hJ
    have hc𝔪 : algebraMap V A c ∈ 𝔪 := hJ𝔪 ((hmemJ _).mpr (dvd_mul_right _ _))
    obtain ⟨𝔮, h𝔮, h𝔮𝔪⟩ := hcov 𝔪 h𝔪.isPrime (s2 c hc 𝔪 h𝔪.isPrime hc𝔪)
    apply h𝔮.ne_top
    rw [Ideal.eq_top_iff_one, ← hsum]
    refine Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _ ?_)
    have hrj : r j ∈ Ideal.comap (algebraMap A B) 𝔮 := by
      rw [h𝔮𝔪]
      exact hJ𝔪 ((hmemJ _).mpr ⟨s j, hr j⟩)
    exact hrj

theorem wcpa_pple_dvls_noether_coord : ∀ (V : Type u) [CommRing V] [IsLocalRing V] (R : Type u) [CommRing R] [Algebra V R], Algebra.FiniteType V R → ∀ (J : Ideal R), Ideal.map (algebraMap V R) (IsLocalRing.maximalIdeal V) ≤ J → ∀ (𝔭 : Ideal R) (_ : 𝔭.IsPrime), J ≤ 𝔭 → ∀ d : ℕ, ringKrullDim (R ⧸ J) < ((d + 1 : ℕ) : WithBot ℕ∞) → ∃ (e : ℕ) (φ : MvPolynomial (Fin e) V →ₐ[V] R), e ≤ d ∧ RingHom.Finite ((Ideal.Quotient.mk J).comp φ.toRingHom) ∧ ∀ x : (𝔭.comap φ.toRingHom).ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x :=
by
  classical

  have s1 : ∀ (k : Type u) [Field k] (n : ℕ) (f : MvPolynomial (Fin (n + 1)) k), f ≠ 0 → ∃ T : MvPolynomial (Fin (n + 1)) k ≃ₐ[k] MvPolynomial (Fin (n + 1)) k, IsUnit (MvPolynomial.finSuccEquiv k n (T f)).leadingCoeff := by
    intro k _ n f hf
    classical
    set B := 2 + f.totalDegree with hB
    have hB0 : 0 < B := by omega
    let r : Fin (n + 1) → ℕ := fun i => B ^ (i : ℕ)
    let T1 : k → (MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k) := fun c =>
      MvPolynomial.aeval (fun i => if i = 0 then MvPolynomial.X 0 else MvPolynomial.X i + c • MvPolynomial.X 0 ^ r i)
    have hcomp : ∀ c : k, (T1 c).comp (T1 (-c)) = AlgHom.id k _ := by
      intro c
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · simp [T1]
      · simp [T1, Fin.succ_ne_zero]
    let T : MvPolynomial (Fin (n + 1)) k ≃ₐ[k] MvPolynomial (Fin (n + 1)) k :=
      AlgEquiv.ofAlgHom (T1 1) (T1 (-1)) (hcomp 1) (by simpa using hcomp (-1))
    refine ⟨T, ?_⟩
    have hm : ∀ j : Fin n, (Polynomial.C (MvPolynomial.X j) + Polynomial.X ^ r j.succ :
        Polynomial (MvPolynomial (Fin n) k)).Monic := by
      intro j
      rw [add_comm]
      exact Polynomial.monic_X_pow_add_C _ (pow_pos hB0 _).ne'
    let M : (Fin (n + 1) →₀ ℕ) → Polynomial (MvPolynomial (Fin n) k) := fun v =>
      Polynomial.X ^ v 0 * ∏ j : Fin n, (Polynomial.C (MvPolynomial.X j) + Polynomial.X ^ r j.succ) ^ v j.succ
    have hMmonic : ∀ v, (M v).Monic := fun v =>
      (Polynomial.monic_X_pow _).mul (Polynomial.monic_prod_of_monic _ _ (fun j _ => (hm j).pow _))
    have hMdeg : ∀ v, (M v).natDegree = ∑ i : Fin (n + 1), B ^ (i : ℕ) * v i := by
      intro v
      rw [Fin.sum_univ_succ]
      show (Polynomial.X ^ v 0 * ∏ j : Fin n, (Polynomial.C (MvPolynomial.X j) + Polynomial.X ^ r j.succ) ^ v j.succ).natDegree = _
      rw [(Polynomial.monic_X_pow _).natDegree_mul (Polynomial.monic_prod_of_monic _ _ (fun j _ => (hm j).pow _)),
        Polynomial.natDegree_prod_of_monic _ _ (fun j _ => (hm j).pow _), Polynomial.natDegree_X_pow]
      simp only [Fin.val_zero, pow_zero, one_mul]
      congr 1
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have h1 : (Polynomial.C (MvPolynomial.X j) + Polynomial.X ^ r j.succ :
          Polynomial (MvPolynomial (Fin n) k)).natDegree = r j.succ := by
        rw [add_comm]; exact Polynomial.natDegree_X_pow_add_C
      rw [(hm j).natDegree_pow, h1, mul_comm]
    have hC : ∀ a : k, MvPolynomial.finSuccEquiv k n (MvPolynomial.C a) = Polynomial.C (MvPolynomial.C a) := by
      intro a
      rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C]; rfl
    have hTmon : ∀ (v : Fin (n + 1) →₀ ℕ) (a : k), MvPolynomial.finSuccEquiv k n (T (MvPolynomial.monomial v a)) =
        Polynomial.C (MvPolynomial.C a) * M v := by
      intro v a
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
      simp [M, T, T1, Fin.prod_univ_succ, Fin.succ_ne_zero, MvPolynomial.finSuccEquiv_X_zero,
        MvPolynomial.finSuccEquiv_X_succ, r, hC]

    have hdig : ∀ (m : ℕ) (v w : Fin m → ℕ), (∀ i, v i < B) → (∀ i, w i < B) →
        ∑ i : Fin m, B ^ (i : ℕ) * v i = ∑ i : Fin m, B ^ (i : ℕ) * w i → v = w := by
      intro m
      induction m with
      | zero => intro v w _ _ _; funext i; exact Fin.elim0 i
      | succ m ih =>
        intro v w hv hw h
        rw [Fin.sum_univ_succ, Fin.sum_univ_succ] at h
        simp only [Fin.val_zero, pow_zero, one_mul, Fin.val_succ, pow_succ] at h
        have e1 : ∀ u : Fin (m + 1) → ℕ, ∑ x : Fin m, B ^ (x : ℕ) * B * u x.succ =
            B * ∑ x : Fin m, B ^ (x : ℕ) * u x.succ := by
          intro u; rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun x _ => by ring)
        rw [e1, e1] at h
        have h0 : v 0 = w 0 := by
          have := congrArg (· % B) h
          simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hv 0), Nat.mod_eq_of_lt (hw 0)] at this
          exact this
        rw [h0] at h
        have h' := Nat.eq_of_mul_eq_mul_left hB0 (Nat.add_left_cancel h)
        have hs := ih (fun x => v x.succ) (fun x => w x.succ) (fun x => hv _) (fun x => hw _) h'
        funext i
        refine Fin.cases h0 (fun x => ?_) i
        exact congrFun hs x
    set D : (Fin (n + 1) →₀ ℕ) → ℕ := fun v => ∑ i : Fin (n + 1), B ^ (i : ℕ) * v i with hD
    have hlt : ∀ v ∈ f.support, ∀ i, v i < B := by
      intro v hv i
      have := (MvPolynomial.monomial_le_degreeOf i hv).trans (MvPolynomial.degreeOf_le_totalDegree f i)
      omega
    have hDinj : ∀ v ∈ f.support, ∀ w ∈ f.support, D v = D w → v = w := by
      intro v hv w hw h
      exact DFunLike.coe_injective (hdig (n + 1) v w (hlt v hv) (hlt w hw) h)
    obtain ⟨v0, hv0, hmax⟩ := Finset.exists_max_image f.support D (MvPolynomial.support_nonempty.mpr hf)
    have hsum : MvPolynomial.finSuccEquiv k n (T f) =
        ∑ v ∈ f.support, Polynomial.C (MvPolynomial.C (f.coeff v)) * M v := by
      conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff f]
      rw [map_sum, map_sum]
      exact Finset.sum_congr rfl (fun v _ => hTmon v _)
    have hdeg : ∀ v ∈ f.support, (Polynomial.C (MvPolynomial.C (f.coeff v)) * M v).degree = (D v : WithBot ℕ) := by
      intro v hv
      have hc : MvPolynomial.C (f.coeff v) ≠ (0 : MvPolynomial (Fin n) k) :=
        MvPolynomial.C_ne_zero.mpr (MvPolynomial.mem_support_iff.mp hv)
      rw [Polynomial.degree_C_mul hc, Polynomial.degree_eq_natDegree (hMmonic v).ne_zero, hMdeg v]
    rw [hsum, ← Finset.add_sum_erase _ _ hv0, add_comm, Polynomial.leadingCoeff_add_of_degree_lt]
    · rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C, (hMmonic v0).leadingCoeff, mul_one]
      exact (isUnit_iff_ne_zero.mpr (MvPolynomial.mem_support_iff.mp hv0)).map MvPolynomial.C
    · rw [hdeg v0 hv0]
      refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
      rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
      intro v hv
      rw [hdeg v (Finset.mem_of_mem_erase hv)]
      have hne := Finset.ne_of_mem_erase hv
      have hle := hmax v (Finset.mem_of_mem_erase hv)
      have : D v ≠ D v0 := fun h => hne (hDinj v (Finset.mem_of_mem_erase hv) v0 hv0 h)
      exact_mod_cast lt_of_le_of_ne hle this

  have s23 : ∀ (k : Type u) [Field k], (∀ (n : ℕ) (h : MvPolynomial (Fin (n + 1)) k), IsUnit (MvPolynomial.finSuccEquiv k n h).leadingCoeff → 0 < (MvPolynomial.finSuccEquiv k n h).natDegree → (MvPolynomial.aeval (Fin.cons h (fun j : Fin n => MvPolynomial.X j.succ) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k) : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k).Finite) ∧ (∀ (n : ℕ) (ψ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k), ψ.Finite → (MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.rename Fin.succ (ψ (MvPolynomial.X j)))) : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k).Finite) := by
    intro k _
    classical

    have fin_of_X : ∀ (m : ℕ) (θ : MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin m) k),
        (∀ i, θ.toRingHom.IsIntegralElem (MvPolynomial.X i)) → θ.Finite := by
      intro m θ hX
      have hint : θ.toRingHom.IsIntegral := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a =>
          have := RingHom.isIntegralElem_map θ.toRingHom (x := MvPolynomial.C a)
          simpa [MvPolynomial.algebraMap_eq] using this
        | add p q hp hq => exact RingHom.IsIntegralElem.add _ hp hq
        | mul_X p i hp => exact RingHom.IsIntegralElem.mul _ hp (hX i)
      have hft : θ.toRingHom.FiniteType := by
        apply RingHom.FiniteType.of_comp_finiteType (f := algebraMap k (MvPolynomial (Fin m) k))
        have : θ.toRingHom.comp (algebraMap k _) = algebraMap k _ := θ.comp_algebraMap
        rw [this]
        exact RingHom.finiteType_algebraMap.mpr inferInstance
      exact RingHom.IsIntegral.to_finite hint hft
    have hC : ∀ (n : ℕ) (a : k), MvPolynomial.finSuccEquiv k n (MvPolynomial.C a) = Polynomial.C (MvPolynomial.C a) := by
      intro n a
      rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C]; rfl

    have hK : ∀ (n : ℕ) (p : MvPolynomial (Fin (n + 1)) k),
        Polynomial.eval₂ (MvPolynomial.rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin (n + 1)) k).toRingHom
          (MvPolynomial.X 0) (MvPolynomial.finSuccEquiv k n p) = p := by
      intro n p
      induction p using MvPolynomial.induction_on with
      | C a => rw [hC, Polynomial.eval₂_C]; exact MvPolynomial.rename_C _ _
      | add p q hp hq => rw [map_add, Polynomial.eval₂_add, hp, hq]
      | mul_X p i hp =>
        rw [map_mul, Polynomial.eval₂_mul, hp]
        congr 1
        refine Fin.cases ?_ (fun j => ?_) i
        · rw [MvPolynomial.finSuccEquiv_X_zero, Polynomial.eval₂_X]
        · rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval₂_C]
          exact MvPolynomial.rename_X _ _

    have s2 : ∀ (n : ℕ) (h : MvPolynomial (Fin (n + 1)) k), IsUnit (MvPolynomial.finSuccEquiv k n h).leadingCoeff → 0 < (MvPolynomial.finSuccEquiv k n h).natDegree → (MvPolynomial.aeval (Fin.cons h (fun j : Fin n => MvPolynomial.X j.succ) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k) : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k).Finite := by
      intro n h hu hdeg
      set θ : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k :=
        MvPolynomial.aeval (Fin.cons h (fun j : Fin n => MvPolynomial.X j.succ) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k) with hθ
      set ι : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin (n + 1)) k := MvPolynomial.rename Fin.succ with hι
      have hιinj : Function.Injective ι := MvPolynomial.rename_injective _ (Fin.succ_injective _)
      have hθι : θ.comp ι = ι := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [θ, ι, MvPolynomial.rename_X]
      set H := MvPolynomial.finSuccEquiv k n h with hH
      set P : Polynomial (MvPolynomial (Fin (n + 1)) k) := H.map ι.toRingHom - Polynomial.C (MvPolynomial.X 0) with hP
      have hPlc : P.leadingCoeff = ι H.leadingCoeff := by
        rw [hP, Polynomial.leadingCoeff_sub_of_degree_lt, Polynomial.leadingCoeff_map_of_injective hιinj]
        · rfl
        · refine lt_of_le_of_lt Polynomial.degree_C_le ?_
          rw [Polynomial.degree_eq_natDegree, Polynomial.natDegree_map_eq_of_injective hιinj]
          · exact_mod_cast hdeg
          · intro h0
            rw [Polynomial.map_eq_zero_iff hιinj] at h0
            rw [h0, Polynomial.natDegree_zero] at hdeg
            exact lt_irrefl _ hdeg
      have hPu : IsUnit P.leadingCoeff := by rw [hPlc]; exact hu.map ι
      have hX0 : θ.toRingHom.IsIntegralElem (MvPolynomial.X 0) := by
        refine ⟨(hPu.unit⁻¹ : (MvPolynomial (Fin (n + 1)) k)ˣ) • P, Polynomial.monic_of_isUnit_leadingCoeff_inv_smul hPu, ?_⟩
        rw [Units.smul_def, Polynomial.eval₂_smul]
        have e1 : θ.toRingHom.comp ι.toRingHom = ι.toRingHom :=
          RingHom.ext (fun x => DFunLike.congr_fun hθι x)
        have e2 : Polynomial.eval₂ θ.toRingHom (MvPolynomial.X 0) P = 0 := by
          rw [hP, Polynomial.eval₂_sub, Polynomial.eval₂_map, Polynomial.eval₂_C, e1, hK]
          simp [θ]
        rw [e2, mul_zero]
      apply fin_of_X
      intro i
      refine Fin.cases hX0 (fun j => ?_) i
      have := RingHom.isIntegralElem_map θ.toRingHom (x := MvPolynomial.X j.succ)
      simpa [θ] using this

    have s3 : ∀ (n : ℕ) (ψ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k), ψ.Finite → (MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.rename Fin.succ (ψ (MvPolynomial.X j)))) : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k).Finite := by
      intro n ψ hψ
      set Ψ : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k :=
        MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.rename Fin.succ (ψ (MvPolynomial.X j)))) with hΨ
      set ι : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin (n + 1)) k := MvPolynomial.rename Fin.succ with hι
      have hΨι : Ψ.comp ι = ι.comp ψ := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [Ψ, ι, MvPolynomial.rename_X]
      have hψi : ψ.toRingHom.IsIntegral := RingHom.IsIntegral.of_finite hψ
      apply fin_of_X
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · have := RingHom.isIntegralElem_map Ψ.toRingHom (x := MvPolynomial.X 0)
        simpa [Ψ] using this
      · obtain ⟨p, hpm, hp⟩ := hψi (MvPolynomial.X j)
        refine ⟨p.map ι.toRingHom, hpm.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        have e1 : Ψ.toRingHom.comp ι.toRingHom = ι.toRingHom.comp ψ.toRingHom :=
          RingHom.ext (fun x => DFunLike.congr_fun hΨι x)
        have e2 : (MvPolynomial.X j.succ : MvPolynomial (Fin (n + 1)) k) = ι.toRingHom (MvPolynomial.X j) := by
          simp [ι, MvPolynomial.rename_X]
        rw [e1, e2, ← Polynomial.hom_eval₂, hp, map_zero]
    exact ⟨s2, s3⟩

  have s4 : ∀ (k : Type u) [Field k], (∀ (n : ℕ) (f : MvPolynomial (Fin (n + 1)) k), f ≠ 0 → ∃ T : MvPolynomial (Fin (n + 1)) k ≃ₐ[k] MvPolynomial (Fin (n + 1)) k, IsUnit (MvPolynomial.finSuccEquiv k n (T f)).leadingCoeff) → (∀ (n : ℕ) (h : MvPolynomial (Fin (n + 1)) k), IsUnit (MvPolynomial.finSuccEquiv k n h).leadingCoeff → 0 < (MvPolynomial.finSuccEquiv k n h).natDegree → (MvPolynomial.aeval (Fin.cons h (fun j : Fin n => MvPolynomial.X j.succ) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k) : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k).Finite) → (∀ (n : ℕ) (ψ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k), ψ.Finite → (MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.rename Fin.succ (ψ (MvPolynomial.X j)))) : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k).Finite) → ∀ (n : ℕ) (𝔮 : Ideal (MvPolynomial (Fin n) k)), 𝔮.IsPrime → ∃ (ψ₀ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k) (S : Finset (Fin n)), ψ₀.Finite ∧ 𝔮.comap ψ₀.toRingHom = RingHom.ker (MvPolynomial.aeval (fun i : Fin n => if i ∈ S then (0 : MvPolynomial (Fin n) k) else MvPolynomial.X i) : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k).toRingHom := by
    intro k _ s1 s2 s3
    classical
    have idcase : ∀ (n : ℕ) (𝔮 : Ideal (MvPolynomial (Fin n) k)), 𝔮 = ⊥ → ∃ (ψ₀ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k) (S : Finset (Fin n)), ψ₀.Finite ∧ 𝔮.comap ψ₀.toRingHom = RingHom.ker (MvPolynomial.aeval (fun i : Fin n => if i ∈ S then (0 : MvPolynomial (Fin n) k) else MvPolynomial.X i) : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k).toRingHom := by
      intro n 𝔮 h
      refine ⟨AlgHom.id k _, ∅, RingHom.Finite.id _, ?_⟩
      have e : (MvPolynomial.aeval (fun i : Fin n => if i ∈ (∅ : Finset (Fin n)) then (0 : MvPolynomial (Fin n) k) else MvPolynomial.X i) : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k) = AlgHom.id k _ := by
        apply MvPolynomial.algHom_ext; intro i; simp
      rw [e, h]
      ext x
      simp [RingHom.mem_ker]
    intro n
    induction n with
    | zero =>
      intro 𝔮 h𝔮
      apply idcase
      rw [eq_bot_iff]
      intro p hp
      rw [Ideal.mem_bot]
      rw [MvPolynomial.eq_C_of_isEmpty p] at hp ⊢
      by_contra hne
      have hc : p.coeff 0 ≠ 0 := fun h => hne (by rw [h, map_zero])
      exact h𝔮.ne_top (Ideal.eq_top_of_isUnit_mem _ hp ((isUnit_iff_ne_zero.mpr hc).map MvPolynomial.C))
    | succ n ih =>
      intro 𝔮 h𝔮
      by_cases hbot : 𝔮 = ⊥
      · exact idcase _ _ hbot
      obtain ⟨f, hf𝔮, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hbot
      obtain ⟨T, hT⟩ := s1 n f hf0
      set h := T f with hh
      haveI := h𝔮
      set 𝔮' : Ideal (MvPolynomial (Fin (n + 1)) k) :=
        𝔮.comap (T.symm : MvPolynomial (Fin (n + 1)) k →+* MvPolynomial (Fin (n + 1)) k) with h𝔮'def
      haveI h𝔮' : 𝔮'.IsPrime := Ideal.comap_isPrime _ _
      have hh𝔮' : h ∈ 𝔮' := by
        rw [h𝔮'def, Ideal.mem_comap]
        simpa [hh] using hf𝔮
      have hdeg : 0 < (MvPolynomial.finSuccEquiv k n h).natDegree := by
        by_contra h0
        have h0' : (MvPolynomial.finSuccEquiv k n h).natDegree = 0 := by omega
        have hunit : IsUnit (MvPolynomial.finSuccEquiv k n h) := by
          rw [Polynomial.eq_C_of_natDegree_eq_zero h0']
          have e : (MvPolynomial.finSuccEquiv k n h).coeff 0 =
              (MvPolynomial.finSuccEquiv k n h).leadingCoeff := by
            rw [Polynomial.leadingCoeff, h0']
          rw [e]; exact Polynomial.isUnit_C.mpr hT
        have hhu : IsUnit h := by
          have := hunit.map (MvPolynomial.finSuccEquiv k n).symm
          simpa using this
        exact h𝔮'.ne_top (Ideal.eq_top_of_isUnit_mem _ hh𝔮' hhu)
      set θ : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k :=
        MvPolynomial.aeval (Fin.cons h (fun j : Fin n => MvPolynomial.X j.succ) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k) with hθdef
      have hθ : θ.Finite := s2 n h hT hdeg
      set ι : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin (n + 1)) k := MvPolynomial.rename Fin.succ with hιdef
      have hιinj : Function.Injective ι := MvPolynomial.rename_injective _ (Fin.succ_injective _)
      set 𝔮'' : Ideal (MvPolynomial (Fin n) k) := 𝔮'.comap ι.toRingHom with h𝔮''def
      haveI h𝔮'' : 𝔮''.IsPrime := Ideal.comap_isPrime _ _
      obtain ⟨ψ', S', hψ', hc'⟩ := ih 𝔮'' h𝔮''
      set ρ' : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k :=
        MvPolynomial.aeval (fun i : Fin n => if i ∈ S' then (0 : MvPolynomial (Fin n) k) else MvPolynomial.X i) with hρ'def
      set Ψ : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k :=
        MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun j : Fin n => MvPolynomial.rename Fin.succ (ψ' (MvPolynomial.X j)))) with hΨdef
      have hΨ : Ψ.Finite := s3 n ψ' hψ'
      have hTs : (T.symm : MvPolynomial (Fin (n + 1)) k ≃ₐ[k] MvPolynomial (Fin (n + 1)) k).toAlgHom.Finite :=
        RingHom.Finite.of_surjective _ T.symm.surjective
      set S : Finset (Fin (n + 1)) := insert 0 (S'.map (Fin.succEmb n)) with hSdef
      set ρS : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k :=
        MvPolynomial.aeval (fun i : Fin (n + 1) => if i ∈ S then (0 : MvPolynomial (Fin (n + 1)) k) else MvPolynomial.X i) with hρSdef
      set A := θ.comp Ψ with hAdef
      set τ : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin n) k :=
        MvPolynomial.aeval (Fin.cons (0 : MvPolynomial (Fin n) k) (fun j : Fin n => MvPolynomial.X j) : Fin (n + 1) → MvPolynomial (Fin n) k) with hτdef
      set ε₀ : MvPolynomial (Fin (n + 1)) k →ₐ[k] MvPolynomial (Fin (n + 1)) k :=
        MvPolynomial.aeval (Fin.cons (0 : MvPolynomial (Fin (n + 1)) k) (fun j : Fin n => MvPolynomial.X j.succ) : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k) with hε₀def
      have ha : θ.comp ι = ι := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [θ, ι, MvPolynomial.rename_X]
      have hb : A.comp ι = ι.comp ψ' := by
        apply MvPolynomial.algHom_ext
        intro j
        show θ (Ψ (ι (MvPolynomial.X j))) = ι (ψ' (MvPolynomial.X j))
        have e : Ψ (ι (MvPolynomial.X j)) = ι (ψ' (MvPolynomial.X j)) := by
          simp [Ψ, ι, MvPolynomial.rename_X]
        rw [e]
        exact DFunLike.congr_fun ha _
      have hc : ε₀ = ι.comp τ := by
        apply MvPolynomial.algHom_ext
        intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp [ε₀, τ]
        · simp [ε₀, τ, ι, MvPolynomial.rename_X]
      have hdeq : (Ideal.Quotient.mkₐ k 𝔮').comp A = (Ideal.Quotient.mkₐ k 𝔮').comp (A.comp ε₀) := by
        apply MvPolynomial.algHom_ext
        intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · show Ideal.Quotient.mkₐ k 𝔮' (θ (Ψ (MvPolynomial.X 0))) =
            Ideal.Quotient.mkₐ k 𝔮' (θ (Ψ (ε₀ (MvPolynomial.X 0))))
          have e1 : θ (Ψ (MvPolynomial.X 0)) = h := by simp [θ, Ψ]
          have e2 : ε₀ (MvPolynomial.X 0) = 0 := by simp [ε₀]
          rw [e1, e2, map_zero, map_zero, Ideal.Quotient.mkₐ_eq_mk, map_zero, Ideal.Quotient.eq_zero_iff_mem]
          exact hh𝔮'
        · have e : ε₀ (MvPolynomial.X j.succ) = MvPolynomial.X j.succ := by simp [ε₀]
          simp only [AlgHom.comp_apply, e]
      have he : ι.comp (ρ'.comp τ) = ρS := by
        apply MvPolynomial.algHom_ext
        intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · have h0S : (0 : Fin (n + 1)) ∈ S := Finset.mem_insert_self _ _
          simp [ρS, τ, h0S]
        · have hjS : j.succ ∈ S ↔ j ∈ S' := by
            rw [hSdef, Finset.mem_insert, Finset.mem_map]
            constructor
            · rintro (h0 | ⟨a, ha, hae⟩)
              · exact absurd h0 (Fin.succ_ne_zero j)
              · have : a = j := Fin.succ_injective _ hae
                rw [← this]; exact ha
            · intro hj; exact Or.inr ⟨j, hj, rfl⟩
          by_cases hj : j ∈ S'
          · have hj' : j.succ ∈ S := hjS.mpr hj
            simp [ρS, τ, ρ', hj, hj']
          · have hj' : j.succ ∉ S := fun h => hj (hjS.mp h)
            simp [ρS, τ, ρ', ι, hj, hj', MvPolynomial.rename_X]
      have key : ∀ g, θ (Ψ g) ∈ 𝔮' ↔ ρS g = 0 := by
        intro g
        have hd : Ideal.Quotient.mk 𝔮' (A g) = Ideal.Quotient.mk 𝔮' (A (ε₀ g)) :=
          DFunLike.congr_fun hdeq g
        have hεg : ε₀ g = ι (τ g) := DFunLike.congr_fun hc g
        have hbg : A (ι (τ g)) = ι (ψ' (τ g)) := DFunLike.congr_fun hb (τ g)
        have e1 : θ (Ψ g) ∈ 𝔮' ↔ ι (ψ' (τ g)) ∈ 𝔮' := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem]
          rw [show θ (Ψ g) = A g from rfl, hd, hεg, hbg]
        rw [e1]
        change τ g ∈ 𝔮''.comap ψ'.toRingHom ↔ _
        rw [hc', RingHom.mem_ker, ← map_eq_zero_iff ι hιinj]
        change ι (ρ' (τ g)) = 0 ↔ _
        rw [show ι (ρ' (τ g)) = ρS g from DFunLike.congr_fun he g]
      refine ⟨(T.symm : MvPolynomial (Fin (n + 1)) k ≃ₐ[k] MvPolynomial (Fin (n + 1)) k).toAlgHom.comp A, S,
        AlgHom.Finite.comp hTs (AlgHom.Finite.comp hθ hΨ), ?_⟩
      ext g
      rw [Ideal.mem_comap, RingHom.mem_ker]
      exact key g

  have s5 : ∀ (k : Type u) [Field k] (n : ℕ) (p : MvPolynomial (Fin n) k), IsIntegral k p → ∃ c : k, p = MvPolynomial.C c := by
    intro k _ n p ⟨μ, hμm, hμ⟩
    by_contra hne
    have hδ : p.totalDegree ≠ 0 := by
      intro h0; exact hne ⟨_, MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0⟩
    have hp0 : p ≠ 0 := by rintro rfl; exact hδ (by simp)
    have hpow : ∀ i : ℕ, (p ^ i).totalDegree = i * p.totalDegree := by
      intro i
      induction i with
      | zero => simp
      | succ i ih =>
        rw [pow_succ, MvPolynomial.totalDegree_mul_of_isDomain (pow_ne_zero _ hp0) hp0, ih]; ring
    have hD : 0 < μ.natDegree := by
      by_contra h
      push Not at h
      have h0 : μ.natDegree = 0 := by omega
      have h1 : μ = 1 := by
        have hl := hμm
        rw [Polynomial.Monic, Polynomial.leadingCoeff, h0] at hl
        rw [Polynomial.eq_C_of_natDegree_eq_zero h0, hl, map_one]
      rw [h1] at hμ
      simp at hμ
    have hexp : Polynomial.eval₂ (algebraMap k _) p μ =
        p ^ μ.natDegree + ∑ i ∈ Finset.range μ.natDegree, μ.coeff i • p ^ i := by
      conv_lhs => rw [hμm.as_sum]
      simp [Polynomial.eval₂_add, Polynomial.eval₂_finsetSum, Algebra.smul_def]
    have htail : (∑ i ∈ Finset.range μ.natDegree, μ.coeff i • p ^ i).totalDegree <
        (p ^ μ.natDegree).totalDegree := by
      rw [hpow]
      refine lt_of_le_of_lt (MvPolynomial.totalDegree_finsetSum _ _) ?_
      rw [Finset.sup_lt_iff (by positivity)]
      intro i hi
      refine lt_of_le_of_lt (MvPolynomial.totalDegree_smul_le _ _) ?_
      rw [hpow]
      exact Nat.mul_lt_mul_of_pos_right (Finset.mem_range.mp hi) (Nat.pos_of_ne_zero hδ)
    have h2 := MvPolynomial.totalDegree_add_eq_left_of_totalDegree_lt htail
    rw [← hexp, hμ, hpow] at h2
    simp at h2
    rcases h2 with h2 | h2 <;> omega

  have s6 : ∀ (k : Type u) [Field k] (n : ℕ) (S : Finset (Fin n)) (𝔮 : Ideal (MvPolynomial (Fin n) k)) [𝔮.IsPrime], 𝔮 = RingHom.ker (MvPolynomial.aeval (fun i : Fin n => if i ∈ S then (0 : MvPolynomial (Fin n) k) else MvPolynomial.X i) : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k).toRingHom → ∀ x : 𝔮.ResidueField, IsIntegral k x → ∃ c : k, algebraMap k _ c = x := by
    intro k _ n S 𝔮 _ h𝔮 x hx
    set ρ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k :=
      MvPolynomial.aeval (fun i : Fin n => if i ∈ S then (0 : MvPolynomial (Fin n) k) else MvPolynomial.X i) with hρ
    let lft : MvPolynomial (Fin n) k ⧸ 𝔮 →+* MvPolynomial (Fin n) k :=
      Ideal.Quotient.lift 𝔮 ρ.toRingHom (fun a ha => by rw [h𝔮] at ha; exact (RingHom.mem_ker).mp ha)
    have hlft : Function.Injective lft := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro z hz
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [RingHom.mem_ker, Ideal.Quotient.lift_mk] at hz
      rw [Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem, h𝔮]
      exact hz
    let j : MvPolynomial (Fin n) k ⧸ 𝔮 →+* FractionRing (MvPolynomial (Fin n) k) :=
      (algebraMap (MvPolynomial (Fin n) k) (FractionRing (MvPolynomial (Fin n) k))).comp lft
    have hj : Function.Injective j :=
      (IsFractionRing.injective (MvPolynomial (Fin n) k) (FractionRing (MvPolynomial (Fin n) k))).comp hlft
    let L : 𝔮.ResidueField →+* FractionRing (MvPolynomial (Fin n) k) := IsFractionRing.lift hj
    have hLk : ∀ c : k, L (algebraMap k _ c) = algebraMap k _ c := by
      intro c
      rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin n) k ⧸ 𝔮) 𝔮.ResidueField]
      show IsFractionRing.lift hj _ = _
      rw [IsFractionRing.lift_algebraMap, ← Ideal.Quotient.mk_algebraMap]
      show algebraMap _ _ (ρ (algebraMap k _ c)) = _
      rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
    let Lk : 𝔮.ResidueField →ₐ[k] FractionRing (MvPolynomial (Fin n) k) :=
      { L with commutes' := hLk }
    have h1 : IsIntegral (MvPolynomial (Fin n) k) (Lk x) := (hx.map Lk).tower_top
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp h1
    have h2 : IsIntegral k y := by
      rw [← isIntegral_algHom_iff (IsScalarTower.toAlgHom k (MvPolynomial (Fin n) k)
        (FractionRing (MvPolynomial (Fin n) k))) (IsFractionRing.injective _ _)]
      rw [IsScalarTower.coe_toAlgHom', hy]
      exact hx.map Lk
    obtain ⟨c, hc⟩ := s5 k n y h2
    refine ⟨c, L.injective ?_⟩
    show L (algebraMap k _ c) = Lk x
    rw [hLk, ← hy, hc, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]

  have s7 : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B), Function.Injective f → f.IsIntegral → ringKrullDim A ≤ ringKrullDim B := by
    intro A B _ _ f hf hfi
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral A B := ⟨hfi⟩
    unfold ringKrullDim Order.krullDim
    refine iSup_le fun l => ?_
    obtain ⟨Q, -, hQp, hQo⟩ := Ideal.exists_ideal_over_prime_of_isIntegral l.head.asIdeal (⊥ : Ideal B) (by
      show Ideal.comap f ⊥ ≤ _
      rw [Ideal.comap_bot_of_injective _ hf]; exact bot_le)
    haveI := hQp
    haveI : Q.LiesOver l.head.asIdeal := ⟨hQo.symm⟩
    obtain ⟨L, hL, -⟩ := Ideal.exists_ltSeries_of_hasGoingUp l Q
    exact le_iSup_of_le L (by rw [hL])

  have s8 : ∀ (V : Type u) [CommRing V] [IsLocalRing V] (R : Type u) [CommRing R] [Algebra V R] (J : Ideal R) (𝔭 : Ideal R) [𝔭.IsPrime] (P : Ideal (R ⧸ J)) [P.IsPrime], P.comap (Ideal.Quotient.mk J) = 𝔭 → ∀ (e : ℕ) (ψ : MvPolynomial (Fin e) (V ⧸ IsLocalRing.maximalIdeal V) →+* R ⧸ J), (∀ v : V, ψ (MvPolynomial.C (Ideal.Quotient.mk (IsLocalRing.maximalIdeal V) v)) = Ideal.Quotient.mk J (algebraMap V R v)) → ψ.Finite → (∀ x : (P.comap ψ).ResidueField, IsIntegral (V ⧸ IsLocalRing.maximalIdeal V) x → ∃ c : V ⧸ IsLocalRing.maximalIdeal V, algebraMap (V ⧸ IsLocalRing.maximalIdeal V) _ c = x) → ∃ φ : MvPolynomial (Fin e) V →ₐ[V] R, RingHom.Finite ((Ideal.Quotient.mk J).comp φ.toRingHom) ∧ ∀ x : (𝔭.comap φ.toRingHom).ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x := by
    intro V _ _ R _ _ J 𝔭 _ P _ hP e ψ hψC hψfin hRF
    choose r hr using fun i : Fin e => Ideal.Quotient.mk_surjective (ψ (MvPolynomial.X i))
    let φ : MvPolynomial (Fin e) V →ₐ[V] R := MvPolynomial.aeval r
    let red : MvPolynomial (Fin e) V →+* MvPolynomial (Fin e) (V ⧸ IsLocalRing.maximalIdeal V) := MvPolynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal V))
    have hred : Function.Surjective red := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
    have hE : (Ideal.Quotient.mk J).comp φ.toRingHom = ψ.comp red := by
      apply MvPolynomial.ringHom_ext
      · intro v
        simp only [RingHom.comp_apply, red, MvPolynomial.map_C, hψC]
        show Ideal.Quotient.mk J (φ (MvPolynomial.C v)) = _
        rw [MvPolynomial.aeval_C]
      · intro i
        simp [φ, red, hr]
    refine ⟨φ, ?_, ?_⟩
    · rw [hE]; exact RingHom.Finite.comp hψfin (RingHom.Finite.of_surjective red hred)
    · intro x hx
      have hf : 𝔭.comap φ.toRingHom = (P.comap ψ).comap red := by
        rw [Ideal.comap_comap, ← hE, ← Ideal.comap_comap, hP]
      let ρ := Ideal.ResidueField.map (𝔭.comap φ.toRingHom) (P.comap ψ) red hf
      have hρ : Function.Bijective ρ :=
        (RingHom.surjectiveOnStalks_of_surjective hred).residueFieldMap_bijective _ _ hf
      have hcompat : ∀ a : V, ρ (algebraMap V _ a) =
          algebraMap (V ⧸ IsLocalRing.maximalIdeal V) (P.comap ψ).ResidueField (Ideal.Quotient.mk (IsLocalRing.maximalIdeal V) a) := by
        intro a
        rw [IsScalarTower.algebraMap_apply V (MvPolynomial (Fin e) V) (𝔭.comap φ.toRingHom).ResidueField,
          Ideal.ResidueField.map_algebraMap, IsScalarTower.algebraMap_apply (V ⧸ IsLocalRing.maximalIdeal V) (MvPolynomial (Fin e) (V ⧸ IsLocalRing.maximalIdeal V))]
        congr 1
        simp [red, MvPolynomial.algebraMap_eq]
      obtain ⟨q, hqm, hq⟩ := hx
      have hρx : IsIntegral (V ⧸ IsLocalRing.maximalIdeal V) (ρ x) := by
        refine ⟨q.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal V)), hqm.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        have e1 : (algebraMap (V ⧸ IsLocalRing.maximalIdeal V) (P.comap ψ).ResidueField).comp (Ideal.Quotient.mk (IsLocalRing.maximalIdeal V)) =
            ρ.comp (algebraMap V _) := by
          ext a; exact (hcompat a).symm
        rw [e1, ← Polynomial.hom_eval₂, hq, map_zero]
      obtain ⟨c, hc⟩ := hRF _ hρx
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
      exact ⟨a, hρ.1 (by rw [hcompat, hc])⟩

  intro V _ _ R _ _ hFT J hmJ 𝔭 h𝔭 hJ𝔭 d hdim
  classical
  letI : Field (V ⧸ IsLocalRing.maximalIdeal V) := Ideal.Quotient.field _
  have hle : IsLocalRing.maximalIdeal V ≤ J.comap (algebraMap V R) := Ideal.map_le_iff_le_comap.mp hmJ
  letI iKB : Algebra (V ⧸ IsLocalRing.maximalIdeal V) (R ⧸ J) :=
    Ideal.Quotient.algebraQuotientOfLEComap hle
  have hKB : ∀ v : V, algebraMap (V ⧸ IsLocalRing.maximalIdeal V) (R ⧸ J)
      (Ideal.Quotient.mk _ v) = Ideal.Quotient.mk J (algebraMap V R v) := fun v => rfl
  haveI : IsScalarTower V (V ⧸ IsLocalRing.maximalIdeal V) (R ⧸ J) :=
    IsScalarTower.of_algebraMap_eq (fun v => by
      rw [Ideal.Quotient.algebraMap_eq, hKB, Ideal.Quotient.mk_algebraMap])
  haveI : Algebra.FiniteType V (R ⧸ J) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ V J) (Ideal.Quotient.mkₐ_surjective V J)
  haveI : Algebra.FiniteType (V ⧸ IsLocalRing.maximalIdeal V) (R ⧸ J) :=
    Algebra.FiniteType.of_restrictScalars_finiteType V _ _
  haveI : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr (fun h => h𝔭.ne_top (eq_top_iff.mpr (h ▸ hJ𝔭)))
  obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg (V ⧸ IsLocalRing.maximalIdeal V) (R ⧸ J)

  have hsd : s ≤ d := by
    have h1 := s7 _ _ g.toRingHom hginj (RingHom.IsIntegral.of_finite hgfin)
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin] at h1
    have h2 := lt_of_le_of_lt h1 hdim
    have h3 : (s : ℕ∞) < ((d + 1 : ℕ) : ℕ∞) := by exact_mod_cast h2
    have h4 : s < d + 1 := by exact_mod_cast h3
    omega

  have hker : RingHom.ker (Ideal.Quotient.mk J) ≤ 𝔭 := by rw [Ideal.mk_ker]; exact hJ𝔭
  set Pb : Ideal (R ⧸ J) := 𝔭.map (Ideal.Quotient.mk J) with hPb
  haveI hPbp : Pb.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
  have hPbc : Pb.comap (Ideal.Quotient.mk J) = 𝔭 := by
    rw [hPb, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
    refine sup_eq_left.mpr ?_
    have : Ideal.comap (Ideal.Quotient.mk J) ⊥ = RingHom.ker (Ideal.Quotient.mk J) := rfl
    rw [this]; exact hker
  set 𝔮₀ := Pb.comap g.toRingHom with h𝔮₀
  haveI : 𝔮₀.IsPrime := Ideal.comap_isPrime _ _
  obtain ⟨ψ₀, S, hψ₀, hc⟩ := s4 (V ⧸ IsLocalRing.maximalIdeal V) (s1 _) (s23 _).1 (s23 _).2 s 𝔮₀ inferInstance
  set ψ : MvPolynomial (Fin s) (V ⧸ IsLocalRing.maximalIdeal V) →+* R ⧸ J := (g.comp ψ₀).toRingHom with hψ
  have hψfin : ψ.Finite := AlgHom.Finite.comp hgfin hψ₀
  have hψc : Pb.comap ψ = RingHom.ker (MvPolynomial.aeval (fun i : Fin s => if i ∈ S then (0 : MvPolynomial (Fin s) (V ⧸ IsLocalRing.maximalIdeal V)) else MvPolynomial.X i) : MvPolynomial (Fin s) (V ⧸ IsLocalRing.maximalIdeal V) →ₐ[V ⧸ IsLocalRing.maximalIdeal V] MvPolynomial (Fin s) (V ⧸ IsLocalRing.maximalIdeal V)).toRingHom := by
    rw [← hc, h𝔮₀, Ideal.comap_comap]; rfl
  have hψC : ∀ v : V, ψ (MvPolynomial.C (Ideal.Quotient.mk (IsLocalRing.maximalIdeal V) v)) = Ideal.Quotient.mk J (algebraMap V R v) := by
    intro v
    rw [← hKB, ← MvPolynomial.algebraMap_eq]
    exact (g.comp ψ₀).commutes _
  haveI : (Pb.comap ψ).IsPrime := Ideal.comap_isPrime _ _
  have hRF := s6 (V ⧸ IsLocalRing.maximalIdeal V) s S (Pb.comap ψ) hψc
  obtain ⟨φ, hφfin, hφRF⟩ := s8 V R J 𝔭 Pb hPbc s ψ hψC hψfin hRF
  exact ⟨s, φ, hsd, hφfin, hφRF⟩

theorem wcpa_pple_dvls_etale_localize : ∀ (V : Type u) [CommRing V] [IsLocalRing V] (C R : Type u) [CommRing C] [CommRing R] [Algebra V C] [Algebra C R] [Algebra V R] [IsScalarTower V C R], Algebra.FiniteType C R → ∀ (M : Type u) [AddCommGroup M] [Module R M], Module.Finite R M → ∀ (𝔭 : Ideal R) (_ : 𝔭.IsPrime) (q : Ideal (R ⧸ Module.annihilator R M)) (_ : q.IsPrime), q.comap (Ideal.Quotient.mk (Module.annihilator R M)) = 𝔭 → Algebra.QuasiFiniteAt C q → Ideal.map (algebraMap V C) (IsLocalRing.maximalIdeal V) ≤ 𝔭.comap (algebraMap C R) → (∀ x : (𝔭.comap (algebraMap C R)).ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x) → ∃ (C' : Type u) (_ : CommRing C') (_ : Algebra C C') (_ : Algebra V C') (_ : IsScalarTower V C C'), Algebra.Etale C C' ∧ ∃ (P : Ideal C') (_ : P.IsPrime), P.comap (algebraMap C C') = 𝔭.comap (algebraMap C R) ∧ ∀ c : C', c ∉ P → ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra R R₁) (_ : Algebra V R₁) (_ : IsScalarTower V R R₁) (_ : Algebra (Localization.Away c) R₁) (_ : IsScalarTower V (Localization.Away c) R₁), Algebra.Etale R R₁ ∧ Module.Finite (Localization.Away c) (TensorProduct R R₁ M) ∧ ∃ (𝔭₁ : Ideal R₁) (_ : 𝔭₁.IsPrime), 𝔭₁.comap (algebraMap R R₁) = 𝔭 ∧ (∀ b : R₁, ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R R₁ s * b - algebraMap R R₁ a ∈ 𝔭₁) ∧ Ideal.map (algebraMap V (Localization.Away c)) (IsLocalRing.maximalIdeal V) ≤ 𝔭₁.comap (algebraMap (Localization.Away c) R₁) ∧ RingHom.Finite ((Ideal.Quotient.mk (Module.annihilator R₁ (TensorProduct R R₁ M))).comp (algebraMap (Localization.Away c) R₁)) ∧ (∀ Q : Ideal R₁, Q.IsPrime → Module.annihilator R₁ (TensorProduct R R₁ M) ≤ Q → Q.comap (algebraMap (Localization.Away c) R₁) = 𝔭₁.comap (algebraMap (Localization.Away c) R₁) → Q = 𝔭₁) ∧ (∀ x : (𝔭₁.comap (algebraMap (Localization.Away c) R₁)).ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x) :=
by
  have t_s1 : ∀ (C C' : Type u) [CommRing C] [CommRing C'] [Algebra C C'] (p : Ideal C) [p.IsPrime] (P : Ideal C') [P.IsPrime] [P.LiesOver p] (hs : Function.Surjective (Ideal.ResidueField.mapₐ p P (Algebra.ofId C C') (P.over_def p))), ∀ x : C', ∃ a s : C, s ∉ p ∧ algebraMap C C' s * x - algebraMap C C' a ∈ P := by
    intro C C' _ _ _ p _ P _ _ hs
    intro x
    obtain ⟨y, hy⟩ := hs (algebraMap C' P.ResidueField x)
    obtain ⟨a', b', hb', rfl⟩ := IsFractionRing.div_surjective (A := C ⧸ p) y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a'
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective b'
    have hs0 : s ∉ p := by
      intro h; apply nonZeroDivisors.ne_zero hb'; exact Ideal.Quotient.eq_zero_iff_mem.mpr h
    refine ⟨a, s, hs0, ?_⟩
    have key : ∀ t : C, (Ideal.ResidueField.mapₐ p P (Algebra.ofId C C') (P.over_def p)) (algebraMap (C ⧸ p) p.ResidueField (Ideal.Quotient.mk p t)) = algebraMap C' P.ResidueField (algebraMap C C' t) := by
      intro t
      rw [show Ideal.Quotient.mk p t = algebraMap C (C ⧸ p) t from rfl, ← IsScalarTower.algebraMap_apply]
      exact (AlgHom.commutes _ t).trans (IsScalarTower.algebraMap_apply C C' P.ResidueField t)
    rw [map_div₀, key, key] at hy
    have hsP : algebraMap C' P.ResidueField (algebraMap C C' s) ≠ 0 := by
      rw [Ne, Ideal.algebraMap_residueField_eq_zero]; intro h; apply hs0; rw [Ideal.over_def P p]; exact h
    rw [← Ideal.algebraMap_residueField_eq_zero, map_sub, map_mul, ← hy]
    field_simp
    ring
  have t_s2 : ∀ (C R C' : Type u) [CommRing C] [CommRing R] [CommRing C'] [Algebra C R] [Algebra C C'] (p : Ideal C) (P : Ideal C') (hcong : ∀ x : C', ∃ a s : C, s ∉ p ∧ algebraMap C C' s * x - algebraMap C C' a ∈ P) (𝔭 : Ideal R) [h𝔭p : 𝔭.IsPrime] (h𝔭 : 𝔭.comap (algebraMap C R) = p) (𝔔 : Ideal (TensorProduct C R C')) (h𝔔 : ∀ y ∈ P, (1 : R) ⊗ₜ[C] y ∈ 𝔔), ∀ x : TensorProduct C R C', ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R (TensorProduct C R C') s * x - algebraMap R (TensorProduct C R C') a ∈ 𝔔 := by
    intro C R C' _ _ _ _ _ p P hcong 𝔭 h𝔭p h𝔭 𝔔 h𝔔
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨0, 1, (Ideal.ne_top_iff_one _).mp h𝔭p.ne_top, by simp⟩
    | tmul r y =>
      obtain ⟨a₀, s₀, hs₀, hz⟩ := hcong y
      refine ⟨r * algebraMap C R a₀, algebraMap C R s₀, fun h => hs₀ (h𝔭 ▸ h), ?_⟩
      have e : algebraMap R (TensorProduct C R C') (algebraMap C R s₀) * (r ⊗ₜ[C] y) - algebraMap R (TensorProduct C R C') (r * algebraMap C R a₀) = (r ⊗ₜ[C] (1:C')) * ((1:R) ⊗ₜ[C] (algebraMap C C' s₀ * y - algebraMap C C' a₀)) := by
        have h1 : (algebraMap C R s₀ * r) ⊗ₜ[C] y = r ⊗ₜ[C] (algebraMap C C' s₀ * y) := by
          rw [← Algebra.smul_def, ← Algebra.smul_def, TensorProduct.smul_tmul]
        have h2 : (r * algebraMap C R a₀) ⊗ₜ[C] (1:C') = r ⊗ₜ[C] (algebraMap C C' a₀) := by
          rw [mul_comm, ← Algebra.smul_def, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        simp only [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        rw [h1, h2, TensorProduct.tmul_sub]
      rw [e]; exact Ideal.mul_mem_left _ _ (h𝔔 _ hz)
    | add x₁ x₂ h₁ h₂ =>
      obtain ⟨a₁, s₁, hs₁, e₁⟩ := h₁
      obtain ⟨a₂, s₂, hs₂, e₂⟩ := h₂
      refine ⟨s₂ * a₁ + s₁ * a₂, s₁ * s₂, fun h => (h𝔭p.mem_or_mem h).elim hs₁ hs₂, ?_⟩
      have e : algebraMap R (TensorProduct C R C') (s₁ * s₂) * (x₁ + x₂) - algebraMap R (TensorProduct C R C') (s₂ * a₁ + s₁ * a₂) = algebraMap R (TensorProduct C R C') s₂ * (algebraMap R (TensorProduct C R C') s₁ * x₁ - algebraMap R (TensorProduct C R C') a₁) + algebraMap R (TensorProduct C R C') s₁ * (algebraMap R (TensorProduct C R C') s₂ * x₂ - algebraMap R (TensorProduct C R C') a₂) := by
        simp only [map_mul, map_add]; ring
      rw [e]; exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ e₁) (Ideal.mul_mem_left _ _ e₂)
  have t_s3 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (𝔭 : Ideal R) (𝔔 : Ideal T) [h𝔔p : 𝔔.IsPrime] (h𝔔 : 𝔔.comap (algebraMap R T) = 𝔭) (hcong : ∀ x : T, ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R T s * x - algebraMap R T a ∈ 𝔔) (g : T) (hg : g ∉ 𝔔) (𝔭₁ : Ideal (Localization.Away g)) (h𝔭₁ : 𝔭₁.comap (algebraMap T (Localization.Away g)) = 𝔔), ∀ b : Localization.Away g, ∃ a s : R, s ∉ 𝔭 ∧ algebraMap R (Localization.Away g) s * b - algebraMap R (Localization.Away g) a ∈ 𝔭₁ := by
    intro R T _ _ _ 𝔭 𝔔 h𝔔p h𝔔 hcong g hg 𝔭₁ h𝔭₁
    intro b
    obtain ⟨n, x, hb⟩ := IsLocalization.Away.surj g b
    obtain ⟨a, t, ht, h1⟩ := hcong x
    obtain ⟨a', t', ht', h2⟩ := hcong (g ^ n)
    have hp : 𝔭.IsPrime := h𝔔 ▸ Ideal.comap_isPrime _ _
    have ha' : a' ∉ 𝔭 := by
      intro h
      rw [← h𝔔] at h ht'
      have h3 : algebraMap R T t' * g ^ n ∈ 𝔔 := by
        have := Ideal.add_mem _ h2 h
        simpa using this
      rcases h𝔔p.mem_or_mem h3 with h4 | h4
      · exact ht' h4
      · exact hg (h𝔔p.mem_of_pow_mem n h4)
    refine ⟨t' * a, t * a', fun h => (hp.mem_or_mem h).elim ht ha', ?_⟩
    have key : algebraMap R (Localization.Away g) (t * a') * b - algebraMap R (Localization.Away g) (t' * a) = algebraMap T (Localization.Away g) (algebraMap R T t) * algebraMap T (Localization.Away g) (- (algebraMap R T t' * g ^ n - algebraMap R T a')) * b + algebraMap T (Localization.Away g) (algebraMap R T t') * algebraMap T (Localization.Away g) (algebraMap R T t * x - algebraMap R T a) := by
      simp only [IsScalarTower.algebraMap_apply R T (Localization.Away g), map_mul, map_sub, map_neg, map_pow]
      rw [← hb]; ring
    rw [key]
    have mem : ∀ y ∈ 𝔔, algebraMap T (Localization.Away g) y ∈ 𝔭₁ := fun y hy => by rw [← h𝔭₁] at hy; exact hy
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (mem _ (Submodule.neg_mem _ h2)))) (Ideal.mul_mem_left _ _ (mem _ h1))
  have t_s4 : ∀ (V C D : Type u) [CommRing V] [CommRing C] [CommRing D] [Algebra V C] [Algebra C D] [Algebra V D] [IsScalarTower V C D] (p : Ideal C) [p.IsPrime] (Q : Ideal D) [Q.IsPrime] (hQp : Q.comap (algebraMap C D) = p) (hcong : ∀ y : D, ∃ a s : C, s ∉ p ∧ algebraMap C D s * y - algebraMap C D a ∈ Q) (hIV : ∀ x : p.ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x), ∀ x : Q.ResidueField, IsIntegral V x → ∃ a : V, algebraMap V _ a = x := by
    intro V C D _ _ _ _ _ _ _ p _ Q _ hQp hcong hIV
    let f := Ideal.ResidueField.mapₐ p Q (IsScalarTower.toAlgHom V C D) hQp.symm
    have hf : ∀ t : C, f (algebraMap C p.ResidueField t) = algebraMap D Q.ResidueField (algebraMap C D t) := fun t => by
      simp only [f, Ideal.ResidueField.mapₐ_apply]; exact Ideal.ResidueField.map_algebraMap _ _ _ _ t
    have hinj : Function.Injective f := f.toRingHom.injective
    have ha : ∀ y : D, algebraMap D Q.ResidueField y ∈ f.toRingHom.fieldRange := by
      intro y
      obtain ⟨a, s, hs, hy⟩ := hcong y
      have hs0 : algebraMap D Q.ResidueField (algebraMap C D s) ≠ 0 := by
        rw [Ne, Ideal.algebraMap_residueField_eq_zero]; intro h; apply hs; rw [← hQp]; exact h
      have e : algebraMap D Q.ResidueField y = f (algebraMap C p.ResidueField a) / f (algebraMap C p.ResidueField s) := by
        rw [hf, hf, eq_div_iff hs0]
        rw [← Ideal.algebraMap_residueField_eq_zero, map_sub, map_mul, sub_eq_zero] at hy
        rw [mul_comm]; exact hy
      rw [e]
      exact Subfield.div_mem _ ⟨_, rfl⟩ ⟨_, rfl⟩
    have hsurj : Function.Surjective f := by
      intro x
      obtain ⟨a', b', _, rfl⟩ := IsFractionRing.div_surjective (A := D ⧸ Q) x
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a'
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b'
      have e : ∀ y : D, algebraMap (D ⧸ Q) Q.ResidueField (Ideal.Quotient.mk Q y) = algebraMap D Q.ResidueField y := fun y => by
        rw [show Ideal.Quotient.mk Q y = algebraMap D (D ⧸ Q) y from rfl, ← IsScalarTower.algebraMap_apply]
      rw [e, e]
      exact Subfield.div_mem _ (ha a) (ha b)
    intro x hx
    obtain ⟨z, rfl⟩ := hsurj x
    have hz : IsIntegral V z := (isIntegral_algHom_iff f hinj).mp hx
    obtain ⟨a, ha⟩ := hIV z hz
    exact ⟨a, by rw [← ha, AlgHom.commutes]⟩
  have t_s5 : ∀ (C' W D : Type u) [CommRing C'] [CommRing W] [Algebra C' W] [CommRing D] (c : C') (ε : W) (hfin : Module.Finite C' (Localization.Away ε)) (θ : W →+* D) (ψ : Localization.Away c →+* D) (hθψ : ∀ x : C', θ (algebraMap C' W x) = ψ (algebraMap C' (Localization.Away c) x)) (hu : IsUnit (θ ε)) (hd : ∀ d : D, ∃ (w : W) (n : ℕ), θ (algebraMap C' W c) ^ n * d = θ w), ψ.Finite := by
    intro C' W D _ _ _ _ c ε hfin θ ψ hθψ hu hd
    classical
    letI := ψ.toAlgebra
    have hθA : ∀ w, (IsLocalization.Away.lift ε hu : Localization.Away ε →+* D) (algebraMap W (Localization.Away ε) w) = θ w := IsLocalization.Away.lift_eq ε hu
    obtain ⟨s, hs⟩ := hfin.1
    show Module.Finite (Localization.Away c) D
    refine ⟨⟨s.image (IsLocalization.Away.lift ε hu : Localization.Away ε →+* D), ?_⟩⟩
    rw [eq_top_iff]
    intro d _
    have SP : ∀ a ∈ Submodule.span C' (s : Set (Localization.Away ε)), (IsLocalization.Away.lift ε hu : Localization.Away ε →+* D) a ∈ Submodule.span (Localization.Away c) ((s.image (IsLocalization.Away.lift ε hu : Localization.Away ε →+* D) : Finset D) : Set D) := by
      intro a ha
      induction ha using Submodule.span_induction with
      | mem x hx => exact Submodule.subset_span (by simp only [Finset.coe_image]; exact ⟨x, hx, rfl⟩)
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
      | smul r x _ hx =>
        rw [Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply C' W (Localization.Away ε), hθA, hθψ]
        exact Submodule.smul_mem _ (algebraMap C' (Localization.Away c) r) hx
    obtain ⟨w, n, hw⟩ := hd d
    have hmem := SP (algebraMap W (Localization.Away ε) w) (hs ▸ Submodule.mem_top)
    rw [hθA, ← hw] at hmem
    obtain ⟨v, e⟩ := ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away c) c).pow n).exists_left_inv
    have hu' : ψ v * θ (algebraMap C' W c) ^ n = 1 := by
      rw [hθψ, ← map_pow, ← map_mul, e, map_one]
    have hdd : d = v • (θ (algebraMap C' W c) ^ n * d) := by
      show d = ψ _ * _
      rw [← mul_assoc, hu', one_mul]
    rw [hdd]; exact Submodule.smul_mem _ _ hmem
  have t_s6 : ∀ (A B N : Type u) [CommRing A] [CommRing B] [Algebra A B] [AddCommGroup N] [Module B N] [Module A N] [IsScalarTower A B N] (hN : Module.Finite B N) (hf : RingHom.Finite ((Ideal.Quotient.mk (Module.annihilator B N)).comp (algebraMap A B))), Module.Finite A N := by
    intro A B N _ _ _ _ _ _ _ hN hf
    rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_eq, RingHom.finite_algebraMap] at hf
    letI : Module (B ⧸ Module.annihilator B N) N := Module.quotientAnnihilator
    haveI : IsScalarTower B (B ⧸ Module.annihilator B N) N := ⟨fun b y n => by
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      show (Ideal.Quotient.mk _ (b • y)) • n = b • (Ideal.Quotient.mk _ y • n)
      exact smul_assoc b y n⟩
    haveI : IsScalarTower A (B ⧸ Module.annihilator B N) N := ⟨fun a y n => by
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      show (Ideal.Quotient.mk _ (a • y)) • n = a • (Ideal.Quotient.mk _ y • n)
      exact smul_assoc a y n⟩
    haveI : Module.Finite (B ⧸ Module.annihilator B N) N := Module.Finite.of_restrictScalars_finite B _ N
    exact Module.Finite.trans (B ⧸ Module.annihilator B N) N
  have t_s8 : ∀ (C' W T R₁ : Type u) [CommRing C'] [CommRing W] [CommRing T] [CommRing R₁] [Algebra C' W] [Algebra T R₁] (g : T) [IsLocalization.Away g R₁] (π : T →+* W) (I₁ : Ideal R₁) (Φ : W →+* R₁ ⧸ I₁) (hΦ : ∀ x : T, Φ (π x) = Ideal.Quotient.mk I₁ (algebraMap T R₁ x)) (ε : W) (hε : IsUnit (Φ ε)) (P : Ideal C') (𝔓 : Ideal W) (huniq : ∀ 𝔓'' : Ideal W, 𝔓''.IsPrime → 𝔓''.LiesOver P → ε ∉ 𝔓'' → 𝔓'' = 𝔓) (κ : C' →+* R₁) (hκ : ∀ x : C', Φ (algebraMap C' W x) = Ideal.Quotient.mk I₁ (κ x)) (𝔭₁ : Ideal R₁) (h𝔭₁ : 𝔭₁.IsPrime) (h𝔭₁T : 𝔭₁.comap (algebraMap T R₁) = 𝔓.comap π) (Q : Ideal R₁) (hQ : Q.IsPrime) (hIQ : I₁ ≤ Q) (hQP : Q.comap κ = P), Q = 𝔭₁ := by
    intro C' W T R₁ _ _ _ _ _ _ g _ π I₁ Φ hΦ ε hε P 𝔓 huniq κ hκ 𝔭₁ h𝔭₁ h𝔭₁T Q hQ hIQ hQP
    have hmem : ∀ x : R₁, Ideal.Quotient.mk I₁ x ∈ Q.map (Ideal.Quotient.mk I₁) ↔ x ∈ Q := fun x => Ideal.mem_quotient_iff_mem hIQ
    haveI hQb : (Q.map (Ideal.Quotient.mk I₁)).IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIQ)
    have hQW : (Q.map (Ideal.Quotient.mk I₁)).comap Φ = 𝔓 := by
