theorem wcpa_dj_lr1k_ebc_cgr_icc_coord : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)), Flat uX → IsProper uX → ∀ (x : ↥X) (w : ↥(Limits.pullback uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))), Limits.pullback.fst uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = x → wcpaDjLkSmAt W uX w → ∀ (σ : Spec (.of ↥W) ⟶ X), σ ≫ uX = 𝟙 _ → σ (IsLocalRing.closedPoint ↥W) = x → ∃ (O : X.affineOpens) (tO : Γ(X, O.1)) (e : ⊤ ≤ σ ⁻¹ᵁ O.1), x ∈ O.1 ∧ RingHom.ker (σ.appLE O.1 ⊤ e).hom = Ideal.span {tO} :=
by
  intro Ω _ W X uX hflat hprop x w hw hSm σ hσu hσx
  haveI := hprop
  have hlfp : LocallyOfFinitePresentation uX :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) X uX hflat inferInstance
  obtain ⟨W', hW', hsm⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) X uX
    (IsLocalRing.ResidueField ↥W)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w hflat hlfp hSm
  rw [hw, ← hσx] at hW'
  obtain ⟨O', m, σO, _, _, hO', _, _, hσO, _, _, _, hkerO, _⟩ :=
    wcpa_dj_lr1k_ebd_two_section_chart Ω W X uX σ σ inferInstance hσu hσu rfl ⟨W', hW', hsm⟩
  subst hσO
  have hpre : ∀ p, (σO ≫ O'.ι) p ∈ O' := by
    intro p
    rw [Scheme.Hom.comp_apply]
    have h1 : O'.ι (σO p) ∈ Set.range O'.ι := ⟨_, rfl⟩
    rwa [Scheme.Opens.range_ι] at h1
  have e : (⊤ : (Spec (.of ↥W)).Opens) ≤ (σO ≫ O'.ι) ⁻¹ᵁ O' :=
    fun p _ => (Scheme.Hom.mem_preimage _).mpr (hpre p)
  have h : (⊤ : O'.toScheme.Opens) ≤ O'.ι ⁻¹ᵁ O' := (Scheme.Opens.ι_preimage_self O').ge
  set ρ := (O'.ι.appLE O' ⊤ h).hom with hρdef
  have hfac : ((σO ≫ O'.ι).appLE O' ⊤ e).hom = σO.appTop.hom.comp ρ := by
    have h1 := Scheme.Hom.appLE_comp_appLE σO O'.ι O' ⊤ ⊤ h le_top
    have h2 : σO.appLE ⊤ ⊤ le_top = σO.appTop := Scheme.Hom.appLE_eq_app σO
    rw [h2] at h1
    rw [← h1, CommRingCat.hom_comp]
  have hρbij : Function.Bijective ρ := by
    rw [hρdef, Scheme.Opens.ι_appLE]
    have hIso : IsIso (homOfLE ((Scheme.Opens.ι_image_top O').le) :
        (O'.ι ''ᵁ ⊤ : X.Opens) ⟶ O').op := by
      refine ⟨⟨(homOfLE (Scheme.Opens.ι_image_top O').ge).op, ?_, ?_⟩⟩
      · exact Subsingleton.elim _ _
      · exact Subsingleton.elim _ _
    exact ConcreteCategory.bijective_of_isIso (X.presheaf.map _)
  set E := RingEquiv.ofBijective ρ hρbij with hE
  set μ := m.appTop.hom
    ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) with hμ
  have hEρ : ∀ a, E a = ρ a := fun a => rfl
  refine ⟨⟨O', hO'⟩, E.symm μ, e, ?_, ?_⟩
  · rw [← hσx]; exact hpre _
  · show RingHom.ker ((σO ≫ O'.ι).appLE O' ⊤ e).hom = Ideal.span {E.symm μ}
    rw [hfac]
    ext f
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.mem_span_singleton']
    constructor
    · intro hf
      have hm : ρ f ∈ RingHom.ker σO.appTop.hom := hf
      rw [hkerO, Ideal.mem_span_singleton'] at hm
      obtain ⟨k, hk⟩ := hm
      refine ⟨E.symm k, ?_⟩
      apply E.injective
      rw [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, hEρ, hk]
    · rintro ⟨k, rfl⟩
      have hm : ρ (k * E.symm μ) ∈ RingHom.ker σO.appTop.hom := by
        rw [hkerO, Ideal.mem_span_singleton']
        refine ⟨ρ k, ?_⟩
        rw [map_mul, ← hEρ (E.symm μ), RingEquiv.apply_symm_apply]
      exact hm

theorem wcpa_dj_lr1k_ebc_cgr_icc_two_charts : ∀ (X X₁ : Scheme.{u}) (I : X.IdealSheafData) (r₁ : X₁ ⟶ X), wcCsdIsBlowup I r₁ → ∀ (O : X.affineOpens) (g₀ g₁ : Γ(X, O.1)), I.ideal O = Ideal.span {g₀, g₁} → ∃ (U₀ U₁ : X₁.affineOpens) (e₀ : U₀.1 ≤ r₁ ⁻¹ᵁ O.1) (e₁ : U₁.1 ≤ r₁ ⁻¹ᵁ O.1) (β : Γ(X₁, U₀.1)) (S : Γ(X₁, U₁.1)), (∀ z : ↥X₁, r₁ z ∈ O.1 → z ∈ U₀.1 ∨ z ∈ U₁.1) ∧ (r₁.appLE O.1 U₀.1 e₀).hom g₁ = β * (r₁.appLE O.1 U₀.1 e₀).hom g₀ ∧ (r₁.appLE O.1 U₀.1 e₀).hom g₀ ∈ nonZeroDivisors Γ(X₁, U₀.1) ∧ (r₁.appLE O.1 U₁.1 e₁).hom g₀ = S * (r₁.appLE O.1 U₁.1 e₁).hom g₁ ∧ (∀ f : Γ(X₁, U₁.1), f ∈ Subring.closure (Set.range (r₁.appLE O.1 U₁.1 e₁).hom ∪ {S})) ∧ X₁.basicOpen S ≤ U₀.1 :=
by
  intro X X₁ I r₁ hbl O g₀ g₁ hI
  classical

  have alg : ∀ {A A' B C : Type u} [CommRing A] [CommRing A'] [CommRing B] [CommRing C]
      (ψ : C →+* B) (χ : B →+* C), (∀ c, χ (ψ c) = c) → (∀ b, ψ (χ b) = b) →
      ∀ (φ : A →+* C) (φ' : A' →+* B) (ρ : A →+* A'), Function.Surjective ρ →
      (∀ a, ψ (φ a) = φ' (ρ a)) → ∀ (gl gm : A) (tl tm : B) (T : Set B),
      φ' (ρ gm) = tm * φ' (ρ gl) → φ' (ρ gl) = tl * φ' (ρ gl) → φ' (ρ gl) ∈ nonZeroDivisors B →
      (∀ y ∈ T, y = tl ∨ y = tm) → (∀ s : B, s ∈ Subring.closure (Set.range φ' ∪ T)) →
      φ gm = χ tm * φ gl ∧ φ gl ∈ nonZeroDivisors C ∧
        ∀ f : C, f ∈ Subring.closure (Set.range φ ∪ {χ tm}) := by
    intro A A' B C _ _ _ _ ψ χ hχψ hψχ φ φ' ρ hρ hcomm gl gm tl tm T hrel hself hnzd hT hgen
    have hψinj : Function.Injective ψ := fun x y h => by rw [← hχψ x, ← hχψ y, h]
    refine ⟨?_, ?_, ?_⟩
    · apply hψinj
      rw [map_mul, hψχ, hcomm, hcomm, hrel]
    · rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      apply hψinj
      rw [map_zero]
      have h1 : ψ x * φ' (ρ gl) = 0 := by rw [← hcomm, ← map_mul, hx, map_zero]
      exact (mem_nonZeroDivisors_iff_right.mp hnzd) _ h1
    · have htl : tl = 1 := by
        have h0 : (tl - 1) * φ' (ρ gl) = 0 := by rw [sub_mul, one_mul, ← hself, sub_self]
        exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff_right.mp hnzd) _ h0)
      have hle : Subring.closure (Set.range φ' ∪ T) ≤
          (Subring.closure (Set.range φ ∪ {χ tm})).comap χ := by
        rw [Subring.closure_le]
        rintro y (⟨a', rfl⟩ | hy)
        · obtain ⟨a, rfl⟩ := hρ a'
          rw [SetLike.mem_coe, Subring.mem_comap, ← hcomm, hχψ]
          exact Subring.subset_closure (Or.inl ⟨a, rfl⟩)
        · rcases hT y hy with h | h
          · rw [SetLike.mem_coe, Subring.mem_comap, h, htl, map_one]
            exact Subring.one_mem _
          · rw [SetLike.mem_coe, Subring.mem_comap, h]
            exact Subring.subset_closure (Or.inr rfl)
      intro f
      have h2 := hle (hgen (ψ f))
      rw [Subring.mem_comap, hχψ] at h2
      exact h2
