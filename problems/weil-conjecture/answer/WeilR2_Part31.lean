      refine ⟨h, ⟨RingHom.ext fun b => ?_, hh2⟩, ?_⟩
      · have := RingHom.congr_fun hh1 (φ.symm b)
        simpa using this
      · rintro h' ⟨h1', h2'⟩
        apply huniq
        refine ⟨RingHom.ext fun t => ?_, h2'⟩
        have := RingHom.congr_fun h1' (φ t)
        simpa using this

