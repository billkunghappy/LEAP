  obtain ⟨hJ0FG, hinv0⟩ := wcpa_dj_mscc_model_centre Ω W b hb0
  obtain ⟨M', r₀, hr₀⟩ := wcpa_dj_ms_blowup_exists_ft _ _ hJ0FG
  obtain ⟨-, hP2⟩ := wcpa_dj_mscc_model_blowup Ω W hW b hb0 hbm M' r₀ hr₀

  have hb1 := wcpa_dj_nc_blowup_flat_basechange X X₁ U.toScheme _ r₁ U.ι inferInstance hbl
  have hb2 := wcpa_dj_nc_blowup_flat_basechange _ M' U.toScheme _ r₀ m inferInstance hr₀
