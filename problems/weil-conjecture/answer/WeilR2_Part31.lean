          wcEbBdResDeg K' V := by
    intro V h
    subst h
    exact ⟨wcEbBdResAlg K' V, fun x hx hy => rfl, rfl⟩



  have s4poly : ∀ (k : Type u) [Field k] (f : Fin r → ℕ), f i₀ = 1 →
      (∏ i : Fin r, (Polynomial.X - Polynomial.C (if i = i₀ then (0 : k) else 1)) ^ f i).coeff 1
        ≠ 0 := by
    intro k _ f h1
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i₀)]
    rw [if_pos rfl, h1, pow_one, Polynomial.C_0, sub_zero]
    show (Polynomial.X * _).coeff (0 + 1) ≠ 0
    rw [Polynomial.coeff_X_mul, Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_prod]
    rw [Finset.prod_ne_zero_iff]
    intro i hi
    have hne := (Finset.mem_erase.mp hi).1
    rw [Polynomial.eval_pow]
    apply pow_ne_zero
    simp [hne]
  have s4 : ∀ (k : Type u) [Field k] (n : ℕ) (E : Fin r → Type u) [∀ i, AddCommGroup (E i)]
      [∀ i, Module k (E i)] [∀ i, FiniteDimensional k (E i)] (M : Matrix (Fin n) (Fin n) k)
      (w : Fin n → ((i : Fin r) → E i)), Module.finrank k (E i₀) = 1 →
      ∑ i, Module.finrank k (E i) = n →
      (∀ y : (i : Fin r) → E i, ∃ c : Fin n → k, ∑ l, c l • w l = y) →
      (∀ (j : Fin n) (i : Fin r), (if i = i₀ then (0 : k) else 1) • w j i = ∑ l, M l j • w l i) →
      M.charpoly.coeff 1 ≠ 0 := by
    intro k _ n E _ _ _ M w h1 hsum hspan hrel
    let D : ((i : Fin r) → E i) →ₗ[k] ((i : Fin r) → E i) :=
      LinearMap.pi (fun i => (if i = i₀ then (0 : k) else 1) • LinearMap.proj i)
    have hD : ∀ y i, D y i = (if i = i₀ then (0 : k) else 1) • y i := fun y i => rfl
    let T : (Fin n → k) →ₗ[k] ((i : Fin r) → E i) :=
      { toFun := fun c => ∑ l, c l • w l
        map_add' := fun c d => by simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun a c => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum, RingHom.id_apply] }
    have hT : ∀ c, T c = ∑ l, c l • w l := fun c => rfl
    have hcomm : ∀ c, T (Matrix.toLin' M c) = D (T c) := by
      intro c
      funext i
      rw [hD, hT, hT, Matrix.toLin'_apply]
      simp only [Finset.sum_apply, Pi.smul_apply, Matrix.mulVec, dotProduct]
      rw [Finset.smul_sum]
      simp_rw [Finset.sum_smul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [smul_comm, hrel j i, Finset.smul_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [mul_comm, mul_smul]
    have hfin : Module.finrank k (Fin n → k) = Module.finrank k ((i : Fin r) → E i) := by
      rw [Module.finrank_fin_fun, Module.finrank_pi_fintype, hsum]
    have hsurj : Function.Surjective T := fun y => by
      obtain ⟨c, hc⟩ := hspan y
      exact ⟨c, hc⟩
    have hinj := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin).mpr hsurj
    let e := LinearEquiv.ofBijective T ⟨hinj, hsurj⟩
    have hconj : e.conj (Matrix.toLin' M) = D := by
      apply LinearMap.ext
      intro y
      rw [LinearEquiv.conj_apply_apply]
      have h2 : e (Matrix.toLin' M (e.symm y)) = T (Matrix.toLin' M (e.symm y)) := rfl
      rw [h2, hcomm]
      congr 1
      exact e.apply_symm_apply y
    have hcp : M.charpoly = D.charpoly := by
      rw [← Matrix.charpoly_toLin', ← hconj, LinearEquiv.charpoly_conj]
    let b := Pi.basis (fun i => Module.finBasis k (E i))
    have hDq : ∀ q, D (b q) = (if q.1 = i₀ then (0 : k) else 1) • b q := by
      intro q
      rcases q with ⟨a, j⟩
      have hb : b ⟨a, j⟩ = Pi.single a (Module.finBasis k (E a) j) := Pi.basis_apply _ _
      rw [hb]
      funext i
      rw [hD, Pi.smul_apply]
      by_cases h : i = a
      · subst h
        simp only [Pi.single_eq_same]
      · simp only [Pi.single_eq_of_ne h, smul_zero]
    have hDb : D = Matrix.toLin b b (Matrix.diagonal
        (fun p : (Σ i, Fin (Module.finrank k (E i))) => if p.1 = i₀ then (0 : k) else 1)) := by
      apply b.ext
      intro q
      rw [Matrix.toLin_self, Finset.sum_eq_single q, Matrix.diagonal_apply_eq, hDq]
      · intro p _ hp
        rw [Matrix.diagonal_apply_ne _ hp, zero_smul]
      · intro h; exact absurd (Finset.mem_univ q) h
    rw [hcp, ← LinearMap.charpoly_toMatrix D b, hDb, LinearMap.toMatrix_toLin,
      Matrix.charpoly_diagonal, Fintype.prod_sigma]
    have hc : ∀ i : Fin r, (∏ _j : Fin (Module.finrank k (E i)),
        (Polynomial.X - Polynomial.C (if i = i₀ then (0 : k) else 1))) =
        (Polynomial.X - Polynomial.C (if i = i₀ then (0 : k) else 1)) ^ Module.finrank k (E i) := by
      intro i
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    rw [Finset.prod_congr rfl (fun i _ => hc i)]
    exact s4poly k (fun i => Module.finrank k (E i)) h1



  have s5 : ∀ (β : Module.Basis (Fin (Module.finrank K' L)) ↥O.toSubring
      ↥(integralClosure ↥O.toSubring L)) (z : ↥(integralClosure ↥O.toSubring L)),
      (minpoly K' (z : L)).natDegree = Module.finrank K' L →
      (Algebra.leftMulMatrix β z).charpoly.map (algebraMap ↥O.toSubring K') =
        minpoly K' (z : L) := by
    intro β z hdeg
    set χ := (Algebra.leftMulMatrix β z).charpoly with hχ
    have h1 : Polynomial.aeval z χ = 0 := by
      apply Algebra.leftMulMatrix_injective β
      rw [← Polynomial.aeval_algHom_apply, Matrix.aeval_self_charpoly, map_zero]
    have h2 : Polynomial.aeval (z : L) χ = 0 := by
      rw [Subalgebra.aeval_coe, h1]; rfl
    have h3 : Polynomial.aeval (z : L) (χ.map (algebraMap ↥O.toSubring K')) = 0 := by
      rw [Polynomial.aeval_map_algebraMap]; exact h2
    have hint : IsIntegral K' (z : L) := IsIntegral.of_finite K' _
    have hdvd := minpoly.dvd K' (z : L) h3
    have hmon : (χ.map (algebraMap ↥O.toSubring K')).Monic := (Matrix.charpoly_monic _).map _
    refine Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) hmon hdvd ?_
    rw [hdeg, (Matrix.charpoly_monic _).natDegree_map, Matrix.charpoly_natDegree_eq_dim,
      Fintype.card_fin]



  have s6 : ∀ (V : ValuationSubring L) (d : Polynomial ↥O.toSubring) (z : L),
      (∀ s : ↥O.toSubring, algebraMap ↥O.toSubring L s ∈ V) → V.valuation z < 1 →
