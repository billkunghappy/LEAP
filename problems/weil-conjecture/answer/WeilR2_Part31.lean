  have wcpa_dj_lr1k_eb_cdnc_diag_idempotent : ∀ (R A L : Type u) [CommRing R] [CommRing A]
      [CommRing L] [Algebra R A] [Algebra R L] [Algebra A L] [IsScalarTower R A L]
