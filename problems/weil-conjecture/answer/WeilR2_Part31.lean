        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
        (Scheme.ΓSpecIso (.of ↥W)).inv.hom c' := e2.symm
    rw [e2']
    have e3 := congrArg (fun f => f.hom c')
      (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e3
    rw [← e3, IsLocalRing.ResidueField.algebraMap_eq,
