          Ideal.map Φ.toRingHom ((Ideal.span {Polynomial.X} ⊔
          (IsLocalRing.maximalIdeal R).map (Polynomial.C : R →+* Polynomial R)).map
            (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map (Polynomial.C : R →+* Polynomial R)))) := rfl
      rw [e1, Ideal.map_map, hΦc, Ideal.map_sup, Ideal.map_span, Set.image_singleton,
