    ∀ σ₁ : Spec (.of ↥W) ⟶ X₁, σ₁ ≫ r₁ = σ' →
    ∃ σt : Spec (.of ↥W) ⟶ X₁, σt ≫ r₁ = σ ∧
      σt (IsLocalRing.closedPoint ↥W) ≠ σ₁ (IsLocalRing.closedPoint ↥W) ∧
