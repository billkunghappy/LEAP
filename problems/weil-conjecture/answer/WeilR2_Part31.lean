    fun i => Module.finite_of_finrank_pos (by rw [hf i]; exact hpos i)
  let ρ : ∀ i, ↥(integralClosure ↥O.toSubring L) →+* IsLocalRing.ResidueField ↥(Vs i) :=
    fun i => (IsLocalRing.residue ↥(Vs i)).comp
      (RingHom.codRestrict (integralClosure ↥O.toSubring L).val.toRingHom (Vs i)
        (fun b => hBV i b.1 b.2))
  have hρ : ∀ i b, ρ i b = IsLocalRing.residue ↥(Vs i) ⟨b.1, hBV i b.1 b.2⟩ := fun i b => rfl
  have hρalg : ∀ i (c : ↥O.toSubring),
