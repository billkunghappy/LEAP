            ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
            (Limits.pullback.fst g s₀ ≫ g).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
          rw [Scheme.Hom.comp_appTop]; rfl
