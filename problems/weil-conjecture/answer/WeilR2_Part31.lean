      MvPolynomial.eval₂Hom MvPolynomial.C (fun _ => MvPolynomial.X 0 - MvPolynomial.C c)
    let φb : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 1) ↥W :=
