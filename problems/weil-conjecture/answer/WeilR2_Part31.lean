theorem wcpa_dj_lr1k_ebc_cgr_ic_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ → ∀ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι → ∀ (x : ↥X) (w : ↥(Limits.pullback uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))), Limits.pullback.fst uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w = x → wcpaDjLkSmAt W uX w → ∀ (σ : Spec (.of ↥W) ⟶ X) (b : ↥W), wcpaDjLlPair W uX x σ b → ∀ (X₁ : Scheme.{u}) (r₁ : X₁ ⟶ X) (ι₁ : wcProjK Ω 1 ⟶ X₁), wcCsdIsBlowup (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX b) r₁ → ι₁ ≫ r₁ = ι → wcpaDjLkModel W (r₁ ≫ uX) ι₁ → ∀ σt : Spec (.of ↥W) ⟶ X₁, σt ≫ r₁ = σ → ∃ (O : X.affineOpens) (tO : Γ(X, O.1)) (U₀ U₁ : X₁.affineOpens) (e₀ : U₀.1 ≤ r₁ ⁻¹ᵁ O.1) (e₁ : U₁.1 ≤ r₁ ⁻¹ᵁ O.1) (β : Γ(X₁, U₀.1)) (S : Γ(X₁, U₁.1)), x ∈ O.1 ∧ (∀ c : ↥W, (σ.ker ⊔ wcNcPrincipal (.of ↥W) X uX c).ideal O = Ideal.span {tO, (uX.appLE ⊤ O.1 (by simp)).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c)}) ∧ ((r₁ ≫ uX).appLE ⊤ U₀.1 (by simp)).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom b) = β * (r₁.appLE O.1 U₀.1 e₀).hom tO ∧ (r₁.appLE O.1 U₀.1 e₀).hom tO ∈ nonZeroDivisors Γ(X₁, U₀.1) ∧ (r₁.appLE O.1 U₁.1 e₁).hom tO = ((r₁ ≫ uX).appLE ⊤ U₁.1 (by simp)).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom b) * S ∧ σt (IsLocalRing.closedPoint ↥W) ∈ U₁.1 ∧ σt.ker.ideal U₁ = Ideal.span {S} ∧ (∀ z : ↥X₁, r₁ z = x → z ≠ σt (IsLocalRing.closedPoint ↥W) → z ∈ U₀.1) :=
by
