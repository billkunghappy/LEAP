        have hcJ : Polynomial.C c ∈ J := by
          rw [hJ, Polynomial.coeff_C_zero]; exact hvinv
        have h1 := hPV _ (hIP (Ideal.mem_map_of_mem ψ hcJ))
        rw [hψC] at h1
        have h2 : V.valuation (algebraMap K' L x) ≤ 1 := (V.valuation_le_one_iff _).mpr hx
        have h3 : V.valuation (algebraMap K' L x * algebraMap K' L x⁻¹) = 1 := by
