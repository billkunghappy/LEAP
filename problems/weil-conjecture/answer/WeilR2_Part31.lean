    intro z hz
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
    have hz' : f * MvPolynomial.X 0 ∈ Ideal.span
        {(MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a' : MvPolynomial (Fin 2) ↥W)} := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
