  haveI := hm

  obtain ⟨hJb, -, hdivb⟩ := wcpa_dj_lr1k_ebd_centre_comap Ω W X uX σ σ' b b c' O m σO σ'O
    hσci hσ'ci hOaff hmq hσO hσ'O hσOm hσ'Om hKO hK'O
  obtain ⟨-, u₀, hc'⟩ := hdivb hIeq.le
  obtain ⟨hJa, -, -⟩ := wcpa_dj_lr1k_ebd_centre_comap Ω W X uX σ σ' a a c' O m σO σ'O
    hσci hσ'ci hOaff hmq hσO hσ'O hσOm hσ'Om hKO hK'O
  have hc'm : c' ∈ IsLocalRing.maximalIdeal ↥W := by
    rw [hc']; exact Ideal.mul_mem_right _ _ hbm
