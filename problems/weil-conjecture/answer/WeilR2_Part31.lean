    let ℓ : Spec Q ⟶ T := hp.lift _ _ w
    have hℓ : ℓ ≫ p = Spec.map φ ≫ Z.fromSpecStalk (p ξ) := hp.lift_fst _ _ w
    have hcp : (Spec.map φ) (IsLocalRing.closedPoint Q) =
        IsLocalRing.closedPoint (Z.presheaf.stalk (p ξ)) := Spec_closedPoint
    have hapt0 : (Spec.map φ ≫ Z.fromSpecStalk (p ξ)) (IsLocalRing.closedPoint Q) = p ξ := by
      change Z.fromSpecStalk (p ξ) ((Spec.map φ) (IsLocalRing.closedPoint Q)) = p ξ
      exact (congrArg (Z.fromSpecStalk (p ξ)) hcp).trans Scheme.fromSpecStalk_closedPoint
    have hpt : ℓ (IsLocalRing.closedPoint Q) = ξ := by
      apply hpinj
      change (ℓ ≫ p) (IsLocalRing.closedPoint Q) = p ξ
