    have hne : IsLocalRing.residue ↥W (y k0) ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hu
    exact hne ((mul_eq_zero.mp hc).resolve_left (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)))
  let ψ := Polynomial.X * (Polynomial.X + Polynomial.C 1) * φ
  have hψ : ψ ≠ 0 :=
    mul_ne_zero (mul_ne_zero Polynomial.X_ne_zero (Polynomial.monic_X_add_C 1).ne_zero) hφ
  obtain ⟨z, hz⟩ := Infinite.exists_notMem_finset ψ.roots.toFinset
  have hev : ψ.eval z ≠ 0 := by
    intro h; apply hz; rw [Multiset.mem_toFinset, Polynomial.mem_roots hψ]; exact h
  simp only [ψ, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_add,
    Polynomial.eval_C] at hev
  obtain ⟨hz12, hφz⟩ := mul_ne_zero_iff.mp hev
  obtain ⟨hz0, hz1⟩ := mul_ne_zero_iff.mp hz12
  obtain ⟨lam, hlam⟩ := IsLocalRing.residue_surjective (R := ↥W) z
  have hsum : IsLocalRing.residue ↥W
      (∑ k ∈ Finset.range (N + 1), (-1) ^ k * lam ^ (N - k) * y k) = φ.eval z := by
    simp only [φ, Polynomial.eval_finset_sum, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_pow, Polynomial.eval_X, map_sum, map_mul, map_pow, map_neg, map_one, hlam,
      Polynomial.eval_neg, Polynomial.eval_one]
    exact Finset.sum_congr rfl (fun k _ => by ring)
  refine ⟨lam, (IsLocalRing.residue_ne_zero_iff_isUnit _).mp ?_,
    (IsLocalRing.residue_ne_zero_iff_isUnit _).mp ?_,
    (IsLocalRing.residue_ne_zero_iff_isUnit _).mp ?_⟩
  · rw [hlam]; exact hz0
  · rw [map_add, map_one, hlam, add_comm]; exact hz1
  · rw [hsum]; exact hφz

