    rintro z (⟨w, rfl⟩ | rfl | rfl)
    · exact (V'.valuation_le_one_iff _).1 (hOV _ (hOw w))
    · exact (V'.valuation_le_one_iff _).1 hηV
    · exact (V'.valuation_le_one_iff _).1 hgηV
