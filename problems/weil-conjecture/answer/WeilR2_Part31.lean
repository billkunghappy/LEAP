theorem wcpa_dj_lr1k_ebnb_desc_map : ∀ {C X₁ X₂ : Scheme.{u}} (f₁ : C ⟶ X₁) (f₂ : C ⟶ X₂) [QuasiCompact f₁] [QuasiSeparated f₁] [QuasiCompact f₂] [QuasiSeparated f₂] (U : X₂.Opens) (g : U.toScheme ⟶ X₁) (f₂' : C ⟶ U.toScheme), f₂' ≫ U.ι = f₂ → f₂' ≫ g = f₁ → ∃ (Φ : (f₂.fromNormalization ⁻¹ᵁ U).toScheme ⟶ f₁.normalization) (t : C ⟶ (f₂.fromNormalization ⁻¹ᵁ U).toScheme), t ≫ (f₂.fromNormalization ⁻¹ᵁ U).ι = f₂.toNormalization ∧ t ≫ Φ = f₁.toNormalization ∧ Φ ≫ f₁.fromNormalization = (f₂.fromNormalization ∣_ U) ≫ g :=
