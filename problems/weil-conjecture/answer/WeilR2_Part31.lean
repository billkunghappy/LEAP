      (algebraMap ↥(integralClosure ↥(wcEbRing W a) L) (Localization.AtPrime 𝔮)).comp
        (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L))
    let E : Polynomial (wcEbNg W g) →+* Localization.AtPrime 𝔮 := Polynomial.eval₂RingHom ψ ζ
    have hp₁' : E h * jR ⟨RatFunc.X, Subring.subset_closure (Or.inr (Set.mem_insert _ _))⟩ =
        E p₁ := hp₁
    have hp₂' : E h * jR ⟨algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹,
        Subring.subset_closure (Or.inr (Set.mem_insert_of_mem _ rfl))⟩ = E p₂ := hp₂
    suffices key : ∀ (x : RatFunc Ω) (hx : x ∈ Subring.closure
        (Set.range (fun w : ↥W => algebraMap Ω (RatFunc Ω) (w : Ω)) ∪
          {RatFunc.X, algebraMap Ω (RatFunc Ω) (a : Ω) * RatFunc.X⁻¹})),
        ∃ (k : ℕ) (p : Polynomial (wcEbNg W g)),
          E (Polynomial.derivative f * h) ^ k * jR ⟨x, hx⟩ = E p by
      obtain ⟨k, p, hp⟩ := key r hr
      exact ⟨k, p, hp⟩
    intro x hx
    induction hx using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨w, rfl⟩ | hx
      · refine ⟨0, Polynomial.C (wcEbNgC W g w), ?_⟩
        rw [pow_zero, one_mul]
        show _ = Polynomial.eval₂ ψ ζ (Polynomial.C (wcEbNgC W g w))
        rw [Polynomial.eval₂_C, hψC]
        rfl
      · rcases hx with rfl | rfl
        · refine ⟨1, Polynomial.derivative f * p₁, ?_⟩
          rw [pow_one, map_mul E, map_mul E, mul_assoc, hp₁']
        · refine ⟨1, Polynomial.derivative f * p₂, ?_⟩
          rw [pow_one, map_mul E, map_mul E, mul_assoc, hp₂']
    | zero =>
      refine ⟨0, 0, ?_⟩
      show _ * jR 0 = _
      rw [map_zero, mul_zero, map_zero]
    | one =>
      refine ⟨0, 1, ?_⟩
      show _ * jR 1 = _
      rw [map_one, mul_one, pow_zero, map_one]
    | add x y hx hy ihx ihy =>
      obtain ⟨k, p, hp⟩ := ihx
      obtain ⟨k', p', hp'⟩ := ihy
      refine ⟨k + k', (Polynomial.derivative f * h) ^ k' * p +
        (Polynomial.derivative f * h) ^ k * p', ?_⟩
      show _ * jR (⟨x, hx⟩ + ⟨y, hy⟩) = _
      simp only [map_add, map_mul, map_pow] at hp hp' ⊢
      rw [← hp, ← hp']
      ring
    | neg x hx ih =>
      obtain ⟨k, p, hp⟩ := ih
      refine ⟨k, -p, ?_⟩
      show _ * jR (-⟨x, hx⟩) = _
      simp only [map_neg, map_mul, map_pow] at hp ⊢
      rw [← hp]
      ring
    | mul x y hx hy ihx ihy =>
      obtain ⟨k, p, hp⟩ := ihx
      obtain ⟨k', p', hp'⟩ := ihy
      refine ⟨k + k', p * p', ?_⟩
      show _ * jR (⟨x, hx⟩ * ⟨y, hy⟩) = _
      simp only [map_mul, map_pow] at hp hp' ⊢
      rw [← hp, ← hp']
      ring

theorem wcpa_dj_lr1k_eb_an_branch_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → W ≠ ⊤ →
    ∀ (L : Type u) [Field L] [Algebra (RatFunc Ω) L] [FiniteDimensional (RatFunc Ω) L]
      [Algebra.IsSeparable (RatFunc Ω) L],
    wcEbDefectless W L →
    ∃ a : ↥W, a ≠ 0 ∧ a ∈ IsLocalRing.maximalIdeal ↥W ∧
      letI : Algebra ↥(wcEbRing W a) L :=
        ((algebraMap (RatFunc Ω) L).comp (wcEbRing W a).subtype).toAlgebra
      ∃ (n : ℕ) (𝔮 : Fin n → Ideal ↥(integralClosure ↥(wcEbRing W a) L))
        (h𝔮 : ∀ j, (𝔮 j).IsPrime),
        (∀ j, (𝔮 j).comap (algebraMap ↥(wcEbRing W a) ↥(integralClosure ↥(wcEbRing W a) L)) =
          wcEbNode W a) ∧
        (∀ j, haveI := h𝔮 j; wcEbAnMonoData W a L (𝔮 j)) ∧
        ∃ V : ValuationSubring (RatFunc Ω), wcEbRing W a ≤ V.toSubring ∧
          (∀ r ∈ wcEbNode W a, V.valuation (r : RatFunc Ω) < 1) ∧
          ∀ V' : ValuationSubring L, V'.comap (algebraMap (RatFunc Ω) L) = V →
            ∃ j, ∀ s : ↥(integralClosure ↥(wcEbRing W a) L),
              s ∈ 𝔮 j ↔ V'.valuation (s : L) < 1 :=
by
  intro Ω _ _ W hdim hW L _ _ _ _ hdef
  have key : ∀ {F : Type u} [Field F] (A : ValuationSubring F) (y : F),
      A.valuation y < 1 ↔ (y = 0 ∨ y⁻¹ ∉ A) := by
    intro F _ A y
    by_cases hy : y = 0
    · simp [hy]
    · simp only [hy, false_or]
      rw [← A.valuation_le_one_iff, map_inv₀, not_le]
      have hv : A.valuation y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy
      exact (one_lt_inv₀ (zero_lt_iff.mpr hv)).symm
  have transfer : ∀ (O : ValuationSubring (RatFunc Ω)) (V' : ValuationSubring L),
      V'.comap (algebraMap (RatFunc Ω) L) = O → ∀ x : RatFunc Ω,
      V'.valuation (algebraMap (RatFunc Ω) L x) < 1 ↔ O.valuation x < 1 := by
    intro O V' hV' x
    rw [key, key, map_eq_zero, ← map_inv₀, ← hV']
    rfl
  have hGS := wcpa_dj_lr1k_eb_an_gauss_structure Ω W hdim hW L hdef
  have hBD := wcpa_dj_lr1k_eb_an_branch_data Ω W hdim hW L hdef hGS
  obtain ⟨a, ha0, ham, hmono⟩ :=
    wcpa_dj_lr1k_eb_an_branch_chart_mono Ω W hdim hW L hdef hGS hBD
  obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq (a : Ω) (by norm_num : 0 < 2)
  have hcc : c * c = (a : Ω) := by rw [← sq]; exact hc
  obtain ⟨O, hOex, hRO, hOnode⟩ := wcpa_dj_lr1k_eb_an_annulus_gauss Ω W a c ha0 ham hcc
  letI : Algebra ↥(wcEbRing W a) L :=
    ((algebraMap (RatFunc Ω) L).comp (wcEbRing W a).subtype).toAlgebra
  obtain ⟨n, 𝔮, h𝔮, hreal, hcov⟩ :=
    wcpa_dj_lr1k_eb_an_finite_centres (RatFunc Ω) L (wcEbRing W a) O hRO
  refine ⟨a, ha0, ham, n, 𝔮, h𝔮, ?_, ?_, O, hRO, ?_, hcov⟩
  · intro j
    obtain ⟨V', hV', hch⟩ := hreal j
    ext r
    rw [Ideal.mem_comap, hch]
    show V'.valuation (algebraMap (RatFunc Ω) L (r : RatFunc Ω)) < 1 ↔ r ∈ wcEbNode W a
    rw [transfer O V' hV']
    exact hOnode r
  · intro j
    obtain ⟨V', hV', hch⟩ := hreal j
    haveI := h𝔮 j
    exact hmono c hcc O hOex V' hV' (𝔮 j) hch
  · intro r hr
    exact (hOnode r).2 hr

